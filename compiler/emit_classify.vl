}

// True if the expression at `exprIx`, or any sub-expression, is a string `+`, `==` or
// `.slice`.
export function exprHasStrOp(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is BinExpr {
    if exprIsStrConcat(exprIx, fnIx) { return true }
    if exprIsStrEq(exprIx, fnIx) { return true }
    // A string ordering rides the same lexicographic compare loop.
    if exprIsStrOrder(exprIx, fnIx) { return true }
    // A union-box `==` whose value compare can hit the string arm stages its payloads in the
    // same frame.
    if exprIsUnionStrEq(exprIx, fnIx) { return true }
    // A struct `==` stages its string and array field compares in the same frame.
    if exprIsStructEq(exprIx, fnIx) { return true }
    // An assignment of a literal-union atom into a `string` target widens, which stages the
    // atom id in the string-op scratch frame.
    if assignWidensAtomToStr(exprIx, fnIx) { return true }
    if exprHasStrOp(e.binLeft, fnIx) { return true }
    return exprHasStrOp(e.binRight, fnIx)
  }
  if e is Call {
    if exprIsStrSlice(exprIx, fnIx) { return true }
    // A literal-union atom argument flowing into a `string` param widens, which stages the
    // atom id in the string-op scratch frame.
    if callWidensAtomToStr(exprIx, fnIx) { return true }
    // `xs.push(atom)` into a `string[]` widens the same way — its twin emit arm is in
    // `emitPush`.
    if pushWidensAtomToStr(exprIx, fnIx) { return true }
    // `s.indexOf(sub)` and `s.includes(sub)` stage their receiver, needle and loop counters in
    // the same string scratch frame. `charCodeAt` is a bare `array.get` and needs no frame; its
    // operands recurse below.
    if exprIsStrIndexOf(exprIx, fnIx) { return true }
    // `print(<string>)` rides the string-op scratch frame: the streaming loop's string ref,
    // cursor and length live there.
    const pcal = P.nodes[e.callFn]
    if pcal is Ident {
      if pcal.identName == "print" {
        if e.callArgs.length == 1 {
          if exprString(e.callArgs[0], fnIx) { return true }
          // `print(<literal-union atom>)` widens to its member string, and its per-member
          // print chain rides the same string-op scratch frame.
          if exprIsLitAtom(e.callArgs[0], fnIx) { return true }
          if identShadowMayBeLitAtom(e.callArgs[0], fnIx) { return true }
          // `print(<string | null>)` streams through `emitPrintNulString`, which `local.set`s
          // the ref it recovers into the same frame. The two ends of one decision must ask the
          // same question: `exprNullableString` is strictly wider than `exprString`, so where
          // the handler claims a value the scan does not, the frame is never reserved.
          if exprNullableString(e.callArgs[0], fnIx) { return true }
          // `print(<value-union box>)` with a string arm streams that arm through the same
          // tail, out of the same frame. Asked through the shared plan, which is what the
          // handler dispatches on, so reservation and lowering cannot disagree about the arm.
          if printUnionHasStrArm(e.callArgs[0], fnIx) { return true }
        }
      }
      // `__trap__(<string>)` prints its reason through the same string streaming loop before
      // the abort, so it rides the string-op scratch frame too.
      if pcal.identName == "__trap__" {
        if e.callArgs.length == 1 {
          if exprString(e.callArgs[0], fnIx) { return true }
        }
      }
      // `fromCodePoints(xs)` stages its length and result there too.
      if pcal.identName == "fromCodePoints" { return true }
    }
    if exprHasStrOp(e.callFn, fnIx) { return true }
    const args = e.callArgs
    let i = 0
    while i < args.length {
      if exprHasStrOp(args[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if e is Member { return exprHasStrOp(e.memObj, fnIx) }
  if e is Index {
    if exprHasStrOp(e.idxArr, fnIx) { return true }
    return exprHasStrOp(e.idxIndex, fnIx)
  }
  // An if-expression in value position: a string op in the condition or either arm needs the
  // frame reserved too.
  if e is IfStmt {
    if exprHasStrOp(e.ifCond, fnIx) { return true }
    // An atom arm under a `string`-typed join widens, staging the atom id in the string-op
    // frame. Mirrors the emit decision: the join type recorded by the checker, any arm.
    if tyKindOf(nodeTyIxOf(exprIx)) == 3 {
      if ifChainHasAtomArm(exprIx, fnIx) { return true }
    }
    if blockHasStrOp(e.ifThen, fnIx) { return true }
    if e.ifElse >= 0 { return blockHasStrOp(e.ifElse, fnIx) }
    return false
  }
  if e is Unary { return exprHasStrOp(e.unArg, fnIx) }
  if e is Paren { return exprHasStrOp(e.parInner, fnIx) }
  if e is IsExpr {
    // A string-literal `is` (`s is "a"`) lowers through `emitStrEqCore`, so it stages operands
    // in the string scratch frame like a string `==`. The quoted-leaf test is at its home in
    // `tyname.nameIsQuotedLeaf`, with the `length > 0` bound in front of it.
    if e.isVariant.length > 0 && nameIsQuotedLeaf(e.isVariant) { return true }
    return exprHasStrOp(e.isObj, fnIx)
  }
  if e is AsExpr { return exprHasStrOp(e.asObj, fnIx) }
  if e is ObjLit {
    const fields = e.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if exprHasStrOp(f.fiValue, fnIx) { return true }
        // A literal-union atom field value widens to a string for a `string` field. Any atom
        // field value is destined for one, and a literal-union field is not yet a rep, so this
        // is a safe over-approximation.
        if exprIsLitAtom(f.fiValue, fnIx) { return true }
        if identShadowMayBeLitAtom(f.fiValue, fnIx) { return true }
      }
      i = i + 1
    }
    return false
  }
  if e is ArrayLit {
    const elems = e.arrElems
    let i = 0
    while i < elems.length {
      if exprHasStrOp(elems[i], fnIx) { return true }
      // A literal-union atom element of a string-array literal widens to its member string,
      // which stages the atom id in the string-op scratch frame — the emit's reservation side.
      // Deliberately not gated on the literal being a string list: `arrLitIsStr` is an
      // emit-time classification this scan does not repeat, and over-reserving only costs locals.
      if exprIsLitAtom(elems[i], fnIx) { return true }
      if identShadowMayBeLitAtom(elems[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// True if any arm tail of the value if chain at `ifIx` is a literal-union atom: under a
// `string`-typed join the atom arm widens to its member string, which rides the string-op
// scratch frame.
function ifChainHasAtomArm(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    const tv = ifThenValueIx(ifIx)
    if tv >= 0 {
      if exprIsLitAtom(tv, fnIx) { return true }
      if identShadowMayBeLitAtom(tv, fnIx) { return true }
    }
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is IfStmt { return ifChainHasAtomArm(s.ifElse, fnIx) }
      if els is Block {
        const ev = ifArmValueExpr(s.ifElse)
        if ev >= 0 {
          if exprIsLitAtom(ev, fnIx) { return true }
          return identShadowMayBeLitAtom(ev, fnIx)
        }
      }
    }
  }
  false
}

// True if any statement in the block at `blockIx` contains a string op, descending into if and
// else branches and while bodies — the scopes `collectLocals` walks. The wrapper restores the
// narrowing depth the scan's post-guard pushes may leave behind on an early `true`.
export function blockHasStrOp(blockIx: i32, fnIx: i32) {
  const savedGuardTop = narrowTop
  const hit = blockHasStrOpScan(blockIx, fnIx)
  restoreNarrow(savedGuardTop)
  hit
}

function blockHasStrOpScan(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        if exprHasStrOp(s.letInit, fnIx) { return true }
        // A literal-union atom initializing a `string` local widens — reserve the frame.
        if letWidensAtomToStr(stmts[i], fnIx) { return true }
      } else if s is RetStmt {
        if exprHasStrOp(s.retArg, fnIx) { return true }
        // A literal-union atom returned as `string` widens — reserve the string-op frame.
        if retWidensAtomToStr(s.retArg, fnIx) { return true }
      } else if s is BinExpr {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Call {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is ObjLit {
        // A bare trailing object-literal statement is a function's implicit-return value, and
        // its field initializers can contain string ops, so descend — `exprHasStrOp` walks
        // `objFields`.
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Member {
        // A bare trailing member access is also an implicit-return value, and its receiver may
        // be a string op, such as `s.slice(a, b).length`. Without this the slice's scratch
        // frame goes unreserved and the slice emit references an unallocated local.
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Index {
        // Likewise a trailing `xs[i]` or `m[k]` index whose receiver or key uses a string op.
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is ArrayLit {
        // A trailing array literal is an implicit-return value, and a literal-union atom
        // element of a string list widens there exactly as it does at a `let`. `exprHasStrOp`'s
        // own ArrayLit arm asks the per-element atom question; this arm routes a tail literal
        // to it.
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Paren {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Unary {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is IsExpr {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is AsExpr {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is IfStmt {
        if ifChainHasStrOp(stmts[i], fnIx) { return true }
      } else if s is WhileStmt {
        if exprHasStrOp(s.whileCond, fnIx) { return true }
        if blockHasStrOp(s.whileBody, fnIx) { return true }
      } else if s is ForIn {
        if exprHasStrOp(s.fiIter, fnIx) { return true }
        if blockHasStrOp(s.fiBody, fnIx) { return true }
      } else if s is ForRange {
        if exprHasStrOp(s.frFrom, fnIx) { return true }
        if exprHasStrOp(s.frTo, fnIx) { return true }
        if blockHasStrOp(s.frBody, fnIx) { return true }
      }
      // Post-guard complement narrowing, mirroring the emit loops, so a string read below a
      // returning guard is detected under the same narrowing the emit applies. The wrapper
      // restores the depth.
      pushPostGuardNarrow(stmts[i], fnIx)
      i = i + 1
    }
  }
  false
}

// True if any arm of the `if` chain at `ifIx` contains a string op — its condition, then-branch,
// `else` block, or recursively a chained `else if`. Mirrors `ifChainPushPopBits`: it walks the
// whole chain, not just one level.
function ifChainHasStrOp(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if exprHasStrOp(s.ifCond, fnIx) { return true }
    // Narrow across the then-branch, mirroring `emitStmt` and `collectLocalsIf`, so a string op
    // over a narrowed variant field is detected — `exprString` resolves a variant field's string
    // type only while the receiver's narrowing is active. Save and restore the depth.
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const hit = blockHasStrOp(s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if hit { return true }
    if s.ifElse >= 0 {
      // A value union narrows to the complement set in the else-arm, mirroring `emitStmt`'s
      // else lowering, so `else { print(v) }` with `v` now `string` is detected as a string
      // print and reserves the scratch frame.
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
      const els = P.nodes[s.ifElse]
      let hitElse = false
      if els is Block { hitElse = blockHasStrOp(s.ifElse, fnIx) }
      else if els is IfStmt { hitElse = ifChainHasStrOp(s.ifElse, fnIx) }
      if narrowedElse { restoreNarrow(savedElseTop) }
      if hitElse { return true }
    }
  }
  false
}

// True if the `FuncDecl` at `fnIx` uses any string op, so it reserves the shared string
// scratch frame. The statement scan covers every op reachable from a statement; the tail leg
// covers the one position that is a return without being spelled as one.
export function fnHasStrOp(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if blockHasStrOp(fn.fnBody, fnIx) { return true }
    return fnTailWidensAtomToStr(fnIx)
  }
  false
}

// ── array-intrinsic detection ─────────────────────────────────────────────────
// `__array_new__`, `__array_new_default__`, `__array_copy__` and `__trap__` lower inline at
// the call site. The two allocators reserve the one-slot `arrNewScratchBase` frame, and these
// walkers find them anywhere in a body — a pure name walk, so no narrowing bookkeeping.

// D966 — the arena type of an `__array_new__` call's fill argument, or -1. The element row for
// the resulting list is interned from it, so the intern derives the element's kind rather than
// assuming the struct one. `arrNewIntrKind` below is the kind itself: `__array_new__` reads
// its fill, `__array_new_default__` its destination, and -1 is not an intrinsic allocation.
export function arrNewFillTyIx(callIx: i32): i32 {
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length == 2 { return nodeTyIxOf(c.callArgs[1]) }
  }
  -1
}

export function arrNewIntrKind(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      if callee.identName == "__array_new__" {
        if c.callArgs.length == 2 {
          if exprIsF64(c.callArgs[1], fnIx) { return 1 }
          // D963 — the i64 fill: `ia64TypeIdx` and `il64TypeIdx` are interned like the f64
          // pair above and `i64[]` lists lower and run. Ahead of the string and struct arms
          // for the same reason f64 is: a scalar fill cannot be either. f32 is not here —
          // the identical wiring for the f32 pair produces invalid wasm, so its guard stays.
          if exprIsI64(c.callArgs[1], fnIx) { return 4 }
          // A string fill builds the string list; a struct or object-literal fill builds the
          // ref list for that element struct.
          if exprString(c.callArgs[1], fnIx) { return 2 }
          const anf = P.nodes[c.callArgs[1]]
          if anf is ObjLit { return 3 }
          if exprStruct(c.callArgs[1], fnIx) { return 3 }
          if exprIsClosure(c.callArgs[1], fnIx) { return 3 }
          if exprArray(c.callArgs[1], fnIx) { return 3 }
          if exprRefArray(c.callArgs[1], fnIx) { return 3 }
          if exprStringArray(c.callArgs[1], fnIx) { return 3 }
          if exprMap(c.callArgs[1], fnIx) { return 3 }
        }
        return 0
      }
      if callee.identName == "__array_new_default__" {
        return arrNewDefaultKind(callIx)
      }
    }
  }
  -1
}

// The `__array_new_default__(n)` element kind, read off the checker's recorded type for the
// call: `array.new_default` writes each slot's zero, so the kind is the destination's. An
// unpinned hole answers `0`, matching the i32 default such a binding gets. Laddered over
// `PrimName`, the checker's own vocabulary, so the gate and the kind cannot drift (D1470).
function arrNewDefaultKind(callIx: i32) {
  const p = tyPrimLeafElemName(nodeTyIxOf(callIx))
  if p == "f64" { return 1 }
  if p == "i64" { return 4 }
  if p == "u8" { return 5 }
  if p == "f32" { return 6 }
  if p == "i32" { return 0 }
  if p == "boolean" { return 0 }
  if p == "string" { return 0 }
  if p == "void" { return 0 }
  if p == "null" { return 0 }
  if p == "never" { return 0 }
  0
}

// The declared-local position of `name`: the innermost live lexical binding when the scope
// stack has one, else the first `localNames` slot of that name as a safety net for the
// scope-less passes. The resolution variant of `declaredSlotOf`: identical, except the flat
// fallback skips loop-variable slots, whose loop has closed if the scan reaches them.
function declaredSlotLive(name: string) {
  const scoped = scopeSlotOf(name)
  if scoped >= 0 { return scoped }
  // `flatScanSkips` states for a block binding what `localLoopVar` states for a loop
  // variable: a flat hit the scope stack could have answered for is out of scope.
  let pos = 0
  while pos < localNames.length {
    if (
      localNames[pos] == name &&
      localLoopVar[pos] == 0 &&
      !flatScanSkips(pos)
    ) {
      return pos
    }
    pos = pos + 1
  }
  -1
}

// Could two same-named slots in one frame give a type-directed detector different answers?
// True when they differ on any axis a classifier reads off the slot: the rep, the struct row,
// the literal-atom flag, the declaration node or the loop iterable. Same on every one means
// the flat scan's choice cannot matter, so the detection owes no second pass (D1595).
function localRepDiffers(a: i32, b: i32) {
  if a < 0 || b < 0 { return true }
  if localIsRef[a] != localIsRef[b] { return true }
  if localStructIdx[a] != localStructIdx[b] { return true }
  if localLitUnion[a] != localLitUnion[b] { return true }
  if localDeclIx[a] != localDeclIx[b] { return true }
  localLoopIter[a] != localLoopIter[b]
}

// Does this frame bind any name to more than one slot? The one condition under which
// `declaredSlotOf`'s scope-less answer is a guess. The detection drivers ask once per frame,
// so a frame with no shadowing keeps the flat scan's first-match early return (D1595).
export function frameHasDupLocalName() {
  let i = 1
  while i < localNames.length {
    let j = 0
    while j < i {
      if localNames[j] == localNames[i] { return true }
      j = j + 1
    }
    i = i + 1
  }
  false
}

// Does the flat scan have to pass slot `pos` over? True for a block-scoped binding asked
// while the scope stack is authoritative, since every live one resolves through
// `scopeSlotOf` and reaching the flat scan means this one's `}` has passed. Scope-less
// passes keep the whole registry, which is what they are for. D1597.
function flatScanSkips(pos: i32) {
  if localBlockLet[pos] == 0 { return false }
  blockBindingHidden()
}

// Does this frame bind a name in a nested block that a module global also binds? The one
// condition under which the scope-less detection sweep and the lowering can disagree about
// which home a read denotes, so the one condition `dupScanRun` owes a second sweep. D1597.
export function frameHasBlockLetOverGlobal() {
  let i = 0
  while i < localNames.length {
    if localBlockLet[i] == 1 {
      if globalLetOf(localNames[i]) >= 0 { return true }
    }
    i = i + 1
  }
  false
}

function declaredSlotOf(name: string) {
  const scoped = scopeSlotOf(name)
  if scoped >= 0 { return scoped }
  if !dupScanActive {
    let pos = 0
    while pos < localNames.length {
      if localNames[pos] == name && !flatScanSkips(pos) { return pos }
      pos = pos + 1
    }
    return -1
  }
  // Under a detection driver's disambiguation loop: hand back the `dupSlotBias`-th
  // same-named slot (the first when the name is bound once, or when the bias has run past
  // the match count), and tell the driver when a later match of a different rep is still
  // unvisited — that is the pass it has yet to run.
  let p = 0
  let first = -1
  let pick = -1
  let seen = 0
  while p < localNames.length {
    if localNames[p] == name {
      if first < 0 { first = p }
      if seen == dupSlotBias {
        pick = p
      } else if seen > dupSlotBias && pick >= 0 {
        if localRepDiffers(pick, p) { dupSlotMore = true }
      }
      seen = seen + 1
    }
    p = p + 1
  }
  if pick >= 0 { return pick }
  first
}

// The `VKind` of declared local `name`, or `null` when there is no such declared local — the
// single `declaredSlotOf` and `localIsRef` lookup the `declared*` type predicates share, each
// comparing the result against its own kind atom. The `null` arm matches no atom, so an
// absent local reads as none of these.
export function declaredKind(name: string): VKind | null {
  const slot = declaredSlotOf(name)
  if slot < 0 { return null }
  localIsRef[slot]
}

// The wasm local index of the declared-local position `pos` in function `fnIx`, or -1 when
// `pos` names no local. Declared locals sit after the params, so the index is
// `envShift + paramCount + pos`. The position-to-index half of declared-local resolution,
// shared by `declaredIndexOf` and by `localIndexOf`'s scope-stack arm.
function declaredIndexAt(fnIx: i32, pos: i32) {
  if pos < 0 { return -1 }
  if fnIx < 0 {
    // Module scope is the start function's body, which has no params, so the local index is
    // the slot. A global-section constexpr init also runs at `fnIx` -1, but its scope stack
    // is empty, so `declaredSlotOf` has already answered -1.
    return pos
  }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl { return envSlotShift(fnIx) + fn.fnParams.length + pos }
  -1
}

// The wasm local index of declared local `name`, or -1 if it is not a declared
// local. `declaredSlotLive` resolves the name (innermost live lexical binding, else
// the loop-var-skipping flat scan); `declaredIndexAt` turns that position into an index.
function declaredIndexOf(fnIx: i32, name: string) {
  declaredIndexAt(fnIx, declaredSlotLive(name))
}

// The wasm-local-index offset introduced by the env-leading closure param: when any function
// value exists in the module, every function but the start one carries a hidden leading
// `structref env` at local 0, so its params shift to 1..p and its locals to p+1 on. Zero
// otherwise, so a module with no lambda keeps the original 0-based layout.
export function envSlotShift(fnIx: i32) {
  if fnValUsed && fnIx >= 0 { return 1 }
  0
}

// Resolve an identifier `name` to its wasm local index for function `fnIx`: a live lexical
// binding first, else a param, else a declared local through the flat fallback, or -1. The
// scope stack outranks the param because a block-scoped local shadowing one gets its own
// slot; only that hit does, since the flat scan cannot tell a dead binding from a live one.
export function localIndexOf(fnIx: i32, name: string) {
  const scoped = scopeSlotOf(name)
  if scoped >= 0 { return declaredIndexAt(fnIx, scoped) }
  const pIx = paramIndexOf(fnIx, name)
  if pIx >= 0 { return envSlotShift(fnIx) + pIx }
  declaredIndexOf(fnIx, name)
}

// ── the canonical field order (D622) ─────────────────────────────────────────
// `fieldNameOrder` below is it: a struct or variant row's emitted field sequence as a
// permutation of the spelled one, ascending by field name, so a shape's wasm layout is a pure
// function of the shape. Not applied to a `flat` record, whose field order is its byte layout.

// ── the struct emission order (D622) ─────────────────────────────────────────
// Is row `p`'s field name and code list a proper prefix of row `c`'s? The cheap half of
// `emit_sections`' `structRowIsProperPrefix`, which also compares the emitted slot. Being
// weaker is safe here: it triggers on a superset of the real edges and a reorder is neutral.
function structRowPrefixCheap(p: i32, c: i32): boolean {
  if p < 0 || c < 0 || p == c { return false }
  if p >= sFieldCount.length || c >= sFieldCount.length { return false }
  const pn = sFieldCount[p]
  if pn == 0 { return false }
  if pn >= sFieldCount[c] { return false }
  let k = 0
  while k < pn {
    if sFieldNames[sFieldStart[p] + k] != sFieldNames[sFieldStart[c] + k] {
      return false
    }
    if sFieldTypes[sFieldStart[p] + k] != sFieldTypes[sFieldStart[c] + k] {
      return false
    }
    k = k + 1
  }
  true
}

// The order the representative struct rows are assigned heap indices in and emitted in —
// declaration order, except that a row is held back until every proper prefix of it has gone.
// wasm requires a declared supertype to have a lower type index than its subtype, and a
// supertype here is a shorter field list (D622). Twins have no position of their own to hold.
export function structEmitOrder(): i32[] {
  const ord: i32[] = []
  const done: boolean[] = []
  let i = 0
  while i < sNames.length {
    done.push(sTwin[i] != i)
    i = i + 1
  }
  let placed = true
  while placed {
    placed = false
    let c = 0
    while c < sNames.length {
      if !done[c] {
        let ready = true
        let p = 0
        while p < sNames.length {
          if !done[p] && structRowPrefixCheap(p, c) { ready = false }
          p = p + 1
        }
        if ready {
          ord.push(c)
          done[c] = true
          placed = true
        }
      }
      c = c + 1
    }
  }
  // A cycle is impossible, a proper prefix being strictly shorter, so the relation is a strict
  // partial order — but a row left unplaced would silently vanish from the type section, so
  // any residue is appended in declaration order rather than dropped.
  let r = 0
  while r < sNames.length {
    if !done[r] {
      ord.push(r)
      done[r] = true
    }
    r = r + 1
  }
  ord
}

export function fieldNameOrder(names: string[]): i32[] {
  const ord: i32[] = []
  let i = 0
  while i < names.length {
    ord.push(i)
    i = i + 1
  }
  let a = 1
  while a < ord.length {
    let b = a
    while b > 0 && names[ord[b - 1]] > names[ord[b]] {
      const t = ord[b - 1]
      ord[b - 1] = ord[b]
      ord[b] = t
      b = b - 1
    }
    a = a + 1
  }
  ord
}

// The wasm struct field index of `name` within struct `si` (declaration order), or
// -1 if that struct has no such field.
export function sFieldIndex(si: i32, name: string) {
  if si < 0 {
    return -1 // unresolved struct (e.g. an inferred ref with no interned shape)
  }
  // The floor for the whole family: an `si` past the struct table names no struct, the same
  // answer `si < 0` gets. Without it a caller handing over an index from another table turns
  // a classifier probe into an out-of-bounds read inside the compiler. Every downstream
  // accessor is reached only after this returns `>= 0`, so bounding it here bounds them all.
  if si >= sFieldStart.length { return -1 }
  const start = sFieldStart[si]
  const cnt = sFieldCount[si]
  let j = 0
  while j < cnt {
    if sFieldNames[start + j] == name { return j }
    j = j + 1
  }
  -1
}

// The wasm-type code (`0` i32, `3` string, `4` i32-list, `5` ref-list) of struct `si`'s
// field at field index `fi`.
export function sFieldTypeAt(si: i32, fi: i32) {
  sFieldTypes[sFieldStart[si] + fi]
}

// The ref-list element type-name of struct `si`'s field `fi` (a code-5 field), "" otherwise.
export function sFieldElemNameAt(si: i32, fi: i32) {
  sFieldElemName[sFieldStart[si] + fi]
}

// The arena type of struct `si`'s field `fi`'s element or target — the `sFieldElemTyIx`
// sidecar's accessor and `sFieldElemNameAt`'s structural twin. -1 when the sidecar does not
// cover the row, which every consumer treats as "keep the name path".
export function sFieldElemTyIxAt(si: i32, fi: i32): i32 {
  const ix = sFieldStart[si] + fi
  if ix >= sFieldElemTyIx.length { return -1 }
  sFieldElemTyIx[ix]
}

// The `sFieldElemTyIxAt` twin for variant fields (`uFieldElemTyIx`).
function uFieldElemTyIxAt(vi: i32, fi: i32): i32 {
  const ix = uFieldStart[vi] + fi
  if ix >= uFieldElemTyIx.length { return -1 }
  uFieldElemTyIx[ix]
}

// The same two sidecars addressed by their flat row index — the form `emit_collect`'s
// field-table re-derivation passes hold, since they walk `sFieldTypes` straight through
// rather than per struct and field. Same uncovered answer as the `…At` pair: -1 keeps the
// name path.
export function sFieldElemTyIxRow(ix: i32): i32 {
  if ix < 0 { return -1 }
  if ix >= sFieldElemTyIx.length { return -1 }
  sFieldElemTyIx[ix]
}

export function uFieldElemTyIxRow(ix: i32): i32 {
  if ix < 0 { return -1 }
  if ix >= uFieldElemTyIx.length { return -1 }
  uFieldElemTyIx[ix]
}

// The two sidecars' write half, by flat row index (D1050). The `record*` pair appends a row's
// entry at collect time; this rewrites one already there, padding the column as they pad. A
// second push would be the wrong tool: the row's other columns are already in place, so
// pushing again skews the sidecar against every row after it.
export function setSFieldElemRowTy(ix: i32, tyIx: i32): i32 {
  if ix < 0 { return 0 }
  while sFieldElemTyIx.length <= ix { sFieldElemTyIx.push(-1) }
  sFieldElemTyIx[ix] = tyIx
  0
}

export function setUFieldElemRowTy(ix: i32, tyIx: i32): i32 {
  if ix < 0 { return 0 }
  while uFieldElemTyIx.length <= ix { uFieldElemTyIx.push(-1) }
  uFieldElemTyIx[ix] = tyIx
  0
}

// The key half of struct `si`'s map field `fi`: true when the field's type is an i32-keyed
// map. The uncovered answer is false, string-keyed — the same self-heal shape the arena
// sidecar's -1 has, and the conservative one.
function sFieldElemKeyI32At(si: i32, fi: i32): boolean {
  sFieldRowKeyI32(sFieldStart[si] + fi)
}

// The flat-row form, for the passes that walk the whole field table by row index rather than
// by struct and field. `collectA`'s field re-derivation must not lose the key, because an
// inline `{m: {[i32]: V}}` shape is one `TypeRef` whose map never reaches the bare-map arm.
export function sFieldRowKeyI32(row: i32): boolean {
  if row >= sFieldElemKeyI32.length { return false }
  sFieldElemKeyI32[row] == 1
}

// The `sFieldElemKeyI32At` twin for variant fields (`uFieldElemKeyI32`).
export function uFieldElemKeyI32At(vi: i32, fi: i32): boolean {
  uFieldRowKeyI32(uFieldStart[vi] + fi)
}

// The `sFieldRowKeyI32` twin for the variant field table.
export function uFieldRowKeyI32(row: i32): boolean {
  if row >= uFieldElemKeyI32.length { return false }
  uFieldElemKeyI32[row] == 1
}

// The one home of which map struct `si`'s map field `fi` denotes — the shape vocabulary every
// map op site threads (`-1` mono string-keyed, `-4` mono i32-keyed, a `>= 0` mv slot). The
// field row's key column is the half a value-only lookup misses, so an i32-keyed map field
// would resolve its string-keyed twin's struct. Arena first, then the name resolver.
export function sFieldMapShape(si: i32, fi: i32): i32 {
  const ki = sFieldElemKeyI32At(si, fi)
  const a = mvSlotOfValTyK(sFieldElemTyIxAt(si, fi), ki)
  if a >= 0 { return a }
  const s = mvSlotOfValNameFindK(sFieldElemNameAt(si, fi), ki)
  if s == -1 { return mapMonoShapeOfKey(ki) }
  s
}

// The `sFieldMapShape` twin for a variant's map field, off the `uFieldElemTyIx` and
// `uFieldElemKeyI32` sidecars.
export function uFieldMapShape(vi: i32, fj: i32): i32 {
  const ki = uFieldElemKeyI32At(vi, fj)
  const a = mvSlotOfValTyK(uFieldElemTyIxAt(vi, fj), ki)
  if a >= 0 { return a }
  const s = mvSlotOfValNameFindK(variantFieldElemName(vi, fj), ki)
  if s == -1 { return mapMonoShapeOfKey(ki) }
  s
}

// The ref-list table slot for an arena element type — the arena-input entry point to the layer
// `repElemKey` already keys, so this is a lookup and not new design. It answers
// `rlSlotByName`'s first two rungs directly from the type; the third, the struct-twin name
// fallback, has no arena input and is not reproduced, so a caller keeps its name path for -1.
export function rlSlotOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  const key = repElemId(ty)
  if key < 0 { return -1 }
  let i = 0
  while i < rlElemKey.length {
    if rlElemKey[i] == key { return i }
    i = i + 1
  }
  -1
}

// The arena type a ref-list slot's stored element name denotes, or -1 when the sidecar does
// not cover the slot. The column pads on push, so a lagging or missing entry answers
// uncovered and every consumer keeps its element-name path.
function rlElemTyIxAt(slot: i32): i32 {
  if slot < 0 { return -1 }
  if slot >= rlElemTyIx.length { return -1 }
  rlElemTyIx[slot]
}

// ── the render-and-reparse round trip: is this node typed as a function ───────
// `nodeTyName` renders the node's recorded arena type and consumers took that render apart
// with a top-level `=>` scan. The dual is exact for every render it can produce — a `TyArray`
// parenthesizes a `TyFunc` element — so `typecheck.nodeTyIsFunc` is the one home.

// `refArrElemName`'s structural dual over a ref-list element type: peel one `TyNullable` hop,
// the `(S[] | null)[]` niche the name path recurses through, then take the `TyArray`'s
// element. -1 when the element is not an array, where the name path also declines.
export function tyRefArrElemOf(ty: i32): i32 {
  if ty < 0 { return -1 }
  let b = ty
  const t = T.tys[b]
  if t is TyNullable { b = t.nInner }
  if b < 0 { return -1 }
  const bt = T.tys[b]
  if bt is TyArray { return bt.aElem }
  -1
}

// The ref-list slot of a nested ref-list element's inner list — the arena reading of
// `rlSlotByName(refArrElemName(rlElemName[slot]))`. -1 when the sidecar does not cover the
// slot, the element is not an array, or no slot claims the element type; the caller then
// keeps its name path.
function rlInnerSlotOfElem(slot: i32): i32 {
  rlSlotOfTy(tyRefArrElemOf(rlElemTyIxAt(slot)))
}

// ── the ref-array annotation-node chokepoints ─────────────────────────────────
// The consumers ask which ref-list row holds an annotation's element — intern state, not shape
// — and whether it is a ref array, which that row existing answers. Deliberately not the
// structural test, since `nameIsRefArray` also requires the element be nameable by the layer.

// `1` when the type-annotation node's recorded arena type is a `TyNullable`, `0` when it is
// not, `-1` when the checker recorded no type for the node. The tri-state keeps uncovered
// distinguishable from not-nullable, so a caller never reads a missing row as a positive.
function annTyNulFlag(tyNodeIx: i32): i32 {
  if tyNodeIx < 0 { return -1 }
  const ty = nodeTyIxOf(tyNodeIx)
  // A node the checker never typed falls to the intern sidecar's flag, which the ref-array
  // arm records from the very spelling the name path would peel.
  if ty < 0 { return annRlNulAt(tyNodeIx) }
  const t = T.tys[ty]
  if t is TyNullable { return 1 }
  0
}

// ── the intern-pass annotation-node sidecar ───────────────────────────────────
// `collectA` resolves every ref-array annotation spelling into the ref-list table, and the row
// it interns is the row every annotation-node consumer asks for, so banking it per node turns
// their question into a lookup. The later annotation syntheses record here at their own sites.
export function recordAnnRlSlot(nodeIx: i32, slot: i32, nul: i32) {
  if nodeIx < 0 { return 0 }
  if slot < 0 { return 0 }
  while annRlSlot.length <= nodeIx {
    annRlSlot.push(-1)
    annRlNul.push(-1)
  }
  annRlSlot[nodeIx] = slot
  annRlNul[nodeIx] = nul
  0
}

// The element type-name the array literal at `nodeIx` has committed to through its first
// element's own annotation, or "" (D163). Written once, with scope, by `scanArrLitCommit`, and
// read by all three ref-list classifiers so they answer alike at the scope-less collect walk
// and at the scope-carrying emit.
export function recordArrLitCommitName(nodeIx: i32, name: string) {
  if nodeIx < 0 { return 0 }
  if name == "" { return 0 }
  while arrLitCommitName.length <= nodeIx { arrLitCommitName.push("") }
  arrLitCommitName[nodeIx] = name
  0
}

function arrLitCommitNameAt(nodeIx: i32): string {
  if nodeIx < 0 { return "" }
  if nodeIx >= arrLitCommitName.length { return "" }
  arrLitCommitName[nodeIx]
}

// The ref-list row the intern pass recorded for annotation node `nodeIx`, or -1.
function annRlSlotAt(nodeIx: i32): i32 {
  if nodeIx < 0 { return -1 }
  if nodeIx >= annRlSlot.length { return -1 }
  annRlSlot[nodeIx]
}

// The intern pass's `| null` flag for annotation node `nodeIx` (`1` a nullable ref
// array, `0` a bare one), or -1 when the node is not a recorded ref-array annotation.
function annRlNulAt(nodeIx: i32): i32 {
  if nodeIx < 0 { return -1 }
  if nodeIx >= annRlNul.length { return -1 }
  annRlNul[nodeIx]
}

// The ref-list table slot of the ref-array type a type-annotation node names — the arena
// reading of `rlSlotByName(refArrElemName(<the node's rendered name>))`. `tyRefArrElemOf`
// peels the same single `| null` hop the name path peels, so a `S[] | null` annotation
// resolves the same inner row. -1 when no recorded type, not an array, or no row claims it.
export function annRefArrSlot(tyNodeIx: i32): i32 {
  if tyNodeIx < 0 { return -1 }
  const a = rlSlotOfTy(tyRefArrElemOf(nodeTyIxOf(tyNodeIx)))
  if a >= 0 { return a }
  // The intern-pass sidecar: the row `collectA` interned for this node. Covers what the
  // recorded type cannot — a node the checker never typed, and an element the reflist layer
  // keys by a synthetic name no arena key can match.
  annRlSlotAt(tyNodeIx)
}

// `annRefArrSlot` restricted to a non-nullable annotation. The consumers that ask
// `nameIsRefArray` of the whole annotation get no for a `S[] | null` spelling, since the name
// predicate does not peel a top-level `| null`, so their arena leg must decline it too —
// without this gate `tyRefArrElemOf`'s nullable hop would answer where the name says no.
function annBareRefArrSlot(tyNodeIx: i32): i32 {
  if annTyNulFlag(tyNodeIx) != 0 { return -1 }
  annRefArrSlot(tyNodeIx)
}

// `annRefArrSlot` restricted to a nullable annotation (`<ref-array> | null`) — the dual of
// `annBareRefArrSlot`. The consumers that peel `nullablePartOf` first and decline a non-null
// spelling outright need the same restriction on the arena leg.
function annNulRefArrSlot(tyNodeIx: i32): i32 {
  if annTyNulFlag(tyNodeIx) != 1 { return -1 }
  annRefArrSlot(tyNodeIx)
}

// `structIdxOfElemName`'s structural dual: the struct-table row of a ref-list element type,
// peeling the `| null` niche exactly as the name path does before resolving. -1 when uncovered
// or not a declared row, where the caller keeps its name path.
function structIdxOfElemTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  let b = ty
  const t = T.tys[b]
  if t is TyNullable { b = t.nInner }
  structIndexOfTy(b)
}

// The struct-table row of a ref-list slot's element, off the arena sidecar.
function rlElemStructIdxAt(slot: i32): i32 {
  structIdxOfElemTy(rlElemTyIxAt(slot))
}

// The recorded element type of ref-list slot `slot` with its `| null` niche peeled —
// the arena reading of `nullablePartOf(rlElemName[slot])`, and the input the canon-key
// row rung keys on. -1 when the sidecar does not cover the slot.
function rlElemNonNulTyAt(slot: i32): i32 {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  ty
}

// Tri-state dual of `nullablePartOf(rlElemName[slot]) != ""`: `1` the element type
// is a `TyNullable`, `0` it is not, `-1` the sidecar does not cover the slot — the
// caller then keeps its name test, so the arena never answers where it cannot.
function rlElemTyNullableAt(slot: i32): i32 {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return 1 }
  0
}

// The `$fnsig` key of a closure-element ref-list slot, off the arena: peel the `| null` niche,
// since the narrowed indexed call casts to the same functype a non-null element does, then key
// the `TyFunc` spine directly rather than re-parsing the rendered signature. "" when uncovered
// or not a function type.
export function rlElemCloSigKeyAt(slot: i32): string {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return "" }
  let b = ty
  const t = T.tys[ty]
  if t is TyNullable { b = t.nInner }
  if b < 0 { return "" }
  const bt = T.tys[b]
  if bt is TyFunc { return sigKeyOfTy(b) }
  ""
}

// The inner ref-list slot of a nested or nullable ref-array element — the chokepoint the
// `rlSlotByName(refArrElemName(rlElemName[s]))` readers share. Arena first; the element-name
// surgery is the fall-through for a slot the sidecar does not cover, bound-guarded because
// `refListSlotOfExpr` clamps a miss to 0 and an empty `rlElemName` would trap (D1500).
export function rlElemInnerSlot(slot: i32): i32 {
  const ar = rlInnerSlotOfElem(slot)
  if ar >= 0 { return ar }
  if slot < 0 || slot >= rlElemName.length { return -1 }
  rlSlotOfArrName(rlElemName[slot])
}

// The interned ref-list slot of union member `m`'s ref-array arm — the arena reading of the
// four arm scanners' shared per-atom step. It asks the intern-state question directly: does
// the ref-list table hold a row for this member's element type, which is what all four
// consumers want. A bare-scalar array member cannot answer, a row's element never being one.
function unMemRefArrArmSlot(m: i32): i32 { rlSlotOfTy(tyRefArrElemOf(m)) }

// The struct-table row of a ref-list element — the chokepoint the
// `structIdxOfElemName(rlElemName[s])` readers share, in four rungs: arena identity through
// the `sTyIx` sidecar, nominal identity, the canon-key row off the recorded type, then the
// fieldset scan. Declining is not neutral: `mAssignTypeIndices` then writes a 0 heap (D208).
export function rlElemStructRow(slot: i32): i32 {
  const ln = nonNulBaseOf(rlElemName[slot])
  const bn = structIndexByName(ln)
  // The nominal floor, the exact complement of the read side's gate: a ref-list element whose
  // name is a registered union variant and not a registered plain struct has no struct-table
  // row, its heap being `uVarHeap[vi]`, so every rung below must decline. Keyed on the name
  // because variants are nominal, and it gates the arena rung too, ahead of it (D32).
  if bn < 0 && variantIndexOf(ln) >= 0 { return -1 }
  const ar = rlElemStructIdxAt(slot)
  if ar >= 0 { return ar }
  if bn >= 0 { return bn }
  const cr = repRowOfTyStruct(rlElemNonNulTyAt(slot), sScanLim())
  if cr >= 0 { return cr }
  // The fieldset scan, reached only where all three rungs above decline — exactly where the
  // alternative is the `rlElemHeap = 0` sentinel.
  structIndexOfTypeName(ln)
}

// The variant-table row of the same element — the other side of `rlElemStructRow`'s floor,
// written as one predicate so the two cannot disagree about which table owns a name. -1 for a
// plain struct element, an unregistered name, and a name the struct table claims. Nominal by
// construction: a name scan over `uVariants`, so a `{r:i32}` render must not match an arm.
export function rlElemVariantRow(slot: i32): i32 {
  const ln = nonNulBaseOf(rlElemName[slot])
  if structIndexByName(ln) >= 0 { return -1 }
  variantIndexOf(ln)
}

// The array-literal element's struct row: the same arena leg, but the fall-through is the
// nominal `structIndexByName`, not the structural bridge `structIdxOfElemName` adds. A -1 here
// routes on to the concrete-variant lookup, so widening the name leg would change which arm
// answers.
export function rlElemLitStructRow(slot: i32): i32 {
  const ar = rlElemStructIdxAt(slot)
  if ar >= 0 { return ar }
  const ln = nonNulBaseOf(rlElemName[slot])
  structIndexByName(ln)
}

// Whether a ref-list slot's element is a nullable niche: the arena test
// (`T.tys[..] is TyNullable`) first, `nullablePartOf`'s render test for an uncovered row.
function rlElemIsNulNiche(slot: i32): boolean {
  const ar = rlElemTyNullableAt(slot)
  if ar >= 0 { return ar == 1 }
  nullablePartOf(rlElemName[slot]) != ""
}

// The `$fnsig` key of a closure-element ref-list slot: the arena keys the `TyFunc`
// spine directly (`sigKeyOfTy`), so the grouping-paren strip and `annSigKey` re-parse
// of the rendered element name is the fall-through only (D5-final).
export function rlElemCloSigKey(slot: i32): string {
  const ar = rlElemCloSigKeyAt(slot)
  if ar != "" { return ar }
  const nm = nonNulBaseOf(rlElemName[slot])
  // The paren-span test (`nameIsParenSpanEnds`, first/last char, no balance walk)
  // already declines any name under 2 chars; a balanced walk would wrongly re-key `(a)|(b)`.
  if !nameIsParenSpanEnds(nm) { return "" }
  // `groupInnerOf` is the paired cut; it has no endpoint test of its own, so the span
  // check above must run first (the brace-shaped call sites below share this cut).
  annSigKey(groupInnerOf(nm))
}

// The mv slot of a map-element ref-list slot's inner value. `peelNul` strips one
// `TyNullable` hop before asking (the twin comparator and the nested-map read don't
// peel). Answers only a real slot (>= 0); every negative — uncovered, not a map, no
// claiming row — collapses to one result and must never be read as "mono" (D3').
export function rlElemMapValMvSlotAt(slot: i32, peelNul: boolean): i32 {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return -1 }
  let b = ty
  const t = T.tys[b]
  if peelNul {
    if t is TyNullable { b = t.nInner }
  }
  if b < 0 { return -1 }
  const bt = T.tys[b]
  // The slot's key comes off the same `TyMap` its value does — one hop, both halves.
  if bt is TyMap { return mvSlotOfValTyK(bt.mVal, tyMapKeyIsI32(b)) }
  -1
}

// The key half of the same element question: `1` an i32-keyed map, `0` string-keyed,
// `-1` the sidecar doesn't cover the slot or it isn't a map (caller keeps its name
// leg). Always peels one `TyNullable` — a `{[i32]: V} | null` element carries the same
// map struct as its non-null twin, so its key must answer the same way.
export function rlElemMapKeyI32(slot: i32): boolean {
  const ar = rlElemMapKeyI32At(slot)
  if ar >= 0 { return ar == 1 }
  let en = rlElemName[slot]
  const enn = nulMapInnerName(en)
  if enn != "" { en = enn }
  nameIsI32KeyedMap(en)
}

function rlElemMapKeyI32At(slot: i32): i32 {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return -1 }
  let b = ty
  const t = T.tys[b]
  if t is TyNullable { b = t.nInner }
  if b < 0 { return -1 }
  const bt = T.tys[b]
  if bt is TyMap {
    if tyMapKeyIsI32(b) { return 1 }
    return 0
  }
  -1
}

// The map shape a `Map()` must build to sit in ref-list slot `slot`'s element position:
// arena first, then the element-name leg. `-1`/`-4` the mono struct of the element's key
// rep, `>= 0` the element's own (key, value) mv slot, `-3` a value the mv layer doesn't
// intern (`emitMapNew`'s reject). Only meaningful when the element kind is a map (3).
export function rlElemMapShape(slot: i32): i32 {
  const ar = rlElemMapValMvSlotAt(slot, true)
  if ar >= 0 { return ar }
  let en = rlElemName[slot]
  const enn = nulMapInnerName(en)
  if enn != "" { en = enn }
  mvShapeOfMapName(en)
}

// The mv slot a map-element ref-list slot's value occupies — the chokepoint the
// `mvSlotOfMapValNameOrMono(mapValNameOf(rlElemName[s]))` readers share. Arena first
// (`rlElemTyIx` to the `TyMap`'s value to `mvSlotOfTy`), and only for a real slot: the
// name resolver's `-1` (mono) and `-3` (unsupported) answers stay its own (D5-final).
export function rlElemMapValMvSlot(slot: i32): i32 {
  const ar = rlElemMapValMvSlotAt(slot, false)
  if ar >= 0 { return ar }
  mvSlotOfMapName(rlElemName[slot])
}

// `rlElemMapValMvSlot` for a slot whose element may be a nullable map: the arena leg
// peels one `TyNullable`, the name leg the `nulMapInnerName` spelling, before asking
// for the value's slot. Same sentinel discipline.
function rlElemNulMapValMvSlot(slot: i32): i32 {
  const ar = rlElemMapValMvSlotAt(slot, true)
  if ar >= 0 { return ar }
  let cen = rlElemName[slot]
  const cnin = nulMapInnerName(cen)
  if cnin != "" { cen = cnin }
  mvSlotOfMapName(cen)
}

// The arena type a map-value slot's stored value name denotes, or -1 when the sidecar
// doesn't cover the slot. `mvValTyIx` pads on push and resets per program, so a lagging
// or stale row answers "uncovered" and every consumer falls to its value-name path.
function mvValTyIxAt(slot: i32): i32 {
  if slot < 0 { return -1 }
  if slot >= mvValTyIx.length { return -1 }
  mvValTyIx[slot]
}

// The inner ref-list slot of a ref-list-valued map slot — the arena reading of
// `rlSlotByName(refArrElemName(mvValName[slot]))`. A slot is a rep question (D2), so it
// resolves through `rlSlotOfTy`/`repElemKey`, never `repCanonKey`. -1 when the sidecar
// doesn't cover the slot, the value isn't an array, or no ref-list slot claims the element.
function mvValInnerRlSlotAt(slot: i32): i32 {
  rlSlotOfTy(tyRefArrElemOf(mvValTyIxAt(slot)))
}

// The mv slot of a nested map-valued slot's inner value — the arena reading of
// `mvSlotOfMapValNameOrMono(mapValNameOf(mvValName[slot]))`. Answers only a real slot
// (>= 0); every negative falls through to the name path, and no caller can see the
// arena's miss value, so a miss here can never be read as "mono" (D3').
function mvValInnerMvSlotAt(slot: i32, peelNul: boolean): i32 {
  const ty = mvValTyIxAt(slot)
  if ty < 0 { return -1 }
  let b = ty
  const t = T.tys[ty]
  // `peelNul` strips one `TyNullable` hop: a `{[K]: V} | null` value rides its non-null
  // twin's struct, so a caller wanting the backing shape (not just "is this a map") needs it.
  if peelNul {
    if t is TyNullable { b = t.nInner }
  }
  if b < 0 { return -1 }
  const bt = T.tys[b]
  if bt is TyMap { return mvSlotOfValTyK(bt.mVal, tyMapKeyIsI32(b)) }
  -1
}

// Tri-state dual of `unionHasAtomTy(mvValName[slot], "null", false)` over a boxed-union
// map value: `1` admits null, `0` doesn't, `-1` the sidecar doesn't cover the slot or the
// type isn't a union (caller keeps its member-set test).
function mvValUnionHasNullAt(slot: i32): i32 {
  const ty = mvValTyIxAt(slot)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return 1 }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const mt = T.tys[t.uMembers[i]]
      if mt is TyPrim {
        if mt.primName == "null" { return 1 }
      }
      if mt is TyNullable { return 1 }
      i = i + 1
    }
    return 0
  }
  -1
}

// The single non-null member of a nullable value type (`TyNullable`'s inner, or the one
// non-null member of an `X | null` union) — `nulRefMapValInnerOf`'s structural front
// half. -1 unless the type is exactly one non-null member plus null.
function tyNulSoloMember(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  if t is TyUnion {
    let solo = -1
    let nonNull = 0
    let hasNull = false
    let i = 0
    while i < t.uMembers.length {
      const mt = T.tys[t.uMembers[i]]
      let isNull = false
      if mt is TyPrim {
        if mt.primName == "null" { isNull = true }
      }
      if isNull {
        hasNull = true
      } else {
        nonNull = nonNull + 1
        solo = t.uMembers[i]
      }
      i = i + 1
    }
    if !hasNull { return -1 }
    if nonNull != 1 { return -1 }
    return solo
  }
  -1
}

// The function type under a nullable one (`((i32) => i32) | null`) — the inner `TyFunc`'s
// arena index, or -1 when `ty` isn't a nullable function type. Sees through both nullable
// encodings (`TyNullable`, and the two-arm `X | null` union) and through a declared alias
// body, so the result is always a type `sigKeyOfTy` can key directly.
export function tyNulFuncInner(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t0 = T.tys[ty]
  let nullable = false
  if t0 is TyNullable { nullable = true }
  if t0 is TyUnion { nullable = true }
  if !nullable { return -1 }
  let inner = tyNulSoloMember(ty)
  if inner < 0 { return -1 }
  // Peels the degenerate one-member alias wrapper the same way `tyDenotesFunc` walks it,
  // so the returned index is always a `TyFunc`.
  let steps = 0
  while inner >= 0 && inner < T.tys.length && steps < 8 {
    const it = T.tys[inner]
    if it is TyFunc { return inner }
    if it is TyUnion {
      if it.uMembers.length != 1 { return -1 }
      inner = it.uMembers[0]
      steps = steps + 1
    } else {
      return -1
    }
  }
  -1
}

// Tri-state dual of `nulRefMapValInnerOf(mvValName[slot]) != ""` — is the slot's value a
// niche-nullable ref (string / map / closure / struct, plus null)? `1` yes, `0` no, `-1`
// the arena declines (uncovered, or a shape the struct table doesn't claim). Declining is
// the safe direction: the caller keeps its rendered-name test.
function mvValNulRefNicheAt(slot: i32): i32 {
  const ty = mvValTyIxAt(slot)
  if ty < 0 { return -1 }
  const t0 = T.tys[ty]
  let nullable = false
  if t0 is TyNullable { nullable = true }
  if t0 is TyUnion { nullable = true }
  if !nullable { return 0 }
  const inner = tyNulSoloMember(ty)
  if inner < 0 { return 0 }
  const it = T.tys[inner]
  if it is TyPrim {
    if it.primName == "string" { return 1 }
    return 0
  }
  if it is TyMap { return 1 }
  if it is TyFunc { return 1 }
  // A list member can be a niche, but only for reps the name path's kind-6 pair names;
  // that distinction lives in intern state, not the shape, so this declines (-1).
  if it is TyArray { return -1 }
  if it is TyObj {
    if structIndexOfTy(inner) >= 0 { return 1 }
    return -1
  }
  -1
}

// `valueAtomKind`'s arena dual over a union member type: same code vocabulary (0 i32 ·
// 1 boolean · 2 string · 3 i64 · 4 f64 · 5 f32 · 6 null · 7 i32-list · 8 f64-list ·
// 9 string-list · 10 i64-list · 11 closure · 12 f32-list). `-1` is the arena declining,
// never "not an atom" — every consumer falls through.
function tyValueAtomKindOf(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyPrim {
    if t.primName == "i32" { return 0 }
    if t.primName == "boolean" { return 1 }
    if t.primName == "string" { return 2 }
    if t.primName == "i64" { return 3 }
    if t.primName == "f64" { return 4 }
    if t.primName == "f32" { return 5 }
    if t.primName == "null" { return 6 }
    return -1
  }
  if t is TyFunc { return 11 }
  if t is TyArray {
    if tyIsI32LeafElem(t.aElem) { return 7 }
    if tyIsStrLeafElem(t.aElem) { return 9 }
    const et = T.tys[t.aElem]
    if et is TyPrim {
      if et.primName == "f64" { return 8 }
      if et.primName == "i64" { return 10 }
      if et.primName == "f32" { return 12 }
    }
    return -1
  }
  -1
}

// Tri-state dual of `mvUnionIsScalarNull`'s value test: is the boxed union value exactly
// `<scalar> | null` (so the fused `?? d` peels to the raw unboxed scalar)? `1` yes, `0`
// no, `-1` the arena declines (uncovered, or an unclassified member) — caller keeps its
// atom-set path.
function mvValUnionScalarNullAt(slot: i32): i32 {
  const ty = mvValTyIxAt(slot)
  if ty < 0 { return -1 }
  const solo = tyNulSoloMember(ty)
  if solo < 0 { return 0 }
  const ak = tyValueAtomKindOf(solo)
  if ak < 0 { return -1 }
  if ak == 2 { return 0 }
  if ak == 6 { return 0 }
  1
}

// The inner ref-list slot of a ref-list-valued map slot — the chokepoint the three
// `rlSlotByName(refArrElemName(mvValName[s]))` readers share. Arena first (`mvValTyIx`
// to the `TyArray`'s element to `rlSlotOfTy`); the value-name surgery is the untouched
// fall-through for a slot the sidecar doesn't cover (D5-final).
export function mvValInnerRlSlot(slot: i32): i32 {
  const ar = mvValInnerRlSlotAt(slot)
  if ar >= 0 { return ar }
  // The fall-through's key hint reads the same `mvValName` cell that feeds `mvValTyIx`,
  // so the arena peel and the name peel are one row and cannot disagree.
  rlSlotOfArrNameTy(mvValName[slot], tyRefArrElemOf(mvValTyIxAt(slot)))
}

// The mv slot of a nested-map value's inner value. Arena first (`mvValTyIx` to the
// `TyMap`'s value to `mvSlotOfTy`), and only for a real slot: the name resolver's `-1`
// (mono) and `-3` (unsupported) answers are its own, never the arena's miss (D5-final).
function mvValInnerMvSlot(slot: i32): i32 {
  const ar = mvValInnerMvSlotAt(slot, false)
  if ar >= 0 { return ar }
  mvSlotOfMapName(mvValName[slot])
}

// `mvValInnerMvSlot` for a slot whose value may be a nullable map: the arena leg peels
// one `TyNullable`, the name leg the `nulMapInnerName` spelling, before asking for the
// inner value's slot. Same sentinel discipline as `rlElemNulMapValMvSlot`.
function mvValNulInnerMvSlot(slot: i32): i32 {
  const ar = mvValInnerMvSlotAt(slot, true)
  if ar >= 0 { return ar }
  let vn = mvValName[slot]
  const vnn = nulMapInnerName(vn)
  if vnn != "" { vn = vnn }
  mvSlotOfMapName(vn)
}

// Does a boxed-union map value admit `null`? Arena first (a `TyNullable`, or a `TyUnion`
// with a null member); the union member-set test is the fall-through for a value the
// sidecar doesn't cover (D5-final).
export function mvValUnionHasNull(slot: i32): boolean {
  const ar = mvValUnionHasNullAt(slot)
  if ar >= 0 { return ar == 1 }
  unionHasAtomTy(mvValName[slot], "null", false)
}

// The canonical structural identity of a map-value slot — the `mvTwin` comparator's
// input. Arena first (`repCanonId` over the recorded index, computed at query time so
// an in-place arena mutation moves both sides together), `repNameCanonId` by name for
// an uncovered row. Neither leg builds a spelling; both answer in ids (D5-final).
export function mvValCanonId(slot: i32): i32 {
  const ty = mvValTyIxAt(slot)
  if ty >= 0 { return repCanonId(ty) }
  repNameCanonId(mvValName[slot])
}

// ── the struct-row arena index ───────────────────────────────────────────────
// Push-only column (`recordSTyIx` pads with -1 and pushes), first match wins,
// reset explicitly per program since a watermark can't see `collectS`'s reset.
// Keyed by arena index — a dense space, so a plain array beats a map; -1 entries skipped.
let sTyRow: i32[] = []
let sTyRowLen = 0

export function structTyIxReset() {
  sTyRow = []
  sTyRowLen = 0
  0
}

function sTyRowSync() {
  if sTyRowLen > sTyIx.length { structTyIxReset() }
  while sTyRowLen < sTyIx.length {
    const ty = sTyIx[sTyRowLen]
    if ty >= 0 {
      while sTyRow.length <= ty { sTyRow.push(-1) }
      if sTyRow[ty] < 0 { sTyRow[ty] = sTyRowLen }
    }
    sTyRowLen = sTyRowLen + 1
  }
  0
}

// The struct-table row for an arena type — `structIndexByName`'s arena-input twin,
// scanning `sTyIx` (the arena type each row denotes) instead of the name column, same
// first-match-wins order. -1 when the sidecar doesn't cover the row, so it never matches
// a real type and the caller falls through to its name path.
export function structIndexOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  sTyRowSync()
  if ty >= sTyRow.length { return -1 }
  sTyRow[ty]
}

// The struct-table row a nested-struct field (code 15) targets — the chokepoint every
// code-15 consumer shares (default / literal seed / struct-eq / type section / closure
// scan / optional-chain). Arena first (`sFieldElemTyIx` to `structIndexOfTy`), then the
// recorded name (`structIndexByName`) for a row the sidecar doesn't cover.
export function sFieldTgtStructIdx(si: i32, fi: i32): i32 {
  const a = structIndexOfTy(sFieldElemTyIxAt(si, fi))
  if a >= 0 { return a }
  structIndexByName(sFieldElemNameAt(si, fi))
}

// The `sFieldTgtStructIdx` twin for a variant's nested-struct field, with one extra rung:
// the arm twin. A variant's fields are recorded before the struct table exists, so an
// arm-typed field banks the arm's own name and no `sNames` row ever carries it;
// `armFieldStructRow` is the same resolver asked one phase later, once the mint has run.
export function uFieldTgtStructIdx(vi: i32, fi: i32): i32 {
  const a = structIndexOfTy(uFieldElemTyIxAt(vi, fi))
  if a >= 0 { return a }
  const nm = uFieldElemName[uFieldStart[vi] + fi]
  const bn = structIndexByName(nm)
  if bn >= 0 { return bn }
  armFieldStructRow(nm)
}

// True if struct `si`'s field `fi` is a literal-union atom field (code 0 whose recorded
// elem name is a literal union) — construction/read/assign seed the atom rep for it.
export function sFieldIsLitUnion(si: i32, fi: i32) {
  if sFieldTypeAt(si, fi) != 0 { return false }
  // Arena leg: the sidecar records the arena type the field's element name denotes, so
  // this answers structurally instead of re-classifying the rendered spelling. Tests
  // `tyIsLitUnionOrLit`, not `tyIsLitUnion` — a one-member set is atom material at both
  // of its spellings (D1460), reachable here only through `promoteLitFieldToAtom`.
  const ety = sFieldElemTyIxAt(si, fi)
  if ety >= 0 { return tyIsLitUnionOrLit(ety) }
  const r = nameIsLitUnionType(sFieldElemNameAt(si, fi))
  r
}

// True if struct `si`'s field `fi` is an atom-array field (`f: K[]` — code 4 whose recorded
// elem name is a litunion array). The field IS the i32 list; construction/assign seed the
// atom-element context so member literals build the i32 backing (not a string list whose
// wrapper ref would mismatch the field type).
export function sFieldIsLitUnionArray(si: i32, fi: i32) {
  if sFieldTypeAt(si, fi) != 4 { return false }
  // Arena leg (`sFieldIsLitUnion`'s array sibling): a code-4 field records its array
  // type name, so `tyIsLitUnionArray` reads the `TyArray` structurally.
  const ety = sFieldElemTyIxAt(si, fi)
  if ety >= 0 { return tyIsLitUnionArray(ety) }
  const r = nameIsLitUnionArray(sFieldElemNameAt(si, fi))
  r
}

// The union-variant twin of `sFieldIsLitUnionArray`: variant `vi`'s field `fj` is an
// atom-array field (`f: K[]`, code 4 with a recorded litunion-array element name) — the
// variant payload build seeds the atom context so the literal builds the i32 list of
// atom ids, not a string list.
export function variantFieldIsLitUnionArray(vi: i32, fj: i32) {
  if variantFieldTypeAt(vi, fj) != 4 { return false }
  // Arena leg, off the `uFieldElemTyIx` sidecar (the struct twin above).
  const ety = uFieldElemTyIxAt(vi, fj)
  if ety >= 0 { return tyIsLitUnionArray(ety) }
  nameIsLitUnionArray(variantFieldElemName(vi, fj))
}

// The union-variant twin of `sFieldIsLitUnion`: variant `vi`'s field `fj` is a
// literal-union atom field (code 0 with a recorded litunion element name), so the
// variant payload build and the atom-read classifier seed the atom rep for it — the
// chokepoint for `emitVariantStruct`'s construct arm and `exprIsLitAtom`'s member read.
export function variantFieldIsLitUnion(vi: i32, fj: i32) {
  if variantFieldTypeAt(vi, fj) != 0 { return false }
  // `tyIsLitUnionOrLit`, for `sFieldIsLitUnion`'s reason (D1460).
  const ety = uFieldElemTyIxAt(vi, fj)
  if ety >= 0 { return tyIsLitUnionOrLit(ety) }
  nameIsLitUnionType(variantFieldElemName(vi, fj))
}

// ── the struct-row name index ────────────────────────────────────────────────
// Incremental, not rebuilt on demand: `sNames` is push-only within a program, so the
// index scans only rows past its watermark, first match wins. Reset is explicit
// (`structNameIxReset`) — a watermark alone can't see `collectS` resetting `sNames`.
let sNameIx: {[string]: i32} = Map()
let sNameIxLen = 0

export function structNameIxReset() {
  sNameIx = Map()
  sNameIxLen = 0
  0
}

function sNameIxSync() {
  // Defensive, and free: a table that shrank without the explicit reset would otherwise
  // answer from a longer past; costs one compare per query.
  if sNameIxLen > sNames.length { structNameIxReset() }
  while sNameIxLen < sNames.length {
    const nm = sNames[sNameIxLen]
    if (sNameIx[nm] ?? -1) < 0 { sNameIx[nm] = sNameIxLen }
    sNameIxLen = sNameIxLen + 1
  }
  0
}

// The struct table index whose name is `name`, or -1 if `name` is not a declared struct type.
export function structIndexByName(name: string) {
  sNameIxSync()
  sNameIx[name] ?? -1
}

// The number of fully-collected struct entries — the scan bound for any matcher reading
// a struct's field metadata. During `collectS`'s field-coding loop the in-flight
// declaration has `sNames` pushed but `sFieldCount` not yet, and `fieldTypeCode` can
// re-enter these matchers, so a raw `sNames.length` bound would read `sFieldCount` out of bounds.
function sScanLim() {
  let n = sNames.length
  if sFieldCount.length < n { n = sFieldCount.length }
  if sFieldStart.length < n { n = sFieldStart.length }
  n
}

// The struct table index whose field-name set matches the object literal at `objIx`
// exactly (same count, every literal field present in the struct), or -1 if none
// matches — the struct analogue of `objVariantName`, disambiguating which struct an
// `{ … }` literal constructs.
export function structIndexOfObj(objIx: i32) { structIndexOfObjCtx(objIx, -1) }

// Can an object literal's field value (coded `vc`) be stored into struct `si`'s field
// `mfi` (coded `sc`)? Refutation only, on three standing leniencies: `vc < 0`, a union
// box field (16, which accepts every atom), and an equal code. Composite-code arms
// refute only against an anonymous row — a declared field's code can differ through adoption/boxing.
function anonValueFitsField(vc: i32, sc: i32, valIx: i32, si: i32, mfi: i32) {
  if vc < 0 { return true }
  if sc == 16 {
    // A nested-object literal isn't an atom: it fits a box field (16) only where the
    // box's own member set has a struct arm to hold it (D1242).
    if vc == 15 { return unionSetCanHoldStruct(sFieldElemNameAt(si, mfi)) }
    return true
  }
  const anonRow = sIsAnonRow(si)
  if vc == sc {
    // A nested-struct field (code 15) must also agree on which struct: refuting needs
    // both target names known, so an un-interned inner literal ("") keeps the lenient match.
    if vc == 15 && anonRow {
      const vn = anonFieldElemName(valIx, 15)
      const fn = sFieldElemNameAt(si, mfi)
      if vn != "" && fn != "" && vn != fn { return false }
    }
    return true
  }
  if vc == 0 {
    // `boolean | null` (21) is an i32-sentinel niche only a boolean value fills — an
    // integer collides with the sentinel, so `isBoolLitExpr` asks the node directly.
    if sc == 21 { return isBoolLitExpr(valIx) }
    // `K | null` — the i32 atom niche, spare value -1.
    if sc == 30 { return true }
    // Wider numeric/map slots (i64 23, f32 24, map 19/29): a declared field can reach
    // these via checker adoption, but an anon row's numeric field carries no such promise.
    if sc == 23 || sc == 24 || sc == 19 || sc == 29 { return !anonRow }
    return false
  }
  if vc == 3 {
    // A code-0 field is a plain i32/boolean slot unless it's a literal-union atom slot
    // (recorded in `sFieldElemName`), which a string literal legitimately writes.
    if sc == 0 { return sFieldElemNameAt(si, mfi) != "" }
    // `string | null` (the same ref, nullable) and `K | null` (a string literal names
    // the atom) are the two niches a string value fills.
    if sc == 20 { return true }
    if sc == 30 { return true }
    return false
  }
  // Composite value codes, anon rows only (a declared row's codes can differ through
  // adoption). Each widens into one nullable spelling of its own backing: `i32[] | null`,
  // `((…) => …) | null`, f64 for f32, `f64[] | null`, `i64[] | null`. A nested-struct
  // ref (15) matches only code 15 or the union box (16).
  if !anonRow { return true }
  if vc == 4 { return sc == 18 }
  if vc == 14 { return sc == 22 }
  if vc == 24 { return sc == 17 }
  if vc == 25 { return sc == 32 }
  if vc == 26 { return sc == 33 }
  if vc == 15 { return false }
  true
}

// True if struct-table row `si` is an anonymous shape — one `collectAnonShapes` minted
// from an object literal under a synthetic `#anonN` name, rather than a declared `type`
// or inline-shape annotation. An anon row's codes read directly off the literal (exact); a
// declared row's come from an annotation the checker can reach with values the code omits.
function sIsAnonRow(si: i32) {
  if si < 0 || si >= sNames.length { return false }
  const nm = sNames[si]
  nm.length >= 5 && nm.slice(0, 5) == "#anon"
}

// The arena row an interned anonymous shape handle `nm` names, or -1. `#anonN` is a name
// the checker's annotation grammar cannot parse back, so a monomorphizer pin sourced from
// it needs a real row rather than the coarse field-less placeholder. Keyed on the name
// alone (a pure function of it), matching the instance registry's own key (D681).
export function anonHandleTyIx(nm: string): i32 {
  const si = structIndexByName(nm)
  if si < 0 { return -1 }
  if !sIsAnonRow(si) { return -1 }
  if si >= sTyIx.length { return -1 }
  sTyIx[si]
}

// A memo over `structIndexOfObjCtxGo`, keyed by node index and the querying `fnIx` (the
// f64 axis is per-instance). A hit is stable since rows only append, so an existing
// first match stays first; a miss is stamped with the row count and only recomputed
// once the table grows. Reset per program in `collectS` (`sioMemoReset`).
let sioMemoIx: i32[] = []
let sioMemoFn: i32[] = []
let sioMemoVer: i32[] = []
export function sioMemoReset() {
  sioMemoIx = []
  sioMemoFn = []
  sioMemoVer = []
}

// The row a `??`-joined literal builds at, once the merge is decided: redirects every
// reader of a literal's row to the merged destination, keyed on the literal being a join
// mark (not a row), so an unrelated same-fieldset literal is untouched. Applied outside
// the memo, whose cached value is the pre-merge answer (D882).
export function anonLeafJoinRowOf(objIx: i32, si: i32): i32 {
  if !anonLeafEmitPhase { return si }
  if si < 0 { return si }
  if objIx < 0 { return si }
  if objIx >= anonLeafJoined.length { return si }
  if anonLeafJoined[objIx] != 1 { return si }
  anonLeafSupersedeOf(si)
}

export function structIndexOfObjCtx(objIx: i32, fnIx: i32) {
  anonLeafJoinRowOf(objIx, structIndexOfObjCtxMemo(objIx, fnIx))
}

function structIndexOfObjCtxMemo(objIx: i32, fnIx: i32) {
  while sioMemoIx.length <= objIx {
    sioMemoIx.push(0 - 2)
    sioMemoFn.push(0 - 2)
    sioMemoVer.push(0 - 1)
  }
  if sioMemoIx[objIx] != 0 - 2 && sioMemoFn[objIx] == fnIx {
    // A hit requires the row count unchanged even for a prior success: an append can
    // turn a single name-match into an ambiguous one, changing which resolution arm fires.
    if sioMemoVer[objIx] == sNames.length { return sioMemoIx[objIx] }
  }
  const r = structIndexOfObjCtxGo(objIx, fnIx)
  sioMemoIx[objIx] = r
  sioMemoFn[objIx] = fnIx
  sioMemoVer[objIx] = sNames.length
  r
}

// The context-aware variant: `fnIx` (when >= 0) classifies field values through the
// expression family too, so a monomorphized instance's shared tail literal
// (`{ x: self.x + b.x }`) resolves per instance — f64 against f64, i32 against i32.
function structIndexOfObjCtxGo(objIx: i32, fnIx: i32) {
  const o = P.nodes[objIx]
  if o is ObjLit {
    const nf = o.objFields.length
    // The name-only scan can match several structs at once (a string literal fits both
    // `{f: string}` and litunion-atom `{f: K0}`); ambiguity defers to the checker's recorded type.
    let firstSi = -1
    let matches = 0
    // A stricter first match: the first candidate whose code-15 fields also align with
    // code-15/16 fields, tracked beside the lenient `matches` as the tiebreak of last resort.
    let strictSi = -1
    let strictCount = 0
    let si = 0
    const sLimA = sScanLim()
    while si < sLimA {
      if sFieldCount[si] == nf {
        let ok = true
        let strict = true
        let k = 0
        while k < nf {
          const f = P.nodes[o.objFields[k]]
          if f is FieldInit {
            const mfi = sFieldIndex(si, f.fiName)
            if mfi < 0 {
              ok = false
              strict = false
            } else {
              // An `{x}` literal name-matches both the i32 and f64 `{x}` shapes, so
              // split on the value's floatness: `{x: 1.5}` builds f64, `{x: 1}` i32.
              const sc = sFieldTypeAt(si, mfi)
              const vc = anonFieldCode(f.fiValue)
              let isFloat = vc == 17
              if !isFloat && fnIx >= 0 {
                if exprIsF64(f.fiValue, fnIx) { isFloat = true }
              }
              if isFloat {
                if sc != 17 && sc != 24 && sc != 16 { ok = false }
              } else if vc == 23 {
                // An i64-coded value (a magnitude literal, or one adopted to i64 by
                // the checker) must not match an i32-field shape and store an i64 into it.
                if sc != 23 && sc != 16 { ok = false }
              } else if vc == 19 {
                // An mv slot's identity is the (key, value) pair, so a `Map()` field value
                // aligns only with a map field whose row names that same pair, not just any map.
                if sc != 19 && sc != 16 { ok = false }
                if sc == 19 {
                  if (
                    sFieldElemKeyI32At(si, mfi) !=
                    anonFieldElemKeyI32(f.fiValue, vc)
                  ) {
                    ok = false
                  }
                  if (
                    sFieldElemNameAt(si, mfi) !=
                    anonFieldElemName(f.fiValue, vc)
                  ) {
                    ok = false
                  }
                }
              } else if sc == 17 {
                if fnIx >= 0 || vc >= 0 { ok = false }
              } else if !anonValueFitsField(vc, sc, f.fiValue, si, mfi) {
                // The remaining value axes, of which the f64 and i64 checks are special cases.
                ok = false
              }
              // A nested object-literal field value aligns only with a nested-struct (15)
              // or union-box (16) field; this narrows `strictSi` only, `matches` stays lenient.
              if vc == 15 && sc != 15 && sc != 16 { strict = false }
            }
          } else {
            ok = false
            strict = false
          }
          k = k + 1
        }
        if ok {
          if firstSi < 0 { firstSi = si }
          matches = matches + 1
          if strict {
            if strictSi < 0 { strictSi = si }
            strictCount = strictCount + 1
          }
        }
      }
      si = si + 1
    }
    // When exactly one candidate's code-15 fields align with code-15/16 fields while
    // others don't (the rest are field-code incompatible), that candidate is definitively
    // correct and wins before the name/arena resolvers run — which can otherwise return
    // the wrong same-fieldset niche twin for a lambda-body literal with a mis-recorded type.
    if matches >= 2 && strictCount == 1 && strictSi >= 0 { return strictSi }
    if matches >= 2 {
      // A genuine shape collision (name/scalar-code alone matched 2+ structs): consult
      // the checker's recorded type for this literal, resolving through
      // `structIndexOfTypeName`'s field-type-guarded match, and fall back to first match
      // only when the node carries no recorded type (an emit-time-cloned mono node).
      if nodeTyIsObj(objIx) {
        // Consults the checker's adopted arena type for this literal (`nodeRepTyIxOf`)
        // through `repRowOfTyStruct` first, ahead of any render-derived match — this is
        // the row the literal's proven type names. Falls to the name path only when the
        // node is uncovered (no rep type, not a `TyObj`, an empty key, or an unguessable collision).
        const nsi = repRowOfTyStruct(nodeRepTyIxOf(objIx), sLimA)
        if nsi >= 0 { return nsi }
        // The field set, asked of the type directly (`structRowOfObjFieldSet`), rather
        // than re-deriving a spelling of it from a render.
        const fsi = structRowOfObjFieldSet(nodeTyIxOf(objIx))
        if fsi >= 0 { return fsi }
      }
      // The name path didn't resolve, so this trusts the checker's recorded arena type
      // structurally (`repRowOfTyStruct`) over the fieldset-count heuristic `firstSi`.
      // Safe because an `sTwin` spelling-twin keys the same `$fnsig` digit as its
      // representative; `repRowOfTyStruct` still declines an ambiguous canon-key collision.
      const xr = repRowOfTyStruct(nodeRepTyIxOf(objIx), sLimA)
      if xr >= 0 { return xr }
      // When the name/arena resolvers can't decide (a lambda-body literal with no
      // recorded type), prefer the candidate whose code-15 fields align with code-15/16
      // fields over plain `firstSi` — `{f: {a: false}}` resolves to the code-15 struct
      // instead of a same-fieldset niche twin like `{f: boolean | null}`.
      if strictSi >= 0 { return strictSi }
    }
    return firstSi
  }
  -1
}

// True if lifted function `fe` has any un-annotated parameter — a generic whose param is
// a per-call-site inference hole. Such a function monomorphizes per direct call but
// i32-defaults when taken as a value, so the value site rejects it.
export function fnHasUnannotatedParam(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType < 0 { return true }
      }
      i = i + 1
    }
  }
  false
}

// The leaf field's wasm type code of an optional chain (`x?.y`, `o?.inner?.y`) — the
// `sFieldTypeAt` of the last link, or -1 when `exprIx` isn't a resolvable chain. The
// chokepoint for "what rep does a `?.` deliver" (`exprNullableString`, `exprUnion`); the
// consumer-side twin of what `emitOptMemberValue`'s `?? d` arm resolves by hand.
function optChainLeafFieldCode(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    const si = optChainStructIdxOf(e.omObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.omProp)
      if fi >= 0 { return sFieldTypeAt(si, fi) }
    }
  }
  -1
}

export function optChainStructIdxOf(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 { return -1 }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 { return -1 }
    if sFieldTypeAt(psi, pfi) != 15 { return -1 }
    return sFieldTgtStructIdx(psi, pfi)
  }
  structIndexOfExpr(exprIx, fnIx)
}

// The value-atom kind the concrete (non-box) side of a union `==` compares under — the
// same ladder `emitUnionCoerce` uses — or -1 when the operand has no atom rep (a struct,
// a map, a void call). -1 is a real "cannot classify" answer, never an in-band `"i32"`
// guess (D1071); the fall-through asks the operand's own arena row first.
export function unionEqAtomKindOf(
  otherIx: i32,
  unionName: string,
  fnIx: i32,
): i32 {
  let k = 0
  // A literal-union atom compares under the box's string arm (`unionTakesAtomAsStr`) since
  // that's the rep it rides as; checked ahead of `exprString` because an atom isn't a
  // string ref until `emitUnionEqOther`'s kind-2 arm widens it.
  if exprIsLitAtom(otherIx, fnIx) {
    k = 2
  } else if exprString(otherIx, fnIx) {
    k = 2
  } else if exprIsF32(otherIx, fnIx) {
    k = 5
  } else if exprIsF64(otherIx, fnIx) {
    k = 4
  } else if exprIsI64(otherIx, fnIx) {
    k = 3
  } else if exprIsBool(otherIx, fnIx) {
    k = 1
  } else {
    // The operand's own row first: `-1` states the shape has no atom rep at all; `-2` is
    // the arena declining, which leaves this ladder's own default answer in force.
    const ork = valueRowKind(nodeTyIxOf(unwrapParen(otherIx)))
    if ork == -1 { return -1 }
    // A container or closure atom (codes 7+) rides the box's `value` field directly with
    // no scalar value box, so it's answered as itself rather than promoted.
    if ork >= 7 { return ork }
    // The union's own promotion, asked of the same ladder the store uses
    // (`unionStoreAtomKind`) rather than re-derived here — so a read and a write agree on
    // which numeric arm the union promotes to (D291).
    const eqw = unionStoreAtomKind(unionName, 0)
    if eqw >= 0 { k = eqw }
    const bare = P.nodes[unwrapParen(otherIx)]
    if bare is NumLit {
      if !numLexFitsI32(bare.numText) { k = 3 }
    }
  }
  // The f64-to-f32 re-encode: a float value against a union whose only float arm is
  // `f32` is stored in the f32 box, so the compare must select that arm too.
  if k == 4 {
    const eqw4 = unionStoreAtomKind(unionName, 4)
    if eqw4 >= 0 { k = eqw4 }
  }
  k
}

// True if the member access at `memIx` reads a field of a currently-narrowed union
// identifier (the receiver `Ident` has an active binding on the narrowing stack). The
// receiver is unwrapped through parens, matching its two twins (`memNarrowVariantIndex`,
// `emitNarrowedMem`); the nested-path half of the same discipline is in `memberPathKeyOf`.
export function memIsNarrowed(memIx: i32) {
  if narrowTop == 0 { return false }
  const m = P.nodes[memIx]
  if m is Member {
    const recv = P.nodes[unwrapParen(m.memObj)]
    if recv is Ident {
      if narrowVariantFor(recv.identName) != "" { return true }
    }
    // A nested union-field receiver (`t.v.a` where `t.v` is narrowed to a variant): the
    // receiver is itself a Member, narrowed by its path key (`t.v`).
    if recv is Member {
      const pk = memberPathKeyOf(m.memObj)
      if pk != "" {
        if narrowVariantFor(pk) != "" { return true }
      }
    }
  }
  false
}

// The variant table index the Member `memIx`'s receiver is currently narrowed to, or -1
// if its receiver is not a narrowed union identifier. Resolves each receiver's own active
// narrowing, so simultaneously-narrowed locals each map to their own variant.
export function memNarrowVariantIndex(memIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    // Unwrapped in lock-step with `memIsNarrowed` (D222) — a predicate saying "narrowed"
    // and an index answering -1 would be the worse of the two failures.
    const recv = P.nodes[unwrapParen(m.memObj)]
    if recv is Ident { return variantIndexOf(narrowVariantFor(recv.identName)) }
    if recv is Member {
      const pk = memberPathKeyOf(m.memObj)
      if pk != "" { return variantIndexOf(narrowVariantFor(pk)) }
    }
  }
  -1
}

// The fifth receiver shape of the member field-code ladder: a receiver typed `Arm | null`
// (code `nulvariant`), which none of the ladder's other rungs cover. Shares its reader
// with `addLocalName`'s typing (`nulVariantIdxOfExpr`), so the classifier and the slot
// cannot name two different rows (D1094).
function memRecvNulVariantIndex(recvIx: i32, fnIx: i32) {
  nulVariantIdxOfExpr(recvIx, fnIx)
}

// The variant row an expression is currently narrowed to, or -1 — asked of the
// expression itself, unlike `memNarrowVariantIndex` which asks it of a Member's receiver.
// A struct arm's read never unboxes (stays `{tag, payload}`), so a destination typed at
// the arm must recover the payload itself. Paren/member unwrap shared with that sibling (D222).
export function narrowedStructArmVi(exprIx: i32): i32 {
  if exprIx < 0 { return -1 }
  if narrowTop == 0 { return -1 }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident { return variantIndexOf(narrowVariantFor(e.identName)) }
  if e is Member {
    const pk = memberPathKeyOf(unwrapParen(exprIx))
    if pk != "" { return variantIndexOf(narrowVariantFor(pk)) }
  }
  -1
}

// The variant row a code-15 struct-field read `p.err` targets, or -1 when the field isn't
// a nested-shape field or its target is a plain struct. A code-15 field stores a ref
// whether or not it's nullable, and `T` may be a union arm rather than a standalone
// struct — `collectS` skips a union member, so only the variant table has its layout.
function memberNulVariantRow(memIx: i32, fnIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    if memberFieldCode(memIx, fnIx) != 15 { return -1 }
    // The checker's type on the read node, not the field table's recorded name: the field
    // table banks canon's softened rendering, which can miss the arm `variantIndexOf` needs.
    const ty = nodeTyIxOf(memIx)
    if ty < 0 { return -1 }
    const t = T.tys[ty]
    if t is TyNullable { return variantRowOfTy(t.nInner) }
    variantRowOfTy(ty)
  } else {
    -1
  }
}

// The value-union name of a union-typed struct field read `o.y` (field code 16), or ""
// when the member isn't a union-box field. Covers a narrowed-variant receiver too (`v.f`
// where `v` is narrowed to a union arm carrying a value-union field `f`) — the field then
// rides the variant tables, not the incrementally-built struct table.
export function memberUnionFieldName(memIx: i32, fnIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    const si = structIndexOfExpr(m.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, m.memProp)
      if fi >= 0 {
        if sFieldTypeAt(si, fi) == 16 { return sFieldElemNameAt(si, fi) }
      }
    }
    // The receiver is a narrowed union arm (`v.f`, `v` narrowed to a struct variant):
    // resolve `f` through the variant field tables.
    const nvi = memNarrowVariantIndex(memIx)
    if nvi >= 0 {
      const vfi = variantFieldIndex(nvi, m.memProp)
      if vfi >= 0 {
        if variantFieldTypeAt(nvi, vfi) == 16 {
          return variantFieldElemName(nvi, vfi)
        }
      }
    }
    // Narrowing-blind last resort (the frame pre-pass runs before narrowing is active): an
    // ident declared as a union whose struct arm carries a code-16 field named `memProp`,
    // probed across the arms directly. Gated on the checker having typed the read a union
    // (cheap), since the ident-union walk below is too hot to run on every struct read.
    if !nodeTyIsUnion(memIx) { return "" }
    const mObj = P.nodes[unwrapParen(m.memObj)]
    if mObj is Ident {
      const mun = unionNameOfIdent(mObj.identName, fnIx)
      if mun != "" {
        const mAtoms: string[] = []
        unionArmsOf(mun, mAtoms)
        // The arm's struct row can be asked for by type: `unionMemberTysOf` appends
        // member types in the same order `splitUnionAtoms` cuts names, so the two arrays pair up.
        const mTys: i32[] = []
        let mCov = unionMemberTysOfAB(
          13,
          mun,
          unionDeclTyIxOfExpr(m.memObj, fnIx),
          mTys,
        )
        if mTys.length != mAtoms.length { mCov = false }
        let mi = 0
        while mi < mAtoms.length {
          const ma = mAtoms[mi]
          if ma != "null" {
            let msi = -1
            if mCov { msi = structIndexOfTy(mTys[mi]) }
            if msi < 0 { msi = structIndexByName(ma) }
            if msi >= 0 {
              const mfi = sFieldIndex(msi, m.memProp)
              if mfi >= 0 {
                if sFieldTypeAt(msi, mfi) == 16 {
                  return sFieldElemNameAt(msi, mfi)
                }
              }
            }
            const mvi = variantIndexOf(ma)
            if mvi >= 0 {
              const mvfi = variantFieldIndex(mvi, m.memProp)
              if mvfi >= 0 {
                if variantFieldTypeAt(mvi, mvfi) == 16 {
                  return variantFieldElemName(mvi, mvfi)
                }
              }
            }
          }
          mi = mi + 1
        }
      }
    }
  }
  ""
}

// Whether arm `vi`'s layout is ambiguous: gated on two heap-asked rungs — a second arm
// sharing that layout (`repVariantSlotsTwin`) and a declared struct sharing it
// (`variantStructHeapTwinAt`). Un-gated, a field read could pick the wrong layout for
// the arm (D171).
function armLayoutAmbiguousAt(vi: i32): boolean {
  if vi < 0 { return false }
  if vi >= uVarTyIx.length { return false }
  // A contested arm whose contestant shares its heap type isn't ambiguous: one heap
  // means one layout, so the field read has nothing to guess at.
  if armLayoutContestedAt(vi) && variantStructHeapTwinAt(vi) < 0 { return true }
  const key = repCanonId(uVarTyIx[vi])
  if key < 0 { return false }
  let j = 0
  while j < uVarTyIx.length {
    if j != vi {
      if repCanonId(uVarTyIx[j]) == key && repVariantSlotsTwin(vi, j) == 0 {
        return true
      }
    }
    j = j + 1
  }
  false
}

// The value-union name of a code-16 field read whose receiver is a declared union arm
// (`const g: Circle = …; g.r`, a `Circle` parameter or return, a `Circle[]` element) —
// the gap `memberUnionFieldName` leaves, since a union arm has no row in the standalone
// struct table (`collectS` skips a member of a `type X = {…}` union). "" for the rest (D219).
function armFieldUnionName(memIx: i32, fnIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    const avi = exprVariantIndex(m.memObj, fnIx)
    if armLayoutAmbiguousAt(avi) { return "" }
    if avi >= 0 {
      const afi = variantFieldIndex(avi, m.memProp)
      if afi >= 0 {
        if variantFieldTypeAt(avi, afi) == 16 {
          return variantFieldElemName(avi, afi)
        }
      }
    }
  }
  ""
}

// The read-side composite: `memberUnionFieldName` first, then the declared-arm rung
// (`armFieldUnionName`). The three read classifiers ask this; the `is`-narrowing push
// sites keep asking `memberUnionFieldName` directly, since a pushed value there is
// already a bare variant ref, not a box `emitNarrowedMem` could unwrap (D220).
export function memberUnionFieldNameRead(memIx: i32, fnIx: i32) {
  const r = memberUnionFieldName(memIx, fnIx)
  if r != "" { return r }
  armFieldUnionName(memIx, fnIx)
}

// ── the read/consumer channel predicate ──────────────────────────────────────
// An un-narrowed code-16 field read's delivered atom, or -1 when the box comes back
// unchanged. Asked by both the read site and every consumer so the two cannot disagree:
// unnarrowed, a checker-banked atom at the read, and a recoverable box payload (D209).
export function memReadUnboxAtomKind(memIx: i32, fnIx: i32): i32 {
  if memReadBoxedAtomKind(memIx, fnIx) < 0 { return -1 }
  memReadCheckerAtomKind(memIx)
}

// The value atom the checker banked at an un-narrowed code-16 read — condition 2 of the
// channel predicate on its own, with no union anywhere in it. -1 when the checker typed
// the node as anything but a non-`null` value atom.
function memReadCheckerAtomKind(memIx: i32): i32 {
  const cty = nodeTyIxOf(memIx)
  if cty < 0 { return -1 }
  const t = T.tys[cty]
  if t is TyPrim {
    const k = valueAtomKind(t.primName)
    if k < 0 || k == 6 { return -1 }
    return k
  }
  -1
}

// The other half of the channel: the atom the box the read yields actually holds, which
// isn't always the atom the read delivers — a field's declared member, the payload the
// store boxed, and the checker's type for the read can each name a different one (D291),
// so the read site needs both ends to bridge them. -1 wherever the predicate declines.
export function memReadBoxedAtomKind(memIx: i32, fnIx: i32): i32 {
  const un0 = memberUnionFieldNameRead(memIx, fnIx)
  if un0 == "" { return -1 }
  if narrowedValueAtomOf(memberPathKeyOf(memIx)) != "" { return -1 }
  const cty = nodeTyIxOf(memIx)
  if cty < 0 { return -1 }
  const t = T.tys[cty]
  if t is TyPrim {
    const k = valueAtomKind(t.primName)
    if k < 0 || k == 6 { return -1 }
    return unionStoreAtomKind(un0, k)
  }
  -1
}

// Every value atom the box at this read can hold, appended to `out` deduped, or false.
// Unlike `memReadBoxedAtomKind`'s single answer, a `??`-merged row boxes each family
// member at its own atom, so the read has to dispatch over the whole set. False — keeping
// today's single cast — when a member isn't a scalar atom; `null` is skipped, not refused (D927).
export function memReadBoxedAtomKinds(
  memIx: i32,
  fnIx: i32,
  out: i32[],
): boolean {
  const un0 = memberUnionFieldNameRead(memIx, fnIx)
  if un0 == "" { return false }
  if narrowedValueAtomOf(memberPathKeyOf(memIx)) != "" { return false }
  const atoms: string[] = []
  splitUnionAtoms(un0, atoms)
  let i = 0
  while i < atoms.length {
    const k = valueAtomKind(atoms[i])
    if k < 0 { return false }
    if k != 6 {
      let seen = false
      let j = 0
      while j < out.length {
        if out[j] == k { seen = true }
        j = j + 1
      }
      if !seen { out.push(k) }
    }
    i = i + 1
  }
  out.length > 0
}

// Membership of a scalar value atom in the union `nm`, answered from the banked kind
// column where the pool covers the set and the member-name path where it doesn't — one
// function so the store ladder and the read predicate ask the same question.
export function unionHasAtomK(s: i32, nm: string, kw: string, k: i32): boolean {
  const b = msHasValKind(s, k)
  if b >= 0 { return b == 1 }
  unionHasAtomTy(nm, kw, false)
}

// `unionHasAtomK` for a kind with no single spelling — the list codes and up, where
// `valueAtomNameOfKind` answers "" because a code (e.g. 7) names several distinct member
// spellings (D1095). Walks the member spellings and asks each one's own kind instead. Reads
// only kinds, never positions — the arm's box tag still comes from `scalarTagOfKind(k)`.
export function unionHasAtomKindArm(unionName: string, k: i32): boolean {
  if k < 0 { return false }
  const arms: string[] = []
  splitUnionAtoms(unionName, arms)
  let i = 0
  while i < arms.length {
    if valueAtomKind(arms[i]) == k { return true }
    i = i + 1
  }
  false
}

// The spelling of a value-atom kind — `valueAtomKind`'s inverse over the seven scalar
// keywords it's a bijection on (codes 0-6). "" for every other code: a list code like 7
// folds several spellings into one (`i32[]`, `boolean[]`, a litunion `K[]`), so there's
// no single name to hand back.
export function valueAtomNameOfKind(k: i32): string {
  if k == 0 { return "i32" }
  if k == 1 { return "boolean" }
  if k == 2 { return "string" }
  if k == 3 { return "i64" }
  if k == 4 { return "f64" }
  if k == 5 { return "f32" }
  if k == 6 { return "null" }
  ""
}

// ── the store's own ladder, named ────────────────────────────────────────────
// The value-atom kind stored when a value (atom `atom`/`vk`) is boxed into `unionName`,
// or -1 when no arm can hold it — a function, not an open-coded chain, because both the
// coercion (picking its tag) and the un-narrowed read ask it (D291).
export function unionStoreAtomKind(unionName: string, vk: i32): i32 {
  const atom = valueAtomNameOfKind(vk)
  if atom == "" { return -1 }
  const s = msSetOfText(unionName)
  if unionHasAtomK(s, unionName, atom, vk) { return vk }
  if vk == 0 {
    if unionHasAtomK(s, unionName, "i64", 3) { return 3 }
    if unionHasAtomK(s, unionName, "f64", 4) { return 4 }
    if unionHasAtomK(s, unionName, "f32", 5) { return 5 }
  }
  if vk == 4 {
    if unionHasAtomK(s, unionName, "f32", 5) { return 5 }
  }
  -1
}

// Record a distinct (kind, ref-list slot) source frame requirement.
export function mfRecordSrc(kind: MfKind, slot: i32) {
  let i = 0
  while i < mfSrcKinds.length {
    if mfSrcKinds[i] == kind && mfSrcSlots[i] == slot { return 0 }
    i = i + 1
  }
  mfSrcKinds.push(kind)
  mfSrcSlots.push(slot)
  0
}

// Record a distinct (result-element-kind, ref-list slot) dest frame requirement. `slot` is
// the ref-list table slot for a kind-2 (ref-list) dest (so two struct-array filters of
// different element types get distinct backing locals), -1 for a non-ref dest.
export function mfRecordDst(kind: MfKind, slot: i32) {
  let i = 0
  while i < mfDstKinds.length {
    if mfDstKinds[i] == kind && mfDstSlots[i] == slot { return 0 }
    i = i + 1
  }
  mfDstKinds.push(kind)
  mfDstSlots.push(slot)
  0
}

// The wasm local holding the source wrapper ref for (kind, slot), or -1.
export function mfSrcLocalFor(kind: MfKind, slot: i32) {
  let i = 0
  while i < mfSrcKinds.length {
    if mfSrcKinds[i] == kind && mfSrcSlots[i] == slot {
      if i < mfSrcBases.length { return mfSrcBases[i] }
    }
    i = i + 1
  }
  -1
}

// The wasm local holding the dest backing ref for result (kind, slot), or -1.
export function mfDstLocalFor(kind: MfKind, slot: i32) {
  let i = 0
  while i < mfDstKinds.length {
    if mfDstKinds[i] == kind && mfDstSlots[i] == slot {
      if i < mfDstBases.length { return mfDstBases[i] }
    }
    i = i + 1
  }
  -1
}

// True if function `fnIx` operates on a map — it has a map param, or `buildLocals`
// flagged a map local (code 6). Drives the map scratch-frame reservation; must run
// after `buildLocals`, so `localIsRef` is populated.
export function fnHasMap(fnIx: i32) {
  let i = 0
  while i < localNames.length {
    if localIsRef[i] == "map" { return true }
    // A map-array local (`{[string]:i32}[]`, code 5 with element kind 3) lets map ops run
    // on an indexed element, so the function needs the scratch frame even with no bare map local.
    if localIsRef[i] == "reflist" {
      const s = localStructIdx[i]
      if s >= 0 {
        if s < rlElemKindTbl.length {
          if rlElemKindTbl[s] == 3 { return true }
        }
      }
    }
    i = i + 1
  }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let pj = 0
    while pj < params.length {
      const p = P.nodes[params[pj]]
      if p is Param {
        if p.parType >= 0 {
          const ty = P.nodes[p.parType]
          if ty is TypeRef {
            // The arena test must match the WIDTH of the name test it replaces
            // (`nameIsMap` accepted a nullable- or union-wrapped map too, not just bare) —
            // `nodeTyIsMap` alone would under-reserve for those. Over-answering is the safe
            // direction for a reservation: an unused frame costs nothing, a missing one doesn't build.
            if nodeTyReachesMap(p.parType) { return true }
          }
        }
      }
      pj = pj + 1
    }
  }
  false
}

// Does the module contain a union-operand `as` cast? It needs a 1-slot box scratch, since
// its operand is evaluated once and then both tested and unboxed. Module-wide rather than
// a per-function hand-walk (like `blockHasCallRef`'s), deliberately: a hand-walk that
// misses a node kind under-reserves the slot, invalid wasm — a linear arena pass cannot.
export function moduleHasUnionAs(): boolean {
  // Memoised on an arena prefix (never a plain boolean): asked once per emitted function,
  // so a full rescan on every call would cost noticeably more self-compile time.
  if modUnionAsHit { return true }
  let i = modUnionAsSeen
  while i < P.nodes.length {
    if asExprIsUnionCast(i) {
      modUnionAsHit = true
      return true
    }
    // The hole operand, over-approximated: with no `fnIx` here this can't ask the rep
    // question the emit-time check does, so it reserves rather than risk an invalid-wasm
    // miss — an unused local costs nothing (D1251).
    if asExprOperandIsHole(i) {
      modUnionAsHit = true
      return true
    }
    i = i + 1
  }
  modUnionAsSeen = P.nodes.length
  false
}

// Whether the `AsExpr` at `ix` is the union-operand form. One home, read by the reservation
// scan and by the lowering, so the two cannot disagree about which casts need the frame.
// Asked of the operand's checker type, not the cast's: the cast node's own type is the
// target arm, so it cannot tell a union propagation from a numeric conversion.
export function asExprIsUnionCast(ix: i32): boolean {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if !(n is AsExpr) { return false }
  const oty = nodeTyIxOf(n.asObj)
  if oty < 0 { return false }
  const ot = T.tys[oty]
  if ot is TyUnion { return true }
  // A nullable operand is a union operand too — same bar, same meaning — and the checker's
  // own arm expands it before deciding; this gate must agree or the cast emits an i32 op over a ref.
  if ot is TyNullable { return true }
  false
}

// The operand's recorded type is an unresolved inference hole (a `TyVar`): a parameter only
// the call site pins keeps one on every read, even though the monomorphizer has already
// pinned the instance's parameter to the argument's union. Without this rung
// `asExprIsUnionCast` declines and the cast falls to the plain numeric ladder (D1251).
function asExprOperandIsHole(ix: i32): boolean {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if !(n is AsExpr) { return false }
  const oty = nodeTyIxOf(n.asObj)
  if oty < 0 { return true }
  const ot = T.tys[oty]
  if ot is TyVar { return true }
  false
}

// The gate the lowering and every cast-result classifier ask: `asExprIsUnionCast`'s
// node-local answer, plus the rung the recorded type can't carry — a hole operand whose box
// the emitter's own rep answer (`exprUnion`) knows about. The same function the union arm's
// own boxed-operand check asks, so the gate and the arm cannot disagree (D1251).
export function asExprIsUnionCastIn(ix: i32, fnIx: i32): boolean {
  if asExprIsUnionCast(ix) { return true }
  if !asExprOperandIsHole(ix) { return false }
  const n = P.nodes[ix]
  if n is AsExpr { return exprUnion(n.asObj, fnIx) }
  false
}

// ── the numeric exact-or-fail cast (D1041) ───────────────────────────────────
// The source and target primitive names of the `AsExpr` at `ix`, read from the arena
// rather than the spelling `n.asTy` (safe for `emitAsCast`'s lossless ladder, which only
// compares the four primitive names). Survives an alias (`type Px = i32`) and `T | null`.
export function asExprNumSrcName(ix: i32): string {
  const n = P.nodes[ix]
  if !(n is AsExpr) { return "" }
  primNameStr(primNameOf(nodeTyIxOf(n.asObj)))
}
export function asExprNumTgtName(ix: i32): string {
  const n = P.nodes[ix]
  if !(n is AsExpr) { return "" }
  // `as?` records `T | null` on the node; the other two record `T`. Peeling is a no-op on a
  // non-nullable, so one read serves all three modes.
  primNameStr(primNameOf(tyPeelNul(nodeTyIxOf(ix))))
}

// The exactness domain, the target name except at `u8` — the emitter's half of the
// checker's `numCastDomainName`, and the one place `n.asTy` outranks the arena: `x as u8`
// records `i32` (the value it produces), so only the spelling still says `u8` (D1587). The
// target name still decides the conversion opcode, so the two must not be merged.
export function asExprNumCastDomain(ix: i32): string {
  const n = P.nodes[ix]
  if !(n is AsExpr) { return "" }
  if n.asTy == "u8" { return "u8" }
  asExprNumTgtName(ix)
}

// Whether the `AsExpr` at `ix` is a numeric cast that can fail — the emitter's half of the
// checker's `numCastCanFail`, asked of the same two names. Disjoint from `asExprIsUnionCast`
// by operand (a union operand is never a primitive), so the two gates cannot both claim a cast.
export function asExprNumFallible(ix: i32): boolean {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if !(n is AsExpr) { return false }
  // `as%` keeps the low bits, so it cannot fail at any width pair and owes no staging slot,
  // no `T | null` box row and no trap message.
  if n.asMode == "wrap" { return false }
  if asExprIsUnionCast(ix) { return false }
  numCastCanFail(asExprNumSrcName(ix), asExprNumCastDomain(ix))
}

// Is `exprIx` an expression whose f64/f32 value is integral by construction? `trunc` /
// `floor` / `ceil` / `nearest` are the four `f64 → f64` intrinsics with no fractional
// result, so `trunc(d) as! i32` only needs the trapping `i32.trunc_f64_s`'s range check.
// Exactly these four; a user function named `floor` shadows them, checked via `fnIndexOfSid`.
export function exprIsIntegralFloat(exprIx: i32, _fnIx: i32): boolean {
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if !(e is Call) { return false }
  if e.callArgs.length != 1 { return false }
  const callee = P.nodes[e.callFn]
  if !(callee is Ident) { return false }
  if fnIndexOfSid(sidOfNode(e.callFn)) >= 0 { return false }
  const nm = callee.identName
  nm == "trunc" || nm == "floor" || nm == "ceil" || nm == "nearest"
}

// Does the module contain a fallible numeric cast? The `moduleHasUnionAs` twin, reserving
// the three staging slots by the same linear arena walk, since an exactness test's operand
// is read twice and is typically not re-readable. Memoised the same way, for the same reason.
export function moduleHasNumCast(): boolean {
  if modNumCastHit { return true }
  let i = modNumCastSeen
  while i < P.nodes.length {
    if asExprNumFallible(i) {
      modNumCastHit = true
      return true
    }
    i = i + 1
  }
  modNumCastSeen = P.nodes.length
  false
}

// True if the statement/expression tree at `ix` contains a function-value call (a `Call`
// whose callee is a closure value rather than a known function name) — so the function
// needs the closure scratch slot for `call_ref`.
export function blockHasCallRef(ix: i32, fnIx: i32) {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if n is Call {
    const callee = P.nodes[n.callFn]
    let isVal = false
    if callee is Ident {
      let t = fnIndexOfSid(sidOfNode(n.callFn))
      // A live closure binding of the name is what the call denotes, so the frame needs
      // the scratch even though a module function carries the name — without it the
      // `call_ref` spills into a local the vector never declared (D1602).
      if t >= 0 && identIsBoundClosure(callee.identName, fnIx) { t = -1 }
      if t < 0 {
        if exprIsClosure(n.callFn, fnIx) { isVal = true }
        // `t()` where `t` is a union binding with a bare-closure arm: the `is`-narrowing
        // that makes `t` a closure isn't active in this pre-pass, so reserve conservatively.
        if !isVal && calleeIsUnionClosureIdent(n.callFn, fnIx) { isVal = true }
      } else {
        // A direct call to a capturing function is lowered via call_ref too.
        if captureCountOf(t) > 0 { isVal = true }
      }
    } else {
      if exprIsClosure(n.callFn, fnIx) { isVal = true }
      // `p[0]()` where `p` is a union with a closure-array arm: the `is`-narrowing needed to
      // see it isn't active in this pre-pass, so reserve conservatively (a spare local is harmless).
      if !isVal && calleeIsUnionClosureArrayIndex(n.callFn, fnIx) {
        isVal = true
      }
      // `t0.f[0]()` through a union struct-arm's closure-array field: same pre-pass
      // narrowing gap, reserved conservatively (the indexed-member twin of the arm above).
      if !isVal && calleeIsUnionArmCloArrayIndex(n.callFn, fnIx) {
        isVal = true
      }
      // `t0.f.f()` through a union struct-arm's closure-field chain: same gap, reserved
      // conservatively — an unreserved `call_ref` would spill into the next frame's local.
      if !isVal && calleeIsUnionArmClosureMember(n.callFn, fnIx) {
        isVal = true
      }
      // `t0[0].f()` where `t0`'s union has a ref-array arm whose element struct carries a
      // closure field — the indexed-element-field twin of the arms above.
      if !isVal && calleeIsUnionElemFieldClosure(n.callFn, fnIx) {
        isVal = true
      }
    }
    // The typed-IR net for any callee spelling the syntactic classifiers above miss: the
    // checker records every callee's own checked type, so one that types as a closure
    // reserves the scratch regardless of shape or depth — covering narrowed callees the
    // syntactic union-closure chain above cannot see. Over-reservation is harmless.
    if !isVal {
      const cty = nodeTyIxOf(n.callFn)
      if cty >= 0 {
        if T.tys[cty] is TyFunc { isVal = true }
      }
    }
    if isVal { return true }
    if blockHasCallRef(n.callFn, fnIx) { return true }
    const args = n.callArgs
    let i = 0
    while i < args.length {
      if blockHasCallRef(args[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    while i < stmts.length {
      if blockHasCallRef(stmts[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if n is LetDecl {
    if n.letInit >= 0 { return blockHasCallRef(n.letInit, fnIx) }
    return false
  }
  if n is RetStmt {
    if n.retArg >= 0 { return blockHasCallRef(n.retArg, fnIx) }
    return false
  }
  if n is IfStmt {
    if blockHasCallRef(n.ifCond, fnIx) { return true }
    if blockHasCallRef(n.ifThen, fnIx) { return true }
    if n.ifElse >= 0 { return blockHasCallRef(n.ifElse, fnIx) }
    return false
  }
  if n is WhileStmt {
    if blockHasCallRef(n.whileCond, fnIx) { return true }
    return blockHasCallRef(n.whileBody, fnIx)
  }
  if n is ForRange {
    if blockHasCallRef(n.frFrom, fnIx) { return true }
    if blockHasCallRef(n.frTo, fnIx) { return true }
    if n.frStep >= 0 {
      if blockHasCallRef(n.frStep, fnIx) { return true }
    }
    return blockHasCallRef(n.frBody, fnIx)
  }
  if n is ForIn {
    if blockHasCallRef(n.fiIter, fnIx) { return true }
    return blockHasCallRef(n.fiBody, fnIx)
  }
  if n is BinExpr {
    if blockHasCallRef(n.binLeft, fnIx) { return true }
    return blockHasCallRef(n.binRight, fnIx)
  }
  if n is Unary { return blockHasCallRef(n.unArg, fnIx) }
  if n is Paren { return blockHasCallRef(n.parInner, fnIx) }
  // An `is` operand (`f(x) is i32`) may itself be a function-value call — without this the
  // closure scratch slot (`callRefSlot`) goes unreserved and the inline `call_ref` reads a
  // non-existent local 0.
  if n is IsExpr { return blockHasCallRef(n.isObj, fnIx) }
  if n is AsExpr { return blockHasCallRef(n.asObj, fnIx) }
  if n is Member { return blockHasCallRef(n.memObj, fnIx) }
  if n is Index {
    if blockHasCallRef(n.idxArr, fnIx) { return true }
    return blockHasCallRef(n.idxIndex, fnIx)
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if blockHasCallRef(f.fiValue, fnIx) { return true }
      }
      i = i + 1
    }
    return false
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      if blockHasCallRef(elems[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// True if struct-table entry `ssi` layout-matches a variant arm of some registered
// variant-box union whose arm heap type differs from `sHeapIdx[ssi]` — a struct of this
// shape flowing into that union must be re-boxed, never passed raw. The reservation
// pre-pass has no flow context, so this over-approximates (a harmless spare local).
function structIdxHasReboxVariant(ssi: i32): boolean {
  if ssi < 0 || ssi >= sHeapIdx.length { return false }
  let u = 0
  while u < unNames.length {
    let vi = unVarStart[u]
    while vi < unVarStart[u] + unVarCount[u] {
      if vi >= 0 && vi < uVarHeap.length {
        if structIdxMatchesVariantIdx(ssi, vi) {
          if sHeapIdx[ssi] != uVarHeap[vi] { return true }
        }
      }
      vi = vi + 1
    }
    u = u + 1
  }
  false
}

// True if the expression at `exprIx` is a multi-field struct-returning call — a
// non-re-readable source, since a call can't be re-evaluated per field — whose result
// shape must be re-boxed into a variant-box union arm, the one case
// `emitStructExprAsVariantBox` stashes in `variantReboxSlot`. Drives that slot's reservation.
function exprIsMultiFieldReboxCall(exprIx: i32, fnIx: i32): boolean {
  const inner = unwrapParen(exprIx)
  if inner < 0 { return false }
  const n = P.nodes[inner]
  if !(n is Call) { return false }
  if !exprStruct(inner, fnIx) { return false }
  const ssi = structIndexOfExpr(inner, fnIx)
  // `structIndexOfExpr` can return a variant index (its own heap table) for a variant-
  // returning call, not a struct-table index. Bounded to the struct table so it's never
  // misused as one — a variant-returning call never reboxes; it builds the variant directly.
  if ssi < 0 || ssi >= sFieldCount.length { return false }
  if sFieldCount[ssi] <= 1 { return false }
  structIdxHasReboxVariant(ssi)
}

// Whether the tree at `ix` contains a multi-field struct-returning call that must be
// re-boxed into a variant-box union arm (`exprIsMultiFieldReboxCall`), so the function
// reserves `variantReboxSlot`. Mirrors `blockHasCallRef`'s traversal; under-reservation
// fails loudly (never invalid wasm), so exact flow-position matching isn't needed.
export function blockHasVariantRebox(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  if exprIsMultiFieldReboxCall(ix, fnIx) { return true }
  const n = P.nodes[ix]
  if n is Call {
    if blockHasVariantRebox(n.callFn, fnIx) { return true }
    const args = n.callArgs
    let i = 0
    while i < args.length {
      if blockHasVariantRebox(args[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    while i < stmts.length {
      if blockHasVariantRebox(stmts[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if n is LetDecl {
    if n.letInit >= 0 { return blockHasVariantRebox(n.letInit, fnIx) }
    return false
  }
  if n is RetStmt {
    if n.retArg >= 0 { return blockHasVariantRebox(n.retArg, fnIx) }
    return false
  }
  if n is IfStmt {
    if blockHasVariantRebox(n.ifCond, fnIx) { return true }
    if blockHasVariantRebox(n.ifThen, fnIx) { return true }
    if n.ifElse >= 0 { return blockHasVariantRebox(n.ifElse, fnIx) }
    return false
  }
  if n is WhileStmt {
    if blockHasVariantRebox(n.whileCond, fnIx) { return true }
    return blockHasVariantRebox(n.whileBody, fnIx)
  }
  if n is ForRange {
    if blockHasVariantRebox(n.frFrom, fnIx) { return true }
    if blockHasVariantRebox(n.frTo, fnIx) { return true }
    if n.frStep >= 0 {
      if blockHasVariantRebox(n.frStep, fnIx) { return true }
    }
    return blockHasVariantRebox(n.frBody, fnIx)
  }
  if n is ForIn {
    if blockHasVariantRebox(n.fiIter, fnIx) { return true }
    return blockHasVariantRebox(n.fiBody, fnIx)
  }
  if n is BinExpr {
    if blockHasVariantRebox(n.binLeft, fnIx) { return true }
    return blockHasVariantRebox(n.binRight, fnIx)
  }
  if n is Unary { return blockHasVariantRebox(n.unArg, fnIx) }
  if n is Paren { return blockHasVariantRebox(n.parInner, fnIx) }
  if n is IsExpr { return blockHasVariantRebox(n.isObj, fnIx) }
  if n is AsExpr { return blockHasVariantRebox(n.asObj, fnIx) }
  if n is Member { return blockHasVariantRebox(n.memObj, fnIx) }
  if n is Index {
    if blockHasVariantRebox(n.idxArr, fnIx) { return true }
    return blockHasVariantRebox(n.idxIndex, fnIx)
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if blockHasVariantRebox(f.fiValue, fnIx) { return true }
      }
      i = i + 1
    }
    return false
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      if blockHasVariantRebox(elems[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// The bounds-check frame kind for a scalar list element kind (`scalarListElemKind`
// only ever yields the four scalar members of `VKind`).
export function listIdxKindOf(ek: VKind): MfKind {
  // The packed byte list's frame slots must carry its own heap types (`bl8`/`ba8`), not the
  // i32 list's — the `"i32"` default below would type the hoisted wrapper local
  // `(ref null $lTypeIdx)` and store a `(ref $bl8TypeIdx)` into it.
  if ek == "u8list" { return "u8" }
  if ek == "f64" { return "f64" }
  if ek == "i64" { return "i64" }
  if ek == "f32" { return "f32" }
  "i32"
}

// Which columns join the `liBack` code in a stash's match: the code alone, the code and
// `liSlots`, the code and `liKinds`, or all three. `scratchSlot` takes the code as an
// ARGUMENT rather than each allocator copying a constant, so a new stash cannot silently
// hand back a slot a live one already owns.
const SCRATCH_BY_CODE = 0
const SCRATCH_BY_KEY = 1
const SCRATCH_BY_KIND = 2
const SCRATCH_BY_BOTH = 3

// The frame slot carrying `liBack` code `code`, found in the lazily grown table or reserved
// now as the row `(kind, key, code)`. A column `by` does not key on is still WRITTEN, so a
// row always reads back the valtype it reserved. Slot 0 of the frame is the shared i32
// index stash, so row k is slot `listIdxScratchBase + 1 + k`.
function scratchSlot(code: i32, kind: MfKind, key: i32, by: i32) {
  let k = 0
  while k < liKinds.length {
    if liBack[k] == code {
      let hit = true
      if by == SCRATCH_BY_KEY || by == SCRATCH_BY_BOTH {
        if liSlots[k] != key { hit = false }
      }
      if by == SCRATCH_BY_KIND || by == SCRATCH_BY_BOTH {
        if liKinds[k] != kind { hit = false }
      }
      if hit { return listIdxScratchBase + 1 + k }
    }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(key)
  liBack.push(code)
  listIdxScratchBase + liKinds.length
}

// The bounds-check wrapper-ref slot for list kind `kind` (`slot` = the ref-list table slot
// for kind "ref", else 0), code 0 — the one stash keyed on both columns, since a wrapper's
// heap type comes from the kind and its ref-list row together. Handed out during lowering:
// first-use order is what keeps the layout deterministic.
export function listIdxWrapSlot(kind: MfKind, slot: i32) {
  scratchSlot(0, kind, slot, SCRATCH_BY_BOTH)
}

// The shared-union-field receiver stash, code 7 — one `(ref null $uBoxIdx)` slot holding
// the box across a per-tag dispatch whose receiver cannot be re-emitted per arm. Lazy, not
// eagerly reserved: whether a read is "shared" depends on `is`-narrowing, which a pre-pass
// runs before and so cannot see.
export function sharedFieldRecvSlot() {
  scratchSlot(7, "i32", 0, SCRATCH_BY_CODE)
}

// ── the element-converting copy's frame slots (D791) ─────────────────────────
// Four locals: the source wrapper (once), the fresh destination backing, and two i32
// temps — lazy, since a pre-pass can't know a delivery widens before the tables intern.
// Sharing is safe: the source is fully emitted before the stash, no user code runs between.
export function widenSrcWrapSlot(slot: i32) {
  scratchSlot(8, "ref", slot, SCRATCH_BY_KEY)
}

export function widenDstBackSlot(slot: i32) {
  scratchSlot(9, "ref", slot, SCRATCH_BY_KEY)
}

// D972 — the union-`==` operand stash, code 13. Its own code rather than
// `sharedFieldRecvSlot`'s 7: that shared receiver can be live across this compare (the
// operand of a `==` may itself be a shared-union-field read), and two writers of one slot
// is how a stash gets clobbered — an operand assigning itself.
export function unionEqStashSlot() {
  scratchSlot(13, "i32", 0, SCRATCH_BY_CODE)
}

// D1510 — the object-literal order stash, codes `100 + <field code>`. A struct/variant
// literal written out of layout order evaluates each initialiser here in source order,
// and `struct.new` reads the slots back in layout order; the code carries the field's own
// type so it can never disagree with `pushFieldStorage`. Fresh per field, never shared.
export function objOrderStashSlot(code: i32, storageSlot: i32) {
  liKinds.push("i32") // unread — `liBack` alone carries the field code
  liSlots.push(storageSlot)
  liBack.push(100 + code)
  listIdxScratchBase + liKinds.length
}

// D1060 — the literal-`is` receiver stash, code 17. A `v is <literal>` over a boxed union
// reads its receiver twice (the tag, then the payload), so a non-re-readable receiver is
// parked here at first read. Its own code, not `unionEqStashSlot`'s 13, because an `is`
// can sit inside a union `==`'s operand and a second writer of one slot is how a stash clobbers.
export function unionLitIsStashSlot() {
  scratchSlot(17, "i32", 0, SCRATCH_BY_CODE)
}

// D973 — the three scratch slots a struct-union `==` needs: the two operand boxes (codes 13
// and 15, `(ref null $uBoxIdx)`) and, per arm, the pair of casted variant payloads (code 14,
// keyed by variant index; the right operand is keyed `vi + 1024`, outside any variant table).
export function unionEqStashSlot2() {
  scratchSlot(15, "i32", 0, SCRATCH_BY_CODE)
}

// D974 — a struct-heap-typed stash pair, code 16, keyed by struct-table row (the right
// operand `row + 1024`). A struct union's arm may carry a nested shape field, and that
// shape is interned into the struct table even though the arms themselves are not, so the
// nested compare can use `emitStructEqRec` given operands parked at the nested row's heap.
export function structEqStashSlot(row: i32) {
  scratchSlot(16, "ref", row, SCRATCH_BY_KEY)
}

export function unionEqArmSlot(vi: i32) {
  scratchSlot(14, "ref", vi, SCRATCH_BY_KEY)
}

// The scalar analogue of `widenSrcWrapSlot`/`widenDstBackSlot`: codes 11 and 12, keyed by
// the list's element kind rather than a ref-list row, since a scalar list's wrapper and
// backing heap types come from the kind alone. Two copies over the same kind share one
// slot for the same reason: the source is fully emitted before the stash (D965).
export function widenScalarWrapSlot(kind: MfKind) {
  scratchSlot(11, kind, 0, SCRATCH_BY_KIND)
}

export function widenScalarBackSlot(kind: MfKind) {
  scratchSlot(12, kind, 0, SCRATCH_BY_KIND)
}

export function widenTmpSlot(which: i32) {
  scratchSlot(10, "i32", which, SCRATCH_BY_KEY)
}

// The tail-value expression of an if-expression's then arm (`ifArmValueExpr`: the arm
// block's last statement), or -1. The arms share the checker's join type, so the then
// arm's rep classifies the whole if-expression.
function ifThenValueIx(ifIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt { return ifArmValueExpr(s.ifThen) }
  -1
}

// The then-arm value of an if-expression whose other arm is `null` — absent (an else-less
// `if`) or a bare `null` else — at `exprIx`, parens peeled; -1 for every other shape. Such
// an `if` is `T | null` in every position (DECISIONS), so the value's niche is the then
// arm's own rep made nullable; both null spellings share this rung deliberately.
export function nulArmIfThenValueIx(exprIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is IfStmt {
    if e.ifElse < 0 { return ifArmValueExpr(e.ifThen) }
    const eb = P.nodes[e.ifElse]
    if eb is Block {
      const ev = ifArmValueExpr(e.ifElse)
      if ev >= 0 {
        if P.nodes[unwrapParen(ev)] is NullLit {
          return ifArmValueExpr(e.ifThen)
        }
      }
    }
  }
  -1
}

// The value arm of an if-expression whose deciding arm is itself nullable, at `exprIx`, or
// -1 — the shape `nulArmIfThenValueIx` can't answer, since both arms carry `T | null` here.
// Gated on the checker's join being one rep (`nodeTyIsNullableOneRep`): two differently-
// shaped nullable arms join to a union box, whose rep neither arm alone can name (D1560).
function nulIfArmNullableValueIx(exprIx: i32) {
  if exprIx < 0 { return -1 }
  const ix = unwrapParen(exprIx)
  const e = P.nodes[ix]
  if e is IfStmt {
    if !nodeTyIsNullableOneRep(ix) { return -1 }
    const tv = ifArmValueExpr(e.ifThen)
    if tv >= 0 {
      if exprIsNullLit(tv) {
        // `if c { null } else { v }` — the then arm is the null half, so the else arm
        // decides. The mirror of `nulArmIfThenValueIx`, which reads null in the else.
        if e.ifElse >= 0 {
          if P.nodes[e.ifElse] is Block { return ifArmValueExpr(e.ifElse) }
        }
        return -1
      }
      return tv
    }
  }
  -1
}

// True if the expression at `exprIx` is the bare `null` literal, grouping parens peeled.
function exprIsNullLit(exprIx: i32) {
  if exprIx < 0 { return false }
  P.nodes[unwrapParen(exprIx)] is NullLit
}

// The if-expression arm whose own rep decides the join's — the then arm, except where that
// arm is the bare `null` half of a `T | null` join, when it is the else arm. The kind and
// its companion slot must be read off one arm, or `fbValtype` names a heap type the value
// does not actually hold (D1560).
function ifRepArmValueIx(ifIx: i32) {
  const tv = ifThenValueIx(ifIx)
  if tv >= 0 {
    if !exprIsNullLit(tv) { return tv }
  }
  const nlv = nulIfArmNullableValueIx(ifIx)
  if nlv >= 0 { return nlv }
  tv
}

// The `fbValtype` kind of a ref-typed if-expression join — string, string-list, f64-list,
// ref-list, i32-list, or struct — classified from the then arm's tail value. -1 for a
// numeric join and for a value-union/concrete-variant join (handled upstream). The array
// predicates run before the i32-list `exprArray`, which would also claim a wider list via its typed-IR fast path.
export function ifExprRefKind(ifIx: i32, fnIx: i32): VKind | null {
  const tv = ifThenValueIx(ifIx)
  if tv < 0 { return null }
  // A closure join (kind 14, `(ref $cloStruct)`) checked first: a bare lambda arm is a
  // function value, not a string/array/struct.
  if exprIsClosure(tv, fnIx) { return "closure" }
  // The join's checked type is the arm-order-independent string signal: a `string`-typed
  // join (an atom + a string/member-literal arm, either order) is the string ref kind even
  // when the then arm alone doesn't classify stringy; the atom arm widens later.
  if tyKindOf(nodeTyIxOf(ifIx)) == 3 { return "str" }
  if exprString(tv, fnIx) { return "str" }
  if exprStringArray(tv, fnIx) { return "strlist" }
  // Scalar lists in `scalarListElemKind`'s own order — f32 before f64, since
  // `exprF64Array`'s typed-IR fast path would otherwise claim an `f32[]` join too.
  if exprF32Array(tv, fnIx) { return "f32list" }
  if exprF64Array(tv, fnIx) { return "f64list" }
  if exprI64Array(tv, fnIx) { return "i64list" }
  if exprRefArray(tv, fnIx) { return "reflist" }
  if exprArray(tv, fnIx) { return "list" }
  // A map join's blocktype selects this value-shape's `$mapStruct`, so the slot is the
  // map shape (`ifExprRefSlot`'s map arm), not a struct-table index.
  if exprMap(tv, fnIx) { return "map" }
  if structIndexOfExpr(tv, fnIx) >= 0 { return "struct" }
  // An object literal arm in a struct-typed context (return / binding seeds
  // `pendingStructIdx`) has no self-derivable struct index.
  const tn = P.nodes[tv]
  if tn is ObjLit {
    if pendingStructIdx >= 0 { return "struct" }
  }
  // A join whose deciding arm is itself nullable (D1560): every predicate above is
  // non-null, so a `T | null`-returning arm answers no to all of them and would otherwise
  // fall to the scalar path. Same kind order as the ladder above.
  const nlv = nulIfArmNullableValueIx(ifIx)
  if nlv >= 0 {
    if exprNullableString(nlv, fnIx) { return "str" }
    const nsk = exprNulScalarListKind(nlv, fnIx)
    if nsk == "nulstrlist" { return "strlist" }
    if nsk == "nulf32list" { return "f32list" }
    if nsk == "nulf64list" { return "f64list" }
    if nsk == "nuli64list" { return "i64list" }
    if exprNullableRefArray(nlv, fnIx) { return "reflist" }
    if exprNullableList(nlv, fnIx) { return "list" }
    if exprNullableMap(nlv, fnIx) { return "map" }
    // The variant arm goes ahead of the struct one: a union member's heap is `uVarHeap`,
    // and the struct fallback below would claim it with a row `sHeapIdx` doesn't have.
    if exprNullableVariant(nlv, fnIx) { return "variant" }
    if exprNullableStruct(nlv, fnIx) { return "struct" }
  }
  // A nullable-struct join whose then arm is `null` (no rep of its own): the struct index
  // resolves from the checker's inner struct in `ifExprRefSlot` instead.
  if nodeTyIsNullableStruct(ifIx) { return "struct" }
  null
}

// The `fbValtype` slot (second arg) for a ref-typed if-expression join of `kind`: the
// struct table index (kind 1) or the ref-list wrapper slot (kind 5); the other ref kinds
// ignore the slot. Prefers the pending context seed (a struct/list return or binding)
// over the then-arm's own derivation.
export function ifExprRefSlot(ifIx: i32, fnIx: i32, kind: VKind) {
  // The arm that carries the rep (D1560) — the same one `ifExprRefKind` classified from, so
  // a kind and its slot are never read off two different arms.
  const tv = ifRepArmValueIx(ifIx)
  // A nullable-variant join: the row is the arm's own `uVarHeap` index. Without it the
  // struct arm below would claim the value and `fbValtype` would floor with no interned shape.
  if kind == "variant" { return nulVariantIdxOfExpr(tv, fnIx) }
  if kind == "struct" {
    const si = structIndexOfExpr(tv, fnIx)
    if si >= 0 { return si }
    if pendingStructIdx >= 0 { return pendingStructIdx }
    // Then arm is `null` with no binding seed — resolve the struct from the checker's
    // nullable join type instead, so the arm rep and nullable blocktype find the layout.
    const inn = nodeNulStructInnerName(ifIx)
    if inn != "" { return structIndexOfTypeName(inn) }
    return pendingStructIdx
  }
  if kind == "reflist" {
    if pendingListKind == 5 { return pendingListSlot }
    return refListSlotOfExpr(tv, fnIx)
  }
  // A map join's slot is the map shape (mv slot / -1 mono / -2 set), the value every other
  // map valtype site passes to `mapTypeIdxOf`.
  if kind == "map" { return mapShapeFoldSet(mapShapeOfExpr(tv, fnIx)) }
  -1
}

// True if `stmtIx` is usable as an if-expression arm value: a plain tail value
// (`stmtIsTailValue`), or a nested if-expression. Kept separate from `stmtIsTailValue` so
// the function-tail nullable path (which routes an else-ful nullable tail through
// `emitIfTail`) is untouched; only the if-expression arm emitters opt into nesting.
export function ifArmIsValue(stmtIx: i32, fnIx: i32) {
  if stmtIsTailValue(stmtIx, fnIx) { return true }
  const s = P.nodes[stmtIx]
  if s is IfStmt { return ifTailIsValue(stmtIx, fnIx) }
  false
}

// The single-byte blocktype valtype for a value-position if-expression: the widest
// numeric rep across its arms (checked f64 → f32 → i64, else the i32 default).
export function ifExprValtype(ifIx: i32, fnIx: i32) {
  if exprIsF64(ifIx, fnIx) {
    return 124 // 0x7c f64
  }
  if exprIsF32(ifIx, fnIx) {
    return 125 // 0x7d f32
  }
  if exprIsI64(ifIx, fnIx) {
    return 126 // 0x7e i64
  }
  127 // 0x7f i32
}

// True if the declared local `name` is an i64 slot (kind 10 in the local registry).
function declaredI64(name: string) { declaredKind(name) == "i64" }

// True if the module global `name` is an i64 cell.
function globalIsI64Sid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsI64(li, -1)
}

// The unboxed scalar atom kind of a value-union null-coalesce `lhs ?? d` (`lhs` an ident
// or call yielding `T | null` with one non-null scalar atom): the result of `??` is that
// atom, so `print`-routing and numeric coercion classify it by the atom. -1 when the
// expression is not such a `??`, or the union keeps 2+ non-null atoms (still a box).
function coalesceAtomKind(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" {
      const nm = unionNameOfExpr(e.binLeft, fnIx)
      if nm != "" {
        if isValueUnionName(nm) && unionSetHasNull(nm) {
          const k = valueAtomKind(removeAtomFromSet(nm, "null"))
          if k >= 0 && k != 6 { return k }
        }
      }
    }
  }
  -1
}

// True if evaluating the expression at `exprIx` yields an i64 — a reference to an
// i64 param/local/global, or a parenthesized such. Drives the `print` import choice
// (`__print_i64__`, import 4). Arithmetic/calls returning i64 are Slice 2; here only
// the direct-reference forms (the Slice-1 `print(x)` shape) classify as i64.
export function exprIsI64(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyKindOf(nodeTyIxOf(exprIx)) == 10 {
    return true // typed-IR fast path (see exprIsF64)
  }
  if coalesceAtomKind(exprIx, fnIx) == 3 { return true }
  // `m[k] ?? d` over an i64-valued map yields an i64 (the value type).
  const cmi = coalesceMvSlot(exprIx, fnIx)
  if cmi >= 0 {
    if mvValKind[cmi] == 10 { return true }
  }
  const e = P.nodes[exprIx]
  // An explicit `x as T` cast has exactly its target rep (see exprIsF64).
  if e is AsExpr { return e.asTy == "i64" }
  if e is Paren { return exprIsI64(e.parInner, fnIx) }
  // A field read `s.x` whose struct field is an i64 slot (code 23) yields an i64.
  if e is Member { return memFieldTypeCode(exprIx, fnIx) == 23 }
  // A bare `m[k]` read over an i64-valued map yields an i64.
  if e is Index {
    // An indexed read of an i64 list (`xs[i]` over `i64[]`) is an i64 — the syntactic dual of
    // `exprIsF64`'s Index case. Needed for a synthetic `c[0]` (e.g. a captured-mutation box) that
    // carries no checker-recorded type for the typed-IR fast path above.
    if exprI64Array(e.idxArr, fnIx) { return true }
    const mri = mapReadMvSlot(exprIx, fnIx)
    if mri >= 0 {
      if mvValKind[mri] == 10 { return true }
    }
  }
  // A bare integer literal past the i32 range is typed i64 by the checker (the host's
  // `defaultIntegerType` magnitude rule) and lowers as `i64.const`, so it classifies as
  // i64 here too (a float `.` literal is f64, never i64).
  if e is NumLit {
    if numLexIsFloat(e.numText) { return false }
    return !numLexFitsI32(e.numText)
  }
  if e is Ident {
    // A value-union ident classifies by its narrowed atom (the read unboxes to that rep);
    // an un-narrowed union ident is the box, never a scalar.
    const uk = unionIdentReadKind(exprIx, fnIx)
    if uk != -3 { return uk == 3 }
    if paramIsI64(fnIx, e.identName) { return true }
    if declaredI64(e.identName) { return true }
    // A captured i64 — same field/read agreement `exprIsF64`'s arm carries: without it
    // the read widens through `i64.extend_i32_s` over a slot the env already types i64.
    if capturedKindOf(fnIx, e.identName) == "i64" { return true }
    return globalIsI64Sid(fnIx, sidOfNode(exprIx))
  }
  // An arithmetic/bitwise/shift op yields i64 when either operand is i64 (the i32 side
  // widens). Comparisons and logical connectives produce an i32 bool even over i64
  // operands, so they are not i64.
  if e is BinExpr {
    const op = e.binOp
    if (
      op == "+" ||
      op == "-" ||
      op == "*" ||
      op == "/" ||
      op == "%" ||
      op == "&" ||
      op == "|" ||
      op == "^" ||
      op == "<<" ||
      op == ">>" ||
      op == ">>>"
    ) {
      if exprIsI64(e.binLeft, fnIx) { return true }
      return exprIsI64(e.binRight, fnIx)
    }
    return false
  }
  // Unary negation `-x` / bitwise NOT `~x` preserve the operand's i64-ness (`!` is a bool,
  // never i64; `p+`/`p-` ride their operand but are statement-level).
  if e is Unary {
    if e.unOp == "-" || e.unOp == "~" {
      // Except `-2147483648`: the host folds the sign into the literal before defaulting,
      // so a negated magnitude-2^31 literal is i32 (at I32_MIN) even though the bare
      // operand literal classifies i64 above.
      if e.unOp == "-" {
        const negInner = P.nodes[unwrapParen(e.unArg)]
        if negInner is NumLit {
          if !numLexIsFloat(negInner.numText) {
            if numLexIs2Pow31(negInner.numText) { return false }
          }
        }
      }
      return exprIsI64(e.unArg, fnIx)
    }
    return false
  }
  // A call to an i64-returning function yields i64.
  if e is Call {
    // An indexed closure call `fs[i](x)` whose element signature returns i64.
    if cloArrCallRetKind(exprIx, fnIx) == "i64" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 { return fRetKind[target] == "i64" }
      // An i64-returning function value (a binding / `(…) => i64` param callee).
      return calleeReturnsI64Sid(sidOfNode(e.callFn), fnIx)
    }
    // An i64-returning field-closure call (`o.f(x)` over an `(…) => i64` field).
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return fRetKind[ffe] == "i64" }
    }
    return false
  }
  // A value-position if-expression is i64 when either arm's value is i64.
  if e is IfStmt { return ifExprArmIsKind(exprIx, fnIx, "i64") }
  false
}

// True if the declared local `name` is an f32 slot (kind 13 in the local registry).
function declaredF32(name: string) { declaredKind(name) == "f32" }

// True if the un-annotated `LetDecl` at `letIx` should infer an f32 slot — its initializer
// already yields an f32. f32 is the checker's weak spot (no f32 typed-IR), so this is
// annotation-only; without it an un-annotated `let y = s.x` over an f32 source would
// default to an i32 slot and store an f32 into it. A bare float literal stays f64.
export function letInfersF32(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return false }
    if d.letInit < 0 { return false }
    return exprIsF32(d.letInit, fnIx)
  }
  false
}

// True if the module global `name` is an f32 cell.
function globalIsF32Sid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsF32(li)
}

// Is the expression at `exprIx` a float number literal, peeling grouping parens and a
// leading unary `-`? A float literal is polymorphic across the float types (it adapts
// down to an f32 operand), so it doesn't force f64 like a genuine f64 value. The unary
// peel matters: `-1.0` parses as a `Unary` over the literal, which `emitExprAsF32` re-encodes to match.
function exprIsFloatLit(exprIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is NumLit { return numLexIsFloat(e.numText) }
  if e is Unary {
    if e.unOp == "-" {
      const neg = P.nodes[unwrapParen(e.unArg)]
      if neg is NumLit { return numLexIsFloat(neg.numText) }
    }
  }
  false
}

// What kinds of leaf does the arithmetic spine at `exprIx` (parens, unary `-`, `+ - * /`)
// carry? Bit 1 = a leaf the f32 classifier claims; bit 2 = a leaf `exprIsF64` claims that
// isn't a bare number literal (a genuine f64) — a literal contributes neither, since it
// re-encodes at whichever width the operation resolves to. Linear in the subtree.
function spineFloatLeafBits(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is Paren { return spineFloatLeafBits(e.parInner, fnIx) }
  if e is Unary {
    if e.unOp == "-" { return spineFloatLeafBits(e.unArg, fnIx) }
  }
  if e is BinExpr {
    const op = e.binOp
    if op == "+" || op == "-" || op == "*" || op == "/" {
      const lb = spineFloatLeafBits(e.binLeft, fnIx)
      const rb = spineFloatLeafBits(e.binRight, fnIx)
      return lb | rb
    }
  }
  if e is NumLit { return 0 }
  let bits = 0
  if exprIsF32(exprIx, fnIx) { bits = 1 }
  if exprIsF64(exprIx, fnIx) { bits = bits | 2 }
  bits
}

// Is the operand at `exprIx` a genuine f64 — one that does not adapt down to an f32
// operand? `exprIsF64` alone over-claims for a float literal anywhere inside an
// arithmetic node (`fv + 0.5`, `-1.0` both lower fine at f32), which matters because
// `emitFloatIntr` asks this of a routinely-compound intrinsic argument, not a leaf.
function exprHasHardF64(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if !exprIsF64(exprIx, fnIx) { return false }
  if exprIsFloatLit(exprIx) { return false }
  // In order: not `exprIsF64` → not hard; a float literal → not hard; a genuine f64 leaf
  // anywhere in the spine → hard; otherwise soft only if the spine has an f32 leaf to adapt to.
  const bits = spineFloatLeafBits(exprIx, fnIx)
  if bits >= 2 { return true }
  bits != 1
}

// Does a binary op over `leftIx`/`rightIx` have a genuine (non-literal) f64 operand? Such an
// operand makes the whole op f64 — an f32/i32/float-literal side widens to it. Drives both
// `exprIsF32` and the f32 emit slice: without it, the f32 slice would demote a genuine f64
// operand and trap.
export function binMixHardF64(leftIx: i32, rightIx: i32, fnIx: i32) {
  if exprHasHardF64(leftIx, fnIx) { return true }
  exprHasHardF64(rightIx, fnIx)
}

// True if evaluating `exprIx` yields an f32: a reference to an f32 param/local/global, f32
// arithmetic (either operand f32 — an i32 or float literal on the other side coerces), or
// unary `-`/parens over such. A bare float literal is not f32 by default (`exprIsF64`
// claims it); checked before `exprIsF64` so a mixed f32/literal expression routes to f32.
export function exprIsF32(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyKindOf(nodeTyIxOf(exprIx)) == 13 {
    return true // typed-IR fast path (see exprIsF64)
  }
  if coalesceAtomKind(exprIx, fnIx) == 5 { return true }
  const e = P.nodes[exprIx]
  // An explicit `x as T` cast has exactly its target rep (see exprIsF64).
  if e is AsExpr { return e.asTy == "f32" }
  if e is Paren { return exprIsF32(e.parInner, fnIx) }
  // An index read `xs[i]` over an `f32[]` yields an f32 element.
  if e is Index {
    if exprF32Array(e.idxArr, fnIx) { return true }
  }
  // A field read `s.x` whose struct field is an f32 slot (code 24) yields an f32.
  if e is Member { return memFieldTypeCode(exprIx, fnIx) == 24 }
  if e is Ident {
    // A value-union ident classifies by its narrowed atom (see exprIsI64).
    const uk = unionIdentReadKind(exprIx, fnIx)
    if uk != -3 { return uk == 5 }
    if paramIsF32(fnIx, e.identName) { return true }
    if declaredF32(e.identName) { return true }
    // A captured f32 — same field/read agreement `exprIsF64`'s arm carries.
    if capturedKindOf(fnIx, e.identName) == "f32" { return true }
    return globalIsF32Sid(fnIx, sidOfNode(exprIx))
  }
  // Arithmetic yields f32 when either operand is f32. Comparisons and logical connectives
  // produce an i32 bool even over f32 operands, so they are not f32. `%` is here for the
  // reason `exprIsF64`'s arm gives (D1586).
  if e is BinExpr {
    const op = e.binOp
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
      // f32 arithmetic yields f32 only when no operand is a genuine f64 — a genuine f64 side
      // makes the op f64 (the f32 side widens). A float literal does not count.
      if binMixHardF64(e.binLeft, e.binRight, fnIx) { return false }
      if exprIsF32(e.binLeft, fnIx) { return true }
      return exprIsF32(e.binRight, fnIx)
    }
    return false
  }
  if e is Unary {
    if e.unOp == "-" { return exprIsF32(e.unArg, fnIx) }
    return false
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 { return fRetKind[target] == "f32" }
    }
    // An f32-returning field-closure call the typed-IR fast path can't see: the emitter's own
    // `dispatchRewrite` mints a `Call` with no arena entry for `x[i]` over a `"[]"` closure
    // field, so without this arm the f32 result bound into an i32 slot and failed validation.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return fRetKind[ffe] == "f32" }
    }
    return false
  }
  // A value-position if-expression is f32 when either arm's value is f32.
  if e is IfStmt { return ifExprArmIsKind(exprIx, fnIx, "f32") }
  false
}

// The non-i32 numeric rep an if-expression arm can carry. A pure selector, never encoded:
// it tags which `exprIs*` classifier `armValueIsKind` consults, rather than threading the
// bare wasm blocktype bytes 124/125/126 through each call site directly.
type BtKind = "f64" | "f32" | "i64"

// True if a value-position if-expression (`ifIx`) carries the numeric rep named by `kind`:
// either arm's tail value is of that kind, recursing through an `else if` chain in the else
// slot. Drives the whole-expression classification and the blocktype `emitIfExpr` picks; a
// bare i32-arm if-expression matches none of these and stays the i32 default.
function ifExprArmIsKind(ifIx: i32, fnIx: i32, kind: BtKind) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 { return false }
    const thenV = ifArmValueExpr(s.ifThen)
    if armValueIsKind(thenV, fnIx, kind) { return true }
    const els = P.nodes[s.ifElse]
    if els is IfStmt { return ifExprArmIsKind(s.ifElse, fnIx, kind) }
    return armValueIsKind(ifArmValueExpr(s.ifElse), fnIx, kind)
  }
  false
}

// Classify a single arm-value expression against a numeric rep `kind`.
function armValueIsKind(exprIx: i32, fnIx: i32, kind: BtKind) {
  match kind {
    "f64" => exprIsF64(exprIx, fnIx)
    "f32" => exprIsF32(exprIx, fnIx)
    "i64" => exprIsI64(exprIx, fnIx)
  }
}

// True if the declared local `name` is an f64 slot (kind 11 in the local registry).
function declaredF64(name: string) { declaredKind(name) == "f64" }

// True if the module global `name` is an f64 cell.
function globalIsF64Sid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsF64(li, -1)
}

// True if evaluating `exprIx` yields an f64: a float `.` literal, a reference to an f64
// param/local/global, f64 arithmetic (either operand f64 — the i32 side widens via
// `f64.convert_i32_s`), unary `-`/parens over such, or a call to an f64-returning function.
// Drives the `print` import choice (`__print_f64__`) and the per-operand opcode selection.
export function exprIsF64(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // Typed-IR fast path (additive — only turns false into true, so the syntactic derivation
  // below still applies to a node with no recorded type, e.g. a monomorphized instance body).
  if tyKindOf(nodeTyIxOf(exprIx)) == 11 { return true }
  if coalesceAtomKind(exprIx, fnIx) == 4 { return true }
  // `m[k] ?? d` / `m.get(k) ?? d` over an f64-valued map yields an f64 (the value type).
  const cmf = coalesceMvSlot(exprIx, fnIx)
  if cmf >= 0 {
    if mvValKind[cmf] == 11 { return true }
  }
  const e = P.nodes[exprIx]
  // An explicit `x as T` cast has exactly its target rep — classify syntactically
  // (robust where `nodeTyIx` is absent, e.g. a monomorphized body).
  if e is AsExpr { return e.asTy == "f64" }
  if e is NumLit { return numLexIsFloat(e.numText) }
  if e is Paren { return exprIsF64(e.parInner, fnIx) }
  // An index read into an `f64[]` yields an f64 element — so it routes to `__print_f64__`
  // and participates in f64 arithmetic. A bare `m[k]` read over an f64-valued map likewise yields an f64.
  if e is Index {
    if exprF64Array(e.idxArr, fnIx) { return true }
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 {
      if mvValKind[mrs] == 11 { return true }
    }
    return false
  }
  if e is Ident {
    // A value-union ident classifies by its narrowed atom (see exprIsI64).
    const uk = unionIdentReadKind(exprIx, fnIx)
    if uk != -3 { return uk == 4 }
    if paramIsF64(fnIx, e.identName) { return true }
    if declaredF64(e.identName) { return true }
    // A captured f64: the env field is typed by `captureValKind`, so the read must classify
    // by the same answer or the two disagree and widen through `f64.convert_i32_s` over a
    // slot that already holds an f64 (`vl check`-clean invalid wasm).
    if capturedKindOf(fnIx, e.identName) == "f64" { return true }
    return globalIsF64Sid(fnIx, sidOfNode(exprIx))
  }
  // Arithmetic yields f64 when either operand is f64. Comparisons and logical connectives
  // produce an i32 bool even over f64 operands, so they are not f64. `%` is here because
  // float remainder has a form (D1586) and its result is the dividend's width.
  if e is BinExpr {
    const op = e.binOp
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
      if exprIsF64(e.binLeft, fnIx) { return true }
      return exprIsF64(e.binRight, fnIx)
    }
    // `xs.get(i) ?? d` over an f64 list yields an f64 (the fused checked read);
    // the default `d` shares the element type, so classify by the right side.
    if op == "??" {
      const lhs = P.nodes[unwrapParen(e.binLeft)]
      if lhs is Call {
        const lcallee = P.nodes[lhs.callFn]
        if lcallee is Member {
          if lcallee.memProp == "get" || lcallee.memProp == "pop" {
            if exprF64Array(lcallee.memObj, fnIx) { return true }
          }
        }
      }
      return false
    }
    return false
  }
  // Unary negation `-x` preserves f64-ness (`~` is integer-only; `!` is bool).
  if e is Unary {
    if e.unOp == "-" { return exprIsF64(e.unArg, fnIx) }
    return false
  }
  if e is Call {
    // An indexed closure call `fs[i](x)` whose element signature returns f64.
    if cloArrCallRetKind(exprIx, fnIx) == "f64" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 { return fRetKind[target] == "f64" }
      // A function-value (closure) callee returning f64 — its result routes as f64.
      return calleeReturnsF64Sid(sidOfNode(e.callFn), fnIx)
    }
    // A field-closure call `t.op(x)` whose field function returns f64.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return cloRetKindOf(ffe) == "f64" }
    }
    return false
  }
  // A field read `p.x` whose struct field is an f64 slot (code 17) yields an f64.
  if e is Member { return memFieldTypeCode(exprIx, fnIx) == 17 }
  // A value-position if-expression is f64 when either arm's value is f64 (the branch-join
  // widens to f64); an `else if` chain recurses through the else slot.
  if e is IfStmt { return ifExprArmIsKind(exprIx, fnIx, "f64") }
  false
}

export function exprIsBool(ix: i32, fnIx: i32) {
  if ix < 0 { return false }
  // Typed-IR fast path (additive, mirroring exprIsF64): boolean shares the i32 rep
  // everywhere, so the syntactic derivations below still cover paths that lose the tag
  // (a struct-field read, a map `??` result, a closure-value call, a `boolean[]` param).
  if nodeTyWidenedRepName(ix) == "boolean" { return true }
  const e = P.nodes[ix]
  if e is BoolLit { return true }
  if e is IsExpr { return true }
  if e is Paren { return exprIsBool(e.parInner, fnIx) }
  if e is Index {
    // An element read over a boolean-element list prints as true/false: a `.map` result
    // whose callback returns boolean, or a directly declared `boolean[]`.
    if mfArrElemIsBool(e.idxArr, fnIx) { return true }
    return listElemIsBool(e.idxArr, fnIx)
  }
  if e is Unary { return e.unOp == "!" }
  if e is Ident {
    // A value-union ident narrowed to `boolean` unboxes to the bool rep and prints
    // true/false (see exprIsI64 for the classification rule).
    const uk = unionIdentReadKind(ix, fnIx)
    if uk != -3 { return uk == 1 }
    // A `boolean|null` niche binding read (narrowed non-null in its branch) prints
    // true/false. Plain `boolean` idents stay unclassified (existing rule).
    if exprNulBool(ix, fnIx) { return true }
    // A captured boolean (a closure returning its maker's `x: boolean` param) — the
    // closure's inferred return kind (`fRetBool`) sees the bool-ness through the env.
    if capturedIsBool(fnIx, e.identName) { return true }
    // A plain boolean local/param/global — recovered from the binding's annotation
    // or initializer, since a boolean local registers identically to an i32.
    if boundBoolByName(e.identName, fnIx) { return true }
  }
  if e is BinExpr {
    const op = e.binOp
    if op == "==" || op == "!=" { return true }
    if op == "<" || op == ">" || op == "<=" || op == ">=" { return true }
    if op == "&&" || op == "||" { return true }
    // `lhs ?? d` over a boolean-list `.get`/`.pop` (or a binding seeded by one) yields a
    // boolean — render true/false. Other `??` reads keep i32 (map gets).
    if op == "??" {
      const lhs = P.nodes[unwrapParen(e.binLeft)]
      if lhs is Call {
        const lcallee = P.nodes[lhs.callFn]
        if lcallee is Member {
          if lcallee.memProp == "get" || lcallee.memProp == "pop" {
            if !exprMap(lcallee.memObj, fnIx) {
              return listElemIsBool(lcallee.memObj, fnIx)
            }
          }
        }
      }
      if lhs is Ident { return identNullableBoolPop(lhs.identName, fnIx) }
    }
    return false
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    // A field-closure call (an index-trap dispatch) classifies by the field function's
    // return: the receiver's origin resolves the exact monomorphized instance, since bool-
    // ness lives in the instance's own pinned param annotation, not the shared closure body.
    if callee is Member {
      if (
        drwFieldClosure(structIndexOfExpr(callee.memObj, fnIx), callee.memProp)
      ) {
        return fieldCloCallIsBool(callee.memObj, callee.memProp, fnIx)
      }
    }
    if callee is Ident {
      const target = fnIndexOf(callee.identName)
      if target >= 0 {
        const fn = P.nodes[fnStmts[target]]
        if fn is FuncDecl {
          if fn.fnRet >= 0 {
            // The arena also drops the `rt is TypeRef` gate the name form needed: a return
            // annotation that isn't a bare `TypeRef` still has a recorded type to read.
            if nodeTyPrimName(fn.fnRet) == "boolean" { return true }
            const rt = P.nodes[fn.fnRet]
            if rt is TypeRef { return false }
          } else {
            // Un-annotated: `computeRetInference` classifies the callee's first valued
            // return into `fRetBool` (a fixed point, so mutual recursion resolves).
            return fRetBool[target] == 1
          }
        }
      }
    }
    // A map membership test `m.has(k)` and `m.delete(k)` both yield a boolean (print
    // true/false): `.has` reports presence, `.delete` reports whether it removed anything.
    if callee is Member {
      if callee.memProp == "has" { return exprMap(callee.memObj, fnIx) }
      if callee.memProp == "delete" { return exprMap(callee.memObj, fnIx) }
      // A string `s.includes(sub)` yields a boolean (print true/false).
      if callee.memProp == "includes" { return exprString(callee.memObj, fnIx) }
    }
  }
  if e is Member {
    // D931 — a generic carrier's boolean field, read in a monomorphized instance: a mono
    // clone shares its leaf nodes, so the checker's bank on `self.actual` still carries the
    // original's `T`, and the struct table alone can't answer since a boolean field is code
    // 0, layout-shared with i32. The instance's own row (`sTyIx`) still holds the precise type.
    const msi = structIndexOfExpr(e.memObj, fnIx)
    if msi >= 0 && msi < sTyIx.length {
      const mfty = tyFieldTyOf(sTyIx[msi], e.memProp)
      if mfty >= 0 && tyToEmitName(mfty) == "boolean" { return true }
    }
  }
  false
}

// The closure `$fnsig` key for the elements of a closure-element ref list (kind 5): strip the
// slot element's grouping parens and read its signature key. "" for a non-closure slot or an
// un-keyable signature. Lets an indexed closure call (`fs[i](x)`) cast to the element's real
// functype instead of the all-i32 arity fallback.
function cloArrSlotSigKey(slot: i32) {
  if slot < 0 || slot >= rlElemName.length { return "" }
  if rlElemKindTbl[slot] != 5 { return "" }
  rlElemCloSigKey(slot)
}

// The closure result type-name of a closure-element ref-list slot (kind 5): the element name
// is the parenthesized function type `(() => K0 | null)`; strip the grouping parens and return
// the text after the top-level `=>`. "" for a non-closure slot or an un-parseable element.
export function cloArrSlotRetName(slot: i32) {
  if slot < 0 || slot >= rlElemName.length { return "" }
  if rlElemKindTbl[slot] != 5 { return "" }
  let nm = rlElemName[slot]
  // A nullable-closure element slot: peel the `| null` (the call classifies on the
  // narrowed non-null closure), mirroring `cloArrSlotSigKey`.
  nm = nonNulBaseOf(nm)
  // Same paren-span-then-cut pair as `rlElemCloSigKey`: the span test guards the cut, with
  // no balance walk and an implied `length >= 2`.
  if !nameIsParenSpanEnds(nm) { return "" }
  // `annRetNameOf` is this `annArrowAt`-then-slice pair; its gate differs only for an arrow
  // at index 0, a spelling no renderer produces.
  return annRetNameOf(groupInnerOf(nm))
}

// The wide-scalar coercion kind of parameter `idx` from a `$fnsig` key's param-token spine:
// `"i64"` / `"f64"` / `"f32"`, or `null` (i32 or a ref kind — no coercion). Lets a value call
// widen an i32-literal argument into a wider parameter exactly as a direct call does —
// without it the `call_ref` pushes an i32 and traps.
export function sigParamCoerceKind(key: string, idx: i32): VKind | null {
  const k = sigParamKindAt(key, idx)
  if k == "i64" || k == "f64" || k == "f32" { return k }
  null
}

// The `VKind` of parameter `idx` in a `$fnsig` key's param-token spine — the whole answer
// `sigParamCoerceKind` filters to its three wide-scalar rows. `null` for an out-of-range
// index or a character outside the token vocabulary. The interlock: this token IS the
// valtype the `call_ref`'s cast functype declares, so a coercion decided from it agrees with the bytes.
export function sigParamKindAt(key: string, idx: i32): VKind | null {
  const ti = sigParamTokIx(key, idx)
  if ti < 0 { return null }
  repKindOfSigTok(key[ti])
}

// The character index where parameter `idx`'s token starts, or -1 (the walk met the `>`
// result separator or ran out of key). The one param-spine walk: the kind projection above
// and the slot projection below both read it, so the two cannot disagree about token boundaries.
function sigParamTokIx(key: string, idx: i32): i32 {
  let i = 0
  let p = 0
  while i < key.length {
    const c = key[i]
    if c == '>' { return -1 }
    if p == idx { return i }
    if repSigTokHasSlot(repKindOfSigTok(c)) {
      while i < key.length && key[i] != ';' { i = i + 1 }
      i = i + 1
    } else {
      i = i + 1
    }
    p = p + 1
  }
  -1
}

// The interned slot of parameter `idx` — the `;`-terminated decimal a slot-carrying token
// carries (`s3;`, `V0;`, `r1;`) — or -1 for a slot-free kind or no such parameter. The
// interlock: the digit is the table row whose heap type the `call_ref`'s cast declares.
export function sigParamSlotAt(key: string, idx: i32): i32 {
  sigSlotAtTok(key, sigParamTokIx(key, idx))
}

// D1100 — the lifted function a call hands back, or -1: `pick()(…)` where `pick`'s body
// returns a bare function name. The callee-position twin of `fieldClosureFeOfRecv` and
// `anonLeafArrElemFe`. One hop, deliberately: an arena-scanning resolver here stalled the
// compiler's own self-compile, so this reads the `FuncDecl` and its one return, O(1).
export function anonLeafRetCallFe(calleeIx: i32): i32 {
  const ix = unwrapParen(calleeIx)
  if ix < 0 { return -1 }
  const e = P.nodes[ix]
  if e is Call {
    const inner = P.nodes[unwrapParen(e.callFn)]
    if inner is Ident {
      const t = anonLeafFeDeclNode(
        fnIndexOfSid(sidOfNode(unwrapParen(e.callFn))),
      )
      if t >= 0 {
        const rx = fnRetExprOf(t)
        if rx >= 0 { return fieldValueFeOf(unwrapParen(rx)) }
      }
    }
  }
  -1
}

// D1100 — the arena node of lifted-function position `fe`, or -1. Every parallel-table read
// the container-delivery redirects make goes through it: a position past `fnStmts`'s end is
// an OOB read, which traps the compiler rather than refusing (D1152).
function anonLeafFeDeclNode(fe: i32): i32 {
  if fe < 0 { return -1 }
  if fe >= fnStmts.length { return -1 }
  fnStmts[fe]
}

// D1100 — did the `??` merge move either row of the function declared at `fnDeclIx`? The
// gate every container-delivery redirect takes, so a program with no merge keeps every byte.
function anonLeafFnRowsMovedOf(fnDeclIx: i32): boolean {
  if fnDeclIx < 0 { return false }
  if anonLeafRetMovedOf(fnDeclIx) { return true }
  const n = P.nodes[fnDeclIx]
  if n is FuncDecl {
    let pj = 0
    while pj < n.fnParams.length {
      const px = n.fnParams[pj]
      if px < anonLeafParamMoved.length {
        if anonLeafParamMoved[px] == 1 { return true }
      }
      pj = pj + 1
    }
  }
  false
}

// D1100 — the `$fnsig` an indexed closure-array call must use when the array holds a function
// whose rows a `??` merge moved: `cloArrSlotSigKey` reads the slot element's declared (pre-
// move) name, which then keys nothing interned. "" when the array's elements don't all name
// the same function (two functions in one slot share only one wasm signature by accident).
function anonLeafArrElemSigKey(arrIx: i32, fnIx: i32): string {
  const fe = anonLeafArrElemFe(arrIx, fnIx)
  if fe < 0 { return "" }
  // Gated on the move, so every other indexed closure call keeps `cloArrSlotSigKey`'s
  // element-name route byte for byte.
  if !anonLeafFnRowsMovedOf(anonLeafFeDeclNode(fe)) { return "" }
  const k = cloSigKeyExt(fe)
  // An un-interned key is one nothing can `call_indirect` at — the same refusal
  // `anonLeafMovedFnSigKey` makes, for the same reason.
  if k != "" && cloSigPosOfKey(k) >= 0 { return k }
  ""
}

// The one lifted function every element of the array behind `arrIx` holds, or -1 — the
// closure-array twin of `fieldClosureFeOfRecv`. Two different functions in one slot answer
// -1: a ref-list slot is one wasm signature, and they agree only by accident (D1100).
export function anonLeafArrElemFe(arrIx: i32, fnIx: i32): i32 {
  const li = anonLeafArrLitOf(arrIx, fnIx)
  if li < 0 { return -1 }
  const a = P.nodes[li]
  if a is ArrayLit {
    const els = a.arrElems
    if els.length == 0 { return -1 }
    let fe = -1
    let i = 0
    while i < els.length {
      const ei = fieldValueFeOf(unwrapParen(els[i]))
      if ei < 0 { return -1 }
      if fe < 0 { fe = ei }
      if fe != ei { return -1 }
      i = i + 1
    }
    return fe
  }
  -1
}

// The `ArrayLit` node an indexed callee's receiver resolves to — the literal itself, or the
// initializer of the binding that names it. -1 for anything this cannot follow, which is the
// answer that keeps every other indexed closure call on `cloArrSlotSigKey`'s route.
function anonLeafArrLitOf(arrIx: i32, fnIx: i32): i32 {
  const ix = unwrapParen(arrIx)
  if ix < 0 { return -1 }
  const e = P.nodes[ix]
  if e is ArrayLit { return ix }
  anonLeafArrBindingLitOf(ix, fnIx)
}

// The array literal a BINDING's initializer is — the one hop `anonLeafArrLitOf`'s own arm
// does not cover, and that ladder's default. -1 for a name this cannot follow: a parameter,
// a global built elsewhere, an initializer that is not a literal.
function anonLeafArrBindingLitOf(ix: i32, fnIx: i32): i32 {
  const e = P.nodes[ix]
  if e is Ident {
    let li = -1
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 { li = globalLetOfIn(fnIx, e.identName) }
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        // Guarded before `unwrapParen`: a binding with no initializer is -1, and peeling
        // parens off it reads `P.nodes[-1]` — a compiler trap, not a refusal (D1152).
        if d.letInit >= 0 {
          const iv = unwrapParen(d.letInit)
          if iv >= 0 {
            const ivn = P.nodes[iv]
            if ivn is ArrayLit { return iv }
          }
        }
      }
    }
  }
  -1
}

// The callee's interned `$fnsig` KEY for a value call (`f(x)`, `(o.field)(x)`, `fs[i](x)`), or "" —
// the param tokens drive argument coercion and the key resolves the functype the `call_ref` casts to.
export function cloCallSigKey(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cre = P.nodes[c.callFn]
    // The syntactic resolvers — fast (no type render): a function-typed binding/param Ident, a struct
    // field closure, an indexed closure-array element.
    if cre is Ident {
      const k = calleeCloSigKeySid(sidOfNode(c.callFn), fnIx)
      if k != "" {
        // The interned-divergence override: the syntactic resolvers are name-shaped, and a
        // name cannot always answer what a type can — a litunion whose spelling softened keys
        // the wrong box. Only overrides when the name key is un-interned and the arena key is
        // interned, so every call whose historic key names a real `$fnsig` keeps it.
        if cloSigPosOfKey(k) < 0 {
          const ak = sigKeyOfTy(nodeTyIxOf(c.callFn))
          if ak != "" && ak != k {
            if cloSigPosOfKey(ak) >= 0 { return ak }
          }
        }
        return k
      }
    }
    if cre is Member {
      const mfe = fieldClosureFeOfRecv(cre.memObj, cre.memProp, fnIx)
      if mfe >= 0 {
        // Same-field-name-set shapes dedup to one struct index, so the literal-resolved
        // closure may belong to another shape's field. Trust it only when the arity matches
        // the call; a mismatch falls to the checker-typed general fallback below, which keys
        // the field's real function type — unguarded, the wrong key drove invalid wasm.
        const mfn = P.nodes[fnStmts[mfe]]
        let mfArity = -1
        if mfn is FuncDecl { mfArity = mfn.fnParams.length }
        if mfArity == c.callArgs.length {
          const mfk = cloSigKeyExt(mfe)
          // D1100 — a moved function's own key is authoritative, ahead of the divergence
          // override below: the field holds a function whose rows a `??` merge moved, so its
          // interned `$fnsig` is what the table entry carries, while the callee node's arena
          // type is the field's pre-move declared arrow.
          if anonLeafFnRowsMovedOf(anonLeafFeDeclNode(mfe)) {
            if mfk != "" && cloSigPosOfKey(mfk) >= 0 { return mfk }
          }
          // The arity guard alone can't split same-arity twin fields that dedup to one row:
          // verify against the checker-typed callee when it's a proven function type — a
          // divergent key means the syntactic resolve aliased the twin, and the typed key is
          // the field's real lambda. Either side unresolvable keeps the historic key.
          const mcty = nodeTyIxOf(c.callFn)
          if mcty >= 0 {
            if T.tys[mcty] is TyFunc {
              // Keys the callee's arena functype directly (`sigKeyOfTy`) — the destringified
              // dual of rendering a name and re-parsing it.
              const mtk = sigKeyOfTy(mcty)
              // Only an interned divergent key overrides: the arena key can be a benign twin
              // of the interned one, and an un-interned key would break a working call.
              if mtk != "" && mtk != mfk {
                if cloSigPosOfKey(mtk) >= 0 { return mtk }
              }
            }
          }
          return mfk
        }
      }
    }
    // D1100 — the callee is a call that hands a `??`-moved function back (`pick()(…)`): its
    // own `$fnsig` is what the table entry carries, while the general fallback below would key
    // the pre-move declared arrow. Gated on the move, so any other returned closure is unaffected.
    if cre is Call {
      const rfe = anonLeafRetCallFe(c.callFn)
      if rfe >= 0 {
        if anonLeafFnRowsMovedOf(anonLeafFeDeclNode(rfe)) {
          const rk = cloSigKeyExt(rfe)
          if rk != "" && cloSigPosOfKey(rk) >= 0 { return rk }
        }
      }
    }
    if cre is Index {
      if exprRefArray(cre.idxArr, fnIx) {
        // D1100 — the moved-row override, ahead of the slot's own key: `cloArrSlotSigKey`
        // reads the declaration's (pre-move) spelling, which names the wrong functype after a
        // merge moves the element function's rows. "" outside such a family.
        const ek = anonLeafArrElemSigKey(cre.idxArr, fnIx)
        if ek != "" { return ek }
        const k = cloArrSlotSigKey(refListSlotOfExpr(cre.idxArr, fnIx))
        if k != "" { return k }
      }
    }
    // General fallback, off the hot path: derive the key from the callee's checker arena type
    // uniformly for any callee the syntactic resolvers miss (an indexed closure-array element
    // returning a struct/union, a value inferred from a factory call). `sigKeyOfTy` walks the
    // `TyFunc` spine directly, with no per-position sig producer or string spine scan.
    const ck = sigKeyOfTy(nodeTyIxOf(c.callFn))
    if ck != "" { return ck }
  }
  ""
}

// The literal-union parameter flavour of value call `callIx`'s parameter `idx`: `1` a `K`
// atom param, `2` a `K | null` niche param, `0` neither — the `emitCallRef` twin of what
// `emitCall` reads off a declared callee's `Param` node. Can't come from the `$fnsig` key:
// a litunion param's token is deliberately `i`, identical to a plain i32's.
export function cloCallParamLitUnion(callIx: i32, idx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const ft = nodeTyIxOf(c.callFn)
    if ft < 0 { return 0 }
    const t = T.tys[ft]
    if t is TyFunc {
      if idx < 0 || idx >= t.fnParamTypes.length { return 0 }
      const pty = t.fnParamTypes[idx]
      // Alias-only for the non-null form, by arena-index identity: an inline `"a" | "b"`
      // param really is a string (outside `litUnionPreserve`'s set), and call sites already
      // work by pushing it. `unionAliasDeclNameOfTy`, not `litUnionAliasNameOfTy` (which
      // would name the inline spelling "K" wherever `type K = "a" | "b"` is also declared).
      if tyIsLitUnion(pty) {
        // `tyLitUnionAliasIx`, not `unionAliasDeclNameOfTy`: both exclude the inline
        // spelling, but the name form also misses a narrowed copy, whose rep is the atom.
        if tyLitUnionAliasIx(pty) >= 0 { return 1 }
        return 0
      }
      // The niche claims both spellings, exactly as `nodeTyIsNulLitUnion` does: inline and
      // aliased alike rep as the i32 atom with the `-1` null sentinel.
      if tyIsNullableLitUnion(pty) { return 2 }
    }
  }
  0
}

// The callee's own `TyFunc` arena row for value call `callIx`, or -1 — asked of the
// callee's annotation before the call node's recorded type, and the order matters: inside
// a monomorphized instance the body shares leaf nodes with the generic, so
// `nodeTyIxOf(c.callFn)` answers the generic's own type-variable signature, not the pin.
function cloCallCalleeFnTy(callIx: i32, fnIx: i32): i32 {
  const c = P.nodes[callIx]
  if c is Call {
    const cre = P.nodes[c.callFn]
    if cre is Ident {
      // A parameter (an instance's substituted `f: (i32, i32) => K`, or an ordinary
      // annotated function-typed param).
      const pt = paramTypeNode(fnIx, cre.identName)
      if pt >= 0 {
        const pty = nodeTyIxOf(pt)
        if pty >= 0 {
          if T.tys[pty] is TyFunc { return pty }
        }
      }
      // An annotated function-typed binding (`const f: (i32) => K = base`).
      const jnd = identFnTypeAnnNodeSid(sidOfNode(c.callFn), fnIx)
      if jnd >= 0 {
        const jty = nodeTyIxOf(jnd)
        if jty >= 0 {
          if T.tys[jty] is TyFunc { return jty }
        }
      }
    }
    // Everything else — a field closure, an indexed element, an inferred binding — keys off
    // the callee's own checker type, exactly as `cloCallSigKey`'s general fallback does.
    const direct = nodeTyIxOf(c.callFn)
    if direct >= 0 {
      if T.tys[direct] is TyFunc { return direct }
    }
  }
  -1
}

// The result twin of `cloCallParamLitUnion`: does value call `callIx` yield a literal-union
// interned i32 atom? The `$fnsig` key can't supply it (a litunion result's token is `i`,
// identical to a plain i32's). Without it, a function-value call inside a monomorphized
// instance staged the atom into a string-narrow slot: `vl check` rc 0, refused at load.
export function cloCallResultLitUnion(callIx: i32, fnIx: i32): boolean {
  const ft = cloCallCalleeFnTy(callIx, fnIx)
  if ft < 0 { return false }
  const t = T.tys[ft]
  if t is TyFunc { return tyLitUnionAliasIx(t.fnRet) >= 0 }
  false
}

// The last-resort rung of `cloCallParamUnionName`: inside a monomorphized instance the
// callee `Ident` shares a leaf with the generic, so `nodeTyIxOf` answers a `TyFunc` no
// union registry ever names. The lifted lambda's own `Param` node carries the substituted
// pin instead (D426): last, since every callee resolving today takes an earlier candidate.
function cloLamParamUnionName(calleeIx: i32, idx: i32, fnIx: i32) {
  const cre = P.nodes[calleeIx]
  if cre is Ident {
    const fe = identClosureFeSid(sidOfNode(calleeIx), fnIx)
    if fe >= 0 && fe < fnStmts.length {
      const lf = P.nodes[fnStmts[fe]]
      if lf is FuncDecl {
        if idx >= 0 && idx < lf.fnParams.length {
          const p = P.nodes[lf.fnParams[idx]]
          if p is Param {
            if p.parType >= 0 {
              const nm = tyNameOf(p.parType)
              if nm != "" {
                // The registration test the arena arms make, restated by the same producer:
                // a name `annParamKind` keys `u` is one `isUName` admits, hence one
                // `unionMemberSetOf` resolves.
                if annParamKind(nm) == repSigTokOfKind("union") { return nm }
              }
            }
          }
        }
      }
    }
  }
  ""
}

// The union-box parameter name of value call `callIx`'s parameter `idx` — the emitter's
// registered union name (`isUName`), which `emitUnionCoerce` resolves to its member set for
// the tag choice. "" when not a union box. Can't come from the `$fnsig` key: the union token
// `u` is slot-free (every boxed union shares one valtype), so identity comes from here.
export function cloCallParamUnionName(callIx: i32, idx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const ft = nodeTyIxOf(c.callFn)
    if ft < 0 { return cloLamParamUnionName(c.callFn, idx, fnIx) }
    const t = T.tys[ft]
    if t is TyFunc {
      if idx < 0 || idx >= t.fnParamTypes.length { return "" }
      const pty = t.fnParamTypes[idx]
      if tyIsLitUnion(pty) { return "" }
      if tyIsNullableLitUnion(pty) { return "" }
      // A registry lookup, not a key mint: the union registry fills from whichever spelling
      // reaches it first, and the arena can't say which — so ask, most specific first: (1)
      // the declared alias, by arena-index identity; (2) the nominal render, for an inline
      // union registered under its member set; (3) the structural render.
      let nm = unionAliasDeclNameOfTy(pty)
      if nm != "" {
        if annParamKind(nm) == repSigTokOfKind("union") { return nm }
      }
      nm = tyToNominalName(pty)
      if nm != "" {
        if annParamKind(nm) == repSigTokOfKind("union") { return nm }
      }
      nm = tyToEmitName(pty)
      if nm == "" { return cloLamParamUnionName(c.callFn, idx, fnIx) }
      // The registration test, made by the token producer itself rather than restated: a
      // name `annParamKind` keys `u` is one `isUName` admits, hence one `unionMemberSetOf`
      // resolves. Asking the producer keeps this arm and the ABI from ever disagreeing.
      if annParamKind(nm) != repSigTokOfKind("union") {
        return cloLamParamUnionName(c.callFn, idx, fnIx)
      }
      return nm
    }
  }
  ""
}

// The producer (concrete-lambda) `$fnsig` key of a function-value binding `name` — the
// functype the lambda value actually carries (`cloSigKeyExt` of the resolved lambda),
// chasing a plain copy to the source binding's initializer lambda. "" when `name` does
// not resolve to a concrete lambda.
function producerCloSigKey(name: string, fnIx: i32) {
  const fe = identClosureFe(name, fnIx)
  if fe >= 0 { return cloSigKeyExt(fe) }
  const src = identCopySource(name, fnIx)
  if src != "" && src != name { return producerCloSigKey(src, fnIx) }
  ""
}

// Soundness floor: a function-value call whose resolved cast `$fnsig` and its concrete
// producer lambda's `$fnsig` are both ref-list results on different, non-layout-twin
// element slots — array elements are invariant, so the `ref.cast` to the annotation's
// wrapper traps on the producer's. Rejects loudly rather than emit the latent trap (#875).
export function cloCallReflistElemTwin(callIx: i32, fnIx: i32): boolean {
  const c = P.nodes[callIx]
  if c is Call {
    const cre = P.nodes[c.callFn]
    if cre is Ident {
      const castK = cloCallSigKey(callIx, fnIx)
      if castK == "" { return false }
      const prodK = producerCloSigKey(cre.identName, fnIx)
      if prodK == "" { return false }
      if prodK == castK { return false }
      if cloSigPosOfKey(castK) < 0 { return false }
      if cloSigPosOfKey(prodK) < 0 { return false }
      const crk = sigKeyRetKind(castK)
      const prk = sigKeyRetKind(prodK)
      if crk == null || prk == null { return false }
      if crk == "reflist" && prk == "reflist" {
        const cs = sigKeyRetSlot(castK)
        const ps = sigKeyRetSlot(prodK)
        if cs >= 0 && ps >= 0 && cs != ps {
          if rlSlotsLayoutTwin(cs, ps) == 0 { return true }
        }
      }
    }
  }
  false
}

// The declared list type-name of the expression at `ix`, or "" — an annotation, not a rep.
// Covers all four storage classes a list binding can have (param, function-scoped
// let/const, module global, one level of index), because inside a monomorphized instance
// the checker never typed the cloned body, so only the substituted annotation is left.
function listAnnNameOf(ix: i32, fnIx: i32) {
  if ix < 0 { return "" }
  const e = P.nodes[unwrapParen(ix)]
  if e is Ident {
    const ptn = paramTypeNode(fnIx, e.identName)
    if ptn >= 0 {
      const pt = P.nodes[ptn]
      if pt is TypeRef { return pt.tyName }
    }
    let li = -1
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 { li = globalLetOfIn(fnIx, e.identName) }
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letType >= 0 {
          const lt = P.nodes[d.letType]
          if lt is TypeRef { return lt.tyName }
        }
      }
    }
    return ""
  }
  if e is Index {
    const outer = listAnnNameOf(e.idxArr, fnIx)
    if outer != "" { return arrElemNameRaw(outer) }
  }
  ""
}

// True if the list at `arrIx` carries boolean elements: a `[true, ...]` literal, a
// `boolean[]` annotation on any storage class, a name tracing to either through its
// initializer, or a `.map`/`.filter` callback returning boolean. Rides the i32 list rep
// (0/1), with spare value 2 encoding a checked `.pop()`'s `boolean | null` niche sentinel.
export function listElemIsBool(arrIx: i32, fnIx: i32) {
  if arrIx < 0 { return false }
  const inner = unwrapParen(arrIx)
  const e = P.nodes[inner]
  if e is ArrayLit {
    if e.arrElems.length > 0 { return exprIsBool(e.arrElems[0], fnIx) }
    return false
  }
  // The array grammar's one cut (`arrElemNameRaw`) plus the bare leaf name — deliberately
  // not `nameIsI32Array`, which is rep-wide (also accepts `i32[]`, litunion `K[]`, niche
  // arrays) where this site is about the element's print formatting specifically.
  const annElem = arrElemNameRaw(listAnnNameOf(inner, fnIx))
  // Stays on the name rather than the arena twin (`tyArrayElemPrimName`) on purpose: inside
  // a monomorphized instance the body is a clone the checker never typed, so the node-type
  // bank has nothing and only the substituted annotation carries the boolean-ness.
  // Substituting the arena twin breaks `generics/bool-list-arg-print.vl` (B77).
  if annElem == "boolean" { return true }
  // A numeric declared element outranks the initializer-derived kind below: the A7
  // boolean→i32 coercion adapts an array literal element-wise, so `const e: i32[] = [t]`
  // with a boolean-typed `t` is still a declared-i32 list that must print as a number.
  if annElem == "i32" || annElem == "u8" { return false }
  if e is Ident {
    let li = -1
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 { li = globalLetOfIn(fnIx, e.identName) }
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letInit >= 0 {
          if unwrapParen(d.letInit) != inner {
            return listElemIsBool(d.letInit, fnIx)
          }
        }
      }
    }
    return false
  }
  mfArrElemIsBool(arrIx, fnIx)
}

// True if `name` is a binding whose initializer is a checked `.pop()` over a
// BOOLEAN-element list — its i32 cell holds 0/1 or the niche sentinel 2 (`null`),
// so a later `name ?? d` must compare against 2, not test a ref.
export function identNullableBoolPop(name: string, fnIx: i32) {
  let li = -1
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { li = parentLetOf(fn.fnBody, name) }
  }
  if li < 0 { li = globalLetOfIn(fnIx, name) }
  if li >= 0 {
    const d = P.nodes[li]
    if d is LetDecl {
      if d.letInit >= 0 {
        const ini = P.nodes[unwrapParen(d.letInit)]
        if ini is Call {
          const callee = P.nodes[ini.callFn]
          if callee is Member {
            if callee.memProp == "pop" {
              return listElemIsBool(callee.memObj, fnIx)
            }
          }
        }
      }
    }
  }
  false
}

// The interned `$fnsig` key of a `.map`/`.filter` callback that is a closure value — a
// function-typed param or binding (`xs.map(f)` with `f: (i32) => i32`), not a literal
// lambda / named function (those resolve a lifted `mfCallbackFe`). "" otherwise. Lets a
// higher-order function forward a runtime callback to `.map`.
export function mfCallbackCloKey(cbIx: i32, fnIx: i32) {
  const cb = P.nodes[unwrapParen(cbIx)]
  if cb is Ident {
    if fnIndexOf(cb.identName) >= 0 {
      return "" // a named fn — uses the lifted-fe path
    }
    return calleeCloSigKey(cb.identName, fnIx)
  }
  ""
}

// Map a closure sig-return kind (`sigKeyRetKind`) to a `.map` result element kind
// (`mfResultKindOf`'s vocabulary), for a closure-value callback. A struct return maps to a
// ref-list result — its slot comes from `mfResultSlotOf`'s closure-value branch. `null`
// for a void result / still-unwired ref kind.
function mfResKindFromSigRet(k: VKind | null): MfKind | null {
  if k == "i32" { return "i32" }
  if k == "f64" { return "f64" }
  if k == "i64" { return "i64" }
  if k == "str" { return "str" }
  if k == "struct" { return "ref" }
  null
}

// Push the discriminant narrowing a field test implies for its receiver: `s.kind is KC` and
// `s.kind == "circle"` both refine `s` via the checker's banked surviving type at the
// condition node, so this reads one answer for both spellings. Single survivor only: a test
// leaving two of three arms needs a member-set id, not a name, so nothing is pushed then.
function pushDiscrimNarrow(
  placeIx: i32,
  condIx: i32,
  fnIx: i32,
  elseArm: boolean,
): boolean {
  const pn = P.nodes[placeIx]
  if !(pn is Member) { return false }
  const root = P.nodes[unwrapParen(pn.memObj)]
  if !(root is Ident) { return false }
  let dTy = isParentTyIxOf(condIx)
  if elseArm { dTy = isParentElseTyIxOf(condIx) }
  if dTy < 0 { return false }
  // An anonymous arm has no nominal name, and its variant row is spelled by its render
  // (D1473): `variantIndexOfOwnRender` asks canon's own render of the arm, keyed on the
  // same atom spelling the row itself is banked under — so the read side's exact
  // `variantIndexOf` compare cannot miss it.
  let dNm = nominalStructNameOfTy(dTy)
  if dNm == "" || variantIndexOf(dNm) < 0 {
    const dvr = variantIndexOfOwnRender(tyToEmitName(dTy))
    if dvr >= 0 { dNm = uVariants[dvr] }
  }
  if dNm == "" { return false }
  if variantIndexOf(dNm) < 0 { return false }
  // The name must be a member of this receiver's own set — skipping that check is a
  // cast-failure trap: an arena type can carry more than one nominal name (an alias fold
  // can make two distinct unions structurally identical), so `nominalStructNameOfTy` can
  // answer a name from the wrong union, casting the box to the wrong variant heap type.
  const setTxt = currentStructNarrowSetOf(root.identName, fnIx)
  if setTxt == "" { return false }
  const atoms: string[] = []
  splitUnionAtoms(setTxt, atoms)
  let found = false
  let ai = 0
  while ai < atoms.length {
    if atoms[ai] == dNm { found = true }
    ai = ai + 1
  }
  if !found { return false }
  pushNarrowRep(root.identName, dNm, dTy, -1)
  true
}

// The value-union name of an index read `xs[0]` whose receiver is a ref list with a
// union-box element (kind 2), or "" otherwise. The index twin of `memberUnionFieldNameRead`
// — the one gate every index narrowing channel asks before minting a key, so the push side
// and the read side cannot disagree about which cells hold a box.
export function indexElemUnionName(idxIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(idxIx)]
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        if rlElemKindTbl[slot] == 2 { return rlElemName[slot] }
      }
    }
  }
  ""
}

// The nullable-ref-array element name of an index read `xs[0]` — `"i32[][][] | null"` for
// `xs: (i32[][][] | null)[]` — or "" otherwise (D451's other half). A niche, not a box:
// `array.get` + `ref.as_non_null` already leaves the right value, so the peel is sound
// only under the narrowing guard, not off the bare name.
function indexElemNulRefArrayName(idxIx: i32, fnIx: i32) {
  const ix = unwrapParen(idxIx)
  const e = P.nodes[ix]
  if e is Index {
    if exprNullableRefArray(ix, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemName.length {
        const np = nullablePartOf(rlElemName[slot])
        if np != "" && nameIsRefArray(np) { return np }
      }
    }
  }
  ""
}

// Push the narrowing for an index place whose cell is a niche — a nullable reference the
// read leaves `(ref null …)` rather than a tagged box. Returns whether it pushed. Not one
// rep family: of the seven nullable reps, four are boxes (`new i32`/`i64`/`f32`/`f64`) but
// `new string` and the two three-deep arrays are niches, each failing with its own wasm error.
function pushIndexNicheNarrow(idxIx: i32, fnIx: i32) {
  const ik = indexPathKeyOf(idxIx)
  if ik == "" { return false }
  // A nullable ref-array cell carries its peeled name as the variant, because the guarded
  // reads resolve the inner ref-list row from it.
  const np = indexElemNulRefArrayName(idxIx, fnIx)
  if np != "" {
    pushNarrow(ik, np)
    return true
  }
  // A nullable string cell — the variant only has to be a non-`null` spelling, and
  // `string` is the atom the recovered ref actually holds.
  const e = P.nodes[unwrapParen(idxIx)]
  if e is Index {
    if exprNulStrArray(e.idxArr, fnIx) {
      pushNarrow(ik, "string")
      return true
    }
  }
  false
}

// The mv slot of a bare map read `m[1]` whose value reads back as a reference, or -1. The
// three scalar-backed value kinds are excluded (11 f64, 10 i64, 13 f32): `emitMapGet`'s
// miss arm yields `ref.null` for every other kind, so a guard can prove the read present,
// while those three miss as a numeric zero with no null to recover from.
export function mapReadNarrowableSlot(idxIx: i32, fnIx: i32) {
  const mrs = mapReadMvSlot(idxIx, fnIx)
  if mrs < 0 || mrs >= mvValKind.length { return -1 }
  const k = mvValKind[mrs]
  if k == 10 || k == 11 || k == 13 { return -1 }
  mrs
}

// The value-atom kind a bare map read `m[1]` unboxes to, or -1 for "keeps its rep". Answers
// only for a union-box value (kind 2) whose index place is narrowed to one value atom — the
// one producer both the read (`emitNarrowedMapReadTail`) and every classifier that must stop
// calling it a box ask, so the two cannot disagree about which reads the lowering already opened.
export function mapReadNarrowedAtomKind(exprIx: i32, fnIx: i32) {
  const mrs = mapReadNarrowableSlot(exprIx, fnIx)
  if mrs < 0 { return -1 }
  if mvValKind[mrs] != 2 { return -1 }
  const a = narrowedValueAtomOf(indexPathKeyOf(exprIx))
  if a == "" { return -1 }
  const ak = valueAtomKind(a)
  if ak < 0 || ak == 6 { return -1 }
  ak
}

// Push the narrowing for a map index place `m[1] is T` — the map twin of the ref-list
// element and niche arms above. One arm serves both reps: a bare `m[k]` is always
// `V | null` (a miss is the null), so every ref-valued read just proves non-null, while a
// union value (kind 2) additionally unboxes to the tested atom.
function pushIndexMapNarrow(
  idxIx: i32,
  variant: string,
  condIx: i32,
  fnIx: i32,
) {
  const ik = indexPathKeyOf(idxIx)
  if ik == "" { return false }
  if mapReadNarrowableSlot(idxIx, fnIx) < 0 { return false }
  pushNarrowIs(ik, variant, condIx)
  true
}

// Retire every live narrowing whose key is a cell of the receiver keyed `root` — the
// emitter twin of `retireNarrowingsForWrite`'s prefix rule. Needed because the checker
// retires and re-types a write's reads at the declared rep, which for a niche cell is one
// `print` renders fine, so the program stays check-clean while the stale emit-side entry traps.
function retireNarrowForIndexCells(root: string) {
  if root == "" { return 0 }
  const pfx = root + "["
  let i = 0
  while i < narrowTop {
    const k = narrowNames[i]
    if k.length > pfx.length {
      if k.slice(0, pfx.length) == pfx { narrowRetired[i] = 1 }
    }
    i = i + 1
  }
  0
}

// True when the index place `xs[0]` carries a live narrowing that excludes `null` — the
// question a niche read asks before recovering non-null. Deliberately not
// `narrowExcludesNull`, which needs an arena type behind the entry (`narrowSlotTy >= 0`); a
// niche push banks a rendered spelling only, so that predicate would answer false for every one of them.
export function indexPlaceNonNull(idxIx: i32) {
  const k = indexPathKeyOf(idxIx)
  if k == "" { return false }
  const v = narrowVariantFor(k)
  if v == "" { return false }
  v != "null"
}

// If the `if` condition at `condIx` is `n is Variant` over a bare union identifier `n`,
// push the narrowing (`narrowNames`/`narrowVariants`) so the then-branch's `n.field` reads
// downcast through the box, and return true; otherwise leave the stack untouched and
// return false. A non-identifier receiver (`f(x) is A`) has no stable name and stays un-narrowed.
export function setNarrowFromCond(condIx0: i32, fnIx: i32) {
  // A parenthesized condition guards identically (`if (x is A)` ≡ `if x is A`), and
  // the checker's narrowing collectors already peel `Paren` — match them here so the
  // emitter narrows every branch the checker proved narrowed. Every matcher below
  // (including the `&&`-conjunct recursion) sees the bare condition shape.
  const condIx = unwrapParen(condIx0)
  const c = P.nodes[condIx]
  // An `is T` test pins a variant rather than stripping `null`, so a consumer that only
  // accepts strips (the loop body — see `narrowStripNullOnly`) skips this whole block.
  if c is IsExpr && !narrowStripNullOnly {
    const recv = P.nodes[c.isObj]
    if recv is Ident {
      if exprUnion(c.isObj, fnIx) {
        pushNarrowIs(recv.identName, c.isVariant, condIx)
        return true
      }
    }
    // `o.y is T` over a UNION-typed struct FIELD narrows the member PATH (the
    // narrowing key is the path string `o.y`; `emitMem` unboxes under it).
    const mrecv = P.nodes[unwrapParen(c.isObj)]
    if mrecv is Member {
      if memberUnionFieldNameRead(unwrapParen(c.isObj), fnIx) != "" {
        const mk = memberPathKeyOf(unwrapParen(c.isObj))
        if mk != "" {
          pushNarrowIs(mk, c.isVariant, condIx)
          return true
        }
      }
    }
    // `xs[0] is T` over a union-box element narrows the index place — the index twin of
    // the member channel above, keyed exactly as the checker's `placeKeyOf` spells it.
    if mrecv is Index {
      const iix = unwrapParen(c.isObj)
      if indexElemUnionName(iix, fnIx) != "" {
        const ik = indexPathKeyOf(iix)
        if ik != "" {
          pushNarrowIs(ik, c.isVariant, condIx)
          return true
        }
      }
      if pushIndexNicheNarrow(iix, fnIx) { return true }
      // …and the map read, the same place one container over (D1025): `placeKeyOf` never
      // distinguished the two receivers, so the checker has always narrowed both.
      if pushIndexMapNarrow(iix, c.isVariant, condIx, fnIx) { return true }
    }
    // `s.kind is KC` — the discriminant: a test on a struct union's field refines the
    // receiver itself, which the member arm above (for a union-typed field) doesn't cover.
    // The surviving type is the checker's (`isParentTyIxOf`), not re-derived. Single
    // survivor only: a test leaving two of three arms pushes nothing and stays loud.
    if pushDiscrimNarrow(unwrapParen(c.isObj), condIx, fnIx, false) {
      return true
    }
    // `x?.y is T` narrows the member path exactly like `x.y is T` — the then-arm only runs
    // when every chain link held and the union field matched, so plain `x.y` reads unbox
    // under the same path key.
    if mrecv is OptMember {
      const omSi = optChainStructIdxOf(mrecv.omObj, fnIx)
      if omSi >= 0 {
        const omFi = sFieldIndex(omSi, mrecv.omProp)
        if omFi >= 0 {
          if sFieldTypeAt(omSi, omFi) == 16 {
            const omRoot = P.nodes[unwrapParen(mrecv.omObj)]
            if omRoot is Ident {
              pushNarrowIs(
                omRoot.identName + "." + mrecv.omProp,
                c.isVariant,
                condIx,
              )
              return true
            }
          }
        }
      }
    }
  }
  // `a && b` composes: the then-branch sees both conjuncts' narrowings (the RHS is checked
  // under the LHS's narrowing). Pushes stack; the caller's save/restore of `narrowTop`
  // unwinds them together.
  if c is BinExpr {
    // `s.kind == "circle"` — the discriminant in the spelling that needs no tag alias
    // declared. Same bank, same push as the `is` arm above.
    if c.binOp == "==" && !narrowStripNullOnly {
      if pushDiscrimNarrow(unwrapParen(c.binLeft), condIx, fnIx, false) {
        return true
      }
      if pushDiscrimNarrow(unwrapParen(c.binRight), condIx, fnIx, false) {
        return true
      }
    }
    if c.binOp == "&&" {
      const nl = setNarrowFromCond(c.binLeft, fnIx)
      const nr = setNarrowFromCond(c.binRight, fnIx)
      return nl || nr
    }
  }
  // `!cond` swaps the branch senses: the then-arm of `if !(x is A) { … }` sees the
  // else-narrowing of the inner condition.
  if c is Unary {
    if c.unOp == "!" {
      return setNarrowFromCondElse(unwrapParen(c.unArg), fnIx)
    }
  }
  // `x == null` / `x != null` over a boxed value union narrows the then-branch: `==` pins
  // `x` to the `null` member; `!=` strips `null` from the current set.
  const nm = valueUnionNullCmpName(condIx, fnIx)
  if nm != "" {
    const cn = P.nodes[condIx]
    if cn is BinExpr {
      if cn.binOp == "==" {
        // Pinning `x` to `null` is not a strip — skipped for a strip-only consumer.
        if narrowStripNullOnly { return false }
        pushNarrow(nm, "null")
        return true
      }
      const nsid = currentNarrowSetIdOf(nm, fnIx)
      if pushNarrowComplement(nm, nsid, "null") != "" { return true }
      const rest = removeAtomFromSet(currentNarrowSetOf(nm, fnIx), "null")
      if rest != "" {
        pushNarrow(nm, rest)
        return true
      }
    }
  }
  // `w.f == null` / `w.f != null` over a boxed-union field narrows the member path — the
  // null-compare twin of the `is` arm's member channel above. Without it the guard's test
  // stays correct but the then-arm's `w.f` read keeps the raw box: `vl check`-clean invalid wasm.
  const mnull = nullCmpRefOf(condIx)
  if mnull >= 0 {
    if P.nodes[mnull] is Member {
      const mfn = memberUnionFieldNameRead(mnull, fnIx)
      if mfn != "" && isValueUnionName(mfn) {
        const mk = memberPathKeyOf(mnull)
        if mk != "" {
          const mcn = P.nodes[condIx]
          if mcn is BinExpr {
            if mcn.binOp == "==" {
              pushNarrow(mk, "null")
              return true
            }
            const mrest = removeAtomFromSet(unionMemberSetOf(mfn), "null")
            if mrest != "" {
              pushNarrow(mk, mrest)
              return true
            }
          }
        }
      }
    }
  }
  // `xs[0] == null` / `xs[0] != null` — the index twin of the member channel above, carrying
  // most of D451's 56 cells. Same key grammar; the member set comes from the element's own
  // declared union, since `currentNarrowSetOf`'s ident fallback can't resolve a path key.
  if mnull >= 0 {
    if P.nodes[mnull] is Index {
      const ifn = indexElemUnionName(mnull, fnIx)
      if ifn != "" && isValueUnionName(ifn) {
        const ik = indexPathKeyOf(mnull)
        if ik != "" {
          const icn = P.nodes[condIx]
          if icn is BinExpr {
            if icn.binOp == "==" {
              // Pinning the cell to `null` is not a strip.
              if narrowStripNullOnly { return false }
              pushNarrow(ik, "null")
              return true
            }
            const irest = removeAtomFromSet(unionMemberSetOf(ifn), "null")
            if irest != "" {
              pushNarrow(ik, irest)
              return true
            }
          }
        }
      }
      // The nullable-ref-array cell (`(i32[][][] | null)[]`) — a niche, so only the `!=`
      // sense narrows anything the reads can use.
      const incn = P.nodes[condIx]
      if incn is BinExpr {
        if incn.binOp == "!=" {
          if pushIndexNicheNarrow(mnull, fnIx) { return true }
        }
      }
    }
  }
  // The same null-compare narrowing over a boxed struct union with a `null` member: `!=`
  // strips `null` (so an inner `is`/else chain subtracts toward one variant), `==` pins it.
  // The 1-struct niche (`S | null`) is excluded — a nullable ref, not a box.
  const snm = structUnionNullCmpName(condIx, fnIx)
  if snm != "" {
    const scn = P.nodes[condIx]
    if scn is BinExpr {
      if scn.binOp == "==" {
        // Pinning `v` to `null` is not a strip — skipped for a strip-only consumer.
        if narrowStripNullOnly { return false }
        pushNarrow(snm, "null")
        return true
      }
      const ssid = currentStructNarrowSetIdOf(snm, fnIx)
      if pushNarrowComplement(snm, ssid, "null") != "" { return true }
      const srest = removeAtomFromSet(
        currentStructNarrowSetOf(snm, fnIx),
        "null",
      )
      if srest != "" {
        pushNarrow(snm, srest)
        return true
      }
    }
  }
  false
}

// The non-null operand of a `x == null` / `x != null` comparison at `condIx` (parens
// peeled, either operand order), or -1 when `condIx` isn't a null compare. The one home
// for that extraction — a grammar question (which side is the literal), not a per-rep
// one, so a rep added to one selector can't get the peel subtly different from its siblings.
function nullCmpRefOf(condIx: i32) {
  const c = P.nodes[condIx]
  if c is BinExpr {
    if c.binOp == "==" || c.binOp == "!=" {
      const lhs = P.nodes[unwrapParen(c.binLeft)]
      const rhs = P.nodes[unwrapParen(c.binRight)]
      if rhs is NullLit { return unwrapParen(c.binLeft) }
      if lhs is NullLit { return unwrapParen(c.binRight) }
    }
  }
  -1
}

// The receiver name when the condition at `condIx` is `<ident> == null` /
// `<ident> != null` over a boxed struct union (2+ struct variants plus a `null`
// member), else "". The value-union and 1-struct-niche forms are excluded (each
// keeps its own narrowing path).
function structUnionNullCmpName(condIx: i32, fnIx: i32) {
  const c = P.nodes[condIx]
  if c is BinExpr {
    if c.binOp == "==" || c.binOp == "!=" {
      const refIx = nullCmpRefOf(condIx)
      if refIx >= 0 {
        const r = P.nodes[refIx]
        if r is Ident {
          const un = unionNameOfIdentSid(sidOfNode(refIx), fnIx)
          if un != "" {
            if !isValueUnionName(un) {
              const uset = unionMemberSetOf(un)
              if unionSetHasNull(uset) && unionSetNonNullCount(uset) >= 2 {
                return r.identName
              }
            }
          }
        }
      }
    }
  }
  ""
}

// The receiver name when the condition at `condIx` is `<ident> == null` /
// `<ident> != null` over a boxed value union, else "". (A struct union / niche
// nullable keeps its existing lowering and narrowing behavior.)
function valueUnionNullCmpName(condIx: i32, fnIx: i32) {
  const c = P.nodes[condIx]
  if c is BinExpr {
    if c.binOp == "==" || c.binOp == "!=" {
      const refIx = nullCmpRefOf(condIx)
      if refIx >= 0 {
        const r = P.nodes[refIx]
        if r is Ident {
          const un = unionNameOfIdentSid(sidOfNode(refIx), fnIx)
          if un != "" {
            if isValueUnionName(un) { return r.identName }
          }
        }
      }
    }
  }
  ""
}

// D1193/D1194 — the spelling to push for the sole survivor of a literal complement, or ""
// when the survivor is one this narrowing cannot name. Two survivor kinds, two renderers: a
// value atom needs its canonical spelling (`tyToEmitName`); a struct arm needs the nominal
// one, and only when registered (`variantIndexOf`). Anything else answers "".
function litElseSurvName(surv: i32): string {
  if unMemAtomKind(surv) >= 0 { return tyToEmitName(surv) }
  const nom = tyToNominalName(surv)
  if nom == "" { return "" }
  if variantIndexOf(nom) < 0 { return "" }
  nom
}

// D1193 — the else complement of a literal `is`, answered from the arena because the
// emitter's member set can't: `x is "err"` over `i32 | "err"` reaches the emitter already
// canon-softened to `i32|string`, so set-subtraction finds no `"err"` member. Removes the
// member whose lexeme is the tested literal, narrows only when exactly one survives (value-atom only).
function litElseNarrow(objIx: i32, variant: string): boolean {
  const ox = unwrapParen(objIx)
  const recv = P.nodes[ox]
  if recv is Ident {
    // The receiver's declared type, un-narrowed — the checker's own resolution of this
    // very node, the only place the literal member still exists. Bound-guarded: an
    // emitter-synthesized node the checker never saw reads -1, not a trap.
    let uty = nodeTyIxOf(ox)
    if uty < 0 { return false }
    // A hole parameter records the hole here, not the union its call-site pin names, so the
    // literal member survives only at the call's own pin (`pinnedHoleTyOf`, D1412).
    const puty = pinnedHoleTyOf(uty)
    if puty >= 0 { uty = puty }
    const ut = T.tys[uty]
    if ut is TyUnion {
      // Exactly two members, which is "exactly one survives" said up front. A wider union
      // minus one literal leaves a set, which the interned-`msSubAtom` path already handles.
      const mems = ut.uMembers
      if mems.length == 2 {
        let surv = -1
        let hit = 0
        let i = 0
        while i < mems.length {
          const lex = tyLitSetMemberLexes(mems[i])
          if lex.length == 1 && lex[0] == variant {
            hit = hit + 1
          } else {
            surv = mems[i]
          }
          i = i + 1
        }
        if hit == 1 && surv >= 0 {
          const nm = litElseSurvName(surv)
          if nm != "" {
            pushNarrowRep(recv.identName, nm, surv, -1)
            return true
          }
        }
      }
    }
  }
  false
}

// The else-branch dual of `setNarrowFromCond`, for value unions only: on a failed guard,
// `is T` strips `T` from the current set (a 2-member union fully discriminates — `string |
// i32` minus `i32` is `string`, which unboxes), `== null` strips `null`, and `!= null`
// pins `null`. Struct unions keep their existing (no else-narrowing) behavior.
export function setNarrowFromCondElse(condIx0: i32, fnIx: i32) {
  // Peel `Paren` exactly like `setNarrowFromCond` — the else-arm of `if (x is A)`
  // complement-narrows the same as the bare spelling.
  const condIx = unwrapParen(condIx0)
  const c = P.nodes[condIx]
  // The else of `x is null` strips null (that is how `!(e is null)` narrows); the else of
  // `x is T` subtracts `T`, which pins a variant. A strip-only consumer keeps the former.
  if c is IsExpr && (c.isVariant == "null" || !narrowStripNullOnly) {
    // Member path checked first, outside the `valueAtomKind` gate: `o.y is T` over a
    // union-typed struct field strips `T` from the path's current set, unboxing the
    // else-arm's `o.y`. A struct variant fails `valueAtomKind` and a `Member` isn't an
    // `Ident`, so this must sit outside both gates or the member path falls between them.
    const mrecv = P.nodes[unwrapParen(c.isObj)]
    // The discriminant complement: `if s.kind is KC {…} else {…}` rules the tested arm out
    // of the else branch too. Scoped narrower than the general struct-union complement
    // below (which derives from a rendered set): this pushes only the checker's banked
    // answer for one condition node.
    if pushDiscrimNarrow(unwrapParen(c.isObj), condIx, fnIx, true) {
      return true
    }
    // The index dual of the member complement below: the else of `xs[0] is T` subtracts
    // `T` from the cell's set, unboxing `match xs[0] { null => … T => … }`'s second arm.
    if mrecv is Index {
      const eiix = unwrapParen(c.isObj)
      const eiun = indexElemUnionName(eiix, fnIx)
      if eiun != "" {
        const eik = indexPathKeyOf(eiix)
        if eik != "" {
          let eicur = ""
          let eisid = -1
          const eislot = narrowSlotOf(eik)
          if eislot >= 0 {
            eicur = narrowVariants[eislot]
            eisid = narrowSets[eislot]
          } else {
            eicur = unionMemberSetOf(eiun)
            eisid = msSetOfText(eicur)
          }
          if pushNarrowComplement(eik, eisid, c.isVariant) != "" { return true }
          const eirst = removeAtomFromSet(eicur, c.isVariant)
          if eirst != "" {
            pushNarrow(eik, eirst)
            return true
          }
        }
      }
      if c.isVariant == "null" {
        if pushIndexNicheNarrow(eiix, fnIx) { return true }
      }
    }
    if mrecv is Member {
      const mun = memberUnionFieldNameRead(unwrapParen(c.isObj), fnIx)
      if mun != "" {
        const mk = memberPathKeyOf(unwrapParen(c.isObj))
        if mk != "" {
          let mcur = ""
          let msid = -1
          // The member PATH's own narrowing stack slot carries both its rendered
          // current set and that set's identity — one walk answers both.
          const mslot = narrowSlotOf(mk)
          if mslot >= 0 {
            mcur = narrowVariants[mslot]
            msid = narrowSets[mslot]
          } else {
            mcur = unionMemberSetOf(mun)
            msid = msSetOfText(mcur)
          }
          if pushNarrowComplement(mk, msid, c.isVariant) != "" { return true }
          const mrest = removeAtomFromSet(mcur, c.isVariant)
          if mrest != "" {
            pushNarrow(mk, mrest)
            return true
          }
        }
      }
    }
    // D1193 — the literal complement, which the atom gate below can't see: `x is "err"`
    // over `i32 | "err"` narrows the else to `i32` in the checker, but `valueAtomKind` and
    // the struct-union complement both miss a quoted lexeme against the softened member set.
    if litElseNarrow(c.isObj, c.isVariant) { return true }
    if valueAtomKind(c.isVariant) >= 0 {
      const recv = P.nodes[unwrapParen(c.isObj)]
      if recv is Ident {
        const un = unionNameOfIdent(recv.identName, fnIx)
        if un != "" {
          if isValueUnionName(un) {
            const esid = currentNarrowSetIdOf(recv.identName, fnIx)
            if pushNarrowComplement(recv.identName, esid, c.isVariant) != "" {
              return true
            }
            const rest = removeAtomFromSet(
              currentNarrowSetOf(recv.identName, fnIx),
              c.isVariant,
            )
            if rest != "" {
              pushNarrow(recv.identName, rest)
              return true
            }
          }
        }
      }
      // A mixed union — struct arm(s) alongside the tested value atom (`{f: i32} | i32`) —
      // isn't a value union, so the Ident arm above skipped it. Falls through to the
      // struct-union complement below: the guard fails, so subtracting the tested atom
      // leaves the struct arm(s), and the else-arm's `v.f` reads through that downcast.
      let elseMixed = false
      if recv is Ident {
        const mxun = unionNameOfIdent(recv.identName, fnIx)
        if mxun != "" {
          if !isValueUnionName(mxun) { elseMixed = true }
        }
      }
      if !elseMixed { return false }
    }
    // Struct-union complement (host flow narrowing): the guard fails, so the tested
    // variant is stripped from the receiver's current set. One member remaining fully
    // discriminates the else-arm; a multi-member rest keeps a later `else if` narrowing
    // further. Only a boxed struct union narrows — a 1-struct niche is a nullable ref.
    const srecv = P.nodes[unwrapParen(c.isObj)]
    if srecv is Ident {
      if exprUnion(c.isObj, fnIx) {
        // The subtracted atom is the resolved spelling, not the author's, agreeing with the
        // three gates that already read it. An inline shape tested against a nominally
        // spelled union would otherwise clear no bit (`msSubAtom` finds no match), silently
        // handing the else arm an unchanged, un-narrowed set while the checker did narrow.
        const sVar = isVariantSpelling(c.isVariant, isVarTyIxOf(condIx))
        const ssid = currentStructNarrowSetIdOf(srecv.identName, fnIx)
        if pushNarrowComplement(srecv.identName, ssid, sVar) != "" {
          return true
        }
        const srest = removeAtomFromSet(
          currentStructNarrowSetOf(srecv.identName, fnIx),
          sVar,
        )
        if srest != "" {
          pushNarrow(srecv.identName, srest)
          return true
        }
      }
    }
    return false
  }
  // `a || b` composes in the else direction, the dual of `setNarrowFromCond`'s `&&`
  // recursion: the else-arm runs only when both disjuncts fail, so it sees both of their
  // else-narrowings. Without it a third disjunct in a chain like `e == null || g() || e >= 0`
  // saw nothing and read the raw box. Pushes stack; the caller unwinds them together.
  if c is BinExpr {
    if c.binOp == "||" {
      const el = setNarrowFromCondElse(c.binLeft, fnIx)
      const er = setNarrowFromCondElse(c.binRight, fnIx)
      return el || er
    }
    // The else arm of `s.kind == "circle"`: the test being false rules out the arms whose
    // tag can only be that literal. Same banked answer, same single-survivor bound as the
    // `is` complement above.
    if c.binOp == "==" && !narrowStripNullOnly {
      if pushDiscrimNarrow(unwrapParen(c.binLeft), condIx, fnIx, true) {
        return true
      }
      if pushDiscrimNarrow(unwrapParen(c.binRight), condIx, fnIx, true) {
        return true
      }
    }
  }
  // `!cond` in the else-arm: the inner condition holds there, so the else sees
  // the inner condition's then-narrowing (`if !(n is Program) {…} else { n.progStmts }`).
  if c is Unary {
    if c.unOp == "!" { return setNarrowFromCond(unwrapParen(c.unArg), fnIx) }
  }
  const nm = valueUnionNullCmpName(condIx, fnIx)
  if nm != "" {
    const cn = P.nodes[condIx]
    if cn is BinExpr {
      if cn.binOp == "!=" {
        // The else of `x != null` pins `null`, not a strip.
        if narrowStripNullOnly { return false }
        pushNarrow(nm, "null")
        return true
      }
      const nsid = currentNarrowSetIdOf(nm, fnIx)
      if pushNarrowComplement(nm, nsid, "null") != "" { return true }
      const rest = removeAtomFromSet(currentNarrowSetOf(nm, fnIx), "null")
      if rest != "" {
        pushNarrow(nm, rest)
        return true
      }
    }
  }
  // The member-path dual of the arm above, and the complement of `setNarrowFromCond`'s own
  // member channel: in the else of `w.f != null` the field is `null`; in the else of
  // `w.f == null` it's the non-null member set, unboxing the else-arm's `w.f` reads.
  const emnull = nullCmpRefOf(condIx)
  if emnull >= 0 {
    if P.nodes[emnull] is Member {
      const emfn = memberUnionFieldName(emnull, fnIx)
      if emfn != "" && isValueUnionName(emfn) {
        const emk = memberPathKeyOf(emnull)
        if emk != "" {
          const emcn = P.nodes[condIx]
          if emcn is BinExpr {
            if emcn.binOp == "!=" {
              pushNarrow(emk, "null")
              return true
            }
            const emrest = removeAtomFromSet(unionMemberSetOf(emfn), "null")
            if emrest != "" {
              pushNarrow(emk, emrest)
              return true
            }
          }
        }
      }
    }
  }
  // The index dual: in the else of `xs[0] != null` the cell is `null`; in the else of
  // `xs[0] == null` it's the non-null member set, unboxing the else-arm's reads.
  if emnull >= 0 {
    if P.nodes[emnull] is Index {
      const eifn = indexElemUnionName(emnull, fnIx)
      if eifn != "" && isValueUnionName(eifn) {
        const eik = indexPathKeyOf(emnull)
        if eik != "" {
          const eicn = P.nodes[condIx]
          if eicn is BinExpr {
            if eicn.binOp == "!=" {
              pushNarrow(eik, "null")
              return true
            }
            const eirest = removeAtomFromSet(unionMemberSetOf(eifn), "null")
            if eirest != "" {
              pushNarrow(eik, eirest)
              return true
            }
          }
        }
      }
      const eincn = P.nodes[condIx]
      if eincn is BinExpr {
        if eincn.binOp == "==" {
          if pushIndexNicheNarrow(emnull, fnIx) { return true }
        }
      }
    }
  }
  // The struct-union dual: in the else of `v != null` the value is `null`; in the
  // else of `v == null` it is the non-null variant set.
  const snm = structUnionNullCmpName(condIx, fnIx)
  if snm != "" {
    const scn = P.nodes[condIx]
    if scn is BinExpr {
      if scn.binOp == "!=" {
        // The else of `v != null` pins `null`, not a strip.
        if narrowStripNullOnly { return false }
        pushNarrow(snm, "null")
        return true
      }
      const ssid = currentStructNarrowSetIdOf(snm, fnIx)
      if pushNarrowComplement(snm, ssid, "null") != "" { return true }
      const srest = removeAtomFromSet(
        currentStructNarrowSetOf(snm, fnIx),
        "null",
      )
      if srest != "" {
        pushNarrow(snm, srest)
        return true
      }
    }
  }
  false
}

// Rewind the narrowing stack depth back to `n` (drop bindings a branch pushed). The
// arrays keep their backing slots — only the logical depth changes, so no `.pop()`.
export function restoreNarrow(n: i32) {
  narrowTop = n
  0
}

// After a guard `if` — one with no else whose then-branch always leaves the path — the
// rest of the block only runs when the guard fails, so it sees the same complement
// narrowing an explicit else-arm would. `break`/`continue` leave the path exactly as
// `return` does and are how a loop-body guard is spelled, so both are checked here too.
export function pushPostGuardNarrow(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if s.ifElse < 0 {
      if blockAlwaysReturns(s.ifThen) || blockLastStmtExits(s.ifThen) {
        setNarrowFromCondElse(s.ifCond, fnIx)
      }
    } else if blockLastStmtExits(s.ifThen) {
      // With an `else`, two things must match the checker exactly: the divergence test is
      // `blockLastStmtExits` alone (not the broader `blockAlwaysReturns`, which once
      // narrowed a block the checker leaves boxed and miscompiled string literals), and
      // only bare names post-narrow, since a path's narrowing overlay retires with the else scope.
      const savedBare = narrowBareIdentOnly
      narrowBareIdentOnly = true
      setNarrowFromCondElse(s.ifCond, fnIx)
      // …and the rest of the chain: an `else if` arm is a guard clause with no block of its
      // own, so reaching the code after the chain means every arm down to the first
      // non-diverging one fails. Complements push stack, walking arm by arm; the walk
      // stops where the checker's own test stops, or the block below reads a box unboxed.
      let chainIx = s.ifElse
      let walking = true
      while walking {
        walking = false
        if chainIx >= 0 {
          const armN = P.nodes[chainIx]
          if armN is IfStmt {
            if blockLastStmtExits(armN.ifThen) {
              setNarrowFromCondElse(armN.ifCond, fnIx)
              chainIx = armN.ifElse
              walking = true
            }
          }
        }
      }
      narrowBareIdentOnly = savedBare
    }
  }
  // Assignment narrowing (the host's `assignmentNarrowing`): a straight-line
  // `x = <non-null expr>` over a null-bearing value union makes `x` provably non-null for
  // the rest of the block, restored at block exit. The same statement also retires any
  // narrowing the write invalidates, so the checker and the emitter agree on the rep.
  if s is BinExpr {
    if s.binOp == "=" {
      const tgt = P.nodes[s.binLeft]
      // Asked once, and only for the two targets that read it: `m[k] = v` / `xs[i] = v`
      // reach neither arm below, so hoisting this above the test would scan every index
      // assignment for an answer nothing asks for.
      const tgtIsPlace = tgt is Ident || tgt is Member || tgt is Index
      const rhsNullable = tgtIsPlace && writeRhsIsNullBearing(s.binRight, fnIx)
      if tgt is Ident {
        const un = unionNameOfIdentSid(sidOfNode(s.binLeft), fnIx)
        // A root rebind kills its cells unconditionally — `writeRetiresNarrowing`'s prefix
        // leg doesn't consult the written type, since a new array says nothing about the
        // old one's cells. Sits outside the `rhsNullable` gate for that reason.
        retireNarrowForIndexCells(tgt.identName)
        if rhsNullable {
          retireNarrowFor(tgt.identName)
        } else if un != "" && isValueUnionName(un) && unionSetHasNull(un) {
          const asid = msSetOfText(un)
          if pushNarrowComplement(tgt.identName, asid, "null") == "" {
            pushNarrow(tgt.identName, removeAtomFromSet(un, "null"))
          }
        }
      }
      // The member target: `w.f = maybeNull()` retires the `w.f` path narrowing exactly as
      // `x = maybeNull()` retires a bare name's, sharing one stack and `retireNarrowFor`.
      // No complement push, unlike the Ident arm: a member path isn't a
      // `narrowBareIdentOnly` name, so `pushNarrowRep` would decline it anyway.
      if tgt is Member {
        if rhsNullable {
          const mtk = memberPathKeyOf(s.binLeft)
          if mtk != "" { retireNarrowFor(mtk) }
        }
      }
      // The index target: a literal subscript names its cell, so only the exact key
      // retires (`indexPathKeyOf` mints no key for a nested receiver, so no prefix leg can
      // catch it). A variable subscript names no cell and may have hit any of them, so it
      // retires the receiver's whole family, matching the checker's `tgtKey == ""` branch.
      if tgt is Index {
        if rhsNullable {
          const itk = indexPathKeyOf(s.binLeft)
          if itk != "" {
            retireNarrowFor(itk)
          } else {
            const iroot = P.nodes[unwrapParen(tgt.idxArr)]
            if iroot is Ident { retireNarrowForIndexCells(iroot.identName) }
            if iroot is Member {
              retireNarrowForIndexCells(memberPathKeyOf(tgt.idxArr))
            }
          }
        }
      }
    }
  }
  0
}

// Is the value written by `rhsIx` null-bearing? Read off the checker's banked node type
// rather than the registered-union member scan, which answers "" for every niche rep
// (`string | null`, a nullable collection) whose guard narrowings need retiring just as
// much. One home because both assignment targets — bare name and member path — ask it.
function writeRhsIsNullBearing(rhsIx: i32, fnIx: i32) {
  const rhs = P.nodes[unwrapParen(rhsIx)]
  if rhs is NullLit { return true }
  if nodeTyIsNullable(unwrapParen(rhsIx)) { return true }
  const rn = unionNameOfExpr(rhsIx, fnIx)
  if rn == "" { return false }
  unionHasAtomAB(14, rn, unionDeclTyIxOfExpr(rhsIx, fnIx), "null")
}

export function forInElemKind(iterIx: i32, fnIx: i32): VKind | null {
  // A narrowed union arm iterates the arm's elements, not the literal's own values: for
  // `type K = string | K[]`, `if c is K[]` narrows to a list of boxes, while the plain
  // classifiers would type the temp as a string list (check-clean invalid wasm, D1015).
  // Keyed off `narrowSlotOf`, not `narrowedValueAtomOf`, which answers "" here regardless.
  const fiN0 = P.nodes[iterIx]
  if fiN0 is Ident {
    const fiSl = narrowSlotOf(fiN0.identName)
    if fiSl >= 0 {
      const fiVa = narrowVariants[fiSl]
      if fiVa != "" {
        if nameIsArray(fiVa) {
          if isUName(arrElemNameRaw(fiVa)) { return "union" }
        }
      }
    }
  }
  const e = P.nodes[iterIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if exprMap(callee.memObj, fnIx) {
        // A map's keys bind at the key's kind: string for the string-keyed rep, i32 for
        // the i32-keyed one. A Set's `.values()` yields its elements, asking the same
        // question — the two `"str"` answers below are the string-keyed half of a pair.
        const kk = mapShapeOfExpr(callee.memObj, fnIx)
        if callee.memProp == "keys" {
          if mapShapeKeyI32(kk) { return "i32" }
          return "str"
        }
        if callee.memProp == "values" {
          if kk == -5 { return "i32" }
          // A set's `.values()` yields its elements — the string keys (kind 3), not the
          // i32 membership booleans. A map's yields its values: i32 for the mono map, the
          // value's kind for a ref-valued map.
          if mapIsSetExpr(callee.memObj, fnIx) { return "str" }
          const vsl = mapShapeOfExpr(callee.memObj, fnIx)
          if vsl >= 0 {
            if mvValKind[vsl] == 3 {
              // A nullable string value (`{[string]: string | null}`) rides the same kind-3
              // vals list as its non-null twin (the element slot is nullable either way), so
              // only the loop var differs: the `string | null` niche, exactly as `const v =
              // m[k]` binds — the non-null `"str"` var would trap on a stored null.
              if mvSlotNullable(vsl) { return "nulstr" }
              return "str" // string value
            }
            if mvValKind[vsl] == 11 {
              return "f64" // f64 value (scalar local)
            }
            if mvValKind[vsl] == 10 {
              return "i64" // i64 value (scalar local)
            }
            if mvValKind[vsl] == 13 {
              return "f32" // f32 value (scalar local)
            }
            if mvValKind[vsl] == 14 {
              return "closure" // closure value (`{[string]: (i32) => i32}` — loop var calls each)
            }
            // A list value (`{[string]: i32[]}` / `S[]` …): the loop var binds the inner
            // value list's own rep (`mvListValKind`), exactly as a nested-array `for row in
            // g` does. A nullable list value rides the same vals list as its non-null twin,
            // so only the loop var differs — the niche kind, mirroring `nulstr`/`nulstruct`.
            if mvValKind[vsl] == 6 {
              if mvSlotNullable(vsl) { return mvNulListValKind(vsl) }
              return mvListValKind(vsl)
            }
            // A union-box value (`{[string]: i32 | null}`, `{[string]: C | S}`): the vals
            // element IS `$uBox`, so the loop var binds as a kind-4 union-box local.
            if mvValKind[vsl] == 2 { return "union" }
            // A nullable-struct value (`{[string]: S | null}`) rides the same kind-1 vals
            // list as its non-null twin; the loop var is the kind-9 niche instead.
            if mvSlotNullable(vsl) { return "nulstruct" }
            // A union-arm value (`{[string]: Circle}` where `Circle` is a declared union
            // member): the loop var is the kind-8 variant local, not struct — the arm's
            // layout lives in `uVarHeap`, since `collectS` skips a union member (D50).
            if mvValVariantOf(vsl) >= 0 { return "variant" }
            return "struct" // struct value
          }
          return "i32"
        }
      }
    }
  }
  // A bare map iterable (`for k in m`) iterates its keys — like `m.keys()`: string for
  // the string-keyed rep (kind 3), i32 for the i32-keyed one.
  if exprMap(iterIx, fnIx) {
    const bk = mapShapeOfExpr(iterIx, fnIx)
    if mapShapeKeyI32(bk) { return "i32" }
    return "str"
  }
  // A `(string | null)[]` — the string-ref niche list. Its backing is a plain string list,
  // but the element slot is nullable, so the loop var binds the nullable string (kind 16),
  // exactly as `const e = xs[i]` does. Checked before `exprStringArray`, which would claim
  // the same backing for a non-null element and trap on a stored null.
  if exprNulStrArray(iterIx, fnIx) { return "nulstr" }
  if exprStringArray(iterIx, fnIx) { return "str" }
  // A struct-element ref list (`S[]`): the element is a struct ref, so bind the loop var
  // as a code-1 struct local. (Union-box (2) / map-array ref lists aren't wired here yet.)
  if exprRefArray(iterIx, fnIx) {
    // Bound-guarded, since `refListSlotOfExpr` doesn't answer -1 on a miss — it clamps to
    // 0, so a miss is indistinguishable from slot 0, and with no ref list interned at all
    // `rlElemKindTbl` is empty: an unguarded read is `wasm trap: out of bounds array
    // access` from inside the compiler, not a diagnostic (D179).
    const rslot = refListSlotOfExpr(iterIx, fnIx)
    if rslot < 0 || rslot >= rlElemKindTbl.length { return null }
    if rlElemKindTbl[rslot] == 1 {
      // A nullable-struct element ref list (`(P | null)[]`): the loop var binds as a
      // kind-9 niche, its read staying nullable (no `ref.as_non_null`); plain `S[]` is kind 1.
      if rlElemIsNulNiche(rslot) { return "nulstruct" }
      // An arm-element ref list (`Circle[]` where `Circle` is a declared union member): the
      // loop var binds as the kind-8 variant local over `uVarHeap[vi]`, since
      // `structIdxOfElemName`'s nominal floor declines an arm (D50).
      if rlElemVariantRow(rslot) >= 0 { return "variant" }
      return "struct"
    }
    // A union-box element ref list (`(C | S)[]`, kind 2): the loop var binds as a kind-4
    // union-box local (the element-kind code IS the loop-var local kind, as struct's `1` is),
    // so `for x in arr { … x is S … }` narrows each element. The `#l` temp is the ref-list
    // wrapper (code 5), same as the struct case.
    if rlElemKindTbl[rslot] == 2 { return "union" }
    // A nested-array element ref list (`i32[][]`/`string[][]`/`f64[][]`/`i64[][]`): the
    // loop var binds the inner list — a list local of kind 2/7/12/20. The element read is
    // a ref (the inner wrapper, recovered non-null); the `#l` temp is the outer wrapper.
    if rlElemKindTbl[rslot] == 4 {
      // A `(i32[] | null)[]` keeps the `| null` in its element slot, so the loop var is
      // the kind-15 nullable list — the same rep `exprNullableList`'s kind-4 arm binds.
      if rlElemIsNulNiche(rslot) { return "nullist" }
      return "list"
    }
    // The four distinct-backing inner lists (`string[][]` 6 / `f64[][]` 7 / `i64[][]` 8 /
    // `f32[][]` 10). A `(T[] | null)[]` element keeps `| null` in its slot exactly as the
    // kind-4 niche above, so the loop var is the matching nullable-list kind.
    if rlElemKindTbl[rslot] == 6 {
      if rlElemIsNulNiche(rslot) { return "nulstrlist" }
      return "strlist"
    }
    if rlElemKindTbl[rslot] == 7 {
      if rlElemIsNulNiche(rslot) { return "nulf64list" }
      return "f64list"
    }
    if rlElemKindTbl[rslot] == 8 {
      if rlElemIsNulNiche(rslot) { return "nuli64list" }
      return "i64list"
    }
    if rlElemKindTbl[rslot] == 10 {
      if rlElemIsNulNiche(rslot) { return "nulf32list" }
      return "f32list" // f32-inner list -> an f32-list local (kind 21)
    }
    if rlElemKindTbl[rslot] == 11 {
      if rlElemIsNulNiche(rslot) { return "nulu8list" }
      return "u8list" // u8-inner list -> a packed-byte-list local
    }
    // A closure-element ref list (`((i32) => i32)[]`, element kind 5): the loop var binds
    // as a kind-14 closure local — `for f in fs { … f(x) … }` calls each via `call_ref`.
    // The element read recovers the closure ref non-null (like a struct); the `#l` temp is
    // the ref-list wrapper (code 5).
    if rlElemKindTbl[rslot] == 5 { return "closure" }
    // A nested ref array (`S[][]`/`(C|D)[][]`/`S[][][]`, element kind 9): the loop var
    // binds the inner ref list — a kind-5 ref-list local carrying the inner slot,
    // recursing (the inner slot may itself be kind 9). A `(S[] | null)[]` element is the
    // kind-18 nullable ref list, the same niche rule.
    if rlElemKindTbl[rslot] == 9 {
      if rlElemIsNulNiche(rslot) { return "nulreflist" }
      return "reflist"
    }
    return null
  }
  // An f64 element list (`f64[]`): the loop var binds as a scalar f64 local (code 11), and
  // the `#l` temp is the f64-list (code 12), recognized through `exprF64Array` so an
  // `f64[]`-returning call iterates too. An f32 element list (`f32[]`) binds a scalar f32
  // local (code 13). Both checked before the i32 default.
  if exprF32Array(iterIx, fnIx) { return "f32" }
  if exprF64Array(iterIx, fnIx) { return "f64" }
  // An i64 element list (`i64[]`): the loop var binds as a scalar i64 local (code 10), and
  // the `#l` temp is the i64-list (code 20).
  if exprI64Array(iterIx, fnIx) { return "i64" }
  // A packed byte list (`u8[]`): each element reads as an i32 (`array.get_u` zero-
  // extends), so the loop var is the plain i32 code — the one-byte storage lives entirely
  // in the `#l` temp (`forInU8Src`). Asked explicitly rather than left to the i32 default,
  // since `exprArray` claims a `u8[]` in only some storage classes.
  if exprU8Array(iterIx, fnIx) { return "i32" }
  // A STRING iterable (`for ch in s`): each code unit is an i32 (loop-var code 0, same as an
  // `i32[]`), but the source is the RAW i32 array — the `#l` temp is the string itself (code 3),
  // and the length/element reads skip the list-wrapper `struct.get`. `forInStringSrc` flags it
  // at the temp-kind and emit sites. Checked before `exprArray` (a string is not an i32 list).
  if exprString(iterIx, fnIx) { return "i32" }
  if exprArray(iterIx, fnIx) { return "i32" }
  return null
}

// Whether a `for v in <iter>` iterable is a STRING (`for ch in s`) — the i32-code-unit walk over
// the raw array, distinct from an `i32[]` (code 0 too) whose backing hides behind a list wrapper.
export function forInStringSrc(iterIx: i32, fnIx: i32) {
  if forInElemKind(iterIx, fnIx) != "i32" { return false }
  exprString(iterIx, fnIx)
}

// Whether a `for v in <iter>` iterable is the packed byte list (`u8[]`) — the i32-element
// walk over its own `$bl8` wrapper, distinct from an `i32[]` (element kind `"i32"` too,
// four bytes wide). The `forInStringSrc` twin: the element kind can't tell the two apart,
// so agreement lives in the `#l` temp's own wrapper (#1814 repro A).
export function forInU8Src(iterIx: i32, fnIx: i32) {
  if forInElemKind(iterIx, fnIx) != "i32" { return false }
  exprU8Array(iterIx, fnIx)
}

// True when a `for v in <iter>` walks a map's ordered vals list (field 1) rather than its
// keys list (field 0) — a `.values()` call on a map that isn't a set (a set's `.values()`
// yields its elements, in the keys list instead). Paired with `forInMapRecv`, so the field
// a walk reads and the type its loop var binds can never disagree.
export function forInMapWalksVals(iterIx: i32, fnIx: i32) {
  const e = P.nodes[iterIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) {
          return !mapIsSetExpr(callee.memObj, fnIx)
        }
      }
    }
  }
  false
}

// The mv slot of a `for v in m.values()` walk over a ref-valued map, or -1 (not a
// map walk / a mono map / a set). The values walk then types its loop var + list
// temp off the slot's value type instead of a ref-array's element.
export function forInMapValsSlot(iterIx: i32, fnIx: i32) {
  if !forInMapWalksVals(iterIx, fnIx) { return -1 }
  // A MONO-value map interns no slot — its shape is one of the negative sentinels
  // (`-1` mono, `-4` i32-keyed mono), and every one of them answers "no slot" here.
  const sl = mapShapeOfExpr(forInMapRecv(iterIx, fnIx), fnIx)
  if sl < 0 { return -1 }
  sl
}

// The element struct table index of a `for v in <S[]>` iterable (the struct that the
// code-1 loop var binds), or -1 when the iterable is not a struct ref list. Mirrors
// the index-read resolution (`structIndexOfExpr` over `xs[i]`): the element name comes
// from the ref-list slot, then its struct table index.
export function forInRefArrayStructIdx(iterIx: i32, fnIx: i32) {
  const mvs = forInMapValsSlot(iterIx, fnIx)
  if mvs >= 0 {
    // An ARM-valued map's `.values()` walk has no STRUCT row to bind (D34) — the loop var's
    // layout lives in the variant table, and this resolver's contract is a struct index. It
    // declines rather than handing back a row from the other namespace.
    if mvValVariantOf(mvs) >= 0 { return -1 }
    if mvValKind[mvs] == 1 { return mvValStructIdxOf(mvs) }
    return -1
  }
  if !exprRefArray(iterIx, fnIx) { return -1 }
  // Strip a `| null` niche suffix (`(P | null)[]` → "P") so the nullable-struct loop var
  // carries P's struct index.
  structIdxOfElemName(refListElemNameOfExpr(iterIx, fnIx))
}

// The variant row of the same loop var — `forInRefArrayStructIdx`'s storage-class twin,
// built arm for arm against it (D50): an arm-valued map's `.values()` walk (the row the
// struct half declines) and an arm-element ref list (the row `structIdxOfElemName`'s
// nominal floor declines, via `rlElemVariantRow`). Both halves already existed as declines.
export function forInRefArrayVariantIdx(iterIx: i32, fnIx: i32) {
  const mvs = forInMapValsSlot(iterIx, fnIx)
  if mvs >= 0 { return mvValVariantOf(mvs) }
  if !exprRefArray(iterIx, fnIx) { return -1 }
  rlElemVariantRow(refListSlotOfExpr(iterIx, fnIx))
}

// The companion table slot of a `for-in` loop variable's cell — paired with `addLocalName`
// the same way `declareForInLocals` does (lifted out of it, D1142, since a captured loop
// var needs the same pair for its closure env field). -1 for every kind needing no slot —
// the scalars, the leaf scalar lists, `str`/`nulstr`/`list`/`u8list`/`union`/`closure`.
export function forInVarStructIdx(iterIx: i32, fnIx: i32): i32 {
  const ek = forInElemKind(iterIx, fnIx)
  if ek == null { return -1 }
  if ek == "struct" || ek == "nulstruct" {
    return forInRefArrayStructIdx(iterIx, fnIx)
  }
  if ek == "variant" { return forInRefArrayVariantIdx(iterIx, fnIx) }
  if ek == "reflist" || ek == "nulreflist" {
    // A nested ref array (`S[][]`): the loop var is the inner ref list, off the outer
    // list's element slot.
    return rlElemInnerSlot(refListSlotOfExpr(iterIx, fnIx))
  }
  -1
}

// True if the map-typed expression at `exprIx` is a set (`Set()`-seeded binding or
// the constructor itself). Consulted by the `.values()` paths: a set's `.values()`
// yields its elements (the keys list), not the membership booleans in `vals` —
// mirroring the checker (`typecheck.vl`: a set's values() returns `mKey[]`).
function mapIsSetExpr(exprIx: i32, fnIx: i32) {
  mapShapeOfExpr(exprIx, fnIx) == -2
}

// The value-atom kind a numeric literal union reps as inside the union box — `1 | 2` → 0
// (i32), `1.5 | 2.5` → 4 (f64) — or -1 otherwise. A numeric litunion is not the `-1`
// sentinel `K | null` uses: its rep is the number itself (#1866), so no bit pattern is
// spare, and `{[string]: N}` needs the same conditional box every no-spare scalar needs (D6).
function numLitUnionBoxKind(ty: i32): i32 {
  if ty < 0 { return -1 }
  const bn = numLitUnionBaseName(ty)
  if bn == "i32" { return 0 }
  if bn == "i64" { return 3 }
  if bn == "f64" { return 4 }
  -1
}

// `numLitUnionBoxKind` asked of a map READ expression, from the recorded types alone — the
// one place the numeric-litunion rule is applied, so the two twins below cannot drift.
function mapReadNumLitBoxKind(exprIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(exprIx)]
  if !(e is Index) { return -1 }
  const rt = nodeTyIxOf(e.idxArr)
  if rt < 0 { return -1 }
  const r = T.tys[rt]
  if !(r is TyMap) { return -1 }
  numLitUnionBoxKind(r.mVal)
}

// The arena-only twin of `mapReadScalarBoxKind` below: same question, answered from the
// recorded types alone so it can run in passes with no enclosing function. A twin rather
// than a default argument: `mapReadScalarBoxKind` resolves its receiver through the
// function's locals, so a missing `fnIx` would silently answer "not a map read" everywhere.
export function mapReadScalarBoxKindTy(exprIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(exprIx)]
  if !(e is Index) { return -1 }
  const rt = nodeTyIxOf(e.idxArr)
  if rt < 0 { return -1 }
  const r = T.tys[rt]
  if !(r is TyMap) { return -1 }
  const v = r.mVal
  if v < 0 { return -1 }
  // Every niche-bearing value carries its own "absent" and must keep today's lowering.
  if tyIsLitUnion(v) { return -1 }
  // The numeric litunion has no niche (see `numLitUnionBoxKind` above): it takes the box,
  // at its base scalar's atom, asked before `tyScalarBaseIs` since the two questions differ.
  const nlk = numLitUnionBoxKind(v)
  if nlk >= 0 { return nlk }
  if numLitUnionHasBase(v) { return -1 }
  if tyScalarBaseIs(v, "boolean") { return -1 }
  if tyScalarBaseIs(v, "i32") { return 0 }
  if tyScalarBaseIs(v, "i64") { return 3 }
  if tyScalarBaseIs(v, "f64") { return 4 }
  if tyScalarBaseIs(v, "f32") { return 5 }
  -1
}

// The value-atom kind (`valueAtomKind`'s code) of a bare scalar-valued map read `m[k]` /
// `m.get(k)`, or -1 otherwise. A map read's type is `V | null`, but a scalar value has no
// spare bit to mean absent, so `emitMapGet`'s miss yields a real value (e.g. `0`) that the
// union-coerce ladder then boxes as present. Covers i32, i64, f64, f32, and the numeric litunion.
export function mapReadScalarBoxKind(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(exprIx)]
  if !(e is Index) { return -1 }
  if !exprMap(e.idxArr, fnIx) { return -1 }
  // A numeric literal union value is decided first, since neither test below can see it:
  // it reps as its base scalar (#1866), so it interns an ordinary mv slot and the
  // litunion exclusions further down are string-only by construction.
  const nlk = mapReadNumLitBoxKind(exprIx)
  if nlk >= 0 { return nlk }
  if nodeTyMapValIsNumLitUnion(e.idxArr) { return -1 }
  const sl = mapShapeOfExpr(e.idxArr, fnIx)
  if sl >= 0 {
    if mvValKind[sl] == 10 {
      return 3 // i64
    }
    if mvValKind[sl] == 11 {
      return 4 // f64
    }
    if mvValKind[sl] == 13 {
      return 5 // f32
    }
    return -1
  }
  // The mono map (no mv slot). Only PLAIN i32 lands here without a niche of its own.
  const rv = e.idxArr
  if nodeTyMapValIsNulLitUnion(rv) || nodeTyMapValIsLitUnion(rv) { return -1 }
  if nodeTyMapValIsNulBool(rv) || nodeTyMapValIsBool(rv) { return -1 }
  0 // i32
}

// The mv slot a map READ expression resolves to: `m[k]` (Index over a ref-valued map) or
// `m.get(k)` (the method form), else -1. The chokepoint the expression-kind resolvers
// (`exprString` / struct resolution / `??` lowering) consult so a ref-valued `m[k] ?? d`
// classifies as its value type.
function mapReadMvSlot(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Index {
    if exprMap(e.idxArr, fnIx) {
      const sl = mapShapeOfExpr(e.idxArr, fnIx)
      if sl >= 0 { return sl }
      return -1
    }
    // Narrowing-blind fallback: `t0[k]` where `t0` is a union ident with a map arm. In the
    // frame pre-pass the `is`-narrow that would make `t0` a map isn't active, so `exprMap`
    // misses — resolve the arm's value mv slot directly.
    const ax = P.nodes[unwrapParen(e.idxArr)]
    if ax is Ident {
      // …but blind is not the same as wrong: when an `is` narrow is active and says the
      // receiver is the union's array arm, `exprMap` missing above is correct, not a
      // pre-pass artefact — claiming the map arm anyway would reach a receiver that isn't
      // one (D1012).
      const d12v = narrowVariantFor(ax.identName)
      if nameIsArray(d12v) { return -1 }
      // …and the same for a `string` narrow (D1033): `k[0]` over `k` narrowed to the
      // union's string arm is a char read, not a map read (the index yields an i32) — and
      // claiming the map arm skipped the argument boundary's box.
      if d12v == "string" { return -1 }
      const aun = unionNameOfIdent(ax.identName, fnIx)
      if aun != "" {
        // The arm's arena type comes back with its spelling: the value slot resolves off
        // the `TyMap` the member scan already read, rather than re-slicing `V` from the render.
        const armTy: i32[] = []
        const ma = unionMapArmNameTy(aun, armTy)
        if ma != "" {
          let maVt = -1
          if armTy.length > 0 { maVt = tyMapValOf(armTy[0]) }
          const msl = mvSlotOfMapNameTy(ma, maVt)
          if msl >= 0 { return msl }
        }
      }
    }
    return -1
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "get" {
        if exprMap(callee.memObj, fnIx) {
          const sl = mapShapeOfExpr(callee.memObj, fnIx)
          if sl >= 0 { return sl }
        }
      }
    }
  }
  -1
}

// The mv slot of a `lhs ?? d` read-with-default over a ref-valued map, else -1. Parens are
// peeled on both the whole expression and the LHS so `(m[k]) ?? d` classifies identically
// to the bare form — must agree with the `??` emit, which also peels parens, else a
// parenthesized string/f64/struct map-get keeps its real type but routes as i32.
function coalesceMvSlot(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" { return mapReadMvSlot(unwrapParen(e.binLeft), fnIx) }
  }
  -1
}

// True when a `m[k] ?? d` read over a nullable-value map (slot `cns`) stays nullable — i.e.
// the default `d` is itself nullable (a bare `null`, or a nullable-typed default). `??`
// coalesces on the read value being null, so a non-null default collapses the read to the
// value's non-null kind; only a nullable default leaves it `V | null`.
export function coalesceStaysNullable(exprIx: i32, cns: i32, _fnIx: i32) {
  if cns < 0 { return false }
  if !mvSlotNullable(cns) { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" {
      const d = P.nodes[unwrapParen(e.binRight)]
      if d is NullLit { return true }
      return nodeTyIsNullable(e.binRight)
    }
  }
  false
}

// The one nullability decision for the non-map `??` reps (the value-union box and the
// nullable-struct niche): `??` coalesces on the LHS being null, so a non-null default
// collapses to the non-null rep while a nullable default leaves `T | null`. Structural in
// the chain, never banked, since a re-associated `p ?? q ?? r` mints an untyped inner node.
export function coalesceDefaultNullable(defIx: i32, fnIx: i32): boolean {
  if defIx < 0 { return false }
  const dix = unwrapParen(defIx)
  const d = P.nodes[dix]
  if d is NullLit { return true }
  if d is BinExpr {
    if d.binOp == "??" { return coalesceDefaultNullable(d.binRight, fnIx) }
  }
  if nodeTyIsNullable(dix) { return true }
  const un = unionNameOfExpr(dix, fnIx)
  if un != "" { return unionSetHasNull(un) }
  false
}

// The LHS place of a non-map `??`, or -1 when `exprIx` isn't a `??` — the consumer-side
// hook of every nullable-niche `??` arm, the counterpart of `coalesceMvSlot` for the fused
// map-get spellings. `p ?? d` carries the LHS's rep in both halves, so the rep question and
// the nullable-half question (`coalesceDefaultNullable`) come from two separate homes.
function coalesceNicheLhs(exprIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" { return e.binLeft }
  }
  -1
}

// The HALF a non-map `??` result lands in — `true` the NULLABLE half, `false` the non-null one
// (and `false` for a node that is not a `??`, which no caller asks). `coalesceDefaultNullable`
// stays THE nullability decision; this is only its `??`-node accessor, so a consumer classifier
// reaches the default without re-deriving its arena index beside `coalesceNicheLhs`.
function coalesceNicheStaysNullable(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" { return coalesceDefaultNullable(e.binRight, fnIx) }
  }
  false
}

// True when the default of a `K | null` `??` reps as that niche's own i32 — a bare `null`,
// an atom place/field/call, another `K | null`, a member literal, or a chain (structural,
// never banked). A member literal is decided by lexeme membership (`litLexIsMember`),
// since a default-position literal carries the join's type, not a `TyLit`.
function coalesceLitUnionDefaultIsAtom(defIx: i32, texts: string[], fnIx: i32) {
  if defIx < 0 { return false }
  const dix = unwrapParen(defIx)
  const d = P.nodes[dix]
  if d is NullLit { return true }
  if d is StrLit { return litLexIsMember(d.strText, texts) }
  if d is BinExpr {
    if d.binOp == "??" {
      if !coalesceLitUnionDefaultIsAtom(d.binLeft, texts, fnIx) { return false }
      return coalesceLitUnionDefaultIsAtom(d.binRight, texts, fnIx)
    }
  }
  exprIsLitAtom(dix, fnIx)
}

// True when the `??` at `exprIx` lowers as the `K | null` atom niche: its LHS is that
// niche and its default reps as the same i32. The default decides whether the rep
// survives at all, not just its nullability — a non-atom default (joining to `string`)
// declines here and keeps the loud reject instead of check-clean invalid wasm.
export function coalesceLitUnionFits(exprIx: i32, fnIx: i32) {
  const lhs = coalesceNicheLhs(exprIx)
  if lhs < 0 { return false }
  if !exprNulLitUnion(lhs, fnIx) { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    // The niche's member set: its nullable spelling first, then the bare one for an LHS whose
    // banked type the narrow already collapsed.
    let lut = nodeNulLitUnionMemberTexts(lhs)
    if lut.length == 0 { lut = nodeLitUnionMemberTexts(lhs) }
    return coalesceLitUnionDefaultIsAtom(e.binRight, lut, fnIx)
  }
  false
}

// The list-element rep (2/7/12/20 — see `mvListValKind`) of a bare `m[k]` or `m[k] ?? d`
// read over a list-valued map, else -1. The single classifier hook each `expr*Array` uses to
// claim a list-valued-map read of its own element type.
function mapReadListKind(exprIx: i32, fnIx: i32): VKind | null {
  const cm = coalesceMvSlot(exprIx, fnIx)
  if cm >= 0 { return mvListValKind(cm) }
  return mvListValKind(mapReadMvSlot(exprIx, fnIx))
}

// The map receiver arena index of a `for v in m.keys()` / `m.values()` iterable, or -1
// when the iterable is not a map keys/values walk. Drives the tombstone-aware skip in
// the for-in loop (the map's `live` array is consulted per entry).
export function forInMapRecv(iterIx: i32, fnIx: i32) {
  const e = P.nodes[iterIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "keys" || callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) { return callee.memObj }
      }
    }
  }
  // A bare map iterable (`for k in m`) is its own receiver — the live-skip walks it.
  if exprMap(iterIx, fnIx) { return iterIx }
  -1
}

export function fnRetNullBearing(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return false }
  const r = fn.fnRet
  if tyIsNulBool(r) { return true }
  if retNulStringFlag(r) == 1 { return true }
  if retNulRefFlag(r) == 1 { return true }
  if retNulListFlag(r) == 1 { return true }
  if retNulMapFlag(r) == 1 { return true }
  // The arena, not the render's `|`-split: `nodeTyBearsNull` covers both shapes
  // `retUnionFlag` admits (a `TyUnion` with a `null` member and a `TyNullable` scalar).
  if retUnionFlag(r) == 1 { return nodeTyBearsNull(r) }
  if r < 0 {
    const im = inferRetNameOf(fn.fnName)
    if isValueUnionName(im) {
      // The arena, reached through the inferred-return table's own type column
      // (`inferRetTyIxOf`), rather than splitting a rendered member set on `|`. The
      // fallback below is unreachable and kept only as a total-function guard:
      // `isValueUnionName(im)` being true already proves `inferRetTyIxOf` resolves.
      return inferRetBearsNull(fn.fnName)
    }
    if inferNicheNullByName(fn.fnName) != "" { return true }
  }
  false
}

// D1240 — a member call the checker typed non-void, which the emitter can deliver as a
// value. One predicate for three consumers that must agree: `computeVoidFns`,
// `emitFuncBody`/`emitStmtTail` (the tail is the result), and `emitCallStmt`'s discard.
// Reads the checker's type at every method, not a by-name exclusion list (D1301, D1592).
export function memberCallYieldsValue(stmtIx: i32) {
  const s = P.nodes[stmtIx]
  if s is Call {
    const callee = P.nodes[s.callFn]
    if callee is Member { return tyPrimNameOf(nodeTyIxOf(stmtIx)) != "void" }
  }
  false
}

// True if the statement at `stmtIx` is a bare value expression usable as an implicit
// return — no `return` keyword needed. Recognized: literals, an identifier, a unary, a
// non-assignment `BinExpr`, a paren, a member/index access, an `is` guard, an
// object/array literal, and a value-returning call — not a void member-call or `.push`.
export function stmtIsTailValue(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  // A bare lambda tail `(a) => (b) => …` is an implicit-return VALUE (a closure), so the
  // outer arrow's body — `(b) => …` — emits as the function's result. Without this the tail
  // is mis-read as a statement, the body emits nothing, and the function is just `unreachable`.
  if s is FuncDecl { return true }
  if s is NumLit { return true }
  // A trailing `null` is an implicit-return value (the function returns null) — seeded
  // per the return type by `emitReturnValue`, the same as `return null`.
  if s is NullLit { return true }
  if s is StrLit { return true }
  if s is CharLit { return true }
  if s is BoolLit { return true }
  if s is Ident { return true }
  if s is Unary { return true }
  if s is Paren { return true }
  if s is Member { return true }
  if s is Index { return true }
  if s is IsExpr { return true }
  if s is AsExpr { return true }
  if s is ObjLit { return true }
  if s is ArrayLit { return true }
  if s is BinExpr {
    if s.binOp == "=" {
      // A trailing assignment over an ident target is a tail value — assignment yields
      // its right side (DECISIONS: assignment-as-expression). An index/member target stays a statement.
      const tgt = P.nodes[s.binLeft]
      if tgt is Ident { return true }
      return false
    }
    return true
  }
  if s is Call {
    // A value-returning call `f(..)` is a tail value; a `recv.push(x)` member-call,
    // a `print(...)`, and a call to a VOID function (`fRetVoid`) are statements.
    const callee = P.nodes[s.callFn]
    if callee is Ident {
      if callee.identName == "print" { return false }
      // The void memory/array intrinsics (`__store_*__`, the bulk pair, `__log__`,
      // `__array_copy__`, `__trap__`) are statements: classifying one as the body's value
      // would emit a function promising a result it never produces.
      if callee.identName == "__store_i32__" { return false }
      if nameIsMemStoreIntrinsic(callee.identName) { return false }
      if nameIsMemBulkIntrinsic(callee.identName) { return false }
      if callee.identName == "__log__" { return false }
      if callee.identName == "__array_copy__" { return false }
      if callee.identName == "__trap__" { return false }
      const target = fnIndexOf(callee.identName)
      // A live closure binding of the name is what the tail denotes, so the voidness is
      // that closure's and the module function of the name settles nothing (D1602).
      if target >= 0 && !identIsBoundClosure(callee.identName, fnIx) {
        return fRetVoid[target] == 0
      }
      // A closure-value callee (invisible to `fnIndexOf`): a void one yields nothing, so
      // it's a statement tail, letting `run(g: () => void) { g() }` infer void.
      if fnIx >= 0 && calleeReturnsVoidSid(sidOfNode(s.callFn), fnIx) {
        return false
      }
      return true
    }
    // D980 — a closure-field call in tail position is a value: without this arm,
    // `function p(x: {f: () => string}): string { x.f() }` lowered its tail as a
    // statement and trapped. Narrow on purpose: widening to every non-void member call
    // would wrongly claim `xs.push(1)` as a value inside a void function.
    if callee is Member {
      if fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx) >= 0 {
        return true
      }
    }
    return false
  }
  false
}

// True if the BLOCK at `blockIx` ends in a bare tail VALUE statement (an implicit
// return), as opposed to an explicit `return`/`while`/etc. — i.e. lowering it in tail
// position would need `emitStmtTail`. A nested `if`/`else` tail recurses (any arm).
export function blockTailIsValue(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return false }
    const last = stmts[n - 1]
    const s = P.nodes[last]
    if s is IfStmt { return ifTailIsValue(last, fnIx) }
    return stmtIsTailValue(last, fnIx)
  }
  false
}

// D1029/D1032/D1034 — is the nullable inference's non-voidness real? `inferRetBearsNull`
// exists for an else-less tail `if c { 5 }`, whose fall-through is the `null`. Three other
// tail shapes (an empty arm, a bare-return guard, an index-target assignment) are not
// values at all, so the veto applies only where the tail `if`'s arms end in values.
export function tailIfNullableIsReal(blockIx: i32, fnIx: i32): boolean {
  const b = P.nodes[blockIx]
  if b is Block {
    const n = b.blkStmts.length
    if n == 0 { return true }
    const s = P.nodes[b.blkStmts[n - 1]]
    if s is IfStmt { return ifArmsAllValues(b.blkStmts[n - 1], fnIx) }
  }
  true
}

// Every arm of the `if`/`else if` chain at `stmtIx` ends in a bare tail VALUE. An EMPTY arm
// answers false (nothing to be a value), and so does an arm whose tail is a statement.
function ifArmsAllValues(stmtIx: i32, fnIx: i32): boolean {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if !blockTailIsValue(s.ifThen, fnIx) { return false }
    if s.ifElse < 0 { return true }
    const e = P.nodes[s.ifElse]
    if e is Block { return blockTailIsValue(s.ifElse, fnIx) }
    if e is IfStmt { return ifArmsAllValues(s.ifElse, fnIx) }
  }
  false
}

// True if the arm at `blockIx` is a BLOCK with no statements — the shape that has no tail to
// give a value, and therefore no value for `emitIfTail` to place. A non-Block arm (an
// `else if` chain) is never "empty" in this sense and answers false.
function ifTailArmIsEmpty(blockIx: i32): boolean {
  if blockIx < 0 { return false }
  const ab = P.nodes[blockIx]
  if ab is Block { return ab.blkStmts.length == 0 }
  false
}

// True if the `if`/`else` at `stmtIx` (in tail position) has any arm that ends in a bare value
// expression rather than an explicit `return` — so it must be lowered via `emitIfTail`. An
// `if` WITHOUT an `else` can fall through with no value, so it never qualifies (the existing
// void-if path handles it). Recurses through `else if` chains.
function ifTailIsValue(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    // An else-less `if` never qualifies here (it can fall through with no value) — load-
    // bearing for the `fRetVoid` fixpoint, which must not treat a void recursive tail
    // `if n>0 { rec(n-1) }` as a value. The nullable-return case is handled separately by
    // `elseLessNullableTail` at emit time.
    if s.ifElse < 0 { return false }
    // D1034 — an empty arm disqualifies the whole `if`: this asks "does any arm end in a
    // bare value", so `if c { } else { buf.push(1) }` (one value arm, one empty) would
    // otherwise be wrongly classified non-void. Not "every arm must be a value" — an
    // explicit `return x` arm is not a bare tail value.
    if ifTailArmIsEmpty(s.ifThen) { return false }
    if ifTailArmIsEmpty(s.ifElse) { return false }
    if blockTailIsValue(s.ifThen, fnIx) { return true }
    const els = P.nodes[s.ifElse]
    if els is Block { return blockTailIsValue(s.ifElse, fnIx) }
    return ifTailIsValue(s.ifElse, fnIx)
  }
  false
}

// True if the statement at `stmtIx` is a body-tail `if`/`else` whose arms yield a
// value (implicit return) and so must be lowered tail-aware by `emitIfTail`.
export function lastStmtIsValueIf(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt { return ifTailIsValue(stmtIx, fnIx) }
  false
}

// True if the body-tail statement at `stmtIx` is an else-less `if` whose then-arm yields
// a value and function `fnIx` returns a nullable type — so the false fall-through is the
// `null` of that nullable, lowered by the function-end `emitNullForRet`. Consulted only at
// emit time (where `fRetVoid` is final), so it never perturbs that fixpoint.
export function elseLessNullableTail(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if s.ifElse >= 0 { return false }
    if !blockTailIsValue(s.ifThen, fnIx) { return false }
    return fnRetNullBearing(fnIx)
  }
  false
}

// True if the function's top-level body block at `blockIx` ends in an instruction the
// wasm validator treats as making the fallthrough unreachable — an explicit `return` or a
// bare tail value. Otherwise control falls through to `end` with an empty stack, so an
// explicit `unreachable` pads it — sound because the typechecker proved that path dead.
export function bodyEndsInReturn(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return false }
    const last = stmts[n - 1]
    const s = P.nodes[last]
    if s is RetStmt { return true }
    return stmtIsTailValue(last, fnIx)
  }
  false
}

// How many value-producing exits one return value contributes. An if-expression
// (`return if c { a } else { b }`) lowers as a void statement-`if` whose arms each
// terminate as their own return, so it contributes one exit per arm — what makes such a
// function eligible for the sink at all. Every other expression is a single exit.
function retValueExitCount(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const bare = P.nodes[unwrapParen(exprIx)]
  if bare is IfStmt {
    return retArmExitCount(bare.ifThen, fnIx) +
      retArmExitCount(bare.ifElse, fnIx)
  }
  1
}

// One arm of a returned if-EXPRESSION: an `else if` chain link is another if-expression,
// a block's single tail value recurses (a NESTED if-expression contributes its own arms),
// and anything else is one exit.
function retArmExitCount(armIx: i32, fnIx: i32) {
  if armIx < 0 { return 0 }
  const a = P.nodes[armIx]
  if a is IfStmt { return retValueExitCount(armIx, fnIx) }
  if a is Block {
    const av = ifArmValueExpr(armIx)
    if av >= 0 { return retValueExitCount(av, fnIx) }
  }
  1
}

// How many value-producing exits the statement at `stmtIx` contributes, counting an
// explicit `return` and a tail value the same way `emitFuncBody`/`emitStmtTail` do.
// Recurses into structured statements, never a nested `FuncDecl`. A prediction only, used
// to size the return-sink's local reservation — it may over- or under-count harmlessly.
function retExitCount(stmtIx: i32, fnIx: i32) {
  if stmtIx < 0 { return 0 }
  const s = P.nodes[stmtIx]
  if s is FuncDecl { return 0 }
  if s is RetStmt { return retValueExitCount(s.retArg, fnIx) }
  if s is Block {
    const stmts = s.blkStmts
    let n = 0
    let i = 0
    while i < stmts.length {
      const isLast = i == stmts.length - 1
      if isLast && stmtIsTailValue(stmts[i], fnIx) {
        n = n + retValueExitCount(stmts[i], fnIx)
      } else {
        n = n + retExitCount(stmts[i], fnIx)
      }
      i = i + 1
    }
    return n
  }
  if s is IfStmt {
    return retExitCount(s.ifThen, fnIx) + retExitCount(s.ifElse, fnIx)
  }
  if s is WhileStmt { return retExitCount(s.whileBody, fnIx) }
  if s is ForRange { return retExitCount(s.frBody, fnIx) }
  if s is ForIn { return retExitCount(s.fiBody, fnIx) }
  0
}

// True when function `fnIx` should reserve the union-box return-sink frame: its result
// rep is the shared union box and it has at least two value-producing exits (a single-exit
// function already has the one construction site the sink would build). The box test must
// agree with `emitReturnValue`'s own `retUNm` ladder, or the frame is reserved for nothing.
export function fnUnionRetSinkOk(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    let isBox = false
    if retUnionFlag(fn.fnRet) == 1 {
      if (
        !nodeTyIsLitUnionAlias(fn.fnRet) &&
        !nodeTyIsNulLitUnion(fn.fnRet) &&
        nulCloFlag(fn.fnRet) != 1
      ) {
        isBox = true
      }
    }
    if fn.fnRet < 0 {
      const im = inferRetNameOf(fn.fnName)
      if isValueUnionName(im) || isUNameAB(15, im, inferRetTyIxOf(fn.fnName)) {
        isBox = true
      }
    }
    if !isBox { return false }
    return retExitCount(fn.fnBody, fnIx) >= 2
  }
  false
}

// Is some collected declared local named `name` the union box rep (kind 4)? The binding
// sink's prediction asks this rather than re-deriving the slot cursor: `buildLocals` has
// already run, so a shadowed name that answers for the wrong slot only mis-predicts,
// costing two unused locals, never a wrong sink (the lowering reads `localIsRef[slot]` directly).
function localNameIsUnionSlot(name: string) {
  let i = 0
  while i < localNames.length {
    if localNames[i] == name {
      if localIsRef[i] == "union" { return true }
    }
    i = i + 1
  }
  false
}

// Does the statement at `stmtIx` hold a `let`/`const` of the union BOX rep whose init is
// an if-EXPRESSION — the shape the binding sink rewrites? Deliberately does NOT descend
// into a nested `FuncDecl`, whose locals belong to its own lifted wasm function.
function blockHasUnionLetIf(stmtIx: i32) {
  if stmtIx < 0 { return false }
  const s = P.nodes[stmtIx]
  if s is FuncDecl { return false }
  if s is LetDecl {
    if exprIsIfStmt(s.letInit) { return localNameIsUnionSlot(s.letName) }
    return false
  }
  if s is Block {
    const stmts = s.blkStmts
    let i = 0
    while i < stmts.length {
      if blockHasUnionLetIf(stmts[i]) { return true }
      i = i + 1
    }
    return false
  }
  if s is IfStmt {
    if blockHasUnionLetIf(s.ifThen) { return true }
    return blockHasUnionLetIf(s.ifElse)
  }
  if s is WhileStmt { return blockHasUnionLetIf(s.whileBody) }
  if s is ForRange { return blockHasUnionLetIf(s.frBody) }
  if s is ForIn { return blockHasUnionLetIf(s.fiBody) }
  false
}

// True when function `fnIx` should reserve the union-box sink pair for a binding: it holds
// a union-box `let`/`const` initialized by an if-expression, so an arm's box can be sunk
// past the merge. A prediction only (`unionIfBindingAllBox` decides at lowering time
// whether the rewrite fires); over-firing costs two unused locals, under-firing declines a sink.
export function fnUnionLetSinkOk(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl { return blockHasUnionLetIf(fn.fnBody) }
  false
}

// The per-function mv frame base for mv slot `slot` (valid when `fnUsesMap`).
export function fnMvMapRefLocal(slot: i32) { fnMvBase + slot * 3 }

export function fnMvValsBkLocal(slot: i32) { fnMvBase + slot * 3 + 1 }

export function fnMvValStashLocal(slot: i32) { fnMvBase + slot * 3 + 2 }

// The `m.values()` per-mv-slot OUTPUT backing local for mv slot `slot`.
export function fnMvValsOutLocal(slot: i32) { mvValsOutBase + slot }

// The result list REP-kind of a `m.values()` call — `2` i32-list, `7` string-list, `12`
// f64-list, `20` i64-list, `5` ref-list (struct / nested-list / nested-map values) — or -1
// if `exprIx` is not a `.values()` over a map. The result element type IS the map's value
// type, so each `expr*Array` classifier compares against its own rep.
function mapValuesResultKind(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) {
          const sh = mapShapeOfExpr(callee.memObj, fnIx)
          if sh == -1 {
            return 2 // mono i32 map → i32 list
          }
          if sh == -2 {
            return 7 // a Set's values() ARE its string keys
          }
          if sh == -4 || sh == -5 {
            // The i32-keyed rep: a map's values are the mono i32 list, and a Set's
            // values ARE its i32 keys — the same i32 list either way.
            return 2
          }
          if sh >= 0 {
            const vk = mvValKind[sh]
            if vk == 3 {
              return 7 // string-valued → string list
            }
            if vk == 11 {
              return 12 // f64-valued → f64 list
            }
            if vk == 10 {
              return 20 // i64-valued → i64 list
            }
            return 5 // struct / nested-list / nested-map → ref list
          }
        }
      }
    }
  }
  -1
}

// The `fnStmts` position of the `FuncDecl` at arena index `fnIx`, or -1. Most calls ask
// about the function `emitCodeSection` is currently lowering, whose position
// `emitCurFnPos` carries as the caller's own input (not a memo — it's written as one pair
// with `emitCurFnIx` from the loop), so the scan below is only the fallback.
export function fnStmtsPosOf(fnIx: i32) {
  if fnIx >= 0 && fnIx == emitCurFnIx { return emitCurFnPos }
  let i = 0
  while i < fnStmts.length {
    if fnStmts[i] == fnIx { return i }
    i = i + 1
  }
  // A monomorphized slot replaced in place (a count-0 instance overwrote `fnStmts[fe]`), so
  // the scan above can't find the original node — a lambda literal a binding still points
  // at. `monoOrigNode[fe]` still records it as the fallback.
  let j = 0
  while j < monoOrigNode.length {
    if monoOrigNode[j] == fnIx { return j }
    j = j + 1
  }
  -1
}

// True if `name` is a single inline struct shape spanning the whole string (`{f: i32}`) —
// its first `{`'s matching `}` is the last char, and it isn't a map spelling (`{[`). The
// brace-only alphabet is safe against `<`/`>` but not a quoted literal member
// (`{v: "a}b"}` closes the group early), so `tyGroupWrapsWhole` is quote-aware instead.
export function nameIsWholeSpanShape(name: string) {
  // The endpoint span alone (`nameIsShapeSpanEnds`) is a wider test that a composite
  // union name like `{a:{b:i32}}|{c:i32}` also passes; the walk here is strictly tighter.
  if !nameIsShapeSpanEnds(name) { return false }
  tyGroupWrapsWhole(name)
}

// Does some struct row carry exactly this `TyObj`'s field-name set? A shallow,
// terminating structural test for "this field is a struct" — no code comparison, so a
// recursive shape (`type Node = {next: Node | null}`) cannot loop. Ignoring field types is
// sound here: this decides only the code (15, "a nested struct"), never which row.
function tyHasStructRowShallow(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyObj {
    const fnames = t.objFieldNames
    if fnames.length == 0 { return false }
    const lim = sScanLim()
    let si = 0
    while si < lim {
      if sFieldStart[si] + sFieldCount[si] <= sFieldElemName.length {
        if sFieldCount[si] == fnames.length {
          let ok = true
          let k = 0
          while k < fnames.length {
            if sFieldIndex(si, fnames[k]) < 0 { ok = false }
            k = k + 1
          }
          if ok { return true }
        }
      }
      si = si + 1
    }
  }
  false
}

// `fieldCodeOfTy` for the matcher only (D-MATCHCODE): `fieldCodeOfTy` serves two
// consumers — the matcher below, which only compares a code, and `nameFieldCodeTy`, which
// feeds the path that records `sFieldTypes`. Code 15 is a two-part answer (code plus an
// element name), so widening it there would leave `refSlot` unresolved; widening only here doesn't.
function fieldCodeForMatch(ty: i32): i32 {
  const c = fieldCodeOfTy(ty)
  if c != -2 { return c }
  if ty < 0 { return -2 }
  const t = T.tys[ty]
  if t is TyObj {
    if isStructOfTy(ty) { return 15 }
    if tyHasStructRowShallow(ty) { return 15 }
  }
  if t is TyNullable {
    if isStructOfTy(t.nInner) { return 15 }
    if tyHasStructRowShallow(t.nInner) { return 15 }
  }
  // A map-typed field is code 19, gated identically to the spelling ladder
  // (`mvValLowersTy`): a map whose value the classifier can't lower keeps failing loudly.
  if t is TyMap {
    if mvValLowersTy(t.mVal) == 1 { return 19 }
  }
  -2
}

// The variant twin of `structRowOfObjFieldSet` below, and specifically of
// `variantIndexOfTypeName`'s field-set arm — not of `variantRowOfTy`, which matches on
// arena-index identity (two variants sharing a field set are still different variants).
// Asks the same field-set question of the type instead of a spelling, first match wins.
function variantRowOfObjFieldSet(ty: i32): i32 {
  variantRowOfObjFieldSetK(ty, false)
}

// The leniency-levelled form (D733), the variant half of `structRowOfObjFieldSetK`.
// `widen` applies `objFieldCodeWidens` in place of code equality. First-match is kept on
// the widened pass here (unlike the struct twin, which demands uniqueness) because the
// variant side already has one first-match authority (`objVariantName`) this can only agree with or decline.
function variantRowOfObjFieldSetK(ty: i32, widen: boolean): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyObj {
    const fnames = t.objFieldNames
    const ftys = t.objFieldTypes
    let vi = 0
    while vi < uVariants.length {
      if uFieldStart[vi] + uFieldCount[vi] > uFieldElemName.length {
        vi = vi + 1
        continue
      }
      if uFieldCount[vi] == fnames.length {
        let ok = true
        let k = 0
        while k < fnames.length {
          const fj = variantFieldIndex(vi, fnames[k])
          if fj < 0 {
            ok = false
          } else {
            const want = fieldCodeForMatch(ftys[k])
            if want >= 0 {
              if widen {
                if (
                  !variantFieldCodeWidens(
                    want,
                    variantFieldTypeAt(vi, fj),
                    vi,
                    fj,
                  )
                ) {
                  ok = false
                }
              } else if want != variantFieldTypeAt(vi, fj) {
                ok = false
              }
            } else {
              // The same leniency-with-one-tightening the struct matcher carries: uncoded
              // fields are lenient, except a code-15 nested row checked by canonical rep.
              if variantFieldTypeAt(vi, fj) == 15 {
                const rowElem = variantFieldElemName(vi, fj)
                if rowElem != "" {
                  const cq = repCanonId(ftys[k])
                  const cr = repNameCanonId(rowElem)
                  if cq >= 0 {
                    if cr >= 0 {
                      if cq != cr { ok = false }
                    }
                  }
                }
              }
            }
          }
          k = k + 1
        }
        if ok { return vi }
      }
      vi = vi + 1
    }
  }
  -1
}

// The declaration-identity name of an arena type — `shapeNominalOfTy`'s two arena rungs,
// lifted out so other nominal questions can ask them without the two field-set scans that
// follow there. Both rungs answer by declaration identity, never a guess. "" for an
// anonymous shape — the two field-set rungs are deliberately not here (D33).
function declNominalOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const si = structIndexOfTy(ty)
  if si >= 0 { return sNames[si] }
  const av = variantRowOfTy(ty)
  if av >= 0 { return uVariants[av] }
  ""
}

// `emit_rep.fieldCodeRefsElemHeap`, private to its own module and needed here for the
// same reason: 15 a nested struct, 5 a ref list, 28 its `| null` niche — field codes whose
// storage is a `(ref [null] <heap>)` the code alone doesn't name, so two rows can
// field-set match, code-match and canon-match while still emitting different layouts.
function fieldCodeRefsElemHeapC(code: i32): boolean {
  code == 15 || code == 5 || code == 28
}

// That field's ELEMENT, asked of the QUERY side's arena type: a ref list peels its
// `TyArray`, the `| null` niche peels the nullable first, and a nested struct IS its own
// element. -1 for every other code and for a type that does not have the peeled shape.
function fieldElemTyOfQueryTy(ty: i32, code: i32): i32 {
  if ty < 0 { return -1 }
  if code == 15 { return ty }
  let base = ty
  if code == 28 {
    const n = T.tys[ty]
    if n is TyNullable { base = n.nInner } else { return -1 }
  }
  if base < 0 { return -1 }
  const b = T.tys[base]
  if b is TyArray { return b.aElem }
  -1
}

// Are the query field's element and struct row `si` field `fj`'s recorded element proven
// to be different declarations? Nominal on both sides and refutation-only: an unresolvable
// side is never a conflict. Nominal, not canon, is the point — `Circle` (a union arm) and
// its exact layout twin `Dot` share one canon key but are two declarations (DECISIONS.md).
function fieldElemDeclConflict(qElemTy: i32, si: i32, fj: i32): boolean {
  const qn = declNominalOfTy(qElemTy)
  if qn == "" { return false }
  let rn = declNominalOfTy(sFieldElemTyIxAt(si, fj))
  if rn == "" { rn = sFieldElemNameAt(si, fj) }
  if rn == "" { return false }
  qn != rn
}

// Does struct row `si` carry a PROVEN element-declaration conflict against the query
// object type's fields, on any of the named-heap field codes?
function rowElemDeclConflicts(si: i32, fnames: string[], ftys: i32[]): boolean {
  let k = 0
  while k < fnames.length {
    const fj = sFieldIndex(si, fnames[k])
    if fj >= 0 {
      const code = sFieldTypeAt(si, fj)
      if fieldCodeRefsElemHeapC(code) {
        if fieldElemDeclConflict(fieldElemTyOfQueryTy(ftys[k], code), si, fj) {
          return true
        }
      }
    }
    k = k + 1
  }
  false
}

// The declared-row widenings `anonValueFitsField` grants an object literal's field value,
// asked of a recorded field type instead of a value node. The two sides must agree:
// `structIndexOfObj` accepts a widening building the row, so the shape resolver must
// accept the same widening naming it, or a container's element type resolves to no row at all.
function fieldCodeWidensElem(qc: i32, rc: i32, elem: string): boolean {
  if qc == rc { return true }
  // A union-BOX field takes any member — `anonValueFitsField`'s own first line, and the
  // pairing D461 added to the NAME side of this same question.
  if rc == 16 { return true }
  if qc == 0 {
    // An i32/boolean/litunion-atom value widens into wider numeric slots and the `K | null`
    // atom niche — not the `boolean | null` niche (21), which needs a boolean literal, a
    // distinction the code has erased and a type can't recover; not the map slots either.
    if rc == 23 { return true }
    if rc == 24 { return true }
    if rc == 30 { return true }
    return false
  }
  if qc == 3 {
    // A string value: the `string | null` ref niche, the `K | null` atom niche, and a
    // literal-union atom slot (records its union name in the element column).
    if rc == 20 { return true }
    if rc == 30 { return true }
    if rc == 0 { return elem != "" }
    return false
  }
  false
}

// `fieldCodeWidensElem` against a STRUCT row's field.
function objFieldCodeWidens(qc: i32, rc: i32, si: i32, fj: i32): boolean {
  fieldCodeWidensElem(qc, rc, sFieldElemNameAt(si, fj))
}

// `fieldCodeWidensElem` against a VARIANT row's field — the same relation read out of the
// other table, so the two field-set scans cannot drift on what a widening is.
function variantFieldCodeWidens(qc: i32, rc: i32, vi: i32, fj: i32): boolean {
  fieldCodeWidensElem(qc, rc, variantFieldElemName(vi, fj))
}

// `structIndexOfTypeName`'s arena twin — the struct row whose field set matches the
// `TyObj` `ty`, or -1 (D-FIELDSETOFTY). Asks the fields directly instead of rendering and
// re-parsing the type, with the same scan order and half-built-row guard as the name path:
// a declining field fails the row rather than matching loosely.
export function structRowOfObjFieldSet(ty: i32): i32 {
  const strict = structRowOfObjFieldSetK(ty, false)
  if strict >= 0 { return strict }
  structRowOfObjFieldSetK(ty, true)
}

// The row scan `structRowOfObjFieldSet` runs, at one leniency (D733). Split out of that
// function verbatim so the two passes cannot drift; `widen` is threaded to the per-field
// code test and adds the unique-claimant requirement, and changes nothing else.
function structRowOfObjFieldSetK(ty: i32, widen: boolean): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyObj {
    const fnames = t.objFieldNames
    const ftys = t.objFieldTypes
    const lim = sScanLim()
    let first = -1
    let firstExact = -1
    let nMatch = 0
    let si = 0
    while si < lim {
      if sFieldStart[si] + sFieldCount[si] > sFieldElemName.length {
        si = si + 1
        continue
      }
      if sFieldCount[si] == fnames.length {
        let ok = true
        let k = 0
        while k < fnames.length {
          const fj = sFieldIndex(si, fnames[k])
          if fj < 0 {
            ok = false
          } else {
            const want = fieldCodeForMatch(ftys[k])
            if want >= 0 {
              if widen {
                if !objFieldCodeWidens(want, sFieldTypeAt(si, fj), si, fj) {
                  ok = false
                }
              } else if want != sFieldTypeAt(si, fj) {
                ok = false
              }
            } else {
              // An uncoded field is lenient, matching the render path's `shapeFieldTypeCompat`
              // (refutes only proven mismatches), with its one tightening: a code-15 nested-
              // struct field is checked by canonical rep, so two arms sharing a field-name set
              // but differing in nested layout cannot collide onto the wrong variant (B190).
              if sFieldTypeAt(si, fj) == 15 {
                const rowElem = sFieldElemNameAt(si, fj)
                if rowElem != "" {
                  const cq = repCanonId(ftys[k])
                  const cr = repNameCanonId(rowElem)
                  if cq >= 0 {
                    if cr >= 0 {
                      if cq != cr { ok = false }
                    }
                  }
                }
              }
            }
          }
          k = k + 1
        }
        if ok {
          // The element-declaration preference (D94): a named-heap field's code is not its
          // layout, so two rows agreeing on field set, code and canon key (`{xs: Circle[]}`
          // vs `{xs: Dot[]}`) still need the query's own element declaration to pick the
          // right one. A preference, not a refutation: a conflicting row is only outranked.
          if first < 0 { first = si }
          nMatch = nMatch + 1
          if firstExact < 0 {
            if !rowElemDeclConflicts(si, fnames, ftys) { firstExact = si }
          }
        }
      }
      si = si + 1
    }
    // The unique-claimant gate on the widened pass: first-match is safe on the strict pass
    // (agreeing on every field code makes two rows layout twins), but a widened match isn't
    // — two claimants means two different layouts with no evidence which one is the real build.
    if widen {
      if nMatch != 1 { return -1 }
    }
    if firstExact >= 0 { return firstExact }
    return first
  }
  -1
}

// The struct table index a type NAME names: a declared struct name directly, or an INLINE
// object-shape name (`{x:i32,y:i32}`) matched by field-name SET against the interned shapes
// (the anonymous literals interned the same sets). -1 if neither.
export function structIndexOfTypeName(name: string) {
  const si = structIndexByName(name)
  if si >= 0 { return si }
  // Only a single shape spanning the whole name is a bare struct — a composite (`{…}|null`,
  // `{…}|{…}`, `{…}[]`) is not, so a nullable-struct name must not mis-match its leading shape.
  if nameIsWholeSpanShape(name) {
    // Collect the top-level field names + type texts (`shapeFieldParse`), then match by
    // field-name set tightened with a field-type layout guard (`shapeFieldTypeCompat`):
    // two shapes sharing field names but differing in a field's type must not collide.
    const fnames: string[] = []
    const ftypes: string[] = []
    shapeFieldParse(name, fnames, ftypes)
    // Two passes: the strict pass is the scan every caller has always run; only a render
    // that placed nowhere reaches the second, box-lenient pass (D461). A third pass (D733)
    // handles the name side of literal widenings that both field-set resolvers refuse,
    // requiring a unique claimant since two widened rows are two layouts.
    const strictSi = shapeRowScanK(fnames, ftypes, 0)
    if strictSi >= 0 { return strictSi }
    const boxSi = shapeRowScanK(fnames, ftypes, 1)
    if boxSi >= 0 { return boxSi }
    return shapeRowScanK(fnames, ftypes, 2)
  }
  -1
}

// The row scan `structIndexOfTypeName` runs, at one leniency (D461, widened D733). Split
// out verbatim so the passes cannot drift; `lenient` threads to `shapeFieldTypeCompatK`
// and changes nothing else. `0` strict (every caller's default), `1` the union-box
// leniency, `2` plus the literal widenings, which alone needs a unique claimant.
function shapeRowScanK(fnames: string[], ftypes: string[], lenient: i32): i32 {
  let uniq = -1
  let nHit = 0
  let si2 = 0
  const sLimB = sScanLim()
  while si2 < sLimB {
    // Skip a struct whose per-field rows aren't fully appended yet: `internInlineShape`
    // pushes the header before populating its field rows one at a time, and a code-5
    // ref-list field's element-name computation can re-enter this scanner mid-loop.
    // Reading a not-yet-pushed trailing field is an out-of-bounds compiler crash.
    if sFieldStart[si2] + sFieldCount[si2] > sFieldElemName.length {
      si2 = si2 + 1
      continue
    }
    if sFieldCount[si2] == fnames.length {
      let ok = true
      let k = 0
      while k < fnames.length {
        const fj = sFieldIndex(si2, fnames[k])
        if fj < 0 {
          ok = false
        } else if (
          !shapeFieldTypeCompatK(
            ftypes[k],
            sFieldTypeAt(si2, fj),
            sFieldElemNameAt(si2, fj),
            lenient,
          )
        ) {
          ok = false
        }
        k = k + 1
      }
      if ok {
        if lenient < 2 { return si2 }
        if uniq < 0 { uniq = si2 }
        nHit = nHit + 1
      }
    }
    si2 = si2 + 1
  }
  if lenient >= 2 {
    if nHit == 1 { return uniq }
  }
  -1
}

// Parse a canonical inline shape name `{a:T,b:U}` into parallel field-name / field-type
// string lists. A non-`{…}` name appends nothing. Shared by the variant/struct field-set
// resolvers so a field-name match can be tightened with a field-type check. A part with no
// `:` keeps the whole part as the field name.
function shapeFieldParse(name: string, outNames: string[], outTypes: string[]) {
  if nameIsShapeOpen(name) {
    const flat = nameStripSpaces(name)
    const parts: string[] = []
    // The group-interior cut (`groupInnerOf`) runs on the despaced name, so a hypothetical
    // `"{ "` reaches here as `flat == "{"` — `.slice` clamps, so the answer stays "".
    tyTopLevelSplit(groupInnerOf(flat), ',', false, parts)
    let k = 0
    while k < parts.length {
      const part = parts[k]
      const ci = part.indexOf(":")
      if ci < 0 {
        outNames.push(part)
        outTypes.push("")
      } else {
        // The field-colon cut (`fieldNameOf`/`fieldTypeTextOf`). The `ci < 0` guard above
        // keeps the whole part as the field name, unlike siblings that gate `ci <= 0`.
        outNames.push(fieldNameOf(part, ci))
        outTypes.push(fieldTypeTextOf(part, ci))
      }
      k = k + 1
    }
  }
}

// True if two map value type-names denote the same map rep — the code-19 tightening the
// field-set matchers apply, since every map field shares code 19 regardless of value type.
// Lenient when either side is unclassifiable or a checker render collapses a litunion
// alias to `string`; otherwise kinds must agree and slot-bearing values share their canonical rep.
function mvValNamesCompat(va: string, ve: string): boolean {
  const ka = mvValKindOfName(va)
  const ke = mvValKindOfName(ve)
  if ka == -3 || ke == -3 { return true }
  if ka != ke {
    if ka == 3 && ke == -1 && nameIsLitUnionType(ve) { return true }
    if ke == 3 && ka == -1 && nameIsLitUnionType(va) { return true }
    return false
  }
  const sa = mvSlotOfMapValNameOrMono(va)
  const se = mvSlotOfMapValNameOrMono(ve)
  if sa >= 0 && se >= 0 { return mvCanonRepOf(sa) == mvCanonRepOf(se) }
  true
}

// True if a shape field TYPE-string `t` (from `shapeFieldParse`) is compatible with the
// emitter field CODE `code` — i.e. not a proven mismatch (both codes known and unequal).
// When the type-string can't be classified the check stays lenient (never a false reject
// of a real twin). A map field (code 19) is additionally tightened by its value rep.
function shapeFieldTypeCompat(t: string, code: i32, elem: string): boolean {
  shapeFieldTypeCompatK(t, code, elem, 0)
}

// The leniency-levelled form (D461, widened D733). `0` is every caller's default, the
// only one `variantIndexOfTypeName` asks for; `1` is `structIndexOfTypeName`'s second pass
// (the union box), `2` its third (the literal widenings), each run only for a render no
// earlier pass could place.
function shapeFieldTypeCompatK(
  t: string,
  code: i32,
  elem: string,
  lenient: i32,
): boolean {
  const want = nameFieldCode(t)
  if want < 0 || code < 0 {
    // A nested-struct candidate field (code 15) whose spelled type can't classify is
    // almost always an inline nested shape — tighten by canonical structural key so two
    // arms sharing a field-name set but differing in nested layout don't collide.
    if code == 15 && elem != "" {
      const tb = nonNulBaseOf(t)
      return nestedStructNamesCompat(tb, elem)
    }
    // No refutation arm here: every caller reaching this point is already routed through
    // an arena resolver that separates nested-alias twins by their full nested type.
    return true
  }
  if want != code {
    // A literal union has two reps, so `K` against a code-3 row is not a proven mismatch
    // either (D1460): a discriminant can lay out as the string while canon still renders
    // the arm's field as its declared alias (code 0).
    if want == 0 && code == 3 {
      if nameIsLitUnionType(t) { return true }
    }
    // The union-box field accepts every atom — the name resolver's half of the leniency
    // `anonValueFitsField` already applies node-side (D461): both answer which struct row a
    // `{r: 7}` literal builds. Second-pass only: applied on the strict pass it would let a
    // box row declared first win every single-field render ahead of the exact one.
    if lenient >= 1 && code == 16 { return true }
    // The literal widenings (D733), level 2 only — the name side of `objFieldCodeWidens`:
    // a render `{r:i32}` denotes `{r:i64}`/`{r:K}` for the same reason the literal built there.
    if lenient >= 2 {
      if want == 0 {
        if code == 23 { return true }
        if code == 24 { return true }
        if code == 30 { return true }
        // D902 — and the `boolean | null` niche (21), which the code can't decide but the
        // spelling can: only the literal text `boolean` widens into the niche, since that
        // distinction is exactly what code 0 erased.
        if code == 21 { return t == "boolean" }
      }
      if want == 3 {
        if code == 20 { return true }
        if code == 30 { return true }
        if code == 0 { return elem != "" }
      }
    }
    // The ambiguous nullable-closure render: a code-22 field renders ungrouped
    // (`()=>i64|null`), which `nameFieldCode` reads as a top-level arrow (14) — the grouped
    // and ungrouped spellings render identically, so stay lenient when the result is nullable.
    if code == 22 && want == 14 {
      // The return cut (`fnRetTextOf`) takes a wider `aa >= 0` gate than other routed
      // sites', since `.slice` clamps rather than traps at `aa == 0`.
      const aa = annArrowAt(t)
      if aa >= 0 && nullablePartOf(fnRetTextOf(t, aa)) != "" { return true }
    }
    return false
  }
  if want == 0 {
    // Atom-identity tightening (code 0 is layout-shared between plain i32/boolean and
    // litunion-atom slots): a `{f: K0}` spelling must not adopt a plain row (a member
    // literal would emit as a string into an i32 slot), and a plain spelling must not
    // adopt an atom row (ids read back as booleans). Both sides decidable, proven-mismatch only.
    if nameIsLitUnionType(t) != nameIsLitUnionType(elem) { return false }
    return true
  }
  if want == 4 {
    // The atom-array sibling: `{f: K0[]}` (i32 list of member ids) vs a plain
    // `{f: i32[]}`/`{f: boolean[]}` — the same shared-layout split as code 0.
    if nameIsLitUnionArray(t) != nameIsLitUnionArray(elem) { return false }
    return true
  }
  if want == 19 && elem != "" { return mvValNamesCompat(mapValNameOf(t), elem) }
  if want == 15 && elem != "" {
    // A declared-name nested-struct field (`inner: Inner`) against the variant's
    // recorded target: the same canonical-key tightening as the inline spelling.
    const tb15 = nonNulBaseOf(t)
    return nestedStructNamesCompat(tb15, elem)
  }
  true
}

// True unless the two nested-struct type spellings `ta` / `elem` are proven to denote
// distinct structures: both resolve through the checker's canonical structural key
// (`repNameCanonId`) and the keys differ. Either side unresolvable (-1) stays lenient —
// never a false reject of a twin the canon layer doesn't cover.
function nestedStructNamesCompat(ta: string, elem: string): boolean {
  if ta == elem { return true }
  const ka = repNameCanonId(ta)
  if ka < 0 { return true }
  const ke = repNameCanonId(elem)
  if ke < 0 { return true }
  ka == ke
}

// The arm whose own canonical render is `name` (D762) — strictly tighter than
// `variantIndexOfTypeName` below, which is a lenient field-set match so an adopted
// literal's render can reach the arm the adoption already chose. This asks whether canon,
// rendering the arm itself, would produce exactly this string — the container-element question.
export function variantIndexOfOwnRender(name: string): i32 {
  if !nameIsShapeOpen(name) { return -1 }
  let vi = 0
  while vi < uVariants.length {
    if vi < uVarTyIx.length && uVarTyIx[vi] >= 0 {
      if tyToEmitName(uVarTyIx[vi]) == name { return vi }
    }
    vi = vi + 1
  }
  -1
}

// The union-VARIANT table index whose field-set matches a `{meow: i32}` SHAPE name (a collapsed
// `.map` callback return the checker rendered structurally) — the variant analogue of
// `structIndexOfTypeName`. -1 if no variant matches. A NAME that is already a variant alias
// resolves directly. Field-name parsing mirrors `structIndexOfTypeName`.
function variantIndexOfTypeName(name: string) {
  const direct = variantIndexOf(name)
  if direct >= 0 { return direct }
  if nameIsShapeOpen(name) {
    const fnames: string[] = []
    const ftypes: string[] = []
    shapeFieldParse(name, fnames, ftypes)
    let vi = 0
    while vi < uVariants.length {
      if uFieldCount[vi] == fnames.length {
        let ok = true
        let k = 0
        while k < fnames.length {
          const fj = variantFieldIndex(vi, fnames[k])
          if fj < 0 {
            ok = false
          } else if (
            !shapeFieldTypeCompat(
              ftypes[k],
              variantFieldTypeAt(vi, fj),
              variantFieldElemName(vi, fj),
            )
          ) {
            // A shared field NAME but a mismatched field TYPE — a distinct shape that
            // merely collides on names (a closure returning `{a:i32,f:i64,z:f64}` is NOT
            // the union arm `{a:boolean,f:()=>…,z:i32}`). Not this variant.
            ok = false
          }
          k = k + 1
        }
        if ok { return vi }
      }
      vi = vi + 1
    }
  }
  -1
}

// The union-variant index a lifted callback `fe` returns when it collapses to a single
// variant (`(a) => if a is Cat { a } else { catShape }`), read from the checker's recorded
// node-keyed return shape, or -1. Lets `.map`/`.filter` classify the result as the variant
// ref list, rather than widening the narrowed receiver back to the box.
export function cbRetVariantIdx(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const nm = inferRetNameByNode(fnStmts[fe])
  // The nominal arm on the name, the structural arm on the arena: `variantIndexOfTypeName`
  // runs both, but only the direct name match asks whether this IS a declared variant —
  // identity the arena can't recover (B208). The arena arm is stricter, refusing a
  // field-set collision `shapeFieldTypeCompat` would let through (avoided by the `fRetKind` guard below).
  let vi = variantIndexOf(nm)
  if vi < 0 { vi = variantRowOfObjFieldSet(inferRetTyIxByNode(fnStmts[fe])) }
  if vi < 0 { return -1 }
  // A lambda whose inferred return the checker classified as a plain struct must not
  // collapse to a variant merely because its anonymous shape coincides with an unrelated
  // sibling field's union arm: its `$fnsig` result must key the struct token, not the
  // variant one. A direct nominal variant name is always a genuine collapse and passes through.
  if fe < fRetKind.length {
    if variantIndexOf(nm) < 0 {
      const k = fRetKind[fe]
      if (k == "struct" || k == "nulstruct") && fRetStructIdx[fe] >= 0 {
        return -1
      }
    }
  }
  vi
}

// The return-type name of a function-value callee `name` (in scope of `fnIx`): the return
// part of its source function-type annotation — a closure-typed param, local/global
// binding, or a union arm narrowed to a bare closure. "" when `name` isn't a resolvable
// closure value or its annotation isn't a `(…) => R` arrow.
export function calleeCloRetName(name: string, fnIx: i32) {
  let ft = ""
  // A union binding narrowed to a bare-closure arm carries the arm's `(…) => R` name.
  const nc = narrowedClosureOf(name)
  if nc != "" {
    ft = nc
  } else if fnIx >= 0 {
    // A closure-typed PARAM of the enclosing function.
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const params = fn.fnParams
      let i = 0
      while i < params.length {
        const p = P.nodes[params[i]]
        if p is Param {
          if p.parName == name {
            const pn = tyNameOf(p.parType)
            // The parser's tree: `annArrowAt` scans the rendered name for a depth-0 arrow,
            // asking whether the annotation's tree root is a function type — different
            // from a scan for an arrow anywhere. Dual-run over the corpus: no disagreement,
            // both answers present.
            if annIsTopLevelFunc(p.parType, pn) { ft = pn }
          }
        }
        i = i + 1
      }
    }
  }
  // A closure-typed local/global binding annotation.
  if ft == "" { ft = identFnTypeAnnName(name, fnIx) }
  // The second exact copy of `annRetNameOf` (#1144); same `< 0` vs `< 1` note as
  // `cloArrSlotRetName` above.
  return annRetNameOf(ft)
}

// True if the expression is a NAME (param / local / module global) annotated
// `boolean|null` — the niche scalar nullable.
export function exprNulBool(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // Typed-IR fast path (additive — only turns false into true, mirroring `exprIsBool`):
  // the checker recorded this node's type as `boolean | null`. Recovers the niche for a
  // form the syntactic arms below can't trace — a `(boolean | null)[]` element read
  // `p[i]` — so its `!= null` compares against sentinel 2, not a bare null.
  if nodeTyIsNulBool(exprIx) { return true }
  // An if-EXPRESSION whose arm is ITSELF nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfB = nulIfArmNullableValueIx(exprIx)
  if nlIfB >= 0 {
    if exprNulBool(nlIfB, fnIx) { return true }
  }
  const e = P.nodes[unwrapParen(exprIx)]
  // A CALL of a function annotated `: boolean | null` — its result is the niche i32.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const cfn = P.nodes[fnStmts[t]]
        if cfn is FuncDecl {
          if tyIsNulBool(cfn.fnRet) { return true }
          // …or an un-annotated function whose return infers to `boolean | null`. Not a type
          // spelling (D-CLASSGRAM census note): `inferNicheNullByName` publishes a
          // three-valued tag (`""` / `"boolean|null"` / `"string|null"`), compared by provenance, not shape.
          if cfn.fnRet < 0 {
            if inferNicheNullByName(callee.identName) == "boolean|null" {
              return true
            }
          }
          return false
        }
      }
      // A call of a closure-typed VALUE (`p()` where `p: () => boolean | null`) — a
      // param / local / global `fnIndexOf` can't see: read its return-type annotation.
      if nameIsNulBool(calleeCloRetName(callee.identName, fnIx)) { return true }
    }
    return false
  }
  if e is Ident {
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl {
        const params = fn.fnParams
        let i = 0
        while i < params.length {
          const p = P.nodes[params[i]]
          if p is Param {
            if p.parName == e.identName { return tyIsNulBool(p.parType) }
          }
          i = i + 1
        }
        const li = parentLetOf(fn.fnBody, e.identName)
        if li >= 0 { return letNulBool(li, fnIx) }
      }
    }
    const gi = globalLetOfIn(fnIx, e.identName)
    if gi >= 0 { return letNulBool(gi, -1) }
    return false
  }
  // A bare map read `m[k]` over a `boolean | null`-valued map yields the niche i32 (0/1
  // with sentinel 2), so an un-annotated `const b = m[k]` narrows with `!= null` against 2.
  if e is Index {
    if nodeTyMapValIsNulBool(e.idxArr) { return true }
  }
  // A `boolean | null` struct FIELD read (`a.v`, code 21) is the niche i32 sentinel.
  if e is Member { return memberFieldCode(exprIx, fnIx) == 21 }
  // A chained `a ?? b` over `boolean | null` is itself `boolean | null` when the default
  // `b` is also nullable — the left-associative `(f() ?? g()) ?? d` shape (see the
  // `exprNullableString` companion). Keeps `??` print-routing consistent with the rep.
  if e is BinExpr {
    if e.binOp == "??" {
      if exprNulBool(e.binLeft, fnIx) { return exprNulBool(e.binRight, fnIx) }
    }
  }
  false
}

// A `let`/`const` binding is `boolean | null` if it is so ANNOTATED, or (un-annotated)
// its initializer is a `boolean | null` value — e.g. `const r = f()` where `f` returns
// the niche. Mirrors `letUnionNameOf`'s annotation-or-init resolution for value unions.
export function letNulBool(letIx: i32, fnIx: i32) {
  if letIx < 0 { return false }
  if letIsNulBoolAnn(letIx) { return true }
  // An un-annotated `const x = if c then true else null` infers `boolean | null` (a
  // niche the emitter can't statically derive from the if-expr arms). The CHECKER
  // typed it and exported the binding by node index; consult that before the init probe.
  if isInferLetNulBool(letIx) { return true }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType < 0 { return exprNulBool(d.letInit, fnIx) }
  }
  false
}

// True if `exprIx` is a `K | null` NICHE value (the i32 atom with the spare `-1` = null) — a
// `K|null`-annotated param / local / global, or a call of a `K|null`-returning function. The
// litunion dual of `exprNulBool`; consulted at the `== null` compare and the `null`-seed boundaries.
export function exprNulLitUnion(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  // …and the same `if` whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfA = nulIfArmNullableValueIx(exprIx)
  if nlIfA >= 0 {
    if exprNulLitUnion(nlIfA, fnIx) { return true }
  }
  // An if-EXPRESSION with a NULL arm over a litunion-ATOM arm — see `nulArmIfThenValueIx`. The
  // niche is the same i32 atom with `-1` for the missing arm, which is exactly what
  // `emitIfExprAs` writes for this shape.
  const elIfA = nulArmIfThenValueIx(exprIx)
  if elIfA >= 0 { return exprIsLitAtom(elIfA, fnIx) }
  // A `(K | null)[]` element read `p[i]` — the niche i32 (a member id or `-1`). Recovered
  // from the array's element type so `p[i] != null` narrows against `-1`, not a bare null.
  if e is Index {
    if nodeArrayElemIsNulLitUnion(e.idxArr) { return true }
    // A bare map read `m[k]` over `{[string]: K | null}` yields the niche i32 (a member id
    // or `-1`), so `const t = m[k]` narrows with `!= null` against `-1`.
    if nodeTyMapValIsNulLitUnion(e.idxArr) { return true }
    // …and the non-nullable spelling `{[string]: K}` reads the same niche: a bare `m[k]`
    // is `K | null` there too (a missing key is null), via the same `-1` miss value.
    if nodeTyMapValIsLitUnion(e.idxArr) { return true }
  }
  // A fused `m[k] ?? d` read over `{[string]: K | null}` yields the niche i32, so
  // `const t = m[k] ?? d` narrows with `!= null` — the same fused-read home `m.get(k) ?? d` shares.
  if e is BinExpr {
    if e.binOp == "??" {
      const nblRecv = fusedMapReadRecvIx(unwrapParen(e.binLeft))
      if nblRecv >= 0 {
        if nodeTyMapValIsNulLitUnion(nblRecv) { return true }
      }
      // The non-map `p ?? d` over the same niche keeps it `K | null` exactly when the
      // default can still be null — the consumer half of `emitCoalesce`'s litunion arm.
      // `coalesceLitUnionFits` makes the same claim the emit arm does, so both decline together.
      if coalesceLitUnionFits(exprIx, fnIx) {
        return coalesceDefaultNullable(e.binRight, fnIx)
      }
    }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const cfn = P.nodes[fnStmts[t]]
        if cfn is FuncDecl {
          if cfn.fnRet >= 0 { return nodeTyIsNulLitUnion(cfn.fnRet) }
        }
      }
      // A call of a closure-typed VALUE (`p()` where `p: () => K | null`) — a param /
      // local / global whose `K | null` niche return `fnIndexOf` can't see.
      if nameIsNulLitUnion(calleeCloRetName(callee.identName, fnIx)) {
        return true
      }
    }
    // An INDEXED closure-array call (`p[i]()` where `p: (() => K | null)[]`): the element's
    // closure result is the `K | null` niche. `cloArrSlotRetName` reads it off the ref-list slot,
    // the indexed dual of the Ident `calleeCloRetName` above — so `const t0 = p[i]()` binds the
    // kind-0 litunion niche (an i32) instead of mis-inferring the softened `string | null` ref.
    if callee is Index {
      if exprRefArray(callee.idxArr, fnIx) {
        const rn = cloArrSlotRetName(refListSlotOfExpr(callee.idxArr, fnIx))
        if nameIsNulLitUnion(rn) { return true }
      }
    }
    // Fallback, scoped to a call: a `K | null`-returning closure value call whose callee the
    // cases above miss — a chained closure call (`v(1)()` where `v: (i32) => (() => K | null)`).
    // The cheap no-render `nodeTyIsNulLitUnion` reads the checker's per-node type, mirroring
    // `exprNullableString`'s fallback, which structurally excludes the litunion niche.
    return nodeTyIsNulLitUnion(exprIx)
  }
  if e is Ident {
    // A CAPTURED variable, resolved against the enclosing frame's binding — the niche twin of
    // `exprIsLitAtom`'s capture channel, and the same node `captureValKind` sizes the env
    // field from. Checked first: a capture is none of the three channels below.
    if capturedIsNulLitUnion(fnIx, e.identName) { return true }
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl {
        const params = fn.fnParams
        let i = 0
        while i < params.length {
          const p = P.nodes[params[i]]
          if p is Param {
            if p.parName == e.identName {
              return nodeTyIsNulLitUnion(p.parType)
            }
          }
          i = i + 1
        }
        const li = parentLetOf(fn.fnBody, e.identName)
        if li >= 0 { return letNulLitUnion(li, fnIx) }
      }
    }
    const gi = globalLetOfIn(fnIx, e.identName)
    if gi >= 0 { return letNulLitUnion(gi, -1) }
    // A for-in loop var over a `(K | null)[]` — the one storage class the channels above
    // can't reach (no declaration node for an annotation). `declareForInLocals` flags its
    // slot as the atom; nullability comes from the checker's per-read recorded type.
    const nluSlot = declaredSlotOf(e.identName)
    if nluSlot >= 0 && nluSlot < localLitUnion.length {
      if localLitUnion[nluSlot] == 1 { return nodeTyIsNulLitUnion(exprIx) }
    }
    return false
  }
  // A `K | null` struct field read (`a.f`, code 30) is the niche i32 with the `-1`
  // sentinel — the litunion dual of `exprNulBool`'s Member arm. Covers the plain struct
  // receiver and the `is`-narrowed variant receiver (`memberFieldCode` resolves both), so
  // `const t0 = v.f` binds the niche and its `!= null` narrows against `-1`.
  if e is Member { return memberFieldCode(exprIx, fnIx) == 30 }
  false
}

// A `let`/`const` binding is `K | null` if it is so ANNOTATED, or (un-annotated) its initializer is
// a `K | null` value. The litunion dual of `letNulBool`.
export function letNulLitUnion(letIx: i32, fnIx: i32) {
  if letIx < 0 { return false }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return nodeTyIsNulLitUnion(d.letType) }
    return exprNulLitUnion(d.letInit, fnIx)
  }
  false
}

// True if `name` resolves (param / local / module global) to a BOOLEAN binding:
// either a `: boolean`/`: bool` annotation, or an un-annotated `const`/`let` whose
// initializer is itself boolean. A boolean local registers as kind 0 (== i32), so
// bool-ness must be recovered from the binding here, not the local registry.
function boundBoolByName(name: string, fnIx: i32) {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const params = fn.fnParams
      let i = 0
      while i < params.length {
        const p = P.nodes[params[i]]
        if p is Param {
          if p.parName == name { return tyIsBool(p.parType) }
        }
        i = i + 1
      }
      // `frameLetOfLive`, not `parentLetOf`: a `boolean` bound in a block this read is
      // not inside is out of scope, and the read denotes the module global. D1597.
      const li = frameLetOfLive(fn.fnBody, name)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if d.letType >= 0 { return tyIsBool(d.letType) }
          return exprIsBool(d.letInit, fnIx)
        }
      }
    }
  }
  const gi = globalLetOfIn(fnIx, name)
  if gi >= 0 {
    const g = P.nodes[gi]
    if g is LetDecl {
      if g.letType >= 0 { return tyIsBool(g.letType) }
      return exprIsBool(g.letInit, -1)
    }
  }
  false
}

export function retNulRefFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a nullable declared
    // struct (`S | null`). Confirms only; `string | null` and everything else fall to the name path.
    if nodeTyIsNulStruct(tyIx) { return 1 }
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      const base = nullablePartOf(ty.tyName)
      // `string` is the raw i32 array, NOT a struct — `string | null` is the kind-16
      // nullable-string ref (`retNulStringFlag`), never a nullable struct. Exclude it
      // here so it isn't mis-claimed as kind 9 (which would read the box as a struct).
      if base == "string" { return 0 }
      // A union variant with no struct row is `nulvariant`, not kind 9 (`retNulVariantFlag`
      // is the positive answer) — excluded here, at the one producer: `collectS` refuses a
      // variant its own struct row, so every `nulstruct` answer pairs a real struct index.
      if base != "" {
        if variantIndexOf(base) >= 0 && structIndexOfTypeName(base) < 0 {
          return 0
        }
      }
      if base != "" {
        // The `structIndexOfTypeName` half is load-bearing: a name can be both a variant and
        // a declared struct (`std/fs.vl`'s `IoResult`), which keeps its real struct row.
        const nrt = nodeRepTyIxOf(tyIx)
        if nrt >= 0 {
          const tn = T.tys[nrt]
          if tn is TyNullable {
            if tn.nInner >= 0 {
              const ti2 = T.tys[tn.nInner]
              if ti2 is TyObj { return 1 }
            }
            return 0
          }
        }
        if structIndexOfTypeName(base) >= 0 { return 1 }
      }
    }
  }
  0
}

// A nullable union variant annotation or expression (`Circle | null`, `x as? Circle`) — `1`,
// else `0`. Disjoint from `retNulRefFlag` by construction: that flag returns 0 for exactly
// what this one claims, since a variant has no struct row for the arena to ask about.
// Defined in terms of the index (`nulVariantIndexOf`), so the kind/slot pair can't disagree.
export function retNulVariantFlag(tyIx: i32) {
  if nulVariantIndexOf(tyIx) >= 0 { return 1 }
  0
}

// The variant table index behind a `Circle | null` annotation or expression at `tyIx`, or
// -1 — the `nulvariant` half of `annValtypeSlotOf`'s kind/slot pairing. Two rungs: the name
// answers an annotation, the arena an expression with a recorded type and no spelling
// (`mk(a) as? Circle`), since `variantRowOfTy` matches only by arena-index identity.
export function nulVariantIndexOf(tyIx: i32) {
  if tyIx < 0 { return -1 }
  const ty = P.nodes[tyIx]
  if ty is TypeRef {
    const base = nullablePartOf(ty.tyName)
    if base != "" {
      const nvn = variantIndexOf(base)
      // ONLY where the struct table refused a row — see `retNulRefFlag`'s matching gate.
      // A name that is both a variant and a declared struct keeps the kind-9 niche it
      // already lowers with, so this kind never takes a position that works today.
      if nvn >= 0 && structIndexOfTypeName(base) < 0 { return nvn }
      return -1
    }
  }
  const nvt = nodeTyIxOf(tyIx)
  if nvt >= 0 {
    const nvty = T.tys[nvt]
    if nvty is TyNullable {
      if nvty.nInner >= 0 {
        const nvr = variantRowOfTy(nvty.nInner)
        if nvr >= 0 {
          if structIndexOfTypeName(uVariants[nvr]) < 0 { return nvr }
        }
      }
    }
  }
  -1
}

// The base struct table index of a `S | null` annotation at `tyIx`, or -1.
export function retNulRefIndex(tyIx: i32) {
  if tyIx >= 0 {
    // Structural-first: the checker's recorded arena type resolves the slot directly
    // (`repSlotOfTy`, nominal identity plus the structural-declared bridge). Confirms only.
    const rt = nodeRepTyIxOf(tyIx)
    if rt >= 0 {
      const t = T.tys[rt]
      if t is TyNullable {
        const ds = repSlotOfTy(t.nInner)
        if ds >= 0 { return ds }
      }
    }
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      const nb = nulBaseStructRow(tyIx, ty.tyName)
      if nb >= 0 { return nb }
    }
  }
  -1
}

// The struct/rep row of the base of a nullable-struct annotation (`S | null` -> `S`'s row),
// or -1. Three rungs: the arena (a `TyNullable`'s peeled inner via `repRowOfTyStruct`,
// no render), `repRowOfName` (kept for an inline-shape nullable the arena can't resolve),
// then `structIndexOfTypeName`'s legacy field-set scan.
function nulBaseStructRow(tyIx: i32, name: string): i32 {
  const base = nullablePartOf(name)
  if base == "" { return -1 }
  const nt = nodeRepTyIxOf(tyIx)
  if nt >= 0 {
    const t = T.tys[nt]
    if t is TyNullable {
      const ar = repRowOfTyStruct(t.nInner, sScanLim())
      if ar >= 0 { return ar }
    }
  }
  // The arena already answered "not a struct row" whenever the nullable inner isn't an
  // object row, so the name bridge (`repRowOfName`, which requires `TyObj` too) is never
  // asked — dual-run confirms it always agrees. A decline with no `TyNullable` in the rep
  // column at all keeps the full ladder, since there the arena said nothing, not no.
  let innerIsObj = false
  let innerKnown = false
  if nt >= 0 {
    const t2 = T.tys[nt]
    if t2 is TyNullable {
      innerKnown = true
      if t2.nInner >= 0 {
        const ti = T.tys[t2.nInner]
        if ti is TyObj { innerIsObj = true }
      }
    }
  }
  // And the field-set matcher goes with it: a non-object inner (`string`, `i32`, `K`, a
  // map) has no field set for `structIndexOfTypeName` to match either, dual-run confirmed
  // to decline the same way `repRowOfName` does — so the whole name tail is skipped and
  // the arena alone answers -1, the value it would reach anyway one scan later.
  if innerKnown && !innerIsObj { return -1 }
  const rr = repRowOfName(base, sScanLim())
  if rr >= 0 { return rr }
  structIndexOfTypeName(base)
}

// `1` if the type-annotation node at `tyIx` names the struct, else `0` (i32 / none).
// Used for functype param/result valtypes and the `"struct"` return kind. Returning the
// flag (not pushing bytes) keeps each call free of a `0→1` local reassignment, which
// pins a `let x = 0` to the literal `0` type and fails to typecheck.
export function retTRFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a declared struct —
    // confirm directly, skipping the O(nodes) `nameIsStructDecl` scan `isSName` walks. Only
    // CONFIRMS (never denies), so anything it doesn't cover falls to the name test below.
    if nodeTyIsStruct(tyIx) { return 1 }
    return 0
  }
  0
}

// The struct table index named by the type-annotation node at `tyIx`, or -1 if it
// names no declared struct.
export function retStructIndex(tyIx: i32) {
  if tyIx >= 0 {
    // Structural-first (the first arena-keyed row consumer): a struct annotation resolves
    // its slot off the checker's arena type (`repSlotOfTy`), skipping the name scan. This
    // includes the structural-declared bridge (an inline `{…}` resolving to its unique
    // declared twin), byte-safe now that the sig-canon slice renders twin-safe `$fnsig` digits.
    const ds = repSlotOfTy(nodeRepTyIxOf(tyIx))
    if ds >= 0 { return ds }
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      const si = structIndexByName(ty.tyName)
      if si >= 0 { return si }
      // A union-variant name carries its VARIANT index here (consumed by `pushVT`'s
      // `kind == 8` variant-struct case); not a standalone struct, so it is -1 above.
      const vi = variantIndexOf(ty.tyName)
      if vi >= 0 { return vi }
      // A `S | null` annotation resolves to its BASE struct's index — the single
      // chokepoint the param/local/return struct lookups read, so a nullable-struct
      // binding's member layout resolves without separate plumbing.
      return nulBaseStructRow(tyIx, ty.tyName)
    }
  }
  -1
}

// The name the emitter's own shape table claims for the arena struct row `ty`, or "" when
// no row claims it (D592). The monomorphizer's un-annotated struct return needs a real
// name, not a printed shape (`tyToStructStr` prints `{x: i32}`, which nothing registered);
// `sNames[si]` is the row's own name, what every name-keyed consumer resolves.
export function monoRetRowName(ty: i32) {
  const si = repSlotOfTy(ty)
  if si >= 0 {
    if si < sNames.length { return sNames[si] }
  }
  // D681 — the anonymous row, by arena identity and nothing else: `repSlotOfTy` covers
  // declared rows only, so a shape that only appeared as an object literal answers -1
  // there even though `collectAnonShapes` interned exactly this row, under an `#anonN`
  // handle. Nominal, not structural — a printed-spelling match can't tell two generic instances apart.
  const ai = sAnonRowByTy(ty)
  if ai >= 0 { return sNames[ai] }
  ""
}

// The ANONYMOUS struct-table row whose D0 `sTyIx` sidecar entry IS the arena type `ty`, or
// -1 — `repSlotOfTyDecl`'s nominal leg with the `sRowDecl` gate replaced by its complement.
// First match wins, as in every other row scan; the sidecar holds -1 for a row it does not
// cover, which never matches a real type.
function sAnonRowByTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  let i = 0
  while i < sTyIx.length {
    if sTyIx[i] == ty {
      if sIsAnonRow(i) { return i }
    }
    i = i + 1
  }
  -1
}

// The `pendingListKind` a type-annotation node at `tyIx` names (1 = struct/map ref list,
// 2 = union box ref list, 3 = string list), or 0 when it isn't a list annotation. Shared
// by the let/return/call-arg/global seeding so each position threads the same
// annotation-derived list context into `emitArr`, not a first-element guess.
export function tyAnnRefListKind(tyIx: i32) {
  if tyIx >= 0 {
    // The annotation's element row, `| null`-tolerant exactly as the intern arm that
    // banked it (`ensureRefElem`/`rlInternName`) — read, not re-derived from the rendering.
    const raK = annRefArrSlot(tyIx)
    if raK >= 0 && raK < rlElemKindTbl.length {
      if rlElemKindTbl[raK] == 2 { return 2 }
      if rlElemKindTbl[raK] == 5 { return 5 }
      return 1
    }
    // An inline literal-union array annotation (`("a" | "b")[]`) seeds no list kind — the
    // default i32 wrapper. Ahead of the name arm since canon softens the bare inline union
    // to `string`, which would otherwise seed the string-list build for an atom-i32 cell.
    if tyIsLitUnionArray(nodeTyIxOf(tyIx)) { return 0 }
    // The numeric twin of the arm above: a numeric literal union has no atom (its members
    // ARE i32/i64/f64 values), so a `K[]` is the base scalar's list — f64 (4), i64 (6), or
    // the default i32. Ahead of the name arms for the same canon-softening reason: an
    // empty `[]` would otherwise build the i32 default into an f64/i64 cell.
    const nlab = numLitUnionArrayBaseName(nodeTyIxOf(tyIx))
    if nlab == "f64" { return 4 }
    if nlab == "i64" { return 6 }
    if nlab != "" { return 0 }
    // The nullable-element twin (`(("a" | "b") | null)[]`, kind 9), ahead of the name arms
    // for the same reason: the softened `(string | null)[]` spelling would seed a string list.
    if annIsNulLitUnionArray(tyIx) { return 9 }
    const lt = P.nodes[tyIx]
    if lt is TypeRef {
      // Stays on the name — a decline with evidence (B79): `nodeTyArrayElemRepName(tyIx) ==
      // "string"` looks like a swap-in but is silent on a `TyParam` element
      // (`generics/type-param-shadows-alias-funcdecl.vl`), and dual-run confirms the arena
      // never answers `string` where the name declines, so the disjunct would move nothing.
      if nameIsStringArray(lt.tyName) { return 3 }
      // A `(boolean | null)[]` annotation (kind 8): an i32-backed list with the boolean
      // sentinel niche (`null → 2`), so an all-`null` `[null]` builds the i32 wrapper.
      // Checked before the scalar-array arms. The arena (`nodeTyIsNulBoolList`) and name
      // (`nameIsNulBoolList`) legs agree everywhere dual-run; the name stays for uncovered nodes.
      if nodeTyIsNulBoolList(tyIx) { return 8 }
      if nodeTyIxOf(tyIx) < 0 && nameIsNulBoolList(lt.tyName) { return 8 }
      // A `(K | null)[]` annotation (kind 9): an i32-backed atom list with the litunion
      // sentinel niche (`null → -1`). Do not delete on a zero-row sabotage (B75): the
      // similar-looking `annIsNulLitUnionArray` only recognizes the `TyNullable`-element
      // spelling, not the checker's flattened `"a" | "b" | null` union form; this catches both.
      if nameIsNulLitUnionList(lt.tyName) { return 9 }
      // An `f64[]` annotation: an empty `[]` builds the f64-list wrapper (kind 4).
      if tyIsF64Array(nodeTyIxOf(tyIx)) { return 4 }
      // An `i64[]` annotation: an empty `[]` builds the i64-list wrapper (kind 6).
      if tyIsI64Array(nodeTyIxOf(tyIx)) { return 6 }
      // An `f32[]` annotation (kind 7): threads even for a non-empty literal, since a bare
      // `[1.5]` doesn't self-identify as f32 (it defaults to f64). Stays on the name
      // deliberately — a kind-based test would be a constant false here (`tyKindOf` never
      // returns 21), and a kind-based claim would mis-classify a literal-built f64 list as f32.
      if nameIsF32Array(lt.tyName) { return 7 }
      // A `u8[]` annotation (kind 10) — the packed byte list. Threads for a non-empty
      // literal too: a bare `[1, 2]` types `i32[]`, so the annotation is the only signal.
      if nameIsU8Array(lt.tyName) { return 10 }
    }
  }
  0
}

// The ref-list table slot a type-annotation node at `tyIx` names (`Tok[]` → the `Tok`
// slot), or 0 when it isn't a ref-array annotation. Mirror of `tyAnnRefListKind` for the
// slot; threads `pendingListSlot` so a ref-list literal builds the annotation's own element type.
export function tyAnnRefListSlot(tyIx: i32) {
  if tyIx >= 0 {
    // Which ref-list ROW holds this annotation's element — the recorded type first,
    // then the row the INTERN pass banked on the node. `| null`-tolerant, exactly as
    // the intern arm is.
    const raS = annRefArrSlot(tyIx)
    if raS >= 0 { return raS }
  }
  0
}

// `1` if the type-annotation node at `tyIx` is a REF array (`S[]`/`N[]`), else `0`.
// Feeds the `kind == 5` (ref list) branch of `pushVT`.
export function retRefArrFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node as an array of a declared struct
    // (`S[]`) — the clean base case, without the O(nodes) name scan the bare element match walks.
    if nodeTyIsStructArray(tyIx) { return 1 }
    // A ref-list ROW for the annotation's element IS the intern-state question, and covers the
    // nested / union / niche element spellings the struct-array fast path above declines. Gated
    // to a NON-nullable annotation — a `S[] | null` spelling is `retNulRefArrFlag`'s.
    if annBareRefArrSlot(tyIx) >= 0 { return 1 }
  }
  0
}

// `1` if the type-annotation node at `tyIx` is a nullable ref array (`<ref-array> | null` —
// e.g. `S[] | null`, `i32[][] | null`), else `0`. The value/composite-position analogue of
// the local ladder's `letIsNulRefArray` (kind 18, `"nulreflist"`): a `(ref null $wrapper)`
// slot over the inner ref-list's element wrapper. Feeds the `"nulreflist"` arm of `vtKindOfType`.
export function retNulRefArrFlag(tyIx: i32) {
  if tyIx >= 0 {
    // A `TyNullable` annotation whose inner array's element owns a ref-list ROW, with the
    // nullable gate carried by `annNulRefArrSlot` so a bare `S[]` still answers 0.
    if annNulRefArrSlot(tyIx) >= 0 { return 1 }
  }
  0
}

// The folded list-rep code of a function return annotation `tyIx`: `2` i32-list, `5`
// ref-list, `7` string-list, `12` f64-list, or `0` (not a list). The four `nameIs*Array`
// predicates are mutually exclusive by name, so the priority order is immaterial.
function retListKindFlag(tyIx: i32) {
  if retArrFlag(tyIx) == 1 { return 2 }
  if retRefArrFlag(tyIx) == 1 { return 5 }
  if retStrArrFlag(tyIx) == 1 { return 7 }
  if retF64ArrFlag(tyIx) == 1 { return 12 }
  0
}

// The ref-list element type-NAME of a function RETURN type node `tyIx` (an `S[]`/`N[]`),
// or "". Populates `fRetRArrElem`.
export function retRefArrElemName(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    // `refArrElemNameIf` IS the `nameIsRefArray`-gated `refArrElemName` this arm spelled
    // out; its "" for a non-ref-array annotation is the same "" this function's tail
    // returned, so the early return is exact.
    if ty is TypeRef { return refArrElemNameIf(ty.tyName) }
  }
  ""
}

// An emitter-synthesized type-annotation node (a mono clone, an inferred-list synthesis, a
// contextual return/param pin). Records the concrete type on the new node so the
// structural classifiers cover it (`recordClonedNodeTy`), uniformly across every synthesis
// site. The returned node carries its resolved type, so a caller reads it off the node.
export function synthTypeRef(name: string, pos: i32) {
  synthTypeRefTy(name, pos, -1)
}

// `synthTypeRef` with a FALLBACK type: the name is resolved first and wins, and `tyFb` is
// used only where it does not resolve — where `synthTypeRef` records a coarse placeholder.
// See `recordClonedNodeTyFb` for the measurement that fixes this precedence.
export function synthTypeRefFb(name: string, pos: i32, tyFb: i32) {
  const n = mkTypeRef(name, pos)
  const pin = pinKindOfName(name)
  recordNodePin(n, pin, synthPinPayloadOf(name, pin))
  recordClonedNodeTyFb(n, name, pin, tyFb)
  n
}

// `synthTypeRef` with the type handed over instead of parsed back out of `name`. See
// `recordClonedNodeTyKnown`. `tyIx` of -1 is exactly `synthTypeRef`.
export function synthTypeRefTy(name: string, pos: i32, tyIx: i32) {
  const n = mkTypeRef(name, pos)
  const pin = pinKindOfName(name)
  recordNodePin(n, pin, synthPinPayloadOf(name, pin))
  recordClonedNodeTyKnown(n, name, pin, tyIx)
  n
}

// The mint-side bridge of the pin column: which provenance, if any, the synthesized name
// `name` carries. Every pin enters the arena through `synthTypeRef` above, so classifying
// here covers the column completely. The anon leg is an exact-name query
// (`isSName`) — a prefix test would also match `"#anon3[]"`, an array of an interned shape.
export function pinKindOfName(name: string) {
  if sigKeyPinPayload(name) != "" { return PIN_SIGKEY }
  if isSName(name) { return PIN_ANON }
  PIN_NONE
}

// The payload the column stores beside `kind` — the `$fnsig` key for a SIGKEY pin,
// "" for every other kind (an interned shape's layout rides `sNames`, keyed by the
// name the node already carries, so it needs no second copy here).
function synthPinPayloadOf(name: string, kind: i32) {
  if kind == PIN_SIGKEY { return sigKeyPinPayload(name) }
  ""
}

// The nullable-scalar-list VKind of a distinct-backing nullable list type name (`string[] |
// null`, `f64[] | null`, `i64[] | null`, `f32[] | null`), or "" otherwise. Each leaf has its
// own wrapper heap type, unlike the i32-backed `nameIsNulI32List` fold: a bare `= null` init
// lowers as `ref.null $wrapper`, and a list value's wrapper ref subtypes the nullable slot.
export function nulScalarListKind(name: string): VKind | null {
  const b = nullablePartOf(name)
  if nameIsStringArray(b) { return "nulstrlist" }
  // A nullable-element string list under the outer null (`(string | null)[] | null`) shares
  // `string[]`'s wrapper heap type, so the nullable cell is the same kind. Un-admitted, the
  // param fell through to the i32 default and pushed the wrapper ref into an i32 slot.
  if nameIsNulStrList(b) { return "nulstrlist" }
  if nameIsF64Array(b) { return "nulf64list" }
  if nameIsI64Array(b) { return "nuli64list" }
  if nameIsF32Array(b) { return "nulf32list" }
  if nameIsU8Array(b) { return "nulu8list" }
  null
}
// The nullable-scalar-list VKind of annotation node `tyIx`, or `null`. Arena-first and
// total where it covers: the spelling can't tell the four cases apart any more, since
// `canonEmitName` softens a bare inline literal union to its base scalar. A covered
// annotation outside the four answers `null` outright, not a name that lost the distinction.
export function nulScalarListKindOfNode(tyIx: i32): VKind | null {
  if tyIx < 0 { return null }
  const rk = annRepKindOf(tyIx)
  if rk != null {
    if isNulScalarListKind(rk) { return rk }
    return null
  }
  const ty = P.nodes[tyIx]
  if ty is TypeRef { return nulScalarListKind(ty.tyName) }
  null
}
// The `emitArr` list-build code (`pendingListKind` / `ExpCtx.listKind`) a nullable-scalar-list
// value's list literal builds with: strlist 3 · f64list 4 · i64list 6 · f32list 7 (the leaf-list
// build codes), or 0 if `kind` is not a nullable scalar list.
export function nulScalarListBuildKind(kind: VKind | null): i32 {
  if kind == "nulstrlist" { return 3 }
  if kind == "nulf64list" { return 4 }
  if kind == "nuli64list" { return 6 }
  if kind == "nulf32list" { return 7 }
  if kind == "nulu8list" { return 13 }
  0
}
// True if `kind` is one of the four distinct-backing nullable-scalar-list VKinds.
export function isNulScalarListKind(kind: VKind | null): boolean {
  if kind == null { return false }
  kind == "nulstrlist" ||
    kind == "nulf64list" ||
    kind == "nuli64list" ||
    kind == "nulf32list" ||
    kind == "nulu8list"
}
// The struct/variant field code of a distinct-backing nullable scalar-list spelling —
// `string[] | null` 31 · `f64[] | null` 32 · `i64[] | null` 33 · `f32[] | null` 34 — or -1.
// Each leaf keeps its own wrapper heap type, unlike the i32-backed leaves which all fold
// onto code 18, so `structFieldCodesEq` can split same-fieldset twins by real layout.
function nulScalarListFieldCode(name: string) {
  const k = nulScalarListKind(name)
  if k == "nulstrlist" { return 31 }
  if k == "nulf64list" { return 32 }
  if k == "nuli64list" { return 33 }
  if k == "nulf32list" { return 34 }
  if k == "nulu8list" { return 35 }
  -1
}
// The nullable-scalar-list VKind behind FIELD code 31..34 — the inverse of
// `nulScalarListFieldCode`, so the store/read/null paths recover the leaf's build kind
// (`nulScalarListBuildKind`) and wrapper heap (`nulScalarListWrapHeap`) from the code alone.
export function nulScalarListCodeKind(code: i32): VKind | null {
  if code == 31 { return "nulstrlist" }
  if code == 32 { return "nulf64list" }
  if code == 33 { return "nuli64list" }
  if code == 34 { return "nulf32list" }
  if code == 35 { return "nulu8list" }
  null
}
// True if field code `c` is one of the four distinct-backing nullable-scalar-list codes.
export function isNulScalarListFieldCode(c: i32): boolean {
  c == 31 || c == 32 || c == 33 || c == 34
}

// True if the type-annotation node `tyIx` denotes an array whose element is a nullable
// literal union (`(K | null)[]`) — the atom-niche list interning i32 ids with `-1` for
// `null`. `nameIsNulLitUnionList`'s structural dual: `canonEmitName` softens an inline
// nullable litunion to `(string | null)[]`, indistinguishable by name from a real string list.
function annIsNulLitUnionArray(tyIx: i32) {
  tyIsNulLitUnionArr(nodeTyIxOf(tyIx))
}

// The same question asked of an arena index rather than an annotation node — an array
// whose element is a nullable string, needed after `annIsNulStrListDeep` peels an outer
// `| null` and has no node left to ask.
function tyIsNulStrArr(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyNullable {
      const inner = T.tys[e.nInner]
      if inner is TyPrim { return inner.primName == "string" }
    }
  }
  false
}

function tyIsNulLitUnionArr(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyNullable { return tyIsLitUnion(e.nInner) }
  }
  false
}

// `nameIsNulStrListDeep` asked of a type-annotation node, with the atom-niche element
// ruled out structurally first: an inline `(("a" | "b") | null)[]` renders `(string |
// null)[]` after canon, so the name predicate alone would mis-route it to the string backing.
function annIsNulStrListDeep(tyIx: i32) {
  if tyIx < 0 { return false }
  let ty = nodeTyIxOf(tyIx)
  if ty >= 0 {
    const t = T.tys[ty]
    if t is TyNullable { ty = t.nInner }
  }
  if tyIsNulLitUnionArr(ty) { return false }
  // The arena answers the positive half too, so this predicate doesn't render a type and
  // pattern-match the render.
  if ty >= 0 { return tyIsNulStrArr(ty) }
  // A node the checker did not record still falls back to the spelling.
  nameIsNulStrListDeep(tyNameOf(tyIx))
}

// The wasm rep kind the checker's arena assigns to annotation node `tyNodeIx`, or `null`
// where the arena doesn't decide it — `vtKindOfType`'s `repOf`-first leg: when it answers,
// the rep is settled structurally, and a new element vocabulary belongs in the rep tree,
// not a second arm here, or the two would drift.
function annRepKindOf(tyNodeIx: i32): VKind | null {
  if tyNodeIx < 0 { return null }
  const rd = repOfNode(tyNodeIx)
  if rd.rdCovered == 1 { return rd.rdKind }
  null
}

// True if the type-annotation node `tyIx` denotes the kind-19 nullable-closure niche,
// seeing through a declared alias whose body is a function type (`type F = (i32) => i32`,
// then `F | null`). The parser encodes such an alias as `TyNullable(TyUnion[TyFunc])`, so
// `tyDenotesFunc` peels the degenerate one-member union wrapper to find the function.
function nulCloFlagAnn(tyIx: i32) {
  if nulCloFlag(tyIx) == 1 { return 1 }
  const ty = nodeTyIxOf(tyIx)
  if ty < 0 { return 0 }
  const t = T.tys[ty]
  if t is TyNullable {
    if tyDenotesFunc(t.nInner) { return 1 }
  }
  0
}

export function vtKindOfType(tyIx: i32): VKind {
  // Arena-first (the strangler seam): where the checker's arena covers the annotation's
  // shape, the rep descriptor decides the kind — one structural derivation instead of
  // this ladder re-testing name arms. The ladder below is the fallback for the uncovered
  // remainder and shrinks as coverage widens. `annRepKindOf` is this leg exactly.
  const rk = annRepKindOf(tyIx)
  if rk != null { return rk }
  // A literal-union annotation (`type K = "a" | "b"`) is an i32-backed interned atom (`"i32"`), NOT
  // a value-union box — checked first (it IS a `TyUnion`, so `retUnionFlag` would claim it).
  if tyIx >= 0 {
    if P.nodes[tyIx] is TypeRef {
      if nodeTyIsLitUnionAlias(tyIx) { return "i32" }
    }
  }
  // A nullable literal-union (`K | null`) is the same i32 atom (`"i32"`), with the spare
  // value `-1` encoding `null` (no box). Checked before the `string | null` niche
  // (`"nulstr"`) as a defensive ordering, ahead of any base-collapse.
  if tyIx >= 0 {
    if P.nodes[tyIx] is TypeRef {
      if nodeTyIsNulLitUnion(tyIx) { return "i32" }
    }
  }
  // A nullable numeric literal union (`1 | 2 | null`) is the value-union box (`<base
  // scalar> | null`), not the atom niche — neither litunion rule above claims it, so
  // without this arm it fell to the `"i32"` default while the `let`/global ladder built
  // it as a box: one type with two reps, `bare null needs a struct-typed context` at `f(null)`.
  if nodeTyIsNulNumLitUnion(tyIx) { return "union" }
  // A NULLABLE function `(fn) | null` is the closure fat-pointer made nullable, `"nulclosure"` —
  // checked BEFORE `tyIsFuncType` (whose `=>` test would otherwise claim it as the non-null
  // `"closure"`). The non-null part is a function, but the `| null` makes the slot nullable.
  if nulCloFlag(tyIx) == 1 { return "nulclosure" }
  // An array of functions (`((i32) => i32)[]`) is a closure-element ref list
  // (`"reflist"`), not a single closure — checked before `tyIsFuncType`, whose `=>`
  // substring test would otherwise claim the whole array as `"closure"`.
  if nameIsClosureArrayTy(tyIx) == 1 { return "reflist" }
  // A function-typed annotation (a name carrying `=>` — incl. the synthetic
  // `"=>sigkey"` a monomorphized closure param is pinned with) is the closure
  // fat-pointer, `"closure"`. Checked first; no other name contains an arrow.
  if tyIsFuncType(tyIx) { return "closure" }
  // A string-keyed map annotation (`{[string]: V}`) is the map struct ref, `"map"` — checked
  // before the struct/object arms (an inline `{[…]:…}` is not a field-struct shape). Its
  // `fbValtype` arg is the map shape slot (mono i32 ⇒ -1, via `paramStructIdxOf`/`retStructIndex`).
  if retMapFlag(tyIx) == 1 { return "map" }
  // A nullable string-keyed map (`{[string]: V} | null`) — the `(ref null $mapStruct)` niche
  // (`"nulmap"`), the map twin of `nulstruct`. AFTER `retMapFlag` (a bare map is never nullable);
  // disjoint from it anyway (a `| null` map name is a `nameIsMapMemberUnion`, which `retMapFlag`
  // excludes). Its shape arg is `mapAnnShape` (now `| null`-aware), resolving THIS map's `$mapStruct`.
  if retNulMapFlag(tyIx) == 1 { return "nulmap" }
  // A nullable union variant (`Circle | null`) — the `(ref null $uVarHeap[vi])` niche,
  // paired in `annValtypeSlotOf` with the variant index. Beside `retNulRefFlag` rather
  // than after it as a fallback, because the two are disjoint at the producer.
  if retNulVariantFlag(tyIx) == 1 { return "nulvariant" }
  if retNulRefFlag(tyIx) == 1 { return "nulstruct" }
  if retNulStringFlag(tyIx) == 1 { return "nulstr" }
  if retNulListFlag(tyIx) == 1 { return "nullist" }
  // A nullable ref array (`<ref-array> | null`) — the `(ref null $wrapper)` niche (kind 18,
  // `"nulreflist"`). Before `retRefArrFlag` (whose non-null slot can't hold `null`) and the
  // union arms. Disjoint from `"nullist"` above: an i32-backed list is `"nullist"`, a
  // ref-element/nested list is `"nulreflist"`.
  if retNulRefArrFlag(tyIx) == 1 { return "nulreflist" }
  if retStrArrFlag(tyIx) == 1 { return "strlist" }
  if retF64ArrFlag(tyIx) == 1 { return "f64list" }
  if retI64ArrFlag(tyIx) == 1 { return "i64list" }
  // A `u8[]` annotation — the packed byte list. Before `retArrFlag`, whose i32-list
  // answer would name a 4-byte backing for a one-byte one. The `repOf` seam above
  // already answers for a node the checker recorded a type on; this rung is the
  // annotation-node fallback its scalar-list siblings each carry too.
  if annIsU8Array(tyIx) { return "u8list" }
  if retF32ArrFlag(tyIx) == 1 { return "f32list" }
  if retRefArrFlag(tyIx) == 1 { return "reflist" }
  if retUnionFlag(tyIx) == 1 { return "union" }
  if retVariantFlag(tyIx) == 1 { return "variant" }
  if retTRFlag(tyIx) == 1 { return "struct" }
  if retArrFlag(tyIx) == 1 { return "list" }
  if retStrFlag(tyIx) == 1 { return "str" }
  if retI64Flag(tyIx) == 1 { return "i64" }
  if retF64Flag(tyIx) == 1 { return "f64" }
  if retF32Flag(tyIx) == 1 { return "f32" }
  "i32"
}

// `1` if the type-annotation node at `tyIx` is a string-keyed map (`{[string]: V}`), else `0`.
// Feeds the `kind == 6` (map struct ref) branch of `vtKindOfType`, so a map can be a param /
// return / functype valtype (the `(ref $mapStruct)` cell), not only a local.
export function retMapFlag(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      // A string-keyed map crosses a call boundary as kind 6 (`(ref $mapStruct)`), gated by
      // the same classifier the local path interns with (`mvValKindOfName`). A map-member
      // union (`{[string]: V} | X`) also starts with `{[`, but the arena distinguishes a
      // bare `TyMap` from a `TyUnion` with no false positive (D-BAREMAP).
      if nodeTyIsMap(tyIx) {
        // The arena's value type, not the annotation's spelling: reached through
        // `nodeTyMapValName`, so an alias or softened literal union can't change the
        // answer. Not fully spelling-free — `mvValKindOfName` still tests a name, just one read from the arena.
        if mapNodeValKindLowerable(tyIx) { return 1 }
      }
    }
  }
  0
}

// The bare (non-null) inner map name of a `{[string]: V} | null` type-name, or "" for
// anything that isn't a nullable map. The one chokepoint every `nulmap` classifier strips
// through, so downstream readers see the inner `{[string]: V}`, never a garbled slice.
export function nulMapInnerName(name: string) {
  const np = nullablePartOf(name)
  if np != "" && nameIsBareMap(np) { return np }
  ""
}
// `1` if the type-annotation node at `tyIx` is a nullable string-keyed map (`{[string]: V}
// | null`), else `0` — the map analogue of `retNulRefFlag`/`retNulRefArrFlag`: a
// `(ref null $mapStruct)` niche. Gated to the same supported value kinds as the non-null
// `retMapFlag`, so an unrepresentable nullable-map value keeps failing loudly (D-BAREMAP).
export function retNulMapFlag(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      if tyIsNulBareMap(tyIx) {
        if mapValKindLowerable(nulMapInnerName(ty.tyName)) { return 1 }
      }
    }
  }
  0
}

// The map shape (`fbValtype`/`mapTypeIdxOf` second arg) of a string-keyed map type
// annotation: -1 for the mono i32/boolean map, or the value type's interned mv slot. Safe
// for a non-map/un-interned value, since `retMapFlag` only admits supported value types.
// Shared by the param/return valtype and the body shape resolution (`mapShapeOfExpr`).
export function mapAnnShape(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      // A NULLABLE map annotation (`{[string]: V} | null`) resolves its shape from the BARE inner
      // map — its `(ref null $mapStruct)` cell selects the SAME `$mapStruct` its non-null twin does.
      let mn = ty.tyName
      const nim = nulMapInnerName(mn)
      if nim != "" { mn = nim }
      if nameIsMap(mn) {
        // The key selects which map struct family the annotation names — the param/
        // return/nulmap valtype and the body shape must agree. The arena answers where it
        // covers the node (`nodeTyMapKeyIsI32Span`, recursing `TyNullable` so the folded
        // nulmap spelling is covered too); an uncovered node keeps the name bridge.
        let kAn = nameIsI32KeyedMap(mn)
        if nodeTyIxOf(tyIx) >= 0 { kAn = nodeTyMapKeyIsI32Span(tyIx) }
        const vn = mapValNameOf(mn)
        // A mono value rides the shared struct of its own key rep: the `-1`/`-4` pair.
        if vn == "i32" || vn == "boolean" { return mapMonoShapeOfKey(kAn) }
        // The arena leg's type comes from this annotation node when the checker banked one
        // (D-MAPNODETY): every call site hands a node index, so an uncovered node (-1) keeps the name bridge.
        let aAn = -1
        const vtAn = nodeMapValTyIx(tyIx)
        // …and the arm component of the slot's identity off the same node (D48): without it
        // the mint could separate two twin-valued maps' slots while both functions kept
        // returning the first one's map struct. `vn` is a render that can't tell an arm
        // from its layout twin either; `vtAn` is the checker's own type and answers nominally.
        const armAn = mvArmHintOfTy(vtAn)
        // …and the same key rewrite the mint applies (D93): `mvArmKeyName` is a pure
        // function of (rendered name, recorded type), so mint and find compute one key.
        const vnA = mvArmKeyName(vn, vtAn)
        if vtAn >= 0 { aAn = mvSlotOfTyKArm(vtAn, kAn, armAn) }
        if aAn < 0 { aAn = mvSlotOfValNameTyKArm(vnA, kAn, armAn) }
        if aAn >= 0 { return aAn }
        const nmAn = mvSlotByValNameKArm(vnA, kAn, armAn)
        if nmAn >= 0 { return nmAn }
        // A mono-repped value spelling the two scans above never intern (a literal-union
        // atom, a nullable atom) still resolves by KEY alone.
        if kAn { return -4 }
      }
    }
  }
  -1
}

// The map SHAPE of the map PARAM `name` of function `fnIx` (its annotation's value type),
// or -1. Lets `mapShapeOfExpr` resolve a map param's VALUE type instead of assuming mono i32.
function paramMapShape(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name { return mapAnnShape(p.parType) }
      }
      i = i + 1
    }
  }
  -1
}

// ── the re-entrancy guard on an inferred map return's shape ──────────────────
// The `fnStmts` positions whose inferred map-return shape is currently being resolved. A
// stack, not a flag, since a chain of map factories nests legitimately. On re-entry the
// answer is the checker's own recorded type on the call node, never a bare -1 (D30).
let retMapFlight: i32[] = []

// Drop any in-flight map-return resolution. Called from `emitProgram`'s state block.
export function resetRetMapFlight() {
  retMapFlight = []
  0
}

// True when `fe`'s inferred map-return shape is already being resolved further up the stack.
function retMapInFlight(fe: i32) {
  let i = 0
  while i < retMapFlight.length {
    if retMapFlight[i] == fe { return true }
    i = i + 1
  }
  false
}

// The map shape the CHECKER recorded on the call node at `callIx`, or -1 — the re-entry
// answer, and the same rung `mapShapeOfExpr` / `mapRetExprShape` fall through to when the
// syntactic path cannot name the callee.
function mapRecordedCallShape(callIx: i32) {
  if callIx >= 0 {
    if nodeTyIsMap(callIx) { return mapFindShapeOfNodeTy(callIx) }
  }
  -1
}

// The map shape a function `name` returns, as seen from the call at `callIx`: its return
// annotation's value type, else the inferred shape its own result valtype is minted from
// (`inferredRetMapSlot`), else -1 (the mono map). `callIx` carries the call node only for
// the re-entrant case (D30) — a tail `if` return isn't caught by `fnRetExprOf` alone.
function fnRetMapShapeAt(sid: i32, callIx: i32) {
  const fe = fnIndexOfSid(sid)
  if fe >= 0 {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      if fn.fnRet >= 0 { return mapAnnShape(fn.fnRet) }
      if retMapInFlight(fe) { return mapRecordedCallShape(callIx) }
      return inferredRetMapSlot(fe)
    }
  }
  -1
}

// `1` if the type-annotation node at `tyIx` names a union VARIANT struct (e.g. `TyObj`
// of `Ty`), else `0`. Feeds the `kind == 8` (concrete variant struct ref) branch of
// `pushVT`. A variant-struct param/result is the unboxed variant ref directly — gap #2.
export function retVariantFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a union-variant member.
    if nodeTyIsVariant(tyIx) { return 1 }
    return 0
  }
  0
}

// `1` if the type-annotation node at `tyIx` names the declared union alias, else `0`.
// Feeds the `kind == 4` (union box) branch of `pushVT`.
export function retUnionFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a declared value-union box.
    if nodeTyIsUnionAlias(tyIx) { return 1 }
    return 0
  }
  0
}

// The `pushVT` `VKind` for a parameter node at `paramIx` (`"struct"`, `"list"`,
// `"str"`, `"i32"`, …) — its annotation's `vtKindOfType`, or `"i32"` for a node
// that is not a `Param`.
export function vtKindOfParam(paramIx: i32): VKind {
  const p = P.nodes[paramIx]
  if p is Param { return vtKindOfType(p.parType) }
  "i32"
}

// The second `fbValtype` arg for the parameter node at `paramIx` — its annotation's
// companion slot, through the shared ladder below. The PARAM storage class's name for
// `annValtypeSlotOf`, kept so `emitTypeSection` and the `$fnsig` tokens read a
// param-shaped question; every kind-to-table pairing lives in the one home.
export function paramStructIdxOf(paramIx: i32) {
  const p = P.nodes[paramIx]
  if p is Param {
    return anonLeafParamRowOf(paramIx, annValtypeSlotOf(p.parType))
  }
  -1
}

// D925 — the same answer with the `??` redirect taken in every phase, for the one caller
// asking "what row will the bytes say" (the `$fnsig` interning key, `cloParamTok`): the
// mint is over the moment `collectAnonShapes` returns, well before `anonLeafEmitPhase` flips.
export function paramStructIdxFinal(paramIx: i32) {
  const p = P.nodes[paramIx]
  if p is Param {
    const si = annValtypeSlotOf(p.parType)
    if si < 0 { return si }
    if paramIx < 0 { return si }
    if paramIx >= anonLeafParamMoved.length { return si }
    if anonLeafParamMoved[paramIx] != 1 { return si }
    return anonLeafSupersedeOf(si)
  }
  -1
}

// D891 — the row a `??`-moved parameter's slot selects, once the mint is over:
// `annValtypeSlotOf` resolves `p: {r: i32}` to the narrow field-set row regardless of what
// the merge did with the value reaching it. Gated on the param node's own mark
// (`anonLeafParamMoved`), never on the row, since a merge's narrow row is shared by shape.
function anonLeafParamRowOf(paramIx: i32, si: i32): i32 {
  if !anonLeafEmitPhase { return si }
  if si < 0 { return si }
  if paramIx < 0 { return si }
  if paramIx >= anonLeafParamMoved.length { return si }
  if anonLeafParamMoved[paramIx] != 1 { return si }
  anonLeafSupersedeOf(si)
}

// The one home for "which interned table slot does this type annotation's `fbValtype`
// select" — the companion index every ref-bearing `VKind` needs: `reflist`/`nulreflist`
// read the ref-list table slot, `map`/`nulmap` the map shape (mono ⇒ -1), `variant` the
// union-variant index, everything else `retStructIndex`.
export function annValtypeSlotOf(tyIx: i32) {
  if retRefArrFlag(tyIx) == 1 { return tyAnnRefListSlot(tyIx) }
  // A nullable ref array (kind 18) — its `(ref null $wrapper)` slot is the inner ref-list
  // element wrapper (`tyAnnRefListSlot` is `| null`-aware), mirroring the non-null one above.
  if retNulRefArrFlag(tyIx) == 1 { return tyAnnRefListSlot(tyIx) }
  if retMapFlag(tyIx) == 1 { return mapAnnShape(tyIx) }
  // A nullable map (`{[string]: V} | null`) — the same map shape selects its
  // `(ref null $mapStruct)` cell's heap type (`mapAnnShape` is `| null`-aware).
  if retNulMapFlag(tyIx) == 1 { return mapAnnShape(tyIx) }
  if retVariantFlag(tyIx) == 1 {
    const ptv = P.nodes[tyIx]
    if ptv is TypeRef { return variantIndexOf(ptv.tyName) }
  }
  // `Circle | null` — the variant index under the null, the slot `fbValtype`'s
  // `nulvariant` arm indexes `uVarHeap` with. `retStructIndex` below cannot answer it:
  // a variant has no struct row.
  if retNulVariantFlag(tyIx) == 1 { return nulVariantIndexOf(tyIx) }
  retStructIndex(tyIx)
}

// The `pushVT` `kind` for a module global from its literal INITIALIZER at `initIx`:
// `1` struct ref, `2` list ref, `3` string ref, else `0` i32. The global's valtype must
// match the init's wasm type so the constexpr validates; the literal cases are the only
// ones in scope (a non-literal init fails loudly when `emitExpr` lowers it with `fnIx = -1`).
function globalKind(initIx: i32): VKind {
  if initIx < 0 { return "i32" }
  const e = P.nodes[initIx]
  // A function-literal init (`const add = function(...)...`) — or a bare reference to a
  // top-level function name in value position — is a closure fat-pointer cell (kind 14).
  if e is FuncDecl { return "closure" }
  if e is Ident {
    if fnIndexOfSid(sidOfNode(initIx)) >= 0 { return "closure" }
  }
  // An un-annotated float `.` literal init (`const a = 1.5`) is an f64 cell (kind 11),
  // lowered as `f64.const`. Bare integer globals stay kind 0.
  if e is NumLit {
    if numLexIsFloat(e.numText) { return "f64" }
  }
  if e is ObjLit {
    // A literal matching a standalone struct is that struct ref (kind 1) — even in a
    // union program. Otherwise, in a union program it boxes into the union (kind 4).
    if structIndexOfObj(initIx) >= 0 { return "struct" }
    // The module-global half of D51, the third storage class of a rule the other two
    // already carry: `collectLocals` and `criClassify` both ask this same question for
    // their own storage classes, but a module global asked neither, so `const iv = {r: 7}`
    // beside `type Shape = Circle | Sq` fell to the union box instead of the bare arm.
    if objLitVariantIdxNoStructRow(initIx) >= 0 { return "variant" }
    if uDeclared { return "union" }
    return "struct"
  }
  if e is ArrayLit {
    // A ref-element array literal is a ref list (kind 5); a string-element literal is the
    // string list (kind 7); an f64-element literal is the f64 list (kind 12); an
    // i32/empty literal is the i32 list (kind 2). A module-global empty `[]` over a ref
    // type is out of scope (a global ref-list constexpr needs the binding annotation).
    if arrLitIsRef(initIx) { return "reflist" }
    if arrLitIsStr(initIx, -1) { return "strlist" }
    if arrLitIsF64(initIx, -1) { return "f64list" }
    if arrLitIsI64(initIx, -1) { return "i64list" }
    // An f32-element literal is the f32 list, an arm the earlier ladder lacked. After the
    // f64/i64 arms, so every literal either of them claims keeps its answer.
    if arrLitIsF32(initIx, -1) { return "f32list" }
    return "list"
  }
  if e is StrLit { return "str" }
  // A non-literal initializer (a concat, a function call, a reference to another global):
  // classify via the expression family with no enclosing function (`fnIx = -1`), the same
  // predicates the local `letIs*` ladder uses. A non-literal evaluating to a function
  // value is a closure cell (kind 14), checked first; anything i32-producing stays kind 0.
  if exprIsClosure(initIx, -1) { return "closure" }
  if exprNullableVariant(initIx, -1) { return "nulvariant" }
  if exprNullableStruct(initIx, -1) { return "nulstruct" }
  if exprMap(initIx, -1) { return "map" }
  if exprString(initIx, -1) { return "str" }
  if exprStringArray(initIx, -1) { return "strlist" }
  if exprRefArray(initIx, -1) { return "reflist" }
  if exprF64Array(initIx, -1) { return "f64list" }
  if exprI64Array(initIx, -1) { return "i64list" }
  if exprF32Array(initIx, -1) { return "f32list" }
  // The packed byte list — before `exprArray` below, which would claim any i32-element
  // list and type the cell as the 4-byte wrapper for a one-byte initializer.
  if exprU8Array(initIx, -1) { return "u8list" }
  if exprUnion(initIx, -1) { return "union" }
  // A concrete-variant init (`const r = mk()` returning a union arm) is the raw variant
  // ref (kind 8), the module-scope twin of `buildLocals`' variant slot — before
  // `exprStruct`, which names the standalone struct table a variant has no row in.
  if exprVariantIndex(initIx, -1) >= 0 { return "variant" }
  if exprStruct(initIx, -1) { return "struct" }
  if exprArray(initIx, -1) { return "list" }
  // A scalar f32 non-literal init (f32 arithmetic, an f32-returning call) — kind 13, the
  // module-scope analogue of `letIsF32`. Checked before the f64 arm, mirroring
  // `exprIsF32`'s own dispatch order: `exprIsF64` over-claims a mixed f32/float-literal
  // init (`fv * 1.0` satisfies both), so f32 must go first or the start-fn's `f32.mul` disagrees.
  if exprIsF32(initIx, -1) { return "f32" }
  // A scalar f64/i64 non-literal init (arithmetic, or an f64-returning call) — kind 11/10,
  // the module-scope analogue of `letIsF64`/`letIsI64`. May recurse into another global,
  // terminating for an acyclic program, the same as the `exprString`/`exprStruct` cases above.
  if exprIsF64(initIx, -1) { return "f64" }
  if exprIsI64(initIx, -1) { return "i64" }
  "i32"
}

// Whether the module global `name` has a non-const initializer — used at READ sites
// (`global.get`) to decide whether the (nullable) cell needs a `ref.as_non_null`.
export function globalNameIsNonConst(name: string) {
  globalIsNonConst(globalLetOf(name))
}

// The sid-taking primitive (R5): `emitIdentNode` already holds the identifier's id.
export function globalNameIsNonConstSid(sid: i32) {
  globalIsNonConst(globalLetOfSid(sid))
}

// ── the `globalCellKind` walk memo (D1513) ───────────────────────────────────
// This ladder re-enters itself: a rung asks an `expr*` predicate that reaches a
// referenced global, whose kind comes back through here, so one link in a chain
// multiplies the work instead of adding to it, exhausting the GC heap on a valid program.
let gckHave: i32[] = []
let gckVal: VKind[] = []
let gckDepth = 0
let gckGenTy = -1
let gckGenS = -1
let gckGenSF = -1
let gckGenU = -1
let gckGenV = -1
let gckGenN = -1

// Has any input the ladder reads changed since the columns' last stamp? The arena's
// in-place epoch plus the LENGTH of every append-only collect table a rung consults.
function gckStale() {
  if gckGenTy != tyMutEpoch { return true }
  if gckGenS != sNames.length { return true }
  if gckGenSF != sFieldCount.length { return true }
  if gckGenU != unNames.length { return true }
  if gckGenV != uVariants.length { return true }
  gckGenN != P.nodes.length
}

function gckStamp() {
  gckGenTy = tyMutEpoch
  gckGenS = sNames.length
  gckGenSF = sFieldCount.length
  gckGenU = unNames.length
  gckGenV = uVariants.length
  gckGenN = P.nodes.length
  0
}

export function globalCellKind(letIx: i32): VKind {
  if letIx < 0 { return "i32" }
  // Only the TOP of a walk re-stamps: inside one, the columns are what stops the ladder
  // re-deriving the same global once per rung, which is the exponential.
  if gckDepth == 0 {
    if gckStale() {
      gckHave = []
      gckVal = []
      gckStamp()
    }
  }
  if letIx < gckHave.length {
    if gckHave[letIx] != 0 { return gckVal[letIx] }
  }
  gckDepth = gckDepth + 1
  const k = globalCellKindGo(letIx)
  gckDepth = gckDepth - 1
  while gckHave.length <= letIx {
    gckHave.push(0)
    gckVal.push("i32")
  }
  gckHave[letIx] = 1
  gckVal[letIx] = k
  // A rung that re-parses a spelling MINTS rows, so a walk can move its own generation. Drop
  // the columns at the top when it did: nothing computed under the old one may persist.
  if gckDepth == 0 {
    if gckStale() {
      gckHave = []
      gckVal = []
      gckStamp()
    }
  }
  k
}

// The `fbValtype` kind for a module global's cell. When the binding has a type annotation,
// the kind derives from it via the `letIs*` ladder, so a global agrees with a same-typed
// local/param/field. Only an un-annotated const global falls back to the literal-
// initializer kind (`globalKind`); a non-const un-annotated init rides the ladder too.
function globalCellKindGo(letIx: i32): VKind {
  const d = P.nodes[letIx]
  if d is LetDecl {
    // D1576 — a never-filled `const x = null` at module scope is the `null` type, cell
    // `nullref`. Checked first, outside the annotation split: the binding has no
    // annotation by construction, so the un-annotated arm would read the init as i32.
    if letIsNulNone(letIx, -1) { return "nulnone" }
    if globalHasTypeAnn(letIx) {
      // A NULLABLE-function global (`let g: ((i32) => i32) | null = inc`) is a nullable
      // closure cell (kind 19) — checked BEFORE the bare-function kind 14, mirroring
      // `vtKindOfType` / `fieldTypeCode`: `((i32) => i32) | null` is a nullable function,
      // whereas `(i32) => i32 | null` is a function returning a nullable.
      if nulCloFlagAnn(d.letType) == 1 { return "nulclosure" }
      // A function-typed global (`const g: (i32) => i32 = inc`) is a closure fat-pointer
      // cell (kind 14), like a function-valued local.
      if tyIsFuncType(d.letType) { return "closure" }
      // A `Circle | null` global — the `nulvariant` niche. BEFORE its struct twin for the
      // ladder's usual reason: `letIsNulRef` falls through an annotation it cannot claim
      // to the INITIALIZER, and a nullable-variant-returning call answers there.
      if letIsNulVariant(letIx, -1) { return "nulvariant" }
      if letIsNulRef(letIx, -1) { return "nulstruct" }
      // A nullable ref-array global (`(P | null)[] | null`, `S[] | null`) — kind 18, a
      // `(ref null $rlWrap)` cell over the inner wrapper — before the i32-backed `nullist`.
      // Mirrors the local ladder's `letIsNulRefArray` arm so a global matches a same-typed local.
      if letIsNulRefArray(letIx, -1) { return "nulreflist" }
      if letIsNulList(letIx, -1) { return "nullist" }
      // A DISTINCT-backing nullable scalar list global (`string[]|null`, `f64[]|null`,
      // `i64[]|null`, `f32[]|null`): its own `(ref null $wrapper)` cell — BEFORE the non-null
      // list arms (whose init fallback would else claim a bare list value as a non-null cell).
      const gNulSL = nulScalarListKindOfNode(d.letType)
      if gNulSL != null { return gNulSL }
      // A NULLABLE map global cell (`let g: {[string]: V} | null = …`, kind `nulmap`) — BEFORE
      // `letIsMap` (a nullable annotation/init must not collapse to the non-null `"map"` cell).
      if letIsNulMap(letIx, -1) { return "nulmap" }
      if letIsMap(letIx, -1) { return "map" }
      // A union-annotated global cell is the box ref (kind 4), exactly as `buildLocals`
      // classifies a union local — before the struct/string/scalar-list cases. `S | null` /
      // `boolean | null` never register as union names (they keep their niche kinds above).
      if letIsLitUnion(letIx) { return "i32" }
      // A `K | null` niche global (`const g: K0 | null = "404"`) — the i32 atom cell with
      // the `-1` null sentinel, the nullable twin of the litunion arm above. Before
      // `letIsString`, whose init fallback would else claim the niche as a string-ref cell.
      if nodeTyIsNulLitUnion(d.letType) { return "i32" }
      // A concrete union-variant global (`const g: Cat = {…}`), kind 8 — the bare variant
      // struct ref. Before `letIsUnion`/`letIsStruct`, mirroring `buildLocals`' own
      // `letIsVariant` rung: a variant name is neither the union box nor a standalone
      // struct, since `collectS` keeps a variant's `TypeDecl` out of the struct table.
      if letAnnVariantIdx(letIx) >= 0 { return "variant" }
      if letIsUnion(letIx, -1) { return "union" }
      if letIsStringArray(letIx, -1) { return "strlist" }
      if letIsRefArray(letIx, -1) { return "reflist" }
      if letIsU8Array(letIx, -1) { return "u8list" }
      if letIsF32Array(letIx, -1) { return "f32list" }
      if letIsF64Array(letIx, -1) { return "f64list" }
      if letIsI64Array(letIx, -1) { return "i64list" }
      if letIsStruct(letIx, -1) { return "struct" }
      if letIsArray(letIx, -1) { return "list" }
      if letIsNulString(letIx, -1) { return "nulstr" }
      if letIsString(letIx, -1) { return "str" }
      if letIsI64(letIx, -1) { return "i64" }
      if letIsF64(letIx, -1) { return "f64" }
      if letIsF32(letIx) { return "f32" }
      return "i32"
    }
    // No annotation: a const literal init types itself; a non-const un-annotated init is
    // out of scope (no annotation to derive from) and `globalKind` returns its best guess.
    // An empty `[]` whose PUSHES infer a string element is the string list (kind 7).
    if letInfStrListByUse(letIx) { return "strlist" }
    // The two nullable cells the un-annotated arm lacked: `const g = mk()` with a
    // `((i32) => i32) | null` / `i32[] | null` return fell through to `globalKind`'s
    // `"closure"`/`"i32"` guess, disagreeing with the value the start fn actually stores.
    // The read sides need no separate widening — `exprNulClosure` and `globalIsNulList` already ask this ladder.
    if letInfersNulClosure(letIx, -1) { return "nulclosure" }
    // A bare map read (`const g = m[k]`) at module scope — mirrors the local ladder's
    // `letNulMapReadValKind` arm (D1040) so a global agrees with a same-typed local's cell
    // kind. Before `nullist` and the scalar-list arms below, exactly as the local ladder
    // orders them: this answers the value's nullable kind for every mv value rep at once.
    const gMapRead = letNulMapReadValKind(letIx, -1)
    if gMapRead != null { return gMapRead }
    // D1106 — the kind-18 cell the un-annotated arm lacked: `const r = mk()` with `mk():
    // S[] | null` fell through to `globalKind`'s i32 guess, so a later `r != null` compare
    // had no rep to test against. Before `nullist`, exactly as the annotated ladder orders
    // the two disjoint arms.
    if letIsNulRefArray(letIx, -1) { return "nulreflist" }
    if letIsNulListInfer(letIx, -1) { return "nullist" }
    // A distinct-backing nullable scalar list bound to a call (`const r = mk()`): its own
    // `(ref null $wrapper)` cell, resolved through the binding (`letNulScalarListKind`)
    // since there's no annotation node to read. Before the nulmap/union arms and the literal fallback.
    const gNulSLU = letNulScalarListKind(letIx, -1)
    if gNulSLU != null { return gNulSLU }
    // An un-annotated global bound to a `{[string]: V} | null`-returning call carries the
    // `nulmap` cell as a local would — before the union arm (a nullable map is a niche,
    // not the box) and the literal-init fallback, whose i32 guess would else conflict.
    if letIsNulMap(letIx, -1) { return "nulmap" }
    // An un-annotated global whose init PRODUCES a union (`const a = make(42)` with
    // a union-returning `make`) carries the box (kind 4), as a local would.
    if letIsUnion(letIx, -1) { return "union" }
    // An un-annotated global bound to a `string | null`-returning call (`const r = f()`)
    // carries the kind-16 nullable-string cell, as a local would.
    if letIsNulString(letIx, -1) { return "nulstr" }
    return globalKind(d.letInit)
  }
  "i32"
}

// The struct table index for a global cell of kind 1 (struct ref), else -1. When the
// binding has a struct ANNOTATION the index comes from THAT annotation (`structIndexOfLet`,
// which prefers the annotation over the init) — so a struct global agrees with a same-
// typed local/param/field. An un-annotated const struct global infers from its literal.
export function globalCellStructIdx(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if globalHasTypeAnn(letIx) {
      // The annotated twin of the variant leg below: a kind-8 slot IS the variant index,
      // named directly by the annotation. Before `structIndexOfLet`, which answers -1 for
      // a variant by construction (the struct table doesn't hold one).
      const avi = letAnnVariantIdx(letIx)
      if avi >= 0 { return avi }
      return globalNulRefSupersede(letIx, structIndexOfLet(letIx, -1))
    }
    // A kind-8 VARIANT cell's slot is the VARIANT index, not a struct row — paired with
    // `globalKind`'s variant arm, which decides the kind this slot is read beside.
    const gvi = exprVariantIndex(d.letInit, -1)
    if gvi >= 0 { return gvi }
    // The object-literal leg of the same pairing (D244): the rung above carries no
    // object-literal field-set arm by design, so `globalKind`'s `variant` arm and this slot
    // must read the same helper (`objLitVariantIdxNoStructRow`) or they'd disagree.
    const govi = letObjLitVariantIdx(letIx)
    if govi >= 0 { return govi }
    // The UN-ANNOTATED nullable-variant cell (`const c = h(true)` where `h` returns
    // `Circle | null`) — its slot comes from the callee's return, the same place its
    // KIND does.
    const gnvi = nulVariantIdxOfExpr(d.letInit, -1)
    if gnvi >= 0 { return gnvi }
    // Not redirected, for `nulRefStructIdxOfLet`'s reason: an un-annotated nullable-struct
    // global takes its row from the callee's return, which no `??` family can supersede.
    return structIndexOfExpr(d.letInit, -1)
  }
  -1
}

// D842 — the module-scope twin of `nulRefStructIdxOfLet`'s redirect, gated on the cell
// kind since this resolver serves three of them: a `??` merge supersedes the row a
// nullable-struct cell holds, never a plain `const x: R = {…}` global's own layout.
function globalNulRefSupersede(letIx: i32, si: i32): i32 {
  if si < 0 { return si }
  if globalCellKind(letIx) != "nulstruct" { return si }
  anonLeafSupersedeOf(si)
}

// The ref-list table slot for a kind-5 (ref array) global cell: the annotation's element
// type when present, else the element type inferred from the initializer, so two
// un-annotated ref-list globals of distinct element types each declare their own wrapper
// instead of both declaring the first's. 0 (slot fallback) if unresolvable.
export function globalRefListSlot(letIx: i32) {
  const s = letRefListSlot(letIx, -1)
  if s < 0 { return 0 }
  s
}

// True if the type-name `name` refers to one of the declared struct types.
export function isSName(name: string) { structIndexByName(name) >= 0 }

// "Is this type a registered struct", asked of the arena — the struct companion to
// `isUnionOfTy`. Structural here, unlike unions, needing no declared/inline split: the
// intern layer already dedupes an inline shape onto a declared struct at intern time, so
// `tySame` is the right comparison for every row. The index rung runs first as the cheap one.
export function isStructOfTy(ty: i32): boolean {
  if ty < 0 { return false }
  let s = 0
  while s < sTyIx.length {
    if sTyIx[s] == ty { return true }
    s = s + 1
  }
  let q = 0
  while q < sTyIx.length {
    if tySame(sTyIx[q], ty) { return true }
    q = q + 1
  }
  false
}

// The ref-array shape ladder — the one home of the arms `nameIsRefArray` and
// `refArrElemKind` each carried as their own hand-copy (D-REFARRKIND). Returns the
// ref-list element kind a name's shape decides, or -1 when no shape arm claims it — the
// caller's own base arm then answers. The paren-grouped niche arms are resolved once here.
function refArrShapeKind(name: string): i32 {
  // `i32[][]`, `boolean[][]`, and literal-union `K[][]` all carry the i32-list wrapper element
  // (kind 4) — one i32[] backing (`nameIsI32ListArray`), not three special cases.
  if nameIsI32ListArray(name) { return 4 }
  // Nested lists of a NON-i32 scalar/string element — the element is that inner list's
  // WRAPPER (kinds 6/7/8 → `mkListIdx` / `fl64TypeIdx` / `il64TypeIdx`). Used for a
  // string[]/f64[]/i64[]-VALUED map's vals ref-list (the value analogue of `i32[][]` kind 4).
  if nameIsArray(name) && nameIsStringArray(arrElemNameRaw(name)) {
    // `string[][]` AND the niche `(string | null)[][]`: the element is the string-list
    // wrapper (`$mkListIdx`) either way — the nullable rides INSIDE the inner elements.
    return 6
  }
  // The three non-i32 scalar leaves, asked the way the `string[][]` arm above already
  // does: the array grammar's one cut (`arrElemNameRaw`), then each inner list named by
  // the leaf's own spelling-exact home (`nameIsF64Array` is `arrElemNameRaw(n) == "f64"`).
  // `arrElemIsArrayOf` reads the inner `[]` and leaf span in place, without cutting first.
  if arrElemIsArrayOf(name, "f64") { return 7 }
  if arrElemIsArrayOf(name, "i64") { return 8 }
  if arrElemIsArrayOf(name, "f32") {
    return 10 // f32 inner list (element is the `$fl32TypeIdx` wrapper)
  }
  // The packed byte leaf — `u8[][]`, whose element is the `$bl8TypeIdx` wrapper (D1241).
  // The fifth distinct-backing leaf; without it `nameIsRefArray` refused the declaration.
  if arrElemIsArrayOf(name, "u8") { return 11 }
  // A nested ref array (`S[][]`, `(C|D)[][]`, `((i32)=>i32)[][]`, `S[][][]`, …): the
  // element is itself a ref array, stored as the inner list's wrapper — kind 9. Recurses
  // to any depth via the interned inner slots.
  if nameIsArray(name) && nameIsRefArray(refArrElemName(name)) { return 9 }
  if nameIsMapArray(name) { return 3 }
  // The paren-grouped element, resolved once: five former arms each re-derived the same
  // `(…)[]` union element and its `| null` part separately; one lookup gates all of them,
  // in the exact order `refArrElemKind` tested them.
  const pun = parenUnionArrElemName(name)
  if pun != "" {
    const nn = nullablePartOf(pun)
    if nn != "" {
      // A `(P | null)[]` nullable-struct array is a STRUCT ref list (kind 1) — its element is a
      // `(ref null $P)` niche, not a union box. Checked before the value-union fall-through.
      if structIndexByName(nn) >= 0 { return 1 }
      // The same niche where `P` is a union arm (D771): `collectS` withholds an `sNames`
      // row from a union member, so the rung above misses `(Circle | null)[]` and would
      // otherwise fall to the kind-2 union box, which has no rep for a niche nullable. An
      // arm and its declared layout twin share one heap since D280, so no new rep is needed.
      if variantIndexOf(nn) >= 0 { return 1 }
      // A `({[string]: V} | null)[]` nullable-map array is a map ref list (kind 3) — the
      // same `(ref null $mapStruct)` backing the non-null element uses; the slot key keeps
      // the `| null` so the index read stays nullable for the `e != null` narrow.
      if nameIsBareMap(nn) { return 3 }
      // A `(i32[] | null)[]` nullable-list array reuses the inner list's own rep — kind 4
      // for an i32-backed inner, 6/7/8/10 for a distinct-backing scalar/string inner, 9 for
      // a ref inner — a `(ref null $wrapper)` niche, not a union box. The kind-set gate
      // below is expected unreachable but kept, since an unproven removal is a behavior risk.
      if nameIsArray(nn) {
        const ik = refArrElemKind(nn + "[]")
        if (
          ik == 4 ||
          ik == 6 ||
          ik == 7 ||
          ik == 8 ||
          ik == 9 ||
          ik == 10 ||
          ik == 11
        ) {
          return ik
        }
      }
      // A `(((i32) => boolean) | null)[]` nullable-closure array is a closure ref list
      // (kind 5) — a `(ref null $cloStruct)` niche, not a union box.
      if nameIsFuncTypeAtom(nn) { return 5 }
    }
    // A `(string|i32)[]` value-union element list is a union-box list (kind 2).
    return 2
  }
  // An `((i32) => i32)[]` array of functions is a closure-element list (kind 5).
  if nameIsClosureArray(name) { return 5 }
  -1
}

// The struct-table index for a ref-list element name, stripping a `| null` niche suffix
// first (a nullable-struct array's slot keys on the full `"P | null"`, but the struct it
// stores/reads is the bare `P`). Nominal first (`structIndexByName`), then the structural
// bridge (`structIndexOfTypeName`) for an inline-shape element deduped onto its declared twin.
export function structIdxOfElemName(name: string) {
  const n = nonNulBaseOf(name)
  // Nominal exact-name match first: unambiguous, cheap, and it moves no bytes.
  const sbn = structIndexByName(n)
  if sbn >= 0 { return sbn }
  // The same nominal floor `rlElemStructRow` carries, at the second copy of this ladder
  // (D63): a registered union variant that isn't also a registered plain struct has no
  // struct-table row (its heap is `uVarHeap[vi]`), so every structural rung below must
  // decline rather than bridge the arm's shape onto a standalone struct row (D32, D36/D38).
  if variantIndexOf(n) >= 0 { return -1 }
  // Consults the canon-key vocabulary (`repRowOfName` → `resolveAnnot` → `repRowOfTyStruct`)
  // rather than the lenient fieldset scan, since it distinguishes a same-fieldset nested
  // twin (`{f: {f: i64 | null}}` vs its inner row) by the full nested field type. After the
  // nominal consult, before the fieldset scan: trust the arena where it covers the element.
  const rr = repRowOfName(n, sScanLim())
  if rr >= 0 { return rr }
  structIndexOfTypeName(n)
}

// The struct-table index an inline-SHAPE element spelling (`{v:i32}` of a `{v:i32}[]`
// annotation) resolves to — the arena's canonical-key answer, else the structural bridge
// (`structIndexOfTypeName`) — or -1 when nothing resolves. Ungated since #2004: an inline
// spelling may resolve to an anonymous-literal row, not only a declared struct.
function shapeElemDeclaredStructIdx(base: string) {
  if !nameIsShapeOpen(base) { return -1 }
  // Node-less caller: `base` is an inline shape `{…}` element spelling, routed through the
  // canonical-key vocabulary (`repRowOfName` → `resolveAnnot` → `repRowOfTyStruct`) rather
  // than the lenient fieldset scan, since it distinguishes a same-fieldset nested twin by
  // the full nested field type. Falls to the fieldset scan when the arena declines.
  let si = repRowOfName(base, sScanLim())
  if si < 0 { si = structIndexOfTypeName(base) }
  if si < 0 { return -1 }
  // `sRowDecl` answers "is this row's name a declared type" (unions included), not "is
  // this a declared struct" — a distinct question this resolver does not reuse it for.
  si
}

// True if the array type-name `name` is a REF-element list — `S[]` over a declared
// struct, `N[]` over the declared union alias (the box-ref element), or `{[string]:i32}[]`
// (a map-struct element). Lowers to the `{ backing: (ref $raTypeIdx), len, cap }` wrapper
// over a `(ref null $elem)` backing (G7-ref). A non-`[]` name or an `i32[]` is not a ref array.
export function nameIsRefArray(name: string) {
  // A top-level arrow is a function type (`(i32) => S[]`), never a ref array, even though
  // it ends in `[]` — guarded first so a closure-returning-array is classified as the
  // closure fat-pointer. (The nested-arrow array-of-closures case reaches `nameIsClosureArray` below.)
  if annArrowAt(name) >= 0 { return false }
  // A literal-union array (`K[]`) is an i32 atom array, not a ref list — excluded before
  // the union-name match below, which would otherwise mis-claim it as a union-box array.
  if nameIsLitUnionArray(name) { return false }
  // Every shape-decided arm — the i32/string/scalar 2D leaves, the nested-ref recursion,
  // the map list, the paren-grouped element arms and the closure list — is
  // `refArrShapeKind` (D-REFARRKIND). This entry point only needs "did any arm claim it",
  // discarding the kind, so a second hand-written copy of that ladder is not needed.
  if refArrShapeKind(name) >= 0 { return true }
  // Otherwise a `<Struct>[]` / `<Union>[]`: strip the trailing `[]` once and match the bare
  // element name against the struct/union tables, avoiding a fresh per-struct allocation
  // (the old form compared `name` to `sNames[i] + "[]"` for every struct, every call).
  if nameIsElemArray(name) {
    const base = arrElemNameRaw(name)
    // A multi-atom element spelling isn't an element at all — it's the tail of a union
    // whose last arm happens to be an array (`string[] | i32[]`), so the whole name ends
    // in `]`. Without excluding it, the `unNames` scan below matched the shorter union
    // (`string[] | i32[]` cut to `string[] | i32`), interning a reflist slot with a union-box element.
    if unionMemberCount(base) >= 2 { return false }
    if structIndexByName(base) >= 0 { return true }
    // An inline-shape element (`{v:i32}[]`) whose shape deduped onto an interned row at
    // intern time: the structural bridge resolves it, the shape-vs-declared twin of `S[]`.
    if shapeElemDeclaredStructIdx(base) >= 0 { return true }
    // A `Cat[]` over a concrete union VARIANT — a ref list of bare variant structs.
    if variantIndexOf(base) >= 0 { return true }
    // The same arm, reached by its structural render (D762): a value-call parameter type
    // is rendered by canon, which expands the arm's own field types, so `Circle = {r:
    // Shape2}` arrives as `{r:{c2:i32}|{s2:i32}}`, claimed by neither the nominal rung nor
    // the struct bridge. `variantIndexOfTypeName` is the same resolver `objVariantName` uses.
    if variantIndexOfOwnRender(base) >= 0 { return true }
    let u = 0
    while u < unNames.length {
      if base == unNames[u] { return true }
      u = u + 1
    }
  }
  false
}

// Intern the ref-list slot whose element type is `elemName`, recursively interning a
// nested inner list's element slot first — so the inner wrapper lands at a lower type
// index and the outer element heap (kind 9) resolves to it. The DRY core that makes
// arbitrary `X[]…[]` nesting of any ref leaf fall out, bottoming out at the leaf array.
export function ensureRefElem(elemName: string) {
  ensureRefElemTy(elemName, -1)
}

// `ensureRefElem` with the caller's recorded arena type for `elemName` (D-REPELEMTY),
// threaded to `rlInternNameTy` for the slot key only — classification still reads the
// spelling, and the intern still mints on a miss. `ty` -1 = no hint; the k==9 recursion
// stays unhinted, since the arm re-forms a name that can disagree with the arena.
export function ensureRefElemTy(elemName: string, ty: i32) {
  if elemName == "" { return -1 }
  const k = refArrElemKind(refElemArrName(elemName))
  if k == 9 {
    // The nested recursion carries the row down: when this function's own element is
    // itself a ref array (kind 9), its inner element is `ty`'s own `aElem`, so the inner
    // intern needs no re-resolution of the spelling this line cuts.
    const inm = refArrElemName(elemName)
    let inner = -1
    if ty >= 0 {
      const it = T.tys[ty]
      if it is TyArray { inner = it.aElem }
    }
    if elemNameIsNominal(inm) { inner = -1 }
    ensureRefElemTy(inm, inner)
  }
  ensureRefElemKindTail(elemName, k, ty)
}

// `refElemArrName` re-forms an element name as its array name (`<elem>[]`) for
// `refArrElemKind` — one producer, no allow-list. `nulStructElemNiche` asks whether `nn`
// is the niche kind-1 covers (a declared struct or union variant, one heap since D280),
// reusing that ladder's exact rungs and order so the two can never disagree (D1340).
function nulStructElemNiche(nn: string): boolean {
  if structIndexByName(nn) >= 0 { return true }
  variantIndexOf(nn) >= 0
}

export function refElemArrName(elemName: string): string {
  // Re-forms `elemName` as its array name for `refArrElemKind` to read the kind. A
  // nullable-list, closure, or map element needs its grouping parens restored
  // (`(elem)[]`), matching every niche kind `refArrShapeKind` recognizes; a value-union
  // element has no niche and stays ungrouped so the union-box arm handles it directly.
  let arrName = elemName + "[]"
  const enp = nullablePartOf(elemName)
  if (
    enp != "" &&
    (nameIsArray(enp) ||
      nameIsFuncTypeAtom(enp) ||
      nameIsBareMap(enp) ||
      nulStructElemNiche(enp))
  ) {
    // A nullable-list, nullable-closure, or nullable-map element needs its grouping
    // parens restored here to read as its niche kind.
    arrName = "(" + elemName + ")[]"
  } else if (
    parenUnionArrElemName("(" + elemName + ")[]") != "" &&
    (isValueUnionName(elemName) || nullablePartOf(elemName) == "")
  ) {
    // A value-union element needs its grouping parens restored, or `refArrElemKind`
    // mis-splits it as a struct element and an unboxed value lands in a ref slot; a
    // niche-nullable-scalar element (`string | null`) has no union-box rep, so it stays
    // ungrouped to keep its kind-1 reject.

    arrName = "(" + elemName + ")[]"
  }
  arrName
}

// The flag-setting and intern half of `ensureRefElemTy`, run after the kind is known and
// any kind-9 recursion has finished — split out so the literal side (`collectA`) can reach
// it with the kind its own classifier already chose, rather than re-deriving one.
function ensureRefElemKindTail(elemName: string, k: i32, ty: i32) {
  // A map element (kind 3): forces the map heap types and interns the element map's value
  // slot, so a typed-value map in any composition position resolves the same per-value map
  // struct a standalone `{[string]: V}` binding does. A mono or atom value interns nothing,
  // riding the shared mono `$mapStruct`.
  if k == 3 {
    mUsed = true
    lUsed = true
    aUsed = true
    // A nullable map element strips to its inner map for the value intern — the slot
    // shares the map struct and mv slot with the non-null element.
    let mve = elemName
    const nme = nulMapInnerName(elemName)
    if nme != "" { mve = nme }
    mvShapeOfMapName(mve)
    // The one home that also sets `mI32Used` for an i32-keyed map reached only through a
    // map-typed ref-list element — every other map-forcing site sets `mUsed`/`lUsed`/`aUsed`
    // alone. Without it the key temporary aliases the map-ref temporary at the same local
    // index: `vl check` rc 0, `expected (ref $type), found i32`.
    if nameIsI32KeyedMap(mve) { mI32Used = true }
  }
  // Forces the leaf list-type wrapper flags for a scalar inner-list element, so its singleton
  // wrapper is allocated. A ref inner list (kind 9) forces these in the recursion above; a
  // struct, union, or closure element (kind 1/2/5) needs none. Shared by both the array path
  // and the map-value path.
  if k == 4 {
    lUsed = true
    aUsed = true
  } else if k == 6 {
    slUsed = true
    aUsed = true
  } else if k == 7 {
    fa64Used = true
  } else if k == 8 {
    ia64Used = true
  } else if k == 10 {
    fa32Used = true
  } else if k == 11 {
    ba8Used = true
  }
  rlInternNameTy(elemName, k, ty)
}

export function refArrElemKind(name: string) {
  // Every shape-decided arm is `refArrShapeKind`, tested in the same order —
  // `nameIsRefArray` carries a second hand-written copy of this ladder.
  const sk = refArrShapeKind(name)
  if sk >= 0 { return sk }
  // The base arm, where this entry point and `nameIsRefArray` genuinely differ: a
  // `<Union>[]` element list is kind 2 (strip `[]` once, match the bare union name);
  // anything else — struct, inline-shape, or variant array — is kind 1. No struct-table
  // consult needed here, unlike `nameIsRefArray`'s four.
  if nameIsElemArray(name) {
    const base = arrElemNameRaw(name)
    let u = 0
    while u < unNames.length {
      if base == unNames[u] { return 2 }
      u = u + 1
    }
  }
  1
}

// Forces the wrapper/backing flags a scalar-list field storage code needs, since a
// field-only program never builds a `u8[]`/`f64[]`/etc list literal elsewhere.
export function forceScalarListField(code: i32) {
  if code == 35 { ba8Used = true }
  if code == 25 { fa64Used = true }
  if code == 26 { ia64Used = true }
  if code == 27 { fa32Used = true }
  // The nullable twins (codes 32/33/34) ride the same leaf wrapper as their non-null
  // counterparts. A field that only ever holds `null` never builds a list literal, so
  // without this the field's `(ref null $wrapper)` storage type would reference an
  // unallocated index. Code 31's `string[] | null` pair is forced beside the code-6 string list instead.
  if code == 32 { fa64Used = true }
  if code == 33 { ia64Used = true }
  if code == 34 { fa32Used = true }
  0
}

// The scalar-list pair a rep name (not a spelling) asks for — the one home of that mapping,
// so a new element kind is added once rather than at each caller. `"i32"`/`""` mint
// nothing, since every list-forcing arm already sets the i32 pair by default. Needed for an
// empty-list literal whose element the checker pinned to a non-i32 scalar spelled nowhere else (D1569).
export function forceScalarListRep(rep: string) {
  if rep == "f64" {
    fa64Used = true
  } else if rep == "i64" {
    ia64Used = true
  } else if rep == "f32" {
    fa32Used = true
  } else if rep == "u8" {
    ba8Used = true
  } else if rep == "string" {
    slUsed = true
    aUsed = true
  } else if rep == "i32" {
    // Exhaustive over `PrimName` from here down: `i32`/`boolean` ride the default i32
    // pair, and `void`/`null`/`never` are not element reps, so each mints nothing rather
    // than falling through by accident. `""` (no recorded element, or a ref one) is not a
    // `PrimName` and falls past — the ref element kinds are `collectA`'s business.
    0
  } else if rep == "boolean" {
    0
  } else if rep == "void" {
    0
  } else if rep == "null" {
    0
  } else if rep == "never" {
    0
  }
  0
}

// The type under `name`'s `| null` wrapper, or `name` unchanged when it carries none.
// `nullablePartOf` answers "" for no; this is the answer-or-the-original fold every
// caller that means to look through nullability wants, rather than branch on it.
export function nonNulBaseOf(name: string) {
  const nb = nullablePartOf(name)
  if nb != "" { return nb }
  name
}

// True if `name` is a nullable ref-list (`S[] | null`, `(i32|null)[] | null`), the ref-list
// analogue of `nameIsNulI32List`; its non-null part is a ref array. Not `i32[] | null`,
// which is code 18 / kind 15.
export function nameIsNulRefList(name: string) {
  const np = nullablePartOf(name)
  if np == "" { return false }
  return nameIsRefArray(np)
}

// The field-type spellings whose rep is deferred by design, as against the far larger set
// `fieldCodeOfSpelling` refuses because it cannot yet tell what they are. A "not interned
// yet" spelling is pass-order and a caller mid-cascade must stay silent on it; a deferred
// spelling is permanent, refused loudly, and any new one belongs in this one set.
function fieldTypeIsDeferred(t: string): boolean { nameIsU8Array(t) }

// The per-field wasm-type code a field type spelling carries — the one home of the
// field-code ladder, shared by `fieldTypeCode` and `nameFieldCode`; both reps of a field
// must agree arm for arm and in order. `litNode` is an AST node when the caller has one
// (decided from the checker's recorded type) or -1 when only the spelling is available.
function fieldCodeOfSpelling(t: string, litNode: i32) {
  if t == "i32" { return 0 }
  if t == "boolean" { return 0 }
  // An f64 field (`x: f64`) stores a raw f64 valtype slot — code 17. An i64 / f32 field is
  // the same idea in the other scalar valtypes — codes 23 / 24 (0x7e / 0x7d storage).
  if t == "f64" { return 17 }
  if t == "i64" { return 23 }
  if t == "f32" { return 24 }
  // A literal-union field stores an interned i32 atom (code 0), not a box. Checked before
  // the union tests, since a literal union also registers as a union name that would
  // otherwise claim it as code 16. The union name is recorded in `sFieldElemName` so
  // construction, read, and assign recover the atom's membership.
  if litNode >= 0 {
    if nodeTyIsLitUnionAlias(litNode) { return 0 }
    // An inline literal-union array field is the i32 atom list, code 4 — the same code the
    // `K[]` alias gets. Its spelling cannot say so: `canonEmitName` softens it to
    // `"string[]"`, which the array arm below would code 6, while every element path builds
    // atom ids. Decided structurally off the recorded type, ahead of the softened name.
    if tyIsLitUnionArray(nodeTyIxOf(litNode)) { return 4 }
    // The `| null` twin: `("a"|"b")[] | null` is the nullable i32 atom list, code 18 — the
    // same code its `K[] | null` alias gets. Same softening blindness: the
    // nullable-scalar-list arm below would code it 31 while the object literal stores the
    // atom wrapper. Asked of the rep (`repOfNullable`) rather than re-derived from the softened type.
    if annRepKindOf(litNode) == "nullist" { return 18 }
    // The nullable-ELEMENT twin, which folds onto the SAME code 4: `nameIsI32Array` admits
    // `(K | null)[]` into the i32 backing (one `$lTypeIdx` wrapper for the whole atom-niche
    // family), so the alias spelling already codes 4 here and the inline one must too.
    if annIsNulLitUnionArray(litNode) { return 4 }
  } else {
    // An inline member set is the string slot; a registered alias is the atom — the split
    // the node path makes with `nodeTyIsLitUnionAlias`, which this name-only path lacks.
    // Without it an inline-shape annotation of the identical field coded 0, so passing a
    // declared struct to that parameter produced check-clean invalid wasm.
    if nameIsInlineLitUnion(t) { return 3 }
    if nameIsLitUnionType(t) { return 0 }
  }
  // The arena where a node came with the spelling, the name where none did: `fieldTypeCode`
  // passes the field's annotation node, `nameFieldCode` has none and passes -1 (a deliberate
  // absence, not a lost type). `canonTyIxOf` is read where canon rewrote the node, so a
  // literal-union field softened to `string` still resolves through its own lowering.
  if litNode >= 0 {
    let fsTy = nodeTyIxOf(litNode)
    if canonRewroteNode(litNode) { fsTy = canonTyIxOf(litNode) }
    if tyScalarBaseIs(fsTy, "string") { return 3 }
  } else if nameIsString(t) {
    return 3
  }
  if nameIsArray(t) {
    // The scalar-element backings, in `scalarListKindOfName`'s order: `string[]` is code 6,
    // a scalar list stores its own wrapper (25/26/27), never code 5 (struct/union/closure
    // only). `u8[]` gets its own code 35 rather than a sixth `scalarListKindOfName` entry,
    // which would misread silently until each of its four readers grew a matching arm (D1008).
    if nameIsU8Array(t) { return 35 }
    const sk = scalarListKindOfName(t)
    if sk == 0 { return 4 }
    if sk == 1 { return 6 }
    if sk == 2 { return 25 }
    if sk == 3 { return 26 }
    if sk == 4 { return 27 }
    return 5
  }
  // A map-typed field stores a non-null ref to its value type's map struct, code 19. The mv
  // slot is interned by `collectA`'s arena scan of the annotation node, so emission re-finds
  // it by the value name. A map-member union field (`{[string]: string} | string`) starts
  // with `{[` too, but `!nameIsMapMemberUnion` routes it to the union test (code 16) instead.
  if nameIsBareMap(t) { return 19 }
  // A nullable map field stores a nullable ref to the value type's map struct, code 29 — the
  // field analogue of the `nulmap` local/param/return niche. Gated to the same supported
  // value kinds as the non-null map field, so a nullable map over an unrepresentable value
  // type keeps failing loudly (-1, no interned shape).
  const nmi = nulMapInnerName(t)
  if nmi != "" {
    if mapValKindLowerable(nmi) { return 29 }
  }
  // A NULLABLE i32-list field (`rest: i32[] | null`) stores a NULLABLE ref to
  // the same wrapper as code 4 — code 18 (`0x63 lTypeIdx`). Checked before the
  // value-union test (`i32[]` is not a value atom, so 16 never claims it).
  if nameIsNulI32List(t) { return 18 }
  if nameIsNulRefList(t) { return 28 }
  // A nullable distinct-backing scalar-list field (`f64[] | null` 32, `i64[] | null` 33,
  // `f32[] | null` 34, `string[] | null` 31): a `(ref null $leafWrapper)` slot, the field
  // mirror of the same-named binding niche. Checked after the ref-list arm so a spelling
  // it already claims (`(string|null)[] | null`) keeps code 28's rep.
  const nsl = nulScalarListFieldCode(t)
  if nsl >= 0 { return nsl }
  // A `string | null` niche field — `(ref null $sTypeIdx)`, code 20. Checked before
  // the value-union test (it is NOT a value union — a single ref + null is a niche).
  if nameIsNulString(t) { return 20 }
  // A `boolean | null` niche field — i32 sentinel, code 21.
  if nameIsNulBool(t) { return 21 }
  // A `K | null` nullable-litunion niche field — the i32 atom slot with the spare
  // value `-1` = `null` (member ids are interned ≥ 0), code 30. The field analogue
  // of the kind-0 `K | null` binding niche; checked before the value-union test
  // (a single atom set + null is a niche, not a box).
  if nameIsNulLitUnion(t) { return 30 }
  // A box-union field — a value union or a registered struct/heterogeneous union — stores
  // the shared union box ref, code 16. Checked before the nullable-struct strip, so a
  // declared `type Opt = { v: i32 | null }` carries the same rep as the inline
  // `{v:i32|null}` annotation.
  if isValueUnionName(t) { return 16 }
  if isUName(t) { return 16 }
  // A field naming another struct, or a nullable struct, stores a `(ref null $S)`, code 15.
  // Resolved via the declaration scan rather than the incrementally-built struct table, so a
  // forward or mutually-recursive reference ties into the shared rec group.
  const base = nonNulBaseOf(t)
  if nameIsStructDecl(base) { return 15 }
  // A field typed as a union ARM (`g: Circle` / `g: Circle | null`) — the same code-15
  // `(ref null $S)` slot, over the struct row whose heap the arm shares (D761). Placed on the
  // ONE spelling ladder all three refusal sites reach, so the declared, the inline-shape and
  // the generic-instance spellings of one field cannot answer differently.
  if armFieldStructRow(base) >= 0 { return 15 }
  // The same field one phase earlier (D1518): a field on a declaration that is itself a
  // union arm is coded from `collectU`, before the struct table exists, so the rung above
  // declines. This predicate says the mint will answer, and `collectNestedFieldShapes` is
  // what owes it.
  if armFieldDeferredRowOk(base) { return 15 }
  // D1293 — the arena, once every name arm has declined. `nameIsNulRefList` resolves
  // through the struct/union tables, and `collectU` runs before `collectS` builds them, so
  // an `S[] | null` variant-arm field coded -1 while the identical field on a plain struct
  // coded 28. Last, so no spelling a name arm already answers can move.
  nulRefListFieldCodeOfNode(litNode)
}

// The `S[] | null` FIELD code (28) the ARENA decides, or -1. Ref-ELEMENT lists only: that is
// the one nullable-list code whose name test needs a table, and every other element kind is
// already decided by a spelling that carries its own answer (D1293).
function nulRefListFieldCodeOfNode(litNode: i32): i32 {
  if litNode < 0 { return -1 }
  let ty = nodeTyIxOf(litNode)
  if canonRewroteNode(litNode) { ty = canonTyIxOf(litNode) }
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable {
    const inner = t.nInner
    if inner < 0 { return -1 }
    // A LITERAL-union element list is the i32 ATOM backing (code 18), never a ref list —
    // the same subtraction `fieldCodeOfTy`'s array arm makes.
    if tyIsLitUnionArray(inner) { return -1 }
    const it = T.tys[inner]
    if it is TyArray {
      const e = it.aElem
      if e < 0 { return -1 }
      const et = T.tys[e]
      if et is TyObj { return 28 }
      if et is TyUnion { return 28 }
      if et is TyFunc { return 28 }
      if et is TyArray { return 28 }
      if et is TyMap { return 28 }
      // Every other `Ty` is deliberately not code 28: that backing is owed only by an
      // element that is itself a reference. `TyPrim`, `TyLit`, `TyVar`, `TyErr`, and a
      // nested `TyNullable` element carry no ref backing, so they fall to -1, which every
      // caller reads as "not mine".
    }
  }
  -1
}

// The struct-table row a field annotation's base type occupies — canon-routed, `| null`
// peeled, and checked through both `structIndexOfTy` (exact arena index, finds a declared
// struct) and `repRowOfTyStruct` (structural, finds an inline shape) since neither alone
// covers what the name path does. -1 means "I do not know", never "no row" — callers fall back to the name.
function fieldBaseStructRow(tyIx: i32) {
  let ty = nodeTyIxOf(tyIx)
  if canonRewroteNode(tyIx) { ty = canonTyIxOf(tyIx) }
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  let base = ty
  if t is TyNullable { base = t.nInner }
  if base < 0 { return -1 }
  const ex = structIndexOfTy(base)
  if ex >= 0 { return ex }
  repRowOfTyStruct(base, sScanLim())
}

// The per-field wasm-type code for a struct or union-variant field whose type node is
// `tyIx`. Extends the inline classifier with array-typed fields: a field of array type
// stores a ref to a list wrapper, so the code records which one. An unsupported field
// type yields -1 and the caller fails loudly.
export function fieldTypeCode(tyIx: i32) {
  if tyIx < 0 { return -1 }
  // A nullable-function field stores a nullable closure fat-pointer, code 22 — the field
  // analogue of a kind-19 local. Checked before the bare-function test, in the same order
  // `vtKindOfType` uses: `((i32) => i32) | null` is a nullable function, while `(i32) =>
  // i32 | null` is a function returning a nullable, handled elsewhere.
  if nulCloFlagAnn(tyIx) == 1 { return 22 }
  // A function-typed field (`op: (i32) => i32`) stores the closure fat-pointer (code 14),
  // the field analogue of a function-valued local.
  if tyIsFuncType(tyIx) { return 14 }
  const ty = P.nodes[tyIx]
  if ty is TypeRef {
    const c = fieldCodeOfSpelling(ty.tyName, tyIx)
    if c >= 0 { return c }
    // An inline-shape struct field resolves structurally to its interned struct
    // (pre-interned by `collectNestedFieldShapes`), the dual of a nominal `inner: Inner`.
    // Guarded against an array base: `structIndexOfTypeName` ignores a trailing `[]` and
    // would mis-code a nullable struct-list field as a nullable struct (invalid wasm).
    const base = nonNulBaseOf(ty.tyName)
    if !nameIsArray(base) && structIndexOfTypeName(base) >= 0 { return 15 }
    // A generic-application field is a struct-ref field over the monomorphized instance,
    // code 15, keyed by the application name `gaeEnsure` interns the instance under. It
    // cannot use `structIndexOfTypeName` above: `collectS` codes every declared struct
    // before `gaeCollectDecls` runs, so at field-code time the instance exists only in the arena.
    if !nameIsArray(base) && nameIsGenAppDecl(base) { return 15 }
    return -1
  }
  -1
}

// True if `name` is a generic-alias application (`Box<i32>`) whose head names a generic
// `type` declaration — the application analogue of `nameIsStructDecl`, independent of the
// registry and the struct table since both are built after `collectS`'s field-coding loop.
// Arity is not checked here: `gaeEnsure` declines a mismatch and fails loudly at use.
function nameIsGenAppDecl(name: string) {
  if !annGenAppSpanEnds(name) { return false }
  const head = gaeHeadNameOf(name, gaeLtAt(name))
  if head == "" { return false }
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is TypeDecl {
      const lt = gaeLtAt(nd.tdName)
      if lt > 0 {
        if gaeHeadNameOf(nd.tdName, lt) == head { return true }
      }
    }
    i = i + 1
  }
  false
}

// True if `name` is a STANDALONE struct `type` declaration's name — independent of
// the (incrementally-built) struct table, so a struct field may reference a LATER
// struct declaration. Union aliases and union variants are excluded (their fields
// ride the variant tables, not the struct table).
function nameIsStructDecl(name: string) {
  if name == "" { return false }
  if isUName(name) { return false }
  if variantIndexOf(name) >= 0 { return false }
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is TypeDecl {
      if nd.tdName == name { return true }
    }
    i = i + 1
  }
  false
}

// The ref-list element type-name of a field whose type node is `tyIx` — the key into
// `rlElemName` when `fieldTypeCode(tyIx) == 5` (a struct/union ref list), else "". Strips
// the trailing `[]` directly, since `sNames` builds incrementally and a field may
// reference a later-declared struct. Fills `sFieldElemName`/`uFieldElemName`.
export function fieldRefElemName(tyIx: i32) {
  if tyIx < 0 { return "" }
  const code = fieldTypeCode(tyIx)
  const ty = P.nodes[tyIx]
  if ty is TypeRef {
    // A nested-struct field (code 15) records its target struct name, resolved to a struct
    // table index at use sites. The node recorder nominalizes where the shape-text one does
    // not: an inline-shape field records the name of its interned struct, so every
    // nominal-keyed use site resolves it like a declared `inner: Inner`.
    if code == 15 {
      // `nonNulBaseOf` is the answer-or-original fold applied here. The arena is checked
      // first (`fieldBaseStructRow`); its -1 means "I do not know", never "no row" — the
      // name-matcher path still answers for those.
      const ar = fieldBaseStructRow(tyIx)
      if ar >= 0 { return sNames[ar] }
      const base = nonNulBaseOf(ty.tyName)
      const idx = structIndexOfTypeName(base)
      if idx >= 0 { return sNames[idx] }
      // An arm-typed field records its cross-table twin's name, not the arm's (D761): every
      // code-15 consumer resolves through `structIndexByName`, a struct-table lookup where
      // `Circle` has no row. The twin row's name resolves, and its heap is the arm's.
      const arm = armFieldStructRow(base)
      if arm >= 0 { return sNames[arm] }
      return base
    }
    // A nullable ref-list field's element is the ref-array element of the non-null part
    // (`S[]|null` -> `S`), so `sFieldRefSlot` finds its interned slot. Deferred exactly as
    // the shape-text recorder is: `collectVariantFields` reaches this from `collectU`,
    // which runs before `collectS` builds the struct table, so the slot is un-interned (D1293).
    if code == 28 { return refArrElemKeyDeferred(nullablePartOf(ty.tyName)) }
    // The ATOM codes the shape-text recorder keys and the NODE recorder does not: a
    // code-0 literal-union field and a code-30 `K | null` niche field carry their union
    // name from the annotation interner, not from here.
    if code == 0 { return "" }
    if code == 30 { return "" }
    // Every other code is recorded identically from a spelling: code 16 the union name,
    // 19/29 the map's value name, 4 the atom array name, 5 the canonical ref element
    // (parens stripped, nullable-array peeled — without it a declared `f: (f64|null)[]`
    // field would store a raw f64 into the box-ref backing).
    return shapeFieldElemName(ty.tyName, code)
  }
  ""
}

// The struct-table row a field typed as a union arm stores through (D761), or -1 when the
// arm has none: a union arm has no `sNames` row, so `nameIsStructDecl` declines it and
// nothing else claims the field, even though the arm's own layout builds and runs fine
// declared as a plain struct. `variantStructHeapTwinAt` is that row; any other would be a second heap type.
export function armFieldStructRow(base: string): i32 {
  const vi = variantIndexOf(base)
  if vi < 0 { return -1 }
  variantStructHeapTwinAt(vi)
}

// Validates an array type name as a supported element type: `i32[]` or a ref list
// `S[]`/`N[]` over a declared struct or union alias. A nested `i32[][]`, or an array of
// an unsupported element, fails loudly. Returns 0 on success, or -1 via `emitFail`.
export function checkArrName(name: string) {
  if nameIsI32Array(name) { return 0 }
  if nameIsRefArray(name) { return 0 }
  emitFail(
    "emitProgram: only i32[] arrays and struct/union element arrays are supported",
  )
}

// The struct-field refusal message, worded from what the field actually is (D734): only a
// field whose declared type is a union arm — on the declaration alone, or its `arm | null`
// niche — has no field code; deleting the union, or making the field the union, both run.
// The message names the type and says what to write instead, rather than a stale allow-list.
export function fieldTypeRefusalMsg(name: string): string {
  const base = nonNulBaseOf(name)
  if base != "" {
    if variantIndexOf(base) >= 0 {
      return "emitProgram: a struct field typed as the union ARM `" +
        base +
        "` has no field rep — give the field the UNION's own type, or declare the arm as a plain struct"
    }
  }
  if variantIndexOf(name) >= 0 {
    return "emitProgram: a struct field typed as the union ARM `" +
      name +
      "` has no field rep — give the field the UNION's own type, or declare the arm as a plain struct"
  }
  // The general refusal names the type, unlike the old allow-list. Two `u8[]` fixtures pin
  // it word for word, so the name must be the substituted spelling on the generic side —
  // which it is: `gaeEnsure` hands `tn`, the applied field text.
  if name != "" {
    return "emitProgram: struct field type `" +
      name +
      "` has no struct-field rep"
  }
  "emitProgram: struct field type has no struct-field rep"
}

// True when `name` is `T[]` for a declared type parameter `T`, checked against both a
// FuncDecl's parameter names and a generic alias's split-out parameters. Skipping is right
// for either: a generic alias mints no concrete struct, each application interns its own
// substituted shape through `gaeEnsure`, and `checkArrName`'s own accept set guards a name collision.
export function fnTyParamName(base: string) {
  let i = 0
  while i < genTyParamNames.length {
    if genTyParamNames[i] == base { return true }
    i = i + 1
  }
  false
}

// True when `base` is a declared type parameter of either kind: a FuncDecl's names
// (`genTyParamNames`) or a generic alias's (`gaeParams`, split back out by
// `gaeCollectDecls`). `genTyParamArr` is its one caller.
function genTyParamLeaf(base: string) {
  if genTyParamNames.length == 0 && gaeBases.length == 0 { return false }
  if fnTyParamName(base) { return true }
  // The generic-alias half: `gaeParams` stores the raw parameter text per declaration
  // ("T", "A,B"), split by `gaeSplitArgs` — the same cut `gaeEnsure` makes, not a second
  // grammar. An empty registry (no generic alias) never runs this loop.
  let gi = 0
  while gi < gaeBases.length {
    const pnames: string[] = []
    gaeSplitArgs(gaeParams[gi], pnames)
    let pj = 0
    while pj < pnames.length {
      if pnames[pj] == base { return true }
      pj = pj + 1
    }
    gi = gi + 1
  }
  false
}

export function genTyParamArr(name: string) {
  if genTyParamNames.length == 0 && gaeBases.length == 0 { return false }
  // The array-name grammar at its two homes: the test stays ahead of the cut, since
  // `nameIsArray` is exactly the bound the two compares below duplicate, and the `""` a
  // non-array cut yields never matches a type-parameter name — kept rather than folded,
  // per `arrElemNameRaw`'s own rule about `"[]"`.
  if !nameIsArray(name) { return false }
  if nameIsI32Array(name) { return false }
  if nameIsRefArray(name) { return false }
  // Cuts to the leaf (`arrLeafNameOf`) rather than one level, since `T[][]` is as much a
  // type-parameter array as `T[]` is. This does not make a nested parameter array work —
  // the emit error moves to the pass that actually owns the gap, away from a misleading
  // i32-element message, and every name it newly claims already fails loudly at emit.
  genTyParamLeaf(arrLeafNameOf(name))
}

// The registered union the checker typed this array literal's element as, or "" — the one
// home `arrLitIsRef`, `arrLitElemKind`, and `arrLitElemName` each need an arm for. A call or
// an ident element is neither an object literal, nested literal, nor lambda, so the
// first-element probes those three classifiers run cannot see a union arriving by either route.
export function arrLitUnionElemName(arrIx: i32): string {
  const cen = nodeArrayElemName(arrIx)
  if cen == "" { return "" }
  if !isUNameAB(16, cen, nodeArrayElemTyIx(arrIx)) { return "" }
  if arrLitIsStr(arrIx, -1) { return "" }
  if arrLitIsF64(arrIx, -1) { return "" }
  if arrLitIsI64(arrIx, -1) { return "" }
  cen
}

// The checker-recorded value-union element of the array literal at `arrIx`, without asking
// whether the emitter holds that union's row — `arrLitInferUnionElemName` reads this at
// registration time when the row does not exist yet, and `arrLitBoxElem` adds the `isUName`
// gate back for every classifier that consults it afterward. A literal union is excluded.
export function arrLitBoxElemName(arrIx: i32): string {
  const ty = nodeTyIxOf(arrIx)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if !(t is TyArray) { return "" }
  if t.aElem < 0 { return "" }
  const el = T.tys[t.aElem]
  if !(el is TyUnion) { return "" }
  if el.uMembers.length < 2 { return "" }
  if tyIsLitUnion(t.aElem) { return "" }
  const cen = nodeArrayElemName(arrIx)
  if cen == "" { return "" }
  if nameIsLitUnionArmValueUnion(cen) { return "" }
  cen
}

// The nullable spelling of the same box (D1372): `arrLitBoxElemName` reads `TyUnion`, but a
// boxed nullable scalar (`i32 | null`) is recorded as `TyNullable`, so the scalar classifiers
// saw no box and claimed the literal, storing the wrong heap type. `arrLitNulRefElemKind == 2`
// is the rung that claims it for the ref path instead, keeping both classifiers one answer.
function arrLitNulBoxElem(arrIx: i32): boolean {
  if arrLitNulRefElemName(arrIx) == "" { return false }
  arrLitNulRefElemKind(arrIx) == 2
}

// The registered form — `arrLitBoxElemName` plus the row check — for the scalar classifiers
// to consult; not `arrLitUnionElemName` itself, which asks `arrLitIsStr` and would close a
// cycle. The scalar classifiers are first-element probes, so `[1, "two"]` and `["two", 1]`
// would otherwise disagree; the recorded element type is order-blind and answers for both.
function arrLitBoxElem(arrIx: i32): boolean {
  if arrLitNulBoxElem(arrIx) { return true }
  const nm = arrLitBoxElemName(arrIx)
  if nm == "" { return false }
  isUNameAB(17, nm, nodeArrayElemTyIx(arrIx))
}

// The name the registration pass (`collectU`) mints a row for: the box element of a literal
// that today has no row and no other classification. `arrLitIsRef` is checked last by
// design — a literal an earlier rung already claims must not be registered here — and
// carries no scalar exclusion, since repeating `arrLitUnionElemName`'s would be a chicken-and-egg.
export function arrLitInferUnionElemName(arrIx: i32): string {
  const cen = arrLitBoxElemName(arrIx)
  if cen == "" { return "" }
  if arrLitIsRef(arrIx) { return "" }
  cen
}

// True if the struct type at `ty` has a map field anywhere in its (nested-struct) shape,
// depth-bounded against recursive struct definitions.
export function tyStructHasMapField(ty: i32, depth: i32): boolean {
  if ty < 0 { return false }
  if depth > 12 { return false }
  const t = T.tys[ty]
  if !(t is TyObj) { return false }
  const fts = t.objFieldTypes
  let i = 0
  while i < fts.length {
    const ft = T.tys[fts[i]]
    if ft is TyMap { return true }
    if ft is TyObj {
      if tyStructHasMapField(fts[i], depth + 1) { return true }
    }
    i = i + 1
  }
  false
}

// Does the type tree at `ty` mention a function type anywhere? The arena reading of
// `nameIsClosureElem`'s last leg, matching an arrow at any depth: inside a union arm, an
// array element, or a field.
function tyMentionsFunc(ty: i32, depth: i32): boolean {
  if ty < 0 { return false }
  if depth > 12 { return false }
  const t = T.tys[ty]
  if t is TyFunc { return true }
  if t is TyArray { return tyMentionsFunc(t.aElem, depth + 1) }
  if t is TyNullable { return tyMentionsFunc(t.nInner, depth + 1) }
  if t is TyMap { return tyMentionsFunc(t.mVal, depth + 1) }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if tyMentionsFunc(ms[i], depth + 1) { return true }
      i = i + 1
    }
  }
  if t is TyObj {
    const fts = t.objFieldTypes
    let k = 0
    while k < fts.length {
      if tyMentionsFunc(fts[k], depth + 1) { return true }
      k = k + 1
    }
  }
  false
}

// The arena twin of `nameIsClosureElem`, asked of an array's element, arm for arm:
// `TyFunc`, a nullable `TyFunc`, a bare `TyObj` (declines even with a closure field), or an
// arrow at any depth (`tyMentionsFunc`). Narrowing the last arm to "is it a `TyFunc`" still
// produces correct output but a markedly larger module, since the element still reps as a ref.
export function arrElemIsClosureTy(arrIx: i32, cen: string): boolean {
  // The emptiness gate is kept on the render: "" is not a missing answer, it is the
  // checker declining to name the element — a decline the arena cannot see, since it only knows the kind.
  if cen == "" { return false }
  const aty = nodeTyIxOf(arrIx)
  if aty < 0 { return false }
  const at = T.tys[aty]
  if at is TyArray {
    const ety = at.aElem
    const et = T.tys[ety]
    if et is TyFunc { return true }
    if et is TyNullable {
      const it2 = T.tys[et.nInner]
      if it2 is TyFunc { return true }
    }
    // `nameIsBraceSpanEnds` spans both brace forms — an object and a map — so a map whose
    // value is a closure declines here exactly as an object with a closure field does.
    if et is TyObj { return false }
    if et is TyMap { return false }
    return tyMentionsFunc(ety, 0)
  }
  false
}

// The ref-list element name of an array literal whose elements are maps (`[Map()]`,
// `[Set()]`, a map-factory call), or "" — the map twin of `arrLitUnionElemName`. The name is
// the checker's recorded element type, whose render is the string an annotated `{[K]: V}[]`
// spelling reduces to, so both spellings intern one row of kind 3.
function arrLitMapElemName(arrIx: i32): string {
  const cen = nodeArrayElemName(arrIx)
  if cen == "" { return "" }
  if !nameIsBareMap(cen) { return "" }
  cen
}

// The ref-list element name of an array literal whose elements are themselves arrays, or ""
// — the nested-array twin of `arrLitUnionElemName`/`arrLitMapElemName`, same contract: the
// name is the checker's recorded element type. Needed for an empty `[]` a later `.push`
// pinned to an array, since the nested/element classifiers key off the first element's node.
export function arrLitNestedElemName(arrIx: i32): string {
  const ty = nodeTyIxOf(arrIx)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem >= 0 {
      const el = T.tys[t.aElem]
      if el is TyArray {
        // The gate is the same one `nodeArrayElemName`'s arm asks (D702): does this element
        // render? A spelling with no render is one no row can be keyed under.
        if !tyNestedArrLeafRenders(t.aElem) { return "" }
        const nen = nodeArrayElemName(arrIx)
        if nen == "" { return "" }
        // The ref-list layer must also be able to name it: `refArrElemKind` answers a kind
        // for every name, so a render alone is not enough. Without this, `{r: K}[]` (no
        // resolvable struct row) would intern as a kind-1 struct element and a neighbouring
        // `{r: i32}[]` literal would resolve to that same row and lose its wrapper.
        if !nameIsRefArray(refElemArrName(nen)) { return "" }
        return nen
      }
    }
  }
  ""
}

// The element kind for `arrLitNestedElemName`'s literal, asked of the one producer the
// annotation route asks (`refArrElemKind` over `refElemArrName`), so a kind derived here
// can never differ from the kind the annotation side derives — `rlInternName` banks the
// first kind against a shared rep key, and a disagreement types one wrapper over another.
export function arrLitNestedElemKind(arrIx: i32): i32 {
  const en = nodeArrayElemName(arrIx)
  if en == "" { return 4 }
  refArrElemKind(refElemArrName(en))
}

// D1511 — the ref-list element name of an array literal whose recorded element is a shape,
// or "" — the struct twin of `arrLitUnionElemName`/`arrLitNestedElemName`, for an empty
// literal with no element for `arrLitIsRef` to classify. The name is `shapeNominalOfTy`'s,
// not the render, since `synthEmptyListAnn` resolves the row by that same producer.
export function arrLitShapeElemName(arrIx: i32): string {
  const ty = nodeTyIxOf(arrIx)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem >= 0 {
      const el = T.tys[t.aElem]
      if el is TyObj {
        const nom = shapeNominalOfTy(t.aElem)
        if nom == "" { return "" }
        // The ref-list layer must also be able to name it (`arrLitNestedElemName`'s second
        // gate): a render alone is not enough to key a row the annotation half would decline.
        if !nameIsRefArray(refElemArrName(nom)) { return "" }
        return nom
      }
    }
  }
  ""
}

// D1270 — the ref-list element name of an array literal whose recorded element is a nullable
// type, or "" — the nullable twin of `arrLitNestedElemName`, same contract and same two
// gates: the render must exist, and the ref-list layer must be able to name it. A niche
// nullable scalar stays ungrouped and declines here exactly as it does on the annotation side.

// D1340 — the element name of a nullable element, nominal where the niche needs it.
// `tyToEmitName` renders a `TyObj` structurally, but `refArrShapeKind`'s niche rung resolves
// the nullable part through `structIndexByName`, which only answers for a declared name.
// `nominalStructNameOfTy` puts both the annotated and the inferred spelling on that name.
function nulRefElemEmitName(nulTy: i32, innerTy: i32): string {
  if innerTy >= 0 {
    const it = T.tys[innerTy]
    if it is TyObj {
      const nom = nominalStructNameOfTy(innerTy)
      if nom != "" { return nom + "|null" }
    }
  }
  tyToEmitName(nulTy)
}

export function arrLitNulRefElemName(arrIx: i32): string {
  const ty = nodeTyIxOf(arrIx)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem >= 0 {
      const el = T.tys[t.aElem]
      if el is TyNullable {
        const nen = nulRefElemEmitName(t.aElem, el.nInner)
        if nen == "" { return "" }
        const an = refElemArrName(nen)
        if !nameIsRefArray(an) { return "" }
        return nen
      }
    }
  }
  ""
}

// The element kind for `arrLitNulRefElemName`'s literal, asked of the one producer the
// annotation route asks, exactly as `arrLitNestedElemKind` is (D1270).
function arrLitNulRefElemKind(arrIx: i32): i32 {
  refArrElemKind(refElemArrName(arrLitNulRefElemName(arrIx)))
}

// True if the array literal at `arrIx` has ref elements — its first element is a struct
// object literal or a union-variant object literal. An empty literal is not detectable
// here (it has no elements); its kind comes from the binding annotation (`pendingListKind`).
export function arrLitIsRef(arrIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    // A literal of function values the checker typed as a closure array: its element is a
    // closure cell, checker-driven rather than a first-element guess, so a local shadowing
    // a function name is never mis-claimed. Subsumes the lambda-literal rung below for any
    // closure array the checker concretely typed.
    const cen = nodeArrayElemName(arrIx)
    if arrElemIsClosureTy(arrIx, cen) { return true }
    const e0 = P.nodes[a.arrElems[0]]
    if e0 is ObjLit { return true }
    // A closure-element literal is a ref list (kind 5), not an i32 list — without this,
    // `exprArray` claims it by default, the inferred-return scan mints an i32-list closure
    // signature, and a closure value returning it miscompiles.
    if e0 is FuncDecl { return true }
    // A nested array literal is a ref list whose element is the inner list's wrapper (kind
    // 4, or 6/7/8 for a string/f64/i64 leaf). Keying every scalar leaf, not only i32, avoids
    // a wrapper-heap mismatch between the outer key and the inner literal's own build. A ref
    // inner literal falls through to the arena rung below instead, one level short here.
    if e0 is ArrayLit {
      if !arrLitIsRef(a.arrElems[0]) { return true }
    }
    // A checker-typed union element: the kind-2 box list. Last rung, deliberately — every
    // literal that classifies by its first element keeps that classification, so this arm
    // only ever claims a literal that otherwise falls through to the i32 default.
    if arrLitUnionElemName(arrIx) != "" { return true }
    // A checker-typed map element: the kind-3 map list. Same placement as the union rung —
    // a `Map()`/`Set()` element is no object literal, no nested literal, and no lambda, so
    // every probe above misses it and the literal falls to the i32 list, where
    // `emitArr`'s guard refuses the map-struct ref element loudly.
    if arrLitMapElemName(arrIx) != "" { return true }
    // A checker-typed object-shaped element the first-element probes cannot see — an ident
    // or a call whose recorded element is a declared struct or union arm. Last, beside the
    // union and map rungs, for the same reason: it only claims a literal falling to i32.
    if arrLitNominalElemName(arrIx) != "" { return true }
    // A checker-typed list element the first-element probes cannot see (D180): `[c]` where
    // `c` is a `string[]` local is no object literal, nested literal, lambda, map, or
    // declared shape, so it fell to the i32 backing with a ref operand — check-clean invalid
    // wasm. Reuses `arrLitNestedElemName`, last because an array-first-element is claimed above.
    if arrLitNestedElemName(arrIx) != "" { return true }
    // D1270 — the nullable-niche element, one peel short of the list rung above: its
    // recorded element is a `TyNullable`, not the `TyArray` that rung reads, so every probe
    // missed it and the literal built the mono i32 list with a nullable-ref element stored
    // in it — check-clean invalid wasm. Last, for the same reason the rungs above are.
    if arrLitNulRefElemName(arrIx) != "" { return true }
  }
  false
}

// True if the array literal at `arrIx` has string elements — its first element is a
// string-typed expression. An empty literal is not detectable here; its kind comes from
// the binding/field annotation (`pendingListKind == 3`).
export function arrLitIsStr(arrIx: i32, fnIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    // An atom-element literal (the checker adopted a `K[]` context) is the i32 atom-id
    // list, not a string list — its elements are string exprs syntactically but each lowers
    // as its interned atom id. Without this the literal claims the string-list build while
    // every consumer reads the atom rep, invalid wasm at first use.
    if nodeArrayElemIsLitUnion(arrIx) { return false }
    // A `(K | null)[]` literal is likewise the i32 atom-niche list, not a string list: its
    // elements lower as atom ids and `null` as the `-1` sentinel. Without this exclusion a
    // string-first literal claims the string-list build while every consumer reads the atom
    // rep, invalid wasm.
    if nodeArrayElemIsNulLitUnion(arrIx) { return false }
    // A `string[]` literal with no string-typed first element (a litunion value under a
    // `string[]` annotation): the recorded context-adoption type is the only signal, and
    // without it the emitter built the atom list from the first element into a string-list
    // slot — check-clean invalid wasm. Checked after the two literal-union exclusions above.
    if nodeArrayElemIsStr(arrIx) { return true }
    // A one-member set spelled bare (`("a")[]`) is a string list (D1460): its only element,
    // a promoted one-member discriminant field, reads as an atom, so the first-element probe
    // below misses it and the literal would build the i32 list into a string-list slot.
    // Checked beside the `string[]` arm, after the two litunion exclusions.
    if nodeArrayElemIsBareStrLit(arrIx) { return true }
    // A `(string | null)[]` literal with no string-typed first element (`[null]`): the
    // recorded context-adoption type is the only signal — it is the string-ref niche list,
    // so the string-list build is authoritative even though the first-element probe misses.
    if nodeArrayElemIsNulStr(arrIx) { return true }
    // A box-list literal whose first element happens to be a string: the checker recorded a
    // value union and the elements box, so the string-list build would store the i32 sibling
    // into a ref backing — invalid wasm. Asked of the recorded type, order-blind, so
    // `[1, "two"]` and `["two", 1]` are one answer. Last, right before the first-element probe.
    if arrLitBoxElem(arrIx) { return false }
    return exprString(a.arrElems[0], fnIx)
  }
  false
}

// True if the array literal at `arrIx` has f64 elements — its first element is an
// f64-typed expression. An empty literal is not detectable here; its kind comes from the
// binding annotation (`pendingListKind == 4`).
export function arrLitIsF64(arrIx: i32, fnIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    // A box-list literal with an f64 member: the checker recorded a value union, so the
    // elements box and the f64-list build would store a string ref into an `(array (mut
    // f64))` backing. The scan below is order-blind (any f64 member claims the list), so
    // here the union has to win rather than the first element.
    if arrLitBoxElem(arrIx) { return false }
    // Any f64 element makes the literal an f64 list: first-element-only classification let
    // `[2, 1.5]` claim the i32 list and emit `f64.const` into it — invalid wasm. An i64
    // element keeps this false, since mixed float/int is a checker-level union.
    let anyF64 = false
    let i = 0
    while i < a.arrElems.length {
      if exprIsI64(a.arrElems[i], fnIx) { return false }
      if !anyF64 {
        if exprIsF64(a.arrElems[i], fnIx) { anyF64 = true }
      }
      i = i + 1
    }
    return anyF64
  }
  false
}

// The union variant an object-literal-element array literal boxes its elements under, or ""
// — the one home the rule `arrLitElemName`, `arrLitElemKind`, and `arrLitElemHintTy` all
// need an arm for. `objVariantName` alone over-widens an anonymous shape shared by two
// variants (D36); `arrLitBoxElemName` is the second gate, asking whether the element is a real union.
export function arrLitObjElemBoxVariant(arrIx: i32): string {
  if !uDeclared { return "" }
  if arrLitBoxElemName(arrIx) == "" { return "" }
  // The third gate (D361): the recorded union may be a join, not a disagreement of rows.
  // When every element denotes one arm, the literal is a list of that arm, and declining
  // here routes all three classifiers to kind 1 under that arm's own name — the same slot
  // the annotated `Circle[]` spelling interns.
  if arrLitObjElemsOneVariant(arrIx) != "" { return "" }
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length >= 1 {
      const e0 = P.nodes[a.arrElems[0]]
      if e0 is ObjLit { return objVariantName(a.arrElems[0]) }
    }
  }
  ""
}
// The one nominal row every object-literal element of `arrIx` denotes, or "" when they do
// not all denote one row (D361) — the rung `arrLitObjElemBoxVariant` consults before it
// widens. "The checker recorded a union" and "the elements denote different rows" are two
// different facts: a naive structural join can name a union while every element is one arm.
function arrLitObjElemsOneVariant(arrIx: i32): string {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 2 { return "" }
    let nm = ""
    let i = 0
    while i < a.arrElems.length {
      const e = P.nodes[a.arrElems[i]]
      if !(e is ObjLit) { return "" }
      const vn = objVariantName(a.arrElems[i])
      if vn == "" { return "" }
      if i == 0 { nm = vn }
      else if vn != nm { return "" }
      i = i + 1
    }
    return nm
  }
  ""
}

// The declared row an array literal's element denotes when no first-element syntax probe
// can see it (an ident or a call) — the fourth home of the rule `arrLitIsRef`,
// `arrLitElemName`, and `arrLitElemKind` must agree on (D40). Gated on a `TyObj` element:
// `shapeNominalOfTy` recurses through `TyArray` and would misname a nested list otherwise.
export function arrLitNominalElemName(arrIx: i32): string {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return "" }
    const e0 = P.nodes[a.arrElems[0]]
    if e0 is ObjLit { return "" }
    if e0 is ArrayLit { return "" }
    if e0 is FuncDecl { return "" }
    const aty = nodeTyIxOf(arrIx)
    if aty < 0 { return "" }
    const at = T.tys[aty]
    if at is TyArray {
      if at.aElem < 0 { return "" }
      const el = T.tys[at.aElem]
      if !(el is TyObj) { return "" }
      return shapeNominalOfTy(at.aElem)
    }
  }
  ""
}

// The ref-element kind of the array literal at `arrIx` (assumes `arrLitIsRef`): 2 when the
// first element is a union variant (boxes into the union), else 1 (a direct struct
// element). Per-element-type: a `Tok[]` literal is kind 1 even in a program that also
// declares a union.
export function arrLitElemKind(arrIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    // A closure-element literal is kind 5, asked of the element itself, so a struct, map, or
    // union element that merely contains a closure keeps its own kind and wrapper.
    const cen = nodeArrayElemName(arrIx)
    if arrElemIsClosureTy(arrIx, cen) { return 5 }
    if a.arrElems.length >= 1 {
      const e0 = P.nodes[a.arrElems[0]]
      // A nested-list element: the inner literal's leaf picks the element kind (string 6,
      // f64 7, i64 8, else the i32-list wrapper 4). Mirrors `arrLitElemName`'s leaf keying.
      if e0 is ArrayLit {
        // A ref inner literal is kind 9, and only the arena can say so: the three leaf
        // probes below all decline an object/nested-list inner, and the arm would fall to 4,
        // keying the i32-list wrapper over a backing holding a `(ref $rlWrap)` (D702). Must
        // agree arm for arm with `arrLitElemName`'s rung of the same shape.
        if arrLitIsRef(a.arrElems[0]) {
          if arrLitNestedElemName(arrIx) != "" {
            return arrLitNestedElemKind(arrIx)
          }
        }
        if arrLitIsStr(a.arrElems[0], -1) { return 6 }
        if arrLitIsF64(a.arrElems[0], -1) { return 7 }
        if arrLitIsI64(a.arrElems[0], -1) { return 8 }
        return 4
      }
      if e0 is ObjLit {
        // A union-variant element boxes into the union (kind 2); a plain struct is kind 1.
        // Must agree arm for arm with `arrLitElemName`'s object arm, one shared predicate.
        if arrLitObjElemBoxVariant(arrIx) != "" { return 2 }
        return 1
      }
    }
    // The checker-typed union element (`arrLitIsRef`'s last rung) boxes: kind 2. Stated
    // explicitly, ahead of the `uDeclared` fall-through below, because the three classifiers
    // must agree arm for arm and this answer follows from this literal's own element type.
    if arrLitUnionElemName(arrIx) != "" { return 2 }
    // Must agree arm for arm with `arrLitElemName`'s committed-rep rung (D163): a map
    // spelling is kind 3, the same `refArrElemKind` gives the annotated `{[K]: V}[]`, and a
    // bare union arm is kind 1, the unboxed variant-struct element. `scanArrLitCommit`'s
    // gate holds nothing else, so there is no third case.
    const acnK = arrLitCommitNameAt(arrIx)
    if acnK != "" {
      if nameIsBareMap(acnK) { return 3 }
      return 1
    }
    // The checker-typed map element: kind 3, the same `refArrElemKind` gives the annotated
    // `{[K]: V}[]` spelling. Checked before the `uDeclared` fall-through, which would
    // otherwise claim a map literal as a union box in any program declaring a union.
    if arrLitMapElemName(arrIx) != "" { return 3 }
    // The checker-typed object-shaped element: a direct struct element, kind 1 — the same
    // kind `refArrElemKind` gives the annotated `Circle[]` spelling. Checked before the
    // `uDeclared` fall-through, which would otherwise box an arm-element literal into the
    // union in any program declaring one, a rep a reader that unboxes cannot meet (D36).
    if arrLitNominalElemName(arrIx) != "" { return 1 }
    // The checker-typed list element: the nested kinds 4/6/7/8, keyed on the inner array's
    // leaf from the arena rather than a first element this literal lacks in literal form.
    // Checked before the `uDeclared` fall-through, which would otherwise box a list-element
    // literal into the union in any program declaring one — same placement as the rungs above.
    if arrLitNestedElemName(arrIx) != "" { return arrLitNestedElemKind(arrIx) }
    // D1270 — the checker-typed nullable-container element: the niche kinds, keyed off the
    // arena render through the same authority the annotated `(i32[] | null)[]` spelling
    // resolves by. Checked before the `uDeclared` fall-through, same placement as the rungs
    // above, for the same reason.
    if arrLitNulRefElemName(arrIx) != "" { return arrLitNulRefElemKind(arrIx) }
  }
  if uDeclared { return 2 }
  1
}

// True if the type tree at `ty` mentions a literal-union type or an object shape anywhere,
// depth-bounded, gating which `arrLitElemHintTy` arms are safe to hint.
function tyMentionsLitOrObj(ty: i32, depth: i32): boolean {
  if ty < 0 { return false }
  // The depth bound is a recursion guard, not a policy: a self-referential row would
  // otherwise walk forever, and past this depth the arm declines rather than guesses.
  if depth > 6 { return false }
  const t = T.tys[ty]
  if t is TyLit { return true }
  if t is TyObj { return true }
  if t is TyArray { return tyMentionsLitOrObj(t.aElem, depth + 1) }
  if t is TyNullable { return tyMentionsLitOrObj(t.nInner, depth + 1) }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if tyMentionsLitOrObj(ms[i], depth + 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyFunc {
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      if tyMentionsLitOrObj(ps[i], depth + 1) { return true }
      i = i + 1
    }
    return tyMentionsLitOrObj(t.fnRet, depth + 1)
  }
  false
}
// The arena twin of `arrLitElemName`, arm for arm: the row that arm's name denotes, or -1
// where the arm's answer is deliberately a name. Each arm must use its own source — hinting
// every arm from the array's arena element disagrees for the two object-literal arms, whose
// name is a row found in a table, not the array's recorded element.
export function arrLitElemHintTy(arrIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    const cen = nodeArrayElemName(arrIx)
    // The closure-element arm is hinted at full agreement under the guard: the row is the
    // array's own recorded element, but only where the element mentions no literal type and
    // no object shape (`tyMentionsLitOrObj`), the two classes that disagree.
    if arrElemIsClosureTy(arrIx, cen) {
      const cty = arrLitArenaElemRow(arrIx)
      if cty < 0 { return -1 }
      if tyMentionsLitOrObj(cty, 0) { return -1 }
      return cty
    }
    if a.arrElems.length >= 1 {
      const e0 = P.nodes[a.arrElems[0]]
      // Arm 2 — the coarse nested-list bucket.
      if e0 is ArrayLit { return -1 }
      if e0 is ObjLit {
        // Must agree arm for arm with the two classifiers above: the hint denotes the row
        // the name arm picked, so it asks the same predicate. An element resolving to a bare
        // arm falls past into the struct arm, which declines the hint rather than guess.
        const vn = arrLitObjElemBoxVariant(arrIx)
        if vn != "" {
          // The variant arm, dual-written at full agreement: the name is `unNames[u]`, the
          // row is that table's own `unTyIx[u]`, resolved from that name at mint.
          const u = unionOfVariant(variantIndexOf(vn))
          if u < 0 { return -1 }
          if u >= unTyIx.length { return -1 }
          return unTyIx[u]
        }
        // The struct arm, at full agreement once two row classes are excluded: `sIsAnonRow`
        // (`sTyIx` has two producers that disagree for an `#anonN` row), and
        // `nameIsNewtypeBrand` (the row's name is the brand while `sTyIx[si]` holds the
        // unbranded base, so `repElemKey` keys the two differently).
        const si = structIndexOfObj(a.arrElems[0])
        if si >= 0 {
          if si >= sTyIx.length { return -1 }
          if sIsAnonRow(si) { return -1 }
          if nameIsNewtypeBrand(sNames[si]) { return -1 }
          return sTyIx[si]
        }
        return -1
      }
    }
    // The union-element arm, dual-written at full agreement: `arrLitUnionElemName` is
    // `nodeArrayElemName` gated by `isUName`, so its row is the array's own recorded
    // element, read off `nodeTyIxOf` — the same column that renderer reads.
    if arrLitUnionElemName(arrIx) != "" { return arrLitArenaElemRow(arrIx) }
    // The committed-rep arm declines too (D163): its name is a spelling the element
    // expression committed to, never a row this function looked up, so there is no arena
    // twin to hand over. The nominal-element arm declines deliberately, for the same reason
    // — a declined hint costs nothing, a wrong hint is a silently wrong rep key.
  }
  -1
}

// The array literal's own recorded element row — the source `nodeArrayElemName` renders.
// Reads `nodeTyIxOf`, not `nodeRepTyIxOf`: the renderer reads the checker's column and this
// twin must read the same one.
function arrLitArenaElemRow(arrIx: i32) {
  const ty = nodeTyIxOf(arrIx)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyArray { return t.aElem }
  -1
}

// The annotation node's recorded ref-array element row, or -1 — the arena twin of
// `refArrElemName(nullablePartOf(nd.tyName))`. Reads the canon column where
// `canonRewroteNode` reports the node as rewritten, since `canonEmitTypeNames` rewrites the
// name in place but leaves `nodeTyIx` holding the pre-rewrite type.
export function annRefArrElemRow(annIx: i32) {
  let ty = nodeTyIxOf(annIx)
  if canonRewroteNode(annIx) { ty = canonTyIxOf(annIx) }
  if ty < 0 { return -1 }
  const t0 = T.tys[ty]
  if t0 is TyNullable { ty = t0.nInner }
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyArray { return t.aElem }
  -1
}

// Is the element name `en` one `repElemKey` keys nominally? Those are the names a structural
// row cannot stand in for. Four classes: an interned anonymous row, a newtype brand (the
// name is the brand while the row is the unbranded base), a declared struct, and a declared
// alias reached through the array grammar. A conservative decline costs nothing; a wrong hint is a silently wrong slot.
export function elemNameIsNominal(en: string) { elemNameIsNominalAt(en, 0) }
function elemNameIsNominalAt(en: string, depth: i32): boolean {
  if en == "" { return true }
  // A recursion bound, not a policy: past it the guard declines rather than guesses.
  if depth > 8 { return true }
  // Peel the array grammar and ask about the LEAF — `S[]` is nominal exactly when `S` is.
  if nameIsArray(en) {
    return elemNameIsNominalAt(arrElemNameRaw(en), depth + 1)
  }
  if en.length >= 5 {
    if en.slice(0, 5) == "#anon" { return true }
  }
  if nameIsNewtypeBrand(en) { return true }
  if structIndexByName(en) >= 0 { return true }
  false
}

export function arrLitElemName(arrIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    // A closure-element literal: the parenthesized function-type table key the checker
    // recorded. Must agree arm for arm with `arrLitElemKind`'s kind-5 gate.
    const cen = nodeArrayElemName(arrIx)
    if arrElemIsClosureTy(arrIx, cen) { return cen }
    if a.arrElems.length >= 1 {
      const e0 = P.nodes[a.arrElems[0]]
      // A nested-list element keys the inner list's name by its leaf — the table key
      // `arrLitElemKind` picks the matching kind for (6/7/8, else 4).
      if e0 is ArrayLit {
        // An inner hole (`[[]]`) has no element for the three leaf probes below to read, so
        // all three would decline and key `i32[]` regardless of what the outer list holds —
        // check-clean invalid wasm (D16). The checker's own recorded element renders the
        // inner list's emit name instead, gated on the hole so a non-empty inner classifies normally.
        if emptyArrLitIxOf(a.arrElems[0]) >= 0 {
          if cen != "" { return cen }
        }
        // A ref inner literal's element is the inner ref list, whose name the leaf probes
        // below cannot render — they answer one level short, keying a different row than
        // the element actually builds (D702). The arena renders it instead, the same string
        // the annotated spelling interns. Must agree arm for arm with `arrLitElemKind`'s kind-9 rung.
        if arrLitIsRef(a.arrElems[0]) {
          const rin = arrLitNestedElemName(arrIx)
          if rin != "" { return rin }
        }
        if arrLitIsStr(a.arrElems[0], -1) { return "string[]" }
        if arrLitIsF64(a.arrElems[0], -1) { return "f64[]" }
        if arrLitIsI64(a.arrElems[0], -1) { return "i64[]" }
        return "i32[]"
      }
      if e0 is ObjLit {
        // The union widening is `arrLitObjElemBoxVariant`'s, not a bare field-set scan's —
        // one home for the rule, so this arm and `arrLitElemKind`'s cannot drift.
        const vn = arrLitObjElemBoxVariant(arrIx)
        if vn != "" { return unionNameOfVariant(variantIndexOf(vn)) }
        const si = structIndexOfObj(a.arrElems[0])
        if si >= 0 { return sNames[si] }
        // The arm's own name, not its union — the fall-through this gate needs, in the same
        // ladder order every consumer uses (struct row, then variant row). A concrete-variant
        // element list has no `sNames` row, so without this an anonymous element whose only
        // claimant is an arm has no name here and the literal falls to the i32 list (D38).
        if uDeclared {
          const av = objVariantName(a.arrElems[0])
          if av != "" { return av }
        }
      }
    }
    // The checker-typed union element: the registered composite is the table key — the
    // same string `refArrElemName` yields for the annotated `(Cat | Dog)[]` spelling, so
    // both spellings intern one slot.
    const aun = arrLitUnionElemName(arrIx)
    if aun != "" { return aun }
    // The element expression's own committed rep, ahead of every rung that reads the
    // checker's structural record (D163): `shapeNominalOfTy` resolves the struct table
    // before the variant table, so an annotated `Circle` element could key its layout twin
    // `Dot` instead. Checked after the literal arms and the checker-typed union element.
    const acn = arrLitCommitNameAt(arrIx)
    if acn != "" { return acn }
    // The checker-typed map element: the whole `{[K]:V}` spelling is the table key, the
    // same string `refArrElemName` yields for the annotated `{[K]: V}[]` — so the two
    // spellings intern one row of kind 3, carrying the key as well as the value.
    const amn = arrLitMapElemName(arrIx)
    if amn != "" { return amn }
    // The checker-typed object-shaped element: the declared row's own name is the table
    // key, the same string `refArrElemName` yields for the annotated `Circle[]` spelling,
    // whether that row is a struct or a union arm — so the inferred literal and the
    // annotation intern one kind-1 slot.
    const ann = arrLitNominalElemName(arrIx)
    if ann != "" { return ann }
    // The checker-typed list element: the inner list's own emit name is the table key, the
    // same string `refArrElemName` yields for the annotated `string[][]` spelling, so all
    // three spellings intern one row. Must agree arm for arm with `arrLitIsRef` and
    // `arrLitElemKind`, which ask the identical predicate.
    const anl = arrLitNestedElemName(arrIx)
    if anl != "" { return anl }
    // D1270 — the checker-typed nullable-container element: the element's own emit render
    // is the table key, the same string `refArrElemName` yields for the annotated
    // `(i32[] | null)[]` spelling, so both spellings intern one row. Must agree arm for arm
    // with `arrLitIsRef` and `arrLitElemKind`.
    const anr = arrLitNulRefElemName(arrIx)
    if anr != "" { return anr }
  }
  ""
}

// The element type name for a ref-array type name (assumes `nameIsRefArray(name)`): `name`
// with the trailing `[]` removed — the struct or union alias name. Mirrors `refArrElemKind`
// but yields the table key.
export function refArrElemName(name: string) {
  const ranp = nullablePartOf(name)
  if ranp != "" && nameIsArray(ranp) { return refArrElemName(ranp) }
  // `i32[][]` -> `i32[]`, `boolean[][]` -> `boolean[]`, `K[][]` -> `K[]`: the immediate i32-backed
  // inner list is the slot key (all kind-4 `lTypeIdx` elements), mirroring the `i32[][]` case.
  if nameIsI32ListArray(name) { return arrElemNameRaw(name) }
  // A nested non-i32 scalar or string 2D array: the inner list's name is the slot key (kind
  // 8/7/6 element), mirroring `i32[][]` -> `i32[]`. The three scalar arms test the array
  // grammar's one cut in place and cut only on the way out, so a name that is none of them
  // never builds the element string.
  if arrElemIsArrayOf(name, "i64") { return arrElemNameRaw(name) }
  if arrElemIsArrayOf(name, "f64") { return arrElemNameRaw(name) }
  if arrElemIsArrayOf(name, "f32") { return arrElemNameRaw(name) }
  if arrElemIsArrayOf(name, "u8") { return arrElemNameRaw(name) }
  if nameIsArray(name) && nameIsStringArray(arrElemNameRaw(name)) {
    return arrElemNameRaw(name)
  }
  if nameIsMapArray(name) { return arrElemNameRaw(name) }
  // `(string|i32)[]` → `string|i32` (the parens are annotation grouping only —
  // the TABLE key is the bare atom-set name every other union position uses).
  const pun = parenUnionArrElemName(name)
  if pun != "" { return pun }
  // `((i32) => i32)[]` → `((i32) => i32)` (the parenthesized function-type element, the
  // table key for the closure-element slot — all such slots share `cloStructIdx`).
  if nameIsClosureArray(name) { return arrElemNameRaw(name) }
  // A `<Union>[]`/`<Struct>[]`: strip the trailing `[]` once and confirm the bare name is a
  // registered union or struct — the stripped base is the table key, avoiding a
  // per-iteration `+ "[]"` concat that allocated a string per call.
  if nameIsElemArray(name) {
    const base = arrElemNameRaw(name)
    let u = 0
    while u < unNames.length {
      if base == unNames[u] { return base }
      u = u + 1
    }
    if structIndexByName(base) >= 0 { return base }
    // An inline-shape element resolving to an interned row by the structural bridge: the
    // spelling stays the table key (its slot twins with the resolved row's slot at the heap
    // layer), keyed exactly like `nameIsRefArray`'s bridge — the two must agree.
    if shapeElemDeclaredStructIdx(base) >= 0 { return base }
    // A `Cat[]` concrete-variant element list — the bare variant name is the table key.
    if variantIndexOf(base) >= 0 { return base }
    // D762 — the arm reached by its structural render, matching `nameIsRefArray`'s rung.
    // The key is the arm's nominal name, not the render: an arm has no struct row, and every
    // consumer that turns an element name back into a heap is nominal. Answering the render
    // would intern a slot no consumer could resolve.
    const rvi = variantIndexOfOwnRender(base)
    if rvi >= 0 { return uVariants[rvi] }
    // A NESTED ref array (`Cell[]` as the element of `Cell[][]`): the base is itself a ref array
    // — the inner list's name keys its slot. Recurses to the leaf struct/union/closure array.
    if nameIsRefArray(base) { return base }
  }
  ""
}

// This name's ref-list element, or "" — the one home for the guarded pair several call
// sites once wrote by hand. The guard is not redundant: `nameIsRefArray` rejects a
// top-level arrow and a literal-union array that `refArrElemName` never learned. "" means
// both "not a ref array" and "a ref array whose element does not resolve".
function refArrElemNameIf(name: string) {
  if !nameIsRefArray(name) { return "" }
  refArrElemName(name)
}

// A ref-list element is a nullable niche (the index read leaves it `(ref null $elem)`) iff
// it is a niche-bearing kind — a struct, a closure (the fat-pointer), or an inner list of
// any leaf — and its name carries `| null`. A value-union box (kind 2) is not a niche even
// though `i32 | null` also has `| null`, since its null is a tag inside a non-null box.
function rlElemNicheNullable(kind: i32, name: string) {
  if (
    kind != 1 &&
    kind != 3 &&
    kind != 4 &&
    kind != 5 &&
    kind != 6 &&
    kind != 7 &&
    kind != 8 &&
    kind != 9 &&
    kind != 10
  ) {
    return false
  }
  return nullablePartOf(name) != ""
}

// Canonicalizes an element name's unions to the one spelling every producer uses, descending
// through array-of-union, paren grouping, inline shapes, and map values so a nested union
// keys the same slot as a flat one. A closure element or top-level function type is left
// untouched, since its `=>`-result litunion is not a slot-key union.
function rlCanonLitUnionAtoms(name: string): string {
  const n = name.length
  if n == 0 { return name }
  if isTopLevelFuncTypeName(name) { return name }
  // A trailing `[]`: canon the element, re-grouping a union element with parens
  // (`(K0|i32)[]`), exactly as `canonEmitName` re-wraps.
  if nameIsElemArray(name) {
    const core = rlCanonLitUnionAtoms(arrElemNameRaw(name))
    if unionMemberCount(core) > 1 { return "(" + core + ")[]" }
    if isTopLevelFuncTypeName(core) { return "(" + core + ")[]" }
    return core + "[]"
  }
  // A parenthesized group wrapping the whole: strip and canon the inside, unless the inner
  // is a function type — a grouped closure element, whose grouping parens are part of its
  // ref-list slot key, so stripping them would re-key the slot. Such a name is left
  // untouched.
  if nameIsParenSpanEnds(name) {
    const inner = groupInnerOf(name)
    if isTopLevelFuncTypeName(inner) { return name }
    return rlCanonLitUnionAtoms(inner)
  }
  // An inline shape: soften litunion-alias atoms inside its field or value types, the struct
  // sibling of the array descent above — without it a map value canon-softened on the
  // annotation side but rendered elsewhere with the alias keyed two different mv slots.
  // `nameIsBraceSpanEnds` must stay the wide test, since `nameIsShapeSpanEnds` rejects `{[`.
  if nameIsBraceSpanEnds(name) {
    // A map `{[K]:V}`: soften the VALUE (a nested map / struct value); leave the key text.
    if nameIsMapOpen(name) {
      const mv = mapValNameOf(name)
      if mv == "" { return name }
      const cmv = rlCanonLitUnionAtoms(mv)
      if cmv == mv { return name }
      // `name` = `{[` + key + `]:` + mv + `}` — replace only the value tail.
      return name.slice(0, n - mv.length - 1) + cmv + "}"
    }
    // A struct `{f:T,…}`: soften each field type.
    const fNames: string[] = []
    const fTypes: string[] = []
    shapeFieldParse(name, fNames, fTypes)
    if fNames.length == 0 { return name }
    let sChanged = false
    let sOut = "{"
    let sfi = 0
    while sfi < fNames.length {
      if sfi > 0 { sOut = sOut + "," }
      const ct = rlCanonLitUnionAtoms(fTypes[sfi])
      if ct != fTypes[sfi] { sChanged = true }
      sOut = sOut + fNames[sfi] + ":" + ct
      sfi = sfi + 1
    }
    sOut = sOut + "}"
    if sChanged { return sOut }
    return name
  }
  // A top-level union: soften each litunion-alias atom, and descend non-litunion atoms (a
  // nullable struct value carries the litunion one level down). Softens a litunion atom
  // only when a genuine non-null, non-litunion sibling exists: a pure `K0 | null` is the
  // -1-sentinel mono niche, and widening it would re-rep the niche and break its values.
  if unionMemberCount(name) > 1 { return canonLitUnionArms(name) }
  name
}

// The ref-list element's stored name normalizer. The slot key is `repElemKey` (structural);
// this produces the canonical name several not-yet-destringified consumers still read, which
// is why it keeps a litunion-alias atom. A future change here must also update the arm
// scanner's closed probe vocabulary, or a preserved atom silently loses its ref-array arm.
function rlElemStoredName(name: string): string {
  const c = rlCanonLitUnionAtoms(name)
  if nameIsI32Array(c) { return "i32[]" }
  if nameIsStringArray(c) { return "string[]" }
  c
}

export function rlInternName(name: string, kind: i32) {
  rlInternNameTy(name, kind, -1)
}

// `rlInternName` with the caller's recorded arena type for `name`: the hint reaches only
// the key — the scan, mint, stored spelling, and every sidecar push are unchanged, so a
// hinted call that finds no row interns exactly the row an unhinted one would. The hint
// must compute the same key, since a disagreeing hint silently re-keys the row.
export function rlInternNameTy(name: string, kind: i32, ty: i32) {
  if name == "" { return -1 }
  // Dedup on the element's rep key (`repElemKey`), a structural wrapper-equivalence class,
  // not a string-canonicalized name. Two spellings sharing a WasmGC wrapper collapse to one
  // slot — without it, two slots sharing one wrapper mint distinct iso-recursive functypes
  // and a value-call `ref.cast` trap. Declared struct twins stay apart, keyed nominally.
  const key = repElemIdOfNameTy(name, ty)
  let i = 0
  while i < rlElemName.length {
    if rlElemKey[i] == key { return i }
    i = i + 1
  }
  const stored = rlElemStoredName(name)
  rlElemName.push(stored)
  rlElemKey.push(key)
  // The arena type the stored spelling denotes, recorded once at mint time — resolved from
  // the stored name (which `rlElemStoredName` may have folded), never the raw `name`. Prefers
  // the caller's hint when the stored spelling is unfolded (`stored == name`), since a folded
  // spelling's own resolve would land on a different row than the checker's.
  let rlTy = -1
  if ty >= 0 && stored == name { rlTy = ty }
  if rlTy < 0 { rlTy = fieldElemTyIxOfName(stored) }
  rlElemTyIx.push(rlTy)
  rlElemHeap.push(0)
  rlBackIdx.push(0)
  rlWrapIdx.push(0)
  rlElemKindTbl.push(kind)
  if rlElemNicheNullable(kind, stored) {
    rlElemNullable.push(1)
  } else {
    rlElemNullable.push(0)
  }
  rlElemName.length - 1
}

// The table slot for a ref-list element type name: nominal exact-name match first, then the
// rep-key scan (`repElemKey`), then the struct-twin fallback, so a struct element spelled
// differently from the interned key still resolves to the same heap. Niche-nullable and
// non-null elements never merge, since that would change the read discipline.
export function rlSlotByName(name: string): i32 {
  rlSlotByNameTyK(name, -1, -1)
}

// `rlSlotByName` with a key-only hint: the caller's recorded arena type reaches rung 2's
// `repElemKey` and nothing else — the rendered rung 3 stays laddered, unlike
// `rlSlotByNameTy`'s full hint, which deletes it. The two differ because `rlSlotByNameTy`
// asserts the arena leg is total for its caller; a caller without that measurement keeps rung 3.
export function rlSlotByNameKeyTy(name: string, keyTy: i32): i32 {
  rlSlotByNameTyK(name, -1, keyTy)
}

// The ref-list slot of the element of the ref-array spelling `arrName` — `rlSlotByName`
// of `refArrElemName`. One home for a composition several call sites once wrote by hand.
function rlSlotOfArrName(arrName: string): i32 {
  rlSlotByNameKeyTy(refArrElemName(arrName), -1)
}

// `rlSlotOfArrName` with the caller's arena element type for `arrName`'s element,
// key-only: `elemTy` is `tyRefArrElemOf` of the array's recorded type, the arena dual of
// the `refArrElemName` peel this composition performs on the spelling.
function rlSlotOfArrNameTy(arrName: string, elemTy: i32): i32 {
  rlSlotByNameKeyTy(refArrElemName(arrName), elemTy)
}

// `rlSlotByName` with the caller's recorded arena element type as a hint for rungs 2 and 3.
// Rung 1, the exact-stored-name match, is untouched and still first — a hint must never
// preempt it. Rung 3 resolves a struct row from a rendered spelling on both sides;
// `rlSlotOfTyTwin` is its arena dual, and a hinted call skips rung 3 entirely (`ty` -1 keeps it).
function rlSlotByNameTy(name: string, ty: i32): i32 {
  rlSlotByNameTyK(name, ty, ty)
}

// The shared body of the three entry points above. `ty` is the full hint (rung 3's twin
// input); `keyTy` is the key hint alone. `rlSlotByNameTy` passes the same index as both;
// `rlSlotByNameKeyTy` passes -1 as `ty`, so only rung 2 moves.
function rlSlotByNameTyK(name: string, ty: i32, keyTy: i32): i32 {
  let i = 0
  while i < rlElemName.length {
    if rlElemName[i] == name { return i }
    i = i + 1
  }
  const key = repElemIdOfNameTy(name, keyTy)
  let ci = 0
  while ci < rlElemName.length {
    if rlElemKey[ci] == key { return ci }
    ci = ci + 1
  }
  const tw = rlSlotOfTyTwin(ty)
  if tw >= 0 { return tw }
  // The rendered rung is skipped for a hinted caller: no `nullablePartOf`, no
  // `structIndexOfTypeName`, no `shapeFieldParse` on this path.
  if ty >= 0 { return -1 }
  const qn = nullablePartOf(name)
  let qBase = name
  if qn != "" { qBase = qn }
  const qsi = structIndexOfTypeName(qBase)
  if qsi < 0 { return -1 }
  let j = 0
  while j < rlElemName.length {
    if rlElemKindTbl[j] == 1 {
      const en = rlElemName[j]
      const enn = nullablePartOf(en)
      let parity = false
      if qn == "" && enn == "" { parity = true }
      if qn != "" && enn != "" { parity = true }
      if parity {
        let eBase = en
        if enn != "" { eBase = enn }
        const esi = structIndexOfTypeName(eBase)
        if esi >= 0 && repStructSlotsTwin(qsi, esi) == 1 { return j }
      }
    }
    j = j + 1
  }
  -1
}

// The struct table row an arena type resolves to, with the same two-rung shape
// `structIndexOfTypeName` has: rung 1 is identity (`structIndexOfTy`), rung 2 is a lenient
// field-name-set match for an inline shape with no minted row. The name resolver's
// field-code tightening of rung 2 is not reproduced, since this row's consumer re-gates.
function repRowOfTyLenientRow(ty: i32, lim: i32): i32 {
  const idr = structIndexOfTy(ty)
  if idr >= 0 && idr < lim { return idr }
  if ty < 0 { return -1 }
  if ty >= T.tys.length { return -1 }
  const t = T.tys[ty]
  if !(t is TyObj) { return -1 }
  const n = t.objFieldNames.length
  let si = 0
  while si < lim && si < sNames.length {
    // The half-built-row skip: `internInlineShape` pushes a row header before its
    // per-field rows, and this scanner can be re-entered mid-field-loop.
    if sFieldStart[si] + sFieldCount[si] > sFieldElemName.length {
      si = si + 1
      continue
    }
    if sFieldCount[si] == n {
      let ok = true
      let k = 0
      while k < n {
        if sFieldIndex(si, t.objFieldNames[k]) < 0 { ok = false }
        k = k + 1
      }
      if ok { return si }
    }
    si = si + 1
  }
  -1
}

// The arena dual of `rlSlotByName`'s struct-twin rung: the ref-list slot whose element is
// a layout twin of the arena type `ty`, with both sides resolved from recorded arena types
// rather than rendered spellings. The `| null` niche parity the name rung enforces is a
// `TyNullable` test here. -1 means no arena answer, and the rendered rung runs instead.
function rlSlotOfTyTwin(ty: i32): i32 {
  if ty < 0 { return -1 }
  if ty >= T.tys.length { return -1 }
  let qty = ty
  let qNul = false
  const qt = T.tys[ty]
  if qt is TyNullable {
    qty = qt.nInner
    qNul = true
  }
  const qsi = repRowOfTyLenientRow(qty, sScanLim())
  if qsi < 0 { return -1 }
  let j = 0
  while j < rlElemName.length {
    if rlElemKindTbl[j] == 1 {
      const ety = rlElemTyIxAt(j)
      if ety >= 0 && ety < T.tys.length {
        let eb = ety
        let eNul = false
        const et = T.tys[ety]
        if et is TyNullable {
          eb = et.nInner
          eNul = true
        }
        if eNul == qNul {
          const esi = repRowOfTyLenientRow(eb, sScanLim())
          if esi >= 0 && repStructSlotsTwin(qsi, esi) == 1 { return j }
        }
      }
    }
    j = j + 1
  }
  -1
}

// ── canonical layout twins, map-value slot layer ──
// The struct table dedups by canonical key and field codes; the ref-list table by resolved
// element heap. The map-value table is the next layer: two slots whose value types are
// layout twins emit byte-equal map structs, merged by `repMapValSlotsTwin` — timing-independent, so queryable before heap indices exist.

// True when ref-list slots `a` and `b` resolve the same element heap type — the pairwise
// layout-twin equivalence over the ref-list table, mirroring the `rlSig` arms of
// `mAssignTypeIndices` from checker-level data only. Each arm below must stay at least as
// strict as its `rlSig` twin, since the map and struct arms recurse into their own tables.
export function rlSlotsLayoutTwin(a: i32, b: i32): i32 {
  if a == b { return 1 }
  if a < 0 || b < 0 { return 0 }
  const ka = rlElemKindTbl[a]
  if ka != rlElemKindTbl[b] { return 0 }
  if (
    ka == 2 ||
    ka == 4 ||
    ka == 5 ||
    ka == 6 ||
    ka == 7 ||
    ka == 8 ||
    ka == 10
  ) {
    return 1
  }
  if ka == 9 {
    // The inner list slots come off the arena chokepoint (`rlElemInnerSlot`), whose
    // element-name surgery is the untouched fall-through for a slot the sidecar skips.
    return rlSlotsLayoutTwin(rlElemInnerSlot(a), rlElemInnerSlot(b))
  }
  if ka == 3 {
    const ma = rlElemMapValMvSlot(a)
    const mb = rlElemMapValMvSlot(b)
    if ma == -1 && mb == -1 { return 1 }
    if ma < 0 || mb < 0 { return 0 }
    return repMapValSlotsTwin(ma, mb)
  }
  // The struct tail, off the arena chokepoints: `| null` niche parity through
  // `rlElemIsNulNiche`, and the struct row through `rlElemStructRow`. Each keeps its
  // element-name leg as the fall-through for a slot the sidecar does not cover.
  if rlElemIsNulNiche(a) != rlElemIsNulNiche(b) { return 0 }
  const sa = rlElemStructRow(a)
  const sb = rlElemStructRow(b)
  if sa >= 0 && sb >= 0 { return repStructSlotsTwin(sa, sb) }
  // The cross-table arm: a variant element only twins with itself until the variant table
  // dedups against the struct table. `rlElemStructRow` answers -1 for a registered arm by
  // design (D32's nominal floor) — the question is whether the arm has the same heap, asked
  // through `variantStructHeapTwinAt`, timing-independent since no heap index is consulted.
  const va = rlElemVariantRow(a)
  if va >= 0 && sb >= 0 {
    return repStructSlotsTwin(variantStructHeapTwinAt(va), sb)
  }
  const vb = rlElemVariantRow(b)
  if vb >= 0 && sa >= 0 {
    return repStructSlotsTwin(sa, variantStructHeapTwinAt(vb))
  }
  0
}

// The canonical identity a heap-twin comparison must use (D124): `mvValCanonId` with the
// niche-nullable peel the slot's own vals rep already took. A `{[K]: V | null}` value keys
// its vals ref-list slot through the single non-null member, so the identity must share that
// peel too, or the comparator refuses a pair whose vals slot it already made identical.
function mvValTwinCanonId(slot: i32): i32 {
  const nin = nulRefMapValInnerOf(mvValName[slot])
  if nin != "" { return repNameCanonId(nin) }
  mvValCanonId(slot)
}

// The struct row behind map-value slot `slot`'s vals element, or -1 when the slot has no
// ref-list row or its element is not a struct (a registered variant answers -1, D32's
// nominal floor). `rlSig`'s struct branch is a ladder (D623): when `rlElemStructRow` answers
// -1 it falls to the concrete-variant leg via `variantStructHeapTwinAt`, timing-independent.
function mvValsElemStructRow(slot: i32): i32 {
  const rs = mvRlSlot[slot]
  if rs < 0 || rs >= rlElemName.length { return -1 }
  const sr = rlElemStructRow(rs)
  if sr >= 0 { return sr }
  variantStructHeapTwinAt(rlElemVariantRow(rs))
}

export function repMapValSlotsTwin(a: i32, b: i32): i32 {
  if a == b { return 1 }
  if a < 0 || b < 0 { return 0 }
  // The key is part of the layout, not just the identity: field 0 (`keys`) is a string-ref
  // list wrapper on one rep and the i32 list wrapper on the other, so two slots agreeing on
  // every value question can still be byte-different map structs. Asked first, cheapest.
  if mvSlotKeyI32(a) != mvSlotKeyI32(b) { return 0 }
  const k = mvValKind[a]
  if k != mvValKind[b] { return 0 }
  // ── the direct layout question, asked before the canonical-key proxy (D300) ──
  // The map struct's identity is exactly (keys wrapper, vals wrapper): two kind-1 slots that
  // interned the same vals ref-list slot emit byte-equal map structs whatever the checker
  // says about value types. Asked as slot equality rather than `rlSlotsLayoutTwin`, to skip its cross-table arm.
  if k == 1 && mvRlSlot[a] >= 0 && mvRlSlot[a] == mvRlSlot[b] { return 1 }
  // ── same wrapper, not same slot (D301) ──
  // The rung above is slot equality; the vals half of a map struct's identity is the wrapper.
  // Two declared names of one layout intern two rows, which slot equality cannot see past, so
  // this leg asks the struct-row question directly through `repStructSlotsTwin`.
  if k == 1 {
    const wa = mvValsElemStructRow(a)
    const wb = mvValsElemStructRow(b)
    if wa >= 0 && wb >= 0 && repStructSlotsTwin(wa, wb) == 1 { return 1 }
  }
  // The nested-map half, the same hoist one container out: a `{[K]: {[K]: V}}` value is
  // kind 6, and its recursion bottoms out in the pair the rung above just merged — so
  // without this the inner merge lands but the outer map keeps two structs. Hoisted rather
  // than widened: the arm is unchanged, only the canonical-key precondition is dropped.
  if k == 6 && rlSlotsLayoutTwin(mvRlSlot[a], mvRlSlot[b]) == 1 { return 1 }
  const ka = mvValTwinCanonId(a)
  if ka < 0 { return 0 }
  if ka != mvValTwinCanonId(b) { return 0 }
  if k == 3 || k == 10 || k == 11 || k == 13 { return 1 }
  if k == 2 || k == 14 { return 1 }
  if k == 1 {
    // The direct question, asked before the proxy (D123): what decides whether two mv slots
    // emit one map struct is the vals list wrapper, via `rlSlotsLayoutTwin`. The proxy below
    // stays as the fall-through, since it is not a mere approximation — some arm-twin merges
    // have distinct ref-list rows that only the variant layer can answer.
    if rlSlotsLayoutTwin(mvRlSlot[a], mvRlSlot[b]) == 1 { return 1 }
    // The arm half of the kind-1 guard (D34): `mvValStructIdx` matches an arm-valued
    // `{[string]: Circle}` and a plain-struct `{[string]: Dot}` over the same field set to
    // the same row, so without this test they would share one map struct over two different
    // vals wrapper heaps — invalid wasm at the other map's store. Which table the heap comes from is decided first.
    const mva = mvValVariantRawOf(a)
    const mvb = mvValVariantRawOf(b)
    if (mva >= 0) != (mvb >= 0) {
      // The old premise — "cross-table is never one heap, since variant structs mint ahead
      // of every struct row" — is retired: an arm whose layout is a declared struct's now
      // takes that row's heap index, so the pair can be one heap. Asked per claimant, so the
      // mint and this find agree by computing the same function.
      if mva >= 0 {
        return repStructSlotsTwin(
          variantStructHeapTwinAt(mva),
          mvValStructIdx[b],
        )
      }
      return repStructSlotsTwin(mvValStructIdx[a], variantStructHeapTwinAt(mvb))
    }
    if mva >= 0 { return repVariantSlotsTwin(mva, mvb) }
    return repStructSlotsTwin(mvValStructIdx[a], mvValStructIdx[b])
  }
  if k == 6 { return rlSlotsLayoutTwin(mvRlSlot[a], mvRlSlot[b]) }
  0
}

// The canonical representative map-value slot for `slot`: the smallest slot reachable from
// it through `repMapValSlotsTwin`. This must follow the whole chain rather than returning at
// the first twin (D300): the relation is sound but not transitive, so a first-twin return can
// disagree with itself, tripping the `emitFail` that does not halt and walks off a parallel table.
export function mvCanonRepOf(slot: i32): i32 {
  if slot < 0 { return slot }
  let cur = slot
  let moved = true
  while moved {
    moved = false
    let t = 0
    while t < cur {
      if repMapValSlotsTwin(t, cur) == 1 {
        cur = t
        moved = true
        t = cur
      }
      t = t + 1
    }
  }
  cur
}

// True if a `+` expression has a string literal anywhere in its chain — the syntactic
// concat test `anonFieldCode` can run where `exprIsStrConcat` cannot: a field value is
// classified during `collectS`, before the locals a typed-operand test needs exist, so
// there is no `fnIx` to ask. Walks the whole chain, since `+` associates left.
function plusChainHasStrLit(ix: i32) {
  const e = P.nodes[unwrapParen(ix)]
  if e is StrLit { return true }
  if e is BinExpr {
    if e.binOp == "+" {
      if plusChainHasStrLit(e.binLeft) { return true }
      return plusChainHasStrLit(e.binRight)
    }
  }
  false
}

// `nodeTyName` returns "" for a type it will not spell, and `anonFieldCode` uses that
// emptiness as a gate on both of its paths. This is that gate's own partition, read off the
// type so it can apply without building the string: non-empty for a non-void `TyPrim`, a
// `TyObj`, a `TyFunc`, or a `TyArray`; "" for everything else. Copied from those arms directly.
function anonTySpellable(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName != "void" }
  if t is TyObj { return true }
  if t is TyFunc { return true }
  if t is TyArray { return true }
  false
}

// The member-set name an anonymous literal's value-union field records, or "" when it is
// not one. Two load-bearing conjuncts: the arena must grade the type a value union
// (`fieldCodeOfTy == 16`), and the render must produce a name the registry accepts, since
// that string is the box's key at intern time and at every read.
function anonUnionFieldName(valIx: i32): string {
  if valIx < 0 { return "" }
  const ty = nodeTyIxOf(valIx)
  if ty < 0 { return "" }
  const nm = tyToEmitName(ty)
  if nm == "" { return "" }
  // The two rungs the declared ladder ends on, in order: `isValueUnionName` for a union of
  // atoms (plus null), then `isUName` for a registered struct or heterogeneous one — which
  // `fieldCodeOfTy` declines by design, its own rung being the value-union half alone.
  if fieldCodeOfTy(ty) == 16 {
    if isValueUnionName(nm) { return nm }
    return ""
  }
  // Matched on either registry column (`unionRowOf`), not `isUName`, which reads alias
  // names alone while `tyToEmitName` renders a union alias as its member set — without
  // this a `type AB = A | B`-valued field kept minting nothing.
  if unionRowOf(nm) >= 0 { return nm }
  // The arena, once the render has declined: `unRowOfCanon` keys the registry on the
  // type's canonical id rather than a spelling, so a declared union whose render is
  // structural still finds its row.
  const ur = unRowOfCanon(ty)
  if ur >= 0 { return unNames[ur] }
  ""
}

export function anonFieldCode(valIx: i32) {
  if valIx < 0 { return -1 }
  // The packed byte list has no field code (`fieldTypeIsDeferred`), so no synthetic row may
  // claim one for it — this is the one rung that can see the difference, since every rung
  // below reads the literal's own type and a bare `[7]` never infers `u8[]`. `nodeRepTyIxOf`
  // carries the destination the literal adopts, asked here ahead of all three guessing rungs.
  if tyIsU8ArrayTy(nodeRepTyIxOf(valIx)) { return -1 }
  const syn = anonFieldCodeSyn(valIx)
  if syn >= 0 { return syn }
  // A value-union field value is the shared box, code 16 — the same code the declared twin
  // gets from `isValueUnionName`. Checked ahead of the spellability gate on purpose:
  // `nodeTyName` spells no union, so that gate would refuse the whole literal a row (D1242).
  // `anonUnionFieldName` supplies the companion column the admission rule needs.
  if anonUnionFieldName(valIx) != "" { return 16 }
  // The gate, then the arena, then the render: `anonTySpellable` keeps an unspellable type
  // out of both paths, which a naive hoist of the arena rung drops — regressing a
  // generic-alias reresolve to a loud reject. With the gate preserved, the render is built
  // only when the arena declines, so a miss on either half gives the same -1.
  if !anonTySpellable(nodeTyIxOf(valIx)) { return -1 }
  const anonTy = nodeTyIxOf(valIx)
  const anonArena = fieldCodeOfTy(anonTy)
  if anonArena != -2 {
    if !anonCodeAdmitsValue(anonArena, valIx) { return -1 }
    return anonArena
  }
  const tn = nodeTyName(valIx)
  if tn == "" { return -1 }
  // The arena rung first: `nameFieldCodeTy` takes `fieldCodeOfTy` first, the confirm-only
  // rung that answers where the arena decides the code exactly and returns -2 otherwise, and
  // falls back to this same name ladder. The render above stays as the fallback's input; the
  // `tn == ""` guard keeps an unspellable type out of both paths.
  const c = nameFieldCodeTy(tn, anonTy)
  // A nested-struct field fed by a non-literal (D1543): the name ladder codes a field by its
  // rendered type, and an anonymous literal's struct-valued field renders structurally even
  // where the value carries a declared alias, which `fieldCodeOfSpelling` has no code for.
  // Gated on the companion resolving, the same bargain `anonCodeIsSelfContained` requires.
  if c < 0 {
    if fieldCodeForMatch(anonTy) == 15 {
      if anonFieldElemName(valIx, 15) != "" { return 15 }
    }
  }
  if !anonCodeAdmitsValue(c, valIx) { return -1 }
  c
}

// The struct row a code-5 (struct-ref list) field's element names, read from the arena, or
// -1 (D1515). A list produced by anything but an array literal of object literals has no
// element node to read a row off; `repRowOfTyStruct` turns the recorded element type into
// the row the emitter interns through instead.
function anonRefListElemRow(valIx: i32): i32 {
  if valIx < 0 { return -1 }
  const ty = nodeTyIxOf(valIx)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyArray { return repRowOfTyStruct(t.aElem, sScanLim()) }
  -1
}

// Is field code `c`'s wasm slot decided by the code alone, with no companion column beside
// it? The codes here are the ones whose slot is a module-global heap type or a raw valtype —
// the scalars, the string ref, the scalar-backed list wrappers, and the closure fat pointer.
// Widening this set means widening `anonFieldElemName` in the same change, not relaxing the gate.
function anonCodeIsSelfContained(c: i32) {
  if c == 0 || c == 3 || c == 17 || c == 23 || c == 24 { return true }
  if c == 4 || c == 6 || c == 25 || c == 26 || c == 27 || c == 35 {
    return true
  }
  c == 14
}

// The admission rule the recorded-type rung actually applies: `anonCodeIsSelfContained` plus
// the one code that needs a companion and can now supply it, stated where the value is in
// hand (D1515).
function anonCodeAdmitsValue(c: i32, valIx: i32) {
  if anonCodeIsSelfContained(c) { return true }
  c == 5 && anonRefListElemRow(valIx) >= 0
}

// The width of an arithmetic field value, from the arena, falling back to i32 (D1586): the
// operator alone is not the answer, since `{ f: mkF64() - mkF64() }` stores an f64 into an
// i32 field if coded by operator. The i32 fall-back stays for a value whose type the
// checker never recorded, since i32 is what the surrounding ladder assumes there.
function anonArithFieldCode(valIx: i32) {
  const bk = tyKindOf(nodeTyIxOf(valIx))
  if bk == 10 { return 23 }
  if bk == 11 { return 17 }
  if bk == 13 { return 24 }
  0
}

// The syntax half of `anonFieldCode` — the field value's own literal form. Kept separate
// so the recorded-type fallback above cannot shadow a context-adopted literal rep: every
// arm here is a fact about the literal the checker's recorded type either does not carry
// or carries less exactly.
function anonFieldCodeSyn(valIx: i32) {
  const e = P.nodes[valIx]
  if e is NumLit {
    // A float `.` literal field is an f64 slot (code 17) — unless the context adopted an
    // f32 slot (`objRetWidenAdopt`'s f32-field arm): code 24, re-encoding exactly at the
    // field store.
    if numLexIsFloat(e.numText) {
      if tyKindOf(nodeTyIxOf(valIx)) == 13 { return 24 }
      return 17
    }
    // An i64-magnitude literal field is an i64 slot (code 23) — an i32-coded shape would
    // `struct.new` the i64 operand into an i32 field, invalid wasm (a lambda-returning
    // `{f: i64}` hole; an annotated return shape already codes 23 via `fieldTypeCode`).
    if !numLexFitsI32(e.numText) { return 23 }
    // A small int literal whose context adopted a wider slot (`objRetWidenAdopt`, a lambda
    // returning `{f: 5}` against `() => {f: i64}`): code the wide slot, since the literal
    // re-encodes at the field store. Without the f32 rung, `anonValueFitsField` reads an
    // integer literal in an f32 field as a plain i32 against the f32 slot.
    const tk = tyKindOf(nodeTyIxOf(valIx))
    if tk == 10 { return 23 }
    if tk == 11 { return 17 }
    if tk == 13 { return 24 }
    return 0
  }
  if e is BoolLit { return 0 }
  if e is StrLit { return 3 }
  if e is FuncDecl { return 14 }
  if e is Ident {
    if nameNamesFunction(e.identName) { return 14 }
    return -1
  }
  // An arithmetic field value is i32 unless the arena says otherwise; a `+` whose operand
  // is a string literal is a concat, not classifiable here.
  if e is BinExpr {
    const bop = e.binOp
    if bop == "-" || bop == "*" || bop == "/" || bop == "%" {
      return anonArithFieldCode(valIx)
    }
    if bop == "+" {
      // Whole chain, not one level: `"a" + f(x) + g(y)` associates left, so its outermost
      // `+` has neither operand a string literal. Reading that as arithmetic would code
      // the field i32 and then store a string ref into it.
      if plusChainHasStrLit(valIx) { return -1 }
      return anonArithFieldCode(valIx)
    }
    return -1
  }
  // A numeric-element array literal field: an i32 list (code 4), or the f64/i64 scalar-list
  // codes (25/26) when any element is a float or i64-magnitude literal — the same leaf split
  // the NumLit field takes. All elements scan, since coding by the first element alone let a
  // mixed-magnitude list intern an i32-list field and emit an i64 const into the i32 array.
  if e is ArrayLit {
    if e.arrElems.length > 0 {
      const ae0 = P.nodes[e.arrElems[0]]
      if ae0 is NumLit {
        let anyFloat = false
        let anyI64 = false
        let i = 0
        while i < e.arrElems.length {
          const ae = P.nodes[e.arrElems[i]]
          if ae is NumLit {
            if numLexIsFloat(ae.numText) { anyFloat = true }
            else if !numLexFitsI32(ae.numText) { anyI64 = true }
          }
          // A non-literal element (a param read) stays unexamined, as before —
          // only the literal elements steer the leaf split.
          i = i + 1
        }
        // Mixed float and i64-magnitude literals join as a checker-level union, not a
        // scalar list — unclassifiable here (-1), the loud path.
        if anyFloat && anyI64 { return -1 }
        if anyFloat { return 25 }
        if anyI64 { return 26 }
        return 4
      }
      // A list-of-anonymous-struct field is the struct ref list, code 5: the parser
      // interns children before parents, so each element literal already has its own row.
      // Every element must resolve to the same row, or coding it 5 would intern a field
      // whose `sFieldElemName` names one arm while its values build another (D1443).
      if ae0 is ObjLit {
        const e0si = structIndexOfObj(e.arrElems[0])
        if e0si < 0 { return -1 }
        let j = 1
        while j < e.arrElems.length {
          const aej = P.nodes[e.arrElems[j]]
          if !(aej is ObjLit) { return -1 }
          if structIndexOfObj(e.arrElems[j]) != e0si { return -1 }
          j = j + 1
        }
        return 5
      }
    }
    return -1
  }
  // A nested object-literal field is a nested-struct ref (code 15) once the inner
  // literal's shape resolves — the parser interns children before parents, so a linear
  // collect sees it.
  if e is ObjLit {
    if structIndexOfObj(valIx) >= 0 { return 15 }
    return -1
  }
  // A map-producing field value is a map field, code 19. The literal carries no
  // annotation, so both halves of the map's rep come off the type the checker recorded on
  // the call. The lowerability gate is the same one the annotated field position uses: an
  // unsupported value type leaves the shape un-interned and the literal fails loudly.
  if e is Call {
    if nodeTyIsMap(valIx) {
      if mapNodeValKindLowerable(valIx) { return 19 }
    }
    return -1
  }
  -1
}

// The `sFieldElemName` entry for an anonymous-shape field: a map field (code 19) records
// its value name, read off the recorded type instead of an annotation; a code-15 field
// records the nested struct's table name. "" otherwise.
export function anonFieldElemName(valIx: i32, code: i32) {
  if code == 19 { return nodeTyMapValName(valIx) }
  // A value-union field (code 16) records its member set, the same column
  // `shapeFieldElemName` fills from the declared spelling. Supplying it is what admits
  // code 16 to `anonFieldCode` at all (D1242).
  if code == 16 { return anonUnionFieldName(valIx) }
  // A struct-ref-list field (code 5) records its element row's name — the companion the
  // emitter resolves the list's element heap type through, the same bargain code 16
  // struck (D1443).
  if code == 5 {
    const av = P.nodes[valIx]
    if av is ArrayLit {
      if av.arrElems.length == 0 { return "" }
      const esi = structIndexOfObj(av.arrElems[0])
      if esi >= 0 { return sNames[esi] }
    }
    // D1515 — the arena, once the literal route has declined: a list produced by anything
    // but an array literal of object literals has no element node, so the recorded element type names the same row.
    const ari = anonRefListElemRow(valIx)
    if ari >= 0 { return sNames[ari] }
    return ""
  }
  if code != 15 { return "" }
  const si = structIndexOfObj(valIx)
  if si >= 0 { return sNames[si] }
  // The value is not always a literal, and its row usually already exists (D1543): a field
  // fed by a binding, call, or member read has no child literal to read a row off. The
  // missing piece is the reverse lookup from the value's recorded type to the row — the
  // declared name first, then a field-set match on the type.
  const nvt = nodeTyIxOf(valIx)
  if nvt < 0 { return "" }
  if nodeTyIsObj(valIx) {
    const cn = nodeTyCanonObjName(valIx)
    if cn != "" {
      const bn = structIndexByName(cn)
      if bn >= 0 { return sNames[bn] }
    }
    const fsr = structRowOfObjFieldSet(nvt)
    if fsr >= 0 { return sNames[fsr] }
    return ""
  }
  // The nullable twin, which `fieldCodeForMatch` already folds onto the same code 15: peel
  // and ask the inner's row, so `{ item: mkMaybe() }` over a `Rec | null` names `Rec` too.
  const nvr = T.tys[nvt]
  if nvr is TyNullable {
    const inr = structRowOfObjFieldSet(nvr.nInner)
    if inr >= 0 { return sNames[inr] }
  }
  ""
}

// The key column of an anonymous-shape field row: true only for an i32-keyed map field,
// whose (key, value) pair is the mv slot's identity — every other code is string-keyed by
// construction. Read off the checker's recorded type, the literal's only spelling of the map.
export function anonFieldElemKeyI32(valIx: i32, code: i32) {
  if code != 19 { return false }
  nodeTyMapKeyIsI32(valIx)
}

// ── the field-code classifier's arena rung ──
// Answers primitive-keyword tests directly, since the arena went string-free. Confirm-only:
// it answers only where the arena decides the code exactly, returning -2 to the name ladder
// otherwise, since composites, closures, maps, and unions need emitter interning state the arena lacks.
function fieldCodeOfTy(ty: i32): i32 {
  if ty < 0 { return -2 }
  // The registration split the two ladders beside this one make: a registered literal-union
  // alias reps as the interned atom, an unregistered inline set as a string ref.
  if tyIsLitUnionAlias(ty) { return 0 }
  if tyIsLitUnion(ty) { return 3 }
  if tyIsLitUnionArray(ty) { return 4 }
  const t = T.tys[ty]
  if t is TyPrim {
    const p = t.primName
    if p == "i32" { return 0 }
    if p == "boolean" { return 0 }
    if p == "f64" { return 17 }
    if p == "i64" { return 23 }
    if p == "f32" { return 24 }
    if p == "string" { return 3 }
    return -2
  }
  // The two arms `nameFieldCode` reads off the spelling, asked of the type instead. Order
  // matters, mirroring the text ladder: a nullable closure is the nullable fat-pointer 22,
  // tested before the bare arrow (closure rep 14). A union carrying a closure member is a
  // value union (the box), not a closure field, so `TyUnion` falls through here as it should.
  if t is TyNullable {
    const inner = T.tys[t.nInner]
    if inner is TyFunc { return 22 }
  }
  if t is TyFunc { return 14 }
  // The array arm mirrors `fieldCodeOfSpelling`'s `scalarListKindOfName` ladder, deliberately
  // narrower: an unrecognised element stays uncoded (-2) and falls through to the render,
  // rather than a blanket 5 (struct/union/closure only). No `TyObj` arm: the spelling
  // ladder's declaration scan lets a forward reference tie into the shared rec group.
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyPrim {
        const ep = et.primName
        if ep == "i32" { return 4 }
        if ep == "boolean" { return 4 }
        if ep == "string" { return 6 }
        if ep == "f64" { return 25 }
        if ep == "i64" { return 26 }
        if ep == "f32" { return 27 }
      }
      // The spelling ladder's fall-through is `return 5` for any other `X[]`, but "other"
      // there already excludes the nullable-element and litunion families by name. Reaching
      // this point from the arena has not, so a blanket 5 would mis-code a nullable-element
      // list and trap on an out-of-bounds index. Code 5 names struct/union/closure only.
      if et is TyObj { return 5 }
      if et is TyUnion { return 5 }
      if et is TyFunc { return 5 }
      // A nested list and a map-element list are ref lists too, claimed by no arm above the
      // spelling ladder's fall-through — only the nullable element families are, which is why
      // `TyNullable` stays out (B171).
      if et is TyArray { return 5 }
      if et is TyMap { return 5 }
    }
  }

  // A value union is the box, code 16 — the arm the name ladder states as
  // `isValueUnionName(t)`. Placed last so every arm the arena already claims still wins.
  // `isValueUnionTyOr` declines rather than guess, so a literal union (`TyLit` members,
  // answering 0) can never be claimed as a box.
  if isValueUnionTyOr(ty) == 1 { return 16 }
  -2
}

// `nameFieldCode` with the caller's recorded arena type for the field — arena rung first,
// the spelling ladder unchanged behind it.
export function nameFieldCodeTy(t: string, ty: i32): i32 {
  const a = fieldCodeOfTy(ty)
  if a != -2 { return a }
  nameFieldCode(t)
}

export function nameFieldCode(t: string) {
  // A nullable function field text is the nullable closure fat-pointer, code 22 — the
  // text reading of `fieldTypeCode`'s `nulCloFlag` arm.
  if nameIsNulClosure(t) { return 22 }
  // A function-typed field name (a top-level arrow) is the closure rep, code 14.
  // Depth-aware (`annArrowAt`, not a substring test): a union carrying a closure member
  // nests its arrow in parens and is a value union (code 16), which a substring test would
  // mis-claim as a bare closure and mismatch the box ref against the closure-typed field.
  if annArrowAt(t) >= 0 { return 14 }
  // -1: there is no node, so the literal-union arm is decided from the spelling.
  fieldCodeOfSpelling(t, -1)
}

// Interns each union arm whose core (trailing `[]`s peeled) is an inline `{…}` shape, via
// `internShapeDeep` — the shared body of the paren-free and paren-carrying splits. The bare
// `{` opener test at index 0 is the one grammar character-test this file keeps, since no
// existing brace-family predicate covers a bare `len >= 1` opener test.
function internShapeArms(set: string, arms: string[]) {
  // Arena hand-over: `arms` is `splitUnionAtoms(set)`, and `unionMemberTysOf` appends the
  // row's member types in exactly that order by construction, since a multi-arm `set`
  // reaches `unionRowOf` through the row whose recorded set spelling is this string. An
  // uncovered row leaves every arm at -1, so the unhinted call is unchanged.
  const armTys: i32[] = []
  let cov = unionMemberTysOf(set, armTys)
  if armTys.length != arms.length { cov = false }
  let uai = 0
  while uai < arms.length {
    let armTy = -1
    if cov { armTy = armTys[uai] }
    const uCore = arrLeafNameOf(arms[uai])
    if uCore.length >= 1 && uCore[0] == '{' {
      internShapeDeepTy(arms[uai], armTy)
    } else if annArrowAt(normTypeAtom(uCore)) >= 0 {
      // A closure arm: the inline shapes buried in its params or result are otherwise
      // unreachable, since the arm is one spelling inside the union name. Routed through
      // the soundness-gated functype interner, which keeps an unsupported-field shape
      // un-interned — a clean reject, never invalid wasm.
      internFuncTypeShapesTy(arms[uai], armTy)
    }
    uai = uai + 1
  }
  0
}

function tyStepNullable(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  -1
}

function tyStepElem(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyArray { return t.aElem }
  -1
}

function tyStepMapVal(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyMap { return t.mVal }
  -1
}

// The `TyFunc` arms of the same family: `annFnDecompose` hands back the param texts and the
// result text, and these hand back the matching arena entries, declining unless the arena
// really is a function of exactly that arity — an arity mismatch is a different function.
function tyStepParam(ty: i32, i: i32, n: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyFunc {
    if t.fnParamTypes.length != n { return -1 }
    return t.fnParamTypes[i]
  }
  -1
}

function tyStepRet(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyFunc { return t.fnRet }
  -1
}

// Peels the arena twin of a trailing-`[]` run, sized by how much the name shortened:
// `arrLeafNameOf` shortens by exactly two characters per layer, so the layer count is the
// length delta halved. An odd delta, or a layer the arena lacks, declines.
function tyStepArrRun(ty: i32, full: string, leaf: string): i32 {
  if ty < 0 { return -1 }
  let t = ty
  let n = full.length - leaf.length
  while n >= 2 {
    t = tyStepElem(t)
    if t < 0 { return -1 }
    n = n - 2
  }
  if n != 0 { return -1 }
  t
}

// `tyStepNullable`, but only when the name actually lost its `| null` — a non-nullable
// spelling keeps its own type rather than declining.
function tyStepNulIf(ty: i32, full: string, base: string): i32 {
  if ty < 0 { return -1 }
  if base.length == full.length { return ty }
  tyStepNullable(ty)
}

export function internShapeDeep(nm: string) { internShapeDeepTy(nm, -1) }

// Recursively peels the composition wrappers off a type name — grouping parens, a trailing
// `| null`, and trailing `[]` suffixes, in any order and to any depth — interning the
// inline-shape struct reached at the bottom. A non-shape leaf (`i32`, a named type, a map)
// interns as a no-op.
export function internShapeDeepTy(nm: string, ty: i32) {
  if nm.length < 2 { return 0 }
  // Peels only a grouping pair that wraps the whole name. A functype whose leading `(` is
  // its own param list must not be blind-peeled — the garbled remainder dead-ends every case
  // below, so the shapes buried in its result spine never intern.
  const uw = normTypeAtom(nm)
  if uw.length != nm.length { return internShapeDeepTy(uw, ty) }
  // A value union leaf registers its box reps. Its `| null` is not peeled: here the null is
  // a union atom (a tag in a non-null box), not a nullable-niche wrapper. Checked after the
  // parens peel but before the `| null` peel, which would lose the atom.
  if isValueUnionName(nm) {
    registerValueUnionNameAB(7, nm, ty)
    // A closure atom of the value union may bury inline shapes in its params or result,
    // unreachable through the box registration alone. Descended through the
    // soundness-gated functype interner, which keeps an unsupported-field shape
    // un-interned — a clean reject, never invalid wasm.
    if strContains(nm, "=>") {
      const vArms: string[] = []
      splitUnionAtoms(nm, vArms)
      // Paired with the row's arena members the same way `internShapeArms` pairs its
      // composite arms, so the two splits are the same split.
      const vTys: i32[] = []
      let vCov = unionMemberTysOfAB(10, nm, ty, vTys)
      if vTys.length != vArms.length { vCov = false }
      let va = 0
      while va < vArms.length {
        const vc = normTypeAtom(vArms[va])
        if annArrowAt(vc) >= 0 {
          let vTy = -1
          if vCov { vTy = vTys[va] }
          internFuncTypeShapesTy(vc, vTy)
        }
        va = va + 1
      }
    }
    return 0
  }
  // The arrow test runs before the `| null` and `[]` peels: `nameIsElemArray` would claim
  // `() => (f64 | null)[]` as an array, and `nullablePartOf` would claim `(i32) => string |
  // null` (a top-level arrow binds `| null` to its result). A genuinely nullable closure
  // nests its arrow in parens, so the depth-aware `annArrowAt` leaves it to the peel below.
  if annArrowAt(nm) >= 1 && nameIsParenOpen(nm) {
    return internFuncTypeShapesTy(nm, ty)
  }
  const np = nullablePartOf(nm)
  if np != "" { return internShapeDeepTy(np, tyStepNullable(ty)) }
  // A mixed composite union: a top-level `|` here means at least one arm is a composite, so
  // its inline struct/map arms must intern now, before `collectAnonShapes` names the same
  // shape `#anonN` and the union arm's name-based lookup fails to find the reflist slot
  // the literal interns — a silent fall-through to scalar-boxing, invalid wasm.
  if !strContains(nm, "(") {
    // Count before cutting: the split's result is only used when the name has 2+ top-level
    // members, so a single-member name would build and discard one string. `unionMemberCount`
    // is the allocation-free dual (B272), and this is the hottest `splitUnionAtoms` caller in
    // the compiler — the overwhelming majority of reaches here are single-member.
    if unionMemberCount(nm) > 1 {
      const uArms: string[] = []
      splitUnionAtoms(nm, uArms)
      internShapeArms(nm, uArms)
      return 0
    }
  } else {
    // The same count-before-cut on the paren-carrying branch, most reaches single-member.
    if unionMemberCount(nm) > 1 {
      const pArms: string[] = []
      splitUnionAtoms(nm, pArms)
      internShapeArms(nm, pArms)
      // Returns, exactly as the paren-free branch does: the arms below (array, map, and
      // inline-shape peels) would otherwise treat a top-level `|` name as the composite its
      // first arm happens to be — `{[string]:()=>i32}|{w:i32}|null` claimed by `nameIsMap`,
      // for instance. The arms are already interned one line up, so nothing is left to reach.
      return 0
    }
  }
  if nameIsElemArray(nm) {
    return internShapeDeepTy(arrElemNameRaw(nm), tyStepElem(ty))
  }
  // A map name: the inline shapes buried in the value position are otherwise unreachable,
  // since the whole map is one TypeRef name and `internInlineShape` no-ops on a map. Descend
  // into the value so its shapes intern, via position-independent map-value resolution. A
  // named-alias value already interned via its own TypeRef, so this is the inline dual.
  if nameIsMap(nm) {
    return internShapeDeepTy(mapValNameOf(nm), tyStepMapVal(ty))
  }
  gaeEnsure(nm)
  internInlineShapeTy(nm, ty) // no-op for any non-shape leaf
  0
}

// Whether field code `c` is a scalar, string, scalar-list, or nested-struct field — the reps
// a struct lowers as a closure result or param without touching an unsupported composite
// field (a typed-value map, a value-union box, or a ref list). A code-18 nullable i32-backed
// scalar list is lowerable too, since it is the same wrapper slot any non-closure struct uses.
function funcTypeFieldCodeSafe(c: i32): boolean {
  c == 0 ||
    c == 3 ||
    c == 4 ||
    c == 6 ||
    c == 15 ||
    c == 17 ||
    c == 18 ||
    c == 23 ||
    c == 24 ||
    c == 25 ||
    c == 26 ||
    c == 27 ||
    c == 35 ||
    isNulScalarListFieldCode(c)
}

// True if `nm` is a nested array bottoming out at a scalar or string leaf list (kinds
// 4/6/7/8/10, or a deeper recursion over those), never a struct, union, closure, or
// map-element array. The leaf test the closure-result shape gate uses: such a field is a
// plain code-5 ref-list slot whose element machinery is fully interned by `collectA`.
export function nameIsNestedScalarLeafArray(nm: string): boolean {
  if !nameIsRefArray(nm) { return false }
  const k = refArrElemKind(nm)
  if k == 4 || k == 6 || k == 7 || k == 8 || k == 10 { return true }
  if k == 9 { return nameIsNestedScalarLeafArray(refArrElemName(nm)) }
  false
}

// True if `t` is a struct-element array whose element itself lowers as a closure-result
// field: a declared plain struct name (not a union variant, whose list rides the variant
// machinery), or an inline shape that recursively passes `funcTypeShapeLowerable`. A
// nullable-struct element admits too, as the kind-1 struct niche in the same ref-list wrapper.
function structElemArrayLowerable(t: string): boolean {
  if !nameIsElemArray(t) { return false }
  // The element text as written carries any grouping parens the source spelled. Peel the
  // grouping pair, then a `| null` wrapper, so both reach the same admission test the
  // paren-free spelling takes. Without this, the whole closure-result struct stayed
  // un-interned and the body literal fieldset-collided onto its own element row — invalid wasm.
  let base = normTypeAtom(arrElemNameRaw(t))
  const nb = nullablePartOf(base)
  if nb != "" { base = normTypeAtom(nb) }
  if nameIsShapeOpen(base) { return funcTypeShapeLowerable(base) }
  nameIsStructDecl(base) && variantIndexOf(base) < 0
}

// Whether inline shape `nm` lowers as a closure result or param with no unsupported
// composite field, recursing through nested inline shapes. A map, value-union,
// distinct-backing-nullable-list, or closure field makes it un-lowerable, so the shape is
// left un-interned and the closure stays a clean reject, never invalid wasm.
export function funcTypeShapeLowerable(nm: string): boolean {
  if !nameIsShapeSpanEnds(nm) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let okAll = true
  let fieldCount = 0
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] == "" {
      okAll = false
    } else {
      const ftxt = ftexts[fi]
      const fc = nameFieldCode(ftxt)
      if fc < 0 {
        // A nested inline-shape field: recurse into the base shape — lowerable only if
        // it is.
        const base = nonNulBaseOf(ftxt)
        if !funcTypeShapeLowerable(base) { okAll = false }
      } else if !funcTypeFieldCodeSafe(fc) {
        // A code-5 field whose type is a nested scalar-leaf array or a lowerable
        // struct-element array is a plain ref-list slot, lowerable. A code-19 map field
        // whose value kind the mv interner represents is likewise a plain map-struct slot.
        // A registered code-16 union box and a code-22 nullable closure are the same rep the field carries in any non-closure struct.
        if (
          !(fc == 5 &&
            (nameIsNestedScalarLeafArray(ftxt) ||
            structElemArrayLowerable(ftxt) ||
            nameIsClosureArray(ftxt))) &&
          !(fc == 19 && mapValKindLowerable(ftxt)) &&
          !(fc == 16 && isUName(ftxt)) &&
          fc != 22
        ) {
          okAll = false
        }
      }
      fieldCount = fieldCount + 1
    }
    fi = fi + 1
  }
  okAll && fieldCount > 0
}

// Whether the inline shape text `nm` will intern cleanly as a nested struct at the
// `collectA` phase — the pure, intern-free mirror of `internInlineShape`'s acceptance,
// usable during `collectU` before the struct table exists. Acceptance here obligates the
// `collectA` variant-field pass to intern `nm`, and is monotone-safe: a field code can only improve from -1.
export function variantNestedShapeOk(nm: string): boolean {
  if !nameIsShapeSpanEnds(nm) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let okAll = true
  let fieldCount = 0
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] == "" {
      okAll = false
    } else {
      const ftxt = ftexts[fi]
      if nameFieldCode(ftxt) < 0 {
        // A nested inline-shape field (`g: {h: i32}` / `g: {h: i32} | null`):
        // lowerable only if ITS shape is.
        const base = nonNulBaseOf(ftxt)
        if !variantNestedShapeOk(base) { okAll = false }
      }
      fieldCount = fieldCount + 1
    }
    fi = fi + 1
  }
  okAll && fieldCount > 0
}

// The arm's render, spelled the way the arm's own row is coded (D1093): `tyToEmitName`
// renders an inline literal-union field faithfully (code 0), while the variant recorder
// codes the same field from the canon-softened annotation node (code 3). Without this the
// two tables' codes disagree positionally and a field typed as the arm had no rep.
export function armMintShapeName(nm: string) {
  if !nameIsShapeSpanEnds(nm) { return nm }
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let changed = false
  let out = "{"
  let i = 0
  while i < fnames.length {
    if i > 0 { out = out + "," }
    let tx = ftexts[i]
    if nameIsInlineLitUnion(tx) {
      tx = "string"
      changed = true
    }
    out = out + fnames[i] + ":" + tx
    i = i + 1
  }
  if !changed { return nm }
  out + "}"
}

const armDeferStack: string[] = []

// The arm's struct row, one phase before it exists (D1518) — the pure mirror of
// `collectNestedFieldShapes`'s arm-field mint. `armFieldStructRow` reads the struct table,
// but `collectVariantFields` codes an arm's fields during `collectU`, before `collectS`
// builds it, so a field typed as an arm on a declaration that is itself an arm had no code.
export function armFieldDeferredRowOk(base: string): boolean {
  const vi = variantIndexOf(base)
  if vi < 0 { return false }
  if vi >= uVarTyIx.length { return false }
  const aty = uVarTyIx[vi]
  if aty < 0 { return false }
  // The re-entrancy stack (`repCanonKey`'s idiom): the predicate below codes the arm's own
  // fields through `nameFieldCode`, which reaches this rung again, so a self-referential arm
  // asked about itself forever and the compiler trapped rather than refusing. Declining on
  // re-entry keeps that arm's existing loud refusal instead.
  let g = 0
  while g < armDeferStack.length {
    if armDeferStack[g] == base { return false }
    g = g + 1
  }
  armDeferStack.push(base)
  const ok = armPlainLayoutShapeOk(armMintShapeName(tyToEmitName(aty)), 0)
  armDeferStack.pop()
  ok
}

// The arm render's fields, coded, with `variantStructHeapTwinAt`'s own layout guard applied
// (D1518): a gate narrowed ahead of its lowering buys check-clean invalid wasm instead, so
// the two must apply the same rule. Stricter than `variantNestedShapeOk` on purpose: that
// predicate answers "will this intern", this one "will the interned row be the arm's".
function armPlainLayoutShapeOk(nm: string, depth: i32): boolean {
  if depth > 8 { return false }
  if !nameIsShapeSpanEnds(nm) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  if fnames.length == 0 { return false }
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] == "" { return false }
    const c = nameFieldCode(ftexts[fi])
    // A -1 is not a refusal here, it is the render's own spelling: `tyToEmitName` writes a
    // declared target structurally, and an inline shape has no code until it is interned.
    // The variant row codes the same field from the annotation node, where the declared name
    // is still there, so it is 15 either way — the leaf below is what both sides must agree on.
    if c < 0 || c == 5 || c == 15 || c == 28 {
      if !armRefFieldLeafOk(ftexts[fi], depth + 1) { return false }
    }
    fi = fi + 1
  }
  true
}

// The referenced layer, one phase before the struct table exists (D1579) — the mirror of
// the descent `variantStructHeapTwinAt` makes into a 15/5/28 field. The variant row banks
// the declared name while the arm's minted anon row banks the structural render; an arm
// answers through the same deferred predicate, whose `armDeferStack` bounds re-entry.
function armRefFieldLeafOk(txt: string, depth: i32): boolean {
  if depth > 8 { return false }
  if txt == "" { return false }
  const base = nonNulBaseOf(txt)
  if base != txt { return armRefFieldLeafOk(base, depth + 1) }
  if nameIsArray(txt) {
    return armRefFieldLeafOk(arrElemNameRaw(txt), depth + 1)
  }
  // A declared struct name surviving in a structural render is `tyToEmitName`'s recursion
  // stop: every other declared target renders structurally, so a name here means the walk
  // closed a cycle, and the anon row minted from that render does not twin the declared
  // row — the residue this leaves open (D1579).
  if nameIsStructDecl(txt) { return false }
  if nameIsShapeSpanEnds(txt) { return armPlainLayoutShapeOk(txt, depth + 1) }
  armFieldDeferredRowOk(txt)
}

// Interns the plainly-lowerable inline shapes buried in the params or result of a
// function-type name, peeling the grouping, nullable, array, and nested-functype wrappers
// around each position. Only a fully-lowerable struct leaf is interned; an unsupported
// composite field is left un-interned so the closure stays a clean reject, never invalid wasm.
export function internFuncTypeShapes(nm: string): i32 {
  internFuncTypeShapesTy(nm, -1)
}

// `internFuncTypeShapes` with the caller's recorded arena type for `nm` — the functype twin
// of `internShapeDeepTy`, peeled in lockstep with the same name grammar. The name walk stays
// authoritative for every key and stored spelling; the type rides alongside and reaches only
// the `sTyIx` hint at the leaf. A value-union leaf declines, since box registration has no leaf to hint.
function internFuncTypeShapesTy(nm: string, ty: i32): i32 {
  if nm.length < 2 { return 0 }
  // Peels only a grouping pair that wraps the whole name. A functype whose leading `(` is
  // its own param list must not be blind-peeled — that garbles the name, and the shapes
  // buried in a nested functype result never intern.
  const uw = normTypeAtom(nm)
  if uw.length != nm.length { return internFuncTypeShapesTy(uw, ty) }
  // A value-union leaf registers its box reps, exactly as `internShapeDeep`'s value-union
  // arm does, before the `| null` peel (the null is a union atom here, not a nullable
  // wrapper). Without it a producer-less closure-arm annotation left the value box
  // un-minted while a narrowed call's unbox still cast to a default type-0 index — invalid wasm.
  if isValueUnionName(nm) {
    registerValueUnionNameAB(8, nm, ty)
    return 0
  }
  // The arrow split runs before the `| null` peel: a top-level arrow binds `| null` to its
  // result (`nulCloFlag`'s rule), and the naive peel would treat it as a nullable closure,
  // leaving that result's value box unregistered. A genuinely nullable closure nests its
  // arrow in parens, so the depth-aware `annArrowAt` still takes the peel below.
  const fParts: string[] = []
  const fRet = annFnDecompose(nm, fParts)
  if fRet != "" {
    let pi = 0
    while pi < fParts.length {
      internFuncTypeShapesTy(fParts[pi], tyStepParam(ty, pi, fParts.length))
      pi = pi + 1
    }
    return internFuncTypeShapesTy(fRet, tyStepRet(ty))
  }
  const np = nullablePartOf(nm)
  if np != "" { return internFuncTypeShapesTy(np, tyStepNullable(ty)) }
  // A composite-union position: every arm below this line reads one composite, so a
  // top-level `|` that is not a pure value union reached no arm at all and the shapes
  // inside its arms never interned. `internShapeDeepTy` owns that grammar, so this delegates
  // rather than growing a second copy — reached only through a closure result, the arm never ran before.
  if unionMemberCount(nm) > 1 { return internShapeDeepTy(nm, ty) }
  if nameIsElemArray(nm) {
    return internFuncTypeShapesTy(arrElemNameRaw(nm), tyStepElem(ty))
  }
  if nameIsShapeSpanEnds(nm) {
    if funcTypeShapeLowerable(nm) {
      internShapeFieldElemsTy(nm, ty)
      internInlineShapeTy(nm, ty)
    } else {
      // The result struct is not lowerable as a whole (e.g. it carries a plain closure
      // field): the outer shape stays un-interned here, but its nested inline-shape fields
      // and closure fields' result shapes must each still intern their own row, or a
      // literal building the outer shape fieldset-collides onto a same-fieldset twin — invalid wasm.
      internNonLowerableFieldShapesTy(nm, ty)
    }
  }
  0
}

// Descends the fields of a non-lowerable closure-result struct, interning the nested
// inline-shape and closure fields' shapes. Only composite fields (a nested shape, or a
// closure) are descended; a scalar, string, map, or value-union field is left untouched,
// preserving the closure's clean-reject semantics for genuinely-unsupported reps.
function internNonLowerableFieldShapesTy(nm: string, ty: i32) {
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] != "" {
      const ftxt = ftexts[fi]
      // A closure field (`() => {f: i64}`) — intern its result shape. Depth-aware:
      // an inner arrow makes the field a closure regardless of wrappers.
      const fldTy = tyFieldTyOf(ty, fnames[fi])
      if annArrowAt(ftxt) >= 0 {
        internShapeDeepTy(ftxt, fldTy)
      } else {
        // A nested inline-shape field (`{f: string[]}`, possibly `| null` / `[]`
        // wrapped) — peel the wrappers to the `{…}` (non-map) leaf and intern it.
        const nul = nonNulBaseOf(ftxt)
        const base = arrLeafNameOf(nul)
        if nameIsShapeOpen(base) {
          internShapeDeepTy(
            base,
            tyStepArrRun(tyStepNulIf(fldTy, ftxt, nul), nul, base),
          )
        }
      }
    }
    fi = fi + 1
  }
  0
}

// Pre-interns the inline-shape leaves of `nm`'s array-typed fields, so `internInlineShape`'s
// code-5 arm resolves each element name — interning mid-field-loop would corrupt the flat
// `sField*` arrays. The functype twin of `collectNestedFieldShapes`' leaf strip, run only on
// a shape `funcTypeShapeLowerable` accepted, before the shape itself interns.
function internShapeFieldElemsTy(nm: string, ty: i32) {
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] != "" {
      const ftxt = arrLeafNameOf(ftexts[fi])
      // `peeled` — "the loop ran at least once" — IS `leaf != name`: every iteration
      // shortens by exactly two characters, so the peel is the identity iff nothing peeled.
      const peeled = ftxt != ftexts[fi]
      if peeled && nameIsShapeOpen(ftxt) {
        internInlineShapeTy(
          ftxt,
          tyStepArrRun(tyFieldTyOf(ty, fnames[fi]), ftexts[fi], ftxt),
        )
      }
    }
    fi = fi + 1
  }
  0
}

// Interns the inline object-shape text `nm` as an anonymous struct shape, returning its
// struct table index, or -1 when `nm` is not an internable shape. A field whose type is
// itself an inline shape recurses: the nested shape interns first, and only a nested text
// with no code fails the whole shape. Idempotent per field-name+code set (`annShapeIndexOf`).
export function internInlineShape(nm: string) { internInlineShapeTy(nm, -1) }

// True if any raw field-type text in `rawTexts` names a declared generic type parameter as
// an array element (`T[]`, or a paren-grouped nullable union arm), declining to mint
// a shape row before the parameter is substituted.
function shapeFieldsRideTyParam(rawTexts: string[]) {
  if genTyParamNames.length == 0 { return false }
  let gp = 0
  while gp < rawTexts.length {
    const t = rawTexts[gp]
    if nameIsArray(t) && !nameIsI32Array(t) && !nameIsRefArray(t) {
      if fnTyParamName(arrLeafNameOf(t)) { return true }
    }
    // The paren-grouped element `(T | null)[]`: `refArrShapeKind`'s paren-union fall-through
    // is unconditional, so `nameIsRefArray` is true and `rlInternName` would resolve the
    // unregistered `T | null` onto struct row 0 — invalid at run. `refArrShapeKind` answers 1
    // for a resolved nullable-struct element, so skip only on kind 2; every resolved kind keeps its row.
    if nameIsArray(t) && !nameIsI32Array(t) {
      const pu = parenUnionArrElemName(t)
      if pu != "" {
        const nn = nullablePartOf(pu)
        if nn != "" {
          if fnTyParamName(nn) {
            if refArrShapeKind(t) == 2 { return true }
          }
        }
      }
    }
    gp = gp + 1
  }
  false
}

// D831 — a row whose field is already a box over this atom serves this annotation too, so an
// annotation interned after it must not mint a narrower twin and split the program's reps in
// two. `annShapeIndexOf` dedups on exact field codes, so a `??`-joined pair's merged row (coded
// 16) would otherwise miss that dedup and mint a second row for the same value.
function annShapeWiderRowOf(names: string[], codes: i32[], texts: string[]) {
  if !postMonoShapes { return 0 - 1 }
  const sLimW = sScanLim()
  let si = 0
  while si < sLimW {
    if sFieldCount[si] == names.length {
      let allIn = true
      let boxed = false
      let i = 0
      while i < names.length {
        const fi = sFieldIndex(si, names[i])
        if fi < 0 {
          allIn = false
        } else {
          const rc = sFieldTypeAt(si, fi)
          if rc == 16 && codes[i] != 16 {
            boxed = true
            if !unionSetNamesAtom(sFieldElemNameAt(si, fi), texts[i]) {
              allIn = false
            }
          } else if rc == codes[i] {
            if (
              sFieldElemNameAt(si, fi) !=
              shapeFieldElemName(texts[i], codes[i])
            ) {
              allIn = false
            }
          } else {
            allIn = false
          }
        }
        i = i + 1
      }
      if allIn && boxed { return si }
    }
    si = si + 1
  }
  0 - 1
}

// D833 — the row that already holds a `??`-joined leaf family, or -1. A row whose field
// `fname` is a box naming every atom of `set` serves the whole family by construction, so
// there is nothing to mint — the value-side twin of `annShapeWiderRowOf`. Searches every
// row, not only the one claiming `objIx`, since several `??` families can share one row.
export function anonLeafServingRow(
  objIx: i32,
  fname: string,
  set: string,
): i32 {
  const o = P.nodes[objIx]
  if o is ObjLit {
    const nf = o.objFields.length
    const lim = sScanLim()
    let si = 0
    while si < lim {
      if sFieldCount[si] == nf {
        let all = true
        let k = 0
        while k < nf {
          const f = P.nodes[o.objFields[k]]
          if f is FieldInit {
            if sFieldIndex(si, f.fiName) < 0 { all = false }
          } else {
            all = false
          }
          k = k + 1
        }
        if all {
          if anonRowServesLeafSet(si, fname, set) { return si }
        }
      }
      si = si + 1
    }
  }
  0 - 1
}

// D901 — does a row over `objIx`'s field-name set already spell `fname` as a plain scalar
// that is neither end of the folded pair? Then the fold is not this rung's to make: a bare
// numeric literal has no destination column (`2.5` reads f64 whether the field is f64 or
// f32), so folding it there could code the field against a declared row of a different width.
export function anonLeafFoldBlocked(
  objIx: i32,
  fname: string,
  ca: i32,
  cb: i32,
): boolean {
  const o = P.nodes[objIx]
  if o is ObjLit {
    const nf = o.objFields.length
    const lim = sScanLim()
    let si = 0
    while si < lim {
      if sFieldCount[si] == nf {
        let all = true
        let k = 0
        while k < nf {
          const f = P.nodes[o.objFields[k]]
          if f is FieldInit {
            if sFieldIndex(si, f.fiName) < 0 { all = false }
          } else {
            all = false
          }
          k = k + 1
        }
        if all {
          const fi = sFieldIndex(si, fname)
          if fi >= 0 {
            const dc = sFieldTypeAt(si, fi)
            if dc == 0 || dc == 3 || dc == 17 || dc == 23 || dc == 24 {
              if dc != ca && dc != cb { return true }
            }
          }
        }
      }
      si = si + 1
    }
  }
  false
}

export function anonRowServesLeafSet(
  si: i32,
  fname: string,
  set: string,
): boolean {
  if si < 0 { return false }
  const fi = sFieldIndex(si, fname)
  if fi < 0 { return false }
  const parts: string[] = []
  splitUnionAtoms(set, parts)
  // D901 — a folded set is one atom, held by a plain scalar field, not a box. Without this,
  // a second literal of the family would mint a duplicate `#anon` row instead of finding the
  // first's box, and two structurally identical rows serving one family is not cosmetic — a
  // `type mismatch` between them cost a `runs` cell. Only the two codes the fold can spell are served.
  if parts.length == 1 {
    const pc = nameFieldCode(set)
    if pc != 17 && pc != 23 { return false }
    return sFieldTypeAt(si, fi) == pc
  }
  if sFieldTypeAt(si, fi) != 16 { return false }
  const have = sFieldElemNameAt(si, fi)
  let i = 0
  while i < parts.length {
    if !unionSetNamesAtom(have, parts[i]) { return false }
    i = i + 1
  }
  true
}

// Does the value-union member set `set` (`"i32|null"`, the spelling `anonLeafPolyUnionSet`
// mints and `sFieldElemName` records) name `atom` as one of its members? Split with the
// one home `splitUnionAtoms`, so a grouped or spaced spelling reads the same here as at
// the mint.
function unionSetNamesAtom(set: string, atom: string): boolean {
  if set == "" { return false }
  const at = normTypeAtom(atom)
  if at == "" { return false }
  const parts: string[] = []
  splitUnionAtoms(set, parts)
  let i = 0
  while i < parts.length {
    if normTypeAtom(parts[i]) == at { return true }
    i = i + 1
  }
  false
}

// `internInlineShape` with the caller's recorded arena type for `nm`. The hint reaches more
// than the `sTyIx` cell, since the field loop calls `nameFieldCodeTy` and its codes feed
// `annShapeIndexOf`'s key. `rlInternNameTy`'s rule governs: the hint must compute the same
// key, which the `sTyIx` leg does by construction here.
export function internInlineShapeTy(nm: string, tyIx: i32) {
  if !nameIsShapeSpanEnds(nm) { return -1 }
  // Split `x:i32,y:string` into names + codes at depth 0 (`shapeInnerFieldSplit` —
  // the shape layer's ONE field scanner). `texts` keeps each field's type TEXT (a
  // code-16 union field interns its union and records the name in `sFieldElemName`;
  // a code-15 nested field records its base shape).
  const rawNames: string[] = []
  const rawTexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), rawNames, rawTexts)
  // A generic original's inline shape declares no concrete struct, exactly as a generic
  // alias declares none, so it must not be interned: without this a type-parameter array
  // field resolved to "" and `pushFieldStorage` read `rlWrapIdx[-1]`, a compiler crash.
  // Skipping is right because the original is replaced by its instances, never emitted.
  if shapeFieldsRideTyParam(rawTexts) { return -1 }
  const names: string[] = []
  const codes: i32[] = []
  const texts: string[] = []
  let ok = true
  let fi = 0
  while fi < rawNames.length {
    if rawNames[fi] == "" {
      ok = false
    } else {
      let ftxt = rawTexts[fi]
      // Pre-interns any inline shape or value union buried in the field type before
      // classifying: a nullable ref-list field needs its element shape interned for
      // `nameFieldCode` to recognize the non-null part as a ref array. Must run before any
      // row is pushed, so the flat `sField*` arrays are not corrupted by the re-entrant intern.
      const fldTy = tyFieldTyOf(tyIx, rawNames[fi])
      internShapeDeepTy(ftxt, fldTy)
      let fc = nameFieldCodeTy(ftxt, fldTy)
      if fc < 0 {
        // A nested inline-shape field interns the nested shape and stores a struct ref on
        // it under the canonical registered name. An earlier literal may have interned the
        // identical shape as a synthetic `#anonN`, so keying this field by the raw inline
        // spelling instead would block the dedup and leave the element unresolvable at emit.
        const base = nonNulBaseOf(ftxt)
        // The `| null` the name peel just dropped is peeled off the hint too — and only
        // when the name actually shortened, so a non-nullable field keeps its own type.
        const iidx = internInlineShapeTy(base, tyStepNulIf(fldTy, ftxt, base))
        if iidx >= 0 {
          fc = 15
          ftxt = sNames[iidx]
        }
      }
      // The arm-typed field's element name, the interner's copy of `fieldRefElemName`'s rung
      // (D761): `nameFieldCodeTy` already answers 15 for an arm-typed field, so the nested-
      // shape arm above never runs and `ftxt` would stay the arm's name, unresolvable by
      // `structIndexByName`. Recorded as the cross-table twin's name instead.
      if fc == 15 {
        const armRow = armFieldStructRow(nonNulBaseOf(ftxt))
        if armRow >= 0 { ftxt = sNames[armRow] }
      }
      if fc < 0 { ok = false }
      names.push(rawNames[fi])
      codes.push(fc)
      texts.push(ftxt)
    }
    fi = fi + 1
  }
  if !ok { return -1 }
  // The empty shape `{}` is a real zero-field layout, not a parse failure (D1171): a bare
  // `names.length == 0` refusal would leave `{} | null` with no interned shape, a loud
  // reject on a program the alias spelling already compiles and runs. Only a body that is
  // actually empty may mint a zero-field row; a non-empty body splitting into none is malformed.
  if names.length == 0 {
    if nameStripSpaces(groupInnerOf(nm)).length != 0 { return -1 }
  }
  const existing = annShapeIndexOf(names, codes, texts)
  if existing >= 0 { return existing }
  // D831: the wider `#anon` row a literal already interned serves this annotation too.
  const wider = annShapeWiderRowOf(names, codes, texts)
  if wider >= 0 { return wider }
  sDeclared = true
  // Interned under the annotation text itself (`{v:i32}`) — a real key, so
  // `structIndexByName` on the annotation (or on a ref-list element name `{v:i32}[]` ->
  // `{v:i32}`) resolves directly.
  sNames.push(nm)
  recordSRowDeclOfName(nm)
  recordSTyIx(sTyIxOfNameTy(nm, tyIx)) // D0
  sFieldStart.push(sFieldNames.length)
  sFieldCount.push(codes.length)
  // The canonical field order (D622, `fieldNameOrder`): `annShapeIndexOf` above already
  // matches by field name off a sorted field-set id, so the dedup this recorder depends on
  // is unaffected; only the emitted sequence moves.
  const dOrd = fieldNameOrder(names)
  let pj = 0
  while pj < codes.length {
    const pi = dOrd[pj]
    sFieldNames.push(names[pi])
    sFieldTypes.push(codes[pi])
    sFieldCloSig.push(fieldCloSigOf(codes[pi], texts[pi]))
    forceScalarListField(codes[pi])
    // B6b: the row's key column, read off the field's own spelling and asked once for every
    // code, rather than hard-coded `false` for codes 5 and 28 — untrue of a ref-list field
    // whose element is a map. `nameIsI32KeyedMap`'s key cut needs only the `{[K]:` prefix,
    // so it answers correctly for a map spelling's list and `| null` widths too.
    const fkI32 = nameIsI32KeyedMap(texts[pi])
    if codes[pi] == 5 {
      // A ref-list field records its canonical ref-array element name (parens stripped for
      // a value-union element, so it keys the same slot every other union position uses),
      // so `sFieldRefSlot` finds the element's interned slot. Without this an inline-shape
      // ref-list field stored "" and the read failed to resolve the element.
      let e5 = refArrElemName(texts[pi])
      // A ref-list element that is itself an inline shape is invisible to `refArrElemName`
      // until the shape is interned, so it returns "". Pre-interned by
      // `collectNestedFieldShapes`, so here just key it by its stripped text. A nominal,
      // union, or scalar element keeps `refArrElemName`.
      if e5 == "" {
        // The trailing-`[]` cut at its home (`tyname.arrElemNameRaw`). The guard is
        // dischargeable: `codes[pi] == 5` implies `nameFieldCode(texts[pi]) == 5`, since the
        // code and text are pushed together and `fieldCodeOfSpelling`'s single `return 5` is
        // inside `if nameIsArray(t)`.
        const raw5 = arrElemNameRaw(texts[pi])
        if structIndexByName(raw5) >= 0 { e5 = raw5 }
        // A grouping-paren element spelling carries no semantic meaning, but
        // `refArrElemName` keys the paren-free spelling, so peel the grouping pair to key
        // the same slot. Without this the field recorded "" and either failed loudly or,
        // with a same-fieldset twin in scope, fieldset-collided onto its own row — invalid wasm.
        if e5 == "" {
          const uw5 = normTypeAtom(raw5)
          if uw5.length != raw5.length {
            if structIndexByName(uw5) >= 0 { e5 = uw5 }
          }
        }
      }
      sFieldElemName.push(e5)
      recordSFieldElemRow(e5, fkI32) // D5 + B6b
      if isValueUnionName(e5) { registerValueUnionName(e5) }
    } else if codes[pi] == 28 {
      // A nullable ref-list field's element name is the ref-array element of the non-null
      // part; the element shape or union is pre-interned in the parse loop.
      let e28 = refArrElemName(nullablePartOf(texts[pi]))
      if e28 == "" {
        // The same cut home (`tyname.arrElemNameRaw`) and the same discharge: `codes[pi] ==
        // 28` is reachable only through `fieldCodeOfSpelling`'s single `return 28`, which is
        // `nameIsRefArray(nullablePartOf(t))`, and `nameIsRefArray` implies `nameIsArray` —
        // so the guard is dischargeable and the routing stays legal.
        const raw28 = arrElemNameRaw(nullablePartOf(texts[pi]))
        if structIndexByName(raw28) >= 0 { e28 = raw28 }
      }
      sFieldElemName.push(e28)
      recordSFieldElemRow(e28, fkI32) // D5 + B6b
      if isValueUnionName(e28) { registerValueUnionName(e28) }
    } else {
      // Every other code is recorded identically from the field's spelling, so the
      // shape-text table answers: code 16 the union name, 15 the nested-struct target,
      // 19/29 the map's value name, 0/4 the litunion atom name, 30 the niche's union. Only
      // codes 5 and 28 above stay local, resolving through the already-interned tables.
      const en = shapeFieldElemName(texts[pi], codes[pi])
      // The field's own row, projected per code, where the name it accompanies is not
      // one `repElemKey` keys nominally and not a literal union.
      let enTy = -1
      if en != "" {
        if !elemNameIsNominal(en) {
          if !nameIsLitUnionType(en) && !nameIsLitUnionArray(en) {
            enTy = shapeFieldElemRow(
              shapeFieldRowOf(tyIx, names[pi]),
              codes[pi],
            )
          }
        }
      }
      sFieldElemName.push(en)
      recordSFieldElemRowTy(en, fkI32, enTy) // D5 + B6b
      // The union FIELD's name keys its atom set; registering it interns the shared
      // box + the value-box reps it needs (this runs after `collectU`, but before any
      // type-index math).
      if codes[pi] == 16 { registerValueUnionName(en) }
    }
    pj = pj + 1
  }
  sNames.length - 1
}

// Interns the inline shape name `nm` as the named struct `key` — the same field parsing as
// `collectAnnShapes`, but keyed under the alias name so `structIndexByName(key)` resolves
// params, locals, and literals.
export function internShapeAs(key: string, nm: string) {
  const rawNames: string[] = []
  const rawTexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), rawNames, rawTexts)
  const names: string[] = []
  const codes: i32[] = []
  let fi = 0
  while fi < rawNames.length {
    if rawNames[fi] == "" {
      return emitFail("emitProgram: malformed struct field")
    }
    const fc = nameFieldCode(rawTexts[fi])
    if fc < 0 { return emitFail(fieldTypeRefusalMsg(rawTexts[fi])) }
    names.push(rawNames[fi])
    codes.push(fc)
    fi = fi + 1
  }
  if names.length == 0 {
    return emitFail("emitProgram: empty struct alias shape")
  }
  // Field order is canonical (`fieldNameOrder`, D622), the same rule `collectS`'s `TypeDecl`
  // arm applies: `{a: i32, b: i32}` and `{b: i32, a: i32}` are one type to the checker, but
  // two struct rows collapse to one wasm heap type only when their field sequence matches,
  // since `structFieldCodesEq` compares field codes positionally, never names.
  const ord = fieldNameOrder(names)
  sDeclared = true
  sNames.push(key)
  recordSRowDeclOfName(key)
  // Keyed on the shape and not on the alias name: `key` here is a struct-alias union name,
  // so `sTyIxOfName(key)` would answer the arena's union type, and `slotCanonId`'s `TyObj`
  // gate would decline the row, banking -1. Without recording the shape's own type, two
  // aliases of one layout each got their own heap type — check-clean invalid wasm (D441).
  recordSTyIx(sTyIxOfName(nm)) // D0
  sFieldStart.push(sFieldNames.length)
  sFieldCount.push(codes.length)
  let pi = 0
  while pi < codes.length {
    const fx = ord[pi]
    sFieldNames.push(names[fx])
    sFieldTypes.push(codes[fx])
    sFieldCloSig.push(fieldCloSigOf(codes[fx], rawTexts[fx]))
    sFieldElemName.push("")
    // This recorder banks no element name for any code (its rows carry "", since the alias
    // shape's fields are re-derived elsewhere), but the key half is free and read straight
    // off the field's own spelling, so a mono i32-keyed map field names its own map struct.
    recordSFieldElemRow("", nameIsI32KeyedMap(rawTexts[fx])) // D5
    pi = pi + 1
  }
  0
}

// ── the shape-row fieldset index ──
// `annShapeIndexOf`'s three conditions collapse to one key: the multiset of (field name,
// field code), hash-consed so the scan becomes a walk of one bucket. The bucket only
// narrows candidates; every member still faces the unchanged per-candidate test.
let sSetHead: i32[] = []
let sSetTail: i32[] = []
let sSetNext: i32[] = []
let sSetLen = 0

export function shapeSetIxReset() {
  sSetHead = []
  sSetTail = []
  sSetNext = []
  sSetLen = 0
  0
}

// The canonical id of a (field name, field code) multiset, sorted by sid so field order
// cannot change the key. The sid of an element name maps "" to a value no real name can
// take, since an empty element name means "no element", a different fact from "the element
// is the empty spelling" that `sidOf("")` would otherwise conflate.
function elemSid(nm: string): i32 {
  if nm == "" { return -1 }
  sidOf(nm)
}

// The row identity, per field, in canonical (sid-sorted) order: field-name sid, field code,
// element-name sid, map-key bit, litunion-atom bit. Four of the five are live; the atom bit
// is inert by construction (set only under `qb == ""`, which `shapeFieldElemName` never
// yields for the two codes it guards) and stays as a backstop — an incomplete key is a miss, never a wrong answer.
function shapeFieldSetIdOf(
  fnames: string[],
  fcodes: i32[],
  felems: string[],
  fkeys: i32[],
  fatoms: i32[],
): i32 {
  const sids: i32[] = []
  const ord: i32[] = []
  let i = 0
  while i < fnames.length {
    const sd = sidOf(fnames[i])
    let j = sids.length
    sids.push(sd)
    ord.push(i)
    while j > 0 {
      if sids[j - 1] <= sd {
        j = 0
      } else {
        sids[j] = sids[j - 1]
        ord[j] = ord[j - 1]
        sids[j - 1] = sd
        ord[j - 1] = i
        j = j - 1
      }
    }
    i = i + 1
  }
  const a: i32[] = []
  a.push(fnames.length)
  let k = 0
  while k < sids.length {
    const o = ord[k]
    a.push(sids[k])
    a.push(fcodes[o])
    a.push(elemSid(felems[o]))
    a.push(fkeys[o])
    a.push(fatoms[o])
    k = k + 1
  }
  hcShapeSetId(a)
}

// The stored row's own key, read off the flat field columns. `sScanLim` bounds by the
// header columns, not the three detail arrays `shapeRowSetId` reads, so inside a mint's
// header-then-details window it can include a row whose details are short. This index
// never re-keys a row, so a row bucketed mid-construction would keep the wrong key forever.
function sSetLim(): i32 {
  const n = sScanLim()
  // From `sSetLen`, not from 0 — otherwise this guard is O(rows) on every query and puts
  // back the O(rows²) the watermark index exists to remove. Answer-identical: no row below
  // `sSetLen` can be short, since it is complete by the time the index consumes it, and the detail
  // columns only grow within a program.
  let i = sSetLen
  while i < n {
    if sFieldStart[i] + sFieldCount[i] > sFieldElemName.length { return i }
    if sFieldStart[i] + sFieldCount[i] > sFieldNames.length { return i }
    if sFieldStart[i] + sFieldCount[i] > sFieldTypes.length { return i }
    i = i + 1
  }
  n
}

function shapeRowSetId(si: i32): i32 {
  const fn: string[] = []
  const fc: i32[] = []
  const fe: string[] = []
  const fk: i32[] = []
  const fa: i32[] = []
  const st = sFieldStart[si]
  const n = sFieldCount[si]
  let i = 0
  while i < n {
    fn.push(sFieldNames[st + i])
    fc.push(sFieldTypes[st + i])
    const en = sFieldElemNameAt(si, i)
    fe.push(en)
    let kb = 0
    if en != "" {
      if sFieldElemKeyI32At(si, i) { kb = 1 }
    }
    fk.push(kb)
    // A row whose field records no element name is a plain scalar there — a litunion field
    // records its union name — so its atom bit is 0, and the query's is its own text's
    // litunion-ness, the split the refinement's two atom arms make.
    fa.push(0)
    i = i + 1
  }
  shapeFieldSetIdOf(fn, fc, fe, fk, fa)
}

function sSetSync() {
  if sSetLen > sNames.length { shapeSetIxReset() }
  const lim = sSetLim()
  while sSetLen < lim {
    const k = shapeRowSetId(sSetLen)
    while sSetHead.length <= k {
      sSetHead.push(-1)
      sSetTail.push(-1)
    }
    while sSetNext.length <= sSetLen { sSetNext.push(-1) }
    if sSetHead[k] < 0 {
      sSetHead[k] = sSetLen
    } else {
      sSetNext[sSetTail[k]] = sSetLen
    }
    sSetTail[k] = sSetLen
    sSetLen = sSetLen + 1
  }
  0
}

function annShapeIndexOf(names: string[], codes: i32[], texts: string[]) {
  const sLimC = sScanLim()
  sSetSync()
  const qElems: string[] = []
  const qKeys: i32[] = []
  const qAtoms: i32[] = []
  let qi = 0
  while qi < names.length {
    // The same derivation the refinement makes, hoisted: `shapeFieldElemName` is the
    // mint's one home for "what element does this (text, code) record", and "" means the
    // field records none — in which case the atom bit carries the split instead.
    let qb = shapeFieldElemName(texts[qi], codes[qi])
    if qb != "" {
      if codes[qi] == 15 { qb = nonNulBaseOf(qb) }
    }
    qElems.push(qb)
    let kb = 0
    if qb != "" {
      if nameIsI32KeyedMap(texts[qi]) { kb = 1 }
    }
    qKeys.push(kb)
    let ab = 0
    if qb == "" {
      if codes[qi] == 0 {
        if nameIsLitUnionType(texts[qi]) { ab = 1 }
      } else if codes[qi] == 4 {
        if nameIsLitUnionArray(texts[qi]) { ab = 1 }
      }
    }
    qAtoms.push(ab)
    qi = qi + 1
  }
  const qk = shapeFieldSetIdOf(names, codes, qElems, qKeys, qAtoms)
  if qk < 0 || qk >= sSetHead.length { return -1 }
  let si = sSetHead[qk]
  while si >= 0 && si < sLimC {
    if sFieldCount[si] == names.length {
      let allIn = true
      let i = 0
      while i < names.length {
        const fi = sFieldIndex(si, names[i])
        if fi < 0 {
          allIn = false
        } else if sFieldTypeAt(si, fi) != codes[i] {
          // The same field-name set with a different field type is a distinct shape —
          // intern it separately so each annotation resolves its own struct.
          allIn = false
        } else {
          // Same field name and code, but a ref field with a different element type is still
          // a distinct shape: without this, `{f:{f:i32}}` and `{f:{f:{f:i32}}}` (both field
          // `f`, code 15) would wrongly dedup, since the recursion produces identical
          // name+code at every level when field names repeat.
          const en = sFieldElemNameAt(si, fi)
          if en != "" {
            // Unifying this comparison with `shapeFieldElemName` enables merges the rep
            // fuzzer proves unsound: `p2r ((i32) => {f: boolean}[] | {w: i32}) | f64` goes
            // from reject to mismatch, a narrowing test taking the wrong branch. The
            // constant-false on five codes is conservative and stays until the merge is understood.
            let bi = texts[i]
            if codes[i] == 15 { bi = nonNulBaseOf(bi) }
            if en != bi { allIn = false }
          } else if codes[i] == 0 && nameIsLitUnionType(texts[i]) {
            // Atom-identity split (code 0 is layout-shared): a litunion-atom field must not
            // dedup onto a plain i32/boolean row — layout-equal but encoding-different, since
            // the shared row served both and the atom side's member literal emitted as a
            // string ref into the i32 slot, invalid wasm.
            allIn = false
          } else if codes[i] == 4 && nameIsLitUnionArray(texts[i]) {
            // The atom-array sibling: same shared-layout split — the atom-element context
            // is per-row (`sFieldIsLitUnionArray`), so the rows must stay distinct.
            allIn = false
          } else if !sFieldCloSigCompat(si, fi, codes[i], texts[i]) {
            // Signature-identity split, the closure field's twin of the two atom splits
            // above: code 14 is layout-shared, so `{f: () => string}` and `{f: () => i32}`
            // matched here and the second annotation resolved the first's row, leaving its
            // own spelling with no interned shape on a program `vl check` accepts.
            allIn = false
          }
        }
        i = i + 1
      }
      if allIn { return si }
    }
    si = sSetNext[si]
  }
  -1
}

// The registry slot of generic-alias base `name`, or -1.
function gaeIndexOf(name: string) {
  let i = 0
  while i < gaeBases.length {
    if gaeBases[i] == name { return i }
    i = i + 1
  }
  -1
}

// True when a generic-application argument is a FuncDecl type parameter rather than a real
// type — the application belongs to a generic original and denotes no concrete struct. The
// shadow ruling is carried here exactly as `genTyParamArr` carries it, asked of the array
// spelling: a parameter that also names a real type binds nothing, so the application is concrete and must intern.
function gaeArgIsTyParam(arg: string) {
  if genTyParamNames.length == 0 { return false }
  // The leaf, peeled exactly as `genTyParamArr` peels it: `T[][]` is as much a
  // type-parameter array as `T[]` is. Asked of the raw argument this missed `Box<T[]>`,
  // whose substituted field text matches an array-bodied alias at `X := T` exactly —
  // skipping one and not the other let the unskipped half report invalid wasm at run.
  let base = arg
  if nameIsArray(arg) { base = arrLeafNameOf(arg) }
  if !fnTyParamName(base) { return false }
  // Two shadow sets, and the union of them is the answer — neither alone is:
  // `gaeParamShadowed` catches a parameter named for a primitive (without it, `Box<f64>`
  // beside `function idF64<f64>` got skipped and failed loudly on a program master runs);
  // the array accept set below catches a parameter shadowing a declared type instead.
  if gaeParamShadowed(base) { return false }
  const a = base + "[]"
  if nameIsI32Array(a) { return false }
  if nameIsRefArray(a) { return false }
  true
}

// Interns the application `name` ("Box<i32>") as a struct shape, once. A field the emitter
// cannot type (an unbound param, an unsupported shape) leaves the application un-interned —
// its use then fails loudly downstream, never a trap.
export function gaeEnsure(name: string) {
  // The generic-application span test at its home (`annGenAppSpanEnds`): a cheap length
  // reject, a trailing-`>` compare, then a `gaeLtAt` scan, in that order. `gaeLtAt` is
  // re-asked below for the head and argument slices rather than threaded out, costing a
  // second scan only on a name that already ended in `>`.
  if !annGenAppSpanEnds(name) { return 0 }
  const ltAt = gaeLtAt(name)
  if structIndexByName(name) >= 0 { return 0 }
  const gi = gaeIndexOf(gaeHeadNameOf(name, ltAt))
  if gi < 0 { return 0 }
  const pnames: string[] = []
  gaeSplitArgs(gaeParams[gi], pnames)
  const args: string[] = []
  gaeSplitArgs(gaeArgsTextOf(name, ltAt), args)
  if args.length != pnames.length { return 0 }
  // A generic original's application interns nothing, for the same reason its inline twin
  // does not: the original is replaced by its instances and never emitted, and each
  // instance re-runs this pass over its pinned, concrete name. Without the skip, the
  // parameter would substitute for itself and intern as a nominal element name — invalid wasm at run.
  let gp = 0
  while gp < args.length {
    if gaeArgIsTyParam(args[gp]) { return 0 }
    gp = gp + 1
  }
  const names: string[] = []
  const codes: i32[] = []
  const elems: string[] = []
  // The closure-signature column, banked per field for the same reason `ekeys` is: the
  // applied field spelling is the only place the signature is legible and the push loop
  // below lacks it.
  const csigs: string[] = []
  // B6b: the field row's key column, banked per field beside its element name — an
  // applied field spelling is the only place the key is legible, and the push loop below
  // lacks the spelling.
  const ekeys: i32[] = []
  let ok = true
  const fs = gaeFieldStart[gi]
  const fc = gaeFieldCount[gi]
  let fi = 0
  while fi < fc {
    const tn = gaeApplyFieldTy(gaeFieldTyNames[fs + fi], pnames, args)
    // A field that is ITSELF an application (or an array of one) interns
    // depth-first, so the ref/elem lookups below resolve.
    gaeEnsure(arrLeafNameOf(tn))
    let code = nameFieldCode(tn)
    let elem = ""
    if code < 0 {
      // An interned application name is a struct-ref field (`nameFieldCode`
      // only consults TypeDecl names, which an application is not).
      if structIndexByName(tn) >= 0 {
        code = 15
        elem = tn
      } else if fieldTypeIsDeferred(tn) {
        // The instance's field is a deferred rep, so this -1 is the same refusal the
        // declared-struct and struct-alias loops make, reported in their words. The silent
        // `return 0` below is right for every other -1, but wrong here: without this, the
        // instance stayed un-interned and its literal minted its own wrong-backing `#anon` row.
        return emitFail(fieldTypeRefusalMsg(tn))
      }
    } else if code == 5 {
      // The applied element text, raw: an instance field's list element is spelled by
      // `gaeApplyFieldTy`'s substitution, a name the canonicalizing recorder does not key —
      // the one arm this path does not share with the shape-text table. The trailing-`[]`
      // cut is dischargeable: `code == 5` implies `nameIsArray(tn)`, so the two forms compute the identical slice.
      elem = arrElemNameRaw(tn)
    } else if code >= 0 {
      // Codes 15/16/4 are recorded identically from the field's spelling: the nested
      // target, the union name, and the atom-array name. This path deliberately records ""
      // for the map, litunion-atom, nullable-ref-list, and `K | null` codes where the
      // shape-text table records a key — a known, intentional divergence, not merged here.
      elem = shapeFieldElemName(tn, code)
      if code == 16 { registerValueUnionName(elem) }
    }
    if code < 0 { ok = false }
    names.push(gaeFieldNames[fs + fi])
    codes.push(code)
    elems.push(elem)
    csigs.push(fieldCloSigOf(code, tn))
    let ek = 0
    if nameIsI32KeyedMap(tn) { ek = 1 }
    ekeys.push(ek)
    fi = fi + 1
  }
  if !ok { return 0 }
  if names.length == 0 { return 0 }
  sDeclared = true
  sNames.push(name)
  recordSRowDeclOfName(name)
  recordSTyIx(sTyIxOfName(name)) // D0
  sFieldStart.push(sFieldNames.length)
  sFieldCount.push(codes.length)
  // The canonical field order (D622, `fieldNameOrder`).
  const fOrd = fieldNameOrder(names)
  let pj = 0
  while pj < codes.length {
    const pi = fOrd[pj]
    sFieldNames.push(names[pi])
    sFieldTypes.push(codes[pi])
    sFieldCloSig.push(csigs[pi])
    sFieldElemName.push(elems[pi])
    recordSFieldElemRow(elems[pi], ekeys[pi] == 1) // D5
    pj = pj + 1
  }
  0
}

// ── literal-union atoms (`type K = "a" | "b"`) ──
// A literal-union value is an interned i32 id: each distinct member string gets one id,
// interned lazily by its raw `StrLit` text. The literal members come from the checker; the
// emit-side `udVariants` are widened to `"string"` and must not be used.
let litAtomId: {[string]: i32} = Map()

let litAtomNext: i32 = 0

// Seeded around a literal-union boundary (binding init or `==` operand) so a member `StrLit`
// lowers as its interned i32 id instead of a string. The atom analogue of `pendingNulString`.
export let pendingLitUnion: i32 = 0

// Whether the module uses any literal-union type (named or inline). Set once per program by
// a single `P.nodes` scan; every per-node litunion detector early-outs on it, so a program
// with no literal unions pays none of the per-node atom-detection cost.
let gLitUnionUsed: i32 = 0

export function resetLitAtoms() {
  litAtomId = Map()
  litAtomNext = 0
  gLitUnionUsed = 0
  if anyLitUnionUsed() { gLitUnionUsed = 1 }
  // `startStmts` is filled by `collectFns`, so on a compiler instance that emits several
  // programs the collect passes ahead of it still observe the previous program's node
  // indices, and dereferencing one into the re-minted arena traps. Emptied here, ahead of
  // every pass, so a query issued before `collectFns` reads an empty table and declines.
  startStmts = []
  sidResetStartBlockLet()
  0
}

// Drops this file's sid-keyed rows — the `startBlockLetOf` memo. Paired with
// `symbols.sidReset` by the driver, through `emit_sections.sidKeyedTablesReset`.
export function sidResetStartBlockLet() {
  sblVal = []
  sblGen = []
  sblEpoch = sblEpoch + 1
  0
}

export function internAtom(text: string) {
  // One probe, not two: a `.has` guard does not narrow a later `m[k]` read
  // (`map-has-guard-reread`), and this is the atom interner, hit once per literal in the
  // program, so a second probe would be on a real path.
  const atomHit = litAtomId[text]
  if atomHit is i32 { return atomHit }
  const id = litAtomNext
  litAtomId[text] = id
  litAtomNext = id + 1
  id
}

// True if the binding/global at `letIx` is annotated with a literal-union type (an i32-backed atom).
export function letIsLitUnion(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const r = nodeTyIsLitUnionAlias(d.letType)
      return r
    }
  }
  false
}

// True if the binding at `letIx` is un-annotated and its initializer is a literal-union atom.
// Such a local holds an i32 atom id, so it must be the i32 atom slot, not the string ref slot
// its checker type would otherwise pick — which stores the atom into a `(ref $array)` cell,
// invalid wasm. The init-side dual of `letIsLitUnion`.
export function letInitIsLitAtom(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType < 0 && d.letInit >= 0 { return exprIsLitAtom(d.letInit, fnIx) }
    // The module global's face, and only it (D1541): a top-level `const v: "a" | "b" = xs[0]`
    // is already slotted as the atom, so declining here made the read side disagree with the
    // store side. Gated on `globalLetOf`, not `fnIx < 0`, since a module-scope `for`/`if` body
    // has `fnIx == -1` too but its binding is a start-fn local, where the string ref stands.
    if d.letInit >= 0 {
      if globalLetOf(d.letName) == letIx {
        if tyIsLitUnion(nodeTyIxOf(d.letType)) {
          return exprIsLitAtom(d.letInit, fnIx)
        }
      }
    }
    // The annotated face inside a frame is deliberately not claimed (D1196): an annotation
    // that softens to `string` refuses loudly in `checkLocalI32` rather than re-slotting as
    // an atom local, since the store would then write the softened string ref into an atom
    // slot — invalid wasm. Loud-to-silent is the one trade this repo refuses.
  }
  false
}

// True when the binding at `bindIx` (a `Param` or `LetDecl`) holds an interned i32 atom
// rather than a member string — the one question every channel of `exprIsLitAtom` asks about
// a declaration site, matching `vtKindOfType`'s slot sizing. `ownerFnIx` is the frame the
// binding lives in (-1 at module scope), since the un-annotated arm resolves the initializer there.
export function bindingIsLitAtom(bindIx: i32, ownerFnIx: i32) {
  if bindIx < 0 { return false }
  const bn = P.nodes[bindIx]
  if bn is Param {
    // The alias-index question, matching the rep, exactly as `exprIsLitAtom`'s param arm
    // asks it: a narrowed alias is a copy at a fresh index, so the registry misses while
    // the rep layer, which assigns the valtype through this same test, says `i32`.
    return tyLitUnionAliasIx(nodeTyIxOf(bn.parType)) >= 0
  }
  if bn is LetDecl {
    return letIsLitUnion(bindIx) || letInitIsLitAtom(bindIx, ownerFnIx)
  }
  false
}

// The `K | null` NICHE dual of `bindingIsLitAtom`: the binding holds the same i32 atom with
// the spare `-1` encoding null (no box).
function bindingIsNulLitUnion(bindIx: i32, ownerFnIx: i32) {
  if bindIx < 0 { return false }
  const bn = P.nodes[bindIx]
  if bn is Param { return nodeTyIsNulLitUnion(bn.parType) }
  if bn is LetDecl { return letNulLitUnion(bindIx, ownerFnIx) }
  false
}

// True when `name` is a captured variable of lifted function `fnIx` whose enclosing-frame
// binding holds an i32 atom — the capture channel of `exprIsLitAtom`, which otherwise
// resolves an identifier through the reader's own locals, params, and module globals, none
// of which a capture is. Without it a captured atom read as a string, `print` printing the raw id.
function capturedIsLitAtom(fnIx: i32, name: string) {
  bindingIsLitAtom(
    capturedBindingOf(fnIx, name),
    capturedBindingFrameOf(fnIx, name),
  )
}

// The niche dual of `capturedIsLitAtom` — `exprNulLitUnion`'s capture channel. A `K | null`
// capture rides the same i32 env field (`vtKindOfType` answers "i32" for both spellings), so
// both classifiers need the channel or the two spellings disagree about one field.
function capturedIsNulLitUnion(fnIx: i32, name: string) {
  bindingIsNulLitUnion(
    capturedBindingOf(fnIx, name),
    capturedBindingFrameOf(fnIx, name),
  )
}

// ── the declaration fallback, for a body whose expressions record nothing usable ──
// A monomorphized instance shares its leaf expression nodes with the generic body, so the
// checker-recorded type is the generic's — worse than absent, since it looks concrete but
// answers the litunion question falsely. Depth-bounded (32), since a declaration chain is a DAG.
function declFallbackDepthCap() { 32 }

// The element arena type of the array expression `arrIx` when that element is a literal
// union, or -1. `nodeArrayElemIsLitUnion` is exactly the `tyIsLitUnion` of its direct half.
export function arrElemLitUnionTy(arrIx: i32, fnIx: i32) {
  arrElemLitUnionTyAt(arrIx, fnIx, 0)
}

function arrElemLitUnionTyAt(arrIx: i32, fnIx: i32, depth: i32): i32 {
  if arrIx < 0 { return 0 - 1 }
  const direct = nodeArrayElemTyIx(arrIx)
  if tyIsLitUnion(direct) { return direct }
  if depth >= declFallbackDepthCap() { return 0 - 1 }
  const n = P.nodes[unwrapParen(arrIx)]
  if n is Ident {
    const slot = declaredSlotOf(n.identName)
    if slot >= 0 {
      const d = localDeclIx[slot]
      if d >= 0 { return declLitUnionTyAt(d, fnIx, depth, true) }
    }
    const pElem = nodeArrayElemTyIx(paramTypeNode(fnIx, n.identName))
    if tyIsLitUnion(pElem) { return pElem }
  }
  0 - 1
}

// The literal-union arena type an atom-repped expression's members come from, or -1 — the
// `arrElemLitUnionTy` dual for a value that is the atom rather than the array holding it.
export function litAtomMemberTy(exprIx: i32, fnIx: i32) {
  litAtomMemberTyAt(exprIx, fnIx, 0)
}

// The member texts to spell atom-repped node `ix` with — one home for the ladder the two
// widen consumers each wrote out. `exprIsLitAtom` has already decided the value is an atom;
// an empty answer here is a genuine disagreement, refused loudly. The third rung is the
// one-member set (D1460): a promoted one-member discriminant field is a bare `TyLit` atom.
export function litAtomWidenTexts(ix: i32, fnIx: i32) {
  const direct = nodeLitUnionMemberTexts(ix)
  if direct.length > 0 { return direct }
  const decl = tyLitMemberTexts(litAtomMemberTy(ix, fnIx))
  if decl.length > 0 { return decl }
  tyLitMemberTexts(nodeTyIxOf(ix))
}

function litAtomMemberTyAt(exprIx: i32, fnIx: i32, depth: i32): i32 {
  if exprIx < 0 { return 0 - 1 }
  const ix = unwrapParen(exprIx)
  const direct = nodeTyIxOf(ix)
  if tyIsLitUnion(direct) { return direct }
  if depth >= declFallbackDepthCap() { return 0 - 1 }
  const e = P.nodes[ix]
  if e is Index { return arrElemLitUnionTyAt(e.idxArr, fnIx, depth + 1) }
  if e is Ident {
    const slot = declaredSlotOf(e.identName)
    if slot >= 0 {
      // A for-in element loop var IS the array's element, so its members come from the
      // ITERABLE — the one storage class with no declaration node to read.
      const iter = localLoopIter[slot]
      if iter >= 0 { return arrElemLitUnionTyAt(iter, fnIx, depth + 1) }
      const d = localDeclIx[slot]
      if d >= 0 { return declLitUnionTyAt(d, fnIx, depth, false) }
    }
    const pTy = nodeTyIxOf(paramTypeNode(fnIx, e.identName))
    if tyIsLitUnion(pTy) { return pTy }
  }
  0 - 1
}

// The two above, asked of a `LetDecl`: its annotation when it has one, else its initializer
// one hop deeper. `wantElem` picks which question — the declaration's element type or the
// declaration's own type.
function declLitUnionTyAt(
  declIx: i32,
  fnIx: i32,
  depth: i32,
  wantElem: boolean,
): i32 {
  const d = P.nodes[declIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if wantElem {
        const aTy = nodeArrayElemTyIx(d.letType)
        if tyIsLitUnion(aTy) { return aTy }
        return 0 - 1
      }
      const lTy = nodeTyIxOf(d.letType)
      if tyIsLitUnion(lTy) { return lTy }
      return 0 - 1
    }
    if d.letInit >= 0 {
      if wantElem { return arrElemLitUnionTyAt(d.letInit, fnIx, depth + 1) }
      return litAtomMemberTyAt(d.letInit, fnIx, depth + 1)
    }
  }
  0 - 1
}

// True if `exprIx` is a literal-union atom value (an i32 id) — a litunion-flagged local or a
// litunion-annotated param. Distinguishes a real atom from a checker-inferred literal union.
export function exprIsLitAtom(exprIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  // A `K | null` niche binding or call holds an i32 atom id (or the -1 null sentinel). Any
  // position that consumes it as an atom has the checker narrowing it non-null first, so it
  // is a valid atom, with member texts from the node's narrowed type.
  if exprNulLitUnion(exprIx, fnIx) { return true }
  // `p ?? d` over the `K | null` niche is an atom in both halves — a non-null default
  // coalesces the sentinel away to leave the plain atom id, so this asks only whether the
  // rep survives (`coalesceLitUnionFits`). Without it an inferred `const v = p ?? "a"` bound
  // a bare i32 and every atom consumer saw a number instead of the member.
  if coalesceLitUnionFits(exprIx, fnIx) { return true }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident {
    // A captured variable, resolved against the enclosing frame's binding — the same node
    // `captureValKind` sizes the env field from, checked first because a capture shadows
    // nothing: it is by construction neither a local, param, nor global of the reader.
    if capturedIsLitAtom(fnIx, e.identName) { return true }
    const slot = declaredSlotOf(e.identName)
    if slot >= 0 && slot < localLitUnion.length {
      if localLitUnion[slot] == 1 { return true }
    }
    const pt = paramTypeNode(fnIx, e.identName)
    if pt >= 0 {
      // The alias-index question, not the registry one: `tyLitUnionAliasIx` also consults
      // the checker's copy-provenance table, which records the copies narrowing, join, or
      // subtraction mint at fresh indices. This is the same predicate the rep layer uses to
      // assign the valtype, so the consumer agrees with the rep by construction.
      const r = tyLitUnionAliasIx(nodeTyIxOf(pt)) >= 0
      return r
    }
    const gli = globalLetOfIn(fnIx, e.identName)
    if gli >= 0 {
      // An annotated `: K` global, or an un-annotated global whose init is an atom — the
      // global dual of the `localLitUnion` init classification, through the same
      // declaration-site answer the capture channel above asks for.
      return bindingIsLitAtom(gli, -1)
    }
  }
  if e is Index {
    // `xs[i]` over a literal-union array yields an atom element, through the declaration
    // fallback: a monomorphized instance's receiver records the generic's `T[]`, so the
    // direct probe answers false for an array it should claim. Without it, a generic
    // returning the atom emitted a string-ref result over a body yielding the i32 atom — silent invalid wasm.
    if arrElemLitUnionTy(e.idxArr, fnIx) >= 0 { return true }
    // `m[k]` over a litunion-valued map yields the atom id; without the claim a compare
    // falls to string equality with the raw i32 atom — invalid wasm. Unless the members are
    // numbers, whose values have no member id to widen — a case that needs both families in
    // one module to surface, since the classifier sits behind `gLitUnionUsed`.
    const pluIx = unwrapParen(exprIx)
    if nodeTyIsPureLitUnion(pluIx) {
      if numLitUnionBaseTy(nodeTyIxOf(pluIx)) < 0 { return true }
    }
    // The bare read types `K0 | null` (a missing key reads null) — the emit is the i32
    // atom either way (the not-found arm yields a non-member sentinel), so the nullable
    // spelling claims too.
    if nodeTyIsNulLitUnion(unwrapParen(exprIx)) { return true }
    return false
  }
  if e is IfStmt {
    // A value if-expression joining two atoms yields an atom, since the join rep is the
    // bare i32 id. Both arms must be atoms; a mixed atom/string join types `string` instead,
    // widening at the string-join seam, so it deliberately does not classify here.
    if e.ifElse < 0 { return false }
    const tv = ifArmValueExpr(e.ifThen)
    if tv >= 0 {
      if exprIsLitAtom(tv, fnIx) {
        const eb = P.nodes[e.ifElse]
        // An `else if` chain recurses on the nested IfStmt directly.
        if eb is IfStmt { return exprIsLitAtom(e.ifElse, fnIx) }
        if eb is Block {
          const ev = ifArmValueExpr(e.ifElse)
          if ev >= 0 { return exprIsLitAtom(ev, fnIx) }
        }
      }
    }
    return false
  }
  if e is Member {
    // `t0.f` reading a literal-union atom field through a narrowed union receiver or a
    // variant-typed receiver yields the atom — the variant-table twin of the struct-receiver
    // case below, in `memFieldTypeCode`'s dispatch order. Without it the read printed the raw atom id.
    const mIxA = unwrapParen(exprIx)
    let mviA = -1
    if memIsNarrowed(mIxA) {
      mviA = memNarrowVariantIndex(mIxA)
    } else {
      mviA = exprVariantIndex(e.memObj, fnIx)
    }
    // The fifth receiver shape, taken in the same order the field-code twins take it: a
    // bare variant first, then the `Arm | null` niche.
    if mviA < 0 { mviA = memRecvNulVariantIndex(e.memObj, fnIx) }
    if mviA >= 0 {
      const mvfiA = variantFieldIndex(mviA, e.memProp)
      if mvfiA >= 0 && variantFieldTypeAt(mviA, mvfiA) == 0 {
        const rv = variantFieldIsLitUnion(mviA, mvfiA)
        return rv
      }
    }
    // The fourth receiver shape, whose absence causes a silent wrong value: an un-narrowed
    // struct union whose members all carry the field printed the raw atom id instead of the
    // member. `sharedUnionFieldPlan` is the same derivation the dispatch reads, so the atom
    // claim cannot drift; code 0 alone is not sufficient, since it is also plain i32/boolean.
    const avis: i32[] = []
    const afis: i32[] = []
    if sharedUnionFieldPlan(e.memObj, e.memProp, fnIx, avis, afis) == 0 {
      let allAtom = avis.length > 0
      let ai = 0
      while ai < avis.length {
        if !variantFieldIsLitUnion(avis[ai], afis[ai]) { allAtom = false }
        ai = ai + 1
      }
      if allAtom { return true }
    }
    // `b.kind` reading a literal-union atom FIELD yields the atom.
    const msi = structIndexOfExpr(e.memObj, fnIx)
    if msi >= 0 {
      const mfi = sFieldIndex(msi, e.memProp)
      if mfi >= 0 {
        const r = sFieldIsLitUnion(msi, mfi)
        return r
      }
    }
  }
  if e is Call {
    // Any call whose checked result type is an aliased litunion holds an i32 atom, widened
    // at print. Covers a closure value call, a struct-field closure call, and an
    // indexed-closure call, none of which the callee-Ident named arm below can reach. A
    // named call to an inline-litunion-returning function reps as a string ref, correctly excluded.
    if nodeTyIsLitUnionAlias(unwrapParen(exprIx)) { return true }
    // A function-value call whose callee's annotated result is an aliased litunion — the arm
    // above cannot reach inside a monomorphized instance, where the call node is shared with
    // the generic and still records the type variable. `cloCallResultLitUnion` asks the
    // callee's own substituted annotation instead.
    if cloCallResultLitUnion(unwrapParen(exprIx), fnIx) { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 {
        const cf = P.nodes[fnStmts[target]]
        if cf is FuncDecl {
          if cf.fnRet >= 0 {
            const r = nodeTyIsLitUnionAlias(cf.fnRet)
            return r
          }
          // An un-annotated callee, from the flag its own classification recorded: an
          // inferred return has neither a type node nor an annotation, so the signature's
          // result kind is classified from the returned expression, and this reads that
          // banked answer. Without it, a named-litunion tag printed its raw atom id.
          if target < fRetLitAtom.length {
            if fRetLitAtom[target] == 1 { return true }
          }
        }
      }
    }
  }
  if e is BinExpr {
    // `m[k] ?? d` over an atom-valued map yields the atom — the mono vals list holds ids.
    // The method spelling `m.get(k) ?? d` is the same fused get, so the receiver comes from
    // the one fused-read shape home rather than an `is Index` half-set; without the `.get`
    // half this classifier declined and `print` printed the raw atom id.
    if e.binOp == "??" {
      const blRecv = fusedMapReadRecvIx(unwrapParen(e.binLeft))
      if blRecv >= 0 { return nodeTyMapValIsLitUnion(blRecv) }
    }
  }
  false
}

// The ref-list element key of an array spelling, with the deferred fallback the shape-text
// field recorder needs: `refArrElemName`, else the trailing-`[]` cut, else "". A named-struct
// or inline-shape element is invisible to `refArrElemName` while the struct/union tables are
// still empty, so the stripped element text is recorded deferred and interned once they exist.
function refArrElemKeyDeferred(name: string) {
  const e = refArrElemName(name)
  if e != "" { return e }
  // This IS `arrElemNameRaw` character-for-character (guard, cut, `""` otherwise) — it
  // predates the home and is now the home's call.
  arrElemNameRaw(name)
}

// The arena row of shape row `tyIx`'s field named `fnm`, looked up by name. The loop that
// records these walks a filtered field list, so a positional index into `objFieldTypes`
// would not be sound.
function shapeFieldRowOf(tyIx: i32, fnm: string) {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if t is TyObj {
    const fns = t.objFieldNames
    const fts = t.objFieldTypes
    let i = 0
    while i < fns.length {
      if fns[i] == fnm {
        if i < fts.length { return fts[i] }
        return -1
      }
      i = i + 1
    }
  }
  -1
}

// The arm-for-arm twin of `shapeFieldElemName`, projecting the field's row per code: 16/0/4
// the field type is the recorded name's type, 15 the `| null`-stripped nested target, 5/28
// the ref-array element (28 stripped first), 19/29 the map's value (29 stripped first). Code
// 30 declines: its name carries the shape grammar's own separators, which `repElemId` cannot parse.
export function shapeFieldElemRow(fty: i32, code: i32) {
  if fty < 0 { return -1 }
  if code == 16 { return fty }
  if code == 0 { return fty }
  if code == 4 { return fty }
  if code == 15 { return tyShapeNulPeel(fty) }
  if code == 30 { return -1 }
  if code == 5 { return tyShapeArrElem(fty) }
  if code == 28 { return tyShapeArrElem(tyShapeNulPeel(fty)) }
  if code == 19 { return tyMapValOf(fty) }
  if code == 29 { return tyMapValOf(tyShapeNulPeel(fty)) }
  -1
}
function tyShapeNulPeel(ty: i32) {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  ty
}
function tyShapeArrElem(ty: i32) {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyArray { return t.aElem }
  -1
}

// The element or target name a shape-text field records in `uFieldElemName`: a ref-list
// field its element name, a nested-struct field its non-null target name, a value-union
// field its atom-set name; "" otherwise.
export function shapeFieldElemName(ftxt: string, code: i32) {
  if code == 5 { return refArrElemKeyDeferred(ftxt) }
  if code == 15 { return nonNulBaseOf(ftxt) }
  if code == 16 { return ftxt }
  // A nullable ref-list field (code 28): the ref-array element of the non-null part —
  // the shape-text mirror of `fieldRefElemName`'s code-28 arm, with the same
  // deferred-intern fallback code-5 uses for a not-yet-registered struct/union element.
  if code == 28 { return refArrElemKeyDeferred(nullablePartOf(ftxt)) }
  // A map-typed field (code 19) records its value type name — the mv-slot key, the
  // shape-text mirror of `fieldRefElemName`'s code-19 arm. Without it a union variant with
  // a map field recorded "" and every op site failed the loud slot find.
  if code == 19 { return mapValNameOf(ftxt) }
  // A NULLABLE map field (code 29): the `| null`-stripped map's value name — same key.
  if code == 29 { return mapValNameOf(nulMapInnerName(ftxt)) }
  // A literal-union atom field (code 0) or atom-array field (code 4) records its union name,
  // so the variant tables recover the rep and membership — without it construction emitted
  // the raw member string into the i32 atom slot. An inline litunion field (code 3) records
  // its member set for the same reason, since code 3 is layout-shared with a plain string field.
  if code == 3 && nameIsInlineLitUnion(ftxt) { return ftxt }
  if code == 0 && nameIsLitUnionType(ftxt) { return ftxt }
  if code == 4 && nameIsLitUnionArray(ftxt) { return ftxt }
  if code == 4 { return "" }
  // A NULLABLE-litunion niche field (code 30): the non-null union name, the
  // code-0 recording over the `| null`-stripped part.
  if code == 30 { return nulLitUnionInnerName(ftxt) }
  ""
}

// The `sFieldCloSig` column's one producer: the `$fnsig` key a closure field (code 14) or a
// nullable-closure field (code 22) records, "" for every other code. `cloNameSigKey` answers
// "" for a name it cannot decompose, and "" is read as "unknown", never as "no signature", by
// the one consumer.
function fieldCloSigOf(code: i32, ftxt: string) {
  if code != 14 && code != 22 { return "" }
  cloNameSigKey(ftxt)
}

// The same column from the arena instead of a spelling: `sigKeyOfTy` is `annSigKey`'s
// type-taking twin, agreeing by construction, so a row recorded through either provenance
// keys the same signature. The recorder holding a `FieldDef` node has no rendered field
// text, and re-introducing one to feed this column would be the render coming back.
export function fieldCloSigOfTy(code: i32, tyIx: i32) {
  if code != 14 && code != 22 { return "" }
  sigKeyOfTy(tyIx)
}

// Could row `si`'s field `fi` and a query field spelled `(code, ftxt)` be the same closure
// field? "" on either side is unknown, not "no signature", so an unknown answers true and
// the pair keeps whatever behaviour it had before the column existed. Only two signatures
// that both resolve and disagree split.
function sFieldCloSigCompat(
  si: i32,
  fi: i32,
  code: i32,
  ftxt: string,
): boolean {
  const want = fieldCloSigOf(code, ftxt)
  if want == "" { return true }
  const have = sFieldCloSigAt(si, fi)
  if have == "" { return true }
  have == want
}

// The `$fnsig` key recorded for row `si`'s field `fi` (`sFieldCloSig`), "" when the row
// predates the column's fill or the field is not a closure.
function sFieldCloSigAt(si: i32, fi: i32) {
  const at = sFieldStart[si] + fi
  if at < 0 || at >= sFieldCloSig.length { return "" }
  sFieldCloSig[at]
}

// The wasm-type code (`0` i32, `3` string) of variant `vi`'s field at field index `fi`.
export function variantFieldTypeAt(vi: i32, fi: i32) {
  uFieldTypes[uFieldStart[vi] + fi]
}

// The ref-list table SLOT of variant `vi`'s ref-list field `fi`, or -1 if not a ref list.
export function variantFieldRefSlot(vi: i32, fi: i32) {
  // D5: the arena leg — the field's recorded element type resolves the slot through the
  // rep key the layer is already interned on; the recorded name is the fall-through for a
  // row the sidecar does not cover, and for `rlSlotByName`'s struct-twin rung, which has no arena input.
  const ety = uFieldElemTyIxAt(vi, fi)
  const a = rlSlotOfTy(ety)
  if a >= 0 { return a }
  // The fall-through's rung 2 reads that same index rather than re-resolving the name beside
  // it, key-only: the rendered rung below it still answers for a live share of entries here,
  // so it stays laddered — `sFieldRefSlot`'s stronger `rlSlotByNameTy` claim is not this caller's.
  rlSlotByNameKeyTy(uFieldElemName[uFieldStart[vi] + fi], ety)
}

// The ref-list table slot of struct `si`'s ref-list field `fi` — `variantFieldRefSlot`'s
// struct-table twin, living beside it because the cross-table layout guard
// (`variantStructHeapTwinAt`) asks both about one field position (D1579). Same two rungs:
// the recorded element type through the rep key, then the recorded element name.
export function sFieldRefSlot(si: i32, fi: i32) {
  const a = rlSlotOfTy(sFieldElemTyIxAt(si, fi))
  if a >= 0 { return a }

  rlSlotByNameTy(sFieldElemNameAt(si, fi), sFieldElemTyIxAt(si, fi))
}

// `sFieldStorageSlot`'s union-variant twin — the `pushFieldStorage` slot argument for
// variant `vi`'s field `fj`, read by the type section and by the object-literal ORDER
// STASH (D1510) alike.
export function uFieldStorageSlot(vi: i32, fj: i32): i32 {
  const code = variantFieldTypeAt(vi, fj)
  if code == 15 { return uFieldTgtStructIdx(vi, fj) }
  if code == 19 || code == 29 { return uFieldMapShape(vi, fj) }
  variantFieldRefSlot(vi, fj)
}

// The ELEMENT/atom-set NAME recorded for variant `vi`'s field `fi` — a union-box field
// (code 16) records its atom-set name (the key `emitUnionCoerce` boxes against), a
// ref-list its element name, a nested-struct its target. "" for a plain scalar field.
export function variantFieldElemName(vi: i32, fi: i32) {
  uFieldElemName[uFieldStart[vi] + fi]
}

// ── canonical layout twins, variant slot layer ──
// Two union-variant slots share one WasmGC heap type under the two-layer discipline: the
// canonical key of the variant's type (`repNameCanonId`), then a layout guard over field
// storage (`variantFieldLayoutEq`) — code equality plus, for codes 5/15/19, twin equivalence of the referenced layer.

// The per-field storage layout guard (the `structFieldCodesEq` analogue).
function variantFieldLayoutEq(a: i32, b: i32): i32 {
  if uFieldCount[a] != uFieldCount[b] { return 0 }
  let fi = 0
  while fi < uFieldCount[a] {
    const ca = uFieldTypes[uFieldStart[a] + fi]
    if ca != uFieldTypes[uFieldStart[b] + fi] { return 0 }
    if ca == 5 || ca == 28 {
      // Code 28 (`<ref-array> | null`) stores through the same per-slot wrapper as a
      // plain ref-list field — twin equivalence is the same referenced-layer guard.
      if (
        rlSlotsLayoutTwin(
          variantFieldRefSlot(a, fi),
          variantFieldRefSlot(b, fi),
        ) ==
        0
      ) {
        return 0
      }
    } else if ca == 15 {
      if (
        repStructSlotsTwin(uFieldTgtStructIdx(a, fi), uFieldTgtStructIdx(b, fi)) ==
        0
      ) {
        return 0
      }
    } else if ca == 19 {
      // No key comparison here, by witness rather than assumption (B6b): a `{[i32]: V}` and a
      // `{[string]: V}` field do store different map structs, but this guard never runs on
      // such a pair, since `buildVariantTwins` only calls it when `repNameCanonId` already
      // matched — and that key comes off the arena, where the two are `TyMap`s with different key types.
      const ma = mvSlotOfMapValNameOrMonoKTy(
        uFieldElemName[uFieldStart[a] + fi],
        false,
        uFieldElemTyIxRow(uFieldStart[a] + fi),
      )
      const mb = mvSlotOfMapValNameOrMonoKTy(
        uFieldElemName[uFieldStart[b] + fi],
        false,
        uFieldElemTyIxRow(uFieldStart[b] + fi),
      )
      let mOk = false
      if ma == -1 && mb == -1 { mOk = true }
      if ma >= 0 && mb >= 0 {
        if mvCanonRepOf(ma) == mvCanonRepOf(mb) { mOk = true }
      }
      if !mOk { return 0 }
    }
    fi = fi + 1
  }
  1
}

// True when variants `a` and `b` share one WasmGC heap type — the `uVarTwin` equivalence,
// queryable pairwise and independent of `buildVariantTwins` having run, exactly as
// `repStructSlotsTwin` is the pairwise form of `buildStructTwins`. Same two gates in the
// same order: the canonical structural key of the arm's declared name, then the field-layout guard.
export function repVariantSlotsTwin(a: i32, b: i32): i32 {
  if a == b { return 1 }
  if a < 0 || b < 0 { return 0 }
  if a >= uVariants.length || b >= uVariants.length { return 0 }
  // D1023's rung, ahead of the canon-key gate: the key preserves each arm's literal set, so
  // two arms the tag already merged key apart. This pairwise form must answer exactly as
  // `buildVariantTwins` does, since the `$fnsig` producers render off it before `uVarTwin`
  // is filled, and two structurally identical functypes at two rec-group indices are distinct types.
  if variantSig(a) == variantSig(b) && variantLitDiscriminable(a, b) {
    return 1
  }
  const ka = repNameCanonId(uVariants[a])
  if ka < 0 { return 0 }
  if ka != repNameCanonId(uVariants[b]) { return 0 }
  variantFieldLayoutEq(a, b)
}

// The canonical (smallest layout-twin) representative of variant row `vi` — the variant
// layer's `repStructSlotRep` (D199): without it, two layout-twin arms keyed two `$fnsig`s
// while sharing one heap type, and two structurally identical functypes at two rec-group
// indices trap `indirect call type mismatch`. Computed on demand, deliberately not memoized.
export function repVariantSlotRep(vi: i32): i32 {
  if vi < 0 || vi >= uVariants.length { return vi }
  let j = 0
  while j < vi {
    if repVariantSlotsTwin(j, vi) == 1 { return j }
    j = j + 1
  }
  vi
}

// The `$fnsig` slot token of a union-arm param or result — the one place a `V<slot>;` digit
// is minted, so the five producers cannot disagree. It does not fold across the struct table
// (D351): an arm whose layout a declared struct also claims keys `V…;` against the struct's
// `s…;`, since folding trades a `trap_loads` gain for a `runs` loss at the token character.
export function repSigVariantTok(vi: i32): string {
  repSigSlotTokOfKind("variant", repVariantSlotRep(vi))
}

// Populates `uVarTwin` (parallel to `uVariants`): `uVarTwin[i]` is the smallest earlier
// layout twin, or `i` itself when `i` is first of its layout. Keys are computed once up
// front, since the compiler's own unions carry hundreds of variants and a per-pair
// recomputation is the hot path. Called from `mAssignTypeIndices` before heap indices allocate.
export function buildVariantTwins() {
  const keys: i32[] = []
  let i = 0
  while i < uVariants.length {
    keys.push(repNameCanonId(uVariants[i]))
    i = i + 1
  }
  uVarTwin = []
  i = 0
  while i < uVariants.length {
    let rep = i
    if keys[i] >= 0 {
      let j = 0
      while j < i {
        if keys[j] == keys[i] && variantFieldLayoutEq(j, i) == 1 {
          rep = j
          j = i // stop at the first (smallest) twin
        }
        j = j + 1
      }
    }
    // D1023's arms fold here too: the canon key preserves each arm's literal set, so two
    // arms with different literals key differently and miss the guard above, even though
    // `assignTags` already ranked them one tag (same field-name signature). A shared tag with
    // two heap types is not a representation — the other arm's `ref.cast` would trap.
    if rep == i {
      let d = 0
      while d < i {
        if variantSig(d) == variantSig(i) && variantLitDiscriminable(d, i) {
          rep = d
          d = i // the smallest such row, matching the guard above
        }
        d = d + 1
      }
    }
    uVarTwin.push(rep)
    i = i + 1
  }
  uVarSTwin = []
  i = 0
  while i < uVariants.length {
    uVarSTwin.push(variantStructHeapTwinAt(i))
    i = i + 1
  }
}

// The cross-table heap twin: the declared struct slot variant `vi` shares a WasmGC heap type
// with, or -1 (D280) — the checker's rule that two identically-shaped declared types share
// one heap type, applied across the variant/struct seam. Timing-independent: both claimants
// derive their heap from the arm's own arena type, so mint and find agree without observing each other.
const vshtPairVi: i32[] = []
const vshtPairSi: i32[] = []

export function variantStructHeapTwinAt(vi: i32): i32 {
  if vi < 0 { return -1 }
  if vi >= uVarTyIx.length { return -1 }
  if vi >= uFieldCount.length { return -1 }
  let si = repSlotOfTy(uVarTyIx[vi])
  // The anonymous claimant (D282): `repSlotOfTy` answers only for a declared row, so an arm
  // whose only layout-mate is an interned `#anonN` literal row read -1 and minted a second
  // heap type for a checker type that already had one. `repRowOfTyStruct` is the same double
  // gate over a whole-table scan, confirm-only and second, so a declared answer stays untouched.
  if si < 0 { si = repRowOfTyStruct(uVarTyIx[vi], sScanLim()) }
  if si < 0 { return -1 }
  if si >= sFieldCount.length { return -1 }
  if uFieldCount[vi] != sFieldCount[si] { return -1 }
  // D627 — the coinductive pair stack, not a re-entrancy guard: the map-value comparison
  // below can re-enter this function, unbounded on a mutually recursive map-valued shape.
  // Assuming a revisited pair is merged is sound because the answer wanted is the greatest
  // fixpoint of equirecursive type equality — any finite disagreement still unwinds to -1.
  let vsi = 0
  while vsi < vshtPairVi.length {
    if vshtPairVi[vsi] == vi && vshtPairSi[vsi] == si { return si }
    vsi = vsi + 1
  }
  vshtPairVi.push(vi)
  vshtPairSi.push(si)
  let fi = 0
  while fi < uFieldCount[vi] {
    const cv = uFieldTypes[uFieldStart[vi] + fi]
    if cv != sFieldTypes[sFieldStart[si] + fi] { return vshtPop(0 - 1) }
    // The referenced-layer descent both sibling comparators already had (D1579): a field
    // whose storage is a ref (15 a nested struct, 5 a ref list, 28 its niche) declined
    // outright here before, so an arm carrying one shared a heap with no struct row. The two
    // sides record the same field under different spellings, so the question must ask the referenced rows, not the names.
    if cv == 15 {
      if (
        repStructSlotsTwin(
          uFieldTgtStructIdx(vi, fi),
          sFieldTgtStructIdx(si, fi),
        ) ==
        0
      ) {
        return vshtPop(0 - 1)
      }
    }
    if cv == 5 || cv == 28 {
      if (
        rlSlotsLayoutTwin(variantFieldRefSlot(vi, fi), sFieldRefSlot(si, fi)) ==
        0
      ) {
        return vshtPop(0 - 1)
      }
    }
    if cv == 19 || cv == 29 {
      const um = uFieldMapShape(vi, fi)
      if um == -3 { return vshtPop(0 - 1) }
      const sm = sFieldMapShape(si, fi)
      // The widening D624 permits: two mv slots whose value types are layout twins emit
      // byte-identical map structs, so slot-index equality alone would decline a merge the
      // reps already agree on. `mvCanonRepOf` catches it, costing nothing on the corpus and
      // is what makes D627's witness print its value.
      if um != sm {
        if mvCanonRepOf(um) != mvCanonRepOf(sm) { return vshtPop(0 - 1) }
      }
    }
    fi = fi + 1
  }
  vshtPop(si)
}

// Pop the pair stack and pass `r` through — so every exit of the walk above unwinds it
// exactly once, whatever it answers.
function vshtPop(r: i32): i32 {
  if vshtPairVi.length > 0 {
    vshtPairVi.pop()
    vshtPairSi.pop()
  }
  r
}

// The structural signature of variant `vi` — its field names joined with `,` (a
// stable per-shape key). Two variants with the same field-name set share a sig (and
// so, under structural typing, are the same variant — `docs/unions.md`); the slice's
// AST-style unions use DISTINCT field-name prefixes per variant, so every sig differs.
export function variantSig(vi: i32) {
  let out = ""
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  let j = 0
  while j < cnt {
    if j > 0 { out = out + "," }
    out = out + uFieldNames[start + j]
    j = j + 1
  }
  out
}

// ── D1023: the discriminant column's three queries ──
// `is A` over two struct arms that share a field-name set is a discriminant-value test: true
// iff the tag names the shared shape and the value's literal-typed fields are members of
// `A`'s sets. These three answer what `vi`'s members are at field `fi`, whether two arms' sets agree, and whether `fi` needs testing.

// The literal-set member lexemes of variant `vi`'s field `fi` — empty when the field is not
// a literal set. Reads the discriminant column rather than the identity column
// (`uFieldTyText`), since canon softens a multi-member set to its base.
export function variantFieldLitLexes(vi: i32, fi: i32) {
  const none: string[] = []
  if vi < 0 || vi >= uFieldStart.length { return none }
  if fi < 0 || fi >= uFieldCount[vi] { return none }
  const row = uFieldStart[vi] + fi
  if row < 0 || row >= uFieldLitTyIx.length { return none }
  tyLitSetMemberLexes(uFieldLitTyIx[row])
}

// Is LEXEME `lex` one of `lexes`? `emit_base.litLexIsMember`'s twin for a list that is
// already quoted — that one quotes each element before comparing, which would re-quote a
// lexeme and answer false for every member.
function lexInLexes(lex: string, lexes: string[]): boolean {
  let i = 0
  while i < lexes.length {
    if lexes[i] == lex { return true }
    i = i + 1
  }
  false
}

// Do variants `a` and `b` carry the SAME literal set at field `fi`? Set equality, not list
// equality: `"x" | "y"` and `"y" | "x"` are one type, and a test that called them different
// would emit a membership compare that is a tautology in both directions.
function variantFieldLitSetSame(a: i32, b: i32, fi: i32): boolean {
  const la = variantFieldLitLexes(a, fi)
  const lb = variantFieldLitLexes(b, fi)
  if la.length != lb.length { return false }
  let i = 0
  while i < la.length {
    if !lexInLexes(la[i], lb) { return false }
    i = i + 1
  }
  let j = 0
  while j < lb.length {
    if !lexInLexes(lb[j], la) { return false }
    j = j + 1
  }
  true
}

// Must `x is <vi>` test field `fi`'s value, or does the tag already settle it? The gate is
// "another arm shares my tag and disagrees at this field": a variant whose tag is its own has
// nothing to disambiguate, and a same-signature sibling with the same set at `fi` does not
// disagree. Asked directly off `variantSig`, since this runs before `uTags` is filled too.
export function variantDiscrimFieldNeeded(vi: i32, fi: i32): boolean {
  if variantFieldLitLexes(vi, fi).length == 0 { return false }
  const sig = variantSig(vi)
  let vj = 0
  while vj < uVariants.length {
    if vj != vi {
      if variantSig(vj) == sig {
        if !variantFieldLitSetSame(vi, vj, fi) { return true }
      }
    }
    vj = vj + 1
  }
  false
}

// Are variants `a` and `b` — same field-name set, sharing a tag — legal under D1023's ruling:
// one tag, one layout, `is` answering by the discriminant's value? Every field must either
// compare equal, or be a literal set in both arms with the same storage, and at least one
// must be the latter. Two callers must agree (D1050): `assignTags` admits, `buildVariantTwins` merges.
export function variantLitDiscriminable(a: i32, b: i32): boolean {
  variantLitPairKind(a, b) == 1
}

// Would the pair be discriminable if its mixed literal fields got re-laid (D1050)? True
// only for a pair not discriminable as laid out, so the two questions partition. One
// derivation, three readers — `assignTags` admits on this, `unifyMixedLitRepArms` acts on
// it, `buildVariantTwins` folds on it — so the three cannot drift the way copies would.
export function variantLitRepUnifiable(a: i32, b: i32): boolean {
  variantLitPairKind(a, b) >= 2
}

// The pair's D1023 status as one walk: 1 discriminable as laid out, 2 discriminable after
// re-laying mixed literal fields onto the atom rep, 3 onto the string rep (D1460), 0 neither.
// The action is per field, so a pair carrying one of each is admitted here and re-laid twice there.
function variantLitPairKind(a: i32, b: i32): i32 {
  if a < 0 || b < 0 { return 0 }
  if a >= uFieldCount.length || b >= uFieldCount.length { return 0 }
  if uFieldCount[a] != uFieldCount[b] { return 0 }
  let sawLit = false
  let sawMixed = false
  let sawStrMixed = false
  let fi = 0
  while fi < uFieldCount[a] {
    const ra = uFieldStart[a] + fi
    const rb = uFieldStart[b] + fi
    const codeEq = uFieldTypes[ra] == uFieldTypes[rb] &&
      uFieldElemKeyI32At(a, fi) == uFieldElemKeyI32At(b, fi)
    const storageEq = codeEq && uFieldElemName[ra] == uFieldElemName[rb]
    // Either, not both: a literal set beside its own base is legal, and the base arm has
    // no set to record. The code column keeps this honest: `{v: i32} | {v: boolean}` has
    // both codes 0 and neither a set, so it falls to the equality rung and parts on its
    // type text — the checker is the stricter gate regardless.
    const eitherLit = uFieldLitTyIx[ra] >= 0 || uFieldLitTyIx[rb] >= 0
    // The elem-name column is an identity here, not a storage, so the discriminant rung
    // drops it while the equality rung keeps it. A litunion field records its alias name
    // there, but every alias of a string literal set reps as the same interned i32 atom, so
    // requiring names to match would refuse the alias spelling of a pair the ruling makes legal.
    if codeEq && eitherLit {
      sawLit = true
    } else if variantFieldLitRepMixed(a, b, fi) {
      // The D1050 field: a string literal set in both arms, differing only across the
      // atom/string seam — not a layout they share today (kind 2, never 1), but one
      // `unifyMixedLitRepArms` can give them, since both sets are interned-atom material.
      sawLit = true
      sawMixed = true
    } else if variantFieldLitRepStrMixed(a, b, fi) {
      // The D1460 field: an atom-repped set beside its own base. The base arm holds an
      // arbitrary string with no interned id, so the atom is the rep they cannot share and
      // the string is the one they can — the same layout the pair already has when the set
      // arm is spelled inline, which runs today.
      sawLit = true
      sawStrMixed = true
    } else if !(storageEq && uFieldTyText[ra] == uFieldTyText[rb]) {
      // Neither a discriminant candidate nor equal — the arms genuinely differ at a field
      // whose values `is` has no way to compare.
      return 0
    }
    fi = fi + 1
  }
  if !sawLit { return 0 }
  // The kinds are reported most-constrained first, but the action is per field and both
  // re-lays run, so a pair carrying one field of each is served correctly either way. The
  // demotion is a sink — a base partner cannot be atomised — which makes the pair loop
  // converge on a three-arm group whatever order it visits the arms in.
  if sawStrMixed { return 3 }
  if sawMixed { return 2 }
  1
}

// Is variant field `fi` a string literal set in both arms whose storages differ only by the
// litunion rep seam — a registered alias's interned atom (code 0) beside an inline set's
// string ref (code 3)? Both sides must already be atom material, or the promotion would have
// to invent a rep for a value with none. A numeric set has no atom and stays refused (D1460).
export function variantFieldLitRepMixed(a: i32, b: i32, fi: i32): boolean {
  if a < 0 || b < 0 { return false }
  if a >= uFieldCount.length || b >= uFieldCount.length { return false }
  if fi < 0 || fi >= uFieldCount[a] || fi >= uFieldCount[b] { return false }
  const ra = uFieldStart[a] + fi
  const rb = uFieldStart[b] + fi
  if uFieldTypes[ra] == uFieldTypes[rb] { return false }
  if !litFieldRowIsAtomisable(ra) { return false }
  litFieldRowIsAtomisable(rb)
}

// Can variant field ROW `ix` carry the interned-atom rep? Code 0 already does; code 3 is the
// inline spelling of the same members and can be made to. Any other code is a different
// storage entirely and is not this seam.
function litFieldRowIsAtomisable(ix: i32): boolean {
  if ix < 0 || ix >= uFieldTypes.length { return false }
  const code = uFieldTypes[ix]
  if code != 0 && code != 3 { return false }
  tyIsLitUnionOrLit(uFieldLitTyIx[ix])
}

// Is variant field `fi` an atom-repped literal set in one arm and its own base (a plain
// `string`) in the other — the pair `variantFieldLitRepMixed` cannot serve, since the base
// arm holds an arbitrary string with no interned id (D1460). The string is the rep they can
// share: this pair with the set arm spelled inline is already two code-3 rows and runs today.
export function variantFieldLitRepStrMixed(a: i32, b: i32, fi: i32): boolean {
  if a < 0 || b < 0 { return false }
  if a >= uFieldCount.length || b >= uFieldCount.length { return false }
  if fi < 0 || fi >= uFieldCount[a] || fi >= uFieldCount[b] { return false }
  const ra = uFieldStart[a] + fi
  const rb = uFieldStart[b] + fi
  if uFieldTypes[ra] == uFieldTypes[rb] { return false }
  if litFieldRowIsAtomisable(ra) { return litFieldRowIsPlainString(rb) }
  if litFieldRowIsAtomisable(rb) { return litFieldRowIsPlainString(ra) }
  false
}

// Is variant field row `ix` a plain `string` — the base a string literal set softens to?
// Three columns, since no one alone says it: the code is shared with every string-slot
// field, the discriminant column parts a set from a non-set, and the identity column keeps
// a nominal `type Id = new string` from being read as the base its brand is distinct from.
function litFieldRowIsPlainString(ix: i32): boolean {
  if ix < 0 || ix >= uFieldTypes.length { return false }
  if uFieldTypes[ix] != 3 { return false }
  if uFieldLitTyIx[ix] >= 0 { return false }
  uFieldTyText[ix] == "string"
}

// Do `a` and `b` differ at a field where a literal set meets a different storage? Since
// D1050 every such pair is re-laid onto one rep before this runs, so this is the floor's own
// applicability test rather than a program anyone can write. Kept separate because the other
// refusal beside it (arms nothing tells apart) is still live.
export function variantLitRepMismatch(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return false }
  if a >= uFieldCount.length || b >= uFieldCount.length { return false }
  if uFieldCount[a] != uFieldCount[b] { return false }
  let fi = 0
  while fi < uFieldCount[a] {
    const ra = uFieldStart[a] + fi
    const rb = uFieldStart[b] + fi
    if uFieldLitTyIx[ra] >= 0 || uFieldLitTyIx[rb] >= 0 {
      if uFieldTypes[ra] != uFieldTypes[rb] { return true }
    }
    fi = fi + 1
  }
  false
}

// The name of the first field at which `a` and `b` disagree, for `assignTags`' floor, or ""
// when nothing does. A floor that cannot say where sends its reader to re-derive the walk it
// just ran (D1461).
export function variantFirstLayoutDisagreeField(a: i32, b: i32): string {
  if a < 0 || b < 0 { return "" }
  if a >= uFieldCount.length || b >= uFieldCount.length { return "" }
  if uFieldCount[a] != uFieldCount[b] { return "" }
  let fi = 0
  while fi < uFieldCount[a] {
    const ra = uFieldStart[a] + fi
    const rb = uFieldStart[b] + fi
    if uFieldTypes[ra] != uFieldTypes[rb] { return uFieldNames[ra] }
    if uFieldElemName[ra] != uFieldElemName[rb] { return uFieldNames[ra] }
    if uFieldTyText[ra] != uFieldTyText[rb] { return uFieldNames[ra] }
    fi = fi + 1
  }
  ""
}

// Does variant `vi` carry ANY field whose value `is` must test — i.e. is `vi` one of a set
// of arms sharing a tag and parted by a discriminant? The whole-variant form of
// `variantDiscrimFieldNeeded`, for the callers that ask about the arm rather than a field:
// `emitIs`'s static fold, which is unsound exactly when this is true.
export function variantHasDiscrimField(vi: i32): boolean {
  if vi < 0 || vi >= uFieldCount.length { return false }
  let fi = 0
  while fi < uFieldCount[vi] {
    if variantDiscrimFieldNeeded(vi, fi) { return true }
    fi = fi + 1
  }
  false
}

// The globally-stable tag of a value-union atom: every struct variant takes the dense ranks
// `0 .. uVariants.length-1`, so atom kinds claim the fixed slots above them, stable across
// every union in the module. The kind-to-tag table lives in `emit_rep` (`scalarTagOfKind`);
// this is the atom-spelled entry point into it, not a second copy of the table.
export function scalarTagOf(atom: string) {
  scalarTagOfKind(valueAtomKind(atom))
}

// The first tag above the value-atom band — the base the three slot-keyed bands below sit
// on. Code 13 (the packed byte list) exists only in a module that has one (`ba8Used`),
// settled before `emitModule` runs. Conditional rather than a flat 14, since a flat lift
// would renumber every tag in a program with no `u8[]`, though any base keeps the three bands disjoint.
export function uAtomBandTop(): i32 {
  if ba8Used { return 14 }
  13
}

// The globally-stable tag of the ref-element-array arm whose interned reflist slot is `slot`,
// claiming the band above the value-atom band. Three slot-keyed bands share that space and
// interleave by residue mod 3 so none can collide however deep its table runs: ref-arrays
// `+B + 3*slot`, maps `+B+4 + 3*slot`, closures `+B+2 + 3*(slot-1)`, where `B = uAtomBandTop()`.
export function refArrSlotTag(slot: i32) {
  uVariants.length + uAtomBandTop() + slot * 3
}

// The globally-stable tag of the map arm whose interned map value-slot is `slot` (mono
// rides slot -1), taking residue 2 of the mod-3 interleave. The slot canonicalizes through
// `mvCanonRepOf` first: layout-twin value spellings share one map-struct heap type, so they
// must share one tag, or an `is` compare would miss its own twin-spelled value.
export function mapSlotTag(slot: i32) {
  let s = slot
  if s >= 0 { s = mvCanonRepOf(s) }
  uVariants.length + uAtomBandTop() + 4 + s * 3
}

// The slot the function type rendered `nm` claims in the closure-signature tag table,
// interning it on a miss. -1 for "", folded onto the value-atom band's kind-11 offset by
// `cloSigSlotTag`. The key is the canonical structural render (`tyToEmitName`), so an alias
// and the inline spelling of one signature share a slot and meet on the same tag.
export function cloSigTagSlot(nm: string): i32 {
  if nm == "" { return -1 }
  let i = 0
  while i < cloSigTagNames.length {
    if cloSigTagNames[i] == nm { return i }
    i = i + 1
  }
  cloSigTagNames.push(nm)
  cloSigTagNames.length - 1
}

// The globally-stable tag of the bare-closure arm whose interned signature slot is `slot`,
// residue 0 of the mod-3 interleave. The first slot deliberately keeps the value-atom band's
// kind-11 offset, so a program with one closure signature tags exactly as it always did; each
// further signature claims the band above. An un-nameable closure (`slot < 0`) shares the first slot's tag.
export function cloSigSlotTag(slot: i32): i32 {
  if slot <= 0 { return scalarTagOfKind(11) }
  uVariants.length + uAtomBandTop() + 2 + (slot - 1) * 3
}

// The union box tag a bare function-typed arm of arena type `ty` claims — the one home of
// the function-type-to-tag composition, read by both the box site and the test site
// (`isArmTagOfTy`). The two must derive the tag from the same render, or a value boxed
// through one arm answers an `is` against another.
export function cloArmTagOfTy(ty: i32): i32 {
  if ty < 0 { return scalarTagOfKind(11) }
  cloSigSlotTag(cloSigTagSlot(tyToEmitName(ty)))
}

// The interned value-box heap-type index for a scalar atom (`boolean` shares the i32 box),
// or -1 for `string`/`null` (a string ref is already an `anyref` subtype; null is
// `ref.null`), and likewise for the five list flavours and the closure atom, which ride the
// box anyref directly. The kind-to-box table lives in `emit_rep` (`vbHeapIdxOfKind`).
export function vbHeapIdxOfAtom(atom: string) {
  vbHeapIdxOfKind(valueAtomKind(atom))
}

// `registerValueUnionName` with the caller's arena type for this union, or -1 when the
// caller has only a name. The row's `unTyIx` entry is that index, so the registry can be
// asked by type rather than by spelling once its readers move.
function registerValueUnionNameTy(name: string, tyIx: i32) {
  if isUNameAB(1, name, tyIx) { return 0 }
  // The row decides: `isValueUnionTyOr` asks `valueRowKind` per member, matching
  // `isValueUnionName`'s spelling test, and declines (-1) rather than guess. A value union
  // with a litunion-alias arm registers here too, since the alias rides the box as its
  // member-string atom — without it the scalar arms' value boxes are never minted.
  let isVU = isValueUnionTyOr(tyIx)
  if isVU < 0 {
    isVU = 0
    if isValueUnionName(name) { isVU = 1 }
  }
  if isVU == 0 && !nameIsLitUnionArmValueUnion(name) { return 0 }
  uDeclared = true
  unNames.push(name)
  unTyIx.push(tyIx)
  unKey.push(canonUnionKeyOfName(name))
  unDeclIx.push(-1) // value-union row: registered from a name, no declaration
  unMemberSet.push(name)
  recordUnMemTys(name) // D-UNION foundation
  unVarStart.push(uVariants.length)
  unVarCount.push(0)
  markValueUnionAtoms(name)
  0
}

// The name-only entry point: resolves the name once, here, exactly as the two
// declaration-driven registration sites do, so a row minted through this path carries an
// arena index instead of -1 without every one of its twelve callers threading one.
// Resolving at the boundary means the string work happens once at mint, not at every query.
export function registerValueUnionName(name: string) {
  registerValueUnionNameTy(name, declTyIxOfName(name))
}

// Marks the per-rep value-box usage flags for every scalar atom of the value union `name`,
// at registration time so `mAssignTypeIndices` interns exactly the used reps. The box-tag
// ABI is order-sensitive: this mints value-box reps in atom order, so the recorded slice is
// consumed in lock-step behind a length guard, and an uncovered row keeps the legacy name path.
export function markValueUnionAtoms(name: string) {
  const atoms: string[] = []
  const mems: i32[] = []
  const cov = unionSetArmTys(name, atoms, mems)
  let i = 0
  while i < atoms.length {
    let k = -1
    if cov { k = unMemAtomKind(mems[i]) } else { k = valueAtomKind(atoms[i]) }
    if k == 0 || k == 1 { vbI32Used = true }
    // A string member rides the box's anyref value as the raw string-array ref, so force that
    // array type even when the module constructs no string: the narrowed string read's
    // `ref.cast` is emitted regardless of branch, and must still validate, so the array type
    // has to exist even when nothing builds one.
    if k == 2 { aUsed = true }
    if k == 3 { vbI64Used = true }
    if k == 4 { vbF64Used = true }
    if k == 5 { vbF32Used = true }
    // A LIST member (codes 7..10, 12, 13) forces its list type so the wrapper heap the box
    // payload rides exists — the union annotation alone may be the only mention of that
    // list type.
    if k == 7 {
      lUsed = true
      aUsed = true
    }
    if k == 8 { fa64Used = true }
    if k == 9 {
      slUsed = true
      aUsed = true
    }
    if k == 10 { ia64Used = true }
    if k == 12 { fa32Used = true }
    // A packed byte-list member (code 13) forces the `ba8`/`bl8` pair, and it is the only
    // arm here that also decides a tag: `uAtomBandTop` reads `ba8Used` to lift the three
    // slot-keyed bands off code 13's tag. This mark makes that bit true before any tag is
    // emitted, since a union annotation may be the program's only mention of `u8[]`.
    if k == 13 { ba8Used = true }
    // A CLOSURE member (code 11) rides the box anyref as the `$cloStructIdx` fat-pointer —
    // force the closure rec-group types so that heap type exists (the union annotation may be
    // the only mention of a function value in the program), the string/list analogue above.
    if k == 11 { fnValUsed = true }
    // A litunion-alias member rides the box anyref as its member-string ref, so force the
    // string array type exactly like a `string` member — the narrowed `is K0` read's
    // `ref.cast` must validate even when the module constructs no string.
    if k < 0 {
      let lit = false
      if cov {
        lit = tyIsLitUnion(mems[i])
      } else {
        lit = nameIsLitUnionType(atoms[i])
      }
      if lit { aUsed = true }
    }
    i = i + 1
  }
  0
}

// Interns the reflist wrapper slot for every ref-element-array arm of the union `name` — its
// box payload rides that wrapper ref, and `refArrTagOf` needs the slot to exist. The
// ref-array analogue of `markValueUnionAtoms`. Gated on a non-value array atom, so
// scalar-element lists (owned by `markValueUnionAtoms`) are skipped.
export function markRefArrayArms(name: string) {
  // The arm gate is a `TyArray` over a non-scalar-leaf element (`unMemIsRefElemArray`), not
  // `valueAtomKind(a) < 0 && nameIsArray(a)` over the atom's rendering. The stored atom text
  // still feeds the name-keyed reflist layer downstream, so it stays; only the
  // classification moves. An uncovered row keeps the legacy gate.
  const atoms: string[] = []
  const mems: i32[] = []
  const cov = unionSetArmTys(name, atoms, mems)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    let isRefArr = false
    if cov {
      isRefArr = unMemIsRefElemArray(mems[i])
    } else {
      isRefArr = a != "null" && valueAtomKind(a) < 0 && nameIsArray(a)
    }
    if isRefArr {
      // Arena hand-over: `mems` is this very seam's answer for these very atoms, so a
      // covered row hands the arm's type straight down instead of resolving `a` again.
      let aTy = -1
      if cov { aTy = mems[i] }
      internShapeDeepTy(a, aTy)
      const elem = refArrElemName(a)
      if elem != "" {
        // The same hand-over, one line further down: `aTy` is this arm's arena row, already
        // used for `internShapeDeepTy` above, so the arm's element is its `aElem` and the
        // intern needs no second resolution of the name cut from `a`.
        let elemTy = -1
        if aTy >= 0 {
          const ut = T.tys[aTy]
          if ut is TyArray { elemTy = ut.aElem }
        }
        if elemNameIsNominal(elem) { elemTy = -1 }
        ensureRefElemTy(elem, elemTy)
        // Forces the ref-list flags so the backing/wrapper heaps emit and the index/`.length`
        // machinery is enabled — a ref-array mentioned only as a union arm otherwise leaves
        // `raUsed`/`rlUsed` false and the narrowed `x[i]` read fails "ref array type not
        // collected". The union-arm analogue of the array-literal flips.
        rlUsed = true
        raUsed = true
      }
    }
    i = i + 1
  }
  0
}

// Interns the map value-slot for every map arm of the union `name` — its box payload rides
// that arm's map struct ref, and `mapTagOf` needs the slot to exist. Forces the shared map
// heap flags and interns the arm's value shape via `mvShapeOfValName`; a mono/atom value
// interns no slot (rides -1), a typed value gets a distinct mv slot and `mapSlotTag`.
export function markMapUnionArms(name: string) {
  // D-UNION: a map arm is a `TyMap` member (`unMemIsMap`), not a `{[`-prefixed
  // rendering. The arm's stored atom TEXT still keys the (name-keyed) map-value slot
  // layer below (`mapValNameOf` → `mvShapeOfValName`). Uncovered rows keep the name gate.
  const atoms: string[] = []
  const mems: i32[] = []
  const cov = unionSetArmTys(name, atoms, mems)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    let isMap = false
    if cov {
      isMap = unMemIsMap(mems[i])
    } else {
      isMap = a != "null" && nameIsMap(a)
    }
    if isMap {
      mUsed = true
      lUsed = true
      aUsed = true
      mvShapeOfMapName(a)
    }
    i = i + 1
  }
  0
}

// Forces the shared map machinery and interns the mv value slot of a map reached only as a
// closure result inside a composite annotation. The whole spelling is one TypeRef whose map
// is invisible to every branch of the `collectA` scan, so the narrowed arm's call-result map
// ops rejected "map type not collected". Self-gating: a name with no arrow or map forces nothing.
export function forceCloResultMapTypes(nm: string) {
  // Cheap pre-gate (this runs per arena TypeRef): only a name spelling BOTH an
  // arrow and a map can carry a closure-result map — two substring scans, no
  // allocation, before the arm split allocates anything.
  if !strContains(nm, "=>") || !strContains(nm, "{[") { return 0 }
  const arms: string[] = []
  splitUnionAtoms(nm, arms)
  let i = 0
  while i < arms.length {
    const a = normTypeAtom(arms[i])
    // `annRetNameOf` is the `annArrowAt` + slice pair, and its own opener test now runs
    // first so the one-char reject precedes the depth scan — a strict work reduction, since
    // `annArrowAt` skips an arm that cannot pass instead of running on it.
    if nameIsParenOpen(a) {
      const ret0 = annRetNameOf(a)
      if ret0 != "" {
        let res = normTypeAtom(ret0)
        const rn = nulMapInnerName(res)
        if rn != "" { res = rn }
        if nameIsBareMap(res) {
          mUsed = true
          lUsed = true
          aUsed = true
          mvShapeOfMapName(res)
        } else if annArrowAt(res) >= 0 {
          // A curried result (`() => () => {[string]: V}`) recurses to ITS result.
          forceCloResultMapTypes(res)
        }
      }
    }
    i = i + 1
  }
  0
}

// Forces the wrapper/backing types of a scalar-leaf (or string) list reached only as a
// closure result inside a composite annotation. The whole spelling is one TypeRef whose
// result list is invisible to every branch of the `collectA` scan, so a narrowed arm's
// value-call index read rejected "list type not collected". The list dual of `forceCloResultMapTypes`.
export function forceCloResultListTypes(nm: string) {
  // Cheap pre-gate (this runs per arena TypeRef): only a name spelling BOTH an arrow
  // and an array can carry a closure-result list — two substring scans, no allocation.
  if !strContains(nm, "=>") || !strContains(nm, "[]") { return 0 }
  const arms: string[] = []
  splitUnionAtoms(nm, arms)
  let i = 0
  while i < arms.length {
    const a = normTypeAtom(arms[i])
    // `annRetNameOf`, exactly as in `forceCloResultMapTypes` above: the caller's own opener
    // test runs first so the one-char reject precedes the depth scan.
    if nameIsParenOpen(a) {
      const ret0 = annRetNameOf(a)
      if ret0 != "" {
        const res = nonNulBaseOf(normTypeAtom(ret0))
        // The five scalar-element backings via the one home (`scalarListKindOfName`). This
        // copy asks them in a different order (string first, i32 last); the five predicates
        // are pairwise disjoint, so the home's order is the same answer.
        const sk = scalarListKindOfName(res)
        if sk == 1 {
          slUsed = true
          aUsed = true
        } else if sk == 2 {
          fa64Used = true
        } else if sk == 3 {
          ia64Used = true
        } else if sk == 4 {
          fa32Used = true
        } else if sk == 0 {
          lUsed = true
          aUsed = true
        } else if nameIsRefArray(res) {
          // A ref-element list result: intern its element slot and force the ref-list
          // machinery, exactly as a bare `S[]` annotation's branch does — else a narrowed
          // arm's value call keys a signature no producer interned, or the read finds no wrapper.
          rlUsed = true
          raUsed = true
          ensureRefElem(refArrElemName(res))
        } else if annArrowAt(res) >= 0 {
          // A curried result (`() => () => f32[]`) recurses to ITS result.
          forceCloResultListTypes(res)
        }
      }
    }
    i = i + 1
  }
  0
}

// True if the union member-set `name` has a map arm whose interned map value-slot is `slot`
// — the guard `emitUnionCoerce` uses before boxing a value with that arm's `mapSlotTag`. Arm
// and carrier compare canonically (`mvCanonRepOf`), so a twin-spelled carrier matches the arm
// it lowers as. A value matching no arm falls through rather than mis-tag.
export function unionHasMapArmSlot(name: string, slot: i32) {
  // D-UNION: the arm SHAPE test is structural (`unMemIsMap` — a `TyMap` member); the
  // SLOT comparison stays where it is, because a slot is a REP question and
  // `mvSlotOfMapValNameOrMono`/`mvCanonRepOf` already answer it canonically.
  const atoms: string[] = []
  const mems: i32[] = []
  const cov = unionSetArmTys(name, atoms, mems)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    let isMap = false
    if cov {
      isMap = unMemIsMap(mems[i])
    } else {
      isMap = a != "null" && nameIsMap(a)
    }
    if isMap {
      // The arm's value type is already in hand when the arena decided the arm: `mems[i]`
      // is this atom's `TyMap`, so the slot lookup takes one hop instead of re-parsing
      // `mapValNameOf(a)`. An arena-blind row passes -1 and the name leg answers as before.
      let aVt = -1
      if cov { aVt = tyMapValOf(mems[i]) }
      if (mvCanonRepOf(mvSlotOfMapNameTy(a, aVt)) == mvCanonRepOf(slot)) {
        return true
      }
    }
    i = i + 1
  }
  false
}

// True when the union member-set `name` carries a map arm whose value spelling is the bare
// `string` — the checker's render of a litunion-valued map, since the litunion bit lives on
// the node, not the name. `emitUnionCoerce` consults this when a mono litunion-valued map
// misses the slot match, tagging mono (`mapSlotTag(-1)`) so store and narrow resolve one tag.
export function unionHasCollapsedStringMapArm(name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  // Deliberately not migrated to an arena leg: this classifier's verdict asks about the
  // checker's render of a litunion map value, which is exactly the information the arena
  // keeps and the name loses, and it is dead on the whole corpus, so an arena leg here could
  // not be verified.
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a != "null" && nameIsBareMap(a) {
      if mapValNameOf(a) == "string" { return true }
    }
    i = i + 1
  }
  false
}

// True if the union member-set `name` has a MAP arm (`{[string]: V}`). Resolves an alias to its
// member set first. Used by the frame pre-pass (`exprHasMapOp` → `unionMapArmIdent`) to reserve the
// map scratch frame for a `t[k]` on a union binding narrowed to its map arm — the narrowing is not
// active in that pass, so the map op must be spotted from the binding's DECLARED union.
function unionHasMapArm(name: string) { unionMapArmName(name) != "" }

// The map arm name of the union member-set `name`, or "" when it has none — the value-atom
// scheme carries one map arm per union. `mapReadMvSlot`'s narrowing-blind fallback resolves
// the arm's value mv slot from it, so a `t[k] ?? d` binding classifies its value union in the
// frame pre-pass, where the `is`-narrow that makes `t` a map is not active.
export function unionMapArmName(name: string) {
  const armTy: i32[] = []
  unionMapArmNameTy(name, armTy)
}

// The form that also hands back the arm's arena type, pushed onto `outTy` (empty when the
// arena leg did not decide the arm). The map-slot layer downstream is still name-keyed, so
// the spelling stays the return value, sparing the caller from re-deriving `V` from
// it. An out-array rather than a second function, since the arm is chosen by one walk.
function unionMapArmNameTy(name: string, outTy: i32[]) {
  const atoms: string[] = []
  // Picks the map arm from the row's recorded arena member types (`unMemIsMap`) instead of
  // re-classifying each atom's rendered spelling with `nameIsMap`. The recorded member slice
  // is in atom order, so `atoms[m]` is this member's stored spelling, which the still-
  // name-keyed map-slot layer downstream needs. An uncovered row keeps the legacy name path.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsMap(mems[m]) {
        outTy.push(mems[m])
        return atoms[m]
      }
      m = m + 1
    }
    return ""
  }
  let i = 0
  while i < atoms.length {
    if nameIsMap(atoms[i]) { return atoms[i] }
    i = i + 1
  }
  ""
}

// True if `exprIx` is an IDENT whose DECLARED union has a map arm — the receiver shape the frame
// pre-pass reserves the map scratch for (`t[k]` / `t[k] ?? d` / `t.has(k)` on a union narrowed to
// a map). Narrowing-blind: reads the binding's declared union, not the active narrowing.
export function unionMapArmIdent(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident {
    const un = unionNameOfIdent(e.identName, fnIx)
    if un != "" { return unionHasMapArm(un) }
    // The typed-IR fallback: a union binding whose name the syntactic resolution cannot
    // render still records the union on its node type. The emitter lowers the narrowed map
    // read regardless, so the frame pre-pass must reserve the map scratch from the same
    // signal. An over-reservation is a harmless spare.
    return nodeTyUnionHasMapArm(exprIx)
  }
  false
}

// True when the CHECKED type of `exprIx` is a union carrying a MAP member, or a bare
// MAP (a narrowed occurrence records the NARROWED arm type, so the then-branch ident
// of `if t1 is {[string]: i32}` types TyMap, not the union) — the typed-IR net behind
// `unionMapArmIdent`'s syntactic miss.
function nodeTyUnionHasMapArm(exprIx: i32): boolean {
  const ty = nodeTyIxOf(exprIx)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return true }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if T.tys[t.uMembers[i]] is TyMap { return true }
      i = i + 1
    }
  }
  false
}

// The typed-IR net for the narrowed map-arm unbox gate: follows `name`'s rebind chain to
// its origin expression and tests whether the checker typed it as a union carrying a map
// member. The narrowed occurrence records the narrowed arm type (TyMap), so the receiver
// node itself cannot carry the gate, but the origin records the union before any narrowing.
export function identChainTyMapArmUnion(
  name: string,
  fnIx: i32,
  depth: i32,
): boolean {
  if depth <= 0 || fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return false }
  const li = parentLetOf(fn.fnBody, name)
  if li < 0 { return false }
  const d = P.nodes[li]
  if !(d is LetDecl) { return false }
  if d.letInit < 0 { return false }
  const initIx = unwrapParen(d.letInit)
  const init = P.nodes[initIx]
  if init is Ident {
    return identChainTyMapArmUnion(init.identName, fnIx, depth - 1)
  }
  const ty = nodeTyIxOf(initIx)
  if ty < 0 { return false }
  let uy = ty
  const tw = T.tys[ty]
  if tw is TyNullable { uy = tw.nInner }
  const tn = T.tys[uy]
  if tn is TyUnion {
    let i = 0
    while i < tn.uMembers.length {
      if T.tys[tn.uMembers[i]] is TyMap { return true }
      i = i + 1
    }
  }
  false
}

// The value-atom dual of `identChainTyMapArmUnion`: follows `name`'s rebind chain to its
// origin expression and tests whether the checker typed it as a boxed value union — 2+
// members, at least one non-literal. Consulted where the syntactic `unionNameOfIdent`
// cannot render the binding's union: skipping the unbox pushes the box ref where a raw narrowed atom belongs.
export function identChainTyBoxedUnion(
  name: string,
  fnIx: i32,
  depth: i32,
): boolean {
  if depth <= 0 || fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return false }
  const li = parentLetOf(fn.fnBody, name)
  if li < 0 { return false }
  const d = P.nodes[li]
  if !(d is LetDecl) { return false }
  if d.letInit < 0 { return false }
  const initIx = unwrapParen(d.letInit)
  const init = P.nodes[initIx]
  if init is Ident {
    return identChainTyBoxedUnion(init.identName, fnIx, depth - 1)
  }
  const ty = nodeTyIxOf(initIx)
  if ty < 0 { return false }
  let uy = ty
  const tw = T.tys[ty]
  if tw is TyNullable { uy = tw.nInner }
  const tn = T.tys[uy]
  if tn is TyUnion {
    if tn.uMembers.length < 2 { return false }
    let i = 0
    while i < tn.uMembers.length {
      if !(T.tys[tn.uMembers[i]] is TyLit) { return true }
      i = i + 1
    }
  }
  false
}

// True if `exprIx` is a member read whose object indexes an ident declared as a union with
// a ref-array arm whose element struct's field is a map — the receiver shape the frame
// pre-pass must reserve the map scratch for. Narrowing-blind: the `is`-narrow that makes
// `t[i]` a struct is not active in the pre-pass, so without this the map read clobbered i32 scratch slots — invalid wasm.
export function unionListElemMapFieldMember(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member {
    const obj = P.nodes[unwrapParen(e.memObj)]
    if obj is Index {
      const arr = P.nodes[unwrapParen(obj.idxArr)]
      if arr is Ident {
        const un = unionNameOfIdent(arr.identName, fnIx)
        if un != "" {
          const atoms: string[] = []
          // The arm's element type is `tyArmElem` (a `TyArray` arm's element, the arena
          // dual of the name path's `nameIsRefArray` gate plus its `refArrElemName`
          // re-resolution), and the `.f` leaf's code-19 map test is `tyArmPathIsMap`. An
          // uncovered row keeps the legacy name walk.
          const mems: i32[] = []
          const cov = unionArmTys(un, atoms, mems)
          let i = 0
          while i < atoms.length {
            const a = atoms[i]
            if cov {
              const path: string[] = []
              path.push(e.memProp)
              if tyArmPathIsMap(tyArmElem(mems[i]), path) { return true }
            } else if nameIsRefArray(a) {
              // The arm's element struct: `refArrElemName` for a nominal element, the raw
              // `[]`-stripped text for an inline shape it cannot see. The dropped length
              // conjunct is dischargeable: `nameIsRefArray(a)` already establishes
              // `nameIsArray(a)`, and `arrElemNameRaw` agrees with the guarded spelling on "".
              let en = refArrElemName(a)
              if en == "" { en = arrElemNameRaw(a) }
              const si = structIndexByName(en)
              if si >= 0 {
                const fi = sFieldIndex(si, e.memProp)
                if fi >= 0 {
                  if sFieldTypeAt(si, fi) == 19 { return true }
                }
              }
            }
            i = i + 1
          }
        }
      }
    }
  }
  false
}

// True if `exprIx` is a member read whose object is an ident declared as a union with a
// struct arm whose field is a map — the receiver shape the frame pre-pass must reserve the
// map scratch for, narrowing-blind like the list-element sibling above. Probes both field
// tables: the struct table and the variant table (`uVariants`). An over-reservation is a harmless spare.
export function unionStructArmMapFieldMember(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member {
    // Collect the field chain root-first: `t0.f.g` -> root `t0`, props [f, g] — the same
    // walk `calleeIsUnionArmClosureMember` performs, so a map field reached through
    // code-15 nested-struct hops is spotted, not just the single-hop `t0.f[k]`.
    const props: string[] = []
    let cur = unwrapParen(exprIx)
    let rootName = ""
    let guard = 0
    while guard < 32 {
      guard = guard + 1
      const cn = P.nodes[cur]
      if cn is Member {
        props.push(cn.memProp)
        cur = unwrapParen(cn.memObj)
      } else if cn is Ident {
        rootName = cn.identName
        break
      } else {
        return false
      }
    }
    if rootName == "" || props.length == 0 { return false }
    // props collected leaf-first — reverse into walk order.
    const path: string[] = []
    let pr = props.length - 1
    while pr >= 0 {
      path.push(props[pr])
      pr = pr - 1
    }
    const un = unionNameOfIdent(rootName, fnIx)
    if un == "" { return false }
    const atoms: string[] = []
    // The arm's field path is walked over the member's arena type (`tyArmPathIsMap`)
    // instead of re-resolving the rendered atom to a struct/variant row.
    // a struct/variant row and consulting its per-field lowering codes.
    const mems: i32[] = []
    // The arena declining is answered conservatively by `armPathArenaDeclined`, not by a
    // second walk over the arms' rendered spellings.
    if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
    let m = 0
    while m < mems.length {
      if atoms[m] != "null" {
        if tyArmPathIsMap(mems[m], path) { return true }
      }
      m = m + 1
    }
    return false
  }
  false
}

// The one answer for "the arena could not give me this union's member types" at the five
// frame-reservation guards below: `true`, the only sound answer. Every guard exists to
// reserve a frame slot the narrowing-blind pre-pass would otherwise miss, where an
// over-reservation is a harmless spare and an under-reservation is invalid wasm.
function armPathArenaDeclined(): boolean { true }

// True if `exprIx` is an index whose receiver is a member chain rooted at a union ident,
// whose field path walks — narrowing-blindly — to a list-of-maps field. The receiver shape
// the frame pre-pass must reserve the map scratch for: without it the narrowed map read's
// scratch stores fall on unreserved indices shared with unrelated locals — invalid wasm.
export function unionStructArmMapListElemIndex(exprIx: i32, fnIx: i32) {
  if !uDeclared { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    const m = unwrapParen(e.idxArr)
    if !(P.nodes[m] is Member) { return false }
    // Collect the field chain root-first: `t0.f.g[0]` -> root `t0`, props [f, g]. The
    // root may also be an indexed union ident, whose ref-array arm's element struct
    // carries the field: bottom out at `Index(Ident)` with the via-element flag, so the
    // arm walk starts at the array arm's element.
    const props: string[] = []
    let cur = m
    let rootName = ""
    let viaElem = false
    let guard = 0
    while guard < 32 {
      guard = guard + 1
      const cn = P.nodes[cur]
      if cn is Member {
        props.push(cn.memProp)
        cur = unwrapParen(cn.memObj)
      } else if cn is Ident {
        rootName = cn.identName
        break
      } else if cn is Index {
        const rin = P.nodes[unwrapParen(cn.idxArr)]
        if rin is Ident {
          rootName = rin.identName
          viaElem = true
        }
        break
      } else {
        return false
      }
    }
    if rootName == "" || props.length == 0 { return false }
    const path: string[] = []
    let pr = props.length - 1
    while pr >= 0 {
      path.push(props[pr])
      pr = pr - 1
    }
    const un = unionNameOfIdent(rootName, fnIx)
    if un == "" { return false }
    const atoms: string[] = []
    // The arm walk is structural (`tyArmPathIsMapList`, a `TyArray` over a `TyMap` leaf),
    // and so is the indexed-root hop: `tyArmElem` takes a `TyArray` arm's element in place
    // of `nameIsRefArray` + `refArrElemName` on the rendered atom.
    const mems: i32[] = []
    // The arena declining is answered conservatively by `armPathArenaDeclined`, not by a
    // second walk over the arms' rendered spellings.
    if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
    let mi = 0
    while mi < mems.length {
      if atoms[mi] != "null" {
        let mem = mems[mi]
        if viaElem { mem = tyArmElem(mem) }
        if tyArmPathIsMapList(mem, path) { return true }
      }
      mi = mi + 1
    }
    return false
  }
  false
}

// True if the union member-set `name` has a closure-array arm. `p[0]()` on such a union is a
// `call_ref`, so the frame pre-pass reserves `callRefSlot` for it (`blockHasCallRef`).
// Resolves an alias to its member set first.
function unionHasClosureArrayArm(name: string) {
  const atoms: string[] = []
  // `unMemIsFuncArray` (a `TyArray` over a `TyFunc`) is the arena dual of
  // `nameIsClosureArray`, including its nullable-element exclusion, which falls out for
  // free since a nullable-closure element is a `TyNullable`.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsFuncArray(mems[m]) { return true }
      m = m + 1
    }
    return false
  }
  let i = 0
  while i < atoms.length {
    if nameIsClosureArray(atoms[i]) { return true }
    i = i + 1
  }
  false
}

// True if `exprIx` is `p[0]` where `p` is a union IDENT whose union has a closure-array arm —
// the callee shape `blockHasCallRef` reserves `callRefSlot` for (the narrowing-blind pre-pass).
function calleeIsUnionClosureArrayIndex(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    const arr = P.nodes[unwrapParen(e.idxArr)]
    if arr is Ident {
      const un = unionNameOfIdent(arr.identName, fnIx)
      if un != "" { return unionHasClosureArrayArm(un) }
    }
  }
  false
}

// `t0[0].f()` where `t0`'s union has a ref-array arm whose element struct carries a
// closure field: the `is`-narrowing that makes `t0` the ref array is not active in this
// frame pre-pass, so `exprIsClosure` is false and `callRefSlot` must be reserved
// conservatively, or an unreserved `call_ref` spill shares the next frame's local — invalid wasm.
export function calleeIsUnionElemFieldClosure(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member {
    const ix = P.nodes[unwrapParen(e.memObj)]
    if ix is Index {
      const arr = P.nodes[unwrapParen(ix.idxArr)]
      if arr is Ident {
        const un = unionNameOfIdent(arr.identName, fnIx)
        if un != "" {
          const atoms: string[] = []
          // The deliberately-conservative `strContains(elem, "=>")` arm test is a
          // reachability question — `unMemIsFuncReachArray` asks it of the arena (a
          // `TyArray` whose element structure reaches a `TyFunc`) instead of the rendered spelling.
          const mems: i32[] = []
          if unionArmTys(un, atoms, mems) {
            let m = 0
            while m < mems.length {
              if unMemIsFuncReachArray(mems[m]) { return true }
              m = m + 1
            }
            return false
          }
          let i = 0
          while i < atoms.length {
            const a = atoms[i]
            // `refArrElemNameIf` IS the `nameIsRefArray` gate plus the element read;
            // a non-ref-array atom yields "" and `strContains("", "=>")` is false, so
            // dropping the conjunct is exact.
            if a != "null" && valueAtomKind(a) < 0 {
              if strContains(refArrElemNameIf(a), "=>") { return true }
            }
            i = i + 1
          }
        }
      }
    }
  }
  false
}

// True if the union member-set `name` has a bare-closure arm. A closure is value-atom kind
// 11 (a ref atom riding the box anyref as the fat-pointer), and it tags on an interned slot,
// its signature's (`cloSigSlotTag`), since kind 11 alone cannot separate two function-typed
// arms. Mirrors `unionHasClosureArrayArm`, which tests the distinct closure-element array shape.
function unionHasClosureArm(name: string) {
  const atoms: string[] = []
  // Value-atom kind 11 is "the member is a function type" — ask the arena
  // (`unMemIsFunc`) rather than `valueAtomKind`'s spelling ladder.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsFunc(mems[m]) { return true }
      m = m + 1
    }
    return false
  }
  let i = 0
  while i < atoms.length {
    if valueAtomKind(atoms[i]) == 11 { return true }
    i = i + 1
  }
  false
}

// The bare-closure arm name of the union member-set `name`, or "" when it has none — the
// presence question `emitUnionCoerce` gates its closure-carrier box on. The returned name
// does not decide the box tag: only the arm's signature separates several function-typed
// arms, so the tag comes from the arena type (`unionClosureArmTy` -> `cloArmTagOfTy`).
export function unionClosureArmName(name: string) {
  const atoms: string[] = []
  // The arm selection is structural (`unMemIsFunc`); the returned name stays the
  // member's stored spelling.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsFunc(mems[m]) { return atoms[m] }
      m = m + 1
    }
    return ""
  }
  let i = 0
  while i < atoms.length {
    if valueAtomKind(atoms[i]) == 11 { return atoms[i] }
    i = i + 1
  }
  ""
}

// D1098 — the arena type of the arm spelled `atom` in union `name`, or -1. The per-arm form
// of `unionClosureArmTy`, which answers for the first function arm only and cannot separate
// two closure signatures. Deliberately no name path beside the arena one: a top-level `=>`
// absorbs the `|` that follows it, so a member set that lost the split cannot be re-split.
export function unionArmTyOfAtom(name: string, atom: string): i32 {
  const atoms: string[] = []
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < atoms.length {
      if atoms[m] == atom {
        if m < mems.length { return mems[m] }
      }
      m = m + 1
    }
  }
  0 - 1
}

export function unionClosureArmTy(name: string): i32 {
  const atoms: string[] = []
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsFunc(mems[m]) { return mems[m] }
      m = m + 1
    }
  }
  -1
}

// The element value-union of union member-set `name`'s ref-array arm whose element is itself
// a value union carrying a bare-closure member, or "". Such an arm is a union-element array
// (kind 2), not `nameIsClosureArray` (a bare closure element), so `unionHasClosureArrayArm`
// does not cover it. Lets `t0[0]` off a union binding recover its element union narrowing-blindly.
export function unionClosureArrElemUnion(name: string) {
  const atoms: string[] = []
  unionArmsOf(name, atoms)
  let i = 0
  while i < atoms.length {
    // `refArrElemNameIf` is the `nameIsRefArray` gate plus the element read. The
    // `el != ""` test keeps the short-circuit this loop already had: without it,
    // `isValueUnionName("")` would run once per non-ref-array atom, a cost `unionMemberCount`
    // never paid before.
    const el = refArrElemNameIf(atoms[i])
    if el != "" && isValueUnionName(el) && unionHasClosureArm(el) { return el }
    i = i + 1
  }
  ""
}

// True if `exprIx` is an ident whose declared union has a bare-closure arm — the callee shape
// `blockHasCallRef` reserves `callRefSlot` for, since the `is`-narrowing that makes the ident
// a closure is not active during the narrowing-blind frame pre-pass. The bare-binding
// analogue of `calleeIsUnionClosureArrayIndex`.
export function calleeIsUnionClosureIdent(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident {
    const un = unionNameOfIdent(e.identName, fnIx)
    if un != "" { return unionHasClosureArm(un) }
    // A rebind of a union-arm field union: the binding's own union name resolves "" here,
    // so walk the init chain to the member's field table — a closure field or a union-box
    // field with a closure arm means the narrowed `call_ref` needs its scratch.
    // Reservation-only; without it the closure spill indexed an unreserved local — invalid wasm.
    return identRebindUnionArmClosureField(e.identName, fnIx, 4)
  }
  false
}

// True when local `name`'s let-init chain (rebinds followed up to `depth`) bottoms out at
// a member chain rooted at a union-typed ident whose arm field path leafs at a closure
// field (code 14/22) or a closure-armed union-box field (code 16) — the rebound-binding
// dual of `calleeIsUnionArmClosureMember`, for `blockHasCallRef`'s reservation.
function identRebindUnionArmClosureField(
  name: string,
  fnIx: i32,
  depth: i32,
): boolean {
  if depth <= 0 || fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return false }
  const li = parentLetOf(fn.fnBody, name)
  if li < 0 { return false }
  const d = P.nodes[li]
  if !(d is LetDecl) { return false }
  if d.letInit < 0 { return false }
  const init = P.nodes[unwrapParen(d.letInit)]
  if init is Ident {
    return identRebindUnionArmClosureField(init.identName, fnIx, depth - 1)
  }
  if init is Member {
    // Collect the field chain root-first (the `calleeIsUnionArmClosureMember` walk).
    const props: string[] = []
    let cur = unwrapParen(d.letInit)
    let rootName = ""
    let guard = 0
    while guard < 32 {
      guard = guard + 1
      const cn = P.nodes[cur]
      if cn is Member {
        props.push(cn.memProp)
        cur = unwrapParen(cn.memObj)
      } else if cn is Ident {
        rootName = cn.identName
        break
      } else {
        return false
      }
    }
    if rootName == "" || props.length == 0 { return false }
    const path: string[] = []
    let pr = props.length - 1
    while pr >= 0 {
      path.push(props[pr])
      pr = pr - 1
    }
    const un = unionNameOfIdent(rootName, fnIx)
    if un == "" { return false }
    const atoms: string[] = []
    // D-UNION: the arm walk is structural (`tyArmPathHasCloValue` — a `TyFunc` leaf,
    // bare / nullable, or a `TyUnion` with a `TyFunc` member).
    const mems: i32[] = []
    // The arena declining is answered conservatively by `armPathArenaDeclined`, not by a
    // second walk over the arms' rendered spellings.
    if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
    let m = 0
    while m < mems.length {
      if atoms[m] != "null" {
        if tyArmPathHasCloValue(mems[m], path) { return true }
      }
      m = m + 1
    }
    return false
  }
  false
}

// True if `exprIx` is a member chain rooted at an ident declared as a union, whose field
// path walks — narrowing-blindly through the arms' field tables — to a closure field
// (code 14, or the nullable-closure niche 22). The callee shape `blockHasCallRef` reserves
// `callRefSlot` for, since without it the closure spill falls on an unreserved index — invalid wasm.
export function calleeIsUnionArmClosureMember(exprIx: i32, fnIx: i32) {
  if !uDeclared {
    return false // no unions declared — nothing to probe (cheap bail)
  }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member {
    // Collect the field chain root-first: `t0.f.g` → root `t0`, props [f, g].
    const props: string[] = []
    let cur = unwrapParen(exprIx)
    let rootName = ""
    let guard = 0
    while guard < 32 {
      guard = guard + 1
      const cn = P.nodes[cur]
      if cn is Member {
        props.push(cn.memProp)
        cur = unwrapParen(cn.memObj)
      } else if cn is Ident {
        rootName = cn.identName
        break
      } else {
        return false
      }
    }
    if rootName == "" || props.length == 0 { return false }
    // props collected leaf-first — reverse into walk order.
    const path: string[] = []
    let pr = props.length - 1
    while pr >= 0 {
      path.push(props[pr])
      pr = pr - 1
    }
    const un = unionNameOfIdent(rootName, fnIx)
    if un == "" { return false }
    const atoms: string[] = []
    // D-UNION: the arm walk is structural (`tyArmPathIsClosure` — a `TyFunc` leaf, bare
    // or under the nullable-closure niche's `TyNullable`).
    const mems: i32[] = []
    // The arena declining is answered conservatively by `armPathArenaDeclined`, not by a
    // second walk over the arms' rendered spellings.
    if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
    let m = 0
    while m < mems.length {
      if atoms[m] != "null" {
        if tyArmPathIsClosure(mems[m], path) { return true }
      }
      m = m + 1
    }
    return false
  }
  false
}

// Walks field path `path` from union arm `arm`: the first hop resolves through the arm's
// struct-table or variant-table row, each mid hop must be a code-15 nested-struct field,
// and the last hop is a closure field (code 14/22) — used for the index whose receiver is
// a member chain rooted at a union ident, needing `blockHasCallRef`'s reservation.
export function calleeIsUnionArmCloArrayIndex(exprIx: i32, fnIx: i32) {
  if !uDeclared { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    const m = P.nodes[unwrapParen(e.idxArr)]
    if m is Member {
      const props: string[] = []
      let cur = unwrapParen(e.idxArr)
      let rootName = ""
      let guard = 0
      while guard < 32 {
        guard = guard + 1
        const cn = P.nodes[cur]
        if cn is Member {
          props.push(cn.memProp)
          cur = unwrapParen(cn.memObj)
        } else if cn is Ident {
          rootName = cn.identName
          break
        } else {
          return false
        }
      }
      if rootName == "" || props.length == 0 { return false }
      const path: string[] = []
      let pr = props.length - 1
      while pr >= 0 {
        path.push(props[pr])
        pr = pr - 1
      }
      const un = unionNameOfIdent(rootName, fnIx)
      if un == "" { return false }
      const atoms: string[] = []
      // D-UNION: the arm walk is structural (`tyArmPathIsCloArray` — a `TyArray` over a
      // `TyFunc` leaf).
      const mems: i32[] = []
      // The arena declining is answered conservatively by `armPathArenaDeclined`, not by a
      // second walk over the arms' rendered spellings.
      if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
      let mi = 0
      while mi < mems.length {
        if atoms[mi] != "null" {
          if tyArmPathIsCloArray(mems[mi], path) { return true }
        }
        mi = mi + 1
      }
      return false
    }
  }
  false
}

// The recorded member types of a member-set spelling, for the four ref-array arm
// scanners. `unionMemberTysOf` accepts an alias name too, but an alias must not expand
// here: the name loops these scanners replaced split an alias spelling into one atom,
// which no arm test accepts, so expanding it would be an extension, not a migration.
function unionArmMemberTys(name: string, out: i32[]): boolean {
  if unionMemberSetOf(name) != name { return false }
  unionMemberTysOf(name, out)
}

// D947 — is `atom` one of the member spellings of the rendered set `name`? A pure string
// test on purpose: an ABI-kind derivation per member got the answer inverted, killing a
// live arm. The narrowed atom and the set's members are rendered by the same producer, so
// comparing spellings needs no kind derivation or canonicalisation.
export function unionSetHasAtom(name: string, atom: string): boolean {
  if name == "" { return false }
  if atom == "" { return false }
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  if atoms.length < 2 { return true }
  // Every member must be a plain scalar spelling, or this test means nothing: a set
  // carrying a shape, closure, array, or nested union renders members a name comparison
  // cannot decide, and answering "absent" for those elided live fixtures and trapped the
  // rep fuzzer. Answering true (present) on anything unrecognised keeps master's behaviour.
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a == atom { return true }
    if !nameIsPlainScalarAtom(a) { return true }
    i = i + 1
  }
  false
}

// A member spelling this file can compare by name: a bare primitive. Anything carrying a
// grouper is a shape / closure / array / nested union and is deliberately excluded.
function nameIsPlainScalarAtom(a: string): boolean {
  if a == "i32" { return true }
  if a == "i64" { return true }
  if a == "f32" { return true }
  if a == "f64" { return true }
  if a == "boolean" { return true }
  if a == "string" { return true }
  if a == "u8" { return true }
  if a == "null" { return true }
  false
}

// True if the union member-set `name` has a ref-element array arm whose interned reflist
// slot is `slot` — the guard `emitUnionCoerce` uses to confirm a ref-array carrier matches
// an arm before boxing it with that arm's `refArrSlotTag`. A slot matching no arm falls
// through rather than mis-tag.
export function unionHasRefArrayArmSlot(name: string, slot: i32) {
  // `refListSlotOfExpr` floors a miss at 0, so the only caller never asks about a negative
  // slot; the guard keeps "the carrier has no slot" from matching a member with no arm row (both -1).
  if slot < 0 { return false }
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return false }
  let i = 0
  while i < mems.length {
    if unMemRefArrArmSlot(mems[i]) == slot { return true }
    i = i + 1
  }
  false
}

// The interned reflist slot of a union-box-element ref-array arm of `name` whose element
// union admits the member atom `elemAtom` (exact match), or -1. An empty `elemAtom` (an
// empty `[]` literal) matches the first union-box-element arm, since an empty list's
// element type is vacuous and the checker already proved the literal fits the union.
export function unionRefArrayArmSlotForElem(name: string, elemAtom: string) {
  const exact = unionRefArrayArmSlotForElemAtom(name, elemAtom)
  if exact >= 0 { return exact }
  // Literal-widening admission: the probe classifies a bare int literal as "i32" and a
  // float literal as "f64", but the checker already admits it into a wider scalar element
  // union. Without this the exact-atom miss let the literal fall to the value-atom ladder,
  // boxing a raw scalar list with a non-matching tag — every `is` on it silently false.
  if elemAtom == "i32" {
    const wi = unionRefArrayArmSlotForElemAtom(name, "i64")
    if wi >= 0 { return wi }
    const wf = unionRefArrayArmSlotForElemAtom(name, "f64")
    if wf >= 0 { return wf }
    return unionRefArrayArmSlotForElemAtom(name, "f32")
  }
  if elemAtom == "f64" { return unionRefArrayArmSlotForElemAtom(name, "f32") }
  -1
}

// The exact-atom pass of `unionRefArrayArmSlotForElem`: the first union-box-element
// ref-array arm whose element union carries `elemAtom` verbatim (any arm for "").
function unionRefArrayArmSlotForElemAtom(name: string, elemAtom: string) {
  // The arm slot per member, off the arena. The element-union atom test below still
  // reads a member-set spelling, and it reads the arm row's stored one, since the row
  // stores the very spelling the parse produced.
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    const slot = unMemRefArrArmSlot(mems[i])
    if slot >= 0 && rlElemKindTbl[slot] == 2 {
      if elemAtom == "" { return slot }
      const en = rlElemName[slot]
      const eAtoms: string[] = []
      unionArmsOf(en, eAtoms)
      let j = 0
      while j < eAtoms.length {
        if eAtoms[j] == elemAtom { return slot }
        // R3's boxed-member rule, at the arm's stored element spelling: a litunion-alias
        // member of a value union rides the box as the `string` atom, and the stored
        // spelling keeps the alias rather than widening it. Without this leg, a
        // `(K | i32)[]` arm is invisible to a string-element literal — invalid wasm.
        if elemAtom == "string" && nameIsLitUnionType(eAtoms[j]) { return slot }
        j = j + 1
      }
    }
    i = i + 1
  }
  -1
}

// The interned reflist slot of the first union-box-element ref-array arm of `name` whose
// element union carries an atom that is itself an array (`wantMap` false) or a map
// (`wantMap` true) — the arm a nested list or map-element literal has to build through.
// Structural on the element union's own atoms, not nominal on the union name (D1016).
export function unionRefArrayArmSlotForNestedElem(
  name: string,
  wantMap: boolean,
) {
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    const slot = unMemRefArrArmSlot(mems[i])
    if slot >= 0 && slot < rlElemKindTbl.length && rlElemKindTbl[slot] == 2 {
      const eAtoms: string[] = []
      unionArmsOf(rlElemName[slot], eAtoms)
      let j = 0
      while j < eAtoms.length {
        if wantMap {
          if nameIsMapOpen(eAtoms[j]) { return slot }
        } else {
          if nameIsArray(eAtoms[j]) { return slot }
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  -1
}

// The interned reflist slot of an array-of-map arm of `name` whose element map's value
// rep matches the literal element's map shape `mvShape` (canonical rep, `mvCanonRepOf`),
// or -1. `emitUnionCoerce` routes an array literal of map exprs (invisible to
// `exprRefArray`) into the arm's build and tag; an unmatched literal keeps the loud reject.
export function unionRefArrayArmSlotForMapElem(name: string, mvShape: i32) {
  if mvShape < -1 { return -1 }
  // The arm shape test is `unMemIsMapArray`, and the `nameIsMapMemberUnion` exclusion
  // is free structurally, since a map-member union element is a `TyUnion`. The arm row is
  // `unMemRefArrArmSlot`, and the arm's map-value slot is the ref-list layer's own
  // chokepoint `rlElemMapValMvSlot`.
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    if unMemIsMapArray(mems[i]) {
      const slot = unMemRefArrArmSlot(mems[i])
      if slot >= 0 && slot < rlElemKindTbl.length && rlElemKindTbl[slot] == 3 {
        const armMv = rlElemMapValMvSlot(slot)
        if armMv == -1 && mvShape == -1 { return slot }
        if armMv >= 0 && mvShape >= 0 {
          if mvCanonRepOf(armMv) == mvCanonRepOf(mvShape) { return slot }
        }
      }
    }
    i = i + 1
  }
  -1
}

// The interned reflist slot of the single nested-array arm of `name` (an arm whose
// element is itself a list, kinds 4/6/7/8/9/10), or -1 when the union has no such arm or
// more than one — an ambiguous route stays the loud reject. `emitUnionCoerce` routes an
// ArrayLit carrier through this arm's own build so the inner lists build the arm's own leaf.
export function unionNestedArrayArmSlot(name: string) {
  // The arm rows come off the recorded member types, asking `unMemRefArrArmSlot` (does a
  // row exist for the member's element) rather than the shape predicate `unMemIsRefElemArray`,
  // since that predicate is a strict superset of `nameIsRefArray` and an inert
  // over-accept is still not an equality.
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let found = -1
  let n = 0
  let i = 0
  while i < mems.length {
    const slot = unMemRefArrArmSlot(mems[i])
    if slot >= 0 && slot < rlElemKindTbl.length {
      const k = rlElemKindTbl[slot]
      if k == 4 || k == 6 || k == 7 || k == 8 || k == 9 || k == 10 {
        found = slot
        n = n + 1
      }
    }
    i = i + 1
  }
  if n == 1 { return found }
  -1
}

// True if the union member-set `name` has an array-of-map arm. The frame pre-pass
// consults this (via `unionMapArrayElemIndex`) to reserve the map scratch for a `t[i][k]`
// read on a union binding narrowed to its map-array arm, since the narrowing is not active
// in that pass — the map-array twin of `unionHasMapArm`.
function unionHasMapArrayArm(name: string) {
  const atoms: string[] = []
  // A `TyArray` over a `TyMap` (`unMemIsMapArray`). The name path's
  // `!nameIsMapMemberUnion(elem)` guard is free structurally — a map-member union
  // element is a `TyUnion`, never a `TyMap`, however it renders.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsMapArray(mems[m]) { return true }
      m = m + 1
    }
    return false
  }
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a != "null" && nameIsArray(a) {
      const en = refArrElemName(a)
      if nameIsBareMap(en) { return true }
    }
    i = i + 1
  }
  false
}

// True if `exprIx` is an index read whose array indexes an ident declared as a union with
// an array-of-map arm — the receiver shape the frame pre-pass reserves the map scratch
// for. Narrowing-blind, like `unionMapArmIdent`. An over-reservation is a harmless spare local.
export function unionMapArrayElemIndex(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    const arr = P.nodes[unwrapParen(e.idxArr)]
    if arr is Ident {
      const un = unionNameOfIdent(arr.identName, fnIx)
      if un != "" { return unionHasMapArrayArm(un) }
    }
  }
  false
}

// The inferred `T|null` union name of the null-init `LetDecl` at `letIx`, or "".
export function nliNameOf(letIx: i32) {
  let i = 0
  while i < nliLetIxs.length {
    if nliLetIxs[i] == letIx { return nliNames[i] }
    i = i + 1
  }
  ""
}

// The value-union name an un-annotated if-expression binding init carries, or "" when it
// is not a value union the box can hold (a non-union if, a `string | null` niche, or an
// arm the static pre-pass cannot classify). The canonical name is the deduped arm atoms in
// arm order, with a trailing `|null` when any arm or the else-less path is null.
export function ifExprNliName(ifIx: i32) {
  const atoms: string[] = []
  const hn = ifExprCollectAtoms(ifIx, atoms)
  if hn == -2 { return "" }
  if atoms.length == 0 { return "" }
  // Mixed numeric arms widen to a single numeric — they are not a union, and this static
  // atom list cannot do that lattice join. Bail so the numeric value-position-if path
  // (`letIsF64`/`letIsI64`) handles them instead. A single numeric scalar is fine.
  let numCount = 0
  let j = 0
  while j < atoms.length {
    const k = valueAtomKind(atoms[j])
    if k == 0 || k == 3 || k == 4 || k == 5 { numCount = numCount + 1 }
    j = j + 1
  }
  if numCount >= 2 { return "" }
  let nm = ""
  let i = 0
  while i < atoms.length {
    if nm != "" { nm = nm + "|" }
    nm = nm + atoms[i]
    i = i + 1
  }
  if hn == 1 { nm = nm + "|null" }
  // Only a value union the box rep can hold (≥2 non-null atoms, or one NUMERIC scalar +
  // null) registers here — a `string | null` niche / a non-union stay on their own paths.
  if !isValueUnionName(nm) { return "" }
  nm
}

// The per-union table index that OWNS global variant `vi` (the union whose variant
// slice contains it), or -1. Mirrors the `structIndexByName`-style resolver.
function unionOfVariant(vi: i32) {
  let u = 0
  while u < unNames.length {
    const start = unVarStart[u]
    if vi >= start && vi < start + unVarCount[u] { return u }
    u = u + 1
  }
  -1
}

// The variant registry asked of the arena — the row index whose arm type is `ty`, or -1.
// Variants are nominal: two variants with the same field set are different variants, so
// there is no structural fallback here. A query-side hazard: `nodeTyIxOf(paramTypeNode(...))`
// for a union-annotated param hands back the first arm, not the union.
export function variantRowOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  let i = 0
  while i < uVarTyIx.length {
    if uVarTyIx[i] == ty { return i }
    i = i + 1
  }
  // No structural rung: two variants with the same field set are different variants, and a
  // `tySame` fallback here would match the first of them for both. Variants are nominal,
  // like unions and unlike structs, since their whole purpose is to be told apart. The index
  // rung is the whole function: `declTyIxOfName` resolves each arm's declaration.
  -1
}

export function variantIndexOf(name: string) {
  sidArrGet(uVariantRowBySid, sidLookup(name))
}

// The only writer of `uVariants`, so its sid index cannot drift from it: the row is
// recorded as the name is appended and the first spelling keeps the slot. `sidOf` mints
// here and `variantIndexOf` probes with `sidLookup`, so a name never pushed reads absent.
export function uVariantsPush(name: string) {
  const s = sidOf(name)
  if sidArrGet(uVariantRowBySid, s) < 0 {
    sidArrPut(uVariantRowBySid, s, uVariants.length)
  }
  uVariants.push(name)
  0
}

// A row whose recorded type is exactly `ty` — the index rung of the hybrid identity below,
// with no kind test of its own so the caller's own arms decide when it may fire (D1490).
function unRowHasTyIx(ty: i32): boolean {
  let u = 0
  while u < unTyIx.length {
    if unTyIx[u] == ty { return true }
    u = u + 1
  }
  false
}

// "Is this a registered union", answered without the spelling — the hybrid identity. A
// declared union's identity is its declaration, matching by arena index; an inline union
// has no declaration, so its identity is structural, matched with `tySame` against
// `unMemTys`. Interning would have made the second cheap and destroyed the first.
export function isUnionOfTy(ty: i32): boolean {
  if ty < 0 { return false }
  if ty >= T.tys.length { return false }
  const t = T.tys[ty]
  // A nullable query against a union row: `A | null` is a spelling whose type is
  // `TyNullable(A)`, not `TyUnion[A, null]`, since the registry keys on spellings where
  // `| null` is a member atom while the checker puts nullability in a wrapper. Nothing is
  // rendered here — both sides compare arena indices structurally, not by re-implementing the renderer.
  if t is TyNullable {
    // The index rung belongs inside the shape arms (D1490): the mint resolves a row's
    // spelling, and for a union whose members share a shape that resolver answers a member,
    // so a rung firing for any `ty` would call a declared struct a union. That entry stays
    // load-bearing as the annotation's handle, but must not answer this different question.
    if unRowHasTyIx(ty) { return true }
    let rn = 0
    while rn < unMemTyCount.length {
      if unDeclIx[rn] < 0 && unMemTyCount[rn] == 2 {
        const stn = unMemTyStart[rn]
        if stn >= 0 {
          const a0 = unMemTys[stn]
          const a1 = unMemTys[stn + 1]
          if tyIsNullPrim(a1) {
            if tySame(a0, t.nInner) { return true }
          }
          if tyIsNullPrim(a0) {
            if tySame(a1, t.nInner) { return true }
          }
        }
      }
      rn = rn + 1
    }
  }
  if t is TyUnion {
    if unRowHasTyIx(ty) { return true }
    let r = 0
    while r < unMemTyCount.length {
      if unDeclIx[r] < 0 && unMemTyCount[r] == t.uMembers.length {
        const st = unMemTyStart[r]
        if st >= 0 {
          let k = 0
          let same = true
          while k < t.uMembers.length {
            if !tySame(unMemTys[st + k], t.uMembers[k]) { same = false }
            k = k + 1
          }
          if same { return true }
        }
      }
      r = r + 1
    }
  }
  false
}

// The `unNames` row whose recorded arena type is STRUCTURALLY `ty` — the canon-keyed reverse
// index. `unTyIx` alone is not enough: the arena is not hash-consed for composite spellings, so
// one spelling can mint several rows and a row-IDENTITY scan misses the registered one.
// `repCanonId` is the interned structural id those duplicates share.
export function unRowOfCanon(ty: i32): i32 {
  if ty < 0 { return -1 }
  const c = repCanonId(ty)
  let u = 0
  while u < unTyIx.length {
    if unTyIx[u] >= 0 {
      if repCanonId(unTyIx[u]) == c { return u }
    }
    u = u + 1
  }
  -1
}

// The arena row a TypeRef node's spelling denotes. Canon rewrites `tyName` in place and
// banks the rewrite in `canonTyIxCol` at the same moment, so a rewritten node's name is a
// compiler-produced spelling whose row is that column, not the pre-canon recorded type.
export function annRowOfNode(ix: i32): i32 {
  if canonRewroteNode(ix) { return canonTyIxOf(ix) }
  nodeTyIxOf(ix)
}

// The `unNames` row a spelling names, or -1 — `isUName`'s row-valued sibling, so registry-
// by-id seams can compare row to row rather than boolean to boolean: "both said yes" and
// "both named the same row" are different findings. `unionRowOf` is a wider lookup (it also
// scans `unMemberSet`); this one is the exact row `isUName` answers about.
function unRowOfName(name: string): i32 {
  let u = 0
  while u < unNames.length {
    if unNames[u] == name { return u }
    u = u + 1
  }
  -1
}

export function isUName(name: string) { unRowOfName(name) >= 0 }

// The union alias name that owns global variant `vi` (assumes `vi` is a variant of some
// declared union), or "" if none — interns a ref-list-of-union keyed by the specific
// union, so `Node[]` and `Ty[]` are distinct table slots.
function unionNameOfVariant(vi: i32) {
  const u = unionOfVariant(vi)
  if u >= 0 { return unNames[u] }
  ""
}

// The wasm struct field index of `field` within variant `vi` (declaration order), or
// -1 if that variant has no such field.
export function variantFieldIndex(vi: i32, field: string) {
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  let j = 0
  while j < cnt {
    if uFieldNames[start + j] == field { return j }
    j = j + 1
  }
  -1
}

// True if the function `name` declares the struct as its return type (flat lookup
// over the stored kind `buildFnMap` recorded — no arena rescan).
function fnRetStructSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "struct"
}

// True if the parameter `name` of function `fnIx` is the struct type.
function paramStruct(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  // STRUCTURAL fast-path (C1): a recorded declared-struct param, else the name test.
  if nodeTyIsStruct(pt) { return true }
  false
}

// True if evaluating the expression at `exprIx` yields the struct (a `(ref $0)`):
// an object literal (constructs it), a struct-returning call, a struct param/local
// reference, or a parenthesized struct expression. Anything else is an i32 value.
export function exprStruct(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is ObjLit { return true }
  if e is Paren { return exprStruct(e.parInner, fnIx) }
  // An if-EXPRESSION whose branch join is a struct — an un-annotated binding classifies kind 1
  // (the THEN arm's rep, the arms agreeing by the checker), matching `structIndexOfExpr`.
  if e is IfStmt {
    const tv = ifThenValueIx(exprIx)
    return tv >= 0 && exprStruct(tv, fnIx)
  }
  // A `m[k] ?? default` over a struct-valued map yields the value struct, so a bound
  // `const p = m[k] ?? d` classifies as a struct local. A nullable-value slot yields
  // `S | null` instead, since a stored null is preserved through `??` — `exprNullableStruct`
  // claims that arm, not this one.
  if e is BinExpr {
    const cms = coalesceMvSlot(exprIx, fnIx)
    if cms >= 0 {
      // A nullable-value slot with a NON-null default coalesces to the non-null struct too
      // (stored null included) — only a nullable default leaves it `S | null`.
      return mvValKind[cms] == 1 && !coalesceStaysNullable(exprIx, cms, fnIx)
    }
    // A `<S|null> ?? <S>` coalesce yields the non-null struct (the generic nullable-struct `??` emit) —
    // so a bound `const p = r ?? d` classifies struct and `(r ?? d).x` resolves. The left is the
    // nullable struct; the right is a plain struct default.
    if e.binOp == "??" {
      if exprNullableStruct(e.binLeft, fnIx) { return true }
      return exprStruct(e.binRight, fnIx)
    }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetStructSid(sidOfNode(e.callFn)) { return true }
      // A struct-returning function VALUE (a binding / `(i32) => S` param callee): its
      // resolved `>sN;` sig (mirrors `structIndexOfExpr`'s closure case). Falls through to the
      // per-node-type fallback below when the sig path misses (a factory-inferred value).
      if calleeReturnsStructIdxSid(sidOfNode(e.callFn), fnIx) >= 0 {
        return true
      }
    }
    // A field-closure call (`(a."*")(2)` — a rewritten operator/index trap)
    // yields the field function's return struct (mirrors `structIndexOfExpr`).
    if callee is Member {
      if (
        drwFieldClosure(structIndexOfExpr(callee.memObj, fnIx), callee.memProp)
      ) {
        const cfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if cfe >= 0 {
          if fRetKind[cfe] == "struct" { return true }
        }
      }
    }
    // Fallback, scoped to a call: a struct-returning closure value call whose callee the
    // cases above miss — an indexed closure-array element or a factory-inferred value. The
    // cheap no-render `nodeTyIsObj` reads the checker's per-node type, the boolean dual of
    // `structIndexOfExpr`'s fallback.
    return nodeTyIsObj(exprIx)
  }
  if e is Ident {
    if paramStruct(fnIx, e.identName) { return true }
    if declaredStruct(e.identName) { return true }
    // A captured struct: the env field is the struct ref (`captureValKind` sized it that
    // way), so classify it like a struct param/local — the fourth storage class this arm
    // never grew. Without it, a lambda whose body is a bare captured struct minted its
    // `$fnsig` result i32 over a body returning `(ref $S)` — two functypes, invalid wasm.
    if capturedKindOf(fnIx, e.identName) == "struct" { return true }
    return globalIsStructSid(fnIx, sidOfNode(exprIx))
  }
  // `xs[i]` over a STRUCT-element ref list yields the struct (G7-ref). Per-slot: the
  // element kind comes from the receiver's distinct ref-list slot (1 = struct).
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      // GUARD the slot (a narrowed union-arm rebind receiver can classify
      // `exprRefArray` true while the slot resolver misses — OOB otherwise).
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot < 0 || slot >= rlElemKindTbl.length { return false }
      return rlElemKindTbl[slot] == 1
    }
  }
  // A NULLABLE struct value (`S | null`) participates in the struct machinery
  // (member layout resolution); the field-read path inserts the non-null recover.
  exprNullableStruct(exprIx, fnIx)
}

// True if the already-collected declared local `name` is a nullable struct (code 9).
function declaredNulRef(name: string) { declaredKind(name) == "nulstruct" }
function declaredNulVariant(name: string) { declaredKind(name) == "nulvariant" }

// Expression `exprIx` is a nullable union variant — the variant twin of
// `exprNullableStruct`, kept strict and separate rather than folded into its struct twin,
// since the two kinds index different heap tables (`uVarHeap` vs `sHeapIdx`). A caller
// deciding a kind must tell them apart; a null test wants `exprNullableRefNiche` instead.
export function exprNullableVariant(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNullableVariant(e.parInner, fnIx) }
  // An if-expression whose arm is itself nullable (`nulIfArmNullableValueIx`, D1560):
  // without this rung, both faces of an if over an `Arm | null`-returning call floored on
  // "no interned shape", since the struct fallback claimed a value whose heap lives in
  // `uVarHeap`.
  const nlIfV = nulIfArmNullableValueIx(exprIx)
  if nlIfV >= 0 {
    if exprNullableVariant(nlIfV, fnIx) { return true }
  }
  if e is AsExpr { return retNulVariantFlag(exprIx) == 1 }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      // The direct call of a top-level function — the `nulvariant` twin of `fnRetNulRefSid`,
      // asked of both the stored kind and the callee's annotation. The annotation is
      // load-bearing: `fRetKind` is seeded before `collectU` fills the variant table, so
      // `variantIndexOf` answers -1 there and the stored kind is stale for a variant return.
      const nvfe = fnIndexOfSid(sidOfNode(e.callFn))
      if nvfe >= 0 {
        if fRetKind[nvfe] == "nulvariant" { return true }
        if nvfe < fnStmts.length {
          const nvfn = P.nodes[fnStmts[nvfe]]
          if nvfn is FuncDecl {
            if nvfn.fnRet >= 0 {
              if retNulVariantFlag(nvfn.fnRet) == 1 { return true }
            }
          }
        }
      }
      if calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "nulvariant" {
        return true
      }
    }
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return fRetKind[ffe] == "nulvariant" }
    }
    return false
  }
  if e is Ident {
    if paramNulVariant(fnIx, e.identName) { return true }
    if declaredNulVariant(e.identName) { return true }
    if capturedKindOf(fnIx, e.identName) == "nulvariant" { return true }
    const gi = globalLetOfIn(fnIx, e.identName)
    if gi >= 0 {
      const g = P.nodes[gi]
      if g is LetDecl {
        if g.letType >= 0 { return retNulVariantFlag(g.letType) == 1 }
        // UN-ANNOTATED — classify through the initializer, as the global cell's own
        // kind ladder does.
        return exprNullableVariant(g.letInit, -1)
      }
    }
    return false
  }
  // A nested-shape field read whose target is a union arm — the arm this twin never had,
  // and the reason an un-annotated rebind off such a field bound the struct niche over a
  // variant heap (D1112). Same code-15 storage the struct twin's `Member` arm classifies
  // nullable; `memberNulVariantRow` is the one reader of which table owns the target.
  if e is Member { return memberNulVariantRow(exprIx, fnIx) >= 0 }
  // A bare `m[k]` over an arm-valued map is `Circle | null` — the vals slot is `(ref null
  // $uVarHeap[vi])`, unrecovered by the get. This twin lacked the map-read rung
  // `exprNullableStruct`'s own `Index` arm has (D34): without it, a binding off such a read
  // bound the struct niche over a variant heap and the narrowed field read floored.
  if e is Index {
    // An index into a `(Circle | null)[]` whose arm is a union member (D851) — the
    // nullable twin of `exprVariantIndex`'s own `Index` arm. `refArrShapeKind` interns such
    // a list kind 1, so both niche classifiers see the same slot; `rlElemVariantRow` says
    // which table owns the element. Without it an un-annotated binding fell to the struct twin, which has no row for a union arm.
    if exprRefArray(e.idxArr, fnIx) {
      // The SAME slot guard the struct twin carries, for the same reason: a narrowed
      // union-arm rebind receiver classifies `exprRefArray` true with no slot.
      const nrls = refListSlotOfExpr(e.idxArr, fnIx)
      if nrls >= 0 && nrls < rlElemKindTbl.length {
        if rlElemKindTbl[nrls] == 1 {
          if rlElemVariantRow(nrls) >= 0 {
            if rlElemIsNulNiche(nrls) { return true }
          }
        }
      }
    }
    const mrv = mapReadMvSlot(exprIx, fnIx)
    if mrv >= 0 { return mvValVariantOf(mrv) >= 0 }
  }
  // The `m[k] ?? d` dual, gated by the SAME helper the struct twin gates its own with, so
  // the two cannot disagree about when a coalesce keeps the niche.
  if e is BinExpr {
    const crv = coalesceMvSlot(exprIx, fnIx)
    if crv >= 0 {
      return mvValVariantOf(crv) >= 0 &&
        coalesceStaysNullable(exprIx, crv, fnIx)
    }
  }
  false
}

// Expression `exprIx` is a nullable ref niche — a nullable struct (kind 9) or a nullable
// union variant. The predicate every null-test and narrowing site wants: both lower a bare
// `null` as `ref.null` and test with `ref.is_null`, neither consulting the heap table that
// separates the two kinds. A site deciding a kind must ask the strict twins instead.
export function exprNullableRefNiche(exprIx: i32, fnIx: i32) {
  if exprNullableStruct(exprIx, fnIx) { return true }
  exprNullableVariant(exprIx, fnIx)
}

// ── the non-null ref kind and its nullable niche (D1115) ──
// Every nullable ref niche is `(ref null $H)` over the same heap `$H` its non-null kind is
// `(ref $H)` over; this table doubles as "is `K` a non-null ref". Stated once, since two
// hand-written kind lists can drift out of step with each other otherwise.
export function vkNulNicheOf(k: VKind): VKind | null {
  if k == "struct" { return "nulstruct" }
  if k == "variant" { return "nulvariant" }
  if k == "list" { return "nullist" }
  if k == "reflist" { return "nulreflist" }
  if k == "strlist" { return "nulstrlist" }
  if k == "f64list" { return "nulf64list" }
  if k == "i64list" { return "nuli64list" }
  if k == "f32list" { return "nulf32list" }
  if k == "u8list" { return "nulu8list" }
  if k == "map" { return "nulmap" }
  if k == "str" { return "nulstr" }
  if k == "closure" { return "nulclosure" }
  null
}

// D1222 — the struct-field destination's rep kind, from its field code: a field names its
// destination by code while every other delivery names it by kind, so this is the code-to-
// kind edge, feeding the same `vkNulNicheOf` table. Only the non-null ref codes answer; a
// scalar, nullable, union-box, or unrepresentable field code is `null` — nothing is owed.
export function fieldCodeVKind(code: i32): VKind | null {
  if code == 3 { return "str" }
  if code == 4 { return "list" }
  if code == 5 { return "reflist" }
  if code == 6 { return "strlist" }
  if code == 14 { return "closure" }
  if code == 15 { return "struct" }
  if code == 19 { return "map" }
  if code == 25 { return "f64list" }
  if code == 26 { return "i64list" }
  if code == 27 { return "f32list" }
  if code == 35 { return "u8list" }
  null
}

// The rep kind of the cell an identifier reads, across the four storage classes: parameter
// annotation, declared local, captured env field, module global. The kind-level
// generalization of `exprNullableStruct`'s four-arm ladder. Parameter first is not a
// shadowing bug: `paramTypeNode` answers -1 once a declared local of that name is live.
export function identCellVKind(exprIx: i32, fnIx: i32): VKind | null {
  if exprIx < 0 { return null }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident {
    const pt = paramTypeNode(fnIx, e.identName)
    if pt >= 0 { return vtKindOfType(pt) }
    const dk = declaredKind(e.identName)
    if dk != null { return dk }
    const ck = capturedKindOf(fnIx, e.identName)
    if ck != null { return ck }
    const gl = globalLetOfIn(fnIx, e.identName)
    if gl >= 0 { return globalCellKind(gl) }
  }
  null
}

// D1576 — is this expression's value the `null` type, whose rep is `nullref`? Two producers
// mint the same value: a never-filled `let x = null` binding, and a call to a function whose
// every returned value is a bare `null`. The one home, so consumers that must treat the
// value as statically null ask once. An indirect call is deliberately not claimed.
export function exprIsNulNone(exprIx: i32, fnIx: i32): boolean {
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Call {
    const cf = P.nodes[unwrapParen(e.callFn)]
    if cf is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 && t < fRetKind.length { return fRetKind[t] == "nulnone" }
    }
    return false
  }
  // An if-expression whose every arm is itself `null`-typed is `null`-typed: the join of
  // `null` with `null` is `null`. One arm carrying a real value is not this — its join is a
  // genuine `T | null` and the niche paths own it. An else-less `if` used as a value is
  // `T | null`, and here `T` is already `null`.
  if e is IfStmt {
    const tvNN = ifArmValueExpr(e.ifThen)
    if tvNN < 0 { return false }
    if !exprIsNulNone(tvNN, fnIx) { return false }
    if e.ifElse < 0 { return true }
    const evNN = ifArmValueExpr(e.ifElse)
    return evNN >= 0 && exprIsNulNone(evNN, fnIx)
  }
  // Every other node kind asks the cell, which is the named default and not a fall-through:
  // an Ident, a captured read, and a module global all resolve through `identCellVKind`, and
  // for a kind that names no cell it answers `null` — the right answer for every remaining kind.
  identCellVKind(exprIx, fnIx) == "nulnone"
}

// D1576 — `x ?? d` where `x` is the `null` type is exactly `d`, so a classifier asked about
// the `??` must answer about the default, at the default's rep. Returns `d`'s node index, or
// -1 when this is not that shape. Without it, `print(x ?? "d")` classified i32 over a string ref.
function coalesceNulNoneDefaultIx(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" {
      if exprIsNulNone(e.binLeft, fnIx) { return e.binRight }
    }
  }
  -1
}

// The binding half of `exprIsNulNone`: is the LetDecl at `letIx` a binding whose only value
// is `null`? Two producers, matching the expression side: a never-filled infer-null hole
// (D1576), and an un-annotated binding to a call returning `null` always. An annotated
// binding never lands here: its annotation pins the rep, and `C | null = null` is `nulstruct`.
export function letIsNulNone(letIx: i32, fnIx: i32): boolean {
  if letIx < 0 { return false }
  const s = P.nodes[letIx]
  if s is LetDecl {
    if s.letType >= 0 || s.letInit < 0 { return false }
    const ini = P.nodes[unwrapParen(s.letInit)]
    if ini is NullLit { return letNullHoleUnfilled(letIx) }
    return exprIsNulNone(s.letInit, fnIx)
  }
  false
}

// The result valtype kind of `fnIx`, read off the same ladder `emitOneFuncType` writes the
// result byte from — annotation, then the un-annotated closure fact, then the stored
// inferred kind — so a site repairing the value cannot disagree with the result it repairs.
// The closure arm is not a special case, it is the one kind `fRetKind` does not carry, so it is asked ahead of the stored kind.
function retResultVKind(fnIx: i32, fnPos: i32): VKind | null {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return vtKindOfType(fn.fnRet) }
    if fnPos < 0 { return null }
    if fnPos < fRetVoid.length {
      if fRetVoid[fnPos] == 1 { return null }
    }
    if fnReturnsClosure(fnPos) { return "closure" }
    if fnPos < fRetKind.length { return fRetKind[fnPos] }
  }
  null
}

// D1115 — does the return boundary owe a `ref.as_non_null` for `retArg`? The criterion:
// the result valtype is a non-null ref and the value classifies as the nullable niche. A
// prior guard named only two kinds of thirteen, so a narrowed nullable list, map, ref-list,
// or closure parameter returned into its own non-null result — invalid wasm at `vl check` rc 0.
export function retNeedsNonNullRecover(retArg: i32, fnIx: i32, fnPos: i32) {
  nulNicheRecoverOwed(retResultVKind(fnIx, fnPos), retArg, fnIx)
}

// Does the value at `exprIx` lower to the nullable ref niche `niche`? The cell question
// first (`identCellVKind`): a name's storage class states its rep outright. The per-rep
// predicates behind it reach a value that is not a name — a call result, a cast, a map
// read, a `??` merge — each asked only for its own niche, so kinds never cross-satisfy.
function exprIsNulNicheOf(niche: VKind, exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if identCellVKind(exprIx, fnIx) == niche { return true }
  if niche == "nulstruct" { return exprNullableStruct(exprIx, fnIx) }
  if niche == "nulvariant" { return exprNullableVariant(exprIx, fnIx) }
  if niche == "nulclosure" { return exprNulClosure(exprIx, fnIx) }
  if niche == "nulstr" { return exprNullableString(exprIx, fnIx) }
  if niche == "nulmap" { return exprNullableMap(exprIx, fnIx) }
  if niche == "nullist" { return exprNullableList(exprIx, fnIx) }
  if niche == "nulreflist" { return exprNullableRefArray(exprIx, fnIx) }
  exprNulScalarListKind(exprIx, fnIx) == niche
}

// D1115 — does a destination of kind `dk` owe `ref.as_non_null` on the value at `exprIx`?
// A nullable niche read deliberately keeps its raw `(ref null $H)`, since narrowing is
// type-level and the use site recovers. Every delivery into a `(ref $H)` destination owes
// the recover, and a rep added to `vkNulNicheOf` reaches every position that asks here.
export function nulNicheRecoverOwed(dk: VKind | null, exprIx: i32, fnIx: i32) {
  if dk == null { return false }
  const niche = vkNulNicheOf(dk)
  if niche == null { return false }
  exprIsNulNicheOf(niche, exprIx, fnIx)
}

// True if `name` is a declared NULLABLE function-value local (`fn | null`, kind 19) — the
// closure dual of `declaredNulRef`.
function declaredNulClosure(name: string) { declaredKind(name) == "nulclosure" }

// True if the expression at `exprIx` is a NULLABLE function value (`fn | null`, kind 19) —
// currently a kind-19 local ident. Drives the `== null` / `!= null` test (`ref.is_null`)
// and the narrowed-call recover, the closure analogue of `exprNullableStruct`.
export function exprNulClosure(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // An if-EXPRESSION whose arm is ITSELF nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfC = nulIfArmNullableValueIx(exprIx)
  if nlIfC >= 0 {
    if exprNulClosure(nlIfC, fnIx) { return true }
  }
  const ux = unwrapParen(exprIx)
  const e = P.nodes[ux]
  if e is Ident {
    if paramNulClosure(fnIx, e.identName) { return true }
    if declaredNulClosure(e.identName) { return true }
    // A CAPTURED `((…) => R) | null` cell — the env field is the same
    // `(ref null $cloStruct)` fat pointer, typed by `captureValKind`.
    if capturedKindOf(fnIx, e.identName) == "nulclosure" { return true }
    // A module-global nullable-closure cell (kind 19).
    const gl = globalLetOfIn(fnIx, e.identName)
    if gl >= 0 { return globalCellKind(gl) == "nulclosure" }
    return false
  }
  // A call of a function whose return type is a nullable closure: the result is the kind-19
  // niche `(ref null $cloStruct)`. A named function reads its `fnRet`; a closure-typed value
  // callee reads its return-type annotation (`calleeCloRetName`). Drives local-kind
  // inference and the `f != null` compare, the closure analogue of `exprNullableStruct`.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const cfn = P.nodes[fnStmts[t]]
        if cfn is FuncDecl { return nulCloFlag(cfn.fnRet) == 1 }
      }
      if nameIsNulClosure(calleeCloRetName(callee.identName, fnIx)) {
        return true
      }
    }
    // An indexed closure-array element call, or a struct-field closure call whose resolved
    // `$fnsig` result is the nullable-closure niche: the result is the kind-19 `(ref null
    // $cloStruct)`. Uses the same `cloCallSigKey` resolution the call emit casts with, so the
    // classification and the cast always agree.
    return sigKeyRetKind(cloCallSigKey(ux, fnIx)) == "nulclosure"
  }
  // A nullable-closure struct FIELD read (`recv.op` over a `((i32) => i32) | null` field,
  // code 22): the raw `(ref null $cloStruct)` — its `!= null` lowers to `ref.is_null` and
  // the narrowed call recovers non-null (`ref.as_non_null`) at the call site.
  if e is Member { return memberFieldCode(ux, fnIx) == 22 }
  // A bare `m[k]` over a FUNCTION-valued map (mv kind 14) reads back a NULLABLE closure
  // `(ref null $cloStruct)` — `const f = m[k]` binds the kind-19 niche, narrowed `if f != null`.
  if e is Index {
    // Indexing a `(((i32) => boolean) | null)[]` (a kind-5 ref list whose element slot keeps
    // the `| null`) yields a NULLABLE closure — the read left it `(ref null $cloStruct)`, so
    // `const f = xs[i]; if f != null` narrows. The closure dual of `exprNullableList`'s arm.
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemKindTbl[slot] == 5 && rlElemNullable[slot] == 1 { return true }
      }
    }
    const mrs = mapReadMvSlot(ux, fnIx)
    if mrs >= 0 { return mvValKind[mrs] == 14 }
  }
  // A `m[k] ?? d` read over a nullable-closure-valued map stays nullable only when the
  // default is itself nullable; a non-null default coalesces every null (stored included)
  // to the non-null closure — the closure dual of `exprNullableStruct`'s coalesce arm.
  if e is BinExpr {
    const cns = coalesceMvSlot(ux, fnIx)
    if cns >= 0 {
      return mvValKind[cns] == 14 && coalesceStaysNullable(ux, cns, fnIx)
    }
  }
  false
}

// True if an UN-annotated `const f = <init>` should infer a NULLABLE-closure (kind 19) slot —
// its init reads back a nullable closure (a bare `m[k]` over a function-valued map). The
// annotated form is `letIsNulClosure`; this is its init-driven dual (it lives here, not in
// `emit_query`, because it consults the wasmEmit-side `exprNulClosure`).
export function letInfersNulClosure(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return false }
    if d.letInit < 0 { return false }
    return exprNulClosure(d.letInit, fnIx)
  }
  false
}

// True if the already-collected declared local `name` is a nullable i32 list (kind 15).
function declaredNulList(name: string) { declaredKind(name) == "nullist" }

// True if the already-collected declared local `name` is a struct ref. Resolves to
// the IN-SCOPE binding's slot (so a same-named binding in a sibling/inner block reads
// ITS own valtype, not an unrelated branch's).
function declaredStruct(name: string) { declaredKind(name) == "struct" }

// True if the binding's annotation is a single inline object shape (with a trailing `|
// null` stripped) that is not interned as a struct — its shape could not be built (an
// unsupported field type). Checked only after union/nullable-struct/struct classification,
// so a valid inline-struct binding never reaches it; catches the remainder so it rejects cleanly.
export function letAnnIsUninternedShape(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType < 0 { return false }
    const nm = nonNulBaseOf(tyNameOf(d.letType))
    // The spelled-shape half asks the tree, not the arena: `nameIsShapeSpanEnds` is character
    // surgery over the rendering, testing whether the author wrote an inline object shape
    // rather than a map. The arena's `TyObj` sees through a named alias or generic application
    // to the object it denotes, so testing it directly admits false positives it must reject.
    if !annIsSpelledInlineShape(d.letType, nm) { return false }
    // The struct-table lookup stays name-keyed: `sTyRow` is not populated for every shape
    // `sNames` knows, and the row's identity is the name. That is the interning layer, not a
    // type decision.
    if structIndexByName(nm) >= 0 { return false }
    // The third resolver's fall-through, mirroring `paramStructIndex`'s inline-shape rung
    // (D111): the name above cannot find an inline shape a declared struct of the same
    // layout already owns, since `internInlineShapeTy` dedups onto that row and pushes no
    // `sNames` entry. `monoAnnPinName`'s inline-shape rung must land first; not safe alone.
    repSlotOfTy(nodeRepTyIxOf(d.letType)) < 0
  }
  false
}

// True if the `LetDecl` at `letIx` carries a value-union annotation — the declared-spelling
// half of `letIsUnion`, asked without looking at the initializer. A literal union is
// excluded, since it reps as an interned i32 atom, not the box. The initializer-free
// reading is what makes it usable from `structIndexOfLet`, on the path `exprUnion` reaches.
function letAnnIsUnion(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // Not `nodeTyIsUnionAlias(d.letType)`, though it reads as exactly this conjunction:
        // its body has two more positive arms — a same-shape-collapsed `TyObj` and a
        // nullable numeric literal union — both wider than `isUName`, and this site needs the
        // narrower set. Trying it broke six passing tests.
        return isUNameAB(2, lt.tyName, annRowOfNode(d.letType)) &&
          !nodeTyIsLitUnionAlias(d.letType)
      }
    }
  }
  false
}

// True if the `LetDecl` at `letIx` declares a struct-typed local: its annotation names the
// struct, or its initializer produces one. Picks the local's valtype (`(ref $0)` vs i32) in
// `collectLocals`.
export function letIsStruct(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // The arena rung: `nodeTyIsStruct` is the checker-side twin already provided for
        // "does this annotation denote a struct", an arena-index set instead of an O(nodes)
        // name scan. A strict superset: the arena claims spellings `isSName` structurally
        // cannot — a generic application, a canonicalized intersection, an inline shape.
        if nodeTyIsStruct(d.letType) { return true }
        // This residue leg is inert on the corpus: the arena rung above already claims every
        // struct-typed let a corpus program declares. Kept rather than deleted, since inert
        // proves redundant, not dead — the shape it would catch is exactly what a fixture
        // corpus can lack.
        if isSName(lt.tyName) { return true }
      }
    }
    return exprStruct(d.letInit, fnIx)
  }
  false
}

// True if the `LetDecl` at `letIx` binds a concrete union-variant value — a kind-8 local
// `(ref $(uVarHeap[vi]))`, distinct from the union box (kind 4) and a standalone struct
// (kind 1). Annotation first, else the init's variant value. Checked after the struct/union
// local cases so only an explicit variant annotation or variant-valued init reaches here.
export function letIsVariant(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // Name, not `variantRowOfTy`: that twin is index-only, answering only for a node that
        // resolves to the variant's declaration. A second node spelling the same inline shape
        // mints its own arena row and compares unequal, so under-answering here would unbind
        // a variant let — the name stays.
        if variantIndexOf(lt.tyName) >= 0 { return true }
      }
    }
    // The init's rep is `exprVariantIndex`'s answer, and nothing second-guesses it. A guard
    // that re-asks the struct table to catch a plain-struct twin of an arm misreads a variant
    // index as a struct row whenever the struct table is non-empty, since the two tables
    // share one integer namespace and a bounds check against `sHeapIdx.length` cannot tell (D26).
    return exprVariantIndex(d.letInit, fnIx) >= 0
  }
  false
}

// The union-variant table index a variant-typed `LetDecl` binds (annotation first, else
// the init's variant value), or -1.
export function variantIndexOfLet(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        const vi = variantIndexOf(lt.tyName)
        if vi >= 0 { return vi }
      }
    }
    // Mirrors `letIsVariant` — including the retired `letInitReboxesToVariant` guard, whose
    // reasoning is recorded there.
    return exprVariantIndex(d.letInit, fnIx)
  }
  -1
}

// The union-variant row an un-annotated object-literal `LetDecl` initializer denotes:
// `objVariantName`'s field-set match, or -1 if `structIndexOfObj` already claims a row (D39,
// D51). Re-asks under the opposite precondition from `structIndexOfLet`'s -1, since a bare
// `{ r: n }` can have two nominal claimants and only one remains once a struct row is ruled out.
export function objLitVariantIdxNoStructRow(exprIx: i32) {
  if exprIx < 0 { return -1 }
  const oi = unwrapParen(exprIx)
  const e = P.nodes[oi]
  if e is ObjLit {
    if structIndexOfObj(oi) >= 0 { return -1 }
    const vn = objVariantName(oi)
    if vn == "" { return -1 }
    return variantIndexOf(vn)
  }
  -1
}

// The same answer for a `LetDecl`'s INITIALIZER, and only for an UN-annotated binding:
// an ANNOTATED one is `letAnnVariantIdx`'s (D52), whose nominal answer must not be
// second-guessed by a field-set scan in either direction.
export function letObjLitVariantIdx(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return -1 }
    return objLitVariantIdxNoStructRow(d.letInit)
  }
  -1
}

// ── multi-struct index resolution ──
// Parallel to the boolean `exprStruct` family, these return the struct table index a
// struct-typed expression, param, local, or return produces, so a field read/write can
// resolve the right heap type and field layout. Return -1 when not a struct.

// The struct table index of the param `name` of function `fnIx` (from its annotation), or
// -1 (D891). `structIndexOfExpr`'s `Ident` arm resolves a parameter's layout through the
// ladder below, not through `paramStructIdxOf`, so a param whose slot a merge moved must be
// redirected on both, or the two disagree by construction and the module fails to parse.
function paramStructIndex(fnIx: i32, name: string) {
  // The `fnIx < 0` guard is first and load-bearing: at module scope there is no enclosing
  // function, and `fnParamNodeOf` indexes `P.nodes[-1]` — a compiler trap (out of bounds
  // array access). The raw body below opens with the same guard, for the same reason.
  if fnIx < 0 { return -1 }
  return anonLeafParamRowOf(
    fnParamNodeOf(fnIx, name),
    paramStructIndexRaw(fnIx, name),
  )
}

// The un-redirected answer: the annotation's own row, through the three-rung ladder below.
function paramStructIndexRaw(fnIx: i32, name: string) {
  if fnIx < 0 {
    return -1 // module-scope initializer (no enclosing function)
  }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            const ty = P.nodes[p.parType]
            if ty is TypeRef {
              // A plain struct name, or the `S | null` nullable base — not a union variant,
              // since a variant-typed param rides the gap-#2 path. Name, not the arena: for a
              // generic original's param, the arena's recorded type is the un-substituted
              // shape, while the shadow ruling correctly says the parameter binds nothing.
              const psi = structIndexByName(ty.tyName)
              if psi >= 0 { return psi }
              const pnb = nulBaseStructRow(p.parType, ty.tyName)
              if pnb >= 0 { return pnb }
              // The inline-shape rung (`annValtypeSlotOf`'s, verbatim): an inline shape whose
              // row a declared struct of the same layout already owns dedups with no `sNames`
              // entry, while the functype for the same node resolves through `repSlotOfTy`
              // (D53). Last, inline-shape only, and not a generic original — each guard answers a recorded failure.
              if fn.fnTyParams.length == 0 {
                if nameIsShapeSpanEnds(ty.tyName) {
                  if variantIndexOf(ty.tyName) < 0 {
                    const pbr = repSlotOfTy(nodeRepTyIxOf(p.parType))
                    if pbr >= 0 { return pbr }
                  }
                }
              }
            }
          }
          return -1
        }
      }
      i = i + 1
    }
  }
  -1
}

// The union-variant table index of the param `name` of function `fnIx` (when its annotation
// names a variant struct of the declared union), or -1 — such a param's value is already
// narrowed/unboxed, so a field read needs no box unwrap. Name, not the arena: a union whose
// arms are structurally identical collapses to arm 0's row, but the param is the whole union.
function paramVariantIndex(fnIx: i32, name: string) {
  const pv = paramTypeNode(fnIx, name)
  if annUnionAtomsOf(pv) >= 2 { return -1 }
  variantRowOfTy(nodeTyIxOf(pv))
}

// The union-variant table index an expression at `exprIx` yields a CONCRETE variant
// struct ref for (a variant-typed param reference, or a parenthesized one), or -1. The
// receiver shape for a gap-#2 field read `o.field` where `o: TyObj`.
export function exprVariantIndex(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Paren { return exprVariantIndex(e.parInner, fnIx) }
  // `x as Cat` over a union yields the concrete variant — the cast's own recorded type is
  // the arm the checker proved. Without it, a binding cast to a variant falls to the i32 slot
  // default, and the `ref.cast` the cast emits lands in a slot typed i32.
  if e is AsExpr {
    if asExprIsUnionCastIn(exprIx, fnIx) {
      const anm = nominalStructNameOfTy(nodeTyIxOf(exprIx))
      if anm != "" { return variantIndexOf(anm) }
    }
    return -1
  }
  if e is Ident {
    const pvi = paramVariantIndex(fnIx, e.identName)
    if pvi >= 0 { return pvi }
    const dvi = declaredVariantIndex(e.identName)
    if dvi >= 0 { return dvi }
    // The capture leg — the fourth storage class this ladder lacked while its
    // boolean-and-nullable siblings carry it. `captureValKind`/`captureValStructIdx` already
    // bank the fact; only the reader is missing here. Without it a captured variant read
    // answers -1 and a nested function hands a raw struct ref to a union-box parameter.
    const cvi = capturedVariantIndex(fnIx, e.identName)
    if cvi >= 0 { return cvi }
    // A module GLOBAL whose cell is the kind-8 raw variant — the global twin of the
    // `declaredVariantIndex` LOCAL leg above, and the leg every member-read site
    // (`o.field`) needs to pick `uVarHeap` over `sHeapIdx` for a variant receiver.
    return globalVariantIndexSid(fnIx, sidOfNode(exprIx))
  }
  // A call to a `: Cat`-returning function yields the concrete variant ref, in the three
  // callee forms the nullable twin handles arm for arm: a declared function, a closure value,
  // or a closure-valued field. Missing the latter two, a lambda binding or field closure
  // answers -1 — the whole kind decision here — so the value falls to the struct table.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const cvsid = sidOfNode(e.callFn)
      // A DECLARED function keeps its own richer resolution (the `: Cat` annotation, then
      // the inferred `fRetKind`/`fRetStructIdx` pair) — unchanged, and asked first so no
      // named-callee answer moves.
      if fnIndexOfSid(cvsid) >= 0 { return fnRetVariantIndexSid(cvsid) }
      // A closure-value callee (`const f = (x: Circle) => x; f(c)`, `const f = idc; f(c)`,
      // a closure param `f(c)`), which `fnIndexOfSid` misses by construction. The resolved
      // `$fnsig` key is the same key `emitCallRef` casts the call through, so the slot this
      // reads and the functype the call site emits come from one fact.
      const cvk = calleeCloSigKeySid(cvsid, fnIx)
      if sigKeyRetKind(cvk) == "variant" { return sigKeyRetSlot(cvk) }
      return -1
    }
    // A closure-valued FIELD callee (`holder.go(c)`) — the twin's third rung, same gate.
    if callee is Member {
      const cvfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if cvfe >= 0 {
        if cloRetValKind(cvfe) == "variant" { return cloRetValSlot(cvfe) }
      }
      return -1
    }
    return -1
  }
  // An index into a `Cat[]` variant-element ref list yields the bare variant struct.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const ren = refListElemNameOfExpr(e.idxArr, fnIx)
      // A plain-struct element list whose element shape also matches a value-union's struct
      // member must not read through that union's variant heap: the array physically holds
      // the plain struct's own heap, a distinct type from the box member. Only a genuine
      // concrete-variant element list resolves through the variant heap here.
      if structIndexByName(ren) < 0 { return variantIndexOf(ren) }
    }
    // A bare `m[k]` over an arm-valued map yields the bare variant struct — the map rung
    // this ladder lacked while `structIndexOfExpr`'s own `Index` arm carries its struct twin
    // (D34). Same slot, same kind gate, the other column; the two cannot both answer for one
    // binding.
    const ivs = mapReadMvSlot(exprIx, fnIx)
    if ivs >= 0 { return mvValVariantOf(ivs) }
  }
  // A `m[k] ?? d` over an arm-valued map — the BinExpr dual of the Index rung above, and
  // the same pairing: `structIndexOfExpr`'s `??` arm already reads `mvValStructIdx` off
  // `coalesceMvSlot`.
  if e is BinExpr {
    const cvs = coalesceMvSlot(exprIx, fnIx)
    if cvs >= 0 { return mvValVariantOf(cvs) }
    // A `<T|null> ?? <T>` whose `T` is a union ARM yields the non-null arm ref — the
    // variant twin of `structIndexOfExpr`'s own `??` arm, and needed for the same reason:
    // without it `(r ?? d).field` has no layout. The left's nullable-variant row drives
    // it, else the right default's.
    if e.binOp == "??" {
      if exprNullableVariant(e.binLeft, fnIx) {
        const lv = nulVariantIdxOfExpr(e.binLeft, fnIx)
        if lv >= 0 { return lv }
      }
      return exprVariantIndex(e.binRight, fnIx)
    }
  }
  -1
}

// The union-variant table index a module global's cell holds, or -1 — the global sibling
// of `globalStructIndexSid`, gated on the cell actually being the kind-8 variant so the two
// never both answer for one binding. A global whose init names another global recurses one
// level per link; module globals cannot cycle.
function globalVariantIndexSid(fnIx: i32, sid: i32): i32 {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return -1 }
  if globalCellKind(li) != "variant" { return -1 }
  globalCellStructIdx(li)
}

// The union-VARIANT table index a function `name` returns (its `: Cat` return
// annotation), or -1.
function fnRetVariantIndexSid(sid: i32) {
  const fe = fnIndexOfSid(sid)
  if fe >= 0 {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      if fn.fnRet >= 0 {
        // The kind decides, not the name: `variantIndexOf` answers for any spelling
        // `uVariants` holds, including one that still lowers as the standalone struct because
        // the checker never called it a variant. Taking the index anyway would feed a
        // `uVarHeap` cell from an `sHeapIdx` value — invalid wasm.
        if retVariantFlag(fn.fnRet) != 1 { return -1 }
        const rt = P.nodes[fn.fnRet]
        if rt is TypeRef { return variantIndexOf(rt.tyName) }
        return -1
      }
      // The un-annotated callee, by the same rule the arm above states: when there is no
      // annotation, the predicate is `fRetKind`/`fRetStructIdx`, the pair `emitOneFuncType`'s
      // inferred variant arm emits — reading the same pair here is agreement, not a second
      // opinion. Without it the callee validates but the caller does not (D52).
      if fe < fRetKind.length {
        if fRetKind[fe] == "variant" { return fRetStructIdx[fe] }
      }
    }
  }
  -1
}

// The union-variant table index of the declared local `name` (a kind-8 variant local —
// its `localStructIdx` holds the variant index), or -1.
function declaredVariantIndex(name: string) {
  const slot = declaredSlotOf(name)
  if slot < 0 { return -1 }
  if localIsRef[slot] == "variant" { return localStructIdx[slot] }
  -1
}

// The struct table index of the declared local `name` (recorded in `localStructIdx`),
// or -1 if `name` is not a struct local.
function declaredStructIndex(name: string) {
  const slot = declaredSlotOf(name)
  if slot < 0 { return -1 }
  if localIsRef[slot] == "struct" { return localStructIdx[slot] }
  if localIsRef[slot] == "nulstruct" { return localStructIdx[slot] }
  -1
}

// The struct table index a function `name` returns (recorded in `fRetStructIdx`), or -1.
function fnRetStructIndexSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return -1 }
  // Kind-gated, like every other reader of the polymorphic companion slot: `fRetStructIdx`
  // holds four namespaces selected by `fRetKind` (struct row, variant index, ref-list slot,
  // map shape), and every sibling reader gates on the kind first (D26) — the producer needs
  // the same gate a misreading consumer already carries.
  const k = fRetKind[i]
  if k != "struct" && k != "nulstruct" { return -1 }
  // D871 — the same redirect the map's value slot and the local's cell take: the row the
  // return annotation names is the row the `??` family superseded, and the callee's returned
  // literal is minted at the merged row instead. Safe under the four-namespace slot since the
  // kind gate above already establishes this one is a struct-table row.
  if !anonLeafRetMovedOf(fnStmts[i]) { return fRetStructIdx[i] }
  anonLeafSupersedeOf(fRetStructIdx[i])
}

// The struct table index of a module global `name` (from its annotation/initializer),
// or -1.
function globalStructIndexSid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return -1 }
  // Kind-gated, like every other storage class's struct reader — with only its variant
  // sibling gated, the two can both answer for one binding, and `emitUnionBoxArg`'s
  // layout-twin test re-emits the value from the twin's heap type (D200). `globalCellKind` is
  // the same function `emitGlobalSection` writes the cell with, so the two cannot drift.
  const gk = globalCellKind(li)
  if gk != "struct" && gk != "nulstruct" { return -1 }
  // D842 — the same redirect `globalCellStructIdx` takes, for the reason the block above
  // gives: this reader and `emitGlobalSection`'s cell must not drift, since the section writes
  // a superseded nullable-struct cell at the merged row and each site resolves the row
  // separately — skipping the redirect at either lets a `??`-merged global mismatch its cell's layout.
  globalNulRefSupersede(li, structIndexOfLet(li, -1))
}

// The struct table index of a captured struct-ref variable `name` of the capturing lifted
// function `fnIx`, or -1. Mirrors `emitCapturedRead`'s guards so a captured struct receiver
// resolves exactly as a param/local/global receiver would. Gated on the capture's kind: the
// companion slot is polymorphic, so a map's mv slot read back as a struct index traps.
function capturedStructIndex(fnIx: i32, name: string) {
  const ck = capturedKindOf(fnIx, name)
  if ck != "struct" && ck != "nulstruct" { return -1 }
  capturedCompanionSlot(fnIx, name)
}

// The ref-list table slot of a captured ref-array variable, or -1 — `capturedStructIndex`'s
// sibling on the other index space the companion slot ranges over. The kind gate keeps a
// ref-list slot out of `sFieldStart` and a struct row out of `rlElemName`, so a captured
// `S[]` read resolves the same wrapper the env field is typed with.
export function capturedRefListSlot(fnIx: i32, name: string) {
  const ck = capturedKindOf(fnIx, name)
  if ck != "reflist" && ck != "nulreflist" { return -1 }
  capturedCompanionSlot(fnIx, name)
}

// The map shape of a captured nullable-map cell, or -1 when `name` is not such a capture.
// Reads the companion slot rather than re-deriving from the parent binding on purpose:
// `captureValStructIdx` typed the env field off that very number, so the narrowed read and
// the field cannot name two different `$mapStruct`s. -1 is safe only because the kind gate runs first.
function capturedNulMapShape(fnIx: i32, name: string) {
  if capturedKindOf(fnIx, name) != "nulmap" { return -1 }
  capturedCompanionSlot(fnIx, name)
}

// The raw `fbValtype` companion slot of a captured `name` of `fnIx`, or -1 when `name` is
// not a capture. Polymorphic in the kind — the number lives in whichever index space
// `capturedKindOf` names, so every consumer goes through a kind-gated reader above and never
// calls this directly.
function capturedCompanionSlot(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  if !fnValUsed { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return -1 }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { return captureValStructIdx(fe, name) }
    ci = ci + 1
  }
  -1
}

// True if the CAPTURED variable `name` of the capturing lifted function `fnIx`
// is BOOLEAN-typed in the parent frame (a `boolean` param annotation, a
// `boolean`-annotated let, or a bool-literal init). Bool rides in an i32, so
// `capturedKindOf` cannot carry it — this is the print/`fRetBool` side channel.
function capturedIsBool(fnIx: i32, name: string) {
  if fnIx < 0 { return false }
  if !fnValUsed { return false }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return false }
  const caps = captureNamesOf(fe)
  let isCap = false
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { isCap = true }
    ci = ci + 1
  }
  if !isCap { return false }
  const b = parentBindingOf(fe, name)
  if b < 0 { return false }
  const bn = P.nodes[b]
  // `tyIsBool` IS this test — `tyNameOf` returns "" for a negative index and for a non-`TypeRef`,
  // which is that function's `false`. Two hand-written copies of one predicate, now one call each;
  // the destringification rides in `tyIsBool` alone.
  if bn is Param { return tyIsBool(bn.parType) }
  if bn is LetDecl {
    if bn.letType >= 0 { return tyIsBool(bn.letType) }
    if bn.letInit >= 0 {
      const iv = P.nodes[unwrapParen(bn.letInit)]
      if iv is BoolLit { return true }
    }
  }
  false
}

// The value kind of a captured variable `name` of the capturing lifted function `fnIx`, or
// `null` if not a capture — the classifier-side mirror of `capturedStructIndex`. No
// `fnEnvIdxOf` guard, since that index is minted after every classification pass and gating
// on it silently answered `null` for the whole of `computeRetInference` — invalid wasm.
export function capturedKindOf(fnIx: i32, name: string): VKind | null {
  if fnIx < 0 { return null }
  if !fnValUsed { return null }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return null }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { return captureValKind(fe, name) }
    ci = ci + 1
  }
  null
}

// True when `name` is a capture of `fnIx` whose env field holds the value-union box. Asked
// of `captureValKind`, the function that typed that field, so the answer cannot disagree with
// what rides in the env. The gate for the narrowed-read unbox in `emitIdentNode` on the
// capture storage class, since the name-based gate the other storage classes use answers "" for a capture.
export function capturedIsUnionBox(fnIx: i32, name: string) {
  capturedKindOf(fnIx, name) == "union"
}

// True when the identifier `name` reads a frame slot of `fnIx` — a param, declared local, or
// capture — that holds the union box. Narrowing-blind on purpose: a list op's scratch
// reservation and its receiver resolution run in different passes and must answer the same
// way, since what the slot holds does not depend on narrowing. A global is deliberately not here.
export function identSlotIsUnionBox(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  if pt >= 0 { return vtKindOfType(pt) == "union" }
  if declaredKind(name) == "union" { return true }
  capturedIsUnionBox(fnIx, name)
}

// The union member-set NAME of a CAPTURED union-box variable `name` (kind 4) of the capturing
// function `fnIx` — resolved from the PARENT frame's binding annotation / init, so `a is Cat`
// narrows a captured `a: Cat | Dog`. "" when `name` is not a captured union. The union-name
// dual of `capturedStructIndex`.
function capturedUnionName(fnIx: i32, name: string) {
  if capturedKindOf(fnIx, name) != "union" { return "" }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return "" }
  const b = parentBindingOf(fe, name)
  if b < 0 { return "" }
  const bn = P.nodes[b]
  if bn is Param {
    const pn = tyNameOf(bn.parType)
    // The registry test off the row: a canon-rewritten `tyName` is a compiler-produced
    // spelling, so `annRowOfNode` reads `canonTyIxOf` there and `nodeTyIxOf` otherwise, though
    // the name is still the product returned.
    if unRowOfCanon(annRowOfNode(bn.parType)) >= 0 { return pn }
    return ""
  }
  if bn is LetDecl {
    const par = fnParent[fe]
    if par >= 0 { return letUnionNameOf(b, fnStmts[par]) }
  }
  ""
}

export function structIndexOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is ObjLit { return structIndexOfObjCtx(exprIx, fnIx) }
  if e is Paren { return structIndexOfExpr(e.parInner, fnIx) }
  // An if-EXPRESSION whose join is a struct (`const b = if c { mk(1) } else { mk(2) }`): the
  // THEN arm's struct index classifies the whole `if` (the checker proved the arms agree), so an
  // un-annotated binding resolves the same struct heap type the `emitIfExprRef` join emits.
  if e is IfStmt {
    const tv = ifThenValueIx(exprIx)
    if tv >= 0 { return structIndexOfExpr(tv, fnIx) }
  }
  // A `m[k] ?? default` over a STRUCT-valued map resolves to the value type's struct index (the
  // mv slot's `mvValStructIdx`), so the field-read layout is found.
  if e is BinExpr {
    const cms = coalesceMvSlot(exprIx, fnIx)
    if cms >= 0 {
      // An ARM value has no `sNames` row; its layout is `exprVariantIndex`'s (D34).
      if mvValVariantOf(cms) >= 0 { return -1 }
      if mvValKind[cms] == 1 { return mvValStructIdxOf(cms) }
    }
    // A `<S|null> ?? <S>` coalesce resolves to the (inner) struct index — so `(r ?? d).field` finds
    // the layout. The left's nullable struct drives it (its inner struct), else the right default.
    if e.binOp == "??" {
      const ls = structIndexOfExpr(e.binLeft, fnIx)
      if ls >= 0 { return ls }
      return structIndexOfExpr(e.binRight, fnIx)
    }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const ri = fnRetStructIndexSid(sidOfNode(e.callFn))
      if ri >= 0 { return ri }
      // A struct-returning function VALUE (a binding / `(i32) => S` param callee, invisible
      // to `fnRetStructIndex`): the struct index from its resolved `>sN;` sig. Falls through to the
      // per-node-type fallback below when the sig path misses (a value INFERRED from a factory call —
      // `const g = mk()` — whose `>sN;` the syntactic path can't recover).
      const ci = calleeReturnsStructIdxSid(sidOfNode(e.callFn), fnIx)
      if ci >= 0 { return ci }
    }
    // A field-closure call (`(a."[]")(i)` — a chained index trap whose "[]"
    // returns another trap object) yields the field function's return struct.
    if callee is Member {
      if (
        drwFieldClosure(structIndexOfExpr(callee.memObj, fnIx), callee.memProp)
      ) {
        const cfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if cfe >= 0 {
          if fRetKind[cfe] == "struct" || fRetKind[cfe] == "nulstruct" {
            // D1100 — through the `??` merge's return-row redirect: the field holds a
            // function whose return row the merge moved, so the call yields the merged row
            // while `fRetStructIdx` still names the declaration's. `anonLeafRetRowOf` is `si`
            // unchanged for every field closure outside such a family.
            return anonLeafRetRowOf(anonLeafFeDeclNode(cfe), fRetStructIdx[cfe])
          }
        }
      }
    }
    // D1100 — a call that hands the function back (`pick()({r: 4})`), same shape as the
    // indexed arm below: only where the redirect moves the row.
    if callee is Call {
      const rfe = anonLeafRetCallFe(e.callFn)
      if rfe >= 0 && rfe < fRetKind.length && rfe < fRetStructIdx.length {
        if fRetKind[rfe] == "struct" || fRetKind[rfe] == "nulstruct" {
          const rrr = anonLeafRetRowOf(
            anonLeafFeDeclNode(rfe),
            fRetStructIdx[rfe],
          )
          if rrr != fRetStructIdx[rfe] { return rrr }
        }
      }
    }
    // D1100 — an indexed closure-array call whose element is a function the `??` merge moved.
    // Only where the redirect actually moves the row, so every other indexed closure call
    // keeps the fallbacks below.
    if callee is Index {
      const efe = anonLeafArrElemFe(callee.idxArr, fnIx)
      if efe >= 0 && efe < fRetKind.length && efe < fRetStructIdx.length {
        if fRetKind[efe] == "struct" || fRetKind[efe] == "nulstruct" {
          const err = anonLeafRetRowOf(
            anonLeafFeDeclNode(efe),
            fRetStructIdx[efe],
          )
          if err != fRetStructIdx[efe] { return err }
        }
      }
    }
    // `xs.pop()` / `xs.get(i)` over a struct-element ref list yield that list's
    // element struct (as `S | null` — see `structListPopGetElem`).
    const slv = structListPopGetElem(exprIx, fnIx)
    if slv >= 0 { return slv }
    // Fallback, scoped to a call: a struct-returning closure value call whose callee the
    // cases above miss — an indexed closure-array element or a value inferred from a factory
    // call. Resolves the struct from the checker's per-node type, gated on the cheap
    // `nodeTyIsObj`. Off the hot path — struct receivers resolve syntactically above.
    if nodeTyIsObj(exprIx) {
      // The Index arm's ordering, exactly: exact spelling, then the arena row, then the
      // lenient field-set scan — `structIndexByName` runs ahead of the arena rung on purpose,
      // since an inline shape interned under its render can differ from the arena's smallest
      // row sharing the canon key; arena-first would silently flip a struct `==` into false.
      const snc = nodeTyCanonObjName(exprIx)
      if snc != "" {
        const sbn = structIndexByName(snc)
        if sbn >= 0 { return sbn }
      }
      const cr = repRowOfTyStruct(nodeRepTyIxOf(exprIx), sScanLim())
      if cr >= 0 { return cr }
      // The field-set rung on the canon render is gone: `structRowOfObjFieldSet` below already
      // asks the same question of the type. `canonTyIxOf` can be -1 at this node while
      // `nodeTyIxOf`/`nodeRepTyIxOf` hold it; `snc` stays since `structIndexByName(snc)` is a
      // lookup of a declared name — nominal identity the arena cannot recover.
      const fsx = structRowOfObjFieldSet(nodeTyIxOf(exprIx))
      if fsx >= 0 { return fsx }
      // The render-based rung here is gone: the question it asked — the type's spelling's
      // field set against the table — is what the rung above now asks of the type directly.
      // Its `-1` return is load-bearing, short-circuiting the nullable-struct rung below, so
      // the fallback stays and only the render lookup is retired (`anonTySpellable`).
      if anonTySpellable(nodeTyIxOf(exprIx)) { return -1 }
    }
    // The nullable-struct dual: a `S | null`-returning closure value call resolves to its
    // inner struct's layout index, so the kind-9 binding's `!= null` narrow finds `P`. Arena
    // first, peeling `TyNullable`. Wider than the name rung it fronts: `tyToEmitName` returns
    // "" on a cycle while `repCanonId` does not, so a recursive inner answers a row here where the name rung declines.
    const nnTy = nodeRepTyIxOf(exprIx)
    if nnTy >= 0 {
      const nnT = T.tys[nnTy]
      if nnT is TyNullable {
        const nr = repRowOfTyStruct(nnT.nInner, sScanLim())
        if nr >= 0 { return nr }
      }
    }
    const nn = nodeNulStructInnerName(exprIx)
    if nn != "" { return structIndexOfTypeName(nn) }
    return -1
  }
  if e is Ident {
    const pi = paramStructIndex(fnIx, e.identName)
    if pi >= 0 { return pi }
    const di = declaredStructIndex(e.identName)
    if di >= 0 { return di }
    const gi = globalStructIndexSid(fnIx, sidOfNode(exprIx))
    if gi >= 0 { return gi }
    return capturedStructIndex(fnIx, e.identName)
  }
  // `xs[i]` over a struct-element ref list yields that list's element struct. The
  // element struct table index comes from the receiver's per-element-type slot's name
  // (`Tok[]` → `Tok` → its struct index), so distinct struct ref-lists resolve to
  // distinct struct types — not always heap-type 0.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      let nm = refListElemNameOfExpr(e.idxArr, fnIx)
      // A nullable-struct element (`(P | null)[]`, slot key "P | null") resolves to the bare
      // struct `P` — strip the `| null` so a narrowed `xs[i].field` finds P's layout. The
      // structural bridge (`structIndexOfTypeName`) then also resolves an inline-shape
      // element (`{v:i32}[]` param) to its declared twin's layout.
      nm = nonNulBaseOf(nm)
      // Nominal exact-name match first — AFTER-not-FIRST relative to the arena rung (#1061).
      const sbn = structIndexByName(nm)
      if sbn >= 0 { return sbn }
      // Node route: the element receiver `v[i]` carries its adopted checked type, so resolve
      // its row through the canonical-key vocabulary directly (`repRowOfTyStruct`), the
      // read-side dual of `structIdxOfElemName`. Distinguishes a same-fieldset nested twin by
      // the full nested field type. Falls to the lenient fieldset scan when uncovered.
      const rr = repRowOfTyStruct(nodeRepTyIxOf(exprIx), sScanLim())
      if rr >= 0 { return rr }
      // The arena already said "not an object", so the field-set matcher is not asked:
      // `structIndexOfTypeName` parses a field set that a non-`TyObj` recorded type does not
      // have, so skipping it is answer-preserving. The guard is on "the arena recorded a
      // non-object", not on "the arena declined" — `repRowOfTyStruct` also returns -1 for other reasons, where the name path still answers.
      let sieObj = false
      let sieKnown = false
      const sieTy = nodeRepTyIxOf(exprIx)
      if sieTy >= 0 {
        sieKnown = true
        const sieT = T.tys[sieTy]
        if sieT is TyObj { sieObj = true }
      }
      if !sieKnown || sieObj {
        const si = structIndexOfTypeName(nm)
        if si >= 0 { return si }
      }
    }
    // A BARE `m[k]` over a STRUCT-valued map resolves to the value type's struct index, so a
    // narrowed `(m[k]).field` finds the layout — the Index dual of the `?? default` BinExpr case.
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 {
      // An ARM value has no `sNames` row; its layout is `exprVariantIndex`'s (D34).
      if mvValVariantOf(mrs) >= 0 { return -1 }
      if mvValKind[mrs] == 1 { return mvValStructIdxOf(mrs) }
    }
  }
  // The `?.` producer (D1084): `o?.f` over `o: T | null` with `T = {f: S}` banks `S | null`,
  // so an `==` against another `S | null` resolves both operands through this function. Every
  // other producer of `S | null` already answered; only `?.` fell to the -1 tail — a missing
  // arm. The body is the `Member` arm's struct leg verbatim.
  if e is OptMember {
    const osi = structIndexOfExpr(e.omObj, fnIx)
    if osi >= 0 {
      const ofi = sFieldIndex(osi, e.omProp)
      if ofi >= 0 {
        if sFieldTypeAt(osi, ofi) == 15 { return sFieldTgtStructIdx(osi, ofi) }
      }
    }
    return -1
  }
  if e is Member {
    const msi = structIndexOfExpr(e.memObj, fnIx)
    if msi >= 0 {
      const mfi = sFieldIndex(msi, e.memProp)
      if mfi >= 0 {
        if sFieldTypeAt(msi, mfi) == 15 { return sFieldTgtStructIdx(msi, mfi) }
      }
      return -1
    }
    // A narrowed union member and a variant-typed receiver resolve through the variant
    // field tables — the code-15 twin of `mapShapeOfExpr`'s Member dispatch. Checked after
    // the struct probe, and only on its receiver miss, so a plain receiver never pays the
    // narrow-key/variant resolution (`memIsNarrowed` builds a path-key string — hot).
    if memIsNarrowed(exprIx) {
      const nvi = memNarrowVariantIndex(exprIx)
      if nvi >= 0 {
        const nvfi = variantFieldIndex(nvi, e.memProp)
        if nvfi >= 0 {
          if variantFieldTypeAt(nvi, nvfi) == 15 {
            return uFieldTgtStructIdx(nvi, nvfi)
          }
        }
      }
    }
    // D1114 — the niche twin of the `pvi` rung below: an arm has no `sNames` row, so the
    // struct probe above misses, and `variantStructHeapTwinAt` declines code 15 by design. A
    // nested read needs the field's target row, which `uFieldTgtStructIdx` holds. Kind-gated
    // exactly as `nulVariantIdxOfExpr`'s header requires.
    const nvi2 = nulVariantIdxOfExpr(e.memObj, fnIx)
    if nvi2 >= 0 && exprNullableVariant(e.memObj, fnIx) {
      const nvfi2 = variantFieldIndex(nvi2, e.memProp)
      if nvfi2 >= 0 {
        if variantFieldTypeAt(nvi2, nvfi2) == 15 {
          return uFieldTgtStructIdx(nvi2, nvfi2)
        }
      }
    }
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 {
        if variantFieldTypeAt(pvi, pvfi) == 15 {
          // Deliberately not migrated: the arena twin of this lookup is
          // `uFieldTgtStructIdx`, used at every other code-15 variant-field site, but this
          // arm (a declared variant name that is not struct-resolvable) looks unreachable on
          // today's surface. Unverifiable, so it keeps the name path until a shape reaches it.
          return structIndexByName(variantFieldElemName(pvi, pvfi))
        }
      }
    }
  }
  -1
}

// The struct table index a struct-typed `LetDecl` binds: from its annotation if
// present, else inferred from its initializer. -1 if not a struct local.
export function structIndexOfLet(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    // A value-union annotation pins the cell to the box, which has no struct-table layout,
    // so the answer is -1 and the initializer must not be consulted. Falling through would
    // resolve the arm's object literal by field-name set and hand back whichever row shares
    // those names, short-circuiting the narrowed-variant resolution the read actually needs.
    if letAnnIsUnion(letIx) { return -1 }
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // The arena rung: this is the emitter's hottest name query and it holds a node, so it
        // can ask by type. `structIndexByName` finds the row interned under this spelling,
        // while `structIndexOfTy` finds the first row denoting this type, possibly a
        // structurally identical twin. Revert this rung if a pair ever surfaces with `repStructSlotsTwin == 0`.
        let si = structIndexOfTy(nodeTyIxOf(d.letType))
        if si < 0 { si = structIndexByName(lt.tyName) }
        if si >= 0 { return si }
        // A nullable annotation resolves its non-null part: `collectAnnShapes` interns an
        // inline shape under the bare text (the `|null` wrapper stripped), and a named alias
        // interns under its own name. Needed when the initializer is a bare `null`, with no
        // struct literal to infer the index from.
        const nb = nullablePartOf(lt.tyName)
        if nb != "" {
          const si2 = structIndexByName(nb)
          if si2 >= 0 { return si2 }
        }
      }
    }
    return structIndexOfExpr(d.letInit, fnIx)
  }
  -1
}

// ── union-typedness of expressions (G1) ──
// Parallel to the struct family: decide whether an expression, param, local, or let is the
// declared union (a boxed value). An object literal's intrinsic type is its variant struct,
// not the union — boxing happens at a flow boundary, so a bare object literal is not this.

// True if function `name` declares the union as its return type.
function fnRetUnionSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "union"
}

// True if the parameter `name` of function `fnIx` is the union type.
function paramUnion(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  // STRUCTURAL fast-path (C1): a recorded declared value-union param, else the name test.
  if nodeTyIsUnionAlias(pt) { return true }
  false
}

// True if the already-collected declared local `name` is a union ref (code `4`).
function declaredUnion(name: string) { declaredKind(name) == "union" }

// True if evaluating the expression at `exprIx` yields the union box: a union-returning
// call, a union param/local reference, or a parenthesized union expression. A bare object
// literal is not a union here.
export function exprUnion(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprUnion(e.parInner, fnIx) }
  // A standalone `?.` whose leaf is a scalar yields `<scalar> | null`, which has no spare
  // value to niche into and so reps as the value-union box, exactly what
  // `emitOptMemberValue` builds. Without this arm, boxing happened twice — `struct.new
  // $vbI32` applied to a `(ref $uBox)` — invalid wasm. The niche nullables a `?.` can also produce are structurally excluded.
  if e is OptMember {
    if nodeTyIsNulScalarBox(exprIx) { return true }
    // A value-union leaf (code 16) is already the box, and the chain only adds `null` to
    // its member set, so the whole `?.` is a box value too (D803): without this arm the
    // chain classified as a scalar while `emitOptMemberValue` built the box.
    return optChainLeafFieldCode(exprIx, fnIx) == 16
  }
  // `x as Shape` over a wider union yields the BOX at a narrower type — the sub-union cast
  // does not unbox, so its result is a union value like any other. Answered from the cast's
  // own recorded type: a SINGLE-arm target is not a union and correctly answers false here,
  // which is what keeps `const c = mk(a) as Circle` a variant binding rather than a box one.
  if e is AsExpr {
    // D1041 — a numeric `as?` that can fail yields `T | null`, and for the four numeric
    // atoms that is the value-union box, exactly as the union arm's `as? i32` is. Every box
    // consumer keys on this predicate, so without it the box lands in a scalar slot —
    // `vl check` rc 0, invalid wasm.
    if asExprNumFallible(exprIx) {
      if e.asMode == "null" { return true }
      // `as!` and a bare `as` yield `T` itself — a plain scalar, never a box.
      return false
    }
    if asExprIsUnionCastIn(exprIx, fnIx) {
      const cty = nodeTyIxOf(exprIx)
      if cty >= 0 {
        const ct = T.tys[cty]
        if ct is TyUnion { return true }
        // `x as? T` records `T | null`, and for a sub-union or a numeric arm that is still a
        // box — a non-null box carrying `nullBoxTag()` for the absent case. Reading only the
        // bare `TyUnion` left the coalescing forms classified as "not a union" and emitted an
        // untyped `null`. `nodeTyIsUnionAlias`'s third arm already asks exactly this question.
        if nodeTyIsUnionAlias(exprIx) { return true }
      }
    }
    return false
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetUnionSid(sidOfNode(e.callFn)) { return true }
      // A union-returning function VALUE (a binding / `(…) => A | B` param callee) — its
      // result is the union box, `>u`.
      if calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "union" { return true }
      // A miss here is not authoritative: a closure rebound from a composed carrier with no
      // annotation has no sig the syntactic resolution sees, yet its call_ref yields the
      // union box — fall through to the checker-typed `nodeTyIsUnion` fallback below, so the
      // binding classifies as the box instead of a raw i32 slot.
    }
    // A union-returning FIELD-closure call.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return fRetKind[ffe] == "union" }
    }
    // A union-returning INDEXED closure-element call (`xs[i](1)` over a
    // `((i32) => A | B)[]`): the element signature's result token is the box (`>u`).
    // The checker net below can miss it (a union WITH null records nullable-shaped),
    // so the sig-derived kind is consulted like the other `cloArrCallRetKind` arms.
    if cloArrCallRetKind(exprIx, fnIx) == "union" { return true }
    // A PURE-litunion result (`pick(ks)` → `K`) reps as the i32 atom / string ref,
    // never the box — the checker-typed net must not claim it as a union value.
    if nodeTyIsPureLitUnion(exprIx) { return false }
    // A nullable NUMERIC-scalar result (`f32 | null` from a chained value call
    // `v(1)()`) is the value-union box (`repOfNullable`'s scalar arm) — the checker-typed
    // net's TyNullable case. The niche nullables (string/boolean/litunion/struct/closure/
    // list `| null`) are structurally excluded by the classifier.
    if nodeTyIsNulScalarBox(exprIx) { return true }
    return nodeTyIsUnion(exprIx)
  }
  if e is Ident {
    // A value-union ident narrowed to one scalar atom (`if u is i32 { … u … }`) reads
    // unboxed in this scope: the host's narrowing types it as the member, not the union.
    // A sub-union narrowing (2+ atoms) keeps the box.
    if narrowedValueAtomOf(e.identName) != "" { return false }
    // A union binding narrowed to a ref-element array arm reads unboxed to the reflist
    // wrapper: in this scope it is a list, not a union value — the ref-array twin of the
    // scalar-atom rule above. Without it a rebind under the narrow classified as a union
    // box while the init emitted the unboxed wrapper ref — invalid wasm.
    if narrowedRefArrayOf(e.identName) != "" { return false }
    // D1029 — and the map arm, the third member of the same rule: a map binding narrowed
    // this way reads unboxed to the map struct, but `exprUnion` keeps answering true for it,
    // so `emitUnionCoerce` hands the unboxed map to a destination typed at the union —
    // invalid wasm at six delivery positions.
    if narrowedMapOf(e.identName) != "" { return false }
    if paramUnion(fnIx, e.identName) { return true }
    if declaredUnion(e.identName) { return true }
    // A CAPTURED union box (`const a: C | D = …; () => … a is C …`): the env field is the union
    // box (kind 4). `capturedUnionName` resolves its member set from the parent binding so `is`
    // narrows; here we only need to know it IS a union value.
    if capturedKindOf(fnIx, e.identName) == "union" { return true }
    // A module GLOBAL union binding (a union annotation, or a union-returning
    // init): top-level `const a = make(42)` / `let w: string | i32 = "a"`.
    const gi = globalLetOfIn(fnIx, e.identName)
    if gi >= 0 { return letIsUnion(gi, -1) }
    return false
  }
  // `ns[i]` over a UNION-element ref list yields the union box (G7-ref) — so the value
  // is usable with `is`-narrowing (a `let n0 = ns[i]` is a union local). Per-slot: the
  // element kind comes from the receiver's distinct ref-list slot (2 = union box).
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      // GUARD the slot (same discipline as the struct-element arm — a narrowed
      // union-arm rebind receiver resolves no slot; OOB otherwise).
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot < 0 || slot >= rlElemKindTbl.length { return false }
      // A cell narrowed to one scalar atom unboxes at the read (D451), exactly as the
      // Member arm below declines a narrowed field read — the union box is not the value in
      // this scope. A sub-union narrowing (kind 6 = `null`, or no atom kind at all) keeps the box.
      const iAtom = narrowVariantFor(indexPathKeyOf(exprIx))
      const iak = valueAtomKind(iAtom)
      if iak >= 0 && iak != 6 { return false }
      // The container arms of the same narrowing (D1014): the Ident arm declines a narrowed
      // ref-array or map for the same reason the atom rule above exists, since the read
      // unboxes. Without them an un-annotated rebind under the narrow took the union-box
      // cell while the init emitted the unboxed wrapper — invalid wasm.
      if narrowedRefArrayOfPlace(exprIx) != "" { return false }
      if narrowedMapOfPlace(exprIx) != "" { return false }
      return rlElemKindTbl[slot] == 2
    }
    // A bare `m[k]` over a union-valued map yields the value union box — unless the cell is
    // narrowed to one scalar atom, which the read unboxes (D1025), exactly as the ref-list
    // arm above declines its narrowed cell. The two index receivers must answer alike, or the
    // binding claims a box the read does not deliver.
    const mri = mapReadMvSlot(exprIx, fnIx)
    if mri >= 0 {
      if mapReadNarrowedAtomKind(exprIx, fnIx) >= 0 { return false }
      return mvValKind[mri] == 2
    }
  }
  // `m[k] ?? d` over a UNION-valued map yields the value union box — EXCEPT a `scalar | null`
  // value, which `??` peels to the raw unboxed scalar (classified by `exprIsI64`/`exprIsF64`/… ).
  if e is BinExpr {
    const cmu = coalesceMvSlot(exprIx, fnIx)
    if cmu >= 0 { return mvValKind[cmu] == 2 && !mvUnionIsScalarNull(cmu) }
    // A non-map `p ?? q` over a nullable value-union box keeps the box when the default is
    // itself nullable, since the result is still `T | null`, with no unboxed rep. Without it
    // an un-annotated binding inferred the residual scalar cell and its `!= null` found no
    // nullable rep to test. Delegated to the name-typed mirror so the two cannot disagree.
    if e.binOp == "??" {
      if unionNameOfExpr(exprIx, fnIx) != "" { return true }
    }
    // D1589 — an assignment's value is its target cell, the rule `fnAssignRetKind` already
    // states for the functype. Delegated to the target rather than re-derived, since the
    // value this node leaves on the stack is `emitExpr` of that target. Without it a tail
    // assignment over a nullable box cell struct.new'd the box as a scalar payload — invalid wasm.
    if e.binOp == "=" { return exprUnion(e.binLeft, fnIx) }
  }
  // D969 — an if-expression is its then arm's union-ness. The `??` desugaring turns `x ?? d`
  // over a nullable value-union box into an if-expression, and with an un-annotated
  // destination the binding took a scalar cell and the box went into it — invalid wasm. The
  // arms share the checker's join type, so the then arm classifies the whole if-expression.
  if e is IfStmt {
    const iuTv = ifThenValueIx(exprIx)
    if iuTv >= 0 { return exprUnion(iuTv, fnIx) }
    return false
  }
  // A plain read of a value-union struct field (code 16) yields the field's union box, a
  // value usable wherever a union is expected. A read narrowed to one scalar atom unboxes
  // (mirrors the code-16 read path in emitMem), so the union box is not the value here — same
  // as the narrowed Ident case above; a sub-union narrowing keeps the box.
  if e is Member {
    if memberUnionFieldNameRead(exprIx, fnIx) == "" { return false }
    const mAtom = narrowVariantFor(memberPathKeyOf(exprIx))
    const mk = valueAtomKind(mAtom)
    if mk >= 0 && mk != 6 { return false }
    // The container arms of the same narrowing (D1014), as the Index arm above.
    if narrowedRefArrayOfPlace(exprIx) != "" { return false }
    if narrowedMapOfPlace(exprIx) != "" { return false }
    // D209 — the other end of the read: an un-narrowed read the read site unboxes is not a
    // union value here either, asked with the same predicate that site uses, so the consumer
    // boxes exactly what the read delivered.
    if memReadUnboxAtomKind(exprIx, fnIx) >= 0 { return false }
    return true
  }
  false
}

// True if the `LetDecl` at `letIx` declares a union-typed local: its annotation names
// the union, or its initializer produces the union. An object-literal init under a union
// annotation is boxed as the union (`emitStmt`).
export function letIsUnion(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    // The annotation half (`letAnnIsUnion`) — a literal union (`type K = "a" | "b"`, or an
    // inline `"a" | "b"`) is an interned-i32 ATOM, not a value-union box, and it declines.
    if letAnnIsUnion(letIx) { return true }
    // The init's union-ness applies only when no annotation pinned the cell: an explicit
    // non-union annotation unboxes the narrowed atom into the concrete type instead of boxing.
    if d.letType < 0 {
      if exprUnion(d.letInit, fnIx) && !exprIsLitAtom(d.letInit, fnIx) {
        return true
      }
    }
    // A null-hole binding (`let x = null`, A-infer-null) is its inferred union.
    return nliNameOf(letIx) != ""
  }
  false
}

// ── value-union name resolution (the union a value flows as) ──────────────────

// The registered union name a binding `name` carries in function `fnIx` — from its param
// annotation, `let` annotation, an inferred union-returning init, or a module global — or
// "" when not union-typed. The name string is the atom set itself (`"boolean|i32"`).
export function unionNameOfIdent(name: string, fnIx: i32) {
  unionNameOfIdentSid(sidOf(name), fnIx)
}

// The sid-taking primitive behind `unionNameOfIdent`, checked in the same order: param
// annotation, enclosing `let`, captured frame, global, then start-block. `sidText` only
// recovers a faithful spelling for an id minted with `sidOf` — never one from `sidLookup`.
export function unionNameOfIdentSid(sid: i32, fnIx: i32) {
  const name = sidText(sid)
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      // Reads `body` before the `Param` narrowing below can rebind it.
      const body = fn.fnBody
      const params = fn.fnParams
      let i = 0
      while i < params.length {
        const p = P.nodes[params[i]]
        if p is Param {
          // `sidOfNode(params[i])` is `sidOf(p.parName)`, so this scan compares interned ids
          // rather than strings.
          if sidOfNode(params[i]) == sid {
            // The registry-membership test via the canon-keyed index instead of `isUName`'s
            // linear scan over `unNames`: same question, same name returned, on interned ids.
            const pn = tyNameOf(p.parType)
            if unRowOfCanon(annRowOfNode(p.parType)) >= 0 { return pn }
            return ""
          }
        }
        i = i + 1
      }
      const li = parentLetOfSid(body, sid)
      if li >= 0 { return letUnionNameOf(li, fnIx) }
      // A `for <name> in <(C|S)[]>` loop variable is a kind-4 union box with no `LetDecl` of
      // its own, so its member set comes from the iterable's union-box element type instead.
      const flv = forInLoopVarUnionName(name, fnIx)
      if flv != "" { return flv }
    }
  }
  // A top-level `for` loop runs in the start function, which has no `FuncDecl` body, so its
  // union-box loop var needs this same `forInLoopVarUnionName` rung to avoid an unboxed read.
  if fnIx < 0 {
    const slv = forInLoopVarUnionName(name, -1)
    if slv != "" { return slv }
  }
  // A captured union box resolves its member set from the parent frame's binding.
  const cun = capturedUnionName(fnIx, name)
  if cun != "" { return cun }
  const gi = globalLetOfSidIn(fnIx, sid)
  if gi >= 0 { return letUnionNameOf(gi, -1) }
  const bl = startBlockLetOfSid(sid, fnIx)
  if bl >= 0 { return letUnionNameOf(bl, -1) }
  ""
}

// A per-program memo for `startBlockLetRowOfSid` (R6): `sid` → the `LetDecl` it resolved to,
// or -1. `sblGen[sid] == sblEpoch` marks a row live; `resetLitAtoms` bumps the epoch alongside
// `startStmts`, so a row cannot outlive the arena it names. Exists because the scan below hands
// `parentLetOf`'s one-entry block cache a different block every step, thrashing it unmemoized.
let sblVal: i32[] = []
let sblGen: i32[] = []
let sblEpoch: i32 = 0

// The `LetDecl` for a module-scope binding declared inside a top-level block
// (`if true { const r = g() }`), or -1 — a start-function local that neither `globalLetOf`
// (wasm globals) nor `parentLetOf` (function scope) can see. An empty `startStmts` means
// `collectFns` has not run yet and is a correct, fail-safe decline, not just a cheap one.
function startBlockLetRowOfSid(sid: i32) {
  if startStmts.length < 1 { return -1 }
  if sid < 0 { return -1 }
  if sidArrGet(sblGen, sid) == sblEpoch { return sidArrGet(sblVal, sid) }
  let si = 0
  let found = -1
  while si < startStmts.length && found < 0 {
    const li = parentLetOfSid(startStmts[si], sid)
    if li >= 0 { found = li }
    si = si + 1
  }
  sidArrPut(sblGen, sid, sblEpoch)
  sidArrPut(sblVal, sid, found)
  found
}

// The start-block `LetDecl` a read of `sid` denotes, or -1 — the one home both union rungs
// consult. The live lexical slot (`scopeSlotOf` → `localDeclIx`) outranks a name-based scan
// across sibling blocks, since two same-named `const`s in different blocks would otherwise
// collide; only reached at module scope, since a function-scope caller's own scan runs first. D1593.
function startBlockLetOfSid(sid: i32, fnIx: i32) {
  if fnIx < 0 {
    const slot = scopeSlotOf(sidText(sid))
    if slot >= 0 && slot < localDeclIx.length { return localDeclIx[slot] }
  }
  startBlockLetRowOfSid(sid)
}

// The one home for "which value union does a `for <name> in <iter>` loop variable flow
// as", from the iterable's union-box element type (there is no declaration node to read).
// Keyed by the live slot, never the name — two `for` loops in one frame can share a loop-var
// name while binding different unions, and a name-based scan would hand one the other's type.
function forInLoopVarUnionName(name: string, fnIx: i32) {
  if declaredKind(name) != "union" { return "" }
  const slot = declaredSlotOf(name)
  if slot < 0 || slot >= localLoopIter.length { return "" }
  forInIterUnionElemName(localLoopIter[slot], fnIx)
}

// The union NAME an ITERABLE's element carries, or "". A union-box ref array (`(C | S)[]`,
// and the vals list of a box-VALUED map, which `exprRefArray` claims too) answers its
// element's registered member set; every other iterable answers "".
function forInIterUnionElemName(iterIx: i32, fnIx: i32) {
  if iterIx < 0 { return "" }
  if !exprRefArray(iterIx, fnIx) { return "" }
  const slot = refListSlotOfExpr(iterIx, fnIx)
  if slot < 0 || slot >= rlElemKindTbl.length { return "" }
  if rlElemKindTbl[slot] != 2 { return "" }
  rlElemName[slot]
}

// The declaration's arena type for a union-typed ident — `unionNameOfIdentSid`'s type-taking
// twin, arm for arm over its two annotation arms (D1491). Answers from the annotation's type,
// not the expression's, since a narrowed read's own type differs from what names its member
// set; the inferred/captured/loop-var arms answer -1, an honest "no id here".
function letUnionDeclTyIxOf(letIx: i32): i32 {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return annRowOfNode(d.letType) }
  }
  -1
}

function unionDeclTyIxOfIdentSid(sid: i32, fnIx: i32): i32 {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const body = fn.fnBody
      const params = fn.fnParams
      let i = 0
      while i < params.length {
        const p = P.nodes[params[i]]
        if p is Param {
          if sidOfNode(params[i]) == sid { return annRowOfNode(p.parType) }
        }
        i = i + 1
      }
      const li = parentLetOfSid(body, sid)
      if li >= 0 { return letUnionDeclTyIxOf(li) }
    }
  }
  const gi = globalLetOfSid(sid)
  if gi >= 0 { return letUnionDeclTyIxOf(gi) }
  const bl = startBlockLetOfSid(sid, fnIx)
  if bl >= 0 { return letUnionDeclTyIxOf(bl) }
  -1
}

// The same question of an expression: the declaration's type where the ident has one, else
// the node's own — mirroring `letUnionNameOf`'s annotation-first, expression-second order.
// The fallback is load-bearing: without it, an ident resolvable through its declaration
// loses that answer and reports no type instead.
function unionDeclTyIxOfExpr(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident {
    const di = unionDeclTyIxOfIdentSid(sidOfNode(unwrapParen(exprIx)), fnIx)
    if di >= 0 { return di }
  }
  nodeTyIxOf(unwrapParen(exprIx))
}

// The union name of a `LetDecl`: its annotation when that names a union, else the
// union its (un-annotated) initializer produces (`const r = pick(true)`).
export function letUnionNameOf(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    // Membership decided via `unRowOfCanon` (canon-keyed), the name still rendered via
    // `tyNameOf` — the same split `unionNameOfIdentSid`'s param arm uses.
    const an = tyNameOf(d.letType)
    if unRowOfCanon(annRowOfNode(d.letType)) >= 0 { return an }
    if d.letType < 0 {
      const inf = unionNameOfExpr(d.letInit, fnIx)
      if inf != "" { return inf }
      // A null-hole binding (`let x = null` filled by a later `x = e`) carries
      // its inferred `T|null` value union (A-infer-null).
      return nliNameOf(letIx)
    }
  }
  ""
}

// The UNION return of a function-type NAME (`(i32) => A | B` → "A | B", an alias `(i32) => Sh` → its
// member set via `isUName`), or "" when the name is not a function type returning a multi-member union.
function unionRetOfFnType(fnTyName: string) {
  // Mirrors `annRetNameOf`'s gate (#1144) and `emit_base.nameIsParenOpen`'s open-only test,
  // hoisted ahead of the scan as in the `forceCloResult*` twins.
  if nameIsParenOpen(fnTyName) {
    const ret0 = annRetNameOf(fnTyName)
    if ret0 == "" { return "" }
    const ret = normTypeAtom(ret0)
    if isUName(ret) { return ret }
    if isValueUnionName(ret) { return ret }
    // A value union with a litunion-alias arm (`K0 | i64`) is neither a registered union alias
    // nor `isValueUnionName`, yet still boxes as a value union via the alias arm's atom.
    if nameIsLitUnionArmValueUnion(ret) { return ret }
  }
  ""
}

// The union return-type NAME of a closure-typed PARAM `name` of function `fnIx` (`g: (i32) => A | B`
// → "A | B"), or "" when `name` is not a union-returning closure param. Lets a value call THROUGH a
// closure param (`g(x)` inside a HOF) classify its result union so a narrowed read unboxes.
function paramUnionRetName(fnIx: i32, name: string) {
  if fnIx < 0 { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            const ty = P.nodes[p.parType]
            if ty is TypeRef { return unionRetOfFnType(ty.tyName) }
          }
          return ""
        }
      }
      i = i + 1
    }
  }
  ""
}

// The registered union a node's own type is, when its render cannot name it: an inference
// (a desugared `??`, a hole-param call) renders its union arms structurally, so a name-keyed
// registry scan finds nothing. `unRowOfCanon` answers from the canon-keyed reverse index
// instead, naming the row every downstream member-set, narrow and variant lookup keys on. D1561.
function nodeRegisteredUnionName(ix: i32): string {
  const ty = nodeTyIxOf(unwrapParen(ix))
  if ty < 0 { return "" }
  const t = T.tys[ty]
  // Gated on `is TyUnion` so the `unRowOfCanon` scan — one pass over every registered row —
  // is paid only for union-typed nodes, not every node this is asked of.
  if t is TyUnion {
    if t.uMembers.length < 2 { return "" }
    const u = unRowOfCanon(ty)
    if u >= 0 { return unNames[u] }
  }
  ""
}

// The union NAME the expression at `exprIx` produces (the name-typed mirror of the
// boolean `exprUnion`): a union-returning call's return annotation, a union-typed
// ident, a parenthesized union. "" when the expression is not union-valued.
export function unionNameOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return "" }
  const e = P.nodes[unwrapParen(exprIx)]
  // `x as? T`'s box (`i32 | null`, `Shape | null`) needs the union name so a narrow/unbox
  // consumer sees a box, not a raw ref — rendered the same way an equivalent annotation would be.
  if e is AsExpr {
    const acn = tyToEmitName(nodeTyIxOf(unwrapParen(exprIx)))
    if acn != "" {
      if isValueUnionName(acn) { return acn }
      if isUNameAB(3, acn, nodeTyIxOf(unwrapParen(exprIx))) { return acn }
    }
    return ""
  }
  // An if-expression names its union from its own recorded type, like the `AsExpr` arm: only
  // a desugared `??` (`nodeTyCarry`) puts a type on an `if` — a source-written one has none. D969.
  if e is IfStmt {
    const icn = tyToEmitName(nodeTyIxOf(unwrapParen(exprIx)))
    if icn != "" {
      if isValueUnionName(icn) { return icn }
      if isUNameAB(4, icn, nodeTyIxOf(unwrapParen(exprIx))) { return icn }
    }
    // A `??` over a declared struct union desugars to this `if`, whose recorded type renders
    // structurally, so `isValueUnionName`/`isUNameAB` above miss it — named off the type instead. D1561.
    return nodeRegisteredUnionName(exprIx)
  }
  // A `??`'s desugared call-operand form still needs a name here: it drives the default's
  // coercion and makes `exprUnion` true, so a consumer boxes the result exactly once. D960.
  if e is BinExpr {
    if e.binOp == "??" {
      const ccn = tyToEmitName(nodeTyIxOf(unwrapParen(exprIx)))
      if ccn != "" {
        if isValueUnionName(ccn) { return ccn }
      }
    }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const fn = P.nodes[fnStmts[t]]
        if fn is FuncDecl {
          const rn = tyNameOf(fn.fnRet)
          if unRowOfCanon(annRowOfNode(fn.fnRet)) >= 0 { return rn }
          // An un-annotated function whose returns join to a value union: without its inferred
          // name, a binding stays the raw box and a narrowed read mis-types (arrayref vs scalar).
          if fn.fnRet < 0 {
            const im = inferRetNameOf(callee.identName)
            // A value union or a registered struct union (`isUName`, from this same inferred
            // name in `collectU`) — either drives narrowing/unboxing as an annotation would.
            if isValueUnionName(im) { return im }
            if im != "" && isUNameAB(18, im, inferRetTyIxOf(callee.identName)) {
              return im
            }
          }
        }
      }
      // A union-returning function-value callee (`const f = g; const r = f(7)`): without
      // resolving through the lifted function, a closure-call union stays the raw box.
      const cfe = identClosureFe(callee.identName, fnIx)
      if cfe >= 0 {
        const cfn = P.nodes[fnStmts[cfe]]
        if cfn is FuncDecl {
          const crn = tyNameOf(cfn.fnRet)
          if unRowOfCanon(annRowOfNode(cfn.fnRet)) >= 0 { return crn }
          // A value-union annotated return (`i32 | string`, pinned by `synthRetAnnots`) needs this:
          // `isUName` covers struct unions only, so this narrowed result would not unbox otherwise. B290.
          if isValueUnionTyOr(annRowOfNode(cfn.fnRet)) == 1 { return crn }
          if cfn.fnRet < 0 {
            const cim = inferRetNameOf(cfn.fnName)
            if isValueUnionName(cim) { return cim }
            if cim != "" && isUNameAB(19, cim, inferRetTyIxOf(cfn.fnName)) {
              return cim
            }
          }
        }
      }
      // A union-returning closure param callee (`callIt(g: (i32) => A | B, x)`): resolve via
      // the param's function-type annotation, so the HOF body's narrowed result unboxes too.
      const pun = paramUnionRetName(fnIx, callee.identName)
      if pun != "" { return pun }
      // A closure binding with an inferred function type (`const g = mk()`): recover it from
      // `identFnTypeAnnName`, since `identClosureFe` can't see through the call result.
      const bun = unionRetOfFnType(identFnTypeAnnName(callee.identName, fnIx))
      if bun != "" { return bun }
      // A callee narrowed to a union's closure arm: the binding's own annotation channel
      // misses (the type lives on the arm), so resolve the return from the active narrow instead.
      const ncl = narrowedClosureOf(callee.identName)
      if ncl != "" {
        const nun = unionRetOfFnType(peelGroupParens(ncl))
        if nun != "" { return nun }
      }
    }
    // A union-returning field-closure callee (`o.run(7)` over a `(…) => A | B` field): resolve
    // via the lifted function `fieldClosureFeOfRecv` finds, mirroring the plain-binding case.
    if callee is Member {
      const mfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if mfe >= 0 {
        const mfn = P.nodes[fnStmts[mfe]]
        if mfn is FuncDecl {
          const mrn = tyNameOf(mfn.fnRet)
          if unRowOfCanon(annRowOfNode(mfn.fnRet)) >= 0 { return mrn }
          if mfn.fnRet < 0 {
            const mim = inferRetNameOf(mfn.fnName)
            if isValueUnionName(mim) { return mim }
            if mim != "" && isUNameAB(20, mim, inferRetTyIxOf(mfn.fnName)) {
              return mim
            }
          }
        }
      }
    }
    // Fallback scoped to a call (an if-expr has its own union path): renders from the checker's
    // per-node type when the callee has no static name to key on (`arr[i](x)`).
    const crun = nodeUnionName(exprIx)
    if crun != "" { return crun }
    // `nodeUnionName` gates itself to a value union first, so a call returning a declared
    // struct union (an inferred hole-param return with no annotation) named nothing here either. D1561.
    return nodeRegisteredUnionName(exprIx)
  }
  // The ident arm declines the same three narrows `exprUnion`'s ident arm does (scalar atom,
  // ref array, map): a rebind under a narrow must not still be named a union here. D1252.
  if e is Ident {
    if narrowedValueAtomOf(e.identName) != "" { return "" }
    if narrowedRefArrayOf(e.identName) != "" { return "" }
    if narrowedMapOf(e.identName) != "" { return "" }
    return unionNameOfIdent(e.identName, fnIx)
  }
  // A `?.` whose leaf is a value-union field (code 16): the checker's own type for the node
  // is exactly the union plus `null`, so it is rendered rather than assembled here. D803.
  if e is OptMember {
    if optChainLeafFieldCode(exprIx, fnIx) == 16 {
      return nodeUnionName(unwrapParen(exprIx))
    }
    return ""
  }
  // `m[k] ?? d` over a UNION-valued map yields the value union's box — resolve its name (the
  // mv slot's value name) so an un-annotated `const v = m[k] ?? d` narrows/unboxes.
  if e is BinExpr {
    const cmu = coalesceMvSlot(unwrapParen(exprIx), fnIx)
    if cmu >= 0 {
      // `scalar | null` peels to a raw scalar (not a union), so it has no union name here.
      if mvValKind[cmu] == 2 && !mvUnionIsScalarNull(cmu) {
        return mvValName[cmu]
      }
    }
    // The name-typed mirror of `exprUnion`'s non-map `??` arm: needs the resulting member set
    // to narrow/unbox through, only when both operands share the same set (or default is `null`).
    if e.binOp == "??" {
      const cln = unionNameOfExpr(e.binLeft, fnIx)
      if cln != "" && coalesceDefaultNullable(e.binRight, fnIx) {
        const crn = unionNameOfExpr(e.binRight, fnIx)
        if crn == "" || crn == cln { return cln }
      }
      // A `?.` LHS over a value-union LEAF stays a BOX past the `??` even with a NON-null
      // default: peeling `null` off `i32 | string | null` leaves TWO atoms, which have no
      // shared unboxed rep. The result set is the checker's type for the `??` NODE — the
      // union minus `null` — rendered rather than assembled, as the `?.` arm above. D803.
      const olh = P.nodes[unwrapParen(e.binLeft)]
      if olh is OptMember {
        if optChainLeafFieldCode(e.binLeft, fnIx) == 16 {
          return nodeUnionName(unwrapParen(exprIx))
        }
      }
    }
  }
  // `ns[i]` over a UNION-element ref list yields the element union's box (the
  // name-typed mirror of `exprUnion`'s Index case) — so an un-annotated
  // `const a = arr[0]` binding resolves its union name for narrowing/unboxing.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        if rlElemKindTbl[slot] == 2 {
          // The name-typed half of `exprUnion`'s D451 decline: a cell narrowed to one
          // scalar atom is unboxed by the read, so it carries no union name either. The two
          // must answer together — `exprUnion` false with a name still resolving is exactly
          // the split D311 records one classifier over.
          const iAtom = narrowVariantFor(indexPathKeyOf(exprIx))
          const iak = valueAtomKind(iAtom)
          if iak >= 0 && iak != 6 { return "" }
          return rlElemName[slot]
        }
      }
    }
    // A union binding's ref-array arm with a closure member: narrowing-blind, `exprRefArray(t0)`
    // is false, so recover the element union directly from the arm instead.
    const ax = P.nodes[unwrapParen(e.idxArr)]
    if ax is Ident {
      const aun = unionNameOfIdent(ax.identName, fnIx)
      if aun != "" {
        const cel = unionClosureArrElemUnion(aun)
        if cel != "" { return cel }
      }
    }
    // A bare `m[k]` over a UNION-valued map (the value union's box). The name-typed half of
    // `exprUnion`'s D1025 decline: a cell narrowed to one scalar atom is unboxed by the read,
    // so it carries no union name either — the two must answer together.
    const mri = mapReadMvSlot(unwrapParen(exprIx), fnIx)
    if mri >= 0 {
      if mvValKind[mri] == 2 {
        if mapReadNarrowedAtomKind(unwrapParen(exprIx), fnIx) >= 0 { return "" }
        return mvValName[mri]
      }
    }
  }
  // The name-typed mirror of `exprUnion`'s Member case: a code-16 field read carries
  // the field's union name (its atom set), unless narrowed to one scalar (unboxed).
  if e is Member {
    const mix = unwrapParen(exprIx)
    const mAtom = narrowVariantFor(memberPathKeyOf(mix))
    const mk = valueAtomKind(mAtom)
    if mk >= 0 && mk != 6 { return "" }
    // Must decline the same read `exprUnion`'s Member case does: a read the read site already
    // unboxes is a string ref, not a union box, whatever this field's declared type says. D311.
    if memReadUnboxAtomKind(mix, fnIx) >= 0 { return "" }
    return memberUnionFieldNameRead(mix, fnIx)
  }
  ""
}

// True when the live narrowing on `name` proves it not null (`emitIdentNode` reads at the
// arm's rep, but the `??` lowering and a `!= null` test still target the declared nullable
// rep unless this says otherwise). Decided on the arena type the narrow banked, never the
// rendered variant — a slot with no single banked type answers false, the safe default.
export function narrowExcludesNull(name: string): boolean {
  const i = narrowSlotOf(name)
  if i < 0 { return false }
  const v = narrowVariants[i]
  if v == "" { return false }
  if v == "null" { return false }
  const ty = narrowSlotTy(i)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return false }
  !tyIsNullPrim(ty)
}

// True when arena type `ty` IS the `null` type itself (as against a nullable of something).
// `narrowExcludesNull`'s second half: a `== null` / `is null` push banks the null type, and a
// narrowing TO null excludes nothing.
function tyIsNullPrim(ty: i32): boolean {
  // `unMemTys` records -1 for a member spelling that did not resolve to an arena type, and
  // `isUnionOfTy` reads that column directly — so the guard is load-bearing, not defensive.
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName == "null" }
  false
}

export function narrowedValueAtomOf(name: string) {
  const i = narrowSlotOf(name)
  if i < 0 { return "" }
  const v = narrowVariants[i]
  if v == "" { return "" }
  // The narrowed type decides reject (no value-atom or litunion arm, however costly its
  // spelling is to classify); only where it IS an atom does the spelling decide instead.
  const ty = narrowSlotTy(i)
  if ty >= 0 {
    const tk = unMemAtomKind(ty)
    if tk == 6 { return "" }
    if tk < 0 {
      // A numeric litunion arm (`if p is N` where `type N = 1 | 2`) unboxes as its base
      // scalar, asked of the arena since no rendered spelling carries a numeric literal's kind.
      const nb = numLitUnionBaseName(ty)
      if nb != "" { return nb }
      // A bare string-literal arm (`if r is "err"` over `i32 | "err"`) unboxes as the string
      // ref the box holds, exactly as a litunion-alias arm — `tyIsLitUnionOrLit` covers both. D1193.
      if !tyIsLitUnion(ty) {
        // `tyIsLitUnionOrLit` minus the already-excluded `tyIsLitUnion` case is exactly "a
        // bare string-literal type", so this needs no predicate of its own.
        if !tyIsLitUnionOrLit(ty) { return "" }
        return "string"
      }
    }
  }
  const k = valueAtomKind(v)
  if k >= 0 && k != 6 { return v }
  // A transparent alias (`type N = i32`) banks the alias spelling, which `valueAtomKind`
  // declines; fall back to the arena `TyPrim`'s canonical `primName` for the same atom.
  if k < 0 && ty >= 0 {
    const at = T.tys[ty]
    if at is TyPrim {
      const ak = valueAtomKind(at.primName)
      if ak >= 0 && ak != 6 { return at.primName }
    }
  }
  // A litunion-alias narrow (`x is K0` where `type K0 = "a" | "b"`) unboxes as the
  // STRING ref the box stores its litunion member as (`emitUnionCoerce` boxes it so).
  if k < 0 && nameIsLitUnionType(v) { return "string" }
  ""
}

// The ref-element-array arm a union binding `name` is currently narrowed to (`if x is S[]`
// → `S[]`), or "" when not narrowed to a ref array. A non-"" answer means an ident read
// recovers the reflist wrapper ref from the box (`ref.cast` of the anyref payload), so
// indexing and `.length` see the list directly.
export function narrowedRefArrayOf(name: string) {
  const i = narrowSlotOf(name)
  if i < 0 { return "" }
  const v = narrowVariants[i]
  if v == "" { return "" }
  const ty = narrowSlotTy(i)
  if ty >= 0 {
    if unMemAtomKind(ty) >= 0 { return "" }
    // `unMemIsRefElemArray` is a shape question and `nameIsRefArray` is that shape plus
    // nameability, so the arena leg can only reject; a shape match re-asks the name.
    if !unMemIsRefElemArray(ty) { return "" }
  }
  if valueAtomKind(v) >= 0 { return "" }
  if nameIsRefArray(v) { return v }
  ""
}

// The bare-closure arm a union binding `name` is currently narrowed to (`if x is () => i64`
// → `() => i64`), or "" otherwise. The narrowed read already unboxes via
// `narrowedValueAtomOf`; this isolates the closure case so `exprIsClosure` can route the
// call through `call_ref` with the arm's `$fnsig`.
export function narrowedClosureOf(name: string) {
  const v = narrowedValueAtomOf(name)
  if v != "" && valueAtomKind(v) == 11 { return v }
  ""
}

// The map arm a union binding `name` is currently narrowed to (`if x is {[string]: string}`
// → `{[string]: string}`), or "" otherwise. A non-"" answer means an ident read recovers the
// map struct ref from the box, so `x[k]`, `x[k] ?? d` and `x.has(k)` route through the map
// lowering directly.
export function narrowedMapOf(name: string) {
  const i = narrowSlotOf(name)
  if i < 0 { return "" }
  const v = narrowVariants[i]
  if v == "" { return "" }
  // A narrowed type that is not a `TyMap` cannot be the map arm, whatever it is spelled —
  // free rejection for the map-member union the name path still has to exclude.
  const ty = narrowSlotTy(i)
  if ty >= 0 {
    if !unMemIsMap(ty) { return "" }
  }
  if valueAtomKind(v) >= 0 { return "" }
  // A narrow can land on a member set, not a single arm — a name starting with `{[` can still
  // be a union box, not a bare map. Skipping this guard misclassifies a rebind as a mono map.
  if nameIsBareMap(v) { return v }
  ""
}

// The map value type the narrowing banks for `name`, or -1 — `narrowedMapOf`'s structural
// sibling, reading the same slot's type column (`pushNarrowRep` writes `narrowVariants[i]`
// and `narrowTys[i]` together) instead of re-deriving `V` from the rendered `{[K]: V}`
// spelling through the annotation grammar.
function narrowedMapValTyOf(name: string): i32 {
  const i = narrowSlotOf(name)
  if i < 0 { return -1 }
  tyMapValOf(narrowSlotTy(i))
}

// The ref-element-array arm a non-identifier place is currently narrowed to (`if n.v is K[]`
// → `K[]`), or "" — `narrowedRefArrayOf`'s place-keyed dual. A consumer asking about an
// identifier misses a place narrow entirely (`if n.v is K[] { for e in n.v … }` failed at
// whichever floor came first), so `narrowTop` gates first since the key is a built string. D1014.
export function narrowedRefArrayOfPlace(exprIx: i32): string {
  if narrowTop == 0 { return "" }
  const k = placeNarrowKeyOf(exprIx)
  if k == "" { return "" }
  narrowedRefArrayOf(k)
}

// The map arm a non-identifier place is currently narrowed to, or "" — see
// `narrowedRefArrayOfPlace`.
export function narrowedMapOfPlace(exprIx: i32): string {
  if narrowTop == 0 { return "" }
  const k = placeNarrowKeyOf(exprIx)
  if k == "" { return "" }
  narrowedMapOf(k)
}

// The map VALUE type banked beside `narrowedMapOfPlace`'s arm, or -1 — the place-keyed dual of
// `narrowedMapValTyOf`, read off the SAME narrow-stack row so the arm spelling and its value
// type cannot describe two different maps.
function narrowedMapValTyOfPlace(exprIx: i32): i32 {
  if narrowTop == 0 { return -1 }
  const k = placeNarrowKeyOf(exprIx)
  if k == "" { return -1 }
  narrowedMapValTyOf(k)
}

// The atom kind an ident expression currently reads as, for the scalar/string classifiers:
// `valueAtomKind`'s code when narrowed to one scalar atom (the read unboxes to it), -2 for
// a union binding not narrowed to a single atom (still the box ref, whatever its init spelled),
// or -3 when the expression is not a union-typed ident at all.
function unionIdentReadKind(exprIx: i32, fnIx: i32) {
  const e = P.nodes[exprIx]
  if e is Ident {
    if unionNameOfIdentSid(sidOfNode(exprIx), fnIx) != "" {
      const a = narrowedValueAtomOf(e.identName)
      if a != "" { return valueAtomKind(a) }
      // An un-annotated binding whose init is itself a narrowed ident inherits that one level
      // of narrowing only (deeper would inherit someone else's), else `exprString` sees a box. D1013.
      if fnIx < 0 {
        let mi = 0
        while mi < P.nodes.length {
          const mn = P.nodes[mi]
          if mn is LetDecl {
            if mn.letName == e.identName {
              if mn.letType < 0 {
                const min = P.nodes[mn.letInit]
                if min is Ident {
                  const ma = narrowedValueAtomOf(min.identName)
                  if ma != "" { return valueAtomKind(ma) }
                }
              }
            }
          }
          mi = mi + 1
        }
      }
      if fnIx >= 0 {
        const ufn = P.nodes[fnIx]
        if ufn is FuncDecl {
          const uli = parentLetOf(ufn.fnBody, e.identName)
          if uli >= 0 {
            const uld = P.nodes[uli]
            if uld is LetDecl {
              if uld.letType < 0 {
                const uin = P.nodes[uld.letInit]
                if uin is Ident {
                  const ua = narrowedValueAtomOf(uin.identName)
                  if ua != "" { return valueAtomKind(ua) }
                }
              }
            }
          }
        }
      }
      return -2
    }
  }
  -3
}

// The member-path dual of `unionIdentReadKind`: the atom kind a union-typed struct-field read
// (`o.y`, field code 16) currently reads as — the narrowed atom's kind when the member path is
// narrowed, -2 for an un-narrowed box read, -3 for a non-union-field member. An un-narrowed
// read is not always the box: where the read site itself unboxes, this must say so too. D311.
function memberUnionReadKind(exprIx: i32, fnIx: i32) {
  const e = P.nodes[exprIx]
  if e is Member {
    if memberUnionFieldNameRead(exprIx, fnIx) != "" {
      const a = narrowedValueAtomOf(memberPathKeyOf(exprIx))
      if a != "" { return valueAtomKind(a) }
      const d = memReadUnboxAtomKind(exprIx, fnIx)
      if d >= 0 { return d }
      return -2
    }
  }
  -3
}

// The index-place dual of `unionIdentReadKind` / `memberUnionReadKind`: the atom kind a
// union-box element read (`xs[0]`) currently reads as — the narrowed atom's kind when the
// index place is narrowed, -2 for an un-narrowed box read, -3 when this is not a union-element
// index. Wired only for `exprString`, the one classifier with no typed-IR fast path of its own.
function indexUnionReadKind(exprIx: i32, fnIx: i32) {
  const e = P.nodes[exprIx]
  if e is Index {
    if indexElemUnionName(exprIx, fnIx) != "" {
      const a = narrowedValueAtomOf(indexPathKeyOf(exprIx))
      if a != "" { return valueAtomKind(a) }
      return -2
    }
    // A union-valued map's bare read is the same box a union-element cell is (D1025), and a
    // narrowed cell unboxes at the read — the map receiver just one container over.
    const mrs = mapReadNarrowableSlot(exprIx, fnIx)
    if mrs >= 0 && mvValKind[mrs] == 2 {
      const mak = mapReadNarrowedAtomKind(exprIx, fnIx)
      if mak >= 0 { return mak }
      return -2
    }
  }
  -3
}

// The CURRENT narrowed atom set of the union binding `name`: its innermost active
// narrowing when one exists (which may already be a sub-union), else its declared
// union's full member set (the union name itself). "" when not a union binding.
export function currentNarrowSetOf(name: string, fnIx: i32) {
  const v = narrowVariantFor(name)
  if v != "" { return v }
  unionNameOfIdent(name, fnIx)
}

// The full pipe-joined member set of the union named `name`: a registered alias returns its
// `unMemberSet` entry (`type N = A | B` expands to `"A|B"`); an unregistered or already
// pipe-joined name passes through unchanged. Lets complement narrowing subtract variants
// from an alias-annotated binding's set.
export function unionMemberSetOf(name: string) {
  let u = 0
  while u < unNames.length {
    if unNames[u] == name { return unMemberSet[u] }
    u = u + 1
  }
  name
}

// Resolves `name` to its member-set spelling (an alias name to its declared set, else itself)
// and splits it into pipe-joined atoms into `out`, using the `msMemberAtomsOf` memo before
// falling back to `splitUnionAtoms`. The single home for that resolve-then-split pair, so
// every caller shares one splitting grammar and one memo.
export function unionArmsOf(name: string, out: string[]) {
  let nm = unionMemberSetOf(name)
  if nm == "" { nm = name }
  if !msMemberAtomsOf(nm, out) { splitUnionAtoms(nm, out) }
  nm
}

// Resolves `name`'s arm spellings via `unionArmsOf` into `atoms`, then fills `tys` with their
// arena types in the row's box-tag ABI order — true only when the row covers all of them 1:1.
// `atoms` and `tys` stay index-parallel either way; on `false`, `tys` is left untouched and
// the caller keeps its own spelling-based fallback.
function unionArmTys(name: string, atoms: string[], tys: i32[]): boolean {
  const nm = unionArmsOf(name, atoms)
  unionMemberTysOf(nm, tys) && tys.length == atoms.length
}

// `unionArmTys` for a caller that already holds a member set and must not have it resolved
// as an alias name — the union registration paths, which are handed `unMemberSet[u]` or an
// inline set directly. `unionArmsOf` would re-expand a registered alias name to its arms,
// changing which arms get interned and tag-matched, so this deliberately skips that resolve.
export function unionSetArmTys(
  set: string,
  atoms: string[],
  tys: i32[],
): boolean {
  // Both arrays come from one slice of one recorded row (`recordUnMemTys`'s columns), so their
  // lengths agree by construction on this fast path; a miss falls through to the split below.
  const u = unionRowOf(set)
  if u >= 0 && u < unMemTyStart.length {
    const st = unMemTyStart[u]
    const n = unMemTyCount[u]
    if st >= 0 && st + n <= unMemAtoms.length && st + n <= unMemTys.length {
      let allRes = true
      let i = 0
      while i < n {
        if unMemTys[st + i] < 0 { allRes = false }
        i = i + 1
      }
      if allRes {
        let j = 0
        while j < n {
          atoms.push(unMemAtoms[st + j])
          tys.push(unMemTys[st + j])
          j = j + 1
        }
        return true
      }
    }
  }
  splitUnionAtoms(set, atoms)
  unionMemberTysOf(set, tys) && tys.length == atoms.length
}

// The `unNames` ROW of the union `name` — matched on the alias NAME or on the
// pipe-joined member SET (a consumer that already resolved the alias hands us the
// set), or -1. Nominal identity lookup, not a structural decision.
export function unionRowOf(name: string): i32 {
  if name == "" { return -1 }
  let u = 0
  while u < unNames.length {
    if unNames[u] == name { return u }
    u = u + 1
  }
  let v = 0
  while v < unMemberSet.length {
    if unMemberSet[v] == name { return v }
    v = v + 1
  }
  -1
}

// ── the union registry asked by arena type id — an A/B shadow harness (docs/internals/registry-by-type-id.md)

// Off by default: `unABOn()` is 0 unless the host arms the shadow harness, and every AB
// function then returns exactly what its unshadowed twin does, so an unarmed compile is
// unaffected. Mode 2 prefers the id answer; mode 3 re-keys the tally on `unKey` instead of
// `repCanonId`, both armed from source only, since a compiler reading its own environment is a second input.
const unABMode: i32 = 0

// The emit-time tallies, per converted site — counters, not a shared reason-bucket, because
// `repShadowSweep` resets the bucket table before this sweep runs (a bump during emit would
// not survive to the report) and a pooled bucket can't say which site a disagreement belongs
// to: `unABCnt[site * UNAB_K + k]`, six outcomes per site.
let unABCnt: i32[] = []
const UNAB_K = 7
// 0 agree · 1 differ · 2 name-only · 3 id-only · 4 neither · 5 no-ty · 6 alias.
const UNAB_AGREE = 0
const UNAB_DIFFER = 1
const UNAB_NAMEONLY = 2
const UNAB_IDONLY = 3
const UNAB_NEITHER = 4
const UNAB_NOTY = 5
// Two rows keyed to the same member sequence but differing only in name (a declared alias
// beside its inline spelling, or two monomorphized instances) are not a disagreement — their
// tag slices are identical and either row answers. D1491.
const UNAB_ALIAS = 6
let unRetryHit: i32 = 0
let unRetryMiss: i32 = 0

function unABOn(): i32 {
  if unABMode > 0 { return unABMode }
  if repShadowOn { return 1 }
  0
}

// One reach recorded. Called only when armed, so the growth loop and the read-modify-write
// are off the unarmed path entirely.
function unABBump(site: i32, k: i32) {
  const at = site * UNAB_K + k
  while unABCnt.length <= at { unABCnt.push(0) }
  unABCnt[at] = unABCnt[at] + 1
  0
}

// Two rows the KEY cannot tell apart: both covered, and their minted `unKey` is the same id.
// Bounded on both sides — a row named by a key the column never grew is exactly the read that
// trapped at D1152.
function unRowKeySame(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return false }
  if a >= unKey.length || b >= unKey.length { return false }
  if unKey[a] < 0 { return false }
  unKey[a] == unKey[b]
}

// Classify one reach: `n` the row the SPELLING named, `d` the row the ARENA ID named, both
// -1 for "no row". `ty < 0` is its OWN bucket — "this site had no id to offer" and "the id
// disagreed" are different findings, and collapsing them is how a coverage gap reads as
// agreement.
function unABProbe(site: i32, n: i32, d: i32, ty: i32) {
  if ty < 0 { return unABBump(site, UNAB_NOTY) }
  if n >= 0 && d >= 0 {
    if n == d { return unABBump(site, UNAB_AGREE) }
    if unRowKeySame(n, d) { return unABBump(site, UNAB_ALIAS) }
    return unABBump(site, UNAB_DIFFER)
  }
  if n >= 0 { return unABBump(site, UNAB_NAMEONLY) }
  if d >= 0 { return unABBump(site, UNAB_IDONLY) }
  unABBump(site, UNAB_NEITHER)
}

// The WRITE side's probe. At a mint site no row exists yet, so the rows are both -1 and
// `unABProbe` would report "neither" for every reach. The question there is whether the id
// the caller OFFERS is the same type the name RESOLVES to, so the comparison is on the
// arena types, at `repCanonId` — the structural id duplicate arena indices share.
function unABTyProbe(site: i32, dTy: i32, oTy: i32) {
  if oTy < 0 { return unABBump(site, UNAB_NOTY) }
  if dTy < 0 { return unABBump(site, UNAB_IDONLY) }
  if repCanonId(dTy) == repCanonId(oTy) { return unABBump(site, UNAB_AGREE) }
  unABBump(site, UNAB_DIFFER)
}

// The converted sites, by name — an i32 constant at each call site, so an unarmed compile
// just pushes it and returns; the spelling is needed only by the report. Ids 1-10 are the
// sites the initial shim added (including id-free callers that already hold an arena id);
// 11+ came from later one-hop threading. `UNAB_N` bounds the report loop.
const UNAB_N = 47
function unABSiteName(s: i32): string {
  // 29-46 are step 4b(c): `registerInlineUnion`'s recursions, each keyed on the sub-spelling's
  // own canon key, plus `collectTyReachRegister`'s two ID-FREE callers, which hold a type.
  if s == 29 { return "riu/mapVal" }
  if s == 30 { return "riu/arrayAtom" }
  if s == 31 { return "riu/pun" }
  if s == 32 { return "riu/nulRefArray" }
  if s == 33 { return "riu/nulShape" }
  if s == 34 { return "riu/nulCloValue" }
  if s == 35 { return "riu/nulCloVariant" }
  if s == 36 { return "riu/nulCloRefArray" }
  if s == 37 { return "riu/nestedArray" }
  if s == 38 { return "riu/arrayShape" }
  if s == 39 { return "riu/fnResult" }
  if s == 40 { return "riu/refArrayArm" }
  if s == 41 { return "ctr/nullableName" }
  if s == 42 { return "ctr/unionName" }
  if s == 43 { return "riu/collapsedName" }
  if s == 44 { return "riu/inferRetNominal" }
  if s == 45 { return "riu/arrElemUnion" }
  if s == 46 { return "riu/api" }
  if s == 1 { return "regValueUnionTy" }
  if s == 2 { return "letAnnUnionKind" }
  if s == 3 { return "unionNameOfExpr/as" }
  if s == 4 { return "unionNameOfExpr/is" }
  if s == 5 { return "letAnnUnionRetSink" }
  if s == 6 { return "letAnnUnionSlot" }
  if s == 7 { return "internShapeDeep/valueUnion" }
  if s == 8 { return "internFuncTypeShapes/valueUnion" }
  if s == 9 { return "inferRetArenaUnionIsDup" }
  if s == 10 { return "internShapeDeep/armTys" }
  if s == 11 { return "exprIsUnionStrEq/l" }
  if s == 12 { return "exprIsUnionStrEq/r" }
  if s == 13 { return "memberUnionFieldName" }
  if s == 14 { return "writeRhsIsNullBearing" }
  if s == 15 { return "fnUnionRetSinkOk" }
  if s == 16 { return "arrLitUnionElemName" }
  if s == 17 { return "arrLitBoxElem" }
  if s == 18 { return "unionNameOfExpr/callee" }
  if s == 19 { return "unionNameOfExpr/closure" }
  if s == 20 { return "unionNameOfExpr/method" }
  if s == 21 { return "nliInferIfLet" }
  if s == 22 { return "nliInferOptChainLet" }
  if s == 23 { return "collectU/inferLetTy" }
  if s == 24 { return "collectU/arrLitInferElem" }
  if s == 25 { return "emitUnionUnionEq" }
  if s == 26 { return "emitReturnValue/inferRet" }
  if s == 27 { return "emitLetDeclStmt/union" }
  if s == 28 { return "emitLetDeclStmt/nli" }
  "site?"
}

// One bucket's name. Split out so the report loop reads as a table rather than as a
// six-armed ladder inside two nested loops.
function unABKindName(k: i32): string {
  if k == UNAB_AGREE { return "agree" }
  if k == UNAB_DIFFER { return "differ" }
  if k == UNAB_NAMEONLY { return "name-only" }
  if k == UNAB_IDONLY { return "id-only" }
  if k == UNAB_NEITHER { return "neither" }
  if k == UNAB_ALIAS { return "alias" }
  "no-ty"
}

// The id-keyed twin of `unionRowOf(name)`. `unRowOfCanon` is the reverse index this repo
// already built (`repCanonId` over the `unTyIx` sidecar B-1 step 1 populated); this name is
// its registry-facing spelling, so a converted call site reads as the twin of the call it
// replaces rather than as a new idea.
function unionRowOfTy(ty: i32): i32 { unRowOfCanon(ty) }

// The raw-arena-index twin, kept beside the canon one so all three candidate keys can be
// priced against each other on one run. The arena is not hash-consed for composite
// spellings, so one spelling mints several indices and this misses rows the canon key
// finds — that gap is the argument against keying on the raw index.
function unionRowOfTyRaw(ty: i32): i32 {
  if ty < 0 { return -1 }
  let u = 0
  while u < unTyIx.length {
    if unTyIx[u] == ty { return u }
    u = u + 1
  }
  -1
}

// The key-keyed twin — the third candidate, and the one the design argues for: the row whose
// minted `unKey` equals the key the arena route obtains for `ty`. Neither `unionRowOfTy` nor
// `unionRowOfTyRaw` is that equivalence (the raw index isn't an identity; `repCanonId` merges
// rows the box ABI needs kept apart). `docs/internals/registry-by-type-id.md` §5.
function unRowOfKey(ty: i32): i32 { unRowOfKeyId(canonUnionKeyOfTy(ty)) }

// The same reverse index from the key itself — the entry point for a producer with no arena
// node at all. `registerInlineUnion`'s recursions are cut substrings of a spelling, so the
// only identity they can offer is the key canon mints for the sub-spelling, obtained here
// rather than cut from the parent's. `docs/internals/registry-by-type-id.md` §5, step 4b.
function unRowOfKeyId(k: i32): i32 {
  if k < 0 { return -1 }
  let u = 0
  while u < unKey.length {
    if unKey[u] == k { return u }
    u = u + 1
  }
  -1
}

// The ID side's row under the harness MODE: 3 keys on `unKey`, anything else on
// `repCanonId`. Only the four A/B seams route through here, and only their TALLY moves —
// the shipped answer stays the name's at every mode but 2, so an armed compile at mode 3
// emits exactly what an unarmed one does.
function unRowOfTyAB(ty: i32): i32 {
  if unABMode == 3 { return unRowOfKey(ty) }
  unionRowOfTy(ty)
}

// `isUName`'s seam. The two predicates do NOT scan the same column — `isUName` reads
// `unNames` only, `unionRowOfTy` reads `unTyIx` — so a disagreement here is as likely to be
// a coverage hole as a key disagreement, and the buckets are named apart for that reason.
export function isUNameAB(site: i32, name: string, ty: i32): boolean {
  const n = isUName(name)
  const m = unABOn()
  if m == 0 { return n }
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(ty) }
  let nr = -1
  if n { nr = unRowOfName(name) }
  unABProbe(site, nr, d, ty)
  if m == 2 { return d >= 0 }
  n
}

// `isUName`'s seam for a caller with no arena node: the NAME answer, plus a tally of what the
// row-by-KEY twin says. The id side takes the caller's TYPE where it has one and otherwise the
// key canon mints for the spelling — which is an identity, not a re-cut substring. A key of -1
// (the empty name) is counted as "no id offered", the same bucket a missing type takes.
export function isUNameKeyAB(site: i32, name: string, ty: i32): boolean {
  const n = isUName(name)
  const m = unABOn()
  if m == 0 { return n }
  let d = -1
  let key = -1
  if ty >= 0 {
    key = 0
    d = unRowOfTyAB(ty)
  } else {
    key = canonUnionKeyOfName(name)
    if key >= 0 { d = unRowOfKeyId(key) }
  }
  let nr = -1
  if n { nr = unRowOfName(name) }
  unABProbe(site, nr, d, key)
  if m == 2 { return d >= 0 }
  n
}

// The member-type seam. Mode 2 is an additive retry — it fills `out` from the id-keyed row
// only where the spelling found none — because the name leg has already appended to `out`
// by the time the id answer is known, and a seam that both fills and re-fills is measuring
// its own double write rather than the key.
function unionMemberTysOfAB(
  site: i32,
  name: string,
  ty: i32,
  out: i32[],
): boolean {
  const r = unionMemberTysOf(name, out)
  const m = unABOn()
  if m == 0 { return r }
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(ty) }
  unABProbe(site, unRowOfName(name), d, ty)
  if m == 2 && !r { return unionMemberTysOfRow(d, out) }
  r
}

// `unionHasAtom`'s seam. That predicate is a SPELLING scan, not a registry read — it walks
// the pipe-separated spans of `name` — so its id-keyed twin walks the row's recorded
// `unMemAtoms` instead, which is the same member list the mint recorded verbatim.
export function unionHasAtomAB(
  site: i32,
  name: string,
  ty: i32,
  atom: string,
): boolean {
  const n = unionHasAtom(name, atom)
  const m = unABOn()
  if m == 0 { return n }
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(ty) }
  unABProbe(site, unRowOfName(name), d, ty)
  if m == 2 && d >= 0 { return unionHasAtomRow(d, atom) }
  n
}

// The value-union mint's seam. `registerValueUnionName` resolves the spelling once at the
// boundary; this records whether the id the caller could have offered names the same type,
// and under mode 2 mints from the caller's id instead. The shipped answer stays the name's,
// so a converted mint site is unaffected when unarmed. `docs/internals/registry-by-type-id.md` §5.
export function registerValueUnionNameAB(
  site: i32,
  name: string,
  ty: i32,
): i32 {
  const d = declTyIxOfName(name)
  const m = unABOn()
  if m == 0 { return registerValueUnionNameTy(name, d) }
  unABTyProbe(site, d, ty)
  if m == 2 && ty >= 0 { return registerValueUnionNameTy(name, ty) }
  registerValueUnionNameTy(name, d)
}

// The key-stability check, per row: does the key the row's producer minted equal the key the
// other two producers (the arena type, the recorded member set) would obtain? A key with
// three entry points is only a key if they land on one id — the property step 5's switch
// rests on. `ty-none` separates "the arena route has no render" from "it disagrees".
function unKeySweepRow(u: i32, ty: i32) {
  let k = -1
  if u < unKey.length { k = unKey[u] }
  if k >= 0 { repShadowBumpReason("keySweep/covered") }
  if ty >= 0 {
    const kt = canonUnionKey(ty)
    if kt < 0 { repShadowBumpReason("keySweep/ty-none") }
    else if kt == k { repShadowBumpReason("keySweep/ty-agree") }
    else { repShadowBumpReason("keySweep/ty-differ") }
    // The step-4a route beside the step-3 one, on the same rows in the same run: the
    // structural render's reach is what `tykey-*` has to beat, and a table of one is a
    // number nobody can grade.
    const kn = canonUnionKeyOfTy(ty)
    if kn < 0 { repShadowBumpReason("keySweep/tykey-none") }
    else if kn == k { repShadowBumpReason("keySweep/tykey-agree") }
    else { repShadowBumpReason("keySweep/tykey-differ") }
  }
  if u < unMemberSet.length {
    const ks = canonUnionKeyOfName(unMemberSet[u])
    if ks == k {
      repShadowBumpReason("keySweep/set-agree")
    } else {
      repShadowBumpReason("keySweep/set-differ")
    }
  }
  0
}

// The second half of the key's licence — `merge-diffset` alone is not it (D1492). A struct
// union's tags are positional over its variant slice, not the member-set string, so two rows
// with the same set but different slices need this too. Complementary: a value union owns no
// variants, so only the set compare can see two atom sets fused.
function unRowVariantsSame(a: i32, b: i32): boolean {
  if a >= unVarStart.length || b >= unVarStart.length { return false }
  if a >= unVarCount.length || b >= unVarCount.length { return false }
  const na = unVarCount[a]
  if na != unVarCount[b] { return false }
  const sa = unVarStart[a]
  const sb = unVarStart[b]
  if sa < 0 || sb < 0 { return false }
  if sa + na > uVariants.length || sb + na > uVariants.length { return false }
  let i = 0
  while i < na {
    if uVariants[sa + i] != uVariants[sb + i] { return false }
    i = i + 1
  }
  true
}

// The ABI assertion step 5 owes: two rows one key would fuse, and how many of those record a
// different member set. A union's box tags are positional over its own member set, so a merge
// across different sets reads a value tagged under one slice through the other's — the
// hazard that disqualified `repCanonId`. `merge-diffset` must be 0 for the key to be usable.
function unKeySweepPair(u: i32, v: i32) {
  let k = -1
  let kv = -1
  if u < unKey.length { k = unKey[u] }
  if v < unKey.length { kv = unKey[v] }
  if k < 0 || kv < 0 { return 0 }
  if k != kv { return 0 }
  repShadowBumpReason("keySweep/merge")
  if unNames[u] != unNames[v] { repShadowBumpReason("keySweep/merge-diffname") }
  if v < unMemberSet.length && u < unMemberSet.length {
    if unMemberSet[u] != unMemberSet[v] {
      repShadowBumpReason("keySweep/merge-diffset")
    }
  }
  if !unRowVariantsSame(u, v) { repShadowBumpReason("keySweep/merge-diffvar") }
  0
}

// The whole-registry measurement, run once per program beside `repShadowSweep`: every row
// asked about itself, both ways, with no call-site plumbing. The round-trips say whether a
// key can even name its own row; `canon-merge` counts pairs of distinct rows one canon id
// would fuse — the ABI hazard, since a union's box tags are positional over its own member set.
export function unionRegistryABSweep() {
  if unABOn() == 0 { return 0 }
  let s = 1
  while s < UNAB_N {
    let k = 0
    while k < UNAB_K {
      const at = s * UNAB_K + k
      if at < unABCnt.length {
        repShadowAddReason(
          "unionAB/" + unABSiteName(s) + "/" + unABKindName(k),
          unABCnt[at],
        )
      }
      k = k + 1
    }
    s = s + 1
  }
  repShadowAddReason("atomRetry/id-hit", unRetryHit)
  repShadowAddReason("atomRetry/id-miss", unRetryMiss)
  unABCnt = []
  unRetryHit = 0
  unRetryMiss = 0
  let u = 0
  while u < unNames.length {
    repShadowBumpReason("unionSweep/rows")
    if unionRowOf(unNames[u]) == u { repShadowBumpReason("unionSweep/name-rt") }
    let ty = -1
    if u < unTyIx.length { ty = unTyIx[u] }
    if ty >= 0 {
      repShadowBumpReason("unionSweep/covered")
      if unionRowOfTy(ty) == u { repShadowBumpReason("unionSweep/canon-rt") }
      if unionRowOfTyRaw(ty) == u { repShadowBumpReason("unionSweep/raw-rt") }
    }
    unKeySweepRow(u, ty)
    let v = u + 1
    while v < unNames.length {
      if unNames[u] == unNames[v] { repShadowBumpReason("unionSweep/name-dup") }
      let tv = -1
      if v < unTyIx.length { tv = unTyIx[v] }
      unKeySweepPair(u, v)
      if ty >= 0 && tv >= 0 {
        if repCanonId(ty) == repCanonId(tv) {
          repShadowBumpReason("unionSweep/canon-merge")
          if unNames[u] != unNames[v] {
            repShadowBumpReason("unionSweep/canon-merge-diffname")
          }
          // Bounded, not assumed adjacent: `unMemberSet` is pushed in lockstep with `unNames`
          // at all three mint sites, but this sweep never relies on that alignment holding.
          if v < unMemberSet.length && u < unMemberSet.length {
            if unMemberSet[u] != unMemberSet[v] {
              repShadowBumpReason("unionSweep/canon-merge-diffset")
            }
          }
        }
      }
      v = v + 1
    }
    u = u + 1
  }
  0
}

// The row-keyed core of `unMemHasAtom` — the same walk from a row instead of a spelling.
// Every parallel-table read here is bounded: a row named by a key the table never grew
// is exactly the shape that trapped before. D1152.
function unMemHasAtomRow(u: i32, want: string, arr: boolean): i32 {
  if u < 0 { return -1 }
  if u >= unMemTyStart.length { return -1 }
  if u >= unMemTyCount.length { return -1 }
  const st = unMemTyStart[u]
  const n = unMemTyCount[u]
  if st < 0 { return -1 }
  if st + n > unMemTys.length { return -1 }
  let i = 0
  while i < n {
    let m = unMemTys[st + i]
    if m < 0 { return -1 }
    if m >= T.tys.length { return -1 }
    if arr {
      const ta = T.tys[m]
      m = -1
      if ta is TyArray { m = ta.aElem }
      if m >= T.tys.length { return -1 }
    }
    if m >= 0 {
      const t = T.tys[m]
      if t is TyPrim {
        if t.primName == want { return 1 }
      }
    }
    i = i + 1
  }
  0
}

// `unionHasAtom`'s row-keyed twin: does row `u` record a member whose verbatim atom
// spelling is `atom`? The name-keyed original scans the pipe-separated spans of a
// spelling; this scans `unMemAtoms`, recorded from exactly those spans, so the two answer
// the same question off the same text. Bounded through `unMemRowStart`. D1152.
function unionHasAtomRow(u: i32, atom: string): boolean {
  const st = unMemRowStart(u)
  if st < 0 { return false }
  const n = unMemTyCount[u]
  let i = 0
  while i < n {
    if unMemAtoms[st + i] == atom { return true }
    i = i + 1
  }
  false
}

// The registry row for a SPELLING, keyed by rep identity rather than by text: the name is
// used only as a ROUTE to the arena (`declTyIxOfName`), and the comparison is `repCanonId`.
// This is the query a registry keyed on an interned rep key would perform, written so the
// three filed witnesses can be graded without threading a type through their call chains.
function unionRowOfSpellingTy(name: string): i32 {
  const ty = declTyIxOfName(name)
  if ty < 0 { return -1 }
  unionRowOfTy(ty)
}

// The id-keyed RETRY at the atom test's decline. -1 always when unarmed, so the shipped
// compiler reaches its `emitFail` exactly as before; mode 1 only TALLIES whether the id key
// would have found the row, mode 2 answers from it. `id-hit` counts the refusals a rep-keyed
// registry would not have raised — the number the design's witness claim rests on.
function unABAtomRetry(name: string, want: string, arr: boolean): i32 {
  const m = unABOn()
  if m == 0 { return -1 }
  const u = unionRowOfSpellingTy(name)
  if u < 0 {
    unRetryMiss = unRetryMiss + 1
    return -1
  }
  unRetryHit = unRetryHit + 1
  if m != 2 { return -1 }
  unMemHasAtomRow(u, want, arr)
}

// The arena member types of the union `name`, appended to `out` in the row's recorded order
// (the box-tag ABI order). True when the row is covered and every member resolved; false
// leaves `out` untouched and the caller keeps its legacy member-name path. Consumers then
// classify each member structurally instead of re-deriving shape from its rendered spelling.
function unionMemberTysOf(name: string, out: i32[]): boolean {
  unionMemberTysOfRow(unionRowOf(name), out)
}

// The same walk from a ROW — the one place the member columns are read, so a
// spelling-keyed and an arena-keyed entry point cannot drift into two readings of them.
function unionMemberTysOfRow(u: i32, out: i32[]): boolean {
  if u < 0 { return false }
  if u >= unMemTyStart.length { return false }
  const st = unMemTyStart[u]
  if st < 0 { return false }
  const n = unMemTyCount[u]
  let i = 0
  while i < n {
    if unMemTys[st + i] < 0 { return false }
    i = i + 1
  }
  let j = 0
  while j < n {
    out.push(unMemTys[st + j])
    j = j + 1
  }
  true
}

// The union-box ABI's atom test, from the arena: 1 when the union `name` has a member whose
// type is exactly the keyword primitive `want` (or exactly an array over it when `arr`), 0
// for none, -1 when the row is uncovered — a "cannot happen" its only caller diagnoses. Exact
// match only: the caller turns the atom into a tag, never asking "reps like this" instead.
export function unMemHasAtom(name: string, want: string, arr: boolean): i32 {
  const mems: i32[] = []
  if !unionMemberTysOf(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    let m = mems[i]
    if m >= T.tys.length { return -1 }
    if arr {
      const ta = T.tys[m]
      m = -1
      if ta is TyArray { m = ta.aElem }
      if m >= T.tys.length { return -1 }
    }
    if m >= 0 {
      const t = T.tys[m]
      if t is TyPrim {
        if t.primName == want { return 1 }
      }
    }
    i = i + 1
  }
  0
}

// The union-box ABI's atom test, answered only from the arena: a row minted without its
// members, an unresolved member spelling, or an unregistered name are each structurally
// impossible once a value is boxed with a tag, since the registration that mints the tag
// also records the members. An uncovered row is a "cannot happen" — it fails loudly.
export function unionHasAtomTy(
  name: string,
  want: string,
  arr: boolean,
): boolean {
  const a = unMemHasAtom(name, want, arr)
  if a >= 0 { return a == 1 }
  // SPIKE: would a registry keyed on rep identity have found this row? -1 when unarmed, so
  // the refusal below is reached exactly as before (`unABAtomRetry`).
  const r = unABAtomRetry(name, want, arr)
  if r >= 0 { return r == 1 }
  emitFail(
    "emitProgram: union box atom test on a union with no recorded members: " +
      name,
  )
  false
}

// ── the union member set as a structure ────────────────────────────────────────

// A member set is a subset of one union row's recorded members: the pair (row, mask), where
// bit `i` of the mask is member `i` in the row's recorded (box-tag ABI) order — never
// re-derived, only masked. Membership is a kind test or interned-id compare, not a substring
// search; a set renders (`msTextOf`) only when handed to a name-keyed consumer.

// The member slice of union row `u`, or -1 when the row is not covered by the reference
// columns (a row the recorder missed, an empty row, or one wider than the 31-bit mask).
// `unMemTyStart`/`unMemTyCount` slice all four member columns alike. The bound lives once,
// in `emit_rep` beside the recorder that writes the columns (#1110) — this is its local spelling.
function msRowStart(u: i32): i32 { unMemRowStart(u) }

// Is member `i` present in `mask`? (Bitwise `&` binds LOOSER than `==` in this
// language, so the test is parenthesized once here rather than at five call sites.)
function msBitSet(mask: i32, i: i32): boolean { ((mask >>> i) & 1) == 1 }

// The rendered form of the subset `mask` of row `u`: the surviving members'
// verbatim spellings, joined on `|`, in the row's recorded order.
function msRenderSet(u: i32, mask: i32): string {
  const st = msRowStart(u)
  if st < 0 { return "" }
  const n = unMemTyCount[u]
  let out = ""
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if out != "" { out = out + "|" }
      out = out + unMemAtoms[st + i]
    }
    i = i + 1
  }
  out
}

// The interned set id for the subset `mask` of row `u` — one id per distinct
// (row, mask), so a set's rendering is built once and every later operation on it is
// a table read. Stamped with the pool generation (method note 7).
function msSetIntern(u: i32, mask: i32): i32 {
  while msRowChain.length <= u { msRowChain.push(-1) }
  let s = msRowChain[u]
  while s >= 0 {
    if msSetMask[s] == mask && msSetGen[s] == msGen { return s }
    s = msSetNext[s]
  }
  const id = msSetRow.length
  const txt = msRenderSet(u, mask)
  msSetRow.push(u)
  msSetMask.push(mask)
  msSetGen.push(msGen)
  msSetNext.push(msRowChain[u])
  msSetText.push(txt)
  msRowChain[u] = id
  if txt != "" {
    if (msSetByText[txt] ?? -1) < 0 { msSetByText[txt] = id }
  }
  id
}

// The set id of union row `u`'s FULL member set, or -1 when the row is uncovered.
function msSetOfRow(u: i32): i32 {
  const st = msRowStart(u)
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  msSetIntern(u, (1 << n) - 1)
}

// The set id for a member-set string — the bridge for a consumer still holding text. A set
// the pool already rendered answers from the text index; otherwise the string must be some
// union row's full member set, and a row whose recorded set matches hands over its members.
// -1 = uncovered; an alias name (`N`) is deliberately kept as a one-atom set, like the legacy path.
export function msSetOfText(set: string): i32 {
  if set == "" { return -1 }
  const hit = msSetByText[set] ?? -1
  if hit >= 0 {
    if msSetGen[hit] == msGen { return hit }
  }
  if (msSetMiss[set] ?? -1) == msGen { return -1 }
  let u = 0
  while u < unMemberSet.length {
    if unMemberSet[u] == set {
      const id = msSetOfRow(u)
      if id >= 0 { return id }
    }
    u = u + 1
  }
  msSetMiss[set] = msGen
  -1
}

// The rendered member set of `s` (see `msRenderSet`).
function msTextOf(s: i32): string {
  if s < 0 || s >= msSetText.length { return "" }
  msSetText[s]
}

// Appends the set's member spellings to `out`, in the row's recorded (box-tag ABI) order,
// without re-splitting anything: the recorded member column is what `splitUnionAtoms` would
// rebuild, since `msSetOfText` only hands back a set matching the row's own recorded string.
// False = uncovered, `out` untouched, and the caller splits as before.
export function msMemberAtomsOf(set: string, out: string[]): boolean {
  msMemberAtomsOfSet(msSetOfText(set), out)
}

// `msMemberAtomsOf` for a caller that already holds the set id — the whole point of banking
// one: `msSetOfText` is a text→set resolution (a map probe, or on a miss a linear scan of
// every registered row); a consumer that already has its set from the narrowing table or an
// earlier resolution has no reason to render it and look it up again.
export function msMemberAtomsOfSet(s: i32, out: string[]): boolean {
  if s < 0 { return false }
  if s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return false }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let i = 0
  while i < n {
    if msBitSet(mask, i) { out.push(unMemAtoms[st + i]) }
    i = i + 1
  }
  true
}

// MEMBERSHIP of the `null` keyword — a member-KIND test over the set's members, with
// no string compare at all.
export function msHasNull(s: i32): boolean {
  if s < 0 || s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return false }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if unMemKinds[st + i] == 0 { return true }
    }
    i = i + 1
  }
  false
}

// CARDINALITY of the non-`null` members — a bit count over the kind column.
function msNonNullCount(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return 0 }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return 0 }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let c = 0
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if unMemKinds[st + i] != 0 { c = c + 1 }
    }
    i = i + 1
  }
  c
}

// The arena type of the set's sole member, or -1 when the set is empty, uncovered, or has
// two or more members. The bridge from the set ADT to the per-type classifiers: a complement
// narrowing subtracted down to one member (`i32 | null` minus `null`) binds that member's
// type, so "what is this binding now" asks the type, not the rendered survivor.
function msSoleMemberTy(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let found = -1
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if found >= 0 { return -1 }
      found = st + i
    }
    i = i + 1
  }
  if found < 0 { return -1 }
  unMemTys[found]
}

// SUBTRACTION of the `null` keyword: clear every member whose KIND is the null token.
export function msSubNull(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  let mask = msSetMask[s]
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if unMemKinds[st + i] == 0 { mask = mask - (1 << i) }
    }
    i = i + 1
  }
  msSetIntern(u, mask)
}

// SUBTRACTION of a named member: clear every member whose interned IDENTITY is the
// removed one. `msAtomIdOf` peels grouping parens on both sides, exactly as the
// string surgery's `peelGroupParens` comparison did, so an `is () => i64` test still
// strips the `(() => i64)` member.
export function msSubAtom(s: i32, removed: string): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  const rid = msAtomIdOf(removed)
  let mask = msSetMask[s]
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if unMemAtomIds[st + i] == rid { mask = mask - (1 << i) }
    }
    i = i + 1
  }
  msSetIntern(u, mask)
}

// ── the set ADT's consumers (structure first, string surgery as fall-through) ──

// Set SUBTRACTION — the else-branch complement of `is removed` / `!= null`. The
// structural path resolves the set, clears the removed member's bits and renders the
// survivors in the row's recorded ORDER; `removeAtomFrom`'s string surgery stays as
// the fall-through for a set the pool does not cover.
export function removeAtomFromSet(set: string, removed: string): string {
  const s = msSetOfText(set)
  if s >= 0 {
    let r = -1
    // `null` is a keyword, not a rendered shape — the one member the structural path
    // identifies without any name at all, and the dominant removal (`!= null` else-branches).
    if removed == "null" { r = msSubNull(s) } else { r = msSubAtom(s, removed) }
    if r >= 0 { return msTextOf(r) }
  }
  removeAtomFrom(set, removed)
}

// Set subtraction that keeps the set identity: subtract `removed` from set `s` and push the
// survivors as `name`'s narrowing, banking the resulting set id so the next complement over
// the same binding subtracts from a (row, mask) pair rather than re-parsing a rendered
// survivor list. Returns the pushed rendering, or "" when the caller keeps its string path.
function pushNarrowComplement(name: string, s: i32, removed: string): string {
  if s < 0 { return "" }
  let r = -1
  if removed == "null" { r = msSubNull(s) } else { r = msSubAtom(s, removed) }
  if r < 0 { return "" }
  const txt = msTextOf(r)
  if txt == "" { return "" }
  pushNarrowRep(name, txt, -1, r)
  txt
}

// The interned set a binding is currently narrowed to — the set-ADT reading of
// `currentNarrowSetOf`: the innermost narrowing's banked set when it has one, else the
// declared union's own set. -1 means no set (an `is`-pinned narrowing, a declined alias
// name, an unregistered union), and the caller keeps the rendered path.
export function currentNarrowSetIdOf(name: string, fnIx: i32): i32 {
  const i = narrowSlotOf(name)
  if i >= 0 { return narrowSets[i] }
  msSetOfText(unionNameOfIdent(name, fnIx))
}

// The struct-union dual of `currentNarrowSetIdOf` (`currentStructNarrowSetOf`'s set):
// an un-narrowed binding resolves through the alias expansion its rendered twin uses.
function currentStructNarrowSetIdOf(name: string, fnIx: i32): i32 {
  const i = narrowSlotOf(name)
  if i >= 0 { return narrowSets[i] }
  msSetOfText(unionMemberSetOf(unionNameOfIdent(name, fnIx)))
}

// The per-arm plan for `print(<value-union box>)`: the box-tag ABI-ordered value-atom kind of
// every arm, appended to `out`, true only when every arm is a value `print` renders on its
// own. Kinds 0..5 are `print`'s declared scalar/string domain (plus 6 for `null`); kinds
// 7..13 (lists, closures) are containers with no defined print rendering and decline. D711.
function printNarrowKeepsBox(key: string): boolean {
  const nv = narrowVariantFor(key)
  if nv == "" { return true }
  unionMemberCount(nv) > 1
}

export function printUnionRecvIsBox(exprIx: i32, fnIx: i32): boolean {
  if exprIx < 0 { return false }
  if !exprUnion(exprIx, fnIx) { return false }
  const pe = P.nodes[unwrapParen(exprIx)]
  if pe is Ident { return printNarrowKeepsBox(pe.identName) }
  if pe is Member {
    return printNarrowKeepsBox(memberPathKeyOf(unwrapParen(exprIx)))
  }
  if pe is Index {
    return printNarrowKeepsBox(indexPathKeyOf(unwrapParen(exprIx)))
  }
  true
}

function printUnionPlanCode(exprIx: i32, fnIx: i32, out: i32[]): i32 {
  if !printUnionRecvIsBox(exprIx, fnIx) { return 0 }
  const nm = unionNameOfExpr(exprIx, fnIx)
  if nm == "" { return 0 }
  // The row's recorded members, in box-tag ABI order — the order the dispatch walks and
  // `emitUnionCoerce` tagged them in; an uncovered set falls back to the rendered expansion.
  const sid = msSetOfText(nm)
  const atoms: string[] = []
  if !msMemberAtomsOfSet(sid, atoms) {
    splitUnionAtoms(unionMemberSetOf(nm), atoms)
  }
  if atoms.length < 2 { return 0 }
  const kinds: i32[] = []
  // The BANKED codes when the row has them (`unMemValKind` is index-parallel to the atom
  // column and is literally `valueAtomKind` per member), else the per-atom derivation.
  if !msMemberValKindsOf(sid, kinds) || kinds.length != atoms.length {
    while kinds.length > 0 { kinds.pop() }
    let d = 0
    while d < atoms.length {
      kinds.push(valueAtomKind(atoms[d]))
      d = d + 1
    }
  }
  // A bare map read is `V | null` whatever `V` is (a missing key reads the null-tagged box),
  // so the dispatch needs a `null` arm the map's declared value set may not carry.
  if mapReadNarrowableSlot(unwrapParen(exprIx), fnIx) >= 0 {
    if !unionSetHasNull(nm) {
      atoms.push("null")
      kinds.push(nullValKind())
    }
  }
  let nonNull = 0
  let hasNull = false
  let solo = -1
  let bad = false
  const seen: i32[] = []
  let i = 0
  while i < kinds.length {
    let k = kinds[i]
    // A literal-union arm (`K0 | i64`) is not a value atom but boxes as one under the string
    // tag (`emitUnionCoerce`'s `unionTakesAtomAsStr`), so it prints as the string arm here.
    if k < 0 && nameIsLitUnionType(atoms[i]) { k = 2 }
    // A member the box ABI does not classify (a struct arm, an inline shape) means this
    // isn't the boxed value union — decline the shape rather than call it a failure.
    if k < 0 { return 0 }
    // A container arm (kinds 7..13) is in a box the dispatch cannot render — recorded and
    // answered below, so the result tells "not my shape" apart from "my shape, can't do it".
    if k > 6 { bad = true }
    if k == nullValKind() {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      solo = k
    }
    // One arm per TAG. Two members can share a tag (a litunion arm beside a `string` one),
    // and a second `if tag == 2` would be dead code the last-arm fall-through never reaches.
    let dup = false
    let s = 0
    while s < seen.length {
      if seen[s] == k { dup = true }
      s = s + 1
    }
    if !dup { seen.push(k) }
    i = i + 1
  }
  // The box test mirrors the checker's `valueUnionFromAtomKinds` gate: 2+ non-null atoms
  // box, and one numeric atom beside `null` boxes — `boolean|null`/`string|null` are niches.
  let boxed = nonNull >= 2
  if nonNull == 1 && hasNull {
    if solo == 0 || solo == 3 || solo == 4 || solo == 5 { boxed = true }
  }
  if !boxed { return 0 }
  if bad { return -1 }
  let o = 0
  while o < seen.length {
    out.push(seen[o])
    o = o + 1
  }
  1
}

// The boolean face — "will this LOWER" — for the reservation scan and the handler.
export function printUnionPlan(exprIx: i32, fnIx: i32, out: i32[]): boolean {
  printUnionPlanCode(exprIx, fnIx, out) == 1
}

// "The value is the box and the dispatch cannot render one of its arms" — the emitter's last
// line of defence, not `printUnionRecvIsBox` (which over-claims). Falling through with a real
// box on the stack ends in `call __print_i32__` against a `(ref $uBox)`: check-clean invalid
// wasm. Should be unreachable — this exists to make a disagreement between the two gates loud.
export function printUnionArmsUnrenderable(exprIx: i32, fnIx: i32): boolean {
  const pk: i32[] = []
  printUnionPlanCode(exprIx, fnIx, pk) < 0
}

// Does the print-union plan for `exprIx` carry a STRING arm? The reservation scan's half of
// the pair above — a string arm streams through `emitPrintStrFromScratch`, which lives in
// the str-op scratch frame.
export function printUnionHasStrArm(exprIx: i32, fnIx: i32): boolean {
  const pk: i32[] = []
  if !printUnionPlan(exprIx, fnIx, pk) { return false }
  let i = 0
  while i < pk.length {
    if pk[i] == 2 { return true }
    i = i + 1
  }
  false
}

// MEMBERSHIP of `null` in a member set, structurally.
export function unionSetHasNull(set: string): boolean {
  const s = msSetOfText(set)
  if s >= 0 { return msHasNull(s) }
  unionHasAtom(set, "null")
}

// CARDINALITY of a member set's non-`null` members, structurally.
function unionSetNonNullCount(set: string): i32 {
  const s = msSetOfText(set)
  if s >= 0 { return msNonNullCount(s) }
  nonNullMemberCountOf(set)
}

// ── the arena duals of the union structural member classifiers ─────────────────

// Each answers the same question `nameIs*` asked of a rendered atom spelling, from the
// member's arena type instead — `nameIsMap` / `nameIsClosureArray` / `valueAtomKind(.) ==
// 11` / `nameIsArray(.) && nameIsMap(refArrElemName(.))`.

// A MAP member (`{[string]: V}`). The `nameIsMapMemberUnion` exclusion the name path
// carries is structural here for free: a union whose FIRST atom is a map renders as a
// `{[`-prefixed name but IS a `TyUnion`, never a `TyMap`.
export function unMemIsMap(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyMap { return true }
  false
}

// A bare-closure member (`(() => i64) | i32` — value-atom kind 11).
export function unMemIsFunc(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyFunc { return true }
  false
}

// A closure-element array member (`((i32) => f64)[]`, `nameIsClosureArray`). A
// nullable-closure element (`(((i32) => boolean) | null)[]`) is a `TyNullable`
// element, not a `TyFunc` — excluded here exactly as `nameIsClosureArray` excludes it.
function unMemIsFuncArray(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyFunc { return true }
  }
  false
}

// An ARRAY-OF-MAP member (`{[string]: V}[]`). The name path's
// `!nameIsMapMemberUnion(elem)` guard is again free: a map-member-UNION element is a
// `TyUnion`, not a `TyMap`.
function unMemIsMapArray(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyMap { return true }
  }
  false
}

// A ref-array member whose element type reaches a function type — the structural dual
// of the deliberately-conservative `strContains(refArrElemName(a), "=>")` arm test
// (`calleeIsUnionElemFieldClosure`). Depth-bounded and cycle-tolerant by the bound.
function unMemIsFuncReachArray(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyArray { return tyReachesFuncD(t.aElem, 12) }
  false
}

// A ref-element array member — the structural dual of `markRefArrayArms`'s gate over a
// member's rendered spelling: a `TyArray` whose element does not ride a scalar-leaf list
// backing. Not the dual of `nameIsRefArray`, which is a strict subset (it also demands the
// element be nameable by the reflist layer) — see the refutation at `unionHasRefArrayArmSlot`.
export function unMemIsRefElemArray(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyArray {
    const e = t.aElem
    if e < 0 { return false }
    if tyIsI32LeafElem(e) { return false }
    if tyIsStrLeafElem(e) { return false }
    const et = T.tys[e]
    if et is TyPrim {
      if et.primName == "f64" { return false }
      if et.primName == "i64" { return false }
      if et.primName == "f32" { return false }
      // A packed byte list is not a ref-element array — without this, `u8[]` fell through
      // to `true` and got tagged for a reflist wrapper instead of its `$bl8` scalar rep. #1805.
      if et.primName == "u8" { return false }
    }
    return true
  }
  false
}

// The value-atom kind of a union member, from the arena — the structural dual of
// `valueAtomKind(atom)` over the member's rendered spelling, tested in the same order:
// primitives by `primName`, an i32-backed leaf array as 7 (before the per-width numeric
// lists and the string leaf array), a function type as 11. Anything else is -1.
export function unMemAtomKind(m: i32): i32 {
  if m < 0 { return -1 }
  const t = T.tys[m]
  if t is TyPrim { return valueAtomKind(t.primName) }
  if t is TyArray {
    const e = t.aElem
    if e < 0 { return -1 }
    if tyIsI32LeafElem(e) { return 7 }
    const et = T.tys[e]
    if et is TyPrim {
      if et.primName == "f64" { return 8 }
      if et.primName == "i64" { return 10 }
      if et.primName == "f32" { return 12 }
      // The packed byte list — `valueAtomKind`'s `u8` arm, asked of the element row; without
      // it, `is u8[]` fell past the value-atom arm to the struct-variant ladder and rejected.
      if et.primName == "u8" { return 13 }
    }
    if tyIsStrLeafElem(e) { return 9 }
    return -1
  }
  if t is TyFunc { return 11 }
  -1
}

// ── the union arm-path walk, from the arena ─────────────────────────────────────

// The `unionArmPath*` family answers "does this union arm's field path `a.b.c` leaf at a
// map / a list-of-maps / a closure / a closure-array / a closure-carrying value" by walking
// the arena structurally instead of the emitter's per-field lowering codes — narrowing-blind
// and conservative, so an unresolvable arm answers "no".

// The inner of a `T | null`, else `ty` itself. The lowering codes fold a nullable
// struct (`next: S | null`) into the same code-15 nested-struct hop as a bare `S`, and
// a nullable closure into code 22 beside code 14's bare one.
export function tyPeelNul(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  ty
}

// The arena type of field `name` of the object type `ty` (nullable-peeled — a code-15
// hop follows `S` and `S | null` alike), or -1 when `ty` is not an object or has no
// such field.
function tyObjFieldTy(ty: i32, name: string): i32 {
  const b = tyPeelNul(ty)
  if b < 0 { return -1 }
  const t = T.tys[b]
  if t is TyObj {
    let i = 0
    while i < t.objFieldNames.length {
      if t.objFieldNames[i] == name { return t.objFieldTypes[i] }
      i = i + 1
    }
  }
  -1
}

// Walks the field path `path` from the union member type `m` and returns the arena type of
// the leaf field, or -1. Mid hops must be object-typed — a map/union-box/list mid field
// yields no field — mirroring the lowering-code walk's own `code != 15` guard. The leaf
// comes back unclassified so each consumer applies its own predicate.
function tyArmPathLeaf(m: i32, path: string[]): i32 {
  if m < 0 || path.length == 0 { return -1 }
  let cur = m
  let hop = 0
  while hop < path.length {
    const ft = tyObjFieldTy(cur, path[hop])
    if ft < 0 { return -1 }
    if hop == path.length - 1 { return ft }
    cur = ft
    hop = hop + 1
  }
  -1
}

// The arm type a `t0[i].f…` root walks from: the ELEMENT of a ref-array arm. -1 for a
// non-array arm (the name path's `nameIsRefArray(arm)` gate, structurally).
function tyArmElem(m: i32): i32 {
  if m < 0 { return -1 }
  const t = T.tys[m]
  if t is TyArray { return t.aElem }
  -1
}

// `tyArmPathIsMap`'s leaf: a MAP field (code 19). NOT nullable-peeled — a
// `{[string]: V} | null` field is code 29, which the code walk does not accept.
function tyArmPathIsMap(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyMap { return true }
  false
}

// `tyArmPathIsMapList`'s leaf: a LIST-OF-MAPS field (code 5 whose element renders as
// a map) — a `TyArray` over a `TyMap`.
function tyArmPathIsMapList(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyMap { return true }
  }
  false
}

// `tyArmPathIsClosure`'s leaf: a closure field (code 14) or its nullable niche
// (code 22) — a `TyFunc`, bare or under one `TyNullable`.
function tyArmPathIsClosure(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const b = tyPeelNul(leaf)
  if b < 0 { return false }
  const t = T.tys[b]
  if t is TyFunc { return true }
  false
}

// `tyArmPathIsCloArray`'s leaf: a closure-element array field (code 5 whose element
// name carries a top-level arrow) — a `TyArray` over a `TyFunc`. A nullable-closure
// element is a `TyNullable`, excluded here exactly as the arrow scan excludes it (the
// arrow sits under the element's own parens, never at depth 0).
function tyArmPathIsCloArray(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyFunc { return true }
  }
  false
}

// `tyArmPathHasCloValue`'s leaf: a closure field (14/22) or a union-box field (16) whose
// member set has a bare-closure arm — a `TyFunc`, or a `TyUnion` with a `TyFunc` member.
// Both are nullable-peeled: an `((i32) => i32) | null` field is code 22, and a `(A | B) |
// null` box field keeps its `null` atom in the member set the code walk consults.
function tyArmPathHasCloValue(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const b = tyPeelNul(leaf)
  if b < 0 { return false }
  const t = T.tys[b]
  if t is TyFunc { return true }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const mt = T.tys[tyPeelNul(t.uMembers[i])]
      if mt is TyFunc { return true }
      i = i + 1
    }
  }
  false
}

// True when `ty` contains a `TyFunc` anywhere in its structure (fields, elements, map
// values, nullable inners, union members) within `depth` wrapper hops.
function tyReachesFuncD(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyFunc { return true }
  if t is TyArray { return tyReachesFuncD(t.aElem, depth - 1) }
  if t is TyNullable { return tyReachesFuncD(t.nInner, depth - 1) }
  if t is TyMap { return tyReachesFuncD(t.mVal, depth - 1) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if tyReachesFuncD(t.uMembers[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyObj {
    let j = 0
    while j < t.objFieldTypes.length {
      if tyReachesFuncD(t.objFieldTypes[j], depth - 1) { return true }
      j = j + 1
    }
    return false
  }
  false
}

// The CURRENT narrowed variant set of a STRUCT-union binding `name`: its innermost
// active narrowing when one exists (which may already be a subtracted sub-set),
// else its declared union's FULL member set (alias names expanded so subtraction
// sees every variant + a `null` member). "" when not a union binding.
function currentStructNarrowSetOf(name: string, fnIx: i32) {
  const v = narrowVariantFor(name)
  if v != "" { return v }
  unionMemberSetOf(unionNameOfIdent(name, fnIx))
}

// The map-value compat of an object literal's field value against a candidate variant's
// code-19 field: the literal's checker-recorded map value type must not contradict the
// variant's recorded value rep. Lenient when the value isn't classifiable as a map (it
// fails loudly downstream); an atom-valued literal field is compatible with any mono elem.
function objMapFieldCompat(objIx: i32, fname: string, elem: string): boolean {
  const valIx = objFieldVal(objIx, fname)
  if valIx < 0 { return true }
  if !nodeTyIsMap(valIx) { return true }
  if nodeTyMapValIsLitUnion(valIx) { return mvValKindOfName(elem) == -1 }
  mvValNamesCompat(nodeTyMapValName(valIx), elem)
}

// The nested-struct compat of an object literal's field value against a candidate
// variant's code-15 field: a nested literal value's field-name set must equal the target
// struct's — deliberately name-set only, since the checker records the literal's inferred
// leaf types, and a non-literal value stays lenient (it fails loudly downstream if wrong).
function objNestedFieldCompat(
  objIx: i32,
  fname: string,
  elem: string,
): boolean {
  const valIx = objFieldVal(objIx, fname)
  if valIx < 0 { return true }
  const v = P.nodes[unwrapParen(valIx)]
  if v is ObjLit {
    const si = structIndexByName(elem)
    if si < 0 { return true }
    if v.objFields.length != sFieldCount[si] { return false }
    let fi = 0
    while fi < sFieldCount[si] {
      if objFieldVal(valIx, sFieldNames[sFieldStart[si] + fi]) < 0 {
        return false
      }
      fi = fi + 1
    }
  }
  true
}

// The variant struct name an object literal at `objIx` matches: the union variant whose
// field-name set equals the literal's field names (order-independent), or "" if none. A
// map-typed candidate field is further tightened by its value rep, so two unions' arms
// sharing field names but differing in map value type cannot collide onto the wrong slot.
export function objVariantName(objIx: i32) {
  const o = P.nodes[objIx]
  if o is ObjLit {
    let vi = 0
    while vi < uVariants.length {
      if objMatchesVariantIdx(objIx, vi) { return uVariants[vi] }
      vi = vi + 1
    }
  }
  ""
}

// Whether the object literal at `objIx` matches variant `vi`: the field-name set equals
// the variant's (order-independent), tightened per field by the value rep — a map field
// by `objMapFieldCompat`, a nested-struct field by `objNestedFieldCompat`. The one matcher
// behind both `objVariantName` and `unionArmVariantForObj`, so the two never diverge.
function objMatchesVariantIdx(objIx: i32, vi: i32): boolean {
  const o = P.nodes[objIx]
  if o is ObjLit {
    const cnt = uFieldCount[vi]
    if cnt != o.objFields.length { return false }
    const start = uFieldStart[vi]
    let allMatch = true
    let fj = 0
    while fj < cnt {
      if objFieldVal(objIx, uFieldNames[start + fj]) < 0 {
        allMatch = false
      } else if uFieldTypes[start + fj] == 19 {
        if (
          !objMapFieldCompat(
            objIx,
            uFieldNames[start + fj],
            uFieldElemName[start + fj],
          )
        ) {
          allMatch = false
        }
      } else if uFieldTypes[start + fj] == 15 {
        // A nested-struct candidate field (code 15) is tightened by its target's
        // field-name set, exactly as a map field is by its value rep.
        if (
          !objNestedFieldCompat(
            objIx,
            uFieldNames[start + fj],
            uFieldElemName[start + fj],
          )
        ) {
          allMatch = false
        }
      }
      fj = fj + 1
    }
    return allMatch
  }
  false
}

// Does the union registered under `set` carry a struct arm — a variant a `{…}` value could
// be stored as? Refutation-only: an unregistered set answers yes, since a helper that refutes
// must never refute on ignorance. `unVarCount == 0` is the one positive fact this can state —
// a union of atoms alone (`i32 | null`) has nowhere to put a struct.
function unionSetCanHoldStruct(set: string): boolean {
  const u = unionRowOf(set)
  if u < 0 { return true }
  unVarCount[u] > 0
}

// The variant-table index of the arm of the union whose registered member set is
// `unionSet` that the object literal at `objIx` matches, or -1. Union-context-restricted:
// the global `objVariantName` scan could land on another union's arm sharing field names,
// silently boxing the wrong tag. Falls back to -1 when `unionSet` is not a registered union.
export function unionArmVariantForObj(unionSet: string, objIx: i32): i32 {
  let u = 0
  while u < unNames.length {
    if unNames[u] == unionSet || unMemberSet[u] == unionSet {
      let vi = unVarStart[u]
      while vi < unVarStart[u] + unVarCount[u] {
        if objMatchesVariantIdx(objIx, vi) { return vi }
        vi = vi + 1
      }
      return -1
    }
    u = u + 1
  }
  -1
}

// True if the plain struct at table index `ssi` has the same field layout (name set, count,
// per-field type code) as the union-variant arm `vi` — the struct-index dual of
// `objMatchesVariantIdx`. Recognizes a struct-typed value (an ident/call result, built as a
// distinct heap type from the arm's variant struct) as a union member so it can be re-boxed.
function structIdxMatchesVariantIdx(ssi: i32, vi: i32): boolean {
  if ssi < 0 { return false }
  // The bound this parallel-table read lacked: an unguarded read past these arrays traps the
  // compiler instead of surfacing the diagnostic `emitFail` already recorded.
  if ssi >= sFieldCount.length { return false }
  if vi < 0 { return false }
  if vi >= uFieldCount.length { return false }
  const cnt = uFieldCount[vi]
  if cnt != sFieldCount[ssi] { return false }
  const start = uFieldStart[vi]
  let fj = 0
  while fj < cnt {
    const fname = uFieldNames[start + fj]
    const sfi = sFieldIndex(ssi, fname)
    if sfi < 0 { return false }
    if sFieldTypeAt(ssi, sfi) != uFieldTypes[start + fj] { return false }
    fj = fj + 1
  }
  true
}

// The union variant arm (of `unionSet`) whose struct layout matches the struct-typed
// expression at `exprIx`, or -1 — the struct-expression dual of `unionArmVariantForObj`: a
// struct-typed ident/call result is built as its own plain struct, a layout twin of but
// distinct type from the variant struct, so the emitter re-boxes it against the matched arm.
export function unionArmVariantForStructExpr(
  unionSet: string,
  exprIx: i32,
  fnIx: i32,
): i32 {
  const ssi = structIndexOfExpr(exprIx, fnIx)
  if ssi < 0 { return -1 }
  let u = 0
  while u < unNames.length {
    if unNames[u] == unionSet || unMemberSet[u] == unionSet {
      let vi = unVarStart[u]
      while vi < unVarStart[u] + unVarCount[u] {
        if structIdxMatchesVariantIdx(ssi, vi) { return vi }
        vi = vi + 1
      }
      return -1
    }
    u = u + 1
  }
  -1
}

// True if re-evaluating the expression at `exprIx` is side-effect-free and yields the same
// value — an ident (local/param/global/captured), a parenthesized such, or a pure
// field/index navigation of one. A call is not re-readable (its effects, and any
// allocation, would fire again). Gates the field-copy variant re-box, re-emitted per field.
export function exprReReadable(exprIx: i32): boolean {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Ident { return true }
  if e is Paren { return exprReReadable(e.parInner) }
  if e is Member { return exprReReadable(e.memObj) }
  if e is Index {
    return exprReReadable(e.idxArr) && exprReReadable(e.idxIndex)
  }
  false
}

// ── array-typedness of expressions ──────────────────────────────────────────────

// Parallel to the struct family above: decide whether an expression / param / local
// produces the i32 array (a `(ref $aTypeIdx)`) rather than an i32. An index read
// `a[i]` and `a.length` are i32 (not arrays), so they are deliberately absent here.

// True if the function `name` declares an array (`i32[]`) as its return type.
function fnRetArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "list"
}

// True if the already-collected declared local `name` is an i32-array ref (code `2`).
function declaredArray(name: string) { declaredKind(name) == "list" }

// The shared-field plan over an un-narrowed struct union — `(A | B).tag`, where the checker
// proved the field present on every member. Fills `outVis`/`outFis` with each member's
// variant index and its index for this field, in box-tag order, and returns the one field
// code they all carry. -1 when any member lacks the field or the codes disagree.
export function sharedUnionFieldPlan(
  recvIx: i32,
  prop: string,
  fnIx: i32,
  outVis: i32[],
  outFis: i32[],
): i32 {
  if !exprUnion(recvIx, fnIx) { return -1 }
  const recv = P.nodes[unwrapParen(recvIx)]
  // The receiver need not be an ident — a non-ident receiver's re-evaluation is handled by
  // the emitter's lazy-frame stash; what's decided here is only the narrowed-set typing.
  let set = ""
  let setId = -1
  if recv is Ident {
    set = currentStructNarrowSetOf(recv.identName, fnIx)
    setId = currentStructNarrowSetIdOf(recv.identName, fnIx)
  } else {
    set = unionMemberSetOf(unionNameOfExpr(recvIx, fnIx))
    setId = msSetOfText(set)
  }
  if set == "" { return -1 }
  const atoms: string[] = []
  if (!msMemberAtomsOfSet(setId, atoms)) { splitUnionAtoms(set, atoms) }
  if atoms.length < 2 { return -1 }
  let code = -1
  let i = 0
  while i < atoms.length {
    // `variantIndexOfTypeName` (D1083), not the exact `variantIndexOf`: the atoms here can be
    // structural renders (a narrowed complement's fallback), which `variantIndexOf` can't match.
    const vi = variantIndexOfTypeName(atoms[i])
    if vi < 0 { return -1 }
    const fi = variantFieldIndex(vi, prop)
    if fi < 0 { return -1 }
    const fc = variantFieldTypeAt(vi, fi)
    if code < 0 { code = fc }
    else if code != fc { return -1 }
    outVis.push(vi)
    outFis.push(fi)
    i = i + 1
  }
  code
}

// The wasm-type code of the struct/variant field a `Member` expression at `memIx` reads
// (`0` i32, `3` string, `4` i32-list, `5` ref-list), or `-1` if not a known field read.
// Mirrors `exprString`'s Member dispatch: a narrowed union identifier reads the variant
// field's type; otherwise the receiver's struct field's type — drives array-field reads.
function memFieldTypeCode(memIx: i32, fnIx: i32) {
  const e = P.nodes[memIx]
  if e is Member {
    if memIsNarrowed(memIx) {
      const vi = memNarrowVariantIndex(memIx)
      if vi >= 0 {
        const vfi = variantFieldIndex(vi, e.memProp)
        if vfi >= 0 { return variantFieldTypeAt(vi, vfi) }
      }
      return -1
    }
    // A field read on a variant-typed param `o.field` reads the variant struct's field type
    // directly, off the unboxed param rather than a `narrowName` ident.
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 { return variantFieldTypeAt(pvi, pvfi) }
    }
    // The fifth receiver shape — `memRecvNulVariantIndex`'s own header states what it costs.
    const nvi5 = memRecvNulVariantIndex(e.memObj, fnIx)
    if nvi5 >= 0 {
      const nvfi5 = variantFieldIndex(nvi5, e.memProp)
      if nvfi5 >= 0 { return variantFieldTypeAt(nvi5, nvfi5) }
    }
    const si = structIndexOfExpr(e.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.memProp)
      if fi >= 0 { return sFieldTypeAt(si, fi) }
    }
    // The fourth receiver shape: an un-narrowed struct union whose members all carry the
    // field at one code (`(A | B).tag`) — without it, a shared read classified as i32.
    const uvis: i32[] = []
    const ufis: i32[] = []
    const ucode = sharedUnionFieldPlan(e.memObj, e.memProp, fnIx, uvis, ufis)
    if ucode >= 0 { return ucode }
  }
  -1
}

// True when the ident `name`, read inside frame `fnIx`, is shadowed by a binding of the
// frame itself — a declared param, or a collected declared local. The `expr*Array` global
// fallbacks must not resolve `name` through a module global when such an inner binding
// exists, since scope resolution picks the inner binding regardless of its kind. #922.
function identShadowedByFrame(fnIx: i32, name: string) {
  if paramIndexOf(fnIx, name) >= 0 { return true }
  declaredSlotOf(name) >= 0
}

export function exprArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyKindOf(nodeTyIxOf(exprIx)) == 2 {
    return true // typed-IR fast path (see exprIsF64)
  }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return !arrLitIsRef(exprIx) }
  if e is Paren { return exprArray(e.parInner, fnIx) }
  if e is Call {
    // An INDEXED closure call `fs[i](x)` whose element signature returns `i32[]`.
    if cloArrCallRetKind(exprIx, fnIx) == "list" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      // The intrinsic allocators yield an i32 list unless the fill is f64
      // (`arrNewIntrKind` 1 — then `exprF64Array` claims the call).
      if arrNewIntrKind(exprIx, fnIx) == 0 { return true }
      if fnRetArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-value call (`g(x)` with `g: (i32) => i32[]`) whose resolved sig result is
      // the i32 list, so `const xs = g(x)` types `xs` as a list.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "list"
    }
    // `xs.map(f)`/`xs.filter(p)` yield a new list — the i32 list exactly when the result
    // element kind is i32/boolean.
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "i32"
    }
    // `xs.slice(...)` yields the same list kind as its receiver — an i32 list iff the
    // receiver is one.
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "i32"
    }
    // `m.values()` over an i32-valued map yields an i32 list.
    if mapValuesResultKind(exprIx, fnIx) == 2 { return true }
    // `m.keys()` over the i32-KEYED rep yields an i32 list of its keys — the twin of
    // the string-keyed `.keys()` claimed by the string-list classifier.
    const kc32 = P.nodes[e.callFn]
    if kc32 is Member {
      if kc32.memProp == "keys" {
        if exprMap(kc32.memObj, fnIx) {
          if mapShapeKeyI32(mapShapeOfExpr(kc32.memObj, fnIx)) { return true }
        }
      }
    }
    return false
  }
  if e is Ident {
    // A value-union ident narrowed to a kind-7 i32-backed list atom classifies as an i32
    // list first, since the binding's declared type is the union, not a plain list.
    if unionIdentReadKind(exprIx, fnIx) == 7 { return true }
    if valueAtomKind(narrowedValueAtomOf(e.identName)) == 7 { return true }
    if paramArray(fnIx, e.identName) { return true }
    if declaredArray(e.identName) { return true }
    if globalIsArraySid(fnIx, sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A nullable i32-list binding (kind 15) participates in the list machinery — narrowing
    // is type-level, so every list op classifies the read as a list.
    if paramNulList(fnIx, e.identName) { return true }
    if declaredNulList(e.identName) { return true }
    if globalIsNulListSid(fnIx, sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED i32-list read (`store[k]` inside a closure capturing `store`).
    return capturedKindOf(fnIx, e.identName) == "list"
  }
  // A list CONCAT `a + b` yields a NEW i32 list (collections-design §VL.4).
  if e is BinExpr {
    if e.binOp == "+" {
      if (
        exprArray(e.binLeft, fnIx) &&
        !exprStringArray(e.binLeft, fnIx) &&
        !exprRefArray(e.binLeft, fnIx)
      ) {
        return exprArray(e.binRight, fnIx)
      }
    }
    // `m[k] ?? d` over an i32-LIST-valued map (`{[string]: i32[]}`) yields the value i32 list.
    if e.binOp == "??" {
      if mvListValKind(coalesceMvSlot(exprIx, fnIx)) == "list" { return true }
      // The non-map `p ?? d` over the i32-list niche is the i32-list wrapper in both halves —
      // only nullability changes, matching `exprNullableList`'s own `??` arm.
      if exprNullableList(e.binLeft, fnIx) { return true }
    }
    return false
  }
  // A field read `p.items` whose struct field is an `i32[]` (code 4) yields the i32 list
  // wrapper ref; a nullable list field (code 18) classifies the same way.
  if e is Member {
    if memFieldTypeCode(exprIx, fnIx) == 4 { return true }
    if memFieldTypeCode(exprIx, fnIx) == 18 { return true }
  }
  // `m[i]` over an `i32[][]` ref list (element kind 4) yields the INNER i32 list,
  // so a chained `m[i][j]` / `m[i].length` treats it as a list.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 4) { return true }
    // A bare `m[k]` over an i32-LIST-valued map yields the value i32 list (`V | null` — the
    // list machinery recovers non-null at the read site).
    if mvListValKind(mapReadMvSlot(exprIx, fnIx)) == "list" { return true }
  }
  false
}

// True if the `LetDecl` at `letIx` declares an array-typed local: its annotation is an
// array type (`i32[]`), OR its initializer produces an array. Picks the local's
// valtype (`(ref $aTypeIdx)` vs i32) in `collectLocals`.
export function letIsArray(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // Arena-first: where the checker's arena decides the annotation's rep, this is "is
      // that rep the i32 list" with no name parse; the arena's uncovered spellings fall through.
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "list" { return true }
      } else {
        // Kept for the shapes the arena leg declines (an inline litunion element, the
        // `(boolean|null)[]`/`(K|null)[]` niches) — unreached here is corpus-unreachable, not dead.
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsI32Array(lt.tyName) { return true }
        }
      }
    }
    return exprArray(d.letInit, fnIx)
  }
  false
}

// ── ref-array-typedness of expressions (G7-ref) ─────────────────────────────────

// Parallel to the i32-array family: decide whether an expression / param / local produces
// a ref list — `Tok[]` / `Node[]`, a `(ref $rlTypeIdx)`. Receiver shapes mirror `exprArray`
// but for `S[]`/`N[]` annotations. `localIsRef` code `5` flags a ref-list local.

// True if function `name` declares a ref array (`S[]`/`N[]`) as its return type.
function fnRetRefArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "reflist"
}

// True if the parameter `name` of function `fnIx` is a ref-array type.
function paramRefArray(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  // STRUCTURAL fast-path (C1): a recorded array-of-declared-struct param, else the name test.
  if nodeTyIsStructArray(pt) { return true }
  // A ref-list row for the param's element — covers the nested/union/closure/niche
  // element spellings the struct-array fast path declines (non-nullable only).
  annBareRefArrSlot(pt) >= 0
}

// True if the parameter `name` of function `fnIx` is a NULLABLE ref-array type (`<ref-array> | null`,
// kind 18 — e.g. `i32[][] | null`, `S[] | null`). The param analogue of `paramRefArray`: `retNulRefArrFlag`
// (already `| null`-aware) recognizes the annotation. Lets `exprNullableRefArray` / `exprRefArray` classify
// a nulreflist PARAM (its `!= null` narrow + narrowed indexing), which #877 wired only for a LOCAL.
function paramNulRefArray(fnIx: i32, name: string) {
  retNulRefArrFlag(paramTypeNode(fnIx, name)) == 1
}

// True if the already-collected declared local `name` is a ref-list ref (code `5`).
function declaredRefArray(name: string) { declaredKind(name) == "reflist" }

// True if evaluating the expression at `exprIx` yields a ref list: a ref-element array
// literal, a ref-array-returning call, a ref-array param/local reference, or a
// parenthesized ref-array expression. An index read / `.length` is NOT a list.
export function exprRefArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitIsRef(exprIx) }
  if e is Paren { return exprRefArray(e.parInner, fnIx) }
  // `m[k]` / `m[k] ?? d` over a struct-LIST-valued map yields a struct ref list.
  if mapReadListKind(exprIx, fnIx) == "reflist" { return true }
  if e is Call {
    // `__array_new__(n, {…})` builds a ref list of the element struct (kind 3).
    if arrNewIntrKind(exprIx, fnIx) == 3 { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetRefArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-VALUE callee returning a ref list (`mk: () => S[]`) — its resolved `$fnsig`
      // result is the ref-list wrapper (`>r<slot>;`), so `mk()[i]` indexes it directly.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "reflist"
    }
    // A `.filter` over a struct/union array yields the SAME ref list (kind 2).
    if callee is Member {
      if mfResultKindOf(exprIx, fnIx) == "ref" { return true }
    }
    // `m.values()` over a struct- / nested-list- / nested-map-valued map yields a ref list.
    if mapValuesResultKind(exprIx, fnIx) == 5 { return true }
    // General fallback for a value call the resolvers above miss (a narrowed closure arm, a
    // struct-field or indexed-element closure): resolves via `$fnsig`, mirroring the call emit.
    const gk = cloCallSigKey(exprIx, fnIx)
    if sigKeyRetKind(gk) == "reflist" {
      const gs = sigKeyRetSlot(gk)
      if gs >= 0 && gs < rlElemKindTbl.length { return true }
    }
    return false
  }
  if e is Ident {
    // A union binding narrowed to a ref-element array arm unboxes to the reflist wrapper, so
    // it is a ref array in the narrowed branch — checked first, ahead of its declared type.
    if narrowedRefArrayOf(e.identName) != "" { return true }
    // A kind-18 NULLABLE ref-array local is a ref array too (narrowed `if t != null`) — so indexing /
    // `.length` reuse the ref-array machinery; the index emit recovers non-null for the niche receiver.
    if declaredKind(e.identName) == "nulreflist" { return true }
    // A nulreflist PARAM narrowed non-null is a ref array too — index / `.length` reuse the
    // ref-array machinery (the index emit recovers non-null for the niche receiver).
    if paramNulRefArray(fnIx, e.identName) { return true }
    if paramRefArray(fnIx, e.identName) { return true }
    if declaredRefArray(e.identName) { return true }
    // A captured ref-array is the fourth storage class, asked of the function that typed the
    // env field so the read cannot disagree — checked ahead of the shadow test and global arms.
    if capturedRefListSlot(fnIx, e.identName) >= 0 { return true }
    if identShadowedByFrame(fnIx, e.identName) { return false }
    // A kind-18 nullable ref-array global is a ref array too — without this, an empty-`[]`
    // init misclassified as an i32 list (invalid wasm) and a `null` init matched no classifier.
    if globalIsNulRefArraySid(fnIx, sidOfNode(exprIx)) { return true }
    return globalIsRefArraySid(fnIx, sidOfNode(exprIx))
  }
  // A field read `p.items` whose struct field is a `T[]`/`N[]` (code `5`) yields the ref
  // list wrapper ref — so `.length` / indexing / assignment treat it as a ref list.
  if e is Member {
    // A union-box field narrowed to a ref-element array arm unboxes to that arm's reflist
    // wrapper, so it is a ref array in the narrowed branch — the Ident arm's rule. D1014.
    if narrowedRefArrayOfPlace(exprIx) != "" { return true }
    if memFieldTypeCode(exprIx, fnIx) == 5 { return true }
    if exprNullableRefArray(exprIx, fnIx) { return true }
  }
  // Indexing a nested ref array (`g[i]` where `g: S[][]`): each element is the inner ref
  // list, so the index yields a ref array too — recurses for deeper nesting.
  if e is Index {
    // A union-box ELEMENT whose index PLACE is narrowed to a ref-element array arm
    // (`if xs[0] is K[]`) — the index twin of the Member arm above (D1014).
    if narrowedRefArrayOfPlace(exprIx) != "" { return true }
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        return rlElemKindTbl[slot] == 9
      }
    }
  }
  // `p ?? d` over the `<ref-array> | null` niche is the ref-list wrapper in both halves —
  // only nullability changes, matching the kind-18 Ident arms above.
  const raLhs = coalesceNicheLhs(exprIx)
  if raLhs >= 0 {
    if exprNullableRefArray(raLhs, fnIx) { return true }
  }
  // A list concat `a + b` yields a new list of the operands' own rep. Must ask itself, not
  // a shared classifier — routing through one would cost 14^depth on a left-nested chain. D721.
  if e is BinExpr {
    if e.binOp == "+" {
      if exprRefArray(e.binLeft, fnIx) { return exprRefArray(e.binRight, fnIx) }
    }
  }
  false
}

// The ref-list ELEMENT type-NAME a ref-array param `name` of function `fnIx` declares
// (`p: Tok[]` → `Tok`), or "" if not a ref-array param.
function paramRefArrayName(fnIx: i32, name: string) {
  if fnIx < 0 {
    return "" // module-scope initializer (no enclosing function)
  }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            const ty = P.nodes[p.parType]
            // `refArrElemNameIf` (the `nameIsRefArray`-gated element read): its "" for a
            // non-ref-array annotation is the same "" the next line returns.
            if ty is TypeRef { return refArrElemNameIf(ty.tyName) }
          }
          return ""
        }
      }
      i = i + 1
    }
  }
  ""
}

// The ref-list ELEMENT type-NAME a function `name` returns (from its `S[]`/`N[]` return
// annotation, recorded in `fRetRArrElem`), or "".
function fnRetRefArrayNameSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return "" }
  fRetRArrElem[i]
}

// The INNER ref-list element type-NAME a function `name` returns when its return is a NULLABLE ref array
// (`i32[][] | null` → the inner `i32[]`), else "". Reads the return-type node directly (`fRetRArrElem`
// records only the NON-null ref-array element), so a consumer `const t = mk()` infers the kind-18 niche
// and its `!= null` narrow + narrowed indexing resolve the inner ref-list slot.
function fnRetNulRefArrayNameSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return "" }
  const fn = P.nodes[fnStmts[i]]
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      // The `np != ""` conjunct is kept rather than folded in: `nameIsRefArray("")` is not
      // free (an arrow scan and a full shape ladder), so the short-circuit stays.
      const np = nullablePartOf(tyNameOf(fn.fnRet))
      if np != "" { return refArrElemNameIf(np) }
    }
  }
  ""
}

// The ref-list ELEMENT type-NAME of the declared local `name` (recorded in
// `localStructIdx` as its table SLOT for code-5 locals), or "".
function declaredRefArrayName(name: string) {
  const i = declaredSlotOf(name)
  if i >= 0 {
    if localIsRef[i] == "reflist" {
      const slot = localStructIdx[i]
      if slot >= 0 {
        if slot < rlElemName.length { return rlElemName[slot] }
      }
    }
  }
  ""
}

// The ref-list ELEMENT type-NAME a module global `name` declares (`S[]`/`N[]`), or "".
function globalRefArrayName(fnIx: i32, name: string) {
  const li = globalLetOfIn(fnIx, name)
  if li < 0 { return "" }
  letRefListElemName(li, -1)
}

// The annotation NAME the instance `fnIx` carries for the identifier at `exprIx`, or "".
// A monomorphized clone rebuilds only its statement spine, so a shared leaf expression's
// recorded type is still the template's `T`; the instance's own parameter or `LetDecl`
// annotation is the one channel that answers per instance (D1605).
function instAnnTyNameOfExpr(exprIx: i32, fnIx: i32): string {
  if fnIx < 0 { return "" }
  const ax = unwrapParen(exprIx)
  if ax < 0 { return "" }
  const an = P.nodes[ax]
  if an is Ident {
    const pt = paramTypeNode(fnIx, an.identName)
    if pt >= 0 { return tyNameOf(pt) }
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOf(fn.fnBody, an.identName)
      if li >= 0 {
        const ld = P.nodes[li]
        if ld is LetDecl { return tyNameOf(ld.letType) }
      }
    }
  }
  ""
}

// The ref-list ELEMENT type-NAME the expression at `exprIx` produces, or "" if it is not
// a ref list. Mirrors `exprRefArray`'s receiver shapes, resolving the per-element-
// type table slot (`refListSlotOfExpr`) at every push / index / `.length` / store site.
export function refListElemNameOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return "" }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitElemName(exprIx) }
  if e is Paren { return refListElemNameOfExpr(e.parInner, fnIx) }
  // `m[k]` / `m[k] ?? d` over a struct-LIST-valued map — the element is the value's struct.
  const slsMv = mapReadStructListMvSlot(exprIx, fnIx)
  if slsMv >= 0 { return refArrElemName(mvValName[slsMv]) }
  if e is Call {
    // `__array_new__(n, {…})` — the ref-list element name is the fill's struct.
    if arrNewIntrKind(exprIx, fnIx) == 3 {
      const asi = structIndexOfExpr(e.callArgs[1], fnIx)
      if asi >= 0 { return sNames[asi] }
      // The fill's own recorded type, then the instance's annotation for it. A
      // monomorphized clone shares this call node, so the recorded type is still the
      // template's `T` and only the instance can name the element; `""` reaches the
      // caller's strict slot and refuses, rather than taking another element's row (D1605).
      const anTy = tyToEmitName(nodeTyIxOf(e.callArgs[1]))
      if anTy != "" { return anTy }
      return instAnnTyNameOfExpr(e.callArgs[1], fnIx)
    }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const fn = fnRetRefArrayNameSid(sidOfNode(e.callFn))
      if fn != "" { return fn }
      // A nulreflist-returning function (`mk: () => i32[][] | null`): the INNER ref-list element name.
      const nfn = fnRetNulRefArrayNameSid(sidOfNode(e.callFn))
      if nfn != "" { return nfn }
      // A closure-value callee returning a ref list: its element name is the `rlElemName` of
      // the result slot parsed off the callee's resolved `$fnsig`.
      const ck = calleeCloSigKeySid(sidOfNode(e.callFn), fnIx)
      if sigKeyRetKind(ck) == "reflist" {
        const rs = sigKeyRetSlot(ck)
        if rs >= 0 && rs < rlElemName.length { return rlElemName[rs] }
      }
      // A narrowed union binding's closure arm: the name-based path misses it, so the general
      // `cloCallSigKey` fallback derives the key from the callee's checker type instead.
      const nk = cloCallSigKey(exprIx, fnIx)
      if sigKeyRetKind(nk) == "reflist" {
        const nrs = sigKeyRetSlot(nk)
        if nrs >= 0 && nrs < rlElemName.length { return rlElemName[nrs] }
      }
      return ""
    }
    // A ref-valued `m.values()` yields a ref list whose element is the map's value — read its
    // name off the value's mv ref-list slot, checked before the `.filter` result-slot path.
    if callee is Member {
      if callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) {
          const vsh = mapShapeOfExpr(callee.memObj, fnIx)
          if vsh >= 0 {
            const rs = mvRlSlot[vsh]
            if rs >= 0 { return rlElemName[rs] }
          }
        }
      }
      // Bound-guarded like the other reads in this function: `mfResultSlotOf` clamps a miss to
      // 0 rather than -1, so an unbounded `rlElemName[ms]` traps the compiler on an empty table. D227.
      const ms = mfResultSlotOf(exprIx, fnIx)
      if ms >= 0 && ms < rlElemName.length { return rlElemName[ms] }
    }
    // A struct-field or indexed closure-array element call whose result is a ref list: the
    // resolved `$fnsig` result slot names the element, mirroring the Ident-callee arm above.
    const mk2 = cloCallSigKey(exprIx, fnIx)
    if sigKeyRetKind(mk2) == "reflist" {
      const mrs2 = sigKeyRetSlot(mk2)
      if mrs2 >= 0 && mrs2 < rlElemName.length { return rlElemName[mrs2] }
    }
    return ""
  }
  if e is Ident {
    // A union binding NARROWED to a ref-element array arm (`if x is S[]` then `x[i]`): its element
    // name is the arm's, so `refListSlotOfExpr` resolves the wrapper the narrowed read casts to.
    const raN = narrowedRefArrayOf(e.identName)
    if raN != "" { return refArrElemName(raN) }
    // A kind-18 nullable ref-array local stores its INNER ref-list slot in `localStructIdx`; its element
    // name is that inner slot's element name, so `refListSlotOfExpr` round-trips back to the inner slot.
    if declaredKind(e.identName) == "nulreflist" {
      const sl18 = declaredSlotOf(e.identName)
      if sl18 >= 0 {
        const is18 = localStructIdx[sl18]
        if is18 >= 0 && is18 < rlElemName.length { return rlElemName[is18] }
      }
    }
    // A nulreflist param's inner ref-list element name is the ref-array's element (the
    // `| null`-stripped annotation), so `refListSlotOfExpr` resolves the narrowed inner wrapper.
    if paramNulRefArray(fnIx, e.identName) {
      const np18 = nullablePartOf(tyNameOf(paramTypeNode(fnIx, e.identName)))
      if np18 != "" { return refArrElemName(np18) }
    }
    const pn = paramRefArrayName(fnIx, e.identName)
    if pn != "" { return pn }
    const dn = declaredRefArrayName(e.identName)
    if dn != "" { return dn }
    // A captured ref-array's element name is the `rlElemName` of the slot the env field is
    // typed with — the storage-class mirror of `exprRefArray`'s capture arm.
    const cn = capturedRefListSlot(fnIx, e.identName)
    if cn >= 0 && cn < rlElemName.length { return rlElemName[cn] }
    // A kind-18 nullable ref-array global reads its inner ref-list row off the annotation —
    // `globalRefArrayName` below can't, since it falls through to a nameless `[]`/`null` init.
    if globalIsNulRefArraySid(fnIx, sidOfNode(exprIx)) {
      const g18 = globalLetOfIn(fnIx, e.identName)
      const gs18 = letAnnRefListSlot(g18)
      if gs18 >= 0 && gs18 < rlElemName.length { return rlElemName[gs18] }
    }
    return globalRefArrayName(fnIx, e.identName)
  }
  if e is Member {
    // The member path's own narrowing first (D1014): a narrowed ref-element arm names the
    // arm's element, ahead of the receiver-narrowing arm below (a different question).
    const raPm = narrowedRefArrayOfPlace(exprIx)
    if raPm != "" { return refArrElemName(raPm) }
    // A `recv.field` ref-list field read — the field's element name from the receiver's
    // struct / narrowed variant.
    if memIsNarrowed(exprIx) {
      const vi = memNarrowVariantIndex(exprIx)
      if vi >= 0 {
        const vfi = variantFieldIndex(vi, e.memProp)
        if vfi >= 0 { return uFieldElemName[uFieldStart[vi] + vfi] }
      }
      return ""
    }
    const si = structIndexOfExpr(e.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.memProp)
      if fi >= 0 { return sFieldElemNameAt(si, fi) }
    }
  }
  // Indexing a nested ref array (`g[i]` where `g: S[][]`): the element strips one `[]` off
  // `g`'s element name — recurses for deeper nesting.
  if e is Index {
    // The index place's own narrowing to a ref-array arm (D1014) — distinct from the
    // nullable-niche narrowing below it, which peels a `| null` off the cell's own name.
    const raPi = narrowedRefArrayOfPlace(exprIx)
    if raPi != "" { return refArrElemName(raPi) }
    // A narrowed index over a nullable-ref-array element resolves via `nulRefArrayInnerSlot`,
    // gated on the ref-array shape so an unrelated nullable-string cell can't borrow the row. D451.
    if indexElemNulRefArrayName(unwrapParen(exprIx), fnIx) != "" {
      if narrowVariantFor(indexPathKeyOf(exprIx)) != "" {
        const nin = nulRefArrayInnerSlot(unwrapParen(exprIx), fnIx)
        if nin >= 0 && nin < rlElemName.length { return rlElemName[nin] }
      }
    }
    const outer = refListElemNameOfExpr(e.idxArr, fnIx)
    if outer != "" && nameIsArray(outer) { return refArrElemName(outer) }
  }
  // `p ?? d` over a `<ref-array> | null` niche resolves via the niche's own inner-slot resolver
  // first — the plain recursion alone misses an `Index`'s `| null`-suffixed element name.
  const rlnLhs = coalesceNicheLhs(exprIx)
  if rlnLhs >= 0 {
    const rlnIn = nulRefArrayInnerSlot(rlnLhs, fnIx)
    if rlnIn >= 0 && rlnIn < rlElemName.length { return rlElemName[rlnIn] }
    return refListElemNameOfExpr(rlnLhs, fnIx)
  }
  // A ref-list concat yields a new list at the operands' own slot — skipping this, the slot-0
  // clamp reads a wrong row as real. Both operands must agree, or there is no single slot. D721.
  if e is BinExpr {
    if e.binOp == "+" {
      const cl = refListElemNameOfExpr(e.binLeft, fnIx)
      if cl != "" {
        if cl == refListElemNameOfExpr(e.binRight, fnIx) { return cl }
      }
    }
  }
  ""
}

// The per-element-type ref-list table SLOT the expression at `exprIx` produces, or 0
// (slot fallback) if the element type can't be resolved — every migrated site uses this
// to pick the right backing/wrapper/element indices.
export function refListSlotOfExpr(exprIx: i32, fnIx: i32) {
  const nm = refListElemNameOfExpr(exprIx, fnIx)
  const s = rlSlotByName(nm)
  if s < 0 { return 0 }
  s
}

// `refListSlotOfExpr` without the clamp — -1 where the element name does not resolve. The
// clamp to 0 is right for a consumer that must name some wrapper; it is wrong for one deciding
// whether two rows differ, since slot 0 is a real row and "unresolved" would read as "the
// first one interned" — the hazard a widening over this file must not reintroduce. D791.
export function refListSlotOfExprStrict(exprIx: i32, fnIx: i32): i32 {
  const nm = refListElemNameOfExpr(exprIx, fnIx)
  if nm == "" { return -1 }
  rlSlotByName(nm)
}

// The ref-list row the value of `exprIx` is actually emitted at, or -1 — only an identifier,
// a call, a field read or an index answers. Unlike `refListSlotOfExprStrict` (which answers
// the row the element spelling names), this reads the row the emitter actually put the value
// in, since a shadowed global or a literal already built at a destination's row can differ. D791.
export function exprEmittedRefListSlot(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const inner = unwrapParen(exprIx)
  if inner < 0 || inner >= P.nodes.length { return -1 }
  const e = P.nodes[inner]
  if e is Ident {
    const sl = declaredSlotOf(e.identName)
    if sl >= 0 {
      if declaredKind(e.identName) != "reflist" { return -1 }
      if sl >= localStructIdx.length { return -1 }
      return localStructIdx[sl]
    }
    const pn = paramRefArrayName(fnIx, e.identName)
    if pn != "" { return rlSlotByName(pn) }
    const g = globalLetOfIn(fnIx, e.identName)
    if g >= 0 {
      if globalCellKind(g) != "reflist" { return -1 }
      return globalRefListSlot(g)
    }
  }
  // A call result's row is the callee's own declared return, not the "spelling" this function
  // otherwise refuses — a callee's return annotation is what its own emit is typed from. The
  // same lookup (`rlSlotByName` off `fRetRArrElem`) the parameter arm above already trusts,
  // for the identical reason: a param's row comes from its annotation too. D794.
  if e is Call {
    const callee = P.nodes[unwrapParen(e.callFn)]
    if callee is Ident {
      const cn = fnRetRefArrayNameSid(sidOfNode(e.callFn))
      if cn != "" { return rlSlotByName(cn) }
    }
  }
  // A field read's row is the struct table's, from the field's own storage slot — inlined here
  // since `sFieldRefSlot` lives downstream in the emitter.
  if e is Member {
    const msi = structIndexOfExpr(e.memObj, fnIx)
    if msi >= 0 {
      const mfi = sFieldIndex(msi, e.memProp)
      if mfi >= 0 {
        const mty = sFieldElemTyIxAt(msi, mfi)
        const ma = rlSlotOfTy(mty)
        if ma >= 0 { return ma }
        return rlSlotByNameTy(sFieldElemNameAt(msi, mfi), mty)
      }
    }
  }
  // An indexed read's row is the outer list's element slot, read strictly (not clamped) since
  // a bare-scalar array answering nothing must not fall back to a real, unrelated slot. D1500.
  if e is Index {
    const osl = refListSlotOfExprStrict(e.idxArr, fnIx)
    if osl >= 0 { return rlElemInnerSlot(osl) }
  }
  -1
}

// The `pendingListKind` an expression's list cell demands — the same 0-7 vocabulary
// `tyAnnRefListKind` produces from an annotation node, for positions with no annotation node
// left to read (a compiled-away local, a param on the `FuncDecl`). Order mirrors
// `tyAnnRefListKind`'s: ref-list row first, then nullable scalar backings, then non-null scalars.
export function exprListCellBuildKind(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  if exprRefArray(exprIx, fnIx) || exprNullableRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlElemKindTbl.length {
      if rlElemKindTbl[s] == 2 { return 2 }
      if rlElemKindTbl[s] == 5 { return 5 }
    }
    return 1
  }
  // `string[] | null`, `f64[] | null`, `i64[] | null`, `f32[] | null` — the DISTINCT-backing
  // niches, mapped by the one home the call-argument and global-assign boundaries also read.
  const nsk = exprNulScalarListKind(exprIx, fnIx)
  if nsk != null { return nulScalarListBuildKind(nsk) }
  if exprStringArray(exprIx, fnIx) { return 3 }
  if exprF64Array(exprIx, fnIx) { return 4 }
  if exprI64Array(exprIx, fnIx) { return 6 }
  if exprF32Array(exprIx, fnIx) { return 7 }
  0
}

// The `pendingListSlot` twin of `exprListCellBuildKind` — WHICH ref-list element row the
// cell holds. `0` (the slot fallback `refListSlotOfExpr` itself returns) for a non-ref list,
// matching `tyAnnRefListSlot`'s `0` for a non-ref-array annotation.
export function exprListCellBuildSlot(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  if exprRefArray(exprIx, fnIx) || exprNullableRefArray(exprIx, fnIx) {
    return refListSlotOfExpr(exprIx, fnIx)
  }
  0
}

// ── the empty-`[]` hole: an element rep no element can supply ───────────────────

// An empty array literal carries no element, so every syntactic classifier declines it and
// both the build and the result valtype fall to the i32-list default — right only where the
// cell is actually an i32 list. The checker records the unified element type on the literal
// itself (`nodeTyIxOf`), which is what both halves of the fix read, so they cannot drift. D16.

// The `ArrayLit` node index of an EMPTY `[]` expression (through parens), else -1.
function emptyArrLitIxOf(exprIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is ArrayLit {
    if e.arrElems.length == 0 { return exprIx }
    return -1
  }
  if e is Paren { return emptyArrLitIxOf(e.parInner) }
  -1
}

// The interned ref-list row an empty `[]`'s element resolves to, or -1. The element name is
// the checker's own rendering of the recorded element type, character-for-character the key
// an equivalent annotated spelling interns its row under, so the hole and the annotation land
// on one row.
function emptyArrHoleElemName(exprIx: i32) {
  const ax = emptyArrLitIxOf(exprIx)
  if ax < 0 { return "" }
  // The arena decides which row first (D626): `nodeArrayElemName` renders a nested element
  // structurally, which is not the key an annotated spelling interned its row under.
  const aslot = rlSlotOfTy(tyRefArrElemOf(nodeTyIxOf(ax)))
  if aslot >= 0 && aslot < rlElemName.length { return rlElemName[aslot] }
  nodeArrayElemName(ax)
}

function emptyArrHoleElemSlot(exprIx: i32) {
  const en = emptyArrHoleElemName(exprIx)
  if en == "" { return -1 }
  rlSlotByName(en)
}

// The `VKind` an empty `[]`'s recorded array type reps as, or `null` when this is not an
// element-pinned hole. Ordered as `tyAnnRefListKind`'s ladder is: non-`TyPrim`-backed
// spellings (litunion, nullable niches) first, then `TyPrim` leaves, then the ref-list row —
// a `TyPrim` leaf returns on an unmapped element rather than falling into the row lookup.
function emptyArrHoleKind(exprIx: i32): VKind | null {
  const ax = emptyArrLitIxOf(exprIx)
  if ax < 0 { return null }
  const ty = nodeTyIxOf(ax)
  if ty < 0 { return null }
  const sbk = tyScalarBackedListKind(ty)
  if sbk != null { return sbk }
  const lk = tyPrimLeafListKind(ty)
  if lk != null { return lk }
  if tyPrimLeafElem(ty) { return null }
  if emptyArrHoleElemSlot(exprIx) >= 0 { return "reflist" }
  null
}

// The bare `TyPrim` element name of an array type, or `null` for a non-array, an unpinned
// hole, or any element that is not a bare primitive. The one home of that walk — the two
// answers below and `arrNewDefaultKind` each need it, and the third wants to ladder over
// `PrimName` rather than over the list `VKind` this folds to.
function tyPrimLeafElemName(ty: i32): PrimName | null {
  if ty < 0 { return null }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 { return null }
    const el = T.tys[t.aElem]
    if el is TyPrim { return el.primName }
  }
  null
}

// The list `VKind` an ARRAY type over a bare `TyPrim` LEAF reps as — `i32`/`boolean` share
// the one i32-list backing, every other leaf has its own — or `null` for any other element
// (or any non-array). The ARENA twin of the `nameIs*Array` ladder, written once for the
// positions that hold a TYPE and no annotation node to run the name ladder over.
function tyPrimLeafListKind(ty: i32): VKind | null {
  const n = tyPrimLeafElemName(ty)
  if n == "i32" || n == "boolean" { return "list" }
  if n == "string" { return "strlist" }
  if n == "f64" { return "f64list" }
  if n == "i64" { return "i64list" }
  if n == "f32" { return "f32list" }
  if n == "u8" { return "u8list" }
  // `void` / `null` / `never` are not element types the list layer has a backing for, and
  // neither is the `null` this answers for a non-array or a non-primitive element.
  null
}

// True if `ty` is an array over a bare `TyPrim` element — the guard that keeps a leaf
// `tyPrimLeafListKind` does NOT map (a `TyPrim` the list layer has no backing for) out of
// the ref-list row lookup below it. `nodeArrayElemName` renders a prim element as its bare
// scalar name, and a bare scalar is not a ref-list key: matching one would be a coincidence.
function tyPrimLeafElem(ty: i32) { tyPrimLeafElemName(ty) != null }

// The `pendingListKind` build vocabulary a list `VKind` + its ref-list ROW demand — the
// same 0/1/2/3/4/5/6/7/10 alphabet `tyAnnRefListKind` produces from an ANNOTATION node and
// `seedFieldListBuild` from a FIELD code. `0` (the i32-list default) for every kind that is
// not a distinct-backing list, which is also the correct seed for the i32-backed ones.
function listBuildKindOfVKind(kind: VKind | null, slot: i32) {
  if kind == "strlist" { return 3 }
  if kind == "f64list" { return 4 }
  if kind == "i64list" { return 6 }
  if kind == "f32list" { return 7 }
  if kind == "u8list" { return 10 }
  if kind == "reflist" {
    if slot >= 0 && slot < rlElemKindTbl.length {
      if rlElemKindTbl[slot] == 2 { return 2 }
      if rlElemKindTbl[slot] == 5 { return 5 }
    }
    return 1
  }
  nulScalarListBuildKind(kind)
}

// The `pendingListKind` / `pendingListSlot` pair an empty `[]` hole demands of `emitArr`.
export function emptyArrHoleBuildKind(exprIx: i32) {
  listBuildKindOfVKind(emptyArrHoleKind(exprIx), emptyArrHoleElemSlot(exprIx))
}

export function emptyArrHoleBuildSlot(exprIx: i32) {
  const s = emptyArrHoleElemSlot(exprIx)
  if s < 0 { return 0 }
  s
}

// True if the `LetDecl` at `letIx` declares a ref-list local: its annotation is a ref
// array (`S[]`/`N[]`), OR its initializer produces a ref list. Picks the local's valtype
// (`(ref $rlTypeIdx)`) and the code-`5` flag in `collectLocals`.
export function letIsRefArray(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // A union annotation (even `S[] | i64`) is a union-box local, not a reflist local —
        // return false so a ref-array init below doesn't mis-pick the reflist valtype.
        if isUNameAB(5, lt.tyName, annRowOfNode(d.letType)) { return false }
        // Arena-first: the arena's `"reflist"` arm covers the settled base cases; the
        // spellings it declines (nested arrays, niches, union/map elements) keep the name walk.
        const k = annRepKindOf(d.letType)
        if k != null {
          if k == "reflist" { return true }
        } else {
          // Where the arena declines the element (nested arrays, niche/union-box/map
          // elements) the reflist layer's own row still answers, off the recorded type.
          if annBareRefArrSlot(d.letType) >= 0 { return true }
        }
      }
    }
    return exprRefArray(d.letInit, fnIx)
  }
  false
}

// The ref-list ELEMENT type-NAME a ref-list `LetDecl` binds: from its `S[]`/`N[]`
// annotation if present, else inferred from its initializer (`refListElemNameOfExpr`).
// "" if not a ref-list local.
function letRefListElemName(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // The one site whose else-branch is the initializer path rather than "": a ref array
        // whose element name is unresolved is expected to be empty by construction here.
        const en = refArrElemNameIf(lt.tyName)
        if en != "" { return en }
      }
    }
    return refListElemNameOfExpr(d.letInit, fnIx)
  }
  ""
}

// ── read-only covariance: the two questions an element-converting copy needs ────

// `Circle[]` assigned to `Shape[]` is `vl check` rc 0 but an invalid module: a mutable wasm
// array is invariant, so no subtyping edge exists between the two array types and the only
// lowering is an element-converting copy. That copy is licensed only where nothing writes
// through either handle — otherwise it silently gives one destination a private list. D791.

// The variant index a ref-list slot's element boxes as when widened into the union-box list
// at `dstSlot`, or -1 when the pair cannot widen: a kind-1 (plain struct) element into a
// kind-2 element, matched by heap type not name (D280: an arm and its layout twin are one
// heap). A nullable source is deliberately allowed in; a nullable destination is not.
export function rlWidenVariantOf(srcSlot: i32, dstSlot: i32): i32 {
  if srcSlot < 0 || dstSlot < 0 { return -1 }
  if srcSlot == dstSlot { return -1 }
  if srcSlot >= rlElemKindTbl.length { return -1 }
  if dstSlot >= rlElemKindTbl.length { return -1 }
  if rlElemKindTbl[srcSlot] != 1 { return -1 }
  if rlElemKindTbl[dstSlot] != 2 { return -1 }
  if srcSlot >= rlElemNullable.length { return -1 }
  if dstSlot >= rlElemNullable.length { return -1 }
  if rlElemNullable[dstSlot] == 1 { return -1 }
  if srcSlot >= rlElemName.length { return -1 }
  // LEG 1 — the element NAMES an arm (`Circle[]`). This is `rlElemVariantHeap`'s own
  // lookup, which is where the slot's element heap came from in the first place.
  const evi = variantIndexOf(nonNulBaseOf(rlElemName[srcSlot]))
  if evi >= 0 { return evi }
  // An inline shape or declared twin whose interned struct heap is an arm's heap (D280).
  // Compared on the resolved row, not `rlElemHeap` (pushed as 0 at intern time — a real index).
  const esi = rlElemStructRow(srcSlot)
  if esi < 0 { return -1 }
  if esi >= sHeapIdx.length { return -1 }
  const eh = sHeapIdx[esi]
  let vi = 0
  while vi < uVarHeap.length {
    if uVarHeap[vi] == eh { return vi }
    vi = vi + 1
  }
  -1
}

// Could a store through the receiver at `recvIx` reach a list whose element rep is ref-list
// slot `slot`? An unclassified side must never be claimed: an unrecorded type or an
// unresolved ref-ish element answers true (the widening then declines, unchanged behaviour),
// while a scalar element or a non-array receiver answers false — neither can alias a ref list.
function listWriteReaches(recvIx: i32, slot: i32): boolean {
  if recvIx < 0 { return true }
  if recvIx >= P.nodes.length { return true }
  const rty = nodeTyIxOf(recvIx)
  if rty < 0 || rty >= T.tys.length { return true }
  const ety = tyRefArrElemOf(rty)
  if ety < 0 || ety >= T.tys.length { return false }
  const et = T.tys[ety]
  let refish = false
  if et is TyObj { refish = true }
  if et is TyUnion { refish = true }
  if et is TyArray { refish = true }
  if et is TyMap { refish = true }
  if et is TyFunc { refish = true }
  if et is TyNullable { refish = true }
  if !refish { return false }
  const s = rlSlotOfTy(ety)
  if s < 0 { return true }
  s == slot
}

// The mutating LIST methods. `set` / `add` / `delete` are map/Set operations and are
// listed anyway: their receiver is a `TyMap`, which `listWriteReaches` answers FALSE for,
// so naming them costs nothing and keeps the set honest if a list ever grows one.
function memPropMutatesList(p: string): boolean {
  if p == "push" { return true }
  if p == "pop" { return true }
  if p == "clear" { return true }
  if p == "set" { return true }
  if p == "add" { return true }
  if p == "delete" { return true }
  false
}

// The un-memoised body of `rlSlotEverWritten` — one flat walk of the node arena, because the
// licence the copy needs is a whole-program property (nothing writes through either handle),
// and aliasing means a write anywhere can observe the copy. Looks for an `Index` assignment
// target or a mutating list method call; `__array_copy__` blocks every slot, unclassified.
function rlSlotWrittenScan(slot: i32): boolean {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is BinExpr {
      if n.binOp == "=" {
        const lhsIx = unwrapParen(n.binLeft)
        if lhsIx >= 0 && lhsIx < P.nodes.length {
          const lhs = P.nodes[lhsIx]
          if lhs is Index {
            if listWriteReaches(lhs.idxArr, slot) { return true }
          }
        }
      }
    }
    if n is Call {
      if n.callFn >= 0 && n.callFn < P.nodes.length {
        const callee = P.nodes[n.callFn]
        if callee is Member {
          if memPropMutatesList(callee.memProp) {
            if listWriteReaches(callee.memObj, slot) { return true }
          }
        }
        if callee is Ident {
          if callee.identName == "__array_copy__" { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// Does ANY list-element store or mutating list method in this program reach a list whose
// element rep is ref-list slot `slot`? Memoised per slot (`rlWrSlots`/`rlWrAns`, cleared
// with the ref-list tables in `collectA`) because the scan is O(arena) and the widening
// sites ask the same two slots at every delivery.
export function rlSlotEverWritten(slot: i32): boolean {
  if slot < 0 { return true }
  let m = 0
  while m < rlWrSlots.length {
    if rlWrSlots[m] == slot { return rlWrAns[m] == 1 }
    m = m + 1
  }
  const ans = rlSlotWrittenScan(slot)
  rlWrSlots.push(slot)
  if ans { rlWrAns.push(1) } else { rlWrAns.push(0) }
  ans
}

// The whole licence in one predicate: may a value at ref-list slot `srcSlot` be delivered
// into `dstSlot` by an element-converting copy? Widenable by rep, and write-free on both
// sides — a write through either handle after the copy is what would make it observable.
// `rootName` sharpens the rep-scoped write answer to a per-value one (D821) when needed.
export function rlWidenAllowed(
  rootName: string,
  srcSlot: i32,
  dstSlot: i32,
): boolean {
  if rlWidenVariantOf(srcSlot, dstSlot) < 0 { return false }
  if !rlSlotEverWritten(srcSlot) {
    if !rlSlotEverWritten(dstSlot) { return true }
  }
  // Only a definite "nothing writes this value" (0) overrides the rep's "written" answer —
  // an unknown keeps the decline, since a copy on a guess is silently wrong, not just invalid. D791.
  covarValueWriteState(rootName) == 0
}

// The ref-list table slot a ref-list `LetDecl` binds (stored in `localStructIdx` for a
// code-5 local so `declaredRefArrayName` can recover its element type), or -1.
export function letRefListSlot(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    // Guarded by the newtype-brand receipt: a brand is a second arena index over its base's
    // `Ty`, so no structural reader can tell them apart — only `nwTyIxs` can, so it declines here. B123.
    const elemTy = tyRefArrElemOf(nodeTyIxOf(d.letType))
    if !tyIsNewtypeBrand(elemTy) {
      const a = annBareRefArrSlot(d.letType)
      if a >= 0 { return a }
    }
  }
  // The destination an un-annotated list literal never had (D381) — see
  // `letRefListDestSlot`. The local's cell and the literal's build read one answer.
  const dsl = letRefListDestSlot(letIx, fnIx)
  if dsl >= 0 { return dsl }
  rlSlotByName(letRefListElemName(letIx, fnIx))
}

// The bound `LetDecl`'s own name, or "" out of range / not a let.
function letBoundName(letIx: i32): string {
  if letIx < 0 || letIx >= P.nodes.length { return "" }
  const d = P.nodes[letIx]
  if d is LetDecl { return d.letName }
  ""
}

// The ref-list slot the binding's declared destination names, or -1. An un-annotated list
// literal types itself from its own elements with no lookahead, so binding it into a
// declared union-element destination leaves two list types for one list at `vl check` rc 0;
// only the destination can settle it. Kind 2 only — a kind-1 destination is a different question. D381.
export function letRefListDestSlot(letIx: i32, fnIx: i32): i32 {
  const box = letRefListDestSlotK(letIx, fnIx, 2)
  // Two destinations of different element kinds are a loud reject, not a slot pick (D411):
  // a list value has one element rep, so whichever slot wins the other store mismatches.
  if box >= 0 {
    const k1 = letRefListDestSlotK(letIx, fnIx, 1)
    if k1 >= 0 {
      // The answer the earlier refusal didn't have: build at the plain-struct row and let the
      // union-box destination take a copy, gated on the write scan against exactly that risk. D791.
      if rlWidenAllowed(letBoundName(letIx), k1, box) { return k1 }
      emitFailAt(
        "emitProgram: one un-annotated list literal is bound to TWO declared destinations " +
          "whose elements are stored differently (a union-box element list and a " +
          "plain-struct element list); a list value has one element storage, so annotate " +
          "the literal at the type it must be, or build a second literal for the second " +
          "destination",
        letIx,
      )
    }
  }
  box
}

// The two-destination kind conflict, asked before a pin commits the element row: reached
// only for a binding still un-annotated at classify time, since the arm-pin family writes
// an annotation onto this exact shape earlier when a pin fires. Cannot reach an object-literal
// pin — this needs a non-empty `ArrayLit` init. D501.
export function letListDestKindConflict(letIx: i32, fnIx: i32): boolean {
  if letRefListDestSlotK(letIx, fnIx, 2) < 0 { return false }
  letRefListDestSlotK(letIx, fnIx, 1) >= 0
}

// The kind-parameterised scan (D411). `want` 2 is the union BOX — the only kind this rung
// ever ANSWERS with, and the behaviour every caller had before — and `want` 1 is the plain
// struct-row element list, asked only by the conflict detector above.
export function letRefListDestSlotK(letIx: i32, fnIx: i32, want: i32): i32 {
  // O(1) necessary condition keeping the O(arena) scan off most programs: this rung only
  // ever returns a union-box row, and a module declaring no union has none.
  if !uDeclared { return -1 }
  const d = P.nodes[letIx]
  if d is LetDecl {
    // An annotated binding already names its own slot, and a passthrough init names the
    // slot it copies — only a literal has an element inference for a destination to correct.
    if d.letType >= 0 { return -1 }
    if d.letInit < 0 { return -1 }
    const ini = P.nodes[unwrapParen(d.letInit)]
    if ini is ArrayLit {
      // An EMPTY `[]` is already destination-typed through `pendingListKind` /
      // `emptyArrHoleKind`; it has no element inference to correct.
      if ini.arrElems.length < 1 { return -1 }
    } else {
      return -1
    }
    const nm = d.letName
    // The binding's own scope (D661): a name-matched whole-arena scan reads two same-named
    // bindings in different scopes as one with two destinations, and wrongly refuses both.
    const scopeIx = dsScopeRootOf(letIx, nm, fnIx)
    if scopeIx >= 0 { return dsScopeWalk(scopeIx, scopeIx, nm, fnIx, want) }
    let i = 0
    while i < P.nodes.length {
      const rs = dsDestSlotAt(i, nm, fnIx, want)
      if rs >= 0 { return rs }
      i = i + 1
    }
  }
  -1
}

// The seven destination forms, asked of one arena node — `letRefListDestSlotK`'s loop body,
// lifted so the scoped walk and the whole-arena fallback ask the identical question. Kept as
// two copies so a form gets fixed in one traversal, not silently missed in the other.
function dsDestSlotAt(i: i32, nm: string, fnIx: i32, want: i32): i32 {
  const nd = P.nodes[i]
  if nd is LetDecl {
    if nd.letType >= 0 && nd.letInit >= 0 {
      const dini = P.nodes[unwrapParen(nd.letInit)]
      // (a) `const c: Shape[] = nm`
      if dini is Ident {
        if dini.identName == nm {
          const rs = letAnnDestKindListSlot(i, want)
          if rs >= 0 { return rs }
        }
      }
      // (b) `const c: Shape[][] = [nm]` — the annotation's ref-list element is
      // itself a ref list (kind 9); its INNER slot is the one this binding must be.
      if dini is ArrayLit {
        let ei = 0
        while ei < dini.arrElems.length {
          const el = P.nodes[unwrapParen(dini.arrElems[ei])]
          if el is Ident {
            if el.identName == nm {
              const iv = rlInnerKindListSlot(letAnnRefListSlot(i), want)
              if iv >= 0 { return iv }
            }
          }
          ei = ei + 1
        }
      }
      // (f) `const w: W = { f: nm }` — the declared struct FIELD, the third of
      // `letMapDestShape`'s own three destination forms.
      if dini is ObjLit {
        const dsi = letAnnStructIdx(i)
        if dsi >= 0 {
          let fj = 0
          while fj < dini.objFields.length {
            const ff = P.nodes[dini.objFields[fj]]
            if ff is FieldInit {
              const fv = P.nodes[unwrapParen(ff.fiValue)]
              if fv is Ident {
                if fv.identName == nm {
                  const fi2 = sFieldIndex(dsi, ff.fiName)
                  if fi2 >= 0 {
                    const rs = rlSlotByName(sFieldElemNameAt(dsi, fi2))
                    if rlSlotIsKindList(rs, want) { return rs }
                  }
                }
              }
            }
            fj = fj + 1
          }
        }
      }
    }
  }
  // `c[k] = nm` over a declared `{[string]: Shape[]}` — the map value's own ref-list slot,
  // read off the destination map's shape exactly as `letMapDestShape` reads it.
  if nd is BinExpr {
    if nd.binOp == "=" {
      const rhs = P.nodes[unwrapParen(nd.binRight)]
      if rhs is Ident {
        if rhs.identName == nm {
          const lhs = P.nodes[unwrapParen(nd.binLeft)]
          if lhs is Index {
            const mapN = P.nodes[unwrapParen(lhs.idxArr)]
            if mapN is Ident {
              const iv = mapValKindListSlot(mapN.identName, fnIx, want)
              if iv >= 0 { return iv }
            }
          }
          // `c = nm` — the assignment into an already-declared binding, which form (a)
          // cannot see: the destination's annotation is on a `LetDecl` with its own init.
          if lhs is Ident {
            const li = destLetOf(lhs.identName, fnIx)
            if li >= 0 {
              const rs = letAnnDestKindListSlot(li, want)
              if rs >= 0 { return rs }
            }
          }
        }
      }
    }
  }
  // (d) `take(nm)` into a `take(c: Shape[])` parameter.
  if nd is Call {
    const callee = P.nodes[nd.callFn]
    if callee is Ident {
      let ai = 0
      while ai < nd.callArgs.length {
        const arg = P.nodes[unwrapParen(nd.callArgs[ai])]
        if arg is Ident {
          if arg.identName == nm {
            const rs = fnParamKindListSlot(callee.identName, ai, want)
            if rs >= 0 { return rs }
          }
        }
        ai = ai + 1
      }
    }
  }
  // `return nm` from a function whose return annotation is a box list — the annotation comes
  // from the enclosing function (`fnIx`), not the scan.
  if nd is RetStmt {
    if nd.retArg >= 0 {
      const rv = P.nodes[unwrapParen(nd.retArg)]
      if rv is Ident {
        if rv.identName == nm {
          if fnIx >= 0 {
            const fnd = P.nodes[fnIx]
            if fnd is FuncDecl {
              if tyAnnRefListKind(fnd.fnRet) == want {
                const rs = tyAnnRefListSlot(fnd.fnRet)
                if rlSlotIsKindList(rs, want) { return rs }
              }
            }
          }
        }
      }
    }
  }
  -1
}

// The scope a name-matched destination scan has to stay inside (D661), as an arena index to
// start the walk at, or -1 when this binding's scope is not knowable here. Two scopes and a
// decline, since a wrong scope is worse than none: a local (`parentLetOf`), a global
// (`globalLetOf`), or neither — keep the whole-arena scan rather than miss a real destination.
function dsScopeRootOf(letIx: i32, nm: string, fnIx: i32): i32 {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      if parentLetOf(fn.fnBody, nm) == letIx { return fn.fnBody }
    }
  }
  if globalLetOf(nm) == letIx {
    if emitRootIx >= 0 {
      const r = P.nodes[emitRootIx]
      if r is Program { return emitRootIx }
    }
  }
  -1
}

// Does the nested function at `fIx` rebind `nm`? Then its body's uses of the name denote its
// own binding, never the one being classified, so the walk must not enter it. Both binding
// forms a function introduces — a `const nm = …` anywhere in the body, and a parameter named
// `nm` — since either alone leaks.
function dsRebindsName(fIx: i32, nm: string): boolean {
  const fn = P.nodes[fIx]
  if fn is FuncDecl {
    if parentLetOf(fn.fnBody, nm) >= 0 { return true }
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parName == nm { return true }
      }
      i = i + 1
    }
  }
  false
}

// The scoped destination walk (D661): `alcWalk`'s shape, but descends into a nested function
// (unless it rebinds the name), since a capturing nested function is part of the binding's
// scope. The frame threaded down is the destination's, not the binding's (D661A) — three of
// `dsDestSlotAt`'s seven forms read `fnIx` themselves and would otherwise ask the wrong function.
function dsScopeWalk(
  ix: i32,
  scopeIx: i32,
  nm: string,
  fnIx: i32,
  want: i32,
): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = P.nodes[ix]
  let frame = fnIx
  if ix != scopeIx {
    if n is FuncDecl {
      if dsRebindsName(ix, nm) { return -1 }
      frame = ix
    }
  }
  const here = dsDestSlotAt(ix, nm, frame, want)
  if here >= 0 { return here }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    const rs = dsScopeWalk(kids[k], scopeIx, nm, frame, want)
    if rs >= 0 { return rs }
    k = k + 1
  }
  -1
}

// The ref-list slot of element kind `want` that a `LetDecl`'s annotation names, or -1 —
// the destination test forms (a), (b) and (g) of `letRefListDestSlot` all reduce to it.
function letAnnDestKindListSlot(letIx: i32, want: i32): i32 {
  if letAnnRefListKind(letIx) != want { return -1 }
  const rs = letAnnRefListSlot(letIx)
  if rlSlotIsKindList(rs, want) { return rs }
  -1
}

// The `LetDecl` a destination NAME resolves to — the enclosing function's own binding
// first, then a module global. `letRefListDestSlot`'s two name-addressed forms (the map
// store and the assignment) share it.
function destLetOf(name: string, fnIx: i32): i32 {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOf(fn.fnBody, name)
      if li >= 0 { return li }
    }
  }
  globalLetOf(name)
}

// The kind-2 ref-list slot the declared map binding `name` holds as its value, or -1. Read
// off the annotation, not the map's interned shape: with the literal declared before the map,
// `collectLocals` sees -1 for the binding's cell while emit (after the full intern pass) sees
// a real slot for the build, so the two halves of one landing would disagree — a genuine order dependence.
function mapValKindListSlot(name: string, fnIx: i32, want: i32): i32 {
  const li = destLetOf(name, fnIx)
  if li < 0 { return -1 }
  const d = P.nodes[li]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        const vn = mapValNameOf(lt.tyName)
        if vn != "" {
          const en = refArrElemNameIf(vn)
          if en != "" {
            const rs = rlSlotByName(en)
            if rlSlotIsKindList(rs, want) { return rs }
          }
        }
      }
    }
  }
  -1
}

// The ref-list slot of element kind `want` NESTED inside `slot`, or -1: a list-of-lists
// row (element kind 9) holds its inner list's slot, and that inner list is the destination
// forms (b) and (c) hand this binding.
function rlInnerKindListSlot(slot: i32, want: i32): i32 {
  if slot < 0 { return -1 }
  if slot >= rlElemKindTbl.length { return -1 }
  if rlElemKindTbl[slot] != 9 { return -1 }
  const iv = rlElemInnerSlot(slot)
  if rlSlotIsKindList(iv, want) { return iv }
  -1
}

// True when `slot` is a live ref-list row whose element kind is `want` — 2 is the union box,
// 1 a plain struct-row element. Takes the kind as a parameter (D411) so every destination
// helper in this cluster and the two-destination conflict detector read the same seven forms
// arm for arm — a form added later cannot reach only one reading.
function rlSlotIsKindList(slot: i32, want: i32): boolean {
  if slot < 0 { return false }
  if slot >= rlElemKindTbl.length { return false }
  rlElemKindTbl[slot] == want
}

// The `pendingListKind` code and `pendingListSlot` table slot a `LetDecl`'s list initializer
// builds with. One record, resolved once: the destination walk answers both halves, and the
// binding's cell and its literal's build must read one answer or the module is invalid at a
// different offset. `letRefListSlot` is the cell's half.
type ListBuild = { lbKind: i32, lbSlot: i32 }

// The pair, from the binding's own annotation or, where it has none, from its declared
// destination (D381). `lbKind` 0 with `lbSlot` from the annotation is the no-answer pair,
// which leaves the literal to type itself from its elements.
export function letListBuild(letIx: i32, fnIx: i32): ListBuild {
  const k = letAnnRefListKind(letIx)
  if k != 0 {
    const ann: ListBuild = { lbKind: k, lbSlot: letAnnRefListSlot(letIx) }
    return ann
  }
  const ds = letRefListDestSlot(letIx, fnIx)
  if ds >= 0 {
    const dst: ListBuild = { lbKind: 2, lbSlot: ds }
    return dst
  }
  const own: ListBuild = { lbKind: 0, lbSlot: letAnnRefListSlot(letIx) }
  own
}

// The ref-list slot of element kind `want` that parameter `argIx` of the named function
// declares, or -1. There is no function-by-name index in the arena, so this scans — reached
// only from `letRefListDestSlot` form (d), bounded by that binding's call sites rather than
// by arena size.
function fnParamKindListSlot(fnName: string, argIx: i32, want: i32): i32 {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is FuncDecl {
      if nd.fnName == fnName {
        if argIx < nd.fnParams.length {
          const p = P.nodes[nd.fnParams[argIx]]
          if p is Param {
            if tyAnnRefListKind(p.parType) == want {
              const rs = tyAnnRefListSlot(p.parType)
              if rlSlotIsKindList(rs, want) { return rs }
            }
          }
        }
        return -1
      }
    }
    i = i + 1
  }
  -1
}

// The ref-list element kind a `LetDecl`'s ANNOTATION declares (`S[]` → 1, `N[]` → 2),
// or `0` when it is not a ref-array annotation. Types an empty `[]` initializer
// (a non-empty literal types itself from its elements).
export function letAnnRefListKind(letIx: i32) {
  // `pendingListKind` semantics: 1 = struct/map ref list, 2 = union box, 3 = string list.
  // Delegates to `tyAnnRefListKind` so the let/return/call-arg/global seeds agree.
  const d = P.nodes[letIx]
  if d is LetDecl {
    const k = tyAnnRefListKind(d.letType)
    if k == 0 {
      // An un-annotated empty `[]` whose pushes infer a string element seeds the
      // string-list kind, so the literal builds the string-list wrapper, not the i32 default.
      if letInfStrListByUse(letIx) { return 3 }
    }
    return k
  }
  0
}

// The ref-list table slot a `LetDecl`'s ref-array annotation names (`let xs: Tok[] = []`
// → the `Tok` slot), or 0 when it is not a ref-array annotation. Threads `pendingListSlot`
// so an empty `[]` initializer builds the annotation's distinct element type.
export function letAnnRefListSlot(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    // An un-annotated map read has no annotation to name its slot, and 0 is a wrong answer,
    // not a missing one — two such globals would otherwise share slot 0's wrapper wrongly. D1040.
    if d.letType < 0 {
      if letNulMapReadValKind(letIx, -1) != null {
        return letNulMapReadSlotArg(letIx, -1)
      }
      // The same "0 is wrong, not missing" hazard for the other un-annotated kind-18 source:
      // resolved through the binding's own init, so a global and same-typed local agree. D1106.
      if letIsNulRefArray(letIx, -1) {
        return nulRefArrayInnerSlotOfLet(letIx, -1)
      }
    }
    return tyAnnRefListSlot(d.letType)
  }
  0
}

// The struct table index a `LetDecl`'s annotation names (`let b: B = { … }` → B's index), or
// -1 when un-annotated or the annotation names a non-struct. Threads `pendingStructIdx` so an
// annotated struct literal builds the annotation's struct over a first-field-name match; an
// un-annotated `let` is left to the literal's own field shape.
export function letAnnStructIdx(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // The arena, as an index rather than a boolean: `structIndexOfTy` (`sTyRow[ty]`) is a
      // real table lookup, unlike its variant sibling below, which has no arena analogue.
      const si = structIndexOfTy(nodeTyIxOf(d.letType))
      if si >= 0 { return si }
      const lt = P.nodes[d.letType]
      if lt is TypeRef { return structIndexByName(lt.tyName) }
    }
  }
  -1
}

// The union-VARIANT table index a `LetDecl`'s annotation names (`const c: Cat`), or -1.
// Seeds `pendingVariantIdx` so the object-literal init builds the bare variant (kind 8).
export function letAnnVariantIdx(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        const lav = variantIndexOf(lt.tyName)
        if lav >= 0 { return lav }
        // `Circle | null` seeds the same concrete variant the bare `Circle` annotation does:
        // the niche's non-null payload is a variant struct, so a literal must build that heap type.
        return nulVariantIndexOf(d.letType)
      }
    }
  }
  -1
}

// Shared `g[i]` nested-array test for the scalar-element list families (string/f64/f32/i64):
// indexing a `T[][]` ref list whose inner element kind is `elemKind` yields the inner `T[]`.
// The four `exprXArray` walks used an identical block, parameterized here by `elemKind` (the
// i32 `exprArray` and ref `exprRefArray` Index cases carry extra logic and stay inline).
function nestedRefListElemIs(idxArr: i32, fnIx: i32, elemKind: i32) {
  if exprRefArray(idxArr, fnIx) {
    const slot = refListSlotOfExpr(idxArr, fnIx)
    if slot >= 0 && slot < rlElemKindTbl.length {
      // A nullable-niche element (kinds 6/7/8/10 with the `| null` slot key) reads as the
      // nullable leaf list, not the non-null one — claiming it here would mis-route the read.
      if rlElemNullable[slot] == 1 { return false }
      if rlElemKindTbl[slot] == elemKind { return true }
    }
  }
  false
}

// ── string-array-typedness of expressions (`string[]`) ──────────────────────────

// Parallel to the ref-array family: decide whether an expression / param / local produces
// a string list — a `(ref $mkListIdx)`. An index read `xs[i]` (a string) / `.length` (i32)
// is not a list.

// True if the already-collected declared local `name` is a string-list ref (code `7`).
function declaredStringArray(name: string) { declaredKind(name) == "strlist" }

// True if function `name` declares (or, un-annotated, infers) a `string[]` return type
// (`"strlist"`). Mirrors `fnRetArray`/`fnRetRefArray` — lets a `string[]`-returning call
// classify so an untyped `let x = snap()` picks the string-list local kind (code `7`).
function fnRetStringArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "strlist"
}

// True if function `name` declares (or, un-annotated, infers) an `f64[]` return — the f64
// analogue of `fnRetStringArray`, so an untyped `let x = mk()` / a call argument classifies as
// an f64 list (kind 12) instead of falling through to i32.
function fnRetF64ArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "f64list"
}

// True if function `name` returns a string-keyed mono map (`{[string]: i32}`, annotated or
// inferred — `"map"`). Lets `exprMap`/`mapShapeOfExpr` classify a call to it, so
// `const r = mk()` (or `mk()[k]`) routes through the map lowering.
function fnRetMapSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "map"
}

// True if evaluating the expression at `exprIx` yields a string list: a string-element
// array literal, a `string[]`-returning call, a `string[]` param/local reference, a
// parenthesized string-array, or a `string[]` field read (code `6`). An index read /
// `.length` is NOT a list.
export function exprStringArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyKindOf(nodeTyIxOf(exprIx)) == 7 {
    return true // typed-IR fast path (see exprIsF64)
  }
  // `m[k]` / `m[k] ?? d` over a string[]-VALUED map yields a string list.
  if mapReadListKind(exprIx, fnIx) == "strlist" { return true }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitIsStr(exprIx, fnIx) }
  if e is Paren { return exprStringArray(e.parInner, fnIx) }
  if e is Call {
    // `__array_new__(n, "s")` builds a string list (intrinsic kind 2).
    if arrNewIntrKind(exprIx, fnIx) == 2 { return true }
    // An INDEXED closure call `fs[i](x)` whose element signature returns `string[]`.
    if cloArrCallRetKind(exprIx, fnIx) == "strlist" { return true }
    // `xs.map(f)`/`xs.filter(p)` yield a new list — the string list exactly when the result
    // element kind is a string; without it a `.filter` over `(string|null)[]` misclassified.
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "str"
    }
    // `xs.slice(...)` over a string list yields a string list.
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "str"
    }
    // `m.keys()` over a STRING-keyed map yields a string list of its keys; over the
    // i32-keyed rep it yields an i32 list, which is not this classifier's answer.
    const kcallee = P.nodes[e.callFn]
    if kcallee is Member {
      if kcallee.memProp == "keys" {
        if exprMap(kcallee.memObj, fnIx) {
          return !mapShapeKeyI32(mapShapeOfExpr(kcallee.memObj, fnIx))
        }
      }
    }
    // `m.values()` over a string-valued map (or a Set) yields a string list.
    if mapValuesResultKind(exprIx, fnIx) == 7 { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetStringArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-VALUE call (`g(x)` with `g: (i32) => string[]`) whose resolved sig
      // result is the string list (`>A`).
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "strlist"
    }
    return false
  }
  if e is Ident {
    // A VALUE-union ident narrowed to a string-backed LIST arm (`is string[]`, `is
    // (string | null)[]` — value-atom kind 9) reads UNBOXED as the string list.
    if unionIdentReadKind(exprIx, fnIx) == 9 { return true }
    if paramStringArray(fnIx, e.identName) { return true }
    if declaredStringArray(e.identName) { return true }
    if globalIsStringArraySid(fnIx, sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED string-list read (incl. a boxed captured-mutated `string` local). Kind 7.
    return capturedKindOf(fnIx, e.identName) == "strlist"
  }
  // A field read `p.names` whose field is a `string[]` (code `6`) yields the string-list
  // wrapper ref — so `.length` / indexing / assignment / `.push` treat it as a string list.
  if e is Member {
    if memFieldTypeCode(exprIx, fnIx) == 6 { return true }
  }
  // `g[i]` over a `string[][]` (ref-list element kind 6 — the inner string-list wrapper)
  // yields a `string[]`, so `g[i][j]` reads the string element.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 6) { return true }
  }
  // `p ?? d` over the `string[] | null` niche is the string-list wrapper in BOTH halves — the
  // rep is unchanged, only its nullability (`exprNulScalarListKind`'s own `??` arm).
  const salLhs = coalesceNicheLhs(exprIx)
  if salLhs >= 0 {
    if exprNulScalarListKind(salLhs, fnIx) == "nulstrlist" { return true }
  }
  // A list concat `a + b` yields a new list of the operands' own rep. Must ask itself, not
  // a shared classifier — routing through one would cost 14^depth on a left-nested chain. D721.
  if e is BinExpr {
    if e.binOp == "+" {
      if exprStringArray(e.binLeft, fnIx) {
        return exprStringArray(e.binRight, fnIx)
      }
    }
  }
  false
}

// True if `name` is a `(string | null)[]`, also through one `| null` wrapper
// (`(string | null)[] | null`, the form a `!= null` narrow leaves behind). The one home for
// a block three sibling classifiers carried verbatim, so they cannot drift on whether the
// wrapper counts.
function nameIsNulStrListDeep(name: string) {
  if nameIsNulStrList(name) { return true }
  const p = nullablePartOf(name)
  if p != "" { return nameIsNulStrList(p) }
  false
}

// True if the expression at `exprIx` produces a `(string | null)[]` — the string-ref niche
// list, whose backing is a plain string list but whose element read stays `(ref null)`
// instead of recovering non-null. Recognizes the receiver by its recorded array element
// type or a param/local annotation. Drives the dedicated read arm, checked before `exprStringArray`.
export function exprNulStrArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if nodeArrayElemIsNulStr(exprIx) { return true }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNulStrArray(e.parInner, fnIx) }
  if e is Ident {
    const pt = paramTypeNode(fnIx, e.identName)
    if pt >= 0 {
      // `…Deep` also admits a `(string | null)[] | null` param narrowed with `!= null`: the
      // narrowed value stays `(ref null)`, since the plain-string arm's recover traps on null.
      return annIsNulStrListDeep(pt)
    }
    // A union binding narrowed to the `(string | null)[]` arm reads unboxed as the
    // string list whose ELEMENT stays `(ref null)` — the same nullable read discipline.
    if nameIsNulStrList(narrowVariantFor(e.identName)) { return true }
    // A local/global binding (or a rebind chain `const t0 = g`) annotated
    // `(string | null)[]` — or `(string | null)[] | null`, narrowed via `t0 != null`.
    if identBindingNulStrList(e.identName, fnIx, 4) { return true }
  }
  false
}

// The `exprNulStrArray` binding resolver: the LetDecl for `name` (function-local via
// `parentLetOf`, else a module-level `startStmts` global) whose ANNOTATION — directly or
// under an outer `| null` — is a `(string | null)[]` list; an un-annotated rebind
// (`const t0 = g`) follows its init chain (depth-capped).
function identBindingNulStrList(name: string, fnIx: i32, depth: i32): boolean {
  if depth <= 0 { return false }
  let li = -1
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { li = parentLetOf(fn.fnBody, name) }
  }
  if li < 0 {
    // A rebind chain ending at a PARAM of the enclosing function (`const t0 = p`).
    const pt = paramTypeNode(fnIx, name)
    if pt >= 0 { return annIsNulStrListDeep(pt) }
    // A module GLOBAL (`const g: (string | null)[] | null = …`) — top-level LetDecls
    // live in `globalStmts` (they emit as wasm globals, not start statements).
    li = globalLetOfIn(fnIx, name)
  }
  if li < 0 { return false }
  const d = P.nodes[li]
  if !(d is LetDecl) { return false }
  if d.letType >= 0 { return annIsNulStrListDeep(d.letType) }
  if d.letInit >= 0 {
    const init = P.nodes[unwrapParen(d.letInit)]
    if init is Ident {
      return identBindingNulStrList(init.identName, fnIx, depth - 1)
    }
  }
  false
}

// Usage-driven element inference for an un-annotated empty `[]` local, the richer dual of
// `letInfStrListByUse` (which only sees a string literal push): also recognizes a push of
// any string-typed expression, so a build-loop accumulator classifies as `string[]`.
// `gStrInfLet` guards against the `out.push(out[0])` self-reference cycle.
export function letInfStrListByUseV(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return false }
    if d.letInit < 0 { return false }
    const ini = P.nodes[unwrapParen(d.letInit)]
    if ini is ArrayLit {
      if ini.arrElems.length != 0 { return false }
      if gStrInfLet == letIx { return false }
      const saved = gStrInfLet
      gStrInfLet = letIx
      let found = false
      let i = 0
      while i < P.nodes.length {
        const nd = P.nodes[i]
        if nd is Call {
          const callee = P.nodes[nd.callFn]
          if callee is Member {
            if callee.memProp == "push" {
              const recv = P.nodes[callee.memObj]
              if recv is Ident {
                if recv.identName == d.letName && nd.callArgs.length == 1 {
                  const argN = P.nodes[unwrapParen(nd.callArgs[0])]
                  if argN is StrLit {
                    found = true
                  } else if fnIx >= 0 && exprString(nd.callArgs[0], fnIx) {
                    found = true
                  }
                }
              }
            }
          }
        }
        i = i + 1
      }
      gStrInfLet = saved
      return found
    }
  }
  false
}

// True if the `LetDecl` at `letIx` declares a `string[]` local: its annotation is
// `string[]`, OR its initializer produces a string list. Picks the local's valtype
// (`(ref $mkListIdx)`) and the code-`7` flag in `collectLocals`.
export function letIsStringArray(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // A `K[]` annotation is the i32 atom list, authoritative over a string-typed init (since
      // #1852, no string expression can reach here wrongly). Ahead of `annRepKindOf`, not
      // beside the name arms it mirrors: a covered annotation skips the name-arm block entirely.
      if tyIsLitUnionArray(nodeTyIxOf(d.letType)) { return false }
      // Arena-first: a covered annotation answers both `nameIsStringArray` and the
      // authoritative `nameIsRefArray` reject; the uncovered `(K|null)[]` niche keeps the name arm.
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "strlist" { return true }
        if k == "reflist" { return false }
      } else {
        // The `(K | null)[]` reject, structurally, must lead the name arms: the inline spelling
        // of the same type renders as `(string | null)[]` after canon, matching the string niche.
        if annIsNulLitUnionArray(d.letType) { return false }
        // Live and asymmetric with its sibling `letIsI32List`: forcing this arm false uniquely
        // loses a corpus row where the arena legs above don't reach.
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsStringArray(lt.tyName) { return true }
          // A ref-array annotation is authoritative (see `letIsF64Array`) — `annBareRefArrSlot`
          // answers the intern-state question for spellings `annRepKindOf` leaves uncovered.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
          // A `(K | null)[]` annotation is authoritative over a string-first init literal — kept
          // because both arena legs return false-as-silence on an uncovered node, not "no". #1563.
          if nameIsNulLitUnionList(lt.tyName) { return false }
        }
      }
    }
    if exprStringArray(d.letInit, fnIx) { return true }
    return letInfStrListByUseV(letIx, fnIx)
  }
  false
}

// ── f64-array-typedness of expressions (Slice 4) ────────────────────────────────

// Parallel to the i32/string-array families: decide whether an expression / param / local
// produces an `f64[]` list. Drives the index-read dispatch and the f64-list cell kind (`12`).

// True if the already-collected declared local `name` is an f64-list ref (code `12`).
function declaredF64Array(name: string) { declaredKind(name) == "f64list" }

// The scalar-list wrapper kind of an array type whose element rides a scalar list's backing
// without being a `TyPrim` — `"list"` for a literal-union `K[]` and its nullable niches (the
// i32 list), `"strlist"` for the `(string | null)[]` ref niche — else `null`. The arena fold
// of the same identity the name-side ladders have long used: all these wrappers are one heap type.
function tyScalarBackedListKind(tyIx: i32): VKind | null {
  if tyIx < 0 { return null }
  const t = T.tys[tyIx]
  if t is TyArray {
    if t.aElem < 0 { return null }
    if tyIsLitUnion(t.aElem) { return "list" }
    // The two i32-sentinel niches, through the shared predicate `==`/`+` also read — the
    // answer set is unchanged, only the three homes deciding "one i32 cell" collapse to one. D101.
    if tyIsI32SentinelNullable(t.aElem) { return "list" }
    const el = T.tys[t.aElem]
    if el is TyNullable {
      const inner = T.tys[el.nInner]
      if inner is TyPrim {
        if inner.primName == "string" { return "strlist" }
      }
    }
  }
  null
}

// How a `%` node votes on the `__f64_rem__` reservation, in the vocabulary `scanPrintUse`
// needs: 1 = float (the helper must exist), 0 = definitely integer, -1 = the checker recorded
// no scalar type for this node. -1 is not a defensive floor — a monomorphized instance body
// carries its original's type, which is exactly this case. D1586.
export function binRemFloatNeed(ix: i32): i32 {
  const k = tyKindOf(nodeTyIxOf(ix))
  if k == 11 || k == 13 { return 1 }
  if k == 0 || k == 10 { return 0 }
  -1
}

function tyKindOf(tyIx: i32) {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if t is TyPrim {
    const n = t.primName
    if n == "i32" { return 0 }
    if n == "f64" { return 11 }
    if n == "i64" { return 10 }
    if n == "f32" { return 13 }
    if n == "string" { return 3 }
    if n == "boolean" { return 0 }
    return -1
  }
  if t is TyArray {
    if t.aElem < 0 { return -1 }
    // A numeric litunion element reps as its base scalar's list (`numLitUnionBaseTy`); a
    // string litunion element stays -1, since its rep is the interned atom, not a `(ref $array)`.
    let elIx = t.aElem
    const el0 = T.tys[elIx]
    if el0 is TyLit {
      const eb0 = numLitUnionBaseTy(elIx)
      if eb0 >= 0 { elIx = eb0 }
    }
    if el0 is TyUnion {
      const eb1 = numLitUnionBaseTy(elIx)
      if eb1 >= 0 { elIx = eb1 }
    }
    const el = T.tys[elIx]
    if el is TyPrim {
      const en = el.primName
      if en == "i32" { return 2 }
      if en == "f64" { return 12 }
      if en == "i64" { return 20 }
      if en == "string" { return 7 }
      if en == "boolean" { return 2 }
    }
    return -1 // struct / ref / nested-list element — needs the ref-list slot
  }
  // A numeric literal type or union has no rep of its own — it reps as its base scalar,
  // resolved through `numLitUnionBaseTy` and this function's `TyPrim` arm, not written twice.
  let litBaseRow = -1
  if t is TyLit { litBaseRow = numLitUnionBaseTy(tyIx) }
  if t is TyUnion { litBaseRow = numLitUnionBaseTy(tyIx) }
  if litBaseRow >= 0 { return tyKindOf(litBaseRow) }
  -1
}

// TYPED-IR consumer: is the type the checker recorded for `tyIx` an `f64[]`? Lets the emitter
// recognize an f64 list the SYNTACTIC predicates miss (e.g. an `f64[]`-returning call, which
// `calleeRetKind` doesn't map to a list kind) without a bespoke per-position predicate.
function tyIsF64Array(tyIx: i32) { tyKindOf(tyIx) == 12 }

export function exprF64Array(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // Typed-IR fast path: trust the checker's recorded type when it has one. A monomorphized
  // instance body reads back -1 and falls through to the syntactic derivation unaffected.
  if tyIsF64Array(nodeTyIxOf(exprIx)) { return true }
  // `m[k]` / `m[k] ?? d` over an f64[]-VALUED map yields an f64 list.
  if mapReadListKind(exprIx, fnIx) == "f64list" { return true }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitIsF64(exprIx, fnIx) }
  if e is Paren { return exprF64Array(e.parInner, fnIx) }
  if e is Ident {
    // A VALUE-union ident narrowed to the `f64[]` LIST arm (value-atom kind 8) reads
    // UNBOXED as the f64 list — the string/i32-list classifiers carry the same arm.
    if unionIdentReadKind(exprIx, fnIx) == 8 { return true }
    if paramF64Array(fnIx, e.identName) { return true }
    if declaredF64Array(e.identName) { return true }
    if globalIsF64ArraySid(fnIx, sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED f64-list read (`xs[i]` inside a closure capturing `xs` — incl. a boxed
    // captured-mutated `f64` local, lowered to a length-1 `f64[]`). Kind 12 = f64 list.
    return capturedKindOf(fnIx, e.identName) == "f64list"
  }
  // A `.map`/`.filter` whose result ELEMENT kind is f64 yields an f64 list (an f64
  // receiver's filter, or a map whose callback returns f64). (Slices 3–4.)
  if e is Call {
    // `__array_new__(n, <f64 fill>)` yields an f64 list.
    if arrNewIntrKind(exprIx, fnIx) == 1 { return true }
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "f64"
    }
    // `xs.slice(...)` over an f64 list yields an f64 list.
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "f64"
    }
    // An INDEXED closure call `fs[i](x)` whose element signature returns `f64[]`.
    if cloArrCallRetKind(exprIx, fnIx) == "f64list" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      // A NAMED function returning `f64[]` (annotated or inferred, `"f64list"`).
      if fnRetF64ArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-VALUE call (`g(x)` with `g: (i32) => f64[]`) whose resolved sig
      // result is the f64 list (`>D`).
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "f64list"
    }
    return false
  }
  // `g[i]` over an `f64[][]` (ref-list element kind 7 — the inner f64-list wrapper) yields an
  // `f64[]`, so `g[i][j]` reads the f64 scalar.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 7) { return true }
  }
  // A list concat `a + b` yields a new list of the operands' own rep. Must ask itself, not
  // a shared classifier — routing through one would cost 14^depth on a left-nested chain. D721.
  if e is BinExpr {
    if e.binOp == "+" {
      if exprF64Array(e.binLeft, fnIx) { return exprF64Array(e.binRight, fnIx) }
    }
  }
  false
}

// ── f32-array typedness (the f32 sibling of the f64-array family, rep code 21) ───

// f32 is the checker's weak spot (a float literal types f64), so these lean on the syntactic
// path — an `f32[]` annotation — rather than a blanket typed-IR fast path. A bare `[1.5]`
// literal stays f64; a value is f32[] only when its declared type says so.

// The checker-recorded type `tyIx` tested for an f32-element array, read structurally
// (`TyArray` → `TyPrim "f32"`) — the only working arena test, since `tyKindOf` deliberately
// carries no f32-array kind. Not safe at every node: an `ArrayLit` (recorded arm isn't what
// it builds) and an `Index` (rep comes from the container's row) must never reach it.
function tyIsF32ArrayShape(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if t is TyArray {
    if t.aElem < 0 { return false }
    const el = T.tys[t.aElem]
    if el is TyPrim { return el.primName == "f32" }
  }
  false
}

function declaredF32Array(name: string) { declaredKind(name) == "f32list" }

function globalIsF32ArraySid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsF32Array(li, -1)
}

function fnRetF32ArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "f32list"
}

// True if function `name` carries an annotated `f32[]` return — read straight off the
// annotation node, since neither `fRetKind` (no f32-list arm) nor the typed-IR fast path
// (`tyKindOf` carries no f32-array kind) can answer for f32. Gated on `fn.fnRet >= 0`: an
// un-annotated `f32[]` return is a different, still-open defect.
function fnRetAnnF32ArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 || i >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[i]]
  if fn is FuncDecl {
    if fn.fnRet < 0 { return false }
    return retF32ArrFlag(fn.fnRet) == 1
  }
  false
}

// True if the `let`/`const` at `letIx` binds a `u8[]` — the packed byte list, cell
// `(ref $bl8TypeIdx)` over `(array (mut i8))`. Annotation-only, unlike its f32/f64/i64
// siblings: a bare array literal always types `i32[]`, so there is no un-annotated
// expression whose own type is `u8[]` to fall through to.
export function letIsU8Array(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // Arena-first (see `letIsArray`), name as the documented second opinion.
      const k = annRepKindOf(d.letType)
      if k != null { return k == "u8list" }
      const lt = P.nodes[d.letType]
      if lt is TypeRef { return nameIsU8Array(lt.tyName) }
    }
    // Un-annotated: the initializer decides, exactly as the scalar-list siblings — without
    // this, a `u8[]`-returning call's result stored into an i32-list cell is invalid wasm.
    return exprU8Array(d.letInit, fnIx)
  }
  false
}

export function letIsF32Array(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // Arena-first (see `letIsArray`).
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "f32list" { return true }
        if k == "reflist" { return false }
        // A settled annotation naming a different scalar/ref list is authoritative — the
        // initializer must not overrule it, or the two wrapper types meet at the store (invalid wasm).
        if k == "f64list" { return false }
        if k == "i64list" { return false }
        if k == "strlist" { return false }
        if k == "list" { return false }
      } else {
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsF32Array(lt.tyName) { return true }
          // A REF-array annotation (`(f32 | null)[]`) is authoritative — see `letIsF64Array`.
          // ARENA (destringify D-REFARR): the intern-state reading of that reject.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
        }
      }
    }
    return exprF32Array(d.letInit, fnIx)
  }
  false
}

// True if the array literal at `arrIx` has f32 elements — every element must be `exprIsF32`,
// unlike its f64/i64 siblings, which claim on any element. A mixed literal (`[fv, 1]`) is a
// checker-level union, not an f32 list, and an annotated `f32[]` binding routes through the
// annotation instead. A bare `[1.5]` stays f64: a float literal is deliberately not `exprIsF32`.
export function arrLitIsF32(arrIx: i32, fnIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    let i = 0
    while i < a.arrElems.length {
      if !exprIsF32(a.arrElems[i], fnIx) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// True if the type-annotation node `tyIx` spells `u8[]` — the arena's recorded type first,
// the written spelling as the documented second opinion, the pattern every scalar list rung
// in `vtKindOfType` follows.
function annIsU8Array(tyIx: i32) {
  if tyIx < 0 { return false }
  if tyIsU8ArrayTy(nodeTyIxOf(tyIx)) { return true }
  const t = P.nodes[tyIx]
  if t is TypeRef { return nameIsU8Array(t.tyName) }
  false
}

// True if `exprIx` evaluates to a `u8[]` — the packed byte list. The arena is enough here,
// unlike `exprF32Array`'s per-position syntactic arms: nothing infers to `u8[]`, so the
// recorded type says `u8[]` exactly when an annotation put it there, at every position.
export function exprU8Array(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyIsU8ArrayTy(nodeTyIxOf(exprIx)) { return true }
  const e = P.nodes[exprIx]
  if e is Paren { return exprU8Array(e.parInner, fnIx) }
  if e is Call {
    // A call of a NAMED function with an annotated `u8[]` return. The recorded type above
    // answers at most positions; this reads the callee's own annotation for the ones it
    // does not, which is how `const xs = mk()` binds the packed wrapper.
    const cf = P.nodes[e.callFn]
    if cf is Ident {
      const cfi = fnIndexOfSid(sidOfNode(e.callFn))
      if cfi >= 0 {
        const fd = P.nodes[fnStmts[cfi]]
        if fd is FuncDecl { return annIsU8Array(fd.fnRet) }
      }
    }
    return false
  }
  if e is Ident {
    // No narrowed-union arm here, unlike `exprArray`/`exprF32Array`: `u8[]`'s `TyPrim("u8")`
    // element survives narrowing, so the arena leg above already answers every narrowed read.
    // The three name positions it doesn't reach — a param inside its own body, a declared
    // local, a module global — each ask the declaration that fixed the cell's kind instead.
    if annIsU8Array(paramTypeNode(fnIx, e.identName)) { return true }
    if declaredKind(e.identName) == "u8list" { return true }
    const gli = globalLetOfSidIn(fnIx, sidOfNode(exprIx))
    if gli >= 0 {
      if letIsU8Array(gli, -1) {
        return !identShadowedByFrame(fnIx, e.identName)
      }
    }
    return false
  }
  // A list concat `a + b` yields a new list of the operands' own rep. Must ask itself, not
  // a shared classifier — routing through one would cost 14^depth on a left-nested chain. D721.
  if e is BinExpr {
    if e.binOp == "+" {
      if exprU8Array(e.binLeft, fnIx) { return exprU8Array(e.binRight, fnIx) }
    }
  }
  false
}

export function exprF32Array(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // The arena leg is per-arm, not at the top (unlike `exprF64Array`'s `tyIsF64Array` opener):
  // a top-level `tyKindOf(ty) == 21` test never returns 21, so it is attached only to the two
  // node shapes that reach it soundly — an Ident and a Member, each a place whose cell rep the
  // declaration already fixed.

  // A read of an `f32[]`-valued map (`m[k] ?? []`, or a bare `m[k]`) — its value-list rep is the
  // f32 list (`mvListValKind` → 21), the f32 dual of the f64-list (12) case above.
  if mapReadListKind(exprIx, fnIx) == "f32list" { return true }
  const e = P.nodes[exprIx]
  // An f32-element literal, the arm the f64/i64 siblings carry and this lacked — without it,
  // an inferred `[fv]` built an i32 backing over f32 elements (invalid wasm).
  if e is ArrayLit { return arrLitIsF32(exprIx, fnIx) }
  if e is Paren { return exprF32Array(e.parInner, fnIx) }
  if e is Ident {
    // A value-union ident narrowed to the `f32[]` list arm reads unboxed — the checker's
    // typed-IR carries no f32-array claim (a float literal types f64), so this is the only signal.
    if unionIdentReadKind(exprIx, fnIx) == 12 { return true }
    if paramF32Array(fnIx, e.identName) { return true }
    if declaredF32Array(e.identName) { return true }
    if globalIsF32ArraySid(fnIx, sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED f32-list read (incl. a boxed captured-mutated `f32` local). Kind 21 = f32 list.
    if capturedKindOf(fnIx, e.identName) == "f32list" { return true }
    // The arena leg: every rung above answers off a bare `f32[]` declared kind, none of which
    // covers the `f32[] | null` niche — the checker's narrowed-read type is the plain `f32[]`.
    return tyIsF32ArrayShape(nodeTyIxOf(exprIx))
  }
  // A struct-field read of an `f32[]` field (code 27) — the f64/i64 duals get this from their
  // typed-IR fast path, so f32 fields need the field code directly.
  if e is Member {
    if memberFieldCode(exprIx, fnIx) == 27 { return true }
    // The nullable-field niche, narrowed in place: the field's own code is the nullable one
    // (declining the code-27 rung above), so the arena leg answers from the narrowed read.
    return tyIsF32ArrayShape(nodeTyIxOf(exprIx))
  }
  if e is Call {
    // `xs.map(f)` / `xs.filter(p)` whose result element is f32 (mf-result kind 13) — a `.map`
    // with an f32-returning callback, or a `.filter` over an f32 list (preserves the element).
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "f32"
    }
    // `xs.slice(...)` over an f32 list yields an f32 list.
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "f32"
    }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetF32ArraySid(sidOfNode(e.callFn)) { return true }
      // A named function with an annotated `f32[]` return — the annotation read directly,
      // since f32 has neither channel its i64/f64 siblings use (`fnRetAnnF32ArraySid`).
      if fnRetAnnF32ArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-VALUE call (`g()` with `g: () => f32[]`) whose resolved sig result is
      // the f32 list (`>F`) — the f32 dual of the i64/f64-list callee arms.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "f32list"
    }
    // A curried/composed value call (`t0()(1)`): the checker's recorded result type decides —
    // reliable here since a call result's f32-ness comes from the callee's functype, not a literal.
    return tyIsF32ArrayShape(nodeTyIxOf(exprIx))
  }
  // `g[i]` over an `f32[][]` (ref-list element kind 10 — the inner f32-list wrapper) yields an
  // `f32[]`, so `g[i][j]` reads the f32 scalar.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 10) { return true }
  }
  // A list concat `a + b` yields a new list of the operands' own rep. Must ask itself, not
  // a shared classifier — routing through one would cost 14^depth on a left-nested chain. D721.
  if e is BinExpr {
    if e.binOp == "+" {
      if exprF32Array(e.binLeft, fnIx) { return exprF32Array(e.binRight, fnIx) }
    }
  }
  false
}

// ── i64-array typedness (the i64 sibling of the f64-array family) ───────────────

// Mirrors the f64 predicates over the i64-list rep (code 20, wrapper `il64TypeIdx`). The
// typed-IR fast path carries annotated cases; the syntactic fallback covers a
// monomorphized body whose nodes have no recorded type.
function tyIsI64Array(tyIx: i32) { tyKindOf(tyIx) == 20 }

function declaredI64Array(name: string) { declaredKind(name) == "i64list" }

export function letIsI64Array(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // Arena-first (see `letIsArray`).
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "i64list" { return true }
        if k == "reflist" { return false }
      } else {
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsI64Array(lt.tyName) { return true }
          // A REF-array annotation (`(i64 | null)[]`) is authoritative — see `letIsF64Array`.
          // ARENA (destringify D-REFARR): the intern-state reading of that reject.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
        }
      }
    }
    return exprI64Array(d.letInit, fnIx)
  }
  false
}

function globalIsI64ArraySid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsI64Array(li, -1)
}

export function arrLitIsI64(arrIx: i32, fnIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    // A box-list literal with an i64 member is the f64 arm's twin (see `arrLitBoxElem`): the
    // scan is order-blind, so any i64 element (not just the first) makes this an i64 list.
    if arrLitBoxElem(arrIx) { return false }
    let anyI64 = false
    let i = 0
    while i < a.arrElems.length {
      if exprIsF64(a.arrElems[i], fnIx) { return false }
      if !anyI64 {
        if exprIsI64(a.arrElems[i], fnIx) { anyI64 = true }
      }
      i = i + 1
    }
    return anyI64
  }
  false
}

export function exprI64Array(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyIsI64Array(nodeTyIxOf(exprIx)) { return true }
  // `m[k]` / `m[k] ?? d` over an i64[]-VALUED map yields an i64 list.
  if mapReadListKind(exprIx, fnIx) == "i64list" { return true }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitIsI64(exprIx, fnIx) }
  if e is Paren { return exprI64Array(e.parInner, fnIx) }
  if e is Ident {
    if paramI64Array(fnIx, e.identName) { return true }
    if declaredI64Array(e.identName) { return true }
    if globalIsI64ArraySid(fnIx, sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED i64-list read (incl. a boxed captured-mutated `i64` local). Kind 20 = i64 list.
    return capturedKindOf(fnIx, e.identName) == "i64list"
  }
  if e is Call {
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "i64"
    }
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "i64"
    }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      // A closure-value call whose resolved sig result is the i64 list — a named function
      // returning `i64[]` is recognized via the typed-IR fast path above.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "i64list"
    }
    return false
  }
  // `g[i]` over an `i64[][]` (ref-list element kind 8 — the inner i64-list wrapper) yields an
  // `i64[]`, so `g[i][j]` reads the i64 scalar.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 8) { return true }
  }
  // A list concat `a + b` yields a new list of the operands' own rep. Must ask itself, not
  // a shared classifier — routing through one would cost 14^depth on a left-nested chain. D721.
  if e is BinExpr {
    if e.binOp == "+" {
      if exprI64Array(e.binLeft, fnIx) { return exprI64Array(e.binRight, fnIx) }
    }
  }
  false
}

// True if the `LetDecl` at `letIx` declares an `f64[]` local: its annotation is `f64[]`,
// OR its initializer produces an f64 list. Picks the local's valtype (`(ref $fl64TypeIdx)`)
// and the code-`12` flag in `collectLocals`.
export function letIsF64Array(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // Arena-first: a covered annotation's kind is the authority the three name tests below
      // spell out — nothing else can reach the init fallback wrongly.
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "f64list" { return true }
        if k == "reflist" { return false }
        if k == "f32list" { return false }
      } else {
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsF64Array(lt.tyName) { return true }
          // A ref-array annotation (union-box elements) is authoritative: the float-literal
          // init must not claim a scalar f64 list when the slot is a kind-2 ref list.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
          // An `f32[]` annotation is authoritative too — without this, a global `const a:
          // f32[] = [1.5]` double-claimed both kinds and routed `.push` through the wrong frame.
          if nameIsF32Array(lt.tyName) { return false }
        }
      }
    }
    return exprF64Array(d.letInit, fnIx)
  }
  false
}

// ── map-typedness of expressions (G8: `{[string]: i32}`) ────────────────────────

// Parallel to the array family: decide whether an expression / param / local produces a
// string-keyed map — a `(ref $mStructIdx)`. An index read `m[k]` / `m.has(k)` yields an
// i32, not a map, so neither counts here.

// True if the already-collected declared local `name` is a map ref (code `6`).
function declaredMap(name: string) { declaredKind(name) == "map" }
function declaredNulMap(name: string) { declaredKind(name) == "nulmap" }

// True if evaluating the expression at `exprIx` yields a nullable map ref (`{[string]: V} | null`,
// kind `nulmap`) — a nulmap-annotated param / local / global reference, or a nulmap-returning call.
// The map analogue of `exprNullableStruct` / `exprNullableRefArray`: the `!= null` narrow reads the
// `(ref null $mapStruct)` niche, and the narrowed map ops recover it non-null at the receiver.
export function exprNullableMap(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNullableMap(e.parInner, fnIx) }
  // …and the same `if` whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfM = nulIfArmNullableValueIx(exprIx)
  if nlIfM >= 0 {
    if exprNullableMap(nlIfM, fnIx) { return true }
  }
  // An if-EXPRESSION with a NULL arm over a map arm — see `nulArmIfThenValueIx`.
  const elIfM = nulArmIfThenValueIx(exprIx)
  if elIfM >= 0 { return exprMap(elIfM, fnIx) }
  if e is Index {
    // The map read (D1038/D1039), the sibling of `exprNullableList`'s map arm: one arm covers
    // both the inline `if m[k] != null` test and the un-annotated `const g = m[k]` binding.
    const mvSh = mapShapeOfExpr(e.idxArr, fnIx)
    if mvSh >= 0 && mvSh < mvValName.length {
      if nameIsBareMap(mvValName[mvSh]) { return true }
    }
  }
  if e is Ident {
    if paramNulMap(fnIx, e.identName) { return true }
    if declaredNulMap(e.identName) { return true }
    // A captured `{[K]: V} | null` cell: the env field carries the same niche, typed by
    // `captureValKind` off the parent frame's binding.
    if capturedKindOf(fnIx, e.identName) == "nulmap" { return true }
    return globalIsNulMapSid(fnIx, sidOfNode(exprIx))
  }
  // A `recv.f` read of a NULLABLE map FIELD (`f: {[string]: V} | null`, code 29) yields a
  // nullable map — `const t = v.f` infers kind `nulmap` and narrows with `if t != null`.
  if e is Member { return memFieldTypeCode(exprIx, fnIx) == 29 }
  // A read over a nullable-inner-map-valued map yields `map | null` — the fused `?? d` hit
  // arm preserves a stored null, and a bare `m[k]` is nullable by construction.
  if e is BinExpr {
    const cnm = coalesceMvSlot(exprIx, fnIx)
    if cnm >= 0 {
      return mvValIsMap(cnm) && coalesceStaysNullable(exprIx, cnm, fnIx)
    }
  }
  if e is Index {
    // An INDEX into a nullable-map array (`({[string]: V} | null)[]`, element kind 3 with the
    // nullable bit): the element legitimately holds null — `const e = xs[i]` binds `nulmap`.
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemKindTbl[slot] == 3 && rlElemNullable[slot] == 1 { return true }
      }
    }
    const mnm = mapReadMvSlot(exprIx, fnIx)
    if mnm >= 0 { return mvValIsMap(mnm) && mvSlotNullable(mnm) }
  }
  // A call whose ANNOTATED return is `{[string]: V} | null` yields a nullable map, so an
  // un-annotated `const t = mk(…)` infers kind `nulmap` and narrows with `if t != null`.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 {
        const fn = P.nodes[fnStmts[target]]
        if fn is FuncDecl {
          if fn.fnRet >= 0 { return retNulMapFlag(fn.fnRet) == 1 }
          // The inferred return too, off the kind column `buildFnMap` recorded: without it a
          // caller's `const r = pick(…)` bound a non-null cell with nothing to narrow against. D937.
          if target < fRetKind.length { return fRetKind[target] == "nulmap" }
        }
      }
    }
  }
  false
}

// True if evaluating the expression at `exprIx` yields a string-keyed map: the
// `Map()` constructor call, a map param/local reference, or a parenthesized map
// expression.
export function exprMap(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprMap(e.parInner, fnIx) }
  if e is Call {
    const callee = P.nodes[e.callFn]
    // A `Set()` is a boolean-valued string map — the same struct — treated as a map
    // throughout; a named function returning a map (`fnRetMap`) yields one too.
    if callee is Ident {
      if callee.identName == "Map" || callee.identName == "Set" { return true }
      if fnRetMapSid(sidOfNode(e.callFn)) { return true }
    }
    // `scopes.pop()` over a map ref list (`{[string]:i32}[]`) yields a Map ref.
    if callee is Member {
      if callee.memProp == "pop" {
        if exprRefArray(callee.memObj, fnIx) {
          const slot = refListSlotOfExpr(callee.memObj, fnIx)
          if slot >= 0 && slot < rlElemKindTbl.length {
            return rlElemKindTbl[slot] == 3
          }
        }
      }
    }
    // Fallback: a map-returning closure-value/factory call the syntactic cases miss — the map
    // dual of `structIndexOfExpr`'s `nodeTyIsObj` fallback, off the checker's recorded type.
    if nodeTyIsMap(exprIx) { return true }
    return false
  }
  if e is Ident {
    // A union binding narrowed to a map arm unboxes to the map struct ref, so it is a map in
    // the narrowed branch — checked first, ahead of its declared type.
    if narrowedMapOf(e.identName) != "" { return true }
    if paramMap(fnIx, e.identName) { return true }
    if declaredMap(e.identName) { return true }
    if globalIsMapSid(fnIx, sidOfNode(exprIx)) { return true }
    // A captured map variable of a lifted lambda: classify it exactly as a param/local
    // receiver would, so it takes the map-arm boxing in a union-boxed result.
    if capturedKindOf(fnIx, e.identName) == "map" { return true }
    // A nullable map binding is a map ref in the narrowed (`!= null`) branch — the checker
    // proved the map op guarded, and the receiver recovers non-null at the map-op site.
    return exprNullableMap(exprIx, fnIx)
  }
  // A MAP-typed struct field read (`node.children`, code 19) yields a Map ref —
  // map member/index ops on it route to the existing map lowering.
  if e is Member {
    // A union-box field narrowed to a map arm unboxes to the map struct ref — the Ident
    // arm's rule at the one receiver shape that never had it. D1014.
    if narrowedMapOfPlace(exprIx) != "" { return true }
    if memFieldTypeCode(exprIx, fnIx) == 19 { return true }
    if exprNullableMap(exprIx, fnIx) { return true }
  }
  // A union-box ELEMENT whose index PLACE is narrowed to a MAP arm (`if xs[0] is {[string]:
  // K}`) — the index twin of the Member arm above (D1014).
  if e is Index {
    if narrowedMapOfPlace(exprIx) != "" { return true }
  }
  // `outer[k] ?? d` over a NESTED map (value kind 6) yields the inner Map ref — so a
  // chained `(outer[k] ?? d)[j]` routes through the map lowering.
  if e is BinExpr {
    const cmm = coalesceMvSlot(exprIx, fnIx)
    if cmm >= 0 {
      // A NULLABLE inner-map value with a NULLABLE default yields `map | null` —
      // `exprNullableMap` claims that; a non-null default coalesces to the non-null map.
      if mvValIsMap(cmm) && !coalesceStaysNullable(exprIx, cmm, fnIx) {
        return true
      }
    }
  }
  // `scopes[i]` over a map ref list yields a Map ref, per-slot; a bare `outer[k]` over a
  // nested map likewise yields the inner Map.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      // Bound-checked before the read: `refListSlotOfExpr` falls back to slot 0 for an
      // un-interned element name, so an unguarded read is a compiler-internal OOB trap.
      if slot >= 0 && slot < rlElemKindTbl.length {
        // A NULLABLE map element (`({[string]: V} | null)[]`) yields `map | null` —
        // `exprNullableMap`'s element arm claims it, not this non-null arm.
        return rlElemKindTbl[slot] == 3 && rlElemNullable[slot] == 0
      }
    }
    const mri = mapReadMvSlot(exprIx, fnIx)
    if mri >= 0 {
      // A bare read of a NULLABLE inner-map value stays `map | null` — `exprNullableMap`'s.
      if mvValIsMap(mri) && !mvSlotNullable(mri) { return true }
    }
  }
  false
}

// ── G8: map ops on a global struct-field map-array element ──────────────────────

// `fnHasMap` reserves the map scratch frame from map params/locals/map-array locals, but a
// map op can also run on a global struct-field map-array element with no map local at all,
// which the local scan misses. This walk matches the exact four shapes `emitExpr`/`emitStmt`
// lower as map ops, each gated by `exprMap` on the same receiver, so it never over-reserves.

// True if the expression at `exprIx` (recursively) contains a map-op shape whose
// receiver `exprMap` resolves — i.e. a shape the emitter lowers via the map scratch
// frame.
export function exprHasMapOp(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Index {
    // Map GET `recv[k]`.
    if exprMap(e.idxArr, fnIx) { return true }
    // A union binding with a map arm indexed `t[k]`: the narrowing isn't active in this
    // pre-pass frame, so `exprMap` misses it — spot the union-with-map-arm ident directly.
    if unionMapArmIdent(e.idxArr, fnIx) { return true }
    // A map-field read through a union's ref-array arm (`t[i].f[k]` after an `is S[]` narrow):
    // likewise invisible to `exprMap` here — spot the member shape from the declared union.
    if unionListElemMapFieldMember(e.idxArr, fnIx) { return true }
    // A map-field read through a union's struct arm (`t.f[k]` after an `is {f:{[string]:V}}`
    // narrow): likewise invisible — spot it from the declared union's arm field tables.
    if unionStructArmMapFieldMember(e.idxArr, fnIx) { return true }
    // A map read through a union's ARRAY-OF-MAP arm (`t[i][k]` after an `is {[string]:V}[]`
    // narrow): likewise invisible — spot the index shape from the declared union.
    if unionMapArrayElemIndex(e.idxArr, fnIx) { return true }
    // A map read through a union STRUCT arm's LIST-OF-MAPS field (`t.f[0][k]` after an
    // `is {f: {[string]:V}[]}` narrow): likewise invisible — walk the arm's field path.
    if unionStructArmMapListElemIndex(e.idxArr, fnIx) { return true }
    // The typed-IR net for any receiver spelling the syntactic classifiers above miss: the
    // checker's own recorded type reserves the frame regardless of shape or depth (harmless spare).
    if nodeTyUnionHasMapArm(e.idxArr) { return true }
    if exprHasMapOp(e.idxArr, fnIx) { return true }
    return exprHasMapOp(e.idxIndex, fnIx)
  }
  if e is BinExpr {
    // Fused map get-with-default `recv[k] ?? d` (and the method form `recv.get(k) ?? d`).
    if e.binOp == "??" {
      const lhs = P.nodes[e.binLeft]
      if lhs is Index {
        if exprMap(lhs.idxArr, fnIx) { return true }
        if unionMapArmIdent(lhs.idxArr, fnIx) { return true }
        if unionListElemMapFieldMember(lhs.idxArr, fnIx) { return true }
        if unionStructArmMapFieldMember(lhs.idxArr, fnIx) { return true }
        if unionMapArrayElemIndex(lhs.idxArr, fnIx) { return true }
        if unionStructArmMapListElemIndex(lhs.idxArr, fnIx) { return true }
        if nodeTyUnionHasMapArm(lhs.idxArr) { return true }
      }
      if lhs is Call {
        const lcallee = P.nodes[lhs.callFn]
        if lcallee is Member {
          if lcallee.memProp == "get" {
            if exprMap(lcallee.memObj, fnIx) { return true }
          }
        }
      }
    }
    // Map SET `recv[k] = v` (an assignment is a statement, but walk it defensively).
    if e.binOp == "=" {
      const target = P.nodes[e.binLeft]
      if target is Index {
        if exprMap(target.idxArr, fnIx) { return true }
        if unionMapArmIdent(target.idxArr, fnIx) { return true }
        if unionListElemMapFieldMember(target.idxArr, fnIx) { return true }
        if unionStructArmMapFieldMember(target.idxArr, fnIx) { return true }
        if unionMapArrayElemIndex(target.idxArr, fnIx) { return true }
        if unionStructArmMapListElemIndex(target.idxArr, fnIx) { return true }
        if nodeTyUnionHasMapArm(target.idxArr) { return true }
      }
    }
    if exprHasMapOp(e.binLeft, fnIx) { return true }
    return exprHasMapOp(e.binRight, fnIx)
  }
  if e is Call {
    // `recv.has(k)` map membership / `recv.delete(k)` map removal — both touch a map.
    // `m.keys()` / `m.values()` ITERATION also needs the map scratch frame (slot 0
    // holds the map ref for the tombstone-aware `live[i]` skip in the for-in loop).
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "has" {
        if exprMap(callee.memObj, fnIx) { return true }
        if unionMapArmIdent(callee.memObj, fnIx) { return true }
        if unionMapArrayElemIndex(callee.memObj, fnIx) { return true }
        if nodeTyUnionHasMapArm(callee.memObj) { return true }
      }
      if callee.memProp == "delete" {
        if exprMap(callee.memObj, fnIx) { return true }
        if unionMapArmIdent(callee.memObj, fnIx) { return true }
        if nodeTyUnionHasMapArm(callee.memObj) { return true }
      }
      if callee.memProp == "keys" || callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) { return true }
        if unionMapArmIdent(callee.memObj, fnIx) { return true }
        if nodeTyUnionHasMapArm(callee.memObj) { return true }
      }
      // The method map SET `recv.set(k, v)`/`recv.add(x)` — without this, a receiver only
      // this arm claims emitted a store against a frame nothing reserved (invalid wasm).
      if callee.memProp == "set" || callee.memProp == "add" {
        if exprMap(callee.memObj, fnIx) { return true }
        if unionMapArmIdent(callee.memObj, fnIx) { return true }
        if unionMapArrayElemIndex(callee.memObj, fnIx) { return true }
        if nodeTyUnionHasMapArm(callee.memObj) { return true }
      }
    }
    if exprHasMapOp(e.callFn, fnIx) { return true }
    const args = e.callArgs
    let i = 0
    while i < args.length {
      if exprHasMapOp(args[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if e is Member { return exprHasMapOp(e.memObj, fnIx) }
  if e is Unary { return exprHasMapOp(e.unArg, fnIx) }
  if e is Paren { return exprHasMapOp(e.parInner, fnIx) }
  if e is IsExpr { return exprHasMapOp(e.isObj, fnIx) }
  if e is AsExpr { return exprHasMapOp(e.asObj, fnIx) }
  if e is ObjLit {
    const fields = e.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if exprHasMapOp(f.fiValue, fnIx) { return true }
      }
      i = i + 1
    }
    return false
  }
  if e is ArrayLit {
    const elems = e.arrElems
    let i = 0
    while i < elems.length {
      if exprHasMapOp(elems[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// True if any statement in the block at `blockIx` (descending into if/else branches
// and while bodies) contains a map op. An assignment statement (`recv[k] = v`) is a
// bare `BinExpr` with `binOp == "="` — `exprHasMapOp` recognizes its SET shape.
export function blockHasMapOp(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        if exprHasMapOp(s.letInit, fnIx) { return true }
      } else if s is RetStmt {
        if exprHasMapOp(s.retArg, fnIx) { return true }
      } else if s is IfStmt {
        if ifChainHasMapOp(stmts[i], fnIx) { return true }
      } else if s is WhileStmt {
        if exprHasMapOp(s.whileCond, fnIx) { return true }
        if blockHasMapOp(s.whileBody, fnIx) { return true }
      } else if s is ForIn {
        // The iterable is asked through `forInMapRecv`, the emitter's own header predicate: a
        // bare `for k in m` walks the map's live/keys arrays but is invisible to `exprHasMapOp`.
        if forInMapRecv(s.fiIter, fnIx) >= 0 { return true }
        if exprHasMapOp(s.fiIter, fnIx) { return true }
        if blockHasMapOp(s.fiBody, fnIx) { return true }
      } else if s is ForRange {
        if exprHasMapOp(s.frFrom, fnIx) { return true }
        if exprHasMapOp(s.frTo, fnIx) { return true }
        if blockHasMapOp(s.frBody, fnIx) { return true }
      } else if s is Block {
        if blockHasMapOp(stmts[i], fnIx) { return true }
      } else {
        // Every other statement is an expression statement: a tail `mk()["k"]` is an `Index`
        // statement nothing else walked, so ask the widest form — it cannot over-reserve. D1101.
        if exprHasMapOp(stmts[i], fnIx) { return true }
      }
      i = i + 1
    }
  }
  false
}

// True if any arm of the `if` / `else if` chain at `ifIx` contains a map op — its
// condition, then-branch, `else` block, OR (recursively) a chained `else if`.
function ifChainHasMapOp(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if exprHasMapOp(s.ifCond, fnIx) { return true }
    if blockHasMapOp(s.ifThen, fnIx) { return true }
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is Block {
        if blockHasMapOp(s.ifElse, fnIx) { return true }
      } else if els is IfStmt {
        if ifChainHasMapOp(s.ifElse, fnIx) { return true }
      }
    }
  }
  false
}

// True if the FuncDecl at `fnIx` performs a map op on a GLOBAL struct-field map-array
// element (or any map-op shape `fnHasMap`'s local scan does not already cover) — so it
// reserves the shared 12-slot map scratch frame. OR'd into `fnUsesMap`.
export function fnHasGlobalMapOp(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl { return blockHasMapOp(fn.fnBody, fnIx) }
  false
}

// True if the `LetDecl` at `letIx` declares a map-typed local: its annotation is a map
// type (`{[string]: i32}`), OR its initializer produces a map (`Map()`). Picks the
// local's valtype (`(ref $mStructIdx)`) and the code-`6` flag in `collectLocals`.
export function letIsMap(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // Arena-first: a `TyMap` is a map however it renders, subsuming both `nameIsMap` and
        // its map-member-union exclusion, without splitting the name into top-level atoms.
        const k = annRepKindOf(d.letType)
        if k != null {
          if k == "map" { return true }
        } else if nodeTyIsMap(d.letType) {
          // The rep is uncovered but the type is not: `nodeTyIsMap` answers the strictly
          // weaker "is this annotation a map at all", the arena fallback one variant tag down.
          return true
        }
        // Any registered union annotation carrying a bare map arm is a union-box local whose
        // init is that arm — authoritative, so the map fall-through can't reclaim it as bare.
        if isUNameAB(6, lt.tyName, annRowOfNode(d.letType)) { return false }
      }
    }
    return exprMap(d.letInit, fnIx)
  }
  false
}

// True if the `LetDecl` at `letIx` declares a NULLABLE map local (`{[string]: V} | null`,
// kind `nulmap`): its annotation is a nullable map, OR its initializer produces one (a
// nulmap param/local passthrough, or a nulmap-returning call). Checked BEFORE `letIsMap` in
// the collect ladder so a nullable init does not collapse to the non-null kind `"map"`.
export function letIsNulMap(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulMapFlag(d.letType) == 1 { return true }
    }
    return exprNullableMap(d.letInit, fnIx)
  }
  false
}
// The map SHAPE code of a nulmap-typed `LetDecl` (the same vocabulary as `letMapShapeOf`:
// `-2` Set, mv slot >= 0, `-1` mono, `-3` unsupported). Annotation-first (the `| null`-aware
// `mapAnnShape`), else the nulmap initializer's shape.
export function nulMapShapeOf(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulMapFlag(d.letType) == 1 { return mapAnnShape(d.letType) }
    }
    return mapShapeOfExpr(d.letInit, fnIx)
  }
  -1
}

// True if the `LetDecl` at `letIx` declares an i32-keyed map/set. Annotation-first (the
// spelling, `| null` tolerated by the key cut's width), else the checker's recorded type
// on the initializer — the only answer for an un-annotated `const s = Set()` whose key the
// first `.add(1)` pinned.
function letI32KeyedMap(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // Matches the name form's span width (`nameIsI32KeyedMap` cuts `{[K]:` from anywhere),
      // rather than the narrower exact width, since the only consumer picks a Set rep by width.
      if nodeTyMapKeyIsI32Span(d.letType) { return true }
      // Subsumed by the span form above and kept rather than deleted: 0 corpus rows proves
      // corpus-unreachable, not dead.
      if nodeTyMapKeyIsI32(d.letType) { return true }
    }
    return nodeTyMapKeyIsI32(d.letInit)
  }
  false
}

// The map shape code of a map-typed `LetDecl`: `-2` a Set, an mv slot (>= 0) for a
// ref-valued map, `-1` the mono i32 map, `-3` an unsupported value type (op sites fail
// loudly). Annotation-first, else the initializer's shape (a `Map()`/`Set()` constructor,
// or a map-typed passthrough).
export function letMapShapeOf(letIx: i32, fnIx: i32) {
  if letIsSet(letIx) {
    // The Set flavor of the i32-keyed rep (`-5`): a Set is a boolean-valued map, so it
    // is mono either way — the sentinel is what keeps `.values()` yielding ELEMENTS.
    if letI32KeyedMap(letIx) { return -5 }
    return -2
  }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // A map-member union annotation is not a bare map — skip it so the union box is
        // picked. The value must resolve by its nominal arena type, not the rendered spelling.
        if nodeTyIsMap(d.letType) {
          const tsh = mvShapeOfMapNameArmTy(
            lt.tyName,
            nodeMapValTyIx(d.letType),
          )
          if tsh != -3 { return tsh }
        }
      }
    }
    // The destination an un-annotated `Map()` never had, consulted only where the initializer
    // already named a slot — moved thousands of cells loud → runs with zero runs lost. D203.
    const ish = mapShapeOfExpr(d.letInit, fnIx)
    if ish >= 0 || ish == -3 {
      const dsh = letMapDestShape(letIx, fnIx)
      if dsh >= 0 { return dsh }
    }
    return ish
  }
  -1
}

// The map shape the binding's destination declares, or -1. An un-annotated `const lv1 =
// Map()` takes its value type from the first key write, which never looks forward, so
// binding it into a differently-shaped destination leaves two map structs for one map at
// `vl check` rc 0. A find, not a mint: every slot returned is already interned. D203.
function letMapDestShape(letIx: i32, fnIx: i32): i32 {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return -1 }
    if d.letInit < 0 { return -1 }
    const ini = P.nodes[unwrapParen(d.letInit)]
    // Only a BARE `Map()` constructor. A passthrough initializer already names another
    // binding's shape and must keep it.
    let bare = false
    if ini is Call {
      const cf = P.nodes[ini.callFn]
      if cf is Ident {
        if cf.identName == "Map" { bare = true }
      }
    }
    if !bare { return -1 }
    const nm = d.letName
    let i = 0
    while i < P.nodes.length {
      const nd = P.nodes[i]
      // (a) `dst[k] = nm`
      if nd is BinExpr {
        if nd.binOp == "=" {
          const rhs = P.nodes[unwrapParen(nd.binRight)]
          if rhs is Ident {
            if rhs.identName == nm {
              const lhs = P.nodes[unwrapParen(nd.binLeft)]
              if lhs is Index {
                const os = mapShapeOfExpr(lhs.idxArr, fnIx)
                if os >= 0 {
                  if mvValIsMap(os) {
                    const inner = rlElemMapValMvSlot(mvRlSlot[os])
                    if inner >= 0 { return inner }
                  }
                }
              }
            }
          }
        }
      }
      // (b) `const c: {[string]: V}[] = [nm]`  ·  (c) `const c: W = { f: nm }`
      if nd is LetDecl {
        if nd.letType >= 0 && nd.letInit >= 0 {
          const dini = P.nodes[unwrapParen(nd.letInit)]
          if dini is ArrayLit {
            let ei = 0
            while ei < dini.arrElems.length {
              const el = P.nodes[unwrapParen(dini.arrElems[ei])]
              if el is Ident {
                if el.identName == nm {
                  const rs = letAnnRefListSlot(i)
                  if rs >= 0 && rs < rlElemKindTbl.length {
                    if rlElemKindTbl[rs] == 3 {
                      const iv = rlElemMapValMvSlot(rs)
                      if iv >= 0 { return iv }
                    }
                  }
                }
              }
              ei = ei + 1
            }
          }
          if dini is ObjLit {
            const dsi = letAnnStructIdx(i)
            if dsi >= 0 {
              let fj = 0
              while fj < dini.objFields.length {
                const ff = P.nodes[dini.objFields[fj]]
                if ff is FieldInit {
                  const fv = P.nodes[unwrapParen(ff.fiValue)]
                  if fv is Ident {
                    if fv.identName == nm {
                      const fi2 = sFieldIndex(dsi, ff.fiName)
                      if fi2 >= 0 {
                        const fc = sFieldTypeAt(dsi, fi2)
                        if fc == 19 || fc == 29 {
                          const fs = sFieldMapShape(dsi, fi2)
                          if fs >= 0 { return fs }
                        }
                      }
                    }
                  }
                }
                fj = fj + 1
              }
            }
          }
        }
      }
      i = i + 1
    }
  }
  -1
}

// The map shape code of a map-typed expression (the receiver of a map op): `-2` Set, an mv
// slot >= 0, `-1` mono, `-3` unsupported. Mirrors `exprMap`'s resolution chain: constructor
// calls, locals, globals, and the mono-only map-array element / `.pop()` forms. Map-typed
// params stay mono-only — a ref-valued map cannot cross a call boundary.
export function mapShapeOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Paren { return mapShapeOfExpr(e.parInner, fnIx) }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if callee.identName == "Set" {
        if nodeTyMapKeyIsI32(exprIx) { return -5 }
        return -2
      }
      // A map-returning function yields its declared map SHAPE (mono ⇒ -1, or a `string`-valued
      // map's mv slot); a `Map()` constructor is the mono map (-1).
      const fe = fnIndexOfSid(sidOfNode(e.callFn))
      if fe >= 0 { return fnRetMapShapeAt(sidOfNode(e.callFn), exprIx) }
    }
    // An i32-keyed constructor/factory result: the key comes off the call's own recorded
    // type, paired with the value below rather than short-circuiting to the mono sentinel.
    const ckI32 = nodeTyMapKeyIsI32(exprIx)
    // Fallback: a map-returning closure-value/factory call the syntactic path misses — resolve
    // from the checker's recorded map value type, mirroring the `exprMap` fallback.
    if nodeTyIsMap(exprIx) { return mapFindShapeOfNodeTy(exprIx) }
    if ckI32 { return -4 }
    return -1
  }
  if e is Ident {
    // A union binding narrowed to a map arm resolves its shape from the arm's value type,
    // read off the same narrow-stack row as the arm spelling, checked first ahead of declaredMap/paramMap.
    const nm = narrowedMapOf(e.identName)
    if nm != "" {
      return mvSlotOfMapNameTy(nm, narrowedMapValTyOf(e.identName))
    }
    if declaredMap(e.identName) {
      const slot = declaredSlotOf(e.identName)
      if slot >= 0 { return localStructIdx[slot] }
      return -1
    }
    // A map param's shape is its annotation's value type — so the body's map ops resolve
    // the param's value type, not the mono i32 assumption a bare -1 would force.
    if paramMap(fnIx, e.identName) { return paramMapShape(fnIx, e.identName) }
    // A nullable map binding narrowed non-null — its shape is the `| null`-stripped value
    // type, resolved from the local slot or the param annotation.
    if declaredNulMap(e.identName) {
      const nslot = declaredSlotOf(e.identName)
      if nslot >= 0 { return localStructIdx[nslot] }
      return -1
    }
    if paramNulMap(fnIx, e.identName) {
      return paramMapShape(fnIx, e.identName)
    }
    // A captured map variable resolves its shape from the parent frame's binding — both a
    // `Param` and a `LetDecl`, else a captured map param reads mono `-1` against a typed field.
    if capturedKindOf(fnIx, e.identName) == "map" {
      const cfe = fnStmtsPosOf(fnIx)
      if cfe >= 0 {
        const cb = parentBindingOf(cfe, e.identName)
        if cb >= 0 {
          const cbn = P.nodes[cb]
          if cbn is Param { return mapAnnShape(cbn.parType) }
          if cbn is LetDecl {
            const cpar = parentBindingFrameOf(cfe, e.identName)
            if cpar >= 0 { return letMapShapeOf(cb, fnStmts[cpar]) }
          }
        }
      }
      return -1
    }
    // A captured nullable map narrowed non-null — the `| null` twin of the arm above, for a
    // storage class the local/param resolvers can't reach (the binding lives in another frame).
    if capturedKindOf(fnIx, e.identName) == "nulmap" {
      return capturedNulMapShape(fnIx, e.identName)
    }
    const gl = globalLetOfIn(fnIx, e.identName)
    if gl >= 0 {
      if letIsMap(gl, -1) { return letMapShapeOf(gl, -1) }
      if letIsNulMap(gl, -1) { return nulMapShapeOf(gl, -1) }
    }
  }
  // A map-typed struct field read: the shape is the field row's (key, value) pair, mirroring
  // `memberFieldCode`'s receiver dispatch across narrowed/variant/plain-struct receivers.
  if e is Member {
    // The member path's own narrowing to a map arm (D1014): its shape is the arm's value
    // type, ahead of the receiver-narrowing arm below (which would fall to the mono `-1`).
    const mpP = narrowedMapOfPlace(exprIx)
    if mpP != "" {
      return mvSlotOfMapNameTy(mpP, narrowedMapValTyOfPlace(exprIx))
    }
    if memIsNarrowed(exprIx) {
      const nvi = memNarrowVariantIndex(exprIx)
      if nvi >= 0 {
        const nvfi = variantFieldIndex(nvi, e.memProp)
        if nvfi >= 0 {
          const nvc = variantFieldTypeAt(nvi, nvfi)
          if nvc == 19 || nvc == 29 { return uFieldMapShape(nvi, nvfi) }
        }
      }
    }
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 {
        const pvc = variantFieldTypeAt(pvi, pvfi)
        if pvc == 19 || pvc == 29 { return uFieldMapShape(pvi, pvfi) }
      }
    }
    const msi = structIndexOfExpr(e.memObj, fnIx)
    if msi >= 0 {
      const mfi = sFieldIndex(msi, e.memProp)
      if mfi >= 0 {
        const mfc = sFieldTypeAt(msi, mfi)
        if mfc == 19 || mfc == 29 { return sFieldMapShape(msi, mfi) }
      }
    }
  }
  // The index place's own narrowing to a map arm (D1014) — ahead of the composition read
  // below, whose answer describes the cell rather than the narrowed arm.
  if e is Index {
    const mpI = narrowedMapOfPlace(exprIx)
    if mpI != "" {
      return mvSlotOfMapNameTy(mpI, narrowedMapValTyOfPlace(exprIx))
    }
  }
  // A composition map read yielding a typed-value map (a nested-map read, or a list-of-maps
  // element): without this, the binding fell to the mono map and its cell rejected the read.
  const cms2 = compositionMapReadSlot(exprIx, fnIx)
  if cms2 != -2 { return cms2 }
  -1
}

// The mv slot of the map a composition read yields, `-1` for a mono/atom-valued map (rides
// the shared `$mStructIdx`), or `-2` when the expression is not a composition map read at
// all. Two shapes: a nested-map read (the receiver's vals element), or a list-of-maps
// element read (the ref-list element itself).
function compositionMapReadSlot(exprIx: i32, fnIx: i32): i32 {
  // Nested-map read: resolve the receiver's mv slot, then its inner map value.
  let os = coalesceMvSlot(exprIx, fnIx)
  if os < 0 { os = mapReadMvSlot(exprIx, fnIx) }
  if os >= 0 && mvValIsMap(os) { return rlElemMapValMvSlot(mvRlSlot[os]) }
  // List-of-maps element read: the element name is the map type; its value picks the slot.
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length && rlElemKindTbl[slot] == 3 {
        // A NULLABLE map element strips to its inner map for the value-slot resolve.
        return rlElemNulMapValMvSlot(slot)
      }
    }
  }
  -2
}

// The mv slot of the value of the bare-map spelling `mapName` — `mvSlotOfMapValNameOrMono`
// of `mapValNameOf`. Same shape as `mvShapeOfMapName` (the intern side) and
// `mapValKindLowerable` (the support side): three questions about a map's value, once each
// answered by re-slicing `V` out of `{[string]: V}`.
function mvSlotOfMapName(mapName: string): i32 {
  mvSlotOfMapNameTy(mapName, -1)
}
// The `Ty` form (D-MAPNODETY): `valTy` is the map VALUE's banked arena type when the caller
// holds the node, else -1. There is deliberately NO intern-side twin of this — the intern
// path is `mvShapeOfMapName`, and its header says why it does not get one.
function mvSlotOfMapNameTy(mapName: string, valTy: i32): i32 {
  // The KEY comes off the map spelling, exactly as on the intern side
  // (`mvShapeOfMapName`); a MONO value needs no slot on either key rep, so it is the
  // `-1`/`-4` sentinel pair.
  const ki = nameIsI32KeyedMap(mapName)
  const sl = mvSlotOfMapValNameOrMonoKTy(mapValNameOf(mapName), ki, valTy)
  if sl == -1 { return mapMonoShapeOfKey(ki) }
  sl
}

// The mv slot whose map value type-name is `ivIn`, `-1` for a mono/atom value (never
// interned, rides `$mStructIdx`), or `-3` for a typed value whose slot is never interned
// (unsupported — op sites fail loudly, never the silent mono fallback). Mono-tolerant,
// unlike `mvSlotOfValNameFind`, which fails loudly on the mono miss.
function mvSlotOfMapValNameOrMono(ivIn: string): i32 {
  mvSlotOfMapValNameOrMonoK(ivIn, false)
}

function mvSlotOfMapValNameOrMonoK(ivIn: string, keyI32: boolean): i32 {
  mvSlotOfMapValNameOrMonoKTy(ivIn, keyI32, -1)
}
// The `Ty` form (D-MAPNODETY) — the same rung swap `mapAnnShape` makes: the arena leg's
// type comes from the caller's node when it banked one, and every other rung (the mono
// early-out, the name scan, the loud `-3`) is unmoved.
function mvSlotOfMapValNameOrMonoKTy(
  ivIn: string,
  keyI32: boolean,
  valTy: i32,
): i32 {
  // The same key rewrite the mint applies (D47/D93): `mvArmKeyName` is a pure function of
  // (rendered name, recorded value type), so the op find keys exactly what the mint keyed.
  const ivK = mvArmKeyName(ivIn, valTy)
  const iv = mvCanonValName(ivK)
  if mvValKindOfName(iv) == -1 { return -1 }
  // The find's half of the arm component (D48) — the same tri-state the mint threads,
  // answering nominally when `valTy` is known, else via `MV_ARM_NOHINT`.
  const armMo = mvArmHintOfTy(valTy)
  let aMo = -1
  if valTy >= 0 { aMo = mvSlotOfTyKArm(valTy, keyI32, armMo) }
  if aMo < 0 { aMo = mvSlotOfValNameTyKArm(ivK, keyI32, armMo) }
  if aMo >= 0 { return aMo }
  const nmMo = mvSlotByValNameKArm(iv, keyI32, armMo)
  if nmMo >= 0 { return nmMo }
  // A typed value name with no interned slot means the collect pass missed it — `-3`
  // (unsupported) keeps the op sites' loud-reject contract rather than silently defaulting.
  -3
}

// ── string-typedness of expressions ─────────────────────────────────────────────

// Parallel to the array family above: decide whether an expression / param / local
// produces a `string` (currently the same `(array (mut i32))` of code points an array is
// — `docs/strings-design.md`). Like the array family, a `.length`/index read yields an i32.

// True if the function `name` declares `string` as its return type. The `fromCodePoint`
// builtin (H2) constructs a single-character VL string, so it is `string`-returning too —
// classifying it here routes `value + fromCodePoint(cp)` to string concat and
// `let s = fromCodePoint(n)` to a string local, exactly as a user function would.
function fnRetStringSid(sid: i32) {
  // The three builtin string producers are recognized by spelling, not the function table
  // — `sidText` reads the spelling back out of the intern table, faithful since callers mint.
  const name = sidText(sid)
  if name == "fromCodePoint" { return true }
  if name == "fromCodePoints" { return true }
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "str"
}

// True if the parameter `name` of function `fnIx` is `string`-typed.
function paramString(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  if retNulStringFlag(pt) == 1 { return true }
  // Canon's banked type (B143): a litunion param's spelling softens to `string`, and here
  // the softened name is right — an Ident read of it IS a string at a string sink.
  let psTy = nodeTyIxOf(pt)
  if canonRewroteNode(pt) { psTy = canonTyIxOf(pt) }
  tyScalarBaseIs(psTy, "string")
}

// True if the already-collected declared local `name` is a string ref (code `3`).
function declaredString(name: string) {
  // A `string | null` (kind 16) local reads as a string for string ops — narrowed non-null
  // at every such read, so `!= null` (checked first via `exprNullableString`) never mis-routes.
  const dk = declaredKind(name)
  return dk == "str" || dk == "nulstr"
}

// The wasm-type code (`0` i32/bool, `3` string, `4` i32[], `5` ref list, `6` string list)
// of the field a `Member` access reads, resolving the receiver through the three
// field-bearing shapes — a narrowed union local, a variant-typed value, or a plain struct —
// or -1 otherwise. The one place `exprString`/`exprStruct`/`exprArray`/`exprMap` consult.
function memberFieldCode(memIx: i32, fnIx: i32) {
  const e = P.nodes[memIx]
  if e is Member {
    if memIsNarrowed(memIx) {
      const vi = memNarrowVariantIndex(memIx)
      if vi >= 0 {
        const vfi = variantFieldIndex(vi, e.memProp)
        if vfi >= 0 { return variantFieldTypeAt(vi, vfi) }
      }
      return -1
    }
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 { return variantFieldTypeAt(pvi, pvfi) }
      return -1
    }
    // The fifth receiver shape, in lock-step with the twin above.
    const nvi5 = memRecvNulVariantIndex(e.memObj, fnIx)
    if nvi5 >= 0 {
      const nvfi5 = variantFieldIndex(nvi5, e.memProp)
      if nvfi5 >= 0 { return variantFieldTypeAt(nvi5, nvfi5) }
      return -1
    }
    const si = structIndexOfExpr(e.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.memProp)
      if fi >= 0 { return sFieldTypeAt(si, fi) }
    }
    // The fourth receiver shape: an un-narrowed struct union whose members all carry the
    // field at one code (`(A | B).tag`) — without it, a shared read classified as i32.
    const uvis: i32[] = []
    const ufis: i32[] = []
    const ucode = sharedUnionFieldPlan(e.memObj, e.memProp, fnIx, uvis, ufis)
    if ucode >= 0 { return ucode }
  }
  -1
}

// True if evaluating the expression at `exprIx` yields a string: a string literal, a
// `string`-returning call, a string param/local reference, or a parenthesized string
// expression. An index read / `.length` yields an i32, so neither counts.
export function exprString(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is StrLit { return true }
  if e is Paren { return exprString(e.parInner, fnIx) }
  // `x as T` yields exactly `T`, asked of that recorded type rather than the operand — the
  // point of the cast. A numeric cast lands here too and correctly answers false.
  if e is AsExpr { return tyKindOf(nodeTyIxOf(exprIx)) == 3 }
  // An if-expression whose branch join is a string: the checker proved both arms agree, so
  // the join's type (or the then-arm) classifies the whole `if` as kind 3, matching the emit.
  if e is IfStmt {
    // The join's checked type is arm-order-independent: a `string`-typed join may lead with
    // an atom arm, which widens at `emitRefIfArm` — so the value is still a string.
    if tyKindOf(nodeTyIxOf(exprIx)) == 3 { return true }
    const tv = ifThenValueIx(exprIx)
    return tv >= 0 && exprString(tv, fnIx)
  }
  if e is Call {
    // G6: `s.slice(...)` over a string receiver produces a string. Otherwise a
    // bare call produces a string iff the callee declares a `string` return.
    if exprIsStrSlice(exprIx, fnIx) { return true }
    // An INDEXED closure call `fs[i](x)` whose element signature returns `string`.
    if cloArrCallRetKind(exprIx, fnIx) == "str" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetStringSid(sidOfNode(e.callFn)) { return true }
      // A string-returning function value's resolved `>S` sig, except an aliased litunion
      // call whose checker type softens to `string` while `call_ref` reps the i32 atom.
      if calleeReturnsStringSid(sidOfNode(e.callFn), fnIx) {
        if !nodeTyIsLitUnionAlias(exprIx) { return true }
      }
    }
    // A string-returning FIELD-closure call (`o.label(3)` over a `(i32) => string` field).
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 {
        // Except an aliased litunion whose checker type softens to `string`: same-fieldset
        // twin rows can alias onto the OTHER row's string-result lambda (invalid wasm otherwise). #991.
        if fRetKind[ffe] == "str" {
          if nodeTyIsLitUnionAlias(exprIx) { return false }
          // A `{f: (…) => string}` field beside a boolean twin collapses to one layout heap
          // type, so trust the checker's recorded result type over the fe's kind when present.
          const nts = nodeTyIxOf(exprIx)
          // Only when the checker actually resolved it: an un-annotated param's recorded type
          // may still be a type variable, which is an absence of an opinion, not a disagreement. D976.
          if nts >= 0 {
            if !tyHasTyVar(nts) { return tyKindOf(nts) == 3 }
          }
          return true
        }
        return false
      }
    }
    // A closure-value call whose sig the per-name resolvers can't key: resolve it the same way
    // the emitter does, gated on the checker's plain-`string` result to exclude litunion aliases.
    if tyKindOf(nodeTyIxOf(exprIx)) == 3 {
      if sigKeyRetKind(cloCallSigKey(exprIx, fnIx)) == "str" { return true }
    }
    return false
  }
  if e is BinExpr {
    // `m[k] ?? d`/`m.get(k) ?? d` over a string-valued map yields a string ref (the value
    // type); a nullable value with a nullable default stays `string | null`.
    const cms = coalesceMvSlot(exprIx, fnIx)
    if cms >= 0 {
      return mvValKind[cms] == 3 && !coalesceStaysNullable(exprIx, cms, fnIx)
    }
    // `r ?? d` over a `string | null` LHS yields a (non-null) string — the coalesce
    // recovers the non-null array ref, so `.length`/`+`/etc. on the result work.
    if e.binOp == "??" {
      if exprNullableString(e.binLeft, fnIx) { return true }
      // …and over a `null`-typed LHS the value is the default, at the default's rep (D1576).
      const cnnS = coalesceNulNoneDefaultIx(exprIx, fnIx)
      if cnnS >= 0 { return exprString(cnnS, fnIx) }
    }
    // G6: string concatenation `a + b` produces a string; no other binary operator
    // does (`==`/`!=` yield an i32).
    return exprIsStrConcat(exprIx, fnIx)
  }
  if e is Ident {
    // A value-union ident is a string only when narrowed to the `string` atom — an
    // un-narrowed union binding is the box, even when its init is a string literal.
    const uk = unionIdentReadKind(exprIx, fnIx)
    if uk != -3 { return uk == 2 }
    if paramString(fnIx, e.identName) { return true }
    if declaredString(e.identName) { return true }
    // A captured string reads as a string ref (kind 3), like a string param/local; `nulstr`
    // too, since `exprNullableString` claims the `!= null` test first and never mis-routes it.
    const csk = capturedKindOf(fnIx, e.identName)
    if csk == "str" || csk == "nulstr" { return true }
    return globalIsStringSid(fnIx, sidOfNode(exprIx))
  }
  // An index read over a string list (`names[i]`) yields a string ref — the only
  // string-producing index form (an i32 list or `s[i]` yields an i32).
  if e is Index {
    if exprStringArray(e.idxArr, fnIx) { return true }
    // A union-box cell narrowed to the `string` atom unboxes to the string ref — `exprString`
    // has no typed-IR fast path (canon softens a literal union to `string`), unlike its siblings.
    const iuk = indexUnionReadKind(exprIx, fnIx)
    if iuk != -3 { return iuk == 2 }
  }
  // A field read `p.f` where `f` is a STRING struct field yields a string ref (gap #2:
  // `let k = t.kind` must give `k` the string type, not i32).
  if e is Member {
    // A UNION-typed field read narrowed to the `string` atom unboxes to the
    // string ref (the member-path dual of the Ident rule above).
    const muk = memberUnionReadKind(exprIx, fnIx)
    if muk != -3 { return muk == 2 }
    // A field read whose declared type is `string` (code 3), or a `string | null` niche
    // field (code 20) read as a value (it recovers the non-null string ref).
    const mfc = memberFieldCode(exprIx, fnIx)
    return mfc == 3 || mfc == 20
  }
  false
}

// True if the `LetDecl` at `letIx` declares a string-typed local: its annotation is
// `string`, OR its initializer produces a string. Picks the local's valtype
// (`(ref $aTypeIdx)` vs i32) in `collectLocals`.
export function letIsString(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // Canon's banked type: `nameIsString` reads the spelling, which softens a litunion to
        // `string` — right here since nothing else claims the binding first.
        if nodeTyPrimName(d.letType) == "string" { return true }
      }
    }
    return exprString(d.letInit, fnIx)
  }
  false
}

// True if the `LetDecl`/global at `letIx` declares an `i64` binding. Annotation-only: a bare
// integer literal stays i32 by design, so only an explicit `: i64` annotation selects the i64
// slot (valtype `0x7e`, kind 10), and the initializer literal is then lowered as `i64.const`.
export function letIsI64(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // Canon's banked type (B144): `nodeTyPrimName` disagrees for an i64 literal union that
        // softens to the spelling `i64`, so the arena type of the softened spelling is used instead.
        let liTy = nodeTyIxOf(d.letType)
        if canonRewroteNode(d.letType) { liTy = canonTyIxOf(d.letType) }
        if tyScalarBaseIs(liTy, "i64") { return true }
      }
      return false
    }
    // Un-annotated: infer i64 from the initializer, mirroring the host and `letIsF64`. At
    // module scope this recurses through `globalIsI64` for a global-ident operand.
    if d.letInit >= 0 { return exprIsI64(d.letInit, fnIx) }
  }
  false
}

// True if the `LetDecl`/global at `letIx` declares an `f64` binding: an explicit `: f64`
// annotation, or an un-annotated binding whose initializer is a float `.` literal. Such a
// binding selects the f64 slot (valtype 0x7c, kind 11). Accepting an un-annotated float
// `let` here is strictly additive: no other arm claims an un-annotated float binding first.
export function letIsF64(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // Canon's banked type (B144): a numeric literal type/union softens to `f64` (never to
        // `i64`), so the arena type of the softened spelling is used, as `letIsI64` does for i64.
        let lfTy = nodeTyIxOf(d.letType)
        if canonRewroteNode(d.letType) { lfTy = canonTyIxOf(d.letType) }
        if tyScalarBaseIs(lfTy, "f64") { return true }
      }
      return false
    }
    if d.letInit >= 0 {
      const ie = P.nodes[d.letInit]
      if ie is NumLit { return numLexIsFloat(ie.numText) }
      // An f32 init is not an f64 binding — this predicate is the binding-level answer every
      // read site reaches, and without it an inferred-f32 global answered "f64" wrongly.
      if exprIsF32(d.letInit, fnIx) { return false }
      // Un-annotated: infer f64 from the initializer. At module scope this recurses through
      // `globalIsF64` for a global-ident operand, terminating for an acyclic program.
      return exprIsF64(d.letInit, fnIx)
    }
  }
  false
}

// True if the `LetDecl` at `letIx` binds a function value (kind 14): its initializer is
// a `function(...)` literal, a bare reference to a top-level/lifted function name, or a
// call returning a function value. The cell is the closure fat-pointer `(ref
// $cloStructIdx)`. (Lambdas.)
export function letIsClosure(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letInit < 0 { return false }
    return exprIsClosure(d.letInit, fnIx)
  }
  false
}

// Does `name` denote a live binding holding a closure in frame `fnIx` — a narrowed arm, a
// closure-typed param, a nullable one, or a `let`/`const` whose cell is a closure? The rungs
// of `exprIsClosure`'s `Ident` arm that read a binding, asked without the module-function
// rung above them, so a call site can let the binding win (D1602).
export function identIsBoundClosure(name: string, fnIx: i32): boolean {
  if narrowedClosureOf(name) != "" { return true }
  if paramIsClosure(fnIx, name) { return true }
  if paramNulClosure(fnIx, name) { return true }
  const slot = declaredSlotLive(name)
  if slot >= 0 {
    return localIsRef[slot] == "closure" || localIsRef[slot] == "nulclosure"
  }
  // The arena rung, for a pass that runs before `buildLocals` fills the registry — a binding
  // declared directly in the frame body covers every call in it, a nested-block one does not.
  if fnIx < 0 || fnIndexOf(name) < 0 { return false }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, name)
    if li >= 0 && blockDeclaresStmt(fn.fnBody, li) {
      const ld = P.nodes[li]
      if ld is LetDecl {
        if ld.letType >= 0 { return tyIsFuncType(ld.letType) }
        // `exprIsClosureNoLocal`, not `letDeclIsClosureNoLocal`: an alias of a closure param
        // or global is a closure binding too, and that one hop is what this classifier is for.
        return exprIsClosureNoLocal(ld.letInit, fnIx)
      }
    }
  }
  false
}

// True if the expression at `exprIx` evaluates to a function value (a closure
// fat-pointer): a `function(...)` literal, a bare reference to a top-level/lifted
// function name, a reference to a closure-typed param/local, or a call returning a
// function value (a function whose body's tail is itself a function value).
export function exprIsClosure(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprIsClosure(e.parInner, fnIx) }
  if e is FuncDecl { return true }
  // An if-expression whose branch join is a closure: the checker proved both arms agree, so
  // the then-arm's rep classifies the whole `if`, matching `emitIfExprRef`'s `(ref $cloStruct)`.
  if e is IfStmt {
    const tv = ifThenValueIx(exprIx)
    return tv >= 0 && exprIsClosure(tv, fnIx)
  }
  if e is Ident {
    if fnIndexOf(e.identName) >= 0 { return true }
    // A narrowed closure arm, a closure-typed param (kind 14) or nullable one (kind 19), or a
    // closure-celled local — every one calls via `call_ref`, recovered non-null at the call site.
    if identIsBoundClosure(e.identName, fnIx) { return true }
    // A declared local of the name that is not a closure cell denotes no module global.
    if declaredSlotLive(e.identName) >= 0 { return false }
    // A module-global closure cell — a bare closure (kind 14) or a NULLABLE one (kind 19).
    const gl = globalLetOfIn(fnIx, e.identName)
    if gl >= 0 {
      const gk = globalCellKind(gl)
      return gk == "closure" || gk == "nulclosure"
    }
    return false
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 { return fnReturnsClosure(t) }
      // A closure-value callee (`f(4)` where `f: (i32) => ((i32) => i32)`) whose result is
      // itself a closure — resolved from `f`'s `$fnsig` result (`>c`). Lets a curried lambda
      // `const g = f(4)` bind `g` as a closure and call it.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "closure"
    }
    // A chained value call `g()()`: the whole call is a closure iff the checker typed its
    // result as a function type, read directly off the arena rather than a rendered name.
    return anonTySpellable(nodeTyIxOf(exprIx)) && nodeTyIsFunc(exprIx)
  }
  if e is Member {
    // A closure field of a narrowed union or variant-typed receiver reads back a closure
    // exactly like a plain struct's, so the call routes to `call_ref`.
    let mviC = -1
    if memIsNarrowed(exprIx) {
      mviC = memNarrowVariantIndex(exprIx)
    } else {
      mviC = exprVariantIndex(e.memObj, fnIx)
    }
    if mviC >= 0 {
      const mvfiC = variantFieldIndex(mviC, callMemProp(exprIx))
      if mvfiC >= 0 {
        const vfcC = variantFieldTypeAt(mviC, mvfiC)
        if vfcC == 14 || vfcC == 22 { return true }
      }
    }
    // A struct field holding a function value reads back as a closure.
    return memberIsClosure(e.memObj, callMemProp(exprIx), fnIx)
  }
  // An index `xs[i]` into an ARRAY OF FUNCTIONS (`((i32) => i32)[]`, ref-list element
  // kind 5) reads back a closure fat-pointer — callable via `call_ref`.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        return rlElemKindTbl[slot] == 5
      }
    }
    // A bare `m[k]` over a FUNCTION-valued map (`{[string]: (i32) => i32}`, mv kind 14) reads
    // back the closure (nullable — narrow with `if f != null`).
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 { return mvValKind[mrs] == 14 }
  }
  // `m[k] ?? d` over a function-valued map yields the closure — a non-null default coalesces
  // to non-null, a nullable default stays `closure | null` (`exprNullableClosure`'s).
  if e is BinExpr {
    const cm = coalesceMvSlot(exprIx, fnIx)
    if cm >= 0 {
      return mvValKind[cm] == 14 && !coalesceStaysNullable(exprIx, cm, fnIx)
    }
  }
  false
}

// The closure-ABI param-kind code for a type name — the annotation-string analogue of
// `cloParamTok` (which reads the AST), producing the identical token per valtype so a value
// call over an annotated higher-order callee resolves the same interned `$fnsig`. "" for a
// type outside the value-call ABI (the all-i32 arity fallback then applies).
function annParamKind(t: string) {
  if t == "i32" || t == "boolean" { return repSigTokOfKind("i32") }
  if t == "f64" { return repSigTokOfKind("f64") }
  if t == "i64" { return repSigTokOfKind("i64") }
  if t == "f32" { return repSigTokOfKind("f32") }
  // A registered union name is the `{tag, value}` box, except a litunion alias, whose rep is
  // the interned i32 atom — gated on `isUName` since only a declared alias registers a name.
  if isUName(t) {
    if nameIsLitUnionType(t) { return repSigTokOfKind("i32") }
    return repSigTokOfKind("union")
  }
  if nameIsString(t) { return repSigTokOfKind("str") }
  // The five scalar-element list backings, via the one home `scalarListKindOfName` — the
  // same enumeration `annRetKind` reads, so the two `$fnsig` producers cannot drift.
  const sk = scalarListKindOfName(t)
  if sk == 0 { return repSigTokOfKind("list") }
  if sk == 1 { return repSigTokOfKind("strlist") }
  if sk == 2 { return repSigTokOfKind("f64list") }
  if sk == 3 { return repSigTokOfKind("i64list") }
  if sk == 4 { return repSigTokOfKind("f32list") }
  const si = structIndexByName(t)
  if si >= 0 { return repSigSlotTokOfKind("struct", si) }
  // A concrete-variant name (`Cat`), keyed by the variant index (matches `cloParamTok`).
  const vti = variantIndexOf(t)
  if vti >= 0 { return repSigVariantTok(vti) }
  // A ref-list param — the recursive dual of `annRetKind`'s ref-list result. Before the arrow
  // case so a closure-element array's nested `=>` isn't misread as a single closure.
  if nameIsRefArray(t) {
    const rs = rlSlotOfArrName(t)
    if rs >= 0 { return repSigSlotTokOfKind("reflist", rs) }
  }
  // A map param, the annotation-string twin of `cloParamTok`'s map arm (D701 wired the AST
  // side) — without it a map-param lambda call keys "" against the closure's interned map sig.
  if nameIsBareMap(t) { return repSigSlotTokOfKind("map", mvSlotOfMapName(t)) }
  // A function-type param is the shared closure fat-pointer, matching `cloParamTok` — without
  // it a higher-order closure param left its `$fnsig` un-interned (invalid wasm).
  if annArrowAt(t) >= 0 { return repSigTokOfKind("closure") }
  // A struct param the checker rendered structurally resolves by field-set to the same index
  // the AST producer's `cloParamTok` keys, matching a nominal name too.
  const sti = structIndexOfTypeName(t)
  if sti >= 0 { return repSigSlotTokOfKind("struct", sti) }
  ""
}

function annRetKind(t: string) {
  if t == "i32" || t == "boolean" { return ">" + repSigTokOfKind("i32") }
  if t == "f64" { return ">" + repSigTokOfKind("f64") }
  // A literal-union (or nullable litunion) result reps as the interned i32 atom, matching
  // `cloRetKeySuffix`'s `>i` — checked before the union split below, which would mis-key it.
  if nameIsLitUnionType(t) || nameIsNulLitUnion(t) {
    return ">" + repSigTokOfKind("i32")
  }
  // The numeric half of that subtraction is unreachable here, as in `annParamKind`: #1273
  // canons a function type's interior, so this producer never sees a numeric alias.
  if t == "void" { return ">v" }
  if t == "string" { return ">" + repSigTokOfKind("str") }
  if t == "i64" { return ">" + repSigTokOfKind("i64") }
  if t == "f32" { return ">" + repSigTokOfKind("f32") }
  // A list return, matching `cloRetKeySuffix` — `nameIsI32Array` folds `boolean[]` and a
  // litunion `K[]` into the same i32-list token the param dual already keys.
  const sk = scalarListKindOfName(t)
  if sk == 0 { return ">" + repSigTokOfKind("list") }
  if sk == 1 { return ">" + repSigTokOfKind("strlist") }
  if sk == 2 { return ">" + repSigTokOfKind("f64list") }
  if sk == 3 { return ">" + repSigTokOfKind("i64list") }
  if sk == 4 { return ">" + repSigTokOfKind("f32list") }
  // A ref-list return, matching `cloRetKeySuffix` — before the closure case so a closure-
  // element array's nested `=>` isn't misread, keyed by the same `rlSlotByName` the AST side uses.
  if nameIsRefArray(t) {
    const rs = rlSlotOfArrName(t)
    if rs >= 0 { return ">" + repSigSlotTokOfKind("reflist", rs) }
  }
  // A map return, matching `cloRetKeySuffix` — a map-member union also starts `{[` but is a
  // union box, excluded so it falls to the `>u` arm instead of mis-keying `>m`.
  if nameIsBareMap(t) {
    return ">" + repSigSlotTokOfKind("map", mvSlotOfMapName(t))
  }
  // A closure return, matching `cloRetKeySuffix` — the result often arrives parenthesized,
  // so peel one fully-wrapping `(...)` before testing for the arrow.
  const tc = normTypeAtom(t)
  if annArrowAt(tc) >= 0 { return ">" + repSigTokOfKind("closure") }
  // `structIndexOfTypeName` (not `structIndexByName`) so a checker-rendered inline-shape
  // struct return resolves by field-set to the same index the AST producer keys.
  const si = structIndexOfTypeName(t)
  if si >= 0 { return ">" + repSigSlotTokOfKind("struct", si) }
  // A union/nullable return boxes, matching `cloRetKeySuffix` — a union alias resolves to its
  // member set first, so a closure returning the alias still keys the box.
  const parts: string[] = []
  annSplitPipe(unionMemberSetOf(t), parts)
  if parts.length >= 2 {
    const nonNull: string[] = []
    let hasNull = false
    let pi = 0
    while pi < parts.length {
      const p = parts[pi]
      if p == "null" { hasNull = true }
      else if p.length > 0 { nonNull.push(p) }
      pi = pi + 1
    }
    if hasNull && nonNull.length == 1 {
      if nonNull[0] == "string" { return ">" + repSigTokOfKind("nulstr") }
      // A nullable i32-backed list result: the i32-list wrapper made nullable, slot-free,
      // matching `cloRetKeySuffix`'s `>o`; distinct-backing nullable lists fall through to "".
      if nameIsI32Array(nonNull[0]) { return ">" + repSigTokOfKind("nullist") }
      const msi = structIndexOfTypeName(nonNull[0])
      if msi >= 0 { return ">" + repSigSlotTokOfKind("nulstruct", msi) }
      // A nullable-closure result: the shared closure fat-pointer made nullable, slot-free,
      // matching `cloRetKeySuffix`'s `>C` — without it the call fell to the all-i32 arity sig.
      if strContains(nonNull[0], "=>") {
        return ">" + repSigTokOfKind("nulclosure")
      }
      // A nullable numeric scalar reps as the value-union box, matching `cloRetKeySuffix` —
      // `boolean | null` is the i32-sentinel niche instead, excluded since its valtype is plain i32.
      if (
        nonNull[0] == "i32" ||
        nonNull[0] == "i64" ||
        nonNull[0] == "f64" ||
        nonNull[0] == "f32"
      ) {
        return ">" + repSigTokOfKind("union")
      }
      return ""
    }
    if nonNull.length >= 2 { return ">" + repSigTokOfKind("union") }
  }
  ""
}

// The `$fnsig` KEY of a SOURCE function-type annotation `(params)=>ret` — the SAME
// encoding `fnSigKeyOf` produces for a function (`"i>i"`, `"d>d"`, `"s3;>i"`), so a value
// call over an annotated callee resolves the interned signature. "" if any param/return
// type is outside the value-call ABI (the all-i32 arity fallback then applies).
function annSigKey(name: string) {
  // `annFnDecompose` (#1144) IS this whole preamble — the three gates, the param-list
  // slice, the `length > 0`-guarded `annSplitParams` and the return slice. The home's ""
  // sentinel covers all three of this copy's own `return ""` legs.
  const parts: string[] = []
  const retStr = annFnDecompose(name, parts)
  if retStr == "" { return "" }
  let key = ""
  let i = 0
  while i < parts.length {
    const pc = annParamKind(parts[i])
    if pc == "" { return "" }
    key = key + pc
    i = i + 1
  }
  const rc = annRetKind(retStr)
  if rc == "" { return "" }
  key + rc
}

// The `$fnsig` key of a function-type arena type `funcTyIx` (a `TyFunc`) — the destringify-D3
// dual of `annSigKey(nodeTyName(node))`: walks the arena spine (`fnParamTypes`, `fnRet`)
// directly instead of rendering to a name and re-parsing, classifying leaves with the same
// `annParamKind`/`annRetKind` the string path uses. "" for a non-function type or leaf outside the ABI.
function paramTokOfTy(ty: i32) {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim {
    const pn = t.primName
    if pn == "i32" || pn == "boolean" { return repSigTokOfKind("i32") }
    if pn == "f64" { return repSigTokOfKind("f64") }
    if pn == "i64" { return repSigTokOfKind("i64") }
    if pn == "f32" { return repSigTokOfKind("f32") }
    if pn == "string" { return repSigTokOfKind("str") }
    return ""
  }
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const el = T.tys[t.aElem]
    if el is TyPrim {
      const en = el.primName
      if en == "i32" || en == "boolean" { return repSigTokOfKind("list") }
      if en == "string" { return repSigTokOfKind("strlist") }
      if en == "f64" { return repSigTokOfKind("f64list") }
      if en == "i64" { return repSigTokOfKind("i64list") }
      if en == "f32" { return repSigTokOfKind("f32list") }
    }
    return ""
  }
  // A union-arm's identity is its declaration, not its structure (two variants can share a
  // field set) — `variantRowOfTy` matches by arena index only, unlike the name path's field-set match.
  if t is TyObj {
    const vrow = variantRowOfTy(ty)
    if vrow >= 0 { return repSigVariantTok(vrow) }
    return ""
  }
  ""
}

// The return-side twin of `paramTokOfTy` — same partition, same declines, and one extra
// decline of its own: the litunion arms. `annRetKind` keys `>i` for a litunion alias name
// while a raw render softens an inline litunion to `string` (`>S`), so the name arm stays
// authoritative there. Dual-written inside `sigKeyOfTy`.
function retTokOfTy(ty: i32) {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim {
    const pn = t.primName
    if pn == "i32" || pn == "boolean" { return ">" + repSigTokOfKind("i32") }
    if pn == "f64" { return ">" + repSigTokOfKind("f64") }
    if pn == "i64" { return ">" + repSigTokOfKind("i64") }
    if pn == "f32" { return ">" + repSigTokOfKind("f32") }
    if pn == "string" { return ">" + repSigTokOfKind("str") }
    return ""
  }
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const el = T.tys[t.aElem]
    if el is TyPrim {
      const en = el.primName
      if en == "i32" || en == "boolean" { return ">" + repSigTokOfKind("list") }
      if en == "string" { return ">" + repSigTokOfKind("strlist") }
      if en == "f64" { return ">" + repSigTokOfKind("f64list") }
      if en == "i64" { return ">" + repSigTokOfKind("i64list") }
      if en == "f32" { return ">" + repSigTokOfKind("f32list") }
    }
    // The ref-array arm: the arena twin of `annRetKind`'s `nameIsRefArray` path, resolved
    // through the element's own ref-list slot via `repElemId` — the same key the name resolver ends at.
    const rslot = rlSlotOfTy(t.aElem)
    if rslot >= 0 { return ">" + repSigSlotTokOfKind("reflist", rslot) }
    return ""
  }
  // The result twin of `paramTokOfTy`'s union-arm arm, added together: a `(Circle) => Circle`
  // annotation keys both halves, or half a key still disagrees with the lambda's functype.
  if t is TyObj {
    const vrow = variantRowOfTy(ty)
    if vrow >= 0 { return ">" + repSigVariantTok(vrow) }
    return ""
  }
  ""
}

export function sigKeyOfTy(funcTyIx: i32): string {
  if funcTyIx < 0 { return "" }
  const t = T.tys[funcTyIx]
  if !(t is TyFunc) { return "" }
  let key = ""
  let i = 0
  while i < t.fnParamTypes.length {
    // A litunion-alias parameter is preserved (as the return leg is): a raw render softens it
    // to `string`, disagreeing with the two other `$fnsig` producers which key the i32 atom.
    let pc = paramTokOfTy(t.fnParamTypes[i])
    if pc == "" {
      let pnm = ""
      if tyIsLitUnion(t.fnParamTypes[i]) {
        // `tyLitUnionAliasIx`, not the bare `unionAliasDeclNameOfTy`: it follows the checker's
        // alias provenance, so a narrowed-copy alias param resolves its source name, not `string`.
        pnm = unionAliasDeclNameOfTy(tyLitUnionAliasIx(t.fnParamTypes[i]))
      }
      if pnm == "" { pnm = tyToEmitName(t.fnParamTypes[i]) }
      if pnm == "" { return "" }
      pc = annParamKind(pnm)
    }
    if pc == "" { return "" }
    key = key + pc
    i = i + 1
  }
  // The return render mirrors `tyToEmitName`'s TyFunc arm: litunion-alias preservation keys
  // `>i` (not `>S`) and the arena is tried first, so a scalar/scalar-list result is never rendered.
  const raTok = retTokOfTy(t.fnRet)
  if raTok != "" { return key + raTok }
  let rs = ""
  const rtn = T.tys[t.fnRet]
  if rtn is TyNullable {
    const nal = litUnionAliasNameOfTy(rtn.nInner)
    if nal != "" { rs = nal + "|null" }
  }
  if rs == "" {
    const bal = litUnionAliasNameOfTy(t.fnRet)
    if bal != "" { rs = bal }
  }
  if rs == "" { rs = tyToEmitName(t.fnRet) }
  if rs == "" { return "" }
  const rt = T.tys[t.fnRet]
  if rt is TyFunc { rs = "(" + rs + ")" }
  const rc = annRetKind(rs)
  if rc == "" { return "" }
  key + rc
}

// The `$fnsig` key of a union member-set arm (a `splitUnionAtoms` atom), or "" for a
// non-closure arm or a signature outside the value-call ABI. A closure arm arrives wrapped
// in its disambiguating parens and may carry `| `-split whitespace, neither peeled by
// `annSigKey` — normalized here so the key byte-matches the narrowed call site's.
export function unionArmSigKey(arm: string) {
  // Trim then peel one fully-wrapping `(...)` — the same steps as `emit_base.normTypeAtom`,
  // kept as a separate copy here and dual-run against it with no disagreement. #1150.
  const t = normTypeAtom(arm)
  if annArrowAt(t) < 0 { return "" }
  annSigKey(t)
}

// The lifted-function position (`fnStmts` index) of the function value bound to `let`/
// `const`/global `name` in scope of `fnIx` — `const f = dbl` traces to `dbl`. -1 when `name`
// is not a binding holding a bare function value. Lets a closure call over an inferred
// binding resolve the callee's real signature, not the all-i32 arity sig.
export function identClosureFe(name: string, fnIx: i32) {
  identClosureFeSid(sidOf(name), fnIx)
}

// The sid-taking primitive: the body asks two name-keyed tables about the same identifier
// (the function-scope one and the global one), so one intern replaces two hash-and-probes
// even when the caller has no arena index to offer — with one (`sidOfNode`), it replaces
// two with zero.
export function identClosureFeSid(sid: i32, fnIx: i32) {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOfSid(fn.fnBody, sid)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl { return fieldValueFeOf(d.letInit) }
      }
    }
  }
  const gi = globalLetOfSidIn(fnIx, sid)
  if gi >= 0 {
    const gd = P.nodes[gi]
    if gd is LetDecl { return fieldValueFeOf(gd.letInit) }
  }
  // The module frame (D1350), the third scope this resolver must reach: `fnIx < 0` is the
  // start function, whose locals live in no `fnBody` and are not globals either.
  const ml = moduleLocalLetOf(emitRootIx, sidText(sid))
  if ml >= 0 {
    const md = P.nodes[ml]
    if md is LetDecl { return fieldValueFeOf(md.letInit) }
  }
  -1
}

// The function-type annotation name (`(f64)=>f64`) of a `let`/`const`/global `name` in
// scope of `fnIx`, or "" when `name` is not a function-typed binding.
export function identFnTypeAnnName(name: string, fnIx: i32) {
  identFnTypeAnnNameSid(sidOf(name), fnIx)
}

// The annotation node behind `identFnTypeAnnNameSid`'s first arm — a `LetDecl` whose
// `letType` is a function type. -1 for every other arm, so a caller that wants the arena
// gets it only where the name would have come from a plain function-type annotation. The
// sid-taking primitive: `parentLetOf` and `globalLetOf` reached from here, one id serves both.
function identFnTypeAnnNodeSid(sid: i32, fnIx: i32) {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOfSid(fn.fnBody, sid)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if tyIsFuncType(d.letType) { return d.letType }
        }
      }
    }
  }
  -1
}

function identFnTypeAnnNameSid(sid: i32, fnIx: i32) {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOfSid(fn.fnBody, sid)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if tyIsFuncType(d.letType) { return tyNameOf(d.letType) }
          // A nullable-closure annotation (kind 19): return its name so a narrowed call
          // through a null-seeded binding resolves its sig even with no closure value to trace.
          if nulCloFlag(d.letType) == 1 { return tyNameOf(d.letType) }
          // An un-annotated closure local from a call result: recover the function type from
          // the checker's recorded init type — a bare lambda instead trusts its own lifted sig.
          if d.letType < 0 && d.letInit >= 0 {
            const ini = P.nodes[d.letInit]
            if ini is Call {
              // The arena test before the render: the two conditions are ANDed, so this builds
              // the name only for an init the arena already agreed is a function type.
              if nodeTyIsFunc(d.letInit) {
                const itn = nodeTyName(d.letInit)
                if itn != "" { return itn }
              }
            }
            // A copy of another closure binding: the init is a bare Ident, so its checked type
            // is authoritative (unlike a lambda's inferred return, which can disagree).
            if ini is BinExpr {
              if ini.binOp == "??" {
                // The arena test before the render, as the Call arm above: builds the name
                // only for an init the arena already agreed is a function type.
                if nodeTyIsFunc(d.letInit) {
                  const jtn = nodeTyName(d.letInit)
                  if jtn != "" { return jtn }
                }
              }
            }
            // An un-annotated binding read from a closure-element ref list: the kind-5 slot's
            // element name is the function type — return it so a call resolves the element's real sig.
            if ini is Index {
              if exprRefArray(ini.idxArr, fnIx) {
                const islot = refListSlotOfExpr(ini.idxArr, fnIx)
                if islot >= 0 && islot < rlElemKindTbl.length {
                  if rlElemKindTbl[islot] == 5 {
                    const enm = rlElemName[islot]
                    if nullablePartOf(enm) != "" { return enm }
                    return peelGroupParens(enm)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  const gi = globalLetOfSidIn(fnIx, sid)
  if gi >= 0 {
    const gd = P.nodes[gi]
    if gd is LetDecl {
      if tyIsFuncType(gd.letType) { return tyNameOf(gd.letType) }
      // The global dual of the local nulclosure-annotation arm above.
      if nulCloFlag(gd.letType) == 1 { return tyNameOf(gd.letType) }
    }
  }
  ""
}

// The `$fnsig` key of a function-type name that may be a plain closure or a nullable one
// (kind 19, its arrow nested one paren-depth down, invisible to `annArrowAt`) — peeled to
// the bare closure first. "" when neither resolves, so the call keeps its all-i32 arity
// fallback; otherwise it recovers the result token so a narrowed nullable-closure call classifies correctly.
function cloNameSigKey(nm: string) {
  if annArrowAt(nm) >= 0 { return annSigKey(nm) }
  if nameIsNulClosure(nm) {
    const clo = peelGroupParens(nullablePartOf(nm))
    if annArrowAt(clo) >= 0 { return annSigKey(clo) }
  }
  ""
}

// The source binding name of an inferred copy `const name = <Ident>` in scope of `fnIx`
// (`const t0 = p` → `"p"`), or "" when `name` is not such a copy. Lets a closure-value call
// resolve its sig through the intermediate binding the nullable/closure read pattern
// introduces, by chasing the copy to its source (a param or annotated binding).
function identCopySource(name: string, fnIx: i32) {
  identCopySourceSid(sidOf(name), fnIx)
}

function identCopySourceSid(sid: i32, fnIx: i32) {
  if fnIx < 0 { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOfSid(fn.fnBody, sid)
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letType < 0 && d.letInit >= 0 {
          const ini = P.nodes[d.letInit]
          if ini is Ident { return ini.identName }
        }
      }
    }
  }
  ""
}

// The `$fnsig` key for a function-value callee ident `name` (in scope of `fnIx`): a
// function-typed param (its annotation or monomorphized pin), a function-typed local/global
// annotation, or — for an inferred binding — the underlying function's own sig. "" means the
// all-i32 arity fallback applies (an unresolved or non-value-ABI signature, including void).
function calleeCloSigKey(name: string, fnIx: i32) {
  calleeCloSigKeySid(sidOf(name), fnIx)
}

// The sid-taking primitive: the three `ident*` resolutions below each ask the function-scope
// table and the global table about the same identifier, so one id replaces five
// hash-and-probes — and the ~14 `calleeRetKind` call sites hand it the callee node's id
// straight from the carrier, paying none at all.
function calleeCloSigKeySid(sid: i32, fnIx: i32) {
  const name = sidText(sid)
  // A union binding narrowed to a bare-closure arm (`if x is () => i64 { x() }`): the arm's
  // function-type name interns the SAME `$fnsig` an annotated closure would — so the `call_ref`
  // casts to the right functype and the result classifiers (`calleeReturnsI64`/…) read its return.
  const nc = narrowedClosureOf(name)
  if nc != "" {
    const nk = annSigKey(nc)
    if nk != "" { return nk }
  }
  const pk = paramCloSigKey(fnIx, name)
  if pk != "" { return pk }
  // The binding's twin of that answer (D1090), ahead of the annotation arms: a `??` merge
  // can move the rows of the one function this binding ever holds.
  const bk = anonLeafCloBindSigKey(name)
  if bk != "" { return bk }
  // One intern for the three resolutions below (design R3's shape (b)): `identFnTypeAnnName`,
  // `identClosureFe` and `identCopySource` each ask the same identifier against the same tables.
  const csid = sid
  const an = identFnTypeAnnNameSid(csid, fnIx)
  if an != "" {
    // The arena builds the key where the binding carries a plain annotation; `cloNameSigKey`
    // (parsing the rendered name) is the fall-through, safe since both routes decline together. B255.
    const jnd = identFnTypeAnnNodeSid(csid, fnIx)
    if jnd >= 0 {
      const jty = nodeTyIxOf(jnd)
      if jty >= 0 {
        const jt = T.tys[jty]
        if jt is TyFunc {
          const jk = sigKeyOfTy(jty)
          if jk != "" { return jk }
        }
      }
    }
    const ak = cloNameSigKey(an)
    if ak != "" { return ak }
  }
  const fe = identClosureFeSid(csid, fnIx)
  // The extended key (not just `fnSigKeyOf`) so a void-returning binding resolves its `>v`
  // sig, interned above; a value-eligible binding takes the same key `fnSigKeyOf` would.
  if fe >= 0 { return cloSigKeyExt(fe) }
  // An inferred COPY of another closure binding (`const t0 = p`): chase the source so a call
  // through the intermediate binding classifies its result (nullable-closure read pattern).
  const src = identCopySourceSid(csid, fnIx)
  if src != "" && src != name { return calleeCloSigKey(src, fnIx) }
  // A binding whose initializer is a call: read the checker's recorded type directly, since
  // every rung above resolves a name and a call result is none of them. D945.
  let letIx = 0 - 1
  if fnIx >= 0 {
    const cfn = P.nodes[fnIx]
    if cfn is FuncDecl { letIx = parentLetOfSid(cfn.fnBody, csid) }
  }
  if letIx < 0 { letIx = globalLetOfSidIn(fnIx, csid) }
  if letIx >= 0 {
    const cd = P.nodes[letIx]
    if cd is LetDecl {
      if cd.letInit >= 0 {
        const cty = nodeTyIxOf(cd.letInit)
        if cty >= 0 {
          const ct = T.tys[cty]
          if ct is TyFunc { return sigKeyOfTy(cty) }
        }
      }
    }
  }
  ""
}

// True if the function-VALUE callee `name` (in scope of `fnIx`) returns f64 — its resolved
// `$fnsig` key's result kind is `"f64"`. Drives the closure-call RESULT classification
// (print routing, numeric-context coercion), the value-call analogue of `fRetF64` for a
// named function.
function calleeReturnsF64Sid(sid: i32, fnIx: i32) {
  calleeRetKindSid(sid, fnIx) == "f64"
}

// True if the function-value callee `name` (in scope of `fnIx`) returns void — its resolved
// `$fnsig` key carries the `>v` void marker (`sigKeyRetIsVoid`, not the `null` an unresolved
// key also decodes to). A void closure call leaves nothing on the stack, so its statement
// form must not `drop`.
export function calleeReturnsVoid(name: string, fnIx: i32) {
  sigKeyRetIsVoid(calleeCloSigKey(name, fnIx))
}

function calleeReturnsVoidSid(sid: i32, fnIx: i32) {
  sigKeyRetIsVoid(calleeCloSigKeySid(sid, fnIx))
}

// True if the function-VALUE callee `name` (in scope of `fnIx`) returns a string — its
// resolved `$fnsig` key's result kind is `"str"`. The value-call analogue of
// `fnRetString` for a named function — drives the closure-call RESULT's string typing
// (binding cell, print routing).
function calleeReturnsStringSid(sid: i32, fnIx: i32) {
  calleeRetKindSid(sid, fnIx) == "str"
}

// True if the function-VALUE callee `name` (in scope of `fnIx`) returns i64 — its resolved
// `$fnsig` key's result kind is `"i64"`. The value-call analogue of `fRetI64` for a named
// function — drives the closure-call RESULT's i64 typing (print routing, numeric-context
// coercion).
function calleeReturnsI64Sid(sid: i32, fnIx: i32) {
  calleeRetKindSid(sid, fnIx) == "i64"
}

// The struct-table index a function-value callee `name` (in scope of `fnIx`) returns, or
// -1. Its resolved `$fnsig` key's result kind is `"struct"` (`>sN;`) or `"nulstruct"`
// (`>nN;`); the slot digits parse through the shared result-slot reader. Drives the
// closure-call result's struct typing.
function calleeReturnsStructIdxSid(sid: i32, fnIx: i32) {
  const k = calleeCloSigKeySid(sid, fnIx)
  const rk = sigKeyRetKind(k)
  if rk == "struct" || rk == "nulstruct" { return sigKeyRetSlot(k) }
  -1
}

// The position of a `$fnsig` key's result token char — just past the last `>` (params never
// contain one) — or -1 for an empty/result-less key. The one last-`>` scan every result-side
// reader (`sigKeyRetKind`/`sigKeyRetIsVoid`/`sigKeyRetSlot`) decodes through, instead of
// re-scanning the key string per site. Not a type-name grammar — the `$fnsig` ABI alphabet.
function sigKeyRetTokIx(k: string) {
  const n = k.length
  let gt = -1
  let i = 0
  while i < n {
    if k[i] == '>' { gt = i }
    i = i + 1
  }
  if gt < 0 || gt + 1 >= n { return -1 }
  gt + 1
}

// The one home of the monomorphized closure pin's marker: the `$fnsig` key a closure-pinned
// parameter carries in its `TypeRef.tyName` slot behind a bare `"=>"` prefix (`"=>i>d"`), or
// "" when `nm` is not a pin. Not the function-type arrow (which sits at a positive index
// behind a parenthesized param list) — this asks whether the column holds an interned ABI key.
export function sigKeyPinPayload(nm: string) {
  if nm.length <= 2 { return "" }
  if nm[0] != '=' { return "" }
  if nm[1] != '>' { return "" }
  // Bound rather than left as the trailing expression: a bare member-call statement is not
  // a lowerable form, the same reason `arrElemNameRaw`/`annRetNameOf` bind their slices.
  const payload = nm.slice(2, nm.length)
  payload
}

// The result value-kind encoded in a closure `$fnsig` key (the atom after the final `>`), or
// `null` when the key is empty or malformed. Shared by the Ident-callee path
// (`calleeRetKindSid`), the indexed-element path (`cloArrCallRetKind`), and — for a
// monomorphized closure-pinned param — the instance-return pin (emit_mono).
export function sigKeyRetKind(k: string): VKind | null {
  const ti = sigKeyRetTokIx(k)
  if ti < 0 { return null }
  const c = k[ti]
  // Void is the ABSENCE of a result kind, not a member of the token
  // vocabulary — tested before the shared table.
  if c == 'v' { return null }
  // ONE vocabulary with the encode sites: the token decodes through the
  // canonical char→kind table (`repKindOfSigTok` — the inverse of the
  // `repSigTokOfKind` the encoders read). Every encoder arm must carry a decoder twin.
  repKindOfSigTok(c)
}

// True when a `$fnsig` key's result token is the literal void marker (`…>v`) —
// distinguishable from an EMPTY/unresolved key, which `sigKeyRetKind` folds into the
// same `null` a void result yields.
export function sigKeyRetIsVoid(k: string) {
  const ti = sigKeyRetTokIx(k)
  ti >= 0 && k[ti] == 'v'
}

// True when a closure value call's declared result is a value union but the resolved
// closure `$fnsig` reps its result as a non-union (the lambda self-infers its one concrete
// arm while the checker types the whole union) — rejects loudly here rather than leaking
// invalid wasm at the narrow that consumes it. A supported union result (keying `>u`) returns false.
export function cloCallUnionResultUnrepresentable(
  callIx: i32,
  fnIx: i32,
): boolean {
  // Case A: a nullable-closure-union result claims a box (`>u`) but no value union is
  // declared, so the box is never minted — reject here rather than trap on the tag read. #875.
  const ckeyA = cloCallSigKey(callIx, fnIx)
  if ckeyA != "" {
    const rkA = sigKeyRetKind(ckeyA)
    if rkA != null && rkA == "union" && !uDeclared { return true }
  }
  const ty = nodeTyIxOf(callIx)
  if ty < 0 { return false }
  // A nullable numeric-scalar result reps as the same value-union box as a nullable-scalar
  // union arm, so it needs the identical rep-consistency tail; `string|null`/`boolean|null` don't.
  const tn = T.tys[ty]
  if tn is TyNullable {
    // A never-filled `let x = null` captured by a lambda gives it the open null-hole as its
    // inferred result, so `nInner` is -1 here — representable as `null`'s own rep, not a refusal. D1576.
    if tn.nInner < 0 || tn.nInner >= T.tys.length { return false }
    const nit = T.tys[tn.nInner]
    let nulBoxScalar = false
    if nit is TyPrim {
      const pn = nit.primName
      if pn == "i32" || pn == "f64" || pn == "i64" || pn == "f32" {
        nulBoxScalar = true
      }
    }
    if !nulBoxScalar {
      // A nullable value-union result wraps the union in `TyNullable`, bypassing the main
      // union branch — route the inner union through the same analysis so it floors, not traps.
      if nit is TyUnion { return cloCallUnionMixUnrep(tn.nInner, callIx, fnIx) }
      return false
    }
    const nkey = cloCallSigKey(callIx, fnIx)
    if nkey == "" { return true }
    const nrk = sigKeyRetKind(nkey)
    if nrk == null { return true }
    if nrk != "union" { return true }
    return cloSigPosOfKey(nkey) < 0
  }
  if !(T.tys[ty] is TyUnion) { return false }
  return cloCallUnionMixUnrep(ty, callIx, fnIx)
}

// The scalar+composite value-union analysis of `cloCallUnionResultUnrepresentable`, factored
// so both a direct `TyUnion` result and a nullable-wrapped union result (which bypasses the
// main branch) run the identical representability test. `ty` is the union type index;
// `callIx`/`fnIx` drive the `$fnsig` producer checks.
function cloCallUnionMixUnrep(ty: i32, callIx: i32, fnIx: i32): boolean {
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  if t.uMembers.length < 2 { return false }
  // A "boxing" union needs at least one scalar member and one composite member — their reps
  // differ, so the closure result needs the shared box; a rep-uniform union already lowers.
  let hasScalar = false
  let hasComposite = false
  let i = 0
  while i < t.uMembers.length {
    const mt = T.tys[t.uMembers[i]]
    if mt is TyPrim {
      hasScalar = true
    } else if mt is TyLit {
      // A litunion member reps as an i32 atom, so a litunion+composite mix is as
      // rep-heterogeneous as a scalar mix — it needs the box too; a pure litunion stays uniform.
      hasScalar = true
    } else if tyIsLitUnion(t.uMembers[i]) {
      hasScalar = true
    } else if mt is TyObj {
      hasComposite = true
    } else if mt is TyArray {
      hasComposite = true
    } else if mt is TyMap {
      hasComposite = true
    } else if mt is TyFunc {
      hasComposite = true
    }
    i = i + 1
  }
  if !hasComposite { return false }
  // Rep-consistent only when the resolved `$fnsig` result is the union box (`>u`); a concrete-
  // member result or no sig means the box read has nothing to recover — the deferred hole.
  const ckey = cloCallSigKey(callIx, fnIx)
  if ckey == "" { return hasScalar }
  const rk = sigKeyRetKind(ckey)
  if rk == null { return hasScalar }
  if rk != "union" { return hasScalar }
  // A `>u` key alone is not consistency — some producer must have actually interned that
  // box functype; an un-interned `>u` is the same deferred hole for the mix.
  if cloSigPosOfKey(ckey) < 0 { return hasScalar }
  // The `>u` box can be interned (e.g. by an outer nullable-closure annotation) while the
  // producer lambda self-inferred a non-union arm — an iso-recursive twin-cast trap. #938.
  const pk = callProducerCloSigKey(callIx, fnIx)
  if pk != "" && pk != ckey {
    const prk = sigKeyRetKind(pk)
    if prk != null && prk != "union" { return true }
  }
  // A param-fed closure (no resolvable producer) with a map-array union arm: its direct
  // binding already rejects, but a nullable-closure annotation interns the box, slipping the check.
  if pk == "" && tyUnionHasMapArrayArm(ty) { return true }
  // The closure-array sibling of the map-array arm above: a param-fed union with a closure-
  // array arm slips the same check via an outer `| null` interning the box.
  if pk == "" && tyUnionHasClosureArrayArm(ty) { return true }
  // The litunion-2D-array sibling of the two arms above: a nested litunion array folds to a
  // slot the box doesn't yet compose through, slipping the check the same way.
  if pk == "" && tyUnionHasLitUnionNestedArrayArm(ty) { return true }
  // An indexed closure-array-element callee (`f[0]()`) whose result union has a value-union
  // element-array arm: a param-fed array has no producer to verify its actual arm. #1034.
  if tyUnionHasValueUnionElemArrayArm(ty) {
    if calleeIsIndexedRefArrayCall(callIx, fnIx) {
      if pk == "" { return true }
      const prkI = sigKeyRetKind(pk)
      if prkI == null || prkI != "union" { return true }
    }
  }
  false
}

// True when the `TyUnion` at `ty` has a member that is an array whose element is itself a
// value union (`(i64 | boolean)[]`) — the deferred hole in a closure-result union, since the
// box-of-value-union-element-array rep does not yet compose through a closure result. A
// struct/closure/plain-scalar-list arm is not flagged — those rep fine.
function tyUnionHasValueUnionElemArrayArm(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    const m = T.tys[t.uMembers[i]]
    if m is TyArray {
      const el = T.tys[m.aElem]
      if el is TyUnion {
        // A VALUE union element (2+ members, at least one scalar) — not a variant union.
        if el.uMembers.length >= 2 {
          let hasPrim = false
          let j = 0
          while j < el.uMembers.length {
            if T.tys[el.uMembers[j]] is TyPrim { hasPrim = true }
            j = j + 1
          }
          if hasPrim { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// True when `mt` is a declared member of the union type `ut` — used by the `is` emitter's
// loud floor to tell apart "not a union variant" (the tested type isn't in the union) from
// "a declared member with no interned rep" (the arm is checker-approved but nothing ever
// boxed a value into it). A nullable union receiver peels; structural, because VL is.
export function tyIsUnionMemberOf(ut: i32, mt: i32): boolean {
  if ut < 0 || mt < 0 { return false }
  let u = ut
  const un = T.tys[u]
  if un is TyNullable { u = un.nInner }
  if u < 0 { return false }
  const t = T.tys[u]
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    if tySame(t.uMembers[i], mt) { return true }
    i = i + 1
  }
  false
}

// True when the `TyUnion` at `ty` has a member that is an array whose element is a map
// (`{[string]: f32}[]`) — a deferred hole in a closure-result value union, since the
// box-of-map-array rep does not yet compose through a closure result. A struct-array,
// plain scalar-list, struct, or closure arm is not flagged — those rep fine.
function tyUnionHasMapArrayArm(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    const m = T.tys[t.uMembers[i]]
    if m is TyArray {
      if T.tys[m.aElem] is TyMap { return true }
    }
    i = i + 1
  }
  false
}

// True when the `TyUnion` at `ty` has a member that is an array whose element is a closure
// (a nullable-closure element peels its `| null` to the `TyFunc`) — a deferred hole in a
// closure-result value union, since the box-of-closure-array rep does not yet compose
// through a closure result. A struct-array or scalar-list arm is not flagged.
function tyUnionHasClosureArrayArm(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    const m = T.tys[t.uMembers[i]]
    if m is TyArray {
      let el = m.aElem
      const en = T.tys[el]
      if en is TyNullable { el = en.nInner }
      if el >= 0 {
        if T.tys[el] is TyFunc { return true }
      }
    }
    i = i + 1
  }
  false
}

// True when the `TyUnion` at `ty` has a member that is a nested (2-D+) array whose leaf
// element is a litunion (`K0[][]`) — a deferred hole in a closure-result value union, since
// the litunion 2-D array folds to a distinct wrapper slot that does not yet compose through
// the box. A 1-D litunion array or a scalar-leaf nested array reps fine — gate precisely.
function tyUnionHasLitUnionNestedArrayArm(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    const m = T.tys[t.uMembers[i]]
    if m is TyArray {
      const el = T.tys[m.aElem]
      // A NESTED array: the outer array's element is itself an array. Walk to the leaf.
      if m.aElem >= 0 && el is TyArray {
        let leaf = m.aElem
        while leaf >= 0 {
          const lt = T.tys[leaf]
          if lt is TyArray { leaf = lt.aElem } else { break }
        }
        if leaf >= 0 && tyIsLitUnion(leaf) { return true }
      }
    }
    i = i + 1
  }
  false
}

// The concrete PRODUCER lambda's `$fnsig` key for a value-CALL whose callee is a plain
// Ident binding — the functype the closure VALUE actually carries. "" for a non-Ident
// callee or an unresolvable producer.
function callProducerCloSigKey(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cre = P.nodes[c.callFn]
    if cre is Ident { return producerCloSigKey(cre.identName, fnIx) }
  }
  ""
}

// True when a call's callee is an index into a ref (closure) array (`f[0]()`): the element
// sig comes from the array-element annotation, not a resolvable producer lambda. Used by
// the union-result floor to reject the deferred scalar+composite closure-result union in
// this spelling (the array element may hold a lambda that self-inferred a non-box arm).
function calleeIsIndexedRefArrayCall(callIx: i32, fnIx: i32): boolean {
  const c = P.nodes[callIx]
  if c is Call {
    const cre = P.nodes[c.callFn]
    if cre is Index { return exprRefArray(cre.idxArr, fnIx) }
  }
  false
}

// The interned slot of a slot-carrying result token (`>s3;`, `>n1;`, `>V0;`, `>r2;`,
// `>m0;`) — the `;`-terminated decimal after the token char — or -1 when the key's result
// kind carries no slot or the digits are malformed. The one result-slot digit parser;
// callers gate on `sigKeyRetKind` for which table the slot indexes.
function sigKeyRetSlot(k: string) { sigSlotAtTok(k, sigKeyRetTokIx(k)) }

// The `;`-terminated decimal SLOT of the token starting at `ti`, or -1 when `ti` names no
// token or that kind carries no slot / malformed digits. The ONE slot-digit parse, read by
// both key decoders that want one (`sigKeyRetSlot` for the result token, `sigParamSlotAt`
// for the param spine).
function sigSlotAtTok(k: string, ti: i32): i32 {
  if ti < 0 || ti >= k.length { return -1 }
  if !repSigTokHasSlot(repKindOfSigTok(k[ti])) { return -1 }
  let j = ti + 1
  let acc = 0
  let saw = false
  while j < k.length && k[j] != ';' {
    const d = k[j]
    if d < '0' || d > '9' { return -1 }
    acc = acc * 10 + (d - '0')
    saw = true
    j = j + 1
  }
  if !saw { return -1 }
  acc
}

// The `cloRetValKind`-style result kind of a function-value callee (by `sid`, in scope of
// `fnIx`), decoded from its resolved `$fnsig` key — the `VKind` the trailing `>X` token
// names, or `null` for a void result or when the callee resolves to no value-call sig (the
// two are indistinguishable here; no consumer needs to tell them apart).
function calleeRetKindSid(sid: i32, fnIx: i32): VKind | null {
  return sigKeyRetKind(calleeCloSigKeySid(sid, fnIx))
}

// The result value-kind of a call whose callee is an index into a closure array (`fs[i](x)`):
// the closure-element signature's return atom. `null` when the call's callee is not an
// indexed closure value. The expr classifiers consult this so an indexed closure call's
// result routes to the right print/arithmetic/store path.
function cloArrCallRetKind(callIx: i32, fnIx: i32): VKind | null {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Index {
      if exprRefArray(callee.idxArr, fnIx) {
        return sigKeyRetKind(
          cloArrSlotSigKey(refListSlotOfExpr(callee.idxArr, fnIx)),
        )
      }
    }
  }
  null
}

function paramCloSigKey(fnIx: i32, name: string) {
  if fnIx < 0 { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name {
          // The moved callee's own key wins over the annotation's (D940): a `??` merge can
          // move the rows of the one function this slot ever receives.
          const mvk = anonLeafCloSlotSigKey(params[i])
          if mvk != "" { return mvk }
          if p.parType >= 0 {
            // A monomorphized closure-pinned param announces itself in the pin column, which
            // also carries the `$fnsig` key — read where it lives, not by prefix-testing the name.
            const pin = nodePinPayloadOf(p.parType)
            if pin != "" { return pin }
            const ty = P.nodes[p.parType]
            if ty is TypeRef {
              const nm = ty.tyName
              if nm.length > 2 {
                // The parser's tree, not a character scan: asks whether the annotation spells a
                // function type anywhere, including inside a union arm (unlike the narrower arena test).
                if annCloSigSpelled(p.parType, nm) {
                  // The arena builds the key, the name is the fall-through: `sigKeyOfTy` skips
                  // parsing the rendered function type back into params and a return.
                  const pty = nodeTyIxOf(p.parType)
                  if pty >= 0 {
                    const pt = T.tys[pty]
                    if pt is TyFunc {
                      const ak = sigKeyOfTy(pty)
                      if ak != "" { return ak }
                    } else if pt is TyNullable {
                      const pin = T.tys[pt.nInner]
                      if pin is TyFunc {
                        const ak2 = sigKeyOfTy(pt.nInner)
                        if ak2 != "" { return ak2 }
                      }
                    }
                  }
                  return cloNameSigKey(nm)
                }
              }
            }
          }
          return ""
        }
      }
      i = i + 1
    }
  }
  ""
}

// True if the function at `fnStmts` position `t` returns a function value — its body's
// tail expression is itself a function value (a bare function name, a `function(...)`
// literal, or a closure-typed local). Drives `exprIsClosure` for call results
// (`const f = makeAdder(5)` where `makeAdder` returns its inner closure).
export function fnReturnsClosure(t: i32) {
  if t < 0 || t >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[t]]
  if fn is FuncDecl {
    // An annotated function-type return is a closure result regardless of how the body yields
    // it (a higher-order call the tail scan can't see), since the valtype is already kind 14.
    if fn.fnRet >= 0 && tyIsFuncType(fn.fnRet) { return true }
    return blockTailIsClosure(fn.fnBody, fnStmts[t])
  }
  false
}

// True if the block's tail (implicit-return) expression is a function value.
function blockTailIsClosure(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return false }
    const last = stmts[n - 1]
    const s = P.nodes[last]
    if s is RetStmt {
      if s.retArg >= 0 { return exprIsClosureNoLocal(s.retArg, fnIx) }
      return false
    }
    return exprIsClosureNoLocal(last, fnIx)
  }
  false
}

// The declaration half of `exprIsClosureNoLocal`'s binding arm: "does this `let`/`const`
// hold a function value", without the locals registry. The annotation decides it outright;
// an un-annotated binding is claimed only by a one-node-read initializer. Deliberately not
// recursive — a chained initializer is left to `exprIsClosure`, since a scan here could loop.
export function letDeclIsClosureNoLocal(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return tyIsFuncType(d.letType) }
    if d.letInit < 0 { return false }
    const u = unwrapParen(d.letInit)
    const ui = P.nodes[u]
    if ui is FuncDecl { return true }
    if ui is Ident { return fnIndexOfSid(sidOfNode(u)) >= 0 }
  }
  false
}

// `exprIsClosure` restricted to forms safe to query during return-kind classification
// (avoids recursion through `declaredSlotOf`, which needs the local registry built): a
// function name, a `function(...)` literal, or an object field — the arm this ladder
// lacked, a closure-typed param or local returned by name.
function frameBindingNode(fnIx: i32, name: string): i32 {
  if fnIx < 0 { return -1 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name { return params[i] }
      }
      i = i + 1
    }
    const li = parentLetOf(fn.fnBody, name)
    if li >= 0 { return li }
    return parentLoopVarOf(fn.fnBody, name)
  }
  -1
}

// The binding a bare identifier denotes, seen from inside the function at arena index
// `fnIx`: this frame's own param/`let`/`for` variable, else the nearest enclosing frame
// that binds it (a capture there). -1 when no scope in the chain binds it — the only case
// where the name can denote a module-level global or function.
function identBindingNoLocal(fnIx: i32, name: string): i32 {
  const own = frameBindingNode(fnIx, name)
  if own >= 0 { return own }
  let pp = fnStmtsPosOf(fnIx)
  // `fnStmts.length` bounds the walk the way `fnIndexOfInScopeSid`'s does: a parent chain
  // cannot outrun the function count, so a malformed `fnParent` cannot spin here.
  let steps = 0
  while pp >= 0 && steps <= fnStmts.length {
    if pp >= fnParent.length { return -1 }
    pp = fnParent[pp]
    if pp < 0 || pp >= fnStmts.length { return -1 }
    const hit = frameBindingNode(fnStmts[pp], name)
    if hit >= 0 { return hit }
    steps = steps + 1
  }
  -1
}

function exprIsClosureNoLocal(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprIsClosureNoLocal(e.parInner, fnIx) }
  if e is FuncDecl { return true }
  if e is Ident {
    // The scope must be asked first: a module-wide function lookup ranks below every scope
    // question, or a shadowing param/let/for-var would misclassify as the function.
    const b = identBindingNoLocal(fnIx, e.identName)
    if b >= 0 {
      const bn = P.nodes[b]
      if bn is Param { return tyIsFuncType(bn.parType) }
      if bn is LetDecl { return letDeclIsClosureNoLocal(b) }
      // A `for` variable: an i32 counter, or an element of the iterated list. Neither is
      // a bare function NAME, which is all this no-registry predicate can claim.
      return false
    }
    if moduleBindsLoopVar(emitRootIx, e.identName) { return false }
    // The module is the outermost frame, and the chain above never reaches it (D1542): a
    // top-level lambda's `fnParent` walk ends at -1, missing a module-scope capture.
    const mll = moduleLocalLetOf(emitRootIx, e.identName)
    if mll >= 0 { return letDeclIsClosureNoLocal(mll) }
    const gcl = globalLetOf(e.identName)
    if gcl >= 0 { return letDeclIsClosureNoLocal(gcl) }
    return fnIndexOfSid(sidOfNode(exprIx)) >= 0
  }
  if e is ObjLit { return false }
  false
}

// True if member access `obj.prop` yields a function value — `prop` is a struct field
// whose declared type is a function type. (For `objects/equality-function-field.vl` and
// `escaping.vl`'s `o.go`.) Resolved against the receiver's struct table fields.
function memberIsClosure(objIx: i32, prop: string, fnIx: i32) {
  const si = structIndexOfExpr(objIx, fnIx)
  if si >= 0 { return structFieldIsClosure(si, prop) }
  // A narrowed union receiver: the struct index isn't resolvable from the declared union
  // type, so read the closure field code off the narrowed variant's own field tables instead.
  const o = P.nodes[unwrapParen(objIx)]
  if o is Ident {
    const nv = narrowVariantFor(o.identName)
    if nv != "" {
      const vi = variantIndexOf(nv)
      if vi >= 0 {
        const vfi = variantFieldIndex(vi, prop)
        if vfi >= 0 {
          const vfc = variantFieldTypeAt(vi, vfi)
          return vfc == 14 || vfc == 22
        }
      }
    }
  }
  false
}

// True if field `prop` of struct table index `si` is a function-valued field — a bare
// closure (code 14) or a NULLABLE closure (code 22). Both read back as a closure and call
// via `call_ref`; the nullable one is recovered to non-null at the call site.
function structFieldIsClosure(si: i32, prop: string) {
  if si < 0 || si >= sNames.length { return false }
  const cnt = sFieldCount[si]
  const start = sFieldStart[si]
  let fj = 0
  while fj < cnt {
    if sFieldNames[start + fj] == prop {
      const fc = sFieldTypeAt(si, fj)
      return fc == 14 || fc == 22
    }
    fj = fj + 1
  }
  false
}

// `xs.pop()`/`xs.get(i)` over a struct-element ref list — the host types both as `S | null`.
// Returns the element struct table index, or -1 when the call is not such a read.
// Restricted to plain-struct elements: map-array and union-element pops keep their
// existing classification (`g_maparray`'s golden bytes depend on it).
export function structListPopGetElem(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "pop" || callee.memProp == "get" {
        if exprRefArray(callee.memObj, fnIx) {
          const slot = refListSlotOfExpr(callee.memObj, fnIx)
          if slot >= 0 && slot < rlElemKindTbl.length {
            if rlElemKindTbl[slot] == 1 { return rlElemStructRow(slot) }
          }
        }
      }
    }
  }
  -1
}

// ── `.map` / `.filter` classification (Slices 3–4) ─────────────────────────────

// True if the expression at `exprIx` is a `.map`/`.filter` HOF call over a LIST
// receiver (one callback argument). A member call named `map`/`filter` over a
// NON-list receiver (e.g. a function-valued struct field) is NOT a HOF site.
function callIsMapFilter(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "map" || callee.memProp == "filter" {
        if e.callArgs.length == 1 {
          return mfRecvKindOf(callee.memObj, fnIx) != null
        }
      }
    }
  }
  false
}

// True if the expression at `exprIx` is an array `.slice(start, end?)` over a LIST
// receiver — a sublist of the SAME element type. (A string `.slice` is a separate
// `exprIsStrSlice` path; this is the array dual.)
export function callIsArrSlice(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "slice" {
        if e.callArgs.length == 1 || e.callArgs.length == 2 {
          return mfRecvKindOf(callee.memObj, fnIx) != null
        }
      }
    }
  }
  false
}

// The RECEIVER list kind of a `.map`/`.filter` call: `0` (i32/boolean list), `1`
// (f64 list), `2` (struct/union ref list), or -1 (not a supported list — a string
// list or a non-list receiver).
export function mfRecvKindOf(recvIx: i32, fnIx: i32): MfKind | null {
  if exprF64Array(recvIx, fnIx) { return "f64" }
  if exprI64Array(recvIx, fnIx) { return "i64" }
  if exprF32Array(recvIx, fnIx) { return "f32" }
  if exprRefArray(recvIx, fnIx) { return "ref" }
  if exprStringArray(recvIx, fnIx) { return "str" }
  // The packed byte list before `exprArray` (D1141): `u8[]`'s backing differs from every
  // other i32-element list, so a `.slice` must pick this rep or mint the wrong wrapper.
  if exprU8Array(recvIx, fnIx) { return "u8" }
  if exprArray(recvIx, fnIx) { return "i32" }
  null
}

// The result element kind of the `.map`/`.filter` call at `callIx`: `0` (i32/boolean
// element), `1` (f64 element), or -1 (unsupported). `filter` keeps the receiver's element
// kind (a ref-list filter fails loudly at emit); `map`'s result element kind is the
// callback's return kind (`cloRetKindOf`).
export function mfResultKindOf(callIx: i32, fnIx: i32): MfKind | null {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // `.slice` preserves the element type — its result kind IS the receiver's.
      if callee.memProp == "slice" { return mfRecvKindOf(callee.memObj, fnIx) }
      if callee.memProp == "filter" { return mfRecvKindOf(callee.memObj, fnIx) }
      if c.callArgs.length == 1 {
        const fe = mfCallbackFe(c.callArgs[0], fnIx)
        if fe < 0 {
          // A closure-value callback (`xs.map(f)`, `f` a function-typed param/binding) — its result
          // kind comes from the closure's sig RETURN token, not a lifted fe (scalar returns only).
          const ck = mfCallbackCloKey(c.callArgs[0], fnIx)
          if ck != "" { return mfResKindFromSigRet(sigKeyRetKind(ck)) }
          return null
        }
        // A string-returning callback maps to a string-list result (kind 3) — checked first
        // since `cloRetKindOf` folds string into -1.
        if cloRetIsString(fe) { return "str" }
        // A struct-returning callback maps to a new ref list of the result struct — consult
        // `cloRetValKind` directly, since the result element type differs from the source.
        if cloRetValKind(fe) == "struct" { return "ref" }
        // A concrete-variant-returning callback maps to a ref list of bare variant structs —
        // checked before the union case since `cloRetValKind` already prefers the variant.
        if cloRetValKind(fe) == "variant" { return "ref" }
        // A union-returning callback maps to a ref list of union boxes; all unions share
        // `$uBox`, so the result element is the declared union.
        if cloRetValKind(fe) == "union" { return "ref" }
        // A nullable-string-returning callback maps to the same `(string | null)[]` string
        // list — `cloRetKindOf` folds the niche into i32, so consult `cloRetValKind` instead.
        if cloRetValKind(fe) == "nulstr" { return "str" }
        // An i64-/f32-returning callback maps to an i64-/f32-list result — `cloRetKindOf`
        // folds these to -1 (out of the value-call ABI), so consult `cloRetValKind` directly.
        if cloRetValKind(fe) == "i64" { return "i64" }
        if cloRetValKind(fe) == "f32" { return "f32" }
        // The `.map` dual of `fnSigKeyOf`'s key/bytes interlock: claim i32/f64 only when the
        // coarse `cloRetKindOf` agrees with the honest `cloRetValKind`; else fall to a loud reject.
        const rk2 = cloRetKindOf(fe)
        const vk2 = cloRetValKind(fe)
        if rk2 == "i32" && vk2 == "i32" { return "i32" }
        if rk2 == "f64" && vk2 == "f64" { return "f64" }
      }
      return null
    }
  }
  null
}

// The ref-list table slot of a kind-2 `.map`/`.filter` result, or -1. `.filter` preserves the
// receiver's element list, so the result slot IS the source ref-list slot.
export function mfResultSlotOf(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // `.slice` preserves the ref-list element — its result slot IS the receiver's.
      if callee.memProp == "slice" {
        if mfRecvKindOf(callee.memObj, fnIx) == "ref" {
          return refListSlotOfExpr(callee.memObj, fnIx)
        }
      }
      if callee.memProp == "filter" {
        if mfRecvKindOf(callee.memObj, fnIx) == "ref" {
          return refListSlotOfExpr(callee.memObj, fnIx)
        }
      }
      // A STRUCT-returning `.map`: the result is a NEW ref list whose element is the
      // callback's RETURN struct — its ref-list slot (interned by `mfScan`).
      if callee.memProp == "map" && c.callArgs.length == 1 {
        const fe = mfCallbackFe(c.callArgs[0], fnIx)
        if fe >= 0 && cloRetValKind(fe) == "struct" {
          const si = cloRetValSlot(fe)
          if si >= 0 && si < sNames.length {
            // Arena route, one layer up from the rep tables: the struct row's own `sTyIx`
            // already carries its type, so `rlSlotOfTy` needs no spelling to be produced at all.
            let elemTy = -1
            if si < sTyIx.length { elemTy = sTyIx[si] }
            const aRow = rlSlotOfTy(elemTy)
            if aRow >= 0 { return aRow }
            return rlSlotByName(sNames[si])
          }
        }
        // A struct-returning closure-value callback: no lifted fe, so the result struct
        // index comes from the closure's `>s<idx>;` sig-return token instead.
        if fe < 0 {
          const ck = mfCallbackCloKey(c.callArgs[0], fnIx)
          if ck != "" && sigKeyRetKind(ck) == "struct" {
            const csi = sigKeyRetSlot(ck)
            if csi >= 0 && csi < sNames.length {
              let cElemTy = -1
              if csi < sTyIx.length { cElemTy = sTyIx[csi] }
              const cRow = rlSlotOfTy(cElemTy)
              if cRow >= 0 { return cRow }
              return rlSlotByName(sNames[csi])
            }
          }
        }
        // A concrete-VARIANT `.map`: the result element is the variant — its ref-list slot
        // is keyed by the variant NAME (`uVariants[vi]`).
        if fe >= 0 && cloRetValKind(fe) == "variant" {
          const vi = cloRetValSlot(fe)
          if vi >= 0 && vi < uVariants.length {
            return rlSlotByName(uVariants[vi])
          }
        }
        // A UNION-returning `.map`: the result is a ref list of the declared union (all
        // unions share `$uBox`, so the element key is the union alias name).
        if fe >= 0 && cloRetValKind(fe) == "union" && unNames.length > 0 {
          return rlSlotByName(unNames[0])
        }
      }
    }
  }
  -1
}

// Resolve a `.map`/`.filter` callback argument to its lifted-function position in `fnStmts`:
// an inline `function(...)` literal, a named function reference, or a let-bound function
// value whose initializer is one of those. -1 when unresolvable. The named-reference rung
// resolves through the innermost-declaring scope (`fnIndexOfInScope`), not a flat lookup. #1204.
export function mfCallbackFe(cbIx: i32, fnIx: i32) {
  if cbIx < 0 { return -1 }
  const inner = unwrapParen(cbIx)
  const e = P.nodes[inner]
  if e is FuncDecl { return fnStmtsPosOf(inner) }
  if e is Ident {
    const t = fnIndexOfInScope(e.identName, fnIx)
    if t >= 0 { return t }
    let li = -1
    // The frame whose scope the binding's initializer is elaborated in: a global's init is
    // elaborated at top level, so resolving it against the calling frame could hijack it.
    let initFn = fnIx
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 {
      li = globalLetOfIn(fnIx, e.identName)
      if li >= 0 { initFn = -1 }
    }
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letInit >= 0 {
          // Guard the degenerate self-referential binding against infinite recursion.
          if unwrapParen(d.letInit) != inner {
            return mfCallbackFe(d.letInit, initFn)
          }
        }
      }
    }
  }
  -1
}

// True if the lifted callback at `fe` returns a BOOLEAN (its annotation, or the
// inferred `fRetBool`) — the element-bool-ness of a `.map` result, threaded to the
// print import choice (`__print_bool__` renders true/false).
function mfCbRetIsBool(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      // Drops the `rt is TypeRef` gate the spelling path needed: a non-`TypeRef` return
      // annotation still has a recorded type, so the name form couldn't even ask.
      return tyIsBool(fn.fnRet)
    }
    if fe < fRetBool.length { return fRetBool[fe] == 1 }
  }
  false
}

// True if an index read over the list at `arrIx` yields a boolean element. Today the
// only boolean-element list producer is a `.map` whose callback returns boolean
// (`xs.map(function(n: i32) n > 2)`); a `.filter` keeps its receiver's element
// bool-ness, and a module-global binding traces through its initializer.
function mfArrElemIsBool(arrIx: i32, fnIx: i32) {
  if arrIx < 0 { return false }
  const inner = unwrapParen(arrIx)
  const e = P.nodes[inner]
  if e is Call {
    if callIsMapFilter(inner, fnIx) {
      const callee = P.nodes[e.callFn]
      if callee is Member {
        if callee.memProp == "filter" {
          return mfArrElemIsBool(callee.memObj, fnIx)
        }
        return mfCbRetIsBool(mfCallbackFe(e.callArgs[0], fnIx))
      }
    }
    return false
  }
  if e is Ident {
    const li = globalLetOfIn(fnIx, e.identName)
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letInit >= 0 {
          if unwrapParen(d.letInit) != inner {
            return mfArrElemIsBool(d.letInit, -1)
          }
        }
      }
    }
  }
  false
}

// True if `ix` is a bare identifier naming a top-level or lifted function — the shape a
// `.map`/`.filter` callback takes by plain reference rather than as a closure literal.
export function exprIsBareFnName(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Ident { return fnIndexOfSid(sidOfNode(ix)) >= 0 }
  false
}

// The result type name of lifted function `fe` (`i32`, `string`, `i32[]`, a struct name,
// …) — its declared return annotation, or the inferred kind mapped back to a name, for
// building a closure argument's function-type name for generic binding.
export function cloRetTypeName(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return tyNameOf(fn.fnRet) }
  }
  const k = cloRetValKind(fe)
  if k == "i32" { return "i32" }
  if k == "f64" { return "f64" }
  if k == "i64" { return "i64" }
  if k == "f32" { return "f32" }
  if k == "str" { return "string" }
  if k == "list" { return "i32[]" }
  if k == "strlist" { return "string[]" }
  if k == "f64list" { return "f64[]" }
  if k == "struct" {
    const slot = cloRetValSlot(fe)
    if slot >= 0 && slot < sNames.length { return sNames[slot] }
  }
  ""
}

// The function-type nominalizer, on the arena: built from `TyFunc`'s own param and result
// types instead of by slicing a rendered function name apart and re-parsing each piece.
// Each part is nominalized by `shapeNominalOfTy` and otherwise rendered. "" means the type
// is not a `TyFunc`. A litunion alias keeps its name at both parameter and result positions.
function nominalizePartOfTy(ty: i32): string {
  const al = litUnionAliasNameOfTy(ty)
  if al != "" { return al }
  const sn = shapeNominalOfTy(ty)
  if sn != "" { return sn }
  tyToEmitName(ty)
}

export function nominalizeFnTypeOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if !(t is TyFunc) { return "" }
  let out = "("
  const pts = t.fnParamTypes
  let i = 0
  while i < pts.length {
    if i > 0 { out = out + "," }
    out = out + nominalizePartOfTy(pts[i])
    i = i + 1
  }
  out + ")=>" + nominalizePartOfTy(t.fnRet)
}

// Does struct `si` carry a closure-valued field `name` (code 14)?
export function drwFieldClosure(si: i32, name: string) {
  if si < 0 { return false }
  const fi = sFieldIndex(si, name)
  if fi < 0 { return false }
  sFieldTypeAt(si, fi) == 14
}

// The arena rung of `resolveShapeToNominal` below, for the one consumer whose input is a
// recorded type rather than a spelling. "" means the arena does not resolve this — fall
// through to the name ladder, not "no nominal". No variant rung: `variantRowOfTy` would fit,
// but for a union of structurally identical arms the arena legitimately holds arm 0's type. B107.
export function shapeNominalOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    const inner = shapeNominalOfTy(t.aElem)
    if inner == "" { return "" }
    return inner + "[]"
  }
  const si = structIndexOfTy(ty)
  if si >= 0 { return sNames[si] }
  // The arena's variant rung, the exact complement of the struct rung above — both answer by
  // declaration identity. Without it, a union arm beside a same-layout struct order-collided. D33.
  const av = variantRowOfTy(ty)
  if av >= 0 { return uVariants[av] }
  const fs = structRowOfObjFieldSetK(ty, false)
  if fs >= 0 { return sNames[fs] }
  const vr = variantRowOfObjFieldSetK(ty, false)
  if vr >= 0 { return uVariants[vr] }
  // The widened passes, both tables, below both strict ones (D733): a widened struct match
  // must not outrank a strict variant one, so the two scans are called at separate levels.
  const fw = structRowOfObjFieldSetK(ty, true)
  if fw >= 0 { return sNames[fw] }
  const vw = variantRowOfObjFieldSetK(ty, true)
  if vw >= 0 { return uVariants[vw] }
  ""
}

// `shapeNominalOfTy` asked of an ARRAY's ELEMENT: peel the `TyArray`, then resolve. "" when the
// node is not an array or the element does not resolve to a declared row.
export function arrElemNominalOfTy(arrIx: i32): string {
  const aty = nodeTyIxOf(arrIx)
  if aty < 0 { return "" }
  const at = T.tys[aty]
  if at is TyArray { return shapeNominalOfTy(at.aElem) }
  ""
}

// The map-value twin of `arrElemNominalOfTy` (D88): `shapeNominalOfTy` recurses through
// `TyArray`, but nothing asked it about a map value, so `tyToEmitName` rendered a declared
// arm structurally there instead — two map structs for one map, `vl check` rc 0 and the
// engine refusing. `variantRowOfTy` is the narrowing kept; only the value text changes.
export function nodeMapArmNominalName(ix: i32): string {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyMap {
    const vr = variantRowOfTy(t.mVal)
    if vr < 0 { return "" }
    if vr >= uVariants.length { return "" }
    const whole = tyToEmitName(ty)
    if mapSpellKeyEnd(whole) < 0 { return "" }
    return "{[" + mapSpellKeyName(whole) + "]:" + uVariants[vr] + "}"
  }
  ""
}

export function resolveShapeToNominal(name: string) {
  if name == "" { return "" }
  if nameIsArray(name) {
    const inner = resolveShapeToNominal(arrElemNameRaw(name))
    if inner == "" { return "" }
    return inner + "[]"
  }
  const si = structIndexOfTypeName(name)
  if si >= 0 { return sNames[si] }
  const vti = variantIndexOfTypeName(name)
  if vti >= 0 { return uVariants[vti] }
  name
}

// Does the annotation at `ix` spell a function type anywhere? The tree when it survives,
// the rendered name's arrow scan when it does not.
function annCloSigSpelled(ix: i32, nm: string): boolean {
  const root = annTsOf(ix)
  if root >= 0 { return tsHasKind(root, TS_FUNC) }
  strContains(nm, "=>")
}

// Is the annotation at `ix` spelled as a top-level function type? The tree's root kind where
// the tree survives, `annArrowAt`'s depth-0 scan of the rendering where it does not.
function annIsTopLevelFunc(ix: i32, nm: string): boolean {
  const root = annTsOf(ix)
  if root >= 0 { return tsKind[root] == TS_FUNC }
  annArrowAt(nm) >= 0
}

// Is the annotation at `ix` spelled as an inline object shape (`{a: i32}`, not a map
// `{[k]: v}`)? The tree's root kind where the tree survives, the rendering's opening
// characters where it does not.
function annIsSpelledInlineShape(ix: i32, nm: string): boolean {
  const root = annTsOf(ix)
  if root >= 0 { return tsKind[root] == TS_OBJ }
  nameIsShapeSpanEnds(nm)
}
