// The facts the IR verifier checks a function against that only legacy's planners know, noted on
// the function by node before it is verified, so `ir_verify.vl` asks legacy nothing (D17049).
import {
  IrFn,
  IrNode,
  OImm,
  OStr,
  OVar,
  Opnd,
  RAtomStr,
  RCall,
  RGetField,
  RGlobalGet,
  RLitArms,
  RMakeRec,
  RMapGet,
  RMemOp,
  RNullOf,
  RRetag,
  Rhs,
  SEffect,
  SGlobalSet,
  SLet,
  SReturn,
  irGlobalRepOf,
  irSigOf,
} from "./ir"
import { Call, IsExpr, nodeAt } from "./ast"
import { irTyOpen, irUntypedClosure, u8sSame } from "./ir_verify"
import { RClosure, RList, RNullable, repNodeAt, repNodeKids, repOfTy, repTyOf } from "./emit_rep"
import { closureHeld, tyOpenHeldAsIds } from "./emit_classify"
import { fbValtype, wTarget } from "./emit_bytes"
import { rlWrapIdx } from "./emit_state"
import { rlSlotOfTyOrTwin } from "./emit_shape_rows"
import { tyRefArrElemOf } from "./emit_map_value_slots"
import { nodeTyAt } from "./emit_capture_frames"
import { NULL_OWN_BOX, NULL_OWN_NONE } from "./emit_plan_null"
import {
  atomStrPlanOf,
  litArmsReadsOf,
  memOpIsVoid,
  memOpPlanOf,
  narrowedMapReadOf,
  nulUnitPlaceReadAt,
  structFieldBoxTy,
  variantFieldBoxTy,
} from "./wasmEmit"

// Notes each node's fact only legacy's planner knows; the valtypes of each rep pair the verifier
// compares stored alike (an argument and its parameter, a global and its read or store, a record
// kid or returned value at an open type); and whether each open variable's open parts are held
// functions (`tyOpenHeldAsIds`).
export function irNoteVerifyFacts(f: IrFn) {
  let v = 0
  while v < f.irVars.length {
    const x = f.irVars[v]
    if irTyOpen(x.vTy) {
      f.irVarHeldIds[v] = tyOpenHeldAsIds(x.vTy, x.vRep, [])
    }
    v = v + 1
  }
  let i = 0
  while i < f.irNodes.length {
    nodeFacts(f, f.irNodes[i], i)
    i = i + 1
  }
  return 0
}

// The facts node `n` (at `i`) carries: its right-hand side's, or a returned value's valtypes.
function nodeFacts(f: IrFn, n: IrNode, i: i32) {
  if n is SLet { return noteFact(f, n.lRhs, i, n.lDst) }
  if n is SEffect { return noteFact(f, n.efRhs, i, -1) }
  if n is SReturn { return noteReturn(f, n) }
  if n is SGlobalSet {
    return notePair(f, irGlobalRepOf(f, n.gsSym), opndRep(f, n.gsSrc))
  }
  return noteNone(i)
}

// A returned value is compared stored alike with the result's rep where the two differ.
function noteReturn(f: IrFn, n: SReturn) {
  if !n.rtHas { return 0 }
  const rn = repNodeAt(f.irRetRep)
  if rn is RNullable { notePair(f, rn.rnInner, opndRep(f, n.rtV)) }
  return notePair(f, f.irRetRep, opndRep(f, n.rtV))
}

// Node `i`, or a right-hand side, of a kind whose check reads no fact only legacy knows.
function noteNone(i: i32) { return i }

// Notes rep `r`'s valtype (`refRepValtype`) once, where it has one.
function noteValtype(f: IrFn, r: i32) {
  if r < 0 || f.irRepValtype.has(r) { return 0 }
  f.irRepValtype[r] = refRepValtype(r)
  return 0
}

// Reps `a` and `b`, which the verifier compares stored alike where they differ.
function notePair(f: IrFn, a: i32, b: i32) {
  if a == b { return 0 }
  noteValtype(f, a)
  return noteValtype(f, b)
}

// Operand `o`'s rep in `f`.
function opndRep(f: IrFn, o: Opnd): i32 {
  return match o {
    OVar => if o.ov >= 0 && o.ov < f.irVars.length { f.irVars[o.ov].vRep } else { -1 }
    OImm => o.oiRep
    OStr => o.osRep
  }
}

// The fact right-hand side `r` at node `i`, defining variable `d` (-1 for none), carries.
function noteFact(f: IrFn, r: Rhs, i: i32, d: i32) {
  if r is RGlobalGet {
    const src = f.irNodeAt[i] ?? -1
    if src >= 0 { f.irFactTy[i] = nodeTyAt(src, f.irAt) }
    if d >= 0 && d < f.irVars.length {
      notePair(f, f.irVars[d].vRep, irGlobalRepOf(f, r.ggSym))
    }
  } else if r is RCall {
    const si = irSigOf(f, r.caCallee)
    const ps = if si >= 0 { f.irSigParams[si] } else { [] }
    if si >= 0 && d >= 0 && d < f.irVars.length {
      notePair(f, f.irVars[d].vRep, f.irSigRet[si])
    }
    let k = 0
    while k < ps.length && k < r.caArgs.length {
      notePair(f, ps[k], opndRep(f, r.caArgs[k]))
      k = k + 1
    }
  } else if r is RRetag {
    // A hole's closure list retagged to its consumer's (`cloListUndeclaredTakes`).
    if d >= 0 && d < f.irVars.length {
      notePair(f, f.irVars[d].vRep, opndRep(f, r.rgV))
    }
  } else if r is RGetField {
    f.irFactTy[i] = nodeTyAt(r.gfAt, f.irAt)
  } else if r is RMemOp {
    const c = nodeAt(r.moAt)
    f.irFactInt[i] = if c is Call && memOpIsVoid(memOpPlanOf(c).moArm) { 1 } else { 0 }
  } else if r is RLitArms {
    const lt = nodeAt(r.liAt)
    f.irFactInt[i] = if lt is IsExpr { litArmsReadsOf(r.liAt, r.liArm, lt.isObj, f.irAt) } else { 2 }
  } else if r is RMapGet {
    f.irFactInt[i] = if narrowedMapReadOf(r.mtAt, f.irAt).nmArm == "unbox" { 1 } else { 0 }
  } else if r is RMakeRec {
    const tys: i32[] = []
    let fi = 0
    while r.mrBuiltRow >= 0 && fi < r.mrLayout.length {
      tys.push(
        if r.mrVariant { variantFieldBoxTy(r.mrBuiltRow, fi) } else { structFieldBoxTy(r.mrBuiltRow, fi) },
      )
      fi = fi + 1
    }
    f.irFactKidTy[i] = tys
    noteRecOpenKids(f, r, tys, d)
  } else if r is RAtomStr {
    // Whether the decode's plan writes a `null` (`apNul`), which only a nullable string holds.
    const nul = r.sxAt < 0 || atomStrPlanOf(r.sxAt, f.irAt, false).apNul
    f.irFactInt[i] = if nul { 1 } else { 0 }
  } else if r is RNullOf {
    // The null's owner (0 none, 1 box, 2 typed), plus 3 where its node is a null-unit place read.
    let fact = if r.nuOwn == NULL_OWN_BOX { 1 } else if r.nuOwn == NULL_OWN_NONE { 0 } else { 2 }
    if nulUnitPlaceReadAt(r.nuAt, f.irAt) { fact = fact + 3 }
    f.irFactInt[i] = fact
  } else {
    return noteNone(i)
  }
  return 0
}

// A record's kid whose site type is open (or unknown) is compared stored alike with its field.
function noteRecOpenKids(f: IrFn, r: RMakeRec, tys: i32[], d: i32) {
  if d < 0 || d >= f.irVars.length { return 0 }
  const ks = repNodeKids(f.irVars[d].vRep)
  let k = 0
  while k < ks.length && k < r.mrFields.length {
    let fi = 0
    while fi < r.mrLayout.length && r.mrLayout[fi] != k { fi = fi + 1 }
    const st = if r.mrBuiltRow >= 0 && fi < tys.length { tys[fi] } else { -1 }
    if irTyOpen(st) {
      noteValtype(f, ks[k])
      noteValtype(f, opndRep(f, r.mrFields[k]))
    }
    k = k + 1
  }
  return 0
}

// Whether a variable of type `ty` at rep `rep` is open (rule 1): a type whose every open part is
// a function held at a rep no instance changes is not (`tyOpenHeldAsIds`).
export function irTyHeldOpen(ty: i32, rep: i32): boolean {
  if irUntypedClosure(ty, rep) { return false }
  return irTyOpen(ty) && !tyOpenHeldAsIds(ty, rep, [])
}

// The valtype bytes legacy's `fbValtype` writes a value of rep `r` at: a held closure's, or a
// ref-element list's at its wrapper; none for any other rep. Writes nothing to the live writer.
export function refRepValtype(r: i32): u8[] {
  const out: u8[] = []
  const d = repOfTy(repTyOf(r))
  const k = d.rdKind
  if k == null || d.rdNul != 0 { return out }
  // A list's type keys its wrapper by its element (`rlSlotOfTyOrTwin`), as legacy's reads do.
  const slot = if k == "reflist" && d.rdSlot < 0 { rlSlotOfTyOrTwin(tyRefArrElemOf(repTyOf(r))) } else { d.rdSlot }
  const clo = k == "closure" && closureHeld(r)
  const list = k == "reflist" && slot >= 0 && slot < rlWrapIdx.length
  if !clo && !list { return out }
  const prev = wTarget(out)
  fbValtype(k, slot)
  wTarget(prev)
  return out
}

// Whether a value of rep `src` stands where rep `dst` is asked: both write the same valtype
// (`refRepValtype`).
export function repStoresAs(dst: i32, src: i32): boolean {
  const a = refRepValtype(dst)
  return a.length > 0 && u8sSame(a, refRepValtype(src))
}

// Whether a list of closures at rep `src`, whose rep writes no valtype (a hole's element), is the
// closure list at `dst` that writes one: legacy keys such a list at its consumer's wrapper.
export function cloListUndeclaredTakes(src: i32, dst: i32): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if !(a is RList) || !(d is RList) { return false }
  return repNodeAt(a.rlsElem) is RClosure
    && repNodeAt(d.rlsElem) is RClosure
    && refRepValtype(src).length == 0
    && refRepValtype(dst).length > 0
}

// Whether a destination of open type `ty` at rep `rep` takes a value of rep `v` as it stands,
// stored alike (`repStoresAs`).
export function openRepTakes(ty: i32, rep: i32, v: i32): boolean {
  return irTyOpen(ty) && repStoresAs(rep, v)
}

// Whether open type `ty`'s rep `rep` has no valtype legacy writes (`refRepValtype`) and `v` has
// one. Permissive alone: a caller ties `v` to a legacy declaration of the storage it reads.
export function undeclaredRepTakes(ty: i32, rep: i32, v: i32): boolean {
  return irTyOpen(ty)
    && refRepValtype(rep).length == 0
    && refRepValtype(v).length > 0
}
