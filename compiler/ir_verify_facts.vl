// The facts the IR verifier checks a function against that only legacy's planners know, noted on
// the function by node before it is verified, so `ir_verify.vl` asks legacy nothing (D17049).
import {
  IrFn,
  RGetField,
  RGlobalGet,
  RLitArms,
  RMapGet,
  RMemOp,
  RNullOf,
  Rhs,
  SEffect,
  SLet,
} from "./ir"
import { Call, IsExpr, nodeAt } from "./ast"
import { nodeTyAt } from "./emit_capture_frames"
import { NULL_OWN_BOX, NULL_OWN_NONE } from "./emit_plan_null"
import {
  litArmsReadsOf,
  memOpIsVoid,
  memOpPlanOf,
  narrowedMapReadOf,
} from "./wasmEmit"

// Notes, for every node of `f` whose check reads one, the fact legacy's planner gives it.
export function irNoteVerifyFacts(f: IrFn) {
  let i = 0
  while i < f.irNodes.length {
    const n = f.irNodes[i]
    if n is SLet { noteFact(f, n.lRhs, i) }
    if n is SEffect { noteFact(f, n.efRhs, i) }
    i = i + 1
  }
  return 0
}

function noteFact(f: IrFn, r: Rhs, i: i32) {
  if r is RGlobalGet {
    const src = f.irNodeAt[i] ?? -1
    if src >= 0 { f.irFactTy[i] = nodeTyAt(src, f.irAt) }
  } else if r is RGetField {
    f.irFactTy[i] = nodeTyAt(r.gfAt, f.irAt)
  } else if r is RMemOp {
    const c = nodeAt(r.moAt)
    f.irFactInt[i] = if c is Call && memOpIsVoid(memOpPlanOf(c).moArm) { 1 } else { 0 }
  } else if r is RLitArms {
    const lt = nodeAt(r.liAt)
    f.irFactInt[i] = if lt is IsExpr { litArmsReadsOf(r.liAt, r.liArm, lt.isObj, f.irAt) } else { 2 }
  } else if r is RMapGet {
    f.irFactInt[i] = if narrowedMapReadOf(r.mtAt, f.irAt).nmArm == "unbox" { 1 } else { 0 }
  } else if r is RNullOf {
    f.irFactInt[i] = if r.nuOwn == NULL_OWN_BOX { 1 } else if r.nuOwn == NULL_OWN_NONE { 0 } else { 2 }
  }
  return 0
}
