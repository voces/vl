// The recorded result of each emitted function, and its shadow against the emitter's voidness.
// One answer per `fnStmts` entry, from the elaboration where the function is an instance or
// lives in one, else from the checker; `recordedVoidFns` reads it for voidness, and the
// shadow grades that column and the result kind against it. Off unless a host arms it; armed, each emitted function is
// counted by class (`docs/internals/refactor-notes/2026-10-25-scoreboard-baselines.md`, pass rows).
import { mapTwinUnionMember } from "./check_ty_rep"
import {
  ArrayLit,
  BinExpr,
  Block,
  Call,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  Member,
  ObjLit,
  P,
  i32ToStr,
  nodeAt,
  nodeChildrenPush,
} from "./ast"
import { nodeRepTyIxOf } from "./check_core_state"
import { nodeTyIxOf } from "./check_node_tys"
import { inferRetTyIxByNode } from "./check_infer_ret"
import { retValueRootCall } from "./check_store_rep"
import { collectRetValues } from "./check_nj_join"
import { recHoleIdentityArg } from "./check_fit_rules"
import { recBuildTable, recBuildTyIn, recKeptFnDstOf } from "./check_rec_rows"
import { recPassThroughArg } from "./check_record_origins"
import { identBoundFnDeclOf } from "./check_scopes"
import {
  cwBindingOf,
  cwFramedNode,
  cwIxWant,
  cwKeyOfRoot,
  cwPeel,
  cwPeelValue,
  cwSlotWrittenValues,
} from "./check_write_scan"
import { nodeHoleElemOf } from "./check_side_rows"
import {
  T,
  TY_BOOL,
  TY_NEVER,
  TY_STR,
  TY_VOID,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  mkArrayTy,
  mkNullableTy,
  tyAt,
  tyIsLitUnion,
  tySame,
} from "./check_types"
import {
  elabCheckedTyOf,
  elabDeliveredRowOf,
  elabHeldValTy,
  elabHoleFnClosed,
  elabKeyAtPos,
  elabNestedResultOf,
  elabResultOf,
  elabSlotTyAt,
  elabSrcDecl,
  elabSubstClosed,
  elabUnboundTpTy,
} from "./emit_elab"
import { unwrapParen } from "./emit_base"
import { scopeTyAt } from "./emit_capture_frames"
import { callsOfCallee } from "./emit_fn_ret_kinds"
import { cloSigKeyExt, fnBundleRetRow } from "./emit_classify"
import { repOfTy, repSigKindOfTy, repSigTokHasSlot } from "./emit_rep"
import { repSigRetTokOfTy, repSlotOfKind } from "./emit_rep_slot"
import {
  VKind,
  arrLitMint,
  emitPhaseReached,
  fRetBool,
  fRetKind,
  fRetLitAtom,
  fRetRArrElem,
  fRetRListRow,
  fRetStructIdx,
  fRetVoid,
  fnParent,
  fnStmts,
  fnStmtsPosOf,
  monoInstFe,
  monoInstOrig,
  monoOrigNode,
  monoStubSlots,
  retLitsFirst,
  rlElemName,
} from "./emit_state"
import { i32ListHas } from "./listutil"
import {
  elabTyClosed,
  fnTagCallSetOf,
  fnTagCalls,
  fnTagMembers,
} from "./check_elab_cap"
import { fnIndexOfInScopeAt } from "./emit_local_scope"
import { identDeclOf, sidOfNode } from "./symbols"
import { nonNullTy, tyHasTyVar } from "./tyquery"

let frsArmed = false
let frsNamed = false
let frsKindArmed = false
let frsColArmed = false
let frsDrop = 0
let frsRowKey: string[] = []
let frsRowN: i32[] = []

// Arm (1) or disarm (0) the shadow for the compiles that follow; 2 also names each function.
export function fnRetShadowArm(on: i32) {
  frsArmed = on != 0
  frsNamed = on == 2
  0
}

// Arm (1) or disarm (0) the result-kind shadow for the compiles that follow; 2 also names each
// function. It counts beside the voidness rows, once `fnRetColsFromRecorded` has settled.
export function fnKindShadowArm(on: i32) {
  frsKindArmed = on != 0
  frsNamed = on == 2
  0
}

// Arm (1) or disarm (0) the return-column shadow (`fnColShadowRun`); 2 also names each function.
export function fnColShadowArm(on: i32) {
  frsColArmed = on != 0
  frsNamed = on == 2
  0
}

// For the shadow's own test: the shadow reads the column as answering nothing (1) or `void`
// everywhere (2). What the emitter reads is unchanged.
export function fnRetShadowDropSet(d: i32) {
  frsDrop = d
  0
}

// The result type emitted function `fe` returns, as recorded: `void` for a pruned template's
// stub, its instance's result when it owns an elaboration slot, its own type inside the
// instance that holds it, else its checker type; where that is open, its template's closed
// result. -1 where none is recorded or it is still open.
export function fnRecordedRetTy(fe: i32): i32 {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  frsLitUnionRet(fnStmts[fe], frsRecordedRetCore(fe))
}

// Recorded result `r` of the lambda at node `fx`, or the literal union its context typed the
// lambda's result at where `r` is a string or a string literal: the lambda returns the atom. A
// lambda the elaboration rebuilt is typed at the declaration it copies.
function frsLitUnionRet(fx: i32, r: i32): i32 {
  if r < 0 || r >= T.tys.length { return r }
  const rt = tyAt(r)
  if r != TY_STR && !(rt is TyLit && rt.litKind == "str") { return r }
  const src = if emitPhaseReached("monomorphized") { elabSrcDecl(fx) } else { fx }
  const lu = inferRetTyIxByNode(if src >= 0 { src } else { fx })
  if tyIsLitUnion(lu) { lu } else { r }
}

// Mints the rows of each list literal in a value function `fx` returns, before its result's token
// is read.
function frsMintRetLits(fx: i32) {
  if !retLitsFirst(fx) { return 0 }
  const fn = nodeAt(fx)
  if !(fn is FuncDecl) || fn.fnBody < 0 { return 0 }
  const todo: i32[] = []
  collectRetValues(fn.fnBody, todo)
  while todo.length > 0 {
    const at = todo.pop()
    if at >= 0 && at < P.nodes.length && !(nodeAt(at) is FuncDecl) {
      if nodeAt(at) is ArrayLit { arrLitMint(at) }
      nodeChildrenPush(at, todo)
    }
  }
  0
}

// `fnRecordedRetTy` before a lambda's literal-union result is read (`frsLitUnionRet`).
function frsRecordedRetCore(fe: i32): i32 {
  const fx = fnStmts[fe]
  // The stub and elaboration ledgers are this compile's only once `monomorphize` has run; before,
  // they hold the previous program's, so only the checker's own type answers.
  if !emitPhaseReached("monomorphized") { return frsFnRet(elabCheckedTyOf(fx)) }
  // A template no instance replaced is pruned to an empty stub, void as minted.
  if i32ListHas(monoStubSlots, fe) { return TY_VOID }
  frsMintRetLits(fx)
  const k = elabKeyAtPos(fe)
  const nested = fe < fnParent.length && fnParent[fe] >= 0
  let r = -1
  if k >= 0 && !nested {
    r = elabResultOf(k)
    // The instance is built at the record the calls mono routes to it are stamped at, where they
    // agree, else at the record every call reaching its key is.
    const cr = frsCallsBuiltRow(fx, r)
    const dr = if cr >= 0 { cr } else { elabDeliveredRowOf(k) }
    if dr >= 0 && r >= 0 && r < T.tys.length && tyAt(r) is TyObj { r = dr }
  } else {
    r = frsFnRet(if k >= 0 { scopeTyAt(fx, fx) } else { elabCheckedTyOf(fx) })
    if r >= 0 && k < 0 {
      const kd = recKeptFnDstOf(fx, r)
      if kd >= 0 { r = kd }
      // A value built by a call keeps that call's row whatever the delivery; else the calls'.
      const vr = if r < T.tys.length && tyAt(r) is TyObj { frsValuesBuiltRow(fx) } else { -1 }
      const cr = if vr >= 0 { vr } else { frsCallsBuiltRow(fx, r) }
      if cr >= 0 { r = cr }
    }
  }
  // A record is built at its values' stamps where they agree, and a list or map with no row of
  // its own only there (D14901 class D).
  const obj = r >= 0 && r < T.tys.length && tyAt(r) is TyObj
  if obj || r >= 0 && r < T.tys.length && repSigRetTokOfTy(r) == "" {
    const sr = frsValuesStampRow(fx, r, obj || frsIsPlainFn(fx))
    if sr >= 0 { r = sr }
  }
  if r >= 0 && r < T.tys.length && repSigRetTokOfTy(r) == "" {
    const br = frsValuesBuiltTy(fe, r)
    if br >= 0 { r = br }
  }
  if r >= 0 { return frsClosedHoleRet(fx, r) }
  const tr = frsTemplateRet(fe, nested, k)
  if tr >= 0 { return tr }
  // A function nested in an instance whose template leaves its result open takes the type the
  // instance gives its values.
  const nr = if nested && k >= 0 { elabNestedResultOf(fx, k) } else { -1 }
  if nr >= 0 { return frsClosedHoleRet(fx, nr) }
  const vr = frsValuesRet(fe)
  if vr >= 0 { return frsClosedHoleRet(fx, vr) }
  frsHoleLambdaRet(fe)
}

// Where result `r` of function `fe` has no token: the one type with a token every returned value
// is built at, as the elaboration and the record rows record it (`frsValueBuiltTy`), a record at
// any record and any other result where it closes `r`'s holes and keeps the rest; else -1.
function frsValuesBuiltTy(fe: i32, r: i32): i32 {
  if r < 0 || r >= T.tys.length || fe < 0 || fe >= fnStmts.length { return -1 }
  const fn = nodeAt(fnStmts[fe])
  if !(fn is FuncDecl) || fn.fnBody < 0 || frsValuesDepth >= 8 { return -1 }
  const vals: i32[] = []
  collectRetValues(fn.fnBody, vals)
  if vals.length == 0 { return -1 }
  const rec = tyAt(r) is TyObj && !tyHasTyVar(r)
  frsValuesDepth = frsValuesDepth + 1
  let t = -1
  for v in vals {
    const bt = frsValueBuiltTy(unwrapParen(v), fe)
    const ok = bt >= 0
      && bt < T.tys.length
      && repSigRetTokOfTy(bt) != ""
      && (if rec { tyAt(bt) is TyObj } else { frsClosesHoles(r, bt, 0) })
    if !ok || (t >= 0 && !tySame(t, bt)) {
      frsValuesDepth = frsValuesDepth - 1
      return -1
    }
    t = bt
  }
  frsValuesDepth = frsValuesDepth - 1
  t
}

// The type returned value `v` of function `fe` is built at: an assignment's at its target's build;
// a call of another function at its recorded result; a binding at its build, slot fact or a
// `const`'s initializer's held type, the first with a token; else `elabHeldValTy`. -1 for none.
function frsValueBuiltTy(v: i32, fe: i32): i32 {
  if v < 0 || v >= P.nodes.length || fe < 0 || fe >= fnStmts.length {
    return -1
  }
  const fx = fnStmts[fe]
  const n = nodeAt(v)
  if n is BinExpr && n.binOp == "=" {
    const l = unwrapParen(n.binLeft)
    const d = if l >= 0 && nodeAt(l) is Ident { identDeclOf(l) } else { -1 }
    return if d >= 0 { recBuildTyIn(recBuildTable(), d, false) } else { -1 }
  }
  const root = retValueRootCall(v)
  const rn = if root >= 0 { nodeAt(root) } else { null }
  if rn is Call && rn.callFn >= 0 && root == v {
    const cd = identBoundFnDeclOf(rn.callFn)
    const ce = if cd >= 0 { fnStmtsPosOf(cd) } else { -1 }
    if ce >= 0 && ce != fe { return fnRecordedRetTy(ce) }
  }
  if n is Ident {
    const d = identDeclOf(v)
    const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
    if !(dn is LetDecl) { return -1 }
    const b = recBuildTyIn(recBuildTable(), d, false)
    if frsHasTok(b) { return b }
    const st = elabSlotTyAt(d, [], fx)
    if frsHasTok(st) { return st }
    // A `let` the body may reassign is not built at its initializer.
    const init = if dn.letKw == "const" { dn.letInit } else { -1 }
    const it = if init >= 0 { elabHeldValTy(init, fx) } else { -1 }
    return if frsHasTok(it) { it } else { -1 }
  }
  elabHeldValTy(v, fx)
}

// Whether type `t` is one whose result has a token.
function frsHasTok(t: i32): boolean {
  t >= 0 && t < T.tys.length && repSigRetTokOfTy(t) != ""
}

// Whether closed type `c` is open type `r` with each hole closed: equal wherever `r` is closed.
function frsClosesHoles(r: i32, c: i32, depth: i32): boolean {
  if r < 0 { return true }
  if c < 0 || r >= T.tys.length || c >= T.tys.length || depth > 32 {
    return false
  }
  if tySame(r, c) { return true }
  const a = tyAt(r)
  const b = tyAt(c)
  if a is TyVar { return true }
  if a is TyArray && b is TyArray {
    return frsClosesHoles(a.aElem, b.aElem, depth + 1)
  }
  if a is TyNullable && b is TyNullable {
    return frsClosesHoles(a.nInner, b.nInner, depth + 1)
  }
  if a is TyMap && b is TyMap {
    return a.mSet == b.mSet
      && frsClosesHoles(a.mKey, b.mKey, depth + 1)
      && frsClosesHoles(a.mVal, b.mVal, depth + 1)
  }
  if a is TyFunc && b is TyFunc {
    if a.fnParamTypes.length != b.fnParamTypes.length { return false }
    let i = 0
    while i < a.fnParamTypes.length {
      if !frsClosesHoles(a.fnParamTypes[i], b.fnParamTypes[i], depth + 1) {
        return false
      }
      i = i + 1
    }
    return frsClosesHoles(a.fnRet, b.fnRet, depth + 1)
  }
  if a is TyObj && b is TyObj {
    if a.objFieldNames.length != b.objFieldNames.length { return false }
    let i = 0
    while i < a.objFieldNames.length {
      if a.objFieldNames[i] != b.objFieldNames[i] { return false }
      if !frsClosesHoles(a.objFieldTypes[i], b.objFieldTypes[i], depth + 1) {
        return false
      }
      i = i + 1
    }
    return true
  }
  // A scalar, union, literal, negation or error closes no hole: only the same type matches it.
  if a is TyPrim { return false }
  if a is TyUnion { return false }
  if a is TyLit { return false }
  if a is TyNeg { return false }
  if a is TyErr { return false }
  false
}

// The result of function `fe` whose every returned value is still open, a hole or a function
// with one: the one type the elaboration holds them at, else the one type every call reaching
// `fe` is checked at, else a hole value at its unbound default (`elabUnboundTpTy`) and an open
// function at its uncalled default (`elabHoleFnClosed`); -1 where a value is closed or they differ.
function frsHoleLambdaRet(fe: i32): i32 {
  const fx = fnStmts[fe]
  const fn = nodeAt(fx)
  if !(fn is FuncDecl) || fn.fnBody < 0 { return -1 }
  const vals: i32[] = []
  collectRetValues(fn.fnBody, vals)
  if vals.length == 0 { return -1 }
  let held = -1
  let dflt = -1
  for v0 in vals {
    const v = unwrapParen(v0)
    const ct = elabCheckedTyOf(v)
    if ct < 0 || ct >= T.tys.length || !tyHasTyVar(ct) { return -1 }
    const h = elabHeldValTy(v, fx)
    held = if h < 0 || (held != -1 && (held == -2 || !tySame(held, h))) { -2 } else { h }
    const c = tyAt(ct)
    const d = if c is TyVar { elabUnboundTpTy(-1, fx, c.tvName) } else { elabHoleFnClosed(ct) }
    dflt = if d < 0 || (dflt != -1 && (dflt == -2 || !tySame(dflt, d))) { -2 } else { d }
  }
  if held >= 0 { return held }
  const ct = frsCallsCheckedTy(fx)
  if ct != -1 { return if ct >= 0 { ct } else { -1 } }
  if dflt >= 0 { dflt } else { -1 }
}

// The one closed type every call whose callee's set holds function `fx` is checked at; -1 where
// no call reaches it, -2 where one is open or two differ.
function frsCallsCheckedTy(fx: i32): i32 {
  const src = elabSrcDecl(fx)
  let t = -1
  for c in fnTagCalls() {
    const ms = fnTagMembers(fnTagCallSetOf(c))
    if i32ListHas(ms, fx) || i32ListHas(ms, src) {
      const ct = nodeTyIxOf(c)
      if (
        ct < 0
        || ct >= T.tys.length
        || !elabTyClosed(ct, 0)
        || tyHasTyVar(ct)
      ) {
        return -2
      }
      if t >= 0 && !tySame(t, ct) { return -2 }
      t = ct
    }
  }
  t
}

let frsValuesDepth = 0

// Where nothing elaborates function `fe`'s values: the one type they agree on, each a call of a
// named function at the result recorded for the function it lowers to, else its own closed checker
// type; a call of `fe` itself skipped, -1 where one is a write, open, or they disagree.
function frsValuesRet(fe: i32): i32 {
  const fn = nodeAt(fnStmts[fe])
  if !(fn is FuncDecl) || fn.fnBody < 0 || frsValuesDepth >= 8 { return -1 }
  const vals: i32[] = []
  collectRetValues(fn.fnBody, vals)
  frsValuesDepth = frsValuesDepth + 1
  let t = -1
  let i = 0
  while i < vals.length && t != -2 {
    const vt = frsValueRet(unwrapParen(vals[i]), fe)
    if vt != -3 {
      t = if vt < 0 || (t >= 0 && !tySame(t, vt)) { -2 } else { vt }
    }
    i = i + 1
  }
  frsValuesDepth = frsValuesDepth - 1
  if t >= 0 { t } else { -1 }
}

// `frsValuesRet`'s answer for one value `v` of function `fe`: -3 for a call of `fe` itself.
function frsValueRet(v: i32, fe: i32): i32 {
  if v < 0 || v >= P.nodes.length { return -1 }
  const n = nodeAt(v)
  if n is BinExpr {
    const op = n.binOp
    if op.length >= 1 && op.slice(op.length - 1, op.length) == "=" {
      if op != "==" && op != "!=" && op != "<=" && op != ">=" { return -1 }
    }
  }
  if n is Call && n.callFn >= 0 {
    const c = nodeAt(n.callFn)
    if c is Ident {
      const ce = fnIndexOfInScopeAt(
        sidOfNode(n.callFn),
        c.identName,
        fe,
        n.callFn,
      )
      if ce == fe { return -3 }
      if ce >= 0 && ce < fnStmts.length {
        const cr = fnRecordedRetTy(ce)
        if cr >= 0 && cr < T.tys.length && elabTyClosed(cr, 0) { return cr }
        return -1
      }
    }
  }
  const ct = elabCheckedTyOf(v)
  if ct >= 0 && ct < T.tys.length && ct != TY_VOID && elabTyClosed(ct, 0) {
    ct
  } else {
    -1
  }
}

// The record every call of plain function `fx` is stamped at, when its result `r` is a record and
// they all agree: the row its value is built at where a delivery widens it (D14900); else -1.
function frsCallsBuiltRow(fx: i32, r: i32): i32 {
  if r < 0 || r >= T.tys.length || !(tyAt(r) is TyObj) { return -1 }
  if fx < 0 || fx >= P.nodes.length { return -1 }
  const fn = nodeAt(fx)
  if !(fn is FuncDecl) { return -1 }
  const cs = callsOfCallee(fn.fnName)
  if cs.length == 0 { return -1 }
  let row = -1
  for c in cs {
    const st = frsCallBuiltAt(c, 0)
    if st < 0 || st >= T.tys.length || !(tyAt(st) is TyObj) || tyHasTyVar(st) {
      return -1
    }
    if row >= 0 && !tySame(row, st) { return -1 }
    row = st
  }
  row
}

// The record call `c`'s value is built at: where the callee hands an argument straight back (an
// identity, or a hole function returning its parameter), that argument's build (D14902), an
// element read at its list's (`frsElemBuiltRow`); where the callee's every value is call-built,
// that row (`frsValuesBuiltRow`); else the call's own stamp.
function frsCallBuiltAt(c: i32, hops: i32): i32 {
  const st = nodeRepTyIxOf(c)
  if hops >= 16 || c < 0 || c >= P.nodes.length { return st }
  const cn = nodeAt(c)
  if !(cn is Call) { return st }
  let a = recPassThroughArg(c)
  if a < 0 && cn.callFn >= 0 {
    a = recHoleIdentityArg(c, identBoundFnDeclOf(cn.callFn))
  }
  if a < 0 && cn.callFn >= 0 {
    const vr = frsValuesBuiltRow(identBoundFnDeclOf(cn.callFn))
    return if vr >= 0 { vr } else { st }
  }
  const ap = if a >= 0 { cwPeelValue(a) } else { -1 }
  if ap < 0 || ap >= P.nodes.length { return st }
  const an = nodeAt(ap)
  let b = -1
  if an is Call {
    b = frsCallBuiltAt(ap, hops + 1)
  } else if an is Ident {
    const d = identDeclOf(ap)
    b = if d >= 0 { recBuildTyIn(recBuildTable(), d, false) } else { -1 }
    if b < 0 { b = nodeRepTyIxOf(ap) }
  } else if an is ObjLit {
    b = nodeRepTyIxOf(ap)
  } else if an is Index {
    b = frsElemBuiltRow(ap)
  }
  if b < 0 || b >= T.tys.length || !(tyAt(b) is TyObj) || tyHasTyVar(b) {
    return st
  }
  b
}

// The record un-annotated plain function `fx` builds its value at where every value it returns is
// a call of a plain function or handed back through identities (`frsHandBackLeaf`), or a read the
// store column stamped (`frsHeldRead`), and the stamps agree on one closed record; else -1. An
// annotated result, and a literal leaf built at its instance's row, are not read.
function frsValuesBuiltRow(fx: i32): i32 {
  if fx < 0 || fx >= P.nodes.length || !frsIsPlainFn(fx) { return -1 }
  const fn = nodeAt(fx)
  if !(fn is FuncDecl) || fn.fnRet >= 0 || fn.fnBody < 0 { return -1 }
  const vals: i32[] = []
  collectRetValues(fn.fnBody, vals)
  if vals.length == 0 { return -1 }
  let row = -1
  for v in vals {
    const root = retValueRootCall(v)
    let at = if root >= 0 && frsHandBackLeaf(root, 0) >= 0 { root } else { frsHeldRead(v) }
    if at < 0 { at = frsConstLitRead(v) }
    if at < 0 { return -1 }
    const st = nodeRepTyIxOf(at)
    if st < 0 || st >= T.tys.length || !(tyAt(st) is TyObj) || tyHasTyVar(st) {
      return -1
    }
    if row >= 0 && !tySame(row, st) { return -1 }
    row = st
  }
  row
}

// The record literal returned value `v` reads where `v` names a `const` bound to one, which the
// lowering builds at the literal's own stamp; else -1.
function frsConstLitRead(v: i32): i32 {
  const u = unwrapParen(v)
  if u < 0 || u >= P.nodes.length || !(nodeAt(u) is Ident) { return -1 }
  const d = identDeclOf(u)
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letKw != "const" || dn.letType >= 0 { return -1 }
  const init = unwrapParen(dn.letInit)
  if init >= 0 && nodeAt(init) is ObjLit { init } else { -1 }
}

// Returned value `v` when it is a read the checker's store column stamped at another record than
// its own type (`storeRetsResolve`, D15127); else -1.
function frsHeldRead(v: i32): i32 {
  const u = unwrapParen(v)
  const n = if u >= 0 && u < P.nodes.length { nodeAt(u) } else { null }
  if !(n is Index) && !(n is Member) && !(n is Ident) { return -1 }
  const st = nodeRepTyIxOf(u)
  if st < 0 || tySame(st, nodeTyIxOf(u)) { -1 } else { u }
}

// The record element read `ix` (`xs[i]`, `xs` a binding) is built at: every value stored in the
// list's elements, its literal's and each write's through any alias (`cwSlotWrittenValues`), read
// at a plain function's kept build where it is that function's call, else at its stamp; the one
// closed record with a row they agree on, else -1 (D14901 class D).
function frsElemBuiltRow(ix: i32): i32 {
  const n = nodeAt(ix)
  if !(n is Index) { return -1 }
  const arr = cwPeel(n.idxArr)
  if arr < 0 || arr >= P.nodes.length || !(nodeAt(arr) is Ident) { return -1 }
  cwIxWant()
  if !cwFramedNode(arr) || cwKeyOfRoot(arr) < 0 { return -1 }
  const vals: i32[] = []
  const ats: i32[] = []
  if cwSlotWrittenValues(cwBindingOf(arr), ["[]"], vals, ats) < 0 { return -1 }
  if vals.length == 0 { return -1 }
  let row = -1
  for v in vals {
    const st = frsValueBuiltAt(cwPeelValue(v))
    if st < 0 || st >= T.tys.length || !(tyAt(st) is TyObj) || tyHasTyVar(st) {
      return -1
    }
    if repSigRetTokOfTy(st) == "" { return -1 }
    if row >= 0 && !tySame(row, st) { return -1 }
    row = st
  }
  row
}

// The record stored value `v` is built at: a plain function's call at that function's kept
// build (`recKeptFnDstOf`) where one is recorded, else its own stamp, as the lowering reads it.
function frsValueBuiltAt(v: i32): i32 {
  if v < 0 || v >= P.nodes.length { return -1 }
  const n = nodeAt(v)
  if n is Call {
    const fd = if n.callFn >= 0 { identBoundFnDeclOf(n.callFn) } else { -1 }
    if frsIsPlainFn(fd) {
      const own = frsFnRet(elabCheckedTyOf(fd))
      const kd = if own >= 0 { recKeptFnDstOf(fd, own) } else { -1 }
      if kd >= 0 { return kd }
    }
  }
  nodeRepTyIxOf(v)
}

// The record, list or map every value function `fx` returns is stamped at, a literal at its own
// stamp, a call-built value at its root call's and, where `reads` (a plain function's own nodes),
// any other value at its own, when they agree on one closed type of `r`'s shape that has a row;
// else -1. The lowering builds such a value at that stamp.
function frsValuesStampRow(fx: i32, r: i32, reads: boolean): i32 {
  if !frsSameShape(r, r) { return -1 }
  if fx < 0 || fx >= P.nodes.length { return -1 }
  const fn = nodeAt(fx)
  if !(fn is FuncDecl) || fn.fnBody < 0 { return -1 }
  const vals: i32[] = []
  collectRetValues(fn.fnBody, vals)
  if vals.length == 0 { return -1 }
  let row = -1
  for v in vals {
    const root = retValueRootCall(v)
    const pv = unwrapParen(v)
    if pv < 0 || pv >= P.nodes.length { return -1 }
    if root < 0 && !reads && !(nodeAt(pv) is ObjLit || nodeAt(pv) is ArrayLit) {
      return -1
    }
    const st = nodeRepTyIxOf(if root >= 0 { root } else { pv })
    if st < 0 || st >= T.tys.length || tyHasTyVar(st) { return -1 }
    if !frsSameShape(st, r) { return -1 }
    if repSigRetTokOfTy(st) == "" { return -1 }
    if row >= 0 && !tySame(row, st) { return -1 }
    row = st
  }
  row
}

// Whether types `a` and `b` are both records, both lists or both maps.
function frsSameShape(a: i32, b: i32): boolean {
  if a < 0 || a >= T.tys.length || b < 0 || b >= T.tys.length { return false }
  const x = tyAt(a)
  const y = tyAt(b)
  x is TyObj && y is TyObj
    || x is TyArray && y is TyArray
    || x is TyMap && y is TyMap
}

// The call of a plain, non-generic function that call `c` is, or hands back through generic
// identities and hole functions that return their parameter; -1 where the chain ends elsewhere.
function frsHandBackLeaf(c: i32, hops: i32): i32 {
  if hops >= 16 || c < 0 || c >= P.nodes.length { return -1 }
  const cn = nodeAt(c)
  if !(cn is Call) || cn.callFn < 0 { return -1 }
  const fd = identBoundFnDeclOf(cn.callFn)
  let a = recPassThroughArg(c)
  if a < 0 { a = recHoleIdentityArg(c, fd) }
  if a >= 0 { return frsHandBackLeaf(cwPeelValue(a), hops + 1) }
  if frsIsPlainFn(fd) { c } else { -1 }
}

// Whether `fd` is a function with no type parameters that no instance replaces: not a mono clone,
// whose parameters are already substituted, and with no elaboration slot.
function frsIsPlainFn(fd: i32): boolean {
  if fd < 0 || fd >= P.nodes.length { return false }
  const f = nodeAt(fd)
  if !(f is FuncDecl) || f.fnTyParams.length > 0 { return false }
  const fe = fnStmtsPosOf(fd)
  fe >= 0 && elabKeyAtPos(fe) < 0 && !i32ListHas(monoInstFe, fe)
}

// Result `r` of function `fx`, a hole list (`_[]` or `_[] | null`) closed to the element the
// checker records at every value the function returns once its last pin ran (`nodeHoleElemOf`),
// so the record names the list the value is built as while its type keeps the hole; else `r`.
function frsClosedHoleRet(fx: i32, r: i32): i32 {
  if r < 0 || r >= T.tys.length { return r }
  const t = tyAt(r)
  if t is TyNullable {
    const inner = frsClosedHoleRet(fx, t.nInner)
    return if inner == t.nInner { r } else { mkNullableTy(inner) }
  }
  if !(t is TyArray) || t.aElem >= 0 { return r }
  const fn = nodeAt(fx)
  if !(fn is FuncDecl) { return r }
  const vals: i32[] = []
  collectRetValues(fn.fnBody, vals)
  if vals.length == 0 { return r }
  const el = nodeHoleElemOf(vals[0])
  if el < 0 { return r }
  let i = 1
  while i < vals.length {
    if nodeHoleElemOf(vals[i]) != el { return r }
    i = i + 1
  }
  mkArrayTy(el)
}

// For emitted function `fe` whose own answer is open: the checker result of its template (the
// generic an instance copies, or the source lambda of a lambda clone), closed by instance
// `k`'s binding where it names a type variable; -1 where it stays open.
function frsTemplateRet(fe: i32, nested: boolean, k: i32): i32 {
  let t = -1
  if !nested {
    let i = 0
    while i < monoInstFe.length && t < 0 {
      if monoInstFe[i] == fe && i < monoInstOrig.length {
        const o = monoInstOrig[i]
        if o >= 0 && o < monoOrigNode.length { t = monoOrigNode[o] }
      }
      i = i + 1
    }
  }
  if t < 0 { t = elabSrcDecl(fnStmts[fe]) }
  const r = frsFnRet(elabCheckedTyOf(t))
  if r < 0 { return -1 }
  if !tyHasTyVar(r) { return r }
  if k >= 0 { elabSubstClosed(r, k) } else { -1 }
}

// The result of the function type `ft0`, or of its function member where a delivery recorded it
// nullable; -1 where it is no function type.
function frsFnRet(ft0: i32): i32 {
  const ft = nonNullTy(ft0)
  if ft < 0 || ft >= T.tys.length { return -1 }
  const f = tyAt(ft)
  if f is TyFunc { return f.fnRet }
  -1
}

// Count every emitted function by how its recorded result meets `fRetVoid`. Run once the
// voidness has settled (after `recordedVoidFns#2`).
export function fnRetShadowRun() {
  if !frsArmed { return 0 }
  frsRowKey = []
  frsRowN = []
  let fe = 0
  while fe < fnStmts.length && fe < fRetVoid.length {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl {
      let key = frsClass(fe)
      if frsNamed { key = key + " | " + fn.fnName }
      frsCount(key)
    }
    fe = fe + 1
  }
  0
}

// The class of emitted function `fe`.
function frsClass(fe: i32): string {
  const c = frsClassCore(fe)
  if (
    c == "agree"
    || c.slice(0, 9) == "recorded "
    || c.slice(0, 9) == "emit-time"
  ) {
    return c
  }
  if fRetVoid[fe] == 1 { return c + ", emitter void" }
  c + ", emitter value"
}

function frsClassCore(fe: i32): string {
  let r = frsRecordedOrAnn(fe)
  if frsDrop == 1 { r = -1 }
  if frsDrop == 2 { r = TY_VOID }
  const nested = fe < fnParent.length && fnParent[fe] >= 0
  if r == TY_NEVER { return "never" }
  if r != TY_VOID && (r < 0 || r >= T.tys.length) {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl {
      if fn.fnRet >= 0 { return "no result recorded, annotated" }
    }
    if elabKeyAtPos(fe) >= 0 || nested {
      return "no result recorded, instance or nested"
    }
    return "no result recorded"
  }
  const recVoid = r == TY_VOID
  const emitVoid = fRetVoid[fe] == 1
  if recVoid == emitVoid { return "agree" }
  if recVoid { return "recorded void, emitter value" }
  if frsTailIsAssign(fnStmts[fe]) {
    return "emit-time: tail assignment lowered void"
  }
  if frsTailCallsVoid(fnStmts[fe]) {
    return "emit-time: tail call of a function lowered void"
  }
  "recorded value, emitter void"
}

// Whether the function `fx` ends in an assignment: the emitter lowers that tail as a statement
// unless a reader takes its value, where the recorded result is the assignment's value.
function frsTailIsAssign(fx: i32): boolean {
  const fn = nodeAt(fx)
  if !(fn is FuncDecl) || fn.fnBody < 0 { return false }
  const b = nodeAt(fn.fnBody)
  if !(b is Block) || b.blkStmts.length == 0 { return false }
  const t = nodeAt(b.blkStmts[b.blkStmts.length - 1])
  t is BinExpr && t.binOp == "="
}

// Whether the function `fx` ends in a call of a function the emitter lowered void.
function frsTailCallsVoid(fx: i32): boolean {
  const fn = nodeAt(fx)
  if !(fn is FuncDecl) || fn.fnBody < 0 { return false }
  const b = nodeAt(fn.fnBody)
  if !(b is Block) || b.blkStmts.length == 0 { return false }
  const t = nodeAt(b.blkStmts[b.blkStmts.length - 1])
  if !(t is Call) { return false }
  const cd = identDeclOf(t.callFn)
  if cd < 0 { return false }
  const ce = fnStmtsPosOf(cd)
  ce >= 0 && ce < fRetVoid.length && fRetVoid[ce] == 1
}

// Count every function the emitter lowers valued by how the kind of its recorded result meets
// `fRetKind`. Run once the kinds have settled (after `fnRetColsFromRecorded`).
export function fnKindShadowRun() {
  if !frsKindArmed { return 0 }
  if frsArmed == false {
    frsRowKey = []
    frsRowN = []
  }
  let fe = 0
  while fe < fnStmts.length && fe < fRetVoid.length {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl {
      if fRetVoid[fe] == 0 {
        let key = frsKindClass(fe)
        if frsNamed { key = key + " | " + fn.fnName }
        frsCount(key)
      }
    }
    fe = fe + 1
  }
  0
}

// The kind class of valued function `fe`: the `$fnsig` result token its recorded result
// crosses as, against the one its lowered signature (`cloSigKeyExt`) carries.
function frsKindClass(fe: i32): string {
  let r = frsRecordedOrAnn(fe)
  if frsDrop == 1 { r = -1 }
  if frsDrop == 2 { r = TY_VOID }
  if r == TY_VOID || r == TY_NEVER { return "kind: recorded void or never" }
  if r < 0 || r >= T.tys.length { return "kind: no result recorded" }
  const rec = repSigRetTokOfTy(r)
  if rec == "" { return "kind: recorded result has no token" }
  const low = cloSigKeyExt(fe)
  let gt = -1
  let i = 0
  while i < low.length {
    if low[i] == '>' { gt = i }
    i = i + 1
  }
  if gt < 0 { return "kind: lowered signature has no token" }
  const lr = low.slice(gt, low.length)
  if lr == rec { return "kind agree" }
  const k = repSigKindOfTy(r)
  if k != null && repSigTokHasSlot(k) { return frsRowClass(fe, lr) }
  "kind: recorded " + rec + ", lowered " + lr
}

// The row class of valued function `fe` whose recorded result has a slot the lowering keys
// elsewhere: each value it returns, by the row its stamp names, against token `lr`.
function frsRowClass(fe: i32, lr: string): string {
  const fn = nodeAt(fnStmts[fe])
  if !(fn is FuncDecl) { return "row: not a function" }
  const vals: i32[] = []
  collectRetValues(fn.fnBody, vals)
  if vals.length == 0 { return "row: no value returned" }
  const k = elabKeyAtPos(fe)
  let i = 0
  while i < vals.length {
    // A call-built value is built at the row its root call is stamped at.
    const root = retValueRootCall(vals[i])
    let sty = nodeRepTyIxOf(if root >= 0 { root } else { vals[i] })
    // An instance's body is typed at its template, so its stamp closes under the binding.
    if sty >= 0 && tyHasTyVar(sty) && k >= 0 { sty = elabSubstClosed(sty, k) }
    const st = frsFoldSetTok(repSigRetTokOfTy(sty))
    if st != frsFoldSetTok(lr) {
      return "row: stamped " + st + ", lowered " + lr
    }
    i = i + 1
  }
  "row agree"
}

// Token `t` with a set's map shape folded to its map sibling, as the lowering keys it
// (`mapShapeFoldSet`): `-2`, `-5` and `-7` read as `-1`, `-4` and `-6`.
function frsFoldSetTok(t: string): string {
  if t.length < 4 || (t[1] != 'm' && t[1] != 'M') { return t }
  const sh = t.slice(2, t.length - 1)
  if sh == "-2" { return t.slice(0, 2) + "-1;" }
  if sh == "-5" { return t.slice(0, 2) + "-4;" }
  if sh == "-7" { return t.slice(0, 2) + "-6;" }
  t
}

// The result the shadow grades function `fe` by: its recorded one, else the annotation of a
// function the emitter mints after the checker (`$eqc`, `$extv`), which no checker node types.
function frsRecordedOrAnn(fe: i32): i32 {
  const r = fnRecordedRetTy(fe)
  if r >= 0 || fe < 0 || fe >= fnStmts.length { return r }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return nodeTyIxOf(fn.fnRet) }
  }
  r
}

function frsCount(key: string) {
  let i = 0
  while i < frsRowKey.length {
    if frsRowKey[i] == key {
      frsRowN[i] = frsRowN[i] + 1
      return 0
    }
    i = i + 1
  }
  frsRowKey.push(key)
  frsRowN.push(1)
  0
}

export function fnRetShadowRowCount() { frsRowKey.length }

export function fnRetShadowRowLen(i: i32) { frsRowKey[i].length }

export function fnRetShadowRowAt(i: i32, j: i32) { frsRowKey[i][j] }

export function fnRetShadowRowN(i: i32) { frsRowN[i] }

// Count every un-annotated function the emitter lowers valued by how the rep of its recorded
// result meets the return columns, each class prefixed with `at`: the pass about to run or
// just run.
export function fnColShadowRun(at: string) {
  if !frsColArmed { return 0 }
  if at == "post seed" { frsColSnap() }
  let fe = 0
  while fe < fnStmts.length && fe < fRetVoid.length && fe < fRetKind.length {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl {
      if fRetVoid[fe] == 0 && fn.fnRet < 0 {
        const cls = frsColClass(fe)
        let key = at + ": " + cls
        if frsNamed { key = key + " | " + fn.fnName }
        frsCount(key)
        // Whether the run just ended moved the columns `buildFnMap#2` seeded, by class.
        if at == "post settled" && fe < frsSnapKind.length {
          const mv = if frsColMoved(fe) { "moved" } else { "unmoved" }
          let mk = "post moved: " + mv + ": " + cls
          if frsNamed { mk = mk + " | " + fn.fnName }
          frsCount(mk)
        }
      }
    }
    fe = fe + 1
  }
  0
}

let frsSnapKind: VKind[] = []
let frsSnapSlot: i32[] = []
let frsSnapElem: string[] = []
let frsSnapBool: i32[] = []

// Snapshot the return columns, for `frsColMoved`.
function frsColSnap() {
  frsSnapKind = []
  frsSnapSlot = []
  frsSnapElem = []
  frsSnapBool = []
  let fe = 0
  while fe < fRetKind.length {
    frsSnapKind.push(fRetKind[fe])
    frsSnapSlot.push(fRetStructIdx[fe])
    frsSnapElem.push(
      if fe < fRetRArrElem.length { fRetRArrElem[fe] } else { "" },
    )
    frsSnapBool.push(if fe < fRetBool.length { fRetBool[fe] } else { 0 })
    fe = fe + 1
  }
  0
}

// Whether function `fe`'s kind, slot, element name or boolean flag differs from the snapshot.
function frsColMoved(fe: i32): boolean {
  if frsSnapKind[fe] != fRetKind[fe] || frsSnapSlot[fe] != fRetStructIdx[fe] {
    return true
  }
  if fe < fRetRArrElem.length && frsSnapElem[fe] != fRetRArrElem[fe] {
    return true
  }
  fe < fRetBool.length && frsSnapBool[fe] != fRetBool[fe]
}

// The first return column of valued function `fe` that its recorded result's columns
// (`fnRecordedRetCols`) do not reproduce, as a class; a missing fact is named by its class.
function frsColClass(fe: i32): string {
  let r = fnRecordedRetTy(fe)
  if frsDrop == 1 { r = -1 }
  if frsDrop == 2 { r = TY_VOID }
  const miss = frsColsOfTy(fe, r)
  if miss != "" { return miss }
  if frcKind != fRetKind[fe] {
    return "kind " + frcKind + " vs " + fRetKind[fe]
  }
  if (
    frcKind == "reflist"
    && fe < fRetRListRow.length
    && frcRow != fRetRListRow[fe]
  ) {
    return "row reflist: "
      + i32ToStr(frcRow)
      + " vs "
      + i32ToStr(fRetRListRow[fe])
  }
  if frcSlot != fRetStructIdx[fe] {
    if frcKind == "map" || frcKind == "nulmap" {
      return "slot "
        + frcKind
        + ": "
        + i32ToStr(frcRow)
        + " vs "
        + i32ToStr(fRetStructIdx[fe])
    }
    if !repSigTokHasSlot(frcKind) {
      return "slot " + frcKind + ": no-slot kind, slots differ"
    }
    if frcSlot < 0 {
      return "slot " + frcKind + ": recorded names no row, column does"
    }
    if fRetStructIdx[fe] < 0 {
      return "slot " + frcKind + ": column names no row, recorded does"
    }
    return "slot " + frcKind + ": rows differ"
  }
  if fe < fRetRArrElem.length && frcElem != fRetRArrElem[fe] {
    if fRetRArrElem[fe] == "" {
      return "elem " + frcKind + ": column names none"
    }
    if frcElem == "" { return "elem " + frcKind + ": recorded names none" }
    return "elem " + frcKind + ": names differ"
  }
  if fe < fRetBool.length && frcBool != fRetBool[fe] {
    return if frcBool == 1 { "bool: recorded boolean, column not" } else { "bool: column boolean, recorded not" }
  }
  if fe < fRetLitAtom.length && frcAtom != fRetLitAtom[fe] {
    return if frcAtom == 1 { "atom: recorded atom, column not" } else { "atom: column atom, recorded not" }
  }
  "agree " + frcKind
}

// The return columns `fnRecordedRetCols` last answered: kind, slot, ref-list element name,
// boolean flag and literal-atom flag.
export let frcKind: VKind = "i32"
export let frcSlot = -1
export let frcRow = -1
export let frcElem = ""
export let frcBool = 0
export let frcAtom = 0

// Whether return kind `k` keeps its table row in `fRetStructIdx`.
function frsKindHasRow(k: VKind): boolean {
  k == "struct" || k == "nulstruct" || k == "variant" || k == "nulvariant"
}

// Read valued function `fe`'s return columns off its recorded result into `frcKind`..`frcAtom`:
// the rep's kind (a closure keyed `i32`), the row `repSlotOfKind` finds, a ref list's element
// name. "" when read, else the missing fact that leaves them to the body walk, by class.
export function fnRecordedRetCols(fe: i32): string {
  frsColsOfTy(fe, fnRecordedRetTy(fe))
}

// `fnRecordedRetCols` of function `fe` over result `r`; after `monomorphize`, a type variable
// nothing bound is read at the type it takes unbound (`elabUnboundTpTy`), as the emitter lowers it.
function frsColsOfTy(fe: i32, r0: i32): string {
  if r0 == TY_VOID || r0 == TY_NEVER { return "recorded void or never" }
  if r0 < 0 || r0 >= T.tys.length { return "no result recorded" }
  const tv = tyAt(r0)
  const open = tv is TyVar && emitPhaseReached("monomorphized")
  const r1 = if open && tv is TyVar { elabUnboundTpTy(-1, fnStmts[fe], tv.tvName) } else { r0 }
  // Maps nothing can tell apart return as their one map.
  const tw = mapTwinUnionMember(r1)
  const r = if tw >= 0 { tw } else { r1 }
  const d = repOfTy(r)
  if d.rdCovered == 0 { return "rep uncovered" }
  // A map's columns name no row, so a map whose value type is still open is a map all the same.
  const mapCols = (d.rdKind == "map" || d.rdKind == "nulmap")
    && tyAt(nonNullTy(r)) is TyMap
  if repSigRetTokOfTy(r) == "" && !mapCols {
    return "recorded result has no token"
  }
  frcKind = if d.rdKind == "closure" { "i32" } else { d.rdKind }
  // A closure result mono lowered as its bundle's record: the record of members a call returns,
  // or the bundle parameter the instance hands back.
  if d.rdKind == "closure" {
    const br = fnBundleRetRow(fe)
    if br == -2 { return "bundle record has no row" }
    if br >= 0 {
      frcKind = "struct"
      frcSlot = br
      frcRow = br
      frcElem = ""
      frcBool = 0
      frcAtom = 0
      return ""
    }
  }
  // `fRetStructIdx` carries a row only for a record or variant; a ref list's row is
  // `fRetRListRow`, and a map's shape is read off its type.
  frcRow = if repSigTokHasSlot(frcKind) { repSlotOfKind(frcKind, r) } else { -1 }
  frcSlot = if frsKindHasRow(frcKind) { frcRow } else { -1 }
  frcElem = ""
  if frcKind == "reflist" && frcRow >= 0 && frcRow < rlElemName.length {
    frcElem = rlElemName[frcRow]
  }
  frcBool = if r == TY_BOOL { 1 } else { 0 }
  frcAtom = d.rdAtom
  ""
}
