// Capture-rows walk: the sole references, widened declarations and open statements of the
// body being checked, and the frame and handle a nested function's capture resolves to.
// Does not import the checker.
import { placeNameTy, placeText } from "./check_place_ids"
import { declTyOf, slotNameOf, slotVisibleOf } from "./check_scopes"
import {
  FuncDecl,
  P,
  Param,
  binderNameAt,
  elseIfLink,
  nodeAt,
  nodeSpineChildren,
} from "./ast"
import { T, tyIsHole } from "./check_types"
import {
  crAskProg,
  crEscNames,
  crFnBases,
  crFnIxs,
  crPendNames,
  crProgRoot,
  crRdIx,
  crRdRet,
  crRetCalls,
  crRetLoops,
  crRetNames,
  crRetNarTys,
  crRetRoots,
  crRetWideTys,
  crRhsBys,
  crRhsNames,
  crRhsOps,
  crRhsRetired,
  crSoleDecls,
  crSoleDepths,
  crSoleRoots,
  crSoleTys,
  crStmtFns,
  crStmtIxs,
  crStmtPend,
  crStmtRd,
  crStmtScopes,
  crWideDepths,
  crWideNames,
  crWideSlots,
} from "./check_capture_rows"
import {
  crEscWalk,
  crNoNames,
  crwBindDeclOf,
  crwEnsure,
} from "./check_capture_walks"
import { asgDeclDepths, asgDeclSlots } from "./check_nar_bank"
import { crCurRoot, crFnBase } from "./check_capture_widen"
import { strListHas } from "./listutil"

// Drop the records of the scope being left, at depth `d` and deeper.
export function crPopSoleTo(d: i32) {
  while crSoleDepths.length > 0 && crSoleDepths[crSoleDepths.length - 1] >= d {
    crSoleDecls.pop()
    crSoleDepths.pop()
    crSoleRoots.pop()
    crSoleTys.pop()
  }
  0
}

// Whether the body being checked belongs to a function with an un-annotated parameter still
// typed as a hole. Its body is checked again at each call's argument types, which decide; a
// declared-type read settled here would be carried into that check against types it never saw.
export function crInHoleTemplate(): boolean {
  let f = 0
  while f < crFnIxs.length {
    const fd = nodeAt(crFnIxs[f])
    if fd is FuncDecl {
      let i = 0
      while i < fd.fnParams.length {
        const pn = nodeAt(fd.fnParams[i])
        if pn is Param {
          if tyIsHole(declTyOf(fd.fnParams[i])) { return true }
        }
        i = i + 1
      }
    }
    f = f + 1
  }
  false
}

// Enter and leave one statement of a block. Leaving drops the statement's pending names — the
// emitter has retired them by then — and its read rows.
export function crStmtEnter(stmtIx: i32) {
  crStmtIxs.push(stmtIx)
  crStmtFns.push(crFnBases.length)
  crStmtPend.push(crPendNames.length)
  crStmtRd.push(crRdRet.length)
  crStmtScopes.push(T.frames.length)
  0
}

// The visible slots of the names narrowed in the current function, one per name.
export function crLiveSlots(): i32[] {
  const out: i32[] = []
  const seen: {[string]: boolean} = Map()
  const base = crFnBase()
  let i = 0
  while i < asgDeclSlots.length {
    if asgDeclDepths[i] >= base {
      const nm = slotNameOf(asgDeclSlots[i])
      const vs = slotVisibleOf(asgDeclSlots[i])
      if vs != -1 && !seen.has(nm) {
        seen[nm] = true
        out.push(vs)
      }
    }
    i = i + 1
  }
  out
}

// The innermost open statement that holds the scope at depth `d`, or -1.
export function crStmtHolding(d: i32): i32 {
  let i = crStmtIxs.length - 1
  while i >= 0 {
    if crStmtFns[i] != crFnBases.length { return -1 }
    if crStmtScopes[i] <= d { return crStmtIxs[i] }
    i = i - 1
  }
  -1
}

// Whether `name` is bound in the innermost scope only by `crDeclareWidened`.
export function crWidenedInTop(name: string): boolean {
  const d = T.frames.length - 1
  let i = crWideNames.length - 1
  while i >= 0 && crWideDepths[i] >= d {
    if crWideDepths[i] == d && crWideNames[i] == name { return true }
    i = i - 1
  }
  false
}

// A declaration of `name` in the innermost scope replaces its `crDeclareWidened` binding.
export function crUnwidenTop(name: string) {
  const d = T.frames.length - 1
  let i = crWideNames.length - 1
  while i >= 0 && crWideDepths[i] >= d {
    if crWideDepths[i] == d && crWideNames[i] == name {
      crWideNames[i] = ""
      crWideSlots[i] = -1
    }
    i = i - 1
  }
  0
}

// The declaration a nested function is only ever called by: its own, or the binding holding it; -1.
export function crLambdaHandle(fnIx: i32): i32 {
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    if fd.fnName != "" { return fnIx }
  }
  crwEnsure(crCurRoot())
  crwBindDeclOf[fnIx] ?? -1
}

// 1 when the nested function `fnIx` may run anywhere but at a call by its handle in the body of
// the function that makes it: it has no handle, or the handle is used other than as that
// body's own callee — stored, passed, returned, reassigned, or called from a nested function.
export function crLambdaEscapes(fnIx: i32): i32 {
  const h = crLambdaHandle(fnIx)
  if h < 0 { return 1 }
  let body = crProgRoot
  if crFnIxs.length >= 2 {
    const pf = nodeAt(crFnIxs[crFnIxs.length - 2])
    if pf is FuncDecl { body = pf.fnBody }
  }
  if crEscapesIn(body, h) { return 1 }
  0
}

// Whether the binding declared at `decl` is read in `body` other than as its own callee, from one
// walk per body.
export function crEscapesIn(body: i32, decl: i32): boolean {
  if body == crProgRoot { crAskProg("e", binderNameAt(decl)) }
  let esc = crEscNames[body]
  if esc == null {
    const got: {[i32]: boolean} = Map()
    crEscWalk(body, false, got)
    crEscNames[body] = got
    esc = got
  }
  (esc ?? crNoEsc).has(decl)
}

const crNoEsc: {[i32]: boolean} = Map()

// Whether the binding declared at `decl` is read in the body being checked other than as its own
// callee.
export function crDeclEscapesHere(decl: i32): boolean {
  let body = crProgRoot
  if crFnIxs.length >= 1 {
    const pf = nodeAt(crFnIxs[crFnIxs.length - 1])
    if pf is FuncDecl { body = pf.fnBody }
  }
  crEscapesIn(body, decl)
}

// The node that retired `name` in the right operand of the `&&`/`||` at `opIx`, or -1.
function crRhsRetiredBy(opIx: i32, name: string): i32 {
  let i = crRhsOps.length - 1
  while i >= 0 {
    if crRhsOps[i] == opIx && crRhsNames[i] == name { return crRhsBys[i] }
    i = i - 1
  }
  -1
}

// Whether a `&&`/`||` in the condition at `condIx` had its right operand retire `name`: the
// condition's arms then hold no fact about it, and no join below the `if` may install one.
export function crCondRetired(condIx: i32, name: string): boolean {
  if crRhsRetired.length == 0 || condIx < 0 || condIx >= P.nodes.length {
    return false
  }
  const r = crRhsRetired[condIx] ?? crNoNames
  if strListHas(r, name) { return true }
  let cur = condIx
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if crCondRetired(kids[k], name) { return true }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// Drop the facts collected since `mark` that the right operand of the `&&`/`||` at `opIx` retired.
// A re-test in the right operand then narrows again.
export function crFilterRhsRetired(
  opIx: i32,
  places: i32[],
  tys: i32[],
  mark: i32,
) {
  if crRhsRetired.length == 0 { return 0 }
  const gone = crRhsRetired[opIx] ?? crNoNames
  if gone.length == 0 { return 0 }
  let w = mark
  let i = mark
  while i < places.length {
    const nm = placeText(places[i])
    if strListHas(gone, nm) {
      const by = crRhsRetiredBy(opIx, nm)
      if by >= 0 {
        crRetNames.push(nm)
        crRetCalls.push(by)
        crRetNarTys.push(tys[i])
        crRetWideTys.push(placeNameTy(places[i]))
        crRetRoots.push(crCurRoot())
        crRetLoops.push(false)
      }
    } else {
      places[w] = places[i]
      tys[w] = tys[i]
      w = w + 1
    }
    i = i + 1
  }
  while places.length > w {
    places.pop()
    tys.pop()
  }
  0
}

// The path twin of `crReadHook`'s note half: a read of `key` with no narrowing left, after a
// condition dropped a fact about it, is remembered so a diagnostic spanning it names the cause.
export function crPathDropRead(key: string, ix: i32) {
  if crRetNames.length == 0 || crStmtIxs.length == 0 { return 0 }
  const root = crCurRoot()
  let r = crRetNames.length - 1
  while r >= 0 {
    if crRetNames[r] == key && crRetRoots[r] == root {
      if crRetWideTys[r] < 0 {
        crRdRet.push(r)
        crRdIx.push(ix)
      }
      return 0
    }
    r = r - 1
  }
  0
}
