// The read query's shadow (`elab_reads.vl`), armed with the rep shadow (`$VL_REP_SHADOW`): check's
// answer for each call's callee read is saved as `elabPrepare` ends, each read mono's rewrite asks
// is compared with it, and `mfrSnapReadsLine` counts the saved answers for the iface dump.
// Unarmed it saves nothing and costs one boolean test.
import { Call, FuncDecl, Ident, P, i32ToStr, nodeAt } from "./ast"
import { identDeclOf } from "./symbols"
import { parenPeelIx } from "./check_places"
import { cwIxCoveredLen } from "./check_write_scan"
import { optCallCalleeOf } from "./check_core_state"
import { repABNote } from "./emit_nullable_rets"
import { elabReadFns, mfrLeafFn } from "./elab_reads"

// Check's answer per callee read, as the function list's key (`mfrFnsKey`). Emptied by
// `mfrSnapReset`, refilled by `mfrCheckSnap`.
let mfrSnap: {[i32]: string} = Map()
let mfrSnapNames: {[i32]: string} = Map()
let mfrSnapOne = 0
let mfrSnapMany = 0
let mfrSnapNone = 0
// The arena prefix already saved; the scan resumes from it.
let mfrSnapDone = 0

export function mfrSnapReset() {
  mfrSnap = Map()
  mfrSnapNames = Map()
  mfrSnapOne = 0
  mfrSnapMany = 0
  mfrSnapNone = 0
  mfrSnapDone = 0
  return 0
}

// Saves check's answer for each call whose callee is not a declared function's name.
export function mfrCheckSnap() {
  mfrSnapReset()
  let i = mfrSnapDone
  while i < P.nodes.length && i < cwIxCoveredLen() {
    const n = nodeAt(i)
    if n is Call {
      const x = parenPeelIx(n.callFn)
      if x >= 0 && !mfrNamesFn(x) {
        const fs = elabReadFns(x, i)
        mfrSnap[x] = mfrFnsKey(fs)
        mfrSnapNames[x] = mfrFnsNames(fs)
        if fs.length == 0 { mfrSnapNone = mfrSnapNone + 1 }
        else if fs.length == 1 { mfrSnapOne = mfrSnapOne + 1 }
        else { mfrSnapMany = mfrSnapMany + 1 }
      }
    }
    i = i + 1
  }
  mfrSnapDone = i
  return 0
}

// The saved answers' counts: callee reads holding one function, several, or none known. Empty
// when nothing is saved.
export function mfrSnapReadsLine(): string {
  if mfrSnapOne + mfrSnapMany + mfrSnapNone == 0 { return "" }
  return "reads one "
    + i32ToStr(mfrSnapOne)
    + " many "
    + i32ToStr(mfrSnapMany)
    + " none "
    + i32ToStr(mfrSnapNone)
}

// Whether callee `x` is a name a function declaration binds.
function mfrNamesFn(x: i32): boolean {
  if !(nodeAt(x) is Ident) { return false }
  const d = identDeclOf(x)
  return d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl
}

// The declared names of `fs` (`?` for a lambda), for a `changed` note.
function mfrFnsNames(fs: i32[]): string {
  let out = ""
  for f in fs {
    const fn = if f >= 0 && f < P.nodes.length { nodeAt(f) } else { nodeAt(0) }
    out = out + "+" + (if f >= 0 && fn is FuncDecl { fn.fnName } else { "?" })
  }
  return out
}

function mfrFnsKey(fs: i32[]): string {
  let k = ""
  for f in fs { k = k + "," + i32ToStr(f) }
  return k
}

// Notes how the elaboration's answer for read `x` compares with generic `g`, the one the rewrite
// names, where `call` is the call `x` is the callee of (-1 for none), and whether check saved the
// same answer. Ask before the rewrite.
export function mfrShadowNote(x: i32, g: i32, call: i32) {
  // A read rewritten already names its generic, and a second ask would agree with itself.
  if x >= 0 && x < P.nodes.length && nodeAt(x) is Ident && identDeclOf(x) == g {
    repABNote("mfr", "reset", "")
    return 0
  }
  // A desugared optional call's callee is minted after check: it answers through its `?.` read.
  const ox = if x >= cwIxCoveredLen() { optCallCalleeOf[x] ?? x } else { x }
  const es = elabReadFns(ox, call)
  const gg = mfrLeafFn(g)
  const oc = if es.length == 0 { "none" } else if es.length > 1 { "several" } else if es[0] == gg { "agree" } else { "differ" }
  const was = mfrSnap[ox] ?? "?"
  const now = mfrFnsKey(es)
  const vs = if was == "?" { "unsaved" } else if was == now { "same" } else { "changed:" + (mfrSnapNames[ox] ?? "") + ">" + mfrFnsNames(es) }
  return repABNote("mfr", oc, (if call >= 0 { "call/" } else { "read/" }) + vs)
}
