// The function a read the monoFlow* rewrite re-points holds: the elaboration's answer
// (`mfrElabNames`) and its shadow, and the chain walk that admits a callee read (`mfrChainFns`).
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  i32ToStr,
  nodeAt,
} from "./ast"
import { identDeclOf, memberMethodOf } from "./symbols"
import { i32ListHas } from "./listutil"
import { optCallCalleeOf } from "./check_core_state"
import {
  cwBindingOf,
  cwBindingWrittenValues,
  cwHeldFnOf,
  cwIxBuild,
  cwIxCoveredLen,
  letReadFnOf,
  cwKeyOfDecl,
  cwLetUnwritten,
  cwParamArgs,
  cwSlotPath,
  cwSlotWriteCount,
  cwSlotWrittenValues,
} from "./check_write_scan"
import { collectRetValues } from "./check_nj_join"
import { identFnDeclOf } from "./check_scopes"
import { parenPeelIx } from "./check_places"
import { constListFnElemDecl } from "./check_calls"
import { elabCalleeFnsOf, elabSlotFlowFns } from "./emit_elab"
import { repABNote } from "./emit_nullable_rets"
import { monoIsGenericDecl, tyIsFuncType } from "./emit_base"
import { recEnclosingFn } from "./check_fit_rules"
import { opDeclAtNode } from "./check_callee"
import { elabCallDeclOf } from "./check_elab_cap"
import { monoNameIsExported } from "./value_reach"

// Notes how the elaboration's answer for read `x` compares with generic `g`, the one the rewrite
// names, where `call` is the call `x` is the callee of (-1 for none). Ask before the rewrite.
export function mfrShadowNote(x: i32, g: i32, call: i32) {
  // A read rewritten already names its generic, and a second ask would agree with itself.
  if x >= 0 && x < P.nodes.length && nodeAt(x) is Ident && identDeclOf(x) == g {
    repABNote("mfr", "reset", "")
    return 0
  }
  const es = mfrElabFns(x, call)
  const gg = mfrLeafFn(g)
  const oc = if es.length == 0 { "none" } else if es.length > 1 { "several" } else if es[0] == gg { "agree" } else { "differ" }
  repABNote("mfr", oc, if call >= 0 { "call" } else { "read" })
}

// Whether the elaboration names generic `g` as the one function read `x` holds, `call` the call
// `x` is the callee of (-1 for none): the rewrite's answer, which mono's walkers only gate. A read
// already rewritten to `g` answers itself.
export function mfrElabNames(x: i32, g: i32, call: i32): boolean {
  if x >= 0 && x < P.nodes.length && nodeAt(x) is Ident && identDeclOf(x) == g {
    return true
  }
  // A desugared optional call's callee is minted after the elaboration ran: it answers through
  // the `?.` read the callee stands for.
  const ox = if x >= cwIxCoveredLen() { optCallCalleeOf[x] ?? -1 } else { x }
  if ox < 0 { return true }
  const es = mfrElabFns(ox, call)
  es.length == 1 && es[0] == mfrLeafFn(g)
}

// The functions read `x` holds, by the first that answers: a module-scope `const` list's element
// (`constListFnElemDecl`), the element its literal-index steps reach (`mfrIndexedFns`), the field or
// element of a literal it reads straight out of, its slot's value-flow set, its call's callees.
function mfrElabFns(x: i32, call: i32): i32[] {
  const none: i32[] = []
  if x < 0 || x >= cwIxCoveredLen() { return none }
  // A read of a re-pointed `let` holds the function its most recent write stored.
  const rf = letReadFnOf(x)
  if rf >= 0 { return [rf] }
  const el = constListFnElemDecl(x)
  if el >= 0 { return [el] }
  const ix = mfrIndexedFns(x)
  if ix.length > 0 { return ix }
  const lv = mfrLitReadValue(x)
  if lv >= 0 {
    const lf = cwHeldFnOf(lv)
    return if lf >= 0 { [lf] } else { none }
  }
  const path: string[] = []
  const rt = cwSlotPath(x, path)
  const d = if rt >= 0 { identDeclOf(rt) } else { -1 }
  if d >= 0 && d < cwIxCoveredLen() && nodeAt(d) is LetDecl {
    const ep: string[] = []
    for st in path {
      if st == "[]" { ep.push("e") } else { ep.push("f." + st) }
    }
    return elabSlotFlowFns(d, ep)
  }
  if call >= 0 { return elabCalleeFnsOf(call) }
  none
}

// The function a rewrite leaf names: the lambda a `const` binds, else the leaf itself.
function mfrLeafFn(g: i32): i32 {
  if g < 0 || g >= P.nodes.length { return g }
  const gn = nodeAt(g)
  if gn is LetDecl { return parenPeelIx(gn.letInit) }
  g
}

// The value a read straight out of a literal names: field `f` of `{ f: v }.f`, else element `k`
// of a spread-free `[..][k]` at a literal index (`mfrLitElemValue`); -1 for any other read.
function mfrLitReadValue(x: i32): i32 {
  const n = nodeAt(x)
  if n is Member {
    const o = nodeAt(parenPeelIx(n.memObj))
    if o is ObjLit {
      for f in o.objFields {
        const fi = nodeAt(f)
        if fi is FieldInit {
          if fi.fiName == n.memProp { return fi.fiValue }
        }
      }
    }
    return -1
  }
  mfrLitElemValue(x)
}

// Element `k` of the spread-free list literal an index read `x` reads at a literal index; -1 for
// any other read.
function mfrLitElemValue(x: i32): i32 {
  const n = nodeAt(x)
  if !(n is Index) { return -1 }
  const a = nodeAt(parenPeelIx(n.idxArr))
  const k = nodeAt(n.idxIndex)
  if !(a is ArrayLit) || !(k is NumLit) { return -1 }
  for e in a.arrElems {
    if nodeAt(e) is Spread { return -1 }
  }
  let j = 0
  while j < a.arrElems.length {
    if i32ToStr(j) == k.numText { return a.arrElems[j] }
    j = j + 1
  }
  -1
}

// The one function an indexed read `x` (`r[k]...`, a literal index at least once) names: the
// element each value its root can hold has at those steps, the root a `const` (its initialiser, or
// what the call initialising it returns) or a parameter (each call's argument); [] when they differ,
// a step is not a literal's part, or the slot is written after it is built.
function mfrIndexedFns(x: i32): i32[] {
  const none: i32[] = []
  const rev: string[] = []
  let cur = parenPeelIx(x)
  let hasIdx = false
  while cur >= 0 && cur < P.nodes.length && rev.length < 8 {
    const st = mfrStep(cur)
    if st == "" { break }
    if st.length > 0 && st[0] == "#"[0] { hasIdx = true }
    rev.push(st)
    cur = parenPeelIx(mfrStepObj(cur))
  }
  if !hasIdx || cur < 0 { return none }
  const steps: string[] = []
  const cp: string[] = []
  let k = rev.length - 1
  while k >= 0 {
    steps.push(rev[k])
    cp.push(
      if rev[k][0] == "#"[0] { "[]" } else { rev[k].slice(2, rev[k].length) },
    )
    k = k - 1
  }
  const seeds: i32[] = []
  // A call's result is fresh, so no write reaches it before the read.
  const cfd = mfrCalledFnDecl(cur)
  const cfn = if cfd >= 0 { nodeAt(cfd) } else { nodeAt(cur) }
  if cfn is FuncDecl {
    collectRetValues(cfn.fnBody, seeds)
  } else {
    if !(nodeAt(cur) is Ident) { return none }
    const d = identDeclOf(cur)
    if d < 0 || d >= cwIxCoveredLen() { return none }
    if cwSlotWriteCount(cwBindingOf(cur), cp) != 0 { return none }
    if !mfrRootSeeds(d, seeds) { return none }
  }
  if seeds.length == 0 { return none }
  let g = -1
  const leaves: i32[] = []
  for sd in seeds {
    if !mfrDescendSteps(sd, steps, 0, 0, leaves) { return none }
  }
  for leaf in leaves {
    const f = mfrLeafHeldFn(leaf, 0)
    if f < 0 || (g >= 0 && f != g) { return none }
    g = f
  }
  if g >= 0 { [g] } else { none }
}

// The step read `ix` takes from its object: `#k` for a literal index, `f.<name>` for a field; ""
// for any other node.
function mfrStep(ix: i32): string {
  const n = nodeAt(ix)
  if n is Member { return "f." + n.memProp }
  mfrIndexStep(ix)
}

function mfrIndexStep(ix: i32): string {
  const n = nodeAt(ix)
  if !(n is Index) { return "" }
  const k = nodeAt(n.idxIndex)
  if k is NumLit { "#" + k.numText } else { "" }
}

// The object node step `ix` reads from (`mfrStep`).
function mfrStepObj(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Member { return n.memObj }
  mfrIndexObj(ix)
}

function mfrIndexObj(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Index { n.idxArr } else { -1 }
}

// The values the binding declared at `d` can be built from, onto `out`: a `const`'s initialiser, or
// what the function its initialising call names returns; a parameter's argument at each call. False
// when one is not known.
function mfrRootSeeds(d: i32, out: i32[]): boolean {
  const dn = nodeAt(d)
  if dn is LetDecl {
    if dn.letKw != "const" || dn.letType >= 0 || dn.letInit < 0 { return false }
    const fd = mfrCalledFnDecl(dn.letInit)
    if fd < 0 {
      out.push(dn.letInit)
      return true
    }
    const fn = nodeAt(fd)
    if fn is FuncDecl {
      collectRetValues(fn.fnBody, out)
      return true
    }
    return false
  }
  cwParamArgs(d, out)
}

// The declared function a call `e` names; -1 for any other node.
function mfrCalledFnDecl(e: i32): i32 {
  const n = nodeAt(parenPeelIx(e))
  if n is Call { identFnDeclOf(parenPeelIx(n.callFn)) } else { -1 }
}

// The function leaf `v` names, through `const` aliases and a parameter's argument at each call
// (all of which must agree); -1 otherwise.
function mfrLeafHeldFn(v: i32, hops: i32): i32 {
  const f = cwHeldFnOf(v)
  if f >= 0 || hops > 8 { return f }
  const x = parenPeelIx(v)
  if x < 0 || !(nodeAt(x) is Ident) { return -1 }
  const d = identDeclOf(x)
  const args: i32[] = []
  if d < 0 || !cwParamArgs(d, args) || args.length == 0 { return -1 }
  let g = -1
  for a in args {
    const af = mfrLeafHeldFn(a, hops + 1)
    if af < 0 || (g >= 0 && af != g) { return -1 }
    g = af
  }
  g
}

// The nodes value `v` holds after `steps[i..]`, onto `out`: through `const` aliases, a parameter's
// argument at each call, and list and record literals; false where a step is not a literal's part.
function mfrDescendSteps(
  v: i32,
  steps: string[],
  i: i32,
  hops: i32,
  out: i32[],
): boolean {
  const x = parenPeelIx(v)
  if x < 0 || x >= P.nodes.length || hops > 16 { return false }
  if i >= steps.length {
    out.push(x)
    return true
  }
  const n = nodeAt(x)
  if n is Ident {
    const d = identDeclOf(x)
    if d < 0 { return false }
    const dn = nodeAt(d)
    if dn is LetDecl {
      if dn.letType >= 0 || dn.letInit < 0 { return false }
      if dn.letKw != "const" && !cwLetUnwritten(d) { return false }
      const rest: string[] = []
      let r = i
      while r < steps.length {
        rest.push(
          if steps[r][0] == "#"[0] { "[]" } else { steps[r].slice(2, steps[r].length) },
        )
        r = r + 1
      }
      if cwSlotWriteCount(cwBindingOf(x), rest) != 0 { return false }
      return mfrDescendSteps(dn.letInit, steps, i, hops + 1, out)
    }
    const args: i32[] = []
    if !cwParamArgs(d, args) || args.length == 0 { return false }
    for a in args {
      if !mfrDescendSteps(a, steps, i, hops + 1, out) { return false }
    }
    return true
  }
  // A call holds what its declared function returns.
  const cfd = mfrCalledFnDecl(x)
  const cfn = if cfd >= 0 { nodeAt(cfd) } else { n }
  if cfn is FuncDecl {
    const rets: i32[] = []
    collectRetValues(cfn.fnBody, rets)
    if rets.length == 0 { return false }
    for rv in rets {
      if !mfrDescendSteps(rv, steps, i, hops + 1, out) { return false }
    }
    return true
  }
  mfrDescendLit(x, steps, i, hops, out)
}

// One step of `mfrDescendSteps` into the list or record literal `x`.
function mfrDescendLit(
  x: i32,
  steps: string[],
  i: i32,
  hops: i32,
  out: i32[],
): boolean {
  const n = nodeAt(x)
  const st = steps[i]
  if n is ArrayLit {
    if st[0] != "#"[0] { return false }
    for e in n.arrElems {
      if nodeAt(e) is Spread { return false }
    }
    let j = 0
    while j < n.arrElems.length {
      if "#" + i32ToStr(j) == st {
        return mfrDescendSteps(n.arrElems[j], steps, i + 1, hops + 1, out)
      }
      j = j + 1
    }
    return false
  }
  mfrDescendObj(x, steps, i, hops, out)
}

function mfrDescendObj(
  x: i32,
  steps: string[],
  i: i32,
  hops: i32,
  out: i32[],
): boolean {
  const n = nodeAt(x)
  if !(n is ObjLit) { return false }
  for f in n.objFields {
    const fi = nodeAt(f)
    if fi is FieldInit {
      if "f." + fi.fiName == steps[i] {
        return mfrDescendSteps(fi.fiValue, steps, i + 1, hops + 1, out)
      }
    }
  }
  false
}

// The one function read `x` holds along every link of its value chain: a written binding holds
// every value written to it, a slot every value stored there, `??` both sides, a parameter every
// call's argument. [] when a link is unknown, the links name two, or the read is rooted at a
// parameter (its argument stays built as a value at the call).
export function mfrChainFns(x: i32): i32[] {
  const none: i32[] = []
  if x < 0 || x >= cwIxCoveredLen() { return none }
  let rt = parenPeelIx(x)
  let k = 0
  while rt >= 0 && k < 16 {
    const st = mfrChainStep(rt)
    if st == "" || st == "!" { break }
    rt = parenPeelIx(mfrChainStepObj(rt))
    k = k + 1
  }
  if rt < 0 || !(nodeAt(rt) is Ident) { return none }
  const rd = identDeclOf(rt)
  if rd < 0 || rd >= P.nodes.length || !(nodeAt(rd) is LetDecl) { return none }
  const leaves: i32[] = []
  const steps: string[] = []
  if !mfrChainDescend(x, steps, 0, 0, leaves) { return none }
  let g = -1
  for f in leaves {
    if g >= 0 && f != g { return none }
    g = f
  }
  if g >= 0 { [g] } else { none }
}

// The step read `ix` takes from its object: `#k` a literal index, `f.<name>` a field, `[]` a map
// key (a string index or `.get`); "!" for a computed index; "" when `ix` is not a read.
function mfrChainStep(ix: i32): string {
  const n = nodeAt(ix)
  if n is Member { return "f." + n.memProp }
  if n is Index {
    const k = nodeAt(n.idxIndex)
    if k is NumLit { return "#" + k.numText }
    if k is StrLit { return "[]" }
    return "!"
  }
  if n is Call { return if mfrChainGetObj(ix) >= 0 { "[]" } else { "" } }
  ""
}

function mfrChainStepObj(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Member { return n.memObj }
  if n is Index { return n.idxArr }
  mfrChainGetObj(ix)
}

// The receiver of a `m.get(k)` call `ix`; -1 otherwise.
function mfrChainGetObj(ix: i32): i32 {
  const n = nodeAt(ix)
  if !(n is Call) || n.callArgs.length != 1 || n.callFn < 0 { return -1 }
  const f = nodeAt(parenPeelIx(n.callFn))
  if f is Member && f.memProp == "get" { f.memObj } else { -1 }
}

// The functions value `v` holds after `steps[i..]`, onto `out`; false when a link is unknown.
function mfrChainDescend(
  v: i32,
  steps: string[],
  i: i32,
  hops: i32,
  out: i32[],
): boolean {
  const x = parenPeelIx(v)
  if x < 0 || x >= cwIxCoveredLen() || hops > 24 { return false }
  // A parenthesised name taken as a value is not instanced where it is built (D4120).
  if x != v && i >= steps.length && nodeAt(x) is Ident { return false }
  const st = mfrChainStep(x)
  if st == "!" { return false }
  if st != "" {
    const more: string[] = [st]
    let r = i
    while r < steps.length {
      more.push(steps[r])
      r = r + 1
    }
    return mfrChainDescend(mfrChainStepObj(x), more, 0, hops + 1, out)
  }
  const n = nodeAt(x)
  if n is Ident { return mfrChainIdent(x, steps, i, hops, out) }
  if n is BinExpr {
    if n.binOp != "??" { return false }
    return mfrChainDescend(n.binLeft, steps, i, hops + 1, out)
      && mfrChainDescend(n.binRight, steps, i, hops + 1, out)
  }
  if n is Call { return mfrChainCall(x, steps, i, hops, out) }
  if i >= steps.length { return false }
  mfrChainLit(x, steps, i, hops, out)
}

function mfrChainIdent(
  x: i32,
  steps: string[],
  i: i32,
  hops: i32,
  out: i32[],
): boolean {
  const d = identDeclOf(x)
  if d < 0 {
    const fd = identFnDeclOf(x)
    if fd < 0 || i < steps.length || !(nodeAt(fd) is FuncDecl) { return false }
    out.push(fd)
    return true
  }
  if d >= cwIxCoveredLen() { return false }
  const vals: i32[] = []
  const dn = nodeAt(d)
  match dn {
    FuncDecl => {
      if i < steps.length { return false }
      out.push(d)
      return true
    }
    Param => {
      if dn.parType >= 0 || dn.parDefault >= 0 { return false }
      // An exported function is called from outside the program too, with values no call here shows.
      const pf = recEnclosingFn(d)
      const pfn = if pf >= 0 { nodeAt(pf) } else { null }
      if !(pfn is FuncDecl) || monoNameIsExported(pfn.fnName) { return false }
      if !cwParamArgs(d, vals) || vals.length == 0 { return false }
    }
    LetDecl => {
      if dn.letType >= 0 { return false }
    }
    // no other declaration holds a value the chain follows
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      return false
    }
  }
  const b = cwBindingOf(x)
  if b < 0 { return false }
  for w in cwBindingWrittenValues(b) { vals.push(w) }
  if vals.length == 0 { return false }
  if i < steps.length {
    const cp: string[] = []
    let idx = false
    let r = i
    while r < steps.length {
      if steps[r][0] == "#"[0] { idx = true }
      cp.push(
        if steps[r][0] == "f"[0] { steps[r].slice(2, steps[r].length) } else { "[]" },
      )
      r = r + 1
    }
    if dn is Param {
      if cwSlotWriteCount(b, cp) != 0 { return false }
    } else {
      const sv: i32[] = []
      const ats: i32[] = []
      const nw = cwSlotWrittenValues(b, cp, sv, ats)
      if nw < 0 || (idx && nw != 0) { return false }
      if !idx {
        for w in sv {
          if !mfrChainDescend(w, steps, steps.length, hops + 1, out) {
            return false
          }
        }
      }
    }
  }
  for w in vals {
    if !mfrChainDescend(w, steps, i, hops + 1, out) { return false }
  }
  true
}

// A call holds what its declared function returns; `Map()` holds nothing below it.
function mfrChainCall(
  x: i32,
  steps: string[],
  i: i32,
  hops: i32,
  out: i32[],
): boolean {
  const n = nodeAt(x)
  if !(n is Call) || n.callFn < 0 { return false }
  const cf = parenPeelIx(n.callFn)
  if cf < 0 || cf >= P.nodes.length { return false }
  const fd = identFnDeclOf(cf)
  if fd < 0 {
    const c = nodeAt(cf)
    return i < steps.length
      && n.callArgs.length == 0
      && c is Ident
      && c.identName == "Map"
      && identDeclOf(cf) < 0
  }
  const fn = nodeAt(fd)
  if !(fn is FuncDecl) { return false }
  const rets: i32[] = []
  collectRetValues(fn.fnBody, rets)
  if rets.length == 0 { return false }
  for rv in rets {
    if !mfrChainDescend(rv, steps, i, hops + 1, out) { return false }
  }
  true
}

// One step into the list or record literal `x`; false past a list literal's end.
function mfrChainLit(
  x: i32,
  steps: string[],
  i: i32,
  hops: i32,
  out: i32[],
): boolean {
  const n = nodeAt(x)
  const st = steps[i]
  if n is ArrayLit {
    if st[0] != "#"[0] { return false }
    for e in n.arrElems {
      if nodeAt(e) is Spread { return false }
    }
    let j = 0
    while j < n.arrElems.length {
      if "#" + i32ToStr(j) == st {
        return mfrChainDescend(n.arrElems[j], steps, i + 1, hops + 1, out)
      }
      j = j + 1
    }
    return false
  }
  if !(n is ObjLit) { return false }
  for f in n.objFields {
    const fi = nodeAt(f)
    if !(fi is FieldInit) { return false }
    if "f." + fi.fiName == st {
      return mfrChainDescend(fi.fiValue, steps, i + 1, hops + 1, out)
    }
  }
  false
}

// Per declaration, the list, record and `Map()` literals it can hold, filled after the
// elaboration and before any emit rewrite: 0 unasked, 1 asking, 2 known (`mfrLitStart` into the
// -1-terminated `mfrLitNodes`), 3 unknown. A `Map()` root's binding is `mfrLitMapDecl`.
let mfrLitState: i32[] = []
let mfrLitStart: i32[] = []
let mfrLitNodes: i32[] = []
let mfrLitMapDecl: i32[] = []
// 1 at a binding whose roots hold a function its own walk reached other than through a map read.
let mfrLitDirectFn: i32[] = []
// The walk's nesting inside map reads, and whether it pushed a function outside one.
let mfrLitStoredDepth = 0
let mfrLitDirect = false

// Fills the literal roots of every binding, its links gated as the chain walk's are.
export function mfrLitsRun() {
  // Only where the mono pass can run, its sole reader: some function is generic or takes a
  // function-typed parameter (`monoIsGenericDecl`, `feHasClosureParam`).
  let want = false
  let w = 0
  while !want && w < P.nodes.length {
    const fn = nodeAt(w)
    if fn is FuncDecl {
      want = monoIsGenericDecl(w)
      for p in fn.fnParams {
        const pn = nodeAt(p)
        if pn is Param && pn.parType >= 0 && tyIsFuncType(pn.parType) {
          want = true
        }
      }
    }
    w = w + 1
  }
  if !want { return 0 }
  cwIxBuild()
  const len = P.nodes.length
  mfrLitState = __array_new__(len, 0)
  mfrLitStart = __array_new__(len, -1)
  mfrLitNodes = []
  mfrLitMapDecl = __array_new__(len, -1)
  mfrLitDirectFn = __array_new__(len, 0)
  let i = 0
  while i < len {
    const n = nodeAt(i)
    if n is LetDecl || n is Param || n is FuncDecl || n is LoopVar {
      mfrLitsDecl(i)
    }
    i = i + 1
  }
  0
}

// The literal roots expression `x` can evaluate to, onto `out`: -1 when unknown or `x` is a node
// minted after the elaboration, 1 when the walk reached a function other than through a map read,
// 0 otherwise.
export function mfrLitsExprOf(x: i32, out: i32[]): i32 {
  const was = mfrLitDirect
  const depth = mfrLitStoredDepth
  mfrLitDirect = false
  mfrLitStoredDepth = 0
  const ok = mfrLitsVal(x, out)
  const r = if !ok { -1 } else if mfrLitDirect { 1 } else { 0 }
  mfrLitDirect = was
  mfrLitStoredDepth = depth
  r
}

// The literal roots binding or function `d` can hold, onto `out`; false when they are unknown.
function mfrLitsAt(d: i32, out: i32[]): boolean {
  if d < 0 || d >= mfrLitState.length || mfrLitState[d] != 2 { return false }
  if mfrLitStoredDepth == 0 && mfrLitDirectFn[d] == 1 { mfrLitDirect = true }
  let k = mfrLitStart[d]
  while k >= 0 && k < mfrLitNodes.length && mfrLitNodes[k] >= 0 {
    out.push(mfrLitNodes[k])
    k = k + 1
  }
  true
}

// The literal roots of binding `d` (`mfrLitsAt`), or of a binding minted after the elaboration,
// which stands for its initialiser: `emit_rewrite`'s `spillLocal` (`asg#<ix>#<tag>`) and its
// capture-cell write temp (`__cbv<n>`) each bind an existing expression. Only a covered list or
// record literal, or a read of a covered binding, is forwarded; anything else is unknown.
export function mfrLitsOf(d: i32, out: i32[]): boolean {
  if mfrLitsAt(d, out) { return true }
  if d < cwIxCoveredLen() || d >= P.nodes.length { return false }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letType >= 0 { return false }
  const v = parenPeelIx(dn.letInit)
  if v < 0 || v >= cwIxCoveredLen() { return false }
  const vn = nodeAt(v)
  if vn is ArrayLit || vn is ObjLit {
    out.push(v)
    return true
  }
  vn is Ident && mfrLitsAt(identDeclOf(v), out)
}

// `mfrLitState` for `d`, computed once; a cycle back into a binding being asked is unknown.
function mfrLitsDecl(d: i32): boolean {
  if d < 0 || d >= mfrLitState.length { return false }
  const st = mfrLitState[d]
  if st != 0 { return st == 2 }
  mfrLitState[d] = 1
  const out: i32[] = []
  const was = mfrLitDirect
  const depth = mfrLitStoredDepth
  mfrLitDirect = false
  mfrLitStoredDepth = 0
  const ok = mfrLitsDeclVals(d, out)
  if mfrLitDirect && d < mfrLitDirectFn.length { mfrLitDirectFn[d] = 1 }
  mfrLitDirect = was
  mfrLitStoredDepth = depth
  if !ok || out.length == 0 {
    mfrLitState[d] = 3
    return false
  }
  mfrLitStart[d] = mfrLitNodes.length
  for x in out { mfrLitNodes.push(x) }
  mfrLitNodes.push(-1)
  mfrLitState[d] = 2
  true
}

// The values binding or function `d` holds: a function's returns, a parameter's argument at each
// call (none for an exported function's), a binding's every write; each resolved to its roots.
function mfrLitsDeclVals(d: i32, out: i32[]): boolean {
  const vals: i32[] = []
  const dn = nodeAt(d)
  match dn {
    FuncDecl => {
      if dn.fnTyParams.length > 0 { return false }
      collectRetValues(dn.fnBody, vals)
    }
    Param => {
      if dn.parType >= 0 || dn.parDefault >= 0 { return false }
      const pf = recEnclosingFn(d)
      const pfn = if pf >= 0 { nodeAt(pf) } else { null }
      if !(pfn is FuncDecl) || monoNameIsExported(pfn.fnName) { return false }
      if !cwParamArgs(d, vals) { return false }
      for w in cwBindingWrittenValues(cwKeyOfDecl(d)) { vals.push(w) }
    }
    LetDecl => {
      if dn.letType >= 0 { return false }
      // A `const` built by `Map()` is the map's own root; what it holds is read through its slots.
      const iv = parenPeelIx(dn.letInit)
      if (
        dn.letKw == "const"
        && mfrLitIsMapNew(iv)
        && iv < mfrLitMapDecl.length
      ) {
        mfrLitMapDecl[iv] = d
        out.push(iv)
        return true
      }
      for w in cwBindingWrittenValues(cwKeyOfDecl(d)) { vals.push(w) }
    }
    LoopVar => {
      if dn.lvSlot != 0 || !mfrLitsLoopElems(dn.lvLoop, vals) { return false }
    }
    // no other declaration holds a value
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread => {
      return false
    }
  }
  if vals.length == 0 { return false }
  for v in vals {
    if !mfrLitsVal(v, out) { return false }
  }
  true
}

// The values `for … in` loop `lp`'s element variable takes, onto `vals`: a list literal's
// elements, or every value a `let`-bound list's element slot is written (`cwSlotWrittenValues`);
// false for a spread element, a map, or an iterable the write index cannot answer.
function mfrLitsLoopElems(lp: i32, vals: i32[]): boolean {
  const ln = if lp >= 0 && lp < P.nodes.length { nodeAt(lp) } else { null }
  if !(ln is ForIn) { return false }
  const it = parenPeelIx(ln.fiIter)
  if it < 0 || it >= cwIxCoveredLen() { return false }
  const itn = nodeAt(it)
  if itn is ArrayLit {
    for e in itn.arrElems {
      if e < 0 || nodeAt(e) is Spread { return false }
      vals.push(e)
    }
    return itn.pos >= 0
  }
  if !(itn is Ident) { return false }
  const b = identDeclOf(it)
  const bn = if b >= 0 { nodeAt(b) } else { null }
  if !(bn is LetDecl) || mfrLitIsMapNew(parenPeelIx(bn.letInit)) {
    return false
  }
  const ats: i32[] = []
  cwSlotWrittenValues(cwKeyOfDecl(b), ["[]"], vals, ats) >= 0
}

// Whether `x` is a bare `Map()` call.
function mfrLitIsMapNew(x: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  const c = nodeAt(x)
  if !(c is Call) || c.callArgs.length != 0 || c.callFn < 0 { return false }
  const f = nodeAt(parenPeelIx(c.callFn))
  f is Ident && f.identName == "Map" && identDeclOf(parenPeelIx(c.callFn)) < 0
}

function mfrLitPush(out: i32[], x: i32) {
  const xn = nodeAt(x)
  if (
    mfrLitStoredDepth == 0
    && !(xn is ArrayLit
      || xn is ObjLit
      || x < mfrLitMapDecl.length && mfrLitMapDecl[x] >= 0)
  ) {
    mfrLitDirect = true
  }
  if !i32ListHas(out, x) { out.push(x) }
  0
}

// The roots value `v` holds, onto `out`: a list or record literal itself, a function's name as a
// leaf, a binding's or a called function's roots, both sides of `??`, an element, field or map
// read's; false where any part is unknown.
function mfrLitsVal(v0: i32, out: i32[]): boolean {
  const v = parenPeelIx(v0)
  if v < 0 || v >= cwIxCoveredLen() { return false }
  const n = nodeAt(v)
  match n {
    ArrayLit => {
      if n.pos < 0 { return false }
      mfrLitPush(out, v)
      return true
    }
    ObjLit => {
      mfrLitPush(out, v)
      return true
    }
    Ident => {
      const d = identDeclOf(v)
      const fd = if d < 0 { identFnDeclOf(v) } else { d }
      if fd >= 0 && fd < P.nodes.length && nodeAt(fd) is FuncDecl {
        mfrLitPush(out, v)
        return true
      }
      return mfrLitsDecl(d) && mfrLitsAt(d, out)
    }
    BinExpr => {
      // A user operator is a call of the function the checker resolved it to.
      const od = mfrLitCallDecl(v)
      if od >= 0 { return mfrLitsDecl(od) && mfrLitsAt(od, out) }
      if n.binOp != "??" { return false }
      // A `null` side holds no literal.
      const l = nodeAt(parenPeelIx(n.binLeft)) is NullLit
        || mfrLitsVal(n.binLeft, out)
      return l
        && (nodeAt(parenPeelIx(n.binRight)) is NullLit
        || mfrLitsVal(n.binRight, out))
    }
    Call => {
      return mfrLitsCall(v, n, out)
    }
    Index => {
      const base: i32[] = []
      if !mfrLitsVal(n.idxArr, base) || base.length == 0 { return false }
      // A map read at any key holds every value the map stores.
      if mfrLitAllMaps(base) { return mfrLitsStored(base, out) }
      const kn = nodeAt(n.idxIndex)
      if !(kn is NumLit) { return false }
      for b in base {
        const el = mfrLitElemOf(b, kn.numText)
        if el < 0 || !mfrLitsVal(el, out) { return false }
      }
      return true
    }
    Member => {
      const base: i32[] = []
      if !mfrLitsVal(n.memObj, base) { return false }
      for b in base {
        const fv = mfrLitFieldOf(b, n.memProp)
        if fv < 0 || !mfrLitsVal(fv, out) { return false }
      }
      return true
    }
    // no other node holds a literal the walk follows
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      return false
    }
  }
}

// A call's roots: a `self`-function's or a declared function's returns, a slice's receiver's,
// or a map `.get`'s stored values.
function mfrLitsCall(v: i32, n: Call, out: i32[]): boolean {
  const c = parenPeelIx(n.callFn)
  if c < 0 || c >= P.nodes.length { return false }
  const cm = nodeAt(c)
  if cm is Member {
    const mf = mfrLitCallDecl(v)
    if mf >= 0 { return mfrLitsDecl(mf) && mfrLitsAt(mf, out) }
    // A slice holds its receiver's elements.
    if cm.memProp == "slice" { return mfrLitsVal(cm.memObj, out) }
    if cm.memProp != "get" || n.callArgs.length != 1 { return false }
    return mfrLitsMapRead(cm.memObj, out)
  }
  const fd = identFnDeclOf(c)
  fd >= 0 && mfrLitsDecl(fd) && mfrLitsAt(fd, out)
}

// Element `k` of the spread-free list literal `b`; -1 otherwise.
function mfrLitElemOf(b: i32, k: string): i32 {
  const ln = nodeAt(b)
  if !(ln is ArrayLit) { return -1 }
  for e in ln.arrElems {
    if nodeAt(e) is Spread { return -1 }
  }
  let j = 0
  while j < ln.arrElems.length {
    if i32ToStr(j) == k { return ln.arrElems[j] }
    j = j + 1
  }
  -1
}

// Field `name` of the record literal `b`; -1 otherwise.
function mfrLitFieldOf(b: i32, name: string): i32 {
  const on = nodeAt(b)
  if !(on is ObjLit) { return -1 }
  for f in on.objFields {
    const fi = nodeAt(f)
    if !(fi is FieldInit) { return -1 }
    if fi.fiName == name { return fi.fiValue }
  }
  -1
}

// The values every `Map()` root of `m` stores, resolved to their roots.
function mfrLitsMapRead(m: i32, out: i32[]): boolean {
  const base: i32[] = []
  if !mfrLitsVal(m, base) || base.length == 0 { return false }
  mfrLitsStored(base, out)
}

// Whether every root in `base` is a `Map()`.
function mfrLitAllMaps(base: i32[]): boolean {
  for b in base {
    if b < 0 || b >= mfrLitMapDecl.length || mfrLitMapDecl[b] < 0 {
      return false
    }
  }
  true
}

// The values each `Map()` root in `base` stores, resolved to their roots.
function mfrLitsStored(base: i32[], out: i32[]): boolean {
  for b in base {
    const ow = if b >= 0 && b < mfrLitMapDecl.length { mfrLitMapDecl[b] } else { -1 }
    if ow < 0 { return false }
    const sv: i32[] = []
    const ats: i32[] = []
    if cwSlotWrittenValues(cwKeyOfDecl(ow), ["[]"], sv, ats) < 0 {
      return false
    }
    mfrLitStoredDepth = mfrLitStoredDepth + 1
    let ok = true
    for w in sv {
      if ok && !mfrLitsVal(w, out) { ok = false }
    }
    mfrLitStoredDepth = mfrLitStoredDepth - 1
    if !ok { return false }
  }
  true
}

// The roots of every value `Map()` root `m` stores (`mfrLitsStored`), onto `out`; false when one
// is unknown or `m` is no map root.
export function mfrLitsMapStored(m: i32, out: i32[]): boolean {
  const depth = mfrLitStoredDepth
  const ok = mfrLitsStored([m], out)
  mfrLitStoredDepth = depth
  ok
}

// Whether binding `d` may hold a function its walk reached other than through a map read; true
// for a binding minted after the elaboration.
export function mfrLitsDirectFn(d: i32): boolean {
  d < 0 || d >= mfrLitDirectFn.length || mfrLitDirectFn[d] == 1
}

// The function the checker resolved member or operator call `ix` to (`elabCallDeclOf`); -1 when
// it noted none or it is not a declared function.
function mfrLitCallDecl(ix: i32): i32 {
  let d = elabCallDeclOf(ix)
  if d < 0 { d = opDeclAtNode(ix) }
  if d < 0 { d = memberMethodOf(ix) }
  if d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl { d } else { -1 }
}
