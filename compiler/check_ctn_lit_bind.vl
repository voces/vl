// The literal-`const` binding rows: each un-annotated `const` bound to a list, object or map
// literal, with its initializer, depth-tagged like the checker's other binding marks.
// `markCtnLitBinding` writes a row, `ctnLitBindPopTo` drops the rows a scope retires,
// `ctnLitInitOf` answers which literal a name resolves to, and `ctnLitBindReset` clears them
// per program. Nothing here imports the checker.
import { bindMarkPopTo, bindMarkPush } from "./check_num_lit_state"
import { lookupDepth } from "./check_scopes"

// The readonly-only list rule follows such a name to the literal it names.
let ctnLitBindDepth: i32[] = []
let ctnLitBindName: string[] = []
let ctnLitBindInit: i32[] = []

export function ctnLitBindReset() {
  ctnLitBindDepth = []
  ctnLitBindName = []
  ctnLitBindInit = []
}

// Mark an un-annotated literal `const` (see `letDeclIsUnannotCtnLit`) with its initializer.
export function markCtnLitBinding(name: string, depth: i32, init: i32) {
  bindMarkPush(ctnLitBindDepth, ctnLitBindName, name, depth)
  ctnLitBindInit.push(init)
}

// Drop the rows the scope at `depth` retired.
export function ctnLitBindPopTo(depth: i32) {
  bindMarkPopTo(ctnLitBindDepth, ctnLitBindName, depth)
  while ctnLitBindInit.length > ctnLitBindName.length { ctnLitBindInit.pop() }
}

// The initializer of the literal `const` `name` resolves to, or -1 when it resolves to anything
// else. Paired by depth exactly as `bindMarkHas` is, so shadowing holds.
export function ctnLitInitOf(name: string): i32 {
  if ctnLitBindName.length == 0 { return -1 }
  const d = lookupDepth(name)
  if d < 0 { return -1 }
  let i = ctnLitBindName.length - 1
  while i >= 0 {
    if ctnLitBindName[i] == name && ctnLitBindDepth[i] == d {
      if i < ctnLitBindInit.length { return ctnLitBindInit[i] }
      return -1
    }
    i = i - 1
  }
  -1
}
