import { numLitUnionBaseTy } from "./check_types"

// `emit_union_registry.vl` — the union registry's member sets: which atoms and
// ref-array members a registered union carries, and the member-set interner.

import { tyPeelNul } from "./tyquery"
import { readNarrowedTyAt } from "./emit_capture_frames"
import { unMemPeelAliasWrapper, unRowOfTyKey } from "./emit_union_tykey_text"
import { canonUnionKeyTextOfTy } from "./check_inline_lit_union"
import { primTyIxOfName } from "./check_decl_scan"
import {
  canonUnionMemberTysOf,
  canonUnionMembersLitsInto,
} from "./check_program"
import { mapTwinUnionMember } from "./check_ty_rep"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  cUserTypes,
  tyAt,
  tyIsLitUnion,
  tyIsLitUnionOrLit,
  tySame,
} from "./check_types"
import { emitFail } from "./emit_bytes"
import { rlElemTyIxAt } from "./emit_struct_order"
import {
  armDeclSame,
  msFreeSlicePush,
  msMaskClear,
  msMaskFull,
  msMaskHas,
  msMaskIsEmpty,
  msSetHas,
  msSetMaskCopy,
  msSliceAtom,
  msSliceCount,
  msSliceKind,
  msSliceTy,
  repCanonId,
  repShadowBumpReason,
  repShadowOn,
  tyIsI32LeafElem,
  tyIsStrLeafElem,
  unMemRowStart,
} from "./emit_rep"
export { unRowOfCanonFolded } from "./emit_rep"
export { unMemPeelAliasWrapper } from "./emit_union_tykey_text"
import {
  msFreeByTy,
  msFreeChain,
  msGen,
  msRowChain,
  msSetGen,
  msSetNext,
  msSetRow,
  msSetText,
  msSetWordAt,
  msSetWords,
  rlElemName,
  uVarTyIx,
  unMemAtoms,
  unMemKinds,
  unMemTyCount,
  unMemTyStart,
  unMemTys,
  unMemberSet,
  unNames,
  unRowBySid,
  unTyIx,
  unTyKey,
  unVarCount,
  unVarStart,
} from "./emit_state"
import { sidArrGet, sidLookup } from "./symbols"
import {
  flattenVariantsInto,
  isNullTy,
  primNameOf,
  tyAdmitsNull,
} from "./tyquery"

// The non-null member `X` when type `t` is exactly `X | null`, -1 otherwise.
export function nulArmTyOf(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const at = tyAt(t)
  if at is TyNullable { return at.nInner }
  const tys: i32[] = []
  flattenVariantsInto(t, tys)
  if tys.length != 2 { return -1 }
  if isNullTy(tys[0]) && !isNullTy(tys[1]) { return tys[1] }
  if isNullTy(tys[1]) && !isNullTy(tys[0]) { return tys[0] }
  -1
}

// The atom code a list of element `e` takes on the i32 list's storage: 17 for `boolean`, 18
// for its `boolean | null` niche and for `null`, -1 for any other element.
export function boolTagElemKind(e: i32): i32 {
  if primNameOf(e) == "boolean" { return 17 }
  // `null[]` is that backing with every element the null sentinel (D4671).
  if primNameOf(e) == "null" { return 18 }
  if e < 0 || e >= T.tys.length { return -1 }
  const t = tyAt(e)
  if t is TyNullable {
    if primNameOf(t.nInner) == "boolean" { return 18 }
  }
  -1
}

// The `unNames` row a spelling names, or -1 — `unNameBound`'s row-valued sibling, so registry-
// by-id seams can compare row to row rather than boolean to boolean: "both said yes" and
// "both named the same row" are different findings. `unionRowOf` is a wider lookup (it also
// asks a member-set spelling's key); this one is the exact row `unNameBound` answers about.
export function unRowOfName(name: string): i32 {
  sidArrGet(unRowBySid, sidLookup(name))
}

// The member-set spelling of row `u`, or `name` unchanged where `u` is -1 or past the table: a
// spelling no row binds passes through, as `unionMemberSetOf` passes an unbound name (D16032).
export function unionMemberSetOfRow(u: i32, name: string): string {
  if u >= 0 && u < unMemberSet.length { return unMemberSet[u] }
  name
}

// Whether the spelling `name` is bound to a row, for a caller about to bind or rewrite it.
export function unNameBound(name: string) { unRowOfName(name) >= 0 }

// The full pipe-joined member set of the union named `name`: a registered alias returns its
// `unMemberSet` entry (`type N = A | B` expands to `"A|B"`); an unregistered or already
// pipe-joined name passes through unchanged. Lets complement narrowing subtract variants
// from an alias-annotated binding's set.
export function unionMemberSetOf(name: string) {
  const u = unRowOfName(name)
  if u >= 0 { return unMemberSet[u] }
  name
}

// The row whose recorded member columns answer for spelling `name`: the row `name` is bound
// to, or -1 when it is bound to none or that row has no recorded member slice.
export function unMemRowOfName(name: string): i32 {
  const u = unRowOfName(name)
  if u < 0 || u >= unMemTyStart.length { return -1 }
  const st = unMemTyStart[u]
  if st < 0 || st + unMemTyCount[u] > unMemAtoms.length { return -1 }
  u
}

// `unionArmsOf` for a caller holding the row `u` its name is bound to: appends the row's recorded
// atoms to `out` and answers true, or false with `out` untouched where `u` records no members.
export function unionArmsOfRow(u: i32, out: string[]): boolean {
  if u < 0 || u >= unMemTyStart.length { return false }
  const st = unMemTyStart[u]
  if st < 0 || st + unMemTyCount[u] > unMemAtoms.length { return false }
  unRowAtomsInto(u, out)
  true
}

// Appends the recorded member atoms of row `u` (one `unMemRowOfName` returned) to `out`, in
// box-tag order.
function unRowAtomsInto(u: i32, out: string[]) {
  const st = unMemTyStart[u]
  let i = 0
  while i < unMemTyCount[u] {
    out.push(unMemAtoms[st + i])
    i = i + 1
  }
  0
}

// Appends the member atoms of `name`'s bound row to `out`, in box-tag order. An alias name answers
// with its declared arms; a name no row binds is a compile failure.
export function unionMemberAtomsOf(name: string, out: string[]) {
  const u = unMemRowOfName(name)
  if u < 0 {
    emitFail(
      "emitProgram: a union's member atoms were asked of a name no row binds",
    )
    return 0
  }
  unRowAtomsInto(u, out)
}

// Whether the box of member set `s` carries a member as a string ref, counted over its member
// types: a literal-union or `string` member answers true, a lone member only as `string`, and a
// literal union beside `null` alone (the atom niche) false. False when `s` is uncovered.
export function msSetTakesAtomAsStr(s: i32): boolean {
  const tys: i32[] = []
  if !msMemberTysOfSet(s, tys) { return false }
  memberTysTakeAtomAsStr(tys)
}

// The count `msSetTakesAtomAsStr` and `tyDeclTakesAtomAsStr` share over member types, `-1` for
// `null`: a literal union is one member, never flattened into its literals.
function memberTysTakeAtomAsStr(tys: i32[]): boolean {
  let str = false
  let nul = false
  let lits = 0
  for m in tys {
    if m < 0 { nul = true }
    else if tyIsLitUnion(m) { lits = lits + 1 }
    else if primNameOf(m) == "string" { str = true }
  }
  if tys.length == 1 { return str }
  if tys.length == 2 && nul && lits == 1 { return false }
  str || lits > 0
}

// Whether a destination declared as type `ty` takes a literal-union atom as its member string,
// counted over the members `ty` itself declares: a literal-union alias stays one member, so a
// lone `K` or `K | null` answers false while `K | i32` and `string` answer true. False for `-1`.
export function tyDeclTakesAtomAsStr(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const tys: i32[] = []
  const t = tyAt(ty)
  if t is TyUnion {
    for m in t.uMembers { tys.push(declMemberOrNull(m)) }
  } else if t is TyNullable {
    const inner = t.nInner
    if inner >= 0 && inner < T.tys.length && !tyIsLitUnion(inner) {
      const it = tyAt(inner)
      if it is TyUnion {
        for m in it.uMembers { tys.push(declMemberOrNull(m)) }
      } else {
        tys.push(declMemberOrNull(inner))
      }
    } else {
      tys.push(declMemberOrNull(inner))
    }
    tys.push(-1)
  } else {
    tys.push(declMemberOrNull(ty))
  }
  memberTysTakeAtomAsStr(tys)
}

// Declared member `m`, with the `null` type folded to the `-1` the member count reads.
function declMemberOrNull(m: i32): i32 {
  if m < 0 || isNullTy(m) { return -1 }
  m
}

// Whether union type `ty`'s canonical members carry a literal-union atom as its string, so
// an alias arm counts at every depth: a literal-union or `string` member answers true, and a lone
// member or a literal union beside `null` alone (the atom niche) answers false.
export function tyTakesAtomAsStr(ty: i32): boolean {
  const tys: i32[] = []
  if !canonUnionMemberTysOf(ty, tys) { return false }
  let str = false
  let nul = false
  let lits = 0
  for m in tys {
    if m < 0 { nul = true }
    else if tyIsLitUnionOrLit(m) { lits = lits + 1 }
    else if primNameOf(m) == "string" { str = true }
  }
  if tys.length == 1 { return str }
  if tys.length == 2 && nul && lits == 1 { return false }
  str || lits > 0
}

// Whether the box of union type `ty` carries a literal-union atom as its member string: the
// row keyed by `ty` answers when one exists (a mixed literal union boxes as its widened row),
// else `ty`'s own members. False for `-1`.
export function tyBoxTakesAtomAsStr(ty: i32): boolean {
  const s = msSetOfTy(ty)
  if s >= 0 { return msSetTakesAtomAsStr(s) }
  tyTakesAtomAsStr(ty)
}

// The number of non-`null` members of row `r`, read from its recorded members, else of type `ty`'s
// own set (-1 where neither covers it).
export function unionRowNonNullCountTy(r: i32, ty: i32): i32 {
  if !unionArmsOfRow(r, []) { return unionSetNonNullCountTy(ty) }
  const u = r
  const st = unMemTyStart[u]
  let n = 0
  let i = 0
  while i < unMemTyCount[u] {
    if unMemAtoms[st + i] != "null" { n = n + 1 }
    i = i + 1
  }
  n
}

// The interned full member set of `name`, read off its bound row (an alias resolves to its
// declared set); -1 when `name` has no row or its row has no set.
export function msSetOfUnion(name: string): i32 {
  const u = unMemRowOfName(name)
  if u < 0 { return -1 }
  msSetOfRow(u)
}

// Resolves `name` to its member-set spelling (an alias name to its declared set, else itself)
// and appends its atoms to `out`: a bound row's recorded members, else the spelling split; a
// declared type name is its own one atom. Returns the member-set spelling.
export function unionArmsOf(name: string, out: string[]) {
  unionArmsOfSet(name, -1, out)
}

// `unionArmsOf` for a caller holding the arena type `ty` of `name`, or -1: the row keyed by
// `ty` answers, else the members of `ty`'s own set (`msSetOfTyAny`).
export function unionArmsOfTy(name: string, ty: i32, out: string[]) {
  unionArmsOfSetTy(name, msSetOfTy(ty), ty, out)
}

// `unionArmsOf` for a caller holding the member set `s` that `name` renders, or -1: the set's
// members answer before the spelling is split.
export function unionArmsOfSet(name: string, s: i32, out: string[]) {
  unionArmsOfSetTy(name, s, -1, out)
}

// `unionArmsOfSet` that also holds `ty`, the arena type `name` renders, or -1. A type only
// answers a name that is its own member set, since an alias resolves to its declared one.
function unionArmsOfSetTy(name: string, s: i32, ty: i32, out: string[]) {
  let nm = unionMemberSetOf(name)
  if nm == "" { nm = name }
  const u = unMemRowOfName(name)
  if u >= 0 {
    unRowAtomsInto(u, out)
    return nm
  }
  if (cUserTypes[nm] ?? -1) >= 0 {
    out.push(nm)
    return nm
  }
  if msMemberAtomsOfSet(s, out) { return nm }
  if nm != name {
    emitFail(
      "emitProgram: an alias's member atoms were asked of its declared spelling",
    )
    return nm
  }
  // A spelling no row binds answers from the type it renders: its own member set.
  if ty < 0 || !msMemberAtomsOfSet(msSetOfTyAny(ty), out) {
    emitFail(
      "emitProgram: a union's member atoms were asked of a type with no member set",
    )
  }
  nm
}

// The `unNames` ROW the union spelling `name` is bound to, or -1. A member-set spelling no row is
// bound to finds none here; a caller holding the union's type asks the row it keys to.
export function unionRowOf(name: string): i32 {
  if name == "" { return -1 }
  unRowOfName(name)
}

// ── the union registry asked by arena type id — an A/B shadow harness (docs/internals/registry-by-type-id.md)

// Off by default: `unABOn()` is 0 unless the host arms the shadow harness, and every AB
// function then returns exactly what its unshadowed twin does, so an unarmed compile is
// unaffected. Mode 2 prefers the id answer; mode 3 re-keys the tally on `unKey` instead of
// `repCanonId`, both armed from source only, since a compiler reading its own environment is a second input.
export const unABMode: i32 = 0

export function unABOn(): i32 {
  if unABMode > 0 { return unABMode }
  if repShadowOn { return 1 }
  0
}

// The converted sites, by name — an i32 constant at each call site, so an unarmed compile
// just pushes it and returns; the spelling is needed only by the report. Ids 1-10 are the
// sites the initial shim added (including id-free callers that already hold an arena id);
// 11+ came from later one-hop threading. `UNAB_N` bounds the report loop.
const UNAB_N = 107

// The id-keyed twin of `unionRowOf(name)`. `unRowOfCanonFolded` is the reverse index this repo
// already built (`repCanonId` over the `unTyIx` sidecar B-1 step 1 populated); this name is
// its registry-facing spelling, so a converted call site reads as the twin of the call it
// replaces rather than as a new idea.
function unionRowOfTy(ty: i32): i32 { unRowOfCanonFolded(ty) }

// The seams that answer from the union KEY, step 5's switch: every one but 55, whose type keeps
// the literals, aliases and nesting its name's render drops. Where the key finds no row,
// `unSiteWideHit` and the mint guard say what still answers.
// `docs/internals/registry-by-type-id.md` §5.
export function unSiteOnKey(site: i32): boolean {
  site >= 1 && site < UNAB_N && site != 55
}

// The sites whose typed lookup reads the canonical type key (`unTyKey`): all but 55, which keys
// on `repCanonId`. Where the key parts from the softened one, it is a literal set's own row, not
// the first set's that softens alike.
function unSiteOnTyKey(site: i32): boolean {
  site >= 1 && site < UNAB_N && site != 55
}

// The ID side's row for `site`: the canonical type key's (`unSiteOnTyKey`), else the softened
// key's (`unKey`) for harness mode 3, else `repCanonId`'s. Only the A/B seams route through here.
export function unRowOfTyAB(site: i32, ty: i32): i32 {
  if unSiteOnTyKey(site) { return unRowOfTyKey(ty) }
  unionRowOfTy(ty)
}

// False only where `isUNameAB` answers false for type `ty`: `ty` neither a union nor a nullable,
// the one shape any of its typed legs keys a row from.
export function isUNameABTyMayHit(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return true }
  const t = tyAt(ty)
  t is TyUnion || t is TyNullable
}

// The registry-membership seam: whether a row carries type `ty`'s key, or one a row-existence
// site finds wide (`unSiteWideHit`); false with no type.
export function isUNameAB(site: i32, ty: i32): boolean {
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(site, ty) }
  if ty < 0 { return false }
  d >= 0 || unSiteWideHit(site, ty)
}

// Whether union row `r` is the only row of its member multiset (`unTyKey`): every spelling of
// that set, in any order or declaration, finds it, so a reader may take it by type.
export function unRowSoleOfMembers(r: i32): boolean {
  if r < 0 || r >= unTyKey.length || unTyKey[r] < 0 { return false }
  let n = 0
  for k in unTyKey {
    if k == unTyKey[r] { n = n + 1 }
  }
  n == 1
}

// The union a union-box ref-list row's element is: the registry row the row's type finds where
// that row is the only one of its member set, else the row's stored name.
export function rlElemUnionName(slot: i32): string {
  if slot < 0 || slot >= rlElemName.length { return "" }
  const r = rlElemUnionRow(slot)
  if r >= 0 { return unNames[r] }
  rlElemName[slot]
}

// The row ref-list slot `slot`'s element union is named by: the one its type keys to, when that
// row holds the element's members alone; -1 where the slot's own element name answers.
export function rlElemUnionRow(slot: i32): i32 {
  if slot < 0 || slot >= rlElemName.length { return -1 }
  const r = unRowOfTyKey(rlElemTyIxAt(slot))
  if r >= 0 && r < unNames.length && unRowSoleOfMembers(r) { return r }
  -1
}

// One union member against another in the same position: the same type, or two records or
// maps of one structure (or lists of such), which the key renders apart when only one
// carries its declared name.
function unMemberSameShape(a: i32, b: i32): boolean {
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  const ta = tyAt(a)
  const tb = tyAt(b)
  if ta is TyPrim {
    if tb is TyPrim { return ta.primName == tb.primName }
    return false
  }
  if ta is TyArray {
    if tb is TyArray { return unMemberSameShape(ta.aElem, tb.aElem) }
    return false
  }
  if !(ta is TyObj || ta is TyMap) || !(tb is TyObj || tb is TyMap) {
    return false
  }
  repCanonId(a) == repCanonId(b)
}

// Two union types with the same member sequence under `unMemberSameShape`, order kept, since
// a union's box tags are positional over its members.
function unTySeqSameShape(a: i32, b: i32): boolean {
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  const ta = tyAt(a)
  const tb = tyAt(b)
  match ta {
    TyNullable => tb is TyNullable && unTySeqSameShape(ta.nInner, tb.nInner)
    TyUnion => tb is TyUnion && unMemberSeqSameShape(ta.uMembers, tb.uMembers)
    TyLit => false
    TyArray => false
    TyMap => false
    TyObj => false
    TyPrim => false
    TyErr => false
    TyFunc => false
    TyVar => false
    TyNeg => false
  }
}

function unMemberSeqSameShape(ma: i32[], mb: i32[]): boolean {
  if ma.length != mb.length { return false }
  let i = 0
  while i < ma.length {
    if !unMemberSameShape(ma[i], mb[i]) { return false }
    i = i + 1
  }
  true
}

// A row for a union type the key missed: a row whose recorded type has the same member sequence
// up to record names. For the existence question only.
function unRowOfTyWide(ty: i32): i32 {
  if canonUnionKeyTextOfTy(ty) == "" { return -1 }
  let u = 0
  while u < unTyIx.length {
    if unTySeqSameShape(unTyIx[u], ty) { return u }
    u = u + 1
  }
  -1
}

// A row-existence seam's answer where the key finds no row: a row by `unRowOfTyWide`.
function unSiteWideHit(site: i32, ty: i32): boolean {
  if !unSiteWideAsks(site) { return false }
  unRowOfTyWide(ty) >= 0
}

// Whether the site asks about a row for the type rather than about the spelling.
function unSiteWideAsks(site: i32): boolean {
  match site {
    2 | 5 | 6 | 7 | 15 | 16 | 17 | 18 | 20 | 26 | 27 | 28 => true
    _ => false
  }
}

// The row-NAME seam: the name of the row type `ty`'s key finds, else "", and "" with no type.
export function unionRowNameAB(site: i32, ty: i32): string {
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(site, ty) }
  if d >= 0 && d < unNames.length { return unNames[d] }
  ""
}

// The registry-membership seam: whether a row carries type `ty`'s key; false with no type.
export function isUNameKeyAB(site: i32, ty: i32): boolean {
  ty >= 0 && unRowOfTyAB(site, ty) >= 0
}

// Registry membership for a declared type's name: whether a row carries the key of its declared
// arena type. Every caller asks it of a declared name.
export function isUNameDeclAB(site: i32, name: string): boolean {
  const ty = cUserTypes[name] ?? -1
  if ty < 0 {
    emitFail(
      "emitProgram: a union registry membership test names no declared type",
    )
    return false
  }
  unRowOfTyAB(site, ty) >= 0
}

// The row union type `ty`'s key finds under `site`, or -1.
export function unionRowKeyAB(site: i32, ty: i32): i32 {
  if ty < 0 { return -1 }
  unRowOfTyAB(site, ty)
}

// The member-type seam: the members of the row type `ty` keys to under `site`. False when it
// finds no covered row, leaving `out` untouched.
export function unionMemberTysOfAB(site: i32, ty: i32, out: i32[]): boolean {
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(site, ty) }
  unionMemberTysOfRow(d, out)
}

// Whether union row `u` has a member that is exactly the keyword primitive `want` (or a list of it
// when `arr`): 1, 0, or -1 for an uncovered row.
// Every parallel-table read here is bounded: a row named by a key the table never grew
// is exactly the shape that trapped before. D1152.
function unMemHasAtomRow(u: i32, want: string, arr: boolean): i32 {
  if u < 0 { return -1 }
  if u >= unMemTyStart.length { return -1 }
  if u >= unMemTyCount.length { return -1 }
  const st = unMemTyStart[u]
  const n = unMemTyCount[u]
  if st < 0 { return -1 }
  if st + n > unMemTys.length { return -1 }
  let i = 0
  while i < n {
    let m = unMemTys[st + i]
    if m < 0 { return -1 }
    if m >= T.tys.length { return -1 }
    if arr {
      const ta = tyAt(m)
      m = -1
      if ta is TyArray { m = ta.aElem }
      if m >= T.tys.length { return -1 }
      // A numeric literal-union element is stored as its base (`Z[]` with `Z = 0 | 1` is `i32[]`).
      const mb = if m >= 0 { numLitUnionBaseTy(m) } else { -1 }
      if mb >= 0 { m = mb }
    }
    if m >= 0 {
      const t = tyAt(m)
      if t is TyPrim {
        if t.primName == want { return 1 }
      }
    }
    i = i + 1
  }
  0
}

// The arena member types of the union `name`, appended to `out` in the row's recorded order
// (the box-tag ABI order). True when the row is covered and every member resolved; false
// leaves `out` untouched and the caller keeps its legacy member-name path. Consumers then
// classify each member structurally instead of re-deriving shape from its rendered spelling.
export function unionMemberTysOf(name: string, out: i32[]): boolean {
  unionMemberTysOfRow(unionRowOf(name), out)
}

// The same walk from a ROW — the one place the member columns are read, so a
// spelling-keyed and an arena-keyed entry point cannot drift into two readings of them.
export function unionMemberTysOfRow(u: i32, out: i32[]): boolean {
  if u < 0 { return false }
  if u >= unMemTyStart.length { return false }
  const st = unMemTyStart[u]
  if st < 0 { return false }
  const n = unMemTyCount[u]
  let i = 0
  while i < n {
    if unMemTys[st + i] < 0 { return false }
    i = i + 1
  }
  let j = 0
  while j < n {
    out.push(unMemTys[st + j])
    j = j + 1
  }
  true
}

// Whether union type `ty` has a member of the primitive `want` (its list `want[]` with `arr`),
// read off the row `ty` keys. A union no covered row answers fails loudly.
export function unionHasAtomOfTy(ty: i32, want: string, arr: boolean): boolean {
  const a = unMemHasAtomRow(unRowOfTyKey(ty), want, arr)
  if a >= 0 { return a == 1 }
  emitFail(
    "emitProgram: union box atom test on a union with no recorded members",
  )
  false
}

// ── the union member set as a structure ────────────────────────────────────────

// A member set is a subset of one union row's recorded members: the pair (row, mask), where
// bit `i` of the mask is member `i` in the row's recorded (box-tag ABI) order — never
// re-derived, only masked. Membership is a kind test or interned-id compare, not a substring
// search; a set renders (`msTextOf`) only when handed to a name-keyed consumer.

// The member slice of union row `u`, or -1 when the row is not covered by the reference
// columns (a row the recorder missed, or an empty row). `unMemTyStart`/`unMemTyCount` slice
// all four member columns alike. The bound lives once, in `emit_rep` beside the recorder
// that writes the columns (#1110) — this is its local spelling.
function msRowStart(u: i32): i32 { unMemRowStart(u) }

// The rendered form of the subset `mask` of row `u`: the surviving members'
// verbatim spellings, joined on `|`, in the row's recorded order.
function msRenderSet(u: i32, mask: i32[]): string {
  const n = msSliceCount(u)
  if n < 0 { return "" }
  let out = ""
  let i = 0
  while i < n {
    if msMaskHas(mask, i) {
      if out != "" { out = out + "|" }
      out = out + msSliceAtom(u, i)
    }
    i = i + 1
  }
  out
}

// Does set `s` hold exactly the mask `mask`?
function msSetMaskIs(s: i32, mask: i32[]): boolean {
  const at = msSetWordAt[s]
  let k = 0
  while k < mask.length {
    if at + k >= msSetWords.length { return false }
    if msSetWords[at + k] != mask[k] { return false }
    k = k + 1
  }
  true
}

// The first set interned over slice `u` (-1 none), the head of its `msSetNext` chain.
function msChainHead(u: i32): i32 {
  if u >= 0 { return msRowChain[u] }
  msFreeChain[-2 - u]
}

// The interned set id for the subset `mask` of row `u` — one id per distinct
// (row, mask), so a set's rendering is built once and every later operation on it is
// a table read. `mask` is `msMaskWords` words of the row. Stamped with the pool generation (method note 7).
function msSetIntern(u: i32, mask: i32[]): i32 {
  while u >= 0 && msRowChain.length <= u { msRowChain.push(-1) }
  let s = msChainHead(u)
  while s >= 0 {
    if msSetGen[s] == msGen.at && msSetMaskIs(s, mask) { return s }
    s = msSetNext[s]
  }
  const id = msSetRow.length
  const txt = msRenderSet(u, mask)
  msSetRow.push(u)
  msSetWordAt.push(msSetWords.length)
  let k = 0
  while k < mask.length {
    msSetWords.push(mask[k])
    k = k + 1
  }
  msSetGen.push(msGen.at)
  msSetNext.push(msChainHead(u))
  msSetText.push(txt)
  if u >= 0 { msRowChain[u] = id } else { msFreeChain[-2 - u] = id }
  id
}

// The set id of union row `u`'s FULL member set, or -1 when the row is uncovered.
export function msSetOfRow(u: i32): i32 {
  if u < 0 || u >= unMemTyCount.length { return -1 }
  const st = msRowStart(u)
  if st < 0 { return -1 }
  msSetIntern(u, msMaskFull(unMemTyCount[u]))
}

// The full member set of the union row keyed as arena type `ty`, or -1 when no row carries
// its key: the set a caller holding the type reads without naming it.
export function msSetOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  const u = unRowOfTyKey(ty)
  if u < 0 { return -1 }
  msSetOfRow(u)
}

// The full member set of type `ty` whether or not a row carries its key: the row's set when one
// does, else a set over the type's own members in the canon render's order (`msFreeSliceOfTy`),
// one member for a type that is no union. A row-less set answers every member question but has
// no box tags. -1 when a member has no render.
export function msSetOfTyAny(ty: i32): i32 {
  const s = msSetOfTy(ty)
  if s >= 0 || ty < 0 { return s }
  const u = msFreeSliceOfTy(ty)
  if u > -2 { return -1 }
  msSetIntern(u, msMaskFull(msSliceCount(u)))
}

// The row-less member slice of type `ty`, built once per type: its members as
// `canonUnionMembersLitsInto` spells them, never reordered or deduplicated past that. -1 when a
// member has no render.
function msFreeSliceOfTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  while msFreeByTy.length <= ty { msFreeByTy.push(-1) }
  const got = msFreeByTy[ty]
  if got >= 0 { return -2 - got }
  if got == -2 { return -1 }
  const tys: i32[] = []
  const atoms: string[] = []
  const lits: boolean[] = []
  if !canonUnionMembersLitsInto(ty, tys, atoms, lits) || atoms.length < 1 {
    msFreeByTy[ty] = -2
    return -1
  }
  const u = msFreeSlicePush(tys, atoms, lits)
  msFreeByTy[ty] = -2 - u
  u
}

// The rendered member set of `s` (see `msRenderSet`).
export function msTextOf(s: i32): string {
  if s < 0 || s >= msSetText.length { return "" }
  msSetText[s]
}

// Appends set `s`'s member spellings to `out`, in the row's recorded (box-tag ABI) order,
// without splitting anything. False = uncovered (`s` is -1 or names no covered row), `out`
// untouched, and the caller splits the spelling instead.
export function msMemberAtomsOfSet(s: i32, out: string[]): boolean {
  if s < 0 { return false }
  if s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return false }
  let i = 0
  while i < n {
    if msSetHas(s, i) { out.push(msSliceAtom(u, i)) }
    i = i + 1
  }
  true
}

// `msMemberAtomsOfSet`'s twin over the member types, index-parallel to the atoms it appends.
export function msMemberTysOfSet(s: i32, out: i32[]): boolean {
  if s < 0 { return false }
  if s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return false }
  let i = 0
  while i < n {
    if msSetHas(s, i) { out.push(msSliceTy(u, i)) }
    i = i + 1
  }
  true
}

// The number of members of set `s`, `null` included; 0 when `s` is uncovered.
export function msMemberCount(s: i32): i32 {
  const tys: i32[] = []
  msMemberTysOfSet(s, tys)
  tys.length
}

// MEMBERSHIP of the `null` keyword — a member-KIND test over the set's members, with
// no string compare at all.
export function msHasNull(s: i32): boolean {
  if s < 0 || s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return false }
  let i = 0
  while i < n {
    if msSetHas(s, i) {
      if msSliceKind(u, i) == 0 { return true }
    }
    i = i + 1
  }
  false
}

// CARDINALITY of the non-`null` members — a bit count over the kind column.
function msNonNullCount(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return 0 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return 0 }
  let c = 0
  let i = 0
  while i < n {
    if msSetHas(s, i) {
      if msSliceKind(u, i) != 0 { c = c + 1 }
    }
    i = i + 1
  }
  c
}

// The arena type of the set's sole member, or -1 when the set is empty, uncovered, or has
// two or more members. The bridge from the set ADT to the per-type classifiers: a complement
// narrowing subtracted down to one member (`i32 | null` minus `null`) binds that member's
// type, so "what is this binding now" asks the type, not the rendered survivor.
export function msSoleMemberTy(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return -1 }
  let found = -1
  let i = 0
  while i < n {
    if msSetHas(s, i) {
      if found >= 0 { return -1 }
      found = i
    }
    i = i + 1
  }
  if found < 0 { return -1 }
  msSliceTy(u, found)
}

// SUBTRACTION of the `null` keyword: clear every member whose KIND is the null token.
export function msSubNull(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return -1 }
  const mask = msSetMaskCopy(s)
  let i = 0
  while i < n {
    if msMaskHas(mask, i) {
      if msSliceKind(u, i) == 0 { msMaskClear(mask, i) }
    }
    i = i + 1
  }
  msSetIntern(u, mask)
}

// SELECTION of one member by arena TYPE: clear every member the type is not. The write
// half of the reads-only rule needs a member the CHECKER named, and it names it by arena
// index.
export function msKeepTy(s: i32, ty: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  if ty < 0 { return -1 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return -1 }
  const mask = msSetMaskCopy(s)
  let i = 0
  while i < n {
    if msMaskHas(mask, i) {
      if !msTyCovers(ty, msSliceTy(u, i)) { msMaskClear(mask, i) }
    }
    i = i + 1
  }
  if msMaskIsEmpty(mask) { return -1 }
  msSetIntern(u, mask)
}

// Does `ty` cover member type `m`? A single type covers itself; a UNION covers each of its own
// members, which is the shape an arm join hands back (`i32 | string` out of a three-arm
// declaration). The set keeps the declared row and narrows only its mask, so box tags stay
// positional whatever the join's own arena row looks like (D1846).
function msTyCovers(ty: i32, m: i32): boolean {
  if tySame(ty, m) { return true }
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if tySame(t.uMembers[i], m) { return true }
      i = i + 1
    }
  }
  false
}

// ── the set ADT's consumers ──

// The per-arm plan for `print(<value-union box>)`: the box-tag ABI-ordered value-atom kind of
// every arm, appended to `out`, true only when every arm is a value `print` renders on its
// own. Kinds 0..5 are `print`'s declared scalar/string domain (plus 6 for `null`); kinds
// 7..13 (lists, closures) are containers with no defined print rendering and decline. D711.
export function printNarrowKeepsBox(exprIx: i32, fnIx: i32): boolean {
  const nt = readNarrowedTyAt(exprIx, fnIx)
  if nt < 0 { return true }
  const tys: i32[] = []
  flattenVariantsInto(nt, tys)
  tys.length > 1
}

// The member types a narrowing to two or more of them leaves a print argument's box holding,
// into `live` (`null` as -1); false, leaving it empty, when it is not so narrowed. A box with a
// record arm the narrowing excluded prints from these alone (D3231).
export function printNarrowLiveTys(
  exprIx: i32,
  fnIx: i32,
  live: i32[],
): boolean {
  const nt = readNarrowedTyAt(exprIx, fnIx)
  if nt < 0 { return false }
  const s = msSetOfTyAny(nt)
  if msMemberCount(s) < 2 { return false }
  msMemberTysOfSet(s, live)
}

// Set while a read the narrowing pins to `null` is planned with that narrowing lifted: the plan
// then skips a record arm rather than decline the box, since the narrowing ruled it out (D3231).
export let printPlanNullPinned = false

// Sets whether the print plan reads a `null`-pinned box; the previous setting, to restore.
export function printPlanPinNull(on: boolean): boolean {
  const was = printPlanNullPinned
  printPlanNullPinned = on
  was
}

// Lifts the pin at compile start, so a compile that stopped inside a pinned plan leaves none.
export function printPlanReset() {
  printPlanNullPinned = false
  0
}

// MEMBERSHIP of `null` in member set `set` whose arena type is `ty` (or -1), structurally; a
// declared type name is one non-null atom, and a primitive keyword is `null` only when it is.
export function unionSetHasNullTy(set: string, ty: i32): boolean {
  if primTyIxOfName(set) >= 0 { return set == "null" }
  const s = msSetOfTy(ty)
  if s >= 0 { return msHasNull(s) }
  if (cUserTypes[set] ?? -1) >= 0 { return false }
  tyAdmitsNull(ty)
}

// CARDINALITY of the non-`null` members of type `ty`'s member set (row or not). A type with no
// member set is a compile failure.
export function unionSetNonNullCountTy(ty: i32): i32 {
  const s = msSetOfTyAny(ty)
  if s >= 0 { return msNonNullCount(s) }
  emitFail(
    "emitProgram: a union's non-null members are counted over a type with no member set",
  )
  0
}

// ── the arena duals of the union structural member classifiers ─────────────────

// Each answers the same question `nameIs*` asked of a rendered atom spelling, from the
// member's arena type instead — `nameIsMap` / `nameIsClosureArray` / `valueAtomKind(.) ==
// 11` / an array of maps.

// Whether row `u` records a map member (`unMemIsMap`); false for no row.
export function unRowHasMapArm(u: i32): boolean {
  const mems: i32[] = []
  if !unionMemberTysOfRow(u, mems) { return false }
  for m in mems {
    if unMemIsMap(m) { return true }
  }
  false
}

// A MAP member (`{[string]: V}`). A union whose first atom is a map renders as a
// `{[`-prefixed name but is a `TyUnion`, never a `TyMap`, so it is not a map member.
export function unMemIsMap(m: i32): boolean {
  unMemPeelAliasWrapper(m) >= 0 && tyIsMapRow(unMemPeelAliasWrapper(m))
}

// Whether `ty` is a map, through an alias wrapper or as a union of twin maps (D15540). A
// nullable map is not, and neither is a union with a map member.
export function tyIsBareMap(ty: i32): boolean {
  if unMemIsMap(ty) { return true }
  unMemIsMap(mapTwinUnionMember(ty))
}

// Whether `ty` is a nullable bare map (`{[K]: V} | null`), twins included.
export function tyIsNulMap(ty: i32): boolean {
  const inner = tyPeelNul(ty)
  inner != ty && tyIsBareMap(inner)
}

function tyIsMapRow(m: i32): boolean {
  if m < 0 { return false }
  const t = tyAt(m)
  if t is TyMap { return true }
  false
}

// An ARRAY-OF-MAP member (`{[string]: V}[]`). A map-member union element is a `TyUnion`,
// not a `TyMap`, so its list is not an array-of-map member.
export function unMemIsMapArray(m: i32): boolean {
  if m < 0 { return false }
  const t = tyAt(m)
  if t is TyArray {
    if t.aElem < 0 { return false }
    const e = tyAt(t.aElem)
    if e is TyMap { return true }
  }
  false
}

// A ref-element array member — the structural dual of `markRefArrayArms`'s gate over a
// member's rendered spelling: a `TyArray` whose element does not ride a scalar-leaf list
// backing. A row for the element is a separate question — see the refutation at
// `unionHasRefArrayArmSlot`.
export function unMemIsRefElemArray(m: i32): boolean {
  if m < 0 { return false }
  const t = tyAt(m)
  if t is TyArray {
    const e = t.aElem
    if e < 0 { return false }
    if tyIsI32LeafElem(e) { return false }
    if tyIsStrLeafElem(e) { return false }
    const et = tyAt(e)
    if et is TyPrim {
      // Exhaustive over `PrimName` and `_`-less: the four scalar-list leaves are not
      // ref-element arrays; `true` (below) is the real answer for the rest.
      match et.primName {
        "f64" => {
          return false
        }
        "i64" => {
          return false
        }
        "f32" => {
          // A packed byte list is not a ref-element array either — without the `u8` arm below,
          // `u8[]` fell through to `true` and took a reflist wrapper over its `$bl8` rep (#1805).
          return false
        }
        "u8" => {
          return false
        }
        "v128" => {
          // A v128 element is a scalar, not a ref element (no v128[] in S1-S2).
          return false
        }
        "null" => {
          // `null[]` rides the `(boolean | null)[]` i32 list (D4671), no ref element.
          return false
        }
        "i32" | "boolean" | "string" | "void" | "never" => {
          // A ref-element leaf; the `true` below stands.
        }
      }
    }
    return true
  }
  false
}

// The union registry's key licence, once per program under the rep shadow: every pair of rows the
// type key would fuse is compared (`unKeySweepPair`). A no-op unless the shadow is armed.
export function unionKeySweep() {
  if !repShadowOn { return 0 }
  let u = 0
  while u < unNames.length {
    let v = u + 1
    while v < unNames.length {
      unKeySweepPair(u, v)
      v = v + 1
    }
    u = u + 1
  }
  0
}

// Whether row `u` records a member slice in bounds of the member columns.
function unRowHasSlice(u: i32): boolean {
  if u < 0 || u >= unMemTyStart.length || u >= unMemTyCount.length {
    return false
  }
  const st = unMemTyStart[u]
  const end = st + unMemTyCount[u]
  st >= 0 && end <= unMemAtoms.length && end <= unMemKinds.length
}

// Whether rows `u` and `v` record the same members in the same order once their `null` members
// are set aside, with as many members each. `null`'s box tag is global, so where it sits is no
// part of the layout; every other member's position is, and none is deduped. A row with no
// recorded slice compares by its member-set spelling.
function unRowSetSameNullBlind(u: i32, v: i32): boolean {
  if u < 0 || v < 0 || u >= unMemberSet.length || v >= unMemberSet.length {
    return true
  }
  if unMemberSet[u] == unMemberSet[v] { return true }
  if !unRowHasSlice(u) || !unRowHasSlice(v) { return false }
  const n = unMemTyCount[u]
  if n != unMemTyCount[v] { return false }
  const su = unMemTyStart[u]
  const sv = unMemTyStart[v]
  let i = 0
  let j = 0
  while i < n || j < n {
    while i < n && unMemKinds[su + i] == 0 { i = i + 1 }
    while j < n && unMemKinds[sv + j] == 0 { j = j + 1 }
    if i < n && j < n {
      if unMemAtoms[su + i] != unMemAtoms[sv + j] { return false }
      i = i + 1
      j = j + 1
    } else if i < n || j < n {
      return false
    }
  }
  true
}

// Whether two variant slots hold one type under one declaration: twin records (`Cat`, `Kot`)
// are one shape but two declarations, kept apart as `unionArmsAllSame` keeps them.
function variantSlotSame(a: i32, b: i32): boolean {
  if a == b { return true }
  tySame(a, b) && armDeclSame(a, b)
}

// The second half of the key's licence (D1492): a struct union's tags are positional over its
// variant slice, so two rows with one set must also agree slot by slot. A slot compares by its
// type, never its spelling, which only labels the position (D14552).
function unRowVariantsSame(a: i32, b: i32): boolean {
  if a >= unVarStart.length || b >= unVarStart.length { return false }
  if a >= unVarCount.length || b >= unVarCount.length { return false }
  const na = unVarCount[a]
  if na != unVarCount[b] { return false }
  const sa = unVarStart[a]
  const sb = unVarStart[b]
  if sa < 0 || sb < 0 { return false }
  if sa + na > uVarTyIx.length || sb + na > uVarTyIx.length { return false }
  let i = 0
  while i < na {
    const ta = uVarTyIx[sa + i]
    const tb = uVarTyIx[sb + i]
    if ta < 0 || tb < 0 || !variantSlotSame(ta, tb) { return false }
    i = i + 1
  }
  true
}

// The ABI assertion the type key owes: two rows it would fuse (`unTyKey`), and how many of those
// record a different member set. A union's box tags are positional over its own member set, so a merge
// across different sets reads a value tagged under one slice through the other's — the
// hazard that disqualified `repCanonId`. `merge-diffset` must be 0 for the key to be usable.
function unKeySweepPair(u: i32, v: i32) {
  let k = -1
  let kv = -1
  if u < unTyKey.length { k = unTyKey[u] }
  if v < unTyKey.length { kv = unTyKey[v] }
  if k < 0 || kv < 0 { return 0 }
  repShadowBumpReason("keySweep/pair-keyed")
  if k != kv { return 0 }
  repShadowBumpReason("keySweep/merge")
  if unNames[u] != unNames[v] { repShadowBumpReason("keySweep/merge-diffname") }
  if !unRowSetSameNullBlind(u, v) {
    repShadowBumpReason("keySweep/merge-diffset")
  }
  if !unRowVariantsSame(u, v) { repShadowBumpReason("keySweep/merge-diffvar") }
  0
}
