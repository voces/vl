// `emit_union_registry.vl` — the union registry's member sets: which atoms and
// ref-array members a registered union carries, and the member-set interner.

import { readNarrowedTyAt } from "./emit_capture_frames"
import {
  canonUnionKeyNullAtOfTy,
  canonUnionKeyOfAnnName,
  canonUnionKeyOfName,
  canonUnionKeyOfText,
  canonUnionKeyOfTy,
  canonUnionKeyTextOfName,
  declaredStructUnionMembers,
} from "./check_nj_join"
import { primTyIxOfName } from "./check_decl_scan"
import { nominalNameOfObj } from "./check_fit_rules"
import { canonUnionMemberTysOf, canonUnionMembersInto } from "./check_program"
import { canonUnionKeyAtomOfTy } from "./check_ty_rep"
import {
  RC_NULLABLE,
  RC_ROOT,
  RC_UNION_MEM,
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  cUserTypes,
  ctxKeepsLitUnion,
  litUnionAliasNameOfTy,
  litUnionAliasOfLitTexts,
  litUnionInlineNameOfTy,
  mixedLitRunAliasOf,
  oneStrLitSpelling,
  structNameOfTy,
  tyAt,
  tyIsLitUnion,
  tyIsLitUnionOrLit,
  tyMembersDistinctRecords,
  tyNameAtoms,
  tySame,
  tyToEmitNameAt,
  tyToNominalNameAt,
  tyToStr,
} from "./check_types"
import { atomsHaveValueAtom, unionHasAtom } from "./emit_base"
import { emitFail } from "./emit_bytes"
import {
  declTyIxOfName,
  msAtomIdOf,
  msFreeSlicePush,
  msMaskClear,
  msMaskFull,
  msMaskHas,
  msMaskIsEmpty,
  msSetHas,
  msSetMaskCopy,
  msSliceAtom,
  msSliceAtomId,
  msSliceCount,
  msSliceKind,
  msSliceTy,
  repCanonId,
  repShadowAddReason,
  repShadowBumpReason,
  repShadowOn,
  tyIsI32LeafElem,
  tyIsStrLeafElem,
  unMemRowStart,
  unRowOfKey,
  unRowOfKeyId,
} from "./emit_rep"
export { unRowOfCanonFolded } from "./emit_rep"
import {
  msFreeByTy,
  msFreeChain,
  msGen,
  msRowChain,
  msSetGen,
  msSetNext,
  msSetRow,
  msSetText,
  msSetWordAt,
  msSetWords,
  uVariants,
  unKey,
  unKeyAliasRow,
  unKeyFirstRow,
  unKeyPush,
  unMemAtoms,
  unMemKinds,
  unMemTyCount,
  unMemTyStart,
  unMemTys,
  unMemberSet,
  unNames,
  unRowBySid,
  unTyIx,
  unVarCount,
  unVarStart,
} from "./emit_state"
import { sidArrGet, sidLookup } from "./symbols"
import {
  roListInnerName,
  splitUnionAtoms,
  tyTopIndexOf,
  unionMemberCount,
} from "./tyname"
import {
  flattenVariantsInto,
  intLitUnionBasesOf,
  isNullTy,
  primNameOf,
} from "./tyquery"

// The non-null member `X` when type `t` is exactly `X | null`, -1 otherwise.
export function nulArmTyOf(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const at = tyAt(t)
  if at is TyNullable { return at.nInner }
  const tys: i32[] = []
  flattenVariantsInto(t, tys)
  if tys.length != 2 { return -1 }
  if isNullTy(tys[0]) && !isNullTy(tys[1]) { return tys[1] }
  if isNullTy(tys[1]) && !isNullTy(tys[0]) { return tys[0] }
  -1
}

// The atom code a list of element `e` takes on the i32 list's storage: 17 for `boolean`, 18
// for its `boolean | null` niche and for `null`, -1 for any other element.
export function boolTagElemKind(e: i32): i32 {
  if primNameOf(e) == "boolean" { return 17 }
  // `null[]` is that backing with every element the null sentinel (D4671).
  if primNameOf(e) == "null" { return 18 }
  if e < 0 || e >= T.tys.length { return -1 }
  const t = tyAt(e)
  if t is TyNullable {
    if primNameOf(t.nInner) == "boolean" { return 18 }
  }
  -1
}

// The `unNames` row a spelling names, or -1 — `unNameBound`'s row-valued sibling, so registry-
// by-id seams can compare row to row rather than boolean to boolean: "both said yes" and
// "both named the same row" are different findings. `unionRowOf` is a wider lookup (it also
// asks a member-set spelling's key); this one is the exact row `unNameBound` answers about.
export function unRowOfName(name: string): i32 {
  sidArrGet(unRowBySid, sidLookup(name))
}

// Whether the spelling `name` is bound to a row, for a caller about to bind or rewrite it.
export function unNameBound(name: string) { unRowOfName(name) >= 0 }

// The full pipe-joined member set of the union named `name`: a registered alias returns its
// `unMemberSet` entry (`type N = A | B` expands to `"A|B"`); an unregistered or already
// pipe-joined name passes through unchanged. Lets complement narrowing subtract variants
// from an alias-annotated binding's set.
export function unionMemberSetOf(name: string) {
  const u = unRowOfName(name)
  if u >= 0 { return unMemberSet[u] }
  name
}

// The row whose recorded member columns answer for spelling `name`: the row `name` is bound
// to, or -1 when it is bound to none or that row has no recorded member slice.
export function unMemRowOfName(name: string): i32 {
  const u = unRowOfName(name)
  if u < 0 || u >= unMemTyStart.length { return -1 }
  const st = unMemTyStart[u]
  if st < 0 || st + unMemTyCount[u] > unMemAtoms.length { return -1 }
  u
}

// Appends the recorded member atoms of row `u` (one `unMemRowOfName` returned) to `out`, in
// box-tag order.
function unRowAtomsInto(u: i32, out: string[]) {
  const st = unMemTyStart[u]
  let i = 0
  while i < unMemTyCount[u] {
    out.push(unMemAtoms[st + i])
    i = i + 1
  }
  0
}

// Appends the member atoms of `name` to `out`, in box-tag order: a bound row's recorded
// members, else the atoms `name` itself spells. An alias name answers with its declared arms.
export function unionMemberAtomsOf(name: string, out: string[]) {
  const u = unMemRowOfName(name)
  if u < 0 { return unionSetAtomsOf(unionMemberSetOf(name), out) }
  unRowAtomsInto(u, out)
}

// Appends the atoms member-set spelling `set` splits into, in box-tag order: the recorded
// members of the row whose set is `set` itself, else one atom for a declared type name or a
// primitive keyword (neither spells a top-level `|`), else the split.
export function unionSetAtomsOf(set: string, out: string[]) {
  const u = unMemRowOfName(set)
  if u >= 0 && unMemberSet[u] == set { return unRowAtomsInto(u, out) }
  if (cUserTypes[set] ?? -1) >= 0 || primTyIxOfName(set) >= 0 {
    out.push(set)
    return 0
  }
  splitUnionAtoms(set, out)
}

// `unionSetAtomsOf` for a caller holding `ty`, the arena type `set` is a render of, or -1. A
// type that is neither a union nor a nullable renders as one atom, and a nullable of one (or of
// a union named by its alias) as that atom then `null`; only the rest are split.
export function unionSetAtomsOfTy(set: string, ty: i32, out: string[]) {
  if ty < 0 || ty >= T.tys.length { return unionSetAtomsOf(set, out) }
  const t = tyAt(ty)
  if !(t is TyUnion) && !(t is TyNullable) {
    out.push(set)
    return 0
  }
  if t is TyNullable {
    const n = set.length - 5
    if n > 0 && t.nInner >= 0 && set.slice(n, set.length) == "|null" {
      const it = tyAt(t.nInner)
      const inner = set.slice(0, n)
      if (
        !(it is TyNullable)
        && (!(it is TyUnion) || (cUserTypes[inner] ?? -1) >= 0)
      ) {
        out.push(inner)
        out.push("null")
        return 0
      }
    }
  }
  unionSetAtomsOf(set, out)
}

// Pushes the arena type of each atom of a spelling of `ty` onto `out`: a lone atom is `ty`,
// and a union's non-null atoms take its canonical sequence's non-null members in order, so
// `null` may sit anywhere. A `null` atom is -1, and so is every atom when `ty` is -1 or the
// non-null counts differ.
export function unionAtomTysOf(ty: i32, atoms: string[], out: i32[]) {
  const mem: i32[] = []
  if atoms.length == 1 {
    mem.push(ty)
  } else {
    const tys: i32[] = []
    canonUnionMemberTysOf(ty, tys)
    for m in tys {
      if m >= 0 { mem.push(m) }
    }
  }
  let n = 0
  for a in atoms {
    if a != "null" { n = n + 1 }
  }
  let k = 0
  for a in atoms {
    let at = -1
    if a != "null" && mem.length == n {
      at = mem[k]
      k = k + 1
    }
    out.push(at)
  }
  0
}

// The number of atoms member-set spelling `set` splits into: the recorded count of the row
// whose set is `set` itself, else the spelling's own count. An alias name counts as one.
export function unionSetMemberCount(set: string): i32 {
  const u = unMemRowOfName(set)
  if u >= 0 && unMemberSet[u] == set { return unMemTyCount[u] }
  unionMemberCount(set)
}

// Whether member-set spelling `set` holds a non-null value-atom member (`atomsHaveValueAtom`
// over `unionSetAtomsOf`): false for an all-struct union.
export function unionHasValueAtom(set: string): boolean {
  const atoms: string[] = []
  unionSetAtomsOf(set, atoms)
  atomsHaveValueAtom(atoms)
}

// Whether the box of member set `s` carries a member as a string ref, counted over its member
// types: a literal-union or `string` member answers true, a lone member only as `string`, and a
// literal union beside `null` alone (the atom niche) false. False when `s` is uncovered.
export function msSetTakesAtomAsStr(s: i32): boolean {
  const tys: i32[] = []
  if !msMemberTysOfSet(s, tys) { return false }
  memberTysTakeAtomAsStr(tys)
}

// The count `msSetTakesAtomAsStr` and `tyDeclTakesAtomAsStr` share over member types, `-1` for
// `null`: a literal union is one member, never flattened into its literals.
function memberTysTakeAtomAsStr(tys: i32[]): boolean {
  let str = false
  let nul = false
  let lits = 0
  for m in tys {
    if m < 0 { nul = true }
    else if tyIsLitUnion(m) { lits = lits + 1 }
    else if primNameOf(m) == "string" { str = true }
  }
  if tys.length == 1 { return str }
  if tys.length == 2 && nul && lits == 1 { return false }
  str || lits > 0
}

// Whether a destination declared as type `ty` takes a literal-union atom as its member string,
// counted over the members `ty` itself declares: a literal-union alias stays one member, so a
// lone `K` or `K | null` answers false while `K | i32` and `string` answer true. False for `-1`.
export function tyDeclTakesAtomAsStr(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const tys: i32[] = []
  const t = tyAt(ty)
  if t is TyUnion {
    for m in t.uMembers { tys.push(declMemberOrNull(m)) }
  } else if t is TyNullable {
    const inner = t.nInner
    if inner >= 0 && inner < T.tys.length && !tyIsLitUnion(inner) {
      const it = tyAt(inner)
      if it is TyUnion {
        for m in it.uMembers { tys.push(declMemberOrNull(m)) }
      } else {
        tys.push(declMemberOrNull(inner))
      }
    } else {
      tys.push(declMemberOrNull(inner))
    }
    tys.push(-1)
  } else {
    tys.push(declMemberOrNull(ty))
  }
  memberTysTakeAtomAsStr(tys)
}

// Declared member `m`, with the `null` type folded to the `-1` the member count reads.
function declMemberOrNull(m: i32): i32 {
  if m < 0 || isNullTy(m) { return -1 }
  m
}

// Whether union type `ty`'s canonical members carry a literal-union atom as its string, so
// an alias arm counts at every depth: a literal-union or `string` member answers true, and a lone
// member or a literal union beside `null` alone (the atom niche) answers false.
export function tyTakesAtomAsStr(ty: i32): boolean {
  const tys: i32[] = []
  if !canonUnionMemberTysOf(ty, tys) { return false }
  let str = false
  let nul = false
  let lits = 0
  for m in tys {
    if m < 0 { nul = true }
    else if tyIsLitUnionOrLit(m) { lits = lits + 1 }
    else if primNameOf(m) == "string" { str = true }
  }
  if tys.length == 1 { return str }
  if tys.length == 2 && nul && lits == 1 { return false }
  str || lits > 0
}

// Whether the box of union type `ty` carries a literal-union atom as its member string: the
// row keyed by `ty` answers when one exists (a mixed literal union boxes as its widened row),
// else `ty`'s own members. False for `-1`.
export function tyBoxTakesAtomAsStr(ty: i32): boolean {
  const s = msSetOfTy(ty)
  if s >= 0 { return msSetTakesAtomAsStr(s) }
  tyTakesAtomAsStr(ty)
}

// The number of members of `name`: a bound row's recorded count, else the members `name`
// itself spells (1 for a bare name).
export function unionMemberCountOfName(name: string): i32 {
  const u = unMemRowOfName(name)
  if u < 0 { return unionSetMemberCount(unionMemberSetOf(name)) }
  unMemTyCount[u]
}

// The number of non-`null` members of `name`, read from a bound row's recorded members.
export function unionNameNonNullCount(name: string): i32 {
  unionNameNonNullCountTy(name, -1)
}

// `unionNameNonNullCount` for a caller that also holds `name`'s arena type `ty`, or -1.
export function unionNameNonNullCountTy(name: string, ty: i32): i32 {
  const u = unMemRowOfName(name)
  if u < 0 { return unionSetNonNullCountTy(unionMemberSetOf(name), ty) }
  const st = unMemTyStart[u]
  let n = 0
  let i = 0
  while i < unMemTyCount[u] {
    if unMemAtoms[st + i] != "null" { n = n + 1 }
    i = i + 1
  }
  n
}

// The interned full member set of `name`, read off its bound row (an alias resolves to its
// declared set); -1 when `name` has no row or its row has no set.
export function msSetOfUnion(name: string): i32 {
  const u = unMemRowOfName(name)
  if u < 0 { return -1 }
  msSetOfRow(u)
}

// Resolves `name` to its member-set spelling (an alias name to its declared set, else itself)
// and appends its atoms to `out`: a bound row's recorded members, else the spelling split; a
// declared type name is its own one atom. Returns the member-set spelling.
export function unionArmsOf(name: string, out: string[]) {
  unionArmsOfSet(name, -1, out)
}

// `unionArmsOf` for a caller holding the arena type `ty` of `name`, or -1: the row keyed by
// `ty` answers, else the atoms `ty` renders as (`unionSetAtomsOfTy`), before any split.
export function unionArmsOfTy(name: string, ty: i32, out: string[]) {
  unionArmsOfSetTy(name, msSetOfTy(ty), ty, out)
}

// `unionArmsOf` for a caller holding the member set `s` that `name` renders, or -1: the set's
// members answer before the spelling is split.
export function unionArmsOfSet(name: string, s: i32, out: string[]) {
  unionArmsOfSetTy(name, s, -1, out)
}

// `unionArmsOfSet` that also holds `ty`, the arena type `name` renders, or -1. A type only
// answers a name that is its own member set, since an alias resolves to its declared one.
function unionArmsOfSetTy(name: string, s: i32, ty: i32, out: string[]) {
  let nm = unionMemberSetOf(name)
  if nm == "" { nm = name }
  const u = unMemRowOfName(name)
  if u >= 0 {
    unRowAtomsInto(u, out)
    return nm
  }
  if (cUserTypes[nm] ?? -1) >= 0 {
    out.push(nm)
    return nm
  }
  if msMemberAtomsOfSet(s, out) { return nm }
  if nm == name {
    unionSetAtomsOfTy(nm, ty, out)
  } else {
    unionSetAtomsOf(nm, out)
  }
  nm
}

// Files the row being minted (member set `spelling`, slice recorded) under its type's union key,
// else under its softened key, which finds the row too. A row with `null` before a member, or
// whose softened key has another member count, keeps `spelling`'s key; the type key also needs
// `null` last and the key's first row to record the same members, `null`'s position aside.
export function unKeyPushOfTy(ty: i32, spelling: string) {
  const u = unKey.length
  let nk = -1
  if unRowNullLast(u) {
    const kept = sukKeptAtoms(ty, [])
    if kept.length == unMemTyCount[u] {
      nk = canonUnionKeyOfText(sukJoin(kept))
    }
  }
  if nk < 0 { nk = canonUnionKeyOfName(spelling) }
  let k = -1
  if ty >= 0 && unRowNullLast(u) { k = canonUnionKeyOfTy(ty) }
  if k >= 0 && k < unKeyFirstRow.length {
    const first = unKeyFirstRow[k]
    if first >= 0 && !unRowSetSameNullBlind(first, u) { k = -1 }
  }
  if k < 0 { return unKeyPush(nk) }
  unKeyPush(k)
  unKeyAliasRow(nk, unKey.length - 1)
}

// Whether row `u` records a member slice in bounds of the member columns.
function unRowHasSlice(u: i32): boolean {
  if u < 0 || u >= unMemTyStart.length || u >= unMemTyCount.length {
    return false
  }
  const st = unMemTyStart[u]
  const end = st + unMemTyCount[u]
  st >= 0 && end <= unMemAtoms.length && end <= unMemKinds.length
}

// Whether row `u`'s recorded members hold no `null`, or one, as the last member; false for a
// row with no recorded slice.
function unRowNullLast(u: i32): boolean {
  if !unRowHasSlice(u) { return false }
  const st = unMemTyStart[u]
  let i = 0
  while i + 1 < unMemTyCount[u] {
    if unMemKinds[st + i] == 0 { return false }
    i = i + 1
  }
  true
}

// The `unNames` ROW of the union `name` — matched on the alias NAME, else on the union key of
// the member set it spells (a consumer that already resolved the alias hands us the set), or
// -1. The name is asked first: a spelling that is one row's name keeps naming that row.
export function unionRowOf(name: string): i32 {
  if name == "" { return -1 }
  const u = unRowOfName(name)
  if u >= 0 { return u }
  unRowOfSetText(name)
}

// The softened key text of `ty`: its emit render's member sequence, literals widened (an integer
// union over two widths is its widths) and union aliases flattened, read off the type. "" when
// `ty` renders as fewer than two atoms or has a part this walk does not split. An anonymous
// record member is spelled as the first declaration in `stmts` of its exact shape.
export function softUnionKeyTextOfTyIn(ty: i32, stmts: i32[]): string {
  sukJoin(sukKeptAtoms(ty, stmts))
}

// The atoms of `softUnionKeyTextOfTyIn`'s text, each once in first-seen order; empty where
// that text is "".
function sukKeptAtoms(ty: i32, stmts: i32[]): string[] {
  const kept: string[] = []
  if ty < 0 { return kept }
  let atoms: string[] = []
  if !sukAtomsAt(ty, RC_ROOT, true, stmts, atoms) { return kept }
  if atoms.length < 2 {
    const widths: string[] = []
    for b in intLitUnionBasesOf(ty) {
      widths.push(tyToEmitNameAt(b, RC_UNION_MEM))
    }
    if widths.length < 2 { return kept }
    atoms = widths
  }
  for a in atoms {
    const ex: string[] = []
    if !sukAliasAtoms(a, ex) { return [] }
    for e in ex {
      let dup = false
      for k in kept {
        if k == e { dup = true }
      }
      if !dup { kept.push(e) }
    }
  }
  if kept.length < 2 { return [] }
  kept
}

function sukJoin(atoms: string[]): string {
  let out = ""
  for k in atoms {
    if out != "" { out = out + "|" }
    out = out + k
  }
  out
}

// The atoms alias atom `a` stands for in a key: its own members where a declared union alias
// renders as two or more, else `a`. An alias of declared records spells its members by name.
function sukAliasAtoms(a: string, out: string[]): boolean {
  const ix = cUserTypes[a] ?? -1
  if ix >= 0 {
    const t = tyAt(ix)
    const ex: string[] = []
    if t is TyNullable {
      if !sukAtomsAt(t.nInner, RC_ROOT, false, [], ex) { return false }
      ex.push("null")
    } else if t is TyUnion {
      if declaredStructUnionMembers(a) != "" {
        if !sukUnionAtoms(ix, t, RC_ROOT, true, [], ex) { return false }
      } else if !sukAtomsAt(ix, RC_ROOT, false, [], ex) {
        return false
      }
    }
    if ex.length > 1 {
      for e in ex { out.push(e) }
      return true
    }
  }
  out.push(a)
  true
}

// The render of `ty` at `ctx` on the face asked for, `tyNameAtoms` set to its width.
function sukRender(ty: i32, ctx: i32, nominal: boolean): string {
  if nominal { return tyToNominalNameAt(ty, ctx) }
  tyToEmitNameAt(ty, ctx)
}

// Whether every record of `recs` takes a declaration's name in `rev`.
function sukRevNamesAll(recs: i32[], rev: i32[]): boolean {
  if rev.length == 0 { return false }
  for r in recs {
    if sukRevName(r, rev) == "" { return false }
  }
  true
}

// The declaration in `rev` an anonymous record `ty` has the exact shape of, or "".
function sukRevName(ty: i32, rev: i32[]): string {
  if rev.length == 0 || ty < 0 || ty >= T.tys.length { return "" }
  const t = tyAt(ty)
  if !(t is TyObj) || structNameOfTy(ty) != "" { return "" }
  nominalNameOfObj(ty, rev)
}

// Appends the atoms of `ty`'s emit render at position `ctx`, the parts the render joins at
// its top level; false when it renders as "" or as a part this walk does not split.
function sukAtomsAt(
  ty: i32,
  ctx: i32,
  nominal: boolean,
  rev: i32[],
  out: string[],
): boolean {
  const rn = sukRevName(ty, rev)
  if rn != "" {
    out.push(rn)
    return true
  }
  const s = sukRender(ty, ctx, nominal)
  if s == "" { return false }
  if tyNameAtoms == 1 {
    out.push(s)
    return true
  }
  const t = tyAt(ty)
  if t is TyNullable { return sukNullableAtoms(t, nominal, rev, out) }
  if t is TyUnion { return sukUnionAtoms(ty, t, ctx, nominal, rev, out) }
  sukNoKeyOfKind()
}

// Every Ty kind but a nullable and a union whose render still spells two or more atoms: no
// softened key, so the caller keys by the name. Fails closed, as a guessed split would mint
// a key no name produces.
function sukNoKeyOfKind(): boolean { false }

// The string-literal run of union `ty` as the render spells it: its alias, else each distinct
// literal quoted. `null` members are skipped.
function sukLitRunAtoms(ty: i32, out: string[]) {
  const texts: string[] = []
  const t = tyAt(ty)
  if t is TyUnion {
    for m in t.uMembers {
      const mt = tyAt(m)
      if mt is TyLit {
        let dup = false
        for x in texts {
          if x == mt.litText { dup = true }
        }
        if !dup { texts.push(mt.litText) }
      }
    }
  }
  const al = litUnionAliasOfLitTexts(texts)
  if al != "" {
    out.push(al)
    return 0
  }
  for x in texts { out.push("\"" + x + "\"") }
  0
}

// `sukAtomsAt` over a nullable, as its render keeps a literal-union inner whole.
function sukNullableAtoms(
  t: TyNullable,
  nominal: boolean,
  rev: i32[],
  out: string[],
): boolean {
  const inner = t.nInner
  const nal = litUnionAliasNameOfTy(inner)
  if nal != "" {
    out.push(nal)
  } else if litUnionInlineNameOfTy(inner) != "" {
    sukLitRunAtoms(inner, out)
  } else if oneStrLitSpelling(inner) != "" {
    out.push(oneStrLitSpelling(inner))
  } else if inner >= 0 && tyAt(inner) is TyFunc {
    const s = sukRender(inner, RC_NULLABLE, nominal)
    if s == "" { return false }
    out.push("(" + s + ")")
  } else if !sukAtomsAt(inner, RC_NULLABLE, nominal, rev, out) {
    return false
  }
  out.push("null")
  true
}

// `sukAtomsAt` over a union of two or more parts: each member's atoms, a repeated part once.
function sukUnionAtoms(
  ix: i32,
  t: TyUnion,
  ctx: i32,
  nominal: boolean,
  rev: i32[],
  out: string[],
): boolean {
  const members = t.uMembers
  if litUnionInlineNameOfTy(ix) != "" {
    let hasNull = false
    for m in members { hasNull = hasNull || isNullTy(m) }
    if hasNull || ctxKeepsLitUnion(ctx) {
      sukLitRunAtoms(ix, out)
      if hasNull { out.push("null") }
      return true
    }
  }
  const recs: i32[] = []
  for m in members {
    if !isNullTy(m) { recs.push(m) }
  }
  if tyMembersDistinctRecords(recs) && !sukRevNamesAll(recs, rev) {
    return false
  }
  const rgAlias = mixedLitRunAliasOf(members)
  let rgDone = false
  const parts: string[] = []
  const partAtoms: string[] = []
  for m in members {
    const mt = tyAt(m)
    const pa: string[] = []
    if rgAlias != "" && mt is TyLit {
      if !rgDone { pa.push(rgAlias) }
      rgDone = true
    } else {
      const al = litUnionAliasNameOfTy(m)
      if al != "" {
        pa.push(al)
      } else if mt is TyFunc {
        const s = sukRender(m, RC_UNION_MEM | (ctx & RC_NULLABLE), nominal)
        if s == "" { return false }
        pa.push("(" + s + ")")
      } else if (
        !sukAtomsAt(m, RC_UNION_MEM | (ctx & RC_NULLABLE), nominal, rev, pa)
      ) {
        return false
      }
    }
    if pa.length > 0 {
      let text = ""
      for a in pa {
        if text != "" { text = text + "|" }
        text = text + a
      }
      let dup = false
      for p in parts {
        if p == text { dup = true }
      }
      if !dup {
        parts.push(text)
        for a in pa { partAtoms.push(a) }
      }
    }
  }
  for a in partAtoms { out.push(a) }
  true
}

// The first row carrying the union key of member-set spelling `set`, or -1. A spelling that
// names a declared type is that type's name, not a member set, and finds no row here.
export function unRowOfSetText(set: string): i32 {
  if set == "" { return -1 }
  if (cUserTypes[set] ?? -1) >= 0 { return -1 }
  unRowOfKeyId(canonUnionKeyOfName(set))
}

// Armed, the softened key text of `ty` against the key text of `name` at `site`: agree,
// differ, or none where `ty` has no softened text. Flushed by the registry sweep.
let sukNotes: string[] = []

export function softKeyProbe(site: i32, name: string, ty: i32) {
  softKeyProbeIn(unABSiteName(site), name, ty, [])
}

// `softKeyProbe` for a caller that offers no type of its own, only the one `name` renders.
export function softKeyProbeNoTy(
  site: i32,
  name: string,
  ty: i32,
  stmts: i32[],
) {
  softKeyProbeIn("noTy/" + unABSiteName(site), name, ty, stmts)
}

function softKeyProbeIn(label: string, name: string, ty: i32, stmts: i32[]) {
  if unABOn() == 0 || ty < 0 || name == "" { return 0 }
  const s = softUnionKeyTextOfTyIn(ty, stmts)
  const n = canonUnionKeyTextOfName(name)
  let k = "agree"
  if s == "" { k = "none" }
  else if s != n { k = "differ" }
  const tag = "softKey/" + label + "/" + k
  sukNotes.push(tag)
  if k != "agree" {
    sukNotes.push(
      tag + " " + name + " :: " + n + " :: " + s + " :: " + tyToStr(ty),
    )
  }
  0
}

// ── the union registry asked by arena type id — an A/B shadow harness (docs/internals/registry-by-type-id.md)

// Off by default: `unABOn()` is 0 unless the host arms the shadow harness, and every AB
// function then returns exactly what its unshadowed twin does, so an unarmed compile is
// unaffected. Mode 2 prefers the id answer; mode 3 re-keys the tally on `unKey` instead of
// `repCanonId`, both armed from source only, since a compiler reading its own environment is a second input.
export const unABMode: i32 = 0

// The emit-time tallies, per converted site — counters, not a shared reason-bucket, because
// `repShadowSweep` resets the bucket table before this sweep runs (a bump during emit would
// not survive to the report) and a pooled bucket can't say which site a disagreement belongs
// to: `unABCnt[site * UNAB_K + k]`, six outcomes per site.
let unABCnt: i32[] = []
const UNAB_K = 7
// 0 agree · 1 differ · 2 name-only · 3 id-only · 4 neither · 5 no-ty · 6 alias.
const UNAB_AGREE = 0
const UNAB_DIFFER = 1
const UNAB_NAMEONLY = 2
const UNAB_IDONLY = 3
const UNAB_NEITHER = 4
const UNAB_NOTY = 5
// Two rows keyed to the same member sequence but differing only in name (a declared alias
// beside its inline spelling, or two monomorphized instances) are not a disagreement — their
// tag slices are identical and either row answers. D1491.
const UNAB_ALIAS = 6
let unRetryHit: i32 = 0
let unRetryMiss: i32 = 0

export function unABOn(): i32 {
  if unABMode > 0 { return unABMode }
  if repShadowOn { return 1 }
  0
}

// One reach recorded. Called only when armed, so the growth loop and the read-modify-write
// are off the unarmed path entirely.
function unABBump(site: i32, k: i32) {
  const at = site * UNAB_K + k
  while unABCnt.length <= at { unABCnt.push(0) }
  unABCnt[at] = unABCnt[at] + 1
  0
}

// Two rows the KEY cannot tell apart: both covered, and their minted `unKey` is the same id.
// Bounded on both sides — a row named by a key the column never grew is exactly the read that
// trapped at D1152.
function unRowKeySame(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return false }
  if a >= unKey.length || b >= unKey.length { return false }
  if unKey[a] < 0 { return false }
  unKey[a] == unKey[b]
}

// Classify one reach: `n` the row the SPELLING named, `d` the row the ARENA ID named, both
// -1 for "no row". `ty < 0` is its OWN bucket — "this site had no id to offer" and "the id
// disagreed" are different findings, and collapsing them is how a coverage gap reads as
// agreement.
export function unABProbe(site: i32, n: i32, d: i32, ty: i32) {
  if ty < 0 { return unABBump(site, UNAB_NOTY) }
  if n >= 0 && d >= 0 {
    if n == d { return unABBump(site, UNAB_AGREE) }
    if unRowKeySame(n, d) { return unABBump(site, UNAB_ALIAS) }
    return unABBump(site, UNAB_DIFFER)
  }
  if n >= 0 { return unABBump(site, UNAB_NAMEONLY) }
  if d >= 0 { return unABBump(site, UNAB_IDONLY) }
  unABBump(site, UNAB_NEITHER)
}

// The converted sites, by name — an i32 constant at each call site, so an unarmed compile
// just pushes it and returns; the spelling is needed only by the report. Ids 1-10 are the
// sites the initial shim added (including id-free callers that already hold an arena id);
// 11+ came from later one-hop threading. `UNAB_N` bounds the report loop.
const UNAB_N = 107
function unABSiteName(s: i32): string {
  if s == 47 { return "collectU/optCallRet" }
  // 69-81 are registry-membership readers asking a declared name's type (`isUNameDeclAB`);
  // 82-97 are `unionRowOf` callers handed the union's type (`unionRowKeyAB`).
  if s == 69 { return "annParamKind/union" }
  if s == 70 { return "inferRetIsUnion/noRow" }
  if s == 71 { return "inferRetIsUnion/noTy" }
  if s == 72 { return "forInNarrow/elem" }
  if s == 73 { return "unionRetName" }
  if s == 74 { return "nulBoxUnionElem" }
  if s == 75 { return "fieldCode/union" }
  if s == 76 { return "gaeLeaf/union" }
  if s == 77 { return "nameIsStructDecl" }
  if s == 78 { return "typeParamBase/union" }
  if s == 79 { return "monoAnnPin/union" }
  if s == 80 { return "monoAnnPin/listElem" }
  if s == 81 { return "monoAnnPin/litUnionList" }
  if s == 82 { return "armVariantForObj" }
  if s == 83 { return "armVariantForStructExpr" }
  if s == 84 { return "unionBoxHasNoRow" }
  if s == 85 { return "armVariantWithHeap" }
  if s == 86 { return "unionSetCanHoldStruct" }
  if s == 87 { return "markValueUnionAtoms" }
  if s == 88 { return "assignGlobal/litUnion" }
  if s == 89 { return "assignLocal/litUnion" }
  if s == 90 { return "narrowedBoxRender" }
  if s == 91 { return "unionBoxLacksTag" }
  if s == 92 { return "listEmptyFitArms" }
  if s == 93 { return "isPatUnionArmTy" }
  if s == 94 { return "mapSoftTwinTag" }
  if s == 95 { return "listIsAcrossReps" }
  if s == 96 { return "unionUnionEq/left" }
  if s == 97 { return "unionUnionEq/right" }
  if s == 98 { return "anonValueFitsField/boxed" }
  if s == 99 { return "anonValueFitsField/union" }
  if s == 100 { return "shapeRowFits/union" }
  if s == 101 { return "shapeFieldTypeCompatK" }
  if s == 102 { return "markMapUnionArms" }
  if s == 103 { return "markRefArrayArms" }
  if s == 104 { return "unionHasMapArmSlot" }
  if s == 105 { return "unionHasAtomLeafArm" }
  if s == 106 { return "mapBoxTagOf" }
  // 67-68 are registry-membership readers moved onto the type key (`isUNameKeyAB`).
  if s == 67 { return "funcTypeShape/unionField" }
  if s == 68 { return "nulCloMixedUnion/res" }
  // 61-66 are the last `registerValueUnionName` callers, handed the type at their source.
  if s == 61 { return "iisField/refListElem" }
  if s == 62 { return "iisField/nulRefListElem" }
  if s == 63 { return "iisField/union" }
  if s == 64 { return "gaeField/union" }
  if s == 65 { return "asNull/numFallible" }
  if s == 66 { return "nliInferLet" }
  // 54-60 are `registerValueUnionName` callers that hold the type they rendered the name from.
  if s == 54 { return "pushFieldRow/union" }
  if s == 55 { return "riu/valueUnion" }
  if s == 56 { return "collectU/arrLitNulScalar" }
  if s == 57 { return "collectU/popGet" }
  if s == 58 { return "collectU/coalesceIf" }
  if s == 59 { return "collectU/optMember" }
  if s == 60 { return "mvShape/valueUnion" }
  // 52-53 are `unionRowOf` callers that hold the type they rendered the name from.
  if s == 52 { return "anonUnionFieldName" }
  if s == 53 { return "mvValUnionRow" }
  // 48-51 are step 5: name-only readers and a mint that rendered a type they held.
  if s == 48 { return "mapValNominalName" }
  if s == 49 { return "nulRefElemNominal" }
  if s == 50 { return "asNullResult" }
  if s == 51 { return "sharedReadUnion" }
  // 29-46 are step 4b(c): `registerInlineUnionAt`'s descents into a subtype, each keyed on its
  // own canon key, plus `collectTyReachRegister`'s two ID-FREE callers, which hold a type.
  if s == 29 { return "riu/mapVal" }
  if s == 30 { return "riu/arrayAtom" }
  if s == 31 { return "riu/pun" }
  if s == 32 { return "riu/nulRefArray" }
  if s == 34 { return "riu/nulCloValue" }
  if s == 35 { return "riu/nulCloVariant" }
  if s == 36 { return "riu/nulCloRefArray" }
  if s == 37 { return "riu/nestedArray" }
  if s == 39 { return "riu/fnResult" }
  if s == 40 { return "riu/refArrayArm" }
  if s == 41 { return "ctr/nullableName" }
  if s == 42 { return "ctr/unionName" }
  if s == 43 { return "riu/collapsedName" }
  if s == 44 { return "riu/inferRetNominal" }
  if s == 45 { return "riu/arrElemUnion" }
  if s == 46 { return "riu/api" }
  if s == 1 { return "regValueUnionTy" }
  if s == 2 { return "letAnnUnionKind" }
  if s == 3 { return "unionNameOfExpr/as" }
  if s == 4 { return "unionNameOfExpr/is" }
  if s == 5 { return "letAnnUnionRetSink" }
  if s == 6 { return "letAnnUnionSlot" }
  if s == 7 { return "internShapeDeep/valueUnion" }
  if s == 8 { return "internFuncTypeShapes/valueUnion" }
  if s == 9 { return "inferRetArenaUnionIsDup" }
  if s == 10 { return "internShapeDeep/armTys" }
  if s == 11 { return "exprIsUnionStrEq/l" }
  if s == 12 { return "exprIsUnionStrEq/r" }
  if s == 13 { return "memberUnionFieldName" }
  if s == 14 { return "writeRhsIsNullBearing" }
  if s == 15 { return "fnUnionRetSinkOk" }
  if s == 16 { return "arrLitUnionElemName" }
  if s == 17 { return "arrLitBoxElem" }
  if s == 18 { return "unionNameOfExpr/callee" }
  if s == 19 { return "unionNameOfExpr/closure" }
  if s == 20 { return "unionNameOfExpr/method" }
  if s == 21 { return "nliInferIfLet" }
  if s == 22 { return "nliInferOptChainLet" }
  if s == 23 { return "collectU/inferLetTy" }
  if s == 24 { return "collectU/arrLitInferElem" }
  if s == 25 { return "emitUnionUnionEq" }
  if s == 26 { return "emitReturnValue/inferRet" }
  if s == 27 { return "emitLetDeclStmt/union" }
  if s == 28 { return "emitLetDeclStmt/nli" }
  "site?"
}

// One bucket's name. Split out so the report loop reads as a table rather than as a
// six-armed ladder inside two nested loops.
function unABKindName(k: i32): string {
  if k == UNAB_AGREE { return "agree" }
  if k == UNAB_DIFFER { return "differ" }
  if k == UNAB_NAMEONLY { return "name-only" }
  if k == UNAB_IDONLY { return "id-only" }
  if k == UNAB_NEITHER { return "neither" }
  if k == UNAB_ALIAS { return "alias" }
  "no-ty"
}

// The id-keyed twin of `unionRowOf(name)`. `unRowOfCanonFolded` is the reverse index this repo
// already built (`repCanonId` over the `unTyIx` sidecar B-1 step 1 populated); this name is
// its registry-facing spelling, so a converted call site reads as the twin of the call it
// replaces rather than as a new idea.
function unionRowOfTy(ty: i32): i32 { unRowOfCanonFolded(ty) }

// The raw-arena-index twin, kept beside the canon one so all three candidate keys can be
// priced against each other on one run. The arena is not hash-consed for composite
// spellings, so one spelling mints several indices and this misses rows the canon key
// finds — that gap is the argument against keying on the raw index.
function unionRowOfTyRaw(ty: i32): i32 {
  if ty < 0 { return -1 }
  let u = 0
  while u < unTyIx.length {
    if unTyIx[u] == ty { return u }
    u = u + 1
  }
  -1
}

// The seams that answer from the union KEY, step 5's switch: every one but 55, whose type keeps
// the literals, aliases and nesting its name's render drops. Where the key finds no row,
// `unSiteWideHit` and the mint guard say what still answers.
// `docs/internals/registry-by-type-id.md` §5.
export function unSiteOnKey(site: i32): boolean {
  site >= 1 && site < UNAB_N && site != 55
}

// The ID side's row for `site`: a switched site and harness mode 3 key on `unKey`, anything
// else on `repCanonId`. Only the A/B seams route through here.
export function unRowOfTyAB(site: i32, ty: i32): i32 {
  if unABMode == 3 || unSiteOnKey(site) { return unRowOfKey(ty) }
  unionRowOfTy(ty)
}

// The registry-membership seam: a site with a type answers "a row carries its
// key", and one with no type (`ty < 0`) answers by the key of `name`. Armed, the spelling's own
// row is read only to tally; it scans `unNames` where the key scans `unTyIx`, so the buckets
// name a coverage hole apart from a key disagreement.
export function isUNameAB(site: i32, name: string, ty: i32): boolean {
  isUNameABAt(site, name, ty, false)
}

// `isUNameAB` for a mint guard where `name` is the type's own spelling: the key of `name` also
// answers where that type carries no union key (a softened literal union, or same-shape records
// collapsed to one record).
export function isUNameOwnAB(site: i32, name: string, ty: i32): boolean {
  isUNameABAt(site, name, ty, true)
}

// False only where `isUNameAB` given type `ty` answers false whatever the name: unarmed, and
// `ty` neither a union nor a nullable, the one shape any of its typed legs keys a row from.
// A caller may skip building the name then.
export function isUNameABTyMayHit(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length || unABOn() > 0 { return true }
  const t = tyAt(ty)
  t is TyUnion || t is TyNullable
}

// The row carrying the union key of spelling `name`, or -1 when `name` is not a union of two or
// more members.
function nameKeyRow(name: string): i32 {
  unRowOfKeyId(canonUnionKeyOfAnnName(name))
}

// The shared body. `own` says `name` is the type's own spelling, so the key of `name` answers
// where the type carries no union key.
export function isUNameABAt(
  site: i32,
  name: string,
  ty: i32,
  own: boolean,
): boolean {
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(site, ty) }
  if unABOn() > 0 { unABProbe(site, unRowOfName(name), d, ty) }
  if ty < 0 { return nameKeyRow(name) >= 0 }
  if d >= 0 || unSiteWideHit(site, ty) || unRowOfCanonMembers(ty) >= 0 {
    return true
  }
  own && canonUnionKeyOfTy(ty) < 0 && nameKeyRow(name) >= 0
}

// The row union `ty`'s key finds, else the row its canonical member sequence finds, or -1: the
// rows a typed site on the key answers yes about in `isUNameAB`.
export function unRowOfKeyOrMembers(ty: i32): i32 {
  const k = unRowOfKey(ty)
  if k >= 0 { return k }
  unRowOfCanonMembers(ty)
}

// The row keyed by the sequence of union `ty`'s canonical members, or -1: the spelling canon
// gives the type, which its own nominal key misses when it nests a union (`K | (L | i32)`
// keys apart from the `string | i32` row its canon spelling minted). A repeated member declines,
// since a positional member set (`i32 | string | string`) is never folded onto a deduplicated row.
function unRowOfCanonMembers(ty: i32): i32 {
  if !tyNestsValueUnion(ty) { return -1 }
  const tys: i32[] = []
  if !canonUnionMemberTysOf(ty, tys) || tys.length < 2 { return -1 }
  const own: i32[] = []
  flattenVariantsInto(ty, own)
  let i = 0
  while i < own.length {
    let j = i + 1
    while j < own.length {
      if tySame(own[i], own[j]) { return -1 }
      j = j + 1
    }
    i = i + 1
  }
  let s = ""
  for m in tys {
    let a = "null"
    if m >= 0 { a = canonUnionKeyAtomOfTy(m) }
    if a == "" { return -1 }
    if s != "" { s = s + "|" }
    s = s + a
  }
  unRowOfKeyId(canonUnionKeyOfName(s))
}

// Whether union `ty` has a direct member that is itself a union other than a literal union, or
// two literal-union members, which canon spells as one run.
function tyNestsValueUnion(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  let litUnions = 0
  if t is TyUnion {
    for m in t.uMembers {
      if m >= 0 && m < T.tys.length {
        const mt = tyAt(m)
        if mt is TyUnion || mt is TyNullable {
          if !tyIsLitUnionOrLit(m) { return true }
          litUnions = litUnions + 1
        }
      }
    }
  }
  litUnions >= 2
}

// One union member against another in the same position: the same type, or two records or
// maps of one structure (or lists of such), which the key renders apart when only one
// carries its declared name.
function unMemberSameShape(a: i32, b: i32): boolean {
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  const ta = tyAt(a)
  const tb = tyAt(b)
  if ta is TyPrim {
    if tb is TyPrim { return ta.primName == tb.primName }
    return false
  }
  if ta is TyArray {
    if tb is TyArray { return unMemberSameShape(ta.aElem, tb.aElem) }
    return false
  }
  if !(ta is TyObj || ta is TyMap) || !(tb is TyObj || tb is TyMap) {
    return false
  }
  repCanonId(a) == repCanonId(b)
}

// Two union types with the same member sequence under `unMemberSameShape`, order kept, since
// a union's box tags are positional over its members.
function unTySeqSameShape(a: i32, b: i32): boolean {
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  const ta = tyAt(a)
  const tb = tyAt(b)
  match ta {
    TyNullable => tb is TyNullable && unTySeqSameShape(ta.nInner, tb.nInner)
    TyUnion => tb is TyUnion && unMemberSeqSameShape(ta.uMembers, tb.uMembers)
    TyLit => false
    TyArray => false
    TyMap => false
    TyObj => false
    TyPrim => false
    TyErr => false
    TyFunc => false
    TyVar => false
    TyNeg => false
  }
}

function unMemberSeqSameShape(ma: i32[], mb: i32[]): boolean {
  if ma.length != mb.length { return false }
  let i = 0
  while i < ma.length {
    if !unMemberSameShape(ma[i], mb[i]) { return false }
    i = i + 1
  }
  true
}

// A row for a union type the key missed: by the key of its `null` arm at each member position,
// since a nullable union's row keeps `null` at its spelled position, else a row whose recorded
// type has the same member sequence up to record names. For the existence question only.
function unRowOfTyWide(ty: i32): i32 {
  let at = 0
  let k = canonUnionKeyNullAtOfTy(ty, 0)
  while k >= 0 {
    const r = unRowOfKeyId(k)
    if r >= 0 { return r }
    at = at + 1
    k = canonUnionKeyNullAtOfTy(ty, at)
  }
  if canonUnionKeyOfTy(ty) < 0 { return -1 }
  let u = 0
  while u < unTyIx.length {
    if unTySeqSameShape(unTyIx[u], ty) { return u }
    u = u + 1
  }
  -1
}

// A row-existence seam's answer where the key finds no row: a row by `unRowOfTyWide`.
function unSiteWideHit(site: i32, ty: i32): boolean {
  if !unSiteWideAsks(site) { return false }
  unRowOfTyWide(ty) >= 0
}

// Whether the site asks about a row for the type rather than about the spelling.
function unSiteWideAsks(site: i32): boolean {
  match site {
    2 | 5 | 6 | 7 | 15 | 16 | 17 | 18 | 20 | 26 | 27 | 28 => true
    _ => false
  }
}

// The row-NAME seam: the name of the row carrying the union key, else "". A site with a type
// keys on it, and one with no type (`ty < 0`) on the key of `name`, so a spelling no row is
// named by still reaches the row its key finds; armed, the spelling's own row is only tallied.
export function unionRowNameAB(site: i32, name: string, ty: i32): string {
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(site, ty) } else { d = nameKeyRow(name) }
  if unABOn() > 0 { unABProbe(site, unRowOfName(name), d, ty) }
  if d >= 0 && d < unNames.length { return unNames[d] }
  ""
}

// The registry-membership seam for a caller with no arena node: the row its type keys to where it has one,
// and otherwise the row carrying the key canon mints for the spelling, one member or more. The
// empty name has no key and names no row; armed, a key of -1 is tallied as `no-ty`.
export function isUNameKeyAB(site: i32, name: string, ty: i32): boolean {
  let d = -1
  let key = -1
  if ty >= 0 {
    key = 0
    d = unRowOfTyAB(site, ty)
  } else {
    key = canonUnionKeyOfName(name)
    if key >= 0 { d = unRowOfKeyId(key) }
  }
  if unABOn() > 0 { unABProbe(site, unRowOfName(name), d, key) }
  d >= 0
}

// The key a no-type site finds `name`'s row by when it holds the type `ty` the name
// records: `ty`'s softened key with records named by their declarations in `stmts`,
// else the key of `name` where `ty` has none.
export function softKeyOrNameKey(name: string, ty: i32, stmts: i32[]): i32 {
  const k = canonUnionKeyOfText(softUnionKeyTextOfTyIn(ty, stmts))
  if k >= 0 { return k }
  canonUnionKeyOfName(name)
}

// Registry membership for a caller holding only a spelling: a declared type's name asks the key of
// its declared arena type, and any other spelling the key of `name`. Armed, the spelling key's
// row is tallied against the answer's.
export function isUNameDeclAB(site: i32, name: string): boolean {
  const ty = cUserTypes[name] ?? -1
  let d = -1
  if ty >= 0 {
    d = unRowOfTyAB(site, ty)
  } else {
    d = unRowOfKeyId(canonUnionKeyOfName(name))
  }
  if unABOn() > 0 {
    unABProbe(site, unRowOfKeyId(canonUnionKeyOfName(name)), d, ty)
  }
  d >= 0
}

// `unionRowOf(name)` for a caller holding the type `name` renders: the row that type's union
// key finds, else, where it finds none or no type came (`ty < 0`), the row `name` finds. Armed,
// the name's row is tallied against the key's under `site`.
export function unionRowKeyAB(site: i32, name: string, ty: i32): i32 {
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(site, ty) }
  if unABOn() > 0 { unABProbe(site, unionRowOf(name), d, ty) }
  if d >= 0 { return d }
  unionRowOf(name)
}

// `unionRowOf(name)`, for a caller that goes on to read the registry by `name` and holds the
// type `name` renders. Armed, the row that type keys to is tallied against it under
// `site`; the answer stays the name's until those readers are keyed by type too.
export function unionRowOfAB(site: i32, name: string, ty: i32): i32 {
  const r = unionRowOf(name)
  if unABOn() > 0 {
    let d = -1
    if ty >= 0 { d = unRowOfTyAB(site, ty) }
    unABProbe(site, r, d, ty)
  }
  r
}

// The member-type seam: the members of the row the type keys to, or, where the type finds no
// row or there is none (`ty < 0`), of the row carrying the key of `name`. False when neither
// finds a covered row, leaving `out` untouched.
export function unionMemberTysOfAB(
  site: i32,
  name: string,
  ty: i32,
  out: i32[],
): boolean {
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(site, ty) }
  if unABOn() > 0 { unABProbe(site, unRowOfName(name), d, ty) }
  if d < 0 { d = nameKeyRow(name) }
  unionMemberTysOfRow(d, out)
}

// `unionHasAtom`'s seam: whether the row the type keys to, or else the row carrying the key of
// `name`, records the member atom `atom` verbatim (`unMemAtoms`). Where neither key finds a row,
// the spelling's own atoms answer, since a spelling no row holds is a text question.
export function unionHasAtomAB(
  site: i32,
  name: string,
  ty: i32,
  atom: string,
): boolean {
  let d = -1
  if ty >= 0 { d = unRowOfTyAB(site, ty) }
  if unABOn() > 0 { unABProbe(site, unRowOfName(name), d, ty) }
  if d < 0 { d = nameKeyRow(name) }
  if d >= 0 { return unionHasAtomRow(d, atom) }
  unionHasAtom(name, atom)
}

// The key-stability check, per row: does the key the row's producer minted equal the key the
// other two producers (the arena type, the recorded member set) would obtain? A key with
// three entry points is only a key if they land on one id — the property step 5's switch
// rests on. `tykey-none` separates "the arena route has no key" from "it disagrees".
function unKeySweepRow(u: i32, ty: i32) {
  let k = -1
  if u < unKey.length { k = unKey[u] }
  if k >= 0 { repShadowBumpReason("keySweep/covered") }
  if ty >= 0 {
    const kn = canonUnionKeyOfTy(ty)
    if kn < 0 { repShadowBumpReason("keySweep/tykey-none") }
    else if kn == k { repShadowBumpReason("keySweep/tykey-agree") }
    else { repShadowBumpReason("keySweep/tykey-differ") }
  }
  if u < unMemberSet.length {
    const ks = canonUnionKeyOfName(unMemberSet[u])
    if ks == k {
      repShadowBumpReason("keySweep/set-agree")
    } else {
      repShadowBumpReason("keySweep/set-differ")
    }
  }
  0
}

// The second half of the key's licence — `merge-diffset` alone is not it (D1492). A struct
// union's tags are positional over its variant slice, not the member-set string, so two rows
// with the same set but different slices need this too. Complementary: a value union owns no
// variants, so only the set compare can see two atom sets fused.
function unRowVariantsSame(a: i32, b: i32): boolean {
  if a >= unVarStart.length || b >= unVarStart.length { return false }
  if a >= unVarCount.length || b >= unVarCount.length { return false }
  const na = unVarCount[a]
  if na != unVarCount[b] { return false }
  const sa = unVarStart[a]
  const sb = unVarStart[b]
  if sa < 0 || sb < 0 { return false }
  if sa + na > uVariants.length || sb + na > uVariants.length { return false }
  let i = 0
  while i < na {
    if uVariants[sa + i] != uVariants[sb + i] { return false }
    i = i + 1
  }
  true
}

// Points row `u`'s empty variant slice at the slice of the first earlier row minted under the
// same key, or leaves it alone. A one-member declaration over an inline union records the
// expansion's member set but has no struct member of its own to push (D1492); sharing the slice
// pushes no variant, so no tag moves.
export function unVarSliceAdoptKeySibling(u: i32) {
  if u < 0 || u >= unKey.length || u >= unVarCount.length { return 0 }
  if unVarCount[u] != 0 { return 0 }
  const r = unRowOfKeyId(unKey[u])
  if r < 0 || r >= u || r >= unVarCount.length { return 0 }
  if unVarCount[r] < 1 { return 0 }
  unVarStart[u] = unVarStart[r]
  unVarCount[u] = unVarCount[r]
  0
}

// The ABI assertion step 5 owes: two rows one key would fuse, and how many of those record a
// different member set. A union's box tags are positional over its own member set, so a merge
// across different sets reads a value tagged under one slice through the other's — the
// hazard that disqualified `repCanonId`. `merge-diffset` must be 0 for the key to be usable.
function unKeySweepPair(u: i32, v: i32) {
  let k = -1
  let kv = -1
  if u < unKey.length { k = unKey[u] }
  if v < unKey.length { kv = unKey[v] }
  if k < 0 || kv < 0 { return 0 }
  if k != kv { return 0 }
  repShadowBumpReason("keySweep/merge")
  if unNames[u] != unNames[v] { repShadowBumpReason("keySweep/merge-diffname") }
  if !unRowSetSameNullBlind(u, v) {
    repShadowBumpReason("keySweep/merge-diffset")
  }
  if !unRowVariantsSame(u, v) { repShadowBumpReason("keySweep/merge-diffvar") }
  0
}

// Whether rows `u` and `v` record the same members in the same order once their `null` members
// are set aside, with as many members each. `null`'s box tag is global, so where it sits is no
// part of the layout; every other member's position is, and none is deduped. A row with no
// recorded slice compares by its member-set spelling.
function unRowSetSameNullBlind(u: i32, v: i32): boolean {
  if u < 0 || v < 0 || u >= unMemberSet.length || v >= unMemberSet.length {
    return true
  }
  if unMemberSet[u] == unMemberSet[v] { return true }
  if !unRowHasSlice(u) || !unRowHasSlice(v) { return false }
  const n = unMemTyCount[u]
  if n != unMemTyCount[v] { return false }
  const su = unMemTyStart[u]
  const sv = unMemTyStart[v]
  let i = 0
  let j = 0
  while i < n || j < n {
    while i < n && unMemKinds[su + i] == 0 { i = i + 1 }
    while j < n && unMemKinds[sv + j] == 0 { j = j + 1 }
    if i < n && j < n {
      if unMemAtoms[su + i] != unMemAtoms[sv + j] { return false }
      i = i + 1
      j = j + 1
    } else if i < n || j < n {
      return false
    }
  }
  true
}

// The whole-registry measurement, run once per program beside `repShadowSweep`: every row
// asked about itself, both ways, with no call-site plumbing. The round-trips say whether a
// key can even name its own row; `canon-merge` counts pairs of distinct rows one canon id
// would fuse — the ABI hazard, since a union's box tags are positional over its own member set.
export function unionRegistryABSweep() {
  if unABOn() == 0 { return 0 }
  let s = 1
  while s < UNAB_N {
    let k = 0
    while k < UNAB_K {
      const at = s * UNAB_K + k
      if at < unABCnt.length {
        repShadowAddReason(
          "unionAB/" + unABSiteName(s) + "/" + unABKindName(k),
          unABCnt[at],
        )
      }
      k = k + 1
    }
    s = s + 1
  }
  repShadowAddReason("atomRetry/id-hit", unRetryHit)
  repShadowAddReason("atomRetry/id-miss", unRetryMiss)
  for l in sukNotes { repShadowBumpReason(l) }
  sukNotes = []
  unABCnt = []
  unRetryHit = 0
  unRetryMiss = 0
  let u = 0
  while u < unNames.length {
    repShadowBumpReason("unionSweep/rows")
    if unionRowOf(unNames[u]) == u { repShadowBumpReason("unionSweep/name-rt") }
    let ty = -1
    if u < unTyIx.length { ty = unTyIx[u] }
    if ty >= 0 {
      repShadowBumpReason("unionSweep/covered")
      if unionRowOfTy(ty) == u { repShadowBumpReason("unionSweep/canon-rt") }
      if unionRowOfTyRaw(ty) == u { repShadowBumpReason("unionSweep/raw-rt") }
    }
    unKeySweepRow(u, ty)
    let v = u + 1
    while v < unNames.length {
      if unNames[u] == unNames[v] { repShadowBumpReason("unionSweep/name-dup") }
      let tv = -1
      if v < unTyIx.length { tv = unTyIx[v] }
      unKeySweepPair(u, v)
      if ty >= 0 && tv >= 0 {
        if repCanonId(ty) == repCanonId(tv) {
          repShadowBumpReason("unionSweep/canon-merge")
          if unNames[u] != unNames[v] {
            repShadowBumpReason("unionSweep/canon-merge-diffname")
          }
          // Bounded, not assumed adjacent: `unMemberSet` is pushed in lockstep with `unNames`
          // at all three mint sites, but this sweep never relies on that alignment holding.
          if v < unMemberSet.length && u < unMemberSet.length {
            if unMemberSet[u] != unMemberSet[v] {
              repShadowBumpReason("unionSweep/canon-merge-diffset")
            }
          }
        }
      }
      v = v + 1
    }
    u = u + 1
  }
  0
}

// The row-keyed core of `unMemHasAtom` — the same walk from a row instead of a spelling.
// Every parallel-table read here is bounded: a row named by a key the table never grew
// is exactly the shape that trapped before. D1152.
function unMemHasAtomRow(u: i32, want: string, arr: boolean): i32 {
  if u < 0 { return -1 }
  if u >= unMemTyStart.length { return -1 }
  if u >= unMemTyCount.length { return -1 }
  const st = unMemTyStart[u]
  const n = unMemTyCount[u]
  if st < 0 { return -1 }
  if st + n > unMemTys.length { return -1 }
  let i = 0
  while i < n {
    let m = unMemTys[st + i]
    if m < 0 { return -1 }
    if m >= T.tys.length { return -1 }
    if arr {
      const ta = tyAt(m)
      m = -1
      if ta is TyArray { m = ta.aElem }
      if m >= T.tys.length { return -1 }
    }
    if m >= 0 {
      const t = tyAt(m)
      if t is TyPrim {
        if t.primName == want { return 1 }
      }
    }
    i = i + 1
  }
  0
}

// `unionHasAtom`'s row-keyed twin: does row `u` record a member whose verbatim atom
// spelling is `atom`? The name-keyed original scans the pipe-separated spans of a
// spelling; this scans `unMemAtoms`, recorded from exactly those spans, so the two answer
// the same question off the same text. Bounded through `unMemRowStart`. D1152.
function unionHasAtomRow(u: i32, atom: string): boolean {
  const st = unMemRowStart(u)
  if st < 0 { return false }
  const n = unMemTyCount[u]
  let i = 0
  while i < n {
    if unMemAtoms[st + i] == atom { return true }
    i = i + 1
  }
  false
}

// The registry row for a SPELLING, keyed by rep identity rather than by text: the name is
// used only as a ROUTE to the arena (`declTyIxOfName`), and the comparison is `repCanonId`.
// This is the query a registry keyed on an interned rep key would perform, written so the
// three filed witnesses can be graded without threading a type through their call chains.
function unionRowOfSpellingTy(name: string): i32 {
  const ty = declTyIxOfName(name)
  if ty < 0 { return -1 }
  unionRowOfTy(ty)
}

// The id-keyed RETRY at the atom test's decline. -1 always when unarmed, so the shipped
// compiler reaches its `emitFail` exactly as before; mode 1 only TALLIES whether the id key
// would have found the row, mode 2 answers from it. `id-hit` counts the refusals a rep-keyed
// registry would not have raised — the number the design's witness claim rests on.
function unABAtomRetry(name: string, want: string, arr: boolean): i32 {
  const m = unABOn()
  if m == 0 { return -1 }
  const u = unionRowOfSpellingTy(name)
  if u < 0 {
    unRetryMiss = unRetryMiss + 1
    return -1
  }
  unRetryHit = unRetryHit + 1
  if m != 2 { return -1 }
  unMemHasAtomRow(u, want, arr)
}

// The arena member types of the union `name`, appended to `out` in the row's recorded order
// (the box-tag ABI order). True when the row is covered and every member resolved; false
// leaves `out` untouched and the caller keeps its legacy member-name path. Consumers then
// classify each member structurally instead of re-deriving shape from its rendered spelling.
export function unionMemberTysOf(name: string, out: i32[]): boolean {
  unionMemberTysOfRow(unionRowOf(name), out)
}

// The same walk from a ROW — the one place the member columns are read, so a
// spelling-keyed and an arena-keyed entry point cannot drift into two readings of them.
function unionMemberTysOfRow(u: i32, out: i32[]): boolean {
  if u < 0 { return false }
  if u >= unMemTyStart.length { return false }
  const st = unMemTyStart[u]
  if st < 0 { return false }
  const n = unMemTyCount[u]
  let i = 0
  while i < n {
    if unMemTys[st + i] < 0 { return false }
    i = i + 1
  }
  let j = 0
  while j < n {
    out.push(unMemTys[st + j])
    j = j + 1
  }
  true
}

// The union-box ABI's atom test, from the arena: 1 when the union `name` has a member whose
// type is exactly the keyword primitive `want` (or exactly an array over it when `arr`), 0
// for none, -1 when the row is uncovered — a "cannot happen" its only caller diagnoses. Exact
// match only: the caller turns the atom into a tag, never asking "reps like this" instead.
export function unMemHasAtom(name: string, want: string, arr: boolean): i32 {
  const mems: i32[] = []
  if !unionMemberTysOf(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    let m = mems[i]
    if m >= T.tys.length { return -1 }
    if arr {
      const ta = tyAt(m)
      m = -1
      if ta is TyArray { m = ta.aElem }
      if m >= T.tys.length { return -1 }
    }
    if m >= 0 {
      const t = tyAt(m)
      if t is TyPrim {
        if t.primName == want { return 1 }
      }
    }
    i = i + 1
  }
  0
}

// The union-box ABI's atom test, answered only from the arena: a row minted without its
// members, an unresolved member spelling, or an unregistered name are each structurally
// impossible once a value is boxed with a tag, since the registration that mints the tag
// also records the members. An uncovered row is a "cannot happen" — it fails loudly.
export function unionHasAtomTy(
  name: string,
  want: string,
  arr: boolean,
): boolean {
  const a = unMemHasAtom(name, want, arr)
  if a >= 0 { return a == 1 }
  // SPIKE: would a registry keyed on rep identity have found this row? -1 when unarmed, so
  // the refusal below is reached exactly as before (`unABAtomRetry`).
  const r = unABAtomRetry(name, want, arr)
  if r >= 0 { return r == 1 }
  // The RENDERED member set, when the name is one: an inferred join has no registered row,
  // and its render is the checker's own member list, so reading it invents neither a row nor
  // an order. A name with no top-level `|` is an alias and still refuses (D1733).
  if tyTopIndexOf(name, '|', 0, 0) >= 0 {
    let spell = want
    if arr { spell = want + "[]" }
    return unionHasAtom(name, spell)
  }
  emitFail(
    "emitProgram: union box atom test on a union with no recorded members: "
      + name,
  )
  false
}

// ── the union member set as a structure ────────────────────────────────────────

// A member set is a subset of one union row's recorded members: the pair (row, mask), where
// bit `i` of the mask is member `i` in the row's recorded (box-tag ABI) order — never
// re-derived, only masked. Membership is a kind test or interned-id compare, not a substring
// search; a set renders (`msTextOf`) only when handed to a name-keyed consumer.

// The member slice of union row `u`, or -1 when the row is not covered by the reference
// columns (a row the recorder missed, or an empty row). `unMemTyStart`/`unMemTyCount` slice
// all four member columns alike. The bound lives once, in `emit_rep` beside the recorder
// that writes the columns (#1110) — this is its local spelling.
function msRowStart(u: i32): i32 { unMemRowStart(u) }

// The rendered form of the subset `mask` of row `u`: the surviving members'
// verbatim spellings, joined on `|`, in the row's recorded order.
function msRenderSet(u: i32, mask: i32[]): string {
  const n = msSliceCount(u)
  if n < 0 { return "" }
  let out = ""
  let i = 0
  while i < n {
    if msMaskHas(mask, i) {
      if out != "" { out = out + "|" }
      out = out + msSliceAtom(u, i)
    }
    i = i + 1
  }
  out
}

// Does set `s` hold exactly the mask `mask`?
function msSetMaskIs(s: i32, mask: i32[]): boolean {
  const at = msSetWordAt[s]
  let k = 0
  while k < mask.length {
    if at + k >= msSetWords.length { return false }
    if msSetWords[at + k] != mask[k] { return false }
    k = k + 1
  }
  true
}

// The first set interned over slice `u` (-1 none), the head of its `msSetNext` chain.
function msChainHead(u: i32): i32 {
  if u >= 0 { return msRowChain[u] }
  msFreeChain[-2 - u]
}

// The interned set id for the subset `mask` of row `u` — one id per distinct
// (row, mask), so a set's rendering is built once and every later operation on it is
// a table read. `mask` is `msMaskWords` words of the row. Stamped with the pool generation (method note 7).
function msSetIntern(u: i32, mask: i32[]): i32 {
  while u >= 0 && msRowChain.length <= u { msRowChain.push(-1) }
  let s = msChainHead(u)
  while s >= 0 {
    if msSetGen[s] == msGen.at && msSetMaskIs(s, mask) { return s }
    s = msSetNext[s]
  }
  const id = msSetRow.length
  const txt = msRenderSet(u, mask)
  msSetRow.push(u)
  msSetWordAt.push(msSetWords.length)
  let k = 0
  while k < mask.length {
    msSetWords.push(mask[k])
    k = k + 1
  }
  msSetGen.push(msGen.at)
  msSetNext.push(msChainHead(u))
  msSetText.push(txt)
  if u >= 0 { msRowChain[u] = id } else { msFreeChain[-2 - u] = id }
  id
}

// The set id of union row `u`'s FULL member set, or -1 when the row is uncovered.
function msSetOfRow(u: i32): i32 {
  if u < 0 || u >= unMemTyCount.length { return -1 }
  const st = msRowStart(u)
  if st < 0 { return -1 }
  msSetIntern(u, msMaskFull(unMemTyCount[u]))
}

// The full member set of the union row keyed as arena type `ty`, or -1 when no row carries
// its key: the set a caller holding the type reads without naming it.
export function msSetOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  const u = unRowOfKey(ty)
  if u < 0 { return -1 }
  msSetOfRow(u)
}

// The full member set of type `ty` whether or not a row carries its key: the row's set when one
// does, else a set over the type's own members in the canon render's order (`msFreeSliceOfTy`),
// one member for a type that is no union. A row-less set answers every member question but has
// no box tags. -1 when a member has no render.
export function msSetOfTyAny(ty: i32): i32 {
  const s = msSetOfTy(ty)
  if s >= 0 || ty < 0 { return s }
  const u = msFreeSliceOfTy(ty)
  if u > -2 { return -1 }
  msSetIntern(u, msMaskFull(msSliceCount(u)))
}

// The row-less member slice of type `ty`, built once per type: its members as
// `canonUnionMembersInto` spells them, never reordered or deduplicated past that. -1 when a
// member has no render.
function msFreeSliceOfTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  while msFreeByTy.length <= ty { msFreeByTy.push(-1) }
  const got = msFreeByTy[ty]
  if got >= 0 { return -2 - got }
  if got == -2 { return -1 }
  const tys: i32[] = []
  const atoms: string[] = []
  if !canonUnionMembersInto(ty, tys, atoms) || atoms.length < 1 {
    msFreeByTy[ty] = -2
    return -1
  }
  const u = msFreeSlicePush(tys, atoms)
  msFreeByTy[ty] = -2 - u
  u
}

// The full member set of union `name` whose arena type is `ty`, or -1: a union or alias name
// reads its row, else the row keyed by `ty`, else a nullable `ty`'s inner row when `name` spells
// that row's members. A primitive keyword or "" names no row.
export function msSetOfNameTy(name: string, ty: i32): i32 {
  const s = msSetOfUnion(name)
  if s >= 0 { return s }
  if name == "" || primTyIxOfName(name) >= 0 { return -1 }
  const s2 = msSetOfTy(ty)
  if s2 >= 0 || ty < 0 { return s2 }
  const t = tyAt(ty)
  if !(t is TyNullable) { return -1 }
  const r = msSetOfTy(t.nInner)
  if r >= 0 && msTextOf(r) == name { return r }
  -1
}

// The rendered member set of `s` (see `msRenderSet`).
export function msTextOf(s: i32): string {
  if s < 0 || s >= msSetText.length { return "" }
  msSetText[s]
}

// Appends set `s`'s member spellings to `out`, in the row's recorded (box-tag ABI) order,
// without splitting anything. False = uncovered (`s` is -1 or names no covered row), `out`
// untouched, and the caller splits the spelling instead.
export function msMemberAtomsOfSet(s: i32, out: string[]): boolean {
  if s < 0 { return false }
  if s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return false }
  let i = 0
  while i < n {
    if msSetHas(s, i) { out.push(msSliceAtom(u, i)) }
    i = i + 1
  }
  true
}

// `msMemberAtomsOfSet`'s twin over the member types, index-parallel to the atoms it appends.
export function msMemberTysOfSet(s: i32, out: i32[]): boolean {
  if s < 0 { return false }
  if s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return false }
  let i = 0
  while i < n {
    if msSetHas(s, i) { out.push(msSliceTy(u, i)) }
    i = i + 1
  }
  true
}

// The number of members of set `s`, `null` included; 0 when `s` is uncovered.
export function msMemberCount(s: i32): i32 {
  const tys: i32[] = []
  msMemberTysOfSet(s, tys)
  tys.length
}

// MEMBERSHIP of the `null` keyword — a member-KIND test over the set's members, with
// no string compare at all.
export function msHasNull(s: i32): boolean {
  if s < 0 || s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return false }
  let i = 0
  while i < n {
    if msSetHas(s, i) {
      if msSliceKind(u, i) == 0 { return true }
    }
    i = i + 1
  }
  false
}

// CARDINALITY of the non-`null` members — a bit count over the kind column.
function msNonNullCount(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return 0 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return 0 }
  let c = 0
  let i = 0
  while i < n {
    if msSetHas(s, i) {
      if msSliceKind(u, i) != 0 { c = c + 1 }
    }
    i = i + 1
  }
  c
}

// The arena type of the set's sole member, or -1 when the set is empty, uncovered, or has
// two or more members. The bridge from the set ADT to the per-type classifiers: a complement
// narrowing subtracted down to one member (`i32 | null` minus `null`) binds that member's
// type, so "what is this binding now" asks the type, not the rendered survivor.
export function msSoleMemberTy(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return -1 }
  let found = -1
  let i = 0
  while i < n {
    if msSetHas(s, i) {
      if found >= 0 { return -1 }
      found = i
    }
    i = i + 1
  }
  if found < 0 { return -1 }
  msSliceTy(u, found)
}

// SUBTRACTION of the `null` keyword: clear every member whose KIND is the null token.
export function msSubNull(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return -1 }
  const mask = msSetMaskCopy(s)
  let i = 0
  while i < n {
    if msMaskHas(mask, i) {
      if msSliceKind(u, i) == 0 { msMaskClear(mask, i) }
    }
    i = i + 1
  }
  msSetIntern(u, mask)
}

// SELECTION of one member by arena TYPE: clear every member the type is not. The write
// half of the reads-only rule needs a member the CHECKER named, and it names it by arena
// index — `msSubAtom`'s spelling identity cannot answer for a type with no written atom.
export function msKeepTy(s: i32, ty: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  if ty < 0 { return -1 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return -1 }
  const mask = msSetMaskCopy(s)
  let i = 0
  while i < n {
    if msMaskHas(mask, i) {
      if !msTyCovers(ty, msSliceTy(u, i)) { msMaskClear(mask, i) }
    }
    i = i + 1
  }
  if msMaskIsEmpty(mask) { return -1 }
  msSetIntern(u, mask)
}

// Does `ty` cover member type `m`? A single type covers itself; a UNION covers each of its own
// members, which is the shape an arm join hands back (`i32 | string` out of a three-arm
// declaration). The set keeps the declared row and narrows only its mask, so box tags stay
// positional whatever the join's own arena row looks like (D1846).
function msTyCovers(ty: i32, m: i32): boolean {
  if tySame(ty, m) { return true }
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if tySame(t.uMembers[i], m) { return true }
      i = i + 1
    }
  }
  false
}

// SUBTRACTION of a named member: clear every member whose interned IDENTITY is the
// removed one. `msAtomIdOf` peels grouping parens on both sides, exactly as the
// string surgery's `peelGroupParens` comparison did, so an `is () => i64` test still
// strips the `(() => i64)` member.
export function msSubAtom(s: i32, removed: string): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return -1 }
  const rid = msAtomIdOf(removed)
  const mask = msSetMaskCopy(s)
  let i = 0
  while i < n {
    if msMaskHas(mask, i) {
      if msSliceAtomId(u, i) == rid { msMaskClear(mask, i) }
    }
    i = i + 1
  }
  msSetIntern(u, mask)
}

// ── the set ADT's consumers (structure first, string surgery as fall-through) ──

// Set SUBTRACTION — the else-branch complement of `is removed` / `!= null`: resolves the set,
// clears the removed member's bits and renders the survivors in the row's recorded ORDER. `ty`
// is `set`'s arena type (-1 none), as `removeAtomRestOf` takes it.
export function removeAtomFromSet(
  set: string,
  removed: string,
  ty: i32,
): string {
  removeAtomFromSetOf(-1, set, removed, ty)
}

// The id of set `s` less member `removed`, or -1 when `s` is -1 or the set path declines. `null`
// is a keyword, the one member removed without any name.
export function msRemoveAtomId(s: i32, removed: string): i32 {
  if s < 0 { return -1 }
  if removed == "null" { return msSubNull(s) }
  msSubAtomOrView(s, removed)
}

// `removeAtomFromSet` for a caller already holding the id `sid` of `set` (-1 resolves `set`) and
// `set`'s arena type `ty` (-1 none), as `removeAtomRestOf` takes it.
export function removeAtomFromSetOf(
  sid: i32,
  set: string,
  removed: string,
  ty: i32,
): string {
  removeAtomRestOf(removeAtomIdOf(sid, set, removed), set, removed, ty)
}

// The id of `set` less `removed`, where `sid` is `set`'s id or -1 to resolve `set` by key; -1
// when no key covers it. A narrowing pushed from the survivors banks this id.
export function removeAtomIdOf(sid: i32, set: string, removed: string): i32 {
  let s = sid
  if s < 0 && primTyIxOfName(set) < 0 { s = msSetOfUnion(set) }
  msRemoveAtomId(s, removed)
}

// The rendering of the survivors `rid` from `removeAtomIdOf`. With no id, `set`'s arena type
// `ty` (-1 none) builds a set from its own members, rendered less `removed` and not banked: its
// row need not be the row the rendering names. `set` itself when neither covers it.
export function removeAtomRestOf(
  rid: i32,
  set: string,
  removed: string,
  ty: i32,
): string {
  if rid >= 0 { return msTextOf(rid) }
  if set == "" || ty < 0 { return set }
  const c = msSetOfTyAny(ty)
  const rc = msRemoveAtomId(c, removed)
  if rc < 0 || rc == c { return set }
  msTextOf(rc)
}

// `msSubAtom`, where a set that spells a view's member as its list still loses it: the two are
// one rep and one atom, so `is readonly f64[]` rules out an `f64[]` member (D2887).
export function msSubAtomOrView(s: i32, removed: string): i32 {
  const r = msSubAtom(s, removed)
  if r != s { return r }
  const roIn = roListInnerName(removed)
  if roIn == "" { return r }
  msSubAtom(s, roIn)
}

// The per-arm plan for `print(<value-union box>)`: the box-tag ABI-ordered value-atom kind of
// every arm, appended to `out`, true only when every arm is a value `print` renders on its
// own. Kinds 0..5 are `print`'s declared scalar/string domain (plus 6 for `null`); kinds
// 7..13 (lists, closures) are containers with no defined print rendering and decline. D711.
export function printNarrowKeepsBox(exprIx: i32, fnIx: i32): boolean {
  const nt = readNarrowedTyAt(exprIx, fnIx)
  if nt < 0 { return true }
  const tys: i32[] = []
  flattenVariantsInto(nt, tys)
  tys.length > 1
}

// The members a narrowing to two or more of them leaves a print argument's box holding, into
// `live`; nothing when it is not so narrowed. A box with a record arm the narrowing excluded
// prints from these alone (D3231).
export function printNarrowLiveAtoms(exprIx: i32, fnIx: i32, live: string[]) {
  const nt = readNarrowedTyAt(exprIx, fnIx)
  if nt < 0 { return 0 }
  const s = msSetOfTyAny(nt)
  if msMemberCount(s) >= 2 { msMemberAtomsOfSet(s, live) }
  0
}

// Set while a read the narrowing pins to `null` is planned with that narrowing lifted: the plan
// then skips a record arm rather than decline the box, since the narrowing ruled it out (D3231).
export let printPlanNullPinned = false

// Sets whether the print plan reads a `null`-pinned box; the previous setting, to restore.
export function printPlanPinNull(on: boolean): boolean {
  const was = printPlanNullPinned
  printPlanNullPinned = on
  was
}

// Lifts the pin at compile start, so a compile that stopped inside a pinned plan leaves none.
export function printPlanReset() {
  printPlanNullPinned = false
  0
}

// MEMBERSHIP of `null` in a member set, structurally; a declared type name is one non-null atom,
// and a primitive keyword is one atom that is `null` only when it is `null` itself.
export function unionSetHasNull(set: string): boolean {
  unionSetHasNullTy(set, -1)
}

// `unionSetHasNull` for a caller that also holds `set`'s arena type `ty`, or -1.
export function unionSetHasNullTy(set: string, ty: i32): boolean {
  if primTyIxOfName(set) >= 0 { return set == "null" }
  const s = msSetOfNameTy(set, ty)
  if s >= 0 { return msHasNull(s) }
  if (cUserTypes[set] ?? -1) >= 0 { return false }
  unionHasAtom(set, "null")
}

// CARDINALITY of a member set's non-`null` members, structurally; `ty` is `set`'s arena type
// when the caller holds it, or -1.
export function unionSetNonNullCountTy(set: string, ty: i32): i32 {
  const s = msSetOfNameTy(set, ty)
  if s >= 0 { return msNonNullCount(s) }
  const atoms: string[] = []
  unionSetAtomsOf(set, atoms)
  let n = 0
  let i = 0
  while i < atoms.length {
    if atoms[i] != "null" { n = n + 1 }
    i = i + 1
  }
  n
}

// ── the arena duals of the union structural member classifiers ─────────────────

// Each answers the same question `nameIs*` asked of a rendered atom spelling, from the
// member's arena type instead — `nameIsMap` / `nameIsClosureArray` / `valueAtomKind(.) ==
// 11` / `nameIsArray(.) && nameIsMap(refArrElemName(.))`.

// A MAP member (`{[string]: V}`). The `nameIsMapMemberUnion` exclusion the name path
// carries is structural here for free: a union whose FIRST atom is a map renders as a
// `{[`-prefixed name but IS a `TyUnion`, never a `TyMap`.
export function unMemIsMap(m: i32): boolean {
  unMemPeelAliasWrapper(m) >= 0 && tyIsMapRow(unMemPeelAliasWrapper(m))
}

function tyIsMapRow(m: i32): boolean {
  if m < 0 { return false }
  const t = tyAt(m)
  if t is TyMap { return true }
  false
}

export function unMemPeelAliasWrapper(m: i32): i32 {
  if m < 0 { return m }
  const t = tyAt(m)
  if t is TyUnion {
    if t.uMembers.length == 1 { return t.uMembers[0] }
  }
  m
}

// An ARRAY-OF-MAP member (`{[string]: V}[]`). The name path's
// `!nameIsMapMemberUnion(elem)` guard is again free: a map-member-UNION element is a
// `TyUnion`, not a `TyMap`.
export function unMemIsMapArray(m: i32): boolean {
  if m < 0 { return false }
  const t = tyAt(m)
  if t is TyArray {
    if t.aElem < 0 { return false }
    const e = tyAt(t.aElem)
    if e is TyMap { return true }
  }
  false
}

// A ref-element array member — the structural dual of `markRefArrayArms`'s gate over a
// member's rendered spelling: a `TyArray` whose element does not ride a scalar-leaf list
// backing. Not the dual of `nameIsRefArray`, which is a strict subset (it also demands the
// element be nameable by the reflist layer) — see the refutation at `unionHasRefArrayArmSlot`.
export function unMemIsRefElemArray(m: i32): boolean {
  if m < 0 { return false }
  const t = tyAt(m)
  if t is TyArray {
    const e = t.aElem
    if e < 0 { return false }
    if tyIsI32LeafElem(e) { return false }
    if tyIsStrLeafElem(e) { return false }
    const et = tyAt(e)
    if et is TyPrim {
      // Exhaustive over `PrimName` and `_`-less: the four scalar-list leaves are not
      // ref-element arrays; `true` (below) is the real answer for the rest.
      match et.primName {
        "f64" => {
          return false
        }
        "i64" => {
          return false
        }
        "f32" => {
          // A packed byte list is not a ref-element array either — without the `u8` arm below,
          // `u8[]` fell through to `true` and took a reflist wrapper over its `$bl8` rep (#1805).
          return false
        }
        "u8" => {
          return false
        }
        "v128" => {
          // A v128 element is a scalar, not a ref element (no v128[] in S1-S2).
          return false
        }
        "null" => {
          // `null[]` rides the `(boolean | null)[]` i32 list (D4671), no ref element.
          return false
        }
        "i32" | "boolean" | "string" | "void" | "never" => {
          // A ref-element leaf; the `true` below stands.
        }
      }
    }
    return true
  }
  false
}
