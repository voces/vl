// `emit_rep.vl` — `repOf`: the unified wasm-REP descriptor, derived STRUCTURALLY
// from the checker's `Ty` arena (ROADMAP "repOf unification").
//
// WHY THIS MODULE EXISTS. The emitter historically enumerates the same wasm rep
// families in FIVE parallel schemes that must agree by convention: the `VKind`
// string union (emit_state.vl), raw numeric codes 0–21 (still live in struct FIELD
// codes), single-char `$fnsig` tokens (`cloParamTok` / `cloRetKeySuffix` encode,
// `sigKeyRetKind` decodes straight to a `VKind`), the per-function stored
// inferred-return kind (`fRetKind`), and side enums (`MfKind`/`BtKind`/`PushKind`).
// Every translation ladder between them is a place a new rep can be missed — each
// wave-4 rep bug was one enumeration arm that had drifted from its twins. `repOf`
// is the strangler replacement: ONE descriptor, derived ONCE from the checked
// type, that every scheme becomes a projection of. Consumers migrate site by site,
// each migration gated by the fixpoint + corpus byte-compare + the rep fuzzer; the
// old schemes then become delegation shims and finally die.
//
// COVERAGE DISCIPLINE (`rdCovered`). The derivation is deliberately PARTIAL: an
// arm is marked covered only where the arena structure decides the rep exactly
// as the emitter's name-based classifier ladder does today. Everything else —
// shapes whose rep still depends on emitter interning gates (typed-value maps,
// union-element lists, nested arrays, nullable lists beyond `i32[] | null`) —
// returns `rdCovered == 0`, and the consumer keeps its legacy path. This is the
// consult-the-checker-first / fall-back-syntactic pattern the typed-IR sidecar
// (`nodeTy*`) established; coverage widens arm by arm, never by a blanket claim.
//
// SLOTS. `rdSlot` carries a rep's interned STRUCT-table slot. The arena
// derivation resolves it for a DECLARED-struct object type via `repSlotOfTy`
// (keyed on the checker's memoized arena index, so nominal twins stay distinct —
// see the note there); it stays -1 for inline shapes, variants, ref-list and map
// reps, whose slots remain name-keyed at the consumer in emit_classify
// (`structIndexByName` / `rlSlotByName` / `mvValName`). No consumer reads `rdSlot`
// yet; the canonical structural key (`repCanonKey`) that makes it cycle-safe is
// just below.
//
// CYCLES. Recursive structural types are REAL arena cycles: in `type Tree = {kids:
// Tree[]}` the field's `TyArray.aElem` points back at the enclosing `TyObj`. The
// KIND arms below never recurse more than one wrapper deep (an array classifies by
// its element's variant, never by the element's own descriptor), so they cannot
// loop; the TRANSITIVE queries (`repTyScalarMask`) walk the full graph and
// terminate via a generation-stamped visited mark per arena index.

import { i32ToStr } from "./ast"
import { nameIsShapeSpanEnds } from "./emit_base"
import {
  annGenAppSpanEnds,
  nameStripSpaces,
  peelGroupParens,
  splitUnionAtoms,
} from "./tyname"
import {
  VKind,
  msAtomIds,
  msAtomTexts,
  msGen,
  msRowChain,
  msSetByText,
  msSetGen,
  msSetMask,
  msSetMiss,
  msSetNext,
  msSetRow,
  msSetText,
  mvKeyI32,
  mvValArmSig,
  mvValName,
  mvValTyIx,
  sFieldCount,
  sFieldElemKeyI32,
  sFieldElemName,
  sFieldElemTyIx,
  sFieldStart,
  sFieldTypes,
  sNames,
  sRowDecl,
  sTwin,
  sTyIx,
  uFieldElemKeyI32,
  uFieldElemName,
  uFieldElemTyIx,
  uVariants,
  unMemAtomIds,
  unMemAtoms,
  unMemKinds,
  unMemTyCount,
  unMemTyStart,
  unMemTys,
  unNames,
  vbF32Idx,
  vbF32Used,
  vbF64Idx,
  vbF64Used,
  vbI32Idx,
  vbI32Used,
  vbI64Idx,
  vbI64Used,
} from "./emit_state"
import {
  PrimName,
  T,
  TY_I32,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  cUserTypes,
  cUserTypesVer,
  litBaseTy,
  mapKeyRepTy,
  nodeRepTyIxOf,
  nodeTyIsUnionAlias,
  nodeTyIxOf,
  numLitUnionBaseTy,
  primNameStr,
  primTyOfName,
  resolveAnnot,
  tyIsLitUnion,
  tyIsNullableLitUnion,
  tyIsValueUnionBox,
  tyIxIsVariantMember,
  tyLitUnionAliasIx,
  tyMutEpoch,
  valueAtomKind,
} from "./typecheck"
import { sidOf } from "./symbols"

// ── The descriptor ────────────────────────────────────────────────────────────
// One struct per classified type. `rdCovered` is 1 when the rep was structurally derived
// from the arena and 0 when the arena does not decide this shape yet — at 0 the consumer
// MUST use its legacy path. `rdKind` is the `VKind` member; the valtype byte and heap index
// follow from `fbValtype(rdKind, rdSlot)`, the one declarative kind-to-byte table, which the
// descriptor deliberately does not duplicate. `rdNul` says how the rep encodes `null`: 0
// not nullable, 1 nullable ref, 2 the `boolean | null` i32 sentinel, 3 the litunion atom
// sentinel, 4 boxed as a member atom tag in the value-union box. `rdSlot` is the interned
// table slot where the consumer resolved one, and stays -1 at the arena level (see SLOTS
// above). `rdSigTok` is the canonical `$fnsig` token character, "" when the kind has no
// token in the value-call ABI, with slot-carrying tokens appending the slot at the encode
// site. `rdListElem` names the ELEMENT's rep vocabulary for the list kinds, else "".
export type RepDesc = {
  rdCovered: i32,
  rdKind: VKind,
  rdNul: i32,
  rdSlot: i32,
  rdSigTok: string,
  rdListElem: string,
}

// The canonical kind→`$fnsig` token character — scheme 3's single source, read
// by BOTH encode sites (`cloParamTok` params, `cloRetKeySuffix` results). The
// PARAM and RESULT eligibility sets stay at those sites: they encode which
// kinds may CROSS the value-call ABI at each position, not what the token
// character is. "" = the kind has no token (maps, the nullable niches without
// result tokens, the scalar lists not yet in the ABI). Accepts the nullable
// kind the closure-result classifier yields (`null` = void/no kind → "").
export function repSigTokOfKind(kind: VKind | null): string {
  if kind == "i32" { return "i" }
  if kind == "i64" { return "I" }
  if kind == "f64" { return "d" }
  if kind == "f32" { return "f" }
  if kind == "str" { return "S" }
  if kind == "list" { return "a" }
  if kind == "strlist" { return "A" }
  if kind == "f64list" { return "D" }
  if kind == "i64list" { return "L" }
  if kind == "f32list" { return "F" }
  // `u8[]` — the packed byte list. `B` for bytes; the letter is free and the kind is
  // slot-free like the other scalar lists, so it needs no `repSigTokHasSlot` arm.
  if kind == "u8list" { return "B" }
  if kind == "union" { return "u" }
  if kind == "nulstr" { return "N" }
  if kind == "closure" { return "c" }
  // A NULLABLE closure result — `((i32) => T) | null` (kind 19): the shared closure
  // fat-pointer made nullable (`(ref null $cloStruct)`, slot-free like `c`/`N`). A
  // RESULT-only token (the closure-result ABI); `cloParamTok` rejects a nullable-closure
  // PARAM explicitly (like map/nulstr/nulstruct), so `C` appears only in the `>` result spine.
  if kind == "nulclosure" { return "C" }
  if kind == "struct" { return "s" }
  if kind == "nulstruct" { return "n" }
  if kind == "variant" { return "V" }
  if kind == "reflist" { return "r" }
  // A string-keyed MAP — a RESULT-only token (the closure result ABI); it carries the map
  // SHAPE slot at the encode site (`cloRetKeySuffix`, like `s`/`r`). Map PARAMS stay outside
  // the ABI (`cloParamTok` rejects them), so the token appears only in the `>` result spine.
  if kind == "map" { return "m" }
  // A NULLABLE i32-backed list result — `boolean[] | null`, `i32[] | null`, `K0[] | null`
  // (kind 15): the shared i32-list wrapper made nullable (`(ref null $lTypeIdx)`,
  // slot-free like `N`/`C`). A RESULT-only token; `cloParamTok` rejects a nullable-list
  // PARAM explicitly, so `o` appears only in the `>` result spine. The distinct-backing
  // nullable lists (`i64[] | null`, …) stay outside the ABI (no token — a loud reject).
  if kind == "nullist" { return "o" }
  ""
}

// True when a kind's `$fnsig` token carries a `;`-terminated decimal SLOT (the
// interned struct / variant / ref-list / map-shape index) — the third leg of
// the token scheme, read by BOTH sides: the encoders mint the digits
// (`repSigSlotTokOfKind`) and every decoder that walks or tails a key skips /
// parses them through this ONE predicate (`sigKeyRetSlot`, `sigParamCoerceKind`,
// `emitSynthCloSig`). A slot-carrying kind can no longer be added to the
// encoder without every parser agreeing on its shape.
export function repSigTokHasSlot(kind: VKind | null): boolean {
  kind == "struct" ||
    kind == "nulstruct" ||
    kind == "variant" ||
    kind == "reflist" ||
    kind == "map"
}

// Mint a SLOT-CARRYING `$fnsig` token: the kind's token char followed by the `;`-terminated
// decimal slot (`s3;`, `r0;`, `m2;`). The ONE place token digits are assembled, so the
// producers never hand-append `i32ToStr(slot) + ";"`.
//
// SIG-SPACE CANONICALIZATION: a STRUCT / NULLABLE-STRUCT slot digit renders its
// `sTwin`-canonical representative (`repStructSlotRep`), not the raw row. Two spelling-twin
// struct rows already emit identical functypes, because `fbValtype` reads `sHeapIdx` and
// that collapses twins — but their RAW digits made the three `$fnsig` producers key one
// shape under DIFFERENT sig keys. Rendering the canonical rep makes the sig KEY
// twin-invariant, so whichever row a resolver lands on the interned functype key is the
// same. The rep is computed TIMING-INDEPENDENTLY, from `slotCanonId` and never the `sTwin[]`
// array `buildStructTwins` fills after `collectCloSigs`. Other slot kinds pass through.
export function repSigSlotTokOfKind(kind: VKind | null, slot: i32): string {
  let s = slot
  if kind == "struct" || kind == "nulstruct" { s = repStructSlotRep(slot) }
  repSigTokOfKind(kind) + i32ToStr(s) + ";"
}

// The INVERSE projection — a `$fnsig` token character (an i32 code point) back
// to its `VKind`, or `null` for a character outside the vocabulary. `'v'`
// (void) is deliberately NOT here: void is the absence of a result kind, and
// its decoder tests it before consulting the vocabulary. Together with
// `repSigTokOfKind` this pair IS the token scheme — an encoder arm without its
// decoder twin (or vice versa) cannot exist.
export function repKindOfSigTok(c: i32): VKind | null {
  if c == 'i' { return "i32" }
  if c == 'I' { return "i64" }
  if c == 'd' { return "f64" }
  if c == 'f' { return "f32" }
  if c == 'S' { return "str" }
  if c == 'a' { return "list" }
  if c == 'A' { return "strlist" }
  if c == 'D' { return "f64list" }
  if c == 'L' { return "i64list" }
  if c == 'F' { return "f32list" }
  if c == 'B' { return "u8list" }
  if c == 'u' { return "union" }
  if c == 'N' { return "nulstr" }
  if c == 'c' { return "closure" }
  if c == 'C' { return "nulclosure" }
  if c == 's' { return "struct" }
  if c == 'n' { return "nulstruct" }
  if c == 'V' { return "variant" }
  if c == 'r' { return "reflist" }
  if c == 'm' { return "map" }
  if c == 'o' { return "nullist" }
  null
}

// An uncovered descriptor — the consumer must take its legacy path. `rdKind`
// deliberately carries the ladder's own default ("i32") so a consumer that
// forgets the `rdCovered` check degrades to the same fallthrough the legacy
// chain has, never to a bogus ref kind.
function repUncovered(): RepDesc {
  const d: RepDesc = {
    rdCovered: 0,
    rdKind: "i32",
    rdNul: 0,
    rdSlot: -1,
    rdSigTok: "",
    rdListElem: "",
  }
  return d
}

function repMk(kind: VKind, nul: i32, elem: string): RepDesc {
  const d: RepDesc = {
    rdCovered: 1,
    rdKind: kind,
    rdNul: nul,
    rdSlot: -1,
    rdSigTok: repSigTokOfKind(kind),
    rdListElem: elem,
  }
  return d
}

// ── Canonical structural key (cycle-terminating) ─────────────────────────────
// A string identifying a type's STRUCTURE, walked in FULL so `{a:i32}` and `{a:i32,b:i32}`
// differ (unlike the descriptor arms, which classify at most one wrapper deep). Recursive
// arena cycles terminate via a visited STACK: re-entering a type already being expanded
// emits a RELATIVE back-edge `#<k>`, k the stack distance to the enclosing occurrence — a
// de Bruijn index — so two isomorphic cyclic types render the same key regardless of their
// per-compile arena indices. Two structurally-identical types share a key and two distinct
// ones never collide. A leaf variant the emitter does not narrow (`TyVar`/`TyLit`/`TyErr`)
// is keyed by its arena index (`@N`): distinctness is preserved, never a false merge, while
// isomorphism across such leaves is not — the slot resolver only consults DECLARED-struct
// keys, where these do not arise.
const repKeyStack: i32[] = []

// ── The repCanonKey memo (generation-stamped) ────────────────────────────────
// The full recursive string build above made `repCanonKey` the hottest compile path: every
// `repSlotOfTy` query re-rendered every declared struct's key. The memo is per arena index
// ("" = unfilled — every real key is non-empty: a prim name, a bracketed shape, or `@N`/`!`),
// stamped with the checker's `tyMutEpoch`; ANY in-place arena mutation advances that epoch
// and the whole memo drops — conservative, since one pinned hole can change every key that
// reaches it. Consulted and written at TOP-LEVEL calls only (`repKeyStack` empty): an
// INTERIOR key fragment is context-dependent, because a de Bruijn back-edge `#k` in it
// counts stack distance into the ENCLOSING walk, so only a root's key is a self-contained
// string that can be reused verbatim. Interior recursion inside one computation stays
// fresh, so a computed key matches the unmemoized render exactly.
let repKeyMemo: string[] = []
let repKeyMemoEpoch = -1

function repKeyMemoSync() {
  if repKeyMemoEpoch != tyMutEpoch {
    repKeyMemo = []
    // The identity twin's memo shares this generation exactly — one sync, two columns,
    // so the two can never disagree about which generation they are in.
    hcCanonMemo = []
    repKeyMemoEpoch = tyMutEpoch
  }
  0
}

// D611: THE NUMERIC-LITERAL-UNION SOFTEN FOR A STRUCT FIELD, applied on both canon-key walks
// so the id and the string stay one answer. `type N = 1 | 2` and `i32` are ONE emitted field;
// `numLitUnionBaseTy` is the checker's own `softenLitTy` rule and claims a type only when
// every member is a literal over the SAME base. IT IS CANON'S RULE, NOT A NEW EQUIVALENCE,
// which is why it belongs in the key rather than at one mint site: canon rewrites an
// ANNOTATION `{r: N}` to `{r:i32}` and banks that spelling's type, while a DECLARED
// `type Box1 = {r: N}` records the pre-canon entry canon never revisits — so one shape
// reached `buildStructTwins` under two arena types and got two heap types. THE FIELD POSITION
// ONLY, and that bound is graded: softening at every position LOSES cells that run today,
// because outside a field a numeric literal union is not the same interned row as its base.
// The STRING base is excluded and must be — softening an atom field would fuse it onto a
// `string` field. Layout safety stays DOUBLE-GATED: `structFieldCodesEq` still has to agree.
function repCanonFieldTy(ty: i32): i32 {
  const nb = numLitUnionBaseTy(ty)
  if nb >= 0 { return nb }
  const sb = inlineLitUnionFieldBase(ty)
  if sb >= 0 { return sb }
  ty
}

// The `string` prim an INLINE string literal-union FIELD keys as, or -1
// (silent-class-inventory D1093) — the multi-member twin of `repCanonKeyGo`'s `TyLit` arm,
// which keys a BARE literal field as its base scalar for exactly this reason (D1031).
// THE TWO SPELLINGS EMIT ONE SLOT AND HAD TWO KEYS: an inline `k: "a" | "b"` field is not a
// registered alias, so the field-code ladder reads canon's softened render and codes it 3, a
// plain string ref — the same slot a `k: string` field takes — while `hcUnionId` still keyed
// a UNION. `variantStructHeapTwinAt` finds an arm's struct row through `repRowOfTyStruct`,
// which gates on this key, so an arm carrying such a field could never be recognised as its
// own row. THE ALIAS SPELLING IS EXCLUDED AND THAT IS THE WHOLE CARE: `k: K` over
// `type K = "a" | "b"` codes 0, an interned i32 ATOM, a genuinely different layout that must
// keep a different key — and `tyLitUnionAliasIx` is the same predicate the rep layer assigns
// that valtype with. COARSE ON PURPOSE: this is a REP key, guarded by `structFieldCodesEq`.
function inlineLitUnionFieldBase(ty: i32): i32 {
  if ty < 0 { return -1 }
  if !tyIsLitUnion(ty) { return -1 }
  if tyLitUnionAliasIx(ty) >= 0 { return -1 }
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length > 0 {
      const m0 = T.tys[t.uMembers[0]]
      if m0 is TyLit {
        const b = litBaseTy(m0)
        const bt = T.tys[b]
        if bt is TyPrim {
          if bt.primName == "string" { return b }
        }
      }
    }
  }
  -1
}

export function repCanonKey(ty: i32): string {
  if ty < 0 { return "!" }
  let si = repKeyStack.length - 1
  while si >= 0 {
    if repKeyStack[si] == ty { return "#" + i32ToStr(repKeyStack.length - si) }
    si = si - 1
  }
  const top = repKeyStack.length == 0
  if top {
    repKeyMemoSync()
    if ty < repKeyMemo.length {
      if repKeyMemo[ty] != "" { return repKeyMemo[ty] }
    }
  }
  repKeyStack.push(ty)
  let s = repCanonKeyGo(ty)
  repKeyStack.pop()
  // RUNAWAY CAP (same crash family as `repNameCanonId`'s): a render past any sane
  // structural-key size collapses to an ARENA-INDEX-unique sentinel — never equal to
  // another type's key, so it can only DECLINE a merge (loud fall-through), never
  // create one. Capped here (not per-arm) so one bound covers every composition arm.
  if s.length > 262144 { s = "@big:" + i32ToStr(ty) }
  if top {
    // `repCanonKeyGo` only READS the arena (no checker re-entry), so the epoch
    // synced above still holds — the write cannot stamp a stale key.
    while repKeyMemo.length <= ty { repKeyMemo.push("") }
    repKeyMemo[ty] = s
  }
  s
}

function repCanonKeyGo(ty: i32): string {
  const t = T.tys[ty]
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: the checker's match
  // exhaustiveness names any arena variant this key builder stops answering for,
  // so a 12th variant breaks the self-compile here instead of silently taking the
  // index sentinel — which never merges, and so never DEDUPS two spellings of one
  // type either. Deliberate leaves are spelled as empty arms carrying their reason.
  match t {
    TyPrim => {
      return t.primName
    }
    TyObj => {
      let s = "{"
      let i = 0
      while i < t.objFieldNames.length {
        s = s +
          t.objFieldNames[i] +
          ":" +
          repCanonKey(repCanonFieldTy(t.objFieldTypes[i])) +
          ","
        i = i + 1
      }
      return s + "}"
    }
    TyArray => {
      return repCanonKey(t.aElem) + "[]"
    }
    TyNullable => {
      return repCanonKey(t.nInner) + "?"
    }
    TyUnion => {
      // MIX-widening (the `mvCanonValName` / `rlInternName` discipline at the key layer): a
      // litunion member of a MIXED union — one with a non-null, non-litunion sibling — is
      // STRING-repped in the box, so its canonical key renders "string". Without this a
      // declared `{a: K0 | {w:i32} | {q:i64}}` and the inline spelling (interned under the
      // checker's string-softened render) keyed DIFFERENTLY, declined the struct-twin dedup,
      // and minted two structurally-equal but iso-recursively DISTINCT heap types, so the
      // declared-param call site's `(ref $T0)` mismatched the inline literal's twin: invalid
      // wasm. A PURE litunion (`K0`, `K0 | null`) keeps its structural render — the atom-i32
      // rep, NOT mergeable with `string`. Widened members dedup to one "string" render.
      // Layout safety stays double-gated: `structFieldCodesEq` still refuses a merge whose
      // emitted field codes differ.
      let mixHasOther = false
      let mi = 0
      while mi < t.uMembers.length {
        const mt = T.tys[t.uMembers[mi]]
        let mLit = tyIsLitUnion(t.uMembers[mi])
        if mt is TyLit { mLit = true }
        let mNull = false
        if mt is TyPrim {
          if mt.primName == "null" { mNull = true }
        }
        if !mLit && !mNull { mixHasOther = true }
        mi = mi + 1
      }
      let s = "("
      let emitted = 0
      let sawWideStr = false
      let i = 0
      while i < t.uMembers.length {
        let r = repCanonKey(t.uMembers[i])
        let skip = false
        if mixHasOther {
          let iLit = tyIsLitUnion(t.uMembers[i])
          const it = T.tys[t.uMembers[i]]
          if it is TyLit { iLit = true }
          if iLit { r = "string" }
          if r == "string" {
            if sawWideStr { skip = true }
            sawWideStr = true
          }
        }
        if !skip {
          if emitted > 0 { s = s + "|" }
          s = s + r
          emitted = emitted + 1
        }
        i = i + 1
      }
      return s + ")"
    }
    TyFunc => {
      let s = "("
      let i = 0
      while i < t.fnParamTypes.length {
        if i > 0 { s = s + "," }
        s = s + repCanonKey(t.fnParamTypes[i])
        i = i + 1
      }
      return s + ")=>" + repCanonKey(t.fnRet)
    }
    TyMap => {
      let s = "M"
      if t.mSet == 1 { s = "Se" }
      return s + "[" + repCanonKey(t.mKey) + ":" + repCanonKey(t.mVal) + "]"
    }
    TyNeg => {
      return "!" + repCanonKey(t.negTy)
    }
    TyVar => {
      // A generic type PARAMETER: no structural render exists before the
      // monomorphizer substitutes it, so it takes the index sentinel below.
    }
    TyLit => {
      // A BARE literal type keys as its BASE SCALAR, which is the rep it actually has
      // (silent-class-inventory D1031). The index sentinel this arm used to fall to is
      // unique per arena entry, and EVERY spelling of a literal is its own entry — so two
      // identically-spelled declared shapes keyed differently, `buildStructTwins` never
      // compared them, and the two rows each allocated a heap type for ONE checker type:
      // D280's soundness bug reached through the literal, with no union in the program. The
      // sentinel's own claim — "it can only DECLINE a merge, never invent one" — is true and
      // is not a safety argument here, since a declined merge between shapes the CHECKER
      // accepts for each other IS the miscompile. Keying as the base is what the field
      // already emits (a bare-literal field codes 3, a plain string slot) and what the
      // enclosing UNION arm always did. COARSE ON PURPOSE AND GUARDED: this is a REP key,
      // and every consumer pairs it with `structFieldCodesEq`.
      return repCanonKey(litBaseTy(t))
    }
    TyErr => {
      // The error/unknown hole — assignable both ways, so any structural render
      // would claim an equivalence it does not have; the index sentinel below.
    }
  }
  // The three empty arms above land here: not narrowable to a structural render,
  // so each keys by ARENA INDEX — unique per index, so it can only DECLINE a
  // merge (the loud direction), never invent one.
  "@" + i32ToStr(ty)
}

// ── repElemKey — the ref-list ELEMENT rep key (destringify D2) ────────────────
// A canonical key for a ref-list element's REPRESENTATION (its WasmGC wrapper-equivalence
// class), NOT its type: equal iff two elements ride ONE wrapper heap type / occupy ONE
// ref-list slot. The structural replacement for the string-surgery `rlCanonElemName`. It is
// NOT `repCanonKey`, which diverges from a slot key at BOTH ends. That key keeps `i32[]`,
// `boolean[]`, litunion `K[]` and `(boolean|null)[]` apart — correct as a TYPE key — yet
// all four ride one i32-list backing, so `repElemKey` FOLDS each shared-wrapper leaf list
// to one token. And it EXPANDS a declared struct to its field shape, collapsing declared
// twins, while the ref-list layer keeps them NOMINAL (distinct slots, deduped later via
// `rlTwin`); so `repElemKey` keys a DECLARED struct by its nominal slot and expands only an
// INLINE shape, whose arena index is minted fresh per spelling and would be unstable
// between intern and lookup. Everything else is structural, mirroring `rlCanonLitUnionAtoms`.
export function repElemKey(ty: i32): string {
  if ty < 0 { return "!" }
  let si = repElemKeyStack.length - 1
  while si >= 0 {
    if repElemKeyStack[si] == ty {
      return "#" + i32ToStr(repElemKeyStack.length - si)
    }
    si = si - 1
  }
  const top = repElemKeyStack.length == 0
  if top {
    repElemMemoSync()
    if ty < repElemMemo.length {
      if repElemMemo[ty] != "" { return repElemMemo[ty] }
    }
  }
  repElemKeyStack.push(ty)
  let s = repElemKeyGo(ty)
  repElemKeyStack.pop()
  if s.length > 262144 { s = "@big:" + i32ToStr(ty) }
  if top {
    // `repElemKeyGo` only READS (the arena, and the slot cache through
    // `repSlotOfTyDecl`), so the generations synced above still hold and the write
    // cannot stamp a stale key — `repKeyMemo`'s note, one cache over.
    while repElemMemo.length <= ty { repElemMemo.push("") }
    repElemMemo[ty] = s
  }
  s
}

// Cycle guard (de Bruijn back-edges), mirroring `repKeyStack` — a recursive type
// reaches `repElemKey` through a declared struct (keyed nominally, which already
// bottoms out) or, defensively, a union/map that could self-refer.
const repElemKeyStack: i32[] = []

// THE `repElemKey` MEMO — `repKeyMemo`'s twin, with one more generation to compare.
// `repCanonKeyGo` reads the ARENA ALONE, so its memo syncs on `tyMutEpoch`; this key's
// `TyObj` arm additionally asks `repSlotOfTyDecl`, whose answer belongs to the slot cache —
// so this memo syncs on exactly the TRIPLE `repSlotCacheSync` compares (`tyMutEpoch`,
// `cUserTypesVer`, `sNames.length`). Anything that can change a key changes one of the
// three, and stamping the same triple keeps the two caches from disagreeing about which
// generation they are in. TOP OF RECURSION ONLY, exactly as `repKeyMemo`, and not out of
// caution: the de Bruijn back-edge (`#n`) is a function of the caller's DEPTH, not of `ty`,
// so an INNER answer is not a pure function of its type and must never be banked. No
// generation conjunct has been shown load-bearing on any input tried; the triple is kept
// anyway, because the alternative is an unguarded cache resting on an emit-window invariant
// nobody has stated. This ships as a DESTRINGIFY result, not a speed one.
let repElemMemo: string[] = []
let repElemMemoEpoch = -1
let repElemMemoUserVer = -1
let repElemMemoLen = -1

function repElemMemoSync() {
  if (
    repElemMemoEpoch != tyMutEpoch ||
    repElemMemoUserVer != cUserTypesVer ||
    repElemMemoLen != sNames.length
  ) {
    repElemMemo = []
    hcElemMemo = [] // the identity twin's memo, on the same generation
    hcMvMemo = [] // the map-value twin's, on that same generation for the same reason
    repElemMemoEpoch = tyMutEpoch
    repElemMemoUserVer = cUserTypesVer
    repElemMemoLen = sNames.length
  }
  0
}

function repElemKeyGo(ty: i32): string {
  const t = T.tys[ty]
  // EXHAUSTIVE over `Ty` and deliberately `_`-less, for the same reason as
  // `repCanonKeyGo`: a 12th arena variant breaks the self-compile here rather
  // than silently taking the index sentinel and declining every slot merge.
  match t {
    TyArray => {
      // Top-level i32-backed leaf array (`i32[]`, `boolean[]`, litunion `K[]`,
      // `(boolean | null)[]`, `(K | null)[]` — `nameIsI32Array`) → the shared
      // i32-list wrapper. The `| null` niche rides INSIDE the elements (the outer
      // list ref is non-null), so a top-level-nullable list (`i32[] | null`, a
      // TyNullable) carries its `| null` OUTSIDE and is NOT this arm.
      if tyIsI32LeafElem(t.aElem) { return "$rlI32L" }
      // Top-level string-backed leaf array (`string[]`, `(string | null)[]` —
      // `nameIsStringArray`) → the shared string-list wrapper.
      if tyIsStrLeafElem(t.aElem) { return "$rlStrL" }
      // A nested ref array (`S[][]`, `(K0|i32)[][]`): recurse — the inner litunion
      // softening still applies, the inner struct stays nominal.
      return repElemKey(t.aElem) + "[]"
    }
    TyObj => {
      // A struct: the NOMINAL slot for a DECLARED one, a structural field expansion for an
      // INLINE shape — see the header (and `structural-twin-reflist-dedup.vl`).

      const ds = repSlotOfTyDecl(ty)
      if ds >= 0 { return "S" + i32ToStr(ds) }
      let s = "{"
      let i = 0
      while i < t.objFieldNames.length {
        s = s + t.objFieldNames[i] + ":" + repElemKey(t.objFieldTypes[i]) + ","
        i = i + 1
      }
      return s + "}"
    }
    TyPrim => {
      return t.primName
    }
    TyNullable => {
      return repElemKey(t.nInner) + "?"
    }
    TyUnion => {
      // Mirror `repCanonKeyGo`'s MIX-widening: a litunion member of a MIXED union
      // (one with a non-null, non-litunion sibling) is STRING-repped in the box, so
      // it keys "string" — the same niche guard `rlCanonLitUnionAtoms` applies.
      let mixHasOther = false
      let mi = 0
      while mi < t.uMembers.length {
        const mt = T.tys[t.uMembers[mi]]
        let mLit = tyIsLitUnion(t.uMembers[mi])
        if mt is TyLit { mLit = true }
        let mNull = false
        if mt is TyPrim {
          if mt.primName == "null" { mNull = true }
        }
        if !mLit && !mNull { mixHasOther = true }
        mi = mi + 1
      }
      let s = "("
      let emitted = 0
      let sawWideStr = false
      let i = 0
      while i < t.uMembers.length {
        let r = repElemKey(t.uMembers[i])
        let skip = false
        if mixHasOther {
          let iLit = tyIsLitUnion(t.uMembers[i])
          const it = T.tys[t.uMembers[i]]
          if it is TyLit { iLit = true }
          if iLit { r = "string" }
          if r == "string" {
            if sawWideStr { skip = true }
            sawWideStr = true
          }
        }
        if !skip {
          if emitted > 0 { s = s + "|" }
          s = s + r
          emitted = emitted + 1
        }
        i = i + 1
      }
      return s + ")"
    }
    TyFunc => {
      let s = "("
      let i = 0
      while i < t.fnParamTypes.length {
        if i > 0 { s = s + "," }
        s = s + repElemKey(t.fnParamTypes[i])
        i = i + 1
      }
      return s + ")=>" + repElemKey(t.fnRet)
    }
    TyMap => {
      let s = "M"
      if t.mSet == 1 { s = "Se" }
      return s + "[" + repElemKey(t.mKey) + ":" + repElemKey(t.mVal) + "]"
    }
    TyNeg => {
      return "!" + repElemKey(t.negTy)
    }
    TyVar => {
      // A generic type PARAMETER: no wrapper class before substitution.
    }
    TyLit => {
      // A bare literal type reached without its enclosing union — no wrapper of
      // its own; the softening above only applies to litunion MEMBERS.
    }
    TyErr => {
      // The error/unknown hole — it must never share a slot with anything.
    }
  }
  // The three empty arms above land here: keep them distinct by arena index
  // (never a false merge), matching `repCanonKeyGo`.
  "@" + i32ToStr(ty)
}

// True when element type `e` rides the i32-list backing as a LEAF — `i32`,
// `boolean`, a litunion (`K` / inline `"a"|"b"`), and their `| null` sentinel
// niches (`boolean | null`, `K | null`). The structural twin of `nameIsI32Array`'s
// element half (its base minus the trailing `[]`).
export function tyIsI32LeafElem(e: i32): boolean {
  if e < 0 { return false }
  const t = T.tys[e]
  if t is TyPrim {
    if t.primName == "i32" { return true }
    if t.primName == "boolean" { return true }
    return false
  }
  if tyIsLitUnion(e) { return true }
  if t is TyNullable {
    const it = T.tys[t.nInner]
    if it is TyPrim {
      if it.primName == "boolean" { return true }
    }
    if tyIsLitUnion(t.nInner) { return true }
  }
  false
}

// The string-leaf sibling of `tyIsI32LeafElem`: `string` and `string | null`
// (`nameIsStringArray`'s element half). A `string[]` element is already a
// nullable ref at wasm level, so the `| null` niche needs no new wrapper.
export function tyIsStrLeafElem(e: i32): boolean {
  if e < 0 { return false }
  const t = T.tys[e]
  if t is TyPrim {
    if t.primName == "string" { return true }
    return false
  }
  if t is TyNullable {
    const it = T.tys[t.nInner]
    if it is TyPrim {
      if it.primName == "string" { return true }
    }
  }
  false
}

// The name bridge for the ref-list layer (which is name-keyed): resolve a ref-list element
// NAME to its arena type (memoized per spelling by `resolveAnnot`), then compute its rep
// key. It asks `resolveAnnot` DIRECTLY rather than through `declTyIxOfName` — a graded
// exclusion: a `new` newtype's declared-name entry and the index the annotation grammar
// resolves to are two arena entries over one `Ty` whose rep keys differ HERE (mechanism in
// `declTyIxOfName`'s header). An unresolvable spelling keys on the name itself, nominally.
// `ty` is the caller's RECORDED arena type FOR THIS VERY NAME (D-REPELEMTY), -1 for none —
// and it must be that, not merely a type the name's POSITION has: the shipped hint sources
// are D5 sidecar cells recorded over the same string, so agreement is by CONSTRUCTION,
// while a NODE bank disagrees because `canonEmitTypeNames` rewrites `TypeRef.tyName` in
// place and leaves `nodeTyIx` on the pre-rewrite type. The `name == ""` early-out stays
// ABOVE the hint: an unnamed element has no row, so interner and resolver decline together.
export function repElemIdOfNameTy(name: string, ty: i32): i32 {
  if name == "" { return -1 }
  if ty >= 0 { return repElemId(ty) }
  if name.length > 4096 { return hcNameId(name) }
  const di = resolveAnnot(name, repNoTyparams)
  if di < 0 { return hcNameId(name) }
  repElemId(di)
}

// ── repMvValKey — the map-VALUE slot rep key ──────────────────────────────────
// A canonical key for a `{[string]: V}` VALUE type's mv-table slot identity: equal iff two
// value spellings intern ONE `mvValName` row. It is neither of the two keys above, and the
// difference is the point. NOT `repElemKey`, which FOLDS every shared-wrapper leaf list
// into one token because those elements ride one wrapper — the mv table does not, each leaf
// list value interning its OWN row, and folding here would hand a caller a row whose
// recorded NAME is a different spelling. NOT `repCanonKey`, which EXPANDS a declared struct
// to its field shape and so collapses declared twins, while `{[string]: A}` and
// `{[string]: B}` are distinct mv rows: nominal slot for a declared struct, structural
// expansion for an inline shape. Its one FOLD mirrors `mvCanonValName` — a litunion member
// of a MIXED union is STRING-repped in the box, so it keys "string". Strictness is the safe
// direction: a finer key makes the resolver DECLINE, a coarser one hands back another row's.
export function repMvValKey(ty: i32): string {
  if ty < 0 { return "!" }
  let si = repMvKeyStack.length - 1
  while si >= 0 {
    if repMvKeyStack[si] == ty {
      return "#" + i32ToStr(repMvKeyStack.length - si)
    }
    si = si - 1
  }
  repMvKeyStack.push(ty)
  let s = repMvValKeyGo(ty)
  repMvKeyStack.pop()
  if s.length > 262144 { s = "@big:" + i32ToStr(ty) }
  s
}

// Cycle guard (de Bruijn back-edges), mirroring `repElemKeyStack`.
const repMvKeyStack: i32[] = []

function repMvValKeyGo(ty: i32): string {
  const t = T.tys[ty]
  // No leaf-list fold: `i32[]` / `boolean[]` / `K[]` are DISTINCT mv rows.
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th arena variant breaks
  // the self-compile here rather than silently taking the index sentinel.
  match t {
    TyArray => {
      return repMvValKey(t.aElem) + "[]"
    }
    TyObj => {
      const ds = repSlotOfTyDecl(ty)
      if ds >= 0 { return "S" + i32ToStr(ds) }
      let s = "{"
      let i = 0
      while i < t.objFieldNames.length {
        s = s + t.objFieldNames[i] + ":" + repMvValKey(t.objFieldTypes[i]) + ","
        i = i + 1
      }
      return s + "}"
    }
    TyPrim => {
      return t.primName
    }
    TyNullable => {
      return repMvValKey(t.nInner) + "?"
    }
    TyUnion => {
      let mixHasOther = false
      let mi = 0
      while mi < t.uMembers.length {
        const mt = T.tys[t.uMembers[mi]]
        let mLit = tyIsLitUnion(t.uMembers[mi])
        if mt is TyLit { mLit = true }
        let mNull = false
        if mt is TyPrim {
          if mt.primName == "null" { mNull = true }
        }
        if !mLit && !mNull { mixHasOther = true }
        mi = mi + 1
      }
      let s = "("
      let emitted = 0
      let sawWideStr = false
      let i = 0
      while i < t.uMembers.length {
        let r = repMvValKey(t.uMembers[i])
        let skip = false
        if mixHasOther {
          let iLit = tyIsLitUnion(t.uMembers[i])
          const it = T.tys[t.uMembers[i]]
          if it is TyLit { iLit = true }
          if iLit { r = "string" }
          if r == "string" {
            if sawWideStr { skip = true }
            sawWideStr = true
          }
        }
        if !skip {
          if emitted > 0 { s = s + "|" }
          s = s + r
          emitted = emitted + 1
        }
        i = i + 1
      }
      return s + ")"
    }
    TyFunc => {
      let s = "("
      let i = 0
      while i < t.fnParamTypes.length {
        if i > 0 { s = s + "," }
        s = s + repMvValKey(t.fnParamTypes[i])
        i = i + 1
      }
      return s + ")=>" + repMvValKey(t.fnRet)
    }
    TyMap => {
      let s = "M"
      if t.mSet == 1 { s = "Se" }
      return s + "[" + repMvValKey(t.mKey) + ":" + repMvValKey(t.mVal) + "]"
    }
    TyNeg => {
      return "!" + repMvValKey(t.negTy)
    }
    TyVar => {
      // A generic type PARAMETER: no mv row before substitution.
    }
    TyLit => {
      // A bare literal type reached without its enclosing union — no mv row of
      // its own.
    }
    TyErr => {
      // The error/unknown hole — it must never share an mv row with anything.
    }
  }
  // The three empty arms above land here: keep them distinct by arena index
  // (never a false merge).
  "@" + i32ToStr(ty)
}

// Record the arena type of the map VALUE name JUST pushed onto `mvValName`. Pads
// with -1 so an intern site that does not call this self-heals to "uncovered".
//
// `rowTy` is the caller's own resolution of THIS spelling, on the
// `mvValTyIxOfNameRow` contract: the slot FIND that ran before the row was pushed
// resolved the same string, so the recorder reads that index instead of asking a second
// time. -1 is "no bank" — what the caller passes when its resolution and this one have
// different inputs, which for the single intern site means canon rewrote the spelling.
export function recordMvValTyIx(nm: string, rowTy: i32) {
  while mvValTyIx.length + 1 < mvValName.length { mvValTyIx.push(-1) }
  mvValTyIx.push(mvValTyIxOfNameRow(nm, rowTy))
  0
}

// The interned mv slot whose VALUE type is `ty`, or -1 when the arena does not
// claim one — the structural answer to the `mvValName[i] == valName` scans.
// First-match-wins, exactly like the name scans it fronts. Both sides compute the
// key at QUERY time from the recorded arena INDEX (never a key frozen at intern
// time), so an in-place arena mutation moves both together — the D1 hazard.
// The KEY half of an mv slot's identity: true when slot `slot`'s map struct carries the
// i32 keys list. THE ONE READ of the `mvKeyI32` column — the slot resolvers here, the
// `cm*` emit accessors and the type section all ask through it, so a slot is
// self-describing and nothing downstream of the intern carries a second key parameter.
// Lives in this module rather than beside its siblings in `emit_classify` because
// `emit_classify` imports FROM here: the lower module is the only place both can read.
export function mvSlotKeyI32(slot: i32): boolean {
  if slot < 0 { return false }
  if slot >= mvKeyI32.length { return false }
  mvKeyI32[slot] == 1
}

// THE ONE KEY QUESTION ASKED OF A MAP SHAPE, in the shape vocabulary every op site
// threads: the two MONO sentinels (`-4` map / `-5` Set — a value on the shared i32
// `vals` list interns no slot, so the key has nowhere else to live) plus an mv SLOT's
// own column. Both halves or neither: a site that tested `sh == -4` alone was correct
// only while an i32-keyed map's value was restricted to the mono rep.
export function mapShapeKeyI32(sh: i32): boolean {
  sh == -4 || sh == -5 || mvSlotKeyI32(sh)
}

// THE D1 HAZARD, RESTATED FOR THE MEMO. Both sides compute the key at QUERY time from the
// recorded arena INDEX, never a key frozen at intern time, so an in-place arena mutation
// moves both together. That is still true of the WALK and no longer the whole story of the
// CACHE: `repMvValId` banks a depth-0 answer per arena index, so between generation bumps
// the answer IS frozen. What discharges D1 is the generation triple it syncs on —
// `tyMutEpoch`, `cUserTypesVer`, `sNames.length` — and every in-place arena patch bumps
// `tyMutEpoch`. THE KEY-PAIRED FORM: a slot's identity is (key rep, value type), since the
// map struct's `keys` field differs between the two reps, so the scan must agree on BOTH
// halves or a `{[i32]: S}` would resolve its `{[string]: S}` twin's struct — invalid wasm
// `vl check` cannot see. The UN-HINTED two-argument form is gone rather than deprecated
// (D93): its callers all held the value's arena type, so the hint they were missing was a
// pure function of an argument they already had. `mvSlotOfTyKArm` below keeps the tri-state.

// ── THE ARM: THE THIRD COMPONENT OF AN mv SLOT'S IDENTITY (D48) ──────────────
// The pair (key rep, value type) is not the whole of a slot's identity, for the same reason
// the KEY had to be added: `{[string]: Circle}` where `Circle` is a declared union ARM and
// `{[string]: Dot}` over its exact layout twin have DIFFERENT vals element heaps, in two
// tables that never merge (`DECISIONS.md`: the variant-to-struct TABLE seam stays nominal),
// yet agree on both existing components. Every name the mv layer holds is a RENDER, and
// re-resolving it mints one shared anonymous arena index, so the value-TYPE component
// cannot see the difference either; the arm can, and is banked per slot
// (`mvValVariantIdx`, nominal by construction). THREE states, not a parity: `MV_ARM_NOHINT`
// matches any parity (today's behaviour byte for byte), -1 matches only a NON-arm slot —
// the state that stops a twin's mint finding the arm's slot — and `>= 0` only that arm's.
// A hint FILTERS the existing rungs and never adds a match, so the ladder below is intact.
export function mvSlotOfTyKArm(ty: i32, keyI32: boolean, armHint: i32): i32 {
  if ty < 0 { return -1 }
  // THE INTERNED ID, not a rebuilt spelling. Both sides of this comparison are ARENA
  // INDICES; master rendered each to a full structural STRING and compared the strings —
  // and did it inside the scan, so `repMvValKey` was re-run for every occupied row on every
  // query, overwhelmingly on types it had already keyed.
  //
  // The id form is the same move `repCanonKey` -> `repCanonId` and `repElemKey` ->
  // `repElemId` already made; this was the last string hash-cons key in the compiler whose
  // two sides are both arena types. It retires the STRING memo B16 built and declined — but
  // not memoisation as such. What the id buys is that a repeat is an i32 compare instead of
  // a rebuilt spelling; the depth-0 memo still exists, rides `repElemMemo`'s generation
  // triple, and is what stops the walk re-descending at all.
  const k = repMvValId(ty)
  let i = 0
  while i < mvValTyIx.length {
    if mvValTyIx[i] >= 0 {
      if mvSlotKeyI32(i) == keyI32 {
        if mvSlotArmMatches(i, armHint) {
          if repMvValId(mvValTyIx[i]) == k { return i }
        }
      }
    }
    i = i + 1
  }
  -1
}

// "No arm hint" — the caller holds no type to ask `variantRowOfTy` of, so it matches a
// slot of any arm parity. Distinct from -1, which is a RESOLVED "not an arm".
export const MV_ARM_NOHINT = 0 - 2

// Does mv slot `slot` satisfy the caller's arm hint? The read side of the tri-state
// above, bounds-guarded like every other parallel-table accessor (a slot whose column
// never resolved reads -1, i.e. "not an arm", which is what an uncovered row means).
export function mvSlotArmMatches(slot: i32, armHint: i32): boolean {
  if armHint == MV_ARM_NOHINT { return true }
  // THE SIGNATURE COLUMN, NOT THE VARIANT ONE (D93). The hint is a filter on the slot's
  // IDENTITY, and identity needs the wider question: two nested maps whose inner values
  // are an arm and its exact layout twin have the same variant column (-1 and -1, neither
  // value being an arm) and different signatures. On every kind-1 slot the two columns
  // agree by construction, so nothing an arm-valued map resolves today moves.
  let sv = 0 - 1
  if slot >= 0 && slot < mvValArmSig.length { sv = mvValArmSig[slot] }
  sv == armHint
}

// The VALUE type of a map type `ty`, or -1 when `ty` is not a `TyMap` — the
// structural form of `mapValNameOf(name)`, which slices the value text out of a
// rendered `{[K]: V}` spelling. One `TyMap` hop and no peeling: the name slicer
// declines a nullable / non-map spelling too, so both legs decline together and a
// consumer that feeds the answer to `mvSlotOfValTyK` gets the same -1 either way.
export function tyMapValOf(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyMap { return t.mVal }
  -1
}

// The KEY half of the same hop: true when the map type `ty` is i32-KEYED — the
// structural form of `nameIsI32KeyedMap(name)`, and the argument every arena-side
// `mvSlotOfValTyK` caller pairs with `tyMapValOf`. A non-map answers false, exactly as the
// name predicate does for a non-map spelling, so the two legs decline together.
export function tyMapKeyIsI32(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  // The key's HASH is `typecheck.mapKeyRepTy`'s answer, the same one the checker's gate
  // and `nodeTyMapKeyIsI32` project — a second structural test here would be a place the
  // two can drift about which map struct a newtype- or alias-keyed map takes.
  if t is TyMap { return mapKeyRepTy(t.mKey) == TY_I32 }
  false
}

// The name bridge for the mv layer (still name-keyed at its entry points): resolve a
// map-value NAME to its arena type, then to its (key-paired) slot. -1 when the name does
// not resolve or no row claims it — the caller keeps its name scan. There is no key-blind
// sibling: every caller holds a map whose key it can name, and a default of "string-keyed"
// is exactly the silent wrong answer the key column exists to prevent.
//
// D-MAPNODETY BUCKETED THE CALLS BY SITE, and that bucketing is the finding: most of the
// traffic arrives from a caller holding an annotation or expression NODE whose map type the
// checker banked at that very node (`nodeMapValTyIx` below is the read), and those sites
// route there instead. What is left here is the population that has only a spelling — a
// narrowed-arm map name, a union-arm atom, a `sNames` row — plus the FALL-THROUGH the
// routed sites keep for a node the checker did not cover.
export function mvSlotOfValNameTyK(nm: string, keyI32: boolean): i32 {
  mvSlotOfValNameTyKArm(nm, keyI32, MV_ARM_NOHINT)
}

// The arm-hinted form of the name bridge — the same resolution, filtered by the caller's
// arm state (see `mvSlotOfTyKArm`). The un-hinted entry point above is unchanged.
export function mvSlotOfValNameTyKArm(
  nm: string,
  keyI32: boolean,
  armHint: i32,
): i32 {
  mvSlotOfTyKArm(fieldElemTyIxOfName(nm), keyI32, armHint)
}

// The ARENA TYPE a map-value spelling denotes — the rung the bridge above sits on, and the
// one place a caller's OWN resolution of that spelling replaces it.
//
// `rowTy >= 0` REPLACES the bridge rather than fronting it, and that is the whole
// distinction this parameter carries (D-MVSLOTFIND). A hint that is a better ANSWER — a
// node's map type, a narrowing's arm type — may only be tried FIRST, because where it
// declines the name may still resolve. A hint that is the same INPUT deletes the resolution
// outright, and is ARENA-ORDER-NEUTRAL BY CONSTRUCTION: `resolveAnnot` memoizes per
// spelling and a positive entry is never invalidated, so a second ask could only return the
// index the first one minted. That is what licenses deleting a rung under a MINT, where a
// merely-better answer would skip it — and `repElemKeyGo`'s identity arm keys `TyVar` /
// `TyLit` / `TyErr` by arena INDEX, so mint ORDER is load-bearing. -1 keeps the bridge.
export function mvValTyIxOfNameRow(nm: string, rowTy: i32): i32 {
  if rowTy >= 0 { return rowTy }
  fieldElemTyIxOfName(nm)
}

// The (`| null`-peeled) `TyMap` arena index an annotation / expression NODE denotes, or -1
// — the NODE-side entry to the same `tyMapValOf` / `tyMapKeyIsI32` pair the sidecar legs
// (`rlElemMapValMvSlotAt`, `mvValInnerMvSlotAt`) read off their own columns.
//
// One `| null` wrapper is tolerated, exactly as `typecheck.nodeTyMapKeyIsI32` tolerates it
// and exactly as deep as the name side's `nulMapInnerName` strips, so a `{[K]: V} | null`
// annotation resolves the map its non-null twin does.
//
// -1 IS THE DECLINE AND IT IS LOAD-BEARING: an interior `TypeRef` (a map spelled inside a
// union member's struct field, or inside an `is` pattern) carries no `nodeTyIx` — coverage
// gap D-BAREMAP, witnessed by `tests/cases/maps/map-value-union-struct-map-field.vl`. Every
// consumer therefore keeps its name leg BELOW this one and reaches it on a decline.
export function nodeMapTyIx(nodeIx: i32): i32 {
  const ty = nodeTyIxOf(nodeIx)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable {
    const it = T.tys[t.nInner]
    if it is TyMap { return t.nInner }
    return -1
  }
  if t is TyMap { return ty }
  -1
}

// The map VALUE type a NODE's recorded map type carries, or -1 — the structural answer
// to `fieldElemTyIxOfName(mapValNameOf(<the node's spelling>))`, which slices `V` out of
// a rendered `{[K]: V}` and puts the slice back through the annotation grammar to
// recover a type the checker had already resolved AT THAT VERY NODE.
export function nodeMapValTyIx(nodeIx: i32): i32 {
  tyMapValOf(nodeMapTyIx(nodeIx))
}

// The interned STRUCT-table slot for an object type `ty`, derived from the arena alone, or
// -1 when none is claimed (the consumer keeps its nominal path). The struct table is keyed
// NOMINALLY: declared `type A = {v:i32}` and `type B = {v:i32}` occupy DISTINCT slots even
// though `repCanonKey` is identical, so the canonical key alone cannot reproduce nominal
// slot identity while the checker's MEMOIZED arena index can. This resolver therefore takes
// an EXACT arena-index match against a declared slot's memoized type first, else the UNIQUE
// declared slot whose structural key matches, else -1 — zero or MANY matches are left to
// the nominal path, never collapsed. Only DECLARED-struct slots participate; cycle-safe via
// `repCanonKey`. The scan is CACHED (`repSlotByDecl` / `repSlotKeySi` / `repSlotKeyN`) and
// KEYED ON THE STRUCTURAL IDENTITY, not the rendered key: `repCanonId` partitions exactly
// as `repCanonKey` does, asserted by `repShadowSweep` and sabotage-checked, so this is a
// change of REPRESENTATION with the partition held fixed and cannot move a byte.
let repSlotCacheEpoch = -1
let repSlotCacheUserVer = -1
let repSlotCacheLen = -1
let repSlotByDecl: i32[] = []
let repSlotKeySi: i32[] = []
let repSlotKeyN: i32[] = []
// The SMALLEST slot in each key's bucket (D100). `repSlotKeySi` records the LAST
// match, which is all a `n == 1` gate ever needed; the twin rung below reaches for a
// bucket of two or more and must name a DETERMINISTIC representative, which is the
// same "smallest twin" `repStructSlotRep` already defines.
let repSlotKeyFirst: i32[] = []

// Rebuilt whenever anything the scan reads can have changed: an arena mutation
// (`tyMutEpoch` — keys), a `cUserTypes` write (`cUserTypesVer` — which arena index a name
// resolves to, including `resolveAnnot` memoizing a NEW spelling mid-emit), or `sNames`
// growth (a slot interned mid-emit; `sNames` is push-only within a program, and the
// cross-program `sNames = []` reset always rides an `initChecker` epoch advance).
function repSlotCacheSync() {
  if (
    repSlotCacheEpoch == tyMutEpoch &&
    repSlotCacheUserVer == cUserTypesVer &&
    repSlotCacheLen == sNames.length
  ) {
    return 0
  }
  repSlotByDecl = []
  repSlotKeySi = []
  repSlotKeyN = []
  repSlotKeyFirst = []
  let si = 0
  while si < sNames.length {
    // THE ROW LAYER'S LAST NAME->TYPE RESOLUTION, RETIRED. This opened
    // `cUserTypes[sNames[si]] ?? -1`, which reads as "resolve this row's name" and decides
    // two separate things: IS the row declared, and WHICH arena type it is. Both are banked
    // now — declared-ness by `sRowDecl` at the mint (the name's own `cUserTypes` answer,
    // asked once), the type by the `sTyIx` sidecar — and the swap was graded exact on both
    // halves, against the resolution it replaces, before it was taken.
    //
    // THE COLUMN MUST BE RESET WITH `sNames`, and that is not decoration: the first version
    // omitted the reset and disagreed, and the mechanism I invented to explain it ("the
    // answer moves after the mint") was refuted by a direct probe — the bug was the missing
    // reset. Same hazard `structNameIxReset` and `structTyIxReset` carry, and the same fix.
    let di = -1
    if si < sRowDecl.length {
      if sRowDecl[si] == 1 {
        if si < sTyIx.length { di = sTyIx[si] }
      }
    }
    if di >= 0 {
      const dt = T.tys[di]
      if dt is TyObj {
        while repSlotByDecl.length <= di { repSlotByDecl.push(-1) }
        if repSlotByDecl[di] < 0 { repSlotByDecl[di] = si }
        const k = repCanonId(di)
        while repSlotKeySi.length <= k {
          repSlotKeySi.push(-1)
          repSlotKeyN.push(0)
          repSlotKeyFirst.push(-1)
        }
        repSlotKeySi[k] = si
        if repSlotKeyFirst[k] < 0 { repSlotKeyFirst[k] = si }
        repSlotKeyN[k] = repSlotKeyN[k] + 1
      }
    }
    si = si + 1
  }
  // Stamp AFTER the build: `repCanonKey` above only reads the arena, so the
  // generations compared at entry still hold for everything just recorded.
  repSlotCacheEpoch = tyMutEpoch
  repSlotCacheUserVer = cUserTypesVer
  repSlotCacheLen = sNames.length
  0
}

// The NOMINAL-IDENTITY leg of `repSlotOfTy` (rep-twin phase 1): the declared-struct
// slot whose `cUserTypes` arena index IS `ty`, or -1 — no structural bridge. Split
// out so `repSlotOfTy` layers the bridge on top of one shared nominal lookup. Phase 1
// consumed THIS leg alone in `retStructIndex` / `retNulRefIndex` (the BRIDGE leg's 2
// corpus divergences were `sTwin` layout twins whose slot digits feed `$fnsig`
// tokens — not byte-safe under phase 1's byte-identity gate, the #980 KEY-vs-ROW
// family). The sig-canon slice canonicalizes those digits
// (`repSigSlotTokOfKind`→`repStructSlotRep`), so a twin-slot shift now keys the SAME
// `$fnsig`; those resolvers upgraded to the full `repSlotOfTy` (bridge included).
function repSlotOfTyDecl(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if !(t is TyObj) { return -1 }
  repSlotCacheSync()
  // Nominal identity — the scan's `di == ty` early return.
  if ty < repSlotByDecl.length {
    if repSlotByDecl[ty] >= 0 { return repSlotByDecl[ty] }
  }
  -1
}

export function repSlotOfTy(ty: i32): i32 {
  // Nominal identity first — the shared leg above.
  const ds = repSlotOfTyDecl(ty)
  if ds >= 0 { return ds }
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if !(t is TyObj) { return -1 }
  // The structural→nominal bridge: the UNIQUE declared twin, else -1. (No slot
  // has the queried arena index here, so the count is exactly the scan's `n`.)
  const key = repCanonId(ty)
  if key < 0 || key >= repSlotKeyN.length { return -1 }
  if repSlotKeyN[key] == 1 { return repSlotKeySi[key] }
  // A UNIQUE HEAP TYPE, WHICH IS A WEAKER QUESTION THAN A UNIQUE ROW — and the difference
  // is the whole of silent-class-inventory D100. That row was filed as D39's CHANNEL case
  // (`Circle` and `Dot` are two equally valid readings of one field set), naming a
  // refutation it did not take: if the claimants are `repStructSlotsTwin` they are ONE
  // WasmGC heap type, so both answers emit the same module and "first row wins" is sound
  // with no channel at all. Probed at this rung on the filed witness, they are — what
  // declined was a uniqueness test stronger than soundness needs, not an ambiguity. THE
  // PREDICATE IS THE CONJUNCTION THE ROW NAMED, not `structFieldCodesEq` alone, taken
  // against the bucket's FIRST row: if every member is a twin of the smallest, then
  // `repStructSlotRep` of every member IS the smallest. GENUINE AMBIGUITY STILL DECLINES —
  // two rows sharing a canonical key but NOT a layout fail the guard and answer -1 — and
  // the caller gates on `variantIndexOf`, so the D63/D75 variant collapse stays unreachable.
  const fst = repSlotKeyFirst[key]
  if fst < 0 { return -1 }
  let si2 = 0
  while si2 < sNames.length {
    let d2 = -1
    if si2 < sRowDecl.length {
      if sRowDecl[si2] == 1 {
        if si2 < sTyIx.length { d2 = sTyIx[si2] }
      }
    }
    if d2 >= 0 {
      if repCanonId(d2) == key {
        if repStructSlotsTwin(fst, si2) == 0 { return -1 }
      }
    }
    si2 = si2 + 1
  }
  fst
}

// ── STRUCTURAL IDENTITY, HASH-CONSED — the rep key without a spelling ─────────
// `repCanonKey` / `repElemKey` RENDER a structural string from an arena type and every
// consumer uses it for ONE thing: equality, so the string REPRESENTS a structural identity
// rather than being one. These build the identity directly: every node interns
// `(tag, args…)` into a hash-consed table and returns its INDEX, so two structurally-equal
// types get the same i32 and no type spelling is ever composed. The recursion mirrors the
// string builders ARM FOR ARM — same mix-widening, same de Bruijn back-edge, same
// sentinels, same order — because the partition must be IDENTICAL, not merely similar.
// `hcLen` carries what the string builder's answer WOULD be in characters: it reproduces
// the runaway cap exactly and is a far tighter equivalence check than partition agreement,
// since a length matching at every node says the two recursions have the same SHAPE. Every
// live consumer keys on the id now; the string builders survive only in the shadow harness.
const HC_ERRTY = 0 // the `ty < 0` key, `"!"`
const HC_PRIM = 1
const HC_OBJ = 2
const HC_ARRAY = 3
const HC_NUL = 4
const HC_UNION = 5
const HC_FUNC = 6
const HC_MAP = 7
const HC_SET = 8
const HC_NEG = 9
const HC_BACK = 10 // de Bruijn back-edge, arg = depth
const HC_IDX = 11 // the arena-index sentinel `"@<ix>"` (TyVar / TyLit / TyErr)
const HC_BIG = 12 // the runaway cap `"@big:<ix>"`
const HC_SLOT = 13 // a DECLARED slot `"S<n>"` — elem and mv keys
const HC_RLI32 = 14 // `"$rlI32L"` — elem key only
const HC_RLSTR = 15 // `"$rlStrL"` — elem key only
const HC_NAME = 16 // the unresolvable-spelling key `"name:<nm>"`, arg = the name's sid
const HC_FIELDSET = 17 // a shape row's (field name sid, field code) multiset, name-sorted

let hcTag: i32[] = []
let hcArgStart: i32[] = []
let hcArgCount: i32[] = []
let hcArgs: i32[] = []
let hcHashV: i32[] = []
let hcLen: i32[] = []
let hcNext: i32[] = []
let hcBucket: i32[] = []
let hcMask = -1

// Reset the identity table. Called where `sidReset` is called and for the same reason:
// `HC_PRIM` and `HC_OBJ` carry `sidOf` ids for the primitive keyword and the field names,
// so an id minted against one program's symbol space means nothing against the next one's.
export function hcReset() {
  // EVERYTHING KEYED ON AN HC ID DIES WITH THE ID SPACE, and this is not a per-program
  // courtesy: `sidKeyedTablesReset` runs INSIDE the module-parse loop (driver.vl, "the
  // sharpest edge the carrier has"), so the space restarts mid-compile. The two ty->id
  // memos hold ids as VALUES and the slot cache holds them as INDICES; both would index
  // the previous space's rows. The slot cache is invalidated by stamp rather than
  // cleared, so its own sync stays the single place that rebuilds it.
  hcCanonMemo = []
  hcElemMemo = []
  hcMvMemo = []
  repSlotCacheEpoch = -1
  hcTag = []
  hcArgStart = []
  hcArgCount = []
  hcArgs = []
  hcHashV = []
  hcLen = []
  hcNext = []
  hcBucket = []
  hcMask = -1
  0
}

// The character count `i32ToStr` would produce — WITHOUT producing it. The whole point of
// `hcLen` is to know the rendered length without rendering, so asking `i32ToStr(n).length`
// here would defeat the exercise at the one place it is easiest to get wrong.
function hcDigits(n: i32): i32 {
  if n < 0 { return 1 + hcDigits(0 - n) }
  if n < 10 { return 1 }
  1 + hcDigits(n / 10)
}

// FNV-1a over the tag and the argument ids, with the offset basis reduced to fit an i32
// literal (the constant's VALUE is irrelevant to correctness — it only spreads buckets).
// Masked to 30 bits so the bucket index is non-negative without depending on how the host
// lowers a shifted sign bit.
function hcHash(tag: i32, args: i32[]): i32 {
  let h = 0x1c9dc5 ^ tag
  h = h * 16777619
  let i = 0
  while i < args.length {
    h = (h ^ args[i]) * 16777619
    i = i + 1
  }
  h & 0x3fffffff
}

function hcGrow() {
  let cap = 16
  while cap < hcTag.length * 2 { cap = cap * 2 }
  hcBucket = []
  let i = 0
  while i < cap {
    hcBucket.push(-1)
    i = i + 1
  }
  hcMask = cap - 1
  let id = 0
  while id < hcTag.length {
    const b = hcHashV[id] & hcMask
    hcNext[id] = hcBucket[b]
    hcBucket[b] = id
    id = id + 1
  }
  0
}

function hcIntern(tag: i32, args: i32[], len: i32): i32 {
  if hcMask < 0 { hcGrow() }
  const h = hcHash(tag, args)
  let b = hcBucket[h & hcMask]
  while b >= 0 {
    if hcHashV[b] == h && hcTag[b] == tag && hcArgCount[b] == args.length {
      let ok = true
      const st = hcArgStart[b]
      let i = 0
      while i < args.length {
        if hcArgs[st + i] != args[i] { ok = false }
        i = i + 1
      }
      if ok { return b }
    }
    b = hcNext[b]
  }
  const id = hcTag.length
  hcTag.push(tag)
  hcArgStart.push(hcArgs.length)
  hcArgCount.push(args.length)
  hcHashV.push(h)
  hcLen.push(len)
  hcNext.push(-1)
  let j = 0
  while j < args.length {
    hcArgs.push(args[j])
    j = j + 1
  }
  // Grow AFTER the push so the rebuild chains the new entry too; otherwise insert it.
  if hcTag.length * 4 > (hcMask + 1) * 3 {
    hcGrow()
  } else {
    const bi = h & hcMask
    hcNext[id] = hcBucket[bi]
    hcBucket[bi] = id
  }
  id
}

// The rendered length of id `i` — `hcLen`'s accessor, and the one place that knows the
// column is parallel to the id space.
export function hcLenOf(i: i32): i32 {
  if i < 0 || i >= hcLen.length { return -1 }
  hcLen[i]
}

const hcNoArgs: i32[] = []

// The `"name:<nm>"` key — a NAME-derived identity, not a structural one, minted where a
// spelling resolves to no type. It carries the name's sid rather than the spelling, so it
// is still the one place a name reaches this table and it can never collide with a
// structural key (its tag is its own).
function hcNameId(name: string): i32 {
  const a: i32[] = []
  a.push(sidOf(name))
  hcIntern(HC_NAME, a, 5 + name.length)
}

// The shape interner's FIELDSET key — the (field-name sid, field code) multiset a row is
// deduped by, canonically ordered by the caller. Interned here so the shape layer's
// identity shares one table with the rep layer's and can never collide with it: the tag
// is its own. No length is meaningful (nothing renders this key), so it carries 0.
export function hcShapeSetId(args: i32[]): i32 {
  hcIntern(HC_FIELDSET, args, 0)
}

function hcPrimId(name: string): i32 {
  const a: i32[] = []
  a.push(sidOf(name))
  hcIntern(HC_PRIM, a, name.length)
}

// The identity twin of `repCanonKey`. Same stack, same cap, same memo discipline — the
// memo is per arena index and top-of-recursion only, because the back-edge is a function
// of the caller's DEPTH rather than of `ty`.
let hcCanonMemo: i32[] = []
const hcCanonStack: i32[] = []

export function repCanonId(ty: i32): i32 {
  if ty < 0 { return hcIntern(HC_ERRTY, hcNoArgs, 1) }
  let si = hcCanonStack.length - 1
  while si >= 0 {
    if hcCanonStack[si] == ty {
      const d = hcCanonStack.length - si
      const a: i32[] = []
      a.push(d)
      return hcIntern(HC_BACK, a, 1 + hcDigits(d))
    }
    si = si - 1
  }
  const top = hcCanonStack.length == 0
  if top {
    repKeyMemoSync()
    if ty < hcCanonMemo.length {
      if hcCanonMemo[ty] >= 0 { return hcCanonMemo[ty] }
    }
  }
  hcCanonStack.push(ty)
  let r = repCanonIdGo(ty)
  hcCanonStack.pop()
  if hcLen[r] > 262144 {
    const a: i32[] = []
    a.push(ty)
    r = hcIntern(HC_BIG, a, 5 + hcDigits(ty))
  }
  if top {
    while hcCanonMemo.length <= ty { hcCanonMemo.push(-1) }
    hcCanonMemo[ty] = r
  }
  r
}

function repCanonIdGo(ty: i32): i32 {
  const t = T.tys[ty]
  match t {
    TyPrim => {
      return hcPrimId(t.primName)
    }
    TyObj => {
      // The key is the brace-wrapped concatenation of `name:child,` over the fields.
      // FIELD ORDER IS SORTED OUT OF IT: `{a: i32, b: string}` and `{b: string, a: i32}`
      // are THE SAME TYPE, and the checker already agrees — `assignable` takes one where
      // the other is asked for. Walking `objFieldNames` in DECLARATION order keyed the
      // twins differently, and `buildStructTwins` tests this id BEFORE `structFieldCodesEq`,
      // so the pair was never compared and each row allocated its own heap type: check-clean
      // invalid wasm. SORTING IS SAFE BY CONSTRUCTION rather than by measurement, the only
      // acceptable argument for touching this key — field NAMES are unique, so ordering the
      // (name-sid, child-id) pairs by sid is a BIJECTION on the field set, able to merge
      // twins and never to collide two distinct types. It is `shapeFieldSetIdOf`'s sort, on
      // the same sid column. `len` accumulates over the SORTED walk, so `hcIntern`'s size
      // hint describes the key it is actually given.
      const sortedSid: i32[] = []
      const sortedIx: i32[] = []
      let si2 = 0
      while si2 < t.objFieldNames.length {
        const sd = sidOf(t.objFieldNames[si2])
        let j2 = sortedSid.length
        sortedSid.push(sd)
        sortedIx.push(si2)
        while j2 > 0 {
          if sortedSid[j2 - 1] <= sd {
            j2 = 0
          } else {
            sortedSid[j2] = sortedSid[j2 - 1]
            sortedIx[j2] = sortedIx[j2 - 1]
            sortedSid[j2 - 1] = sd
            sortedIx[j2 - 1] = si2
            j2 = j2 - 1
          }
        }
        si2 = si2 + 1
      }
      const a: i32[] = []
      let len = 2
      let i = 0
      while i < sortedIx.length {
        const fx = sortedIx[i]
        const c = repCanonId(repCanonFieldTy(t.objFieldTypes[fx]))
        a.push(sortedSid[i])
        a.push(c)
        len = len + t.objFieldNames[fx].length + 1 + hcLen[c] + 1
        i = i + 1
      }
      return hcIntern(HC_OBJ, a, len)
    }
    TyArray => {
      const c = repCanonId(t.aElem)
      const a: i32[] = []
      a.push(c)
      return hcIntern(HC_ARRAY, a, hcLen[c] + 2)
    }
    TyNullable => {
      const c = repCanonId(t.nInner)
      const a: i32[] = []
      a.push(c)
      return hcIntern(HC_NUL, a, hcLen[c] + 1)
    }
    TyUnion => {
      return hcUnionId(t.uMembers, 0)
    }
    TyFunc => {
      // `"(" + join(",", params) + ")=>" + ret` — ONE for the open paren; the closer is
      // inside the `")=>"` added below, so starting at 2 double-counts it.
      const a: i32[] = []
      let len = 1
      let i = 0
      while i < t.fnParamTypes.length {
        if i > 0 { len = len + 1 }
        const c = repCanonId(t.fnParamTypes[i])
        a.push(c)
        len = len + hcLen[c]
        i = i + 1
      }
      const rc = repCanonId(t.fnRet)
      a.push(rc)
      len = len + 3 + hcLen[rc]
      return hcIntern(HC_FUNC, a, len)
    }
    TyMap => {
      const kc = repCanonId(t.mKey)
      const vc = repCanonId(t.mVal)
      const a: i32[] = []
      a.push(kc)
      a.push(vc)
      let head = 1
      let tag = HC_MAP
      if t.mSet == 1 {
        head = 2
        tag = HC_SET
      }
      return hcIntern(tag, a, head + 1 + hcLen[kc] + 1 + hcLen[vc] + 1)
    }
    TyNeg => {
      const c = repCanonId(t.negTy)
      const a: i32[] = []
      a.push(c)
      return hcIntern(HC_NEG, a, 1 + hcLen[c])
    }
    TyVar => {

    }
    TyLit => {
      // The identity twin of `repCanonKeyGo`'s literal arm — a BARE literal keys as its
      // BASE SCALAR, the rep it emits. The whole argument is there; the two are
      // dual-written, and a divergence is a merge one of them makes and the other does not.
      //
      // NOT carried into `repIdOfGo` (the ref-list ELEMENT / map-VALUE identities): those key
      // a different equivalence — which slot two spellings share — and no witness asks them
      // to merge a bare literal. Their arms stay the index sentinel.
      return repCanonId(litBaseTy(t))
    }
    TyErr => {

    }
  }
  const a: i32[] = []
  a.push(ty)
  hcIntern(HC_IDX, a, 1 + hcDigits(ty))
}

// The union arm, shared by both identities because the MIX-WIDENING rule is one rule
// written twice in the string builders and must not become three. `canon` selects which
// child identity to recurse with — the two differ only in that.
// `mode`: 0 = canon, 1 = ref-list ELEM, 2 = map-VALUE. The three id walks share this arm
// because the litunion-collapse it implements is identical in all three — only the RECURSION
// differs, and that is what `mode` picks.
function hcUnionId(mems: i32[], mode: i32): i32 {
  let mixHasOther = false
  let mi = 0
  while mi < mems.length {
    const mt = T.tys[mems[mi]]
    let mLit = tyIsLitUnion(mems[mi])
    if mt is TyLit { mLit = true }
    let mNull = false
    if mt is TyPrim {
      if mt.primName == "null" { mNull = true }
    }
    if !mLit && !mNull { mixHasOther = true }
    mi = mi + 1
  }
  const strId = hcPrimId("string")
  const a: i32[] = []
  let len = 2
  let emitted = 0
  let sawWideStr = false
  let i = 0
  while i < mems.length {
    let r = -1
    // EXPLICIT PER MODE, no catch-all. The elem walk used to be the `else`, so a mode this
    // function does not know — a future fourth, or a miscomputed `mvMode` — would silently mint
    // ELEM ids inside an mv union: a wrong slot with no diagnostic. That is the failure policy
    // `repElemIdGo`'s own match rejects a few lines on ("deliberately `_`-less: a 12th arena
    // variant breaks the self-compile here rather than silently taking the index sentinel").
    if mode == 0 {
      r = repCanonId(mems[i])
    } else if mode == 1 {
      r = repElemId(mems[i])
    } else if mode == 2 {
      r = repMvValId(mems[i])
    } else {
      // Unreachable: those three are the only modes minted, at the three entry points. Keyed by
      // ARENA INDEX so an impossible mode can only ever SPLIT, never merge two distinct types.
      const bad: i32[] = []
      bad.push(mems[i])
      r = hcIntern(HC_IDX, bad, 1 + hcDigits(mems[i]))
    }
    let skip = false
    if mixHasOther {
      let iLit = tyIsLitUnion(mems[i])
      const it = T.tys[mems[i]]
      if it is TyLit { iLit = true }
      if iLit { r = strId }
      if r == strId {
        if sawWideStr { skip = true }
        sawWideStr = true
      }
    }
    if !skip {
      if emitted > 0 { len = len + 1 }
      a.push(r)
      len = len + hcLen[r]
      emitted = emitted + 1
    }
    i = i + 1
  }
  hcIntern(HC_UNION, a, len)
}

// The identity twin of `repElemKey`. Its memo carries the same triple as `repElemMemo`.
let hcElemMemo: i32[] = []
const hcElemStack: i32[] = []

export function repElemId(ty: i32): i32 {
  if ty < 0 { return hcIntern(HC_ERRTY, hcNoArgs, 1) }
  let si = hcElemStack.length - 1
  while si >= 0 {
    if hcElemStack[si] == ty {
      const d = hcElemStack.length - si
      const a: i32[] = []
      a.push(d)
      return hcIntern(HC_BACK, a, 1 + hcDigits(d))
    }
    si = si - 1
  }
  const top = hcElemStack.length == 0
  if top {
    repElemMemoSync()
    if ty < hcElemMemo.length {
      if hcElemMemo[ty] >= 0 { return hcElemMemo[ty] }
    }
  }
  hcElemStack.push(ty)
  let r = repElemIdGo(ty, false)
  hcElemStack.pop()
  if hcLen[r] > 262144 {
    const a: i32[] = []
    a.push(ty)
    r = hcIntern(HC_BIG, a, 5 + hcDigits(ty))
  }
  if top {
    while hcElemMemo.length <= ty { hcElemMemo.push(-1) }
    hcElemMemo[ty] = r
  }
  r
}

// The mode dispatch for the shared walk's recursion. Each entry point owns its own cycle stack
// and its own depth-0 memo, so a nested call has to re-enter through the RIGHT one — recursing
// straight into `repElemIdGo` would share `repElemId`'s stack with an mv walk and let a cycle in
// one be reported as a back-edge in the other.
function repIdOf(ty: i32, mv: boolean): i32 {
  if mv { return repMvValId(ty) }
  repElemId(ty)
}

// The identity twin of `repMvValKey` — the MAP-VALUE slot key as an interned id. Its memo
// carries the same triple as `repElemMemo` because it shares that walk's `repSlotOfTyDecl` read,
// which is SID-KEYED: `sidKeyedTablesReset` runs INSIDE the module-parse loop, so a memo that did
// not ride the same generation would answer out of the previous space's rows.
let hcMvMemo: i32[] = []
const hcMvStack: i32[] = []

function repMvValId(ty: i32): i32 {
  if ty < 0 { return hcIntern(HC_ERRTY, hcNoArgs, 1) }
  let si = hcMvStack.length - 1
  while si >= 0 {
    if hcMvStack[si] == ty {
      const d = hcMvStack.length - si
      const a: i32[] = []
      a.push(d)
      return hcIntern(HC_BACK, a, 1 + hcDigits(d))
    }
    si = si - 1
  }
  const top = hcMvStack.length == 0
  if top {
    repElemMemoSync()
    if ty < hcMvMemo.length {
      if hcMvMemo[ty] >= 0 { return hcMvMemo[ty] }
    }
  }
  hcMvStack.push(ty)
  let r = repElemIdGo(ty, true)
  hcMvStack.pop()
  if hcLen[r] > 262144 {
    const a: i32[] = []
    a.push(ty)
    r = hcIntern(HC_BIG, a, 5 + hcDigits(ty))
  }
  if top {
    while hcMvMemo.length <= ty { hcMvMemo.push(-1) }
    hcMvMemo[ty] = r
  }
  r
}

// The MAP-VALUE id is this same walk with the ref-list leaf folds switched OFF, which is the
// only place the two structural keys ever differed (`repMvValKey`'s header: "No leaf-list fold:
// `i32[]` / `boolean[]` / `K[]` are DISTINCT mv rows"). Shared rather than copied so the two
// cannot drift arm for arm — the property `repElemKey`/`repCanonKey` state about each other and
// which a hand-written third copy would have quietly given up.
function repElemIdGo(ty: i32, mv: boolean): i32 {
  let mvMode = 1
  if mv { mvMode = 2 }
  const t = T.tys[ty]
  match t {
    TyArray => {
      // THE ONE DIVERGENCE between the two walks. The ref-list elem key folds an i32/string
      // LEAF array to a single shared row; the map-value key must not, because `i32[]`,
      // `boolean[]` and `K[]` are distinct mv rows and folding them would make a `{[K]: i32[]}`
      // resolve a `{[K]: boolean[]}`'s slot.
      if !mv {
        if tyIsI32LeafElem(t.aElem) { return hcIntern(HC_RLI32, hcNoArgs, 7) }
        if tyIsStrLeafElem(t.aElem) { return hcIntern(HC_RLSTR, hcNoArgs, 7) }
      }
      const c = repIdOf(t.aElem, mv)
      const a: i32[] = []
      a.push(c)
      return hcIntern(HC_ARRAY, a, hcLen[c] + 2)
    }
    TyObj => {
      const ds = repSlotOfTyDecl(ty)
      if ds >= 0 {
        const a: i32[] = []
        a.push(ds)
        return hcIntern(HC_SLOT, a, 1 + hcDigits(ds))
      }
      const a2: i32[] = []
      let len = 2
      let i = 0
      while i < t.objFieldNames.length {
        const c = repIdOf(t.objFieldTypes[i], mv)
        a2.push(sidOf(t.objFieldNames[i]))
        a2.push(c)
        len = len + t.objFieldNames[i].length + 1 + hcLen[c] + 1
        i = i + 1
      }
      return hcIntern(HC_OBJ, a2, len)
    }
    TyPrim => {
      return hcPrimId(t.primName)
    }
    TyNullable => {
      const c = repIdOf(t.nInner, mv)
      const a: i32[] = []
      a.push(c)
      return hcIntern(HC_NUL, a, hcLen[c] + 1)
    }
    TyUnion => {
      return hcUnionId(t.uMembers, mvMode)
    }
    TyFunc => {
      // See the canon twin: 1 for the open paren, the closer rides in `")=>"`.
      const a: i32[] = []
      let len = 1
      let i = 0
      while i < t.fnParamTypes.length {
        if i > 0 { len = len + 1 }
        const c = repIdOf(t.fnParamTypes[i], mv)
        a.push(c)
        len = len + hcLen[c]
        i = i + 1
      }
      const rc = repIdOf(t.fnRet, mv)
      a.push(rc)
      len = len + 3 + hcLen[rc]
      return hcIntern(HC_FUNC, a, len)
    }
    TyMap => {
      const kc = repIdOf(t.mKey, mv)
      const vc = repIdOf(t.mVal, mv)
      const a: i32[] = []
      a.push(kc)
      a.push(vc)
      let head = 1
      let tag = HC_MAP
      if t.mSet == 1 {
        head = 2
        tag = HC_SET
      }
      return hcIntern(tag, a, head + 1 + hcLen[kc] + 1 + hcLen[vc] + 1)
    }
    TyNeg => {
      const c = repIdOf(t.negTy, mv)
      const a: i32[] = []
      a.push(c)
      return hcIntern(HC_NEG, a, 1 + hcLen[c])
    }
    TyVar => {

    }
    TyLit => {

    }
    TyErr => {

    }
  }
  const a: i32[] = []
  a.push(ty)
  hcIntern(HC_IDX, a, 1 + hcDigits(ty))
}

// ── Structural heap-type dedup (roadmap Next#1, the slot layer) ───────────────
// The canonical structural key for struct slot `si`, or "" when `si` does not participate
// in dedup. A DECLARED struct keys on its memoized arena index; an INLINE-SHAPE slot
// (interned under its annotation spelling) resolves that spelling through the checker's
// name grammar to the same key vocabulary. Shape slots mostly dedup at intern time, but a
// FIELD shape interned by `collectNestedFieldShapes` lands BEFORE the declared structs, so
// a declared twin still minted a duplicate heap type — invalid wasm; keying shape slots
// here collapses it. The key is `repCanonKey`: structurally identical slots (recursive
// twins included, canonicalized by the de Bruijn back-edge) render the SAME key and
// distinct structures never collide; anything else stays "" and is never merged. A14
// FORWARD-COMPAT SEAM: a future nominal/opaque type opts OUT by injecting its nominal
// identity into `repCanonKeyGo`'s key, so its slot matches no twin — nothing here changes.
const repNoTyparams: string[] = []

// The arena type index a struct-row NAME denotes, or -1 — the resolution
// `slotCanonId` used to inline. Exported so the row MINT sites can record it into
// the `sTyIx` sidecar (phase D0) at the moment the annotation is in scope.
export function sTyIxOfName(nm: string): i32 { sTyIxOfNameTy(nm, -1) }

// `sTyIxOfName` with the caller's RECORDED arena type for this very name (destringify
// D-INLINESHAPETY), -1 for no hint. The bridge's whole body is
// `cUserTypes[nm] ?? resolveAnnot(nm)` for a shape spelling, so a caller that already
// banked that index is asking `resolveAnnot` to hand back what it holds; the name
// ladder below is untouched and still runs for every unhinted caller.
//
// The hint must be the type THIS name resolved to — `internInlineShapeTy`'s header has
// the construction for the one hinted call path, and the population measurement that
// says why there is only one.
export function sTyIxOfNameTy(nm: string, tyIx: i32): i32 {
  if tyIx >= 0 { return tyIx }
  const di = cUserTypes[nm] ?? -1
  if di >= 0 { return di }
  // The inline-shape fallback: only a bare `{...}` spelling (not a map `{[`) resolves.
  // This runs at INTERN time inside `collectS`'s row-minting loop and `resolveAnnot` mints
  // arena types per call — the #961 runaway shape — so the cost was checked rather than
  // assumed, and came out in the noise: the annotation-name memo is doing its job. A name
  // that resolves through neither path stays -1 and `slotCanonId` falls through to its
  // existing name behaviour.
  if nameIsShapeSpanEnds(nm) { return resolveAnnot(nm, repNoTyparams) }
  // The GENERIC-APPLICATION fallback (`Box<i32>`), the same rung one spelling wider.
  // `gaeEnsure` mints a row for every concrete application it interns and records the
  // sidecar THROUGH THIS FUNCTION, and until here the ladder had no arm for a `Head<…>`
  // spelling at all: `cUserTypes` holds the generic BASE, never an application, and the
  // shape test above wants a leading `{`. So every application row banked -1, which
  // `buildStructTwins` tests FIRST, so an application was never compared against ANY row
  // and a layout twin of a declared struct got its own heap type — check-clean INVALID
  // WASM. SAFE BY CONSTRUCTION: `resolveAnnot` IS the resolution the checker performed at
  // every annotation spelled `Box<i32>`, so the recorded index is the type the row's name
  // denotes, not a new equivalence. Nothing is merged by this arm; `buildStructTwins`'
  // second gate (`structFieldCodesEq`, positional) still has to agree before two rows
  // share a heap type, and an unresolvable spelling still answers -1.
  if annGenAppSpanEnds(nm) { return resolveAnnot(nm, repNoTyparams) }
  -1
}

// Whether the struct row JUST pushed came from a DECLARED type name, decided from its own
// spelling at the MINT — the one moment it is in scope. Pads with 0 so a mint site that
// does not call this reads "not declared", the conservative answer.
//
// THIS IS `cUserTypes` MEMBERSHIP, WHICH INCLUDES UNION DECLARATIONS. It is the right
// predicate for `repSlotCacheSync` ("is this row's name a declared TYPE") and the WRONG
// one for `structIdxOfElemName`, which needs "is it a declared STRUCT" and must keep
// `nameIsStructDecl`. See the note at that gate: a swap was tried, and a struct-alias
// union opened it.
export function recordSRowDeclOfName(nm: string) {
  let v = 0
  if cUserTypes.has(nm) { v = 1 }
  while sRowDecl.length + 1 < sNames.length { sRowDecl.push(0) }
  sRowDecl.push(v)
  0
}

// Record `v` as the arena type index of the struct row JUST pushed onto `sNames`. Pads
// with -1 so a mint site that does not call this self-heals to "uncovered" — `slotCanonId`
// then falls through to the legacy name path rather than reading a mis-aligned entry.
export function recordSTyIx(v: i32) {
  while sTyIx.length + 1 < sNames.length { sTyIx.push(-1) }
  sTyIx.push(v)
  0
}

// The arena type index a struct/variant FIELD's recorded ELEMENT/TARGET name denotes,
// or -1 — the `sFieldElemTyIx` / `uFieldElemTyIx` sidecars' producer (phase D5).
// Nominal first, then the annotation grammar — the two rungs of `declTyIxOfName`,
// whose header owns the rule (a declared struct / union / alias name IS its identity;
// a code-15 field's target and a code-16 field's union name are usually exactly that,
// while a composite spelling — `{v:i32}`, `S[]`, `(i32 | null)` — needs the grammar).
// `resolveAnnot` memoizes per spelling — positively AND negatively —
// so the synthetic `#anonN` element names (which resolve through neither path) cost one
// failed lookup per program and record -1, the self-healing "uncovered" value.
// Runs ONCE per struct field at intern time, so the #961 runaway does not apply.
export function fieldElemTyIxOfName(nm: string): i32 {
  if nm == "" { return -1 }
  // The runaway cap, mirroring `repNameCanonId` / `repElemIdOfNameTy`: a spelling this
  // long is never a legit slot key, and feeding it to `resolveAnnot` mints fresh arena
  // types per probe. -1 is the documented safe degenerate (the name path is kept).
  if nm.length > 4096 { return -1 }
  declTyIxOfName(nm)
}

// The emit side's NAME → ARENA-TYPE bridge, and the one home for its three rungs: the
// DECLARED-name table answers a nominal spelling directly, the PRIMITIVE leaf answers a
// bare keyword, and ONLY a spelling neither carries reaches the annotation grammar.
// Guard-free by design — each caller keeps its own empty-name and runaway-cap policy above
// this call, because those policies differ (-1 · "" · -2). THE RUNGS ARE PARSE ELIMINATORS,
// NOT CACHES: `resolveAnnot` memoizes per spelling, so what a rung removes is the FIRST
// resolution of a spelling, the one call that actually reads the grammar. Rung 2 is
// ARENA-NEUTRAL and so can renumber nothing — the primitive it answers with is seeded
// before any annotation resolves. Rung 1 is NOT sound at `repElemIdOfNameTy`: a `new`
// NEWTYPE has two live arena indices over one `Ty` (base and `nwBrand`), only the base owns
// an `sNames` row, so one spelling gets two reps there and that site keeps asking the
// grammar. See `docs/internals/destringify-types-program.md` (D-DECLRUNG, D-NWBRANDKEY).
export function declTyIxOfName(nm: string): i32 {
  const di = cUserTypes[nm] ?? -1
  if di >= 0 { return di }
  // RUNG 2 — the PRIMITIVE leaf. `primTyOfName` is one of the three leaf rungs BOTH
  // checker resolvers bottom out at, and a bare `i32` / `string` / `null` spelling is
  // a leaf: the grammar below takes it apart into nothing and arrives at this very
  // function. Asking it here is the same lookup one call earlier, not a second copy
  // of a rule — and it answers a SEEDED arena index that no second entry shadows
  // (the base/brand skew that refuses rung 1 at `repElemIdOfNameTy` needs a
  // DECLARED name, and no declaration can be spelled with a primitive keyword).
  const pi = primTyOfName(nm)
  if pi >= 0 { return pi }
  resolveAnnot(nm, repNoTyparams)
}

// Record the two SIDECAR columns of the struct field row JUST pushed onto
// `sFieldElemName`: the element/target name's arena type (phase D5) and — for a MAP
// field — the KEY half of the map's rep (B6b). Pads with -1 / 0 so a push site that
// does not call this self-heals to "uncovered" — every consumer then falls through to
// its legacy name path (arena) or to "string-keyed" (key) rather than reading a
// mis-aligned entry.
//
// ONE RECORDER FOR BOTH COLUMNS, deliberately. The key column is what makes a map
// field's row name its LAYOUT (an mv slot's identity is the (KEY, VALUE) pair), and a
// key column written at only some of the seven `sFieldElemName.push` sites is exactly
// the parallel-array skew this table is most fragile to. Folding it into the recorder
// every push site ALREADY calls makes "wrote the name, forgot the key" unspellable.
export function recordSFieldElemRow(nm: string, keyI32: boolean) {
  recordSFieldElemRowTy(nm, keyI32, -1)
}

// `recordSFieldElemRow` with the caller's ARENA ROW for `nm`. -1 is exactly the unhinted
// call, so a site with nothing to hand over is unchanged by construction.
//
// This is on the SIDECAR side of the mint-order line (D-MAPNODETY): the row is recorded
// BESIDE a mint that has already happened, not used to decide one. An arena leg that
// answers where the name bridge declines must not front a MINT path — that is what
// emitted invalid wasm at `mvShapeOfValNameK`.
export function recordSFieldElemRowTy(
  nm: string,
  keyI32: boolean,
  tyHint: i32,
) {
  while sFieldElemTyIx.length + 1 < sFieldElemName.length {
    sFieldElemTyIx.push(-1)
  }
  let sfTy = tyHint
  if sfTy < 0 { sfTy = fieldElemTyIxOfName(nm) }
  sFieldElemTyIx.push(sfTy)
  while sFieldElemKeyI32.length + 1 < sFieldElemName.length {
    sFieldElemKeyI32.push(0)
  }
  let k = 0
  if keyI32 { k = 1 }
  sFieldElemKeyI32.push(k)
  0
}

// The `recordSFieldElemRow` twin for the VARIANT field table (`uFieldElemName`).
export function recordUFieldElemRow(nm: string, keyI32: boolean) {
  recordUFieldElemRowTy(nm, keyI32, -1)
}

// `recordUFieldElemRow` with the caller's ARENA ROW for `nm`; -1 is today's call. The
// sidecar side of the mint-order line, exactly as `recordSFieldElemRowTy`.
export function recordUFieldElemRowTy(
  nm: string,
  keyI32: boolean,
  tyHint: i32,
) {
  while uFieldElemTyIx.length + 1 < uFieldElemName.length {
    uFieldElemTyIx.push(-1)
  }
  let ufTy = tyHint
  if ufTy < 0 { ufTy = fieldElemTyIxOfName(nm) }
  uFieldElemTyIx.push(ufTy)
  while uFieldElemKeyI32.length + 1 < uFieldElemName.length {
    uFieldElemKeyI32.push(0)
  }
  let k = 0
  if keyI32 { k = 1 }
  uFieldElemKeyI32.push(k)
  0
}

// The arena type index a union MEMBER-atom spelling denotes, or -1. The three rungs
// of `declTyIxOfName`, whose header owns the rule: nominal (`cUserTypes` — a declared
// variant / alias name IS its identity), then the primitive leaf (a member set is
// mostly bare scalars: 1,481 of this site's 1,991 corpus reaches), then the checker's
// annotation grammar for a composite spelling (`{[string]: V}`, `((i32) => f32)[]`,
// `{w: i32}`). `resolveAnnot` memoizes per spelling, and this runs ONCE per union
// member at registration, so the #961 runaway does not apply.
//
// The empty-atom guard is this caller's own policy (the bridge is guard-free), and it
// moves ABOVE the lookup: an empty spelling is not a declared name in any program, so
// the probe it used to make could only ever miss.
export function unMemAtomTyIx(atom: string): i32 {
  if atom.length == 0 { return -1 }
  declTyIxOfName(atom)
}

// The interned id of a union member's atom SPELLING, after `peelGroupParens` (the
// same normalization `removeAtomFrom` applies to both sides of its comparison, so a
// `(() => i64)` member and an `is () => i64` test are the same member reference).
// Two member references are equal iff their ids are — set membership and subtraction
// are then integer work, with no string scan and nothing re-parsed. Ids are pure text
// identities carrying no arena or table content, so the table lives across programs.
export function msAtomIdOf(atom: string): i32 {
  const p = peelGroupParens(atom)
  const hit = msAtomIds[p] ?? -1
  if hit >= 0 { return hit }
  const id = msAtomTexts.length
  msAtomTexts.push(p)
  msAtomIds[p] = id
  id
}

// WHAT a union member IS, recorded next to its arena type: 0 the `null` keyword
// (a token, not a rendered shape) · 1 NOMINAL — a declared alias / struct / variant
// name, whose identity IS the name (`cUserTypes` resolved it) · 2 a scalar primitive
// · 3 a composite (map / array / closure / inline shape / nested union) · -1 the
// spelling did not resolve to an arena type. `ty` is the member's already-resolved
// arena index, so this classification costs one map probe and one arena read — it
// never re-derives anything from the member's TEXT beyond the `null` keyword test.
function unMemKindOf(atom: string, ty: i32): i32 {
  if atom == "null" { return 0 }
  const di = cUserTypes[atom] ?? -1
  if di >= 0 { return 1 }
  if ty < 0 { return -1 }
  if ty >= T.tys.length { return -1 }
  const t = T.tys[ty]
  if t is TyPrim { return 2 }
  3
}

// ── D-UNION ATOM-KIND — the member's value-atom kind, banked at the recorder ──
// `valueAtomKind(atom)` is the union box ABI's 14-way code (i32 · boolean · string · i64 ·
// f64 · f32 · null · six scalar-element list flavours, the packed `u8[]` being the sixth ·
// closure, and -1 for "not a value atom"). The box TAG (`scalarTagOf`), the scalar
// VALUE-BOX heap index (`vbHeapIdxOfKind`) and the list WRAPPER heap index are pure
// projections of it, each of which used to re-PARSE the member's rendered spelling.
// `recordUnMemTys` already holds each member's atom TEXT while it walks the set — the one
// place a member set is ever split — so it banks the code there instead. EXACT, never a
// fold: a folding predicate would hand `scalarTagOf` a tag NO producer interned, a runtime
// `ref.cast` trap rather than a loud reject. LIFETIME: the column is index-parallel to
// `unMemAtoms`, which `emitProgram` and `collectU` clear without knowing it exists, so the
// lock-step guard re-empties it and `unMemValKindAt` answers -2 (uncovered; -1 is a kind).
export let unMemValKind: i32[] = []

// The banked value-atom kind of recorded member `m`, or -2 when the bank does not
// cover it (a member recorded before this column existed in this program, or a
// column the external reset left behind — see the lock-step guard).
export function unMemValKindAt(m: i32): i32 {
  if m < 0 { return -2 }
  if unMemValKind.length != unMemAtoms.length { return -2 }
  if m >= unMemValKind.length { return -2 }
  unMemValKind[m]
}

// The member slice of union row `u`, or -1 when the row is not covered by the member
// reference columns — the ONE home of the member-slice bounds (same 31-bit mask limit
// the set ADT's masks are sized by), so a set the pool minted is a set this column can
// index. `emit_classify`'s `msRowStart` delegates here; there is no second copy.
export function unMemRowStart(u: i32): i32 {
  if u < 0 { return -1 }
  if u >= unMemTyStart.length { return -1 }
  const st = unMemTyStart[u]
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  if n < 1 || n > 31 { return -1 }
  if st + n > unMemAtoms.length { return -1 }
  st
}

// The banked value-atom kind of the SINGLE member of the interned member set `s` —
// the question every `valueAtomKind(removeAtomFromSet(set, "null"))` consumer is
// actually asking, since a residual with 0 or 2+ members renders as `""` / `"a|b"`
// and `valueAtomKind` answers -1 for both. So: -1 for a non-singleton set (the same
// answer the rendered form gives), the member's banked kind for a singleton, and -2
// only when the pool or the bank does not cover the set and the caller must keep its
// rendered-atom path.
export function msSoloValKind(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -2 }
  if msSetGen[s] != msGen { return -2 }
  const u = msSetRow[s]
  const st = unMemRowStart(u)
  if st < 0 { return -2 }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let solo = -1
  let cnt = 0
  let i = 0
  while i < n {
    if ((mask >>> i) & 1) == 1 {
      solo = i
      cnt = cnt + 1
    }
    i = i + 1
  }
  if cnt != 1 { return -1 }
  unMemValKindAt(st + solo)
}

// ITERATION over the banked kinds — the kind column's twin of `msMemberAtomsOf`,
// appending the set's members' banked codes to `out` in the row's recorded (box-tag
// ABI) order, so a consumer that walks a set's members can carry the code alongside
// the spelling instead of re-deriving it per member. False leaves `out` untouched and
// the caller keeps its per-atom derivation.
export function msMemberValKindsOf(s: i32, out: i32[]): boolean {
  if s < 0 || s >= msSetRow.length { return false }
  if msSetGen[s] != msGen { return false }
  const u = msSetRow[s]
  const st = unMemRowStart(u)
  if st < 0 { return false }
  if unMemValKind.length != unMemAtoms.length { return false }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let i = 0
  while i < n {
    if ((mask >>> i) & 1) == 1 { out.push(unMemValKind[st + i]) }
    i = i + 1
  }
  true
}

// MEMBERSHIP of a SCALAR value atom, by its ABI KIND — `msHasNull`'s generalization from
// the `null` keyword to the whole scalar keyword row, answered from the banked kind column
// with no spelling anywhere. 1 present · 0 absent · -1 uncovered (the caller keeps its
// name-keyed `unionHasAtomTy` path). D-VALKIND: the same question, asked of the BANK — its
// callers already hold the set id and usually the KIND, so the keyword is only the decline
// argument. RESTRICTED TO KINDS 0-6 BY CONSTRUCTION: only across the seven scalar keywords
// is the kind map a bijection, while kind 7 folds `i32[]` / `boolean[]` / litunion-`K[]`
// into ONE code and every list member's arena type is a `TyArray`, so an EXACT `TyPrim`
// test would answer NO where a kind test answers YES. The ALIAS arm is why a 0 here can be
// believed: a member spelled `MyInt` under `type MyInt = i32` resolves to `TyPrim("i32")`
// while `valueAtomKind("MyInt")` is -1, so a set holding ANY member the kind column cannot
// classify but whose RECORDED ARENA TYPE is primitive is declared UNCOVERED.
export function msHasValKind(s: i32, k: i32): i32 {
  if k < 0 || k > 6 { return -1 }
  if s < 0 || s >= msSetRow.length { return -1 }
  if msSetGen[s] != msGen { return -1 }
  const u = msSetRow[s]
  const st = unMemRowStart(u)
  if st < 0 { return -1 }
  if unMemValKind.length != unMemAtoms.length { return -1 }
  if unMemTys.length != unMemAtoms.length { return -1 }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let hit = 0
  let i = 0
  while i < n {
    if ((mask >>> i) & 1) == 1 {
      const mk = unMemValKind[st + i]
      if mk == k { hit = 1 }
      if mk < 0 {
        // An ALIAS spelling whose arena type IS a primitive would answer YES on the
        // `TyPrim` path and NO here — decline the whole set rather than differ.
        const ty = unMemTys[st + i]
        if ty >= 0 && ty < T.tys.length {
          const t = T.tys[ty]
          if t is TyPrim { return -1 }
        }
      }
    }
    i = i + 1
  }
  hit
}

// IS the interned member set `s` a VALUE union — one this emitter boxes into the shared
// `{tag, payload}` rep? Tri-state: 1 yes · 0 no · -1 the pool or the kind bank does not
// cover `s`, and the caller keeps its member-NAME path.
//
// D-VALUNION: `isValueUnionName`'s question asked of the BANK instead of of a rendering.
// That resolver takes a union SPELLING apart three ways — `unionMemberCount`, then
// `splitUnionAtoms` re-running the same scan and materializing every atom, then
// `valueAtomKind` per atom — to reach an answer that reads nothing but ABI codes
// `recordUnMemTys` already recorded per member in box-tag order (`unMemValKind`). EXACT,
// not an approximation: `msSetOfText(text) == s` hands back a set only when `text` IS that
// set's members joined in recorded order, so the column read is `isValueUnionName`'s body
// arm for arm, short-circuit on a non-value-atom member included.
export function msIsValueUnion(s: i32): i32 {
  const kinds: i32[] = []
  if !msMemberValKindsOf(s, kinds) { return -1 }
  if kinds.length < 2 { return 0 }
  let nonNull = 0
  let hasNull = false
  let soloKind = -1
  let i = 0
  while i < kinds.length {
    const k = kinds[i]
    // A member that is not a value atom (a struct name, an inline shape, a
    // ref-element array) — not a value union, and the scan stops, exactly as the
    // spelling ladder's `if k < 0 { return false }` does.
    if k < 0 { return 0 }
    if k == nullValKind() {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    i = i + 1
  }
  if nonNull >= 2 { return 1 }
  if nonNull == 1 && hasNull {
    // Only a NUMERIC scalar boxes with null; `boolean | null` / `string | null` keep
    // their niche encodings, which are not boxes.
    if soloKind == 0 || soloKind == 3 || soloKind == 4 || soloKind == 5 {
      return 1
    }
    return 0
  }
  0
}

// The globally-stable box TAG of a value atom, from its KIND — the ONE home of the
// kind→tag table. `emit_classify`'s `scalarTagOf(atom)` delegates here over
// `valueAtomKind(atom)`. Struct variants take the dense ranks below; atom kinds claim
// the fixed slots above them.
export function scalarTagOfKind(k: i32): i32 { uVariants.length + k }

// The value-atom KIND of the `null` member — a CONSTANT of the box ABI, not a
// question about a spelling. `null` is a keyword, never a rendered type: the emitter
// asked `scalarTagOf("null")` at thirteen sites and each one walked `valueAtomKind`'s
// six literal compares to land on the seventh arm, which is the only arm that can
// answer for that lexeme (`valueAtomKind` returns 6 for `"null"` and 6 for nothing
// else, so the map is a bijection at this one point and the derivation is dead work).
// Named here, beside the kind→tag table, so the ABI's null code has ONE home too.
export function nullValKind(): i32 { 6 }

// The globally-stable box TAG of the `null` member — `scalarTagOfKind(nullValKind())`.
// Every producer and every consumer of a null-tagged box (the `null` literal's coerce,
// the `??` tag tests over an ident / a call / a union field, a missing map entry's
// null-tagged box, the nullable-union stores) reads the tag from HERE instead of
// re-deriving it from the lexeme.
export function nullBoxTag(): i32 { scalarTagOfKind(nullValKind()) }

// A type that DENOTES a function type, seeing through the degenerate ONE-member
// union wrapper an arrow-bodied alias carries. `parser.vl` encodes every
// non-`{…}`-bodied `type N = …` as a one-member `UnionDecl`, and the checker's pass 0a
// registers a `TyUnion` placeholder for it; #1122's transparency collapse
// (`aliasRefIsPlainName`) covers only a plain NAME or generic APPLICATION member, so
// `type F = (i32) => i32` keeps the wrapper and `T.tys[nameToTy("F")]` is a `TyUnion`
// over one `TyFunc`, not a `TyFunc`. A one-member union has nothing to discriminate —
// it denotes its member, exactly the rule #1122 established — so the wrapper is peeled
// here (iteratively: an alias chain can nest them). `unMemIsFunc`'s plain `is TyFunc`
// stays what it is; this is the ALIAS-tolerant reading a consumer wants when it is
// asking "is the type the user named a closure type", not "is this union member one".
export function tyDenotesFunc(m: i32): boolean {
  let cur = m
  let steps = 0
  while cur >= 0 && cur < T.tys.length && steps < 8 {
    const t = T.tys[cur]
    if t is TyFunc { return true }
    if t is TyUnion {
      if t.uMembers.length != 1 { return false }
      cur = t.uMembers[0]
      steps = steps + 1
    } else {
      return false
    }
  }
  false
}

// The interned scalar VALUE-BOX heap index for a value atom of kind `k`, or -1 when the
// kind rides the box's `anyref` payload directly (string, the five list flavours, closure)
// or is not a value atom at all. The kind-keyed twin of `emit_classify`'s
// `vbHeapIdxOfAtom(atom)`, which delegates here over `valueAtomKind(atom)` — so the
// kind→box table has exactly ONE home and cannot drift.
//
// UNMINTED IS -1, NOT 0, AND THE DIFFERENCE IS A SILENT CLASS. `vb*Idx` initialises to 0
// and is assigned only when `mAssignTypeIndices` sees the matching `vb*Used` flag, so a
// module whose value unions never use a rep answered heap type 0 for it — a real type in
// every module, and the wrong one. Every caller guards `< 0` and takes a loud reject, but
// none could distinguish "box 0" from "no box", so a `ref.cast (ref 0)` shipped instead
// (silent-class-inventory D221). The flag is the mint's own condition, read back.
export function vbHeapIdxOfKind(k: i32): i32 {
  if k == 0 || k == 1 {
    if !vbI32Used { return -1 }
    return vbI32Idx
  }
  if k == 3 {
    if !vbI64Used { return -1 }
    return vbI64Idx
  }
  if k == 4 {
    if !vbF64Used { return -1 }
    return vbF64Idx
  }
  if k == 5 {
    if !vbF32Used { return -1 }
    return vbF32Idx
  }
  -1
}

// The value-eq OPCODE (i32 result) for a value atom of kind `k`: i32 / boolean share
// `i32.eq`; i64 / f64 / f32 take their own. -1 for `string` (its eq loop), `null` (tag
// equality alone decides it — no payload) and every list / closure kind.
//
// D-EQOPCODE: this is the table `emit_base`'s `atomEqOpcode(atom)` held, minus the
// `valueAtomKind(atom)` it ran first. Both of its call sites (the union `==` arms in
// `wasmEmit`) already HOLD the code — one from `unMemValKind`'s banked column, the
// other derived once for the tag — and handed the callee a SPELLING to re-derive it.
// The table lives here, beside `scalarTagOfKind` / `vbHeapIdxOfKind`, because every
// other kind→ABI projection does; `emit_base`'s atom-spelled entry point is left with
// zero callers rather than duplicated (see the hand-off in the destringify doc).
export function atomEqOpcodeOfKind(k: i32): i32 {
  if k == 0 || k == 1 {
    return 70 // 0x46 i32.eq
  }
  if k == 3 {
    return 81 // 0x51 i64.eq
  }
  if k == 4 {
    return 97 // 0x61 f64.eq
  }
  if k == 5 {
    return 91 // 0x5b f32.eq
  }
  -1
}

// The wasm value BLOCKTYPE byte a value atom of kind `k` carries — the result type a
// value-producing `if` must declare when its arms yield the UNBOXED atom. i64 / f64 /
// f32 take their own; every other kind (i32, boolean, and the ref atoms that ride the
// box's anyref) reads as the i32 blocktype, which is what each of the four `??` /
// map-get residual sites defaulted to.
//
// D-BLOCKTY: four hand-copied three-arm ladders (`emitMapGetOrUnionBox` and
// `emitCoalesce`'s ident / call / field arms) spelled this table out in place, each
// beside a second hand-copied ladder dispatching the DEFAULT's emit on the same code.
// One home, so a new scalar rep is added once (the D-ELEMHOME / D-FIELDCODE move,
// applied to the box ABI's blocktype column).
export function valBlockTypeOfKind(k: i32): i32 {
  if k == 3 {
    return 126 // 0x7e i64
  }
  if k == 4 {
    return 124 // 0x7c f64
  }
  if k == 5 {
    return 125 // 0x7d f32
  }
  127 // 0x7f i32 (boolean shares it)
}

// Drop every interned member SET (the D-UNION set ADT — see `msSetRow` in
// `emit_state`) and bump the pool generation. A set id is a (union row, member mask)
// pair, and both halves are per-PROGRAM: a fresh program re-mints `unNames` and the
// arena the member columns were recorded against. The generation stamp makes a
// missed reset site read as "uncovered" (the consumer keeps its member-NAME path)
// rather than answering from the previous program's rows — method note 7.
export function msPoolReset() {
  msSetRow = []
  msSetMask = []
  msSetNext = []
  msSetText = []
  msSetGen = []
  msRowChain = []
  msSetByText = Map()
  msSetMiss = Map()
  msGen = msGen + 1
  0
}

// Record the ARENA member types of the union row JUST pushed onto `unNames`, whose
// pipe-joined member set is `set` (the D-UNION foundation — see `unMemTys` in
// `emit_state`). Pads with an empty slice so a mint site that does not call this
// self-heals to "uncovered" and its consumers keep the legacy member-NAME path.
// ORDER-PRESERVING by construction: one recorded index per `splitUnionAtoms` atom,
// in atom order — the union box-tag ABI depends on it.
//
// This is also the ONE place a member set is ever split: alongside each member's
// arena index it records the member REFERENCE columns (`unMemAtoms`/`unMemAtomIds`/
// `unMemKinds`), so every downstream membership / subtraction / cardinality /
// iteration is a structural operation on the recorded members instead of a re-split
// of the joined string (the D-UNION set ADT).
export function recordUnMemTys(set: string) {
  // The member columns are reset in `collectU` and at the top of `emitProgram`, both
  // of which clear `unMemTys` — the reference columns are cleared HERE when that is
  // observed, so they can never answer with a slice of the previous program's rows
  // (an over-long column is the signature: only this function appends, in lock-step).
  if unMemAtoms.length > unMemTys.length {
    unMemAtoms = []
    unMemAtomIds = []
    unMemKinds = []
    msPoolReset()
  }
  // The banked value-atom KINDS are index-parallel to `unMemAtoms` and live in THIS
  // module, so the resets that clear the member columns from above (`collectU`, the
  // top of `emitProgram`) cannot see them. The disagreement is observed here, before
  // this row's members append, and re-empties the column — the only way the two can
  // diverge is such an external reset, because nothing but the loop below appends to
  // either.
  if unMemValKind.length != unMemAtoms.length { unMemValKind = [] }
  while unMemTyStart.length + 1 < unNames.length {
    unMemTyStart.push(-1)
    unMemTyCount.push(0)
  }
  const atoms: string[] = []
  splitUnionAtoms(set, atoms)
  unMemTyStart.push(unMemTys.length)
  unMemTyCount.push(atoms.length)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    const ty = unMemAtomTyIx(a)
    unMemTys.push(ty)
    unMemAtoms.push(a)
    unMemAtomIds.push(msAtomIdOf(a))
    unMemKinds.push(unMemKindOf(a, ty))
    unMemValKind.push(valueAtomKind(a))
    i = i + 1
  }
  0
}

// KEYED ON THE STRUCTURAL IDENTITY (the rep-column rewrite, step 3). Every answer was a
// RENDERED key whose only use is equality, so it is now the hash-consed id — and the
// `""` "does not participate in dedup, never merged" sentinel becomes `-1`. Same
// partition, proven; same two rungs and neither-rung fall-through, untouched.
function slotCanonId(si: i32): i32 {
  if si < 0 || si >= sNames.length { return -1 }
  // RUNG 1 — the ARENA-INDEX sidecar (`sTyIx`, recorded at every row mint), consulted
  // FIRST (destringify D-SLOTARENA). This row's type is known structurally, so there is
  // nothing to re-derive from its name, and it covers the `#anon` literal rows the name
  // path cannot resolve at all. CONFIRM-ONLY, exactly like `nulBaseStructRow`'s arena
  // rung: an uncovered row (-1, the pad-on-push self-heal) or a covered row whose
  // recorded type is not a `TyObj` falls through to the name ladder below, unchanged and
  // in its old order — the two rungs agree wherever both can answer, and an off-by-one
  // read of the sidecar diverges loudly, which is what makes that agreement gradeable
  // rather than vacuous. WHAT MOVING IT BUYS is not tidiness: the name ladder's
  // inline-shape fallback is a `resolveAnnot` RE-PARSE of a spelling this table already
  // banked, and `slotCanonId` is the hottest of `emit_rep`'s seven `resolveAnnot`
  // callers, so the re-parse traffic collapses here and nowhere else.
  if si < sTyIx.length {
    const dix = sTyIx[si]
    if dix >= 0 {
      const dt = T.tys[dix]
      if dt is TyObj { return repCanonId(dix) }
    }
  }
  // RUNG 2 — the NAME ladder, for a row the sidecar does not cover: a mint site that
  // does not call `recordSTyIx` (pad-on-push -1 / a column shorter than `sNames`), or a
  // name that had not resolved yet when the row was interned. Unchanged, and STILL LIVE:
  // control reaches it and it returns a non-"" key on the corpus, so the fall-through is
  // not decoration and the rung is not deletable. Two of its properties are nevertheless
  // INVISIBLE to the corpus, and that is stated rather than banked as a zero — making
  // rung 1 TOTAL wherever the column covers the row, and dropping the `TyObj` gate, each
  // move nothing there, while an off-by-one sidecar read and deleting rung 1 outright
  // both move files. Every answer this rung gives therefore comes from a row PAST the
  // column's end, which is the only decline the corpus can see.
  const nm = sNames[si]
  let di = cUserTypes[nm] ?? -1
  if di < 0 {
    // The inline-shape fallback: only a bare `{...}` spelling (not a map `{[`)
    // resolves; the checker memoizes shape resolution, so this stays cheap.
    if nameIsShapeSpanEnds(nm) { di = resolveAnnot(nm, repNoTyparams) }
  }
  if di >= 0 {
    const t = T.tys[di]
    if !(t is TyObj) { return -1 }
    return repCanonId(di)
  }
  // Neither rung: a synthetic `#anon` row the D0 recorder could not type, or an
  // unresolvable spelling. -1 is the legacy never-merged behaviour ("" before step 3).
  -1
}

// The arena type index to record for an anonymous object-literal shape row (phase
// D0): the literal node's CONTEXT-RESOLVED rep type (`nodeRepTyIxOf`), or -1 when
// the node is uncovered / not a `TyObj`. Exported so the `emit_collect` intern site
// records it without pulling the arena vocabulary across the module boundary.
export function anonRowTyIx(objIx: i32): i32 {
  const rix = nodeRepTyIxOf(objIx)
  if rix < 0 { return -1 }
  const t = T.tys[rix]
  if !(t is TyObj) { return -1 }
  rix
}

// The canonical structural IDENTITY of an arbitrary type-NAME spelling, resolved
// through the checker's annotation grammar (`resolveAnnot`) into the ONE
// `repCanonId` vocabulary — the name-input twin of `slotCanonId`, for slot
// layers whose intern keys are not struct-table indices (the map-VALUE table's
// `mvValName` spellings, the variant table's `uVariants` names). -1 when the
// spelling does not resolve (such a slot never participates in dedup — never
// merged). Every caller feeds names that already passed annotation checking,
// so a miss is the safe degenerate case, not an error path.
//
// The rep-column rewrite, step 4: the answer was a rendered key and is now the id.
// The runaway cap below is unchanged and still needed — it guards `resolveAnnot`, not
// the render, and that hazard is about minting arena types, not about building strings.
export function repNameCanonId(nm: string): i32 {
  if nm == "" { return -1 }
  // RUNAWAY CAP: a spelling this long is never a legit dedup key — feeding it to
  // `resolveAnnot` MINTS fresh arena types per probe (epoch bump → cache rebuild →
  // longer renders → longer spellings), the multiplicative cascade that grew a deep
  // same-fieldset composite's compat probes into a >1GB string allocation — a compiler
  // CRASH ("allocation size too large"; fuzz seed 459979688 d6 bm, the {a,f,z}
  // quadruple-nest). -1 is the documented safe degenerate: the slot just never
  // participates in dedup (never merged) and the resolver falls through LOUDLY.
  if nm.length > 4096 { return -1 }
  const di = declTyIxOfName(nm)
  if di < 0 { return -1 }
  repCanonId(di)
}

// The struct-table row whose sNames key is `nm`, or -1 — a local scan (the
// `structIndexByName` twin; that resolver lives in emit_classify, ABOVE this
// module, so the layout guard here reads the flat `emit_state` arrays directly).
function repStructRowByName(nm: string): i32 {
  let i = 0
  while i < sNames.length {
    if sNames[i] == nm { return i }
    i = i + 1
  }
  -1
}

// The struct-table row whose D0 `sTyIx` sidecar entry is the ARENA type `ty`, or -1 —
// `repStructRowByName`'s STRUCTURAL twin (`structIndexOfTy`'s question, local for the same
// layering reason, same first-match-wins order). A row the D0 sidecar does not cover holds
// -1 there and never matches a real type, so the caller falls through to its name path.
function repStructRowByTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  let i = 0
  while i < sTyIx.length {
    if sTyIx[i] == ty { return i }
    i = i + 1
  }
  -1
}

// The D5 `sFieldElemTyIx` sidecar entry for struct row `si`'s field `fi` — a local copy
// of `sFieldElemTyIxAt` (emit_classify), with the same pad-on-push bounds guard. -1 when
// the sidecar does not cover the row.
function repFieldElemTyIx(si: i32, fi: i32): i32 {
  const ix = sFieldStart[si] + fi
  if ix >= sFieldElemTyIx.length { return -1 }
  sFieldElemTyIx[ix]
}

// In-progress (elemA, elemB) pairs of the code-15 referenced-layer descent below —
// layout equality over RECURSIVE shapes (`type L1 = {n: L1 | null}` vs a structural
// twin) is COINDUCTIVE: a revisited pair is assumed equal (the canonical keys
// already matched at every level above; only a genuine storage divergence refutes).
const sfceStkA: i32[] = []
const sfceStkB: i32[] = []

// The field CODES whose emitted storage is a `(ref [null] <heap>)` the code alone does
// NOT name — the heap comes from the field's own recorded element spelling
// (`sFieldElemName` / the D5 `sFieldElemTyIx` sidecar), so two rows may agree on every
// top-level code and still store DIFFERENT heap types: 15 a nested / nullable struct, 5 a
// struct / union / closure ref LIST, 28 the `S[] | null` niche. Every one needs the
// referenced-layer descent below before its rows may share a WasmGC type — gating only
// code 15 is what D64 cost: two `{xs: <arm>[]}` rows merged onto one heap type while the
// ref-list layer kept their element heaps apart, giving check-clean invalid wasm. The
// other named-heap codes (a map-valued field 19 and its niche 29, and a code-15 field over
// a union arm) are absent because they are a LOUD reject before any row is merged; adding
// them would be an unwitnessed widening of a MERGE gate, which cannot be graded. They
// belong here the day a witness reaches the test.
function fieldCodeRefsElemHeap(code: i32): boolean {
  code == 15 || code == 5 || code == 28
}

// True when struct slots `a` and `b` have an IDENTICAL emitter field-code list
// (same count, same per-field wasm code in order), with the referenced-layer
// guard on every field code whose storage heap is NAMED rather than pinned by the
// code (`fieldCodeRefsElemHeap`, below). A layout guard on top of the structural key:
// `repCanonKey` equality guarantees the CHECKER structure is the same, but a key
// collision whose EMITTED layout would differ (e.g. an atom-backed litunion
// field `type K="a"|"b"` vs an inline `"a"|"b"`, coded differently by the
// emitter) must NOT merge. Same key AND same codes AND twin-equal referenced
// rows ⟹ same emitted heap layout.
function structFieldCodesEq(a: i32, b: i32): i32 {
  if sFieldCount[a] != sFieldCount[b] { return 0 }
  let i = 0
  while i < sFieldCount[a] {
    if sFieldTypes[sFieldStart[a] + i] != sFieldTypes[sFieldStart[b] + i] {
      return 0
    }
    if fieldCodeRefsElemHeap(sFieldTypes[sFieldStart[a] + i]) {
      // A NAMED-HEAP field stores a `(ref [null] <elem heap>)` — the code alone does
      // NOT pin the layout; the referenced rows must share one heap type too (the
      // `variantFieldLayoutEq` referenced-layer discipline, which the struct layer
      // lacked). Same key + same TOP-LEVEL codes is NOT enough: an `#anon` row's
      // canon-key sidecar carries the literal's ADOPTED type (`{a:i32,f:{b:f32}}`)
      // while its interned fields came from the SELF-classified spelling (`3.5` → an
      // f64 inner row), so merging it with the annotation row stored a `(ref ${b:f32})`
      // into a field typed `(ref null ${b:f64})` — INVALID WASM. Byte-equal elem names
      // trivially share a row; distinct names must resolve and be twins themselves. An
      // unresolvable elem name DECLINES the merge (never-merged is the safe degenerate,
      // the "" key discipline).
      const ea = sFieldElemName[sFieldStart[a] + i]
      const eb = sFieldElemName[sFieldStart[b] + i]
      if ea != eb {
        // DESTRINGIFY: the referenced ROW comes off the ARENA — the D5 sidecar's
        // recorded element type through the D0 `sTyIx` row scan — and the recorded
        // NAME only for a row the sidecars do not cover. Ladder-faithful (D1 leg C):
        // the arena replaces the resolver in place, the fall-through is untouched, so
        // the `ra < 0 || rb < 0` decline and the coinductive twin descent below are
        // reached in exactly the same cases. Note what does NOT move: the `ea != eb`
        // trigger stays a NAME compare. Equal recorded names are a sufficient identity
        // fast path, whereas swapping it for arena-index equality would newly MERGE the
        // rows whose element spelling the struct table cannot name — reflist/struct
        // INTERN STATE, not structure (the D3' refutation's shape).
        let ra = repStructRowByTy(repFieldElemTyIx(a, i))
        if ra < 0 { ra = repStructRowByName(ea) }
        let rb = repStructRowByTy(repFieldElemTyIx(b, i))
        if rb < 0 { rb = repStructRowByName(eb) }
        if ra < 0 || rb < 0 { return 0 }
        if ra != rb {
          let onStack = false
          let k = 0
          while k < sfceStkA.length {
            if sfceStkA[k] == ra && sfceStkB[k] == rb { onStack = true }
            k = k + 1
          }
          if !onStack {
            sfceStkA.push(ra)
            sfceStkB.push(rb)
            const tw = repStructSlotsTwin(ra, rb)
            sfceStkA.pop()
            sfceStkB.pop()
            if tw == 0 { return 0 }
          }
        }
      }
    }
    i = i + 1
  }
  1
}

// True when struct slots `a` and `b` share ONE WasmGC heap type under the
// canonical structural key + the field-code layout guard — the `sTwin`
// equivalence, queryable PAIRWISE (independent of `buildStructTwins` having
// run). The ref-list layer's canonical slot fallback (`rlSlotByName`) uses it
// to decide whether two element spellings back the same heap type.
export function repStructSlotsTwin(a: i32, b: i32): i32 {
  if a == b { return 1 }
  if a < 0 || b < 0 { return 0 }
  const ka = slotCanonId(a)
  if ka < 0 { return 0 }
  if ka != slotCanonId(b) { return 0 }
  structFieldCodesEq(a, b)
}

// The canonical (smallest `sTwin`-equivalent) representative of struct slot `si` — the
// smallest slot `j <= si` sharing `si`'s `slotCanonId` under the `structFieldCodesEq`
// layout guard, or `si` itself when it is the first of its structure or does not
// participate in dedup (empty key). This is the SAME equivalence `buildStructTwins` records
// in `sTwin[]`, computed on demand and TIMING-INDEPENDENTLY: `repSigSlotTokOfKind` renders
// it into `$fnsig` struct tokens during `collectCloSigs` — BEFORE `mAssignTypeIndices` has
// built `sTwin[]` — and again at emit time, and the two must agree. Reads only
// `slotCanonId` (memoized per arena index) so a spelling-twin row keys the SAME sig digit
// as its representative, making structurally-identical shapes intern one functype key.
// Memoized per `tyMutEpoch`; `sNames` only APPENDS later slots, which never change an
// existing slot's rep, so growth needs no reset.
let repSlotRepMemo: i32[] = []
let repSlotRepEpoch = -1

function repSlotRepSync() {
  if repSlotRepEpoch != tyMutEpoch {
    repSlotRepMemo = []
    repSlotRepEpoch = tyMutEpoch
  }
  0
}

export function repStructSlotRep(si: i32): i32 {
  if si < 0 || si >= sNames.length { return si }
  repSlotRepSync()
  if si < repSlotRepMemo.length {
    if repSlotRepMemo[si] >= 0 { return repSlotRepMemo[si] }
  }
  const key = slotCanonId(si)
  let rep = si
  if key >= 0 {
    let j = 0
    while j < si {
      if slotCanonId(j) == key && structFieldCodesEq(j, si) == 1 {
        rep = j
        j = si // stop at the first (smallest) twin
      }
      j = j + 1
    }
  }
  while repSlotRepMemo.length <= si { repSlotRepMemo.push(-1) }
  repSlotRepMemo[si] = rep
  rep
}

// Rep-twin phase 2 — the STRUCTURAL row resolver for `structIndexOfObjCtx`'s ambiguity
// arm (matches >= 2). Given the checker's recorded arena type for an `ObjLit` (`repTyIx`,
// from `nodeRepTyIxOf`), the UNIQUE struct row `si` in `[0, lim)` whose canonical
// structural key equals `repCanonKey(repTyIx)` and whose emitted field-code layout is
// consistent (`structFieldCodesEq`) — the `repStructSlotsTwin` double gate lifted to a
// whole-table scan keyed on an arena type rather than a second slot. -1 when: `repTyIx` is
// uncovered or not a `TyObj`, the key is empty, no row matches, or two matched rows differ
// in emitted layout — a genuinely AMBIGUOUS collision this resolver must NOT guess through,
// so the caller falls back to its name path. The scan mirrors `slotCanonId`'s own cost
// discipline: declared rows read a memoized arena key, inline shape spellings resolve
// through the checker's memoized `resolveAnnot`.
export function repRowOfTyStruct(repTyIx: i32, lim: i32): i32 {
  if repTyIx < 0 { return -1 }
  const t = T.tys[repTyIx]
  if !(t is TyObj) { return -1 }
  const key = repCanonId(repTyIx)
  if key < 0 { return -1 }
  let best = -1
  let si = 0
  while si < lim && si < sNames.length {
    if slotCanonId(si) == key {
      if best < 0 {
        best = si
      } else if structFieldCodesEq(best, si) == 0 {
        // Two canon-key twins with DIVERGENT emitted layouts (the #974
        // atom-backed litunion field vs a plain scalar row) — this arena type
        // alone cannot pick the right emission; decline and let the name path
        // (which reads per-row atom identity) resolve.
        return -1
      }
    }
    si = si + 1
  }
  best
}

// Normalize a checker RENDER (`tyToStr`, which spaces fields `{f: T}` and spells a nullable
// with a `?` suffix) into the canonical spelling the annotation grammar (`resolveAnnot`)
// parses — SCOPED to `repRowOfName` below, NEVER a global `nameToTy` change. Two fidelity
// gaps a raw render trips: SPACES, because `nameToTy`'s inline-shape parser slices a field
// type WITH its leading space and then fails its nested-shape test on the leading brace, so
// `repCanonKey` reads a spaced nested field as a proven mismatch; and the `?` NULLABLE,
// unparseable as an atom until rewritten to the `i64|null` union spelling. Both are
// position-independent textual rewrites over a canonical type render. The SPACE half is
// `tyname.nameStripSpaces` (W7), the same ENFORCEMENT `emit_classify.shapeFieldParse` asks
// for; the `?` half stays here because it is a SPELLING rewrite, not a normalisation. The
// two COMMUTE — `"|null"` holds no space and a `?` is not a space — which is what makes
// splitting them exact rather than similar, at the cost of one extra non-allocating scan.
function renderFaithful(nm: string): string {
  const ns = nameStripSpaces(nm)
  let out = ""
  let i = 0
  while i < ns.length {
    const c = ns[i]
    if c == '?' { out = out + "|null" } else { out = out + fromCodePoint(c) }
    i = i + 1
  }
  out
}

// The struct-table row a checker RENDER `nm` names, after `renderFaithful` normalization,
// resolved through the ONE `repRowOfTyStruct` vocabulary — the name-input twin of the node
// route. Tri-state: -2 the spelling did not resolve through the annotation grammar, -1
// resolved to a non-`TyObj` or a shape participating in no row, >=0 the unique matching
// row in `[0, lim)`. NO CALLER CONSULTS THE DISTINCTION — every one tests `>= 0` / `< 0`
// and collapses -1 with -2 — so an arena-index replacement need not reproduce it; do not
// add a consumer without re-grading. The `resolveAnnot` here (a spelling normalized
// character-by-character, then RE-PARSED by the checker's annotation grammar) is this
// module's largest destringify debt, and the arena entry `repRowOfTyStruct` just below
// takes the index directly. `renderFaithful` itself normalizes NOTHING in practice —
// every live caller hands in an already-canonical spelling — and is kept only because it
// is cheap. Hand-off: `docs/internals/destringify-types-program.md`.
export function repRowOfName(nm: string, lim: i32): i32 {
  if nm == "" { return -2 }
  // The `repNameCanonId` runaway cap (a render this long is never a legit key and
  // MINTS fresh arena types per probe — the >1GB crash family): decline it.
  if nm.length > 4096 { return -2 }
  const di = declTyIxOfName(renderFaithful(nm))
  if di < 0 { return -2 }
  const t = T.tys[di]
  if !(t is TyObj) { return -1 }
  repRowOfTyStruct(di, lim)
}

// The ARENA-INPUT twin of the deleted `monoIsRowMatch` (destringify D-MONOISTY, see
// `docs/internals/destringify-types-program.md`). Does a monomorphized instance's bound
// argument row — named `sk`, a genuinely NOMINAL row key (`#anon0`, minted by
// `collectAnonShapes`), which is why that side stays a name — SATISFY an `is` test whose
// type the checker already banked (`isVarTyIxOf`)? 1 yes · 0 no · -1 neither side names a
// row. The `want` side is the whole point: that resolver took a raw SOURCE SPELLING and
// put it through `renderFaithful` character surgery plus a `resolveAnnot` RE-PARSE to
// recover a type the checker had already resolved AT THAT NODE; handing in the arena index
// skips both, and `isVarTyIxOf` is the same bank this node's `isArmTagOfTy` and the
// narrow-push already read. `lim` is the caller's struct-table scan bound, PASSED rather
// than computed so this keeps the SAME contract as `repRowOfTyStruct`'s other call sites.
export function repIsRowMatchTy(sk: string, wantTy: i32, lim: i32): i32 {
  const skSi = repStructRowByName(sk)
  if skSi < 0 { return -1 }
  const wSi = repRowOfTyStruct(wantTy, lim)
  if wSi < 0 { return -1 }
  if wSi == skSi { return 1 }
  // Layout twins are ONE heap type, so they satisfy each other.
  if repStructSlotsTwin(skSi, wSi) != 0 { return 1 }
  0
}

// The struct-table scan bound this module's own resolvers pass to
// `repRowOfTyStruct` — the local twin of `emit_classify.sScanLim` (private there),
// kept here for the SAME layering reason `repStructRowByName` and `repStructRowByTy`
// are: emit_classify sits ABOVE this module, so a caller in `wasmEmit` cannot borrow
// its bound. Same guard, same reason: during `collectS`'s field-coding loop the
// IN-FLIGHT declaration has `sNames`/`sFieldStart` pushed but `sFieldCount` not yet,
// and a matcher that reads field metadata past that point reads out of bounds.
export function repScanLim(): i32 {
  let n = sNames.length
  if sFieldCount.length < n { n = sFieldCount.length }
  if sFieldStart.length < n { n = sFieldStart.length }
  n
}

// Populate `sTwin` (parallel to `sNames`): `sTwin[i]` is the representative struct
// slot for slot `i`'s WasmGC heap type — the smallest earlier slot with the same
// canonical key AND field-code layout, or `i` itself when `i` is the first of its
// structure. Keys are computed ONCE up front (`slotCanonId` per slot), then matched
// pairwise; a non-participating slot (-1 key) is always its own representative.
// Called from `mAssignTypeIndices` before `sHeapIdx` allocation.
export function buildStructTwins() {
  const keys: i32[] = []
  let i = 0
  while i < sNames.length {
    keys.push(slotCanonId(i))
    i = i + 1
  }
  sTwin = []
  i = 0
  while i < sNames.length {
    let rep = i
    if keys[i] >= 0 {
      let j = 0
      while j < i {
        if keys[j] == keys[i] && structFieldCodesEq(j, i) == 1 {
          rep = j
          j = i // stop at the first (smallest) twin
        }
        j = j + 1
      }
    }
    sTwin.push(rep)
    i = i + 1
  }
}

// ── The descriptor: tree-PRIMARY over the flat arms (Stage B wave 1) ─────────
// The recursive Rep tree is AUTHORITATIVE at this seam: wherever the flat arms claim
// coverage, the returned kind / null discipline / list-element vocabulary are the TREE's
// projections (`repTreeVKind` / `repTreeNulOf` / `repTreeListElemName`, certified
// equivalent to the flat answers by the `$VL_REP_SHADOW` sweeps), and the `$fnsig` token
// follows the kind through the one token table. The flat derivation still decides two
// things the tree does not own yet: COVERAGE — a shape the flat alphabet cannot name keeps
// rejecting through the legacy path even where the tree knows more — and the nominal SLOT
// (`rdSlot`), since the tree's hash-cons may surface a TWIN slot, same layout at a
// different index. The flat facts remain as the debug-mode CROSS-CHECK (the shadow harness
// at the end of this file); where the tree has no flat spelling at a flat-covered type
// (`repTreeVKind` = null) the flat answer stands, a defensive fallback, not a policy.
export function repOfTy(ty: i32): RepDesc {
  const d = repOfTyFlat(ty)
  if d.rdCovered == 0 { return d }
  const tix = repTreeOfTy(ty)
  const tk = repTreeVKind(tix)
  if tk == null { return d }
  const td = repMk(tk, repTreeNulOf(tix), repTreeListElemName(tix))
  td.rdSlot = d.rdSlot
  td
}

// ── The flat derivation: one table-driven arm per `Ty` variant ───────────────
// INVARIANT: every covered arm must decide the rep EXACTLY as the emitter's
// annotation-name classifier ladder (`vtKindOfType`'s arm order) does for the
// same type — the migration gates (fixpoint + corpus byte-compare) hold each
// arm to that. The ladder's priority order is inherent here: a `Ty` is exactly
// one variant, so no arm can shadow another.
function repOfTyFlat(ty: i32): RepDesc {
  if ty < 0 { return repUncovered() }
  const t = T.tys[ty]
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th arena variant breaks
  // the self-compile here rather than silently answering `repUncovered()`, which
  // reads as "this shape's rep is not derivable" and hands the consumer back to
  // its legacy name ladder — a valid-looking answer for the wrong reason.
  match t {
    TyPrim => {
      return repOfPrim(t.primName)
    }
    TyFunc => {
      // A function type is the closure fat-pointer. (A nullable closure is a
      // `TyNullable`, a closure ARRAY a `TyArray` — each classified by its own arm,
      // so the bare-arrow ambiguity of the name-based test cannot arise.)
      return repMk("closure", 0, "")
    }
    TyObj => {
      // A union-VARIANT member is the concrete variant struct ref (its slot is a
      // variant index, not a struct-table index); any other object shape is a
      // standalone struct ref.
      if tyIxIsVariantMember(ty) { return repMk("variant", 0, "") }
      const d = repMk("struct", 0, "")
      d.rdSlot = repSlotOfTy(ty)
      return d
    }
    TyUnion => {
      // A homogeneous string-literal union: a DECLARED alias (`type K = "a"|"b"`)
      // — or a checker-minted COPY of one, recognized through the b1 alias
      // PROVENANCE (`tyLitUnionAliasIx`; narrowing/join/subtraction re-mint the
      // alias at a fresh index) — reps as the interned i32 atom. An INLINE one
      // is name-softened to `string` by the canon pass, and its rep questions
      // route through the name ladder — uncovered here (the atom-vs-string
      // split is the alias-ness, which is checker metadata, not structure).
      if tyIsLitUnion(ty) {
        if tyLitUnionAliasIx(ty) >= 0 { return repMk("i32", 0, "") }
        return repUncovered()
      }
      // The EXPANDED nullable-litunion `"a" | "b" | null` — a null member plus an
      // all-quoted-literal remainder. It is the SAME TYPE as the two-part `K | null`
      // spelling `repOfNullable` gives the i32 atom + `-1` sentinel niche (`rdNul` 3)
      // fifty lines below, so it must get the SAME rep; without this arm it fell to
      // `tyIsValueUnionBox` and reps'd as the union BOX, while every read classified
      // from the arena — where the two spellings are one type — and lowered the atom.
      // `type K = "ab" | "zz" | null` interns as exactly this shape, so its cell was
      // built as a box and `print(v)` handed that `(ref $box)` to `__print_i32__`:
      // INVALID WASM. No alias gate here, matching `repOfNullable`: canon PRESERVES a
      // nullable litunion's members (`nulLitUnionPreserve`), so the inline and aliased
      // spellings both rep as the atom.
      if tyIsNullableLitUnion(ty) { return repMk("i32", 3, "") }
      // A single-member object union is the canonicalized `{a} & {b}` struct
      // alias — reps as the struct itself.
      if t.uMembers.length == 1 {
        const m = T.tys[t.uMembers[0]]
        if m is TyObj { return repMk("struct", 0, "") }
        return repUncovered()
      }
      // A `{tag, value}` value/struct union box. (Numeric literal unions —
      // `0 | 1` — are neither litunion-atoms nor boxes; they canon-collapse to
      // their base scalar and stay with the name ladder.)
      if tyIsValueUnionBox(ty) { return repMk("union", 0, "") }
      return repUncovered()
    }
    TyNullable => {
      return repOfNullable(t.nInner)
    }
    TyArray => {
      return repOfArray(t.aElem)
    }
    TyMap => {
      return repOfMap(t.mKey, t.mVal, t.mSet)
    }
    TyVar => {
      // A generic type PARAMETER — the monomorphizer instantiates it, and the
      // INSTANCE is what this query is asked about.
    }
    TyLit => {
      // A bare literal type — canon widens it to its base scalar (or folds it
      // into its enclosing litunion), so no rep is decided here.
    }
    TyErr => {
      // The error/unknown hole — a rejected program never reaches emit.
    }
    TyNeg => {
      // A negation — `intersectTy` consumes it during checking; nothing
      // structural survives to carry a rep.
    }
  }
  // The four empty arms above land here: no wasm rep of their own, so the
  // consumer keeps its legacy name-based path (`rdCovered == 0`).
  repUncovered()
}

function repOfPrim(pn: PrimName): RepDesc {
  // boolean shares the i32 rep; `void` follows the ladder's fallthrough ("i32")
  // — the void-ness of a RESULT is a separate axis (`fRetVoid`), not a valtype.
  if pn == "i32" || pn == "boolean" { return repMk("i32", 0, "") }
  if pn == "i64" { return repMk("i64", 0, "") }
  if pn == "f64" { return repMk("f64", 0, "") }
  if pn == "f32" { return repMk("f32", 0, "") }
  if pn == "string" { return repMk("str", 0, "") }
  if pn == "void" { return repMk("i32", 0, "") }
  // `null` (and any future prim) — no standalone rep.
  repUncovered()
}

// A nullable's rep is decided by its INNER variant — four distinct null
// disciplines exist (see `rdNul`), one per inner rep family.
function repOfNullable(inner: i32): RepDesc {
  if inner < 0 { return repUncovered() }
  const it = T.tys[inner]
  if it is TyPrim {
    // `string | null` — the nullable raw-array ref niche.
    if it.primName == "string" { return repMk("nulstr", 1, "") }
    // `boolean | null` — the i32 sentinel-2 niche; the VALTYPE is plain i32.
    if it.primName == "boolean" { return repMk("i32", 2, "") }
    // A nullable SCALAR (`i32 | null`, `f64 | null`, …) has no spare value to
    // niche into — it boxes as a value union whose `null` is a member atom.
    if (
      it.primName == "i32" ||
      it.primName == "i64" ||
      it.primName == "f64" ||
      it.primName == "f32"
    ) {
      return repMk("union", 4, "")
    }
    return repUncovered()
  }
  // `((…) => …) | null` — the closure fat-pointer made nullable.
  if it is TyFunc { return repMk("nulclosure", 1, "") }
  if it is TyObj {
    // `S | null` over a standalone struct — the nullable struct ref. A VARIANT
    // member's nullable stays with the name ladder (its slot vocabulary is the
    // variant index, and the ladder's nulstruct arm resolves it by name).
    if tyIxIsVariantMember(inner) { return repUncovered() }
    return repMk("nulstruct", 1, "")
  }
  if it is TyUnion {
    // `K | null` over a litunion — the i32 atom with the -1 null sentinel (the
    // members are preserved through canon for exactly this classification).
    if tyIsLitUnion(inner) { return repMk("i32", 3, "") }
    // `(A | B) | null` — the box already has a null member atom.
    if tyIsValueUnionBox(inner) { return repMk("union", 4, "") }
    return repUncovered()
  }
  if it is TyArray {
    // `i32[] | null` / `boolean[] | null` / litunion `K[] | null` — the nullable i32-list
    // ref (a litunion's atoms are interned i32 ids, sharing the i32-list backing). Every
    // OTHER nullable list (scalar-elem, ref-elem) has no settled rep yet — those must keep
    // failing loudly through the legacy chain.
    if it.aElem >= 0 {
      const et = T.tys[it.aElem]
      if et is TyPrim {
        if et.primName == "i32" || et.primName == "boolean" {
          return repMk("nullist", 1, "i32")
        }
        // A DISTINCT-backing nullable scalar list — its own `(ref null $wrapper)` niche over
        // the leaf list wrapper (`string[]|null` → `$mkListIdx`, `f64[]` → `$fl64TypeIdx`,
        // `i64[]` → `$il64TypeIdx`, `f32[]` → `$fl32TypeIdx`). A non-null list value subtypes
        // the nullable slot; a bare `null` is `ref.null $wrapper`.
        if et.primName == "string" { return repMk("nulstrlist", 1, "string") }
        if et.primName == "f64" { return repMk("nulf64list", 1, "f64") }
        if et.primName == "i64" { return repMk("nuli64list", 1, "i64") }
        if et.primName == "f32" { return repMk("nulf32list", 1, "f32") }
        // D979 — the PACKED byte list joins the nullable-scalar-list family.
        if et.primName == "u8" { return repMk("nulu8list", 1, "u8list") }
      }
      if tyIsLitUnion(it.aElem) { return repMk("nullist", 1, "i32") }
      // `(string | null)[] | null` — a nullable-ELEMENT string list under the outer
      // null. The backing is the SAME `$mkListIdx` wrapper as `string[]` (a string
      // element is already a nullable ref at the wasm level — `nameIsNulStrList`), so
      // the nullable CELL is the same `nulstrlist` niche as `string[] | null`. Left
      // uncovered, the whole kind ladder fell through to the i32 DEFAULT and the call
      // site pushed the wrapper ref into an i32 param slot — INVALID-WASM (fuzz-nightly
      // plain leg, seed 154928295 d6). The element-READ discipline (the element stays
      // `(ref null $aTypeIdx)`, narrowed with `!= null`) is `exprNulStrArray`'s; the
      // OTHER nullable-scalar elements (`(f64|null)[] | null`, …) are value-union-BOX
      // element lists (a scalar has no null niche) and stay with the legacy chain.
      if et is TyNullable {
        const eit = T.tys[et.nInner]
        if eit is TyPrim {
          if eit.primName == "string" {
            return repMk("nulstrlist", 1, "string")
          }
        }
        // `({a, f, z} | null)[] | null` — a nullable-STRUCT-element ref list under the
        // outer null. The inner list is the plain struct ref list (its `(ref null $S)`
        // backing already holds the element nulls — the bare `(S|null)[]` spelling works
        // for free), so the nullable CELL is the established `nulreflist` (kind 18)
        // niche, exactly like `S[][] | null`. Left uncovered, the name ladder's
        // `retNulRefArrFlag` missed the paren-grouped nullable-shape element spelling
        // and the param fell through to the i32 DEFAULT — the call site pushed the
        // wrapper ref into an i32 slot: INVALID-WASM (fuzz-nightly bm leg, seed
        // 160804094 d5). A variant-member element keeps the ladder (its slot vocabulary
        // is the variant index).
        if eit is TyObj {
          if !tyIxIsVariantMember(et.nInner) {
            return repMk("nulreflist", 1, "struct")
          }
        }
      }
    }
    return repUncovered()
  }
  // A nullable MAP (the niche-exempt `{[string]: T} | null`) and the rest —
  // legacy owns them.
  repUncovered()
}

// An array's rep is decided by its ELEMENT variant — one wrapper level, never
// the element's own descriptor (which is what keeps this arm cycle-free).
function repOfArray(elem: i32): RepDesc {
  // An element hole (`[]` never pinned) has no rep to claim.
  if elem < 0 { return repUncovered() }
  const et = T.tys[elem]
  if et is TyPrim {
    if et.primName == "i32" || et.primName == "boolean" {
      return repMk("list", 0, "i32")
    }
    if et.primName == "f64" { return repMk("f64list", 0, "f64") }
    if et.primName == "i64" { return repMk("i64list", 0, "i64") }
    if et.primName == "f32" { return repMk("f32list", 0, "f32") }
    // `u8[]` — the PACKED byte list. Its element is a STORAGE type: one byte in the
    // backing, an i32 at every value seam (`array.get_u` widens, `array.set` truncates).
    // The descriptor records the element as `"u8"` so the list layer can pick the packed
    // backing; nothing downstream treats `"u8"` as a scalar VALUE kind, because there is
    // no such value — see `TY_U8` in the checker.
    if et.primName == "u8" { return repMk("u8list", 0, "u8") }
    if et.primName == "string" { return repMk("strlist", 0, "string") }
    return repUncovered()
  }
  // `((i32) => i32)[]` — a closure-element ref list.
  if et is TyFunc { return repMk("reflist", 0, "closure") }
  // `S[]` / `{f: i32}[]` — a struct-element ref list (a variant-member element
  // is also a ref-list element; the slot layer resolves which).
  if et is TyObj { return repMk("reflist", 0, "struct") }
  if et is TyUnion {
    // `K[]` over a DECLARED litunion alias, a provenanced COPY of one, OR a genuinely
    // INLINE `("a" | "b")[]` — all three are atom-id elements riding the i32 list. The
    // alias gate that used to stand here was the root home of the #1198 miscompile: the
    // canon pass softens a BARE inline union to `string`, so the annotation renders
    // `string[]` and every NAME-driven classifier coded the binding a string list while
    // every ARENA-driven path built i32 atom ids. That softening is a fact about the BARE
    // position; at the ELEMENT position the two spellings are one type, exactly as
    // `repOfNullable`'s list arm (`tyIsLitUnion(it.aElem)` → `nullist`), `tyIsI32LeafElem`
    // and `rtNulDiscOf` have always had it — ungated. Union-BOX-element lists keep their
    // still-irregular legacy seams.
    if tyIsLitUnion(elem) { return repMk("list", 0, "i32") }
    return repUncovered()
  }
  // Nested arrays, nullable elements, map elements — legacy owns.
  repUncovered()
}

// A string-keyed map (or Set): the mono `$mapStruct` values (i32 / boolean /
// aliased litunion), plus the SCALAR/STRING typed values whose kind the mv
// interner (`mvValKindOfName`, in emit_classify above this module) supports
// unconditionally — scalars/strings, aliased litunions, and the composite
// families with gate-free admission (closures, arrays, nested maps, null-free
// unions). Struct values (intern-state-gated) and nullable values (the -3
// remainder family) stay uncovered — the slot layer still owns those gates.
function repOfMap(mKey: i32, mVal: i32, mSet: i32): RepDesc {
  if mKey >= 0 {
    const kt = T.tys[mKey]
    if kt is TyPrim {
      if kt.primName == "string" {
        // A Set is internally a boolean-valued map — always the mono shape.
        if mSet == 1 { return repMk("map", 0, "") }
        if mVal >= 0 {
          const vt = T.tys[mVal]
          if vt is TyPrim {
            if vt.primName == "i32" || vt.primName == "boolean" {
              return repMk("map", 0, "")
            }
            // SCALAR/STRING typed values (`{[string]: f64}`, …): mv kinds 3/10/11/13 —
            // every one of them the ladder's `retMapFlag` gate (`mvValKindOfName != -3`)
            // already admits as `"map"`, so the descriptor decides identically. The
            // value's own rep (scalar vals list vs string-ref list) is the mv-slot
            // layer's, not the kind's.
            if (
              vt.primName == "string" ||
              vt.primName == "i64" ||
              vt.primName == "f64" ||
              vt.primName == "f32"
            ) {
              return repMk("map", 0, "")
            }
          }
          // An ALIASED-litunion value (`{[string]: K0}`): each value is the interned
          // i32 atom, so the map is the MONO i32 map (`mvValKindOfName` → -1). The
          // alias-only gate mirrors the array-element arm: an INLINE litunion value's
          // spelling softens to `string` in canon names, so no index-level answer
          // exists for it — uncovered, legacy owns.
          if tyIsLitUnion(mVal) {
            if tyLitUnionAliasIx(mVal) >= 0 { return repMk("map", 0, "") }
          }
          // COMPOSITE values whose ladder admission is UNCONDITIONAL — a FUNCTION
          // value (kind 14, any arrow-carrying name), an ARRAY value (kind 6: the
          // scalar-array names and `nameIsRefArray` between them admit every `…[]`
          // spelling) and a NESTED map value (kind 6) — each map to an mv kind with
          // no name-domain gate, so the descriptor decides identically. A STRUCT
          // value stays uncovered (`structIndexByValName` is an INTERN-state gate the
          // arena cannot mirror), and so does a NULLABLE value (the -3 remainder —
          // the un-repped list/closure niches — lives in that family).
          if vt is TyFunc { return repMk("map", 0, "") }
          if vt is TyArray { return repMk("map", 0, "") }
          if vt is TyMap { return repMk("map", 0, "") }
          // A UNION value with 2+ members and NO null-ish member (`{[string]:
          // i32 | string}`, `{[string]: C | S}`, a map-member arm): the ladder's
          // kind-2 arm admits it by member count alone. A PURE litunion is the
          // atom/mono family (aliased covered above, inline uncovered); a null
          // member routes the ladder through the nullable-union block whose -3
          // remainder the arena does not re-derive — both stay uncovered here.
          if vt is TyUnion {
            const ms = vt.uMembers
            if ms.length >= 2 && !tyIsLitUnion(mVal) {
              let vHasNull = false
              let vi = 0
              while vi < ms.length {
                const vm = T.tys[ms[vi]]
                if vm is TyPrim {
                  if vm.primName == "null" { vHasNull = true }
                } else if vm is TyNullable {
                  vHasNull = true
                }
                vi = vi + 1
              }
              if !vHasNull { return repMk("map", 0, "") }
            }
          }
        }
      }
    }
  }
  repUncovered()
}

// ── The node-level bridge ─────────────────────────────────────────────────────
// `repOf` for an AST node (an annotation / expression the checker recorded a
// type for): the arena derivation, plus the ONE recovery only the node can
// make — a SAME-SHAPE union (`A | B` with structurally identical members)
// collapses to a single `TyObj` in the arena, losing its union-ness, while the
// emitter still boxes it for tag discrimination. The node's name (a top-level
// `|`) is the only witness; `nodeTyIsUnionAlias` performs that test.
export function repOfNode(nodeIx: i32): RepDesc {
  const d = repOfTy(nodeTyIxOf(nodeIx))
  if d.rdCovered == 1 {
    if d.rdKind == "struct" || d.rdKind == "variant" {
      if nodeTyIsUnionAlias(nodeIx) { return repMk("union", 0, "") }
    }
  }
  d
}

// ── Transitive scalar-mention query (cycle-safe) ─────────────────────────────
// Whether a type CONTAINS an i64 / f64 / f32 leaf anywhere — through arrays,
// nullables, unions, map keys/values, function params/results, object fields,
// and negations. Drives the print-import scan: a program that can hold one of
// these scalars can narrow/read/print one, so the matching `__print_*__`
// import must exist. Returned as a bitmask (`REP_SCAL_*`).
export const REP_SCAL_I64 = 1
export const REP_SCAL_F64 = 2
export const REP_SCAL_F32 = 4

// Generation-stamped visited marks + a completed-QUERY memo, both indexed by
// `Ty`-arena index. The visited stamp makes one query terminate on arena
// CYCLES (recursive structural types); the memo is written only for a query's
// ROOT — a completed walk covers the root's whole reachable component, so its
// union is exact — and folded in whenever a later walk re-reaches that node
// (interior nodes of a cycle are never memoized mid-walk, which could record
// an under-approximation). Reset per program (`repReset`): arena indices are
// re-minted per compile.
let repSeenGen: i32[] = []
let repMaskMemo: i32[] = []
let repGen = 0

export function repReset() {
  repSeenGen = []
  repMaskMemo = []
  repGen = 0
  // The canonical-key memo + slot cache (above) are also arena-index-keyed —
  // drop them per program too. (Their generation stamps already catch this via
  // `initChecker`'s epoch advance; this keeps the reset story in one place.)
  repKeyMemo = []
  repKeyMemoEpoch = -1
  repSlotByDecl = []
  repSlotKeySi = []
  repSlotKeyN = []
  repSlotCacheEpoch = -1
  repSlotCacheUserVer = -1
  repSlotCacheLen = -1
  // The recursive rep TREE (below) is arena-index-keyed too — force its next
  // `rtSync` to rebuild from scratch.
  repTreeDrop()
  0
}

function repGrowTo(n: i32) {
  while repSeenGen.length < n { repSeenGen.push(0) }
  while repMaskMemo.length < n { repMaskMemo.push(-1) }
  0
}

export function repTyScalarMask(root: i32) {
  if root < 0 { return 0 }
  repGrowTo(T.tys.length)
  if root < repMaskMemo.length {
    if repMaskMemo[root] >= 0 { return repMaskMemo[root] }
  }
  repGen = repGen + 1
  let mask = 0
  // An index worklist (breadth-order); `wp` is the read cursor.
  const work: i32[] = []
  work.push(root)
  let wp = 0
  while wp < work.length {
    const ix = work[wp]
    wp = wp + 1
    if ix >= 0 && ix < T.tys.length {
      // The arena can GROW mid-emit (monomorphization records late types) —
      // re-grow so the stamp arrays cover any index the walk reaches.
      repGrowTo(T.tys.length)
      if repSeenGen[ix] != repGen {
        repSeenGen[ix] = repGen
        if repMaskMemo[ix] >= 0 {
          // A prior query completed from this node — fold its exact component
          // union instead of re-walking.
          mask = mask | repMaskMemo[ix]
        } else {
          const t = T.tys[ix]
          // EXHAUSTIVE over `Ty` and deliberately `_`-less: the checker's match
          // exhaustiveness names any arena variant this walk stops descending
          // through, so a 12th variant breaks the self-compile here instead of
          // leaving the mask silently 0 ("mentions no wide scalar") — the
          // dangerous direction, since a MISSED mention drops a `__print_*__`
          // import the program needs. The three empty arms are the LEAVES with
          // nothing to descend into; each carries its reason, so the omission is
          // a decision on the page rather than a fall-through.
          match t {
            TyPrim => {
              if t.primName == "i64" { mask = mask | REP_SCAL_I64 }
              if t.primName == "f64" { mask = mask | REP_SCAL_F64 }
              if t.primName == "f32" { mask = mask | REP_SCAL_F32 }
            }
            TyArray => {
              work.push(t.aElem)
            }
            TyNullable => {
              work.push(t.nInner)
            }
            TyUnion => {
              let mi = 0
              while mi < t.uMembers.length {
                work.push(t.uMembers[mi])
                mi = mi + 1
              }
            }
            TyMap => {
              work.push(t.mKey)
              work.push(t.mVal)
            }
            TyFunc => {
              let pi = 0
              while pi < t.fnParamTypes.length {
                work.push(t.fnParamTypes[pi])
                pi = pi + 1
              }
              work.push(t.fnRet)
            }
            TyObj => {
              let fi = 0
              while fi < t.objFieldTypes.length {
                work.push(t.objFieldTypes[fi])
                fi = fi + 1
              }
            }
            TyNeg => {
              work.push(t.negTy)
            }
            TyLit => {
              // A literal type MENTIONS the scalar it softens to, and the descent is
              // through the ONE home for that rule (`litBaseTy`) so the mask agrees with
              // every other consumer of it.
              //
              // Do NOT assume the inhabitants are all SPELLED in source, so that
              // `scanPrintUse`'s `NumLit` / `numLexIsFloat` arm has already claimed the
              // import: `null` inhabits `N | null` without being a member, so `g(null)`
              // over `type N = 1.5 | 2.5` spells no float value anywhere while the
              // `is`-narrowed read IS an f64 — `print` then routed to a `__print_f64__`
              // the import section never declared, giving check-clean invalid wasm.
              // Passing a member literal at any one call site hides it.
              work.push(litBaseTy(t))
            }
            TyErr => {
              // The error/unknown hole — assignable both ways, so it has no
              // leaf of its own to mention.
            }
            TyVar => {
              // A generic type PARAMETER: the monomorphizer substitutes it
              // before this query runs, so the mask is read off the instance.
            }
          }
        }
      }
    }
  }
  repMaskMemo[root] = mask
  mask
}

// The scalar-mention mask of the type the checker recorded for node `ix`, or
// -1 when the node has NO recorded type — the caller must fall back to its
// name-based test (an emitter-synthesized node past the typed-IR table, or an
// emitter-internal name `nameToTy` cannot resolve).
export function repNodeScalarMask(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return -1 }
  repTyScalarMask(ty)
}

// The `REP_SCAL_*` mask a LOAD-WIDTH intrinsic call RESULTS in, read off the NAME
// (`buffer-design.md` §C2's matrix). 0 for every width that lands in an i32 — the four
// narrow loads and `__load_i32__` — and for any name that is not a load width.
//
// Keyed by name, NOT by `nodeTyIxOf`, and deliberately so: the name determines the
// result type totally (there is no polymorphism in this family), whereas the arena is
// known to answer -1 for nodes it never recorded — an emit-time-cloned monomorphized
// instance body being the standing example. The import scan's failure direction is
// asymmetric: an EXTRA `__print_f64__` import is a harmless unused entry, a MISSED one
// is invalid wasm (a print routed to an import index that was never declared). So the
// scan takes the total answer.
export function repMemLoadScalarMask(name: string) {
  if name == "__load_i64__" { return REP_SCAL_I64 }
  if name == "__load_f32__" { return REP_SCAL_F32 }
  if name == "__load_f64__" { return REP_SCAL_F64 }
  0
}

// ── The RECURSIVE rep tree (rep-rewrite Stage A — see `ROADMAP.md`) ──────────
// `repTreeOfTy` is the TOTAL, compositional successor of the flat descriptor above:
// where `RepDesc` classifies at most one wrapper deep and answers `rdCovered == 0` for
// every composition it cannot name, the tree denotes EVERY post-mono type — never a
// silent fallthrough, since a shape whose ABI policy does not exist yet becomes an
// EXPLICIT `unsup` node carrying a stable reason code (the Stage B burn-down unit; code
// list at `rtGo`). It is an index-linked ARENA hash-consed on a key of already-interned
// CHILD indices, not a recursive render, so interning stays O(size) and tree identity IS
// layout identity; construction memoizes by `Ty` index and stamps BEFORE recursing, so an
// arena cycle yields an index cycle that no participant can falsely merge into an earlier
// node. `RtKind` is a litunion, so it reps as an INTERNED i32 atom and the `k == "…"`
// ladders on `repOfTy`'s hot path lower to `i32.eq`; `rtAlloc`/`rtLeafOf` keep it closed.
type RtKind = "i32"
  | "bool"
  | "i64"
  | "f64"
  | "f32"
  | "str"
  | "u8"
  | "atom"
  | "list"
  | "map"
  | "box"
  | "closure"
  | "struct"
  | "nul"
  | "unsup"

let rtKind: RtKind[] = [] // node kind — see the grammar above
let rtDisc: i32[] = [] // kind-specific: nul discipline (rdNul's 1/2/3/4) ·
// struct 1 = union-VARIANT member · closure 1 = declared-void result
let rtChild: i32[] = [] // list elem / map val / nul inner; else -1
let rtSlot: i32[] = [] // struct: the interned struct-table slot, else -1
let rtTy: i32[] = [] // the arena index that BUILT the node — provenance for
// debugging only, never identity (a hash-cons merge keeps the first builder's)
let rtReason: string[] = [] // unsup: the policy reason-code, else ""
let rtKidStart: i32[] = [] // struct fields / box members / closure params+ret,
let rtKidCount: i32[] = [] // a [start,count) block in `rtKids`; -1 = the node
// is still under construction (the cycle re-entry marker)
let rtKids: i32[] = []
let rtByTy: i32[] = [] // Ty index → node index (-1 unfilled); the cycle breaker
let rtIntern: {[string]: i32} = Map() // structural key → node (hash-cons)
let rtWalkGen: i32[] = [] // per-node visit stamps (`repTreeUnsupReason`)
let rtWalkN = 0
let rtEpoch = -1
let rtUserVer = -1

// Invalidate the tree (the `repReset` hook): the next `rtSync` rebuilds.
function repTreeDrop() {
  rtEpoch = -1
  0
}

// LIFETIME. Generation-stamped on the CHECKER axes of the flat layer's memos:
// `tyMutEpoch` (in-place arena mutation re-keys everything) and `cUserTypesVer` (which
// arena index a spelling resolves to). Any bump drops the whole tree — conservative,
// like the key memo. `sNames.length` (slot claims) is deliberately NOT an axis: the
// AUTHORITY projections (kind / null discipline / list element — what `repOfTy` reads on
// the normal compile path) never consult `rtSlot`, and slot interning happens constantly
// during emit, so stamping on it would rebuild the tree once per interned slot. The only
// `rtSlot` consumer is the armed shadow harness, and `repShadowSweep` forces a full drop
// first, so its slot assertions always run over a tree built against the FINAL slot table.
// Building is LAZY, and a returned node index is valid only until the next checker
// mutation: consume it immediately, or re-query.
function rtSync() {
  if (rtEpoch == tyMutEpoch && rtUserVer == cUserTypesVer) { return 0 }
  rtKind = []
  rtDisc = []
  rtChild = []
  rtSlot = []
  rtTy = []
  rtReason = []
  rtKidStart = []
  rtKidCount = []
  rtKids = []
  rtByTy = []
  rtIntern = Map()
  rtWalkGen = []
  rtEpoch = tyMutEpoch
  rtUserVer = cUserTypesVer
  0
}

function rtAlloc(kind: RtKind, ty: i32): i32 {
  const ix = rtKind.length
  rtKind.push(kind)
  rtDisc.push(0)
  rtChild.push(-1)
  rtSlot.push(-1)
  rtTy.push(ty)
  rtReason.push("")
  rtKidStart.push(0)
  rtKidCount.push(-1)
  ix
}

function rtByTyPut(ty: i32, ix: i32) {
  while rtByTy.length <= ty { rtByTy.push(-1) }
  rtByTy[ty] = ix
  0
}

// A LEAF node (no children): interned by key directly — no throwaway
// allocation on a hit. The key grammar is shared with `rtInternKeyOf` (a leaf
// is the empty-suffix case), so a leaf and a composite can never collide.
function rtLeafOf(kind: RtKind, disc: i32, reason: string, ty: i32): i32 {
  const key = kind + "|" + i32ToStr(disc) + "|" + reason + "|"
  const hit = rtIntern[key] ?? -1
  if hit >= 0 {
    if ty >= 0 { rtByTyPut(ty, hit) }
    return hit
  }
  const ix = rtAlloc(kind, ty)
  rtDisc[ix] = disc
  rtReason[ix] = reason
  rtKidCount[ix] = 0
  rtIntern[key] = ix
  if ty >= 0 { rtByTyPut(ty, ix) }
  ix
}

// The structural (hash-cons) key of a COMPLETED node: kind + discriminator +
// reason + the child/kid node indices + (structs) the field names — child
// IDENTITY, not a recursive render, so equal keys mean equal layout trees.
// Field names ride along because the struct twin equivalence requires them
// (`repCanonKey` keys `{a:i32}` apart from `{b:i32}`).
function rtInternKeyOf(ix: i32): string {
  let s = rtKind[ix] + "|" + i32ToStr(rtDisc[ix]) + "|" + rtReason[ix] + "|"
  if rtChild[ix] >= 0 { s = s + "c" + i32ToStr(rtChild[ix]) + ";" }
  let k = 0
  while k < rtKidCount[ix] {
    s = s + i32ToStr(rtKids[rtKidStart[ix] + k]) + ","
    k = k + 1
  }
  if rtKind[ix] == "struct" {
    const t = T.tys[rtTy[ix]]
    if t is TyObj {
      let fi = 0
      while fi < t.objFieldNames.length {
        s = s + t.objFieldNames[fi] + ":"
        fi = fi + 1
      }
    }
  }
  s
}

function rtSetKids(ix: i32, kids: i32[]) {
  rtKidStart[ix] = rtKids.length
  let i = 0
  while i < kids.length {
    rtKids.push(kids[i])
    i = i + 1
  }
  rtKidCount[ix] = kids.length
  0
}

// Complete node `ix` (children filled): consult the hash-cons table. An
// existing structurally-identical node WINS — `ix` is orphaned (a small,
// bounded arena leak: at most one per distinct Ty per generation) and the Ty
// memo is redirected, folding nominal slot knowledge into the survivor. A
// cycle participant cannot reach here with a colliding key (its key contains
// its own index — see the CYCLES note above), so redirecting is always safe:
// nothing references the orphan.
function rtComplete(ix: i32, ty: i32): i32 {
  const key = rtInternKeyOf(ix)
  const hit = rtIntern[key] ?? -1
  if hit >= 0 && hit != ix {
    if rtSlot[hit] < 0 && rtSlot[ix] >= 0 { rtSlot[hit] = rtSlot[ix] }
    if ty >= 0 { rtByTyPut(ty, hit) }
    return hit
  }
  rtIntern[key] = ix
  ix
}

// The one TOTAL constructor: the rep tree of arena type `ty`. Always returns a
// node; a shape without a settled lowering policy returns an `unsup` node
// whose reason-code is one of the STABLE set (the coverage buckets):
//   hole · prim:<name> · litunion:noalias · union:single-nonobj ·
//   union:unclassified · nul:hole · nul:unclassified · list:hole · map:key ·
//   map:val-hole · neg · leaf:unnarrowable
export function repTreeOfTy(ty: i32): i32 {
  rtSync()
  rtGo(ty)
}

function rtGo(ty: i32): i32 {
  if ty < 0 { return rtLeafOf("unsup", 0, "hole", -1) }
  if ty < rtByTy.length {
    if rtByTy[ty] >= 0 { return rtByTy[ty] }
  }
  const t = T.tys[ty]
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th arena variant breaks
  // the self-compile here rather than silently taking the `leaf:unnarrowable`
  // bucket, which reads as a settled coverage answer.
  match t {
    TyPrim => {
      return rtOfPrim(t.primName, ty)
    }
    TyFunc => {
      return rtOfFunc(ty, t.fnParamTypes, t.fnRet)
    }
    TyObj => {
      return rtOfObj(ty, t.objFieldTypes)
    }
    TyUnion => {
      return rtOfUnion(ty, t.uMembers)
    }
    TyNullable => {
      return rtOfNullable(ty, t.nInner)
    }
    TyArray => {
      if t.aElem < 0 { return rtLeafOf("unsup", 0, "list:hole", ty) }
      const ix = rtAlloc("list", ty)
      rtByTyPut(ty, ix)
      // Split form retained ONE seed generation — not `rtChild[ix] = rtGo(…)`:
      // the PUBLISHED seed's indexed-store lowering predates this PR's fix (it
      // captures the list backing BEFORE the call, and the recursion's `rtAlloc`
      // pushes can REALLOCATE it — the store lands in the stale backing and the
      // node keeps child -1; the #918 eval-order family, list flavor). Safe to
      // fuse after the seed containing this fix publishes (B-chore-liststore-fuse).
      const elem = rtGo(t.aElem)
      rtChild[ix] = elem
      rtKidCount[ix] = 0
      return rtComplete(ix, ty)
    }
    TyMap => {
      return rtOfMap(ty, t.mKey, t.mVal, t.mSet)
    }
    TyNeg => {
      return rtLeafOf("unsup", 0, "neg", ty)
    }
    TyVar => {
      // A generic type PARAMETER — the monomorphizer instantiates it and the
      // INSTANCE gets the tree.
    }
    TyLit => {
      // A bare literal type — canon widens it to its base scalar, so no tree
      // policy is settled here.
    }
    TyErr => {
      // The error/unknown hole — a rejected program never reaches emit.
    }
  }
  // The three empty arms above land here: none has a standalone rep of its own,
  // so each becomes the STABLE `leaf:unnarrowable` coverage bucket.
  rtLeafOf("unsup", 0, "leaf:unnarrowable", ty)
}

function rtOfPrim(pn: PrimName, ty: i32): i32 {
  // `boolean` keeps its OWN leaf even though its valtype is i32: the flat slot
  // layer's canonical key distinguishes `{f:boolean}` from `{f:i32}` (pinned by
  // structural-non-twin-distinct.vl — the shadow harness caught the merged
  // version), so tree identity must too. `void` follows the flat ladder (the
  // void-ness of a RESULT is a separate axis — `rtDisc` on the closure node).
  if pn == "i32" { return rtLeafOf("i32", 0, "", ty) }
  if pn == "boolean" { return rtLeafOf("bool", 0, "", ty) }
  if pn == "i64" { return rtLeafOf("i64", 0, "", ty) }
  if pn == "f64" { return rtLeafOf("f64", 0, "", ty) }
  if pn == "f32" { return rtLeafOf("f32", 0, "", ty) }
  if pn == "string" { return rtLeafOf("str", 0, "", ty) }
  // `u8` — a STORAGE leaf, not a value leaf. It reaches this function only as an array
  // ELEMENT (the checker admits `u8` nowhere else), and `rtListVKind` is the only reader
  // that answers for it; a `u8` in any other tree position has no rep and correctly
  // finds none.
  if pn == "u8" { return rtLeafOf("u8", 0, "", ty) }
  if pn == "void" { return rtLeafOf("i32", 0, "", ty) }
  // `null` (and any future prim) — no standalone rep policy.
  rtLeafOf("unsup", 0, "prim:" + primNameStr(pn), ty)
}

function rtOfFunc(ty: i32, paramTys: i32[], retTy: i32): i32 {
  const ix = rtAlloc("closure", ty)
  rtByTyPut(ty, ix)
  if retTy >= 0 {
    const rt = T.tys[retTy]
    if rt is TyPrim {
      if rt.primName == "void" { rtDisc[ix] = 1 }
    }
  }
  const kids: i32[] = []
  let i = 0
  while i < paramTys.length {
    kids.push(rtGo(paramTys[i]))
    i = i + 1
  }
  // The RESULT rides as the last kid (void-ness is `rtDisc`, see above).
  kids.push(rtGo(retTy))
  rtSetKids(ix, kids)
  rtComplete(ix, ty)
}

function rtOfObj(ty: i32, fieldTys: i32[]): i32 {
  // Checker metadata in: a union-VARIANT member's slot vocabulary is the
  // variant index, not the struct table — the discriminator keeps the two
  // apart through hash-consing.
  let disc = 0
  if tyIxIsVariantMember(ty) { disc = 1 }
  rtOfObjAs(ty, ty, disc, fieldTys)
}

// The struct-node builder, split from `rtOfObj` so a single-member union can
// build its member's shape under the UNION's memo index with variant-ness
// forced off. `memoTy` keys `rtByTy` (the cycle breaker — any self-reference
// through the alias spelling resolves back to it); `objTy` names the fields
// (the intern key reads them through `rtTy`) and claims the slot.
function rtOfObjAs(memoTy: i32, objTy: i32, disc: i32, fieldTys: i32[]): i32 {
  const ix = rtAlloc("struct", objTy)
  rtByTyPut(memoTy, ix)
  rtDisc[ix] = disc
  rtSlot[ix] = repSlotOfTy(objTy)
  const kids: i32[] = []
  let fi = 0
  while fi < fieldTys.length {
    kids.push(rtGo(fieldTys[fi]))
    fi = fi + 1
  }
  rtSetKids(ix, kids)
  rtComplete(ix, memoTy)
}

function rtOfUnion(ty: i32, members: i32[]): i32 {
  if tyIsLitUnion(ty) {
    // Alias-ness as explicit input (b1): a DECLARED litunion alias — or a
    // checker-minted COPY of one, now index-visible through the alias
    // PROVENANCE the mint sites record (`tyLitUnionAliasIx`) — is the
    // interned i32 atom. What remains at a provenance-less index is a
    // GENUINELY inline litunion (`: "a" | "b"` spelled directly), whose flat
    // lowering is position-decided by the canon pass (softened to `string`
    // bare, preserved as atoms under `| null` / at list elements) — no single
    // compositional denotation exists for it, so it stays the explicit policy
    // node; the flat projections carry its positional truths.
    if tyLitUnionAliasIx(ty) >= 0 { return rtLeafOf("atom", 0, "", ty) }
    return rtLeafOf("unsup", 0, "litunion:noalias", ty)
  }
  // D-NULLITHOME: the EXPANDED nullable-litunion `"a" | "b" | null`. It is the SAME
  // type the two-part `K | null` spelling builds as a `nul` node with the atom-sentinel
  // discipline (disc 3) over the litunion inner, so build it identically here and let
  // the hash-cons fold the two spellings into ONE node. Without this arm it fell to the
  // `box` arm below and the TREE — which is AUTHORITATIVE over the flat kind at
  // `repOfTy` — answered "union" for a type every reader lowers as the i32 atom niche,
  // so a `type K = "ab" | "zz" | null` param/return got a `(ref $box)` valtype while its
  // body read the `-1` sentinel: INVALID WASM. The child is the same explicit
  // `litunion:noalias` policy node an INLINE `"a" | "b" | null` inner yields — the
  // member vocabulary stays the open question, the DISCIPLINE is decided.
  if tyIsNullableLitUnion(ty) {
    const nix = rtAlloc("nul", ty)
    rtByTyPut(ty, nix)
    rtDisc[nix] = 3
    rtChild[nix] = rtLeafOf("unsup", 0, "litunion:noalias", -1)
    rtKidCount[nix] = 0
    return rtComplete(nix, ty)
  }
  if members.length == 1 {
    const m = T.tys[members[0]]
    if m is TyObj {
      // The canonicalized `{a} & {b}` struct alias — a PLAIN struct, never a
      // variant: the emitter lowers a one-member union as the struct itself
      // (disc 0). The member's OWN index agrees since the variant-member
      // registration went arity-aware (the #920 irregularity (a) fix): a
      // single-member decl no longer marks its member a variant.
      return rtOfObjAs(ty, members[0], 0, m.objFieldTypes)
    }
    return rtLeafOf("unsup", 0, "union:single-nonobj", ty)
  }
  if tyIsValueUnionBox(ty) {
    const ix = rtAlloc("box", ty)
    rtByTyPut(ty, ix)
    const kids: i32[] = []
    let mi = 0
    while mi < members.length {
      kids.push(rtGo(members[mi]))
      mi = mi + 1
    }
    rtSetKids(ix, kids)
    return rtComplete(ix, ty)
  }
  // Numeric literal unions (`0 | 1`) canon-collapse to their base scalar and
  // never classify here; anything else is a policy gap, stated loudly.
  rtLeafOf("unsup", 0, "union:unclassified", ty)
}

// The nullable DISCIPLINE for inner type `inner` — `rdNul`'s vocabulary
// (1 nullable ref niche · 2 i32 sentinel 2 · 3 atom sentinel -1 · 4 boxed),
// or 0 when no discipline exists (the nullable is a policy gap).
function rtNulDiscOf(inner: i32): i32 {
  const it = T.tys[inner]
  if it is TyPrim {
    if it.primName == "string" { return 1 }
    if it.primName == "boolean" { return 2 }
    if (
      it.primName == "i32" ||
      it.primName == "i64" ||
      it.primName == "f64" ||
      it.primName == "f32"
    ) {
      return 4
    }
    return 0
  }
  if it is TyFunc { return 1 }
  if it is TyObj { return 1 }
  if it is TyUnion {
    // ANY litunion inner takes the atom sentinel — deliberately NOT gated on
    // alias identity, mirroring the flat arm AND the canon pass: an
    // alias-derived inner is atom-backed (usually a provenanced COPY now —
    // b1), and a genuinely-inline `"a" | "b" | null` is PRESERVED as atoms
    // too (`nulLitUnionPreserve` — the nullable position is atom for both
    // forms). The INNER node may still be the explicit `litunion:noalias`
    // policy node (see `rtOfUnion`): the discipline is decided even where
    // the member vocabulary is the open question.
    if tyIsLitUnion(inner) { return 3 }
    if tyIsValueUnionBox(inner) { return 4 }
    if it.uMembers.length == 1 {
      const m = T.tys[it.uMembers[0]]
      if m is TyObj { return 1 }
    }
    return 0
  }
  if it is TyArray { return 1 }
  if it is TyMap { return 1 }
  // Nullable-of-nullable, negation, unnarrowable leaves — no discipline.
  0
}

function rtOfNullable(ty: i32, inner: i32): i32 {
  if inner < 0 { return rtLeafOf("unsup", 0, "nul:hole", ty) }
  const disc = rtNulDiscOf(inner)
  if disc == 0 { return rtLeafOf("unsup", 0, "nul:unclassified", ty) }
  const ix = rtAlloc("nul", ty)
  rtByTyPut(ty, ix)
  rtDisc[ix] = disc
  // Split form retained ONE seed generation — see the `rtGo` list arm: the
  // recursion can reallocate `rtChild`'s backing under a fused store
  // (B-chore-liststore-fuse).
  const innerIx = rtGo(inner)
  rtChild[ix] = innerIx
  rtKidCount[ix] = 0
  rtComplete(ix, ty)
}

function rtOfMap(ty: i32, mKey: i32, mVal: i32, mSet: i32): i32 {
  let keyOk = 0
  if mKey >= 0 {
    const kt = T.tys[mKey]
    if kt is TyPrim {
      if kt.primName == "string" { keyOk = 1 }
    }
  }
  // Only string-keyed maps have a rep (the grammar's `Map(val)`).
  if keyOk == 0 { return rtLeafOf("unsup", 0, "map:key", ty) }
  if mSet != 1 && mVal < 0 { return rtLeafOf("unsup", 0, "map:val-hole", ty) }
  const ix = rtAlloc("map", ty)
  rtByTyPut(ty, ix)
  // Split form retained ONE seed generation — see the `rtGo` list arm: the
  // value recursion (and even a leaf intern) can reallocate `rtChild`'s
  // backing under a fused store (B-chore-liststore-fuse).
  let valIx = -1
  if mSet == 1 {
    // A Set is internally a boolean-valued map — the mono value rep.
    valIx = rtLeafOf("bool", 0, "", -1)
  } else {
    valIx = rtGo(mVal)
  }
  rtChild[ix] = valIx
  rtKidCount[ix] = 0
  rtComplete(ix, ty)
}

// ── Tree accessors + flat projections ────────────────────────────────────────
// Read-only structure accessors (the arena arrays stay private so every
// consumer goes through one vocabulary).
export function repTreeKindOf(ix: i32): string {
  if ix < 0 { return "" }
  rtKind[ix]
}

export function repTreeChildOf(ix: i32): i32 {
  if ix < 0 { return -1 }
  rtChild[ix]
}

export function repTreeKidCountOf(ix: i32): i32 {
  if ix < 0 { return 0 }
  if rtKidCount[ix] < 0 { return 0 }
  rtKidCount[ix]
}

export function repTreeKidAt(ix: i32, k: i32): i32 {
  rtKids[rtKidStart[ix] + k]
}

export function repTreeSlotOf(ix: i32): i32 {
  if ix < 0 { return -1 }
  rtSlot[ix]
}

export function repTreeReasonOf(ix: i32): string {
  if ix < 0 { return "" }
  rtReason[ix]
}

// The tree's projection onto the flat `VKind` vocabulary — the fact the
// differential harness compares against `rdKind`, and the shim Stage B
// consumers migrate through. `null` = the tree has no flat spelling (an
// `unsup` node, or a composition the flat alphabet cannot name yet — e.g. a
// nested list, a ref-element nullable list): the flat layer answers
// `rdCovered == 0` there, so the two stay comparable exactly where both speak.
export function repTreeVKind(ix: i32): VKind | null {
  if ix < 0 { return null }
  const k = rtKind[ix]
  if k == "i32" || k == "bool" { return "i32" }
  if k == "i64" { return "i64" }
  if k == "f64" { return "f64" }
  if k == "f32" { return "f32" }
  if k == "str" { return "str" }
  if k == "atom" { return "i32" }
  if k == "closure" { return "closure" }
  if k == "box" { return "union" }
  if k == "map" { return "map" }
  if k == "struct" {
    if rtDisc[ix] == 1 { return "variant" }
    return "struct"
  }
  if k == "list" { return rtListVKind(rtChild[ix]) }
  if k == "nul" { return rtNulVKind(ix) }
  null
}

function rtListVKind(elem: i32): VKind | null {
  if elem < 0 { return null }
  const ek = rtKind[elem]
  // An INLINE litunion element — the explicit `litunion:noalias` POLICY node
  // (`rtOfUnion` keeps it, because the BARE position's lowering is decided by
  // the canon pass, not compositionally). At the LIST position the policy is
  // settled: atom ids on the i32 list, the same answer the alias spelling
  // gets. This is the exact mirror of `rtNulDiscOf`'s ungated `disc 3` — the
  // nullable position has always carried its own positional truth here while
  // leaving the member vocabulary an open question at the child.
  if ek == "unsup" {
    if rtReason[elem] == "litunion:noalias" { return "list" }
    return null
  }
  // Atom elements share the i32-list backing (interned i32 ids), as do
  // boolean elements (same valtype).
  if ek == "i32" || ek == "bool" || ek == "atom" { return "list" }
  if ek == "i64" { return "i64list" }
  if ek == "f64" { return "f64list" }
  if ek == "f32" { return "f32list" }
  if ek == "u8" { return "u8list" }
  if ek == "str" { return "strlist" }
  if ek == "struct" || ek == "closure" { return "reflist" }
  null
}

function rtNulVKind(ix: i32): VKind | null {
  const d = rtDisc[ix]
  // The i32-sentinel niches (`boolean | null`, litunion `K | null`) keep the
  // plain i32 valtype; the boxed discipline is the value-union box itself.
  if d == 2 || d == 3 { return "i32" }
  if d == 4 { return "union" }
  if d != 1 { return null }
  const inner = rtChild[ix]
  if inner < 0 { return null }
  const k = rtKind[inner]
  if k == "str" { return "nulstr" }
  if k == "closure" { return "nulclosure" }
  if k == "struct" {
    // A nullable VARIANT member's slot vocabulary is the variant index — the
    // flat alphabet has no kind for it (the name ladder owns it).
    if rtDisc[inner] == 1 { return null }
    return "nulstruct"
  }
  if k == "map" { return "nulmap" }
  if k == "list" {
    const elem = rtChild[inner]
    if elem < 0 { return null }
    const ek = rtKind[elem]
    if ek == "i32" || ek == "bool" || ek == "atom" { return "nullist" }
    // The flat nullable arm covers ANY litunion element as atom-backed
    // (the pinned litunion-nullable-list.vl runs an INLINE one as atoms) —
    // mirror that here even where the tree keeps the elem an explicit policy
    // node. Alias-DERIVED elements are real atom nodes since b1 (provenance),
    // and the flat bare-array arm now agrees on them; only the genuinely-
    // inline element remains position-decided (see `rtOfUnion`).
    if ek == "unsup" {
      if rtReason[elem] == "litunion:noalias" { return "nullist" }
    }
    if ek == "str" { return "nulstrlist" }
    if ek == "f64" { return "nulf64list" }
    if ek == "i64" { return "nuli64list" }
    if ek == "f32" { return "nulf32list" }
    if ek == "u8" { return "nulu8list" }
    return null
  }
  null
}

// The tree's `rdNul` projection: the null discipline of the TOP node.
export function repTreeNulOf(ix: i32): i32 {
  if ix < 0 { return 0 }
  if rtKind[ix] == "nul" { return rtDisc[ix] }
  0
}

// The tree's `rdListElem` projection: the flat ELEMENT vocabulary of a list
// (or nullable-list) node — "" for a non-list or an element outside the flat
// alphabet.
export function repTreeListElemName(ix: i32): string {
  if ix < 0 { return "" }
  let lix = ix
  if rtKind[ix] == "nul" { lix = rtChild[ix] }
  if lix < 0 { return "" }
  if rtKind[lix] != "list" { return "" }
  const elem = rtChild[lix]
  if elem < 0 { return "" }
  const ek = rtKind[elem]
  if ek == "i32" || ek == "bool" || ek == "atom" { return "i32" }
  if ek == "i64" || ek == "f64" || ek == "f32" || ek == "u8" { return ek }
  if ek == "str" { return "string" }
  if ek == "struct" { return "struct" }
  if ek == "closure" { return "closure" }
  // The nullable-list flat arm treats a policy-pending litunion element as
  // atom-backed (see `rtNulVKind`) — its element vocabulary is "i32".
  if ek == "unsup" {
    if rtReason[elem] == "litunion:noalias" { return "i32" }
  }
  ""
}

// Whether `root`'s tree contains an `unsup` node anywhere — and WHICH policy
// gap, as the first reason-code reached (breadth-order, deterministic). "" =
// the whole tree is real: this is the totality metric the coverage report
// buckets. Cycle-safe via a generation stamp per node (the `repTyScalarMask`
// pattern; the stamps live with the arena arrays above).
export function repTreeUnsupReason(root: i32): string {
  if root < 0 { return "hole" }
  rtWalkN = rtWalkN + 1
  while rtWalkGen.length < rtKind.length { rtWalkGen.push(0) }
  const work: i32[] = []
  work.push(root)
  let wp = 0
  while wp < work.length {
    const ix = work[wp]
    wp = wp + 1
    if ix >= 0 && rtWalkGen[ix] != rtWalkN {
      rtWalkGen[ix] = rtWalkN
      if rtKind[ix] == "unsup" { return rtReason[ix] }
      if rtChild[ix] >= 0 { work.push(rtChild[ix]) }
      let k = 0
      while k < rtKidCount[ix] {
        work.push(rtKids[rtKidStart[ix] + k])
        k = k + 1
      }
    }
  }
  ""
}

// ── The differential SHADOW harness ──────────────────────────────────────────
// A debug-only sweep asserting the FLAT arms agree with the tree on every fact BOTH
// can express wherever the flat side claims coverage (`rdCovered == 1`): top kind,
// null discipline, list-element vocabulary, `$fnsig` token, and struct-slot identity
// — up to `repStructSlotsTwin` equivalence, since a hash-cons merge may surface a
// TWIN slot but never a different layout. The tree is the AUTHORITY at the `repOfTy`
// seam and the flat arms are the shadow; a disagreement still means one side is wrong,
// so triage against the emitted behavior. It also tallies the COVERAGE report: which
// policy gaps (`repTreeUnsupReason` buckets) block a fully-real tree. OFF by default —
// the host arms it (`setRepShadow`) when `$VL_REP_SHADOW` is set and reads the report
// back through the `diagMsgAt`-style accessors; an unarmed compile pays ONE boolean test.
export let repShadowOn = false

export function setRepShadow(v: i32) {
  repShadowOn = v != 0
  0
}

// Banked memo entries that do not reproduce when recomputed — see `repMemoCheck`.
let hcMemoBad = 0
let repShadowMsgs: string[] = []
let repShadowSeen: {[string]: i32} = Map()
let repShadowTys = 0
let repShadowReal = 0
let repShadowReasonNames: string[] = []
let repShadowReasonCounts: i32[] = []
let repShadowReasonIx: {[string]: i32} = Map()

// The identity↔spelling equivalence tallies. Two directions, because a partition
// agreement needs BOTH: no two distinct spellings may share an id (a false MERGE, the
// dangerous direction — it would fuse two layouts), and no spelling may reach two ids (a
// false SPLIT, which only declines a merge but still means the recursions disagree).
let hcSeenStrId: {[string]: i32} = Map()
// PER VOCABULARY, because the two key builders share ONE hash-cons table and an id
// reached from both is CORRECT — `i32` is `i32` under either rendering, and the arms
// where they genuinely differ (`HC_SLOT`, `HC_RLI32`, `HC_RLSTR`) carry their own tags.
// Only same-vocabulary agreement is required, so only that is asserted.
let hcSeenIdStrC: string[] = []
let hcSeenIdStrE: string[] = []
export let hcChecked = 0
export let hcMergeBad = 0
export let hcSplitBad = 0
export let hcLenBad = 0

// THE MEMO'S OWN ORACLE — every banked depth-0 answer recomputed from scratch and
// compared. Run BEFORE the sweep touches anything: the sweep's first `repElemKey`
// call runs `repElemMemoSync`, which CLEARS both id memos if the generation moved,
// so checking afterwards validates a memo you just rebuilt — a tautology, not a test.
//
// This is the check the three id walks did not have: `hcCheckKey` compares the WALKS
// against their string twins and says nothing about the CACHE in front of them. A
// stale entry here is a wrong slot, so the walk that resolves slots must not inherit
// a guarantee on trust.
//
// Recomputation swaps the memo column OUT rather than clearing it, so a disagreement
// is reported instead of silently repaired, and the banked column is restored either way.
function repMemoCheck() {
  const bankedMv = hcMvMemo
  const bankedElem = hcElemMemo
  hcMvMemo = []
  hcElemMemo = []
  let i = 0
  while i < bankedMv.length {
    if bankedMv[i] >= 0 {
      if repMvValId(i) != bankedMv[i] {
        hcMemoBad = hcMemoBad + 1
        repShadowNoteRaw("hc-memo mv ty=" + i32ToStr(i))
      }
    }
    i = i + 1
  }
  hcMvMemo = []
  let j = 0
  while j < bankedElem.length {
    if bankedElem[j] >= 0 {
      if repElemId(j) != bankedElem[j] {
        hcMemoBad = hcMemoBad + 1
        repShadowNoteRaw("hc-memo elem ty=" + i32ToStr(j))
      }
    }
    j = j + 1
  }
  hcMvMemo = bankedMv
  hcElemMemo = bankedElem
  0
}

// The sweep — called once per program from `emitProgram` AFTER the module bytes are
// final (the arena is complete then; monomorphization and the collect passes have
// minted every late type). Restarts its tallies each run, so an instance that compiles
// more than one program reports the last sweep.
export function repShadowSweep() {
  if !repShadowOn { return 0 }
  // Force a FRESH tree: the normal-compile tree deliberately survives slot
  // interning (`sNames` growth is not an invalidation axis — see LIFETIME),
  // so nodes built mid-emit may carry slot claims from before the table
  // finished. The sweep's slot assertions must run over a tree built against
  // the FINAL table; everything else re-derives identically.
  repTreeDrop()
  repShadowMsgs = []
  repShadowSeen = Map()
  repShadowTys = 0
  repShadowReal = 0
  repShadowReasonNames = []
  repShadowReasonCounts = []
  repShadowReasonIx = Map()
  hcSeenStrId = Map()
  hcSeenIdStrC = []
  hcSeenIdStrE = []
  hcChecked = 0
  hcMergeBad = 0
  hcSplitBad = 0
  hcLenBad = 0
  hcMemoBad = 0
  // AFTER the message/tally reset above (which would otherwise discard what this reports) and
  // BEFORE the loop below, whose first `repElemKey` runs `repElemMemoSync` and CLEARS both id
  // memos if the generation moved during emit. Check after that and you validate a memo you just
  // rebuilt — a tautology, not a test. Ordering is the whole correctness of this check, and the
  // first version of it sat above the reset and reported nothing at all.
  repMemoCheck()
  // `T.tys.length` is re-read each pass: a slot query inside the sweep can
  // itself memoize a new annotation spelling (`resolveAnnot`), growing the
  // arena — those late types are swept too, and the growth terminates because
  // the checker memoizes.
  let ty = 0
  while ty < T.tys.length {
    repShadowCheckTy(ty)
    ty = ty + 1
  }
  0
}

// Add `n` to a bucket in one step. `repShadowBumpReason` counts an EVENT; a probe that
// accumulates during emit has to report a TOTAL after `repShadowSweep` has reset the table,
// and bumping once per event would then be O(events) work at report time.
export function repShadowAddReason(r: string, n: i32) {
  if n <= 0 { return 0 }
  const i = repShadowReasonIx[r] ?? -1
  if i >= 0 {
    repShadowReasonCounts[i] = repShadowReasonCounts[i] + n
    return 0
  }
  repShadowReasonIx[r] = repShadowReasonNames.length
  repShadowReasonNames.push(r)
  repShadowReasonCounts.push(n)
  0
}

export function repShadowBumpReason(r: string) {
  const i = repShadowReasonIx[r] ?? -1
  if i >= 0 {
    repShadowReasonCounts[i] = repShadowReasonCounts[i] + 1
    return 0
  }
  repShadowReasonIx[r] = repShadowReasonNames.length
  repShadowReasonNames.push(r)
  repShadowReasonCounts.push(1)
  0
}

// Record one disagreement, deduped per (fact, canonical structure) — the same
// composition reached through many arena indices reports once. Bounded: a
// systematic drift would otherwise flood one line per arena index.
function repShadowNote(tag: string, ty: i32, detail: string) {
  const key = tag + "|" + repCanonKey(ty)
  if (repShadowSeen[key] ?? 0) == 1 { return 0 }
  repShadowSeen[key] = 1
  if repShadowMsgs.length < 200 {
    repShadowMsgs.push(
      tag + " ty@" + i32ToStr(ty) + " " + repCanonKey(ty) + ": " + detail,
    )
  }
  0
}

// THE IDENTITY EQUIVALENCE CHECK — one spelling, one id, one length.
//
// `which` distinguishes the two key vocabularies so a canon key and an elem key that
// happen to render the same text are not asked to share an id (they need not: they are
// different functions, and only same-vocabulary agreement is required).
function hcCheckKey(which: string, key: string, id: i32) {
  hcChecked = hcChecked + 1
  // The "" sentinel below means "unset", and no key builder can answer "" — every arm
  // emits at least one character. Stated because the sentinel would silently skip it.
  if key == "" { return 0 }
  if hcLenOf(id) != key.length {
    hcLenBad = hcLenBad + 1
    repShadowNoteRaw(
      "hc-len " +
        which +
        " key=" +
        key +
        " len=" +
        i32ToStr(key.length) +
        " hcLen=" +
        i32ToStr(hcLenOf(id)),
    )
  }
  const tagged = which + "|" + key
  const prev = hcSeenStrId[tagged] ?? -1
  if prev < 0 {
    hcSeenStrId[tagged] = id
  } else if prev != id {
    // One spelling, two ids — a false SPLIT.
    hcSplitBad = hcSplitBad + 1
    repShadowNoteRaw("hc-split " + which + " key=" + key)
  }
  if which == "canon" {
    while hcSeenIdStrC.length <= id { hcSeenIdStrC.push("") }
    if hcSeenIdStrC[id] == "" {
      hcSeenIdStrC[id] = key
    } else if hcSeenIdStrC[id] != key {
      // Two spellings, one id — a false MERGE, the direction that fuses layouts.
      hcMergeBad = hcMergeBad + 1
      repShadowNoteRaw(
        "hc-merge canon id=" +
          i32ToStr(id) +
          " a=" +
          hcSeenIdStrC[id] +
          " b=" +
          key,
      )
    }
    return 0
  }
  while hcSeenIdStrE.length <= id { hcSeenIdStrE.push("") }
  if hcSeenIdStrE[id] == "" {
    hcSeenIdStrE[id] = key
  } else if hcSeenIdStrE[id] != key {
    hcMergeBad = hcMergeBad + 1
    repShadowNoteRaw(
      "hc-merge " +
        which +
        " id=" +
        i32ToStr(id) +
        " a=" +
        hcSeenIdStrE[id] +
        " b=" +
        key,
    )
    // `which`, not a hardcoded "elem". An MV false merge is the one direction that fuses two
    // map-value slots into one — the invalid wasm this layer exists to prevent — and it was
    // being reported as an elem merge, sending the reader into the wrong walk.

  }
  0
}

function repShadowNoteRaw(msg: string) {
  if repShadowMsgs.length < 200 { repShadowMsgs.push(msg) }
  0
}

function repShadowCheckTy(ty: i32) {
  hcCheckKey("canon", repCanonKey(ty), repCanonId(ty))
  hcCheckKey("elem", repElemKey(ty), repElemId(ty))
  // The MAP-VALUE leg. `repMvValKey` has no functional caller now — `mvSlotOfTyKArm` compares
  // ids — and this is where it earns its keep, as the SHADOW of the id it was replaced by. The
  // other two keys are kept for exactly this reason; leaving mv out would have made it the one
  // key with no oracle at the moment it stopped being load-bearing, which is when drift stops
  // being visible.
  hcCheckKey("mv", repMvValKey(ty), repMvValId(ty))
  const tix = repTreeOfTy(ty)
  repShadowTys = repShadowTys + 1
  const reason = repTreeUnsupReason(tix)
  if reason == "" {
    repShadowReal = repShadowReal + 1
  } else {
    repShadowBumpReason(reason)
  }
  // The FLAT derivation — not `repOfTy`, which RETURNS the tree's facts wherever the
  // flat side claims coverage, so comparing it would be a tautology.
  const d = repOfTyFlat(ty)
  if d.rdCovered == 0 { return 0 }
  const tk = repTreeVKind(tix)
  if tk != d.rdKind {
    repShadowNote(
      "kind",
      ty,
      "flat=" +
        d.rdKind +
        " tree=" +
        repTreeKindOf(tix) +
        "/" +
        repSigTokOfKind(tk),
    )
    // The kind is the root fact — the projections below assume it agrees.
    return 0
  }
  if repTreeNulOf(tix) != d.rdNul {
    repShadowNote(
      "nul",
      ty,
      "flat=" + i32ToStr(d.rdNul) + " tree=" + i32ToStr(repTreeNulOf(tix)),
    )
  }
  if repTreeListElemName(tix) != d.rdListElem {
    repShadowNote(
      "elem",
      ty,
      "flat=" + d.rdListElem + " tree=" + repTreeListElemName(tix),
    )
  }
  if repSigTokOfKind(tk) != d.rdSigTok {
    repShadowNote(
      "sigtok",
      ty,
      "flat=" + d.rdSigTok + " tree=" + repSigTokOfKind(tk),
    )
  }
  if d.rdSlot >= 0 {
    const ts = repTreeSlotOf(tix)
    if ts < 0 {
      repShadowNote("slot", ty, "flat=" + i32ToStr(d.rdSlot) + " tree=-1")
    } else if repStructSlotsTwin(d.rdSlot, ts) == 0 {
      repShadowNote(
        "slot",
        ty,
        "flat=" + i32ToStr(d.rdSlot) + " tree=" + i32ToStr(ts) + " (not twins)",
      )
    }
  }
  0
}

// The host-readable report surface (the `diagCount`/`diagMsgLen`/`diagMsgAt`
// accessor pattern — the compiler module is instantiated with no imports, so
// strings cross the boundary one code point at a time).
export function repShadowCount() { repShadowMsgs.length }

export function repShadowMsgLen(i: i32) { repShadowMsgs[i].length }

export function repShadowMsgAt(i: i32, j: i32) { repShadowMsgs[i][j] }

// Coverage tallies: 0 = arena types swept · 1 = fully-real trees (no `unsup`
// node anywhere). The difference is bucketed by `repShadowReason*` below.
export function repShadowStat(k: i32): i32 {
  if k == 0 { return repShadowTys }
  if k == 1 { return repShadowReal }
  // The identity↔spelling equivalence tallies (the rep-column rewrite's proof).
  if k == 2 { return hcChecked }
  if k == 3 { return hcMergeBad }
  if k == 4 { return hcSplitBad }
  if k == 5 { return hcLenBad }
  // The MEMO's tally, distinct from the three walk tallies above it: those compare a walk
  // against its string twin, this one compares a BANKED answer against a recomputation.
  if k == 6 { return hcMemoBad }
  0
}

export function repShadowReasonCount() { repShadowReasonNames.length }

export function repShadowReasonLen(i: i32) { repShadowReasonNames[i].length }

export function repShadowReasonAt(i: i32, j: i32) { repShadowReasonNames[i][j] }

export function repShadowReasonN(i: i32) { repShadowReasonCounts[i] }
