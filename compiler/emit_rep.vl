// One struct per classified type. `rdCovered` is 1 when the rep derives structurally, 0 when
// the consumer must use its legacy path; `rdKind` is the `VKind` member, `rdNul` how `null` is
// encoded (ref, boolean/litunion sentinel, or boxed atom tag), `rdSlot` the interned slot (-1 at
// the arena level), `rdSigTok`/`rdListElem` the `$fnsig` token and list-element vocabulary.
export type RepDesc = {
  rdCovered: i32,
  rdKind: VKind,
  rdNul: i32,
  rdSlot: i32,
  rdSigTok: string,
  rdListElem: string,
  // 1 when the non-null value is a string-literal-union atom, which `rdKind` "i32" cannot tell.
  rdAtom: i32,
}

// The descriptor a TABLE-column producer answers with — today the return-kind trio
// (`fRetKind`/`fRetStructIdx`/`fRetRArrElem`), which is a producer of its own until the
// campaign's step 5 makes it a projection of `repOfTy`. `rdNul` is `REP_NUL_UNANSWERED`
// rather than 0, because these columns carry no null discipline and a 0 would read as one.
export const REP_NUL_UNANSWERED = -1

export function repDescRet(kind: VKind, slot: i32, elem: string): RepDesc {
  const d = repMk(kind, REP_NUL_UNANSWERED, elem)
  d.rdSlot = slot
  d
}

// The "no answer" descriptor a name-keyed producer hands back when the name resolves to
// nothing — `rdCovered` 0, the same contract `repUncovered` states for an underivable type.
export function repDescNone(): RepDesc { repUncovered() }

// The canonical kind->`$fnsig` token character, read by both encode sites
// (`cloParamTok` params, `cloRetKeySuffix` results); the param/result eligibility
// sets stay at those sites, since they encode which kinds may cross the ABI, not what
// the token is. `""` = no token.
export function repSigTokOfKind(kind: VKind | null): string {
  // Exhaustive over `VKind` and `_`-less, `null` included: `""` is a real answer the ABI
  // reads, so a new kind must say whether it crosses rather than inherit "no token" (D1898
  // made a nullable litunion matchable, which is what lets this scrutinee take a `match`).
  match kind {
    "i32" => {
      return "i"
    }
    "i64" => {
      return "I"
    }
    "f64" => {
      return "d"
    }
    "f32" => {
      return "f"
    }
    "str" => {
      return "S"
    }
    "list" => {
      return "a"
    }
    "strlist" => {
      return "A"
    }
    "f64list" => {
      return "D"
    }
    "i64list" => {
      return "L"
    }
    "f32list" => {
      return "F"
    }
    "u8list" => {
      // `u8[]` — the packed byte list. `B` for bytes; the letter is free and the kind is
      // slot-free like the other scalar lists, so it needs no `repSigTokHasSlot` arm.
      return "B"
    }
    "union" => {
      return "u"
    }
    "nulstr" => {
      return "N"
    }
    "closure" => {
      return "c"
    }
    "nulclosure" => {
      // A NULLABLE closure — `((i32) => T) | null` (kind 19): the shared closure fat-pointer
      // made nullable (`(ref null $cloStruct)`, slot-free like `c`/`N`). It keys a parameter
      // and a result alike.
      return "C"
    }
    "struct" => {
      return "s"
    }
    "nulstruct" => {
      return "n"
    }
    "variant" => {
      return "V"
    }
    "nulvariant" => {
      // A nullable union arm (`Circle | null`): the arm's variant struct made nullable,
      // keyed by its variant slot like `V`.
      return "W"
    }
    "reflist" => {
      return "r"
    }
    "map" => {
      // A MAP; it carries the map SHAPE slot at the encode site (like `s`/`r`).
      return "m"
    }
    "nullist" => {
      // A nullable i32-backed list result (`boolean[] | null`, `i32[] | null`, kind 15): the
      // shared i32-list wrapper made nullable, slot-free like `N`/`C`. A result-only token;
      // distinct-backing nullable lists stay outside the ABI (no token).
      return "o"
    }
    "nulstrlist" => {
      // The distinct-backing nullable scalar lists: each list's own wrapper made nullable,
      // slot-free like `o` (D2399).
      return "P"
    }
    "nulf64list" => {
      return "E"
    }
    "nuli64list" => {
      return "J"
    }
    "nulf32list" => {
      return "G"
    }
    "nulu8list" => {
      return "H"
    }
    "v128" => {
      // The SIMD vector, slot-free like the other scalars, at a param and at a result.
      return "X"
    }
    "nulreflist" => {
      // A nullable ref list (`S[] | null`, `f64[][] | null`): the ref-list wrapper made
      // nullable, keyed by its ref-list slot like `r` (D5882).
      return "R"
    }
    "nulmap" => {
      // A nullable string- or i32-keyed map (`{[string]: V} | null`): the map struct made
      // nullable, keyed by its map shape slot like `m`.
      return "M"
    }
    "nulnone" => {
      // The `null` type itself: a nullref, slot-free.
      return "Z"
    }
    "nulbool" => {
      // `boolean | null` crosses as its i32 valtype.
      return "i"
    }
    null => {
      // The caller has no kind at all.
      return ""
    }
  }
}

// True when a kind's `$fnsig` token carries a `;`-terminated decimal slot (an
// interned struct/variant/ref-list/map-shape index) — read by both sides: encoders
// mint the digits (`repSigSlotTokOfKind`), decoders skip/parse them through this one
// predicate. A slot-carrying kind cannot be added without every parser agreeing on its shape.
export function repSigTokHasSlot(kind: VKind | null): boolean {
  kind == "struct"
    || kind == "nulstruct"
    || kind == "variant"
    || kind == "nulvariant"
    || kind == "reflist"
    || kind == "nulreflist"
    || kind == "map"
    || kind == "nulmap"
}

// Mint a slot-carrying `$fnsig` token: the kind's token char followed by the
// `;`-terminated decimal slot — the one place token digits are assembled. A struct
// slot renders its `sTwin`-canonical representative (`repStructSlotRep`), not the raw
// row, so two spelling-twin rows key one `$fnsig`; computed from `slotCanonId`, never `sTwin[]`.
export function repSigSlotTokOfKind(kind: VKind | null, slot: i32): string {
  let s = slot
  if kind == "struct" || kind == "nulstruct" { s = repStructSlotRep(slot) }
  repSigTokOfKind(kind) + i32ToStr(s) + ";"
}

// The inverse projection: a `$fnsig` token character back to its `VKind`, or `null`
// outside the vocabulary. `'v'` (void) is deliberately absent, since void is the
// absence of a result kind and its decoder tests it first. Together with
// `repSigTokOfKind` this pair IS the token scheme — an arm without its twin cannot exist.
export function repKindOfSigTok(c: i32): VKind | null {
  if c == 'i' { return "i32" }
  if c == 'I' { return "i64" }
  if c == 'd' { return "f64" }
  if c == 'f' { return "f32" }
  if c == 'S' { return "str" }
  if c == 'a' { return "list" }
  if c == 'A' { return "strlist" }
  if c == 'D' { return "f64list" }
  if c == 'L' { return "i64list" }
  if c == 'F' { return "f32list" }
  if c == 'B' { return "u8list" }
  if c == 'u' { return "union" }
  if c == 'N' { return "nulstr" }
  if c == 'c' { return "closure" }
  if c == 'C' { return "nulclosure" }
  if c == 's' { return "struct" }
  if c == 'n' { return "nulstruct" }
  if c == 'V' { return "variant" }
  if c == 'W' { return "nulvariant" }
  if c == 'r' { return "reflist" }
  if c == 'R' { return "nulreflist" }
  if c == 'm' { return "map" }
  if c == 'M' { return "nulmap" }
  if c == 'Z' { return "nulnone" }
  if c == 'o' { return "nullist" }
  if c == 'P' { return "nulstrlist" }
  if c == 'E' { return "nulf64list" }
  if c == 'J' { return "nuli64list" }
  if c == 'G' { return "nulf32list" }
  if c == 'H' { return "nulu8list" }
  if c == 'X' { return "v128" }
  null
}

// An uncovered descriptor — the consumer must take its legacy path. `rdKind`
// deliberately carries the ladder's own default ("i32") so a consumer that
// forgets the `rdCovered` check degrades to the same fallthrough the legacy
// chain has, never to a bogus ref kind.
function repUncovered(): RepDesc {
  const d: RepDesc = {
    rdCovered: 0,
    rdKind: "i32",
    rdNul: 0,
    rdSlot: -1,
    rdSigTok: "",
    rdListElem: "",
    rdAtom: 0,
  }
  return d
}

function repMk(kind: VKind, nul: i32, elem: string): RepDesc {
  const d: RepDesc = {
    rdCovered: 1,
    rdKind: kind,
    rdNul: nul,
    rdSlot: -1,
    rdSigTok: repSigTokOfKind(kind),
    rdListElem: elem,
    rdAtom: 0,
  }
  return d
}

// A string literal union's rep: the interned i32 atom, with `nul` 0 (bare) or 3 (the
// `-1` null sentinel).
function repAtomMk(nul: i32): RepDesc {
  const d = repMk("i32", nul, "")
  d.rdAtom = 1
  d
}

// Canonical structural key (cycle-terminating): walked in full so `{a:i32}` and
// `{a:i32,b:i32}` differ. A recursive cycle terminates via a visited stack: re-entering
// a type emits a relative back-edge `#<k>` (a de Bruijn index), so two isomorphic
// cyclic types render the same key. An unnarrowed leaf keys by arena index (`@N`): distinct, never a false merge.
const repKeyStack: i32[] = []

// The `repCanonKey` memo (generation-stamped), since the full recursive build made
// this the hottest compile path. Per arena index (`""` = unfilled), stamped with the
// checker's `tyMutEpoch`; any arena mutation advances the epoch and drops the whole
// memo. Consulted only at top-level calls, since an interior key's back-edge is not a self-contained string.
let repKeyMemo: string[] = []
// A plain stamp rather than a `MemoKey`, as are `repSlotRepEpoch` and `rtEpoch`: each sync runs
// on every ask, where a key's array read is a measurable share of the compile.
let repKeyMemoEpoch = -1

function repKeyMemoSync() {
  if repKeyMemoEpoch != tyMutEpoch {
    repKeyMemoEpoch = tyMutEpoch
    repKeyMemo = []
    // The identity twin's memo shares this generation exactly — one sync, two columns,
    // so the two can never disagree about which generation they are in.
    hcCanonMemo = []
    hcRowMemo = []
  }
  0
}

// D611 — the numeric-literal-union soften for a struct field, applied on both
// canon-key walks so the id and string stay one answer: `type N = 1 | 2` and `i32`
// are one emitted field, since canon rewrites an inline annotation but not a
// declared type's stored entry. Field position only, and string bases are excluded (double-gated by `structFieldCodesEq`).
function repCanonFieldTy(ty: i32): i32 {
  const nb = numLitUnionBaseTy(ty)
  if nb >= 0 { return nb }
  ty
}

// A bare string literal at a record field keys as its one-member set: both rep as the atom, so
// `{k: "a"}` and `{k: KC}` share one row and neither shares `{k: string}`'s (D7220).
function repFieldLitAsSet(ty: i32): i32[] {
  const out: i32[] = []
  if ty >= 0 && ty < T.tys.length {
    const t = tyAt(ty)
    if t is TyLit {
      if t.litKind == "str" { out.push(ty) }
    }
  }
  out
}

// Which equivalence a rep key renders: `canon` the full structural key; `elem` the ref-list
// element key (leaf lists folded to one token each, a declared struct nominal); `mv` the map-value
// key, nominal with no leaf fold; `row` is `canon` with every function type keyed as its one
// closure cell, which is a struct row's identity.
type RepKeyMode = "canon" | "elem" | "mv" | "row"

// Whether `mode` is the full structural key: it expands a declared struct, softens a
// literal-union field to its base, and keys a bare literal as its base scalar.
function repKeyIsCanon(mode: RepKeyMode): boolean {
  match mode {
    "canon" | "row" => {
      return true
    }
    "elem" | "mv" => {
      return false
    }
  }
}

// Whether `mode` keys a Set as its boolean-valued map: the canon keys, and the mv slot key,
// whose slot is named by the map a Set value is stored as.
function repKeyFoldsSet(mode: RepKeyMode): boolean {
  match mode {
    "canon" | "row" | "mv" => {
      return true
    }
    "elem" => {
      return false
    }
  }
}

// Whether `mode` folds an i32- or string-backed leaf array to its shared list wrapper.
function repKeyFoldsLeafList(mode: RepKeyMode): boolean {
  match mode {
    "elem" => {
      return true
    }
    "canon" | "mv" | "row" => {
      return false
    }
  }
}

export function repCanonKey(ty: i32): string { repKeyOf(ty, "canon") }

// The back-edge depth at which a walk with `stack` folds `ty`, or 0: the nearest entry that is
// `ty` or that `ty` unrolls, so a recursive type and each unrolling of it key as one tree.
function repFoldDepth(stack: i32[], ty: i32): i32 {
  let si = stack.length - 1
  while si >= 0 {
    if stack[si] == ty { return stack.length - si }
    si = si - 1
  }
  if !tyReachesCycle(ty) { return 0 }
  si = stack.length - 1
  while si >= 0 {
    if tyUnrollsTo(ty, stack[si]) { return stack.length - si }
    si = si - 1
  }
  0
}

// Whether `ty` and `anc` are one recursive type, either rolled or unrolled: both reach a cycle
// and render equal at every depth, holes exact. False for an acyclic type, which no strict
// ancestor of it can equal.
export function tyUnrollsTo(ty: i32, anc: i32): boolean {
  if ty == anc { return true }
  if ty < 0 || anc < 0 || ty >= T.tys.length || anc >= T.tys.length {
    return false
  }
  if !tyReachesCycle(ty) || !tyReachesCycle(anc) { return false }
  if tyHeadCode(ty) != tyHeadCode(anc) { return false }
  tyEqSameHoles(ty, anc)
}

// The arena variant of `ty` as a number, a record's also counting its fields, so two types with
// different codes cannot be equal.
function tyHeadCode(ty: i32): i32 {
  const t = tyAt(ty)
  match t {
    TyPrim => 0
    TyErr => 1
    TyFunc => 2
    TyUnion => 3
    TyNullable => 4
    TyArray => 5
    TyMap => 6
    TyVar => 7
    TyLit => 8
    TyNeg => 9
    TyObj => 10 + t.objFieldNames.length
  }
}

// Per arena index: 0 unknown, 1 acyclic, 2 reaches a cycle, 3 on the walk's path. Synced with
// the checker's `tyMutEpoch`, as the key memo is.
let rcMemo: i32[] = []
let rcEpoch = -1

// Whether some type reachable from `ty` reaches itself again.
function tyReachesCycle(ty: i32): boolean {
  if rcEpoch != tyMutEpoch {
    rcEpoch = tyMutEpoch
    rcMemo = []
  }
  rcGo(ty) == 2
}

function rcGo(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return 1 }
  while rcMemo.length <= ty { rcMemo.push(0) }
  const m = rcMemo[ty]
  if m == 3 { return 2 }
  if m != 0 { return m }
  rcMemo[ty] = 3
  const r = rcKids(ty)
  rcMemo[ty] = r
  r
}

// `rcGo` over the types `ty` is built from: 2 when any of them reaches a cycle.
function rcKids(ty: i32): i32 {
  const t = tyAt(ty)
  let r = 1
  if t is TyObj {
    for f in t.objFieldTypes {
      if rcGo(f) == 2 { r = 2 }
    }
  } else if t is TyArray {
    r = rcGo(t.aElem)
  } else if t is TyNullable {
    r = rcGo(t.nInner)
  } else if t is TyUnion {
    for u in t.uMembers {
      if rcGo(u) == 2 { r = 2 }
    }
  } else if t is TyMap {
    if rcGo(t.mKey) == 2 || rcGo(t.mVal) == 2 { r = 2 }
  } else if t is TyFunc {
    for p in t.fnParamTypes {
      if rcGo(p) == 2 { r = 2 }
    }
    if rcGo(t.fnRet) == 2 { r = 2 }
  } else if t is TyNeg {
    r = rcGo(t.negTy)
  }
  r
}

// The one entry every key render recurses through. Each mode owns its cycle stack, and
// `canon` and `elem` a depth-0 memo: a back-edge is a function of the caller's depth, so only
// a top-of-recursion answer is banked. A render past any sane size collapses to a sentinel
// naming its structural id, so two arena copies of one deep type still share a key (D9840).
function repKeyOf(ty: i32, mode: RepKeyMode): string {
  if ty < 0 { return "!" }
  const stack = repKeyStackOf(mode)
  const fd = repFoldDepth(stack, ty)
  if fd > 0 { return "#" + i32ToStr(fd) }
  const top = stack.length == 0
  if top {
    const hit = repKeyMemoGet(ty, mode)
    if hit != "" { return hit }
  }
  stack.push(ty)
  let s = repKeyGo(ty, mode)
  stack.pop()
  if s.length > 262144 { s = "@big:" + i32ToStr(hcBigInner(repIdOf(ty, mode))) }
  // The walk only reads the arena and the slot cache, so the generation the read synced
  // still holds and the write cannot stamp a stale key.
  if top { repKeyMemoPut(ty, mode, s) }
  s
}

function repKeyStackOf(mode: RepKeyMode): i32[] {
  match mode {
    "canon" => {
      return repKeyStack
    }
    "elem" => {
      return repElemKeyStack
    }
    "mv" => {
      return repMvKeyStack
    }
    "row" => {
      return repRowKeyStack
    }
  }
}

// The depth-0 memo's key for `ty` under `mode`, `""` for a miss; `mv` keeps no memo.
function repKeyMemoGet(ty: i32, mode: RepKeyMode): string {
  match mode {
    "canon" => {
      repKeyMemoSync()
      if ty < repKeyMemo.length { return repKeyMemo[ty] }
      return ""
    }
    "elem" => {
      repElemMemoSync()
      if ty < repElemMemo.length { return repElemMemo[ty] }
      return ""
    }
    "mv" | "row" => {
      return ""
    }
  }
}

function repKeyMemoPut(ty: i32, mode: RepKeyMode, s: string) {
  match mode {
    "canon" => {
      while repKeyMemo.length <= ty { repKeyMemo.push("") }
      repKeyMemo[ty] = s
    }
    "elem" => {
      while repElemMemo.length <= ty { repElemMemo.push("") }
      repElemMemo[ty] = s
    }
    "mv" | "row" => {}
  }
  0
}

// The base of a union every member of which is an integer literal of that one base, else -1.
// Such a union is stored as its base, so a field of it shares the base's element row.
// The type a map's value keys by: under the canon key a union of one base's integer literals is
// that base, as the map stores it, so `{[K]: 1 | 2}` keys as `{[K]: i32}` does.
function repMapValTy(v: i32, mode: RepKeyMode): i32 {
  if !repKeyIsCanon(mode) || v < 0 || v >= T.tys.length { return v }
  const vt = tyAt(v)
  if !(vt is TyUnion) { return v }
  const b = oneIntLitBaseOf(vt.uMembers)
  if b >= 0 { return b }
  v
}

function oneIntLitBaseOf(ms: i32[]): i32 {
  let b = -1
  for m in ms {
    if m < 0 || m >= T.tys.length { return -1 }
    const mt = tyAt(m)
    if !(mt is TyLit) { return -1 }
    if mt.litKind != "int" { return -1 }
    const mb = litBaseTy(mt)
    if b >= 0 && mb != b { return -1 }
    b = mb
  }
  b
}

function repKeyGo(ty: i32, mode: RepKeyMode): string {
  const t = tyAt(ty)
  // Exhaustive over `Ty` and deliberately `_`-less: a 12th arena variant breaks the
  // self-compile here instead of silently taking the index sentinel, which never
  // merges and so never dedups two spellings of one type. Deliberate leaves are spelled as empty arms carrying their reason.
  match t {
    TyPrim => {
      return t.primName
    }
    TyObj => {
      // `canon` expands every struct; the slot keys name a declared struct by its slot and
      // expand only an inline shape (`structural-twin-reflist-dedup.vl`).
      const canon = repKeyIsCanon(mode)
      if !canon {
        const ds = repSlotOfElemTy(ty, mode)
        if ds >= 0 { return "S" + i32ToStr(ds) }
      }
      let s = "{"
      let i = 0
      while i < t.objFieldNames.length {
        let ft = t.objFieldTypes[i]
        if canon { ft = repCanonFieldTy(ft) }
        const asSet = repFieldLitAsSet(ft)
        const fk = if canon && asSet.length > 0 { repKeyUnion(asSet, mode) } else { repKeyOf(ft, mode) }
        s = s + t.objFieldNames[i] + ":" + fk + ","
        i = i + 1
      }
      return s + "}"
    }
    TyArray => {
      if repKeyFoldsLeafList(mode) {
        // A top-level i32-backed leaf array (`i32[]`, `boolean[]`, litunion `K[]`, `(boolean
        // | null)[]`) shares the i32-list wrapper, and a string-backed one (`string[]`,
        // `(string | null)[]`) the string-list wrapper. A top-level-nullable list carries its
        // `| null` outside and is not this arm.
        if tyIsI32LeafElem(t.aElem) { return "$rlI32L" }
        if tyIsStrLeafElem(t.aElem) { return "$rlStrL" }
      }
      return repKeyOf(t.aElem, mode) + "[]"
    }
    TyNullable => {
      return repKeyOf(t.nInner, mode) + "?"
    }
    TyUnion => {
      const lb = if mode == "elem" { oneIntLitBaseOf(t.uMembers) } else { -1 }
      if lb >= 0 { return repKeyOf(lb, mode) }
      return repKeyUnion(t.uMembers, mode)
    }
    TyFunc => {
      if mode == "row" { return "=>" }
      let s = "("
      let i = 0
      while i < t.fnParamTypes.length {
        if i > 0 { s = s + "," }
        s = s + repKeyOf(t.fnParamTypes[i], mode)
        i = i + 1
      }
      return s + ")=>" + repKeyOf(t.fnRet, mode)
    }
    TyMap => {
      let s = "M"
      // Under the canon and mv keys a Set is its `{[K]: boolean}` map: both name the Set by that
      // map, so a row or slot typed from the name must find the rep of the Set it holds.
      if t.mSet == 1 && !repKeyFoldsSet(mode) { s = "Se" }
      return s
        + "["
        + repKeyOf(t.mKey, mode)
        + ":"
        + repKeyOf(repMapValTy(t.mVal, mode), mode)
        + "]"
    }
    TyNeg => {
      return "!" + repKeyOf(t.negTy, mode)
    }
    TyVar => {
      // A generic type PARAMETER: no structural render exists before the
      // monomorphizer substitutes it, so it takes the index sentinel below.
    }
    TyLit => {
      // D1031 — under `canon` a bare literal type keys as its base scalar, the rep the field
      // actually emits (guarded by `structFieldCodesEq`). The slot keys give it no row of its
      // own: the softening applies only to a litunion MEMBER.
      if repKeyIsCanon(mode) { return repKeyOf(litBaseTy(t), mode) }
    }
    TyErr => {
      // The error/unknown hole — assignable both ways, so any structural render
      // would claim an equivalence it does not have; the index sentinel below.
    }
  }
  // The empty arms land here: keyed by arena index, unique per index, so this can only
  // decline a merge (the loud direction), never invent one.
  "@" + i32ToStr(ty)
}

// Whether union member `m` is a literal: a litunion, or a bare `TyLit`.
function repMemberIsLit(m: i32): boolean {
  if tyIsLitUnion(m) { return true }
  const mt = tyAt(m)
  if mt is TyLit { return true }
  false
}

// Whether a union over `mems` is MIXED: some member is neither a literal nor `null`. A
// litunion member of a mixed union is string-repped in the box, so every key renders it as
// `string` (the `mvCanonValNameTy`/`rlInternName` discipline at the key layer).
function repUnionIsMixed(mems: i32[]): boolean {
  let mi = 0
  while mi < mems.length {
    if !repMemberIsLit(mems[mi]) {
      const mt = tyAt(mems[mi])
      let mNull = false
      if mt is TyPrim {
        if mt.primName == "null" { mNull = true }
      }
      if !mNull { return true }
    }
    mi = mi + 1
  }
  false
}

// Whether `ty` is a list of one or more layers over a `boolean` or `boolean | null` leaf. A
// union box tags such an arm apart from its `i32` twin (D2769), so a union member keys it
// unfolded: folded, two unions differing only there share one ref-list row and its name (D4896).
function repIsBoolLeafList(ty: i32): boolean {
  let cur = ty
  let layers = 0
  while cur >= 0 && cur < T.tys.length && layers < 64 {
    const t = tyAt(cur)
    if !(t is TyArray) { break }
    cur = t.aElem
    layers = layers + 1
  }
  if layers == 0 || cur < 0 || cur >= T.tys.length { return false }
  let leaf = cur
  const lt = tyAt(cur)
  if lt is TyNullable { leaf = lt.nInner }
  if leaf < 0 || leaf >= T.tys.length { return false }
  const pt = tyAt(leaf)
  if pt is TyPrim { return pt.primName == "boolean" }
  false
}

// The mode a union member keys under: `elem`'s leaf fold is a wrapper equivalence, and a
// boolean-leaf arm is a distinct box arm, so it takes the unfolded `mv` render.
function repUnionMemberMode(m: i32, mode: RepKeyMode): RepKeyMode {
  if repKeyFoldsLeafList(mode) && repIsBoolLeafList(m) { return "mv" }
  mode
}

// The union arm: without the mix-widening a declared and an inline spelling of one union
// keyed differently and mismatched at the call boundary. A pure litunion keeps its atom-i32
// render, guarded by `structFieldCodesEq`.
function repKeyUnion(mems: i32[], mode: RepKeyMode): string {
  const mixed = repUnionIsMixed(mems)
  let s = "("
  let emitted = 0
  let sawWideStr = false
  let i = 0
  while i < mems.length {
    let r = repKeyOf(mems[i], repUnionMemberMode(mems[i], mode))
    let skip = false
    if mixed {
      if repMemberIsLit(mems[i]) { r = "string" }
      if r == "string" {
        if sawWideStr { skip = true }
        sawWideStr = true
      }
    }
    if !skip {
      if emitted > 0 { s = s + "|" }
      s = s + r
      emitted = emitted + 1
    }
    i = i + 1
  }
  s + ")"
}

// repElemKey — the ref-list element rep key (destringify D2): a canonical key for an
// element's representation (its WasmGC wrapper-equivalence class), not its type —
// equal iff two elements ride one wrapper heap type. Unlike `repCanonKey`, it folds
// `i32[]`/`boolean[]`/litunion `K[]` to one token (they share a backing) and keeps a declared struct nominal, expanding only an inline shape.
export function repElemKey(ty: i32): string { repKeyOf(ty, "elem") }

// Cycle guard (de Bruijn back-edges), mirroring `repKeyStack` — a recursive type
// reaches `repElemKey` through a declared struct (keyed nominally, which already
// bottoms out) or, defensively, a union/map that could self-refer.
const repElemKeyStack: i32[] = []

// The `repElemKey` memo, `repKeyMemo`'s twin with one more generation to compare:
// this key's `TyObj` arm also asks `repSlotOfTyDecl`, so it syncs on the triple
// `repSlotCacheSync` compares (`tyMutEpoch`, `cUserTypesVer`, `sNames.length`). Top of
// recursion only: a de Bruijn back-edge is a function of the caller's depth, not of `ty`, so an inner answer is never banked.
let repElemMemo: string[] = []
const repElemGenKey = memoKeyNew(3)

function repElemMemoSync() {
  if memoMoved3(repElemGenKey, tyMutEpoch, cUserTypesVer, sNames.length) {
    repElemMemo = []
    hcElemMemo = [] // the identity twin's memo, on the same generation
    hcMvMemo = [] // the map-value twin's, on that same generation for the same reason
  }
  0
}

// True when element type `e` rides the i32-list backing as a LEAF — `i32`,
// `boolean`, a litunion (`K` / inline `"a"|"b"`), and their `| null` sentinel
// niches (`boolean | null`, `K | null`). The structural twin of `nameIsI32Array`'s
// element half (its base minus the trailing `[]`).
export function tyIsI32LeafElem(e: i32): boolean {
  if e < 0 { return false }
  const t = tyAt(e)
  match t {
    TyPrim => {
      // Exhaustive over `PrimName` and `_`-less: `false` is "not an i32-backed leaf", a real
      // answer, so a new prim must say whether it rides the i32 spine.
      match t.primName {
        "i32" | "boolean" => true
        // Not i32-backed.
        "i64" | "f32" | "f64" | "string" | "void" | "null" | "never" | "u8" | "v128" => false
      }
    }
    TyUnion => tyIsLitUnion(e)
    TyNullable => {
      if t.nInner < 0 { return false }
      const it = tyAt(t.nInner)
      if it is TyPrim {
        if it.primName == "boolean" { return true }
      }
      tyIsLitUnion(t.nInner)
    }
    // No other element shape rides the i32 backing as a leaf.
    TyFunc | TyObj | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// The string-leaf sibling of `tyIsI32LeafElem`: `string` and `string | null`
// (`nameIsStringArray`'s element half). A `string[]` element is already a
// nullable ref at wasm level, so the `| null` niche needs no new wrapper.
export function tyIsStrLeafElem(e: i32): boolean {
  if e < 0 { return false }
  const t = tyAt(e)
  match t {
    TyPrim => t.primName == "string"
    TyNullable => {
      if t.nInner < 0 { return false }
      const it = tyAt(t.nInner)
      if it is TyPrim {
        if it.primName == "string" { return true }
      }
      false
    }
    // No other element shape is a string leaf.
    TyFunc | TyObj | TyUnion | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// The name bridge for the ref-list layer (name-keyed): resolve a ref-list element
// name to its arena type (memoized by `resolveAnnot`), then compute its rep key —
// asking `resolveAnnot` directly rather than `declTyIxOfName`, since a newtype's
// declared-name entry and the annotation-resolved index differ here. Unresolvable spellings key on the name itself, nominally.
export function repElemIdOfNameTy(name: string, ty: i32): i32 {
  if name == "" { return -1 }
  if ty >= 0 { return repElemId(ty) }
  const di = repElemTyOfName(name)
  if di < 0 { return hcNameId(name) }
  repElemId(di)
}

// The arena type `repElemIdOfNameTy` keys an unhinted element name by, or -1 for an empty,
// runaway or unresolvable spelling, which that key names nominally instead.
export function repElemTyOfName(name: string): i32 {
  if name == "" { return -1 }
  if name.length > 4096 { return -1 }
  resolveAnnot(name, repNoTyparams)
}

// repMvValKey — the map-value slot rep key: canonical for a `{[string]: V}` value
// type's mv-table slot identity, equal iff two spellings intern one `mvValName` row.
// Unlike `repElemKey` it does not fold shared-wrapper leaf lists (each interns its
// own row); unlike `repCanonKey` it keeps a declared struct nominal, not expanded. A finer key only declines a resolve, never hands back another row's.
export function repMvValKey(ty: i32): string { repKeyOf(ty, "mv") }

// Cycle guard (de Bruijn back-edges), mirroring `repElemKeyStack`.
const repMvKeyStack: i32[] = []
const repRowKeyStack: i32[] = []

// Record the arena type of the map value name just pushed onto `mvValName`, padded
// with -1 so a site that skips this self-heals to uncovered. `rowTy` is the caller's
// own resolution of this spelling (the slot find that ran before the push resolved
// the same string); -1 means the caller's resolution and this one had different inputs — for the one intern site, that canon rewrote the spelling.
export function recordMvValTyIx(nm: string, rowTy: i32) {
  while mvValTyIx.length + 1 < mvValName.length { mvValTyIx.push(-1) }
  mvValTyIx.push(mvValTyIxOfNameRow(nm, rowTy))
  0
}

// The key half of an mv slot's identity: the `typecheck.mapKeyKindOfTy` kind of the keys list
// slot `slot`'s map struct carries, the string kind for a slot the column does not cover. The
// one read of the `mvKeyKind` column; it lives here because `emit_classify` imports from here.
export function mvSlotKeyKind(slot: i32): i32 {
  if slot < 0 { return MAP_KEY_STR }
  if slot >= mvKeyKind.length { return MAP_KEY_STR }
  mvKeyKind[slot]
}

// The one key question asked of a map shape, in the vocabulary every op site threads: the i32
// mono pair (`-4` map, `-5` Set), the i64 mono pair (`-6`, `-7`), or an mv slot's own column;
// every other shape is string-keyed. A site testing one sentinel alone misses the slot half.
export function mapShapeKeyKind(sh: i32): i32 {
  if sh == -4 || sh == -5 { return MAP_KEY_I32 }
  if sh == -6 || sh == -7 { return MAP_KEY_I64 }
  mvSlotKeyKind(sh)
}

// Whether map shape `sh` has an integer key, so its index is the (tag, entry) pair layout.
export function mapShapeKeyInt(sh: i32): boolean {
  mapShapeKeyKind(sh) != MAP_KEY_STR
}

// D48 — the interned mv slot whose (value type, key rep, arm) triple matches
// `ty`/`keyI32`/`armHint`, or -1 — first-match-wins over the `mvValName` scan it
// fronts. The arm is a third identity component, since a map whose value is a
// declared union arm and one over its exact layout twin never merge. `MV_ARM_NOHINT` matches any parity, -1 only a non-arm slot, `>= 0` only that arm's.
export function mvSlotOfTyKArm(ty: i32, keyK: i32, armHint: i32): i32 {
  if ty < 0 { return -1 }
  // The interned id, not a rebuilt spelling: comparing arena indices as raw ints
  // avoids re-rendering a full structural string and re-running `repMvValKey` for
  // every occupied row on every query. The id form is the same move `repCanonKey` ->
  // `repCanonId` made; a repeat is now an i32 compare, riding `repElemMemo`'s depth-0 generation triple.
  const k = repMvValId(ty)
  let i = 0
  while i < mvValTyIx.length {
    if mvValTyIx[i] >= 0 {
      if mvSlotKeyKind(i) == keyK {
        if mvSlotArmMatches(i, armHint) {
          if repMvValId(mvValTyIx[i]) == k { return i }
        }
      }
    }
    i = i + 1
  }
  -1
}

// "No arm hint" — the caller holds no type to ask `armRowOfRecordTyShim` of, so it matches a
// slot of any arm parity. Distinct from -1, which is a RESOLVED "not an arm".
export const MV_ARM_NOHINT = 0 - 2

// Does mv slot `slot` satisfy the caller's arm hint? The read side of the tri-state
// above, bounds-guarded like every other parallel-table accessor (a slot whose column
// never resolved reads -1, i.e. "not an arm", which is what an uncovered row means).
export function mvSlotArmMatches(slot: i32, armHint: i32): boolean {
  if armHint == MV_ARM_NOHINT { return true }
  // The signature column, not the variant one (D93): the hint filters the slot's
  // identity, which needs the wider question — two nested maps whose inner values are
  // an arm and its exact layout twin share the variant column (-1, -1) but differ in
  // signature. On every kind-1 slot the two columns agree by construction, so nothing moves.
  let sv = 0 - 1
  if slot >= 0 && slot < mvValArmSig.length { sv = mvValArmSig[slot] }
  sv == armHint
}

// The KEY half of the same hop: the key kind (`typecheck.mapKeyKindOfTy`) of map type `ty`, the
// structural form of `mapNameKeyKind(name)` and the argument every arena-side `mvSlotOfValTyK`
// caller pairs with `tyMapValOf`. A non-map answers the string kind, as the name form does.
export function tyMapKeyKind(ty: i32): i32 {
  if ty < 0 { return MAP_KEY_STR }
  const t = tyAt(ty)
  if t is TyMap { return mapKeyKindOfTy(t.mKey) }
  MAP_KEY_STR
}

// The name bridge for the mv layer (still name-keyed at entry): resolve a map-value
// name to its arena type, then to its (key-paired) slot; -1 when the name does not
// resolve or no row claims it. Most traffic now routes through a caller holding an
// annotation/expression node whose map type the checker already banked (`nodeMapValTyIx`); this covers what has only a spelling, plus the fall-through those routed sites keep.
export function mvSlotOfValNameTyK(nm: string, keyK: i32): i32 {
  mvSlotOfValNameTyKArm(nm, keyK, MV_ARM_NOHINT)
}

// The arm-hinted form of the name bridge — the same resolution, filtered by the
// caller's arm state (see `mvSlotOfTyKArm`). The un-hinted entry point is unchanged.
export function mvSlotOfValNameTyKArm(
  nm: string,
  keyK: i32,
  armHint: i32,
): i32 {
  mvSlotOfTyKArm(fieldElemTyIxOfName(nm), keyK, armHint)
}

// The arena type a map-value spelling denotes — the rung the name bridge sits on,
// and the one place a caller's own resolution of that spelling replaces it. `rowTy
// >= 0` replaces the bridge rather than fronting it: a hint that is merely a better
// answer may only be tried first, while a hint that is the same input deletes the resolution outright (safe since `resolveAnnot` never invalidates a positive entry).
export function mvValTyIxOfNameRow(nm: string, rowTy: i32): i32 {
  if rowTy >= 0 { return rowTy }
  fieldElemTyIxOfName(nm)
}

// The (`| null`-peeled) `TyMap` arena index an annotation/expression node denotes,
// or -1 — the node-side entry the sidecar legs read off their own columns. -1 is the
// decline and is load-bearing: an interior `TypeRef` (a map inside a union member's
// field, or an `is` pattern) carries no `nodeTyIx`, so every consumer keeps its name leg and reaches it on a decline.
function nodeMapTyIx(nodeIx: i32): i32 {
  const ty = nodeTyIxOf(nodeIx)
  if ty < 0 { return -1 }
  const t = tyAt(ty)
  match t {
    TyNullable => {
      if t.nInner < 0 { return -1 }
      const it = tyAt(t.nInner)
      if it is TyMap { return t.nInner }
      -1
    }
    TyMap => ty
    // Not a map, nullable or bare.
    TyPrim | TyFunc | TyObj | TyUnion | TyArray | TyNeg | TyVar | TyLit | TyErr => -1
  }
}

// The key type of a map type `ty`, or -1 when `ty` is not a `TyMap` — `tyMapValOf`'s twin.
export function tyMapKeyOf(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = tyAt(ty)
  if t is TyMap { return t.mKey }
  -1
}

// Whether node `ix` records a map whose KEY is a literal union. `nodeTyMapKeyKind` answers
// the i32 kind for it too, so this is the half that separates a member literal — which lowers as the
// interned atom, not a string ref — from a genuine `{[i32]: V}` key (D1748).
export function nodeTyMapKeyIsLitUnion(ix: i32): boolean {
  tyIsLitUnion(tyMapKeyOf(nodeMapTyIx(ix)))
}

// The map value type a node's recorded map type carries, or -1 — the structural
// answer to `fieldElemTyIxOfName(mapValNameOf(<the node's spelling>))`, recovering a
// type the checker had already resolved at that very node.
export function nodeMapValTyIx(nodeIx: i32): i32 {
  tyMapValOf(nodeMapTyIx(nodeIx))
}

// The interned struct-table slot for an object type `ty`, derived from the arena
// alone, or -1 (the consumer keeps its nominal path). The struct table is keyed
// nominally, so this resolver tries an exact arena-index match against a declared
// slot's memoized type first, else the unique structurally-matching slot, else -1 — zero or many matches are left to the nominal path, never collapsed.
const repSlotCacheGenKey = memoKeyNew(3)
let repSlotByDecl: i32[] = []
let repSlotKeySi: i32[] = []
let repSlotKeyN: i32[] = []
// The SMALLEST slot in each key's bucket (D100). `repSlotKeySi` records the LAST
// match, which is all a `n == 1` gate ever needed; the twin rung below reaches for a
// bucket of two or more and must name a DETERMINISTIC representative, which is the
// same "smallest twin" `repStructSlotRep` already defines.
let repSlotKeyFirst: i32[] = []

// Rebuilt whenever anything the scan reads can have changed: an arena mutation
// (`tyMutEpoch`), a `cUserTypes` write (`cUserTypesVer` — which arena index a name
// resolves to), or `sNames` growth (push-only within a program; the cross-program
// reset always rides an `initChecker` epoch advance).
function repSlotCacheSync() {
  if !memoMoved3(repSlotCacheGenKey, tyMutEpoch, cUserTypesVer, sNames.length) {
    return 0
  }
  // Cleared for the build, so an ask nested inside it rebuilds rather than reading a half-built cache.
  memoKeyClear(repSlotCacheGenKey)
  repSlotByDecl = []
  repSlotKeySi = []
  repSlotKeyN = []
  repSlotKeyFirst = []
  let si = 0
  while si < sNames.length {
    // Declared-ness and arena type are banked separately: `sRowDecl` at the mint (the
    // name's own `cUserTypes` answer, asked once) and the `sTyIx` sidecar. The column
    // must be reset together with `sNames`, the same hazard `structNameIxReset` and
    // `structTyIxReset` carry — an unreset column still describes the old name at that index.
    let di = -1
    if si < sRowDecl.length {
      if sRowDecl[si] == 1 {
        if si < sTyIx.length { di = sTyIx[si] }
      }
    }
    if di >= 0 {
      const dt = tyAt(di)
      if dt is TyObj {
        while repSlotByDecl.length <= di { repSlotByDecl.push(-1) }
        if repSlotByDecl[di] < 0 { repSlotByDecl[di] = si }
        const k = repCanonId(di)
        while repSlotKeySi.length <= k {
          repSlotKeySi.push(-1)
          repSlotKeyN.push(0)
          repSlotKeyFirst.push(-1)
        }
        repSlotKeySi[k] = si
        if repSlotKeyFirst[k] < 0 { repSlotKeyFirst[k] = si }
        repSlotKeyN[k] = repSlotKeyN[k] + 1
      }
    }
    si = si + 1
  }
  // Recorded after the build: `repKeyGo`'s walk only reads the arena, so the
  // generations compared at entry still hold for everything just recorded.
  memoMoved3(repSlotCacheGenKey, tyMutEpoch, cUserTypesVer, sNames.length)
  0
}

// The nominal-identity leg of `repSlotOfTy` (rep-twin phase 1): the declared-struct
// slot whose `cUserTypes` arena index is `ty`, or -1, no structural bridge — split
// out so `repSlotOfTy` layers the bridge on one shared lookup. The sig-canon slice
// canonicalizes a twin-slot's digits, so a twin-slot shift still keys the same `$fnsig` (#980).
function repSlotOfTyDecl(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = tyAt(ty)
  if !(t is TyObj) { return -1 }
  repSlotCacheSync()
  // Nominal identity — the scan's `di == ty` early return.
  if ty < repSlotByDecl.length {
    if repSlotByDecl[ty] >= 0 { return repSlotByDecl[ty] }
  }
  -1
}

// The declared-struct slot a slot key renders record `ty` as. Under `elem` it is the layout
// class's representative slot (`repStructSlotRep`), so layout twins and a shape spelling of a
// declared struct key one ref-list row at every depth. -1 keys the record by its fields.
function repSlotOfElemTy(ty: i32, mode: RepKeyMode): i32 {
  const ds = repSlotOfTyDecl(ty)
  if !repKeyFoldsLeafList(mode) { return ds }
  if ds >= 0 { return repStructSlotRep(ds) }
  const nom = nominalStructNameOfTy(ty)
  if nom != "" && nominalStructSoleOfTy(ty) {
    const d = declTyIxOfName(nom)
    if d >= 0 && d != ty && repCanonId(ty) == repCanonId(d) {
      const dd = repSlotOfTyDecl(d)
      if dd >= 0 { return repStructSlotRep(dd) }
    }
  }
  const bs = repSlotOfTy(ty)
  if bs >= 0 { return repStructSlotRep(bs) }
  -1
}

export function repSlotOfTy(ty: i32): i32 {
  // Nominal identity first — `repSlotOfTyDecl`'s shared leg.
  const ds = repSlotOfTyDecl(ty)
  if ds >= 0 { return ds }
  if ty < 0 { return -1 }
  const t = tyAt(ty)
  if !(t is TyObj) { return -1 }
  // The structural→nominal bridge: the UNIQUE declared twin, else -1. (No slot
  // has the queried arena index here, so the count is exactly the scan's `n`.)
  const key = repCanonId(ty)
  if key < 0 || key >= repSlotKeyN.length { return -1 }
  if repSlotKeyN[key] == 1 { return repSlotKeySi[key] }
  // D100 — a unique heap type is a weaker question than a unique row: if the bucket's
  // claimants are `repStructSlotsTwin`, they already share one WasmGC heap type, so
  // "first row wins" is sound. The predicate tests every member against the bucket's
  // first row's twin-ness; two rows sharing a key but not a layout still decline, kept unreachable by the caller's `variantIndexOf` gate.
  const fst = repSlotKeyFirst[key]
  if fst < 0 { return -1 }
  let si2 = 0
  while si2 < sNames.length {
    let d2 = -1
    if si2 < sRowDecl.length {
      if sRowDecl[si2] == 1 {
        if si2 < sTyIx.length { d2 = sTyIx[si2] }
      }
    }
    if d2 >= 0 {
      if repCanonId(d2) == key {
        if repStructSlotsTwin(fst, si2) == 0 { return -1 }
      }
    }
    si2 = si2 + 1
  }
  fst
}

// Structural identity, hash-consed — the rep key without a spelling. `repCanonKey`/
// `repElemKey` render a string used only for equality; these intern `(tag, args...)`
// directly and return an index, so two structurally-equal types get the same i32
// with no spelling composed. The recursion mirrors the string builders arm for arm, since the partition must be identical, not merely similar.
const HC_ERRTY = 0 // the `ty < 0` key, `"!"`
const HC_PRIM = 1
const HC_OBJ = 2
const HC_ARRAY = 3
const HC_NUL = 4
const HC_UNION = 5
const HC_FUNC = 6
const HC_MAP = 7
const HC_SET = 8
const HC_NEG = 9
const HC_BACK = 10 // de Bruijn back-edge, arg = depth
const HC_IDX = 11 // the arena-index sentinel `"@<ix>"` (TyVar / TyLit / TyErr)
const HC_BIG = 12 // the runaway cap `"@big:<id>"`, arg = the structural id it caps
const HC_SLOT = 13 // a DECLARED slot `"S<n>"` — elem and mv keys
const HC_RLI32 = 14 // `"$rlI32L"` — elem key only
const HC_RLSTR = 15 // `"$rlStrL"` — elem key only
const HC_NAME = 16 // the unresolvable-spelling key `"name:<nm>"`, arg = the name's sid
const HC_FIELDSET = 17 // a shape row's (field name sid, field code) multiset, name-sorted

let hcTag: i32[] = []
let hcArgStart: i32[] = []
let hcArgCount: i32[] = []
let hcArgs: i32[] = []
let hcHashV: i32[] = []
let hcLen: i32[] = []
let hcNext: i32[] = []
let hcBucket: i32[] = []
let hcMask = -1

// Reset the identity table. Called where `sidReset` is called and for the same reason:
// `HC_PRIM` and `HC_OBJ` carry `sidOf` ids for the primitive keyword and the field names,
// so an id minted against one program's symbol space means nothing against the next one's.
export function hcReset() {
  // Everything keyed on an hc id dies with the id space, not merely as a per-program
  // courtesy: `sidKeyedTablesReset` runs inside the module-parse loop, so the space
  // restarts mid-compile. The two ty->id memos hold ids as values and the slot cache
  // holds them as indices; both would index the previous space's rows if not cleared here.
  hcCanonMemo = []
  hcRowMemo = []
  hcElemMemo = []
  hcMvMemo = []
  hcImpure = 0
  memoKeyClear(repSlotCacheGenKey)
  hcTag = []
  hcArgStart = []
  hcArgCount = []
  hcArgs = []
  hcHashV = []
  hcLen = []
  hcNext = []
  hcBucket = []
  hcMask = -1
  0
}

// The character count `i32ToStr` would produce — WITHOUT producing it. The whole point of
// `hcLen` is to know the rendered length without rendering, so asking `i32ToStr(n).length`
// here would defeat the exercise at the one place it is easiest to get wrong.
function hcDigits(n: i32): i32 {
  if n < 0 { return 1 + hcDigits(0 - n) }
  if n < 10 { return 1 }
  1 + hcDigits(n / 10)
}

// FNV-1a over the tag and the argument ids, with the offset basis reduced to fit an i32
// literal (the constant's VALUE is irrelevant to correctness — it only spreads buckets).
// Masked to 30 bits so the bucket index is non-negative without depending on how the host
// lowers a shifted sign bit.
function hcHash(tag: i32, args: i32[]): i32 {
  let h = 0x1c9dc5 ^ tag
  h = h * 16777619
  let i = 0
  while i < args.length {
    h = (h ^ args[i]) * 16777619
    i = i + 1
  }
  h & 0x3fffffff
}

function hcGrow() {
  let cap = 16
  while cap < hcTag.length * 2 { cap = cap * 2 }
  hcBucket = []
  let i = 0
  while i < cap {
    hcBucket.push(-1)
    i = i + 1
  }
  hcMask = cap - 1
  let id = 0
  while id < hcTag.length {
    const b = hcHashV[id] & hcMask
    hcNext[id] = hcBucket[b]
    hcBucket[b] = id
    id = id + 1
  }
  0
}

function hcIntern(tag: i32, args: i32[], len: i32): i32 {
  if hcMask < 0 { hcGrow() }
  const h = hcHash(tag, args)
  let b = hcBucket[h & hcMask]
  while b >= 0 {
    if hcHashV[b] == h && hcTag[b] == tag && hcArgCount[b] == args.length {
      let ok = true
      const st = hcArgStart[b]
      let i = 0
      while i < args.length {
        if hcArgs[st + i] != args[i] { ok = false }
        i = i + 1
      }
      if ok { return b }
    }
    b = hcNext[b]
  }
  const id = hcTag.length
  hcTag.push(tag)
  hcArgStart.push(hcArgs.length)
  hcArgCount.push(args.length)
  hcHashV.push(h)
  hcLen.push(len)
  hcNext.push(-1)
  let j = 0
  while j < args.length {
    hcArgs.push(args[j])
    j = j + 1
  }
  // Grow AFTER the push so the rebuild chains the new entry too; otherwise insert it.
  if hcTag.length * 4 > (hcMask + 1) * 3 {
    hcGrow()
  } else {
    const bi = h & hcMask
    hcNext[id] = hcBucket[bi]
    hcBucket[bi] = id
  }
  id
}

// The rendered length of id `i` — `hcLen`'s accessor, and the one place that knows the
// column is parallel to the id space.
function hcLenOf(i: i32): i32 {
  if i < 0 || i >= hcLen.length { return -1 }
  hcLen[i]
}

// The structural id an `HC_BIG` id caps, or `i` itself for any other id.
function hcBigInner(i: i32): i32 {
  if i < 0 || i >= hcTag.length || hcTag[i] != HC_BIG { return i }
  hcArgs[hcArgStart[i]]
}

const hcNoArgs: i32[] = []

// The `"name:<nm>"` key — a NAME-derived identity, not a structural one, minted where a
// spelling resolves to no type. It carries the name's sid rather than the spelling, so it
// is still the one place a name reaches this table and it can never collide with a
// structural key (its tag is its own).
function hcNameId(name: string): i32 {
  const a: i32[] = []
  a.push(sidOf(name))
  hcIntern(HC_NAME, a, 5 + name.length)
}

// The shape interner's FIELDSET key — the (field-name sid, field code) multiset a row is
// deduped by, canonically ordered by the caller. Interned here so the shape layer's
// identity shares one table with the rep layer's and can never collide with it: the tag
// is its own. No length is meaningful (nothing renders this key), so it carries 0.
export function hcShapeSetId(args: i32[]): i32 {
  hcIntern(HC_FIELDSET, args, 0)
}

function hcPrimId(name: string): i32 {
  const a: i32[] = []
  a.push(sidOf(name))
  hcIntern(HC_PRIM, a, name.length)
}

// The identity twins of the three rep keys: one interned id per key, each mode with its own
// cycle stack and depth-0 memo, exactly as `repKeyOf` keeps them. `canon`'s memo rides
// `repKeyMemo`'s generation; `elem`'s and `mv`'s ride `repElemMemo`'s triple, since both walks
// read `repSlotOfTyDecl`, which is sid-keyed and reset inside the module-parse loop.
let hcCanonMemo: i32[] = []
const hcCanonStack: i32[] = []
let hcElemMemo: i32[] = []
const hcElemStack: i32[] = []
let hcMvMemo: i32[] = []
const hcMvStack: i32[] = []
let hcRowMemo: i32[] = []
const hcRowStack: i32[] = []

export function repCanonId(ty: i32): i32 { repIdOf(ty, "canon") }

// A struct row's identity: the canonical id with every function type keyed as the closure cell
// it is stored as, so records apart only in a function field's type share one row. The row's
// reader takes that field's type from the position, never from the row.
export function repRowId(ty: i32): i32 { repIdOf(ty, "row") }

export function repElemId(ty: i32): i32 { repIdOf(ty, "elem") }

// The ref-list element key of a union with members `mems`, as `repElemId` keys one the arena
// holds; `mems` is taken as given, never deduped.
export function repElemIdOfMembers(mems: i32[]): i32 { hcUnionId(mems, "elem") }

function repMvValId(ty: i32): i32 { repIdOf(ty, "mv") }

// The one entry every identity walk recurses through, so a nested call re-enters its own
// mode's stack: sharing one stack between two modes would report a cycle in one walk as a
// back-edge in the other.
function repIdOf(ty: i32, mode: RepKeyMode): i32 {
  if ty < 0 { return hcIntern(HC_ERRTY, hcNoArgs, 1) }
  const stack = hcStackOf(mode)
  const d = repFoldDepth(stack, ty)
  if d > 0 {
    const a: i32[] = []
    a.push(d)
    hcImpure = hcImpure + 1
    return hcIntern(HC_BACK, a, 1 + hcDigits(d))
  }
  const top = stack.length == 0
  const hit = hcMemoGet(ty, mode)
  if hit >= 0 { return hit }
  if hit < -1 {
    if top {
      hcImpure = hcImpure + 1
      return -2 - hit
    }
  }
  const before = hcImpure
  stack.push(ty)
  let r = repIdGo(ty, mode)
  stack.pop()
  if hcLenOf(r) > 262144 {
    const a: i32[] = []
    a.push(r)
    r = hcIntern(HC_BIG, a, 5 + hcDigits(r))
  }
  if hcImpure == before {
    hcMemoPut(ty, mode, r)
  } else {
    if top { hcMemoPut(ty, mode, -2 - r) }
  }
  r
}

// The count of answers a walk took from its position — a back-edge, or a banked top-level
// answer that had one. A walk that leaves it unchanged means the same id at every depth, so
// its answer is banked for interior asks too, which keeps a shared inner type to one walk.
let hcImpure = 0

// A memo cell's id whatever its purity: `-2 - id` banks a top-level-only answer, -1 a miss.
function hcMemoIdOf(v: i32): i32 {
  if v < -1 { return -2 - v }
  v
}

function hcStackOf(mode: RepKeyMode): i32[] {
  match mode {
    "canon" => {
      return hcCanonStack
    }
    "elem" => {
      return hcElemStack
    }
    "mv" => {
      return hcMvStack
    }
    "row" => {
      return hcRowStack
    }
  }
}

// The memo cell for `ty` under `mode`: an id, -1 for a miss, or `-2 - id` for an answer valid
// only at depth 0.
function hcMemoGet(ty: i32, mode: RepKeyMode): i32 {
  match mode {
    "canon" => {
      repKeyMemoSync()
      if ty < hcCanonMemo.length { return hcCanonMemo[ty] }
      return -1
    }
    "elem" => {
      repElemMemoSync()
      if ty < hcElemMemo.length { return hcElemMemo[ty] }
      return -1
    }
    "mv" => {
      repElemMemoSync()
      if ty < hcMvMemo.length { return hcMvMemo[ty] }
      return -1
    }
    "row" => {
      repKeyMemoSync()
      if ty < hcRowMemo.length { return hcRowMemo[ty] }
      return -1
    }
  }
}

function hcMemoPut(ty: i32, mode: RepKeyMode, r: i32) {
  match mode {
    "canon" => {
      while hcCanonMemo.length <= ty { hcCanonMemo.push(-1) }
      hcCanonMemo[ty] = r
    }
    "elem" => {
      while hcElemMemo.length <= ty { hcElemMemo.push(-1) }
      hcElemMemo[ty] = r
    }
    "mv" => {
      while hcMvMemo.length <= ty { hcMvMemo.push(-1) }
      hcMvMemo[ty] = r
    }
    "row" => {
      while hcRowMemo.length <= ty { hcRowMemo.push(-1) }
      hcRowMemo[ty] = r
    }
  }
  0
}

// The identity walk, arm for arm the id of `repKeyGo`'s string, with one deliberate
// difference: a union's members, and under `canon` an object's fields, are sorted, so a
// reordered spelling of one type is one id (D1712) where the string keeps spelling order.
function repIdGo(ty: i32, mode: RepKeyMode): i32 {
  const t = tyAt(ty)
  match t {
    TyPrim => {
      return hcPrimId(t.primName)
    }
    TyObj => {
      if repKeyIsCanon(mode) { return hcCanonObjId(t, mode) }
      const ds = repSlotOfElemTy(ty, mode)
      if ds >= 0 {
        const a: i32[] = []
        a.push(ds)
        return hcIntern(HC_SLOT, a, 1 + hcDigits(ds))
      }
      const a2: i32[] = []
      let len = 2
      let i = 0
      while i < t.objFieldNames.length {
        const c = repIdOf(t.objFieldTypes[i], mode)
        a2.push(sidOf(t.objFieldNames[i]))
        a2.push(c)
        len = len + t.objFieldNames[i].length + 1 + hcLenOf(c) + 1
        i = i + 1
      }
      return hcIntern(HC_OBJ, a2, len)
    }
    TyArray => {
      // Only the ref-list elem key folds an i32/string leaf array to a single shared row; the
      // map-value key must not, since folding would make a `{[K]: i32[]}` resolve a `{[K]:
      // boolean[]}`'s slot.
      if repKeyFoldsLeafList(mode) {
        if tyIsI32LeafElem(t.aElem) { return hcIntern(HC_RLI32, hcNoArgs, 7) }
        if tyIsStrLeafElem(t.aElem) { return hcIntern(HC_RLSTR, hcNoArgs, 7) }
      }
      const c = repIdOf(t.aElem, mode)
      const a: i32[] = []
      a.push(c)
      return hcIntern(HC_ARRAY, a, hcLenOf(c) + 2)
    }
    TyNullable => {
      // A nullable union is the union's flat member set with a `null`, however it is nested.
      if t.nInner >= 0 && !tyIsLitUnion(t.nInner) && tyAt(t.nInner) is TyUnion {
        const self: i32[] = []
        self.push(ty)
        return hcUnionId(self, mode)
      }
      const c = repIdOf(t.nInner, mode)
      const a: i32[] = []
      a.push(c)
      return hcIntern(HC_NUL, a, hcLenOf(c) + 1)
    }
    TyUnion => {
      const lb = if mode == "elem" { oneIntLitBaseOf(t.uMembers) } else { -1 }
      if lb >= 0 { return repIdOf(lb, mode) }
      return hcUnionId(t.uMembers, mode)
    }
    TyFunc => {
      if mode == "row" { return hcIntern(HC_FUNC, hcNoArgs, 2) }
      // `"(" + join(",", params) + ")=>" + ret` — ONE for the open paren; the closer is
      // inside the `")=>"` added below, so starting at 2 double-counts it.
      const a: i32[] = []
      let len = 1
      let i = 0
      while i < t.fnParamTypes.length {
        if i > 0 { len = len + 1 }
        const c = repIdOf(t.fnParamTypes[i], mode)
        a.push(c)
        len = len + hcLenOf(c)
        i = i + 1
      }
      const rc = repIdOf(t.fnRet, mode)
      a.push(rc)
      len = len + 3 + hcLenOf(rc)
      return hcIntern(HC_FUNC, a, len)
    }
    TyMap => {
      const kc = repIdOf(t.mKey, mode)
      const vc = repIdOf(repMapValTy(t.mVal, mode), mode)
      const a: i32[] = []
      a.push(kc)
      a.push(vc)
      let head = 1
      let tag = HC_MAP
      // The canon and mv ids keep a Set with its boolean-valued map twin, as `repKeyGo` does.
      if t.mSet == 1 && !repKeyFoldsSet(mode) {
        head = 2
        tag = HC_SET
      }
      return hcIntern(tag, a, head + 1 + hcLenOf(kc) + 1 + hcLenOf(vc) + 1)
    }
    TyNeg => {
      const c = repIdOf(t.negTy, mode)
      const a: i32[] = []
      a.push(c)
      return hcIntern(HC_NEG, a, 1 + hcLenOf(c))
    }
    TyVar => {}
    TyLit => {
      // `repKeyGo`'s literal arm: under `canon` a bare literal keys as its base scalar.
      if repKeyIsCanon(mode) { return repIdOf(litBaseTy(t), mode) }
    }
    TyErr => {}
  }
  const a: i32[] = []
  a.push(ty)
  hcIntern(HC_IDX, a, 1 + hcDigits(ty))
}

// The canonical id of an object: the `name:child,` pairs with field order sorted out, since
// `{a: i32, b: string}` and `{b: string, a: i32}` are one type and keying them by declaration
// order minted two heap types for one shape. Field names are unique, so ordering by sid is a
// bijection: it can merge twins and never collide distinct types.
function hcCanonObjId(t: TyObj, mode: RepKeyMode): i32 {
  const sortedSid: i32[] = []
  const sortedIx: i32[] = []
  let si2 = 0
  while si2 < t.objFieldNames.length {
    const sd = sidOf(t.objFieldNames[si2])
    let j2 = sortedSid.length
    sortedSid.push(sd)
    sortedIx.push(si2)
    while j2 > 0 {
      if sortedSid[j2 - 1] <= sd {
        j2 = 0
      } else {
        sortedSid[j2] = sortedSid[j2 - 1]
        sortedIx[j2] = sortedIx[j2 - 1]
        sortedSid[j2 - 1] = sd
        sortedIx[j2 - 1] = si2
        j2 = j2 - 1
      }
    }
    si2 = si2 + 1
  }
  const a: i32[] = []
  let len = 2
  let i = 0
  while i < sortedIx.length {
    const fx = sortedIx[i]
    const ft = hcRowFieldTy(repCanonFieldTy(t.objFieldTypes[fx]), mode)
    const asSet = repFieldLitAsSet(ft)
    const fm = hcRowFieldMode(ft, mode)
    const c = if asSet.length > 0 { hcUnionId(asSet, fm) } else { repIdOf(ft, fm) }
    a.push(sortedSid[i])
    a.push(c)
    len = len + t.objFieldNames[fx].length + 1 + hcLenOf(c) + 1
    i = i + 1
  }
  hcIntern(HC_OBJ, a, len)
}

// The type a record field is keyed by: a row keys a nullable record field as the record, since
// the field holds a nullable reference to it either way.
function hcRowFieldTy(ft: i32, mode: RepKeyMode): i32 {
  if mode != "row" || ft < 0 || ft >= T.tys.length { return ft }
  const t = tyAt(ft)
  if t is TyNullable {
    if t.nInner >= 0 && t.nInner < T.tys.length && tyAt(t.nInner) is TyObj {
      return t.nInner
    }
  }
  ft
}

// The mode a record field is keyed in: a row keys its own fields, and a nested record's or a
// union's, as a row, but a list's or a map's element by its canonical type, since a container's
// value slot is interned per element type.
function hcRowFieldMode(ft: i32, mode: RepKeyMode): RepKeyMode {
  if mode != "row" || ft < 0 || ft >= T.tys.length { return mode }
  const t = tyAt(ft)
  if t is TyArray || t is TyMap { return "canon" }
  mode
}

// The union arm of the identity walk: `repKeyUnion`'s mix-widening, over ids. A member that
// is itself a non-literal union contributes its members and a nullable one its inner and a
// `null`, so a union holding an alias union keys as its flat member set does, and a set
// holding `null` keys as the nullable of the rest, as the nullable arm does.
function hcUnionId(given: i32[], mode: RepKeyMode): i32 {
  const mems: i32[] = []
  if !hcUnionFlatInto(given, mems) { return hcUnionSetId(mems, mode) }
  const c = if mems.length == 1 { repIdOf(mems[0], mode) } else { hcUnionSetId(mems, mode) }
  const n: i32[] = []
  n.push(c)
  hcIntern(HC_NUL, n, hcLenOf(c) + 1)
}

// `hcUnionId` over a flat member set holding no `null`.
function hcUnionSetId(mems: i32[], mode: RepKeyMode): i32 {
  const mixed = repUnionIsMixed(mems)
  const strId = hcPrimId("string")
  const a: i32[] = []
  let len = 2
  let emitted = 0
  let sawWideStr = false
  let i = 0
  while i < mems.length {
    let r = repIdOf(mems[i], repUnionMemberMode(mems[i], mode))
    let skip = false
    if mixed {
      if repMemberIsLit(mems[i]) { r = strId }
      if r == strId {
        if sawWideStr { skip = true }
        sawWideStr = true
      }
    }
    if !skip {
      if emitted > 0 { len = len + 1 }
      a.push(r)
      len = len + hcLenOf(r)
      emitted = emitted + 1
    }
    i = i + 1
  }
  // A union is a SET, so a member's place in the spelling is not part of its identity (owner
  // ruling, D1712) — the same rule and the same insertion sort the `TyObj` arm applies to its
  // field names. Sorted, never deduped: two members with one id are two arms, and the box tags
  // are read off the row's own recorded set, not off this key.
  let ui = 1
  while ui < a.length {
    const cur = a[ui]
    let uj = ui - 1
    while uj >= 0 && a[uj] > cur {
      a[uj + 1] = a[uj]
      uj = uj - 1
    }
    a[uj + 1] = cur
    ui = ui + 1
  }
  hcIntern(HC_UNION, a, len)
}

// Appends `mems` to `out` with each non-literal union member replaced by its own members and
// each nullable one by its inner's. True when a member is nullable.
function hcUnionFlatInto(mems: i32[], out: i32[]): boolean {
  let nul = false
  for m in mems {
    let flat = false
    if m >= 0 && !tyIsLitUnion(m) {
      const mt = tyAt(m)
      if mt is TyUnion {
        if hcUnionFlatInto(mt.uMembers, out) { nul = true }
        flat = true
      } else if mt is TyNullable && mt.nInner >= 0 {
        const inner: i32[] = []
        inner.push(mt.nInner)
        hcUnionFlatInto(inner, out)
        nul = true
        flat = true
      }
    }
    if !flat { out.push(m) }
  }
  nul
}

// Structural heap-type dedup (roadmap Next#1, slot layer): the canonical structural
// key for struct slot `si`, or "" when it does not participate. A declared struct
// keys on its memoized arena index; an inline-shape slot resolves its annotation
// spelling through the checker's grammar. Keys via `repCanonKey`: identical slots render the same key, distinct ones never collide, and anything else stays "" and unmerged.
const repNoTyparams: string[] = []

// The arena type index a struct-row name denotes, or -1 — the resolution
// `slotCanonId` once inlined. Exported so the row mint sites can record it into the `sTyIx` sidecar (phase D0) at the moment the annotation is in scope.
export function sTyIxOfName(nm: string): i32 { sTyIxOfNameTy(nm, -1) }

// `sTyIxOfName` with the caller's recorded arena type for this name (destringify
// D-INLINESHAPETY), -1 for no hint. The bridge's body is `cUserTypes[nm] ??
// resolveAnnot(nm)`, so a hinted caller just asks `resolveAnnot` to hand back what it
// already holds; the name ladder is untouched for every unhinted caller.
export function sTyIxOfNameTy(nm: string, tyIx: i32): i32 {
  if tyIx >= 0 { return tyIx }
  const di = cUserTypes[nm] ?? -1
  if di >= 0 { return di }
  // The inline-shape fallback: only a bare `{...}` spelling (not a map `{[`) resolves.
  // Runs at intern time inside `collectS`'s row-minting loop; `resolveAnnot` mints
  // arena types per call (the #961 runaway shape), but the annotation-name memo keeps
  // the cost in the noise. A name resolving through neither path stays -1, and `slotCanonId` falls through to its existing name behaviour.
  if nameIsShapeSpanEnds(nm) { return resolveAnnot(nm, repNoTyparams) }
  // The generic-application fallback (`Box<i32>`), one spelling wider: `gaeEnsure`
  // mints a row for every concrete application and records the sidecar through this
  // function. Safe by construction: `resolveAnnot` is the same resolution the checker
  // performed at that spelling, so the recorded index is not a new equivalence — `buildStructTwins`'s second gate (`structFieldCodesEq`) still has to agree.
  if annGenAppSpanEnds(nm) { return resolveAnnot(nm, repNoTyparams) }
  -1
}

// Whether the struct row just pushed came from a declared type name, decided from
// its own spelling at the mint. Pads with 0 (not declared) so an uncalled mint site
// gets the conservative answer. This is `cUserTypes` membership, which includes
// union declarations — the right predicate for `repSlotCacheSync`, but the wrong one for `structIdxOfElemName`, which needs `nameIsStructDecl` instead.
export function recordSRowDeclOfName(nm: string) {
  let v = 0
  if cUserTypes.has(nm) { v = 1 }
  while sRowDecl.length + 1 < sNames.length { sRowDecl.push(0) }
  sRowDecl.push(v)
  0
}

// Record `v` as the arena type index of the struct row JUST pushed onto `sNames`. Pads
// with -1 so a mint site that does not call this self-heals to "uncovered" — `slotCanonId`
// then falls through to the legacy name path rather than reading a mis-aligned entry.
export function recordSTyIx(v: i32) {
  while sTyIx.length + 1 < sNames.length { sTyIx.push(-1) }
  sTyIx.push(v)
  0
}

// The arena type index a struct/variant field's recorded element/target name
// denotes, or -1 — the `sFieldElemTyIx`/`uFieldElemTyIx` sidecars' producer (phase
// D5). Nominal first, then the annotation grammar (`declTyIxOfName`'s two rungs); a
// synthetic `#anonN` name resolving through neither costs one failed lookup and records -1. Runs once per field at intern time.
export function fieldElemTyIxOfName(nm: string): i32 {
  if nm == "" { return -1 }
  // The runaway cap, mirroring `repNameCanonId` / `repElemIdOfNameTy`: a spelling this
  // long is never a legit slot key, and feeding it to `resolveAnnot` mints fresh arena
  // types per probe. -1 is the documented safe degenerate (the name path is kept).
  if nm.length > 4096 { return -1 }
  declTyIxOfName(nm)
}

// The emit side's name -> arena-type bridge, the one home for its three rungs: the
// declared-name table answers a nominal spelling, the primitive leaf a bare keyword,
// and only a spelling neither carries reaches the annotation grammar. Guard-free by
// design, since each caller's empty-name and runaway-cap policy differs; the rungs are parse eliminators, not caches.
export function declTyIxOfName(nm: string): i32 {
  const di = cUserTypes[nm] ?? -1
  if di >= 0 { return di }
  // Rung 2, the primitive leaf: `primTyOfName` is one of the three leaf rungs both
  // checker resolvers bottom out at, and a bare `i32`/`string`/`null` spelling is a
  // leaf the grammar below takes apart into nothing before arriving here anyway. It
  // answers a seeded arena index no second entry shadows, since no declaration can be spelled with a primitive keyword.
  const pi = primTyOfName(nm)
  if pi >= 0 { return pi }
  resolveAnnot(nm, repNoTyparams)
}

// Record the two sidecar columns of the struct field row just pushed onto
// `sFieldElemName`: the element/target name's arena type (phase D5) and, for a map
// field, the key half of the map's rep (B6b). Pads -1/0 so a skipped push self-heals
// to uncovered. One recorder for both, since writing the key at only some push sites is exactly the parallel-array skew this table is most fragile to.
export function recordSFieldElemRow(nm: string, keyK: i32) {
  recordSFieldElemRowTy(nm, keyK, -1)
}

// `recordSFieldElemRow` with the caller's arena row for `nm`; -1 is exactly the
// unhinted call, unchanged by construction. On the sidecar side of the mint-order
// line (D-MAPNODETY): the row is recorded beside a mint that already happened,
// never fronting one — a mint path here emits invalid wasm (the mv-slot interner).
export function recordSFieldElemRowTy(nm: string, keyK: i32, tyHint: i32) {
  recordFieldElemRow(
    sFieldElemName,
    sFieldElemTyIx,
    sFieldElemKeyKind,
    nm,
    keyK,
    tyHint,
  )
}

// The `recordSFieldElemRowTy` twin for the VARIANT field table (`uFieldElemName`), with the
// caller's arena row for `nm` or -1. The sidecar side of the mint-order line, exactly as
// `recordSFieldElemRowTy`.
export function recordUFieldElemRowTy(nm: string, keyK: i32, tyHint: i32) {
  recordFieldElemRow(
    uFieldElemName,
    uFieldElemTyIx,
    uFieldElemKeyKind,
    nm,
    keyK,
    tyHint,
  )
}

// The shared body of both recorders, over one field table's name column and its two
// sidecars: pad each sidecar to the row just pushed onto `names`, then append its entry.
function recordFieldElemRow(
  names: string[],
  tys: i32[],
  keys: i32[],
  nm: string,
  keyK: i32,
  tyHint: i32,
) {
  while tys.length + 1 < names.length { tys.push(-1) }
  let ty = tyHint
  if ty < 0 { ty = fieldElemTyIxOfName(nm) }
  tys.push(ty)
  while keys.length + 1 < names.length { keys.push(0) }
  keys.push(keyK)
  0
}

// The interned id of a union member's atom spelling, after `peelGroupParens` (applied
// to both sides, so a `(() => i64)` member and an `is () => i64` test are the same
// reference). Two references are
// equal iff their ids are, so membership and subtraction are integer work. Ids are pure text identities with no arena content, so the table lives across programs.
export function msAtomIdOf(atom: string): i32 {
  const p = peelGroupParens(atom)
  const hit = msAtomIds[p] ?? -1
  if hit >= 0 { return hit }
  const id = msAtomTexts.length
  msAtomTexts.push(p)
  msAtomIds[p] = id
  id
}

// What a union member is, recorded beside its arena type: 0 the `null` keyword, 1
// nominal (a declared alias/struct/variant name, whose identity is the name), 2 a
// scalar primitive, 3 a composite, -1 unresolved. `ty` is the member's already-
// resolved arena index, so classification costs one map probe and one arena read, never re-deriving from the member's text beyond the `null` keyword test.
function unMemKindOf(atom: string, ty: i32): i32 {
  if atom == "null" { return 0 }
  const di = cUserTypes[atom] ?? -1
  if di >= 0 { return 1 }
  if ty < 0 { return -1 }
  if ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  if t is TyPrim { return 2 }
  3
}

// The member's value-atom kind, banked at the recorder: `valueAtomKind(atom)` is
// the union box ABI's 14-way code (i32/boolean/string/i64/f64/f32/null, six scalar
// list flavours, closure, -1 for not-a-value-atom), banked once by `recordUnMemTys`
// while it already holds each member's text. Exact, never a fold, since folding could hand a tag no producer interned — a runtime trap rather than a loud reject.
export let unMemValKind: i32[] = []

// The banked value-atom kind of recorded member `m`, or -2 when the bank does not
// cover it (a member recorded before this column existed in this program, or a
// column the external reset left behind — see the lock-step guard).
function unMemValKindAt(m: i32): i32 {
  if m < 0 { return -2 }
  if unMemValKind.length != unMemAtoms.length { return -2 }
  if m >= unMemValKind.length { return -2 }
  unMemValKind[m]
}

// The member slice of union row `u`, or -1 when the row is not covered by the member
// reference columns — the ONE home of the member-slice bounds, so a set the pool minted is
// a set this column can index. A row of any width is covered: a set's mask is as many words
// as its row needs (`msMaskWords`). `emit_union_registry`'s `msRowStart` delegates here.
export function unMemRowStart(u: i32): i32 {
  if u < 0 { return -1 }
  if u >= unMemTyStart.length { return -1 }
  const st = unMemTyStart[u]
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  if n < 1 { return -1 }
  if st + n > unMemAtoms.length { return -1 }
  st
}

// A set's row `u` names a member slice: a registered union row when `u >= 0`, row-less slice
// `-2 - u` (`msFreeStart`) when `u <= -2`. The readers below take either, so a set answers the
// same questions whether or not its members have a row; only a registered row has box tags.
// The member count of slice `u`, or -1 when it is not covered.
export function msSliceCount(u: i32): i32 {
  if u >= 0 {
    if unMemRowStart(u) < 0 { return -1 }
    return unMemTyCount[u]
  }
  const k = -2 - u
  if k < 0 || k >= msFreeStart.length { return -1 }
  const st = msFreeStart[k]
  const n = msFreeCount[k]
  if st < 0 || n < 1 || st + n > msFreeAtoms.length { return -1 }
  n
}

// Member `i` of covered slice `u`: its arena type (-1 for `null`), atom spelling, interned atom id,
// member kind (`unMemKindOf`) and value-atom kind (-2 when the bank does not cover it).
export function msSliceTy(u: i32, i: i32): i32 {
  if u >= 0 { return unMemTys[unMemRowStart(u) + i] }
  msFreeTys[msFreeStart[-2 - u] + i]
}

export function msSliceAtom(u: i32, i: i32): string {
  if u >= 0 { return unMemAtoms[unMemRowStart(u) + i] }
  msFreeAtoms[msFreeStart[-2 - u] + i]
}

export function msSliceAtomId(u: i32, i: i32): i32 {
  if u >= 0 { return unMemAtomIds[unMemRowStart(u) + i] }
  msFreeAtomIds[msFreeStart[-2 - u] + i]
}

export function msSliceKind(u: i32, i: i32): i32 {
  if u >= 0 { return unMemKinds[unMemRowStart(u) + i] }
  msFreeKinds[msFreeStart[-2 - u] + i]
}

export function msSliceValKind(u: i32, i: i32): i32 {
  if u >= 0 { return unMemValKindAt(unMemRowStart(u) + i) }
  msFreeValKind[msFreeStart[-2 - u] + i]
}

// The row-less slice holding members `tys` spelled `atoms` (index-parallel, -1 / "null" for
// `null`), as row id `-2 - k`; banked like `recordUnMemTys` banks a row's members.
export function msFreeSlicePush(tys: i32[], atoms: string[]): i32 {
  const k = msFreeStart.length
  msFreeStart.push(msFreeAtoms.length)
  msFreeCount.push(atoms.length)
  msFreeChain.push(-1)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    msFreeTys.push(tys[i])
    msFreeAtoms.push(a)
    msFreeAtomIds.push(msAtomIdOf(a))
    msFreeKinds.push(unMemKindOf(a, tys[i]))
    msFreeValKind.push(valueAtomKind(a))
    i = i + 1
  }
  -2 - k
}

// The number of 32-bit words a member mask over `n` members takes.
function msMaskWords(n: i32): i32 { (n + 31) >>> 5 }

// Is member `i` of its row in set `s`? The one reader of a stored mask; `s` is a set id the
// caller bounded and `i` below its row's member count. False past the stored words.
export function msSetHas(s: i32, i: i32): boolean {
  const ix = msSetWordAt[s] + (i >>> 5)
  if ix < 0 || ix >= msSetWords.length { return false }
  ((msSetWords[ix] >>> (i & 31)) & 1) == 1
}

// A fresh copy of set `s`'s mask words, for a subtraction to clear bits in before it interns
// the result (`msSetIntern`). `s` is a set id the caller bounded.
export function msSetMaskCopy(s: i32): i32[] {
  const n = msMaskWords(msSliceCount(msSetRow[s]))
  const at = msSetWordAt[s]
  const out: i32[] = []
  let k = 0
  while k < n {
    if at + k < msSetWords.length {
      out.push(msSetWords[at + k])
    } else {
      out.push(0)
    }
    k = k + 1
  }
  out
}

// The mask holding every one of `n` members.
export function msMaskFull(n: i32): i32[] {
  const out: i32[] = []
  let left = n
  while left > 0 {
    if left >= 32 { out.push(-1) } else { out.push((1 << left) - 1) }
    left = left - 32
  }
  out
}

// Is member `i` in mask `m`?
export function msMaskHas(m: i32[], i: i32): boolean {
  ((m[i >>> 5] >>> (i & 31)) & 1) == 1
}

// Clears member `i` in mask `m`; a no-op when it is already clear.
export function msMaskClear(m: i32[], i: i32) {
  if msMaskHas(m, i) { m[i >>> 5] = m[i >>> 5] - (1 << (i & 31)) }
  0
}

// Does mask `m` hold no member?
export function msMaskIsEmpty(m: i32[]): boolean {
  let k = 0
  while k < m.length {
    if m[k] != 0 { return false }
    k = k + 1
  }
  true
}

// The banked value-atom kind of the single member of interned member set `s` — what
// every `valueAtomKind(removeAtomFromSet(set, "null"))` consumer is really asking,
// since a residual with 0 or 2+ members renders as `""`/`"a|b"` and `valueAtomKind`
// answers -1 for both. -1 for a non-singleton set (the same answer the rendered form gives); -2 only when the pool or bank does not cover the set.
export function msSoloValKind(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -2 }
  if msSetGen[s] != msGen.at { return -2 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return -2 }
  let solo = -1
  let cnt = 0
  let i = 0
  while i < n {
    if msSetHas(s, i) {
      solo = i
      cnt = cnt + 1
    }
    i = i + 1
  }
  if cnt != 1 { return -1 }
  msSliceValKind(u, solo)
}

// Iteration over the banked kinds, the kind column's twin of `msMemberAtomsOfSet`:
// appends the set's members' banked codes to `out` in the row's recorded (box-tag
// ABI) order, so a consumer can carry the code alongside the spelling instead of
// re-deriving it per member. False leaves `out` untouched.
export function msMemberValKindsOf(s: i32, out: i32[]): boolean {
  if s < 0 || s >= msSetRow.length { return false }
  if msSetGen[s] != msGen.at { return false }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return false }
  if u >= 0 && unMemValKind.length != unMemAtoms.length { return false }
  let i = 0
  while i < n {
    if msSetHas(s, i) { out.push(msSliceValKind(u, i)) }
    i = i + 1
  }
  true
}

// Membership of a scalar value atom, by its ABI kind — `msHasNull`'s generalization
// to the whole scalar keyword row, answered from the banked kind column with no
// spelling. 1 present, 0 absent, -1 uncovered. Restricted to kinds 0-6, since only
// across those is the kind map a bijection (kind 7 folds several list shapes into one code, where an exact `TyPrim` test would disagree).
export function msHasValKind(s: i32, k: i32): i32 {
  if k < 0 || k > 6 { return -1 }
  if s < 0 || s >= msSetRow.length { return -1 }
  if msSetGen[s] != msGen.at { return -1 }
  const u = msSetRow[s]
  const n = msSliceCount(u)
  if n < 0 { return -1 }
  if u >= 0 && unMemValKind.length != unMemAtoms.length { return -1 }
  if u >= 0 && unMemTys.length != unMemAtoms.length { return -1 }
  let hit = 0
  let i = 0
  while i < n {
    if msSetHas(s, i) {
      const mk = msSliceValKind(u, i)
      if mk == k { hit = 1 }
      if mk < 0 {
        // An ALIAS spelling whose arena type IS a primitive would answer YES on the
        // `TyPrim` path and NO here — decline the whole set rather than differ.
        const ty = msSliceTy(u, i)
        if ty >= 0 && ty < T.tys.length {
          const t = tyAt(ty)
          if t is TyPrim { return -1 }
        }
      }
    }
    i = i + 1
  }
  hit
}

// Is the interned member set `s` a value union — one this emitter boxes into the
// shared `{tag, payload}` rep? Tri-state: 1 yes, 0 no, -1 the pool or kind bank does
// not cover `s` (the caller keeps its member-name path). Reads only the banked ABI
// codes `recordUnMemTys` already recorded per member, arm for arm with `isValueUnionName`'s spelling-based body, so the two cannot drift.
export function msIsValueUnion(s: i32): i32 {
  const kinds: i32[] = []
  if !msMemberValKindsOf(s, kinds) { return -1 }
  if kinds.length < 2 { return 0 }
  let nonNull = 0
  let hasNull = false
  let soloKind = -1
  let i = 0
  while i < kinds.length {
    const k = kinds[i]
    // A member that is not a value atom (a struct name, an inline shape, a
    // ref-element array) — not a value union, and the scan stops, exactly as the
    // spelling ladder's `if k < 0 { return false }` does.
    if k < 0 { return 0 }
    if k == nullValKind() {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    i = i + 1
  }
  if nonNull >= 2 { return 1 }
  if nonNull == 1 && hasNull {
    // Only a NUMERIC scalar boxes with null; `boolean | null` / `string | null` keep
    // their niche encodings, which are not boxes.
    if (
      soloKind == 0
      || soloKind == 3
      || soloKind == 4
      || soloKind == 5
      || soloKind == 14
    ) {
      return 1
    }
    return 0
  }
  0
}

// The globally-stable box TAG of a value atom, from its KIND — the one home of the
// kind→tag table. Struct variants take the dense ranks `0 .. uVariants.length-1`; atom
// kinds claim the fixed slots above them, stable across every union in the module.
export function scalarTagOfKind(k: i32): i32 {
  uVariants.length + k + relSkew(RS_TAG)
}

// The value-atom kind of the `null` member — a constant of the box ABI, not a
// question about a spelling. `null` is a keyword, never a rendered type, and
// `valueAtomKind` returns 6 for `"null"` and nothing else, so the map is a bijection
// at this one point. Named here, beside the kind-tag table, so the ABI's null code has one home.
export function nullValKind(): i32 { 6 }

// The globally-stable box tag of the `null` member — `scalarTagOfKind(nullValKind())`.
// Every producer and consumer of a null-tagged box (the `null` literal's coerce, `??`
// tag tests, a missing map entry's box, nullable-union stores) reads the tag from here instead of re-deriving it from the lexeme.
export function nullBoxTag(): i32 { scalarTagOfKind(nullValKind()) }

// A type that denotes a function type, seeing through the degenerate one-member
// union wrapper an arrow-bodied alias carries (`parser.vl` encodes every
// non-`{...}`-bodied `type N = ...` as a one-member `UnionDecl`). A one-member union
// denotes its member (#1122), so the wrapper is peeled iteratively — the alias-tolerant reading a consumer wants when asking whether the named type is a closure type.
export function tyDenotesFunc(m: i32): boolean {
  let cur = m
  let steps = 0
  while cur >= 0 && cur < T.tys.length && steps < 8 {
    const t = tyAt(cur)
    match t {
      TyFunc => {
        return true
      }
      TyUnion => {
        if t.uMembers.length != 1 { return false }
        cur = t.uMembers[0]
        steps = steps + 1
      }
      // Any other member is not a function type.
      TyPrim | TyObj | TyNullable | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => {
        return false
      }
    }
  }
  false
}

// D221 — the interned scalar value-box heap index for a value atom of kind `k`, or -1
// when the kind rides the box's `anyref` payload directly, or is not a value atom.
// Unminted is -1, not 0: `vb*Idx` initialises to 0, so a module that never uses a rep
// answered heap type 0 for it — a real type in every module, and the wrong one, indistinguishable from "no box" until this.
export function vbHeapIdxOfKind(k: i32): i32 {
  if k == 0 || k == 1 {
    if !vbI32Used { return -1 }
    return vbI32Idx
  }
  if k == 3 {
    if !vbI64Used { return -1 }
    return vbI64Idx
  }
  if k == 4 {
    if !vbF64Used { return -1 }
    return vbF64Idx
  }
  if k == 5 {
    if !vbF32Used { return -1 }
    return vbF32Idx
  }
  if k == 14 {
    if !vbV128Used { return -1 }
    return vbV128Idx
  }
  -1
}

// The value-eq opcode (i32 result) for a value atom of kind `k`: i32/boolean share
// `i32.eq`, i64/f64/f32 take their own; -1 for `string` (its eq loop), `null` (tag
// equality alone decides it) and every list/closure kind. Lives here, beside
// `scalarTagOfKind`/`vbHeapIdxOfKind`, since both call sites already hold the code and only needed a home free of re-deriving it from a spelling.
export function atomEqOpcodeOfKind(k: i32): i32 {
  if k == 0 || k == 1 {
    return 70 // 0x46 i32.eq
  }
  if k == 3 {
    return 81 // 0x51 i64.eq
  }
  if k == 4 {
    return 97 // 0x61 f64.eq
  }
  if k == 5 {
    return 91 // 0x5b f32.eq
  }
  -1
}

// The wasm value blocktype byte a value atom of kind `k` carries — the result type a
// value-producing `if` must declare when its arms yield the unboxed atom. i64/f64/f32
// take their own; every other kind reads as the i32 blocktype. One home for a table
// several call sites otherwise duplicate, each beside its own default-emit dispatch on the same code.
export function valBlockTypeOfKind(k: i32): i32 {
  if k == 3 {
    return 126 // 0x7e i64
  }
  if k == 4 {
    return 124 // 0x7c f64
  }
  if k == 5 {
    return 125 // 0x7d f32
  }
  if k == 14 {
    return 123 // 0x7b v128
  }
  127 // 0x7f i32 (boolean shares it)
}

// Drop every interned member set (the D-UNION set ADT, see `msSetRow` in
// `emit_state`) and bump the pool generation. A set id is a (union row, member mask)
// pair, both per-program, so the generation stamp makes a missed reset site read as
// uncovered rather than answering from the previous program's rows.
export function msPoolReset() {
  msSetRow = []
  msSetWordAt = []
  msSetWords = []
  msSetNext = []
  msSetText = []
  msSetGen = []
  msRowChain = []
  msFreeStart = []
  msFreeCount = []
  msFreeChain = []
  msFreeTys = []
  msFreeAtoms = []
  msFreeAtomIds = []
  msFreeKinds = []
  msFreeValKind = []
  msFreeByTy = []
  memoGenAdvance(msGen)
  0
}

// Record the arena member types of the union row just pushed onto `unNames`, whose
// pipe-joined member set is `set` (the D-UNION foundation, see `unMemTys` in
// `emit_state`). Pads with an empty slice so a skipped mint self-heals to uncovered,
// order-preserving by construction — one index per `splitUnionAtoms` atom in atom order, since the box-tag ABI depends on it. The one place a member set is ever split.
export function recordUnMemTys(set: string) {
  // The member columns are reset in `collectU` and at the top of `emitProgram`, both
  // of which clear `unMemTys` — the reference columns are cleared HERE when that is
  // observed, so they can never answer with a slice of the previous program's rows
  // (an over-long column is the signature: only this function appends, in lock-step).
  if unMemAtoms.length > unMemTys.length {
    unMemAtoms = []
    unMemAtomIds = []
    unMemKinds = []
    msPoolReset()
  }
  // The banked value-atom kinds are index-parallel to `unMemAtoms` but live in this
  // module, so the external resets that clear the member columns above cannot see
  // them; the disagreement is observed here, before this row's members append, and
  // re-empties the column.
  if unMemValKind.length != unMemAtoms.length { unMemValKind = [] }
  while unMemTyStart.length + 1 < unNames.length {
    unMemTyStart.push(-1)
    unMemTyCount.push(0)
  }
  const atoms: string[] = []
  const tys: i32[] = []
  const row = unNames.length - 1
  let rowTy = -1
  if row >= 0 && row < unTyIx.length { rowTy = unTyIx[row] }
  if rowTy < 0 {
    emitFail("emitProgram: union row has no arena type: " + set)
  } else if boxRowMembersInto(rowTy, tys, atoms) {
    // A member is its arena type, never a re-parse of its spelling, which renders a numeric
    // literal field as its base and would merge twin arms (D14540). The row's -1 is null.
    let j = 0
    while j < tys.length {
      if tys[j] < 0 { tys[j] = TY_NULL }
      j = j + 1
    }
  } else if tyHasTyVar(rowTy) {
    // A generic body's row over an unsolved type parameter: each instance mints its own row,
    // so this one has no members.
  } else {
    emitFail("emitProgram: union row has a member with no render: " + set)
  }
  unMemTyStart.push(unMemTys.length)
  unMemTyCount.push(atoms.length)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    const ty = tys[i]
    unMemTys.push(ty)
    unMemAtoms.push(a)
    unMemAtomIds.push(msAtomIdOf(a))
    unMemKinds.push(unMemKindOf(a, ty))
    unMemValKind.push(valueAtomKind(a))
    i = i + 1
  }
  0
}

// Keyed on structural identity (the rep-column rewrite, step 3): every answer is now
// the hash-consed id rather than a rendered key used only for equality, and the `""`
// (does not participate, never merged) sentinel becomes `-1`. Same partition, same
// two rungs and fall-through, unchanged.
function slotCanonId(si: i32): i32 {
  if si < 0 || si >= sNames.length { return -1 }
  // A literal's row whose recorded context still names a hole is keyed by the literal's own
  // record type, the one its fields are stored as.
  const ot = sAnonOwnTy.get(si) ?? -1
  if ot >= 0 && tyAt(ot) is TyObj { return repRowId(ot) }
  // Rung 1 — the arena-index sidecar (`sTyIx`, recorded at every row mint), consulted
  // first (destringify D-SLOTARENA): this row's type is known structurally, and it
  // covers the `#anon` literal rows the name path cannot resolve at all. Confirm-only —
  // an uncovered row or one whose type is not a `TyObj` falls through to the name ladder unchanged, so the two rungs agree wherever both can answer.
  if si < sTyIx.length {
    const dix = sTyIx[si]
    if dix >= 0 {
      const dt = tyAt(dix)
      if dt is TyObj { return repRowId(dix) }
    }
  }
  // Rung 2 — the name ladder, for a row the sidecar does not cover: a mint site that
  // skips `recordSTyIx`, or a name unresolved when the row interned. Still live: it
  // returns a non-"" key on the corpus, so the fall-through is not decoration. Two of
  // its properties stay invisible to the corpus, stated rather than banked as a zero.
  const nm = sNames[si]
  let di = cUserTypes[nm] ?? -1
  if di < 0 {
    // The inline-shape fallback: only a bare `{...}` spelling (not a map `{[`)
    // resolves; the checker memoizes shape resolution, so this stays cheap.
    if nameIsShapeSpanEnds(nm) { di = resolveAnnot(nm, repNoTyparams) }
  }
  if di >= 0 {
    const t = tyAt(di)
    if !(t is TyObj) { return -1 }
    return repRowId(di)
  }
  // Neither rung: a synthetic `#anon` row the D0 recorder could not type, or an
  // unresolvable spelling. -1 is the legacy never-merged behaviour ("" before step 3).
  -1
}

// The arena type index to record for an anonymous object-literal shape row (phase
// D0): the literal node's context-resolved rep type (`nodeRepTyIxOf`), or -1 when
// the node is uncovered / not a `TyObj`. Exported so the `emit_collect` intern site
// records it without pulling the arena vocabulary across the module boundary.
export function anonRowTyIx(objIx: i32): i32 {
  const rix = nodeRepTyIxOf(objIx)
  if rix < 0 { return -1 }
  const t = tyAt(rix)
  if !(t is TyObj) { return -1 }
  rix
}

// The literal's own record type where `anonRowTyIx` records a context that still names a hole
// (a literal handed to an un-annotated parameter), or -1. Read only to tell the code-0 kinds of
// the row's fields apart, never as the row's identity (D2762).
export function anonRowOwnTyIx(objIx: i32): i32 {
  const rix = nodeRepTyIxOf(objIx)
  if rix >= 0 && !tyHasTyVar(rix) { return -1 }
  const own = nodeTyIxOf(objIx)
  if own < 0 || tyHasTyVar(own) { return -1 }
  if !(tyAt(own) is TyObj) { return -1 }
  own
}

// The canonical structural identity of an arbitrary type-name spelling, resolved
// through the checker's annotation grammar into the one `repCanonId` vocabulary —
// the name-input twin of `slotCanonId`, for slot layers whose intern keys are not
// struct-table indices. -1 when the spelling does not resolve; every caller already passed annotation checking, so a miss is the safe degenerate, not an error.
export function repNameCanonId(nm: string): i32 {
  if nm == "" { return -1 }
  // Runaway cap: a spelling this long is never a legit dedup key, and feeding it to
  // `resolveAnnot` mints fresh arena types per probe — a multiplicative cascade
  // (epoch bump, cache rebuild, longer renders, longer spellings) that can grow into a
  // multi-gigabyte string allocation and crash the compiler. -1 is the documented safe degenerate: the slot never participates in dedup, and the resolver falls through loudly.
  if nm.length > 4096 { return -1 }
  const di = declTyIxOfName(nm)
  if di < 0 { return -1 }
  repCanonId(di)
}

// The struct-table row whose sNames key is `nm`, or -1 — a local scan (the
// `structIndexByName` twin; that resolver lives in emit_classify, ABOVE this
// module, so the layout guard here reads the flat `emit_state` arrays directly).
function repStructRowByName(nm: string): i32 {
  let i = 0
  while i < sNames.length {
    if sNames[i] == nm { return i }
    i = i + 1
  }
  -1
}

// The struct-table row whose D0 `sTyIx` sidecar entry is the ARENA type `ty`, or -1 —
// `repStructRowByName`'s STRUCTURAL twin (`structIndexOfTy`'s question, local for the same
// layering reason, same first-match-wins order). A row the D0 sidecar does not cover holds
// -1 there and never matches a real type, so the caller falls through to its name path.
function repStructRowByTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  let i = 0
  while i < sTyIx.length {
    if sTyIx[i] == ty { return i }
    i = i + 1
  }
  -1
}

// The arena type of struct `si`'s field `fi`'s element or target, from the `sFieldElemTyIx`
// sidecar — `sFieldElemNameAt`'s structural twin. -1 when the sidecar does not cover the row,
// which every consumer treats as "keep the name path".
export function sFieldElemTyIxAt(si: i32, fi: i32): i32 {
  const ix = sFieldStart[si] + fi
  if ix >= sFieldElemTyIx.length { return -1 }
  sFieldElemTyIx[ix]
}

// In-progress (elemA, elemB) pairs of the code-15 referenced-layer descent below —
// layout equality over RECURSIVE shapes (`type L1 = {n: L1 | null}` vs a structural
// twin) is COINDUCTIVE: a revisited pair is assumed equal (the canonical keys
// already matched at every level above; only a genuine storage divergence refutes).
const sfceStkA: i32[] = []
const sfceStkB: i32[] = []

// The field codes whose emitted storage is a `(ref [null] <heap>)` the code alone
// does not name — the heap comes from the field's recorded element spelling, so two
// rows may agree on every top-level code yet store different heap types (15 a
// nested/nullable struct, 5 a struct/union/closure ref list, 28 `S[] | null`). D64: gating only code 15 let two such rows merge onto one heap type while their element heaps stayed apart — check-clean invalid wasm.
function fieldCodeRefsElemHeap(code: i32): boolean {
  code == FC_STRUCT || code == FC_REF_LIST || code == FC_NUL_REF_LIST
}

// The row an element type no row records resolves to by its shape (`repRowOfTyStruct`), or
// -1. An instance re-spells a declared element structurally, so the declared row is its
// heap; a re-entry for the same type declines, since a recursive shape asks itself again.
const reShapeStk: i32[] = []
function repElemRowByShape(ty: i32): i32 {
  if ty < 0 { return -1 }
  let k = 0
  while k < reShapeStk.length {
    if reShapeStk[k] == ty { return -1 }
    k = k + 1
  }
  reShapeStk.push(ty)
  const r = repRowOfTyStruct(ty, repScanLim())
  reShapeStk.pop()
  r
}

// How many list layers wrap arena type `ty`: 0 for a non-list or a hole.
function repListDepth(ty: i32): i32 {
  let d = 0
  let t = ty
  while t >= 0 {
    const n = tyAt(t)
    if !(n is TyArray) { return d }
    d = d + 1
    t = n.aElem
  }
  d
}

// The type under every list layer of `ty`, or `ty` itself when it is no list.
function repListLeafTy(ty: i32): i32 {
  let t = ty
  while t >= 0 {
    const n = tyAt(t)
    if !(n is TyArray) { return t }
    t = n.aElem
  }
  t
}

// The struct row of a list's leaf element type, by its recorded type then its shape, or -1.
function repLeafRow(ty: i32): i32 {
  const r = repStructRowByTy(ty)
  if r >= 0 { return r }
  repElemRowByShape(ty)
}

// True when struct slots `a` and `b` have an identical emitter field-code list, with
// the referenced-layer guard on every field code whose storage heap is named rather
// than pinned by the code (`fieldCodeRefsElemHeap`). A layout guard on top of the
// structural key: a key collision whose emitted layout differs (e.g. an atom-backed litunion field vs an inline one) must not merge even though `repCanonKey` agrees.
function structFieldCodesEq(a: i32, b: i32): i32 {
  if sFieldCount[a] != sFieldCount[b] { return 0 }
  let i = 0
  while i < sFieldCount[a] {
    if sFieldTypes[sFieldStart[a] + i] != sFieldTypes[sFieldStart[b] + i] {
      return 0
    }
    if fieldCodeRefsElemHeap(sFieldTypes[sFieldStart[a] + i]) {
      // A named-heap field stores a `(ref [null] <elem heap>)` — the code alone does not
      // pin the layout, so the referenced rows must share one heap type too. Same key and
      // same top-level codes is not enough: an `#anon` row's adopted type can disagree with
      // its self-classified fields, merging a mismatched field ref into invalid wasm. Byte-equal elem names share a row trivially; distinct names must resolve and be twins, or decline.
      const ea = sFieldElemName[sFieldStart[a] + i]
      const eb = sFieldElemName[sFieldStart[b] + i]
      if ea != eb {
        // Destringify: the referenced row comes off the arena (the D5 sidecar's recorded
        // element type through the D0 `sTyIx` scan), the recorded name only for a row the
        // sidecars do not cover — reached in exactly the same cases as the name-based
        // fall-through it replaces. The `ea != eb` trigger stays a name compare; arena-index equality here would newly merge rows the struct table cannot name.
        const ta = sFieldElemTyIxAt(a, i)
        const tb = sFieldElemTyIxAt(b, i)
        const da = repListDepth(ta)
        if da != repListDepth(tb) { return 0 }
        let ra = -1
        let rb = -1
        if da > 0 {
          // A list-of-lists element: the inner lists share a heap when their leaf rows do.
          ra = repLeafRow(repListLeafTy(ta))
          rb = repLeafRow(repListLeafTy(tb))
        } else {
          ra = repStructRowByTy(ta)
          if ra < 0 { ra = repStructRowByName(ea) }
          if ra < 0 { ra = repElemRowByShape(ta) }
          rb = repStructRowByTy(tb)
          if rb < 0 { rb = repStructRowByName(eb) }
          if rb < 0 { rb = repElemRowByShape(tb) }
        }
        if sfceElemRowsTwin(ra, rb) == 0 { return 0 }
      }
    }
    i = i + 1
  }
  1
}

// Whether element rows `ra` and `rb` share one heap type for `structFieldCodesEq`: both
// resolved, and equal or twins, a pair already being compared counting as twins.
function sfceElemRowsTwin(ra: i32, rb: i32): i32 {
  if ra < 0 || rb < 0 { return 0 }
  if ra == rb { return 1 }
  let k = 0
  while k < sfceStkA.length {
    if sfceStkA[k] == ra && sfceStkB[k] == rb { return 1 }
    k = k + 1
  }
  sfceStkA.push(ra)
  sfceStkB.push(rb)
  const tw = repStructSlotsTwin(ra, rb)
  sfceStkA.pop()
  sfceStkB.pop()
  tw
}

// True when struct slots `a` and `b` share one WasmGC heap type under the canonical
// structural key plus the field-code layout guard — the `sTwin` equivalence,
// queryable pairwise without `buildStructTwins` having run. The ref-list layer's
// struct-twin slot rung (`rlSlotOfTyTwin`) uses it to decide whether two spellings share a heap type.
export function repStructSlotsTwin(a: i32, b: i32): i32 {
  if a == b { return 1 }
  if a < 0 || b < 0 { return 0 }
  const ka = slotCanonId(a)
  if ka < 0 { return 0 }
  if ka != slotCanonId(b) { return 0 }
  structFieldCodesEq(a, b)
}

// The canonical (smallest `sTwin`-equivalent) representative of struct slot `si` —
// the smallest `j <= si` sharing `si`'s `slotCanonId` under the `structFieldCodesEq`
// layout guard, or `si` itself. The same equivalence `buildStructTwins` records in
// `sTwin[]`, computed on demand and timing-independently, since callers need it before `mAssignTypeIndices` has built `sTwin[]`. Memoized per `tyMutEpoch`.
let repSlotRepMemo: i32[] = []
let repSlotRepEpoch = -1

function repSlotRepSync() {
  if repSlotRepEpoch != tyMutEpoch {
    repSlotRepMemo = []
    repSlotRepEpoch = tyMutEpoch
  }
  0
}

export function repStructSlotRep(si: i32): i32 {
  if si < 0 || si >= sNames.length { return si }
  repSlotRepSync()
  if si < repSlotRepMemo.length {
    if repSlotRepMemo[si] >= 0 { return repSlotRepMemo[si] }
  }
  const key = slotCanonId(si)
  let rep = si
  if key >= 0 {
    let j = 0
    while j < si {
      if slotCanonId(j) == key && structFieldCodesEq(j, si) == 1 {
        rep = j
        j = si // stop at the first (smallest) twin
      }
      j = j + 1
    }
  }
  while repSlotRepMemo.length <= si { repSlotRepMemo.push(-1) }
  repSlotRepMemo[si] = rep
  rep
}

// Whether struct row `si` may hold type `ty`: an `#anon` row holds only its own type's canonical
// id, so two literals apart in a closure field's signature mint two rows. A generic body's row,
// whose type still names a parameter, serves each instance; a tagged set's own parameters do not
// make a row generic.
function anonRowServes(si: i32, ty: i32): boolean {
  const nm = sNames[si]
  if nm.length < 5 || nm.slice(0, 5) != "#anon" { return true }
  let own = sAnonOwnTy.get(si) ?? -1
  if own < 0 && si < sTyIx.length { own = sTyIx[si] }
  if own < 0 || own >= T.tys.length { return true }
  if tyHasTyVar(own) && !fnTagHoldsTy(own, 4) { return true }
  repCanonId(own) == repCanonId(ty)
}

// Rep-twin phase 2 — the structural row resolver for `structIndexOfObjCtx`'s
// ambiguity arm (matches >= 2): given the checker's recorded arena type for an
// `ObjLit`, the unique struct row whose canonical key and field-code layout both
// match, or -1 for an uncovered type, an empty key, no match, or a genuine collision — the caller falls back to its name path rather than guess.
export function repRowOfTyStruct(repTyIx: i32, lim: i32): i32 {
  if repTyIx < 0 { return -1 }
  const t = tyAt(repTyIx)
  if !(t is TyObj) { return -1 }
  const key = repRowId(repTyIx)
  if key < 0 { return -1 }
  scnSync()
  let bound = lim
  if bound > sNames.length { bound = sNames.length }
  let best = -1
  // The indexed rows below `scnLen`, ascending: this key's bucket merged with the rows the
  // name rung answers, which are asked again since their answer is not stamped.
  const b = scnRows[key] ?? scnNoRows
  let bi = 0
  let li = 0
  while true {
    let si = bound
    let fromB = false
    if bi < b.length && b[bi] < si {
      si = b[bi]
      fromB = true
    }
    if li < scnLive.length && scnLive[li] < si {
      si = scnLive[li]
      fromB = false
    }
    if si >= bound { break }
    if fromB { bi = bi + 1 } else { li = li + 1 }
    if (fromB || slotCanonId(si) == key) && anonRowServes(si, repTyIx) {
      if best < 0 { best = si }
      else if structFieldCodesEq(best, si) == 0 { return -1 }
    }
  }
  // The rows past the index, in order: each recorded one joins it as it is asked.
  let si = scnLen
  while si < bound {
    let k = -1
    if si == scnLen && si < sTyIx.length {
      k = scnAdvance()
    } else {
      k = slotCanonId(si)
    }
    if k == key && anonRowServes(si, repTyIx) {
      if best < 0 {
        best = si
      } else if structFieldCodesEq(best, si) == 0 {
        // Canon-key twins with divergent emitted layouts (#974): the type alone cannot pick.
        return -1
      }
    }
    si = si + 1
  }
  best
}

// The struct-row canon index (D3738): per canonical id, the rows below `scnLen` whose own arena
// type (`sTyIx`) has it, ascending, and in `scnLive` the rows the name rung answers. Rows join in
// scan order as `repRowOfTyStruct` reaches them, so each id is first computed where a full scan
// computes it. Keyed on `tyMutEpoch` (`scnGenKey`).
let scnRows: {[i32]: i32[]} = Map()
let scnLive: i32[] = []
let scnLen = 0
const scnGenKey = memoKeyNew(1)
const scnNoRows: i32[] = []

export function structCanonIxReset() {
  scnRows = Map()
  scnLive = []
  scnLen = 0
  memoKeyClear(scnGenKey)
  0
}

function scnSync() {
  if (
    memoMoved(scnGenKey, 0, tyMutEpoch)
    || scnLen > sNames.length
    || scnLen > sTyIx.length
  ) {
    structCanonIxReset()
    memoMoved(scnGenKey, 0, tyMutEpoch)
  }
  0
}

// Index row `scnLen`, whose arena type is recorded, and return its canonical id.
function scnAdvance(): i32 {
  const si = scnLen
  let own = false
  const dix = sTyIx[si]
  if dix >= 0 {
    const dt = tyAt(dix)
    if dt is TyObj { own = true }
  }
  const k = slotCanonId(si)
  if !own {
    scnLive.push(si)
  } else if k >= 0 {
    const b = scnRows[k] ?? []
    if b.length == 0 { scnRows[k] = b }
    b.push(si)
  }
  scnLen = scnLen + 1
  k
}

// Normalize a checker render (`tyToStr`) into the canonical spelling the annotation
// grammar (`resolveAnnot`) parses — scoped to `repRowOfName` below, never a global
// `nameToTy` change. Two fidelity gaps: spaces (`nameStripSpaces`, W7) and the `?`
// nullable suffix, rewritten here to `|null`. The two commute, so splitting them is exact rather than similar.
function renderFaithful(nm: string): string {
  const ns = nameStripSpaces(nm)
  let out = ""
  let i = 0
  while i < ns.length {
    const c = ns[i]
    if c == '?' { out = out + "|null" } else { out = out + fromCodePoint(c) }
    i = i + 1
  }
  out
}

// The struct-table row a checker render `nm` names, after `renderFaithful`
// normalization, resolved through the one `repRowOfTyStruct` vocabulary. Tri-state:
// -2 unresolved through the annotation grammar, -1 a non-`TyObj` or a shape in no
// row, >= 0 the unique matching row. No caller consults the -1/-2 distinction, so an arena-index replacement need not reproduce it.
export function repRowOfName(nm: string, lim: i32): i32 {
  if nm == "" { return -2 }
  // The `repNameCanonId` runaway cap (a render this long is never a legit key and
  // MINTS fresh arena types per probe — the >1GB crash family): decline it.
  if nm.length > 4096 { return -2 }
  const di = declTyIxOfName(renderFaithful(nm))
  if di < 0 { return -2 }
  const t = tyAt(di)
  if !(t is TyObj) { return -1 }
  repRowOfTyStruct(di, lim)
}

// The arena-input twin of the deleted `monoIsRowMatch` (destringify D-MONOISTY): does
// a monomorphized instance's bound argument row (`sk`, a nominal `#anon0` row) satisfy
// an `is` test whose type the checker already banked (`isVarTyIxOf`)? 1 yes, 0 no, -1
// neither side names a row. `lim` is the caller's scan bound, passed to keep `repRowOfTyStruct`'s contract.
export function repIsRowMatchTy(sk: string, wantTy: i32, lim: i32): i32 {
  const skSi = repStructRowByName(sk)
  if skSi < 0 { return -1 }
  const wSi = repRowOfTyStruct(wantTy, lim)
  if wSi < 0 { return -1 }
  if wSi == skSi { return 1 }
  // Layout twins are ONE heap type, so they satisfy each other.
  if repStructSlotsTwin(skSi, wSi) != 0 { return 1 }
  0
}

// The struct-table scan bound this module's own resolvers pass to
// `repRowOfTyStruct` — the local twin of `emit_classify.sScanLim` (private there),
// kept here since `emit_classify` sits above this module. During `collectS`'s
// field-coding loop the in-flight declaration has `sNames`/`sFieldStart` pushed but not yet `sFieldCount`, and a matcher reading past that point reads out of bounds.
export function repScanLim(): i32 {
  let n = sNames.length
  if sFieldCount.length < n { n = sFieldCount.length }
  if sFieldStart.length < n { n = sFieldStart.length }
  n
}

// Populate `sTwin` (parallel to `sNames`): `sTwin[i]` is the representative struct
// slot for slot `i`'s WasmGC heap type — the smallest earlier slot with the same
// canonical key and field-code layout, or `i` itself when first of its structure.
// Keys are computed once up front, then matched pairwise; called from `mAssignTypeIndices` before `sHeapIdx` allocation.
export function buildStructTwins() {
  const keys: i32[] = []
  let i = 0
  while i < sNames.length {
    keys.push(slotCanonId(i))
    i = i + 1
  }
  sTwin = []
  i = 0
  while i < sNames.length {
    let rep = i
    if keys[i] >= 0 {
      let j = 0
      while j < i {
        if keys[j] == keys[i] && structFieldCodesEq(j, i) == 1 {
          rep = j
          j = i // stop at the first (smallest) twin
        }
        j = j + 1
      }
    }
    sTwin.push(rep)
    i = i + 1
  }
}

// The descriptor, tree-primary over the flat arms (Stage B wave 1): the recursive
// Rep tree is authoritative wherever the flat arms claim coverage, so the returned
// kind/null discipline/list-element vocabulary are the tree's projections. The flat
// derivation still decides coverage (a shape it cannot name keeps rejecting) and the nominal slot (the tree's hash-cons may surface a twin at a different index).
export function repOfTy(ty: i32): RepDesc {
  const d = repOfTyFlat(ty)
  if d.rdCovered == 0 { return d }
  const tix = repTreeOfTy(ty)
  const tk = repTreeVKind(tix)
  if tk == null { return d }
  const td = repMk(tk, repTreeNulOf(tix), repTreeListElemName(tix))
  td.rdSlot = d.rdSlot
  td.rdAtom = d.rdAtom
  td
}

// The box tag of a value of type `ty` inside a union box: 0 i32, 1 boolean, 2 string, 3 i64,
// 4 f64, 5 f32, 6 null, 7 i32 list, 8 f64 list, 9 string list, 10 i64 list, 11 closure, 12 f32
// list, 13 byte list, 14 v128, 17 boolean list, 18 `null[]`; -1 when no single atom. It differs
// from `repOfTy` for a literal union, which is an i32 value but a string ref inside a box.
export function boxTagOfTy(ty: i32): i32 {
  const k = btOfTy(ty)
  if k != -2 { return k }
  valueAtomKind(tyToEmitName(ty))
}

// `boxTagOfTy`'s decision, or -2 where only the render decides: a union whose members share
// a list or closure tag that several spellings carry (D4320).
function btOfTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  for s in btSeen {
    // A revisited ancestor is a recursive alias, never one atom.
    if s == ty { return -1 }
  }
  btSeen.push(ty)
  const r = btGo(ty)
  btSeen.pop()
  r
}

// The ancestor stack of `btOfTy`.
const btSeen: i32[] = []

function btGo(ty: i32): i32 {
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less: every arena shape says which tag it boxes under.
  match t {
    TyPrim => {
      return btOfPrim(t.primName)
    }
    TyFunc => {
      return 11
    }
    TyLit => {
      // A string literal rides the box as its string; a numeric or boolean one as its base.
      return btOfTy(litBaseTy(t))
    }
    TyArray => {
      return btOfList(ty, t.aElem)
    }
    TyUnion => {
      // A numeric literal union boxes as its base scalar, a string one as its member string.
      const nb = numLitUnionBaseTy(ty)
      if nb >= 0 { return btOfTy(nb) }
      if tyIsLitUnion(ty) { return 2 }
      const p = tyEmitPrimOf(ty)
      if p != null { return btOfPrim(p) }
      return btOfUnion(t.uMembers)
    }
    TyObj | TyMap | TyNullable | TyVar | TyNeg | TyErr => {
      // A shape, a map and a `T | null` are never one atom; the rest have no value.
      return -1
    }
  }
}

// The tag of a primitive, -1 for one with no value or no box arm of its own.
function btOfPrim(p: PrimName | null): i32 {
  if p == null { return -1 }
  match p {
    "i32" => {
      return 0
    }
    "boolean" => {
      return 1
    }
    "string" => {
      return 2
    }
    "i64" => {
      return 3
    }
    "f64" => {
      return 4
    }
    "f32" => {
      return 5
    }
    "null" => {
      return 6
    }
    "v128" => {
      return 14
    }
    "void" | "never" | "u8" => {
      return -1
    }
  }
}

// The tag of the list `p[]`, -1 for an element with no list arm of its own.
function btOfPrimList(p: PrimName | null): i32 {
  if p == null { return -1 }
  match p {
    "i32" => {
      return 7
    }
    "boolean" => {
      return 17
    }
    "f64" => {
      return 8
    }
    "string" => {
      return 9
    }
    "i64" => {
      return 10
    }
    "f32" => {
      return 12
    }
    "u8" => {
      return 13
    }
    "null" => {
      return 18
    }
    "void" | "never" | "v128" => {
      return -1
    }
  }
}

// The tag of list `arr` with element `e`: its element backing's list, so a literal-union or
// nullable-boolean element rides the i32 list and a nullable string the string list.
function btOfList(arr: i32, e: i32): i32 {
  if e >= 0 {
    if tyIsI32LeafElem(e) {
      if primNameOf(e) == "boolean" { return 17 }
      if primNameOf(e) == "null" { return 18 }
      const et = tyAt(e)
      if et is TyNullable && primNameOf(et.nInner) == "boolean" { return 18 }
      return 7
    }
    const ep = primNameOf(e)
    if ep == "f64" || ep == "i64" || ep == "f32" || ep == "u8" || ep == "null" {
      return btOfPrimList(ep)
    }
    if tyIsStrLeafElem(e) { return 9 }
  }
  const k = valueRowKind(arr)
  if k != -2 { return k }
  const p = tyEmitElemPrimOf(arr)
  if p != null { return btOfPrimList(p) }
  if tyEmitElemNulPrimOf(arr, "boolean") != 0 { return 18 }
  if tyEmitElemNulPrimOf(arr, "string") != 0 { return 9 }
  const el = tyStepElem(arr)
  if el < 0 { return -1 }
  // A quoted literal run with a null, or its alias with one, is the atom list.
  if litUnionInlineNameOfTy(el) != "" { return 7 }
  const lt = tyAt(el)
  // Exhaustive over `Ty` and `_`-less: every element shape says whether it is an atom list.
  match lt {
    TyNullable => {
      const inr = lt.nInner
      if inr < 0 { return -1 }
      if litUnionAliasNameOfTy(inr) != "" || litUnionInlineNameOfTy(inr) != "" {
        return 7
      }
      const it = tyAt(inr)
      if it is TyUnion || it is TyNullable { return -2 }
      // Any other inner beside the null is not one of the three nullable-element lists.
      return -1
    }
    TyUnion => {
      return -2
    }
    TyPrim | TyLit | TyObj | TyArray | TyMap | TyFunc | TyVar | TyNeg | TyErr => {
      // A shape, list, map or function element, or an element with no value.
      return -1
    }
  }
}

// The tag of a union no primitive spells: its members' one shared tag, else -1.
function btOfUnion(ms: i32[]): i32 {
  if ms.length == 0 { return -1 }
  // Two string literals beside a non-null member spell their registered alias, an extra part.
  const texts: string[] = []
  let nonLit = false
  for m in ms {
    const mt = tyAt(m)
    if mt is TyLit {
      if mt.litKind == "str" { texts.push(mt.litText) }
    } else if !isNullTy(m) {
      nonLit = true
    }
  }
  if nonLit && texts.length >= 2 && litUnionAliasOfLitTexts(texts) != "" {
    return -1
  }
  let kind = -3
  for m in ms {
    let mk = -1
    const mt = tyAt(m)
    if litUnionAliasNameOfTy(m) != "" {
      mk = -1
    } else if mt is TyFunc {
      // A function member is grouped, so its spelling never ends in `[]`.
      if tyEmitNamesOf(m) { mk = 11 }
    } else if mt is TyUnion {
      return -2
    } else {
      mk = btOfTy(m)
      if mk == -2 { return -2 }
    }
    if mk == -1 { return -1 }
    if kind == -3 { kind = mk }
    else if kind != mk { return -1 }
  }
  // One spelling per tag, except the atom list, the string list, the nullable boolean list
  // and the closure, each of which several spellings share (D4320).
  if ms.length > 1 && (kind == 7 || kind == 9 || kind == 11 || kind == 18) {
    return -2
  }
  kind
}

// The value kind arena type `ty` crosses a `$fnsig` as: `repOfTy`'s where it covers `ty`, else
// the rep tree's. null when the rep layer has no rep for `ty`.
export function repSigKindOfTy(ty: i32): VKind | null {
  if ty < 0 || ty >= T.tys.length { return null }
  const d = repOfTy(ty)
  if d.rdCovered != 0 { return d.rdKind }
  repTreeVKind(repTreeOfTy(ty))
}

// The flat derivation: one table-driven arm per `Ty` variant. Invariant: every
// covered arm must decide the rep exactly as the emitter's annotation-name
// classifier ladder (`vtKindOfType`'s arm order) does for the same type — the
// migration gates (fixpoint + corpus byte-compare) hold each arm to that.
function repOfTyFlat(ty: i32): RepDesc {
  if ty < 0 { return repUncovered() }
  const t = tyAt(ty)
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th arena variant breaks
  // the self-compile here rather than silently answering `repUncovered()`, which
  // reads as "this shape's rep is not derivable" and hands the consumer back to
  // its legacy name ladder — a valid-looking answer for the wrong reason.
  match t {
    TyPrim => {
      return repOfPrim(t.primName)
    }
    TyFunc => {
      // A function type is the closure fat-pointer, or the i32 id of its member when its set
      // is tagged (`fnTagDecide`).
      if fnTagTyIsTagged(ty) { return repOfPrim("i32") }
      return repMk("closure", 0, "")
    }
    TyObj => {
      // A union-VARIANT member is the concrete variant struct ref (its slot is a
      // variant index, not a struct-table index); any other object shape is a
      // standalone struct ref.
      if repTyIsVariant(ty) { return repMk("variant", 0, "") }
      const d = repMk("struct", 0, "")
      d.rdSlot = repSlotOfTy(ty)
      return d
    }
    TyUnion => {
      // A string literal union reps as the interned i32 atom, whatever its spelling.
      if tyIsLitUnion(ty) { return repAtomMk(0) }
      // The expanded nullable-litunion `"a" | "b" | null` is the same type as the two-part
      // `K | null` spelling, so it must get the same rep (the i32 atom + `-1` sentinel
      // niche, `rdNul` 3) — without this arm it repped as the union box while every read
      // classified it from the arena as the atom, printing invalid wasm. No alias gate here: canon preserves a nullable litunion's members, so both spellings rep as the atom.
      if tyIsNullableLitUnion(ty) { return repAtomMk(3) }
      // A single-member object union is the canonicalized `{a} & {b}` struct
      // alias — reps as the struct itself.
      if t.uMembers.length == 1 {
        const m = tyAt(t.uMembers[0])
        if m is TyObj { return repMk("struct", 0, "") }
        // Any other one-member union (a recursive alias's `rest | null`) is its member.
        return repOfTyFlat(t.uMembers[0])
      }
      // Lists that all spell one list are that list: the first member a rep covers decides.
      if oneListUnionRender(ty) != "" {
        for m in t.uMembers {
          const md = repOfTyFlat(m)
          if md.rdCovered == 1 { return md }
        }
        return repUncovered()
      }
      // A numeric literal union (`0 | 1`) is stored as its base scalar.
      const nb = numLitUnionBaseTy(ty)
      if nb >= 0 { return repOfTyFlat(nb) }
      if unionHasOpenMember(t.uMembers) { return repUncovered() }
      // A `{tag, value}` value/struct union box.
      if tyIsValueUnionBox(ty) { return repMk("union", 0, "") }
      return repUncovered()
    }
    TyNullable => {
      return repOfNullable(t.nInner)
    }
    TyArray => {
      return repOfArray(t.aElem)
    }
    TyMap => {
      return repOfMap(t.mVal, t.mSet)
    }
    TyVar => {
      // A generic type PARAMETER — the monomorphizer instantiates it, and the
      // INSTANCE is what this query is asked about.
    }
    TyLit => {
      // A bare literal type is stored as its base scalar: `"x"` is a string ref, `3` an i32.
      return repOfTyFlat(litBaseTy(t))
    }
    TyErr => {
      // The error/unknown hole — a rejected program never reaches emit.
    }
    TyNeg => {
      // A negation — `intersectTy` consumes it during checking; nothing
      // structural survives to carry a rep.
    }
  }
  // The four empty arms above land here: no wasm rep of their own, so the
  // consumer keeps its legacy name-based path (`rdCovered == 0`).
  repUncovered()
}

function repOfPrim(pn: PrimName): RepDesc {
  // boolean shares the i32 rep; `void` follows the ladder's fallthrough ("i32")
  // — the void-ness of a RESULT is a separate axis (`fRetVoid`), not a valtype.
  if pn == "i32" || pn == "boolean" { return repMk("i32", 0, "") }
  if pn == "i64" { return repMk("i64", 0, "") }
  if pn == "f64" { return repMk("f64", 0, "") }
  if pn == "f32" { return repMk("f32", 0, "") }
  if pn == "string" { return repMk("str", 0, "") }
  if pn == "v128" { return repMk("v128", 0, "") }
  if pn == "void" { return repMk("i32", 0, "") }
  // The `null` type itself is a nullref, slot-free (D4550).
  if pn == "null" { return repMk("nulnone", 1, "") }
  // Any future prim has no standalone rep.
  repUncovered()
}

// A nullable's rep is decided by its INNER variant — four distinct null
// disciplines exist (see `rdNul`), one per inner rep family. Exhaustive over
// `Ty` and `_`-less, so a new arena variant must say which discipline it takes.
function repOfNullable(inner: i32): RepDesc {
  // No inner type is known (`const x = null`), so only `null` reaches it: the `null` type's cell.
  if inner < 0 { return repMk("nulnone", 1, "") }
  const it = tyAt(inner)
  match it {
    TyPrim => {
      return repOfNullablePrim(it.primName)
    }
    TyLit => {
      // `"x" | null` — one string literal is its one-member set beside `null`, the atom
      // niche, as `mkNullableTy` stores it (D7446).
      if it.litKind == "str" { return repAtomMk(3) }
    }
    TyFunc => {
      // `((…) => …) | null` — the nullable of the function's own rep: the closure fat-pointer
      // made nullable, or a tagged set's i32 id boxed as any nullable i32 is.
      const fr = repOfTyFlat(inner)
      if fr.rdKind == "i32" { return repOfNullablePrim("i32") }
      return repMk("nulclosure", 1, "")
    }
    TyObj => {
      return repMk(repNulObjKind(inner), 1, "")
    }
    TyUnion => {
      // `K | null` over a litunion — the i32 atom with the -1 null sentinel.
      if tyIsLitUnion(inner) { return repAtomMk(3) }
      // A one-member union is its member made nullable; a self-referential alias with a `null`
      // arm (`Json`) interns as `TyUnion[TyNullable(rest)]`, which already holds the `null`.
      if it.uMembers.length == 1 { return repOfNullable(it.uMembers[0]) }
      // `(A | B) | null` — the box already has a null member atom.
      if tyIsValueUnionBox(inner) { return repMk("union", 4, "") }
      // A numeric literal union made nullable is its base scalar made nullable.
      const nb = numLitUnionBaseTy(inner)
      if nb >= 0 { return repOfNullable(nb) }
      // Lists that all spell one list: that list's nullable, as the first covered member reps it.
      if oneListUnionRender(inner) != "" {
        for m in it.uMembers {
          const md = repOfNullableArray(tyStepElem(m))
          if md.rdCovered == 1 { return md }
        }
      }
    }
    TyArray => {
      return repOfNullableArray(it.aElem)
    }
    TyMap => {
      // `M | null` — the `(ref null $mapStruct)` niche.
      if repOfMap(it.mVal, it.mSet).rdCovered == 1 {
        return repMk("nulmap", 1, "")
      }
    }
    TyNullable => {
      // A doubled nullable is the single one.
      return repOfNullable(it.nInner)
    }
    TyVar => {
      // An inference hole nothing filled holds only `null`, so it is the `null` type's cell.
      if it.tvName.length > 0 && it.tvName[0] == '?' {
        return repMk("nulnone", 1, "")
      }
      // A generic parameter made nullable — the instance is what is asked about.
    }
    TyErr => {
      // The error hole — a rejected program never reaches emit.
    }
    TyNeg => {
      // A negation — consumed during checking.
    }
  }
  repUncovered()
}

// The niche of `S | null` for object type `S`: `nulvariant`, the `(ref null $uVarHeap[vi])`
// niche, when `S` is a union arm the variant table registered and no declared struct row
// claims it (`std:fs`'s `IoError` has both); else `nulstruct`. A twin of a variant row's shape
// is that row (D3870); a shape only the checker's member set holds has no row and stays a struct.
function repNulObjKind(objTy: i32): VKind {
  if (
    tyIxIsVariantMember(objTy)
    && repSlotOfTyDecl(objTy) < 0
    && armRowOfRecordTyShim(objTy) >= 0
  ) {
    return "nulvariant"
  }
  const r = repVariantShapeRowOf(objTy)
  if r >= 0 { return "nulvariant" }
  "nulstruct"
}

// Whether record type `ty` is a union arm: the checker registered a member of its shape, or a
// variant row has its shape. Records are structural (D3870), so an instance, inferred or
// twin spelling of an arm is that arm. A `new` record, and a declared struct with its own row,
// match by index alone. Every variant-or-struct reader in the rep layer asks this.
export function repTyIsVariant(ty: i32): boolean {
  if tyIxIsVariantMember(ty) { return true }
  repVariantShapeHas(ty, 3)
}

// Whether record type `ty` has the shape of an arm the variant table holds, and no declared
// struct row of its own: its rep is a variant heap row. The rep question a reader with no union
// in hand asks, where `repTyIsVariant` also counts the checker's member set.
export function repTyHasArmShape(ty: i32): boolean { repVariantShapeHas(ty, 2) }

// Whether a canonical shape equal to `ty`'s is registered: bit 1 by the checker's member set,
// bit 2 by the emit variant table; `bits` selects which sources count.
function repVariantShapeHas(ty: i32, bits: i32): boolean {
  if !rvsShapeMatches(ty) { return false }
  rvsSync()
  const c = repCanonId(ty)
  const b = rvsBits[c]
  b != null && (b & bits) != 0 && repSlotOfTyDecl(ty) < 0
}

// The first variant row whose arm has `ty`'s canonical shape, or -1: the row behind
// `repTyIsVariant`'s shape answer, so a slot reader finds the row that chose the kind.
export function repVariantShapeRowOf(ty: i32): i32 {
  if !rvsShapeMatches(ty) { return -1 }
  rvsSync()
  const r = rvsRow[repCanonId(ty)] ?? (-1)
  if r < 0 || repSlotOfTyDecl(ty) >= 0 { return -1 }
  r
}

// The first variant row whose arm type is the bare record `ty`, or -1: the shim every reader
// that holds a type rather than a union row position asks, and the deletion target (D14552).
// A query-side hazard: `nodeTyIxOf(paramTypeNode(...))` for a union-annotated param hands
// back the first arm, not the union.
export function armRowOfRecordTyShim(ty: i32): i32 {
  if ty < 0 { return -1 }
  // No structural rung: two variants with the same field set are different variants, and a
  // `tySame` fallback here would match the first of them for both. Variants are nominal,
  // like unions and unlike structs, since their whole purpose is to be told apart. The index
  // rung is the whole function: `declTyIxOfName` resolves each arm's declaration.
  vrIxSync()
  vrIxFirst[ty] ?? (-1)
}

// `armRowOfRecordTyShim`'s index: arm type to the first `uVarTyIx` row carrying it, over rows below
// `vrIxUpTo`. Rows are only appended between resets, so it extends in place; a reset of the
// table or a new pass rebuilds it (D11320).
let vrIxFirst: {[i32]: i32} = Map()

let vrIxUpTo = 0

const vrIxKey = memoKeyNew(2)

function vrIxSync() {
  let moved = memoMoved(vrIxKey, 0, uVarTyIxResets)
  moved = memoPassMoved(vrIxKey, 1) || moved
  if moved || uVarTyIx.length < vrIxUpTo {
    vrIxFirst = Map()
    vrIxUpTo = 0
  }
  while vrIxUpTo < uVarTyIx.length {
    const t = uVarTyIx[vrIxUpTo]
    if !vrIxFirst.has(t) { vrIxFirst[t] = vrIxUpTo }
    vrIxUpTo = vrIxUpTo + 1
  }
  0
}

// Whether record type `ty` may be an arm by shape: a record that is not a `new` brand. A declared
// struct with a row of its own is excluded by each caller, after a shape hit.
function rvsShapeMatches(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  tyAt(ty) is TyObj && nomNameOfTy(ty) == ""
}

// Canonical shape id → source bits of the registered variant members, extended in place as
// the checker's list and the variant table grow; rebuilt when either is reset or the arena
// generation moves.
let rvsBits: {[i32]: i32} = Map()

// Canonical shape id → the first variant row carrying it.
let rvsRow: {[i32]: i32} = Map()

let rvsChkUpTo = 0

let rvsRowUpTo = 0

const rvsKey = memoKeyNew(4)

function rvsSync() {
  let moved = memoMoved3(rvsKey, tyMutEpoch, cUserTypesVer, uVarTyIxResets)
  moved = memoPassMoved(rvsKey, 3) || moved
  if (
    moved
    || cVariantMemberTyIxs.length < rvsChkUpTo
    || uVarTyIx.length < rvsRowUpTo
  ) {
    rvsBits = Map()
    rvsRow = Map()
    rvsChkUpTo = 0
    rvsRowUpTo = 0
    repTreeDrop()
  }
  while rvsChkUpTo < cVariantMemberTyIxs.length {
    rvsAdd(cVariantMemberTyIxs[rvsChkUpTo], 1)
    rvsChkUpTo = rvsChkUpTo + 1
  }
  while rvsRowUpTo < uVarTyIx.length {
    const rc = rvsAdd(uVarTyIx[rvsRowUpTo], 2)
    if rc >= 0 && rvsRow[rc] == null { rvsRow[rc] = rvsRowUpTo }
    rvsRowUpTo = rvsRowUpTo + 1
  }
  0
}

// Sets `bit` for `ty`'s canonical shape; that shape's id, or -1 for no structural record.
function rvsAdd(ty: i32, bit: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  if !(tyAt(ty) is TyObj) || nomNameOfTy(ty) != "" { return -1 }
  const c = repCanonId(ty)
  let b = 0
  const hit = rvsBits[c]
  if hit != null { b = hit }
  if (b | bit) != b {
    rvsBits[c] = b | bit
    repTreeDrop()
  }
  c
}

// Whether type `ty` is `T | null` over a `T` whose rep is a numeric scalar, which has no spare
// value to niche into, so the nullable is the value-union `{tag, value}` box. The niche
// nullables (string, boolean, a literal union, a ref) are not.
export function tyIsNulScalarBox(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if !(t is TyNullable) || t.nInner < 0 || t.nInner >= T.tys.length {
    return false
  }
  const k = repOfTyFlat(t.nInner).rdKind
  if k != "i32" && k != "i64" && k != "f64" && k != "f32" { return false }
  repOfNullable(t.nInner).rdKind == "union"
}

// `tyIsNulScalarBox` asked of node `ix`'s type.
export function nodeTyIsNulScalarBox(ix: i32): boolean {
  tyIsNulScalarBox(nodeTyIxOf(ix))
}

// `T | null` over a primitive `T`, by name.
function repOfNullablePrim(pn: PrimName): RepDesc {
  // `string | null` — the nullable raw-array ref niche.
  if pn == "string" { return repMk("nulstr", 1, "") }
  // `boolean | null` — the i32 sentinel-2 niche, whose valtype is plain i32.
  if pn == "boolean" { return repMk("nulbool", 2, "") }
  // A nullable SCALAR has no spare value to niche into — it boxes as a value union
  // whose `null` is a member atom.
  if pn == "i32" || pn == "i64" || pn == "f64" || pn == "f32" || pn == "v128" {
    return repMk("union", 4, "")
  }
  repUncovered()
}

// `E[] | null` by element `E`. Only the shapes with a settled rep are covered; every
// other nullable list must keep failing loudly through the legacy chain.
function repOfNullableArray(elem: i32): RepDesc {
  if elem < 0 { return repUncovered() }
  const et = tyAt(elem)
  if et is TyPrim {
    // `i32[] | null` / `boolean[] | null` — the nullable i32-list ref.
    if et.primName == "i32" || et.primName == "boolean" {
      return repMk("nullist", 1, "i32")
    }
    // `null[] | null` — the `null[]` i32 list, every element the sentinel 2 (D4671).
    if et.primName == "null" { return repMk("nullist", 1, "i32") }
    // A DISTINCT-backing nullable scalar list — its own `(ref null $wrapper)` niche over
    // the leaf list wrapper. A non-null list value subtypes the nullable slot.
    if et.primName == "string" { return repMk("nulstrlist", 1, "string") }
    if et.primName == "f64" { return repMk("nulf64list", 1, "f64") }
    if et.primName == "i64" { return repMk("nuli64list", 1, "i64") }
    if et.primName == "f32" { return repMk("nulf32list", 1, "f32") }
    // D979 — the PACKED byte list joins the nullable-scalar-list family.
    if et.primName == "u8" { return repMk("nulu8list", 1, "u8list") }
  }
  // A litunion `K[] | null` — atoms are interned i32 ids, sharing the i32-list backing. A
  // nullable-litunion element `(K | null)[] | null` rides its null in the same i32 sentinel.
  if tyIsLitUnion(elem) || tyIsNullableLitUnion(elem) {
    return repMk("nullist", 1, "i32")
  }
  if et is TyNullable && et.nInner >= 0 {
    const eit = tyAt(et.nInner)
    // `(boolean | null)[] | null` — the sentinel-2 boolean element on the i32-list backing.
    if eit is TyPrim {
      if eit.primName == "boolean" { return repMk("nullist", 1, "i32") }
    }
    // `(string | null)[] | null` — the `$mkListIdx` backing already holds a nullable
    // string element, so the cell is the same `nulstrlist` niche as `string[] | null`.
    if eit is TyPrim {
      if eit.primName == "string" { return repMk("nulstrlist", 1, "string") }
    }
    // `({…} | null)[] | null` — the plain struct ref list already holds the element
    // nulls, so the cell is the `nulreflist` niche, exactly like `S[][] | null`.
    if eit is TyObj {
      if !repTyIsVariant(et.nInner) { return repMk("nulreflist", 1, "struct") }
    }
  }
  // Any other ref list (`S[] | null`, `S[][] | null`, a closure or box list) is its `nulreflist` niche.
  const ad = repOfArray(elem)
  if ad.rdCovered == 1 && ad.rdKind == "reflist" {
    return repMk("nulreflist", 1, ad.rdListElem)
  }
  repUncovered()
}

// The `unNames` row whose recorded arena type is structurally `ty` (shares its interned canon
// id), or -1. A row-identity scan of `unTyIx` is not enough: the arena is not hash-consed for
// composite spellings, so one spelling can mint several rows, and an arena-side reader has no
// spelling to offer.
export function unRowOfCanon(ty: i32): i32 {
  if ty < 0 { return -1 }
  const c = repCanonId(ty)
  ucIxSync()
  ucIxFirst[c] ?? (-1)
}

// `unRowOfCanon`'s index: canon id to the first `unTyIx` row carrying it, over rows below
// `ucIxUpTo`. A row's canon id holds while the arena's generation does; the pass generation
// is in the key too, since `collectU` refills the registry from empty within a compile.
let ucIxFirst: {[i32]: i32} = Map()

let ucIxUpTo = 0

const ucIxKey = memoKeyNew(2)

function ucIxSync() {
  let moved = memoMoved(ucIxKey, 0, tyMutEpoch)
  moved = memoPassMoved(ucIxKey, 1) || moved
  if moved || unTyIx.length < ucIxUpTo {
    ucIxFirst = Map()
    ucIxUpTo = 0
  }
  while ucIxUpTo < unTyIx.length {
    const t = unTyIx[ucIxUpTo]
    if t >= 0 {
      const c = repCanonId(t)
      if !ucIxFirst.has(c) { ucIxFirst[c] = ucIxUpTo }
    }
    ucIxUpTo = ucIxUpTo + 1
  }
  0
}

// The union registry row of `inner | null`, matched by the inner's canon id, or -1. A reader
// that holds only `inner` asks this rather than minting the nullable in the arena. An unfilled
// hole's canon is the error id, which no `inner` this is asked about shares.
function unRowOfNullableOver(inner: i32): i32 {
  if inner < 0 { return -1 }
  const c = repCanonId(inner)
  let u = 0
  while u < unTyIx.length {
    if unTyIx[u] >= 0 {
      const t = tyAt(unTyIx[u])
      if t is TyNullable {
        if repCanonId(t.nInner) == c { return u }
      }
    }
    u = u + 1
  }
  -1
}

// The union registry row whose minted `unKey` equals the key canon obtains for `ty`, or -1.
// Unlike the canon id, the key keeps apart rows the box ABI needs distinct, and it reaches a
// row registered under a spelling the arena node's canon id does not share.
// `docs/internals/registry-by-type-id.md` §5.
export function unRowOfKey(ty: i32): i32 { unRowOfKeyId(canonUnionKeyOfTy(ty)) }

// The same reverse index from the key itself, for a producer with no arena node at all
// (`registerInlineUnion`'s sub-spellings). `docs/internals/registry-by-type-id.md` §5, step 4b.
export function unRowOfKeyId(k: i32): i32 {
  if k < 0 || k >= unKeyFirstRow.length { return -1 }
  unKeyFirstRow[k]
}

// An array's rep is decided by its ELEMENT variant — one wrapper level, never
// the element's own descriptor (which is what keeps this arm cycle-free).
function repOfArray(elem: i32): RepDesc {
  // An element hole (`[]` never pinned) has no rep to claim.
  if elem < 0 { return repUncovered() }
  const et = tyAt(elem)
  if et is TyPrim {
    if et.primName == "i32" || et.primName == "boolean" {
      return repMk("list", 0, "i32")
    }
    if et.primName == "f64" { return repMk("f64list", 0, "f64") }
    if et.primName == "i64" { return repMk("i64list", 0, "i64") }
    if et.primName == "f32" { return repMk("f32list", 0, "f32") }
    // `u8[]` — the packed byte list. Its element is a storage type: one byte in the
    // backing, an i32 at every value seam. The descriptor records the element as `"u8"`
    // so the list layer can pick the packed backing; nothing downstream treats `"u8"` as a scalar value kind, since there is no such value (see `TY_U8` in the checker).
    if et.primName == "u8" { return repMk("u8list", 0, "u8") }
    if et.primName == "string" { return repMk("strlist", 0, "string") }
    // `null[]` rides the i32 list, every element the `boolean | null` sentinel 2 (D4671).
    if et.primName == "null" { return repMk("list", 0, "i32") }
    return repUncovered()
  }
  // `((i32) => i32)[]` — a closure-element ref list.
  if et is TyFunc {
    if fnTagTyIsTagged(elem) { return repMk("list", 0, "i32") }
    return repMk("reflist", 0, "closure")
  }
  // `S[]` / `{f: i32}[]` — a struct-element ref list (a variant-member element
  // is also a ref-list element; the slot layer resolves which).
  if et is TyObj { return repMk("reflist", 0, "struct") }
  // `{[string]: V}[]` — a map element is a reference like a struct or a closure, so the
  // list is a ref list whatever the map's own value rep is; the mv layer owns that.
  if et is TyMap { return repMk("reflist", 0, "map") }
  // `S[][]` — a list is a reference too, so a list OF lists is a ref list whatever the
  // inner element reps as; the inner list's own rep is its own query.
  if et is TyArray { return repMk("reflist", 0, "list") }
  if et is TyNullable { return repOfNulElemArray(elem, et.nInner) }
  // `"x"[]` — a single string literal element is its one-member set's atom (D7340).
  if et is TyLit {
    if et.litKind == "str" { return repMk("list", 0, "i32") }
    return repUncovered()
  }
  if et is TyUnion {
    // `K[]` over a declared litunion alias, a provenanced copy, or a genuinely inline
    // `("a" | "b")[]` — all three are atom-id elements riding the i32 list. Canon softens
    // a bare inline union to `string`, but at the element position the two spellings are
    // one type, exactly as `repOfNullable`'s list arm already treats it — ungated here too.
    if tyIsLitUnion(elem) { return repMk("list", 0, "i32") }
    // The expanded `("a" | "b" | null)[]` keeps its null in the atom's `-1` sentinel.
    if tyIsNullableLitUnion(elem) { return repMk("list", 0, "i32") }
    // A numeric litunion `(1 | 2)[]` rides its base scalar's list.
    const nb = numLitUnionBaseTy(elem)
    if nb >= 0 && nb != elem {
      const nbt = tyAt(nb)
      if nbt is TyPrim {
        if nbt.primName != "string" { return repOfArray(nb) }
      }
    }
    // The canonicalized `{a} & {b}` one-member union is the struct itself.
    if et.uMembers.length == 1 {
      const w = tyAt(et.uMembers[0])
      if w is TyObj { return repMk("reflist", 0, "struct") }
      // A self-referential union with a `null` arm (`Json`) interns as `TyUnion[TyNullable(rest)]`;
      // it is the box over `rest | null`, and the registry holds its row under the wrapper.
      if w is TyNullable {
        if tyIsValueUnionBox(w.nInner) && unRowOfCanon(elem) >= 0 {
          return repMk("reflist", 0, "union")
        }
      }
    }
    // Lists that all spell one list are that list, a reference like `S[][]`'s element.
    if oneListUnionRender(elem) != "" { return repMk("reflist", 0, "list") }
    // A value-union BOX element the registry holds a row for — a reference, so a ref list.
    // `tyIsValueUnionBox` is the shape gate (a numeric litunion has a canon row too but reps
    // as its scalar list). The row is found by canon id, else by key, since an arena node
    // need not share the canon id of the spelling that registered the row.
    if tyIsValueUnionBox(elem) {
      if unRowOfCanon(elem) >= 0 || unRowOfKey(elem) >= 0 {
        return repMk("reflist", 0, "union")
      }
    }
    // A join of records with no box row is a list of the one arm its literals denote, a
    // struct-element ref list like `S[]`.
    if repAllMembersObj(et.uMembers) { return repMk("reflist", 0, "struct") }
    return repUncovered()
  }
  // A map-key or negation element, or an unregistered union — legacy owns those.
  repUncovered()
}

// Whether every member of a union is an object type.
function repAllMembersObj(ms: i32[]) {
  if ms.length == 0 { return false }
  for m in ms {
    if m < 0 || m >= T.tys.length { return false }
    const mt = tyAt(m)
    if !(mt is TyObj) { return false }
  }
  true
}

// `(E | null)[]` by inner `E`, one answer per null discipline (`rtNulDiscOf`): a sentinel
// element rides its base list, a niche reference and a registered box ride the ref list.
// `elem` is the nullable element itself, the type the union registry keys a box on.
function repOfNulElemArray(elem: i32, inner: i32): RepDesc {
  if inner < 0 { return repUncovered() }
  const it = tyAt(inner)
  match it {
    TyPrim => {
      if it.primName == "string" { return repMk("strlist", 0, "string") }
      if it.primName == "boolean" { return repMk("list", 0, "i32") }
      // A nullable scalar boxes as a value union, as `repOfNullablePrim` says.
      if (
        it.primName == "i32"
        || it.primName == "i64"
        || it.primName == "f64"
        || it.primName == "f32"
        || it.primName == "v128"
      ) {
        if unRowOfCanon(elem) >= 0 { return repMk("reflist", 0, "union") }
      }
    }
    TyFunc => {
      return repMk("reflist", 0, "closure")
    }
    TyObj => {
      // A union arm's niche is a ref-list element too; the slot layer resolves its heap.
      return repMk("reflist", 0, "struct")
    }
    TyUnion => {
      if tyIsLitUnion(inner) { return repMk("list", 0, "i32") }
      // The box over `A | B` holds `null` as a member atom, as `repOfNullable` says, so the inner's
      // row also serves a nullable only an instance forms, which no collect pass registered.
      if tyIsValueUnionBox(inner) {
        if unRowOfCanon(elem) >= 0 || unRowOfCanon(inner) >= 0 {
          return repMk("reflist", 0, "union")
        }
      }
      // A numeric litunion boxes as its base scalar made nullable.
      // Its row is the base's, since the registry keys `N | null` on the rendered `i32|null`.
      const nb = numLitUnionBaseTy(inner)
      if nb >= 0 {
        if unRowOfNullableOver(nb) >= 0 { return repMk("reflist", 0, "union") }
      }
    }
    TyArray => {
      return repMk("reflist", 0, "list")
    }
    TyMap => {
      return repMk("reflist", 0, "map")
    }
    TyLit => {
      // `("x" | null)[]` — one string literal softens to `string`, as `repOfNullable` says.
      if it.litKind == "str" { return repMk("strlist", 0, "string") }
    }
    TyNullable => {
      // A doubled nullable — canon flattens it before emit.
    }
    TyVar => {
      // A generic parameter — the instance is what is asked about.
    }
    TyErr => {
      // The error hole — a rejected program never reaches emit.
    }
    TyNeg => {
      // A negation — consumed during checking.
    }
  }
  repUncovered()
}

// A map or Set is the `$mapStruct` ref whatever its key and value; which `$mapStruct` (the mv
// slot) is the slot layer's. A value still a hole has no type to rep yet.
function repOfMap(mVal: i32, mSet: i32): RepDesc {
  if mSet != 1 && mVal < 0 { return repUncovered() }
  repMk("map", 0, "")
}

// `repOf` for an AST node (an annotation/expression the checker recorded a type
// for): the arena derivation, plus the one recovery only the node can make — a
// same-shape union (`A | B` with structurally identical members) collapses to a
// single `TyObj` in the arena, losing its union-ness, while the emitter still boxes it for tag discrimination. The node's top-level `|` spelling is the only witness.
export function repOfNode(nodeIx: i32, fnIx: i32): RepDesc {
  repOfNodeAt(nodeIx, nodeTyAt(nodeIx, fnIx))
}

// `repOfNode` read at type `ty` instead of the node's recorded type: the type an instance gives
// a node its generic body shares. The same-shape union recovery still reads the node.
export function repOfNodeAt(nodeIx: i32, ty: i32): RepDesc {
  const d = repOfTyAtNode(nodeIx, ty)
  if d.rdCovered == 1 {
    // A template's node type is no instance's, so only a closed one can name the box.
    if d.rdKind == "struct" || d.rdKind == "variant" {
      const own = nodeTyIxOf(nodeIx)
      const closed = own < 0 || !tyHasTyVar(own)
      if closed && nodeTyIsUnionAlias(nodeIx) { return repMk("union", 0, "") }
    }
  }
  d
}

// `repOfTy(ty)`, except that the node's own recorded hole list reads at the element the checker
// closed it to (`nodeHoleElemOf`); a hole pinned since, or asked at another type, reads as itself.
function repOfTyAtNode(nodeIx: i32, ty: i32): RepDesc {
  const h = nodeHoleElemOf(nodeIx)
  if h < 0 || ty != nodeTyIxOf(nodeIx) { return repOfTy(ty) }
  const t = tyAt(ty)
  if t is TyArray {
    if t.aElem < 0 { return repOfArray(h) }
  }
  if t is TyNullable && t.nInner >= 0 {
    const it = tyAt(t.nInner)
    if it is TyArray {
      if it.aElem < 0 { return repOfNullableArray(h) }
    }
  }
  repOfTy(ty)
}

// The checked-rep column: node `ix`'s rep as the checker's type decided it, so a classifier
// asks the descriptor instead of a ladder over spellings. A negative `ix` is uncovered.
function nodeRep(ix: i32, fnIx: i32): RepDesc {
  if ix < 0 { return repUncovered() }
  repOfNode(ix, fnIx)
}

// Whether node `ix` reps as the bare string-literal-union atom.
export function nodeRepIsAtom(ix: i32, fnIx: i32): boolean {
  const d = nodeRep(ix, fnIx)
  d.rdCovered == 1 && d.rdAtom == 1 && d.rdNul == 0
}

// Whether node `ix` reps as the nullable atom: the i32 atom with the `-1` null sentinel.
export function nodeRepIsNulAtom(ix: i32, fnIx: i32): boolean {
  const d = nodeRep(ix, fnIx)
  d.rdCovered == 1 && d.rdAtom == 1 && d.rdNul == 3
}

// Whether node `ix` reps as kind `k`; the nullable niches (`nulstr`, `nulstruct`,
// `nullist`, `nulclosure`) are the kinds the classifiers ask it for.
export function nodeRepIs(ix: i32, k: VKind, fnIx: i32): boolean {
  const d = nodeRep(ix, fnIx)
  d.rdCovered == 1 && d.rdKind == k
}

// Whether a type contains an i64/f64/f32 leaf anywhere — through arrays,
// nullables, unions, map keys/values, function params/results, object fields, and
// negations. Drives the print-import scan: a program that can hold one of these
// scalars can narrow/read/print one, so the matching `__print_*__` import must exist.
export const REP_SCAL_I64 = 1
export const REP_SCAL_F64 = 2
export const REP_SCAL_F32 = 4

// Generation-stamped visited marks plus a completed-query memo, both indexed by
// `Ty`-arena index. The visited stamp terminates one query on arena cycles; the
// memo is written only for a query's root, since a completed walk covers the
// root's whole reachable component and its union is exact — interior cycle nodes are never memoized mid-walk, which could record an under-approximation.
let repSeenGen: i32[] = []
let repMaskMemo: i32[] = []
let repGen = 0

export function repReset() {
  repSeenGen = []
  repMaskMemo = []
  repGen = 0
  // The canonical-key memo + slot cache (above) are also arena-index-keyed —
  // drop them per program too. (Their generation stamps already catch this via
  // `initChecker`'s epoch advance; this keeps the reset story in one place.)
  repKeyMemo = []
  repKeyMemoEpoch = -1
  repSlotRepEpoch = -1
  rcMemo = []
  rcEpoch = -1
  repSlotByDecl = []
  repSlotKeySi = []
  repSlotKeyN = []
  memoKeyClear(repSlotCacheGenKey)
  // The recursive rep TREE (below) is arena-index-keyed too — force its next
  // `rtSync` to rebuild from scratch.
  repTreeDrop()
  0
}

function repGrowTo(n: i32) {
  while repSeenGen.length < n { repSeenGen.push(0) }
  while repMaskMemo.length < n { repMaskMemo.push(-1) }
  0
}

export function repTyScalarMask(root: i32) {
  if root < 0 { return 0 }
  repGrowTo(T.tys.length)
  if root < repMaskMemo.length {
    if repMaskMemo[root] >= 0 { return repMaskMemo[root] }
  }
  repGen = repGen + 1
  let mask = 0
  // An index worklist (breadth-order); `wp` is the read cursor.
  const work: i32[] = []
  work.push(root)
  let wp = 0
  while wp < work.length {
    const ix = work[wp]
    wp = wp + 1
    if ix >= 0 && ix < T.tys.length {
      // The arena can GROW mid-emit (monomorphization records late types) —
      // re-grow so the stamp arrays cover any index the walk reaches.
      repGrowTo(T.tys.length)
      if repSeenGen[ix] != repGen {
        repSeenGen[ix] = repGen
        if repMaskMemo[ix] >= 0 {
          // A prior query completed from this node — fold its exact component
          // union instead of re-walking.
          mask = mask | repMaskMemo[ix]
        } else {
          const t = tyAt(ix)
          // Exhaustive over `Ty` and deliberately `_`-less: a 12th arena variant breaks the
          // self-compile here instead of leaving the mask silently 0 (mentions no wide
          // scalar) — the dangerous direction, since a missed mention drops a `__print_*__`
          // import the program needs. The three empty arms are leaves with nothing to descend into, each carrying its own reason.
          match t {
            TyPrim => {
              if t.primName == "i64" { mask = mask | REP_SCAL_I64 }
              if t.primName == "f64" { mask = mask | REP_SCAL_F64 }
              if t.primName == "f32" { mask = mask | REP_SCAL_F32 }
            }
            TyArray => {
              work.push(t.aElem)
            }
            TyNullable => {
              work.push(t.nInner)
            }
            TyUnion => {
              let mi = 0
              while mi < t.uMembers.length {
                work.push(t.uMembers[mi])
                mi = mi + 1
              }
            }
            TyMap => {
              work.push(t.mKey)
              work.push(t.mVal)
            }
            TyFunc => {
              let pi = 0
              while pi < t.fnParamTypes.length {
                work.push(t.fnParamTypes[pi])
                pi = pi + 1
              }
              work.push(t.fnRet)
            }
            TyObj => {
              let fi = 0
              while fi < t.objFieldTypes.length {
                work.push(t.objFieldTypes[fi])
                fi = fi + 1
              }
            }
            TyNeg => {
              work.push(t.negTy)
            }
            TyLit => {
              // A literal type mentions the scalar it softens to, descending through the one
              // home for that rule (`litBaseTy`). Its inhabitants are not all spelled in source:
              // `null` inhabits `N | null` without being a member, so `g(null)` over `type N =
              // 1.5 | 2.5` spells no float anywhere while the `is`-narrowed read is an f64 — `print` then routed to an import the section never declared, giving invalid wasm.
              work.push(litBaseTy(t))
            }
            TyErr => {
              // The error/unknown hole — assignable both ways, so it has no
              // leaf of its own to mention.
            }
            TyVar => {
              // A generic type PARAMETER: the monomorphizer substitutes it
              // before this query runs, so the mask is read off the instance.
            }
          }
        }
      }
    }
  }
  repMaskMemo[root] = mask
  mask
}

// The scalar-mention mask of the type the checker recorded for node `ix`, or
// -1 when the node has NO recorded type — the caller must fall back to its
// name-based test (an emitter-synthesized node past the typed-IR table, or an
// emitter-internal name `nameToTy` cannot resolve).
export function repNodeScalarMask(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return -1 }
  repTyScalarMask(ty)
}

// The `REP_SCAL_*` mask a load-width intrinsic call results in, read off the name
// (`buffer-design.md` section C2's matrix). 0 for every width landing in an i32 and
// for any non-load-width name. Keyed by name, not `nodeTyIxOf`, since the name
// determines the result type totally, unlike the arena, which answers -1 for nodes it never recorded.
export function repMemLoadScalarMask(name: string) {
  if name == "__load_i64__" { return REP_SCAL_I64 }
  if name == "__load_u8_i64__" { return REP_SCAL_I64 }
  if name == "__load_u16_i64__" { return REP_SCAL_I64 }
  if name == "__load_u32_i64__" { return REP_SCAL_I64 }
  if name == "__load_f32__" { return REP_SCAL_F32 }
  if name == "__load_f64__" { return REP_SCAL_F64 }
  0
}

// The recursive rep tree (rep-rewrite Stage A, see ROADMAP.md): the total,
// compositional successor of the flat descriptor — where `RepDesc` classifies at
// most one wrapper deep and answers uncovered for anything it cannot name, the
// tree denotes every post-mono type, with an unhandled shape becoming an explicit `unsup` node carrying a stable reason code rather than a silent fall-through.
type RtKind = "i32"
  | "bool"
  | "i64"
  | "f64"
  | "f32"
  | "str"
  | "u8"
  | "atom"
  | "list"
  | "map"
  | "box"
  | "closure"
  | "struct"
  | "nul"
  | "unsup"

let rtKind: RtKind[] = [] // node kind — see the grammar above
let rtDisc: i32[] = [] // kind-specific: nul discipline (rdNul's 1/2/3/4) ·
// struct 1 = union-VARIANT member · closure 1 = declared-void result
let rtChild: i32[] = [] // list elem / map val / nul inner; else -1
let rtSlot: i32[] = [] // struct: the interned struct-table slot, else -1
let rtTy: i32[] = [] // the arena index that BUILT the node — provenance for
// debugging only, never identity (a hash-cons merge keeps the first builder's)
let rtReason: string[] = [] // unsup: the policy reason-code, else ""
let rtKidStart: i32[] = [] // struct fields / box members / closure params+ret,
let rtKidCount: i32[] = [] // a [start,count) block in `rtKids`; -1 = the node
// is still under construction (the cycle re-entry marker)
let rtKids: i32[] = []
let rtByTy: i32[] = [] // Ty index → node index (-1 unfilled); the cycle breaker
let rtIntern: {[string]: i32} = Map() // structural key → node (hash-cons)
let rtWalkGen: i32[] = [] // per-node visit stamps (`repTreeUnsupReason`)
let rtWalkN = 0
// The generations `rtSync` last built at; plain stamps, as `repKeyMemo`'s comment says.
let rtEpoch = -1
let rtUserVer = -1

// Invalidate the tree (the `repReset` hook): the next `rtSync` rebuilds.
function repTreeDrop() {
  rtEpoch = -1
  rtUserVer = -1
  0
}

// Lifetime: generation-stamped on the checker axes of the flat layer's memos
// (`tyMutEpoch`, `cUserTypesVer`) and the variant shapes (`rvsSync` drops it); any bump drops the whole tree, conservative like
// the key memo. `sNames.length` is deliberately not an axis, since the authority
// projections never consult `rtSlot` and slot interning happens constantly during emit. Building is lazy; a returned node index is valid only until the next mutation.
function rtSync() {
  rvsSync()
  if (rtEpoch == tyMutEpoch && rtUserVer == cUserTypesVer) { return 0 }
  rtKind = []
  rtDisc = []
  rtChild = []
  rtSlot = []
  rtTy = []
  rtReason = []
  rtKidStart = []
  rtKidCount = []
  rtKids = []
  rtByTy = []
  rtIntern = Map()
  rtWalkGen = []
  rtWalkN = 0
  rtEpoch = tyMutEpoch
  rtUserVer = cUserTypesVer
  0
}

// A new node with its own columns filled; `kidCount` -1 leaves it under construction until
// `rtCompleteChild` or `rtSetKids` fills its children.
function rtAlloc(
  kind: RtKind,
  ty: i32,
  disc: i32,
  slot: i32,
  reason: string,
  kidCount: i32,
): i32 {
  const ix = rtKind.length
  rtKind.push(kind)
  rtDisc.push(disc)
  rtChild.push(-1)
  rtSlot.push(slot)
  rtTy.push(ty)
  rtReason.push(reason)
  rtKidStart.push(0)
  rtKidCount.push(kidCount)
  ix
}

// Complete one-child node `ix` (a list, map or nullable) with `child`; a hole `ix` is not a node.
function rtCompleteChild(ix: i32, child: i32, ty: i32): i32 {
  if ix < 0 || ix >= rtChild.length { return ix }
  rtChild[ix] = child
  rtKidCount[ix] = 0
  rtComplete(ix, ty)
}

function rtByTyPut(ty: i32, ix: i32) {
  while rtByTy.length <= ty { rtByTy.push(-1) }
  rtByTy[ty] = ix
  0
}

// A LEAF node (no children): interned by key directly — no throwaway
// allocation on a hit. The key grammar is shared with `rtInternKeyOf` (a leaf
// is the empty-suffix case), so a leaf and a composite can never collide.
function rtLeafOf(kind: RtKind, disc: i32, reason: string, ty: i32): i32 {
  const key = kind + "|" + i32ToStr(disc) + "|" + reason + "|"
  const hit = rtIntern[key] ?? -1
  if hit >= 0 {
    if ty >= 0 { rtByTyPut(ty, hit) }
    return hit
  }
  const ix = rtAlloc(kind, ty, disc, -1, reason, 0)
  rtIntern[key] = ix
  if ty >= 0 { rtByTyPut(ty, ix) }
  ix
}

// The structural (hash-cons) key of a completed node: kind + discriminator +
// reason + the child/kid node indices + (structs) the field names — child identity,
// not a recursive render, so equal keys mean equal layout trees. Field names ride
// along since the struct twin equivalence requires them (`repCanonKey` keys `{a:i32}` apart from `{b:i32}`).
function rtInternKeyOf(ix: i32): string {
  let s = rtKind[ix] + "|" + i32ToStr(rtDisc[ix]) + "|" + rtReason[ix] + "|"
  if rtChild[ix] >= 0 { s = s + "c" + i32ToStr(rtChild[ix]) + ";" }
  let k = 0
  while k < rtKidCount[ix] {
    s = s + i32ToStr(rtKids[rtKidStart[ix] + k]) + ","
    k = k + 1
  }
  if rtKind[ix] == "struct" {
    const t = tyAt(rtTy[ix])
    if t is TyObj {
      let fi = 0
      while fi < t.objFieldNames.length {
        s = s + t.objFieldNames[fi] + ":"
        fi = fi + 1
      }
    }
  }
  s
}

function rtSetKids(ix: i32, kids: i32[]) {
  rtKidStart[ix] = rtKids.length
  let i = 0
  while i < kids.length {
    rtKids.push(kids[i])
    i = i + 1
  }
  rtKidCount[ix] = kids.length
  0
}

// Complete node `ix` (children filled): consult the hash-cons table. An existing
// structurally-identical node wins — `ix` is orphaned (a small, bounded arena leak,
// at most one per distinct `Ty` per generation) and the `Ty` memo redirects, folding
// nominal slot knowledge into the survivor. A cycle participant cannot collide (its key contains its own index), so redirecting is always safe.
function rtComplete(ix: i32, ty: i32): i32 {
  const key = rtInternKeyOf(ix)
  const hit = rtIntern[key] ?? -1
  if hit >= 0 && hit != ix {
    if rtSlot[hit] < 0 && rtSlot[ix] >= 0 { rtSlot[hit] = rtSlot[ix] }
    if ty >= 0 { rtByTyPut(ty, hit) }
    return hit
  }
  rtIntern[key] = ix
  ix
}

// The one total constructor: the rep tree of arena type `ty`. Always returns a
// node; a shape without a settled lowering policy returns an `unsup` node whose
// reason-code is one of the stable coverage buckets: hole, prim:<name>,
// litunion:noalias, union:single-nonobj/unclassified, nul:hole/unclassified, list:hole, map:key/val-hole, neg, leaf:unnarrowable.
function repTreeOfTy(ty: i32): i32 {
  rtSync()
  rtGo(ty)
}

function rtGo(ty: i32): i32 {
  if ty < 0 { return rtLeafOf("unsup", 0, "hole", -1) }
  if ty < rtByTy.length {
    if rtByTy[ty] >= 0 { return rtByTy[ty] }
  }
  const t = tyAt(ty)
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th arena variant breaks
  // the self-compile here rather than silently taking the `leaf:unnarrowable`
  // bucket, which reads as a settled coverage answer.
  match t {
    TyPrim => {
      return rtOfPrim(t.primName, ty)
    }
    TyFunc => {
      if fnTagTyIsTagged(ty) { return rtOfPrim("i32", ty) }
      return rtOfFunc(ty, t.fnParamTypes, t.fnRet)
    }
    TyObj => {
      return rtOfObj(ty, t.objFieldTypes)
    }
    TyUnion => {
      return rtOfUnion(ty, t.uMembers)
    }
    TyNullable => {
      return rtOfNullable(ty, t.nInner)
    }
    TyArray => {
      if t.aElem < 0 { return rtLeafOf("unsup", 0, "list:hole", ty) }
      const ix = rtAlloc("list", ty, 0, -1, "", -1)
      rtByTyPut(ty, ix)
      return rtCompleteChild(ix, rtGo(t.aElem), ty)
    }
    TyMap => {
      return rtOfMap(ty, t.mVal, t.mSet)
    }
    TyNeg => {
      return rtLeafOf("unsup", 0, "neg", ty)
    }
    TyVar => {
      // A generic type PARAMETER — the monomorphizer instantiates it and the
      // INSTANCE gets the tree.
    }
    TyLit => {
      // A bare literal type is stored as its base scalar.
      return rtGo(litBaseTy(t))
    }
    TyErr => {
      // The error/unknown hole — a rejected program never reaches emit.
    }
  }
  // The two empty arms above land here: none has a standalone rep of its own,
  // so each becomes the STABLE `leaf:unnarrowable` coverage bucket.
  rtLeafOf("unsup", 0, "leaf:unnarrowable", ty)
}

function rtOfPrim(pn: PrimName, ty: i32): i32 {
  // `boolean` keeps its own leaf even though its valtype is i32: the flat slot
  // layer's canonical key distinguishes `{f:boolean}` from `{f:i32}`
  // (structural-non-twin-distinct.vl), so tree identity must too. `void` follows the
  // flat ladder; a result's void-ness is a separate axis (`rtDisc` on the closure node).
  if pn == "i32" { return rtLeafOf("i32", 0, "", ty) }
  if pn == "boolean" { return rtLeafOf("bool", 0, "", ty) }
  if pn == "i64" { return rtLeafOf("i64", 0, "", ty) }
  if pn == "f64" { return rtLeafOf("f64", 0, "", ty) }
  if pn == "f32" { return rtLeafOf("f32", 0, "", ty) }
  if pn == "string" { return rtLeafOf("str", 0, "", ty) }
  // `u8` — a STORAGE leaf, not a value leaf. It reaches this function only as an array
  // ELEMENT (the checker admits `u8` nowhere else), and `rtListVKind` is the only reader
  // that answers for it; a `u8` in any other tree position has no rep and correctly
  // finds none.
  if pn == "u8" { return rtLeafOf("u8", 0, "", ty) }
  if pn == "void" { return rtLeafOf("i32", 0, "", ty) }
  // `null` (and any future prim) — no standalone rep policy.
  rtLeafOf("unsup", 0, "prim:" + primNameStr(pn), ty)
}

function rtOfFunc(ty: i32, paramTys: i32[], retTy: i32): i32 {
  let disc = 0
  if retTy >= 0 {
    const rt = tyAt(retTy)
    if rt is TyPrim {
      if rt.primName == "void" { disc = 1 }
    }
  }
  const ix = rtAlloc("closure", ty, disc, -1, "", -1)
  rtByTyPut(ty, ix)
  const kids: i32[] = []
  let i = 0
  while i < paramTys.length {
    kids.push(rtGo(paramTys[i]))
    i = i + 1
  }
  // The RESULT rides as the last kid (void-ness is `rtDisc`, see above).
  kids.push(rtGo(retTy))
  rtSetKids(ix, kids)
  rtComplete(ix, ty)
}

function rtOfObj(ty: i32, fieldTys: i32[]): i32 {
  // Checker metadata in: a union-VARIANT member's slot vocabulary is the
  // variant index, not the struct table — the discriminator keeps the two
  // apart through hash-consing.
  let disc = 0
  if repTyIsVariant(ty) { disc = 1 }
  rtOfObjAs(ty, ty, disc, fieldTys)
}

// The struct-node builder, split from `rtOfObj` so a single-member union can
// build its member's shape under the union's memo index with variant-ness forced
// off. `memoTy` keys `rtByTy` (the cycle breaker, so a self-reference through the
// alias spelling resolves back to it); `objTy` names the fields and claims the slot.
function rtOfObjAs(memoTy: i32, objTy: i32, disc: i32, fieldTys: i32[]): i32 {
  const ix = rtAlloc("struct", objTy, disc, repSlotOfTy(objTy), "", -1)
  rtByTyPut(memoTy, ix)
  const kids: i32[] = []
  let fi = 0
  while fi < fieldTys.length {
    kids.push(rtGo(fieldTys[fi]))
    fi = fi + 1
  }
  rtSetKids(ix, kids)
  rtComplete(ix, memoTy)
}

function rtOfUnion(ty: i32, members: i32[]): i32 {
  // A string literal union is the interned i32 atom, whatever its spelling.
  if tyIsLitUnion(ty) { return rtLeafOf("atom", 0, "", ty) }
  // D-NULLITHOME: the expanded nullable-litunion `"a" | "b" | null` is the same type
  // the two-part `K | null` spelling builds as a `nul` node (disc 3, atom-sentinel),
  // so building it identically here lets the hash-cons fold both spellings into one
  // node. Without this arm the tree answered "union" for a type every reader lowers as the i32 atom niche, giving invalid wasm.
  if tyIsNullableLitUnion(ty) {
    const nix = rtAlloc("nul", ty, 3, -1, "", -1)
    rtByTyPut(ty, nix)
    return rtCompleteChild(
      nix,
      rtLeafOf("unsup", 0, "litunion:noalias", -1),
      ty,
    )
  }
  if members.length == 1 {
    const m = tyAt(members[0])
    if m is TyObj {
      // The canonicalized `{a} & {b}` struct alias — a plain struct, never a variant:
      // the emitter lowers a one-member union as the struct itself (disc 0). The
      // member's own index agrees since variant-member registration is arity-aware (#920 irregularity (a)): a single-member decl never marks its member a variant.
      return rtOfObjAs(ty, members[0], 0, m.objFieldTypes)
    }
    // Any other one-member union is its member.
    const k1 = rtGo(members[0])
    rtByTyPut(ty, k1)
    return k1
  }
  // Lists that all spell one list are that list: the first member with a flat kind decides.
  if oneListUnionRender(ty) != "" {
    for m in members {
      const k = rtGo(m)
      if repTreeVKind(k) != null {
        rtByTyPut(ty, k)
        return k
      }
    }
    return rtLeafOf("unsup", 0, "union:unclassified", ty)
  }
  if unionHasOpenMember(members) {
    return rtLeafOf("unsup", 0, "union:open", ty)
  }
  if tyIsValueUnionBox(ty) {
    const ix = rtAlloc("box", ty, 0, -1, "", -1)
    rtByTyPut(ty, ix)
    const kids: i32[] = []
    let mi = 0
    while mi < members.length {
      kids.push(rtGo(members[mi]))
      mi = mi + 1
    }
    rtSetKids(ix, kids)
    return rtComplete(ix, ty)
  }
  // A numeric literal union (`0 | 1`) is its base scalar; anything else is a policy gap.
  const nb = numLitUnionBaseTy(ty)
  if nb >= 0 {
    const bk = rtGo(nb)
    rtByTyPut(ty, bk)
    return bk
  }
  rtLeafOf("unsup", 0, "union:unclassified", ty)
}

// The nullable DISCIPLINE for inner type `inner` — `rdNul`'s vocabulary
// (1 nullable ref niche · 2 i32 sentinel 2 · 3 atom sentinel -1 · 4 boxed),
// or 0 when no discipline exists (the nullable is a policy gap).
function rtNulDiscOf(inner: i32): i32 {
  const it = tyAt(inner)
  match it {
    TyPrim => {
      // Exhaustive over `PrimName` and `_`-less: `0` is "no nullable discipline (a policy gap)",
      // a real answer, so a new prim must declare its discipline here.
      match it.primName {
        "string" => 1
        "boolean" => 2
        "i32" | "i64" | "f64" | "f32" | "v128" => 4
        // No nullable discipline.
        "void" | "null" | "never" | "u8" => 0
      }
    }
    // A function takes its own rep's discipline: the closure ref, or a tagged set's i32 id.
    TyFunc => {
      if rtKind[rtGo(inner)] == "i32" { return 4 }
      1
    }
    TyObj | TyArray | TyMap => 1
    TyUnion => {
      // Any string-literal-union inner, aliased or inline, takes the atom sentinel.
      if tyIsLitUnion(inner) { return 3 }
      if tyIsValueUnionBox(inner) { return 4 }
      // A numeric literal union takes its base scalar's discipline.
      const nb = numLitUnionBaseTy(inner)
      if nb >= 0 { return rtNulDiscOf(nb) }
      // Lists that all spell one list take a list's discipline.
      if oneListUnionRender(inner) != "" { return 1 }
      if it.uMembers.length == 1 {
        const m = tyAt(it.uMembers[0])
        if m is TyObj { return 1 }
      }
      0
    }
    // Nullable-of-nullable, negation, unnarrowable leaves — no discipline.
    TyNullable | TyNeg | TyVar | TyLit | TyErr => 0
  }
}

function rtOfNullable(ty: i32, inner: i32): i32 {
  if inner < 0 { return rtLeafOf("unsup", 0, "nul:hole", ty) }
  const disc = rtNulDiscOf(inner)
  if disc == 0 { return rtLeafOf("unsup", 0, "nul:unclassified", ty) }
  const ix = rtAlloc("nul", ty, disc, -1, "", -1)
  rtByTyPut(ty, ix)
  rtCompleteChild(ix, rtGo(inner), ty)
}

function rtOfMap(ty: i32, mVal: i32, mSet: i32): i32 {
  // Every key kind stores in the same `$mapStruct` family; the key list is the slot's.
  if mSet != 1 && mVal < 0 { return rtLeafOf("unsup", 0, "map:val-hole", ty) }
  const ix = rtAlloc("map", ty, 0, -1, "", -1)
  rtByTyPut(ty, ix)
  // A Set is internally a boolean-valued map — the mono value rep.
  const child = if mSet == 1 { rtLeafOf("bool", 0, "", -1) } else { rtGo(mVal) }
  rtCompleteChild(ix, child, ty)
}

// ── Tree accessors + flat projections ────────────────────────────────────────
// Read-only structure accessors (the arena arrays stay private so every
// consumer goes through one vocabulary).
function repTreeKindOf(ix: i32): string {
  if ix < 0 { return "" }
  rtKind[ix]
}

function repTreeSlotOf(ix: i32): i32 {
  if ix < 0 { return -1 }
  rtSlot[ix]
}

// The tree's projection onto the flat `VKind` vocabulary — the fact the
// differential harness compares against `rdKind`, and the shim Stage B consumers
// migrate through. `null` means the tree has no flat spelling (an `unsup` node,
// or a composition the flat alphabet cannot name yet), matching the flat layer's `rdCovered == 0` so the two stay comparable exactly where both speak.
function repTreeVKind(ix: i32): VKind | null {
  if ix < 0 { return null }
  const k = rtKind[ix]
  match k {
    "i32" | "bool" => {
      return "i32"
    }
    "i64" => {
      return "i64"
    }
    "f64" => {
      return "f64"
    }
    "f32" => {
      return "f32"
    }
    "str" => {
      return "str"
    }
    "atom" => {
      return "i32"
    }
    "closure" => {
      return "closure"
    }
    "box" => {
      return "union"
    }
    "map" => {
      return "map"
    }
    "struct" => {
      if rtDisc[ix] == 1 { return "variant" }
      return "struct"
    }
    "list" => {
      return rtListVKind(rtChild[ix])
    }
    "nul" => {
      return rtNulVKind(ix)
    }
    "u8" | "unsup" => {
      return null
    }
  }
}

function rtListVKind(elem: i32): VKind | null {
  if elem < 0 { return null }
  const ek = rtKind[elem]
  // Exhaustive over `RtKind` and `_`-less: the unnamed `box` takes `null` (a list element is
  // never a raw value box), so a new element kind must decide its list vocabulary here.
  match ek {
    "unsup" => {
      return null
    }
    // Atom elements share the i32-list backing (interned i32 ids), as do
    // boolean elements (same valtype).
    "i32" | "bool" | "atom" => {
      return "list"
    }
    "i64" => {
      return "i64list"
    }
    "f64" => {
      return "f64list"
    }
    "f32" => {
      return "f32list"
    }
    "u8" => {
      return "u8list"
    }
    "str" => {
      return "strlist"
    }
    "struct" | "closure" | "map" | "list" => {
      return "reflist"
    }
    "nul" => {
      return rtNulElemListVKind(elem)
    }
    // A value-union BOX element the registry holds a row for — the box is a reference, so
    // the list is a ref list. Gated on the node's arena provenance, the same canon-id
    // question the flat arm asks, so a box with no row declines on both sides.
    "box" => {
      if unRowOfCanon(rtTy[elem]) >= 0 { return "reflist" }
      return null
    }
  }
}

// `(E | null)[]`'s list kind by the element's null discipline, as `repOfNulElemArray` decides
// it: a sentinel element rides the i32 list, a niche string the string list, a niche
// reference and a registered box the ref list.
function rtNulElemListVKind(elem: i32): VKind | null {
  const d = rtDisc[elem]
  if d == 2 || d == 3 { return "list" }
  if d == 4 {
    if unRowOfCanon(rtTy[elem]) >= 0 { return "reflist" }
    return null
  }
  const n = rtNulNicheElemName(elem)
  if n == "" { return null }
  if n == "string" { return "strlist" }
  "reflist"
}

// The flat element vocabulary of a nullable list element, by the same discipline.
function rtNulElemName(elem: i32): string {
  const d = rtDisc[elem]
  if d == 2 || d == 3 { return "i32" }
  if d == 4 { return "union" }
  rtNulNicheElemName(elem)
}

// The element name of a niche nullable `elem` by its inner's kind, or "" for any other
// discipline and for an inner no niche list holds.
function rtNulNicheElemName(elem: i32): string {
  const nin = rtChild[elem]
  if rtDisc[elem] != 1 || nin < 0 { return "" }
  const k = rtKind[nin]
  match k {
    "str" => {
      return "string"
    }
    "struct" | "closure" | "map" | "list" => {
      return k
    }
    // A scalar or box inner takes a sentinel or a box, never a niche.
    "i32" | "bool" | "i64" | "f64" | "f32" | "u8" | "atom" | "box" | "nul" | "unsup" => {
      return ""
    }
  }
}

function rtNulVKind(ix: i32): VKind | null {
  const d = rtDisc[ix]
  // `boolean | null` is its own kind over an i32 valtype; a litunion `K | null` keeps the plain
  // i32 atom; the boxed discipline is the value-union box itself.
  if d == 2 { return "nulbool" }
  if d == 3 { return "i32" }
  if d == 4 { return "union" }
  if d != 1 { return null }
  const inner = rtChild[ix]
  if inner < 0 { return null }
  const k = rtKind[inner]
  match k {
    "str" => {
      return "nulstr"
    }
    "closure" => {
      return "nulclosure"
    }
    "struct" => {
      // A union arm's niche is decided per arena type; the node's builder decides it, as it
      // already decides `rtSlot`.
      if rtDisc[inner] == 1 { return repNulObjKind(rtTy[inner]) }
      return "nulstruct"
    }
    "map" => {
      return "nulmap"
    }
    "list" => {
      const elem = rtChild[inner]
      if elem < 0 { return null }
      const ek = rtKind[elem]
      match ek {
        "i32" | "bool" | "atom" => {
          return "nullist"
        }
        "str" => {
          return "nulstrlist"
        }
        "f64" => {
          return "nulf64list"
        }
        "i64" => {
          return "nuli64list"
        }
        "f32" => {
          return "nulf32list"
        }
        "u8" => {
          return "nulu8list"
        }
        // A ref, box, nullable or unsup element has no nullable-list kind.
        "list" | "map" | "box" | "closure" | "struct" | "nul" | "unsup" => {
          return null
        }
      }
    }
    // A scalar, box, nested nullable or unsup inner has no nullable kind of its own.
    "i32" | "bool" | "i64" | "f64" | "f32" | "u8" | "atom" | "box" | "nul" | "unsup" => {}
  }
  null
}

// The tree's `rdNul` projection: the null discipline of the TOP node.
function repTreeNulOf(ix: i32): i32 {
  if ix < 0 { return 0 }
  if rtKind[ix] == "nul" { return rtDisc[ix] }
  0
}

// The tree's `rdListElem` projection: the flat ELEMENT vocabulary of a list
// (or nullable-list) node — "" for a non-list or an element outside the flat
// alphabet.
function repTreeListElemName(ix: i32): string {
  if ix < 0 { return "" }
  let lix = ix
  if rtKind[ix] == "nul" { lix = rtChild[ix] }
  if lix < 0 { return "" }
  if rtKind[lix] != "list" { return "" }
  const elem = rtChild[lix]
  if elem < 0 { return "" }
  const ek = rtKind[elem]
  match ek {
    "i32" | "bool" | "atom" => {
      return "i32"
    }
    "i64" | "f64" | "f32" | "u8" => {
      return ek
    }
    "str" => {
      return "string"
    }
    "struct" => {
      return "struct"
    }
    "closure" => {
      return "closure"
    }
    "map" => {
      return "map"
    }
    "list" => {
      return "list"
    }
    "nul" => {
      return rtNulElemName(elem)
    }
    "box" => {
      return "union"
    }
    // An unsup element is outside the flat alphabet.
    "unsup" => {}
  }
  ""
}

// Whether `root`'s tree contains an `unsup` node anywhere, and which policy gap,
// as the first reason-code reached (breadth-order, deterministic). `""` means the
// whole tree is real — the totality metric the coverage report buckets. Cycle-safe via a generation stamp per node.
function repTreeUnsupReason(root: i32): string {
  if root < 0 { return "hole" }
  rtWalkN = rtWalkN + 1
  while rtWalkGen.length < rtKind.length { rtWalkGen.push(0) }
  const work: i32[] = []
  work.push(root)
  let wp = 0
  while wp < work.length {
    const ix = work[wp]
    wp = wp + 1
    if ix >= 0 && rtWalkGen[ix] != rtWalkN {
      rtWalkGen[ix] = rtWalkN
      if rtKind[ix] == "unsup" { return rtReason[ix] }
      if rtChild[ix] >= 0 { work.push(rtChild[ix]) }
      let k = 0
      while k < rtKidCount[ix] {
        work.push(rtKids[rtKidStart[ix] + k])
        k = k + 1
      }
    }
  }
  ""
}

// The differential shadow harness: a debug-only sweep asserting the flat arms
// agree with the tree on every fact both can express wherever the flat side
// claims coverage — top kind, null discipline, list-element vocabulary, `$fnsig`
// token, struct-slot identity. The tree is the authority; a disagreement means one side is wrong. Off by default (`setRepShadow`, `$VL_REP_SHADOW`); an unarmed compile pays one boolean test.
export let repShadowOn = false

export function setRepShadow(v: i32) {
  repShadowOn = v != 0
  0
}

// Banked memo entries that do not reproduce when recomputed — see `repMemoCheck`.
let hcMemoBad = 0
let repShadowMsgs: string[] = []
let repShadowSeen: {[string]: i32} = Map()
let repShadowTys = 0
let repShadowReal = 0
let repShadowReasonNames: string[] = []
let repShadowReasonCounts: i32[] = []
let repShadowReasonIx: {[string]: i32} = Map()

// The identity↔spelling equivalence tallies. Two directions, because a partition
// agreement needs BOTH: no two distinct spellings may share an id (a false MERGE, the
// dangerous direction — it would fuse two layouts), and no spelling may reach two ids (a
// false SPLIT, which only declines a merge but still means the recursions disagree).
let hcSeenStrId: {[string]: i32} = Map()
// Per vocabulary, since the two key builders share one hash-cons table and an id
// reached from both is correct — `i32` is `i32` under either rendering, and the
// arms where they genuinely differ (`HC_SLOT`, `HC_RLI32`, `HC_RLSTR`) carry their
// own tags. Only same-vocabulary agreement is required, so only that is asserted.
let hcSeenIdStrC: string[] = []
let hcSeenIdStrE: string[] = []
let hcChecked = 0
let hcMergeBad = 0
let hcSplitBad = 0
let hcLenBad = 0

// The memo's own oracle: every banked depth-0 answer recomputed from scratch and
// compared, run before the sweep touches anything (the first `repElemKey` call
// clears both id memos if the generation moved, so checking after would validate
// a memo just rebuilt). Recomputation swaps the memo column out rather than clearing it, so a disagreement is reported and the banked column is restored either way.
function repMemoCheck() {
  const bankedMv = hcMvMemo
  const bankedElem = hcElemMemo
  hcMvMemo = []
  hcElemMemo = []
  let i = 0
  while i < bankedMv.length {
    if bankedMv[i] != -1 {
      if repMvValId(i) != hcMemoIdOf(bankedMv[i]) {
        hcMemoBad = hcMemoBad + 1
        repShadowNoteRaw("hc-memo mv ty=" + i32ToStr(i))
      }
    }
    i = i + 1
  }
  hcMvMemo = []
  let j = 0
  while j < bankedElem.length {
    if bankedElem[j] != -1 {
      if repElemId(j) != hcMemoIdOf(bankedElem[j]) {
        hcMemoBad = hcMemoBad + 1
        repShadowNoteRaw("hc-memo elem ty=" + i32ToStr(j))
      }
    }
    j = j + 1
  }
  hcMvMemo = bankedMv
  hcElemMemo = bankedElem
  0
}

// The sweep — called once per program from `emitProgram` AFTER the module bytes are
// final (the arena is complete then; monomorphization and the collect passes have
// minted every late type). Restarts its tallies each run, so an instance that compiles
// more than one program reports the last sweep.
export function repShadowSweep() {
  if !repShadowOn { return 0 }
  // Force a fresh tree: the normal-compile tree deliberately survives slot
  // interning (`sNames` growth is not an invalidation axis, see lifetime), so
  // nodes built mid-emit may carry slot claims from before the table finished. The
  // sweep's slot assertions must run over a tree built against the final table.
  repTreeDrop()
  repShadowMsgs = []
  repShadowSeen = Map()
  repShadowTys = 0
  repShadowReal = 0
  repShadowReasonNames = []
  repShadowReasonCounts = []
  repShadowReasonIx = Map()
  hcSeenStrId = Map()
  hcSeenIdStrC = []
  hcSeenIdStrE = []
  hcChecked = 0
  hcMergeBad = 0
  hcSplitBad = 0
  hcLenBad = 0
  hcMemoBad = 0
  // Run after the message/tally reset above (or it would discard what this reports)
  // and before the loop below, whose first `repElemKey` call runs `repElemMemoSync`
  // and clears both id memos if the generation moved during emit — checking after that would validate a memo just rebuilt, a tautology, not a test.
  repMemoCheck()
  // `T.tys.length` is re-read each pass: a slot query inside the sweep can
  // itself memoize a new annotation spelling (`resolveAnnot`), growing the
  // arena — those late types are swept too, and the growth terminates because
  // the checker memoizes.
  let ty = 0
  while ty < T.tys.length {
    repShadowCheckTy(ty)
    ty = ty + 1
  }
  0
}

// Add `n` to a bucket in one step. `repShadowBumpReason` counts an EVENT; a probe that
// accumulates during emit has to report a TOTAL after `repShadowSweep` has reset the table,
// and bumping once per event would then be O(events) work at report time.
export function repShadowAddReason(r: string, n: i32) {
  if n <= 0 { return 0 }
  const i = repShadowReasonIx[r] ?? -1
  if i >= 0 {
    repShadowReasonCounts[i] = repShadowReasonCounts[i] + n
    return 0
  }
  repShadowReasonIx[r] = repShadowReasonNames.length
  repShadowReasonNames.push(r)
  repShadowReasonCounts.push(n)
  0
}

export function repShadowBumpReason(r: string) {
  const i = repShadowReasonIx[r] ?? -1
  if i >= 0 {
    repShadowReasonCounts[i] = repShadowReasonCounts[i] + 1
    return 0
  }
  repShadowReasonIx[r] = repShadowReasonNames.length
  repShadowReasonNames.push(r)
  repShadowReasonCounts.push(1)
  0
}

// Record one disagreement, deduped per (fact, canonical structure) — the same
// composition reached through many arena indices reports once. Bounded: a
// systematic drift would otherwise flood one line per arena index.
function repShadowNote(tag: string, ty: i32, detail: string) {
  const key = tag + "|" + repCanonKey(ty)
  if (repShadowSeen[key] ?? 0) == 1 { return 0 }
  repShadowSeen[key] = 1
  if repShadowMsgs.length < 200 {
    repShadowMsgs.push(
      tag + " ty@" + i32ToStr(ty) + " " + repCanonKey(ty) + ": " + detail,
    )
  }
  0
}

// The identity equivalence check: one spelling, one id, one length. `which`
// distinguishes the two key vocabularies so a canon key and an elem key that
// happen to render the same text are not asked to share an id — different
// functions, and only same-vocabulary agreement is required.
function hcCheckKey(which: string, key: string, id: i32) {
  hcChecked = hcChecked + 1
  // The "" sentinel below means "unset", and no key builder can answer "" — every arm
  // emits at least one character. Stated because the sentinel would silently skip it.
  if key == "" { return 0 }
  if hcLenOf(id) != key.length {
    hcLenBad = hcLenBad + 1
    repShadowNoteRaw(
      "hc-len "
        + which
        + " key="
        + key
        + " len="
        + i32ToStr(key.length)
        + " hcLen="
        + i32ToStr(hcLenOf(id)),
    )
  }
  const tagged = which + "|" + key
  const prev = hcSeenStrId[tagged] ?? -1
  if prev < 0 {
    hcSeenStrId[tagged] = id
  } else if prev != id {
    // One spelling, two ids — a false SPLIT.
    hcSplitBad = hcSplitBad + 1
    repShadowNoteRaw("hc-split " + which + " key=" + key)
  }
  if which == "canon" {
    while hcSeenIdStrC.length <= id { hcSeenIdStrC.push("") }
    if hcSeenIdStrC[id] == "" {
      hcSeenIdStrC[id] = key
    } else if hcSeenIdStrC[id] != key {
      // Two spellings, one id — a false MERGE, the direction that fuses layouts.
      hcMergeBad = hcMergeBad + 1
      repShadowNoteRaw(
        "hc-merge canon id="
          + i32ToStr(id)
          + " a="
          + hcSeenIdStrC[id]
          + " b="
          + key,
      )
    }
    return 0
  }
  while hcSeenIdStrE.length <= id { hcSeenIdStrE.push("") }
  if hcSeenIdStrE[id] == "" {
    hcSeenIdStrE[id] = key
  } else if hcSeenIdStrE[id] != key {
    hcMergeBad = hcMergeBad + 1
    repShadowNoteRaw(
      "hc-merge "
        + which
        + " id="
        + i32ToStr(id)
        + " a="
        + hcSeenIdStrE[id]
        + " b="
        + key,
    )
    // `which`, not a hardcoded "elem": an mv false merge is the one direction that fuses
    // two map-value slots into one — the invalid wasm this layer exists to prevent — and
    // must not report as an elem merge, which would send the reader into the wrong walk.

  }
  0
}

function repShadowNoteRaw(msg: string) {
  if repShadowMsgs.length < 200 { repShadowMsgs.push(msg) }
  0
}

function repShadowCheckTy(ty: i32) {
  hcCheckKey("canon", repCanonKey(ty), repCanonId(ty))
  hcCheckKey("elem", repElemKey(ty), repElemId(ty))
  // The map-value leg: `repMvValKey` has no functional caller now (`mvSlotOfTyKArm`
  // compares ids), so this is where it earns its keep, as the shadow of the id that
  // now does the real work. Leaving mv out would make it the one key with no oracle
  // the moment it stops being load-bearing, which is exactly when drift stops being visible.
  hcCheckKey("mv", repMvValKey(ty), repMvValId(ty))
  const tix = repTreeOfTy(ty)
  repShadowTys = repShadowTys + 1
  const reason = repTreeUnsupReason(tix)
  if reason == "" {
    repShadowReal = repShadowReal + 1
  } else {
    repShadowBumpReason(reason)
  }
  // The FLAT derivation — not `repOfTy`, which RETURNS the tree's facts wherever the
  // flat side claims coverage, so comparing it would be a tautology.
  const d = repOfTyFlat(ty)
  if d.rdCovered == 0 { return 0 }
  const tk = repTreeVKind(tix)
  if tk != d.rdKind {
    repShadowNote(
      "kind",
      ty,
      "flat="
        + d.rdKind
        + " tree="
        + repTreeKindOf(tix)
        + "/"
        + repSigTokOfKind(tk),
    )
    // The kind is the root fact — the projections below assume it agrees.
    return 0
  }
  if repTreeNulOf(tix) != d.rdNul {
    repShadowNote(
      "nul",
      ty,
      "flat=" + i32ToStr(d.rdNul) + " tree=" + i32ToStr(repTreeNulOf(tix)),
    )
  }
  if repTreeListElemName(tix) != d.rdListElem {
    repShadowNote(
      "elem",
      ty,
      "flat=" + d.rdListElem + " tree=" + repTreeListElemName(tix),
    )
  }
  if repSigTokOfKind(tk) != d.rdSigTok {
    repShadowNote(
      "sigtok",
      ty,
      "flat=" + d.rdSigTok + " tree=" + repSigTokOfKind(tk),
    )
  }
  if d.rdSlot >= 0 {
    const ts = repTreeSlotOf(tix)
    if ts < 0 {
      repShadowNote("slot", ty, "flat=" + i32ToStr(d.rdSlot) + " tree=-1")
    } else if repStructSlotsTwin(d.rdSlot, ts) == 0 {
      repShadowNote(
        "slot",
        ty,
        "flat=" + i32ToStr(d.rdSlot) + " tree=" + i32ToStr(ts) + " (not twins)",
      )
    }
  }
  0
}

// The host-readable report surface (the `diagCount`/`diagMsgLen`/`diagMsgAt`
// accessor pattern — the compiler module is instantiated with no imports, so
// strings cross the boundary one code point at a time).
export function repShadowCount() { repShadowMsgs.length }

export function repShadowMsgLen(i: i32) { repShadowMsgs[i].length }

export function repShadowMsgAt(i: i32, j: i32) { repShadowMsgs[i][j] }

// Coverage tallies: 0 = arena types swept · 1 = fully-real trees (no `unsup`
// node anywhere). The difference is bucketed by `repShadowReason*` below.
export function repShadowStat(k: i32): i32 {
  if k == 0 { return repShadowTys }
  if k == 1 { return repShadowReal }
  // The identity↔spelling equivalence tallies (the rep-column rewrite's proof).
  if k == 2 { return hcChecked }
  if k == 3 { return hcMergeBad }
  if k == 4 { return hcSplitBad }
  if k == 5 { return hcLenBad }
  // The MEMO's tally, distinct from the three walk tallies above it: those compare a walk
  // against its string twin, this one compares a BANKED answer against a recomputation.
  if k == 6 { return hcMemoBad }
  0
}

export function repShadowReasonCount() { repShadowReasonNames.length }

export function repShadowReasonLen(i: i32) { repShadowReasonNames[i].length }

export function repShadowReasonAt(i: i32, j: i32) { repShadowReasonNames[i][j] }

export function repShadowReasonN(i: i32) { repShadowReasonCounts[i] }

// Whether a union member other than a function still holds a type parameter: such a union has
// no box tag until it is bound, while a function member is the closure whatever its parameter.
function unionHasOpenMember(members: i32[]): boolean {
  for m in members {
    if m >= 0 && m < T.tys.length && !(tyAt(m) is TyFunc) && tyHasTyVar(m) {
      return true
    }
  }
  false
}
