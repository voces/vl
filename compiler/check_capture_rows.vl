// `check_capture_rows.vl` — the tables behind "a call that may reassign a narrowed binding ends
// the narrowing" (D2390): the function bodies and statements being checked, the names a call
// retired and the reads refused after it, the emitter's retire banks, the captured-narrowing
// records and loss banks, the alias and sole-reference rows, and the memos the capture walks
// keep. The checker owns every step that reads the type arena or the scope chain; `crReset`
// clears the tables once per program.

import { arenaEditLogReset, i32ToStr, nodeToks } from "./ast"
import { crLostReset } from "./check_capture_loss"
import {
  crByRefAnyMemo,
  crByRefMemo,
  crNulledBuilt,
  crNulledKeys,
  crNulledSids,
  crwRoot,
} from "./check_capture_walks"

// Operator sites that dispatched to a closure field of the left operand, and every operator site
// that dispatched at all.
export let crOpOpaque: {[i32]: boolean} = Map()
export let crOpCall: {[i32]: boolean} = Map()

// Assignments that ended a path narrowing through another place that may name the same object.
// They settle like a call (`crPathCallRetire`), since the emitter cannot see the alias.
export let crAliasWr: {[i32]: boolean} = Map()
// Narrowings a hole body ended by a rule that holds at every pin, keyed `<ender>|<path key>`: a
// write to the place or a prefix of it, a variable-index write under it, or a call that writes
// the path through an argument or a free variable by name. An alias or cell-tag verdict is decided
// on types the hole does not have yet, so a read after it keeps master's behaviour (D3287).
export let npKillSure: {[string]: boolean} = Map()
// Enclosing functions' path slots such a write inside a nested function ends, with the depth of
// the function holding the write. They hold again when that body closes: its calls run the write.
export let crAliasNestSlots: i32[] = []
// Calls inside a nested body that ended an enclosing function's narrowing there (`crAliasNestSlots`).
export let crNestCallRet: {[i32]: boolean} = Map()
export let crAliasNestDepths: i32[] = []

// Bindings whose object no other place refers to: a `const` bound to a new object whose name is
// used only as a receiver (`x.f`, `x[i]`) in its root, with the scope depth of its declaration.
export let crSoleNames: string[] = []
export let crSoleDepths: i32[] = []
// Per record, the root still to grade it against (-1 once graded) and its declared type: a
// top-level record waits for the first write that asks about it.
export let crSoleRoots: i32[] = []
export let crSoleTys: i32[] = []
// The root `crValUseNames` describes, the names that root uses other than as a receiver, the
// receivers of its operator sites, and per receiver the props of its `x.p` sites a getter is
// named (D3760).
export let crValUseRoot = -2
export let crValUseNames: {[string]: boolean} = Map()
export let crValUseDyn: {[string]: boolean} = Map()
export let crValUseGetProps: {[string]: string[]} = Map()
// Per root walked (D3739): the arena epoch, logged-edit bump count and edit-log position of its
// walk, its banking-free names, and the sites `x.p` and `x[i]` whose receiver counts only where
// a getter or an operator may run there.
export let cvuSlotOf: {[i32]: i32} = Map()
export let cvuEpoch: i32[] = []
export let cvuBumps: i32[] = []
export let cvuLogAt: i32[] = []
export let cvuNames: {[string]: boolean}[] = []
export let cvuMemIx: i32[][] = []
export let cvuMemName: string[][] = []
export let cvuIdxIx: i32[][] = []
export let cvuIdxName: string[][] = []

// The names a function body reads at the declared type because `crCaptureLosesNarrowing` said so.
export let crCapLossBank: {[i32]: string[]} = Map()
export let crCapLossAny = false

// The function bodies being checked, innermost last: the scope depth each body starts at, since
// a narrowing below it belongs to an enclosing function, and the root its closures are read from.
export let crFnBases: i32[] = []
export let crFnRoots: i32[] = []
// Per function body, the overlay height and barrier count at its entry: a path slot or a loop
// below them belongs to an enclosing function.
export let crFnNpBases: i32[] = []
export let crFnReBases: i32[] = []
export let crFnIxs: i32[] = []
// Calls whose path retirement is banked for the emitter, for a monomorphization re-check.
export let crCallSettled: {[i32]: boolean} = Map()
export let crProgRoot = -1
// The statements being checked, innermost last, with the function depth each belongs to and
// where its pending and read rows start. A statement is the unit the emitter retires at, so it
// is the unit a read is refused in.
export let crStmtIxs: i32[] = []
export let crStmtFns: i32[] = []
export let crStmtPend: i32[] = []
export let crStmtRd: i32[] = []
// The scope count on entering each statement, so a scope depth names the statement holding it.
export let crStmtScopes: i32[] = []
// Names a call retired inside a statement still being checked, with the call and the narrowed
// type. A read later in that statement is refused.
export let crPendNames: string[] = []
export let crPendCalls: i32[] = []
export let crPendNarTys: i32[] = []
export let crPendDepths: i32[] = []
// Every retirement, for the note on a later misuse: the name, the call, the narrowed type, the
// type it reads at now, and the root it happened under.
export let crRetNames: string[] = []
export let crRetCalls: i32[] = []
export let crRetNarTys: i32[] = []
export let crRetWideTys: i32[] = []
export let crRetRoots: i32[] = []
export let crRetLoops: boolean[] = []
// Reads of a retired name in the statements still being checked: the row of the table above,
// and the reading identifier.
export let crRdRet: i32[] = []
export let crRdIx: i32[] = []
// Per `&&`/`||` node, the left operand's facts its right operand retired (`crNoteRhsRetired`).
export let crRhsRetired: {[i32]: string[]} = Map()
// What retired each: the `&&`/`||` node, the name, and the write or call that ended it.
export let crRhsOps: i32[] = []
export let crRhsNames: string[] = []
export let crRhsBys: i32[] = []
// Per nested function, the captured names `crCaptureWiden` widened.
export let crCapWidenBank: {[i32]: string[]} = Map()
// Per body, the names `crEscWalk` found escaping it, for this check.
export let crEscNames: {[i32]: {[i32]: boolean}} = Map()
// How many live records `crCapRec*` hold per handle, so a call of any other name skips the scan.
export let crCapRecCount: {[i32]: i32} = Map()
// Nested functions that kept a captured narrowing, called only by handle in the body making them:
// that body's function depth, the handle, the name and its slot, the type captured, and the function.
export let crCapRecDepths: i32[] = []
export let crCapRecHandles: i32[] = []
export let crCapRecNames: string[] = []
export let crCapRecSlots: i32[] = []
export let crCapRecTys: i32[] = []
export let crCapRecFns: i32[] = []
// Per root, then per binding key: 0 when no closure writes the binding, 1 when every function
// that can reach a writer is only ever called by name, 2 when one escaped. The keys of the
// bindings such calls name ride beside.
export let crInfoMemo: {[i32]: {[i32]: i32}} = Map()
export let crHandleMemo: {[i32]: {[i32]: i32[]}} = Map()
// While armed, each name a whole-program question asked about, once per kind: `w` who
// writes it, `e` where it is used as a value, `o` the order of the top-level statements.
export let crAskOn = false
export let crAskKeys: string[] = []
let crAskSeen: {[string]: boolean} = Map()
// While armed and not held, each write question asked, once: the token of the asker (-1 for none),
// the kind (`CR_ASK_*`), the declaration node, the parameter. The asker is the declaration whose
// summary is being computed, else the statement being checked.
export let crAskQs: i32[] = []
let crAskQSeen: {[string]: boolean} = Map()
let crAskHeld = false
// The top-level statement a question asked before that statement is entered belongs to, or -1.
let crAskFor = -1
// The declarations whose summaries are being computed, innermost last.
const crAskOpen: i32[] = []

export function crAskForSet(s: i32) {
  crAskFor = s
  0
}

export function crAskPush(d: i32) {
  crAskOpen.push(d)
  0
}

export function crAskPop() {
  crAskOpen.pop()
  0
}
export const CR_ASK_EFFECTS = 0
export const CR_ASK_FREE = 1
export const CR_ASK_SHAPES = 2
export const CR_ASK_ONLY_CALLED = 3

export function crAskArm(on: boolean) {
  crAskOn = on
  crAskKeys = []
  crAskSeen = Map()
  crAskQs = []
  crAskQSeen = Map()
  crAskUses = Map()
  0
}

// While armed and not held, what a narrowing tested a write summary against (`crAskUseShape`,
// `crAskUsePath`): a banked answer keeps only the parts one of these could hit.
export let crAskUses: {[string]: boolean} = Map()

export function crAskUse(u: string) {
  if crAskOn && !crAskHeld { crAskUses[u] = true }
  0
}

// Stop (true) or resume recording, while the driver re-asks banked questions itself.
export function crAskHold(on: boolean) {
  crAskHeld = on
  0
}

// Record a question about declaration `fnIx`, from the innermost open summary or statement.
export function crAskDecl(kind: i32, fnIx: i32, p: i32) {
  if !crAskOn || crAskHeld { return 0 }
  let s = crAskFor
  const n = crStmtIxs.length
  if n > 0 { s = crStmtIxs[n - 1] }
  const o = crAskOpen.length
  if o > 0 { s = crAskOpen[o - 1] }
  let at = -1
  if s >= 0 && s < nodeToks.length { at = nodeToks[s] }
  const k = i32ToStr(at)
    + ","
    + i32ToStr(kind)
    + ","
    + i32ToStr(fnIx)
    + ","
    + i32ToStr(p)
  if crAskQSeen.has(k) { return 0 }
  crAskQSeen[k] = true
  crAskQs.push(at)
  crAskQs.push(kind)
  crAskQs.push(fnIx)
  crAskQs.push(p)
  0
}

export function crAskProg(kind: string, name: string) {
  if !crAskOn { return 0 }
  const k = kind + name
  if crAskSeen.has(k) { return 0 }
  crAskSeen[k] = true
  crAskKeys.push(k)
  0
}

export function crReset() {
  crFnBases = []
  crFnRoots = []
  crFnNpBases = []
  crFnReBases = []
  crFnIxs = []
  crCallSettled = Map()
  crProgRoot = -1
  crStmtIxs = []
  crStmtFns = []
  crStmtPend = []
  crStmtRd = []
  crStmtScopes = []
  crPendNames = []
  crPendCalls = []
  crPendNarTys = []
  crPendDepths = []
  crRetNames = []
  crRetCalls = []
  crRetNarTys = []
  crRetWideTys = []
  crRetRoots = []
  crRetLoops = []
  crRdRet = []
  crRdIx = []
  crRhsRetired = Map()
  crRhsOps = []
  crRhsNames = []
  crRhsBys = []
  crCapWidenBank = Map()
  crEscNames = Map()
  crLostReset()
  crCapLossBank = Map()
  crCapLossAny = false
  crWideNames = []
  crWideDepths = []
  crWideSlots = []
  crCapRecCount = Map()
  crCapRecDepths = []
  crCapRecHandles = []
  crCapRecNames = []
  crCapRecSlots = []
  crCapRecTys = []
  crCapRecFns = []
  crwRoot = -2
  crInfoMemo = Map()
  crAsgMemo = Map()
  crByRefMemo = Map()
  crByRefAnyMemo = Map()
  crReadMemo = Map()
  crReadLists = Map()
  crNulledKeys = Map()
  crNulledSids = Map()
  crNulledBuilt = false
  crHandleMemo = Map()
  crOpOpaque = Map()
  crOpCall = Map()
  crAliasWr = Map()
  npKillSure = Map()
  crAliasNestSlots = []
  crNestCallRet = Map()
  crAliasNestDepths = []
  crSoleNames = []
  crSoleDepths = []
  crSoleRoots = []
  crSoleTys = []
  crValUseRoot = -2
  crValUseNames = Map()
  crValUseDyn = Map()
  crValUseGetProps = Map()
  cvuSlotOf = Map()
  cvuEpoch = []
  cvuBumps = []
  cvuLogAt = []
  arenaEditLogReset()
  cvuNames = []
  cvuMemIx = []
  cvuMemName = []
  cvuIdxIx = []
  cvuIdxName = []
  0
}

// Each `crDeclareWidened` layer: the name it spells, its frame depth, and the slot it re-binds.
export let crWideNames: string[] = []
export let crWideDepths: i32[] = []
export let crWideSlots: i32[] = []

// `crNameAssignedInRoot` per root, then per binding key: asked once per capture, it would
// otherwise rebuild the writer analysis each time the question moves between a function and the
// module.
export let crAsgMemo: {[i32]: {[i32]: boolean}} = Map()

export let crReadMemo: {[string]: boolean} = Map()
export let crReadLists: {[i32]: i32[]} = Map()
