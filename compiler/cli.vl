// ── `vl` CLI — the brain in VL (docs/cli-design.md) ──────────────────────────
// The command-queue half of the CLI. The host (`scripts/vl-host`) is a thin pump: it
// calls `cliNext()` until it returns `CMD_DONE`, services the one raw I/O command each
// step asks for, commits the result back, and loops. All policy lives here — arg
// parsing, running the checker in-module, diagnostic formatting, severity gating, the
// exit code — so it survives the host's planned shrink to a WASI shim, each command
// mapping 1:1 onto a WASI call. The linker stays empty: this is a state machine over
// the globals below, identical in shape to the module-fetch loop.
//
// `cli.vl` is joined into the compiled compiler, so it calls the lexer, parser,
// checker and lint and the driver's diagnostic accessors directly — no second copy of
// the compiler, and no ABI marshalling inside the module.

// The command codes `cliNext` returns to the host pump (`docs/cli-design.md`).
const CMD_DONE = 0
const CMD_LIST_DIR = 1
const CMD_READ_FILE = 2
const CMD_WRITE_FILE = 3
const CMD_PRINT_OUT = 4
const CMD_PRINT_ERR = 5
const CMD_READ_STDIN = 6
// `vl test` (docs/internals/vl-test-design.md). Wasm execution is the one thing a VL
// program cannot do for itself — instances, threads and trap catching are the
// engine's, and the engine lives in the host — so the runner's policy (discovery, the
// plan, the report, the exit code) stays here and three raw mechanisms cross to Rust.
const CMD_TEST_STASH = 7   // keep the module now in rbyte* as test file `cliCmdPath`
const CMD_TEST_COLLECT = 8 // instantiate every stashed module; report its registry
const CMD_TEST_RUN = 9     // run the pushed plan (in parallel); report each result
// `vl check --codegen`. The wasm validator lives in the engine, and the engine is the
// host's, so "did the emitter produce a module?" is the second thing this brain cannot
// decide for itself: the emitter returning 0 is not the same claim, and the gap between
// them is the check-clean-invalid-wasm class. The bytes are already in `rbyte*`.
const CMD_VALIDATE = 10 // validate the module now in rbyte* as file `cliCmdPath`; report engine verdict
// `vl test`'s compile pool. Each file's compile is one compiler instance's whole state,
// so compiling files concurrently needs more instances, and instances are the host's.
// The brain names the files; each pool worker is a fresh instance running this same
// state machine in compile-one mode (`cliTestPoolMode == 2`).
const CMD_TEST_ENQUEUE = 11 // queue test file `cliCmdPath` for the compile pool
const CMD_TEST_COMPILE = 12 // compile every queued file; commit each outcome in order
// `vl check`'s root pool. A root's report is its whole graph checked with it as the
// entry, so two roots share no result; they run in fresh instances instead, each one
// this machine in check-one mode (`cliCheckPoolMode == 2`).
const CMD_CHECK_ENQUEUE = 13   // queue check root `cliCmdPath` for the root pool
const CMD_CHECK_POOL = 14      // check every queued root; commit each outcome in order
const CMD_CHECK_ROOT_DONE = 15 // worker: root `cliCheckPick` is done (`cliExit`, `cliCmdData`)

// The process exit codes (`docs/internals/cli-design.md` §Exit codes). The host reports
// the same table, and `tests/cli_host_tables_test.ts` holds the two equal.
type CliExit = 0 | 1 | 2 | 3 | 70
const EXIT_OK = 0
const EXIT_FAILED = 1        // the program, its check or a gate failed
const EXIT_USAGE = 2         // an unusable command line or an unreadable input
const EXIT_FMT_BUG = 3       // `vl fmt`: the formatted output failed to re-parse
const EXIT_COMPILER_BUG = 70 // the compiler crashed, or emitted a module the engine refused

// The state-machine states (cliState). `*_RECV` states resume after the host has
// committed the result of the command the previous `cliNext` returned.
const ST_INIT = 0             // parse argv, classify the target
const ST_CLASSIFY = 1         // got the LIST_DIR result for the target (dir vs file)
const ST_WALK = 2             // got a LIST_DIR result for a pending directory
const ST_PRINT = 3            // draining cliOut to stderr
const ST_CHECK_READ = 4       // got a check file's source
const ST_CHECK_FETCH = 5      // got a pending module's source
const ST_DONE = 6             // finished
const ST_FMT_STDIN = 7        // got stdin for `fmt`
const ST_FMT_READ = 8         // got a fmt file's source
const ST_FMT_AFTER = 9        // a fmt write/print was serviced; advance
const ST_FIX_WROTE = 10       // a `check --fix` write was serviced; run the check
const ST_TEST_READ = 11       // got a test file's source
const ST_TEST_FETCH = 12      // got a test file dependency's source
const ST_TEST_STASH = 13      // the host stashed the compiled test module
const ST_TEST_COLLECT = 14    // the host reported every stashed file's registry
const ST_TEST_RUN = 15        // the host reported every planned test's result
const ST_CHECK_VALIDATE = 16  // the host validated this file's emitted module
const ST_TEST_ENQUEUED = 17   // the host queued one file for the compile pool
const ST_TEST_POOLED = 18     // the host committed every queued file's compile outcome
const ST_SIB_LIST = 19        // got the listing of the checked file's own directory
const ST_SIB_READ = 20        // got a file outside the module graph, read for its exports
const ST_VALIDATE_READ = 21   // got a named file's source while checking every path exists
const ST_BUDGET_READ = 22     // got the `--budget` baseline's source
const ST_BUDGET_GIT = 23      // got one file of `.git`, resolving HEAD for `--write-baseline`
const ST_BUDGET_WROTE = 24    // the `--write-baseline` write was serviced
const ST_BUDGET_FINDINGS = 25 // got the `--findings` report's source
const ST_CHECK_ENQUEUED = 26  // the host queued one root for the root pool
const ST_CHECK_POOLED = 27    // the host committed every queued root's outcome
const ST_CHECK_NEXT = 28      // a worker awaits its next root (`cliCheckNextRoot`)
const ST_WI_READ = 29         // got a root's source, read for its imports before the pool

// ── protocol state ────────────────────────────────────────────────────────────
let cliArgs: string[] = []      // committed argv (cliArgs[0] = the subcommand)
let cliArgAcc: i32[] = []       // the in-flight argument's code points
let cliState = 0                // see the ST_* constants above
let cliCmdPath = ""             // path payload of the current command
let cliCmdData = ""             // data payload of the current command (a print line)
const cliResultAcc = cpAccNew() // the host pushes a file's contents here
let cliFileSrc = ""             // last committed file contents
let cliFileFound = 0            // 1 = the host read the file, 0 = missing
let cliExit: CliExit = EXIT_OK  // the process exit code, read after CMD_DONE
// A `--codegen` file whose emitted module the engine refused. `vl check` said rc 0 to
// reach the emitter, so an invalid module is the compiler's fault by construction and
// exits 70 (EX_SOFTWARE, the code `report` uses for a compiler trap) rather than 1: a
// caller can tell a vl bug from a bad program without parsing stderr (D1578).
let cliInvalidModule = 0
// Whether the file currently being checked is the one that set it — the per-file half
// of `cliInvalidModule`, which a `--batch` record reports as its own exit 70.
let cliFileInvalid = 0

// ── parsed `check` configuration ───────────────────────────────────────────────
let cliFile = ""
let cliConcise = 0
let cliCodegen = 0
let cliNoValidate = 0          // --no-validate: emit under --codegen, skip the engine check
let cliValidateMsg = ""        // the engine's rejection for the current file ("" = valid)
let cliJson = 0
let cliColor = 0
let cliSeverity = "error"
let cliSeverityGiven = 0
let cliBatch = 0               // --batch: many paths, one verdict record per file
let cliExcludes: string[] = [] // --exclude glob patterns (normalized)
let cliIncludeStd = 0          // --include-std: report std's own warnings too
let cliIncludeImports = 0      // --include-imports: report imported modules' warnings too
let cliArgErr = ""             // a fatal arg-parse message (printed, exit 2)
let cliBudget = 0              // 1 = --budget, 2 = --budget-why, 3 = + --write-baseline, 4 = + --exempt-codes
let cliBudgetPath = ""         // that baseline's path
let cliBudgetFindings = ""     // `--findings`: a `check --json` report counted instead of a walk
let cliBudgetAct = 0           // 3 = --write-baseline, 4 = --exempt-codes, until parsed

// ── work + output ──────────────────────────────────────────────────────────────
let cliEntrySrc = ""      // the entry file's source
let cliModMode = 0        // 1 = drive the module fetch loop
let cliFetchKey = ""      // the module key currently being read
let cliOut: string[] = [] // the stderr lines to emit, in order
let cliOutIdx = 0
// --json: the accumulated diagnostic objects (one JSON text per diagnostic,
// across every file checked) and the pending stdout payload — the single JSON
// array cliBeginPrint emits before draining cliOut ("" = nothing pending).
let cliJsonItems: string[] = []
let cliJsonOut = ""
// `--batch --json`: one finished record per input file, drained to stdout ahead of the
// stderr notes. A list rather than one joined payload, so a corpus-sized batch crosses
// the host boundary a record at a time instead of as a single multi-megabyte string.
let cliBatchOut: string[] = []
let cliBatchIdx = 0
// A `--batch` entry the host could not read. Its record carries exit 2 (the code a
// single `vl check <missing>` carries) and so does the run.
let cliBatchUnread = 0

// ── directory walk + multi-file run (A-impl 2) ──────────────────────────────────
// The paths named on the command line, in argv order. Exactly one without `--batch`;
// each is classified (file vs directory) and expanded in turn, so a batch record's
// order is argv order with each directory's own files sorted inside it.
let cliTargets: string[] = []
let cliTargetIdx = 0
let cliValIdx = 0               // cursor of the all-paths-exist pass (`cliValidateNext`)
let cliTargetFileBase = 0       // where the current target's slice of cliFiles begins
let cliDirMode = 0              // 1 = the file being checked came from a directory walk (file-count noun, no per-stage note)
let cliWalkStack: string[] = [] // directories still to list (DFS work-stack, full paths)
let cliWalkRel: string[] = []   // parallel: each pending dir's path RELATIVE to the check root
let cliFiles: string[] = []     // collected `.vl` paths — the check work-list
// Parallel to cliFiles: 1 for a path a directory walk found, 0 for one the caller
// NAMED. It is what `cliDirMode` reads per file, so a `--batch` file target is graded
// exactly as `vl check <file>` alone grades it — same lint scope, same report.
let cliFileFromDir: i32[] = []
let cliFileKeys: {[string]: i32} = Map() // `cliPathKey` of every queued path
let cliFileIdx = 0                       // cursor into cliFiles for the per-file loop
let cliCurFile = ""                      // the file currently being checked (its path)
let cliCurDir = ""                       // the directory currently being listed (child-path base)
let cliCurRel = ""                       // the directory currently being listed, relative to the root
let cliLastStage = ""                    // failing stage of the LAST file compiled (single-file note)
// Running tally across every file checked.
let cliErrors = 0
let cliWarnings = 0
let cliGating = 0
// Count of std diagnostics `--include-std` reveals; the summary names it so nothing
// is dropped in silence (D1601).
let cliStdHidden = 0
let cliStdHiddenWarn = 0
// The same count for the target's non-std imports, which `--include-imports` reveals.
let cliImpHidden = 0
let cliImpHiddenWarn = 0
// fmt mode (A-impl 3): the walk + file collection are shared with `check`; only
// the per-file action and the finish differ.
let cliCmd = 0         // subcommand: 0 = check, 1 = fmt
let cliFmtWrite = 0    // -w / --write (rewrite in place)
let cliFmtCheck = 0    // --check (CI gate: nonzero exit on any drift)
let cliFmtDrift = 0    // count of not-already-formatted files (--check)
let cliFmtResult = ""  // the formatted source of the current file
let cliFmtBad = 0      // count of files whose INPUT did not parse (exit 2)
let cliFmtBug = 0      // count of round-trip gate trips — formatter bug (exit 3)
let cliFix = 0         // check --fix: apply the safe lint fixes in place
let cliFixCount = 0    // total safe fixes applied across the run
let cliFixDeclined = 0 // total edits VERIFY-AND-REVERT threw away across the run
let cliLintGraphed = 0 // 1 = the current file's lint ran module-aware (lintGraph)
let cliFileFixed = 0   // 1 once the current file's fixing is finished — so
// the module-aware re-check (for the report) does not re-fix. Reset per file in
// `cliStartFile`.

// `--fix` runs in rounds: each re-checks the source the last one wrote, since a fix
// can expose another (a removed annotation orphans the import that named its type).
// It stops at the first round that applies nothing, or at the cap.
const FIX_ROUND_CAP = 10
let cliFixRound = 0            // rounds applied to the current file
let cliFixRoundsMax = 0        // the most rounds any file of the run took
let cliFixCapHit = 0           // files that reached the cap with fixes still pending
let cliFixKinds: string[] = [] // per-kind tally of the applied fixes, for the summary
let cliFixKindN: i32[] = []

// ── files outside the module graph ───────────────────────────────────────────

// An undeclared name no graph module exports may be exported by a file the program does not
// import yet. Once per file with such a miss, the CLI reads the candidates — the directory
// walk's files, or the checked file's own directory — and re-checks with their exports
// offered as imports, so the diagnostic and `--fix` can name the module.
let cliSibTried = 0
let cliSibQueue: string[] = []
let cliSibQEnd = 0                         // `cliSibQueue[0 .. cliSibQEnd)` is still to read, last first
let cliSibScanned: {[string]: i32} = Map() // candidate paths already scanned this run
let cliSibExpKey: string[] = []            // one row per export: the file's path
let cliSibExpName: string[] = []           // and the exported name
let cliSibSkipped: string[] = []           // candidates that do not lex, named once in the summary

// ── verify-and-revert (D1091) ────────────────────────────────────────────────

// An autofix must never ship a program that stops working, so every candidate rewrite
// is compiled (emit plus engine validation, not just `check`) before it reaches the
// disk, and an edit that breaks a file that built is dropped. The phases run inside
// the per-file check loop, so a trial costs one compile and no host read.
const FIXP_OFF = 0   // not verifying: the report path
const FIXP_ALL = 1   // trial = every computed edit at once (the fast path)
const FIXP_BASE = 2  // trial = the ORIGINAL source (did it build before?)
const FIXP_ONE = 3   // trial = the accepted set plus edit `cliFixTrial`
let cliFixPhase = 0
let cliFixTrial = 0  // index under trial in FIXP_ONE
let cliFixOrig = ""  // the file's source before any edit
let cliFixPassRc = 0 // compileSrc's rc for the trial just run
// One row per auto-fix edit: `len` code units at `pos` become `txt`; `what` is the lint or
// hint it came from, and `line`/`col` place it for the report.
type CliFixEditCols = {
  pos: i32[],
  len: i32[],
  txt: string[],
  what: string[],
  line: i32[],
  col: i32[],
}
const cliFixEdit: CliFixEditCols = {
  pos: [],
  len: [],
  txt: [],
  what: [],
  line: [],
  col: [],
}
let cliFixKeep: i32[] = [] // 1 = this edit is in the current candidate
// A 1-based line, a 0-based column and a text, one row per site.
type CliSiteCols = { line: i32[], col: i32[], text: string[] }
// One row per edit verify-and-revert declined, with the fix's name as the text, drained into
// an `info` diagnostic by the report pass. A declined edit is a site where the finding that
// offered it is wrong, and a count alone cannot be worked on (D1091).
const cliFixDecl: CliSiteCols = { line: [], col: [], text: [] }
// The imports this file's own errors ask for, one exporter each (`cliNoteImportFix`): the
// specifier text to add, the module to add it to, and whether a method call asked for it.
type CliImpAskCols = { item: string[], spec: string[], method: boolean[] }
const cliImpAsk: CliImpAskCols = { item: [], spec: [], method: [] }
let cliImpClash: string[] = []
// A source span per row: 1-based start line and column, then end line and exclusive end column.
type CliSpanCols = { line: i32[], col: i32[], endLine: i32[], endCol: i32[] }
// The spans of this file's `filled(n, 0)` calls refused into a `u8[]` (`cliNoteZeroBytesFix`).
const cliZb: CliSpanCols = { line: [], col: [], endLine: [], endCol: [] }
// The spans this file's fixes shorten to a prefix (`cliNoteCastFix`, `cliNoteStrictEqFix`), as
// `CliSpanCols`: how many characters from each span's start the fix keeps, and the fix's name.
type CliCutCols = {
  line: i32[],
  col: i32[],
  endLine: i32[],
  endCol: i32[],
  keep: i32[],
  what: string[],
}
const cliRc: CliCutCols = {
  line: [],
  col: [],
  endLine: [],
  endCol: [],
  keep: [],
  what: [],
}
// The annotations to insert after a binding's name, from refusals of a concrete function written
// to a generic `let` (`cliNoteGenBindFix`), with the type as the text.
const cliGb: CliSiteCols = { line: [], col: [], text: [] }
// The parameter names to write before positional arguments that follow a misplaced named one
// (`cliNoteNamedOrderFix`), with the name as the text.
const cliNo: CliSiteCols = { line: [], col: [], text: [] }
// ── `vl test` (cliCmd == 2) ────────────────────────────────────────────────────
// Flags.
let cliTestFilter = "" // -t <substring>: keep tests whose scope-path contains it
let cliTestJobs = 0    // --jobs N (0 = let the host pick, one worker per core)
// Staged by the host after argv: 0 = no compile pool (compile in this instance),
// 1 = the host compiles queued files in parallel, 2 = this instance IS a pool worker.
let cliTestPoolMode = 0
let cliTestUnreadable = "" // the pool's "cannot read <named file>" report, when one came back
let cliTestEnqIdx = 0 // the next cliFiles index to hand the pool
// `vl check`'s root pool, staged like the test pool's: 0 = none, 1 = the host checks
// queued roots in parallel, 2 = this instance is a worker checking root `cliCheckPick`.
let cliCheckPoolMode = 0
let cliCheckPick = -1
let cliCheckEnqIdx = 0
// A worker's copy of the parent's walk (paths and `cliFileFromDir`), so it never re-walks.
let cliPresetFiles: string[] = []
let cliPresetFromDir: i32[] = []
// Per root (parallel to `cliFiles`) once the pool has run: 0 = `cliPoolPayload` holds
// the root's whole contribution to the report, 1 = this instance checks it itself.
let cliPoolStatus: i32[] = []
let cliPoolPayload: string[] = []
// A worker's report baselines (what its own walk left), and its `--budget` notes as
// five fields each, replayed by the parent through `budgetNote` in root order.
let cliPwBase: i32[] = []
let cliPwNotes: string[] = []
let cliPpSrc = "" // the payload being applied, and the read cursor into it
let cliPpPos = 0
// Per collected file (parallel to `cliFiles`): the compile error text, "" when the
// file compiled. A file that fails to compile is one failing entry in the report and
// does not stop the run.
let cliTestFileErr: string[] = []
// The files whose modules the host holds, in stash order. Not every entry of
// cliFiles is here (a compile failure stashes nothing), so this is the index space
// the collect/run protocol speaks in; cliTestStashOf maps back to cliFiles.
let cliTestStash: string[] = []
let cliTestStashOf: i32[] = []
// Per stashed file, from `CMD_TEST_COLLECT`: 0 = instantiated and its registry read,
// 1 = instantiation failed (the file's top level trapped), message in `...Msg`.
let cliTestFileStatus: i32[] = []
let cliTestFileMsg: string[] = []
// The collected registry, flattened across files (parallel arrays).
let cliTestOwner: i32[] = [] // stash index
let cliTestLocal: i32[] = [] // the test's index WITHIN its file (what vltRun takes)
let cliTestName: string[] = []
let cliTestSkip: i32[] = []
// The plan: the entries selected to run, in report order. Read by the host.
let cliPlanEntry: i32[] = [] // index into the cliTest* registry
// Per plan entry, from CMD_TEST_RUN: 0 = passed, 1 = failed, 2 = skipped.
let cliResStatus: i32[] = []
let cliResMsg: string[] = []
let cliResOut: string[] = []
// In-flight accumulators the host pushes into.
let cliTestNameAcc: i32[] = []
let cliTestOutAcc: i32[] = []
// The index within the file currently being collected — what `vltRun(i)` takes.
let cliTestLocalNext = 0
// Tallies for the summary line.
let cliTestPassed = 0
let cliTestFailed = 0
let cliTestSkipped = 0

// One committed directory listing (parallel arrays), refilled per CMD_LIST_DIR.
let cliDirNames: string[] = []
let cliDirIsDirs: i32[] = []
let cliDirNameAcc: i32[] = []
let cliDirWasDir = 0 // 1 if the last CMD_LIST_DIR target was a directory

// The reported diagnostics, as parallel arrays (the compiler's own idiom): severity,
// 1-based line (0 = positionless), 0-based col, the 1-based line the span ends on and its
// 0-based end column on THAT line, message. One entry per index.
let dgSev: string[] = []
let dgLine: i32[] = []
let dgCol: i32[] = []
let dgEndLine: i32[] = []
let dgEnd: i32[] = []
let dgMsg: string[] = []
// The table index of the module that owns each diagnostic (parallel to the arrays
// above), so a graph-compile error in an imported module is labelled — and its caret
// context drawn — against that file, not the entry. 0 = the entry, a positionless
// diagnostic, or single-file mode.
let dgMod: i32[] = []
// The diagnostic's stable code (parallel): the lint rule id, or "redundant-type" for
// the annotation hint; "" for a compile error, which carries none and whose field
// `--json` omits. No `data` column deliberately: a compile diagnostic's structured
// payload is the quick-fix's answer for an editor, and no batch reporter edits.
let dgCode: string[] = []
// The stage that produced each diagnostic (parallel), as `--json`'s `stage`: the
// driver's four (`diagStage`) plus this file's `validate`, `lint`, `fix` and `read`.
// It is what classifies a refusal, since the summary's `(type error)` note is per FILE.
// The set and each value's meaning: `docs/internals/cli-design.md`.
let dgStage: string[] = []
// The committed modules' keys and sources, in commit order, so the index matches the
// driver's module-table index (what `diagModule` / `modOfTok` return) — the per-module
// file label and caret-context source for a graph-compile diagnostic. Reset and filled
// by the module fetch loop.
let cliModKeys: string[] = []
let cliModSrcs: string[] = []
// Memo for `cliDiagSrcLines`: the last module whose source this split into lines. A
// file's diagnostics cluster, so this avoids re-splitting per diagnostic.
let cliDiagLineCacheMod = -1
let cliDiagLineCache: string[] = []
let cliSrcLines: string[] = []
// ── per-run module source cache ──────────────────────────────────────────────

// A directory check runs the module fetch loop once per file, and a shared dependency
// is imported by many dependents, so without a cache it is re-read and re-pushed
// across the host boundary once per dependent. Keyed on the module key; `found = 0`
// is cached too, and the cache spans `modReset()` because a run's tree is stable.
let cliSrcCacheKeys: string[] = []
let cliSrcCacheSrcs: string[] = []
let cliSrcCacheFound: i32[] = []
// Each key's slot in the three arrays above.
let cliSrcCacheIx: {[string]: i32} = Map()
function cliSrcCacheGet(key: string): i32 { cliSrcCacheIx[key] ?? -1 }
function cliSrcCachePut(key: string, src: string, found: i32) {
  const i = cliSrcCacheGet(key)
  if i >= 0 {
    cliSrcCacheSrcs[i] = src
    cliSrcCacheFound[i] = found
    return 0
  }
  cliSrcCacheIx[key] = cliSrcCacheKeys.length
  cliSrcCacheKeys.push(key)
  cliSrcCacheSrcs.push(src)
  cliSrcCacheFound.push(found)
  0
}

// ── argv intake (host pushes each arg before the run loop) ───────────────────

// The complete instance reset: every CLI global above returns to its declared state,
// so a reused compiler instance starts each run clean. A partial reset is a latent
// desync — `dgMod` surviving while its parallel siblings clear, or a prior run's
// `--exclude` patterns still filtering.
export function cliArgReset() {
  cliArgs = []
  cliArgAcc = []
  cliState = ST_INIT
  cliCmdPath = ""
  cliCmdData = ""
  cpAccReset(cliResultAcc)
  cliFileSrc = ""
  cliFileFound = 0
  cliExit = EXIT_OK
  cliInvalidModule = 0
  cliFileInvalid = 0
  cliFile = ""
  cliConcise = 0
  cliCodegen = 0
  cliNoValidate = 0
  cliValidateMsg = ""
  cliJson = 0
  cliColor = 0
  cliSeverity = "error"
  cliSeverityGiven = 0
  cliExcludes = []
  cliIncludeStd = 0
  cliIncludeImports = 0
  cliArgErr = ""
  cliEntrySrc = ""
  cliModMode = 0
  cliFetchKey = ""
  cliOut = []
  cliOutIdx = 0
  cliJsonItems = []
  cliJsonOut = ""
  cliBatchOut = []
  cliBatchIdx = 0
  cliBatchUnread = 0
  cliBatch = 0
  cliTargets = []
  cliTargetIdx = 0
  cliValIdx = 0
  cliTargetFileBase = 0
  cliDirMode = 0
  cliWalkStack = []
  cliWalkRel = []
  cliFiles = []
  cliFileKeys = Map()
  cliFileFromDir = []
  cliFileIdx = 0
  cliCurFile = ""
  cliCurDir = ""
  cliCurRel = ""
  cliLastStage = ""
  cliErrors = 0
  cliWarnings = 0
  cliGating = 0
  cliStdHidden = 0
  cliStdHiddenWarn = 0
  cliImpHidden = 0
  cliImpHiddenWarn = 0
  cliCmd = 0
  cliFmtWrite = 0
  cliFmtCheck = 0
  cliFmtDrift = 0
  cliFmtResult = ""
  cliFix = 0
  cliFixCount = 0
  cliFixDeclined = 0
  cliLintGraphed = 0
  cliFileFixed = 0
  cliFixRound = 0
  cliFixRoundsMax = 0
  cliFixCapHit = 0
  cliFixKinds = []
  cliFixKindN = []
  cliFixPhase = FIXP_OFF
  cliFixTrial = 0
  cliFixOrig = ""
  cliFixPassRc = 0
  cliFixEditClear()
  cliFixKeep = []
  cliSitesClear(cliFixDecl)
  cliDirNames = []
  cliDirIsDirs = []
  cliDirNameAcc = []
  cliDirWasDir = 0
  cliTestFilter = ""
  cliTestJobs = 0
  cliTestPoolMode = 0
  cliTestUnreadable = ""
  cliTestEnqIdx = 0
  cliCheckPoolMode = 0
  cliCheckPick = -1
  cliCheckEnqIdx = 0
  cliPresetFiles = []
  cliPresetFromDir = []
  cliPoolStatus = []
  cliPoolPayload = []
  cliPwBase = []
  cliPwNotes = []
  cliTestFileErr = []
  cliTestStash = []
  cliTestStashOf = []
  cliTestFileStatus = []
  cliTestFileMsg = []
  cliTestOwner = []
  cliTestLocal = []
  cliTestName = []
  cliTestSkip = []
  cliPlanEntry = []
  cliResStatus = []
  cliResMsg = []
  cliResOut = []
  cliTestNameAcc = []
  cliTestOutAcc = []
  cliTestLocalNext = 0
  cliTestPassed = 0
  cliTestFailed = 0
  cliTestSkipped = 0
  dgSev = []
  dgLine = []
  dgCol = []
  dgEndLine = []
  dgEnd = []
  dgMsg = []
  dgMod = []
  dgCode = []
  cliModKeys = []
  cliModSrcs = []
  cliDiagLineCacheMod = -1
  cliDiagLineCache = []
  cliSrcLines = []
  cliSibTried = 0
  cliSibQueue = []
  cliSibQEnd = 0
  cliSibScanned = Map()
  cliSibExpKey = []
  cliSibExpName = []
  cliSibSkipped = []
  mimpExtraSet([], [])
  0
}
export function cliArgPush(c: i32) {
  cliArgAcc.push(c)
  0
}
export function cliArgCommit() {
  cliArgs.push(fromCodePoints(cliArgAcc))
  cliArgAcc = []
  0
}

// ── current-command payload accessors (valid until the next cliNext) ───────────
export function cliCmdPathLen() { cliCmdPath.length }
export function cliCmdPathAt(j: i32) { cliCmdPath[j] }
export function cliCmdDataLen() { cliCmdData.length }
export function cliCmdDataAt(j: i32) { cliCmdData[j] }
// The bulk twin of `cliCmdDataAt` — the `<name>Store(off, count)` half of the host's
// out ABI (protocol and staging window: `driver.rbyteStore`'s header). Writes
// `written` = min(count, cliCmdDataLen() - off) bytes, packed four per i32 word
// little-endian, into `ioMem[0 .. written)` and returns `written`.
export function cliCmdDataStore(off: i32, count: i32): i32 {
  const avail = cliCmdData.length - off
  let n = count
  if n > avail { n = avail }
  if n < 0 { n = 0 }
  let i = 0
  while i + 4 <= n {
    const c0 = cliCmdData[off + i]
    const c1 = cliCmdData[off + i + 1]
    const c2 = cliCmdData[off + i + 2]
    const c3 = cliCmdData[off + i + 3]
    __store_i32__(i, c0 | (c1 << 8) | (c2 << 16) | (c3 << 24))
    i = i + 4
  }
  if i < n {
    let w = 0
    let k = n - 1
    while k >= i {
      w = (w << 8) | cliCmdData[off + k]
      k = k - 1
    }
    __store_i32__(i, w)
  }
  n
}

// ── result intake (host commits the serviced command's result) ─────────────────
export function cliResultPush(c: i32) {
  cpAccPush(cliResultAcc, c)
  0
}
// The bulk twin of `cliResultPush` — the `<name>Load(count)` half of the host's
// `StrIn` ABI (protocol, staging window and the why-a-loop in `driver.srcLoad`'s
// header). Every `vl check` / `vl fmt` / `vl test` file read arrives on this channel,
// so it is the LSP's own intake.
export function cliResultLoad(count: i32) {
  cpAccLoad(cliResultAcc, count)
  0
}
export function cliFileCommit(found: i32) {
  cliFileFound = found
  cliFileSrc = cpAccTake(cliResultAcc)
  0
}
// The host's CMD_VALIDATE verdict for the file just emitted: `ok = 1` and the
// module is one the engine accepts; `ok = 0` and `cliResultAcc` carries the
// engine's rejection, which becomes this file's positionless error diagnostic.
export function cliValidateCommit(ok: i32) {
  const msg = cpAccTake(cliResultAcc)
  if ok != 0 { cliValidateMsg = "" } else { cliValidateMsg = msg }
  0
}
export function cliExitCode() { return cliExit }
// 1: a `--codegen` CMD_VALIDATE names its file in `cliCmdPath`. A seed without this export
// leaves an unrelated path there, so the host keeps no module it could misfile.
export function cliValidateNamesFile(): i32 { 1 }

// ── directory-listing intake (host commits one CMD_LIST_DIR result) ─────────────
export function cliDirNamePush(c: i32) {
  cliDirNameAcc.push(c)
  0
}
export function cliDirEntryPush(isDir: i32) {
  cliDirNames.push(fromCodePoints(cliDirNameAcc))
  cliDirIsDirs.push(isDir)
  cliDirNameAcc = []
  0
}
// `isDir = 1` when the listed path is a directory (entries pushed above); 0 when it
// is a file or does not exist (no entries) — the VL program then treats the path as a
// single file.
export function cliDirCommit(isDir: i32) {
  cliDirWasDir = isDir
  0
}

// ── lint-stream adapters ─────────────────────────────────────────────────────

// The current file's lint findings, read from whichever stream the lint run
// populated: the module-aware graph accumulators (`cliLintGraphed`, one entry per
// finding with its owning module index), or lint.vl's single-module sink, which is
// module 0 throughout.
function cliLintCount() {
  if cliLintGraphed != 0 { return lintGraphCount() }
  lintCount()
}
function cliLintSevAt(k: i32) {
  if cliLintGraphed != 0 { return lintGraphSevAt(k) }
  lintSevAt(k)
}
function cliLintMsgAt(k: i32) {
  if cliLintGraphed != 0 { return lintGraphMsgAt(k) }
  lintMsgAt(k)
}
function cliLintCodeAt(k: i32) {
  if cliLintGraphed != 0 { return lintGraphCodeAt(k) }
  lintCodeAt(k)
}
function cliLintLineAt(k: i32) {
  if cliLintGraphed != 0 { return lintGraphLine(k) }
  lintLineAt(k)
}
function cliLintColAt(k: i32) {
  if cliLintGraphed != 0 { return lintGraphCol(k) }
  lintColAt(k)
}
function cliLintEndAt(k: i32) {
  if cliLintGraphed != 0 { return lintGraphEnd(k) }
  lintEndAt(k)
}
function cliLintModAt(k: i32) {
  if cliLintGraphed != 0 { return lintGraphModule(k) }
  0
}

// ── diagnostic formatting (the policy retired from the Rust host) ──────────────
function cliAddDiag(
  sev: string,
  stage: string,
  code: string,
  line: i32,
  col: i32,
  endc: i32,
  msg: string,
  mod: i32,
) {
  cliAddDiagSpan(sev, stage, code, line, col, line, endc, msg, mod)
}
// The same, for a finding whose subject spans LINES: `endLine` is the line `endc` counts
// from. `cliAddDiag` is this with the two lines equal, so a caller with a one-line span
// never has to say so twice.
function cliAddDiagSpan(
  sev: string,
  stage: string,
  code: string,
  line: i32,
  col: i32,
  endLine: i32,
  endc: i32,
  msg: string,
  mod: i32,
) {
  dgSev.push(sev)
  dgLine.push(line)
  dgCol.push(col)
  let el = endLine
  if el < line { el = line }
  dgEndLine.push(el)
  dgEnd.push(endc)
  dgMsg.push(msg)
  dgMod.push(mod)
  dgCode.push(code)
  dgStage.push(stage)
  0
}
// The redundant-annotation hint's exclusive end column, on `redunELineAt(ri)`: `redunS`..
// `redunE` is the range `--fix` DELETES (the `:` through just before the `=`), so the caret
// covers exactly what goes. Only a span ending on the START line needs the one-column floor;
// an annotation spanning lines ends at a column of its own on a line the report now carries.
function cliRedunEndCol(ri: i32) {
  if redunELineAt(ri) != redunSLineAt(ri) { return redunEColAt(ri) }
  const e = redunEColAt(ri)
  if e <= redunSColAt(ri) { return redunSColAt(ri) + 1 }
  e
}
// Empty the parallel diagnostic columns. One home for the three places that start a
// fresh report, so a column added here cannot be left stale by one of them.
function cliClearDiags() {
  dgSev = []
  dgLine = []
  dgCol = []
  dgEndLine = []
  dgEnd = []
  dgMsg = []
  dgMod = []
  dgCode = []
  dgStage = []
  0
}
// Concise one-liner: `<file>: <severity> [<line>:<col>] <message>` (1-based L:C).
function cliFmtConcise(d: i32) {
  let line = dgLine[d]
  if line <= 0 { line = 1 }
  cliDiagFile(d)
    + ": "
    + dgSev[d]
    + " ["
    + i32ToStr(line)
    + ":"
    + i32ToStr(dgCol[d] + 1)
    + "] "
    + dgMsg[d]
}
// One diagnostic as a JSON object (the `--json` schema, `docs/internals/cli-design.md`):
// file, severity, stage, the stable code where one exists (a compile error carries none and
// the field is omitted), 1-based line and col, an exclusive 1-based endCol, `endLine` only
// where the span ends on a LATER line, and the message. Positionless: no position field.
function cliFmtJson(d: i32) {
  let out = "{\"file\":\"" + cliJsonEsc(cliDiagFile(d)) + "\""
  out = out + ",\"severity\":\"" + cliJsonEsc(dgSev[d]) + "\""
  out = out + ",\"stage\":\"" + cliJsonEsc(dgStage[d]) + "\""
  if dgCode[d].length > 0 {
    out = out + ",\"code\":\"" + cliJsonEsc(dgCode[d]) + "\""
  }
  if dgLine[d] > 0 {
    const col = dgCol[d]
    const el = dgEndLine[d]
    let endc = dgEnd[d]
    // The widen-to-one-column floor holds only on the start line: an end on a LATER line is
    // a column in its own right and may sit anywhere, `0` included.
    if el <= dgLine[d] && endc < col + 1 { endc = col + 1 }
    out = out
      + ",\"line\":"
      + i32ToStr(dgLine[d])
      + ",\"col\":"
      + i32ToStr(col + 1)
    if el > dgLine[d] { out = out + ",\"endLine\":" + i32ToStr(el) }
    out = out + ",\"endCol\":" + i32ToStr(endc + 1)
  }
  out + ",\"message\":\"" + cliJsonEsc(dgMsg[d]) + "\"}"
}
// One input file's `--batch` record: the file, the exit code `vl check <file>` alone
// would carry, and the diagnostics it appended to `cliJsonItems` from `from` on. A
// record per file rather than one flat array, in which a CLEAN file reads exactly like
// one nothing checked.
function cliBatchRecord(file: string, exit: CliExit, from: i32) {
  const buf: i32[] = []
  pushCps(buf, "{\"file\":\"")
  pushCps(buf, cliJsonEsc(file))
  pushCps(buf, "\",\"exit\":")
  pushCps(buf, i32ToStr(exit))
  pushCps(buf, ",\"diagnostics\":[")
  let i = from
  while i < cliJsonItems.length {
    if i > from { buf.push(',') }
    // `pushCps`, not `buf.push(item[ci])`: the buffer drains through `fromCodePoints`,
    // whose element is a code point, while `item[ci]` is a byte. See `strutil`.
    pushCps(buf, cliJsonItems[i])
    i = i + 1
  }
  pushCps(buf, "]}\n")
  cliBatchOut.push(fromCodePoints(buf))
  0
}
// The file path to label diagnostic `d` with: the owning module's key in module mode,
// so a graph-compile error in an imported file points at that file rather than the
// entry, else the entry path. `dgMod[d]` is 0 for lint, redundant and single-file.
function cliDiagFile(d: i32) {
  const m = dgMod[d]
  if cliModMode != 0 && m >= 0 && m < cliModKeys.length { return cliModKeys[m] }
  cliCurFile
}
// Why diagnostic `d` is withheld from the report, or "shown". Errors and the entry's own
// diagnostics are always shown; an import's non-error is withheld when its key matches
// `--exclude`, or without `--include-std` for a `std:` module (D1601) and without
// `--include-imports` for any other (plumb PL-055).
type CliWithheld = "shown" | "std" | "import" | "exclude"
function cliDiagWithheld(d: i32): CliWithheld {
  if dgSev[d] == "error" { return "shown" }
  const m = dgMod[d]
  if cliModMode == 0 || m <= 0 { return "shown" }
  const f = cliDiagFile(d)
  if cliExcluded(f, cliBaseName(f)) { return "exclude" }
  if f.length >= 4 && f.slice(0, 4) == "std:" {
    if cliIncludeStd != 0 { return "shown" }
    return "std"
  }
  if cliIncludeImports != 0 { return "shown" }
  "import"
}
// The last `/`-separated segment of `path`, for an `--exclude` basename match.
function cliBaseName(path: string) {
  let i = path.length
  while i > 0 && path[i - 1] != '/' { i = i - 1 }
  path.slice(i, path.length)
}
// The source lines of diagnostic `d`'s owning module (its caret-context line),
// memoized by module index. Falls back to `cliSrcLines` outside module mode.
function cliDiagSrcLines(d: i32) {
  const m = dgMod[d]
  if cliModMode != 0 && m >= 0 && m < cliModSrcs.length {
    if cliDiagLineCacheMod != m {
      cliDiagLineCache = cliSplitLines(cliModSrcs[m])
      cliDiagLineCacheMod = m
    }
    return cliDiagLineCache
  }
  cliSrcLines
}
// The 0-based column just past `raw`'s last non-space byte — where a multi-line span's
// first-line slice ends, so the caret stops at the code rather than running to the margin.
function cliTrimEndCol(raw: string) {
  let e = raw.length
  while (
    e > 0
    && (raw[e - 1] == ' ' || raw[e - 1] == '\t' || raw[e - 1] == '\r')
  ) {
    e = e - 1
  }
  e
}
// Pretty rustc/Deno-style block: `[SEVERITY]: msg` / source line / caret /
// `at file:line:col`. A positionless diagnostic drops the source+caret block.
function cliFmtPretty(d: i32) {
  const sev = dgSev[d]
  const head = cliAnsi(
    cliColor,
    "1;" + cliSevCode(sev),
    "[" + cliUpper(sev) + "]",
  )
  let out = head + ": " + dgMsg[d]
  const col = dgCol[d]
  const dgFile = cliDiagFile(d)
  const dgSrcLines = cliDiagSrcLines(d)
  if dgLine[d] > 0 {
    const idx = dgLine[d] - 1
    if idx >= 0 && idx < dgSrcLines.length {
      const raw = dgSrcLines[idx]
      const shown = cliDetab(raw)
      out = out + "\n  " + shown
      const start = cliVisualWidth(raw, col)
      let endc = dgEnd[d]
      // A span ending on a later line draws the first line's slice: the caret runs from the
      // anchor to the end of the text on this line, which the `remaining` clamp below caps.
      if dgEndLine[d] > dgLine[d] { endc = cliTrimEndCol(raw) }
      if endc < col + 1 { endc = col + 1 }
      const end = cliVisualWidth(raw, endc)
      let remaining = shown.length - start
      if remaining < 1 { remaining = 1 }
      let span = end - start
      if span < 1 { span = 1 }
      if span > remaining { span = remaining }
      const underline = "^" + cliRepeat("~", span - 1)
      out = out
        + "\n  "
        + cliRepeat(" ", start)
        + cliAnsi(cliColor, cliSevCode(sev), underline)
    }
    out = out
      + "\n"
      + cliAnsi(
      cliColor,
      "2",
      "  at " + dgFile + ":" + i32ToStr(dgLine[d]) + ":" + i32ToStr(col + 1),
    )
  } else {
    out = out + "\n" + cliAnsi(cliColor, "2", "  at " + dgFile)
  }
  out
}

// Stable insertion sort of a diagnostic-index array: errors first, so a lint tier
// cannot bury one, then by module, line and col. Ties keep insertion order.
function cliDiagLess(a: i32, b: i32) {
  const ea = dgSev[a] == "error"
  if ea != (dgSev[b] == "error") { return ea }
  if dgMod[a] != dgMod[b] { return dgMod[a] < dgMod[b] }
  if dgLine[a] != dgLine[b] { return dgLine[a] < dgLine[b] }
  dgCol[a] < dgCol[b]
}
function cliStableSort(order: i32[]) {
  let i = 1
  while i < order.length {
    const key = order[i]
    let j = i - 1
    while j >= 0 && cliDiagLess(key, order[j]) {
      order[j + 1] = order[j]
      j = j - 1
    }
    order[j + 1] = key
    i = i + 1
  }
  0
}

// ── the `check` policy ───────────────────────────────────────────────────────

// ── `--exclude` glob filtering ───────────────────────────────────────────────
// Normalize a pattern (strip a leading `./` and trailing `/`s) and record it.
function cliAddExclude(pat: string) {
  let p = pat
  if p.length >= 2 && p[0] == '.' && p[1] == '/' { p = p.slice(2, p.length) }
  while p.length > 0 && p[p.length - 1] == '/' { p = p.slice(0, p.length - 1) }
  cliExcludes.push(p)
  0
}
// True if any exclude pattern matches the path relative to the check root or its
// basename — so `--exclude tests` prunes a whole subtree and `--exclude '*.gen.vl'`
// matches generated files anywhere.
function cliExcluded(relPath: string, basename: string) {
  let i = 0
  while i < cliExcludes.length {
    const p = cliExcludes[i]
    if cliGlob(p, relPath) { return true }
    if cliGlob(p, basename) { return true }
    i = i + 1
  }
  false
}

// A flag-shaped argument (so a value-taking flag never swallows one — e.g. the
// host-injected trailing `--color=<v>` after a bare `--severity`).
function cliIsFlag(a: string) { a.length > 0 && a[0] == '-' }
// `--jobs` value → a positive worker count, or -1 for "not a positive count"
// (the caller turns that into a usage error rather than silently running serially).
function cliParseJobs(s: string) {
  if s.length == 0 { return -1 }
  let n = 0
  let i = 0
  while i < s.length {
    const c = s[i]
    if c < '0' || c > '9' { return -1 }
    n = n * 10 + ((c as! i32) - ('0' as! i32))
    i = i + 1
  }
  if n < 1 { return -1 }
  n
}
// Record a usage error (first one wins; printed at exit tier 2).
function cliUsageErr(msg: string) {
  if cliArgErr == "" { cliArgErr = msg }
  0
}
// End the run: print `msg` on stderr and exit with the usage code.
function cliUsageStop(msg: string) {
  cliOut = [msg]
  cliExit = EXIT_USAGE
  cliBeginPrint()
}
// Whether flag `cliArgs[i]` has its value at `i + 1`: present and not itself a flag.
// When it does not, records `msg` as the usage error.
function cliTakeValue(i: i32, msg: string): boolean {
  if i + 1 < cliArgs.length && !cliIsFlag(cliArgs[i + 1]) { return true }
  cliUsageErr(msg)
  false
}
// Whether `a` is `prefix` (a `--flag=` spelling) followed by a non-empty value.
function cliHasPrefixValue(a: string, prefix: string): boolean {
  a.length > prefix.length && a.slice(0, prefix.length) == prefix
}
// The value after `prefix` in `a`, for an `a` that `cliHasPrefixValue` accepted.
function cliPrefixValue(a: string, prefix: string): string {
  a.slice(prefix.length, a.length)
}
// Parse the subcommand's args strictly: an unknown flag or a second positional
// argument is a usage error (exit 2), never silently ignored — `vl check a.vl b.vl`
// must not quietly check only `a.vl`. Flags are validated per subcommand; a
// value-taking flag requires a non-flag value.
function cliParseArgs() {
  let sub = "check"
  if cliArgs.length > 0 && cliArgs[0] == "fmt" { sub = "fmt" }
  if cliArgs.length > 0 && cliArgs[0] == "test" { sub = "test" }
  // `--batch` decides how the POSITIONALS parse, so it is read before the loop rather
  // than in it: a flag has to mean the same thing wherever on the line it is written,
  // and `vl check a.vl b.vl --batch` would otherwise fail on `b.vl` first.
  if sub == "check" {
    let b = 1
    while b < cliArgs.length {
      if cliArgs[b] == "--batch" { cliBatch = 1 }
      b = b + 1
    }
  }
  let i = 1
  while i < cliArgs.length {
    const a = cliArgs[i]
    if a == "--compiler" {
      // The host's concern (it selects the compiler module) — skip flag + value.
      i = i + 1
    } else if sub == "check" && a == "--concise" {
      cliConcise = 1
    } else if sub == "check" && a == "--codegen" {
      cliCodegen = 1
    } else if sub == "check" && a == "--no-validate" {
      // Mirrors `vl build --no-validate`: run the emitter, skip the engine's verdict on
      // its output, for anyone sizing emitter reach on a corpus of invalid modules.
      cliNoValidate = 1
    } else if sub == "check" && a == "--json" {
      cliJson = 1
    } else if sub == "check" && a == "--batch" {
      cliBatch = 1
    } else if sub == "check" && a == "--include-std" {
      cliIncludeStd = 1
    } else if sub == "check" && a == "--include-imports" {
      cliIncludeImports = 1
    } else if sub == "check" && a == "--severity" {
      cliSeverityGiven = 1
      const msg = "check: --severity requires a value (error, warning, info, hint)"
      if cliTakeValue(i, msg) {
        i = i + 1
        cliSeverity = cliArgs[i]
      }
    } else if sub == "check" && cliHasPrefixValue(a, "--severity=") {
      cliSeverity = cliPrefixValue(a, "--severity=")
      cliSeverityGiven = 1
    } else if cliHasPrefixValue(a, "--color=") {
      if cliPrefixValue(a, "--color=") == "always" {
        cliColor = 1
      } else {
        cliColor = 0
      }
    } else if (sub == "check" || sub == "test") && a == "--exclude" {
      if cliTakeValue(i, sub + ": --exclude requires a glob pattern") {
        i = i + 1
        cliAddExclude(cliArgs[i])
      }
    } else if (
      (sub == "check" || sub == "test")
      && cliHasPrefixValue(a, "--exclude=")
    ) {
      cliAddExclude(cliPrefixValue(a, "--exclude="))
    } else if sub == "fmt" && (a == "-w" || a == "--write") {
      cliFmtWrite = 1
    } else if sub == "fmt" && a == "--check" {
      cliFmtCheck = 1
    } else if sub == "check" && a == "--fix" {
      cliFix = 1
    } else if sub == "check" && a == "--write-baseline" {
      cliBudgetAct = 3
    } else if sub == "check" && a == "--exempt-codes" {
      cliBudgetAct = 4
    } else if sub == "check" && (a == "--budget" || a == "--budget-why") {
      cliBudget = 1
      if a == "--budget-why" { cliBudget = 2 }
      if cliTakeValue(i, "check: " + a + " requires a baseline file") {
        i = i + 1
        cliBudgetPath = cliArgs[i]
      }
    } else if sub == "check" && a == "--findings" {
      if cliTakeValue(i, "check: --findings requires a `--json` report file") {
        i = i + 1
        cliBudgetFindings = cliArgs[i]
      }
    } else if sub == "test" && a == "-t" {
      const msg = "test: -t requires a substring to match test names against"
      if cliTakeValue(i, msg) {
        i = i + 1
        cliTestFilter = cliArgs[i]
      }
    } else if sub == "test" && cliHasPrefixValue(a, "-t=") {
      cliTestFilter = cliPrefixValue(a, "-t=")
    } else if sub == "test" && a == "--jobs" {
      if cliTakeValue(i, "test: --jobs requires a positive count") {
        i = i + 1
        cliTestJobs = cliParseJobs(cliArgs[i])
      }
    } else if sub == "test" && cliHasPrefixValue(a, "--jobs=") {
      cliTestJobs = cliParseJobs(cliPrefixValue(a, "--jobs="))
    } else if cliIsFlag(a) {
      cliUsageErr(sub + ": unknown flag `" + a + "`")
    } else if a.length > 0 {
      cliTargets.push(a)
    }
    i = i + 1
  }
  if (
    cliArgErr == ""
    && cliBudget != 0
    && (cliFix != 0 || cliJson != 0 || cliBatch != 0)
  ) {
    cliArgErr = "check: --budget reports a verdict of its own; it takes no --fix, --json or --batch"
  }
  if cliArgErr == "" && cliBudgetAct != 0 {
    if cliBudget == 1 {
      cliBudget = cliBudgetAct
    } else {
      cliArgErr = "check: --write-baseline and --exempt-codes act on a --budget <baseline>"
    }
  }
  if cliArgErr == "" && cliBudgetFindings != "" && cliBudget == 4 {
    cliArgErr = "check: --findings counts a --budget <baseline> report; it takes no --exempt-codes"
  }
  if cliArgErr == "" && cliTestJobs < 0 {
    cliArgErr = "test: --jobs expects a positive count"
  }
  if cliArgErr == "" && cliSeverityGiven != 0 && !cliSevValid(cliSeverity) {
    cliArgErr = "check: invalid --severity `"
      + cliSeverity
      + "` (expected one of: error, warning, info, hint)"
  }
  // --json is machine output: never ANSI, whatever the host-resolved --color
  // (TTY detection / NO_COLOR) says.
  if cliJson != 0 { cliColor = 0 }
  0
}

// Stage `cliEntrySrc` into the compiler's single-source input. One call, not a
// per-element loop: `driver.srcSetStr`'s header explains why the loop spelling
// double-encodes a non-ASCII source.
function cliStageEntry() {
  srcReset()
  srcSetStr(cliEntrySrc)
  0
}

// Stable merge sort of the file paths collected from `base` on — one target's own
// slice, so a batch's records stay in argv order while each directory sorts inside it
// (stable output across runs). `cliFileFromDir` rides along, since it is read by index.
function cliSortFilesFrom(base: i32) {
  const n = cliFiles.length - base
  if n < 2 { return 0 }
  let src: i32[] = []
  let dst: i32[] = []
  let i = 0
  while i < n {
    src.push(base + i)
    dst.push(0)
    i = i + 1
  }
  let width = 1
  while width < n {
    let lo = 0
    while lo < n {
      let mid = lo + width
      if mid > n { mid = n }
      let hi = lo + 2 * width
      if hi > n { hi = n }
      let a = lo
      let b = mid
      let k = lo
      while k < hi {
        // The left run wins a tie, which is what keeps the sort stable.
        if (
          a < mid
          && (b >= hi || !cliStrGt(cliFiles[src[a]], cliFiles[src[b]]))
        ) {
          dst[k] = src[a]
          a = a + 1
        } else {
          dst[k] = src[b]
          b = b + 1
        }
        k = k + 1
      }
      lo = hi
    }
    const t = src
    src = dst
    dst = t
    width = width * 2
  }
  const files: string[] = []
  const fromDir: i32[] = []
  for ix in src {
    files.push(cliFiles[ix])
    fromDir.push(cliFileFromDir[ix])
  }
  i = 0
  while i < n {
    cliFiles[base + i] = files[i]
    cliFileFromDir[base + i] = fromDir[i]
    i = i + 1
  }
  0
}
// Ingest one committed directory listing rooted at `base` (full path) / `relBase`
// (relative to the check root): queue non-skipped, non-excluded subdirectories onto
// the walk stack and collect non-excluded `.vl` files onto the work-list. The exclude
// test sees the path relative to the root and the basename.
function cliIngestEntries(base: string, relBase: string) {
  let i = 0
  while i < cliDirNames.length {
    const name = cliDirNames[i]
    const child = base + "/" + name
    let rel = name
    if relBase.length > 0 { rel = relBase + "/" + name }
    if cliDirIsDirs[i] != 0 {
      if !cliSkipDir(name) && !cliExcluded(rel, name) {
        cliWalkStack.push(child)
        cliWalkRel.push(rel)
      }
    } else {
      // `check` and `fmt` collect every `.vl`; `test` collects only `*.test.vl` — the
      // discovery predicate is the one thing the walk does differently.
      let wanted = cliEndsVl(name)
      if cliCmd == 2 { wanted = cliEndsTestVl(name) }
      if wanted && !cliExcluded(rel, name) { cliAddFile(child, 1) }
    }
    i = i + 1
  }
  0
}

// ── per-file check (appends to cliOut + folds into the tally) ────────────────
// Run the checker over the current file, append its formatted diagnostics to `cliOut`,
// and add its error, warning and gating counts to the running tally. The summary is
// built once at the end (`cliFinishSummary`).
function cliCheckCurFile() {
  if cliModMode == 0 { cliStageEntry() }
  cliFileInvalid = 0
  let rc = 0
  // A `--fix` verify pass compiles rather than checks: an annotation the hint calls
  // redundant is load-bearing for the emitter far more often than for the checker (D1091).
  if cliCodegen != 0 || cliFixPhase != FIXP_OFF {
    rc = compileSrc()
  } else {
    rc = checkSrc()
    cliWiBankRows()
  }
  cliFixPassRc = rc
  cliLastStage = ""
  if rc == 1 { cliLastStage = "parse" }
  else if rc == 2 { cliLastStage = "type" }
  else if rc == 3 { cliLastStage = "emit" }

  // `--codegen` promises the program lowers, which the emitter returning 0 does not
  // establish, so the bytes cross to the engine. The round-trip reads `rbyte*` and
  // commits a string, never re-entering the compiler, so it is safe here and not later.
  cliValidateMsg = ""
  // A verify pass always hands the bytes over, even for a nonzero `rc`: the round-trip
  // is what unwinds the stack between trials, so many edits cost one frame, not one each.
  if cliFixPhase != FIXP_OFF {
    cliState = ST_CHECK_VALIDATE
    return CMD_VALIDATE
  }
  if cliCodegen != 0 && rc == 0 && cliNoValidate == 0 {
    cliState = ST_CHECK_VALIDATE
    cliCmdPath = cliCurFile
    return CMD_VALIDATE
  }
  cliCheckCurFileRest()
}

// The rest of the per-file check, after the engine has had its say (see
// `cliCheckCurFile`). Split out only so the validate round-trip has somewhere to resume.
function cliCheckCurFileRest() {
  // A verify pass produces a verdict, never a report: the diagnostics it just computed
  // describe a candidate source that may never reach the disk.
  if cliFixPhase != FIXP_OFF {
    let ok = 0
    if cliFixPassRc == 0 && cliValidateMsg.length == 0 { ok = 1 }
    cliValidateMsg = ""
    return cliFixVerdict(ok)
  }
  if cliSibTried == 0 && mimpMissed.length > 0 {
    cliSibTried = 1
    // The scan's candidates and cache are the run's, so a worker hands the root back.
    if cliCheckPoolMode == 2 { return cliCheckWorkerDone() }
    return cliSibBegin()
  }
  // Error-tier diagnostics — capture them now, straight from the driver stores, before
  // `lintSrc` re-parses the entry source and resets those stores.
  cliCaptureErrorDiags()
  // The engine rejected the module this file emitted. Positioned: the emitter banks
  // each function body's module byte range, so the offset the validator names maps back
  // to the function owning those bytes; an unmapped offset keeps the positionless form.
  // An `error`, because the alternative is a clean `check --codegen` that cannot load.
  if cliValidateMsg.length > 0 {
    const vsp = emitFnSpanAt(engineFailOffset(cliValidateMsg))
    const vwhere = emitFnSpanWhere(vsp)
    // The underline covers the name where there is one; a module-scope statement has
    // none, so it gets a one-column caret rather than an empty span.
    let vlen = emitFnSpanNameLen(vsp)
    if vlen == 0 && vsp >= 0 { vlen = 1 }
    cliAddDiag(
      "error",
      "validate",
      "invalid-module",
      emitFnSpanLine(vsp),
      emitFnSpanCol(vsp),
      emitFnSpanCol(vsp) + vlen,
      "the emitted module failed to validate"
        + vwhere
        + " — this is a bug in vl, not in your program; please report it with this "
        + "file: "
        + cliValidateMsg,
      emitFnSpanModule(vsp),
    )
    cliInvalidModule = 1
    cliFileInvalid = 1
    cliValidateMsg = ""
  }

  // Lint (parse-only), run before the `--fix` block that needs the stream and reused by
  // the report. Scope: a single-file target in module mode lints the whole graph, so an
  // unused local in an imported module is reported against its owner; a directory run
  // lints the entry module only, since every file gets its turn as the entry.
  cliStageEntry()
  // The path is what scopes `std-comment-audience`/`compiler-no-interpolation` to
  // `std/`/`compiler/`; the graph walk re-sets it per module, so this is the
  // single-file and directory path. `lintScopeKeyOf` relativizes an absolute
  // `cliCurFile` inside the VL checkout, or blanks one outside it.
  lintSetPath(lintScopeKeyOf(cliCurFile))
  // The check above is this file's own, so the lint may read the `+` links it typed.
  lintUseCheck(checkGen())
  cliLintGraphed = 0
  if cliModMode != 0 && cliDirMode == 0 {
    cliLintGraphed = 1
    lintGraph()
  } else {
    lintSrc()
  }

  // `--fix`, module-aware: the redundant-annotation and lint streams are reliable after
  // the resolved check, so apply the safe edits, write the file and re-check, which is
  // the next round. Fixing after imports resolve is what makes it safe.
  if cliFix != 0 && cliFileFixed == 0 {
    cliCollectFixes(cliEntrySrc)
    if cliFixEdit.pos.length > 0 && cliFixRound >= FIX_ROUND_CAP {
      cliFixCapHit = cliFixCapHit + 1
      cliFixFileDone()
    } else if cliFixEdit.pos.length == 0 {
      cliFixFileDone()
    } else {
      cliFixOrig = cliEntrySrc
      // Trial one: every edit at once. On the overwhelming majority of files it
      // holds, and then verification costs exactly one compile.
      cliFixKeep = []
      let fk = 0
      while fk < cliFixEdit.pos.length {
        cliFixKeep.push(1)
        fk = fk + 1
      }
      cliFixPhase = FIXP_ALL
      cliEntrySrc = cliApplyFixEdits(cliFixOrig, cliFixKeep)
      return cliBeginCheck()
    }
  }

  // ── report ──────────────────────────────────────────────────────────────────
  cliAddReportStreams()

  cliSrcLines = cliSplitLines(cliEntrySrc)
  if cliBudget != 0 {
    cliBudgetCollect()
    cliFileIdx = cliFileIdx + 1
    return cliStartFile()
  }
  const thr = cliSevRank(cliSeverity)
  let disp = 0
  if cliSeverityGiven != 0 { disp = thr }
  // Where this file's contribution to the running tally and to the JSON array begins —
  // the two things a `--batch` record is a slice of.
  const gateBase = cliGating
  const jsonBase = cliJsonItems.length
  // Fold this file's counts into the running tally (gating + error/warning).
  let gi = 0
  while gi < dgSev.length {
    // A withheld diagnostic counts nowhere — not in the tally, not in the gate: a
    // warning in an import must not fail the build of the file that imports it. The
    // hidden count takes only what the display floor would have shown.
    const why = cliDiagWithheld(gi)
    const warn = dgSev[gi] == "warning"
    const shownAt = cliSevRank(dgSev[gi]) >= disp
    match why {
      "shown" => {
        if cliSevRank(dgSev[gi]) >= thr { cliGating = cliGating + 1 }
        if dgSev[gi] == "error" { cliErrors = cliErrors + 1 }
        if warn { cliWarnings = cliWarnings + 1 }
      }
      "std" => {
        if shownAt { cliStdHidden = cliStdHidden + 1 }
        if shownAt && warn { cliStdHiddenWarn = cliStdHiddenWarn + 1 }
      }
      "import" => {
        if shownAt { cliImpHidden = cliImpHidden + 1 }
        if shownAt && warn { cliImpHiddenWarn = cliImpHiddenWarn + 1 }
      }
      "exclude" => {}
    }
    gi = gi + 1
  }
  // Display: those at or above the floor, stable-sorted by position, appended.
  const order: i32[] = []
  let oj = 0
  while oj < dgSev.length {
    if cliSevRank(dgSev[oj]) >= disp && cliDiagWithheld(oj) == "shown" {
      order.push(oj)
    }
    oj = oj + 1
  }
  cliStableSort(order)
  let os = 0
  while os < order.length {
    if cliJson != 0 { cliJsonItems.push(cliFmtJson(order[os])) }
    else if cliConcise != 0 { cliOut.push(cliFmtConcise(order[os])) }
    else { cliOut.push(cliFmtPretty(order[os])) }
    os = os + 1
  }
  // `--batch --json`: this file's own verdict, sliced out of what it just appended.
  if cliBatch != 0 && cliJson != 0 {
    let fexit: CliExit = EXIT_OK
    if cliGating > gateBase { fexit = EXIT_FAILED }
    if cliFileInvalid != 0 { fexit = EXIT_COMPILER_BUG }
    cliBatchRecord(cliCurFile, fexit, jsonBase)
  }
  // This file is done (reported); advance to the next.
  cliFileIdx = cliFileIdx + 1
  cliStartFile()
}

// `cliCheckCurFileRest`'s error tier: resets the per-file diagnostic and `--fix` note
// columns, then adds every driver diagnostic as an `error`, noting the entry module's
// fixable ones when `--fix` is on.
function cliCaptureErrorDiags() {
  cliClearDiags()
  cliImpAsk.item = []
  cliImpAsk.spec = []
  cliImpClash = []
  cliImpAsk.method = []
  cliZb.line = []
  cliZb.col = []
  cliZb.endLine = []
  cliZb.endCol = []
  cliRc.line = []
  cliRc.col = []
  cliRc.endLine = []
  cliRc.endCol = []
  cliRc.keep = []
  cliRc.what = []
  cliSitesClear(cliGb)
  cliSitesClear(cliNo)
  const n = diagCount()
  let i = 0
  while i < n {
    // Capture the owning module and the producing stage before `lintSrc` resets
    // `P.toks` / `nodeToks`, which `diagModule` and `diagStage` resolve through.
    // Single-file mode is module 0, the entry.
    cliAddDiagSpan(
      "error",
      diagStage(i),
      "",
      diagLine(i),
      diagCol(i),
      diagEndLine(i),
      diagEndCol(i),
      vcDiagMsg(i),
      diagModule(i),
    )
    if cliFix != 0 && diagModule(i) == 0 {
      cliNoteImportFix(i)
      cliNoteZeroBytesFix(i)
      cliNoteGenBindFix(i)
      cliNoteCastFix(i)
      cliNoteStrictEqFix(i)
      cliNoteNamedOrderFix(i)
    }
    i = i + 1
  }
  // A served check's type errors are the ones its importer's check banked for it.
  let w = 0
  while w < wiDiagCount() {
    cliAddDiagSpan(
      "error",
      "type",
      "",
      wiDiagLine(w),
      wiDiagCol(w),
      wiDiagEndLine(w),
      wiDiagEndCol(w),
      wiDiagMsg(w),
      wiDiagMod(w),
    )
    w = w + 1
  }
}

// `cliCheckCurFileRest`'s report streams after the lint run: the lint findings, the sites
// `--fix` declined, and the checker's entry-module hints and warnings.
function cliAddReportStreams() {
  // Lint-tier diagnostics (from the lint run above; read the stored count).
  // Module-aware: a graph lint's finding carries the owning module's index, so the
  // report labels it, and draws its caret context, against that file.
  const ln = cliLintCount()
  let k = 0
  while k < ln {
    let sev = cliLintSevAt(k)
    if sev.length == 0 { sev = "warning" }
    cliAddDiag(
      sev,
      "lint",
      cliLintCodeAt(k),
      cliLintLineAt(k),
      cliLintColAt(k),
      cliLintEndAt(k),
      cliLintMsgAt(k),
      cliLintModAt(k),
    )
    k = k + 1
  }
  // `--fix` declined an edit here (an `info`): applying it stopped the file building,
  // so the diagnostic that offered it is wrong about this site. Reported per site and
  // not as a count, because a count cannot be worked on (D1091).
  let fd = 0
  while fd < cliFixDecl.text.length {
    cliAddDiag(
      "info",
      "fix",
      "fix-declined",
      cliFixDecl.line[fd],
      cliFixDecl.col[fd],
      cliFixDecl.col[fd] + 1,
      "`--fix` left this alone: applying the "
        + cliFixDecl.text[fd]
        + " fix stops this file building, so the finding that offers it is wrong here",
      0,
    )
    fd = fd + 1
  }
  // The checker's hints and warnings for the entry module: an importer's when a bank served
  // this check, else this check's own (`cliStreamRows`).
  let rows = cliStreamRows(0)
  if wiServed() { rows = cliWiRows[wiKeyOf(cliCurFile)] ?? cliRowsNew() }
  let ri = 0
  while ri < rows.sev.length {
    cliAddDiagSpan(
      rows.sev[ri],
      "type",
      rows.code[ri],
      rows.line[ri],
      rows.col[ri],
      rows.endLine[ri],
      rows.endc[ri],
      rows.msg[ri],
      0,
    )
    ri = ri + 1
  }
}

// The checker's rows of one module, in report order, as `cliStreamRows` reads them.
type CliRows = {
  sev: string[],
  code: string[],
  line: i32[],
  col: i32[],
  endLine: i32[],
  endc: i32[],
  msg: string[],
}
// Per target key, the rows an importer's check read for it (`cliWiBankRows`).
let cliWiRows: {[string]: CliRows} = Map()

function cliRowsNew(): CliRows {
  { sev: [], code: [], line: [], col: [], endLine: [], endc: [], msg: [] }
}

function cliRowAdd(
  r: CliRows,
  sev: string,
  code: string,
  line: i32,
  col: i32,
  endLine: i32,
  endc: i32,
  msg: string,
) {
  r.sev.push(sev)
  r.code.push(code)
  r.line.push(line)
  r.col.push(col)
  r.endLine.push(endLine)
  r.endc.push(endc)
  r.msg.push(msg)
  0
}

// Module `mod`'s rows of the checker's report streams. Only the entry's are reported, since a
// graph check merges every module and only the entry's positions map onto the reported file.
function cliStreamRows(mod: i32): CliRows {
  const r = cliRowsNew()
  // Redundant explicit type annotations (a `hint`): `let x: T = e` where the initializer
  // already infers to exactly `T`. The span is `cliRedunEndCol`'s.
  let ri = 0
  while ri < redunCount() {
    if redunModuleAt(ri) == mod {
      cliRowAdd(
        r,
        "hint",
        "redundant-type",
        redunSLineAt(ri),
        redunSColAt(ri),
        redunELineAt(ri),
        cliRedunEndCol(ri),
        redunMsgAt(ri),
      )
    }
    ri = ri + 1
  }
  // Dead `??` defaults (a `warning`): `x ?? d` where `x`'s type admits no null. The severity
  // matches the lint pass's `constant-condition`, the same family of a branch never taken.
  let ci = 0
  while ci < rcoalCount() {
    if rcoalModuleAt(ci) == mod {
      const ln = rcoalLineAt(ci)
      cliRowAdd(
        r,
        "warning",
        rcoalCodeAt(ci),
        ln,
        rcoalColAt(ci),
        ln,
        rcoalEndAt(ci),
        rcoalMsgAt(ci),
      )
    }
    ci = ci + 1
  }
  // An uncalled entry export's parameter the checker inferred from its body (a `hint`, D3817):
  // the program runs, and the advice is to freeze the host-facing signature.
  let ei = 0
  while ei < expInfCount() {
    if expInfModuleAt(ei) == mod {
      const ln = expInfLineAt(ei)
      cliRowAdd(
        r,
        "hint",
        "inferred-export-param",
        ln,
        expInfColAt(ei),
        ln,
        expInfEndAt(ei),
        expInfMsgAt(ei),
      )
    }
    ei = ei + 1
  }
  // `is <literal>` over an operand whose union collapsed (a `hint`): the subsumed-arm ruling
  // makes `string | "err"` the type `string`, so the test is a value compare. A `hint`, since
  // the program is correct and the advice is about the author's error channel.
  let vi = 0
  while vi < isvalCount() {
    if isvalModuleAt(vi) == mod {
      const ln = isvalLineAt(vi)
      cliRowAdd(
        r,
        "hint",
        isvalCodeAt(vi),
        ln,
        isvalColAt(vi),
        ln,
        isvalEndAt(vi),
        isvalMsgAt(vi),
      )
    }
    vi = vi + 1
  }
  r
}

// After a check that banked targets for serving (`wiBankedCount`), read each one's rows now,
// while the check's streams still name its modules.
function cliWiBankRows() {
  let i = 0
  while i < wiBankedCount() {
    // A target banked clean from a check with errors reports the rows that check withheld.
    const held = wiBankedHeld(i)
    if held { wiHeldSwap() }
    cliWiRows[wiBankedKey(i)] = cliStreamRows(wiBankedMod(i))
    if held { wiHeldSwap() }
    i = i + 1
  }
  0
}

// `--budget`: note this file's findings of every budgeted code, at any severity, that the
// report would show, named by checkout-relative path and source line and kept only
// inside the trees the baseline's targets name.
function cliBudgetCollect() {
  const tops: string[] = []
  for t in budgetTargets() { tops.push(topPathSeg(cliPathKey(t))) }
  let d = 0
  while d < dgSev.length {
    if budgetWants(dgCode[d]) && cliDiagWithheld(d) == "shown" {
      const rel = cliPathKey(cliDiagFile(d))
      let inside = false
      for t in tops {
        if t == topPathSeg(rel) { inside = true }
      }
      const lines = cliDiagSrcLines(d)
      let text = ""
      if dgLine[d] >= 1 && dgLine[d] <= lines.length {
        text = lines[dgLine[d] - 1]
      }
      if inside && cliCheckPoolMode == 2 {
        cliPwNotes.push(dgCode[d])
        cliPwNotes.push(rel)
        cliPwNotes.push(i32ToStr(dgLine[d]))
        cliPwNotes.push(i32ToStr(dgCol[d]))
        cliPwNotes.push(text)
      } else if inside {
        budgetNote(dgCode[d], rel, dgLine[d], dgCol[d], text)
      }
    }
    d = d + 1
  }
  0
}
// `--budget`'s verdict, or `--budget-why`'s names, as the run's stdout.
function cliBudgetFinish() {
  let lines = budgetWhyLines(cliBudgetPath)
  if cliBudget == 1 { lines = budgetCheckLines(cliBudgetPath) }
  let text = ""
  for l in lines { text = text + l + "\n" }
  cliJsonOut = text
  cliExit = EXIT_OK
  if budgetFailed() { cliExit = EXIT_FAILED }
  if cliBudget == 2 && budgetFailed() { cliExit = EXIT_USAGE }
  0
}
// `--write-baseline`: read `path` toward HEAD's commit, or — resolved, or "" when it
// cannot be — write the baseline this run counted.
function cliBudgetGitRead(path: string) {
  if path != "" {
    cliCmdPath = path
    cliState = ST_BUDGET_GIT
    return CMD_READ_FILE
  }
  cliCmdPath = cliBudgetPath
  cliCmdData = budgetWriteText(budgetGitCommit())
  cliState = ST_BUDGET_WROTE
  CMD_WRITE_FILE
}

// A `--batch` entry the host could not read. It gets its OWN record — exit 2, the code
// a single `vl check <missing>` carries — rather than the walk's silent skip: a caller
// keying on the paths it named must never read an unread file as a clean one.
function cliBatchUnreadable() {
  cliModMode = 0
  const jsonBase = cliJsonItems.length
  cliClearDiags()
  cliAddDiag(
    "error",
    "read",
    "cannot-read",
    0,
    0,
    0,
    "cannot read " + cliCurFile,
    0,
  )
  cliErrors = cliErrors + 1
  cliGating = cliGating + 1
  cliBatchUnread = 1
  if cliJson != 0 {
    cliJsonItems.push(cliFmtJson(0))
    cliBatchRecord(cliCurFile, EXIT_USAGE, jsonBase)
  } else {
    cliOut.push("check: cannot read " + cliCurFile)
  }
  cliFileIdx = cliFileIdx + 1
  cliStartFile()
}

// Say what `--include-std` and `--include-imports` withheld, so a hidden diagnostic is
// never a silent one. It rides `cliOut` (stderr) rather than the report, so a `--json`
// caller is told too without a non-diagnostic entering the array on stdout (D1601).
function cliHiddenNotes() {
  for f in cliSibSkipped {
    cliOut.push(
      cliAnsi(
        cliColor,
        "2",
        "(the missing-import lookup skipped " + f + ": it does not lex)",
      ),
    )
  }
  cliHiddenNote(cliImpHidden, cliImpHiddenWarn, "import", "--include-imports")
  cliHiddenNote(cliStdHidden, cliStdHiddenWarn, "std", "--include-std")
}
// One withheld-count line: `n` hidden, `nWarn` of them warnings, from `what` modules.
function cliHiddenNote(n: i32, nWarn: i32, what: string, flag: string) {
  if n == 0 { return 0 }
  let noun = what + " diagnostic"
  if nWarn == n { noun = what + " warning" }
  cliOut.push(
    cliAnsi(
      cliColor,
      "2",
      "(" + cliPlural(n, noun) + " hidden — " + flag + " shows them)",
    ),
  )
  0
}

// The aggregate summary line, once every file is checked. A single-file target keeps
// the per-stage note (`(type error)`) tooling greps for; a directory run aggregates
// across files and omits it.
function cliFinishSummary() {
  // `--fix`: note how many safe fixes this run applied, of which kinds and over how many
  // rounds, ahead of the check report. A declined edit is one verify-and-revert threw
  // away because the rewritten file stopped building (D1091).
  if (
    cliFix != 0
    && (cliFixCount > 0 || cliFixDeclined > 0 || cliFixCapHit > 0)
  ) {
    let note = "Applied " + i32ToStr(cliFixCount) + " fix(es)"
    if cliFixCount > 0 {
      note = note + " in " + i32ToStr(cliFixRoundsMax) + " round(s):"
      let fk = 0
      while fk < cliFixKinds.length {
        if fk > 0 { note = note + "," }
        note = note + " " + i32ToStr(cliFixKindN[fk]) + " " + cliFixKinds[fk]
        fk = fk + 1
      }
    }
    note = note + "."
    if cliFixDeclined > 0 {
      note = note
        + " Declined "
        + i32ToStr(cliFixDeclined)
        + " that stopped the file building."
    }
    if cliFixCapHit > 0 {
      note = note
        + " Stopped after "
        + i32ToStr(FIX_ROUND_CAP)
        + " rounds with fixes still to apply in "
        + i32ToStr(cliFixCapHit)
        + " file(s); run `--fix` again."
    }
    cliOut.push(cliAnsi(cliColor, "2", note))
  }
  // `--json`: the diagnostics are the report — one JSON array on a single stdout line,
  // no human summary, with the exit code carrying the gate. Built in a code-point
  // buffer, since string concat per item is quadratic on a large directory run.
  if cliJson != 0 {
    cliExit = cliCheckExit()
    // `--batch` already wrote a record per file; its stdout is those, not one array.
    if cliBatch != 0 { return cliHiddenNotes() }
    const buf: i32[] = []
    buf.push('[')
    let ji = 0
    while ji < cliJsonItems.length {
      if ji > 0 { buf.push(',') }
      // `pushCps`, not `buf.push(item[ci])`: the buffer drains through `fromCodePoints`,
      // whose element is a code point, while `item[ci]` is a byte. See `strutil`.
      pushCps(buf, cliJsonItems[ji])
      ji = ji + 1
    }
    buf.push(']')
    buf.push('\n')
    cliJsonOut = fromCodePoints(buf)
    return cliHiddenNotes()
  }
  let summary = ""
  if cliErrors == 0 && cliWarnings == 0 {
    let noun = "files"
    if cliFiles.length == 1 { noun = "file" }
    summary = cliAnsi(
      cliColor,
      "2",
      "Checked "
        + i32ToStr(cliFiles.length)
        + " "
        + noun
        + ", no errors.",
    )
  } else {
    let parts = cliPlural(cliErrors, "error")
    if cliWarnings > 0 {
      parts = parts + ", " + cliPlural(cliWarnings, "warning")
    }
    let note = ""
    if cliGating > 0 && cliSeverity != "error" {
      note = " (failing at severity " + cliSeverity + ")"
    }
    let stageNote = ""
    if (
      cliBatch == 0
      && cliDirMode == 0
      && cliFiles.length == 1
      && cliErrors > 0
      && cliLastStage != ""
    ) {
      stageNote = " (" + cliLastStage + " error)"
    }
    const text = "Found " + parts + "." + note + stageNote
    let code = "33"
    if cliGating > 0 { code = "31" }
    summary = cliAnsi(cliColor, code, text)
  }
  cliOut.push(summary)
  cliHiddenNotes()
  cliExit = cliCheckExit()
  0
}

// `vl check`'s exit code: a gating diagnostic fails the run, an unreadable `--batch` input
// outranks that, and a module the engine refused outranks both.
function cliCheckExit(): CliExit {
  if cliInvalidModule > 0 { return EXIT_COMPILER_BUG }
  if cliBatchUnread != 0 { return EXIT_USAGE }
  if cliGating > 0 { return EXIT_FAILED }
  EXIT_OK
}

// ── `vl test` — the runner brain (docs/internals/vl-test-design.md) ──────────

// The whole runner is policy except wasm execution: discovery reuses the `check` walk
// with a `*.test.vl` predicate, compilation reuses the module fetch loop, and three
// commands cross to the host — stash a compiled module, collect the registries, run
// the plan. A file that fails to compile records its diagnostics and the run goes on.

// The line `vl test` appends to every test file before compiling it: the runner
// protocol, re-exported so the host can find it on the test module itself. Appended
// and never prepended, so every diagnostic position in the user's file is unchanged. A
// file defining its own `vltCount` gets a duplicate-export error, reported as failure.
function cliTestProtocol() {
  "\nexport { vltCount, vltNameLen, vltNameAt, vltSkipped, vltRun, vltFailLen, vltFailAt } from \"std:test\"\n"
}

// Compile in the host's pool when it has one. A single file goes through it too, as one
// worker, so it shares the host's compile cache; `--jobs 1` over several files compiles in
// this instance, one file at a time.
function cliTestStart() {
  if (
    cliTestPoolMode == 1
    && cliFiles.length >= 1
    && (cliFiles.length == 1 || cliTestJobs != 1)
  ) {
    cliTestEnqIdx = 0
    return cliTestEnqueueNext()
  }
  cliStartTestFile()
}

// Queue the next discovered file for the pool, or — all queued — ask the host to
// compile them. Outcomes come back through `cliTestCompiledCommit`, in queue order.
function cliTestEnqueueNext() {
  if cliTestEnqIdx >= cliFiles.length {
    cliState = ST_TEST_POOLED
    return CMD_TEST_COMPILE
  }
  cliCmdPath = cliFiles[cliTestEnqIdx]
  cliTestEnqIdx = cliTestEnqIdx + 1
  cliState = ST_TEST_ENQUEUED
  CMD_TEST_ENQUEUE
}

// A pool worker's end: exit 0 once the host holds its module, 1 with the file's report
// entry in `cliCmdData` when it did not compile.
function cliTestWorkerDone(code: CliExit, msg: string) {
  cliCmdData = msg
  cliExit = code
  cliState = ST_DONE
  CMD_DONE
}

// The check loop. With a host pool and two or more roots, every root is queued for the
// pool first. `--fix` writes files and `--codegen` hands each module to the engine, so
// both keep every root in this instance. A worker checks each root the host hands it.
function cliCheckStart() {
  cliWiStart()
  if cliCheckPoolMode == 2 { return cliCheckWorkerBegin() }
  if (
    cliCheckPoolMode == 1
    && cliFiles.length >= 2
    && cliFix == 0
    && cliCodegen == 0
  ) {
    cliCheckEnqIdx = 0
    if cliWiOn {
      cliWiReadIdx = 0
      cliWiImports = []
      return cliWiReadNext()
    }
    return cliCheckEnqueueNext()
  }
  cliStartFile()
}

// ── serving a root from an importer's check (`wiArm`) ─────────────────────────
// A plain check of two or more roots arms the driver to serve a root whose whole check an
// earlier root's check already holds. The pool queues importers first, so a worker meets a
// root's importer before the root; the report keeps the walk's order either way.
let cliWiOn = false
let cliWiReadIdx = 0
// Per root, the module keys its source imports directly.
let cliWiImports: string[][] = []
// The queue order, as indices into `cliFiles`, and how many outcomes the pool has committed.
let cliWiPerm: i32[] = []
// Per queue slot, the slot whose check can serve it (`cliCheckParentOf`).
let cliWiParent: i32[] = []
let cliWiCommits = 0

function cliWiStart() {
  cliWiOn = cliFiles.length >= 2
    && cliFix == 0
    && cliCodegen == 0
    && cliBudget == 0
  cliWiPerm = []
  cliWiCommits = 0
  cliWiParent = []
  cliWiRows = Map()
  if !cliWiOn {
    wiArm(0, 0)
    return 0
  }
  wiArm(1, 0)
  for f in cliFiles { wiTargetAdd(f) }
  0
}

// Read the next root for its imports, or — all read — queue the roots importers first.
function cliWiReadNext() {
  while cliWiReadIdx < cliFiles.length {
    const path = cliFiles[cliWiReadIdx]
    const ci = cliSrcCacheGet(path)
    if ci < 0 {
      cliCmdPath = path
      cliState = ST_WI_READ
      return CMD_READ_FILE
    }
    cliWiImports.push(
      cliWiImportsOf(path, cliSrcCacheSrcs[ci], cliSrcCacheFound[ci]),
    )
    cliWiReadIdx = cliWiReadIdx + 1
  }
  cliWiPerm = cliWiOrder()
  cliCheckEnqueueNext()
}

// The module keys source `src` of root `path` imports, as its own check resolves them.
function cliWiImportsOf(path: string, src: string, found: i32): string[] {
  const out: string[] = []
  if found == 0 || cliNeedsModules(src) == 0 { return out }
  modReset()
  cliModCommitOne(path, src, 1)
  let k = 0
  while k < modPendingCount() {
    out.push(cliPendingKey(k))
    k = k + 1
  }
  modReset()
  out
}

// The roots ordered by how many other roots each reaches through roots' imports, most
// first, the walk's order breaking ties.
function cliWiOrder(): i32[] {
  const ix: {[string]: i32} = Map()
  let f = 0
  while f < cliFiles.length {
    ix[wiKeyOf(cliFiles[f])] = f
    f = f + 1
  }
  const reach: i32[] = []
  const reaches: i32[][] = []
  f = 0
  while f < cliFiles.length {
    const seen: boolean[] = []
    for _ in cliFiles { seen.push(false) }
    seen[f] = true
    const work: i32[] = [f]
    let w = 0
    while w < work.length {
      const row = if work[w] < cliWiImports.length { cliWiImports[work[w]] } else { [] }
      for key in row {
        const d = ix[key] ?? -1
        if d >= 0 && !seen[d] {
          seen[d] = true
          work.push(d)
        }
      }
      w = w + 1
    }
    reach.push(work.length - 1)
    reaches.push(work)
    f = f + 1
  }
  const perm: i32[] = []
  const done: boolean[] = []
  for _ in cliFiles { done.push(false) }
  while perm.length < cliFiles.length {
    let best = -1
    let g = 0
    while g < cliFiles.length {
      if !done[g] && (best < 0 || reach[g] > reach[best]) { best = g }
      g = g + 1
    }
    done[best] = true
    perm.push(best)
  }
  // Each root's latest earlier reacher, in one pass over the reach lists.
  const pos: i32[] = []
  const last: i32[] = []
  for _ in cliFiles {
    pos.push(0)
    last.push(-1)
  }
  let i = 0
  while i < perm.length {
    pos[perm[i]] = i
    i = i + 1
  }
  i = 0
  while i < perm.length {
    for d in reaches[perm[i]] {
      if pos[d] > i { last[d] = i }
    }
    i = i + 1
  }
  cliWiParent = []
  for r in perm { cliWiParent.push(last[r]) }
  perm
}

// The latest queue slot before `j` whose root reaches slot `j`'s through roots' imports, or
// -1. A pool that checks that slot and then `j` on one instance lets `j` meet the importer
// check that holds it, so the slots form a forest the pool keeps together.
export function cliCheckParentOf(j: i32): i32 {
  if j < 0 || j >= cliWiParent.length { return -1 }
  cliWiParent[j]
}

// The root the pool's `j`th queue slot holds.
function cliWiSlot(j: i32): i32 {
  if j < cliWiPerm.length { return cliWiPerm[j] }
  j
}

// A worker begins root `cliCheckPick`, baselining the report so its payload is that
// root's contribution alone. With no root left to check it ends.
function cliCheckWorkerBegin() {
  if cliCheckPick < 0 {
    cliState = ST_DONE
    return CMD_DONE
  }
  cliPwBase = []
  cliPwNotes = []
  if cliCheckPick >= cliFiles.length { return cliCheckWorkerDone() }
  cliFileIdx = cliCheckPick
  // Both are read only by the run's summary, which a worker never reaches; cleared, they
  // defer only the root that set them, so the instance goes on to its next root.
  cliBatchUnread = 0
  cliInvalidModule = 0
  cliPwBase = [
    cliOut.length,
    cliJsonItems.length,
    cliBatchOut.length,
    cliErrors,
    cliWarnings,
    cliGating,
    cliStdHidden,
    cliStdHiddenWarn,
    cliImpHidden,
    cliImpHiddenWarn,
  ]
  cliStartFile()
}

// Queue the next root for the pool, or — all queued — ask the host to check them.
// Outcomes come back through `cliCheckPooledCommit`, in queue order.
function cliCheckEnqueueNext() {
  if cliCheckEnqIdx >= cliFiles.length {
    cliState = ST_CHECK_POOLED
    return CMD_CHECK_POOL
  }
  const root = cliWiSlot(cliCheckEnqIdx)
  if root < 0 || root >= cliFiles.length || root >= cliFileFromDir.length {
    cliState = ST_CHECK_POOLED
    return CMD_CHECK_POOL
  }
  cliCmdPath = cliFiles[root]
  cliCmdData = i32ToStr(cliFileFromDir[root])
  cliCheckEnqIdx = cliCheckEnqIdx + 1
  cliState = ST_CHECK_ENQUEUED
  CMD_CHECK_ENQUEUE
}

// A worker's root is done: `EXIT_OK` with its payload in `cliCmdData`, or `EXIT_FAILED` when the
// parent must check the root itself. That is a root whose report reads run-wide state:
// the missing-import scan, an unreadable `--batch` entry, an invalid module. Either way
// the host hands this instance its next root through `cliCheckNextRoot`.
function cliCheckWorkerDone() {
  cliExit = EXIT_FAILED
  cliCmdData = ""
  if (
    cliPwBase.length > 0
    && cliSibTried == 0
    && cliBatchUnread == 0
    && cliInvalidModule == 0
  ) {
    cliExit = EXIT_OK
    cliCmdData = cliPwPayload()
  }
  cliState = ST_CHECK_NEXT
  CMD_CHECK_ROOT_DONE
}

// The worker's root as one string of fields, each `<n>:` for an integer or `<bytes>:`
// then that many bytes for a string: the root's path, its tally deltas, then the report
// lines, `--json` items, `--batch` records and `--budget` notes it appended.
function cliPwPayload() {
  const buf: i32[] = []
  cliPwStr(buf, cliFiles[cliCheckPick])
  cliPwInt(buf, cliErrors - cliPwBase[3])
  cliPwInt(buf, cliWarnings - cliPwBase[4])
  cliPwInt(buf, cliGating - cliPwBase[5])
  cliPwInt(buf, cliStdHidden - cliPwBase[6])
  cliPwInt(buf, cliStdHiddenWarn - cliPwBase[7])
  cliPwInt(buf, cliImpHidden - cliPwBase[8])
  cliPwInt(buf, cliImpHiddenWarn - cliPwBase[9])
  cliPwList(buf, cliOut, cliPwBase[0])
  cliPwList(buf, cliJsonItems, cliPwBase[1])
  cliPwList(buf, cliBatchOut, cliPwBase[2])
  cliPwList(buf, cliPwNotes, 0)
  fromCodePoints(buf)
}
function cliPwInt(buf: i32[], n: i32) {
  pushCps(buf, i32ToStr(n))
  buf.push(':')
  0
}
function cliPwStr(buf: i32[], s: string) {
  cliPwInt(buf, s.length)
  pushCps(buf, s)
  0
}
function cliPwList(buf: i32[], xs: string[], from: i32) {
  cliPwInt(buf, xs.length - from)
  let i = from
  while i < xs.length {
    cliPwStr(buf, xs[i])
    i = i + 1
  }
  0
}

// The payload readers, over `cliPpSrc` from `cliPpPos`.
function cliPpInt() {
  let n = 0
  while cliPpPos < cliPpSrc.length && cliPpSrc[cliPpPos] != ':' {
    n = n * 10 + (cliPpSrc[cliPpPos] - '0')
    cliPpPos = cliPpPos + 1
  }
  cliPpPos = cliPpPos + 1
  n
}
function cliPpStr() {
  const n = cliPpInt()
  const s = cliPpSrc.slice(cliPpPos, cliPpPos + n)
  cliPpPos = cliPpPos + n
  s
}

// The integer `s` spells in decimal, as `i32ToStr` wrote it.
function cliDigits(s: string) {
  let n = 0
  let i = 0
  if s.length > 0 && s[0] == '-' { i = 1 }
  while i < s.length {
    n = n * 10 + (s[i] - '0')
    i = i + 1
  }
  if s.length > 0 && s[0] == '-' { return 0 - n }
  n
}

// Fold root `f`'s pooled payload into the run, as checking it here would have. The
// per-root `cliLastStage`/`cliDirMode` are not carried: the summary reads them only for
// a run of one root, which never pools.
function cliPoolApply(f: i32) {
  cliPpSrc = cliPoolPayload[f]
  cliPoolPayload[f] = ""
  cliPpPos = 0
  cliPpStr()
  cliErrors = cliErrors + cliPpInt()
  cliWarnings = cliWarnings + cliPpInt()
  cliGating = cliGating + cliPpInt()
  cliStdHidden = cliStdHidden + cliPpInt()
  cliStdHiddenWarn = cliStdHiddenWarn + cliPpInt()
  cliImpHidden = cliImpHidden + cliPpInt()
  cliImpHiddenWarn = cliImpHiddenWarn + cliPpInt()
  let n = cliPpInt()
  while n > 0 {
    cliOut.push(cliPpStr())
    n = n - 1
  }
  n = cliPpInt()
  while n > 0 {
    cliJsonItems.push(cliPpStr())
    n = n - 1
  }
  n = cliPpInt()
  while n > 0 {
    cliBatchOut.push(cliPpStr())
    n = n - 1
  }
  n = cliPpInt()
  while n >= 5 {
    const code = cliPpStr()
    const rel = cliPpStr()
    const line = cliDigits(cliPpStr())
    const col = cliDigits(cliPpStr())
    budgetNote(code, rel, line, col, cliPpStr())
    n = n - 5
  }
  cliPpSrc = ""
  0
}

// Begin the next test file, or — work-list exhausted — move on to collection.
function cliStartTestFile() {
  if cliFileIdx >= cliFiles.length { return cliTestBeginCollect() }
  cliCurFile = cliFiles[cliFileIdx]
  if cliFileIdx < cliFileFromDir.length {
    cliDirMode = cliFileFromDir[cliFileIdx]
  }
  cliTestFileErr.push("")
  const ci = cliSrcCacheGet(cliCurFile)
  if ci >= 0 && cliSrcCacheFound[ci] != 0 {
    cliEntrySrc = cliSrcCacheSrcs[ci] + cliTestProtocol()
    return cliTestBeginCompile()
  }
  cliCmdPath = cliCurFile
  cliState = ST_TEST_READ
  CMD_READ_FILE // — the test file's source
}

// Record why the current file produced no tests and move to the next one. The message
// is the file's report entry; the run never stops for it.
function cliTestFileFailed(msg: string) {
  if cliTestPoolMode == 2 { return cliTestWorkerDone(EXIT_FAILED, msg) }
  cliTestFileErr[cliFileIdx] = msg
  cliFileIdx = cliFileIdx + 1
  cliStartTestFile()
}

// Set up the module table for the current test file and drive its fetch loop. A test
// file always imports (the appended protocol re-export is one), so module mode is
// unconditional — no `cliHasImports` gate.
function cliTestBeginCompile() {
  modReset()
  cliModMode = 1
  cliModKeys = [cliCurFile]
  cliModSrcs = [cliEntrySrc]
  cliDiagLineCacheMod = -1
  cliModCommitOne(cliCurFile, cliEntrySrc, 1)
  cliTestFetchOrCompile()
}

// Fetch the current file's remaining imports (from the per-run cache when we have
// them), then compile.
function cliTestFetchOrCompile() {
  while modPendingCount() > 0 {
    const key = cliPendingKey(0)
    const ci = cliSrcCacheGet(key)
    if ci < 0 {
      cliFetchKey = key
      cliCmdPath = key
      cliState = ST_TEST_FETCH
      return CMD_READ_FILE
    }
    cliModKeys.push(key)
    cliModSrcs.push(cliSrcCacheSrcs[ci])
    cliModCommitOne(key, cliSrcCacheSrcs[ci], cliSrcCacheFound[ci])
  }
  cliTestCompileNow()
}

// Emit the current test file's module. Success hands the bytes to the host to
// hold (CMD_TEST_STASH reads them straight out of the driver's `rbyte*` buffer);
// failure becomes this file's one report line.
function cliTestCompileNow() {
  const rc = compileSrc()
  if rc != 0 {
    cliClearDiags()
    const n = diagCount()
    let i = 0
    while i < n {
      cliAddDiagSpan(
        "error",
        diagStage(i),
        "",
        diagLine(i),
        diagCol(i),
        diagEndLine(i),
        diagEndCol(i),
        vcDiagMsg(i),
        diagModule(i),
      )
      i = i + 1
    }
    let stage = "emit"
    if rc == 1 { stage = "parse" }
    if rc == 2 { stage = "type" }
    let msg = stage + " error"
    let d = 0
    while d < dgMsg.length {
      msg = msg + "\n" + cliFmtConcise(d)
      d = d + 1
    }
    return cliTestFileFailed(msg)
  }
  cliTestStash.push(cliCurFile)
  cliTestStashOf.push(cliFileIdx)
  cliCmdPath = cliCurFile
  cliState = ST_TEST_STASH
  CMD_TEST_STASH // — the host keeps the module now in rbyte*
}

// Every file compiled: ask the host to instantiate the stashed modules and read their
// registries back. Nothing stashed — every file failed to compile, or none exist —
// skips straight to the report.
function cliTestBeginCollect() {
  if cliTestStash.length == 0 { return cliTestReport() }
  cliState = ST_TEST_COLLECT
  CMD_TEST_COLLECT
}

// The plan: every collected test, in collection order, minus the ones `-t` filters
// out. `itSkip` entries stay in the plan — the host reports them skipped off
// `vltRun`'s return value, so the skip decision has exactly one owner (`std:test`).
function cliTestPlanRun() {
  cliPlanEntry = []
  let i = 0
  while i < cliTestName.length {
    if strContains(cliTestName[i], cliTestFilter) { cliPlanEntry.push(i) }
    i = i + 1
  }
  if cliPlanEntry.length == 0 { return cliTestReport() }
  cliState = ST_TEST_RUN
  CMD_TEST_RUN
}

// One report line for a test, `<status> <name>`, with the failure message and any
// captured output indented beneath it.
function cliTestEmitResult(k: i32) {
  const e = cliPlanEntry[k]
  const status = cliResStatus[k]
  if status == 2 {
    cliTestSkipped = cliTestSkipped + 1
    cliOut.push("  " + cliAnsi(cliColor, "2", "skip") + " " + cliTestName[e])
    return 0
  }
  if status == 0 {
    cliTestPassed = cliTestPassed + 1
    cliOut.push("  " + cliAnsi(cliColor, "32", "ok  ") + " " + cliTestName[e])
    return 0
  }
  cliTestFailed = cliTestFailed + 1
  cliOut.push("  " + cliAnsi(cliColor, "31", "FAIL") + " " + cliTestName[e])
  cliTestEmitIndented(cliResMsg[k])
  if cliResOut[k].length > 0 {
    cliOut.push("       " + cliAnsi(cliColor, "2", "--- captured output ---"))
    cliTestEmitIndented(cliResOut[k])
  }
  0
}

// Push `text` into the report indented under a failing test, one line per line —
// a compiler diagnostic block and a captured-output block are both multi-line.
function cliTestEmitIndented(text: string) {
  if text.length == 0 { return 0 }
  const lines = cliSplitLines(text)
  let i = 0
  while i < lines.length {
    if !(i == lines.length - 1 && lines[i].length == 0) {
      cliOut.push("       " + lines[i])
    }
    i = i + 1
  }
  0
}

// The whole report: one block per file, then the summary. Deterministic — files
// in sorted order, tests in registration order — however the host scheduled them.
function cliTestReport() {
  let f = 0
  while f < cliFiles.length {
    cliOut.push(cliAnsi(cliColor, "1", cliFiles[f]))
    if cliTestFileErr[f].length > 0 {
      cliTestFailed = cliTestFailed + 1
      cliOut.push("  " + cliAnsi(cliColor, "31", "FAIL") + " <compile>")
      cliTestEmitIndented(cliTestFileErr[f])
    } else {
      cliTestEmitFileTests(f)
    }
    f = f + 1
  }
  const noun = cliPlural(cliFiles.length, "file")
  let text = noun
    + " · "
    + i32ToStr(cliTestPassed)
    + " passed · "
    + i32ToStr(cliTestFailed)
    + " failed"
  if cliTestSkipped > 0 {
    text = text + " · " + i32ToStr(cliTestSkipped) + " skipped"
  }
  let code = "32"
  if cliTestFailed > 0 { code = "31" }
  cliOut.push(cliAnsi(cliColor, code, text))
  cliExit = EXIT_OK
  if cliTestFailed > 0 { cliExit = EXIT_FAILED }
  cliBeginPrint()
}

// The per-test lines of file `f` (a cliFiles index): every plan entry that
// belongs to it, plus the two file-level outcomes that produce no tests at all.
function cliTestEmitFileTests(f: i32) {
  let stash = -1
  let s = 0
  while s < cliTestStashOf.length {
    if cliTestStashOf[s] == f { stash = s }
    s = s + 1
  }
  if stash < 0 { return 0 }
  if cliTestFileStatus[stash] != 0 {
    cliTestFailed = cliTestFailed + 1
    cliOut.push("  " + cliAnsi(cliColor, "31", "FAIL") + " <file top level>")
    cliTestEmitIndented(cliTestFileMsg[stash])
    return 0
  }
  let shown = 0
  let k = 0
  while k < cliPlanEntry.length {
    if cliTestOwner[cliPlanEntry[k]] == stash {
      cliTestEmitResult(k)
      shown = shown + 1
    }
    k = k + 1
  }
  if shown == 0 { cliOut.push("  " + cliAnsi(cliColor, "2", "no tests") + "") }
  0
}

// ── the `vl test` protocol: what the host reads ──────────────────────────────
// The plan, as (stashed file, test index within that file) pairs, plus the worker
// count. `cliTestJobsWanted() == 0` means the host's choice, one per core.
export function cliTestPlanCount(): i32 { cliPlanEntry.length }
export function cliTestPlanFile(k: i32): i32 { cliTestOwner[cliPlanEntry[k]] }
export function cliTestPlanTest(k: i32): i32 { cliTestLocal[cliPlanEntry[k]] }
export function cliTestJobsWanted(): i32 { cliTestJobs }

// ── the `vl test` protocol: what the host commits ────────────────────────────
// Before the first `cliNext`, after argv: 1 = this host has a compile pool, 2 = this
// instance is one of its workers (compile the one target, stash or fail, stop).
export function cliTestPoolStage(mode: i32) {
  cliTestPoolMode = mode
  0
}
// One pooled file's compile outcome, in queue order: 0 = the host stashed its module,
// 1 = it did not compile, with the file's report entry on the shared `cliResult`.
export function cliTestCompiledCommit(status: i32) {
  const f = cliTestFileErr.length
  const msg = cpAccTake(cliResultAcc)
  if f >= cliFiles.length { return 0 }
  if status == 0 {
    cliTestFileErr.push("")
    cliTestStash.push(cliFiles[f])
    cliTestStashOf.push(f)
  } else {
    // A NAMED file that cannot be read is a usage error, as in the serial path.
    if cliFileFromDir[f] == 0 && msg == "cannot read " + cliFiles[f] {
      cliTestUnreadable = msg
    }
    cliTestFileErr.push(msg)
  }
  0
}
// ── the `vl check` root pool: what the host commits ─────────────────────────
// Before the first `cliNext`, after argv: `mode` 1 = this host has a root pool, 2 = this
// instance is one of its workers, checking root `pick` of the walk.
export function cliCheckPoolStage(mode: i32, pick: i32) {
  cliCheckPoolMode = mode
  cliCheckPick = pick
  0
}
// A worker's copy of one root of the parent's walk, in walk order: the path on the
// shared `cliResult`, `fromDir` as the parent's `CMD_CHECK_ENQUEUE` reported it.
export function cliCheckPresetRoot(fromDir: i32) {
  cliPresetFiles.push(cpAccTake(cliResultAcc))
  cliPresetFromDir.push(fromDir)
  0
}
// A worker's next root after `CMD_CHECK_ROOT_DONE`: `pick` of the walk, or -1 to end.
export function cliCheckNextRoot(pick: i32) {
  cliCheckPick = pick
  0
}
// One pooled root's outcome, in queue order: 0 = its worker's payload is on the shared
// `cliResult`, anything else = this instance checks the root itself. A payload naming a
// different root (the tree changed under the walk) is checked here too.
export function cliCheckPooledCommit(status: i32) {
  const payload = cpAccTake(cliResultAcc)
  // Queued importers first, the slots name roots out of order: every root starts as
  // checked here, and each outcome fills its own.
  if cliWiCommits == 0 {
    while cliPoolStatus.length < cliFiles.length {
      cliPoolStatus.push(1)
      cliPoolPayload.push("")
    }
  }
  const j = cliWiCommits
  cliWiCommits = cliWiCommits + 1
  const f = cliWiSlot(j)
  if (
    f < 0
    || f >= cliFiles.length
    || f >= cliPoolStatus.length
    || f >= cliPoolPayload.length
  ) {
    return 0
  }
  let st = 1
  if status == 0 {
    cliPpSrc = payload
    cliPpPos = 0
    if cliPpStr() == cliFiles[f] { st = 0 }
    cliPpSrc = ""
  }
  cliPoolStatus[f] = st
  if st == 0 { cliPoolPayload[f] = payload }
  0
}
// A test name, one code point at a time (the `cliDirNamePush` idiom).
export function cliTestNamePush(c: i32) {
  cliTestNameAcc.push(c)
  0
}
// End of one test's name, for the file currently being collected. `skip` is the
// registry's own `vltSkipped(i)`.
export function cliTestNameCommit(skip: i32) {
  cliTestOwner.push(cliTestFileStatus.length)
  cliTestLocal.push(cliTestLocalNext)
  cliTestName.push(fromCodePoints(cliTestNameAcc))
  cliTestSkip.push(skip)
  cliTestLocalNext = cliTestLocalNext + 1
  cliTestNameAcc = []
  0
}
// End of one stashed file's registry. `status` 0 = instantiated and read, 1 = its top
// level trapped, with the message on the shared `cliResult` channel. Files commit in
// stash order, so `cliTestFileStatus.length` is the stash index being collected, which
// is what the names above attribute to.
export function cliTestFileCommit(status: i32) {
  cliTestFileStatus.push(status)
  cliTestFileMsg.push(cpAccTake(cliResultAcc))
  cliTestLocalNext = 0
  0
}
// Captured output of the test result being committed.
export function cliTestOutPush(c: i32) {
  cliTestOutAcc.push(c)
  0
}
// One plan entry's outcome: 0 = passed, 1 = failed, 2 = skipped. The failure
// message rides the shared `cliResult` channel; the captured output rides
// `cliTestOutPush`. `k` is the plan index, asserted rather than assumed so a
// mis-ordered host commit cannot silently attribute a failure to another test.
export function cliTestResultCommit(k: i32, status: i32) {
  while cliResStatus.length < k {
    cliResStatus.push(0)
    cliResMsg.push("")
    cliResOut.push("")
  }
  cliResStatus.push(status)
  cliResMsg.push(cpAccTake(cliResultAcc))
  cliResOut.push(fromCodePoints(cliTestOutAcc))
  cliTestOutAcc = []
  0
}

// ── the state machine ────────────────────────────────────────────────────────
// Transition into the print phase and return the first output command. A pending
// `--json` payload goes first, to stdout; the stderr lines — notes like the `--fix`
// count — drain after it.
function cliBeginPrint() {
  cliOutIdx = 0
  cliState = ST_PRINT
  if cliJsonOut.length > 0 {
    cliCmdData = cliJsonOut
    cliJsonOut = ""
    return CMD_PRINT_OUT
  }
  cliEmitNextOut()
}
function cliEmitNextOut() {
  if cliBatchIdx < cliBatchOut.length {
    cliCmdData = cliBatchOut[cliBatchIdx]
    cliBatchIdx = cliBatchIdx + 1
    return CMD_PRINT_OUT
  }
  if cliOutIdx < cliOut.length {
    cliCmdData = cliOut[cliOutIdx]
    cliOutIdx = cliOutIdx + 1
    return CMD_PRINT_ERR
  }
  cliState = ST_DONE
  CMD_DONE
}
// Ask the host whether target `cliTargetIdx` is a directory. One target is the
// ordinary case; `--batch` names several and each expands the same way, in turn.
function cliClassifyTarget() {
  cliFile = cliTargets[cliTargetIdx]
  // Strip trailing `/`s off the target (keep a bare `/`): child paths are built as
  // `base + "/" + name`, so `vl check compiler/` would otherwise label every file
  // `compiler//file.vl`.
  while cliFile.length > 1 && cliFile[cliFile.length - 1] == '/' {
    cliFile = cliFile.slice(0, cliFile.length - 1)
  }
  cliTargetFileBase = cliFiles.length
  cliDirNames = []
  cliDirIsDirs = []
  cliCmdPath = cliFile
  cliState = ST_CLASSIFY
  CMD_LIST_DIR
}
// Advance the directory walk: list the next pending dir, or — this target done — sort
// its slice and either classify the next target or begin the per-file check loop.
function cliWalkStep() {
  if cliWalkStack.length > 0 {
    cliCurDir = cliWalkStack[cliWalkStack.length - 1]
    cliCurRel = cliWalkRel[cliWalkRel.length - 1]
    cliWalkStack = cliPopLast(cliWalkStack)
    cliWalkRel = cliPopLast(cliWalkRel)
    cliDirNames = []
    cliDirIsDirs = []
    cliCmdPath = cliCurDir
    cliState = ST_WALK
    return CMD_LIST_DIR
  }
  cliSortFilesFrom(cliTargetFileBase)
  if cliTargetIdx + 1 < cliTargets.length {
    cliTargetIdx = cliTargetIdx + 1
    return cliClassifyTarget()
  }
  if cliFiles.length == 0 && cliCmd == 2 {
    cliOut = ["test: no *.test.vl files found under " + cliFile]
    cliExit = EXIT_OK
    return cliBeginPrint()
  }
  if cliFiles.length == 0 && cliCmd == 0 {
    cliOut = ["check: no .vl files found under " + cliFile]
    // --json still delivers a parseable (empty) array on stdout. `--batch` says it with
    // zero records instead — its stdout is records, never an array.
    if cliJson != 0 && cliBatch == 0 { cliJsonOut = "[]\n" }
    cliExit = EXIT_OK
    return cliBeginPrint()
  }
  cliValIdx = 0
  cliValidateNext()
}

// Several paths: every named file must exist before any is checked, formatted or run, so a
// typo in the last path cannot leave the first ones half fixed. A read that succeeds is
// cached for the work loop. One path, or `--batch`, keeps its own per-file answer.
function cliValidateNext() {
  if cliBatch == 0 && cliTargets.length > 1 {
    while cliValIdx < cliFiles.length {
      const f = cliFiles[cliValIdx]
      if cliFileFromDir[cliValIdx] == 0 && cliSrcCacheGet(f) < 0 {
        cliCmdPath = f
        cliState = ST_VALIDATE_READ
        return CMD_READ_FILE
      }
      cliValIdx = cliValIdx + 1
    }
  }
  cliFileIdx = 0
  cliStartWork()
}

// The subcommand's name, for a usage line.
function cliSubName(): string {
  if cliCmd == 1 { return "fmt" }
  if cliCmd == 2 { return "test" }
  "check"
}

// Add `path` to the work-list unless an earlier target already named the same file (the
// spellings `./a.vl` and `a.vl` are one file). `--batch` keeps every entry: its records
// line up with the caller's list.
function cliAddFile(path: string, fromDir: i32) {
  if cliBatch == 0 {
    const key = cliPathKey(path)
    if cliFileKeys.has(key) { return 0 }
    cliFileKeys.set(key, 1)
  }
  cliFiles.push(path)
  cliFileFromDir.push(fromDir)
  0
}

// `path` with `.` and `..` segments and repeated `/`s removed, for comparing two spellings.
// Lexical: a `..` cancels the segment before it, and one above the root of an absolute path
// is dropped, so a symlinked directory can make two different files share a key.
function cliPathKey(path: string): string {
  const segs: string[] = []
  const abs = path.length > 0 && path[0] == '/'
  let start = 0
  let i = 0
  while i <= path.length {
    if i == path.length || path[i] == '/' {
      const seg = path.slice(start, i)
      if seg == ".." {
        if segs.length > 0 && segs[segs.length - 1] != ".." { segs.pop() }
        else if !abs { segs.push(seg) }
      } else if seg != "" && seg != "." {
        segs.push(seg)
      }
      start = i + 1
    }
    i = i + 1
  }
  let out = ""
  if abs { out = "/" }
  let k = 0
  while k < segs.length {
    if k > 0 { out = out + "/" }
    out = out + segs[k]
    k = k + 1
  }
  out
}

// Expand the targets (the working directory when none is named) and walk the first.
function cliBeginTargets() {
  if cliCheckPoolMode == 2 && cliPresetFiles.length > 0 {
    cliFiles = cliPresetFiles
    cliFileFromDir = cliPresetFromDir
    cliFileIdx = 0
    return cliStartWork()
  }
  if cliTargets.length == 0 { cliTargets = ["."] }
  cliTargetIdx = 0
  cliClassifyTarget()
}

// Dispatch the per-file loop on the subcommand: `check` runs the checker, `fmt`
// reformats.
function cliStartWork() {
  if cliCmd == 1 { return cliStartFmtFile() }
  if cliCmd == 2 { return cliTestStart() }
  cliCheckStart()
}
// Begin checking cliFiles[cliFileIdx] (read its source), or — work-list done —
// build the summary and start printing.
function cliStartFile() {
  if cliCheckPoolMode == 2 && cliFileIdx != cliCheckPick {
    return cliCheckWorkerDone()
  }
  // Roots the pool already checked contribute their payload here, in root order, so a
  // root this instance checks itself lands between them exactly where it always did.
  while cliFileIdx < cliPoolStatus.length && cliPoolStatus[cliFileIdx] == 0 {
    cliPoolApply(cliFileIdx)
    cliFileIdx = cliFileIdx + 1
  }
  if cliFileIdx >= cliFiles.length {
    if cliBudget == 3 { return cliBudgetGitRead(budgetGitStart()) }
    if cliBudget != 0 { cliBudgetFinish() } else { cliFinishSummary() }
    return cliBeginPrint()
  }
  cliCurFile = cliFiles[cliFileIdx]
  // A NAMED path is checked as `vl check <file>` checks it (whole-graph lint, a missing
  // file is an error); one the walk found keeps the directory run's shape.
  cliDirMode = cliFileFromDir[cliFileIdx]
  cliSibTried = 0
  mimpExtraSet([], [])
  cliFileFixed = 0
  cliFixRound = 0
  cliFixPhase = FIXP_OFF
  cliFixOrig = ""
  cliFixEditClear()
  cliFixKeep = []
  cliSitesClear(cliFixDecl)
  // Already read this run as another file's dependency? Check it from the cache, with
  // no host round-trip. A cached miss (found = 0) falls through to a real read.
  const ci = cliSrcCacheGet(cliCurFile)
  if ci >= 0 && cliSrcCacheFound[ci] != 0 {
    cliEntrySrc = cliSrcCacheSrcs[ci]
    return cliBeginCheck()
  }
  cliCmdPath = cliCurFile
  cliState = ST_CHECK_READ
  CMD_READ_FILE // — the file's source
}
// For the current file: fetch the next pending module — from the per-run source
// cache when this run already read it, else from the host — or, graph closed,
// check it and advance to the next file.
function cliFetchOrCheckFile() {
  while modPendingCount() > 0 {
    const key = cliPendingKey(0)
    const ci = cliSrcCacheGet(key)
    if ci < 0 {
      cliFetchKey = key
      cliCmdPath = key
      cliState = ST_CHECK_FETCH
      return CMD_READ_FILE
    }
    cliModKeys.push(key)
    cliModSrcs.push(cliSrcCacheSrcs[ci])
    cliModCommitOne(key, cliSrcCacheSrcs[ci], cliSrcCacheFound[ci])
  }
  // cliCheckCurFile reports + advances to the next file itself — or, for --fix,
  // returns CMD_WRITE_FILE mid-way to write the fixed source (then re-check).
  cliCheckCurFile()
}
// Begin checking the current file's source (cliEntrySrc): set up module mode if it
// imports, then run the fetch-or-check loop. Shared by the plain and `--fix` paths.
function cliBeginCheck() {
  modReset()
  // Unconditional, unlike `lintSetPath` below: `checkMemSharedOrigin` (D2355) needs
  // the RAW path even when this file has no imports at all.
  checkEntryPathSet(cliCurFile)
  cliModKeys = []
  cliModSrcs = []
  cliDiagLineCacheMod = -1
  if cliNeedsModules(cliEntrySrc) != 0 {
    cliModMode = 1
    cliModKeys.push(cliCurFile)
    cliModSrcs.push(cliEntrySrc)
    cliModCommitOne(cliCurFile, cliEntrySrc, 1)
  } else {
    cliModMode = 0
  }
  cliFetchOrCheckFile()
}

// The directory part of `path`, "" when it has none.
function cliDirOf(path: string): string {
  let i = path.length - 1
  while i >= 0 {
    if path[i] == '/' { return path.slice(0, i) }
    i = i - 1
  }
  ""
}

// Queue the current file's candidates outside the module graph: every file of a directory
// run, else the `.vl` files beside it, which needs a listing first.
function cliSibBegin() {
  cliSibQueue = []
  if cliDirMode != 0 {
    for f in cliFiles {
      if f != cliCurFile { cliSibQueue.push(f) }
    }
    cliSibQEnd = cliSibQueue.length
    return cliSibReadNext()
  }
  cliDirNames = []
  cliDirIsDirs = []
  cliCmdPath = cliDirOf(cliCurFile)
  if cliCmdPath == "" { cliCmdPath = "." }
  cliState = ST_SIB_LIST
  CMD_LIST_DIR
}

// Queue the `.vl` files the listing of the current file's directory named.
function cliSibListed() {
  const dir = cliDirOf(cliCurFile)
  let i = 0
  while i < cliDirNames.length {
    if cliDirIsDirs[i] == 0 && cliEndsVl(cliDirNames[i]) {
      let path = cliDirNames[i]
      if dir != "" { path = dir + "/" + path }
      if path != cliCurFile { cliSibQueue.push(path) }
    }
    i = i + 1
  }
  cliSibQEnd = cliSibQueue.length
  cliSibReadNext()
}

// Scan the next unscanned candidate, from the source cache or the host; with none left,
// offer every scanned export to the checker and re-check the current file.
function cliSibReadNext() {
  while cliSibQEnd > 0 {
    cliSibQEnd = cliSibQEnd - 1
    const key = cliSibQueue[cliSibQEnd]
    if !cliSibScanned.has(key) {
      const ci = cliSrcCacheGet(key)
      if ci < 0 {
        cliFetchKey = key
        cliCmdPath = key
        cliState = ST_SIB_READ
        return CMD_READ_FILE
      }
      cliSibScan(key, cliSrcCacheSrcs[ci], cliSrcCacheFound[ci])
    }
  }
  const names: string[] = []
  const specs: string[] = []
  let r = 0
  while r < cliSibExpKey.length {
    if cliSibExpKey[r] != cliCurFile {
      const spec = mimpRelSpec(cliCurFile, cliSibExpKey[r])
      if spec != "" {
        names.push(cliSibExpName[r])
        specs.push(spec)
      }
    }
    r = r + 1
  }
  mimpExtraSet(names, specs)
  cliBeginCheck()
}

// Record candidate `key`'s exported names (none when it could not be read).
function cliSibScan(key: string, src: string, found: i32) {
  cliSibScanned.set(key, 1)
  if found == 0 { return 0 }
  const names = modExportNamesOf(src)
  if names == null {
    cliSibSkipped.push(key)
    return 0
  }
  for n in names {
    cliSibExpKey.push(key)
    cliSibExpName.push(n)
  }
  0
}

// ── check --fix ──────────────────────────────────────────────────────────────

// Collect the auto-fix edits for `src` into `cliFixEdit`, ordered by start offset,
// from the safe fixes: prefer-const, a redundant annotation's `: T ` span becoming one
// space, and an unused import's specifier removed. Unused-variable is not fixed — the `_`
// prefix silences a warning. Precondition: the module-aware check and lint ran over `src`.
function cliCollectFixes(src: string) {
  cliFixEditClear()
  const n = cliLintCount()
  // The absolute offset where each 0-based line begins.
  const starts = [0]
  let s = 0
  while s < src.length {
    if src[s] == '\n' { starts.push(s + 1) }
    s = s + 1
  }
  const pos = cliFixEdit.pos
  const len = cliFixEdit.len
  const txt = cliFixEdit.txt
  const what = cliFixEdit.what
  const eln = cliFixEdit.line
  const ecl = cliFixEdit.col
  // The `{` of each import clause holding an unused-import finding, and every finding's offset.
  const impLb: i32[] = []
  const impOff: i32[] = []
  let k = 0
  while k < n {
    const code = cliLintCodeAt(k)
    const ln = cliLintLineAt(k) - 1
    const col = cliLintColAt(k)
    // Entry module only, like the redundant-annotation block below: a graph lint
    // carries other modules' findings, whose positions do not map onto `src`.
    if cliLintModAt(k) == 0 && ln >= 0 && ln < starts.length {
      const off = starts[ln] + col
      if code == "prefer-const" {
        if (
          off + 3 <= src.length
          && src[off] == 'l'
          && src[off + 1] == 'e'
          && src[off + 2] == 't'
        ) {
          pos.push(off)
          len.push(3)
          txt.push("const")
          what.push("prefer-const")
          eln.push(ln + 1)
          ecl.push(col)
        }
      } else if code == "unused-import" {
        const lb = cliImportBraceOf(src, off)
        if lb >= 0 {
          let seen = false
          for x in impLb {
            if x == lb { seen = true }
          }
          if !seen { impLb.push(lb) }
          impOff.push(off)
        }
      }
    }
    k = k + 1
  }
  for lb in impLb {
    cliImportFixEdits(src, lb, impOff, starts, "unused import")
  }
  cliZeroBytesEdits(src, starts)
  cliCastEdits(src, starts)
  cliGenBindEdits(starts, src.length)
  cliNamedOrderEdits(starts, src.length)
  cliMissingImportEdits(src, starts)
  // Redundant binding annotations: `let x: T = init` → `let x = init`, the checker's
  // depth-aware span replaced by one space; entry module only. A return annotation is
  // signature documentation, so it is hinted but never removed here.
  let rk = 0
  while rk < redunCount() {
    if redunModuleAt(rk) == 0 && !redunIsReturnAt(rk) {
      const sl = redunSLineAt(rk) - 1
      const el = redunELineAt(rk) - 1
      if sl >= 0 && sl < starts.length && el >= 0 && el < starts.length {
        const so = starts[sl] + redunSColAt(rk)
        const eo = starts[el] + redunEColAt(rk)
        if so >= 0 && eo > so && eo <= src.length {
          pos.push(so)
          len.push(eo - so)
          txt.push(" ")
          what.push("redundant type annotation")
          eln.push(sl + 1)
          ecl.push(redunSColAt(rk))
        }
      }
    }
    rk = rk + 1
  }
  // An inferred export parameter: insert its annotation after the name (D3817).
  let ek = 0
  while ek < expInfCount() {
    if expInfModuleAt(ek) == 0 {
      const el = expInfLineAt(ek) - 1
      if el >= 0 && el < starts.length {
        const eo = starts[el] + expInfEndAt(ek)
        if eo >= 0 && eo <= src.length {
          pos.push(eo)
          len.push(0)
          txt.push(": " + expInfTypeAt(ek))
          what.push("inferred export parameter")
          eln.push(el + 1)
          ecl.push(expInfEndAt(ek))
        }
      }
    }
    ek = ek + 1
  }
  // Order the edits by start offset ascending, so `cliApplyFixEdits` can splice in one
  // forward pass and an edit's index stays stable across the verify trials.
  let a = 1
  while a < pos.length {
    const kp = pos[a]
    const kl = len[a]
    const kt = txt[a]
    const kw = what[a]
    const kln = eln[a]
    const kcl = ecl[a]
    let b = a - 1
    while b >= 0 && pos[b] > kp {
      pos[b + 1] = pos[b]
      len[b + 1] = len[b]
      txt[b + 1] = txt[b]
      what[b + 1] = what[b]
      eln[b + 1] = eln[b]
      ecl[b + 1] = ecl[b]
      b = b - 1
    }
    pos[b + 1] = kp
    len[b + 1] = kl
    txt[b + 1] = kt
    what[b + 1] = kw
    eln[b + 1] = kln
    ecl[b + 1] = kcl
    a = a + 1
  }
  0
}

// Whether `src[i]` is a space or a tab.
function cliBlankAt(src: string, i: i32) { src[i] == ' ' || src[i] == '\t' }

// Whether `src[i]` is a space, a tab or a line break.
function cliSpaceAt(src: string, i: i32) {
  cliBlankAt(src, i) || src[i] == '\n' || src[i] == '\r'
}

// The `{` of the `import { … } from "…"` clause around offset `off`, where `import` opens
// its line; -1 when the text is not that plain shape (a comment in the clause, say), which
// leaves the finding unfixed rather than guessing at an edit.
function cliImportBraceOf(src: string, off: i32) {
  let b = off - 1
  while b >= 0 && src[b] != '{' {
    if src[b] == '}' || src[b] == '/' || src[b] == '"' { return -1 }
    b = b - 1
  }
  if b < 0 { return -1 }
  let k = b - 1
  while k >= 0 && cliBlankAt(src, k) { k = k - 1 }
  if k < 5 || src.slice(k - 5, k + 1) != "import" { return -1 }
  if k - 6 >= 0 && src[k - 6] != '\n' { return -1 }
  b
}

// The offset of the `}` closing the clause opened at `lb`; -1 past a comment or the end.
function cliImportRBrace(src: string, lb: i32) {
  let r = lb + 1
  while r < src.length && src[r] != '}' {
    if src[r] == '/' { return -1 }
    r = r + 1
  }
  if r >= src.length { return -1 }
  r
}

// The end of the import statement whose clause closes at `rb`: just past its line's newline,
// or the source end. -1 unless only `from "…"`, blanks and an optional `;` follow the `}`.
// `cliImportStd` is set to whether the path names a `std:` module.
let cliImportStd = false
function cliImportStmtEnd(src: string, rb: i32) {
  cliImportStd = false
  let q = rb + 1
  while q < src.length && cliBlankAt(src, q) { q = q + 1 }
  if q + 4 > src.length || src.slice(q, q + 4) != "from" { return -1 }
  q = q + 4
  while q < src.length && cliBlankAt(src, q) { q = q + 1 }
  if q >= src.length || src[q] != '"' { return -1 }
  cliImportStd = q + 5 <= src.length && src.slice(q + 1, q + 5) == "std:"
  q = q + 1
  while q < src.length && src[q] != '"' && src[q] != '\n' { q = q + 1 }
  if q >= src.length || src[q] != '"' { return -1 }
  q = q + 1
  while q < src.length && (cliBlankAt(src, q) || src[q] == ';') { q = q + 1 }
  if q == src.length { return q }
  if src[q] == '\n' { return q + 1 }
  if src[q] == '\r' && q + 1 < src.length && src[q + 1] == '\n' { return q + 2 }
  -1
}

// The 1-based line holding offset `off`, given each line's start offset.
function cliLineOfOff(starts: i32[], off: i32) {
  let i = 0
  while i + 1 < starts.length && starts[i + 1] <= off { i = i + 1 }
  i + 1
}

// Push the edits that remove the unused specifiers of the import clause opened at `lb`; a
// specifier is unused when an offset in `offs` falls in it. A removal takes one adjacent
// comma with it. A clause left empty drops the whole statement, but only for a `std:`
// module: dropping a module of the program's own would skip its top-level statements.
function cliImportFixEdits(
  src: string,
  lb: i32,
  offs: i32[],
  starts: i32[],
  what: string,
) {
  const rb = cliImportRBrace(src, lb)
  if rb < 0 { return 0 }
  // Each specifier's content span, trimmed of blanks and newlines.
  const cs: i32[] = []
  const ce: i32[] = []
  let seg = lb + 1
  let i = lb + 1
  while i <= rb {
    if i == rb || src[i] == ',' {
      let a = seg
      let e = i
      while a < e && cliSpaceAt(src, a) { a = a + 1 }
      while e > a && cliSpaceAt(src, e - 1) { e = e - 1 }
      if e > a {
        cs.push(a)
        ce.push(e)
      }
      seg = i + 1
    }
    i = i + 1
  }
  const unused: boolean[] = []
  let lastKept = -1
  let j = 0
  while j < cs.length {
    let hit = false
    for o in offs {
      if o >= cs[j] && o <= ce[j] { hit = true }
    }
    unused.push(hit)
    if !hit { lastKept = j }
    j = j + 1
  }
  if lastKept < 0 {
    const end = cliImportStmtEnd(src, rb)
    if end < 0 || !cliImportStd { return 0 }
    let st = lb
    while st > 0 && src[st - 1] != '\n' { st = st - 1 }
    cliPushFixEdit(st, end - st, what, starts)
    return 0
  }
  // Before the last kept specifier, a removal runs to the next one's start; after it, the
  // trailing run goes as one edit from the kept one's end.
  j = 0
  while j < lastKept {
    if unused[j] { cliPushFixEdit(cs[j], cs[j + 1] - cs[j], what, starts) }
    j = j + 1
  }
  if lastKept < cs.length - 1 {
    const from = ce[lastKept]
    cliPushFixEdit(from, ce[cs.length - 1] - from, what, starts)
  }
  0
}

// Empty every `cliFixEdit` column.
function cliFixEditClear() {
  cliFixEdit.pos = []
  cliFixEdit.len = []
  cliFixEdit.txt = []
  cliFixEdit.what = []
  cliFixEdit.line = []
  cliFixEdit.col = []
  0
}

// Empty every column of `t`.
function cliSitesClear(t: CliSiteCols) {
  t.line = []
  t.col = []
  t.text = []
  0
}

// Append one deletion of `len` code units at `off` to the `cliFixEdit` rows.
function cliPushFixEdit(off: i32, len: i32, what: string, starts: i32[]) {
  cliPushFixRepl(off, len, "", what, starts)
}

// Append one replacement of `len` code units at `off` by `txt` to the `cliFixEdit` rows.
function cliPushFixRepl(
  off: i32,
  len: i32,
  txt: string,
  what: string,
  starts: i32[],
) {
  const ln = cliLineOfOff(starts, off)
  cliFixEdit.pos.push(off)
  cliFixEdit.len.push(len)
  cliFixEdit.txt.push(txt)
  cliFixEdit.what.push(what)
  cliFixEdit.line.push(ln)
  cliFixEdit.col.push(off - starts[ln - 1])
  0
}

// Diagnostic `i` is a cast that does nothing: note its span and the operand length it keeps.
function cliNoteCastFix(i: i32) {
  if vcDiagCode(i) != "redundant-cast" { return 0 }
  const kv = cliDataVals(vcDiagData(i), "keep")
  if kv.length != 1 { return 0 }
  let keep = 0
  for c in kv[0] {
    if c < '0' || c > '9' { return 0 }
    keep = keep * 10 + (c - '0')
  }
  cliRc.line.push(diagLine(i))
  cliRc.col.push(diagCol(i))
  cliRc.endLine.push(diagEndLine(i))
  cliRc.endCol.push(diagEndCol(i))
  cliRc.keep.push(keep)
  cliRc.what.push("redundant cast")
  0
}

// Diagnostic `i` is a JavaScript `===` or `!==`: note its span, of which the fix keeps the first two
// characters.
function cliNoteStrictEqFix(i: i32) {
  if vcDiagCode(i) != STRICT_EQ_CODE { return 0 }
  if diagLine(i) != diagEndLine(i) || diagEndCol(i) - diagCol(i) != 3 {
    return 0
  }
  cliRc.line.push(diagLine(i))
  cliRc.col.push(diagCol(i))
  cliRc.endLine.push(diagEndLine(i))
  cliRc.endCol.push(diagEndCol(i))
  cliRc.keep.push(2)
  cliRc.what.push("strict equality")
  0
}

// The edits shortening each noted span to the prefix it keeps: a cast to its operand, `!==` to `!=`.
function cliCastEdits(src: string, starts: i32[]) {
  let k = 0
  while k < cliRc.line.length {
    const sl = cliRc.line[k] - 1
    const el = cliRc.endLine[k] - 1
    if sl >= 0 && sl < starts.length && el >= 0 && el < starts.length {
      const so = starts[sl] + cliRc.col[k]
      const eo = starts[el] + cliRc.endCol[k]
      if (
        so >= 0
        && eo <= src.length
        && cliRc.keep[k] > 0
        && so + cliRc.keep[k] < eo
      ) {
        cliPushFixRepl(
          so,
          eo - so,
          src.slice(so, so + cliRc.keep[k]),
          cliRc.what[k],
          starts,
        )
      }
    }
    k = k + 1
  }
  0
}

// Diagnostic `i` asks for an import with exactly one exporter: note the specifier and the
// module. An undeclared name and a UFCS method share the payload's `member` and `modules`.
function cliNoteImportFix(i: i32) {
  const code = vcDiagCode(i)
  if code != "missing-import" && code != "ufcs-not-imported" { return 0 }
  const data = vcDiagData(i)
  const mods = cliDataVals(data, "modules")
  const member = cliDataVals(data, "member")
  if mods.length != 1 || member.length != 1 { return 0 }
  // An aliased import also needs the call respelled, which this edit cannot do, so it is left
  // to the author rather than re-proposed under a fresh alias every round.
  if cliDataVals(data, "alias").length > 0 { return 0 }
  cliImpAdd(member[0], mods[0], code == "ufcs-not-imported")
}

// Diagnostic `i` refuses a `filled(n, 0)` delivered into a `u8[]`: note the call's span.
function cliNoteZeroBytesFix(i: i32) {
  if vcDiagCode(i) != "filled-zero-bytes" { return 0 }
  cliZb.line.push(diagLine(i))
  cliZb.col.push(diagCol(i))
  cliZb.endLine.push(diagEndLine(i))
  cliZb.endCol.push(diagEndCol(i))
  0
}

// Diagnostic `i` refuses a concrete function written to a `let` that keeps its generic type:
// note where the annotation goes, once per binding (D3960).
function cliNoteGenBindFix(i: i32) {
  if vcDiagCode(i) != "generic-binding-concrete-write" { return 0 }
  const data = vcDiagData(i)
  const annot = cliDataVals(data, "annot")
  const line = cliDataVals(data, "line")
  const col = cliDataVals(data, "col")
  if annot.length != 1 || line.length != 1 || col.length != 1 { return 0 }
  const ln = cliDecI32(line[0])
  const cl = cliDecI32(col[0])
  let k = 0
  while k < cliGb.line.length {
    if cliGb.line[k] == ln && cliGb.col[k] == cl { return 0 }
    k = k + 1
  }
  cliGb.line.push(ln)
  cliGb.col.push(cl)
  cliGb.text.push(annot[0])
  0
}

// The non-negative decimal `t` as an i32; a non-digit ends it.
function cliDecI32(t: string): i32 {
  let v = 0
  for c in t {
    if c < '0' || c > '9' { return v }
    v = v * 10 + (c - '0')
  }
  v
}

// The edits for the noted generic bindings: `: <type>` after each one's name.
function cliGenBindEdits(starts: i32[], srcLen: i32) {
  let k = 0
  while k < cliGb.line.length {
    const l = cliGb.line[k] - 1
    if l >= 0 && l < starts.length {
      const off = starts[l] + cliGb.col[k]
      if off >= 0 && off <= srcLen {
        cliPushFixRepl(
          off,
          0,
          ": " + cliGb.text[k],
          "annotate the binding",
          starts,
        )
      }
    }
    k = k + 1
  }
  0
}

// Diagnostic `i` refuses a positional argument after a misplaced named one: note the name each
// positional argument after it takes, once per argument (D4061).
function cliNoteNamedOrderFix(i: i32) {
  if vcDiagCode(i) != "named-arg-out-of-position" { return 0 }
  const data = vcDiagData(i)
  const names = cliDataVals(data, "name")
  const lines = cliDataVals(data, "line")
  const cols = cliDataVals(data, "col")
  if names.length != lines.length || names.length != cols.length { return 0 }
  let a = 0
  while a < names.length {
    const ln = cliDecI32(lines[a])
    const cl = cliDecI32(cols[a])
    let seen = false
    let k = 0
    while k < cliNo.line.length {
      if cliNo.line[k] == ln && cliNo.col[k] == cl { seen = true }
      k = k + 1
    }
    if !seen {
      cliNo.line.push(ln)
      cliNo.col.push(cl)
      cliNo.text.push(names[a])
    }
    a = a + 1
  }
  0
}

// The edits for the noted positional arguments: `<name>: ` before each one.
function cliNamedOrderEdits(starts: i32[], srcLen: i32) {
  let k = 0
  while k < cliNo.line.length {
    const l = cliNo.line[k] - 1
    if l >= 0 && l < starts.length {
      const off = starts[l] + cliNo.col[k]
      if off >= 0 && off <= srcLen {
        cliPushFixRepl(
          off,
          0,
          cliNo.text[k] + ": ",
          "name the argument",
          starts,
        )
      }
    }
    k = k + 1
  }
  0
}

// The edits for the noted `filled(n, 0)` calls: each becomes `zeroBytes(n)`, and `zeroBytes`
// is asked of `std:bytes`. A span whose text is not `filled(<n>, <fill>)` is left alone.
function cliZeroBytesEdits(src: string, starts: i32[]) {
  let k = 0
  while k < cliZb.line.length {
    const sl = cliZb.line[k] - 1
    const el = cliZb.endLine[k] - 1
    if sl >= 0 && sl < starts.length && el >= 0 && el < starts.length {
      const so = starts[sl] + cliZb.col[k]
      const eo = starts[el] + cliZb.endCol[k]
      const comma = cliZbCountEnd(src, so, eo)
      if comma > 0 {
        let a = so + 7
        while a < comma && cliSpaceAt(src, a) { a = a + 1 }
        let b = comma
        while b > a && cliSpaceAt(src, b - 1) { b = b - 1 }
        const n = src.slice(a, b)
        cliPushFixRepl(
          so,
          eo - so,
          "zeroBytes(" + n + ")",
          "zero bytes",
          starts,
        )
        if !cliZbImported(src) { cliImpAdd("zeroBytes", "std:bytes", false) }
      }
    }
    k = k + 1
  }
  0
}

// Whether `src`'s `std:bytes` import clause already names `zeroBytes`.
function cliZbImported(src: string): boolean {
  const rb = cliImportClauseOf(src, "std:bytes")
  if rb < 0 { return false }
  let lb = rb
  while lb > 0 && src[lb] != '{' { lb = lb - 1 }
  src.slice(lb, rb).includes("zeroBytes")
}

// The offset of the comma ending `n` in a `filled(n, <fill>)` spanning `[so, eo)`, else -1:
// the first comma outside brackets, followed by at most a trailing one, and no string, char
// literal or comment anywhere in the call (the rewrite would drop or move it).
function cliZbCountEnd(src: string, so: i32, eo: i32) {
  if so < 0 || eo > src.length || eo - so < 11 { return -1 }
  if src.slice(so, so + 7) != "filled(" || src[eo - 1] != ')' { return -1 }
  let depth = 0
  let comma = -1
  let trail = -1
  let q = so + 7
  while q < eo - 1 {
    const c = src[q]
    if c == '(' || c == '[' || c == '{' {
      depth = depth + 1
    } else if c == ')' || c == ']' || c == '}' {
      depth = depth - 1
    } else if c == '"' || c == '\'' || c == '`' {
      return -1
    } else if c == '/' && (src[q + 1] == '/' || src[q + 1] == '*') {
      return -1
    } else if c == ',' && depth == 0 {
      if trail >= 0 { return -1 }
      if comma >= 0 { trail = q } else { comma = q }
    } else if trail >= 0 && !cliSpaceAt(src, q) {
      return -1
    }
    if depth < 0 { return -1 }
    q = q + 1
  }
  comma
}

// A name two modules are asked for is a clash when a plain use asked: either import alone
// would refuse the other, so neither is added. Two method calls (`s.lastIndexOf`,
// `xs.lastIndexOf`) each import their receiver's module, which receiver overloading allows.
function cliImpAdd(item: string, spec: string, method: boolean) {
  const local = cliImpLocal(item)
  let k = 0
  while k < cliImpAsk.item.length {
    if cliImpLocal(cliImpAsk.item[k]) == local {
      if cliImpAsk.spec[k] == spec { return 0 }
      if !method || !cliImpAsk.method[k] {
        cliImpClash.push(local)
        return 0
      }
    }
    k = k + 1
  }
  cliImpAsk.method.push(method)
  cliImpAsk.item.push(item)
  cliImpAsk.spec.push(spec)
  0
}

// The name an import specifier binds: the alias after `as`, else the specifier.
function cliImpLocal(item: string): string {
  let i = item.length - 1
  while i >= 0 && item[i] != ' ' { i = i - 1 }
  item.slice(i + 1, item.length)
}

// The values of `key` in a diagnostic payload: netstrings read as alternating key and value.
function cliDataVals(data: string, key: string): string[] {
  const out: string[] = []
  let isKey = true
  let keyHit = false
  let i = 0
  while i < data.length {
    let len = 0
    while i < data.length && data[i] != ':' {
      len = len * 10 + (data[i] - '0')
      i = i + 1
    }
    const v = data.slice(i + 1, i + 1 + len)
    i = i + len + 2
    if isKey { keyHit = v == key }
    else if keyHit { out.push(v) }
    isKey = !isKey
  }
  out
}

// The `}` of the top-level `import { … } from "<spec>"` in `src`, else -1.
function cliImportClauseOf(src: string, spec: string) {
  let ls = 0
  while ls < src.length {
    const rb = cliImportRBraceAtLine(src, ls)
    if rb >= 0 && cliImportSpecAfter(src, rb) == spec { return rb }
    while ls < src.length && src[ls] != '\n' { ls = ls + 1 }
    ls = ls + 1
  }
  -1
}

// Where a new import goes: past the last top-level import statement of any form, else past
// the leading run of blank and `//` lines, so a header comment stays first.
function cliImportsEnd(src: string) {
  let end = -1
  let ls = 0
  while ls < src.length {
    let eol = ls
    while eol < src.length && src[eol] != '\n' { eol = eol + 1 }
    let next = eol
    if eol < src.length { next = eol + 1 }
    const rb = cliImportRBraceAtLine(src, ls)
    if rb >= 0 {
      const e = cliImportStmtEnd(src, rb)
      if e > end { end = e }
    } else if cliIsImportLine(src, ls) && next > end {
      end = next
    }
    ls = next
  }
  if end >= 0 { return end }
  cliHeaderEnd(src)
}

// Whether the line at `ls` opens an `import` statement: the keyword, then a blank, `{` or `*`.
function cliIsImportLine(src: string, ls: i32): boolean {
  if ls + 7 > src.length || src.slice(ls, ls + 6) != "import" { return false }
  const c = src[ls + 6]
  c == ' ' || c == '\t' || c == '{' || c == '*'
}

// The offset just past the leading run of blank and `//` lines: the header comment block.
function cliHeaderEnd(src: string) {
  let ls = 0
  while ls < src.length {
    let q = ls
    while q < src.length && cliBlankAt(src, q) { q = q + 1 }
    const blank = q >= src.length || src[q] == '\n' || src[q] == '\r'
    const comment = q + 1 < src.length && src[q] == '/' && src[q + 1] == '/'
    if !blank && !comment { return ls }
    while q < src.length && src[q] != '\n' { q = q + 1 }
    if q >= src.length { return src.length }
    ls = q + 1
  }
  ls
}

// The `}` closing the clause of an `import {` that opens the line at `ls`, else -1.
function cliImportRBraceAtLine(src: string, ls: i32) {
  if ls + 6 > src.length || src.slice(ls, ls + 6) != "import" { return -1 }
  let q = ls + 6
  while q < src.length && cliBlankAt(src, q) { q = q + 1 }
  if q >= src.length || src[q] != '{' { return -1 }
  cliImportRBrace(src, q)
}

// The specifier text of the `from "…"` after the clause closing at `rb`, else "".
function cliImportSpecAfter(src: string, rb: i32): string {
  if cliImportStmtEnd(src, rb) < 0 { return "" }
  const q = cliImportSpecStart(src, rb)
  let e = q
  while e < src.length && src[e] != '"' { e = e + 1 }
  src.slice(q, e)
}

// The offset just inside the opening quote of the `from "…"` after `rb`.
function cliImportSpecStart(src: string, rb: i32) {
  let q = rb + 1
  while q < src.length && src[q] != '"' { q = q + 1 }
  q + 1
}

// The edits for the imports this file's errors ask for. A name exported by exactly one other
// module moves there first. Each added name then joins an existing import of its module, or
// a new statement after the last import.
function cliMissingImportEdits(src: string, starts: i32[]) {
  let mv = 0
  while mv < mimpMovedMod.length {
    if mimpMovedMod[mv] == 0 {
      cliMovedImportEdit(
        src,
        starts,
        mimpMovedName[mv],
        mimpMovedFrom[mv],
        mimpMovedTo[mv],
      )
    }
    mv = mv + 1
  }
  let fresh = ""
  const done: string[] = []
  let k = 0
  while k < cliImpAsk.spec.length {
    const spec = cliImpAsk.spec[k]
    if !strListHas(done, spec) {
      done.push(spec)
      let list = ""
      let j = k
      while j < cliImpAsk.spec.length {
        if (
          cliImpAsk.spec[j] == spec
          && !strListHas(cliImpClash, cliImpLocal(cliImpAsk.item[j]))
        ) {
          if list != "" { list = list + ", " }
          list = list + cliImpAsk.item[j]
        }
        j = j + 1
      }
      const rb = cliImportClauseOf(src, spec)
      if list == "" {
        // Every name asked of this module clashed.
      } else if rb >= 0 {
        let q = rb - 1
        while q > 0 && cliSpaceAt(src, q) { q = q - 1 }
        let txt = ", " + list
        if src[q] == '{' { txt = " " + list }
        else if src[q] == ',' { txt = " " + list + "," }
        cliPushFixRepl(q + 1, 0, txt, "missing import", starts)
      } else {
        fresh = fresh + "import { " + list + " } from \"" + spec + "\"\n"
      }
    }
    k = k + 1
  }
  if fresh != "" {
    const at = cliImportsEnd(src)
    if at > 0 && src[at - 1] != '\n' { fresh = "\n" + fresh }
    cliPushFixRepl(at, 0, fresh, "missing import", starts)
  }
  0
}

// The edit for `name`, imported from `from` but exported by `to` alone: the specifier
// becomes `to` when `name` is the clause's only one, else that one name moves to `to`.
function cliMovedImportEdit(
  src: string,
  starts: i32[],
  name: string,
  from: string,
  to: string,
) {
  const rb = cliImportClauseOf(src, from)
  if rb < 0 { return 0 }
  let lb = rb - 1
  while lb >= 0 && src[lb] != '{' { lb = lb - 1 }
  // Each specifier's trimmed span; the one whose first word is `name` moves.
  let count = 0
  let hitAt = -1
  let hitEnd = -1
  let seg = lb + 1
  let i = lb + 1
  while i <= rb {
    if i == rb || src[i] == ',' {
      let a = seg
      let e = i
      while a < e && cliSpaceAt(src, a) { a = a + 1 }
      while e > a && cliSpaceAt(src, e - 1) { e = e - 1 }
      if e > a {
        count = count + 1
        let w = a
        while w < e && !cliSpaceAt(src, w) { w = w + 1 }
        if src.slice(a, w) == name {
          hitAt = a
          hitEnd = e
        }
      }
      seg = i + 1
    }
    i = i + 1
  }
  if hitAt < 0 { return 0 }
  if count == 1 {
    const q = cliImportSpecStart(src, rb)
    return cliPushFixRepl(q, from.length, to, "moved import", starts)
  }
  cliImportFixEdits(src, lb, [hitAt], starts, "moved import")
  cliImpAdd(src.slice(hitAt, hitEnd), to, false)
}

// `src` with every edit whose `keep` flag is set applied. A single forward pass into a
// code-point buffer: copy the gap before each edit, append its replacement, skip the
// replaced span. The two safe fixes never overlap; a defensive `>= cur` guard drops
// any that somehow would.
function cliApplyFixEdits(src: string, keep: i32[]) {
  const buf: i32[] = []
  let cur = 0
  let e = 0
  while e < cliFixEdit.pos.length {
    const p = cliFixEdit.pos[e]
    if keep[e] != 0 && p >= cur {
      // The gap and the replacement both go in as code points: `buf.push(src[g])` would
      // push bytes into a code-point buffer, and `src.slice` is an O(1) view.
      pushCps(buf, src.slice(cur, p))
      pushCps(buf, cliFixEdit.txt[e])
      cur = p + cliFixEdit.len[e]
    }
    e = e + 1
  }
  pushCps(buf, src.slice(cur, src.length))
  fromCodePoints(buf)
}

// ── verify-and-revert: the trial ladder (D1091) ──────────────────────────────

// `ok` is the verdict on the candidate `cliEntrySrc` just compiled. Advance the phase
// and either start the next trial or commit: `ALL` ok commits everything, broken asks
// whether the file built at all; `BASE` broken commits everything, since no edit can
// have broken it; `BASE` ok starts greedy from the empty set; `ONE` records one edit.
function cliFixVerdict(ok: i32) {
  const n = cliFixEdit.pos.length
  if cliFixPhase == FIXP_ALL {
    if ok != 0 { return cliFixCommit() }
    cliFixPhase = FIXP_BASE
    let z = 0
    while z < n {
      cliFixKeep[z] = 0
      z = z + 1
    }
    cliEntrySrc = cliFixOrig
    return cliBeginCheck()
  }
  if cliFixPhase == FIXP_BASE {
    if ok == 0 {
      // Already broken before the fix — `runs -> not-runs` is not reachable here.
      let z = 0
      while z < n {
        cliFixKeep[z] = 1
        z = z + 1
      }
      return cliFixCommit()
    }
    // One edit and the whole-file trial failed ⇒ that edit is the culprit; the
    // greedy pass would only re-derive it at the cost of one more compile.
    if n == 1 { return cliFixCommit() }
    cliFixPhase = FIXP_ONE
    cliFixTrial = 0
    cliFixKeep[0] = 1
    cliEntrySrc = cliApplyFixEdits(cliFixOrig, cliFixKeep)
    return cliBeginCheck()
  }
  // FIXP_ONE
  if ok == 0 { cliFixKeep[cliFixTrial] = 0 }
  cliFixTrial = cliFixTrial + 1
  if cliFixTrial >= n { return cliFixCommit() }
  cliFixKeep[cliFixTrial] = 1
  cliEntrySrc = cliApplyFixEdits(cliFixOrig, cliFixKeep)
  cliBeginCheck()
}

// Count one applied fix of kind `what` toward the summary.
function cliFixTally(what: string) {
  let i = 0
  while i < cliFixKinds.length {
    if cliFixKinds[i] == what {
      cliFixKindN[i] = cliFixKindN[i] + 1
      return 0
    }
    i = i + 1
  }
  cliFixKinds.push(what)
  cliFixKindN.push(1)
  0
}

// The current file has no round left to run: fold its last round's declined edits and
// its round count into the run's totals.
function cliFixFileDone() {
  cliFileFixed = 1
  cliFixDeclined = cliFixDeclined + cliFixDecl.text.length
  if cliFixRound > cliFixRoundsMax { cliFixRoundsMax = cliFixRound }
  0
}

// The accepted edit set is final: tally it, leave verification, and hand the
// result to the report path — writing the file only when it actually changed.
function cliFixCommit() {
  let kept = 0
  cliSitesClear(cliFixDecl)
  let ki = 0
  while ki < cliFixKeep.length {
    if cliFixKeep[ki] != 0 {
      kept = kept + 1
      cliFixTally(cliFixEdit.what[ki])
    } else if ki < cliFixEdit.what.length {
      cliFixDecl.text.push(cliFixEdit.what[ki])
      cliFixDecl.line.push(cliFixEdit.line[ki])
      cliFixDecl.col.push(cliFixEdit.col[ki])
    }
    ki = ki + 1
  }
  cliFixCount = cliFixCount + kept
  cliFixPhase = FIXP_OFF
  const out = cliApplyFixEdits(cliFixOrig, cliFixKeep)
  cliEntrySrc = out
  // A round that changed nothing is the last; its declined edits are the report's.
  if out == cliFixOrig {
    cliFixFileDone()
    return cliBeginCheck()
  }
  cliFixRound = cliFixRound + 1
  cliSitesClear(cliFixDecl)
  // Keep the per-run source cache coherent with the rewrite the host is
  // about to perform, so later files that import this one see the fix.
  cliSrcCachePut(cliCurFile, out, 1)
  cliCmdPath = cliCurFile
  cliCmdData = out
  cliState = ST_FIX_WROTE
  CMD_WRITE_FILE
}

// Begin formatting cliFiles[cliFileIdx] (read its source), or — work-list done —
// finish (the `--check` drift report / exit code).
function cliStartFmtFile() {
  if cliFileIdx >= cliFiles.length { return cliFmtFinish() }
  cliCurFile = cliFiles[cliFileIdx]
  cliDirMode = cliFileFromDir[cliFileIdx]
  cliCmdPath = cliCurFile
  cliState = ST_FMT_READ
  CMD_READ_FILE
}
// One stderr line for a failed `fmt` of `path`; `status` is `cliFormatNow`'s nonzero
// result. An unparseable input (1) reports its first parse diagnostic; a round-trip
// gate trip (2) is a formatter bug and leaves the file unchanged, which it says loudly.
function cliFmtFailNote(path: string, status: i32) {
  if status == 2 {
    cliFmtBug = cliFmtBug + 1
    cliOut.push(
      "fmt: "
        + path
        + ": formatter produced invalid output — file left unchanged, please report",
    )
    return 0
  }
  cliFmtBad = cliFmtBad + 1
  let msg = "parse error"
  if diagCount() > 0 {
    const line = diagLine(0)
    if line > 0 {
      msg = msg + " [" + i32ToStr(line) + ":" + i32ToStr(diagCol(0) + 1) + "]"
    }
    msg = msg + ": " + vcDiagMsg(0)
  }
  cliOut.push("fmt: " + path + ": " + msg + " — not formatted")
  0
}

// End of the fmt work-list: compute the exit code and drain any accumulated stderr
// lines. Drift gates only under `--check` (exit 1); an unparseable input outranks
// drift (exit 2); a round-trip gate trip outranks both (exit 3), since a formatter bug
// must never look like mere drift.
function cliFmtFinish() {
  cliExit = EXIT_OK
  if cliFmtCheck != 0 && cliFmtDrift > 0 { cliExit = EXIT_FAILED }
  if cliFmtBad > 0 { cliExit = EXIT_USAGE }
  if cliFmtBug > 0 { cliExit = EXIT_FMT_BUG }
  if cliOut.length > 0 { return cliBeginPrint() }
  cliState = ST_DONE
  CMD_DONE
}

// ST_INIT: parse the arguments and start the command they name.
function cliStepInit() {
  cliParseArgs()
  if cliArgErr != "" { return cliUsageStop(cliArgErr) }
  if cliArgs.length == 0 { return cliUsageStop("vl: no subcommand") }
  const sub = cliArgs[0]
  if sub == "fmt" {
    cliCmd = 1
  } else if sub == "check" {
    cliCmd = 0
  } else if sub == "test" {
    cliCmd = 2
  } else {
    return cliUsageStop(
      "vl: this build's pump implements `check`, `fmt` and `test`",
    )
  }
  cliOut = []
  cliErrors = 0
  cliWarnings = 0
  cliGating = 0
  cliFmtDrift = 0
  cliFmtBad = 0
  cliFmtBug = 0
  cliFixCount = 0
  cliFixDeclined = 0
  cliFixRoundsMax = 0
  cliFixCapHit = 0
  cliFixKinds = []
  cliFixKindN = []
  cliWalkStack = []
  cliWalkRel = []
  cliFiles = []
  cliFileKeys = Map()
  cliDirNames = []
  cliDirIsDirs = []
  cliSrcCacheKeys = []
  cliSrcCacheIx = Map()
  cliSrcCacheSrcs = []
  cliSrcCacheFound = []
  // `fmt` with no path formats stdin to stdout; `check` with no path → cwd.
  if cliCmd == 1 && cliTargets.length == 0 {
    cliState = ST_FMT_STDIN
    return CMD_READ_STDIN
  }
  if cliBudget != 0 {
    cliCmdPath = cliBudgetPath
    cliState = ST_BUDGET_READ
    return CMD_READ_FILE
  }
  return cliBeginTargets()
}

// ST_BUDGET_READ: load the budget baseline, then start the targets.
function cliStepBudgetRead() {
  let err = "cannot read it"
  if cliFileFound != 0 { err = budgetLoad(cliFileSrc) }
  if err != "" {
    return cliUsageStop("check: --budget " + cliBudgetPath + ": " + err)
  }
  if cliBudget == 4 {
    cliJsonOut = budgetExemptLine() + "\n"
    return cliBeginPrint()
  }
  if cliBudgetFindings != "" {
    cliCmdPath = cliBudgetFindings
    cliState = ST_BUDGET_FINDINGS
    return CMD_READ_FILE
  }
  // The baseline names the population it counts; a named path narrows it.
  if cliTargets.length == 0 { cliTargets = budgetTargets() }
  for g in budgetExcludes() { cliAddExclude(g) }
  cliIncludeImports = 1
  return cliBeginTargets()
}

// ST_BUDGET_FINDINGS: note a `--findings` report against the budget.
function cliStepBudgetFindings() {
  let err = "cannot read it"
  if cliFileFound != 0 { err = budgetNoteJson(cliFileSrc, cliBudgetFindings) }
  if err != "" {
    return cliUsageStop("check: --findings " + cliBudgetFindings + ": " + err)
  }
  if cliBudget != 1 && budgetUnnamed() > 0 {
    return cliUsageStop(
      "check: --findings "
        + cliBudgetFindings
        + ": "
        + i32ToStr(budgetUnnamed())
        + " finding(s) carry no `text`, so --budget-why and --write-baseline cannot name them",
    )
  }
  if cliBudget == 3 { return cliBudgetGitRead(budgetGitStart()) }
  cliBudgetFinish()
  return cliBeginPrint()
}

// ST_FMT_STDIN: format stdin to stdout.
function cliStepFmtStdin() {
  // stdin formatted to stdout; `--check` reports drift through the exit code. A
  // failed format passes the input through so a mid-pipeline `vl fmt` never eats the
  // data — the note and nonzero exit carry the failure.
  cliCurFile = "<stdin>"
  cliFiles = []
  cliFileIdx = 0
  const fst = cliFormatNow(cliFileSrc)
  cliFmtResult = cliFileSrc
  if fst == 0 {
    cliFmtResult = vcFmtOut
  } else {
    cliFmtFailNote(cliCurFile, fst)
  }
  if cliFmtCheck != 0 {
    if fst == 0 && cliFmtResult != cliFileSrc { cliFmtDrift = cliFmtDrift + 1 }
    return cliFmtFinish()
  }
  cliCmdData = cliFmtResult
  cliState = ST_FMT_AFTER
  return CMD_PRINT_OUT
}

// ST_FMT_READ: format one file that has been read.
function cliStepFmtRead() {
  if cliFileFound == 0 {
    if cliDirMode == 0 { return cliUsageStop("fmt: cannot read " + cliCurFile) }
    cliFileIdx = cliFileIdx + 1
    return cliStartFmtFile()
  }
  const fst = cliFormatNow(cliFileSrc)
  if fst != 0 {
    // Parse error or gate trip: the file is untouched (and nothing is printed
    // in stdout mode); the note + exit code carry the failure.
    cliFmtFailNote(cliCurFile, fst)
    cliFileIdx = cliFileIdx + 1
    return cliStartFmtFile()
  }
  cliFmtResult = vcFmtOut
  const changed = cliFmtResult != cliFileSrc
  if cliFmtCheck != 0 {
    if changed {
      cliOut.push(cliCurFile + ": not formatted")
      cliFmtDrift = cliFmtDrift + 1
    }
    cliFileIdx = cliFileIdx + 1
    return cliStartFmtFile()
  }
  if cliFmtWrite != 0 {
    if changed {
      cliCmdPath = cliCurFile
      cliCmdData = cliFmtResult
      cliState = ST_FMT_AFTER
      return CMD_WRITE_FILE
    }
    cliFileIdx = cliFileIdx + 1
    return cliStartFmtFile()
  }
  cliCmdData = cliFmtResult
  cliState = ST_FMT_AFTER
  return CMD_PRINT_OUT
}

export function cliNext() {
  // Dispatch on a local copy of the state: `cliState == N` would narrow the global to
  // the literal `N`, and a later `cliState = …` write is then checked against that.
  const st = cliState
  if st == ST_INIT { return cliStepInit() }
  if st == ST_BUDGET_READ { return cliStepBudgetRead() }
  if st == ST_BUDGET_FINDINGS { return cliStepBudgetFindings() }
  if st == ST_BUDGET_GIT {
    return cliBudgetGitRead(budgetGitStep(cliFileFound != 0, cliFileSrc))
  }
  if st == ST_BUDGET_WROTE {
    cliJsonOut = budgetWroteLine(cliBudgetPath) + "\n"
    return cliBeginPrint()
  }
  if st == ST_CLASSIFY {
    if cliDirWasDir != 0 {
      cliDirMode = 1
      cliIngestEntries(cliFile, "")
      return cliWalkStep()
    }
    // A file, or a missing path — the caller NAMED it, so it goes on the work-list as
    // itself and a read miss is reported against it rather than skipped.
    cliDirMode = 0
    cliAddFile(cliFile, 0)
    if cliBatch != 0 || cliTargets.length > 1 { return cliWalkStep() }
    cliFileIdx = 0
    return cliStartWork()
  }
  if st == ST_VALIDATE_READ {
    if cliFileFound == 0 {
      return cliUsageStop(cliSubName() + ": cannot read " + cliFiles[cliValIdx])
    }
    cliSrcCachePut(cliFiles[cliValIdx], cliFileSrc, 1)
    cliValIdx = cliValIdx + 1
    return cliValidateNext()
  }
  if st == ST_WALK {
    cliIngestEntries(cliCurDir, cliCurRel)
    return cliWalkStep()
  }
  if st == ST_CHECK_READ {
    if cliFileFound == 0 {
      // A single-file target that does not exist → cannot read. A collected file
      // that vanished mid-walk → skip it. Under `--batch` neither: the entry gets a
      // record of its own, so the caller's file list and the records line up.
      if cliBatch != 0 { return cliBatchUnreadable() }
      if cliDirMode == 0 {
        return cliUsageStop("check: cannot read " + cliCurFile)
      }
      cliFileIdx = cliFileIdx + 1
      return cliStartFile()
    }
    // Check the file module-aware, resolving its imports. For `--fix`,
    // `cliCheckCurFile` applies the safe edits after the resolved check, writes the
    // source, and re-enters here via `ST_FIX_WROTE`.
    cliEntrySrc = cliFileSrc
    cliSrcCachePut(cliCurFile, cliFileSrc, 1)
    return cliBeginCheck()
  }
  if st == ST_SIB_LIST {
    if cliDirWasDir == 0 { return cliSibReadNext() }
    return cliSibListed()
  }
  if st == ST_SIB_READ {
    cliSrcCachePut(cliFetchKey, cliFileSrc, cliFileFound)
    cliSibScan(cliFetchKey, cliFileSrc, cliFileFound)
    return cliSibReadNext()
  }
  if st == ST_FIX_WROTE {
    // Re-check the fixed source (already in `cliEntrySrc`) module-aware for the report.
    // `cliFileFixed == 1` stops `cliCheckCurFile` re-fixing.
    return cliBeginCheck()
  }
  if st == ST_CHECK_FETCH {
    cliSrcCachePut(cliFetchKey, cliFileSrc, cliFileFound)
    cliModKeys.push(cliFetchKey)
    cliModSrcs.push(cliFileSrc)
    cliModCommitOne(cliFetchKey, cliFileSrc, cliFileFound)
    return cliFetchOrCheckFile()
  }
  if st == ST_FMT_STDIN { return cliStepFmtStdin() }
  if st == ST_FMT_READ { return cliStepFmtRead() }
  if st == ST_FMT_AFTER {
    cliFileIdx = cliFileIdx + 1
    return cliStartFmtFile()
  }
  if st == ST_TEST_READ {
    if cliFileFound == 0 {
      // A named target that does not exist is a usage error; a file that vanished
      // between the walk and the read is one failing entry.
      if cliDirMode == 0 && cliTestPoolMode != 2 {
        return cliUsageStop("test: cannot read " + cliCurFile)
      }
      return cliTestFileFailed("cannot read " + cliCurFile)
    }
    cliSrcCachePut(cliCurFile, cliFileSrc, 1)
    cliEntrySrc = cliFileSrc + cliTestProtocol()
    return cliTestBeginCompile()
  }
  if st == ST_TEST_FETCH {
    cliSrcCachePut(cliFetchKey, cliFileSrc, cliFileFound)
    cliModKeys.push(cliFetchKey)
    cliModSrcs.push(cliFileSrc)
    cliModCommitOne(cliFetchKey, cliFileSrc, cliFileFound)
    return cliTestFetchOrCompile()
  }
  if st == ST_CHECK_VALIDATE { return cliCheckCurFileRest() }
  if st == ST_TEST_STASH {
    if cliTestPoolMode == 2 { return cliTestWorkerDone(EXIT_OK, "") }
    cliFileIdx = cliFileIdx + 1
    return cliStartTestFile()
  }
  if st == ST_TEST_ENQUEUED { return cliTestEnqueueNext() }
  if st == ST_CHECK_ENQUEUED { return cliCheckEnqueueNext() }
  if st == ST_WI_READ {
    cliSrcCachePut(cliFiles[cliWiReadIdx], cliFileSrc, cliFileFound)
    return cliWiReadNext()
  }
  if st == ST_CHECK_NEXT { return cliCheckWorkerBegin() }
  if st == ST_CHECK_POOLED {
    cliFileIdx = 0
    return cliStartFile()
  }
  if st == ST_TEST_POOLED {
    if cliTestUnreadable != "" {
      return cliUsageStop("test: " + cliTestUnreadable)
    }
    return cliTestBeginCollect()
  }
  if st == ST_TEST_COLLECT { return cliTestPlanRun() }
  if st == ST_TEST_RUN { return cliTestReport() }
  if st == ST_PRINT { return cliEmitNextOut() }
  CMD_DONE
}
