// Assignment rows: the type each name target stores and reads at, the open element row of a
// store, and the source/destination stacks an assignability walk keeps against recursion.
// Emptied by `asgRowsReset`. Does not import the checker.
import { ArrayLit, BinExpr, Index, ObjLit, P, nodeAt } from "./ast"
import { TyArray, tyAt } from "./check_types"
import { parenPeelIx } from "./check_places"
import {
  crAfterBank,
  crBeforeBank,
  crCapWidenBank,
  crCondDropBank,
} from "./check_capture_rows"
import { colAt, nodeTyIxOf } from "./check_node_tys"

// Cycle-guard stacks for `assignable` over recursive named types: a (src, dst) pair already
// being compared higher in the recursion is assumed assignable — coinductive, so a
// self-referential `left: Tree | null` terminates instead of expanding.
export let asgSrcStack: i32[] = []
export function asgSrcStackPop() {
  asgSrcStack.pop()
  0
}
export function asgSrcStackPush(v: i32) { asgSrcStack.push(v) }

export let asgDstStack: i32[] = []
export function asgDstStackPop() {
  asgDstStack.pop()
  0
}
export function asgDstStackPush(v: i32) { asgDstStack.push(v) }

// Cycle-guard stacks for the generic call-site binding walk (`bindGenWalk`) and the deep
// substitution (`substTyDeep`) — a recursive named type is cyclic in the arena, so both walks
// remember what they are already visiting.
export let bgSrcStack: i32[] = []
export function bgSrcStackPop() {
  bgSrcStack.pop()
  0
}
export function bgSrcStackPush(v: i32) { bgSrcStack.push(v) }

export let bgDstStack: i32[] = []
export function bgDstStackPop() {
  bgDstStack.pop()
  0
}
export function bgDstStackPush(v: i32) { bgDstStack.push(v) }

// The array row an enclosing index store is about to pin, live only while that store's value is
// checked; -1 everywhere else.
export let asgOpenElemRow = -1
export function asgOpenElemRowSet(v: i32) { asgOpenElemRow = v }

// The row of an index store's receiver when its element is still open — the row a value in the
// store's own right-hand side may pin. -1 for every other target.
export function asgOpenElemRowOf(tgtIx: i32) {
  if tgtIx < 0 { return -1 }
  const g = nodeAt(tgtIx)
  if g is Index {
    const at = nodeTyIxOf(g.idxArr)
    if at < 0 { return -1 }
    const t = tyAt(at)
    if t is TyArray {
      if t.aElem < 0 { return at }
    }
  }
  -1
}

// By assignment node: the storage type of a name target, which a narrowed read type hides,
// where it is not the right side's type; -1 elsewhere. Reset by `initChecker`.
export let asgStoreTys: i32[] = []
export function asgStoreTysPush(v: i32) { asgStoreTys.push(v) }
export function asgStoreTysSetAt(k: i32, v: i32) { asgStoreTys[k] = v }

// Whether any assignment's name target stores a type other than its right side's.
export function asgAnyWiderStore(): boolean { asgStoreTys.length > 0 }

// The storage type the name target of assignment `ix` is checked against where it is not the
// right side's type, or -1.
export function asgStoreTyOf(ix: i32): i32 {
  if ix < 0 || ix >= asgStoreTys.length { return -1 }
  asgStoreTys[ix]
}
// ── free index operators (B14) ───────────────────────────────────────────────

// ── getters (property-access-design.md §D3a) ─────────────────────────────────

// D1736 — the re-narrow sidecar: at an assignment whose accepted write retired the target's
// narrowing, the type the bare name reads at afterwards. Keyed by the assignment node, sized
// with `isVarTyIx`, read through `asgNarTyIxOf`; -1 means the read is at the declared type.
export let asgNarTyIx: i32[] = []
export function asgNarTyIxSet(v: i32[]) { asgNarTyIx = v }

// Per assignment node, the non-null type a straight-line write's null strip left its bare-name
// target at, which the emitter needs where that name lives in a capture cell (D3288).
export let asgStripTys: i32[] = []
export function asgStripTysPush(v: i32) { asgStripTys.push(v) }
export function asgStripTysSet(v: i32[]) { asgStripTys = v }
export function asgStripTysSetAt(k: i32, v: i32) { asgStripTys[k] = v }

export let asgKeepNarrow: {[i32]: boolean} = Map()
export function asgKeepNarrowSet(v: {[i32]: boolean}) { asgKeepNarrow = v }
export function asgKeepNarrowSetAt(k: i32, v: boolean) { asgKeepNarrow[k] = v }

// Assignment nodes whose place reads at the member its pin lands on (`HD_TVW`, `HD_HWR`): the
// emitter retires the place's narrowing there, and a name's pin that excludes null re-narrows it.
export let asgTvWrite: {[i32]: boolean} = Map()
export function asgTvWriteSet(v: {[i32]: boolean}) { asgTvWrite = v }

// A monomorphized clone of node `from` answers what `from` did in the three banks above.
export function recordClonedCallRetire(from: i32, to: i32) {
  if from < 0 || to < 0 { return 0 }
  const a = crAfterBank[from]
  if a is string[] { crAfterBank[to] = a }
  const b = crBeforeBank[from]
  if b is string[] { crBeforeBank[to] = b }
  const c = crCondDropBank[from]
  if c is string[] { crCondDropBank[to] = c }
  const w = crCapWidenBank[from]
  if w is string[] { crCapWidenBank[to] = w }
  carryAsgBanks(from, to)
  0
}

// A clone of assignment `from` answers its write's narrowing banks (`asgNarTyIxOf`,
// `asgStripTyOf`, `asgKeepsNarrowOf`, `asgTvWriteOf`), which are keyed by node.
function carryAsgBanks(from: i32, to: i32) {
  if from < 0 || from >= P.nodes.length { return 0 }
  const nt = asgNarTyIxOf(from)
  if nt >= 0 { recordAsgNarTyIx(to, nt) }
  const st = asgStripTyOf(from)
  if st >= 0 {
    while asgStripTys.length <= to { asgStripTys.push(-1) }
    asgStripTys[to] = st
  }
  if asgKeepsNarrowOf(from) { asgKeepNarrow[to] = true }
  if asgTvWriteOf(from) { asgTvWrite[to] = true }
  0
}

// Whether right side `rhs` is built by its store: a list or record literal, or an assignment
// whose own right side is one. A named value keeps its identity and its own type (D2394).
export function asgRhsBuiltAtPlace(rhs: i32): boolean {
  const x = parenPeelIx(rhs)
  if x < 0 || x >= P.nodes.length { return false }
  const e = nodeAt(x)
  if e is ArrayLit || e is ObjLit { return true }
  asgNestedRhsBuilt(x)
}

// Whether node `x` is an assignment whose right side its store builds; every other node is a
// value with an identity of its own.
function asgNestedRhsBuilt(x: i32): boolean {
  const e = nodeAt(x)
  if e is BinExpr {
    if e.binOp == "=" { return asgRhsBuiltAtPlace(e.binRight) }
  }
  false
}

// Whether the write at assignment node `ix` into a guard-narrowed bare name kept the narrowing it
// found, so the reads after it lower at the member they already did.
export function asgKeepsNarrowOf(ix: i32): boolean {
  if asgKeepNarrow.length == 0 { return false }
  asgKeepNarrow[ix] ?? false
}

// The type the assignment at node `ix` re-narrows its bare-name target to, or -1 when the
// write retired no narrowing and the reads after it are at the declared type. The emitter's
// half of the reads-only rule: it pushes the member this names (D1736).
export function asgNarTyIxOf(ix: i32) { colAt(asgNarTyIx, ix) }

// Whether the place the assignment at node `ix` writes reads at the member its pin lands on:
// the reads after it carry the pin, not the template's narrowing (D3240).
export function asgTvWriteOf(ix: i32): boolean {
  if asgTvWrite.length == 0 { return false }
  asgTvWrite[ix] ?? false
}

// The type the assignment at node `ix` null-stripped its bare-name target to, or -1.
export function asgStripTyOf(ix: i32): i32 {
  if ix < 0 || ix >= asgStripTys.length { return -1 }
  asgStripTys[ix]
}

// Forget both answers banked at assignment node `ix`, before the check that re-derives them.
export function clearAsgNarTyIx(ix: i32) {
  if ix >= 0 && ix < asgNarTyIx.length { asgNarTyIx[ix] = -1 }
  if asgKeepNarrow.length > 0 && (asgKeepNarrow[ix] ?? false) {
    asgKeepNarrow[ix] = false
  }
  if asgTvWrite.length > 0 && (asgTvWrite[ix] ?? false) {
    asgTvWrite[ix] = false
  }
  0
}

// Bank `asgNarTyIxOf`'s answer at the assignment node.
export function recordAsgNarTyIx(ix: i32, ty: i32) {
  if ix < 0 || ty < 0 { return 0 }
  while asgNarTyIx.length <= ix { asgNarTyIx.push(-1) }
  asgNarTyIx[ix] = ty
  0
}

// Bank a write whose reads the pin decides at assignment `ix`, place declared `dcl`.
export function recordAsgTvWrite(ix: i32, dcl: i32) {
  recordAsgNarTyIx(ix, dcl)
  asgTvWrite[ix] = true
  0
}

export function asgRowsReset() {
  bgSrcStack = []
  bgDstStack = []
  asgStoreTys = []
  asgNarTyIx = []
  asgStripTys = []
  asgKeepNarrow = Map()
  asgTvWrite = Map()
  asgSrcStack = []
  asgDstStack = []
}
