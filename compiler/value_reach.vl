// `value_reach.vl` — where a function value flows: the calls that run it, through the bindings,
// literals, fields, returns and parameters that hold it. The monomorphizer asks it whether a
// value is inert (it reaches no call and nothing that observes its signature), and the split
// plan of `fn_split.vl` asks it which calls a slot serves, so both read one answer (D6880).

import { emitFail } from "./emit_bytes"
import { elabHoleRowCut, elabHoleRowMark } from "./check_elab_cap"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  callHasTyArgs,
  declExported,
  hasNamedArgs,
  i32ToStr,
  nodeAt,
  nodeChildren,
  nodeChildrenPush,
} from "./ast"
import { wsOrigTyOf } from "./check_demands"
import { isVarTyIxOf } from "./check_list_union"
import { i32TyIx } from "./check_leaf_steps"
import { nodeTyIxOf } from "./check_node_tys"
import { holeSlotCallRets, substTyDeep } from "./check_relate_core"
import { T, TyFunc, mkFuncTy, tyAt, tyEq, tyMayHoldFn } from "./check_types"
import {
  monoAnnHasTyParam,
  monoDeclAnnName,
  monoTyParamOf,
  retVoidAnnFlag,
  tyNameOf,
  unwrapParen,
} from "./emit_base"
import { fnStmtsPosOf } from "./emit_capture_frames"
import {
  fnParent,
  fnStmts,
  monoInstFe,
  monoInstOrig,
  monoOrigNode,
  reExpName,
  reExpTarget,
} from "./emit_state"
import { i32ListHas } from "./listutil"

import { identDeclOf, sidArrGet } from "./symbols"
import { tyHasTyVar, tyIsArray, tyReachesHole } from "./tyquery"

let vrParent: i32[] = []
let vrUses: {[i32]: i32[]} = Map()
let vrUnres: {[string]: boolean} = Map()
let vrMemoState: {[string]: i32} = Map()
let vrMemoVal: {[string]: i32[]} = Map()
let vrSeen: i32[] = []
let vrStmts: i32[] = []
// The list and record literals the index holds, in the order it reached them.
export let vrLits: i32[] = []
let vrInst = false
let vrExact = false
// Whether a lambda's result and a write into a fresh literal's field or element are followed;
// only the checker's question asks, so the monomorphizer's and fn_split's answers stay put.
let vrFollow = false

// Follows a lambda's result and a write into a fresh literal for the question `vrReset` started.
export function vrSetFollow() { vrFollow = true }

// Starts a new question over the module statements `stmts`, whose values are dropped. With
// `inst` an instance function answers by its template's reads; with `exact` every call answered
// runs this value or a loop variable over its list, so a join, a write, a parameter or an
// unnamed element position is lost.
export function vrReset(stmts: i32[], inst: boolean, exact: boolean) {
  vrResetFor("", stmts, inst, exact)
}

// The question the index answers, named by the pass that started it; "" for one that names none.
let vrOwner = ""

// One saved index (`vrStash`), so a pass can ask its own question inside another's.
let vrStashParent: i32[] = []
let vrStashUses: {[i32]: i32[]} = Map()
let vrStashUnres: {[string]: boolean} = Map()
let vrStashMemoState: {[string]: i32} = Map()
let vrStashMemoVal: {[string]: i32[]} = Map()
let vrStashSeen: i32[] = []
let vrStashStmts: i32[] = []
let vrStashLits: i32[] = []
let vrStashFlags: boolean[] = []
let vrStashOwner = ""

// Saves the current index for `vrUnstash`; a second stash before the unstash replaces the first.
export function vrStash() {
  vrStashParent = vrParent
  vrStashUses = vrUses
  vrStashUnres = vrUnres
  vrStashMemoState = vrMemoState
  vrStashMemoVal = vrMemoVal
  vrStashSeen = vrSeen
  vrStashStmts = vrStmts
  vrStashLits = vrLits
  vrStashFlags = [vrInst, vrExact, vrFollow]
  vrStashOwner = vrOwner
  0
}

// Restores the index `vrStash` saved.
export function vrUnstash() {
  vrParent = vrStashParent
  vrUses = vrStashUses
  vrUnres = vrStashUnres
  vrMemoState = vrStashMemoState
  vrMemoVal = vrStashMemoVal
  vrSeen = vrStashSeen
  vrStmts = vrStashStmts
  vrLits = vrStashLits
  if vrStashFlags.length == 3 {
    vrInst = vrStashFlags[0]
    vrExact = vrStashFlags[1]
    vrFollow = vrStashFlags[2]
  }
  vrOwner = vrStashOwner
  0
}

// `vrReset` for the question pass `owner` asks; `vrInert` answers only the monomorphizer's.
export function vrResetFor(
  owner: string,
  stmts: i32[],
  inst: boolean,
  exact: boolean,
) {
  vrOwner = owner
  vrParent = __array_new__(P.nodes.length, -1)
  vrUses = Map()
  vrUnres = Map()
  vrSeen = __array_new__(P.nodes.length, -1)
  vrMemoState = Map()
  vrMemoVal = Map()
  vrStmts = stmts
  vrLits = []
  vrInst = inst
  vrExact = exact
  vrFollow = false
  0
}

// Adds the subtrees under `roots` not yet indexed, and pushes to `cands` each read in them that
// may name a function: a declared function, a binding a lambda initializes, or an unknown name.
export function vrIndex(roots: i32[], cands: i32[]) {
  vrMemoState = Map()
  vrMemoVal = Map()
  // Both tables cover the whole arena up front, so the walk indexes them directly.
  const len = P.nodes.length
  while vrSeen.length < len { vrSeen.push(-1) }
  while vrParent.length < len { vrParent.push(-1) }
  for root in roots {
    const stack: i32[] = [root]
    while stack.length > 0 {
      const ix = stack.pop()
      if ix >= 0 && ix < len && vrSeen[ix] != 1 {
        vrSeen[ix] = 1
        const n = nodeAt(ix)
        if n is ArrayLit || n is ObjLit { vrLits.push(ix) }
        if n is Ident { vrNoteRead(ix, cands) }
        const k0 = stack.length
        nodeChildrenPush(ix, stack)
        let k = k0
        while k < stack.length {
          const ch = stack[k]
          if ch >= 0 && ch < len && vrParent[ch] < 0 { vrParent[ch] = ix }
          k = k + 1
        }
      }
    }
  }
  0
}

// Whether node `ix` is in the index.
export function vrIndexed(ix: i32): boolean { sidArrGet(vrSeen, ix) == 1 }

function vrNoteRead(ix: i32, cands: i32[]) {
  const n = nodeAt(ix)
  if !(n is Ident) { return 0 }
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length {
    vrUnres[n.identName] = true
    cands.push(ix)
    return 0
  }
  const us = vrUses[d] ?? []
  us.push(ix)
  vrUses[d] = us
  const dn = nodeAt(d)
  if dn is FuncDecl {
    cands.push(ix)
  } else if dn is LetDecl && dn.letInit >= 0 {
    const iv = unwrapParen(dn.letInit)
    if iv >= 0 && nodeAt(iv) is FuncDecl { cands.push(ix) }
  }
  0
}

// Whether value `x`, holding a function at `path`, reaches no call and nothing that observes it.
export function vrInert(x: i32, path: string): boolean {
  vrCalls(x, path).length == 0
}

// `vrInert` for pass `owner`, which refuses loudly unless the index answering is the one
// `owner` built (`vrResetFor`) and holds `x`: a stale index answers about another tree.
export function vrInertFor(owner: string, x: i32, path: string): boolean {
  if vrOwner != owner || x < 0 || x >= vrParent.length || x >= vrSeen.length {
    emitFail(
      "emitProgram: value reach was asked about a node the index built for "
        + owner
        + " does not hold",
    )
    return false
  }
  vrInert(x, path)
}

// The calls value `x` reaches with the function it holds at `path` ("" the value itself, `e,` or
// `e<k>,` a list element, `f:<name>,` a record field) at their callee position; [-1] when it
// reaches a place the question does not follow. A cycle answers [-1].
export function vrCalls(x: i32, path: string): i32[] {
  if x < 0 || x >= P.nodes.length || path.length > 256 { return vrLost() }
  const key = i32ToStr(x) + "|" + path
  const m = vrMemoState[key] ?? 0
  if m == 1 { return vrLost() }
  if m == 2 { return vrMemoVal[key] ?? vrLost() }
  vrMemoState[key] = 1
  const r = vrStep(x, path)
  vrMemoVal[key] = r
  vrMemoState[key] = 2
  r
}

// Whether type `t` reaches an inference hole or names a type variable other than those in
// `keep`, the asking frame's own, which an instance of it binds.
function vrOpen(t: i32, keep: string[]): boolean {
  let u = t
  if keep.length > 0 && tyHasTyVar(t) {
    const fill: i32[] = []
    for _k in keep { fill.push(i32TyIx()) }
    // The placeholder asks a question; it pins no hole an instance would be built at.
    const r0 = elabHoleRowMark()
    u = substTyDeep(t, keep, fill)
    elabHoleRowCut(r0)
  }
  tyHasTyVar(u) || tyReachesHole(u, 16)
}

// The one function type every call value `x` reaches at `path` makes, open in at most the type
// variables `keep`; -1 when it reaches no call, a place the question does not follow, or calls
// of more than one type.
export function vrCalleeTy(x: i32, path: string, keep: string[]): i32 {
  const cs = vrCalls(x, path)
  if cs.length == 0 || vrLostIn(cs) { return -1 }
  let out = -1
  for c in cs {
    const cn = nodeAt(c)
    if !(cn is Call) { return -1 }
    const t = vrCallTy(cn, c, keep)
    if t < 0 || (out >= 0 && !tyEq(out, t)) { return -1 }
    out = t
  }
  out
}

// The function type call `n` at node `c` makes: its callee's, or where that is open (`vrOpen`),
// at each open parameter its argument's type and at an open result its own; -1 when one still is.
function vrCallTy(n: Call, c: i32, keep: string[]): i32 {
  const t = nodeTyIxOf(n.callFn)
  if t < 0 || t >= T.tys.length { return -1 }
  const ft = tyAt(t)
  if !(ft is TyFunc) { return -1 }
  if !vrOpen(t, keep) { return t }
  if (
    hasNamedArgs(n.callArgNames)
    || n.callArgs.length != ft.fnParamTypes.length
  ) {
    return -1
  }
  const ps: i32[] = []
  let i = 0
  while i < n.callArgs.length {
    let pt = ft.fnParamTypes[i]
    if vrOpen(pt, keep) {
      const a = n.callArgs[i]
      if nodeAt(a) is Spread { return -1 }
      pt = nodeTyIxOf(a)
      if pt < 0 || vrOpen(pt, keep) { return -1 }
    }
    ps.push(pt)
    i = i + 1
  }
  let r = ft.fnRet
  if vrOpen(r, keep) { r = nodeTyIxOf(c) }
  if r < 0 || vrOpen(r, keep) { return -1 }
  mkFuncTy(ps, r)
}

// Whether call list `cs` holds a place the question does not follow.
export function vrLostIn(cs: i32[]): boolean { cs.length > 0 && cs[0] < 0 }

function vrLost(): i32[] { [-1] }

// Adds the calls `add` to `acc`; false when `add` is lost, which loses `acc` too.
function vrJoin(acc: i32[], add: i32[]): boolean {
  if vrLostIn(add) { return false }
  for c in add {
    if !i32ListHas(acc, c) { acc.push(c) }
  }
  true
}

// The step of `vrCalls` the node holding `x` decides.
function vrStep(x: i32, path: string): i32[] {
  const none: i32[] = []
  const p = sidArrGet(vrParent, x)
  // A module statement's value is dropped.
  if p < 0 {
    if i32ListHas(vrStmts, x) { return none }
    return vrLost()
  }
  const pn = nodeAt(p)
  match pn {
    Block => {
      const k = pn.blkStmts.length
      if k == 0 || pn.blkStmts[k - 1] != x { return none }
      return vrCalls(p, path)
    }
    IfStmt => {
      if x == pn.ifCond || vrExact { return vrLost() }
      return vrCalls(p, path)
    }
    WhileStmt => {
      if x == pn.whileBody { return none }
    }
    ForRange => {
      if x == pn.frBody { return none }
    }
    ForIn => {
      if x == pn.fiBody { return none }
      if x == pn.fiIter { return vrForVar(pn, path) }
    }
    FuncDecl => {
      if x == pn.fnBody && !vrExact { return vrFnValue(p, path) }
    }
    RetStmt => {
      if !vrExact { return vrFnValue(vrFrameOf(p), path) }
    }
    Paren => {
      return vrCalls(p, path)
    }
    ObjLit => {
      return vrCalls(p, path)
    }
    ArrayLit => {
      return vrCalls(p, vrElemToken(pn.arrElems, x) + path)
    }
    FieldInit => {
      return vrCalls(p, "f:" + pn.fiName + "," + path)
    }
    LetDecl => {
      if x == pn.letInit && pn.letType < 0 { return vrDecl(p, path) }
    }
    BinExpr => {
      // A comparison reads the function's identity, its declaration and captures, and calls
      // nothing.
      if path == "" && (pn.binOp == "==" || pn.binOp == "!=") { return [] }
      if !vrExact { return vrBin(pn, p, x, path) }
    }
    Call => {
      if pn.callFn == x {
        if path != "" { return vrLost() }
        const one: i32[] = [p]
        return one
      }
      if !vrExact {
        const pr = vrPushRecv(pn)
        if pr >= 0 { return vrPushed(pn, pr, x, path) }
        return vrArg(pn, x, path)
      }
    }
    Member => {
      return vrProp(pn.memProp, p, path)
    }
    OptMember => {
      return vrProp(pn.omProp, p, path)
    }
    Index => {
      if x == pn.idxArr { return vrIndexRead(pn.idxIndex, p, path) }
    }
    // reads the value, or holds it where the question does not follow
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | ErrExpr | Param | TypeRef | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | UnionDecl | IsExpr | AsExpr | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  vrLost()
}

// The path token of element `x` of a list literal with elements `es`: `e<k>,` at a position no
// spread before it moves, else `e,`.
function vrElemToken(es: i32[], x: i32): string {
  let i = 0
  while i < es.length && es[i] != x {
    if nodeAt(es[i]) is Spread { return "e," }
    i = i + 1
  }
  "e" + i32ToStr(i) + ","
}

// The element position a path starting `e<k>,` names, -1 for `e,`, -2 for no element path; the
// rest of the path after the token goes to `vrPathRest`.
let vrPathRest = ""
function vrElemOf(path: string): i32 {
  if path.slice(0, 1) != "e" { return -2 }
  let k = 1
  while k < path.length && path.slice(k, k + 1) != "," { k = k + 1 }
  if k >= path.length { return -2 }
  vrPathRest = path.slice(k + 1, path.length)
  if k == 1 { return -1 }
  vrLitIndex(path.slice(1, k))
}

// The value of decimal digits `s`, or -1.
function vrLitIndex(s: string): i32 {
  if s.length == 0 || s.length > 6 { return -1 }
  let v = 0
  for ch in s {
    if ch < "0"[0] || ch > "9"[0] { return -1 }
    v = v * 10 + (ch - "0"[0])
  }
  v
}

// The `Index` arm of `vrStep`: an element is read. With `exact`, a literal index reads none of
// the elements at other positions, and a computed one may read any (D7182).
function vrIndexRead(ix: i32, p: i32, path: string): i32[] {
  const at = vrElemOf(path)
  if at == -2 { return vrLost() }
  const rest = vrPathRest
  if vrExact {
    const n = nodeAt(unwrapParen(ix))
    if !(n is NumLit) { return vrCalls(p, rest) }
    if at < 0 || vrLitIndex(n.numText) < 0 { return vrLost() }
    if vrLitIndex(n.numText) != at {
      const none: i32[] = []
      return none
    }
  }
  vrCalls(p, rest)
}

// The `ForIn` arm of `vrStep` for the list `p` iterates: each element is bound to the loop
// variable, whose reads reach what the element does, in either mode.
function vrForVar(n: ForIn, path: string): i32[] {
  const out: i32[] = []
  if vrElemOf(path) == -2 { return vrLost() }
  const rest = vrPathRest
  for u in vrUses[n.fiDecl1] ?? [] {
    if !vrJoin(out, vrCalls(u, rest)) { return vrLost() }
  }
  out
}

// The function declaration holding node `ix`, or -1 at module scope.
export function vrFrameOf(ix: i32): i32 {
  let o = sidArrGet(vrParent, ix)
  while o >= 0 && !(nodeAt(o) is FuncDecl) { o = sidArrGet(vrParent, o) }
  o
}

// The template instance declaration `fd` copies, whose reads are the program's (D6930), or `fd`.
function vrTmplOf(fd: i32): i32 {
  if fd < 0 || !vrInst { return fd }
  const it = monoFrameInstTmpl(fd)
  if it[0] == fd && it[1] >= 0 { return it[1] }
  fd
}

// The calls the value function declaration `f0` returns reaches at `path`: none when it is
// declared `void`; else, when its result is inferred and it is no export, those each of its
// calls' results reaches. Every other read of it is lost. An instance answers by its template.
function vrFnValue(f0: i32, path: string): i32[] {
  const out: i32[] = []
  const f = vrTmplOf(f0)
  if f < 0 || !vrIndexed(f) { return vrLost() }
  const fn = nodeAt(f)
  if !(fn is FuncDecl) { return vrLost() }
  if fn.fnRet >= 0 {
    if retVoidAnnFlag(fn.fnRet) != 0 { return out }
    return vrLost()
  }
  // A lambda's result reaches what the result of each call its value reaches does.
  if fn.fnName == "" && vrFollow {
    const cs = vrCalls(f, "")
    if vrLostIn(cs) { return vrLost() }
    for c in cs {
      if !vrJoin(out, vrCalls(c, path)) { return vrLost() }
    }
    return out
  }
  if (
    fn.fnName == ""
    || monoNameIsExported(fn.fnName)
    || declExported(f)
    || (vrUnres[fn.fnName] ?? false)
  ) {
    return vrLost()
  }
  for u in vrUses[f] ?? [] {
    let callee = u
    let c = sidArrGet(vrParent, u)
    while c >= 0 && nodeAt(c) is Paren {
      callee = c
      c = sidArrGet(vrParent, c)
    }
    if c < 0 { return vrLost() }
    const cn = nodeAt(c)
    if !(cn is Call) || cn.callFn != callee { return vrLost() }
    if !vrJoin(out, vrCalls(c, path)) { return vrLost() }
  }
  out
}

// The calls every read of the binding or parameter declared at `d`, no export, reaches at
// `path`; a write's target is no read. With `exact` only a binding nothing writes answers.
function vrDecl(d: i32, path: string): i32[] {
  const out: i32[] = []
  const dn = nodeAt(d)
  let nm = ""
  if dn is LetDecl && (dn.letKw == "const" || !vrExact || !vrWritten(d)) {
    nm = dn.letName
  }
  if dn is Param && !vrExact { nm = dn.parName }
  if (nm == "" || declExported(d) || (vrUnres[nm] ?? false) || !vrIndexed(d)) {
    return vrLost()
  }
  if sidArrGet(vrParent, d) < 0 && monoNameIsExported(nm) { return vrLost() }
  for u in vrUses[d] ?? [] {
    if !vrJoin(out, vrCalls(u, path)) { return vrLost() }
  }
  out
}

// Whether some read of the binding declared at `d` is an assignment's target.
function vrWritten(d: i32): boolean {
  for u in vrUses[d] ?? [] {
    let t = u
    let p = sidArrGet(vrParent, u)
    while p >= 0 && nodeAt(p) is Paren {
      t = p
      p = sidArrGet(vrParent, p)
    }
    if p >= 0 {
      const pn = nodeAt(p)
      if pn is BinExpr && pn.binOp == "=" && pn.binLeft == t { return true }
    }
  }
  false
}

// The `BinExpr` arm of `vrStep`: a plain write's target is not read, and its value reaches what
// the binding it writes does, an un-annotated one or a labelled block's carrier.
function vrBin(n: BinExpr, p: i32, x: i32, path: string): i32[] {
  const out: i32[] = []
  if n.binOp != "=" { return vrLost() }
  if x == n.binLeft { return out }
  const t = unwrapParen(n.binLeft)
  if t >= 0 && vrFollow && !(nodeAt(t) is Ident) {
    const roots: i32[] = []
    const paths: string[] = []
    if !vrPlaceRoots(t, path, roots, paths) { return vrLost() }
    let i = 0
    while i < roots.length {
      if !vrJoin(out, vrDecl(roots[i], paths[i])) { return vrLost() }
      i = i + 1
    }
    if !vrJoin(out, vrCalls(p, path)) { return vrLost() }
    return out
  }
  if t < 0 || !(nodeAt(t) is Ident) { return vrLost() }
  const d = identDeclOf(t)
  if d < 0 || d >= P.nodes.length { return vrLost() }
  const dn = nodeAt(d)
  if dn is LetDecl {
    if dn.letType >= 0 && dn.letName.slice(0, 3) != "$lv" { return vrLost() }
  } else if dn is Param {
    if dn.parType >= 0 { return vrLost() }
  } else {
    return vrLost()
  }
  if !vrJoin(out, vrDecl(d, path)) || !vrJoin(out, vrCalls(p, path)) {
    return vrLost()
  }
  out
}

// Pushes to `roots` each binding whose reads may reach the storage the place `t` writes into, and
// to `paths` its path to the written slot followed by `path`. False unless each is an un-annotated
// binding of fresh lists, records or `Map()`s, reached through those literals, a name one holds or
// a write rebinding one, and no container on the way may be re-pointed (D12332).
function vrPlaceRoots(
  t: i32,
  path: string,
  roots: i32[],
  paths: string[],
): boolean {
  // The steps, the last first.
  const steps: string[] = []
  let x = t
  let more = true
  while more && x >= 0 && x < P.nodes.length && steps.length <= 8 {
    const n = nodeAt(x)
    if n is Member {
      steps.push("f:" + n.memProp + ",")
      x = unwrapParen(n.memObj)
    } else if n is Index {
      steps.push("e,")
      x = unwrapParen(n.idxArr)
    } else {
      more = false
    }
  }
  if steps.length == 0 || steps.length > 8 { return false }
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return false }
  // The bindings to visit, each with the count of steps left under it.
  const work: i32[] = [identDeclOf(x)]
  const left: i32[] = [steps.length]
  let w = 0
  while w < work.length {
    if work.length > 16 { return false }
    const d = work[w]
    const n = left[w]
    w = w + 1
    if d < 0 || d >= P.nodes.length { return false }
    const dn = nodeAt(d)
    if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return false }
    let p = path
    let k = 0
    while k < n {
      p = steps[k] + p
      k = k + 1
    }
    if !vrRootSeen(roots, paths, d, p) {
      if vrRepointable(d, n) { return false }
      roots.push(d)
      paths.push(p)
      const vals: i32[] = [dn.letInit]
      vrRebinds(d, vals)
      for v in vals {
        if !vrValueRoots(unwrapParen(v), steps, n, work, left) { return false }
      }
    }
  }
  true
}

// Whether `roots` and `paths` already pair binding `d` with path `p`.
function vrRootSeen(roots: i32[], paths: string[], d: i32, p: string): boolean {
  let i = 0
  while i < roots.length {
    if roots[i] == d && paths[i] == p { return true }
    i = i + 1
  }
  false
}

// Pushes to `vals` the value of each plain write rebinding the binding declared at `d`.
function vrRebinds(d: i32, vals: i32[]) {
  for u in vrUses[d] ?? [] {
    let t = u
    let p = sidArrGet(vrParent, u)
    while p >= 0 && nodeAt(p) is Paren {
      t = p
      p = sidArrGet(vrParent, p)
    }
    if p >= 0 {
      const pn = nodeAt(p)
      if pn is BinExpr && pn.binOp == "=" && pn.binLeft == t {
        vals.push(pn.binRight)
      }
    }
  }
  0
}

// Follows the value `v` a binding holds, with `n` of `steps` left under it, to the bindings its
// written container may belong to, pushed to `work` and `left`; false unless it is a name, or a
// fresh list, record or `Map()` holding a literal or a name at each step before the last, or a
// call to a declared function returning only those.
function vrValueRoots(
  v: i32,
  steps: string[],
  n: i32,
  work: i32[],
  left: i32[],
): boolean {
  if v < 0 || v >= P.nodes.length { return false }
  const vn = nodeAt(v)
  if vn is Ident {
    work.push(identDeclOf(v))
    left.push(n)
    return true
  }
  let fresh = vn is ObjLit || vn is ArrayLit
  if vn is Call && vn.callArgs.length == 0 {
    const cf = nodeAt(unwrapParen(vn.callFn))
    fresh = cf is Ident && cf.identName == "Map" && identDeclOf(vn.callFn) < 0
  }
  if !fresh && vn is Call {
    // A declared function's result is followed into each list, record or name it returns (D12370).
    const rets: i32[] = []
    if !holeSlotCallRets(vn, rets) || rets.length == 0 { return false }
    for r in rets {
      const rv = unwrapParen(r)
      if rv < 0 || rv >= P.nodes.length { return false }
      const rn = nodeAt(rv)
      if !(rn is ObjLit || rn is ArrayLit || rn is Ident) { return false }
      if !vrValueRoots(rv, steps, n, work, left) { return false }
    }
    return true
  }
  if !fresh { return false }
  let lits: i32[] = [v]
  let k = n - 1
  while k > 0 {
    lits = vrLitStep(lits, steps[k], k, work, left)
    if vrLostIn(lits) { return false }
    k = k - 1
  }
  true
}

// The list and record literals the literals `lits` hold at the path step `step`, with each name
// they hold there pushed to `work` with `k` steps left under it; lost when one of them holds
// anything else there.
function vrLitStep(
  lits: i32[],
  step: string,
  k: i32,
  work: i32[],
  left: i32[],
): i32[] {
  const out: i32[] = []
  for l in lits {
    const n = nodeAt(l)
    if step == "e," {
      if !(n is ArrayLit) { return vrLost() }
      for e in n.arrElems {
        if !vrLitHeld(unwrapParen(e), k, out, work, left) { return vrLost() }
      }
    } else {
      if !(n is ObjLit) { return vrLost() }
      let v = -1
      for fi in n.objFields {
        const f = nodeAt(fi)
        if f is FieldInit && "f:" + f.fiName + "," == step {
          v = unwrapParen(f.fiValue)
        }
      }
      if !vrLitHeld(v, k, out, work, left) { return vrLost() }
    }
  }
  out
}

// Sorts the value `v` a literal holds on the way to a written place: a list or record literal
// goes to `out`, a name to `work` with `k` steps left; false for anything else.
function vrLitHeld(
  v: i32,
  k: i32,
  out: i32[],
  work: i32[],
  left: i32[],
): boolean {
  if v < 0 || v >= P.nodes.length { return false }
  const vn = nodeAt(v)
  match vn {
    ObjLit | ArrayLit => {
      out.push(v)
      return true
    }
    Ident => {
      work.push(identDeclOf(v))
      left.push(k)
      return true
    }
    // a value whose storage the walk does not model
    AsExpr | BinExpr | Block | BoolLit | BreakStmt | Call | CharLit | ContinueStmt | ErrExpr | FieldDef | FieldInit | ForIn | ForRange | FuncDecl | IfStmt | ImportDecl | Index | IsExpr | LetDecl | MatchExpr | Member | NullLit | NumLit | OptMember | Param | Paren | Program | RetStmt | Spread | StrLit | TypeDecl | TypeRef | Unary | UnionDecl | WhileStmt | LoopVar => {}
  }
  false
}

// Whether a read of the binding declared at `d` may re-point a container on a place `n` steps
// under it: it writes or calls a method on a container above the last, or hands one of those to
// anything else, which could. A write rebinding the binding is a root `vrPlaceRoots` follows.
function vrRepointable(d: i32, n: i32): boolean {
  for u in vrUses[d] ?? [] {
    let cur = u
    let m = 0
    let p = sidArrGet(vrParent, cur)
    let more = true
    while more && p >= 0 {
      const pn = nodeAt(p)
      if pn is Paren {
        cur = p
      } else if pn is Member && pn.memObj == cur {
        cur = p
        m = m + 1
      } else if pn is Index && pn.idxArr == cur {
        cur = p
        m = m + 1
      } else {
        more = false
      }
      if more { p = sidArrGet(vrParent, cur) }
    }
    if p < 0 {
      if vrHandsOnAbove(m, n) { return true }
    } else {
      const pn = nodeAt(p)
      if pn is BinExpr && pn.binOp == "=" && pn.binLeft == cur {
        if m > 0 && m < n { return true }
      } else if pn is Call && pn.callFn == cur && m > 0 {
        if m < n { return true }
      } else if vrHandsOnAbove(m, n) {
        return true
      }
    }
  }
  false
}

// Whether a read handing on the container `m` steps under the binding reaches above the last
// container of an `n`-step place, so whatever receives it could re-point one.
function vrHandsOnAbove(m: i32, n: i32): boolean { m < n - 1 }

// The `Call` arm of `vrStep` for an argument: none when its parameter is declared a closed type
// no function fits (D6471); the calls its reads reach when it takes its argument's own type
// (D6881). Named arguments and a spread before it pair by no position.
function vrArg(n: Call, x: i32, path: string): i32[] {
  const none: i32[] = []
  if hasNamedArgs(n.callArgNames) { return vrLost() }
  let i = 0
  while i < n.callArgs.length && n.callArgs[i] != x {
    if nodeAt(n.callArgs[i]) is Spread { return vrLost() }
    i = i + 1
  }
  if i >= n.callArgs.length { return vrLost() }
  const t = wsOrigTyOf(n, i)
  const closed = t >= 0 && !tyHasTyVar(t) && !tyMayHoldFn(t, 0)
  const cd = vrTmplOf(monoCalleeDeclOf(n))
  if cd >= 0 && cd < P.nodes.length {
    const f = nodeAt(cd)
    if f is FuncDecl && i < f.fnParams.length {
      const pIx = f.fnParams[i]
      const pp = nodeAt(pIx)
      if pp is Param && pp.parDefault < 0 && pp.parRest == 0 {
        // A closed parameter type still yields the function to an `is` that widens it (D6701)
        if !closed && !monoParamIsOpen(f, pIx) { return vrLost() }
        return vrDecl(pIx, path)
      }
    }
  }
  if closed { return none }
  vrLost()
}

// The receiver of call `n` when it is `xs.push(…)` on a list, else -1.
function vrPushRecv(n: Call): i32 {
  if n.callFn < 0 { return -1 }
  const m = nodeAt(n.callFn)
  if !(m is Member) || m.memProp != "push" { return -1 }
  if !tyIsArray(nodeTyIxOf(m.memObj)) { return -1 }
  m.memObj
}

// The `Call` arm of `vrStep` for value `x` pushed onto list `recv` by call `n`: it is an element
// of the binding `recv` names, at no known position; lost for any other receiver or a spread.
function vrPushed(n: Call, recv: i32, x: i32, path: string): i32[] {
  if nodeAt(x) is Spread || hasNamedArgs(n.callArgNames) { return vrLost() }
  const r = unwrapParen(recv)
  if r < 0 || !(nodeAt(r) is Ident) { return vrLost() }
  const d = identDeclOf(r)
  if d < 0 || d >= P.nodes.length { return vrLost() }
  vrDecl(d, "e," + path)
}

// The member arms of `vrStep`: a list's `length` reads no element, nor does a `push` onto it,
// and a record's other fields read none of the one holding the function.
function vrProp(prop: string, p: i32, path: string): i32[] {
  const none: i32[] = []
  if vrElemOf(path) != -2 {
    if prop == "length" { return none }
    const c = sidArrGet(vrParent, p)
    if c >= 0 {
      const cn = nodeAt(c)
      if cn is Call && cn.callFn == p && vrPushRecv(cn) >= 0 { return none }
    }
    return vrLost()
  }
  if path.slice(0, 2) != "f:" { return vrLost() }
  let k = 2
  while k < path.length && path.slice(k, k + 1) != "," { k = k + 1 }
  if path.slice(2, k) != prop { return none }
  vrCalls(p, path.slice(k + 1, path.length))
}

// Whether function declaration `fd` is no export and every read of it reaches nothing
// (`vrInert`), so nothing calls it or observes its signature (D6912).
export function vrReadsInert(fd: i32): boolean {
  const f = nodeAt(fd)
  if (
    !(f is FuncDecl)
    || f.fnName == ""
    || monoNameIsExported(f.fnName)
    || declExported(fd)
    || (vrUnres[f.fnName] ?? false)
    || !vrIndexed(fd)
  ) {
    return false
  }
  for u in vrUses[fd] ?? [] {
    if !vrInert(u, "") { return false }
  }
  true
}

// Whether every read of function declaration `fd` outside its own body reaches nothing
// (`vrInert`), so no call instances it and nothing observes its signature; an export too (D12211).
export function vrOuterReadsInert(fd: i32): boolean {
  if !vrIndexed(fd) { return false }
  for u in vrUses[fd] ?? [] {
    let o = sidArrGet(vrParent, u)
    while o >= 0 && o != fd { o = sidArrGet(vrParent, o) }
    if o < 0 && !vrInert(u, "") { return false }
  }
  true
}

// Whether parameter `pIx` of `f` takes its argument's own type: un-annotated, or annotated by a
// type parameter that no other parameter, the result, an `is`/`as` or a type argument names (D6910).
function monoParamIsOpen(f: FuncDecl, pIx: i32): boolean {
  const p = nodeAt(pIx)
  if !(p is Param) { return false }
  if p.parType < 0 { return true }
  const tp = monoParamBareTyParam(pIx, f.fnTyParams)
  if tp == "" { return false }
  if monoDeclAnnName(p.parType, tyNameOf(p.parType), f.fnTyParams) != tp {
    return false
  }
  for q in f.fnParams {
    if q != pIx && monoParamBareTyParam(q, f.fnTyParams) == tp { return false }
  }
  monoTyParamOnlyBareParams(f, tp)
}

// The function declaration call `n`'s callee names directly, or -1.
export function monoCalleeDeclOf(n: Call): i32 {
  const f = unwrapParen(n.callFn)
  if f < 0 || !(nodeAt(f) is Ident) { return -1 }
  const d = identDeclOf(f)
  if d < 0 || d >= P.nodes.length || !(nodeAt(d) is FuncDecl) { return -1 }
  d
}

// `[instance, template]` for the generic instance frame `fx` is, or the nearest enclosing frame
// that is one; `[-1, -1]` at module scope or outside any instance.
export function monoFrameInstTmpl(fx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  let f = fx
  let hops = 0
  while f >= 0 && hops < 8 {
    const fe = fnStmtsPosOf(f)
    if fe < 0 || fe >= fnStmts.length { return none }
    let k = 0
    while k < monoInstFe.length && k < monoInstOrig.length {
      if monoInstFe[k] == fe {
        const o = monoInstOrig[k]
        if o < 0 || o >= monoOrigNode.length { return none }
        const out: i32[] = [f, monoOrigNode[o]]
        return out
      }
      k = k + 1
    }
    if fe >= fnParent.length { return none }
    const ps = fnParent[fe]
    if ps < 0 || ps >= fnStmts.length { return none }
    f = fnStmts[ps]
    hops = hops + 1
  }
  none
}

// Whether `fn` names type parameter `tp` only as the whole annotation of some parameters: not
// in its return type, another annotation, an `is`/`as` or a call's type arguments.
export function monoTyParamOnlyBareParams(fn: FuncDecl, tp: string): boolean {
  const tps: string[] = [tp]
  const bare: i32[] = []
  for pIx in fn.fnParams {
    const p = nodeAt(pIx)
    if p is Param && p.parType >= 0 { bare.push(p.parType) }
  }
  const stack: i32[] = []
  for pIx in fn.fnParams { stack.push(pIx) }
  stack.push(fn.fnRet)
  stack.push(fn.fnBody)
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is TypeRef && monoAnnHasTyParam(ix, -1, tps) {
        let ok = n.tyName == tp
        if ok {
          ok = false
          for x in bare {
            if x == ix { ok = true }
          }
        }
        if !ok { return false }
      }
      if n is IsExpr && monoAnnHasTyParam(ix, isVarTyIxOf(ix), tps) {
        return false
      }
      if n is AsExpr && monoAnnHasTyParam(ix, -1, tps) { return false }
      if n is Call && callHasTyArgs(ix) { return false }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  true
}

// The type parameter a bare `T` or `T[]` parameter annotation rides, or "".
export function monoParamBareTyParam(pIx: i32, typarams: string[]): string {
  const p = nodeAt(pIx)
  if p is Param {
    if p.parType < 0 { return "" }
    const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
    return monoTyParamOf(ann, typarams)
  }
  ""
}

// Is `name` part of the module's wasm ABI — the public name, or the internal target of a
// staged export alias? The driver fills `reExpName`/`reExpTarget` before `emitProgram`
// runs, so both are populated by the time the prune reads them. Both are consulted: the
// module path's public name may differ from its mangled target.
export function monoNameIsExported(name: string) {
  let i = 0
  while i < reExpTarget.length {
    if reExpTarget[i] == name { return true }
    i = i + 1
  }
  let j = 0
  while j < reExpName.length {
    if reExpName[j] == name { return true }
    j = j + 1
  }
  false
}
