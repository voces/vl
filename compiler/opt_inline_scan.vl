// The `-O` inline-record step (docs/internals/optimizer-in-vl.md, rungs R6b to R7): which
// struct fields holding a leaf record are stored inline, why each other one stays a reference,
// and the module rewritten so; then which lists of leaf records hold their fields side by side.
// It walks every body under an emulation of the validator's operand stack. The host stages the
// module with `optInLoad`, calls `optInlineRewrite`, then `optInlineFlatScan` and
// `optInlineFlatStep` on its output, and reads each module and its explain lines through
// `optOut*`. A module this cannot read is left alone.

import {
  WasmCursor,
  wcByte,
  wcFail,
  wcNew,
  wcOp,
  wcSkipLeb,
  wcU32,
} from "./wasm_read"
import { WasmModule, wmRead } from "./wasm_write"
import { copyBytes, putText, wnPutLeb, wnRead, wnTable } from "./wasm_names"
import { optInBytes, optOutSet } from "./opt_scan"
import {
  max,
  min,
  mvFieldOnlyParams,
  mvProducerRecords,
  mvTableArity,
} from "./opt_multivalue"
import { namesFields } from "./opt_inline"
import { i32ListEq, i32ListHas } from "./listutil"

const NONE = -1
// Operand stack entries: a number, the validator's bottom and unknown reference, or a reference
// as `REF + heap * 2 + nullable` (an abstract heap's byte, or 0x100 + a type index).
const NUM = 0
const BOT = -1
const UREF = -2
const REF = 4
// A holder: a type index, any record (`H_ANY`), or none.
const H_ANY = -1
const H_NONE = -2
const FK_BLOCK = 0
const FK_LOOP = 1
const FK_IF = 2
const FK_ELSE = 3
const FL_GET = 0
const FL_SET = 1
const FL_CTL = 2
const SM_OTHER = 0
const SM_ASNN = 1
const SM_GET = 2
const SM_SET = 3
const SM_TEE = 4
const SM_SGET = 5
const SM_NEW = 6
const SM_AGET = 7
const SM_CALL = 8
// The ops on a candidate array the flattening rewrites, and how an element read is used.
const AK_NEWDEF = 0
const AK_FIXED = 1
const AK_GET = 2
const AK_SET = 3
const AK_LEN = 4
const AK_COPY = 5
const AU_FIELD = 0
const AU_LOCAL = 1
const AU_ARG = 2
const AU_WHOLE = 3
// A flattened array stays boxed past this many whole-element reads per store
// (inline-records-design.md §7); V8 refuses an `array.new_fixed` of more operands than this.
const FLAT_READS_PER_STORE = 6
const NEW_FIXED_MAX = 10000
const MAX_LOCALS = 50000
const PAIR = 65536

// The module.
let B: u8[] = []
let M: WasmModule = wmRead([])
let bad = false
let nTypes = 0
let superOf: i32[] = []
let hasSub: boolean[] = []
let comp: i32[] = []
let recOk: boolean[] = []
let single: boolean[] = []
let funcType: i32[] = []
let nImports = 0
let globals: i32[] = []
let tables: i32[] = []
let tags: i32[] = []
let tableImported = false
let tableExported = false
let exKind: i32[] = []
let exIdx: i32[] = []
let exWhat: i32[] = []
let potential: {[i32]: i32} = Map()
let potKeys: i32[] = []
let isParent: boolean[] = []
let isRecord: boolean[] = []
let constMade: boolean[] = []
// The list-flattening step's candidates: per type the record a candidate array's elements
// hold or -1, the candidates ascending, and why each is refused outright (`arrBadF` -2 when
// it is not, -1 when no function is to blame); the array types constant expressions make.
let arrRec: i32[] = []
let arrList: i32[] = []
let arrBadW: u8[][] = []
let arrBadF: i32[] = []
let constArr: i32[] = []
// Whether the walk records array sites, and what the last flattening scan found: `gate` 0
// refused (`scanWhy` says why), 1 no candidate at all, 2 no candidate array, 3 candidate arrays,
// whose bodies `flatWalked` says are read.
let flatScan = false
let gate = 0
let flatWalked = false
let scanWhy = ""
// The flattening's sites over every body: per site its op, offset, reachability, array type,
// kind and operands `[fsOLo, fsOHi)`, how an element read is used, and whether a
// `ref.as_non_null` follows it; per body its sites `[fbLo, fbHi)`.
let fsK: i32[] = []
let fsOff: i32[] = []
let fsReach: boolean[] = []
let fsTy: i32[] = []
let fsKind: i32[] = []
let fsOLo: i32[] = []
let fsOHi: i32[] = []
let fsUse: i32[] = []
let fsUA: i32[] = []
let fsUB: i32[] = []
let fsCast: boolean[] = []
let foNull: boolean[] = []
let foProd: i32[] = []
let foCast: boolean[] = []
let fbLo: i32[] = []
let fbHi: i32[] = []
// The multi-value step's facts on the scanned module, read once: its field-only parameters
// (`g * 64 + j`) and per function the record its result is taken apart as, or -1.
let mvReady = false
let mvFo: {[i32]: i32} = Map()
let mvProd: i32[] = []
// The step: per type whether the multi-value step leaves its free reads boxed, the number type
// a flattened array holds or -1, and the free reads it counted.
let unfreed: boolean[] = []
let flatNum: i32[] = []
let flRebox = false
let fhA: i32[] = []
let fhF: i32[] = []
let fhL: i32[] = []
let faA: i32[] = []
let faG: i32[] = []
let faJ: i32[] = []
let nameW = wnRead([])
let nameTab: i32[] = []

// What crosses the boundary: per entry its holder and what it is (an index into `whats`).
let whats: u8[][] = []
let bndH: i32[] = []
let bndW: i32[] = []
let crossW: i32[] = []
let crossAny = -1

// What the walk finds, over every body.
let writer: i32[] = []
let defaultMade: i32[] = []
let identH: i32[] = []
let identF: i32[] = []
let erasedRoot: i32[] = []
let erasedAny = -1
let erasedF: i32[] = []
let rdField: {[i32]: i32} = Map()
let rdLocal: {[i32]: i32} = Map()
let rdArg: {[i32]: i32} = Map()
let rdWhole: {[i32]: i32} = Map()
let rdWholeIn: {[i32]: i32} = Map()
let argP: i32[] = []
let argG: i32[] = []
let argA: i32[] = []
let argF: i32[] = []
// Every reachable store of a value whose type admits null into a candidate field.
let nlDst: i32[] = []
let nlSrc: i32[] = []
let nlNew: boolean[] = []
let nlOff: i32[] = []
let nlF: i32[] = []

// The body being walked: the operand stack and who pushed each slot, the control frames.
let stk: i32[] = []
let own: i32[] = []
let frKind: i32[] = []
let frBtK: i32[] = []
let frBtV: i32[] = []
let frHeight: i32[] = []
let frInit: i32[] = []
let frUnreach: boolean[] = []
let inits: i32[] = []
let inited: boolean[] = []
let locT: i32[] = []
let flipped: boolean[] = []
let nParams = 0
let curF = 0

// Per op of the body: its height after, its kind, and what it pushed.
let post: i32[] = []
let smK: i32[] = []
let smA: i32[] = []
let smB: i32[] = []
let newOf: i32[] = []
let getAt: i32[] = []
let argOfG: {[i32]: i32} = Map()
let argOfJ: {[i32]: i32} = Map()
let seg: i32[] = []
let getK: i32[] = []
let getKey: i32[] = []
let flKind: i32[] = []
let flK: i32[] = []
let flL: i32[] = []
let flNN: boolean[] = []
let flOp: i32[] = []
let flLo: i32[] = []
let flHi: i32[] = []
let flLab: i32[] = []
let bsOff: i32[] = []
let bsTy: i32[] = []
let bsNew: boolean[] = []
let bsLo: i32[] = []
let bsHi: i32[] = []
let boField: i32[] = []
let boNull: boolean[] = []
let boProd: i32[] = []
let boFrom: i32[] = []
let bsK: i32[] = []
let bsSet: boolean[] = []
let touch = false

// Kept per body for the rewrite: whether an op names a parent, whether its record locals are
// declared non-null, its local count, and its sites `[rbLo, rbHi)`, each with its op, kind and
// operands (field, producer, the record type a `struct.new` producer makes, and the cast).
let rbTouch: boolean[] = []
let rbTight: boolean[] = []
let rbLocals: i32[] = []
let rbLo: i32[] = []
let rbHi: i32[] = []
let rsK: i32[] = []
let rsReach: boolean[] = []
let rsTy: i32[] = []
let rsSet: boolean[] = []
let rsLo: i32[] = []
let rsHi: i32[] = []
let roField: i32[] = []
let roProd: i32[] = []
let roNew: i32[] = []
let roCast: boolean[] = []

// The decision: per candidate pair (by `potKeys` index) the record it inlines or -1 and why
// not, and per record type asked whether it may be copied.
let decInl: i32[] = []
let decWhy: u8[][] = []
let decRecs: i32[] = []
let decRecWhy: u8[][] = []

// The immediates of the op being walked.
let imA = 0
let imB = 0
let imC = 0
let imD = 0
let imBtK = 0
let imBtV = 0
let imL: i32[] = []

// The first flattening site of the body being walked.
let fbCur = 0

// The step's decision on `b`, into `decInl`/`decWhy` per candidate pair and `decRecs`/
// `decRecWhy` per record; sets `bad` when the module cannot be read. `stable` is
// `--stable-layout`, `rebox` inlines a field whatever its whole-record reads, and `fault`
// refuses every field.
function decide(b: u8[], stable: boolean, rebox: boolean, fault: boolean) {
  if !readModule(b) || bad { bad = true; return }
  findCandidates()
  if potKeys.length == 0 && !anyRecord() { bad = true; return }
  findCrossing(!stable)
  resetFound()
  let bi = 0
  while bi < M.bodies.length && !bad {
    scanBody(bi)
    bi = bi + 1
  }
  if bad || M.bodies.length + nImports != funcType.length { bad = true; return }
  closeErased(!stable)
  if potKeys.length > 0 { decideFields(rebox, fault) }
}

// ---- Reading the module ----

function readModule(b: u8[]): boolean {
  B = b
  M = wmRead(b)
  if !M.ok { return false }
  if namesFields(M) {
    scanWhy = "the name section names struct fields"
    return false
  }
  nameW = wnRead(b)
  if !nameW.ok { return false }
  nTypes = M.types.length
  if nTypes >= 32768 { return false }
  funcType = []
  nImports = 0
  globals = []
  tables = []
  tags = []
  tableImported = false
  tableExported = false
  exKind = []
  exIdx = []
  exWhat = []
  whats = []
  bndH = []
  bndW = []
  constMade = []
  constArr = []
  for _ in M.types { constMade.push(false) }
  let structGroups = 0
  let t = 0
  for size in M.groupSize {
    let hasStruct = false
    let k = 0
    while k < size {
      const st = M.types[t + k]
      if st.form == 0x5f { hasStruct = true }
      if st.form == 0x5f && st.params.length >= PAIR { return false }
      if st.supers.length > 1 { return false }
      k = k + 1
    }
    if hasStruct { structGroups = structGroups + 1 }
    t = t + size
  }
  if structGroups > 1 {
    scanWhy = "struct types span several rec groups, so a changed parent could become equal to another type"
    return false
  }
  let s = 0
  while s < M.secId.length {
    const id = M.secId[s]
    const c = wcNew(b, M.secStart[s], M.secEnd[s])
    wcByte(c)
    wcU32(c)
    if id == 2 { readImports(c) }
    if id == 3 {
      for ft in M.funcTypes { funcType.push(ft) }
    }
    if id == 4 { readTables(c) }
    if id == 6 { readGlobals(c) }
    if id == 7 { readExports(c) }
    if id == 9 { readElements(c) }
    if id == 13 { readTags(c) }
    if c.failed || bad { return false }
    s = s + 1
  }
  nameTab = wnTable(nameW, funcType.length)
  classify()
  true
}

function readImports(c: WasmCursor) {
  const n = wcU32(c)
  let i = 0
  while i < n && !c.failed {
    const w = whats.length
    const what: u8[] = []
    putText(what, "import ")
    readName(c, what)
    what.push(46)
    readName(c, what)
    whats.push(what)
    const kind = wcByte(c)
    if kind == 0 {
      const t = wcU32(c)
      funcType.push(t)
      nImports = nImports + 1
      if isFunc(t) {
        for v in sigP(t) { boundary(v, w) }
        for v in sigR(t) { boundary(v, w) }
      }
    } else if kind == 1 {
      const rt = rdVal(c)
      readLimits(c)
      tableImported = true
      tables.push(rt)
      boundary(rt, w)
    } else if kind == 2 {
      readLimits(c)
    } else if kind == 3 {
      const vt = rdVal(c)
      wcByte(c)
      globals.push(vt)
      boundary(vt, w)
    } else if kind == 4 {
      wcByte(c)
      const t = wcU32(c)
      tags.push(t)
      if isFunc(t) {
        for v in sigP(t) { boundary(v, w) }
      }
    } else {
      wcFail(c)
    }
    i = i + 1
  }
}

// Appends a name's bytes to `out`.
function readName(c: WasmCursor, out: u8[]) {
  const len = wcU32(c)
  if c.failed || len < 0 || len > c.end - c.pos { wcFail(c); return }
  let i = 0
  while i < len {
    out.push(c.b[c.pos + i])
    i = i + 1
  }
  c.pos = c.pos + len
}

function readLimits(c: WasmCursor) {
  const flags = wcByte(c)
  if flags > 15 { wcFail(c); return }
  wcSkipLeb(c)
  if (flags & 1) != 0 { wcSkipLeb(c) }
  if (flags & 8) != 0 { wcU32(c) }
}

function readTables(c: WasmCursor) {
  const n = wcU32(c)
  let i = 0
  while i < n && !c.failed {
    let init = false
    if c.pos < c.end && c.b[c.pos] == 0x40 {
      wcByte(c)
      if wcByte(c) != 0 { wcFail(c) }
      init = true
    }
    tables.push(rdVal(c))
    readLimits(c)
    if init { constScan(c) }
    i = i + 1
  }
}

function readGlobals(c: WasmCursor) {
  const n = wcU32(c)
  let i = 0
  while i < n && !c.failed {
    globals.push(rdVal(c))
    wcByte(c)
    constScan(c)
    i = i + 1
  }
}

function readExports(c: WasmCursor) {
  const n = wcU32(c)
  let i = 0
  while i < n && !c.failed {
    const what: u8[] = []
    putText(what, "export ")
    readName(c, what)
    const kind = wcByte(c)
    const ix = wcU32(c)
    if kind > 4 { wcFail(c) }
    if kind == 1 { tableExported = true }
    exKind.push(kind)
    exIdx.push(ix)
    exWhat.push(whats.length)
    whats.push(what)
    i = i + 1
  }
}

function readElements(c: WasmCursor) {
  const n = wcU32(c)
  let i = 0
  while i < n && !c.failed {
    const flags = wcU32(c)
    if flags > 7 { wcFail(c); return }
    if flags == 2 || flags == 6 { wcU32(c) }
    if (flags & 1) == 0 { constSkip(c) }
    if (flags & 3) != 0 {
      if (flags & 4) != 0 { rdVal(c) } else { wcByte(c) }
    }
    const m = wcU32(c)
    let k = 0
    while k < m && !c.failed {
      if (flags & 4) != 0 { constScan(c) } else { wcU32(c) }
      k = k + 1
    }
    i = i + 1
  }
}

function readTags(c: WasmCursor) {
  const n = wcU32(c)
  let i = 0
  while i < n && !c.failed {
    wcByte(c)
    tags.push(wcU32(c))
    i = i + 1
  }
}

// Skips a constant expression, marking every struct type it makes and every array type it
// makes other than as an empty `array.new_fixed`.
function constScan(c: WasmCursor) {
  while !c.failed {
    const at = c.pos
    const op = wcOp(c)
    if op == 0xfb0000 || op == 0xfb0001 {
      if c.imm >= 0 && c.imm < nTypes { constMade[c.imm] = true }
    }
    if op == 0xfb0006 || op == 0xfb0007 || op == 0xfb0008 {
      const d = wcNew(c.b, at, c.pos)
      wcByte(d)
      wcU32(d)
      const t = wcU32(d)
      if op != 0xfb0008 || wcU32(d) != 0 { constArr.push(t) }
    }
    if op == 0x0b { return }
  }
}

// Skips an offset expression.
function constSkip(c: WasmCursor) {
  while !c.failed {
    if wcOp(c) == 0x0b { return }
  }
}

// A value type, packed as `wasm_write.vl` packs it; fails the cursor on a shared one.
function rdVal(c: WasmCursor): i32 {
  const lead = wcByte(c)
  if lead != 0x63 && lead != 0x64 { return lead }
  let exact = 0
  if c.pos < c.end && c.b[c.pos] == 0x62 {
    c.pos = c.pos + 1
    exact = 1
  }
  if c.pos < c.end && (c.b[c.pos] & 0xc0) == 0x40 {
    const h = wcByte(c)
    if h == 0x65 { return wcFail(c) }
    return lead | (h << 8)
  }
  const t = wcU32(c)
  if t < 0 || t >= nTypes { return wcFail(c) }
  lead | ((0x100 + 2 * t + exact) << 8)
}

// A heap type: an abstract heap's byte, or 0x100 + a type index.
function rdHeap(c: WasmCursor): i32 {
  if c.pos < c.end && c.b[c.pos] == 0x62 { c.pos = c.pos + 1 }
  if c.pos < c.end && (c.b[c.pos] & 0xc0) == 0x40 {
    const h = wcByte(c)
    if h == 0x65 { return wcFail(c) }
    return h
  }
  const t = wcU32(c)
  if t < 0 || t >= nTypes { return wcFail(c) }
  0x100 + t
}

// ---- Types ----

function isFunc(t: i32): boolean {
  t >= 0 && t < nTypes && M.types[t].form == 0x60
}

function sigP(t: i32): i32[] {
  if !isFunc(t) {
    bad = true
    return []
  }
  M.types[t].params
}

function sigR(t: i32): i32[] {
  if !isFunc(t) {
    bad = true
    return []
  }
  M.types[t].results
}

function fieldCount(t: i32): i32 {
  if t >= 0 && t < nTypes && M.types[t].form == 0x5f {
    M.types[t].params.length
  } else {
    0
  }
}

// The type index a packed value type refers to, or -1.
function refIdx(v: i32): i32 {
  const lead = v & 0xff
  const h = v >> 8
  if (lead != 0x63 && lead != 0x64) || h < 0x100 { return -1 }
  (h - 0x100) >> 1
}

// A packed value type as an operand stack entry.
function stOf(v: i32): i32 {
  const lead = v & 0xff
  if lead == 0x63 || lead == 0x64 {
    const h = v >> 8
    const heap = if h < 0x100 { h } else { 0x100 + ((h - 0x100) >> 1) }
    return REF + heap * 2 + (if lead == 0x63 { 1 } else { 0 })
  }
  if lead >= 0x69 && lead <= 0x75 { return REF + lead * 2 + 1 }
  NUM
}

function isAnyHeap(h: i32): boolean { h == 0x6e || h == 0x6d || h == 0x6b }

// What a value of packed type `v` may hold: a type index, any record, or none.
function holderOf(v: i32): i32 {
  const lead = v & 0xff
  if lead == 0x63 || lead == 0x64 {
    const h = v >> 8
    if h < 0x100 { return if isAnyHeap(h) { H_ANY } else { H_NONE } }
    return (h - 0x100) >> 1
  }
  if isAnyHeap(lead) { H_ANY } else { H_NONE }
}

// `holderOf` for an operand: a type that another rec group repeats holds any record.
function holderOfOperand(e: i32): i32 {
  if e < REF { return H_NONE }
  const heap = (e - REF) >> 1
  if heap >= 0x100 {
    const t = heap - 0x100
    return if t < nTypes && single[t] { t } else { H_ANY }
  }
  if isAnyHeap(heap) { H_ANY } else { H_NONE }
}

// Whether a value of type `v` may stand where type `t` is expected.
function holds(t: i32, v: i32): boolean {
  if t == H_ANY { return true }
  let u = v
  let guard = 0
  while u >= 0 && u < nTypes && guard <= nTypes {
    if u == t { return true }
    u = superOf[u]
    guard = guard + 1
  }
  false
}

// Supertypes, subtyping components, leaf records, and which types another rec group repeats.
function classify() {
  superOf = []
  hasSub = []
  comp = []
  recOk = []
  for st in M.types {
    superOf.push(
      if st.supers.length == 1 && st.supers[0] < nTypes { st.supers[0] } else { -1 },
    )
    hasSub.push(false)
    comp.push(comp.length)
    let ok = st.form == 0x5f && st.params.length > 0 && st.params.length <= 8
    if ok {
      for v in st.params {
        if v < 0x7c || v > 0x7f { ok = false }
      }
    }
    recOk.push(ok)
  }
  let t = 0
  while t < nTypes {
    const sup = superOf[t]
    if sup >= 0 {
      hasSub[sup] = true
      const ra = root(t)
      const rb = root(sup)
      if ra < 0 || rb < 0 { bad = true }
      else if ra < rb { comp[rb] = ra }
      else { comp[ra] = rb }
    }
    t = t + 1
  }
  t = 0
  while t < nTypes {
    comp[t] = root(t)
    t = t + 1
  }
  canon()
}

function root(t: i32): i32 {
  let x = t
  while comp[x] != x {
    comp[x] = comp[comp[x]]
    x = comp[x]
  }
  x
}

// `single[t]`: no other rec group canonicalizes to the one `t` is in.
function canon() {
  const cls: i32[] = []
  const count: i32[] = []
  for _ in M.types {
    cls.push(0)
    count.push(0)
  }
  const keys: i32[][] = []
  const starts: i32[] = []
  const next: i32[] = []
  const head: {[i32]: i32} = Map()
  let g0 = 0
  for size in M.groupSize {
    const key = groupKey(g0, size, cls)
    let hash = 0
    for x in key { hash = ((hash & 0xffffff) * 31 + (x & 0xffff)) & 0x7fffffff }
    let found = -1
    let at = head[hash] ?? -1
    while at >= 0 && found < 0 {
      if i32ListEq(keys[at], key) { found = at }
      at = next[at]
    }
    const gi = keys.length
    keys.push(key)
    starts.push(g0)
    next.push(head[hash] ?? -1)
    head[hash] = gi
    let k = 0
    while k < size {
      const c = if found >= 0 { starts[found] + k } else { g0 + k }
      cls[g0 + k] = c
      count[c] = count[c] + 1
      k = k + 1
    }
    g0 = g0 + size
  }
  single = []
  for c in cls { single.push(count[c] == 1) }
}

function groupKey(g0: i32, size: i32, cls: i32[]): i32[] {
  const key: i32[] = [size]
  let k = 0
  while k < size {
    const st = M.types[g0 + k]
    key.push(if st.prefix == 0x50 { 0 } else { 1 })
    key.push(st.supers.length)
    for s in st.supers { keyRef(key, s, g0, size, cls) }
    key.push(st.form)
    if st.form == 0x5d {
      keyRef(key, st.params[0], g0, size, cls)
    } else {
      key.push(st.params.length)
      for v in st.params { keyVal(key, v, g0, size, cls) }
      key.push(st.results.length)
      for v in st.results { keyVal(key, v, g0, size, cls) }
      for m in st.mutable { key.push(if m { 1 } else { 0 }) }
    }
    k = k + 1
  }
  key
}

function keyRef(key: i32[], r: i32, g0: i32, size: i32, cls: i32[]) {
  if r >= g0 && r < g0 + size {
    key.push(1)
    key.push(r - g0)
  } else if r >= 0 && r < g0 {
    key.push(2)
    key.push(cls[r])
  } else {
    bad = true
  }
}

function keyVal(key: i32[], v: i32, g0: i32, size: i32, cls: i32[]) {
  key.push(v & 0xff)
  const h = v >> 8
  if h >= 0x100 {
    key.push((h - 0x100) & 1)
    keyRef(key, (h - 0x100) >> 1, g0, size, cls)
  } else {
    key.push(h)
  }
}

// The fields that may hold a leaf record inline, and the records lists of them may hold.
function findCandidates() {
  potential = Map()
  potKeys = []
  isParent = []
  isRecord = []
  arrRec = []
  arrList = []
  arrBadW = []
  arrBadF = []
  for _ in M.types {
    isParent.push(false)
    isRecord.push(false)
    arrRec.push(-1)
    arrBadW.push([])
    arrBadF.push(-2)
  }
  let p = 0
  while p < nTypes {
    const st = M.types[p]
    if st.form == 0x5f {
      let j = 0
      while j < st.params.length {
        const v = refIdx(st.params[j])
        if v >= 0 && v < nTypes && recOk[v] && !hasSub[v] {
          potential[p * PAIR + j] = v
          potKeys.push(p * PAIR + j)
          isParent[p] = true
          isRecord[v] = true
        }
        j = j + 1
      }
    }
    if st.form == 0x5e && st.params.length == 1 {
      const v = refIdx(st.params[0])
      if v >= 0 && v < nTypes && recOk[v] && !hasSub[v] && uniform(v) {
        isRecord[v] = true
        arrRec[p] = v
        arrList.push(p)
      }
    }
    p = p + 1
  }
}

function uniform(v: i32): boolean {
  for f in M.types[v].params {
    if f != M.types[v].params[0] { return false }
  }
  true
}

function anyRecord(): boolean {
  for r in isRecord {
    if r { return true }
  }
  false
}

// ---- The module boundary ----

function boundary(v: i32, w: i32) {
  const h = holderOf(v)
  if h != H_NONE {
    bndH.push(h)
    bndW.push(w)
  }
}

// What crosses: the types a boundary signature names, and what they reach (fields and
// elements too unless `direct`), each with the first boundary entry that reaches it.
function findCrossing(direct: boolean) {
  let e = 0
  while e < exKind.length {
    const kind = exKind[e]
    const ix = exIdx[e]
    const w = exWhat[e]
    if kind == 0 && ix >= 0 && ix < funcType.length && isFunc(funcType[ix]) {
      for v in M.types[funcType[ix]].params { boundary(v, w) }
      for v in M.types[funcType[ix]].results { boundary(v, w) }
    }
    if kind == 3 && ix >= 0 && ix < globals.length { boundary(globals[ix], w) }
    if kind == 1 && ix >= 0 && ix < tables.length { boundary(tables[ix], w) }
    if kind == 4 && ix >= 0 && ix < tags.length && isFunc(tags[ix]) {
      for v in M.types[tags[ix]].params { boundary(v, w) }
    }
    e = e + 1
  }
  if tableImported || tableExported {
    const w = whats.length
    const what: u8[] = []
    putText(what, "a function in an exposed table")
    whats.push(what)
    let f = nImports
    while f < funcType.length {
      if isFunc(funcType[f]) {
        for v in M.types[funcType[f]].params { boundary(v, w) }
        for v in M.types[funcType[f]].results { boundary(v, w) }
      }
      f = f + 1
    }
  }
  crossW = []
  for _ in M.types { crossW.push(-1) }
  crossAny = -1
  const workT: i32[] = []
  const workW: i32[] = []
  let i = 0
  while i < bndH.length {
    if bndH[i] == H_ANY {
      if crossAny < 0 { crossAny = bndW[i] }
    } else {
      workT.push(bndH[i])
      workW.push(bndW[i])
    }
    i = i + 1
  }
  while workT.length > 0 {
    const t = workT[workT.length - 1]
    const w = workW[workW.length - 1]
    workT.pop()
    workW.pop()
    if t < nTypes && crossW[t] < 0 {
      crossW[t] = w
      for v in innerTypes(t, direct) {
        const h = holderOf(v)
        if h == H_ANY {
          if crossAny < 0 { crossAny = w }
        } else if h >= 0 {
          workT.push(h)
          workW.push(w)
        }
      }
    }
  }
}

// The value types a value of type `t` carries: a signature's, and unless `direct` its
// fields or element.
function innerTypes(t: i32, direct: boolean): i32[] {
  const st = M.types[t]
  const out: i32[] = []
  if st.form == 0x60 {
    for v in st.params { out.push(v) }
    for v in st.results { out.push(v) }
  } else if (st.form == 0x5f || st.form == 0x5e) && !direct {
    for v in st.params {
      if v != 0x78 && v != 0x77 { out.push(v) }
    }
  }
  out
}

// An erased value reaches what its type reaches; each type keeps the first function.
function closeErased(direct: boolean) {
  erasedF = []
  const roots: i32[] = []
  let t = 0
  while t < nTypes {
    erasedF.push(-1)
    if erasedRoot[t] >= 0 { roots.push(t) }
    t = t + 1
  }
  sortBy(roots, erasedRoot)
  for r in roots {
    const f = erasedRoot[r]
    const work: i32[] = [r]
    while work.length > 0 {
      const u = work[work.length - 1]
      work.pop()
      if u < nTypes && erasedF[u] < 0 {
        erasedF[u] = f
        for v in innerTypes(u, direct) {
          const h = holderOf(v)
          if h >= 0 { work.push(h) }
        }
      }
    }
  }
}

// Sorts type indices by `by[t]`, then by index.
function sortBy(xs: i32[], by: i32[]) {
  let i = 1
  while i < xs.length {
    const x = xs[i]
    let j = i - 1
    while j >= 0 && (by[xs[j]] > by[x] || by[xs[j]] == by[x] && xs[j] > x) {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = x
    i = i + 1
  }
}

// Sorts `xs` ascending.
function sortAsc(xs: i32[]) {
  let i = 1
  while i < xs.length {
    const x = xs[i]
    let j = i - 1
    while j >= 0 && xs[j] > x {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = x
    i = i + 1
  }
}

// How a value of type `t` can cross the boundary, or empty.
function crossing(t: i32): u8[] {
  const out: u8[] = []
  if crossAny >= 0 {
    let f = erasedAny
    let u = t
    let guard = 0
    while u >= 0 && u < nTypes && guard <= nTypes {
      const g = erasedF[u]
      if g >= 0 && (f < 0 || g < f) { f = g }
      u = superOf[u]
      guard = guard + 1
    }
    if f >= 0 {
      putText(out, "it is stored as an abstract reference in ")
      putName(out, f)
      putText(out, ", and one crosses at ")
      putBytes(out, whats[crossAny])
      return out
    }
  }
  let best = -1
  let u = t
  let guard = 0
  while u >= 0 && u < nTypes && guard <= nTypes {
    const w = crossW[u]
    if w >= 0 && (best < 0 || less(whats[w], whats[best])) { best = w }
    u = superOf[u]
    guard = guard + 1
  }
  if best >= 0 { putBytes(out, whats[best]) }
  out
}

function less(a: u8[], b: u8[]): boolean {
  let i = 0
  while i < a.length && i < b.length {
    if a[i] != b[i] { return a[i] < b[i] }
    i = i + 1
  }
  a.length < b.length
}

// ---- The walk ----

function resetFound() {
  writer = []
  defaultMade = []
  erasedRoot = []
  for _ in M.types {
    writer.push(-1)
    defaultMade.push(-1)
    erasedRoot.push(-1)
  }
  identH = []
  identF = []
  erasedAny = -1
  rdField = Map()
  rdLocal = Map()
  rdArg = Map()
  rdWhole = Map()
  rdWholeIn = Map()
  argP = []
  argG = []
  argA = []
  argF = []
  nlDst = []
  nlSrc = []
  nlNew = []
  nlOff = []
  nlF = []
  rbTouch = []
  rbTight = []
  rbLocals = []
  rbLo = []
  rbHi = []
  rsK = []
  rsReach = []
  rsTy = []
  rsSet = []
  rsLo = []
  rsHi = []
  roField = []
  roProd = []
  roNew = []
  roCast = []
  decInl = []
  decWhy = []
  decRecs = []
  decRecWhy = []
}

// Walks body `bi`: under its locals declared non-null when that still validates, else as
// declared.
function scanBody(bi: i32) {
  const f = nImports + bi
  curF = f
  if f >= funcType.length || !isFunc(funcType[f]) { bad = true; return }
  const body = M.bodies[bi]
  const params = M.types[funcType[f]].params
  nParams = params.length
  locT = []
  flipped = []
  for v in params {
    locT.push(v)
    flipped.push(false)
  }
  let any = false
  let k = 0
  while k < body.localCount.length {
    const v = body.localType[k]
    const n = body.localCount[k]
    if n < 0 || n > MAX_LOCALS - locT.length { bad = true; return }
    const r = refIdx(v)
    const flip = (v & 0xff) == 0x63 && r >= 0 && isRecord[r]
    if flip { any = true }
    let i = 0
    while i < n {
      locT.push(v)
      flipped.push(flip)
      i = i + 1
    }
    k = k + 1
  }
  let tight = false
  if any {
    const r = walk(bi, false)
    if r == 2 { bad = true; return }
    tight = r == 0
  }
  let l = 0
  while l < locT.length {
    if flipped[l] && tight {
      locT[l] = (locT[l] & ~0xff) | 0x64
    } else {
      flipped[l] = false
    }
    l = l + 1
  }
  if walk(bi, true) != 0 { bad = true; return }
  afterWalk(f, tight)
}

// One pass over body `bi`: 0 when it validates, 1 when a local declared non-null fails, 2 when
// this cannot read it. `rec` records what the decision reads.
function walk(bi: i32, rec: boolean): i32 {
  const body = M.bodies[bi]
  const c = wcNew(B, body.from, body.to)
  stk = []
  own = []
  frKind = []
  frBtK = []
  frBtV = []
  frHeight = []
  frInit = []
  frUnreach = []
  inits = []
  inited = []
  for _ in locT { inited.push(false) }
  pushCtrl(FK_BLOCK, 2, funcType[curF])
  post = []
  smK = []
  smA = []
  smB = []
  newOf = []
  getAt = []
  argOfG = Map()
  argOfJ = Map()
  seg = [0]
  getK = []
  getKey = []
  flKind = []
  flK = []
  flL = []
  flNN = []
  flOp = []
  flLo = []
  flHi = []
  flLab = []
  bsOff = []
  bsK = []
  bsSet = []
  touch = false
  bsTy = []
  bsNew = []
  bsLo = []
  bsHi = []
  fbCur = fsK.length
  boField = []
  boNull = []
  boProd = []
  boFrom = []
  let k = 0
  while c.pos < c.end {
    if frKind.length == 0 { return 2 }
    const off = c.pos
    const op = wcOp(c)
    if c.failed || !decodeImm(op, off, c.pos) { return 2 }
    if op == 0x06 || op == 0x07 || op == 0x09 || op == 0x18 || op == 0x19 {
      return 2
    }
    const hb = stk.length
    const depth = frKind.length
    const reach = !frUnreach[depth - 1]
    const base = frHeight[depth - 1]
    if rec { record(op, k, off, hb, reach, base, seg[seg.length - 1]) }
    const arP = arity(op)
    if arP == -2 || bad { return 2 }
    const r = apply(op)
    if r != 0 { return r }
    if bad { return 2 }
    if rec {
      const ha = stk.length
      let lo = 0
      if arP >= 0 {
        lo = max(ha - arP, 0)
      } else {
        lo = min(max(min(hb, ha) - 1, 0), base)
      }
      if frKind.length > depth { lo = min(lo, frHeight[frKind.length - 1]) }
      while own.length < ha { own.push(NONE) }
      let p = lo
      while p < ha {
        own[p] = k
        p = p + 1
      }
      while own.length > ha { own.pop() }
      post.push(ha)
      if op == 0x02 || op == 0x03 || op == 0x04 || op == 0x1f {
        seg.push(k + 1)
      }
      if op == 0x05 { seg[seg.length - 1] = k + 1 }
      if op == 0x0b { seg.pop() }
    }
    k = k + 1
  }
  if frKind.length != 0 { return 2 }
  0
}

// Reads the immediates of the op at `B[at, end)` into `im*`; those of an op whose immediates
// the walk never reads are skipped to `end`, where `wcOp` left the cursor.
function decodeImm(op: i32, at: i32, end: i32): boolean {
  const d = wcNew(B, at, end)
  wcByte(d)
  if op > 0xff { wcU32(d) }
  imL = []
  if op == 0x02 || op == 0x03 || op == 0x04 || op == 0x1f {
    readBt(d)
    if op == 0x1f {
      const n = wcU32(d)
      let i = 0
      while i < n && !d.failed {
        const kind = wcByte(d)
        if kind <= 1 { wcU32(d) }
        imL.push(wcU32(d))
        i = i + 1
      }
    }
  } else if op == 0x0e {
    const n = wcU32(d)
    let i = 0
    while i <= n && !d.failed {
      imL.push(wcU32(d))
      i = i + 1
    }
  } else if (
    op == 0x0c
    || op == 0x0d
    || op == 0xd5
    || op == 0xd6
    || op == 0x08
    || op == 0x10
    || op == 0x12
    || op == 0x14
    || op == 0x15
    || op == 0xd2
    || op >= 0x20 && op <= 0x26
  ) {
    imA = wcU32(d)
  } else if op == 0x11 || op == 0x13 {
    imA = wcU32(d)
    imB = wcU32(d)
  } else if op == 0x1c {
    if wcU32(d) != 1 { return false }
    imA = rdVal(d)
  } else if op == 0xd0 {
    imA = rdHeap(d)
  } else if (op >> 16) == 0xfb {
    const sub = op & 0xffff
    if sub <= 1 || sub == 6 || sub == 7 || sub >= 11 && sub <= 14 || sub == 16 {
      imA = wcU32(d)
    } else if (
      sub >= 2 && sub <= 5
      || sub >= 8 && sub <= 10
      || sub >= 17 && sub <= 19
    ) {
      imA = wcU32(d)
      imB = wcU32(d)
    } else if sub >= 20 && sub <= 23 {
      imA = rdHeap(d)
    } else if sub == 24 || sub == 25 {
      imC = wcByte(d)
      imA = wcU32(d)
      imB = rdHeap(d)
      imD = rdHeap(d)
    } else {
      d.pos = end
    }
  } else {
    d.pos = end
  }
  if (
    (op == 0x10 || op == 0x12 || op == 0xd2)
    && (imA < 0 || imA >= funcType.length)
  ) {
    return false
  }
  !d.failed && d.pos == end
}

// A block type: `imBtK` 0 empty, 1 one value type (`imBtV`), 2 a type index (`imBtV`).
function readBt(d: WasmCursor) {
  if d.pos >= d.end { wcFail(d); return }
  const x: i32 = d.b[d.pos]
  if x == 0x40 {
    d.pos = d.pos + 1
    imBtK = 0
  } else if x >= 0x40 && x < 0x80 {
    imBtK = 1
    imBtV = rdVal(d)
  } else {
    imBtK = 2
    imBtV = wcU32(d)
    if !isFunc(imBtV) { wcFail(d) }
  }
}

function btParams(k: i32, v: i32): i32[] {
  if k == 2 { sigP(v) } else { [] }
}

function btResults(k: i32, v: i32): i32[] {
  if k == 2 { return sigR(v) }
  if k == 1 { [v] } else { [] }
}

// The types a branch to label `depth` carries; empty past the outermost frame.
function labelTypes(depth: i32): i32[] {
  const i = frKind.length - 1 - depth
  if depth < 0 || i < 0 { return [] }
  if frKind[i] == FK_LOOP {
    btParams(frBtK[i], frBtV[i])
  } else {
    btResults(frBtK[i], frBtV[i])
  }
}

function labelN(depth: i32): i32 {
  if depth < 0 || depth >= frKind.length { bad = true }
  labelTypes(depth).length
}

function pushCtrl(kind: i32, k: i32, v: i32) {
  frKind.push(kind)
  frBtK.push(k)
  frBtV.push(v)
  frHeight.push(stk.length)
  frInit.push(inits.length)
  frUnreach.push(false)
  if kind != FK_BLOCK || frKind.length > 1 { pushVals(btParams(k, v)) }
}

function popCtrl() {
  const top = frKind.length - 1
  while inits.length > frInit[top] {
    inited[inits[inits.length - 1]] = false
    inits.pop()
  }
  while stk.length > frHeight[top] { stk.pop() }
  frKind.pop()
  frBtK.pop()
  frBtV.pop()
  frHeight.pop()
  frInit.pop()
  frUnreach.pop()
}

function setUnreach() {
  const top = frKind.length - 1
  while stk.length > frHeight[top] { stk.pop() }
  frUnreach[top] = true
}

function pop(): i32 {
  const top = frKind.length - 1
  if stk.length <= frHeight[top] {
    if !frUnreach[top] { bad = true }
    return BOT
  }
  const e = stk[stk.length - 1]
  stk.pop()
  e
}

function popRef(): i32 {
  const e = pop()
  if e == BOT { UREF } else { e }
}

function popN(n: i32) {
  let i = 0
  while i < n {
    pop()
    i = i + 1
  }
}

function pushVals(vs: i32[]) {
  for v in vs { stk.push(stOf(v)) }
}

function asNonNull(e: i32): i32 {
  if e >= REF { e & ~1 } else { e }
}

// The entry `d` below the top of the whole stack, or `UREF` past its bottom.
function peek(d: i32): i32 {
  const i = stk.length - 1 - d
  if d < 0 || i < 0 { UREF } else { stk[i] }
}

// The pushes of the op about to run, as the validator's arity reads it: -1 when it has none,
// -2 when this cannot say.
function arity(op: i32): i32 {
  const ta = mvTableArity(op)
  if ta >= 0 { return ta & 15 }
  if ta == -2 { return -2 }
  const top = frKind.length - 1
  if op == 0x02 || op == 0x03 || op == 0x04 || op == 0x1f {
    return btParams(imBtK, imBtV).length
  }
  if op == 0x05 { return btParams(frBtK[top], frBtV[top]).length }
  if op == 0x0b { return btResults(frBtK[top], frBtV[top]).length }
  if (
    op == 0x08
    || op == 0x0c
    || op == 0x0e
    || op == 0x0f
    || op == 0x12
    || op == 0x13
    || op == 0x15
  ) {
    return 0
  }
  if op == 0x0d || op == 0xfb0018 || op == 0xfb0019 { return labelN(imA) }
  if op == 0xd5 { return labelN(imA) + 1 }
  if op == 0xd6 {
    const n = labelN(imA)
    return if n == 0 { -1 } else { n - 1 }
  }
  if op == 0x10 { return sigR(funcType[imA]).length }
  if op == 0x11 || op == 0x14 { return sigR(imA).length }
  if op == 0xfb0000 || op == 0xfb0008 { return 1 }
  -2
}

// The op's effect on the operand and control stacks: 0, 1 when a local declared non-null
// fails, 2 when this cannot read it.
function apply(op: i32): i32 {
  const top = frKind.length - 1
  if op == 0x00 || op == 0x0f { setUnreach(); return 0 }
  if op == 0x01 { return 0 }
  if op == 0x02 || op == 0x03 || op == 0x1f || op == 0x04 {
    if op == 0x04 { pop() }
    popN(btParams(imBtK, imBtV).length)
    pushCtrl(
      if op == 0x03 { FK_LOOP } else if op == 0x04 { FK_IF } else { FK_BLOCK },
      imBtK,
      imBtV,
    )
    return 0
  }
  if op == 0x05 {
    if frKind[top] != FK_IF { return 2 }
    const k = frBtK[top]
    const v = frBtV[top]
    popCtrl()
    pushCtrl(FK_ELSE, k, v)
    return 0
  }
  if op == 0x0b {
    const k = frBtK[top]
    const v = frBtV[top]
    popCtrl()
    pushVals(btResults(k, v))
    return 0
  }
  if op == 0x0c { setUnreach(); return 0 }
  if op == 0x0d {
    pop()
    const ts = labelTypes(imA)
    popN(ts.length)
    pushVals(ts)
    return 0
  }
  if op == 0x0e || op == 0x0a { pop(); setUnreach(); return 0 }
  if op == 0x08 {
    if imA < 0 || imA >= tags.length { return 2 }
    popN(sigP(tags[imA]).length)
    setUnreach()
    return 0
  }
  if op == 0x10 || op == 0x12 {
    const t = funcType[imA]
    popN(sigP(t).length)
    if op == 0x12 { setUnreach() } else { pushVals(sigR(t)) }
    return 0
  }
  if op == 0x11 || op == 0x13 || op == 0x14 || op == 0x15 {
    pop()
    popN(sigP(imA).length)
    if op == 0x13 || op == 0x15 { setUnreach() } else { pushVals(sigR(imA)) }
    return 0
  }
  if op == 0x1a { pop(); return 0 }
  if op == 0x1b {
    pop()
    const t1 = pop()
    const t2 = pop()
    stk.push(if t1 == BOT { t2 } else { t1 })
    return 0
  }
  if op == 0x1c {
    popN(3)
    stk.push(stOf(imA))
    return 0
  }
  if op >= 0x20 && op <= 0x22 {
    const l = imA
    if l < 0 || l >= locT.length { return 2 }
    if op == 0x20 {
      if flipped[l] && !inited[l] { return 1 }
      stk.push(stOf(locT[l]))
      return 0
    }
    const e = pop()
    if flipped[l] {
      if e == UREF { return 2 }
      if e >= REF && (e & 1) == 1 { return 1 }
      if !inited[l] {
        inited[l] = true
        inits.push(l)
      }
    }
    if op == 0x22 { stk.push(stOf(locT[l])) }
    return 0
  }
  if op == 0x23 || op == 0x24 {
    if imA < 0 || imA >= globals.length { return 2 }
    if op == 0x23 { stk.push(stOf(globals[imA])) } else { pop() }
    return 0
  }
  if op == 0x25 || op == 0x26 {
    if imA < 0 || imA >= tables.length { return 2 }
    pop()
    if op == 0x25 { stk.push(stOf(tables[imA])) } else { pop() }
    return 0
  }
  if op == 0xd0 { stk.push(REF + imA * 2 + 1); return 0 }
  if op == 0xd1 || op == 0xd3 {
    pop()
    if op == 0xd3 { pop() }
    stk.push(NUM)
    return 0
  }
  if op == 0xd2 { stk.push(REF + (0x100 + funcType[imA]) * 2); return 0 }
  if op == 0xd4 { stk.push(asNonNull(pop())); return 0 }
  if op == 0xd5 || op == 0xd6 {
    const e = popRef()
    const ts = labelTypes(imA)
    if op == 0xd5 {
      popN(ts.length)
      pushVals(ts)
      stk.push(asNonNull(e))
    } else {
      if ts.length == 0 { return 2 }
      popN(ts.length - 1)
      let i = 0
      while i < ts.length - 1 {
        stk.push(stOf(ts[i]))
        i = i + 1
      }
    }
    return 0
  }
  if (op >> 16) == 0xfb { return applyGc(op & 0xffff) }
  const ta = mvTableArity(op)
  if ta < 0 { return 2 }
  popN(ta >> 4)
  let i = 0
  while i < (ta & 15) {
    stk.push(NUM)
    i = i + 1
  }
  0
}

function applyGc(sub: i32): i32 {
  if sub == 15 { pop(); stk.push(NUM); return 0 }
  if sub <= 19 {
    const t = imA
    if t < 0 || t >= nTypes { return 2 }
    const st = M.types[t]
    if sub <= 5 && st.form != 0x5f || sub >= 6 && st.form != 0x5e { return 2 }
    if sub == 0 { popN(st.params.length) }
    if sub == 0 || sub == 1 { stk.push(REF + (0x100 + t) * 2); return 0 }
    if sub >= 2 && sub <= 4 {
      if imB < 0 || imB >= st.params.length { return 2 }
      pop()
      stk.push(if sub == 2 { stOf(st.params[imB]) } else { NUM })
      return 0
    }
    if sub == 5 { popN(2); return 0 }
    if sub >= 6 && sub <= 10 {
      popN(if sub == 7 { 1 } else if sub == 8 { imB } else { 2 })
      stk.push(REF + (0x100 + t) * 2)
      return 0
    }
    if sub >= 11 && sub <= 13 {
      popN(2)
      stk.push(if sub == 11 { stOf(st.params[0]) } else { NUM })
      return 0
    }
    popN(if sub == 14 { 3 } else if sub == 17 { 5 } else { 4 })
    return 0
  }
  if sub == 20 || sub == 21 { pop(); stk.push(NUM); return 0 }
  if sub == 22 || sub == 23 {
    pop()
    stk.push(REF + imA * 2 + (if sub == 23 { 1 } else { 0 }))
    return 0
  }
  if sub == 24 || sub == 25 {
    popRef()
    const ts = labelTypes(imA)
    if ts.length == 0 { return 2 }
    popN(ts.length - 1)
    let i = 0
    while i < ts.length - 1 {
      stk.push(stOf(ts[i]))
      i = i + 1
    }
    const fromNull = imC & 1
    const toNull = (imC >> 1) & 1
    if sub == 24 {
      stk.push(
        REF + imB * 2 + (if fromNull == 1 && toNull == 0 { 1 } else { 0 }),
      )
    } else {
      stk.push(REF + imD * 2 + toNull)
    }
    return 0
  }
  if sub == 26 || sub == 27 {
    const e = pop()
    const h = if sub == 26 { 0x6e } else { 0x6f }
    stk.push(if e >= REF { REF + h * 2 + (e & 1) } else { UREF })
    return 0
  }
  if sub == 28 { pop(); stk.push(REF + 0x6c * 2); return 0 }
  if sub == 29 || sub == 30 { pop(); stk.push(NUM); return 0 }
  2
}

// ---- What one op tells the decision, read before it runs ----

function tracked(l: i32): boolean {
  if l < nParams || l >= locT.length { return false }
  const r = refIdx(locT[l])
  r >= 0 && isRecord[r]
}

function nullableAt(d: i32, reach: boolean): boolean {
  if !reach { return false }
  const e = peek(d)
  if e == NUM { return true }
  e >= REF && (e & 1) == 1
}

function producer(p: i32, reach: boolean, base: i32, segLo: i32): i32 {
  if !reach || p < base || p >= own.length { return NONE }
  const q = own[p]
  if q != NONE && q >= segLo && post[q] == p + 1 { q } else { NONE }
}

// Records the operand `d` below the top as stored into field `field`.
function opnd(
  field: i32,
  d: i32,
  hb: i32,
  reach: boolean,
  base: i32,
  segLo: i32,
) {
  const q = if hb > d { producer(hb - 1 - d, reach, base, segLo) } else { NONE }
  boField.push(field)
  boNull.push(nullableAt(d, reach))
  boProd.push(q)
  boFrom.push(if q != NONE { getAt[q] } else { -1 })
}

function record(
  op: i32,
  k: i32,
  off: i32,
  hb: i32,
  reach: boolean,
  base: i32,
  segLo: i32,
) {
  const f = curF
  if op == 0x10 {
    const g = imA
    const n = if isFunc(funcType[g]) { M.types[funcType[g]].params.length } else { 0 }
    if hb >= n && reach {
      let j = 0
      while j < n {
        const q = own[hb - n + j]
        if q != NONE && q >= segLo {
          argOfG[q] = g
          argOfJ[q] = j
        }
        j = j + 1
      }
    }
  }
  if reach { erase(op, f) }
  const sub = if (op >> 16) == 0xfb { op & 0xffff } else { -1 }
  if (
    sub >= 0
    && sub <= 5
    && sub != 1
    && imA >= 0
    && imA < nTypes
    && isParent[imA]
  ) {
    touch = true
  }
  if sub == 0 && isParent[imA] {
    const m = M.types[imA].params.length
    bsOff.push(off)
    bsK.push(k)
    bsSet.push(false)
    bsTy.push(imA)
    bsNew.push(reach)
    bsLo.push(boField.length)
    let j = 0
    while j < m {
      if potential.has(imA * PAIR + j) {
        opnd(j, m - 1 - j, hb, reach, base, segLo)
      }
      j = j + 1
    }
    bsHi.push(boField.length)
  }
  if sub == 5 {
    if writer[imA] < 0 { writer[imA] = f }
    if isParent[imA] && potential.has(imA * PAIR + imB) {
      bsOff.push(off)
      bsK.push(k)
      bsSet.push(true)
      bsTy.push(imA)
      bsNew.push(false)
      bsLo.push(boField.length)
      opnd(imB, 0, hb, reach, base, segLo)
      bsHi.push(boField.length)
      if !reach { bsOff[bsOff.length - 1] = -1 }
    }
  }
  if sub == 0 && isParent[imA] && !reach { bsOff[bsOff.length - 1] = -1 }
  if sub == 1 && defaultMade[imA] < 0 { defaultMade[imA] = f }
  if op == 0xd3 || sub == 27 {
    let d = 0
    while d < (if op == 0xd3 { 2 } else { 1 }) {
      const h = holderOfOperand(peek(d))
      if h != H_NONE {
        identH.push(h)
        identF.push(f)
      }
      d = d + 1
    }
  }
  newOf.push(if sub == 0 && recOk[imA] { imA } else { -1 })
  if op == 0x20 && tracked(imA) { flow(FL_GET, k, imA, false, op) }
  if (op == 0x21 || op == 0x22) && tracked(imA) {
    flow(FL_SET, k, imA, !reach || !nullableAt(0, reach), op)
  }
  if (
    op >= 0x02 && op <= 0x05
    || op >= 0x0b && op <= 0x0f
    || op == 0x1f
    || op == 0xd5
    || op == 0xd6
    || sub == 24
    || sub == 25
    || op == 0x00
    || op == 0x08
    || op == 0x0a
    || op == 0x12
    || op == 0x13
    || op == 0x15
  ) {
    flow(FL_CTL, k, imA, false, op)
  }
  let kind = SM_OTHER
  let a = 0
  let b = 0
  if op == 0xd4 { kind = SM_ASNN }
  if op == 0x20 { kind = SM_GET; a = imA }
  if op == 0x21 { kind = SM_SET; a = imA }
  if op == 0x22 { kind = SM_TEE; a = imA }
  if sub == 0 { kind = SM_NEW; a = imA }
  if sub == 11 { kind = SM_AGET; a = imA }
  if op == 0x10 { kind = SM_CALL; a = imA }
  if flatScan && arrList.length > 0 {
    flatSite(op, sub, k, off, hb, reach, base, segLo)
  }
  let at = -1
  if sub == 2 {
    kind = SM_SGET
    a = imA
    b = imB
    if potential.has(imA * PAIR + imB) {
      getK.push(k)
      getKey.push(imA * PAIR + imB)
      at = imA * PAIR + imB
    }
  }
  getAt.push(at)
  smK.push(kind)
  smA.push(a)
  smB.push(b)
}

function flow(kind: i32, k: i32, l: i32, nn: boolean, op: i32) {
  flKind.push(kind)
  flK.push(k)
  flL.push(l)
  flNN.push(nn)
  flOp.push(op)
  flLo.push(flLab.length)
  for x in imL { flLab.push(x) }
  flHi.push(flLab.length)
}

// A value handed to a place typed `any`, `eq` or `struct` forgets its type there.
function erase(op: i32, f: i32) {
  let want: i32[] = []
  let above = 0
  const sub = if (op >> 16) == 0xfb { op & 0xffff } else { -1 }
  if op == 0x21 || op == 0x22 {
    want = [locT[imA]]
  } else if op == 0x24 {
    if imA < globals.length { want = [globals[imA]] }
  } else if op == 0x10 || op == 0x12 {
    if isFunc(funcType[imA]) { want = M.types[funcType[imA]].params }
  } else if op == 0x11 || op == 0x13 || op == 0x14 || op == 0x15 {
    if isFunc(imA) { want = M.types[imA].params }
    above = 1
  } else if op == 0x0f {
    want = M.types[funcType[f]].results
  } else if op == 0x0b {
    want = labelTypes(0)
  } else if op == 0x0c || op == 0x0d {
    want = labelTypes(imA)
    if op == 0x0d { above = 1 }
  } else if op == 0x0e {
    want = labelTypes(imL[imL.length - 1])
    above = 1
  } else if op >= 0x02 && op <= 0x04 {
    if imBtK == 2 { want = M.types[imBtV].params }
    if op == 0x04 { above = 1 }
  } else if op == 0x08 {
    if imA < tags.length && isFunc(tags[imA]) {
      want = M.types[tags[imA]].params
    }
  } else if op == 0x1c {
    want = [imA, imA]
    above = 1
  } else if sub == 0 {
    want = M.types[imA].params
  } else if sub == 5 {
    want = [M.types[imA].params[imB]]
  } else if sub == 6 || sub == 8 || sub == 14 || sub == 16 {
    const el = M.types[imA].params[0]
    if sub == 8 {
      const vs: i32[] = []
      while vs.length < min(imB, 4096) { vs.push(el) }
      want = vs
    } else {
      want = [el]
    }
    if sub == 6 || sub == 16 { above = 1 }
  }
  const n = want.length
  let i = 0
  while i < n {
    if holderOf(want[i]) == H_ANY {
      const e = peek(above + n - 1 - i)
      const h = holderOfOperand(e)
      if h >= 0 {
        if erasedRoot[h] < 0 { erasedRoot[h] = f }
      } else if h == H_ANY && !isAnyHeap((e - REF) >> 1) {
        if erasedAny < 0 { erasedAny = f }
      }
    }
    i = i + 1
  }
}

// ---- The flattening's sites, read before each op runs ----

function flatCand(a: i32): boolean { a >= 0 && a < nTypes && arrRec[a] >= 0 }

// Refuses candidate array type `a` outright, the first reason winning.
function flatBad(a: i32, what: string) {
  if flatCand(a) && arrBadF[a] == -2 {
    const w: u8[] = []
    putText(w, what)
    arrBadW[a] = w
    arrBadF[a] = curF
  }
}

function flatPush(kind: i32, a: i32, k: i32, off: i32, reach: boolean) {
  fsK.push(k)
  fsOff.push(off)
  fsReach.push(reach)
  fsTy.push(a)
  fsKind.push(kind)
  fsOLo.push(foNull.length)
  fsOHi.push(foNull.length)
  fsUse.push(-1)
  fsUA.push(0)
  fsUB.push(0)
  fsCast.push(false)
}

// Records the operand `d` below the top as an element the last site stores.
function flatOpnd(d: i32, hb: i32, reach: boolean, base: i32, segLo: i32) {
  const q = if hb > d { producer(hb - 1 - d, reach, base, segLo) } else { NONE }
  foNull.push(nullableAt(d, reach))
  foProd.push(q)
  foCast.push(false)
  fsOHi[fsOHi.length - 1] = foNull.length
}

function flatSite(
  op: i32,
  sub: i32,
  k: i32,
  off: i32,
  hb: i32,
  reach: boolean,
  base: i32,
  segLo: i32,
) {
  if op == 0xd4 {
    const s = fsK.length - 1
    if s >= fbCur && fsK[s] == k - 1 && fsKind[s] == AK_GET { fsCast[s] = true }
    return
  }
  if sub == 6 {
    flatBad(
      imA,
      "an array.new fills it from one shared value, which a flat array would copy into every element",
    )
  } else if sub == 7 && flatCand(imA) {
    flatPush(AK_NEWDEF, imA, k, off, reach)
  } else if sub == 8 && flatCand(imA) {
    flatPush(AK_FIXED, imA, k, off, reach)
    let i = 0
    while i < imB {
      flatOpnd(imB - 1 - i, hb, reach, base, segLo)
      i = i + 1
    }
  } else if sub == 11 && flatCand(imA) {
    flatPush(AK_GET, imA, k, off, reach)
  } else if sub == 14 && flatCand(imA) {
    flatPush(AK_SET, imA, k, off, reach)
    flatOpnd(0, hb, reach, base, segLo)
  } else if sub == 17 {
    if imA == imB && flatCand(imA) {
      flatPush(AK_COPY, imA, k, off, reach)
    } else {
      flatBad(imA, "an array.copy from another array type")
      flatBad(imB, "an array.copy into another array type")
    }
  } else if sub == 15 {
    const e = peek(0)
    if e >= REF {
      const h = holderOfOperand(e)
      if h >= 0 {
        if flatCand(h) { flatPush(AK_LEN, h, k, off, reach) }
      } else {
        for a in arrList {
          flatBad(a, "an array.len of an abstract array reference")
        }
      }
    }
  } else if sub == 9 || sub == 10 || sub == 16 || sub == 18 || sub == 19 {
    flatBad(imA, "an array op the flattening does not rewrite")
  }
}

// ---- After the walk: which stores are of non-null values, and how each read is used ----

function afterWalk(f: i32, tight: boolean) {
  const nonNull = nonNullGets(post.length)
  rbTouch.push(touch)
  rbTight.push(tight)
  rbLocals.push(locT.length)
  rbLo.push(rsK.length)
  let s = 0
  while s < bsK.length {
    rsK.push(bsK[s])
    rsReach.push(bsOff[s] >= 0)
    rsTy.push(bsTy[s])
    rsSet.push(bsSet[s])
    rsLo.push(roField.length)
    let o = bsLo[s]
    while o < bsHi[s] {
      const q = boProd[o]
      roField.push(boField[o])
      roProd.push(q)
      roNew.push(if q != NONE { newOf[q] } else { -1 })
      roCast.push(boNull[o] && q != NONE && nonNull[q])
      o = o + 1
    }
    rsHi.push(roField.length)
    s = s + 1
  }
  rbHi.push(rsK.length)
  s = 0
  while s < bsOff.length {
    if bsOff[s] >= 0 {
      let o = bsLo[s]
      while o < bsHi[s] {
        let nullable = boNull[o]
        if nullable && boProd[o] != NONE && nonNull[boProd[o]] {
          nullable = false
        }
        if nullable {
          nlDst.push(bsTy[s] * PAIR + boField[o])
          nlSrc.push(boFrom[o])
          nlNew.push(bsNew[s])
          nlOff.push(bsOff[s])
          nlF.push(f)
        }
        o = o + 1
      }
    }
    s = s + 1
  }
  if flatScan && arrList.length > 0 { flatAfter(nonNull) }
  tally(f)
}

// The op after `k`, past one `ref.as_non_null`, or -1.
function afterCast(k: i32): i32 {
  let n = k + 1
  if n < smK.length && smK[n] == SM_ASNN { n = n + 1 }
  if n < smK.length { n } else { -1 }
}

function fieldReadOf(n: i32, v: i32): boolean {
  n >= 0 && smK[n] == SM_SGET && holds(smA[n], v) && smB[n] < fieldCount(smA[n])
}

function tally(f: i32) {
  // The locals a candidate read is stored into: tee'd, how many sets, whether every get is
  // read through a field, per record type asked.
  const luIx: {[i32]: i32} = Map()
  const luL: i32[] = []
  for k in getK {
    const n = afterCast(k)
    if n >= 0 && smK[n] == SM_SET && !luIx.has(smA[n]) {
      luIx[smA[n]] = luL.length
      luL.push(smA[n])
    }
  }
  const luTee: boolean[] = []
  const luSets: i32[] = []
  const luReads: i32[][] = []
  for _ in luL {
    luTee.push(false)
    luSets.push(0)
    luReads.push([])
  }
  if luL.length > 0 {
    let q = 0
    while q < smK.length {
      const kind = smK[q]
      if (
        (kind == SM_TEE || kind == SM_SET || kind == SM_GET)
        && luIx.has(smA[q])
      ) {
        const u = luIx[smA[q]] ?? 0
        if kind == SM_TEE { luTee[u] = true }
        if kind == SM_SET { luSets[u] = luSets[u] + 1 }
        if kind == SM_GET { luReads[u].push(afterCast(q)) }
      }
      q = q + 1
    }
  }
  let i = 0
  while i < getK.length {
    const k = getK[i]
    const key = getKey[i]
    const v = potential[key] ?? 0
    let how = 2
    const n = afterCast(k)
    if fieldReadOf(n, v) {
      how = 0
    } else if n >= 0 && smK[n] == SM_SET && smA[n] >= nParams {
      const u = luIx[smA[n]] ?? 0
      if !luTee[u] && luSets[u] == 1 {
        let all = true
        for r in luReads[u] {
          if !fieldReadOf(r, v) { all = false }
        }
        if all { how = 1 }
      }
    }
    const last = if k + 1 < smK.length && smK[k + 1] == SM_ASNN { k + 1 } else { k }
    if how == 0 {
      rdField[key] = (rdField[key] ?? 0) + 1
    } else if how == 1 {
      rdLocal[key] = (rdLocal[key] ?? 0) + 1
    } else if argOfG.has(last) {
      argP.push(key)
      argG.push(argOfG[last] ?? 0)
      argA.push(argOfJ[last] ?? 0)
      argF.push(f)
    } else {
      rdWhole[key] = (rdWhole[key] ?? 0) + 1
      if !rdWholeIn.has(key) { rdWholeIn[key] = f }
    }
    i = i + 1
  }
}

// Per op, whether it is a `local.get` of a tracked local that holds no null there: on every
// path the last set of it stored a value whose type excludes null. A loop's entry state, less
// the locals some set inside it may make null, holds at every back edge.
function nonNullGets(nOps: i32): boolean[] {
  const out: boolean[] = []
  while out.length < nOps { out.push(false) }
  const killAt: {[i32]: i32} = Map()
  const killed: i32[][] = []
  const open: i32[] = []
  let e = 0
  while e < flKind.length {
    const op = flOp[e]
    if flKind[e] == FL_CTL {
      if op == 0x03 { open.push(flK[e]) }
      if op == 0x02 || op == 0x04 || op == 0x1f { open.push(-1) }
      if op == 0x0b && open.length > 0 { open.pop() }
    }
    if flKind[e] == FL_SET && !flNN[e] {
      for lk in open {
        if lk >= 0 {
          if !killAt.has(lk) {
            killAt[lk] = killed.length
            killed.push([])
          }
          const ks = killed[killAt[lk] ?? 0]
          if !i32ListHas(ks, flL[e]) { ks.push(flL[e]) }
        }
      }
    }
    e = e + 1
  }
  let curLive = true
  let cur: i32[] = []
  const afLoop: boolean[] = [false]
  const afIf: boolean[] = [false]
  const afElse: boolean[] = [false]
  const afEntL: boolean[] = [true]
  const afEnt: i32[][] = [[]]
  const afOutL: boolean[] = [false]
  const afOut: i32[][] = [[]]
  e = 0
  while e < flKind.length {
    const kind = flKind[e]
    const op = flOp[e]
    if kind == FL_GET {
      if curLive && i32ListHas(cur, flL[e]) { out[flK[e]] = true }
    } else if kind == FL_SET {
      if curLive {
        if flNN[e] {
          if !i32ListHas(cur, flL[e]) { cur.push(flL[e]) }
        } else {
          cur = without(cur, flL[e])
        }
      }
    } else if op == 0x02 || op == 0x03 || op == 0x04 || op == 0x1f {
      if op == 0x1f {
        let x = flLo[e]
        while x < flHi[e] {
          branch(afLoop, afOutL, afOut, flLab[x], curLive, cur)
          x = x + 1
        }
      }
      if op == 0x03 && curLive && killAt.has(flK[e]) {
        for l in killed[killAt[flK[e]] ?? 0] { cur = without(cur, l) }
      }
      afLoop.push(op == 0x03)
      afIf.push(op == 0x04)
      afElse.push(false)
      afEntL.push(curLive)
      afEnt.push(copyL(cur))
      afOutL.push(false)
      afOut.push([])
    } else if op == 0x05 {
      const t = afLoop.length - 1
      if t >= 0 {
        meet(afOutL, afOut, t, curLive, cur)
        afElse[t] = true
        curLive = afEntL[t]
        cur = copyL(afEnt[t])
      }
    } else if op == 0x0b {
      const t = afLoop.length - 1
      if t >= 0 {
        if afIf[t] && !afElse[t] { meet(afOutL, afOut, t, afEntL[t], afEnt[t]) }
        meet(afOutL, afOut, t, curLive, cur)
        curLive = afOutL[t]
        cur = afOut[t]
        afLoop.pop()
        afIf.pop()
        afElse.pop()
        afEntL.pop()
        afEnt.pop()
        afOutL.pop()
        afOut.pop()
      }
    } else if op == 0x0c {
      branch(afLoop, afOutL, afOut, flL[e], curLive, cur)
      curLive = false
    } else if (
      op == 0x0d
      || op == 0xd5
      || op == 0xd6
      || op == 0xfb0018
      || op == 0xfb0019
    ) {
      branch(afLoop, afOutL, afOut, flL[e], curLive, cur)
    } else if op == 0x0e {
      let x = flLo[e]
      while x < flHi[e] {
        branch(afLoop, afOutL, afOut, flLab[x], curLive, cur)
        x = x + 1
      }
      curLive = false
    } else {
      curLive = false
    }
    e = e + 1
  }
  out
}

function branch(
  afLoop: boolean[],
  afOutL: boolean[],
  afOut: i32[][],
  depth: i32,
  live: boolean,
  s: i32[],
) {
  const i = afLoop.length - 1 - depth
  if depth >= 0 && i >= 0 && !afLoop[i] { meet(afOutL, afOut, i, live, s) }
}

function meet(outL: boolean[], out: i32[][], i: i32, live: boolean, s: i32[]) {
  if !live { return }
  if !outL[i] {
    outL[i] = true
    out[i] = copyL(s)
    return
  }
  const keep: i32[] = []
  for l in out[i] {
    if i32ListHas(s, l) { keep.push(l) }
  }
  out[i] = keep
}

function without(s: i32[], l: i32): i32[] {
  const out: i32[] = []
  for x in s {
    if x != l { out.push(x) }
  }
  out
}

function copyL(s: i32[]): i32[] {
  const out: i32[] = []
  for x in s { out.push(x) }
  out
}

// ---- After the walk: how each element read of a candidate array is used ----

// The walked body closes its sites: a stored value whose type admits null is
// non-null after all when the local it is read from holds no null there.
function flatAfter(nonNull: boolean[]) {
  const lo = fbCur
  const hi = fsK.length
  fbLo.push(lo)
  fbHi.push(hi)
  const gets: i32[] = []
  const stored: {[i32]: i32} = Map()
  let s = lo
  while s < hi {
    let x = fsOLo[s]
    while x < fsOHi[s] {
      const q = foProd[x]
      if foNull[x] && q != NONE && nonNull[q] {
        foNull[x] = false
        foCast[x] = true
      }
      x = x + 1
    }
    if fsKind[s] == AK_GET { gets.push(s) }
    if fsKind[s] == AK_SET && foProd[fsOLo[s]] != NONE {
      stored[foProd[fsOLo[s]]] = fsTy[s]
    }
    s = s + 1
  }
  if gets.length == 0 { return }
  const sets: {[i32]: i32} = Map()
  let q = 0
  while q < smK.length {
    if smK[q] == SM_SET || smK[q] == SM_TEE {
      sets[smA[q]] = (sets[smA[q]] ?? 0) + 1
    }
    q = q + 1
  }
  const plain = elemLocals(gets, stored, false)
  const held = elemLocals(gets, stored, true)
  for g in gets {
    const k = fsK[g]
    const v = arrRec[fsTy[g]]
    const last = if k + 1 < smK.length && smK[k + 1] == SM_ASNN { k + 1 } else { k }
    const n = afterCast(k)
    const l = if n >= 0 && smK[n] == SM_SET { smA[n] } else { -1 }
    const isPlain = l >= 0 && plain.has(l) && (sets[l] ?? 0) == 1
    if fieldReadOf(n, v) {
      fsUse[g] = AU_FIELD
      fsUA[g] = n
      fsUB[g] = smB[n]
    } else if l >= 0 && (isPlain || held.has(l)) {
      fsUse[g] = AU_LOCAL
      fsUA[g] = l
      fsUB[g] = if isPlain { 0 } else { 1 }
    } else {
      const ag = argOfG[last]
      if ag != null {
        fsUse[g] = AU_ARG
        fsUA[g] = ag
        fsUB[g] = argOfJ[last] ?? 0
      } else {
        fsUse[g] = AU_WHOLE
      }
    }
  }
}

// The locals (not parameters) an element read of a candidate array is set into that are never
// tee'd, set only to such a read of that array (past an optional `ref.as_non_null`), a fresh
// record of its element type or a producer's result, and read only for a field, a store back
// or a field-only parameter. `wide` also takes the locals a store reads, and producer calls.
function elemLocals(
  gets: i32[],
  stored: {[i32]: i32},
  wide: boolean,
): {[i32]: i32} {
  const arrOf: {[i32]: i32} = Map()
  const keys: i32[] = []
  const badL: {[i32]: i32} = Map()
  for g in gets {
    const n = afterCast(fsK[g])
    if n >= 0 && smK[n] == SM_SET && smA[n] >= nParams {
      const l = smA[n]
      if !arrOf.has(l) {
        arrOf[l] = fsTy[g]
        keys.push(l)
      } else if (arrOf[l] ?? 0) != fsTy[g] {
        badL[l] = 1
      }
    }
  }
  let grow = wide
  while grow {
    const before = keys.length
    let q = 0
    while q < smK.length {
      const l = smA[q]
      if smK[q] == SM_GET && l >= nParams && !arrOf.has(l) {
        let into = -1
        if q + 1 < smK.length && smK[q + 1] == SM_SET {
          const l3 = smA[q + 1]
          if l3 != l { into = arrOf[l3] ?? -1 }
        } else {
          into = stored[q] ?? -1
        }
        if into >= 0 {
          arrOf[l] = into
          keys.push(l)
        }
      }
      q = q + 1
    }
    grow = keys.length != before
  }
  let q = 0
  while q < smK.length {
    if smK[q] == SM_TEE { badL[smA[q]] = 1 }
    q = q + 1
  }
  let again = true
  while again {
    const drop: i32[] = []
    q = 0
    while q < smK.length {
      const kind = smK[q]
      const l = smA[q]
      if (kind == SM_SET || kind == SM_GET) && !badL.has(l) && arrOf.has(l) {
        const a = arrOf[l] ?? 0
        if (
          !(if kind == SM_SET { setOk(q, l, a, arrOf, badL, wide) } else { getOk(q, l, a, arrOf, badL, stored, wide) })
        ) {
          drop.push(l)
        }
      }
      q = q + 1
    }
    for l in drop { badL[l] = 1 }
    again = drop.length > 0
  }
  const out: {[i32]: i32} = Map()
  for l in keys {
    if !badL.has(l) { out[l] = 1 }
  }
  out
}

function goodL(
  arrOf: {[i32]: i32},
  badL: {[i32]: i32},
  l: i32,
  a: i32,
): boolean {
  arrOf.has(l) && (arrOf[l] ?? 0) == a && !badL.has(l)
}

// Whether the `local.set` at op `q` of local `l` (held for array type `a`) sets what it may.
function setOk(
  q: i32,
  l: i32,
  a: i32,
  arrOf: {[i32]: i32},
  badL: {[i32]: i32},
  wide: boolean,
): boolean {
  if q == 0 { return false }
  const p = smK[q - 1]
  if p == SM_NEW { return smA[q - 1] == arrRec[a] }
  if p == SM_ASNN { return q >= 2 && smK[q - 2] == SM_AGET && smA[q - 2] == a }
  if p == SM_GET { return smA[q - 1] != l && goodL(arrOf, badL, smA[q - 1], a) }
  if p == SM_CALL { return wide && mvProdOf(smA[q - 1]) == arrRec[a] }
  p == SM_AGET && smA[q - 1] == a
}

// Whether the `local.get` at op `q` of local `l` reads it as it may.
function getOk(
  q: i32,
  l: i32,
  a: i32,
  arrOf: {[i32]: i32},
  badL: {[i32]: i32},
  stored: {[i32]: i32},
  wide: boolean,
): boolean {
  const v = arrRec[a]
  const n = afterCast(q)
  if fieldReadOf(n, v) { return true }
  if n >= 0 && smK[n] == SM_SET {
    return n == q + 1 && smA[n] != l && goodL(arrOf, badL, smA[n], a)
  }
  if (stored[q] ?? -1) == a { return true }
  argOfG.has(q) && fieldArg(argOfG[q] ?? 0, argOfJ[q] ?? 0, v, wide)
}

// Parameter `j` of function `g` is a field-only parameter of exactly record type `v`.
function fieldArg(g: i32, j: i32, v: i32, wide: boolean): boolean {
  if !wide || g < 0 || g >= funcType.length || !isFunc(funcType[g]) {
    return false
  }
  const ps = M.types[funcType[g]].params
  j < ps.length && refIdx(ps[j]) == v && mvFoHas(g, j)
}

// The multi-value step's facts on the scanned module, read when first asked.
function ensureMv() {
  if mvReady { return }
  mvReady = true
  mvFo = Map()
  for key in mvFieldOnlyParams(B, true) { mvFo[key] = 1 }
  mvProd = mvProducerRecords()
}

function mvFoHas(g: i32, j: i32): boolean {
  ensureMv()
  j < 64 && mvFo.has(g * 64 + j)
}

function mvProdOf(g: i32): i32 {
  ensureMv()
  if g >= 0 && g < mvProd.length { mvProd[g] } else { -1 }
}

// ---- The decision ----

// Why record type `v` may not be stored inline, or empty.
function recordRefusal(v: i32): u8[] {
  const out: u8[] = []
  let u = 0
  while u < nTypes {
    if writer[u] >= 0 && comp[u] == comp[v] {
      if u == v {
        putText(out, "its fields are written (struct.set ")
      } else {
        putText(out, "type ")
        putDec(out, u)
        putText(out, ", in its subtyping component, is written (struct.set ")
      }
      putDec(out, u)
      putText(out, " in ")
      putName(out, writer[u])
      putText(out, ")")
      return out
    }
    u = u + 1
  }
  const what = crossing(v)
  if what.length > 0 {
    putText(out, "a value of it can cross the module boundary (")
    putBytes(out, what)
    putText(out, ")")
    return out
  }
  let i = 0
  while i < identH.length {
    if holds(identH[i], v) {
      putText(
        out,
        "its identity is observable (ref.eq or extern.convert_any in ",
      )
      putName(out, identF[i])
      putText(out, ")")
      return out
    }
    i = i + 1
  }
  out
}

// Writes the decision: per record type `r <v>[ <why>]`, then per candidate field in order
// `p <p> <j> <v> i <local> <arg>` when inlined, `p <p> <j> <v> n <why>` when not.
function decideFields(rebox: boolean, fault: boolean) {
  sortAsc(potKeys)
  const pairIx: {[i32]: i32} = Map()
  let i = 0
  while i < potKeys.length {
    pairIx[potKeys[i]] = i
    i = i + 1
  }
  const okRec: boolean[] = []
  for _ in M.types { okRec.push(false) }
  const records: i32[] = []
  for key in potKeys {
    const v = potential[key] ?? 0
    if !i32ListHas(records, v) { records.push(v) }
  }
  sortAsc(records)
  for v in records {
    const why = recordRefusal(v)
    decRecs.push(v)
    decRecWhy.push(why)
    if why.length == 0 { okRec[v] = true }
  }
  if argP.length > 0 {
    const fo: {[i32]: i32} = Map()
    for key in mvFieldOnlyParams(B, true) { fo[key] = 1 }
    i = 0
    while i < argP.length {
      const key = argP[i]
      if argA[i] < 64 && fo.has(argG[i] * 64 + argA[i]) {
        rdArg[key] = (rdArg[key] ?? 0) + 1
      } else {
        rdWhole[key] = (rdWhole[key] ?? 0) + 1
        if !rdWholeIn.has(key) { rdWholeIn[key] = argF[i] }
      }
      i = i + 1
    }
  }
  const refused: u8[][] = []
  const inl: i32[] = []
  for _ in potKeys {
    refused.push([])
    inl.push(-1)
  }
  const needDst: i32[] = []
  const needSrc: i32[] = []
  const needWhy: u8[][] = []
  i = 0
  while i < nlDst.length {
    const dst = pairIx[nlDst[i]] ?? 0
    const why: u8[] = []
    putText(why, "a value whose type admits null is stored into it (")
    putText(why, if nlNew[i] { "struct.new" } else { "struct.set" })
    putText(why, " at byte 0x")
    putHex(why, nlOff[i])
    putText(why, " in ")
    putName(why, nlF[i])
    putText(why, ")")
    if nlSrc[i] >= 0 && nlSrc[i] != nlDst[i] {
      needDst.push(dst)
      needSrc.push(pairIx[nlSrc[i]] ?? 0)
      needWhy.push(why)
    } else if nlSrc[i] < 0 && refused[dst].length == 0 {
      refused[dst] = why
    }
    i = i + 1
  }
  i = 0
  while i < potKeys.length {
    const key = potKeys[i]
    const p = key / PAIR
    const v = potential[key] ?? 0
    const why: u8[] = []
    const what = crossing(p)
    const whole = rdWhole[key] ?? 0
    if fault {
      putText(why, "refused by $VL_INLINE_FAULT")
    } else if !okRec[v] {
      putText(why, "its record type ")
      putDec(why, v)
      putText(why, " is refused (above)")
    } else if defaultMade[p] >= 0 {
      putText(why, "type ")
      putDec(why, p)
      putText(why, " is made by struct.new_default (in ")
      putName(why, defaultMade[p])
      putText(why, ")")
    } else if what.length > 0 {
      putText(why, "type ")
      putDec(why, p)
      putText(why, " can cross the module boundary (")
      putBytes(why, what)
      putText(why, "), so its layout is not ours to change")
    } else if constMade[p] {
      putText(why, "type ")
      putDec(why, p)
      putText(why, " is made in a constant expression (a global's initializer)")
    } else if refused[i].length > 0 {
      putBytes(why, refused[i])
    } else if whole > 0 && !rebox {
      putDec(why, whole)
      putText(why, " of its ")
      putDec(
        why,
        (rdField[key] ?? 0) + (rdLocal[key] ?? 0) + (rdArg[key] ?? 0) + whole,
      )
      putText(why, " read(s) take the whole record (first in ")
      putName(why, rdWholeIn[key] ?? 0)
      putText(
        why,
        "), and each would allocate a copy where today it shares the box",
      )
    }
    if why.length == 0 { inl[i] = v } else { refused[i] = why }
    i = i + 1
  }
  fixpoint(pairIx, inl, refused, needDst, needSrc, needWhy)
  decInl = inl
  decWhy = refused
}

// A subtype and its supertype lay a shared field out alike, and a field fed from another
// field's read needs that field inlined: drops inlined fields until both hold.
function fixpoint(
  pairIx: {[i32]: i32},
  inl: i32[],
  refused: u8[][],
  needDst: i32[],
  needSrc: i32[],
  needWhy: u8[][],
) {
  let changed = true
  while changed {
    const dropIx: i32[] = []
    const dropWhy: u8[][] = []
    let i = 0
    while i < needDst.length {
      if inl[needDst[i]] >= 0 && inl[needSrc[i]] < 0 {
        dropIx.push(needDst[i])
        dropWhy.push(needWhy[i])
      }
      i = i + 1
    }
    let t = 0
    while t < nTypes {
      const sup = superOf[t]
      if sup >= 0 {
        const n = min(fieldCount(t), fieldCount(sup))
        let j = 0
        while j < n {
          const ta = pairIx[t * PAIR + j] ?? -1
          const sa = pairIx[sup * PAIR + j] ?? -1
          const a = if ta >= 0 { inl[ta] } else { -1 }
          const b = if sa >= 0 { inl[sa] } else { -1 }
          if a != b {
            if a >= 0 {
              const why: u8[] = []
              putText(why, "its supertype ")
              putDec(why, sup)
              putText(why, " does not inline field ")
              putDec(why, j)
              dropIx.push(ta)
              dropWhy.push(why)
            }
            if b >= 0 {
              const why: u8[] = []
              putText(why, "its subtype ")
              putDec(why, t)
              putText(why, " does not inline field ")
              putDec(why, j)
              dropIx.push(sa)
              dropWhy.push(why)
            }
          }
          j = j + 1
        }
      }
      t = t + 1
    }
    changed = dropIx.length > 0
    i = 0
    while i < dropIx.length {
      if inl[dropIx[i]] >= 0 {
        inl[dropIx[i]] = -1
        refused[dropIx[i]] = dropWhy[i]
      }
      i = i + 1
    }
  }
}

// ---- The rewrite ----

let rwLog: u8[] = []
let rwSum: u8[] = []
let rwMoves: u8[] = []
let rwErr = ""
let layIx: i32[] = []
let layStart: i32[][] = []
let layRec: i32[][] = []
let stStores: {[i32]: i32} = Map()
let stAtProd: {[i32]: i32} = Map()
let stSpilled: {[i32]: i32} = Map()
let stFieldReads: {[i32]: i32} = Map()
let stReboxed: {[i32]: i32} = Map()

// The body being rewritten: its added locals, and per op the code that replaces it or follows
// it (an index into `rwCodes`).
let rwExtra: i32[] = []
let rwNext = 0
let rwRep: {[i32]: i32} = Map()
let rwAft: {[i32]: i32} = Map()
let rwCodes: u8[][] = []
let opOff: i32[] = []
let opEnd: i32[] = []
let opCode: i32[] = []
let opA: i32[] = []
let opB: i32[] = []

// The step on the staged module: decides, then rewrites. Returns 1 with the module in `optOut`,
// or 0 when it leaves the module alone. `stable` and `rebox` are as in `decide`; `spill` takes
// every store apart at the store; `fault` 2 refuses every field, and 3 ends each rewritten
// body's locals with an empty entry (a valid module with other bytes).
export function optInlineRewrite(
  stable: i32,
  rebox: i32,
  spill: i32,
  valid: i32,
  fault: i32,
): i32 {
  optOutSet([])
  rwLog = []
  rwSum = []
  rwMoves = []
  flatNum = []
  if valid == 0 { return 0 }
  bad = false
  decide(optInBytes(), stable != 0, rebox != 0, fault == 2)
  if bad || potKeys.length == 0 || decInl.length != potKeys.length {
    rwLog = []
    return 0
  }
  explainRecords()
  let inlined = 0
  for v in decInl {
    if v >= 0 { inlined = inlined + 1 }
  }
  if inlined == 0 {
    let i = 0
    while i < potKeys.length {
      explainPair(i)
      i = i + 1
    }
    putText(rwLog, "inline-explain: no field inlined\n")
    return 0
  }
  rwErr = ""
  const out = rewrite(spill != 0, fault == 3)
  if rwErr.length > 0 {
    putText(rwLog, "inline-explain: step abandoned: ")
    putText(rwLog, rwErr)
    rwLog.push(10)
    rwMoves = []
    return 0
  }
  let i = 0
  const parents: i32[] = []
  while i < potKeys.length {
    explainPair(i)
    const p = potKeys[i] / PAIR
    if decInl[i] >= 0 && !i32ListHas(parents, p) { parents.push(p) }
    i = i + 1
  }
  putText(rwSum, "inline-explain: ")
  putDec(rwSum, inlined)
  putText(rwSum, " field(s) of ")
  putDec(rwSum, parents.length)
  putText(rwSum, " type(s) inlined\n")
  optOutSet(out)
  1
}

// The last rewrite's body moves: a count, then per output body its input body's byte range, a
// pair count, and per op its offset in the input and in the output module (all ULEB128).
export function optInlineMoves(): i32 {
  optOutSet(rwMoves)
  0
}

// The last run's `$VL_INLINE_EXPLAIN` lines up to the output's validation, each ending in a
// newline.
export function optInlineExplain(): i32 {
  optOutSet(rwLog)
  0
}

// The last rewrite's closing explain line, for the host to print once its output validates.
export function optInlineSummary(): i32 {
  optOutSet(rwSum)
  0
}

function explainRecords() {
  let r = 0
  while r < decRecs.length {
    const v = decRecs[r]
    putText(rwLog, "inline-explain: type ")
    putDec(rwLog, v)
    putText(rwLog, " {")
    let i = 0
    for x in M.types[v].params {
      if i > 0 { putText(rwLog, ", ") }
      putText(
        rwLog,
        if x == 0x7f { "i32" } else if x == 0x7e { "i64" } else if x == 0x7d { "f32" } else { "f64" },
      )
      i = i + 1
    }
    if decRecWhy[r].length == 0 {
      putText(rwLog, "}: candidate\n")
    } else {
      putText(rwLog, "}: refused: ")
      putBytes(rwLog, decRecWhy[r])
      rwLog.push(10)
    }
    r = r + 1
  }
}

function explainPair(i: i32) {
  const key = potKeys[i]
  putText(rwLog, "inline-explain: type ")
  putDec(rwLog, key / PAIR)
  putText(rwLog, " field ")
  putDec(rwLog, key % PAIR)
  putText(rwLog, " (type ")
  putDec(rwLog, potential[key] ?? 0)
  if decInl[i] < 0 {
    putText(rwLog, "): not inlined: ")
    putBytes(rwLog, decWhy[i])
    rwLog.push(10)
    return
  }
  putText(rwLog, "): inlined; ")
  putDec(rwLog, stStores[key] ?? 0)
  putText(rwLog, " store(s) (")
  putDec(rwLog, stAtProd[key] ?? 0)
  putText(rwLog, " taken apart at the producer, ")
  putDec(rwLog, stSpilled[key] ?? 0)
  putText(rwLog, " spilled), ")
  putDec(rwLog, stFieldReads[key] ?? 0)
  putText(rwLog, " read(s) as fields, ")
  putDec(rwLog, stReboxed[key] ?? 0)
  putText(rwLog, " re-boxed (")
  putDec(rwLog, rdLocal[key] ?? 0)
  putText(rwLog, " into a field-read local, ")
  putDec(rwLog, rdArg[key] ?? 0)
  putText(rwLog, " into a field parameter)\n")
}

function bump(m: {[i32]: i32}, key: i32) { m[key] = (m[key] ?? 0) + 1 }

function recLen(v: i32): i32 { M.types[v].params.length }

// The module with each inlined field's record stored in its parent, every body naming a parent
// rewritten, and `rwMoves` filled; sets `rwErr` when it cannot.
function rewrite(spill: boolean, fault: boolean): u8[] {
  const none: u8[] = []
  stStores = Map()
  stAtProd = Map()
  stSpilled = Map()
  stFieldReads = Map()
  stReboxed = Map()
  layIx = []
  layStart = []
  layRec = []
  for _ in M.types { layIx.push(-1) }
  const inlOf: {[i32]: i32} = Map()
  let i = 0
  while i < potKeys.length {
    if decInl[i] >= 0 { inlOf[potKeys[i]] = decInl[i] }
    i = i + 1
  }
  i = 0
  while i < potKeys.length {
    const p = potKeys[i] / PAIR
    if decInl[i] >= 0 && layIx[p] < 0 {
      layIx[p] = layStart.length
      const start: i32[] = []
      const rec: i32[] = []
      let at = 0
      let j = 0
      while j < fieldCount(p) {
        start.push(at)
        const v = inlOf[p * PAIR + j] ?? -1
        rec.push(v)
        at = at + (if v >= 0 { recLen(v) } else { 1 })
        j = j + 1
      }
      start.push(at)
      layStart.push(start)
      layRec.push(rec)
    }
    i = i + 1
  }
  const hdr = bodyStarts()
  if rwErr.length > 0 { return none }
  const bodies: u8[][] = []
  const moves: i32[][] = []
  let bi = 0
  while bi < M.bodies.length {
    const body = M.bodies[bi]
    if !rbTouch[bi] {
      const b: u8[] = []
      copyBytes(b, B, hdr[bi], body.to - hdr[bi])
      bodies.push(b)
      moves.push([hdr[bi], 0])
    } else {
      const mv: i32[] = []
      const b = rewriteBody(bi, hdr[bi], spill, fault, mv)
      if rwErr.length > 0 { return none }
      bodies.push(b)
      moves.push(mv)
    }
    bi = bi + 1
  }
  const types = typeSection()
  if rwErr.length > 0 { return none }
  assemble(types, bodies, moves, hdr)
}

// The type section, every type re-encoded by `encodeSub`, its rec groups kept; sets `rwErr`
// when it cannot.
function typeSection(): u8[] {
  const none: u8[] = []
  const types: u8[] = []
  wnPutLeb(types, M.groupSize.length)
  let t = 0
  let g = 0
  while g < M.groupSize.length {
    const n = M.groupSize[g]
    if M.groupExplicit[g] {
      types.push(0x4e)
      wnPutLeb(types, n)
    } else if n != 1 {
      rwErr = "an implicit rec group holds several types"
      return none
    }
    let k = 0
    while k < n {
      if !encodeSub(types, t) {
        rwErr = "a type does not re-encode"
        return none
      }
      t = t + 1
      k = k + 1
    }
    g = g + 1
  }
  types
}

// Body `bi`'s ops into `opOff`, `opEnd`, `opCode`, `opA` and `opB`; false, with `rwErr` set,
// when it does not decode.
function decodeOps(bi: i32): boolean {
  const body = M.bodies[bi]
  opOff = []
  opEnd = []
  opCode = []
  opA = []
  opB = []
  const c = wcNew(B, body.from, body.to)
  while c.pos < c.end {
    const off = c.pos
    imA = 0
    imB = 0
    const op = wcOp(c)
    if c.failed || !decodeImm(op, off, c.pos) {
      rwErr = "a body does not decode"
      return false
    }
    opOff.push(off)
    opEnd.push(c.pos)
    opCode.push(op)
    opA.push(imA)
    opB.push(imB)
  }
  true
}

// Each body's start in the module: where its locals header begins, past its size.
function bodyStarts(): i32[] {
  const out: i32[] = []
  let s = 0
  while s < M.secId.length {
    if M.secId[s] == 10 {
      const c = wcNew(B, M.secStart[s], M.secEnd[s])
      wcByte(c)
      wcU32(c)
      const n = wcU32(c)
      let i = 0
      while i < n && !c.failed {
        const size = wcU32(c)
        out.push(c.pos)
        c.pos = c.pos + size
        i = i + 1
      }
    }
    s = s + 1
  }
  if out.length != M.bodies.length { rwErr = "a section does not frame" }
  out
}

function newLocal(t: i32): i32 {
  rwExtra.push(t)
  rwNext = rwNext + 1
  rwNext - 1
}

function refT(nullable: boolean, t: i32): i32 {
  (if nullable { 0x63 } else { 0x64 }) | ((0x100 + 2 * t) << 8)
}

function gcOp(out: u8[], sub: i32, t: i32, field: i32) {
  out.push(0xfb)
  wnPutLeb(out, sub)
  wnPutLeb(out, t)
  if field >= 0 { wnPutLeb(out, field) }
}

function castIf(out: u8[], cast: boolean) {
  if cast { out.push(0xd4) }
}

function localOp(out: u8[], op: i32, l: i32) {
  out.push(op)
  wnPutLeb(out, l)
}

function keep(c: u8[]): i32 {
  rwCodes.push(c)
  rwCodes.length - 1
}

// Body `bi`, whose header starts at `h0`, with its sites taken apart and every field index of
// a changed parent re-encoded; `mv` gets its moves.
function rewriteBody(
  bi: i32,
  h0: i32,
  spill: boolean,
  fault: boolean,
  mv: i32[],
): u8[] {
  const none: u8[] = []
  rwExtra = []
  rwNext = rbLocals[bi]
  rwRep = Map()
  rwAft = Map()
  rwCodes = []
  let s = rbLo[bi]
  while s < rbHi[bi] {
    planSite(s, spill)
    if rwErr.length > 0 { return none }
    s = s + 1
  }
  if !decodeOps(bi) { return none }
  const out: u8[] = []
  const moved: i32[] = []
  const n = opOff.length
  let i = 0
  while i < n {
    const k = i
    moved.push(opOff[i])
    moved.push(out.length)
    let consumed = 1
    const sub = if (opCode[i] >> 16) == 0xfb { opCode[i] & 0xffff } else { -1 }
    const p = opA[i]
    const j = opB[i]
    const L = if sub >= 2 && sub <= 5 && p >= 0 && p < nTypes { layIx[p] } else { -1 }
    const rep = rwRep[k] ?? -1
    if rep >= 0 {
      putBytes(out, rwCodes[rep])
    } else if L >= 0 && sub == 2 {
      const nj = layStart[L][j]
      const v = layRec[L][j]
      if v < 0 {
        gcOp(out, 2, p, nj)
      } else {
        let q = i + 1
        if q < n && opCode[q] == 0xd4 { q = q + 1 }
        let x = -1
        if q < n && opCode[q] == (0xfb << 16) + 2 {
          const t = opA[q]
          let clear = !rwAft.has(k)
          let r = i + 1
          while r <= q {
            if rwRep.has(r) || rwAft.has(r) { clear = false }
            r = r + 1
          }
          if holds(t, v) && opB[q] < fieldCount(t) && clear { x = opB[q] }
        }
        const key = p * PAIR + j
        if x >= 0 {
          bump(stFieldReads, key)
          gcOp(out, 2, p, nj + x)
          consumed = q + 1 - i
        } else {
          bump(stReboxed, key)
          const m = recLen(v)
          if m == 1 {
            gcOp(out, 2, p, nj)
          } else {
            const tp = newLocal(refT(true, p))
            localOp(out, 0x21, tp)
            let y = 0
            while y < m {
              localOp(out, 0x20, tp)
              gcOp(out, 2, p, nj + y)
              y = y + 1
            }
          }
          gcOp(out, 0, v, -1)
          // The box is non-null already; a cast after it would hide the allocation from the
          // multi-value step.
          if (
            i + 1 < n
            && opCode[i + 1] == 0xd4
            && !rwRep.has(k + 1)
            && !rwAft.has(k)
          ) {
            consumed = 2
          }
        }
      }
    } else if L >= 0 && (sub == 3 || sub == 4) {
      gcOp(out, sub, p, layStart[L][j])
    } else if L >= 0 && sub == 5 {
      if layRec[L][j] >= 0 {
        rwErr = "an inlined field's store was not planned"
        return none
      }
      gcOp(out, 5, p, layStart[L][j])
    } else {
      copyBytes(out, B, opOff[i], opEnd[i] - opOff[i])
    }
    const aft = rwAft[k] ?? -1
    if aft >= 0 { putBytes(out, rwCodes[aft]) }
    // A consumed op's own planned follow-on still runs: a store can take its value at the cast.
    let q = 1
    while q < consumed {
      moved.push(opOff[i + q])
      moved.push(out.length)
      const qa = rwAft[k + q] ?? -1
      if qa >= 0 { putBytes(out, rwCodes[qa]) }
      q = q + 1
    }
    i = i + consumed
  }
  finishBody(bi, h0, out, moved, fault, mv)
}

// Plans site `s`: the code that replaces its op, and what follows each producer taken apart.
function planSite(s: i32, spill: boolean) {
  const none: u8[] = []
  const p = rsTy[s]
  if p < 0 || p >= layIx.length || layIx[p] < 0 { return }
  const L = layIx[p]
  if rsSet[s] {
    const o = rsLo[s]
    const j = roField[o]
    const v = layRec[L][j]
    if v < 0 { return }
    const key = p * PAIR + j
    bump(stStores, key)
    const tv = newLocal(refT(false, v))
    const tp = newLocal(refT(true, p))
    const c: u8[] = []
    const prod = roProd[o]
    if rsReach[s] && prod != NONE && !spill {
      const a: u8[] = []
      castIf(a, roCast[o])
      localOp(a, 0x21, tv)
      if rwAft.has(prod) || rwRep.has(prod) {
        rwErr = "two rewrites claim one producer"
        return
      }
      rwAft[prod] = keep(a)
      bump(stAtProd, key)
    } else {
      castIf(c, roCast[o])
      localOp(c, 0x21, tv)
      bump(stSpilled, key)
    }
    localOp(c, 0x21, tp)
    const base = layStart[L][j]
    let i = 0
    while i < recLen(v) {
      localOp(c, 0x20, tp)
      localOp(c, 0x20, tv)
      gcOp(c, 2, v, i)
      gcOp(c, 5, p, base + i)
      i = i + 1
    }
    rwRep[rsK[s]] = keep(c)
    return
  }
  const ins: i32[] = []
  let o = rsLo[s]
  while o < rsHi[s] {
    if layRec[L][roField[o]] >= 0 { ins.push(o) }
    o = o + 1
  }
  if ins.length == 0 { return }
  let atProducers = rsReach[s] && !spill
  for x in ins {
    const prod = roProd[x]
    if prod == NONE || rwAft.has(prod) || rwRep.has(prod) {
      atProducers = false
    }
  }
  if atProducers {
    for x in ins {
      const v = layRec[L][roField[x]]
      const key = p * PAIR + roField[x]
      bump(stStores, key)
      bump(stAtProd, key)
      if roNew[x] == v {
        rwRep[roProd[x]] = keep(none)
      } else {
        const tv = newLocal(refT(false, v))
        const a: u8[] = []
        castIf(a, roCast[x])
        localOp(a, 0x21, tv)
        let i = 0
        while i < recLen(v) {
          localOp(a, 0x20, tv)
          gcOp(a, 2, v, i)
          i = i + 1
        }
        rwAft[roProd[x]] = keep(a)
      }
    }
    return
  }
  const params = M.types[p].params
  const first = roField[ins[0]]
  const ls: i32[] = []
  let j = first
  while j < params.length {
    const v = layRec[L][j]
    let t = params[j]
    if v >= 0 { t = refT(false, v) }
    else if t == 0x78 || t == 0x77 { t = 0x7f }
    ls.push(newLocal(t))
    j = j + 1
  }
  const c: u8[] = []
  let i = ls.length - 1
  while i >= 0 {
    let cast = false
    for x in ins {
      if roField[x] == first + i && roCast[x] { cast = true }
    }
    castIf(c, cast)
    localOp(c, 0x21, ls[i])
    i = i - 1
  }
  i = 0
  while i < ls.length {
    const v = layRec[L][first + i]
    if v >= 0 {
      const key = p * PAIR + first + i
      bump(stStores, key)
      bump(stSpilled, key)
      let y = 0
      while y < recLen(v) {
        localOp(c, 0x20, ls[i])
        gcOp(c, 2, v, y)
        y = y + 1
      }
    } else {
      localOp(c, 0x20, ls[i])
    }
    i = i + 1
  }
  gcOp(c, 0, p, -1)
  rwRep[rsK[s]] = keep(c)
}

// The rewritten body: its locals header (the old entries, their record locals declared
// non-null when that validated, then the added locals in runs of one type) and `code`; `fault`
// appends an empty `0 x i32` entry.
function finishBody(
  bi: i32,
  h0: i32,
  code: u8[],
  moved: i32[],
  fault: boolean,
  mv: i32[],
): u8[] {
  const none: u8[] = []
  const body = M.bodies[bi]
  const h = wcNew(B, h0, body.from)
  const n = wcU32(h)
  const entries = h.pos
  const flip: i32[] = []
  let e = 0
  while e < n && !h.failed {
    wcU32(h)
    const at = h.pos
    const v = rdVal(h)
    const r = refIdx(v)
    if rbTight[bi] && at < B.length && B[at] == 0x63 && r >= 0 && isRecord[r] {
      flip.push(at)
    }
    e = e + 1
  }
  if h.failed {
    rwErr = "a locals header does not decode"
    return none
  }
  const gN: i32[] = []
  const gT: i32[] = []
  for t in rwExtra {
    if gT.length > 0 && gT[gT.length - 1] == t {
      gN[gN.length - 1] = gN[gN.length - 1] + 1
    } else {
      gN.push(1)
      gT.push(t)
    }
  }
  if fault {
    gN.push(0)
    gT.push(0x7f)
  }
  const out: u8[] = []
  wnPutLeb(out, n + gN.length)
  const at0 = out.length
  copyBytes(out, B, entries, body.from - entries)
  for at in flip { out[at0 + at - entries] = 0x64 }
  let g = 0
  while g < gN.length {
    wnPutLeb(out, gN[g])
    if !putValLong(out, gT[g]) {
      rwErr = "a local's type does not encode"
      return none
    }
    g = g + 1
  }
  const header = out.length
  putBytes(out, code)
  mv.push(h0)
  mv.push(0)
  let i = 0
  while i < moved.length {
    mv.push(moved[i])
    mv.push(moved[i + 1] + header)
    i = i + 2
  }
  out
}

// Type `t` in the binary format, every value type in its long form, a parent's inlined fields
// expanded to its record's; false when it holds a type this cannot write.
function encodeSub(out: u8[], t: i32): boolean {
  const st = M.types[t]
  if st.form != 0x60 && st.form != 0x5e && st.form != 0x5f { return false }
  if st.prefix == 0x50 || st.supers.length > 0 {
    out.push(if st.prefix == 0x4f { 0x4f } else { 0x50 })
    wnPutLeb(out, st.supers.length)
    for s in st.supers { wnPutLeb(out, s) }
  }
  out.push(st.form)
  if st.form == 0x60 {
    wnPutLeb(out, st.params.length)
    for v in st.params {
      if !putValLong(out, v) { return false }
    }
    wnPutLeb(out, st.results.length)
    for v in st.results {
      if !putValLong(out, v) { return false }
    }
    return true
  }
  if st.form == 0x5e && t < flatNum.length && flatNum[t] >= 0 {
    if !putValLong(out, flatNum[t]) { return false }
    out.push(if st.mutable[0] { 1 } else { 0 })
    return true
  }
  const L = if st.form == 0x5f { layIx[t] } else { -1 }
  if L < 0 {
    if st.form == 0x5f { wnPutLeb(out, st.params.length) }
    let i = 0
    while i < st.params.length {
      if !putField(out, st.params[i], st.mutable[i]) { return false }
      i = i + 1
    }
    return true
  }
  const start = layStart[L]
  wnPutLeb(out, start[start.length - 1])
  let j = 0
  while j < st.params.length {
    const v = layRec[L][j]
    if v < 0 {
      if !putField(out, st.params[j], st.mutable[j]) { return false }
    } else {
      for x in M.types[v].params {
        if !putValLong(out, x) { return false }
        out.push(if st.mutable[j] { 1 } else { 0 })
      }
    }
    j = j + 1
  }
  true
}

function putField(out: u8[], v: i32, mutable: boolean): boolean {
  if v == 0x78 || v == 0x77 { out.push(v) }
  else if !putValLong(out, v) { return false }
  out.push(if mutable { 1 } else { 0 })
  true
}

// A packed value type in its long form: a reference as `0x63`/`0x64` and its heap. False for an
// exact or packed type, or a heap this does not write.
function putValLong(out: u8[], v: i32): boolean {
  const lead = v & 0xff
  if lead >= 0x7b && lead <= 0x7f {
    out.push(lead)
    return true
  }
  let nullable = 0x63
  let h = lead
  if lead == 0x63 || lead == 0x64 {
    nullable = lead
    h = v >> 8
  }
  if h >= 0x100 {
    if ((h - 0x100) & 1) != 0 { return false }
    out.push(nullable)
    putSleb(out, (h - 0x100) >> 1)
    return true
  }
  if (
    !(h == 0x70
      || h == 0x6f
      || h == 0x6e
      || h == 0x71
      || h == 0x72
      || h == 0x73
      || h == 0x6d
      || h == 0x6b
      || h == 0x6a
      || h == 0x6c
      || h == 0x69
      || h == 0x74)
  ) {
    return false
  }
  out.push(nullable)
  out.push(h)
  true
}

// The module with the type section `types` and the code section of `bodies`, every other
// section copied; fills `rwMoves`.
function assemble(
  types: u8[],
  bodies: u8[][],
  moves: i32[][],
  hdr: i32[],
): u8[] {
  const none: u8[] = []
  const out: u8[] = []
  copyBytes(out, B, 0, 8)
  rwMoves = []
  let sawT = false
  let sawC = false
  let s = 0
  while s < M.secId.length {
    const id = M.secId[s]
    if id == 1 {
      sawT = true
      out.push(1)
      wnPutLeb(out, types.length)
      putBytes(out, types)
    } else if id == 10 {
      sawC = true
      const sec: u8[] = []
      wnPutLeb(sec, bodies.length)
      const starts: i32[] = []
      for b in bodies {
        wnPutLeb(sec, b.length)
        starts.push(sec.length)
        putBytes(sec, b)
      }
      const head: u8[] = [10]
      wnPutLeb(head, sec.length)
      const base = out.length + head.length
      wnPutLeb(rwMoves, bodies.length)
      let bi = 0
      while bi < bodies.length {
        const at = base + starts[bi]
        const mv = moves[bi]
        wnPutLeb(rwMoves, hdr[bi])
        wnPutLeb(rwMoves, M.bodies[bi].to)
        wnPutLeb(rwMoves, mv.length / 2)
        let i = 0
        while i < mv.length {
          wnPutLeb(rwMoves, mv[i])
          wnPutLeb(rwMoves, at + mv[i + 1])
          i = i + 2
        }
        bi = bi + 1
      }
      putBytes(out, head)
      putBytes(out, sec)
    } else {
      copyBytes(out, B, M.secStart[s], M.secEnd[s] - M.secStart[s])
    }
    s = s + 1
  }
  if !sawT || !sawC {
    rwErr = "no type or code section"
    return none
  }
  out
}

function putSleb(out: u8[], v: i32) {
  let x = v
  let more = true
  while more {
    const byte = x & 0x7f
    x = x >> 7
    more = !(x == 0 && (byte & 0x40) == 0 || x == -1 && (byte & 0x40) != 0)
    out.push(if more { byte | 0x80 } else { byte })
  }
}

// ---- The list-flattening step ----

// Scans the staged module for the list-flattening step. Returns 0 when it cannot read the
// module (`optOut` says why), 1 when nothing holds a leaf record, 2 when no array does, 3 when
// the step may run. `valid` 0 says the module does not validate; `walk` 0 stops before the
// bodies, for a host that only asks whether the step applies, and leaves no step to run.
export function optInlineFlatScan(stable: i32, valid: i32, walk: i32): i32 {
  optOutSet([])
  flatScan = true
  flatWalked = false
  gate = flatScanRun(stable != 0, valid != 0, walk != 0)
  flatScan = false
  if gate == 0 {
    const w: u8[] = []
    putText(w, scanWhy)
    optOutSet(w)
  }
  gate
}

function flatScanRun(stable: boolean, valid: boolean, walk: boolean): i32 {
  bad = false
  scanWhy = "the module does not parse"
  if !readModule(optInBytes()) || bad { return 0 }
  findCandidates()
  if potKeys.length == 0 && !anyRecord() { return 1 }
  if !valid {
    scanWhy = "the module does not validate"
    return 0
  }
  if arrList.length == 0 { return 2 }
  if !walk { return 3 }
  curF = -1
  for a in constArr { flatBad(a, "it is made in a constant expression") }
  findCrossing(!stable)
  resetFound()
  fsK = []
  fsOff = []
  fsReach = []
  fsTy = []
  fsKind = []
  fsOLo = []
  fsOHi = []
  fsUse = []
  fsUA = []
  fsUB = []
  fsCast = []
  foNull = []
  foProd = []
  foCast = []
  fbLo = []
  fbHi = []
  fbCur = 0
  mvReady = false
  unfreed = []
  for _ in M.types { unfreed.push(false) }
  let bi = 0
  while bi < M.bodies.length && !bad {
    scanBody(bi)
    bi = bi + 1
  }
  if bad {
    scanWhy = "the module does not validate"
    return 0
  }
  if (
    M.bodies.length + nImports != funcType.length
    || fbLo.length != M.bodies.length
  ) {
    scanWhy = "the function and code sections disagree"
    return 0
  }
  closeErased(!stable)
  flatWalked = true
  3
}

// The step on the last scan: which candidate arrays are flattened and why each other one is
// not, then the module rewritten so. Returns 1 with the module in `optOut`, else 0. `rebox`
// and `spill` are as in `optInlineRewrite`; `fault` 4 ends each rewritten body's locals with
// an empty entry.
export function optInlineFlatStep(rebox: i32, spill: i32, fault: i32): i32 {
  optOutSet([])
  rwLog = []
  rwSum = []
  rwMoves = []
  flatNum = []
  if gate != 3 || !flatWalked { return 0 }
  flRebox = rebox != 0
  for _ in M.types { flatNum.push(-1) }
  flatTallies()
  let any = false
  for a in arrList {
    const v = arrRec[a]
    const why = flatRefusal(a, v, rebox != 0)
    if why.length > 0 {
      putText(rwLog, "inline-explain: array type ")
      putDec(rwLog, a)
      putText(rwLog, " (of type ")
      putDec(rwLog, v)
      putText(rwLog, "): not flattened: ")
      putBytes(rwLog, why)
      rwLog.push(10)
    } else {
      flatNum[a] = M.types[v].params[0]
      any = true
    }
  }
  if !any {
    putText(rwLog, "inline-explain: no array flattened\n")
    return 0
  }
  rwErr = ""
  const out = flatRewrite(spill != 0, fault == 4)
  if rwErr.length > 0 {
    putText(rwLog, "inline-explain: flattening abandoned: ")
    putText(rwLog, rwErr)
    rwLog.push(10)
    rwMoves = []
    return 0
  }
  for a in arrList {
    if flatNum[a] >= 0 {
      putText(rwSum, "inline-explain: array type ")
      putDec(rwSum, a)
      putText(rwSum, " (of type ")
      putDec(rwSum, arrRec[a])
      putText(rwSum, "): flattened; ")
      putDec(rwSum, tStores[a])
      putText(rwSum, " store(s) (")
      putDec(rwSum, stAtProd[a] ?? 0)
      putText(rwSum, " taken apart at the producer, ")
      putDec(rwSum, stSpilled[a] ?? 0)
      putText(rwSum, " spilled), ")
      putDec(rwSum, stFieldReads[a] ?? 0)
      putText(rwSum, " read(s) as fields, ")
      putDec(rwSum, stReboxed[a] ?? 0)
      putText(rwSum, " re-boxed (")
      putDec(rwSum, tLocal[a])
      putText(rwSum, " into a local whose box is taken apart, ")
      putDec(rwSum, tArg[a])
      putText(rwSum, " into a field parameter)\n")
    }
  }
  optOutSet(out)
  1
}

// The reads the last step counted free on the multi-value step's word: a count, then per held
// read its array type, body and local, then a count and per field argument its array type,
// callee and parameter (all ULEB128). Only flattened arrays' reads, and none under `rebox`.
export function optInlineFlatRelied(): i32 {
  const out: u8[] = []
  const held: i32[] = []
  const args: i32[] = []
  if !flRebox {
    let i = 0
    while i < fhA.length {
      if flatNum[fhA[i]] >= 0 { held.push(i) }
      i = i + 1
    }
    i = 0
    while i < faA.length {
      if flatNum[faA[i]] >= 0 { args.push(i) }
      i = i + 1
    }
  }
  wnPutLeb(out, held.length)
  for i in held {
    wnPutLeb(out, fhA[i])
    wnPutLeb(out, fhF[i] - nImports)
    wnPutLeb(out, fhL[i])
  }
  wnPutLeb(out, args.length)
  for i in args {
    wnPutLeb(out, faA[i])
    wnPutLeb(out, faG[i])
    wnPutLeb(out, faJ[i])
  }
  optOutSet(out)
  0
}

// Array type `a`'s reads into a local or a field parameter count whole from the next step on:
// the multi-value step does not take them apart.
export function optInlineFlatUnfree(a: i32): i32 {
  if a >= 0 && a < unfreed.length { unfreed[a] = true }
  0
}

// Per array type: its stores, its element reads by use, the first function a whole read is
// in, and why it is refused outright (empty when it is not).
let tStores: i32[] = []
let tField: i32[] = []
let tLocal: i32[] = []
let tArg: i32[] = []
let tWhole: i32[] = []
let tWholeIn: i32[] = []
let tRefused: u8[][] = []

function flatTallies() {
  tStores = []
  tField = []
  tLocal = []
  tArg = []
  tWhole = []
  tWholeIn = []
  tRefused = []
  for _ in M.types {
    tStores.push(0)
    tField.push(0)
    tLocal.push(0)
    tArg.push(0)
    tWhole.push(0)
    tWholeIn.push(-1)
    tRefused.push([])
  }
  fhA = []
  fhF = []
  fhL = []
  faA = []
  faG = []
  faJ = []
  const rA: i32[] = []
  const rG: i32[] = []
  const rJ: i32[] = []
  const rF: i32[] = []
  let bi = 0
  while bi < fbLo.length {
    const f = nImports + bi
    let s = fbLo[bi]
    while s < fbHi[bi] {
      const a = fsTy[s]
      const kind = fsKind[s]
      if kind == AK_SET || kind == AK_FIXED {
        let x = fsOLo[s]
        while x < fsOHi[s] {
          tStores[a] = tStores[a] + 1
          if fsReach[s] && foNull[x] && tRefused[a].length == 0 {
            const w: u8[] = []
            putText(w, "a value whose type admits null is stored into it (")
            putText(
              w,
              if kind == AK_SET { "array.set" } else { "array.new_fixed" },
            )
            putText(w, " at byte 0x")
            putHex(w, fsOff[s])
            putText(w, " in ")
            putName(w, f)
            putText(w, ")")
            tRefused[a] = w
          }
          x = x + 1
        }
        const m = fsOHi[s] - fsOLo[s]
        if (
          kind == AK_FIXED
          && m * recLen(arrRec[a]) > NEW_FIXED_MAX
          && tRefused[a].length == 0
        ) {
          const w: u8[] = []
          putText(w, "an array.new_fixed of ")
          putDec(w, m)
          putText(w, " elements would exceed 10000 operands (in ")
          putName(w, f)
          putText(w, ")")
          tRefused[a] = w
        }
      } else if kind == AK_GET {
        const u = fsUse[s]
        if u == AU_FIELD {
          tField[a] = tField[a] + 1
        } else if u == AU_LOCAL && !(fsUB[s] == 1 && unfreed[a]) {
          tLocal[a] = tLocal[a] + 1
          if fsUB[s] == 1 {
            fhA.push(a)
            fhF.push(f)
            fhL.push(fsUA[s])
          }
        } else if u == AU_ARG && !unfreed[a] {
          rA.push(a)
          rG.push(fsUA[s])
          rJ.push(fsUB[s])
          rF.push(f)
        } else {
          wholeRead(a, f)
        }
      }
      s = s + 1
    }
    bi = bi + 1
  }
  let i = 0
  while i < rA.length {
    const a = rA[i]
    if mvFoHas(rG[i], rJ[i]) {
      tArg[a] = tArg[a] + 1
      faA.push(a)
      faG.push(rG[i])
      faJ.push(rJ[i])
    } else {
      wholeRead(a, rF[i])
    }
    i = i + 1
  }
}

function wholeRead(a: i32, f: i32) {
  tWhole[a] = tWhole[a] + 1
  if tWholeIn[a] < 0 { tWholeIn[a] = f }
}

// Why candidate array type `a` of record type `v` stays boxed, or empty.
function flatRefusal(a: i32, v: i32, rebox: boolean): u8[] {
  const out: u8[] = []
  const n = recLen(v)
  const rec = recordRefusal(v)
  if rec.length > 0 {
    putText(out, "its element type ")
    putDec(out, v)
    putText(out, " is refused: ")
    putBytes(out, rec)
    return out
  }
  if superOf[a] >= 0 || hasSub[a] {
    putText(out, "it is in a subtyping relation")
    return out
  }
  if groupOf(a) != groupOf(v) {
    putText(out, "it is not in the rec group of its element type ")
    putDec(out, v)
    return out
  }
  const cross = crossing(a)
  if cross.length > 0 {
    putText(out, "it can cross the module boundary (")
    putBytes(out, cross)
    putText(out, ")")
    return out
  }
  if arrBadF[a] != -2 {
    putBytes(out, arrBadW[a])
    if arrBadF[a] >= 0 {
      putText(out, " (in ")
      putName(out, arrBadF[a])
      putText(out, ")")
    }
    return out
  }
  if tRefused[a].length > 0 { return tRefused[a] }
  const reads = tField[a] + tLocal[a] + tArg[a] + tWhole[a]
  if tWhole[a] > 0 && !rebox {
    putDec(out, tWhole[a])
    putText(out, " of its ")
    putDec(out, reads)
    putText(out, " element read(s) take the whole element (first in ")
    putName(out, max(tWholeIn[a], 0))
    putText(
      out,
      "), and each would allocate a copy where today it shares the box",
    )
    if unfreed[a] {
      putText(
        out,
        " (the multi-value step would not take its held reads apart)",
      )
    }
    return out
  }
  const boxed = tLocal[a] + tArg[a]
  if tField[a] + n * boxed > FLAT_READS_PER_STORE * n * tStores[a] && !rebox {
    putText(out, "its reads (")
    putDec(out, tField[a])
    putText(out, " of a field, ")
    putDec(out, boxed)
    putText(
      out,
      " of a whole element) are more than 6 whole elements' worth per store (",
    )
    putDec(out, tStores[a])
    putText(
      out,
      " store(s)), and a flat read costs one bounds-checked array.get per field",
    )
  }
  out
}

// The index of the rec group type `t` is in.
function groupOf(t: i32): i32 {
  let at = 0
  let g = 0
  while g < M.groupSize.length {
    at = at + M.groupSize[g]
    if t < at { return g }
    g = g + 1
  }
  g
}

// The module with every flattened array's elements' fields side by side and every body naming
// one rewritten, `rwMoves` filled; sets `rwErr` when it cannot.
function flatRewrite(spill: boolean, fault: boolean): u8[] {
  const none: u8[] = []
  stAtProd = Map()
  stSpilled = Map()
  stFieldReads = Map()
  stReboxed = Map()
  layIx = []
  layStart = []
  layRec = []
  for _ in M.types { layIx.push(-1) }
  const hdr = bodyStarts()
  if rwErr.length > 0 { return none }
  const bodies: u8[][] = []
  const moves: i32[][] = []
  let bi = 0
  while bi < M.bodies.length {
    const sites: i32[] = []
    let s = fbLo[bi]
    while s < fbHi[bi] {
      if flatNum[fsTy[s]] >= 0 { sites.push(s) }
      s = s + 1
    }
    if sites.length == 0 {
      const b: u8[] = []
      copyBytes(b, B, hdr[bi], M.bodies[bi].to - hdr[bi])
      bodies.push(b)
      moves.push([hdr[bi], 0])
    } else {
      const mv: i32[] = []
      const b = flatBody(bi, hdr[bi], sites, spill, fault, mv)
      if rwErr.length > 0 { return none }
      bodies.push(b)
      moves.push(mv)
    }
    bi = bi + 1
  }
  const types = typeSection()
  if rwErr.length > 0 { return none }
  assemble(types, bodies, moves, hdr)
}

// Plans each store site's value local in `hTv`, and in `hAt` where it is set: 0 right after
// its producer (so a producer call is left `call; local.set` for the multi-value step), 1 at the
// store, 2 at the store behind a cast.
function flatPlanStores(
  sites: i32[],
  spill: boolean,
  hTv: {[i32]: i32},
  hAt: {[i32]: i32},
) {
  for s in sites {
    if fsKind[s] == AK_SET {
      const a = fsTy[s]
      const tv = newLocal(refT(false, arrRec[a]))
      const o = fsOLo[s]
      const q = foProd[o]
      if fsReach[s] && q != NONE && !spill && !rwAft.has(q) {
        const c: u8[] = []
        castIf(c, foCast[o])
        localOp(c, 0x21, tv)
        rwAft[q] = keep(c)
        bump(stAtProd, a)
        hAt[fsK[s]] = 0
      } else {
        bump(stSpilled, a)
        hAt[fsK[s]] = if foCast[o] { 2 } else { 1 }
      }
      hTv[fsK[s]] = tv
    }
  }
}

// The code of get site `s` at op `k` over array type `a` of record `v` with `n` fields: one
// field read when the use is a field, else a reboxed record. Records in `consume` how many ops
// the rewrite replaces when it is more than one.
function flatGetCode(
  code: u8[],
  s: i32,
  k: i32,
  a: i32,
  v: i32,
  n: i32,
  ti: i32,
  consume: {[i32]: i32},
) {
  let field = fsUse[s] == AU_FIELD && !rwAft.has(k)
  let q = k + 1
  while field && q <= fsUA[s] {
    if rwAft.has(q) { field = false }
    q = q + 1
  }
  if field {
    scale(code, n, ti)
    plus(code, fsUB[s])
    gcOp(code, 11, a, -1)
    consume[k] = fsUA[s] - k + 1
    bump(stFieldReads, a)
  } else {
    const tb = newLocal(0x7f)
    const tarr = newLocal(refT(true, a))
    scale(code, n, ti)
    localOp(code, 0x21, tb)
    localOp(code, 0x21, tarr)
    let j = 0
    while j < n {
      localOp(code, 0x20, tarr)
      localOp(code, 0x20, tb)
      plus(code, j)
      gcOp(code, 11, a, -1)
      j = j + 1
    }
    gcOp(code, 0, v, -1)
    bump(stReboxed, a)
    // The box is non-null already; a cast after it would hide the allocation from the
    // multi-value step.
    if fsCast[s] && !rwAft.has(k) && !rwAft.has(k + 1) { consume[k] = 2 }
  }
}

// The code of fixed-array site `s` over array type `a` of record `v` with `n` fields: its
// elements held in locals, then their fields side by side in one `array.new_fixed`. Nothing
// for an empty literal.
function flatFixedCode(code: u8[], s: i32, a: i32, v: i32, n: i32) {
  const m = fsOHi[s] - fsOLo[s]
  if m > 0 {
    const tvs: i32[] = []
    let i = 0
    while i < m {
      tvs.push(newLocal(refT(false, v)))
      i = i + 1
    }
    i = m - 1
    while i >= 0 {
      castIf(code, foCast[fsOLo[s] + i])
      localOp(code, 0x21, tvs[i])
      i = i - 1
    }
    for tv in tvs {
      let j = 0
      while j < n {
        localOp(code, 0x20, tv)
        gcOp(code, 2, v, j)
        j = j + 1
      }
    }
    code.push(0xfb)
    wnPutLeb(code, 8)
    wnPutLeb(code, a)
    wnPutLeb(code, m * n)
    stSpilled[a] = (stSpilled[a] ?? 0) + m
  }
}

// The code of an `array.copy` over array type `a` with `n` fields: both offsets and the length
// scaled by `n`.
function flatCopyCode(code: u8[], a: i32, n: i32, ti: i32) {
  const tl = newLocal(0x7f)
  const ts = newLocal(0x7f)
  const td = newLocal(0x7f)
  const tsrc = newLocal(refT(true, a))
  localOp(code, 0x21, tl)
  localOp(code, 0x21, ts)
  localOp(code, 0x21, tsrc)
  localOp(code, 0x21, td)
  localOp(code, 0x20, td)
  scale(code, n, ti)
  localOp(code, 0x20, tsrc)
  localOp(code, 0x20, ts)
  scale(code, n, ti)
  localOp(code, 0x20, tl)
  scale(code, n, ti)
  code.push(0xfb)
  wnPutLeb(code, 17)
  wnPutLeb(code, a)
  wnPutLeb(code, a)
}

// Body `bi`'s decoded ops with each rewrite in place of the ops it consumes and each after-code
// behind its op, finished with the header at `h0`; `mv` gets its moves.
function flatSpliceOps(
  bi: i32,
  h0: i32,
  consume: {[i32]: i32},
  fault: boolean,
  mv: i32[],
): u8[] {
  const out: u8[] = []
  const moved: i32[] = []
  const nOps = opOff.length
  let i = 0
  while i < nOps {
    moved.push(opOff[i])
    moved.push(out.length)
    const rep = rwRep[i] ?? -1
    if rep >= 0 {
      putBytes(out, rwCodes[rep])
    } else {
      copyBytes(out, B, opOff[i], opEnd[i] - opOff[i])
    }
    const consumed = consume[i] ?? 1
    const aft = rwAft[i] ?? -1
    if aft >= 0 { putBytes(out, rwCodes[aft]) }
    let q = 1
    while q < consumed && i + q < nOps {
      moved.push(opOff[i + q])
      moved.push(out.length)
      q = q + 1
    }
    i = i + consumed
  }
  finishBody(bi, h0, out, moved, fault, mv)
}

// Body `bi`, whose header starts at `h0`, with each of its flattened arrays' `sites` rewritten
// to index the fields side by side; `mv` gets its moves.
function flatBody(
  bi: i32,
  h0: i32,
  sites: i32[],
  spill: boolean,
  fault: boolean,
  mv: i32[],
): u8[] {
  const none: u8[] = []
  rwExtra = []
  rwNext = rbLocals[bi]
  rwRep = Map()
  rwAft = Map()
  rwCodes = []
  const ti = newLocal(0x7f)
  // Each store's value is held in a local, set right after its producer when that is known
  // (so a producer call is left `call; local.set` for the multi-value step), else at the store.
  const hTv: {[i32]: i32} = Map()
  const hAt: {[i32]: i32} = Map()
  flatPlanStores(sites, spill, hTv, hAt)
  const consume: {[i32]: i32} = Map()
  for s in sites {
    const k = fsK[s]
    const a = fsTy[s]
    const v = arrRec[a]
    const n = recLen(v)
    const kind = fsKind[s]
    const code: u8[] = []
    if kind == AK_GET {
      flatGetCode(code, s, k, a, v, n, ti, consume)
    } else if kind == AK_SET {
      const tb = newLocal(0x7f)
      const tarr = newLocal(refT(true, a))
      if !hTv.has(k) {
        rwErr = "a store was not planned"
        return none
      }
      const tv = hTv[k] ?? 0
      const at = hAt[k] ?? 0
      if at > 0 {
        castIf(code, at == 2)
        localOp(code, 0x21, tv)
      }
      scale(code, n, ti)
      localOp(code, 0x21, tb)
      localOp(code, 0x21, tarr)
      let j = 0
      while j < n {
        localOp(code, 0x20, tarr)
        localOp(code, 0x20, tb)
        plus(code, j)
        localOp(code, 0x20, tv)
        gcOp(code, 2, v, j)
        gcOp(code, 14, a, -1)
        j = j + 1
      }
    } else if kind == AK_NEWDEF {
      scale(code, n, ti)
      gcOp(code, 7, a, -1)
    } else if kind == AK_FIXED {
      flatFixedCode(code, s, a, v, n)
    } else if kind == AK_LEN {
      code.push(0xfb)
      wnPutLeb(code, 15)
      if n > 1 {
        i32Const(code, n)
        code.push(0x6e)
      }
    } else if kind == AK_COPY {
      flatCopyCode(code, a, n, ti)
    } else {
      rwErr = "a site of an unknown kind"
      return none
    }
    if kind != AK_FIXED || fsOHi[s] > fsOLo[s] {
      if rwRep.has(k) {
        rwErr = "two rewrites claim one op"
        return none
      }
      rwRep[k] = keep(code)
    }
  }
  if !decodeOps(bi) { return none }
  flatSpliceOps(bi, h0, consume, fault, mv)
}

// `x` on the stack becomes `x * n`, or `-n` when that would wrap: every index it gives, plus
// a field offset below `n`, is then out of bounds exactly when `x` is.
function scale(code: u8[], n: i32, ti: i32) {
  if n == 1 { return }
  localOp(code, 0x22, ti)
  i32Const(code, n)
  code.push(0x6c)
  i32Const(code, 0 - n)
  localOp(code, 0x20, ti)
  i32Const(code, wrapLimit(n))
  code.push(0x49)
  code.push(0x1b)
}

// The least unsigned `x` whose `x * n` wraps, as an i32: `(2^32 - n) / n + 1`, for `n >= 2`.
function wrapLimit(n: i32): i32 {
  const q = 0x7fffffff / n
  const r = 0x7fffffff % n
  2 * q + (2 * r + 2) / n
}

function plus(code: u8[], j: i32) {
  if j > 0 {
    i32Const(code, j)
    code.push(0x6a)
  }
}

function i32Const(code: u8[], v: i32) {
  code.push(0x41)
  putSleb(code, v)
}

// ---- Text ----

function putName(out: u8[], f: i32) {
  const r = if f >= 0 && f < nameTab.length { nameTab[f] } else { -1 }
  if r < 0 {
    putText(out, "func ")
    putDec(out, f)
    return
  }
  let i = 0
  while i < nameW.len[r] {
    const x: i32 = B[nameW.at[r] + i]
    if x == 10 { bad = true }
    out.push(x)
    i = i + 1
  }
}

function putBytes(out: u8[], s: u8[]) {
  for x in s { out.push(x) }
}

function putDec(out: u8[], v: i32) {
  if v >= 10 { putDec(out, v / 10) }
  out.push(48 + v % 10)
}

function putHex(out: u8[], v: i32) {
  if v >= 16 { putHex(out, v / 16) }
  const d = v % 16
  out.push(if d < 10 { 48 + d } else { 87 + d })
}
