// True if a read of the module global `name` leaves a nullable list ref on the stack. The
// ident-to-global read deliberately withholds the eager `ref.as_non_null` for exactly these
// kinds, since the `!= null` compare has to see the raw cell, so a consumer staging the
// receiver into a non-null frame slot must recover it itself.
export function globalNulListCellRead(fnIx: i32, name: string) {
  const li = globalLetOfIn(fnIx, name, -1)
  if li < 0 { return false }
  const k = globalCellKind(li)
  if k == "nullist" { return true }
  if k == "nulreflist" { return true }
  isNulScalarListKind(k)
}

// The wide primitive (`i64`, `f64` or `f32`) the right side of assignment `asgIx` is built at
// when its delivery re-types a radix literal to the target's width while the checker typed the
// value at the literal's 32-bit reading; "" otherwise. A use of that width reads the stored
// cell, any other the 32-bit pattern, as the literal itself would be read there (D3733).
export function asgRadixWidePrim(asgIx: i32, fnIx: i32): string {
  if asgIx < 0 || asgIx >= P.nodes.length { return "" }
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return "" }
  if a.binOp != "=" { return "" }
  if tyPrimNameOf(nodeTyIxOf(asgIx)) != "i32" { return "" }
  if asgReadUnwidenOp(asgIx, fnIx) < 0 { return "" }
  // A chained `a = b = 0xff` hands on the inner assignment's own width.
  const rhs = unwrapParen(a.binRight)
  let rn: string = tyPrimNameOf(nodeTyIxOf(rhs)) ?? ""
  const rw = asgRadixWidePrim(rhs, fnIx)
  if rw != "" { rn = rw }
  if rn != "i64" && rn != "f64" && rn != "f32" { return "" }
  let st = asgStoreTyOf(asgIx)
  if st < 0 || st >= T.tys.length { return "" }
  const stT = tyAt(st)
  if stT is TyNullable { st = stT.nInner }
  const sn: string = tyPrimNameOf(st) ?? ""
  if sn != rn { return "" }
  rn
}

// Push the narrowing `asgReReadTy` names for the re-read of
// assignment `asgIx`'s target.
// Returns the depth to restore to, or -1 when it pushes nothing.
export function pushAsgReadNarrow(asgIx: i32, fnIx: i32): i32 {
  const ty = asgReReadTy(asgIx, fnIx)
  if ty < 0 { return -1 }
  if asgIx < 0 { return -1 }
  const a = nodeAt(asgIx)
  if a is BinExpr {
    const t = unwrapParen(a.binLeft)
    if t < 0 { return -1 }
    const tn = nodeAt(t)
    if tn is Ident {
      const saved = narrowTop
      const unTy = identUnionTyAt(sidOfNode(t), fnIx, t)
      if pushNarrowWriteReNarrow(tn.identName, ty, unTy) { return saved }
    }
  }
  -1
}

// The function a callee read of `sid` at node `atIx` in frame `fnIx` names: the innermost frame
// on the chain first, as the flat map (first wins) cannot. A block-local function answers only
// where its scope covers the read (D3608, D3614); an unplaced read takes the name-only answer.
export function fnIndexOfInScopeChainAt(
  sid: i32,
  name: string,
  fnIx: i32,
  atIx: i32,
): i32 {
  if sidArrGet(nestedNameBySid, sid) == 1 {
    const hit = lfResolveAt(sid, name, fnIx, atIx)
    if hit >= 0 { return hit }
    if hit == -1 { return lfFlatAt(sid) }
    if fnIx >= 0 {
      const chain = nestedFnOnChain(name, fnIx)
      if chain >= 0 { return chain }
    }
  }
  fnIndexOfSid(sid, atIx)
}

// Bank the declaration-site narrowing of every frame nested in frame `fe`, by scanning its body
// with the narrowing stack live; a body with no nested function is not walked. Called twice:
// a param's union-ness resolves from the arena, a function-scope local's only from the
// emit-time table `buildLocals` fills, so `emitFuncCode` re-banks after it, appending.
export function capNarrowRecordFrame(fe: i32) {
  const savedTop = narrowTop
  cnRecording = true
  cnWalkFrame(fe)
  cnRecording = false
  cnScanFnIx = -1
  restoreNarrow(savedTop)
  0
}

// Rebuild the declaration-site narrowing table from the current arena. Runs before each
// `computeRetInference` (the classifier needs it to type a closure whose return is a
// narrowed captured read) and again after monomorphization, which renumbers `fnStmts`
// and therefore every recorded frame position.
export function capNarrowBuild() {
  cnFe = []
  cnRowsOf = Map()
  cnRowsSeen = 0
  cnName = []
  cnVariant = []
  cnTy = []
  cnSet = []
  cnGlobReads = Map()
  cnGlobOn = false
  callResultTextsDepth = 0
  const savedTop = narrowTop
  cnRecording = true
  cnTopFe = Map()
  cnTopFes = []
  cnTopNext = []
  let tk = 0
  while tk < topFnNodes.length {
    cnTopFe[topFnNodes[tk]] = -1
    tk = tk + 1
  }
  // An appended generic instance's origin slot, so each instance is recorded where its
  // template is written.
  const instOrig: {[i32]: i32} = Map()
  let q = 0
  while q < monoInstFe.length && q < monoInstOrig.length {
    instOrig[monoInstFe[q]] = monoInstOrig[q]
    q = q + 1
  }
  let fe = 0
  while fe < fnStmts.length {
    if fe >= fnParent.length || fnParent[fe] < 0 {
      const origin = cnFrameOrigin(fe, instOrig)
      if cnTopFe.has(origin) {
        cnTopNext.push(cnTopFe[origin] ?? -1)
        cnTopFe[origin] = cnTopFes.length
        cnTopFes.push(fe)
      } else {
        cnWalkFrame(fe)
      }
    }
    fe = fe + 1
  }
  // Module-level statements are the start function's body. A closure written there has no
  // enclosing frame to capture from, but a top-level statement still narrows a module global,
  // and the frames declared under it, a top-level function included, are frames like any
  // other: each is recorded at its own position among the statements (D2555).
  cnScanFnIx = -1
  const sbound: {[string]: i32} = Map()
  const scaps: string[] = []
  const smark = capTrailName.length
  tk = 0
  let si = 0
  let gi = 0
  while si < startStmts.length || gi < globalStmts.length {
    let sOrd = 2147483647
    if si < startStmts.length && si < startStmtOrd.length {
      sOrd = startStmtOrd[si]
    }
    let gOrd = 2147483647
    if gi < globalStmts.length && gi < globalStmtOrd.length {
      gOrd = globalStmtOrd[gi]
    }
    if gOrd < sOrd {
      // A global's initializer runs in the same order; its closures are frames written here.
      tk = cnRecordTopFns(tk, gOrd, savedTop)
      // With no module narrowing live there is nothing a closure in it could record.
      const gd = nodeAt(globalStmts[gi])
      if gd is LetDecl && narrowTop > savedTop {
        capScan(gd.letInit, sbound, scaps)
      }
      gi = gi + 1
    } else if si < startStmts.length {
      tk = cnRecordTopFns(tk, sOrd, savedTop)
      preStmtNarrow(startStmts[si])
      capScan(startStmts[si], sbound, scaps)
      cnPostGuard(startStmts[si])
      si = si + 1
    } else {
      gi = gi + 1
    }
  }
  cnRecordTopFns(tk, 2147483647, savedTop)
  capTrim(sbound, smark)
  cnRecording = false
  cnScanFnIx = -1
  restoreNarrow(savedTop)
  0
}

// Each top-level function's `fnStmts` positions, its own and its instances': the head of a
// list through `cnTopFes`/`cnTopNext`, or -1.
let cnTopFe: {[i32]: i32} = Map()
let cnTopFes: i32[] = []
let cnTopNext: i32[] = []

// Record every top-level function from the `k`th on whose position precedes `ord`, under the
// narrowing the module statements before it leave above depth `base`; returns the next one.
function cnRecordTopFns(k: i32, ord: i32, base: i32): i32 {
  let i = k
  while i < topFnNodes.length && i < topFnOrd.length && topFnOrd[i] < ord {
    let j = cnTopFe[topFnNodes[i]] ?? -1
    while j >= 0 && j < cnTopFes.length {
      cnRecordTopFrame(cnTopFes[j], narrowTop > base, topFnNodes[i])
      j = cnTopNext[j]
    }
    i = i + 1
  }
  i
}

// Record top-level frame `fe`, written as `origin`, under the live module narrowing when
// `narrowed`, else only the frames it declares. An instance answers what its template's check
// widened, which is the body the checker saw at this position.
function cnRecordTopFrame(fe: i32, narrowed: boolean, origin: i32) {
  if fe < 0 || fe >= fnStmts.length { return 0 }
  if fnStmts[fe] != origin && !capWidenDecided(fnStmts[fe]) {
    recordClonedCallRetire(origin, fnStmts[fe])
  }
  if !narrowed {
    cnWalkFrame(fe)
    cnScanFnIx = -1
    return 0
  }
  const savedGlob = cnGlobReads
  const savedGlobOn = cnGlobOn
  cnGlobReads = Map()
  cnGlobOn = true
  capComputeNamesOf(fe)
  const noFree: string[] = []
  capNarrowRecord(fnStmts[fe], noFree, cnGlobReads)
  cnGlobReads = savedGlob
  cnGlobOn = savedGlobOn
  cnScanFnIx = -1
  0
}

// Replay frame `fe`'s declaration-site narrowing onto the narrowing stack, so a walk over
// `fe`'s body answers every rep question about a narrowed read under the narrowing the closure
// is written inside. Returns the depth to restore to.
export function capNarrowSeed(fe: i32) {
  const saved = narrowTop
  if fe < 0 { return saved }
  if cnFe.length == 0 { return saved }
  const caps = captureNamesOf(fe)
  while cnRowsSeen < cnFe.length {
    const f = cnFe[cnRowsSeen]
    const got = cnRowsOf[f]
    if got == null { cnRowsOf[f] = [cnRowsSeen] } else { got.push(cnRowsSeen) }
    cnRowsSeen = cnRowsSeen + 1
  }
  for i in cnRowsOf[fe] ?? cnNoRows {
    if capNarrowReplays(fe, cnName[i], caps) {
      pushNarrowRep(cnName[i], cnVariant[i], cnTy[i], cnSet[i])
    }
  }
  saved
}

// The rows of `cnFe` each frame banked, in bank order, over its first `cnRowsSeen` rows: a
// replay reads its own frame's rows rather than every frame's (D5950).
let cnRowsOf: {[i32]: i32[]} = Map()
let cnRowsSeen = 0
const cnNoRows: i32[] = []

// Whether frame `fe`'s banked narrowing of `key` binds its body's reads. A captured name only
// when its env field holds the value-union box, the one capture rep a narrowing unboxes; a place
// under a capture, or a module global and any place under one, read the same storage the
// declaration site reads, so its narrowing carries over whole (D2448, D2450).
function capNarrowReplays(fe: i32, key: string, caps: string[]): boolean {
  const root = narrowKeyRoot(key)
  if strListHas(caps, root) {
    if root == key { return captureValKind(fe, key) == "union" }
    return true
  }
  globalIndexOf(root) >= 0
}

// ── scalar-list descriptor (the i32, f64 and i64 list unification) ─────────────
// A scalar-element list is one shape parameterized by its element's valtype: a growable
// `{ backing, len, cap }` wrapper over a raw `(array (mut <elem>))`. The descriptors map a
// canonical element kind to its list types, so a list op is written once over the kind.

// The canonical scalar element kind of a list-valued expression, or null for a ref, string or
// map list and for anything that is not a list. The single dispatch the scalar list ops
// consult instead of each re-deriving `exprF64Array`.
export function scalarListElemKind(exprIx: i32, fnIx: i32): VKind | null {
  // The packed byte list first: what this returns is the discriminator the scalar-list ops
  // select a rep with, and `u8[]` is the one list whose element value kind does not identify
  // its rep — its backing is `(array (mut i8))` where every other i32-element list is
  // `(array (mut i32))`. It must precede `exprArray`, which claims any i32-element list.
  if exprU8Array(exprIx, fnIx) { return "u8list" }
  if exprF32Array(exprIx, fnIx) { return "f32" }
  if exprF64Array(exprIx, fnIx) { return "f64" }
  if exprI64Array(exprIx, fnIx) { return "i64" }
  if exprArray(exprIx, fnIx) { return "i32" }
  return null
}

// True when something NAMED the `__array_new__` at `callIx` its element kind, rather than the
// classifier above falling through to its i32 default. The emitter's own i32-list arm refuses
// on `false` — the list it would build is then a guess about the fill's rep.
export function arrNewKindNamed(callIx: i32, fnIx: i32) {
  arrNewNamedKind(callIx, fnIx) != "none"
}

// `identNameIsUserBound` asked at the emit cursor: a local counts only once its declaration
// has been emitted, so a call above a later `const floor` still names the builtin, as the
// checker reads it (D3599).
export function identNameIsLiveBound(name: string, fnIx: i32): boolean {
  if scopeSlotOf(name) >= 0 || paramIndexOf(fnIx, name) >= 0 { return true }
  capturedKindOf(fnIx, name) != null
}

// Every value atom the box at this read can hold, appended to `out` deduped, or false.
// Unlike `memReadBoxedAtomKind`'s single answer, a `??`-merged row boxes each family
// member at its own atom, so the read has to dispatch over the whole set. False — keeping
// today's single cast — when a member isn't a scalar atom; `null` is skipped, not refused (D927).
export function memReadBoxedAtomKinds(
  memIx: i32,
  fnIx: i32,
  out: i32[],
): boolean {
  const un0 = memberUnionFieldNameRead(memIx, fnIx)
  if un0 == "" { return false }
  if memNarrowAtomKind(memIx, fnIx) >= 0 { return false }
  const atoms: string[] = []
  unionSetAtomsOf(un0, atoms)
  let i = 0
  while i < atoms.length {
    const k = valueAtomKind(atoms[i])
    if k < 0 { return false }
    if k != 6 {
      let seen = false
      let j = 0
      while j < out.length {
        if out[j] == k { seen = true }
        j = j + 1
      }
      if !seen { out.push(k) }
    }
    i = i + 1
  }
  out.length > 0
}

// Is `exprIx` an f64/f32 value integral by construction: a call of the `trunc` / `floor` /
// `ceil` / `nearest` intrinsic, or a `const` initialised by one? A cast of it to an integer
// then owes only the range test. A binding, global or function of the callee's name
// declines, since the call then lowers to that and not to the intrinsic.
export function exprIsIntegralFloat(exprIx: i32, fnIx: i32): boolean {
  if exprIx < 0 { return false }
  const e = nodeAt(unwrapParen(exprIx))
  if e is Ident {
    const di = bindingDeclInScope(unwrapParen(exprIx))
    if di < 0 { return false }
    const d = nodeAt(di)
    if d is LetDecl {
      if d.letKw == "const" { return callIsIntegralFloatIntr(d.letInit, fnIx) }
    }
    return false
  }
  callIsIntegralFloatIntr(exprIx, fnIx)
}

// The call half of `exprIsIntegralFloat`. A `const` is followed one step only: a name in its
// initialiser would resolve here at the cast's scope, which can differ from the declaration's.
function callIsIntegralFloatIntr(exprIx: i32, fnIx: i32): boolean {
  if exprIx < 0 { return false }
  const e = nodeAt(unwrapParen(exprIx))
  if !(e is Call) { return false }
  if e.callArgs.length != 1 { return false }
  if e.callFn < 0 { return false }
  const callee = nodeAt(e.callFn)
  if !(callee is Ident) { return false }
  const nm = callee.identName
  if !(nm == "trunc" || nm == "floor" || nm == "ceil" || nm == "nearest") {
    return false
  }
  if fnIndexOfInScopeChainAt(sidOfNode(e.callFn), nm, fnIx, e.callFn) >= 0 {
    return false
  }
  if globalIndexOf(nm) >= 0 { return false }
  if identNameIsBoundAt(nm, fnIx, e.callFn) { return false }
  !identNameIsLiveBound(nm, fnIx)
}

// Whether `ix` is a list of string-literal-union atoms: typed `K[]` or `(K | null)[]`, or a
// literal whose first element is an atom. Its i32 elements are ids, never numbers to widen.
export function exprIsAtomList(ix: i32, fnIx: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  let e = tyArrayElemIx(nodeTyAt(ix, fnIx))
  if e >= 0 {
    const et = tyAt(e)
    if et is TyNullable { e = et.nInner }
    if tyIsLitUnion(e) { return true }
  }
  const n = nodeAt(ix)
  if n is ArrayLit {
    if n.arrElems.length > 0 { return exprIsLitAtom(n.arrElems[0], fnIx) }
  }
  // Any other node typed as no atom list is not one.
  false
}

// The number instance `fnIx` pins the operand of `asExprHoleNumSad` cast `ix` at, when the
// cast can fail there; "-" when the pin is no number, which is never the target; "" when the
// plain conversion is exact (a `boolean` pin included) or the instance has no exact pin.
export function asExprHolePinSrc(ix: i32, fnIx: i32): string {
  if !asExprHoleNumSad(ix) { return "" }
  const n = nodeAt(ix)
  if n is AsExpr {
    const hx = instanceOperandTyOf(n.asObj, fnIx)
    if hx < 0 { return "" }
    const hs = primNameStr(primNameOf(hx))
    if hs == "boolean" { return "" }
    if hs != "i32" && hs != "i64" && hs != "f32" && hs != "f64" { return "-" }
    if numCastCanFail(hs, asExprNumCastDomain(ix)) { return hs }
  }
  ""
}

// Whether the non-literal record arm `tv` of a join built at struct row `slot` is built at a row
// storing a field in another rep: a bare value where `slot` has a union box, or another scalar.
export function refIfArmNeedsRecordCopy(
  tv: i32,
  slot: i32,
  fnIx: i32,
): boolean {
  if !recordJoinSeen() { return false }
  const vn = nodeAt(unwrapParen(tv))
  if vn is ObjLit || vn is NullLit { return false }
  if slot < 0 || slot >= sTyIx.length { return false }
  // The row the arm's value is built at, which an un-annotated source may share with the join.
  // A nullable record value answers no row syntactically; its checked type names one.
  const ar = rjaRowOf(tv, fnIx)
  if ar < 0 || ar == slot || ar >= sTyIx.length { return false }
  recordRepDiffers(sTyIx[ar], sTyIx[slot], 0)
}

// Refuses, at the value, every record a join of records would have to convert: an `if` or
// `match` tail, a list literal's element, and a function's returned value, each against the
// row of the join or of the declared return. Literal leaves are built at that row (D2765).
export function auditRecordJoinLeaves() {
  if !recordJoinSeen() || emitRootIx < 0 { return 0 }
  const root = nodeAt(emitRootIx)
  if root is Program {
    let s = 0
    while s < root.progStmts.length {
      if rjaWalk(root.progStmts[s], -1) < 0 { return -1 }
      s = s + 1
    }
  }
  let fe = 0
  while fe < fnStmts.length {
    const fnIx = fnStmts[fe]
    const fn = nodeAt(fnIx)
    if fn is FuncDecl {
      if fn.fnRet >= 0 {
        const rrow = joinRowOfTy(recordBaseTy(nodeTyIxOf(fn.fnRet)))
        if rrow >= 0 {
          const rets: i32[] = []
          collectRetValues(fn.fnBody, rets)
          if rjaLeaves(rets, rrow, fnIx) < 0 { return -1 }
        }
      }
      if rjaWalk(fn.fnBody, fnIx) < 0 { return -1 }
    }
    fe = fe + 1
  }
  0
}

// Every tail of each value in `vals` against the row `row`: -1 once one is refused.
function rjaLeaves(vals: i32[], row: i32, fnIx: i32): i32 {
  let i = 0
  while i < vals.length {
    const ls = valueTailLeaves(vals[i])
    let k = 0
    while k < ls.length {
      if refIfArmNeedsRecordCopy(ls[k], row, fnIx) {
        return emitFailAt(RECORD_COPY_MSG, ls[k])
      }
      if rjaLitFields(ls[k], row, fnIx, 0) < 0 { return -1 }
      k = k + 1
    }
    i = i + 1
  }
  0
}

// A literal leaf built at `row`: each field holding a record, against that field's row, so a
// record value nested in the literal meets the same test as one at the top (D2765).
function rjaLitFields(ix: i32, row: i32, fnIx: i32, depth: i32): i32 {
  const o = nodeAt(unwrapParen(ix))
  if depth > 8 || row < 0 || row >= sTyIx.length { return 0 }
  const rb = recordBaseTy(sTyIx[row])
  if rb < 0 { return 0 }
  const rt = tyAt(rb)
  if o is ObjLit {
    if rt is TyObj {
      let i = 0
      while i < o.objFields.length {
        const f = nodeAt(o.objFields[i])
        if f is FieldInit {
          const fr = joinRowOfTy(recordBaseTy(recordFieldTy(rt, f.fiName)))
          if fr >= 0 {
            const one: i32[] = [f.fiValue]
            if rjaLeaves(one, fr, fnIx) < 0 { return -1 }
          }
        }
        i = i + 1
      }
    }
  }
  0
}

// Whether two record values, neither a literal, are stored as different records.
function rjaValuesPart(a: i32, b: i32, fnIx: i32): boolean {
  const na = nodeAt(unwrapParen(a))
  const nb = nodeAt(unwrapParen(b))
  if na is ObjLit || nb is ObjLit || na is NullLit || nb is NullLit {
    return false
  }
  const ra = rjaRowOf(a, fnIx)
  const rb = rjaRowOf(b, fnIx)
  if ra < 0 || rb < 0 || ra == rb || ra >= sTyIx.length || rb >= sTyIx.length {
    return false
  }
  recordRepDiffers(sTyIx[ra], sTyIx[rb], 0)
}

// The struct row a record value is built at: its own, else its checked type's, else -1.
function rjaRowOf(ix: i32, fnIx: i32): i32 {
  const r = structIndexOfExpr(ix, fnIx)
  if r >= 0 { return r }
  structIndexOfTy(recordBaseTy(nodeTyIxOf(ix)))
}

// The joins of records under `ix` in frame `fnIx`, a nested function's aside.
function rjaWalk(ix: i32, fnIx: i32): i32 {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const n = nodeAt(cur)
    if n is FuncDecl { return 0 }
    if n is IfStmt || n is MatchExpr {
      const jr = joinedRecordRowOf(cur, fnIx)
      if jr >= 0 {
        const one: i32[] = [cur]
        if rjaLeaves(one, jr, fnIx) < 0 { return -1 }
      }
    } else if n is Call {
      // A function value returning a join of nested records reaches its parameter's row by
      // shape, which names the first row of those field names, not the join's (D2765).
      let ai = 0
      while ai < n.callArgs.length {
        const la = unwrapParen(n.callArgs[ai])
        if la >= 0 && lambdaJoinsNestedRecord(la) {
          if !calleeParamDeclared(n.callFn, ai, fnIx) {
            return emitFailAt(NESTED_LAMBDA_JOIN_MSG, la)
          }
        }
        ai = ai + 1
      }
    } else if n is BinExpr && n.binOp == "??" {
      // A `??` joins its two operands as an `if` does its arms.
      const cr = joinRowOfTy(recordBaseTy(nodeTyIxOf(cur)))
      if cr >= 0 {
        const two: i32[] = [n.binLeft, n.binRight]
        if rjaLeaves(two, cr, fnIx) < 0 { return -1 }
      } else if (
        recordBaseTy(nodeTyIxOf(cur)) >= 0
        && rjaValuesPart(n.binLeft, n.binRight, fnIx)
      ) {
        // A join typed as one record that no row holds meets its two records as they are; a
        // join typed as their union boxes each.
        return emitFailAt(RECORD_COPY_MSG, n.binRight)
      }
    } else if n is ArrayLit {
      const ety = tyStepElem(nodeTyIxOf(cur))
      if initJoinsWiderRecord(cur, nodeTyIxOf(cur)) {
        const er = joinRowOfTy(recordBaseTy(ety))
        if er >= 0 && rjaLeaves(n.arrElems, er, fnIx) < 0 { return -1 }
      }
    }
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if rjaWalk(kids[k], fnIx) < 0 { return -1 }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// Whether a `for v in <iter>` iterable is a STRING (`for ch in s`) — the i32-code-unit walk over
// the raw array, distinct from an `i32[]` (code 0 too) whose backing hides behind a list wrapper.
export function forInStringSrc(iterIx: i32, fnIx: i32) {
  if forInElemKind(iterIx, fnIx) != "i32" { return false }
  exprString(iterIx, fnIx)
}

// Whether a `for v in <iter>` iterable is the packed byte list (`u8[]`) — the i32-element
// walk over its own `$bl8` wrapper, distinct from an `i32[]` (element kind `"i32"` too,
// four bytes wide). The `forInStringSrc` twin: the element kind can't tell the two apart,
// so agreement lives in the `#l` temp's own wrapper (#1814 repro A).
export function forInU8Src(iterIx: i32, fnIx: i32) {
  if forInElemKind(iterIx, fnIx) != "i32" { return false }
  exprU8Array(iterIx, fnIx)
}

// The value-atom kind (`valueAtomKind`'s code) of a bare map read `m[k]` / `m.get(k)` whose value
// boxes on a miss, or -1 otherwise: the receiver's map type answers it (`mapTyScalarBoxKind`).
export function mapReadScalarBoxKind(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = nodeAt(unwrapParen(exprIx))
  if !(e is Index) { return -1 }
  if !exprMap(e.idxArr, fnIx) { return -1 }
  mapRecvScalarBoxKindIn(e.idxArr, fnIx)
}

// The ref-list table slot for a kind-5 (ref array) global cell: the annotation's element
// type when present, else the element type inferred from the initializer, so two
// un-annotated ref-list globals of distinct element types each declare their own wrapper
// instead of both declaring the first's. 0 (slot fallback) if unresolvable.
export function globalRefListSlot(letIx: i32) {
  const s = letRefListSlot(letIx, -1)
  if repShadowOn { repABNote("clamp", "globalRefListSlot", "call") }
  if s < 0 {
    if repShadowOn { repABNote("clamp", "globalRefListSlot", "CLAMPED") }
    return 0
  }
  s
}

// The name the registration pass (`collectU`) mints a row for: the box element of a literal
// with no row and no other classification, or of a union of records, which builds at its box.
// `arrLitIsRef` is checked last so a literal an earlier rung claims is not registered here, and
// carries no scalar exclusion, since repeating `arrLitUnionElemName`'s would be circular.
export function arrLitInferUnionElemName(arrIx: i32): string {
  const nun = arrLitNulUnionElemName(arrIx)
  if nun != "" && !arrLitUnionDestTaken(arrIx) { return nun }
  const cen = arrLitBoxElemName(arrIx)
  if cen == "" { return "" }
  // A destination's union types the elements, which box into it (D4635).
  if arrLitUnionDestTaken(arrIx) { return "" }
  if (
    arrLitIsRef(arrIx, -1)
    && !arrLitObjBesideNonRecord(arrIx)
    && !arrLitLeadIsList(arrIx)
    && !tyIsRecordUnion(tyRefArrElemOf(nodeTyIxOf(arrIx)))
  ) {
    return ""
  }
  cen
}

// The ref-element kind of the array literal at `arrIx` in function `fnIx` (-1: no frame),
// assuming `arrLitIsRef`: 2 when the first element is a union variant, else 1, so a `Tok[]`
// literal is kind 1 even beside a declared union. A literal whose type in the frame is a ref
// list the literal itself does not show is that type's kind.
export function arrLitElemKind(arrIx: i32, fnIx: i32): i32 {
  const ft = arrLitFrameRefTy(arrIx, fnIx)
  if ft >= 0 { return refListElemKindOfTy(tyArrayElemIx(ft)) }
  arrLitElemKindTpl(arrIx)
}

// `arrLitElemKind` read off the literal's own recorded type, the answer every frame shares.
function arrLitElemKindTpl(arrIx: i32): i32 {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    // A closure-element literal is kind 5, asked of the element itself, so a struct, map, or
    // union element that merely contains a closure keeps its own kind and wrapper.
    if arrElemIsClosureTy(arrIx) { return RLK_CLOSURE }
    if a.arrElems.length >= 1 {
      const e0 = nodeAt(a.arrElems[0])
      // A nested-list element: the inner literal's leaf picks the element kind (string 6,
      // f64 7, i64 8, else the i32-list wrapper 4). Mirrors `arrLitElemName`'s leaf keying.
      if e0 is ArrayLit {
        // Inner lists the checker joined to a union of lists box, whatever the lead inner's
        // leaf: keying that leaf builds the outer backing for one arm only (D4894).
        if arrLitUnionElemName(arrIx) != "" { return RLK_UNION }
        // A ref inner literal is kind 9, and only the arena can say so: the three leaf
        // probes below all decline an object/nested-list inner, and the arm would fall to 4,
        // keying the i32-list wrapper over a backing holding a `(ref $rlWrap)` (D702). Must
        // agree arm for arm with `arrLitElemName`'s rung of the same shape.
        const e0x = arrLitLeadInner(a)
        if arrLitIsRef(e0x, -1) || emptyArrLitIxOf(e0x) >= 0 {
          if arrLitNestedElemName(arrIx) != "" {
            return arrLitNestedElemKind(arrIx)
          }
        }
        if arrLitIsStr(e0x, -1) { return RLK_STR_LIST }
        const nk = arrLitNestedNumKind(a, e0x, -1)
        if nk == ALK_F64 { return RLK_F64_LIST }
        if nk == ALK_I64 { return RLK_I64_LIST }
        return RLK_I32_LIST
      }
      if e0 is ObjLit {
        // A union-variant element boxes into the union (kind 2); a plain struct is kind 1.
        // Must agree arm for arm with `arrLitElemName`'s object arm, one shared predicate.
        if arrLitObjElemBoxVariant(arrIx) != "" { return RLK_UNION }
        // A later `null` names the nullable row ahead of the struct, as `arrLitElemName`'s
        // object arm does: the niche of one record, or the box of a wider union (D4720).
        if arrLitNulRefElemName(arrIx) != "" {
          return arrLitNulRefElemKind(arrIx)
        }
        return RLK_STRUCT
      }
    }
    // The checker-typed union element (`arrLitIsRef`'s last rung) boxes: kind 2. Stated
    // explicitly, ahead of the `uDeclared` fall-through below, because the three classifiers
    // must agree arm for arm and this answer follows from this literal's own element type.
    if arrLitUnionElemName(arrIx) != "" { return RLK_UNION }
    // Must agree arm for arm with `arrLitElemName`'s committed-rep rung (D163): a map
    // spelling is kind 3, the same `refArrElemKind` gives the annotated `{[K]: V}[]`, and a
    // bare union arm is kind 1, the unboxed variant-struct element. `scanArrLitCommit`'s
    // gate holds nothing else, so there is no third case.
    const acnK = arrLitCommitNameAt(arrIx)
    if acnK != "" {
      if nameIsBareMap(acnK) { return RLK_MAP }
      return RLK_STRUCT
    }
    // The checker-typed map element: kind 3, the same `refArrElemKind` gives the annotated
    // `{[K]: V}[]` spelling. Checked before the `uDeclared` fall-through, which would
    // otherwise claim a map literal as a union box in any program declaring a union.
    if arrLitMapElemName(arrIx) != "" { return RLK_MAP }
    // The checker-typed object-shaped element: a direct struct element, kind 1 — the same
    // kind `refArrElemKind` gives the annotated `Circle[]` spelling. Checked before the
    // `uDeclared` fall-through, which would otherwise box an arm-element literal into the
    // union in any program declaring one, a rep a reader that unboxes cannot meet (D36).
    if arrLitNominalElemName(arrIx) != "" { return RLK_STRUCT }
    // The checker-typed list element: the nested kinds 4/6/7/8, keyed on the inner array's
    // leaf from the arena rather than a first element this literal lacks in literal form.
    // Checked before the `uDeclared` fall-through, which would otherwise box a list-element
    // literal into the union in any program declaring one — same placement as the rungs above.
    if arrLitNestedElemName(arrIx) != "" { return arrLitNestedElemKind(arrIx) }
    // D1270 — the checker-typed nullable-container element: the niche kinds, keyed off the
    // arena render through the same authority the annotated `(i32[] | null)[]` spelling
    // resolves by. Checked before the `uDeclared` fall-through, same placement as the rungs
    // above, for the same reason.
    if arrLitNulRefElemName(arrIx) != "" { return arrLitNulRefElemKind(arrIx) }
  }
  if uDeclared { return RLK_UNION }
  RLK_STRUCT
}

// The member texts to spell atom-repped node `ix` with — one home for the ladder the two
// widen consumers each wrote out. `exprIsLitAtom` has already decided the value is an atom;
// an empty answer here is a genuine disagreement, refused loudly. The third rung is the
// one-member set (D1460): a promoted one-member discriminant field is a bare `TyLit` atom.
export function litAtomWidenTexts(ix: i32, fnIx: i32) {
  const direct = nodeLitUnionMemberTexts(ix)
  if direct.length > 0 { return direct }
  // A node an instance shares with its generic records the type parameter. The instance's own
  // declaration names its member set; the hole's banked pin is one program-wide answer (D4893).
  if fnInPinnedInstance(fnIx) {
    const inst = tyLitMemberTexts(litAtomMemberTy(ix, fnIx))
    if inst.length > 0 { return inst }
  }
  const pinTy = nodeTyPinIxOf(ix)
  const pin = tyLitMemberTexts(pinTy)
  if pin.length > 0 && !tyIsNulLitUnionNiche(pinTy) { return pin }
  if holeLitReadIsAtom(ix, fnIx, 0) {
    const hole = tyLitMemberTexts(holeOperandTyOf(ix, fnIx))
    if hole.length > 0 { return hole }
  }
  const decl = tyLitMemberTexts(litAtomMemberTy(ix, fnIx))
  if decl.length > 0 { return decl }
  const own = tyLitMemberTexts(nodeTyAt(ix, fnIx))
  if own.length > 0 { return own }
  const mr = mapReadAtomTexts(ix, fnIx)
  if mr.length > 0 { return mr }
  // A `??` whose default keeps the niche's atom holds one of its operand's members.
  const ce = nodeAt(unwrapParen(ix))
  if ce is BinExpr && ce.binOp == "??" && coalesceLitUnionFits(ix, fnIx) {
    const cl = nulLitAtomTexts(ce.binLeft, fnIx)
    if cl.length > 0 { return cl }
  }
  const clo = callResultAtomTexts(ix, fnIx)
  if clo.length > 0 { return clo }
  const fld = memberAtomFieldTexts(ix, fnIx)
  if fld.length > 0 { return fld }
  // An un-annotated local holds its initializer's atom, so its texts are that read's (D5164).
  const e = nodeAt(unwrapParen(ix))
  if e is Ident {
    const d = bindingDeclInScope(unwrapParen(ix))
    if d >= 0 {
      const dn = nodeAt(d)
      if dn is LetDecl && dn.letType < 0 && dn.letInit >= 0 {
        const lf = memberAtomFieldTexts(dn.letInit, fnIx)
        if lf.length > 0 { return lf }
        return callResultAtomTexts(dn.letInit, fnIx)
      }
    }
    // A binding of an instance's atom result names the texts that result widens with.
    const g = if d < 0 { globalLetOfIn(fnIx, e.identName, unwrapParen(ix)) } else { -1 }
    if g >= 0 {
      const gn = nodeAt(g)
      if gn is LetDecl && gn.letType < 0 && gn.letInit >= 0 {
        return callResultAtomTexts(gn.letInit, -1)
      }
    }
  }
  fld
}

// The member texts of a read off an atom-valued map (`m[k]`, `m.get(k)`) or of a `??` over one,
// named by the receiver's map type; empty for any other expression. A read an instance shares
// with its generic body records the hole, so the receiver's map is what names the set.
function mapReadAtomTexts(ix: i32, fnIx: i32): string[] {
  const u = unwrapParen(ix)
  const none: string[] = []
  if u < 0 { return none }
  const e = nodeAt(u)
  if e is BinExpr {
    if e.binOp != "??" { return none }
    const cr = fusedMapReadRecvIx(unwrapParen(e.binLeft))
    if cr < 0 || coalMapReadForeignDefault(cr, e.binRight, fnIx) { return none }
    // A result that can still be null is the niche, never a bare member.
    if coalesceDefaultNullable(e.binRight, fnIx) { return none }
    return mapTyValLitUnionTexts(mapRecvTyIn(cr, fnIx))
  }
  const recv = fusedMapReadRecvIx(u)
  if recv < 0 { return none }
  mapTyValLitUnionTexts(mapRecvTyIn(recv, fnIx))
}

// The member texts of a call's atom result, read off the callee's function type — the texts
// twin of `cloCallResultLitUnion` and of `exprIsLitAtom`'s named-callee rung, which claim the
// atom from those same types. A call a specialisation wrote records no type of its own (D2152).
function callResultAtomTexts(ix: i32, fnIx: i32): string[] {
  const ty = tyLitMemberTexts(callResultAtomTyAt(ix, fnIx, 0))
  if ty.length > 0 || callResultTextsDepth > 2 { return ty }
  // An instance's atom result whose returned expression records its generic's hole names no
  // type, so its texts are the ones that expression widens with in the callee.
  const c = nodeAt(unwrapParen(ix))
  if c is Call && c.callFn >= 0 && nodeAt(c.callFn) is Ident {
    const t = fnIndexOfNode(c.callFn)
    if (
      t >= 0
      && t < fRetLitAtom.length
      && fRetLitAtom[t] == 1
      && fnInPinnedInstance(fnStmts[t])
    ) {
      const rx = fnRetExprOf(fnStmts[t])
      if rx >= 0 {
        callResultTextsDepth = callResultTextsDepth + 1
        const rt = litAtomWidenTexts(rx, fnStmts[t])
        callResultTextsDepth = callResultTextsDepth - 1
        return rt
      }
    }
  }
  ty
}

// How many callee hops `callResultAtomTexts` is inside, so a self-returning call terminates.
let callResultTextsDepth = 0

// `holeOperandTyOf` where that type is `boolean`, `boolean | null` or a literal union, which
// share the `i32` rep and so are told apart from it only by the type; -1 otherwise (D2919).
export function holeOperandI32PinTyOf(exprIx: i32, fnIx: i32): i32 {
  const t = holeOperandTyOf(exprIx, fnIx)
  if tyPrimNameOf(t) == "boolean" || tyIsNulPrim(t, "boolean") { return t }
  if tyIsLitUnion(t) && holeLitReadIsAtom(exprIx, fnIx, 0) { return t }
  -1
}

// The `i32`-niche type argument `exprIx` holds at the pin of the instance `fnIx` is, a nullable
// literal union or `boolean | null`, which no rep names apart from `i32`; -1 otherwise (D2998,
// D2985). Read off the node, else the hole it shares, the instance parameter's own annotation,
// or the receiver of an element read.
export function argNichePinTyOf(exprIx: i32, fnIx: i32): i32 {
  const ix = unwrapParen(exprIx)
  if ix < 0 { return -1 }
  const own = nodeTyIxOf(ix)
  if tyIsI32NichePin(own) { return own }
  if own >= 0 && !tyHasTyVar(own) { return -1 }
  const h = holeOperandTyOf(ix, fnIx)
  if h >= 0 {
    if tyIsI32NichePin(h) && holeLitReadIsAtom(ix, fnIx, 0) { return h }
    if tyIsI32NichePin(h) && paramIndexOf(fnIx, identNameOrEmpty(ix)) >= 0 {
      return h
    }
    return -1
  }
  const e = nodeAt(ix)
  if e is Ident {
    const pt = paramTypeNodeAt(fnIx, e.identName, ix)
    if pt >= 0 {
      const ptTy = monoParamPinTy.get(pt) ?? nodeTyIxOf(pt)
      if tyIsI32NichePin(ptTy) { return ptTy }
    }
    return -1
  }
  elemNichePinTyOf(ix, fnIx)
}

// `argNichePinTyOf`'s element read `l[i]`, at the element its receiver holds at the pin; -1
// for any other node.
function elemNichePinTyOf(ix: i32, fnIx: i32): i32 {
  const e = nodeAt(ix)
  if e is Index {
    if idxRecvIsStrList(e.idxArr, fnIx) { return -1 }
    const et = iterElemPinTy(e.idxArr, fnIx)
    if tyIsI32NichePin(et) { return et }
  }
  -1
}

// The `i32`-shared element (`tyIsI32AtomPin`) of list literal `exprIx` at the instance `fnIx`
// is, read off its first element that pins one, unless the literal's own recorded type is
// concrete and holds some other element. -1 for any other node (D2998, D2983).
export function litAtomPinElemTyOf(exprIx: i32, fnIx: i32): i32 {
  const ix = unwrapParen(exprIx)
  if ix < 0 { return -1 }
  const n = nodeAt(ix)
  if n is ArrayLit {
    const lt = nodeTyIxOf(ix)
    if lt >= 0 && !tyHasTyVar(lt) && !tyIsI32NichePin(tyStepElem(lt)) {
      return -1
    }
    let i = 0
    while i < n.arrElems.length {
      const el = n.arrElems[i]
      let t = argNichePinTyOf(el, fnIx)
      if t < 0 { t = holeOperandI32PinTyOf(el, fnIx) }
      // The hole instance's own parameter, whose pin `holeOperandI32PinTyOf` leaves to its
      // annotation, which a list built over it does not carry.
      if t < 0 && paramIndexOf(fnIx, identNameOrEmpty(unwrapParen(el))) >= 0 {
        const hp = holeOperandTyOf(el, fnIx)
        if tyIsI32AtomPin(hp) { t = hp }
      }
      if t < 0 && tyIsI32AtomPin(loopVarPinTyOf(el, fnIx)) {
        t = loopVarPinTyOf(el, fnIx)
      }
      if t >= 0 { return t }
      i = i + 1
    }
  }
  -1
}

// Whether `ix`, read in the hole instance `fnIx`, is bound there to a function type, which no
// `null` inhabits: its checked type is the hole, so only the instance can say (D3182).
export function holeBindsFunc(ix: i32, fnIx: i32): boolean {
  const t = holeOrCapturedTyOf(ix, fnIx)
  t >= 0 && t < T.tys.length && tyAt(t) is TyFunc
}

// The pin `monoArgTyName` names for-in loop variable `exprIx` at in instance `fnIx`: its list's
// element there. A type sharing the `i32` rep keys so only where the atom readers claim it and
// never in a hole instance, whose other reads key it as the cascade does (D3015).
export function loopVarArgPinTyOf(exprIx: i32, fnIx: i32): i32 {
  const t = loopVarElemPinTyOf(exprIx, fnIx)
  if t < 0 || !tyIsI32AtomPin(t) { return t }
  if monoHoleSubRow.has(fnStmtsPosOf(fnIx)) { return -1 }
  loopVarPinTyOf(exprIx, fnIx)
}

// The exact map a nullable niche `exprIx` holds inside an exact instance, or -1.
export function mapExactHeldTyOf(exprIx: i32, fnIx: i32): i32 {
  const st = exactOperandTyOf(exprIx, fnIx)
  if st < 0 { return -1 }
  mapTyPeel(st)
}

// The exact type `is` reads of operand `exprIx` in instance `fnIx`: an exact instance's
// substitution of a type parameter, else the operand's recorded type when it names none, as a
// body cloned at a bound type argument records it (D10540); -1 outside an instance.
function isOperandExactTyOf(exprIx: i32, fnIx: i32): i32 {
  const st = exactOperandTyOf(exprIx, fnIx)
  if st >= 0 { return st }
  if !fnInPinnedInstance(fnIx) { return -1 }
  const ty = nodeTyAt(unwrapParen(exprIx), fnIx)
  if ty < 0 || ty >= T.tys.length || tyHasTyVar(ty) { return -1 }
  ty
}

// Whether the exact type of union operand `exprIx` has no member that is the map `patTy`
// exactly, so `is patTy` is false though a box tag may be shared with its twin (D2720).
export function exactUnionLacksMap(
  exprIx: i32,
  patTy: i32,
  fnIx: i32,
): boolean {
  const st = isOperandExactTyOf(exprIx, fnIx)
  if st < 0 || patTy < 0 { return false }
  const flat: i32[] = []
  flattenVariantsInto(st, flat)
  let i = 0
  while i < flat.length {
    if flat[i] >= 0 && mapTwinExact(flat[i], patTy) { return false }
    i = i + 1
  }
  true
}

// Whether the exact type of union operand `exprIx` holds a twin of `patTy` but not `patTy`
// itself, so a shared box tag cannot answer and `is patTy` is false. A twin is spelled alike once
// a nested Set reads as its boolean map, or is a same-named-field record sharing the pattern's
// variant row (D2753); a member whose values fit `patTy` is not one, `is` tests fit (D8300).
export function exactUnionLacksTwin(
  exprIx: i32,
  patTy: i32,
  fnIx: i32,
): boolean {
  const st = isOperandExactTyOf(exprIx, fnIx)
  if st < 0 || patTy < 0 { return false }
  const flat: i32[] = []
  flattenVariantsInto(st, flat)
  let twin = false
  let i = 0
  while i < flat.length {
    if flat[i] >= 0 {
      if tySameSet(flat[i], patTy, TY_WALK_DEPTH) { return false }
      if assignable(flat[i], patTy) { return false }
      if tySameSpelled(flat[i], patTy, TY_WALK_DEPTH) { twin = true }
      if tySameAnonRow(flat[i], patTy) { twin = true }
    }
    i = i + 1
  }
  twin
}

// The result valtype kind of `fnIx`, read off the same ladder `emitOneFuncType` writes the
// result byte from — annotation, then the un-annotated closure fact, then the stored
// inferred kind — so a site repairing the value cannot disagree with the result it repairs.
// The closure arm is not a special case, it is the one kind `fRetKind` does not carry, so it is asked ahead of the stored kind.
function retResultVKind(fnIx: i32, fnPos: i32): VKind | null {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return vtKindOfType(fn.fnRet) }
    if fnPos < 0 { return null }
    if fnPos < fRetVoid.length {
      if fRetVoid[fnPos] == 1 { return null }
    }
    if fnReturnsClosure(fnPos) { return "closure" }
    if fnPos < fRetKind.length { return fRetKind[fnPos] }
  }
  null
}

// D1115 — does the return boundary owe a `ref.as_non_null` for `retArg`? The criterion:
// the result valtype is a non-null ref and the value classifies as the nullable niche. A
// prior guard named only two kinds of thirteen, so a narrowed nullable list, map, ref-list,
// or closure parameter returned into its own non-null result — invalid wasm at `vl check` rc 0.
export function retNeedsNonNullRecover(retArg: i32, fnIx: i32, fnPos: i32) {
  nulNicheRecoverOwed(retResultVKind(fnIx, fnPos), retArg, fnIx)
}

// Does the value at `exprIx` lower to the nullable ref niche `niche`? The read's recorded rep
// answers. A caller that accepts either record niche (`nulstruct`/`nulvariant`) asks for both.
function exprIsNulNicheOf(niche: VKind, exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // A read that recovers at the read delivers the non-null ref.
  if readOwesNonNullRecover(exprIx, fnIx) { return false }
  // A record's two nullable niches are one heap once a declared struct is also an arm, so a
  // destination of either owes the recover for both (D3593).
  if niche == "nulstruct" || niche == "nulvariant" {
    return exprNullableRecord(exprIx, fnIx)
  }
  if niche == "nulmap" { return exprNullableMap(exprIx, fnIx) }
  exprNulKind(exprIx, fnIx) == niche
}

// Is the value at `exprIx` a nullable record ref, of either niche — `nulstruct` or `nulvariant`?
export function exprNullableRecord(exprIx: i32, fnIx: i32): boolean {
  if readOwesNonNullRecover(exprIx, fnIx) { return false }
  const ck = identCellVKind(exprIx, fnIx)
  if ck == "nulstruct" || ck == "nulvariant" { return true }
  exprNullableStruct(exprIx, fnIx) || exprNullableVariant(exprIx, fnIx)
}

// D1115 — does a destination of kind `dk` owe `ref.as_non_null` on the value at `exprIx`?
// A nullable niche read deliberately keeps its raw `(ref null $H)`, since narrowing is
// type-level and the use site recovers. Every delivery into a `(ref $H)` destination owes
// the recover, and a rep added to `vkNulNicheOf` reaches every position that asks here.
export function nulNicheRecoverOwed(dk: VKind | null, exprIx: i32, fnIx: i32) {
  if dk == null { return false }
  const niche = vkNulNicheOf(dk)
  if niche == null { return false }
  exprIsNulNicheOf(niche, exprIx, fnIx)
}

// The key of a read at `exprIx` narrowed to exactly `K | null`, `K` a literal-union alias, out of
// a box that holds `K` as its string arm, or "". An atom-niche destination converts such a read
// with `emitNarrowedNicheRead` (D3118); the read itself stays the box its other consumers expect.
export function narrowedNulLitBoxKey(exprIx: i32, fnIx: i32): string {
  const ix = unwrapParen(exprIx)
  if ix < 0 { return "" }
  if !nodeTyIsNulLitUnion(ix) { return "" }
  narrowedNulLitBoxKeyAt(ix, fnIx)
}

// `narrowedNulLitBoxKey` for a consumer that converts the read where it stands, typed at its
// instance (`instanceReadTyOf`): a binding's cell is classified at the recorded type (D8122).
export function narrowedNulLitPinBoxKey(exprIx: i32, fnIx: i32): string {
  const ix = unwrapParen(exprIx)
  if ix < 0 { return "" }
  if !tyIsNullableLitUnion(instanceReadTyOf(ix, fnIx)) { return "" }
  narrowedNulLitBoxKeyAt(ix, fnIx)
}

// The narrowing key and box test the two above share, for a read already typed `K | null`.
function narrowedNulLitBoxKeyAt(ix: i32, fnIx: i32): string {
  const e = nodeAt(ix)
  let key = ""
  if e is Ident { key = e.identName } else { key = placeNarrowKeyOf(ix) }
  if key == "" { return "" }
  if isStorageRead(ix) || readNarrowedStoreAt(ix, fnIx) < 0 { return "" }
  if !exprUnion(ix, fnIx) { return "" }
  key
}

// The variant-table index of the arm of the union whose registered member set is `unionSet`
// (typed `unionTy`, -1 when unknown) that the object literal at `objIx` matches, or -1. Union-
// context-restricted: the global `objVariantName` scan could land on another union's arm sharing
// field names, silently boxing the wrong tag. -1 when `unionSet` is not a registered union.
export function unionArmVariantForObj(
  unionSet: string,
  unionTy: i32,
  objIx: i32,
  fnIx: i32,
): i32 {
  const u = unionRowKeyAB(82, unionSet, unionTy)
  if u < 0 || u >= unVarStart.length || u >= unVarCount.length { return -1 }
  const own = unionArmOfLitTy(u, objIx, fnIx)
  if own >= 0 { return own }
  // A literal leaving out a nullable field (D4601) is the arm the checker adopted, which
  // the field-name scan below cannot see: the omission matches a narrower arm by names alone.
  const adopted = unionArmAdoptedOmitting(u, objIx, fnIx)
  if adopted >= 0 { return adopted }
  let vi = unVarStart[u]
  while vi < unVarStart[u] + unVarCount[u] {
    if objMatchesVariantIdxOmit(objIx, vi, fnIx, false) { return vi }
    vi = vi + 1
  }
  -1
}

// The one arm of union row `u` whose type is the type the checker gave the object literal at
// `objIx`, so a literal is built at its own type ahead of an arm that merely shares its field
// names (`{r: null}` is no `{r: i32}`); -1 when no arm, or more than one, has that type.
function unionArmOfLitTy(u: i32, objIx: i32, fnIx: i32): i32 {
  const rep = nodeRepTyAt(objIx, fnIx)
  if rep < 0 || rep >= T.tys.length || !(tyAt(rep) is TyObj) { return -1 }
  if u < 0 || u >= unVarStart.length || u >= unVarCount.length { return -1 }
  let hit = -1
  let vi = unVarStart[u]
  while vi < unVarStart[u] + unVarCount[u] && vi < uVarTyIx.length {
    const vt = uVarTyIx[vi]
    if vt >= 0 && tySame(vt, rep) {
      if hit >= 0 { return -1 }
      hit = vi
    }
    vi = vi + 1
  }
  if hit >= 0 && !objMatchesVariantIdxOmit(objIx, hit, fnIx, false) {
    return -1
  }
  hit
}

// The arm of union row `u` whose field-name set is that of the record the checker adopted the
// literal at `objIx` as, when that record has fields the literal omits; -1 when the literal
// omits nothing, or no single arm of `u` carries exactly those names and admits the omission.
function unionArmAdoptedOmitting(u: i32, objIx: i32, fnIx: i32): i32 {
  const o = nodeAt(objIx)
  const rep = nodeRepTyAt(objIx, fnIx)
  if !(o is ObjLit) || rep < 0 || rep >= T.tys.length { return -1 }
  if u < 0 || u >= unVarStart.length || u >= unVarCount.length { return -1 }
  const r = tyAt(rep)
  if !(r is TyObj) || r.objFieldNames.length <= o.objFields.length { return -1 }
  const own = variantRowInRowOfTy(u, rep)
  if own >= 0 {
    if objMatchesVariantIdxOmit(objIx, own, fnIx, true) { return own }
  }
  let hit = -1
  let vi = unVarStart[u]
  while vi < unVarStart[u] + unVarCount[u] && vi < uFieldCount.length {
    let same = uFieldCount[vi] == r.objFieldNames.length
    for n in r.objFieldNames {
      if variantFieldIndex(vi, n) < 0 { same = false }
    }
    if same && objMatchesVariantIdxOmit(objIx, vi, fnIx, true) {
      if hit >= 0 { return -1 }
      hit = vi
    }
    vi = vi + 1
  }
  hit
}

// The union variant arm (of `unionSet`, typed `unionTy`) whose struct layout matches the struct-typed
// expression at `exprIx`, or -1 — the struct-expression dual of `unionArmVariantForObj`: a
// struct-typed ident/call result is built as its own plain struct, a layout twin of but
// distinct type from the variant struct, so the emitter re-boxes it against the matched arm.
export function unionArmVariantForStructExpr(
  unionSet: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  const ssi = structIndexOfExpr(exprIx, fnIx)
  if ssi < 0 { return -1 }
  const u = unionRowKeyAB(83, unionSet, unionTy)
  if u < 0 || u >= unVarStart.length || u >= unVarCount.length { return -1 }
  let vi = unVarStart[u]
  while vi < unVarStart[u] + unVarCount[u] {
    if structIdxMatchesVariantIdx(ssi, vi) { return vi }
    vi = vi + 1
  }
  -1
}

// The arm of union `unionTy` a record value at `exprIx` built at another row lands on: the
// member the checker's `recAdLanding` names, when the value's row copies onto it by widening
// numbers. -1 when the value lands on no record member or is already built at that arm's row.
export function unionArmLandingForStructExpr(
  unionSet: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  const ssi = structIndexOfExpr(exprIx, fnIx)
  if ssi < 0 { return -1 }
  const own = nonNulTyOf(nodeTyAt(exprIx, fnIx))
  const dst = nonNulTyOf(unionTy)
  if own < 0 || dst < 0 || own >= T.tys.length || dst >= T.tys.length {
    return -1
  }
  if !(tyAt(own) is TyObj) { return -1 }
  const land = recAdLanding(own, dst)
  if land == dst || land < 0 || !(tyAt(land) is TyObj) { return -1 }
  const u = unionRowKeyAB(91, unionSet, unionTy)
  if u < 0 || u >= unVarStart.length || u >= unVarCount.length { return -1 }
  let vi = unVarStart[u]
  while vi < unVarStart[u] + unVarCount[u] && vi < uVarTyIx.length {
    const vt = uVarTyIx[vi]
    if vt >= 0 && tySame(vt, land) {
      if structIdxConvertsToVariantIdx(ssi, vi) { return vi }
      return -1
    }
    vi = vi + 1
  }
  -1
}

// Whether the union-box field read at `memIx` holds a stored member that two of the receiver's
// own members widen to, so no read at the own type can tell which one it held.
export function memReadBoxAmbiguous(memIx: i32, fnIx: i32): boolean {
  const nt: i32[] = []
  memReadBoxPlan(memIx, fnIx, nt) == 2
}

// The `fitSh*` row `listFitShadowSet` stored for a read of `name` at node `exprIx` typed as that
// row's list and resolving to the same binding, or -1 when the read takes the binding itself.
export function listFitShadowRow(name: string, exprIx: i32, fnIx: i32): i32 {
  if fitShName.length == 0 { return -1 }
  if narListReadsDecl(exprIx) { return -1 }
  const t = nodeTyAt(exprIx, fnIx)
  if t < 0 { return -1 }
  const recvLoc = localIndexOf(fnIx, unwrapParen(exprIx))
  if recvLoc < 0 { return -1 }
  let i = 0
  while i < fitShName.length {
    if (
      fitShName[i] == name
      && tySame(fitShTy[i], t)
      && fitShRecv[i] == recvLoc
    ) {
      return i
    }
    i = i + 1
  }
  -1
}

// `refListSlotOfExpr` under its historical name. The two answered differently only while the
// plain one clamped a miss to slot 0; with that gone there is one answer, and the alias keeps
// the reading sites that state they need the strict one saying so. D791.
export function refListSlotOfExprStrict(exprIx: i32, fnIx: i32): i32 {
  refListSlotOfExpr(exprIx, fnIx)
}

// The ref-list row the value of `exprIx` is actually emitted at, or -1 — only an identifier,
// a call, a field read or an index answers. Unlike `refListSlotOfExprStrict` (which answers
// the row the element spelling names), this reads the row the emitter actually put the value
// in, since a shadowed global or a literal already built at a destination's row can differ. D791.
export function exprEmittedRefListSlot(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const inner = unwrapParen(exprIx)
  if inner < 0 || inner >= P.nodes.length { return -1 }
  const e = nodeAt(inner)
  match e {
    Ident => {
      const sl = declaredSlotOf(inner)
      if sl >= 0 {
        if declaredKind(inner) != "reflist" { return -1 }
        if sl >= localStructIdx.length { return -1 }
        return localStructIdx[sl]
      }
      const pn = paramRefArrayName(fnIx, e.identName)
      if pn != "" && paramReadAt(fnIx, e.identName, inner) {
        return repSlotOfKind(
          "reflist",
          nodeTyIxOf(paramTypeNode(fnIx, e.identName)),
        )
      }
      // A closure's capture reads the row its env field is typed with (D3058).
      const cs = capturedRefListSlot(fnIx, e.identName)
      if cs >= 0 { return cs }
      const g = globalLetOfIn(fnIx, e.identName, inner)
      if g >= 0 {
        if globalCellKind(g) != "reflist" { return -1 }
        return globalRefListSlot(g)
      }
    }
    // A call result's row is the callee's own declared return, not the "spelling" this function
    // otherwise refuses — a callee's return annotation is what its own emit is typed from. The
    // same lookup (`rlSlotByNameTwin` off `fRetRArrElem`) the parameter arm above already trusts,
    // for the identical reason: a param's row comes from its annotation too. D794.
    Call => {
      const callee = nodeAt(unwrapParen(e.callFn))
      if callee is Ident {
        const cn = fnRetRefArrayNameSid(
          sidOfNode(e.callFn),
          callee.identName,
          fnIx,
          e.callFn,
        )
        if cn != "" {
          return rlSlotByNameTwin(cn, tyRefArrElemOf(nodeTyInOf(inner, fnIx)))
        }
      }
      // A call through a function value returns at the row its function type's result keys.
      const cft = nodeTyAt(e.callFn, fnIx)
      if cft >= 0 && cft < T.tys.length {
        const cf = tyAt(cft)
        if cf is TyFunc && cf.fnRet >= 0 && cf.fnRet < T.tys.length {
          const crt = tyAt(cf.fnRet)
          if crt is TyArray {
            const crs = rlSlotOfTy(crt.aElem)
            if crs >= 0 { return crs }
          }
        }
      }
    }
    // A field read's row is the struct table's, from the field's own storage slot. A union-ARM
    // receiver has no struct row, so its field's element is read off the variant tables first
    // (D1963).
    Member => {
      const avi9 = memRecvArmVariantIndex(e.memObj, fnIx)
      if avi9 >= 0 {
        const en9 = variantFieldElemNameOr(avi9, e.memProp)
        if en9 != "" {
          return variantFieldRefSlot(avi9, variantFieldIndex(avi9, e.memProp))
        }
      }
      const msi = structIndexOfExpr(e.memObj, fnIx)
      if msi >= 0 {
        const mfi = sFieldIndex(msi, e.memProp)
        if mfi >= 0 { return sFieldRefSlot(msi, mfi) }
      }
    }
    // The `?.` twin of the field read above, resolved through the chain (D1676).
    OptMember => {
      const osi = optChainStructIdxOf(e.omObj, fnIx)
      if osi >= 0 {
        const ofi = sFieldIndex(osi, e.omProp)
        if ofi >= 0 { return sFieldRefSlot(osi, ofi) }
      }
    }
    // An indexed read's row is the outer list's element slot, read strictly (not clamped) since
    // a bare-scalar array answering nothing must not fall back to a real, unrelated slot. D1500.
    Index => {
      const osl = refListSlotOfExprStrict(e.idxArr, fnIx)
      if osl >= 0 { return rlElemInnerSlot(osl) }
    }
    // no other expression is emitted at a ref-list row
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The list build code an expression's list cell demands — the same 0-7 `LBK_*` vocabulary
// `listBuildKindOfVKind` speaks, for positions with no annotation node
// left to read (a compiled-away local, a param on the `FuncDecl`). Order: ref-list row first,
// then nullable scalar backings, then non-null scalars.
export function exprListCellBuildKind(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return LBK_I32_LIST }
  if exprRefArray(exprIx, fnIx) || exprNullableRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlElemKindTbl.length {
      if rlElemKindTbl[s] == RLK_UNION { return LBK_UNION }
      if rlElemKindTbl[s] == RLK_CLOSURE { return LBK_REF_AT_SLOT }
    }
    return LBK_REF
  }
  // `string[] | null`, `f64[] | null`, `i64[] | null`, `f32[] | null` — the DISTINCT-backing
  // niches, mapped by the one home the call-argument and global-assign boundaries also read.
  const nsk = exprNulScalarListKind(exprIx, fnIx)
  if nsk != null { return nulScalarListBuildKind(nsk) }
  if exprStringArray(exprIx, fnIx) { return LBK_STR_LIST }
  if exprF64Array(exprIx, fnIx) { return LBK_F64_LIST }
  if exprI64Array(exprIx, fnIx) { return LBK_I64_LIST }
  if exprF32Array(exprIx, fnIx) { return LBK_F32_LIST }
  if exprU8Array(exprIx, fnIx) { return LBK_U8_LIST }
  LBK_I32_LIST
}

// The ref-list row twin of `exprListCellBuildKind` — WHICH ref-list element row the
// cell holds. `0` (the slot fallback `refListSlotOfExpr` itself returns) for a non-ref list,
// matching `tyAnnRefListSlot`'s `0` for a non-ref-array annotation.
export function exprListCellBuildSlot(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  if exprRefArray(exprIx, fnIx) || exprNullableRefArray(exprIx, fnIx) {
    return refListSlotOfExpr(exprIx, fnIx)
  }
  0
}

// Whether a pin must leave this binding's element row alone: the checker built its literal at a
// union list, which a record-element pin would contradict (D501).
export function letListDestKindConflict(letIx: i32, fnIx: i32): boolean {
  letInitUnionListTy(letIx, fnIx) >= 0
}
