// `emit_field_codes.vl` — the field code a type, value kind or match spelling
// lowers to, and the shape fields it parses.

import { fnTagTyIsTagged } from "./check_elab_cap"
import { inferRetNameByNode, inferRetTyIxByNode } from "./check_infer_ret"
import { isValueUnionTyOr } from "./check_ty_rep"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  litUnionAliasNameOfTy,
  structNameOfTy,
  tyArrayElemIx,
  tyAt,
  tyIsLitUnion,
  tyIsLitUnionAlias,
  tyIsLitUnionArray,
  tySame,
} from "./check_types"
import {
  rowCanonIdOfName,
  sFieldElemNameAt,
  sScanLim,
  structIndexOfTy,
} from "./emit_atom_kinds"
import { nameIsShapeSpanEnds, tyGroupWrapsWhole } from "./emit_base"
import { recNarrowRecordOf } from "./check_bind_adopt"
import { rowFieldCode0Kind } from "./emit_join_records"
import { fieldCodeOfListRep } from "./emit_list_rep"
import { isStructOfTy, mvValLowersTy } from "./emit_mv_slots"
import { isVariantSpelling, variantIndexOf } from "./emit_local_slots"
import {
  MV_ARM_NOHINT,
  repElemTyOfName,
  repNameCanonId,
  repOfTy,
  repVariantShapeRowOf,
} from "./emit_rep"
import {
  FC_CLOSURE,
  FC_F32,
  FC_F64,
  FC_I32,
  FC_I32_LIST,
  FC_I64,
  FC_MAP,
  FC_NUL_CLOSURE,
  FC_NUL_LIT_UNION,
  FC_NUL_STR,
  FC_REF_LIST,
  FC_STR,
  FC_STRUCT,
  FC_UNION,
  VKind,
  fRetKind,
  fRetStructIdx,
  fnStmts,
  gaeBases,
  sFieldCount,
  sFieldElemName,
  sFieldNames,
  sFieldStart,
  sIsRefRow,
  sNames,
  sTyIx,
  uVarTyIx,
  uVariants,
  unMemAtoms,
  unMemTyCount,
  unMemTyStart,
  unMemberSet,
} from "./emit_state"
import { sFieldIndex } from "./emit_struct_order"
import { unionMemberSetOf, unionRowKeyAB } from "./emit_union_registry"
import { strListIndexOf } from "./listutil"
import {
  annGenAppSpanEnds,
  fieldNameOf,
  fieldTypeTextOf,
  gaeHeadNameOf,
  gaeLtAt,
  groupInnerOf,
  nameIsShapeOpen,
  nameStripSpaces,
  tyTopLevelSplit,
} from "./tyname"
import { tyEmitPrimOf } from "./tyquery"

// True if `name` is a single inline struct shape spanning the whole string (`{f: i32}`) —
// its first `{`'s matching `}` is the last char, and it isn't a map spelling (`{[`). The
// brace-only alphabet is safe against `<`/`>` but not a quoted literal member
// (`{v: "a}b"}` closes the group early), so `tyGroupWrapsWhole` is quote-aware instead.
export function nameIsWholeSpanShape(name: string) {
  // The endpoint span alone (`nameIsShapeSpanEnds`) is a wider test that a composite
  // union name like `{a:{b:i32}}|{c:i32}` also passes; the walk here is strictly tighter.
  if !nameIsShapeSpanEnds(name) { return false }
  tyGroupWrapsWhole(name)
}

// Does some struct row carry exactly this `TyObj`'s field-name set? A shallow,
// terminating structural test for "this field is a struct" — no code comparison, so a
// recursive shape (`type Node = {next: Node | null}`) cannot loop. Ignoring field types is
// sound here: this decides only the code (15, "a nested struct"), never which row.
function tyHasStructRowShallow(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyObj {
    const fnames = t.objFieldNames
    if fnames.length == 0 { return false }
    const lim = sScanLim()
    let si = 0
    while si < lim {
      if (
        !sIsRefRow(si)
        && sFieldStart[si] + sFieldCount[si] <= sFieldElemName.length
      ) {
        if sFieldCount[si] == fnames.length {
          let ok = true
          let k = 0
          while k < fnames.length {
            if sFieldIndex(si, fnames[k]) < 0 { ok = false }
            k = k + 1
          }
          if ok { return true }
        }
      }
      si = si + 1
    }
  }
  false
}

// `fieldCodeOfTy` for the matcher only (D-MATCHCODE): `fieldCodeOfTy` serves two
// consumers — the matcher below, which only compares a code, and `nameFieldCodeTy`, which
// feeds the path that records `sFieldTypes`. Code 15 is a two-part answer (code plus an
// element name), so widening it there would leave `refSlot` unresolved; widening only here doesn't.
export function fieldCodeForMatch(ty: i32): i32 {
  const c = fieldCodeOfTy(ty)
  if c != -2 { return c }
  if ty < 0 { return -2 }
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less: a new arena variant with a match field code must name
  // it here rather than take the `-2` and fall to the spelling ladder.
  match t {
    TyObj => {
      if isStructOfTy(ty) { return FC_STRUCT }
      if tyHasStructRowShallow(ty) { return FC_STRUCT }
    }
    TyNullable => {
      if isStructOfTy(t.nInner) { return FC_STRUCT }
      if tyHasStructRowShallow(t.nInner) { return FC_STRUCT }
    }
    TyMap => {
      // A map-typed field is code 19, gated identically to the spelling ladder
      // (`mvValLowersTy`): a map whose value the classifier can't lower keeps failing loudly.
      if mvValLowersTy(t.mVal) == 1 { return FC_MAP }
    }
    TyPrim | TyErr | TyFunc | TyUnion | TyArray | TyVar | TyLit | TyNeg => {
      // No match field code of its own; the spelling ladder answers.
    }
  }
  -2
}

// The declaration-identity name of an arena type — `shapeNominalOfTy`'s two arena rungs,
// lifted out so other nominal questions can ask them without the two field-set scans that
// follow there. Both rungs answer by declaration identity, never a guess. "" for an
// anonymous shape — the two field-set rungs are deliberately not here (D33).
export function declNominalOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const si = structIndexOfTy(ty)
  if si >= 0 { return sNames[si] }
  const av = repVariantShapeRowOf(ty)
  if av >= 0 { return uVariants[av] }
  ""
}

// The declared-row widenings `anonValueFitsField` grants an object literal's field value,
// asked of a recorded field type instead of a value node. The two sides must agree:
// `structIndexOfObj` accepts a widening building the row, so the shape resolver must
// accept the same widening naming it, or a container's element type resolves to no row at all.
function fieldCodeWidensElem(qc: i32, rc: i32, elem: string): boolean {
  if qc == rc { return true }
  // A union-BOX field takes any member — `anonValueFitsField`'s own first line, and the
  // pairing D461 added to the NAME side of this same question.
  if rc == FC_UNION { return true }
  if qc == FC_I32 {
    // An i32/boolean/litunion-atom value widens into wider numeric slots and the `K | null`
    // atom niche — not the `boolean | null` niche (21), which needs a boolean literal, a
    // distinction the code has erased and a type can't recover; not the map slots either.
    if rc == FC_I64 { return true }
    if rc == FC_F32 { return true }
    if rc == FC_NUL_LIT_UNION { return true }
    return false
  }
  if qc == FC_STR {
    // A string value: the `string | null` ref niche, the `K | null` atom niche, and a
    // literal-union atom slot (records its union name in the element column).
    if rc == FC_NUL_STR { return true }
    if rc == FC_NUL_LIT_UNION { return true }
    if rc == FC_I32 { return elem != "" }
    return false
  }
  false
}

// `fieldCodeWidensElem` against a STRUCT row's field.
export function objFieldCodeWidens(
  qc: i32,
  rc: i32,
  si: i32,
  fj: i32,
): boolean {
  fieldCodeWidensElem(qc, rc, sFieldElemNameAt(si, fj))
}

// Whether every field a shape spelling writes as `i32` or `boolean` has that same code-0 kind
// in row `si`'s own type; a row whose field type is unknown or a hole agrees.
export function code0SpellingFitsRow(
  fnames: string[],
  ftypes: string[],
  si: i32,
): boolean {
  if si < 0 || si >= sTyIx.length { return true }
  let k = 0
  while k < fnames.length {
    let tk = 0
    if ftypes[k] == "i32" { tk = 1 }
    if ftypes[k] == "boolean" { tk = 2 }
    if tk != 0 {
      const rk = rowFieldCode0Kind(si, fnames[k])
      if rk != 0 && rk != tk { return false }
    }
    k = k + 1
  }
  true
}

// Whether no field of row `p` is `i32` in one of rows `p` and `c` and `boolean` in the other.
// The two share a layout, so a supertype edge would validate while relating two records the
// checker keeps apart; a call pinned to either then reads the other's row (D3693).
export function rowBoolI32Agree(p: i32, c: i32): boolean {
  if p < 0 || p >= sFieldCount.length { return true }
  let k = 0
  while k < sFieldCount[p] {
    const nm = sFieldNames[sFieldStart[p] + k]
    const pk = rowFieldCode0Kind(p, nm)
    const ck = rowFieldCode0Kind(c, nm)
    if (pk == 1 && ck == 2) || (pk == 2 && ck == 1) { return false }
    k = k + 1
  }
  true
}

// Parse a canonical inline shape name `{a:T,b:U}` into parallel field-name / field-type
// string lists. A non-`{…}` name appends nothing. Shared by the variant/struct field-set
// resolvers so a field-name match can be tightened with a field-type check. A part with no
// `:` keeps the whole part as the field name.
export function shapeFieldParse(
  name: string,
  outNames: string[],
  outTypes: string[],
) {
  if nameIsShapeOpen(name) {
    const flat = nameStripSpaces(name)
    const parts: string[] = []
    // The group-interior cut (`groupInnerOf`) runs on the despaced name, so a hypothetical
    // `"{ "` reaches here as `flat == "{"` — `.slice` clamps, so the answer stays "".
    tyTopLevelSplit(groupInnerOf(flat), ',', false, parts)
    let k = 0
    while k < parts.length {
      const part = parts[k]
      const ci = part.indexOf(":")
      if ci < 0 {
        outNames.push(part)
        outTypes.push("")
      } else {
        // The field-colon cut (`fieldNameOf`/`fieldTypeTextOf`). The `ci < 0` guard above
        // keeps the whole part as the field name, unlike siblings that gate `ci <= 0`.
        outNames.push(fieldNameOf(part, ci))
        outTypes.push(fieldTypeTextOf(part, ci))
      }
      k = k + 1
    }
  }
}

// The row union-box field key `name` of type `ty` (-1 unknown) names: the row the type keys
// to, else the name's, asked under `site`. -1 for an empty key.
function unionBoxKeyRowOf(site: i32, name: string, ty: i32): i32 {
  if name == "" { return -1 }
  unionRowKeyAB(site, name, ty)
}

// The member SEQUENCE a union-box field key names, canonical where the registry knows it: a
// registered alias answers with its own set, so `U` and `A|B` are one key. Despaced, never
// deduped and never reordered — a box's tags are positional, so the sequence IS the layout
// (DECISIONS.md, the union member-set ABI). `u` is the key's row or -1; "" resolves nothing.
function unionBoxMemberSeqOf(name: string, u: i32): string {
  if name == "" { return "" }
  if u >= 0 && u < unMemberSet.length { return nameStripSpaces(unMemberSet[u]) }
  nameStripSpaces(unionMemberSetOf(name))
}

// Row `u` (a key's row or -1) when it recorded its members; else -1.
function unionBoxRowOf(u: i32): i32 {
  if u < 0 || u >= unMemTyStart.length { return -1 }
  const st = unMemTyStart[u]
  if st < 0 || st + unMemTyCount[u] > unMemAtoms.length { return -1 }
  if unMemTyCount[u] == 1 && unMemAtoms[st] == "" { return -1 }
  u
}

// Whether rows `u` and `v` (each one `unionBoxRowOf` returned) record the same member
// sequence, member by member and despaced: `unionBoxMemberSeqOf` read from the member table.
function unRowsSameMemberSeq(u: i32, v: i32): boolean {
  if unMemTyCount[u] != unMemTyCount[v] { return false }
  const su = unMemTyStart[u]
  const sv = unMemTyStart[v]
  let i = 0
  while i < unMemTyCount[u] {
    if (
      nameStripSpaces(unMemAtoms[su + i])
      != nameStripSpaces(unMemAtoms[sv + i])
    ) {
      return false
    }
    i = i + 1
  }
  true
}

// True unless two union-box field keys are proven to name different member sequences — the
// code-16 tightening the field-set matchers apply, since every box field shares code 16
// whatever it boxes. Refutation-only: a key resolving to "" is unknown, not a mismatch. Each
// key asks its type's row (`tyA`/`tyB`, -1 unknown) under `site`, then its spelling (D1675).
export function unionMemberSetsCompat(
  site: i32,
  ta: string,
  tyA: i32,
  tb: string,
  tyB: i32,
): boolean {
  if ta == tb { return true }
  const ra = unionBoxKeyRowOf(site, ta, tyA)
  const rb = unionBoxKeyRowOf(site, tb, tyB)
  const ua = unionBoxRowOf(ra)
  const ub = unionBoxRowOf(rb)
  if ua >= 0 && ub >= 0 { return ua == ub || unRowsSameMemberSeq(ua, ub) }
  const sa = unionBoxMemberSeqOf(ta, ra)
  if sa == "" { return true }
  const sb = unionBoxMemberSeqOf(tb, rb)
  if sb == "" { return true }
  sa == sb
}

// Whether spelling `t` is an inline record or an application of a generic record alias.
export function nameIsRecordSpelling(t: string): boolean {
  if nameIsWholeSpanShape(t) { return true }
  if !annGenAppSpanEnds(t) { return false }
  gaeIndexOf(gaeHeadNameOf(t, gaeLtAt(t))) >= 0
}

// True unless the two nested-struct type spellings `ta` / `elem` are proven to denote
// distinct structures: both resolve through the checker's canonical structural key
// (`repNameCanonId`) and the keys differ. Either side unresolvable (-1) stays lenient —
// never a false reject of a twin the canon layer doesn't cover.
export function nestedStructNamesCompat(ta: string, elem: string): boolean {
  if ta == elem { return true }
  const ka = repNameCanonId(ta)
  if ka < 0 { return true }
  let ke = repNameCanonId(elem)
  // An anonymous row's name resolves to no declaration; its own recorded type is its identity,
  // so `{f: boolean}` does not take a `{f: 4}` literal's row (D2841).
  if ke < 0 { ke = rowCanonIdOfName(elem) }
  if ke < 0 { return true }
  ka == ke
}

// The arm whose own canonical render is `name` (D762) — strictly tighter than
// `variantIndexOfTypeName` below, which is a lenient field-set match so an adopted
// literal's render can reach the arm the adoption already chose. Asked of the arena type
// `name` resolves to, field by field in order — the container-element question.
export function variantIndexOfOwnRender(name: string): i32 {
  if !nameIsShapeOpen(name) { return -1 }
  variantRowOwnRender(jrOneRecordOf(repElemTyOfName(name)), true, -1)
}

// The arm whose own type renders as the record `ty` does — the arm recorded at that record
// itself, else the first with its fields in its order, each spelled alike; -1 for none.
export function variantRowOfOwnRenderTy(tyIn: i32): i32 {
  const ty = jrOneRecordOf(tyIn)
  if ty < 0 { return -1 }
  variantRowOwnRender(ty, false, -1)
}

// The inline arm an anonymous record `ty` is: an arm with no declared name whose type is the
// same type, which an inline annotation of that arm reaches by shape (D4638). A declared record,
// or a declared arm of its layout, is not this arm. -1 for none.
function anonArmRowOfTy(ty: i32): i32 {
  if structNameOfTy(ty) != "" { return -1 }
  const r = jrOneRecordOf(ty)
  if r < 0 { return -1 }
  variantRowOwnRender(r, false, ty)
}

// The arm a map value of type `ty` is, or holds through map hops: the arm recorded at the type,
// else the inline arm an anonymous record is (`anonArmRowOfTy`). -1 for none.
export function mvArmSigOfShapeTy(ty: i32, depth: i32): i32 {
  if ty < 0 || depth <= 0 || ty >= T.tys.length { return -1 }
  const v = repVariantShapeRowOf(ty)
  if v >= 0 { return v }
  const an = anonArmRowOfTy(ty)
  if an >= 0 { return an }
  const t = tyAt(ty)
  if t is TyMap { return mvArmSigOfShapeTy(t.mVal, depth - 1) }
  -1
}

// The mv slot find's arm hint for a value of type `ty`: `MV_ARM_NOHINT` with no type, else the
// arm the mint records for it (`mvArmSigOfShapeTy`), or -1 for a type reaching no arm.
export function mvArmHintOfShapeTy(ty: i32): i32 {
  if ty < 0 { return MV_ARM_NOHINT }
  mvArmSigOfShapeTy(ty, 8)
}

// `isVariantSpelling`, then the arm whose record is the tested record's type spelled by shape:
// same-shape records are one type, so a declared name tests the arm a pin minted by shape
// (D5051). An arm only rendered alike (`{x: i32}` for `{x: 1 | 2}`) is not it (D4089).
export function isVariantSpellingOfShape(variant: string, tyIx: i32): string {
  const sp = isVariantSpelling(variant, tyIx)
  if variantIndexOf(sp) >= 0 { return sp }
  if tyIx < 0 || tyIx >= T.tys.length || !(tyAt(tyIx) is TyObj) { return sp }
  const vi = variantRowOfOwnRenderTy(tyIx)
  if vi < 0 || vi >= uVariants.length || vi >= uVarTyIx.length { return sp }
  if !tySame(uVarTyIx[vi], tyIx) { return sp }
  uVariants[vi]
}

// The one arm scan both keys share: the first arm that is the record `ty` or has its fields in
// its order, each spelled alike; `exact` also keeps a literal field apart from its base, as the
// arm's own render does. `anonOf` >= 0 keeps only an arm with no declared name that is that
// same type. -1 for none.
function variantRowOwnRender(ty: i32, exact: boolean, anonOf: i32): i32 {
  if ty < 0 { return -1 }
  let vi = 0
  while vi < uVariants.length {
    if vi < uVarTyIx.length && uVarTyIx[vi] >= 0 {
      const a = uVarTyIx[vi]
      if (
        (a == ty || jrSameFieldSeq(a, ty, 0, exact))
        && (anonOf < 0 || (structNameOfTy(a) == "" && tySame(a, anonOf)))
      ) {
        return vi
      }
    }
    vi = vi + 1
  }
  -1
}

// The record `ty` renders as: itself, or the first member of a union whose members are all
// records spelled alike, which the render dedups to one; -1 for anything else.
function jrOneRecordOf(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  if t is TyObj { return ty }
  if !(t is TyUnion) { return -1 }
  const ms = t.uMembers
  if ms.length == 0 { return -1 }
  const m0 = ms[0]
  if m0 < 0 || !(tyAt(m0) is TyObj) { return -1 }
  for m in ms {
    if m < 0 || !(tyAt(m) is TyObj) { return -1 }
    if !jrSpelledAlike(m, m0, 0, false) { return -1 }
  }
  m0
}

// Whether records `a` and `b` have the same fields in the same order, each spelled alike.
function jrSameFieldSeq(a: i32, b: i32, depth: i32, exact: boolean): boolean {
  if a < 0 || a >= T.tys.length || b < 0 || b >= T.tys.length { return false }
  const ta = tyAt(a)
  const tb = tyAt(b)
  if ta is TyObj {
    if tb is TyObj {
      const na = ta.objFieldNames
      const nb = tb.objFieldNames
      if na.length != nb.length { return false }
      let k = 0
      while k < na.length {
        if na[k] != nb[k] { return false }
        if (
          !jrSpelledAlike(
            ta.objFieldTypes[k],
            tb.objFieldTypes[k],
            depth + 1,
            exact,
          )
        ) {
          return false
        }
        k = k + 1
      }
      return true
    }
  }
  false
}

// Whether field types `a` and `b` render alike: one literal-union alias, one primitive (a
// literal spells its base unless `exact`), or the same shape all the way down.
function jrSpelledAlike(a: i32, b: i32, depth: i32, exact: boolean): boolean {
  if a == b { return true }
  if depth > 8 || a < 0 || b < 0 { return false }
  if litUnionAliasNameOfTy(a) != litUnionAliasNameOfTy(b) { return false }
  const pa = tyEmitPrimOf(a)
  const pb = tyEmitPrimOf(b)
  if pa != null || pb != null {
    if exact && !(tyAt(a) is TyPrim && tyAt(b) is TyPrim) {
      return tySame(a, b)
    }
    return pa == pb
  }
  if tySame(a, b) { return true }
  const ta = tyAt(a)
  const tb = tyAt(b)
  // Exhaustive over `Ty` and `_`-less: only a shape, a list or a nullable spells its parts.
  match ta {
    TyObj => {
      return jrSameFieldSeq(a, b, depth + 1, exact)
    }
    TyArray => {
      const eb = tyArrayElemIx(b)
      return eb >= 0 && jrSpelledAlike(ta.aElem, eb, depth + 1, exact)
    }
    TyNullable => {
      if tb is TyNullable {
        return jrSpelledAlike(ta.nInner, tb.nInner, depth + 1, exact)
      }
    }
    TyPrim | TyErr | TyUnion | TyVar | TyLit | TyNeg | TyFunc | TyMap => {
      // Spelled alike only as the same type, which `tySame` above already answered.
    }
  }
  false
}

// The union-variant index a lifted callback `fe` returns when it collapses to a single
// variant (`(a) => if a is Cat { a } else { catShape }`), read from the checker's recorded
// node-keyed return shape, or -1. Lets `.map`/`.filter` classify the result as the variant
// ref list, rather than widening the narrowed receiver back to the box.
export function cbRetVariantIdx(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const nm = inferRetNameByNode(fnStmts[fe])
  // The nominal arm on the name, the structural arm on the arena: `variantIndexOfTypeName`
  // runs both, but only the direct name match asks whether this IS a declared variant —
  // identity the arena can't recover (B208). The arena arm is stricter, refusing a
  // field-set collision `shapeFieldTypeCompatK` would let through (avoided by the `fRetKind` guard below).
  let vi = variantIndexOf(nm)
  if vi < 0 {
    const rt = inferRetTyIxByNode(fnStmts[fe])
    vi = repVariantShapeRowOf(rt)
    if vi < 0 {
      const nr = recNarrowRecordOf(rt)
      if nr >= 0 { vi = repVariantShapeRowOf(nr) }
    }
  }
  if vi < 0 { return -1 }
  // A lambda whose inferred return the checker classified as a plain struct must not
  // collapse to a variant merely because its anonymous shape coincides with an unrelated
  // sibling field's union arm: its `$fnsig` result must key the struct token, not the
  // variant one. A direct nominal variant name is always a genuine collapse and passes through.
  if fe < fRetKind.length {
    if variantIndexOf(nm) < 0 {
      const k = fRetKind[fe]
      if (k == "struct" || k == "nulstruct") && fRetStructIdx[fe] >= 0 {
        return -1
      }
    }
  }
  vi
}

// ── the field-code classifier's arena rung ──
// The one translation from `VKind` into the field-code vocabulary, so the fourteen constants
// live here rather than at fourteen arms. `-2` is the vocabulary's decline — a kind it does
// not name, never a code.
function fieldCodeOfVKind(k: VKind): i32 {
  // Exhaustive over `VKind` and `_`-less: `-2` is the vocabulary declining, a real answer the
  // caller reads, so a new kind has to say whether it has a code rather than inherit one.
  match k {
    "i32" => {
      return FC_I32
    }
    "str" => {
      return FC_STR
    }
    "list" | "reflist" | "strlist" | "f64list" | "i64list" | "f32list" => {
      // A non-null list's code is the list vocabulary's own; `u8list` and the nullable lists
      // stay outside this one, below.
      return fieldCodeOfListRep(k)
    }
    "closure" => {
      return FC_CLOSURE
    }
    "union" => {
      return FC_UNION
    }
    "f64" => {
      return FC_F64
    }
    "nulclosure" => {
      return FC_NUL_CLOSURE
    }
    "i64" => {
      return FC_I64
    }
    "f32" => {
      return FC_F32
    }
    "struct" | "map" | "variant" | "nulvariant" | "nulstruct" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {
      // Outside this vocabulary: `-2` hands the question to the spelling ladder, which is
      // what the caller's domain gate expects.
      return -2
    }
  }
}

// The descriptor's field code for `ty`, or -2 where it declines or names a kind outside this
// vocabulary. Asked only from inside a DOMAIN gate below, never as the opening rung: letting
// it answer where the ladder declines widens the domain, which costs 8 modules (§6.4).
function fieldCodeOfDesc(ty: i32): i32 {
  const d = repOfTy(ty)
  if d.rdCovered == 0 { return -2 }
  fieldCodeOfVKind(d.rdKind)
}

// The field code for arena type `ty`, or `-2` meaning "the spelling ladder owns the rest".
// Every arm below is a DOMAIN gate — which shapes this vocabulary speaks for — and the code
// it hands back is the descriptor's, through the one translation above.
export function fieldCodeOfTy(ty: i32): i32 {
  if ty < 0 { return -2 }
  // The registration split the two ladders beside this one make: a registered literal-union
  // alias reps as the interned atom, an unregistered inline set as a string ref. Alias-ness
  // is checker metadata rather than structure, so the descriptor declines all three.
  if tyIsLitUnionAlias(ty) { return FC_I32 }
  if tyIsLitUnion(ty) { return FC_STR }
  if tyIsLitUnionArray(ty) { return FC_I32_LIST }
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less. The two predicates outside it stay outside: the
  // litunion trio above is checker metadata, and `isValueUnionTyOr` below is the box arm every
  // falling-through kind still reaches, which is why `TyUnion` here is an empty arm.
  match t {
    TyPrim => {
      // `void` is the one prim the descriptor reps (as the ladder fallthrough `i32`) and this
      // vocabulary never has: a void field has no storage.
      if t.primName == "void" { return -2 }
      return fieldCodeOfDesc(ty)
    }
    TyNullable => {
      // Order matters, mirroring the text ladder: a nullable closure is the nullable fat-pointer
      // 22, tested before the bare arrow (closure rep 14).
      if t.nInner >= 0 {
        const inner = tyAt(t.nInner)
        if inner is TyFunc { return fieldCodeOfDesc(ty) }
      }
    }
    // A tagged set's field holds its i32 id.
    TyFunc => {
      if fnTagTyIsTagged(ty) { return FC_I32 }
      return fieldCodeOfDesc(ty)
    }
    TyArray => {
      // The array arm mirrors `fieldCodeOfSpelling`'s `scalarListRepOfName` ladder, deliberately
      // narrower: an unrecognised element stays uncoded (-2) and falls through to the render,
      // rather than a blanket 5. No `TyObj` arm for the array ITSELF: the spelling ladder's
      // declaration scan lets a forward reference tie into the shared rec group.
      const e = t.aElem
      if e >= 0 {
        const et = tyAt(e)
        // Exhaustive over `Ty` and `_`-less: code 5 names struct/union/closure elements only. A
        // nested list and a map-element list are ref lists too; a NULLABLE element stays out,
        // since coding it 5 would mis-code the wrapper and trap on an out-of-bounds index (B171).
        match et {
          TyPrim => {
            return fieldCodeOfDesc(ty)
          }
          TyObj => {
            return FC_REF_LIST
          }
          TyUnion => {
            return FC_REF_LIST
          }
          // A tagged set's element is its i32 id.
          TyFunc => {
            if fnTagTyIsTagged(e) { return fieldCodeOfDesc(ty) }
            return FC_REF_LIST
          }
          TyArray => {
            return FC_REF_LIST
          }
          TyMap => {
            return FC_REF_LIST
          }
          TyErr | TyNullable | TyVar | TyLit | TyNeg => {
            // Not an element the code vocabulary names; falls to the render.
          }
        }
      }
    }
    TyUnion => {
      // A union carrying a closure member is a value union (the box), not a closure field, so
      // this arm falls through to `isValueUnionTyOr` below, as it should.
    }
    TyErr | TyObj | TyMap | TyVar | TyLit | TyNeg => {
      // No arena field code of its own; the box arm and the render answer.
    }
  }
  // A value union is the box, code 16 — the arm the name ladder states as
  // `isValueUnionName(t)`. Placed last so every arm the arena already claims still wins.
  // `isValueUnionTyOr` declines rather than guess, so a literal union (`TyLit` members,
  // answering 0) can never be claimed as a box.
  if isValueUnionTyOr(ty) == 1 { return FC_UNION }
  -2
}

// The registry slot of generic-alias base `name`, or -1.
export function gaeIndexOf(name: string) { strListIndexOf(gaeBases, name) }
