import { tyIsVariantMember } from "./check_node_tys"

// `emit_field_codes.vl` — the field code a type, value kind or match spelling
// lowers to, and the shape fields it parses.

import { fnTagTyIsTagged } from "./check_elab_cap"
import { inferRetTyIxByNode } from "./check_infer_ret"
import { isValueUnionTyOr } from "./check_ty_rep"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  litUnionAliasNameOfTy,
  numLitUnionBaseTy,
  structNameOfTy,
  tyArrayElemIx,
  tyAt,
  tyIsLitUnion,
  tyIsLitUnionAlias,
  tyIsLitUnionArray,
  tySame,
} from "./check_types"
import { code0KindOf, sScanLim, structIndexOfTy } from "./emit_atom_kinds"
import { nameIsShapeSpanEnds, tyGroupWrapsWhole } from "./emit_base"
import { recNarrowRecordOf } from "./check_bind_adopt"
import { rowFieldCode0Kind } from "./emit_join_records"
import { fieldCodeOfListRep } from "./emit_list_rep"
import { isStructOfTy, mvValLowersTy } from "./emit_mv_slots"
import {
  MV_ARM_NOHINT,
  repOfTy,
  repRowOfTyStruct,
  repVariantShapeRowOf,
} from "./emit_rep"
import {
  FC_CLOSURE,
  FC_F32,
  FC_F64,
  FC_I32,
  FC_I32_LIST,
  FC_I64,
  FC_MAP,
  FC_NUL_CLOSURE,
  FC_REF_LIST,
  FC_STR,
  FC_STRUCT,
  FC_UNION,
  VKind,
  fRetKind,
  fRetStructIdx,
  fnStmts,
  sFieldCount,
  sFieldNames,
  sFieldStart,
  sTyIx,
  uVarTyIx,
  uVariants,
} from "./emit_state"
import {
  fieldNameOf,
  fieldTypeTextOf,
  groupInnerOf,
  nameIsShapeOpen,
  nameStripSpaces,
  tyTopLevelSplit,
} from "./tyname"
import { tyEmitPrimOf } from "./tyquery"

// True if `name` is a single inline struct shape spanning the whole string (`{f: i32}`) —
// its first `{`'s matching `}` is the last char, and it isn't a map spelling (`{[`). The
// brace-only alphabet is safe against `<`/`>` but not a quoted literal member
// (`{v: "a}b"}` closes the group early), so `tyGroupWrapsWhole` is quote-aware instead.
export function nameIsWholeSpanShape(name: string) {
  // The endpoint span alone (`nameIsShapeSpanEnds`) is a wider test that a composite
  // union name like `{a:{b:i32}}|{c:i32}` also passes; the walk here is strictly tighter.
  if !nameIsShapeSpanEnds(name) { return false }
  tyGroupWrapsWhole(name)
}

// Whether record `ty` is stored at a struct row: its own, one of its storage key, or that of the
// one declared record it is narrower than. This decides only the code (15, "a nested struct"),
// never which row.
function tyHasStructRowShallow(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length || !(tyAt(ty) is TyObj) { return false }
  if structIndexOfTy(ty) >= 0 || repRowOfTyStruct(ty, sScanLim()) >= 0 {
    return true
  }
  const nr = recNarrowRecordOf(ty)
  nr >= 0 && (structIndexOfTy(nr) >= 0 || repRowOfTyStruct(nr, sScanLim()) >= 0)
}

// `fieldCodeOfTy` for the matcher only (D-MATCHCODE): `fieldCodeOfTy` serves two
// consumers — the matcher below, which only compares a code, and `nameFieldCodeTy`, which
// feeds the path that records `sFieldTypes`. Code 15 is a two-part answer (code plus an
// element name), so widening it there would leave `refSlot` unresolved; widening only here doesn't.
export function fieldCodeForMatch(ty: i32): i32 {
  const c = fieldCodeOfTy(ty)
  if c != -2 { return c }
  if ty < 0 { return -2 }
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less: a new arena variant with a match field code must name
  // it here rather than take the `-2` and fall to the spelling ladder.
  match t {
    TyObj => {
      if isStructOfTy(ty) { return FC_STRUCT }
      if tyHasStructRowShallow(ty) { return FC_STRUCT }
    }
    TyNullable => {
      if isStructOfTy(t.nInner) { return FC_STRUCT }
      if tyHasStructRowShallow(t.nInner) { return FC_STRUCT }
    }
    TyMap => {
      // A map-typed field is code 19, gated identically to the spelling ladder
      // (`mvValLowersTy`): a map whose value the classifier can't lower keeps failing loudly.
      if mvValLowersTy(t.mVal) == 1 { return FC_MAP }
    }
    TyPrim | TyErr | TyFunc | TyUnion | TyArray | TyVar | TyLit | TyNeg => {
      // No match field code of its own; the spelling ladder answers.
    }
  }
  -2
}

// Whether every field of record type `ty` whose type is a code-0 kind (`i32` or `boolean`) has
// that same kind in row `si`'s own type; true where `ty` is no record, `si` no row, or a row
// field's type is unknown or a hole.
export function code0FieldsFitRow(ty: i32, si: i32): boolean {
  if si < 0 || si >= sTyIx.length || ty < 0 || ty >= T.tys.length { return true }
  const t = tyAt(ty)
  if !(t is TyObj) { return true }
  let k = 0
  while k < t.objFieldNames.length && k < t.objFieldTypes.length {
    const tk = code0KindOf(t.objFieldTypes[k])
    if tk != 0 {
      const rk = rowFieldCode0Kind(si, t.objFieldNames[k])
      if rk != 0 && rk != tk { return false }
    }
    k = k + 1
  }
  true
}

// Whether no field of row `p` is `i32` in one of rows `p` and `c` and `boolean` in the other.
// The two share a layout, so a supertype edge would validate while relating two records the
// checker keeps apart; a call pinned to either then reads the other's row (D3693).
export function rowBoolI32Agree(p: i32, c: i32): boolean {
  if p < 0 || p >= sFieldCount.length { return true }
  let k = 0
  while k < sFieldCount[p] {
    const nm = sFieldNames[sFieldStart[p] + k]
    const pk = rowFieldCode0Kind(p, nm)
    const ck = rowFieldCode0Kind(c, nm)
    if (pk == 1 && ck == 2) || (pk == 2 && ck == 1) { return false }
    k = k + 1
  }
  true
}

// Parse a canonical inline shape name `{a:T,b:U}` into parallel field-name / field-type
// string lists. A non-`{…}` name appends nothing. Shared by the variant/struct field-set
// resolvers so a field-name match can be tightened with a field-type check. A part with no
// `:` keeps the whole part as the field name.
export function shapeFieldParse(
  name: string,
  outNames: string[],
  outTypes: string[],
) {
  if nameIsShapeOpen(name) {
    const flat = nameStripSpaces(name)
    const parts: string[] = []
    // The group-interior cut (`groupInnerOf`) runs on the despaced name, so a hypothetical
    // `"{ "` reaches here as `flat == "{"` — `.slice` clamps, so the answer stays "".
    tyTopLevelSplit(groupInnerOf(flat), ',', false, parts)
    let k = 0
    while k < parts.length {
      const part = parts[k]
      const ci = part.indexOf(":")
      if ci < 0 {
        outNames.push(part)
        outTypes.push("")
      } else {
        // The field-colon cut (`fieldNameOf`/`fieldTypeTextOf`). The `ci < 0` guard above
        // keeps the whole part as the field name, unlike siblings that gate `ci <= 0`.
        outNames.push(fieldNameOf(part, ci))
        outTypes.push(fieldTypeTextOf(part, ci))
      }
      k = k + 1
    }
  }
}

// The arm whose own type renders as the record `ty` does — the arm recorded at that record
// itself, else the first with its fields in its order, each spelled alike; -1 for none.
export function variantRowOfOwnRenderTy(tyIn: i32): i32 {
  const ty = jrOneRecordOf(tyIn)
  if ty < 0 { return -1 }
  variantRowOwnRender(ty, -1)
}

// The inline arm an anonymous record `ty` is: an arm with no declared name whose type is the
// same type, which an inline annotation of that arm reaches by shape (D4638). A declared record,
// or a declared arm of its layout, is not this arm. -1 for none.
function anonArmRowOfTy(ty: i32): i32 {
  if structNameOfTy(ty) != "" { return -1 }
  const r = jrOneRecordOf(ty)
  if r < 0 { return -1 }
  variantRowOwnRender(r, ty)
}

// The arm a map value of type `ty` is, or holds through map hops: the arm recorded at the type,
// else the inline arm an anonymous record is (`anonArmRowOfTy`). -1 for none.
export function mvArmSigOfShapeTy(ty: i32, depth: i32): i32 {
  if ty < 0 || depth <= 0 || ty >= T.tys.length { return -1 }
  const v = repVariantShapeRowOf(ty)
  if v >= 0 { return v }
  const an = anonArmRowOfTy(ty)
  if an >= 0 { return an }
  const t = tyAt(ty)
  if t is TyMap { return mvArmSigOfShapeTy(t.mVal, depth - 1) }
  -1
}

// The mv slot find's arm hint for a value of type `ty`: `MV_ARM_NOHINT` with no type, else the
// arm the mint records for it (`mvArmSigOfShapeTy`), or -1 for a type reaching no arm.
export function mvArmHintOfShapeTy(ty: i32): i32 {
  if ty < 0 { return MV_ARM_NOHINT }
  mvArmSigOfShapeTy(ty, 8)
}

// The one arm scan both keys share: the first arm that is the record `ty` or has its fields in
// its order, each spelled alike. `anonOf` >= 0 keeps only an arm with no declared name that is
// that same type. -1 for none.
function variantRowOwnRender(ty: i32, anonOf: i32): i32 {
  if ty < 0 { return -1 }
  let vi = 0
  while vi < uVariants.length {
    if vi < uVarTyIx.length && uVarTyIx[vi] >= 0 {
      const a = uVarTyIx[vi]
      if (
        (a == ty || jrSameFieldSeq(a, ty, 0))
        && (anonOf < 0 || (structNameOfTy(a) == "" && tySame(a, anonOf)))
      ) {
        return vi
      }
    }
    vi = vi + 1
  }
  -1
}

// The record `ty` renders as: itself, or the first member of a union whose members are all
// records spelled alike, which the render dedups to one; -1 for anything else.
function jrOneRecordOf(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  if t is TyObj { return ty }
  if !(t is TyUnion) { return -1 }
  const ms = t.uMembers
  if ms.length == 0 { return -1 }
  const m0 = ms[0]
  if m0 < 0 || !(tyAt(m0) is TyObj) { return -1 }
  for m in ms {
    if m < 0 || !(tyAt(m) is TyObj) { return -1 }
    if !jrSpelledAlike(m, m0, 0) { return -1 }
  }
  m0
}

// Whether records `a` and `b` have the same fields in the same order, each spelled alike.
function jrSameFieldSeq(a: i32, b: i32, depth: i32): boolean {
  if a < 0 || a >= T.tys.length || b < 0 || b >= T.tys.length { return false }
  const ta = tyAt(a)
  const tb = tyAt(b)
  if ta is TyObj {
    if tb is TyObj {
      const na = ta.objFieldNames
      const nb = tb.objFieldNames
      if na.length != nb.length { return false }
      let k = 0
      while k < na.length {
        if na[k] != nb[k] { return false }
        if (
          !jrSpelledAlike(ta.objFieldTypes[k], tb.objFieldTypes[k], depth + 1)
        ) {
          return false
        }
        k = k + 1
      }
      return true
    }
  }
  false
}

// Whether field types `a` and `b` render alike: one literal-union alias, one primitive (a
// literal spells its base), or the same shape all the way down.
function jrSpelledAlike(a: i32, b: i32, depth: i32): boolean {
  if a == b { return true }
  if depth > 8 || a < 0 || b < 0 { return false }
  if litUnionAliasNameOfTy(a) != litUnionAliasNameOfTy(b) { return false }
  const pa = tyEmitPrimOf(a)
  const pb = tyEmitPrimOf(b)
  if pa != null || pb != null { return pa == pb }
  if tySame(a, b) { return true }
  const ta = tyAt(a)
  const tb = tyAt(b)
  // Exhaustive over `Ty` and `_`-less: only a shape, a list or a nullable spells its parts.
  match ta {
    TyObj => {
      return jrSameFieldSeq(a, b, depth + 1)
    }
    TyArray => {
      const eb = tyArrayElemIx(b)
      return eb >= 0 && jrSpelledAlike(ta.aElem, eb, depth + 1)
    }
    TyNullable => {
      if tb is TyNullable {
        return jrSpelledAlike(ta.nInner, tb.nInner, depth + 1)
      }
    }
    TyPrim | TyErr | TyUnion | TyVar | TyLit | TyNeg | TyFunc | TyMap => {
      // Spelled alike only as the same type, which `tySame` above already answered.
    }
  }
  false
}

// The union-variant index a lifted callback `fe` returns when it collapses to a single
// variant (`(a) => if a is Cat { a } else { catShape }`), read from the checker's recorded
// node-keyed return shape, or -1. Lets `.map`/`.filter` classify the result as the variant
// ref list, rather than widening the narrowed receiver back to the box.
export function cbRetVariantIdx(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const rt = inferRetTyIxByNode(fnStmts[fe])
  let vi = repVariantShapeRowOf(rt)
  if vi < 0 {
    const nr = recNarrowRecordOf(rt)
    if nr >= 0 { vi = repVariantShapeRowOf(nr) }
  }
  if vi < 0 { return -1 }
  // A lambda whose inferred return the checker classified as a plain struct must not
  // collapse to a variant merely because its anonymous shape coincides with an unrelated
  // sibling field's union arm: its `$fnsig` result must key the struct token, not the
  // variant one. A return typed as a declared arm is always a genuine collapse.
  if fe < fRetKind.length {
    if !tyIsVariantMember(rt) {
      const k = fRetKind[fe]
      if (k == "struct" || k == "nulstruct") && fRetStructIdx[fe] >= 0 {
        return -1
      }
    }
  }
  vi
}

// ── the field-code classifier's arena rung ──
// The one translation from `VKind` into the field-code vocabulary, so the fourteen constants
// live here rather than at fourteen arms. `-2` is the vocabulary's decline — a kind it does
// not name, never a code.
function fieldCodeOfVKind(k: VKind): i32 {
  // Exhaustive over `VKind` and `_`-less: `-2` is the vocabulary declining, a real answer the
  // caller reads, so a new kind has to say whether it has a code rather than inherit one.
  match k {
    "i32" => {
      return FC_I32
    }
    "str" => {
      return FC_STR
    }
    "list" | "reflist" | "strlist" | "f64list" | "i64list" | "f32list" => {
      // A non-null list's code is the list vocabulary's own; `u8list` and the nullable lists
      // stay outside this one, below.
      return fieldCodeOfListRep(k)
    }
    "closure" => {
      return FC_CLOSURE
    }
    "union" => {
      return FC_UNION
    }
    "f64" => {
      return FC_F64
    }
    "nulclosure" => {
      return FC_NUL_CLOSURE
    }
    "i64" => {
      return FC_I64
    }
    "f32" => {
      return FC_F32
    }
    "struct" | "map" | "variant" | "nulvariant" | "nulstruct" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {
      // Outside this vocabulary: `-2` hands the question to the spelling ladder, which is
      // what the caller's domain gate expects.
      return -2
    }
  }
}

// The descriptor's field code for `ty`, or -2 where it declines or names a kind outside this
// vocabulary. Asked only from inside a DOMAIN gate below, never as the opening rung: letting
// it answer where the ladder declines widens the domain, which costs 8 modules (§6.4).
function fieldCodeOfDesc(ty: i32): i32 {
  const d = repOfTy(ty)
  if d.rdCovered == 0 { return -2 }
  fieldCodeOfVKind(d.rdKind)
}

// The field code for arena type `ty`, or `-2` meaning "the spelling ladder owns the rest".
// Every arm below is a DOMAIN gate — which shapes this vocabulary speaks for — and the code
// it hands back is the descriptor's, through the one translation above.
export function fieldCodeOfTy(ty: i32): i32 {
  if ty < 0 { return -2 }
  // The registration split the two ladders beside this one make: a registered literal-union
  // alias reps as the interned atom, an unregistered inline set as a string ref. Alias-ness
  // is checker metadata rather than structure, so the descriptor declines all three.
  if tyIsLitUnionAlias(ty) { return FC_I32 }
  if tyIsLitUnion(ty) { return FC_STR }
  if tyIsLitUnionArray(ty) { return FC_I32_LIST }
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less. The two predicates outside it stay outside: the
  // litunion trio above is checker metadata, and `isValueUnionTyOr` below is the box arm every
  // falling-through kind still reaches, which is why `TyUnion` here is an empty arm.
  match t {
    TyPrim => {
      // `void` is the one prim the descriptor reps (as the ladder fallthrough `i32`) and this
      // vocabulary never has: a void field has no storage.
      if t.primName == "void" { return -2 }
      return fieldCodeOfDesc(ty)
    }
    TyNullable => {
      // Order matters, mirroring the text ladder: a nullable closure is the nullable fat-pointer
      // 22, tested before the bare arrow (closure rep 14).
      if t.nInner >= 0 {
        const inner = tyAt(t.nInner)
        if inner is TyFunc { return fieldCodeOfDesc(ty) }
      }
    }
    // A tagged set's field holds its i32 id.
    TyFunc => {
      if fnTagTyIsTagged(ty) { return FC_I32 }
      return fieldCodeOfDesc(ty)
    }
    TyArray => {
      // The array arm mirrors `nameFieldCodeTy`'s scalar-list arm, deliberately
      // narrower: an unrecognised element stays uncoded (-2) and falls through to the render,
      // rather than a blanket 5. No `TyObj` arm for the array ITSELF: the spelling ladder's
      // declaration scan lets a forward reference tie into the shared rec group.
      const e = t.aElem
      if e >= 0 {
        const et = tyAt(e)
        // Exhaustive over `Ty` and `_`-less: code 5 names struct/union/closure elements only. A
        // nested list and a map-element list are ref lists too; a NULLABLE element stays out,
        // since coding it 5 would mis-code the wrapper and trap on an out-of-bounds index (B171).
        match et {
          TyPrim => {
            return fieldCodeOfDesc(ty)
          }
          TyObj => {
            return FC_REF_LIST
          }
          TyUnion => {
            // A numeric literal union's list stores its base scalar, as the union itself does.
            const nb = numLitUnionBaseTy(e)
            if nb >= 0 && nb != e { return fieldCodeOfDesc(ty) }
            return FC_REF_LIST
          }
          // A tagged set's element is its i32 id.
          TyFunc => {
            if fnTagTyIsTagged(e) { return fieldCodeOfDesc(ty) }
            return FC_REF_LIST
          }
          TyArray => {
            return FC_REF_LIST
          }
          TyMap => {
            return FC_REF_LIST
          }
          TyErr | TyNullable | TyVar | TyLit | TyNeg => {
            // Not an element the code vocabulary names; falls to the render.
          }
        }
      }
    }
    TyUnion => {
      // A union carrying a closure member is a value union (the box), not a closure field, so
      // this arm falls through to `isValueUnionTyOr` below, as it should.
    }
    TyErr | TyObj | TyMap | TyVar | TyLit | TyNeg => {
      // No arena field code of its own; the box arm and the render answer.
    }
  }
  // A numeric literal union stores its base scalar, as its type reps (`one-literal-union-rep`).
  if tyAt(ty) is TyUnion {
    const nb = numLitUnionBaseTy(ty)
    if nb >= 0 && nb != ty { return fieldCodeOfTy(nb) }
  }
  // A value union is the box, code 16 — the arm the name ladder states as
  // `isValueUnionName(t)`. Placed last so every arm the arena already claims still wins.
  // `isValueUnionTyOr` declines rather than guess, so a literal union (`TyLit` members,
  // answering 0) can never be claimed as a box.
  if isValueUnionTyOr(ty) == 1 { return FC_UNION }
  -2
}
