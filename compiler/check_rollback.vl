const RB_DIAGS = 1
const RB_ARG = 2
const RB_NEST = 4
const RB_RET = 8
const RB_LET = 16
const RB_BM = 32
const RB_MEM = 64
const RB_UFCS = 128
const RB_IS = 256
const RB_BIN = 512
const RB_PRINT = 1024
const RB_ESC_JOIN = 2048
const RB_COAL_HOLE = 4096

// `tpIf*` and `tpIfRe*`; the latter's `Names`/`Tys` are spans `tpIfReStart` indexes, not rows.
const RB_TP_IF = 8192
const RB_CALLEE_WRITE = 16384
const RB_DJOIN = 32768
const RB_HOLE_FLOW = 65536

// `holeShape*`, `holeArrayDemand`, `holeMap*`, `holeAlt*` and `mintFact*`.
const RB_HOLES = 131072

// `inferRet*`, `inferStack` and `inferTentative`.
const RB_INFER = 262144

// The lint-note tables: `redun*`, `rcoal*` and `isval*`.
export const RB_LINT = 524288
const RB_TP_ENV = 1048576

// `inferLet*`: the un-annotated bindings' value-union and niche rows.
const RB_INFER_LET = 2097152

// The per-site sets, each the sum of its bits. "Every constraint family" is arg, nest, ret, let,
// bm, mem, ufcs, is, bin and print.
// `cstrProbeBefore` keeps the constraint rows it exists to record (D3062): diagnostics, lint
// notes, holes and dJoin.
export const RB_CSTR_PROBE = 688129

// `inferReturnsPrePass` keeps the inferred returns, which are what it is for: diagnostics, lint
// notes, every constraint family, holes, dJoin, coalHole, tpIf and inferLet.
export const RB_RETURNS = 2799615

// `globalInitPrePass`: `RB_RETURNS` bar diagnostics, which it drops per initializer, and inferLet.
export const RB_GLOBAL_INIT = 702462

// `solveUnannotParams` reads holeFlow before rolling back: diagnostics, lint notes, every
// constraint family but nest, holes, holeFlow, dJoin and coalHole.
export const RB_SOLVE = 759803

// `monoRecheckBegin`/`End`: diagnostics, lint notes, every constraint family but nest, holes,
// infer, inferLet, tpEnv and calleeWrite.
export const RB_MONO = 4081659

// The per-node banks a re-check overwrites and the emitter reads by node: `asgNarTyIx`,
// `asgTvWrite`, `lpValTy` and `holeTpJoinNames`. Only an elaboration puts them back.
const RB_NODE_BANKS = 4194304

// Every family: an elaboration leaves no row behind (`elabOne`).
export const RB_ALL = 8388607

// `tpIfRecheck` around its re-check: every constraint family, escJoin, coalHole, tpIf and
// calleeWrite.
export const RB_PINNED = 32766

// Every rollback-able table's length, by family; a family's mark is its keyed column's length, and
// `undo` is the keyed maps' undo-log row (`check_map_undo`).
export type CheckMark = {
  diags: i32,
  argC: i32,
  nestC: i32,
  retC: i32,
  letC: i32,
  bmC: i32,
  memC: i32,
  ufcsC: i32,
  isC: i32,
  binC: i32,
  printC: i32,
  escJoin: i32,
  coalHole: i32,
  tpIf: i32,
  tpIfRe: i32,
  calleeWrite: i32,
  dJoin: i32,
  holeFlow: i32,
  holeShapeNames: i32,
  holeShapeTys: i32,
  holeArrayDemand: i32,
  holeMap: i32,
  holeAlt: i32,
  inferLet: i32,
  inferLetNulStr: i32,
  inferLetNulBool: i32,
  inferRet: i32,
  inferStack: i32,
  inferTentative: i32,
  redun: i32,
  rcoal: i32,
  isval: i32,
  tpEnv: i32,
  holeTpJoin: i32,
  mintFact: i32,
  undo: i32,
}

export function checkMark(): CheckMark {
  {
    diags: T.diags.length,
    argC: argCstr.at.length,
    nestC: nestCstr.ty.length,
    retC: retCstr.got.length,
    letC: letCstr.got.length,
    bmC: bmCstr.got.length,
    memC: memCstr.ty.length,
    ufcsC: ufcsCstr.ty.length,
    isC: isCstr.ty.length,
    binC: binCstr.op.length,
    printC: printCstr.ty.length,
    escJoin: escJoinTy.length,
    coalHole: coalHoleTy.length,
    tpIf: tpIfFn.length,
    tpIfRe: tpIfReFn.length,
    calleeWrite: calleeWriteRow.length,
    dJoin: dJoinNode.length,
    holeFlow: holeFlowSrc.length,
    holeShapeNames: holeShapeNames.length,
    holeShapeTys: holeShapeTys.length,
    holeArrayDemand: holeArrayDemand.length,
    holeMap: holeMapNames.length,
    holeAlt: holeAltNames.length,
    inferLet: inferLetIx.length,
    inferLetNulStr: inferLetNulStrIx.length,
    inferLetNulBool: inferLetNulBoolIx.length,
    inferRet: inferRetFn.length,
    inferStack: inferStack.length,
    inferTentative: inferTentative.length,
    redun: redun.name.length,
    rcoal: rcoal.tok.length,
    isval: isvalTok.length,
    tpEnv: tpEnvNames.length,
    holeTpJoin: holeTpJoinLog.length,
    mintFact: mintFactCount(),
    undo: undoOpen(),
  }
}

// Truncates each family in `set` back to its length in `m`; every site puts back `tpIfOkAt`.
export function checkRollback(m: CheckMark, set: i32) {
  if (set & RB_TP_ENV) != 0 { tpEnvTruncate(m.tpEnv) }
  if (set & RB_HOLES) != 0 {
    holeRowsTruncate(
      m.holeShapeNames,
      m.holeShapeTys,
      m.holeArrayDemand,
      m.holeMap,
      m.holeAlt,
    )
    mintFactsTruncate(m.mintFact)
  }
  if (set & RB_BIN) != 0 { binCstrTruncate(m.binC) }
  if (set & RB_ARG) != 0 { argCstrTruncate(m.argC) }
  if (set & RB_PRINT) != 0 { tyIxCstrTruncate(printCstr, m.printC) }
  if (set & RB_NEST) != 0 { tyIxCstrTruncate(nestCstr, m.nestC) }
  if (set & RB_IS) != 0 { isCstrTruncate(m.isC) }
  if (set & RB_RET) != 0 { retCstrTruncate(m.retC) }
  if (set & RB_LET) != 0 { letCstrTruncate(m.letC) }
  if (set & RB_BM) != 0 { bmCstrTruncate(m.bmC) }
  if (set & RB_MEM) != 0 { memCstrTruncate(m.memC) }
  if (set & RB_UFCS) != 0 { ufcsCstrTruncate(m.ufcsC) }
  if (set & RB_ESC_JOIN) != 0 { escJoinTruncate(m.escJoin) }
  if (set & RB_COAL_HOLE) != 0 { coalHoleTruncate(m.coalHole) }
  if (set & RB_TP_IF) != 0 { tpIfTruncate(m.tpIf, m.tpIfRe, m.undo) }
  if (set & RB_CALLEE_WRITE) != 0 { calleeWriteTruncate(m.calleeWrite) }
  if (set & RB_DJOIN) != 0 { dJoinTruncate(m.dJoin, m.undo) }
  if (set & RB_HOLE_FLOW) != 0 { holeFlowTruncate(m.holeFlow) }
  if (set & RB_INFER_LET) != 0 {
    inferLetTruncate(m.inferLet, m.inferLetNulStr, m.inferLetNulBool)
  }
  if (set & RB_INFER) != 0 {
    inferRetTruncate(m.inferRet, m.inferStack, m.inferTentative)
  }
  if (set & RB_LINT) != 0 {
    redunTruncate(m.redun)
    rcoalTruncate(m.rcoal)
    isvalTruncate(m.isval)
  }
  if (set & RB_DIAGS) != 0 {
    while T.diags.length > m.diags { T.diags.pop() }
    numLitNotesDropFrom(m.diags)
  }
  if (set & RB_NODE_BANKS) != 0 {
    asgBanksUndo(m.undo)
    lpValTyUndo(m.undo)
    holeTpJoinTruncate(m.holeTpJoin)
  }
  tpIfOkAtUndo(m.undo)
  undoClose()
  0
}

