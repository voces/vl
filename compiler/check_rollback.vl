  argCstr,
  argCstrTruncate,
  binCstr,
  binCstrTruncate,
  bmCstr,
  bmCstrTruncate,
  isCstr,
  isCstrTruncate,
  letCstr,
  letCstrTruncate,
  memCstr,
  memCstrTruncate,
  nestCstr,
