  "nlnDecl", "nlnUse", "nlnSlot", "nlnWant", "nlnAnn", "nlnLeaf", "nlnLeafTy",
  "njFnStack", "cstrOwnerStack", "tpIfJoinAt", "tpIfOkAt", "dJoinRelayed",
  "mintFactScope",
]

// The current length of each `PRB_TABLES` entry, in that order.
function prbLens(): i32[] {
  [
    T.diags.length,
    argCstr.at.length,
    argCstr.exp.length,
    argCstr.who.length,
    argCstr.fn.length,
    argCstr.node.length,
    argCstr.form.length,
    argCstr.call.length,
    nestCstr.ty.length,
    nestCstr.ix.length,
    nestCstr.fn.length,
    calleeWriteRow.length,
    calleeWriteGot.length,
    calleeWriteAt.length,
    isCstr.ty.length,
    isCstr.chk.length,
    isCstr.name.length,
    isCstr.ix.length,
    isCstr.fn.length,
    retCstr.got.length,
    retCstr.want.length,
    retCstr.ix.length,
    retCstr.fn.length,
    retCstr.wOnly.length,
    letCstr.got.length,
    letCstr.want.length,
    letCstr.ix.length,
    letCstr.fn.length,
    letCstr.name.length,
    letCstr.seq.length,
    bmCstr.got.length,
    bmCstr.want.length,
    bmCstr.ctx.length,
    bmCstr.ix.length,
    bmCstr.fn.length,
    bmCstr.form.length,
    bmCstr.label.length,
    bmCstr.seq.length,
    memCstr.ty.length,
    memCstr.prop.length,
    memCstr.ix.length,
    memCstr.fn.length,
    memCstr.dem.length,
    ufcsCstr.ty.length,
    ufcsCstr.prop.length,
    ufcsCstr.ix.length,
    ufcsCstr.fn.length,
    ufcsCstr.p0.length,
    ufcsCstr.more.length,
    escJoinTy.length,
    escJoinIx.length,
    escJoinWho.length,
    escJoinFn.length,
    coalHoleTy.length,
    coalHoleFn.length,
    tpIfFn.length,
    tpIfJoin.length,
    tpIfNode.length,
    tpIfOk.length,
    tpIfReFn.length,
    tpIfReOwner.length,
    tpIfReStart.length,
    tpIfReCount.length,
    tpIfReNames.length,
    tpIfReTys.length,
    tpIfReParams.length,
    binCstr.op.length,
    binCstr.lt.length,
    binCstr.rt.length,
    binCstr.fn.length,
    binCstr.node.length,
    binCstr.shape.length,
    printCstr.ty.length,
    printCstr.ix.length,
    printCstr.fn.length,
    dJoinNode.length,
    dJoinTy.length,
    holeFlowSrc.length,
    holeFlowDst.length,
    holeShapeNames.length,
    holeShapeTys.length,
    holeArrayDemand.length,
    holeMapNames.length,
    holeMapTys.length,
    holeAltNames.length,
    holeAltTys.length,
    holeAltPreN.length,
    holeAltTailN.length,
    holeAltHoleIx.length,
    inferLetIx.length,
    inferLetTy.length,
    inferLetNulStrIx.length,
    inferLetNulBoolIx.length,
    inferRetFn.length,
    inferRetTy.length,
    inferRetTyIx.length,
    inferRetAtomCount.length,
    inferRetRung.length,
    inferRetLogTy.length,
    inferRetLogSeed.length,
    inferRetLogLit.length,
    inferStack.length,
    inferTentative.length,
    tpEnvNames.length,
    tpEnvTys.length,
    redun.sLine.length,
    redun.sCol.length,
    redun.eLine.length,
    redun.eCol.length,
    redun.name.length,
    redun.ty.length,
    redun.tok.length,
    redun.ret.length,
    rcoal.line.length,
    rcoal.col.length,
    rcoal.end.length,
    rcoal.tok.length,
    rcoal.ty.length,
    rcoal.msg.length,
    rcoal.why.length,
    rcoal.code.length,
    isvalLine.length,
    isvalCol.length,
    isvalEnd.length,
    isvalTok.length,
    isvalName.length,
    isvalType.length,
    isvalLit.length,
    isvalMsg.length,
    nlnDiag.length,
    nlnMsg.length,
    nlnText.length,
    nlnDecl.length,
    nlnUse.length,
    nlnSlot.length,
    nlnWant.length,
    nlnAnn.length,
    nlnLeaf.length,
    nlnLeafTy.length,
    njFnStack.length,
    cstrOwnerStack.length,
    tpIfJoinAt.length,
    tpIfOkAt.length,
    dJoinRelayed.length,
    mintFactCount(),
  ]
}

// Off unless a host arms it (`probeRollbackArm`). Armed, each quiet probe marks every table's
// length on entry and counts each table whose length moved on leaving, naming which probe
// leaves which table behind.
export let prbArmed = false

// The must-fire control: 1 makes `inferReturnsPrePass` keep its quiet diagnostics.
export let prbSkip = 0
let prbMarks: i32[][] = []
let prbRowKey: string[] = []
let prbRowN: i32[] = []

// Arm (1) or disarm (0) the assertion for the compiles that follow; arming clears the rows.
export function probeRollbackArm(on: i32) {
  prbArmed = on != 0
  prbMarks = []
  prbRowKey = []
  prbRowN = []
  0
}

// Test-only: 1 skips one rollback (`prbSkip`), so a control can prove the assertion fires.
export function probeRollbackSkipSet(k: i32) {
  prbSkip = k
  0
}

export function probeRollbackRowCount() { prbRowKey.length }

export function probeRollbackRowLen(i: i32) { prbRowKey[i].length }

export function probeRollbackRowAt(i: i32, j: i32) { prbRowKey[i][j] }

export function probeRollbackRowN(i: i32) { prbRowN[i] }

function prbCount(key: string) {
  let i = 0
  while i < prbRowKey.length {
    if prbRowKey[i] == key {
      prbRowN[i] = prbRowN[i] + 1
      return 0
    }
    i = i + 1
  }
  prbRowKey.push(key)
  prbRowN.push(1)
  0
}

// A probe begins: mark every table's length. Callers test `prbArmed` first.
export function prbEnter() {
  prbMarks.push(prbLens())
  0
}

// Probe `site` has rolled back: one `site | ran` row, and one `site | table | +` (or `-`) row
// for each table whose length differs from its mark.
export function prbLeave(site: string) {
  const m = prbMarks.pop() ?? []
  prbCount(site + " | ran")
  const cur = prbLens()
  let i = 0
  while i < cur.length && i < m.length {
    if cur[i] > m[i] { prbCount(site + " | " + PRB_TABLES[i] + " | +") }
    if cur[i] < m[i] { prbCount(site + " | " + PRB_TABLES[i] + " | -") }
    i = i + 1
  }
  0
}

// What `monoRecheckBegin` saves and `monoRecheckEnd` restores: the two suppression flags and
// the tables' lengths, of which it rolls back `RB_MONO`.
export type MonoSave = { quiet: boolean, sym: i32, mark: CheckMark }
