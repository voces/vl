  "T.diags", "argCstrAt", "argCstrExp", "argCstrWho", "argCstrFn",
  "argCstrNode", "argCstrForm", "argCstrCall", "nestCstrTy", "nestCstrIx",
  "nestCstrFn", "calleeWriteRow", "calleeWriteGot", "calleeWriteAt", "isCstrTy",
  "isCstrChk", "isCstrName", "isCstrIx", "isCstrFn", "retCstrGot",
  "retCstrWant", "retCstrIx", "retCstrFn", "retCstrWOnly", "letCstrGot",
  "letCstrWant", "letCstrIx", "letCstrFn", "letCstrName", "letCstrSeq",
  "bmCstrGot", "bmCstrWant", "bmCstrCtx", "bmCstrIx", "bmCstrFn", "bmCstrForm",
  "bmCstrLabel", "bmCstrSeq", "memCstrTy", "memCstrProp", "memCstrIx",
  "memCstrFn", "memCstrDem", "ufcsCstrTy", "ufcsCstrProp", "ufcsCstrIx",
  "ufcsCstrFn", "ufcsCstrP0", "ufcsCstrMore", "escJoinTy", "escJoinIx",
  "escJoinWho", "escJoinFn", "coalHoleTy", "coalHoleFn", "tpIfFn", "tpIfJoin",
  "tpIfNode", "tpIfOk", "tpIfReFn", "tpIfReOwner", "tpIfReStart", "tpIfReCount",
  "tpIfReNames", "tpIfReTys", "tpIfReParams", "binCstrOp", "binCstrLt",
  "binCstrRt", "binCstrFn", "binCstrNode", "binCstrShape", "printCstrTy",
  "printCstrIx", "printCstrFn", "dJoinNode", "dJoinTy", "holeFlowSrc",
  "holeFlowDst", "holeShapeNames", "holeShapeTys", "holeArrayDemand",
  "holeMapNames", "holeMapTys", "holeAltNames", "holeAltTys", "holeAltPreN",
  "holeAltTailN", "holeAltHoleIx", "inferLetIx", "inferLetTy",
  "inferLetNulStrIx", "inferLetNulBoolIx", "inferRetFn", "inferRetTy",
  "inferRetTyIx", "inferRetAtomCount", "inferRetRung", "inferRetLogTy",
  "inferRetLogSeed", "inferRetLogLit", "inferStack", "inferTentative",
  "tpEnvNames", "tpEnvTys", "redunSLine", "redunSCol", "redunELine",
  "redunECol", "redunName", "redunType", "redunTok", "redunRet", "rcoalLine",
  "rcoalCol", "rcoalEnd", "rcoalTok", "rcoalType", "rcoalMsg", "rcoalWhy",
