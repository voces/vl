// Numeric join gating: which functions and calls a mixed-numeric join is held back in, and
// the literal-only joins it lets through. Emptied by `njJoinReset`.
// Does not import the checker.
import { declTyOf } from "./check_nar_store"
import {
  cexLitPeel,
  numLitAssignedValue,
  numLitCallStoresNonLit,
  numLitNameAt,
} from "./check_num_lits"
import {
  ArrayLit,
  BinExpr,
  Call,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  Member,
  NullLit,
  P,
  UnionDecl,
  arenaEpochNow,
  nodeAt,
  nodeChildren,
} from "./ast"
import { memoKeyNew, memoMoved } from "./memo"
import { splitUnionAtoms } from "./tyname"
import {
  tailPushBlockTail,
  tailPushIfArms,
  tailPushMatchArms,
  tailValueLeaves,
} from "./check_unconsumed"
import { a20RetWalk, njFnReached } from "./check_nj_gate"
import {
  T,
  TY_BOOL,
  TY_F32,
  TY_F64,
  TY_I32,
  TY_I64,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  cUserTypes,
  cUserTypesVer,
  primNameStr,
  tyAt,
  tyIsHole,
  tyMutEpoch,
  tyNameAtoms,
  tyToEmitName,
  tyVarRenames,
} from "./check_types"
import { parenPeelIx } from "./check_places"
import { cwPeel, fnDeclIx } from "./check_write_scan"
import {
  isNumericPrimTy,
  nonNullTy,
  numLitUnionHasBase,
  primNameOf,
  tyHasTyVar,
  tyHoldsNumericPrim,
} from "./tyquery"
import { nodeTyIxOf } from "./check_node_tys"
import { tyIsNumUnion } from "./check_union_mint"
import { leafIsLit } from "./check_call_retire"
import { cFillStmtIx, canonUnionKeyTextOfTy } from "./check_inline_lit_union"
import { canonUnionKeyAtomOfTy } from "./check_ty_rep"

// The function whose body is being checked, re-checked at a pin or instantiated (`njFnGated`).
export let njFnIx = -1
export function njFnIxSet(v: i32) { njFnIx = v }

export let njGateMemo: {[i32]: boolean} = Map()

// The held-back call nodes `njExprHeld` answers for.
export let njHeldNodes: {[i32]: boolean} = Map()

// The top-level statement list, captured at `checkProgram` entry so the return-inference floor
// can reverse-map an inferred struct-union's object members to named types
// (`structUnionRetName`). The floor must accept exactly the unions the emitter can lower, all
// members named, so it uses the same predicate as the export.
export let gRootStmts: i32[] = []
export function gRootStmtsSet(v: i32[]) {
  gRootStmts = v
  gRootStmtsGen = gRootStmtsGen + 1
}

// Every assignment of `gRootStmts`, which its length alone does not show.
let gRootStmtsGen = 0

// Is `ix` one of the program's own top-level statements? `gRootStmts` is the `Program` node's
// statement list, stamped at the head of `checkProgram`, so this is the exact population the
// pass-1 hoist walks rather than a scope-depth heuristic. Scanned only for an operator-named
// declaration, which is why a linear walk is the right shape.
export function isTopLevelStmt(ix: i32) {
  let i = 0
  while i < gRootStmts.length {
    if gRootStmts[i] == ix { return true }
    i = i + 1
  }
  false
}

// ── scope chain ──────────────────────────────────────────────────────────────

// ── flow narrowing (condition collectors) ────────────────────────────────────

// The subset of `names` the program can store a non-literal through: a whole-name assignment, an
// element assignment, a storing method call on a name in `lists`, or an alias (`const b = name`,
// `x = name`). The suggested annotation would refuse that store, so those notes are dropped. By
// name, so a shadowing binding counts too; one walk for every queued note.
export function numLitNamesStoredNonLit(
  names: {[string]: boolean},
  lists: {[string]: boolean},
): {[string]: boolean} {
  const out: {[string]: boolean} = Map()
  const stack: i32[] = []
  for s in gRootStmts { stack.push(s) }
  while stack.length > 0 {
    const ix = stack[stack.length - 1]
    stack.pop()
    const n = nodeAt(ix)
    let hit = ""
    if n is BinExpr {
      if n.binOp == "=" {
        const tgt = nodeAt(parenPeelIx(n.binLeft))
        let tn = numLitNameAt(n.binLeft)
        if tgt is Index { tn = numLitNameAt(tgt.idxArr) }
        if tn != "" && cexLitPeel(numLitAssignedValue(n)) < 0 { hit = tn }
        const alias = numLitNameAt(n.binRight)
        if alias != "" { out[alias] = true }
      }
    } else if n is LetDecl {
      if n.letInit >= 0 && n.letType < 0 {
        const alias = numLitNameAt(n.letInit)
        if alias != "" { out[alias] = true }
      }
    } else if n is Call {
      const cf = nodeAt(parenPeelIx(n.callFn))
      let rn = ""
      if cf is Member {
        rn = numLitNameAt(cf.memObj)
        if !numLitCallStoresNonLit(n, cf.memProp, 0) { rn = "" }
      } else if cf is Ident && n.callArgs.length > 0 {
        rn = numLitNameAt(n.callArgs[0])
        if !numLitCallStoresNonLit(n, cf.identName, 1) { rn = "" }
      }
      // A scalar is passed by value, so a call stores into a list binding only.
      if rn != "" && (lists[rn] ?? false) { hit = rn }
    }
    if hit != "" && (names[hit] ?? false) { out[hit] = true }
    for k in nodeChildren(ix) {
      if k >= 0 && k < P.nodes.length { stack.push(k) }
    }
  }
  out
}

// Whether every value the `if`, `match` or block at `ix` yields is a literal (`valueIsLitOnly`).
export function joinArmIsLit(ix: i32): boolean { valueIsLitOnly(ix) }

// Whether function `fx` joins its returns as master did, by widening: its return set holds a
// literal arm or a held-back call, or `njFnReached`. The rule's joins are kept only where every
// caller sees them; the rest are D3494 and D3495.
export function njFnGated(fx: i32): boolean {
  if fx < 0 || fx >= P.nodes.length { return false }
  const memo = njGateMemo.get(fx)
  if memo != null { return memo }
  let g = false
  // Provisional, so a cycle of returned calls reads the members not yet decided as direct.
  njGateMemo[fx] = false
  const fn = nodeAt(fx)
  if fn is FuncDecl {
    g = njFnReached(fx) || (fn.fnRet < 0 && njRetSetHeld(fn.fnBody))
  }
  njGateMemo[fx] = g
  g
}

// Whether expression `ix` is the result of a call `njFnGated` holds back, or a name bound
// only from one: its members are master's widening, so an operator, conversion or delivery the
// rule adds is refused over it, as there. A union a direct join produced is never held.
export function njExprHeld(ix: i32): boolean {
  if njHeldNodes.length == 0 { return false }
  njExprHeldAt(ix, 0)
}

function njExprHeldAt(ix: i32, depth: i32): boolean {
  if ix < 0 || ix >= P.nodes.length || depth > 4 { return false }
  const e = cwPeel(ix)
  if e < 0 || e >= P.nodes.length { return false }
  if njHeldNodes.get(e) ?? false { return true }
  const id = nodeAt(e)
  if !(id is Ident) { return false }
  // The name's declarations in the body being checked: held only when every one is.
  let root = -1
  if njFnIx >= 0 && njFnIx < P.nodes.length {
    const fn = nodeAt(njFnIx)
    if fn is FuncDecl { root = fn.fnBody }
  }
  const todo: i32[] = []
  if root >= 0 {
    todo.push(root)
  } else {
    for r in gRootStmts { todo.push(r) }
  }
  let held = false
  while todo.length > 0 {
    const at = todo.pop() ?? -1
    if at >= 0 && at < P.nodes.length {
      const n = nodeAt(at)
      if n is LetDecl {
        if n.letName == id.identName {
          if n.letKw != "const" || n.letInit < 0 { return false }
          if !njExprHeldAt(n.letInit, depth + 1) { return false }
          held = true
        }
      }
      for k in nodeChildren(at) {
        if k >= 0 { todo.push(k) }
      }
    }
  }
  held
}

// Notes call `ix` as one `njExprHeld` refuses when its callee is held back.
export function njNoteHeldCall(n: Call, ix: i32, t: i32) {
  if t < 0 || t >= T.tys.length || n.callFn < 0 { return 0 }
  const cf = nodeAt(n.callFn)
  if !(cf is Ident) { return 0 }
  const d = fnDeclIx.get(cf.identName) ?? -1
  if d < 0 { return 0 }
  // A declared return is the union the author wrote, not a join.
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || dn.fnRet >= 0 || !njFnGated(d) { return 0 }
  if !tyIsNumUnion(nonNullTy(t)) { return 0 }
  // Only a callee whose inferred return is itself a join can have mis-joined its members; one
  // that hands back an argument (`rec<T>(v: T) { … v }`) returns that argument's own type.
  const ft = nodeTyIxOf(d)
  if ft < 0 || ft >= T.tys.length { return 0 }
  const fnt = tyAt(ft)
  if !(fnt is TyFunc) { return 0 }
  const rt = nonNullTy(fnt.fnRet)
  if rt < 0 || rt >= T.tys.length || !(tyAt(rt) is TyUnion) { return 0 }
  njHeldNodes[ix] = true
  0
}

// Whether a join of `a` and `b` in the body being checked is held back: by `njFnGated` for a
// return set (`ret`), by `njFnReached` for any other.
export function njJoinGated(a: i32, b: i32, ret: boolean): boolean {
  if !njJoinMayPart(njFnIx, a, b) { return false }
  if ret { return njFnGated(njFnIx) }
  njFnReached(njFnIx)
}

// Whether a join of `a` and `b` in function `fx` could keep two numbers apart at all: both
// hold a number or a type variable, and not the same numbers alone.
export function njJoinMayPart(fx: i32, a: i32, b: i32): boolean {
  if fx < 0 || a == b { return false }
  const sa = njNumSig(a, 0)
  if sa == 0 { return false }
  const sb = njNumSig(b, 0)
  if sb == 0 { return false }
  sa != sb || sa >= 16
}

// The number types `t` holds as bits (`njNumNames` order from 1), plus 16 for a type
// variable, through unions and nullables; 0 for none.
function njNumSig(t: i32, depth: i32): i32 {
  if t < 0 || t >= T.tys.length || depth > 8 { return 0 }
  const x = nonNullTy(t)
  if x < 0 || x >= T.tys.length { return 0 }
  const u = tyAt(x)
  if u is TyUnion {
    let r = 0
    for m in u.uMembers { r = r | njNumSig(m, depth + 1) }
    return r
  }
  if tyIsHole(x) { return 16 }
  const pn = primNameStr(primNameOf(x))
  let bit = 1
  for nm in njNumNames {
    if nm == pn { return bit }
    bit = bit * 2
  }
  0
}

// The number types, in `njNumSig`'s bit order; every other primitive holds no number.
const njNumNames: string[] = ["i32", "i64", "f32", "f64"]

// Whether any value the function body at `body` returns has a literal arm, or is a call of a
// function `njFnGated` holds back.
function njRetSetHeld(body: i32): boolean {
  const rets: i32[] = []
  collectRetValues(body, rets)
  for r in rets {
    const leaves: i32[] = []
    tailValueLeaves(r, leaves)
    for l in leaves {
      if valueIsLitOnly(l) { return true }
      const c = nodeAt(cwPeel(l))
      if c is Call && c.callFn >= 0 {
        const cf = nodeAt(c.callFn)
        if cf is Ident {
          const d = fnDeclIx.get(cf.identName) ?? -1
          if d >= 0 && njFnGated(d) { return true }
        }
      }
    }
  }
  false
}

// Whether a join of `a` and `b` could keep two numbers apart: both hold a number or a type
// variable, and not the same numbers alone (`njJoinMayPart` without the function).
export function njMayPart(a: i32, b: i32): boolean {
  if a == b || a < 0 || b < 0 { return false }
  const sa = njNumSig(a, 0)
  if sa == 0 { return false }
  const sb = njNumSig(b, 0)
  sb != 0 && (sa != sb || sa >= 16)
}

// Whether every value the `if`, `match` or block at `ix` yields is a literal: a number, a
// negated or parenthesised one, an operator tree of them, or `null`, and one is not `null`.
// Such a value adapts to the type beside it in a join.
export function valueIsLitOnly(ix: i32): boolean { valueLitState(ix) == 1 }

// `valueLitState` per node, kept only while an `else if` chain's tails run, where each link
// asks about the whole link below it: the memo makes the chain cost one walk (D4557).
export let vloMemoOn = false
export function vloMemoOnSet(v: boolean) { vloMemoOn = v }

export let vloMemo: {[i32]: i32} = Map()
export function vloMemoSet(v: {[i32]: i32}) { vloMemo = v }

// -1 when a value the `if`, `match` or block at `ix` yields does not adapt, 1 when every one
// adapts and one is not `null`, 0 when every one is `null` or there is none.
function valueLitState(ix: i32): i32 {
  if ix < 0 { return -1 }
  const root = cwPeel(ix)
  if vloMemoOn && vloMemo.has(root) { return vloMemo.get(root) ?? -1 }
  let st = 0
  const todo: i32[] = [ix]
  while todo.length > 0 && st >= 0 {
    const at = cwPeel(todo.pop() ?? -1)
    if at >= 0 && at < P.nodes.length {
      if at != root && vloMemoOn && vloMemo.has(at) {
        const m = vloMemo.get(at) ?? -1
        if m != 0 { st = m }
      } else if !tailPushIfArms(at, todo) && !tailPushMatchArms(at, todo) {
        if !tailPushBlockTail(at, todo) {
          // The first value that does not adapt settles it, so a chain costs one leaf.
          if !leafIsLit(at, 8) {
            st = -1
          } else if !(nodeAt(parenPeelIx(at)) is NullLit) {
            // A `null` leaf adapts to nothing: an arm of only `null` leaves a sibling apart.
            st = 1
          }
        }
      }
    }
  }
  if vloMemoOn { vloMemo.set(root, st) }
  st
}

// Whether every value `ix` yields is a list literal or `null`, and one is a list literal.
export function valueIsFreshList(ix: i32): boolean {
  const leaves: i32[] = []
  tailValueLeaves(ix, leaves)
  let fresh = false
  for l in leaves {
    const n = nodeAt(cwPeel(l))
    if n is ArrayLit { fresh = true }
    else if !(n is NullLit) { return false }
  }
  fresh
}

// `valueIsLitOnly(ix)` for an arm typed `ty`, asked only where it can decide a join: an arm
// holding no number and no type parameter answers false without a walk, and a list arm
// answers whether it is a fresh list literal.
export function armLit(ty: i32, ix: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  if tyAt(nonNullTy(ty)) is TyArray { return valueIsFreshList(ix) }
  // The common arm, one number or a non-number, settles without flattening anything.
  const t = tyAt(ty)
  if t is TyPrim {
    if !isNumericPrimTy(ty) { return false }
  } else if !tyHoldsNumericPrim(ty) && !tyHasTyVar(ty) {
    return false
  }
  valueIsLitOnly(ix)
}

// Rewrites one synthetic annotation name into the emitter's vocabulary — the emit-name
// canonicalization pass. Structure-preserving: only literal members, `&` folds and
// whole-name parens change; a name without those (`nameNeedsCanon`) returns unchanged. For a
// declared union alias, its flattened member-set emit name; "" for anything else, which keeps its own name.
export function unionAliasMembers(name: string) {
  const ix = cUserTypes[name] ?? -1
  if ix < 0 { return "" }
  const t = tyAt(ix)
  match t {
    TyUnion => {
      // The declared member spellings first (`declaredStructUnionMembers`). "" from it means
      // "not a union of declared structs", which keeps every other alias on the structural render.
      const dsm = declaredStructUnionMembers(name)
      if dsm != "" { return dsm }
      // Renders a self-reference as the alias name rather than letting the cycle guard answer
      // "" — `Json`'s own members mention `Json`, so without this the flatten declined the
      // alias entirely (D1021).
      return tyToEmitName(ix)
    }
    // A nullable alias is a union alias too: `type P = null | f64` is stored as
    // `TyNullable(f64)`, not `TyUnion`, so without expanding it to `<inner>|null` the outer
    // union never sees the null it already contains — the emitter meets a return type with
    // `null` twice (D1026). Declines exactly as the `TyUnion` arm when the inner has no emit name.
    TyNullable => {
      const inner = tyToEmitName(t.nInner)
      if inner == "" { return "" }
      return inner + "|null"
    }
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
  }
  ""
}

// The `|`-joined declared member spellings of union alias `name` (`type Shape = Circle |
// Rect` → "Circle|Rect"), when every member names a declared struct or is `null`; "" for
// anything else. Needed since `tyToNameGo`'s `TyObj` arm has no nominal rung — it
// renders a member as an anonymous shape, unrelated to the real declared structs.
export function declaredStructUnionMembers(name: string) {
  const si = rootUnionDeclAt(name)
  if si < 0 { return "" }
  const s = nodeAt(gRootStmts[si])
  if s is UnionDecl {
    const vs = s.udVariants
    if vs.length < 2 { return "" }
    let out = ""
    let i = 0
    while i < vs.length {
      const m = vs[i]
      if m != "null" {
        const mi = cUserTypes[m] ?? (-1)
        if mi < 0 { return "" }
        const mt = tyAt(mi)
        if mt is TyObj {} else { return "" }
      }
      if i > 0 { out = out + "|" }
      out = out + m
      i = i + 1
    }
    // The join's own atom width, for the caller that reads `tyNameAtoms` after a
    // flatten: one atom per member, since each is a bare name.
    tyNameAtoms = vs.length
    return out
  }
  ""
}

// The position in `gRootStmts` of the first `UnionDecl` named `name`, or -1. Indexed once per
// statement list and arena generation; a stale entry is caught by re-reading its slot, and
// then the list is scanned as before.
function rootUnionDeclAt(name: string): i32 {
  let moved = memoMoved(rudKey, 0, gRootStmtsGen)
  moved = memoMoved(rudKey, 1, gRootStmts.length) || moved
  moved = memoMoved(rudKey, 2, arenaEpochNow()) || moved
  if moved {
    rudAt = Map()
    let i = gRootStmts.length - 1
    while i >= 0 {
      const s = nodeAt(gRootStmts[i])
      if s is UnionDecl { rudAt[s.udName] = i }
      i = i - 1
    }
  }
  const at = rudAt[name] ?? (-1)
  if at < 0 { return -1 }
  const s = nodeAt(gRootStmts[at])
  if s is UnionDecl {
    if s.udName == name { return at }
  }
  let si = 0
  while si < gRootStmts.length {
    const t = nodeAt(gRootStmts[si])
    if t is UnionDecl {
      if t.udName == name { return si }
    }
    si = si + 1
  }
  -1
}

let rudAt: {[string]: i32} = Map()

const rudKey = memoKeyNew(3)

// ── the union registry's rep key, minted here and nowhere else (`registry-by-type-id.md`
// §3) ── neither existing key works: an arena index is not an identity, and `repCanonId`
// both merges disjoint literal unions of the same arity and splits a nested union from its
// flattening. Canon's own softened, flattened rendering is the equivalence the registry needs.
const cukTexts: string[] = []

const cukIds: {[string]: i32} = Map()

// The member sequence `name` denotes, in the registry's ABI order: a union-alias atom is
// replaced by its members only when the expansion is multi-atom, and an alias whose expansion
// is not, spelled alone, by the set its declaration's row records. Not deduped or reordered:
// a union's box tags are positional over it.
function canonUnionKeyText(name: string): string {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  if atoms.length == 1 {
    const ls = aliasDeclRowSet(name)
    if ls != "" { return canonUnionKeyText(ls) }
  }
  let out = ""
  let i = 0
  while i < atoms.length {
    let m = atoms[i]
    const exp = unionAliasMultiMembers(m)
    if exp != "" { m = exp }
    if out.length > 0 { out = out + "|" }
    out = out + m
    i = i + 1
  }
  out
}

// `unionAliasMembers(name)` when it spells two or more atoms, else "". A one-member alias over
// a list, record, map or scalar is one atom, decided without the render, which spells a
// sub-record a nested record shares once per path (D9891).
function unionAliasMultiMembers(name: string): string {
  const ix = cUserTypes[name] ?? -1
  if ix >= 0 {
    const t = tyAt(ix)
    if t is TyUnion && t.uMembers.length == 1 && t.uMembers[0] >= 0 {
      const mt = tyAt(t.uMembers[0])
      if mt is TyArray || mt is TyObj || mt is TyMap || mt is TyPrim {
        return ""
      }
    }
  }
  const exp = unionAliasMembers(name)
  if exp == "" { return "" }
  const ea: string[] = []
  splitUnionAtoms(exp, ea)
  if ea.length > 1 { return exp }
  ""
}

// The `|`-joined declared members of alias `name` (`type K = "a" | "b"` → `"a"|"b"`), the set
// `collectU` keys its row by, where the member expansion is one atom or none: a softened
// string litunion or a one-member alias. "" for any other name, and for a numeric litunion.
function aliasDeclRowSet(name: string): string {
  const ty = cUserTypes[name] ?? -1
  if ty < 0 || numLitUnionHasBase(ty) { return "" }
  if unionAliasMultiMembers(name) != "" { return "" }
  const sx = cFillStmtIx[name] ?? (-1)
  if sx < 0 { return "" }
  const s = nodeAt(sx)
  if s is UnionDecl {
    if s.udName != name { return "" }
    let out = ""
    let i = 0
    while i < s.udVariants.length {
      if i > 0 { out = out + "|" }
      out = out + s.udVariants[i]
      i = i + 1
    }
    return out
  }
  ""
}

// The key for a spelling, -1 for the empty name, which the registry never holds. The flatten
// is the key and the softening is not: the flatten is what makes `J | E` and
// `boolean|f64|string|E` one key, while the softening collapses `"aa"|"bb"` and `61|62` to
// `string`/`i32` (`registry-by-type-id.md` §3 measures the gap against `repCanonId`).
export function canonUnionKeyOfName(name: string): i32 {
  if name.length == 0 { return -1 }
  cukIdOfText(cukTextOfName(name))
}

// The key for an annotation spelling of two or more members, else -1. A one-member spelling
// (`"world"`, `type W = 7`) keys a one-member row, and an annotation naming no union type
// does not denote that row's box. Mints no key for a spelling it declines.
export function canonUnionKeyOfAnnName(name: string): i32 {
  const text = cukTextOfName(name)
  if (cukAtomsOfName[name] ?? 0) < 2 { return -1 }
  cukIdOfText(text)
}

// `canonUnionKeyText(name)`, rendered once per spelling while the memo holds, and its width.
function cukTextOfName(name: string): string {
  cukMemoSync()
  const hit = cukTextMemo[name]
  if hit != null { return hit }
  const text = canonUnionKeyText(name)
  cukTextMemo[name] = text
  const atoms: string[] = []
  splitUnionAtoms(text, atoms)
  cukAtomsOfName[name] = atoms.length
  text
}

// The key text `name` denotes, the member sequence its key is minted from; "" for "".
export function canonUnionKeyTextOfName(name: string): string {
  if name.length == 0 { return "" }
  cukTextOfName(name)
}

// The key for a member-sequence text already in the registry's ABI order, read as written,
// with no alias expanded; -1 for "".
export function canonUnionKeyOfText(text: string): i32 { cukIdOfText(text) }

// The id of a rendered key text, minted on first sight; -1 for "".
function cukIdOfText(text: string): i32 {
  if text.length == 0 { return -1 }
  const at = cukIds[text] ?? -1
  if at >= 0 { return at }
  const id = cukTexts.length
  cukTexts.push(text)
  cukIds[text] = id
  id
}

// A spelling's key text and its width, memoised by spelling. The render reads the alias
// tables and the arena, so the memo holds only while none of them has been rewritten.
let cukTextMemo: {[string]: string} = Map()

let cukAtomsOfName: {[string]: i32} = Map()

const cukMemoKey = memoKeyNew(4)

function cukMemoSync() {
  let moved = memoMoved(cukMemoKey, 0, tyMutEpoch)
  moved = memoMoved(cukMemoKey, 1, cUserTypesVer) || moved
  moved = memoMoved(cukMemoKey, 2, gRootStmts.length) || moved
  moved = memoMoved(cukMemoKey, 3, tyVarRenames) || moved
  if moved {
    cukTextMemo = Map()
    cukAtomsOfName = Map()
  }
  0
}

// The key for an arena type — the route a querier holding only a type takes to the row a
// producer minted from a spelling. The text keeps a union alias member as its name, so the
// spelling's alias expansion still keys it. -1 when `ty` is not a union shape at all, since a
// coverage hole reading as a disagreement picks the wrong row.
export function canonUnionKeyOfTy(ty: i32): i32 {
  const text = canonUnionKeyTextOfTy(ty)
  if text.length == 0 { return -1 }
  canonUnionKeyOfName(text)
}

// The key `ty` would carry with its `null` arm spelled at member position `at`: a nullable
// union's row records `null` where its spelling wrote it, while the arena renders it last.
// -1 when `ty` is not a nullable union of plain atoms, or `at` is past its last member.
export function canonUnionKeyNullAtOfTy(ty: i32, at: i32): i32 {
  if ty < 0 { return -1 }
  const t = tyAt(ty)
  if t is TyNullable {
    if t.nInner < 0 { return -1 }
    const it = tyAt(t.nInner)
    if it is TyUnion {
      const ms = it.uMembers
      if at < 0 || at > ms.length { return -1 }
      let out = ""
      let i = 0
      while i <= ms.length {
        if i == at {
          if out != "" { out = out + "|" }
          out = out + "null"
        }
        if i < ms.length {
          const a = canonUnionKeyAtomOfTy(ms[i])
          if a == "" { return -1 }
          if out != "" { out = out + "|" }
          out = out + a
        }
        i = i + 1
      }
      return canonUnionKeyOfName(out)
    }
  }
  -1
}

// The module bindings whose checked type is one of the scalars a wasm global can export
// (`i32`, `i64`, `f32`, `f64`, `boolean`), by merged name — what the emitter asks before it
// publishes an entry module's `export let`/`export const` as a wasm global.
let topScalarNames: string[] = []

let topScalarTys: string[] = []

export function recordTopScalars() {
  topScalarNames = []
  topScalarTys = []
  let i = 0
  while i < gRootStmts.length {
    const s = nodeAt(gRootStmts[i])
    if s is LetDecl {
      const t = declTyOf(gRootStmts[i])
      let sp = ""
      if t == TY_I32 { sp = "i32" }
      else if t == TY_I64 { sp = "i64" }
      else if t == TY_F32 { sp = "f32" }
      else if t == TY_F64 { sp = "f64" }
      else if t == TY_BOOL { sp = "boolean" }
      if sp != "" {
        topScalarNames.push(s.letName)
        topScalarTys.push(sp)
      }
    }
    i = i + 1
  }
  0
}

// The scalar spelling of module binding `name`, or "" when its type is anything else.
export function topLetScalarOf(name: string): string {
  let i = 0
  while i < topScalarNames.length {
    if topScalarNames[i] == name { return topScalarTys[i] }
    i = i + 1
  }
  ""
}

// Every value a function body at `blockIx` hands back: each valued `return`, and its tail.
export function collectRetValues(blockIx: i32, out: i32[]) {
  a20RetWalk(blockIx, true, out)
}

export function njJoinReset() {
  njGateMemo = Map()
  njHeldNodes = Map()
  njFnIx = -1
  gRootStmtsSet([])
}
