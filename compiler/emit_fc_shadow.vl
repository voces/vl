// The field-code shadow: each struct row field's stored code beside the code its storage type's
// rep derives, one `repAB` bucket per (minter, stored, derived) answer. Armed with the rep shadow
// (`$VL_REP_SHADOW`); unarmed, the sweep is one boolean test. It reads tables and writes only its
// own buckets, so it moves no emitted byte.

import { i32ToStr } from "./ast"
import { repABNote } from "./emit_nullable_rets"
import { fieldCodeOfRep } from "./emit_field_codes"
import { repOfTy, repShadowOn } from "./emit_rep"
import {
  armsAdopted,
  sFieldCount,
  sFieldStart,
  sFieldStoreTy,
  sFieldTypes,
  sIsRefRow,
  sLitIdRow,
  sLitMintFn,
  sLitMintRow,
  sNames,
} from "./emit_state"

// The minter a struct row came from, by its name's spelling: an object literal's anonymous row, a
// type's own row, a reference row, or an interned shape.
function fcRowMinter(si: i32): string {
  if sIsRefRow(si) { return "ref" }
  const nm = sNames[si]
  if nm.length > 0 && nm[0] == '#' { return "anon" }
  if nm.length > 0 && nm[0] == '{' { return "shape" }
  return "decl"
}

// The anonymous rows minted only outside every instance: a literal's mint at instance -1, and no
// instance's mint (its own, or a tagged set's id row) at the same row.
let fcTemplateMemo: {[i32]: boolean} = Map()
let fcTemplateBuilt = false
function fcTemplateRows(): {[i32]: boolean} {
  if fcTemplateBuilt { return fcTemplateMemo }
  const inst: {[i32]: boolean} = Map()
  const tmpl: {[i32]: boolean} = Map()
  for lit in sLitMintRow.keys() {
    const r = sLitMintRow[lit] ?? -1
    if r >= 0 {
      if (sLitMintFn.get(lit) ?? -1) >= 0 {
        inst.set(r, true)
      } else {
        tmpl.set(r, true)
      }
    }
  }
  for lit in sLitIdRow.keys() { inst.set(sLitIdRow[lit] ?? -1, true) }
  fcTemplateMemo = Map()
  for r in tmpl.keys() {
    if !inst.has(r) { fcTemplateMemo.set(r, true) }
  }
  fcTemplateBuilt = true
  return fcTemplateMemo
}

// Every struct row's fields, once the module is final.
export function fcShadowSweep() {
  if !repShadowOn { return 0 }
  fcTemplateBuilt = false
  if !armsAdopted { repABNote("field", "arms", "not adopted") }
  let si = 0
  while (
    si < sNames.length
    && si < sFieldStart.length
    && si < sFieldCount.length
  ) {
    const who = fcRowMinter(si)
    let fi = 0
    while fi < sFieldCount[si] {
      const r = sFieldStart[si] + fi
      const code = if r < sFieldTypes.length { sFieldTypes[r] } else { -3 }
      const st = if r < sFieldStoreTy.length { sFieldStoreTy[r] } else { -1 }
      if st < 0 {
        repABNote("field", who, "noStoreTy code=" + i32ToStr(code))
      } else {
        const d = repOfTy(st)
        const dc = fieldCodeOfRep(d)
        if dc == code {
          repABNote("field", who, "agree")
        } else if dc == -2 && who == "anon" && fcTemplateRows().has(si) {
          // A generic template's own row: minted outside every instance at a type with no rep.
          // Each instance mints its own row, and no emitted code uses this one.
          repABNote("field", "template", "not emitted")
        } else {
          const kw = d.rdKind ?? "none"
          repABNote(
            "field",
            who,
            "stored=" + i32ToStr(code) + " derived=" + i32ToStr(dc) + " rep=" + kw,
          )
        }
      }
      fi = fi + 1
    }
    si = si + 1
  }
  return 0
}
