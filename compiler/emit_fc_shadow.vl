// The field-code shadow: each struct row field's stored code beside the code its storage type's
// rep derives, one `repAB` bucket per (minter, stored, derived) answer. Armed with the rep shadow
// (`$VL_REP_SHADOW`); unarmed, the sweep is one boolean test. It reads tables and writes only its
// own buckets, so it moves no emitted byte.

import { i32ToStr } from "./ast"
import { repABNote } from "./emit_nullable_rets"
import { RepDesc, repOfTy, repShadowOn } from "./emit_rep"
import { fieldCodeOfListRep } from "./emit_list_rep"
import {
  FC_CLOSURE,
  FC_F32,
  FC_F64,
  FC_I32,
  FC_I64,
  FC_MAP,
  FC_NUL_BOOL,
  FC_NUL_CLOSURE,
  FC_NUL_LIT_UNION,
  FC_NUL_MAP,
  FC_NUL_NONE,
  FC_NUL_STR,
  FC_STR,
  FC_STRUCT,
  FC_UNION,
  armsAdopted,
  sFieldCount,
  sFieldStart,
  sFieldStoreTy,
  sFieldTypes,
  sIsRefRow,
  sNames,
} from "./emit_state"

// The field code a storage rep derives, or -2 where it has none (no value, or `v128`). A nullable
// record or variant shares the struct code, which stores either nullable.
function fieldCodeOfRep(d: RepDesc): i32 {
  const k = d.rdKind
  match k {
    null | "v128" => {
      return -2
    }
    "i32" => {
      return if d.rdNul == 3 { FC_NUL_LIT_UNION } else { FC_I32 }
    }
    "str" => {
      return FC_STR
    }
    "closure" => {
      return FC_CLOSURE
    }
    "nulclosure" => {
      return FC_NUL_CLOSURE
    }
    "union" => {
      return FC_UNION
    }
    "i64" => {
      return FC_I64
    }
    "f64" => {
      return FC_F64
    }
    "f32" => {
      return FC_F32
    }
    "struct" | "nulstruct" | "variant" | "nulvariant" => {
      return FC_STRUCT
    }
    "map" => {
      return FC_MAP
    }
    "nulmap" => {
      return FC_NUL_MAP
    }
    "nulstr" => {
      return FC_NUL_STR
    }
    "nulbool" => {
      return FC_NUL_BOOL
    }
    "nulnone" => {
      return FC_NUL_NONE
    }
    "list" | "reflist" | "strlist" | "f64list" | "i64list" | "f32list" | "u8list" | "nullist" | "nulreflist" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" => {
      return if k == null { -2 } else { fieldCodeOfListRep(k) }
    }
  }
}

// The minter a struct row came from, by its name's spelling: an object literal's anonymous row, a
// type's own row, a reference row, or an interned shape.
function fcRowMinter(si: i32): string {
  if sIsRefRow(si) { return "ref" }
  const nm = sNames[si]
  if nm.length > 0 && nm[0] == '#' { return "anon" }
  if nm.length > 0 && nm[0] == '{' { return "shape" }
  "decl"
}

// Every struct row's fields, once the module is final.
export function fcShadowSweep() {
  if !repShadowOn { return 0 }
  if !armsAdopted { repABNote("field", "arms", "not adopted") }
  let si = 0
  while (
    si < sNames.length
    && si < sFieldStart.length
    && si < sFieldCount.length
  ) {
    const who = fcRowMinter(si)
    let fi = 0
    while fi < sFieldCount[si] {
      const r = sFieldStart[si] + fi
      const code = if r < sFieldTypes.length { sFieldTypes[r] } else { -3 }
      const st = if r < sFieldStoreTy.length { sFieldStoreTy[r] } else { -1 }
      if st < 0 {
        repABNote("field", who, "noStoreTy code=" + i32ToStr(code))
      } else {
        const d = repOfTy(st)
        const dc = fieldCodeOfRep(d)
        if dc == code {
          repABNote("field", who, "agree")
        } else {
          const kw = d.rdKind ?? "none"
          repABNote(
            "field",
            who,
            "stored=" + i32ToStr(code) + " derived=" + i32ToStr(dc) + " rep=" + kw,
          )
        }
      }
      fi = fi + 1
    }
    si = si + 1
  }
  0
}
