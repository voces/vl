// The field-code shadow's report: the read-time counts `fieldCodeIn` and the sidecar readers keep
// under the rep shadow (`$VL_REP_SHADOW`), one `repAB` bucket per (reader, verdict). Unarmed it is
// one boolean test, and it writes only its own buckets, so it moves no emitted byte.

import { repABNoteN } from "./emit_nullable_rets"
import { fcReadCnt, fcReadKeys, fcReadReset, repShadowOn } from "./emit_rep"

// Reports the read-time counts once the module is final, then drops them.
export function fcShadowSweep() {
  if !repShadowOn { return 0 }
  let ki = 0
  while ki < fcReadKeys.length {
    const k = fcReadKeys[ki]
    const cut = k.indexOf(" -> ")
    repABNoteN(
      "fieldRead",
      k.slice(0, cut),
      k.slice(cut + 4, k.length),
      fcReadCnt[ki],
    )
    ki = ki + 1
  }
  fcReadReset()
  return 0
}
