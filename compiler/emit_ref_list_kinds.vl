// The `__array_new__(n, fill)` element kind read off the DESTINATION — the checker's recorded
// type for the call, the same source `arrNewDefaultKind` reads below. `"none"` where that type
// names no list rep, an unpinned `T[]` inside a generic body being the live case, and the
// fill ladder stays authoritative there.
export function arrNewDestKind(callIx: i32): ArrNewKind {
  const ty = nodeTyIxOf(callIx)
  const el = tyRefArrElemOf(ty)
  const k = tyListRepKind(ty, rlSlotOfTy(el))
  if k != null { return arrNewKindOfListVKind(k) }
  // No interned row carries the element. An UN-annotated destination has no annotation to have
  // banked one and the collect pass interns off this very answer, so the row cannot be the
  // test; a RESOLVED non-primitive element is the ref list by construction, and the intern
  // follows. An unpinned `T` is not resolved and still declines.
  if tyIsRefListElemTy(el) { return "reflist" }
  "none"
}

// The `pendingListKind` an ELEMENT of ref-list row `slot` builds at, or `-1` where the element
// is not a list at all and the caller's own seed stands. A kind-9 (ref inner list) element
// pairs it with `rlElemInnerSlot`. An element left on the OUTER list's threading is built at
// the outer pair's heap types instead of its own (D1629).
export function refElemListBuildKind(slot: i32): i32 {
  if slot < 0 || slot >= rlElemKindTbl.length { return -1 }
  const k = rlElemListRep(rlElemKindTbl[slot])
  if k == null { return -1 }
  // An inner ref list builds at code 5 through its own row, which the caller pairs with it.
  if k == "reflist" { return LBK_REF_AT_SLOT }
  listBuildKindOfVKind(k, -1)
}

// The `pendingListKind` a type-annotation node at `tyIx` names (1 = struct/map ref list,
// 2 = union box ref list, 3 = string list), or 0 when it isn't a list annotation. Shared
// by the let/return/call-arg/global seeding so each position threads the same
// annotation-derived list context into `emitArr`, not a first-element guess.
export function tyAnnRefListKind(tyIx: i32) {
  if tyIx >= 0 {
    // The annotation's element row, `| null`-tolerant exactly as the intern arm that
    // banked it (`ensureRefElem`/`rlInternName`) — read, not re-derived from the rendering.
    const raK = annRefArrSlot(tyIx)
    if raK >= 0 && raK < rlElemKindTbl.length {
      if rlElemKindTbl[raK] == RLK_UNION { return LBK_UNION }
      if rlElemKindTbl[raK] == RLK_CLOSURE { return LBK_REF_AT_SLOT }
      return LBK_REF
    }
    // An inline literal-union array annotation (`("a" | "b")[]`) seeds no list kind — the
    // default i32 wrapper. Ahead of the name arm since canon softens the bare inline union
    // to `string`, which would otherwise seed the string-list build for an atom-i32 cell.
    if tyIsLitUnionArray(nodeTyIxOf(tyIx)) { return LBK_I32_LIST }
    // The numeric twin of the arm above: a numeric literal union has no atom (its members
    // ARE i32/i64/f64 values), so a `K[]` is the base scalar's list — f64 (4), i64 (6), or
    // the default i32. Ahead of the name arms for the same canon-softening reason: an
    // empty `[]` would otherwise build the i32 default into an f64/i64 cell.
    const nlab = numLitUnionArrayBaseName(nodeTyIxOf(tyIx))
    if nlab == "f64" { return LBK_F64_LIST }
    if nlab == "i64" { return LBK_I64_LIST }
    if nlab != "" { return LBK_I32_LIST }
    // The nullable-element twin (`(("a" | "b") | null)[]`, kind 9), ahead of the name arms
    // for the same reason: the softened `(string | null)[]` spelling would seed a string list.
    if annIsNulLitUnionArray(tyIx) { return LBK_NUL_LIT_UNION_LIST }
    const lt = P.nodes[tyIx]
    if lt is TypeRef {
      // Stays on the name — a decline with evidence (B79): `nodeTyArrayElemRepName(tyIx) ==
      // "string"` looks like a swap-in but is silent on a `TyParam` element
      // (`generics/type-param-shadows-alias-funcdecl.vl`), and dual-run confirms the arena
      // never answers `string` where the name declines, so the disjunct would move nothing.
      if nameIsStringArray(lt.tyName) { return LBK_STR_LIST }
      // A `(boolean | null)[]` annotation (kind 8): an i32-backed list with the boolean
      // sentinel niche (`null → 2`), so an all-`null` `[null]` builds the i32 wrapper.
      // Checked before the scalar-array arms. The arena (`nodeTyIsNulBoolList`) and name
      // (`nameIsNulBoolList`) legs agree everywhere dual-run; the name stays for uncovered nodes.
      if nodeTyIsNulBoolList(tyIx) { return LBK_NUL_BOOL_LIST }
      if nodeTyIxOf(tyIx) < 0 && nameIsNulBoolList(lt.tyName) {
        return LBK_NUL_BOOL_LIST
      }
      // A `(K | null)[]` annotation (kind 9): an i32-backed atom list with the litunion
      // sentinel niche (`null → -1`). Do not delete on a zero-row sabotage (B75): the
      // similar-looking `annIsNulLitUnionArray` only recognizes the `TyNullable`-element
      // spelling, not the checker's flattened `"a" | "b" | null` union form; this catches both.
      if nameIsNulLitUnionList(lt.tyName) { return LBK_NUL_LIT_UNION_LIST }
      // An `f64[]` annotation: an empty `[]` builds the f64-list wrapper (kind 4).
      if tyIsF64Array(nodeTyIxOf(tyIx)) { return LBK_F64_LIST }
      // An `i64[]` annotation: an empty `[]` builds the i64-list wrapper (kind 6).
      if tyIsI64Array(nodeTyIxOf(tyIx)) { return LBK_I64_LIST }
      // An `f32[]` annotation (kind 7): threads even for a non-empty literal, since a bare
      // `[1.5]` doesn't self-identify as f32 (it defaults to f64). Stays on the name
      // deliberately — a kind-based test would be a constant false here (`tyKindOf` never
      // returns 21), and a kind-based claim would mis-classify a literal-built f64 list as f32.
      if nameIsF32Array(lt.tyName) { return LBK_F32_LIST }
      // A `u8[]` annotation (kind 10) — the packed byte list. Threads for a non-empty
      // literal too: a bare `[1, 2]` types `i32[]`, so the annotation is the only signal.
      if nameIsU8Array(lt.tyName) { return LBK_U8_LIST }
    }
  }
  LBK_I32_LIST
}

// The list `VKind` a recorded ARRAY type reps as, given the caller's own ref-list ROW for the
// element (`-1` for none). Ordered as `tyAnnRefListKind`'s ladder is: non-`TyPrim`-backed
// spellings (litunion, nullable niches) first, then `TyPrim` leaves, then the ref-list row —
// a `TyPrim` leaf returns on an unmapped element rather than falling into the row lookup.
function tyListRepKind(ty: i32, rowSlot: i32): VKind | null {
  if ty < 0 { return null }
  const sbk = tyScalarBackedListKind(ty)
  if sbk != null { return sbk }
  const lk = tyPrimLeafListKind(ty)
  if lk != null { return lk }
  if tyPrimLeafElem(ty) { return null }
  if rowSlot >= 0 { return "reflist" }
  null
}

// The `VKind` an empty `[]`'s recorded array type reps as, or `null` when this is not an
// element-pinned hole. Its ref-list row is resolved by NAME where the arena declines, which
// is the one thing this reading has that the plain recorded-type one does not.
export function emptyArrHoleKind(exprIx: i32): VKind | null {
  const ax = emptyArrLitIxOf(exprIx)
  if ax < 0 { return null }
  tyListRepKind(nodeTyIxOf(ax), emptyArrHoleElemSlot(exprIx))
}

// The list `VKind` an ARRAY type over a bare `TyPrim` LEAF reps as — `i32`/`boolean` share
// the one i32-list backing, every other leaf has its own — or `null` for any other element
// (or any non-array). The ARENA twin of the `nameIs*Array` ladder, written once for the
// positions that hold a TYPE and no annotation node to run the name ladder over.
export function tyPrimLeafListKind(ty: i32): VKind | null {
  const n = tyPrimLeafElemName(ty)
  // Exhaustive over `PrimName | null` and `_`-less (D1898 made the nullable litunion
  // matchable): `null` is "no list backing", a real answer, for the three prims the list
  // layer has no backing for and for the `null` a non-array or non-prim element yields.
  match n {
    "i32" | "boolean" => {
      return "list"
    }
    "string" => {
      return "strlist"
    }
    "f64" => {
      return "f64list"
    }
    "i64" => {
      return "i64list"
    }
    "f32" => {
      return "f32list"
    }
    "u8" => {
      return "u8list"
    }
    "void" | "null" | "never" | "v128" | null => {
      // No list backing for these element types, nor for a non-array/non-prim element.
    }
  }
  null
}

// True if `ty` is an array over a bare `TyPrim` element — the guard that keeps a leaf
// `tyPrimLeafListKind` does NOT map (a `TyPrim` the list layer has no backing for) out of
// the ref-list row lookup below it. `nodeArrayElemName` renders a prim element as its bare
// scalar name, and a bare scalar is not a ref-list key: matching one would be a coincidence.
function tyPrimLeafElem(ty: i32) { tyPrimLeafElemName(ty) != null }

// The `pendingListKind` build vocabulary a list `VKind` + its ref-list ROW demand — the
// same 0/1/2/3/4/5/6/7/10 alphabet `tyAnnRefListKind` produces from an ANNOTATION node and
// `seedFieldListBuild` from a FIELD code. `0` (the i32-list default) for every kind that is
// not a distinct-backing list, which is also the correct seed for the i32-backed ones.
export function listBuildKindOfVKind(kind: VKind | null, slot: i32) {
  // Exhaustive over `VKind` and `_`-less, `null` included: `0` is the i32 list's build code,
  // a real answer, so a new list rep has to name its own rather than inherit it.
  match kind {
    "strlist" => {
      return LBK_STR_LIST
    }
    "f64list" => {
      return LBK_F64_LIST
    }
    "i64list" => {
      return LBK_I64_LIST
    }
    "f32list" => {
      return LBK_F32_LIST
    }
    "u8list" => {
      return LBK_U8_LIST
    }
    "reflist" => {
      if slot >= 0 && slot < rlElemKindTbl.length {
        if rlElemKindTbl[slot] == RLK_UNION { return LBK_UNION }
        if rlElemKindTbl[slot] == RLK_CLOSURE { return LBK_REF_AT_SLOT }
      }
      return LBK_REF
    }
    "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" => {
      return nulScalarListBuildKind(kind)
    }
    "list" | "nullist" | "nulreflist" | "i32" | "struct" | "str" | "union" | "map" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f32" | "v128" | "closure" | "nulstr" | "nulbool" | "nulclosure" | "nulmap" | "nulnone" | null => {
      // The i32-backed lists and every kind that is no list seed the i32-list default.
      return LBK_I32_LIST
    }
  }
}

// The `pendingListKind` / `pendingListSlot` pair an empty `[]` hole demands of `emitArr`.
export function emptyArrHoleBuildKind(exprIx: i32) {
  listBuildKindOfVKind(emptyArrHoleKind(exprIx), emptyArrHoleElemSlot(exprIx))
}

// An empty `[]` delivered to a union is recorded as the union's first list member
// (`recordRepTyAdopt`), which is the arm it is built and tagged as: that arm's ref-list row, or
// -1 for a non-ref element or a literal that is not an empty `[]` (D2202).
export function emptyArrUnionArmSlot(exprIx: i32) {
  const ax = emptyArrLitIxOf(exprIx)
  if ax < 0 { return -1 }
  const s = rlSlotOfTy(tyRefArrElemOf(nodeRepTyIxOf(ax)))
  if s < 0 || s >= rlElemKindTbl.length { return -1 }
  s
}

// The list `VKind` of that adopted arm, or `null` when the literal adopted none.
export function emptyArrUnionArmKind(exprIx: i32): VKind | null {
  const ax = emptyArrLitIxOf(exprIx)
  if ax < 0 { return null }
  tyListRepKind(nodeRepTyIxOf(ax), emptyArrUnionArmSlot(exprIx))
}

// The `pendingListKind` that builds the adopted arm's backing.
export function emptyArrUnionArmBuildKind(exprIx: i32) {
  listBuildKindOfVKind(
    emptyArrUnionArmKind(exprIx),
    emptyArrUnionArmSlot(exprIx),
  )
}

export function emptyArrHoleBuildSlot(exprIx: i32) {
  const s = emptyArrHoleElemSlot(exprIx)
  if s < 0 { return 0 }
  s
}

// ── read-only covariance: the two questions an element-converting copy needs ────

// `Circle[]` assigned to `Shape[]` is `vl check` rc 0 but an invalid module: a mutable wasm
// array is invariant, so no subtyping edge exists between the two array types and the only
// lowering is an element-converting copy. That copy is licensed only where nothing writes
// through either handle — otherwise it silently gives one destination a private list. D791.

// The variant index a ref-list slot's element boxes as when widened into the union-box list
// at `dstSlot`, or -1 when the pair cannot widen: a kind-1 (plain struct) element into a
// kind-2 element, matched by heap type not name (D280: an arm and its layout twin are one
// heap). A nullable source is deliberately allowed in; a nullable destination is not.
export function rlWidenVariantOf(srcSlot: i32, dstSlot: i32): i32 {
  if srcSlot < 0 || dstSlot < 0 { return -1 }
  if srcSlot == dstSlot { return -1 }
  if srcSlot >= rlElemKindTbl.length { return -1 }
  if dstSlot >= rlElemKindTbl.length { return -1 }
  if rlElemKindTbl[srcSlot] != RLK_STRUCT { return -1 }
  if rlElemKindTbl[dstSlot] != RLK_UNION { return -1 }
  if srcSlot >= rlElemNullable.length { return -1 }
  if dstSlot >= rlElemNullable.length { return -1 }
  if rlElemNullable[dstSlot] == 1 { return -1 }
  if srcSlot >= rlElemName.length { return -1 }
  // LEG 1 — the element NAMES an arm (`Circle[]`). This is `rlElemVariantHeap`'s own
  // lookup, which is where the slot's element heap came from in the first place.
  const evi = variantIndexOf(nonNulBaseOf(rlElemName[srcSlot]))
  if evi >= 0 { return evi }
  // An inline shape or declared twin whose interned struct heap is an arm's heap (D280).
  // Compared on the resolved row, not `rlElemHeap` (pushed as 0 at intern time — a real index).
  const esi = rlElemStructRow(srcSlot)
  if esi < 0 { return -1 }
  if esi >= sHeapIdx.length { return -1 }
  const eh = sHeapIdx[esi]
  let vi = 0
  while vi < uVarHeap.length {
    if uVarHeap[vi] == eh { return vi }
    vi = vi + 1
  }
  -1
}

// Could a store through the receiver at `recvIx` reach a list whose element rep is ref-list
// slot `slot`? An unclassified side must never be claimed: an unrecorded type or an
// unresolved ref-ish element answers true (the widening then declines, unchanged behaviour),
// while a scalar element or a non-array receiver answers false — neither can alias a ref list.
function listWriteReaches(recvIx: i32, slot: i32): boolean {
  if recvIx < 0 { return true }
  if recvIx >= P.nodes.length { return true }
  const rty = nodeTyIxOf(recvIx)
  if rty < 0 || rty >= T.tys.length { return true }
  const ety = tyRefArrElemOf(rty)
  if ety < 0 || ety >= T.tys.length { return false }
  const et = T.tys[ety]
  let refish = false
  if et is TyObj { refish = true }
  if et is TyUnion { refish = true }
  if et is TyArray { refish = true }
  if et is TyMap { refish = true }
  if et is TyFunc { refish = true }
  if et is TyNullable { refish = true }
  if !refish { return false }
  const s = rlSlotOfTy(ety)
  if s < 0 { return true }
  s == slot
}

// The mutating LIST methods. `set` / `add` / `delete` are map/Set operations and are
// listed anyway: their receiver is a `TyMap`, which `listWriteReaches` answers FALSE for,
// so naming them costs nothing and keeps the set honest if a list ever grows one.
function memPropMutatesList(p: string): boolean {
  if p == "push" { return true }
  if p == "pop" { return true }
  if p == "clear" { return true }
  if p == "set" { return true }
  if p == "add" { return true }
  if p == "delete" { return true }
  false
}

// The un-memoised body of `rlSlotEverWritten` — one flat walk of the node arena, because the
// licence the copy needs is a whole-program property (nothing writes through either handle),
// and aliasing means a write anywhere can observe the copy. Looks for an `Index` assignment
// target or a mutating list method call; `__array_copy__` blocks every slot, unclassified.
function rlSlotWrittenScan(slot: i32): boolean {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is BinExpr {
      if n.binOp == "=" {
        const lhsIx = unwrapParen(n.binLeft)
        if lhsIx >= 0 && lhsIx < P.nodes.length {
          const lhs = P.nodes[lhsIx]
          if lhs is Index {
            if listWriteReaches(lhs.idxArr, slot) { return true }
          }
        }
      }
    }
    if n is Call {
      if n.callFn >= 0 && n.callFn < P.nodes.length {
        const callee = P.nodes[n.callFn]
        if callee is Member {
          if memPropMutatesList(callee.memProp) {
            if listWriteReaches(callee.memObj, slot) { return true }
          }
        }
        if callee is Ident {
          if callee.identName == "__array_copy__" { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// Does ANY list-element store or mutating list method in this program reach a list whose
// element rep is ref-list slot `slot`? Memoised per slot (`rlWrSlots`/`rlWrAns`, cleared
// with the ref-list tables in `collectA`) because the scan is O(arena) and the widening
// sites ask the same two slots at every delivery.
export function rlSlotEverWritten(slot: i32): boolean {
  if slot < 0 { return true }
  let m = 0
  while m < rlWrSlots.length {
    if rlWrSlots[m] == slot { return rlWrAns[m] == 1 }
    m = m + 1
  }
  const ans = rlSlotWrittenScan(slot)
  rlWrSlots.push(slot)
  if ans { rlWrAns.push(1) } else { rlWrAns.push(0) }
  ans
}

// The whole licence in one predicate: may a value at ref-list slot `srcSlot` be delivered
// into `dstSlot` by an element-converting copy? Widenable by rep, and write-free on both
// sides — a write through either handle after the copy is what would make it observable.
// `rootName` sharpens the rep-scoped write answer to a per-value one (D821) when needed.
export function rlWidenAllowed(
  rootName: string,
  rootFrame: i32,
  srcSlot: i32,
  dstSlot: i32,
): boolean {
  if rlWidenVariantOf(srcSlot, dstSlot) < 0 { return false }
  if !rlSlotEverWritten(srcSlot) {
    if !rlSlotEverWritten(dstSlot) { return true }
  }
  // Only a definite "nothing writes this value" (0) overrides the rep's "written" answer —
  // an unknown keeps the decline, since a copy on a guess is silently wrong, not just invalid. D791.
  covarValueWriteState(rootName, rootFrame) == 0
}

// The first element of a list literal that is neither an object literal nor `null`, or -1: a
// record some other expression already built, at a row of its own, which a re-seated list
// cannot hold.
export function rsFirstBuiltElem(elems: i32[]): i32 {
  let k = 0
  while k < elems.length {
    const e = unwrapParen(elems[k])
    if e >= 0 && rsIsBuiltRecord(e) { return e }
    k = k + 1
  }
  -1
}

// Whether the element at `e` is neither an object literal nor `null`.
export function rsIsBuiltRecord(e: i32): boolean {
  const n = P.nodes[e]
  if n is ObjLit { return false }
  !(n is NullLit)
}

export function rsBuiltElemFail(at: i32, dst: i32) {
  emitFailAt(
    "emitProgram: this record was built as another record type than the `"
      + rlElemName[dst]
      + "` a declared destination makes this list hold; a record is shared, not converted, so "
      + "the program is type-valid but cannot build. Build the element as an object literal "
      + "here, or declare its source as `"
      + rlElemName[dst]
      + "`",
    at,
  )
}

// Whether struct row `si` shares its exact field-name set with another row: the
// `objLitNamesTwoRows` question for a record already built at a row.
export function structNamesTwoRows(si: i32): boolean {
  const lim = sScanLim()
  if si < 0 || si >= lim { return false }
  const nf = sFieldCount[si]
  const st = sFieldStart[si]
  let oj = 0
  while oj < lim {
    if oj != si && sFieldCount[oj] == nf {
      let ok = true
      let k = 0
      while k < nf && ok {
        if sFieldIndex(oj, sFieldNames[st + k]) < 0 { ok = false }
        k = k + 1
      }
      if ok { return true }
    }
    oj = oj + 1
  }
  false
}

// Whether the node at `li` is an annotated `let` whose initializer is `x`.
export function rsAnnLetInitIs(li: i32, x: i32): boolean {
  if li < 0 { return false }
  const d = P.nodes[li]
  if d is LetDecl {
    if d.letType >= 0 && d.letInit >= 0 { return unwrapParen(d.letInit) == x }
  }
  false
}

// Whether struct row `si` has exactly the field names of the object literal at `objIx`.
export function rsRowNamesObjLit(si: i32, objIx: i32): boolean {
  const o = P.nodes[objIx]
  if o is ObjLit {
    if si >= sFieldCount.length || sFieldCount[si] != o.objFields.length {
      return false
    }
    let k = 0
    while k < o.objFields.length {
      const f = P.nodes[o.objFields[k]]
      if f is FieldInit {
        if sFieldIndex(si, f.fiName) < 0 { return false }
      } else {
        return false
      }
      k = k + 1
    }
    return true
  }
  false
}

// One question `rsUsesOf` asks of a scope: the uses of `rwName`, which names the re-seated
// list, one element of it (`rwElem`), or a function whose calls return one (`rwCall`), bound by
// `rwOwnLet` and stored at struct row `rwRow`; `rwList` is the list's own name and `rwHome` the
// function binding it, -1 at the top level.
export type RsWalk = {
  rwScope: i32,
  rwOwnLet: i32,
  rwName: string,
  rwElem: boolean,
  rwRow: i32,
  rwList: string,
  rwHome: i32,
  rwCall: boolean,
}

export const rsQueryGen = memoGenNew(0)

// The key of `nm`'s identifier chain within function `fr` (-1 the top level).
export function rsFnKey(nm: string, fr: i32): string { nm + "@" + i32ToStr(fr) }

// Whether the node at `p`, an ancestor below the scope reached through its child `cur`,
// leaves the name bound to `w`'s binding.
export function rsLevelKeeps(p: i32, cur: i32, w: RsWalk): boolean {
  if P.nodes[p] is FuncDecl { return !dsRebindsName(p, w.rwName) }
  rsForKeeps(p, cur, w) && rsBlockKeeps(p, cur, w)
}

// `rsLevelKeeps` at a `for`: its body reads the loop variables, not an outer binding.
function rsForKeeps(p: i32, cur: i32, w: RsWalk): boolean {
  const n = P.nodes[p]
  if n is ForIn {
    if cur == n.fiBody { return n.fiVar != w.rwName && n.fiVar2 != w.rwName }
  }
  true
}

// `rsLevelKeeps` at a block: a `let` of the name before `cur` rebinds it.
function rsBlockKeeps(p: i32, cur: i32, w: RsWalk): boolean {
  const n = P.nodes[p]
  if n is Block { return !rsBlockBindsBefore(n.blkStmts, cur, w.rwName, -1) }
  true
}

// Whether a `let` of `nm` other than `own` stands before statement `cur` in `stmts`.
export function rsBlockBindsBefore(
  stmts: i32[],
  cur: i32,
  nm: string,
  own: i32,
): boolean {
  let k = 0
  while k < stmts.length && stmts[k] != cur {
    const st = P.nodes[stmts[k]]
    if st is LetDecl {
      if st.letName == nm && stmts[k] != own { return true }
    }
    k = k + 1
  }
  false
}

// Whether statement `a` comes before statement `b` in `stmts`.
export function rsStmtBefore(stmts: i32[], a: i32, b: i32): boolean {
  let k = 0
  while k < stmts.length {
    if stmts[k] == a { return true }
    if stmts[k] == b { return false }
    k = k + 1
  }
  false
}

// `w` asked of the name `nm` bound by `own` in `scope`, naming the list or (`elem`) an element.
export function rsWalkAt(
  w: RsWalk,
  scope: i32,
  own: i32,
  nm: string,
  elem: boolean,
): RsWalk {
  const e: RsWalk = {
    rwScope: scope,
    rwOwnLet: own,
    rwName: nm,
    rwElem: elem,
    rwRow: w.rwRow,
    rwList: w.rwList,
    rwHome: w.rwHome,
    rwCall: false,
  }
  e
}

// The loop variable of a `for` at `par` iterating the list at `o`, or "".
export function rsForVarOver(o: i32, par: i32, w: RsWalk): string {
  if w.rwElem { return "" }
  const fi = P.nodes[par]
  if fi is ForIn {
    if unwrapParen(fi.fiIter) == o { return fi.fiVar }
  }
  ""
}

// The un-annotated binding that takes the use at `o` as the same value under another name —
// `const x = il`, `const x = il[k]`, or `const y = x` for an element `x` — or -1.
export function rsAliasOf(o: i32, par: i32, gp: i32, w: RsWalk): i32 {
  if rsLetInitIs(par, o) { return par }
  if !w.rwElem && rsIndexOfName(par, w.rwName) && rsLetInitIs(gp, par) {
    return gp
  }
  -1
}

// Whether the node at `li` is an un-annotated `let` whose initializer is `x`.
export function rsLetInitIs(li: i32, x: i32): boolean {
  if li < 0 { return false }
  const d = P.nodes[li]
  if d is LetDecl {
    if d.letType < 0 && d.letInit >= 0 { return unwrapParen(d.letInit) == x }
  }
  false
}

// The name the identifier at `x` reads, or "" when `x` is not an identifier.
export function rsIdentName(x: i32): string {
  if x < 0 || x >= P.nodes.length { return "" }
  const n = P.nodes[x]
  if n is Ident { return n.identName }
  ""
}

// Whether the node at `x` is an index read `nm[k]`.
export function rsIndexOfName(x: i32, nm: string): boolean {
  if x < 0 { return false }
  const n = P.nodes[x]
  if n is Index { return rsIdentName(unwrapParen(n.idxArr)) == nm }
  false
}

// Whether the callee at `cx` is `nm.push`, which stores into the re-seated storage itself.
export function rsIsPushOnto(cx: i32, nm: string): boolean {
  const c = unwrapParen(cx)
  if c < 0 { return false }
  const m = P.nodes[c]
  if m is Member {
    return m.memProp == "push" && rsIdentName(unwrapParen(m.memObj)) == nm
  }
  false
}

// Whether function `fr` declares a return other than the re-seated row (`list`: a list of it);
// an inferred return takes the storage's own row.
export function rsFnRetDeclaredNot(fr: i32, list: boolean, w: RsWalk): boolean {
  if fr < 0 { return false }
  const fd = P.nodes[fr]
  if fd is FuncDecl {
    if fd.fnRet < 0 { return false }
    const rt = nodeTyIxOf(fd.fnRet)
    if list { return !rsTyIsRow(tyRefArrElemOf(rt), w) }
    return !rsTyIsRow(rt, w)
  }
  false
}

// The checked return type of function `fr`, or -1.
export function rsFnRetTy(fr: i32): i32 {
  const ft = nodeTyIxOf(fr)
  if ft < 0 || ft >= T.tys.length { return -1 }
  const t = T.tys[ft]
  if t is TyFunc { return t.fnRet }
  -1
}

// Whether `ix`, under parent `par`, is a statement of function `fr`'s own body block.
export function rsIsBodyStmtOf(ix: i32, par: i32, fr: i32): boolean {
  if fr < 0 || fr >= P.nodes.length || ix < 0 { return false }
  const fd = P.nodes[fr]
  if fd is FuncDecl { return par == fd.fnBody || unwrapParen(fd.fnBody) == ix }
  false
}

// Whether arena type `ty` is a record, `| null` peeled.
export function rsTyIsRecord(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if t is TyNullable { return rsTyIsRecord(t.nInner) }
  t is TyObj
}

// Whether function `fr` has no declared return type.
export function rsFnRetInferred(fr: i32): boolean {
  if fr < 0 { return false }
  const fd = P.nodes[fr]
  if fd is FuncDecl { return fd.fnRet < 0 }
  false
}

// The type a store `place = v` in function `fr` delivers its value at: an element's or a
// field's (a map's read type carries a `| null` every caller peels), or a bare name's declared
// one, a parameter's or an annotated binding's (D2990). -1 for an un-annotated binding.
export function rsPlaceStoreTy(p: BinExpr, fr: i32): i32 {
  const lx = unwrapParen(p.binLeft)
  if lx < 0 || lx >= P.nodes.length { return -1 }
  const l = P.nodes[lx]
  if l is Ident {
    if paramIndexOf(fr, l.identName) < 0 {
      const li = destLetOf(l.identName, fr)
      if li < 0 || rsLetUnannotated(li) { return -1 }
    }
  }
  nodeTyIxOf(lx)
}

// The object literal the un-annotated binding at `li` is initialised with, or -1.
export function rsLetLitInit(li: i32): i32 {
  if li < 0 || li >= P.nodes.length { return -1 }
  const d = P.nodes[li]
  if d is LetDecl {
    if d.letType >= 0 || d.letInit < 0 { return -1 }
    const ini = unwrapParen(d.letInit)
    if ini >= 0 && P.nodes[ini] is ObjLit { return ini }
  }
  -1
}

// The checked type of the parameter the argument `argIx` of call `c` is passed to, or -1. A
// `.push` stores its argument as the receiver list's element.
export function rsCallParamTy(c: Call, argIx: i32): i32 {
  const cf = P.nodes[unwrapParen(c.callFn)]
  if cf is Member {
    if cf.memProp == "push" {
      return tyRefArrElemOf(nodeTyIxOf(unwrapParen(cf.memObj)))
    }
    // `m.set(k, v)` stores `v` at the map's value type, as `m[k] = v` does (D3195).
    if cf.memProp == "set" && c.callArgs.length == 2 {
      const mt = nonNullTy(nodeTyIxOf(unwrapParen(cf.memObj)))
      if mt >= 0 && mt < T.tys.length {
        const m = T.tys[mt]
        if m is TyMap {
          if m.mSet != 0 || unwrapParen(c.callArgs[1]) != argIx { return -1 }
          return m.mVal
        }
      }
    }
  }
  const ft = nodeTyIxOf(c.callFn)
  if ft < 0 || ft >= T.tys.length { return -1 }
  const t = T.tys[ft]
  if t is TyFunc {
    let k = 0
    while k < c.callArgs.length {
      if unwrapParen(c.callArgs[k]) == argIx {
        if k < t.fnParamTypes.length { return t.fnParamTypes[k] }
        return -1
      }
      k = k + 1
    }
  }
  -1
}

// Whether the value at `ix`, whose parent node is `par`, is what function `fr` returns:
// a `return` operand or the tail of its body.
export function rsIsReturned(ix: i32, par: i32, fr: i32): boolean {
  if fr < 0 { return false }
  if P.nodes[par] is RetStmt { return true }
  const fd = P.nodes[fr]
  if fd is FuncDecl {
    if par == fr { return unwrapParen(fd.fnBody) == ix }
    if par == fd.fnBody { return rsIsLastStmt(par, ix) }
  }
  false
}

// Whether the node at `ix` is a `let` or `const` with no annotation.
export function rsLetUnannotated(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const d = P.nodes[ix]
  if d is LetDecl { return d.letType < 0 }
  false
}

// Whether `ix` is the last statement of the block at `bx`.
export function rsIsLastStmt(bx: i32, ix: i32): boolean {
  const b = P.nodes[bx]
  if b is Block {
    const n = b.blkStmts.length
    return n > 0 && unwrapParen(b.blkStmts[n - 1]) == ix
  }
  false
}

// The struct row a ref-list slot's element is, `| null` peeled, or -1.
export function rsSlotRow(slot: i32): i32 {
  if slot < 0 || slot >= rlElemName.length { return -1 }
  const a = rlElemStructIdxAt(slot)
  if a >= 0 { return a }
  structIdxOfElemName(rlElemName[slot])
}

// Whether struct rows `a` and `b` share one heap type.
export function rsSameRow(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return false }
  repStructSlotsTwin(a, b) == 1
}

// Whether ref lists `a` and `b` hold records of two different heap types, both known.
export function rsRowsDiffer(a: i32, b: i32): boolean {
  const ra = rsSlotRow(a)
  const rb = rsSlotRow(b)
  if ra < 0 || rb < 0 { return false }
  !rsSameRow(ra, rb)
}

// Whether ref-list `slot` holds the re-seated row, nullable or not.
export function rsSlotIsRow(slot: i32, w: RsWalk): boolean {
  rsSameRow(rsSlotRow(slot), w.rwRow)
}

// Whether arena type `ty` is the re-seated row, nullable or not.
export function rsTyIsRow(ty: i32, w: RsWalk): boolean {
  if ty < 0 { return false }
  rsSameRow(structIdxOfElemTy(ty), w.rwRow)
}

// Whether two or more struct rows carry exactly the field names of the object literal at `ix`:
// with one, the row the literal picks is the only one a destination can name either.
export function objLitNamesTwoRows(ix: i32): boolean {
  const o = P.nodes[ix]
  if o is ObjLit {
    const nf = o.objFields.length
    let hits = 0
    const cands = objLitNameCands(o, sScanLim())
    let ci = 0
    while ci < cands.length {
      const si = cands[ci]
      if sFieldCount[si] == nf {
        let ok = true
        let k = 0
        while k < nf && ok {
          const f = P.nodes[o.objFields[k]]
          if f is FieldInit {
            if sFieldIndex(si, f.fiName) < 0 { ok = false }
          } else {
            ok = false
          }
          k = k + 1
        }
        if ok { hits = hits + 1 }
        if hits >= 2 { return true }
      }
      ci = ci + 1
    }
  }
  false
}

// The bound `LetDecl`'s own name, or "" out of range / not a let.
export function letBoundName(letIx: i32): string {
  if letIx < 0 || letIx >= P.nodes.length { return "" }
  const d = P.nodes[letIx]
  if d is LetDecl { return d.letName }
  ""
}

// The scope a name-matched destination scan has to stay inside (D661), as an arena index to
// start the walk at, or -1 when this binding's scope is not knowable here. A local's first
// binding walks the body, a later same-named one the block holding it (D2685), a global the
// program; otherwise decline, keeping the whole-arena scan rather than miss a destination.
export function dsScopeRootOf(letIx: i32, nm: string, fnIx: i32): i32 {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      if parentLetOf(fn.fnBody, nm) == letIx { return fn.fnBody }
      const own = parentLetOwnerOf(fn.fnBody, sidOfNode(letIx), letIx)
      if own >= 0 { return own }
    }
  }
  if globalLetOf(nm) == letIx {
    if emitRootIx >= 0 {
      const r = P.nodes[emitRootIx]
      if r is Program { return emitRootIx }
    }
  }
  -1
}

// Does the nested function at `fIx` rebind `nm`? Then its body's uses of the name denote its
// own binding, never the one being classified, so the walk must not enter it. Both binding
// forms a function introduces — a `const nm = …` anywhere in the body, and a parameter named
// `nm` — since either alone leaks.
export function dsRebindsName(fIx: i32, nm: string): boolean {
  const fn = P.nodes[fIx]
  if fn is FuncDecl {
    if parentLetOf(fn.fnBody, nm) >= 0 { return true }
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parName == nm { return true }
      }
      i = i + 1
    }
  }
  false
}

// The destination sites a module global's name is read at, in `dsScopeWalk`'s own pre-order.
// Rows are (arena node, enclosing `FuncDecl`), chained per symbol through `dsgHead`/`dsgTail`;
// a row whose frame is -1 sits outside every function and takes the asking call's own. Only a
// global's name gets rows, since `dsScopeRootOf` roots a walk at `Program` for nothing else.
export let dsgNode: i32[] = []
export let dsgFrame: i32[] = []
export let dsgNext: i32[] = []
export let dsgHead: i32[] = []
let dsgTail: i32[] = []

// The arena the rows describe: the `Program` node the index walk started at, and the node
// count it saw. Every field a row holds is an arena index, so a different program or a grown
// arena rebuilds. `dsgRoot` -1 is no index.
let dsgRoot: i32 = -1
let dsgLen: i32 = -1

// The `FuncDecl` chain the index walk is inside, outermost first.
let dsgStack: i32[] = []

// Drops the global-destination index. Sid-keyed and arena-keyed both, so it rides
// `sidKeyedTablesReset` with its siblings: a surviving row would name the previous program's
// node under this program's symbol.
export function sidResetGlobalDestIx() {
  dsgNode = []
  dsgFrame = []
  dsgNext = []
  dsgHead = []
  dsgTail = []
  dsgStack = []
  dsgRoot = -1
  dsgLen = -1
  0
}

// True where a frame the index walk is inside binds `nm`: `dsScopeWalk` stops at such a frame,
// so a site under one denotes that frame's binding and never the global's.
function dsgStackRebinds(nm: string): boolean {
  let i = 0
  while i < dsgStack.length {
    if dsRebindsName(dsgStack[i], nm) { return true }
    i = i + 1
  }
  false
}

// Adds a row for symbol `sid` read at node `ix` inside `frame`. Declines a name no global
// binds and a site the walk could not reach; the tail test drops the repeat a node that reads
// one name twice would otherwise add.
function dsgAdd(sid: i32, ix: i32, frame: i32) {
  if sid < 0 { return 0 }
  if globalLetOfSid(sid) < 0 { return 0 }
  const t = sidArrGet(dsgTail, sid)
  if t >= 0 {
    if dsgNode[t] == ix { return 0 }
  }
  if dsgStackRebinds(sidText(sid)) { return 0 }
  const row = dsgNode.length
  dsgNode.push(ix)
  dsgFrame.push(frame)
  dsgNext.push(-1)
  if t >= 0 { dsgNext[t] = row } else { sidArrPut(dsgHead, sid, row) }
  sidArrPut(dsgTail, sid, row)
  0
}

// Adds a row for `ix` where `c` unwraps to an identifier. `dsDestSlotAt` reads every
// destination through one `unwrapParen`, so a site behind parentheses is the same site.
function dsgNoteIdent(c: i32, ix: i32, frame: i32) {
  if c < 0 || c >= P.nodes.length { return 0 }
  const u = unwrapParen(c)
  if u < 0 || u >= P.nodes.length { return 0 }
  const n = P.nodes[u]
  if n is Ident { return dsgAdd(sidOfNode(u), ix, frame) }
  0
}

// Records `ix` against every name read at child `c` where `dsDestSlotAt` can see one: a list
// literal's elements, an object literal's field values, or — every other child shape — the
// child itself. A superset of that reader's seven forms, and it re-runs at the lookup, so a
// form added there needs an arm here only where it reads its name deeper.
function dsgNoteChild(c: i32, ix: i32, frame: i32) {
  if c < 0 || c >= P.nodes.length { return 0 }
  const u = unwrapParen(c)
  if u < 0 || u >= P.nodes.length { return 0 }
  const n = P.nodes[u]
  if n is ArrayLit {
    let i = 0
    while i < n.arrElems.length {
      dsgNoteIdent(n.arrElems[i], ix, frame)
      i = i + 1
    }
    return 0
  }
  if n is ObjLit {
    let i = 0
    while i < n.objFields.length {
      const f = P.nodes[n.objFields[i]]
      if f is FieldInit { dsgNoteIdent(f.fiValue, ix, frame) }
      i = i + 1
    }
    return 0
  }
  dsgNoteIdent(c, ix, frame)
}

// One pre-order pass over the program filling the index. It descends where `dsScopeWalk`
// prunes and drops the site at its row instead, so the one pass answers for every name.
function dsgWalk(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  let pushed = false
  if ix != dsgRoot {
    if n is FuncDecl {
      dsgStack.push(ix)
      pushed = true
    }
  }
  let frame = -1
  if dsgStack.length > 0 { frame = dsgStack[dsgStack.length - 1] }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990); each link
  // still notes every child, the next link included, before walking its own.
  let cur = ix
  while cur >= 0 {
    const kids = nodeChildren(cur)
    let k = 0
    while k < kids.length {
      dsgNoteChild(kids[k], cur, frame)
      k = k + 1
    }
    const walk = nodeSpineChildren(cur)
    k = 0
    while k < walk.length {
      dsgWalk(walk[k])
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  if pushed { dsgStack.pop() }
  0
}

// Builds the index where the arena has moved since the last one. Declines while
// the `arenaFinal` phase is not reached, since a synth pass can re-point a body in place and no node
// count would show it; the caller keeps the walk there.
export function dsgReady(): boolean {
  if !emitPhaseReached("arenaFinal") { return false }
  if emitRootIx < 0 { return false }
  if dsgRoot == emitRootIx && dsgLen == P.nodes.length { return true }
  sidResetGlobalDestIx()
  dsgRoot = emitRootIx
  dsgWalk(emitRootIx)
  dsgLen = P.nodes.length
  true
}

// The `LetDecl` a destination NAME resolves to — the enclosing function's own binding
// first, then a module global. `letRefListDestSlot`'s two name-addressed forms (the map
// store and the assignment) share it.
export function destLetOf(name: string, fnIx: i32): i32 {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOf(fn.fnBody, name)
      if li >= 0 { return li }
    }
  }
  globalLetOf(name)
}

// The kind-2 ref-list slot the declared map binding `name` holds as its value, or -1. Read
// off the annotation, not the map's interned shape: with the literal declared before the map,
// `collectLocals` sees -1 for the binding's cell while emit (after the full intern pass) sees
// a real slot for the build, so the two halves of one landing would disagree — a genuine order dependence.
export function mapValKindListSlot(name: string, fnIx: i32, want: i32): i32 {
  const li = destLetOf(name, fnIx)
  if li < 0 { return -1 }
  const d = P.nodes[li]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        const vn = mapValNameOf(lt.tyName)
        if vn != "" {
          const en = refArrElemNameIf(vn)
          if en != "" {
            const rs = rlSlotByName(en)
            if rlSlotIsKindList(rs, want) { return rs }
          }
        }
      }
    }
  }
  -1
}

// The ref-list slot of element kind `want` NESTED inside `slot`, or -1: a list-of-lists
// row (element kind 9) holds its inner list's slot, and that inner list is the destination
// forms (b) and (c) hand this binding.
export function rlInnerKindListSlot(slot: i32, want: i32): i32 {
  if slot < 0 { return -1 }
  if slot >= rlElemKindTbl.length { return -1 }
  if rlElemKindTbl[slot] != RLK_REF_LIST { return -1 }
  const iv = rlElemInnerSlot(slot)
  if rlSlotIsKindList(iv, want) { return iv }
  -1
}

// True when `slot` is a live ref-list row whose element kind is `want` — 2 is the union box,
// 1 a plain struct-row element. Takes the kind as a parameter (D411) so every destination
// helper in this cluster and the two-destination conflict detector read the same seven forms
// arm for arm — a form added later cannot reach only one reading.
export function rlSlotIsKindList(slot: i32, want: i32): boolean {
  if slot < 0 { return false }
  if slot >= rlElemKindTbl.length { return false }
  rlElemKindTbl[slot] == want
}

// The `pendingListKind` code and `pendingListSlot` table slot a `LetDecl`'s list initializer
// builds with. One record, resolved once: the destination walk answers both halves, and the
// binding's cell and its literal's build must read one answer or the module is invalid at a
// different offset. `letRefListSlot` is the cell's half.
export type ListBuild = { lbKind: i32, lbSlot: i32 }

// The ref-list slot of element kind `want` that parameter `argIx` of the named function
// declares, or -1. There is no function-by-name index in the arena, so this scans — reached
// only from `letRefListDestSlot` form (d), bounded by that binding's call sites rather than
// by arena size.
export function fnParamKindListSlot(
  fnName: string,
  argIx: i32,
  want: i32,
): i32 {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is FuncDecl {
      if nd.fnName == fnName { return fnDeclParamKindListSlot(i, argIx, want) }
    }
    i = i + 1
  }
  -1
}

// The ref-list slot of element kind `want` that parameter `argIx` of the `FuncDecl` at
// `fdIx` declares, or -1 when it declares none or `fdIx` is not a function.
function fnDeclParamKindListSlot(fdIx: i32, argIx: i32, want: i32): i32 {
  if fdIx < 0 || fdIx >= P.nodes.length { return -1 }
  const nd = P.nodes[fdIx]
  if nd is FuncDecl {
    if argIx < nd.fnParams.length {
      const p = P.nodes[nd.fnParams[argIx]]
      if p is Param {
        if tyAnnRefListKind(p.parType) == want {
          const rs = tyAnnRefListSlot(p.parType)
          if rlSlotIsKindList(rs, want) { return rs }
        }
      }
    }
  }
  -1
}

// `dsCalleeParamSlot`'s answer when no binding in scope names the callee, so the name can
// only denote a top-level function.
export const DS_CALLEE_UNBOUND = -2

// The ref-list slot of kind `want` that parameter `argIx` of the callee `name` declares, where
// `name` is a binding in scope at `callIx` inside frame `fnIx`: a lambda-valued `const`, a
// function-typed parameter or annotation, or a `const` naming a top-level function. -1 when
// the binding declares none; `DS_CALLEE_UNBOUND` when nothing in scope binds `name` (D2696).
export function dsCalleeParamSlot(
  name: string,
  callIx: i32,
  fnIx: i32,
  argIx: i32,
  want: i32,
): i32 {
  let b = -1
  if fnIx >= 0 && fnIx < P.nodes.length {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { b = bodyLetReadAtSid(fn.fnBody, sidOf(name), callIx) }
  }
  if b < 0 { b = identBindingNoLocal(fnIx, name, -1) }
  if b < 0 { b = globalLetOf(name) }
  if b < 0 || b >= P.nodes.length { return DS_CALLEE_UNBOUND }
  const bn = P.nodes[b]
  if bn is Param {
    if bn.parType < 0 { return dsLamParamCalleeSlot(b, fnIx, argIx, want) }
    return fnTyAnnParamKindListSlot(bn.parType, argIx, want)
  }
  dsLetCalleeParamSlot(b, fnIx, argIx, want)
}

// `dsCalleeParamSlot` for an un-annotated parameter `parIx` of the lambda or nested function
// `lamIx`: the checker leaves its type open, so the function a call of it hands that parameter
// is the callee, and its parameter `argIx` is the destination (D2748). -1 when none is found.
function dsLamParamCalleeSlot(
  parIx: i32,
  lamIx: i32,
  argIx: i32,
  want: i32,
): i32 {
  if lamIx < 0 || lamIx >= P.nodes.length { return -1 }
  const lam = P.nodes[lamIx]
  if !(lam is FuncDecl) { return -1 }
  let pi = 0
  while pi < lam.fnParams.length && lam.fnParams[pi] != parIx { pi = pi + 1 }
  if pi >= lam.fnParams.length { return -1 }
  const pp = fnStmtsPosOf(lamIx)
  if pp < 0 || pp >= fnParent.length { return -1 }
  const up = fnParent[pp]
  let scope = emitRootIx
  if up >= 0 && up < fnStmts.length {
    const pf = P.nodes[fnStmts[up]]
    if pf is FuncDecl { scope = pf.fnBody }
  }
  if scope < 0 { return -1 }
  dslEnsure(scope)
  let nm = ""
  const lr = dslLamRow[lamIx]
  if lr is i32 { nm = dslLamName[lr] }
  if nm == "" { nm = lam.fnName }
  if nm == "" { return -1 }
  const h = dslCallHead[nm]
  let r = -1
  if h is i32 { r = h }
  while r >= 0 && r < dslCallIx.length {
    const c = P.nodes[dslCallIx[r]]
    if c is Call {
      if (
        pi < c.callArgs.length
        && !dslFrameRebinds(dslCallFrame[r], scope, nm)
      ) {
        const rs = fnTyParamKindListSlot(
          nodeTyIxOf(c.callArgs[pi]),
          argIx,
          want,
        )
        if rs >= 0 { return rs }
      }
    }
    r = dslCallNext[r]
  }
  -1
}

// One scope's lambda bindings and named calls, in walk order: the index `dsLamParamCalleeSlot`
// reads, so a scope holding many lambdas is walked once rather than once per lambda. Kept
// across queries only once the arena is final (the `arenaFinal` phase), and rebuilt per query before.
let dslRoot = -1
let dslLen = -1
let dslLamRow: {[i32]: i32} = Map()
let dslLamName: string[] = []
let dslCallHead: {[string]: i32} = Map()
let dslCallTail: {[string]: i32} = Map()
let dslCallIx: i32[] = []
let dslCallFrame: i32[] = []
let dslCallNext: i32[] = []

// Forgets the index at compile start: a new program's scope can share the old one's node
// index and arena length.
export function dslReset() {
  dslRoot = -1
  dslLen = -1
  0
}

// Builds the index for `scope` unless the one in hand already is it.
function dslEnsure(scope: i32) {
  if !emitPhaseReached("arenaFinal") { dslRoot = -1 }
  if dslRoot == scope && dslLen == P.nodes.length { return 0 }
  dslRoot = scope
  dslLen = P.nodes.length
  dslLamRow = Map()
  dslLamName = []
  dslCallHead = Map()
  dslCallTail = Map()
  dslCallIx = []
  dslCallFrame = []
  dslCallNext = []
  dslWalk(scope, -1)
}

// Records the lambda bindings and named calls under `ix`; `frame` is the nearest enclosing
// function inside the scope, -1 at the scope's own level.
function dslWalk(ix: i32, frame: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  let fr = frame
  if n is LetDecl {
    const li = unwrapParen(n.letInit)
    if li >= 0 && li < P.nodes.length {
      if P.nodes[li] is FuncDecl {
        dslLamRow[li] = dslLamName.length
        dslLamName.push(n.letName)
      }
    }
  } else if n is FuncDecl {
    fr = ix
  } else if n is Call {
    const cf = P.nodes[unwrapParen(n.callFn)]
    if cf is Ident {
      const row = dslCallIx.length
      dslCallIx.push(ix)
      dslCallFrame.push(frame)
      dslCallNext.push(-1)
      const t = dslCallTail[cf.identName]
      if t is i32 {
        dslCallNext[t] = row
      } else {
        dslCallHead[cf.identName] = row
      }
      dslCallTail[cf.identName] = row
    }
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    dslWalk(kids[k], fr)
    k = k + 1
  }
  0
}

// Whether a function between the call's frame `frame` and the scope `scope` rebinds `nm`, so
// the call names that binding rather than the lambda's `const`.
function dslFrameRebinds(frame: i32, scope: i32, nm: string): boolean {
  let pp = fnStmtsPosOf(frame)
  let steps = 0
  while pp >= 0 && pp < fnStmts.length && steps < 64 {
    const fx = fnStmts[pp]
    const fn = P.nodes[fx]
    if fn is FuncDecl {
      if fn.fnBody == scope { return false }
    }
    if dsRebindsName(fx, nm) { return true }
    if pp >= fnParent.length { return false }
    pp = fnParent[pp]
    steps = steps + 1
  }
  false
}

// `dsCalleeParamSlot` for a callee bound by the `LetDecl` at `b`: its function-type
// annotation, else a lambda initializer's own parameter, else an alias's; -1 for any other
// binding (a `for` variable, a let bound to a value this scan cannot follow).
function dsLetCalleeParamSlot(b: i32, fnIx: i32, argIx: i32, want: i32): i32 {
  const d = P.nodes[b]
  if !(d is LetDecl) { return -1 }
  if d.letType >= 0 { return fnTyAnnParamKindListSlot(d.letType, argIx, want) }
  if d.letInit < 0 { return -1 }
  const ini = unwrapParen(d.letInit)
  if ini < 0 || ini >= P.nodes.length { return -1 }
  if P.nodes[ini] is FuncDecl {
    return fnDeclParamKindListSlot(ini, argIx, want)
  }
  dsAliasCalleeParamSlot(ini, fnIx, argIx, want)
}

// A `const k = sum` alias: the top-level function it names, when no scope around `fnIx`
// rebinds that name; -1 for any other initializer.
function dsAliasCalleeParamSlot(
  ini: i32,
  fnIx: i32,
  argIx: i32,
  want: i32,
): i32 {
  const iv = P.nodes[ini]
  if iv is Ident {
    if nameFreeToModule(fnIx, iv.identName) {
      return fnParamKindListSlot(iv.identName, argIx, want)
    }
  }
  -1
}

// The ref-list slot of kind `want` that parameter `argIx` of the function-type annotation
// node `tyNodeIx` (`(Shape[]) => i32`) names, read off its recorded type; -1 otherwise.
function fnTyAnnParamKindListSlot(tyNodeIx: i32, argIx: i32, want: i32): i32 {
  if tyNodeIx < 0 { return -1 }
  fnTyParamKindListSlot(nodeTyIxOf(tyNodeIx), argIx, want)
}

// `fnTyAnnParamKindListSlot` of the function type `ft` itself; -1 when `ft` is not one.
export function fnTyParamKindListSlot(ft: i32, argIx: i32, want: i32): i32 {
  if ft < 0 || ft >= T.tys.length { return -1 }
  const t = T.tys[ft]
  if t is TyFunc {
    if argIx < t.fnParamTypes.length {
      const rs = rlSlotOfTy(tyRefArrElemOf(t.fnParamTypes[argIx]))
      if rlSlotIsKindList(rs, want) { return rs }
    }
  }
  -1
}

// The ref-list element kind a `LetDecl`'s ANNOTATION declares (`S[]` → 1, `N[]` → 2),
// or `0` when it is not a ref-array annotation. Types an empty `[]` initializer
// (a non-empty literal types itself from its elements).
export function letAnnRefListKind(letIx: i32) {
  // `pendingListKind` semantics: 1 = struct/map ref list, 2 = union box, 3 = string list.
  // Delegates to `tyAnnRefListKind` so the let/return/call-arg/global seeds agree.
  const d = P.nodes[letIx]
  if d is LetDecl {
    const k = tyAnnRefListKind(d.letType)
    if k == LBK_I32_LIST {
      // An un-annotated empty `[]` whose pushes infer a string element seeds the
      // string-list kind, so the literal builds the string-list wrapper, not the i32 default.
      if letInfStrListByUse(letIx) { return LBK_STR_LIST }
    }
    return k
  }
  LBK_I32_LIST
}

// The struct table index a `LetDecl`'s annotation names (`let b: B = { … }` → B's index), or
// -1 when un-annotated or the annotation names a non-struct. Threads `pendingStructIdx` so an
// annotated struct literal builds the annotation's struct over a first-field-name match; an
// un-annotated `let` is left to the literal's own field shape.
export function letAnnStructIdx(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // The arena, as an index rather than a boolean: `structIndexOfTy` (`sTyRow[ty]`) is a
      // real table lookup, unlike its variant sibling below, which has no arena analogue.
      const si = structIndexOfTy(nodeTyIxOf(d.letType))
      if si >= 0 { return si }
      const lt = P.nodes[d.letType]
      if lt is TypeRef { return structIndexOfTypeName(lt.tyName) }
    }
  }
  -1
}

// The union-VARIANT table index a `LetDecl`'s annotation names (`const c: Cat`), or -1.
// Seeds `pendingVariantIdx` so the object-literal init builds the bare variant (kind 8).
export function letAnnVariantIdx(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        const lav = variantIndexOf(lt.tyName)
        if lav >= 0 { return lav }
        // `Circle | null` seeds the same concrete variant the bare `Circle` annotation does:
        // the niche's non-null payload is a variant struct, so a literal must build that heap type.
        return nulVariantIndexOf(d.letType)
      }
    }
  }
  -1
}

// ── f64-array-typedness of expressions (Slice 4) ────────────────────────────────

// Parallel to the i32/string-array families: decide whether an expression / param / local
// produces an `f64[]` list. Drives the index-read dispatch and the f64-list cell kind (`12`).

// The scalar-list wrapper kind of an array type whose element rides a scalar list's backing
// without being a `TyPrim` — `"list"` for a literal-union `K[]` and its nullable niches (the
// i32 list), `"strlist"` for the `(string | null)[]` ref niche — else `null`. The arena fold
// of the same identity the name-side ladders have long used: all these wrappers are one heap type.
export function tyScalarBackedListKind(tyIx: i32): VKind | null {
  if tyIx < 0 { return null }
  const t = T.tys[tyIx]
  if t is TyArray {
    if t.aElem < 0 { return null }
    if tyIsLitUnion(t.aElem) { return "list" }
    // The two i32-sentinel niches, through the shared predicate `==`/`+` also read — the
    // answer set is unchanged, only the three homes deciding "one i32 cell" collapse to one. D101.
    if tyIsI32SentinelNullable(t.aElem) { return "list" }
    const el = T.tys[t.aElem]
    if el is TyNullable {
      const inner = T.tys[el.nInner]
      if inner is TyPrim {
        if inner.primName == "string" { return "strlist" }
      }
    }
  }
  null
}

// How a `%` node votes on the `__f64_rem__` reservation, in the vocabulary `scanPrintUse`
// needs: 1 = float (the helper must exist), 0 = definitely integer, -1 = the checker recorded
// no scalar type for this node. -1 is not a defensive floor — a monomorphized instance body
// carries its original's type, which is exactly this case. D1586.
export function binRemFloatNeed(ix: i32): i32 {
  const k = tyKindOf(nodeTyIxOf(ix))
  if k == TK_F64 || k == TK_F32 { return 1 }
  if k == TK_I32 || k == TK_I64 { return 0 }
  if !numUnionMinted || !tyIsNumUnion(nodeTyIxOf(ix)) { return -1 }
  for m in numUnionMembersOf(nodeTyIxOf(ix)) {
    const mk = tyKindOf(m)
    if mk == TK_F64 || mk == TK_F32 { return 1 }
  }
  0
}

// `repOfTy`'s answer as a report word: the covered `VKind`, or `uncovered` where the
// descriptor declines. The oracle's right-hand column, and the only place the two answers
// meet — a consumer still reads whichever producer its own site names.
function repABDescWord(tyIx: i32): string {
  const d = repOfTy(tyIx)
  if d.rdCovered == 1 { return d.rdKind }
  "uncovered"
}

// The codes `tyKindOf` answers: the scalars and scalar lists an arena type reps as, or -1.
// Numbered like the map value kinds (`MVK_*`) at 3, 10, 11 and 13 and nowhere else, so
// neither set's names stand for the other's integers.
const TK_I32 = 0
const TK_LIST = 2 // the i32-backed list
export const TK_STR = 3
const TK_STR_LIST = 7
export const TK_I64 = 10
export const TK_F64 = 11
const TK_F64_LIST = 12
export const TK_F32 = 13
const TK_I64_LIST = 20

// `tyKindOf`'s own i32 code as a report word — the third rep numbering scheme this campaign
// retires, named here so the oracle's report reads in one vocabulary.
function tyKindCodeWord(k: i32): string {
  if k == TK_I32 { return "i32" }
  if k == TK_LIST { return "list" }
  if k == TK_STR { return "str" }
  if k == TK_STR_LIST { return "strlist" }
  if k == TK_I64 { return "i64" }
  if k == TK_F64 { return "f64" }
  if k == TK_F64_LIST { return "f64list" }
  if k == TK_F32 { return "f32" }
  if k == TK_I64_LIST { return "i64list" }
  "declined"
}

// The nine codes this vocabulary speaks, as a projection of the ONE descriptor. Every kind
// outside them keeps the decline (-1) every consumer's `== <code>` test expects — answering
// a code the consumer has no arm for is a new answer, not the same one.
function tyKindCodeOfVKind(k: VKind): i32 {
  if k == "i32" { return TK_I32 }
  if k == "list" { return TK_LIST }
  if k == "str" { return TK_STR }
  if k == "strlist" { return TK_STR_LIST }
  if k == "i64" { return TK_I64 }
  if k == "f64" { return TK_F64 }
  if k == "f64list" { return TK_F64_LIST }
  if k == "f32" { return TK_F32 }
  if k == "i64list" { return TK_I64_LIST }
  -1
}

// The list code whose ELEMENT reps as `k` — the numeric-literal-union element collapse's only
// consumer, since the descriptor declines the collapsed array itself.
function tyKindListCodeOfElem(k: i32): i32 {
  if k == TK_I32 { return TK_LIST }
  if k == TK_STR { return TK_STR_LIST }
  if k == TK_I64 { return TK_I64_LIST }
  if k == TK_F64 { return TK_F64_LIST }
  -1
}

// The descriptor's answer in this vocabulary, or -1 where the descriptor declines.
function tyKindCodeOfTy(tyIx: i32): i32 {
  const d = repOfTy(tyIx)
  if d.rdCovered == 0 { return -1 }
  tyKindCodeOfVKind(d.rdKind)
}

// A primitive's code: the descriptor's answer for it, read off the name rather than built,
// since every literal and scalar operand asks. `void` is the one prim the descriptor reps (as
// `i32`) that this vocabulary never has, a void expression having no width to report.
function tyKindCodeOfPrim(pn: PrimName): i32 {
  match pn {
    "i32" | "boolean" => {
      return TK_I32
    }
    "i64" => {
      return TK_I64
    }
    "f64" => {
      return TK_F64
    }
    "f32" => {
      return TK_F32
    }
    "string" => {
      return TK_STR
    }
    "void" | "null" | "never" | "u8" | "v128" => {
      return -1
    }
  }
}

export function tyKindOf(tyIx: i32) {
  const k = tyKindOfDesc(tyIx)
  if repShadowOn {
    repABNote("tyKindOf", tyKindCodeWord(k), repABDescWord(tyIx))
  }
  k
}

// The arena's rep for `tyIx` in the legacy i32 code vocabulary, as a PROJECTION of the one
// descriptor. Two facts stay here because they are this function's contract, not the rep: its
// DOMAIN (scalars and arrays — every other shape keeps its decline), and the numeric
// literal-union base collapse the descriptor deliberately does not model.
function tyKindOfDesc(tyIx: i32): i32 {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if t is TyPrim { return tyKindCodeOfPrim(t.primName) }
  if t is TyArray {
    if t.aElem < 0 { return -1 }
    // A NUMERIC literal-union element reps as its base scalar's list; the descriptor declines
    // the collapse (the atom-vs-base split is checker metadata, not structure), so it is taken
    // here off the element's own code.
    const eb = numLitUnionBaseTy(t.aElem)
    if eb >= 0 { return tyKindListCodeOfElem(tyKindOfDesc(eb)) }
    // A STRING literal-union element is the interned i32 atom, which the descriptor reps as
    // the i32 `list` and this vocabulary has never claimed — see open-rulings
    // "one-literal-union-rep", whose answer decides whether this decline survives.
    if tyIsLitUnion(t.aElem) { return -1 }
    return tyKindCodeOfTy(tyIx)
  }
  // A numeric literal type or union has no rep of its own — it reps as its base scalar.
  let litBaseRow = -1
  if t is TyLit { litBaseRow = numLitUnionBaseTy(tyIx) }
  if t is TyUnion { litBaseRow = numLitUnionBaseTy(tyIx) }
  if litBaseRow >= 0 { return tyKindOfDesc(litBaseRow) }
  -1
}

// TYPED-IR consumer: is the type the checker recorded for `tyIx` an `f64[]`? Lets the emitter
// recognize an f64 list the SYNTACTIC predicates miss (e.g. an `f64[]`-returning call, which
// `calleeRetKind` doesn't map to a list kind) without a bespoke per-position predicate.
function tyIsF64Array(tyIx: i32) { tyKindOf(tyIx) == TK_F64_LIST }

// The `pendingListKind` a literal stored into a field of code `code` builds at, when the field
// is a non-null list over a distinct scalar backing; -1 for every other field code.
export function fieldCodeScalarListBuildKind(code: i32): i32 {
  const k = listRepOfFieldCode(code)
  if !isScalarBackedListRep(k) { return -1 }
  listBuildKindOfVKind(k, -1)
}

// The scalar list rep the recorded type `pin` of `exprIx` names, in `tyKindOf`'s vocabulary,
// read off its descriptor `rd`. The i32 list is read off the unpinned type, and never for a
// spread literal, whose rep is its source's rather than the type the literal adopted.
export function arenaListRep(exprIx: i32, pin: i32, rd: RepDesc): VKind | null {
  if pin >= 0 {
    if T.tys[pin] is TyArray {
      if tyIsU8ArrayTy(pin) { return "u8list" }
      const k = arrayKindCode(pin, rd)
      if k == TK_STR_LIST { return "strlist" }
      if k == TK_F64_LIST { return "f64list" }
      if k == TK_I64_LIST { return "i64list" }
    }
  }
  if arrLitHasSpread(exprIx) { return null }
  const raw = nodeTyIxOf(exprIx)
  if raw >= 0 {
    if T.tys[raw] is TyArray {
      if raw == pin {
        if arrayKindCode(raw, rd) == TK_LIST { return "list" }
      } else {
        if tyKindOf(raw) == TK_LIST { return "list" }
      }
    }
  }
  null
}

// `tyKindOf(ty)` for an array type `ty` whose descriptor `rd` is already in hand.
function arrayKindCode(ty: i32, rd: RepDesc): i32 {
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 { return -1 }
    if numLitUnionBaseTy(t.aElem) >= 0 { return tyKindOf(ty) }
    if tyIsLitUnion(t.aElem) { return -1 }
    if rd.rdCovered == 0 { return -1 }
    return tyKindCodeOfVKind(rd.rdKind)
  }
  -1
}

// ── i64-array typedness (the i64 sibling of the f64-array family) ───────────────

// Mirrors the f64 predicates over the i64-list rep (code 20, wrapper `il64TypeIdx`). The
// typed-IR fast path carries annotated cases; the syntactic fallback covers a
// monomorphized body whose nodes have no recorded type.
function tyIsI64Array(tyIx: i32) { tyKindOf(tyIx) == TK_I64_LIST }
