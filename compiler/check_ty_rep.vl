// `check_ty_rep.vl` — rep queries over the type arena `T`: how a type is stored.
// Whether a union is a value box and which value-atom kinds its leaves carry, the map key
// kind and value cell tag, the element store class and escape class, a nullable's niche, the
// array spine's leaf, the nominal base a newtype erases to, and the emit names of the union
// spellings the emitter keys on. Nothing here reads a node, the scope chain or `tErr`; the
// only state is the scratch lists the atom-kind walks fill.

import { i32ToStr } from "./ast"
import {
  flattenVariantsInto,
  isNulBoolTy,
  isNullTy,
  isNumericPrimTy,
  isStringTy,
  nonNullTy,
  nulLitUnionPeelTy,
  numLitUnionHasBase,
  primNameOf,
  tyExcludesNull,
  tyHasV128Member,
  tyReachesHole,
  unionSoleNonNullMember,
} from "./tyquery"
import {
  RC_UNION_KEY,
  T,
  TY_I32,
  TY_I64,
  TY_STR,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  cUserTypes,
  genAppNameOfTy,
  litBaseTy,
  nomNameCycle,
  numLitUnionBaseName,
  numLitUnionBaseTy,
  nwBaseTyIxs,
  nwTyIxs,
  oneListUnionRender,
  structNameOfTy,
  tyIsLitUnion,
  tyIsNicheNulScalarElem,
  tyIsNullableLitUnion,
  tyIsPrimNamed,
  tyLitUnionHashesI32,
  tyNameAtoms,
  tyNulNumScalarValKind,
  tyPrimNameOf,
  tyPrintsAsRef,
  tyToEmitName,
  tyToEmitNameAt,
  tyToNominalNameAt,
  unionAliasDeclNameOfTy,
} from "./check_types"
import {
  arrElemNameRaw,
  listElemNameOf,
  nameIsFuncTypeAtom,
  nameIsQuotedLeaf,
  roListInnerName,
  spanEqAt,
  splitUnionAtoms,
  tyTopIndexOf,
  unionMemberCount,
} from "./tyname"

// The one home of which hash a `Map`/`Set` key takes: the rep has exactly three, `string`
// (element-wise, `__str_hash__`), `i32` and `i64` (the integer mixes). Answers the arena type the
// keys hash as, or -1 for a key the rep cannot hold, and every gate projects this answer. The test
// is the LOWERING, so a newtype hashes as its base and a literal union as the i32 it reps as (D1748).
export function mapKeyRepTy(k: i32) {
  if tyIsPrimNamed(k, "i32") { return TY_I32 }
  if tyIsPrimNamed(k, "string") { return TY_STR }
  if tyIsPrimNamed(k, "i64") { return TY_I64 }
  if tyLitUnionHashesI32(k) { return TY_I32 }
  // A numeric literal union over `i64` reps as that base, so it hashes as an i64 key.
  if numLitUnionBaseTy(k) == TY_I64 { return TY_I64 }
  -1
}

// The key rep of a map key type as the emitter's key kind: `MAP_KEY_STR`, `MAP_KEY_I32` or
// `MAP_KEY_I64`. A key the rep cannot hold answers the string kind, which is where every gate
// that projected `mapKeyRepTy(k) == TY_I32` already sent it.
export const MAP_KEY_STR = 0
export const MAP_KEY_I32 = 1
export const MAP_KEY_I64 = 2
export function mapKeyKindOfTy(k: i32): i32 {
  const r = mapKeyRepTy(k)
  if r < 0 { return MAP_KEY_STR }
  if r == TY_I32 { return MAP_KEY_I32 }
  if r == TY_I64 { return MAP_KEY_I64 }
  MAP_KEY_STR
}

// The decision form of `mapKeyRepTy` — can the map rep hash this key at all. The caller that says
// no resolves the annotation to -1 and reports the unsupported-key diagnostic
// (`checkLetDeclNode`, `checkInferredMapKey`).
export function mapKeyTySupported(k: i32) { mapKeyRepTy(k) >= 0 }

export function cellTagOfTy(t0: i32): string {
  const t = nonNullTy(t0)
  if t < 0 { return "" }
  const tt = T.tys[t]
  if tt is TyArray { return "#a" + i32ToStr(tt.aElem) }
  mapCellTagOfTy(t)
}

// `cellTagOfTy` for a receiver that is not a list: a map's tag, or "" for any other receiver (a
// type variable, a union of containers), which may be either.
function mapCellTagOfTy(t: i32): string {
  const tt = T.tys[t]
  if tt is TyMap { return "#m" + i32ToStr(tt.mVal) }
  ""
}

// Whether `ty` is `T | null` over a primitive other than `string`: a cell holding the value box.
export function crTyIsScalarBox(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if !(t is TyNullable) { return false }
  const pn = tyPrimNameOf(nonNullTy(ty))
  pn != null && pn != "string"
}

// Whether two map keys hash alike; an unpinned key (`-1`) may still become either.
export function setMapKeysShareRep(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return true }
  mapKeyRepTy(a) == mapKeyRepTy(b)
}

// Whether a struct type is sound to box into a value union through a widening struct literal
// (`{f: 97.5}` into `{f: f32} | {w: i32}`, where the checker adopts the arm and the emitter boxes
// the plain struct). Restricted to structs whose fields the emitter boxes into a union today; a
// field with no union-boxed rep would emit invalid wasm, so those arms stay a loud reject.
export function unionArmBoxSafe(tyIx: i32) {
  const seen: i32[] = []
  unionArmBoxSafeIn(tyIx, seen)
}

// `unionArmBoxSafe` over a record already on `seen`'s path answers true: a recursive record
// (`next: Node | null`) is one reference slot, and its fields are being checked further up.
function unionArmBoxSafeIn(tyIx: i32, seen: i32[]): boolean {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if !(t is TyObj) { return false }
  for s in seen {
    if s == tyIx { return true }
  }
  seen.push(tyIx)
  // A worklist of field types: a nullable or value-union field queues its inner types.
  const ftys: i32[] = []
  for f in t.objFieldTypes { ftys.push(f) }
  let i = 0
  while i < ftys.length {
    if ftys[i] < 0 { return false }
    const ft = T.tys[ftys[i]]
    if ft is TyPrim {
      // scalar / string / boolean field — boxes cleanly
    } else if ft is TyObj {
      if !unionArmBoxSafeIn(ftys[i], seen) { return false }
    } else if tyIsLitUnion(ftys[i]) {
      // A literal-union field (`f: K0`) boxes as its interned i32 atom: the variant tables record
      // the union name (`uFieldElemName`, the `sFieldElemName` twin) and the variant construct path
      // lowers a member literal as its atom id — the same rep the plain struct field carries.
    } else if ft is TyLit && ft.litKind == "str" {
      // A one-member inline literal field (`kind: "circle"`) — the discriminated-union tag, written
      // the way every other typed language spells it. It is not the litunion arm above, which
      // requires a `TyUnion`. It boxes as a plain string field rather than an atom, because that is
      // the rep a bare literal annotation already has, so this arm claims no new emitter capability.
    } else if numLitUnionHasBase(ftys[i]) {
      // A numeric literal tag — `kind: 0`, `kind: 1.5`, or a named numeric litunion. The string arm
      // above admits its family through `tyIsLitUnion`, which is string-only by construction. It
      // boxes as its base scalar, the same rep a plain `kind: i32` / `kind: f64` field has. Two arms
      // differing only by a numeric tag arrive distinguished, `variantFieldIdText` recording every `TyLit`.
    } else if T.tys[ftys[i]] is TyFunc {
      // A bare function-typed field (`f: (i32) => K0`) boxes as the closure fat-pointer (code 14):
      // the variant construct passes the lambda through and the narrowed member call routes to
      // `call_ref`. A nullable closure field stays out, its arm rep being unproven here.
    } else if ft is TyNullable {
      // A nullable field (`f: i32 | null`, `f: K0 | null`, `f: Bi | null`) has the rep the plain
      // struct field already carries, so it boxes whenever its inner type does (D4601).
      ftys.push(ft.nInner)
    } else if ft is TyUnion {
      // A value-union field (`f: i32 | string`) is the field's union box, the same one a plain
      // struct literal builds; it boxes when every member does (D4601).
      for m in ft.uMembers { ftys.push(m) }
    } else if ft is TyArray {
      // A list field (`xs: i32[]`, `ps: P[]`, `ss: string[]`): one reference slot in the arm's
      // struct, exactly as a nested `TyObj` field is. The variant box holds a ref to the arm struct
      // and the arm struct a ref to the array, so the element rep is not something the variant needs
      // to know — which is why there is no recursion into `aElem`. An empty hole is still one slot.
    } else if ft is TyMap {
      // A map or set field (`m: {[string]: V}`, `m: {[i32]: V}`). Same argument as the list arm
      // above and graded the same way: the rep is present, and the refusal is the arm-pick's alone.
      // Neither key spelling has anything to do with it — a plain list field fails identically, all
      // of them falling to this function's closing `return false`.
    } else {
      return false
    }
    i = i + 1
  }
  true
}

// The byte width of a scalar flat field type, or -1 for anything else. Reads the resolved
// arena type rather than the spelling, so a nominal newtype over a scalar works with no code
// for it. `boolean` is deliberately absent: it is an i32 at the wasm level, but this tier
// exists to match foreign layouts byte for byte, and C's `bool` is one byte, not four.
export function flatScalarWidth(tyIx: i32) {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if t is TyPrim {
    // Exhaustive over `PrimName` and `_`-less: `-1` (the outer return) is "not a flat scalar",
    // a real answer, so a new prim must decide its width here. `boolean` is among the unnamed
    // deliberately — it is an i32 at wasm level but C's `bool` is one byte, not four.
    match t.primName {
      "i32" => {
        return 4
      }
      "f32" => {
        return 4
      }
      "i64" => {
        return 8
      }
      "f64" => {
        return 8
      }
      "boolean" | "string" | "void" | "null" | "never" | "u8" | "v128" => {
        // No flat width; the outer `-1` stands. A v128 flat field is not wired in S1-S2, so it
        // declines here rather than claim a width no `flat` load/store path can honour.
      }
    }
  }
  -1
}

// The UN-branded arena index a branded index stands for (itself, when unbranded).
// Read by the literal-adoption arm, which needs a destination whose own brand is
// waived while everything below it still checks.
export function nomBaseTyIx(ix: i32) {
  if ix < 0 { return ix }
  let i = 0
  while i < nwTyIxs.length {
    if nwTyIxs[i] == ix { return nwBaseTyIxs[i] }
    i = i + 1
  }
  ix
}

// The arena index `ix` erases to at run time: `nomBaseTyIx` iterated to a fixpoint, so a
// brand over a brand (`type N2 = new N`) reaches the same base its outermost brand does.
// The bound is a cycle guard, not a depth policy — the sidecar is append-only and a brand
// is always minted over an index that already exists, so a chain cannot be long.
export function nomErasedTyIx(ix: i32) {
  let cur = ix
  let steps = 0
  while steps < 8 {
    const b = nomBaseTyIx(cur)
    if b == cur { return cur }
    cur = b
    steps = steps + 1
  }
  cur
}

// True when `ty` is an array (of arrays…) whose leaf element is a primitive — the exact
// condition under which `tyToEmitName` renders the type name-faithfully, since every rung
// it walks is the spelling the annotation had. Other leaf kinds are claimed by sibling
// predicates faithful under a different renderer (`arrSpineIsNominal`, `arrSpineIsMap`).
export function arrSpineIsScalar(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyPrim { return true }
  false
}

// The spine peel itself, with the leaf test lifted out — the one walk every `arrSpineIs*`
// predicate shares. Returns the arena index of the element reached by removing every
// `TyArray` layer, `ty` itself when `ty` is not an array, or -1 for an absent type. Bounded
// by the arena walk itself: an array's element is always a strictly earlier construction, so the spine cannot cycle.
function arrSpineLeafTy(ty: i32) {
  let cur = ty
  let going = true
  while going {
    if cur < 0 {
      going = false
    } else {
      const t = T.tys[cur]
      if t is TyArray { cur = t.aElem } else { going = false }
    }
  }
  cur
}

// True when `ty` is an array (of arrays…) whose leaf element is a declared struct — the
// exact condition under which `tyToNominalName` renders the type name-faithfully,
// `arrSpineIsScalar`'s twin one renderer over. Same walk, same bound; only the leaf test
// differs. A union-alias leaf is deliberately not claimed here — `arrSpineIsUnionAlias` claims it instead (D362).
export function arrSpineIsNominal(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  structNameOfTy(leaf) != ""
}

// True when `ty` is an array (of arrays…) whose leaf element is a map — the third twin, and
// a leaf kind `singleAliasMemberTyIx` claims with no gate at all, since a map alias has no
// nominal route to lose. Left unclaimed here, `collectU` minted the alias a one-variant
// union row so `isUName` claimed every annotated binding for the box while the initializer lowered a list wrapper (D181).
export function arrSpineIsMap(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyMap { return true }
  false
}

// True when `ty` is an array (of arrays…) whose leaf element is an inline object shape — the
// fourth twin (D188). Takes the nominal leg too: an inline shape has no declared name of its
// own to drop, but a field inside it can (`type L = {p: Cat}[]` re-renders structurally).
// Tested independently of the declared-struct leaf, since each stays a statement about one leaf kind.
export function arrSpineIsObj(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyObj { return structNameOfTy(leaf) == "" }
  false
}

// True when `ty` is an array (of arrays…) whose leaf element is itself a declared alias —
// the fifth and last twin. `parseTypeDecl` encodes every non-struct-bodied `type N = …` as
// a one-member `UnionDecl`, so such a leaf is a `TyUnion` carrying the alias's name, not the
// leaf's own constructor — a litunion, value union, or intersection all read the same row (D362).
export function arrSpineIsUnionAlias(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  unionAliasDeclNameOfTy(leaf) != ""
}

// The emit spelling of a transparent alias's member — the one producer read by both the
// annotation rewriter and the `is` rewriter, so the two cannot spell the union's variant and
// the test that names it differently. Nominal-first for an object member: with `collectU`'s
// skip, the member interns under its own name rather than falling through to the inline shape.
export function transparentMemberEmitName(smt: i32, ctx: i32): string {
  const mt = T.tys[smt]
  if mt is TyObj {
    const sdn = structNameOfTy(smt)
    if sdn != "" {
      // A declared name is one identifier, so one atom — the same bank `tyToEmitNameAt`
      // fills for its own renders, set here since this arm returns without calling it.
      tyNameAtoms = 1
      return sdn
    }
    // The application spelling is likewise one top-level atom, on `genAppNameOfTy`'s own
    // bank. Declines for an uninstantiated or cyclic argument, so a member with no finite
    // application name still falls through to the structural render.
    const gan = genAppNameOfTy(smt)
    if gan != "" {
      tyNameAtoms = 1
      return gan
    }
  }
  // A declared union member renders as its own alias name at every position, the same
  // nominal-first rule the object arm applies — the structural render would drop the
  // declared name the emitter's tables key on. A numeric litunion alias is deliberately not
  // nominal, though: `numLitUnionAliasName` rewrites it to its base scalar instead.
  const uan = unionAliasDeclNameOfTy(smt)
  if uan != "" {
    if numLitUnionAliasName(uan) == "" {
      // An alias name is one identifier — one atom, as on the object and union arms.
      tyNameAtoms = 1
      return uan
    }
  }
  // An array member over a declared-struct leaf renders through the nominal renderer, one
  // constructor out from the object arm: the structural render drops the declared name the
  // emitter's element tables key on, while `tyToNominalName` keeps the direct spelling.
  // Gated on the same predicate `singleAliasMemberTyIx` uses, so the two agree about which arrays are claimed.
  if mt is TyArray {
    const nomLeaf = arrSpineIsNominal(smt)
      || arrSpineIsMap(smt)
      || arrSpineIsObj(smt)
    if nomLeaf || arrSpineIsUnionAlias(smt) {
      const anr = tyToNominalNameAt(smt, ctx)
      if anr != "" {
        // The nominal render's width stands where it left it — one bank serves both faces,
        // so there is no hand-over. An array is one atom: its `|`s, if any, sit inside the
        // element's grouping parens.
        return anr
      }
    }
  }
  // A nullable member over a union carrying a declared-struct arm renders through the
  // nominal renderer too, one constructor over from the array arm and for the same reason:
  // the structural render spells the arm as its shape, and the union row the emitter keys on
  // is registered under the declared spelling (D1721).
  if mt is TyNullable {
    if nulInnerUnionIsNominal(smt) {
      const nnr = tyToNominalNameAt(smt, ctx)
      if nnr != "" { return nnr }
    }
  }
  tyToEmitNameAt(smt, ctx)
}

// True when nullable `ty`'s inner is a union with a declared-struct member — the exact case
// the structural render renames, since `tyToNameGo`'s `TyObj` arm has no nominal rung. False
// for every other inner, which keeps an all-atom nullable union on the structural render it
// already spells faithfully.
function nulInnerUnionIsNominal(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    // A never-filled `let x = null` banks `mkNullableTy(-1)`, so the index is bound-tested
    // before the read — the arena has no row at the hole.
    if t.nInner < 0 { return false }
    const it = T.tys[t.nInner]
    if it is TyUnion {
      const ms = it.uMembers
      let i = 0
      while i < ms.length {
        if structNameOfTy(ms[i]) != "" { return true }
        i = i + 1
      }
    }
  }
  false
}

// The pipe-joined union name these value-union kinds register under
// (`registerValueUnionName` keys on the member-set spelling), or "" for every other type —
// one home, so the collect pass's registration and the emitter's box lowering cannot disagree.
export function nulNumScalarUnionName(ty: i32): string {
  const k = tyNulNumScalarValKind(ty)
  if k == 0 { return "i32|null" }
  if k == 3 { return "i64|null" }
  if k == 4 { return "f64|null" }
  if k == 5 { return "f32|null" }
  if k == 14 { return "v128|null" }
  ""
}

// The emit name of a declared alias for a numeric literal union, or "". Exported for the
// registered-row reader `numLitUnionBaseName`'s note names.
export function numLitUnionAliasName(name: string) {
  if !cUserTypes.has(name) { return "" }
  const ti = cUserTypes[name] ?? -1
  if ti < 0 { return "" }
  numLitUnionBaseName(ti)
}

// The list a declared alias denotes when its members are lists that all spell one
// (`type A = i32[] | K[]`), or "": the alias is that list, so it registers no union row.
export function oneListUnionAliasName(name: string): string {
  if !cUserTypes.has(name) { return "" }
  oneListUnionRender(cUserTypes[name] ?? -1)
}

// One member of the key's sequence, spelled the way the declaration spelled it — the
// name-faithful renderer at the key's own position, never the structural one (a declared
// struct comes back `Circle`, not `{r:i32}`). A function member is parenthesized, the
// annotation's own atom spelling, or a bare closure result would swallow the union's siblings.
export function canonUnionKeyAtomOfTy(m: i32): string {
  if m < 0 { return "" }
  // The cycle bank is per top-level render (`tyToNominalName`'s contract), and this is a
  // top-level render — the entry that resets it is bypassed to pass the position bit.
  nomNameCycle = false
  const s = tyToNominalNameAt(m, RC_UNION_KEY)
  if s == "" { return "" }
  const t = T.tys[m]
  if t is TyFunc { return "(" + s + ")" }
  s
}

// The wasm element storage class a container's element (or map key/value) type lowers to.
// Two element types in different classes make two unrelated container wasm types, so only a
// copy could relate them, and a container does not widen by copying (DECISIONS.md §"No
// implicit container widening"). A kept class costs nothing. `ESC_UNKNOWN` always declines.
export const ESC_UNKNOWN = 0
export const ESC_I32 = 1
export const ESC_I64 = 2
export const ESC_F32 = 3
export const ESC_F64 = 4
const ESC_BOOL = 5
const ESC_STRING = 6
const ESC_REF = 7         // object / array / map / function, and any nullable or union of them
const ESC_BOX = 8         // a value union the emitter boxes — a scalar beside another atom
export const ESC_ATOM = 9 // a literal union: one interned i32 id

export function elemStoreClassOf(ty: i32, depth: i32): i32 {
  if ty < 0 { return ESC_UNKNOWN }
  if depth <= 0 { return ESC_UNKNOWN }
  if tyReachesHole(ty, 8) { return ESC_UNKNOWN }
  // A niche-nullable scalar reps exactly as its base does: the `| null` is a sentinel
  // inside the element, not a second element type.
  if tyIsNicheNulScalarElem(ty) {
    if tyIsNullableLitUnion(ty) { return ESC_ATOM }
    const n = T.tys[ty]
    if n is TyNullable { return elemStoreClassOf(n.nInner, depth - 1) }
    return ESC_UNKNOWN
  }
  if tyIsLitUnion(ty) { return ESC_ATOM }
  const t = T.tys[ty]
  if t is TyPrim {
    const p = t.primName
    if p == "i32" { return ESC_I32 }
    if p == "i64" { return ESC_I64 }
    if p == "f32" { return ESC_F32 }
    if p == "f64" { return ESC_F64 }
    if p == "boolean" { return ESC_BOOL }
    if p == "string" { return ESC_STRING }
    return ESC_UNKNOWN
  }
  if t is TyObj { return ESC_REF }
  if t is TyArray { return ESC_REF }
  if t is TyMap { return ESC_REF }
  if t is TyFunc { return ESC_REF }
  if t is TyNullable {
    if tyPrintsAsRef(t.nInner, 8) { return ESC_REF }
    return ESC_BOX
  }
  if t is TyUnion {
    if tyPrintsAsRef(ty, 8) { return ESC_REF }
    return ESC_BOX
  }
  ESC_UNKNOWN
}

// Whether a map value `se` delivered as `de` changes storage though both store as references:
// a value stored bare against a union of two or more non-null members, which is stored boxed.
// Any other storage class (a literal union is one atom id) is `containerElemClassDiffers`'s.
export function mapValBoxDiffers(se: i32, de: i32): boolean {
  if se < 0 || de < 0 || se >= T.tys.length || de >= T.tys.length {
    return false
  }
  if tyReachesHole(se, 8) || tyReachesHole(de, 8) { return false }
  if elemStoreClassOf(se, 8) != ESC_REF || elemStoreClassOf(de, 8) != ESC_REF {
    return false
  }
  refLeafCount(de, 8) >= 2 && refLeafCount(se, 8) < 2
}

// How many non-null members `ty` has, through nested unions and `| null`; 1 for a non-union.
function refLeafCount(ty: i32, depth: i32): i32 {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return 1 }
  const t = T.tys[ty]
  match t {
    TyNullable => {
      return refLeafCount(t.nInner, depth - 1)
    }
    TyUnion => {
      let n = 0
      let i = 0
      while i < t.uMembers.length {
        if !isNullTy(t.uMembers[i]) {
          n = n + refLeafCount(t.uMembers[i], depth - 1)
        }
        i = i + 1
      }
      return n
    }
    // Every other type is one member.
    TyPrim | TyErr | TyObj | TyFunc | TyMap | TyVar | TyLit | TyNeg | TyArray => {
      return 1
    }
  }
}

// `K | (L | null)`: literal unions with a null nested in a member rather than wrapping them.
export function substLitBoxNested(m: i32): boolean {
  if m < 0 || m >= T.tys.length { return false }
  const t = T.tys[m]
  if !(t is TyUnion) { return false }
  let nested = false
  for x in t.uMembers {
    if x < 0 || x >= T.tys.length { return false }
    if isNullTy(x) || T.tys[x] is TyNullable { nested = true }
  }
  if !nested { return false }
  const ms: i32[] = []
  flattenVariantsInto(m, ms)
  for x in ms {
    if x >= 0 && x < T.tys.length && (T.tys[x] is TyLit || tyIsLitUnion(x)) {
      return true
    }
  }
  false
}

// Whether `ty` is a union of literal unions, literals and strings with a `null`, at least one a
// literal union or literal, and not itself one literal union: the box `K | L | null` that a
// `string | null` destination reads as its niche (D3382).
export function tyIsNulStrBoxUnion(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  // `K | null` and `"a" | null` are the atom niche, not the box.
  const tt = T.tys[ty]
  if tt is TyNullable {
    const inner = tt.nInner
    if inner < 0 || inner >= T.tys.length { return false }
    if !(T.tys[inner] is TyUnion) || tyIsLitUnion(inner) { return false }
  } else {
    // Only the `(K | L) | null` wrapper is that box; a nested `K | (L | null)` is another rep.
    return false
  }
  if tyIsLitUnion(nonNullTy(ty)) { return false }
  const ms: i32[] = []
  flattenVariantsInto(ty, ms)
  let lit = false
  let nul = false
  for m in ms {
    if m < 0 || m >= T.tys.length { return false }
    const mt = T.tys[m]
    if isNullTy(m) { nul = true }
    else if tyIsLitUnion(m) || mt is TyLit { lit = true }
    else if !(mt is TyPrim && mt.primName == "string") { return false }
  }
  lit && nul
}

// Whether a union rides the i32 SPINE rather than a value box: every non-null arm is an
// `i32`- or `boolean`-repped primitive, or the whole union is a literal one. The spine cases
// pin a rest element hole and run; a boxed one has no instance (D1851).
export function unionRidesI32Spine(tyIx: i32): boolean {
  if tyIsLitUnion(tyIx) { return true }
  if tyIx < 0 || tyIx >= T.tys.length { return false }
  const t = T.tys[tyIx]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const pn = primNameOf(t.uMembers[i])
      if pn == null { return false }
      if pn != "i32" && pn != "boolean" && pn != "null" { return false }
      i = i + 1
    }
    return true
  }
  false
}

// Whether `t`, or a member within `d` levels, is a nullable or union boxing a bare vector.
export function tyBoxesV128(t: i32, d: i32): boolean {
  if t < 0 || d <= 0 { return false }
  if tyHasV128Member(t) { return true }
  const tt = T.tys[t]
  match tt {
    TyArray => {
      return tyBoxesV128(tt.aElem, d - 1)
    }
    TyNullable => {
      return tyBoxesV128(tt.nInner, d - 1)
    }
    TyMap => {
      return tyBoxesV128(tt.mVal, d - 1)
    }
    TyObj => {
      let i = 0
      while i < tt.objFieldTypes.length {
        if tyBoxesV128(tt.objFieldTypes[i], d - 1) { return true }
        i = i + 1
      }
    }
    TyUnion => {
      let j = 0
      while j < tt.uMembers.length {
        if tyBoxesV128(tt.uMembers[j], d - 1) { return true }
        j = j + 1
      }
    }
    TyPrim | TyFunc | TyVar | TyLit | TyErr | TyNeg => {
      // No member a vector could be boxed in (a function value is D1982's).
    }
  }
  false
}

// Whether every leaf atom of the (possibly nested) union/nullable type `er` renders to a
// short name `valueAtomKind` could admit — a prim/literal/type-var leaf, or a prim-element
// list. A composite leaf (struct, map, closure, nested list) always renders to a `-1`-kind
// atom, so the whole union declines here, structurally, before `collectRetAtoms` renders anything — a recursive struct's render is exponential in the depth cap and must never run.
export function retAtomsCheap(er: i32) {
  if er < 0 { return true }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if !retAtomsCheap(t.uMembers[i]) { return false }
      i = i + 1
    }
    return true
  }
  if t is TyNullable { return retAtomsCheap(t.nInner) }
  if t is TyPrim { return true }
  if t is TyLit { return true }
  if t is TyVar { return true }
  if t is TyErr { return true }
  if t is TyArray {
    // Only a prim-element list renders short AND can classify (`i32[]`, `string[]`);
    // a composite-element list (`S[]`, `i32[][]`) renders big and always declines.
    if t.aElem < 0 { return true }
    const et = T.tys[t.aElem]
    return et is TyPrim
  }
  false
}

// The value-atom kind of one leaf of an inferred return type — the structural dual of
// `valueAtomKind(tyToStr(leaf))`, read off the arena instead of a rendering. Only two leaf
// shapes classify: a primitive (its own `primName` identity) and a prim-element list. Every
// other leaf renders to a name `valueAtomKind` rejects, so it is -1 here.
function retAtomKindOf(er: i32) {
  if er < 0 { return -1 }
  const t = T.tys[er]
  if t is TyPrim { return valueAtomKind(t.primName) }
  if t is TyArray {
    if t.aElem < 0 { return -1 }
    const et = T.tys[t.aElem]
    if et is TyPrim {
      const en = et.primName
      // `i32[]` / `boolean[]` are matched by exact name AHEAD of `valueAtomKind`'s
      // litunion-array arm; the other list atoms sit BEHIND it, so a declared litunion
      // alias spelled like a primitive would claim them — ask the same question here.
      if en == "i32" { return 7 }
      if en == "boolean" { return 17 }
      if nameIsLitUnionType(en) { return 7 }
      if en == "f64" { return 8 }
      if en == "string" { return 9 }
      if en == "i64" { return 10 }
      if en == "f32" { return 12 }
    }
    return -1
  }
  if t is TyVar {
    // An inference hole renders `any` — never an atom; a declared type param carries its
    // own source name, which classifies exactly as the rendered atom would.
    if t.tvName.length > 0 {
      if t.tvName[0] == '?' { return -1 }
    }
    return valueAtomKind(t.tvName)
  }
  -1
}

// Push the value-atom KIND of every leaf of `er`, in `collectRetAtoms` order — `6` (the
// `null` atom) for a nullable slot. The kind-valued dual of `collectRetAtoms`: same walk,
// same order, no strings built.
function collectRetAtomKinds(er: i32, out: i32[]) {
  if er < 0 { return 0 }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      collectRetAtomKinds(t.uMembers[i], out)
      i = i + 1
    }
  } else if t is TyNullable {
    collectRetAtomKinds(t.nInner, out)
    out.push(6)
  } else {
    out.push(retAtomKindOf(er))
  }
  0
}

// —— the print gate's boxing question, with the literal softening applied ————————
// The value-atom kind of one leaf for the print gate: `retAtomKindOf`, plus the literal arm
// it deliberately lacks. A literal member softens to its base scalar in the name the emitter
// keys on, so a classifier answering -1 for a literal would call boxed a union the emitter does box; `retAtomKindOf` itself must not learn this arm, since it also feeds `valueUnionRetName`.
function printAtomKindOf(er: i32) {
  if er < 0 { return -1 }
  const t = T.tys[er]
  if t is TyLit { return retAtomKindOf(litBaseTy(t)) }
  retAtomKindOf(er)
}

// Pushes the print-gate kind of every leaf of `er`, in `collectRetAtomKinds` order, with the
// scalar-prim dedup `canonEmitName` performs on the softened name — `"a" | string` is one atom
// (both soften to `string`), `"a" | 1` is two. Only kinds 0-5 dedup; the list kinds
// deliberately share one code and collapsing there would fold a genuine two-arm union into one.
function collectPrintAtomKinds(er: i32, out: i32[]) {
  if er < 0 { return 0 }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      collectPrintAtomKinds(t.uMembers[i], out)
      i = i + 1
    }
  } else if t is TyNullable {
    collectPrintAtomKinds(t.nInner, out)
    out.push(6)
  } else {
    const k = printAtomKindOf(er)
    if k >= 0 && k <= 5 {
      let j = 0
      while j < out.length {
        if out[j] == k { return 0 }
        j = j + 1
      }
    }
    out.push(k)
  }
  0
}

// Scratch for the print-gate leaf scan — module level like `vuAtomKinds`, drained by its
// only consumer.
const pgAtomKinds: i32[] = []

// Whether `print(x)` would be handed the emitter's boxed value-union rep (`uBoxIdx`), which
// `print` cannot lower. Strictly wider than `valueUnionRetName(pt) != ""` on literal-bearing
// unions only: with no literal leaf the softening and dedup are no-ops, so every union that
// gate claimed is still claimed; this adds the unions whose members the emitter softens.
export function tyPrintsAsUnionBox(pt: i32) {
  if pt < 0 { return false }
  // Decline a union with any composite leaf WITHOUT rendering it, exactly as
  // `valueUnionRetName` does — the render of a recursive struct leaf is exponential.
  if !retAtomsCheap(pt) { return false }
  collectPrintAtomKinds(pt, pgAtomKinds)
  const ok = valueUnionFromAtomKinds(pgAtomKinds)
  while pgAtomKinds.length > 0 { pgAtomKinds.pop() }
  ok
}

// Whether every arm of the boxed value union `pt` is a value `print` renders on its own —
// will the emitter's per-arm tag dispatch claim it? Reads the same leaves off the arena as
// the emitter's box row does, through `printAtomKindOf`, arm for arm; a declared literal-union
// alias arm is walked into like any member. Depth-bounded like `tyPrintsAsRef`.
export function tyPrintUnionArmsInDomain(pt: i32, depth: i32): boolean {
  if pt < 0 { return false }
  if depth <= 0 { return false }
  const t = T.tys[pt]
  if t is TyNullable { return tyPrintUnionArmsInDomain(t.nInner, depth - 1) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if !tyPrintUnionArmsInDomain(t.uMembers[i], depth - 1) { return false }
      i = i + 1
    }
    return true
  }
  const k = printAtomKindOf(pt)
  k >= 0 && k <= 6
}

// `isValueUnionName`'s verdict over an already-classified atom-kind sequence: 2+ atoms,
// every atom a value atom, and either 2+ non-null atoms or exactly one NUMERIC scalar
// beside `null` (a boolean/ref + null stays a niche, not a box).
function valueUnionFromAtomKinds(kinds: i32[]) {
  if kinds.length < 2 { return false }
  let nonNull = 0
  let hasNull = false
  let soloKind = -1
  let i = 0
  while i < kinds.length {
    const k = kinds[i]
    if k < 0 { return false }
    if k == 6 {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    i = i + 1
  }
  if nonNull >= 2 { return true }
  if nonNull == 1 && hasNull {
    return soloKind == 0
      || soloKind == 3
      || soloKind == 4
      || soloKind == 5
      || soloKind == 14
  }
  false
}

// Scratch for the leaf-kind scan — module level (like `tyEqAStack`) so the checker's
// hottest decline path allocates nothing; drained by its only consumer.
const vuAtomKinds: i32[] = []

// Whether the inferred return `er` is a value union the emitter boxes — the structural dual
// of `isValueUnionName(<er's joined atom render>)`, decided from the arena before anything
// is rendered. The join is transparent: under `retAtomsCheap` every admitted leaf renders to
// a single top-level atom, so the name's `splitUnionAtoms` atoms are exactly this walk's leaves.
export function tyIsValueUnion(er: i32) {
  collectRetAtomKinds(er, vuAtomKinds)
  const ok = valueUnionFromAtomKinds(vuAtomKinds)
  while vuAtomKinds.length > 0 { vuAtomKinds.pop() }
  ok
}

// Whether every variant of union `er` is a literal or a plain scalar, over two bases or more.
export function litScalarBoxLeaves(er: i32): boolean {
  const vs: i32[] = []
  flattenVariantsInto(er, vs)
  const bases: i32[] = []
  for v in vs {
    if v < 0 { return false }
    const vt = T.tys[v]
    let b = v
    if vt is TyLit { b = litBaseTy(vt) }
    else if !isNumericPrimTy(v) && !isStringTy(v) { return false }
    let seen = false
    for o in bases {
      if o == b { seen = true }
    }
    if !seen { bases.push(b) }
  }
  bases.length > 1
}

// True when at least one union member is not an object shape — the cheap no-render pre-gate
// for `nodeUnionName`'s variant-box fallback. A mixed union boxes value-union style and its
// narrowed read needs the name to unbox; a pure-object union narrows via the variant alone,
// so declining here keeps the costly member renders off that path.
export function mixedVariantBoxGate(members: i32[]): boolean {
  let i = 0
  while i < members.length {
    if !(T.tys[members[i]] is TyObj) { return true }
    i = i + 1
  }
  false
}

// A `{tag, value}` value/struct union box: `TyUnion`, 2+ members, not a pure literal union, nor
// a union of lists that all spell one list (`oneListUnionRender`).
export function isValueUnionBox(tyix: i32) {
  if tyix < 0 { return false }
  const t = T.tys[tyix]
  if t is TyUnion {
    if t.uMembers.length < 2 { return false }
    if oneListUnionRender(tyix) != "" { return false }
    // A homogeneous literal union (all members of one base scalar) is an interned atom or that
    // scalar, not a box; a mixed-base one (`"x" | 7`, or `1 | 9000000000`) shares no one scalar,
    // so it boxes, as `softenLitTy` declines to soften it (D3491).
    let allSameLit = true
    let litBase = -1
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        const b = litBaseTy(m)
        if litBase < 0 { litBase = b }
        else if litBase != b { allSameLit = false }
      } else {
        allSameLit = false
      }
      i = i + 1
    }
    return !allSameLit
  }
  false
}

// A `{tag, value}` value/struct union BOX at arena level — `isValueUnionBox`,
// exposed under the `ty*` naming for the emitter's descriptor arms.
export function tyIsValueUnionBox(ty: i32) { isValueUnionBox(ty) }

// Whether the key spelling `name` names a declared type (an alias, newtype or literal union)
// whose values hash as an i64 key — the name leg's twin of `mapKeyRepTy`'s i64 answer.
export function nameIsI64HashedKey(name: string): boolean {
  const hit = cUserTypes[name]
  if hit is i32 { return mapKeyRepTy(hit) == TY_I64 }
  false
}

// Whether the named type `name` (a `type K = "a" | "b"` alias) is a literal union — the
// emitter's annotation-side query (the checker preserves literal members even though the
// emit-side `udVariants` are widened to `"string"`).
// The spelling-side twin of `tyLitUnionHashesI32`, for the emitter's name-keyed key question.
export function nameIsI32HashedLitUnion(name: string): boolean {
  const hit = cUserTypes[name]
  if hit is i32 { return tyLitUnionHashesI32(hit) }
  nameIsInlineLitUnion(name)
}

export function nameIsLitUnionType(name: string) {
  const luHit = cUserTypes[name]
  if luHit is i32 {
    const ti = luHit
    const r = tyIsLitUnion(ti)
    return r
  }
  // An inline (un-aliased) literal union carries its members directly in the synthetic name
  // (no `cUserTypes` entry) — 2+ top-level members, every one a quoted string literal.
  const inl = nameIsInlineLitUnion(name)
  inl
}

// Whether the synthetic type name `name` is an inline literal union: 2+ top-level
// `|`-separated members, each a quoted string literal. A mixed member or a single literal
// fails — those are value unions / nullables / single-literal types, not atom unions.
export function nameIsInlineLitUnion(name: string) {
  // A cheap reject before the allocating split: an inline literal-union name always begins
  // with a quoted member, which skips every ordinary name without allocating.
  if name.length < 1 { return false }
  if !nameIsQuotedLeaf(name) { return false }
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  if atoms.length < 2 { return false }
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a.length < 2 { return false }
    if !nameIsQuotedLeaf(a) { return false }
    i = i + 1
  }
  true
}

// Whether a `| null` reps as an i32 sentinel niche rather than a `(ref null ...)` niche or a
// value box — `boolean | null` (spare 2) or a string literal union `K | null` (spare -1).
// Asked here so the rep home and the comparability home read one function. Not the numeric
// literal unions: `repOfNullable` asks the string-only `tyIsLitUnion`, so those stay a box.
export function tyIsI32SentinelNullable(ty: i32): boolean {
  if tyIsNullableLitUnion(ty) { return true }
  isNulBoolTy(ty)
}

// Whether type `ty` is a nullable numeric literal union — `1 | 2 | null`, or `Z | null` over
// `type Z = 1 | 2` — and if so, which base scalar its non-null members rep as; "" otherwise.
// The numeric twin of `tyIsNullableLitUnion` (string-only). Asked separately from
// `numLitUnionBaseName`, which declines the moment a member is not a `TyLit` (the `null` is one).
export function nulNumLitUnionBaseName(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  // The two-part spelling: `TyNullable` over a homogeneous numeric litunion.
  if t is TyNullable { return numLitUnionBaseName(t.nInner) }
  if t is TyUnion {
    if t.uMembers.length < 2 { return "" }
    let sawNull = false
    let base = -1
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyPrim {
        if m.primName != "null" { return "" }
        sawNull = true
      } else if m is TyLit {
        if m.litKind == "str" { return "" }
        // The per-member soften and one-base requirement mirror `softenLitTy`'s union arm minus
        // its all-`TyLit` precondition; a mixed-width member set (`1 | 2.5 | null`) answers "".
        const b = litBaseTy(m)
        if base < 0 { base = b }
        else if base != b { return "" }
      } else {
        return "" // a non-literal non-null member is an ordinary heterogeneous box
      }
      i = i + 1
    }
    if !sawNull { return "" }
    if base < 0 { return "" }
    const bt = T.tys[base]
    if bt is TyPrim {
      const bn = bt.primName
      if bn == "i32" || bn == "i64" || bn == "f64" { return bn }
    }
    return ""
  }
  ""
}

// `nodeTyMapValIsNumLitUnion` over arena type `ty`, the map itself.
export function mapTyValIsNumLitUnion(ty: i32) {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if t is TyMap { return numLitUnionHasBase(t.mVal) }
  false
}

// `nodeTyMapValIsLitUnion` over arena type `ty`, the map itself.
export function mapTyValIsLitUnion(ty: i32) {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if t is TyMap { return tyIsLitUnion(t.mVal) }
  false
}

// `nodeTyMapValIsNulLitUnion` over arena type `ty`, the map itself.
export function mapTyValIsNulLitUnion(ty: i32) {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if t is TyMap { return tyIsNullableLitUnion(t.mVal) }
  false
}

// `nodeTyMapValIsNulBool` over arena type `ty`, the map itself.
export function mapTyValIsNulBool(ty: i32) {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if !(t is TyMap) { return false }
  const mv = T.tys[t.mVal]
  if mv is TyNullable { return primNameOf(mv.nInner) == "boolean" }
  if mv is TyUnion {
    if mv.uMembers.length != 2 { return false }
    let sawNull = false
    let sawBool = false
    let i = 0
    while i < mv.uMembers.length {
      const m = T.tys[mv.uMembers[i]]
      if m is TyPrim {
        // Exhaustive over `PrimName` and `_`-less: this pair is the `boolean | null` map value
        // it looks for; any other prim member leaves both flags, which is a real answer.
        match m.primName {
          "null" => {
            sawNull = true
          }
          "boolean" => {
            sawBool = true
          }
          "i32" | "i64" | "f32" | "f64" | "string" | "void" | "never" | "u8" | "v128" => {
            // Neither half of `boolean | null`.
          }
        }
      }
      i = i + 1
    }
    return sawNull && sawBool
  }
  false
}

// Whether arena type `ty` is a map whose value is the `null` unit type: the mono i32 map, every
// stored value the `boolean | null` sentinel `2` (D4671).
export function mapTyValIsNullUnit(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if t is TyMap { return isNullTy(t.mVal) }
  false
}

// `nodeTyMapValIsBool` over arena type `ty`, the map itself.
export function mapTyValIsBool(ty: i32) {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if t is TyMap { return primNameOf(t.mVal) == "boolean" }
  false
}

// `nodeTyMapValLitUnionTexts` over arena type `ty`, the map itself.
export function mapTyValLitUnionTexts(ty: i32) {
  const out: string[] = []
  if ty < 0 || ty >= T.tys.length { return out }
  const t = T.tys[ty]
  if t is TyMap {
    if !tyIsLitUnion(t.mVal) && !tyIsNullableLitUnion(t.mVal) { return out }
    let mv = t.mVal
    const mvN = T.tys[mv]
    if mvN is TyNullable { mv = mvN.nInner }
    const v = T.tys[mv]
    if v is TyUnion {
      let i = 0
      while i < v.uMembers.length {
        const m = T.tys[v.uMembers[i]]
        if m is TyLit {
          if m.litKind == "str" { out.push(m.litText) }
        }
        i = i + 1
      }
    }
  }
  out
}

// Whether `ty` is the nullable literal-union niche, `tyNulLitUnionMemberTexts` without the list.
export function tyIsNulLitUnionNiche(ty: i32): boolean {
  nulLitUnionPeelTy(ty) >= 0
}

// `nodeTyMapValExcludesNull` over arena type `ty`, the map itself.
export function mapTyValExcludesNull(ty: i32) {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if t is TyMap { return tyExcludesNull(t.mVal) }
  false
}

// `nodeTyMapValName` over arena type `ty`, the map itself.
export function mapTyValName(ty: i32) {
  if ty < 0 || ty >= T.tys.length { return "" }
  const t = T.tys[ty]
  if t is TyMap { return tyToEmitName(t.mVal) }
  ""
}

export function tyMapKeyKindSpan(ty: i32): i32 {
  if ty < 0 { return MAP_KEY_STR }
  const t = T.tys[ty]
  if t is TyMap { return mapKeyKindOfTy(t.mKey) }
  if t is TyNullable { return tyMapKeyKindSpan(t.nInner) }
  if t is TyArray { return tyMapKeyKindSpan(t.aElem) }
  MAP_KEY_STR
}

// Whether arena type `ty` is the `null` unit type, the type-taking twin of `nodeTyIsNullType`.
export function tyIsNullUnit(ty: i32): boolean { isNullTy(ty) }

function nulElemListAtomKind(name: string): i32 {
  if name.length < 5 { return -1 }
  const elem = listElemNameOf(name)
  if elem == "" { return -1 }
  if unionMemberCount(elem) < 2 { return -1 }
  let sawNull = false
  let nonNull = 0
  let soloFrom = -1
  let soloTo = -1
  let allQuoted = true
  let st = 0
  let go = true
  while go {
    const at = tyTopIndexOf(elem, '|', '=', st)
    let en = elem.length
    if at >= 0 && elem[at] != '=' { en = at } else { go = false }
    if spanEqAt(elem, st, en, "null") {
      sawNull = true
    } else {
      nonNull = nonNull + 1
      soloFrom = st
      soloTo = en
      if en - st < 2 { allQuoted = false }
      else if elem[st] != '"' { allQuoted = false }
    }
    if go { st = at + 1 }
  }
  if !sawNull { return -1 }
  if nonNull == 0 { return -1 }
  if nonNull == 1 {
    if spanEqAt(elem, soloFrom, soloTo, "boolean") { return 18 }
    if spanEqAt(elem, soloFrom, soloTo, "string") { return 9 }
    if nameIsLitUnionType(elem.slice(soloFrom, soloTo)) { return 7 }
    return -1
  }
  if !allQuoted { return -1 }
  7
}

// Whether `name` is a value union carrying a literal-union alias arm (`K0 | i64`): 2+
// top-level atoms, every atom a value atom/`null`/a declared litunion alias, at least one
// alias arm and 2+ non-null arms. Such a union boxes like a value union — the litunion arm
// rides the box as its member-string atom, so `isValueUnionName` (which declines it) is not enough.
export function nameIsLitUnionArmValueUnion(name: string) {
  // A member the span form recognises as a plain scalar needs no string for either arm — no
  // declaration can be spelled with a primitive keyword, so both questions decide from the span.
  if unionMemberCount(name) < 2 { return false }
  let hasAlias = false
  let nonNull = 0
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    let end = name.length
    if at >= 0 && name[at] != '=' { end = at } else { going = false }
    const sk = valueAtomKindSpan(name, start, end)
    if sk == 6 {
      // the `null` member
    } else if sk >= 0 {
      // A plain scalar span cannot be a declared litunion alias (no declaration is spelled
      // with a primitive keyword) nor an inline one (needs 2+ quoted members) — decided without materializing.
      nonNull = nonNull + 1
    } else {
      const a = name.slice(start, end)
      nonNull = nonNull + 1
      if nameIsLitUnionType(a) { hasAlias = true }
      else if valueAtomKind(a) < 0 { return false }
    }
    if going { start = at + 1 }
  }
  hasAlias && nonNull >= 2
}

// The literal-union element name of a `K[]` / `("a"|"b")[]` array type-name, or "" when
// `name` is not a litunion array. The checker-side twin of the emitter's `nameIsLitUnionArray`
// (which typecheck cannot import): strips the trailing `[]`, peels one grouping-paren layer,
// and requires a litunion. Cheap-rejects any name not ending in `[]`.
export function litUnionArrayElemOf(name: string) {
  // Array test + `[]` cut + one naive paren strip = `listElemNameOf` at its home in
  // `tyname.vl`. The `n < 3` cheap reject also makes "not an array" and `"[]"` both answer "".
  if name.length < 3 { return "" }
  const elem = listElemNameOf(name)
  if elem == "" { return "" }
  if nameIsLitUnionType(elem) { return elem }
  ""
}

// The atom kind of a value-union member type name: 0 i32, 1 boolean, 2 string, 3 i64, 4 f64,
// 5 f32, 6 null, 11 closure (a ref atom), 7-10/12/13/17 scalar-element lists — or -1 for anything
// else (a struct name, an inline shape, a ref-element array). Doubles as the atom's tag offset.
export function valueAtomKind(name: string) {
  if name == "i32" { return 0 }
  if name == "boolean" { return 1 }
  if name == "string" { return 2 }
  if name == "i64" { return 3 }
  if name == "f64" { return 4 }
  if name == "f32" { return 5 }
  if name == "null" { return 6 }
  // Appended: codes double as tag offsets, so the vector takes the next free one.
  if name == "v128" { return 14 }
  // A view and its list are one rep, so they are one atom (D2887).
  if name.length > 9 && name[0] == 'r' {
    const roIn = roListInnerName(name)
    if roIn != "" { return valueAtomKind(roIn) }
  }
  // A list member of a value union (`i32[] | string`) is a ref atom — the union box's `value`
  // field holds the wrapper ref directly, so each list type needs its own distinct tag code.
  const elem = arrElemNameRaw(name)
  // A boolean list shares the `i32[]` storage but takes its own code, so a union box tags the
  // two arms apart; code 17 sits above the band, which `uAtomBandTop` lifts only when used.
  if elem == "i32" { return 7 }
  if elem == "boolean" { return 17 }
  // A literal-union array (`K[]`) shares the exact `i32[]` backing and rides the same kind-7
  // atom; a real `i32[]`/`boolean[]` member cannot coexist with it in one union (same tag).
  if litUnionArrayElemOf(name) != "" { return 7 }
  if elem == "f64" { return 8 }
  if elem == "string" { return 9 }
  if elem == "i64" { return 10 }
  // The f32 list rides its own atom, distinct from the f64 list's kind 8. Code 12 sits above
  // the closure kind 11 since codes are append-only (each doubles as a tag offset).
  if elem == "f32" { return 12 }
  // The packed byte list `u8[]` rides its own atom over a distinct backing no other list
  // shares; its tag needs the band above it to move (`uAtomBandTop` in `emit_classify`).
  if elem == "u8" { return 13 }
  // A niche-nullable scalar-element list's null rides in the element rep, so the list IS its
  // leaf backing's atom — one kind per backing keeps the `is`-compare tag consistent.
  const nk = nulElemListAtomKind(name)
  if nk >= 0 { return nk }
  // A closure member is a ref atom (kind 11) — the fat-pointer struct rides the box's anyref
  // directly. Checked last so no concrete scalar/list name (none carry a top-level `=>`) reaches it.
  if nameIsFuncTypeAtom(name) { return 11 }
  -1
}

// The value-atom kind of an arena row — `valueAtomKind`'s twin, arm for arm, for callers
// that hold a type instead of a piece of a spelling. Codes are identical and append-only.
// `-2` means the arena declines (a shape this twin does not claim), distinct from `-1`
// (`valueAtomKind`'s own "not a value atom") — a caller must treat -2 as "ask the name".
export function valueRowKind(ty: i32): i32 {
  if ty < 0 { return -2 }
  const t = T.tys[ty]
  if t is TyPrim {
    const pn = t.primName
    if pn == "i32" { return 0 }
    if pn == "boolean" { return 1 }
    if pn == "string" { return 2 }
    if pn == "i64" { return 3 }
    if pn == "f64" { return 4 }
    if pn == "f32" { return 5 }
    if pn == "null" { return 6 }
    if pn == "v128" { return 14 }
    return -1 // void / never — not a value atom
  }
  // A closure member rides the box's anyref `value` directly (kind 11).
  if t is TyFunc { return 11 }
  if t is TyArray { return valueRowListKind(t.aElem) }
  // A struct / map is not a value atom; a union row here is an alias arm (`K0` in
  // `K0 | i64`), which `valueAtomKind` answers -1 for by name as well.
  if t is TyObj { return -1 }
  if t is TyMap { return -1 }
  if t is TyLit { return -1 }
  if t is TyUnion { return -1 }
  -2
}

// The list arms of `valueAtomKind`, over the element row rather than the cut spelling.
function valueRowListKind(elem: i32): i32 {
  if elem < 0 { return -2 }
  const e = T.tys[elem]
  if e is TyPrim {
    const en = e.primName
    if en == "i32" { return 7 }
    if en == "boolean" { return 17 }
    if en == "f64" { return 8 }
    if en == "string" { return 9 }
    if en == "i64" { return 10 }
    if en == "f32" { return 12 }
    // The packed byte list, arm for arm with `valueAtomKind`'s `u8` cut.
    if en == "u8" { return 13 }
    return -1
  }
  // A literal-union ELEMENT list shares the `i32[]` backing (its members are interned
  // atom ids) — `litUnionArrayElemOf`'s arm.
  if tyIsLitUnion(elem) { return 7 }
  // A niche-nullable scalar-element list: the null rides in the element rep, so the list IS
  // its leaf backing's atom — `nulElemListAtomKind`'s arms.
  if e is TyNullable { return valueRowNulElemKind(e.nInner) }
  if e is TyUnion { return valueRowNulElemKind(unionSoleNonNullMember(elem)) }
  -2
}

// The non-null leaf of a niche-nullable list element -> the backing's atom kind.
function valueRowNulElemKind(inner: i32): i32 {
  if inner < 0 { return -2 }
  const it = T.tys[inner]
  if it is TyPrim {
    if it.primName == "boolean" { return 18 }
    if it.primName == "string" { return 9 }
    return -2
  }
  if tyIsLitUnion(inner) { return 7 }
  -2
}

// `isValueUnionName`'s twin over a row. Declines (-1 => "ask the name") whenever any
// member row declines, so a shape this walk does not claim never manufactures an answer.
// Returns 1 = yes, 0 = no, -1 = decline.
export function isValueUnionTyOr(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyUnion { return valueUnionVerdict(t.uMembers, false) }
  // `T | null` is a `TyNullable` wrapper in the arena and two atoms in the spelling — not a
  // mismatch to work around, since the wrapper carries the same verdict with null as a flag.
  if t is TyNullable {
    const inner = t.nInner
    if inner < 0 { return -1 }
    const it = T.tys[inner]
    if it is TyUnion { return valueUnionVerdict(it.uMembers, true) }
    const one: i32[] = [inner]
    return valueUnionVerdict(one, true)
  }
  -1
}

// Appends `ms` to `out` with every nested union member replaced by its own members, as a
// generic pin substitutes `T | f64` at `T = i32 | string`; false past `depth` levels. A nested
// literal union still contributes its literals, which no value-atom kind claims.
function valueUnionFlatten(ms: i32[], out: i32[], depth: i32): boolean {
  if depth <= 0 { return false }
  for m in ms {
    if m >= 0 {
      const t = T.tys[m]
      if t is TyUnion {
        if !valueUnionFlatten(t.uMembers, out, depth - 1) { return false }
      } else {
        out.push(m)
      }
    } else {
      out.push(m)
    }
  }
  true
}

// The counting half of `isValueUnionName`, over member rows. `nullSeen` supplies the null
// a `TyNullable` spells as a wrapper rather than a member. -1 = decline, 1 = yes, 0 = no.
function valueUnionVerdict(ms: i32[], nullSeen: boolean): i32 {
  let nonNull = 0
  let hasNull = nullSeen
  let soloKind = -1
  const flat: i32[] = []
  if !valueUnionFlatten(ms, flat, 8) { return -1 }
  let i = 0
  while i < flat.length {
    const k = valueRowKind(flat[i])
    if k == -2 { return -1 }
    if k < 0 { return 0 }
    if k == 6 {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    i = i + 1
  }
  // `unionMemberCount(name) < 2` — the name predicate's first gate, in atoms.
  let atoms = nonNull
  if hasNull { atoms = atoms + 1 }
  if atoms < 2 { return 0 }
  if nonNull >= 2 { return 1 }
  if nonNull == 1 && hasNull {
    // Only a numeric scalar boxes with null; boolean|null / string|null are niches.
    if (
      soloKind == 0
      || soloKind == 3
      || soloKind == 4
      || soloKind == 5
      || soloKind == 14
    ) {
      return 1
    }
    return 0
  }
  0
}

// The scalar arms of `valueAtomKind`, decided over a span of `name` with no slice. Returns
// `-2` for "not one of these — materialize and ask the full ladder", distinct from
// `valueAtomKind`'s own `-1` ("not a value atom"). The list, litunion-array,
// niche-nullable-list and closure arms all need the materialized string.
function valueAtomKindSpan(name: string, from: i32, to: i32): i32 {
  if spanEqAt(name, from, to, "i32") { return 0 }
  if spanEqAt(name, from, to, "boolean") { return 1 }
  if spanEqAt(name, from, to, "string") { return 2 }
  if spanEqAt(name, from, to, "i64") { return 3 }
  if spanEqAt(name, from, to, "f64") { return 4 }
  if spanEqAt(name, from, to, "f32") { return 5 }
  if spanEqAt(name, from, to, "null") { return 6 }
  if spanEqAt(name, from, to, "v128") { return 14 }
  -2
}

// Whether `name` is a value union this emitter boxes: 2+ top-level atoms, every atom a
// scalar/string/null name, and either 2+ non-null atoms, or exactly one non-null numeric atom
// plus `null` (`i32 | null` boxes; `boolean | null` keeps its sentinel niche; a single ref
// member plus null, like `string | null`, stays a niche nullable ref — neither is a box).
export function isValueUnionName(name: string) {
  if unionMemberCount(name) < 2 { return false }
  // Walks spans and materializes only what the ladder needs (most members are plain scalars
  // `valueAtomKindSpan` decides with no slice at all); the `< 2` guard rejects the common case first.
  let nonNull = 0
  let hasNull = false
  let soloKind = -1
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    let end = name.length
    if at >= 0 && name[at] != '=' { end = at } else { going = false }
    let k = valueAtomKindSpan(name, start, end)
    if k == -2 { k = valueAtomKind(name.slice(start, end)) }
    if k < 0 { return false }
    if k == 6 {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    if going { start = at + 1 }
  }
  if nonNull >= 2 { return true }
  if nonNull == 1 && hasNull {
    return soloKind == 0
      || soloKind == 3
      || soloKind == 4
      || soloKind == 5
      || soloKind == 14
  }
  false
}

// Whether `T | null` over inner type `ty` is a null niche: a struct reference, a string or a
// boolean. Every other nullable boxes its value.
export function getterNicheOk(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[nomErasedTyIx(ty)]
  if t is TyObj { return true }
  if t is TyPrim { return t.primName == "string" || t.primName == "boolean" }
  if t is TyErr { return true }
  // Any other inner type (a scalar, a list, a map, a union, a function, a literal) boxes.
  if t is TyFunc { return false }
  if t is TyUnion { return false }
  if t is TyNullable { return false }
  if t is TyArray { return false }
  if t is TyMap { return false }
  if t is TyVar { return false }
  if t is TyLit { return false }
  if t is TyNeg { return false }
  false
}
