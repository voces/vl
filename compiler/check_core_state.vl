// The `initChecker` then `checkProgram` protocol, enforced rather than stated: every table
// `checkProgram` fills is emptied in `initChecker`, so a second walk on an unarmed instance
// reads the previous program's rows. `initChecker` arms this, `checkProgram` consumes it,
// and consuming it when it is already clear is an `internal:` diagnostic, never a trap.
export let checkerArmed = false
export function checkerArmedSet(v: boolean) { checkerArmed = v }

// D-GAPARAM — the declared type-parameter names, as a flat column plus a (start, count)
// slice per alias, the shape the spelling arena uses for its kids. `parseTypeDecl` folds
// the parameter tokens into the declared name, so the `<` scan and slice happen once here
// at registration and the binding loop reads `gaParamNames[start + k]` directly.
export let gaParamNames: string[] = []

export let gaParamStart: i32[] = []

export let gaParamCount: i32[] = []

// One row per (generic function, instantiation type, bound member) some site resolved; a
// second site resolving the same key to a different witness is the refusal, and it names
// both sites. The key is `tyToStr` — `tyEq`'s exact string equivalent, nominality folded
// in — never an arena index, which is append-only, nor the emit-side `canon`/`tyToEmitName`.
export let cohKeys: string[] = []

export let cohWitness: string[] = []

export let cohSiteLine: i32[] = []

export let cohSiteCol: i32[] = []

// Unions minted by `joinTys` that carry at least one hole member. `substTyDeep` re-folds
// such a union under a call's bindings (`refoldJoinUnion`): members that resolve are
// re-joined, and one still unresolved is dropped once some member did, naming a branch the
// pinned argument can never reach. Without the re-fold `A | B` surfaces where one arm is live.
export let joinHoleUnions: i32[] = []

// The generic whose instance the emitter is building, -1 outside one (`joinPinnedArmLit`).
export let njPinFn = -1

export function njSetPinFn(fx: i32): i32 {
  const was = njPinFn
  njPinFn = fx
  was
}

// The deferred return joins of runtime witnesses, which re-join apart wherever they collapse.
export let apartHoleJoins: {[i32]: boolean} = Map()

// D1470 — every `__array_new_default__(n)` call, its node and the array-hole row it returned.
// `array.new_default` writes each slot's zero, so the element type is decided by what pins the
// hole and neither answer exists where the call is checked. `flushUninferred` defaults an
// unpinned hole to `i32`; `checkArrayNewDefaultElems` refuses a pinned element with no zero.
export let arrDefCallIx: i32[] = []

// The element narrowing a `map`/`filter` callback's parameter or a `for` variable starts with,
// keyed on the callback or the loop (`elemFactFor`); a leaf of -1 is none.
export let efLeaf: {[i32]: i32} = Map()

export let efSteps: {[i32]: i32} = Map()

// Declarations whose solve has been attempted, keyed by decl node index — a body is probed at
// most once, whether or not the probe found anything to solve.
export let paramSolveTried: {[i32]: boolean} = Map()

// Set while pass 1.9 walks a generic body only to record its deferred constraints, so the
// walk takes no memo and patches no return (`cstrPrePass`).
export let cstrProbe = false
export function cstrProbeSet(v: boolean) { cstrProbe = v }

// The container null holes (D2506): an un-annotated list element or map value pinned by a bare
// `null` write holds an open `_ | null` a later write or a destination fills. One row
// per hole: its arena index, the write that minted it, the container's spelling, whether it is a
// map value, and whether it is a param-hole map demand's, whose value each call site fills.
export let cnhTys: i32[] = []

export let cnhAts: i32[] = []

export let cnhNames: string[] = []

export let cnhIsVal: boolean[] = []

export let cnhDemand: boolean[] = []

// Each `null` written into a container slot, to that slot: stored as the slot's type once the
// check has filled it.
export let cnhNulls: {[i32]: i32} = Map()

// Post-guard narrowings handed up by an `if` that is itself the else arm of another `if`. Such
// an `if` has no enclosing block of its own — the rest of its block is the rest of the parent's
// — so it cannot `declare` its own fall-through narrowing. The parent consumes these only when
// its own then diverges. Bare names only; pushed in post-order and applied in reverse.
export let pgUpKeys: i32[] = []

export let pgUpTys: i32[] = []

// The node index of the `if` currently being checked as the else arm of a chain, or `-1`. Set
// by a link's head immediately before the next link's head runs, and read-and-cleared at the
// very top of `checkIfHead`, so only that link sees it: an `if` nested inside an arm's body
// has a block of its own and declares normally.
export let pgUpArmIx = -1
export function pgUpArmIxSet(v: i32) { pgUpArmIx = v }

// The place type a trailing chain saw, banked at the instant the post-guard subtraction replaced
// it. `ifChainExhausts` asks whether a chain's arms cover its place's union, and by then the
// chain has already subtracted them, so asking the binding is circular. Keyed by the chain head's
// node index — a head that does not post-narrow writes nothing, and a miss falls back to the binding's type.
export let pgPreIx = -1
export function pgPreIxSet(v: i32) { pgPreIx = v }

export let pgPreKeys: i32[] = []
export function pgPreKeysSet(v: i32[]) { pgPreKeys = v }

export let pgPreTys: i32[] = []
export function pgPreTysSet(v: i32[]) { pgPreTys = v }

// Per `if` node and written key, the type the key holds after that `if`, as its arm join found
// it: what an enclosing `if` whose `else` is this one reads as that arm's end.
export let narIfEnds: {[string]: i32} = Map()
export function narIfEndsSet(v: {[string]: i32}) { narIfEnds = v }
// Reads of a list narrowed by `is K[]` that a delivery takes whole at a type its declared type
// fits (`narListDeliveryErr`): the emitter hands over the list itself, not an arm stand-in.
export let narListDeclReads: {[i32]: boolean} = Map()
export function narListDeclReadsSet(v: {[i32]: boolean}) {
  narListDeclReads = v
}
// Whether the read at `ix` of a list narrowed by `is K[]` is delivered whole at its declared type.
export function narListReadsDecl(ix: i32): boolean {
  narListDeclReads[ix] ?? false
}

export function narNoteChainEnd(ifIx: i32, key: string, ty: i32) {
  if ty < 0 { return 0 }
  narIfEnds[i32ToStr(ifIx) + "#" + key] = ty
  0
}

// The end type of the `else if` link of the `if` at `ifIx` for `key`, or -1 when its `else` is
// no `if`, or the link's own join recorded nothing for `key`.
export function narChainEndTy(ifIx: i32, key: string): i32 {
  const n = nodeAt(ifIx)
  if n is IfStmt {
    if n.ifElse >= 0 && nodeAt(n.ifElse) is IfStmt {
      return narIfEnds[i32ToStr(n.ifElse) + "#" + key] ?? -1
    }
  }
  -1
}

// Whether `ty` is a still-open container null hole.
export function cnhIsOpen(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyNullable {
    if t.nInner >= 0 { return false }
  } else {
    return false
  }
  let i = 0
  while i < cnhTys.length {
    if cnhTys[i] == ty { return true }
    i = i + 1
  }
  false
}

// The joins `paramNullJoin` kept a null in (D3497): re-folding one at a call keeps the null even
// when the bound members absorb it, as a caller's own holes do.
export let paramNullJoins: {[i32]: i32} = Map()

// Whether any join has made one record of two (`joinObjFieldwise`). Only ever set, so the
// emitter passes that build a join's arms at its row can skip a program with none (D2731).
export let recordJoinMinted = false
export function recordJoinMintedSet(v: boolean) { recordJoinMinted = v }

// The emitter's read of `recordJoinMinted`.
export function recordJoinSeen(): boolean { recordJoinMinted }

// The `__memory_shared__()` Call nodes that denote the build intrinsic rather than a local of
// that name; `foldMemShared` folds an `if` only on one of these. Reset by `initChecker`.
export let memSharedCalls: i32[] = []

// The `Map()` and `Set()` Call nodes the checker typed as the ambient constructor, each a fresh
// empty collection, to whether it is a `Set()`. Reset by `initChecker`.
export let ambientCtorCalls: {[i32]: boolean} = Map()

// The element type a `Set()` call whose own element is a hole is built with, by Call node: the
// key of the set it is delivered to (D14228). Reset by `initChecker`.
export let setCtorKeys: {[i32]: i32} = Map()

// The `Member` node an assignment is about to write, so a getter there is refused as a write
// rather than resolved as a read. -1 outside an assignment target.
export let getWriteTarget = -1
export function getWriteTargetSet(v: i32) { getWriteTarget = v }

// Every `+` the real pass checked, by anchor token, and whether its left operand concatenates
// as a string — no operator declaration takes one as receiver, so the link is the built-in
// concat. Read by the `prefer-interpolation` lint, which has no types: a link rechecked with
// another left operand type (a generic pin) records twice, and any `0` among its rows wins.
let plusLinkTok: i32[] = []

let plusLinkStr: i32[] = []

// Every index read the real pass checked, by anchor token, and whether its receiver checked
// as a `string`, so the element is a UTF-8 byte. Read by the `byte-as-code-point` lint under
// `plusLinkStr`'s rule: a site rechecked with another receiver type records twice.
let strIdxTok: i32[] = []

let strIdxStr: i32[] = []

export let inferObserved = -1
export function inferObservedSet(v: i32) { inferObserved = v }

export let inferSawErr = false
export function inferSawErrSet(v: boolean) { inferSawErr = v }

export let inferObservedLit = true
export function inferObservedLitSet(v: boolean) { inferObservedLit = v }

// The `return <void expr>` statements of the functions being inferred, per inference frame, and
// the block each sits in: a void return, refused if its function returns a value (D2635).
export let inferVoidRetSites: i32[] = []

export let inferVoidRetBlks: i32[] = []

// The innermost block whose statements are being checked: the block a `return` sits in.
export let chkStmtBlk = -1
export function chkStmtBlkSet(v: i32) { chkStmtBlk = v }

// The void returns settled in void functions, and their blocks, which `voidRetRewrite` splits
// into the expression statement and a bare `return` once every body is checked.
export let voidRetRwRet: i32[] = []

export let voidRetRwBlk: i32[] = []

export let inferRetSeeding = false
export function inferRetSeedingSet(v: boolean) { inferRetSeeding = v }

// The seeds `dropTailIfSeeds` removed, per inference frame: re-joined when the function turns
// out to return a value anyway, since then the tail's value arms return (`clearTailVerdict`).
export let inferDroppedTy: i32[] = []

export let inferDroppedLit: boolean[] = []

// The `match` `checkNode` last entered in return-tail position, which it leaves as a non-spine node.
export let matchTailNode = -1
export function matchTailNodeSet(v: i32) { matchTailNode = v }

// Each top-level `let`/`const` by name to its node, or -1 once pass 2 has reached the
// declaration: a top-level write to one still mapped is a write before its initializer (D2654).
export let moduleBeforeDecl: {[string]: i32} = Map()

// Recursive return-type inference (binding-group fixpoint). A function whose return becomes
// knowable only after a recursive cycle resolves cannot be inferred in one demand pass, since the
// cycle-break commits a provisional `void`. A suppressed pre-pass resolves every un-annotated
// return first, iterating to a fixpoint; `bodyChecked` lets the real pass still check each once.
export let topUnannotFns: i32[] = []

// An un-annotated function whose returns disagree and join to one list type, keyed as
// `inferRetIdx` is: the joined `Ty` index, which no single return's own list rep names (D2716).
export let inferJoinListIdx: {[string]: i32} = Map()

export let bodyChecked: {[string]: boolean} = Map()

// The arm patterns a `const`-pattern refusal already reported, so the vocabulary does not again.
export let matchPatRefused: {[i32]: boolean} = Map()

// The delivery sites the function-value adapter rewrote, so a second delivery of one does not
// wrap the adapter again.
export let fvaDone: {[i32]: boolean} = Map()

// Context-resolved type sidecar, parallel to `nodeTyIx`: at the arena-pure adoption sites it
// records the destination type a literal node widened into, which is the rep the emitter builds.
// `nodeTyIx` keeps the checker's self-inferred type for its existing consumers; the emitter's rep
// keying reads `nodeRepTyIxOf`, which falls back to `nodeTyIxOf` when nothing is recorded.
export let nodeRepTyIx: i32[] = []

// The destination type each node is delivered at, where the checker proved a delivery: a let or
// const initializer, an assignment, an argument, a return, a field, element or map value. Unlike
// `nodeRepTyIx`, any node kind is recorded, a narrowed read included.
export let nodeCtxTyIx: i32[] = []

// The nodes the checker delivered as a record field's value, keyed by node; read only by
// `ctxIsFieldValue`.
export let ctxFieldNodes: {[i32]: i32} = Map()

// Per literal the checker adopted into an arm of a union, that union: the row the arm's variant
// is read from. -1 where no union adopted the literal.
export let nodeRepUnionIx: {[i32]: i32} = Map()

// Per node, the map type a union of maps is delivered as (D2692): the members share that map's
// storage, so the emitter unboxes the union's payload there. -1 where nothing is recorded.
export let mapUnboxTyIx: i32[] = []

// Per node, the record a delivery copies the node's record into, its number fields converted
// (`recordRecCopy`). -1 where nothing is recorded.
export let recCopyTyIx: i32[] = []

// The shift nodes whose count is a literal, graded once every width is in (`checkShiftCounts`).
export let shiftCountNodes: i32[] = []

// Whether the checker has typed an identifier naming an `extern` anywhere but as a callee: the
// one case the emitter's `synthExternValues` has work for, so a program that only calls its
// externs skips it (D2618). `ckCalleeIx` is the callee node the general call arm is typing, or -1.
export let extValueSeen = false
export function extValueSeenSet(v: boolean) { extValueSeen = v }

export let ckCalleeIx = -1
export function ckCalleeIxSet(v: i32) { ckCalleeIx = v }

// The arena types externs are declared at, by index: the cheap filter in front of the name.
export let extFnTy: boolean[] = []

// The least of them, so a read at any earlier-interned type (every primitive) is one compare.
export let extFnTyMin = 2147483647

export function extFnTyMark(ty: i32) {
  if ty < 0 { return 0 }
  while extFnTy.length <= ty { extFnTy.push(false) }
  extFnTy[ty] = true
  if ty < extFnTyMin { extFnTyMin = ty }
  0
}

export function externValueSeen(): boolean { extValueSeen }

export let cFillActive = false
export function cFillActiveSet(v: boolean) { cFillActive = v }

// The declaration's arena node, so the cycle report — which is discovered in the fixpoint, long
// after the statement walk that found the declaration — can still anchor on the right line.
export let flDeclNodes: i32[] = []

// A single placeholder `TyFunc` arena index for monomorphizer `=>sigkey` closure pins (C1 endgame).
export let cFuncPinTyIx = -1
export function cFuncPinTyIxSet(v: i32) { cFuncPinTyIx = v }

// A single placeholder `TyObj` arena index for interned anonymous-shape `#anonN` names (C1 endgame).
export let cObjPinTyIx = -1
export function cObjPinTyIxSet(v: i32) { cObjPinTyIx = v }

export let cycleBreakCount = 0
export function cycleBreakCountSet(v: i32) { cycleBreakCount = v }

// Bare `{}` literals refused so far (D2223): a body holding one has already been reported, so
// its return inference owes no second message.
export let bareBraceCount = 0
export function bareBraceCountSet(v: i32) { bareBraceCount = v }

// D2223: every value-position `{}` checked, and per node whether a delivery gave it a record
// type to complete (1). `bareBraceUndelivered` refuses the rest once every body is checked.
export let bareBraceLits: i32[] = []

export let bareBraceMark: i32[] = []

// Nesting depth of a speculative `assignableExpr` (one union member tried of several): a `{}`
// is judged once, by the outer delivery that sees every member.
export let bareBraceSpec = 0
export function bareBraceSpecSet(v: i32) { bareBraceSpec = v }

export let unresolvedFns: string[] = []
export function unresolvedFnsSet(v: string[]) { unresolvedFns = v }

export let fnSawValueRet = false
export function fnSawValueRetSet(v: boolean) { fnSawValueRet = v }

// Redundant return-type annotation rule: `retNatural` is the body's natural inferred return — the
// first non-void, non-error one, mirroring `noteInferredRet` — accumulated for an annotated
// function so the rule can compare it against the explicit `: T`. A match means removing the
// annotation yields the identical inferred return. Saved, reset and restored per function.
export let retNatural = -1
export function retNaturalSet(v: i32) { retNatural = v }

export let retNaturalErr = false
export function retNaturalErrSet(v: boolean) { retNaturalErr = v }

// The contextual expected return type per lambda node, the return-side dual of the param seeding:
// a lambda whose body infers a narrower numeric than the expected return adopts it, so the
// widening happens inside the body at the return seam rather than riding function-type variance.
// `cbSeedUsed` counts seeds that changed an inference, so `checkLetDecl` cannot call it redundant (D1442).
export let cbSeedUsed = 0
export function cbSeedUsedSet(v: i32) { cbSeedUsed = v }

// The checker core as the modules below it reach it: kind 0 is `checkNode(a)`, kind 1 is
// `assignableExpr(a, b, c)` and kind 2 `fvaAdaptJoin(a, b)`, each as 1 or 0. The callees' modules
// import every caller's, so a direct call would be an import cycle. One slot of one signature,
// since each function value signature costs the self-compile; `checkProgramPass` installs it.
function checkerForceNone(_k: i32, _a: i32, _b: i32, _c: i32): i32 { -1 }
export let checkerForceFn: (k: i32, a: i32, b: i32, c: i32) => i32 = checkerForceNone
// `checkNode(ix)`: checks node `ix` and answers its type index. The hot callers in
// `check_demands.vl` and `check_relate_core.vl` read the slot directly, saving a call frame.
export function checkNodeHook(ix: i32): i32 { checkerForceFn(0, ix, -1, -1) }

// The constraint columns of `checkerResetPassTables`: each deferred-constraint record's columns
// emptied, with the sequence counter and the probe rows beside them.
function checkerResetCstrColumns() {
  binCstr.lt = []
  binCstr.op = []
  binCstr.rt = []
