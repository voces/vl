// The inference state of `checkerResetPassTables`: call resolution, effects, per-node type
// columns, literal and return-inference scratch, cleared in the order the pass tables list them.
function checkerResetInferState() {
  callResolveReset()
  efLeaf = Map()
  efSteps = Map()
  tvNestOf = Map()
  paramSolveTried = Map()
  expObsProbeReset()
  cstrProbe = false
  cstrProbeReset()
  fnDeclIx = Map()
  memSharedCalls = []
  ambientCtorCalls = Map()
  setCtorKeys = Map()
  calleeReset()
  getterEffectsReset()
  getSiteNodes = []
  getSiteFns = []
  getWriteTarget = -1
  esReset()
  plusLinkTok = []
  plusLinkStr = []
  strIdxTok = []
  strIdxStr = []
  discardedReset()
  moduleBeforeDecl = Map()
  topUnannotFns = []
  irReset()
  inferRetReset()
  inferJoinListIdx = Map()
  inlineLitUnionReset()
  bodyChecked = Map()
  nodeTyIx = []
  narrowedFromTyIx = []
  nodeTyWrites = nodeTyWrites + 1
  matchHeadsReset()
  matchDesugarReset()
  matchPatRefused = Map()
  chainProvenCond = []
  narIfEnds = Map()
  narListDeclReads = Map()
  fvaDone = Map()
  nodeRepTyIx = []
  nodeCtxTyIx = []
  ctxFieldNodes = Map()
  nodeRepUnionIx = Map()
  mapUnboxTyIx = []
  recCopyTyIx = []
  retagRowsReset()
  refListViewReset()
  literalsReset()
  numAdoptReset()
  shiftCountNodes = []
  cexWideLits = []
  cexWideFloatOk = Map()
  cexReported = Map()
  cexNegOperand = Map()
  extValueSeen = false
  ckCalleeIx = -1
  extFnTy = []
  extFnTyMin = 2147483647
  cFuncPinTyIx = -1
  cObjPinTyIx = -1
  cycleBreakCount = 0
  bareBraceCount = 0
  bareBraceLits = []
  bareBraceMark = []
  bareBraceSpec = 0
  unresolvedFns = []
  fnSawValueRet = false
  retNatural = -1
  retNaturalErr = false
  daResetForCheck()
  daWriteTarget = -1
  inferObserved = -1
  inferObservedLit = true
  inferSawErr = false
  inferVoidRetSites = []
  inferVoidRetBlks = []
  chkStmtBlk = -1
  voidRetRwRet = []
  voidRetRwBlk = []
  inferRetSeeding = false
  matchTailNode = -1
  nullHolesReset()
  valueArmAt = -1
  nestedExitFirstAt = []
  lpValSeen = false
  deadTailBlks = []
  bindRowsReset()
  brkPrevTy = -1
  brkPrevIx = -1
  inferDroppedTy = []
  inferDroppedLit = []
}

// The per-pass tables of `initChecker`: rows, memos, constraint columns and inference state.
// Runs first, so the arena and scopes are empty before any primitive is interned.
function checkerResetPassTables() {
  mimpClear()
  identColReset()
  sideRowsReset()
  jwReset()
  redunReset()
  rcoalReset()
  isvalReset()
  covarWriteReset()
  cursorReset()
  pgrReset()
  holeRowsReset()
  joinRowsReset()
  undoReset()
  inferRowsReset()
  expectedReset()
  cbSeedUsed = 0
  T.tys = []
  litTyIntern = Map()
  wideLitMinted = false
  objNamesDistinctReset()
  tpJoinUnions = Map()
  tvElseBase = Map()
  tvElseTested = Map()
  listUnionReset()
  paramNullJoins = Map()
  holeTpJoinNames = Map()
  holeTpJoinLog = []
  genFnCstrBusy = false
  ifValueReset()
  recordJoinMinted = false
  scopesReset()
  T.diags = []
  T.curRet = -1
  cUserTypes = Map()
  nearNamesRead = false
  // The arena is re-minted for this program: advance both generations so no emit-side memo
  // stamped under a previous program can be consulted on a shared instance. Advance, never
  // reset — a reset could collide with a stamp an earlier program left behind.
  tyMutEpoch = tyMutEpoch + 1
  cUserTypesVer = cUserTypesVer + 1
  genAliasAnnsReset()
  gaParamNames = []
  gaParamStart = []
  gaParamCount = []
  annotNameMemo = Map()
  annotNameMemoNegVer = Map()
  annotPart = Map()
  annotClash = Map()
  declScanReset()
  tpBoundReset()
  cohKeys = []
  cohWitness = []
  cohSiteLine = []
  cohSiteCol = []
  asgRowsReset()
  substReset()
  holeLinksReset()
  coalReset()
  narPathsReset()
  hdReset()
  guardReset()
  joinHoleUnions = []
  njGateReset()
  njJoinReset()
  njPinFn = -1
  apartHoleJoins = Map()
  checkerResetCstrColumns()
  checkerResetInferState()
}

// The pass-0 and pass-1 collect tables of `initChecker`, and the arming of the checker.
function checkerResetCollectTables() {
  // Pass 0 and pass 1's collect tables, reset here with everything else: every
  // `checkProgram` reaches its walk through a caller that ran `initChecker` first
  // (`compileSrc`, `checkSrc`, `checkSrcSym`, `pinDeepIs`), so this is the one
  // reset surface, and a new checker module table has one place to go.
  cStructTyIxs = []
  cStructTyIxSet = []
  cStructNames = []
  cStructFirstPos = []
  cVariantMemberTyIxs = []
  cVariantMemberTyIxSet = []
  cUnionTyIxs = []
  cUnionTyIxSet = []
  cUnionNames = []
  luPosByKey = Map()
  luPosByTy = []
  luIxCursor = 0
  luPending = []
  wideLitsReset()
  gaAppTyIxs = []
  gaAppTyIxSet = []
  gaAppHeads = []
  gaAppArgStart = []
  gaAppArgCount = []
  gaAppArgFlat = []
  gaAppFinite = []
  aliasTransparentReset()
  cFillActive = false
  nwDeclNames = []
  nwTyIxs = []
  nwNames = []
  nwBaseTyIxs = []
  flatLayoutReset()
  flDeclNodes = []
  checkerArmed = true
}

// Reset all checker module state, then intern the well-known primitives and the global
// scope. Call once before checking: `checkProgram` assumes it, and this is the only reset
// surface, so a new checker module table belongs here and nowhere else.
export function initChecker() {
  checkerResetPassTables()
  checkerResetCollectTables()
  TY_I32 = mkPrim("i32")
  TY_I64 = mkPrim("i64")
  TY_F64 = mkPrim("f64")
  TY_F32 = mkPrim("f32")
  TY_BOOL = mkPrim("boolean")
  TY_STR = mkPrim("string")
  TY_VOID = mkPrim("void")
  TY_ERR = mkErrTy()
  TY_NULL = mkPrim("null")
  TY_NEVER = mkPrim("never")
  TY_U8 = mkPrim("u8")
  TY_V128 = mkPrim("v128")
  // Per-compile state: the checker instance outlives one program (LSP, the corpus oracle).
  v128NestReported = []
  voidStoreReported = []
  diagKeyDrops = 0
  scopeFramePush()
  cnhTys = []
  cnhAts = []
  cnhNames = []
  cnhIsVal = []
  cnhDemand = []
  cnhNulls = Map()
  pgUpKeys = []
  pgUpTys = []
  pgUpArmIx = -1
  pgPreIx = -1
  pgPreKeys = []
  pgPreTys = []
  weReset()
  tyToStrDepth = 0
  tyToStrStack = []
  narStoreReset()
  narWrittenReset()
  crReset()
  // LSP symbol-table data, cleared every check; the `symEnabled` mode flag is the driver's to
  // set, so it is not reset here. The global scope's decl frame is seeded to parallel the global
  // type scope `T.frames` already pushed below.
  symOccTok = []
  symOccDecl = []
  symOccIsDecl = []
  symOccTy = []
  // Find-references' filled result column indexes `symOccTok`, so it is dropped with it.
  symRefOcc = []
  symRefCursorLine = -1
  symRefCursorCol = -1
  symBindNode = []
  symBindType = []
  symBindKind = []
  symMemNode = []
  symMemGetter = []
  symMemGetterDecl = []
  symMemTy = []
  symMemLine = []
  symMemCol = []
  symMemEndCol = []
  symVisName = []
  symVisNode = []
  symVisKind = []
  symVisSL = []
  symVisSC = []
  symVisEL = []
  symVisEC = []
  scopeResName = []
  scopeResKind = []
  scopeResType = []
  // Opens the module scope for every compile. The token-membership set is cleared with
  // `symOccTok` above.
  symOccReset()
  declareMemoryIntrinsics()
  0
}

// The intrinsics `initChecker` declares in the global scope: memory stores and loads, SIMD,
// atomics, saturating truncations and the host floor. Needs the primitives already interned.
function declareMemoryIntrinsics() {
  // Memory intrinsics (host `defaultScope`): raw linear-memory stores/loads and
  // the `__log__` host hook used by low-level corpus programs.
  declareAmbient("__store_i32__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declareAmbient("__store_i64__", mkFuncTy([TY_I32, TY_I64], TY_VOID))
  declareAmbient("__store_f32__", mkFuncTy([TY_I32, TY_F32], TY_VOID))
  declareAmbient("__store_f64__", mkFuncTy([TY_I32, TY_F64], TY_VOID))
  declareAmbient("__store_i8__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declareAmbient("__store_i16__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declareAmbient("__load_i32__", mkFuncTy([TY_I32], TY_I32))
  declareAmbient("__store_string__", mkFuncTy([TY_I32, TY_STR], TY_I32))
  declareAmbient("__log_string__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declareAmbient("__log__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declareAmbient("__memory_grow__", mkFuncTy([TY_I32], TY_I32))
  const noParams: i32[] = []
  declareAmbient("__memory_size__", mkFuncTy(noParams, TY_I32))
  // The build's heap window, as two constants the host fixed before the compile.
  declareAmbient("__heap_base__", mkFuncTy(noParams, TY_I32))
  declareAmbient("__heap_limit__", mkFuncTy(noParams, TY_I32))
  // Whether the build declared its memory shared (`--shared-memory`), a build-time constant.
  declareAmbient("__memory_shared__", mkFuncTy(noParams, TY_BOOL))
  declareAmbient("__memory_copy__", mkFuncTy([TY_I32, TY_I32, TY_I32], TY_VOID))
  declareAmbient("__memory_fill__", mkFuncTy([TY_I32, TY_I32, TY_I32], TY_VOID))
  // The load-width matrix (`buffer-design.md` §C2). Each VL signature is the wasm instruction's
  // signature, so there is nothing to choose beyond the name: the narrow loads all result in i32
  // because that is what the instruction does, and the `_s`/`_u` split is why both spellings
  // exist. The narrow stores truncate, so there is no `__store_u8__`/`__store_u16__` twin.
  declareAmbient("__load_i8__", mkFuncTy([TY_I32], TY_I32))
  declareAmbient("__load_u8__", mkFuncTy([TY_I32], TY_I32))
  declareAmbient("__load_i16__", mkFuncTy([TY_I32], TY_I32))
  declareAmbient("__load_u16__", mkFuncTy([TY_I32], TY_I32))
  declareAmbient("__load_i64__", mkFuncTy([TY_I32], TY_I64))
  declareAmbient("__load_f32__", mkFuncTy([TY_I32], TY_F32))
  declareAmbient("__load_f64__", mkFuncTy([TY_I32], TY_F64))
  // The zero-extending i64 loads: `i64.load{8,16,32}_u`, the non-atomic twins of the
  // `__atomic_load*_u_i64__` rows. No signed trio: `__load_i32__(p) as i64` already is one.
  declareAmbient("__load_u8_i64__", mkFuncTy([TY_I32], TY_I64))
  declareAmbient("__load_u16_i64__", mkFuncTy([TY_I32], TY_I64))
  declareAmbient("__load_u32_i64__", mkFuncTy([TY_I32], TY_I64))
  // The SIMD substrate (`simd-design.md` §D6): one declaration per row of the intrinsic table,
  // typed by the row's operand shape. A lane or shuffle index is a literal (checked below).
  declareSimdIntrinsics()
  // The atomics (`simd-design.md` §G1): one declaration per row of the atomic table.
  declareAtomicIntrinsics()
  // The scalar saturating truncations, one declaration per `0xFC` sub-opcode.
  declareTruncSatIntrinsics()
  // The host floor, one declaration per row of its table (`check_intrinsics.vl`). Unlike
  // everything above it these are host imports: bytes cross as one packed `u8[]` GC object,
  // and errors are out of band — an empty `u8[]` or a negative i32, with `__fs_errno__()`
  // carrying the WASI errno.
  const u8Arr = mkArrayTy(TY_U8)
  let fk = 0
  while fk < fsIntrinsicCount() {
    const fps: i32[] = []
    let fa = 0
    while fa < fsIntrinsicArity(fk) {
      fps.push(fsFloorTy(fsIntrinsicParam(fk, fa), u8Arr))
      fa = fa + 1
    }
    declareAmbient(
      fsIntrinsicNameAt(fk),
      mkFuncTy(fps, fsFloorTy(fsIntrinsicResult(fk), u8Arr)),
    )
    fk = fk + 1
  }
}

// The checker type of a floor signature's spelling: `u8[]`, `i64`, `i32`, or `void`, which is
// `never` because the one slot that declares it never returns.
function fsFloorTy(spell: string, u8Arr: i32): i32 {
  if spell == "u8[]" { return u8Arr }
  if spell == "i64" { return TY_I64 }
  if spell == "void" { return TY_NEVER }
  TY_I32
}

// Does `ty` concatenate as a string? The `+` gate's operand test, in one home because the
// checker and its pin mirror must not drift about it (D1732). A literal union of strings is a
// SET of strings, so it concatenates and the result is `string` — never the union (D1739).
export function concatsAsStr(ty: i32): boolean { isStringTy(softenLitTy(ty)) }

function redunReset() {
  redun.sLine = []
  redun.sCol = []
  redun.eLine = []
  redun.eCol = []
  redun.name = []
  redun.ty = []
  redun.tok = []
  redun.ret = []
  redunHeld.sLine = []
  redunHeld.sCol = []
  redunHeld.eLine = []
  redunHeld.eCol = []
  redunHeld.name = []
  redunHeld.ty = []
  redunHeld.tok = []
  redunHeld.ret = []
  0
}

export function isJoinHoleUnion(tyIx: i32) {
  let k = 0
  while k < joinHoleUnions.length {
    if joinHoleUnions[k] == tyIx { return true }
    k = k + 1
  }
  false
}

export let genFnCstrBusy = false
export function genFnCstrBusySet(v: boolean) { genFnCstrBusy = v }

// The list rows of the arguments written at the call as an empty `[]` or an
// `__array_new_default__(…)`: the only open lists a callee's writes may decide (D2218).
export function callSiteOpenListRows(args: i32[]): i32[] {
  const rows: i32[] = []
  for a in args {
    const ax = peelParenIx(a)
    if ax >= 0 && ax < P.nodes.length {
      if isEmptyArrayLitNode(ax) || arrDefCallNode(ax) {
        rows.push(nodeTyIxOf(ax))
      }
      openJoinListRows(ax, rows, 0)
    }
  }
  rows
}

// The open list rows of an `if` join written at the call: its own list (the non-null half of a
// `[] | null`) and each arm's `[]` tail, which a body's write decides as it decides a bare `[]`.
function openJoinListRows(ix: i32, rows: i32[], depth: i32) {
  if ix < 0 || ix >= P.nodes.length || depth > 8 { return 0 }
  const n = nodeAt(ix)
  if !(n is IfStmt) { return 0 }
  let jt = nodeTyIxOf(ix)
  if jt >= 0 && jt < T.tys.length {
    const j = tyAt(jt)
    if j is TyNullable { jt = j.nInner }
  }
  if jt >= 0 && jt < T.tys.length {
    const l = tyAt(jt)
    if l is TyArray {
      if l.aElem < 0 && !i32ListHas(rows, jt) { rows.push(jt) }
    }
  }
  if n is IfStmt {
    openJoinArmRows(n.ifThen, rows, depth)
    openJoinArmRows(n.ifElse, rows, depth)
  }
  0
}

function openJoinArmRows(arm: i32, rows: i32[], depth: i32) {
  if arm < 0 || arm >= P.nodes.length { return 0 }
  let tail = arm
  const b = nodeAt(arm)
  if b is Block {
    if b.blkStmts.length == 0 { return 0 }
    tail = peelParenIx(b.blkStmts[b.blkStmts.length - 1])
  }
  if tail < 0 || tail >= P.nodes.length { return 0 }
  if isEmptyArrayLitNode(tail) {
    const t = nodeTyIxOf(tail)
    if t >= 0 && !i32ListHas(rows, t) { rows.push(t) }
    return 0
  }
  openJoinListRows(tail, rows, depth + 1)
}

// Whether node `ix` is a `[]` with no elements.
function isEmptyArrayLitNode(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is ArrayLit { return n.arrElems.length == 0 }
  false
}

// Whether node `ix` is a recorded `__array_new_default__(n)` call.
function arrDefCallNode(ix: i32): boolean { i32ListHas(arrDefCallIx, ix) }

// The redirect for another language's list constructor, keyed on the spelling `Array`; ""
// for any other name.
export function arrayCtorNote(name: string): string {
  if name != "Array" { return "" }
  " — VL has no `Array` constructor: `n` copies of `v` is `filled(n, v)` (`import { filled } from \"std:array\"`), and an empty list is `[]`"
}

// `arrayCtorNote` for an `Array` that is called (`Array(n, v)`), "" for any other use of the
// name, such as `Array.isArray(x)`.
export function arrayCtorCallNote(name: string, ix: i32): string {
  if ix != ckCalleeIx { return "" }
  arrayCtorNote(name)
}

// Resolves a written annotation name in the context of generic type-parameter names: params
// bind to their `TyVar`s in the type-param environment `nameToTy` consults, so a bare `T`, a
// `T[]` suffix, a structural shape, and a generic alias application all resolve through one
// name grammar. Memoized only for the env-free case (a live `tpEnv` bypasses, since one spelling means different types under different bindings), and only once resolution succeeds.
export let annotNameMemo: {[string]: i32} = Map()

// Failed resolutions memoize too, under the version that failed (`cUserTypesVer`): a name
// unresolvable now may resolve once later declarations register, so the negative hit is
// honored only while no new declared-name resolution has registered since. `nameToTy` mints
// partial types before failing, so an un-memoized failure re-probed in a loop would still grow the arena.
export let annotNameMemoNegVer: {[string]: i32} = Map()

// The component the failure banked also restores from a negative memo hit (`unkTyPart`) —
// without it a diagnostic would quote whichever name failed last anywhere in the program,
// since pass 1 hoists every signature (priming the negative memo) before pass 2 reports.
export let annotPart: {[string]: string} = Map()

// The unseparable-member reason (`unkTyClash`) restores the same way and for the same
// mechanism: a negative memo hit returns -1 without re-entering the resolver, so a hoisted
// pass-1 signature reported in pass 2 would otherwise fall back to the generic wording. Kept
// as a separate map from `annotPart` since the two are different bank fields, each restored on its own.
export let annotClash: {[string]: string} = Map()

// The component banked for the failing spelling `name`, or "".
export function annotPartOf(name: string) { return annotPart[name] ?? "" }

// The unseparable-member reason banked for the failing spelling `name`, or "".
export function annotClashOf(name: string) { return annotClash[name] ?? "" }

// Whether the callee `ix` spelled `name` resolves to a module global whose declaration pass 2 has not reached.
export function globalBeforeDecl(ix: i32, name: string): boolean {
  identDepthOf(ix, name) == 0 && (moduleBeforeDecl[name] ?? -1) >= 0
}

// A-exhaust: the arena nodes of `is` conditions `ifChainExhausts` PROVED true — the last arm
// of an exhaustive chain, reached only when the value is one of the members no earlier arm
// covers. The emitter reads it to lower that arm as the bare `else` the design names, rather
// than re-deriving coverage from the arena.
export let chainProvenCond: i32[] = []

// Whether `ix` is a condition the exhaustiveness proof marked always-true.
export function condProvenTrue(ix: i32) {
  if ix < 0 { return false }
  let i = 0
  while i < chainProvenCond.length {
    if chainProvenCond[i] == ix { return true }
    i = i + 1
  }
  false
}

// The container types `v128NestCheck` already reported, so one type is refused once.
export let v128NestReported: i32[] = []

// The annotation nodes `voidStoreCheck` already refused, so one annotation is refused once.
export let voidStoreReported: i32[] = []

// How many refusals this walk dropped as a repeat of one keyed by a type or a message, which a
// refusal in another module may have raised first.
export let diagKeyDrops = 0
export function diagKeyDropNote(): i32 {
  diagKeyDrops = diagKeyDrops + 1
  0
}

// Readies the checker for another walk of the program it just checked: the parse's spellings
// restored and every per-walk table emptied, the generic-token mark kept.
export function checkRestart() {
  const genTok = jwGenTokStart
  canonRestoreSpellings()
  initChecker()
  jwSetGenTokStart(genTok)
  0
}

// The joined list type `inferJoinListIdx` banked for the function keyed `name`, or -1.
export function inferJoinListTyOf(name: string): i32 {
  const h = inferJoinListIdx[name]
  if h is i32 { return h }
  -1
}

// Whether the checker delivered node `ix` as a record field's value.
export function ctxIsFieldValue(ix: i32): boolean { ctxFieldNodes.has(ix) }

// The destination type node `ix` is delivered at, or -1 where no delivery recorded one.
export function nodeCtxTyIxOf(ix: i32): i32 {
  if ix < 0 || ix >= nodeCtxTyIx.length { return -1 }
  nodeCtxTyIx[ix]
}

// The context-resolved companion of `nodeTyIxOf`: returns the destination type recorded by
// `recordRepTyAdopt` at an adoption site when present, else the naive `nodeTyIxOf`. The
// emitter's rep/layer resolvers key on this so a widened literal's row resolves to the shape
// the emitter actually builds.
export function nodeRepTyIxOf(ix: i32) {
  if ix >= 0 {
    if ix < nodeRepTyIx.length {
      const r = nodeRepTyIx[ix]
      if r >= 0 { return r }
    }
  }
  nodeTyIxOf(ix)
}

// The map type a union of maps at `ix` is delivered as, or -1 (`recordMapUnbox`).
export function mapUnboxTyOf(ix: i32): i32 { colAt(mapUnboxTyIx, ix) }

// The record the value at `ix` is copied into where it is delivered, or -1 (`recordRecCopy`).
export function recCopyTyOf(ix: i32): i32 { colAt(recCopyTyIx, ix) }

// Whether any delivery copies a record (`recordRecCopy`).
export function recCopyAny(): boolean { recCopyTyIx.length > 0 }

// The lazily-built placeholder `TyFunc` for closure pins — only its `is TyFunc`-ness is read
// (via `nodeTyIsFunc`); the real signature rides the pin column's payload. Reset per program.
export function funcPinTyIx() {
  if cFuncPinTyIx < 0 {
    const ps: i32[] = []
    cFuncPinTyIx = mkFuncTy(ps, -1)
  }
  cFuncPinTyIx
}

// The lazily-built placeholder `TyObj` for interned anonymous shapes — only its `is TyObj`-ness
// is read (`nodeTyIsStruct`); the real layout rides the `#anonN` name (the emitter's `sNames` table).
export function objPinTyIx() {
  if cObjPinTyIx < 0 {
    const ns: string[] = []
    const ts: i32[] = []
    cObjPinTyIx = mkObjTy(ns, ts)
  }
  cObjPinTyIx
}

// Whether `nm` mentions any of the module's generic-alias type-parameter names
// (`nameMentionsIdent`'s whole-token match, not a substring test).
export function nameMentionsGenAliasParam(nm: string): boolean {
  let i = 0
  while i < gaParamNames.length {
    if nameMentionsIdent(nm, gaParamNames[i]) { return true }
    i = i + 1
  }
  false
}

// Record `+` link `ix`, whose left operand checked as `lt`, for `plusLinkCount` and its readers.
export function plusLinkRecord(ix: i32, lt: i32) {
  if ix < 0 || ix >= nodeToks.length { return 0 }
  const tk = nodeToks[ix]
  if tk < 0 { return 0 }
  plusLinkTok.push(tk)
  if lt >= 0 && concatsAsStr(lt) {
    plusLinkStr.push(1)
  } else {
    plusLinkStr.push(0)
  }
  0
}

export function plusLinkCount() { plusLinkTok.length }

export function plusLinkTokAt(i: i32) { plusLinkTok[i] }

export function plusLinkStrAt(i: i32) { plusLinkStr[i] }

// Record index read `ix`, whose receiver checked as `rt`, for `strIdxCount` and its readers.
export function strIdxRecord(ix: i32, rt: i32) {
  if ix < 0 || ix >= nodeToks.length { return 0 }
  const tk = nodeToks[ix]
  if tk < 0 { return 0 }
  strIdxTok.push(tk)
  strIdxStr.push(if isStringTy(rt) { 1 } else { 0 })
  0
}

export function strIdxCount() { strIdxTok.length }

export function strIdxTokAt(i: i32) { strIdxTok[i] }

export function strIdxStrAt(i: i32) { strIdxStr[i] }

// Whether the `match` arm `body` is a block that always exits, which hands the join nothing and
// is noted for the emitter's `never` tail, as an `if` arm is (D3222).
export function matchArmExits(ix: i32, body: i32, armTy: i32): boolean {
  // An arm with a value cannot always exit, and a statement or tail `match` (`matchOnSpine`)
  // lowers its arms without one, so neither pays for the walk of the arm.
  if matchOnSpine || !isVoidTy(armTy) || !(nodeAt(body) is Block) {
    return false
  }
  const mn = nodeAt(ix)
  let first = false
  if mn is MatchExpr {
    first = mn.matchBodies.length > 0 && mn.matchBodies[0] == body
  }
  if !stmtAlwaysExits(body) { return false }
  if first && atValueArmTail(ix) { lpColSet(nestedExitFirstAt, ix, 1) }
  noteExitArm(body)
  if first { noteExitFirst(ix) }
  true
}

// Whether a `const`-pattern refusal already reported arm pattern `patIx`.
export function matchPatWasRefused(patIx: i32) {
  matchPatRefused[patIx] ?? false
}

export let matchOnSpine = false
export function matchOnSpineSet(v: boolean) { matchOnSpine = v }

// Whether `n` (node `ix`) names a generic function declaration.
export function fvaNamesGeneric(n: Node, ix: i32): boolean {
  if n is Ident {
    const gd = identFnDeclOf(ix)
    if gd < 0 { return false }
    const gf = nodeAt(gd)
    if gf is FuncDecl { return gf.fnTyParams.length > 0 }
  }
  false
}

// Whether `n` (node `ix`) names a binding the adapter may read at call time: a function
// declaration or a `const`, neither of which a later statement can rebind.
export function fvaStableName(n: Node, ix: i32): boolean {
  if n is Ident {
    if identFnDeclOf(ix) >= 0 { return true }
    return identIsConst(ix)
  }
  false
}

// The type of the statement the enclosing block checked last: a `break v`'s value is the
// statement just before the break (`BreakStmt.brkHasVal`).
export let brkPrevTy = -1
export function brkPrevTySet(v: i32) { brkPrevTy = v }
export let brkPrevIx = -1
export function brkPrevIxSet(v: i32) { brkPrevIx = v }

// The arm block of a value `if` or `match` being checked, or -1. A construct standing at its tail
// is read through its first arm by the enclosing construct's classifiers, which a first arm with
// no value misleads, so an exit there keeps the `void` join and its check reject (D3222).
export let valueArmAt = -1
export function valueArmAtSet(v: i32) { valueArmAt = v }

// Whether the construct at `ix` is the tail statement of the value arm block being checked. A
// construct elsewhere in the arm, such as a binding's initializer, is read by its own name.
export function atValueArmTail(ix: i32): boolean {
  if chkStmtBlk < 0 || chkStmtBlk != valueArmAt { return false }
  const b = nodeAt(chkStmtBlk)
  if b is Block {
    const st = b.blkStmts
    return st.length > 0 && cwPeel(st[st.length - 1]) == ix
  }
  false
}

// The `match`es whose exiting first arm stands at another construct's value arm tail, whose
// joined type `refuseNestedExitFirst` asks once it is known.
export let nestedExitFirstAt: i32[] = []

// Whether any loop or labelled block of the program carries a value, so the emitter's
// rewrite of them costs a program without one nothing.
export function loopValAny(): boolean { lpValSeen }

export let lpValSeen = false
export function lpValSeenSet(v: boolean) { lpValSeen = v }

// The blocks whose tail follows a statement that always exits: the checker types no value from
// such a tail, so the emitter drops it before collection rather than lower it (D8720).
export let deadTailBlks: i32[] = []
export function noteDeadTailBlk(blockIx: i32) { deadTailBlks.push(blockIx) }
