// The record-adoption rows: a binding or function holding only literals takes the record it is
// delivered to (DECISIONS.md "Record covariance"). Each pass's demands, the solve's pins and
// refusals, the refused and width-changing sets, and the declarations an adoption rewrote, with
// the queries that ask whether a node reads one (`recAdAdoptedCall`). The checker solves and
// reports; `recAdPassReset` drops one pass's rows and `recAdReset` all of them, per program.
import { Call, FuncDecl, Ident, Node, P, nodeChildren } from "./ast"
import { strListHas } from "./listutil"

// This pass's demands: the declaration, the record the binding (or its list's element) holds,
// the record it is delivered as, whether it is a list's element, and the delivery.
export let recAdDecl: i32[] = []
export let recAdOwn: i32[] = []
export let recAdDst: i32[] = []
export let recAdElem: boolean[] = []
export let recAdAt: i32[] = []
// The solve's answer: declarations to re-check with an annotation, and the refusals it owes.
export let recAdPinDecl: i32[] = []
export let recAdPinTy: string[] = []
export let recAdPinSpell: string[] = []
export let recAdErrMsg: string[] = []
export let recAdErrAt: i32[] = []
// Declarations whose adoption a re-check refused, and the nodes the pins replaced; both last
// the whole program's check.
export let recAdNoAdopt: {[i32]: boolean} = Map()
// The declarations an adoption currently rewrites, the types they are bound at in this pass,
// and how many of this pass's refusals are about something other than an adopted value as a
// whole: those are what a literal's own type served, so they undo the adoption.
export let recAdPinned: {[i32]: boolean} = Map()
// Bindings adopted at a record that stores a number at another width or kind: their reads
// compute at the adopted type, so a re-check's refusal stands instead of undoing them (D3339).
export let recAdWidth: {[i32]: boolean} = Map()
// This pass's deliveries accepted only because they adopt (`recAdForce`), and their bindings.
export let recAdForced: i32[] = []
export let recAdForcedDecl: i32[] = []
// Parallel to `recAdOrigDecl`: each rewritten declaration's name, whether it is a function, and
// the type the adoption wrote.
export let recAdOrigName: string[] = []
export let recAdOrigFn: boolean[] = []
export let recAdOrigTy: string[] = []
export let recAdBound: i32[] = []
export let recAdLoose = 0
export let recAdRaising = false
export let recAdOrigDecl: i32[] = []
export let recAdOrigNode: Node[] = []

// Drop one pass's demands; the pins and the refused set outlive it.
export function recAdPassReset() {
  recAdBound = []
  recAdLoose = 0
  recAdForced = []
  recAdForcedDecl = []
  recAdDecl = []
  recAdOwn = []
  recAdDst = []
  recAdElem = []
  recAdAt = []
  recAdPinDecl = []
  recAdPinTy = []
  recAdPinSpell = []
  recAdErrMsg = []
  recAdErrAt = []
  0
}

// Drop everything, before a program's first pass.
export function recAdReset() {
  recAdPassReset()
  recAdNoAdopt = Map()
  recAdPinned = Map()
  recAdWidth = Map()
  recAdOrigName = []
  recAdOrigFn = []
  recAdOrigTy = []
  recAdOrigDecl = []
  recAdOrigNode = []
  0
}

// Does `x` read, within a few levels, a binding or call whose type an adoption wrote? An
// annotation such a value meets is what adopted it, never redundant.
export function recAdAdoptedCall(x: i32): boolean {
  if recAdOrigDecl.length == 0 { return false }
  recAdMentions(x, 6)
}

// Does an adopted declaration bind `name`? By name only: this decides a hint, not a type.
function recAdIsAdoptedName(name: string): boolean {
  strListHas(recAdOrigName, name)
}

export function recAdMentions(x: i32, depth: i32): boolean {
  if x < 0 || x >= P.nodes.length || depth <= 0 { return false }
  const n = P.nodes[x]
  if n is Ident { return recAdIsAdoptedName(n.identName) }
  if n is Call {
    const cn = P.nodes[n.callFn]
    if cn is Ident {
      if recAdIsAdoptedName(cn.identName) { return true }
    }
  }
  if n is FuncDecl { return false }
  for c in nodeChildren(x) {
    if recAdMentions(c, depth - 1) { return true }
  }
  false
}
