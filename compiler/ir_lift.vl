// `ir_lift.vl` — the lambda-lift decision table: per `fnStmts` slot, whether its function is lifted
// (its captures travel as parameters, so no closure value is built), the frame and binding each
// lifted `const` pairs with, and the captures each one writes back. `ir_lift_scan.vl` fills it;
// the signature writer and the IR builder read it.

// Per lifted slot, parallel to `fnStmts`: the capture count of a function `cloLiftScan`
// lambda-lifted (every use a direct call, so its captures travel as leading parameters after
// the env and no closure value is built), or -1. `cloLiftFrame`/`cloLiftLet` pair each lifted
// `const` binding with the frame that declares it, so that frame skips the binding (SP-037).
export let cloLiftCapN: i32[] = []
export let cloLiftFrame: i32[] = []
export let cloLiftLet: i32[] = []
export let cloLiftFe: i32[] = []
// Every slot `cloLiftScan` lifted, in `fnStmts` order.
export let cloLiftedFes: i32[] = []
// A captured `let` every capturer of which is lifted stays a plain local (D3664): the
// FuncDecl nodes `captureBoxRewrite` left such a binding unboxed for, each of which
// `cloLiftScan` must lift, and pairs of a capturer node with a binding it assigns.
export let cloUnboxNeed: i32[] = []
export let cloUnboxWrFn: i32[] = []
export let cloUnboxWrName: string[] = []
// Per lifted slot, the captures it assigns, returned after its result and written back by
// every call site: `cloLiftWrStart[fe]`/`cloLiftWrN[fe]` slice the capture indices
// `cloLiftWrIdx` and their names `cloLiftWrName`.
export let cloLiftWrStart: i32[] = []
export let cloLiftWrN: i32[] = []
export let cloLiftWrIdx: i32[] = []
export let cloLiftWrName: string[] = []

// The parameter slot of capture `name` that lifted slot `fe` assigns, or -1.
export function cloLiftWriteSlot(fe: i32, name: string): i32 {
  if fe < 0 || fe >= cloLiftWrN.length { return -1 }
  const start = cloLiftWrStart[fe]
  let j = 0
  while j < cloLiftWrN[fe] {
    if cloLiftWrName[start + j] == name { return 1 + cloLiftWrIdx[start + j] }
    j = j + 1
  }
  return -1
}

// Clears the per-program unboxing and write-back tables.
export function cloLiftWrReset() {
  cloUnboxNeed = []
  cloUnboxWrFn = []
  cloUnboxWrName = []
  cloLiftWrStart = []
  cloLiftWrN = []
  cloLiftWrIdx = []
  cloLiftWrName = []
  return 0
}

// The capture index of the `j`th capture lifted slot `fe` assigns.
export function cloLiftWriteCapAt(fe: i32, j: i32): i32 {
  return cloLiftWrIdx[cloLiftWrStart[fe] + j]
}

// How many captures lifted slot `fe` assigns and returns.
export function cloLiftWriteCount(fe: i32): i32 {
  if fe < 0 || fe >= cloLiftWrN.length { return 0 }
  return cloLiftWrN[fe]
}

// The lifted slot the `const` binding at `letIx` in frame position `pos` stands for, or -1.
export function cloLiftLetFe(pos: i32, letIx: i32): i32 {
  let i = 0
  while i < cloLiftLet.length {
    if cloLiftLet[i] == letIx && cloLiftFrame[i] == pos { return cloLiftFe[i] }
    i = i + 1
  }
  return -1
}

// Whether slot `fe` is lambda-lifted.
export function cloLifted(fe: i32): boolean {
  return fe >= 0 && fe < cloLiftCapN.length && cloLiftCapN[fe] >= 0
}
