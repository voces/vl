// What an engine validation message says, read back by the compiler. A leaf: no
// imports, so `tests/vl_engine_fail_offset_test.ts` runs it alone over the case table
// `tests/fixtures/engine-fail-offset.txt`, which the host's Rust twin
// (`engine_fail_offset`, scripts/vl-host/src/main.rs) is tested against too.

// The byte offset an engine validation message names, or -1 when it names none.
// wasmtime spells it `(at offset 0x11b)` or `at offset 188`. The last occurrence that
// parses to a non-negative i32 wins, since a `Caused by:` chain repeats the inner
// message under the outer one.
export function engineFailOffset(msg: string): i32 {
  const key = "at offset "
  let found = -1
  let i = 0
  while i + key.length <= msg.length {
    if efoKeyAt(msg, i, key) {
      const v = efoNumberAt(msg, i + key.length)
      if v >= 0 { found = v }
    }
    i = i + 1
  }
  found
}

function efoKeyAt(msg: string, i: i32, key: string): boolean {
  let k = 0
  while k < key.length {
    if msg[i + k] != key[k] { return false }
    k = k + 1
  }
  true
}

// The `0x` hex or decimal number at `p`, or -1 when there is none or it overflows i32.
function efoNumberAt(msg: string, at: i32): i32 {
  let p = at
  let radix = 10
  if p + 1 < msg.length && msg[p] == '0' && msg[p + 1] == 'x' {
    radix = 16
    p = p + 2
  }
  let v = 0
  let n = 0
  while p < msg.length {
    const d = efoDigit(msg[p], radix)
    if d < 0 { break }
    if v > (2147483647 - d) / radix { return -1 }
    v = v * radix + d
    n = n + 1
    p = p + 1
  }
  if n == 0 { return -1 }
  v
}

function efoDigit(c: i32, radix: i32): i32 {
  if c >= '0' && c <= '9' { return c - '0' }
  if radix == 16 && c >= 'a' && c <= 'f' { return c - 'a' + 10 }
  if radix == 16 && c >= 'A' && c <= 'F' { return c - 'A' + 10 }
  -1
}
