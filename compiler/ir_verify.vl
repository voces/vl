// The IR verifier (ir-design-2026-11.md §2): one linear walk over an `IrFn` that checks rules
// 1-7: closed reps, rep agreement, types against reps, definitions before uses, control, calls
// and switch coverage. Rule 10 keeps raw reps and ops (`RRaw`, `RRawOp`, `SRawOp`) and valued
// blocks and branches inside a runtime helper, each reference operand at its op's heap type, and
// each `push` the leading operand of the next raw effect, in push order. It
// answers the first rule a function breaks, with the node; it never reports through the
// emitter's failure channel. Bounds (rule 8) arrive with the list nodes'
// builder, and trap order (rule 9) with the first pass that moves a check. Until steps I2-I7
// build them, the arms for records, lists, casts, tags, maps and closures have no input.
import { NULL_OWN_BOX, NULL_OWN_NONE } from "./emit_plan_null"
import {
  IrFn,
  IrNode,
  OImm,
  OStr,
  OVar,
  Opnd,
  PStaged,
  RAtomEq,
  RAtomStr,
  RBoxField,
  RBoxNarrow,
  RBundlePick,
  RCall,
  RCallHost,
  RCallRef,
  RCast,
  RCellGet,
  RCellNew,
  RCoalAtomStr,
  RCoalStr,
  REnvDrop,
  REnvGet,
  RFnId,
  RGetField,
  RGlobalGet,
  RListClear,
  RListCopy,
  RListEq,
  RListGet,
  RListLen,
  RListNew,
  RListPop,
  RListPush,
  RListSlice,
  RListStage,
  RMakeClo,
  RMakeList,
  RMakeRec,
  RMapFilter,
  RMapGet,
  RMapGetOr,
  RMapHas,
  RMapNew,
  RMapOp,
  RMapSet,
  RNulTest,
  RNullOf,
  RNumCast,
  RNumIntr,
  RNumWiden,
  RPrimOp,
  RPrint,
  RRawOp,
  RRecover,
  RRel,
  RRetNull,
  RRetag,
  RSharedRead,
  RSpread,
  RStage,
  RStrOp,
  RTagIs,
  RTagOf,
  RTagStash,
  RTest,
  RToBox,
  RUnionEq,
  Rhs,
  SAssign,
  SBlock,
  SBoundsCheck,
  SBr,
  SCellSet,
  SCoalBox,
  SDrop,
  SEffect,
  SForIn,
  SGlobalSet,
  SIf,
  SLet,
  SListSet,
  SLoop,
  SRawOp,
  SReturn,
  SSetField,
  SSwitch,
  STrap,
  irBodyLeaves,
  irFnNew,
  irGlobalRepOf,
  irPushBodies,
  irSigOf,
} from "./ir"
import {
  RAtom,
  RBox,
  RClosure,
  RList,
  RMap,
  RNullable,
  RPrim,
  RRaw,
  RRecord,
  RUnsup,
  repNodeAt,
  repNodeKids,
  repNodeOfTy,
} from "./emit_rep"
import { repBoolNiche, repIsNoValue, repIsScalar, repPrim, repWhat } from "./ir"
import { tyHasTyVar } from "./tyquery"
import { TY_BOOL, TY_I32, TY_STR, tyScalarBasePrim } from "./check_types"
import { i32ToStr } from "./ast"
import { exprEffectFree } from "./emit_base"
import { nodeTyAt } from "./emit_capture_frames"
import { tyOpenHeldAsIds } from "./emit_classify"
import { fnFallThroughPadOf } from "./wasmEmit"

// A verdict: rule 0 with node -1 when `f` holds, else the first rule broken, at node `vfNode`
// (-1 for a variable or the header), with the reason.
export type IrVerdict = { vfRule: i32, vfNode: i32, vfMsg: string }

let vf = irFnNew(-1, "")
let vfRule = 0
let vfAt = -1
let vfMsg = ""
let vfDefined: boolean[] = []
// The temps defined in the open bodies, in order, so a body's exit undoes its own.
let vfDefLog: i32[] = []
// The `push` temps not yet consumed, in push order, and which temps are such pushes.
let vfPushed: i32[] = []
let vfPushes: {[i32]: boolean} = Map()
// Whether the walk met a receiver stage, so the stage rule has a pairing to check.
let vfStaged = false
let vfLabels: i32[] = []
let vfLabelOut: i32[] = []
let vfBool = -1
let vfI32 = -1
let vfStr = -1

function fail(rule: i32, at: i32, msg: string) {
  if vfRule == 0 {
    vfRule = rule
    vfAt = at
    vfMsg = msg
  }
  return 0
}

function varRep(v: i32): i32 {
  if v < 0 || v >= vf.irVars.length { return -1 }
  return vf.irVars[v].vRep
}

// Number kind of rep `r` as `widenPlanOf` names it (1 i32, 3 i64, 4 f64, 5 f32), or -1.
export function numKindOf(r: i32): i32 {
  const p = repPrim(r)
  if p == null { return -1 }
  return match p {
    "i32" => 1
    "i64" => 3
    "f64" => 4
    "f32" => 5
    "bool" | "str" | "u8" | "null" | "v128" => -1
  }
}

function opRep(o: Opnd): i32 {
  return match o {
    OVar => varRep(o.ov)
    OImm => o.oiRep
    OStr => o.osRep
  }
}

// A map operation's receiver: global `sym` of a map rep, or, where `sym` is -1, a variable `loc`
// of one, read as a use.
// The rep of a map receiver: global `sym`'s noted rep, or operand `loc`'s.
function mapRecvRep(sym: i32, loc: Opnd): i32 {
  return if sym >= 0 { irGlobalRepOf(vf, sym) } else { opRep(loc) }
}

function mapRecvOk(sym: i32, loc: Opnd, at: i32): boolean {
  if sym >= 0 { return repNodeAt(irGlobalRepOf(vf, sym)) is RMap }
  if !(loc is OVar) || loc.ov < 0 || loc.ov >= vf.irVars.length { return false }
  use(loc, at)
  return repNodeAt(opRep(loc)) is RMap
}

// Rule 4 at a use: a temp is read only once its one definition is in scope.
function use(o: Opnd, at: i32) {
  match o {
    OVar => {
      if vfPushes[o.ov] ?? false {
        return fail(
          10,
          at,
          "a push read anywhere but as its store's leading operand",
        )
      }
      if o.ov < 0 || o.ov >= vf.irVars.length {
        return fail(
          4,
          at,
          "reads v" + i32ToStr(o.ov) + ", which does not exist",
        )
      }
      if vf.irVars[o.ov].vKind == "temp" && !vfDefined[o.ov] {
        return fail(
          4,
          at,
          "reads temp v" + i32ToStr(o.ov) + " before its definition",
        )
      }
      0
    }
    OImm | OStr => 0
  }
  return 0
}

function uses(os: Opnd[], at: i32) {
  for o in os { use(o, at) }
  return 0
}

function isNum(k: string): boolean {
  return k == "i32" || k == "i64" || k == "f64" || k == "f32"
}

function isInt(k: string): boolean { return k == "i32" || k == "i64" }

// 1 when operand `o` is a variable typed at an unsigned integer, 0 at any other type, -1 for an
// immediate, which carries no type.
function opUnsignedTy(o: Opnd): i32 {
  const v = opndVar(o)
  if v < 0 || v >= vf.irVars.length { return -1 }
  const p = tyScalarBasePrim(vf.irVars[v].vTy)
  if p == null { return 0 }
  const ps: string = p
  return if ps == "u32" || ps == "u64" { 1 } else { 0 }
}

function opndVar(o: Opnd): i32 {
  return match o {
    OVar => o.ov
    OImm | OStr => -1
  }
}

// Rule 2 for a primitive op: its operands' reps and its result rep `dst`.
function primSig(r: RPrimOp, dst: i32, at: i32) {
  const a = r.poArgs
  const unary = r.poOp == "neg" || r.poOp == "not"
  const want = if unary { 1 } else { 2 }
  if a.length != want {
    return fail(
      2,
      at,
      r.poOp
        + " takes "
        + i32ToStr(want)
        + " operands, got "
        + i32ToStr(a.length),
    )
  }
  const ar = opRep(a[0])
  // eq/ne compares the i32 cells of a bool and a `boolean | null` niche; the null sentinel 2
  // equals only null.
  const niche = !unary
    && (r.poOp == "eq" || r.poOp == "ne")
    && nicheBoolPair(ar, opRep(a[1]))
  if !unary && opRep(a[1]) != ar && !niche {
    return fail(2, at, r.poOp + "'s operands differ in rep")
  }
  const k = if niche { "bool" } else { repWhat(ar) }
  const op = r.poOp
  const kindOk = match op {
    "add" | "sub" | "mul" | "div" | "rem" | "lt" | "le" | "gt" | "ge" | "neg" => isNum(k)
    "divu" | "remu" | "ltu" | "leu" | "gtu" | "geu" | "shl" | "shr" | "shru" => isInt(k)
    "and" | "or" | "xor" => isInt(k) || k == "bool"
    "eq" | "ne" => isNum(k) || k == "bool"
    "not" => k == "bool"
  }
  if !kindOk { return fail(2, at, r.poOp + " has no signature over " + k) }
  // The signed and unsigned forms must agree with the operand's type, which the rep cannot say.
  const wantsUnsigned = match op {
    "divu" | "remu" | "ltu" | "leu" | "gtu" | "geu" => 1
    "div" | "rem" | "lt" | "le" | "gt" | "ge" | "shr" => 0
    "add" | "sub" | "mul" | "shl" | "shru" | "and" | "or" | "xor" | "eq" | "ne" | "neg" | "not" => -1
  }
  if wantsUnsigned >= 0 {
    for o in a {
      const u = opUnsignedTy(o)
      if u >= 0 && u != wantsUnsigned {
        return fail(2, at, r.poOp + "'s signedness is not its operand's type's")
      }
    }
  }
  const cmp = match op {
    "eq" | "ne" | "lt" | "ltu" | "le" | "leu" | "gt" | "gtu" | "ge" | "geu" | "not" => true
    "add" | "sub" | "mul" | "div" | "divu" | "rem" | "remu" | "neg" | "shl" | "shr" | "shru" | "and" | "or" | "xor" => false
  }
  const res = if cmp { vfBool } else { ar }
  if dst != res {
    return fail(2, at, r.poOp + "'s result is not its destination's rep")
  }
  return 0
}

// Whether reps `x` and `y` are each `boolean` or its `boolean | null` niche, one of them a niche.
function nicheBoolPair(x: i32, y: i32): boolean {
  const xn = repBoolNiche(x)
  const yn = repBoolNiche(y)
  return (xn || repPrim(x) == "bool")
    && (yn || repPrim(y) == "bool")
    && (xn || yn)
}

// Rules 2 and 6 for a call of callee `fnPos` with `args` into a destination of rep `dst`
// (-1 for an effect, which keeps no result).
function callSig(fnPos: i32, args: Opnd[], dst: i32, at: i32) {
  const si = irSigOf(vf, fnPos)
  if si < 0 {
    return fail(6, at, "calls f" + i32ToStr(fnPos) + ", which has no signature")
  }
  const ps = vf.irSigParams[si]
  if ps.length != args.length {
    return fail(
      6,
      at,
      "passes "
        + i32ToStr(args.length)
        + " arguments to "
        + i32ToStr(ps.length)
        + " parameters",
    )
  }
  let i = 0
  while i < ps.length {
    if opRep(args[i]) != ps[i] {
      return fail(
        6,
        at,
        "argument " + i32ToStr(i) + "'s rep is not its parameter's",
      )
    }
    i = i + 1
  }
  if dst >= 0 && dst != vf.irSigRet[si] {
    return fail(6, at, "the result rep is not the callee's")
  }
  return 0
}

function kidAt(r: i32, i: i32): i32 {
  const ks = repNodeKids(r)
  if i < 0 || i >= ks.length { return -1 }
  return ks[i]
}

// Rule 2: `r`'s operands and its result rep against destination rep `dst` (-1 for an effect).
// The receiver push `r` at node `at` appends to: its own operand, or the one its stage reads.
// The stage is the receiver's one reader, so a staged push uses nothing of it.
function pushRecvOpnd(r: RListPush, at: i32): Opnd {
  const v = r.lpV
  if v is PStaged {
    const sg = stageAt(v.pstNode)
    if sg == null || sg.rsgAt != r.lpAt {
      fail(10, at, "a staged push names no stage of its own call")
      const none: Opnd = { ov: -1 }
      return none
    }
    return sg.rsgV
  }
  return v
}

// The receiver stage node `id` is, or null.
function stageAt(id: i32): RListStage | null {
  if id < 0 || id >= vf.irNodes.length { return null }
  const n = vf.irNodes[id]
  if !(n is SEffect) { return null }
  const r = n.efRhs
  if r is RListStage { return r }
  return null
}

function rhsCheck(r: Rhs, dst: i32, at: i32) {
  match r {
    RPrimOp => {
      uses(r.poArgs, at)
      primSig(r, dst, at)
    }
    RCall => {
      uses(r.caCaps, at)
      uses(r.caArgs, at)
      callSig(r.caCallee, r.caArgs, dst, at)
    }
    RCallRef => {
      use(r.crFn, at)
      uses(r.crArgs, at)
      if !(repNodeAt(opRep(r.crFn)) is RClosure) {
        return fail(2, at, "call_ref of a non-closure")
      }
      0
    }
    RCallHost => {
      uses(r.chArgs, at)
      if r.chVoid && dst >= 0 {
        return fail(2, at, "a void host call has no value")
      }
      0
    }
    RBoxField => {
      use(r.bfV, at)
      const bf = repNodeAt(opRep(r.bfV))
      if !(bf is RBox) && !(bf is RNullable && bf.rnDisc == 4) {
        return fail(2, at, "a narrowed field's receiver is a box")
      }
      0
    }
    RSharedRead => {
      use(r.srV, at)
      // Unstashed, every arm reads the receiver twice, and a temp is read once.
      if (
        !r.srStash
        && (!(r.srV is OVar)
          || r.srV.ov < 0
          || r.srV.ov >= vf.irVars.length
          || vf.irVars[r.srV.ov].vKind == "temp")
      ) {
        return fail(
          2,
          at,
          "a shared read's receiver is a variable read more than once",
        )
      }
      // A boxed `U | null` (discipline 4) is held in the same box.
      const sn = repNodeAt(opRep(r.srV))
      if !(sn is RBox) && !(sn is RNullable && sn.rnDisc == 4) {
        return fail(2, at, "a shared read's receiver is a box")
      }
      0
    }
    RBoxNarrow => {
      use(r.bnV, at)
      const bn = repNodeAt(opRep(r.bnV))
      const boxed = bn is RBox
        || bn is RNullable
        && bn.rnDisc == 4
        && (r.bnAtom >= 0 || repNodeAt(dst) is RRecord)
      if !boxed {
        return fail(2, at, "a narrowed variant read's operand is a box")
      }
      0
    }
    RRecover => {
      use(r.rcV, at)
      if !(repNodeAt(opRep(r.rcV)) is RNullable) {
        return fail(2, at, "a recovered read's operand is nullable")
      }
      0
    }
    RTest => {
      use(r.teV, at)
      if dst >= 0 && dst != vfBool { return fail(2, at, "`is` yields bool") }
      const tn = repNodeAt(opRep(r.teV))
      if !(tn is RBox) && !(tn is RNullable && tn.rnDisc == 4) {
        return fail(2, at, "a box test's operand is a box")
      }
      0
    }
    RCast => {
      use(r.ctV, at)
      if dst < 0 { return 0 }
      const ok = if r.ctOnFail == "trap" { dst == r.ctTarget } else { repNodeAt(dst) is RNullable && kidAt(dst, 0) == r.ctTarget }
      if !ok { return fail(2, at, "a cast's result is not its target's rep") }
      0
    }
    RTagOf => {
      use(r.tgV, at)
      if !(repNodeAt(opRep(r.tgV)) is RBox) {
        return fail(2, at, "a tag of a non-box")
      }
      if dst >= 0 && dst != vfI32 { return fail(2, at, "a tag is an i32") }
      0
    }
    RMakeRec => {
      uses(r.mrFields, at)
      if dst < 0 { return 0 }
      const ks = repNodeKids(dst)
      if !(repNodeAt(dst) is RRecord) || ks.length != r.mrFields.length {
        return fail(2, at, "a record's fields do not match its rep")
      }
      let i = 0
      while i < ks.length {
        if opRep(r.mrFields[i]) != ks[i] {
          return fail(2, at, "field " + i32ToStr(i) + "'s rep differs")
        }
        i = i + 1
      }
      // The layout writes each kid exactly once.
      if r.mrLayout.length != ks.length {
        return fail(2, at, "a record's layout length")
      }
      const seen: boolean[] = []
      for _k in ks { seen.push(false) }
      for k in r.mrLayout {
        if k < 0 || k >= seen.length || seen[k] {
          return fail(2, at, "a record's layout repeats")
        }
        seen[k] = true
      }
      // The order stash's source order, where there is one, evaluates each kid exactly once.
      if r.mrSrc.length > 0 {
        if r.mrSrc.length != ks.length {
          return fail(2, at, "a record's source order length")
        }
        const srcSeen: boolean[] = []
        for _k in ks { srcSeen.push(false) }
        for k in r.mrSrc {
          if k < 0 || k >= srcSeen.length || srcSeen[k] {
            return fail(2, at, "a record's source order repeats")
          }
          srcSeen[k] = true
        }
      }
      0
    }
    RGetField => {
      use(r.gfV, at)
      const v = opRep(r.gfV)
      if !(repNodeAt(v) is RRecord) {
        return fail(2, at, "a field read of a non-record")
      }
      // A union-box field's read unboxes to the read's own rep (`structUnionBoxTail`).
      const k = kidAt(v, r.gfIx)
      const unboxed = repNodeAt(k) is RBox
        && dst == repNodeOfTy(nodeTyAt(r.gfAt, vf.irAt))
      // A nullable field the checker narrowed past its null reads at its inner rep.
      const kn = repNodeAt(k)
      const narrowed = kn is RNullable && kn.rnInner == dst
      if dst >= 0 && k != dst && !unboxed && !narrowed {
        return fail(2, at, "a field's rep is not its destination's")
      }
      // A read at its storage is the field's own box, unboxed nowhere.
      if r.gfStored && (!(repNodeAt(k) is RBox) || dst != k) {
        return fail(2, at, "a field read at its storage is its declared box")
      }
      0
    }
    RMakeList => {
      uses(r.mlElems, at)
      if dst < 0 { return 0 }
      if !(repNodeAt(dst) is RList) {
        return fail(2, at, "a list literal of a non-list rep")
      }
      // A packed list's elements (`u8`, or a sub-word row) are plain i32s, which its backing
      // truncates (`arrayLit`).
      const el = kidAt(dst, 0)
      const en = repNodeAt(el)
      const packed = repPrim(el) == "u8" || en is RPrim && en.rpPacked != 0
      const want = if packed { vfI32 } else { el }
      for e in r.mlElems {
        if opRep(e) != want {
          return fail(2, at, "an element's rep is not the list's")
        }
      }
      0
    }
    RSpread => {
      use(r.spSrc, at)
      if dst < 0 { return 0 }
      if !(repNodeAt(dst) is RList) {
        return fail(2, at, "a spread literal of a non-list rep")
      }
      if opRep(r.spSrc) != dst {
        return fail(2, at, "a spread's source rep is not the literal's")
      }
      0
    }
    RListNew => {
      use(r.lnLen, at)
      use(r.lnFill, at)
      if opRep(r.lnLen) != vfI32 {
        return fail(2, at, "a list length is an i32")
      }
      if dst >= 0 && opRep(r.lnFill) != kidAt(dst, 0) {
        return fail(2, at, "the fill's rep is not the element's")
      }
      0
    }
    RListCopy => {
      for o in r.lcArgs { use(o, at) }
      if r.lcArgs.length != 5 {
        return fail(2, at, "a list copy has five operands")
      }
      const dl = opRep(r.lcArgs[0])
      if !(repNodeAt(dl) is RList) || opRep(r.lcArgs[2]) != dl {
        return fail(2, at, "a list copy's two lists share one list rep")
      }
      for k in [1, 3, 4] {
        if opRep(r.lcArgs[k]) != vfI32 {
          return fail(2, at, "a list copy's offsets and count are i32s")
        }
      }
      0
    }
    RListGet => {
      use(r.lgV, at)
      use(r.lgIx, at)
      const l = opRep(r.lgV)
      if !(repNodeAt(l) is RList) && l != vfStr || opRep(r.lgIx) != vfI32 {
        return fail(
          2,
          at,
          "an element read takes a list or a string, and an i32",
        )
      }
      // A string's element is its code unit, an i32.
      if l == vfStr && dst >= 0 && dst != vfI32 {
        return fail(2, at, "a string's element is an i32")
      }
      // A packed byte reads unsigned into an i32.
      const packed = repPrim(kidAt(l, 0)) == "u8" && dst == vfI32
      // A nullable string element may read recovered at a string.
      const en = repNodeAt(kidAt(l, 0))
      const recovered = en is RNullable && en.rnInner == dst && dst == vfStr
      if l != vfStr && dst >= 0 && kidAt(l, 0) != dst && !packed && !recovered {
        return fail(2, at, "an element's rep is not its destination's")
      }
      0
    }
    RRetag => {
      use(r.rgV, at)
      const d = repNodeAt(dst)
      if (
        !(d is RNullable)
        || !nicheRetag(d.rnDisc, d.rnInner)
        || d.rnInner != opRep(r.rgV)
      ) {
        return fail(
          2,
          at,
          "a retag is not of an atom or a string into its own nullable niche",
        )
      }
      0
    }
    RAtomStr => {
      use(r.sxV, at)
      // An atom decodes to a string, which a `string | null` also holds; only a `K | null`
      // carries the null its destination must hold.
      const s = repNodeAt(opRep(r.sxV))
      const d = repNodeAt(dst)
      const nulSrc = s is RNullable
        && s.rnDisc == 3
        && repNodeAt(s.rnInner) is RAtom
      const nulDst = d is RNullable && d.rnDisc == 1 && d.rnInner == vfStr
      if (
        !(s is RAtom || nulSrc)
        || !(dst == vfStr || nulDst)
        || nulSrc && !nulDst
      ) {
        return fail(2, at, "an atom decode is not of an atom into a string")
      }
      0
    }
    RNullOf => {
      const d = repNodeAt(dst)
      if r.nuOwn == NULL_OWN_BOX {
        if !(d is RBox) && !(d is RNullable && d.rnDisc == 4) {
          return fail(2, at, "a null box is not delivered into a union box")
        }
      } else if r.nuOwn == NULL_OWN_NONE && repPrim(dst) == "null" {
        // The `null` unit's one value is the bottom ref.
      } else if !(d is RNullable) || !nicheRetag(d.rnDisc, d.rnInner) {
        return fail(
          2,
          at,
          "a null is not delivered into a K | null or a nullable reference",
        )
      }
      0
    }
    RRetNull => {
      // The function's own null is its result, so it is delivered at the return rep, a nullable one.
      const d = repNodeAt(dst)
      if dst != vf.irRetRep || !(d is RNullable || d is RBox) {
        return fail(
          2,
          at,
          "a returned null is not at the function's nullable return rep",
        )
      }
      0
    }
    RNulTest => {
      use(r.ntV, at)
      const d = repNodeAt(opRep(r.ntV))
      // A union box (discipline 4 included) answers by its null tag.
      const box = d is RBox || d is RNullable && d.rnDisc == 4
      if !box && (!(d is RNullable) || !nicheRetag(d.rnDisc, d.rnInner)) {
        return fail(
          2,
          at,
          "a null test of neither a K | null, a nullable reference nor a box",
        )
      }
      0
    }
    RAtomEq => {
      // A static side's immediate is unread; any other static operand is evaluated and dropped.
      if !(r.aeStatic == 1 && r.aeL is OImm) { use(r.aeL, at) }
      if !(r.aeStatic == 2 && r.aeR is OImm) { use(r.aeR, at) }
      0
    }
    RUnionEq => {
      use(r.ueL, at)
      use(r.ueR, at)
      0
    }
    RListEq => {
      use(r.qeL, at)
      use(r.qeR, at)
      0
    }
    RToBox => {
      use(r.bxV, at)
      // Legacy's box writer may leave an immediate unread, so one stands only for an effect-free node.
      if (r.bxV is OImm || r.bxV is OStr) && !exprEffectFree(r.bxAt) {
        return fail(2, at, "a box's immediate stands for a node with an effect")
      }
      0
    }
    RNumWiden => {
      use(r.nwV, at)
      if (
        numKindOf(opRep(r.nwV)) != r.nwSrc
        || dst >= 0 && numKindOf(dst) != r.nwDst
      ) {
        return fail(2, at, "a widening's reps are not its kinds")
      }
      0
    }
    RListStage => {
      vfStaged = true
      if dst >= 0 { return fail(2, at, "a receiver stage is a statement") }
      if !(repNodeAt(opRep(r.rsgV)) is RList) {
        return fail(2, at, "a receiver stage of a non-list")
      }
      0
    }
    RListPush => {
      const rv = pushRecvOpnd(r, at)
      if vfRule != 0 { return 0 }
      use(rv, at)
      use(r.lpX, at)
      const ln = repNodeAt(opRep(rv))
      if !(ln is RList) {
        return fail(2, at, "a push of a non-element onto a non-list")
      }
      // A packed list's element is pushed as a plain i32, which its backing truncates.
      const want = if repPrim(ln.rlsElem) == "u8" { vfI32 } else { ln.rlsElem }
      if opRep(r.lpX) != want {
        return fail(2, at, "a push of a non-element onto a non-list")
      }
      if dst >= 0 && dst != vfI32 {
        return fail(2, at, "a push yields its i32 length")
      }
      0
    }
    RMapFilter => {
      use(r.hfV, at)
      if !(repNodeAt(opRep(r.hfV)) is RList) {
        return fail(2, at, "a map or filter of a non-list")
      }
      if !(r.hfC is OImm) { use(r.hfC, at) }
      0
    }
    RListSlice => {
      use(r.scV, at)
      uses(r.scArgs, at)
      if !(repNodeAt(opRep(r.scV)) is RList) {
        return fail(2, at, "a slice of a non-list")
      }
      for a in r.scArgs {
        if opRep(a) != vfI32 { return fail(2, at, "a slice bound is an i32") }
      }
      if dst >= 0 && dst != opRep(r.scV) {
        return fail(2, at, "a slice is a list of its receiver's rep")
      }
      0
    }
    RListClear => {
      use(r.lkV, at)
      if !(repNodeAt(opRep(r.lkV)) is RList) {
        return fail(2, at, "a clear of a non-list")
      }
      if dst >= 0 { return fail(2, at, "a clear is a statement") }
      0
    }
    RListPop => {
      use(r.lqV, at)
      if !(repNodeAt(opRep(r.lqV)) is RList) {
        return fail(2, at, "a pop of a non-list")
      }
      // A value pop leaves the element, its i32 niche, or its null box.
      const el = kidAt(opRep(r.lqV), 0)
      if dst >= 0 && dst != el && dst != vfI32 && repIsScalar(dst) {
        return fail(2, at, "a pop's value is its element, a niche or a box")
      }
      0
    }
    RListLen => {
      use(r.llV, at)
      if !(repNodeAt(opRep(r.llV)) is RList) && opRep(r.llV) != vfStr {
        return fail(2, at, "a length of a non-list, non-string")
      }
      if dst >= 0 && dst != vfI32 { return fail(2, at, "a length is an i32") }
      0
    }
    RMapOp => {
      uses(r.mpArgs, at)
      if r.mpOp == "size" {
        if r.mpArgs.length != 1 || !(repNodeAt(opRep(r.mpArgs[0])) is RMap) {
          return fail(2, at, "a map size of no map")
        }
        if dst >= 0 && dst != vfI32 {
          return fail(2, at, "a map size is an i32")
        }
      }
      0
    }
    RTagStash => {
      use(r.tgsV, at)
      if opRep(r.tgsV) != vfI32 {
        return fail(2, at, "a tag stash keeps an i32 set id")
      }
      0
    }
    RTagIs => if dst != vfBool { fail(2, at, "a tag test is a bool") } else { 0 }
    RCoalAtomStr => {
      use(r.zaL, at)
      use(r.zaD, at)
      const l = repNodeAt(opRep(r.zaL))
      if (
        !(l is RNullable)
        || l.rnDisc != 3
        || !(repNodeAt(l.rnInner) is RAtom)
      ) {
        return fail(2, at, "an atom coalesce of a non-`K | null`")
      }
      if !(r.zaD is OStr) || opRep(r.zaD) != vfStr || dst != vfStr {
        return fail(
          2,
          at,
          "an atom coalesce's default and result are not strings",
        )
      }
      0
    }
    RCoalStr => {
      use(r.czL, at)
      use(r.czD, at)
      const l = repNodeAt(opRep(r.czL))
      if (!(l is RNullable) || l.rnDisc != 1 || repPrim(l.rnInner) != "str") {
        return fail(2, at, "a string coalesce of a non-string | null")
      }
      if !(r.czD is OStr) {
        return fail(
          2,
          at,
          "a string coalesce's default is not a string literal",
        )
      }
      if dst >= 0 && dst != l.rnInner && dst != opRep(r.czL) {
        return fail(
          2,
          at,
          "a string coalesce yields a string or a string | null",
        )
      }
      0
    }
    RNumCast => {
      use(r.ncV, at)
      if !repIsScalar(opRep(r.ncV)) || dst >= 0 && !repIsScalar(dst) {
        return fail(2, at, "a numeric cast is between scalars")
      }
      0
    }
    RNumIntr => {
      uses(r.nxArgs, at)
      if dst >= 0 && !repIsScalar(dst) {
        return fail(2, at, "a numeric intrinsic's result is a scalar")
      }
      0
    }
    RPrint => {
      use(r.pnV, at)
      if dst >= 0 { return fail(2, at, "a print statement has no value") }
      0
    }
    RMapNew => {
      if dst >= 0 && !(repNodeAt(dst) is RMap) {
        return fail(2, at, "an empty map of a non-map rep")
      }
      0
    }
    RMapSet => {
      // A global receiver staged as a temp is read there, at the global's rep.
      if r.msSym >= 0 && r.msLoc is OVar {
        use(r.msLoc, at)
        if opRep(r.msLoc) != irGlobalRepOf(vf, r.msSym) {
          return fail(2, at, "a staged map receiver is not its global's rep")
        }
      }
      use(r.msKey, at)
      use(r.msVal, at)
      if !mapRecvOk(r.msSym, r.msLoc, at) {
        return fail(2, at, "a map set into a receiver that is no map")
      }
      if dst >= 0 { return fail(2, at, "a map set has no value") }
      0
    }
    RMapGet => {
      use(r.mtKey, at)
      if !mapRecvOk(r.mtSym, r.mtLoc, at) {
        return fail(2, at, "a map get of a receiver that is no map")
      }
      const m = repNodeAt(mapRecvRep(r.mtSym, r.mtLoc))
      if dst >= 0 && m is RMap && !mapGetDstOk(m.rmVal, dst) {
        return fail(
          2,
          at,
          "a map get yields its value, or that value's nullable",
        )
      }
      0
    }
    RMapHas => {
      use(r.mhKey, at)
      if !mapRecvOk(r.mhSym, r.mhLoc, at) {
        return fail(2, at, "a map has of a receiver that is no map")
      }
      if dst >= 0 && dst != vfBool && dst != vfI32 {
        return fail(2, at, "a map has is a boolean")
      }
      0
    }
    RMapGetOr => {
      use(r.mgKey, at)
      if r.mgForm > 0 { use(r.mgDef, at) }
      if !mapRecvOk(r.mgSym, r.mgLoc, at) {
        return fail(2, at, "a map read of a receiver that is no map")
      }
      if dst >= 0 && r.mgForm == 0 && dst != vfI32 {
        return fail(2, at, "a map read through a helper is an i32")
      }
      // The miss arm's default is the read's value, so it is at the read's rep.
      if dst >= 0 && r.mgForm > 0 && opRep(r.mgDef) != dst {
        return fail(2, at, "a map read's default is not at its rep")
      }
      0
    }
    RStrOp => {
      uses(r.soArgs, at)
      // A code point is an i32 and a code-point list a list of them; a slice's bounds and a
      // char-code index are i32s; every other operand is a string.
      // `__str_from_bytes__`'s source is a byte list, its start and count i32s.
      if r.soOp == "frombytes" {
        const sl = if r.soArgs.length == 3 { repNodeAt(opRep(r.soArgs[0])) } else { null }
        if !(sl is RList) || repPrim(sl.rlsElem) != "u8" {
          return fail(2, at, "a byte string's source is a list of u8s")
        }
        if opRep(r.soArgs[1]) != vfI32 || opRep(r.soArgs[2]) != vfI32 {
          return fail(2, at, "a byte string's start and count are i32s")
        }
        return 0
      }
      if r.soOp == "fromcps" {
        const ln = repNodeAt(opRep(r.soArgs[0]))
        if !(ln is RList) || ln.rlsElem != vfI32 {
          return fail(2, at, "a code-point list is a list of i32s")
        }
        return 0
      }
      let i = 0
      while i < r.soArgs.length {
        const idx = (r.soOp == "slice" || r.soOp == "charcode") && i > 0
        const want = if r.soOp == "fromcp" || idx { vfI32 } else { vfStr }
        if opRep(r.soArgs[i]) != want {
          return fail(2, at, "a string operator's operand rep")
        }
        i = i + 1
      }
      0
    }
    RMakeClo => {
      uses(r.mcEnv, at)
      if dst >= 0 && !(repNodeAt(dst) is RClosure) {
        return fail(2, at, "a closure of a non-closure rep")
      }
      0
    }
    RFnId => if dst >= 0 && dst != vfI32 { fail(2, at, "a function id is an i32") } else { 0 }
    RCellNew => use(r.cnInit, at)
    RCellGet => use(r.cgCell, at)
    REnvGet => 0
    REnvDrop => 0
    RBundlePick => {
      use(r.bpV, at)
      if dst >= 0 && !(repNodeAt(dst) is RClosure) {
        return fail(2, at, "a bundle member of a non-closure rep")
      }
      0
    }
    RGlobalGet => {
      const g = irGlobalRepOf(vf, r.ggSym)
      if g < 0 { return fail(2, at, "reads a global with no recorded rep") }
      if dst >= 0 && dst != g {
        return fail(2, at, "a global's rep is not its destination's")
      }
      0
    }
    RRawOp => rawRhs(r, dst, at)
    RRel => {
      if !vf.irHelper {
        return fail(10, at, "a raw op outside a runtime helper")
      }
      if dst >= 0 && dst != vfI32 {
        return fail(2, at, "a relocated constant is an i32")
      }
      0
    }
    RStage => {
      use(r.sgV, at)
      // A literal stages only at its own string rep; the box-view escape is for a variable.
      const view = !(r.sgV is OStr)
        && repNodeAt(dst) is RBox
        && repNodeAt(opRep(r.sgV)) is RBox
      if dst >= 0 && dst != opRep(r.sgV) && !view {
        return fail(2, at, "a staged operand is a value at its own rep")
      }
      0
    }
  }
  return 0
}

// Whether rep `r` is raw, at heap `heap` unless that is -1.
// A variable operand naming no variable, for a missing leading operand.
function i32Opnd(v: i32): Opnd { return { ov: v } }

// Whether rep `r` is a raw reference whose heap type no table tracks (heap -1).
function untracked(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RRaw && n.rwHeap == -1
}

function rawAt(r: i32, heap: i32): boolean {
  const n = repNodeAt(r)
  return n is RRaw && (heap < 0 || n.rwHeap == heap)
}

// Rule 10 for a raw value op into destination rep `dst`. A `struct.get` result and a `call`'s
// operands are not checked here: no table keeps a heap's layout or a helper's signature.
function rawRhs(r: RRawOp, dst: i32, at: i32) {
  if !vf.irHelper { return fail(10, at, "a raw op outside a runtime helper") }
  uses(r.rwArgs, at)
  const a = r.rwArgs
  const h = r.rwHeap
  const n = a.length
  const ref0 = n > 0 && rawAt(opRep(a[0]), h)
  const ok = match r.rwOp {
    "struct.get" | "array.len" | "ref.is_null" => n == 1 && ref0
    "ref.as_non_null" => n == 1 && ref0 && rawAt(dst, h)
    "array.get" => n == 2 && ref0 && opRep(a[1]) == vfI32
    "array.new_default" => n == 1 && opRep(a[0]) == vfI32 && rawAt(dst, h)
    "struct.new" => rawAt(dst, h)
    "ref.eq" => n == 2 && rawAt(opRep(a[0]), -1) && rawAt(opRep(a[1]), -1)
    "ref.cast" => n == 1 && rawAt(opRep(a[0]), -1) && rawAt(dst, h)
    "ref.null" => n == 0 && rawAt(dst, h)
    "call" => true
    "test" => n == 1 && opRep(a[0]) == vfI32 && dst == vfBool
    "load" => n == 1 && opRep(a[0]) == vfI32 && dst == vfI32
    "push" => n == 1 && !(a[0] is OStr) && dst == opRep(a[0])
    "ref.test" => n == 1 && rawAt(opRep(a[0]), -1) && dst == vfBool
    "select" => n == 3
      && opRep(a[2]) == vfBool
      && opRep(a[0]) == opRep(a[1])
      && dst == opRep(a[0])
    "tag64" => n == 1 && a[0] is OVar && repPrim(opRep(a[0])) == "i64" && dst == vfI32
    "tee" => n == 1
      && r.rwImm >= 0
      && r.rwImm < vf.irVars.length
      && vf.irVars[r.rwImm].vRep == opRep(a[0])
      && dst == opRep(a[0])
  }
  if !ok {
    return fail(10, at, r.rwOp + " is not over heap type " + i32ToStr(h))
  }
  return 0
}

// Rule 10 for a raw effect: `array.copy`'s source is at heap `srImm`.
function rawEff(e: SRawOp, at: i32) {
  // A list reserve's open and close are legacy's own calls, written in any body.
  if e.srOp == "reserve.open" || e.srOp == "reserve.close" {
    return if e.srArgs.length == 0 { 0 } else { fail(10, at, e.srOp + " takes no operand") }
  }
  // A binding sink's pair writes: a box in, the null in, or the box out to a box variable.
  if e.srOp == "sink.put" || e.srOp == "sink.null" || e.srOp == "sink.close" {
    uses(e.srArgs, at)
    const n0 = if e.srOp == "sink.put" { 1 } else { 0 }
    const v = e.srImm
    const varOk = e.srOp == "sink.null"
      || v >= 0
      && v < vf.irVars.length
      && sinkBoxRep(vf.irVars[v].vRep)
    if (
      e.srArgs.length != n0
      || !varOk
      || n0 == 1 && !sinkBoxRep(opRep(e.srArgs[0]))
    ) {
      return fail(10, at, e.srOp + " is not a union box into the sink pair")
    }
    return 0
  }
  if !vf.irHelper { return fail(10, at, "a raw op outside a runtime helper") }
  // Every outstanding push is this effect's leading operands, in push order.
  let k = 0
  while k < vfPushed.length {
    const p = if k < e.srArgs.length { e.srArgs[k] } else { i32Opnd(-1) }
    if !(p is OVar) || p.ov != vfPushed[k] {
      return fail(
        10,
        at,
        "a push is not its store's leading operand, in push order",
      )
    }
    vfPushes[p.ov] = false
    k = k + 1
  }
  vfPushed = []
  uses(e.srArgs, at)
  const a = e.srArgs
  const n = a.length
  const ref0 = n > 0 && rawAt(opRep(a[0]), e.srHeap)
  const ok = match e.srOp {
    "struct.set" => n == 2 && ref0
    "array.set" => n == 3 && ref0 && opRep(a[1]) == vfI32
    "array.copy" => n == 5 && ref0 && rawAt(opRep(a[2]), e.srImm)
    "array.init_data" | "array.fill" => n == 4 && ref0
    "call" => true
    "reserve.open" | "reserve.close" | "sink.put" | "sink.null" | "sink.close" => false
  }
  if !ok {
    return fail(10, at, e.srOp + " is not over heap type " + i32ToStr(e.srHeap))
  }
  return 0
}

// Whether rep `r` is a union box, or a nullable one held as the same `{tag, payload}`.
function sinkBoxRep(r: i32): boolean {
  const d = repNodeAt(r)
  return d is RBox || d is RNullable && d.rnDisc == 4
}

// Whether node `id` leaves its body: a branch, a return or a trap.
function exits(id: i32): boolean {
  if id < 0 || id >= vf.irNodes.length { return false }
  const n = vf.irNodes[id]
  return n is SBr || n is SReturn || n is STrap
}

// Rule 5's fall-through: a body with out-variable `out` ends by writing it, or by leaving.
function endsWriting(body: i32[], out: i32, at: i32) {
  if out < 0 { return 0 }
  if body.length == 0 {
    return fail(5, at, "an arm leaves v" + i32ToStr(out) + " unwritten")
  }
  const last = body[body.length - 1]
  if exits(last) { return 0 }
  const n = vf.irNodes[last]
  if n is SAssign && n.asDst == out { return 0 }
  fail(5, at, "an arm leaves v" + i32ToStr(out) + " unwritten")
}

// Walks a nested body: the temps it defines are out of scope after it.
// Why a boxed operand's `??` is ill-formed, or "": it reads a union box, or a nullable boxed as a
// union is (discipline 4).
function coalBoxWhy(n: SCoalBox): string {
  const lr = repNodeAt(opRep(n.cbL))
  if lr is RBox || lr is RNullable && lr.rnDisc == 4 { return "" }
  return "a boxed `??` reads no box"
}

// Why a nullable reference's `??` is ill-formed, or "": it reads a nullable reference, and its out
// is that reference, its non-null inner, or a join's box.
function coalNulRefWhy(n: SCoalBox): string {
  const lr = repNodeAt(opRep(n.cbL))
  if !(lr is RNullable) || lr.rnDisc == 4 || lr.rnInner < 0 {
    return "a nullable-reference `??` reads no nullable reference"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "a nullable-reference `??` writes no variable"
  }
  const or = vf.irVars[o].vRep
  const on = repNodeAt(or)
  const boxed = on is RBox || on is RNullable && on.rnDisc == 4
  if !boxed && or != opRep(n.cbL) && or != lr.rnInner {
    return "a nullable-reference `??` yields neither the reference, its inner, nor a box"
  }
  return ""
}

// Why a fused `pop ?? d` is ill-formed, or "": it pops a list of a scalar or atom element, and its
// out is at that element's rep.
function coalPopOrWhy(n: SCoalBox): string {
  const lr = repNodeAt(opRep(n.cbL))
  if !(lr is RList) { return "a `pop ?? d` pops no list" }
  const p = repPrim(lr.rlsElem)
  // A literal-union list holds its atoms' i32 ids, and legacy pops it as a scalar list.
  const scalar = p != null
    && (p == "i32"
    || p == "i64"
    || p == "f64"
    || p == "f32"
    || p == "bool")
    || repNodeAt(lr.rlsElem) is RAtom
  if !scalar { return "a `pop ?? d` pops a list of no scalar element" }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length || vf.irVars[o].vRep != lr.rlsElem {
    return "a `pop ?? d` yields no element"
  }
  return ""
}

// Why a fused map read whose default computes is ill-formed, or "": it probes a map receiver by a
// key along an inline form, `i32` (1) or mv (2), into an out of the read's own rep.
function coalMapGetOrWhy(n: SCoalBox, id: i32): string {
  const mp = n.cbMap
  if mp == null { return "a fused map read holds no probe" }
  use(mp.prKey, id)
  if !mapRecvOk(mp.prSym, n.cbL, id) {
    return "a map read of a receiver that is no map"
  }
  if mp.prForm != 1 && mp.prForm != 2 {
    return "a fused map read writes its default in no miss arm"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "a fused map read writes no variable"
  }
  const p = repPrim(vf.irVars[o].vRep)
  if mp.prForm == 1 && p != "i32" && p != "bool" {
    return "a map read's plain probe yields no i32"
  }
  // The mv slot's read is the map's value as itself, so its out is at that value's rep.
  const mr = repNodeAt(
    if mp.prSym >= 0 { irGlobalRepOf(vf, mp.prSym) } else { opRep(n.cbL) },
  )
  if mp.prForm == 2 && (!(mr is RMap) || mr.rmVal != vf.irVars[o].vRep) {
    return "a map read's mv slot yields no value of its map"
  }
  return ""
}

function nested(body: i32[]) {
  const nDefs = vfDefLog.length
  let prev = -1
  for id in body {
    stmt(id, prev)
    prev = id
  }
  while vfDefLog.length > nDefs {
    const d = vfDefLog.pop() ?? -1
    if d >= 0 && d < vfDefined.length { vfDefined[d] = false }
  }
  return 0
}

// An `if` and every `if` its `else` bodies hold, checked along the spine with one frame per open
// `else` rather than by recursing (D1990): a link's test and `then`, its `else` in order, then its
// arms' writes, as `nested` would order them.
function ifSpine(id0: i32) {
  const links: i32[] = []
  const pos: i32[] = []
  const defs: i32[] = []
  let next = id0
  while true {
    if next >= 0 {
      const h = vf.irNodes[next]
      if h is SIf {
        use(h.siCond, next)
        if opRep(h.siCond) != vfBool {
          fail(2, next, "an `if` tests a bool")
        } else {
          nested(h.siThen)
          links.push(next)
          pos.push(0)
          defs.push(vfDefLog.length)
        }
      }
    }
    next = -1
    if links.length == 0 { return 0 }
    const top = links.length - 1
    const ln = vf.irNodes[links[top]]
    if !(ln is SIf) {
      return fail(5, links[top], "a spine link is not an `if`")
    }
    if pos[top] < ln.siElse.length {
      const c = ln.siElse[pos[top]]
      pos[top] = pos[top] + 1
      if (
        vfRule == 0
        && c >= 0
        && c < vf.irNodes.length
        && vf.irNodes[c] is SIf
      ) {
        nodeRepClosed(c)
        next = c
      } else {
        stmt(c, if pos[top] > 1 { ln.siElse[pos[top] - 2] } else { -1 })
      }
    } else {
      while vfDefLog.length > defs[top] {
        const d = vfDefLog.pop() ?? -1
        if d >= 0 && d < vfDefined.length { vfDefined[d] = false }
      }
      endsWriting(ln.siThen, ln.siOut, links[top])
      endsWriting(ln.siElse, ln.siOut, links[top])
      links.pop()
      pos.pop()
      defs.pop()
    }
  }
}

function labelled(label: i32, out: i32, body: i32[]) {
  vfLabels.push(label)
  vfLabelOut.push(out)
  nested(body)
  vfLabels.pop()
  vfLabelOut.pop()
  return 0
}

// Checks node `id`, the node before it in its body `prev` (-1 for the first).
function stmt(id: i32, prev: i32) {
  if vfRule != 0 { return 0 }
  if id < 0 || id >= vf.irNodes.length {
    return fail(5, id, "a body names no node")
  }
  nodeRepClosed(id)
  const n = vf.irNodes[id]
  match n {
    SLet => {
      const d = n.lDst
      if d < 0 || d >= vf.irVars.length {
        return fail(4, id, "defines no variable")
      }
      rhsCheck(n.lRhs, vf.irVars[d].vRep, id)
      const r = n.lRhs
      if r is RRawOp && r.rwOp == "push" {
        vfPushed.push(d)
        vfPushes[d] = true
      }
      if vf.irVars[d].vKind == "temp" {
        if vfDefined[d] {
          return fail(4, id, "defines temp v" + i32ToStr(d) + " twice")
        }
        vfDefined[d] = true
        vfDefLog.push(d)
      }
      if vf.irNodeRep[id] != vf.irVars[d].vRep {
        return fail(2, id, "the node's rep is not its destination's")
      }
      0
    }
    SAssign => {
      use(n.asSrc, id)
      if n.asDst < 0 || n.asDst >= vf.irVars.length {
        return fail(4, id, "assigns no variable")
      }
      if vf.irVars[n.asDst].vKind == "temp" {
        return fail(4, id, "assigns temp v" + i32ToStr(n.asDst))
      }
      if opRep(n.asSrc) != vf.irVars[n.asDst].vRep {
        return fail(2, id, "an assignment needs a coercion")
      }
      0
    }
    SSetField => {
      use(n.sfV, id)
      use(n.sfSrc, id)
      const r = opRep(n.sfV)
      if !(repNodeAt(r) is RRecord) || kidAt(r, n.sfIx) != opRep(n.sfSrc) {
        return fail(2, id, "a field write's rep is not the field's")
      }
      0
    }
    SListSet => {
      use(n.lsV, id)
      use(n.lsIx, id)
      use(n.lsSrc, id)
      const l = opRep(n.lsV)
      // A packed list's element is stored as a plain i32, which its backing truncates.
      const ln = repNodeAt(l)
      const want = if ln is RList && repPrim(ln.rlsElem) == "u8" { vfI32 } else { kidAt(l, 0) }
      if (!(ln is RList) || opRep(n.lsIx) != vfI32 || want != opRep(n.lsSrc)) {
        return fail(2, id, "an element write's reps do not match the list")
      }
      0
    }
    SCellSet => {
      use(n.csCell, id)
      use(n.csSrc, id)
    }
    SGlobalSet => {
      use(n.gsSrc, id)
      const g = irGlobalRepOf(vf, n.gsSym)
      if g < 0 { return fail(2, id, "writes a global with no recorded rep") }
      if opRep(n.gsSrc) != g {
        return fail(2, id, "a global store needs a coercion")
      }
      0
    }
    SBoundsCheck => {
      use(n.bcV, id)
      use(n.bcIx, id)
      0
    }
    SEffect => rhsCheck(n.efRhs, -1, id)
    SBlock => {
      if n.bkOut >= 0 && !vf.irHelper {
        return fail(10, id, "a valued block outside a runtime helper")
      }
      labelled(n.bkLabel, n.bkOut, n.bkBody)
      endsWriting(n.bkBody, n.bkOut, id)
    }
    SLoop => labelled(n.lpLabel, -1, n.lpBody)
    SForIn => {
      // A map walk's list is an unread immediate when its map is a global the lowering reads,
      // else its receiver at a map rep.
      if n.xfMap < 0 { use(n.xfList, id) }
      const ln = repNodeAt(opRep(n.xfList))
      const recvMap = n.xfMap < 0 && mapRepOrNullable(opRep(n.xfList))
      // A list walks its elements, a string its code points, each an i32.
      let er = -1
      if ln is RList { er = ln.rlsElem }
      if opRep(n.xfList) == vfStr { er = vfI32 }
      // A map walks its keys or values, each an i32 or a string.
      if (
        (n.xfMap >= 0 || recvMap)
        && n.xfVar >= 0
        && n.xfVar < vf.irVars.length
      ) {
        const vr = vf.irVars[n.xfVar].vRep
        if vr == vfI32 || vr == vfStr { er = vr }
      }
      if n.xfVar < 0 || n.xfVar >= vf.irVars.length || er < 0 {
        return fail(
          2,
          id,
          "a walk is not of a list or a string into a variable",
        )
      }
      if vf.irVars[n.xfVar].vKind != "local" || vf.irVars[n.xfVar].vRep != er {
        return fail(
          2,
          id,
          "a walk's variable is not a local of its element rep",
        )
      }
      vfLabels.push(n.xfBrk)
      vfLabelOut.push(-1)
      labelled(n.xfCont, -1, n.xfBody)
      vfLabels.pop()
      vfLabelOut.pop()
    }
    SIf => ifSpine(id)
    SCoalBox => {
      // A fused map read's receiver is read by its probe, which may name a global instead.
      const mapArm = n.cbArm == "mapIndexGetOr"
      if (n.cbMap != null) != mapArm {
        return fail(2, id, "a `??` holds a map probe off the map-read arm")
      }
      if !mapArm { use(n.cbL, id) }
      if n.cbOut < 0 || n.cbOut >= vf.irVars.length {
        return fail(4, id, "a boxed `??` writes no variable")
      }
      const why = match n.cbArm {
        "popOr" => coalPopOrWhy(n)
        "mapIndexGetOr" => coalMapGetOrWhy(n, id)
        "nulRef" => coalNulRefWhy(n)
        "boolPop" | "valBox" | "valScalar" | "valNoKind" | "elem" | "callBox" | "callScalar" | "callNoKind" | "next" => coalBoxWhy(n)
      }
      if why != "" { return fail(2, id, why) }
      nested(n.cbNull)
      endsWriting(n.cbNull, n.cbOut, id)
    }
    SSwitch => switchCheck(n, id)
    SBr => {
      if n.brHas && !vf.irHelper {
        return fail(10, id, "a valued branch outside a runtime helper")
      }
      let i = vfLabels.length - 1
      while i >= 0 {
        if vfLabels[i] == n.brLabel {
          const out = vfLabelOut[i]
          if out < 0 && n.brHas {
            return fail(
              5,
              id,
              "a branch carries a value its label has no place for",
            )
          }
          if out >= 0 {
            if !n.brHas {
              return fail(5, id, "a branch to a valued label carries none")
            }
            use(n.brVal, id)
            if opRep(n.brVal) != varRep(out) {
              return fail(5, id, "a branch's value is not its label's rep")
            }
          }
          return 0
        }
        i = i - 1
      }
      fail(
        5,
        id,
        "a branch to L" + i32ToStr(n.brLabel) + ", which does not enclose it",
      )
    }
    SReturn => {
      const none = repIsNoValue(vf.irRetRep)
      // A return right after a trap is dead, so it carries no value whatever the result.
      const dead = !n.rtHas && prev >= 0 && vf.irNodes[prev] is STrap
      if n.rtHas == none && !dead {
        return fail(
          5,
          id,
          "a return's value does not match the function's result",
        )
      }
      if n.rtHas {
        use(n.rtV, id)
        if opRep(n.rtV) != vf.irRetRep {
          return fail(2, id, "a return's rep is not the result's")
        }
      }
      0
    }
    STrap => 0
    SDrop => use(n.dpV, id)
    SRawOp => rawEff(n, id)
  }
  return 0
}

// Rule 7: each arm of the scrutinee's box is covered once, or a default names what it excludes.
function switchCheck(n: SSwitch, id: i32) {
  const on = varRep(n.swOn)
  if !(repNodeAt(on) is RBox) { return fail(7, id, "a switch over a non-box") }
  const nArms = repNodeKids(on).length
  const seen: boolean[] = []
  let i = 0
  while i < nArms {
    seen.push(false)
    i = i + 1
  }
  let dflt = false
  for a in n.swArms {
    if a.swArm < 0 {
      if a.swWhy == "" {
        return fail(7, id, "a default arm names nothing it excludes")
      }
      if dflt { return fail(7, id, "a second default arm") }
      dflt = true
    } else if a.swArm >= nArms || seen[a.swArm] {
      return fail(
        7,
        id,
        "arm " + i32ToStr(a.swArm) + " is out of range or repeated",
      )
    } else {
      seen[a.swArm] = true
    }
    nested(a.swBody)
    endsWriting(a.swBody, n.swOut, id)
  }
  if dflt { return 0 }
  for s in seen {
    if !s { return fail(7, id, "an arm of the scrutinee is not covered") }
  }
  return 0
}

// Rule 1: whether `r` is a node of the tree and not an unsupported one.
function closedRep(r: i32): boolean {
  const n = repNodeAt(r)
  if n == null { return false }
  return !(n is RUnsup)
}

// Rule 1 for a node: its rep is a closed one in the tree.
function nodeRepClosed(id: i32) {
  const r = vf.irNodeRep[id]
  if !closedRep(r) {
    return fail(1, id, "the node's rep is " + repWhat(r) + ", not a closed rep")
  }
  return 0
}

// The uninstalled bounds rule: no list access may pass unchecked, so any one fails.
function boundsNone(f: IrFn): string {
  for n in f.irNodes {
    if touchesList(n) { return "bounds rule not installed" }
  }
  return ""
}

// Whether node `n` reads or writes a list element, or checks a bound.
function touchesList(n: IrNode): boolean {
  return match n {
    SListSet | SBoundsCheck => true
    SLet => rhsReadsList(n.lRhs)
    SEffect => rhsReadsList(n.efRhs)
    SAssign | SSetField | SCellSet | SGlobalSet | SBlock | SLoop | SForIn | SIf | SSwitch | SCoalBox | SBr | SReturn | STrap | SDrop | SRawOp => false
  }
}

function rhsReadsList(r: Rhs): boolean {
  return match r {
    RListGet => true
    RPrimOp | RCall | RCallRef | RCallHost | RTest | RBoxField | RSharedRead | RBoxNarrow | RRecover | RCast | RTagOf | RMakeRec | RGetField | RMakeList | RSpread | RListNew | RListCopy | RListLen | RListPush | RListStage | RListPop | RListClear | RMapFilter | RListSlice | RMapOp | RMapNew | RMapSet | RMapGetOr | RMapGet | RMapHas | RPrint | RNumIntr | RCoalStr | RCoalAtomStr | RTagStash | RTagIs | RStrOp | RNumWiden | RNumCast | RToBox | RRetag | RAtomStr | RNullOf | RRetNull | RNulTest | RAtomEq | RUnionEq | RListEq | RMakeClo | RFnId | RCellNew | RCellGet | RGlobalGet | REnvGet | REnvDrop | RBundlePick | RRawOp | RRel | RStage => false
  }
}

// The push a statement or temp `id` of `f` is, or null.
function pushAt(f: IrFn, id: i32): RListPush | null {
  if id < 0 || id >= f.irNodes.length { return null }
  const n = f.irNodes[id]
  const r = if n is SEffect { n.efRhs } else if n is SLet { n.lRhs } else { null }
  if r is RListPush { return r }
  return null
}

// The stage rule over `f`: "" when each receiver stage is named by exactly one push of its call,
// later in the stage's own body, else what broke.
function stagePairsWhy(f: IrFn): string {
  const bodies: i32[][] = [f.irBody]
  const pos: i32[] = [0]
  const open: i32[][] = [[]]
  while bodies.length > 0 {
    const top = bodies.length - 1
    const body = bodies[top]
    const i = pos[top]
    if i >= body.length {
      if open[top].length > 0 {
        return "node "
          + i32ToStr(open[top][0])
          + ": a receiver stage no push names"
      }
      bodies.pop()
      pos.pop()
      open.pop()
      continue
    }
    pos[top] = i + 1
    const id = body[i]
    if stageAt(id) != null { open[top].push(id) }
    const p = pushAt(f, id)
    if p != null {
      const v = p.lpV
      if v is PStaged {
        const rest: i32[] = []
        for o in open[top] {
          if o != v.pstNode { rest.push(o) }
        }
        if rest.length == open[top].length {
          return "node "
            + i32ToStr(id)
            + ": a staged push whose stage is not open before it in its body"
        }
        open[top] = rest
      }
    }
    irPushBodies(f, id, bodies, pos)
    while open.length < bodies.length { open.push([]) }
  }
  return ""
}

// The bounds rule, installed with the list builder; it answers "" or what broke, naming the node.
// Whether a map get of value rep `val` may deliver into `dst`: the value itself, or it nullable.
function mapGetDstOk(val: i32, dst: i32): boolean {
  if dst == val { return true }
  const n = repNodeAt(dst)
  return n is RNullable && n.rnInner == val
}

export let irBoundsRuleHook: (f: IrFn) => string = boundsNone

// Whether type `ty` is no closed type a variable can have (rule 1): absent, or open in a type
// parameter. The builder asks it first, so such a function is uncovered rather than refused.
export function irTyOpen(ty: i32): boolean { return ty < 0 || tyHasTyVar(ty) }

// Whether a variable of type `ty` at rep `rep` is open (rule 1): a type whose every open part is
// a tagged set's function, held at the set's `i32` id, is not (`tyOpenHeldAsIds`).
export function irTyHeldOpen(ty: i32, rep: i32): boolean {
  return irTyOpen(ty) && !tyOpenHeldAsIds(ty, rep, [])
}

// Verifies `f`: rule 0 when it holds, else the first rule broken, its node and why.
export function irVerify(f: IrFn): IrVerdict {
  vf = f
  vfRule = 0
  vfAt = -1
  vfMsg = ""
  vfLabels = []
  vfLabelOut = []
  vfBool = repNodeOfTy(TY_BOOL)
  vfI32 = repNodeOfTy(TY_I32)
  vfStr = repNodeOfTy(TY_STR)
  vfDefined = []
  vfDefLog = []
  vfPushed = []
  vfPushes = Map()
  vfStaged = false
  let i = 0
  while i < f.irVars.length {
    const v = f.irVars[i]
    vfDefined.push(false)
    if rawAt(v.vRep, -1) || v.vTy < 0 {
      // A raw variable has no VL type, and only a helper holds one. One whose heap is not
      // tracked is a temp, on the stack between its read and its one use.
      if !f.irHelper || v.vTy >= 0 || !rawAt(v.vRep, -1) {
        fail(
          10,
          -1,
          "v" + i32ToStr(i) + " is raw outside a runtime helper, or typed",
        )
      } else if untracked(v.vRep) && v.vKind != "temp" {
        fail(
          10,
          -1,
          "v" + i32ToStr(i) + " holds an untracked raw value outside a temp",
        )
      }
    } else if !closedRep(v.vRep) {
      fail(
        1,
        -1,
        "v" + i32ToStr(i) + "'s rep is " + repWhat(v.vRep) + ", not a closed rep",
      )
    } else if irTyHeldOpen(v.vTy, v.vRep) {
      fail(1, -1, "v" + i32ToStr(i) + "'s type is open")
    } else if repNodeOfTy(v.vTy) != v.vRep {
      fail(3, -1, "v" + i32ToStr(i) + "'s rep is not its type's")
    }
    i = i + 1
  }
  if !closedRep(f.irRetRep) {
    fail(
      1,
      -1,
      "the result's rep is " + repWhat(f.irRetRep) + ", not a closed rep",
    )
  }
  let prev = -1
  for id in f.irBody {
    stmt(id, prev)
    prev = id
  }
  // Rule 8, the bounds checks, is the list builder's (`ir_verify_bounds.vl`).
  if vfRule == 0 {
    const b = irBoundsRuleHook(f)
    if b != "" { fail(8, -1, b) }
  }
  if vfRule == 0 && vfStaged {
    const sp = stagePairsWhy(f)
    if sp != "" { fail(10, -1, sp) }
  }
  if vfRule == 0 && vfPushed.length > 0 {
    fail(10, -1, "a push no store consumes")
  }
  // Rule 5 at the end: a function with a result leaves its body on every path, or falls into
  // the `null` or `unreachable` the lowering pads its end with, as legacy does.
  if (
    !repIsNoValue(f.irRetRep)
    && !irBodyLeaves(f, f.irBody)
    && fnFallThroughPadOf(f.irAt) == ""
  ) {
    fail(5, -1, "a valued function falls off its end")
  }
  const v: IrVerdict = { vfRule: vfRule, vfNode: vfAt, vfMsg: vfMsg }
  return v
}

// Whether a nullable of discipline `disc` over rep `inner` is a niche that holds its inner value
// unchanged: a `K | null` atom (3), a `boolean | null` (2, its null the sentinel 2), or a nullable
// ref (1) over a string, record, list, map or closure.
function nicheRetag(disc: i32, inner: i32): boolean {
  if disc == 3 { return true }
  if disc == 2 { return repPrim(inner) == "bool" }
  if disc != 1 { return false }
  const p = repPrim(inner)
  if p != null { return p == "str" }
  const n = repNodeAt(inner)
  return n is RRecord || n is RList || n is RMap || n is RClosure
}

// Whether rep `r` is a map, or a nullable one whose receiver a map walk recovers.
function mapRepOrNullable(r: i32): boolean {
  const n = repNodeAt(r)
  if n is RMap { return true }
  return n is RNullable && repNodeAt(n.rnInner) is RMap
}
