import { i32ListHas } from "./listutil"
// The IR verifier (ir-design-2026-11.md §2): one linear walk over an `IrFn` that checks rules
// 1-7: closed reps, rep agreement, types against reps, definitions before uses, control, calls
// and switch coverage. Rule 10 keeps raw reps and ops (`RRaw`, `RRawOp`, `SRawOp`) and valued
// blocks and branches inside a runtime helper, each reference operand at its op's heap type, and
// each `push` the leading operand of the next raw effect, in push order. It
// answers the first rule a function breaks, with the node; it never reports through the
// emitter's failure channel. Bounds (rule 8) arrive with the list nodes'
// builder, and trap order (rule 9) with the first pass that moves a check. Until steps I2-I7
// build them, the arms for records, lists, casts, tags, maps and closures have no input.
import {
  IrFn,
  IrNode,
  OImm,
  OStr,
  OVar,
  Opnd,
  PStaged,
  RAfterEffects,
  RArmUnbox,
  RAsTail,
  RAsUnion,
  RAsgParked,
  RAsgUnwiden,
  RAtomEq,
  RAtomSole,
  RAtomStr,
  RAtomWide,
  RAtomic,
  RBoxField,
  RBoxNarrow,
  RBundlePick,
  RCall,
  RCallHost,
  RCallRef,
  RCallRefHead,
  RCast,
  RCellGet,
  RCellNew,
  RClosureEq,
  RCoalAtomStr,
  RCoalStr,
  RCoerce,
  RDeadNever,
  RDeadNullTest,
  REnvDrop,
  REnvGet,
  REqHelp,
  RFieldNull,
  RFnId,
  RGetField,
  RGlobalGet,
  RHandPick,
  RHolderPick,
  RHoleOptBox,
  RIdentityEq,
  RInitProgress,
  RIsStaged,
  RJoinNull,
  RListCat,
  RListClear,
  RListCopy,
  RListEmpty,
  RListEmptyArms,
  RListEq,
  RListFitIs,
  RListGet,
  RListIsAcross,
  RListLen,
  RListNew,
  RListNewDefault,
  RListPop,
  RListPush,
  RListPushMany,
  RListSlice,
  RListStage,
  RLitArms,
  RMaFoldInit,
  RMakeClo,
  RMakeList,
  RMakeRec,
  RMapClear,
  RMapDelete,
  RMapEq,
  RMapFilter,
  RMapGet,
  RMapGetOr,
  RMapHas,
  RMapIter,
  RMapNew,
  RMapOp,
  RMapSet,
  RMemAccess,
  RMemOp,
  RNicheRead,
  RNulNicheEq,
  RNulNoneBox,
  RNulTest,
  RNullOf,
  RNumCast,
  RNumIntr,
  RNumIs,
  RNumUnionBin,
  RNumUnionConvert,
  RNumWiden,
  ROptRead,
  RPrimOp,
  RPrint,
  RPrintOpen,
  RRawOp,
  RRecCopyPure,
  RRecDown,
  RRecordFitIs,
  RRecover,
  RRel,
  RResultPick,
  RRetNull,
  RRetag,
  RSharedFieldSet,
  RSharedRead,
  RSimd,
  RSpread,
  RStage,
  RStashSet,
  RStrOp,
  RStrToAtom,
  RStrToAtomStaged,
  RStructEq,
  RTagIs,
  RTagOf,
  RTagStash,
  RTest,
  RToBox,
  RTruncSat,
  RUnionConcreteEq,
  RUnionEq,
  RUnionNumCrossEq,
  RUnionStage,
  RUnionStagedEq,
  RUnionVariantEq,
  RVariantChain,
  RVariantDiscrim,
  Rhs,
  SArmSite,
  SArmWrite,
  SAssign,
  SBlock,
  SBoundsCheck,
  SBr,
  SCellSet,
  SCoalBox,
  SDrop,
  SEffect,
  SForIn,
  SGlobalSet,
  SIf,
  SIntSwitch,
  SLet,
  SListSet,
  SLoop,
  SRangeLoop,
  SRawOp,
  SReturn,
  SSetField,
  SSwitch,
  STrap,
  irBodyLeaves,
  irCloFieldRetagAt,
  irFactIntOf,
  irFactKidTyOf,
  irFactTyOf,
  irFnNew,
  irGlobalRepOf,
  irGlobalStoreTyOf,
  irPushBodies,
  irSigOf,
  mapBoxReadsAt,
  mapKeyRep,
  mapNicheReadsAt,
  mapWalkValRep,
  repHeldAsI32,
  repNullRefFits,
} from "./ir"
import {
  RAtom,
  RBox,
  RClosure,
  RList,
  RMap,
  RNullable,
  RPrim,
  RRaw,
  RRecord,
  RUnsup,
  repNodeAt,
  repNodeKids,
  repNodeOfTy,
  repTyIsLoneStrLit,
  repTyOf,
} from "./emit_rep"
import {
  boxListRetag,
  boxMapRetag,
  cloHoleRetag,
  irNodeEndsPath,
  listRetag,
  listRetagHole,
  recFieldsWiden,
  recRetag,
  recSubRetag,
  recValRetag,
  repBoolNiche,
  repBoxCore,
  repIsNoValue,
  repIsScalar,
  repPrim,
  repSubWord,
  repWhat,
  repsLowerAlike,
} from "./ir"
import { tyHasTyVar } from "./tyquery"
import { NICHE_NUL_LIT, NICHE_NUL_MAP } from "./emit_start_block"
import { TY_BOOL, TY_I32, TY_STR, tyScalarBasePrim } from "./check_types"
import { AsExpr, Call, P, i32ToStr, nodeAt } from "./ast"

// A verdict: rule 0 with node -1 when `f` holds, else the first rule broken, at node `vfNode`
// (-1 for a variable or the header), with the reason.
export type IrVerdict = { vfRule: i32, vfNode: i32, vfMsg: string }

let vf = irFnNew(-1, "")
let vfRule = 0
let vfAt = -1
let vfMsg = ""
let vfDefined: boolean[] = []
// The temps defined in the open bodies, in order, so a body's exit undoes its own.
let vfDefLog: i32[] = []
// The `push` temps not yet consumed, in push order, and which temps are such pushes.
let vfPushed: i32[] = []
let vfPushes: {[i32]: boolean} = Map()
// The `RCallRefHead` temps, which only their `RCallRef` reads, and those it has read.
let vfHeads: {[i32]: boolean} = Map()
let vfHeadsRead: {[i32]: boolean} = Map()
// The `RStashSet`s not yet read by their record: its literal, the kid set, the value's rep.
let vfSetAt: i32[] = []
let vfSetK: i32[] = []
let vfSetRep: i32[] = []
// Whether the walk met a receiver stage, so the stage rule has a pairing to check.
let vfStaged = false
let vfLabels: i32[] = []
let vfLabelOut: i32[] = []
let vfBool = -1
let vfI32 = -1
let vfStr = -1

function fail(rule: i32, at: i32, msg: string) {
  if vfRule == 0 {
    vfRule = rule
    vfAt = at
    vfMsg = msg
  }
  return 0
}

function varRep(v: i32): i32 {
  if v < 0 || v >= vf.irVars.length { return -1 }
  return vf.irVars[v].vRep
}

// Number kind of rep `r` as `widenPlanOf` names it (1 i32, 3 i64, 4 f64, 5 f32), or -1.
export function numKindOf(r: i32): i32 {
  const p = repPrim(r)
  if p == null { return -1 }
  return match p {
    "i32" => 1
    "i64" => 3
    "f64" => 4
    "f32" => 5
    "bool" | "str" | "u8" | "null" | "v128" => -1
  }
}

// Whether opcode `op` narrows a value of rep `src` to rep `dst`: `i32.wrap_i64`, `i32.trunc_f64_s`
// or `i32.trunc_f32_s` into an i32, `f32.demote_f64` into an f32, or `ref.as_non_null` of a
// nullable reference into that reference.
function unwidenAgrees(op: i32, src: i32, dst: i32): boolean {
  const s = numKindOf(src)
  const d = numKindOf(dst)
  if op == 167 { return s == 3 && d == 1 }
  if op == 170 { return s == 4 && d == 1 }
  if op == 168 { return s == 5 && d == 1 }
  if op == 182 { return s == 4 && d == 5 }
  if op == 212 {
    const sn = repNodeAt(src)
    return sn is RNullable && sn.rnInner == dst
  }
  return false
}

function opRep(o: Opnd): i32 {
  return match o {
    OVar => varRep(o.ov)
    OImm => o.oiRep
    OStr => o.osRep
  }
}

// A record compare side's value rep: operand `o`'s, or, with an index (`ix`), its list's element's.
function eqSideRep(o: Opnd, ix: Opnd[]): i32 {
  const r = opRep(o)
  if ix.length == 0 { return r }
  const n = repNodeAt(r)
  return if n is RList { n.rlsElem } else { r }
}

// Whether a reference niche read of kind `k` lands at `A | null` of its own shape: the map niche
// at a nullable map, a closure's box tag (11) at a nullable closure, a list's at a nullable list.
function nicheRefFits(k: i32, dst: i32): boolean {
  const dn = repNodeAt(dst)
  if !(dn is RNullable) { return false }
  // A literal union's niche is its atom id, `-1` for null.
  if k == NICHE_NUL_LIT { return dn.rnDisc == 3 }
  const inner = repNodeAt(dn.rnInner)
  if k == NICHE_NUL_MAP { return inner is RMap }
  if k == 11 { return inner is RClosure }
  return inner is RList
}

// A map operation's receiver: global `sym` of a map rep, or, where `sym` is -1, a variable `loc`
// of one, read as a use.
// The rep of a map receiver: global `sym`'s noted rep, or operand `loc`'s.
function mapRecvRep(sym: i32, loc: Opnd): i32 {
  return if sym >= 0 { irGlobalRepOf(vf, sym) } else { opRep(loc) }
}

function mapRecvOk(sym: i32, loc: Opnd, at: i32): boolean {
  if sym >= 0 { return repNodeAt(irGlobalRepOf(vf, sym)) is RMap }
  if !(loc is OVar) || loc.ov < 0 || loc.ov >= vf.irVars.length { return false }
  use(loc, at)
  return repNodeAt(opRep(loc)) is RMap
}

// A `crHead` call's callee: an `RCallRefHead` temp no call has read yet, released for this read.
function headRead(o: Opnd, at: i32): boolean {
  if !(o is OVar) || !(vfHeads[o.ov] ?? false) {
    fail(10, at, "a call_ref's head is no call_ref head")
    return false
  }
  if vfHeadsRead[o.ov] ?? false {
    fail(10, at, "a call_ref head read twice")
    return false
  }
  vfHeads[o.ov] = false
  vfHeadsRead[o.ov] = true
  return true
}

// Rule 4 at a use: a temp is read only once its one definition is in scope.
function use(o: Opnd, at: i32) {
  match o {
    OVar => {
      if vfPushes[o.ov] ?? false {
        return fail(
          10,
          at,
          "a push read anywhere but as its store's leading operand",
        )
      }
      if vfHeads[o.ov] ?? false {
        return fail(
          10,
          at,
          "a call_ref head read anywhere but as its call's callee",
        )
      }
      if o.ov < 0 || o.ov >= vf.irVars.length {
        return fail(
          4,
          at,
          "reads v" + i32ToStr(o.ov) + ", which does not exist",
        )
      }
      if vf.irVars[o.ov].vKind == "temp" && !vfDefined[o.ov] {
        return fail(
          4,
          at,
          "reads temp v" + i32ToStr(o.ov) + " before its definition",
        )
      }
      0
    }
    OImm | OStr => 0
  }
  return 0
}

function uses(os: Opnd[], at: i32) {
  for o in os { use(o, at) }
  return 0
}

function isNum(k: string): boolean {
  return k == "i32" || k == "i64" || k == "f64" || k == "f32"
}

function isInt(k: string): boolean { return k == "i32" || k == "i64" }

// 1 when operand `o` is a variable typed at an unsigned integer, 0 at any other type, -1 for an
// immediate, which carries no type.
function opUnsignedTy(o: Opnd): i32 {
  const v = opndVar(o)
  if v < 0 || v >= vf.irVars.length { return -1 }
  const p = tyScalarBasePrim(vf.irVars[v].vTy)
  if p == null { return 0 }
  const ps: string = p
  return if ps == "u32" || ps == "u64" { 1 } else { 0 }
}

function opndVar(o: Opnd): i32 {
  return match o {
    OVar => o.ov
    OImm | OStr => -1
  }
}

// Rule 2 for an order-stashed record (`mrSet`): it reads exactly the sets of its own literal, made
// in its source order, each at its kid's rep, and has no operands of its own.
function stashedRec(r: RMakeRec, ks: i32[], at: i32) {
  if r.mrFields.length != 0 || r.mrSrc.length != ks.length {
    return fail(2, at, "a stash-set record's shape")
  }
  let j = 0
  const keepAt: i32[] = []
  const keepK: i32[] = []
  const keepRep: i32[] = []
  let i = 0
  while i < vfSetAt.length {
    if vfSetAt[i] == r.mrAt {
      const k = vfSetK[i]
      if j >= r.mrSrc.length || r.mrSrc[j] != k {
        return fail(2, at, "a stash set out of its source order")
      }
      if k < 0 || k >= ks.length || vfSetRep[i] != ks[k] {
        return fail(2, at, "a stash set's rep differs from its field's")
      }
      j = j + 1
    } else {
      keepAt.push(vfSetAt[i])
      keepK.push(vfSetK[i])
      keepRep.push(vfSetRep[i])
    }
    i = i + 1
  }
  if j != r.mrSrc.length {
    return fail(2, at, "a stash-set record's field unset")
  }
  vfSetAt = keepAt
  vfSetK = keepK
  vfSetRep = keepRep
  return 0
}

// Rule 2 for a primitive op: its operands' reps and its result rep `dst`.
function primSig(r: RPrimOp, dst: i32, at: i32) {
  const a = r.poArgs
  const unary = r.poOp == "neg" || r.poOp == "not"
  const want = if unary { 1 } else { 2 }
  if a.length != want {
    return fail(
      2,
      at,
      r.poOp
        + " takes "
        + i32ToStr(want)
        + " operands, got "
        + i32ToStr(a.length),
    )
  }
  const ar = opRep(a[0])
  // eq/ne compares the i32 cells of a bool and a `boolean | null` niche; the null sentinel 2
  // equals only null.
  const niche = !unary
    && (r.poOp == "eq" || r.poOp == "ne")
    && nicheBoolPair(ar, opRep(a[1]))
  if !unary && opRep(a[1]) != ar && !niche {
    return fail(2, at, r.poOp + "'s operands differ in rep")
  }
  const k = if niche { "bool" } else { repWhat(ar) }
  const op = r.poOp
  const kindOk = match op {
    "add" | "sub" | "mul" | "div" | "rem" | "lt" | "le" | "gt" | "ge" | "neg" => isNum(k)
    "divu" | "remu" | "ltu" | "leu" | "gtu" | "geu" | "shl" | "shr" | "shru" => isInt(k)
    "and" | "or" | "xor" => isInt(k) || k == "bool"
    "eq" | "ne" => isNum(k) || k == "bool"
    "not" => k == "bool"
  }
  if !kindOk { return fail(2, at, r.poOp + " has no signature over " + k) }
  // The signed and unsigned forms must agree with the operand's type, which the rep cannot say.
  const wantsUnsigned = match op {
    "divu" | "remu" | "ltu" | "leu" | "gtu" | "geu" => 1
    "div" | "rem" | "lt" | "le" | "gt" | "ge" | "shr" => 0
    "add" | "sub" | "mul" | "shl" | "shru" | "and" | "or" | "xor" | "eq" | "ne" | "neg" | "not" => -1
  }
  if wantsUnsigned >= 0 {
    for o in a {
      const u = opUnsignedTy(o)
      if u >= 0 && u != wantsUnsigned {
        return fail(2, at, r.poOp + "'s signedness is not its operand's type's")
      }
    }
  }
  const cmp = match op {
    "eq" | "ne" | "lt" | "ltu" | "le" | "leu" | "gt" | "gtu" | "ge" | "geu" | "not" => true
    "add" | "sub" | "mul" | "div" | "divu" | "rem" | "remu" | "neg" | "shl" | "shr" | "shru" | "and" | "or" | "xor" => false
  }
  const res = if cmp { vfBool } else { ar }
  if dst != res {
    return fail(2, at, r.poOp + "'s result is not its destination's rep")
  }
  return 0
}

// Whether reps `x` and `y` are each `boolean` or its `boolean | null` niche, one of them a niche.
function nicheBoolPair(x: i32, y: i32): boolean {
  const xn = repBoolNiche(x)
  const yn = repBoolNiche(y)
  return (xn || repPrim(x) == "bool")
    && (yn || repPrim(y) == "bool")
    && (xn || yn)
}

// Rules 2 and 6 for a call of callee `fnPos` with `args` into a destination of rep `dst`
// (-1 for an effect, which keeps no result).
function callSig(fnPos: i32, args: Opnd[], dst: i32, at: i32, never: boolean) {
  const si = irSigOf(vf, fnPos)
  if si < 0 {
    return fail(6, at, "calls f" + i32ToStr(fnPos) + ", which has no signature")
  }
  const ps = vf.irSigParams[si]
  if ps.length != args.length {
    return fail(
      6,
      at,
      "passes "
        + i32ToStr(args.length)
        + " arguments to "
        + i32ToStr(ps.length)
        + " parameters",
    )
  }
  let i = 0
  while i < ps.length {
    if (
      opRep(args[i]) != ps[i]
      && !repNullRefFits(opRep(args[i]), ps[i])
      && !vfStoresAs(ps[i], opRep(args[i]))
    ) {
      return fail(
        6,
        at,
        "argument " + i32ToStr(i) + "'s rep is not its parameter's",
      )
    }
    i = i + 1
  }
  // A callee that never returns has no result: its call takes its consumer's rep.
  const noRet = never && repIsNoValue(vf.irSigRet[si])
  if (
    dst >= 0
    && dst != vf.irSigRet[si]
    && !vfStoresAs(dst, vf.irSigRet[si])
    && !noRet
  ) {
    return fail(6, at, "the result rep is not the callee's")
  }
  return 0
}

function kidAt(r: i32, i: i32): i32 {
  const ks = repNodeKids(r)
  if i < 0 || i >= ks.length { return -1 }
  return ks[i]
}

// Rule 2: `r`'s operands and its result rep against destination rep `dst` (-1 for an effect).
// The receiver push `r` at node `at` appends to: its own operand, or the one its stage reads.
// The stage is the receiver's one reader, so a staged push uses nothing of it.
function pushRecvOpnd(r: RListPush, at: i32): Opnd {
  const v = r.lpV
  if v is PStaged {
    const sg = stageAt(v.pstNode)
    if sg == null || sg.rsgAt != r.lpAt {
      fail(10, at, "a staged push names no stage of its own call")
      const none: Opnd = { ov: -1 }
      return none
    }
    return sg.rsgV
  }
  return v
}

// Whether map value rep `val` is a scalar `print`'s map-read arm streams.
function mapPrintScalar(val: i32): boolean {
  const p = repPrim(val)
  return p == "i32" || p == "i64" || p == "f32" || p == "f64"
}

// The receiver stage node `id` is, or null.
function stageAt(id: i32): RListStage | null {
  if id < 0 || id >= vf.irNodes.length { return null }
  const n = vf.irNodes[id]
  if !(n is SEffect) { return null }
  const r = n.efRhs
  if r is RListStage { return r }
  return null
}

// Whether a read of global `sym` at node `at`, at rep `dst`, is at its checked type's rep or else at
// the storage row the builder recorded taking it at (`irGlobalStoreTyOf`; D14434, D14426).
// Whether retag node `at` of `o` into `dst` is a closure the builder noted at a plainly written
// record field: every closure lowers to the one closure struct, whatever signature either names.
function cloFieldRetag(o: Opnd, dst: i32, at: i32): boolean {
  return irCloFieldRetagAt(vf, at)
    && repNodeAt(opRep(o)) is RClosure
    && repNodeAt(dst) is RClosure
}

function globalReadAtTyOrStorage(sym: i32, dst: i32, at: i32): boolean {
  const src = vf.irNodeAt[at] ?? -1
  if src < 0 || dst == repNodeOfTy(irFactTyOf(vf, at)) { return true }
  const st = irGlobalStoreTyOf(vf, sym)
  return st >= 0 && dst == repNodeOfTy(st)
}

function rhsCheck(r: Rhs, dst: i32, at: i32) {
  match r {
    RPrimOp => {
      uses(r.poArgs, at)
      primSig(r, dst, at)
    }
    RCall => {
      uses(r.caCaps, at)
      uses(r.caArgs, at)
      // A capture handed back goes to a variable the call passed it from.
      for w in r.caWb {
        if !opndsHoldVar(r.caCaps, w) {
          return fail(2, at, "a call's write-back is not a capture it passes")
        }
      }
      callSig(r.caCallee, r.caArgs, dst, at, r.caNever)
    }
    RCallRef => {
      if r.crHead && !headRead(r.crFn, at) { return 0 }
      use(r.crFn, at)
      uses(r.crArgs, at)
      if !(repNodeAt(opRep(r.crFn)) is RClosure) {
        return fail(2, at, "call_ref of a non-closure")
      }
      0
    }
    RCallRefHead => {
      use(r.chFn, at)
      if !(repNodeAt(opRep(r.chFn)) is RClosure) {
        return fail(2, at, "call_ref head of a non-closure")
      }
      if dst != opRep(r.chFn) {
        return fail(2, at, "a call_ref head is at its closure's rep")
      }
      0
    }
    RCallHost => {
      uses(r.chArgs, at)
      if r.chVoid && dst >= 0 {
        return fail(2, at, "a void host call has no value")
      }
      0
    }
    RBoxField => {
      use(r.bfV, at)
      const bf = repNodeAt(opRep(r.bfV))
      if !(bf is RBox) && !(bf is RNullable && bf.rnDisc == 4) {
        return fail(2, at, "a narrowed field's receiver is a box")
      }
      0
    }
    RSharedRead => {
      // A global receiver is read again at each push; its recorded cell is the box, `srV` unread.
      if r.srGlobal >= 0 {
        if !boxShaped(irGlobalRepOf(vf, r.srGlobal)) {
          return fail(2, at, "a shared read's global receiver is a box")
        }
        if !(r.srV is OImm) {
          return fail(2, at, "a shared read's global receiver has no operand")
        }
        return 0
      }
      use(r.srV, at)
      // Unstashed, every arm reads the receiver twice, and a temp is read once.
      if (
        !r.srStash
        && (!(r.srV is OVar)
          || r.srV.ov < 0
          || r.srV.ov >= vf.irVars.length
          || vf.irVars[r.srV.ov].vKind == "temp")
      ) {
        return fail(
          2,
          at,
          "a shared read's receiver is a variable read more than once",
        )
      }
      // A boxed `U | null` (discipline 4) is held in the same box.
      const sn = repNodeAt(opRep(r.srV))
      if !(sn is RBox) && !(sn is RNullable && sn.rnDisc == 4) {
        return fail(2, at, "a shared read's receiver is a box")
      }
      0
    }
    RSharedFieldSet => {
      for v in r.shVs { use(v, at) }
      if dst >= 0 { return fail(2, at, "a shared field store is a statement") }
      // A global receiver is read again at each push; its recorded cell is the box, `shR` unread.
      if r.shGlobal >= 0 {
        if !boxShaped(irGlobalRepOf(vf, r.shGlobal)) {
          return fail(2, at, "a shared field store's global receiver is a box")
        }
        return 0
      }
      use(r.shR, at)
      // Unstaged, every arm reads the receiver again, and a temp is read once.
      if (
        !r.shStash
        && (!(r.shR is OVar)
          || r.shR.ov < 0
          || r.shR.ov >= vf.irVars.length
          || vf.irVars[r.shR.ov].vKind == "temp")
      ) {
        return fail(
          2,
          at,
          "a shared field store's receiver is a variable read more than once",
        )
      }
      if !boxShaped(opRep(r.shR)) {
        return fail(2, at, "a shared field store's receiver is a box")
      }
      0
    }
    RArmUnbox => {
      use(r.uaV, at)
      if !boxShaped(opRep(r.uaV)) {
        return fail(2, at, "an arm unbox's operand is a box")
      }
      const dn = repNodeAt(dst)
      const rec = dn is RRecord
        || dn is RNullable && repNodeAt(dn.rnInner) is RRecord
      if !rec { return fail(2, at, "an arm unbox lands at a record") }
      if r.uaDst >= 0 && r.uaDst != dst {
        return fail(2, at, "a record arms unbox lands at the record it names")
      }
      if r.uaAsg && r.uaDst < 0 {
        return fail(2, at, "an assignment's arm unbox names its destination")
      }
      0
    }
    RNicheRead => {
      use(r.nrV, at)
      if !boxShaped(opRep(r.nrV)) {
        return fail(2, at, "a niche read's operand is a box")
      }
      const dn = repNodeAt(dst)
      const nulStr = dn is RNullable && dn.rnDisc == 1 && dn.rnInner == vfStr
      const fits = if r.nrKind == 1 { repBoolNiche(dst) } else if r.nrKind == 2 { nulStr } else { nicheRefFits(r.nrKind, dst) }
      if !fits { return fail(2, at, "a niche read is at its niche's rep") }
      0
    }
    RBoxNarrow => {
      use(r.bnV, at)
      const bn = repNodeAt(opRep(r.bnV))
      const boxed = bn is RBox
        || bn is RNullable
        && bn.rnDisc == 4
        && (r.bnAtom >= 0 || r.bnCon >= 0 || repNodeAt(dst) is RRecord)
      if !boxed {
        return fail(2, at, "a narrowed variant read's operand is a box")
      }
      0
    }
    RRecCopyPure => {
      uses(r.rpV, at)
      if dst >= 0 && !(repNodeAt(dst) is RRecord) {
        return fail(2, at, "a record copy of a non-record rep")
      }
      0
    }
    RRecover => {
      use(r.rcV, at)
      if !(repNodeAt(opRep(r.rcV)) is RNullable) {
        return fail(2, at, "a recovered read's operand is nullable")
      }
      0
    }
    RRecordFitIs => {
      use(r.rfV, at)
      if dst != vfBool { return fail(2, at, "a record fit test is a bool") }
      if !(r.rfV is OVar) {
        return fail(2, at, "a record fit test re-reads a variable")
      }
      0
    }
    RVariantChain => {
      use(r.vcV, at)
      if dst != vfBool { return fail(2, at, "a variant chain test is a bool") }
      if !(r.vcV is OVar) {
        return fail(2, at, "a variant chain test re-reads a variable")
      }
      if !(repNodeAt(opRep(r.vcV)) is RBox) {
        return fail(2, at, "a variant chain test's operand is a box")
      }
      0
    }
    RVariantDiscrim => {
      use(r.vdV, at)
      if dst != vfBool {
        return fail(2, at, "a variant discriminant test is a bool")
      }
      if !(r.vdV is OVar) {
        return fail(2, at, "a variant discriminant test re-reads a variable")
      }
      if !(repNodeAt(opRep(r.vdV)) is RBox) {
        return fail(2, at, "a variant discriminant test's operand is a box")
      }
      0
    }
    RTest => {
      use(r.teV, at)
      if dst >= 0 && dst != vfBool { return fail(2, at, "`is` yields bool") }
      const tn = repNodeAt(opRep(r.teV))
      if !(tn is RBox) && !(tn is RNullable && tn.rnDisc == 4) {
        return fail(2, at, "a box test's operand is a box")
      }
      0
    }
    RAfterEffects => {
      for e in r.aeEff { use(e, at) }
      use(r.aeV, at)
      // The effects are dropped; the value is the default's, at its own rep.
      if opRep(r.aeV) != dst {
        return fail(2, at, "a value after effects is not at its value's rep")
      }
      0
    }
    RAsTail => {
      use(r.akV, at)
      // The member test reads a staged scalar: an atom id, or a numeric literal's base.
      const kr = opRep(r.akV)
      if !repIsScalar(kr) && !(repNodeAt(kr) is RAtom) {
        return fail(2, at, "a literal cast's operand is a scalar or an atom")
      }
      0
    }
    RAsUnion => {
      use(r.auV, at)
      // The tag test reads a box, a boxed nullable's null-tagged one too, and a union of lists
      // stored as its one list reads that list; what it yields is the cast's own rep.
      const on = repNodeAt(opRep(r.auV))
      const ln = if on is RNullable { repNodeAt(on.rnInner) } else { on }
      if !(on is RBox || on is RNullable && on.rnDisc == 4 || ln is RList) {
        return fail(2, at, "a union cast's operand is a box")
      }
      0
    }
    RCast => {
      use(r.ctV, at)
      // A trapping cast narrows a nullable reference to the reference it holds.
      const on = repNodeAt(opRep(r.ctV))
      if (
        r.ctOnFail == "trap"
        && !(on is RNullable && kidAt(opRep(r.ctV), 0) == r.ctTarget)
      ) {
        return fail(2, at, "a trapping cast's operand is its target's nullable")
      }
      if dst < 0 { return 0 }
      const ok = if r.ctOnFail == "trap" { dst == r.ctTarget } else { repNodeAt(dst) is RNullable && kidAt(dst, 0) == r.ctTarget }
      if !ok { return fail(2, at, "a cast's result is not its target's rep") }
      0
    }
    RTagOf => {
      use(r.tgV, at)
      if !(repNodeAt(opRep(r.tgV)) is RBox) {
        return fail(2, at, "a tag of a non-box")
      }
      if dst >= 0 && dst != vfI32 { return fail(2, at, "a tag is an i32") }
      0
    }
    RMakeRec => {
      uses(r.mrFields, at)
      if dst < 0 { return 0 }
      const ks = repNodeKids(dst)
      if r.mrSet { return stashedRec(r, ks, at) }
      if !(repNodeAt(dst) is RRecord) || ks.length != r.mrFields.length {
        return fail(2, at, "a record's fields do not match its rep")
      }
      let i = 0
      while i < ks.length {
        // A sub-word field (`repSubWord`) takes a plain i32, which `struct.new` truncates.
        if (
          opRep(r.mrFields[i]) != ks[i]
          && !vfOpenTakes(recKidSiteTy(r, i, at), ks[i], opRep(r.mrFields[i]))
          && !(repSubWord(ks[i]) && opRep(r.mrFields[i]) == vfI32)
        ) {
          return fail(2, at, "field " + i32ToStr(i) + "'s rep differs")
        }
        i = i + 1
      }
      // The layout writes each kid exactly once.
      if r.mrLayout.length != ks.length {
        return fail(2, at, "a record's layout length")
      }
      const seen: boolean[] = []
      for _k in ks { seen.push(false) }
      for k in r.mrLayout {
        if k < 0 || k >= seen.length || seen[k] {
          return fail(2, at, "a record's layout repeats")
        }
        seen[k] = true
      }
      // The order stash's source order, where there is one, evaluates each kid exactly once.
      if r.mrSrc.length > 0 {
        if r.mrSrc.length != ks.length {
          return fail(2, at, "a record's source order length")
        }
        const srcSeen: boolean[] = []
        for _k in ks { srcSeen.push(false) }
        for k in r.mrSrc {
          if k < 0 || k >= srcSeen.length || srcSeen[k] {
            return fail(2, at, "a record's source order repeats")
          }
          srcSeen[k] = true
        }
      }
      0
    }
    RGetField => {
      use(r.gfV, at)
      const v = opRep(r.gfV)
      if !(repNodeAt(v) is RRecord) {
        return fail(2, at, "a field read of a non-record")
      }
      // A union-box field's read unboxes to the read's own rep (`structUnionBoxTail`).
      const k = kidAt(v, r.gfIx)
      // A literal-union member is boxed as its string, which the unbox `gfStr` names leaves.
      const tr = repNodeOfTy(irFactTyOf(vf, at))
      const kk = repNodeAt(k)
      const unboxed = (kk is RBox || kk is RNullable && kk.rnDisc == 4)
        && (dst == tr
        || r.gfStr && dst == vfStr && repNodeAt(tr) is RAtom)
      // A nullable field the checker narrowed past its null reads at its inner rep.
      const kn = repNodeAt(k)
      const narrowed = kn is RNullable && kn.rnInner == dst
      // A sub-word field (`repSubWord`) reads into an i32.
      const subWord = repSubWord(k) && dst == vfI32
      if dst >= 0 && k != dst && !unboxed && !narrowed && !subWord {
        return fail(2, at, "a field's rep is not its destination's")
      }
      // A shared template member's read is at its kid's own rep: it has no type to unbox to.
      if r.gfShared && dst >= 0 && dst != k {
        return fail(2, at, "a shared member read is not at its field's rep")
      }
      // A read at its storage is the field's own box or boxed nullable, unboxed nowhere.
      const kb = repNodeAt(k) is RBox || kn is RNullable && kn.rnDisc == 4
      if r.gfStored && (!kb || dst != k) {
        return fail(2, at, "a field read at its storage is its declared box")
      }
      0
    }
    RMakeList => {
      uses(r.mlElems, at)
      if dst < 0 { return 0 }
      if !(repNodeAt(dst) is RList) {
        return fail(2, at, "a list literal of a non-list rep")
      }
      // A packed list's elements (`u8`, or a sub-word row) are plain i32s, which its backing
      // truncates (`arrayLit`).
      const el = kidAt(dst, 0)
      const en = repNodeAt(el)
      const packed = repPrim(el) == "u8" || en is RPrim && en.rpPacked != 0
      // A `null[]` list holds legacy's i32 storage, each `null` its sentinel (`emitArrI32`).
      const nulUnit = repPrim(el) == "null"
      const want = if packed || nulUnit { vfI32 } else { el }
      for e in r.mlElems {
        if opRep(e) != want {
          return fail(2, at, "an element's rep is not the list's")
        }
      }
      0
    }
    RSpread => {
      for s in r.spSrcs { use(s, at) }
      if dst < 0 { return 0 }
      if !(repNodeAt(dst) is RList) {
        return fail(2, at, "a spread literal of a non-list rep")
      }
      // A boxing spread's group is any list, which the lowering boxes or retags to the row; the
      // literal itself is a list of boxes.
      if r.spBoxRow >= 0 {
        const dl = repNodeAt(dst)
        const de = if dl is RList { repNodeAt(dl.rlsElem) } else { null }
        if !(de is RBox) && !(de is RNullable && de.rnDisc == 4) {
          return fail(2, at, "a boxing spread is not a list of boxes")
        }
        for s in r.spSrcs {
          if !(repNodeAt(opRep(s)) is RList) {
            return fail(2, at, "a boxing spread's source is not a list")
          }
        }
        return 0
      }
      let si = 0
      for s in r.spSrcs {
        // A group the plan converts is a list at its own element rep (`spConv`).
        const conv = i32ListHas(r.spConv, si) && repNodeAt(opRep(s)) is RList
        if opRep(s) != dst && !conv {
          return fail(2, at, "a spread's source rep is not the literal's")
        }
        si = si + 1
      }
      0
    }
    RListNewDefault => {
      use(r.ldLen, at)
      if opRep(r.ldLen) != vfI32 {
        return fail(2, at, "a list length is an i32")
      }
      if dst >= 0 && !(repNodeAt(dst) is RList) {
        return fail(2, at, "a zeroed list is a list")
      }
      0
    }
    RListNew => {
      use(r.lnLen, at)
      use(r.lnFill, at)
      if opRep(r.lnLen) != vfI32 {
        return fail(2, at, "a list length is an i32")
      }
      if dst >= 0 && opRep(r.lnFill) != kidAt(dst, 0) {
        return fail(2, at, "the fill's rep is not the element's")
      }
      0
    }
    RMemAccess => memAccessCheck(r, dst, at)
    RMaFoldInit => maFoldInitCheck(r, dst, at)
    RAtomic => atomicCheck(r, dst, at)
    RTruncSat => truncSatCheck(r, dst, at)
    RMemOp => {
      for o in r.moArgs { use(o, at) }
      for o in r.moArgs {
        if opRep(o) != vfI32 {
          return fail(2, at, "a memory op's operands are i32s")
        }
      }
      const v = irFactIntOf(vf, at, 1) == 1
      if dst >= 0 && (v || dst != vfI32) {
        return fail(
          2,
          at,
          "a memory op leaves an i32, or nothing for the bulk pair",
        )
      }
      0
    }
    RListCopy => {
      for o in r.lcArgs { use(o, at) }
      if r.lcArgs.length != 5 {
        return fail(2, at, "a list copy has five operands")
      }
      const dl = opRep(r.lcArgs[0])
      if !(repNodeAt(dl) is RList) || opRep(r.lcArgs[2]) != dl {
        return fail(2, at, "a list copy's two lists share one list rep")
      }
      for k in [1, 3, 4] {
        if opRep(r.lcArgs[k]) != vfI32 {
          return fail(2, at, "a list copy's offsets and count are i32s")
        }
      }
      0
    }
    RListGet => {
      use(r.lgV, at)
      use(r.lgIx, at)
      const l = opRep(r.lgV)
      if !(repNodeAt(l) is RList) && l != vfStr || opRep(r.lgIx) != vfI32 {
        return fail(
          2,
          at,
          "an element read takes a list or a string, and an i32",
        )
      }
      // A string's element is its code unit, an i32.
      if l == vfStr && dst >= 0 && dst != vfI32 {
        return fail(2, at, "a string's element is an i32")
      }
      // A sub-word element (`repSubWord`) reads into an i32.
      const packed = repSubWord(kidAt(l, 0)) && dst == vfI32
      // A nullable element may read recovered at its inner rep.
      const en = repNodeAt(kidAt(l, 0))
      const recovered = en is RNullable && en.rnInner == dst
      // A box element may read unboxed at the member its place narrows to.
      const unboxed = en is RBox || en is RNullable && en.rnDisc == 4
      if (
        l != vfStr
        && dst >= 0
        && kidAt(l, 0) != dst
        && !packed
        && !recovered
        && !unboxed
      ) {
        return fail(2, at, "an element's rep is not its destination's")
      }
      0
    }
    RRetag => {
      use(r.rgV, at)
      const d = repNodeAt(dst)
      if (
        !listRetag(opRep(r.rgV), dst)
        && !boxListRetag(opRep(r.rgV), dst)
        && !boxMapRetag(opRep(r.rgV), dst)
        && !listRetagHole(vf, opRep(r.rgV), dst)
        && !vfCloListUndeclared(opRep(r.rgV), dst)
        && !cloHoleRetagAlike(opRep(r.rgV), dst)
        && !recRetag(opRep(r.rgV), dst)
        && !cloFieldRetag(r.rgV, dst, at)
        && !plainRecordsLowerAlike(opRep(r.rgV), dst)
        && !(r.rgV is OVar && recValRetag(vf, r.rgV.ov, opRep(r.rgV), dst))
        && !recFieldsWiden(opRep(r.rgV), dst, vf.irRecHeap)
        && !recSubRetag(opRep(r.rgV), dst, vf.irRecHeap, vf.irRecSub)
        && !repNullRefFits(opRep(r.rgV), dst)
        && (!(d is RNullable)
          || !nicheRetag(d.rnDisc, d.rnInner)
          || d.rnInner != opRep(r.rgV))
      ) {
        return fail(
          2,
          at,
          "a retag is not of an atom or a string into its own nullable niche, the bottom ref into a nullable reference, a box map as another, a ref list as itself or into its hole, a variant record as its struct twin, or a record as one whose fields, or leading fields, lower alike or widen to its nullable fields",
        )
      }
      0
    }
    RAtomStr => {
      use(r.sxV, at)
      // An atom decodes to a string, which a `string | null` also holds; only a `K | null`
      // carries the null its destination must hold.
      const s = repNodeAt(opRep(r.sxV))
      const d = repNodeAt(dst)
      const nulSrc = s is RNullable
        && s.rnDisc == 3
        && repNodeAt(s.rnInner) is RAtom
      const nulDst = d is RNullable && d.rnDisc == 1 && d.rnInner == vfStr
      // A `K | null` narrowed past its null decodes to a plain string where the plan writes none.
      const nulFree = irFactIntOf(vf, at, 1) == 0
      if (
        !(s is RAtom || nulSrc)
        || !(dst == vfStr || nulDst)
        || nulSrc && !nulDst && !nulFree
      ) {
        return fail(2, at, "an atom decode is not of an atom into a string")
      }
      0
    }
    RFieldNull => {
      const d = repNodeAt(dst)
      if !(d is RNullable) && !(d is RBox) {
        return fail(
          2,
          at,
          "a field's null is not delivered into a nullable or a box",
        )
      }
      0
    }
    RNullOf => {
      const d = repNodeAt(dst)
      const fact = irFactIntOf(vf, at, 2)
      const own = fact % 3
      // A null-unit place read's null carries the read, written for its effect where it is read.
      if r.nuRead.length > 1 || (r.nuRead.length == 1) != (fact >= 3) {
        return fail(
          2,
          at,
          "a null-unit place read's null does not carry exactly its read",
        )
      }
      if own == 1 {
        if !(d is RBox) && !(d is RNullable && d.rnDisc == 4) {
          return fail(2, at, "a null box is not delivered into a union box")
        }
      } else if own == 0 && repPrim(dst) == "null" {
        // The `null` unit's one value is the bottom ref.
      } else if own == 0 && d is RNullable && d.rnDisc != 1 {
        return fail(2, at, "the bottom ref is no sentinel's or box's null")
      } else if !(d is RNullable) || !nicheRetag(d.rnDisc, d.rnInner) {
        return fail(
          2,
          at,
          "a null is not delivered into a K | null or a nullable reference",
        )
      }
      0
    }
    RJoinNull => {
      // A join's null is its nullable reference's, never a box's or a sentinel's.
      const d = repNodeAt(dst)
      if (
        !(d is RNullable)
        || d.rnDisc != 1
        || !nicheRetag(d.rnDisc, d.rnInner)
      ) {
        return fail(
          2,
          at,
          "a join null is not delivered into a nullable reference",
        )
      }
      0
    }
    RRetNull => {
      // The function's own null is its result, so it is delivered at the return rep, a nullable one.
      const d = repNodeAt(dst)
      if dst != vf.irRetRep || !(d is RNullable || d is RBox) {
        return fail(
          2,
          at,
          "a returned null is not at the function's nullable return rep",
        )
      }
      0
    }
    RNulNicheEq => nulNicheEqCheck(r, dst, at)
    RNulNoneBox => {
      if r.nnPay {
        use(r.nnV, at)
        if repPrim(opRep(r.nnV)) != "null" {
          return fail(
            2,
            at,
            "a null-typed box's payload is no null-typed value",
          )
        }
      }
      if !boxShaped(dst) {
        return fail(2, at, "a null-typed box lands at no box")
      }
      0
    }
    RClosureEq => closureEqCheck(r, dst, at)
    RIdentityEq => identityEqCheck(r, dst, at)
    RNulTest => {
      use(r.ntV, at)
      const d = repNodeAt(opRep(r.ntV))
      // A union box (discipline 4 included) answers by its null tag.
      const box = d is RBox || d is RNullable && d.rnDisc == 4
      // A record reference's `ref.is_null` answers too, for a holder read as its record.
      if (
        !box
        && !(d is RRecord)
        && (!(d is RNullable) || !nicheRetag(d.rnDisc, d.rnInner))
      ) {
        return fail(
          2,
          at,
          "a null test of neither a K | null, a nullable reference nor a box",
        )
      }
      0
    }
    RAtomEq => {
      // A static side's immediate is unread; any other static operand is evaluated and dropped.
      if !((r.aeStatic == 1 || r.aeStatic == 3) && r.aeL is OImm) {
        use(r.aeL, at)
      }
      if !((r.aeStatic == 2 || r.aeStatic == 3) && r.aeR is OImm) {
        use(r.aeR, at)
      }
      0
    }
    RUnionConcreteEq => {
      use(r.ucBox, at)
      use(r.ucOther, at)
      const bv = r.ucBox
      // A stashed or parked box is read once, so it may be any value.
      if (
        !r.ucStash
        && (r.ucStage & 1) == 0
        && (!(bv is OVar)
          || bv.ov < 0
          || bv.ov >= vf.irVars.length
          || vf.irVars[bv.ov].vKind == "temp" && !r.ucAgain)
      ) {
        return fail(2, at, "a union compare's box is not a re-read variable")
      }
      const ov = r.ucOther
      if (
        r.ucNul
        && (r.ucStage & 2) == 0
        && !r.ucOtherAgain
        && (!(ov is OVar)
          || ov.ov < 0
          || ov.ov >= vf.irVars.length
          || vf.irVars[ov.ov].vKind == "temp")
      ) {
        return fail(
          2,
          at,
          "a union compare's null-leg operand is not a re-read variable",
        )
      }
      // An operand read again is a null leg's, unparked, beside a box held in a variable or parked.
      if (
        r.ucOtherAgain
        && (!r.ucNul
          || (r.ucStage & 2) != 0
          || (r.ucStage & 1) == 0
          && (!(bv is OVar)
          || bv.ov < 0
          || bv.ov >= vf.irVars.length
          || vf.irVars[bv.ov].vKind == "temp"))
      ) {
        return fail(
          2,
          at,
          "a union compare's operand is read again off a null leg or beside a box that is no variable",
        )
      }
      0
    }
    RUnionEq => {
      use(r.ueL, at)
      use(r.ueR, at)
      0
    }
    RUnionVariantEq => {
      use(r.uvBox, at)
      use(r.uvOther, at)
      0
    }
