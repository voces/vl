        return fail(2, at, "a staged atom narrowing parks a string")
      }
      if dst >= 0 && !(repNodeAt(dst) is RAtom) {
        return fail(2, at, "a staged atom narrowing is an atom")
      }
      0
    }
    RStrToAtom => {
      uses(r.saReads, at)
      for o in r.saReads {
        if repPrim(opRep(o)) != "str" {
          return fail(2, at, "an atom tower tests string reads")
        }
      }
      if r.saReads.length == 0 {
        return fail(2, at, "an atom tower tests at least one member")
      }
      if dst >= 0 && !(repNodeAt(dst) is RAtom) {
        return fail(2, at, "an atom tower is an atom")
      }
      0
    }
    RCellNew => use(r.cnInit, at)
    RCellGet => use(r.cgCell, at)
    REnvGet => 0
    REnvDrop => 0
    // The progress store is a statement's effect: it yields nothing.
    RInitProgress => if dst >= 0 { fail(2, at, "an init progress store yields no value") } else { 0 }
    RBundlePick => {
      use(r.bpV, at)
      if dst >= 0 && !(repNodeAt(dst) is RClosure) {
        return fail(2, at, "a bundle member of a non-closure rep")
      }
      0
    }
    RHandPick => {
      use(r.hpV, at)
      if !(repNodeAt(opRep(r.hpV)) is RRecord) {
        return fail(2, at, "a hand pick of a non-record value")
      }
      if dst >= 0 && !(repNodeAt(dst) is RClosure) {
        return fail(2, at, "a hand member of a non-closure rep")
      }
      0
    }
    RHolderPick => {
      use(r.hkV, at)
      if !(repNodeAt(opRep(r.hkV)) is RRecord) {
        return fail(2, at, "a holder pick of a non-record value")
      }
      if dst >= 0 && !(repNodeAt(dst) is RClosure) {
        return fail(2, at, "a holder member of a non-closure rep")
      }
      0
    }
    RResultPick => {
      use(r.rkV, at)
      if !(repNodeAt(opRep(r.rkV)) is RRecord) {
        return fail(2, at, "a result pick of a non-record value")
      }
      if dst >= 0 && !(repNodeAt(dst) is RClosure) {
        return fail(2, at, "a result member of a non-closure rep")
      }
      0
    }
    RGlobalGet => {
      const g = irGlobalRepOf(vf, r.ggSym)
      if g < 0 { return fail(2, at, "reads a global with no recorded rep") }
      const gn = repNodeAt(g)
      const narrowed = r.ggNn >= 0 && gn is RNullable && gn.rnInner == dst
      if dst >= 0 && dst != g && !narrowed && !vfStoresAs(dst, g) {
        return fail(2, at, "a global's rep is not its destination's")
      }
      // A global the builder noted as holding a record whole is read at that record (`irGlobalHeld`).
      const held = vf.irGlobalHeld[r.ggSym] ?? false
      if (
        dst >= 0
        && !narrowed
        && !held
        && !globalReadAtTyOrStorage(r.ggSym, dst, at)
      ) {
        return fail(
          2,
          at,
          "a global read off its type's rep is not at its storage row",
        )
      }
      0
    }
    RRawOp => rawRhs(r, dst, at)
    RRel => {
      if !vf.irHelper {
        return fail(10, at, "a raw op outside a runtime helper")
      }
      if dst >= 0 && dst != vfI32 {
        return fail(2, at, "a relocated constant is an i32")
      }
      0
    }
    RStage => {
      use(r.sgV, at)
      // A literal stages only at its own string rep; the box-view escape is for a variable.
      const view = !(r.sgV is OStr) && boxShaped(dst) && boxShaped(opRep(r.sgV))
      if dst >= 0 && dst != opRep(r.sgV) && !view {
        return fail(2, at, "a staged operand is a value at its own rep")
      }
      0
    }
  }
  return 0
}

// Whether rep `r` is the union box: a union's own, or a boxed `T | null` (disc 4).
function boxShaped(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RBox || n is RNullable && n.rnDisc == 4
}

// Whether rep `r` is raw, at heap `heap` unless that is -1.
// A variable operand naming no variable, for a missing leading operand.
function i32Opnd(v: i32): Opnd { return { ov: v } }

// Whether rep `r` is a raw reference whose heap type no table tracks (heap -1).
function untracked(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RRaw && n.rwHeap == -1
}

function rawAt(r: i32, heap: i32): boolean {
  const n = repNodeAt(r)
  return n is RRaw && (heap < 0 || n.rwHeap == heap)
}

// Rule 10 for a raw value op into destination rep `dst`. A `struct.get` result and a `call`'s
// operands are not checked here: no table keeps a heap's layout or a helper's signature.
function rawRhs(r: RRawOp, dst: i32, at: i32) {
  if !vf.irHelper { return fail(10, at, "a raw op outside a runtime helper") }
  uses(r.rwArgs, at)
  const a = r.rwArgs
  const h = r.rwHeap
  const n = a.length
  const ref0 = n > 0 && rawAt(opRep(a[0]), h)
  const ok = match r.rwOp {
    "struct.get" | "array.len" | "ref.is_null" => n == 1 && ref0
    "ref.as_non_null" => n == 1 && ref0 && rawAt(dst, h)
    "array.get" => n == 2 && ref0 && opRep(a[1]) == vfI32
    "array.new_default" => n == 1 && opRep(a[0]) == vfI32 && rawAt(dst, h)
    "struct.new" => rawAt(dst, h)
    "ref.eq" => n == 2 && rawAt(opRep(a[0]), -1) && rawAt(opRep(a[1]), -1)
    "ref.cast" => n == 1 && rawAt(opRep(a[0]), -1) && rawAt(dst, h)
    "ref.null" => n == 0 && rawAt(dst, h)
    "call" => true
    "test" => n == 1 && opRep(a[0]) == vfI32 && dst == vfBool
    "load" => n == 1 && opRep(a[0]) == vfI32 && dst == vfI32
    "push" => n == 1 && !(a[0] is OStr) && dst == opRep(a[0])
    "ref.test" => n == 1 && rawAt(opRep(a[0]), -1) && dst == vfBool
    "select" => n == 3
      && opRep(a[2]) == vfBool
      && opRep(a[0]) == opRep(a[1])
      && dst == opRep(a[0])
    "tag64" => n == 1 && a[0] is OVar && repPrim(opRep(a[0])) == "i64" && dst == vfI32
    "tee" => n == 1
      && r.rwImm >= 0
      && r.rwImm < vf.irVars.length
      && vf.irVars[r.rwImm].vRep == opRep(a[0])
      && dst == opRep(a[0])
  }
  if !ok {
    return fail(10, at, r.rwOp + " is not over heap type " + i32ToStr(h))
  }
  return 0
}

// Rule 10 for a raw effect: `array.copy`'s source is at heap `srImm`.
function rawEff(e: SRawOp, at: i32) {
  // A list reserve's open and close are legacy's own calls, written in any body.
  if e.srOp == "reserve.open" || e.srOp == "reserve.close" {
    return if e.srArgs.length == 0 { 0 } else { fail(10, at, e.srOp + " takes no operand") }
  }
  // A binding sink's pair writes: a box in, the null in, or the box out to a box variable.
  if e.srOp == "sink.put" || e.srOp == "sink.null" || e.srOp == "sink.close" {
    uses(e.srArgs, at)
    const n0 = if e.srOp == "sink.put" { 1 } else { 0 }
    const v = e.srImm
    const varOk = e.srOp == "sink.null"
      || v >= 0
      && v < vf.irVars.length
      && sinkBoxRep(vf.irVars[v].vRep)
    if (
      e.srArgs.length != n0
      || !varOk
      || n0 == 1 && !sinkBoxRep(opRep(e.srArgs[0]))
    ) {
      return fail(10, at, e.srOp + " is not a union box into the sink pair")
    }
    return 0
  }
  if e.srOp == "as.fail" {
    const c = if e.srImm >= 0 && e.srImm < P.nodes.length { nodeAt(e.srImm) } else { null }
    return if e.srArgs.length == 0 && c is AsExpr && c.asMode == "trap" { 0 } else { fail(10, at, "as.fail is not an `as!` cast's report") }
  }
  if !vf.irHelper { return fail(10, at, "a raw op outside a runtime helper") }
  // Every outstanding push is this effect's leading operands, in push order.
  let k = 0
  while k < vfPushed.length {
    const p = if k < e.srArgs.length { e.srArgs[k] } else { i32Opnd(-1) }
    if !(p is OVar) || p.ov != vfPushed[k] {
      return fail(
        10,
        at,
        "a push is not its store's leading operand, in push order",
      )
    }
    vfPushes[p.ov] = false
    k = k + 1
  }
  vfPushed = []
  uses(e.srArgs, at)
  const a = e.srArgs
  const n = a.length
  const ref0 = n > 0 && rawAt(opRep(a[0]), e.srHeap)
  const ok = match e.srOp {
    "struct.set" => n == 2 && ref0
    "array.set" => n == 3 && ref0 && opRep(a[1]) == vfI32
    "array.copy" => n == 5 && ref0 && rawAt(opRep(a[2]), e.srImm)
    "array.init_data" | "array.fill" => n == 4 && ref0
    "call" => true
    "reserve.open" | "reserve.close" | "sink.put" | "sink.null" | "sink.close" | "as.fail" => false
  }
  if !ok {
    return fail(10, at, e.srOp + " is not over heap type " + i32ToStr(e.srHeap))
  }
  return 0
}

// Whether rep `r` is a union box, or a nullable one held as the same `{tag, payload}`.
function sinkBoxRep(r: i32): boolean {
  const d = repNodeAt(r)
  return d is RBox || d is RNullable && d.rnDisc == 4
}

// Whether node `id` leaves its body: a branch, a return, a trap or a call that never returns.
function exits(id: i32): boolean {
  if id < 0 || id >= vf.irNodes.length { return false }
  const n = vf.irNodes[id]
  return n is SBr || n is SReturn || irNodeEndsPath(n)
}

// Rule 5's fall-through: a body with out-variable `out` ends by writing it, or by leaving.
function endsWriting(body: i32[], out: i32, at: i32) {
  if out < 0 { return 0 }
  if body.length == 0 {
    return fail(5, at, "an arm leaves v" + i32ToStr(out) + " unwritten")
  }
  const last = body[body.length - 1]
  if exits(last) { return 0 }
  const n = vf.irNodes[last]
  if n is SAssign && n.asDst == out { return 0 }
  fail(5, at, "an arm leaves v" + i32ToStr(out) + " unwritten")
}

// Walks a nested body: the temps it defines are out of scope after it.
// Why a boxed operand's `??` is ill-formed, or "": it reads a union box, or a nullable boxed as a
// union is (discipline 4).
function coalBoxWhy(n: SCoalBox): string {
  const lr = repNodeAt(opRep(n.cbL))
  if lr is RBox || lr is RNullable && lr.rnDisc == 4 { return "" }
  return "a boxed `??` reads no box"
}

// Why a nullable reference's `??` is ill-formed, or "": it reads a nullable reference, and its out
// is that reference, its non-null inner, or a join's box.
// A niche cell's `??` reads its niche (an atom's, or `boolean | null`'s) and writes the niche or
// its present value.
function coalNicheWhy(n: SCoalBox): string {
  const lr = opRep(n.cbL)
  const ln = repNodeAt(lr)
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "a niche cell's `??` writes no variable"
  }
  const or = vf.irVars[o].vRep
  if n.cbArm == "litUnion" {
    if !(ln is RNullable) || ln.rnDisc != 3 {
      return "an atom niche's `??` reads no atom niche"
    }
    if or != lr && or != ln.rnInner {
      return "an atom niche's `??` yields neither the niche nor its atom"
    }
    return ""
  }
  if !repBoolNiche(lr) {
    return "a `boolean | null` `??` reads no boolean niche"
  }
  if or != lr && repPrim(or) != "bool" {
    return "a `boolean | null` `??` yields neither the niche nor a boolean"
  }
  return ""
}

// A `p?.f ?? d` over a nullable record re-reads its receiver, a variable, and yields a scalar.
function coalOptLeafWhy(n: SCoalBox): string {
  if !(n.cbL is OVar) { return "an optional field `??` re-reads no variable" }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "an optional field `??` writes no variable"
  }
  if repPrim(vf.irVars[o].vRep) == null {
    return "an optional field `??` yields no scalar"
  }
  return ""
}

// An optional box field's `??` re-reads its receiver and yields a scalar or the union's box.
function coalOptBoxLeafWhy(n: SCoalBox): string {
  if !(n.cbL is OVar) {
    return "an optional box field `??` re-reads no variable"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "an optional box field `??` writes no variable"
  }
  const r = vf.irVars[o].vRep
  if repPrim(r) == null && !(repNodeAt(r) is RBox) {
    return "an optional box field `??` yields no scalar or box"
  }
  return ""
}

// An optional record field's `??` re-reads its receiver and yields a record or its nullable.
function coalOptRecLeafWhy(n: SCoalBox): string {
  if !(n.cbL is OVar) {
    return "an optional record field `??` re-reads no variable"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "an optional record field `??` writes no variable"
  }
  const r = repNodeAt(vf.irVars[o].vRep)
  if !(r is RRecord || r is RNullable && repNodeAt(r.rnInner) is RRecord) {
    return "an optional record field `??` yields no record"
  }
  return ""
}

// A `K | null` niche's join `??` reads the atom niche and yields the union's box.
function coalNulAtomJoinWhy(n: SCoalBox): string {
  const r = repNodeAt(opRep(n.cbL))
  if !(r is RNullable) || r.rnDisc != 3 {
    return "an atom join `??` reads no atom niche"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "an atom join `??` writes no variable"
  }
  if !(repNodeAt(vf.irVars[o].vRep) is RBox) {
    return "an atom join `??` yields no box"
  }
  return ""
}

// A fused `m[k]?.f ?? d` reads its map and key through its probe and yields the field's scalar.
function coalOptMapFieldWhy(n: SCoalBox, id: i32): string {
  const mp = n.cbMap
  if mp == null { return "an optional map field `??` holds no probe" }
  use(mp.prKey, id)
  if !mapRecvOk(mp.prSym, n.cbL, id) {
    return "an optional map field `??` reads a receiver that is no map"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "an optional map field `??` writes no variable"
  }
  if repPrim(vf.irVars[o].vRep) == null {
    return "an optional map field `??` yields no scalar"
  }
  return ""
}

// A `boolean | null` niche's join `??` reads the niche and yields the union's box.
function coalNulBoolJoinWhy(n: SCoalBox): string {
  if !repBoolNiche(opRep(n.cbL)) {
    return "a boolean join `??` reads no boolean niche"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "a boolean join `??` writes no variable"
  }
  const on = repNodeAt(vf.irVars[o].vRep)
  const box = on is RBox || on is RNullable && on.rnDisc == 4
  return if box { "" } else { "a boolean join `??` yields no box" }
}

// A record field's `??` re-reads its record, a variable, and yields the field's box or its scalar.
function coalFieldWhy(n: SCoalBox): string {
  if !(n.cbL is OVar) { return "a field `??` re-reads no variable" }
  // The record, or a box or nullable record the lowering unwraps to it.
  const lr = repNodeAt(opRep(n.cbL))
  const recv = lr is RRecord
    || lr is RBox
    || lr is RNullable
    && (lr.rnDisc == 4 || repNodeAt(lr.rnInner) is RRecord)
  if !recv { return "a field `??` reads no record" }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length { return "a field `??` writes no variable" }
  const or = vf.irVars[o].vRep
  if n.cbArm == "fieldBox" {
    return if repNodeAt(or) is RBox { "" } else { "a field `??` keeps no box" }
  }
  return if repPrim(or) != null { "" } else { "a field `??` unboxes to no scalar" }
}

function coalNulRefWhy(n: SCoalBox): string {
  const lr = repNodeAt(opRep(n.cbL))
  if !(lr is RNullable) || lr.rnDisc == 4 || lr.rnInner < 0 {
    return "a nullable-reference `??` reads no nullable reference"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "a nullable-reference `??` writes no variable"
  }
  const or = vf.irVars[o].vRep
  const on = repNodeAt(or)
  const boxed = on is RBox || on is RNullable && on.rnDisc == 4
  // A nullable map's `??` may yield its default's wider map, stored alike (D15050).
  const ir = repNodeAt(lr.rnInner)
  const wv = if on is RMap { repNodeAt(on.rmVal) } else { null }
  const maps = on is RMap
    && ir is RMap
    && (on.rmVal == ir.rmVal
    || wv is RNullable && wv.rnInner == ir.rmVal)
  if !boxed && !maps && or != opRep(n.cbL) && or != lr.rnInner {
    return "a nullable-reference `??` yields neither the reference, its inner, a map whose value widens the inner's, nor a box"
  }
  return ""
}

// Why a `string | null` `??` whose default computes is ill-formed, or "": it reads a nullable
// string and yields that string or its non-null inner.
// A propagating `as`'s block reads a nullable reference or string and yields its non-null inner;
// its null path returns.
function coalAsPropWhy(n: SCoalBox): string {
  const lr = repNodeAt(opRep(n.cbL))
  if !(lr is RNullable) || lr.rnDisc != 1 {
    return "a propagating `as` reads no nullable reference"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length || vf.irVars[o].vRep != lr.rnInner {
    return "a propagating `as` yields no non-null inner"
  }
  if n.cbNull.length == 0 || !exits(n.cbNull[n.cbNull.length - 1]) {
    return "a propagating `as`'s null path does not leave"
  }
  return ""
}

function coalNulStrWhy(n: SCoalBox): string {
  const lr = repNodeAt(opRep(n.cbL))
  if !(lr is RNullable) || lr.rnDisc != 1 || repPrim(lr.rnInner) != "str" {
    return "a string `??` reads no nullable string"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "a string `??` writes no variable"
  }
  const or = vf.irVars[o].vRep
  const on = repNodeAt(or)
  const boxed = on is RBox || on is RNullable && on.rnDisc == 4
  if !boxed && or != opRep(n.cbL) && or != lr.rnInner {
    return "a string `??` yields neither the string, its inner, nor a box"
  }
  return ""
}

// Why a shared `scalar | null` field's `??` is ill-formed, or "": it reads a boxed nullable and
// yields a scalar.
function coalBoxFieldScalarWhy(n: SCoalBox): string {
  const ln = repNodeAt(opRep(n.cbL))
  if !(ln is RNullable) || ln.rnDisc != 4 {
    return "a box field's `??` reads no boxed nullable"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length || repPrim(vf.irVars[o].vRep) == null {
    return "a box field's `??` yields no scalar"
  }
  return ""
}

// Why a fused `pop ?? d` is ill-formed, or "": it pops a list of a scalar or atom element, and its
// out is at that element's rep.
function coalPopOrWhy(n: SCoalBox): string {
  const lr = repNodeAt(opRep(n.cbL))
  if !(lr is RList) { return "a `pop ?? d` pops no list" }
  if !scalarListElem(lr.rlsElem) {
    return "a `pop ?? d` pops a list of no scalar element"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length || vf.irVars[o].vRep != lr.rlsElem {
    return "a `pop ?? d` yields no element"
  }
  return ""
}

// Why a fused `get ?? d` is malformed, or "": as a fused pop, it reads a list of a scalar element
// into an out at that element's rep.
function coalListGetOrWhy(n: SCoalBox): string {
  const lr = repNodeAt(opRep(n.cbL))
  if !(lr is RList) { return "a `get ?? d` reads no list" }
  if !scalarListElem(lr.rlsElem) {
    return "a `get ?? d` reads a list of no scalar element"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length || vf.irVars[o].vRep != lr.rlsElem {
    return "a `get ?? d` yields no element"
  }
  return ""
}

// Whether element rep `e` is one a fused list read leaves on the stack: a number, a `boolean`, or
// a literal-union atom, whose i32 id legacy reads as a scalar.
function scalarListElem(e: i32): boolean {
  const p = repPrim(e)
  return p != null
    && (p == "i32" || p == "i64" || p == "f64" || p == "f32" || p == "bool")
    || repNodeAt(e) is RAtom
}

// The value rep of map rep `mrep`, or -1 for no map.
function mapValOf(mrep: i32): i32 {
  const mr = repNodeAt(mrep)
  return if mr is RMap { mr.rmVal } else { -1 }
}

// Why a fused map read whose default computes is ill-formed, or "": it probes a map receiver by a
// key along an inline form, `i32` (1), mv (2), a scalar union value's (3), a ref niche's (4) or a union box's (5), into an out of the read's
// own rep.
function coalMapGetOrWhy(n: SCoalBox, id: i32): string {
  const mp = n.cbMap
  if mp == null { return "a fused map read holds no probe" }
  use(mp.prKey, id)
  if !mapRecvOk(mp.prSym, n.cbL, id) {
    return "a map read of a receiver that is no map"
  }
  if mp.prForm < 1 || mp.prForm > 6 {
    return "a fused map read writes its default in no miss arm"
  }
  const o = n.cbOut
  if o < 0 || o >= vf.irVars.length {
    return "a fused map read writes no variable"
  }
  const p = repPrim(vf.irVars[o].vRep)
  if (mp.prForm == 1 || mp.prForm == 6) && !repHeldAsI32(vf.irVars[o].vRep) {
    return "a map read's plain probe yields no i32"
  }
  // The mv slot's read is the map's value as itself, so its out is at that value's rep.
  const mr = repNodeAt(
    if mp.prSym >= 0 { irGlobalRepOf(vf, mp.prSym) } else { opRep(n.cbL) },
  )
  if mp.prForm == 2 && (!(mr is RMap) || mr.rmVal != vf.irVars[o].vRep) {
    return "a map read's mv slot yields no value of its map"
  }
  // A boxed nullable union's read is its box.
  if (
    mp.prForm == 5
    && !mapBoxReadsAt(
      if mp.prSym >= 0 { irGlobalRepOf(vf, mp.prSym) } else { opRep(n.cbL) },
      vf.irVars[o].vRep,
    )
  ) {
    return "a map read's union box yields no value of its map"
  }
  // A ref niche's read is its non-null value.
  if (
    mp.prForm == 4
    && !mapNicheReadsAt(
      if mp.prSym >= 0 { irGlobalRepOf(vf, mp.prSym) } else { opRep(n.cbL) },
      vf.irVars[o].vRep,
    )
  ) {
    return "a map read's niche yields no value of its map"
  }
  // A union value's read peels to its scalar.
  if mp.prForm == 3 && (!(mr is RMap) || p == null) {
    return "a map read's union value peels to no scalar"
  }
  return ""
}

function nested(body: i32[]) {
  const nDefs = vfDefLog.length
  let prev = -1
  for id in body {
    stmt(id, prev)
    prev = id
  }
  printOpenPairs(body)
  while vfDefLog.length > nDefs {
    const d = vfDefLog.pop() ?? -1
    if d >= 0 && d < vfDefined.length { vfDefined[d] = false }
  }
  return 0
}

// Fails rule 10 where body `body`'s print opens do not pair (`printOpenPairsWhy`): its own frame,
// so the recursive body walk carries no slot for it.
function printOpenPairs(body: i32[]) {
  const po = printOpenPairsWhy(body)
  if po != "" { fail(10, -1, po) }
  return 0
}

// Why body `body`'s print opens (`RPrintOpen`) do not pair, or "": each is closed later in the same
// body by the one print whose `pnOpened` is its arm, with no other print, `return` or branch
// between them, and no print claims an open that is not there.
function printOpenPairsWhy(body: i32[]): string {
  let open = -1
  for id in body {
    const n = vf.irNodes[id]
    if n is SEffect && n.efRhs is RPrintOpen {
      if open >= 0 { return "a print's blocks open inside another's" }
      open = n.efRhs.poArm
    } else if n is SEffect && n.efRhs is RPrint {
      const o = n.efRhs.pnOpened
      if o >= 0 && o != open {
        return "an opened print has no open of its arm before it"
      }
      if o < 0 && open >= 0 {
        return "a print's open is closed by another print"
      }
      open = -1
    } else if open >= 0 && (n is SReturn || n is SBr) {
      return "a print's open is left before its print"
    }
  }
  return if open >= 0 { "a print's open is never closed" } else { "" }
}

// Whether `out` is held in a box: a value `if` written at a box (`siAtDst`) writes one, and each
// arm's assignment then delivers at that box's rep.
function atBoxOut(out: i32): boolean {
  if out < 0 || out >= vf.irVars.length { return false }
  const r = repNodeAt(vf.irVars[out].vRep)
  return r is RBox || r is RNullable && r.rnDisc == 4
}

// An `if` and every `if` its `else` bodies hold, checked along the spine with one frame per open
// `else` rather than by recursing (D1990): a link's test and `then`, its `else` in order, then its
// arms' writes, as `nested` would order them.
function ifSpine(id0: i32) {
  const links: i32[] = []
  const pos: i32[] = []
  const defs: i32[] = []
  let next = id0
  while true {
    if next >= 0 {
      const h = vf.irNodes[next]
      if h is SIf {
        use(h.siCond, next)
        if opRep(h.siCond) != vfBool {
          fail(2, next, "an `if` tests a bool")
        } else if h.siAtDst && !atBoxOut(h.siOut) {
          fail(2, next, "an `if` written at a box writes no box")
        } else {
          nested(h.siThen)
          links.push(next)
          pos.push(0)
          defs.push(vfDefLog.length)
        }
      }
    }
    next = -1
    if links.length == 0 { return 0 }
    const top = links.length - 1
    const ln = vf.irNodes[links[top]]
    if !(ln is SIf) {
      return fail(5, links[top], "a spine link is not an `if`")
    }
    if pos[top] < ln.siElse.length {
      const c = ln.siElse[pos[top]]
      pos[top] = pos[top] + 1
      if (
        vfRule == 0
        && c >= 0
        && c < vf.irNodes.length
        && vf.irNodes[c] is SIf
      ) {
        nodeRepClosed(c)
        next = c
      } else {
        stmt(c, if pos[top] > 1 { ln.siElse[pos[top] - 2] } else { -1 })
      }
    } else {
      while vfDefLog.length > defs[top] {
        const d = vfDefLog.pop() ?? -1
        if d >= 0 && d < vfDefined.length { vfDefined[d] = false }
      }
      endsWriting(ln.siThen, ln.siOut, links[top])
      endsWriting(ln.siElse, ln.siOut, links[top])
      links.pop()
      pos.pop()
      defs.pop()
    }
  }
}

// Whether `v` is a declared binding, the one a loop value's frame carries out through.
function declaredVar(v: i32): boolean {
  return v >= 0
    && v < vf.irVars.length
    && vf.irVars[v].vKind != "temp"
    && vf.irVars[v].vSlot >= 0
}

function labelled(label: i32, out: i32, body: i32[]) {
  vfLabels.push(label)
  vfLabelOut.push(out)
  nested(body)
  vfLabels.pop()
  vfLabelOut.pop()
  return 0
}

// Why a box stash `??` is malformed, or "": its operand is the box the shared slot holds, a null
// one's null its tag.
function coalBoxStashWhy(n: SCoalBox): string {
  const r = repNodeAt(opRep(n.cbL))
  if !(r is RBox) && !(r is RNullable && r.rnDisc == 4) {
    return "a box stash `??` reads a box"
  }
  return ""
}

// A `??`'s checks: its operand block, operand, out, arm and default. Its own frame, so `stmt`'s
// per-level frame stays as small as its other arms need.
function coalBoxCheck(n: SCoalBox, id: i32) {
  // A fused map read's receiver is read by its probe, which may name a global instead.
  const mapArm = n.cbArm == "mapIndexGetOr" || n.cbArm == "optMapField"
  if (n.cbMap != null) != mapArm {
    return fail(2, id, "a `??` holds a map probe off the map-read arm")
  }
  if (
    n.cbLB.length > 0
    && n.cbArm != "nulRef"
    && n.cbArm != "nulStr"
    && n.cbArm != "asProp"
  ) {
    return fail(
      2,
      id,
      "a `??` builds its operand inside off the nullable-reference arm",
    )
  }
  // The operand block's definitions are seen by the operand, then dropped with the node.
  const nDefs = vfDefLog.length
  let lbPrev = -1
  for lid in n.cbLB {
    stmt(lid, lbPrev)
    lbPrev = lid
  }
  if !mapArm { use(n.cbL, id) }
  const ci = n.cbIdx
  if ci != null {
    if n.cbArm != "listGetOr" {
      return fail(2, id, "a `??` holds a `.get` index off the list-read arm")
    }
    use(ci, id)
  }
  if n.cbOut < 0 || n.cbOut >= vf.irVars.length {
    return fail(4, id, "a boxed `??` writes no variable")
  }
  const why = match n.cbArm {
    "popOr" => coalPopOrWhy(n)
    "listGetOr" => coalListGetOrWhy(n)
    "mapIndexGetOr" => coalMapGetOrWhy(n, id)
    "nulRef" => coalNulRefWhy(n)
    "litUnion" | "nulBool" => coalNicheWhy(n)
    "fieldBox" | "fieldVal" => coalFieldWhy(n)
    "optLeaf" => coalOptLeafWhy(n)
    "optBoxLeaf" => coalOptBoxLeafWhy(n)
    "optRecLeaf" => coalOptRecLeafWhy(n)
    "optMapField" => coalOptMapFieldWhy(n, id)
    "nulAtomJoin" => coalNulAtomJoinWhy(n)
    "nulBoolJoin" => coalNulBoolJoinWhy(n)
    "boxStash" => coalBoxStashWhy(n)
    "boxFieldScalar" => coalBoxFieldScalarWhy(n)
    "nulStr" => coalNulStrWhy(n)
    "asProp" => coalAsPropWhy(n)
    "boolPop" | "valBox" | "valScalar" | "valNoKind" | "elem" | "callBox" | "callScalar" | "callNoKind" | "next" => coalBoxWhy(n)
  }
  if why != "" { return fail(2, id, why) }
  nested(n.cbNull)
  endsWriting(n.cbNull, n.cbOut, id)
  while vfDefLog.length > nDefs {
    const d = vfDefLog.pop() ?? -1
    if d >= 0 && d < vfDefined.length { vfDefined[d] = false }
  }
  return 0
}

// An arm write's checks: its box, and per arm a local payload variable and its store's body.
function armWriteCheck(n: SArmWrite, id: i32) {
  use(n.awV, id)
  if !boxShaped(opRep(n.awV)) {
    return fail(2, id, "an arm write stores through a union box")
  }
  if n.awArms.length == 0 || n.awArms.length != n.awVars.length {
    return fail(2, id, "an arm write has a payload per arm")
  }
  for v in n.awVars {
    if v < 0 || v >= vf.irVars.length || vf.irVars[v].vKind != "local" {
      return fail(4, id, "an arm write's payload is a local")
    }
  }
  for a in n.awArms { nested(a) }
  return 0
}

// An arm-site read's checks: its box, then at most an index or key, and per arm a payload variable
// and a body that writes the out.
function armSiteCheck(n: SArmSite, id: i32) {
  for o in n.saOps { use(o, id) }
  if n.saOps.length < 1 || n.saOps.length > 2 || !boxShaped(opRep(n.saOps[0])) {
    return fail(
      2,
      id,
      "an arm-site read takes a union box, then at most an index or key",
    )
  }
  if n.saOps.length == 2 {
    const kr = opRep(n.saOps[1])
    if kr != vfI32 && kr != vfStr {
      return fail(
        2,
        id,
        "an arm-site read's index is an i32 and its key a string",
      )
    }
  }
  if n.saOut < 0 || n.saOut >= vf.irVars.length {
    return fail(4, id, "an arm-site read writes no variable")
  }
  if n.saArms.length == 0 || n.saArms.length != n.saVars.length {
    return fail(2, id, "an arm-site read has a payload per arm")
  }
  for v in n.saVars {
    if v < 0 || v >= vf.irVars.length || vf.irVars[v].vKind != "local" {
      return fail(4, id, "an arm-site arm's payload is a local")
    }
  }
  for a in n.saArms {
    nested(a)
    endsWriting(a, n.saOut, id)
  }
  return 0
}

// Checks node `id`, the node before it in its body `prev` (-1 for the first).
function stmt(id: i32, prev: i32) {
  if vfRule != 0 { return 0 }
  if id < 0 || id >= vf.irNodes.length {
    return fail(5, id, "a body names no node")
  }
  nodeRepClosed(id)
  const n = vf.irNodes[id]
  match n {
    SLet => {
      const d = n.lDst
      if d < 0 || d >= vf.irVars.length {
        return fail(4, id, "defines no variable")
      }
      rhsCheck(n.lRhs, vf.irVars[d].vRep, id)
      const r = n.lRhs
      if r is RRawOp && r.rwOp == "push" {
        vfPushed.push(d)
        vfPushes[d] = true
      }
      if r is RCallRefHead { vfHeads[d] = true }
      if vf.irVars[d].vKind == "temp" {
        if vfDefined[d] {
          return fail(4, id, "defines temp v" + i32ToStr(d) + " twice")
        }
        vfDefined[d] = true
        vfDefLog.push(d)
      }
      if vf.irNodeRep[id] != vf.irVars[d].vRep {
        return fail(2, id, "the node's rep is not its destination's")
      }
      0
    }
    SAssign => {
      use(n.asSrc, id)
      if n.asDst < 0 || n.asDst >= vf.irVars.length {
        return fail(4, id, "assigns no variable")
      }
      if vf.irVars[n.asDst].vKind == "temp" {
        return fail(4, id, "assigns temp v" + i32ToStr(n.asDst))
      }
      if opRep(n.asSrc) != vf.irVars[n.asDst].vRep {
        return fail(2, id, "an assignment needs a coercion")
      }
      0
    }
    SSetField => {
      use(n.sfV, id)
      use(n.sfSrc, id)
      const r = opRep(n.sfV)
      if !(repNodeAt(r) is RRecord) {
        return fail(2, id, "a field write's rep is not the field's")
      }
      // A sub-word field (`repSubWord`) takes a plain i32, which `struct.set` truncates.
      const k = kidAt(r, n.sfIx)
      if k != opRep(n.sfSrc) && !(repSubWord(k) && opRep(n.sfSrc) == vfI32) {
        return fail(2, id, "a field write's rep is not the field's")
      }
      0
    }
    SListSet => {
      use(n.lsV, id)
      use(n.lsIx, id)
      use(n.lsSrc, id)
      const l = opRep(n.lsV)
      // A packed list's element is stored as a plain i32, which its backing truncates.
      const ln = repNodeAt(l)
      // A `null[]` list's element is its i32 storage's sentinel (`emitIdxStoreValue`).
      const asI32 = ln is RList
        && (repPrim(ln.rlsElem) == "u8"
        || repPrim(ln.rlsElem) == "null")
      const want = if asI32 { vfI32 } else { kidAt(l, 0) }
      if (!(ln is RList) || opRep(n.lsIx) != vfI32 || want != opRep(n.lsSrc)) {
        return fail(2, id, "an element write's reps do not match the list")
      }
      0
    }
    SCellSet => {
      use(n.csCell, id)
      use(n.csSrc, id)
    }
    SGlobalSet => {
      use(n.gsSrc, id)
      const g = irGlobalRepOf(vf, n.gsSym)
      if g < 0 { return fail(2, id, "writes a global with no recorded rep") }
      // A source that stores as the cell's valtype (`vfStoresAs`) needs no coercion, nor does a
      // reference stored into its own ref niche (`vfNicheTakes`).
      if (
        opRep(n.gsSrc) != g
        && !repNullRefFits(opRep(n.gsSrc), g)
        && !vfStoresAs(g, opRep(n.gsSrc))
        && !vfNicheTakes(g, opRep(n.gsSrc))
      ) {
        return fail(2, id, "a global store needs a coercion")
      }
      0
    }
    SBoundsCheck => {
      use(n.bcV, id)
      use(n.bcIx, id)
      0
    }
    SEffect => rhsCheck(n.efRhs, -1, id)
    SBlock => {
      if n.bkOut >= 0 && !vf.irHelper && !declaredVar(n.bkOut) {
        return fail(10, id, "a valued block outside a runtime helper")
      }
      labelled(n.bkLabel, n.bkOut, n.bkBody)
      endsWriting(n.bkBody, n.bkOut, id)
    }
    SLoop => labelled(n.lpLabel, -1, n.lpBody)
    SForIn => {
      // A map walk's list is an unread immediate when its map is a global the lowering reads,
      // else its receiver at a map rep.
      if n.xfMap < 0 { use(n.xfList, id) }
      const ln = repNodeAt(opRep(n.xfList))
      const recvMap = n.xfMap < 0 && mapRepOrNullable(opRep(n.xfList))
      // A list walks its elements, a packed byte read unsigned into an i32; a string its code
      // points, each an i32.
      let er = -1
      if ln is RList {
        er = if repPrim(ln.rlsElem) == "u8" { vfI32 } else { ln.rlsElem }
      }
      if opRep(n.xfList) == vfStr { er = vfI32 }
      // A map walks its values into an i32 or a string, or at the rep its receiver's map stores
      // them at (the global's own rep, or the receiver operand's); its keys at the key rep the walk
      // records, which must be one a map key is held at.
      if (n.xfMap >= 0 || recvMap) {
        if n.xfVals {
          const mrep = if n.xfMap >= 0 { irGlobalRepOf(vf, n.xfMap) } else { opRep(n.xfList) }
          er = mapWalkValRep(mrep)
          if n.xfVar >= 0 && n.xfVar < vf.irVars.length {
            const vr = vf.irVars[n.xfVar].vRep
            if vr == vfI32 || vr == vfStr { er = vr }
          }
        } else {
          er = if mapKeyRep(n.xfKeyRep) { n.xfKeyRep } else { -1 }
        }
      }
      if n.xfVar < 0 || n.xfVar >= vf.irVars.length || er < 0 {
        return fail(
          2,
          id,
          "a walk is not of a list, a string or a map into a variable",
        )
      }
      if vf.irVars[n.xfVar].vKind != "local" || vf.irVars[n.xfVar].vRep != er {
        return fail(
          2,
          id,
          "a walk's variable is not a local of its element rep",
        )
      }
      // A second name is a local index, or a map walk's value, whose rep rule 3 ties to its type.
      const v2 = n.xfVar2
      if v2 >= 0 && (v2 >= vf.irVars.length || vf.irVars[v2].vKind != "local") {
        return fail(2, id, "a walk's second name is not a local")
      }
      if v2 >= 0 {
        const pr = vf.irVars[v2].vRep
        if pr != vfI32 && n.xfMap < 0 && !recvMap {
          return fail(
            2,
            id,
            "a walk's second name is not an index or a map's value",
          )
        }
      }
      vfLabels.push(n.xfBrk)
      vfLabelOut.push(-1)
      labelled(n.xfCont, -1, n.xfBody)
      vfLabels.pop()
      vfLabelOut.pop()
    }
    SRangeLoop => {
      const v = n.rlVar
      if (
        v < 0
        || v >= vf.irVars.length
        || vf.irVars[v].vKind != "local"
        || vf.irVars[v].vRep != vfI32
      ) {
        return fail(2, id, "a range loop's variable is not an i32 local")
      }
      // The lowering checks the copy count against legacy's plan; here each copy has its label.
      if (
        n.rlConts.length != n.rlCopies.length
        || !n.rlPartial && n.rlCopies.length > 0
      ) {
        return fail(2, id, "a range loop's copies do not match its labels")
      }
      let k = 0
      while k < n.rlCopies.length {
        vfLabels.push(n.rlBrk)
        vfLabelOut.push(-1)
        labelled(n.rlConts[k], -1, n.rlCopies[k])
        vfLabels.pop()
        vfLabelOut.pop()
        k = k + 1
      }
      vfLabels.push(n.rlTailBrk)
      vfLabelOut.push(-1)
      labelled(n.rlTailCont, -1, n.rlTail)
      vfLabels.pop()
      vfLabelOut.pop()
    }
    SIf => ifSpine(id)
    SCoalBox => coalBoxCheck(n, id)
    SArmSite => armSiteCheck(n, id)
    SArmWrite => armWriteCheck(n, id)
    SSwitch => switchCheck(n, id)
    SIntSwitch => intSwitchCheck(n, id)
    SBr => {
      if (
        n.brHas
        && !vf.irHelper
        && !(n.brVal is OVar && declaredVar(n.brVal.ov))
      ) {
        return fail(10, id, "a valued branch outside a runtime helper")
      }
      let i = vfLabels.length - 1
      while i >= 0 {
        if vfLabels[i] == n.brLabel {
          const out = vfLabelOut[i]
          if out < 0 && n.brHas {
            return fail(
              5,
              id,
              "a branch carries a value its label has no place for",
            )
          }
          if out >= 0 {
            if !n.brHas {
              return fail(5, id, "a branch to a valued label carries none")
            }
            use(n.brVal, id)
            if opRep(n.brVal) != varRep(out) {
              return fail(5, id, "a branch's value is not its label's rep")
            }
          }
          return 0
        }
        i = i - 1
      }
      fail(
        5,
        id,
        "a branch to L" + i32ToStr(n.brLabel) + ", which does not enclose it",
      )
    }
    SReturn => {
      const none = repIsNoValue(vf.irRetRep)
      // A return right after a trap or a call that never returns is dead, so it carries no value
      // whatever the result.
      const dead = !n.rtHas && prev >= 0 && irNodeEndsPath(vf.irNodes[prev])
      if n.rtHas == none && !dead {
        return fail(
          5,
          id,
          "a return's value does not match the function's result",
        )
      }
      if n.rtHas {
        use(n.rtV, id)
        if (
          opRep(n.rtV) != vf.irRetRep
          && !vfOpenTakes(vf.irRetTy, vf.irRetRep, opRep(n.rtV))
          && !vfStoresAs(vf.irRetRep, opRep(n.rtV))
          && !repNullRefFits(opRep(n.rtV), vf.irRetRep)
          && !vfNicheTakes(vf.irRetRep, opRep(n.rtV))
        ) {
          return fail(2, id, "a return's rep is not the result's")
        }
      }
      0
    }
    STrap => 0
    SDrop => use(n.dpV, id)
    SRawOp => rawEff(n, id)
  }
  return 0
}

// Rule 7: an integer switch reads a 32-bit integer, or a 64-bit one when wide, and every table
// entry names an arm or the else.
function intSwitchCheck(n: SIntSwitch, id: i32) {
  use(n.isOn, id)
  const p = repPrim(opRep(n.isOn))
  if p == null { return fail(7, id, "an integer switch over a non-scalar") }
  const w = match p {
    "i32" | "u8" => 1
    "i64" => 2
    "bool" | "f64" | "f32" | "str" | "null" | "v128" => 0
  }
  if w == 0 { return fail(7, id, "an integer switch over a non-integer") }
  if (w == 2) != n.isWide {
    return fail(7, id, "an integer switch's width is not its scrutinee's")
  }
  for t in n.isTable {
    if t < 0 || t > n.isArms.length {
      return fail(7, id, "a table entry names no arm")
    }
  }
  for a in n.isArms {
    nested(a)
    endsWriting(a, n.isOut, id)
  }
  nested(n.isElse)
  endsWriting(n.isElse, n.isOut, id)
  return 0
}

// Rule 7: each arm of the scrutinee's box is covered once, or a default names what it excludes.
function switchCheck(n: SSwitch, id: i32) {
  const on = varRep(n.swOn)
  if !(repNodeAt(on) is RBox) { return fail(7, id, "a switch over a non-box") }
  const nArms = repNodeKids(on).length
  const seen: boolean[] = []
  let i = 0
  while i < nArms {
    seen.push(false)
    i = i + 1
  }
  let dflt = false
  for a in n.swArms {
    if a.swArm < 0 {
      if a.swWhy == "" {
        return fail(7, id, "a default arm names nothing it excludes")
      }
      if dflt { return fail(7, id, "a second default arm") }
      dflt = true
    } else if a.swArm >= nArms || seen[a.swArm] {
      return fail(
        7,
        id,
        "arm " + i32ToStr(a.swArm) + " is out of range or repeated",
      )
    } else {
      seen[a.swArm] = true
    }
    nested(a.swBody)
    endsWriting(a.swBody, n.swOut, id)
  }
  if dflt { return 0 }
  for s in seen {
    if !s { return fail(7, id, "an arm of the scrutinee is not covered") }
  }
  return 0
}

// Rule 1: whether `r` is a node of the tree and not an unsupported one.
function closedRep(r: i32): boolean {
  const n = repNodeAt(r)
  if n == null { return false }
  return !(n is RUnsup)
}

// Rule 1 for a node: its rep is a closed one in the tree.
function nodeRepClosed(id: i32) {
  const r = vf.irNodeRep[id]
  if !closedRep(r) {
    return fail(1, id, "the node's rep is " + repWhat(r) + ", not a closed rep")
  }
  return 0
}

// The uninstalled bounds rule: no list access may pass unchecked, so any one fails.
function boundsNone(f: IrFn): string {
  for n in f.irNodes {
    if touchesList(n) { return "bounds rule not installed" }
  }
  return ""
}

// Whether node `n` reads or writes a list element, or checks a bound.
function touchesList(n: IrNode): boolean {
  return match n {
    SListSet | SBoundsCheck => true
    SLet => rhsReadsList(n.lRhs)
    SEffect => rhsReadsList(n.efRhs)
    SArmSite |
      SArmWrite |
      SAssign |
      SBlock |
      SBr |
      SCellSet |
      SCoalBox |
      SDrop |
      SForIn |
      SGlobalSet |
      SIf |
      SIntSwitch |
      SLoop |
      SRangeLoop |
      SRawOp |
      SReturn |
      SSetField |
      SSwitch |
      STrap => false
  }
}

// A SIMD load's address at i32 and its result at v128; a store's address and vector, and no value.
function simdMemCheck(r: RSimd, dst: i32, at: i32, base: i32) {
  const a = r.sdArgs
  if a.length != base || repPrim(opRep(a[0])) != "i32" {
    return fail(2, at, "a SIMD access's address is an i32")
  }
  if base == 2 && repPrim(opRep(a[1])) != "v128" {
    return fail(2, at, "a SIMD store's value is a v128")
  }
  if dst >= 0 && (base == 2 || repPrim(dst) != "v128") {
    return fail(2, at, "a SIMD load is a v128 and a store has no value")
  }
  return 0
}

// A memory access's address at i32, a store's value at its width's prim (`memAccessPlanOf`), and a
// load's result at that prim; a store has no value.
function memAccessCheck(r: RMemAccess, dst: i32, at: i32) {
  uses(r.mmArgs, at)
  const a = r.mmArgs
  if r.mmBase < 1 || a.length != r.mmBase || opRep(a[0]) != vfI32 {
    return fail(2, at, "a memory access's address is an i32")
  }
  if r.mmBase == 2 && repPrim(opRep(a[1])) != r.mmPrim {
    return fail(2, at, "a memory store's value is at its width's prim")
  }
  if dst >= 0 && (r.mmBase == 2 || repPrim(dst) != r.mmPrim) {
    return fail(
      2,
      at,
      "a memory load is at its width's prim and a store has no value",
    )
  }
  return 0
}

// A declaration-time address fold's initializer: an i32 bounded part, kept in a declared wasm
// local, and an i32 value.
function maFoldInitCheck(r: RMaFoldInit, dst: i32, at: i32) {
  use(r.mfiV, at)
  if opRep(r.mfiV) != vfI32 || r.mfiSlot < 0 {
    return fail(2, at, "an address fold keeps an i32 in a declared local")
  }
  if dst >= 0 && dst != vfI32 {
    return fail(2, at, "an address fold is an i32")
  }
  return 0
}

// A function-value compare's two operands at closure reps, and its 0/1 answer a bool.
function closureEqCheck(r: RClosureEq, dst: i32, at: i32) {
  use(r.cqL, at)
  use(r.cqR, at)
  if (
    !(repNodeAt(opRep(r.cqL)) is RClosure)
    || !(repNodeAt(opRep(r.cqR)) is RClosure)
  ) {
    return fail(2, at, "a function-value compare's operands are closures")
  }
  if dst >= 0 && repPrim(dst) != "bool" {
    return fail(2, at, "a function-value compare is a bool")
  }
  return 0
}

// A reference identity's two operands at references no string or scalar is, and its 0/1 answer
// a bool: the check refuses identity over a value with none.
function identityEqCheck(r: RIdentityEq, dst: i32, at: i32) {
  use(r.ieL, at)
  use(r.ieR, at)
  for o in [r.ieL, r.ieR] {
    const or = opRep(o)
    if repIsScalar(or) || repPrim(or) == "str" || repPrim(or) == "bool" {
      return fail(2, at, "an identity compare's operands are references")
    }
  }
  if dst >= 0 && repPrim(dst) != "bool" {
    return fail(2, at, "an identity compare is a bool")
  }
  return 0
}

// A guarded nullable compare's two operands at reference reps, and its 0/1 answer a bool.
function nulNicheEqCheck(r: RNulNicheEq, dst: i32, at: i32) {
  use(r.neL, at)
  use(r.neR, at)
  use(r.neR2, at)
  if repIsScalar(opRep(r.neL)) || repIsScalar(opRep(r.neR)) {
    return fail(2, at, "a guarded nullable compare's operands are references")
  }
  if opRep(r.neR2) != opRep(r.neR) {
    return fail(
      2,
      at,
      "a guarded nullable compare writes its right operand twice at one rep",
    )
  }
  if dst >= 0 && repPrim(dst) != "bool" {
    return fail(2, at, "a guarded nullable compare is a bool")
  }
  return 0
}

// An atomic's address at i32, each value at `atomicValPrim`, and its result at `atomicResultPrim`
// (a store and a fence have no value).
function atomicCheck(r: RAtomic, dst: i32, at: i32) {
  uses(r.amArgs, at)
  const a = r.amArgs
  if r.amBase < 0 || a.length != r.amBase || r.amValPrims.length < a.length {
    return fail(2, at, "an atomic takes its plan's operands")
  }
  if a.length > 0 && opRep(a[0]) != vfI32 {
    return fail(2, at, "an atomic's address is an i32")
  }
  let k = 1
  while k < a.length {
    if repPrim(opRep(a[k])) != r.amValPrims[k] {
      return fail(2, at, "an atomic's value is at its row's prim")
    }
    k = k + 1
  }
  const res = r.amResPrim
  if dst >= 0 && (res == "" || repPrim(dst) != res) {
    return fail(2, at, "an atomic's result is at its row's prim")
  }
  return 0
}

// A saturating truncation's operand at its float prim and its result at its integer prim.
function truncSatCheck(r: RTruncSat, dst: i32, at: i32) {
  use(r.tsV, at)
  const c = nodeAt(r.tsAt)
  if !(c is Call) { return fail(2, at, "a saturating truncation is a call") }
  if r.tsOp < 0 || repPrim(opRep(r.tsV)) != r.tsFrom {
    return fail(2, at, "a saturating truncation's operand is at its float prim")
  }
  if dst >= 0 && repPrim(dst) != r.tsTo {
    return fail(
      2,
      at,
      "a saturating truncation's result is at its integer prim",
    )
  }
  return 0
}

// A SIMD op's operands and result at the prims the builder planned from its row (`sdPrims`,
// `sdResPrim`), a lane or shuffle index being an immediate and no operand.
function simdCheck(r: RSimd, dst: i32, at: i32) {
  uses(r.sdArgs, at)
  if r.sdMemBase > 0 { return simdMemCheck(r, dst, at, r.sdMemBase) }
  if r.sdPrims.length != r.sdArgs.length {
    return fail(2, at, "a SIMD op's operands are at its row's prims")
  }
  let k = 0
  while k < r.sdArgs.length {
    if repPrim(opRep(r.sdArgs[k])) != r.sdPrims[k] {
      return fail(2, at, "a SIMD op's operands are at its row's prims")
    }
    k = k + 1
  }
  const rp = r.sdResPrim
  if (
    dst >= 0
    && (rp == "" || repPrim(dst) != rp && !(rp == "i32" && repPrim(dst) == "bool"))
  ) {
    return fail(2, at, "a SIMD op's result is at its row's prim")
  }
  return 0
}

function rhsReadsList(r: Rhs): boolean {
  return match r {
    RListGet => true
    RAfterEffects |
      RArmUnbox |
      RAsTail |
      RAsUnion |
      RAsgParked |
      RAsgUnwiden |
      RAtomEq |
      RAtomSole |
      RAtomStr |
      RAtomWide |
      RAtomic |
      RBoxField |
      RBoxNarrow |
      RBundlePick |
      RCall |
      RCallHost |
      RCallRef |
      RCallRefHead |
      RCast |
      RCellGet |
      RCellNew |
      RClosureEq |
      RCoalAtomStr |
      RCoalStr |
      RCoerce |
      RDeadNever |
      RDeadNullTest |
      REnvDrop |
      REnvGet |
      REqHelp |
      RFieldNull |
      RFnId |
      RGetField |
      RGlobalGet |
      RHandPick |
      RHolderPick |
      RHoleOptBox |
      RIdentityEq |
      RInitProgress |
      RIsStaged |
      RJoinNull |
      RListCat |
      RListClear |
      RListCopy |
      RListEmpty |
      RListEmptyArms |
      RListEq |
      RListFitIs |
      RListIsAcross |
      RListLen |
      RListNew |
      RListNewDefault |
      RListPop |
      RListPush |
      RListPushMany |
      RListSlice |
      RListStage |
      RLitArms |
      RMaFoldInit |
      RMakeClo |
      RMakeList |
      RMakeRec |
      RMapClear |
      RMapDelete |
      RMapEq |
      RMapFilter |
      RMapGet |
      RMapGetOr |
      RMapHas |
      RMapIter |
      RMapNew |
      RMapOp |
      RMapSet |
      RMemAccess |
      RMemOp |
      RNicheRead |
      RNulNicheEq |
      RNulNoneBox |
      RNulTest |
      RNullOf |
      RNumCast |
      RNumIntr |
      RNumIs |
      RNumUnionBin |
      RNumUnionConvert |
      RNumWiden |
      ROptRead |
      RPrimOp |
      RPrint |
      RPrintOpen |
      RRawOp |
      RRecCopyPure |
      RRecDown |
      RRecordFitIs |
      RRecover |
      RRel |
      RResultPick |
      RRetNull |
      RRetag |
      RSharedFieldSet |
      RSharedRead |
      RSimd |
      RSpread |
      RStage |
      RStashSet |
      RStrOp |
      RStrToAtom |
      RStrToAtomStaged |
      RStructEq |
      RTagIs |
      RTagOf |
      RTagStash |
      RTest |
      RToBox |
      RTruncSat |
      RUnionConcreteEq |
      RUnionEq |
      RUnionNumCrossEq |
      RUnionStage |
      RUnionStagedEq |
      RUnionVariantEq |
      RVariantChain |
      RVariantDiscrim => false
  }
}

// The push a statement or temp `id` of `f` is, or null.
function pushAt(f: IrFn, id: i32): RListPush | null {
  if id < 0 || id >= f.irNodes.length { return null }
  const n = f.irNodes[id]
  const r = if n is SEffect { n.efRhs } else if n is SLet { n.lRhs } else { null }
  if r is RListPush { return r }
  return null
}

// The stage rule over `f`: "" when each receiver stage is named by exactly one push of its call,
// later in the stage's own body, else what broke.
function stagePairsWhy(f: IrFn): string {
  const bodies: i32[][] = [f.irBody]
  const pos: i32[] = [0]
  const open: i32[][] = [[]]
  while bodies.length > 0 {
    const top = bodies.length - 1
    const body = bodies[top]
    const i = pos[top]
    if i >= body.length {
      if open[top].length > 0 {
        return "node "
          + i32ToStr(open[top][0])
          + ": a receiver stage no push names"
      }
      bodies.pop()
      pos.pop()
      open.pop()
      continue
    }
    pos[top] = i + 1
    const id = body[i]
    if stageAt(id) != null { open[top].push(id) }
    const p = pushAt(f, id)
    if p != null {
      const v = p.lpV
      if v is PStaged {
        const rest: i32[] = []
        for o in open[top] {
          if o != v.pstNode { rest.push(o) }
        }
        if rest.length == open[top].length {
          return "node "
            + i32ToStr(id)
            + ": a staged push whose stage is not open before it in its body"
        }
        open[top] = rest
      }
    }
    irPushBodies(f, id, bodies, pos)
    while open.length < bodies.length { open.push([]) }
  }
  return ""
}

// Why a box whose head the lowering writes ahead of a dispatch (`irBoxLeadFirst`) does not directly
// follow that dispatch's nodes in one body, or "": a node between would land above the head.
function boxLeadsWhy(f: IrFn): string {
  const bodies: i32[][] = [f.irBody]
  const pos: i32[] = [0]
  let found = 0
  while bodies.length > 0 {
    const top = bodies.length - 1
    const body = bodies[top]
    const i = pos[top]
    if i >= body.length {
      bodies.pop()
      pos.pop()
      continue
    }
    pos[top] = i + 1
    const id = body[i]
    let k = 0
    while k < f.irBoxLeadBox.length {
      if f.irBoxLeadBox[k] == id {
        const n = f.irBoxLeadN[k]
        if n < 1 || i < n || body[i - n] != f.irBoxLeadFirst[k] {
          return "node "
            + i32ToStr(id)
            + ": a led box does not directly follow its dispatch"
        }
        found = found + 1
      }
      k = k + 1
    }
    irPushBodies(f, id, bodies, pos)
  }
  if found != f.irBoxLeadBox.length { return "a led box no body holds" }
  return ""
}

// The bounds rule, installed with the list builder; it answers "" or what broke, naming the node.
// Whether a map get of value rep `val` may deliver into `dst`: the value itself, or it nullable.
function mapGetDstOk(val: i32, dst: i32): boolean {
  if dst == val { return true }
  const n = repNodeAt(dst)
  // Narrowed, a value that is itself a ref niche reads as the record inside it, and an atom's
  // `-1` niche as the bare atom.
  const v = repNodeAt(val)
  return n is RNullable && n.rnInner == val
    || v is RNullable && (v.rnDisc == 1 || v.rnDisc == 3) && v.rnInner == dst
}

export let irBoundsRuleHook: (f: IrFn) => string = boundsNone

// Whether type `ty` is no closed type a variable can have (rule 1): absent, or open in a type
// parameter. The builder asks it first, so such a function is uncovered rather than refused.
export function irTyOpen(ty: i32): boolean { return ty < 0 || tyHasTyVar(ty) }

// Whether variable `i` of `vf` is open (rule 1): of an open type whose open parts the builder did
// not find held at a rep no instance changes (`irVarHeldIds`), and no untyped closure.
function vfHeldOpen(i: i32, ty: i32, rep: i32): boolean {
  if irUntypedClosure(ty, rep) { return false }
  return irTyOpen(ty) && !(vf.irVarHeldIds[i] ?? false)
}

// Whether a variable is a closure no arena type spells (a generic's instance, built by
// `repClosureOfReps`): typed -1 at an interned closure rep of no type, which its calls are checked
// against, as a function held at a closure rep is (`tyOpenHeldAsIds`).
export function irUntypedClosure(ty: i32, rep: i32): boolean {
  return ty < 0 && repNodeAt(rep) is RClosure && repTyOf(rep) < 0
}

// Whether a destination of open type `ty` at rep `rep` takes a value of rep `v` as it stands: both
// are stored at the same valtype, as the builder noted them (`irRepValtype`).
function vfOpenTakes(ty: i32, rep: i32, v: i32): boolean {
  return irTyOpen(ty) && vfStoresAs(rep, v)
}

// Whether a ref-niche nullable `r` holds a value of rep `v` as it stands: its inner rep, or one
// the builder noted stored at the inner's valtype.
function vfNicheTakes(r: i32, v: i32): boolean {
  const n = repNodeAt(r)
  return n is RNullable
    && n.rnDisc == 1
    && (n.rnInner == v || vfStoresAs(n.rnInner, v))
}

// Whether a value of rep `src` stands where rep `dst` is asked: both are stored at the valtype the
// builder noted for them (`irRepValtype`).
function vfStoresAs(dst: i32, src: i32): boolean {
  const a = vf.irRepValtype[dst] ?? []
  return a.length > 0 && u8sSame(a, vf.irRepValtype[src] ?? [])
}

// Whether a closure list at rep `src` that writes no valtype is the closure list at `dst` that
// writes one, as the builder noted them (`cloListUndeclaredTakes`).
function vfCloListUndeclared(src: i32, dst: i32): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  return a is RList
    && d is RList
    && repNodeAt(a.rlsElem) is RClosure
    && repNodeAt(d.rlsElem) is RClosure
    && vf.irRepValtype.has(src)
    && (vf.irRepValtype[src] ?? []).length == 0
    && (vf.irRepValtype[dst] ?? []).length > 0
}

// Whether record `r` is built at a variant's row, as `makeRec` lowers it.
export function recIsVariant(r: RMakeRec): boolean { return r.mrVariant }

// The site type kid `k` of record `r` at node `at` is delivered at, as the builder noted it per
// layout position (`irFactKidTy`), or -1.
function recKidSiteTy(r: RMakeRec, k: i32, at: i32): i32 {
  if r.mrBuiltRow < 0 { return -1 }
  let fi = 0
  while fi < r.mrLayout.length && r.mrLayout[fi] != k { fi = fi + 1 }
  const tys = irFactKidTyOf(vf, at)
  return if fi < tys.length { tys[fi] } else { -1 }
}

// Whether byte lists `a` and `b` are equal.
export function u8sSame(a: u8[], b: u8[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  return true
}

// Verifies `f`: rule 0 when it holds, else the first rule broken, its node and why.
export function irVerify(f: IrFn): IrVerdict {
  vf = f
  vfRule = 0
  vfAt = -1
  vfMsg = ""
  vfLabels = []
  vfLabelOut = []
  vfBool = repNodeOfTy(TY_BOOL)
  vfI32 = repNodeOfTy(TY_I32)
  vfStr = repNodeOfTy(TY_STR)
  vfDefined = []
  vfDefLog = []
  vfPushed = []
  vfPushes = Map()
  vfHeads = Map()
  vfHeadsRead = Map()
  vfStaged = false
  vfSetAt = []
  vfSetK = []
  vfSetRep = []
  let i = 0
  while i < f.irVars.length {
    const v = f.irVars[i]
    vfDefined.push(false)
    const untyped = irUntypedClosure(v.vTy, v.vRep)
    if (rawAt(v.vRep, -1) || v.vTy < 0) && !untyped {
      // A raw variable has no VL type, and only a helper holds one. One whose heap is not
      // tracked is a temp, on the stack between its read and its one use.
      if !f.irHelper || v.vTy >= 0 || !rawAt(v.vRep, -1) {
        fail(
          10,
          -1,
          "v" + i32ToStr(i) + " is raw outside a runtime helper, or typed",
        )
      } else if untracked(v.vRep) && v.vKind != "temp" {
        fail(
          10,
          -1,
          "v" + i32ToStr(i) + " holds an untracked raw value outside a temp",
        )
      }
    } else if !closedRep(v.vRep) {
      fail(
        1,
        -1,
        "v" + i32ToStr(i) + "'s rep is " + repWhat(v.vRep) + ", not a closed rep",
      )
    } else if vfHeldOpen(i, v.vTy, v.vRep) {
      fail(1, -1, "v" + i32ToStr(i) + "'s type is open")
    } else if (
      !untyped
      && repNodeOfTy(v.vTy) != v.vRep
      && !neverCallTemp(f, i)
      && !loneLitAtom(v.vTy, v.vRep)
    ) {
      fail(3, -1, "v" + i32ToStr(i) + "'s rep is not its type's")
    }
    i = i + 1
  }
  if !closedRep(f.irRetRep) {
    fail(
      1,
      -1,
      "the result's rep is " + repWhat(f.irRetRep) + ", not a closed rep",
    )
  }
  let prev = -1
  for id in f.irBody {
    stmt(id, prev)
    prev = id
  }
  printOpenPairs(f.irBody)
  // Rule 8, the bounds checks, is the list builder's (`ir_verify_bounds.vl`).
  if vfRule == 0 {
    const b = irBoundsRuleHook(f)
    if b != "" { fail(8, -1, b) }
  }
  if vfRule == 0 && vfStaged {
    const sp = stagePairsWhy(f)
    if sp != "" { fail(10, -1, sp) }
  }
  if vfRule == 0 && f.irBoxLeadBox.length > 0 {
    const bl = boxLeadsWhy(f)
    if bl != "" { fail(10, -1, bl) }
  }
  if vfRule == 0 && vfSetAt.length > 0 {
    fail(2, -1, "a stash set no record reads")
  }
  if vfRule == 0 && vfPushed.length > 0 {
    fail(10, -1, "a push no store consumes")
  }
  // Rule 1 for a result typed by its rep (`irRetFromRep`): only a faithful thunk may carry one.
  if vfRule == 0 && f.irRetFromRep {
    const tw = thunkForwardWhy(f)
    if tw != "" { fail(1, -1, tw) }
  }
  // Rule 5 at the end: a function with a result leaves its body on every path, or falls into
  // the `null` or `unreachable` the lowering pads its end with, as legacy does.
  if (
    !repIsNoValue(f.irRetRep)
    && !irBodyLeaves(f, f.irBody)
    && f.irEndPad == ""
  ) {
    fail(5, -1, "a valued function falls off its end")
  }
  const v: IrVerdict = { vfRule: vfRule, vfNode: vfAt, vfMsg: vfMsg }
  return v
}

// Why function `f`, whose result type is its rep's own, is no faithful thunk, or "": one call of the
// callee its signature notes, on each parameter after the env at that signature's rep, in order,
// its value at the signature's result rep returned as it stands.
function thunkForwardWhy(f: IrFn): string {
  if !f.irThunk { return "a result typed by its rep outside a thunk" }
  if f.irBody.length != 2 {
    return "a rep-typed thunk is not one call and its return"
  }
  const n0 = f.irNodes[f.irBody[0]]
  const n1 = f.irNodes[f.irBody[1]]
  if !(n0 is SLet) || !(n1 is SReturn) {
    return "a rep-typed thunk is not one call and its return"
  }
  const c = n0.lRhs
  if !(c is RCall) || !n1.rtHas {
    return "a rep-typed thunk is not one call and its return"
  }
  const rv = n1.rtV
  if !(rv is OVar) || rv.ov != n0.lDst {
    return "a rep-typed thunk returns no call's value"
  }
  const si = irSigOf(f, c.caCallee)
  if si < 0 { return "a rep-typed thunk's callee has no signature" }
  const ps = f.irSigParams[si]
  if c.caArgs.length != ps.length || f.irParams.length != ps.length + 1 {
    return "a rep-typed thunk does not forward every parameter"
  }
  let i = 0
  while i < ps.length {
    const a = c.caArgs[i]
    if (
      !(a is OVar)
      || a.ov != f.irParams[i + 1]
      || f.irVars[a.ov].vRep != ps[i]
    ) {
      return "a rep-typed thunk does not forward its parameters in order at the callee's reps"
    }
    i = i + 1
  }
  const r = f.irSigRet[si]
  if f.irVars[n0.lDst].vRep != r || f.irRetRep != r {
    return "a rep-typed thunk's result is not its callee's"
  }
  return ""
}

// Whether a nullable of discipline `disc` over rep `inner` is a niche that holds its inner value
// unchanged: a `K | null` atom (3), a `boolean | null` (2, its null the sentinel 2), or a nullable
// ref (1) over a string, record, list, map or closure.
function nicheRetag(disc: i32, inner: i32): boolean {
  if disc == 3 { return true }
  if disc == 2 { return repPrim(inner) == "bool" }
  if disc != 1 { return false }
  const p = repPrim(inner)
  if p != null { return p == "str" }
  const n = repNodeAt(inner)
  return n is RRecord || n is RList || n is RMap || n is RClosure
}

// Whether rep `r` is a map, or a nullable one whose receiver a map walk recovers.
function mapRepOrNullable(r: i32): boolean {
  const n = repNodeAt(r)
  if n is RMap { return true }
  return n is RNullable && repNodeAt(n.rnInner) is RMap
}

// Whether rep `a` is rep `b` apart only in closure openness (`cloHoleRetag`), and, for two
// records, whose fields also lower alike over the noted heaps (`repsLowerAlike`), as one heap
// alone does not show for a field whose rep disagrees with its storage.
function cloHoleRetagAlike(a: i32, b: i32): boolean {
  if !cloHoleRetag(vf, a, b) { return false }
  const x = repNodeAt(a)
  const y = repNodeAt(b)
  return !(x is RRecord)
    || !(y is RRecord)
    || repsLowerAlike(a, b, vf.irRecHeap)
}

// Whether reps `a` and `b` are plain records on one struct heap the builder noted (`irRecHeap`)
// whose fields lower alike by name (`repsLowerAlike`), so one stands for the other with no bytes.
// Any two closures pass: a signature mismatch inside the retag is ruled out by that heap alone.
function plainRecordsLowerAlike(a: i32, b: i32): boolean {
  const x = repNodeAt(a)
  const y = repNodeAt(b)
  return x is RRecord
    && y is RRecord
    && !x.rrVariant
    && !y.rrVariant
    && repsLowerAlike(a, b, vf.irRecHeap)
}

// Whether operands `os` read variable `v`.
function opndsHoldVar(os: Opnd[], v: i32): boolean {
  for o in os {
    if o is OVar && o.ov == v { return true }
  }
  return false
}

// Whether a variable of type `ty` at rep `rep` is a lone string literal's atom: the rep a record
// field keeps that literal at (`repTyIsLoneStrLit`), where a binding of it holds the string.
function loneLitAtom(ty: i32, rep: i32): boolean {
  return repNodeAt(rep) is RAtom && repTyIsLoneStrLit(ty)
}

// Whether variable `i` of `f` is a temp whose checker type has no value, defined by a call that
// never returns or by a field read at the rep its record's row stores the field at. No value
// reaches it, so it takes the rep legacy writes its consumer at.
function neverCallTemp(f: IrFn, i: i32): boolean {
  const v = f.irVars[i]
  if v.vKind != "temp" || v.vTy < 0 || !repIsNoValue(repNodeOfTy(v.vTy)) {
    return false
  }
  for n in f.irNodes {
    if n is SLet && n.lDst == i {
      const r = n.lRhs
      if r is RGetField {
        const ks = repNodeKids(opRep(r.gfV))
        return r.gfIx >= 0 && r.gfIx < ks.length && ks[r.gfIx] == v.vRep
      }
      return (r is RCall && r.caNever)
        || (r is RCallRef && r.crNever)
        || r is RDeadNever
    }
  }
  return false
}

// Whether integer select `r` (`abs` over one operand, `min`/`max` over two) has another operand
// count, or an operand not at its width (i64 when `nxWide`, else i32).
function intSelArgsWrong(r: RNumIntr): boolean {
  const n = if r.nxSel == "abs" { 1 } else { 2 }
  if r.nxArgs.length != n { return true }
  const want = if r.nxWide { "i64" } else { "i32" }
  for a in r.nxArgs {
    if repPrim(opRep(a)) != want { return true }
  }
  return false
}
