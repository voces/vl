// A bare `{}` delivered into a record type: the member it completes and the refusal naming
// the first field it cannot omit.
// Does not import the checker.
import { tyAdmitsNull } from "./tyquery"
import { T, TyNullable, TyObj, TyUnion, tyIsHole, tyToStr } from "./check_types"

// The members of `dstTy` a `{}` could complete: `dstTy` itself, or its union members, with a
// nullable wrapper peeled; empty when there is no type.
export function bareBraceMembers(dstTy: i32): i32[] {
  const out: i32[] = []
  if dstTy < 0 { return out }
  let d = dstTy
  const dn = T.tys[d]
  if dn is TyNullable { d = dn.nInner }
  if d < 0 { return out }
  const du = T.tys[d]
  if du is TyUnion {
    let m = 0
    while m < du.uMembers.length {
      if du.uMembers[m] >= 0 { out.push(du.uMembers[m]) }
      m = m + 1
    }
  } else {
    out.push(d)
  }
  out
}

// The first field of record `mt` a `{}` cannot omit (its type does not admit `null`), "" when
// every field may be omitted, or "-" when `mt` is not a record.
function bareBraceRequiredField(mt: i32): string {
  const mo = T.tys[mt]
  if mo is TyObj {
    let k = 0
    while k < mo.objFieldNames.length {
      if !tyAdmitsNull(mo.objFieldTypes[k]) { return mo.objFieldNames[k] }
      k = k + 1
    }
    return ""
  }
  "-"
}

// The record member of `dstTy` a `{}` completes, or -1 when none admits it.
export function bareBraceRecordOf(dstTy: i32): i32 {
  const ms = bareBraceMembers(dstTy)
  let i = 0
  while i < ms.length {
    if bareBraceRequiredField(ms[i]) == "" { return ms[i] }
    i = i + 1
  }
  -1
}

// The refusal for a `{}` delivered into `dstTy` that no record member admits, naming the first
// required field of the first record member; "" when `dstTy` offers no record at all.
export function bareBraceRequiredMsg(dstTy: i32): string {
  const ms = bareBraceMembers(dstTy)
  let i = 0
  while i < ms.length {
    const f = bareBraceRequiredField(ms[i])
    if f != "-" {
      return "`{}` leaves out `"
        + f
        + "`, a required field of "
        + tyToStr(ms[i])
        + "; only a field whose type admits `null` may be omitted"
    }
    i = i + 1
  }
  ""
}

// Whether `dstTy` is absent or is (or wraps) an unsolved type variable: a generic parameter
// offers no record for a `{}` to complete.
export function bareBraceHoleDst(dstTy: i32): boolean {
  if dstTy < 0 { return true }
  const ms = bareBraceMembers(dstTy)
  let i = 0
  while i < ms.length {
    if tyIsHole(ms[i]) { return true }
    i = i + 1
  }
  false
}
