// Shadow interfaces for L2's S0: each un-annotated function's parameters, the deferred demand rows
// it owns, and whether each call's recorded result agrees with its result substituted at that
// call's bindings (`l2-inferred-interfaces-design.md` §8). An instrument only; no pass reads it.
// Built on demand from the tables the last check left: `ifaceDumpBuild`, then `ifaceDumpAt`.
import {
  BND_ARG,
  BND_ARRDEF,
  BND_BIN,
  BND_BM,
  BND_IS,
  BND_LET,
  BND_MEM,
  BND_NEST,
  BND_PRINT,
  BND_RET,
  BND_UFCS,
  bndOwnRows,
} from "./check_iface"
import { FuncDecl, Ident, P, Param, i32ToStr, nodeAt } from "./ast"
import { cwIxParent, fnDeclIx } from "./check_write_scan"
import {
  callBindCount,
  callBindIxAt,
  callBindNamesAt,
  callBindTysAt,
} from "./check_bind_rows"
import { quietEnterFlat, quietLeaveFlat } from "./check_cursor"
import { setBindDiffLine, setBindSetsOf } from "./check_set_bind"
import {
  arrowArgsOf,
  arrowCalleeOf,
  arrowCount,
  arrowFromOf,
  arrowHoleOf,
} from "./check_arrow"
import {
  mintFactCallOf,
  mintFactRows,
  mintFactRsOf,
  mintFactSetOf,
} from "./check_mint"
import { fnTagMembers, fnTagSetOfTy } from "./check_elab_cap"
import { setMemberRetAt } from "./check_relate_core"
import { tyHasTyVar } from "./tyquery"
import { identDeclOf, nodeSrc } from "./symbols"
import { fnTagCheckLen } from "./check_fn_tag"
import { elabCallDeclOf } from "./check_elab_cap"
import { hdBase, hdKind, hdRootTy } from "./check_hole_pins"
import { nodeTyIxOf, nodeTyOf } from "./check_node_tys"
import { substTyDeep } from "./check_relate_core"
import {
  T,
  TY_VOID,
  TyFunc,
  TyVar,
  mkFuncTy,
  tyAt,
  tyToStr,
} from "./check_types"

let ifaceText = ""

// Type `t` as text, a type variable by its name, so a scheme's variables can be told apart.
function ifaceTyStr(t: i32): string {
  if t < 0 || t >= T.tys.length { return "?" }
  const v = tyAt(t)
  if v is TyVar { return "'" + v.tvName }
  return tyToStr(t)
}

// `name=count` for a non-zero count, else "".
function ifaceCountTag(name: string, n: i32): string {
  if n == 0 { return "" }
  return " " + name + "=" + i32ToStr(n)
}

// Whether declaration `f` has a parameter with no annotation.
function ifaceUnann(f: FuncDecl): boolean {
  for pIx in f.fnParams {
    const p = nodeAt(pIx)
    if p is Param && p.parType < 0 { return true }
  }
  return false
}

// The derived-hole kinds rooted at one of `params`, as ` hd<kind>=<count>` tags.
function ifaceHdTags(params: i32[]): string {
  const counts: i32[] = []
  let k = 0
  while k < 15 {
    counts.push(0)
    k = k + 1
  }
  let r = 0
  while r < hdKind.length && r < hdBase.length {
    const root = hdRootTy(hdBase[r])
    let hit = false
    for p in params {
      if p == root { hit = true }
    }
    const kd = hdKind[r]
    if hit && kd >= 0 && kd < counts.length { counts[kd] = counts[kd] + 1 }
    r = r + 1
  }
  let out = ""
  k = 0
  while k < counts.length {
    out = out + ifaceCountTag("hd" + i32ToStr(k), counts[k])
    k = k + 1
  }
  return out
}

// The calls of `fnIx` with a binding row: how many there are, and how many record a result that
// is not its declared result substituted at the call's bindings. A disagreeing call is listed.
function ifaceCallsOf(fnIx: i32, ft: TyFunc): string {
  let calls = 0
  let differ = 0
  let shown = ""
  let r = 0
  while r < callBindCount() {
    const ix = callBindIxAt(r)
    const got = nodeTyOf(ix)
    if elabCallDeclOf(ix) == fnIx && got >= 0 && ft.fnRet >= 0 {
      calls = calls + 1
      const q = quietEnterFlat()
      const want = substTyDeep(ft.fnRet, callBindNamesAt(r), callBindTysAt(r))
      quietLeaveFlat(q)
      const a = if want >= 0 && want < T.tys.length { tyToStr(want) } else { "?" }
      const b = if got < T.tys.length { tyToStr(got) } else { "?" }
      if a != b {
        differ = differ + 1
        if differ <= 3 {
          shown = shown + " differ@" + i32ToStr(ix) + "{" + a + "|" + b + "}"
        }
      }
    }
    r = r + 1
  }
  return " calls=" + i32ToStr(calls) + " differ=" + i32ToStr(differ) + shown
}

// One line for un-annotated declaration `fnIx`.
function ifaceLine(fnIx: i32, f: FuncDecl): string {
  const sig = nodeTyIxOf(fnIx)
  if sig < 0 || sig >= T.tys.length { return "" }
  const ft = tyAt(sig)
  if !(ft is TyFunc) { return "" }
  let ps = ""
  for p in ft.fnParamTypes {
    if ps != "" { ps = ps + ", " }
    ps = ps + ifaceTyStr(p)
  }
  const rt = ifaceTyStr(ft.fnRet)
  return "fn "
    + f.fnName
    + "("
    + ps
    + ") -> "
    + rt
    + ifaceCountTag("bin", bndOwnRows(BND_BIN, fnIx).length)
    + ifaceCountTag("arg", bndOwnRows(BND_ARG, fnIx).length)
    + ifaceCountTag("ret", bndOwnRows(BND_RET, fnIx).length)
    + ifaceCountTag("let", bndOwnRows(BND_LET, fnIx).length)
    + ifaceCountTag("bm", bndOwnRows(BND_BM, fnIx).length)
    + ifaceCountTag("mem", bndOwnRows(BND_MEM, fnIx).length)
    + ifaceCountTag("ufcs", bndOwnRows(BND_UFCS, fnIx).length)
    + ifaceCountTag("is", bndOwnRows(BND_IS, fnIx).length)
    + ifaceCountTag("print", bndOwnRows(BND_PRINT, fnIx).length)
    + ifaceCountTag("arrdef", bndOwnRows(BND_ARRDEF, fnIx).length)
    + ifaceCountTag("nest", bndOwnRows(BND_NEST, fnIx).length)
    + ifaceHdTags(ft.fnParamTypes)
    + ifaceCallsOf(fnIx, ft)
}

// Builds the dump, one line per un-annotated top-level function, and returns its length.
export function ifaceDumpBuild(): i32 {
  let out = ""
  for name in fnDeclIx.keys() {
    const ix = fnDeclIx[name] ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is FuncDecl && ifaceUnann(n) {
        const l = ifaceLine(ix, n)
        if l != "" { out = out + l + "\n" }
      }
    }
  }
  const sb = setBindDiffLine(fnTagCheckLen())
  if sb != "" { out = out + sb + "\n" }
  const ar = arrowDiffLine()
  ifaceText = if ar == "" { out } else { out + ar + "\n" }
  return ifaceText.length
}

// The arrow rule's rows against the elaboration's mint facts: per (hole call, set), and per
// (hole call, set, member results). `open` counts rows of a set whose arguments stay open.
function arrowDiffLine(): string {
  const mine: string[] = []
  const mineRs: string[] = []
  let open = 0
  let r = 0
  while r < arrowCount() {
    for st in arrowSetsOf(r) {
      const k = i32ToStr(arrowSrcOf(arrowHoleOf(r))) + "|" + i32ToStr(st)
      let closed = true
      for a in arrowArgsOf(r) {
        if a < 0 || tyHasTyVar(a) { closed = false }
      }
      if closed {
        const ft = mkFuncTy(arrowArgsOf(r), TY_VOID)
        let rs = ""
        for m in fnTagMembers(st) {
          rs = rs + "," + i32ToStr(setMemberRetAt(m, ft))
        }
        mine.push(k)
        mineRs.push(k + "=" + rs)
      } else {
        open = open + 1
      }
    }
    r = r + 1
  }
  const theirs: string[] = []
  const theirsRs: string[] = []
  for f in mintFactRows() {
    const k = i32ToStr(arrowSrcOf(mintFactCallOf(f)))
      + "|"
      + i32ToStr(mintFactSetOf(f))
    let rs = ""
    for t in mintFactRsOf(f) { rs = rs + "," + i32ToStr(t) }
    theirs.push(k)
    theirsRs.push(k + "=" + rs)
  }
  if mine.length + theirs.length + open == 0 { return "" }
  return "arrow calls "
    + arrowCmp(mine, theirs)
    + " rs "
    + arrowCmp(mineRs, theirsRs)
    + " open "
    + i32ToStr(open)
}

// The sets row `r`'s hole callee holds: its own set, or, when the outer call hands it a parameter
// of the caller, every set the set-binding rows bring to that parameter.
function arrowSetsOf(r: i32): i32[] {
  const own = fnTagSetOfTy(arrowCalleeOf(r))
  if own >= 0 { return [own] }
  const x = arrowFromOf(r)
  const d = if x >= 0 && nodeAt(x) is Ident { identDeclOf(x) } else { -1 }
  if d < 0 || !(nodeAt(d) is Param) { return [] }
  const e = if d < cwIxParent.length { cwIxParent[d] } else { -1 }
  const en = if e >= 0 && e < P.nodes.length { nodeAt(e) } else { nodeAt(d) }
  if !(en is FuncDecl) { return [] }
  let i = 0
  while i < en.fnParams.length {
    if en.fnParams[i] == d { return setBindSetsOf(e, i) }
    i = i + 1
  }
  return []
}

// The source node a copied node `x` was made from, `x` itself when it is one.
function arrowSrcOf(x: i32): i32 {
  let y = x
  let n = 0
  while n < 64 {
    const s = nodeSrc[y] ?? -1
    if s < 0 || s == y { return y }
    y = s
    n = n + 1
  }
  return y
}

// `both/onlyMine/onlyTheirs` over two lists of keys, each counted once.
function arrowCmp(mine: string[], theirs: string[]): string {
  const inMine: {[string]: boolean} = Map()
  const inTheirs: {[string]: boolean} = Map()
  for k in mine { inMine[k] = true }
  for k in theirs { inTheirs[k] = true }
  let both = 0
  let om = 0
  let ot = 0
  for k in inMine.keys() {
    if inTheirs[k] ?? false { both = both + 1 } else { om = om + 1 }
  }
  for k in inTheirs.keys() {
    if !(inMine[k] ?? false) { ot = ot + 1 }
  }
  return i32ToStr(both) + "/" + i32ToStr(om) + "/" + i32ToStr(ot)
}

// Code point `i` of the dump, 0 past its end.
export function ifaceDumpAt(i: i32): i32 {
  if i < 0 || i >= ifaceText.length { return 0 }
  return ifaceText[i]
}
