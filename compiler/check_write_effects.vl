// The write-effect summaries: which cells a call may write through each parameter
// (`fnWriteEffects`), the write shapes a body applies to what it is handed (`fnWriteShapes`) and
// the free variables it writes (`fnWriteFreePaths`), each settled once per strongly connected
// component of the call graph. Also the call tests the narrowing kill asks: whether a
// callee is unresolved, or may run a function it is handed. A callee is resolved through
// `./check_callee`; the checker pushes nothing here and reads only the summaries. `weReset` clears
// them per program, and `weUnresDrop` drops the ones that read an untyped node when a body is
// entered or left.
import { identFnDeclOf, identTyOf } from "./check_scopes"
import {
  ArrayLit,
  BinExpr,
  BoolLit,
  Call,
  CharLit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  IsExpr,
  LetDecl,
  Member,
  Node,
  NullLit,
  NumLit,
  ObjLit,
  P,
  Param,
  Paren,
  RetStmt,
  StrLit,
  Unary,
  elseIfLink,
  i32ToStr,
  nodeAt,
  nodeChildren,
  nodeIsTplHole,
  nodeSpineChildren,
} from "./ast"
import {
  CR_ASK_EFFECTS,
  CR_ASK_FREE,
  CR_ASK_SHAPES,
  crAskDecl,
  crAskPop,
  crAskPush,
} from "./check_capture_rows"
import { crNoNames } from "./check_capture_walks"
import { nodeTyOf } from "./check_node_tys"
import { memberDeclOf } from "./symbols"
import { crTyHasFn, crTyIsScalar } from "./tyquery"
import { tyIsHole } from "./check_types"
import { i32ListHas, strListHas, strListIndexOf } from "./listutil"
import {
  BME_CELLS,
  builtinMethodEffect,
  builtinMethodOn,
  builtinMethodRunsArgs,
  builtinRunsNoArg,
  callArgPlaces,
  callDeclFnIx,
  callFnValueDecls,
  findFnDeclInRoots,
  opSiteArgs,
  opSiteDecls,
  opSiteRecvUntyped,
  weRoots,
} from "./check_callee"
import { keyHasPrefix, placeKeyOf, subscriptKeyTextOf } from "./check_places"
import { cellTagOfTy } from "./check_ty_rep"
import {
  CW_FR_UNKNOWN,
  covarRootFrame,
  cwFramedNode,
  cwLambdaDeclOf,
  fnDeclIx,
} from "./check_write_scan"

// A summary: its parts (interned, each a whole sub-path, place key or shape) in first occurrence
// order, whether one is a call of a parameter (`@i`), and `opaque` when nothing is known.
export type WeSet = { parts: i32[], at: boolean, opaque: boolean }

const weOpaqueSet: WeSet = { parts: [], at: false, opaque: true }
const weEmptySet: WeSet = { parts: [], at: false, opaque: false }

// The interned parts: the spelling of each, and the parameter `i` a part `@i` calls, else -1. A
// part is never split or scanned, so a string key holding `,`, `@` or `*` is one part (D6400).
let wePartIx: {[string]: i32} = Map()
let wePartText: string[] = []
let wePartParam: i32[] = []

function wePartOf(text: string, param: i32): i32 {
  const hit = wePartIx[text]
  if hit != null { return hit }
  const id = wePartText.length
  wePartIx[text] = id
  wePartText.push(text)
  wePartParam.push(param)
  id
}

// The spelling of part `id` of a `WeSet`.
export function wePartTextOf(id: i32): string { wePartText[id] }

// A summary being built: its parts, and a bitset of those already in it when `dedupe` keeps each
// once (a summary is a set, and one that repeats a callee's parts per call grows with every path
// through the call graph).
type WeAcc = { parts: i32[], seen: i32[], dedupe: boolean }

function weAccNew(dedupe: boolean): WeAcc {
  { parts: [], seen: [], dedupe: dedupe }
}

function weAccId(acc: WeAcc, id: i32) {
  if acc.dedupe {
    const w = id >> 5
    while acc.seen.length <= w { acc.seen.push(0) }
    const bit = 1 << (id & 31)
    if (acc.seen[w] & bit) != 0 { return 0 }
    acc.seen[w] = acc.seen[w] | bit
  }
  acc.parts.push(id)
  0
}

// Add the part spelled `text`; "" adds nothing.
function weAccPart(acc: WeAcc, text: string) {
  if text != "" { weAccId(acc, wePartOf(text, -1)) }
  0
}

// Add the part `@i`, a call of parameter `i` of the function summarised.
function weAccParam(acc: WeAcc, i: i32) {
  // No other part starts with `@`, so the spelling is a key of its own.
  weAccId(acc, wePartOf("@" + i32ToStr(i), i))
}

function weAccSet(acc: WeAcc, s: WeSet) {
  for id in s.parts { weAccId(acc, id) }
  0
}

// Add `s` unless it is opaque or calls a parameter (`@i`), which no call site binds here; false then.
function weAccClosed(acc: WeAcc, s: WeSet): boolean {
  if s.opaque || s.at { return false }
  weAccSet(acc, s)
  true
}

function weSetOf(acc: WeAcc): WeSet {
  if acc.parts.length == 0 { return weEmptySet }
  let at = false
  for id in acc.parts {
    if wePartParam[id] >= 0 { at = true }
  }
  { parts: acc.parts, at: at, opaque: false }
}

function weRebindShape(ix: i32, bound: string[]) {
  const t = nodeAt(ix)
  if t is Ident {
    if !strListHas(bound, t.identName) { return "=" + t.identName }
  }
  ""
}

function weIsFreshName(ix: i32, fresh: string[]): boolean {
  const n = nodeAt(ix)
  if n is Ident { return strListHas(fresh, n.identName) }
  false
}

// The non-negative integer spelled by the digits `t`, or -1.
export function weDigits(t: string): i32 {
  if t.length == 0 { return -1 }
  let v = 0
  let i = 0
  while i < t.length {
    if t[i] < '0' || t[i] > '9' { return -1 }
    v = v * 10 + (t[i] - '0')
    i = i + 1
  }
  v
}

// Whether the expression at `a` can never evaluate to a function, by its form alone: a literal, a
// record or list built in place, a test, or an operator other than `??` and assignment. Asked
// where a callee body's types may not be recorded yet.
function weNeverFn(a: i32): boolean {
  const n = nodeAt(a)
  if n is BinExpr { return n.binOp != "??" && n.binOp != "=" }
  weNeverFnLeaf(a)
}

// `weNeverFn` for a node that is not an operator.
function weNeverFnLeaf(a: i32): boolean {
  const n = nodeAt(a)
  if n is Paren { return weNeverFn(n.parInner) }
  n is NumLit
    || n is StrLit
    || n is BoolLit
    || n is NullLit
    || n is CharLit
    || n is Unary
    || n is IsExpr
    || n is ObjLit
    || n is ArrayLit
}

// `fnBoundNames` of the function at `fnIx` into `bound`, and from the same walk the names its
// body binds only by a `const` holding an object, list or map it builds there, into `fresh`.
function weBoundAndFresh(
  fnIx: i32,
  body: i32,
  bound: string[],
  fresh: string[],
) {
  const cand: string[] = []
  weBoundWalk(fnIx, body, fnIx == body, bound, cand)
  for nm in cand {
    if weBoundOnce(bound, nm) { fresh.push(nm) }
  }
  0
}

// The walk of `fnBoundNames`, also adding to `cand` each `const` holding a fresh object, list or
// map at or below node `body` (`inBody` once there), in source order.
function weBoundWalk(
  ix: i32,
  body: i32,
  inBody: boolean,
  out: string[],
  cand: string[],
) {
  const n = nodeAt(ix)
  if n is FuncDecl {
    let i = 0
    while i < n.fnParams.length {
      const p = nodeAt(n.fnParams[i])
      if p is Param { out.push(p.parName) }
      i = i + 1
    }
  }
  if n is LetDecl {
    out.push(n.letName)
    if inBody && n.letKw == "const" && weInitIsFresh(n.letInit) {
      cand.push(n.letName)
    }
  }
  if n is ForRange { out.push(n.frVar) }
  if n is ForIn {
    out.push(n.fiVar)
    if n.fiVar2 != "" { out.push(n.fiVar2) }
  }
  if !(n is IfStmt) {
    for k in nodeChildren(ix) {
      if k >= 0 { weBoundWalk(k, body, inBody || k == body, out, cand) }
    }
    return 0
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    for k in nodeSpineChildren(cur) {
      if k >= 0 { weBoundWalk(k, body, inBody || k == body, out, cand) }
    }
    cur = elseIfLink(cur)
  }
  0
}

function weBoundOnce(bound: string[], name: string): boolean {
  let c = 0
  let i = 0
  while i < bound.length {
    if bound[i] == name { c = c + 1 }
    i = i + 1
  }
  c == 1
}

// Whether the expression at `ix` builds a new object, list or map: a literal, or `Map()`/`Set()`.
export function weInitIsFresh(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is Call {
    if n.callFn < 0 { return false }
    const cf = nodeAt(n.callFn)
    if cf is Ident {
      if cf.identName == "Map" || cf.identName == "Set" {
        return identTyOf(n.callFn, cf.identName) < 0
          && identFnDeclOf(n.callFn) < 0
      }
    }
    return false
  }
  n is ObjLit || n is ArrayLit
}

// Whether the call at `callIx` counts as opaque only because its receiver's type is not known
// yet: a method whose receiver is an inference hole, its spelling bound to no declaration.
export function crCalleeUnresolved(callIx: i32): boolean {
  if callIx < 0 || callIx >= P.nodes.length { return false }
  const cn = nodeAt(callIx)
  if cn is Call {
    if cn.callFn < 0 { return false }
    const cf = nodeAt(cn.callFn)
    if cf is Member {
      if memberDeclOf(cn.callFn) >= 0 { return false }
      const rt = nodeTyOf(cf.memObj)
      return rt < 0 || tyIsHole(rt)
    }
  }
  false
}

// An interpolation hole's renderer over a scalar: std:fmt's `toString` of a primitive or a
// union of them, which dispatches to no user code. A struct hole may reach a user `toString`.
export function crIsScalarRender(cn: Call): boolean {
  if cn.callArgs.length != 1 { return false }
  const a = cn.callArgs[0]
  if !nodeIsTplHole(a) { return false }
  let t = nodeTyOf(a)
  if t < 0 {
    const an = nodeAt(a)
    if an is Ident { t = identTyOf(a, an.identName) }
  }
  crTyIsScalar(t)
}

// Could the argument at `a` hold a function? A literal cannot; anything whose type is not yet
// known is assumed to.
export function crArgMayBeFn(a: i32): boolean {
  const an = nodeAt(a)
  if (
    an is NumLit
    || an is StrLit
    || an is BoolLit
    || an is NullLit
    || an is CharLit
  ) {
    return false
  }
  let t = nodeTyOf(a)
  if t < 0 {
    if an is Ident { t = identTyOf(a, an.identName) }
  }
  if t < 0 { return true }
  crTyHasFn(t)
}

// The sub-path of the place at `ix` below root name `root` — `o.v` under `o` is `"v"`, `o.a.v`
// under `o` is `"a.v"`. `""` when the place is not rooted at `root`, is `root` itself, or is not a
// keyable place at all. A cell below a field is a sub-path (`o.xs[0]`) and rides the
// `,`-terminated vocabulary untouched; a cell of the root itself answers `""` (inventory-2 D452).
function placeSubPath(ix: i32, root: string) {
  const k = placeKeyOf(ix)
  if k == "" || k == root { return "" }
  const pfx = root + "."
  if !keyHasPrefix(k, pfx) { return "" }
  const sub = k.slice(pfx.length, k.length)
  sub
}

// Write-effect summaries for the effect-based invalidation rule, keyed `"<fn-node-ix>#<param-ix>"`
// and `"<fn-node-ix>#free"`: the field sub-paths a callee may write through that parameter, or the
// place keys it writes through a free variable, or opaque — assume it writes everything reachable.
let weSums: {[string]: WeSet} = Map()
let weOpen: string[] = []

// The shape summaries (`fnWriteShapes`), keyed `"<fn-node-ix>#shape"`.
let weShapeSums: {[string]: WeSet} = Map()

// The call graph's strongly connected components, found on the fly (Tarjan): a summary whose walk
// reached a frame still open is provisional, kept with the shallowest open depth it reached, and
// answers every later ask on its cycle. The frame that closes the cycle settles every member: free
// summaries take its own, shape and parameter summaries iterate each member to its fixpoint.
let weProvSlot: {[string]: i32} = Map()
let weProvKeys: string[] = []
let weProvSums: WeSet[] = []
let weProvLows: i32[] = []
let weProvFn: i32[] = []
let weProvArg: i32[] = []
let weLow = 1073741824
const WE_NO_LOW = 1073741824

// Summaries that read a node with no type recorded yet. Such an answer is the conservative one, and
// it can only sharpen once another body is checked, so it is kept until a body is entered or left.
let weUnresSums: {[string]: WeSet} = Map()
let weUnresAny = false

// Answer a recursive cycle opaque instead of ⊥, the strictly-fail-closed reading. It is sound but
// costs every read-only recursive callee, newly rejecting correct programs of that one shape where
// the fixpoint rejects none. Kept as a switch, the conservative fallback.
const ALIAS_CYCLE_OPAQUE = false

// The write-effect summary of parameter `paramIx` of the `FuncDecl` at `fnIx`. On a cycle every
// member is re-walked until none grows; a path handed on extended (`p.next`) to a member of the same
// component is widened to that path itself, which covers every depth the recursion can reach and
// keeps the summary independent of which member is asked first.
export function fnWriteEffects(fnIx: i32, paramIx: i32): WeSet {
  crAskDecl(CR_ASK_EFFECTS, fnIx, paramIx)
  const key = i32ToStr(fnIx) + "#" + i32ToStr(paramIx)
  // One probe, not two — see `fnWriteFreePaths` for the note.
  const weHit = weSums[key]
  if weHit != null { return weHit }
  const cyc = weCycleHit(key)
  if cyc != null { return cyc }
  const depth = weOpen.length
  const lowBefore = weLow
  const provMark = weProvKeys.length
  weLow = WE_NO_LOW
  weOpen.push(key)
  crAskPush(fnIx)
  const acc = weEffectsWalk(fnIx, paramIx)
  crAskPop()
  weOpen.pop()
  const low = weLow
  weLow = lowBefore
  if weProvisional(key, acc, depth, low, provMark, fnIx, paramIx) { return acc }
  if low == WE_NO_LOW {
    weSums[key] = acc
    return acc
  }
  weProvPush(key, acc, depth, fnIx, paramIx)
  if weRoundsReachOut(provMark, depth) {
    return weProvSums[weProvSlot[key] ?? provMark]
  }
  let out = acc
  while weProvKeys.length > provMark {
    const s = weProvSums[weProvSums.length - 1]
    const k = weProvPop()
    weSums[k] = s
    if k == key { out = s }
  }
  out
}

// One walk of the body of `fnIx` for the writes through parameter `paramIx`.
function weEffectsWalk(fnIx: i32, paramIx: i32): WeSet {
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    const ps = fd.fnParams
    if paramIx >= 0 && paramIx < ps.length {
      const p = nodeAt(ps[paramIx])
      if p is Param {
        weRoots.push(fd.fnBody)
        const into = weAccNew(true)
        let acc = weOpaqueSet
        if weScan(into, fd.fnBody, p.parName) { acc = weSetOf(into) }
        weRoots.pop()
        return acc
      }
    }
  }
  weOpaqueSet
}

// Whether `key` is on the component being walked: open, or provisional under a frame still open.
function weOnCycle(key: string): boolean {
  if weOpenIndex(key) >= 0 { return true }
  const ps = weProvSlot[key] ?? -1
  ps >= 0 && ps < weProvKeys.length && weProvKeys[ps] == key
}

function weCycleSet(): WeSet {
  if ALIAS_CYCLE_OPAQUE { return weOpaqueSet }
  weEmptySet
}

// Add the field sub-paths a subtree may write through the parameter named `pname`; false for
// opaque: the parameter escaping into a field, an element or a return, an indirect call whose
// target is not statically one `FuncDecl`, or a call whose declaration does not resolve at all.
// Nested `FuncDecl`s are descended, and one shadowing `pname` over-approximates, the safe direction.
function weScan(acc: WeAcc, ix: i32, pname: string): boolean {
  if ix < 0 || ix >= P.nodes.length { return true }
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "=" {
      weAccPart(acc, placeSubPath(n.binLeft, pname))
      // the parameter itself stored into the heap — it escapes
      if placeKeyOf(n.binRight) == pname { return false }
    }
  } else if n is RetStmt {
    if n.retArg >= 0 {
      if placeKeyOf(n.retArg) == pname { return false }
    }
  } else if n is Call {
    if !callEffectsOn(acc, ix, pname) { return false }
  }
  if !opEffectsOn(acc, ix, pname) { return false }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if !weScan(acc, kids[i], pname) { return false }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  true
}

// Add the field sub-paths a call inside a callee body may write through `pname`, by composing the
// nested callee's own summary: passing `pname.a` where the nested callee writes `v` through that
// parameter is a write of `a.v` here.
function callEffectsOn(acc: WeAcc, callIx: i32, pname: string): boolean {
  const cn = nodeAt(callIx)
  if cn is Call { return callEffectsOnReal(acc, cn, callIx, pname) }
  true
}

function callEffectsOnReal(
  acc: WeAcc,
  cn: Call,
  callIx: i32,
  pname: string,
): boolean {
  const declIx = callDeclFnIx(cn, callIx)
  // An intrinsic cannot write a field of anything handed to it, so a body whose only use of the
  // parameter is `print(p.v)` has no write effect. Distinguishing this from the opaque `-1` keeps
  // a read-only callee from invalidating its caller's narrowings — the false positive that
  // decides whether the rule is usable at all.
  if declIx == -2 { return true }
  const args = callArgPlaces(cn, callIx)
  if declIx == -1 {
    const ts = callFnValueDecls(cn)
    if ts.length > 0 {
      let i = 0
      while i < ts.length {
        if !argEffectsOn(acc, ts[i], args, pname) { return false }
        i = i + 1
      }
      return true
    }
  }
  argEffectsOn(acc, declIx, args, pname)
}

// `callEffectsOn` for an operator site that may dispatch: each declaration it may run, handed
// the operands. Not a dispatch site adds nothing.
function opEffectsOn(acc: WeAcc, ix: i32, pname: string): boolean {
  if !(nodeAt(ix) is BinExpr || nodeAt(ix) is Index) { return true }
  const ds = opSiteDecls(ix)
  if ds.length == 0 { return true }
  const args = opSiteArgs(ix)
  let i = 0
  while i < ds.length {
    if !argEffectsOn(acc, ds[i], args, pname) { return false }
    i = i + 1
  }
  true
}

// Add the sub-paths the declaration at `declIx` (-1 opaque) may write through `pname`, handed the
// argument places `args` in parameter order; false when opaque.
function argEffectsOn(
  acc: WeAcc,
  declIx: i32,
  args: i32[],
  pname: string,
): boolean {
  let i = 0
  while i < args.length {
    const ak = placeKeyOf(args[i])
    let rooted = ak == pname
    let below = ""
    if !rooted {
      const s = placeSubPath(args[i], pname)
      if s != "" {
        rooted = true
        below = s + "."
      }
    }
    if rooted {
      if declIx < 0 {
        return false // indirect / unresolvable callee
      }
      const sum = fnWriteEffects(declIx, i)
      if sum.opaque { return false }
      if (
        below != ""
        && sum.parts.length > 0
        && weOnCycle(i32ToStr(declIx) + "#" + i32ToStr(i))
      ) {
        // A path extended around a cycle has no bound; the extension itself covers every one.
        weAccPart(acc, below.slice(0, below.length - 1))
      } else {
        for id in sum.parts { weAccPart(acc, below + wePartText[id]) }
      }
    }
    i = i + 1
  }
  true
}

// The names a function binds: its parameters, every `let`/`const` in its body at any depth, both
// `for` variables, and every nested function's parameters and name. A write rooted at one of these
// is local business; a write rooted at anything else is a write through a free variable, which is
// the caller's binding.
export function fnBoundNames(fnIx: i32, out: string[]) {
  // With no body to be inside, the walk adds no candidate, so the shared empty list stays empty.
  weBoundWalk(fnIx, -1, false, out, weNoNames)
}

const weNoNames: string[] = []

// The full place keys a function writes through a free variable — a captured local or a
// module-level binding — or opaque. This channel exists because the parameter channel is keyed on
// arguments, so a callee that takes none is invisible to it: `function zap() { o.v = null }` inside
// a guard is exactly as falsifying as `clr(o)`.
export function fnWriteFreePaths(fnIx: i32): WeSet {
  crAskDecl(CR_ASK_FREE, fnIx, -1)
  const key = i32ToStr(fnIx) + "#free"
  // One probe, not two: a `.has` guard does not narrow a later `m[k]`, since `m[k]` is not a stable
  // place, so the guarded form probes the map twice. Binding once and narrowing the binding is the
  // fix the `map-has-guard-reread` lint names, and this is a memo lookup on the write-effect path,
  // so it is the hot shape rather than an incidental one.
  const weHit = weSums[key]
  if weHit != null { return weHit }
  const cyc = weCycleHit(key)
  if cyc != null { return cyc }
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    const bound: string[] = []
    fnBoundNames(fnIx, bound)
    const depth = weOpen.length
    const lowBefore = weLow
    const provMark = weProvKeys.length
    weLow = WE_NO_LOW
    weOpen.push(key)
    crAskPush(fnIx)
    weRoots.push(fd.fnBody)
    const into = weAccNew(true)
    let acc = weOpaqueSet
    if weScanFree(into, fd.fnBody, bound) { acc = weSetOf(into) }
    weRoots.pop()
    crAskPop()
    weOpen.pop()
    const low = weLow
    weLow = lowBefore
    if weProvisional(key, acc, depth, low, provMark, -1, -1) { return acc }
    // A callee's free writes are the caller's unchanged, so every member of the cycle has `acc`.
    while weProvKeys.length > provMark { weSums[weProvPop()] = acc }
    weSums[key] = acc
    return acc
  }
  weOpaqueSet
}

// Add the free-variable place keys a subtree writes, composing a nested known callee's own free
// writes; false when an opaque nested callee makes the whole answer opaque.
function weScanFree(acc: WeAcc, ix: i32, bound: string[]): boolean {
  if ix < 0 || ix >= P.nodes.length { return true }
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "=" {
      // A bare free name counts too: rebinding `g` replaces every place below it.
      const k = placeKeyOf(n.binLeft)
      if k != "" {
        if !strListHas(bound, placeRootOf(k)) { weAccPart(acc, k) }
      }
    }
  } else if n is Call {
    if !callFreeEffects(acc, ix) { return false }
  } else if n is Index {
    if !opFreeEffects(acc, ix) { return false }
  }
  if n is BinExpr {
    if !opFreeEffects(acc, ix) { return false }
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if !weScanFree(acc, kids[i], bound) { return false }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  true
}

// Add the free-variable writes a nested call contributes. An intrinsic contributes none; an opaque
// callee answers false.
function callFreeEffects(acc: WeAcc, callIx: i32): boolean {
  const cn = nodeAt(callIx)
  if cn is Call {
    const d = callDeclFnIx(cn, callIx)
    if d == -2 { return true }
    if d == -1 {
      const ts = callFnValueDecls(cn)
      if ts.length == 0 { return false }
      let i = 0
      while i < ts.length {
        if !weAccOpen(acc, fnWriteFreePaths(ts[i])) { return false }
        i = i + 1
      }
      return true
    }
    if d < 0 { return false }
    return weAccOpen(acc, fnWriteFreePaths(d))
  }
  true
}

// Add the free-variable writes of every declaration an operator site may run; false when opaque.
function opFreeEffects(acc: WeAcc, ix: i32): boolean {
  const ds = opSiteDecls(ix)
  let i = 0
  while i < ds.length {
    if ds[i] < 0 { return false }
    if !weAccOpen(acc, fnWriteFreePaths(ds[i])) { return false }
    i = i + 1
  }
  true
}

// Add `s` unless it is opaque; false then.
function weAccOpen(acc: WeAcc, s: WeSet): boolean {
  if s.opaque { return false }
  weAccSet(acc, s)
  true
}

// The writes a function may make to an object older than the call, by what they replace, not the
// name spelled: `.f` a field stored, `[k]` / `[]` a cell stored, `-[k]` / `-[]` a map cell removed;
// a set of those, or opaque. Keyed on the shape, it sees a write through any alias, argument or
// receiver (D2461).
export function fnWriteShapes(fnIx: i32): WeSet {
  crAskDecl(CR_ASK_SHAPES, fnIx, -1)
  if weProbeHit { return weOpaqueSet }
  const key = i32ToStr(fnIx) + "#shape"
  const hit = weShapeSums[key]
  if hit != null { return hit }
  const uhit = weUnresSums[key]
  if uhit != null {
    weUnresAt(weUnresWit[key] ?? -1)
    return uhit
  }
  const cyc = weCycleHit(key)
  if cyc != null { return cyc }
  if weProbing {
    const w = weUnresWit[key] ?? -1
    if weWitLive(w) {
      weUnresAt(w)
      return weOpaqueSet
    }
  }
  if !(nodeAt(fnIx) is FuncDecl) { return weOpaqueSet }
  const unresBefore = weUnres
  const depth = weOpen.length
  const lowBefore = weLow
  const provMark = weProvKeys.length
  const witBefore = weUnresWitMax
  weUnresWitMax = -1
  weLow = WE_NO_LOW
  weOpen.push(key)
  crAskPush(fnIx)
  let acc = weShapesWalk(fnIx, weEmptySet)
  crAskPop()
  weOpen.pop()
  const low = weLow
  weLow = lowBefore
  if weProvisional(key, acc, depth, low, provMark, fnIx, WE_SHAPE_ARG) {
    if witBefore > weUnresWitMax { weUnresWitMax = witBefore }
    return acc
  }
  if low != WE_NO_LOW {
    weProvPush(key, acc, depth, fnIx, WE_SHAPE_ARG)
    if weRoundsReachOut(provMark, depth) {
      if witBefore > weUnresWitMax { weUnresWitMax = witBefore }
      return weProvSums[weProvSlot[key] ?? provMark]
    }
  }
  const wit = weUnresWitMax
  if witBefore > wit { weUnresWitMax = witBefore }
  const settled = weUnres == unresBefore
  while weProvKeys.length > provMark {
    const s = weProvSums[weProvSums.length - 1]
    const shape = weProvArg[weProvArg.length - 1] == WE_SHAPE_ARG
    const k = weProvPop()
    if k == key { acc = s }
    if shape { weShapeStore(k, s, settled, wit) }
  }
  weShapeStore(key, acc, settled, wit)
  acc
}

// One walk of the body of `fnIx` for its write shapes, starting from the parts of `seed`.
function weShapesWalk(fnIx: i32, seed: WeSet): WeSet {
  if seed.opaque { return weOpaqueSet }
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    const bound: string[] = []
    const fresh: string[] = []
    weBoundAndFresh(fnIx, fd.fnBody, bound, fresh)
    const params: string[] = []
    let pi = 0
    while pi < fd.fnParams.length {
      const pn = nodeAt(fd.fnParams[pi])
      let nm = ""
      if pn is Param {
        if weBoundOnce(bound, pn.parName) { nm = pn.parName }
      }
      params.push(nm)
      pi = pi + 1
    }
    weRoots.push(fd.fnBody)
    const into = weAccNew(true)
    weAccSet(into, seed)
    let acc = weOpaqueSet
    if weScanShapes(into, fd.fnBody, fresh, params, bound) {
      acc = weSetOf(into)
    }
    weRoots.pop()
    return acc
  }
  weOpaqueSet
}

// Re-walk each shape and parameter summary of the component recorded since `mark`, rooted at
// `depth`, until none grows; first walks read open members as empty, so the result is the least
// fixpoint whichever member is asked first. True when a round reached a frame below `depth`: the
// component is wider, and every member stays provisional under that frame.
function weRoundsReachOut(mark: i32, depth: i32): boolean {
  weProvLowsTo(mark, depth)
  const lowBefore = weLow
  weLow = WE_NO_LOW
  // A summary first asked in a round opens above this marker, so reaching a member makes it one.
  weOpen.push("#rounds")
  let changed = true
  while changed {
    changed = false
    let j = mark
    while j < weProvKeys.length {
      const old = weProvSums[j]
      let s = old
      crAskPush(weProvFn[j])
      if weProvArg[j] == WE_SHAPE_ARG { s = weShapesWalk(weProvFn[j], old) }
      else if weProvArg[j] >= 0 { s = weEffectsWalk(weProvFn[j], weProvArg[j]) }
      crAskPop()
      if s.opaque != old.opaque || s.parts.length != old.parts.length {
        weProvSums[j] = s
        changed = true
      }
      j = j + 1
    }
  }
  weOpen.pop()
  const low = weLow
  weLow = lowBefore
  if low >= depth { return false }
  weProvLowsTo(mark, low)
  if low < weLow { weLow = low }
  true
}

// Record every member of the component since `mark` as reaching the open depth `low`.
function weProvLowsTo(mark: i32, low: i32) {
  let j = mark
  while j < weProvKeys.length {
    weProvLows[j] = low
    j = j + 1
  }
  0
}

// Keep the shape summary `s` for `key`: memoised when `settled`, else kept until a body is
// entered or left, with the witness `wit` a probe answers from.
function weShapeStore(key: string, s: WeSet, settled: boolean, wit: i32) {
  if settled {
    weShapeSums[key] = s
    return 0
  }
  weUnresWit[key] = wit
  if !weProbing {
    weUnresSums[key] = s
    weUnresAny = true
  }
  0
}

// The `paramIx` a shape summary's walk is recorded under on the component.
const WE_SHAPE_ARG = -2

// The answer for `key` when it is on the cycle being walked, open higher in the recursion or
// provisional under a frame still open, lowering `weLow` to the depth it reaches; null otherwise.
function weCycleHit(key: string): WeSet | null {
  const oi = weOpenIndex(key)
  if oi >= 0 {
    if oi < weLow { weLow = oi }
    return weCycleSet()
  }
  const ps = weProvSlot[key] ?? -1
  if ps >= 0 && ps < weProvKeys.length && weProvKeys[ps] == key {
    if weProvLows[ps] < weLow { weLow = weProvLows[ps] }
    return weProvSums[ps]
  }
  null
}

// Record `acc` provisional when the frame at `depth` reached the shallower open depth `low`: it is
// complete only once that frame is. The members recorded under it since `mark` join it at `low`,
// so none names a frame that closes before the component does. False when the frame is complete.
function weProvisional(
  key: string,
  acc: WeSet,
  depth: i32,
  low: i32,
  mark: i32,
  fnIx: i32,
  paramIx: i32,
): boolean {
  if low >= depth { return false }
  if low < weLow { weLow = low }
  weProvLowsTo(mark, low)
  weProvPush(key, acc, low, fnIx, paramIx)
  true
}

// Record `key` on the component being walked; `fnIx` and `paramIx` name a parameter summary's walk.
function weProvPush(
  key: string,
  acc: WeSet,
  low: i32,
  fnIx: i32,
  paramIx: i32,
) {
  weProvSlot[key] = weProvKeys.length
  weProvKeys.push(key)
  weProvSums.push(acc)
  weProvLows.push(low)
  weProvFn.push(fnIx)
  weProvArg.push(paramIx)
  0
}

// Drop the last entry recorded on the component, answering its key.
function weProvPop(): string {
  weProvSums.pop()
  weProvLows.pop()
  weProvFn.pop()
  weProvArg.pop()
  weProvKeys.pop() ?? ""
}

// The depth of `key` among the summaries being computed, or -1.
function weOpenIndex(key: string): i32 {
  let i = 0
  while i < weOpen.length {
    if weOpen[i] == key { return i }
    i = i + 1
  }
  -1
}

// Counts answers given without a receiver or container type recorded, so a summary asked before
// its body is checked is not cached.
let weUnres = 0

// The largest witness counted in the summary being computed: a node `n` read with no type yet is
// `2n`, an index site `n` whose receiver has none is `2n + 1`.
let weUnresWitMax = -1

// A witness per unsettled shape summary, kept across `weUnresDrop`. While it is still untyped, a
// walk would count it again, so a probe answers from it instead of walking (D6130).
let weUnresWit: {[string]: i32} = Map()

// A probe (`weSummaryUnsettled`) is running, and has counted an untyped read: it ends there.
let weProbing = false
let weProbeHit = false

function weUnresAt(w: i32) {
  weUnres = weUnres + 1
  if w > weUnresWitMax { weUnresWitMax = w }
  if weProbing { weProbeHit = true }
  0
}

// Whether witness `w` is still untyped.
function weWitLive(w: i32): boolean {
  if w < 0 { return false }
  const n = w / 2
  if w % 2 == 1 { return opSiteRecvUntyped(n) }
  nodeTyOf(n) < 0
}

// Add the write shapes of a subtree to `acc`, nested functions included, since one written here
// may run during the call; false when they are opaque. A write one step below a name in `fresh` is
// left out: that object is new to this call. A call of parameter `i` of the function summarised
// (`params`) is `@i`, which a call site replaces with what its argument there writes.
function weScanShapes(
  acc: WeAcc,
  ix: i32,
  fresh: string[],
  params: string[],
  bound: string[],
): boolean {
  if ix < 0 || ix >= P.nodes.length { return true }
  if weProbeHit { return false }
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "=" { weAccPart(acc, weTargetShape(n.binLeft, fresh, bound)) }
  } else if n is Call {
    if !weCallShapes(acc, n, ix, fresh, params, bound) { return false }
  }
  if weMayDispatch(n) {
    const ds = opSiteDecls(ix)
    if opSiteRecvUntyped(ix) { weUnresAt(ix * 2 + 1) }
    let d = 0
    while d < ds.length {
      if ds[d] < 0 { return false }
      if !weAccClosed(acc, fnWriteShapes(ds[d])) { return false }
      d = d + 1
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if !weScanShapes(acc, kids[i], fresh, params, bound) { return false }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  true
}

// The shape an assignment to the place at `ix` writes: `.f` a field, a cell's shape, `=g` a
// rebinding of a name `g` the function does not bind, "" a rebinding of its own local.
export function weTargetShape(ix: i32, fresh: string[], bound: string[]) {
  const tix = peelParenIx(ix)
  if tix < 0 || tix >= P.nodes.length { return "" }
  const t = nodeAt(tix)
  if t is Member {
    if weIsFreshName(t.memObj, fresh) { return "" }
    return "." + t.memProp
  }
  weCellShape(tix, fresh, bound)
}

// `weTargetShape` for a target that is not a field.
function weCellShape(ix: i32, fresh: string[], bound: string[]) {
  const t = nodeAt(ix)
  if t is Index {
    if weIsFreshName(t.idxArr, fresh) { return "" }
    return "[" + subscriptKeyTextOf(t.idxIndex) + "]" + weCellTag(t.idxArr)
  }
  weRebindShape(ix, bound)
}

// The container a cell shape writes into, from the type recorded for the node at `ix`: `#a<T>` for
// a list of `T`, `#m<V>` for a map of `V`, "" when unknown, so the shape then hits every cell.
function weCellTag(ix: i32): string {
  const t = nodeTyOf(ix)
  if t < 0 {
    weUnresAt(ix * 2)
    return ""
  }
  cellTagOfTy(t)
}

// The write shapes the call at `callIx` contributes at a narrowing's own call site, where a
// function value from outside is opaque.
export function callWriteShapes(cn: Call, callIx: i32): WeSet {
  const acc = weAccNew(false)
  if !weCallShapes(acc, cn, callIx, crNoNames, crNoNames, crNoNames) {
    return weOpaqueSet
  }
  weSetOf(acc)
}

// The write shapes a call of the declaration `declIx` handed the argument places `args` makes, at a
// narrowing's own call site.
export function declWriteShapes(declIx: i32, args: i32[]): WeSet {
  const sum = fnWriteShapes(declIx)
  const acc = weAccNew(false)
  if !weSubstArgs(acc, sum, args, crNoNames, crNoNames) { return weOpaqueSet }
  weSetOf(acc)
}

// Add the write shapes a call contributes: its declaration's with each `@i` replaced by what
// argument `i` writes, a built-in method's own effect on a receiver it did not make, and those of
// every function value it is handed that it may run; false when opaque. `params` and `bound` are
// the enclosing summary's.
function weCallShapes(
  acc: WeAcc,
  cn: Call,
  callIx: i32,
  fresh: string[],
  params: string[],
  bound: string[],
): boolean {
  if cn.callFn < 0 { return false }
  const cf = nodeAt(cn.callFn)
  if cf is Ident {
    const pj = strListIndexOf(params, cf.identName)
    if pj >= 0 {
      weAccParam(acc, pj)
      return true
    }
  }
  const d = callDeclFnIx(cn, callIx)
  // A method spelled like a built-in of its receiver is that built-in.
  let own = ""
  if cf is Member {
    if !weIsFreshName(cf.memObj, fresh) { own = builtinMethodShape(cn, cf) }
  }
  if d >= 0 {
    weAccPart(acc, own)
    return weDeclCallShapes(acc, d, callArgPlaces(cn, callIx), params, bound)
  }
  if d == -1 && cf is Ident {
    // A binding whose every stored function is known runs one of them (D5017).
    const ts = callFnValueDecls(cn)
    if ts.length > 0 {
      const args = callArgPlaces(cn, callIx)
      weAccPart(acc, own)
      let i = 0
      while i < ts.length {
        if !weDeclCallShapes(acc, ts[i], args, params, bound) { return false }
        i = i + 1
      }
      return true
    }
  }
  if d == -1 {
    if cf is Member {
      if nodeTyOf(cf.memObj) < 0 { weUnresAt(cf.memObj * 2) }
    }
    return false
  }
  if cf is Ident {
    // A local the summary cannot see through, named like no built-in.
    if strListHas(bound, cf.identName) { return false }
  }
  weAccPart(acc, own)
  if cf is Member {
    if !builtinMethodRunsArgs(cf.memProp) { return true }
  } else if cf is Ident {
    if builtinRunsNoArg(cf.identName) { return true }
  }
  let a = 0
  while a < cn.callArgs.length {
    if !weArgShapes(acc, cn.callArgs[a], params, bound) { return false }
    a = a + 1
  }
  true
}

// Add the write shapes a call of the declaration `d` handed `args` contributes; false when opaque.
function weDeclCallShapes(
  acc: WeAcc,
  d: i32,
  args: i32[],
  params: string[],
  bound: string[],
): boolean {
  weSubstArgs(acc, fnWriteShapes(d), args, params, bound)
}

// Add `sum` with each `@i` replaced by the write shapes of the call's argument `i` in parameter
// order; false when one is opaque or missing.
function weSubstArgs(
  acc: WeAcc,
  sum: WeSet,
  args: i32[],
  params: string[],
  bound: string[],
): boolean {
  if sum.opaque { return false }
  if !sum.at {
    weAccSet(acc, sum)
    return true
  }
  for id in sum.parts {
    const j = wePartParam[id]
    if j >= 0 {
      if j >= args.length { return false }
      if !weArgShapes(acc, args[j], params, bound) { return false }
    } else {
      weAccId(acc, id)
    }
  }
  true
}

// Add what a function value handed as an argument writes when called; false when opaque. Inside a
// summary, a function written in place is part of the subtree walked already, and a parameter of
// the summary is `@i`; a named function or a `const`-bound lambda is its declaration's.
function weArgShapes(
  acc: WeAcc,
  a: i32,
  params: string[],
  bound: string[],
): boolean {
  if a < 0 || a >= P.nodes.length { return true }
  const an = nodeAt(a)
  if an is FuncDecl {
    if params.length > 0 || bound.length > 0 { return true }
    return weAccClosed(acc, fnWriteShapes(a))
  }
  if an is Ident {
    // A scalar is no function value, whatever the call hands it to (`clz(m)`, `max(v, i)`); an
    // argument not typed yet may still be one, so that answer is not cached.
    const at = nodeTyOf(a)
    if at < 0 { weUnresAt(a * 2) }
    if crTyIsScalar(at) { return true }
    const pj = strListIndexOf(params, an.identName)
    if pj >= 0 {
      weAccParam(acc, pj)
      return true
    }
    const d = identFnDeclOf(a)
    if d >= 0 { return weAccClosed(acc, fnWriteShapes(d)) }
    const nd = findFnDeclInRoots(an.identName)
    if nd >= 0 { return weAccClosed(acc, fnWriteShapes(nd)) }
    const fr = covarRootFrame(a)
    if cwFramedNode(a) && fr != CW_FR_UNKNOWN {
      const ld = cwLambdaDeclOf(an.identName, fr)
      if ld >= 0 { return weAccClosed(acc, fnWriteShapes(ld)) }
    }
    if strListHas(bound, an.identName) { return false }
  }
  if weNeverFn(a) { return true }
  !crArgMayBeFn(a)
}

// The shape a built-in method writes into its receiver, when the receiver's type has that
// built-in (or is not known): a map's `delete` removes a cell, `pop`, `clear` and `set` store or
// drop one, and `set` and `delete` with a literal key name it. A list's `push` is `+[]`, an
// append, which only a narrowing of every element of a list can see.
function builtinMethodShape(cn: Call, cf: Member): string {
  const p = cf.memProp
  const rt = nodeTyOf(cf.memObj)
  if p == "push" {
    if rt >= 0 && !builtinMethodOn(rt, p) { return "" }
    return "+[]" + weCellTag(cf.memObj)
  }
  if builtinMethodEffect(p) != BME_CELLS { return "" }
  if rt >= 0 && !builtinMethodOn(rt, p) { return "" }
  let pre = ""
  if p == "delete" { pre = "-" }
  let lit = ""
  if p == "set" && cn.callArgs.length == 2 {
    lit = subscriptKeyTextOf(cn.callArgs[0])
  }
  if p == "delete" && cn.callArgs.length == 1 {
    lit = subscriptKeyTextOf(cn.callArgs[0])
  }
  pre + "[" + lit + "]" + weCellTag(cf.memObj)
}

// The root name of a place key (`"o.a.v"` → `"o"`, `"xs[0].v"` → `"xs"`). Both separators, because
// the one caller asks whether the root is bound in the callee, and a key whose root split answered
// `"xs[0]"` matches no binding, so a nested function's own `xs` would not shadow the free one.
export function placeRootOf(key: string) {
  let i = 0
  while i < key.length {
    if key[i] == '.' || key[i] == '[' {
      const head = key.slice(0, i)
      return head
    }
    i = i + 1
  }
  key
}

// The paren peel this file's place readers make by recursion, as an index: `placeKeyOf` and
// `subscriptKeyTextOf` both recurse on `Paren`, and the note has to look at the same node
// they keyed on.
export function peelParenIx(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return ix }
  const n = nodeAt(ix)
  if n is Paren { return peelParenIx(n.parInner) }
  ix
}

// The top-level functions the body of `fnIx` names, each once, and with `ops` also those an
// operator site in it may dispatch to.
export function weFnRefs(fnIx: i32, ops: boolean): i32[] {
  const refs: i32[] = []
  const fd = nodeAt(fnIx)
  if fd is FuncDecl { weRefsIn(fd.fnBody, refs, ops) }
  refs
}

// Whether the write summary of function `d` still reads an untyped node, so checking its body
// first sharpens what a call to it may write (D5593). A live witness answers without a walk; a walk
// stops at its first untyped read and keeps no unsettled summary, since its value is not used.
export function weSummaryUnsettled(d: i32): boolean {
  if weWitLive(weUnresWit[i32ToStr(d) + "#shape"] ?? -1) { return true }
  const before = weUnres
  weProbing = true
  weProbeHit = false
  fnWriteShapes(d)
  weProbing = false
  weProbeHit = false
  weUnres != before
}

function weRefsIn(ix: i32, out: i32[], ops: boolean) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is Ident {
    // A name has no children.
    const d = fnDeclIx[n.identName] ?? -1
    if d >= 0 && !i32ListHas(out, d) { out.push(d) }
    return 0
  }
  if ops && weMayDispatch(n) {
    for d in opSiteDecls(ix) {
      if d >= 0 && !i32ListHas(out, d) { out.push(d) }
    }
  }
  if !(n is IfStmt) {
    for k in nodeChildren(ix) { weRefsIn(k, out, ops) }
    return 0
  }
  let cur = ix
  while cur >= 0 {
    for k in nodeSpineChildren(cur) { weRefsIn(k, out, ops) }
    cur = elseIfLink(cur)
  }
  0
}

// Whether node `n` can be an operator site that dispatches: only an operator or an index is, so
// `opSiteDecls` answers nothing and `opSiteRecvUntyped` false for every other kind.
function weMayDispatch(n: Node): boolean { n is BinExpr || n is Index }

// Drop the summaries that read a node with no type yet, once a body is entered or left: another
// body checked since may have typed it.
export function weUnresDrop() {
  if weUnresAny {
    weUnresSums = Map()
    weUnresAny = false
  }
  0
}

// Drop every summary once the whole program is typed: one memoised mid-check may read a body
// not yet checked, and an answer after the check must be the typed program's (D14460).
export function weMemoDrop() {
  weSums = Map()
  weShapeSums = Map()
  weUnresSums = Map()
  weUnresWit = Map()
  weUnresWitMax = -1
  weUnresAny = false
  0
}

export function weReset() {
  weSums = Map()
  weShapeSums = Map()
  wePartIx = Map()
