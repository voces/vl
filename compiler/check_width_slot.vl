// The slot face of the record-width rewrite: an annotated binding, or an annotated return, that
// refuses an existing record of a wider shape for its extra fields has its annotation dropped and
// the program re-checked, so the slot takes the record's own type. The drop is undone when the
// re-check refuses anything or types any node outside the slot differently, so a slot that feeds
// a join, a `??` or another declared record keeps its refusal. `check_pins.vl` drives the steps.
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  Node,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  arenaSetNode,
  nodeAt,
  nodeChildren,
} from "./ast"
import { nodeTyOf } from "./check_node_tys"
import { T, tyToStr } from "./check_types"
import { wsPendDecl, wsSlotAt } from "./check_width"
import { i32ListHas } from "./listutil"
import { identDeclOf } from "./symbols"

// Slots whose annotation is dropped, beside the annotation each held; slots declined for good.
let slDecl: i32[] = []
let slAnn: i32[] = []
let slNo: i32[] = []
// The round's dropped slots, the nodes each delivery passed through, and every node's type before.
let slRound: i32[] = []
let slPath: i32[] = []
let slSnap: {[i32]: string} = Map()

export function slotReset() {
  slDecl = []
  slAnn = []
  slNo = []
  slRound = []
  slPath = []
  slSnap = Map()
  0
}

// The nodes under `root`, each beside its parent (-1 for `root`).
function slotWalk(root: i32): {[i32]: i32} {
  const par: {[i32]: i32} = Map()
  par[root] = -1
  const xs = [root]
  while xs.length > 0 {
    const x = xs.pop()
    if x >= 0 && x < P.nodes.length {
      for k in nodeChildren(x) {
        if k >= 0 && k < P.nodes.length && !par.has(k) {
          par[k] = x
          xs.push(k)
        }
      }
    }
  }
  par
}

// The nearest function declaration above `x`, or -1.
function slotFnAbove(x: i32, par: {[i32]: i32}) {
  let p = par[x] ?? -1
  let guard = 0
  while p >= 0 && guard < 4096 {
    if nodeAt(p) is FuncDecl { return p }
    p = par[p] ?? -1
    guard = guard + 1
  }
  -1
}

// The annotated slot the value at `at` is delivered to, or -1: a binding's initializer, an
// assignment to a binding, or a function's return, reached through parentheses, list and record
// literals and the tails of blocks and `if` arms. Each node passed is pushed to `path`.
function slotOf(at: i32, par: {[i32]: i32}, path: i32[]) {
  let x = at
  let guard = 0
  while x >= 0 && guard < 256 {
    path.push(x)
    const p = par[x] ?? -1
    if p < 0 { return -1 }
    const pn = nodeAt(p)
    match pn {
      LetDecl => {
        return if pn.letInit == x && pn.letType >= 0 { p } else { -1 }
      }
      BinExpr => {
        if pn.binOp != "=" || pn.binRight != x || !(nodeAt(pn.binLeft) is Ident) { return -1 }
        const d = identDeclOf(pn.binLeft)
        if d < 0 || d >= P.nodes.length { return -1 }
        const dn = nodeAt(d)
        return if dn is LetDecl && dn.letType >= 0 { d } else { -1 }
      }
      RetStmt => {
        const f = slotFnAbove(p, par)
        if f < 0 { return -1 }
        const fd = nodeAt(f)
        return if fd is FuncDecl && fd.fnRet >= 0 { f } else { -1 }
      }
      FuncDecl => {
        return if pn.fnBody == x && pn.fnRet >= 0 { p } else { -1 }
      }
      Block => {
        if pn.blkStmts.length == 0 || pn.blkStmts[pn.blkStmts.length - 1] != x { return -1 }
      }
      IfStmt => {
        if pn.ifCond == x { return -1 }
      }
      Paren | ArrayLit | ObjLit | FieldInit => {}
      // Any other parent hands the value on to something that is not the slot.
      NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Call | Member | OptMember | ErrExpr | Param | TypeRef | WhileStmt | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
        return -1
      }
    }
    x = p
    guard = guard + 1
  }
  -1
}

// The type each node under `root` holds now, "" for none.
function slotSnapshot(root: i32): {[i32]: string} {
  const out: {[i32]: string} = Map()
  for x in slotWalk(root).keys() {
    const t = nodeTyOf(x)
    out[x] = if t >= 0 && t < T.tys.length { tyToStr(t) } else { "" }
  }
  out
}

// Whether every refusal of this pass is one a slot candidate raised.
function slotOnlyRefusals() {
  if T.diags.length == 0 { return false }
  for d in T.diags {
    if !i32ListHas(wsSlotAt, d.tat) { return false }
  }
  true
}

// Whether slot `d` is a binding; any other slot is a function's return.
function slotIsLet(d: i32) { nodeAt(d) is LetDecl }

// Writes slot `d`'s annotation as `ann`, -1 to drop it.
function slotSetAnn(d: i32, ann: i32) {
  if slotIsLet(d) { return slotSetLetAnn(d, ann) }
  slotSetRetAnn(d, ann)
}

// Writes binding `d`'s annotation as `ann`.
function slotSetLetAnn(d: i32, ann: i32) {
  const n = nodeAt(d)
  if n is LetDecl {
    const nn: Node = {
      letKw: n.letKw,
      letName: n.letName,
      letType: ann,
      letInit: n.letInit,
      pos: n.pos,
    }
    arenaSetNode(d, nn)
  }
  0
}

// Writes function `d`'s return annotation as `ann`.
function slotSetRetAnn(d: i32, ann: i32) {
  const n = nodeAt(d)
  if n is FuncDecl {
    const nf: Node = {
      fnName: n.fnName,
      fnTyParams: n.fnTyParams,
      fnParams: n.fnParams,
      fnRet: ann,
      fnBody: n.fnBody,
      pos: n.pos,
    }
    arenaSetNode(d, nf)
  }
  0
}

// The annotation slot `d` holds, or -1.
function slotAnnOf(d: i32) {
  if slotIsLet(d) { return slotLetAnn(d) }
  slotRetAnn(d)
}

// Binding `d`'s annotation, or -1.
function slotLetAnn(d: i32) {
  const n = nodeAt(d)
  if n is LetDecl { return n.letType }
  -1
}

// Function `d`'s return annotation, or -1.
function slotRetAnn(d: i32) {
  const n = nodeAt(d)
  if n is FuncDecl { return n.fnRet }
  -1
}

// Drops the annotation of every slot this pass's refusals name, when they are its only refusals.
// Answers how many it dropped, which the caller re-checks for.
export function slotApply(root: i32) {
  if wsSlotAt.length == 0 || !slotOnlyRefusals() { return 0 }
  const par = slotWalk(root)
  const found: i32[] = []
  const path: i32[] = []
  for at in wsSlotAt {
    const s = slotOf(at, par, path)
    if s < 0 || i32ListHas(slNo, s) || i32ListHas(slDecl, s) { return 0 }
    if !i32ListHas(found, s) { found.push(s) }
  }
  slSnap = slotSnapshot(root)
  slPath = path
  slRound = found
  for s in found {
    slDecl.push(s)
    slAnn.push(slotAnnOf(s))
    slotSetAnn(s, -1)
  }
  found.length
}

// How parent `p` takes slot value `v`: 0 hands it on elsewhere, 1 ends it (a field or element
// read of the same type as before, or an assignment's target), 2 carries it as a value of its own
// whose type changed, 3 binds it to an un-annotated binding, which joins the slot.
function slotUse(v: i32, p: i32, changed: boolean) {
  const pn = nodeAt(p)
  match pn {
    Member => {
      return if pn.memObj != v { 0 } else if changed { 2 } else { 1 }
    }
    Index => {
      return if pn.idxArr != v { 0 } else if changed { 2 } else { 1 }
    }
    BinExpr => {
      return if pn.binOp == "=" && pn.binLeft == v { 1 } else { 0 }
    }
    LetDecl => {
      return if pn.letInit == v && pn.letType < 0 { 3 } else { 0 }
    }
    Paren => {
      return 2
    }
    // Any other parent reads the value at a type other than the one the slot declared.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Call | OptMember | ErrExpr | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      return 0
    }
  }
}

// The callee name node of call `i`, or -1.
function slotCallee(i: i32) {
  const n = nodeAt(i)
  if n is Call { return n.callFn }
  -1
}

// The value node a read `x` of a slot in `fam` stands for: the call where `x` names a dropped
// return's function, else `x`; -1 where `x` reads no slot.
function slotReadAt(x: i32, fam: i32[], par: {[i32]: i32}) {
  if !(nodeAt(x) is Ident) || !i32ListHas(fam, identDeclOf(x)) { return -1 }
  const p = par[x] ?? -1
  if p >= 0 && slotCallee(p) == x { return p }
  x
}

// Whether path node `p` joins values of one type under the types `now`: a list literal's elements,
// or an `if`'s two arms. A join of two record shapes is no slot's own value.
function slotJoinsAlike(p: i32, now: {[i32]: string}) {
  const pn = nodeAt(p)
  match pn {
    ArrayLit => {
      for e in pn.arrElems {
        if (now[e] ?? "") != (now[pn.arrElems[0]] ?? "") { return false }
      }
      return true
    }
    IfStmt => {
      return pn.ifElse < 0 || (now[pn.ifThen] ?? "") == (now[pn.ifElse] ?? "")
    }
    // Every other node on a delivery's path carries one value.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      return true
    }
  }
}

// Whether the re-check after a drop left the program the same outside the slots: no refusal, no
// rewrite left pending, each slot's value read only by a field, an element, an assignment's target
// or an un-annotated binding (which joins the slot), and every other node of the same type.
function slotHeld(root: i32) {
  if T.diags.length > 0 || wsPendDecl.length > 0 { return false }
  const par = slotWalk(root)
  const now = slotSnapshot(root)
  const fam: i32[] = []
  for d in slRound { fam.push(d) }
  const own: {[i32]: boolean} = Map()
  for x in slPath {
    if !slotJoinsAlike(x, now) { return false }
    own[x] = true
  }
  let seen = 0
  let guard = 0
  while seen < fam.length && guard < 64 {
    seen = fam.length
    for x in par.keys() {
      const v0 = slotReadAt(x, fam, par)
      if v0 >= 0 && !(own[v0] ?? false) {
        own[x] = true
        let v = v0
        let steps = 0
        while v >= 0 && steps < 256 {
          own[v] = true
          const p = par[v] ?? -1
          if p < 0 { return false }
          const changed = !slSnap.has(p) || (slSnap[p] ?? "") != (now[p] ?? "")
          const u = slotUse(v, p, changed)
          if u == 0 { return false }
          if u == 3 {
            own[p] = true
            if !i32ListHas(fam, p) { fam.push(p) }
          }
          v = if u == 2 { p } else { -1 }
          steps = steps + 1
        }
      }
    }
    guard = guard + 1
  }
  for x in now.keys() {
    const same = !slSnap.has(x) || (slSnap[x] ?? "") == (now[x] ?? "")
    if !same && !(own[x] ?? false) && !i32ListHas(fam, x) { return false }
  }
  true
}

// Settles the round's drops after their re-check, restoring and declining them unless the
// program held. True when it restored any, so a re-check is owed to report the refusals.
export function slotSettle(root: i32) {
  if slRound.length == 0 { return false }
  const held = slotHeld(root)
  const round = slRound
  slRound = []
  slPath = []
  slSnap = Map()
  if held { return false }
  for s in round {
    let k = 0
    while k < slDecl.length {
      if slDecl[k] == s { slotSetAnn(s, slAnn[k]) }
      k = k + 1
    }
    slNo.push(s)
  }
  const kd: i32[] = []
  const ka: i32[] = []
  let r = 0
  while r < slDecl.length {
    if !i32ListHas(slNo, slDecl[r]) {
      kd.push(slDecl[r])
      ka.push(slAnn[r])
    }
    r = r + 1
  }
  slDecl = kd
  slAnn = ka
  true
}
