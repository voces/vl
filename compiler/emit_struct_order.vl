// `emit_struct_order.vl` — the order structs are emitted in, the duplicate-index
// scan, and which `array.new` kind and fill a list's element kind takes.

import {
  ArrayLit,
  Call,
  Ident,
  Index,
  LetDecl,
  P,
  i32ToStr,
  nodeAt,
} from "./ast"
import { nominalStructNameOfTy } from "./check_emit_queries"
import { nodeTyPinIxOf, pinnedHoleTyOf } from "./check_hole_pins"
import { nodeArrayElemTyIx, nodeTyIxOf } from "./check_node_tys"
import { MAP_KEY_STR, tyIsI32SentinelNullable } from "./check_ty_rep"
import {
  PrimName,
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  tyAt,
  tyIsLitUnion,
} from "./check_types"
import { structPrefixCands } from "./emit_atom_kinds"
import { unwrapParen } from "./emit_base"
import {
  globalLetOf,
  lixDup,
  lixFirst,
  lixFirstOf,
  lixLen,
  lixNextOf,
  lixRebuild,
} from "./emit_narrow_slots"
import { paramTypeNode } from "./emit_query"
import {
  declTyIxOfName,
  repElemId,
  repElemIdOfMembers,
  repSlotOfTy,
} from "./emit_rep"
import {
  VKind,
  blockLetHidden,
  dupScanActive,
  dupSlotBias,
  dupSlotMore,
  localBlockLet,
  localDeclIx,
  localIsRef,
  localLoopIter,
  localLoopVar,
  localNames,
  localStructIdx,
  rlElemKey,
  rlElemName,
  rlElemTyIx,
  sFieldCount,
  sFieldElemKeyKind,
  sFieldElemTyIx,
  sFieldNames,
  sFieldStart,
  sFieldTypes,
  sNames,
  sTwin,
  scopeFrames,
  scopeSlotOf,
  uFieldElemKeyKind,
  uFieldElemTyIx,
  uFieldStart,
} from "./emit_state"
import { tyRegNoteWrite } from "./memo"
import { tyStepElem } from "./tyquery"

// Has the walk's own scope stack already had its say about which binding a read denotes?
// True while a scope frame is active (the collect and lowering walks keep it in lockstep,
// so every live block binding resolves through `scopeSlotOf`) and during the detection
// sweep that hides them. Where it holds, a block binding a name scan finds is out of scope.
export function blockBindingHidden() {
  blockLetHidden || scopeFrames.length > 0
}

// ── array-intrinsic detection ─────────────────────────────────────────────────
// `__array_new__`, `__array_new_default__`, `__array_copy__` and `__trap__` lower inline at
// the call site. The two allocators reserve the one-slot `arrNewScratchBase` frame, and these
// walkers find them anywhere in a body — a pure name walk, so no narrowing bookkeeping.

// D966 — the arena type of an `__array_new__` call's fill argument, or -1. The element row for
// the resulting list is interned from it, so the intern derives the element's kind rather than
// assuming the struct one. `arrNewIntrKind` below is the kind itself: `__array_new__` reads
// its fill, `__array_new_default__` its destination, and `"none"` is not an intrinsic allocation.
export function arrNewFillTyIx(callIx: i32): i32 {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length == 2 { return nodeTyIxOf(c.callArgs[1]) }
  }
  -1
}

// The list rep an array intrinsic allocates, named by its `VKind`: the seven backings the
// intrinsic builds. `"none"` is a call that is not an intrinsic allocation, or a fill no source
// names.
export type ArrNewKind = "none"
  | "list"
  | "f64list"
  | "strlist"
  | "reflist"
  | "i64list"
  | "u8list"
  | "f32list"

// True when arena type `el` is an element the REF list carries — every composite, since each
// reps as one heap ref. A `TyPrim` has its own scalar backing, and the other four are not a
// resolved element type at all: an unbound `TyVar`, a bare literal, a negation, the err hole.
export function tyIsRefListElemTy(el: i32) {
  if el < 0 { return false }
  const e = tyAt(el)
  if e is TyObj { return true }
  if e is TyArray { return true }
  if e is TyUnion { return true }
  if e is TyNullable { return true }
  if e is TyMap { return true }
  if e is TyFunc { return true }
  if e is TyPrim { return false }
  if e is TyVar { return false }
  if e is TyLit { return false }
  if e is TyNeg { return false }
  if e is TyErr { return false }
  false
}

// The `ArrNewKind` of a list over an ELEMENT of `VKind` k. The arms are the five scalar
// backings and the i32-sentinel niches, `nulnone` among them: a `null[]` rides the i32 list
// with every element the sentinel 2. Every remaining kind is ref-repped.
export function arrNewKindOfElemVKind(k: VKind): ArrNewKind {
  match k {
    "i32" | "nulbool" | "nulnone" => {
      return "list"
    }
    "f64" => {
      return "f64list"
    }
    "str" | "nulstr" => {
      return "strlist"
    }
    "i64" => {
      return "i64list"
    }
    "f32" => {
      // The f32 pair is interned exactly as the i64 one is, so a generic instance's f32
      // parameter fill names its kind here rather than reaching the emitter's floor (D1673).
      return "f32list"
    }
    "struct" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "closure" | "nullist" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "u8list" | "list" | "v128" => {
      return "reflist"
    }
  }
}

// The `ArrNewKind` of a list `VKind`: the seven backings this intrinsic allocates, and `"none"`
// for every other kind — each names a VALUE rather than a list of them, and the `T[] | null`
// ones name a cell the allocation does not fill.
export function arrNewKindOfListVKind(k: VKind): ArrNewKind {
  match k {
    "list" => {
      return "list"
    }
    "f64list" => {
      return "f64list"
    }
    "strlist" => {
      return "strlist"
    }
    "reflist" => {
      return "reflist"
    }
    "i64list" => {
      return "i64list"
    }
    "u8list" => {
      return "u8list"
    }
    "f32list" => {
      return "f32list"
    }
    "i32" | "i64" | "f64" | "f32" | "str" | "struct" | "variant" | "union" | "map" | "closure" | "nulstruct" | "nulvariant" | "nulstr" | "nulbool" | "nulclosure" | "nulmap" | "nulnone" | "nullist" | "nulstrlist" | "nulreflist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "v128" => {
      return "none"
    }
  }
}

// The `__array_new_default__(n)` element kind, read off the checker's recorded type for the
// call: `array.new_default` writes each slot's zero, so the kind is the destination's. An
// unpinned hole answers `"list"`, matching the i32 default such a binding gets. Matched over
// `PrimName`, the checker's own vocabulary, so the gate and the kind cannot drift (D1470).
export function arrNewDefaultKind(callIx: i32): ArrNewKind {
  const p = tyPrimLeafElemName(nodeTyIxOf(callIx))
  if p == null { return "list" }
  match p {
    "f64" => {
      return "f64list"
    }
    "i64" => {
      return "i64list"
    }
    "u8" => {
      return "u8list"
    }
    "f32" => {
      return "f32list"
    }
    "i32" | "boolean" | "string" | "void" | "null" | "never" | "v128" => {
      // No v128 array element; the i32 default stands.
      return "list"
    }
  }
}

// The declared-local position of `name`: the innermost live lexical binding when the scope
// stack has one, else the first `localNames` slot of that name as a safety net for the
// scope-less passes. The resolution variant of `declaredSlotOf`: identical, except the flat
// fallback skips loop-variable slots, whose loop has closed if the scan reaches them.
export function declaredSlotLive(name: string) {
  const scoped = scopeSlotOf(name)
  if scoped >= 0 { return scoped }
  // `flatScanSkips` states for a block binding what `localLoopVar` states for a loop
  // variable: a flat hit the scope stack could have answered for is out of scope.
  let pos = lixFirstOf(name)
  while pos >= 0 {
    if localLoopVar[pos] == 0 && !flatScanSkips(pos) { return pos }
    pos = lixNextOf(pos)
  }
  -1
}

// Could two same-named slots in one frame give a type-directed detector different answers?
// Only if their keys differ: the rep, the struct row, whether the slot's declaration is an
// atom, the declaration's class and the loop iterable — every axis a classifier reads off the
// slot. Equal keys mean the flat scan's choice cannot matter, so no second pass (D1595).
function localRepKey(slot: i32): string {
  localIsRef[slot]
    + "|"
    + i32ToStr(localStructIdx[slot])
    + "|"
    + (if slot < dupAtom.length && dupAtom[slot] { "1" } else { "0" })
    + "|"
    + i32ToStr(localDeclClass(slot))
    + "|"
    + i32ToStr(localLoopIter[slot])
}

// The declaration axis of `localRepKey`: -1 for a slot with no `LetDecl`, -2 for one whose
// declaration every declaration reader answers nothing for, else the `LetDecl` itself. Those
// readers (`bindingDeclInScope`'s three callers) ask only for a literal-union type or a
// string-list literal, so two declarations that yield neither are interchangeable (D2090).
function localDeclClass(slot: i32) {
  const d = localDeclIx[slot]
  if d < 0 { return -1 }
  if declYieldsNothing(d, 0) { return -2 }
  d
}

// Does every declaration reader answer nothing for `LetDecl` `d`, whichever same-named slot a
// scope-less pass resolves a name in its initializer to? Conservative: an index, an array
// literal or a chain deeper than the cap counts as yielding something.
function declYieldsNothing(d: i32, depth: i32): boolean {
  const n = nodeAt(d)
  if n is LetDecl {
    if n.letType >= 0 {
      if tyIsLitUnion(nodeArrayElemTyIx(n.letType)) { return false }
      return !tyIsLitUnion(nodeTyIxOf(n.letType))
    }
    if n.letInit < 0 { return true }
    return initYieldsNothing(n.letInit, depth + 1)
  }
  true
}

// `declYieldsNothing` of an initializer: the rungs `litAtomMemberTyAt` and
// `arrElemLitUnionTyAt` read off the node itself, then the one arm (`Ident`) that recurses.
function initYieldsNothing(e: i32, depth: i32): boolean {
  if depth > 8 { return false }
  const ix = unwrapParen(e)
  if tyIsLitUnion(nodeTyIxOf(ix)) { return false }
  if tyIsLitUnion(nodeArrayElemTyIx(e)) { return false }
  if tyIsLitUnion(tyStepElem(nodeTyPinIxOf(ix))) { return false }
  if tyIsLitUnion(pinnedHoleTyOf(nodeArrayElemTyIx(e))) { return false }
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is ArrayLit { return false }
  if n is Index { return false }
  if n is Ident { return identYieldsNothing(n.identName, depth) }
  // Every other kind is a leaf to the declaration readers.
  initIsReaderLeaf()
}

// The readers recurse through `Ident` and `Index` alone and read a list literal only as a
// string list, so an initializer of any other kind is answered by its own rungs.
function initIsReaderLeaf(): boolean { true }

// Every slot a scope-less pass can resolve `name` to answers nothing: no loop iterable, and
// either a declaration that yields nothing or, with none, a parameter type that is not a
// literal union. Memoised per frame in `dupYieldMemo` (0 no, 1 yes, 2 being asked).
function identYieldsNothing(name: string, depth: i32): boolean {
  const m = dupYieldMemo[name] ?? -1
  if m >= 0 { return m == 1 }
  dupYieldMemo[name] = 2
  let ok = true
  let p = lixFirstOf(name)
  if p < 0 { ok = paramYieldsNothing(name) }
  while ok && p >= 0 {
    if localLoopIter[p] >= 0 {
      ok = false
    } else if localDeclIx[p] >= 0 {
      ok = declYieldsNothing(localDeclIx[p], depth)
    } else {
      ok = paramYieldsNothing(name)
    }
    p = lixNextOf(p)
  }
  if ok { dupYieldMemo[name] = 1 } else { dupYieldMemo[name] = 0 }
  ok
}

function paramYieldsNothing(name: string): boolean {
  const pt = paramTypeNode(dupFnIx, name)
  if pt < 0 { return true }
  if tyIsLitUnion(nodeTyIxOf(pt)) { return false }
  !tyIsLitUnion(nodeArrayElemTyIx(pt))
}

// Does this frame bind any name to more than one slot? The one condition under which
// `declaredSlotOf`'s scope-less answer is a guess. The detection drivers ask once per frame,
// so a frame with no shadowing keeps the flat scan's first-match early return (D1595).
export function frameHasDupLocalName() {
  if lixLen != localNames.length { lixRebuild() }
  lixDup
}

// Does the flat scan have to pass slot `pos` over? True for a block-scoped binding or a loop
// variable asked while the scope stack is authoritative: every live one resolves through
// `scopeSlotOf`, so reaching the flat scan means it is out of scope and the name denotes a
// global or parameter. Scope-less passes keep the whole registry (D9751).
function flatScanSkips(pos: i32) {
  if localBlockLet[pos] == 0 && localLoopVar[pos] == 0 { return false }
  blockBindingHidden()
}

// Does this frame bind a name in a nested block that a module global also binds? The one
// condition under which the scope-less detection sweep and the lowering can disagree about
// which home a read denotes, so the one condition `dupScanRun` owes a second sweep. D1597.
export function frameHasBlockLetOverGlobal() {
  let i = 0
  while i < localNames.length {
    if localBlockLet[i] == 1 {
      if globalLetOf(localNames[i]) >= 0 { return true }
    }
    i = i + 1
  }
  false
}

// The `LetDecl` a read of `name` denotes in the frame being emitted, or -1. It takes NO frame
// argument, and that is the contract: `localNames` is rebuilt per function, so the frame is
// the table. A parameter, a global and a `for`-in element each reach their type by their own
// route, and this declines for all three rather than guessing.
export function bindingDeclInScope(name: string): i32 {
  const slot = declaredSlotOf(name)
  if slot < 0 || slot >= localDeclIx.length { return -1 }
  localDeclIx[slot]
}

// The disambiguation index `dupScanIndex` builds per frame: each name's class representatives
// (its first slot of each `localRepKey`) from its first slot's `dupOff`, `dupCnt` of them; per
// slot its class, per representative whether a later one follows. Same-class slots classify
// alike, so a bias walks classes, not slots (D2309); a biased lookup is two reads.
let dupFlat: i32[] = []
let dupOff: i32[] = []
let dupCnt: i32[] = []
let dupMore: i32[] = []
let dupClass: i32[] = []
let dupLen = -1
let dupFnIx = -1
let dupAtom: boolean[] = []
let dupYieldMemo: {[string]: i32} = Map()
// The names bound more than once (their first slots), and which of them the current sweep has
// looked up: `dupSeenMark[head]` is 1 for one, and `dupSeen` lists them.
let dupHeads: i32[] = []
let dupSeenMark: i32[] = []
let dupSeen: i32[] = []

// Drops the frame the index belongs to, at compile start, so the next lookup rebuilds it.
export function dupIndexReset() {
  dupLen = -1
  dupFnIx = -1
  dupAtom = []
  0
}

// Build the disambiguation index for the frame of `fnIx`. The columns it reads are final once
// the collect walk has run, and a lookup rebuilds it if the frame has grown since. `atom[i]` is
// whether slot `i`'s declaration is an interned atom, as the binding storage column answers it.
export function dupScanIndex(fnIx: i32, atom: boolean[]) {
  if lixLen != localNames.length { lixRebuild() }
  dupFnIx = fnIx
  dupAtom = atom
  dupYieldMemo = Map()
  const n = localNames.length
  dupFlat = []
  dupOff = []
  dupCnt = []
  dupMore = []
  dupClass = []
  dupHeads = []
  dupSeenMark = []
  dupSeen = []
  let i = 0
  while i < n {
    dupOff.push(0)
    dupCnt.push(0)
    dupMore.push(0)
    dupClass.push(i)
    dupSeenMark.push(0)
    i = i + 1
  }
  i = 0
  while i < n {
    if (lixFirst[localNames[i]] ?? -1) == i && lixNextOf(i) >= 0 {
      dupIndexGroup(i)
      dupHeads.push(i)
    } else if (lixFirst[localNames[i]] ?? -1) == i {
      dupOff[i] = dupFlat.length
      dupCnt[i] = 1
      dupFlat.push(i)
    }
    i = i + 1
  }
  dupLen = n
  0
}

// Lay out the class representatives of the same-named slots headed by `head`, class every
// slot by `localRepKey`, and mark each representative a later one follows.
function dupIndexGroup(head: i32) {
  const off = dupFlat.length
  const repOf: {[string]: i32} = Map()
  let p = head
  while p >= 0 {
    const key = localRepKey(p)
    const rep = repOf[key] ?? -1
    if rep >= 0 {
      dupClass[p] = rep
    } else {
      repOf[key] = p
      dupFlat.push(p)
    }
    p = lixNextOf(p)
  }
  dupOff[head] = off
  dupCnt[head] = dupFlat.length - off
  let j = dupFlat.length - 2
  while j >= off {
    dupMore[dupFlat[j]] = 1
    j = j - 1
  }
  0
}

// Start a sweep: forget which names the previous one looked up.
export function dupPassBegin() {
  let k = 0
  while k < dupSeen.length {
    dupSeenMark[dupSeen[k]] = 0
    k = k + 1
  }
  dupSeen = []
  0
}

// The heads the current sweep has looked up, in first-lookup order.
export function dupPassSeen(): i32[] { dupSeen }

// The class every multiply-bound name resolves to at `bias`, one entry per head. Two sweeps with
// equal answers here hand every lookup a slot of the same class, so they classify alike.
export function dupPassClasses(bias: i32): i32[] {
  const out: i32[] = []
  let h = 0
  while h < dupHeads.length {
    const head = dupHeads[h]
    if bias < dupCnt[head] {
      out.push(dupClass[dupFlat[dupOff[head] + bias]])
    } else {
      out.push(dupClass[head])
    }
    h = h + 1
  }
  out
}

// Would a lookup of the name headed by `head` at `bias` flag an unvisited slot of another
// class? The `dupSlotMore` a sweep would raise, answered without running it.
export function dupMoreAt(head: i32, bias: i32): boolean {
  if head < 0 || head >= dupCnt.length { return false }
  if bias >= dupCnt[head] { return false }
  dupMore[dupFlat[dupOff[head] + bias]] == 1
}

export function declaredSlotOf(name: string) {
  const scoped = scopeSlotOf(name)
  if scoped >= 0 { return scoped }
  if !dupScanActive {
    let pos = lixFirstOf(name)
    while pos >= 0 {
      if !flatScanSkips(pos) { return pos }
      pos = lixNextOf(pos)
    }
    return -1
  }
  // Under a detection driver's disambiguation loop: hand back the first slot of the name's
  // `dupSlotBias`-th rep class (the first slot when the bias has run past the class count),
  // and tell the driver when a later class is still unvisited — the pass it has yet to run.
  const first = lixFirstOf(name)
  if first < 0 { return -1 }
  if dupLen != localNames.length { dupScanIndex(dupFnIx, dupAtom) }
  if dupCnt[first] > 1 && dupSeenMark[first] == 0 {
    dupSeenMark[first] = 1
    dupSeen.push(first)
  }
  if dupSlotBias >= dupCnt[first] { return first }
  const pick = dupFlat[dupOff[first] + dupSlotBias]
  if dupMore[pick] == 1 { dupSlotMore = true }
  pick
}

// The `VKind` of declared local `name`, or `null` when there is no such declared local — the
// single `declaredSlotOf` and `localIsRef` lookup the `declared*` type predicates share, each
// comparing the result against its own kind atom. The `null` arm matches no atom, so an
// absent local reads as none of these.
export function declaredKind(name: string): VKind | null {
  const slot = declaredSlotOf(name)
  if slot < 0 { return null }
  localIsRef[slot]
}

// ── the canonical field order (D622) ─────────────────────────────────────────
// `fieldNameOrder` below is it: a struct or variant row's emitted field sequence as a
// permutation of the spelled one, ascending by field name, so a shape's wasm layout is a pure
// function of the shape. Not applied to a `flat` record, whose field order is its byte layout.

// ── the struct emission order (D622) ─────────────────────────────────────────
// Is row `p`'s field name and code list a proper prefix of row `c`'s? The cheap half of
// `emit_sections`' `structRowIsProperPrefix`, which also compares the emitted slot. Being
// weaker is safe here: it triggers on a superset of the real edges and a reorder is neutral.
function structRowPrefixCheap(p: i32, c: i32): boolean {
  if p < 0 || c < 0 || p == c { return false }
  if p >= sFieldCount.length || c >= sFieldCount.length { return false }
  const pn = sFieldCount[p]
  if pn == 0 { return false }
  if pn >= sFieldCount[c] { return false }
  let k = 0
  while k < pn {
    if sFieldNames[sFieldStart[p] + k] != sFieldNames[sFieldStart[c] + k] {
      return false
    }
    if sFieldTypes[sFieldStart[p] + k] != sFieldTypes[sFieldStart[c] + k] {
      return false
    }
    k = k + 1
  }
  true
}

// The order the representative struct rows are assigned heap indices in and emitted in —
// declaration order, except that a row is held back until every proper prefix of it has gone.
// wasm requires a declared supertype to have a lower type index than its subtype, and a
// supertype here is a shorter field list (D622). Twins have no position of their own to hold.
export function structEmitOrder(): i32[] {
  const ord: i32[] = []
  const done: boolean[] = []
  let i = 0
  while i < sNames.length {
    done.push(sTwin[i] != i)
    i = i + 1
  }
  let placed = true
  while placed {
    placed = false
    let c = 0
    while c < sNames.length {
      if !done[c] {
        let ready = true
        const ps = structPrefixCands(c, sNames.length)
        let pi = 0
        while pi < ps.length {
          const p = ps[pi]
          if !done[p] && structRowPrefixCheap(p, c) { ready = false }
          pi = pi + 1
        }
        if ready {
          ord.push(c)
          done[c] = true
          placed = true
        }
      }
      c = c + 1
    }
  }
  // A cycle is impossible, a proper prefix being strictly shorter, so the relation is a strict
  // partial order — but a row left unplaced would silently vanish from the type section, so
  // any residue is appended in declaration order rather than dropped.
  let r = 0
  while r < sNames.length {
    if !done[r] {
      ord.push(r)
      done[r] = true
    }
    r = r + 1
  }
  ord
}

// The wasm struct field index of `name` within struct `si` (declaration order), or
// -1 if that struct has no such field.
export function sFieldIndex(si: i32, name: string) {
  if si < 0 {
    return -1 // unresolved struct (e.g. an inferred ref with no interned shape)
  }
  // The floor for the whole family: an `si` past the struct table names no struct, the same
  // answer `si < 0` gets. Without it a caller handing over an index from another table turns
  // a classifier probe into an out-of-bounds read inside the compiler. Every downstream
  // accessor is reached only after this returns `>= 0`, so bounding it here bounds them all.
  if si >= sFieldStart.length { return -1 }
  const start = sFieldStart[si]
  const cnt = sFieldCount[si]
  let j = 0
  while j < cnt {
    if sFieldNames[start + j] == name { return j }
    j = j + 1
  }
  -1
}

// The same two sidecars addressed by their flat row index — the form `emit_collect`'s
// field-table re-derivation passes hold, since they walk `sFieldTypes` straight through
// rather than per struct and field. Same uncovered answer as the `…At` pair: -1 keeps the
// name path.
export function sFieldElemTyIxRow(ix: i32): i32 {
  if ix < 0 { return -1 }
  if ix >= sFieldElemTyIx.length { return -1 }
  sFieldElemTyIx[ix]
}

export function uFieldElemTyIxRow(ix: i32): i32 {
  if ix < 0 { return -1 }
  if ix >= uFieldElemTyIx.length { return -1 }
  uFieldElemTyIx[ix]
}

// The two sidecars' write half, by flat row index (D1050). The `record*` pair appends a row's
// entry at collect time; this rewrites one already there, padding the column as they pad. A
// second push would be the wrong tool: the row's other columns are already in place, so
// pushing again skews the sidecar against every row after it.
export function setSFieldElemRowTy(ix: i32, tyIx: i32): i32 {
  setFieldElemRowTy(sFieldElemTyIx, ix, tyIx)
}

export function setUFieldElemRowTy(ix: i32, tyIx: i32): i32 {
  setFieldElemRowTy(uFieldElemTyIx, ix, tyIx)
}

// The shared body of both writers, over one table's arena-type sidecar `tys`.
function setFieldElemRowTy(tys: i32[], ix: i32, tyIx: i32): i32 {
  if ix < 0 { return 0 }
  while tys.length <= ix { tys.push(-1) }
  tys[ix] = tyIx
  tyRegNoteWrite()
  0
}

// The key half of struct `si`'s map field `fi`: the field's map key kind. The uncovered answer
// is string-keyed — the same self-heal shape the arena sidecar's -1 has, and the conservative one.
export function sFieldElemKeyKindAt(si: i32, fi: i32): i32 {
  sFieldRowKeyKind(sFieldStart[si] + fi)
}

// The flat-row form, for the passes that walk the whole field table by row index rather than
// by struct and field. `collectA`'s field re-derivation must not lose the key, because an
// inline `{m: {[i32]: V}}` shape is one `TypeRef` whose map never reaches the bare-map arm.
export function sFieldRowKeyKind(row: i32): i32 {
  if row < 0 || row >= sFieldElemKeyKind.length { return MAP_KEY_STR }
  sFieldElemKeyKind[row]
}

// The `sFieldElemKeyKindAt` twin for variant fields (`uFieldElemKeyKind`).
export function uFieldElemKeyKindAt(vi: i32, fi: i32): i32 {
  uFieldRowKeyKind(uFieldStart[vi] + fi)
}

// The `sFieldRowKeyKind` twin for the variant field table.
export function uFieldRowKeyKind(row: i32): i32 {
  if row < 0 || row >= uFieldElemKeyKind.length { return MAP_KEY_STR }
  uFieldElemKeyKind[row]
}

// The ref-list table slot for an arena element type: the row minted under `ty`'s rep key, which
// a record spelled by shape shares with its declared struct twin (D4930, D14222); -1 for none.
export function rlSlotOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  rlSlotOfKey(repElemId(ty))
}

// The declared struct type a record spelled by shape (`ty`) shares its ref-list slot with,
// or -1 when `ty` is no record or is that declared type itself (D4930, D4932).
export function rlDeclTwinTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length || !(tyAt(ty) is TyObj) { return -1 }
  const nom = nominalStructNameOfTy(ty)
  if nom == "" { return -1 }
  const d = declTyIxOfName(nom)
  if d == ty { return -1 }
  d
}

// The ref-list table slot of a union element with members `mems`, or -1 when none is interned.
export function rlSlotOfUnionMembers(mems: i32[]): i32 {
  rlSlotOfKey(repElemIdOfMembers(mems))
}

// Whether a member of union `mems` is a type variable or an error type, or out of the arena.
function rlUnionMayBeVar(mems: i32[]): boolean {
  let i = 0
  while i < mems.length {
    const m = mems[i]
    if m < 0 || m >= T.tys.length { return true }
    const mt = tyAt(m)
    if mt is TyVar || mt is TyErr { return true }
    i = i + 1
  }
  false
}

// Whether every ref-list row whose element may be type `ty` — a list nested one or more deep
// of a record of struct row `si`, or a function type bare or nullable when `si` is -1 — is
// stored under the spelling `nm`.
export function rlNestRowsNamed(ty: i32, si: i32, nm: string): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  let i = 0
  while i < rlElemName.length {
    if rlElemName[i] != nm && rlElemMayBeNest(rlElemTyIxAt(i), ty, si) {
      return false
    }
    i = i + 1
  }
  true
}

// Whether ref-list element type `a` may be `ty` for `rlNestRowsNamed`: also when the
// sidecar does not cover it, or it is a type variable, at any list depth down to `ty`'s leaf.
function rlElemMayBeNest(a: i32, ty: i32, si: i32): boolean {
  if a < 0 || a >= T.tys.length || ty < 0 || ty >= T.tys.length { return true }
  const xt = tyAt(a)
  const bt = tyAt(ty)
  match xt {
    TyVar | TyErr => {
      return true
    }
    TyUnion => {
      return rlUnionMayBeVar(xt.uMembers)
    }
    TyArray => {
      return bt is TyArray && rlElemMayBeNest(xt.aElem, bt.aElem, si)
    }
    TyObj => {
      if si < 0 || bt is TyArray { return false }
      const xs = repSlotOfTy(a)
      return xs < 0 || xs == si
    }
    TyFunc => {
      return si < 0 && bt is TyFunc
    }
    TyNullable => {
      if si >= 0 || !(bt is TyNullable) { return false }
      const n = xt.nInner
      if n < 0 || n >= T.tys.length { return true }
      const nt = tyAt(n)
      return nt is TyFunc || nt is TyVar || nt is TyErr
    }
    TyPrim | TyLit | TyMap | TyNeg => {
      return false
    }
  }
}

function rlSlotOfKey(key: i32): i32 {
  if key < 0 { return -1 }
  let i = 0
  while i < rlElemKey.length {
    if rlElemKey[i] == key { return i }
    i = i + 1
  }
  -1
}

// The arena type a ref-list slot's stored element name denotes, or -1 when the sidecar does
// not cover the slot. The column pads on push, so a lagging or missing entry answers
// uncovered and every consumer keeps its element-name path.
export function rlElemTyIxAt(slot: i32): i32 {
  if slot < 0 { return -1 }
  if slot >= rlElemTyIx.length { return -1 }
  rlElemTyIx[slot]
}

// The bare `TyPrim` element name of an array type, or `null` for a non-array, an unpinned
// hole, or any element that is not a bare primitive. The one home of that walk — the two
// answers below and `arrNewDefaultKind` each need it, and the third wants to ladder over
// `PrimName` rather than over the list `VKind` this folds to.
export function tyPrimLeafElemName(ty: i32): PrimName | null {
  if ty < 0 { return null }
  const t = tyAt(ty)
  if t is TyArray {
    if t.aElem < 0 { return null }
    const el = tyAt(t.aElem)
    if el is TyPrim { return el.primName }
  }
  null
}

// The list `VKind` an ARRAY type over a bare `TyPrim` LEAF reps as — `i32`/`boolean` share
// the one i32-list backing, every other leaf has its own — or `null` for any other element
// (or any non-array). The ARENA twin of the `nameIs*Array` ladder, written once for the
// positions that hold a TYPE and no annotation node to run the name ladder over.
export function tyPrimLeafListKind(ty: i32): VKind | null {
  const n = tyPrimLeafElemName(ty)
  // Exhaustive over `PrimName | null` and `_`-less (D1898 made the nullable litunion
  // matchable): `null` is "no list backing", a real answer, for the three prims the list
  // layer has no backing for and for the `null` a non-array or non-prim element yields.
  match n {
    "i32" | "boolean" => {
      return "list"
    }
    "string" => {
      return "strlist"
    }
    "f64" => {
      return "f64list"
    }
    "i64" => {
      return "i64list"
    }
    "f32" => {
      return "f32list"
    }
    "u8" => {
      return "u8list"
    }
    "void" | "null" | "never" | "v128" | null => {
      // No list backing for these element types, nor for a non-array/non-prim element.
    }
  }
  null
}

// The scalar-list wrapper kind of an array type whose element rides a scalar list's backing
// without being a `TyPrim` — `"list"` for a literal-union `K[]` and its nullable niches (the
// i32 list), `"strlist"` for the `(string | null)[]` ref niche — else `null`. The arena fold
// of the same identity the name-side ladders have long used: all these wrappers are one heap type.
export function tyScalarBackedListKind(tyIx: i32): VKind | null {
  if tyIx < 0 { return null }
  const t = tyAt(tyIx)
  if t is TyArray {
    if t.aElem < 0 { return null }
    if tyIsLitUnion(t.aElem) { return "list" }
    // The two i32-sentinel niches, through the shared predicate `==`/`+` also read — the
    // answer set is unchanged, only the three homes deciding "one i32 cell" collapse to one. D101.
    if tyIsI32SentinelNullable(t.aElem) { return "list" }
    const el = tyAt(t.aElem)
    if el is TyNullable && el.nInner >= 0 {
      const inner = tyAt(el.nInner)
      if inner is TyPrim {
        if inner.primName == "string" { return "strlist" }
      }
    }
  }
  null
}

// The scalar list `VKind` an array type reps as, or `null` for any other type: the
// scalar-backed niches first, then `null[]` on the i32 list (D4671), then the `TyPrim`
// leaves — the typed question `nameIsI32Array` ("list") and `nameIsStringArray` ("strlist") ask.
export function tyScalarListKind(ty: i32): VKind | null {
  const sbk = tyScalarBackedListKind(ty)
  if sbk != null { return sbk }
  if tyPrimLeafElemName(ty) == "null" { return "list" }
  tyPrimLeafListKind(ty)
}
