// `intern.vl` — the structural intern table: `(tag, args)` to one `i32` id, so two keys with the
// same tag and the same argument ids are one id. The caller owns what a tag means and keeps the
// argument ids canonical; a key compares shallowly, so the table never recurses. Each id carries
// one caller-supplied `len` column. Imports nothing; `internReset` empties it.

let inTag: i32[] = []
let inArgStart: i32[] = []
let inArgCount: i32[] = []
let inArgs: i32[] = []
let inHashV: i32[] = []
let inLen: i32[] = []
let inNext: i32[] = []
let inBucket: i32[] = []
let inMask = -1

// Empties the table; every id minted before it means nothing after it.
export function internReset() {
  inTag = []
  inArgStart = []
  inArgCount = []
  inArgs = []
  inHashV = []
  inLen = []
  inNext = []
  inBucket = []
  inMask = -1
  0
}

// FNV-1a over the tag and the argument ids, the offset basis reduced to fit an i32 literal.
// Masked to 30 bits so the bucket index is non-negative however the host lowers a shifted sign.
function internHash(tag: i32, args: i32[]): i32 {
  let h = 0x1c9dc5 ^ tag
  h = h * 16777619
  let i = 0
  while i < args.length {
    h = (h ^ args[i]) * 16777619
    i = i + 1
  }
  h & 0x3fffffff
}

function internGrow() {
  let cap = 16
  while cap < inTag.length * 2 { cap = cap * 2 }
  inBucket = []
  let i = 0
  while i < cap {
    inBucket.push(-1)
    i = i + 1
  }
  inMask = cap - 1
  let id = 0
  while id < inTag.length {
    const b = inHashV[id] & inMask
    inNext[id] = inBucket[b]
    inBucket[b] = id
    id = id + 1
  }
  0
}

// The id of key `(tag, args)`, minting it with length `len` when new; a hit keeps the first
// mint's length.
export function internId(tag: i32, args: i32[], len: i32): i32 {
  if inMask < 0 { internGrow() }
  const h = internHash(tag, args)
  let b = inBucket[h & inMask]
  while b >= 0 {
    if inHashV[b] == h && inTag[b] == tag && inArgCount[b] == args.length {
      let ok = true
      const st = inArgStart[b]
      let i = 0
      while i < args.length {
        if inArgs[st + i] != args[i] { ok = false }
        i = i + 1
      }
      if ok { return b }
    }
    b = inNext[b]
  }
  const id = inTag.length
  inTag.push(tag)
  inArgStart.push(inArgs.length)
  inArgCount.push(args.length)
  inHashV.push(h)
  inLen.push(len)
  inNext.push(-1)
  let j = 0
  while j < args.length {
    inArgs.push(args[j])
    j = j + 1
  }
  // Grow after the push so the rebuild chains the new entry too; otherwise insert it.
  if inTag.length * 4 > (inMask + 1) * 3 {
    internGrow()
  } else {
    const bi = h & inMask
    inNext[id] = inBucket[bi]
    inBucket[bi] = id
  }
  id
}

// The length minted with id `i`, or -1 for no such id.
export function internLen(i: i32): i32 {
  if i < 0 || i >= inLen.length { return -1 }
  inLen[i]
}

// The tag of id `i`, or -1 for no such id.
export function internTag(i: i32): i32 {
  if i < 0 || i >= inTag.length { return -1 }
  inTag[i]
}

// Argument `k` of id `i`, or -1 when `i` has no such id or argument.
export function internArg(i: i32, k: i32): i32 {
  if i < 0 || i >= inTag.length || k < 0 || k >= inArgCount[i] { return -1 }
  inArgs[inArgStart[i] + k]
}
