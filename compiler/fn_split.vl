// The instance record of a reassigned function binding called at more than one argument type
// (DECISIONS.md §"A written function binding called at two types"). The record is one binding
// per slot: every write fills each slot, a call reads the slot of its argument types, and any
// other read (a delivery by value) reads a slot of its own. The emitter refuses such a binding
// and asks for it here; the driver then checks the program again to plan the slots, and
// compiles a third time with the plan applied to the fresh parse. A function returning a
// generic its results call at two types is planned the same way, as a copy per result type.
// A program the emitter never refuses runs none of this, so its output is unchanged.
import { holeFnSplitHas } from "./check_bind_rows"
import {
  ArrayLit,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  FieldInit,
  ForIn,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  IsExpr,
  LetDecl,
  MatchExpr,
  Member,
  Node,
  NullLit,
  NumLit,
  ObjLit,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  StrLit,
  TypeRef,
  Unary,
  WhileStmt,
  annTsOf,
  binderNameAt,
  callHasTyArgs,
  clearAnnTs,
  declNameTokOf,
  hasNamedArgs,
  i32ToStr,
  labelBlockValue,
  mkBinary,
  mkBlock,
  mkBool,
  mkBreakVal,
  mkCall,
  mkFieldInit,
  mkIdent,
  mkIf,
  mkIndex,
  mkLet,
  mkLoopVar,
  mkMember,
  mkNum,
  mkParam,
  mkTypeRef,
  mkWhile,
  nodeAt,
  nodeChildren,
  nodeChildrenPush,
  nodeToks,
  orderArgsByParamNames,
  setAnnTs,
} from "./ast"
import { a20CollectRets } from "./check_leaf_steps"
import { nodeTyIxOf } from "./check_node_tys"
import {
  TyArray,
  TyFunc,
  TyMap,
  TyObj,
  objFieldType,
  tyAt,
  tyToStr,
} from "./check_types"
import { tyHasTyVar, tyReachesHole } from "./tyquery"
import {
  reparseArrowLambdaAt,
  reparseChoiceExprAt,
  reparseFuncDeclAt,
} from "./parser"
import { declOrigOf, identDeclOf } from "./symbols"
import { vrCalls, vrIndex, vrLostIn, vrReset } from "./value_reach"

// The pass the driver is running: an ordinary compile, the planning check, or the compile
// that applies the plan.
export const FS_COMPILE = 0
export const FS_PLAN = 1
export const FS_APPLY = 2
let fsMode = FS_COMPILE

// The refused declarations, as parse-arena indices, and whether the last compile added one.
let fsAsks: i32[] = []
let fsTpAsks: i32[] = []
// The refused calls through a function value handed a generic function (D7183).
let fsCallAsks: i32[] = []
// The `const` lists of functions called through at two function types (D10701), and each read
// `flRead` of list `flDecl` a call goes through, with the type `flKey` it takes ("!" for two).
let fsListAsks: i32[] = []
let flRead: i32[] = []
let flDecl: i32[] = []
let flKey: string[] = []
// Each `for` variable read `fcCallee` called through list read `fcRead`, with its type `fcKey`.
let fcCallee: i32[] = []
let fcRead: i32[] = []
let fcKey: string[] = []
let fsAskGrew = false
// The parse arena's length in the current compile; a node at or past it is minted by the plan.
let fsParseLen = 0

// The plan. A new declaration goes after `pdAnchor`, a slot write after the write `pwAnchor`,
// and identifier `prIdent` is renamed to its slot. A value is a slot's name when `*ValName`
// is set, else a fresh copy of the parse node `*ValSrc` (an identifier or a lambda).
let pdAnchor: i32[] = []
let pdKw: string[] = []
let pdName: string[] = []
let pdTy: i32[] = []
let pdValSrc: i32[] = []
let pdValName: string[] = []
let pwAnchor: i32[] = []
let pwName: string[] = []
let pwValSrc: i32[] = []
let pwValName: string[] = []
// The choice binding `pcAnchor` evaluates its whole choice once into the `const` `pcName`
// declared before it, as the index of the arm chosen; it and each of its slots' copies select
// the arm's name `pcLeaves` by that index (D9322). A choosing call (`fsChoiceRetLeaves`) is
// evaluated as a call of its arm-index copy `pcCallFn` instead, returning one of `pcCallLeaves`.
let pcAnchor: i32[] = []
let pcName: string[] = []
let pcLeaves: string[][] = []
let pcCallFn: string[] = []
let pcCallLeaves: string[][] = []
// A write `pcwWrite` of a choosing call to the choice binding `pcAnchor[pcwPc]` runs its arm-index
// copy `pcwCallFn` into that binding's arm index, and each slot `pcwNames` selects by it (D10192).
let pcwWrite: i32[] = []
let pcwPc: i32[] = []
let pcwCallFn: string[] = []
let pcwNames: string[][] = []
let prIdent: i32[] = []
let prName: string[] = []
// Call `plCall` through the name element binder `plFor` binds (`fsElemBinder`) calls the element
// of list copy `plList` at the binder's index `plIdx` instead, naming the index when the binder
// does not (D10791, D12704).
let plCall: i32[] = []
let plFor: i32[] = []
let plList: string[] = []
let plIdx: string[] = []
// The `.push` statement `pmStmt` on an asked list is followed by the same push onto its copy
// `pmList` (D10792).
let pmStmt: i32[] = []
let pmList: string[] = []
// Element `lhAt` of the asked list declared by `lhDecl`, a choice whose condition calls or
// writes, runs once before the list as arm index `lhName`, and the list and each copy select
// that element's leaves `lhLeaves` by it (D10792).
let lhDecl: i32[] = []
let lhAt: i32[] = []
let lhName: string[] = []
let lhLeaves: string[][] = []
// A copy of function `pfSrc` named `pfName` goes after the module statement `pfAnchor`.
let pfSrc: i32[] = []
let pfAnchor: i32[] = []
let pfName: string[] = []
// Parameter `ppAfter` is followed by parameters `ppNames`, and argument `paArg` of call
// `paCall` by arguments reading `paNames`, passed by the names `paPars` when it is named.
let ppAfter: i32[] = []
let ppNames: string[][] = []
let paCall: i32[] = []
let paArg: i32[] = []
let paNames: string[][] = []
let paPars: string[][] = []
// Split parameters, and bindings, whose type-parameter annotation is dropped.
let ptPar: i32[] = []
// Inside the copy minted for `pfSrc[pcCopy]`, the identifier at source offset `pcPos` named
// `pcFrom` is renamed `pcTo`: a copy is a fresh parse, so its nodes are matched by offset.
let pcCopy: i32[] = []
let pcPos: i32[] = []
let pcFrom: string[] = []
let pcTo: string[] = []
// Argument `pkArg` of call `pkCall` is dropped, as parameter `pqName` is from copy `pqCopy`
// and parameter `pzPar` from its own function. Each read of parameter `pkPar` is a call of the
// function `pkDecl` declares, for the plans of that function's own parameters.
let pkCall: i32[] = []
let pkArg: i32[] = []
let pqCopy: i32[] = []
let pqName: string[] = []
let pzPar: i32[] = []
let pkPar: i32[] = []
let pkDecl: i32[] = []
// Each read of parameter `pqPar` in copy `pqCopy` is a call of the function `pqDecl` declares.
let pqPar: i32[] = []
let pqDecl: i32[] = []
// Inside copy `pyCopy`, the argument at source offset `pyPos` named `pyName` is followed by
// arguments reading `pyNames`, passed by the names `pyPars` when it is named.
let pyCopy: i32[] = []
let pyPos: i32[] = []
let pyName: string[] = []
let pyNames: string[][] = []
let pyPars: string[][] = []
// Call `pmCall`, through a record field, calls function `pmName` directly instead.
let pmCall: i32[] = []
let pmName: string[] = []
// Argument `pnArg` of call `pnCall`, a call returning one of `pnLeaves` run as its copy `pnFn` or
// a choice of names (`pnFn` "", D13360) run as itself, runs once before statement `pnStmt` into
// arm index `pnSel`; it and the `pnCount - 1` arguments after it select by that index (D9596).
// Each copy `pnSrcName` of function `pnSrc` returns the index into `pnSrcLeaves`.
let pnCall: i32[] = []
let pnArg: i32[] = []
let pnStmt: i32[] = []
let pnFn: string[] = []
let pnSel: string[] = []
let pnLeaves: string[][] = []
let pnCount: i32[] = []
// Each `pnAheadKid` child of the matching `pnAheadPar` node is bound to a `const` before the
// choice, in order; `pnWrap` is the node whose child `pnStmt` becomes a labelled block holding
// those bindings, -1 when `pnStmt` is a statement already (D13541, D13542).
let pnAheadPar: i32[][] = []
let pnAheadKid: i32[][] = []
let pnWrap: i32[] = []
let pnSrc: i32[] = []
let pnSrcName: string[] = []
let pnSrcLeaves: string[][] = []
// Record literal `pxObj` takes field `pxField` holding function `pxName`, and member read
// `pxMember` reads field `pxMemberName` instead.
let pxObj: i32[] = []
let pxField: string[] = []
let pxName: string[] = []
let pxMember: i32[] = []
let pxMemberName: string[] = []
// Record literal `phLit`, argument `phArg` of the call statement `phStmt`, becomes the `const`
// `phName` declared just before it.
let phLit: i32[] = []
let phStmt: i32[] = []
let phArg: i32[] = []
let phName: string[] = []
// Parameter `psPar` of function `psFn` is annotated with type parameter `psName`, which the
// function declares after its own.
let psPar: i32[] = []
let psFn: i32[] = []
let psName: string[] = []
// Annotation `psRetype` of a binding a split parameter initializes takes `psRetypeName` with it.
let psRetype: i32[] = []
let psRetypeName: string[] = []

function fsPlanReset(): i32 {
  pkCall = []
  pkArg = []
  pqCopy = []
  pqName = []
  pzPar = []
  pkPar = []
  pkDecl = []
  pqPar = []
  pqDecl = []
  pyCopy = []
  pyPos = []
  pyName = []
  pyNames = []
  pyPars = []
  pmCall = []
  pmName = []
  pnCall = []
  pnArg = []
  pnStmt = []
  pnFn = []
  pnSel = []
  pnLeaves = []
  pnCount = []
  pnAheadPar = []
  pnAheadKid = []
  pnWrap = []
  pnSrc = []
  pnSrcName = []
  pnSrcLeaves = []
  pxObj = []
  pxField = []
  pxName = []
  pxMember = []
  pxMemberName = []
  phLit = []
  phStmt = []
  phArg = []
  phName = []
  psPar = []
  psFn = []
  psName = []
  psRetype = []
  psRetypeName = []
  pcAnchor = []
  pcName = []
  pcLeaves = []
  pcCallFn = []
  pcCallLeaves = []
  pcwWrite = []
  pcwPc = []
  pcwCallFn = []
  pcwNames = []
  pdAnchor = []
  pdKw = []
  pdName = []
  pdTy = []
  pdValSrc = []
  pdValName = []
  pwAnchor = []
  pwName = []
  pwValSrc = []
  pwValName = []
  prIdent = []
  prName = []
  pfSrc = []
  pfAnchor = []
  pfName = []
  ppAfter = []
  ppNames = []
  paCall = []
  paArg = []
  paNames = []
  paPars = []
  ptPar = []
  pcCopy = []
  pcPos = []
  pcFrom = []
  pcTo = []
  plCall = []
  plFor = []
  plList = []
  plIdx = []
  pmStmt = []
  pmList = []
  lhDecl = []
  lhAt = []
  lhName = []
  lhLeaves = []
  fsHoleDecline()
  0
}

// Forgets every ask and the plan; the driver calls it once per program.
export function fsReset(): i32 {
  fsMode = FS_COMPILE
  fsAsks = []
  fsTpAsks = []
  fsCallAsks = []
  fsListAsks = []
  flRead = []
  flDecl = []
  flKey = []
  fcCallee = []
  fcRead = []
  fcKey = []
  fsAskGrew = false
  fsPlanReset()
}

export function fsSetMode(m: i32): i32 {
  fsMode = m
  fsAskGrew = false
  0
}

export function fsModeOf(): i32 { fsMode }

// Whether the compile asked for a split, and whether its asks include a new declaration.
export function fsAsked(): boolean {
  fsAsks.length > 0
    || fsTpAsks.length > 0
    || fsCallAsks.length > 0
    || fsListAsks.length > 0
}
export function fsGrew(): boolean { fsAskGrew }

// Whether parse node `ix` is one the plan minted, in the compile that applies it.
export function fsMinted(ix: i32): boolean {
  fsMode == FS_APPLY && fsParseLen > 0 && ix >= fsParseLen
}

// The emitter finds no signature for a call of function value `callee`; asks for the binding
// it reads, which may want a slot per type.
export function fsAskCallee(callee: i32): i32 {
  const d = letDeclOfRead(callee)
  if d < 0 { return 0 }
  fsAsk(d)
}

// The emitter refuses call `c` through a function value for handing a generic function to a
// parameter no one instance binds; records its parse node, whose callees' parameters are asked.
export function fsAskOpenCall(c: i32): i32 {
  if c < 0 || c >= fsParseLen || hasI32(fsCallAsks, c) { return 0 }
  fsCallAsks.push(c)
  fsAskGrew = true
  0
}

// The emitter calls `callee` through read `read` of `const` list `decl` at function type `key`;
// records the parse nodes, for a list later asked by `fsAskList`.
export function fsNoteListCall(
  callee: i32,
  read: i32,
  decl: i32,
  key: string,
): i32 {
  if read < 0 || read >= fsParseLen { return 0 }
  // A read already noted keeps its list, though a split may have renamed it to a copy.
  let i = 0
  while i < flRead.length {
    if flRead[i] == read {
      if flKey[i] != key { flKey[i] = "!" }
      const met = fsNoteLoopCallee(fsParenPeel(callee), read, key)
      if met && hasI32(fsListAsks, flDecl[i]) { fsAskGrew = true }
      return 0
    }
    i = i + 1
  }
  let d = declOrigOf(decl)
  if d < 0 { d = decl }
  if d < 0 || d >= fsParseLen { return 0 }
  fsNoteLoopCallee(fsParenPeel(callee), read, key)
  flRead.push(read)
  flDecl.push(d)
  flKey.push(key)
  // A call first met once the list is asked, such as one past the first refusal, plans again.
  if hasI32(fsListAsks, d) { fsAskGrew = true }
  0
}

// Records `for` variable read `c` called through list read `read` at type `key`, "!" for two;
// true when `c` is first recorded.
function fsNoteLoopCallee(c: i32, read: i32, key: string): boolean {
  if c < 0 || c >= fsParseLen || !(nodeAt(c) is Ident) { return false }
  let i = 0
  while i < fcCallee.length {
    if fcCallee[i] == c {
      if fcKey[i] != key { fcKey[i] = "!" }
      return false
    }
    i = i + 1
  }
  fcCallee.push(c)
  fcRead.push(read)
  fcKey.push(key)
  true
}

// The emitter refuses a call through `const` list `decl` for taking its elements at a second
// function type; records its parse node, which may take a copy per type (D10701).
export function fsAskList(decl: i32): i32 {
  let d = declOrigOf(decl)
  if d < 0 { d = decl }
  if d < 0 || d >= fsParseLen || hasI32(fsListAsks, d) { return 0 }
  fsListAsks.push(d)
  fsAskGrew = true
  0
}

// The emitter refuses declaration `d` for wanting two signatures; records its parse node.
export function fsAsk(d: i32): i32 {
  let o = declOrigOf(d)
  if o < 0 { o = fsParseReadOf(d) }
  if o < 0 { o = d }
  if o < 0 || o >= fsParseLen { return 0 }
  for a in fsAsks {
    if a == o { return 0 }
  }
  fsAsks.push(o)
  fsAskGrew = true
  0
}

// The parse read behind identifier `d` of a generic instance's copy: the one with its name and
// position resolving to the same declaration, else -1 (D13540).
function fsParseReadOf(d: i32): i32 {
  if d < fsParseLen || d >= P.nodes.length { return -1 }
  const n = nodeAt(d)
  if !(n is Ident) { return -1 }
  const dd = identDeclOf(d)
  if dd < 0 { return -1 }
  let want = declOrigOf(dd)
  if want < 0 { want = dd }
  let i = 0
  while i < fsParseLen {
    const m = nodeAt(i)
    if (
      m is Ident
      && m.pos == n.pos
      && m.identName == n.identName
      && identDeclOf(i) == want
    ) {
      return i
    }
    i = i + 1
  }
  -1
}

// The emitter refuses parameter `par` for binding its type parameter to a second generic
// instance; records its parse node, which the plan gives a type parameter of its own (D6200).
export function fsAskTyParam(par: i32): i32 {
  let o = declOrigOf(par)
  if o < 0 { o = par }
  if o < 0 || o >= fsParseLen || hasI32(fsTpAsks, o) { return 0 }
  fsTpAsks.push(o)
  fsAskGrew = true
  0
}

function hasI32(xs: i32[], x: i32): boolean {
  for y in xs {
    if y == x { return true }
  }
  false
}

// Whether key lists `a` and `b` hold the same keys in the same order.
function fsSameKeys(a: string[], b: string[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  true
}

function hasStr(xs: string[], x: string): boolean {
  for y in xs {
    if y == x { return true }
  }
  false
}

// The declaration a parse-arena identifier resolves to when it is a `let`/`const`, else -1.
function letDeclOfRead(ix: i32): i32 {
  if ix < 0 || ix >= fsParseLen { return -1 }
  if !(nodeAt(ix) is Ident) { return -1 }
  const d = identDeclOf(ix)
  if d < 0 || d >= fsParseLen { return -1 }
  if nodeAt(d) is LetDecl { return d }
  -1
}

// Walk state of one planning check: each reachable node's parent, and the identifiers reached.
let fsParent: i32[] = []
let fsIdents: i32[] = []

function fsWalk(root: i32): i32 {
  fsParent = []
  fsIdents = []
  while fsParent.length < P.nodes.length { fsParent.push(-1) }
  const stack: i32[] = [root]
  while stack.length > 0 {
    const ix = stack.pop()
    if nodeAt(ix) is Ident { fsIdents.push(ix) }
    for c in nodeChildren(ix) {
      if c >= 0 && c < P.nodes.length && fsParent[c] < 0 && c != root {
        fsParent[c] = ix
        stack.push(c)
      }
    }
  }
  0
}

// The slot key of a read of a split binding: its call's argument types, "eq" for an equality
// operand (so equal reads compare one slot), or the read's own slot. "" marks a write target
// and "=" a copy into another binding, neither of which is a read of a slot.
function fsReadKey(r: i32): string { fsReadKeyAt(r, 0) }

function fsReadKeyAt(r: i32, depth: i32): string {
  const p = fsParent[r]
  if p < 0 { return "u:" + i32ToStr(r) }
  const pn = nodeAt(p)
  if pn is Call && pn.callFn == r { return fsCallKey(pn, depth) }
  if pn is BinExpr {
    if pn.binOp == "=" && pn.binLeft == r { return "" }
    if pn.binOp == "=" && pn.binRight == r && letDeclOfRead(pn.binLeft) >= 0 {
      return "="
    }
    if pn.binOp == "==" || pn.binOp == "!=" { return "eq" }
  }
  if pn is LetDecl && pn.letInit == r && pn.letType < 0 { return "=" }
  fsReachKey(r, depth)
}

// The one call key every call read `r`'s value reaches shares (`vrCalls`), else its own slot.
function fsReachKey(r: i32, depth: i32): string {
  const own = "u:" + i32ToStr(r)
  const cs = vrCalls(r, "")
  if cs.length == 0 || vrLostIn(cs) { return own }
  let k = ""
  for c in cs {
    const cn = nodeAt(c)
    if !(cn is Call) { return own }
    const ck = fsCallKey(cn, depth)
    if k != "" && ck != k { return own }
    k = ck
  }
  k
}

// The key of call `c`: its arguments' types.
function fsCallKey(c: Call, depth: i32): string {
  let k = "c:"
  for a in c.callArgs { k = k + fsArgKey(a, depth) + "," }
  k
}

// Argument `a`'s part of a call key: its type, or, while that is open, the key of the parameter
// call that produced it (through an un-annotated binding), so `g(x)` and `g(g(x))` differ (D6210).
function fsArgKey(a: i32, depth: i32): string {
  const t = nodeTyIxOf(a)
  if depth < 8 && a >= 0 && a < P.nodes.length && (t < 0 || tyHasTyVar(t)) {
    const n = nodeAt(a)
    if (
      n is Call
      && n.callFn >= 0
      && n.callFn < P.nodes.length
      && nodeAt(n.callFn) is Ident
    ) {
      const d = identDeclOf(n.callFn)
      if d >= 0 && d < P.nodes.length {
        const pd = nodeAt(d)
        if pd is Param {
          return "r(" + pd.parName + fsReadKeyAt(n.callFn, depth + 1) + ")"
        }
      }
    }
    const ld = letDeclOfRead(a)
    if ld >= 0 {
      const l = nodeAt(ld)
      if l is LetDecl && l.letType < 0 && l.letInit >= 0 {
        return fsArgKey(l.letInit, depth + 1)
      }
    }
  }
  tyToStr(t)
}

// The binding a copy read `r` flows into (`let g = r` or `g = r`).
function fsCopyTarget(r: i32): i32 {
  const p = fsParent[r]
  const pn = nodeAt(p)
  if pn is LetDecl { return p }
  if pn is BinExpr { return letDeclOfRead(pn.binLeft) }
  fsExcluded(-1, "a parent that copies into no binding")
}

// The type a delivery read `r` lands in: a call's parameter (a list's push, a map's set), the
// element or field of a literal that is itself delivered, the enclosing function's return, an
// annotated binding or an assigned place. -1 when the read has no such destination. A literal's
// recorded type is its inferred one, so a literal is read through its own destination instead.
function fsDestTy(r: i32): i32 {
  const p = fsParent[r]
  if p < 0 { return -1 }
  const pn = nodeAt(p)
  if pn is Call && pn.callFn != r {
    for nm in pn.callArgNames {
      if nm != "" { return -1 }
    }
    if pn.callFn < 0 { return -1 }
    const cf = nodeAt(pn.callFn)
    if cf is Member && nodeTyIxOf(cf.memObj) >= 0 {
      const rv = tyAt(nodeTyIxOf(cf.memObj))
      if cf.memProp == "push" && rv is TyArray { return rv.aElem }
      if (
        cf.memProp == "set"
        && rv is TyMap
        && pn.callArgs.length == 2
        && pn.callArgs[1] == r
      ) {
        return rv.mVal
      }
    }
    const ft = nodeTyIxOf(pn.callFn)
    if ft < 0 { return -1 }
    const f = tyAt(ft)
    if !(f is TyFunc) { return -1 }
    let i = 0
    while i < pn.callArgs.length && pn.callArgs[i] != r { i = i + 1 }
    if i < f.fnParamTypes.length { return f.fnParamTypes[i] }
    return -1
  }
  if pn is ArrayLit {
    const at = fsDestTy(p)
    if at < 0 { return -1 }
    const a = tyAt(at)
    if a is TyArray { return a.aElem }
    return -1
  }
  if pn is FieldInit {
    const o = fsParent[p]
    if o < 0 || !(nodeAt(o) is ObjLit) { return -1 }
    const ot = fsDestTy(o)
    if ot < 0 { return -1 }
    const t = tyAt(ot)
    if t is TyObj { return objFieldType(t, pn.fiName) }
    return -1
  }
  if pn is RetStmt {
    let f = fsParent[p]
    while f >= 0 && !(nodeAt(f) is FuncDecl) { f = fsParent[f] }
    if f < 0 { return -1 }
    const ft = nodeTyIxOf(f)
    if ft < 0 { return -1 }
    const t = tyAt(ft)
    if t is TyFunc { return t.fnRet }
    return -1
  }
  if pn is LetDecl && pn.letType >= 0 { return nodeTyIxOf(pn.letType) }
  if pn is BinExpr && pn.binOp == "=" && pn.binRight == r {
    const l = nodeAt(pn.binLeft)
    if l is Index && nodeTyIxOf(l.idxArr) >= 0 {
      const m = tyAt(nodeTyIxOf(l.idxArr))
      if m is TyMap { return m.mVal }
    }
    return nodeTyIxOf(pn.binLeft)
  }
  fsExcluded(-1, "a parent that delivers into no typed place")
}

// Whether a delivery read lands in a function type that fixes one instantiation.
function fsDestFixed(r: i32): boolean {
  const t = fsDestTy(r)
  if t < 0 || !(tyAt(t) is TyFunc) { return false }
  !tyHasTyVar(t) && !tyReachesHole(t, 8)
}

// The members of the split set, their slot keys, and each slot's binding name.
let fsMem: i32[] = []
let fsLanes: string[][] = []

function memIx(d: i32): i32 {
  let i = 0
  while i < fsMem.length {
    if fsMem[i] == d { return i }
    i = i + 1
  }
  -1
}

function laneName(mi: i32, key: string): string {
  const lanes = fsLanes[mi]
  if lanes.length > 0 && lanes[0] == key {
    const d = nodeAt(fsMem[mi])
    if d is LetDecl { return d.letName }
  }
  let k = 0
  while k < lanes.length && lanes[k] != key { k = k + 1 }
  const d = nodeAt(fsMem[mi])
  let base = ""
  if d is LetDecl { base = d.letName }
  const dollar = base.indexOf("$")
  if dollar > 0 { base = base.slice(0, dollar) }
  base + "$s" + i32ToStr(fsMem[mi]) + "_" + i32ToStr(k)
}

// A value written to a member is a copy of a peer member, a fresh name, or a lambda; anything
// else declines the plan. Answers the peer's member index, -1 for no peer, -2 to decline.
function fsValuePeer(v: i32): i32 {
  if v < 0 { return -1 }
  const n = nodeAt(v)
  if n is Ident {
    const d = letDeclOfRead(v)
    if d >= 0 { return memIx(d) }
    return -1
  }
  if n is FuncDecl && n.fnName == "" { return -1 }
  if fsPureChoice(v, 0) { return -1 }
  const ia = fsIdentityArg(v)
  if ia >= 0 && (letDeclOfRead(ia) < 0 || fsConstLambdaOf(ia) >= 0) {
    return -1
  }
  if fsConstRet(v) >= 0 { return -1 }
  fsExcluded(
    -2,
    "a value that is not a name, a lambda or a name through an identity call",
  )
}

// Whether `v` is an `if` with an `else` whose arms are each only a name or another such `if`,
// and whose conditions read without a call or a write, so a slot can evaluate a fresh copy of it
// to the same function (D9120). While `fsAnyCond` is set, a condition may be anything.
function fsPureChoice(v: i32, depth: i32): boolean {
  const x = fsParenPeel(v)
  if x < 0 || x >= P.nodes.length || depth > 16 { return false }
  const n = nodeAt(x)
  if n is MatchExpr { return fsPureMatch(n, depth) }
  if !(n is IfStmt) || n.ifElse < 0 { return false }
  if !fsAnyCond && !fsPureRead(n.ifCond, 0) { return false }
  fsPureChoiceArm(n.ifThen, depth) && fsPureChoiceArm(n.ifElse, depth)
}

// `fsPureChoice` for a `match` not yet lowered: a pure scrutinee, literal or `_` patterns
// binding nothing, and arms that are each a name or a pure choice.
function fsPureMatch(n: MatchExpr, depth: i32): boolean {
  if !fsAnyCond && !fsPureRead(n.matchScrut, 0) { return false }
  let i = 0
  while i < n.matchPats.length {
    if n.matchBinds[i] >= 0 || !fsPureRead(n.matchPats[i], 0) { return false }
    i = i + 1
  }
  for b in n.matchBodies {
    if b < 0 || b >= P.nodes.length { return false }
    if !(nodeAt(b) is Ident) && !fsPureChoiceArm(b, depth) { return false }
  }
  true
}

// Whether `fsPureChoice` accepts any condition or scrutinee; set only by `fsHoistsChoice`.
let fsAnyCond = false

// Whether choice `v` has a name at every leaf but a condition or scrutinee that calls or
// writes. Its binding then evaluates the choice once, as an arm index its slots' copies select
// by, so every condition runs as often and in the order the source says (D9161, D9322).
function fsHoistsChoice(v: i32): boolean {
  if fsPureChoice(v, 0) { return false }
  fsAnyCond = true
  const ok = fsPureChoice(v, 0)
  fsAnyCond = false
  ok
}

// Replaces each name at a leaf of choice `v`, left to right, by its index in `names`, which it
// appends to. -1 when a leaf is not a name.
function fsNumberLeaves(v: i32, names: string[], depth: i32): i32 {
  const x = fsParenPeel(v)
  if x < 0 || x >= P.nodes.length || depth > 16 { return -1 }
  const n = nodeAt(x)
  if n is IfStmt {
    if fsNumberArm(n.ifThen, names, depth) < 0 { return -1 }
    return fsNumberArm(n.ifElse, names, depth)
  }
  if n is MatchExpr {
    let i = 0
    while i < n.matchBodies.length {
      const b = n.matchBodies[i]
      const bn = if b >= 0 && b < P.nodes.length { nodeAt(b) } else { n }
      if bn is Ident {
        n.matchBodies[i] = mkNum(i32ToStr(names.length), bn.pos)
        names.push(bn.identName)
      } else if fsNumberArm(b, names, depth) < 0 {
        return -1
      }
      i = i + 1
    }
    return 0
  }
  fsExcluded(-1, "a choice arm that is neither a name nor a choice")
}

// `fsNumberLeaves` for arm `a`: a block holding one name or choice, or an `else if`.
function fsNumberArm(a: i32, names: string[], depth: i32): i32 {
  if a < 0 || a >= P.nodes.length { return -1 }
  const n = nodeAt(a)
  if !(n is Block) { return fsNumberLeaves(a, names, depth + 1) }
  if n.blkStmts.length != 1 { return -1 }
  const s = fsParenPeel(n.blkStmts[0])
  const sn = if s >= 0 && s < P.nodes.length { nodeAt(s) } else { n }
  if sn is Ident {
    n.blkStmts[0] = mkNum(i32ToStr(names.length), sn.pos)
    names.push(sn.identName)
    return 0
  }
  fsNumberLeaves(n.blkStmts[0], names, depth + 1)
}

// A fresh choice of `names` by the arm index binding `sel`: `if sel == 0 { names[0] } else …`.
// -1 for no names.
function fsSelectArm(sel: string, names: string[], pos: i32): i32 {
  if names.length == 0 { return -1 }
  if names.length == 1 { return mkIdent(names[0], pos) }
  let e = mkBlock([mkIdent(names[names.length - 1], pos)], pos)
  let k = names.length - 2
  while k >= 0 {
    const c = mkBinary("==", mkIdent(sel, pos), mkNum(i32ToStr(k), pos), pos)
    e = mkIf(c, mkBlock([mkIdent(names[k], pos)], pos), e, pos)
    k = k - 1
  }
  e
}

// Whether `if` arm `a` (a block holding one value, or an `else if`) is a name or a pure choice.
function fsPureChoiceArm(a: i32, depth: i32): boolean {
  if a < 0 || a >= P.nodes.length { return false }
  const n = nodeAt(a)
  if n is IfStmt { return fsMatchOnce(a) && fsPureChoice(a, depth + 1) }
  if !(n is Block) { return false }
  // A nested `match` whose scrutinee the check bound ahead of it in the arm (D9322).
  const at = if fsAnyCond && n.blkStmts.length == 2 && fsScrutBind(n.blkStmts[0]) { 1 } else { 0 }
  if n.blkStmts.length != at + 1 { return false }
  const s = fsParenPeel(n.blkStmts[at])
  if s < 0 || s >= P.nodes.length { return false }
  if at == 0 && !fsMatchOnce(s) { return false }
  nodeAt(s) is Ident || fsPureChoice(s, depth + 1)
}

// Whether nested choice `s` evaluates its scrutinee once: it is no `match` the check lowered,
// or that `match` tests a place. A computed one the check could not bind ahead of it tests the
// scrutinee once per arm (D2038), so the choice is not evaluated as the source says.
function fsMatchOnce(s: i32): boolean {
  if !fsAnyCond { return true }
  if s < 0 || s >= P.nodes.length { return false }
  const n = nodeAt(s)
  const t = fsFirstTok(s)
  if !(n is IfStmt) || t < 0 || P.toks[t].kind != "MATCH" { return true }
  fsScrutOnce = true
  const ok = fsPureRead(n.ifCond, 0)
  fsScrutOnce = false
  ok
}

// Whether `fsPureRead` reads a bound scrutinee as evaluated once; set only by `fsMatchOnce`.
let fsScrutOnce = false

// Whether statement `s` is a `const $scrut<match>` the check minted for a computed scrutinee.
function fsScrutBind(s: i32): boolean {
  if s < 0 || s >= P.nodes.length { return false }
  const d = nodeAt(s)
  d is LetDecl && d.letName.slice(0, 6) == "$scrut"
}

// Whether expression `x` reads names, literals, fields, elements and operators only, so a second
// evaluation of it gives the same value and has no effect.
function fsPureRead(x: i32, depth: i32): boolean {
  if x < 0 || x >= P.nodes.length || depth > 32 { return false }
  const n = nodeAt(x)
  // A binding the check minted for a computed scrutinee or receiver stands for that
  // expression, which a copy made from the tokens evaluates again.
  if n is Ident {
    const nm = n.identName
    if nm.slice(0, 6) == "$scrut" { return fsScrutOnce }
    if nm.slice(0, 3) == "$om" { return false }
  }
  if (
    n is Ident
    || n is NumLit
    || n is StrLit
    || n is CharLit
    || n is BoolLit
    || n is NullLit
  ) {
    return true
  }
  if n is Paren { return fsPureRead(n.parInner, depth + 1) }
  if n is Unary {
    if n.unOp != "!" && n.unOp != "-" && n.unOp != "~" { return false }
    return fsPureRead(n.unArg, depth + 1)
  }
  if n is BinExpr {
    if n.binOp == "=" { return false }
    return fsPureRead(n.binLeft, depth + 1) && fsPureRead(n.binRight, depth + 1)
  }
  if n is Member { return fsPureRead(n.memObj, depth + 1) }
  if n is Index {
    return fsPureRead(n.idxArr, depth + 1) && fsPureRead(n.idxIndex, depth + 1)
  }
  if n is ArrayLit {
    for e in n.arrElems {
      if !fsPureRead(e, depth + 1) { return false }
    }
    return true
  }
  fsExcluded(0, "a condition that may call, write or build a function") != 0
}

// The argument node call `c` hands back unchanged, or -1. The callee is a declared function
// whose every return, its last statement among them, reads one never-written parameter bare,
// and the argument there is a name, so a slot can hold that name's value without the call.
function fsIdentityArg(c: i32): i32 {
  if c < 0 || c >= fsParseLen { return -1 }
  const cn = nodeAt(c)
  if !(cn is Call) { return -1 }
  const fd = identDeclOf(cn.callFn)
  if fd < 0 || fd >= fsParseLen { return -1 }
  const f = nodeAt(fd)
  if !(f is FuncDecl) || f.fnName == "" { return -1 }
  if cn.callArgs.length != f.fnParams.length { return -1 }
  for nm in cn.callArgNames {
    if nm != "" { return -1 }
  }
  if f.fnBody < 0 || f.fnBody >= P.nodes.length { return -1 }
  const body = nodeAt(f.fnBody)
  if !(body is Block) || body.blkStmts.length == 0 { return -1 }
  const last = nodeAt(body.blkStmts[body.blkStmts.length - 1])
  if !(last is RetStmt) || last.retArg < 0 || !(nodeAt(last.retArg) is Ident) {
    return -1
  }
  const par = identDeclOf(last.retArg)
  let p = 0
  while p < f.fnParams.length && f.fnParams[p] != par { p = p + 1 }
  if p == f.fnParams.length { return -1 }
  let i = 0
  while i < fsParseLen {
    const rn = nodeAt(i)
    if rn is RetStmt && fsEnclosingFn(i) == fd {
      if (
        rn.retArg < 0
        || !(nodeAt(rn.retArg) is Ident)
        || identDeclOf(rn.retArg) != par
      ) {
        return -1
      }
    }
    i = i + 1
  }
  for r in fsIdents {
    if identDeclOf(r) == par && fsParent[r] >= 0 {
      const w = nodeAt(fsParent[r])
      if (
        w is BinExpr
        && w.binLeft == r
        && (w.binOp == "=" || w.binCompound != "")
      ) {
        return -1
      }
    }
  }
  const arg = cn.callArgs[p]
  if !(nodeAt(arg) is Ident) { return -1 }
  arg
}

// The nearest function or lambda enclosing node `n`, or -1.
function fsEnclosingFn(n: i32): i32 {
  let q = fsParent[n]
  while q >= 0 && !(nodeAt(q) is FuncDecl) { q = fsParent[q] }
  q
}

// The un-annotated binding that identifier `a`, an argument of an identity call, initializes
// through that call; -1 when it is not one.
function fsIdentityLetOf(a: i32): i32 {
  const c = fsParent[a]
  if c < 0 || fsIdentityArg(c) != a { return -1 }
  const d = fsParent[c]
  if d < 0 { return -1 }
  const dn = nodeAt(d)
  if dn is LetDecl && dn.letInit == c && dn.letType < 0 { return d }
  -1
}

// Whether node `c` is a call whose callee is identifier `r`.
function fsCallsVia(c: i32, r: i32): boolean {
  const cn = nodeAt(c)
  cn is Call && cn.callFn == r
}

// Whether read `r`'s value reaches a call, and only calls with no type arguments (`vrCalls`).
function fsReachesUntypedCalls(r: i32): boolean {
  const cs = vrCalls(r, "")
  if cs.length == 0 || vrLostIn(cs) { return false }
  for c in cs {
    if callHasTyArgs(c) { return false }
  }
  true
}

// The function call `c` runs: a declared function, or the lambda a never-written `const`
// holds; -1 for any other callee.
function fsCallRunsFn(c: i32): i32 {
  if c < 0 || c >= fsParseLen { return -1 }
  const cn = nodeAt(c)
  if !(cn is Call) { return -1 }
  const lam = fsConstLambdaOf(cn.callFn)
  if lam >= 0 { return lam }
  const fd = identDeclOf(cn.callFn)
  if fd < 0 || fd >= fsParseLen { return -1 }
  const f = nodeAt(fd)
  if !(f is FuncDecl) || f.fnName == "" { return -1 }
  fd
}

// The name node call `c` always evaluates to, or -1: the callee (`fsCallRunsFn`) has every
// return, and its body's value, read one module-scope function by a name nothing else in the
// program declares, so a slot can hold that function without the call.
function fsConstRet(c: i32): i32 {
  const fd = fsCallRunsFn(c)
  if fd < 0 { return -1 }
  const f = nodeAt(fd)
  if !(f is FuncDecl) || f.fnBody < 0 || f.fnBody >= P.nodes.length {
    return -1
  }
  const body = nodeAt(f.fnBody)
  if !(body is Block) || body.blkStmts.length == 0 { return -1 }
  let tail = body.blkStmts[body.blkStmts.length - 1]
  const last = nodeAt(tail)
  if last is RetStmt { tail = last.retArg }
  if tail < 0 || !(nodeAt(tail) is Ident) { return -1 }
  const g = identDeclOf(tail)
  if g < 0 || g >= fsParseLen || fsParent[g] < 0 { return -1 }
  const gn = nodeAt(g)
  if !(gn is FuncDecl) || !(nodeAt(fsParent[g]) is Program) { return -1 }
  let i = 0
  while i < fsParseLen {
    const n = nodeAt(i)
    if n is RetStmt && fsEnclosingFn(i) == fd {
      if (
        n.retArg < 0
        || !(nodeAt(n.retArg) is Ident)
        || identDeclOf(n.retArg) != g
      ) {
        return -1
      }
    }
    if i != g && fsDeclName(i) == gn.fnName { return -1 }
    i = i + 1
  }
  tail
}

// The generics, in first-return order, that call `c` of a non-generic module function with no
// return annotation may evaluate to: every `return` of the callee names one by a name
// `fsGenericName` accepts, and its last statement is a `return`. Empty unless there are two or
// more, which `fsConstRet` does not cover (D9596).
function fsChoiceRetLeaves(c: i32): string[] {
  const none: string[] = []
  const fd = fsCallRunsFn(c)
  if fd < 0 || fsParent[fd] < 0 || !(nodeAt(fsParent[fd]) is Program) {
    return none
  }
  const f = nodeAt(fd)
  if (
    !(f is FuncDecl)
    || f.fnTyParams.length > 0
    || f.fnRet >= 0
    || f.fnBody < 0
  ) {
    return none
  }
  const body = nodeAt(f.fnBody)
  if !(body is Block) || body.blkStmts.length == 0 { return none }
  if !(nodeAt(body.blkStmts[body.blkStmts.length - 1]) is RetStmt) {
    return none
  }
  const cn = nodeAt(c)
  if !(cn is Call) || hasNamedArgs(cn.callArgNames) { return none }
  const names: string[] = []
  let i = 0
  while i < fsParseLen {
    const n = nodeAt(i)
    if n is RetStmt && fsEnclosingFn(i) == fd {
      if n.retArg < 0 || !fsGenericName(n.retArg) { return none }
      const g = nodeAt(n.retArg)
      if g is Ident && !hasStr(names, g.identName) { names.push(g.identName) }
    }
    i = i + 1
  }
  if names.length < 2 { return none }
  names
}

// The statement choice-returning call `a` (`fsChoiceRetLeaves`), an argument of call `c`, can run
// before: `c` is that statement or the value it binds, names no argument, and every argument
// ahead of `a` stays (`fsAheadStays`) or is bound ahead of it in order (`fsAheadHoists`), as
// `fsAheadKid` lists; -1 otherwise.
function fsChoiceStmt(c: i32, a: i32): i32 {
  fsAheadClear()
  if (
    c < 0
    || c >= P.nodes.length
    || c >= fsParent.length
    || a < 0
    || a >= P.nodes.length
  ) {
    return -1
  }
  if fsChoiceRetLeaves(a).length == 0 { return -1 }
  const cn = nodeAt(c)
  const an = nodeAt(a)
  if !(cn is Call) || !(an is Call) || hasNamedArgs(cn.callArgNames) {
    return -1
  }
  const lam = fsChoiceTakesLambda(an)
  for x in cn.callArgs {
    if x == a { break }
    if !fsAheadStays(x, lam) {
      if !fsAheadHoists(x) { return -1 }
      fsAheadNote(c, x, 0)
    }
  }
  let s = c
  const p = fsParent[c]
  if p >= 0 {
    const pn = nodeAt(p)
    if pn is LetDecl && pn.letInit == c { s = p }
  }
  if fsListOwner(s) < 0 { return -1 }
  s
}

// What the last `fsChoiceStmt` or `fsChoiceArgStmt` binds ahead of its choice: child
// `fsAheadKid` of `fsAheadPar`, `fsAheadLvl` nodes above the choice's call; the objects of the
// callees on the way up (`fsAheadObj`); and the node its statement is wrapped in (`pnWrap`).
let fsAheadPar: i32[] = []
let fsAheadKid: i32[] = []
let fsAheadLvl: i32[] = []
let fsAheadObj: i32[] = []
let fsWrapIn = -1

function fsAheadClear(): i32 {
  fsAheadPar = []
  fsAheadKid = []
  fsAheadLvl = []
  fsAheadObj = []
  fsWrapIn = -1
  0
}

// Notes child `x` of `p`, which the source runs ahead of the choice, `lvl` nodes above its call.
function fsAheadNote(p: i32, x: i32, lvl: i32): i32 {
  fsAheadPar.push(p)
  fsAheadKid.push(x)
  fsAheadLvl.push(lvl)
  0
}

// Notes what callee `f` reads before its arguments run: the object of a member, else nothing.
function fsCalleeNote(f: i32): i32 {
  const n = nodeAt(f)
  if n is Member { fsAheadObj.push(n.memObj) }
  0
}

// The statement a choice `a` of names (`fsPureChoice` or `fsHoistsChoice`) handed to call `c`
// can run before (D13360), with what the source runs ahead of it either staying or bound to a
// `const` ahead of it in order (`fsAheadBind`, D13541); -1 otherwise. In a `while` condition or
// a short-circuit's right side, that statement is wrapped in a labelled block there (D13542).
function fsChoiceArgStmt(c: i32, a: i32): i32 {
  fsAheadClear()
  if (
    c < 0
    || c >= P.nodes.length
    || c >= fsParent.length
    || a < 0
    || a >= fsParseLen
  ) {
    return -1
  }
  const pure = fsPureChoice(a, 0)
  if !pure && !fsHoistsChoice(a) { return -1 }
  const cn = nodeAt(c)
  if !(cn is Call) || hasNamedArgs(cn.callArgNames) { return -1 }
  let found = false
  for x in cn.callArgs {
    if x == a { found = true }
    if !found { fsAheadNote(c, x, 0) }
  }
  if !found { return -1 }
  fsCalleeNote(cn.callFn)
  const s = fsChoiceStmtOf(c, pure, pure && !fsChoiceMayTrap(a, 0))
  if s < 0 || !fsAheadBind(pure) { return -1 }
  s
}

// The statement holding `c` that a choice (`pure` or calling) may run before, each enclosing
// expression running `c` once and noting what it runs first (`fsAheadNote`); `lazy` admits a
// short-circuit's right side while nothing noted binds. A `while` condition or a right side not
// admitted is returned itself, `fsWrapIn` naming its parent. -1 otherwise (D13462).
function fsChoiceStmtOf(c: i32, pure: boolean, lazy: boolean): i32 {
  let x = c
  let hops = 0
  while x >= 0 && x < fsParent.length && hops < 64 {
    const p = fsParent[x]
    if p < 0 || p >= fsParseLen { return -1 }
    const pn = nodeAt(p)
    if (pn is Block || pn is Program) && hasI32(fsStmtsOf(p), x) { return x }
    if fsWrapsChild(p, x, lazy && fsAheadAllKeep(pure)) {
      if fsLoopExit(x) { return -1 }
      fsWrapIn = p
      return x
    }
    if !fsRunsChildFirst(p, x, hops + 1) { return -1 }
    x = p
    hops = hops + 1
  }
  -1
}

// Whether node `p` runs child `x` repeatedly or conditionally, as a `while` condition or, unless
// `lazy`, a short-circuit's right side, so a choice in `x` runs where `x` does.
function fsWrapsChild(p: i32, x: i32, lazy: boolean): boolean {
  const pn = nodeAt(p)
  if pn is WhileStmt { return pn.whileBlk == 0 && pn.whileCond == x }
  if pn is BinExpr && pn.binRight == x && !lazy {
    return pn.binOp == "&&" || pn.binOp == "||" || pn.binOp == "??"
  }
  fsExcluded(0, "a node that runs its child once whenever it runs, or never")
    == 1
}

// Whether expression `x` holds a `break` or `continue` naming no label, which a labelled block
// wrapped around `x` would change the target of.
function fsLoopExit(x: i32): boolean {
  const stack: i32[] = [x]
  while stack.length > 0 {
    const k = stack.pop()
    if k >= 0 && k < P.nodes.length {
      const n = nodeAt(k)
      if n is BreakStmt && n.brkLabel == "" { return true }
      if n is ContinueStmt && n.contLabel == "" { return true }
      nodeChildrenPush(k, stack)
    }
  }
  false
}

// Whether node `p` evaluates its child `x` once whenever `p` runs, noting each child it runs
// first (`fsAheadNote`) at `lvl`. A short-circuit's right side counts; `fsWrapsChild` decides it.
function fsRunsChildFirst(p: i32, x: i32, lvl: i32): boolean {
  const pn = nodeAt(p)
  if pn is Paren || pn is Unary || pn is LetDecl || pn is RetStmt {
    return true
  }
  if pn is Member { return pn.memObj == x }
  if pn is IfStmt { return pn.ifCond == x }
  if pn is ForIn { return pn.fiIter == x }
  if pn is MatchExpr { return pn.matchScrut == x }
  if pn is FieldInit { return pn.fiValue == x }
  if pn is Index {
    if pn.idxArr == x { return true }
    fsAheadNote(p, pn.idxArr, lvl)
    return pn.idxIndex == x
  }
  if pn is BinExpr {
    if pn.binLeft == x { return pn.binOp != "=" }
    if pn.binOp == "=" { return nodeAt(pn.binLeft) is Ident }
    fsAheadNote(p, pn.binLeft, lvl)
    return true
  }
  if pn is Call {
    if pn.callFn == x || !fsCalleeStays(pn.callFn) { return false }
    fsCalleeNote(pn.callFn)
    for y in pn.callArgs {
      if y == x { return true }
      fsAheadNote(p, y, lvl)
    }
    return false
  }
  if pn is ArrayLit {
    for y in pn.arrElems {
      if y == x { return true }
      fsAheadNote(p, y, lvl)
    }
    return false
  }
  if pn is ObjLit {
    // A record literal runs its fields in source order.
    for y in pn.objFields {
      if y == x { return true }
      const yn = nodeAt(y)
      if !(yn is FieldInit) { return false }
      fsAheadNote(y, yn.fiValue, lvl)
    }
    return false
  }
  fsExcluded(
    0,
    "a node that may run its child conditionally, repeatedly or late",
  )
    != 0
}

// Whether every noted expression may stay where it is (`fsAheadKeeps`).
function fsAheadAllKeep(pure: boolean): boolean {
  let k = 0
  while k < fsAheadKid.length {
    if !fsAheadKeeps(fsAheadKid[k], fsAheadLvl[k], pure) { return false }
    k = k + 1
  }
  true
}

// Whether `y`, noted `lvl` nodes above the choice's call, may stay where it is once the choice
// runs first: at the call itself as `fsAheadStays` says, or as a pure choice ahead of a pure one
// (D14651), and above it as `fsChoiceAheadOk` says.
function fsAheadKeeps(y: i32, lvl: i32, pure: boolean): boolean {
  if lvl == 0 { return fsAheadStays(y, !pure) || (pure && fsPureChoice(y, 0)) }
  fsChoiceAheadOk(y, pure)
}

// Narrows the noted expressions to those bound ahead of the choice, outer ones first, which is
// the order the source runs them. Each one that may not stay binds, and once one that binds may
// call, every one but a literal or a function's name does, and every callee object noted must
// stay. false when one that must bind cannot (`fsAheadHoists`, `fsCallHoists`).
function fsAheadBind(pure: boolean): boolean {
  let top = 0
  for l in fsAheadLvl {
    if l > top { top = l }
  }
  const par: i32[] = []
  const kid: i32[] = []
  const keep: boolean[] = []
  let calls = false
  let l = top
  while l >= 0 {
    let k = 0
    while k < fsAheadKid.length {
      if fsAheadLvl[k] == l {
        const y = fsAheadKid[k]
        const ok = fsAheadKeeps(y, l, pure)
        if !ok && !fsPureRead(y, 0) { calls = true }
        par.push(fsAheadPar[k])
        kid.push(y)
        keep.push(ok)
      }
      k = k + 1
    }
    l = l - 1
  }
  const outPar: i32[] = []
  const outKid: i32[] = []
  let k = 0
  while k < kid.length {
    const y = kid[k]
    if !keep[k] || (calls && !fsAheadStays(y, true)) {
      if !fsAheadHoists(y) && !fsCallHoists(y) { return false }
      outPar.push(par[k])
      outKid.push(y)
    }
    k = k + 1
  }
  if calls {
    for o in fsAheadObj {
      if !fsAheadStays(o, false) { return false }
    }
  }
  fsAheadPar = outPar
  fsAheadKid = outKid
  true
}

// Whether `y` calls a name or a member of a name, which a `const` binds as it is (D13541).
function fsCallHoists(y: i32): boolean {
  const n = nodeAt(y)
  n is Call && fsCalleeStays(n.callFn)
}

// Whether `y`, which the source runs ahead of a choice now run before its statement, sees and
// changes nothing that move can: for a `pure` choice it calls and writes nothing
// (`fsPureRead`), else it is a literal or a function's name.
function fsChoiceAheadOk(y: i32, pure: boolean): boolean {
  if y < 0 || y >= fsParseLen { return false }
  if pure { return fsPureRead(y, 0) }
  fsAheadStays(y, true)
}

// Whether callee `f` is a name, or a member of a name, so it runs nothing ahead of its arguments.
function fsCalleeStays(f: i32): boolean {
  if f < 0 || f >= fsParseLen { return false }
  const n = nodeAt(f)
  if n is Ident { return true }
  n is Member && nodeAt(n.memObj) is Ident
}

// Whether pure choice `v` reads an element or divides, which may trap when run where the source
// would not have run it.
function fsChoiceMayTrap(v: i32, depth: i32): boolean {
  if v < 0 || v >= P.nodes.length || depth > 64 { return true }
  const n = nodeAt(v)
  if n is Index { return true }
  if n is BinExpr && (n.binOp == "/" || n.binOp == "%") { return true }
  for k in nodeChildren(v) {
    if fsChoiceMayTrap(k, depth + 1) { return true }
  }
  false
}

// Whether choosing call `an` is passed a lambda literal, which may write a `const`'s contents or
// a parameter.
function fsChoiceTakesLambda(an: Call): boolean {
  for x in an.callArgs {
    if fsIsLambdaLit(x) { return true }
  }
  false
}

// Whether argument `x`, ahead of a choosing call, reads the same after that call runs: a literal,
// a function's name, or a parameter or `const` read when the call is passed no lambda (`lam`).
function fsAheadStays(x: i32, lam: boolean): boolean {
  const xn = nodeAt(x)
  if xn is NumLit || xn is StrLit || xn is BoolLit { return true }
  const xd = identDeclOf(x)
  if !(xn is Ident) || xd < 0 || xd >= P.nodes.length { return false }
  const dn = nodeAt(xd)
  dn is FuncDecl
    || (!lam && ((dn is LetDecl && dn.letKw == "const") || dn is Param))
}

// Whether argument `x`, ahead of a choosing call, can be bound to a `const` ahead of that call
// with no destination to type it: a binding read, a member or element read, or arithmetic
// (D10022).
function fsAheadHoists(x: i32): boolean {
  const xn = nodeAt(x)
  const op = fsBinOpAt(x)
  xn is Member
    || xn is Index
    || fsReadsBinding(x)
    || op == "+"
    || op == "-"
    || op == "*"
    || op == "/"
    || op == "%"
}

// The operator of the binary expression at `x`, or "" when `x` is none.
function fsBinOpAt(x: i32): string {
  const xn = nodeAt(x)
  if xn is BinExpr { return xn.binOp }
  ""
}

// Whether `x` reads a `let`, `const` or parameter binding.
function fsReadsBinding(x: i32): boolean {
  const xd = identDeclOf(x)
  if !(nodeAt(x) is Ident) || xd < 0 || xd >= P.nodes.length { return false }
  const dn = nodeAt(xd)
  dn is LetDecl || dn is Param
}

// Whether parse node `r` names a generic module function no other declaration shares a name with.
function fsGenericName(r: i32): boolean {
  if r < 0 || r >= fsParseLen || !(nodeAt(r) is Ident) { return false }
  const g = identDeclOf(r)
  if g < 0 || g >= fsParseLen || fsParent[g] < 0 { return false }
  const gn = nodeAt(g)
  if (
    !(gn is FuncDecl)
    || gn.fnTyParams.length == 0
    || !(nodeAt(fsParent[g]) is Program)
  ) {
    return false
  }
  let i = 0
  while i < fsParseLen {
    if i != g && fsDeclName(i) == gn.fnName { return false }
    i = i + 1
  }
  true
}

// The name parse node `i` declares, read from its stamped name token; "" when it declares none.
function fsDeclName(i: i32): string {
  const t = declNameTokOf(i)
  if t < 0 || t >= P.toks.length { return "" }
  P.toks[t].text
}

// The node a slot past the first copies for value `v`: an identity call's argument, the
// function a constant call returns, else `v`.
function fsSlotSrc(v: i32): i32 {
  const a = fsIdentityArg(v)
  const lam = fsConstLambdaOf(a)
  if lam >= 0 { return lam }
  if a >= 0 { return a }
  const r = fsConstRet(v)
  if r >= 0 { return r }
  const cr = fsConstAliasRet(v)
  if cr >= 0 { return cr }
  v
}

// The name a read `v` of an un-annotated `const` chain evaluates to when the chain ends in a
// constant call (`fsConstRet`), whose binding runs the call; -1 otherwise (D9593).
function fsConstAliasRet(v: i32): i32 {
  let x = v
  let hops = 0
  while hops <= 8 {
    const d = letDeclOfRead(x)
    if d < 0 { return -1 }
    const dn = nodeAt(d)
    if (
      !(dn is LetDecl)
      || dn.letKw != "const"
      || dn.letType >= 0
      || dn.letInit < 0
    ) {
      return -1
    }
    const r = fsConstRet(dn.letInit)
    if r >= 0 { return r }
    x = dn.letInit
    hops = hops + 1
  }
  -1
}

// Whether parse node `a` is a lambda literal, parenthesised or not, which a call can hand again
// as a fresh copy.
function fsIsLambdaLit(a: i32): boolean {
  const l = fsParenPeel(a)
  if l < 0 || l >= fsParseLen { return false }
  const f = nodeAt(l)
  f is FuncDecl && f.fnName == ""
}

// `a` with its parentheses removed, and a labelled block that only breaks out with a value
// (`labelBlockValue`) read as that value (D13461).
function fsParenPeel(a: i32): i32 {
  let x = a
  while x >= 0 && x < P.nodes.length {
    const n = nodeAt(x)
    const v = labelBlockValue(x)
    if v >= 0 { x = v }
    else if n is Paren { x = n.parInner }
    else { return x }
  }
  x
}

// The lambda an un-annotated `const` read by identifier `a` holds, when the lambda reads only its
// own and module-scope bindings, so a slot can hold a fresh copy of it (D6201); else -1.
function fsConstLambdaOf(a: i32): i32 {
  const d = letDeclOfRead(a)
  if d < 0 { return -1 }
  const dn = nodeAt(d)
  if (
    !(dn is LetDecl)
    || dn.letKw != "const"
    || dn.letType >= 0
    || dn.letInit < 0
  ) {
    return -1
  }
  const f = nodeAt(dn.letInit)
  if !(f is FuncDecl) || f.fnName != "" || !fsReadsNoLocal(dn.letInit) {
    return -1
  }
  dn.letInit
}

// How many argument types the calls through binding `d` take.
function fsLetCallKeys(d: i32): i32 {
  const ks: string[] = []
  for r in fsIdents {
    if identDeclOf(r) == d {
      const k = fsReadKey(r)
      if k.slice(0, 2) == "c:" && !hasStr(ks, k) { ks.push(k) }
    }
  }
  ks.length
}

// Whether binding `d` of a generic a call returns wants a slot per key: called at two types, or
// called at one and also delivered as a value its own slot reads afresh (D9594).
function fsLetSplitKeys(d: i32): boolean {
  const n = fsLetCallKeys(d)
  if n != 1 { return n > 1 }
  for r in fsIdents {
    if identDeclOf(r) == d && fsReadKey(r).slice(0, 2) == "u:" { return true }
  }
  false
}

// Whether read `r` is an argument of a call, with no type arguments, of a function declaration.
function fsArgOfNamedFn(r: i32): boolean {
  const c = fsParent[r]
  if c < 0 || callHasTyArgs(c) { return false }
  const cn = nodeAt(c)
  if !(cn is Call) || cn.callFn == r { return false }
  let arg = false
  for x in cn.callArgs {
    if x == r { arg = true }
  }
  const g = identDeclOf(cn.callFn)
  arg && g >= 0 && g < P.nodes.length && nodeAt(g) is FuncDecl
}

// Whether read `r` of a split parameter meets no use of type parameter `tp` but its own: a
// named function's direct argument, a value only calls without type arguments run, or a binding
// annotated bare `tp` or another of its type parameters whose reads each are, at most `depth`
// deep; a write declines. Each such annotation is pushed to `out`, to take the new name (D6703).
function fsTyParamReadSplits(
  r: i32,
  tp: string,
  depth: i32,
  out: i32[],
): boolean {
  if fsArgOfNamedFn(r) { return true }
  if fsResultSplits(r, tp, out) { return true }
  const c = fsParent[r]
  if depth <= 0 || c < 0 { return false }
  if fsReachesUntypedCalls(r) { return true }
  const cn = nodeAt(c)
  if !(cn is LetDecl) || cn.letInit != r || cn.letType < 0 { return false }
  const tn = nodeAt(cn.letType)
  if !(tn is TypeRef) || !fsSameFnTyParam(c, tn.tyName, tp) { return false }
  for x in fsIdents {
    if (
      x != c
      && identDeclOf(x) == c
      && !fsTyParamReadSplits(x, tp, depth - 1, out)
    ) {
      return false
    }
  }
  out.push(cn.letType)
  true
}

// Whether `nm` is `tp`, or a type parameter of the nearest function enclosing node `n` that
// declares `nm` when that function also declares `tp`.
function fsSameFnTyParam(n: i32, nm: string, tp: string): boolean {
  if nm == tp { return true }
  let q = fsEnclosingFn(n)
  while q >= 0 {
    const f = nodeAt(q)
    if f is FuncDecl && hasStr(f.fnTyParams, nm) {
      return hasStr(f.fnTyParams, tp)
    }
    q = fsEnclosingFn(q)
  }
  false
}

// Whether read `r` is a value its function returns, every value it returns reads the same
// binding, and the result is annotated bare `tp`; the annotation is pushed to `out`, so the
// result takes the new name with the parameter it returns (D6425).
function fsResultSplits(r: i32, tp: string, out: i32[]): boolean {
  const fd = fsEnclosingFn(r)
  if fd < 0 { return false }
  const f = nodeAt(fd)
  if !(f is FuncDecl) || f.fnRet < 0 || f.fnBody < 0 { return false }
  const tn = nodeAt(f.fnRet)
  if !(tn is TypeRef) || tn.tyName != tp { return false }
  const vals: i32[] = []
  a20CollectRets(f.fnBody, vals)
  const d = identDeclOf(r)
  let hit = false
  for v in vals {
    const u = fsParenPeel(v)
    if u < 0 || !(nodeAt(u) is Ident) || identDeclOf(u) != d { return false }
    if u == r { hit = true }
  }
  if hit && !hasI32(out, f.fnRet) { out.push(f.fnRet) }
  hit
}

// Each asked parameter, annotated with a bare type parameter of its function, takes a type
// parameter of its own; the function's other reads of the old one stay with it (D6200). A
// function called with type arguments declines. 0 with a plan, 1 with none.
function fsPlanTyParams(): i32 {
  let rc = 1
  for o in fsTpAsks {
    const p = nodeAt(o)
    const fd = fsParent[o]
    const retype: i32[] = []
    let ok = p is Param && fd >= 0 && nodeAt(fd) is FuncDecl
    let tp = ""
    if ok && p is Param {
      const f = nodeAt(fd)
      if p.parType < 0 {
        // An un-annotated one stands for a type parameter of its function the bindings it
        // seeds name (D6760).
        ok = f is FuncDecl
          && f.fnTyParams.length > 0
          && p.parDefault < 0
          && p.parRest == 0
        if ok && f is FuncDecl { tp = f.fnTyParams[0] }
      } else {
        const tn = nodeAt(p.parType)
        ok = tn is TypeRef && f is FuncDecl && hasStr(f.fnTyParams, tn.tyName)
        if tn is TypeRef { tp = tn.tyName }
      }
    }
    for r in fsIdents {
      const c = fsParent[r]
      if (
        ok
        && identDeclOf(r) == fd
        && c >= 0
        && nodeAt(c) is Call
        && callHasTyArgs(c)
      ) {
        ok = false
      }
      // The parameter is read only as a direct argument of a named function or into a binding
      // retyped with it, so no read can meet the old type parameter.
      if (
        ok
        && r != o
        && identDeclOf(r) == o
        && !fsTyParamReadSplits(r, tp, 4, retype)
      ) {
        ok = false
      }
    }
    if ok && p is Param {
      const nm = tp + "$t" + i32ToStr(o)
      psPar.push(o)
      psFn.push(fd)
      psName.push(nm)
      for t in retype {
        psRetype.push(t)
        psRetypeName.push(nm)
      }
      rc = 0
    }
  }
  rc
}

// Value `v` of a field of an un-annotated `const` record, constant call `src` (`fsConstRet`) or
// a `const` it initializes: when every read of the record reads a field and every read of this
// one calls it, the field keeps the types the `const` is called at, else its first call's, and
// a call at any other calls the function directly (D6342). 0 with a plan, 1 with none.
function fsPlanFieldSlot(v: i32, src: i32): i32 {
  let g = fsConstRet(src)
  if g < 0 && src == v && fsGenericName(v) { g = v }
  if g < 0 || v < 0 { return 1 }
  const fi = fsParent[v]
  if fi < 0 { return 1 }
  const fin = nodeAt(fi)
  if !(fin is FieldInit) || fin.fiValue != v { return 1 }
  const o = fsParent[fi]
  if o < 0 || !(nodeAt(o) is ObjLit) { return 1 }
  const d = fsParent[o]
  if d < 0 { return 1 }
  const dn = nodeAt(d)
  if (
    !(dn is LetDecl)
    || dn.letInit != o
    || dn.letType >= 0
    || dn.letKw != "const"
  ) {
    return 1
  }
  const keys: string[] = []
  const calls: i32[] = []
  let keep = ""
  let first = -1
  fsFarCalls = []
  fsFixedCalls = []
  for r in fsIdents {
    if identDeclOf(r) == d && r != d {
      const m = fsParent[r]
      if m < 0 { return 1 }
      const mn = nodeAt(m)
      const whole = !(mn is Member) || mn.memObj != r
      if whole && !fsWholeReadSkips(r, fin.fiName, 4) { return 1 }
      if mn is Member && !whole && mn.memProp == fin.fiName {
        const c = fsParent[m]
        if c < 0 || !fsCallsVia(c, m) { return 1 }
        const key = fsReadKey(m)
        if !hasStr(keys, key) { keys.push(key) }
        calls.push(c)
        if first < 0 || nodeAt(c).pos < nodeAt(calls[first]).pos {
          first = calls.length - 1
          keep = key
        }
      }
    }
  }
  for c in fsFarCalls {
    const cn = nodeAt(c)
    if cn is Call && !hasStr(keys, fsReadKey(cn.callFn)) {
      keys.push(fsReadKey(cn.callFn))
    }
    if cn is Call && first < 0 && keep == "" { keep = fsReadKey(cn.callFn) }
  }
  if keys.length < 2 { return 1 }
  const sd = letDeclOfRead(v)
  let pinned = ""
  for r in fsIdents {
    if (
      sd >= 0
      && identDeclOf(r) == sd
      && fsParent[r] >= 0
      && fsCallsVia(fsParent[r], r)
    ) {
      keep = fsReadKey(r)
      pinned = keep
    }
  }
  for c in fsFixedCalls {
    const cn = nodeAt(c)
    if !(cn is Call) { return 1 }
    const fk = fsReadKey(cn.callFn)
    if pinned != "" && fk != pinned { return 1 }
    pinned = fk
    keep = fk
  }
  const gn = nodeAt(g)
  if !(gn is Ident) { return 1 }
  // A call through a handed-on record keeps its receiver, so one at other types reads a field
  // of its own per types, holding the generic by name (D6700).
  for c in fsFarCalls {
    if !(nodeAt(c) is Call) { return 1 }
  }
  const farKeys: string[] = []
  for c in fsFarCalls {
    const cn = nodeAt(c)
    if !(cn is Call) { return 1 }
    const fk = fsReadKey(cn.callFn)
    if fk != keep {
      if !hasStr(farKeys, fk) {
        farKeys.push(fk)
        fsPlanExtraField(
          o,
          fin.fiName + "$k" + i32ToStr(farKeys.length),
          gn.identName,
        )
      }
      let ki = 0
      while ki < farKeys.length && farKeys[ki] != fk { ki += 1 }
      pxMember.push(cn.callFn)
      pxMemberName.push(fin.fiName + "$k" + i32ToStr(ki + 1))
    }
  }
  for c in calls {
    const cn = nodeAt(c)
    if cn is Call && fsReadKey(cn.callFn) != keep {
      pmCall.push(c)
      pmName.push(gn.identName)
    }
  }
  0
}

// Plans record literal `o` as a `const` declared before its call when it is an argument, to a
// declared parameter type, of a call statement whose callee is a name and whose earlier
// arguments are constants, or names while `o`'s fields are names or constants, so declaring it
// first runs nothing out of order. 0 with a plan, 1 with none.
function fsPlanHoistLit(o: i32): i32 {
  if o < 0 || o >= fsParseLen || hasI32(phLit, o) { return 1 }
  const on = nodeAt(o)
  if !(on is ObjLit) { return 1 }
  const c = fsParent[o]
  if c < 0 { return 1 }
  const cn = nodeAt(c)
  if !(cn is Call) || cn.callFn < 0 || cn.callFn >= P.nodes.length { return 1 }
  if !(nodeAt(cn.callFn) is Ident) || fsListOwner(c) < 0 { return 1 }
  let leaves = true
  for fi in on.objFields {
    const fin = nodeAt(fi)
    if (
      !(fin is FieldInit)
      || !(fsConstLeaf(fin.fiValue) || nodeAt(fin.fiValue) is Ident)
    ) {
      leaves = false
    }
  }
  let j = 0
  while j < cn.callArgs.length && cn.callArgs[j] != o {
    const x = cn.callArgs[j]
    if !fsConstLeaf(x) && !(leaves && nodeAt(x) is Ident) { return 1 }
    j += 1
  }
  if j >= cn.callArgs.length { return 1 }
  const d = fsHoleFwd(o)
  if d < 0 { return 1 }
  const pn = nodeAt(d)
  if !(pn is Param) || pn.parType < 0 { return 1 }
  phLit.push(o)
  phStmt.push(c)
  phArg.push(j)
  phName.push("lit$" + i32ToStr(o))
  0
}

// Whether parse node `x` is a constant literal, which reads nothing.
function fsConstLeaf(x: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  n is NumLit || n is StrLit || n is CharLit || n is BoolLit || n is NullLit
}

// Plans field `fld` holding function `fnName` onto record literal `o`, once however often a
// slot is planned.
function fsPlanExtraField(o: i32, fld: string, fnName: string): i32 {
  let i = 0
  while i < pxObj.length {
    if pxObj[i] == o && pxField[i] == fld { return 0 }
    i += 1
  }
  pxObj.push(o)
  pxField.push(fld)
  pxName.push(fnName)
  0
}

// Whether read `r` of a record hands it on only where field `fld` is at most called: to an
// un-annotated parameter of a declared function, or as an un-annotated `const`'s initializer,
// whose reads each read a field or hand it on again, at most `depth` times (D6371, D6473).
function fsWholeReadSkips(r: i32, fld: string, depth: i32): boolean {
  if depth <= 0 { return false }
  let d = fsHoleFwd(r)
  // A declared parameter type is a delivery this plan does not convert, so a call through it
  // is at the kept types; the parameter may only be tested with `is` or read a field (D6702).
  if d >= 0 {
    const pn = nodeAt(d)
    if pn is Param && pn.parType >= 0 {
      for x in fsIdents {
        if identDeclOf(x) == d && x != d && !fsTypedReadSkips(x, fld) {
          return false
        }
      }
      return true
    }
  }
  const c = fsParent[r]
  if d < 0 && c >= 0 {
    const cn = nodeAt(c)
    if (
      cn is LetDecl
      && cn.letInit == r
      && cn.letType < 0
      && cn.letKw == "const"
    ) {
      d = c
    }
  }
  if d < 0 && c >= 0 {
    const cn = nodeAt(c)
    // A function's result is read at each of its calls (D6424).
    if cn is RetStmt && cn.retArg == r {
      return fsCallsReadSkip(fsEnclosingFn(r), fld, depth - 1)
    }
    // An element of an un-annotated `const` list is read at each index of it (D6424).
    if cn is ArrayLit && hasI32(cn.arrElems, r) {
      return fsListReadsSkip(c, fld, depth - 1)
    }
  }
  if d < 0 { return false }
  for x in fsIdents {
    if identDeclOf(x) == d && x != d && !fsReadSkips(x, fld, depth - 1) {
      return false
    }
  }
  true
}

// The calls of the planned field made through a record handed on, for `fsPlanFieldSlot`, and
// those of them through a declared parameter type, which keep the field's name.
let fsFarCalls: i32[] = []
let fsFixedCalls: i32[] = []

// Whether read `x` of a declared record parameter is an `is` test, reads a field other than
// `fld`, or calls `fld` (pushed to `fsFarCalls` and `fsFixedCalls`).
function fsTypedReadSkips(x: i32, fld: string): boolean {
  const m = fsParent[x]
  if m < 0 { return false }
  const mn = nodeAt(m)
  if mn is IsExpr && mn.isObj == x { return true }
  if !(mn is Member) || mn.memObj != x { return false }
  if mn.memProp != fld { return true }
  const c = fsParent[m]
  if c < 0 || !fsCallsVia(c, m) { return false }
  fsFarCalls.push(c)
  fsFixedCalls.push(c)
  true
}

// Whether read `x` of a record reads a field other than `fld`, calls `fld` (pushed to
// `fsFarCalls`), or hands the record on as `fsWholeReadSkips` allows.
function fsReadSkips(x: i32, fld: string, depth: i32): boolean {
  const m = fsParent[x]
  if m < 0 { return false }
  const mn = nodeAt(m)
  if mn is Member && mn.memObj == x {
    if mn.memProp != fld { return true }
    const c = fsParent[m]
    if c < 0 || !fsCallsVia(c, m) { return false }
    fsFarCalls.push(c)
    return true
  }
  fsWholeReadSkips(x, fld, depth)
}

// Whether declared function `fd` is only ever called, and each call's result is a read
// `fsReadSkips` allows.
function fsCallsReadSkip(fd: i32, fld: string, depth: i32): boolean {
  if depth <= 0 || fd < 0 || !(nodeAt(fd) is FuncDecl) { return false }
  for x in fsIdents {
    if identDeclOf(x) == fd && x != fd {
      const c = fsParent[x]
      if c < 0 || !fsCallsVia(c, x) || !fsReadSkips(c, fld, depth) {
        return false
      }
    }
  }
  true
}

// Whether list literal `lit` initializes an un-annotated `const` every read of which indexes it,
// each element read being one `fsReadSkips` allows.
function fsListReadsSkip(lit: i32, fld: string, depth: i32): boolean {
  if depth <= 0 { return false }
  const d = fsParent[lit]
  if d < 0 { return false }
  const dn = nodeAt(d)
  if (
    !(dn is LetDecl)
    || dn.letInit != lit
    || dn.letType >= 0
    || dn.letKw != "const"
  ) {
    return false
  }
  for x in fsIdents {
    if identDeclOf(x) == d && x != d {
      const m = fsParent[x]
      if m < 0 { return false }
      const mn = nodeAt(m)
      if !(mn is Index) || mn.idxArr != x || !fsReadSkips(m, fld, depth) {
        return false
      }
    }
  }
  true
}

// The field slots of `const` `d`: each of its fields when it is a record, and each field it is
// the value of when a constant call initializes it. 0 with a plan, 1 with none.
function fsPlanFieldSlotsOf(d: i32): i32 {
  if d < 0 || d >= P.nodes.length { return 1 }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letKw != "const" || dn.letInit < 0 { return 1 }
  let rc = 1
  // A record `const` plans each of its fields.
  const o = nodeAt(dn.letInit)
  if o is ObjLit {
    for fi in o.objFields {
      const fin = nodeAt(fi)
      if fin is FieldInit {
        let src = fin.fiValue
        const sd = letDeclOfRead(src)
        if sd >= 0 {
          const sn = nodeAt(sd)
          if sn is LetDecl && sn.letKw == "const" { src = sn.letInit }
        }
        if fsPlanFieldSlot(fin.fiValue, src) == 0 { rc = 0 }
      }
    }
  }
  for q in fsIdents {
    if identDeclOf(q) == d && q != d && fsPlanFieldSlot(q, dn.letInit) == 0 {
      rc = 0
    }
  }
  rc
}

// The field slots of every call of constant maker `fd` that is a record field, or initializes a
// `const` that is one. 0 with a plan, 1 with none.
function fsPlanMakerFields(fd: i32): i32 {
  if fd < 0 || fd >= P.nodes.length || !(nodeAt(fd) is FuncDecl) { return 1 }
  let rc = 1
  for r in fsIdents {
    const c = fsParent[r]
    if (
      r != fd
      && c >= 0
      && fsCallsVia(c, r)
      && fsCallRunsFn(c) == fd
      && fsConstRet(c) >= 0
    ) {
      if fsPlanFieldSlot(c, c) == 0 { rc = 0 }
      if fsPlanFieldSlotsOf(fsParent[c]) == 0 { rc = 0 }
    }
  }
  rc
}

function fsStmtParentOk(s: i32): boolean {
  const p = fsParent[s]
  if p < 0 { return false }
  nodeAt(p) is Block || nodeAt(p) is Program
}

// Indexes program `root` for `vrCalls` in exact mode: a call it answers runs the value alone.
function fsReachIndex(root: i32) {
  const stmts: i32[] = []
  if root >= 0 && root < P.nodes.length {
    const rn = nodeAt(root)
    if rn is Program {
      for s in rn.progStmts { stmts.push(s) }
    }
  }
  vrReset(stmts, false, true)
  const cands: i32[] = []
  vrIndex(stmts, cands)
}

// Plans the slots of every asked declaration over the checked tree under `root`; 0 with a
// plan, 1 when there is nothing it can split.
export function fsPlan(root: i32): i32 {
  fsPlanReset()
  fsWalk(root)
  fsReachIndex(root)
  const lists = fsPlanLists()
  if fsAsks.length + fsTpAsks.length + fsCallAsks.length == 0 { return lists }
  fsPlanAsks()
}

// Each asked list (`fsAskList`) takes a `const` copy per function type its calls take past the
// first, and each call's read of it, or of a `const` alias of it, reads its type's copy. A read
// other than as a `for` iterable, a called element, its `.length` or an alias's value, or an
// element other than a name or a choice of names, declines that list. 0 with a plan, 1 with none.
function fsPlanLists(): i32 {
  let rc = 1
  const done: i32[] = []
  for a in fsListAsks {
    const d = fsListBase(a)
    const lanes = if d >= 0 && !hasI32(done, d) { fsListLanes(d) } else { fsNoLanes() }
    if d >= 0 { done.push(d) }
    const dn = nodeAt(if d >= 0 { d } else { a })
    // An element whose choice calls or writes runs once, before the list, as an arm index.
    if dn is LetDecl && lanes.length > 1 {
      const l = nodeAt(fsParenPeel(dn.letInit))
      if l is ArrayLit {
        let j = 0
        while j < l.arrElems.length {
          if fsHoistsChoice(l.arrElems[j]) {
            lhDecl.push(d)
            lhAt.push(j)
            lhName.push(dn.letName + "$c" + i32ToStr(l.arrElems[j]))
          }
          j = j + 1
        }
      }
    }
    let k = 1
    while dn is LetDecl && k < lanes.length {
      const copy = dn.letName + "$l" + i32ToStr(d) + "_" + i32ToStr(k)
      pdAnchor.push(d)
      pdKw.push("const")
      pdName.push(copy)
      pdTy.push(-1)
      pdValSrc.push(dn.letInit)
      pdValName.push("")
      let i = 0
      while i < flRead.length {
        if fsListBase(flDecl[i]) == d && flKey[i] == lanes[k] {
          prIdent.push(flRead[i])
          prName.push(copy)
        }
        i = i + 1
      }
      // A push onto the list pushes the same value onto the copy.
      for r in fsIdents {
        const rd = identDeclOf(r)
        if rd >= 0 && fsListBase(rd) == d && fsListPushRead(r) {
          pmStmt.push(fsParent[fsParent[r]])
          pmList.push(copy)
        }
      }
      // A loop's variable or an element `const` called at this type reads the copy at its index.
      i = 0
      while i < fcCallee.length {
        const fr = fcRead[i]
        if (
          fcKey[i] == lanes[k]
          && fsListReadKey(fr) == "!"
          && fsListBase(identDeclOf(fr)) == d
        ) {
          plCall.push(fsParent[fcCallee[i]])
          plFor.push(fsElemBinder(fr))
          plList.push(copy)
          plIdx.push("i$l" + i32ToStr(fsElemBinder(fr)))
        }
        i = i + 1
      }
      rc = 0
      k = k + 1
    }
  }
  rc
}

// The function types the calls through asked list `d` take, in note order; empty
// when the list cannot be copied or a read is called at two.
function fsListLanes(d: i32): string[] {
  const none: string[] = []
  const dn = nodeAt(d)
  if !(dn is LetDecl) { return none }
  const l = nodeAt(fsParenPeel(dn.letInit))
  if !(l is ArrayLit) { return none }
  for e in l.arrElems {
    if !(nodeAt(e) is Ident) && !fsPureChoice(e, 0) && !fsHoistsChoice(e) {
      return none
    }
  }
  for r in fsIdents {
    const rd = identDeclOf(r)
    if (
      rd >= 0
      && fsListBase(rd) == d
      && !fsListReadCopies(r)
      && !fsListAliasRead(r)
      && !fsListPushRead(r)
    ) {
      return none
    }
  }
  const lanes: string[] = []
  let i = 0
  while i < flRead.length {
    if fsListBase(flDecl[i]) == d {
      if flKey[i] == "!" {
        if !fsLoopLanes(flRead[i], lanes) { return none }
      } else if !hasStr(lanes, flKey[i]) {
        lanes.push(flKey[i])
      }
    }
    i = i + 1
  }
  lanes
}

// The function type list read `r` is noted at, "!" for two; "" when no note names `r`.
function fsListReadKey(r: i32): string {
  let i = 0
  while i < flRead.length {
    if flRead[i] == r { return flKey[i] }
    i = i + 1
  }
  ""
}

// Pushes onto `lanes` the types the calls through the name the element binder of list read `r`
// binds take, when every read of the name is a call in the binder's own function, each recorded
// one at one type (D10791, D12703, D12704).
function fsLoopLanes(r: i32, lanes: string[]): boolean {
  const p = fsElemBinder(r)
  if p < 0 { return false }
  // A loop binds its first variable; a `const` binder is its own declaration.
  const pn = nodeAt(p)
  const bd = if pn is ForIn { pn.fiDecl1 } else { p }
  for x in fsIdents {
    if x != bd && identDeclOf(x) == bd && nodeAt(x) is Ident {
      const c = fsParent[x]
      if c < 0 || !fsCallsVia(c, x) { return false }
      let i = 0
      while i < fcCallee.length && fcCallee[i] != x { i = i + 1 }
      // A call not yet met keeps the list's own instance until a later round notes it.
      if i < fcCallee.length {
        if fcRead[i] != r || fcKey[i] == "!" { return false }
        if !hasStr(lanes, fcKey[i]) { lanes.push(fcKey[i]) }
      }
    }
  }
  true
}

// Applies `plCall[i]`: its callee becomes `plList[i][plIdx[i]]`, and its binder names that index.
// -1 when `i` is no planned lane, its nodes are not a call and a binder, or the index cannot be
// named.
function fsApplyLoopLane(i: i32): i32 {
  if i < 0 || i >= plCall.length || plFor[i] < 0 { return -1 }
  const c = nodeAt(plCall[i])
  const l = nodeAt(plFor[i])
  if !(c is Call) || c.callFn < 0 { return -1 }
  P.pos = nodeToks[plCall[i]] + 1
  const pos = nodeAt(c.callFn).pos
  if l is ForIn {
    if l.fiVar2 == "" {
      l.fiVar2 = plIdx[i]
      l.fiDecl2 = mkLoopVar(plFor[i], 1, l.pos)
    }
    if (
      l.fiVar2 != plIdx[i]
      && fsLoopIndexCopy(l.fiBody, l.fiVar2, plIdx[i], pos) < 0
    ) {
      return -1
    }
  } else if fsBindIndexCopy(plFor[i], plIdx[i], pos) < 0 {
    return -1
  }
  c.callFn = mkIndex(mkIdent(plList[i], pos), mkIdent(plIdx[i], pos), pos)
  0
}

// Makes element `const` `d`, `const f = xs[e]`, read `xs[copy]` after a `const copy = e` before
// it, so a lane reads the element the binding took; once per binding. -1 for another node.
function fsBindIndexCopy(d: i32, copy: string, pos: i32): i32 {
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letInit < 0 { return -1 }
  const ix = nodeAt(dn.letInit)
  if !(ix is Index) { return -1 }
  const e = nodeAt(ix.idxIndex)
  if e is Ident && e.identName == copy { return 0 }
  const v = ix.idxIndex
  ix.idxIndex = mkIdent(copy, pos)
  fsInsertBefore(d, mkLet("const", copy, -1, v, pos))
}

// The element binder of list read `r`: the `for` loop iterating `r`, or the un-annotated `const`
// an element read `r[e]` initializes; -1 for neither.
function fsElemBinder(r: i32): i32 {
  const p = if r >= 0 { fsParent[r] } else { -1 }
  if p < 0 { return -1 }
  const pn = nodeAt(p)
  if pn is ForIn { return if pn.fiIter == r { p } else { -1 } }
  if !(pn is Index) || pn.idxArr != r { return -1 }
  const d = fsParent[p]
  if d < 0 { return -1 }
  const dn = nodeAt(d)
  if dn is LetDecl && dn.letKw == "const" && dn.letType < 0 && dn.letInit == p {
    return d
  }
  -1
}

// Makes loop body `body` start with `const copy = idx`, so a lane reads the loop's own index
// under a name the body cannot shadow; once per body. -1 when the body holds no statements.
function fsLoopIndexCopy(body: i32, idx: string, copy: string, pos: i32): i32 {
  const bn = nodeAt(body)
  if !(bn is Block) { return -1 }
  if bn.blkStmts.length > 0 {
    const s0 = nodeAt(bn.blkStmts[0])
    if s0 is LetDecl && s0.letName == copy { return 0 }
  }
  const out: i32[] = [mkLet("const", copy, -1, mkIdent(idx, pos), pos)]
  for s in bn.blkStmts { out.push(s) }
  bn.blkStmts = out
  0
}

function fsNoLanes(): string[] {
  const none: string[] = []
  none
}

// The un-annotated `const` a list literal initializes that `const` `d` is, or names through a
// chain of un-annotated `const`s; -1 when the chain ends anywhere else.
function fsListBase(d: i32): i32 {
  let c = d
  let hops = 0
  while c >= 0 && c < fsParseLen && hops < 16 {
    const cn = nodeAt(c)
    if !(cn is LetDecl) || cn.letKw != "const" || cn.letType >= 0 { return -1 }
    const x = fsParenPeel(cn.letInit)
    if x < 0 || x >= P.nodes.length { return -1 }
    if nodeAt(x) is ArrayLit { return c }
    if !(nodeAt(x) is Ident) { return -1 }
    c = identDeclOf(x)
    hops = hops + 1
  }
  -1
}

// Whether list read `r` is the whole value of an un-annotated `const` alias.
function fsListAliasRead(r: i32): boolean {
  const p = fsParent[r]
  if p < 0 { return false }
  const pn = nodeAt(p)
  pn is LetDecl
    && pn.letKw == "const"
    && pn.letType < 0
    && fsParenPeel(pn.letInit) == r
}

// Whether list read `r` can read a copy of the list: a `for` iterable, the list of an element
// read that is called or that an element `const` binds, or the list of a `.length` read.
function fsListReadCopies(r: i32): boolean {
  const p = fsParent[r]
  if p < 0 { return false }
  const pn = nodeAt(p)
  if pn is ForIn { return pn.fiIter == r }
  if pn is Member { return pn.memObj == r && pn.memProp == "length" }
  if !(pn is Index) || pn.idxArr != r { return false }
  if fsElemBinder(r) >= 0 { return true }
  const c = fsParent[p]
  c >= 0 && fsCallsVia(c, p)
}

// Whether list read `r` is the receiver of a `.push` statement whose arguments are each a name,
// a lambda or a pure choice of names, so that pushing them again onto a copy pushes the same
// functions.
function fsListPushRead(r: i32): boolean {
  const m = fsParent[r]
  if m < 0 { return false }
  const mn = nodeAt(m)
  if !(mn is Member) || mn.memObj != r || mn.memProp != "push" { return false }
  const c = fsParent[m]
  if c < 0 || !fsCallsVia(c, m) { return false }
  const s = fsParent[c]
  if s < 0 || !hasI32(fsStmtsOf(s), c) { return false }
  const cn = nodeAt(c)
  if !(cn is Call) || cn.callArgs.length == 0 { return false }
  for a in cn.callArgs {
    if (
      !(nodeAt(fsParenPeel(a)) is Ident)
      && !fsIsLambdaLit(a)
      && !fsPureChoice(a, 0)
    ) {
      return false
    }
  }
  true
}

// Applies `pmStmt[i]`: the same push onto copy `pmList[i]` follows it. -1 when it is no push.
function fsApplyPushMirror(i: i32): i32 {
  if i < 0 || i >= pmStmt.length || i >= pmList.length { return -1 }
  const c = nodeAt(pmStmt[i])
  if !(c is Call) { return -1 }
  P.pos = nodeToks[pmStmt[i]] + 1
  const pos = c.pos
  const args: i32[] = []
  for a in c.callArgs {
    const v = fsValueNode(fsParenPeel(a), "")
    if v < 0 { return -1 }
    args.push(v)
  }
  P.pos = nodeToks[pmStmt[i]] + 1
  const call = mkCall(mkMember(mkIdent(pmList[i], pos), "push", pos), args, pos)
  fsInsertAfter(pmStmt[i], call)
}

// Applies hoist `i`: the element's choice, its leaves numbered, becomes the `const` arm index
// `lhName[i]` before the list, and the element selects its leaves by it. -1 when it cannot.
function fsApplyListHoist(i: i32): i32 {
  const names: string[] = []
  lhLeaves.push(names)
  if i < 0 || i >= lhDecl.length || i >= lhAt.length || i >= lhName.length {
    return -1
  }
  const d = nodeAt(lhDecl[i])
  if !(d is LetDecl) { return -1 }
  const l = nodeAt(fsParenPeel(d.letInit))
  if !(l is ArrayLit) || lhAt[i] >= l.arrElems.length { return -1 }
  const c = l.arrElems[lhAt[i]]
  if c < 0 || c >= nodeToks.length { return -1 }
  P.pos = nodeToks[c] + 1
  const pos = nodeAt(c).pos
  if fsNumberLeaves(c, names, 0) < 0 { return -1 }
  const sel = fsSelectArm(lhName[i], names, pos)
  if sel < 0 { return -1 }
  l.arrElems[lhAt[i]] = sel
  fsInsertBefore(lhDecl[i], mkLet("const", lhName[i], -1, c, pos))
}

// Makes copy `v` of the list declared by `a` select each hoisted element by its arm index, as
// the list does. -1 when `v` is not a list holding that element.
function fsListHoistSelect(a: i32, v: i32): i32 {
  let i = 0
  while i < lhDecl.length {
    if lhDecl[i] == a {
      if v < 0 || i >= lhLeaves.length { return -1 }
      const l = nodeAt(v)
      if !(l is ArrayLit) || lhAt[i] >= l.arrElems.length { return -1 }
      const sel = fsSelectArm(lhName[i], lhLeaves[i], l.pos)
      if sel < 0 { return -1 }
      l.arrElems[lhAt[i]] = sel
    }
    i = i + 1
  }
  0
}

// Plans the asks other than lists; 0 with a plan, 1 when there is nothing it can split.
function fsPlanAsks(): i32 {
  let fields = 1
  fsAskOpenCallPars()
  const tps = fsPlanTyParams()
  // A generic read refused as an identity call's argument asks for the binding it initializes.
  let ai = 0
  while ai < fsAsks.length {
    const a = fsAsks[ai]
    if a >= 0 && a < P.nodes.length && nodeAt(a) is Ident {
      const d = fsIdentityLetOf(a)
      if d >= 0 && !hasI32(fsAsks, d) { fsAsks.push(d) }
      // A const lambda handed through identities into bindings each called at its own type
      // takes a slot per binding type (D6241).
      const cd = letDeclOfRead(a)
      if (
        fsConstLambdaOf(a) >= 0
        && fsIdentityKeyCount(cd) > 1
        && !hasI32(fsAsks, cd)
      ) {
        fsAsks.push(cd)
        fsAskIdentitySiblings(a)
      }
      // A binding refused as a hole's argument may want a slot per hole it is handed to (D6092).
      const ld = letDeclOfRead(a)
      if ld >= 0 && fsHoleFwdKeys(a).length > 0 && !hasI32(fsAsks, ld) {
        fsAsks.push(ld)
        fsAskHoleSiblings(a)
      }
    }
    // A refused function always returning one generic asks for each binding its result
    // initializes that is called at two types, as does a generic one of its returns names
    // when it returns one of several (D10021).
    const fa = fsAskedRetFn(a)
    if fa >= 0 {
      for r in fsIdents {
        const c = fsParent[r]
        let d = -1
        if (
          r != fa
          && c >= 0
          && fsCallsVia(c, r)
          && fsCallRunsFn(c) == fa
          && ((fa == a && fsConstRet(c) >= 0) || fsChoiceRetLeaves(c).length > 0)
        ) {
          d = fsParent[c]
        }
        if d >= 0 {
          const dn = nodeAt(d)
          if (
            dn is LetDecl
            && dn.letInit == c
            && dn.letType < 0
            && fsLetSplitKeys(d)
            && !hasI32(fsAsks, d)
          ) {
            fsAsks.push(d)
          }
          fsAskConstAliases(d, 0)
        }
      }
    }
    // A binding written from a hole parameter asks for the parameter, which then takes one
    // per slot (D6530).
    if a >= 0 && a < fsParseLen && nodeAt(a) is LetDecl { fsAskWrittenHoles(a) }
    // A maker's result, or a generic name it returns, may be a record field (D6342).
    if fsPlanFieldSlotsOf(a) == 0 || fsPlanMakerFields(a) == 0 { fields = 0 }
    // A generic named as a record `const`'s field plans that record's slots (D6700), and one
    // named in a record literal argument declares the literal as a `const` first (D6701).
    if a >= 0 && a < fsParseLen && nodeAt(a) is Ident && fsParent[a] >= 0 {
      const fo = fsParent[fsParent[a]]
      if (
        nodeAt(fsParent[a]) is FieldInit
        && fo >= 0
        && fsPlanFieldSlotsOf(fsParent[fo]) == 0
      ) {
        fields = 0
      }
      if (
        nodeAt(fsParent[a]) is FieldInit
        && fo >= 0
        && fsPlanHoistLit(fo) == 0
      ) {
        fields = 0
      }
    }
    if (
      a >= 0
      && a < P.nodes.length
      && nodeAt(a) is Ident
      && fsPlanMakerFields(fsEnclosingFn(a)) == 0
    ) {
      fields = 0
    }
    ai = ai + 1
  }
  // By name first, so the holes of the functions it names see the calls it makes.
  let byName = 1
  for a in fsAsks {
    if a >= 0 && a < fsParseLen && nodeAt(a) is Param && fsPlanByName(a) == 0 {
      byName = 0
    }
  }
  const holes = fsPlanHoles()
  let anyLet = false
  for a in fsAsks {
    if a >= 0 && a < P.nodes.length && nodeAt(a) is LetDecl { anyLet = true }
  }
  // Lets that need no slot leave the plan to the functions; one that half-planned declines.
  let lets = 1
  if anyLet {
    const was = prIdent.length
      + pdAnchor.length
      + pwAnchor.length
      + pcAnchor.length
    lets = fsPlanLets()
    if (
      lets != 0
      && prIdent.length + pdAnchor.length + pwAnchor.length + pcAnchor.length
        != was
    ) {
      return 1
    }
    // A declined let plan leaves every binding its own name for the hole rewrites.
    if lets != 0 {
      fsMem = []
      fsLanes = []
    }
  }
  let fns = 1
  for a in fsAsks {
    if (
      a >= 0
      && a < P.nodes.length
      && nodeAt(a) is FuncDecl
      && fsPlanFn(a) == 0
    ) {
      fns = 0
    }
  }
  if holes == 0 { fsPlanHoleRewrites() }
  if holes == 0 || fns == 0 { return 0 }
  // A let plan keeps a read in a body called at two keys to one slot, which the body's copies
  // then split (D6321).
  if lets == 0 || fields == 0 || tps == 0 {
    fsPlanInstances()
    return 0
  }
  const inst = fsPlanInstances()
  if byName == 0 { return 0 }
  inst
}

// The function asked node `a` is, or the one whose `return` reads it; -1 for neither.
function fsAskedRetFn(a: i32): i32 {
  if a < 0 || a >= P.nodes.length || a >= fsParent.length { return -1 }
  if nodeAt(a) is FuncDecl { return a }
  const p = fsParent[a]
  if !(nodeAt(a) is Ident) || p < 0 { return -1 }
  const pn = nodeAt(p)
  if !(pn is RetStmt) || pn.retArg != a { return -1 }
  fsEnclosingFn(a)
}

// Asks for each un-annotated `const` initialized by a bare read of binding `d`, at most `depth`
// links down a chain of them, that is called at two types (D9593).
function fsAskConstAliases(d: i32, depth: i32) {
  if d < 0 || depth > 8 { return 0 }
  for r in fsIdents {
    const a = fsParent[r]
    if r != d && identDeclOf(r) == d && a >= 0 {
      const an = nodeAt(a)
      if (
        an is LetDecl
        && an.letKw == "const"
        && an.letInit == r
        && an.letType < 0
      ) {
        if fsLetSplitKeys(a) && !hasI32(fsAsks, a) { fsAsks.push(a) }
        fsAskConstAliases(a, depth + 1)
      }
    }
  }
  0
}

// An asked maker (the function holding an asked read) or module `const`, read in a function
// called at two keys, that no other plan splits: a copy of that function per key, each reading
// a copy of the declaration of its own (D6205, D6206). 1 with no plan.
function fsPlanInstances(): i32 {
  fiDeps = []
  fiClaimed = []
  fiClaimBy = []
  for a in fsAsks {
    let d = -1
    if a >= 0 && a < fsParseLen && nodeAt(a) is Ident { d = fsEnclosingFn(a) }
    if a >= 0 && a < fsParseLen && nodeAt(a) is LetDecl { d = a }
    if fsInstanceDepOk(d) && !hasI32(fiDeps, d) { fiDeps.push(d) }
    // The emitter stops at the first such read, so every maker of the same generic is one.
    if a >= 0 && a < fsParseLen && nodeAt(a) is Ident {
      const k = identDeclOf(a)
      for r in fsIdents {
        if k >= 0 && r != k && identDeclOf(r) == k {
          const m = fsEnclosingFn(r)
          if m != k && fsInstanceDepOk(m) && !hasI32(fiDeps, m) {
            fiDeps.push(m)
          }
        }
      }
    }
  }
  // A function reading a dependency, itself called at one key, is a dependency too.
  let changed = true
  while changed {
    changed = false
    for r in fsIdents {
      const g = fsInstanceReader(r)
      if (
        g >= 0
        && !hasI32(fiDeps, g)
        && fsInstanceDepOk(g)
        && fsInstanceKeys(g).length == 1
      ) {
        fiDeps.push(g)
        changed = true
      }
    }
  }
  const bodies: i32[] = []
  for r in fsIdents {
    const g = fsInstanceReader(r)
    if g >= 0 && !hasI32(fiDeps, g) && !hasI32(bodies, g) { bodies.push(g) }
  }
  // An ask inside a module function called at two keys is copied with that body (D6322). A
  // `let` the let plan split is not: a copy is a fresh parse without its slots, and each
  // instance of the one body already reads its own slots (D9131).
  for a in fsAsks {
    if a >= 0 && a < fsParseLen && !fsInstanceDepOk(a) && !fsLetSplit(a) {
      const g = fsTopStmt(a)
      if (
        g >= 0
        && g != a
        && nodeAt(g) is FuncDecl
        && !hasI32(fiDeps, g)
        && !hasI32(bodies, g)
      ) {
        bodies.push(g)
      }
    }
  }
  let rc = 1
  for g in bodies {
    if fsPlanInstanceBody(g) == 0 { rc = 0 }
  }
  rc
}

// Whether the let plan gave asked binding `a` more than one slot.
function fsLetSplit(a: i32): boolean {
  const mi = memIx(a)
  mi >= 0 && mi < fsLanes.length && fsLanes[mi].length > 1
}

// The dependencies of the instance plan.
let fiDeps: i32[] = []

// The function holding read `r` when `r` reads a dependency in a way a copy can rename, else -1.
function fsInstanceReader(r: i32): i32 {
  const d = identDeclOf(r)
  if r == d || !hasI32(fiDeps, d) || !fsInstanceReadOk(r, d) { return -1 }
  const g = fsEnclosingFn(r)
  if g == d { return -1 }
  g
}

// Whether `d` can take a copy per instance of a function reading it: a named module-scope
// function, or a never-written un-annotated module binding whose slot value is a name.
function fsInstanceDepOk(d: i32): boolean {
  if d < 0 || d >= fsParseLen || fsParent[d] < 0 { return false }
  if !(nodeAt(fsParent[d]) is Program) { return false }
  const n = nodeAt(d)
  if n is FuncDecl { return n.fnName != "" }
  if !(n is LetDecl) || n.letType >= 0 || n.letInit < 0 { return false }
  if n.letKw != "const" && fsBindingWritten(d) { return false }
  nodeAt(fsSlotSrc(n.letInit)) is Ident
}

// Whether an assignment or compound assignment writes binding `d`.
function fsBindingWritten(d: i32): boolean {
  for r in fsIdents {
    if identDeclOf(r) == d && fsParent[r] >= 0 {
      const w = nodeAt(fsParent[r])
      if (
        w is BinExpr
        && w.binLeft == r
        && (w.binOp == "=" || w.binCompound != "")
      ) {
        return true
      }
    }
  }
  false
}

// Whether read `r` of dependency `d` can be renamed to a copy: a function is read as a callee.
function fsInstanceReadOk(r: i32, d: i32): boolean {
  if !(nodeAt(d) is FuncDecl) { return true }
  const c = fsParent[r]
  if c < 0 { return false }
  const cn = nodeAt(c)
  cn is Call && cn.callFn == r
}

// The call keys of named module function `g`; empty unless every read is a call from outside it.
function fsInstanceKeys(g: i32): string[] {
  const keys: string[] = []
  const f = nodeAt(g)
  if !(f is FuncDecl) || f.fnName == "" || fsParent[g] < 0 { return [] }
  if !(nodeAt(fsParent[g]) is Program) { return [] }
  for r in fsIdents {
    if identDeclOf(r) == g && r != g {
      const c = fsParent[r]
      if c < 0 || fsUnder(r, g) { return [] }
      const cn = nodeAt(c)
      if !(cn is Call) || cn.callFn != r { return [] }
      const key = fsReadKey(r)
      if !hasStr(keys, key) { keys.push(key) }
    }
  }
  keys
}

// Body `g`'s share: a copy per call key past the first, each call renamed to its key's copy,
// and every lane's dependency reads renamed to copies of its own, except where lane 0 can claim
// the original, so no original is left unread. 1 when `g` has fewer than two keys.
function fsPlanInstanceBody(g: i32): i32 {
  const f = nodeAt(g)
  const keys = fsInstanceKeys(g)
  if keys.length < 2 || hasI32(pfSrc, g) || fsByNameFn(g) || !(f is FuncDecl) {
    return 1
  }
  let k = 0
  while k < keys.length {
    let copy = -1
    if k > 0 {
      copy = pfSrc.length
      const nm = f.fnName + "$i" + i32ToStr(g) + "_" + i32ToStr(k)
      pfSrc.push(g)
      pfAnchor.push(g)
      pfName.push(nm)
      for r in fsIdents {
        if identDeclOf(r) == g && r != g && fsReadKey(r) == keys[k] {
          fsRename(r, nm)
        }
      }
    }
    for r in fsIdents {
      if fsInstanceReader(r) >= 0 && fsUnder(r, g) {
        const d = identDeclOf(r)
        if copy >= 0 {
          fsCopyRename(copy, r, fsInstanceDepCopy(d, g, k))
        } else if !fsInstanceClaim(d, g) {
          fsRename(r, fsInstanceDepCopy(d, g, k))
        }
      }
    }
    k = k + 1
  }
  0
}

// The dependencies whose original lane 0 of body `fiClaimBy[i]` reads.
let fiClaimed: i32[] = []
let fiClaimBy: i32[] = []

// Whether body `g` can read dependency `d` and every dependency it reads as the originals,
// claiming them when no other body has.
function fsInstanceClaim(d: i32, g: i32): boolean {
  const todo: i32[] = [d]
  const seen: i32[] = []
  while todo.length > 0 {
    const x = todo.pop()
    if !hasI32(seen, x) {
      seen.push(x)
      let i = 0
      while i < fiClaimed.length {
        if fiClaimed[i] == x && fiClaimBy[i] != g { return false }
        i = i + 1
      }
      for r in fsIdents {
        if fsInstanceReader(r) >= 0 && fsUnder(r, x) {
          todo.push(identDeclOf(r))
        }
      }
    }
  }
  for x in seen {
    fiClaimed.push(x)
    fiClaimBy.push(g)
  }
  true
}

// Inside copy `copy`, the identifier matching parse node `r` is renamed `to`.
function fsCopyRename(copy: i32, r: i32, to: string): i32 {
  const n = nodeAt(r)
  if !(n is Ident) { return 0 }
  pcCopy.push(copy)
  pcPos.push(n.pos)
  pcFrom.push(n.identName)
  pcTo.push(to)
  0
}

// The name of dependency `d`'s copy for lane `k` of body `g`, planned on first use; a function's
// copy reads the same lane's copies of the dependencies it reads.
function fsInstanceDepCopy(d: i32, g: i32, k: i32): string {
  const nm = fsDeclName(d)
    + "$i"
    + i32ToStr(d)
    + "_"
    + i32ToStr(g)
    + "_"
    + i32ToStr(k)
  if hasStr(pfName, nm) || hasStr(pdName, nm) { return nm }
  const n = nodeAt(d)
  if n is FuncDecl {
    const copy = pfSrc.length
    pfSrc.push(d)
    pfAnchor.push(d)
    pfName.push(nm)
    for r in fsIdents {
      if fsInstanceReader(r) >= 0 && fsUnder(r, d) {
        fsCopyRename(copy, r, fsInstanceDepCopy(identDeclOf(r), g, k))
      }
    }
    return nm
  }
  if n is LetDecl {
    pdAnchor.push(d)
    pdKw.push(n.letKw)
    pdName.push(nm)
    pdTy.push(-1)
    pdValSrc.push(fsSlotSrc(n.letInit))
    pdValName.push("")
    return nm
  }
  fsExcludedName(nm, "a dependency that is not a function or a binding")
}

// `nm`, the answer for the kinds a ladder does not handle, which `why` names.
function fsExcludedName(nm: string, _why: string): string { nm }

// The result key of call `c` of an asked function: the slot keys of the binding its result
// initializes when every read of it is a call, the call's own when it is called at once, else
// a key of its own.
function fsCallResultKey(c: i32): string {
  const p = fsParent[c]
  if p < 0 { return "u:" + i32ToStr(c) }
  const pn = nodeAt(p)
  if pn is Call && pn.callFn == c { return fsReadKey(c) }
  if pn is LetDecl && pn.letInit == c && pn.letType < 0 {
    let k = "l:"
    for r in fsIdents {
      if identDeclOf(r) == p {
        const rk = fsReadKey(r)
        if rk.slice(0, 2) != "c:" { return "u:" + i32ToStr(c) }
        if k.indexOf(";" + rk + ";") < 0 { k = k + ";" + rk + ";" }
      }
    }
    return k
  }
  // A field of a record binding keys by the calls of that field (D6341).
  const o = fsParent[p]
  let d = -1
  if pn is FieldInit && pn.fiValue == c && o >= 0 && nodeAt(o) is ObjLit {
    d = fsParent[o]
  }
  if d >= 0 && pn is FieldInit {
    const dn = nodeAt(d)
    if dn is LetDecl && dn.letInit == o && dn.letType < 0 {
      let k = "l:"
      for r in fsIdents {
        if identDeclOf(r) == d && r != d {
          const m = fsParent[r]
          if m < 0 { return "u:" + i32ToStr(c) }
          const mn = nodeAt(m)
          if !(mn is Member) { return "u:" + i32ToStr(c) }
          if mn.memProp == pn.fiName {
            const rk = fsReadKey(m)
            if rk.slice(0, 2) != "c:" { return "u:" + i32ToStr(c) }
            if k.indexOf(";" + rk + ";") < 0 { k = k + ";" + rk + ";" }
          }
        }
      }
      return k
    }
  }
  "u:" + i32ToStr(c)
}

// Whether parse node `x` lies inside node `m`'s subtree, `m` itself included.
function fsUnder(x: i32, m: i32): boolean {
  let p = x
  while p >= 0 {
    if p == m { return true }
    p = fsParent[p]
  }
  false
}

// The module statement holding node `m`, or -1.
function fsTopStmt(m: i32): i32 {
  let s = m
  while s >= 0 && fsParent[s] >= 0 {
    if nodeAt(fsParent[s]) is Program { return s }
    s = fsParent[s]
  }
  -1
}

// Whether function `m` reads only its own bindings and module-scope ones, so a copy of it
// placed at module scope means the same.
function fsReadsNoLocal(m: i32): boolean {
  for r in fsIdents {
    if fsUnder(r, m) {
      const d = identDeclOf(r)
      if d >= 0 && !fsUnder(d, m) {
        const p = fsParent[d]
        if p < 0 || !(nodeAt(p) is Program) { return false }
      }
    }
  }
  true
}

// Function `m`, asked for returning a generic its results call at two types: one copy of it per
// result key past the first, placed after its module statement, or after `m` in its block when
// it reads a local, with each read of that key renamed to its copy (D5971). A read that
// is not a call takes a key of its own. 1 when its reads share one key.
function fsPlanFn(m: i32): i32 {
  const f = nodeAt(m)
  if !(f is FuncDecl) || f.fnName == "" || fsParent[m] < 0 || fsByNameFn(m) {
    return 1
  }
  let top = fsTopStmt(m)
  if top < 0 { return 1 }
  if top != m {
    if !(nodeAt(fsParent[m]) is Block) { return 1 }
    if !fsReadsNoLocal(m) { top = m }
  }
  const keys: string[] = []
  const calls: i32[] = []
  const lanes: i32[] = []
  for r in fsIdents {
    if identDeclOf(r) == m && r != m {
      const c = fsParent[r]
      if c < 0 { return 1 }
      const cn = nodeAt(c)
      let key = "v:" + i32ToStr(r)
      if cn is Call && cn.callFn == r { key = fsCallResultKey(c) }
      let k = 0
      while k < keys.length && keys[k] != key { k = k + 1 }
      if k == keys.length { keys.push(key) }
      calls.push(r)
      lanes.push(k)
    }
  }
  if keys.length < 2 { return 1 }
  let k = 1
  while k < keys.length {
    const nm = f.fnName + "$s" + i32ToStr(m) + "_" + i32ToStr(k)
    pfSrc.push(m)
    pfAnchor.push(top)
    pfName.push(nm)
    let i = 0
    while i < calls.length {
      if lanes[i] == k { fsRename(calls[i], nm) }
      i = i + 1
    }
    k = k + 1
  }
  0
}

// A hole parameter whose reads call a generic function at two argument types takes a parameter
// per type (D5611): each call hands the value once per parameter, each read takes its call's,
// and a forward into another function's hole splits that hole too. The split parameters, their
// keys, and the call arguments handed once per key.
let hsPar: i32[] = []
let hsKeys: string[][] = []
let hdRead: i32[] = []
let hdKeys: string[][] = []
let hdPar: i32[] = []
// The same, for a call made in by-name copy `hcCopy`, which hands its argument by name.
let hcCopy: i32[] = []
let hcRead: i32[] = []
let hcPar: i32[] = []
// A parameter read `hpRead` handed by call `hpCall` to split parameter `hpPar`.
let hpCall: i32[] = []
let hpRead: i32[] = []
let hpPar: i32[] = []
let hsBad = false
let hsCopyDepth = 0

function hdIx(r: i32): i32 {
  let i = 0
  while i < hdRead.length {
    if hdRead[i] == r { return i }
    i = i + 1
  }
  -1
}

function hsIx(par: i32): i32 {
  let i = 0
  while i < hsPar.length {
    if hsPar[i] == par { return i }
    i = i + 1
  }
  -1
}

// The declaration function `fd`'s reads name: `fd` for a named function, the binding a lambda
// initializes (D6212); -1 for any other.
function fsFnOwner(fd: i32): i32 {
  if fd < 0 || fd >= fsParseLen { return -1 }
  const f = nodeAt(fd)
  if !(f is FuncDecl) { return -1 }
  if f.fnName != "" { return fd }
  const d = fsParent[fd]
  if d < 0 { return -1 }
  const dn = nodeAt(d)
  if dn is LetDecl && dn.letInit == fd && dn.letType < 0 { return d }
  -1
}

// Whether parameter `par` can take a parameter per type: an un-annotated or bare type-parameter
// parameter of a named function, exported or not (D6204), or of a lambda a binding holds (D6212),
// every read of which is a call, by its name or through a `const` alias (D6261), passing every
// parameter without a default one argument, by position or by name in any order (D6260, D6281).
function fsHoleParamOk(par: i32): boolean {
  if par < 0 || par >= fsParseLen || fsParent[par] < 0 { return false }
  const p = nodeAt(par)
  const fd = fsParent[par]
  const f = nodeAt(fd)
  const own = fsFnOwner(fd)
  if !(p is Param) || !(f is FuncDecl) || own < 0 { return false }
  if p.parDefault >= 0 || p.parOpt != 0 || p.parRest != 0 { return false }
  if p.parType >= 0 {
    const tn = nodeAt(p.parType)
    if !(tn is TypeRef) || !hasStr(f.fnTyParams, tn.tyName) { return false }
  }
  if !fsStmtParentOk(own) { return false }
  for c in fsFnCalls(own) {
    if c < 0 { return false }
    const cn = nodeAt(c)
    if !(cn is Call) || cn.callArgs.length > f.fnParams.length { return false }
    // A parameter with a default may go without an argument (D6707).
    const ord = fsArgsInParamOrder(cn, f)
    let q = 0
    while q < f.fnParams.length {
      let a = -1
      if q < ord.length { a = ord[q] }
      const qn = nodeAt(f.fnParams[q])
      if a < 0 && !(qn is Param && (qn.parDefault >= 0 || qn.parOpt != 0)) {
        return false
      }
      q = q + 1
    }
  }
  true
}

// The calls of function `fd`, by its name or through un-annotated `const` aliases of it; a -1
// among them marks a read that is neither. `fsFnCallsCopy` takes, per call, the by-name copy
// it is made in, or -1 for the parse itself.
let fsFnCallsCopy: i32[] = []
function fsFnCalls(fd: i32): i32[] {
  const calls: i32[] = []
  const cps: i32[] = []
  const decls: i32[] = [fd]
  let di = 0
  while di < decls.length {
    const d = decls[di]
    di = di + 1
    for r in fsIdents {
      if identDeclOf(r) == d && r != d && !hasI32(pkArg, r) {
        const c = fsParent[r]
        const cn = nodeAt(c)
        if c < 0 {
          calls.push(-1)
        } else if cn is Call && cn.callFn == r {
          calls.push(c)
        } else if fsFnAliasInit(c) == r && !hasI32(decls, c) {
          decls.push(c)
        } else if fsIfCalleeCallOf(r) >= 0 {
          // An `if` arm of a callee `if` is called by that call (D7848).
          calls.push(fsIfCalleeCallOf(r))
        } else if fsIfJoinLetOf(r) >= 0 {
          // An `if` arm a `const` holds is called through that binding's reads (D7183).
          if !hasI32(decls, fsIfJoinLetOf(r)) { decls.push(fsIfJoinLetOf(r)) }
        } else if fsIfArmElemOf(r) >= 0 {
          // An `if` arm a list element ends in is called through the literal's reads (D7183).
          for lc in vrCalls(fsIfArmElemOf(r), "") { calls.push(lc) }
        } else if cn is BinExpr && (cn.binOp == "==" || cn.binOp == "!=") {
          // A comparison reads the function's identity and calls nothing.
        } else if cn is ArrayLit || cn is FieldInit {
          // A list element or record field is called through the literal's reads (D6791).
          for lc in vrCalls(r, "") { calls.push(lc) }
        } else {
          calls.push(-1)
        }
        while cps.length < calls.length { cps.push(-1) }
      }
    }
    // A parameter planned by name to this function calls it at each of its reads, in the
    // function itself or in a copy of it.
    let i = 0
    while i < pkPar.length {
      if pkDecl[i] == d {
        for r in fsIdents {
          if identDeclOf(r) == pkPar[i] {
            calls.push(fsParent[r])
            cps.push(-1)
          }
        }
      }
      i = i + 1
    }
    i = 0
    while i < pqCopy.length {
      if pqDecl[i] == d {
        for r in fsIdents {
          if identDeclOf(r) == pqPar[i] {
            calls.push(fsParent[r])
            cps.push(pqCopy[i])
          }
        }
      }
      i = i + 1
    }
  }
  fsFnCallsCopy = cps
  calls
}

// The un-annotated `const` binding whose initializer is an `if` with an `else`, one of whose
// arms ends in read `r`; -1 otherwise.
function fsIfJoinLetOf(r: i32): i32 {
  const i = fsIfArmOf(r)
  if i < 0 { return -1 }
  const d = fsParent[i]
  if d < 0 || d >= fsParseLen { return -1 }
  const dn = nodeAt(d)
  if (
    !(dn is LetDecl)
    || dn.letKw != "const"
    || dn.letType >= 0
    || dn.letInit != i
  ) {
    return -1
  }
  d
}

// The call whose callee, through parentheses, is an `if` with an `else` one of whose arms ends
// in read `r`, directly or through further such `if`s; -1 otherwise.
function fsIfCalleeCallOf(r: i32): i32 {
  const i = fsIfCalleeIfOf(r)
  if i < 0 { return -1 }
  let c = fsParent[i]
  while c >= 0 && c < fsParseLen && nodeAt(c) is Paren { c = fsParent[c] }
  if c < 0 || c >= fsParseLen { return -1 }
  const cn = nodeAt(c)
  if !(cn is Call) || fsParenPeel(cn.callFn) != i { return -1 }
  c
}

// The outermost `if` with an `else` read `r` ends an arm of, through `if`s ending an arm of
// another; -1 when `r` ends no arm.
function fsIfCalleeIfOf(r: i32): i32 {
  let i = fsIfArmOf(r)
  let hops = 0
  while i >= 0 && hops < fsParseLen {
    const p = fsParent[i]
    if p < 0 || p >= fsParseLen { return i }
    const pn = nodeAt(p)
    let up = -1
    if pn is IfStmt && pn.ifElse == i { up = p } else { up = fsIfArmOf(i) }
    if up < 0 { return i }
    i = up
    hops = hops + 1
  }
  i
}

// The `if` with an `else` a list literal holds as an element, one of whose arms ends in read
// `r`; -1 otherwise.
function fsIfArmElemOf(r: i32): i32 {
  const i = fsIfArmOf(r)
  if i < 0 { return -1 }
  const l = fsParent[i]
  if l < 0 || l >= fsParseLen || !(nodeAt(l) is ArrayLit) { return -1 }
  i
}

// The `if` with an `else` one of whose arms ends in read `r`; -1 otherwise.
function fsIfArmOf(r: i32): i32 {
  const b = fsParent[r]
  if b < 0 || !(nodeAt(b) is Block) { return -1 }
  const bn = nodeAt(b)
  if bn is Block {
    if bn.blkStmts.length == 0 || bn.blkStmts[bn.blkStmts.length - 1] != r {
      return -1
    }
  }
  const i = fsParent[b]
  if i < 0 { return -1 }
  const inode = nodeAt(i)
  if !(inode is IfStmt) { return -1 }
  if inode.ifElse < 0 || (inode.ifThen != b && inode.ifElse != b) { return -1 }
  i
}

// The initializer of `d` when it is an un-annotated `const` binding initialized by a name, else -1.
function fsFnAliasInit(d: i32): i32 {
  if d < 0 || d >= fsParseLen { return -1 }
  const dn = nodeAt(d)
  if (
    !(dn is LetDecl)
    || dn.letKw != "const"
    || dn.letType >= 0
    || dn.letInit < 0
  ) {
    return -1
  }
  if !(nodeAt(dn.letInit) is Ident) { return -1 }
  dn.letInit
}

// The declared function name node `f` calls, directly or through `const` aliases, or -1.
function fsCalleeFn(f: i32): i32 {
  let x = f
  let hops = 0
  while (
    x >= 0
    && x < P.nodes.length
    && nodeAt(x) is Ident
    && hops < fsParseLen
  ) {
    const g = identDeclOf(x)
    if g < 0 || g >= fsParseLen { return -1 }
    if nodeAt(g) is FuncDecl { return g }
    x = fsFnAliasInit(g)
    hops = hops + 1
  }
  -1
}

// The arguments of call `cn` in `f`'s parameter order, -1 for a parameter it does not pass, then
// any it cannot place.
function fsArgsInParamOrder(cn: Call, f: FuncDecl): i32[] {
  if !hasNamedArgs(cn.callArgNames) { return cn.callArgs }
  const names: string[] = []
  for q in f.fnParams {
    const qn = nodeAt(q)
    if qn is Param { names.push(qn.parName) } else { names.push("") }
  }
  orderArgsByParamNames(names, cn.callArgs, cn.callArgNames)
}

// The index among `f`'s parameters that argument `i` of call `cn` passes, or -1.
function fsParamOfArg(cn: Call, f: FuncDecl, i: i32): i32 {
  if i < 0 || i >= cn.callArgs.length { return -1 }
  const ord = fsArgsInParamOrder(cn, f)
  let j = 0
  while j < ord.length && j < f.fnParams.length {
    if ord[j] == cn.callArgs[i] { return j }
    j = j + 1
  }
  -1
}

// The argument of call `cn` that passes `f`'s parameter `j`, or -1.
function fsArgOfParam(cn: Call, f: FuncDecl, j: i32): i32 {
  const ord = fsArgsInParamOrder(cn, f)
  if j < 0 || j >= ord.length || j >= f.fnParams.length { return -1 }
  ord[j]
}

// The parameter read `r` is handed to as an argument of a call of a declared function, or -1.
function fsHoleFwd(r: i32): i32 {
  const c = fsParent[r]
  if c < 0 { return -1 }
  const cn = nodeAt(c)
  if !(cn is Call) || cn.callFn == r { return -1 }
  const g = fsCalleeFn(cn.callFn)
  if g < 0 { return -1 }
  const gn = nodeAt(g)
  if !(gn is FuncDecl) { return -1 }
  let i = 0
  while i < cn.callArgs.length && cn.callArgs[i] != r { i = i + 1 }
  if i >= cn.callArgs.length { return -1 }
  const j = fsParamOfArg(cn, gn, i)
  if j < 0 { return -1 }
  gn.fnParams[j]
}

// The parameters read `r` is handed to as an argument of a call through list elements or `if`
// arms naming declared functions, one per function the call reaches (D7845); empty otherwise.
function fsHoleElemFwds(r: i32): i32[] {
  const out: i32[] = []
  const c = fsParent[r]
  if c < 0 || c >= fsParseLen { return out }
  const cn = nodeAt(c)
  if !(cn is Call) || cn.callFn == r || fsCalleeFn(cn.callFn) >= 0 {
    return out
  }
  let i = 0
  while i < cn.callArgs.length && cn.callArgs[i] != r { i = i + 1 }
  if i >= cn.callArgs.length { return out }
  const done: i32[] = []
  for e in fsIdents {
    const ed = identDeclOf(e)
    const p = fsParent[e]
    if ed >= 0 && ed < fsParseLen && p >= 0 && !hasI32(done, ed) {
      const edn = nodeAt(ed)
      const listed = nodeAt(p) is ArrayLit
        || fsIfArmOf(e) >= 0
        || fsIfCalleeCallOf(e) >= 0
      if edn is FuncDecl && listed {
        done.push(ed)
        if hasI32(fsFnCalls(fsFnOwner(ed)), c) {
          const j = fsParamOfArg(cn, edn, i)
          if j < 0 { return [-1] }
          out.push(edn.fnParams[j])
        }
      }
    }
  }
  out
}

// The keys element parameters `eqs`, one per function a list call reaches, are called at
// between them, in order.
function fsElemFwdKeys(eqs: i32[]): string[] {
  const ks: string[] = []
  for eq in eqs {
    for k in fsQuietHoleKeys(eq) {
      if !hasStr(ks, k) { ks.push(k) }
    }
  }
  ks
}

// The argument-type keys parameter `par` is called at, through every hole it reaches by
// forwards, a cycle among them included (D6091, D6202, D6203); sets `hsBad` when a reached hole
// cannot take a parameter per type, or a read of one is neither a call, a forward nor a copy
// into a binding read at one key (D6470).
function fsHoleKeys(par: i32): string[] {
  const ks: string[] = []
  const seen: i32[] = [par]
  let si = 0
  while si < seen.length {
    const h = seen[si]
    si = si + 1
    if !fsHoleParamOk(h) {
      hsBad = true
      return ks
    }
    for r in fsIdents {
      if identDeclOf(r) == h {
        const cn = nodeAt(fsParent[r])
        if cn is Call && cn.callFn == r {
          const k = fsReadKey(r)
          if !hasStr(ks, k) { ks.push(k) }
        } else {
          const cks = fsHoleCopyKeys(r)
          if cks.length > 0 && cks[0] == "!" {
            hsBad = true
            return ks
          }
          if cks.length > 0 {
            for ck in cks {
              if !hasStr(ks, ck) { ks.push(ck) }
            }
          } else {
            const q = fsHoleFwd(r)
            const dk = fsFixedDeliveryKey(r, q)
            const lcs = fsListElemCalls(r)
            if dk != "" {
              if !hasStr(ks, dk) { ks.push(dk) }
            } else if lcs.length > 0 {
              for lc in lcs {
                const lk = fsListElemCallKey(lc)
                if !hasStr(ks, lk) { ks.push(lk) }
              }
            } else if q < 0 {
              // A call through list elements forwards to each element's parameter (D7845).
              const eqs = fsHoleElemFwds(r)
              if eqs.length == 0 || hasI32(eqs, -1) {
                hsBad = true
                return ks
              }
              for eq in eqs {
                if !hasI32(seen, eq) { seen.push(eq) }
              }
            } else if !hasI32(seen, q) {
              seen.push(q)
            }
          }
        }
      }
    }
  }
  ks
}

// The calls of hole read `r`'s element of the un-annotated `const` list it is an element of,
// when every element reads `r`'s binding, nothing writes it, and every read of the list calls
// `xs[k]` at a literal index in range, so each call can name the binding directly (D9653);
// else empty. A list holds its elements, not the binding they are read from.
function fsListElemCalls(r: i32): i32[] {
  const none: i32[] = []
  const l = fsParent[r]
  if l < 0 || l >= fsParseLen { return none }
  const ln = nodeAt(l)
  if !(ln is ArrayLit) { return none }
  const d = fsParent[l]
  if d < 0 || d >= fsParseLen { return none }
  const dn = nodeAt(d)
  if (
    !(dn is LetDecl)
    || dn.letKw != "const"
    || dn.letType >= 0
    || dn.letInit != l
  ) {
    return none
  }
  const h = identDeclOf(r)
  if h < 0 || fsBindingWritten(h) { return none }
  let at = ""
  let j = 0
  while j < ln.arrElems.length {
    const e = ln.arrElems[j]
    if e < 0 || !(nodeAt(e) is Ident) || identDeclOf(e) != h { return none }
    if e == r { at = i32ToStr(j) }
    j = j + 1
  }
  const out: i32[] = []
  for x in fsIdents {
    if identDeclOf(x) == d && x != d {
      const ix = fsParent[x]
      if ix < 0 || ix >= fsParseLen { return none }
      const xn = nodeAt(ix)
      if !(xn is Index) || xn.idxArr != x { return none }
      const kn = nodeAt(xn.idxIndex)
      if !(kn is NumLit) { return none }
      let k = 0
      while k < ln.arrElems.length && i32ToStr(k) != kn.numText { k = k + 1 }
      if k == ln.arrElems.length { return none }
      const c = fsParent[ix]
      if c < 0 || c >= fsParseLen { return none }
      const cn = nodeAt(c)
      if !(cn is Call) || cn.callFn != ix { return none }
      if kn.numText == at { out.push(c) }
    }
  }
  out
}

// The key call `c` of a listed hole calls it at.
function fsListElemCallKey(c: i32): string {
  const cn = nodeAt(c)
  if cn is Call { return fsCallKey(cn, 0) }
  "!"
}

// The call key of hole read `r` handed bare to a closed function type, which calls it at that
// type's parameters (D6741); "" when `r` is handed to a hole `q` can split, or to nothing closed.
function fsFixedDeliveryKey(r: i32, q: i32): string {
  if (q >= 0 && fsHoleParamOk(q)) || !fsDestFixed(r) { return "" }
  const f = tyAt(fsDestTy(r))
  if !(f is TyFunc) { return "" }
  let k = "c:"
  for t in f.fnParamTypes { k = k + tyToStr(t) + "," }
  k
}

// The binding hole read `r` is copied into (`d = r`, `let d = r`), or -1.
function fsHoleCopyDecl(r: i32): i32 {
  const p = fsParent[r]
  if p < 0 { return -1 }
  const pn = nodeAt(p)
  if pn is BinExpr && pn.binOp == "=" && pn.binRight == r {
    return letDeclOfRead(pn.binLeft)
  }
  fsLetInitDecl(p, r)
}

// `p` when it is a `let` initialised with `r`, else -1: every other parent reads `r` in place.
function fsLetInitDecl(p: i32, r: i32): i32 {
  const pn = nodeAt(p)
  if pn is LetDecl && pn.letInit == r { return p }
  -1
}

// The call keys of the binding hole read `r` is copied into, each read of it a call, a
// hand-out to a hole or a further copy, whose keys it takes; empty when `r` is no such copy,
// ["!"] when the binding is read at none or in any other way. Two keys are a binding the let plan
// gives a slot per key, each written from the parameter of its key (D6530).
function fsHoleCopyKeys(r: i32): string[] {
  const ks: string[] = []
  const d = fsHoleCopyDecl(r)
  if d < 0 { return ks }
  const bad: string[] = ["!"]
  if hsCopyDepth > 4 { return bad }
  hsCopyDepth = hsCopyDepth + 1
  let ok = true
  for x in fsIdents {
    if identDeclOf(x) == d && ok {
      // A further copy (`const c = b`) is read at its own binding's key (D6520), a listed
      // copy at each key a call through the list takes (D9653).
      const lcs = fsListElemCalls(x)
      for lc in lcs {
        const lk = fsListElemCallKey(lc)
        if !hasStr(ks, lk) { ks.push(lk) }
      }
      let xk = ""
      if lcs.length == 0 {
        // A further copy read at two keys takes a slot per key from this one's (D9790).
        const fks = fsHoleCopyKeys(x)
        if fks.length > 1 {
          for fk in fks {
            if fk.slice(0, 2) != "c:" { ok = false }
            else if !hasStr(ks, fk) { ks.push(fk) }
          }
        } else if fks.length == 1 {
          xk = fks[0]
        } else {
          xk = fsMemberReadKey(x)
        }
      }
      if xk != "" {
        if xk.slice(0, 2) != "c:" { ok = false }
        else if !hasStr(ks, xk) { ks.push(xk) }
      }
    }
  }
  if ok && ks.length == 0 {
    const tk = fsTyParamCopyKey(d)
    if tk != "" { ks.push(tk) }
  }
  hsCopyDepth = hsCopyDepth - 1
  if !ok || ks.length == 0 { return bad }
  ks
}

// The one key of the parameter annotated bare with the type parameter unread binding `d` is
// annotated with, which fixes the instance the binding holds (D6762); "" when there is none.
function fsTyParamCopyKey(d: i32): string {
  const dn = nodeAt(d)
  // A binding the type-parameter plan retypes holds the instance of its own parameter.
  if !(dn is LetDecl) || dn.letType < 0 || hasI32(psRetype, dn.letType) {
    return ""
  }
  const tn = nodeAt(dn.letType)
  const fd = fsEnclosingFn(d)
  if fd < 0 || !(tn is TypeRef) { return "" }
  const f = nodeAt(fd)
  if !(f is FuncDecl) || !hasStr(f.fnTyParams, tn.tyName) { return "" }
  let own = -1
  for q in f.fnParams {
    const qn = nodeAt(q)
    if qn is Param && qn.parType >= 0 {
      const qt = nodeAt(qn.parType)
      if qt is TypeRef && qt.tyName == tn.tyName {
        if own >= 0 { return "" }
        own = q
      }
    }
  }
  if own < 0 { return "" }
  const ks = fsQuietHoleKeys(own)
  if ks.length != 1 { return "" }
  ks[0]
}

// Hole parameter `q`'s keys, through its forwards, with `hsBad` untouched; empty when it
// cannot take a parameter per type.
function fsQuietHoleKeys(q: i32): string[] {
  const none: string[] = []
  const was = hsBad
  hsBad = false
  const ks = fsHoleKeys(q)
  const bad = hsBad
  hsBad = was
  if bad { return none }
  ks
}

// Whether parameter `par`, read as `r`, is annotated at a type naming no type parameter and
// reaching no hole.
function fsParamTyClosed(par: i32, r: i32): boolean {
  const p = nodeAt(par)
  if !(p is Param) || p.parType < 0 { return false }
  const t = nodeTyIxOf(r)
  t >= 0 && !tyHasTyVar(t) && !tyReachesHole(t, 8)
}

// Whether asked parameter `a` joins the split set: one the type-parameter plan annotates only
// when its reads take two keys, so a plan that can hold it whole is not declined for it.
function fsHoleOverTyParam(a: i32): boolean {
  !hasI32(psPar, a) || fsQuietHoleKeys(a).length > 1
}

// The keys a read handed to a hole parameter takes: that hole's, through its forwards; empty
// for any other read, or a hole that cannot take a parameter per type.
function fsHoleFwdKeys(r: i32): string[] {
  const none: string[] = []
  const q = fsHoleFwd(r)
  if q < 0 { return none }
  fsQuietHoleKeys(q)
}

// Asks every other binding handed to the hole read `a` is handed to whose reads take two slot
// keys, since the monomorphizer refuses one of them per compile.
function fsAskHoleSiblings(a: i32): i32 {
  const q = fsHoleFwd(a)
  if q < 0 { return 0 }
  for r in fsIdents {
    if r != a && fsHoleFwd(r) == q {
      const d = letDeclOfRead(r)
      if d >= 0 && !hasI32(fsAsks, d) && fsLetMemberKeys(d) > 1 {
        fsAsks.push(d)
      }
    }
  }
  0
}

// Asks every other const lambda handed to the same identity function as the read `a` whose
// bindings are called at two types, since the monomorphizer refuses one of them per compile
// (D6262).
function fsAskIdentitySiblings(a: i32): i32 {
  const c = fsParent[a]
  if c < 0 { return 0 }
  const cn = nodeAt(c)
  if !(cn is Call) { return 0 }
  const fd = identDeclOf(cn.callFn)
  if fd < 0 { return 0 }
  for r in fsIdents {
    const rc = fsParent[r]
    if r != a && rc >= 0 && rc != c {
      const rcn = nodeAt(rc)
      if rcn is Call && rcn.callFn != r && identDeclOf(rcn.callFn) == fd {
        const d = letDeclOfRead(r)
        if (
          d >= 0
          && !hasI32(fsAsks, d)
          && fsIdentityArg(rc) == r
          && fsConstLambdaOf(r) >= 0
          && fsIdentityKeyCount(d) > 1
        ) {
          fsAsks.push(d)
        }
      }
    }
  }
  0
}

// The number of distinct slot keys the reads of binding `d` take.
function fsLetMemberKeys(d: i32): i32 {
  const ks: string[] = []
  for r in fsIdents {
    if identDeclOf(r) == d {
      const k = fsMemberReadKey(r)
      if !hasStr(ks, k) { ks.push(k) }
    }
  }
  ks.length
}

// The slot key of read `r` of a split binding: a read handed to an unsplit hole takes the one
// key that hole is called at, a read handed to a closed function type that type's call key
// (D6761), any other read `fsReadKey`'s.
function fsMemberReadKey(r: i32): string {
  const q = fsHoleFwd(r)
  if hsIx(q) < 0 {
    const hk = fsHoleFwdKeys(r)
    if hk.length == 1 { return hk[0] }
  }
  const dk = fsFixedDeliveryKey(r, q)
  if dk != "" { return dk }
  const ik = fsIdentityReadKey(r)
  if ik != "" { return ik }
  const rk = fsReadKey(r)
  if rk.slice(0, 2) == "u:" {
    const lk = fsListCallbackKey(r)
    if lk != "" { return lk }
  }
  rk
}

// The key of read `r` handed as the callback of a `.map` / `.filter` over a list of a closed
// element type: that type, which fixes the one instantiation the callback takes; else "".
function fsListCallbackKey(r: i32): string {
  const p = fsParent[r]
  if p < 0 { return "" }
  const pn = nodeAt(p)
  if (
    !(pn is Call)
    || pn.callFn == r
    || pn.callArgs.length != 1
    || pn.callArgs[0] != r
  ) {
    return ""
  }
  if pn.callFn < 0 { return "" }
  const cf = nodeAt(pn.callFn)
  if !(cf is Member) || (cf.memProp != "map" && cf.memProp != "filter") {
    return ""
  }
  const ot = nodeTyIxOf(cf.memObj)
  if ot < 0 { return "" }
  const at = tyAt(ot)
  if !(at is TyArray) || at.aElem < 0 { return "" }
  if tyHasTyVar(at.aElem) || tyReachesHole(at.aElem, 8) { return "" }
  "c:" + tyToStr(at.aElem) + ","
}

// The key of read `r` when it is an identity call's argument initializing a binding: that
// binding's annotated function type, or the one call key all of its reads share; else "".
function fsIdentityReadKey(r: i32): string {
  const c = fsParent[r]
  if c < 0 || fsIdentityArg(c) != r || fsParent[c] < 0 { return "" }
  const dn = nodeAt(fsParent[c])
  if dn is LetDecl && dn.letInit == c && dn.letType >= 0 {
    const at = nodeTyIxOf(dn.letType)
    if at < 0 || !(tyAt(at) is TyFunc) { return "" }
    return "t:" + tyToStr(at)
  }
  const d = fsIdentityLetOf(r)
  if d < 0 { return "" }
  let k = ""
  for x in fsIdents {
    if identDeclOf(x) == d {
      const xk = fsReadKey(x)
      if xk.slice(0, 2) != "c:" || (k != "" && xk != k) { return "" }
      k = xk
    }
  }
  k
}

// The number of distinct keys of binding `d`'s reads, each through an identity or a call;
// 0 when a read is neither.
function fsIdentityKeyCount(d: i32): i32 {
  if d < 0 { return 0 }
  const ks: string[] = []
  for r in fsIdents {
    if identDeclOf(r) == d {
      let k = fsIdentityReadKey(r)
      if k == "" && fsReadKey(r).slice(0, 2) == "c:" { k = fsReadKey(r) }
      if k == "" { return 0 }
      if !hasStr(ks, k) { ks.push(k) }
    }
  }
  ks.length
}

// The split set: every asked parameter called at two types, closed over the holes it forwards
// to and the parameters forwarded into it. 0 with a split, 1 with none or one it cannot make.
function fsPlanHoles(): i32 {
  fsHoleDecline()
  hsBad = false
  const work: i32[] = []
  // An asked parameter brings the other parameters of its function the checker marked, since
  // the emitter stops at the first one it refuses (D14652).
  const asked: i32[] = []
  for a in fsAsks {
    asked.push(a)
    if a >= 0 && a < fsParseLen && nodeAt(a) is Param && fsParent[a] >= 0 {
      const f = nodeAt(fsParent[a])
      if f is FuncDecl {
        for q in f.fnParams {
          if (
            q != a
            && holeFnSplitHas(q)
            && !hasI32(fsAsks, q)
            && !hasI32(asked, q)
          ) {
            asked.push(q)
          }
        }
      }
    }
  }
  for a in asked {
    if (
      a >= 0
      && a < fsParseLen
      && nodeAt(a) is Param
      && !hasI32(pkPar, a)
      && fsHoleOverTyParam(a)
    ) {
      work.push(a)
    }
  }
  // Functions sharing a list take one parameter list, so each splits its parameter at the
  // keys all of them call it at, in one order (D6832).
  const gPar: i32[] = []
  const gKeys: string[][] = []
  let wi = 0
  while wi < work.length {
    const par = work[wi]
    wi = wi + 1
    if hsIx(par) < 0 && fsParent[par] >= 0 {
      let gi = 0
      while gi < gPar.length && gPar[gi] != par { gi = gi + 1 }
      let ks = fsHoleKeys(par)
      if hsBad { return fsHoleDecline() }
      if gi < gPar.length {
        for k in ks {
          if !hasStr(gKeys[gi], k) { return fsHoleDecline() }
        }
        ks = gKeys[gi]
      } else {
        const grp = fsListGroupPars(par)
        if hasI32(grp, -1) { return fsHoleDecline() }
        if grp.length > 1 {
          for q in grp {
            for k in fsHoleKeys(q) {
              if !hasStr(ks, k) { ks.push(k) }
            }
            if hsBad { return fsHoleDecline() }
          }
          for q in grp {
            if q != par {
              if hsIx(q) >= 0 || !fsHoleOverTyParam(q) {
                return fsHoleDecline()
              }
              gPar.push(q)
              gKeys.push(ks)
              work.push(q)
            }
          }
        }
      }
      if ks.length > 1 {
        hsPar.push(par)
        hsKeys.push(ks)
        const fd = fsParent[par]
        const f = nodeAt(fd)
        let j = 0
        if f is FuncDecl {
          while j < f.fnParams.length && f.fnParams[j] != par { j = j + 1 }
        }
        for r in fsIdents {
          if identDeclOf(r) == par {
            const q = fsHoleFwd(r)
            if q >= 0 && fsFixedDeliveryKey(r, q) == "" { work.push(q) }
            if q < 0 {
              for eq in fsHoleElemFwds(r) {
                if eq >= 0 { work.push(eq) }
              }
            }
            const cd = fsHoleCopyDecl(r)
            if fsHoleCopyKeys(r).length > 1 && !hasI32(fsAsks, cd) {
              fsAsks.push(cd)
            }
          }
        }
        const calls = fsFnCalls(fsFnOwner(fd))
        const cps = fsFnCallsCopy
        let ci = 0
        while ci < calls.length {
          const c = calls[ci]
          const cp = cps[ci]
          ci = ci + 1
          if c < 0 { return fsHoleDecline() }
          const cn = nodeAt(c)
          if cn is Call && f is FuncDecl {
            const a = fsArgOfParam(cn, f, j)
            if a < 0 { return fsHoleDecline() }
            const lam = fsIsLambdaLit(a)
            // A call always returning one generic is handed once, then the generic (D9540).
            // So is one returning one of several, by the arm index it returns (D9596).
            const ret = (nodeAt(a) is Call
              && cp < 0
              && (fsConstRet(a) >= 0 || fsChoiceStmt(c, a) >= 0))
              || (cp < 0 && fsChoiceArgStmt(c, a) >= 0)
            if !lam && !ret && !(nodeAt(a) is Ident) { return fsHoleDecline() }
            let ad = -1
            if !lam && !ret { ad = identDeclOf(a) }
            if cp >= 0 {
              // A copy's call hands a name declared outside the copy (D6706).
              if lam || (ad >= 0 && ad < fsParseLen && fsUnder(ad, pfSrc[cp])) {
                return fsHoleDecline()
              }
              hcCopy.push(cp)
              hcRead.push(a)
              hcPar.push(par)
            } else if ad >= 0 && ad < fsParseLen && nodeAt(ad) is Param {
              // A parameter of a declared closed type is no hole, and is handed as itself (D13661).
              if !fsParamTyClosed(ad, a) { work.push(ad) }
              hpCall.push(c)
              hpRead.push(a)
              hpPar.push(par)
            } else {
              // A call several list elements reach hands its argument once, to parameters
              // splitting at one key list (D7183).
              let hx = 0
              while hx < hdRead.length && hdRead[hx] != a { hx = hx + 1 }
              if hx < hdRead.length {
                if hdPar[hx] != par && !fsSameKeys(hdKeys[hx], ks) {
                  return fsHoleDecline()
                }
              } else {
                hdRead.push(a)
                hdKeys.push(ks)
                hdPar.push(par)
                fsHoleAskLet(a)
              }
            }
          }
        }
      }
    }
  }
  if hsPar.length == 0 { return 1 }
  0
}

// Asks, for each asked call, the hole parameter of every named function the call reaches at
// each position it hands a function by name.
function fsAskOpenCallPars(): i32 {
  if fsCallAsks.length == 0 { return 0 }
  const fns: i32[] = []
  for r in fsIdents {
    const d = identDeclOf(r)
    if d >= 0 && d < fsParseLen && nodeAt(d) is FuncDecl && !hasI32(fns, d) {
      fns.push(d)
    }
  }
  for fd in fns {
    const f = nodeAt(fd)
    const own = fsFnOwner(fd)
    if f is FuncDecl && own >= 0 {
      const calls = fsFnCalls(own)
      for c in fsCallAsks {
        const cn = nodeAt(c)
        if cn is Call && hasI32(calls, c) {
          let j = 0
          while j < f.fnParams.length && j < cn.callArgs.length {
            const a = fsParenPeel(cn.callArgs[j])
            const par = f.fnParams[j]
            if (
              a >= 0
              && nodeAt(a) is Ident
              && !hasI32(fsAsks, par)
              && fsAskedArgCalls(a, par)
            ) {
              fsAsks.push(par)
            }
            j = j + 1
          }
        }
      }
    }
  }
  0
}

// Whether name `a` handed to parameter `par` of an asked call is one a split can serve: a
// function's name, or a value `par`'s reads call through, so a value hole declines nothing (D10700).
function fsAskedArgCalls(a: i32, par: i32): boolean {
  const d = identDeclOf(a)
  if d >= 0 && d < fsParseLen && nodeAt(d) is FuncDecl { return true }
  fsQuietHoleKeys(par).length > 0
}

// The parameters at `par`'s position of every function sharing a list literal or a `const`'s
// `if` join with `par`'s function, through further ones, `par` first; [-1] when a value there
// is not a function name.
function fsListGroupPars(par: i32): i32[] {
  const grp: i32[] = [par]
  let gi = 0
  while gi < grp.length {
    const fd = fsParent[grp[gi]]
    gi = gi + 1
    const f = nodeAt(fd)
    if !(f is FuncDecl) { return [-1] }
    let j = 0
    while j < f.fnParams.length && f.fnParams[j] != grp[gi - 1] { j = j + 1 }
    const own = fsFnOwner(fd)
    for r in fsIdents {
      if identDeclOf(r) == own && r != own {
        const vals: i32[] = []
        let ok = true
        const lit = fsParent[r]
        const ie = fsIfArmElemOf(r)
        if lit >= 0 && nodeAt(lit) is ArrayLit {
          ok = fsPushListVals(lit, vals)
        } else if ie >= 0 {
          ok = fsPushListVals(fsParent[ie], vals)
        } else if fsIfJoinLetOf(r) >= 0 {
          ok = fsPushArmVals(fsIfArmOf(r), vals)
        } else if fsIfCalleeCallOf(r) >= 0 {
          ok = fsPushArmVals(fsIfCalleeIfOf(r), vals)
        }
        if !ok { return [-1] }
        for e in vals {
          const ed = identDeclOf(e)
          if ed < 0 || ed >= fsParseLen { return [-1] }
          const edn = nodeAt(ed)
          if !(edn is FuncDecl) || edn.fnParams.length <= j { return [-1] }
          const q = edn.fnParams[j]
          if !hasI32(grp, q) { grp.push(q) }
        }
      }
    }
  }
  grp
}

// Pushes the value of each element of list literal `lit`, each arm's for an `if`, onto `out`;
// false when one is not a name.
function fsPushListVals(lit: i32, out: i32[]): boolean {
  const ln = nodeAt(lit)
  if !(ln is ArrayLit) { return false }
  for e in ln.arrElems {
    if !fsPushArmVals(e, out) { return false }
  }
  true
}

// Pushes `v` when it is a name, or each arm's value for an `if` with an `else`, onto `out`;
// false otherwise.
function fsPushArmVals(v: i32, out: i32[]): boolean {
  const x = fsParenPeel(v)
  if x < 0 || x >= fsParseLen { return false }
  const n = nodeAt(x)
  if n is Ident {
    out.push(x)
    return true
  }
  if !(n is IfStmt) || n.ifElse < 0 { return false }
  for a in [n.ifThen, n.ifElse] {
    const an = nodeAt(a)
    let last = a
    if an is Block {
      if an.blkStmts.length == 0 { return false }
      last = an.blkStmts[an.blkStmts.length - 1]
    }
    if !fsPushArmVals(last, out) { return false }
  }
  true
}

// A hole parameter of a module function, read only as a callee at one key and handed at every
// call a module function or `const` lambda by name, is that function: the function, and a copy
// of it per further name, calls it by name and drops the parameter, as each call does (D6481).
// 1 when it cannot.
function fsPlanByName(par: i32): i32 {
  if par < 0 || par >= fsParseLen || fsParent[par] < 0 { return 1 }
  const p = nodeAt(par)
  const fd = fsParent[par]
  const f = nodeAt(fd)
  const own = fsFnOwner(fd)
  if !(p is Param) || !(f is FuncDecl) || own < 0 { return 1 }
  if hasI32(pfSrc, fd) || fsByNameCopied(fd) { return 1 }
  // A second parameter of a function already planned by name takes no copy of its own, since
  // a copy parses the body without the first plan's renames (D6705).
  const again = fsByNameFn(fd)
  if p.parType >= 0 || p.parDefault >= 0 || p.parOpt != 0 || p.parRest != 0 {
    return 1
  }
  if fsParent[own] < 0 || !(nodeAt(fsParent[own]) is Program) { return 1 }
  let j = 0
  while j < f.fnParams.length && f.fnParams[j] != par { j = j + 1 }
  const reads: i32[] = []
  for r in fsIdents {
    if identDeclOf(r) == par {
      const cn = nodeAt(fsParent[r])
      if !(cn is Call) || cn.callFn != r { return 1 }
      reads.push(r)
    }
  }
  // A hole called at two keys is the hole plan's.
  hsBad = false
  if fsHoleKeys(par).length > 1 { return 1 }
  // So is one sharing a list with functions whose parameters there are called at two keys
  // between them, since the hole plan splits them all to one parameter list (D7841, D13261).
  const gks: string[] = []
  for q in fsListGroupPars(par) {
    if q >= 0 {
      for k in fsQuietHoleKeys(q) {
        if !hasStr(gks, k) { gks.push(k) }
      }
    }
  }
  if gks.length > 1 { return 1 }
  const calls = fsFnCalls(own)
  // A call made in a copy has no node of its own to drop an argument from.
  for cp in fsFnCallsCopy {
    if cp >= 0 { return 1 }
  }
  const args: i32[] = []
  const names: string[] = []
  for c in calls {
    if c < 0 || hasI32(paCall, c) || (hasI32(pkCall, c) && !again) { return 1 }
    const cn = nodeAt(c)
    // A copy is called by renaming the callee, which only a name can take.
    if !(cn is Call) || cn.callFn < 0 || !(nodeAt(cn.callFn) is Ident) {
      return 1
    }
    const a = fsArgOfParam(cn, f, j)
    const nm = fsFixedFnName(a, own)
    if nm == "" { return 1 }
    // A lambda has no declaration a copy can be parsed from, so it takes one name, as a
    // second parameter does.
    if (f.fnName == "" || again) && names.length > 0 && names[0] != nm {
      return 1
    }
    args.push(a)
    names.push(nm)
  }
  if calls.length == 0 { return 1 }
  // The first name takes the function itself, so the plans of the named function's own
  // parameters see its calls; each further name takes a copy.
  const seen: string[] = []
  const copies: string[] = []
  let i = 0
  while i < calls.length {
    let k = 0
    while k < seen.length && seen[k] != names[i] { k = k + 1 }
    if k == seen.length {
      seen.push(names[i])
      if k == 0 {
        copies.push("")
        for r in reads { fsRename(r, names[i]) }
        pzPar.push(par)
        pkPar.push(par)
        pkDecl.push(identDeclOf(fsParenPeel(args[i])))
      } else {
        const copy = pfSrc.length
        copies.push(f.fnName + "$n" + i32ToStr(par) + "_" + i32ToStr(k))
        pfSrc.push(fd)
        pfAnchor.push(fd)
        pfName.push(copies[k])
        for r in reads { fsCopyRename(copy, r, names[i]) }
        pqCopy.push(copy)
        pqName.push(p.parName)
        pqPar.push(par)
        pqDecl.push(identDeclOf(fsParenPeel(args[i])))
      }
    }
    const cn = nodeAt(calls[i])
    if cn is Call && copies[k] != "" { fsRename(cn.callFn, copies[k]) }
    pkCall.push(calls[i])
    pkArg.push(args[i])
    i = i + 1
  }
  0
}

// Whether a parameter of function `fd` is planned by name, so no other plan copies `fd`.
function fsByNameFn(fd: i32): boolean {
  for q in pkPar {
    if fsParent[q] == fd { return true }
  }
  fsByNameCopied(fd)
}

// Whether a by-name plan copies function `fd`.
function fsByNameCopied(fd: i32): boolean {
  for q in pqCopy {
    if q >= 0 && q < pfSrc.length && pfSrc[q] == fd { return true }
  }
  false
}

// The name argument `a` reads when it is a module function or a module `const` lambda, other
// than `fd` itself and named nowhere inside `fd`, so a read of it in `fd` means it; else "".
function fsFixedFnName(a: i32, fd: i32): string {
  const x = fsParenPeel(a)
  if x < 0 || x >= fsParseLen { return "" }
  const n = nodeAt(x)
  if !(n is Ident) { return "" }
  const d = identDeclOf(x)
  if d < 0 || d >= fsParseLen || d == fd || fsParent[d] < 0 { return "" }
  if !(nodeAt(fsParent[d]) is Program) { return "" }
  const dn = nodeAt(d)
  let ok = dn is FuncDecl && dn.fnName == n.identName
  if dn is LetDecl && dn.letKw == "const" && dn.letName == n.identName {
    ok = dn.letType < 0 && fsIsLambdaLit(dn.letInit)
  }
  if !ok { return "" }
  let i = 0
  while i < fsParseLen {
    if fsUnder(i, fd) && binderNameAt(i) == n.identName { return "" }
    i = i + 1
  }
  n.identName
}

function fsHoleDecline(): i32 {
  hsPar = []
  hsKeys = []
  hdRead = []
  hdKeys = []
  hdPar = []
  hcCopy = []
  hcRead = []
  hcPar = []
  hpCall = []
  hpRead = []
  hpPar = []
  1
}

// A written binding handed once per type takes a slot per type through the let plan.
function fsHoleAskLet(a: i32): i32 {
  const d = letDeclOfRead(a)
  if d < 0 || hasI32(fsAsks, d) { return 0 }
  for r in fsIdents {
    if identDeclOf(r) == d && fsReadKey(r) == "" {
      fsAsks.push(d)
      return 0
    }
  }
  0
}

// Split parameter `si`'s name for key `k`: its own for the first key, a fresh one past it.
function hsSlot(si: i32, k: string): string {
  const par = hsPar[si]
  const p = nodeAt(par)
  let nm = ""
  if p is Param { nm = p.parName }
  let i = 0
  while i < hsKeys[si].length && hsKeys[si][i] != k { i = i + 1 }
  if i == 0 { return nm }
  nm + "$h" + i32ToStr(par) + "_" + i32ToStr(i)
}

// The split set's share of the plan, once the let slots are known: the parameters, each read
// renamed to its parameter, and each call handing its argument once per parameter.
function fsPlanHoleRewrites(): i32 {
  let si = 0
  while si < hsPar.length {
    const par = hsPar[si]
    const ks = hsKeys[si]
    const extra: string[] = []
    let k = 1
    while k < ks.length {
      extra.push(hsSlot(si, ks[k]))
      k = k + 1
    }
    ppAfter.push(par)
    ppNames.push(extra)
    fsDropTyParamPlan(par)
    fsStripTyParam(par)
    for r in fsIdents {
      if identDeclOf(r) == par {
        const c = fsParent[r]
        const cn = nodeAt(c)
        if cn is Call && cn.callFn == r {
          fsRename(r, hsSlot(si, fsReadKey(r)))
        } else {
          const cks = fsHoleCopyKeys(r)
          let q = fsHoleFwd(r)
          // A call through list elements is handed a slot per key of the elements' one key
          // list (D7845).
          let eqs: i32[] = []
          if q < 0 {
            eqs = fsHoleElemFwds(r)
            if eqs.length > 0 && eqs[0] >= 0 { q = eqs[0] }
          }
          const qi = hsIx(q)
          const lcs = fsListElemCalls(r)
          // A copy read at two keys is the let plan's, which writes each slot from the
          // parameter of its key. A listed hole stays its first parameter in the list, and
          // each call through the list calls its key's parameter instead (D9653).
          if (
            lcs.length > 0
            && cks.length == 0
            && qi < 0
            && fsFixedDeliveryKey(r, q) == ""
          ) {
            for lc in lcs {
              pmCall.push(lc)
              pmName.push(hsSlot(si, fsListElemCallKey(lc)))
            }
          } else if cks.length == 1 {
            fsRename(r, hsSlot(si, cks[0]))
          } else if cks.length == 0 && qi >= 0 {
            // A key of the elements' list that no element this call reaches calls is handed
            // the first slot, which nothing there calls (D13520).
            const names: string[] = []
            for qk in hsKeys[qi] {
              names.push(
                if eqs.length > 0 && !hasStr(ks, qk) { "" } else { hsSlot(si, qk) },
              )
            }
            fsHoleHandOut(c, r, names, hsSlotNames(qi))
          } else if cks.length == 0 {
            let dk = fsFixedDeliveryKey(r, q)
            if dk == "" {
              // Through list elements, the one key any element calls it at (D13321).
              const qks = if eqs.length > 0 { fsElemFwdKeys(eqs) } else { fsHoleKeys(q) }
              if qks.length > 0 { dk = qks[0] }
            }
            if dk != "" { fsRename(r, hsSlot(si, dk)) }
          }
        }
      }
    }
    si = si + 1
  }
  // A parameter that does not split itself is handed to every slot of the one it is passed to,
  // which splits only at keys its list siblings call (D13200), and once for a call reaching
  // several siblings, which split at one key list (D13661).
  const handed: i32[] = []
  let pi = 0
  while pi < hpRead.length {
    const a = hpRead[pi]
    const qi = hsIx(hpPar[pi])
    if hsIx(identDeclOf(a)) < 0 && qi >= 0 && !hasI32(handed, a) {
      handed.push(a)
      const names: string[] = []
      for _ in hsKeys[qi] { names.push("") }
      fsHoleHandOut(hpCall[pi], a, names, hsSlotNames(qi))
    }
    pi = pi + 1
  }
  let hi = 0
  while hi < hdRead.length {
    const a = hdRead[hi]
    const an = nodeAt(a)
    const names: string[] = []
    const d = letDeclOfRead(a)
    let mi = -1
    if d >= 0 { mi = memIx(d) }
    // A lambda literal is handed as itself and then a fresh copy per further key, a call as
    // itself and then the generic it returns, by name.
    let leaves: string[] = []
    if mi < 0 { leaves = fsChoiceRetLeaves(a) }
    if mi < 0 && leaves.length == 0 && fsChoiceArgStmt(fsParent[a], a) >= 0 {
      if fsPlanChoiceArg(a, hdKeys[hi].length) != 0 { return 1 }
      hi = hi + 1
      continue
    }
    if leaves.length > 0 {
      if fsPlanChoiceRet(a, leaves, hdKeys[hi].length) != 0 { return 1 }
      hi = hi + 1
      continue
    }
    let rn = ""
    const gx = fsConstRet(a)
    if gx >= 0 {
      const g = nodeAt(gx)
      if g is Ident { rn = g.identName }
    }
    for k in hdKeys[hi] {
      if mi >= 0 { names.push(laneName(mi, k)) }
      else if an is Ident { names.push(an.identName) }
      else if names.length > 0 { names.push(rn) }
      else { names.push("") }
    }
    fsHoleHandOut(fsParent[a], a, names, hsSlotNames(hsIx(hdPar[hi])))
    hi = hi + 1
  }
  hi = 0
  while hi < hcRead.length {
    const an = nodeAt(hcRead[hi])
    const pars = hsSlotNames(hsIx(hcPar[hi]))
    if an is Ident && pars.length > 1 {
      const rest: string[] = []
      const restPars: string[] = []
      let k = 1
      while k < pars.length {
        rest.push(an.identName)
        restPars.push(pars[k])
        k = k + 1
      }
      pyCopy.push(hcCopy[hi])
      pyPos.push(an.pos)
      pyName.push(an.identName)
      pyNames.push(rest)
      pyPars.push(restPars)
    }
    hi = hi + 1
  }
  0
}

// An un-annotated split parameter gives up the type parameter its plan gave it, and a binding
// it seeds annotated with a type parameter no parameter names goes bare, as do the bindings
// that plan retyped: each is then a copy of the parameter per slot (D6760). So does such a
// binding a split parameter annotated with a bare type parameter seeds (D6793).
function fsDropTyParamPlan(par: i32): i32 {
  const p = nodeAt(par)
  const fd = fsParent[par]
  if fd < 0 || !(p is Param) { return 0 }
  const f = nodeAt(fd)
  if !(f is FuncDecl) { return 0 }
  if p.parType >= 0 {
    const pt = nodeAt(p.parType)
    if !(pt is TypeRef) || !hasStr(f.fnTyParams, pt.tyName) { return 0 }
  }
  for r in fsIdents {
    const c = fsParent[r]
    const cn = nodeAt(c)
    if (
      identDeclOf(r) == par
      && cn is LetDecl
      && cn.letInit == r
      && cn.letType >= 0
    ) {
      const tn = nodeAt(cn.letType)
      if (
        tn is TypeRef
        && hasStr(f.fnTyParams, tn.tyName)
        && !fsParamsName(f, tn.tyName)
        && !hasI32(ptPar, c)
      ) {
        ptPar.push(c)
      }
    }
  }
  let nm = ""
  const keepPar: i32[] = []
  const keepFn: i32[] = []
  const keepName: string[] = []
  let i = 0
  while i < psPar.length {
    if psPar[i] == par {
      nm = psName[i]
    } else {
      keepPar.push(psPar[i])
      keepFn.push(psFn[i])
      keepName.push(psName[i])
    }
    i = i + 1
  }
  if nm == "" { return 0 }
  psPar = keepPar
  psFn = keepFn
  psName = keepName
  const keepRe: i32[] = []
  const keepReName: string[] = []
  i = 0
  while i < psRetype.length {
    const d = fsLetOfType(psRetype[i])
    if psRetypeName[i] == nm && d >= 0 {
      if !hasI32(ptPar, d) { ptPar.push(d) }
    } else {
      keepRe.push(psRetype[i])
      keepReName.push(psRetypeName[i])
    }
    i = i + 1
  }
  psRetype = keepRe
  psRetypeName = keepReName
  0
}

// Whether a parameter of `f` is annotated bare with type name `nm`.
function fsParamsName(f: FuncDecl, nm: string): boolean {
  for q in f.fnParams {
    const qn = nodeAt(q)
    if qn is Param && qn.parType >= 0 {
      const qt = nodeAt(qn.parType)
      if qt is TypeRef && qt.tyName == nm { return true }
    }
  }
  false
}

// The parsed binding annotated with type node `t`, else -1.
function fsLetOfType(t: i32): i32 {
  let i = 0
  while i < fsParseLen {
    const n = nodeAt(i)
    if n is LetDecl && n.letType == t { return i }
    i = i + 1
  }
  -1
}

// Split parameter `par`'s type-parameter annotation is dropped, with every other parameter's and
// read body binding's that names it, when its function names that type parameter nowhere but in
// those bare annotations; each is then a hole of its own, as D6202's spelling is (D6240, D6470).
function fsStripTyParam(par: i32): i32 {
  const p = nodeAt(par)
  if !(p is Param) || p.parType < 0 { return 0 }
  const tn = nodeAt(p.parType)
  const fd = fsParent[par]
  const f = nodeAt(fd)
  if !(tn is TypeRef) || !(f is FuncDecl) { return 0 }
  const named: i32[] = []
  for q in f.fnParams {
    const qn = nodeAt(q)
    if qn is Param && qn.parType >= 0 {
      const qt = nodeAt(qn.parType)
      if qt is TypeRef && qt.tyName == tn.tyName { named.push(q) }
    }
  }
  for r in fsIdents {
    const d = identDeclOf(r)
    if d >= 0 && d < fsParseLen && !hasI32(named, d) && fsUnder(d, fd) {
      const dn = nodeAt(d)
      if dn is LetDecl && dn.letType >= 0 {
        const dt = nodeAt(dn.letType)
        if dt is TypeRef && dt.tyName == tn.tyName { named.push(d) }
      }
    }
  }
  let uses = 1 + named.length
  let t = fsFirstTok(fd)
  if t < 0 || fd >= nodeToks.length { return 0 }
  while t <= nodeToks[fd] && t < P.toks.length {
    if P.toks[t].text == tn.tyName { uses = uses - 1 }
    t = t + 1
  }
  if uses != 0 { return 0 }
  for q in named {
    if !hasI32(ptPar, q) { ptPar.push(q) }
  }
  0
}

// Plans choice-returning call `a` (`fsChoiceRetLeaves`, returning one of `leaves`) handed to a
// parameter split `count` ways: it runs once ahead of its statement, as a call of an
// arm-index copy of its callee minted once per callee, and each split argument selects by it.
function fsPlanChoiceRet(a: i32, leaves: string[], count: i32): i32 {
  const c = fsParent[a]
  const s = fsChoiceStmt(c, a)
  const fd = fsCallRunsFn(a)
  if s < 0 || fd < 0 || fd >= P.nodes.length { return fsHoleDecline() }
  const nm = fsPlanArmCopy(a, leaves)
  if nm == "" { return fsHoleDecline() }
  const f = nodeAt(fd)
  if !(f is FuncDecl) { return fsHoleDecline() }
  pnCall.push(c)
  pnArg.push(a)
  pnStmt.push(s)
  pnFn.push(nm)
  pnSel.push(f.fnName + "$n" + i32ToStr(a))
  pnLeaves.push(leaves)
  pnCount.push(count)
  fsPlanAheads()
}

// Records what the last `fsChoiceStmt` or `fsChoiceArgStmt` binds ahead and wraps in.
function fsPlanAheads(): i32 {
  pnAheadPar.push(fsAheadPar)
  pnAheadKid.push(fsAheadKid)
  pnWrap.push(fsWrapIn)
  0
}

// Plans choice argument `a` (`fsChoiceArgStmt`) handed to a parameter split `count` ways: its
// leaves numbered, it runs once ahead of its statement into an arm index, and each split
// argument selects by it (D13360).
function fsPlanChoiceArg(a: i32, count: i32): i32 {
  const c = fsParent[a]
  const s = fsChoiceArgStmt(c, a)
  if s < 0 { return fsHoleDecline() }
  const none: string[] = []
  pnCall.push(c)
  pnArg.push(a)
  pnStmt.push(s)
  pnFn.push("")
  pnSel.push("choice$n" + i32ToStr(a))
  pnLeaves.push(none)
  pnCount.push(count)
  fsPlanAheads()
}

// The name of the arm-index copy of the callee of choosing call `a`, returning the index of the
// one of `leaves` it returns, planned once per callee; "" when `a` runs no declared function.
function fsPlanArmCopy(a: i32, leaves: string[]): string {
  const fd = fsCallRunsFn(a)
  if fd < 0 || fd >= P.nodes.length { return "" }
  const f = nodeAt(fd)
  if !(f is FuncDecl) { return "" }
  const nm = f.fnName + "$x" + i32ToStr(fd)
  if !hasStr(pnSrcName, nm) {
    pnSrc.push(fd)
    pnSrcName.push(nm)
    pnSrcLeaves.push(leaves)
  }
  nm
}

// Mints each arm-index copy `fsPlanArmCopy` planned, then runs each planned call once into
// its arm index binding and hands every split argument a choice by that index. -1 when it cannot.
function fsApplyChoiceRets(): i32 {
  let si = 0
  while si < pnSrc.length {
    const f = reparseFuncDeclAt(fsFirstTok(pnSrc[si]))
    if f < 0 { return -1 }
    const fn = nodeAt(f)
    if !(fn is FuncDecl) { return -1 }
    fn.fnName = pnSrcName[si]
    if fsNumberRets(fn.fnBody, pnSrcLeaves[si]) != 0 { return -1 }
    if fsInsertAfter(pnSrc[si], f) != 0 { return -1 }
    si = si + 1
  }
  for i in fsChoiceOrder() {
    const c = nodeAt(pnCall[i])
    const a = pnArg[i]
    const an = nodeAt(a)
    if !(c is Call) || a >= nodeToks.length { return -1 }
    P.pos = nodeToks[a] + 1
    const pos = an.pos
    let leaves = pnLeaves[i]
    if an is Call && pnFn[i] != "" {
      if an.callFn < 0 || an.callFn >= P.nodes.length { return -1 }
      an.callFn = mkIdent(pnFn[i], nodeAt(an.callFn).pos)
    } else if pnFn[i] == "" {
      // A choice argument numbers its own leaves (D13360).
      const names: string[] = []
      if fsNumberLeaves(a, names, 0) < 0 { return -1 }
      leaves = names
    } else {
      return -1
    }
    const s = pnStmt[i]
    const o = if pnWrap[i] >= 0 { fsWrapChild(pnWrap[i], s, pnSel[i], pos) } else { fsListOwner(s) }
    if o < 0 { return -1 }
    // What runs ahead of the choice binds first, in order; one an earlier choice bound is gone.
    let k = 0
    while k < pnAheadKid[i].length {
      const y = pnAheadKid[i][k]
      const tmp = pnSel[i] + fsAheadSuffix(c.callArgs, y, k)
      if fsSetChild(pnAheadPar[i][k], y, mkIdent(tmp, pos)) == 0 {
        if fsInsertBeforeIn(o, s, mkLet("const", tmp, -1, y, pos)) != 0 {
          return -1
        }
      }
      k = k + 1
    }
    const args: i32[] = []
    for x in c.callArgs {
      if x == a {
        let n = 0
        while n < pnCount[i] {
          args.push(fsSelectArm(pnSel[i], leaves, pos))
          n = n + 1
        }
      } else {
        args.push(x)
      }
    }
    if args.length != c.callArgs.length + pnCount[i] - 1 { return -1 }
    c.callArgs = args
    if c.callArgNames.length > 0 {
      const nms: string[] = []
      for _x in args { nms.push("") }
      c.callArgNames = nms
    }
    if fsInsertBeforeIn(o, s, mkLet("const", pnSel[i], -1, a, pos)) != 0 {
      return -1
    }
  }
  0
}

// The planned choices in the order the source runs them, by their position, so one bound
// ahead of another's statement binds after that one's choice.
function fsChoiceOrder(): i32[] {
  const out: i32[] = []
  let i = 0
  while i < pnArg.length {
    out.push(i)
    let j = out.length - 1
    while j > 0 && nodeAt(pnArg[out[j - 1]]).pos > nodeAt(pnArg[i]).pos {
      out[j] = out[j - 1]
      out[j - 1] = i
      j = j - 1
    }
    i = i + 1
  }
  out
}

// The suffix naming the `k`th binding ahead of a choice: `$a` and its index among the choice
// call's arguments `args` when it is one of them, else `$o` and `k`.
function fsAheadSuffix(args: i32[], y: i32, k: i32): string {
  let j = 0
  while j < args.length {
    if args[j] == y { return "$a" + i32ToStr(j) }
    j = j + 1
  }
  "$o" + i32ToStr(k)
}

// Replaces child `old` of node `p`, in a place `fsRunsChildFirst` or `fsWrapsChild` notes, by
// `nw`. -1 when `old` is not such a child of `p`.
function fsSetChild(p: i32, old: i32, nw: i32): i32 {
  const pn = nodeAt(p)
  if pn is Call { return fsSetIn(pn.callArgs, old, nw) }
  if pn is ArrayLit { return fsSetIn(pn.arrElems, old, nw) }
  if pn is FieldInit && pn.fiValue == old {
    pn.fiValue = nw
    return 0
  }
  if pn is Index && pn.idxArr == old {
    pn.idxArr = nw
    return 0
  }
  if pn is BinExpr && pn.binLeft == old {
    pn.binLeft = nw
    return 0
  }
  if pn is BinExpr && pn.binRight == old {
    pn.binRight = nw
    return 0
  }
  if pn is WhileStmt && pn.whileCond == old {
    pn.whileCond = nw
    return 0
  }
  fsExcluded(-1, "a node no ahead binding or wrapped choice is a child of")
}

// Replaces element `old` of `xs` by `nw`. -1 when `xs` does not hold `old`.
function fsSetIn(xs: i32[], old: i32, nw: i32): i32 {
  let j = 0
  while j < xs.length {
    if xs[j] == old {
      xs[j] = nw
      return 0
    }
    j = j + 1
  }
  -1
}

// Wraps child `x` of `p` in a labelled block `@<sel>$b { x; break @<sel>$b }` handing out its
// value, so what is inserted before `x` there runs each time `p` runs `x`. Returns the block's
// body, which holds `x`, or -1.
function fsWrapChild(p: i32, x: i32, sel: string, pos: i32): i32 {
  const lbl = sel + "$b"
  const b = mkBlock([x, mkBreakVal("break", lbl, pos, 1)], pos)
  const w = mkWhile(mkBool(1, pos), b, lbl, pos, 1)
  if fsSetChild(p, x, w) != 0 { return -1 }
  b
}

// Replaces, in body `b` of an arm-index copy, each `return` of a name in `leaves` by its index
// there, past nested functions. -1 when a `return` names none of them.
function fsNumberRets(b: i32, leaves: string[]): i32 {
  const stack: i32[] = [b]
  while stack.length > 0 {
    const x = stack.pop() ?? -1
    const n = nodeAt(x)
    if n is RetStmt {
      const r = n.retArg
      const rn = if r >= 0 && r < P.nodes.length { nodeAt(r) } else { n }
      if !(rn is Ident) { return -1 }
      let k = 0
      while k < leaves.length && leaves[k] != rn.identName { k = k + 1 }
      if k >= leaves.length || r >= nodeToks.length { return -1 }
      P.pos = nodeToks[r] + 1
      n.retArg = mkNum(i32ToStr(k), rn.pos)
    } else if !(n is FuncDecl) {
      for k in nodeChildren(x) {
        if k >= 0 && k < P.nodes.length { stack.push(k) }
      }
    }
  }
  0
}

// Argument `a` of call `c` reads `names[0]`, and the rest follow it, each passed by the matching
// name in `pars` when `a` is passed by name. A name "" is `a` itself, a lambda literal, or a
// fresh copy of it.
function fsHoleHandOut(c: i32, a: i32, names: string[], pars: string[]): i32 {
  if names.length == 0 { return 0 }
  if names[0] != "" { fsRename(a, names[0]) }
  const rest: string[] = []
  const restPars: string[] = []
  let i = 1
  while i < names.length {
    rest.push(names[i])
    if i < pars.length { restPars.push(pars[i]) }
    i = i + 1
  }
  paCall.push(c)
  paArg.push(a)
  paNames.push(rest)
  paPars.push(restPars)
  0
}

// Split parameter `si`'s names, one per key; empty when `si` is -1.
function hsSlotNames(si: i32): string[] {
  const out: string[] = []
  if si < 0 { return out }
  for k in hsKeys[si] { out.push(hsSlot(si, k)) }
  out
}

// The let slots of every asked `let`; 0 with a plan, 1 when there is nothing it can split. When
// the read keys give no split, or one slot to reads handed to an open parameter at two calls,
// each such read takes a slot per call (D9006).
function fsPlanLets(): i32 {
  fsPinLanes = false
  const base = fsLaneSet()
  if base != 0 || fsLanesMixPins() {
    fsPinLanes = true
    if fsLaneSet() != 0 {
      fsPinLanes = false
      if base != 0 { return 1 }
      fsLaneSet()
    }
  }
  let mi = 0
  while mi < fsMem.length {
    if fsPlanMember(mi) != 0 { return 1 }
    mi = mi + 1
  }
  0
}

// Whether a read handed to an open parameter takes its call's slot (`fsPinReadKey`).
let fsPinLanes = false

// The slot key of read `r` handed to a generic or un-annotated parameter of a declared function:
// the parameter and the call's argument types, so each call instancing the callee reads a binding
// of its own; "" for any other read.
function fsPinReadKey(r: i32): string {
  const q = fsHoleFwd(r)
  if q < 0 { return "" }
  const dt = fsDestTy(r)
  if dt >= 0 && !tyHasTyVar(dt) && !tyReachesHole(dt, 8) { return "" }
  const cn = nodeAt(fsParent[r])
  if !(cn is Call) { return "" }
  "p" + i32ToStr(q) + ":" + fsCallKey(cn, 0)
}

// Whether some member's slot holds two reads handed to open parameters at different calls.
function fsLanesMixPins(): boolean {
  for m in fsMem {
    const ks: string[] = []
    const ps: string[] = []
    for r in fsIdents {
      if identDeclOf(r) == m && hdIx(r) < 0 {
        const pk = fsPinReadKey(r)
        if pk != "" {
          const k = fsMemberReadKey(r)
          let i = 0
          while i < ks.length {
            if ks[i] == k && ps[i] != pk { return true }
            i = i + 1
          }
          ks.push(k)
          ps.push(pk)
        }
      }
    }
  }
  false
}

// `fsMemberReadKey`, or `fsPinReadKey` while the plan keys by call.
function fsLaneReadKey(r: i32): string {
  if fsPinLanes {
    const pk = fsPinReadKey(r)
    if pk != "" { return pk }
  }
  fsMemberReadKey(r)
}

// The split set and each member's slot keys; 0 when some member takes two, else 1.
function fsLaneSet(): i32 {
  fsMem = []
  fsLanes = []
  // The set: the asked declarations, closed over copies in either direction.
  for a in fsAsks {
    if a >= 0 && a < P.nodes.length && nodeAt(a) is LetDecl && memIx(a) < 0 {
      fsMem.push(a)
    }
  }
  let i = 0
  while i < fsMem.length {
    const m = fsMem[i]
    const d = nodeAt(m)
    if d is LetDecl {
      const src = letDeclOfRead(d.letInit)
      if src >= 0 && memIx(src) < 0 { fsMem.push(src) }
    }
    for r in fsIdents {
      if identDeclOf(r) == m {
        const key = fsReadKey(r)
        if key == "=" {
          const t = fsCopyTarget(r)
          if t >= 0 && memIx(t) < 0 { fsMem.push(t) }
        } else if key == "" {
          const w = nodeAt(fsParent[r])
          if w is BinExpr {
            const src = letDeclOfRead(w.binRight)
            if src >= 0 && memIx(src) < 0 { fsMem.push(src) }
          }
        }
      }
    }
    i = i + 1
  }
  for m in fsMem {
    const ks: string[] = []
    const gen = fsMemHoldsGeneric(m)
    for r in fsIdents {
      if identDeclOf(r) == m {
        const key = fsLaneReadKey(r)
        const hd = hdIx(r)
        const lcs = fsListElemCalls(r)
        if hd >= 0 {
          for k in hdKeys[hd] {
            if !hasStr(ks, k) { ks.push(k) }
          }
        } else if lcs.length > 0 {
          // A listed binding takes a slot per key a call through the list takes (D9653).
          for lc in lcs {
            const lk = fsListElemCallKey(lc)
            if !hasStr(ks, lk) { ks.push(lk) }
          }
        } else {
          // A delivery into a type that does not fix one instantiation keeps the refusal,
          // unless the slot is a fresh read of a generic name (D9594).
          if key.slice(0, 2) == "u:" && !fsDestFixed(r) && !gen { return 1 }
          if key != "" && key != "=" && !hasStr(ks, key) { ks.push(key) }
        }
      }
    }
    if gen && fsCallLaneFirst(ks) != 0 { return 1 }
    fsLanes.push(ks)
  }
  // A member needs every slot a binding it is copied into needs.
  let changed = true
  while changed {
    changed = false
    for r in fsIdents {
      const si = memIx(identDeclOf(r))
      if si >= 0 && fsReadKey(r) == "=" {
        const ti = memIx(fsCopyTarget(r))
        if ti >= 0 {
          for k in fsLanes[ti] {
            if !hasStr(fsLanes[si], k) {
              fsLanes[si].push(k)
              changed = true
            }
          }
        }
      }
    }
  }
  let split = false
  for ks in fsLanes {
    if ks.length > 1 { split = true }
  }
  if !split { return 1 }
  0
}

// Whether member `m` is an un-annotated `const` whose call always returns one generic name
// (`fsConstRet`, `fsConstAliasRet`), so a slot past its first can read the name afresh.
function fsMemHoldsGeneric(m: i32): boolean {
  const d = nodeAt(m)
  if !(d is LetDecl) || d.letKw != "const" || d.letType >= 0 || d.letInit < 0 {
    return false
  }
  let r = fsConstRet(d.letInit)
  if r < 0 { r = fsConstAliasRet(d.letInit) }
  r >= 0 && fsGenericName(r)
}

// Moves a key other than a value read's own (`u:`) to the front of `ks`, so the binding that
// runs the call keeps a slot some call fixes; 1 when every key is a value read's own.
function fsCallLaneFirst(ks: string[]): i32 {
  if ks.length == 0 || ks[0].slice(0, 2) != "u:" { return 0 }
  let i = 1
  while i < ks.length {
    if ks[i].slice(0, 2) != "u:" {
      const k = ks[i]
      ks[i] = ks[0]
      ks[0] = k
      return 0
    }
    i = i + 1
  }
  1
}

// Asks every parameter binding `d` is initialized or written from (`let d = p`, `d = p`) that
// can take a parameter per key and is read at two.
function fsAskWrittenHoles(d: i32): i32 {
  for r in fsIdents {
    const pd = identDeclOf(r)
    if (
      pd >= 0
      && pd < fsParseLen
      && nodeAt(pd) is Param
      && fsHoleCopyDecl(r) == d
      && !hasI32(fsAsks, pd)
    ) {
      if fsQuietHoleKeys(pd).length > 1 { fsAsks.push(pd) }
    }
  }
  0
}

// One member's share of the plan: a declaration per extra slot, a slot write after each
// write, and each read renamed to its slot. 1 declines.
function fsPlanMember(mi: i32): i32 {
  const m = fsMem[mi]
  const d = nodeAt(m)
  if !(d is LetDecl) { return 1 }
  const lanes = fsLanes[mi]
  if lanes.length == 0 { return 0 }
  if d.letType >= 0 && !(nodeAt(d.letType) is TypeRef) { return 1 }
  if !fsStmtParentOk(m) { return 1 }
  // A call returning one of several generics runs once too, as the index of the one it returns.
  const callLeaves = if lanes.length > 1 { fsChoiceRetLeaves(d.letInit) } else { [] }
  let callFn = ""
  if callLeaves.length > 0 {
    callFn = fsPlanArmCopy(d.letInit, callLeaves)
    if callFn == "" { return 1 }
  }
  const hoist = callFn != "" || (lanes.length > 1 && fsHoistsChoice(d.letInit))
  const ip = if hoist { -1 } else { fsValuePeer(d.letInit) }
  if ip == -2 { return 1 }
  if hoist {
    pcAnchor.push(m)
    pcCallFn.push(callFn)
    pcCallLeaves.push(callLeaves)
    const dollar = d.letName.indexOf("$")
    const base = if dollar > 0 { d.letName.slice(0, dollar) } else { d.letName }
    pcName.push(base + "$c" + i32ToStr(m))
  }
  let k = 0
  while k < lanes.length {
    const vn = fsLaneValName(d.letInit, ip, lanes[k])
    if vn == "!" { return 1 }
    if k == 0 {
      if vn != "" { fsRename(d.letInit, vn) }
    } else {
      pdAnchor.push(m)
      pdKw.push(d.letKw)
      pdName.push(laneName(mi, lanes[k]))
      pdTy.push(d.letType)
      pdValSrc.push(fsSlotSrc(d.letInit))
      pdValName.push(vn)
    }
    k = k + 1
  }
  for r in fsIdents {
    if identDeclOf(r) == m {
      const key = fsLaneReadKey(r)
      if key == "" {
        const w = fsParent[r]
        const wn = nodeAt(w)
        if !(wn is BinExpr) || !fsStmtParentOk(w) { return 1 }
        const wl = if callFn != "" { fsChoiceRetLeaves(wn.binRight) } else { [] }
        if wl.length > 0 {
          // Its arm-index copy numbers the arms in the order the binding's own selection does.
          if wl.length != callLeaves.length { return 1 }
          for l in wl {
            if !hasStr(callLeaves, l) { return 1 }
          }
          const wfn = fsPlanArmCopy(wn.binRight, callLeaves)
          let wci = 0
          while wci < pnSrcName.length && pnSrcName[wci] != wfn {
            wci = wci + 1
          }
          if (
            wci >= pnSrcName.length
            || !fsSameKeys(pnSrcLeaves[wci], callLeaves)
          ) {
            return 1
          }
          const nms: string[] = []
          for ln in lanes { nms.push(laneName(mi, ln)) }
          pcwWrite.push(w)
          pcwPc.push(pcAnchor.length - 1)
          pcwCallFn.push(wfn)
          pcwNames.push(nms)
          continue
        }
        const vp = fsValuePeer(wn.binRight)
        if vp == -2 { return 1 }
        let wk = 0
        while wk < lanes.length {
          const vn = fsLaneValName(wn.binRight, vp, lanes[wk])
          if vn == "!" { return 1 }
          if wk == 0 {
            if vn != "" { fsRename(wn.binRight, vn) }
          } else {
            pwAnchor.push(w)
            pwName.push(laneName(mi, lanes[wk]))
            pwValSrc.push(fsSlotSrc(wn.binRight))
            pwValName.push(vn)
          }
          wk = wk + 1
        }
      } else if fsListElemCalls(r).length > 0 && hdIx(r) < 0 {
        // A listed binding stays its first slot in the list, and each call through the
        // list calls its key's slot instead (D9653).
        for lc in fsListElemCalls(r) {
          pmCall.push(lc)
          pmName.push(laneName(mi, fsListElemCallKey(lc)))
        }
      } else if key != "=" && hdIx(r) < 0 {
        fsRename(r, laneName(mi, key))
      }
    }
  }
  0
}

// The name slot `lane` of a member reads for value `v` with peer `vp`: the peer's slot, the
// split hole parameter of that key for a hole read copied at two keys (D6530), or "" for a
// fresh copy of `v`; "!" when the hole has no parameter of that key.
function fsLaneValName(v: i32, vp: i32, lane: string): string {
  if vp >= 0 { return laneName(vp, lane) }
  if v < 0 || v >= fsParseLen || !(nodeAt(v) is Ident) { return "" }
  const si = hsIx(identDeclOf(v))
  if si < 0 || fsHoleCopyKeys(v).length < 2 { return "" }
  if !hasStr(hsKeys[si], lane) { return "!" }
  hsSlot(si, lane)
}

// Rewrites planned choice write `i` into a run of its arm-index copy into the arm index binding,
// followed by each slot's selection by that index. -1 when it cannot.
function fsApplyChoiceWrite(i: i32): i32 {
  if (
    i < 0
    || i >= pcwWrite.length
    || i >= pcwCallFn.length
    || i >= pcwNames.length
  ) {
    return -1
  }
  const w = pcwWrite[i]
  const pc = pcwPc[i]
  if w < 0 || w >= nodeToks.length || pc < 0 || pc >= pcLeaves.length {
    return -1
  }
  const wn = nodeAt(w)
  if (
    !(wn is BinExpr)
    || wn.binLeft >= P.nodes.length
    || wn.binRight >= P.nodes.length
  ) {
    return -1
  }
  const c = nodeAt(wn.binRight)
  if !(c is Call) || c.callFn < 0 || c.callFn >= P.nodes.length { return -1 }
  P.pos = nodeToks[w] + 1
  const pos = wn.pos
  c.callFn = mkIdent(pcwCallFn[i], nodeAt(c.callFn).pos)
  wn.binLeft = mkIdent(pcName[pc], nodeAt(wn.binLeft).pos)
  let k = pcwNames[i].length - 1
  while k >= 0 {
    const sel = fsSelectArm(pcName[pc], pcLeaves[pc], pos)
    if sel < 0 { return -1 }
    const asg = mkBinary("=", mkIdent(pcwNames[i][k], pos), sel, pos)
    if fsInsertAfter(w, asg) != 0 { return -1 }
    k = k - 1
  }
  0
}

function fsRename(ix: i32, name: string): i32 {
  const n = nodeAt(ix)
  if n is Ident && n.identName == name { return 0 }
  prIdent.push(ix)
  prName.push(name)
  0
}

// Records the parse arena's length; in the applying compile, applies the plan to the fresh
// parse. -1 when the plan does not apply, which abandons that compile.
export function fsAfterParse(): i32 {
  fsParseLen = P.nodes.length
  fsConstLets()
  if fsMode != FS_APPLY { return 0 }
  fsApply()
}

// The names some `=` or an exported `let` writes, how often each name is declared, and the
// one binding or named function declaring it, for `fsConstLets`. Only the names in `clNeed`
// are recorded; a walk that reaches another name notes it in `clMissed` and answers false.
let clWritten: {[string]: boolean} = Map()
let clDecls: {[string]: i32} = Map()
let clLet: {[string]: i32} = Map()
let clNeed: {[string]: boolean} = Map()
let clMissed: string[] = []

// An un-annotated, unexported `let` that no `=` anywhere writes by name, holding a lambda, a
// name that is a function for good, or a list literal of those, is spelled `const`, so every
// reader that follows a `const` to a function or its list follows it too (D6472, D13521).
function fsConstLets(): i32 {
  const cands: i32[] = []
  const names: string[] = []
  const decls: i32[] = []
  const asg: string[] = []
  let i = 0
  while i < fsParseLen {
    const n = nodeAt(i)
    if n is LetDecl {
      if n.letName != "" {
        names.push(n.letName)
        decls.push(i)
      }
      if n.letKw == "let" && n.letType < 0 && n.letInit >= 0 {
        if fsMayHoldFixedFn(n.letInit) { cands.push(i) }
      }
    } else if n is Param {
      if n.parName != "" {
        names.push(n.parName)
        decls.push(-1)
      }
    } else if n is FuncDecl {
      if n.fnName != "" {
        names.push(n.fnName)
        decls.push(i)
      }
    } else {
      clNoteWrite(n, asg)
    }
    i = i + 1
  }
  if cands.length == 0 { return 0 }
  clWritten = Map()
  clDecls = Map()
  clLet = Map()
  clNeed = Map()
  let fresh: string[] = []
  for c in cands {
    const cd = nodeAt(c)
    if cd is LetDecl {
      fresh.push(cd.letName)
      const v = nodeAt(fsParenPeel(cd.letInit))
      if v is Ident { fresh.push(v.identName) }
      if v is ArrayLit {
        for e in v.arrElems {
          const en = nodeAt(fsParenPeel(e))
          if en is Ident { fresh.push(en.identName) }
        }
      }
    }
  }
  let alive: i32[] = []
  while fresh.length > 0 {
    clRecord(fresh, names, decls, asg)
    clMissed = []
    alive = fsConstAlive(cands)
    fresh = clMissed
  }
  if alive.length == 0 { return 0 }
  let t = 0
  while t + 2 < P.toks.length {
    if P.toks[t].kind == "EXPORT" && P.toks[t + 1].kind == "LET" {
      clWritten[P.toks[t + 2].text] = true
    }
    t = t + 1
  }
  for c in fsConstAlive(alive) {
    const cd = nodeAt(c)
    if cd is LetDecl { cd.letKw = "const" }
  }
  0
}

// Notes in `asg` the name the `=` `n` writes, when its target is a bare name; every node kind
// that declares no name reaches here, and only an assignment writes one.
function clNoteWrite(n: Node, asg: string[]): i32 {
  if n is BinExpr && n.binOp == "=" {
    const l = nodeAt(n.binLeft)
    if l is Ident { asg.push(l.identName) }
  }
  0
}

// The candidates in `cands` that no `=` writes by name and whose value `fsFixedFnValue` fixes.
function fsConstAlive(cands: i32[]): i32[] {
  const out: i32[] = []
  for c in cands {
    const n = nodeAt(c)
    if (
      n is LetDecl
      && !(clWritten[n.letName] ?? false)
      && (fsFixedFnValue(n.letInit, 0) || fsFixedFnList(n.letInit))
    ) {
      out.push(c)
    }
  }
  out
}

// Whether `v` is a non-empty list literal whose every element `fsFixedFnValue` fixes.
function fsFixedFnList(v: i32): boolean {
  const n = nodeAt(fsParenPeel(v))
  if !(n is ArrayLit) || n.arrElems.length == 0 { return false }
  let ok = true
  for e in n.arrElems {
    if !fsFixedFnValue(e, 0) { ok = false }
  }
  ok
}

// Records the `=` writes, declaration count and declaring node of each name in `fresh` not yet
// in `clNeed`. `names[k]` is declared by node `decls[k]` (-1 for a parameter, which counts but
// is never the declaring node), and `asg` holds every `=` target name.
function clRecord(
  fresh: string[],
  names: string[],
  decls: i32[],
  asg: string[],
): i32 {
  const add: {[string]: boolean} = Map()
  for nm in fresh {
    if !(clNeed[nm] ?? false) {
      clNeed[nm] = true
      add[nm] = true
    }
  }
  for nm in asg {
    if add[nm] ?? false { clWritten[nm] = true }
  }
  let k = 0
  while k < names.length {
    const nm = names[k]
    if add[nm] ?? false {
      clDecls[nm] = (clDecls[nm] ?? 0) + 1
      if decls[k] >= 0 { clLet[nm] = decls[k] }
    }
    k = k + 1
  }
  0
}

// Whether `fsFixedFnValue` of `v`, or `fsFixedFnList`, can hold: `v` is a lambda, a name or a
// non-empty list literal of those, parentheses aside.
function fsMayHoldFixedFn(v: i32): boolean {
  const x = fsParenPeel(v)
  if x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  if !(n is ArrayLit) { return fsMayBeFixedFn(x) }
  if n.arrElems.length == 0 { return false }
  for e in n.arrElems {
    if !fsMayBeFixedFn(e) { return false }
  }
  true
}

// Whether `v` is a lambda or a name, parentheses aside.
function fsMayBeFixedFn(v: i32): boolean {
  const x = fsParenPeel(v)
  if x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  if n is FuncDecl { return n.fnName == "" }
  n is Ident
}

// Whether value `v` is a lambda, or a name declared once as a named function or as an unwritten
// binding holding such a value; a copy of a written binding holds whatever the last write stored.
function fsFixedFnValue(v: i32, depth: i32): boolean {
  const n = nodeAt(fsParenPeel(v))
  if n is FuncDecl { return n.fnName == "" }
  if !(n is Ident) || depth > 16 { return false }
  const nm = n.identName
  if !(clNeed[nm] ?? false) {
    clMissed.push(nm)
    return false
  }
  if (clDecls[nm] ?? 0) != 1 || (clWritten[nm] ?? false) { return false }
  const d = clLet[nm] ?? -1
  if d < 0 { return false }
  const dn = nodeAt(d)
  if dn is FuncDecl { return true }
  dn is LetDecl && dn.letInit >= 0 && fsFixedFnValue(dn.letInit, depth + 1)
}

// The statements of a block or the program; empty for any other node.
function fsStmtsOf(o: i32): i32[] {
  const n = nodeAt(o)
  if n is Block { return n.blkStmts }
  if n is Program { return n.progStmts }
  fsNoStmts("a node that holds no statement list")
}

// The statement list holding parse node `s`, as its owner's index, or -1.
function fsListOwner(s: i32): i32 {
  let i = 0
  while i < fsParseLen {
    if hasI32(fsStmtsOf(i), s) { return i }
    i = i + 1
  }
  -1
}

// `v`, the answer for the kinds a ladder does not handle, which `why` names.
function fsExcluded(v: i32, _why: string): i32 { v }

// No statements, for the node kinds a ladder does not handle, which `why` names.
function fsNoStmts(_why: string): i32[] { [] }

// Inserts `x` after `anchor` in its statement list, unless `anchor` is the value a `break`
// carries out of the list. -1 when it cannot.
function fsInsertAfter(anchor: i32, x: i32): i32 {
  const o = fsListOwner(anchor)
  if o < 0 { return -1 }
  const xs = fsStmtsOf(o)
  const out: i32[] = []
  let i = 0
  while i < xs.length {
    out.push(xs[i])
    if xs[i] == anchor {
      if i + 1 < xs.length {
        const nx = nodeAt(xs[i + 1])
        if nx is BreakStmt && nx.brkHasVal == 1 { return -1 }
      }
      out.push(x)
    }
    i = i + 1
  }
  fsSetStmts(o, out)
}

// Inserts `x` before `anchor` in its statement list. -1 when it cannot.
function fsInsertBefore(anchor: i32, x: i32): i32 {
  fsInsertBeforeIn(fsListOwner(anchor), anchor, x)
}

// Inserts `x` before `anchor` in the statement list of `o`. -1 when it cannot.
function fsInsertBeforeIn(o: i32, anchor: i32, x: i32): i32 {
  if o < 0 { return -1 }
  const out: i32[] = []
  for s in fsStmtsOf(o) {
    if s == anchor { out.push(x) }
    out.push(s)
  }
  fsSetStmts(o, out)
}

// Sets the statement list of `o`, a block or the program, to `out`. -1 for another node.
function fsSetStmts(o: i32, out: i32[]): i32 {
  const on = nodeAt(o)
  if on is Block {
    on.blkStmts = out
    return 0
  }
  if on is Program {
    on.progStmts = out
    return 0
  }
  fsExcluded(-1, "a node that holds no statement list")
}

// The token a parse node starts at: scans back from its last token to the one at its offset.
function fsFirstTok(ix: i32): i32 {
  if ix < 0 || ix >= nodeToks.length { return -1 }
  let t = nodeToks[ix]
  const at = nodeAt(ix).pos
  while t >= 0 && P.toks[t].start != at { t = t - 1 }
  t
}

// A fresh value: slot `name` when set, else a fresh copy of parse node `src`. -2 declines.
function fsValueNode(src: i32, name: string): i32 {
  if src < 0 { return -1 }
  const n = nodeAt(src)
  if name != "" { return mkIdent(name, n.pos) }
  if n is Ident { return mkIdent(n.identName, n.pos) }
  if n is FuncDecl {
    const f = reparseArrowLambdaAt(fsFirstTok(src))
    if f < 0 { return -2 }
    return f
  }
  const cx = fsParenPeel(src)
  if cx < 0 || cx >= P.nodes.length { return -2 }
  const cn = nodeAt(cx)
  if cn is IfStmt || cn is MatchExpr {
    // Copied from its tokens, since the check lowers a `match` to an `if` chain in place.
    const e = reparseChoiceExprAt(fsFirstTok(cx))
    if e < 0 || !(nodeAt(e) is IfStmt || nodeAt(e) is MatchExpr) { return -2 }
    return e
  }
  if cn is ArrayLit {
    const e = reparseChoiceExprAt(fsFirstTok(cx))
    if e < 0 || !(nodeAt(e) is ArrayLit) { return -2 }
    return e
  }
  fsExcluded(
    -2,
    "a value that is not a name, a lambda, a list or a choice of names",
  )
}

// Annotation `t` names type `nm`; the parser's spelling tree for it is dropped, since every
// resolver reads that tree before the name (D6523). `rc`, or -1 when `t` is not a `TypeRef`.
function fsRenameTypeRef(t: i32, nm: string, rc: i32): i32 {
  const tn = nodeAt(t)
  if !(tn is TypeRef) { return -1 }
  clearAnnTs(t)
  tn.tyName = nm
  rc
}

function fsApply(): i32 {
  const savedPos = P.pos
  let rc = 0
  let i = 0
  while i < prIdent.length {
    const n = nodeAt(prIdent[i])
    if n is Ident { n.identName = prName[i] } else { rc = -1 }
    i = i + 1
  }
  i = 0
  while i < plCall.length {
    if rc == 0 { rc = fsApplyLoopLane(i) }
    i = i + 1
  }
  i = 0
  while i < pmStmt.length {
    if rc == 0 { rc = fsApplyPushMirror(i) }
    i = i + 1
  }
  i = 0
  while i < psPar.length {
    const p = nodeAt(psPar[i])
    const f = nodeAt(psFn[i])
    if p is Param && p.parType < 0 && f is FuncDecl {
      P.pos = nodeToks[psPar[i]] + 1
      p.parType = mkTypeRef(psName[i], p.pos)
      f.fnTyParams.push(psName[i])
    } else if p is Param && f is FuncDecl {
      rc = fsRenameTypeRef(p.parType, psName[i], rc)
      f.fnTyParams.push(psName[i])
    } else {
      rc = -1
    }
    i = i + 1
  }
  i = 0
  while i < psRetype.length {
    rc = fsRenameTypeRef(psRetype[i], psRetypeName[i], rc)
    i = i + 1
  }
  i = 0
  while i < pmCall.length {
    const c = nodeAt(pmCall[i])
    if c is Call && c.callFn >= 0 {
      P.pos = nodeToks[c.callFn] + 1
      c.callFn = mkIdent(pmName[i], nodeAt(c.callFn).pos)
    } else {
      rc = -1
    }
    i = i + 1
  }
  i = 0
  while i < pxObj.length {
    const o = nodeAt(pxObj[i])
    if o is ObjLit {
      P.pos = nodeToks[pxObj[i]] + 1
      const pos = o.pos
      o.objFields.push(mkFieldInit(pxField[i], mkIdent(pxName[i], pos), pos))
    } else {
      rc = -1
    }
    i = i + 1
  }
  i = 0
  while i < pxMember.length {
    const m = nodeAt(pxMember[i])
    if m is Member { m.memProp = pxMemberName[i] } else { rc = -1 }
    i = i + 1
  }
  i = 0
  while i < phLit.length {
    const c = nodeAt(phStmt[i])
    if rc == 0 && c is Call {
      P.pos = nodeToks[phLit[i]] + 1
      const pos = nodeAt(phLit[i]).pos
      c.callArgs[phArg[i]] = mkIdent(phName[i], pos)
      rc = fsInsertBefore(
        phStmt[i],
        mkLet("const", phName[i], -1, phLit[i], pos),
      )
    } else {
      rc = -1
    }
    i = i + 1
  }
  i = 0
  while i < pcAnchor.length {
    const d = nodeAt(pcAnchor[i])
    const names: string[] = []
    pcLeaves.push(names)
    const c = if d is LetDecl { d.letInit } else { -1 }
    if (
      rc == 0
      && d is LetDecl
      && c >= 0
      && c < P.nodes.length
      && c < nodeToks.length
    ) {
      // The binding's own choice, its leaves numbered, becomes the arm index binding.
      P.pos = nodeToks[c] + 1
      const pos = nodeAt(c).pos
      const cn = nodeAt(c)
      if pcCallFn[i] == "" {
        rc = fsNumberLeaves(c, names, 0)
      } else if cn is Call && cn.callFn >= 0 && cn.callFn < P.nodes.length {
        cn.callFn = mkIdent(pcCallFn[i], nodeAt(cn.callFn).pos)
        for l in pcCallLeaves[i] { names.push(l) }
      } else {
        rc = -1
      }
      const sel = fsSelectArm(pcName[i], names, pos)
      if rc == 0 && sel >= 0 {
        d.letInit = sel
        const kw = if hasI32(pcwPc, i) { "let" } else { "const" }
        rc = fsInsertBefore(pcAnchor[i], mkLet(kw, pcName[i], -1, c, pos))
      } else {
        rc = -1
      }
    } else {
      rc = -1
    }
    i = i + 1
  }
  i = 0
  while i < lhDecl.length {
    if rc == 0 { rc = fsApplyListHoist(i) }
    i = i + 1
  }
  i = 0
  while i < pdAnchor.length {
    if rc == 0 {
      const a = pdAnchor[i]
      P.pos = nodeToks[a] + 1
      // A copy of a choice evaluated once selects its arm by the arm index binding.
      let ci = 0
      while ci < pcAnchor.length && pcAnchor[ci] != a { ci = ci + 1 }
      let v = -2
      if ci < pcAnchor.length {
        v = fsSelectArm(pcName[ci], pcLeaves[ci], nodeAt(a).pos)
        if v < 0 { v = -2 }
      } else {
        v = fsValueNode(pdValSrc[i], pdValName[i])
        if fsListHoistSelect(a, v) < 0 { v = -2 }
      }
      let ty = -1
      // A lane of a binding whose type parameter is stripped is un-annotated too (D6761).
      if pdTy[i] >= 0 && !hasI32(ptPar, a) {
        const tn = nodeAt(pdTy[i])
        if tn is TypeRef {
          ty = mkTypeRef(tn.tyName, tn.pos)
          const tsr = annTsOf(pdTy[i])
          if tsr >= 0 { setAnnTs(ty, tsr) }
        } else {
          rc = -1
        }
      }
      if v == -2 { rc = -1 }
      if rc == 0 {
        P.pos = nodeToks[a] + 1
        rc = fsInsertAfter(a, mkLet(pdKw[i], pdName[i], ty, v, nodeAt(a).pos))
      }
    }
    i = i + 1
  }
  i = 0
  while i < pcwWrite.length {
    if rc == 0 { rc = fsApplyChoiceWrite(i) }
    i = i + 1
  }
  i = 0
  while i < pwAnchor.length {
    if rc == 0 {
      const a = pwAnchor[i]
      P.pos = nodeToks[a] + 1
      const v = fsValueNode(pwValSrc[i], pwValName[i])
      if v < 0 { rc = -1 }
      if rc == 0 {
        P.pos = nodeToks[a] + 1
        const pos = nodeAt(a).pos
        rc = fsInsertAfter(a, mkBinary("=", mkIdent(pwName[i], pos), v, pos))
      }
    }
    i = i + 1
  }
  i = 0
  while i < pfAnchor.length {
    if rc == 0 {
      const f = reparseFuncDeclAt(fsFirstTok(pfSrc[i]))
      rc = -1
      if f >= 0 {
        const fn = nodeAt(f)
        if fn is FuncDecl {
          fn.fnName = pfName[i]
          fsApplyCopyRenames(i, f)
          fsApplyCopyDrops(i, fn)
          rc = fsApplyCopyArgs(i, f)
          if rc == 0 { rc = fsInsertAfter(pfAnchor[i], f) }
        }
      }
    }
    i = i + 1
  }
  i = 0
  while i < ppAfter.length {
    if rc == 0 { rc = fsApplyParams(ppAfter[i], ppNames[i]) }
    i = i + 1
  }

  for par in ptPar {
    const p = nodeAt(par)
    if p is Param { p.parType = -1 }
    else if p is LetDecl { p.letType = -1 }
    else { rc = -1 }
  }
  i = 0
  while i < paCall.length {
    if rc == 0 { rc = fsApplyArgs(paCall[i], paArg[i], paNames[i], paPars[i]) }
    i = i + 1
  }
  if rc == 0 { rc = fsApplyChoiceRets() }
  i = 0
  while i < pkCall.length {
    if rc == 0 { rc = fsApplyArgDrop(pkCall[i], pkArg[i]) }
    i = i + 1
  }
  for par in pzPar {
    if rc == 0 { rc = fsApplyParamDrop(par) }
  }
  P.pos = savedPos
  rc
}

// Copy `i`, minted as function `fn`, without the parameters planned dropped from it.
function fsApplyCopyDrops(i: i32, fn: FuncDecl): i32 {
  let j = 0
  while j < pqCopy.length {
    if pqCopy[j] == i {
      const out: i32[] = []
      for q in fn.fnParams {
        const qn = nodeAt(q)
        if !(qn is Param && qn.parName == pqName[j]) { out.push(q) }
      }
      fn.fnParams = out
    }
    j = j + 1
  }
  0
}

// Parameter `par`'s function without it. -1 when it cannot.
function fsApplyParamDrop(par: i32): i32 {
  let fd = 0
  while fd < fsParseLen {
    const f = nodeAt(fd)
    if f is FuncDecl && hasI32(f.fnParams, par) {
      const out: i32[] = []
      for q in f.fnParams {
        if q != par { out.push(q) }
      }
      f.fnParams = out
      return 0
    }
    fd = fd + 1
  }
  -1
}

// Call `c` without its argument `a`. -1 when it cannot.
function fsApplyArgDrop(c: i32, a: i32): i32 {
  const cn = nodeAt(c)
  if !(cn is Call) { return -1 }
  const args: i32[] = []
  const nms: string[] = []
  let found = false
  let i = 0
  while i < cn.callArgs.length {
    if cn.callArgs[i] == a {
      found = true
    } else {
      args.push(cn.callArgs[i])
      if i < cn.callArgNames.length { nms.push(cn.callArgNames[i]) }
    }
    i = i + 1
  }
  if !found { return -1 }
  cn.callArgs = args
  if cn.callArgNames.length > 0 { cn.callArgNames = nms }
  0
}

// Un-annotated parameters `names` after parameter `par` of its function. -1 when it cannot.
function fsApplyParams(par: i32, names: string[]): i32 {
  let fd = 0
  while fd < fsParseLen {
    const f = nodeAt(fd)
    if f is FuncDecl && hasI32(f.fnParams, par) {
      const at = nodeAt(par).pos
      const out: i32[] = []
      for x in f.fnParams {
        out.push(x)
        if x == par {
          for nm in names {
            P.pos = nodeToks[par] + 1
            out.push(mkParam(nm, -1, -1, 0, 0, at))
          }
        }
      }
      f.fnParams = out
      return 0
    }
    fd = fd + 1
  }
  -1
}

// Arguments reading `names` after argument `a` of call `c`, each passed by its name in `pars`
// when `a` is named; a name "" is a fresh copy of the lambda literal `a`. -1 when it cannot.
function fsApplyArgs(c: i32, a: i32, names: string[], pars: string[]): i32 {
  const cn = nodeAt(c)
  if !(cn is Call) || a < 0 || a >= P.nodes.length || a >= nodeToks.length {
    return -1
  }
  const args: i32[] = []
  const nms: string[] = []
  // In a call naming any argument, a positional one inserted could take another's slot.
  const named = hasNamedArgs(cn.callArgNames)
  let i = 0
  while i < cn.callArgs.length {
    args.push(cn.callArgs[i])
    let nm0 = ""
    if i < cn.callArgNames.length { nm0 = cn.callArgNames[i] }
    nms.push(nm0)
    if cn.callArgs[i] == a {
      if named && pars.length != names.length { return -1 }
      let j = 0
      while j < names.length {
        P.pos = nodeToks[a] + 1
        const v = fsValueNode(fsParenPeel(a), names[j])
        if v < 0 { return -1 }
        args.push(v)
        if named { nms.push(pars[j]) } else { nms.push("") }
        j = j + 1
      }
    }
    i = i + 1
  }
  cn.callArgs = args
  if cn.callArgNames.length > 0 { cn.callArgNames = nms }
  0
}

// Applies the arguments planned inside copy `i`, minted as parse node `f`; -1 when a planned
// argument is not found there.
function fsApplyCopyArgs(i: i32, f: i32): i32 {
  let j = 0
  while j < pyCopy.length {
    if pyCopy[j] == i {
      let done = false
      const stack: i32[] = [f]
      while stack.length > 0 {
        const x = stack.pop()
        const n = nodeAt(x)
        if n is Call {
          for a in n.callArgs {
            const an = nodeAt(a)
            if (
              !done
              && an is Ident
              && an.pos == pyPos[j]
              && an.identName == pyName[j]
            ) {
              if fsApplyArgs(x, a, pyNames[j], pyPars[j]) < 0 { return -1 }
              done = true
            }
          }
        }
        for c in nodeChildren(x) {
          if c >= fsParseLen && c < P.nodes.length { stack.push(c) }
        }
      }
      if !done { return -1 }
    }
    j = j + 1
  }
  0
}

// Applies the renames planned inside copy `i`, minted as parse node `f`.
function fsApplyCopyRenames(i: i32, f: i32): i32 {
  let j = 0
  while j < pcCopy.length {
    if pcCopy[j] == i {
      const stack: i32[] = [f]
      while stack.length > 0 {
        const x = stack.pop()
        const n = nodeAt(x)
        if n is Ident && n.pos == pcPos[j] && n.identName == pcFrom[j] {
          n.identName = pcTo[j]
        }
        for c in nodeChildren(x) {
          if c >= fsParseLen && c < P.nodes.length { stack.push(c) }
        }
      }
    }
    j = j + 1
  }
  0
}
