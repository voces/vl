// `emit_union_tykey.vl` — the union registry's type key: an order-independent identity for a
// row, minted beside its name key, and the test every registration takes before minting, so
// a type key holds one row.

import { TyUnion, tyAt } from "./check_types"
import {
  unMemAtoms,
  unMemKinds,
  unMemTyCount,
  unMemTyStart,
  unMemTys,
  unTyIx,
  unTyKey,
  unTyKeyFirstRow,
} from "./emit_state"
import {
  unRowOfTyKey,
  utkIdOf,
  utkMemberText,
  utkTextOf,
  utkTyKeyText,
} from "./emit_union_tykey_text"
export { unRowOfTyKey } from "./emit_union_tykey_text"

// The key text of row `u`: its own type's (`unTyIx`) where it has one, as a lookup keys that
// type, since the recorded members soften a literal to its base; else the recorded members',
// an atom no member type resolves keyed by the row's type or as `?` plus its spelling.
function utkRowText(u: i32): string {
  if u < 0 || u >= unMemTyStart.length || u >= unMemTyCount.length { return "" }
  if u < unTyIx.length && unTyIx[u] >= 0 {
    const own = utkTyKeyText(unTyIx[u])
    if own != "" { return own }
  }
  const s = unMemTyStart[u]
  if s < 0 { return "" }
  const texts: string[] = []
  let open = false
  let i = 0
  while i < unMemTyCount[u] {
    const m = s + i
    if m >= unMemTys.length || m >= unMemKinds.length { return "" }
    if unMemKinds[m] == 0 {
      texts.push("null")
    } else if unMemTys[m] < 0 {
      const at = utkAtomText(unMemAtoms[m])
      texts.push(at)
      if at.slice(0, 1) == "?" { open = true }
    } else {
      texts.push(utkMemberText(unMemTys[m]))
    }
    i = i + 1
  }
  if open && u < unTyIx.length && unTyIx[u] >= 0 {
    const t = utkTyKeyText(unTyIx[u])
    if t != "" { return t }
  }
  utkTextOf(texts)
}

// The key text of an atom no member type resolves: `?` plus its spelling, which keys no other
// row's text, so the row falls back to its own type's key where it has one.
function utkAtomText(a: string): string { "?" + a }

// Appends the type key of the row just minted, so `unTyKey` stays parallel to the member columns.
export function unTyKeyPushRow() {
  while unTyKey.length + 1 < unMemTyStart.length { unTyKey.push(-1) }
  const t = utkRowText(unMemTyStart.length - 1)
  let id = -1
  if t != "" { id = utkIdOf(t) }
  unTyKey.push(id)
  if id >= 0 {
    while unTyKeyFirstRow.length <= id { unTyKeyFirstRow.push(-1) }
    if unTyKeyFirstRow[id] < 0 { unTyKeyFirstRow[id] = unTyKey.length - 1 }
  }
  0
}

// True when union `ty`'s type key already has a row, which every spelling of `ty` then names:
// one row per key. False with no type or a union type of one member.
export function unTyKeyHasRow(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyUnion {
    if t.uMembers.length < 2 { return false }
  }
  const r = unRowOfTyKey(ty)
  r >= 0 && r < unMemTyStart.length
}
