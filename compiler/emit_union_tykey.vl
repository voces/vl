// `emit_union_tykey.vl` — the union registry's type key: an order-independent identity for a
// row, minted beside its name key, and the adopt that binds an unregistered spelling to the row
// its type keys to.

import { canonUnionMemberTysOf } from "./check_program"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  cUserTypes,
  tyAt,
} from "./check_types"
import {
  unMemAtoms,
  unMemKinds,
  unMemTyCount,
  unMemTyStart,
  unMemTys,
  unRowBySid,
  unTyIx,
  unTyKey,
  unTyKeyFirstRow,
} from "./emit_state"
import {
  TY_WALK_DEPTH,
  unRowOfTyKey,
  utkIdOf,
  utkMemberText,
  utkTextOf,
  utkTyKeyText,
} from "./emit_union_tykey_text"
export { unRowOfTyKey } from "./emit_union_tykey_text"
import { unNameBound } from "./emit_union_registry"
import { sidArrPut, sidOf } from "./symbols"

// The key text of row `u`: its own type's (`unTyIx`) where it has one, as a lookup keys that
// type, since the recorded members soften a literal to its base; else the recorded members',
// an atom no member type resolves keyed by the row's type or as `?` plus its spelling.
function utkRowText(u: i32): string {
  if u < 0 || u >= unMemTyStart.length || u >= unMemTyCount.length { return "" }
  if u < unTyIx.length && unTyIx[u] >= 0 {
    const own = utkTyKeyText(unTyIx[u])
    if own != "" { return own }
  }
  const s = unMemTyStart[u]
  if s < 0 { return "" }
  const texts: string[] = []
  let open = false
  let i = 0
  while i < unMemTyCount[u] {
    const m = s + i
    if m >= unMemTys.length || m >= unMemKinds.length { return "" }
    if unMemKinds[m] == 0 {
      texts.push("null")
    } else if unMemTys[m] < 0 {
      const at = utkAtomText(unMemAtoms[m])
      texts.push(at)
      if at.slice(0, 1) == "?" { open = true }
    } else {
      texts.push(utkMemberText(unMemTys[m]))
    }
    i = i + 1
  }
  if open && u < unTyIx.length && unTyIx[u] >= 0 {
    const t = utkTyKeyText(unTyIx[u])
    if t != "" { return t }
  }
  utkTextOf(texts)
}

// The key text of an atom no member type resolves: `?` plus its spelling, which keys no other
// row's text, so the row falls back to its own type's key where it has one.
function utkAtomText(a: string): string { "?" + a }

// Appends the type key of the row just minted, so `unTyKey` stays parallel to the member columns.
export function unTyKeyPushRow() {
  while unTyKey.length + 1 < unMemTyStart.length { unTyKey.push(-1) }
  const t = utkRowText(unMemTyStart.length - 1)
  let id = -1
  if t != "" { id = utkIdOf(t) }
  unTyKey.push(id)
  if id >= 0 {
    while unTyKeyFirstRow.length <= id { unTyKeyFirstRow.push(-1) }
    if unTyKeyFirstRow[id] < 0 { unTyKeyFirstRow[id] = unTyKey.length - 1 }
  }
  0
}

// True when `name` names a row, after binding an unregistered spelling to the row its type key
// finds, aliased under the key of `name`, when the two place `null` alike. With no type, a
// declared alias name, or a union type of one member, it stays unbound and answers false.
export function unNameAdoptTyKeyRow(name: string, ty: i32): boolean {
  if unNameBound(name) { return true }
  if name == "" || (cUserTypes[name] ?? -1) >= 0 { return false }
  let r = -1
  if ty >= 0 {
    const t = tyAt(ty)
    if t is TyUnion {
      if t.uMembers.length < 2 { return false }
    }
    r = unRowOfTyKey(ty)
    if r < 0 || r >= unMemTyStart.length { return false }
    if utkTyNullShape(ty) != utkRowNullShape(r) { return false }
  } else {
    return false
  }
  sidArrPut(unRowBySid, sidOf(name), r)
  true
}

// Where `null` sits among the members of union `ty`, in its name's order: "n" for null, "m"
// otherwise; "?" when a member has no render.
function utkTyNullShape(ty: i32): string {
  const mems: i32[] = []
  if !canonUnionMemberTysOf(ty, mems) { return "?" }
  let out = ""
  for m in mems {
    if m < 0 { out = out + "n" } else { out = out + "m" }
  }
  out
}

// Where `null` sits among the members of row `r`: "n" for null, "m" otherwise, a declared union
// atom expanded through its type; "" for a row with no member slice.
function utkRowNullShape(r: i32): string {
  if (
    r >= unMemTyStart.length
    || r >= unMemTyCount.length
    || unMemTyStart[r] < 0
  ) {
    return ""
  }
  const s = unMemTyStart[r]
  let out = ""
  let i = 0
  while i < unMemTyCount[r] && s + i < unMemAtoms.length {
    const a = unMemAtoms[s + i]
    const di = cUserTypes[a] ?? -1
    if a == "null" { out = out + "n" }
    else if di >= 0 { out = out + utkNullShapeOfTy(di, 0) }
    else { out = out + "m" }
    i = i + 1
  }
  out
}

// `utkRowNullShape` of declared type `ty`, a nullable placing its `null` last.
function utkNullShapeOfTy(ty: i32, depth: i32): string {
  if ty < 0 || ty >= T.tys.length || depth > TY_WALK_DEPTH { return "m" }
  const t = tyAt(ty)
  match t {
    TyNullable => {
      return utkNullShapeOfTy(t.nInner, depth + 1) + "n"
    }
    TyUnion => {
      let out = ""
      for m in t.uMembers { out = out + utkNullShapeOfTy(m, depth + 1) }
      return out
    }
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyLit | TyNeg => {
      return "m"
    }
  }
}
