// `constrainEmpty` at a position that holds the source expression — the form every site that
// pins and then asks `assignableExpr` must use. The pin erases its own trigger, since
// `recordRepTyAdopt` records a literal's destination rep only while `tyReachesEmptyHole` holds,
// so the recording happens on that same condition and before the pin.
export function constrainEmptyExpr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if !inferQuiet && srcExpr >= 0 && tyReachesEmptyHole(srcTy, 8) {
    recordRepTyAdopt(srcExpr, dstTy, 6)
  }
  if inferQuiet || srcExpr < 0 { return constrainEmpty(srcTy, dstTy) }
  holeLinkSiteSet(srcExpr, srcTy, dstTy)
  constrainEmpty(srcTy, dstTy)
  holeLinkSiteSet(-1, -1, -1)
}

// The inferred return `observed` of the body whose witness frame is on top, re-typed f32 when
// some witness is an f32 value and every other is a float literal, as an
// `if` join does (`joinF32LitTails`). Retires the frame whether or not it re-types.
export function inferRetF32Join(inferring: boolean, observed: i32): i32 {
  if irwMarks.length == 0 { return observed }
  const mark = irwMarks[irwMarks.length - 1]
  irwMarks.pop()
  let res = observed
  if (
    inferring
    && observed >= 0
    && primNameOf(observed) != "f32"
    && f32JoinRetypesRunning()
  ) {
    const fTy = inferRetF32Of(mark)
    if fTy >= 0 { res = fTy }
  }
  while irwExprs.length > mark {
    irwExprs.pop()
    irwTys.pop()
  }
  res
}

// The f32 type the witnesses from `mark` on join to when they are f32 values and literals.
function inferRetF32Of(mark: i32): i32 {
  const es: i32[] = []
  const ts: i32[] = []
  let i = mark
  while i < irwExprs.length {
    const t = irwTys[i]
    // A value-less or diverging path delivers nothing to the join.
    if t != TY_VOID && primNameOf(t) != "never" {
      es.push(irwExprs[i])
      ts.push(t)
    }
    i = i + 1
  }
  f32LitJoinOf(es, ts)
}

// The f32 type a join of the values `exprs`, typed `tys`, takes when some are f32 values and
// every other is a float literal or a join of them (`floatLitTails`); else -1. The
// literals' `if` and `match` nodes are re-typed f32 only when the whole join qualifies.
export function f32LitJoinOf(exprs: i32[], tys: i32[]): i32 {
  // The common join has no f32 member; it is answered by type tests alone.
  let j = 0
  while j < tys.length && primNameOf(tys[j]) != "f32" { j = j + 1 }
  if j == tys.length { return -1 }
  let fTy = -1
  let lits = 0
  const savedQuiet = inferQuiet
  inferQuiet = true
  quietDepth = quietDepth + 1
  let i = 0
  while i < exprs.length && lits >= 0 {
    if primNameOf(tys[i]) == "f32" { fTy = joinTys(fTy, tys[i]) }
    else if floatLitTails(exprs[i]) { lits = lits + 1 }
    else { lits = -1 }
    i = i + 1
  }
  inferQuiet = savedQuiet
  quietDepth = quietDepth - 1
  if lits <= 0 || fTy < 0 || primNameOf(fTy) != "f32" { return -1 }
  if !inferQuiet {
    let k = 0
    while k < exprs.length {
      if primNameOf(tys[k]) != "f32" { f32LitTailsAdopt(exprs[k], TY_F32) }
      k = k + 1
    }
  }
  fTy
}

export function cellTagsMayAlias(a: string, b: string): boolean {
  if a == "" || b == "" { return true }
  if a[1] != b[1] { return false }
  const ea = decDigitsOf(a.slice(2, a.length))
  const eb = decDigitsOf(b.slice(2, b.length))
  if ea < 0 || eb < 0 { return true }
  assignable(ea, eb) || assignable(eb, ea)
}

// `keyStepTags` for an element entry: the tags of the list as declared, since the narrowing
// says what its cells hold now and not which other lists may be the same object.
export function listEveryTags(p: i32, steps: string[]): string[] {
  const s = placeDecl(p)
  let t = narDeclaredTy(s, -1)
  if t < 0 { t = declTyOf(s) }
  const out: string[] = []
  for st in steps {
    t = listUnionWidest(t)
    out.push(keyStepTag(st, t))
    if t >= 0 { t = placeElemTy(t) }
  }
  out
}

// The member of a union of lists `t` whose element every other member's element is assignable
// to, which may alias whatever any member may; `t` itself when there is none or it is no union.
export function listUnionWidest(t: i32): i32 {
  const n = nonNullTy(t)
  if n < 0 { return t }
  const u = tyAt(n)
  if !(u is TyUnion) { return t }
  for m in u.uMembers {
    if m < 0 { return t }
  }
  for m in u.uMembers {
    const mt = tyAt(m)
    if mt is TyArray {
      let all = true
      for o in u.uMembers {
        const ot = tyAt(o)
        if !(ot is TyArray) || !assignable(ot.aElem, mt.aElem) { all = false }
      }
      if all { return m }
    }
  }
  t
}

// Whether a list `depth` deep whose leaf is `leaf` is delivered to `dst` leaf for leaf.
export function listLeafFits(leaf: i32, dst: i32, depth: i32): boolean {
  let d = dst
  let k = 0
  while k < depth {
    const dn = nonNullTy(d)
    if dn < 0 { return false }
    const da = tyAt(dn)
    if !(da is TyArray) { return false }
    d = da.aElem
    k = k + 1
  }
  d >= 0 && assignable(leaf, d)
}

// Shared-field access over a struct union: a field present on every member is readable on the
// union directly and its type is the join of the per-member field types. -1 when a member lacks
// the field or is not a struct. The join is what admits a discriminated union, whose arms carry
// the tag at mutually unassignable literal types; whether the read lowers is `sharedUnionFieldPlan`'s.
export function sharedUnionFieldTy(u: TyUnion, prop: string) {
  const members = u.uMembers
  if members.length < 1 { return -1 }
  let shared = -1
  let i = 0
  while i < members.length {
    const mIx = members[i]
    if mIx < 0 { return -1 }
    const m = tyAt(mIx)
    if m is TyObj {
      const ft = objFieldType(m, prop)
      if ft < 0 { return -1 }
      if shared < 0 {
        shared = ft
      } else {
        // Runtime field values of different numeric types join apart, as an `if` over the
        // members' reads would.
        njApartSet(true)
        // Each member's field is a record that already exists, so the join keeps it a member
        // rather than widening it in place, as a `??` over two existing records does (D15314).
        njFixSet(true, true)
        shared = joinTys(shared, ft)
      }
    } else {
      return -1
    }
    i = i + 1
  }
  shared
}

// Refuses a shared-field read whose join would hold a list of one member's field type as a
// list another member stores differently, the refusal an `if` over the members' reads takes
// (`listJoinWidenCheck`). True when it refused.
export function sharedFieldJoinWidens(
  u: TyUnion,
  prop: string,
  sf: i32,
  ix: i32,
): boolean {
  for mIx in u.uMembers {
    if mIx >= 0 && mIx < T.tys.length {
      const m = tyAt(mIx)
      if m is TyObj {
        const ft = objFieldType(m, prop)
        if ft >= 0 && listJoinStorageDiffers(ft, sf, 8) {
          tErr(
            "`"
              + prop
              + "` is "
              + tyToStr(ft)
              + " on "
              + tyToStr(mIx)
              + " and the members' read would join it as "
              + tyToStr(sf)
              + ": a container never widens implicitly, so narrow the receiver to one member first",
            ix,
          )
          return true
        }
      }
    }
  }
  false
}

// Whether `xs is chk` over the single list `cur` (or `cur | null`) narrows only its literal-set
// leaf, which keeps its storage: the name keeps its list type, since narrowed by name it would be
// delivered as `chk` while still holding what `cur` may store.
export function listNarrowsElemsOnly(cur: i32, chk: i32): boolean {
  const d0 = nonNullTy(cur)
  let d = d0
  let n = chk
  if d < 0 || n < 0 || tyHasTyVar(d) || !(tyAt(d) is TyArray) { return false }
  while d >= 0 && n >= 0 && tyAt(d) is TyArray && tyAt(n) is TyArray {
    const da = tyAt(d)
    const na = tyAt(n)
    if da is TyArray && na is TyArray {
      d = da.aElem
      n = na.aElem
    }
  }
  if d < 0 || n < 0 || tySame(d, n) || !assignable(n, d) { return false }
  if listFitLitLeafOf(chk, d0, []) < 0 { return false }
  listFitNarrowKeepsRep(cur, chk)
}

// Fold the tree at `ix` in place: 1 when it is rewritten into its value's literal, 2 when it is
// a constant the check refuses (reported here), 0 when it is no constant tree.
export function cexTryFold(ix: i32): i32 {
  if cexNotTree.length > 0 && (cexNotTree[ix] ?? false) { return 0 }
  if !cexRootShape(ix) || cexTreeShape(ix, 0) != 1 { return 0 }
  cexFoldAt(ix)
}

// `cexTryFold` for the operator `e` at `ix`, whose operator the caller has already admitted.
export function cexTryFoldBin(e: BinExpr, ix: i32): i32 {
  if cexNotTree.length > 0 && (cexNotTree[ix] ?? false) { return 0 }
  if cexTreeShape(e.binLeft, 1) != 1 || cexTreeShape(e.binRight, 1) != 1 {
    return 0
  }
  cexFoldAt(ix)
}

// Fold the tree at `ix`, whose shape is a constant tree's.
function cexFoldAt(ix: i32): i32 {
  const v = cexEvalAt(ix, 0)
  if v.cxNo || cexPastF64(v) {
    cexKeepWhole(ix, 0)
    return 0
  }
  if v.cxErr != "" {
    tErr(v.cxErr, ix)
    return 2
  }
  cexRewrite(ix, v)
  1
}

// A constant delivered into `dstTy`, a number or a union with a number member: one the type
// cannot hold is refused naming its value and the type, and a whole float constant at an
// integer destination becomes that integer. Answers whether this decided the delivery.
export function cexDeliver(srcExpr: i32, dstTy: i32): boolean {
  const lit = cexLitPeel(srcExpr)
  if lit < 0 { return false }
  const l = nodeAt(lit)
  if !(l is NumLit) { return false }
  const lt = nodeTyOf(lit)
  const isF = lt == TY_F64 || lt == TY_F32
  // Seven characters hold an integer every number type holds exactly, whatever the radix.
  if !isF && l.numText.length <= 7 { return false }
  let kind = 0
  if dstTy == TY_I32 || dstTy == TY_I64 { kind = 1 }
  else if dstTy == TY_F32 || dstTy == TY_F64 { kind = 2 }
  else if tyAt(dstTy) is TyUnion { kind = 3 }
  if kind == 0 { return false }
  // Nine hold none past the i32 range, which `i64` and `f64` hold exactly too.
  if !isF && l.numText.length <= 9 && (kind == 1 || dstTy == TY_F64) {
    return false
  }
  if !cexIsDerived(srcExpr) { return false }
  let v = cexOfLexeme(l.numText)
  if !cexOk(v) { return false }
  if intLitIsNegated(srcExpr) { v = cexNeg(v) }
  if kind == 3 { return cexDeliverUnion(v, lit, srcExpr, dstTy) }
  if cexFitsAt(v, l.numText, dstTy) {
    if kind == 2 || !v.cxFloat { return false }
    if !inferQuiet {
      arenaSetNode(lit, { numText: cexDecText(v), pos: l.pos })
      cexRetype(srcExpr, dstTy)
      cexConverted = true
    }
    return true
  }
  cexReported[lit] = true
  tErr(cexMisfitMsg(v, tyToStr(dstTy), kind == 2), srcExpr)
  true
}

// A constant `v` delivered into the union `dstTy` is refused when no number member holds it.
function cexDeliverUnion(v: Cex, lit: i32, srcExpr: i32, dstTy: i32): boolean {
  const members: i32[] = []
  flattenVariantsInto(dstTy, members)
  let numeric = false
  for m in members {
    if m == TY_I32 || m == TY_I64 || m == TY_F32 || m == TY_F64 {
      numeric = true
      if cexFitsAt(v, cexLexeme(v), m) { return false }
    }
  }
  if !numeric { return false }
  cexReported[lit] = true
  tErr(
    "constant " + cexShown(v) + " fits no member of " + tyToStr(dstTy),
    srcExpr,
  )
  true
}

// The hint at an `is` whose tested type is contained in another arm of the operand's union
// (`is B` over `A | B` with every `B` an `A`): `is` tests whether the value fits the type, so
// an `A` that fits `B` tests as a `B` (the owner's structural `is`, D3885).
export function recordContainedIsAt(
  n: IsExpr,
  ix: i32,
  objTy: i32,
  chkTy: i32,
) {
  if chkTy < 0 || objTy < 0 { return 0 }
  const ot = tyAt(objTy)
  if !(ot is TyUnion) { return 0 }
  // Two records only: a scalar, literal or list containment is the ordinary narrowing it reads as.
  if !(tyAt(chkTy) is TyObj) { return 0 }
  for m in ot.uMembers {
    if (m != chkTy && m >= 0 && tyAt(m) is TyObj && recArmContains(m, chkTy)) {
      const tk = findingStartTok(ix)
      if tk < 0 { return 0 }
      let i = 0
      while i < isvalTok.length {
        if isvalTok[i] == tk { return 0 }
        i = i + 1
      }
      const t = P.toks[tk]
      isvalLine.push(t.line)
      isvalCol.push(t.col)
      isvalEnd.push(findingEndCol(ix, tk))
      isvalTok.push(tk)
      isvalName.push("")
      isvalType.push("")
      isvalLit.push(n.isVariant)
      isvalMsg.push(
        "`"
          + tyToStrUser(chkTy)
          + "` is contained in `"
          + tyToStrUser(m)
          + "`, so `is "
          + tyToStrUser(chkTy)
          + "` tests the value",
      )
      return 0
    }
  }
  0
}

// The join of a `??`'s non-null left type `l` and its default `d` (typed `dt`) when the two are
// runtime numbers that could part, joined apart as `joinArmLit` joins the `if` the operator
// spells; -1 when the ordinary `??` rules decide (a literal or hole default, a gated function).
export function coalJoinApart(l: i32, dt: i32, d: i32): i32 {
  if !njMayPart(l, dt) || tyIsHole(dt) || armLit(dt, d) { return -1 }
  // A hole body keeps master's widening (D2562), as does a template's union left operand; a
  // declared parameter's body joins apart, as its `if` spelling does, and so does every recheck,
  // which is its direct spelling (D3580, D15553).
  if l >= T.tys.length { return -1 }
  const recheckApart = monoRecheckDepth > 0 || !(tyAt(l) is TyUnion)
  if njFnOpen(njFnIx) && !(njFnTyParams(njFnIx) && recheckApart) { return -1 }
  joinArmLit(l, false, dt, false)
}

// The join of the arm types `ts` under the return-set rule, or -1 when none names a type
// parameter (only then can it differ from the collapse).
export function tpApartJoinOf(ts: i32[]): i32 {
  if ts.length < 2 || monoRecheckDepth > 0 || !tysHaveTyVarIn(ts) { return -1 }
  const saved = tpApartConcrete
  tpApartConcreteSet(true)
  const savedClash = joinClashMsg
  let j = ts[0]
  let i = 1
  while i < ts.length {
    if ts[i] >= 0 { j = joinTys(j, ts[i]) }
    i = i + 1
  }
  joinClashMsgSet(savedClash)
  tpApartConcreteSet(saved)
  j
}

// Records the first node the instance would build at a type other than the one the re-check
// gives it, where that type holds a union of lists: a node the template typed concretely is
// built at that type, and a list, record or function literal at its substitution.
export function tpIfCmpNode(ix: i32, t: i32) {
  if tpIfCmpBad != "" || ix < 0 || t < 0 || ix >= nodeTyIx.length { return 0 }
  const tpl = nodeTyIx[ix]
  if tpl < 0 || tpIfJoinAt.has(ix) { return 0 }
  const wt = widenLitTy(t)
  if wt == tpl || !tyReachesUnion(wt, 6) { return 0 }
  let st = tpl
  if tyHasTyVar(tpl) {
    const n = nodeAt(ix)
    if !(n is ArrayLit || n is ObjLit || n is FuncDecl) { return 0 }
    st = substTyDeep(tpl, tpIfCmpNames, tpIfCmpTys)
  }
  if st == wt || tyEq(st, wt) { return 0 }
  tpIfCmpBadSet(
    "the value is "
      + tyToStr(wt)
      + " where the body builds "
      + tyToStr(st)
      + " — narrow it with `is` first",
  )
  0
}

// Collapse a deferred join about to escape the checker — a call's result type, which becomes a node
// type the emitter reads. Re-joining through the ordinary `joinTys` means an unresolvable join,
// whose members name a hole this site does not bind, behaves as an ordinary join rather than
// reaching codegen as a union the emitter has no rep for. Anything else passes through.
export function collapseDeferredJoin(tyIx: i32) {
  if !tyIsDeferredJoin(tyIx) { return tyIx }
  const t = tyAt(tyIx)
  if t is TyUnion {
    const apart = apartHoleJoins.get(tyIx) ?? false
    let res = -1
    let i = 0
    while i < t.uMembers.length {
      if res >= 0 { njApartSet(apart) }
      res = joinTys(res, t.uMembers[i])
      njApartSet(false)
      i = i + 1
    }
    if res >= 0 { return res }
  }
  tyIx
}

// Deferred join `tyIx` as the join a body declaring its parameters keeps apart: the members
// once each, a null as the wrapper, both marked so every pin re-joins it as the lambda does.
export function openParamJoinOf(tyIx: i32): i32 {
  const ms: i32[] = []
  flattenVariantsInto(tyIx, ms)
  const kept: i32[] = []
  let hasNull = false
  for m in ms {
    if isNullTy(m) {
      hasNull = true
    } else {
      let dup = false
      for k in kept {
        if k == m || sameVariantTy(k, m) || sameDeclaredTyParam(k, m) {
          dup = true
        }
      }
      if !dup { kept.push(m) }
    }
  }
  // Every member is a parameter's runtime value, so numbers stay apart at the pin (D3521).
  const u = mkUnionTy(kept)
  tpJoinUnions[u] = 2
  if !hasNull { return u }
  const res = mkNullableTy(u)
  tpJoinUnions[res] = 2
  res
}

// The destination record a record literal delivered where a field's type differs from its own
// (`{ k: [1, 2] }` into `{ k: f64[] }`) is built at, so the emitter takes the destination's row
// and not another row that shares its field names (D2437); -1 when there is none.
export function listFieldWidenDst(srcExpr: i32, dstTy: i32): i32 {
  if inferQuiet || srcExpr < 0 || dstTy < 0 { return -1 }
  if tyDeeperThan(dstTy, 16) { return -1 }
  let dtix = dstTy
  const dN = tyAt(dtix)
  if dN is TyNullable { dtix = dN.nInner }
  if dtix < 0 { return -1 }
  const d = tyAt(dtix)
  const e = nodeAt(parenPeelIx(srcExpr))
  if !(d is TyObj) { return -1 }
  // A union-bearing destination is the union-softening stamp's, in `assignableExpr`.
  if tyReachesUnion(dtix, 8) { return -1 }
  if e is ObjLit {
    if e.objFields.length != d.objFieldNames.length { return -1 }
    let differs = false
    let k = 0
    while k < e.objFields.length {
      const f = nodeAt(e.objFields[k])
      if f is FieldInit {
        let dj = -1
        let j = 0
        while j < d.objFieldNames.length {
          if d.objFieldNames[j] == f.fiName { dj = j }
          j = j + 1
        }
        if dj < 0 { return -1 }
        const own = nodeTyIxOf(f.fiValue)
        if own < 0 { return -1 }
        if !tyEq(own, d.objFieldTypes[dj]) { differs = true }
      } else {
        return -1
      }
      k = k + 1
    }
    if differs { return dtix }
  }
  -1
}

// D581 — the element's source type for the array-literal recursion, and the one place this function
// reads the container instead of the element node. The element node's own recorded type is the
// precise answer at the body's first ask, but at the pin it is stale — it still says `T`, so
// `assignable(T, string)` waves every element past. Gated on the element's record being hole-bearing.
export function litElemSrcTy(elemIx: i32, srcTy: i32) {
  const nt = nodeTyIxOf(elemIx)
  if nt < 0 { return nt }
  if !tyHasHole(nt) { return nt }
  // Under a pin's re-check the element's own type is substituted: a literal joining `T` with a
  // concrete element is a gradual union, wider than its own `T` element (D2906).
  if litPinN.length > 0 {
    const pe = substTyDeep(nt, litPinN, litPinT)
    if pe >= 0 && !tyHasHole(pe) { return pe }
  }
  if srcTy < 0 { return nt }
  const s = tyAt(srcTy)
  if s is TyArray {
    if s.aElem >= 0 {
      if !tyHasHole(s.aElem) { return s.aElem }
    }
  }
  nt
}

// Pin the radix literal at `litIx` to `width`. Answers 2 when this reported (the caller then
// answers the flow true, so the opaque width mismatch is not said twice), else 1 when the literal
// adopted 64 bits, else 0. A pattern past 64 bits reported at the literal itself, so it is silent
// here.
function radixLitAdoptWidth(litIx: i32, width: i32) {
  const t = nodeAt(litIx)
  if t is NumLit {
    const bits = numLexRadixBits(t.numText)
    if bits > 64 { return 2 }
    if width == 64 {
      while litWide64.length <= litIx { litWide64Push(false) }
      litWide64SetAt(litIx, true)
      if litIx < nodeTyIx.length { nodeTySet(litIx, TY_I64) }
      return 1
    }
    if bits > width {
      if !inferQuiet { tErr(radixLitTooWideMsg(t.numText, width), litIx) }
      return 2
    }
  }
  0
}

// Pin the radix literal `srcExpr` delivers into `dstTy` to the destination's width. A value
// `if`, `match` or block delivers its tails, and an object or array literal its fields and
// elements, so each reaches its own destination here too (D2617). A negated literal is a literal
// tree, which `litTreeAdoptDst` pins below (D3049).
export function radixLitAdoptDst(srcExpr: i32, dstTy: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 { return 0 }
  const lix = parenPeelIx(srcExpr)
  if lix < 0 || lix >= P.nodes.length { return 0 }
  const e = nodeAt(lix)
  if e is NumLit {
    if numLexRadixBits(e.numText) < 0 { return 0 }
    const w = dstIntWidth(dstTy, 3)
    if w < 0 { return 0 }
    return radixLitAdoptWidth(lix, w)
  }
  if e is IfStmt || e is MatchExpr || e is Block {
    return radixLitAdoptTails(lix, dstTy)
  }
  if e is ObjLit { return radixLitAdoptFields(e, dstTy) }
  if e is ArrayLit { return radixLitAdoptElems(e, dstTy) }
  if e is BinExpr || e is Unary {
    if litTreeAdoptDst(srcExpr, dstTy) == TY_I64 { return 1 }
    return 0
  }
  radixLitNoParts()
}

// The fields of object literal `e`, each against its own destination field type. A bare literal
// field is left alone: the emitter already reads it at the slot's width, and `assignableExpr`'s
// own field-wise recursion pins it when that one runs.
function radixLitAdoptFields(e: ObjLit, dstTy: i32) {
  const dix = nonNullTy(dstTy)
  if dix < 0 { return 0 }
  const d = tyAt(dix)
  let rc = 0
  if d is TyObj {
    let i = 0
    while i < e.objFields.length {
      const f = nodeAt(e.objFields[i])
      if f is FieldInit {
        const fty = objFieldType(d, f.fiName)
        if fty >= 0 && !(nodeAt(parenPeelIx(f.fiValue)) is NumLit) {
          const fc = radixLitAdoptDst(f.fiValue, fty)
          if fc > rc { rc = fc }
        }
      }
      i = i + 1
    }
  }
  rc
}

// The elements of array literal `e`, each against the element type of `dstTy`, a bare literal
// element left alone as a bare field is.
function radixLitAdoptElems(e: ArrayLit, dstTy: i32) {
  const dix = nonNullTy(dstTy)
  if dix < 0 { return 0 }
  const d = tyAt(dix)
  let rc = 0
  if d is TyArray {
    let i = 0
    while i < e.arrElems.length {
      const el = e.arrElems[i]
      if !(nodeAt(parenPeelIx(el)) is NumLit) {
        const ec = radixLitAdoptDst(el, d.aElem)
        if ec > rc { rc = ec }
      }
      i = i + 1
    }
  }
  rc
}

// The tails of the value `if`, `match` or block at `ix`, pinned to `dstTy`. Only a join every
// `if` and `match` of which is typed `i32` or `i64` takes part. When a tail widens to 64 bits,
// those nodes are re-typed `i64` with it, so the emitter builds the join at that width; at a float
// destination they are re-typed to it, so a radix tail is read as the value a bare one is.
function radixLitAdoptTails(ix: i32, dstTy: i32) {
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(ix, spine, leaves)
  let all32 = true
  let si = 0
  while si < spine.length {
    // A `match` desugared ahead of this delivery leaves its later links untyped; the head's type
    // is the whole chain's.
    const pt = nodeTyOf(spine[si])
    if !(pt < 0 && spine[si] != ix) {
      const pn = primNameOf(pt)
      if pn != "i32" && pn != "i64" { return 0 }
      if pn != "i32" { all32 = false }
    }
    si = si + 1
  }
  let reTy = -1
  let rc = 0
  const fpn = primNameOf(nonNullTy(dstTy))
  if fpn == "f64" || fpn == "f32" {
    let treeLeaf = false
    let ti = 0
    while ti < leaves.length {
      if litTreeAdoptDst(leaves[ti], dstTy) >= 0 { treeLeaf = true }
      ti = ti + 1
    }
    if all32 && (treeLeaf || radixLeafAmong(leaves)) { reTy = nonNullTy(dstTy) }
  } else {
    let i = 0
    while i < leaves.length {
      const lc = radixLitAdoptDst(leaves[i], dstTy)
      if lc > rc { rc = lc }
      i = i + 1
    }
    if rc == 1 { reTy = TY_I64 }
  }
  if reTy >= 0 {
    let s = 0
    while s < spine.length {
      if spine[s] < nodeTyIx.length { nodeTySet(spine[s], reTy) }
      s = s + 1
    }
  }
  rc
}

// The f32 a value `match` at `ix` typed `matchTy` takes when its arms are an f32 value and
// literals, as an `if` does, else -1, with any inner join re-typed f32 handed back `matchTy`.
export function matchF32Join(ix: i32, matchTy: i32): i32 {
  if ix < 0 || matchTy < 0 { return -1 }
  let j = -1
  if primNameOf(matchTy) == "f64" {
    if !valDiscarded(ix) && (!matchInRetTail || f32JoinRetypesRunning()) {
      j = joinF32LitTails(ix)
    }
  }
  if j < 0 { f32JoinRevert(ix) }
  j
}

// A radix literal takes the OTHER operand's width, so `x >= 0x80000000` over an `i64` compares the
// 64-bit pattern rather than the i32 one its digits imply. Upward only: a 32-bit peer leaves a
// wide literal alone, so `x + 0x1_0000_0000` still widens the expression to i64.
export function radixLitAdoptPeer64(exprIx: i32, peerTy: i32) {
  if dstIntWidth(peerTy, 3) != 64 { return 0 }
  radixLitAdoptDst(exprIx, peerTy)
}

// The type on the right of an `is` / `!is` test, and of a `match` type pattern, which
// `parseMatchPattern` mints as a real `IsExpr`. Resolved from the parser's spelling tree, banked on
// the `IsExpr` node itself. Diagnostics anchoring is deliberately not `nameToTyAt`'s: an `is` type
// has never set `annotDiagAt`, and `annotResolve`'s name leg is structurally dead here.
export function isTypeTy(name: string, isIx: i32) {
  annotResolve(name, annTsOf(isIx))
}

// The same type, for the three readers of an `is` node that has already been checked — the two
// narrowing collectors and the if-chain exhaustiveness scan. Where the spelling is a bare name the
// bank is the answer. A composite spelling resolves instead, and for the arena's sake rather than
// the answer's: `T.tys` is not hash-consed, so the reader's index differs by construction.
export function isTypeTyRead(name: string, isIx: i32) {
  const banked = isVarTyIxOf(isIx)
  if banked >= 0 {
    const root = annTsOf(isIx)
    if root >= 0 {
      if tsKind[root] == TS_NAME { return banked }
    }
  }
  isTypeTy(name, isIx)
}

// The declared records an inferred-return union's anonymous members are spelled as: the
// recorded name maps each `{…}` member to the declared type of the same shape
// (`nominalNameOfObj`), and the emitter makes that name's members arms. Without this the
// arena reads the declared record as a plain struct while the name registry reads an arm (D3593).
function inferRegisterNominalTwins(ty: i32) {
  const u = nonNulTyOf(ty)
  if u < 0 { return 0 }
  const t = tyAt(u)
  if t is TyUnion {
    if t.uMembers.length < 2 { return 0 }
    let i = 0
    while i < t.uMembers.length {
      const m = t.uMembers[i]
      if m >= 0 && tyAt(m) is TyObj {
        const nm = nominalNameOfObj(m, gRootStmts)
        if nm != "" {
          const di = cUserTypes[nm] ?? (-1)
          // Committed here, not left pending: the named-function recorder runs after
          // `annCommitVariantMembers`, and a declared record needs no forward resolution.
          if di >= 0 && di != m && cTyIxSetHas(cStructTyIxSet, di) {
            if !cTyIxSetHas(cVariantMemberTyIxSet, di) {
              cTyIxSetAdd(cVariantMemberTyIxs, cVariantMemberTyIxSet, di)
            }
          }
        }
      }
      i = i + 1
    }
  }
  0
}

// Whether record arm `x` holds every value of arm `y` but not the reverse: field by field for
// arms of one field-name set, where a narrower number is not contained in a wider one, else by
// assignability.
function recArmContains(x: i32, y: i32): boolean {
  const tx = tyAt(x)
  const ty = tyAt(y)
  if tx is TyObj && ty is TyObj && objSigSame(tx, ty) && objSigSame(ty, tx) {
    return recArmFitKind(x, y) == 1 && recArmFitKind(y, x) != 1
  }
  assignable(y, x) && !assignable(x, y)
}

// Does some arm of `cur` other than `chk` sit under its own tag and still hold values that fit
// `chk`? Then `is chk` answers from the value, and the then arm keeps `cur`, since a value that
// passed may be laid out as either arm (D4056).
export function recIsFitsAcrossTags(cur: i32, chk: i32): boolean {
  if cur < 0 || chk < 0 { return false }
  if !(tyAt(chk) is TyObj) { return false }
  const ms: i32[] = []
  flattenVariantsInto(cur, ms)
  let records = 0
  for m in ms {
    if m >= 0 && tyAt(m) is TyObj { records = records + 1 }
  }
  // A lone record, nullable or not, sits under no box tag.
  if records < 2 { return false }
  for m in ms {
    if m >= 0 && m != chk && !tySame(m, chk) {
      if recArmsTagApart(chk, m) && recArmFitKind(chk, m) != 0 { return true }
    }
  }
  false
}

// Would `srcExpr : srcTy -> dstTy` succeed if the nominal brands in `dstTy` are ignored?
// True only for a syntactic scalar literal source: it carries no prior identity, so it
// adopts whatever brand the destination wears at any depth. An object/array literal is not
// admitted — it adapts element-wise through `assignableExpr` instead.
export function nomLitAdopts(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if nwTyIxs.length == 0 { return false }
  if srcExpr < 0 { return false }
  if !exprIsBrandAdoptingLiteral(srcExpr) || lbiIsInlined(srcExpr) {
    return false
  }
  nomLitRelaxSet(nomLitRelax + 1)
  const ok = assignable(srcTy, dstTy)
  nomLitRelaxSet(nomLitRelax - 1)
  ok
}

// Is a list element `de` strictly wider than `se`, so a store through the wider handle could
// put in a value `se` forbids? An inference hole or `never` source decides nothing yet.
function listElemWidens(se: i32, de: i32): boolean {
  if se < 0 || de < 0 { return false }
  if se == de { return false }
  if tyReachesHole(se, 8) || tyReachesHole(de, 8) { return false }
  if primNameOf(se) == "never" { return false }
  !assignable(de, se)
}

// —— written-through covariance: the per-value half of D791's write scan (D821) ——
// D791 lowered a read-only covariant list assignment as an element-converting copy, licensed
// by a rep-scoped predicate that declines on an unrelated list sharing an element rep — a
// false reject clause 2 forbids. A per-value `Writable` answer instead (D793): 0 = safe to copy, 1 = refuse, 2 = unknown, fall back to the rep-scoped scan.

// Reported at the assignment rather than the write, since the assignment is what the
// author can change. Not a capability concession: the copy exists (D791), this program is
// the one shape it is not allowed to run in.
export function covarWriteThroughErr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  covarWriteThroughErrAt(srcExpr, srcTy, dstTy, srcExpr)
}

// The same refusal reported at `at`, for a delivery checked away from its own node (a generic
// body's receiver, re-asked at the call that pins it).
export function covarWriteThroughErrAt(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
  at: i32,
) {
  let where = "somewhere in this program"
  const wAt = covarValueWriteAt(cwKeyOfRoot(srcExpr))
  if wAt >= 0 { where = "(line " + i32ToStr(nodeLineOf(wAt)) + ")" }
  tErr(
    "a "
      + tyToStr(srcTy)
      + " cannot be assigned to "
      + tyToStr(dstTy)
      + " here: the list is WRITTEN THROUGH "
      + where
      + ", and a covariant list "
      + "assignment is read-only. The two element storages differ, so the destination would "
      + "have to hold a converted copy, and a store through either handle would not be seen "
      + "through the other. Declare the source as "
      + tyToStr(listMutableTwin(dstTy))
      + " so both handles share one element storage, or copy it with "
      + listCopyMapText(srcTy, dstTy),
    at,
  )
}

// The second sentence (D853), reported at the assignment like its sibling but deliberately
// not sharing its wording: nothing is copied here — both declared views rep as the
// program's one box and every handle aliases one list — so what is wrong is that two
// declared views of one written-through list disagree about which arms the elements may be.
export function covarTwoUnionsErr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  tErr(
    "a "
      + tyToStr(srcTy)
      + " cannot be assigned to "
      + tyToStr(dstTy)
      + " here: this list is ALSO declared with a DIFFERENT element union elsewhere in this "
      + "program, and it is written through. VL lists alias, so the two declarations describe "
      + "one storage: a store admitted by one of them can put an element the other has no arm "
      + "for, and a read through that other one has no correct value. Give every handle on this "
      + "list the same element type, or drop the write",
    srcExpr,
  )
}

// —— a record delivered covariantly is read-only in its widened fields (D2060) ——
// `{x: i32}` passed as `{x: i32 | string}` is shared, not copied, so a `string` stored through
// the wider handle lands in a field the source types `i32`. The reads-only rule for covariant
// lists (DECISIONS.md A9) applies field by field: legal where nothing writes a widened slot.

// A covariant slot path is a run of segments, `.f` for a field and `[]` for any element or map
// value, relative to the delivered value. A trailing `*` marks a slot nothing below is followed
// into, so everything reachable under it counts as widened. Answers whether `s` and `d` differ.
export function rcwCovs(
  s: i32,
  d: i32,
  path: string,
  out: string[],
  depth: i32,
): boolean {
  if s < 0 || d < 0 || s >= T.tys.length || d >= T.tys.length { return false }
  if s == d || tyEq(s, d) { return false }
  if depth > 12 {
    out.push(path + "*")
    return true
  }
  const st = tyAt(s)
  const dt = tyAt(d)
  // A hole or type variable on the destination side adopts the source; a named type parameter
  // on the source side may be any type, so the slot counts as widened and its type as unknown.
  if dt is TyVar || st is TyErr || dt is TyErr { return false }
  if st is TyVar {
    if st.tvName.length == 0 || st.tvName[0] == '?' { return false }
    // At the root, only a BOUNDED parameter delivered into a record shares its argument's
    // record; an unbounded one is pinned to the destination's own type.
    if path == "" {
      if !(dt is TyObj) || tpBoundOfName(st.tvName) < 0 { return false }
      out.push("*")
    } else {
      out.push(rcwTyped(path, s))
    }
    return true
  }
  // A nullable source into a nullable type variable binds the variable to its inner type, so
  // the slot adopts the source as a bare variable does (D2526).
  if dt is TyNullable && st is TyNullable {
    const dIn = dt.nInner
    if dIn >= 0 && dIn < T.tys.length && tyAt(dIn) is TyVar {
      return rcwCovs(st.nInner, dIn, path, out, depth + 1)
    }
  }
  // A union (or nullable) source into a record is one of its members; each member the record
  // accepts contributes its own widened slots, and `null` none.
  if dt is TyObj && (st is TyUnion || st is TyNullable) {
    const ms = rcwMembersOf(s)
    let any = false
    let mi = 0
    while mi < ms.length {
      const m = ms[mi]
      if m >= 0 && !isNullTy(m) && assignable(m, d) {
        if rcwCovs(m, d, path, out, depth + 1) { any = true }
      }
      mi = mi + 1
    }
    return any
  }
  let differs = false
  let walked = false
  if st is TyObj {
    if dt is TyObj {
      walked = true
      let i = 0
      while i < dt.objFieldNames.length {
        const sf = objFieldType(st, dt.objFieldNames[i])
        if sf >= 0 {
          const fp = path + "." + dt.objFieldNames[i]
          if rcwCovs(sf, dt.objFieldTypes[i], fp, out, depth + 1) {
            differs = true
          }
        }
        i = i + 1
      }
    }
  }
  if st is TyArray {
    if dt is TyArray {
      // A delivered container whose element changes storage is copied or refused by the
      // container rule (DECISIONS.md "No implicit container widening"), so no handle is
      // shared; one that keeps its storage is shared, and this rule decides its writes.
      if path == "" && rcwContainerRuleDomain(st.aElem, dt.aElem) {
        return false
      }
      walked = true
      differs = rcwCovs(st.aElem, dt.aElem, path + "[]", out, depth + 1)
    }
  }
  if st is TyMap {
    if dt is TyMap {
      if path == "" && rcwContainerRuleDomain(st.mVal, dt.mVal) { return false }
      walked = true
      differs = rcwCovs(st.mVal, dt.mVal, path + "[]", out, depth + 1)
    }
  }
  if walked {
    if differs && path != "" { out.push(rcwTyped(path, s)) }
    return differs
  }
  if dt is TyUnion || dt is TyNullable { rcwIntoUnion(s, d, path, out, depth) }
  else if rcwIsRefTy(s) { out.push(path + "*") }
  if path != "" { out.push(rcwTyped(path, s)) }
  true
}

// A value landing in a wider union keeps its own type, and a handle reaches its slots only by
// narrowing to a member the value is assignable to, so each such member's widened slots are
// the value's. A union value lands member by member.
function rcwIntoUnion(s: i32, d: i32, path: string, out: string[], depth: i32) {
  if s < 0 || d < 0 || s >= T.tys.length || d >= T.tys.length || depth > 12 {
    return 0
  }
  const parts = rcwMembersOf(s)
  if parts.length != 1 || parts[0] != s {
    let pi = 0
    while pi < parts.length {
      rcwIntoUnion(parts[pi], d, path, out, depth + 1)
      pi = pi + 1
    }
    return 0
  }
  if isNullTy(s) { return 0 }
  const ms = rcwMembersOf(d)
  let i = 0
  while i < ms.length {
    // An exact member keeps the value's type; an unfilled hole (-1) adopts it.
    if ms[i] < 0 || tyEq(s, ms[i]) { return 0 }
    i = i + 1
  }
  let any = false
  i = 0
  while i < ms.length {
    if !isNullTy(ms[i]) && assignable(s, ms[i]) {
      any = true
      const sub: string[] = []
      rcwCovs(s, ms[i], path, sub, depth + 1)
      let k = 0
      while k < sub.length {
        if rcwPathOf(sub[k]) != path { out.push(sub[k]) }
        k = k + 1
      }
    }
    i = i + 1
  }
  if !any && rcwIsRefTy(s) { out.push(path + "*") }
  0
}

// The widened slots a delivery of `srcExpr` (typed `srcTy`) into `dstTy` shares with an
// existing value: the slots a fresh literal owns are dropped.
function rcwSharedCovs(srcExpr: i32, srcTy: i32, dstTy: i32): string[] {
  const all: string[] = []
  rcwCovs(srcTy, dstTy, "", all, 0)
  const out: string[] = []
  let i = 0
  while i < all.length {
    if !rcwSlotFresh(srcExpr, rcwPathOf(all[i]), 0, 0) { out.push(all[i]) }
    i = i + 1
  }
  out
}

// Whether a list or map `srcExpr`, typed `srcTy` at a hole, is re-asked at each pin: it names a
// type parameter, its destination names none, and it is not a method's result, which is fresh.
function rcwPinsContainer(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  if !tyHasTyVar(srcTy) || tyHasTyVar(dstTy) { return false }
  const p = parenPeelIx(srcExpr)
  if p < 0 || p >= P.nodes.length { return false }
  const n = nodeAt(p)
  if n is Call {
    if n.callFn >= 0 && nodeAt(n.callFn) is Member { return false }
  }
  true
}

// Record a delivery of `srcExpr` (typed `srcTy`) into `dstTy` when it widens a shared slot.
export function rcwPend(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcExpr < 0 || srcTy < 0 || dstTy < 0 || srcTy == dstTy { return 0 }
  // A scalar source shares nothing; a type variable may stand for a record.
  if srcTy >= T.tys.length { return 0 }
  if !rcwIsRefTy(srcTy) && !(tyAt(srcTy) is TyVar) { return 0 }
  // A source typed at a hole shares whatever its pin is: each pin re-asks it (D3250), and a
  // record literal holding one is re-asked whole (D14759), as is a list or map handed to a
  // concrete destination, unless a method built it fresh (D4983, D5002).
  const st = tyAt(srcTy)
  if (
    (st is TyVar
      || (st is TyObj && tyHasTyVar(srcTy))
      || ((st is TyArray || st is TyMap) && rcwPinsContainer(srcExpr, srcTy, dstTy)))
    && rcwIsRefTy(dstTy)
    && cstrOwnerTop() >= 0
  ) {
    rcwPinNote(srcExpr, srcTy, dstTy)
  }
  const seen = rcwPendSeen[srcExpr] ?? []
  let s = 0
  while s + 1 < seen.length {
    if seen[s] == srcTy && seen[s + 1] == dstTy { return 0 }
    s = s + 2
  }
  seen.push(srcTy)
  seen.push(dstTy)
  rcwPendSeen[srcExpr] = seen
  // The slots are computed here, inside the scope that knows a type parameter's bound.
  const covs = rcwSharedCovs(srcExpr, srcTy, dstTy)
  if covs.length == 0 { return 0 }
  rcwPendCovs.push(covs)
  rcwPendSrc.push(srcExpr)
  rcwPendSrcTy.push(srcTy)
  rcwPendDstTy.push(dstTy)
  0
}

// The entry for a whole delivery of `srcExpr`: the storage and object-shape floor first, then
// the readonly-only list rule.
export function objShapeAdapterlessAt(
  srcExpr: i32,
  src: i32,
  dst: i32,
): boolean {
  shapeAdaptNulCopySet(false)
  shapeAdaptNestedCopySet(false)
  shapeAdaptMapSharedSet(false)
  shapeAdaptRecFieldSet(false)
  if objShapeAdapterless(srcExpr, src, dst, 12, true) { return true }
  listWidenWalk(srcExpr, src, dst, 12, false)
}

// A literal built inside a function, or handed through a generic call, is built at the row of a
// declared record of its own field storage when one exists, not where the call delivers it; into
// a record that stores a field differently it is refused as an existing record is (D3338). A
// record spelled inline in an annotation is declared too (D3430). True when it refused.
function recBuiltAtDeclared(at: i32, srcTy: i32, dstTy: i32): boolean {
  const own = nonNulTyOf(srcTy)
  const dst = recLandingOf(srcTy, dstTy)
  if own < 0 || dst < 0 || !(tyAt(own) is TyObj) || !(tyAt(dst) is TyObj) {
    return false
  }
  if recAtPinnedArg(at) && !recAtStoreArg(at) { return false }
  let found = false
  for k in cUserTypes.keys() {
    if !found && nameIsBareIdent(demangleName(k)) {
      found = recDeclaredRowOf(cUserTypes[k] ?? -1, own, dst)
    }
  }
  for ut in recAnnObjs {
    if !found { found = recDeclaredRowOf(recAdRecOf(ut), own, dst) }
  }
  if !found { return false }
  recRefuseAtOwnRow(at, own, dst)
}

// Refuse delivering `at`, a record or list of `own` built at its own row, onto `dst`'s storage;
// a list is refused as a container that never widens. True.
function recRefuseAtOwnRow(at: i32, own: i32, dst: i32): boolean {
  const isList = tyAt(own) is TyArray
  shapeAdaptSrcTySet(own)
  shapeAdaptDstTySet(dst)
  shapeAdaptSrcExprSet(at)
  shapeAdaptElemPairSet(isList)
  shapeAdaptWidthFieldSet(false)
  shapeAdaptNulCopySet(false)
  shapeAdaptNestedCopySet(false)
  shapeAdaptMapSharedSet(false)
  shapeAdaptRecFieldSet(false)
  shapeAdaptRecStorageSet(!isList)
  if !isList { shapeAdaptRecStorageFieldSet(recStorageFieldOf(own, dst)) }
  objShapeAdapterlessErr(at, own, dst)
  shapeAdaptElemPairSet(false)
  shapeAdaptRecStorageSet(false)
  true
}

// Is `at` the value handed to a list's `push` or a map's `set`, whose type the receiver fixes
// rather than the argument (D8144)?
function recAtStoreArg(at: i32): boolean {
  cwIxBuild()
  if at < 0 || !cwIxCovers(at) || cwIxUpKind[at] != CW_UP_ARG { return false }
  const cn = nodeAt(cwIxUp[at])
  if !(cn is Call) || cn.callFn < 0 { return false }
  const f = nodeAt(cn.callFn)
  if !(f is Member) || (f.memProp != "push" && f.memProp != "set") {
    return false
  }
  const rt = nonNulTyOf(nodeTyIxOf(f.memObj))
  rt >= 0 && rt < T.tys.length && (tyAt(rt) is TyArray || tyAt(rt) is TyMap)
}

// The record of `dstTy` a record of `srcTy` lands on, past null and through a union
// (`recAdLanding`); -1 when either is -1.
function recLandingOf(srcTy: i32, dstTy: i32): i32 {
  const own = nonNulTyOf(srcTy)
  const dst = nonNulTyOf(dstTy)
  if own < 0 || dst < 0 || own >= T.tys.length || dst >= T.tys.length {
    return -1
  }
  recAdLanding(own, dst)
}

// A record a function built, or an element of a list binding, delivered where a field it holds as
// an integer is a float (D3339), or a number stored at another width that no converting copy
// serves (D15247): the value is built at its own row and refused. True when it refused.
function recFloatBuiltElsewhere(at: i32, srcTy: i32, dstTy: i32): boolean {
  const own = nonNulTyOf(srcTy)
  const dst = nonNulTyOf(dstTy)
  if !recIntToFloat(own, dst, REC_STORE_DEPTH) {
    if !recNumChanges(own, dst, REC_STORE_DEPTH) || recCopyConverts(own, dst) {
      return false
    }
    recWidthCopyGapErr(at, own, dst)
    return true
  }
  shapeAdaptSrcTySet(own)
  shapeAdaptDstTySet(dst)
  shapeAdaptSrcExprSet(at)
  shapeAdaptElemPairSet(false)
  shapeAdaptWidthFieldSet(false)
  shapeAdaptRecStorageSet(true)
  const ff = recFloatFieldAt(own, dst, true)
  shapeAdaptRecStorageFieldSet(
    if ff != "" { ff } else { recStorageFieldOf(own, dst) },
  )
  objShapeAdapterlessErr(at, own, dst)
  shapeAdaptRecStorageSet(false)
  true
}

// The refusal of a record `own` delivered to `dst`, which stores a number at another width in a
// nested or nullable field the converting copy does not reach (D15247).
function recWidthCopyGapErr(at: i32, own: i32, dst: i32) {
  const fnm = recStorageFieldOf(own, dst)
  let note = ""
  const o = tyAt(own)
  const d = tyAt(dst)
  if o is TyObj {
    if d is TyObj {
      const of = objFieldType(o, fnm)
      const df = objFieldType(d, fnm)
      if of >= 0 && df >= 0 {
        note = " (`" + tyToStr(of) + "` into `" + tyToStr(df) + "`)"
      }
    }
  }
  tErr(
    tyToStr(own)
      + " is not "
      + tyToStr(dst)
      + ": they store field `"
      + fnm
      + "` differently"
      + note
      + ", and the record is also kept at its own type; converting it into "
      + tyToStr(dst)
      + " is not yet supported: the converting copy does not reach a nested or nullable field",
    at,
  )
  0
}

// A function with no declared result called only at `call`, whose every returned value is an
// object literal: each is built at the record the call delivers it to, `dstTy`'s member it
// lands on (D3444). True when it recorded that build.
function recFnBuiltAtDst(fd: i32, call: i32, srcTy: i32, dstTy: i32): boolean {
  const own = nonNulTyOf(srcTy)
  if own < 0 || !(tyAt(own) is TyObj) { return false }
  const dst = recAdLanding(own, nonNulTyOf(dstTy))
  if dst < 0 || !(tyAt(dst) is TyObj) || !objFieldNameSetsEq(own, dst) {
    return false
  }
  cwIxBuild()
  recDelivPush(fd, call, REC_DELIV_READ)
  const sites: i32[] = []
  if rcwCallSites(fd, sites) >= 0 || !recSitesLandAt(sites, call, own, dst) {
    return false
  }
  const copies: i32[] = []
  const copyTys: i32[] = []
  const copyBack: i32[] = []
  for cs in recSiteCopies { copies.push(cs) }
  for ct in recSiteCopyTys { copyTys.push(ct) }
  for cb in recSiteCopyBack { copyBack.push(cb) }
  const via: i32[] = []
  const leaves = recFnValueOrigins(fd, via)
  if leaves.length == 0 { return false }
  const lits: i32[] = []
  const litVia: i32[] = []
  const calls: i32[] = []
  let i = 0
  while i < leaves.length {
    const lp = leaves[i]
    if lp < 0 { return false }
    const ll = recLeafLitOf(lp, dst)
    if ll >= 0 {
      lits.push(ll)
      litVia.push(via[i])
    } else if (
      lp != call
      && recInferredFnOf(lp) >= 0
      && recInferredFnOf(lp) != fd
    ) {
      // Else the hand-on refuses the two builds, as D14516 pins.
      if recLeafLeavesToCopy(lp, dst) { return false }
      calls.push(lp)
    } else if lp != call && recSolePinArg(lp) >= 0 {
      let x = lp
      let hops = 0
      while x >= 0 && x < P.nodes.length && hops < 16 && recSolePinArg(x) >= 0 {
        x = cwPeelValue(recSolePinArg(x))
        hops = hops + 1
      }
      const ia = recInferredFnOf(x)
      if ia < 0 || ia == fd { return false }
      calls.push(lp)
    } else {
      return false
    }
    i = i + 1
  }
  // A literal read through a binding is built at `dst`, and the binding keeps its type.
  i = 0
  while i < lits.length {
    if litVia[i] >= 0 {
      recBuildPush(recHeldDecl(litVia[i]), nodeTyIxOf(lits[i]), dst, false)
    }
    recordRepTyAdopt(lits[i], dst, 6)
    recLitFieldsDeliver(lits[i], dst, REC_STORE_DEPTH)
    i = i + 1
  }
  // A leaf calling another such function hands the destination on to it (D8143).
  for cl in calls { recAdoptNote(cl, nodeTyIxOf(cl), dst) }
  // A held-pinned call is built at `dst` and copied to its own record where it is delivered.
  let ci = 0
  while ci < copies.length {
    const cp = copies[ci]
    while recCopyTyIx.length <= cp { recCopyTyIx.push(-1) }
    recCopyTyIx[cp] = copyTys[ci]
    // A call copied back to its own record is delivered as the copy, so its rep is stamped there;
    // the build stays readable at `recCopyFromOf` for the copy itself (D15266).
    if i32ListHas(copyBack, cp) {
      recCopyFrom[cp] = dst
      repStamp(cp, copyTys[ci])
    }
    const un = recCopyUnwrapNames(dst, own)
    if un.length > 0 { recCopyUnwrap[cp] = un }
    ci = ci + 1
  }
  true
}

// Whether value leaf `lp`, a call of another function that cannot itself be built at `dst`, leaves
// the delivery to its converting copy, where one serves (D15216).
function recLeafLeavesToCopy(lp: i32, dst: i32): boolean {
  const lfn = recInferredFnOf(lp)
  lfn >= 0
    && recCopyConverts(nodeTyIxOf(lp), dst)
    && !recFnBuildsAt(lfn, lp, nodeTyIxOf(lp), dst, REC_STORE_DEPTH)
}

// Whether some value leaf of `fd` is a call of another function that leaves the delivery at `dst`
// to its converting copy (`recLeafLeavesToCopy`): `fd` relays a result it does not build (D15244).
function recRelayLeavesToCopy(fd: i32, dst: i32): boolean {
  const via: i32[] = []
  for lf in recFnValueOrigins(fd, via) {
    if lf >= 0 && recInferredFnOf(lf) != fd && recLeafLeavesToCopy(lf, dst) {
      return true
    }
  }
  false
}

// Whether inferred function `fd`, called at `call` with result `own`, can be built at `dst`: its call
// sites land there (`recSitesLandAt`), and each value leaf calling another such function can be
// too, to `depth` calls (`REC_STORE_DEPTH` from the solve, D15216).
function recFnBuildsAt(
  fd: i32,
  call: i32,
  own: i32,
  dst: i32,
  depth: i32,
): boolean {
  if depth <= 0 || fd < 0 { return false }
  cwIxBuild()
  const sites: i32[] = []
  if rcwCallSites(fd, sites) >= 0 || !recSitesLandAt(sites, call, own, dst) {
    return false
  }
  const via: i32[] = []
  for lf in recFnValueOrigins(fd, via) {
    if lf < 0 { return false }
    const lfn = recInferredFnOf(lf)
    if (
      lfn >= 0
      && lfn != fd
      && !recFnBuildsAt(lfn, lf, nodeTyIxOf(lf), dst, depth - 1)
    ) {
      return false
    }
  }
  true
}

// Delivers each field value of record literal `lit`, built at record `dst`, at `dst`'s field, as
// the literal written at `dst` delivers it: a call or binding holding a record there is built at
// or copied to that field (D15215). Nested literals are walked to `depth`.
function recLitFieldsDeliver(lit: i32, dst: i32, depth: i32) {
  if (
    depth <= 0
    || lit < 0
    || lit >= P.nodes.length
    || dst < 0
    || dst >= T.tys.length
  ) {
    return 0
  }
  const e = nodeAt(parenPeelIx(lit))
  const d = tyAt(nonNulTyOf(dst))
  if !(e is ObjLit) || !(d is TyObj) { return 0 }
  for fx in e.objFields {
    const f = nodeAt(fx)
    if f is FieldInit {
      const df = objFieldType(d, f.fiName)
      const v = parenPeelIx(f.fiValue)
      if df >= 0 && v >= 0 && v < P.nodes.length {
        if nodeAt(v) is ObjLit {
          recLitFieldsDeliver(v, df, depth - 1)
        } else {
          recAdoptNote(v, nodeTyIxOf(v), df)
        }
      }
    }
  }
  0
}

// What an inferred function `fd` of result `own` returns when its call sites all land where
// `call` delivers it as `dst` (`recSitesLandAt`), each a fresh literal (`freshLitValue`) or the
// binding read that last reached it (`recFnValueOrigins`); empty when some value is neither.
function recReturnedOrigins(fd: i32, call: i32, own: i32, dst: i32): i32[] {
  cwIxBuild()
  const sites: i32[] = []
  if rcwCallSites(fd, sites) >= 0 || !recSitesLandAt(sites, call, own, dst) {
    return []
  }
  recFnReturns(fd)
}

// `recReturnedOrigins` for every call of `fd` alike: what each of them is handed back.
function recFnReturns(fd: i32): i32[] {
  const out: i32[] = []
  const via: i32[] = []
  const origins = recFnValueOrigins(fd, via)
  let i = 0
  while i < origins.length {
    const o = origins[i]
    if o < 0 { return [] }
    if via[i] >= 0 { out.push(via[i]) }
    else if nodeAt(o) is Ident || freshLitValue(o) { out.push(o) }
    else { return [] }
    i = i + 1
  }
  out
}

// Whether call sites `sites` are `call` and calls each landing `own` on `dst`'s field storage,
// queued for none, or stored into a container (`recHeldStored`, `recStoresAgree`), so one build
// serves them all (D8201). For one queued for none, `dst` widens a field no further than
// `recNullWidened` reads back exactly, and its slots take the build (D8302).
function recSitesLandAt(sites: i32[], call: i32, own: i32, dst: i32): boolean {
  recSiteCopies = []
  recSiteCopyTys = []
  recSiteCopyBack = []
  if sites.length == 1 { return sites[0] == call * 2 }
  let hasCall = false
  for s in sites {
    if s % 2 != 0 { return false }
    const c = s / 2
    if c == call { hasCall = true }
    const mapped = recHeldStored(c)
    // A held-pinned call is built at `dst` and copied to its own record where that loses nothing.
    if recHeldPinnedArg(c) || recPinnedAtOwn(c, own) {
      if (mapped || !recPinnedAtOwn(c, own) || !recCopyNarrows(dst, own)) {
        return false
      }
      recSiteCopies.push(c)
      recSiteCopyTys.push(recCopyDstOf(c, own))
      continue
    }
    const at = if mapped { -1 } else { recQueuedLandingOf(c, own, dst) }
    if at >= 0 {
      if !fieldStorageEq(at, dst, REC_STORE_DEPTH) { return false }
      // A value landing at the build that a record is then written through takes its own copy.
      if (
        c != call
        && recValueWrittenThrough(c, own, REC_STORE_DEPTH)
        && recCopyNarrows(dst, own)
      ) {
        recSiteCopies.push(c)
        recSiteCopyTys.push(own)
        recSiteCopyBack.push(c)
      }
    } else if (
      c == call
      || !recNullWidened(own, dst, mapped)
      || (!mapped && recQueuedReaches(c, own, dst))
    ) {
      return false
    } else if (
      (!mapped || recStoreDeclOf(c) >= 0)
      && recValueWrittenThrough(c, own, REC_STORE_DEPTH)
      && recCopyNarrows(dst, own)
    ) {
      // A binding a record is written through takes its own copy of the build rather than sharing
      // it; one no copy serves shares it as before (D15246).
      recSiteCopies.push(c)
      recSiteCopyTys.push(own)
      recSiteCopyBack.push(c)
    }
  }
  if hasCall { recRepArgsNote(sites, own, dst) }
  hasCall
}

// The held-pinned calls the last `recSitesLandAt` answer copies to their own record, and beside
// each the record it is copied into.
let recSiteCopies: i32[] = []
let recSiteCopyTys: i32[] = []
// The copies among `recSiteCopies` that a binding written through takes back to its own record.
let recSiteCopyBack: i32[] = []

// Whether the value call site `c` produces reaches a binding a record is written through: the
// binding it initialises, the parameter it is handed to, or, through a return, whatever each call
// of the enclosing function reaches, to `depth` such hops (`recBindWrittenThrough`, D15266).
function recValueWrittenThrough(c: i32, own: i32, depth: i32): boolean {
  cwIxBuild()
  if depth <= 0 || c < 0 || !cwIxCovers(c) || !cwIxCovers(c) { return false }
  const d = cwIxParent[c]
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { nodeAt(0) }
  if dn is LetDecl && parenPeelIx(dn.letInit) == c {
    return recOwnTypedAt(d, own) && recBindWrittenThrough(d, 4)
  }
  const uk = cwIxUpKind[c]
  // A value stored into a container slot is asked of the slot's reads.
  if uk == CW_UP_ARG && recAtStoreArg(c) { return recSlotWrittenThrough(c) }
  if uk == CW_UP_ARG { return recArgWrittenThrough(c, own) }
  if uk == CW_UP_ELEM || uk == CW_UP_FIELD || uk == CW_UP_ASG_RHS {
    return recSlotWrittenThrough(c)
  }
  if uk == CW_UP_RET || uk == CW_UP_TAIL {
    const fd = recEnclosingFn(c)
    const sites: i32[] = []
    if fd < 0 || rcwCallSites(fd, sites) >= 0 { return false }
    for s in sites {
      if s % 2 == 0 && recValueWrittenThrough(s / 2, own, depth - 1) {
        return true
      }
    }
  }
  false
}

// Whether the container slot value `c` is stored at is read, through the binding the literal holding
// it initialises, into a place a record is written through: the write scan's slot model
// (`cwSlotPath`, `cwSlotWrittenValues`) decides which reads see `c`.
function recSlotWrittenThrough(c: i32): boolean {
  const md = recStoreDeclOf(c)
  if md < 0 { return false }
  const w = cwOccWalk(md)
  while cwOccNext(w) {
    const r = w.row
    let m = if cwIxKind[r] == CW_OCC_USE { cwIxNode[r] } else { -1 }
    let steps = 0
    while (
      m >= 0
      && cwIxCovers(m)
      && cwIxUpKind[m] == CW_UP_OBJ
      && steps < 16
    ) {
      m = cwIxUp[m]
      const mg = if m >= 0 && cwIxCovers(m) && cwIxUpKind[m] == CW_UP_CALLEE { cwIxUp[m] } else { -1 }
      if mg >= 0 && cwGetRecv(mg) >= 0 { m = mg }
      if recSlotReadHolds(m, c) && recUseWritesThrough(m, 4) { return true }
      steps = steps + 1
    }
  }
  false
}

// Whether the place `m` reads is a slot `c` is stored at.
function recSlotReadHolds(m: i32, c: i32): boolean {
  const path: string[] = []
  const root = cwSlotPath(m, path)
  if root < 0 || path.length == 0 { return false }
  const vals: i32[] = []
  const ats: i32[] = []
  if cwSlotWrittenValues(cwBindingOf(root), path, vals, ats) < 0 {
    return false
  }
  i32ListHas(vals, c)
}

// Whether binding or parameter `d` is typed at the record `own` stores as, or at an open hole a
// call pins: a copy back to `own` is what it holds then.
function recOwnTypedAt(d: i32, own: i32): boolean {
  const t = nodeTyIxOf(d)
  if t < 0 || t >= T.tys.length { return false }
  tyReachesHole(t, 8)
    || tyHasTyVar(t)
    || fieldStorageEq(t, own, REC_STORE_DEPTH)
}

// Whether argument `a` is handed to a parameter a record is written through (`recBindWrittenThrough`).
function recArgWrittenThrough(a: i32, own: i32): boolean {
  const up = cwIxUp[a]
  const un = if up >= 0 && up < P.nodes.length { nodeAt(up) } else { nodeAt(0) }
  if !(un is Call) { return false }
  const fd = recInferredFnOf(up)
  const fn = if fd >= 0 { nodeAt(fd) } else { nodeAt(0) }
  if !(fn is FuncDecl) { return false }
  let i = 0
  while i < un.callArgs.length && i < fn.fnParams.length {
    if parenPeelIx(un.callArgs[i]) == a {
      const pd = fn.fnParams[i]
      return recOwnTypedAt(pd, own) && recBindWrittenThrough(pd, 4)
    }
    i = i + 1
  }
  false
}

// Whether binding or parameter `d` may be written through: a field path of it is assigned, or it
// is bound by `const` or handed as an argument to a binding or parameter that is, to `depth` hops.
function recBindWrittenThrough(d: i32, depth: i32): boolean {
  if d < 0 || depth <= 0 { return false }
  const fr = cwKeyFrame(d)
  const w = cwOccWalk(d)
  while cwOccNext(w) {
    const r = w.row
    const an = if cwIxKind[r] == CW_OCC_ASG && cwIxFr[r] == fr { nodeAt(cwIxNode[r]) } else { null }
    if (
      an is BinExpr
      && an.binOp == "="
      && !(nodeAt(parenPeelIx(an.binLeft)) is Ident)
      && tyHoldsObjDeep(nodeTyIxOf(an.binRight))
    ) {
      return true
    }
    const u = if cwIxKind[r] == CW_OCC_USE && cwIxFr[r] == fr { cwIxNode[r] } else { -1 }
    if u >= 0 && cwIxCovers(u) && recUseWritesThrough(u, depth) { return true }
  }
  false
}

// Whether assignment `a` stores a value holding a record: a scalar field write is served by the
// shared build's own field storage.
function recAsgStoresRecord(a: i32): boolean {
  const an = if a >= 0 && a < P.nodes.length { nodeAt(a) } else { nodeAt(0) }
  an is BinExpr && tyHoldsObjDeep(nodeTyIxOf(an.binRight))
}

// Whether the read `u` of a binding writes through it: the field path it roots is assigned, or the
// whole value is bound by `const` or handed as an argument to a binding written through.
function recUseWritesThrough(u: i32, depth: i32): boolean {
  let top = u
  while top >= 0 && cwIxCovers(top) && cwIxUpKind[top] == CW_UP_OBJ {
    top = cwIxUp[top]
  }
  if top < 0 || !cwIxCovers(top) { return false }
  const uk = cwIxUpKind[top]
  if uk == CW_UP_ASG_LHS { return top != u && recAsgStoresRecord(cwIxUp[top]) }
  if top != u { return false }
  const up = cwIxUp[top]
  if up < 0 || up >= P.nodes.length { return false }
  const un = nodeAt(up)
  if uk == CW_UP_LETINIT && un is LetDecl {
    return recBindWrittenThrough(up, depth - 1)
  }
  if uk == CW_UP_ARG && un is Call {
    const fd = recInferredFnOf(up)
    const fn = if fd >= 0 { nodeAt(fd) } else { nodeAt(0) }
    if !(fn is FuncDecl) { return false }
    let i = 0
    while i < un.callArgs.length && i < fn.fnParams.length {
      if parenPeelIx(un.callArgs[i]) == top {
        return recBindWrittenThrough(fn.fnParams[i], depth - 1)
      }
      i = i + 1
    }
  }
  false
}

// The record call `c` of own type `own` is copied into: the type its pin names, which a written
// type argument spells as a declared record, else `own` (D14818).
function recCopyDstOf(c: i32, own: i32): i32 {
  const dt = recDeclaredPinTy(c)
  if dt >= 0 && fieldStorageEq(dt, own, REC_STORE_DEPTH) { return dt }
  const pt = recReachPinTy(c)
  if pt >= 0 && fieldStorageEq(pt, own, REC_STORE_DEPTH) { pt } else { own }
}

// Whether call `c` reaches a type parameter that a written type argument, or another argument
// holding a value no call of its function produced, pins at a type storing as `own` (D14818).
function recPinnedAtOwn(c: i32, own: i32): boolean {
  const pt = recReachPinTy(c)
  pt >= 0 && fieldStorageEq(pt, own, REC_STORE_DEPTH)
}

// The type name parameter `px` is annotated with, or "" for none or a composite annotation.
function recParamTyName(px: i32): string {
  const pn = nodeAt(px)
  const pt = if pn is Param && pn.parType >= 0 { nodeAt(pn.parType) } else { null }
  if pt is TypeRef { pt.tyName } else { "" }
}

// Whether record `wide` can be copied into record `own` field for field: each field stored alike,
// or a `null` field of `own` where `wide` stores the field as nullable.
function recCopyNarrows(wide: i32, own: i32): boolean {
  recCopyNarrowsAt(wide, own, REC_STORE_DEPTH)
}

// `recCopyNarrows` with at most `depth` levels of record fields left: a field holding a record at
// another row is copied into its own row by the level below.
function recCopyNarrowsAt(wide: i32, own: i32, depth: i32): boolean {
  if (
    depth <= 0
    || wide < 0
    || own < 0
    || wide >= T.tys.length
    || own >= T.tys.length
  ) {
    return false
  }
  const w = tyAt(wide)
  const o = tyAt(own)
  if !(w is TyObj) || !(o is TyObj) || !objFieldNameSetsEq(wide, own) {
    return false
  }
  let i = 0
  while i < o.objFieldNames.length {
    const of = o.objFieldTypes[i]
    const wf = objFieldType(w, o.objFieldNames[i])
    if wf < 0 { return false }
    if (
      !fieldStorageEq(wf, of, REC_STORE_DEPTH)
      && !(of == TY_NULL && nullableInnerOrNone(wf) >= 0)
      && !recCopyUnwraps(wf, of)
      && !(recCopyNestable(wf, of)
        && recCopyNarrowsAt(wf, nonNulTyOf(of), depth - 1))
    ) {
      return false
    }
    i = i + 1
  }
  true
}

// Whether a copy reads field `sf` as a record of its own to copy into the record `df` holds:
// `sf` a record, never null, and `df` a record or a nullable one.
function recCopyNestable(sf: i32, df: i32): boolean {
  if sf < 0 || df < 0 || sf >= T.tys.length || df >= T.tys.length {
    return false
  }
  const dn = nonNulTyOf(df)
  tyAt(sf) is TyObj && dn >= 0 && dn < T.tys.length && tyAt(dn) is TyObj
}

// Whether a field stored as `wf` in the wide row is copied into own field `of` by unwrapping it:
// `wf` is `of` or null, `of` is not. Sound for the copy because `own` is the copied call's own
// result type, so every value its function builds holds an `of` there (D15184).
function recCopyUnwraps(wf: i32, of: i32): boolean {
  const inner = nullableInnerOrNone(wf)
  of != TY_NULL && inner >= 0 && fieldStorageEq(inner, of, REC_STORE_DEPTH)
}

// The fields of record `own` a copy from wide row `wide` unwraps (`recCopyUnwraps`), as field
// paths (`j.f`) through the records a copy nests (`recCopyNestable`).
function recCopyUnwrapNames(wide: i32, own: i32): string[] {
  const out: string[] = []
  recCopyUnwrapNamesAt(wide, own, "", REC_STORE_DEPTH, out)
  out
}

// `recCopyUnwrapNames` below the path `pre`, at most `depth` levels down, pushed onto `out`.
function recCopyUnwrapNamesAt(
  wide: i32,
  own: i32,
  pre: string,
  depth: i32,
  out: string[],
) {
  if depth <= 0 { return 0 }
  const w = if wide >= 0 && wide < T.tys.length { tyAt(wide) } else { tyAt(TY_ERR) }
  const o = if own >= 0 && own < T.tys.length { tyAt(own) } else { tyAt(TY_ERR) }
  if !(w is TyObj) || !(o is TyObj) { return 0 }
  let i = 0
  while i < o.objFieldNames.length {
    const wf = objFieldType(w, o.objFieldNames[i])
    const of = o.objFieldTypes[i]
    if wf >= 0 && !fieldStorageEq(wf, of, REC_STORE_DEPTH) {
      if recCopyUnwraps(wf, of) {
        out.push(pre + o.objFieldNames[i])
      } else if recCopyNestable(wf, of) {
        recCopyUnwrapNamesAt(
          wf,
          nonNulTyOf(of),
          pre + o.objFieldNames[i] + ".",
          depth - 1,
          out,
        )
      }
    }
    i = i + 1
  }
  0
}

// Whether call `c` is an argument to a parameter typed `T` of a generic callee, or an element of a
// list literal handed to one typed `T[]`, where a held value no call of `c`'s function produced
// also binds `T` (another argument, or another element), or the call writes its type arguments:
// the instance is pinned there, so `c` lands at its own type (D14814).
function recHeldPinnedArg(c: i32): boolean {
  if c < 0 || !cwIxCovers(c) { return false }
  // The argument the call is, or the list literal argument it is an element of.
  let x = c
  let elem = false
  if cwIxUpKind[c] == CW_UP_ELEM {
    x = cwIxUp[c]
    elem = true
    if x < 0 || !cwIxCovers(x) || !(nodeAt(x) is ArrayLit) { return false }
  }
  if cwIxUpKind[x] != CW_UP_ARG { return false }
  const call = cwIxUp[x]
  const cn = nodeAt(call)
  if !(cn is Call) || cn.callFn < 0 { return false }
  const gd = identBoundFnDeclOf(cn.callFn)
  const g = if gd >= 0 && gd < P.nodes.length { nodeAt(gd) } else { null }
  const i = cwIxUpAux[x]
  if (
    !(g is FuncDecl)
    || g.fnTyParams.length == 0
    || i < 0
    || i >= g.fnParams.length
  ) {
    return false
  }
  if g.fnParams.length != cn.callArgs.length { return false }
  const pn = nodeAt(g.fnParams[i])
  const pt = if pn is Param && pn.parType >= 0 { nodeAt(pn.parType) } else { null }
  if !(pt is TypeRef) { return false }
  const tv = if elem && pt.tyName.length > 2 { pt.tyName.slice(0, pt.tyName.length - 2) } else { pt.tyName }
  if elem && pt.tyName != tv + "[]" { return false }
  if !strListHas(g.fnTyParams, tv) { return false }
  if callHasTyArgs(call) { return true }
  const fd = recInferredFnOf(c)
  const xl = nodeAt(x)
  if xl is ArrayLit {
    for el in xl.arrElems {
      if el != c && recHeldNotFrom(el, fd) { return true }
    }
  }
  let j = 0
  while j < g.fnParams.length {
    const qn = nodeAt(g.fnParams[j])
    if (
      j != i
      && qn is Param
      && qn.parType >= 0
      && tsMentionsAnyName(annTsOf(qn.parType), [tv])
      && recHeldNotFrom(cn.callArgs[j], fd)
    ) {
      return true
    }
    j = j + 1
  }
  false
}

// The argument value `u` is, or the list or record literal argument it sits in through elements
// and fields; -1 when `u` is neither.
export function recArgOfReach(u: i32): i32 {
  let x = u
  let hops = 0
  while x >= 0 && cwIxCovers(x) && hops < 16 {
    const k = cwIxUpKind[x]
    if k == CW_UP_ARG { return x }
    if k != CW_UP_ELEM && k != CW_UP_FIELD { return -1 }
    x = cwIxUp[x]
    hops = hops + 1
  }
  -1
}

// The type a generic call's written type argument, or another argument holding a value no call
// of `u`'s function produced, pins the type parameter at that `u` reaches through the path from
// `recArgOfReach(u)`; -1 when no parameter is named there or nothing else pins it.
export function recReachPinTy(u: i32): i32 {
  const at: i32[] = []
  const tv = recReachTv(u, at)
  if tv == "" { return -1 }
  const cn = nodeAt(at[1])
  const g = nodeAt(at[2])
  if !(cn is Call) || !(g is FuncDecl) { return -1 }
  if !callHasTyArgs(at[1]) && !recReachHeldPin(cn, g, at[3], at[0], u, tv) {
    return -1
  }
  callBindTyOf(at[1], tv)
}

// `recReachTv` for value `u` when the call it reaches is `call`, else "".
export function recReachTvAt(u: i32, call: i32): string {
  const at: i32[] = []
  const tv = recReachTv(u, at)
  if tv != "" && at.length > 1 && at[1] == call { tv } else { "" }
}

// The type parameter value `u` reaches through the path from `recArgOfReach(u)` down to `u`, with
// `at` filled as [argument, call, callee declaration, parameter position]; "" when none is named.
function recReachTv(u: i32, at: i32[]): string {
  const steps: string[] = []
  let x = u
  while x >= 0 && cwIxCovers(x) && cwIxUpKind[x] != CW_UP_ARG {
    if cwIxUpKind[x] == CW_UP_ELEM {
      steps.push("[]")
    } else if cwIxUpKind[x] == CW_UP_FIELD {
      steps.push(cwFieldNameOf(cwIxUpAux[x]))
    } else {
      return ""
    }
    if steps.length > 16 { return "" }
    x = cwIxUp[x]
  }
  if x < 0 || !cwIxCovers(x) { return "" }
  const call = cwIxUp[x]
  const cn = nodeAt(call)
  if !(cn is Call) || cn.callFn < 0 { return "" }
  const gd = identBoundFnDeclOf(cn.callFn)
  const g = if gd >= 0 && gd < P.nodes.length { nodeAt(gd) } else { null }
  const i = cwIxUpAux[x]
  if !(g is FuncDecl) || i < 0 || i >= g.fnParams.length { return "" }
  let name = nameStripSpaces(recParamTyName(g.fnParams[i]))
  let k = steps.length - 1
  while k >= 0 && name != "" {
    name = if steps[k] == "[]" { listElemNameOf(name) } else { shapeFieldTyName(name, steps[k]) }
    k = k - 1
  }
  if name == "" || !strListHas(g.fnTyParams, name) { return "" }
  at.push(x)
  at.push(call)
  at.push(gd)
  at.push(i)
  name
}

// The declared type that pins the type parameter call `c` reaches: the call's written type
// argument for it, else what another argument, a value no call of `c`'s function produced,
// binds it at through its parameter's annotation (`k: K` at `b: T`, `ks: K[]` at `b: T[]`); -1
// when neither names one (D15183).
function recDeclaredPinTy(c: i32): i32 {
  const at: i32[] = []
  const tv = recReachTv(c, at)
  if tv == "" { return -1 }
  const cn = nodeAt(at[1])
  const g = nodeAt(at[2])
  if !(cn is Call) || !(g is FuncDecl) { return -1 }
  if callHasTyArgs(at[1]) {
    const tas = callTyArgsOf(at[1])
    let q = 0
    while q < g.fnTyParams.length && q < tas.length {
      if g.fnTyParams[q] == tv { return nodeTyIxOf(tas[q]) }
      q = q + 1
    }
    return -1
  }
  const sig = nodeTyIxOf(at[2])
  const f = if sig >= 0 && sig < T.tys.length { tyAt(sig) } else { tyAt(TY_ERR) }
  if !(f is TyFunc) { return -1 }
  const fd = recValueFnOf(c)
  let j = 0
  while j < cn.callArgs.length && j < f.fnParamTypes.length {
    const a = cn.callArgs[j]
    if j != at[3] && recHeldNotFrom(a, fd) {
      const bn: string[] = []
      const bt: i32[] = []
      bindGenWalk(f.fnParamTypes[j], nodeTyIxOf(cwPeelValue(a)), bn, bt)
      let q = 0
      while q < bn.length {
        if bn[q] == tv { return bt[q] }
        q = q + 1
      }
    }
    j = j + 1
  }
  -1
}

// Whether, besides `u` in argument `x` (at position `i`) of call `cn` to `g`, an argument to a
// parameter mentioning `tv`, or another element of the list `x`, is a value no call of `u`'s
// function produced.
function recReachHeldPin(
  cn: Call,
  g: FuncDecl,
  i: i32,
  x: i32,
  u: i32,
  tv: string,
): boolean {
  const fd = recValueFnOf(u)
  const xl = nodeAt(x)
  if xl is ArrayLit && cwIxUp[u] == x {
    for el in xl.arrElems {
      if el != u && recHeldNotFrom(el, fd) { return true }
    }
  }
  // Bare, or one list level down, `u`'s build row instances the call, and a literal holding a
  // held value types only its own parameter; through a field or deeper it pins the instance (D15182).
  const deep = u != x && (cwIxUp[u] != x || cwIxUpKind[u] == CW_UP_FIELD)
  let j = 0
  while j < g.fnParams.length && j < cn.callArgs.length {
    const qn = nodeAt(g.fnParams[j])
    const a = cn.callArgs[j]
    if (
      j != i
      && qn is Param
      && qn.parType >= 0
      && tsMentionsAnyName(annTsOf(qn.parType), [tv])
      && (recHeldNotFrom(a, fd)
        || ((deep || recParamsMeet(g, i, j)) && recHeldInside(a, fd, 8)))
    ) {
      return true
    }
    j = j + 1
  }
  false
}

// Whether parameters `i` and `j` of `g` are both read, so values handed to the two can meet in its
// body; a literal holding a held value then pins the instance at a bare reach too (D15129).
function recParamsMeet(g: FuncDecl, i: i32, j: i32): boolean {
  if i < 0 || j < 0 || i >= g.fnParams.length || j >= g.fnParams.length {
    return false
  }
  recParamRead(g.fnParams[i]) && recParamRead(g.fnParams[j])
}

// Whether parameter `par` is read anywhere in its function.
function recParamRead(par: i32): boolean {
  cwIxBuild()
  const ow = cwOccWalk(par)
  while cwOccNext(ow) {
    if cwIxKind[ow.row] == CW_OCC_USE { return true }
  }
  false
}

// Whether a list or record literal `a` holds, through elements and fields, a value no call of
// `fd` produced (`recHeldNotFrom`).
function recHeldInside(a: i32, fd: i32, depth: i32): boolean {
  if recHeldNotFrom(a, fd) { return true }
  if depth <= 0 { return false }
  const p = cwPeelValue(a)
  if p < 0 || p >= P.nodes.length { return false }
  const n = nodeAt(p)
  if n is ArrayLit {
    for el in n.arrElems {
      if recHeldInside(el, fd, depth - 1) { return true }
    }
  } else if n is ObjLit {
    for fx in n.objFields {
      const fi = nodeAt(fx)
      if fi is FieldInit && recHeldInside(fi.fiValue, fd, depth - 1) {
        return true
      }
    }
  }
  false
}

// The function whose call produced value `u`: its own callee, or its origin's.
function recValueFnOf(u: i32): i32 {
  if nodeAt(u) is Call { return recInferredFnOf(u) }
  const o = recOriginExpr(cwPeelValue(u))
  if o < 0 { -1 } else { recInferredFnOf(o) }
}

// The type name of field `f` in the record shape name `name` (`{f:T,g:U}`), or "" when none.
function shapeFieldTyName(name: string, f: string): string {
  if !nameIsShapeOpen(name) || !nameIsBraceSpanEnds(name) { return "" }
  const parts: string[] = []
  tyTopLevelSplit(name.slice(1, name.length - 1), 44, false, parts)
  for p in parts {
    const ci = tyTopIndexOf(p, 58, 0, 0)
    if ci > 0 && fieldNameOf(p, ci) == f { return fieldTypeTextOf(p, ci) }
  }
  ""
}

// Whether `a` is a held value, a name or a read of one, whose origin is no call of `fd`.
function recHeldNotFrom(a: i32, fd: i32): boolean {
  const p = cwPeelValue(a)
  if p < 0 || p >= P.nodes.length { return false }
  const n = nodeAt(p)
  if !(n is Ident || n is Member || n is Index) { return false }
  const o = recOriginExpr(p)
  o < 0 || recInferredFnOf(o) != fd
}

// Whether some call of `fd` is a held-pinned argument (`recHeldPinnedArg`).
function recSitesHeldPinned(fd: i32): boolean {
  const sites: i32[] = []
  if rcwCallSites(fd, sites) >= 0 { return false }
  for s in sites {
    if s % 2 == 0 && recHeldPinnedArg(s / 2) { return true }
  }
  false
}

// Note each call site in `sites` that `recRepArgOf` serves at `dst` for its callee's instance.
function recRepArgsNote(sites: i32[], own: i32, dst: i32) {
  for s in sites {
    // A binding that takes its own copy hands its own row on, so no argument it reaches takes the
    // build's rep (D15267).
    if s % 2 == 0 && !i32ListHas(recSiteCopyBack, s / 2) {
      let i = 0
      while i < recPendSrc.length {
        if recRepArgOf(i, s / 2, own, dst) {
          recAnnArgTakesRep(recPendSrc[i], dst)
        }
        i = i + 1
      }
    }
  }
  0
}

// Whether record `dst` stores each field of record `own` as `own` does, as that type or null, or,
// where `stored` (held in a container built at `dst`), as `i64` for `i32`; a record field is judged
// alike, to `REC_STORE_DEPTH` levels. Otherwise the record is built at its own row and each delivery
// copies, since a widened number's read must have the checker's type (D8302).
function recNullWidened(own: i32, dst: i32, stored: boolean): boolean {
  recNullWidenedAt(own, dst, stored, REC_STORE_DEPTH)
}

// `recNullWidened` with at most `depth` levels of record fields left.
function recNullWidenedAt(
  own: i32,
  dst: i32,
  stored: boolean,
  depth: i32,
): boolean {
  if (
    depth <= 0
    || own < 0
    || dst < 0
    || own >= T.tys.length
    || dst >= T.tys.length
  ) {
    return false
  }
  const o = tyAt(own)
  const d = tyAt(dst)
  if o is TyObj && d is TyObj {
    let i = 0
    while i < o.objFieldNames.length {
      const of = o.objFieldTypes[i]
      const df = objFieldType(d, o.objFieldNames[i])
      if df < 0 { return false }
      if !fieldStorageEq(of, df, REC_STORE_DEPTH) {
        const inner = nullableInnerOrNone(df)
        const at = if inner < 0 { df } else { inner }
        if (
          !fieldStorageEq(of, at, REC_STORE_DEPTH)
          && !(of == TY_NULL && inner >= 0)
          && !(stored && of == TY_I32 && at == TY_I64)
          && !recNullWidenedAt(of, at, stored, depth - 1)
        ) {
          return false
        }
      }
      i = i + 1
    }
    return true
  }
  false
}

// Whether `x` is the object of a field read that is not a method's callee.
export function recFieldRead(x: i32): boolean {
  if x < 0 || !cwIxCovers(x) || cwIxUpKind[x] != CW_UP_OBJ { return false }
  const u = cwIxUp[x]
  if u < 0 || u >= P.nodes.length || !(nodeAt(u) is Member) { return false }
  !cwIxCovers(u) || cwIxUpKind[u] != CW_UP_CALLEE
}

// Whether some queued delivery reaches call `c`'s record of `own` (`recLandingIn`).
function recQueuedReaches(c: i32, own: i32, dst: i32): boolean {
  let i = 0
  while i < recPendSrc.length {
    if (
      !recPendInert(i)
      && !recRepArgOf(i, c, own, dst)
      && recLandingIn(recPendSrc[i], recPendDstTy[i], c, own, REC_STORE_DEPTH) >= 0
    ) {
      return true
    }
    i = i + 1
  }
  false
}

// Whether `p` reaches the call `po` through generic identities each pinned only by the argument it
// hands back.
function recSolePinChain(p: i32, po: i32): boolean {
  let x = cwPeelValue(p)
  let hops = 0
  while x >= 0 && x < P.nodes.length && hops < 16 {
    if x == po { return true }
    const a = recSolePinArg(x)
    if a < 0 { return false }
    x = cwPeelValue(a)
    hops = hops + 1
  }
  false
}

// Whether some call of `fd` has a queued delivery landing its record or list of `own` on a field
// storage other than both `dst`'s and its own.
function recSitesLandApart(fd: i32, own: i32, dst: i32): boolean {
  if own < 0 || dst < 0 { return false }
  const o = tyAt(own)
  const d = tyAt(dst)
  if !((o is TyObj && d is TyObj) || (o is TyArray && d is TyArray)) {
    return false
  }
  const sites: i32[] = []
  if rcwCallSites(fd, sites) >= 0 { return false }
  for s in sites {
    if s % 2 == 0 {
      const at = recQueuedLandingOf(s / 2, own, dst)
      if (
        at >= 0
        && !fieldStorageEq(at, dst, REC_STORE_DEPTH)
        && !fieldStorageEq(at, own, REC_STORE_DEPTH)
      ) {
        return true
      }
    }
  }
  false
}

// The record a queued delivery of `src` as `dstTy` lands at: the default of a `??` over a read
// built wider is delivered at the read's record, as the store column delivers it (D15317).
function recCoalesceDefaultLanding(src: i32, dstTy: i32): i32 {
  const v = cwPeelValue(src)
  if v < 0 || !cwIxCovers(v) || cwIxUpKind[v] != CW_UP_COAL { return dstTy }
  const q = cwIxUp[v]
  const qn = if q >= 0 && q < P.nodes.length { nodeAt(q) } else { null }
  if !(qn is BinExpr) || cwPeelValue(qn.binRight) != v { return dstTy }
  const b = recBuiltReadTy(q)
  const r = if b >= 0 { nonNullTy(b) } else { -1 }
  if r >= 0 && r < T.tys.length && tyAt(r) is TyObj { r } else { dstTy }
}

// The record a queued delivery lands call `c`'s record of `own` on, through generic identities
// only it pins and the fields and elements of literals; -1 when no queued delivery reaches `c` or
// two land it differently.
function recQueuedLandingOf(c: i32, own: i32, dst: i32): i32 {
  let got = -1
  let i = 0
  while i < recPendSrc.length {
    if recPendInert(i) || recRepArgOf(i, c, own, dst) {
      i = i + 1
      continue
    }
    const t = recLandingIn(
      recPendSrc[i],
      recCoalesceDefaultLanding(recPendSrc[i], recPendDstTy[i]),
      c,
      own,
      REC_STORE_DEPTH,
    )
    if t >= 0 {
      if got >= 0 && !fieldStorageEq(got, t, REC_STORE_DEPTH) { return -1 }
      got = t
    }
    i = i + 1
  }
  got
}

// Whether queued delivery `i` is a list literal handed at its own type to a generic that hands
// back one of its elements (`recElemPinLit`): its elements land where the call does (D14812).
function recPendInert(i: i32): boolean {
  if i < 0 || i >= recPendSrcTy.length || i >= recPendDstTy.length {
    return false
  }
  const src = recPendSrc[i]
  const p = cwPeelValue(src)
  if p < 0 || p >= P.nodes.length || !(nodeAt(p) is ArrayLit) { return false }
  if !tySame(recPendSrcTy[i], recPendDstTy[i]) { return false }
  if src < 0 || !cwIxCovers(src) || cwIxUpKind[src] != CW_UP_ARG {
    return false
  }
  recElemPinLit(cwIxUp[src]) == p
}

// Whether queued delivery `i` is call `c`'s record of `own`, directly or relayed, handed as an
// argument to an annotated parameter an instance at `dst` serves (`recAnnArgRepOk`), or to a list
// parameter that takes the rep (`recListArgTakesRep`), so it lands at the build.
function recRepArgOf(i: i32, c: i32, own: i32, dst: i32): boolean {
  const src = recPendSrc[i]
  if dst < 0 { return false }
  if recAnnArgRepOk(src, dst) {
    return cwPeelValue(src) == c
      || recLandingIn(src, dst, c, own, REC_STORE_DEPTH) >= 0
  }
  // A call writing its type arguments decides its instance: the rep serves it only where the
  // written instance stores the elements as `dst` does (D14815).
  const up = if src >= 0 && cwIxCovers(src) { cwIxUp[src] } else { -1 }
  if up >= 0 && callHasTyArgs(up) {
    const de = tyArrayElemIx(nonNulTyOf(recPendDstTy[i]))
    if de < 0 || !fieldStorageEq(de, dst, REC_STORE_DEPTH) { return false }
  }
  recListArgTakesRep(src)
    && recLandingIn(src, recPendDstTy[i], c, own, REC_STORE_DEPTH) >= 0
}

// Whether `src` is an argument whose list parameter takes the rep (`recListParamTakesRep`).
function recListArgTakesRep(src: i32): boolean {
  if src < 0 || !cwIxCovers(src) || cwIxUpKind[src] != CW_UP_ARG {
    return false
  }
  const c = nodeAt(cwIxUp[src])
  if !(c is Call) || c.callFn < 0 { return false }
  const fd = identBoundFnDeclOf(c.callFn)
  const f = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  const i = cwIxUpAux[src]
  if !(f is FuncDecl) || i < 0 || i >= f.fnParams.length { return false }
  recListParamTakesRep(f.fnParams[i], cwIxUp[src], 4)
}

// `recQueuedLandingOf` for one delivery of `src` as a `dstTy`.
function recLandingIn(src: i32, dstTy: i32, c: i32, own: i32, depth: i32): i32 {
  const p = cwPeelValue(src)
  const d = nonNulTyOf(dstTy)
  if p < 0 || p >= P.nodes.length || d < 0 || d >= T.tys.length || depth <= 0 {
    return -1
  }
  if p == c { return recAdLanding(own, d) }
  if recSolePinArg(p) >= 0 {
    return recLandingIn(recSolePinArg(p), d, c, own, depth - 1)
  }
  // A generic handing back an element of its list literal argument lands each element there.
  const epl = recElemPinLit(p)
  const eln = if epl >= 0 { nodeAt(epl) } else { null }
  if eln is ArrayLit {
    for ex in eln.arrElems {
      const t = recLandingIn(ex, d, c, own, depth - 1)
      if t >= 0 { return t }
    }
    return -1
  }
  // A non-generic function handing back an un-annotated parameter lands its argument there.
  const pc = nodeAt(p)
  if pc is Call && pc.callFn >= 0 {
    const ha = recHoleIdentityArg(p, identBoundFnDeclOf(pc.callFn))
    if ha >= 0 { return recLandingIn(ha, d, c, own, depth - 1) }
  }
  // A call of an inferred function lands each value it hands back where the call lands.
  const g = recInferredFnOf(p)
  if g >= 0 {
    for lf in recFnValueLeaves(g) {
      const t = recLandingIn(lf, d, c, own, depth - 1)
      if t >= 0 { return t }
    }
    return -1
  }
  const e = nodeAt(p)
  const dt = tyAt(d)
  // A binding holding only the call lands where its read does.
  const bo = if e is Ident { recBindOrigin(p) } else { -1 }
  if bo == c { return recAdLanding(own, d) }
  // So does a binding holding only a value that relays it, such as `id(mk())`.
  const hd = if e is Ident { recHeldDecl(p) } else { -1 }
  const hn = if hd >= 0 { nodeAt(hd) } else { null }
  if hn is LetDecl && hn.letInit >= 0 {
    return recLandingIn(hn.letInit, d, c, own, depth - 1)
  }
  if e is ObjLit && dt is TyObj {
    let i = 0
    while i < dt.objFieldNames.length {
      const fx = objLitFieldExpr(p, dt.objFieldNames[i])
      if fx >= 0 {
        const t = recLandingIn(fx, dt.objFieldTypes[i], c, own, depth - 1)
        if t >= 0 { return t }
      }
      i = i + 1
    }
  } else if e is ArrayLit {
    const de = tyArrayElemIx(d)
    if de < 0 { return -1 }
    for el in e.arrElems {
      const t = recLandingIn(el, de, c, own, depth - 1)
      if t >= 0 { return t }
    }
  }
  -1
}

// Does the inferred function `fd` hand back an object literal, directly or through a call to
// another inferred function that a generic identity may hand back, within `depth` calls (D8143)?
function recBuildsLit(fd: i32, depth: i32): boolean {
  if fd < 0 || depth <= 0 { return false }
  if recHasLitLeaf(fd) { return true }
  for lf in recFnValueLeaves(fd) {
    const lo = recOriginExpr(cwPeel(lf))
    const g = if lo >= 0 { recInferredFnOf(lo) } else { -1 }
    if g >= 0 && g != fd && recBuildsLit(g, depth - 1) { return true }
  }
  false
}

// The object literal the function result leaf `lf` is, or hands back through generic identities
// that only it pins and that fits `dst` (D8021). -1 otherwise.
function recLeafLitOf(lf: i32, dst: i32): i32 {
  if lf < 0 || lf >= P.nodes.length { return -1 }
  if nodeAt(lf) is ObjLit { return lf }
  let x = lf
  let hops = 0
  while x >= 0 && x < P.nodes.length && hops < 16 && recSolePinArg(x) >= 0 {
    x = cwPeelValue(recSolePinArg(x))
    hops = hops + 1
  }
  if hops == 0 || x < 0 || x >= P.nodes.length || !(nodeAt(x) is ObjLit) {
    return -1
  }
  if !recLitFits(x, dst, REC_STORE_DEPTH) { return -1 }
  x
}

// Builds at `dst` each object literal the inferred function `fd` hands back through generic
// identities, as a literal it returns directly is built where its call lands (D8380).
function recIdentityLeavesAt(fd: i32, dst: i32) {
  if dst < 0 || dst >= T.tys.length || !(tyAt(dst) is TyObj) { return 0 }
  for lf in recFnValueLeaves(fd) {
    const lp = cwPeel(lf)
    if lp >= 0 && lp < P.nodes.length && !(nodeAt(lp) is ObjLit) {
      const ll = recLeafLitOf(lp, dst)
      if ll >= 0 { recordRepTyAdopt(ll, dst, 6) }
    }
  }
  0
}

// A function that only returns its un-annotated parameter hands back what call `p` delivers
// there, so a literal or literal binding argument adopts the record the call lands on, as it
// does through a generic identity; true when it did.
function recHoleIdentityAt(p: i32, fd: i32, srcTy: i32, dstTy: i32): boolean {
  const a = recHoleIdentityArg(p, fd)
  if a < 0 { return false }
  const ap = cwPeelValue(a)
  if ap < 0 || ap >= P.nodes.length { return false }
  if nodeAt(ap) is ObjLit { return recHoleAdoptLit(ap, srcTy, dstTy) }
  // A call of an inferred function, directly or through bindings holding it (`recOriginExpr`),
  // takes the destination on, as a result leaf does (D14736, D15179).
  const ao = recOriginExpr(a)
  const ia = if ao >= 0 { recInferredFnOf(ao) } else { -1 }
  if ia >= 0 && ia != fd {
    recAdoptNote(ao, nodeTyIxOf(ao), dstTy)
    return true
  }
  if recFreshDeclOf(ap) < 0 { return false }
  recAdoptNote(a, nodeTyIxOf(a), dstTy)
  true
}

// Adopts object literal `ap` at the record a value of `srcTy` lands on in `dstTy` when it fits
// there; true when it does.
function recHoleAdoptLit(ap: i32, srcTy: i32, dstTy: i32): boolean {
  const ld = recLandingOf(srcTy, dstTy)
  if ld < 0 || !recLitFits(ap, ld, REC_STORE_DEPTH) { return false }
  recordRepTyAdopt(ap, ld, 6)
  true
}

// The argument of call `p` that `fd`, a non-generic function whose body only rebinds and returns
// an un-annotated parameter, hands back; -1 otherwise.
export function recHoleIdentityArg(p: i32, fd: i32): i32 {
  if p < 0 || p >= P.nodes.length || fd < 0 || fd >= P.nodes.length {
    return -1
  }
  const c = nodeAt(p)
  const f = nodeAt(fd)
  if !(c is Call) || !(f is FuncDecl) { return -1 }
  if f.fnTyParams.length > 0 || f.fnRet >= 0 || f.fnBody < 0 { return -1 }
  for an in c.callArgNames {
    if an != "" { return -1 }
  }
  const b = nodeAt(f.fnBody)
  if !(b is Block) || b.blkStmts.length == 0 { return -1 }
  let t = b.blkStmts[b.blkStmts.length - 1]
  const tn = nodeAt(t)
  if tn is RetStmt { t = tn.retArg }
  const v = parenPeelIx(t)
  if v < 0 || v >= P.nodes.length { return -1 }
  const vn = nodeAt(v)
  if !(vn is Ident) { return -1 }
  // Earlier statements may only rebind the value to un-annotated names, walked back here.
  let name = vn.identName
  let k = b.blkStmts.length - 2
  while k >= 0 {
    const s = nodeAt(b.blkStmts[k])
    if !(s is LetDecl) || s.letType >= 0 { return -1 }
    const si = parenPeelIx(s.letInit)
    if si < 0 || si >= P.nodes.length { return -1 }
    const sn = nodeAt(si)
    if !(sn is Ident) { return -1 }
    if s.letName == name { name = sn.identName }
    k = k - 1
  }
  let i = 0
  while i < f.fnParams.length && i < c.callArgs.length {
    const pn = nodeAt(f.fnParams[i])
    if pn is Param {
      if pn.parName == name {
        if pn.parType >= 0 || pn.parRest != 0 { return -1 }
        return c.callArgs[i]
      }
    }
    i = i + 1
  }
  -1
}

// Does the object literal `lit` fit the record `dst` field by field, where a number literal
// meets a number field its value fits, at every depth of object literals?
function recLitFits(lit: i32, dst: i32, depth: i32): boolean {
  if lit < 0 || dst < 0 || depth <= 0 { return false }
  const d = tyAt(dst)
  const e = nodeAt(lit)
  if !(e is ObjLit) || !(d is TyObj) { return false }
  if !objFieldNameSetsEq(nodeTyIxOf(lit), dst) { return false }
  let i = 0
  while i < d.objFieldNames.length {
    const fx = cwPeel(objLitFieldExpr(lit, d.objFieldNames[i]))
    const df = d.objFieldTypes[i]
    if fx < 0 { return false }
    const fe = nodeAt(fx)
    const ok = assignable(nodeTyIxOf(fx), df)
      || recLitNumFits(fx, df)
      || (fe is ObjLit && recLitFits(fx, nonNulTyOf(df), depth - 1))
    if !ok { return false }
    i = i + 1
  }
  true
}

// Does the number literal at `fx` hold its value at the number field `df`: in range at a number
// type and whole at an integer one, or a member of an integer-literal type.
function recLitNumFits(fx: i32, df: i32): boolean {
  const lit = cexLitPeel(fx)
  const c = recNumClass(df)
  if lit < 0 || c == "" { return false }
  const l = nodeAt(lit)
  if !(l is NumLit) { return false }
  let v = cexOfLexeme(l.numText)
  if !cexOk(v) { return false }
  if intLitIsNegated(fx) { v = cexNeg(v) }
  const b = nonNulTyOf(df)
  if b < 0 || b >= T.tys.length { return false }
  if tyAt(b) is TyPrim {
    if v.cxFloat && (c == "i32" || c == "i64") { return false }
    return cexFitsAt(v, l.numText, b)
  }
  !v.cxNeg && !v.cxFloat && assignable(mkLitTy("int", l.numText), b)
}

// —— adoption: a binding or function holding only literals takes the record it is delivered to ——
// The destination is written as its annotation or result and the program checked again, so
// every use sees it. A re-check that refuses anything but the adopted value handed on whole
// undoes it, unless it changed a number's width (DECISIONS.md "Record covariance").

// A `Map()` binding `srcExpr` delivered as a map of the same key adopts the record its values
// are delivered as, as a list literal binding's elements do: a `Map()` is built at the type it
// flows into. One held by a list or record literal is delivered as its element or field.
export function recAdoptMapNote(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcTy < 0 || dstTy < 0 { return 0 }
  const p = cwPeelValue(srcExpr)
  if p < 0 || p >= P.nodes.length { return 0 }
  const e = nodeAt(p)
  const d = nonNulTyOf(dstTy)
  if d < 0 || d >= T.tys.length { return 0 }
  const dt = tyAt(d)
  if e is ArrayLit {
    if !(dt is TyArray) { return 0 }
    for el in e.arrElems {
      if !(nodeAt(el) is Spread) {
        recAdoptMapNote(el, nodeTyIxOf(el), dt.aElem)
      }
    }
    return 0
  }
  if e is ObjLit {
    if !(dt is TyObj) { return 0 }
    for fx in e.objFields {
      const f = nodeAt(fx)
      if f is FieldInit {
        recAdoptMapNote(
          f.fiValue,
          nodeTyIxOf(f.fiValue),
          tyFieldTyOf(d, f.fiName),
        )
      }
    }
    return 0
  }
  // A call is delivered as the bindings its function returns. Adopting one retypes the result
  // at every call, so the re-check judges the other calls too.
  if e is Call && (dt is TyMap || dt is TyArray) {
    const fd = recInferredFnOf(p)
    if fd >= 0 {
      const os = recFnReturns(fd)
      let reads = true
      for b in os {
        if !(nodeAt(b) is Ident) { reads = false }
      }
      if reads {
        for b in os { recAdoptMapNote(b, nodeTyIxOf(b), dstTy) }
      }
    }
    return 0
  }
  if !(e is Ident) { return 0 }
  const decl = recFreshMapDeclOf(p)
  if decl < 0 {
    // A list literal binding is delivered as its literal is.
    const ld = recFreshDeclOf(p)
    if ld >= 0 && dt is TyArray {
      const li = parenPeelIx(recDeclInit(ld))
      if li >= 0 && nodeAt(li) is ArrayLit {
        recAdoptMapNote(li, nodeTyIxOf(li), dstTy)
      }
    }
    // One holding a call is delivered as the call is.
    const oc = recHeldCallOrigin(p)
    if oc >= 0 { recAdoptMapNote(oc, nodeTyIxOf(oc), dstTy) }
    return 0
  }
  recAdPushMapDecl(decl, srcTy, nonNulTyOf(dstTy), p)
  // Each value stored into it is delivered as the map's values in the same round, so a chain
  // of `Map()` bindings settles at once rather than one binding a round (D14506).
  if !(dt is TyMap) || i32ListHas(recMapFollowing, decl) { return 0 }
  recMapFollowing.push(decl)
  for v in recMapStoredValues(decl) {
    recAdoptMapNote(v, nodeTyIxOf(v), dt.mVal)
  }
  recMapFollowing.pop()
  0
}

// The `Map()` bindings whose stored values `recAdoptMapNote` is following, so a cycle of stores
// ends.
const recMapFollowing: i32[] = []

// The values stored into the `Map()` binding `d` by `m[k] = v` and `m.set(k, v)`.
function recMapStoredValues(d: i32): i32[] {
  const out: i32[] = []
  const dn = nodeAt(d)
  if !(dn is LetDecl) { return out }
  const fld = dn.letInit >= 0 && nodeAt(cwPeelValue(dn.letInit)) is ObjLit
  cwIxBuild()
  const ow = cwOccWalk(d)
  while cwOccNext(ow) {
    const u = cwIxNode[ow.row]
    if cwIxKind[ow.row] == CW_OCC_USE && u >= 0 && cwIxCovers(u) {
      const v = recMapStoreValueAt(u, fld)
      if v >= 0 { out.push(v) }
    }
  }
  out
}

// The value the use `u` of a map binding stores, when it is the receiver of `u[k] = v` or of
// `u.set(k, v)`; -1 otherwise.
function recMapStoreValueAt(u: i32, fld: boolean): i32 {
  if (u < 0 || !cwIxCovers(u) || !cwIxCovers(u) || cwIxUpKind[u] != CW_UP_OBJ) {
    return -1
  }
  const p = cwIxUp[u]
  if (p < 0 || p >= P.nodes.length || !cwIxCovers(p) || !cwIxCovers(p)) {
    return -1
  }
  const a = cwIxUp[p]
  if a < 0 || a >= P.nodes.length { return -1 }
  if cwIxUpKind[p] == CW_UP_ASG_LHS { return recMapIndexStoreValue(p, a, fld) }
  if cwIxUpKind[p] == CW_UP_CALLEE { return recMapSetStoreValue(p, a) }
  -1
}

// The right side of the assignment `a` whose target is `p`: an index, or with `fld` a field;
// -1 when it is not one.
function recMapIndexStoreValue(p: i32, a: i32, fld: boolean): i32 {
  const an = nodeAt(a)
  const pn = nodeAt(p)
  const target = if fld { pn is Member } else { pn is Index }
  if target && an is BinExpr { return an.binRight }
  -1
}

// The value argument of the call `a` whose callee is the member `p`, when that is `.set(k, v)`;
// -1 otherwise.
function recMapSetStoreValue(p: i32, a: i32): i32 {
  const pn = nodeAt(p)
  const an = nodeAt(a)
  if pn is Member && an is Call {
    if pn.memProp == "set" && an.callArgs.length == 2 { return an.callArgs[1] }
  }
  -1
}

// Build the container binding `md`'s values (`recStoreDeclOf`) where every stored value a kept
// delivery builds is built, a record's field by field, and refuse each one not built there, or
// every one when they land apart.
export function recStoresAgree(md: i32) {
  const vs = recStoredValues(md)
  const own = recStoreRecTy(md)
  if own < 0 {
    for v in vs { recBuildPush(md, nodeTyIxOf(v), recMapStoreKeptDst(v), true) }
  } else {
    recBuildPush(md, own, recFieldsBuiltTy(own, vs), false)
  }
  const bt = recBuildPassAt(md)
  for v in vs {
    const kd = recMapStoreKeptDst(v)
    const st = if own < 0 { bt } else { recFieldRebuiltTy(own, bt, recStoreFieldOf(v)) }
    const at = if st >= 0 { st } else { kd }
    const lit = nodeAt(v) is ObjLit
    const built = st >= 0
      && (lit || (kd >= 0 && fieldStorageEq(kd, st, REC_STORE_DEPTH)))
    if !built && at >= 0 { recRefuseAtOwnRow(v, nodeTyIxOf(v), at) }
    // A stored literal is built at the build, so its fields are boxed at the build's fields.
    if built && lit { litFieldsBoxAt(v, st, 4) }
  }
  0
}

// Boxes each field value of each record literal `x` builds at destination `dst` — `x` itself, or
// the elements of a list literal — at the field's type, into nested literals up to `depth`.
export function litBoxesAtDst(x: i32, dst: i32, depth: i32) {
  const n = if x >= 0 { nodeAt(x) } else { null }
  const d = nonNullTy(dst)
  const dn = if d >= 0 && d < T.tys.length { T.tys[d] } else { null }
  if depth <= 0 { return 0 }
  if n is ArrayLit && dn is TyArray {
    for el in n.arrElems { litBoxesAtDst(cwPeelValue(el), dn.aElem, depth - 1) }
    return 0
  }
  litFieldsBoxAt(x, d, depth)
}

// Boxes each field value of the record literal `lit` at its field's type in the record `st` the
// literal is built at, into nested literals up to `depth`.
function litFieldsBoxAt(lit: i32, st: i32, depth: i32) {
  const n = if lit >= 0 { nodeAt(lit) } else { null }
  const so = if st >= 0 && st < T.tys.length { T.tys[st] } else { null }
  if depth <= 0 || !(n is ObjLit) || !(so is TyObj) { return 0 }
  for fi in n.objFields {
    const f = nodeAt(fi)
    if f is FieldInit {
      const ft = objFieldType(so, f.fiName)
      if ft >= 0 {
        recordBoxTy(f.fiValue, ft)
        litFieldsBoxAt(cwPeelValue(f.fiValue), nonNullTy(ft), depth - 1)
      }
    }
  }
  0
}

// The record type of the object literal the container binding `md` holds, else -1.
function recStoreRecTy(md: i32): i32 {
  const dn = nodeAt(md)
  if !(dn is LetDecl) || dn.letInit < 0 { return -1 }
  const v = cwPeelValue(dn.letInit)
  if v < 0 || !(nodeAt(v) is ObjLit) { return -1 }
  const t = nodeTyIxOf(v)
  if t >= 0 && tyAt(t) is TyObj { t } else { -1 }
}

// The record `own` with each field a stored value in `vs` is built at elsewhere retyped to that
// build; -1 where none is, or two values of one field are built at different storages.
function recFieldsBuiltTy(own: i32, vs: i32[]): i32 {
  const ot = tyAt(own)
  if !(ot is TyObj) { return -1 }
  const tys: i32[] = []
  for f in ot.objFieldTypes { tys.push(f) }
  let moved = false
  for v in vs {
    const kd = recMapStoreKeptDst(v)
    const name = recStoreFieldOf(v)
    let i = ot.objFieldNames.length - 1
    while i >= 0 && ot.objFieldNames[i] != name { i = i - 1 }
    if kd >= 0 && i >= 0 {
      const was = tys[i] != ot.objFieldTypes[i]
      if was && !fieldStorageEq(tys[i], kd, REC_STORE_DEPTH) { return -1 }
      tys[i] = kd
      moved = true
    }
  }
  if moved { mkObjTy(ot.objFieldNames, tys) } else { -1 }
}

// Field `name` of the build `bt` of the record `own`, where it stores differently from `own`'s;
// else -1.
function recFieldRebuiltTy(own: i32, bt: i32, name: string): i32 {
  if bt < 0 || own < 0 || name == "" { return -1 }
  const btT = tyAt(bt)
  const ownT = tyAt(own)
  if !(btT is TyObj) || !(ownT is TyObj) { return -1 }
  const f = objFieldType(btT, name)
  const o = objFieldType(ownT, name)
  if f < 0 || o < 0 || fieldStorageEq(f, o, REC_STORE_DEPTH) { -1 } else { f }
}

// The field the value `v` is stored into: its name in an object literal, or `w.name = v`; else "".
function recStoreFieldOf(v: i32): string {
  if v < 0 || !cwIxCovers(v) { return "" }
  const a = cwIxUp[v]
  if a < 0 || a >= P.nodes.length { return "" }
  if cwIxUpKind[v] == CW_UP_FIELD {
    const fi = nodeAt(cwIxUpAux[v])
    return if fi is FieldInit { fi.fiName } else { "" }
  }
  const an = nodeAt(a)
  if an is BinExpr && an.binRight == v {
    const l = nodeAt(an.binLeft)
    if l is Member { return l.memProp }
  }
  ""
}

// Refuse the own-storage delivery `u` of a container its stores build (`recStoresAgree`), or of
// a value read out of one, where the build stores a field differently from `u`'s own type.
export function recBuiltReadRefuse(u: i32) {
  const p = cwPeelValue(u)
  if p < 0 || p >= P.nodes.length { return 0 }
  const own = nodeTyIxOf(p)
  const et = recBuiltElemOf(p)
  if et >= 0 && own >= 0 {
    const ot = tyAt(own)
    const oe = if ot is TyArray { ot.aElem } else if ot is TyMap { ot.mVal } else { -1 }
    if oe >= 0 && ot is TyArray && recAnnArgTakesRep(p, mkArrayTy(et)) {
      return 0
    }
    if oe >= 0 { recBuiltReadErr(p, own, nonNullTy(oe), et, true) }
    return 0
  }
  const bt = recBuiltReadTy(p)
  if bt < 0 || own < 0 { return 0 }
  if !(nodeAt(p) is BinExpr) && recArgTakesRep(p, 4) { return 0 }
  if !(nodeAt(p) is BinExpr) && recAnnArgTakesRep(p, nonNullTy(bt)) { return 0 }
  // A `??` whose default is a fresh record literal builds the literal at the read's record too.
  if recCoalesceLitBuilt(p, nonNullTy(bt)) { return 0 }
  if recAsgIntoBuiltAt(p, nonNullTy(bt)) { return 0 }
  if !fieldStorageEq(nonNullTy(bt), nonNullTy(own), REC_STORE_DEPTH) {
    recBuiltReadErr(p, own, nonNullTy(own), nonNullTy(bt), false)
  }
  0
}

// Whether `p` is assigned into an un-annotated binding whose initialiser is a built read at
// `rep` too: the binding is stored at `rep`, so the write converts nothing (D15124).
function recAsgIntoBuiltAt(p: i32, rep: i32): boolean {
  const b = recLitPlaceBuiltTy(p)
  b >= 0 && tySame(b, rep)
}

// The record (or list) a literal or read `p` delivered into a built place is built at: an
// un-annotated binding whose initialiser is a built read or a built list (D15188, D15189), or a
// literal pushed or index-stored into a list with a recorded element build (D15235); else -1.
export function recLitPlaceBuiltTy(p: i32): i32 {
  const init = recAsgBindInit(p)
  const b0 = if init >= 0 { recBuiltReadTy(init) } else { -1 }
  // An element of a list whose literal built its records elsewhere is read at that stamp (D15232).
  const b = if b0 < 0 && init >= 0 { recElemReadStampTy(init) } else { b0 }
  if b >= 0 { return nonNullTy(b) }
  if p < 0 || p >= P.nodes.length { return -1 }
  const pn = nodeAt(p)
  // A binding whose function fields its writes widened is built at its own record (D15306).
  const fw = recAsgFnWidenedTy(p)
  if fw >= 0 { return fw }
  // A call's build is the store column's (`callBuiltTy`), unless the record solve copies the
  // call back to its own record (D15246, D15282).
  const call = init >= 0 && nodeAt(init) is Call && recCopyFromOf(init) < 0
  const cb = if call { checkerForceFn(3, init, 8, -1) } else { -1 }
  if (
    cb >= 0
    && cb < T.tys.length
    && tyAt(cb) is TyObj
    && (pn is ObjLit || pn is Ident)
  ) {
    return cb
  }
  if init >= 0 {
    if !(pn is ArrayLit) { return -1 }
    const it = nodeTyIxOf(init)
    const e = recHeldElemBuilt(init)
    return if e >= 0 && it >= 0 && it < T.tys.length && tyAt(it) is TyArray { mkArrayTy(e) } else { -1 }
  }
  // A list literal that is itself an element of a built list of lists is built at its inner
  // lists' build (D15284).
  if pn is ArrayLit {
    cwIxBuild()
    const er = recSlotReceiverOf(p, p)
    const ee = if er >= 0 { recElemOfElemStamp(er) } else { -1 }
    if ee >= 0 { return mkArrayTy(ee) }
  }
  const r = recLitSlotReceiver(p)
  // A list literal spread into a built list of lists holds its inner lists (D15285).
  const ie = if r >= 0 && pn is ArrayLit { recElemOfElemStamp(r) } else { -1 }
  if ie >= 0 { return mkArrayTy(mkArrayTy(ie)) }
  const e = if r >= 0 { recHeldElemBuilt(r) } else { -1 }
  if e < 0 { return -1 }
  // A list literal reaches the list's slots only spread into a push, whose elements it holds.
  if pn is ObjLit || pn is Ident { e }
  else if pn is ArrayLit { mkArrayTy(e) }
  else { -1 }
}

// Builds the fresh record `const` record literal `l` initialises at the record a read of it is
// pushed or assigned into, where that place's build is recorded (D15237). Two places at two
// records each push their demand, and the solve refuses the pair.
export function recHeldLitPlaceAdopt(l: i32) {
  cwIxBuild()
  if l < 0 || !cwIxCovers(l) || cwIxUpKind[l] != CW_UP_LETINIT { return 0 }
  const d = cwIxUp[l]
  const written = recCoalesceHeldLit(d) != l
  if written && recWrittenLetLit(d) != l { return 0 }
  const own = nodeTyIxOf(l)
  const ats: i32[] = []
  const reps: i32[] = []
  const w = cwOccWalk(d)
  while cwOccNext(w) {
    const u = if cwIxKind[w.row] == CW_OCC_USE { cwIxNode[w.row] } else { -1 }
    const b = if u >= 0 { recLitPlaceBuiltTy(u) } else { -1 }
    if b >= 0 && own >= 0 && !tySame(b, own) && tyAt(b) is TyObj {
      ats.push(u)
      reps.push(b)
    }
  }
  let i = 0
  while i < ats.length {
    if written {
      recHeldLetWritesAt(d, l, reps[i], ats[i], ats)
    } else if recAsgBindInit(ats[i]) >= 0 {
      recHeldAsgStamp(d, reps[i], ats[i], ats)
    } else {
      recHeldBindAdopt(d, reps[i], ats[i], ats)
    }
    i = i + 1
  }
  0
}

// Builds the fresh list `const` list literal `l` initialises, where a read of it is spread into a
// push whose receiver's elements are built at a record, with its elements at that record, as an
// element read delivered there adopts it, refusing its other own-storage deliveries (D15287).
export function recHeldListSpreadAdopt(l: i32) {
  cwIxBuild()
  if l < 0 || !cwIxCovers(l) || cwIxUpKind[l] != CW_UP_LETINIT { return 0 }
  const d = cwIxUp[l]
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letKw != "const" { return 0 }
  const own = nodeTyIxOf(l)
  const ot = if own >= 0 && own < T.tys.length { tyAt(own) } else { null }
  const oe = if ot is TyArray { ot.aElem } else { -1 }
  if oe < 0 || oe >= T.tys.length { return 0 }
  const oo = tyAt(oe)
  // A list of record lists is built by its literal's stamp at the receiver's (D15370).
  const nested = oo is TyArray
    && oo.aElem >= 0
    && oo.aElem < T.tys.length
    && tyAt(oo.aElem) is TyObj
  if !(oo is TyObj) && !nested { return 0 }
  const w = cwOccWalk(d)
  while cwOccNext(w) {
    const u = if cwIxKind[w.row] == CW_OCC_USE { cwIxNode[w.row] } else { -1 }
    const sp = if u >= 0 && cwIxCovers(u) { cwIxUp[u] } else { -1 }
    const r = if sp >= 0 && nodeAt(sp) is Spread { recSlotReceiverOf(sp, u) } else { -1 }
    if nested {
      const ie = if r >= 0 { recElemOfElemStamp(r) } else { -1 }
      if (
        ie >= 0
        && ie < T.tys.length
        && tyAt(ie) is TyObj
        && oo is TyArray
        && !tySame(ie, oo.aElem)
      ) {
        const lt = mkArrayTy(mkArrayTy(ie))
        adoptLitAt(l, lt)
        recHeldOwnRefuse(d, lt, u, [u])
      }
    } else {
      const e = if r >= 0 { recHeldElemBuilt(r) } else { -1 }
      if e >= 0 && e < T.tys.length && tyAt(e) is TyObj && !tySame(e, oe) {
        recAdPushDecl(d, oe, e, true, u)
        recHeldOwnRefuse(d, e, u, [u])
      }
    }
  }
  0
}

// The list a record literal `p` is pushed, unshifted or index-stored into, or a list literal `p`
// is spread into a push of, peeled; else -1.
function recLitSlotReceiver(p: i32): i32 {
  cwIxBuild()
  if !(nodeAt(p) is ArrayLit) { return recSlotReceiverOf(p, p) }
  const a = if p >= 0 && cwIxCovers(p) { cwIxUp[p] } else { -1 }
  if a < 0 || a >= P.nodes.length || !(nodeAt(a) is Spread) { return -1 }
  recSlotReceiverOf(a, p)
}

// The list value `x` (the literal `p` itself, or a spread of it) is pushed, unshifted or
// index-stored into, peeled; else -1.
function recSlotReceiverOf(x: i32, p: i32): i32 {
  const a = if x >= 0 && cwIxCovers(x) { cwIxUp[x] } else { -1 }
  const an = if a >= 0 && a < P.nodes.length { nodeAt(a) } else { null }
  if an is Call && an.callFn >= 0 && i32ListHas(an.callArgs, x) {
    const f = nodeAt(an.callFn)
    if f is Member && (f.memProp == "push" || f.memProp == "unshift") {
      return cwPeelValue(f.memObj)
    }
    return -1
  }
  if (
    x == p
    && an is BinExpr
    && an.binOp == "="
    && cwPeelValue(an.binRight) == p
  ) {
    const l = nodeAt(an.binLeft)
    if l is Index { return cwPeelValue(l.idxArr) }
  }
  -1
}

// The record the elements of the list `x` reads are built at: its own recorded build, an element
// of a built list of lists, or, for an un-annotated binding, its initialiser's; else -1.
export function recHeldElemBuilt(x: i32): i32 {
  const e = recBuiltElemOf(x)
  if e >= 0 || x < 0 || x >= P.nodes.length { return e }
  const xn = nodeAt(x)
  // An element of a list of lists is read at its literal's build, one level in (D15236).
  if xn is Index { return recElemOfElemStamp(cwPeelValue(xn.idxArr)) }
  // A list literal whose records its parts built elsewhere holds them at its stamp (D15232).
  if xn is ArrayLit {
    const rt = nodeRepTyIxOf(x)
    const ro = if rt >= 0 && rt < T.tys.length { tyAt(rt) } else { null }
    const re = if ro is TyArray { ro.aElem } else { -1 }
    const ot = tyArrayElemIx(nodeTyIxOf(x))
    const stamped = re >= 0 && re < T.tys.length && tyAt(re) is TyObj
    return if stamped && !(ot >= 0 && tySame(re, ot)) { re } else { -1 }
  }
  if !(xn is Ident) { return -1 }
  const d = recBindDeclOf(x)
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return -1 }
  recHeldElemBuilt(cwPeelValue(dn.letInit))
}

// The record element read `x` (`xs[i]`) is built at, from the rep stamp of the list literal
// `xs`'s binding is initialised with, where that is another record than its own; else -1.
function recElemReadStampTy(x: i32): i32 {
  const n = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
  if !(n is Index) { return -1 }
  const a = cwPeelValue(n.idxArr)
  if a < 0 || a >= P.nodes.length || !(nodeAt(a) is Ident) { return -1 }
  const d = recBindDeclOf(a)
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return -1 }
  const iv = cwPeelValue(dn.letInit)
  if iv < 0 || iv >= P.nodes.length || !(nodeAt(iv) is ArrayLit) { return -1 }
  const rt = nodeRepTyIxOf(iv)
  const ro = if rt >= 0 && rt < T.tys.length { tyAt(rt) } else { null }
  const e = if ro is TyArray { ro.aElem } else { -1 }
  const own = nodeTyIxOf(x)
  if (
    e < 0
    || e >= T.tys.length
    || !(tyAt(e) is TyObj)
    || (own >= 0 && tySame(e, own))
  ) {
    return -1
  }
  e
}

// The record the elements of an element of the list binding read `a` are built at, from its
// list literal initialiser's rep stamp (`T[][]`), through bindings of bindings; else -1.
export function recElemOfElemStamp(a: i32): i32 {
  if a < 0 || a >= P.nodes.length || !(nodeAt(a) is Ident) { return -1 }
  const d = recBindDeclOf(a)
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return -1 }
  const iv = cwPeelValue(dn.letInit)
  // A binding of another such binding reads that one's literal.
  if iv >= 0 && iv < P.nodes.length && nodeAt(iv) is Ident {
    return recElemOfElemStamp(iv)
  }
  const rt = nodeRepTyIxOf(iv)
  const ro = if rt >= 0 && rt < T.tys.length { tyAt(rt) } else { null }
  const it = if ro is TyArray { ro.aElem } else { -1 }
  const io = if it >= 0 && it < T.tys.length { tyAt(it) } else { null }
  if io is TyArray { io.aElem } else { -1 }
}

// The initialiser of the un-annotated binding `p` is assigned into, peeled, where `p` is the
// assigned value or one of its `if` or `match` arm leaves (`tailValueLeaves`, D15280); else -1.
export function recAsgBindInit(p: i32): i32 {
  const d = recAsgBindDecl(p)
  const dn = if d >= 0 { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return -1 }
  cwPeelValue(dn.letInit)
}

// The record a record literal `p` written whole into a binding the field widener widened, a field
// or element slot of one, or pushed onto a list one roots or whose element widens only its
// function fields, is built at (D15306, D15307, D15336); else -1.
export function recAsgFnWidenedTy(p: i32): i32 {
  if p < 0 || p >= P.nodes.length || !(nodeAt(p) is ObjLit) { return -1 }
  // The place, a binding or a field or element slot of one, and the binding it is rooted at;
  // `steps` is the slot's path from the place inward.
  let x = recAsgPlaceOf(p)
  // A literal pushed onto a list is a write of one of its elements (D15336).
  const pushed = x < 0
  if pushed { x = recLitPushReceiverOf(p) }
  const steps: string[] = []
  let hops = 0
  while x >= 0 && x < P.nodes.length && hops < 16 {
    const xn = nodeAt(x)
    if xn is Member {
      steps.push(xn.memProp)
      x = cwPeelValue(xn.memObj)
    } else if xn is Index {
      steps.push("")
      x = cwPeelValue(xn.idxArr)
    } else {
      hops = 16
    }
    hops = hops + 1
  }
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return -1 }
  const d = recBindDeclOf(x)
  const dn = if d >= 0 { nodeAt(d) } else { null }
  const widened = elabFnFieldWidenedAny(d)
  if (
    !(dn is LetDecl)
    || dn.letType >= 0
    || dn.letInit < 0
    || !widened && !pushed
  ) {
    return -1
  }
  // A holder of a tagged set's ids is built at the rep the tag stamped on it (D15350).
  const held = fnTagHeldRepOf(d)
  let t = if held >= 0 { held } else { nodeTyIxOf(d) }
  let k = steps.length - 1
  while k >= 0 {
    const st = steps[k]
    k = k - 1
    const tt = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
    t = if st == "" && tt is TyArray { tt.aElem } else if st != "" && tt is TyObj { tyFieldTyOf(t, st) } else { -1 }
  }
  if pushed {
    const lt = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
    t = if lt is TyArray { lt.aElem } else { -1 }
  }
  // A list no write widened takes a pushed literal at its element only where the two differ in
  // function fields alone, each element field a closed type or another set.
  if !widened && !recFnFieldsWiden(nodeTyIxOf(p), t) { return -1 }
  if t >= 0 && t < T.tys.length && tyAt(t) is TyObj { t } else { -1 }
}

// Whether record `w` is record `own` with at least one function field holding a set that `w`'s
// field holds another set at or closes, and every other field the same.
export function recFnFieldsWiden(own: i32, w: i32): boolean {
  if own < 0 || w < 0 || own >= T.tys.length || w >= T.tys.length {
    return false
  }
  const o = tyAt(own)
  const t = tyAt(w)
  if (
    !(o is TyObj)
    || !(t is TyObj)
    || o.objFieldNames.length != t.objFieldNames.length
  ) {
    return false
  }
  let wider = false
  let i = 0
  while i < o.objFieldNames.length && i < o.objFieldTypes.length {
    const k = strListIndexOf(t.objFieldNames, o.objFieldNames[i])
    if k < 0 || k >= t.objFieldTypes.length { return false }
    const of = o.objFieldTypes[i]
    const tf = t.objFieldTypes[k]
    // Two sets' types spell alike, so a function field is compared by its set.
    if fnTagSetOfTy(of) >= 0 {
      if !recFnSetWidens(of, tf) { return false }
      if fnTagSetOfTy(tf) != fnTagSetOfTy(of) { wider = true }
    } else if !tySame(of, tf) {
      return false
    }
    i = i + 1
  }
  wider
}

// Whether function type `wf` takes a value of set-carrying `of`: a closed type, or another set,
// which the list's later writes join.
function recFnSetWidens(of: i32, wf: i32): boolean {
  if (
    fnTagSetOfTy(of) < 0
    || wf < 0
    || wf >= T.tys.length
    || !(tyAt(wf) is TyFunc)
  ) {
    return false
  }
  fnTagSetOfTy(wf) >= 0 || !tyHasTyVar(wf) && !tyReachesHole(wf, 8)
}

// The list a record literal `p` is pushed onto, peeled; else -1.
function recLitPushReceiverOf(p: i32): i32 {
  cwIxBuild()
  const a = if p >= 0 && cwIxCovers(p) { cwIxUp[p] } else { -1 }
  const an = if a >= 0 && a < P.nodes.length { nodeAt(a) } else { null }
  if !(an is Call) || an.callFn < 0 || !i32ListHas(an.callArgs, p) { return -1 }
  const f = nodeAt(an.callFn)
  if f is Member && f.memProp == "push" { cwPeelValue(f.memObj) } else { -1 }
}

// The un-annotated binding a literal or read `p` is assigned whole into, through `if` arms; -1
// when it is no such value.
function recAsgBindDecl(p: i32): i32 {
  const l = recAsgPlaceOf(p)
  if l >= 0 && nodeAt(l) is Ident { recBindDeclOf(l) } else { -1 }
}

// The place a literal or read `p` is assigned whole into, through `if` arms; -1 when it is no
// such value.
function recAsgPlaceOf(p: i32): i32 {
  cwIxBuild()
  let x = p
  let hops = 0
  while x >= 0 && cwIxCovers(x) && cwIxUpKind[x] == CW_UP_ARM && hops < 16 {
    x = cwIxUp[x]
    hops = hops + 1
  }
  const a = if x >= 0 && cwIxCovers(x) { cwIxUp[x] } else { -1 }
  const an = if a >= 0 && a < P.nodes.length { nodeAt(a) } else { null }
  if (!(an is BinExpr) || an.binOp != "=" || cwPeelValue(an.binRight) != x) {
    return -1
  }
  const leaves: i32[] = []
  tailValueLeaves(an.binRight, leaves)
  if !i32ListHas(leaves, p) { return -1 }
  an.binLeft
}

// Whether `p` is `read ?? { … }` handed to a parameter that takes the rep `rep`; the literal is
// then built at `rep`, so the whole value is one record of it.
function recCoalesceLitBuilt(p: i32, rep: i32): boolean {
  if recCoalesceLitOf(p, rep) < 0 { return false }
  if !recArgTakesRep(p, 4) && !recAnnArgTakesRep(p, rep) { return false }
  recCoalesceLitAdopt(p, rep)
}

// Builds the record literal that `p`, a `read ?? { … }`, defaults to at the record `rep`; false,
// building nothing, where `p` is no such value. The store column builds an un-annotated
// binding of one there (D15230), as `recCoalesceLitBuilt` does an argument.
export function recCoalesceLitAdopt(p: i32, rep: i32): boolean {
  const lit = recCoalesceLitOf(p, rep)
  if lit < 0 { return false }
  recordRepTyAdopt(lit, rep, 6)
  true
}

// Delivers the default of `p`, a `read ?? d`, at the record `rep` as a typed delivery of `d`
// there does (`recAdoptNote`), or builds a `const` there (D15248, D15249, D15310). False when `d`
// is no record of another row.
export function recCoalesceDefaultDeliver(p: i32, rep: i32): boolean {
  const n = nodeAt(p)
  if !(n is BinExpr) || n.binOp != "??" || rep < 0 || rep >= T.tys.length {
    return false
  }
  const v = cwPeelValue(n.binRight)
  if v < 0 || v >= P.nodes.length || !(tyAt(rep) is TyObj) { return false }
  const own = nodeTyIxOf(v)
  if (
    own < 0
    || own >= T.tys.length
    || !(tyAt(own) is TyObj)
    || tySame(own, rep)
  ) {
    return false
  }
  const d = if nodeAt(v) is Ident { recHeldDecl(v) } else { -1 }
  // A fresh `const` literal keeps its own type and is built at `rep`, so the join stays one record
  // (D15310); one record cannot also be delivered at its own storage, so those are refused.
  if recCoalesceDefaultBuilt(p) {
    recBuildPush(d, own, rep, false)
    recHeldOwnRefuse(d, rep, p, recCoalesceDefaultsAt(d, rep))
    return true
  }
  // A `const` of a call whose result reads back from `rep` is adopted there with its function,
  // which its other calls share (D15240).
  const init = recCoalesceHeldInit(d)
  if init >= 0 && recNullWidened(own, rep, false) {
    recHeldBindAdopt(d, rep, p, [p, v])
    return true
  }
  recAdoptNote(v, own, rep)
  true
}

// Whether `p`, a `??`, defaults to a binding of a fresh `const` record literal, which the general
// arm builds at the read's record while it keeps its own type, so the join is one record. False
// for a `let` or a `const` of a call, which the record solve adopts at the read's record instead.
export function recCoalesceDefaultBuilt(p: i32): boolean {
  const n = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
  if !(n is BinExpr) || n.binOp != "??" { return false }
  const v = cwPeelValue(n.binRight)
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return false }
  recCoalesceHeldLit(recHeldDecl(v)) >= 0
}

// Every read of the binding `d` that defaults a `??` over a read built at the record `rep`, and
// that `??`: each delivers `d` at `rep`, so none of them is a delivery at its own storage.
function recCoalesceDefaultsAt(d: i32, rep: i32): i32[] {
  cwIxBuild()
  const out: i32[] = []
  const w = cwOccWalk(d)
  while cwOccNext(w) {
    const u = if cwIxKind[w.row] == CW_OCC_USE { cwIxNode[w.row] } else { -1 }
    const q = if u >= 0 && cwIxCovers(u) && cwIxUpKind[u] == CW_UP_COAL { cwIxUp[u] } else { -1 }
    const qn = if q >= 0 && q < P.nodes.length { nodeAt(q) } else { null }
    if qn is BinExpr && cwPeelValue(qn.binRight) == u {
      const b = recBuiltReadTy(q)
      if b >= 0 && fieldStorageEq(nonNullTy(b), rep, REC_STORE_DEPTH) {
        out.push(u)
        out.push(q)
      }
    }
  }
  out
}

// Whether every read of the binding `d` defaults a `??` over a read built at the record `rep`
// (`recCoalesceDefaultsAt`). Narrow on purpose: with an own-type delivery the pin's refusal is
// what stops invalid wasm, and an unscoped hand-on broke a maker also called at its own (D15311).
function recUsedOnlyAsDefaultAt(d: i32, rep: i32): boolean {
  cwIxBuild()
  let uses = 0
  const w = cwOccWalk(d)
  while cwOccNext(w) {
    if cwIxKind[w.row] == CW_OCC_USE { uses = uses + 1 }
  }
  uses > 0 && uses * 2 == recCoalesceDefaultsAt(d, rep).length
}

// Whether inferred function `fd` hands back another inferred function's call: a returned value is
// such a call, or a binding holding one. False for -1 and for a maker of its own literal.
// The maker whose call every value maker `fd` hands back is, following such hand-ons up to
// `depth`; else -1. A delivery of `fd`'s call delivers that maker's record (D15380).
export function recHandOnMakerOf(fd: i32, depth: i32): i32 {
  if fd < 0 || fd >= P.nodes.length || depth <= 0 || !(nodeAt(fd) is FuncDecl) {
    return -1
  }
  let to = -1
  for lf in recFnValueLeaves(fd) {
    const v = cwPeelValue(lf)
    const c = if v >= 0 && v < P.nodes.length && nodeAt(v) is Call { recInferredFnOf(v) } else { -1 }
    if c < 0 || c == fd || to >= 0 && c != to { return -1 }
    to = c
  }
  if to < 0 { return -1 }
  const next = recHandOnMakerOf(to, depth - 1)
  if next >= 0 { next } else { to }
}

// Whether `u` is a `??` default whose left read is built at a record storing as `dst`: the
// default is delivered there, not at its own type (D15317).
export function recCoalLandsAt(u: i32, dst: i32): boolean {
  cwIxBuild()
  const p = if cwIxCovers(u) { cwIxUp[u] } else { -1 }
  const pn = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
  if !(pn is BinExpr) || pn.binOp != "??" || cwPeelValue(pn.binRight) != u {
    return false
  }
  const bt = recBuiltReadTy(pn.binLeft)
  bt >= 0 && dst >= 0 && fieldStorageEq(nonNullTy(bt), dst, REC_STORE_DEPTH)
}

function recMakerHandsOnCall(fd: i32): boolean {
  if fd < 0 || fd >= P.nodes.length { return false }
  for lf in recFnValueLeaves(fd) {
    const v = cwPeelValue(lf)
    if (
      v >= 0
      && v < P.nodes.length
      && nodeAt(v) is Call
      && recInferredFnOf(v) >= 0
    ) {
      return true
    }
    if v >= 0 && v < P.nodes.length && nodeAt(v) is Ident {
      const c = recHeldCallOrigin(v)
      if (
        c >= 0
        && c < P.nodes.length
        && nodeAt(c) is Call
        && recInferredFnOf(c) >= 0
      ) {
        return true
      }
    }
  }
  false
}

// Builds the fresh record `const` `d` at the record `rep` where `p` delivers it, refusing each
// delivery of `d` at its own storage outside `skip`, since one record cannot be both.
function recHeldBindAdopt(d: i32, rep: i32, p: i32, skip: i32[]): boolean {
  const init = recCoalesceHeldInit(d)
  // A call's function is built at `rep` too, as a delivery of the call there builds it (D15240).
  if init >= 0 && init < P.nodes.length && nodeAt(init) is Call {
    recAdoptNote(init, nodeTyIxOf(init), rep)
    // A maker handing back another maker's call is built at `rep` down the chain by that
    // delivery; adopting the binding as well declines the hand-on, so it is not (D15311).
    if (
      recMakerHandsOnCall(recInferredFnOf(init))
      && recUsedOnlyAsDefaultAt(d, rep)
    ) {
      return recHeldOwnRefuse(d, rep, p, skip)
    }
  }
  recAdPushDecl(d, nodeTyIxOf(init), rep, false, p)
  recHeldOwnRefuse(d, rep, p, skip)
}

// Builds the fresh record `const` `d`, assigned by `p` into a binding held at the record `rep`, by
// stamping its literal there; its type stays, so each delivery of it at its own storage outside
// `skip` is refused. False, building nothing, where `d` holds no fresh literal (D15238).
function recHeldAsgStamp(d: i32, rep: i32, p: i32, skip: i32[]): boolean {
  const l = recCoalesceHeldLit(d)
  if l < 0 { return false }
  adoptLitAt(l, rep)
  recHeldOwnRefuse(d, rep, p, skip)
}

// Builds the fresh record `const` that list literal part `p` reads at the record `rep` the list's
// other parts are built at, refusing its other deliveries at its own storage (D15372). False where
// `p` reads no such binding.
export function recHeldLitPartStamp(p: i32, rep: i32): boolean {
  if !(nodeAt(p) is Ident) { return false }
  const d = recHeldDecl(p)
  d >= 0 && recCoalesceHeldLit(d) >= 0 && recHeldAsgStamp(d, rep, p, [p])
}

function recHeldOwnRefuse(d: i32, rep: i32, p: i32, skip: i32[]): boolean {
  // The store column runs after `recKeptConflicts`, so `d`'s own-storage deliveries are refused here,
  // unless `d` is kept, whose deliveries that pass already refused: one refusal per delivery.
  if i32ListHas(recKeptDecl, d) { return true }
  for u in recOwnSrc {
    const pu = cwPeelValue(u)
    const o = if i32ListHas(skip, pu) || recOwnPinSkip(u) { -1 } else { recFreshOriginDecl(u, 6) }
    if o == d && recArgRepOf(u) < 0 {
      recAdRaising = true
      tErr(recKeptOwnMsg(d, rep, p, false), u)
      recAdRaising = false
    }
  }
  true
}

// Whether own-storage delivery `u` reads a binding that holds its own copy of a call built wider
// (`recCopyFromOf`): the value it hands on is at its own row (D15267).
export function recOwnHoldsCopy(u: i32): boolean {
  const p = cwPeelValue(u)
  const hd = if p >= 0 && nodeAt(p) is Ident { recHeldDecl(p) } else { -1 }
  const hn = if hd >= 0 { nodeAt(hd) } else { nodeAt(0) }
  hn is LetDecl
    && hn.letInit >= 0
    && recCopyFromOf(parenPeelIx(hn.letInit)) >= 0
}

// Whether own-storage delivery `u` is left to the pins: it is, or sits in a literal that is, an
// argument to a generic, and is a call or reaches a type parameter the call binds at a type that
// does not store as `u`'s own (D15180).
export function recOwnPinSkip(u: i32): boolean {
  const x = recArgOfReach(u)
  if x < 0 || !recOwnIsPin(x) { return false }
  if nodeAt(u) is Call { return true }
  const pt = recReachPinTy(u)
  pt < 0 || !fieldStorageEq(pt, nodeTyIxOf(u), REC_STORE_DEPTH)
}

// D15180's refusal of a value `d` built as `dst` where `at` delivers it, handed on at its own type
// elsewhere; `inst` where `at` is that delivery itself, at one instance of the generic around it.
export function recKeptOwnMsg(
  d: i32,
  dst: i32,
  at: i32,
  inst: boolean,
): string {
  let how = " where line "
    + i32ToStr(nodeLineOf(at))
    + " delivers it, and it is handed on here at its own type"
  if inst {
    how = " by this delivery at one instance of the generic function around it, and "
      + "kept at its own type at another"
  }
  recKeptWhat(d)
    + " is built as "
    + tyToStr(dst)
    + how
    + ", which stores a field differently; a record is shared, not copied, so one "
    + "value cannot be both. Annotate it with one of the types, and copy it with an "
    + "object literal for the other"
}

// What an un-annotated `const` `d` holds fresh: its record literal, or a call of an inferred
// function, whose result `recFnBuiltAtDst` can build elsewhere; else -1.
function recCoalesceHeldInit(d: i32): i32 {
  const lit = recCoalesceHeldLit(d)
  if lit >= 0 { return lit }
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if (
    !(dn is LetDecl)
    || dn.letType >= 0
    || dn.letKw != "const"
    || dn.letInit < 0
  ) {
    return -1
  }
  const c = cwPeelValue(dn.letInit)
  if c >= 0 && nodeAt(c) is Call && recInferredFnOf(c) >= 0 { c } else { -1 }
}

// The fresh record literal an un-annotated `let` `d` that is reassigned is initialised with,
// else -1 (D15374).
function recWrittenLetLit(d: i32): i32 {
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if (
    !(dn is LetDecl)
    || dn.letType >= 0
    || dn.letKw != "let"
    || dn.letInit < 0
  ) {
    return -1
  }
  const lit = cwPeelValue(dn.letInit)
  if lit >= 0 && lit < P.nodes.length && nodeAt(lit) is ObjLit {
    lit
  } else {
    -1
  }
}

// Builds the reassigned fresh record `let` `d`, initialised with literal `l` and delivered at `p`
// into a place held at the record `rep`, there: every record literal written into it is stamped
// at `rep`, a value held at its own storage written into it is refused, and each delivery of it
// at its own storage outside `skip` is refused (D15374).
function recHeldLetWritesAt(
  d: i32,
  l: i32,
  rep: i32,
  p: i32,
  skip: i32[],
): boolean {
  adoptLitAt(l, rep)
  const w = cwOccWalk(d)
  while cwOccNext(w) {
    const a = if cwIxKind[w.row] == CW_OCC_ASG { cwIxNode[w.row] } else { -1 }
    const an = if a >= 0 && a < P.nodes.length { nodeAt(a) } else { null }
    const leaves: i32[] = []
    if an is BinExpr && an.binOp == "=" { tailValueLeaves(an.binRight, leaves) }
    for v in leaves {
      if nodeAt(v) is ObjLit {
        adoptLitAt(v, rep)
      } else {
        const vt = nodeTyIxOf(v)
        // A read its container builds at `rep` is already stored there.
        const vb = recBuiltReadTy(v)
        const held = vb >= 0
          && fieldStorageEq(nonNullTy(vb), rep, REC_STORE_DEPTH)
        if vt >= 0 && !held && !fieldStorageEq(vt, rep, REC_STORE_DEPTH) {
          recAdRaising = true
          tErr(
            recKeptWhat(d)
              + " is built as "
              + tyToStr(rep)
              + " where line "
              + i32ToStr(nodeLineOf(p))
              + " delivers it, and this value of its own type is assigned into it, which stores a "
              + "field differently; a record is shared, not copied. Copy it with an object literal",
            v,
          )
          recAdRaising = false
        }
      }
    }
  }
  recHeldOwnRefuse(d, rep, p, skip)
}

// The fresh record literal an un-annotated `const`, or `let` nothing reassigns, `d` is
// initialised with, else -1.
function recCoalesceHeldLit(d: i32): i32 {
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return -1 }
  // A `let` nothing reassigns holds its literal as a `const` does; the index is built first, so
  // the answer does not hang on whether a reader before this one built it (D15283).
  if dn.letKw != "const" {
    cwIxBuild()
    if !cwLetUnwritten(d) { return -1 }
  }
  const lit = cwPeelValue(dn.letInit)
  if lit >= 0 && nodeAt(lit) is ObjLit { lit } else { -1 }
}

// The record literal `p`, a `??`, defaults to where `rep` is a record; else -1.
function recCoalesceLitOf(p: i32, rep: i32): i32 {
  const n = nodeAt(p)
  if !(n is BinExpr) || n.binOp != "??" { return -1 }
  const lit = cwPeelValue(n.binRight)
  if (
    lit < 0
    || !(nodeAt(lit) is ObjLit)
    || rep < 0
    || rep >= T.tys.length
    || !(tyAt(rep) is TyObj)
  ) {
    return -1
  }
  lit
}

// Whether `x` is an argument whose parameter takes its rep (`recParamTakesRep`), up to `depth`
// hand-ons; the callee is instanced at the argument's type and stores it at its build (D14532).
function recArgTakesRep(x: i32, depth: i32): boolean {
  if depth <= 0 || x < 0 { return false }
  // Built here, not trusted to be: on an unbuilt index the answer would depend on whether an
  // earlier query happened to build it (D15373).
  cwIxBuild()
  if !cwIxCovers(x) || cwIxUpKind[x] != CW_UP_ARG { return false }
  const c = nodeAt(cwIxUp[x])
  if !(c is Call) || c.callFn < 0 { return false }
  const fd = identBoundFnDeclOf(c.callFn)
  if fd < 0 || fd >= P.nodes.length { return false }
  const f = nodeAt(fd)
  const i = cwIxUpAux[x]
  if !(f is FuncDecl) || i < 0 || i >= f.fnParams.length { return false }
  recParamTakesRep(f.fnParams[i], cwIxUp[x], depth)
    || recListParamTakesRep(f.fnParams[i], cwIxUp[x], depth)
}

// Whether parameter `par`, a list of a type variable or a hole, is only read for its length or for
// elements `recParamTakesRep` would take: read for a field, handed on by rep, or handed back to a
// `call` that reads the rep (D14733).
function recListParamTakesRep(par: i32, call: i32, depth: i32): boolean {
  const pt = nodeTyIxOf(par)
  if pt < 0 || pt >= T.tys.length { return false }
  const pa = tyAt(pt)
  if !(pa is TyArray) || pa.aElem < 0 || !(tyAt(pa.aElem) is TyVar) {
    return false
  }
  cwIxBuild()
  const owner = if cwIxCovers(par) { cwIxParent[par] } else { -1 }
  if owner < 0 || !(nodeAt(owner) is FuncDecl) { return false }
  let used = false
  const ow = cwOccWalk(par)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_USE {
      const u = cwIxNode[r]
      if (
        !(recElemTakesRep(u, owner, call, depth - 1)
          || recListRetTakesRep(u, owner, call, depth - 1))
        || recEnclosingFn(u) != owner
      ) {
        return false
      }
      used = true
    } else if cwIxKind[r] != CW_OCC_BIND || cwIxNode[r] != par {
      return false
    }
  }
  used
}

// Whether list read `u` is the object of `.length`, or of an index read whose element takes the rep.
function recElemTakesRep(u: i32, fd: i32, call: i32, depth: i32): boolean {
  if u < 0 || !cwIxCovers(u) || cwIxUpKind[u] != CW_UP_OBJ { return false }
  const e = cwIxUp[u]
  if e < 0 || e >= P.nodes.length { return false }
  const en = nodeAt(e)
  if en is Member { return en.memProp == "length" && recFieldRead(u) }
  if !(en is Index) { return false }
  recFieldRead(e)
    || recArgTakesRep(e, depth)
    || recRetTakesRep(e, fd, call, depth)
    || (fd >= 0 && recConstFieldUses(e) >= 0)
}

// Whether parameter `par`, open in a type variable or a hole, is only read or written for a field,
// handed to another such parameter, or returned where `call`'s result is used the same way: the
// positions that read a value at a rep wider than its type.
function recParamTakesRep(par: i32, call: i32, depth: i32): boolean {
  const pt = nodeTyIxOf(par)
  if pt < 0 || pt >= T.tys.length || !(tyAt(pt) is TyVar) { return false }
  cwIxBuild()
  const owner = if cwIxCovers(par) { cwIxParent[par] } else { -1 }
  if owner < 0 || !(nodeAt(owner) is FuncDecl) { return false }
  let used = false
  const ow = cwOccWalk(par)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_USE {
      const u = cwIxNode[r]
      if (
        !recFieldRead(u)
        && !recArgTakesRep(u, depth - 1)
        && !recRetTakesRep(u, owner, call, depth - 1)
      ) {
        return false
      }
      // A use a nested function captures reads the value where the capture stores it.
      if recEnclosingFn(u) != owner { return false }
      used = true
    } else if cwIxKind[r] != CW_OCC_BIND || cwIxNode[r] != par {
      return false
    }
  }
  used
}

// Whether `u` is a value function `fd` hands back, and `call`, the call it hands it back to, uses
// the result only where the rep is read: for a field, as another such argument, or through a
// `const` read only for fields.
function recRetTakesRep(u: i32, fd: i32, call: i32, depth: i32): boolean {
  if depth <= 0 || call < 0 || call >= P.nodes.length { return false }
  let leaf = false
  for lf in recFnValueLeaves(fd) {
    if cwPeelValue(lf) == u { leaf = true }
  }
  if !leaf { return false }
  recFieldRead(call)
    || recArgTakesRep(call, depth)
    || recBoundForFields(call)
    || recInReadOnlyList(call, depth)
    || recIdentityReadsBuilt(call)
}

// Whether `call` hands back its argument, a read out of a built container: the call is then read
// as that read, and its own delivery is judged where it lands (D14819).
function recIdentityReadsBuilt(call: i32): boolean {
  const ia = recIdentityArgOf(call)
  ia >= 0 && recBuiltReadTy(cwPeelValue(ia)) >= 0
}

// The argument call `x` hands back: a hole function's identity, or a generic's sole-pin one; -1
// otherwise.
function recIdentityArgOf(x: i32): i32 {
  const c = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
  if !(c is Call) || c.callFn < 0 { return -1 }
  const ha = recHoleIdentityArg(x, identBoundFnDeclOf(c.callFn))
  if ha >= 0 { ha } else { recSolePinArg(x) }
}

// Whether `x` is an element of a list literal that initialises an un-annotated `const` read only
// for its length or for an element's field: the list is built at its elements' rep (D14811).
function recInReadOnlyList(x: i32, depth: i32): boolean {
  if x < 0 || !cwIxCovers(x) || cwIxUpKind[x] != CW_UP_ELEM { return false }
  const l = cwIxUp[x]
  if l < 0 || !cwIxCovers(l) || !(nodeAt(l) is ArrayLit) { return false }
  if cwIxUpKind[l] != CW_UP_LETINIT { return false }
  recReadOnlyListDecl(cwIxUp[l], depth)
}

// Whether list `u` is handed back whole by function `fd` to `call`, its only call, whose result
// is read only for its length or for an element's field, directly or through an un-annotated
// `const`. A second call could share the instance at another storage (D14813).
function recListRetTakesRep(u: i32, fd: i32, call: i32, depth: i32): boolean {
  if depth <= 0 || call < 0 || call >= P.nodes.length { return false }
  const sites: i32[] = []
  if rcwCallSites(fd, sites) >= 0 || sites.length != 1 || sites[0] != call * 2 {
    return false
  }
  let leaf = false
  for lf in recFnValueLeaves(fd) {
    if cwPeelValue(lf) == u { leaf = true }
  }
  if !leaf { return false }
  if recElemTakesRep(call, -1, -1, depth) { return true }
  if !cwIxCovers(call) || cwIxUpKind[call] != CW_UP_LETINIT { return false }
  recReadOnlyListDecl(cwIxUp[call], depth)
}

// Whether `d` is an un-annotated `const` list read only for its length or an element's field.
function recReadOnlyListDecl(d: i32, depth: i32): boolean {
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letKw != "const" { return false }
  let used = false
  const ow = cwOccWalk(d)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_USE {
      if !recElemTakesRep(cwIxNode[r], -1, -1, depth - 1) { return false }
      used = true
    } else if cwIxKind[r] != CW_OCC_BIND || cwIxNode[r] != d {
      return false
    }
  }
  used
}

// Whether `x` initialises an un-annotated `const` that is only read for a field.
function recBoundForFields(x: i32): boolean { recConstFieldUses(x) > 0 }

// How many reads the un-annotated `const` that `x` initialises has, where each one is for a field;
// -1 when `x` initialises no such `const` or a read is not for a field.
function recConstFieldUses(x: i32): i32 {
  if x < 0 || !cwIxCovers(x) || cwIxUpKind[x] != CW_UP_LETINIT { return -1 }
  const d = cwIxUp[x]
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letKw != "const" { return -1 }
  let used = 0
  const ow = cwOccWalk(d)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_USE {
      if !recFieldRead(cwIxNode[r]) { return -1 }
      used = used + 1
    } else if cwIxKind[r] != CW_OCC_BIND || cwIxNode[r] != d {
      return -1
    }
  }
  used
}

// Whether `x` is an argument of a non-generic function whose annotated parameter, a narrower record
// over `rep`'s fields or a list of one, is only read or written for a field (an element's, for a
// list) in its own body; noted with `recArgRepNote`, so the callee is instanced at `rep` (D14532).
function recAnnArgTakesRep(x: i32, rep: i32): boolean {
  if !recAnnArgRepOk(x, rep) { return false }
  const c = nodeAt(cwIxUp[x])
  const fd = if c is Call { identBoundFnDeclOf(c.callFn) } else { -1 }
  recArgRepNote(x, fd, rep)
  true
}

// `recAnnArgTakesRep` without noting the argument.
function recAnnArgRepOk(x: i32, rep: i32): boolean {
  if x < 0 || !cwIxCovers(x) || cwIxUpKind[x] != CW_UP_ARG { return false }
  const c = nodeAt(cwIxUp[x])
  if !(c is Call) || c.callFn < 0 { return false }
  const fd = identBoundFnDeclOf(c.callFn)
  if fd < 0 || fd >= P.nodes.length { return false }
  const f = nodeAt(fd)
  const i = cwIxUpAux[x]
  if (
    !(f is FuncDecl)
    || f.fnTyParams.length > 0
    || i < 0
    || i >= f.fnParams.length
  ) {
    return false
  }
  const par = f.fnParams[i]
  const pn = nodeAt(par)
  if !(pn is Param) || pn.parType < 0 { return false }
  const list = recListRepWider(nodeTyIxOf(par), rep)
  if !list && !recRepWider(nodeTyIxOf(par), rep) { return false }
  cwIxBuild()
  let used = false
  const ow = cwOccWalk(par)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_USE {
      const u = cwIxNode[r]
      const ok = if list { recElemFieldRead(u) } else { recFieldRead(u) }
      if !ok || recEnclosingFn(u) != fd { return false }
      used = true
    } else if cwIxKind[r] != CW_OCC_BIND || cwIxNode[r] != par {
      return false
    }
  }
  used
}

// Whether lists `narrow` and `wide` hold records `recRepWider` relates.
function recListRepWider(narrow: i32, wide: i32): boolean {
  if narrow < 0 || narrow >= T.tys.length || wide < 0 || wide >= T.tys.length {
    return false
  }
  const n = tyAt(narrow)
  const w = tyAt(wide)
  n is TyArray && w is TyArray && recRepWider(n.aElem, w.aElem)
}

// Whether list read `u` is only its length, or indexed and the element read for a field.
function recElemFieldRead(u: i32): boolean {
  if u < 0 || !cwIxCovers(u) || cwIxUpKind[u] != CW_UP_OBJ { return false }
  const up = cwIxUp[u]
  if up < 0 || up >= P.nodes.length { return false }
  const un = nodeAt(up)
  if un is Member { return un.memProp == "length" && recFieldRead(u) }
  un is Index && recFieldRead(up)
}

// Whether record `wide` is another record over the same field names as record `narrow`, which is
// assignable to it.
function recRepWider(narrow: i32, wide: i32): boolean {
  if narrow < 0 || narrow >= T.tys.length || wide < 0 || wide >= T.tys.length {
    return false
  }
  const n = tyAt(narrow)
  const w = tyAt(wide)
  if !(n is TyObj) || !(w is TyObj) || tySame(narrow, wide) { return false }
  if n.objFieldNames.length != w.objFieldNames.length { return false }
  for nm in n.objFieldNames {
    if strListIndexOf(w.objFieldNames, nm) < 0 { return false }
  }
  assignable(narrow, wide)
}

// The function declaration whose body holds node `x`, or -1.
export function recEnclosingFn(x: i32): i32 {
  let cur = if x >= 0 && cwIxCovers(x) { cwIxParent[x] } else { -1 }
  let guard = 0
  while cur >= 0 && cur < P.nodes.length && guard < 4096 {
    if nodeAt(cur) is FuncDecl { return cur }
    cur = if cwIxCovers(cur) { cwIxParent[cur] } else { -1 }
    guard = guard + 1
  }
  -1
}

// The capability refusal for `recBuiltReadRefuse`: `at` (typed `whole`) is, or with `elems` holds,
// `own` records its container stores at `built`; handing it on at its own type needs a copy.
function recBuiltReadErr(
  at: i32,
  whole: i32,
  own: i32,
  built: i32,
  elems: boolean,
) {
  const where = if elems { " elements are stored at " } else { " is stored at " }
  const whose = if elems { ", the row its stores build" } else { ", the row the stores into its container build" }
  tErrUnsupported(
    (if elems { "this container's " } else { "this " })
      + tyToStr(own)
      + where
      + tyToStr(built)
      + whose
      + "; handing it on as "
      + tyToStr(whole)
      + " is type-valid but not supported yet: field `"
      + recStorageFieldOf(own, built)
      + "` is stored differently there and no converting copy exists",
    at,
  )
}

// The element record the stores into the list or map binding `x` names build, else -1. This
// table wins: a list literal's rep stamp is read only where it has no row (`recHeldElemBuilt`,
// `recElemReadStampTy`), and both are written from the same parts' builds (D15232).
function recBuiltElemOf(x: i32): i32 { recBuiltElemIn(x, recBuildPassTable()) }

// `recBuiltElemOf` read from build table `tbl` (`recBuildPassTable` or `recBuildTable`).
function recBuiltElemIn(x: i32, tbl: Map<i32, i32>): i32 {
  const d = recHeldDecl(x)
  if d < 0 { -1 } else { recBuildTyIn(tbl, d, true) }
}

// The record a container's build gives the read `x`: an element by index or `.get`, a field of
// one, or a record binding's own build; else -1.
export function recBuiltReadTy(x: i32): i32 {
  recBuiltReadTyIn(x, recBuildPassTable())
}

// `recBuiltReadTy` read from build table `tbl`: the pass's own during check, the last pass's after.
export function recBuiltReadTyIn(x: i32, tbl: Map<i32, i32>): i32 {
  recBuiltReadTyAt(x, tbl, true, REC_STORE_DEPTH)
}

// `recBuiltReadTyIn` through at most `depth` bindings and calls: a binding holding such a read,
// or a call of an inferred function every value leaf of which is one at one record (D15124).
// Without `fresh`, a binding's own build is not asked: a fresh record is not a container's read.
function recBuiltReadTyAt(
  x: i32,
  tbl: Map<i32, i32>,
  fresh: boolean,
  depth: i32,
): i32 {
  if depth <= 0 || x < 0 || x >= P.nodes.length { return -1 }
  const n = nodeAt(x)
  if n is BinExpr {
    return if n.binOp == "??" { recBuiltReadTyAt(cwPeelValue(n.binLeft), tbl, fresh, depth) } else { -1 }
  }
  if n is Index { return recBuiltElemIn(cwPeelValue(n.idxArr), tbl) }
  if n is Call {
    if n.callFn < 0 { return -1 }
    const f = nodeAt(n.callFn)
    if n.callArgs.length == 1 && f is Member && f.memProp == "get" {
      return recBuiltElemIn(cwPeelValue(f.memObj), tbl)
    }
    // A list's `pop()` reads an element, as an index does (D15230).
    if n.callArgs.length == 0 && f is Member && f.memProp == "pop" {
      return recBuiltElemIn(cwPeelValue(f.memObj), tbl)
    }
    // A call handing its argument back reads where that argument does (D14819).
    const ia = recIdentityArgOf(x)
    if ia >= 0 {
      const lb = recLitArgBuiltTy(cwPeelValue(ia))
      if lb >= 0 { return lb }
      return recBuiltReadTyAt(cwPeelValue(ia), tbl, false, depth - 1)
    }
    return recBuiltLeavesTy(recInferredFnOf(x), tbl, depth - 1)
  }
  if n is Member {
    const o = recBuiltReadTyAt(cwPeelValue(n.memObj), tbl, fresh, depth)
    if o < 0 { return -1 }
    const ot = tyAt(nonNullTy(o))
    return if ot is TyObj { objFieldType(ot, n.memProp) } else { -1 }
  }
  const d = recHeldDecl(x)
  if d < 0 { return -1 }
  const b = if fresh { recBuildTyIn(tbl, d, false) } else { -1 }
  const dn = nodeAt(d)
  if b >= 0 || !(dn is LetDecl) { return b }
  recBuiltReadTyAt(cwPeelValue(dn.letInit), tbl, fresh, depth - 1)
}

// Whether `u` is a call handing back a record literal a pin built at another record (D15185).
export function recHandsBackPinLit(u: i32): boolean {
  const p = cwPeelValue(u)
  if p < 0 || p >= P.nodes.length || !(nodeAt(p) is Call) { return false }
  const ia = recIdentityArgOf(p)
  ia >= 0 && recLitArgBuiltTy(cwPeelValue(ia)) >= 0
}

// The record literal `x` is built at when a pin stamped it at another record than its own, else -1:
// a call handing it back reads it there (D15185).
function recLitArgBuiltTy(x: i32): i32 {
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is ObjLit) { return -1 }
  const rt = nodeRepTyIxOf(x)
  const own = nodeTyIxOf(x)
  if rt < 0 || rt >= T.tys.length || own < 0 || tySame(rt, own) { return -1 }
  if tyAt(rt) is TyObj { rt } else { -1 }
}

// The record every value leaf of function `fd` is a built read at (`recBuiltReadTyAt`), else -1.
function recBuiltLeavesTy(fd: i32, tbl: Map<i32, i32>, depth: i32): i32 {
  if fd < 0 || depth <= 0 { return -1 }
  let r = -1
  for lf in recFnValueLeaves(fd) {
    const b = recBuiltReadTyAt(cwPeelValue(lf), tbl, false, depth)
    if b < 0 || (r >= 0 && !tySame(r, b)) { return -1 }
    r = b
  }
  r
}

// Each field write a non-generic body checked, as the stored value, the receiver, the field and
// the function around it, boxed at the receiver's storage once the pass's builds are known.
let storeWriteVal: i32[] = []
let storeWriteRecv: i32[] = []
let storeWriteField: string[] = []
let storeWriteFn: i32[] = []

// Queues the field write `recv.field = v` for `storeWritesResolve`.
export function storeWritePush(v: i32, recv: i32, field: string) {
  if v < 0 || recv < 0 || !stampsStand() || tpEnvNames.length > 0 { return 0 }
  storeWriteVal.push(v)
  storeWriteRecv.push(recv)
  storeWriteField.push(field)
  storeWriteFn.push(curFnDeclIx)
  0
}

// Each un-annotated binding's initializer a check queued, and the record a call initializer's
// results are built at where that is another than its own type (`storeLetsResolve`), by call node.
let storeLetInit: i32[] = []
let storeLetDecl: i32[] = []
let storeLetBuilt: {[i32]: i32} = Map()
// The un-annotated functions a check queued, for `storeRetsResolve`.
let storeFnQueue: i32[] = []

// Queues the initializer `init` of un-annotated binding `decl` for `storeLetsResolve`.
export function storeLetPush(init: i32, decl: i32) {
  if init < 0 || !stampsStand() || elabCapLive() { return 0 }
  storeLetInit.push(init)
  storeLetDecl.push(decl)
  0
}
// Queues the un-annotated, non-generic function `fd` for `storeRetsResolve`.
export function storeFnPush(fd: i32) {
  if fd < 0 || !stampsStand() || elabCapLive() { return 0 }
  storeFnQueue.push(fd)
  0
}
export function storeFnCount(): i32 { storeFnQueue.length }
export function storeFnAt(i: i32): i32 { storeFnQueue[i] }
export function storeLetCount(): i32 { storeLetInit.length }
export function storeLetInitAt(i: i32): i32 { storeLetInit[i] }
export function storeLetDeclAt(i: i32): i32 {
  if i < storeLetDecl.length { storeLetDecl[i] } else { -1 }
}
export function storeLetBuiltSet(call: i32, rec: i32) {
  storeLetBuilt[call] = rec
  0
}

// The record every result of the call `call` an un-annotated binding holds is built at, where
// that is another record than the call's own type; else -1.
export function storeLetBuiltOf(call: i32): i32 { storeLetBuilt[call] ?? -1 }

// Empties the built-record column and both queues, as a check pass begins.
export function storeRepPassReset() {
  storeLetBuilt = Map()
  storeWritesClear()
}

// The queued writes, for `storeWritesResolve`, which empties the queue once it has read them.
export function storeWriteCount(): i32 { storeWriteVal.length }
export function storeWriteValAt(i: i32): i32 { storeWriteVal[i] }
export function storeWriteRecvAt(i: i32): i32 { storeWriteRecv[i] }
export function storeWriteFieldAt(i: i32): string { storeWriteField[i] }
export function storeWriteFnAt(i: i32): i32 { storeWriteFn[i] }
export function storeWritesClear() {
  storeLetInit = []
  storeLetDecl = []
  storeFnQueue = []
  storeWriteVal = []
  storeWriteRecv = []
  storeWriteField = []
  storeWriteFn = []
  0
}

// The storage a kept delivery builds the stored value `v` at, else -1.
function recMapStoreKeptDst(v: i32): i32 { recKeptValueDst(v, 6) }

// `recMapStoreKeptDst` through a generic or hole identity to its argument, or through a call of a
// function every result of which is a binding of such a value.
function recKeptValueDst(v: i32, depth: i32): i32 {
  if depth <= 0 { return -1 }
  const p = cwPeelValue(v)
  if p < 0 || p >= P.nodes.length { return -1 }
  const sa = recSolePinArg(p)
  if sa >= 0 { return recKeptValueDst(sa, depth - 1) }
  // A call the solve stamped at its own record is kept nowhere else (D15266).
  if (
    nodeAt(p) is Call
    && nodeRepStamped(p)
    && tySame(nodeRepTyIxOf(p), nodeTyIxOf(p))
  ) {
    return -1
  }
  const kd = recKeptDstOfDecl(recFreshOriginDecl(p, 6))
  if kd >= 0 { return kd }
  const fd = recInferredFnOf(p)
  if fd < 0 { return -1 }
  const ha = recHoleIdentityArg(p, fd)
  if ha >= 0 { return recKeptValueDst(ha, depth - 1) }
  let r = -1
  for lf in recFnValueLeaves(fd) {
    const hd = if lf >= 0 && nodeAt(lf) is Ident { recHeldDecl(lf) } else { -1 }
    const hn = if hd >= 0 { nodeAt(hd) } else { null }
    if !(hn is LetDecl) { return -1 }
    const lr = recKeptValueDst(hn.letInit, depth - 1)
    if lr < 0 || (r >= 0 && !tySame(r, lr)) { return -1 }
    r = lr
  }
  r
}

// Refuses each object literal inside the literal `init`, built at the record `dst`, whose field is
// a union none of whose arms declares every field the literal sets, unless an arm's fields are the
// first of the literal's: that arm is its row's supertype (D3566). `depth` bounds the walk.
function recBuildArmDropRefuse(init: i32, dst: i32, depth: i32) {
  const lp = cwPeelValue(init)
  if inferQuiet || depth <= 0 || lp < 0 || dst < 0 || dst >= T.tys.length {
    return 0
  }
  const e = nodeAt(lp)
  const d = tyAt(nonNulTyOf(dst))
  if !(e is ObjLit) || !(d is TyObj) { return 0 }
  for fx in e.objFields {
    const f = nodeAt(fx)
    if f is FieldInit {
      const ft = objFieldType(d, f.fiName)
      const v = cwPeelValue(f.fiValue)
      const fu = if ft >= 0 { tyAt(nonNulTyOf(ft)) } else { null }
      const vn = if v >= 0 { nodeAt(v) } else { null }
      if (
        fu is TyUnion
        && vn is ObjLit
        && objLitUnionArm(vn, nodeTyIxOf(v), fu.uMembers) < 0
      ) {
        for m in fu.uMembers {
          // An arm whose fields are the first of the literal's is its WasmGC supertype, so the
          // literal is built at its own row and boxed as that arm (D3566).
          if (
            m >= 0
            && tyAt(m) is TyObj
            && assignable(nodeTyIxOf(v), m)
            && !objWidthPrefix(nodeTyIxOf(v), m)
          ) {
            const through = " (reached through "
              + tyToStr(nodeTyIxOf(lp))
              + " into "
              + tyToStr(dst)
              + ")"
            objShapeDropUnsupportedErr(v, nodeTyIxOf(v), m, through)
            return 0
          }
        }
      } else if ft >= 0 {
        recBuildArmDropRefuse(v, ft, depth - 1)
      }
    }
  }
  0
}

// The storage the kept function `d` builds at (`recKeptDecl`), else -1.
function recKeptDstOfDecl(d: i32): i32 {
  if d < 0 { return -1 }
  let k = recKeptDecl.length - 1
  while k >= 0 && recKeptDecl[k] != d { k = k - 1 }
  if k >= 0 && k < recKeptDst.length { recKeptDst[k] } else { -1 }
}

// The un-annotated container binding the value `v` is stored into: a `Map()` by `m[k] = v` or
// `m.set(k, v)`, a list literal's binding by being its element or by `xs[i] = v`, or a record
// literal's by being a field's value or by `w.f = v`; else -1.
export function recStoreDeclOf(v: i32): i32 {
  if v < 0 || !cwIxCovers(v) { return -1 }
  const a = cwIxUp[v]
  if a < 0 || a >= P.nodes.length { return -1 }
  const an = nodeAt(a)
  if an is ArrayLit || (an is ObjLit && cwIxUpKind[v] == CW_UP_FIELD) {
    return recLitDeclOf(a)
  }
  let recv = -1
  let set = false
  let fld = false
  if an is BinExpr {
    if an.binOp == "=" && an.binCompound == "" && an.binRight == v {
      const l = nodeAt(an.binLeft)
      if l is Index {
        recv = l.idxArr
      } else if l is Member {
        recv = l.memObj
        fld = true
      }
    }
  } else if an is Call {
    if an.callArgs.length == 2 && an.callArgs[1] == v && an.callFn >= 0 {
      const f = nodeAt(an.callFn)
      if f is Member && f.memProp == "set" {
        recv = f.memObj
        set = true
      }
    }
  }
  if recv < 0 { return -1 }
  const d = if fld { -1 } else { recFreshMapDeclOf(recv) }
  if d >= 0 {
    const dn = nodeAt(d)
    return if dn is LetDecl && dn.letType < 0 { d } else { -1 }
  }
  const hl = recHeldLit(recv)
  if set || hl < 0 { return -1 }
  const lit = cwPeelValue(hl)
  if lit < 0 || (nodeAt(lit) is ObjLit) != fld { return -1 }
  recLitDeclOf(lit)
}

// The un-annotated binding the list or record literal `a` initializes, else -1.
function recLitDeclOf(a: i32): i32 {
  if a < 0 || !cwIxCovers(a) || cwIxUpKind[a] != CW_UP_LETINIT { return -1 }
  if !(nodeAt(a) is ArrayLit || nodeAt(a) is ObjLit) { return -1 }
  const d = cwIxUp[a]
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if dn is LetDecl && dn.letType < 0 { d } else { -1 }
}

// The values stored into the container binding `d` (`recStoreDeclOf`).
function recStoredValues(d: i32): i32[] {
  const out = recMapStoredValues(d)
  const dn = nodeAt(d)
  if dn is LetDecl && dn.letInit >= 0 {
    const a = nodeAt(cwPeelValue(dn.letInit))
    if a is ArrayLit {
      for e in a.arrElems { out.push(e) }
    } else if a is ObjLit {
      for fi in a.objFields {
        const fn = nodeAt(fi)
        if fn is FieldInit { out.push(fn.fiValue) }
      }
    }
  }
  out
}

// Whether the value of call `c` is stored into a container (`recStoreDeclOf`), directly or
// through an un-annotated `const` whose every use is such a store or a field read.
function recHeldStored(c: i32): boolean {
  if recStoreDeclOf(c) >= 0 { return true }
  if !cwIxCovers(c) || cwIxUpKind[c] != CW_UP_LETINIT { return false }
  const d = cwIxUp[c]
  if d < 0 || d >= P.nodes.length { return false }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letKw != "const" { return false }
  let stored = false
  const ow = cwOccWalk(d)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_USE {
      const u = cwIxNode[r]
      if recStoreDeclOf(u) >= 0 { stored = true }
      else if !recFieldRead(u) { return false }
    } else if cwIxKind[r] != CW_OCC_BIND || cwIxNode[r] != d {
      return false
    }
  }
  stored
}

// Appends to `out` each container a kept function's call is stored into (`recHeldStored`).
export function recKeptStoreDecls(out: i32[]) {
  cwIxBuild()
  let k = 0
  while k < recKeptDecl.length {
    const fd = recKeptDecl[k]
    const sites: i32[] = []
    if nodeAt(fd) is FuncDecl && rcwCallSites(fd, sites) < 0 {
      for s in sites {
        if s % 2 == 0 { recRelayStoreDecls(s / 2, out, 4) }
      }
    }
    k = k + 1
  }
  0
}

// `recHeldStoreDecls` of the call `c` and of each call its value is relayed out of: a generic or
// hole identity it is the argument of, or a call of a function that returns a binding of it.
function recRelayStoreDecls(c: i32, out: i32[], depth: i32) {
  recHeldStoreDecls(c, out)
  if depth <= 0 || c < 0 || !cwIxCovers(c) { return 0 }
  const up = cwIxUp[c]
  if up < 0 || up >= P.nodes.length { return 0 }
  if cwIxUpKind[c] == CW_UP_ARG && nodeAt(up) is Call {
    const sa = recSolePinArg(up)
    const fd = recInferredFnOf(up)
    const ha = if fd >= 0 { recHoleIdentityArg(up, fd) } else { -1 }
    if (sa >= 0 && cwPeelValue(sa) == c) || (ha >= 0 && cwPeelValue(ha) == c) {
      recRelayStoreDecls(up, out, depth - 1)
    }
    return 0
  }
  if cwIxUpKind[c] != CW_UP_LETINIT || !(nodeAt(up) is LetDecl) { return 0 }
  const fd = recEnclosingFn(up)
  if fd < 0 { return 0 }
  for lf in recFnValueLeaves(fd) {
    if lf < 0 || !(nodeAt(lf) is Ident) || recHeldDecl(lf) != up { return 0 }
  }
  const sites: i32[] = []
  if rcwCallSites(fd, sites) >= 0 { return 0 }
  for s in sites {
    if s % 2 == 0 { recRelayStoreDecls(s / 2, out, depth - 1) }
  }
  0
}

// Appends to `out` the containers `recHeldStored` finds the call `c` stored into.
function recHeldStoreDecls(c: i32, out: i32[]) {
  if !recHeldStored(c) { return 0 }
  const md = recStoreDeclOf(c)
  if md >= 0 {
    out.push(md)
    return 0
  }
  const d = cwIxUp[c]
  const dn = nodeAt(d)
  if !(dn is LetDecl) { return 0 }
  const ow = cwOccWalk(d)
  while cwOccNext(ow) {
    if cwIxKind[ow.row] == CW_OCC_USE {
      const ud = recStoreDeclOf(cwIxNode[ow.row])
      if ud >= 0 { out.push(ud) }
    }
  }
  0
}

// Note a delivery of the literal list binding `srcExpr` (a list of records) as a list of a
// record union, which it adopts. True when it noted one.
export function recAdoptUnionList(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
): boolean {
  const p = cwPeelValue(srcExpr)
  if p < 0 || p >= P.nodes.length { return false }
  const e = nodeAt(p)
  // A list literal delivers each element as the destination's element.
  if e is ArrayLit {
    const de = tyArrayElemIx(nonNulTyOf(dstTy))
    if de < 0 { return false }
    let any = false
    for el in e.arrElems {
      if !(nodeAt(el) is Spread) && recAdoptUnionList(el, nodeTyIxOf(el), de) {
        any = true
      }
    }
    return any
  }
  if !(e is Ident) { return false }
  const decl = recFreshDeclOf(p)
  if decl < 0 || !(nodeAt(parenPeelIx(recDeclInit(decl))) is ArrayLit) {
    return false
  }
  const de = tyArrayElemIx(recAdLandingList(nonNulTyOf(dstTy)))
  if de < 0 || !(tyAt(de) is TyUnion) { return false }
  recAdPushUnionList(decl, tyArrayElemIx(srcTy), de, p)
  // Its literal is built at the first such list, which a disagreeing later one aliases (D853).
  const lit = parenPeelIx(recDeclInit(decl))
  const was = if lit < nodeRepTyIx.length { nodeRepTyIx[lit] } else { -1 }
  const wasEl = if was >= 0 { tyArrayElemIx(was) } else { -1 }
  if !recAdNoAdopt.has(decl) && (wasEl < 0 || !(tyAt(wasEl) is TyUnion)) {
    adoptLitAt(lit, recAdLandingList(nonNulTyOf(dstTy)))
  }
  true
}

// Note a delivery of `srcExpr` (a `srcTy`) as a `dstTy`, when it hands a literal binding, or an
// element of a literal list binding, to a record that stores a field differently.
export function recAdoptNote(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcTy < 0 || dstTy < 0 || srcTy == dstTy { return 0 }
  if !tyHoldsObjDeep(srcTy) || !tyHoldsObjDeep(dstTy) { return 0 }
  const p = cwPeelValue(srcExpr)
  if p < 0 || p >= P.nodes.length { return 0 }
  const e = nodeAt(p)
  // A value `if`, `match` or block delivers each tail, and a `??` each operand (D3441).
  if recIsJoin(p) {
    const leaves: i32[] = []
    tailValueLeaves(p, leaves)
    for lf in leaves { recAdoptNote(lf, nodeTyIxOf(lf), dstTy) }
    return 0
  }
  const co = recCoalesceOperands(p)
  if co.length == 2 {
    recAdoptNote(co[0], nodeTyIxOf(co[0]), dstTy)
    recAdoptNote(co[1], nodeTyIxOf(co[1]), dstTy)
    return 0
  }
  if e is Ident {
    const decl = recFreshDeclOf(p)
    if decl < 0 {
      // A binding holding a literal handed through a generic identity adopts as one holding
      // the literal does (D7941).
      const pd = recPassLitDeclOf(p)
      if pd >= 0 {
        return recAdPushDecl(pd, srcTy, nonNulTyOf(dstTy), false, p)
      }
      // One holding a call or an element read is delivered as that origin is (D8140).
      const oc = recHeldCallOrigin(p)
      if oc >= 0 { return recAdoptNote(oc, nodeTyIxOf(oc), dstTy) }
      // One aliasing a literal binding keeps its type, and the literal is built at the record.
      const od = recFreshOriginDecl(p, 6)
      if (
        od >= 0
        && nodeAt(od) is LetDecl
        && nodeAt(parenPeelIx(recDeclInit(od))) is ObjLit
      ) {
        recBuildPush(od, srcTy, nonNulTyOf(dstTy), false)
      }
      return 0
    }
    const iv = nodeAt(parenPeelIx(recDeclInit(decl)))
    if iv is ArrayLit {
      if recAdoptUnionList(srcExpr, srcTy, dstTy) { return 0 }
      // A list of record lists is built at the destination by its literal's stamp, keeping its
      // type, and its own-storage deliveries are refused at the pass end (D15370).
      const land = recAdLandingList(nonNulTyOf(dstTy))
      const se = tyArrayElemIx(srcTy)
      if se >= 0 && se < T.tys.length && tyAt(se) is TyArray && land >= 0 {
        adoptLitAt(parenPeelIx(recDeclInit(decl)), land)
        recApartDecl.push(decl)
        recApartDst.push(land)
        recApartAt.push(p)
        return 0
      }
      return recAdPushDecl(
        decl,
        tyArrayElemIx(srcTy),
        tyArrayElemIx(recAdLandingList(nonNulTyOf(dstTy))),
        true,
        p,
      )
    }
    recAdPushDecl(decl, srcTy, nonNulTyOf(dstTy), false, p)
    if recAdNoAdopt.has(decl) {
      recBuildArmDropRefuse(recDeclInit(decl), nonNulTyOf(dstTy), 6)
    }
    return 0
  }
  if e is Index {
    const b = cwPeelValue(e.idxArr)
    if b < 0 || b >= P.nodes.length { return 0 }
    const bn = nodeAt(b)
    if bn is Ident {
      const decl = recFreshDeclOf(b)
      if decl >= 0 && nodeAt(parenPeelIx(recDeclInit(decl))) is ArrayLit {
        return recAdPushDecl(decl, srcTy, nonNulTyOf(dstTy), true, p)
      }
    }
    // An element of a list literal, or of a call handing one back, is delivered as the list is.
    if bn is ArrayLit {
      const dn = nonNulTyOf(dstTy)
      if dn >= 0 { recAdoptNote(b, nodeTyIxOf(b), mkArrayTy(dn)) }
      return 0
    }
    if bn is Call && recAdParamListArgs(b, nonNulTyOf(dstTy)) { return 0 }
    // An element of a map or list is delivered as its container is, at the element's destination.
    if recContainerReadDeliver(p, dstTy) { return 0 }
    if bn is Ident && recFreshDeclOf(b) < 0 { return 0 }
  }
  if e is Call {
    const fd = recInferredFnOf(p)
    // A list result is delivered as the bindings its function returns. Literals it returns bare
    // are built at the destination list, and so is the result, when every value is one that can
    // be (D14223); a mix of the two adopts neither.
    const sl = nonNulTyOf(srcTy)
    if fd >= 0 && sl >= 0 && tyAt(sl) is TyArray {
      const dl = recAdLandingList(nonNulTyOf(dstTy))
      const os = recReturnedOrigins(fd, p, sl, dl)
      // One body builds one list, so calls landing it on two storages refuse (D8301).
      if os.length == 0 && recSitesLandApart(fd, sl, dl) {
        recRefuseAtOwnRow(p, sl, dl)
        return 0
      }
      let bare = os.length > 0
      let reads = true
      for b in os {
        if !(nodeAt(b) is ArrayLit) || !litAtDstStorage(b, dl) { bare = false }
        if !(nodeAt(b) is Ident) { reads = false }
      }
      if bare {
        for b in os { recordRepTyAdopt(b, dl, 6) }
        recKeptFnPush(fd, sl, dl, p)
      } else if reads {
        for b in os { recAdoptNote(b, nodeTyIxOf(b), dstTy) }
      }
      return 0
    }
    if fd >= 0 {
      // A union member has no adoption of a call result, so one built at a declared row is
      // refused there (D8141).
      if (
        recLandingOf(srcTy, dstTy) != nonNulTyOf(dstTy)
        && recBuildsLit(fd, 8)
        && recBuiltAtDeclared(p, srcTy, dstTy)
      ) {
        return 0
      }
      if recFnBuiltAtDst(fd, p, srcTy, dstTy) {
        return recAdPushDecl(fd, srcTy, nonNulTyOf(dstTy), false, p)
      }
      // A union destination keeps master's delivery, which boxes the record it builds.
      if recFloatBuiltElsewhere(p, srcTy, nonNulTyOf(dstTy)) { return 0 }
      if recBuildsLit(fd, 8) && recBuiltAtDeclared(p, srcTy, dstTy) { return 0 }
      // One body builds one row, so calls landing on two field storages cannot all be served
      // and the record stays at its own row (D8301).
      const ld = recLandingOf(srcTy, dstTy)
      if (
        recBuildsLit(fd, 8)
        && ld >= 0
        && (recSitesLandApart(fd, nonNulTyOf(srcTy), ld) || recSitesHeldPinned(fd))
      ) {
        recRefuseAtOwnRow(p, nonNulTyOf(srcTy), ld)
        return 0
      }
      if recHoleIdentityAt(p, fd, srcTy, dstTy) { return 0 }
      recIdentityLeavesAt(fd, ld)
      // A relay of a result built elsewhere is converted where it is delivered, not kept at `ld`.
      if ld >= 0 && recRelayLeavesToCopy(fd, ld) { return 0 }
      return recAdPushDecl(fd, srcTy, nonNulTyOf(dstTy), false, p)
    }
    const pa = recPassThroughArg(p)
    if pa >= 0 {
      // A generic identity hands its argument back, so a literal binding there adopts (D3442).
      const pp = cwPeelValue(pa)
      // A fresh call under nested identities is judged here, since the inner ones sit at a
      // pinned argument (D8142).
      if pp >= 0 && recPassThroughArg(pp) >= 0 {
        const po = recOriginExpr(pp)
        const pi = if po >= 0 { recInferredFnOf(po) } else { -1 }
        // Identities each pinned only by the call inside hand the build on to it (D8303).
        if (
          pi >= 0
          && recSolePinChain(p, po)
          && recLandingOf(srcTy, dstTy) == nonNulTyOf(dstTy)
          && recFnBuiltAtDst(pi, po, srcTy, dstTy)
        ) {
          return recAdPushDecl(pi, srcTy, nonNulTyOf(dstTy), false, po)
        }
        if pi >= 0 && recHasLitLeaf(pi) && recBuiltAtDeclared(p, srcTy, dstTy) {
          return 0
        }
      }
      if (
        pp >= 0
        && ((nodeAt(pp) is Ident && recFreshDeclOf(pp) >= 0)
          || recPassThroughArg(pp) >= 0
          || recIsJoin(pp)
          || recCoalesceOperands(pp).length == 2)
      ) {
        return recAdoptNote(pa, nodeTyIxOf(pa), dstTy)
      }
      // A fresh call handed through, directly or through bindings holding it, is built at its own
      // row, as it is delivered directly; the origin is the walk the arm's other branches read
      // (`recOriginExpr`, D15179).
      const pc = if pp >= 0 { recOriginExpr(pp) } else { -1 }
      const pf = if pc >= 0 { recInferredFnOf(pc) } else { -1 }
      if pf >= 0 {
        const pl = nonNulTyOf(dstTy)
        if (
          recFloatField(nonNulTyOf(srcTy), pl) != ""
          && recFloatBuiltElsewhere(p, srcTy, pl)
        ) {
          return 0
        }
        // Where only this argument pins the instance, the call is built at the record it lands
        // on and the instance is taken there, as a direct delivery builds it (D8020).
        if (
          recSolePinArg(p) >= 0
          && recLandingOf(srcTy, dstTy) == pl
          && recFnBuiltAtDst(pf, pc, srcTy, dstTy)
        ) {
          return recAdPushDecl(pf, srcTy, nonNulTyOf(dstTy), false, pc)
        }
        if recHasLitLeaf(pf) && recBuiltAtDeclared(p, srcTy, dstTy) { return 0 }
        const pld = recLandingOf(srcTy, dstTy)
        if (
          recHasLitLeaf(pf)
          && pld >= 0
          && recSitesLandApart(pf, nonNulTyOf(srcTy), pld)
        ) {
          recRefuseAtOwnRow(p, nonNulTyOf(srcTy), pld)
          return 0
        }
      }
      // An object literal argument is built at the identity's own instance, which holds an
      // integer where a flat float field waits (D3442).
      if pp >= 0 && nodeAt(pp) is ObjLit {
        const ol = nonNulTyOf(dstTy)
        if (
          recFloatField(nonNulTyOf(srcTy), ol) != ""
          && recFloatBuiltElsewhere(p, srcTy, ol)
        ) {
          return 0
        }
      }
      // A literal argument that alone pins the instance is built at the destination, whatever
      // records the program declares (D7941); one pinned elsewhere is built at its own row.
      const po = recOriginExpr(pa)
      if po >= 0 && nodeAt(po) is ObjLit {
        const pd = recLandingOf(srcTy, dstTy)
        if recSolePinArg(p) >= 0 && recLitFits(po, pd, REC_STORE_DEPTH) {
          recordRepTyAdopt(po, pd, 6)
          return 0
        }
        if recBuiltAtDeclared(p, srcTy, dstTy) { return 0 }
      }
    }
  }
  // A literal delivers each of its elements or fields to the matching part of the destination.
  const d = nonNulTyOf(dstTy)
  if d < 0 || d >= T.tys.length { return 0 }
  if e is ArrayLit {
    const de = tyArrayElemIx(d)
    if de >= 0 {
      for el in e.arrElems {
        if !(nodeAt(el) is Spread) { recAdoptNote(el, nodeTyIxOf(el), de) }
      }
    }
  } else if e is ObjLit {
    recAdNoteFields(p, d)
  }
  0
}

// A call to a generic declared to return `T[]`: an element of its result can only be a value one
// of its `T` or `T[]` arguments brought, so each such argument is delivered at the element's
// destination `d`. False for any other call.
function recAdParamListArgs(call: i32, d: i32): boolean {
  const c = nodeAt(call)
  if d < 0 { return false }
  if c is Call && c.callFn >= 0 {
    const cn = nodeAt(c.callFn)
    if cn is Ident {
      const fd = identBoundFnDeclOf(c.callFn)
      if fd < 0 { return false }
      const f = nodeAt(fd)
      if f is FuncDecl {
        if f.fnRet < 0 { return false }
        const rt = nodeAt(f.fnRet)
        if rt is TypeRef {
          for tp in f.fnTyParams {
            if rt.tyName == tp + "[]" {
              let i = 0
              while i < f.fnParams.length && i < c.callArgs.length {
                const pn = nodeAt(f.fnParams[i])
                if pn is Param && pn.parType >= 0 {
                  const pt = nodeAt(pn.parType)
                  const a = c.callArgs[i]
                  if pt is TypeRef && pt.tyName == rt.tyName {
                    recAdoptNote(a, nodeTyIxOf(a), mkArrayTy(d))
                  } else if pt is TypeRef && pt.tyName == tp {
                    recAdoptNote(a, nodeTyIxOf(a), d)
                  }
                }
                i = i + 1
              }
              return true
            }
          }
        }
      }
    }
  }
  false
}

// `recAdoptNote` for each field of the object literal `lit` delivered as the record `d`.
function recAdNoteFields(lit: i32, d: i32) {
  const dt = tyAt(d)
  if dt is TyObj {
    let i = 0
    while i < dt.objFieldNames.length {
      const fx = objLitFieldExpr(lit, dt.objFieldNames[i])
      if fx >= 0 { recAdoptNote(fx, nodeTyIxOf(fx), dt.objFieldTypes[i]) }
      i = i + 1
    }
  }
  0
}

// A delivery its own type refuses, of a literal binding (or an element or field of a literal)
// into a record that stores one of its numbers at another width or kind (`i32` into `f32`): the
// binding adopts the record and the re-check judges its literal there, as its annotated twin's
// is (D3339). True when it noted such an adoption.
export function recAdForce(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  if (
    srcTy < 0
    || dstTy < 0
    || !tyHoldsObjDeep(srcTy)
    || !tyHoldsObjDeep(dstTy)
  ) {
    return false
  }
  const p = cwPeelValue(srcExpr)
  if p < 0 || p >= P.nodes.length { return false }
  const e = nodeAt(p)
  const fd = recInferredFnOf(p)
  if fd >= 0 {
    const dl = recAdLanding(nonNulTyOf(srcTy), nonNulTyOf(dstTy))
    for lf in recFnValueLeaves(fd) {
      if !recLitFits(cwPeel(lf), dl, REC_STORE_DEPTH) { return false }
    }
    return recFnBuiltAtDst(fd, p, srcTy, dstTy)
  }
  if (
    !(e is Ident || e is Index || e is ArrayLit || e is ObjLit)
    && !recIsJoin(p)
    && recCoalesceOperands(p).length != 2
    && recPassThroughArg(p) < 0
  ) {
    return false
  }
  const before = recAdDecl.length
  recAdoptNote(srcExpr, srcTy, dstTy)
  let any = false
  let i = before
  while i < recAdDecl.length {
    if recAdWidth.has(recAdDecl[i]) {
      any = true
      recAdForced.push(p)
      recAdForcedDecl.push(recAdDecl[i])
    }
    i = i + 1
  }
  any
}

// The readonly-only list rule (DECISIONS.md "No implicit container widening", D2161): a list
// whose element widens is refused unless the destination is `readonly`. Keyed on each list's
// ORIGIN: a list literal is built at the type it flows into, so it is exempt while the lists
// inside it are judged by their own expressions. `underNul`: the pair sits under a `| null`.
function listWidenWalk(
  expr: i32,
  src: i32,
  dst: i32,
  depth: i32,
  underNul: boolean,
): boolean {
  if src < 0 || dst < 0 || depth <= 0 { return false }
  if src >= T.tys.length || dst >= T.tys.length { return false }
  if src == dst { return false }
  const x = listOriginExpr(expr)
  // A list literal a `const` names is built at its own type, so a mutable list sharing it cannot
  // read a function set's elements at a closed function type (D15133).
  if (
    x >= 0
    && expr >= 0
    && parenPeelIx(expr) != x
    && listConstLitFnSet(x, src, dst)
  ) {
    return listWidenClaim(parenPeelIx(expr), src, dst)
  }
  if x == LW_INFERRED { return false }
  if x >= 0 && listWidenJoin(x, dst, depth, underNul) { return true }
  if x >= 0 && (recIsJoin(x) || recCoalesceOperands(x).length == 2) {
    return false
  }
  const pa = if x >= 0 { recPassThroughArg(x) } else { -1 }
  if pa >= 0 {
    return listWidenWalk(pa, nodeTyIxOf(pa), dst, depth - 1, underNul)
  }
  const d = tyAt(dst)
  if d is TyNullable {
    const sn = tyAt(src)
    if sn is TyNullable {
      return listWidenWalk(-1, sn.nInner, d.nInner, depth - 1, true)
    }
    return listWidenWalk(x, src, d.nInner, depth - 1, true)
  }
  if d is TyUnion {
    // A union source is delivered member by member, each to the member that accepts it, so
    // `f64[] | i32[]` into itself is not refused for `i32[]` meeting `f64[]` first (D2877).
    if tyAt(src) is TyUnion {
      return listWidenFromSrc(x, src, dst, depth, underNul)
    }
    return listWidenIntoUnion(x, src, d.uMembers, depth, underNul)
  }
  listWidenFromSrc(x, src, dst, depth, underNul)
}

// A value `if`, `match` or block delivers each tail, and a `??` each operand, judged by its
// own origin (D3441). True when one of them is refused.
function listWidenJoin(
  x: i32,
  dst: i32,
  depth: i32,
  underNul: boolean,
): boolean {
  const leaves: i32[] = []
  if recIsJoin(x) {
    tailValueLeaves(x, leaves)
  } else {
    for o in recCoalesceOperands(x) { leaves.push(o) }
  }
  for lf in leaves {
    if listWidenWalk(lf, nodeTyIxOf(lf), dst, depth - 1, underNul) {
      return true
    }
  }
  false
}

// A union destination accepts the source at some member; the walk refuses only when every
// member that accepts it refuses.
function listWidenIntoUnion(
  x: i32,
  src: i32,
  dms: i32[],
  depth: i32,
  underNul: boolean,
): boolean {
  let anyClean = false
  let anyBad = false
  let i = 0
  while i < dms.length {
    if assignable(src, dms[i]) {
      if listWidenWalk(x, src, dms[i], depth - 1, underNul) {
        anyBad = true
      } else {
        anyClean = true
      }
    }
    i = i + 1
  }
  if anyClean { return false }
  anyBad
}

// The walk's dispatch on the source's own kind; a leaf holds no list.
function listWidenFromSrc(
  x: i32,
  src: i32,
  dst: i32,
  depth: i32,
  underNul: boolean,
): boolean {
  const s = tyAt(src)
  match s {
    TyNullable => {
      return listWidenWalk(-1, s.nInner, dst, depth - 1, underNul)
    }
    TyUnion => {
      let i = 0
      while i < s.uMembers.length {
        if listWidenWalk(-1, s.uMembers[i], dst, depth - 1, underNul) {
          return true
        }
        i = i + 1
      }
      return false
    }
    TyArray => {
      return listWidenArray(x, s, src, dst, depth, underNul)
    }
    TyObj => {
      return listWidenObj(x, s, dst, depth)
    }
    TyMap => {
      return listWidenMap(x, s, src, dst, depth)
    }
    TyFunc => {
      return listWidenFunc(s, dst, depth)
    }
    TyPrim | TyErr | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// A list into a list: the element pair first, so the innermost widened list is the one named.
function listWidenArray(
  x: i32,
  s: TyArray,
  src: i32,
  dst: i32,
  depth: i32,
  underNul: boolean,
): boolean {
  const d = tyAt(dst)
  if d is TyArray {
    if x >= 0 {
      const lit = nodeAt(x)
      if lit is ArrayLit {
        return listWidenLitElems(lit.arrElems, d.aElem, depth)
      }
    }
    if listWidenWalk(-1, s.aElem, d.aElem, depth - 1, false) { return true }
    if d.aRead != 1 {
      if listElemWidens(s.aElem, d.aElem) { return listWidenClaim(x, src, dst) }
      // A function set's generic member type into a closed function element needs a copy
      // through adapters, which only a readonly list may take (D15133).
      if listFnSetNeedsCopy(s.aElem, d.aElem) {
        return listWidenClaim(x, src, dst)
      }
      return false
    }
    // A readonly destination that needs a converting copy under `| null` has no lowering yet.
    if underNul && listPairNeedsCopy(s.aElem, d.aElem) {
      shapeAdaptNulCopySet(true)
      return listWidenClaim(x, src, dst)
    }
  }
  false
}

// Whether literal `x`, of list type `src`, delivered to the mutable list `dst` has elements of a
// function set that `dst`'s closed function element needs copied (`listFnSetNeedsCopy`).
function listConstLitFnSet(x: i32, src: i32, dst: i32): boolean {
  if !(nodeAt(x) is ArrayLit) || src >= T.tys.length || dst >= T.tys.length {
    return false
  }
  const s = tyAt(src)
  const d = tyAt(dst)
  s is TyArray
    && d is TyArray
    && d.aRead != 1
    && listFnSetNeedsCopy(s.aElem, d.aElem)
}

// Whether element `se`, the read type of a re-pointed `let` of functions called at more than one
// type (`fnLetIsWide`), meets `de`, a closed function type: no instance shares that list, so the
// list must be copied, not aliased.
function listFnSetNeedsCopy(se: i32, de: i32): boolean {
  if se < 0 || de < 0 || se >= T.tys.length || de >= T.tys.length || se == de {
    return false
  }
  if !(tyAt(se) is TyFunc) || !(tyAt(de) is TyFunc) || tyHasHole(de) {
    return false
  }
  fnLetIsWide(se)
}

// The elements of a list literal, each judged by its own expression; a spread hands over the
// elements of an existing list, which carry no origin of their own, unless it spreads a list
// literal, whose elements are judged as this literal's own (D4871).
function listWidenLitElems(els: i32[], de: i32, depth: i32): boolean {
  let i = 0
  while i < els.length {
    const el = nodeAt(els[i])
    const sx = ctorExprOf(spreadArgOf(els[i]))
    const sl = if sx >= 0 { nodeAt(sx) } else { el }
    if sl is ArrayLit && sx >= 0 {
      if listWidenLitElems(sl.arrElems, de, depth - 1) { return true }
    } else if el is Spread {
      const st = nodeTyIxOf(el.spdArg)
      if st >= 0 && st < T.tys.length {
        const sa = tyAt(st)
        if sa is TyArray {
          if listWidenWalk(-1, sa.aElem, de, depth - 1, false) { return true }
        }
      }
    } else if listWidenWalk(els[i], nodeTyIxOf(els[i]), de, depth - 1, false) {
      return true
    }
    i = i + 1
  }
  false
}

// A record into a record: each field the destination declares, with its initializer when the
// source is an object literal. A record VALUE is shared, not rebuilt, so a list field whose
// element differs has no lowering even as a view (D2100): that pair is claimed outright.
function listWidenObj(x: i32, s: TyObj, dst: i32, depth: i32): boolean {
  const d = tyAt(dst)
  if d is TyObj {
    let lit = -1
    if x >= 0 {
      const ol = nodeAt(x)
      if ol is ObjLit { lit = x }
    }
    let i = 0
    while i < d.objFieldNames.length {
      const sf = objFieldType(s, d.objFieldNames[i])
      if sf >= 0 {
        const fx = objLitFieldExpr(lit, d.objFieldNames[i])
        if listWidenWalk(fx, sf, d.objFieldTypes[i], depth - 1, false) {
          return true
        }
        if lit < 0 && listSlotWidens(sf, d.objFieldTypes[i], 8) {
          shapeAdaptRecFieldSet(true)
          return listWidenClaimInner(sf, d.objFieldTypes[i], x)
        }
      }
      i = i + 1
    }
  }
  false
}

// Claim the first list pair inside `st` -> `dt` whose element differs, for the message.
function listWidenClaimInner(st: i32, dt: i32, x: i32): boolean {
  let s = st
  let d = dt
  let guard = 0
  while guard < 16 {
    const dn = tyAt(d)
    const sn = tyAt(s)
    if dn is TyNullable {
      d = dn.nInner
      if sn is TyNullable { s = sn.nInner }
    } else if dn is TyArray {
      if sn is TyArray {
        if listElemDiffers(sn.aElem, dn.aElem) {
          return listWidenClaim(x, s, d)
        }
        s = sn.aElem
        d = dn.aElem
      } else {
        return listWidenClaim(x, st, dt)
      }
    } else {
      return listWidenClaim(x, st, dt)
    }
    if s < 0 || d < 0 || s >= T.tys.length || d >= T.tys.length {
      return listWidenClaim(x, st, dt)
    }
    guard = guard + 1
  }
  listWidenClaim(x, st, dt)
}

// A map into a map. A map has no read-only view, so a key or value holding a list whose
// element widens is refused even into a `readonly` list: a store through the wider map puts a
// wider list where the narrower map's readers expect their own (D2161's r13). A list shared at
// its own element type (`string[]` into `readonly string[]`) passes.
function listWidenMap(
  x: i32,
  s: TyMap,
  src: i32,
  dst: i32,
  depth: i32,
): boolean {
  const d = tyAt(dst)
  if d is TyMap {
    if listWidenWalk(-1, s.mKey, d.mKey, depth - 1, false) { return true }
    if listWidenWalk(-1, s.mVal, d.mVal, depth - 1, false) { return true }
    const vw = listSlotWidens(s.mVal, d.mVal, 8)
    const kw = listSlotWidens(s.mKey, d.mKey, 8)
    if vw || kw {
      shapeAdaptMapSharedSet(true)
      return listWidenClaim(x, src, dst)
    }
  }
  false
}

// A function value: its result is covariant and its parameters contravariant, in the order
// `assignable`'s `TyFunc` arm compares them.
function listWidenFunc(s: TyFunc, dst: i32, depth: i32): boolean {
  const d = tyAt(dst)
  if d is TyFunc {
    if s.fnParamTypes.length != d.fnParamTypes.length { return false }
    if listWidenWalk(-1, s.fnRet, d.fnRet, depth - 1, false) { return true }
    let i = 0
    while i < s.fnParamTypes.length {
      if (
        listWidenWalk(
          -1,
          d.fnParamTypes[i],
          s.fnParamTypes[i],
          depth - 1,
          false,
        )
      ) {
        return true
      }
      i = i + 1
    }
  }
  false
}

// Does `st` -> `dt` pair a list with one whose element differs, anywhere inside, `readonly`
// or not? The shape a map value or record field cannot share.
function listSlotWidens(st: i32, dt: i32, depth: i32): boolean {
  if (
    st < 0
    || dt < 0
    || st >= T.tys.length
    || dt >= T.tys.length
    || depth <= 0
  ) {
    return false
  }
  if st == dt { return false }
  const d = tyAt(dt)
  match d {
    TyArray => {
      const se = tyArrayElemIx(st)
      if se < 0 { return false }
      if listElemDiffers(se, d.aElem) { return true }
      // A mutable list read as a view of a union or nullable element: a view stored back
      // through the wider slot may itself view a NARROWER list (D2161's r13).
      if d.aRead == 1 && !tyIxIsView(st) && elemAdmitsNarrowerShare(d.aElem) {
        return true
      }
      return listSlotWidens(se, d.aElem, depth - 1)
    }
    TyNullable => {
      return listSlotWidens(nonNulTyOf(st), d.nInner, depth - 1)
    }
    TyObj => {
      return listSlotWidensFields(st, d, depth)
    }
    TyMap => {
      return listSlotWidensEntries(st, d, depth)
    }
    // A leaf, a union or a function holds no list slot this rule shares.
    TyPrim | TyErr | TyFunc | TyUnion | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// `listSlotWidens` over each field `d` declares, when `st` is a record too.
function listSlotWidensFields(st: i32, d: TyObj, depth: i32): boolean {
  const s = tyAt(st)
  if s is TyObj {
    let i = 0
    while i < d.objFieldNames.length {
      const sf = objFieldType(s, d.objFieldNames[i])
      if sf >= 0 && listSlotWidens(sf, d.objFieldTypes[i], depth - 1) {
        return true
      }
      i = i + 1
    }
  }
  false
}

// `listSlotWidens` over a map's key and value, when `st` is a map too.
function listSlotWidensEntries(st: i32, d: TyMap, depth: i32): boolean {
  const s = tyAt(st)
  if s is TyMap {
    return listSlotWidens(s.mKey, d.mKey, depth - 1)
      || listSlotWidens(s.mVal, d.mVal, depth - 1)
  }
  false
}

// Do two list elements differ in a way a shared list cannot carry: a widened element, or a
// different storage class?
function listElemDiffers(se: i32, de: i32): boolean {
  listElemWidens(se, de) || containerElemClassDiffers(se, de)
}

// Set while `objShapeAdapterless` judges a pair whose destination is a union's member.
let objShapeAtArm = false

// `direct` — is the destination a slot a `(ref $src)` can be written into as it stands?
// True at a value flow, where a declared WasmGC supertype makes the reference fit. False
// wherever the pair sits under something whose own wasm type has to relate by identity — an
// array or map element, a function signature — since a struct-level `sub` edge does not reach those.
function objShapeAdapterless(
  srcExpr: i32,
  src: i32,
  dst: i32,
  depth: i32,
  direct: boolean,
): boolean {
  if src < 0 || dst < 0 || depth <= 0 { return false }
  if src == dst { return false }
  const s = tyAt(src)
  const d = tyAt(dst)
  // Nullable pairs peel exactly as `assignableGo`'s nullable arm does, and in its order.
  match d {
    TyNullable => {
      match s {
        TyNullable => {
          return objShapeAdapterless(-1, s.nInner, d.nInner, depth - 1, direct)
        }
        // a non-nullable source peels the destination alone
        TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
      }
      return objShapeAdapterless(srcExpr, src, d.nInner, depth - 1, direct)
    }
    // every other destination is decided below
    TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
  }
  // A union source is assignable when every member is, so any member needing an adapter
  // makes the whole flow one.
  match s {
    TyUnion => {
      const sms = s.uMembers
      let si = 0
      // A member wider than an arm of a union destination is re-tagged at run time (D15057).
      const memDirect = direct && tyAt(dst) is TyUnion
      while si < sms.length {
        if objShapeAdapterless(-1, sms[si], dst, depth - 1, memDirect) {
          return true
        }
        si = si + 1
      }
      return false
    }
    // every other source is decided below
    TyPrim | TyErr | TyObj | TyFunc | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
  }
  match d {
    TyUnion => {
      return objShapeUnionDstAdapts(srcExpr, src, d.uMembers, depth, direct)
    }
    // every other destination pairs with its source's kind below
    TyPrim | TyErr | TyObj | TyFunc | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
  }
  const cx = ctorExprOf(srcExpr)
  match s {
    TyObj => {
      match d {
        TyObj => {
          // A cost early-out, not a decision: `tyEq` is render-equality, so two equal object
          // types have equal ordered field-name lists, which `objFieldNameSetsEq` declines
          // anyway. Here because the identical pair is the overwhelmingly common one.
          if tyEq(src, dst) { return false }
          // A pair reaching an inference hole is not a pair of shapes yet. An un-annotated
          // parameter used only as `o.x` demands `{x: _}`, which looks like a width-subtyped
          // destination beside a two-field argument and is not one — the solve pins it from the
          // argument and it lowers.
          if objSrcReachesHoleFor(s, dst, 8) || tyReachesHole(dst, 8) {
            return false
          }
          if cx >= 0 {
            const ce = nodeAt(cx)
            if ce is ObjLit {
              if objShapeLitFieldsAdapt(ce, s, d, depth) { return true }
              // Falls through to the dropped-field decision: the exemption covers what "built
              // at the destination shape" buys, and a field the destination does not declare is
              // not in it. `emitObj` walks the destination's field list, so a lacked field is
              // never visited — its initializer never runs, a silently wrong evaluation count.
            }
          }
          // Agreeing field names, differing through a field — still adapterless, and one case
          // is worse than a hole: a field width pair (`{n: Wide}` into `{n: Narrow}`) is unsound
          // rather than unsupported, since a struct field is mutable. Not withdrawn here, since
          // the identical pair is correct for an un-annotated literal — the verdict turns on the source's provenance (D622).
          if objFieldNameSetsEq(src, dst) {
            return objShapeSameNamesAdapts(srcExpr, src, dst, cx)
          }
          // A pinned binding's literal runs the initializer of a field a record drops; no union
          // arm is built from a wider record (D3566).
          if recAdPinInit && !objShapeAtArm && litShapeDropSrcExpr(cx) {
            return false
          }
          // The width lift (D622): a `Wide` flowing into a `Narrow` whose fields are the first
          // of `Wide`'s, in the canonical layout order with identical types, needs no
          // conversion — `emitTypeSection` declares a `(sub)` edge, only at a `direct` position.
          // An object literal is not lifted: `emitObj` builds it at the destination's field list, so an excess field's initializer never runs.
          if direct && !litShapeDropSrcExpr(cx) && objWidthPrefix(src, dst) {
            return false
          }
          return objShapeAdaptNote(src, dst, cx, false, false)
        }
        // a source pairs only with a destination of its own kind
        TyPrim | TyErr | TyFunc | TyUnion | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
      }
      return false
    }
    TyArray => {
      match d {
        TyArray => {
          if cx >= 0 {
            const ae = nodeAt(cx)
            if ae is ArrayLit {
              return objShapeListLitAdapts(ae, dst, d.aElem, depth, direct)
            }
          }
          return objShapeListElemAdapts(src, dst, s, d, cx, depth)
        }
        // a source pairs only with a destination of its own kind
        TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyNullable | TyMap | TyVar | TyLit | TyNeg => {}
      }
      return false
    }
    TyMap => {
      match d {
        TyMap => {
          return objShapeMapPairAdapts(src, dst, s, d, cx, depth)
        }
        // a source pairs only with a destination of its own kind
        TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyNullable | TyArray | TyVar | TyLit | TyNeg => {}
      }
      return false
    }
    TyFunc => {
      match d {
        TyFunc => {
          return objShapeFuncPairAdapts(s, d, depth)
        }
        // a source pairs only with a destination of its own kind
        TyPrim | TyErr | TyObj | TyUnion | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
      }
      return false
    }
    // a union source returned above; no other source has an adapter
    TyPrim | TyErr | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {}
  }
  false
}

// Whether a field of record `s` reaches an inference hole, leaving out a function-typed field the
// record `dst` does not declare, at any record depth: a generic function stored there is closed,
// and does not move the width the pair is compared at (D6422).
function objSrcReachesHoleFor(s: TyObj, dst: i32, depth: i32): boolean {
  const d = tyAt(dst)
  let i = 0
  while i < s.objFieldTypes.length {
    const ft = s.objFieldTypes[i]
    let df = -1
    if d is TyObj { df = objFieldType(d, s.objFieldNames[i]) }
    if objFieldReachesHoleFor(ft, df, depth) { return true }
    i = i + 1
  }
  false
}

// The field half of `objSrcReachesHoleFor`: source field type `ft` beside destination field `df`
// (-1 when the destination does not declare it).
function objFieldReachesHoleFor(ft: i32, df: i32, depth: i32): boolean {
  if ft < 0 || ft >= T.tys.length { return false }
  if depth <= 0 { return tyReachesHole(ft, 7) }
  const f = tyAt(ft)
  if f is TyFunc && df < 0 { return false }
  if f is TyObj && df >= 0 && df < T.tys.length && tyAt(df) is TyObj {
    return objSrcReachesHoleFor(f, df, depth - 1)
  }
  tyReachesHole(ft, 7)
}

// Records the adapter pair `src` into `dst` (built at `cx`) for the refusal's wording, with
// whether the pair is an element pair or a field width pair. Always true: the flow adapts.
function objShapeAdaptNote(
  src: i32,
  dst: i32,
  cx: i32,
  elemPair: boolean,
  widthField: boolean,
): boolean {
  shapeAdaptSrcTySet(src)
  shapeAdaptDstTySet(dst)
  shapeAdaptSrcExprSet(cx)
  shapeAdaptElemPairSet(elemPair)
  shapeAdaptWidthFieldSet(widthField)
  true
}

// A union target accepts the source at some member of `dms`. It is adapterless only when no
// accepting member is: one clean member is a lowering.
function objShapeUnionDstAdapts(
  srcExpr: i32,
  src: i32,
  dms: i32[],
  depth: i32,
  direct: boolean,
): boolean {
  let di = 0
  let anyClean = false
  let anyAdapts = false
  const atArm = objShapeAtArm
  objShapeAtArm = true
  while di < dms.length {
    if assignable(src, dms[di]) {
      if objShapeAdapterless(srcExpr, src, dms[di], depth - 1, direct) {
        anyAdapts = true
      } else {
        anyClean = true
      }
    }
    di = di + 1
  }
  objShapeAtArm = atArm
  if anyClean { return false }
  anyAdapts
}

// The object literal `ce` is rebuilt at `d`; its field values still have to fit the
// destination field types, judged with their own expressions. True when one needs an adapter.
function objShapeLitFieldsAdapt(
  ce: ObjLit,
  s: TyObj,
  d: TyObj,
  depth: i32,
): boolean {
  const dnames = d.objFieldNames
  const dtys = d.objFieldTypes
  let li = 0
  while li < dnames.length {
    const sft = objFieldType(s, dnames[li])
    if sft >= 0 {
      let fexpr = -1
      const fl = ce.objFields
      let fi = 0
      while fi < fl.length {
        const fn = nodeAt(fl[fi])
        if fn is FieldInit {
          if fn.fiName == dnames[li] { fexpr = fn.fiValue }
        }
        fi = fi + 1
      }
      if objShapeAdapterless(fexpr, sft, dtys[li], depth - 1, true) {
        return true
      }
    }
    li = li + 1
  }
  false
}

// Two records of agreeing field names adapt only where a field pair is a width pair and the
// source is not a rebuilt literal: the axis is provenance, since the types alone would refuse
// the correct un-annotated literal. A mutable struct field is WasmGC-invariant (D938).
function objShapeSameNamesAdapts(
  srcExpr: i32,
  src: i32,
  dst: i32,
  cx: i32,
): boolean {
  if (
    !litShapeDropSrcExpr(cx)
    && !srcIsUnannotatedObjBinding(srcExpr)
    && objFieldWidthPair(src, dst)
  ) {
    return objShapeAdaptNote(src, dst, cx, false, true)
  }
  false
}

// A list literal delivered as a list: each element is judged against `dElem` with its own
// expression, and a spread of a list literal, fresh too, against the list `dst` (D4871).
function objShapeListLitAdapts(
  ae: ArrayLit,
  dst: i32,
  dElem: i32,
  depth: i32,
  direct: boolean,
): boolean {
  const els = ae.arrElems
  let ei = 0
  while ei < els.length {
    const sx = ctorExprOf(spreadArgOf(els[ei]))
    const sp = nodeAt(els[ei])
    if sx >= 0 && nodeAt(sx) is ArrayLit {
      if (objShapeAdapterless(sx, nodeTyIxOf(sx), dst, depth - 1, direct)) {
        return true
      }
    } else if sp is Spread {
      // An existing list's elements are existing records, handed over one at a time (D13960).
      const se = tyArrayElemIx(nodeTyIxOf(sp.spdArg))
      if se >= 0 && objShapeAdapterless(-1, se, dElem, depth - 1, true) {
        return true
      }
    } else if (
      objShapeAdapterless(els[ei], nodeTyIxOf(els[ei]), dElem, depth - 1, true)
    ) {
      return true
    }
    ei = ei + 1
  }
  false
}

// A list pair other than a literal: the nested pair first, so an object pair keeps its precise
// wording, then the element's storage class. Only a `readonly` destination over an unwritten
// source takes the converting copy (D965); an unknown write state refuses.
function objShapeListElemAdapts(
  src: i32,
  dst: i32,
  s: TyArray,
  d: TyArray,
  cx: i32,
  depth: i32,
): boolean {
  if objShapeAdapterless(-1, s.aElem, d.aElem, depth - 1, false) { return true }
  if (
    containerElemClassDiffers(s.aElem, d.aElem)
    || (d.aRead == 0 && unionElemMemberWidens(s.aElem, d.aElem))
  ) {
    if d.aRead == 1 && scalarElemWidenServed(s.aElem, d.aElem) {
      if cx < 0 {
        shapeAdaptNestedCopySet(true)
      } else if (covarValueWriteState(cwKeyOfRoot(cx)) == 0) {
        if !covarRootFreshLocal(cx) { noteScalarView(s.aElem, d.aElem) }
        return false
      }
    }
    return objShapeAdaptNote(src, dst, cx, true, false)
  }
  false
}

// A map pair adapts through its key or value pair, a differing storage class of either, or a
// value box or union member the shared map cannot carry.
function objShapeMapPairAdapts(
  src: i32,
  dst: i32,
  s: TyMap,
  d: TyMap,
  cx: i32,
  depth: i32,
): boolean {
  if objShapeAdapterless(-1, s.mKey, d.mKey, depth - 1, false) { return true }
  if objShapeAdapterless(-1, s.mVal, d.mVal, depth - 1, false) { return true }
  if containerElemClassDiffers(s.mKey, d.mKey) {
    return objShapeAdaptNote(src, dst, cx, true, false)
  }
  if (
    containerElemClassDiffers(s.mVal, d.mVal)
    || mapValBoxDiffers(s.mVal, d.mVal)
    || unionElemMemberWidens(s.mVal, d.mVal)
    || mapValIntLitNulls(s.mVal, d.mVal)
  ) {
    return objShapeAdaptNote(src, dst, cx, true, false)
  }
  false
}

// Whether map value `se`, an integer literal or a union of them, is delivered as a value `de`
// that adds `null`: the source is stored as `i32` and the destination boxed (D2713).
function mapValIntLitNulls(se: i32, de: i32): boolean {
  if se < 0 || de < 0 || se >= T.tys.length || de >= T.tys.length {
    return false
  }
  if tyBearsNull(se) || !tyBearsNull(de) { return false }
  const t = tyAt(se)
  match t {
    TyLit => {
      return t.litKind == "int"
    }
    TyUnion => {
      if t.uMembers.length < 1 { return false }
      for m in t.uMembers {
        const mt = if m >= 0 && m < T.tys.length { tyAt(m) } else { null }
        if !(mt is TyLit) || mt.litKind != "int" { return false }
      }
      return true
    }
    // Any other value is no integer literal.
    TyPrim | TyErr | TyObj | TyFunc | TyNullable | TyArray | TyMap | TyVar | TyNeg => {
      return false
    }
  }
}

// A function pair adapts through its result or any parameter. Parameters compare
// contravariantly, in `assignable`'s `TyFunc` operand order, so the pair examined is the pair
// it accepted.
function objShapeFuncPairAdapts(s: TyFunc, d: TyFunc, depth: i32): boolean {
  const sp = s.fnParamTypes
  const dp = d.fnParamTypes
  if sp.length != dp.length { return false }
  if objShapeAdapterless(-1, s.fnRet, d.fnRet, depth - 1, false) { return true }
  let pi = 0
  while pi < sp.length {
    if objShapeAdapterless(-1, dp[pi], sp[pi], depth - 1, false) { return true }
    pi = pi + 1
  }
  false
}

// The `readonly` spelling of `dst` that `src` could be delivered to — every list on the way to
// the widened one made a view — or -1 when this checker would refuse that too, so a message
// never offers a fix that does not build. `srcExpr` keeps the delivery's own write licence.
function readonlyFixOf(
  srcExpr: i32,
  src: i32,
  dst: i32,
  pairS: i32,
  pairD: i32,
): i32 {
  const ro = viewifyLists(src, dst, 8)
  if ro < 0 || ro == dst { return -1 }
  // A readonly copy is licensed where nothing writes the source (D791); the emitter decides a
  // record-into-union copy, so the offer asks the same licence rather than promise it.
  if pairS < 0 || pairD < 0 || pairS >= T.tys.length || pairD >= T.tys.length {
    return -1
  }
  const ps = tyAt(pairS)
  const pd = tyAt(pairD)
  if ps is TyArray {
    if pd is TyArray {
      // A view shares its records, so it serves none that stores a field differently.
      if recStorageFieldOf(ps.aElem, pd.aElem) != "" { return -1 }
      if listPairNeedsCopy(ps.aElem, pd.aElem) {
        const rx = parenPeelIx(srcExpr)
        if covarValueWriteState(cwKeyOfRoot(rx)) != 0 { return -1 }
      }
    }
  }
  if !assignable(src, ro) { return -1 }
  const sS = shapeAdaptSrcTy
  const sD = shapeAdaptDstTy
  const sX = shapeAdaptSrcExpr
  const sE = shapeAdaptElemPair
  const sW = shapeAdaptWidthField
  const nC = shapeAdaptNulCopy
  const nN = shapeAdaptNestedCopy
  const nM = shapeAdaptMapShared
  const nR = shapeAdaptRecField
  const nS = shapeAdaptRecStorage
  const nF = shapeAdaptRecStorageField
  const bad = covarWriteThrough(srcExpr, src, ro) != 0
    || objShapeAdapterlessAt(srcExpr, src, ro)
  shapeAdaptRecFieldSet(nR)
  shapeAdaptRecStorageSet(nS)
  shapeAdaptRecStorageFieldSet(nF)
  shapeAdaptSrcTySet(sS)
  shapeAdaptDstTySet(sD)
  shapeAdaptSrcExprSet(sX)
  shapeAdaptElemPairSet(sE)
  shapeAdaptWidthFieldSet(sW)
  shapeAdaptNulCopySet(nC)
  shapeAdaptNestedCopySet(nN)
  shapeAdaptMapSharedSet(nM)
  if bad { return -1 }
  ro
}

// The message for an `objShapeAdapterless` pair. Names the object pair that has no lowering
// and the fields that make it one, not the container that carried it (reported separately),
// then the two ways out: a constructor is built at the shape it flows into, or the source
// can be spelled at the target's shape.
export function objShapeAdapterlessErr(srcExpr: i32, src: i32, dst: i32) {
  let sT = shapeAdaptSrcTy
  let dT = shapeAdaptDstTy
  let sX = shapeAdaptSrcExpr
  if sT < 0 || dT < 0 {
    sT = src
    dT = dst
    sX = srcExpr
  }
  // A repeated key or a field the record type declares twice is refused at the repeat
  // itself; its second slot is not a field to drop.
  if objLitHasDupKey(sX) || objLitHasDupKey(srcExpr) { return 0 }
  if objTyHasDupField(dT) || objTyHasDupField(dst) { return 0 }
  let through = ""
  if !tyEq(sT, src) || !tyEq(dT, dst) {
    through = " (reached through "
      + tyToStr(src)
      + " into "
      + tyToStr(dst)
      + ")"
  }
  if shapeAdaptRecStorage {
    recStorageErr(srcExpr, sT, dT, sX, through)
    return 0
  }
  // An object literal gets its own wording: "construct at the destination shape" is what
  // the author already did, but what actually happens is silent — dropping the excess
  // field's initializer unevaluated. The container-element wording instead names what
  // changed: how the element is stored — not a capability gap, since a struct field is WasmGC-invariant (D938).
  if shapeAdaptWidthField {
    objShapeWidthFieldErr(srcExpr, sT, dT, through)
    return 0
  }
  if shapeAdaptElemPair {
    objShapeElemPairErr(srcExpr, src, dst, sT, dT, sX, through)
    return 0
  }
  if litShapeDropSrcExpr(sX) {
    objLitUndeclaredErr(srcExpr, sT, dT, through)
  } else {
    objShapeDropUnsupportedErr(srcExpr, sT, dT, through)
  }
}

// The refusal of a value of record `sT` delivered into the record `dT`, which lacks a field it has:
// no field-dropping conversion is built. `through` names the carrying pair, or is "".
function objShapeDropUnsupportedErr(
  at: i32,
  sT: i32,
  dT: i32,
  through: string,
) {
  tErrUnsupported(
    "an object value of shape "
      + tyToStr(sT)
      + " flowing into "
      + tyToStr(dT)
      + through
      + " drops the field "
      + objDroppedFieldList(sT, dT)
      + ": type-valid (structural width subtyping) but not yet supported by codegen — a "
      + "struct's wasm type is its own field list, so these are unrelated types and no "
      + "field-dropping conversion exists. Construct the value at "
      + tyToStr(dT)
      + " (an object literal is built at the shape it flows into), or declare the source "
      + "with exactly "
      + tyToStr(dT)
      + "'s fields",
    at,
  )
}

// The width-field refusal: `sT` and `dT` agree on field names but differ inside a field,
// which a mutable struct field cannot reconcile. `through` names the carrying pair, or is "".
function objShapeWidthFieldErr(
  srcExpr: i32,
  sT: i32,
  dT: i32,
  through: string,
) {
  tErr(
    "an object of type "
      + tyToStr(sT)
      + " cannot flow into "
      + tyToStr(dT)
      + through
      + ": they agree on field names but differ INSIDE a field, and a struct field is "
      + "mutable — writing through the narrower view would leave the original holding a "
      + "value of the wrong type, so the two are unrelated by design and not by a missing "
      + "lowering. Give the source exactly "
      + tyToStr(dT)
      + "'s field types, or read the field out and rebuild",
    srcExpr,
  )
  0
}

// The container-element refusal for `sT` into `dT`, delivered as `src` into `dst`.
// A design rule, not a missing lowering (DECISIONS.md §"No implicit container widening").
// A mutable list pair `readonly` would accept names both fixes; a readonly copy pair is
// refused only because the source is written, so that message names the write.
function objShapeElemPairErr(
  srcExpr: i32,
  src: i32,
  dst: i32,
  sT: i32,
  dT: i32,
  sX: i32,
  through: string,
) {
  let rule = ": a container never widens implicitly. Its elements would have to be stored "
    + "differently, which takes a copy, and a write through the copy would no longer reach "
    + "the original."
  let hint = containerWidenCopyHint(sT, dT)
  // The whole delivered value built at the type it flows into, as its own declaration
  // spells it — every fix names a type the author can write at the source.
  const buildFix = " Build the source as `" + tyToStr(sourceBuildTy(dst)) + "`"
  // An inner list spelled in the source (a literal's element or field) can still be copied
  // with `.map`; one reached only through a type is built at the outer type instead.
  const innerNamed = !(through != "" && sX < 0)
  if !innerNamed { hint = "" }
  const pairNote = tyToStr(sT) + " is not " + tyToStr(dT) + through
  let copyFix = buildFix
  if hint != "" { copyFix = " Copy it" + hint.slice(12, hint.length) }
  if shapeAdaptNulCopy || shapeAdaptNestedCopy {
    tErr(pairNote + containerCopyGapWhy(shapeAdaptNulCopy) + copyFix, srcExpr)
    return 0
  }
  if shapeAdaptMapShared {
    tErr(
      pairNote
        + ": a map never widens a list it holds, and it has no read-only view, so every handle "
        + "would share entries of two types."
        + buildFix,
      srcExpr,
    )
    return 0
  }
  if shapeAdaptRecField {
    tErr(
      pairNote
        + ": a record is shared, not rebuilt, so its list field would have to change type in "
        + "place, which no delivery does, readonly or not (D2100)."
        + buildFix,
      srcExpr,
    )
    return 0
  }
  if containerWidenReadonlyServes(sT, dT) {
    objShapeReadonlyFixErr(srcExpr, src, dst, sT, dT, pairNote, hint, copyFix)
    return 0
  }
  if through == "" && containerWidenServed(sT, dT) {
    const wAt = covarValueWriteAt(cwKeyOfRoot(sX))
    let written = "nothing shows this list is never written, and a container that may be "
      + "written"
    if wAt >= 0 {
      written = "this list is written (line "
        + i32ToStr(nodeLineOf(wAt))
        + "), and a written container"
    }
    rule = " here: "
      + written
      + " never widens implicitly. Its elements would have to be stored differently, which "
      + "takes a copy, and a write would not reach both."
  }
  // A pair reached through a literal spelled in the source is fixed at that inner value.
  let fixes = buildFix
  if through != "" && hint != "" { fixes = copyFix }
  else if hint != "" { fixes = fixes + hint }
  tErr(tyToStr(sT) + " is not " + tyToStr(dT) + through + rule + fixes, srcExpr)
  0
}

// The container-element refusal where a `readonly` destination is covariant: offers that
// destination when this checker accepts it for this delivery, else `copyFix`.
function objShapeReadonlyFixErr(
  srcExpr: i32,
  src: i32,
  dst: i32,
  sT: i32,
  dT: i32,
  pairNote: string,
  hint: string,
  copyFix: string,
) {
  const ro = readonlyFixOf(srcExpr, src, dst, sT, dT)
  let fix = ""
  if ro >= 0 {
    fix = " Declare the destination `" + tyToStr(ro) + "` for a read-only view"
    if hint != "" { fix = fix + hint }
  } else {
    fix = copyFix
  }
  tErr(
    pairNote
      + ": a container never widens implicitly, and only a readonly list is covariant. "
      + containerWidenWhy(sT, dT)
      + fix,
    srcExpr,
  )
  0
}

// The record storage rule's refusal: names the pair, the field stored differently, and both
// fixes: build the source at the destination, or copy it with an object literal.
function recStorageErr(at: i32, sT: i32, dT: i32, sX: i32, through: string) {
  const fnm = shapeAdaptRecStorageField
  let fieldNote = ""
  const s = tyAt(sT)
  const d = tyAt(dT)
  if s is TyObj {
    if d is TyObj {
      const sf = objFieldType(s, fnm)
      const df = objFieldType(d, fnm)
      if sf >= 0 && df >= 0 {
        fieldNote = " (`" + tyToStr(sf) + "` into `" + tyToStr(df) + "`)"
      }
    }
  }
  const copy = recCopyLitText(dT, covarRootName(sX))
  recAdRaising = true
  tErr(
    tyToStr(sT)
      + " is not "
      + tyToStr(dT)
      + through
      + ": they store field `"
      + fnm
      + "` differently"
      + fieldNote
      + ", and a record is shared, not copied, so only a fresh record widens. A write through "
      + "the "
      + tyToStr(dT)
      + " would break the "
      + tyToStr(sT)
      + ". Build the source as `"
      + tyToStr(dT)
      + "`, or copy it with a literal `"
      + copy
      + "`",
    at,
  )
  recAdRaising = false
  0
}

// The refusal of an object literal setting a field its destination record does not declare.
export function objLitUndeclaredErr(
  at: i32,
  sT: i32,
  dT: i32,
  through: string,
) {
  tErr(
    "this object literal sets "
      + objDroppedFieldList(sT, dT)
      + ", which "
      + tyToStr(dT)
      + " does not declare"
      + through
      + ": a literal is built at the shape it flows into, so the extra field would be "
      + "dropped and its initializer never evaluated — a call there would never run. "
      + "Remove the field, or declare it on "
      + tyToStr(dT),
    at,
  )
}

// The bound's members, as three parallel columns filled in source order: `names[i]`, `tys[i]`
// (the call's function type for a method, or the field's declared type for a colon member),
// and `isMethod[i]`. A zero-ary closure field satisfies a method bound by construction, but not
// the converse — a UFCS-satisfied value carries no closure (`docs/constraints-design.md` OQ-1).
export function boundMembersOf(
  root: i32,
  names: string[],
  tys: i32[],
  isMethod: boolean[],
) {
  if root < 0 { return 0 }
  const start = tsKidStart[root]
  const cnt = tsKidCount[root]
  let i = 0
  while i < cnt {
    const kid = tsKids[start + i]
    const k = tsKind[kid]
    if k == TS_METHOD {
      const ks = tsKidStart[kid]
      const kc = tsKidCount[kid]
      const ptys: i32[] = []
      let p = 0
      while p < kc - 1 {
        ptys.push(tsToTy(tsKids[ks + p]))
        p = p + 1
      }
      names.push(tsText[kid])
      tys.push(mkFuncTy(ptys, tsToTy(tsKids[ks + kc - 1])))
      isMethod.push(true)
    } else if k == TS_FIELD {
      names.push(tsText[kid])
      tys.push(tsToTy(tsKids[tsKidStart[kid]]))
      isMethod.push(false)
    }
    i = i + 1
  }
  0
}

// The member list a bound offers, rendered for a diagnostic: `toString(), n`.
export function boundMemberList(root: i32) {
  const bn: string[] = []
  const bt: i32[] = []
  const bm: boolean[] = []
  boundMembersOf(root, bn, bt, bm)
  let out = ""
  let i = 0
  while i < bn.length {
    if i > 0 { out = out + ", " }
    out = out + bn[i]
    if bm[i] { out = out + "()" }
    i = i + 1
  }
  out
}

// Record this site's witness for (generic, instantiation type, member) and refuse
// a DISAGREEMENT, naming both sites and both witnesses. Returns true when the row
// is coherent (including the first time it is written).
export function cohRecord(
  who: string,
  tyKey: string,
  memberName: string,
  wit: string,
  ix: i32,
) {
  const key = who + "#" + tyKey + "#" + memberName
  let i = 0
  while i < cohKeys.length {
    if cohKeys[i] == key {
      if cohWitness[i] == wit { return true }
      tErr(
        "incoherent bound: `"
          + who
          + "` instantiated at `"
          + tyKey
          + "` resolves `"
          + memberName
          + "` to `"
          + cohWitness[i]
          + "` at line "
          + i32ToStr(cohSiteLine[i])
          + ":"
          + i32ToStr(cohSiteCol[i] + 1)
          + " and to `"
          + wit
          + "` here — one generic at one type must have ONE witness across the whole program",
        ix,
      )
      return false
    }
    i = i + 1
  }
  cohKeys.push(key)
  cohWitness.push(wit)
  let ln = 0
  let co = 0
  if ix >= 0 && ix < nodeToks.length {
    const tk = nodeToks[ix]
    if tk >= 0 && tk < P.toks.length {
      ln = P.toks[tk].line
      co = P.toks[tk].col
    }
  }
  cohSiteLine.push(ln)
  cohSiteCol.push(co)
  true
}

// The refusal a strict body raises, naming the bound and what it offers. Returns
// "" when the receiver is not a bounded type parameter, so the caller keeps its
// existing (unbounded) answer.
export function boundMemberFloorMsg(tvName: string, prop: string) {
  const bAnn = tpBoundOfName(tvName)
  if bAnn < 0 { return "" }
  const root = boundObjRootOf(bAnn)
  if root < 0 { return "" }
  const offers = boundMemberList(root)
  let has = "nothing"
  if offers.length > 0 { has = "`" + offers + "`" }
  "no `"
    + prop
    + "` on `"
    + tvName
    + "` — its bound `"
    + boundText(bAnn)
    + "` grants "
    + has
}

// Every type-parameter receiver's floor (`memberFloorMsg`'s `TyVar` rung). The domain is
// exactly "the annotation is not a bound" — `boundObjRootOf` answering -1 — since an unbounded
// `<T>` routes to inference before this rung and a real bound missing the member is answered
// one line up. Says only that: "…is not a type with members" is false of a field-member alias, which has members and simply declares no method ones.
export function tpMemberFloorMsg(tvName: string, prop: string) {
  const bMsg = boundMemberFloorMsg(tvName, prop)
  if bMsg != "" { return bMsg }
  // An inference HOLE is not a declared parameter and owns no bound to name: it carries a
  // minted `?`-name the author never wrote, and `checkMemberNode` grows its shape rather
  // than reaching this floor. `memberFloorErr`'s own floor words it if one ever does.
  if tvName.length == 0 { return "" }
  if tvName[0] == '?' { return "" }
  "no `"
    + prop
    + "` on `"
    + tvName
    + "` — `"
    + boundText(tpBoundOfName(tvName))
    + "` is not a bound"
}

// Joins the return witness `g` into `inferObserved`; `lit` says it is a literal.
export function inferRetJoin(g: i32, lit: boolean) {
  // A witness holding no number (a `null`, a string) neither adapts nor keeps a join apart;
  // a list that already exists keeps its own storage, so it is never neutral.
  const neutral = !tyHoldsNumericPrim(g)
    && !tyHasTyVar(g)
    && (lit || !(tyAt(nonNullTy(g)) is TyArray))
  if inferObserved < 0 {
    inferObservedSet(g)
    inferObservedLitSet(neutral || lit)
    return 0
  }
  njApartRetSet(!inferObservedLit && !lit)
  inferObservedSet(
    keepListStorage(
      inferObserved,
      !inferObservedLit,
      g,
      !lit,
      joinRetTys(inferObserved, g),
    ),
  )
  if njApartRet { markTpJoinApart(inferObserved) }
  njApartRetSet(false)
  if !neutral { inferObservedLitSet(inferObservedLit && lit) }
  0
}

export function matchArmTally(
  ix: i32,
  body: i32,
  armTy: i32,
  acc: i32,
  accLit: boolean,
  lit: boolean,
): i32 {
  if ix < 0 || stmtAlwaysExits(body) { return acc }
  if ifArmGivesNoValue(body, armTy) {
    ifNoValueAtSetAt(ix, true)
    return acc
  }
  const v = f32ArmPlainTy(body, ifArmValTy(body, armTy))
  if acc < 0 { return v }
  joinArmLit(acc, accLit, v, lit)
}

// The type a valued `if` or `match` at `ix` joined to `join` takes instead, or -1: the
// destination banked for `ix` when every arm fits it (DV-1207). A `T | null` destination is
// banked as `T` (`seedExpected`), so the non-null arms adopt `T` and a `null` arm makes the join
// `T | null`; a type parameter, or a `null` the seed left in a union, keeps the join's own type.
export function litJoinOf(ix: i32, join: i32, arms: i32[], tys: i32[]): i32 {
  const jw = joinWantAt.get(ix) ?? -1
  if jw < 0 || join < 0 || tyHasTyVar(jw) || assignable(join, jw) { return -1 }
  if tyHasNullMember(jw) { return -1 }
  let nul = false
  let i = 0
  while i < arms.length {
    if tys[i] == TY_NULL { nul = true }
    else if !joinArmFits(arms[i], tys[i], jw) { return -1 }
    i = i + 1
  }
  if nul && assignable(join, mkNullableTy(jw)) { return -1 }
  joinByWant.set(ix, true)
  i = 0
  while i < arms.length {
    if tys[i] != TY_NULL { joinArmDeliver(arms[i], tys[i], jw) }
    i = i + 1
  }
  if nul { return mkNullableTy(jw) }
  jw
}

// Delivers the tail of an arm a join adopted `jw` for, when its own type does not already fit,
// so the literal it ends in is built at `jw` as it would be at a binding of that type.
function joinArmDeliver(arm: i32, armTy: i32, jw: i32) {
  const tail = joinArmTail(arm)
  if tail < 0 || armTy < 0 || assignable(armTy, jw) { return 0 }
  checkerForceFn(1, tail, armTy, jw)
  0
}

// The inferred-return refusal, anchored at the END of the body it could not infer from — the
// one raise exempt from the node-span rule. It is a whole-body verdict and usually a
// consequence of an error inside that body, and the report is position-ordered: at the
// function's name it would print above its own cause.
export function inferNoBasisErr(name: string, fnIx: i32, body: i32) {
  const msg = "cannot infer a return type for '"
    + name
    + "' — annotate a return type"
  const tk = nodeLastTok(body)
  if tk >= 0 { return tErrPushTok(msg, fnIx, tk, "", "") }
  tErr(msg, fnIx)
  0
}

// The declared type name whose shape structurally equals object type `obj`, found by
// scanning the program's `TypeDecl`s (`cUserTypes` is a `Map` the compiler subset cannot
// iterate). Structural equality is bidirectional assignability, so a 1-field `{meow}` does
// not match a 2-field `Cat = {meow, foo}`. "" if no named type matches.
export function nominalNameOfObj(obj: i32, stmts: i32[]) {
  const i = nominalDeclAtOfObj(obj, stmts, 0)
  if i < 0 { return "" }
  const s = nodeAt(stmts[i])
  if s is TypeDecl { return s.tdName }
  ""
}

// The index in `stmts`, from `from` on, of the first `TypeDecl` whose shape structurally
// equals object type `obj`, or -1.
export function nominalDeclAtOfObj(obj: i32, stmts: i32[], from: i32): i32 {
  let i = from
  while i < stmts.length {
    const s = nodeAt(stmts[i])
    if s is TypeDecl {
      const nmHit = cUserTypes[s.tdName]
      if nmHit is i32 {
        const ti = nmHit
        if ti >= 0 {
          const tt = tyAt(ti)
          if tt is TyObj {
            if assignable(obj, ti) && assignable(ti, obj) { return i }
          }
        }
      }
    }
    i = i + 1
  }
  -1
}

// The emitter-format name of an inferred nullable-ref return `er` — `P | null` (the struct
// inner reverse-mapped to its user-type name) or `string | null`. `synthRetAnnots` pins a
// nullable-returning closure to this so its `$fnsig` result keys the nullable token and the
// value call's `ref.cast` resolves. "" unless `er` is a nullable whose inner the emitter lowers.
export function nullableRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  const t = tyAt(er)
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return "" }
    const it = tyAt(t.nInner)
    if it is TyObj {
      const nm = nominalNameOfObj(t.nInner, stmts)
      // Non-spaced (`P|null`) — the emitter's internal convention (`nullablePartOf`), not the
      // spaced `tyToStr` render. A declared name is one atom, `null` the second (#1115).
      if nm != "" { return irAtoms(nm + "|null", 2) }
      // An inline shape with no matching `TypeDecl` renders as emitter-format shape text, so
      // `structIndexOfTypeName` resolves it by field set to the struct index the annotation keys.
      const inm = tyToEmitName(t.nInner)
      // The enclosing `it is TyObj` arm already rules out a map, so testing whether the render
      // came back at all is enough — no need to re-parse it for shape-openness.
      if inm != "" {
        // The `{…}` shape's separators all sit inside the braces (the renderer reports
        // its own width); `null` adds one atom (#1115).
        return irAtoms(inm + "|null", tyNameAtoms + 1)
      }
    } else if it is TyFunc {
      // A nullable-closure return (kind 19): the fat-pointer made nullable, rendered
      // parenthesized and non-spaced so `nullablePartOf` recognizes it (`((i32)=>K0)|null`).
      let ips = ""
      const pts = it.fnParamTypes
      let pj = 0
      while pj < pts.length {
        const pn = tyToEmitName(pts[pj])
        if pn == "" { return "" }
        if pj > 0 { ips = ips + "," }
        ips = ips + pn
        pj = pj + 1
      }
      let irs = litUnionAliasNameOfTy(it.fnRet)
      if irs == "" { irs = tyToEmitName(it.fnRet) }
      // The grouped closure is one atom (its separators and its `=>` sit inside the parens);
      // `null` is the second (#1115).
      if irs != "" { return irAtoms("((" + ips + ")=>" + irs + ")|null", 2) }
    } else if tyIsNulI32BackedListInner(t.nInner) {
      // The nullable i32-backed list (kind 15) reps as the shared list wrapper made nullable;
      // rendered non-spaced so `nullablePartOf` and `synthRetAnnots`'s pin both recognize it.
      const lnm = tyToEmitName(t.nInner)
      return irAtoms(lnm + "|null", tyNameAtoms + 1)
    } else if it is TyMap {
      // The nullable map (kind 3 struct made nullable) admits any string-keyed non-`Set` map,
      // not just the mono i32-valued shape (D956) — resolved through `inferredRetMapSlot`.
      let mapOk = false
      if it.mSet == 0 { mapOk = tyIsPrimNamed(it.mKey, "string") }
      const mnm = tyToEmitName(t.nInner)
      if mapOk && mnm != "" { return irAtoms(mnm + "|null", tyNameAtoms + 1) }
    } else if tyIsPrimNamed(t.nInner, "string") {
      return irAtoms("string|null", 2)
    } else if tyIsPrimNamed(t.nInner, "boolean") {
      // The boolean niche (`boolean | null`): the i32 sentinel rep (2 = null), matching what
      // `emitReturnValue`'s `tyIsNulBool` arm expects for a `return null` / `return <bool>`.
      return irAtoms("boolean|null", 2)
    }
  }
  ""
}

// A20: the emitter reads this to classify an un-annotated function's return from its
// inferred type name rather than re-deriving from the return expression. Records an
// inferred-return entry: pushes the parallel arrays and the by-name map (first-wins).
// Every producer push goes through here so the map stays in sync.
export function recordInferRet(
  name: string,
  ty: string,
  tyIx: i32,
  atoms: i32,
  rung: i32,
) {
  // The reader half of D1645's rule: the map is keyed by NAME, and the empty name is
  // every anonymous lambda at once, so a row banked under it would answer for all of
  // them. An anonymous lambda has no name to record a return against — refuse the key.
  if name.length == 0 { return 0 }
  if !inferRetIdx.has(name) { inferRetIdx[name] = inferRetFn.length }
  inferRetFn.push(name)
  inferRetTy.push(ty)
  // Banks the recorded name's top-level atom count from `atoms` — the caller's own join
  // width, never re-scanned from the string (a litunion member is one atom, several in the arena).
  inferRetAtomCount.push(atoms)
  inferRetTyIx.push(tyIx)
  if rung == IR_RUNG_STRUCT_UNION || rung == IR_RUNG_VARIANT_BOX {
    inferRegisterNominalTwins(tyIx)
  }
  0
}

// Records `er` under `key` as the `null` type when bare `null` is its only value, including a
// never-filled infer-null hole (`TyNullable(-1)`, D1576); false, recording nothing, otherwise.
// The one rung a named function and an anonymous lambda share, so both rep it as `nullref`.
export function recordInferRetNullOnly(key: string, er: i32): boolean {
  if er < 0 { return false }
  let isNull = tyToStructStr(er) == "null"
  const t = tyAt(er)
  if t is TyNullable {
    if t.nInner < 0 { isNull = true }
  }
  if !isNull { return false }
  // `TY_NULL`, not `er`: the hole's `er` has no inner a downstream read could take.
  recordInferRet(key, "null", TY_NULL, 1, IR_REC_NULL_ONLY)
  true
}

// Records `dstTy` at each list value `srcExpr` delivers into a list of another element type: the
// emitter converts it there when the two element storages differ. A literal is built at its
// destination, so the record goes on its elements and fields instead.
export function recordListCopy(srcExpr: i32, srcTy: i32, dstTy: i32) {
  listCopyAt(srcExpr, srcTy, dstTy, REC_STORE_DEPTH)
}

// `recordListCopy` to `depth` literals deep.
function listCopyAt(srcExpr: i32, srcTy: i32, dstTy: i32, depth: i32) {
  const dst = nonNulTyOf(dstTy)
  if srcExpr < 0 || srcTy < 0 || dst < 0 || srcTy >= T.tys.length || depth < 0 {
    return 0
  }
  const dt = tyAt(dst)
  for lf in valueTailLeaves(srcExpr) {
    if lf < 0 { continue }
    const ln = nodeAt(parenPeelIx(lf))
    if ln is ObjLit {
      if dt is TyObj {
        for fx in ln.objFields {
          const fi = nodeAt(fx)
          if fi is FieldInit {
            const df = objFieldType(dt, fi.fiName)
            if df >= 0 {
              listCopyAt(fi.fiValue, nodeTyOf(fi.fiValue), df, depth - 1)
            }
          }
        }
      }
    } else if ln is ArrayLit {
      if dt is TyArray {
        for ex in ln.arrElems {
          if !(nodeAt(ex) is Spread) {
            listCopyAt(ex, nodeTyOf(ex), dt.aElem, depth - 1)
          }
        }
      }
    } else if coerceRecordOpen() && listTysElemDiffer(nodeTyOf(lf), dst) {
      // The generic pass records the open destination, which each instance closes.
      while listCopyTyIx.length <= lf { listCopyTyIx.push(-1) }
      listCopyTyIx[lf] = dst
    }
  }
  0
}

// Whether `src` and `dst` are both lists, `src` possibly nullable, of different element types.
function listTysElemDiffer(src: i32, dst: i32): boolean {
  const sn = nonNulTyOf(src)
  if sn < 0 || sn >= T.tys.length || dst < 0 || dst >= T.tys.length {
    return false
  }
  const s = tyAt(sn)
  const d = tyAt(dst)
  if s is TyArray {
    if d is TyArray { return s.aElem != d.aElem }
  }
  false
}

// Records `dstTy` at each value `srcExpr` delivers when its record stores a number otherwise
// than the destination's record does: the emitter builds a fresh record there, converting each
// number. Only number fields may differ, and a literal is built at its destination instead.
export function recordRecCopy(srcExpr: i32, srcTy: i32, dstTy: i32) {
  recCopyAt(srcExpr, srcTy, dstTy, REC_STORE_DEPTH)
}

// `recordRecCopy` to `depth` literals deep: a fresh object or list literal is built at the
// destination, so the copy is recorded on its fields and elements instead.
function recCopyAt(srcExpr: i32, srcTy: i32, dstTy: i32, depth: i32) {
  const dst = nonNulTyOf(dstTy)
  if srcExpr < 0 || srcTy < 0 || dst < 0 || srcTy >= T.tys.length || depth < 0 {
    return 0
  }
  const dt = tyAt(dst)
  for lf in valueTailLeaves(srcExpr) {
    if lf < 0 { continue }
    const ln = nodeAt(parenPeelIx(lf))
    if ln is ObjLit {
      if dt is TyObj {
        for fx in ln.objFields {
          const fi = nodeAt(fx)
          if fi is FieldInit {
            const df = objFieldType(dt, fi.fiName)
            if df >= 0 {
              recCopyAt(fi.fiValue, nodeTyOf(fi.fiValue), df, depth - 1)
            }
          }
        }
      }
    } else if ln is ArrayLit {
      if dt is TyArray {
        for ex in ln.arrElems {
          if !(nodeAt(ex) is Spread) {
            recCopyAt(ex, nodeTyOf(ex), dt.aElem, depth - 1)
          }
        }
      }
    } else if recCopyConverts(srcTy, dst) {
      while recCopyTyIx.length <= lf { recCopyTyIx.push(-1) }
      recCopyTyIx[lf] = dst
    }
  }
  0
}

// Whether the record `dst` stores some field of the record `src` as another number class, and
// every other field as `src` stores it.
function recCopyConverts(src: i32, dst: i32): boolean {
  recCopyConvertsAt(src, dst, REC_STORE_DEPTH)
}

// `recCopyConverts` with at most `depth` levels of record fields left: a field holding a record
// that converts is copied by the level below.
function recCopyConvertsAt(src: i32, dst: i32, depth: i32): boolean {
  if (
    depth <= 0
    || src < 0
    || dst < 0
    || src >= T.tys.length
    || dst >= T.tys.length
  ) {
    return false
  }
  const s = tyAt(src)
  const d = tyAt(dst)
  if !(s is TyObj) || !(d is TyObj) { return false }
  let converts = false
  let i = 0
  while i < d.objFieldNames.length {
    const sf = objFieldType(s, d.objFieldNames[i])
    const df = d.objFieldTypes[i]
    if sf < 0 { return false }
    const sc = recNumClass(sf)
    const dc = recNumClass(df)
    if sc != "" && dc != "" && sc != dc {
      if nonNulTyOf(sf) != sf || nonNulTyOf(df) != df { return false }
      converts = true
    } else if !fieldStorageEq(sf, df, REC_STORE_DEPTH) {
      if (
        !recCopyNestable(sf, df)
        || !recCopyConvertsAt(sf, nonNulTyOf(df), depth - 1)
      ) {
        return false
      }
      converts = true
    }
    i = i + 1
  }
  converts
}

// Records `dstTy` for a delivery of `srcExpr` whose type `srcTy` is a union of maps and whose
// destination is one map, or that map's nullable: every member is assignable to it, so every
// member shares its storage. A list or record literal is walked to its elements and fields.
export function recordMapUnbox(
  srcExpr: i32,
  srcTy: i32,
  dstIn: i32,
  depth: i32,
) {
  if srcExpr < 0 || srcTy < 0 || dstIn < 0 || depth <= 0 { return 0 }
  if srcTy >= T.tys.length || dstIn >= T.tys.length { return 0 }
  recordWidenRetagTails(srcExpr, dstIn)
  if tyWideUnionMinted { recordListWidenRetag(srcExpr, srcTy, dstIn) }
  const dstTy = nonNullTy(dstIn)
  if dstTy < 0 || dstTy >= T.tys.length { return 0 }
  const d = tyAt(dstTy)
  match d {
    TyArray => {
      const al = valueTailLeaves(srcExpr)
      let ai = 0
      while ai < al.length {
        mapUnboxListLit(al[ai], d.aElem, depth)
        ai = ai + 1
      }
      return 0
    }
    TyObj => {
      const ol = valueTailLeaves(srcExpr)
      let oi = 0
      while oi < ol.length {
        mapUnboxRecordLit(ol[oi], d.objFieldNames, d.objFieldTypes, depth)
        oi = oi + 1
      }
      return 0
    }
    TyMap => {
      if !tyAllMaps(srcTy) { return 0 }
      while mapUnboxTyIx.length <= srcExpr { mapUnboxTyIx.push(-1) }
      mapUnboxTyIx[srcExpr] = dstTy
      mapDeliveryRecordedSet(true)
      return 0
    }
    TyUnion => {
      return recordMapRetagTails(srcExpr, dstTy, depth)
    }
    // No other destination holds a map a union of maps can be delivered as.
    TyPrim | TyErr | TyFunc | TyVar | TyLit | TyNeg | TyNullable => {
      return 0
    }
  }
}

// `recordMapRetag` at each value a delivery into the union `dstTy` hands over: every tail of a
// value `if`, `match` or block, and the left operand of a `??`, each at its own type.
function recordMapRetagTails(srcExpr: i32, dstTy: i32, depth: i32) {
  if !tyHasMapMember(dstTy, 8) { return 0 }
  const leaves = valueTailLeaves(srcExpr)
  let i = 0
  while i < leaves.length {
    const lf = leaves[i]
    const n = nodeAt(lf)
    if n is BinExpr && n.binOp == "??" && depth > 0 {
      recordMapRetagTails(n.binLeft, dstTy, depth - 1)
      recordMapRetagTails(n.binRight, dstTy, depth - 1)
    } else {
      recordMapRetag(lf, nodeTyIxOf(lf), dstTy)
    }
    i = i + 1
  }
  0
}

// Records, for a union `srcTy` delivered into the union `dstTy`, each map member the
// destination lacks beside the destination member it is assignable to: a box built under the
// source member must carry that member's tag in the destination (`mapRetagRowsOf`).
function recordMapRetag(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcExpr < 0 || srcTy < 0 || srcTy >= T.tys.length { return 0 }
  // A box is a union of two or more non-null members, `| null` or not; one member is a niche.
  const sm: i32[] = []
  unionLeavesInto(srcTy, sm, 8)
  if sm.length < 2 { return 0 }
  const dm: i32[] = []
  unionLeavesInto(dstTy, dm, 8)
  const start = mapRetagFromTy.length
  let i = 0
  while i < sm.length {
    const a = sm[i]
    if tyAt(a) is TyMap && !tyAmong(a, dm) {
      let j = 0
      let found = false
      while j < dm.length && !found {
        if tyAt(dm[j]) is TyMap && assignable(a, dm[j]) {
          mapRetagFromTy.push(a)
          mapRetagToTy.push(dm[j])
          found = true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  if mapRetagFromTy.length > start {
    mapDeliveryRecordedSet(true)
    mapRetagAt.set(srcExpr, start)
    mapRetagN.set(srcExpr, mapRetagFromTy.length - start)
  }
  0
}

// `recordMapUnbox` over each element of a list literal `srcExpr` delivered as `elemTy[]`.
function mapUnboxListLit(srcExpr: i32, elemTy: i32, depth: i32) {
  const e = nodeAt(srcExpr)
  if e is ArrayLit {
    let i = 0
    while i < e.arrElems.length {
      const el = e.arrElems[i]
      recordMapUnbox(el, nodeTyIxOf(el), elemTy, depth - 1)
      i = i + 1
    }
  }
  0
}

// `recordMapUnbox` over each field of a record literal `srcExpr` delivered as the record whose
// field names and types are `names` and `tys`.
function mapUnboxRecordLit(
  srcExpr: i32,
  names: string[],
  tys: i32[],
  depth: i32,
) {
  const e = nodeAt(srcExpr)
  if e is ObjLit {
    let k = 0
    while k < e.objFields.length {
      const f = nodeAt(e.objFields[k])
      if f is FieldInit {
        let j = 0
        while j < names.length {
          if names[j] == f.fiName {
            recordMapUnbox(f.fiValue, nodeTyIxOf(f.fiValue), tys[j], depth - 1)
          }
          j = j + 1
        }
      }
      k = k + 1
    }
  }
  0
}

// Delivers `x` to `dstTy` where `x` names a generic function: it is built at the closed function
// type it meets, each delivery stamping its own name node.
export function adoptFnNameAt(x: i32, dstTy: i32) {
  if !stampsStand() || x < 0 { return 0 }
  const nx = parenPeelIx(x)
  if nx < 0 || nx >= P.nodes.length { return 0 }
  if nodeAt(nx) is Ident { recordRepTyAdopt(nx, dstTy, 6) }
  0
}

// Delivers the fresh literal `x` to `dstTy`, stamping it with that type where `litAtDstStorage`
// holds: every typed delivery of a literal, a join arm included, stamps through here.
export function adoptLitAt(x: i32, dstTy: i32) {
  if litAtDstStorage(x, dstTy) { recordRepTyAdopt(x, dstTy, 6) }
  0
}

// Delivers the join arm `x` to the join's type `dstTy`: each literal it ends in, through nested
// joins, is stamped, and each read of a binding is queued, so a binding holding a literal adopts.
export function adoptArmAt(x: i32, dstTy: i32) {
  adoptLitAt(x, dstTy)
  if x < 0 || x >= P.nodes.length { return 0 }
  const leaves: i32[] = []
  tailValueLeaves(x, leaves)
  for lf in leaves {
    if lf != x { adoptLitAt(lf, dstTy) }
    const p = cwPeelValue(lf)
    if p >= 0 && p < P.nodes.length && nodeAt(p) is Ident {
      recPend(p, nodeTyIxOf(p), dstTy, p)
    }
  }
  0
}

// Whether hole owner `o` is a parameter hole of declaration `d`.
function holeOfDecl(o: string, d: i32): boolean {
  if d < 0 { return false }
  const fd = nodeAt(d)
  fd is FuncDecl && holeNameIsParamOf(o, fd.fnName, d, fd.fnParams.length)
}

// Whether `t` holds an inference hole that neither the function being checked nor one of its
// parameters owns: such a hole is bound by a call into another function, not by this instance.
function holeOutsideFn(t: i32, depth: i32): boolean {
  if depth > 8 || !tyHasInferHole(t, 0) { return false }
  if tyAt(t) is TyVar {
    const o = tyVarOwnerOf(t)
    return o != curFnOwner
      && !holeOfDecl(o, curFnDeclIx)
      && !holeOfDecl(o, cstrOwnerTop())
  }
  const kids: i32[] = []
  tyChildrenOf(t, kids)
  for k in kids {
    if holeOutsideFn(k, depth + 1) { return true }
  }
  false
}

// Whether a fresh value `x` (`freshLitValue`) of another type meets a destination `dstTy`
// holding a record through nullables, a map it is, or any list: it is stored as its destination
// (D3339). A type parameter, or a hole outside the literal's function, stays open; an anonymous
// destination of the literal's own shape is already its storage, so it is not stamped.
export function litAtDstStorage(x: i32, dstTy: i32): boolean {
  if dstTy < 0 || x < 0 || !repStampableLit(x) || holeOutsideFn(dstTy, 0) {
    return false
  }
  const own = nodeTyIxOf(parenPeelIx(x))
  if own == dstTy { return false }
  if structNameOfTy(dstTy) == "" && genAppRowOf(dstTy) < 0 && tyEq(own, dstTy) {
    return false
  }
  let t = dstTy
  let k = 0
  let viaList = false
  while k < 8 && t >= 0 {
    const d = tyAt(t)
    match d {
      TyObj | TyVar => {
        return true
      }
      TyNullable => {
        t = d.nInner
      }
      TyArray => {
        viaList = true
        t = d.aElem
      }
      // a fresh map is built as the map it meets
      TyMap => {
        return viaList || (own >= 0 && tyAt(own) is TyMap)
      }
      // a list of any other element, a function among them, is built at its destination's
      // element storage
      TyPrim | TyUnion | TyLit | TyFunc => {
        return viaList
      }
      // no other type is a storage a literal is built at
      TyErr | TyNeg => {
        return false
      }
    }
    k = k + 1
  }
  false
}

// Whether `x`, past parentheses, is a fresh value (`freshLitValue`), or a value `if`, `match`,
// block or `??` one of whose arms is: the sources a rep stamp can adopt.
export function repStampableLit(x: i32): boolean {
  const p = parenPeelIx(x)
  const pn = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
  if pn is BinExpr && pn.binOp == "??" {
    return repStampableLit(pn.binLeft) || repStampableLit(pn.binRight)
  }
  const leaves = if valueJoinAt(x) < 0 { [parenPeelIx(x)] } else { valueTailLeaves(x) }
  for l in leaves {
    if freshLitValue(l) && !freshSetCall(l) { return true }
  }
  false
}

// Whether node `x` is a `null` value: a bare `null`, or any expression the checker typed the
// `null` unit (a read of a binding never filled, a `null`-typed field, an all-`null` join).
function isNullValue(x: i32): boolean {
  nodeAt(x) is NullLit || isNullTy(nodeTyIxOf(x))
}

// Whether node `x` delivers a bare `null` literal: itself, a value join's leaf, or a list
// literal's element at any depth.
export function deliversNullLit(x: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  if valueJoinAt(x) < 0 {
    const p = parenPeelIx(x)
    if p < 0 || p >= P.nodes.length { return false }
    return isNullValue(p) || elemDeliversNullLit(p)
  }
  if isNullValue(x) { return true }
  for l in valueTailLeaves(x) {
    if isNullValue(l) || elemDeliversNullLit(l) { return true }
  }
  false
}

// Whether node `x` is a list literal one of whose elements delivers a bare `null`.
function elemDeliversNullLit(x: i32): boolean {
  const n = nodeAt(x)
  if n is ArrayLit {
    for e in n.arrElems {
      if deliversNullLit(e) { return true }
    }
  }
  false
}

// Stamps each bare `null` the value at `x` hands over, among its join leaves or its list
// elements, with the type it is consumed at: the join's type `ty`, or a list's element type. A
// leaf a delivery already stamped keeps that stamp, which names its destination.
export function stampNullLeaves(x: i32, ty: i32) {
  if x < 0 || ty < 0 || !stampsStand() { return 0 }
  const n = nodeAt(x)
  if n is ArrayLit {
    const et = tyArrayElemIx(ty)
    if !nullNamesOwnNull(et) { return 0 }
    for e in n.arrElems { stampNullAt(parenPeelIx(e), et, false) }
    return 0
  }
  if !nullNamesOwnNull(ty) { return 0 }
  stampNullJoinLeaves(x, ty, false)
}

// Stamps each bare `null` among the join leaves of `x` with `ty`; `over` replaces a stamp.
function stampNullJoinLeaves(x: i32, ty: i32, over: boolean) {
  for l in valueTailLeaves(x) {
    if l != x { stampNullAt(l, ty, over) }
  }
  0
}

// Stamps a bare `null` an inferred function returns as `v`, itself or among its join leaves, with
// the function's return type `ret`. A return is a delivery, so it replaces a join's stamp.
export function stampNullReturn(v: i32, ret: i32) {
  if v < 0 || ret < 0 || !stampsStand() || !tyAdmitsNull(ret) { return 0 }
  stampNullAt(parenPeelIx(v), ret, true)
  stampNullJoinLeaves(v, ret, true)
}

// Whether a `null` delivered at type `ty` is a null of its own rather than the bottom ref: the
// `boolean | null` and string-literal-union sentinels, or a `string | null`'s typed null. A type
// variable answers no: each instance's elaboration stamps at its own types.
function nullNamesOwnNull(ty: i32): boolean {
  if ty < 0 || !tyAdmitsNull(ty) { return false }
  const inner = nonNullTy(ty)
  if inner < 0 { return false }
  const pn = primNameOf(inner)
  pn == "boolean" || pn == "string" || tyIsLitUnion(inner)
}

// Stamps the node `l` with `ty` when it is a bare `null` and `ty` names a null of its own; a stamp
// already there stays unless `over`.
function stampNullAt(l: i32, ty: i32, over: boolean) {
  if !isNullValue(l) || !nullNamesOwnNull(ty) { return 0 }
  if over {
    return repStamp(l, ty)
  } else if elabCapLive() {
    if (elabCapRep[l] ?? -1) >= 0 { return 0 }
  } else if l < nodeRepTyIx.length && nodeRepTyIx[l] >= 0 {
    return 0
  }
  repStamp(l, ty)
}

// Whether node `x` evaluates to a fresh, un-aliased value, so it may be built as its
// destination (D3339): a record, list or `null` literal, or a call the checker resolved to the
// ambient `Map` or `Set` constructor. A user's own `Map` is not one.
export function freshLitValue(x: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  n is ObjLit || n is ArrayLit || n is NullLit || ambientCtorCalls.has(x)
}

// Whether node `x` is a call the checker resolved to the ambient `Set` constructor.
function freshSetCall(x: i32): boolean { ambientCtorCalls[x] ?? false }

// Records `key` as the element a `Set()` call `ix` whose own element is still a hole is built
// with, outside an elaboration; 0. A Set is not stamped whole (D14228).
function setCtorKeyNote(ix: i32, key: i32): i32 {
  if elabCapLive() || key < 0 || key >= T.tys.length || tyAt(key) is TyVar {
    return 0
  }
  const own = nodeTyIxOf(ix)
  const ot = if own >= 0 && own < T.tys.length { T.tys[own] } else { null }
  if ot is TyMap && (ot.mKey < 0 || tyAt(ot.mKey) is TyVar) {
    setCtorKeys[ix] = key
  }
  0
}

// Records `t` as the destination type node `ix` is delivered at, where stamps stand, and as the
// destination of each value leaf a paren, `if`, block or `match` delivers through it.
export function recordCtxTy(ix: i32, t: i32): i32 {
  if ix < 0 || t < 0 || litPinN.length > 0 || !stampsStand() { return 0 }
  ctxTyStamp(ix, t)
  recordLeafCtxTy(ix, t)
}

// Marks node `ix`, and each value leaf a paren, `if`, block or `match` delivers through it, as
// the value of field `name` of `owner`, an object literal or a member target.
export function markFieldValue(ix: i32, owner: i32, name: string): i32 {
  if ix < 0 || !stampsStand() { return 0 }
  ctxFieldNodes[ix] = owner
  ctxFieldNames[ix] = name
  const e = nodeAt(ix)
  if e is Paren { return markFieldValue(e.parInner, owner, name) }
  if !(e is IfStmt || e is Block || e is MatchExpr) { return 0 }
  for l in valueTailLeaves(ix) {
    if l != ix {
      ctxFieldNodes[l] = owner
      ctxFieldNames[l] = name
    }
  }
  1
}

// Marks node `ix` as an element of list literal `owner`.
export function markElemValue(ix: i32, owner: i32): i32 {
  if ix < 0 || owner < 0 || !stampsStand() { return 0 }
  ctxElemNodes[ix] = owner
  1
}

// Records `t` as the destination of each value leaf and inner join that join `ix` delivers, not
// of `ix` itself: a value `if`, block or `match`'s arms are delivered to the join, whatever then
// takes it.
export function recordLeafCtxTy(ix: i32, t: i32): i32 {
  if ix < 0 || t < 0 || litPinN.length > 0 || !stampsStand() { return 0 }
  const e = nodeAt(ix)
  if e is Paren { return recordCtxTy(e.parInner, t) }
  if !(e is IfStmt || e is Block || e is MatchExpr) { return 0 }
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(ix, spine, leaves)
  for j in spine {
    if j != ix { ctxTyStamp(j, t) }
  }
  for l in leaves {
    if l != ix { ctxTyStamp(l, t) }
  }
  1
}

// Records `t` as the destination type node `ix` is delivered at: the instance's where an
// elaboration re-checks it, else the program's.
function ctxTyStamp(ix: i32, t: i32): i32 {
  // The nodes a `?.` read's rewrite puts in its place are delivered where the read is.
  for op in optReadParts[ix] ?? [] { ctxTyStampOne(op, t) }
  ctxTyStampOne(ix, t)
}

// `ctxTyStamp` for node `ix` alone.
function ctxTyStampOne(ix: i32, t: i32): i32 {
  const isBox = tyIsUnionDst(t)
  if isBox { boxExitsStamp(ix, t) }
  atomSrcStamp(ix)
  numPairStamp(ix, t)
  if elabCapLive() {
    elabCapCtx[ix] = t
    if isBox { boxTyStampOne(ix, t) }
    return 1
  }
  while nodeCtxTyIx.length <= ix { nodeCtxTyIx.push(-1) }
  nodeCtxTyIx[ix] = t
  if isBox { boxTyStamp(ix, t) }
  1
}

// Records the literal set delivered or read node `ix` holds, where its value is one: the instance's
// type where an elaboration re-checks it, else the program's. The final check's write stands.
export function atomSrcStamp(ix: i32): i32 {
  const live = elabCapLive()
  if nodeAtomSrcHeld.has(ix) { return 0 }
  let src = if live { elabCapTy[ix] ?? nodeTyIxOf(ix) } else { nodeTyIxOf(ix) }
  if !tyIsAtomSet(src) { src = constLitSetReadTy(ix) }
  if !tyIsAtomSet(src) { src = asgValueSetTy(ix) }
  atomSrcStampAs(ix, src)
}

// The set an assignment `ix` yields when its target holds a literal set, whatever its right side
// reads as; -1 for any other node.
function asgValueSetTy(ix: i32): i32 {
  const e = nodeAt(ix)
  if !(e is BinExpr) || e.binOp != "=" { return -1 }
  const t = if elabCapLive() { elabCapTy[e.binLeft] ?? nodeTyIxOf(e.binLeft) } else { nodeTyIxOf(e.binLeft) }
  if tyIsAtomSet(t) { t } else { -1 }
}

// Records a `??`'s left operand `ix` as decoding the set `t` its hit holds, and holds that record
// against a later delivery's restamp at the operand's own nullable type. Returns 1 where recorded.
export function atomHitStamp(ix: i32, t: i32): i32 {
  if (inferQuiet && !elabCapLive()) || atomSrcStampAs(ix, t) == 0 { return 0 }
  nodeAtomSrcHeld[ix] = true
  1
}

// `atomSrcStamp` at the given type `src`, for a node the checker mints but never types.
export function atomSrcStampAs(ix: i32, src: i32): i32 {
  if !tyIsAtomSet(src) { return 0 }
  if elabCapLive() {
    elabCapAtomSrc[ix] = src
    return 1
  }
  while nodeAtomSrcTyIx.length <= ix { nodeAtomSrcTyIx.push(-1) }
  nodeAtomSrcTyIx[ix] = src
  1
}

// `atomSrcStamp` for a read that decodes to a string where it stands rather than at a delivery: an
// operand, a template hole, a `.length` receiver. Outside an instance, only the final check's.
export function atomReadStamp(ix: i32): i32 {
  if inferQuiet && !elabCapLive() { return 0 }
  atomSrcStamp(ix)
}

// The set a read of an un-annotated `const` bound to a join of literal consts holds, which the
// read's own type widens to `string` (`constBindsLitSet`); -1 for any other node.
function constLitSetReadTy(ix: i32): i32 {
  const e = nodeAt(ix)
  if !(e is Ident) { return -1 }
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length || !constBindsLitSet(d) { return -1 }
  const dn = nodeAt(d)
  if dn is LetDecl { nodeCtxTyIxOf(dn.letInit) } else { -1 }
}

// The numeric kind of type `t`: 1 `i32`, 2 `u8`, 3 `i64`, 4 `f64`, 5 `f32`, 6 a union of numbers,
// 0 anything else.
function numKindOfTy(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return 0 }
  const p = primNameOf(t)
  if p == "i32" { return 1 }
  if p == "u8" { return 2 }
  if p == "i64" { return 3 }
  if p == "f64" { return 4 }
  if p == "f32" { return 5 }
  if tyIsNumUnion(t) { return 6 }
  0
}

// Records the numeric pair node `ix` is delivered at, where destination `t` is a wide number
// (`i64`, `f64`, `f32`): `src * 8 + dst` of their `numKindOfTy`. Only a converting pair is stored;
// an identity pair is the ctx record's, so it is stored only over a pair that record cannot rebuild.
// Runs before the ctx write, so the ctx it reads is the previous stamp's. The final check's write stands.
function numPairStamp(ix: i32, t: i32): i32 {
  const live = elabCapLive()
  const has = if live { elabCapNumPair.has(ix) } else { nodeNumPair.has(ix) }
  const dk = numKindOfTy(t)
  if dk < 3 || dk > 5 {
    // A number boxed into a union is boxed at the arm that holds it (`numUnionPairOf`).
    const uk = numUnionPairOf(
      if live { elabCapTy[ix] ?? nodeTyIxOf(ix) } else { nodeTyIxOf(ix) },
      t,
    )
    if uk > 0 { return numCodeStamp(ix, uk) }
    // A later non-wide stamp would hide an identity pair the previous wide ctx implied.
    if has { return 0 }
    const prev = if live { elabCapCtx[ix] ?? -1 } else { nodeCtxTyIxOf(ix) }
    const pk = numKindOfTy(prev)
    if pk < 3 || pk > 5 { return 0 }
    if live { elabCapNumPair[ix] = pk * 9 } else { nodeNumPair[ix] = pk * 9 }
    return 1
  }
  const src = if live { elabCapTy[ix] ?? nodeTyIxOf(ix) } else { nodeTyIxOf(ix) }
  const sk = numKindOfTy(src)
  if sk == dk && !has { return 1 }
  if live {
    elabCapNumPair[ix] = sk * 8 + dk
  } else {
    nodeNumPair[ix] = sk * 8 + dk
  }
  1
}

// The scalar type operand `ix` is checked at, a literal or literal union peeled to its base: the
// instance's where an elaboration re-checks it, else the program's; -1 where it has none.
export function numOperandTy(ix: i32): i32 {
  numScalarTyOf(
    if elabCapLive() { elabCapTy[ix] ?? nodeTyIxOf(ix) } else { nodeTyIxOf(ix) },
  )
}

// Type `t`, a literal or literal union peeled to its scalar base; -1 for a hole.
function numScalarTyOf(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const p = tyScalarBasePrim(t)
  if p == null { return t }
  if p == primNameOf(TY_I32) { return TY_I32 }
  if p == primNameOf(TY_I64) { return TY_I64 }
  if p == primNameOf(TY_F32) { return TY_F32 }
  if p == primNameOf(TY_F64) { return TY_F64 }
  t
}

// Records operand `ix`'s numeric pair at its operator's operand type `dt`, where `dt` is a wide
// number and the operand's own type is a number. An operand is delivered at no position and has no
// ctx record, so its one-kind pair is stored too.
export function numOperandStamp(ix: i32, dt: i32): i32 {
  numOperandStampAs(ix, numOperandTy(ix), dt)
}

// `numOperandStamp` for operand `ix` of scalar type `st`.
function numOperandStampAs(ix: i32, st: i32, dt: i32): i32 {
  const dk = numKindOfTy(dt)
  if dk < 3 || dk > 5 { return 0 }
  const sk = numKindOfTy(st)
  if sk == 0 { return 0 }
  numCodeStamp(ix, sk * 8 + dk)
}

// `numOperandTy` of operand `ix`, or, for an element read its open list leaves untyped, the element
// the list is pinned to by now; -1 where neither is known.
function numOperandTyOrRow(ix: i32): i32 {
  const t = numOperandTy(ix)
  if t >= 0 || elabCapLive() { return t }
  const p = parenPeelIx(ix)
  if p < 0 || p >= P.nodes.length { return -1 }
  const e = nodeAt(p)
  if !(e is Index) { return -1 }
  const at = nodeTyIxOf(e.idxArr)
  if at < 0 || at >= T.tys.length { return -1 }
  const a = tyAt(at)
  if a is TyArray {
    if a.aElem >= 0 { return arrElemValueTy(a.aElem) }
  }
  -1
}

// Records both operands' numeric pairs of the binary `n` at its pair rule's operand type, where
// each operand's own type is a number. Returns 0.
export function binOperandsStamp(n: BinExpr): i32 {
  const olt = numOperandTyOrRow(n.binLeft)
  const ort = numOperandTyOrRow(n.binRight)
  if olt < 0 || ort < 0 { return 0 }
  const ot = numPairOpTy(n, olt, ort)
  if ot < 0 {
    // A union compared with, or combined with, a number: the number is read at the kind it has.
    if tyIsUnionDst(olt) && !tyIsUnionDst(ort) {
      return numOwnStamp(n.binRight)
    }
    if tyIsUnionDst(ort) && !tyIsUnionDst(olt) { return numOwnStamp(n.binLeft) }
  }
  numOperandStampAs(n.binLeft, olt, ot)
  numOperandStampAs(n.binRight, ort, ot)
  0
}

// Records node `ix`'s identity numeric pair at its own type, where that is a wide number and the
// node holds no pair yet. Returns 1 where recorded.
function numOwnStamp(ix: i32): i32 {
  const has = if elabCapLive() { elabCapNumPair.has(ix) } else { nodeNumPair.has(ix) }
  const k = numKindOfTy(numOperandTyOrRow(ix))
  if has || k < 3 || k > 5 { return 0 }
  numCodeStamp(ix, k * 9)
}

// Records the numeric pair each exit `xs[i]` of type `tys[i]` takes into a loop's join `t`, where
// `t` is a wide number. Returns 0.
export function numExitsStamp(xs: i32[], tys: i32[], t: i32): i32 {
  if inferQuiet && !elabCapLive() { return 0 }
  let i = 0
  while i < xs.length && i < tys.length {
    numDeliverStamp(xs[i], numScalarTyOf(tys[i]), t)
    i = i + 1
  }
  0
}

// Records, for value join `ix` delivered at union `t`, the numeric pair each leaf of an inner join
// typed a wide number takes into that inner join: an `else if` link is built at its own width,
// and no check of its own delivers its leaves. Returns 0.
export function numInnerJoinsStamp(ix: i32, t: i32): i32 {
  if (inferQuiet && !elabCapLive()) || !tyIsUnionDst(t) { return 0 }
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(ix, spine, leaves)
  for j in spine {
    const jt = numOperandTy(j)
    const jk = numKindOfTy(jt)
    if j != ix && jk >= 3 && jk <= 5 {
      const s2: i32[] = []
      const l2: i32[] = []
      valueTailSplit(j, s2, l2)
      for l in l2 { numDeliverStamp(l, numOperandTy(l), jt) }
    }
  }
  0
}

// Records the numeric pair value `ix` of type `src` (a literal read at its base) takes into slot
// `dst`, where `dst` is a wide number: an open list's element or map's value it pinned, or an
// operator's parameter. Returns 0.
export function numSlotStamp(ix: i32, src: i32, dst: i32): i32 {
  if inferQuiet && !elabCapLive() { return 0 }
  numDeliverStamp(ix, numScalarTyOf(src), dst)
  0
}

// Records cast operand `ix`'s numeric pair at the kind the cast to `tt` stages it in: `as%` at
// `i64` where either side is `i64`; else an `f64` target at `f64`, an `i32` source at the target
// (`i64` where `u8` names the `u8` domain), any other number at its own kind. A union, none.
export function numCastStamp(
  ix: i32,
  tt: i32,
  wrap: boolean,
  u8: boolean,
): i32 {
  const ot = numOperandTy(ix)
  // A boolean is cast from the `i32` it is stored in.
  const sk = if primNameOf(ot) == "boolean" { 1 } else { numKindOfTy(ot) }
  if sk == 0 || sk == 6 { return 0 }
  const tk = numKindOfTy(tt)
  let dk = sk
  if wrap { dk = if tk == 3 || sk == 3 { 3 } else { 0 } }
  else if tk == 4 { dk = 4 }
  else if sk <= 2 { dk = if u8 { 3 } else { tk } }
  if dk < 3 || dk > 5 { return 0 }
  numCodeStamp(ix, sk * 8 + dk)
}

// The pair a number of type `src` is boxed at into union `t`: its own kind where `t` holds it (an
// alias member's included), else the union's promotion, an integer to `i64`, `f64` then `f32` and
// a float to the other float; 0 where nothing wide is boxed.
function numUnionPairOf(src: i32, t: i32): i32 {
  const sk = numBaseKindOfTy(src)
  if sk == 0 || sk == 6 || !tyIsUnionDst(t) { return 0 }
  const ms: i32[] = []
  flattenVariantsInto(t, ms)
  let has = 0
  for m in ms {
    const mk = numBaseKindOfTy(m)
    if mk > 0 && mk < 6 { has = has | (1 << mk) }
  }
  const own = if sk == 2 { 1 } else { sk }
  if (has & (1 << own)) != 0 || (sk == 2 && (has & 4) != 0) {
    return if sk >= 3 { sk * 9 } else { 0 }
  }
  let dk = 0
  if sk <= 3 {
    if sk < 3 && (has & 8) != 0 { dk = 3 }
    else if (has & 16) != 0 { dk = 4 }
    else if (has & 32) != 0 { dk = 5 }
  } else if sk == 4 && (has & 32) != 0 {
    dk = 5
  } else if sk == 5 && (has & 16) != 0 {
    dk = 4
  }
  if dk == 0 { 0 } else { sk * 8 + dk }
}

// Records the numeric pair node `ix` is boxed at when it holds a value of type `hit` entering union
// `t`: a `??`'s left operand on a hit, or a `?.` read's minted non-null part. At a wide number `t`,
// the hit's pair into it, where the node holds none. Outside an instance, only the final check's.
// Returns 1 where recorded.
export function numBoxedStamp(ix: i32, hit: i32, t: i32): i32 {
  if ix < 0 || (inferQuiet && !elabCapLive()) { return 0 }
  if !tyIsUnionDst(t) {
    const has = if elabCapLive() { elabCapNumPair.has(ix) } else { nodeNumPair.has(ix) }
    if has { return 0 }
    return numDeliverStamp(ix, numScalarTyOf(hit), t)
  }
  const code = numUnionPairOf(hit, t)
  if code <= 0 { return 0 }
  numCodeStamp(ix, code)
}

// `numKindOfTy` of `t`, a literal or a union of literals over one base read as that base.
function numBaseKindOfTy(t: i32): i32 {
  const k = numKindOfTy(t)
  if k != 0 { k } else { numKindOfTy(numScalarTyOf(t)) }
}

// Records node `ix`'s numeric pair from type `src` to `dst`, where `dst` is a wide number and
// `src` a number that is no union: a value a site builds and delivers itself (a dispatch's arm).
export function numDeliverStamp(ix: i32, src: i32, dst: i32): i32 {
  const dk = numKindOfTy(dst)
  const sk = numKindOfTy(src)
  if dk < 3 || dk > 5 || sk == 0 || sk == 6 { return 0 }
  numCodeStamp(ix, sk * 8 + dk)
}

// Stores numeric pair `code` for node `ix`: the instance's where an elaboration re-checks it.
function numCodeStamp(ix: i32, code: i32): i32 {
  if elabCapLive() {
    elabCapNumPair[ix] = code
    return 1
  }
  nodeNumPair[ix] = code
  1
}

// Whether `t` holds string-literal members an atom stands for, `| null` included.
function tyIsAtomSet(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const n = tyAt(t)
  if !(n is TyLit || n is TyUnion || n is TyNullable) { return false }
  tyLitMemberTexts(t).length > 0 || tyNulLitUnionMemberTexts(t).length > 0
}

// Records union `t` as the box destination of node `ix` and each value leaf it delivers through,
// where stamps stand, without a contextual type: a `??` operand joins its result, it is not
// delivered to it. Not a union, nothing.
export function recordBoxTy(ix: i32, t: i32): i32 {
  if ix < 0 || !tyIsUnionDst(t) || litPinN.length > 0 || !stampsStand() {
    return 0
  }
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(ix, spine, leaves)
  boxTyStamp(ix, t)
  for j in spine { boxTyStamp(j, t) }
  for l in leaves { boxTyStamp(l, t) }
  1
}

// Whether the box writes now are a `??` join's (`recordJoinBoxTy`).
let boxJoinWrite = false

// `recordBoxTy` for the left operand `ix` of a `??` joining at `t`: the join is not the operand's
// delivery, so a node that already holds a delivery's record keeps it.
export function recordJoinBoxTy(ix: i32, t: i32): i32 {
  boxJoinWrite = true
  const r = recordBoxTy(ix, t)
  boxJoinWrite = false
  r
}

// Records union `t` as the box destination of node `ix` alone, the instance's where an
// elaboration re-checks it, else the program's.
function boxTyStamp(ix: i32, t: i32): i32 {
  for op in optReadParts[ix] ?? [] { boxTyStampOne(op, t) }
  boxTyStampOne(ix, t)
}

// `boxTyStamp` for node `ix` alone. The record is the final check's write, except that a write
// with no emit name, one naming an open type parameter over a closed union, or a join's over a
// delivery's record, keeps the record.
function boxTyStampOne(ix: i32, t: i32): i32 {
  if elabCapLive() {
    const cold = elabCapBox[ix] ?? -1
    if boxJoinWrite && cold >= 0 && !(elabCapBoxJoin[ix] ?? false) { return 1 }
    if boxTyKeeps(cold, t) { return 1 }
    elabCapBox[ix] = t
    elabCapBoxJoin[ix] = boxJoinWrite
    return 1
  }
  while nodeBoxTyIx.length <= ix { nodeBoxTyIx.push(-1) }
  const old = nodeBoxTyIx[ix]
  if boxJoinWrite && old >= 0 && !(nodeBoxJoin[ix] ?? false) { return 1 }
  if boxTyKeeps(old, t) { return 1 }
  nodeBoxTyIx[ix] = t
  nodeBoxJoin[ix] = boxJoinWrite
  1
}

// Whether the standing box record `old` survives a write of `t` (`boxTyStampOne`).
function boxTyKeeps(old: i32, t: i32): boolean {
  if old < 0 || old == t { return false }
  boxTyNamesNothing(t) || (tyHasTyVar(t) && !tyHasTyVar(old))
}

// Whether `t` has no emit name, remembered for the last type asked within one compile while
// neither the arena nor the declared names move. A stamp loop asks it of one union per node, and
// the render doubles in length per level of a record that holds one record twice.
const bnnGen: MemoGen = memoGenNew(0)
let bnnAt = -1
let bnnTy = -1
let bnnLen = -1
let bnnEpoch = -1
let bnnVer = -1
let bnnAns = false
function boxTyNamesNothing(t: i32): boolean {
  // The structural answer walks each arena node once; only a cycle needs the render.
  const ne = tyEmitNameNonEmpty(t)
  if ne >= 0 { return ne == 0 }
  if (
    bnnAt == bnnGen.at
    && t == bnnTy
    && T.tys.length == bnnLen
    && tyMutEpoch == bnnEpoch
    && cUserTypesVer == bnnVer
  ) {
    return bnnAns
  }
  bnnAns = tyToEmitName(t) == ""
  bnnAt = bnnGen.at
  bnnTy = t
  bnnLen = T.tys.length
  bnnEpoch = tyMutEpoch
  bnnVer = cUserTypesVer
  bnnAns
}

// Records union `t` as the box destination of each value loop `ix` exits with (`lpExitsOf`), and of
// each leaf a join among them delivers; the loop's own `ctxTy` stamp does not reach them.
function boxExitsStamp(ix: i32, t: i32): i32 {
  const todo = lpExitsOf(ix).slice(0)
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x < 0 { continue }
    boxTyStamp(x, t)
    numBoxStamp(x, t)
    for y in lpExitsOf(x) { todo.push(y) }
    const spine: i32[] = []
    const leaves: i32[] = []
    valueTailSplit(x, spine, leaves)
    for j in spine {
      if j != x { boxTyStamp(j, t) }
    }
    for l in leaves {
      if l != x { todo.push(l) }
    }
  }
  0
}

// Records the numeric pair a number `ix` is boxed at into union `t` (`numUnionPairOf`), the
// instance's where an elaboration re-checks it. Returns 1 where recorded.
function numBoxStamp(ix: i32, t: i32): i32 {
  const src = if elabCapLive() { elabCapTy[ix] ?? nodeTyIxOf(ix) } else { nodeTyIxOf(ix) }
  const code = numUnionPairOf(src, t)
  if code <= 0 { return 0 }
  numCodeStamp(ix, code)
}

// Whether `t` is a union or a nullable type: a destination a value may be boxed into.
function tyIsUnionDst(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const d = T.tys[t]
  d is TyUnion || d is TyNullable
}

let repTemplateMuted = false

// Runs nothing; while `on`, a stamp outside an elaboration writes no template column, for a
// question asked at one instance's pin of a node every instance shares (D15288).
export function repTemplateMute(on: boolean): i32 {
  repTemplateMuted = on
  1
}

// Records `t` as the type node `ix` is built at, in the elaboration in progress when one is
// re-checking an instance; 1.
function repStamp(ix: i32, t: i32): i32 {
  if elabCapLive() {
    elabCapRep[ix] = t
    return 1
  }
  if repTemplateMuted { return 1 }
  while nodeRepTyIx.length <= ix { nodeRepTyIx.push(-1) }
  nodeRepTyIx[ix] = t
  1
}

// Stamps the list literal `l` with the list type `ty` its elements are built as; 1.
export function repStampListBuilt(l: i32, ty: i32): i32 { repStamp(l, ty) }

// Stamps the returned read `x` with the record `t` its container builds it at; 1.
export function repStampHeldRead(x: i32, t: i32): i32 { repStamp(x, t) }

// Records union `u` as the one literal `ix` is adopted into an arm of, beside its rep stamp; 1.
function repStampUnion(ix: i32, u: i32): i32 {
  if elabCapLive() {
    elabCapRepUnion[ix] = u
    return 1
  }
  if repTemplateMuted { return 1 }
  nodeRepUnionIx[ix] = u
  1
}

// Records union `u` (members `ms`) against each object literal call `x` hands back: an argument
// of the call's own type, or of a nested such call, which exactly one member of `ms` matches both
// ways (D8381). An instance's re-check records nothing; 0.
function retLitAdoptUnion(x: i32, u: i32, ms: i32[], depth: i32): i32 {
  const c = nodeAt(x)
  if !(c is Call) || depth <= 0 || elabCapLive() || repTemplateMuted {
    return 0
  }
  const ct = nodeTyIxOf(x)
  for a in c.callArgs {
    const ax = parenPeelIx(a)
    const at = if ax >= 0 { nodeTyIxOf(ax) } else { -1 }
    if ax >= 0 && tyMutual(at, ct) {
      const an = nodeAt(ax)
      if an is Call {
        retLitAdoptUnion(ax, u, ms, depth - 1)
      } else if an is ObjLit && nodeRepTyIxOf(ax) == at {
        let n = 0
        for m in ms {
          if tyMutual(m, at) { n = n + 1 }
        }
        if n == 1 { litRetUnionIx[ax] = u }
      }
    }
  }
  0
}

// Whether types `a` and `b` are each assignable to the other; false for a hole.
function tyMutual(a: i32, b: i32): boolean {
  if a < 0 || b < 0 || a >= T.tys.length || b >= T.tys.length { return false }
  assignable(a, b) && assignable(b, a)
}

// The list member of union `u` the array literal `ix` is built at: the first whose element type
// each element has exactly, else the first each element fits, else the first list member, looking
// through `| null` and nested unions (a recursive alias's union holds itself that way); -1 for none.
function listLitUnionArm(u: i32, ix: i32): i32 {
  const own = listLitExactArm(u, ix)
  if own >= 0 { return own }
  const fit = listMemberIn(u, ix, 1, 6)
  if fit >= 0 { return fit }
  listMemberIn(u, ix, 2, 6)
}

// The list member of union `u` array literal `ix` has exactly: its own type, else the first
// whose element type each element has, looking through `| null` and nested unions; -1 for none.
export function listLitExactArm(u: i32, ix: i32): i32 {
  const self = listMemberIn(u, ix, 3, 6)
  if self >= 0 { return self }
  listMemberIn(u, ix, 0, 6)
}

// One pass of `listLitUnionArm`: `mode` 3 asks for the literal's own type, 0 a member its
// elements have exactly, 1 one they fit, 2 any.
function listMemberIn(u: i32, ix: i32, mode: i32, depth: i32): i32 {
  const d = nonNullTy(u)
  if depth <= 0 || d < 0 { return -1 }
  const t = tyAt(d)
  if !(t is TyUnion) { return -1 }
  for m in t.uMembers {
    if m >= 0 {
      if tyAt(m) is TyArray {
        if (
          mode == 2
          || ((mode == 3 || mode == 0) && tyEq(nodeTyIxOf(parenPeelIx(ix)), m))
        ) {
          return m
        }
        if mode != 3 && arrLitFitsList(ix, m, mode == 0, depth) { return m }
      }
      const inner = listMemberIn(m, ix, mode, depth - 1)
      if inner >= 0 { return inner }
    }
  }
  -1
}

// The list member of `ms` that array literal `ix` has exactly: its own type, else the first whose
// element type each element has; -1 for none.
export function listLitExactMember(ms: i32[], ix: i32): i32 {
  const own = nodeTyIxOf(parenPeelIx(ix))
  for m in ms {
    if m >= 0 && tyAt(m) is TyArray && tyEq(own, m) { return m }
  }
  for m in ms {
    if m >= 0 && tyAt(m) is TyArray && arrLitFitsList(ix, m, true, 6) {
      return m
    }
  }
  -1
}

// Whether every element of array literal `ix` fits list type `m`'s element: a list literal by the
// same test one level down, any other element by its own type, equal to it where `exact`.
function arrLitFitsList(ix: i32, m: i32, exact: boolean, depth: i32): boolean {
  const e = nodeAt(parenPeelIx(ix))
  const w = tyAt(m)
  if depth <= 0 || !(e is ArrayLit) || !(w is TyArray) { return false }
  const we = nonNullTy(w.aElem)
  for el0 in e.arrElems {
    const sp = nodeAt(el0)
    const el = if sp is Spread { sp.spdArg } else { parenPeelIx(el0) }
    const want = if sp is Spread { m } else { w.aElem }
    const own = nodeTyIxOf(el)
    if (
      !(sp is Spread)
      && nodeAt(el) is ArrayLit
      && we >= 0
      && tyAt(we) is TyArray
    ) {
      if !arrLitFitsList(el, we, exact, depth - 1) { return false }
    } else if (
      !(sp is Spread)
      && nodeAt(el) is ArrayLit
      && we >= 0
      && tyAt(we) is TyUnion
    ) {
      if listMemberIn(we, el, if exact { 0 } else { 1 }, depth - 1) < 0 {
        return false
      }
    } else {
      const lt = if sp is Spread { -1 } else { litTyOfExpr(el) }
      const viaLit = lt >= 0
        && assignable(lt, want)
        && (!exact || tyIsLitUnion(want))
      const viaOwn = own >= 0
        && (if exact { tyEq(own, want) } else { assignable(own, want) })
      if !viaLit && !viaOwn { return false }
    }
  }
  true
}

// Whether `src` is a `null[]` element: a list literal's element, a `push`, `unshift` or `insert`
// argument on a list, `__array_new__`'s fill, or the value of `xs[i] = …` on a list. A struct
// field or local is not one.
function nullUnitListCell(src: i32): boolean {
  cwIxBuild()
  if src < 0 || !cwIxCovers(src) { return false }
  const up = cwIxUp[src]
  if up < 0 || up >= P.nodes.length { return false }
  const k = cwIxUpKind[src]
  const un = nodeAt(up)
  if k == CW_UP_ELEM { return un is ArrayLit }
  if k == CW_UP_ARG && un is Call && un.callFn >= 0 {
    const f = nodeAt(un.callFn)
    if f is Ident && f.identName == "__array_new__" {
      return un.callArgs.length == 2 && un.callArgs[1] == src
    }
    if (
      f is Member
      && (f.memProp == "push" || f.memProp == "unshift" || f.memProp == "insert")
    ) {
      return tyIsListTy(nonNulTyOf(nodeTyIxOf(f.memObj)))
    }
    return false
  }
  if k == CW_UP_ASG_RHS && un is BinExpr && un.binOp == "=" {
    const l = nodeAt(parenPeelIx(un.binLeft))
    if l is Index { return tyIsListTy(nonNulTyOf(nodeTyIxOf(l.idxArr))) }
  }
  false
}

// Stamps `src`, delivered at `dst`, with the `(boolean | null)[]` list's element when it lands in a
// `null[]` cell: that cell rides that list (D4671, D4771), whatever node computes the value, an
// instance's `T = null` included. True when it stamped.
export function stampNullUnitCell(src: i32, dst: i32): boolean {
  if !isNullTy(dst) || litPinN.length > 0 || !stampsStand() { return false }
  if !nullUnitListCell(src) { return false }
  repStamp(src, mkNullableTy(TY_BOOL))
  true
}

// Whether `t` is a list type.
function tyIsListTy(t: i32): boolean {
  t >= 0 && t < T.tys.length && tyAt(t) is TyArray
}

// Stamps the destination type `dstTy` onto literal `srcExpr` (recursively, into `ObjLit` fields /
// `ArrayLit` elements) in the `nodeRepTyIx` sidecar, or the instance's while an elaboration
// re-checks one. Nullable wrappers are peeled; `depth` bounds the walk. A quiet probe and a pin's
// re-check stamp nothing: their types do not stand, and a pin's literal is a generic body's node.
export function recordRepTyAdopt(srcExpr: i32, dstTy: i32, depth: i32) {
  if srcExpr < 0 || dstTy < 0 || depth <= 0 || litPinN.length > 0 { return 0 }
  if !stampsStand() { return 0 }
  ctxTyStamp(srcExpr, dstTy)
  let dtix = dstTy
  let peel = true
  while peel {
    if dtix < 0 || dtix >= T.tys.length { return 0 }
    const dN = tyAt(dtix)
    if dN is TyNullable {
      if dN.nInner < 0 { return 0 }
      dtix = dN.nInner
    } else {
      peel = false
    }
  }
  if dtix >= T.tys.length { return 0 }
  const d = tyAt(dtix)
  const e = nodeAt(srcExpr)
  if stampNullUnitCell(srcExpr, dstTy) { return 1 }
  // A value of the `null` unit type is its destination's null, whatever node computes it.
  if !(e is NullLit) && isNullValue(srcExpr) && nullNamesOwnNull(dstTy) {
    repStamp(srcExpr, dstTy)
  }
  match e {
    Paren => {
      recordRepTyAdopt(e.parInner, dtix, depth)
      return repStamp(srcExpr, dtix)
    }
    ObjLit => {
      match d {
        TyObj => {
          const dfn = d.objFieldNames
          const dft = d.objFieldTypes
          let k = 0
          while k < e.objFields.length {
            const f = nodeAt(e.objFields[k])
            if f is FieldInit {
              let j = 0
              while j < dfn.length {
                if dfn[j] == f.fiName {
                  recordRepTyAdopt(f.fiValue, dft[j], depth - 1)
                }
                j = j + 1
              }
            }
            k = k + 1
          }
          return repStamp(srcExpr, dtix)
        }
        // An `ObjLit` whose destination is a union: recurse against the first member whose
        // field-name set corresponds and that the literal's own type fits, else the first whose
        // names correspond — arms may share every field name and differ in a field's type.
        TyUnion => {
          // The union is recorded before the arm is stamped, so a nested union's own record wins.
          const am = objLitUnionArm(e, nodeTyIxOf(srcExpr), d.uMembers)
          if am >= 0 {
            repStampUnion(srcExpr, dtix)
            return recordRepTyAdopt(srcExpr, am, depth)
          }
          return 0
        }
        // no other destination adopts an object literal
        TyPrim | TyErr | TyFunc | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
      }
      return 0
    }
    ArrayLit => {
      match d {
        TyArray => {
          let i = 0
          while i < e.arrElems.length {
            // A spread element's source list is delivered to the whole list's type.
            const el = nodeAt(e.arrElems[i])
            if el is Spread {
              recordRepTyAdopt(el.spdArg, dtix, depth - 1)
            } else {
              recordRepTyAdopt(e.arrElems[i], d.aElem, depth - 1)
            }
            i = i + 1
          }
          return repStamp(srcExpr, dtix)
        }
        // An array literal boxed into a union arm: recurse against the list member it is built at.
        TyUnion => {
          const am = listLitUnionArm(dtix, srcExpr)
          if am >= 0 { return recordRepTyAdopt(srcExpr, am, depth) }
          return 0
        }
        // no other destination adopts an array literal
        TyPrim | TyErr | TyObj | TyFunc | TyNullable | TyMap | TyVar | TyLit | TyNeg => {}
      }
      return 0
    }
    // A `null` at a nullable record is that record's null, stamped with the record, or with the
    // type parameter an instance binds.
    NullLit => {
      if d is TyObj || d is TyVar { return repStamp(srcExpr, dtix) }
      if nullNamesOwnNull(dstTy) { return repStamp(srcExpr, dstTy) }
      return 0
    }
    // A value `if`, `match` or block delivers each arm's value to the same destination, and one
    // whose arms took a record destination is built as that record too, not as their join (D15020).
    IfStmt | Block | MatchExpr => {
      let any = 0
      for l in valueTailLeaves(srcExpr) {
        if l != srcExpr { any = any | recordRepTyAdopt(l, dtix, depth - 1) }
      }
      if any != 0 && d is TyObj { repStamp(srcExpr, dtix) }
      return any
    }
    // A call handing a literal back delivers it into a union destination; a fresh `Map()` or
    // `Set()` is built as the map it is delivered to.
    Call => {
      if d is TyUnion {
        return retLitAdoptUnion(srcExpr, dtix, d.uMembers, depth)
      }
      if !(d is TyMap) || !freshLitValue(srcExpr) { return 0 }
      if freshSetCall(srcExpr) { return setCtorKeyNote(srcExpr, d.mKey) }
      return repStamp(srcExpr, dtix)
    }
    // A generic or un-annotated function named at a closed function type, or at a union whose
    // one function member is closed, is built at that type.
    Ident => {
      const ft = fnArmOf(dtix)
      if ft < 0 || !elabTyClosed(ft, 0) { return 0 }
      if elabFnIdOf(nodeTyIxOf(srcExpr)) < 0 { return 0 }
      return repStamp(srcExpr, ft)
    }
    // A number literal takes the numeric width it is built at there.
    NumLit | Unary => {
      numLitAdoptDst(srcExpr, dtix)
      return 0
    }
    // A `??` delivers its value from either operand, so each is built at the destination.
    BinExpr => {
      if e.binOp != "??" { return 0 }
      const l = recordRepTyAdopt(e.binLeft, dtix, depth - 1)
      // A join on the left is built at the destination too, as its arms are.
      const lj = parenPeelIx(e.binLeft)
      if l != 0 && lj >= 0 && valueJoinAt(lj) >= 0 { repStamp(lj, dtix) }
      return l | recordRepTyAdopt(e.binRight, dtix, depth - 1)
    }
    // no other source is a literal shape to stamp
    StrLit | CharLit | BoolLit | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | ImportDecl | Spread | LoopVar => {}
  }
  0
}

// The member of `members` an object literal `e` of checked type `srcTy` is stored as: the
// first record whose field names correspond and that `srcTy` is assignable to, else the first
// whose names correspond, else -1. A literal adopted as a member that leaves out a nullable
// field is that member, even though its written names do not correspond (D4601).
function objLitUnionArm(e: ObjLit, srcTy: i32, members: i32[]): i32 {
  if srcTy >= 0 && srcTy < T.tys.length {
    const st = tyAt(srcTy)
    if st is TyObj && st.objFieldNames.length > e.objFields.length {
      for m in members {
        if m == srcTy { return srcTy }
      }
    }
  }
  let first = -1
  let mi = 0
  while mi < members.length {
    const m = members[mi]
    if m >= 0 && m < T.tys.length {
      const mt = tyAt(m)
      if mt is TyObj {
        if objLitFieldsCorrespond(e, mt) {
          if srcTy >= 0 && srcTy < T.tys.length && assignable(srcTy, m) {
            return m
          }
          if first < 0 { first = m }
        }
      }
    }
    mi = mi + 1
  }
  first
}

// The type an un-annotated binding takes from its initializer's `initTy`. A `const` bound to a
// string literal is that literal's type, so it compares in O(1) (owner ruling, D2157); the type
// is a widening one, so a `let` that copies it holds a `string` it may reassign.
export function constStrLitBound(n: LetDecl, initTy: i32): i32 {
  if n.letInit < 0 { return initTy }
  if n.letKw == "const" {
    const iN = nodeAt(n.letInit)
    if iN is StrLit { return mkWideStrLitTy(iN.strText, initTy) }
    // `const Y = Z` is the same one literal, and a join of several (`if c { Z } else { W }`)
    // keeps its literal set, as the join does where it is written; both read as `string`.
    if isWideLitJoin(initTy) { return initTy }
  }
  widenLitTy(initTy)
}

// Refuses a compare that can never hold: one side a `const` string literal (or a join of them),
// the other a literal of a type with no member in common (owner ruling, D2198). Reports and
// returns true when it refused; a side that may hold any string never refuses.
export function constLitNeverMeets(
  lx: i32,
  lty: i32,
  rx: i32,
  rty: i32,
  op: string,
  ix: i32,
): boolean {
  let wx = lx
  let wty = lty
  let oty = strLitViewOf(rx, rty)
  if !isWideLitJoin(lty) {
    if !isWideLitJoin(rty) { return false }
    wx = rx
    wty = rty
    oty = strLitViewOf(lx, lty)
  }
  if oty < 0 { return false }
  if !strLitSetsDisjoint(wty, oty) { return false }
  const always = if op == "!=" { "true" } else { "false" }
  tErr(constLitNeverMsg(wx, wty, oty, "comparison is always " + always), ix)
  true
}

// Whether string-literal sets `a` and `b` provably share no value. Membership compares lexemes,
// so a set holding an escape (`"\n"` beside a raw newline) is never called disjoint.
export function strLitSetsDisjoint(a: i32, b: i32): boolean {
  const both: i32[] = []
  flattenStrLits(a, both)
  flattenStrLits(b, both)
  let i = 0
  while i < both.length {
    const t = tyAt(both[i])
    if t is TyLit {
      if t.litText.indexOf("\\") >= 0 { return false }
    }
    i = i + 1
  }
  const bs: i32[] = []
  flattenStrLits(a, bs)
  let k = 0
  while k < bs.length {
    if assignable(bs[k], b) { return false }
    k = k + 1
  }
  true
}

// The element type of a list literal whose runtime elements `elems` (typed `ets`) hold numbers
// of different types: they join apart, as the arms of an `if` do, and each literal element then
// adapts to that join. -1 when no two runtime elements could part, or the function is gated.
export function listJoinApart(elems: i32[], ets: i32[]): i32 {
  // The common list has one element type, and settles without asking any element.
  let mixed = false
  for et in ets {
    if et != ets[0] { mixed = true }
  }
  if !mixed { return -1 }
  const run: i32[] = []
  const lits: i32[] = []
  let parts = false
  let i = 0
  while i < ets.length {
    const et = ets[i]
    if et < 0 || et == TY_ERR { return -1 }
    if armLit(et, elems[i]) {
      lits.push(et)
    } else {
      if run.length > 0 && njMayPart(run[0], et) && !tyEqSameHoles(run[0], et) {
        parts = true
      }
      run.push(et)
    }
    i = i + 1
  }
  if !parts { return -1 }
  let j = run[0]
  i = 1
  while i < run.length {
    j = joinArmLit(j, false, run[i], false)
    i = i + 1
  }
  for l in lits { j = joinArmLit(j, false, l, true) }
  j
}

// The members of literal set `chk` that a value of `obj` can hold, when `chk` is not already
// inside `obj`: the type `x is chk` tests and narrows to. -1 when `chk` is not a literal set,
// `obj` holds no literal, or `chk` fits `obj` as written; `LIT_MEET_NONE` when none of `chk`
// fits. A `null` in `obj` is not a member of the meet.
export function litSetMeetTy(obj: i32, chk: i32): i32 {
  if obj < 0 || chk < 0 { return -1 }
  if !allLitMembers(chk) { return -1 }
  let base = obj
  const ot = tyAt(obj)
  if ot is TyNullable { base = ot.nInner }
  if base < 0 { return -1 }
  const own: i32[] = []
  flattenLits(base, own)
  if own.length == 0 { return -1 }
  if assignable(chk, base) { return -1 }
  // Membership compares lexemes, so `"\u{e9}"` and `"é"` would look disjoint: an escape on
  // either side keeps the tested set as written, refused unless it fits.
  if litSetHasEscape(base) || litSetHasEscape(chk) { return -1 }
  const cands: i32[] = []
  flattenLits(chk, cands)
  const keep: i32[] = []
  let i = 0
  while i < cands.length {
    if assignable(cands[i], base) { keep.push(cands[i]) }
    i = i + 1
  }
  if keep.length == 0 { return LIT_MEET_NONE }
  // The whole set survives: the operand keeps its own type, and with it its rep.
  if keep.length == own.length && allLitMembers(base) { return base }
  if keep.length == 1 { return keep[0] }
  mkUnionTy(keep)
}

// The members of the literal-bearing union `obj` (or its nullable) whose base scalar is the
// primitive `chk`, as one type: what `x is string` narrows `1 | "s"` to (D3522). -1 when `chk` is
// no primitive, when it is already a variant, or when no literal member has it as its base.
export function litBaseMeetTy(obj: i32, chk: i32): i32 {
  if obj < 0 || chk < 0 || !(tyAt(chk) is TyPrim) { return -1 }
  let base = obj
  const ot = tyAt(obj)
  if ot is TyNullable { base = ot.nInner }
  if base < 0 || !(tyAt(base) is TyUnion || tyAt(base) is TyLit) { return -1 }
  const vs: i32[] = []
  flattenVariantsInto(base, vs)
  const keep: i32[] = []
  for v in vs {
    if v >= 0 {
      const vt = tyAt(v)
      if vt is TyLit {
        if tySame(litBaseTy(vt), chk) { keep.push(v) }
      }
    }
  }
  if keep.length == 0 || assignable(chk, base) { return -1 }
  if keep.length == 1 { return keep[0] }
  mkUnionTy(keep)
}

// The members of integer literal set `chk` an integer `obj` can hold, where some but not all
// fit: `d is C` with `d: i32` and `C = 1 | 3000000000` tests the `1` (D3655). -1 otherwise,
// and for a float receiver, whose answer against an integer literal waits on D3689.
export function litPrimMeetTy(obj: i32, chk: i32): i32 {
  if obj < 0 || chk < 0 || !(tyAt(obj) is TyPrim) { return -1 }
  const pn = primNameOf(obj)
  if pn != "i32" && pn != "i64" { return -1 }
  if !allLitMembers(chk) || assignable(chk, obj) { return -1 }
  const cands: i32[] = []
  flattenLits(chk, cands)
  const keep: i32[] = []
  for c in cands {
    const ct = tyAt(c)
    if ct is TyLit {
      if ct.litKind != "int" { return -1 }
    }
    if assignable(c, obj) { keep.push(c) }
  }
  if keep.length == 0 { return -1 }
  if keep.length == 1 { return keep[0] }
  mkUnionTy(keep)
}

// The part of `obj` that always fits the record type `chk`, where `chk` names none of `obj`'s
// members: `b is A` over `b: B` or `B | null` with every `B` an `A` tests as `is B`, and over
// `B | C` with no `C` able to fit `A` it tests the `B` (D4062). -1 otherwise.
export function recFitMeetTy(obj: i32, chk: i32): i32 {
  if obj < 0 || chk < 0 { return -1 }
  const ct = tyAt(chk)
  if !(ct is TyObj) { return -1 }
  let base = obj
  const ot = tyAt(obj)
  if ot is TyNullable { base = ot.nInner }
  if base < 0 { return -1 }
  const bt = tyAt(base)
  if bt is TyObj {
    if recContainedIn(base, chk) { return base }
    return -1
  }
  if !(bt is TyUnion) { return -1 }
  let fit = -1
  for m in bt.uMembers {
    if m < 0 || tySame(m, chk) { return -1 }
    if recContainedIn(m, chk) {
      if fit >= 0 { return -1 }
      fit = m
    } else if !recNeverFits(m, ct) {
      return -1
    }
  }
  fit
}

// Whether every value of record `a` fits record `b` and not the reverse, the two declaring the
// same field names. A record with fields the other lacks is no containment D3885 settles.
function recContainedIn(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return false }
  const at = tyAt(a)
  const bt = tyAt(b)
  if !(at is TyObj) || !(bt is TyObj) { return false }
  if at.objFieldNames.length != bt.objFieldNames.length { return false }
  for f in at.objFieldNames {
    if strListIndexOf(bt.objFieldNames, f) < 0 { return false }
  }
  assignable(a, b) && !assignable(b, a)
}

// Whether narrowing a record `cur` to `chk` keeps its storage: a field narrowed to a string
// literal set is stored as an atom in `chk` and as a string in `cur`, so the value cannot be
// delivered as a `chk` (D4058).
export function recFitNarrowKeepsRep(cur: i32, chk: i32): boolean {
  const names: string[] = []
  const sets: i32[] = []
  if recFitNarrowedFields(cur, chk, names, sets) != 1 { return true }
  for st in sets {
    for lex in tyLitSetMemberLexes(st) {
      if nameIsQuotedLeaf(lex) { return false }
    }
  }
  true
}

// For `r is B` over a single record `r: A` (or `A | null`) where every `B` is an `A` but not
// the reverse, the fields `B` narrows and the literal set each must hold (D4058). -1 when the
// test is not that shape, 0 when a narrowed field is not a literal set over `A`'s, else 1.
export function recFitNarrowedFields(
  obj: i32,
  chk: i32,
  names: string[],
  sets: i32[],
): i32 {
  if obj < 0 || chk < 0 { return -1 }
  const ct = tyAt(chk)
  if !(ct is TyObj) { return -1 }
  let base = obj
  const ot = tyAt(obj)
  if ot is TyNullable { base = ot.nInner }
  if base < 0 { return -1 }
  const bt = tyAt(base)
  if !(bt is TyObj) || !recContainedIn(chk, base) { return -1 }
  let i = 0
  while i < ct.objFieldNames.length {
    const fb = ct.objFieldTypes[i]
    const at = strListIndexOf(bt.objFieldNames, ct.objFieldNames[i])
    if at < 0 { return 0 }
    const fa = bt.objFieldTypes[at]
    if !assignable(fa, fb) {
      if tyLitSetMemberLexes(fb).length == 0 { return 0 }
      names.push(ct.objFieldNames[i])
      sets.push(fb)
    }
    i = i + 1
  }
  if names.length == 0 { return 0 }
  1
}

// Whether a value `x` yields may be a record that already exists: a leaf of it (through `if`,
// `match` and block tails) whose origin is not an object literal, `null`, or an element read from
// a map or list whose `Map()` bindings may still adopt the record it is delivered as.
export function recJoinFixed(x: i32): boolean {
  const leaves: i32[] = []
  tailValueLeaves(x, leaves)
  for l in leaves {
    const o = recOriginExpr(l)
    if o >= 0 && o < P.nodes.length {
      const e = nodeAt(o)
      if !(e is ObjLit) && !(e is NullLit) && !recContainerReadFresh(o) {
        return true
      }
    }
  }
  false
}

// Is `o` an element read of a map or list whose every value is built where it is delivered?
export function recContainerReadFresh(o: i32): boolean {
  const b = recIndexBase(o)
  b >= 0 && recContainerIsAt(b) && recContainerDeliver(b, -1, 16, false)
}

// Deliver `o`, an element read of such a container, as a `dstTy`: the container is delivered as
// one holding it, and every `Map()` binding it may be adopts its part. False, adopting nothing,
// otherwise.
export function recContainerReadDeliver(o: i32, dstTy: i32): boolean {
  const b = recIndexBase(o)
  if b < 0 || !recContainerIsAt(b) || !recContainerDeliver(b, -1, 16, false) {
    return false
  }
  recContainerDeliver(b, recContainerDst(b, dstTy), 16, true)
}

// Is `b` a map or a list?
function recContainerIsAt(b: i32): boolean {
  const bt = nonNulTyOf(nodeTyIxOf(b))
  if bt < 0 || bt >= T.tys.length { return false }
  const c = tyAt(bt)
  c is TyMap || c is TyArray
}

// Can every value the container `x` may be take the type it is delivered as: a `Map()`, a list
// literal, or a `Map()` binding that may still adopt, reached through aliases, joins, element
// reads, same-shape generic calls and calls of functions with no declared result. With `apply`,
// each such binding adopts its part of `dst`, the container type `x` is delivered as.
function recContainerDeliver(
  x: i32,
  dst: i32,
  depth: i32,
  apply: boolean,
): boolean {
  if depth <= 0 { return false }
  const p = cwPeelValue(x)
  if p < 0 || p >= P.nodes.length { return false }
  if exprIsCollCtorCall(p) { return true }
  const e = nodeAt(p)
  if e is Ident {
    const d = recFreshMapDeclOf(p)
    if d >= 0 {
      if recAdNoAdopt.has(d) { return false }
      if apply { recMapDeclDeliver(d, p, dst) }
      return true
    }
    const held = recHeldLit(p)
    if held < 0 { return false }
    return recContainerDeliver(held, dst, depth - 1, apply)
  }
  if e is ArrayLit {
    const ed = if dst >= 0 { tyArrayElemIx(nonNulTyOf(dst)) } else { -1 }
    for el in e.arrElems {
      if (
        nodeAt(el) is Spread
        || !recContainerDeliver(el, ed, depth - 1, apply)
      ) {
        return false
      }
    }
    return true
  }
  if recIsJoin(p) {
    const leaves: i32[] = []
    tailValueLeaves(p, leaves)
    for lf in leaves {
      if !recContainerDeliver(lf, dst, depth - 1, apply) { return false }
    }
    return true
  }
  const co = recCoalesceOperands(p)
  if co.length == 2 {
    return recContainerDeliver(co[0], dst, depth - 1, apply)
      && recContainerDeliver(co[1], dst, depth - 1, apply)
  }
  const ib = recIndexBase(p)
  if ib >= 0 {
    return recContainerDeliver(ib, recContainerDst(ib, dst), depth - 1, apply)
  }
  const pa = recShapePassArg(p)
  if pa >= 0 { return recContainerDeliver(pa, dst, depth - 1, apply) }
  const fd = recInferredFnOf(p)
  if fd < 0 { return false }
  for lf in recFnValueLeaves(fd) {
    // A local the function also hands elsewhere is shared, so it is not built here.
    if recLeafEscapes(lf) || !recContainerDeliver(lf, dst, depth - 1, apply) {
      return false
    }
  }
  true
}

// The `Map()` binding `d`, read at `at`, adopts the map type `dst`.
function recMapDeclDeliver(d: i32, at: i32, dst: i32) {
  const mt = nodeTyIxOf(at)
  if dst < 0 || mt < 0 || mt >= T.tys.length { return 0 }
  if tyAt(mt) is TyMap && tyAt(dst) is TyMap {
    recAdPushMapDecl(d, mt, dst, at)
  }
  0
}

// The type the container `b` is delivered as when an element read out of it is delivered as
// `dst`: a map of the same key, or a list, holding it. -1 for -1 or any other container.
function recContainerDst(b: i32, dst: i32): i32 {
  const v = nonNulTyOf(dst)
  if v < 0 || v >= T.tys.length { return -1 }
  const bt = nonNulTyOf(nodeTyIxOf(b))
  if bt < 0 || bt >= T.tys.length { return -1 }
  const c = tyAt(bt)
  match c {
    TyMap => {
      return mkMapTy(c.mKey, v, c.mSet)
    }
    TyArray => {
      return mkArrayTy(v)
    }
    // No other container is read by element here.
    TyObj | TyFunc | TyPrim | TyErr | TyVar | TyLit | TyNeg | TyNullable | TyUnion => {
      return -1
    }
  }
}

// `t` itself when it is a function type, else the one function member of union `t`; -1 when
// there is none or more than one.
function fnArmOf(t: i32): i32 {
  const d = tyAt(t)
  if d is TyFunc { return t }
  if !(d is TyUnion) { return -1 }
  let found = -1
  for m in d.uMembers {
    if m >= 0 && tyAt(m) is TyFunc {
      if found >= 0 { return -1 }
      found = m
    }
  }
  found
}
