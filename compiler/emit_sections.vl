    // `{backing,len,cap}` triple as the i32 list, over the string backing.
    wU8(94)  // 0x5e array (keys/string backing)
    wU8(99)  // 0x63 (ref null ht) — nullable string ref
    wSLEB(sTypeIdx)
    wU8(1)   // mutable
    wU8(95)  // 0x5f struct (string-list wrapper)
    wU8(3)   // 3 fields
    wU8(100) // field 0 backing: 0x64 (ref ht) — non-null
    wSLEB(mkArrIdx)
    wU8(1)   // mutable
    wU8(127) // field 1 len: 0x7f i32
    wU8(1)   // mutable
    wU8(127) // field 2 cap: 0x7f i32
    wU8(1)   // mutable
  }
  if mUsed {
    // The map struct — the 7-field open-addressing rep documented at `mUsed`. Field order and
