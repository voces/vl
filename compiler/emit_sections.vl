// Host opt-in for the name section (see `gEmitNames`). The driver does NOT call
// this, so every golden/fixpoint emit leaves names OFF; only the native tool
// turns it on. Idempotent — any nonzero `on` enables, `0` disables.
export function setEmitNames(on: i32) {
  if on != 0 { gEmitNames = 1 } else { gEmitNames = 0 }
  0
}

function emitReset() {
  // NOTE: `gImports` and `startStmts` are NOT reset here — they are assigned by
  // their own passes (the print-detection scan in `emitProgram`, `collectFns`)
  // which run BEFORE `emitModule` calls this; resetting them here would clobber
  // those passes' results.
  W.bytes = []
  curBuf = W.bytes
  0
}

// ── module header ────────────────────────────────────────────────────────────
function emitHeader() {
  // "\0asm" magic + version 1
  wU8(0)
  wU8(97)  // 'a'
  wU8(115) // 's'
  wU8(109) // 'm'
  wU8(1)
  wU8(0)
  wU8(0)
  wU8(0)
  0
}

// Rebuild `localNames` for the function at `fnIx`: clear it, then collect every
// declared-local name in the body (validating each as i32). Returns 0 on success,
// or -1 (via `emitFail`) on any unsupported local. Must run before lowering the
// body so identifier resolution and the locals vector see the full set.
function buildLocals(fnIx: i32) {
  localNames = []
  localIsRef = []
  localStructIdx = []
  localLoopVar = []
  localBlockLet = []
  localLoopIter = []
  localDeclIx = []
  localLitUnion = []
  // Reset the lexical scope stack per function. `collectLocals` pushes/pops frames as
  // it walks (leaving it balanced/empty), then the emit pass rebuilds it in lockstep.
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  const fn = P.nodes[fnIx]
  if fn is FuncDecl { return collectLocals(fn.fnBody, fnIx) }
  emitFail("emitProgram: not a function declaration")
}

// Verify every parameter of the FuncDecl at `fnIx` is typed `i32` — the only type
// this slice emits. Returns 0 on success or -1 (via `emitFail`) otherwise.
function checkParams(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      const p = P.nodes[params[pi]]
      if p is Param {
        if p.parType < 0 {
          // An un-annotated parameter — a contextually-inferred callback literal
          // (`xs.map(function(n) n * 2)`). The checker has already pinned its type from the receiver;
          // this emitter's default kind for a missing annotation is i32 (`vtKindOfType(-1)` → 0), the only inferred-param receiver element kind in scope. Accepted as-is.
          pi = pi + 1
          continue
        }
        const ty = P.nodes[p.parType]
        if ty is TypeRef {
          // The parameter valtype ladder: i32, `boolean` (same 0x7f valtype), the declared struct
          // type, a nullable struct (`S | null`), an array (`i32[]`), or `string` are allowed;
          // anything else fails here. Uses `nodeTyHasRepTyVar`, not `nodeTyHasTyVar` and not a
          // constructor test: every rung below answers yes about a constructor over an unsubstituted type parameter, so `a: T[]` would otherwise lower at the i32 default (D426) — what lands here is a type parameter no call site binds.
          if nodeTyHasRepTyVar(p.parType) {
            return emitFail(
              "emitProgram: parameter `" +
                ty.tyName +
                "` still names an unsubstituted type parameter — a lambda declared inside a generic body keeps the enclosing `T`, so its signature is interned at the unsubstituted type; give the lambda a concrete parameter type or take the value from the enclosing scope",
            )
          } else if tyIsFuncType(p.parType) {
            // a function-typed (closure fat-pointer) param — kind 14
          } else if nulCloFlag(p.parType) == 1 {
            // A nullable function-value param (`((i32) => i32) | null`, kind 19): its `=>` sits nested,
            // so `tyIsFuncType` (top-level-arrow only) does not match it; accept it here explicitly, as `vtKindOfType` already maps it to kind 19.
          } else if retNulRefFlag(p.parType) == 1 {
            // accepted — a `(ref null $S)` param
          } else if retNulListFlag(p.parType) == 1 {
            // accepted — a `(ref null $lTypeIdx)` param (`i32[] | null`, kind 15)
          } else if nulScalarListKindOfNode(p.parType) != null {
            // accepted — a DISTINCT-backing nullable scalar-list param (`i64[] | null` etc.):
            // a `(ref null $wrapper)` cell over the leaf list's own wrapper heap type
            // (`fbValtype` nulstrlist/nulf64list/nuli64list/nulf32list arms).
          } else if retNulRefArrFlag(p.parType) == 1 {
            // accepted — a `(ref null $wrapper)` NULLABLE ref-array param (`<ref-array> | null`, kind 18):
            // its `vtKindOfType` is `"nulreflist"` and `paramStructIdxOf` resolves the inner wrapper slot.
            // (The array rung below once rejected the `| null`-suffixed NAME; it asks the type
            // now (#1609), but this rung still claims the shape first and the note stands.)
          } else if tyIsNulBool(p.parType) {
            // accepted — a `boolean | null` NICHE param (the i32 sentinel 0/1/2)
          } else if retNulStringFlag(p.parType) == 1 {
            // accepted — a `string | null` param (`(ref null $sTypeIdx)`, kind 16)
          } else if retMapFlag(p.parType) == 1 {
            // Accepted — a string-keyed map param (kind 6, `(ref $mapStruct)`). The mv shape crosses the
            // boundary (`paramStructIdxOf` → `mapAnnShape`): -1 for a mono i32/boolean map, its slot for a
            // string-valued one. A struct/f64/i64-valued map is not yet supported — `retMapFlag` returns 0, falling through to the reject below.
          } else if retNulMapFlag(p.parType) == 1 {
            // accepted — a NULLABLE map param (`{[string]: V} | null`, kind `nulmap`): the
            // same shape over a `(ref null $mapStruct)` cell. The `!= null` narrow
            // (`ref.is_null`) and the narrowed ops (`t["k"]` / `t["k"] ?? d`) recover the
            // non-null ref at the receiver — the checker proved every such read guarded.
          } else if nodeTyIsLitUnionAlias(p.parType) {
            // accepted — a literal-union param is an i32-backed interned atom (kind 0).
          } else if nodeTyIsNulLitUnion(p.parType) {
            // Accepted — a `K | null` niche param is the i32 atom with the spare `-1` = null (kind 0).
            // The five scalar rungs below stay on the name (a deliberate decline, B102): a numeric
            // literal-union param renders as `f64` after canon softening, so the spelling accepts it here
            // while the arena sees a `TyUnion` of `TyLit`s and rejects — the softened name is the right answer, since a numeric litunion param is lowered as its base scalar.
          } else if numLitUnionHasBase(nodeTyIxOf(p.parType)) {
            // Accepted — a numeric literal-union param (`1 | 2`, `type Z = 1 | 2`) is lowered as its base
            // scalar, matching what canon's softened spelling reported to the scalar rungs below. Stated
            // from the arena here (`numLitUnionBaseName` reads the `TyUnion` of `TyLit`s structurally, not
            // a rendering), which lets those rungs stop reading `ty.tyName` — without it, a numeric litunion param falls through to the reject once the spelling stops answering for it (B102).
          } else if !paramScalarIs(p.parType, ty.tyName, "i32") {
            if !paramScalarIs(p.parType, ty.tyName, "i64") {
              // i64 rides the 0x7e valtype (Slice 1)
              if !paramScalarIs(p.parType, ty.tyName, "f64") {
                // f64 rides the 0x7c valtype (Slice 3)
                if !paramScalarIs(p.parType, ty.tyName, "f32") {
                  // f32 rides the 0x7d valtype (Slice 5)
                  if !paramScalarIs(p.parType, ty.tyName, "boolean") {
                    // The arena, not the registry. `isSName` tested a name-keyed struct registry with known
                    // gaps — generic instances (`Box<i32>`) and `#anon0` inline shapes resolving to an empty `{}`.
                    // The question here is "does this param take a struct ref", which needs shape, not identity;
                    // removing `isSName` outright breaks no corpus file.
                    if !nodeTyIsStructish(p.parType) {
                      // The arena, and nothing else. `isUName` tested a registry keyed by the union's spelling;
                      // replaced by `nodeTyIsUnionish` plus a spelling-tree read for a small remainder, which
                      // is gone too: the struct rung above moved onto the arena, and a same-shape union
                      // collapses to a `TyObj`, so the struct rung claims both files before this one is reached.
                      if !nodeTyIsUnionish(p.parType) {
                        // The variant rung is gone. It asked `variantIndexOf(ty.tyName)` — the last rendered-name
                        // lookup in the emitter — and had resisted two prior conversion attempts as unconvertible.
                        // It needed no converting: a variant's recorded type is a `TyObj`, so the struct rung above
                        // now claims every variant param before this point is reached; neutralising it breaks zero corpus files.
                        if true {
                          // The arena, not the trailing `]`. `nameIsArray` tested the rendering's last character,
                          // which also matched a union whose last arm is an array. The union rung above now claims
                          // those boxes from the type, so this can be the strict `TyArray` question it always meant;
                          // removing `nameIsArray` breaks none of the corpus files that reach this rung.
                          if !nodeTyIsArrayish(p.parType) {
                            // The arena, not the spelling. `nameIsString` read canon's softened rendering, which reports
                            // `string` for three different arena shapes: a `TyPrim`, a single-member `TyLit` (which reps
                            // as its base), and an inline string-literal union (the alias form is claimed earlier by
                            // `nodeTyIsLitUnionAlias`). `nodeScalarBaseIs` states that collapse from the type instead.
                            if !nodeScalarBaseIs(p.parType, "string") {
                              return emitFail(
                                "emitProgram: only i32, i64, f64, f32, boolean, struct, union, array, or string parameters are supported",
                              )
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        } else {
          return emitFail("emitProgram: parameter type is not a type name")
        }
      } else {
        return emitFail("emitProgram: malformed parameter")
      }
      pi = pi + 1
    }
    return 0
  }
  emitFail("emitProgram: not a function declaration")
}

// ── locals-vector emission (derived, never separately counted) ──
// The locals vector is a sequence of (count, valtype) runs. This emitter uses a count of 1
// per local — one run per declared local and per scratch slot — so the run total equals the
// local count. The run helpers stream straight to `curBuf` (bind it with `wTarget` first); each emits the `1` count then a valtype.

// Builds the size-prefixed code-section body for the `FuncDecl` at `fnIx`: the locals vector
// (declared locals, all i32), the body's statement instructions, then `end`. Framed bytes are
// appended onto `out`. Returns 0, or -1 (via `emitFail`) on any unsupported shape. Every
// declared local is i32, so the vector is one run `(L, 0x7f)`; params are not counted here — they are encoded in the functype, not the locals vector.
function emitFuncCode(out: i32[], fnIx: i32, fnPos: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    // Anchors any emit failure raised while lowering this body at its declaration (`emitFail`
    // snapshots `emitCurFnIx`). Sequential emission means the cursor's value at failure time is
    // the offending function; `fnPos` is the caller's own `fnStmts` loop index, which `fnStmtsPosOf` reads instead of scanning.
    emitCurFnIx = fnIx
    emitCurFnPos = fnPos
    // Replays the narrowing this frame's closure sits inside, for the whole body —
    // locals collection included, since a `const t = <captured narrowed read>` is typed from it.
    // Only a value-union-box capture is seeded, so a function capturing nothing narrowed emits
    // identical bytes. The depth is restored on the success path; a -1 below fails the entire module, so a leaked depth cannot be observed.
    const savedCapNarrow = capNarrowSeed(fnPos)
    // Collect + validate declared locals BEFORE lowering, so identifier resolution
    // and the locals vector both see the full per-function set.
    if buildLocals(fnIx) < 0 { return -1 }
    // Re-banks the declaration-site narrowing of the frames declared inside this body, now that
    // this frame's local table exists — the only point at which a guard over a function-scope
    // local resolves. Bodies emit in `fnStmts` order and a nested frame is collected after its
    // parent, so the record banks before the nested body that reads it. Gated on `fnValUsed`: with no function value or capture anywhere, the scan is skipped entirely.
    if fnValUsed { capNarrowRecordFrame(fnPos) }

    // If this function pushes, reserve three scratch locals after the declared ones.
    // `pushScratchBase` is their first wasm index; the inline-push sequence reads
    // `pushScratchBase`+0/+1/+2. Set before `emitStmts` so a `.push` can resolve its scratch
    // slots. One body walk (`blockPushPopBits`) classifies every `.push`/Member-`.pop` receiver once and yields all six kind flags together.
    fnUsesPush = false
    fnUsesRefPush = false
    fnUsesStrPush = false
    fnUsesNulStrPush = false
    fnUsesF64Push = false
    fnUsesI64Push = false
    fnUsesF32Push = false
    fnUsesU8Push = false
    fnUsesU8Push = false
    fnUsesAtomStage = false
    fnUsesStrOp = false
    fnUsesArrNew = false
    fnUsesCoalesceCall = false
    fnUsesMap = false
    // A function-value call (`call_ref`) anywhere in the body reserves the closure
    // scratch slot. Only detected when a function value exists module-wide (lambdas).
    fnUsesCallRef = false
    fnUsesUnionAs = moduleHasUnionAs()
    // The numeric exact-or-fail staging slots, module-wide for `moduleHasUnionAs`'s reason.
    fnUsesNumCast = moduleHasNumCast()
    fnUsesVariantRebox = false
    // Collect the DISTINCT ref-list element-type slots this function pushes onto (each
    // gets its own typed 4-slot scratch frame). Empty unless `fnUsesRefPush`.
    fnRefPushSlots = []
    refPushBaseBySlot = []
    // Collect the `.map`/`.filter` HOF sites this body lowers (each reserves the
    // shared 4-slot frame + one typed src/dst slot per distinct receiver/result type).
    fnUsesMapFilter = false
    fnUsesMapKeys = false
    fnUsesMapVals = false
    fnUsesMapVals = false
    mfSrcKinds = []
    mfSrcSlots = []
    mfSrcBases = []
    mfDstKinds = []
    mfDstSlots = []
    mfDstBases = []
    // List `==`/`!=`/`+` frames (collections-design §VL.4/§VL.6). May also flip
    // `fnUsesStrOp` (a string-list compare rides the string-op frame), so its scan leads
    // the sweep and the `fnHasStrOp` leg behind it is skipped once the flag is true.
    fnUsesListEqI = false
    fnUsesListEqS = false
    fnListEqRSlots = []
    fnListCatKinds = []
    fnListCatSlots = []
    fnListEqGKinds = []
    fnListEqGSlots = []
    fnUsesCloEq = false
    dupScanRun(fnIx)
    const nLocals = localNames.length
    // Union-box sink: reserve the shared tag/payload pair when this function's result is the box
    // and it has two or more exits (the return sink), or it binds a union box from an if-expression
    // (the binding sink). The frame must be laid out before the body (a `local.set` needs the
    // index), so both are predictions; `uSinkFired` records what the return path actually did.
    fnUsesUnionSink = fnUnionRetSinkOk(fnIx)
    fnUsesUnionLetSink = fnUnionLetSinkOk(fnIx)
    uSinkFired = 0
    uBoxNewEnd = -1
    tailCallEnd = -1
    tailCallIdx = -1
    // Lays out every scratch frame after the params + declared locals via the FuncBuilder cursor,
    // which sets `pushScratchBase`/`refPushScratchBase`/`refPushBaseBySlot`/`strPushScratchBase`/
    // `strScratchBase`/`mapScratchBase` from one running offset in frame order. Scratch frames
    // land after the params and the hidden env param (local 0) when a function value exists module-wide, so the cursor starts past `envSlotShift`.
    fbBeginFunc(fn.fnParams.length + envSlotShift(fnIx), nLocals)

    const bodyExpr: i32[] = []
    // Binds the writer at `bodyExpr` so the `fb*` opcode methods (which append to `curBuf`) write
    // the function-body instructions; the recursive lowering threads the same `bodyExpr` as its
    // `body` arg, so `curBuf == body` throughout and not-yet-converted raw `body.push(...)` sites
    // interleave identically. Restores the previous target afterwards.
    const exprPrev = wTarget(bodyExpr)
    // Reset the emit-time scope stack + slot cursor; `emitFuncBody` re-walks the body
    // in collect's pre-order, so the n-th `LetDecl` it emits re-derives declared-local
    // slot `n` and binds it for in-scope resolution.
    scopeNames = []
    scopeSlots = []
    scopeFrames = []
    emitLetCursor = 0
    // Reset the loop control-frame tracking (`break`/`continue` branch-depth state)
    // so a previous function's open frames never leak into this one.
    ctrlDepth = 0
    loopContDepth = []
    loopBrkDepth = []
    loopContLabel = []
    loopBrkLabel = []
    if emitFuncBody(bodyExpr, fn.fnBody, fnIx) < 0 { return -1 }
    wTarget(exprPrev)

    const body: i32[] = []
    // Locals vector: one (count=1, valtype) run per DECLARED local, then the scratch
    // frames in `fbBeginFunc`'s layout order. Derived from the local set + scratch
    // flags by the FuncBuilder (Phase H) — the run count and every valtype come from
    // ONE place, so they cannot desync from the frame layout above.
    if fbEmitLocalsVec(body, nLocals) < 0 { return -1 }
    // The return sink's single exit block, opened around the whole body so every sunk `return`'s
    // `br <ctrlDepth>` lands on it. Emitted only when a `return` actually sank — otherwise the
    // body holds no branch to it and the block would be dead weight.
    if uSinkFired > 0 {
      const blkPrev = wTarget(body)
      fbBlock(64) // 0x02 block, 0x40 void blocktype
      wTarget(blkPrev)
    }
    appendAll(body, bodyExpr)
    // Bind the writer at `body` (the framed code entry) for the trailing padding/end
    // opcodes emitted via the `fb*` methods.
    const endPrev = wTarget(body)
    // If the body does not end in an explicit `return`/tail value, control falls through to the
    // function `end` with an empty stack, and the validator requires the function's result type
    // there. A nullable return is a live fall-through path (the checker permits it precisely
    // because `null` is in the return type), so it emits `null`; a non-nullable return means the checker has proven the fall-through dead, so `unreachable` is sound padding, never run.
    let isVoidFn = false
    if fnPos >= 0 {
      if fRetVoid[fnPos] == 1 { isVoidFn = true }
    }
    if !isVoidFn && !bodyEndsInReturn(fn.fnBody, fnIx) {
      if fnRetNullBearing(fnIx) {
        if emitNullForRet(body, fnIx) < 0 { return -1 }
        // Inside the sink's exit block this fall-through value cannot simply be left on
        // the stack for the function `end` — the block is void. It terminates like any
        // other exit: sunk when it built a box, a plain `return` otherwise.
        if uSinkFired > 0 { emitUnionRetSink(fnIx) }
      } else {
        fbUnreachable() // 0x00 unreachable (dead padding for the result type)
      }
    }
    // Close the sink's exit block and perform the function's ONE box construction, whose
    // operands every sunk `return` has already written. Falling off the function `end`
    // with it on the stack is the result.
    if uSinkFired > 0 {
      fbEnd() // 0x0b end — the exit block
      fbLocalGet(unionSinkBase)
      fbLocalGet(unionSinkBase + 1)
      fbStructNew(uBoxIdx)
    }
    fbEnd() // 0x0b end
    wTarget(endPrev)
    // Stream the size-prefixed code entry onto `out` (the code-section payload). Bind
    // the writer at `out` explicitly: the caller restores `curBuf` off the payload
    // before this loop, so `curBuf` is NOT `out` on entry here.
    const outPrev = wTarget(out)
    wULEB(body.length)
    wBytes(body)
    wTarget(outPrev)
    restoreNarrow(savedCapNarrow)
    return 0
  }
  emitFail("emitProgram: not a function declaration")
}

// Record the ref-list slot of a bare top-level `recv.push(x)` statement (the
// block-level collector handles pushes nested in loop/if bodies).
function recordStartRefPushSlot(stmtIx: i32) {
  const s = P.nodes[stmtIx]
  if s is Call {
    const callee = P.nodes[s.callFn]
    if callee is Member {
      if callee.memProp == "push" {
        recordRefPushSlot(refListSlotOfExpr(callee.memObj, -1))
      }
    }
  }
  0
}

// Runs every scratch-detection walker over one start-fn block (a loop body, an if
// arm), feeding the `fnUses*` flags and the ref-push slot recorders. The single
// push/pop walk feeds the push flags: a `.push` and a Member-receiver `.pop`
// (which reuses the push frame's slots) each need the scratch quad.
function startScanBlock(blockIx: i32) {
  applyPushPopBits(blockPushPopBits(blockIx, -1))
  if blockHasStrOp(blockIx, -1) { fnUsesStrOp = true }
  if blockHasArrNew(blockIx) { fnUsesArrNew = true }
  if blockHasCoalesceCall(blockIx) { fnUsesCoalesceCall = true }
  if blockHasMapOp(blockIx, -1) { fnUsesMap = true }
  collectRefPushSlots(blockIx, -1)
  collectMemberPopRefSlots(blockIx, -1)
  0
}

// Runs every expression-level scratch-detection walker over one start-fn header expression —
// a `while` condition, a `for`-range bound, a `for`-in iterable, an `if` condition.
// `startScanBlock`'s counterpart for the parts of a compound statement that are not a block:
// those expressions lower into the start function's body exactly as a bare top-level statement does, so they need the same frames (a `for`-range `step` is excluded — a non-constant step is already a clean emit reject).
function startScanHeaderExpr(exprIx: i32) {
  if exprIx < 0 { return 0 }
  if exprHasStrOp(exprIx, -1) { fnUsesStrOp = true }
  if exprHasArrNew(exprIx) { fnUsesArrNew = true }
  if exprHasCoalesceCall(exprIx) { fnUsesCoalesceCall = true }
  if exprHasMapOp(exprIx, -1) { fnUsesMap = true }
  applyPushPopBits(exprPopBits(exprIx, -1))
  collectMemberPopRefSlotsExpr(exprIx, -1)
  0
}

// Scans a top-level `if` chain: the condition expression plus every arm's block (an `else if` recurses through this function).
function startScanIf(ifIx: i32) {
  const st = P.nodes[ifIx]
  if st is IfStmt {
    startScanHeaderExpr(st.ifCond)
    // Narrow across each arm (mirroring `ifChainHasStrOp` / `emitStmt`): the
    // then-branch sees the guard's narrowing, the else-branch sees a VALUE
    // union's complement — so a top-level `if w is string { print(w) }`
    // reserves the string scratch frame in the start function.
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(st.ifCond, -1)
    startScanBlock(st.ifThen)
    if narrowed { restoreNarrow(savedTop) }
    if st.ifElse >= 0 {
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(st.ifCond, -1)
      const els = P.nodes[st.ifElse]
      if els is Block { startScanBlock(st.ifElse) }
      if els is IfStmt { startScanIf(st.ifElse) }
      if narrowedElse { restoreNarrow(savedElseTop) }
    }
  }
  0
}

// ── PROMOTION of a top-level binding to a start-function LOCAL (G2c) ─────────
// `emit_state.vl`'s `gPromoOk` header carries the model and the measurement that
// motivates it. This block is the ANALYSIS: the reachability walk, the safety
// predicate, and the one query the four start-fn / global-section gates share.

// Marks every arena node reachable from the top-level region — the top-level statement list
// and initializers — into `marks`, without descending into a nested `FuncDecl` (a lambda
// literal written at top level is lifted to its own wasm function, but its body still
// addresses the binding as a module cell). A node shape this ladder does not know leaves its descendants unmarked, refusing the promotion — a hole here costs population, never soundness.
function promoMark(marks: i32[], ix: i32) {
  if ix < 0 { return 0 }
  if ix >= marks.length { return 0 }
  if marks[ix] == 1 { return 0 }
  marks[ix] = 1
  const n = P.nodes[ix]
  if n is FuncDecl { return 0 }
  if n is Block {
    const bs = n.blkStmts
    let bi = 0
    while bi < bs.length {
      promoMark(marks, bs[bi])
      bi = bi + 1
    }
    return 0
  }
  if n is LetDecl { return promoMark(marks, n.letInit) }
  if n is BinExpr {
    promoMark(marks, n.binLeft)
    return promoMark(marks, n.binRight)
  }
  if n is Call {
    promoMark(marks, n.callFn)
    const args = n.callArgs
    let ai = 0
    while ai < args.length {
      promoMark(marks, args[ai])
      ai = ai + 1
    }
    return 0
  }
  if n is IfStmt {
    promoMark(marks, n.ifCond)
    promoMark(marks, n.ifThen)
    return promoMark(marks, n.ifElse)
  }
  if n is WhileStmt {
    promoMark(marks, n.whileCond)
    return promoMark(marks, n.whileBody)
  }
  if n is ForRange {
    promoMark(marks, n.frFrom)
    promoMark(marks, n.frTo)
    promoMark(marks, n.frStep)
    return promoMark(marks, n.frBody)
  }
  if n is ForIn {
    promoMark(marks, n.fiIter)
    return promoMark(marks, n.fiBody)
  }
  if n is RetStmt { return promoMark(marks, n.retArg) }
  if n is Unary { return promoMark(marks, n.unArg) }
  if n is Paren { return promoMark(marks, n.parInner) }
  if n is Member { return promoMark(marks, n.memObj) }
  if n is OptMember { return promoMark(marks, n.omObj) }
  if n is IsExpr { return promoMark(marks, n.isObj) }
  if n is AsExpr { return promoMark(marks, n.asObj) }
  if n is Index {
    promoMark(marks, n.idxArr)
    return promoMark(marks, n.idxIndex)
  }
  if n is ArrayLit {
    const es = n.arrElems
    let ei = 0
    while ei < es.length {
      promoMark(marks, es[ei])
      ei = ei + 1
    }
    return 0
  }
  if n is ObjLit {
    const fs = n.objFields
    let fi = 0
    while fi < fs.length {
      promoMark(marks, fs[fi])
      fi = fi + 1
    }
    return 0
  }
  if n is FieldInit { return promoMark(marks, n.fiValue) }
  if n is MatchExpr {
    promoMark(marks, n.matchScrut)
    const pats = n.matchPats
    let pi = 0
    while pi < pats.length {
      promoMark(marks, pats[pi])
      pi = pi + 1
    }
    const binds = n.matchBinds
    let bj = 0
    while bj < binds.length {
      promoMark(marks, binds[bj])
      bj = bj + 1
    }
    const bodies = n.matchBodies
    let mj = 0
    while mj < bodies.length {
      promoMark(marks, bodies[mj])
      mj = mj + 1
    }
    return 0
  }
  0
}

// The cheap half of the safety predicate — the two clauses that read only this binding's own
// declaration (the reachability clause is `computeGlobalPromotion`'s). P2: the cell kind is a
// plain numeric scalar, for which `fbValtypeNullable`/`fbValtype` are the same byte, so a
// start-fn local is a drop-in (a ref cell is nullable but would be a non-null local, not attempted here). P3: the binding has an initializer, since a promoted slot has no other way to get a value.
function globalPromotable(gi: i32) {
  const d = P.nodes[globalStmts[gi]]
  if d is LetDecl {
    if d.letInit < 0 { return false }
    const ck = globalCellKind(globalStmts[gi])
    if ck == "i32" { return true }
    if ck == "i64" { return true }
    if ck == "f64" { return true }
    if ck == "f32" { return true }
    return false
  }
  false
}

// Decides, for every top-level binding, whether it lives in a cell or a start-function local,
// and re-densifies the cell indices around the ones that leave. Runs once, at the top of
// `emitModule`, after every arena-mutating pass. The safety predicate is P1 here plus P2/P3
// in `globalPromotable` plus P4: P1 requires an existing top-level statement list (promotion never mints a start function); P4 requires every `Ident` spelling this name to sit inside the top-level region.
export function computeGlobalPromotion() {
  gPromoInStart = false
  // Rebuilt, not reset in place. `collectFns` seeds these three arrays so a `userGlobalIdx`
  // before this pass still answers the identity, but any pass that appends a global after
  // `collectFns` would leave them short — the same hazard `emit_state.vl` records against `globalIndexBySid`, whose "built once" invariant does not depend on a rebuild here.
  gPromoOk = []
  gPromoSlot = []
  gCellIdx = []
  let ri = 0
  while ri < globalStmts.length {
    gPromoOk.push(0)
    gPromoSlot.push(-1)
    gCellIdx.push(ri)
    ri = ri + 1
  }
  if startStmts.length == 0 {
    return 0 // P1
  }
  let anyCand = false
  let ci = 0
  while ci < globalStmts.length {
    if globalPromotable(ci) {
      gPromoOk[ci] = 1
      anyCand = true
    }
    ci = ci + 1
  }
  if !anyCand { return 0 }
  // P4, in two halves. The reachability walk marks the top-level region; the flat arena
  // scan then finds every `Ident` the walk did NOT reach and vetoes the binding it
  // names. The scan is over the WHOLE arena, which is what makes "everywhere else"
  // exhaustive without needing to enumerate what "everywhere else" is.
  const marks: i32[] = []
  let mi = 0
  while mi < P.nodes.length {
    marks.push(0)
    mi = mi + 1
  }
  let gi = 0
  while gi < globalStmts.length {
    promoMark(marks, globalStmts[gi])
    gi = gi + 1
  }
  let si = 0
  while si < startStmts.length {
    promoMark(marks, startStmts[si])
    si = si + 1
  }
  let ai = 0
  while ai < P.nodes.length {
    const nd = P.nodes[ai]
    if nd is Ident {
      // A module-`const` parameter default vetoes promotion unconditionally, marked or not. The
      // reachability walk answers "is this node reached", and a default node is shared by every
      // call site that omits the argument — the same node sits in a top-level call (marked) and a
      // nested function's call (unreached), so marked-ness alone would promote a binding a function body reads. Vetoing is the conservative side this analysis fails towards.
      if isDefaultGlobalRef(ai) {
        const gd = globalIndexOf(nd.identName)
        if gd >= 0 { gPromoOk[gd] = 0 }
      } else if marks[ai] == 0 {
        const gj = globalIndexOf(nd.identName)
        if gj >= 0 { gPromoOk[gj] = 0 }
      }
    }
    ai = ai + 1
  }
  // The surviving cells re-densify: a promoted binding emits none, so every cell below
  // a promoted one keeps its index and every cell above it drops by one. `userGlobalIdx`
  // is the single translation and reads this array.
  let cell = 0
  let di = 0
  while di < globalStmts.length {
    if gPromoOk[di] == 1 {
      gCellIdx[di] = -1
    } else {
      gCellIdx[di] = cell
      cell = cell + 1
    }
    di = di + 1
  }
  0
}

// Does the binding at `globalStmts` position `gi` have its initializer run by the start
// function? True for a non-constexpr init (zero-initialized in the cell, the start fn stores
// the real value) and for a promoted binding (no cell at all, so init becomes the `local.set`
// that gives the slot its value). `emitModule`'s `hasStart` count, `startFnDetectScratch`'s scan, `emitGlobalSection`'s cell arm, and `emitStartFnCode`'s merge loop must all agree on this.
export function globalRunsInStartFn(gi: i32) {
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 { return true }
  globalIsNonConst(globalStmts[gi])
}

// One scratch-detection sweep of user function `fnIx`'s body, at whatever same-named-slot bias
// `dupScanRun` has set. Split from the resets in `emitFuncCode` so it can be re-run per
// candidate binding of a shadowed name (D1595): every flag it touches is set and never cleared, and every list it appends to dedupes, so the passes OR.
function fnDetectScratch(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    // ONE body walk (`blockPushPopBits`) classifies every `.push`/Member-`.pop` receiver
    // once and yields all six kind flags together.
    applyPushPopBits(blockPushPopBits(fn.fnBody, fnIx))
    // The list-op scan leads because it also flips `fnUsesStrOp`, and every leg below it
    // asks a predicate whose only effect is a flag that is set and never cleared: a flag
    // already true has no second answer to give, so its walk is skipped. That is also what
    // keeps `dupScanRun`'s per-bias repeat to the facts a new bias can still change. D1595.
    leqScanBlock(fn.fnBody, fnIx)
    if !fnUsesStrOp {
      if fnHasStrOp(fnIx) { fnUsesStrOp = true }
    }
    if !fnUsesArrNew {
      if fnHasArrNew(fnIx) { fnUsesArrNew = true }
    }
    if !fnUsesCoalesceCall {
      if fnHasCoalesceCall(fnIx) { fnUsesCoalesceCall = true }
    }
    if !fnUsesMap {
      if fnHasMap(fnIx) { fnUsesMap = true }
    }
    // `fnHasMap` only scans locals/params; also reserve the frame when a map op runs
    // on a global struct-field map-array element (e.g. `T.scopes[top][k] = v`).
    if !fnUsesMap { fnUsesMap = fnHasGlobalMapOp(fnIx) }
    if fnValUsed {
      if !fnUsesCallRef {
        if blockHasCallRef(fn.fnBody, fnIx) { fnUsesCallRef = true }
      }
    }
    // A multi-field call result re-boxed into a variant-box union arm stashes the call
    // in the `variantReboxSlot` (a call cannot be re-read per field).
    if !fnUsesVariantRebox {
      if blockHasVariantRebox(fn.fnBody, fnIx) { fnUsesVariantRebox = true }
    }
    collectRefPushSlots(fn.fnBody, fnIx)
    // A Member-receiver ref-list `.pop` (`T.scopes.pop()`) needs the SAME typed scratch
    // frame as a ref `.push` onto that slot — record its slot too, so a pop-only function
    // reserves the frame whose `recvRef` holds the field's wrapper ref.
    collectMemberPopRefSlots(fn.fnBody, fnIx)
    mfScan(fn.fnBody, fnIx)
  }
  0
}

// Runs a frame's scratch detection until every same-named declared-local slot has had its
// turn — `fnIx < 0` sweeps the start function, otherwise that function's body. The detectors
// classify identifiers through `declaredSlotOf` with the scope stack empty, so a shadowed
// name is a guess by flat first-match scan; the sweep repeats at each bias while a same-named candidate of a different rep is unvisited (D1595) — over-reserving is safe, under-reserving is invalid wasm.
function dupScanRun(fnIx: i32) {
  dupScanActive = frameHasDupLocalName()
  dupSlotBias = 0
  dupSlotMore = false
  let again = true
  while again {
    if fnIx < 0 { startFnDetectScratch() } else { fnDetectScratch(fnIx) }
    again = false
    // The bias can only run past the match count, so `dupSlotMore` falls on its own;
    // `localNames.length` is the belt-and-braces bound (one pass per slot at most).
    if dupSlotMore && dupSlotBias + 1 < localNames.length {
      dupSlotBias = dupSlotBias + 1
      dupSlotMore = false
      again = true
    }
  }
  dupScanActive = false
  dupSlotBias = 0
  dupSlotMore = false
  // The second home, not a second slot: the sweep above covers the frame's same-named
  // slots, and a name a top-level block binds may also be a module global, which no slot
  // bias reaches. One more sweep with block-scoped slots hidden reserves the frames the
  // global's rep needs. D1597.
  if frameHasBlockLetOverGlobal() {
    blockLetHidden = true
    if fnIx < 0 { startFnDetectScratch() } else { fnDetectScratch(fnIx) }
    blockLetHidden = false
  }
  0
}

// Clears every start-function scratch flag, then detects the frames its body needs over the
// non-const global inits and the top-level statements — the start-fn analogue of
// `emitFuncCode`'s per-function detection. Sets the same `fnUses*` flags so the shared
// `fbBeginFunc`/`fbEmitLocalsVec` lay out an identical frame. `dupScanRun` may run the sweep (`startFnDetectScratch`) more than once, which is why the resets live here, above the loop.
function startFnDetectFrames() {
  fnUsesPush = false
  fnUsesRefPush = false
  fnUsesStrPush = false
  fnUsesNulStrPush = false
  fnUsesF64Push = false
  fnUsesF32Push = false
  fnUsesI64Push = false
  fnUsesAtomStage = false
  fnUsesStrOp = false
  fnUsesArrNew = false
  fnUsesCoalesceCall = false
  fnUsesMap = false
  fnUsesCallRef = false
  // The union-`as` box slot is module-wide (see `moduleHasUnionAs`), so the start fn and the
  // global initializers reserve it on the same condition every function body does.
  fnUsesUnionAs = moduleHasUnionAs()
  fnUsesNumCast = moduleHasNumCast()
  fnUsesVariantRebox = false
  fnRefPushSlots = []
  refPushBaseBySlot = []
  fnUsesMapFilter = false
  fnUsesMapKeys = false
  mfSrcKinds = []
  mfSrcSlots = []
  mfSrcBases = []
  mfDstKinds = []
  mfDstSlots = []
  mfDstBases = []
  // List `==`/`!=`/`+` frames (collections-design §VL.4/§VL.6) — non-const
  // global inits and every top-level statement run in the start function.
  fnUsesListEqI = false
  fnUsesListEqS = false
  fnListEqRSlots = []
  fnListCatKinds = []
  fnListCatSlots = []
  fnListEqGKinds = []
  fnListEqGSlots = []
  fnUsesCloEq = false
  dupScanRun(-1)
  0
}

// One scratch-detection sweep of the start function, at whatever same-named-slot bias
// `dupScanRun` has set. A `.push` is a statement-level void call, never in an init value
// position, so an init's push frames are driven by Member-receiver `.pop`s instead. Split from
// the resets in `startFnDetectFrames` so it can be re-run per candidate binding of a shadowed name (D1595).
function startFnDetectScratch() {
  let gi = 0
  while gi < globalStmts.length {
    // A PROMOTED binding's init runs here too (its `local.set` replaces the cell's
    // constexpr), so its scratch needs are detected on the same gate — else a const
    // init that needs a frame would reach the start fn with none reserved.
    if globalRunsInStartFn(gi) {
      const g = P.nodes[globalStmts[gi]]
      if g is LetDecl {
        const ix = g.letInit
        applyPushPopBits(exprPopBits(ix, -1))
        if exprHasStrOp(ix, -1) { fnUsesStrOp = true }
        // A `string` global initialized with a literal-union atom widens via the runtime tower
        // (`emitAtomToStr`), which stages the atom id in the string-op scratch frame.
        if globalInitWidensAtomToStr(globalStmts[gi]) { fnUsesStrOp = true }
        if exprHasArrNew(ix) { fnUsesArrNew = true }
        if exprHasCoalesceCall(ix) { fnUsesCoalesceCall = true }
        if exprHasMapOp(ix, -1) { fnUsesMap = true }
        if fnValUsed {
          if blockHasCallRef(ix, -1) { fnUsesCallRef = true }
        }
        collectMemberPopRefSlotsExpr(ix, -1)
        // A `.map`/`.filter` in a non-const global initializer (`const ys =
        // xs.map(...)`) runs in the start function — reserve its HOF frame here.
        mfScan(ix, -1)
      }
    }
    gi = gi + 1
  }
  // `.map`/`.filter` sites in top-level STATEMENTS (`print(e.map(...).length)`)
  // also run in the start function; `mfScan` recurses every statement shape itself.
  let mfi = 0
  while mfi < startStmts.length {
    mfScan(startStmts[mfi], -1)
    mfi = mfi + 1
  }
  // Top-level STATEMENTS may also need scratch (a `.push` / string op / map op in a
  // top-level `for`/`while`/`if` body or a bare call). Scan each through the same
  // walkers (which recurse into for/while/if bodies). `startScanBlock` runs every
  // block walker over one body; `startScanIf` descends an if/else-if chain.
  let si = 0
  while si < startStmts.length {
    const st = P.nodes[startStmts[si]]
    // The function-value call frame is detected over the whole statement, ahead of the shape split
    // below: `blockHasCallRef` recurses into an `if`/`while`/`for` body itself, whereas
    // `startScanBlock`/`startScanIf` run only the walkers that do not. A closure call nested in a
    // top-level block needs the frame exactly as a bare top-level call does.
    if fnValUsed {
      if blockHasCallRef(startStmts[si], -1) { fnUsesCallRef = true }
    }
    if st is ForRange {
      // The bounds are part of the start function's body — nothing scans them by default, so a
      // `for i in 0 to (g(2) ?? 0) { }` at module scope would emit `fbLocalSet(coalesceCallSlot)`
      // against a local the vector never declared. The in-function twins are covered
      // (`blockHasCoalesceCall`/`blockHasArrNew`/`blockHasMapOp`/`blockPushPopBits` all walk `frFrom`/`frTo`), which is why this needed its own scan.
      startScanHeaderExpr(st.frFrom)
      startScanHeaderExpr(st.frTo)
      startScanBlock(st.frBody)
    } else if st is ForIn {
      startScanBlock(st.fiBody)
      startScanHeaderExpr(st.fiIter)
      // A BARE map iterable (`for k in m` at module scope) — asked through the
      // emitter's own header predicate, exactly as `blockHasMapOp`'s ForIn arm
      // does for the in-function twin. `exprHasMapOp` claims only the
      // `m.keys()` / `m.values()` Call spellings.
      if forInMapRecv(st.fiIter, -1) >= 0 { fnUsesMap = true }
    } else if st is WhileStmt {
      // The condition, likewise: `startScanBlock` receives only the body.
      startScanHeaderExpr(st.whileCond)
      startScanBlock(st.whileBody)
    } else if st is IfStmt {
      startScanIf(startStmts[si])
    } else {
      // expression statements (a bare call / assignment): the per-statement push
      // detector plus the expr walkers
      applyPushPopBits(callPushBits(startStmts[si], -1))
      applyPushPopBits(exprPopBits(startStmts[si], -1))
      if exprHasStrOp(startStmts[si], -1) { fnUsesStrOp = true }
      if exprHasArrNew(startStmts[si]) { fnUsesArrNew = true }
      if exprHasCoalesceCall(startStmts[si]) { fnUsesCoalesceCall = true }
      if exprHasMapOp(startStmts[si], -1) { fnUsesMap = true }
      if callIsPushKind(startStmts[si], -1, "ref") {
        recordStartRefPushSlot(startStmts[si])
      }
      collectMemberPopRefSlotsExpr(startStmts[si], -1)
    }
    si = si + 1
  }
  // Variant-rebox stash for the start function: a multi-field CALL result re-boxed into a
  // variant-box union arm in a non-const global initializer or a top-level statement.
  // `blockHasVariantRebox` recurses into for/while/if bodies itself.
  let vrg = 0
  while vrg < globalStmts.length {
    if globalRunsInStartFn(vrg) {
      const vg = P.nodes[globalStmts[vrg]]
      if vg is LetDecl {
        if vg.letInit >= 0 {
          if blockHasVariantRebox(vg.letInit, -1) { fnUsesVariantRebox = true }
        }
      }
    }
    vrg = vrg + 1
  }
  let vrs = 0
  while vrs < startStmts.length {
    if blockHasVariantRebox(startStmts[vrs], -1) { fnUsesVariantRebox = true }
    vrs = vrs + 1
  }
  let lgi = 0
  while lgi < globalStmts.length {
    if globalRunsInStartFn(lgi) {
      const lg = P.nodes[globalStmts[lgi]]
      if lg is LetDecl { leqScanExpr(lg.letInit, -1) }
    }
    lgi = lgi + 1
  }
  let lsi = 0
  while lsi < startStmts.length {
    leqScanStmt(startStmts[lsi], -1)
    lsi = lsi + 1
  }
  0
}

// Collect the start function's DECLARED locals from the top-level statements: a
// `for` range loop's var+bound pair (and any `let`s nested in loop/if bodies, via
// the same collectLocals walkers user functions use, with the module-level
// `fnIx = -1`). Resets the local registry + scope stack like `buildLocals`.
function collectStartLocals() {
  localNames = []
  localIsRef = []
  localStructIdx = []
  localLoopVar = []
  localBlockLet = []
  localLoopIter = []
  localDeclIx = []
  localLitUnion = []
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  scopePush()
  let i = 0
  while i < startStmts.length {
    const s = P.nodes[startStmts[i]]
    if s is ForRange {
      const fvSlot = addLocalName(s.frVar, "i32", -1)
      markLoopVarSlot(fvSlot)
      scopeBind(s.frVar, fvSlot)
      addLocalName(s.frVar + "#b", "i32", -1)
      if collectLocals(s.frBody, -1) < 0 {
        scopePop()
        return -1
      }
      // The loop variable's scope is the loop (see `scopeUnbind`).
      scopeUnbind()
    } else if s is ForIn {
      // The loop-var / cursor / `#l`-temp declaration is `declareForInLocals` — SHARED with
      // the function-scope walk, because a top-level `for` and an in-function `for` need
      // identical slots (`fnIx` -1 is the only difference, and it is a parameter).
      if declareForInLocals(s, -1) < 0 {
        scopePop()
        return -1
      }
      if collectLocals(s.fiBody, -1) < 0 {
        scopePop()
        return -1
      }
      // The loop variable's scope is the loop (see `scopeUnbind`).
      scopeUnbind()
    } else if s is WhileStmt {
      if collectLocals(s.whileBody, -1) < 0 {
        scopePop()
        return -1
      }
    } else if s is IfStmt {
      if collectLocalsIf(startStmts[i], -1) < 0 {
        scopePop()
        return -1
      }
    }
    i = i + 1
  }
  scopePop()
  // The promoted top-level bindings (G2c) claim their slots last, after every local the
  // statement walk declared, so a program promoting nothing emits the frame it always did.
  // The slot registers under `<name>#g`, not the binding's own name — `#` cannot occur in a
  // source identifier, so nothing resolves to this slot by name; the only reader is `emitUserGlobalGet`/`emitUserGlobalSet` via `gPromoSlot`.
  let pgi = 0
  while pgi < globalStmts.length {
    if gPromoOk[pgi] == 1 {
      const pg = P.nodes[globalStmts[pgi]]
      if pg is LetDecl {
        // P2 restricted the cell to a plain numeric scalar, so `structIdx` is never
        // consulted and `fbLocalRun(ck, -1)` writes the same valtype byte the cell's
        // `fbValtypeNullable(ck, -1)` would have.
        gPromoSlot[pgi] = addLocalName(
          pg.letName + "#g",
          globalCellKind(globalStmts[pgi]),
          -1,
        )
      }
    }
    pgi = pgi + 1
  }
  localNames.length
}

// Emits the synthetic start function's size-prefixed code entry onto `out`. The body runs
// every non-const global initializer in declaration order, then `global.set gi`, so each cell
// holds its real value before any other code runs. Frames exactly as `emitFuncCode` does:
// collect locals, detect scratch frames, lay them out, emit the locals vector, then the body and `end`, size-prefixed.
function emitStartFnCode(out: i32[]) {
  // Locals first, detection second: the scratch detectors classify expressions through the
  // declared-locals registry, so it must be populated first — `declaredSlotOf` falls back to the
  // flat `localNames` scan when no scope frame is active. The start function is synthetic and has
  // no `FuncDecl` to anchor a failure at; -1 is the honest anchor for a failure with no owning declaration, and a node-anchored caller (`emitFailAt`) overrides it.
  emitCurFnIx = -1
  emitCurFnPos = -1
  // Where THIS body's span rows begin (D1594). The merge loop below banks one row per
  // top-level statement at `bodyExpr`-relative offsets; the tail rebases exactly this
  // suffix onto `out` once the locals vector and the size prefix are known.
  const spanBase = emitFnSpanStart.length
  const nStartLocals = collectStartLocals()
  if nStartLocals < 0 { return -1 }
  startFnDetectFrames()
  // The start function is void, so it has no union-box return to sink, and its top-level
  // bindings take neither sink; clear the flags the last user function left set, or
  // `fbBeginFunc`/`fbLocalsCount`/`fbEmitLocalsVec` would each reserve a frame for it.
  fnUsesUnionSink = false
  fnUsesUnionLetSink = false
  uSinkFired = 0
  fbBeginFunc(0, nStartLocals)

  const bodyExpr: i32[] = []
  const exprPrev = wTarget(bodyExpr)
  // Reset the emit-time scope/loop bookkeeping (the start fn has its own empty frame),
  // mirroring `emitFuncCode` — no leak from the last user function.
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  // One frame for the top-level statement list, as `collectStartLocals` pushes for the same
  // walk. A function body takes its frame from `emitStmts` on its `Block`; the top level
  // has no `Block`, so without this the lowering cannot be told from a scope-less detection
  // pass. Popped below; a `return -1` path leaves it, and the next program resets. D1597.
  scopePush()
  emitLetCursor = 0
  ctrlDepth = 0
  loopContDepth = []
  loopBrkDepth = []
  loopContLabel = []
  loopBrkLabel = []
  // Non-const global initializers and top-level statements run interleaved in source order
  // (merged on arena index, since top-level statements parse sequentially): `xs.push(1)` before
  // `const ys = xs.map(f)` must execute before that init. A program with only inits, or only
  // statements, emits the same bytes as before. The emit context is module-level (`fnIx = -1`): identifier reads/writes resolve to globals.
  let gi = 0
  let si = 0
  // Post-statement narrowing for the top-level statement list (the assignment
  // narrowing of `pushPostGuardNarrow` — a top-level guard `if` cannot
  // `return`, so only the assignment arm ever fires here). Restored at loop end.
  const savedStartNarrowTop = narrowTop
  // The promotion context window (G2c): a promoted binding's `local.get`/`local.set` is only
  // meaningful in this frame, so the flag that lets `emitUserGlobalGet`/`emitUserGlobalSet`
  // produce one is armed for exactly the span streaming this body. Every user function body and
  // every const cell's constexpr init has already run with the flag false, so a promoted binding reaching them is a loud reject rather than a wrong opcode.
  gPromoInStart = true
  while gi < globalStmts.length || si < startStmts.length {
    let takeGlobal = gi < globalStmts.length
    if takeGlobal && si < startStmts.length {
      if startStmts[si] < globalStmts[gi] { takeGlobal = false }
    }
    if takeGlobal {
      // ANCHOR any emit failure raised below at the top-level node being lowered (see
      // `emitCurStmtIx`) — the start function has no declaration of its own to name.
      emitCurStmtIx = globalStmts[gi]
      const gSpanAt = bodyExpr.length
      if globalRunsInStartFn(gi) {
        const g = P.nodes[globalStmts[gi]]
        if g is LetDecl {
          // Numeric WIDENING at the global-init boundary (a non-const `: f64`/`: f32`/`: i64`
          // global whose init is a narrower numeric — e.g. `const b: f64 = a` with `a: i32`):
          // the `emitExprAs*` helper inserts the lattice convert so the start-fn `global.set`
          // matches the cell valtype. An i32 cell is untouched. (Slice 5 widening.)
          const gck = globalCellKind(globalStmts[gi])
          if gck == "f32" {
            const savedF32 = pendingF32
            pendingF32 = true
            if emitExprAsF32(bodyExpr, g.letInit, -1) < 0 {
              wTarget(exprPrev)
              return -1
            }
            pendingF32 = savedF32
          } else if gck == "f64" {
            if emitExprAsF64(bodyExpr, g.letInit, -1) < 0 {
              wTarget(exprPrev)
              return -1
            }
          } else if gck == "i64" {
            if emitExprAsI64(bodyExpr, g.letInit, -1) < 0 {
              wTarget(exprPrev)
              return -1
            }
          } else {
            // A map global's start-fn init seeds the map SHAPE (mirrors the
            // local-`let` seeding) so `Map()` builds THIS global's map struct.
            if gck == "map" {
              pendingMapSlot = letMapShapeOf(globalStmts[gi], -1)
            }
            // A NULLABLE map global's start-fn init: seed the map SHAPE (`Map()` builds it) and
            // the null heap (a bare `null` init lowers as `ref.null $mapStruct`).
            if gck == "nulmap" {
              const gnmShape = nulMapShapeOf(globalStmts[gi], -1)
              pendingMapSlot = gnmShape
              pendingNulRefHeap = mapTypeIdxOf(gnmShape)
            }
            // A struct / nullable-struct cell seeds the struct context so a bare
            // `null` init lowers as `ref.null $S` and a literal builds THIS
            // global's annotated struct (mirrors the const-path seeding).
            if gck == "struct" || gck == "nulstruct" {
              pendingStructIdx = globalCellStructIdx(globalStmts[gi])
            }
            // The kind-8 variant twin of that seed, for the non-const init path (a variant global whose
            // initializer is a call, another global, or any other non-constexpr): the literal — or the
            // value the start fn stores — builds the bare variant struct the cell is declared with.
            if gck == "nulvariant" {
              // The promoted-binding mirror of the cell path's nullable-variant seed: a top-level
              // `const c: Circle | null` that becomes a start-function local still needs the variant
              // context, so an object-literal init builds `uVarHeap[vi]` and a bare `null` init lowers as that variant's own typed null.
              const gnvi = globalCellStructIdx(globalStmts[gi])
              pendingVariantIdx = gnvi
              if gnvi >= 0 && gnvi < uVarHeap.length {
                pendingNulRefHeap = uVarHeap[gnvi]
              }
            }
            if gck == "variant" {
              pendingVariantIdx = globalCellStructIdx(globalStmts[gi])
            }
            // A `boolean|null` NICHE global lowers a bare `null` init as the sentinel 2;
            // a `string|null` global lowers it as `ref.null $sTypeIdx` (kind 16).
            pendingNulBool = letIsNulBoolAnn(globalStmts[gi])
            pendingNulString = letIsNulString(globalStmts[gi], -1)
            // D1576 — a `nulnone` cell (a never-filled module-scope `const x = null`) lowers
            // its init as `ref.null none`, the one value it can hold. This block, not the
            // constexpr arm in `emitGlobalSection`, is where every `= null` global's null rep
            // is decided (a bare `null` is not a WasmGC constexpr).
            pendingNulNone = gck == "nulnone"
            if letIsLitUnion(globalStmts[gi]) { pendingLitUnion = 1 }
            // A `K | null` NICHE global's start-fn init: a member literal lowers as
            // its atom id, a bare `null` as the `-1` sentinel — the start-fn twin of
            // the const-path seeding (a `null` init routes here; un-seeded it drew
            // the "bare null needs a struct-typed context" loud reject).
            if g.letType >= 0 {
              if nodeTyIsNulLitUnion(g.letType) {
                pendingLitUnion = 1
                pendingNulLitUnion = true
              }
            }
            // A list-annotated global seeds the element kind/slot so its literal init builds the
            // annotation's backing+wrapper, exactly as the const-path and the local-`let` path seed it (a
            // no-op for a non-list annotation). Needed because a closure-array's function-ident elements
            // aren't an objlit and a scalar `f64[]`/`i64[]`/`f32[]` literal of bare int elements doesn't self-identify; an un-annotated global takes its destination's kind instead (D381).
            const gLb = letListBuild(globalStmts[gi], -1)
            pendingListKind = gLb.lbKind
            pendingListSlot = gLb.lbSlot
            // The three nullable-list cell seeds. A bare `null` is never a WasmGC constexpr, so every
            // `= null` global routes here — this block, not the global section's constexpr arm, is the one
            // place a global cell's null rep is decided. Each mirrors `emitLetDeclStmt`'s local kind ladder
            // exactly, so a `const g: i32[] | null = null` gets the same seeding a local would. Kind 15, the i32-backed `i32[] | null`: `ref.null $lTypeIdx`.
            const savedSNL = pendingNulList
            const savedSNC = pendingNulClosure
            // The kind-driven half of the seeding, shared with the local-`let` and `global.set`
            // boundaries: the nullable-list and nullable-closure null reps, and the
            // distinct-backing scalar lists' leaf build code. Applied over the ambient seeds, so
            // the list seeds above stand for every kind the resolver answers inert for.
            expCtxApply(expCtxForCell(gck))
            // Kind 18, a nullable ref array (`i32[][] | null`, `S[] | null`): the null is this global's
            // element wrapper (`rlWrapIdx[slot]`), the same slot the cell's valtype selects. Armed only
            // when the initializer is a bare `null` (the seed-leak gate the local ladder and the
            // call-argument boundary both spell): a list-literal init whose element is null must lower that element as `ref.null $S`, and an un-gated seed would retype it to the wrapper instead.
            if gck == "nulreflist" {
              if pendingListSlot >= 0 && pendingListSlot < rlWrapIdx.length {
                const gnraInit = P.nodes[unwrapParen(g.letInit)]
                if gnraInit is NullLit {
                  pendingNulRefHeap = rlWrapIdx[pendingListSlot]
                }
              }
            }
            // A union cell (kind 4) coerces a raw init value into the box (`let w: string | i32 = n`
            // boxes the i32 read); a union-valued init passes through unchanged. The box-typed
            // position: a union global's cell is always the box (unlike `buildLocals`), so a
            // concrete-variant init must be boxed exactly as a call argument, return, or array element is, or a plain coerce would store the wrong ref into the box cell.
            let gun = ""
            if gck == "union" { gun = letUnionNameOf(globalStmts[gi], -1) }
            // A module-level `let f = add` aliasing a GENERIC (un-annotated-param) named
            // function, used only as a direct-call callee: the closure through the floor-LESS
            // core, the start-fn twin of the const-cell arm in `emitGlobalSection`.
            const gAliasFe = monoGenericAliasFe(globalStmts[gi])
            // The module-scope twin of `emitLetDeclStmt`'s union-box map-read arm. A bare top-level
            // `const t = m[k]` over a union-valued map must lower its miss as the null-tagged box,
            // because the consuming `!= null`/`is`/`match`/`??` is a tag compare that recovers the box
            // with `ref.as_non_null` first. Without this arm the init falls through to `emitMapGet`'s bare `ref.null` miss — check-clean, then a runtime `null reference` trap.
            const gUmr = letNulMapReadUnionBox(globalStmts[gi], -1)
            if gUmr {
              const gumrN = P.nodes[unwrapParen(g.letInit)]
              if gumrN is Index {
                if (
                  emitMapGetUnionBox(bodyExpr, gumrN.idxArr, gumrN.idxIndex, -1) <
                  0
                ) {
                  wTarget(exprPrev)
                  return -1
                }
              } else {
                wTarget(exprPrev)
                return emitFail(
                  "emitProgram: union-valued map read binding's init is not an index read",
                )
              }
            } else if gun != "" {
              if emitUnionBoxArg(bodyExpr, gun, g.letInit, -1) < 0 {
                wTarget(exprPrev)
                return -1
              }
            } else if gAliasFe >= 0 {
              if emitClosureValueCore(bodyExpr, gAliasFe, -1) < 0 {
                wTarget(exprPrev)
                return -1
              }
            } else if (
              (gck == "str" || gck == "nulstr") &&
              globalInitIsLitAtom(g.letInit)
            ) {
              // A literal-union atom initializing a `string` global widens to its member string.
              // The start fn is a real function, so the runtime widening tower runs here (unlike a
              // CONST global, whose constexpr init has no `select`/scratch).
              if emitAtomToStr(bodyExpr, g.letInit, -1) < 0 {
                wTarget(exprPrev)
                return -1
              }
            } else {
              if emitExpr(bodyExpr, g.letInit, -1) < 0 {
                wTarget(exprPrev)
                return -1
              }
            }
            pendingNulBool = false
            pendingNulString = false
            pendingNulNone = false
            pendingNulClosure = savedSNC
            pendingNulList = savedSNL
            pendingMapSlot = -1
            pendingStructIdx = -1
            // The variant twin of that reset — the rung this ladder lacked (D1563). `emitNullLitNode`
            // reads `pendingVariantIdx` before `pendingStructIdx` and persistently (not consumed on use),
            // so a `T | null` cell whose `T` is a union arm left the seed armed and the next global's bare
            // `null` lowered as `ref.null $T` into the wrong cell — check-clean invalid wasm.
            pendingVariantIdx = -1
            pendingListKind = 0
            pendingListSlot = 0
            pendingLitUnion = 0
            pendingNulLitUnion = false
            // The ref-heap seed is consumed-and-cleared by `emitNullLitNode`, but a
            // NON-null init leaves it armed — so clear it here too, else the next
            // global's bare `null` would take THIS global's wrapper. (The `nulmap` arm
            // above has always seeded it; the two list arms added here do too.)
            pendingNulRefHeap = -1
            // Read-only covariance at the module-global binding (D822) — the eighth delivery form,
            // absent from `letRefListDestSlot`'s list of seven because a global is not a `let`. A const
            // global's init is a wasm constexpr and cannot carry a loop, so the widening copy can only go
            // here — which is where a global reading another global always runs anyway (`globalIsNonConst`).
            if gck == "reflist" {
              emitRefListWidenSite(
                bodyExpr,
                g.letInit,
                exprEmittedRefListSlot(g.letInit, -1),
                globalRefListSlot(globalStmts[gi]),
              )
            }
            // The scalar dual (D965), and the same argument for it living here: a const global's init is
            // a wasm constexpr and cannot carry a loop, so the copy can only go in the non-const init body — which is where a global reading another global always runs.
            emitScalarListWidenSite(bodyExpr, g.letInit, -1, gck)
          }
          const setPrev = wTarget(bodyExpr)
          if emitUserGlobalSet(gi) < 0 {
            wTarget(setPrev)
            wTarget(exprPrev)
            return -1
          }
          wTarget(setPrev)
        }
      }
      // The row the D1594 diagnostic reads: this initializer's own byte range, so an
      // offset inside it names the `const`/`let` rather than the whole start function.
      // A global whose init did not run here contributes no bytes and no row.
      if bodyExpr.length > gSpanAt {
        bankFnSpan(globalStmts[gi], -1, gSpanAt, bodyExpr.length, 1, "")
      }
      gi = gi + 1
    } else {
      emitCurStmtIx = startStmts[si]
      const sSpanAt = bodyExpr.length
      if emitStmt(bodyExpr, startStmts[si], -1) < 0 {
        wTarget(exprPrev)
        return -1
      }
      pushPostGuardNarrow(startStmts[si], -1)
      if bodyExpr.length > sSpanAt {
        bankFnSpan(startStmts[si], -1, sSpanAt, bodyExpr.length, 1, "")
      }
      si = si + 1
    }
  }
  scopePop()
  // The cursor is armed for exactly the span that streams this body; the `return -1` paths
  // above leave it set, which is what carries the anchor out to the diagnostic.
  emitCurStmtIx = -1
  // Close the promotion window. The `return -1` paths above leave it armed, which is
  // inert: a failed body aborts the whole module emit, and `computeGlobalPromotion`
  // clears the flag at the top of the next one.
  gPromoInStart = false
  restoreNarrow(savedStartNarrowTop)
  wTarget(exprPrev)

  const body: i32[] = []
  // Locals vector: the start fn's declared locals (for-loop vars), then the scratch frames.
  if fbEmitLocalsVec(body, nStartLocals) < 0 { return -1 }
  // Where `bodyExpr` lands INSIDE the body — everything before it is the locals vector.
  const exprInBody = body.length
  appendAll(body, bodyExpr)
  const endPrev = wTarget(body)
  fbEnd() // 0x0b end (void → void: stack already empty)
  wTarget(endPrev)

  const outPrev = wTarget(out)
  wULEB(body.length)
  // REBASE this body's statement rows off `bodyExpr` and onto the code payload (D1594):
  // the size prefix is written, so `out.length` is where the body itself begins. The
  // caller rebases the payload onto the module once `wSection` places it, exactly as it
  // does for a user function's row.
  const bodyInOut = out.length
  let ssp = spanBase
  while ssp < emitFnSpanStart.length {
    emitFnSpanStart[ssp] = emitFnSpanStart[ssp] + bodyInOut + exprInBody
    emitFnSpanEnd[ssp] = emitFnSpanEnd[ssp] + bodyInOut + exprInBody
    ssp = ssp + 1
  }
  wBytes(body)
  wTarget(outPrev)
  0
}

// The synthetic `__log__(offset, length)` decoder body: walks the tag/value pairs in linear
// memory (two words per pair) and prints each value, mirroring the host runner's `__log__`
// import. Tag 0 is a plain i32; a non-zero tag traps (`unreachable`) since no corpus program
// logs one natively and a silent wrong decode is worse. The host joins a multi-pair log into one line, this prints one per pair — harmless, since every corpus call logs exactly one.
function emitMemLogFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  // Locals vector: params occupy 0 (offset) and 1 (length); local 2 is the cursor.
  wULEB(1)      // 1 locals run
  wULEB(1)      // count 1
  wU8(127)      // 0x7f i32
  fbLocalGet(0)
  fbLocalSet(2) // cursor = offset
  fbBlock(64)   // block (void)
  fbLoop(64)    // loop (void)
  fbLocalGet(2)
  fbLocalGet(0)
  fbLocalGet(1)
  fbI32Bin(106) // 0x6a i32.add — offset + length (the end)
  fbI32Bin(78)  // 0x4e i32.ge_s — cursor >= end?
  fbBrIf(1)     // exit the block
  fbLocalGet(2)
  fbI32Load()   // the pair's TAG
  fbIf(64)      // tag != 0 → unsupported payload kind
  fbUnreachable()
  fbEnd()
  fbLocalGet(2)
  fbI32Const(4)
  fbI32Bin(106) // i32.add — the value word
  fbI32Load()
  fbCall(0)     // __print_i32__ (import 0)
  fbLocalGet(2)
  fbI32Const(8)
  fbI32Bin(106) // i32.add
  fbLocalSet(2) // cursor += 8
  fbBr(0)       // next pair
  fbEnd()       // end loop
  fbEnd()       // end block
  fbEnd()       // 0x0b end (void function: stack empty)
  wTarget(prev)
  const outPrev = wTarget(out)
  wULEB(body.length)
  wBytes(body)
  wTarget(outPrev)
  0
}

// ── shared runtime helper bodies (module-tail functions) ──
// Each body below is the once-per-module copy of machinery every lowering site otherwise
// inlines. Hand-rolled like the `__log__` decoder above: a locals vector, then straight `fb*`
// opcodes against wasm param/local indices (no scratch-frame indirection — params are the frame).

// Frame a finished helper body (locals vec + code already in `body`) onto `out`.
function helpFrameBody(out: i32[], body: i32[]) {
  const outPrev = wTarget(out)
  wULEB(body.length)
  wBytes(body)
  wTarget(outPrev)
  0
}

// One `h = (h ^ back[i + k]) * 16777619` step of the FNV chain, against the `__str_hash__`
// frame (back = local 5, h = local 1, i = local 2). `k == 0` skips the offset add. Shared by
// the unrolled block and the remainder loop so the two cannot drift into hashing differently.
// `i` is a backing offset, not a view offset: the prologue seeds it from the header's `start` and bounds it at `start + len`.
function fbStrHashStep(k: i32) {
  fbLocalGet(1)
  fbLocalGet(5)
  fbLocalGet(2)
  if k != 0 {
    fbI32Const(k)
    fbI32Bin(106) // i32.add (i + k)
  }
  fbArrayGet(sBackIdx)
  fbI32Bin(115) // 0x73 i32.xor
  fbI32Const(16777619)
  fbI32Bin(108) // 0x6c i32.mul
  fbLocalSet(1)
  0
}

// `__str_hash__(s) -> i32`: the masked non-negative FNV-1a hash of a string. Params: s(0).
// Locals: h(1), i(2), n(3), lim(4), back(5). Memoised in the header's mutable `$hash` field
// (field 3) — sound because the hash is a pure function of the three immutable header
// fields, so one mutable field in an immutable string is a memo, not state; `0` means "not computed yet", so a string whose hash is genuinely 0 re-walks.
function emitStrHashFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(2)     // 2 locals runs
  wULEB(4)     // count 4
  wU8(127)     // 0x7f i32 (h, i, n, lim)
  wULEB(1)     // count 1
  wU8(99)      // 0x63 (ref null ht) — the hoisted backing
  wSLEB(sBackIdx)
  fbBlock(127) // block i32 — yields the hash, cached or freshly walked
  // Memo hit: `h = s.hash ; if h != 0 { yield h }`. Two instructions and a branch on the path
  // that matters — the compiler hashes the same immutable key object (a pooled literal, a token's text, an interned name) over and over.
  fbLocalGet(0)
  fbStrHash()
  fbLocalTee(1)           // h = s.hash
  fbIf(64)                // if h != 0, void
  fbLocalGet(1)
  fbBr(1)                 // → out of the i32 block with the cached hash
  fbEnd()
  fbI32Const(-2128831035) // 2166136261 as signed (the FNV offset basis)
  fbLocalSet(1)           // h
  // Hoist the header ONCE: backing into local 5, the cursor seeded to `start`, the bound to
  // `start + len`. Every element step below then costs one `array.get` and no `struct.get`.
  fbLocalGet(0)
  fbStrBack()
  fbLocalSet(5) // back = s.backing
  fbLocalGet(0)
  fbStrStart()
  fbLocalSet(2) // i = s.start
  fbLocalGet(2)
  fbLocalGet(0)
  fbStrLen()
  fbI32Bin(106) // i32.add
  fbLocalSet(3) // n = s.start + s.len  (one past the last offset)
  fbLocalGet(3)
  fbI32Const(4)
  fbI32Bin(107) // i32.sub
  fbLocalSet(4) // lim = n - 4
  // Wide block: while i <= lim { 4 chained steps ; i += 4 }
  fbLoop(64)    // loop, void
  fbLocalGet(2) // i
  fbLocalGet(4) // lim
  fbI32Bin(74)  // 0x4a i32.gt_s (i > lim → no full block fits)
  fbIf(64)      // then: done (empty)
  fbElse()
  fbStrHashStep(0)
  fbStrHashStep(1)
  fbStrHashStep(2)
  fbStrHashStep(3)
  fbLocalGet(2)
  fbI32Const(4)
  fbI32Bin(106) // i32.add
  fbLocalSet(2) // i += 4
  fbBr(1)       // → loop header
  fbEnd()       // end (gt_s if)
  fbEnd()       // end (wide loop)
  // Remainder: while i < n { one step ; i += 1 }
  fbLoop(64)    // loop, void
  fbLocalGet(2) // i
  fbLocalGet(3) // n
  fbI32Bin(78)  // 0x4e i32.ge_s (i >= n → done)
  fbIf(64)      // then: done (empty)
  fbElse()
  fbStrHashStep(0)
  fbLocalGet(2)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(2)
  fbBr(1)       // → loop header
  fbEnd()       // end (ge_s if)
  fbEnd()       // end (remainder loop)
  // h & 0x7fffffff — force non-negative (the result), then MEMOISE it. The store is the
  // only write anyone ever makes to field 3 and it stores exactly what this walk computed,
  // so a second caller either reads this value or recomputes the identical one.
  fbLocalGet(1)
  fbI32Const(2147483647)
  fbI32Bin(113)  // 0x71 i32.and
  fbLocalSet(1)  // h = the masked result
  fbLocalGet(0)
  fbLocalGet(1)
  fbStrSetHash() // s.hash = h  — 0 stays 0 and simply re-walks next time (see the header)
  fbLocalGet(1)
  fbEnd()        // end (block) — leaves the i32 result
  fbEnd()        // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_eq__(a, b) -> i32`: element-wise string value-equality — 0 if the lengths differ or
// any code point differs, else 1. Params: a(0), b(1). Locals: n(2), i(3), lim(4). Unrolled
// eight wide over an xor/or accumulator; `lim = n - 8` is a subtraction so a maximal-length
// string cannot overflow the gate. Identity fast path (`ref.eq`): the literal pool interns every distinct literal as one module global, so a pooled compare is reference-identical.
function fbStrEqReadA(k: i32) {
  fbLocalGet(5) // aBack
  fbLocalGet(3) // i
  if k > 0 {
    fbI32Const(k)
    fbI32Bin(106) // i32.add
  }
  fbArrayGet(sBackIdx)
  0
}
function fbStrEqReadB(k: i32) {
  fbLocalGet(6) // bBack
  fbLocalGet(3) // i
  fbLocalGet(7) // d = b.start - a.start
  fbI32Bin(106) // i32.add
  if k > 0 {
    fbI32Const(k)
    fbI32Bin(106) // i32.add
  }
  fbArrayGet(sBackIdx)
  0
}

function emitStrEqFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(3)     // 3 locals runs
  wULEB(3)     // count 3
  wU8(127)     // 0x7f i32 (n, i, lim)
  wULEB(2)     // count 2
  wU8(99)      // 0x63 (ref null ht) — the two hoisted backings
  wSLEB(sBackIdx)
  wULEB(1)     // count 1
  wU8(127)     // 0x7f i32 (d — b's start relative to a's)
  fbBlock(127) // block i32 — yields the 0/1 result
  // `if ref.eq(a, b) { 1 ; br out }`. The operands are headers now, so `ref.eq` compares views,
  // not element arrays — still a pure short-circuit (a header trivially equals itself, and it
  // still fires on the literal pool), but it stops covering two distinct headers over the same
  // backing and range, which now walk instead. That is a lost optimisation, never a wrong answer.
  fbLocalGet(0)
  fbLocalGet(1)
  wU8(211) // 0xd3 ref.eq
  fbIf(64) // if, void
  fbI32Const(1)
  fbBr(1)  // → out of the i32 block
  fbEnd()
  // if a.len != b.len { 0 ; br out }
  fbLocalGet(0)
  fbStrLen()
  fbLocalGet(1)
  fbStrLen()
  fbI32Bin(71) // 0x47 i32.ne
  fbIf(64)     // if, void
  fbI32Const(0)
  fbBr(1)      // → out of the i32 block
  fbEnd()
  // Hoist BOTH headers once. The cursor `i` walks A's BACKING coordinates, so an A read is
  // `aBack[i]` with no bias at all and a B read is `bBack[i + d]` for the one-time
  // `d = b.start - a.start`. `n` is A's END offset (`a.start + a.len`).
  fbLocalGet(0)
  fbStrBack()
  fbLocalSet(5) // aBack
  fbLocalGet(1)
  fbStrBack()
  fbLocalSet(6) // bBack
  fbLocalGet(0)
  fbStrStart()
  fbLocalSet(3) // i = a.start
  fbLocalGet(3)
  fbLocalGet(0)
  fbStrLen()
  fbI32Bin(106) // i32.add
  fbLocalSet(2) // n = a.start + a.len
  fbLocalGet(1)
  fbStrStart()
  fbLocalGet(3)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(7) // d = b.start - a.start
  // lim = n - 8 — the last cursor at which a full eight-element block fits. A SUBTRACTION
  // rather than `i + 8 > n`: `n` is bounded by the backing's length and cannot overflow it,
  // while `i + 8` on a maximal-length string could.
  fbLocalGet(2)
  fbI32Const(8)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(4)
  // Short-string gate: skip the wide loop entirely unless a full block can run at least once.
  // Strings shorter than the unroll factor are the common case (identifiers, keywords, tags),
  // and for them the whole wide region is dead weight. The test is `lim >= i` rather than `n >=
  // 8`, because `i` no longer starts at 0 — a view starts at its own `start`, and `n >= 8` would ask about the parent's extent instead of this view's length.
  fbLocalGet(4)
  fbLocalGet(3)
  fbI32Bin(78) // 0x4e i32.ge_s (lim >= i → at least one full block fits)
  fbIf(64)     // if, void
  fbLoop(64)   // loop (eight wide), void
  fbLocalGet(3)
  fbLocalGet(4)
  fbI32Bin(74) // 0x4a i32.gt_s (i > lim → no full block left)
  fbIf(64)     // then: done (empty)
  fbElse()
  // acc = (a[i]^b[i]) | (a[i+1]^b[i+1]) | ... | (a[i+7]^b[i+7]), on the stack.
  let k = 0
  while k < 8 {
    fbStrEqReadA(k)
    fbStrEqReadB(k)
    fbI32Bin(115) // 0x73 i32.xor — 0 exactly when the pair matches
    if k > 0 {
      fbI32Bin(114) // 0x72 i32.or — fold into the accumulator
    }
    k = k + 1
  }
  // A non-zero accumulator means at least one of the eight pairs differed.
  fbIf(64)
  fbI32Const(0)
  fbBr(4) // → out of: if(0)·else(1)·loop(2)·n>=8 if(3)·block(4)
  fbEnd()
  // i = i + 8
  fbLocalGet(3)
  fbI32Const(8)
  fbI32Bin(106)
  fbLocalSet(3)
  fbBr(1) // → loop header
  fbEnd() // end (gt_s if/else)
  fbEnd() // end (eight-wide loop)
  fbEnd() // end (n >= 8 if)
  // Scalar remainder: the fewer than eight elements the wide loop could not cover.
  fbLoop(64)   // loop, void
  fbLocalGet(3)
  fbLocalGet(2)
  fbI32Bin(78) // i32.ge_s (i >= n → done)
  fbIf(64)     // then: done (empty)
  fbElse()
  // if a[i] != b[i] { 0 ; br out }
  fbStrEqReadA(0)
  fbStrEqReadB(0)
  fbI32Bin(71) // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(3)      // → out of: if(0)·else(1)·loop(2)·block(3)
  fbEnd()
  // i = i + 1
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(3)
  fbBr(1)       // → loop header
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  fbI32Const(1) // every element matched
  fbEnd()       // end (block)
  fbEnd()       // end (function) — leaves the 0/1 result
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_concat__(a, b) -> (ref str)`: allocates a fresh `lenA + lenB` backing, `array.copy`s
// both operands' live ranges in, and wraps a whole-backing header around it. Params: a(0),
// b(1). Locals: lenA(2), lenB(3) i32; out(4) a non-null `(ref $sBackIdx)`. Concat is the one
// string op a view cannot make cheaper, but each `array.copy` reads from its operand's `start`, not from 0, so a view operand does not concatenate its parent's leading characters.
function emitStrConcatFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(2) // 2 locals runs
  wULEB(2) // count 2
  wU8(127) // 0x7f i32 (lenA, lenB)
  wULEB(1) // count 1
  wU8(100) // 0x64 (ref $sBackIdx) — out
  wSLEB(sBackIdx)
  // lenA = a.len ; lenB = b.len
  fbLocalGet(0)
  fbStrLen()
  fbLocalSet(2)
  fbLocalGet(1)
  fbStrLen()
  fbLocalSet(3)
  // out = array.new_default $sBackIdx (lenA + lenB)
  fbLocalGet(2)
  fbLocalGet(3)
  fbI32Bin(106) // i32.add
  fbArrayNewDefault(sBackIdx)
  fbLocalSet(4)
  // array.copy out 0 a.backing a.start lenA
  fbLocalGet(4)
  fbI32Const(0)
  fbLocalGet(0)
  fbStrBack()
  fbLocalGet(0)
  fbStrStart()
  fbLocalGet(2)
  fbArrayCopy(sBackIdx, sBackIdx)
  // array.copy out lenA b.backing b.start lenB
  fbLocalGet(4)
  fbLocalGet(2)
  fbLocalGet(1)
  fbStrBack()
  fbLocalGet(1)
  fbStrStart()
  fbLocalGet(3)
  fbArrayCopy(sBackIdx, sBackIdx)
  // The header over the exact-fit backing.
  fbLocalGet(4)
  fbI32Const(0)
  fbLocalGet(2)
  fbLocalGet(3)
  fbI32Bin(106) // i32.add
  fbStrNew()
  fbEnd() // end (function) — leaves the fresh string ref
  wTarget(prev)
  helpFrameBody(out, body)
}

// ── the UTF-8 codec helpers ──
// Three module-tail functions, minted from `aUsed` alongside the string trio above: the codec
// is a loop with a variable stride, the one shape a lowering cannot inline at every use site.
// One copy each: `for cp in s`/`s.cpAt(i)` share `__utf8_dec__`; `fromCodePoint`/`fromCodePoints` share `__utf8_enc__`, which has a fourth twin in VL — `emit_base.cpsToUtf8` — that must agree with it exactly or `"é" == fromCodePoint(233)` goes false.

// Replaces the code point in local `cpL` with U+FFFD when it has no UTF-8 encoding — outside
// [0, 0x10FFFF], or inside the UTF-16 surrogate range D800..DFFF. Emitted into both of
// `__utf8_enc__`'s passes (width and write), since sanitizing changes the width and a width pass that disagreed with the write pass would size the backing wrong.
function fbUtf8Sanitize(cpL: i32) {
  fbLocalGet(cpL)
  fbI32Const(0)
  fbI32Bin(72)      // 0x48 i32.lt_s
  fbLocalGet(cpL)
  fbI32Const(1114111)
  fbI32Bin(74)      // 0x4a i32.gt_s
  fbI32Bin(114)     // 0x72 i32.or
  fbLocalGet(cpL)
  fbI32Const(55296)
  fbI32Bin(78)      // 0x4e i32.ge_s
  fbLocalGet(cpL)
  fbI32Const(57343)
  fbI32Bin(76)      // 0x4c i32.le_s
  fbI32Bin(113)     // 0x71 i32.and
  fbI32Bin(114)     // 0x72 i32.or
  fbIf(64)
  fbI32Const(65533) // U+FFFD
  fbLocalSet(cpL)
  fbEnd()
  0
}

// `(1 << 24) | 0xFFFD` — the decoder's "consume ONE byte, yield the replacement character"
// answer, and the only answer it gives for a byte that begins nothing. Consuming exactly one
// byte is what makes `for cp in s` terminate on arbitrary bytes: a width of 0 would spin.
function fbUtf8DecBad() {
  fbI32Const(16842749) // (1 << 24) | 65533 — width 1, U+FFFD
  fbReturn()
  0
}

// `__utf8_dec__(back, i, end) -> i32` — decodes the UTF-8 sequence beginning at backing offset
// `i`, never reading at or past `end`. Returns `(width << 24) | codepoint`, so one call answers
// both questions a decoding cursor has; `width` is always >= 1. A malformed sequence — a stray
// continuation byte, an invalid lead, a truncated tail, an overlong form, a surrogate, or a value past U+10FFFF — decodes to U+FFFD rather than trapping (Go-lean).
function emitUtf8DecFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(1) // 1 locals run
  wULEB(6) // b, n, cp, k, c, lo
  wU8(127) // 0x7f i32
  // b = back[i]  (array.get_u — the backing is packed i8, so this zero-extends to 0..255)
  fbLocalGet(0)
  fbLocalGet(1)
  fbArrayGet(sBackIdx)
  fbLocalSet(3)
  // ASCII: one byte, the code point IS the byte.
  fbLocalGet(3)
  fbI32Const(128)
  fbI32Bin(72)         // i32.lt_s
  fbIf(64)
  fbI32Const(16777216) // 1 << 24
  fbLocalGet(3)
  fbI32Bin(114)        // i32.or
  fbReturn()
  fbEnd()
  // A lead byte below 0xC2 is a continuation byte or a 2-byte overlong — neither begins a
  // sequence.
  fbLocalGet(3)
  fbI32Const(194)
  fbI32Bin(72) // i32.lt_s
  fbIf(64)
  fbUtf8DecBad()
  fbEnd()
  // n = 2 / 3 / 4 by lead-byte range; 0xF5 and up is not a lead byte at all.
  fbI32Const(2)
  fbLocalSet(4)
  fbLocalGet(3)
  fbI32Const(224)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbI32Const(3)
  fbLocalSet(4)
  fbLocalGet(3)
  fbI32Const(240)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbI32Const(4)
  fbLocalSet(4)
  fbLocalGet(3)
  fbI32Const(245)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbUtf8DecBad()
  fbEnd()
  fbEnd()
  fbEnd()
  // A sequence that runs past `end` is truncated — the slice-off-a-boundary case the API
  // deliberately permits, so it is lenient rather than a trap.
  fbLocalGet(1)
  fbLocalGet(4)
  fbI32Bin(106) // i32.add
  fbLocalGet(2)
  fbI32Bin(74)  // i32.gt_s
  fbIf(64)
  fbUtf8DecBad()
  fbEnd()
  // cp = b & (0x7f >> n) — 0x1f / 0x0f / 0x07 for n = 2 / 3 / 4.
  fbLocalGet(3)
  fbI32Const(127)
  fbLocalGet(4)
  fbI32Bin(118) // 0x76 i32.shr_u
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(5)
  // for k in 1..n { c = back[i + k]; require 10xxxxxx; cp = (cp << 6) | (c & 0x3f) }
  fbI32Const(1)
  fbLocalSet(6)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(6)
  fbLocalGet(4)
  fbI32Bin(78)  // i32.ge_s
  fbBrIf(1)
  fbLocalGet(0)
  fbLocalGet(1)
  fbLocalGet(6)
  fbI32Bin(106) // i32.add
  fbArrayGet(sBackIdx)
  fbLocalSet(7)
  fbLocalGet(7)
  fbI32Const(192)
  fbI32Bin(113) // i32.and
  fbI32Const(128)
  fbI32Bin(71)  // 0x47 i32.ne
  fbIf(64)
  fbUtf8DecBad()
  fbEnd()
  fbLocalGet(5)
  fbI32Const(6)
  fbI32Bin(116) // 0x74 i32.shl
  fbLocalGet(7)
  fbI32Const(63)
  fbI32Bin(113) // i32.and
  fbI32Bin(114) // i32.or
  fbLocalSet(5)
  fbLocalGet(6)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(6)
  fbBr(0)
  fbEnd()
  fbEnd()
  // lo = the smallest code point this width is allowed to encode (the overlong test).
  fbI32Const(128)
  fbLocalSet(8)
  fbLocalGet(4)
  fbI32Const(3)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)
  fbI32Const(2048)
  fbLocalSet(8)
  fbEnd()
  fbLocalGet(4)
  fbI32Const(4)
  fbI32Bin(70) // i32.eq
  fbIf(64)
  fbI32Const(65536)
  fbLocalSet(8)
  fbEnd()
  // Overlong, surrogate, or past U+10FFFF: U+FFFD, but consume the WHOLE malformed
  // sequence (width n) — the maximal-subpart rule the lossy decoder already follows.
  fbLocalGet(5)
  fbLocalGet(8)
  fbI32Bin(72) // i32.lt_s
  fbLocalGet(5)
  fbI32Const(1114111)
  fbI32Bin(74) // i32.gt_s
  fbI32Bin(114) // i32.or
  fbLocalGet(5)
  fbI32Const(55296)
  fbI32Bin(78) // i32.ge_s
  fbLocalGet(5)
  fbI32Const(57343)
  fbI32Bin(76) // i32.le_s
  fbI32Bin(113) // i32.and
  fbI32Bin(114) // i32.or
  fbIf(64)
  fbI32Const(65533)
  fbLocalSet(5)
  fbEnd()
  fbLocalGet(4)
  fbI32Const(24)
  fbI32Bin(116) // i32.shl
  fbLocalGet(5)
  fbI32Bin(114) // i32.or
  fbEnd() // end (function) — leaves (width << 24) | cp
  wTarget(prev)
  helpFrameBody(out, body)
}

// Push `[out, w + off]` — the destination array and index for the `off`-th byte of the
// sequence being written. The caller pushes the byte value and closes with `array.set`.
function fbUtf8Put(outL: i32, wL: i32, off: i32) {
  fbLocalGet(outL)
  fbLocalGet(wL)
  if off != 0 {
    fbI32Const(off)
    fbI32Bin(106) // i32.add
  }
  0
}

// `back[start + i]` for `__utf8_enc__`'s source list — the i32 code point at logical index
// `i`, read through `$aTypeIdx` (a plain i32 array, not the packed string backing).
function fbUtf8EncRead(iL: i32, cpL: i32) {
  fbLocalGet(0)
  fbLocalGet(1)
  fbLocalGet(iL)
  fbI32Bin(106) // i32.add
  fbArrayGet(aTypeIdx)
  fbLocalSet(cpL)
  fbUtf8Sanitize(cpL)
  0
}

// `if cp >= <bound> { n = n + 1 }` — one rung of `__utf8_enc__`'s width sum. Three rungs at
// 0x80 / 0x800 / 0x10000 give 1 / 2 / 3 / 4 with no branch tree.
function fbUtf8WidthStep(bound: i32) {
  fbLocalGet(5)
  fbI32Const(bound)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(3)
  fbEnd()
  0
}

// The LEAD byte of a multi-byte sequence: `mark | (cp >> shift)`.
function fbUtf8Lead(mark: i32, shift: i32) {
  fbI32Const(mark)
  fbLocalGet(5)
  fbI32Const(shift)
  fbI32Bin(118) // i32.shr_u
  fbI32Bin(114) // i32.or
  0
}

// A CONTINUATION byte: `0x80 | ((cp >> shift) & 0x3f)`.
function fbUtf8Cont(shift: i32) {
  fbI32Const(128)
  fbLocalGet(5)
  if shift != 0 {
    fbI32Const(shift)
    fbI32Bin(118) // i32.shr_u
  }
  fbI32Const(63)
  fbI32Bin(113) // i32.and
  fbI32Bin(114) // i32.or
  0
}

// `w = w + k` — advance `__utf8_enc__`'s write cursor past the sequence just written.
function fbUtf8Bump(wL: i32, k: i32) {
  fbLocalGet(wL)
  fbI32Const(k)
  fbI32Bin(106) // i32.add
  fbLocalSet(wL)
  0
}

// `__utf8_enc__(back, start, len) -> (ref str)` — UTF-8-encodes `len` i32 code points read
// from `back[start ..]` into a fresh, exact-fit string. Params: back(0) `(ref $aTypeIdx)`,
// start(1), len(2). Locals: n(3), i(4), cp(5), out(6) `(ref $sBackIdx)`, w(7). Two passes,
// because a WasmGC array is fixed-length: pass 1 sums the widths to size the backing, pass 2 writes; both read through `fbUtf8EncRead`, so they cannot disagree about what a code point is.
function emitUtf8EncFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(3) // 3 locals runs — the ref sits BETWEEN two i32 runs, so the vector splits
  wULEB(3) // n(3), i(4), cp(5)
  wU8(127) // 0x7f i32
  wULEB(1)
  wU8(100) // 0x64 (ref $sBackIdx) — out(6), set once at top level before any read
  wSLEB(sBackIdx)
  wULEB(1) // w(7)
  wU8(127) // 0x7f i32
  // pass 1: n = Σ width(cp)
  fbI32Const(0)
  fbLocalSet(3)
  fbI32Const(0)
  fbLocalSet(4)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(4)
  fbLocalGet(2)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  fbUtf8EncRead(4, 5)
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(3)
  fbUtf8WidthStep(128)
  fbUtf8WidthStep(2048)
  fbUtf8WidthStep(65536)
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(4)
  fbBr(0)
  fbEnd()
  fbEnd()
  // out = array.new_default $sBackIdx n
  fbLocalGet(3)
  fbArrayNewDefault(sBackIdx)
  fbLocalSet(6)
  // pass 2: write
  fbI32Const(0)
  fbLocalSet(7)
  fbI32Const(0)
  fbLocalSet(4)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(4)
  fbLocalGet(2)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  fbUtf8EncRead(4, 5)
  // 1 byte: 0xxxxxxx
  fbLocalGet(5)
  fbI32Const(128)
  fbI32Bin(72) // i32.lt_s
  fbIf(64)
  fbUtf8Put(6, 7, 0)
  fbLocalGet(5)
  fbArraySet(sBackIdx)
  fbUtf8Bump(7, 1)
  fbElse()
  // Two-byte form: 110xxxxx 10xxxxxx
  fbLocalGet(5)
  fbI32Const(2048)
  fbI32Bin(72) // i32.lt_s
  fbIf(64)
  fbUtf8Put(6, 7, 0)
  fbUtf8Lead(192, 6)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 1)
  fbUtf8Cont(0)
  fbArraySet(sBackIdx)
  fbUtf8Bump(7, 2)
  fbElse()
  // Three-byte form: 1110xxxx 10xxxxxx 10xxxxxx
  fbLocalGet(5)
  fbI32Const(65536)
  fbI32Bin(72) // i32.lt_s
  fbIf(64)
  fbUtf8Put(6, 7, 0)
  fbUtf8Lead(224, 12)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 1)
  fbUtf8Cont(6)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 2)
  fbUtf8Cont(0)
  fbArraySet(sBackIdx)
  fbUtf8Bump(7, 3)
  fbElse()
  // Four-byte form: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
  fbUtf8Put(6, 7, 0)
  fbUtf8Lead(240, 18)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 1)
  fbUtf8Cont(12)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 2)
  fbUtf8Cont(6)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 3)
  fbUtf8Cont(0)
  fbArraySet(sBackIdx)
  fbUtf8Bump(7, 4)
  fbEnd()
  fbEnd()
  fbEnd()
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(4)
  fbBr(0)
  fbEnd()
  fbEnd()
  // The whole-backing header over the exact fit.
  fbLocalGet(6)
  fbI32Const(0)
  fbLocalGet(3)
  fbStrNew()
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__utf8_cplen__(s) -> i32` — the code point count of a string view, O(n). Params: s(0).
// Locals: back(1) `(ref null $sBackIdx)`, i(2), end(3), n(4). Drives `__utf8_dec__` rather
// than counting non-continuation bytes: the difference shows only on malformed input, where
// a cheap count and the decode-driven count disagree (a stray continuation byte or truncated sequence each yield their own U+FFFD) — this stays the decode's own answer, not a second one.
function emitUtf8CpLenFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(2)
  wULEB(1)
  wU8(99)       // 0x63 (ref null ht) — the hoisted backing
  wSLEB(sBackIdx)
  wULEB(3)
  wU8(127)      // 0x7f i32 (i, end, n)
  fbLocalGet(0)
  fbStrBack()
  fbLocalSet(1)
  fbLocalGet(0)
  fbStrStart()
  fbLocalSet(2)
  fbLocalGet(2)
  fbLocalGet(0)
  fbStrLen()
  fbI32Bin(106) // i32.add
  fbLocalSet(3)
  fbI32Const(0)
  fbLocalSet(4)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(2)
  fbLocalGet(3)
  fbI32Bin(78)  // i32.ge_s
  fbBrIf(1)
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(4) // one more code point
  fbLocalGet(2)
  fbLocalGet(1)
  wU8(212)      // 0xd4 ref.as_non_null — the hoist slot is nullable; the call is not
  fbLocalGet(2)
  fbLocalGet(3)
  fbCall(gHelpUtf8Dec)
  fbI32Const(24)
  fbI32Bin(118) // 0x76 i32.shr_u — the WIDTH, the same stride `for cp in s` takes
  fbI32Bin(106) // i32.add
  fbLocalSet(2)
  fbBr(0)
  fbEnd()
  fbEnd()
  fbLocalGet(4)
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_bytes__(s) -> (ref $bl8TypeIdx)` — `s.bytes()`, the `u8[]` view of a string's UTF-8
// storage. One `array.copy` of the view's byte range into an exact-fit packed backing,
// wrapped in the ordinary list struct. Params: s(0). Locals: out(1), a non-null
// `(ref $ba8TypeIdx)` set before reads. It copies though the design doc says it should not: a `u8[]` wrapper has no `start` field, so a zero-copy `bytes()` would be silently wrong on `s.slice(1)` (filed, not done).
function emitStrBytesFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(1)
  wULEB(1)
  wU8(100) // 0x64 (ref $ba8TypeIdx) — out
  wSLEB(ba8TypeIdx)
  // out = array.new_default $ba8 (s.len)
  fbLocalGet(0)
  fbStrLen()
  fbArrayNewDefault(ba8TypeIdx)
  fbLocalSet(1)
  // array.copy out 0 s.backing s.start s.len — the cross-heap-type copy is legal because
  // `array.copy` validates on STORAGE types (i8 into i8), not on heap-type identity.
  fbLocalGet(1)
  fbI32Const(0)
  fbLocalGet(0)
  fbStrBack()
  fbLocalGet(0)
  fbStrStart()
  fbLocalGet(0)
  fbStrLen()
  fbArrayCopy(ba8TypeIdx, sBackIdx)
  // { backing: out, len: s.len, cap: s.len } — an exact fit, as `array.new_fixed` makes.
  fbLocalGet(1)
  fbLocalGet(0)
  fbStrLen()
  fbLocalGet(0)
  fbStrLen()
  fbStructNew(bl8TypeIdx)
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// The index-capacity power-of-two invariant, which both probe helpers and the rehash rely on
// to wrap with `i32.and` instead of `i32.rem_u`. The `index` array's length is a power of two
// at every point in a map's life, from its only three producers (`emitMapNew` at 16,
// `__map_resize__` at `2 * len(index)`, `emitMapCompact`) — a fourth producer must keep `mask = cap - 1`. `__map_probe__`: wrapping linear probe to the matching-or-free slot, the shared core of every map op.
function emitMapProbeFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(1) // 1 locals run
  wULEB(3) // count 3
  wU8(127) // 0x7f i32
  // mask = array.len(index) - 1  (the index length is a power of two)
  fbLocalGet(1)
  fbArrayLen()
  fbI32Const(1)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(6)
  // slot = keyHash & mask   (== keyHash % cap)
  fbLocalGet(0)
  fbLocalGet(6)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(7)
  fbBlock(64)   // block (probe break target), void
  fbLoop(64)    // loop, void
  // entry = index[slot] ; if entry == 0 { br out (miss) }
  fbLocalGet(1)
  fbLocalGet(7)
  fbArrayGet(aTypeIdx)
  fbLocalSet(8)
  fbLocalGet(8)
  fbI32Eqz()
  fbBrIf(1) // → out of the probe block
  // hashes[entry-1] == keyHash && live[entry-1] != 0
  //   ? __str_eq__(keysBack[entry-1], key) : 0
  fbLocalGet(2)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)        // i32.sub (entry - 1)
  fbArrayGet(aTypeIdx)
  fbLocalGet(0)
  fbI32Bin(70)         // 0x46 i32.eq
  fbLocalGet(3)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71)         // 0x47 i32.ne (live != 0)
  fbI32Bin(113)        // 0x71 i32.and — the expensive compare rides an `if`
  fbIf(127)            // if, i32 blocktype
  fbLocalGet(4)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(mkArrIdx) // keysBack[entry-1] — (ref null $aTypeIdx)
  fbRefAsNonNull()     // a stored slot is populated
  fbLocalGet(5)
  fbCall(gHelpStrEq)
  fbElse()
  fbI32Const(0)        // hash/live mismatch → not a hit
  fbEnd()
  // if match { br out (hit) }
  fbBrIf(1)
  // slot = (slot + 1) & mask  (collision OR a tombstone marker: keep probing)
  fbLocalGet(7)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(6)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(7)
  fbBr(0)       // → loop header
  fbEnd()       // end (loop)
  fbEnd()       // end (probe block)
  fbLocalGet(7) // the probe slot
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__map_probe_i32__(index, hashes, live, keysBacking, key) -> i32`: the i32-keyed twin of
// `__map_probe__`, line for line, with three substitutions — the key hashes by the integer
// mix (`fbI32HashMix`) instead of `__str_hash__`, the stored-hash gate falls through to an
// `i32.eq` on the key, and the mix stays inline here (the string hash is hoisted to the call site instead) — everything else is identical, which lets both key kinds share `__map_resize__`, the rehash and the compaction.
function emitMapProbeI32FnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(1) // 1 locals run
  wULEB(4) // count 4
  wU8(127) // 0x7f i32
  // mask = array.len(index) - 1  (the index length is a power of two)
  fbLocalGet(0)
  fbArrayLen()
  fbI32Const(1)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(5)
  // keyHash = mix(key)
  fbI32HashMix(4, 6)
  fbLocalSet(6)
  // slot = keyHash & mask   (== keyHash % cap)
  fbLocalGet(6)
  fbLocalGet(5)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(7)
  fbBlock(64)   // block (probe break target), void
  fbLoop(64)    // loop, void
  // entry = index[slot] ; if entry == 0 { br out (miss) }
  fbLocalGet(0)
  fbLocalGet(7)
  fbArrayGet(aTypeIdx)
  fbLocalSet(8)
  fbLocalGet(8)
  fbI32Eqz()
  fbBrIf(1) // → out of the probe block
  // hashes[entry-1] == keyHash && live[entry-1] != 0
  //   ? keysBack[entry-1] == key : 0
  fbLocalGet(1)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)        // i32.sub (entry - 1)
  fbArrayGet(aTypeIdx)
  fbLocalGet(6)
  fbI32Bin(70)         // 0x46 i32.eq
  fbLocalGet(2)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71)         // 0x47 i32.ne (live != 0)
  fbI32Bin(113)        // 0x71 i32.and
  fbIf(127)            // if, i32 blocktype
  fbLocalGet(3)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTypeIdx) // keysBack[entry-1] — a raw i32
  fbLocalGet(4)
  fbI32Bin(70)         // 0x46 i32.eq
  fbElse()
  fbI32Const(0)        // hash/live mismatch → not a hit
  fbEnd()
  // if match { br out (hit) }
  fbBrIf(1)
  // slot = (slot + 1) & mask  (collision OR a tombstone marker: keep probing)
  fbLocalGet(7)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(5)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(7)
  fbBr(0)       // → loop header
  fbEnd()       // end (loop)
  fbEnd()       // end (probe block)
  fbLocalGet(7) // the probe slot
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__map_resize__(index, hashes, live, count, size) -> (ref $aTypeIdx)`: when the load factor
// crosses 1/2 (`size*2 >= len(index)`), allocates a doubled index and re-places every live entry
// from its stored hash (no key re-hashing), returning the fresh backing; otherwise returns
// `index` unchanged. The caller unconditionally stores the result back into `M.index`.
function emitMapResizeFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(2) // 2 locals runs
  wULEB(3) // count 3
  wU8(127) // 0x7f i32 (newCap, i, rslot)
  wULEB(1) // count 1
  wU8(100) // 0x64 (ref $aTypeIdx) — newIdx
  wSLEB(aTypeIdx)
  // if size * 2 >= len(index) { grow + rehash + early-return newIdx }
  fbLocalGet(4)
  fbI32Const(2)
  fbI32Bin(108) // i32.mul (size * 2)
  fbLocalGet(0)
  fbArrayLen()
  fbI32Bin(79)  // 0x4f i32.ge_u
  fbIf(64)      // if, void
  // newCap = 2 * len(index) ; newIdx = array.new_default $aTypeIdx newCap
  fbLocalGet(0)
  fbArrayLen()
  fbI32Const(2)
  fbI32Bin(108)
  fbLocalSet(5)
  fbLocalGet(5)
  fbArrayNewDefault(aTypeIdx)
  fbLocalSet(8)
  // i = 0
  fbI32Const(0)
  fbLocalSet(6)
  // loop { if i >= count {} else { re-place LIVE entry i ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(6)
  fbLocalGet(3)
  fbI32Bin(78) // i32.ge_s (i >= count → done)
  fbIf(64)     // then: done (empty)
  fbElse()
  // if live[i] != 0 { rslot = hashes[i] % newCap ; probe free ; newIdx[rslot] = i+1 }
  fbLocalGet(2)
  fbLocalGet(6)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71) // i32.ne
  fbIf(64)
  // rslot = hashes[i] % newCap — re-places from the stored hash
  fbLocalGet(1)
  fbLocalGet(6)
  fbArrayGet(aTypeIdx)
  fbLocalGet(5)
  fbI32Bin(112) // i32.rem_u
  fbLocalSet(7)
  // while newIdx[rslot] != 0 { rslot = (rslot + 1) % newCap }
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(8)
  fbLocalGet(7)
  fbArrayGet(aTypeIdx)
  fbI32Eqz()
  fbBrIf(1) // → out of the inner block
  fbLocalGet(7)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(5)
  fbI32Bin(112)
  fbLocalSet(7)
  fbBr(0)   // → inner loop header
  fbEnd()   // end (inner loop)
  fbEnd()   // end (inner block)
  // newIdx[rslot] = i + 1
  fbLocalGet(8)
  fbLocalGet(7)
  fbLocalGet(6)
  fbI32Const(1)
  fbI32Bin(106)
  fbArraySet(aTypeIdx)
  fbEnd() // end (live if)
  // i = i + 1
  fbLocalGet(6)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(6)
  fbBr(1)       // → outer loop header
  fbEnd()       // end (ge_s if)
  fbEnd()       // end (outer loop)
  fbLocalGet(8)
  fbReturn()    // the fresh, rebuilt index
  fbEnd()       // end (resize if)
  fbLocalGet(0) // load factor fine → the index unchanged
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__f64_rem__(x, y) -> f64`: the truncated remainder — `x - y * trunc(x / y)` in value, with
// the sign of the dividend (Rust's `f64::rem`, JS's `%`, C's `fmod`; wasm has no instruction
// for it, D1586). Not that identity evaluated directly — it is off by an ulp once the
// quotient passes 2^53 — but a scaled repeated-subtraction form: double `b` to the largest `b * 2^k <= a`, then halve back down subtracting where it fits, each step exact in Sterbenz's range.
function emitF64RemFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(1) // one locals run
  wULEB(4) // four of them
  wU8(124) // 0x7c f64 — a, b, t, s
  // x not finite (NaN or ±inf) → NaN. `v - v` is NaN for both and 0 for every finite v, which is
  // the whole finiteness test and needs no `inf` constant to compare against.
  fbLocalGet(0)
  fbLocalGet(0)
  fbI32Bin(161) // 0xa1 f64.sub
  fbLocalTee(5)
  fbLocalGet(5)
  fbI32Bin(98) // 0x62 f64.ne
  fbIf(64)
  fbF64Const("0.0")
  fbF64Const("0.0")
  fbI32Bin(163) // 0xa3 f64.div — 0/0 is the NaN this returns
  fbReturn()
  fbEnd()
  // b = |y|; y NaN, or y zero → NaN. The NaN arm is separate because `|NaN| == 0.0` is FALSE.
  fbLocalGet(1)
  fbI32Bin(153) // 0x99 f64.abs
  fbLocalTee(3)
  fbF64Const("0.0")
  fbI32Bin(97) // 0x61 f64.eq
  fbLocalGet(1)
  fbLocalGet(1)
  fbI32Bin(98) // 0x62 f64.ne
  fbI32Bin(114) // 0x72 i32.or
  fbIf(64)
  fbF64Const("0.0")
  fbF64Const("0.0")
  fbI32Bin(163) // 0xa3 f64.div
  fbReturn()
  fbEnd()
  // y INFINITE → x. y is not NaN by here, so the same `v - v` test names ±inf alone.
  fbLocalGet(1)
  fbLocalGet(1)
  fbI32Bin(161) // 0xa1 f64.sub
  fbLocalTee(5)
  fbLocalGet(5)
  fbI32Bin(98) // 0x62 f64.ne
  fbIf(64)
  fbLocalGet(0)
  fbReturn()
  fbEnd()
  // a = |x|; |x| < |y| → x itself, which is what carries `-0.0 % 1` through unharmed (D1586).
  fbLocalGet(0)
  fbI32Bin(153) // 0x99 f64.abs
  fbLocalTee(2)
  fbLocalGet(3)
  fbI32Bin(99) // 0x63 f64.lt
  fbIf(64)
  fbLocalGet(0)
  fbReturn()
  fbEnd()
  // SCALE UP: t = b, doubling while `t * 2 <= a`. A double that overflows lands on +inf,
  // which is `> a` for every finite a, so the loop exits rather than looping forever.
  fbLocalGet(3)
  fbLocalSet(4)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(4)
  fbF64Const("2.0")
  fbI32Bin(162) // 0xa2 f64.mul
  fbLocalTee(5)
  fbLocalGet(2)
  fbI32Bin(100) // 0x64 f64.gt
  fbBrIf(1)
  fbLocalGet(5)
  fbLocalSet(4)
  fbBr(0)
  fbEnd()
  fbEnd()
  // DESCEND: subtract t where it fits, halve, stop at t == b. `a < 2t` holds at every step,
  // so each subtraction is exact and `a` ends in [0, b) — the remainder's magnitude.
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(2)
  fbLocalGet(4)
  fbI32Bin(102) // 0x66 f64.ge
  fbIf(64)
  fbLocalGet(2)
  fbLocalGet(4)
  fbI32Bin(161) // 0xa1 f64.sub
  fbLocalSet(2)
  fbEnd()
  fbLocalGet(4)
  fbLocalGet(3)
  fbI32Bin(97) // 0x61 f64.eq
  fbBrIf(1)
  fbLocalGet(4)
  fbF64Const("0.5")
  fbI32Bin(162) // 0xa2 f64.mul
  fbLocalSet(4)
  fbBr(0)
  fbEnd()
  fbEnd()
  // The sign is the dividend's, including on a zero result (`-4.0 % 2.0` is `-0.0`; D1586).
  fbLocalGet(2)
  fbLocalGet(0)
  fbI32Bin(166) // 0xa6 f64.copysign
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// Emits the wasm "name" custom section (id 0) so a wasmtime trap backtrace shows real
// function names instead of `<wasm function N>`. Gated on `gEmitNames` — a no-op when off, so
// the default emit path (goldens + fixpoints) is untouched. `n` is the user-function count and
// `gImports` the imported-function count; imports occupy indices 0..gImports-1, users after. Indices in the namemap must be strictly increasing, per the name-section appendix.
function emitNameSection(n: i32) {
  if gEmitNames == 0 { return 0 }

  // ── function-name subsection (id 1) ──────────────────────────────────────────
  // Build the namemap (count + entries) into a temp buffer, then frame it as the
  // subsection payload. The print imports (if present) are named first at their
  // hardcoded indices 0..3, then each user function at `gImports + i`.
  const fnameMap: i32[] = []
  const mapPrev = wTarget(fnameMap)
  let count = gImports + n
  if gHelpStrHash >= 0 { count = count + 6 }
  if gHelpStrBytes >= 0 { count = count + 1 }
  if gHelpMapProbe >= 0 { count = count + 2 }
  if gHelpMapProbeI32 >= 0 { count = count + 1 }
  if gHelpF64Rem >= 0 { count = count + 1 }
  wULEB(count)
  if gImports > 0 {
    wULEB(0)
    wName("__print_i32__")
    wULEB(1)
    wName("__print_bool__")
    wULEB(2)
    wName("__print_char__")
    wULEB(3)
    wName("__print_str_flush__")
    // The 5th import (index 4) is named only when an i64 program prints.
    if gNeedsI64Print {
      wULEB(4)
      wName("__print_i64__")
    }
    // The `__print_f64__` import is named at its computed index (`gF64PrintIdx`, 4 or 5).
    if gNeedsF64Print {
      wULEB(gF64PrintIdx)
      wName("__print_f64__")
    }
    // The `__print_f32__` import is named at its computed index (`gF32PrintIdx`, 4/5/6).
    if gNeedsF32Print {
      wULEB(gF32PrintIdx)
      wName("__print_f32__")
    }
    // The fs imports, each at the index `scanPrintUse` recorded. They sit between the print family
    // and the user functions, which is where slot order puts them, so the namemap stays strictly
    // increasing — the one hard requirement the appendix places on this subsection. `count` above
    // already includes them, so writing them here is what makes it honest.
    let fsnm = 0
    while fsnm < fsIntrinsicCount() {
      if fsUsedAt(fsnm) {
        let fsIx = fsIdxAt(fsnm)
        let fsLbl = fsIntrinsicNameAt(fsnm)
        if fsIx < 0 || fsLbl == "" {
          // Same rule as the import section's twin loop: `curBuf` is bound to `fnameMap` here, so
          // record the failure and write a placeholder rather than returning out from under the
          // binding. The namemap count is fixed at `gImports + n` before the loop and must still be met.
          emitFail(
            "emitProgram: fs import is used but has no index or name — the slot tables have drifted",
          )
          fsIx = 0
          fsLbl = "__fs_unknown__"
        }
        wULEB(fsIx)
        wName(fsLbl)
      }
      fsnm = fsnm + 1
    }
    // The user externs, after the fs block, which is where manifest order puts them — so the
    // namemap stays strictly increasing, the appendix's one hard requirement.
    let exnm = 0
    while exnm < externCount() {
      let exIx = externIdxAt(exnm)
      let exLbl = externNameAt(exnm)
      if exIx < 0 || exLbl == "" {
        emitFail(
          "emitProgram: extern import has no index or name — the manifest and its readers have drifted",
        )
        exIx = 0
        exLbl = "__extern_unknown__"
      }
      wULEB(exIx)
      wName(exLbl)
      exnm = exnm + 1
    }
  }
  let fi = 0
  while fi < n {
    const fn = P.nodes[fnStmts[fi]]
    if fn is FuncDecl {
      wULEB(gImports + fi)
      // Prefer a lambda's DEBUG display name (its binding, `const foo = …` → "foo")
      // over the synthesized `__lambda_N`, so a trap backtrace reads `foo`.
      const disp = fnDispNames[fi]
      if disp.length > 0 { wName(disp) } else { wName(fn.fnName) }
    }
    fi = fi + 1
  }
  // The shared runtime helpers (module-tail indices — after the start fn and the
  // `__log__` decoder, so the namemap stays strictly increasing).
  if gHelpStrHash >= 0 {
    wULEB(gHelpStrHash)
    wName("__str_hash__")
    wULEB(gHelpStrEq)
    wName("__str_eq__")
    wULEB(gHelpStrConcat)
    wName("__str_concat__")
    wULEB(gHelpUtf8Dec)
    wName("__utf8_dec__")
    wULEB(gHelpUtf8Enc)
    wName("__utf8_enc__")
    wULEB(gHelpUtf8CpLen)
    wName("__utf8_cplen__")
  }
  if gHelpStrBytes >= 0 {
    wULEB(gHelpStrBytes)
    wName("__str_bytes__")
  }
  if gHelpMapProbe >= 0 {
    wULEB(gHelpMapProbe)
    wName("__map_probe__")
    wULEB(gHelpMapResize)
    wName("__map_resize__")
  }
  if gHelpMapProbeI32 >= 0 {
    wULEB(gHelpMapProbeI32)
    wName("__map_probe_i32__")
  }
  if gHelpF64Rem >= 0 {
    wULEB(gHelpF64Rem)
    wName("__f64_rem__")
  }
  wTarget(mapPrev)

  // ── assemble the section payload: wName("name") + the two subsections ─────────
  const namePayload: i32[] = []
  const npPrev = wTarget(namePayload)
  wName("name")
  // module-name subsection (id 0): a single name. Its payload is a length-prefixed
  // name, built into a temp so the subsection-size ULEB frames the right length.
  const modName: i32[] = []
  const mnPrev = wTarget(modName)
  wName("vl")
  wTarget(mnPrev)
  wU8(0) // subsection id 0: module name
  wULEB(modName.length)
  wBytes(modName)
  // function-name subsection (id 1): the namemap built above.
  wU8(1) // subsection id 1: function names
  wULEB(fnameMap.length)
  wBytes(fnameMap)
  wTarget(npPrev)

  wSection(0, namePayload) // custom section id 0
  0
}

// Collects the string-literal pool: every distinct `StrLit` lexeme in the arena (first-seen
// arena order, deterministic per program) whose decoded length fits one `array.new_fixed` (an
// over-cap literal keeps the inline chunked build). An arena scan over-approximates live code,
// so a dead literal costs one small unused immutable global, never correctness; monomorphized clones share one entry by dedup on lexeme.
function collectStrPool() {
  gStrPoolTexts = []
  gStrPoolIx = Map()
  if !aUsed { return 0 }
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is StrLit {
      if (gStrPoolIx[nd.strText] ?? -1) < 0 {
        if cpsToUtf8(decodeStr(strToCps(nd.strText))).length <= NEW_FIXED_MAX {
          gStrPoolIx[nd.strText] = gStrPoolTexts.length
          gStrPoolTexts.push(nd.strText)
        }
      }
    }
    i = i + 1
  }
  0
}

// Assembles the whole module: the header, then each section through its own emitter in
// wasm's mandated section-id order. Before any section bytes go out, this fixes the
// module-wide index spaces every section then references — start-function and `__log__`
// indices, shared-helper indices, the string pool, and every heap type — so no emitter has to re-derive an index another already chose.
function emitModule(_stmts: i32[]) {
  emitReset()
  // The collect passes are done, so this is the last moment before any section indexes a
  // variant: prove the field-span tables cover every `uVariants` row, or fail loudly and pad
  // them, since a short table turns the next thirty reads into a compiler trap. Deliberately not
  // gated on `emitFailed` — the mismatch comes from a swallowed registration failure, so the flag is already set when it matters.
  reconcileVariantFieldSpans()
  emitHeader()

  const n = fnStmts.length

  // ── start-function model (non-const module-global initializers) ──
  // A module global whose initializer is not a WasmGC constant expression cannot be emitted
  // inline in the global section: its cell is zero-initialized there, and a single synthetic
  // start function (the last function index, so no user index shifts) runs every such init via `global.set` first. `computeGlobalPromotion` runs here so it sees the arena every pass left behind, before any section reads a global index.
  computeGlobalPromotion()
  let nNonConst = 0
  let gci = 0
  while gci < globalStmts.length {
    if globalRunsInStartFn(gci) { nNonConst = nNonConst + 1 }
    gci = gci + 1
  }
  let hasStart = 0
  if nNonConst > 0 { hasStart = 1 }
  if startStmts.length > 0 { hasStart = 1 }
  // The synthetic start function's index (last, after all `n` user functions, which
  // themselves sit after any imports) and its `()->()` functype index (one past the
  // user functypes). Both unused when no start.
  const startFnIdx = gImports + n
  // The synthetic `__log__` decoder (memory intrinsics) is the LAST function index —
  // after the imports, the user functions, AND the start fn — so no other function
  // index shifts. `memFn` (0 or 1) feeds the function/code section counts.
  let memFn = 0
  if memLogUsed { memFn = 1 }
  gMemLogIdx = gImports + n + hasStart

  // ── shared runtime helpers (module-tail functions) ──
  // Assigns each enabled helper the next function index after the start fn and the `__log__`
  // decoder (so no other index shifts), in a fixed order keyed only on type-presence flags —
  // deterministic per program, so the self-compile fixpoint converges. An enabled-but-uncalled helper costs a few dozen bytes, never correctness.
  gHelpStrHash = -1
  gHelpStrEq = -1
  gHelpStrConcat = -1
  gHelpUtf8Dec = -1
  gHelpUtf8Enc = -1
  gHelpUtf8CpLen = -1
  gHelpStrBytes = -1
  gHelpMapProbe = -1
  gHelpMapProbeI32 = -1
  gHelpMapResize = -1
  gHelpF64Rem = -1
  let nHelpers = 0
  const helpBase = gImports + n + hasStart + memFn
  if aUsed {
    gHelpStrHash = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpStrEq = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpStrConcat = helpBase + nHelpers
    nHelpers = nHelpers + 1
    // The UTF-8 codec trio, AFTER the string trio so a program's existing helper indices
    // are unmoved by Stage 2c. Same `aUsed` gate and same "enabled-but-uncalled costs a
    // few dozen bytes, never correctness" trade the trio above documents.
    gHelpUtf8Dec = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpUtf8Enc = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpUtf8CpLen = helpBase + nHelpers
    nHelpers = nHelpers + 1
    // `s.bytes()` needs the packed pair to exist, so unlike its three neighbours it is gated on
    // `ba8Used` too — `bl8TypeIdx` is 0 when unminted, and a helper naming it would collide with heap type 0.
    if ba8Used {
      gHelpStrBytes = helpBase + nHelpers
      nHelpers = nHelpers + 1
    }
  }
  if mUsed {
    gHelpMapProbe = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpMapResize = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // The i32-KEYED probe, LAST so no existing helper index moves in a program without
  // one (`__map_resize__` is key-agnostic — it re-places from the STORED hashes — so
  // the i32-keyed map shares it and only the probe needs a twin).
  if mI32Used {
    gHelpMapProbeI32 = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // The float remainder helper (D1586), last for the reason its neighbour above gives: no
  // existing helper index moves in a program without one. It is the first helper gated on
  // neither `aUsed` nor a map flag — a float program touches no string and no map.
  if gNeedsF64Rem {
    gHelpF64Rem = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }

  // Intern the string-literal pool (its globals PRECEDE the user cells — every
  // user-global index below rides `userGlobalIdx`).
  collectStrPool()

  // Heap-type indices, in type-section order: standalone structs, then (for the union path)
  // the variant structs + box, the i32 array/list pair, each ref-list pair, the string-list
  // pair, the map struct, and finally the functypes — minted by the centralized `mIntern*`
  // counter inside `mAssignTypeIndices`, which returns the functype base index (`typeOffset`); all types emit inside one recursion group, so a type may reference one that lands later.
  const typeOffset = mAssignTypeIndices(n)

  // Each type's byte form lives at its emit site in `emitTypeSection`, which is also where the
  // standalone-vs-rec-group split for the print functypes is explained. `nPrintTypes` is
  // counted here, in the coordinator, because two sections need it: the type section (whose
  // rec-group count excludes the standalone print functypes) and the function section (whose `__log__` functype index sits past them). A print-free program counts 0.
  let nPrintTypes = 0
  if gImports > 0 {
    nPrintTypes = 2 // (i32)->() and ()->() for the print imports
  }
  if gNeedsI64Print {
    nPrintTypes = nPrintTypes + 1 // + (i64)->() for __print_i64__
  }
  if gNeedsF64Print {
    nPrintTypes = nPrintTypes + 1 // + (f64)->() for __print_f64__
  }
  if gNeedsF32Print {
    nPrintTypes = nPrintTypes + 1 // + (f32)->() for __print_f32__
  }
  // One standalone functype per used fs import, folded into `nPrintTypes` rather than threaded
  // as a seventh parameter — every downstream index (the `__log__` functype, `helpTyBase`, the
  // export-wrapper block, the rectype count) is already expressed in terms of this number. One
  // per used import, not one per distinct shape: sharing would make slot k's functype depend on which other slots the program uses, the coupling the append-only slot order exists to avoid.
  nPrintTypes = nPrintTypes + fsImportCount()
  // …and one per declared extern, on the same terms and trailing the fs block, so an extern
  // added to a program moves no earlier functype index.
  nPrintTypes = nPrintTypes + externCount()

  emitTypeSection(n, typeOffset, hasStart, memFn, nPrintTypes, nHelpers)

  emitImportSection(n, typeOffset, hasStart)

  emitFunctionSection(n, typeOffset, hasStart, memFn, nPrintTypes, nHelpers)

  // Table section (id 4, between function (3) and memory (5)): the one `funcref` table function
  // values dispatch through, sized to cover every user function at its own wasm index (`gImports
  // + i`), so the id a closure already stores is the table slot. The leading `gImports` slots
  // stay null (never function-value targets); emitted only when `fnValUsed`, mirroring the element section below.
  if fnValUsed {
    const tabPayload: i32[] = []
    const tabPrev = wTarget(tabPayload)
    wULEB(1)            // 1 table
    wU8(112)            // 0x70 funcref element type
    wU8(0)              // limits flag 0x00: min only
    wULEB(gImports + n) // min: every user function, at its own index
    wTarget(tabPrev)
    wSection(4, tabPayload)
  }

  // Memory section (id 5, between function (3) and global (6)): one module-defined memory, min
  // 1 page, no max. The host imports `imports.memory` instead; the native runner provides no
  // memory import, so the module defines its own (same observable behavior). Emitted only when a memory intrinsic is used.
  if memUsed {
    const memPayload: i32[] = []
    const memPrev = wTarget(memPayload)
    wULEB(1) // 1 memory
    wU8(0)   // limits flag 0x00: min only
    wULEB(1) // min: 1 page
    wTarget(memPrev)
    wSection(5, memPayload)
  }

  emitGlobalSection()

  // The export ABI wrappers (#1265) sit after EVERY other function — user functions, the
  // start fn, the `__log__` decoder and the shared helpers — so adding them shifts no
  // existing function index. Wrapper k belongs to export entry k.
  emitExportSection(n, helpBase + nHelpers)

  // Start section (id 8): names the function the runtime invokes once at instantiation, before
  // any export is callable — here the synthetic start fn that runs the non-const global
  // initializers. Sits after the export section (7) and before the code section (10); omitted entirely when no non-const global exists.
  if hasStart == 1 {
    const startPayload: i32[] = []
    const stPrev = wTarget(startPayload)
    wULEB(startFnIdx)
    wTarget(stPrev)
    wSection(8, startPayload)
  }

  // Element section (id 9): a single active elem segment that fills the section-4 table with
  // every user function at its own wasm index — the initializer `call_indirect` reads. Flags
  // 0x00 is the plain active form; the offset is `gImports` because entry `gImports + i` must
  // hold user function `i`. Emitted only when a function value exists (`fnValUsed`); sits after start (8), before code (10).
  if fnValUsed {
    const elemPayload: i32[] = []
    const elPrev = wTarget(elemPayload)
    wULEB(1) // 1 element segment
    wU8(0)   // flags 0x00: active, table 0, offset expr + func-index vec
    wU8(65)  // 0x41 i32.const — the offset expr
    wSLEB(gImports)
    wU8(11)  // 0x0b end
    wULEB(n) // count of table entries written
    let di = 0
    while di < n {
      wULEB(gImports + di) // func index (imports occupy 0..gImports-1)
      di = di + 1
    }
    wTarget(elPrev)
    wSection(9, elemPayload)
  }

  if emitCodeSection(n, hasStart, memFn, nHelpers) < 0 { return -1 }

  // Custom "name" section LAST (after the code section, where it conventionally
  // lives). A no-op unless `gEmitNames` is set, so the default emit path is
  // unchanged for every golden.
  emitNameSection(n)
  0
}

// ── emitProgram pass manager ──
// The front half of `emitProgram` is a sequence of ordered passes over the arena. Each pass
// table row is `"pass"` or `"pass > prereq prereq …"`, rows run top to bottom, and the driver
// asserts every prerequisite has already run before dispatching — so a reordered table fails loudly instead of miscompiling.

// True if `done` (the names of the passes run so far) contains the pass name
// spelled at `needs[i..j)` — a membership test without building a substring.
function passDoneHas(done: string[], needs: string, i: i32, j: i32) {
  let d = 0
  while d < done.length {
    const nm = done[d]
    if nm.length == j - i {
      let k = 0
      let same = true
      while k < nm.length {
        if nm[k] != needs[i + k] { same = false }
        k = k + 1
      }
      if same { return true }
    }
    d = d + 1
  }
  false
}

// True if every space-separated pass name in `needs` is present in `done`.
function passNeedsMet(needs: string, done: string[]) {
  let i = 0
  while i < needs.length {
    if needs[i] == 32 {
      i = i + 1 // skip the separator (space)
    } else {
      let j = i
      while j < needs.length && needs[j] != 32 { j = j + 1 }
      if !passDoneHas(done, needs, i, j) { return false }
      i = j
    }
  }
  true
}

// The pass NAME of a table row (`"buildFnMap#2 > monomorphize"` → `"buildFnMap#2"`):
// the leading run up to the first space or `>`.
function passRowName(row: string) {
  let e = 0
  while e < row.length && row[e] != 32 && row[e] != 62 { e = e + 1 }
  const nm = row.slice(0, e)
  nm
}

// The prerequisite list of a table row — everything after the `>` (`""` when the
// row declares none). Space-separated pass names, consumed by `passNeedsMet`.
function passRowNeeds(row: string) {
  let g = 0
  while g < row.length && row[g] != 62 { g = g + 1 }
  if g >= row.length { return "" }
  const nd = row.slice(g + 1, row.length)
  nd
}

// A module with no functions and no start statements is a module (D1080). The identical file
// imported by a program that uses its types compiles and runs, so a declarations-only module
// is legal — refusing it here is a clause-2 violation on a `vl check`-clean program. An
// empty wasm module is valid and every section here is already gated on having something to write, so this pass enforces nothing — it stays as a table row for the ordering edge `collectFns` declares.
function passCheckTopLevel() { 0 }

// Detects `print(...)`/memory-intrinsic use anywhere in the program: any print pulls in the
// 4-import print family (imports shift every local function's wasm index, so this is decided
// up front). "Any print" is the property, not the spelling `print(` — three constructs lower
// to a `__print_*__` import (`print(...)`, `__log__(...)`, `__trap__(<string>)`); a fourth missed here is invalid wasm that `vl check` passes. Grep `fbCall(0)`..`fbCall(4)` before adding one.
function scanPrintUse() {
  gImports = 0
  gNeedsI64Print = false
  gNeedsF64Print = false
  gF64PrintIdx = 0
  gNeedsF32Print = false
  gF32PrintIdx = 0
  memUsed = false
  memLogUsed = false
  // The fs tables are rebuilt from scratch, never patched: `scanPrintUse` is the single
  // writer and it runs once per module, so a stale row from a previous compile in the
  // same process would silently declare an import the program never calls.
  gFsUse = []
  gFsIdx = []
  let fsr = 0
  while fsr < fsIntrinsicCount() {
    gFsUse.push(0)
    gFsIdx.push(-1)
    fsr = fsr + 1
  }
  // The extern manifest is the import list, so every row is reserved whether or not the program
  // calls it: the declaration is the contract the host must satisfy, which is the whole point of
  // routing it through the import section (extern-design.md §3).
  gExtIdx = []
  let exr = 0
  while exr < externCount() {
    gExtIdx.push(-1)
    exr = exr + 1
  }
  let pscan = 0
  let sawI64Ann = false
  let sawF64 = false
  let sawF32 = false
  // D1586 — the `__f64_rem__` reservation, on the same terms as the import reservation this
  // pass exists for: a helper INDEX cannot be discovered mid-emit either. `sawFloatRem` is a
  // `%` the checker recorded at a float type; `sawRemUnknown` is a `%` with no recorded type
  // at all, which only counts once the module is known to mention a float.
  let sawFloatRem = false
  let sawRemUnknown = false
  while pscan < P.nodes.length {
    const pn = P.nodes[pscan]
    // D1041 — the numeric exact-or-fail cast, both halves this pass is for. (1) `as!` streams its
    // reason before the abort, through the same two imports `__trap__("reason")` uses, so it
    // reserves the print family exactly as that call does. (2) `as?` yields `T | null`, a
    // value-union box, and this is the only place in the program that spelling exists, so registering here is the only route that can ever mint the box heap type.
    if pn is AsExpr {
      // D1517 — and the operand axis is not a type axis. `asExprNumFallible` declines a union
      // operand by construction, so `u as? i32` over `i32 | string` reaches neither rung and its
      // `i32|null` row never mints, while the same program carrying an `i32 | null` annotation
      // anywhere runs. The registration is the node's own recorded result type; `registerValueUnionName` is self-gating on `isValueUnionName`, so `string|null`/`boolean|null` are no-ops.
      if pn.asMode == "null" {
        registerValueUnionName(tyToEmitName(nodeTyIxOf(pscan)))
      }
      if asExprNumFallible(pscan) {
        if pn.asMode == "trap" { gImports = 4 }
        if pn.asMode == "null" {
          registerValueUnionName(asExprNumTgtName(pscan) + "|null")
        }
      }
    }
    if pn is Call {
      const pcallee = P.nodes[pn.callFn]
      if pcallee is Ident {
        if pcallee.identName == "print" { gImports = 4 }
        // The linear-memory intrinsics: any store/load forces the module-defined
        // memory; `__log__` additionally forces the synthetic decoder function,
        // which prints through `__print_i32__` — so it pulls in the print-import
        // family exactly as a `print(...)` call does.
        if (
          pcallee.identName == "__store_i32__" ||
          pcallee.identName == "__load_i32__"
        ) {
          memUsed = true
        }
        // The five other store widths force the memory exactly as `__store_i32__` does. They add
        // nothing to the print-import scan below, and that is a decision: a store consumes a scalar
        // and yields none, so it can never route a `print` to an undeclared import. Membership, not a spelling: a width added to `nameIsMemStoreIntrinsic` forces the memory here the same day.
        if nameIsMemStoreIntrinsic(pcallee.identName) { memUsed = true }
        // The load-width matrix forces the memory exactly as `__load_i32__` does, and additionally
        // forces a `__print_*__` import when its result is a wide scalar: `print(__load_f64__(0))`
        // routes to `__print_f64__` in a program that spells `f64` nowhere, so the annotation scan
        // below cannot see it. Read off the name (`repMemLoadScalarMask`), which is total.
        if nameIsMemLoadIntrinsic(pcallee.identName) {
          memUsed = true
          const lscal = repMemLoadScalarMask(pcallee.identName)
          if (lscal & REP_SCAL_I64) != 0 { sawI64Ann = true }
          if (lscal & REP_SCAL_F64) != 0 { sawF64 = true }
          if (lscal & REP_SCAL_F32) != 0 { sawF32 = true }
        }
        // The bulk pair forces the memory for the same reason, generalised: `memory.copy`/
        // `memory.fill` are instructions on the memory, so a program whose only contact with linear
        // memory is `__memory_fill__(0, 0, 4)` still needs section 5 emitted or the instruction names
        // a memory that does not exist. Both are void, so like the stores they add nothing to the print-import scan below.
        if nameIsMemBulkIntrinsic(pcallee.identName) { memUsed = true }
        // The filesystem floor. Unlike every memory intrinsic above, these are host imports, so a use
        // here reserves a wasm function index — which is exactly why the reservation must happen in
        // this scan rather than at the call site: an extra import shifts every user function's index,
        // and the count cannot be discovered mid-emit. `gImports = 4` pulls in the print family first; the fs imports append after it, so the section every corpus golden pins is not rewritten.
        const fslot = fsIntrinsicSlot(pcallee.identName)
        if fslot >= 0 {
          gImports = 4
          if fslot < gFsUse.length { gFsUse[fslot] = 1 }
          if fsRetIsU8List(fslot) || fsArgIsU8List(fslot, 0) { ba8Used = true }
          if fsRetIsI64(fslot) { sawI64Ann = true }
          // A slot that WRITES linear memory forces section 5 exactly as `__memory_size__`
          // below does: `__fs_read_into__` hands the host an address, and a program whose
          // only memory contact is that call would otherwise name a memory that does not
          // exist — and the export the host looks the memory up by would not be emitted.
          if fsSlotWritesMemory(fslot) { memUsed = true }
        }
        // `memory.size` / `memory.grow` are instructions ON the memory: a program whose
        // ONLY memory contact is `__memory_size__()` still needs section 5 emitted, or
        // the instruction refers to a memory that does not exist and the module fails to
        // validate. Both are i32-valued, so neither touches the print-import scan.
        if (
          pcallee.identName == "__memory_size__" ||
          pcallee.identName == "__memory_grow__"
        ) {
          memUsed = true
        }
        if pcallee.identName == "__log__" {
          memUsed = true
          memLogUsed = true
          gImports = 4
        }
        // `__trap__("reason")` streams its message through the same `__print_char__`/
        // `__print_str_flush__` pair `print(<string>)` uses, so it pulls in the 4-import print
        // family exactly as a `print(...)` call does — without an arm here the two streaming calls
        // land on user function indices, invalid wasm with `vl check` rc 0. Arity-gated: a bare `__trap__()` lowers to `unreachable` alone and streams nothing, so reserving for it would be four unused imports.
        if pcallee.identName == "__trap__" {
          if pn.callArgs.length == 1 { gImports = 4 }
        }
        // A numeric-opcode intrinsic yields a scalar the annotation scan below cannot see:
        // `f64bits(x)` is an i64 and `f32fromBits(b)` an f32 in a program that may spell neither type
        // anywhere. Read the call's own recorded type, so the print router never routes to an undeclared import.
        if isNumIntrinsicName(pcallee.identName) {
          const iscal = repNodeScalarMask(pscan)
          if iscal >= 0 {
            if (iscal & REP_SCAL_I64) != 0 { sawI64Ann = true }
            if (iscal & REP_SCAL_F64) != 0 { sawF64 = true }
            if (iscal & REP_SCAL_F32) != 0 { sawF32 = true }
          }
        }
      }
      // `s.bytes()` yields a `u8[]`. It is the one producer of a packed byte list that spells no
      // `u8[]` anywhere — the annotation scan matches a type, and `for b in s.bytes()` has none — so
      // without this the `ba8`/`bl8` pair is never minted and `struct.new $bl8` names a heap type
      // that does not exist. Matched on the property name alone, deliberately: over-forcing is a pair of unused 3-byte types, under-forcing is invalid wasm.
      if pcallee is Member {
        if pcallee.memProp == "bytes" { ba8Used = true }
      }
    }
    // A FLOAT `%` reserves the `__f64_rem__` helper (D1586). The node's own recorded type
    // decides it: `%` yields the WIDER operand's type, so a float result is exactly a float
    // operand. `binRemFloatNeed` is the three-answer vocabulary, its own header says why.
    if pn is BinExpr {
      if pn.binOp == "%" {
        const rneed = binRemFloatNeed(pscan)
        if rneed > 0 { sawFloatRem = true }
        else if rneed < 0 { sawRemUnknown = true }
      }
    }
    // Any type annotation containing an i64/f64/f32 leaf anywhere — bare, `T[]` element, union
    // member, map value, closure result, struct field, nullable inner — flags the program as
    // using that scalar. Combined with `print`, it pulls in the matching `__print_*__` import: an
    // over-approximation (an unused import is harmless) is fine, a missed flag is invalid wasm.
    if pn is TypeRef {
      // Exact containment via the checker's recorded type (`repTyScalarMask` walks the `Ty` arena
      // transitively, terminating on recursive types), so an alias whose name never spells the
      // scalar (`type Big = i64`) still flags it. Only a node with no recorded type falls back to the name-substring test, which sees exactly what the synthesis spelled.
      const scal = repNodeScalarMask(pscan)
      if scal >= 0 {
        if (scal & REP_SCAL_I64) != 0 { sawI64Ann = true }
        if (scal & REP_SCAL_F64) != 0 { sawF64 = true }
        if (scal & REP_SCAL_F32) != 0 { sawF32 = true }
      } else {
        // No recorded type — the parser's spelling tree answers instead of the rendering.
        // `tsMentionsAnyName` walks the annotation the author actually wrote and compares each leaf
        // whole, unlike the `strContains` substring test it replaces (which matched a field named
        // `f64mode` or a type named `Bf64`). The corpus cannot distinguish the two readers, so this rests on the whole-leaf argument alone, not a graded signal.
        const tsRoot = annTsOf(pscan)
        if tsRoot >= 0 {
          if tsMentionsAnyName(tsRoot, ["i64"]) { sawI64Ann = true }
          if tsMentionsAnyName(tsRoot, ["f64"]) { sawF64 = true }
          if tsMentionsAnyName(tsRoot, ["f32"]) { sawF32 = true }
        } else {
          // Neither a recorded type nor a spelling tree. Flags all three rather than none: this scan is
          // an over-approximation by design — a spare import is harmless, a missed flag is invalid wasm.
          sawI64Ann = true
          sawF64 = true
          sawF32 = true
        }
      }
    }
    // A float `.` literal flags the program as f64-using (the checker types it f64).
    // An INTEGER literal past the i32 range flags it as i64-using (the checker
    // types it i64 — the host `defaultIntegerType` rule), so `print(0xDEAD_BEEF)`
    // pulls in the `__print_i64__` import even with no `i64` annotation.
    if pn is NumLit {
      if numLexIsFloat(pn.numText) { sawF64 = true }
      else if !numLexFitsI32(pn.numText) { sawI64Ann = true }
    }
    // An explicit `x as T` cast target rides as a string field (`asTy`), not a `TypeRef` node, so
    // the annotation scan above misses it. Flag its scalar directly, or `print(x as i64)`/`print(x as f64)` would route to an undeclared import.
    if pn is AsExpr {
      // Arena first, exactly as the `TypeRef` arm above does — the fallback here is a substring
      // scan over `asTy`, a rendered type name, kept for a node the checker did not record. The
      // substring form is also wider than it reads: `strContains(t, "i64")` matches any name containing those characters — a field named `i64x`, an alias whose spelling embeds it — where the arena asks the cast's own recorded type and cannot be fooled.
      const ascal = repNodeScalarMask(pscan)
      if ascal >= 0 {
        if (ascal & REP_SCAL_I64) != 0 { sawI64Ann = true }
        if (ascal & REP_SCAL_F64) != 0 { sawF64 = true }
        if (ascal & REP_SCAL_F32) != 0 { sawF32 = true }
      } else {
        if strContains(pn.asTy, "i64") { sawI64Ann = true }
        if strContains(pn.asTy, "f64") { sawF64 = true }
        if strContains(pn.asTy, "f32") { sawF32 = true }
      }
    }
    pscan = pscan + 1
  }
  // D1586 — the float-remainder helper. A `%` with no recorded type is only counted when
  // the module mentions a float somewhere, which is what keeps an integer-only program's
  // bytes unchanged; the flags this reads are final only now, hence after the loop.
  gNeedsF64Rem = sawFloatRem || (sawRemUnknown && (sawF64 || sawF32))
  // An extern's own RESULT width is a scalar the annotation scan cannot see: `print(nowMillis())`
  // spells `i64` nowhere, and without this the print router would call an undeclared import.
  // Read off the manifest, which is total, exactly as `fsRetIsI64` is for the fs floor.
  let exw = 0
  while exw < externCount() {
    const exwR = externRetAt(exw)
    if exwR == "i64" { sawI64Ann = true }
    if exwR == "f64" { sawF64 = true }
    if exwR == "f32" { sawF32 = true }
    exw = exw + 1
  }
  // When the program both prints (`gImports == 4`, the print family) and names
  // an i64 type, add the 5th `__print_i64__` import.
  if gImports == 4 {
    if sawI64Ann {
      gImports = gImports + 1
      gNeedsI64Print = true
    }
    // Then `__print_f64__` (at the next index — 4 or 5). The f64 import always
    // trails the i64 one so the i64 print index (4) is unchanged. (Slice 3.)
    if sawF64 {
      gF64PrintIdx = gImports
      gImports = gImports + 1
      gNeedsF64Print = true
    }
    // Then `__print_f32__` (at the next index — 4/5/6). It always TRAILS the i64 and
    // f64 imports so their indices are unchanged. (Slice 5.)
    if sawF32 {
      gF32PrintIdx = gImports
      gImports = gImports + 1
      gNeedsF32Print = true
    }
  }
  // The fs imports trail the entire print family — the four fixed entries and all three
  // conditional wide-scalar ones — so no print index ever moves, and within the block they run
  // in slot order over the used slots only (slots are append-only, so adding a syscall never
  // moves an earlier one's index). Outside the `gImports == 4` guard on purpose: by the time this runs `gImports` is 4..7, not 4.
  let fsa = 0
  while fsa < gFsUse.length {
    if gFsUse[fsa] == 1 {
      gFsIdx[fsa] = gImports
      gImports = gImports + 1
    }
    fsa = fsa + 1
  }
  // The user externs trail everything: the print family (whose 0..3 the call lowering hardcodes)
  // and the fs floor. An extern occupies an index, so a program that declares one but does not
  // print still reserves the four print entries — every host provides them already.
  if externCount() > 0 {
    if gImports == 0 { gImports = 4 }
    let exa = 0
    while exa < externCount() {
      gExtIdx[exa] = gImports
      gImports = gImports + 1
      exa = exa + 1
    }
  }
  0
}

// Every function's parameters must be i32 or the struct type before we commit.
function checkFnParams() {
  let i = 0
  while i < fnStmts.length {
    if checkParams(fnStmts[i]) < 0 { return -1 }
    i = i + 1
  }
  0
}

// Dispatch one pass-table row by name. Every pass returns an i32 status (< 0 =
// failed emit). The `#2` rows are the explicit re-run stage — each branch calls
// the same pass function a second time, post-monomorphization.
function runEmitPass(name: string, stmts: i32[], rootIx: i32) {
  if name == "collectTyParams" { return collectTyParamNames() }
  if name == "collectU" { return collectU(stmts) }
  if name == "collectS" { return collectS(stmts) }
  if name == "collectA" { return collectA(stmts) }
  if name == "collectFns" { return collectFns(stmts) }
  if name == "checkTopLevel" { return passCheckTopLevel() }
  if name == "buildFnMap" { return buildFnMap(stmts) }
  if name == "computeVoidFns" { return computeVoidFns() }
  if name == "computeRetInference" { return computeRetInference() }
  if name == "dispatchRewrite" { return dispatchRewrite(stmts) }
  if name == "captureBoxRewrite" { return captureBoxRewrite(stmts) }
  if name == "synthRetAnnots" { return synthRetAnnots() }
  if name == "synthNulListRetAnns" { return synthNulListRetAnns() }
  if name == "synthDstPinAnns" { return synthDstPinAnns(rootIx) }
  if name == "scanArrLitCommit" { return scanArrLitCommit(rootIx) }
  if name == "monomorphize" { return monomorphize(stmts) }
  if name == "collectGenAliasShapes" { return collectGenAliasShapes() }
  if name == "collectAnnShapes" { return collectAnnShapes() }
  // Re-run stage: instance-pinned annotations minted during monomorphization (`Box<i32>`
  // applications, structural returns) postdate the first arena scans, so this rescans them and
  // refreshes the name→index tables that resolve against the struct table. All four are idempotent and usage-gated (no new `TypeRef` means no new shape means identical bytes).
  if name == "collectA#2" { return collectA(stmts) }
  if name == "synthGlobalEmptyListAnns" { return synthGlobalEmptyListAnns() }
  if name == "synthVoidTwins" { return synthVoidTwins(stmts) }
  if name == "buildFnMap#2" { return buildFnMap(stmts) }
  if name == "synthParamAnnots" { return synthParamAnnots() }
  if name == "computeVoidFns#2" { return computeVoidFns() }
  if name == "computeRetInference#2" { return computeRetInference() }
  if name == "collectMapFilterUse" { return collectMapFilterUse() }
  if name == "collectFnValUse" { return collectFnValUse() }
  if name == "collectCloSigs" { return collectCloSigs() }
  if name == "scanPrintUse" { return scanPrintUse() }
  if name == "checkFnParams" { return checkFnParams() }
  if name == "capCacheBuild" { return capCacheBuild() }
  if name == "capNarrowBuild" { return capNarrowBuild() }
  if name == "capNarrowBuild#2" { return capNarrowBuild() }
  if name == "synthCaptureEmptyListAnns" { return synthCaptureEmptyListAnns() }
  emitFail("emitProgram: unknown pass in the pass table: " + name)
}

// ── the sid-keyed table reset — paired with `symbols.sidReset` at every site ──
// The driver calls this beside every `sidReset()`. `globalIndexBySid`/`fnIndexBySid` are
// rebuilt inside `emitProgram`, so between one program's end and the next's collect pass the
// rows are stale. A string-keyed table survived that (program N+1 had to reuse a spelling); a sid-keyed dense array collides on a number from 0, so the collision is close to certain.
export function sidKeyedTablesReset() {
  // The hash-consed structural-identity table is sid-keyed too — `HC_PRIM` holds the
  // primitive keyword's sid and `HC_OBJ` its field names' — so it resets here, which is
  // what this function exists to be: the one home for that pairing.
  hcReset()
  globalIndexBySid = []
  fnIndexBySid = []
  nestedNameBySid = []
  sidResetParentLet()
  sidResetStartBlockLet()
  0
}

export function emitProgram(rootIx: i32) {
  // Must be per-compile, and is not (a filed hazard). `ba8Used` says this module mints the
  // packed-byte heap types; the indices it guards are recomputed every compile, so a
  // single-compile process never disagrees — but the LSP and the wasm test harness drive many
  // compiles through one instance, where the flag survives from an earlier program while the indices do not. Its siblings (`aUsed`, `fa64Used`, …) share the shape and are not reset; only this one has a witness.
  ba8Used = false
  fa32Used = false
  fa64Used = false
  ia64Used = false
  // Same per-compile rule as `ba8Used` above, and the same failure if it is skipped: the
  // helper INDEX is recomputed every compile while a surviving `true` would declare a
  // `__f64_rem__` this module's tail never emits. `scanPrintUse` writes it (D1586).
  gNeedsF64Rem = false
  // The module-predicate memo (`moduleHasUnionAs`/`moduleHasNumCast`) is keyed on an arena
  // prefix, so it needs the same per-compile clear: the next program's arena can be longer
  // than this one's, and a surviving `…Seen` would start the scan inside a prefix that
  // belongs to nobody. Cleared here, not beside `P.nodes = []`, since every read is inside `emitProgram`.
  modUnionAsSeen = 0
  modUnionAsHit = false
  modNumCastSeen = 0
  modNumCastHit = false
  // ── the arena-index sidecar reset (method note 7) ──
  // Every column below holds indices into the checker's `T.tys`, which a fresh program rebuilds
  // from scratch. Each also has its own reset inside the collect pass that clears the name
  // column it parallels, but a stale index dereferences into program N's re-minted arena and traps, where a stale name is merely wrong text — so these are emptied here, ahead of every pass.
  mvValTyIx = []        // map-VALUE type per mv slot        [collectA]
  rlElemTyIx = []       // ref-list ELEMENT type per slot    [collectA]
  annRlSlot = []        // ref-list ROW per annotation node  [collectA] — node ixs are
  annRlNul = []         // ...and that row's `| null` flag              stable, ROWS are not
  arrLitCommitName = [] // committed element name per ArrayLit [scanArrLitCommit]
  sTyIx = []            // arena type a struct ROW came from [collectS]
  sRowDecl = []         // was the row DECLARED, banked at its mint [collectS]
  // Ordering already covers this one (`collectTyParams` is pass-table row 0), but the
  // column belongs with the other per-program sidecars for the reason this block's header
  // gives: the safety should be structural, not a property of the pass order.
  genTyParamNames = []  // FuncDecl type-parameter names  [collectTyParams]
  genTyParamSeen = 0    // ...and the arena prefix that list covers
  sFieldElemTyIx = []   // a struct FIELD's element type     [collectS]
  uFieldElemTyIx = []   // a VARIANT field's element type    [collectU]
  sFieldElemKeyI32 = [] // a struct FIELD's map KEY rep    [collectS]
  uFieldElemKeyI32 = [] // a VARIANT field's map KEY rep   [collectU]
  unMemTyStart = []     // union MEMBER types per row        [collectU]
  unMemTyCount = []
  unMemTys = []
  unMemAtoms = []       // the member-REFERENCE columns      [collectU]
  unMemAtomIds = []
  unMemKinds = []
  msPoolReset()         // the member SETS interned over those columns
  // The if-expression arm blocks whose prelude locals the collect pass allocated. Arena node
  // indices, so it is the same hazard as the columns above and worse: a stale index that happens
  // to name a node in program N grants the emitter permission to lower a prelude with no allocated locals, claiming another binding's slot.
  armPreludeBlocks = []
  emitFailed = false
  emitErr = ""
  // Fresh per program: the diagnostic anchor + the "function being lowered"
  // cursor. A failure before any function body emits leaves these -1 (positionless).
  emitErrAt = -1
  emitCurFnIx = -1
  emitCurFnPos = -1
  emitCurStmtIx = -1
  // The VALIDATE diagnostic's function spans (D1578) — ARENA indices and offsets into
  // THIS program's module, so a row surviving onto the next program on a shared instance
  // would name another program's node at another module's offset.
  emitFnSpanNode = []
  emitFnSpanPos = []
  emitFnSpanStart = []
  emitFnSpanEnd = []
  emitFnSpanKind = []
  emitFnSpanTag = []
  narrowNames = []
  narrowVariants = []
  narrowTys = []
  narrowSets = []
  narrowRetired = []
  narrowTop = 0
  // The capture cache is only valid for a FINAL AST — drop it before the
  // rewrite/monomorphize passes run (they mutate bodies and `fnStmts` slots).
  capCacheOn = false
  // The in-flight map-return stack holds `fnStmts` positions, the same arena-keyed index this
  // block exists to stop leaking across programs. It is push/pop-balanced
  // (`inferredRetMapSlot` has no early return), so it is already empty here; clearing it makes that a property of the reset rather than of every rung below it.
  resetRetMapFlight()
  // The module scope, for the classifiers that walk a SCOPE instead of the whole arena
  // (D661). Written here for the same reason every column above is cleared here: it is an
  // ARENA index, so a value surviving into the next program on a shared instance names a
  // node that program never minted.
  emitRootIx = rootIx
  postMonoShapes = false
  // D882 — the `??`-merge row redirect is armed at `emitModule`, not here. Cleared beside
  // `postMonoShapes` for the same reason: a flag left set by the previous program on a shared
  // instance would arm it over the next program's whole pass table. See `anonLeafEmitPhase`.
  anonLeafEmitPhase = false
  if rootIx < 0 { return emitFail("emitProgram: empty arena (root index < 0)") }
  const root = P.nodes[rootIx]
  if root is Program {
    const stmts = root.progStmts
    // No floor on an empty statement list, for `passCheckTopLevel`'s reason one stage earlier
    // (D1080). A zero-byte or comment-only file parses to a `Program` with no statements — the
    // empty module, valid wasm, already accepted by `vl check`. This site and the pass above are two sentences for one refusal; only this one has no declaration to look at.
    resetLitAtoms()
    resetParentLetCache()
    // The repOf scratch (visited stamps + component-mask memo) is keyed by
    // `Ty`-arena index — stale across programs, since the arena is re-minted
    // per compile.
    repReset()
    // The ordered pass table — see the pass-manager block comment above `passDoneHas` for the row
    // grammar. Each row's `>` dependency is an ordering edge, in three shapes: a pass that
    // mutates the arena runs before every pass that scans it (`dispatchRewrite`,
    // `captureBoxRewrite`, the synth-annotation passes, `monomorphize`); a pass needing a final arena runs after all of them; and a `#2` row re-scans what monomorphization's late-minted annotations invalidated.
    const passTable = [
      "collectTyParams",
      "collectU > collectTyParams",
      "collectS > collectU collectTyParams",
      "collectA > collectS collectTyParams",
      "collectFns > collectU collectS",
      "checkTopLevel > collectFns",
      "buildFnMap > collectFns",
      "computeVoidFns > buildFnMap",
      "capNarrowBuild > buildFnMap",
      "computeRetInference > buildFnMap computeVoidFns capNarrowBuild",
      "dispatchRewrite > buildFnMap computeRetInference",
      "captureBoxRewrite > collectFns",
      "synthRetAnnots > collectU buildFnMap",
      "synthNulListRetAnns > collectFns computeRetInference",
      "synthDstPinAnns > collectU buildFnMap dispatchRewrite",
      "scanArrLitCommit > collectU buildFnMap synthDstPinAnns",
      "monomorphize > dispatchRewrite captureBoxRewrite synthRetAnnots synthNulListRetAnns synthDstPinAnns scanArrLitCommit",
      "collectGenAliasShapes > monomorphize",
      "collectAnnShapes > monomorphize",
      "collectA#2 > collectGenAliasShapes collectAnnShapes",
      "synthGlobalEmptyListAnns > collectA#2 collectFns",
      "synthVoidTwins > collectFns monomorphize",
      "buildFnMap#2 > monomorphize collectA#2 synthVoidTwins",
      "synthParamAnnots > monomorphize buildFnMap#2",
      "computeVoidFns#2 > synthParamAnnots",
      "capNarrowBuild#2 > synthParamAnnots",
      "computeRetInference#2 > synthParamAnnots computeVoidFns#2 capNarrowBuild#2",
      "collectMapFilterUse > synthParamAnnots computeRetInference#2",
      "collectFnValUse > synthParamAnnots computeRetInference#2",
      "collectCloSigs > collectMapFilterUse collectFnValUse",
      "scanPrintUse > monomorphize synthParamAnnots",
      "checkFnParams > monomorphize synthParamAnnots",
      "capCacheBuild > monomorphize synthParamAnnots",
      "synthCaptureEmptyListAnns > collectA#2 capCacheBuild",
    ]
    // synthVoidTwins mints the void twins for coerced function VALUES — after
    // mono (`fnStmts` positions are final; the twin table stores them) and
    // before `buildFnMap#2`, whose `retVoidAnnFlag` seed classifies the twins.

    // Last, and the two edges say why. `collectA#2` is the same prerequisite
    // `synthGlobalEmptyListAnns` carries — the synthesis resolves a ref-list row and never mints
    // one, so the intern pass must have already run — and `capCacheBuild` is the pass that makes
    // the capture lists this walks final. It runs before `emitModule` because the section that reads the annotation (the type section's env structs, here) is emitted after it.

    const passDone: string[] = []
    let pi = 0
    while pi < passTable.length {
      const prow = passTable[pi]
      const pname = passRowName(prow)
      if !passNeedsMet(passRowNeeds(prow), passDone) {
        return emitFail(
          "emitProgram: pass " +
            pname +
            " ran before a prerequisite (pass table reordered)",
        )
      }
      if runEmitPass(pname, stmts, rootIx) < 0 { return -1 }
      // Every shape interned from here on is an instance's RE-SPELLING, not an author's
      // type — see `postMonoShapes`.
      if pname == "monomorphize" { postMonoShapes = true }
      passDone.push(pname)
      pi = pi + 1
    }
    // D882 — the mint is over. From here a `??`-joined literal resolves to the merged row at
    // every reader (`anonLeafJoinRowOf`); before here `collectAnonShapes` needs the pre-merge answer to decide what to mint.
    anonLeafEmitPhase = true
    const rc = emitModule(stmts)
    if rc < 0 { return rc }
    // An `emitFail` whose -1 a deep helper swallowed (e.g. inside a valtype write)
    // must still fail the WHOLE emit: a failed module never reaches instantiation.
    if emitFailed { return -1 }
    // The rep-tree differential harness (debug-only; a no-op unless the host
    // armed `setRepShadow`) — swept HERE because the arena is final now.
    repShadowSweep()
    // The union registry's own equivalence sweep (SPIKE, same arming, same once-per-program
    // window — see `unionRegistryABSweep`). A no-op unless the harness is armed.
    unionRegistryABSweep()
    return rc
  }
  emitFail("emitProgram: root node is not a Program")
}

// Emits one shared-runtime-helper functype (`0x60 func`, params, results) onto the current
// buffer. `params`/`res` are valtype descriptor strings, one char per slot: 'i' = i32, 'a' =
// a non-null `(ref $aTypeIdx)` i32-array ref, 's' = a non-null `(ref $sTypeIdx)` string ref,
// 'm' = a non-null `(ref $mkArrIdx)` string-list backing ref — a wrong functype on any of the six helpers is a call-site type mismatch at every use.
function helpFuncType(params: string, res: string) {
  wU8(96) // 0x60 func
  wULEB(params.length)
  let i = 0
  while i < params.length {
    helpValtype(params[i])
    i = i + 1
  }
  wULEB(res.length)
  let j = 0
  while j < res.length {
    helpValtype(res[j])
    j = j + 1
  }
  0
}

// One descriptor char (see `helpFuncType`) as a valtype.
function helpValtype(c: i32) {
  if c == 'i' {
    wU8(127) // 0x7f i32
    return 0
  }
  if c == 'f' {
    // 'f' = f64 — `__f64_rem__`'s two operands and its result (D1586). The only SCALAR
    // descriptor besides 'i', and the reason the two are handled before the ref block:
    // everything below writes a `(ref ht)` prefix and an index, which a number has none of.
    wU8(124) // 0x7c f64
    return 0
  }
  wU8(100) // 0x64 (ref ht) — non-null
  if c == 'm' {
    wSLEB(mkArrIdx)
  } else if c == 's' {
    wSLEB(sTypeIdx)
  } else if c == 'b' {
    // 'b' = the string's backing, `(ref $sBackIdx)` — distinct from 'a' in storage type (packed
    // i8, not i32). `__utf8_dec__` is the only helper that takes one; naming 'a' here would be a call-site type mismatch.
    wSLEB(sBackIdx)
  } else if c == 'y' {
    // 'y' = the `u8[]` WRAPPER, `(ref $bl8TypeIdx)` — `__str_bytes__`'s result.
    wSLEB(bl8TypeIdx)
  } else {
    wSLEB(aTypeIdx)
  }
  0
}

// Read a `;`-terminated decimal index following a ref `$fnsig` token (`s3;`, `r0;`),
// starting at `i` (the first digit). Returns the parsed index; `outNext` receives the
// position just past the `;`. The token scheme (`repSigTokOfKind`/`repKindOfSigTok`)
// terminates every index-carrying ref token with `;`, so the loop is bounded.
function synthSigIdxAt(key: string, i: i32, outNext: i32[]) {
  let idx = 0
  let j = i
  while j < key.length && key[j] != ';' {
    idx = idx * 10 + (key[j] - '0')
    j = j + 1
  }
  outNext.push(j + 1) // skip the ';'
  idx
}

// True if a `$fnsig` token char carries a `;`-terminated index — the ref shapes whose
// functype valtype needs a heap slot. Decodes through the ONE token vocabulary
// (`repKindOfSigTok` → `repSigTokHasSlot`), so a new slot-carrying kind cannot be added
// to the encoders without this parser skipping its digits correctly.
function synthSigTokHasIdx(c: i32) { repSigTokHasSlot(repKindOfSigTok(c)) }

// Emit ONE `$fnsig` functype — pool position `sai`'s bytes, and nothing else. Split out
// of `emitTypeSection`'s pool loop so that loop can render an entry, MEASURE it, and
// compare it against the entries already written (D351's twin column) without a second
// render or a scratch copy.
function emitCloSigFunctype(sai: i32) {
  const repFe = cloSigRepFn[sai]
  // A union-arm / annotation signature with NO concrete closure (`collectCloSigs`
  // interned it from a bare `(…)=>…` type) carries the -1 rep sentinel: synthesize
  // its functype from the KEY string (the same bytes the rep path emits for that key).
  if repFe < 0 { return emitSynthCloSig(cloSigKeys[sai]) }
  const rep = P.nodes[fnStmts[repFe]]
  if rep is FuncDecl {
    const rparams = rep.fnParams
    wU8(96)                   // 0x60 func
    wULEB(rparams.length + 1) // env + declared params
    wU8(107)                  // param 0 env: structref (0x6b)
    let pj = 0
    while pj < rparams.length {
      fbValtype(vtKindOfParam(rparams[pj]), paramStructIdxOf(rparams[pj]))
      pj = pj + 1
    }
    // The RESULT must byte-match the rep function's own functype result so
    // the call site's `call_indirect $fnsig` signature check accepts the callee:
    // a VOID field-closure sig (`>v`) has 0 results; a STRUCT-returning one
    // (`>sN;`) yields the struct ref exactly as the function functype does.
    if fRetVoid[repFe] == 1 {
      wU8(0) // 0 results — the `>v` write-trap sig
    } else {
      wU8(1) // 1 result
      // The result valtype the rep function's OWN functype emits — scalar (i32/f64/
      // i64), string, an i32/string/f64 list, a union box, a nullable scalar/struct,
      // or a struct ref (`cloRetValKind`/`cloRetValSlot`, the shared mapping).
      const rrk = cloRetValKind(repFe)
      let rrkCode: VKind = "i32"
      if rrk != null { rrkCode = rrk }
      fbValtype(rrkCode, cloRetValSlot(repFe))
    }
  }
  0
}

// Emits one `$fnsig` functype synthesized purely from its interned key string — the path for
// a signature interned from a bare union-arm/annotation function type with no concrete closure
// (`cloSigRepFn` sentinel -1). The bytes match exactly what the rep path emits for the same
// key, since both stream valtypes through the same `fbValtype`, and a key token's trailing index is the `fbValtype` heap slot by construction.
function emitSynthCloSig(key: string) {
  // Not a type-name grammar (D-CLASSGRAM). The `>` below is the `$fnsig` key's param/result
  // separator — a character in the ABI token alphabet on a string the compiler minted token by
  // token, not a rendered type; routing it to the generic-application `<`-scan would be a
  // category error. Nor is it the ABI family's own last-`>` home (`sigKeyRetTokIx`): un-exported, its span rule is the last `>` where this walk wants the first.
  let gi = 0
  while gi < key.length && key[gi] != '>' { gi = gi + 1 }
  // Pass 1 — count params (advance token by token over `key[0..gi)`).
  let nparams = 0
  let ci = 0
  while ci < gi {
    if synthSigTokHasIdx(key[ci]) {
      ci = ci + 1
      while ci < gi && key[ci] != ';' { ci = ci + 1 }
      ci = ci + 1 // skip ';'
    } else {
      ci = ci + 1
    }
    nparams = nparams + 1
  }
  wU8(96)            // 0x60 func
  wULEB(nparams + 1) // env + declared params
  wU8(107)           // param 0 env: structref (0x6b)
  // Pass 2 — emit each param's valtype.
  let pi = 0
  while pi < gi {
    const pc = key[pi]
    const pk = repKindOfSigTok(pc)
    let pkc: VKind = "i32"
    if pk != null { pkc = pk }
    let pidx = -1
    if synthSigTokHasIdx(pc) {
      const nx: i32[] = []
      pidx = synthSigIdxAt(key, pi + 1, nx)
      pi = nx[0]
    } else {
      pi = pi + 1
    }
    fbValtype(pkc, pidx)
  }
  // Result — a `>v` (void field-closure) sig has 0 results; else the single result token.
  const ri = gi + 1
  if ri < key.length && key[ri] == 'v' {
    wU8(0)
  } else {
    wU8(1)
    const rc = key[ri]
    const rk = repKindOfSigTok(rc)
    let rkc: VKind = "i32"
    if rk != null { rkc = rk }
    let ridx = -1
    if synthSigTokHasIdx(rc) {
      const rnx: i32[] = []
      ridx = synthSigIdxAt(key, ri + 1, rnx)
    }
    fbValtype(rkc, ridx)
  }
  0
}

// Type section (id 1): all WasmGC types in one recursion group, followed by the standalone
// print/log functypes — the rec-group count excludes those. One function's `0x60` functype,
// written to the type payload: `withEnv` decides the hidden leading `structref`, every other
// byte the same either way. Called twice per exported function (#1265) — internal env-leading and published clean-ABI — so they are one function, not a copy, to keep them from drifting.
function emitOneFuncType(ti: i32, withEnv: boolean) {
  const fn = P.nodes[fnStmts[ti]]
  if fn is FuncDecl {
    const params = fn.fnParams
    const nParams = params.length
    wU8(96) // 0x60 func
    // When a function value exists module-wide, EVERY function carries a hidden
    // leading `structref env` param (local 0). The declared params follow at 1..p.
    // A non-capturing function ignores its env; a capturing one `ref.cast`s + reads
    // it. Gated on `fnValUsed` so a no-lambda module's functypes are unchanged.
    if withEnv {
      wULEB(nParams + 1) // param count incl. the env param
      wU8(107)           // env param: structref (0x6b)
    } else {
      wULEB(nParams) // param count
    }
    let pi = 0
    while pi < nParams {
      fbValtype(vtKindOfParam(params[pi]), paramStructIdxOf(params[pi]))
      pi = pi + 1
    }
    if fRetVoid[ti] == 1 {
      wU8(0) // 0 results — a VOID function (`()->()`)
    } else if fn.fnRet < 0 && fnReturnsClosure(ti) {
      // A function VALUE return (un-annotated; its tail is a function value) — kind 14.
      wU8(1)
      fbValtype("closure", -1)
    } else if fn.fnRet < 0 {
      // UN-ANNOTATED return: the INFERRED kind (computeRetInference set the same
      // stored `fRetKind` slot the annotation path fills). i32 when nothing matched.
      wU8(1) // 1 result
      // The inferred result kind from the single shared mapping (`inferredRetKindCore`), so this
      // site and `cloRetValKind` cannot drift on a scalar/list/ref kind. The slot follows the kind:
      // struct index for a struct/nullable-struct ref, the element wrapper for a ref list, the map
      // shape for a map; every other kind needs no per-function slot.
      const infKind = inferredRetKindCore(ti)
      let infSlot = -1
      if infKind == "struct" || infKind == "nulstruct" {
        // D871 — the `??` merge redirect, on the INFERRED half of the signature. See
        // `fnRetStructIndexSid`, which is the reader this result valtype has to agree with.
        infSlot = fRetStructIdx[ti]
        if anonLeafRetMovedOf(fnStmts[ti]) {
          infSlot = anonLeafSupersedeOf(infSlot)
        }
      }
      if infKind == "reflist" { infSlot = rlSlotByName(fRetRArrElem[ti]) }
      // A concrete-variant inferred result (kind 8) — the variant index, from the same companion
      // column the struct kinds read. The annotated path below has carried the variant through
      // `retStructIndex` all along; the inferred half had no arm and resolved -1, which
      // `fbValtype`'s bounds guard would turn into a loud `ref valtype with no interned shape` rather than a wrong heap type.
      if infKind == "variant" { infSlot = fRetStructIdx[ti] }
      // D1562 — the nullable-variant twin, from the same companion column, and the signature half
      // of the pair `cloRetValSlot` answers at the call site. The annotated ladder further down carries it through `nulVariantIndexOf`; the inferred half had no arm, so `fbValtype` took -1 and refused the module at check rc 0.
      if infKind == "nulvariant" { infSlot = fRetStructIdx[ti] }
      // A map/nullable-map result carries its value shape, from the one home that also seeds the
      // constructor inside the body (`inferredRetMapSlot`): the assignment cell's shape for an
      // implicit-return assignment, the return expression's otherwise. The `nulmap` half had no arm and defaulted to -1.
      if infKind == "map" || infKind == "nulmap" {
        infSlot = inferredRetMapSlot(ti)
      }
      fbValtype(infKind, infSlot)
    } else {
      wU8(1) // 1 result
      // A `T[]` return is kind 5 — its second `fbValtype` arg is the ref-list TABLE
      // SLOT for the element type (`retStructIndex` is -1 for a ref array), so the
      // result valtype selects THIS function's element wrapper, not slot 0's.
      let retSlot = retStructIndex(fn.fnRet)
      // The `??` merge redirect, on the annotated half of the signature: gated so that
      // `retStructIndex`'s answer really is a struct-table row, the same gate the call-result
      // reader makes. D911 — the gate is the kind, not `retNulRefFlag`: a nested argument
      // (`src(mk())`) reaches one frame further in than the `S | null` population, where this signature stayed narrow while `fnRetStructIndexSid` already answered merged (`d891_bound_nested_arg`).
      const rk = vtKindOfType(fn.fnRet)
      if rk == "struct" || rk == "nulstruct" {
        if anonLeafRetMovedOf(fnStmts[ti]) {
          retSlot = anonLeafSupersedeOf(retSlot)
        }
      }
      if retRefArrFlag(fn.fnRet) == 1 { retSlot = tyAnnRefListSlot(fn.fnRet) }
      // A NULLABLE ref-array return (`<ref-array> | null`, kind 18) — its slot is the INNER
      // ref-list element wrapper (`tyAnnRefListSlot` strips the `| null` before resolving), so the
      // `(ref null $wrapper)` result valtype selects THIS function's element wrapper.
      if retNulRefArrFlag(fn.fnRet) == 1 {
        retSlot = tyAnnRefListSlot(fn.fnRet)
      }
      // A string-keyed MAP return's slot is the map SHAPE (mono ⇒ -1, or the value type's mv
      // slot for a `string`-valued map), so the result valtype selects THIS map's `$mapStruct`.
      if retMapFlag(fn.fnRet) == 1 { retSlot = mapAnnShape(fn.fnRet) }
      // A NULLABLE map return (`{[string]: V} | null`, kind `nulmap`) — the SAME map SHAPE selects
      // its `(ref null $mapStruct)` result valtype (`mapAnnShape` is `| null`-aware).
      if retNulMapFlag(fn.fnRet) == 1 { retSlot = mapAnnShape(fn.fnRet) }
      // A `: Cat` concrete-variant return is kind 8 — its `fbValtype` slot is the VARIANT
      // index (`uVarHeap[vi]`), which `retStructIndex` (standalone structs only) misses.
      if retVariantFlag(fn.fnRet) == 1 {
        // The arena. `variantIndexOf(tyNameOf(..))` rendered the return annotation and looked the
        // rendering up in a name-keyed table; `variantRowOfTy` matches the recorded type against the
        // variant rows' own types instead — safe here because `retVariantFlag` has already
        // established the return is a concrete variant, never a union. Two variants of the same shape cannot coexist with a concrete-variant return at all — that crashes the compiler outright (#1611).
        retSlot = variantRowOfTy(nodeTyIxOf(fn.fnRet))
      }
      // A `Circle | null` return (kind `nulvariant`) — the VARIANT index under the null,
      // which the `(ref null $uVarHeap[vi])` result valtype indexes. `retStructIndex` is
      // -1 for it (`collectS` gives a variant no struct row), the same reason every
      // nullable sibling above carries its own line in this ladder.
      if retNulVariantFlag(fn.fnRet) == 1 {
        retSlot = nulVariantIndexOf(fn.fnRet)
      }
      fbValtype(vtKindOfType(fn.fnRet), retSlot)
    }
  }
}

// ── the declared-supertype graph (D622) ──
// The emitted storage of struct `si`'s field `fi`, as the (code, slot) pair `emitTypeSection`
// hands to `pushFieldStorage`. Two fields emit the same wasm field type exactly when both
// halves agree — the code alone is not the storage, since a nested-struct/ref-list/map field each carry a slot deciding which heap it points at.
function sFieldStoreCode(si: i32, fi: i32): i32 { sFieldTypeAt(si, fi) }

// Is struct row `p`'s emitted field list a proper prefix of row `c`'s — same names, same
// emitted storage, in the same positions, and strictly shorter? Names are part of it even
// though wasm only reads the storage: the edge carries the checker's structural width rule
// ("`Narrow`'s fields are the first of `Wide`'s"), and an edge between two rows that merely agree on storage would relate types the checker never meant to.
function structRowIsProperPrefix(p: i32, c: i32): boolean {
  if p < 0 || c < 0 || p == c { return false }
  if p >= sFieldCount.length || c >= sFieldCount.length { return false }
  const pn = sFieldCount[p]
  if pn == 0 { return false }
  if pn >= sFieldCount[c] { return false }
  let k = 0
  while k < pn {
    if sFieldNames[sFieldStart[p] + k] != sFieldNames[sFieldStart[c] + k] {
      return false
    }
    if sFieldStoreCode(p, k) != sFieldStoreCode(c, k) { return false }
    if sFieldStorageSlot(p, k) != sFieldStorageSlot(c, k) { return false }
    k = k + 1
  }
  true
}

// Builds `sSuper`/`sSubbed`: every representative struct row takes as its declared supertype
// the longest proper-prefix representative row in the module, or -1. Representatives only, on
// both ends — a twin shares an earlier row's heap index and has no form of its own to carry a
// `sub` or be named a parent. Longest, so the chain is transitively closed: a row's other required prefixes are prefixes of its longest one, and that row takes them in turn.
export function buildStructSupers() {
  sSuper = []
  sSubbed = []
  let i = 0
  while i < sNames.length {
    sSuper.push(-1)
    sSubbed.push(false)
    i = i + 1
  }
  let c = 0
  while c < sNames.length {
    if sTwin[c] == c {
      let best = -1
      let bestLen = 0
      let p = 0
      while p < sNames.length {
        if sTwin[p] == p {
          if structRowIsProperPrefix(p, c) {
            if sFieldCount[p] > bestLen {
              best = p
              bestLen = sFieldCount[p]
            }
          }
        }
        p = p + 1
      }
      if best >= 0 {
        sSuper[c] = best
        sSubbed[best] = true
      }
    }
    c = c + 1
  }
  0
}

function emitTypeSection(
  n: i32,
  typeOffset: i32,
  hasStart: i32,
  memFn: i32,
  nPrintTypes: i32,
  nHelpers: i32,
) {
  const typePayload: i32[] = []
  // Bind the writer at `typePayload` for the WHOLE type-section payload build, so the
  // raw framing bytes, `pushFieldStorage`, and `fbValtype` all stream to `curBuf ==
  // typePayload` identically. Restored just before `wSection` frames it (below).
  const tyPrev = wTarget(typePayload)
  const nWrapT = exportWrapSlots().length
  wULEB(1 + nPrintTypes + memFn + nHelpers + nWrapT) // rectypes: the rec group + the standalone print/(log)/helper/export-wrapper functypes
  wU8(78)                                            // 0x4e rec group
  wULEB(n + typeOffset + hasStart)                   // types inside the rec group (print functypes excluded)
  // Twin skip, used by four of the loops below (struct/variant/ref-list pair/ref-valued map): a
  // slot whose `*Twin[i] < i` shares an earlier slot's heap type, already emitted — skip it, in
  // lock-step with the `mAssignTypeIndices` allocation that reused that earlier index, or every heap-type index from here on desyncs.
  buildStructSupers()
  if sDeclared {
    // One struct per declared type, in `structEmitOrder` — the same order `mAssignTypeIndices`
    // assigned heap indices in: declaration order except that a row waits for every proper prefix
    // of it (D622, since wasm needs a supertype's index lower than its subtype's). A field is
    // `0x7f` i32, or for a string field a non-null `(ref $sTypeIdx)` (the raw `(array i32)` string rep); both mutable.
    const eOrd = structEmitOrder()
    let eoi = 0
    while eoi < eOrd.length {
      const si = eOrd[eoi]
      if si >= 0 {
        // The declared-supertype form (D622): a row with a parent, or that is one, is written
        // with WasmGC's `0x50 sub` header instead of a bare `0x5f`, since a type without `sub`
        // is final. `(type $Wide (sub $Narrow …))` is what makes a `(ref $Wide)` acceptable at a `(ref $Narrow)` slot; a module with no proper-prefix pair emits the same bytes as before.
        const sup = sSuperAt(si)
        if sup >= 0 {
          wU8(80)  // 0x50 sub
          wULEB(1) // one supertype
          wULEB(sHeapIdx[sup])
