        // would skip the `wTarget` that unbinds it. Record the failure and write a well-formed 0-param
        // shape so the section stays parseable while it unwinds; the import entry naming this functype comes off the same slot table, so the two stay in step even on this path.
        emitFail(
          "emitProgram: fs import slot has no arity — the slot table and the arity table have drifted",
        )
        wU8(96)  // 0x60 func
        wULEB(0) // 0 params
        wULEB(1)
        wU8(127) // 0x7f i32
