        wU8(96) // 0x60 func
        wULEB(fsAr)
        let fsp = 0
        while fsp < fsAr {
          if fsArgIsU8List(fsty, fsp) {
            wU8(100) // 0x64 (ref $bl8) — a path or a payload
            wSLEB(bl8TypeIdx)
          } else {
            if fsArgIsI64(fsty, fsp) {
              wU8(126) // 0x7e i64 — a range read's byte offset
            } else {
              wU8(127) // 0x7f i32 — `__args_get__`'s index
            }
          }
          fsp = fsp + 1
        }
        // Every slot returns exactly one value: the packed wrapper, an i64 byte count,
        // or an i32 carrying 0/1 or a negative `-errno`.
        wULEB(1)
        if fsRetIsU8List(fsty) {
          wU8(100) // 0x64 (ref $bl8) — non-null, EMPTY on error
          wSLEB(bl8TypeIdx)
        } else {
          if fsRetIsI64(fsty) {
            wU8(126) // 0x7e i64 — `__fs_size__`, negative for `-errno`
          } else {
            wU8(127) // 0x7f i32
          }
        }
      }
    }
    fsty = fsty + 1
  }
  // ── the extern functypes ──
  // One `0x60` rectype per declared extern, in manifest order, standalone outside the rec group
  // for the reason the fs block above is: wasmtime will not match a rec-group member against a
  // host-provided function. Scalars only, so no heap type is ever named here.
  let exty = 0
  while exty < externCount() {
    const exAr = externArityAt(exty)
    wU8(96) // 0x60 func
    if exAr < 0 {
      // Cannot `return` — `curBuf` is bound to `typePayload` across this block. Record and write
      // a well-formed 0-param shape so the section stays parseable while the failure unwinds.
      emitFail(
        "emitProgram: extern row has no arity — the manifest and its readers have drifted",
      )
      wULEB(0)
      wULEB(0)
    } else {
      wULEB(exAr)
      let exp = 0
      while exp < exAr {
        wU8(externValType(externParamAt(exty, exp)))
        exp = exp + 1
      }
      const exR = externRetAt(exty)
      if exR == "" {
        wULEB(0)
      } else {
        wULEB(1)
        wU8(externValType(exR))
      }
    }
    exty = exty + 1
  }
  if memLogUsed {
    wU8(96)  // 0x60 func — the `__log__` decoder
    wU8(2)   // 2 params
    wU8(127) // 0x7f i32 (offset)
    wU8(127) // 0x7f i32 (length)
    wU8(0)   // 0 results
  }
  // The shared runtime helpers, in helper-index order.
  if gHelpStrHash >= 0 {
    helpFuncType("s", "i")   // __str_hash__: (str) -> i32
    helpFuncType("ss", "i")  // __str_eq__: (str, str) -> i32
    helpFuncType("ss", "s")  // __str_concat__: (str, str) -> (ref str)
    helpFuncType("bii", "i") // __utf8_dec__: (strBacking, i, end) -> (width<<24)|cp
    helpFuncType("aii", "s") // __utf8_enc__: (i32Backing, start, len) -> (ref str)
    helpFuncType("s", "i")   // __utf8_cplen__: (str) -> i32
    if ba8Used {
      helpFuncType("s", "y") // __str_bytes__: (str) -> (ref u8[])
    }
  }
  if gHelpMapProbe >= 0 {
    // __map_probe__: (keyHash, index, hashes, live, keysBacking, key) -> slot — three 'a'
    // i32 arrays, the 'm' string-list backing, then the 's' STRING key.
    helpFuncType("iaaams", "i")
    helpFuncType("aaaii", "a") // __map_resize__: (index, hashes, live, count, size) -> index'
  }
  if gHelpMapProbeI32 >= 0 {
    // __map_probe_i32__: (index, hashes, live, keysBacking, key i32) -> slot — the same
    // five operands with an i32 keys backing (`a`) and an i32 KEY (`i`).
    helpFuncType("aaaai", "i")
  }
  if gHelpF64Rem >= 0 {
    helpFuncType("ff", "f") // __f64_rem__: (f64, f64) -> f64
  }
  // The export-wrapper functypes last (#1265), one per export entry, each the target's own
  // signature emitted with `withEnv` false — the clean ABI shape, produced by the same
  // `emitOneFuncType` the main loop uses, so a wrapper's published type cannot drift from the function it forwards to. Empty unless `fnValUsed`.
  const wrapT = exportWrapSlots()
  let wti = 0
  while wti < wrapT.length {
    emitOneFuncType(wrapT[wti], false)
    wti = wti + 1
  }
  wTarget(tyPrev)
  wSection(1, typePayload)
  0
}

// The wasm valtype byte an extern's type spelling writes. The set is the checker's
// (`externScalarTy`); a spelling outside it cannot reach here, and the refusal says which of the
// two lists moved rather than writing a malformed functype.
function externValType(spelling: string): i32 {
  if spelling == "i32" { return 127 }
  // A boolean is an i32 at the boundary: the host receives 0 or 1, which is its whole ABI.
  if spelling == "boolean" { return 127 }
  if spelling == "i64" { return 126 }
  if spelling == "f32" { return 125 }
  if spelling == "f64" { return 124 }
  emitFail(
    "emitProgram: extern type `" +
      spelling +
      "` has no wasm valtype — the checker's extern type set and this writer have drifted",
  )
  127
}

function emitImportSection(n: i32, typeOffset: i32, hasStart: i32) {
  // Import section (id 2, between type and function): the 4-entry print family from
  // the host's `"imports"` module, occupying function indices 0..3 in this exact
  // order (the call lowering hardcodes them): __print_i32__, __print_bool__,
  // __print_char__ (all `(i32)->()`), __print_str_flush__ (`()->()`).
  if gImports > 0 {
    const ftI32 = typeOffset + n + hasStart
    const ftVoid = ftI32 + 1
    const ftI64 = ftVoid + 1
    // The `(f64)->()` functype index trails the i64 one when present, else the void one.
    let ftF64 = ftVoid + 1
    if gNeedsI64Print { ftF64 = ftI64 + 1 }
    // The `(f32)->()` functype index trails the f64 one when present, else wherever the
    // f64 index would be (the standalone functypes are emitted i64 → f64 → f32 in order).
    let ftF32 = ftF64
    if gNeedsF64Print { ftF32 = ftF64 + 1 }
    // The first fs functype index — one past wherever the f32 one would sit. `ftF32` is
    // "the next free index" whether or not the f32 print import exists (each of the
    // three conditionals above advances only when its own flag is set), so this
    // continues the same chain rather than re-deriving it.
    let ftFs = ftF32
    if gNeedsF32Print { ftFs = ftF32 + 1 }
    const importPayload: i32[] = []
    const imPrev = wTarget(importPayload)
    // 4 imports normally; +1 each for `__print_i64__` / `__print_f64__` / `__print_f32__`.
    let nImports = 4
    if gNeedsI64Print { nImports = nImports + 1 }
    if gNeedsF64Print { nImports = nImports + 1 }
    if gNeedsF32Print { nImports = nImports + 1 }
    // …and one per USED fs slot, counted from the same table the entries below iterate.
    nImports = nImports + fsImportCount()
    // …and one per declared extern, trailing the fs block.
    nImports = nImports + externCount()
    wULEB(nImports)
    wName("imports")
    wName("__print_i32__")
    wU8(0) // import kind: func
    wULEB(ftI32)
    wName("imports")
    wName("__print_bool__")
    wU8(0)
    wULEB(ftI32)
    wName("imports")
    wName("__print_char__")
    wU8(0)
    wULEB(ftI32)
    wName("imports")
    wName("__print_str_flush__")
    wU8(0)
    wULEB(ftVoid)
    // `__print_i64__` LAST, at function index 4 (`fbCall(4)` in the print router), so
    // the existing imports keep indices 0..3 and only this entry is conditionally added.
    if gNeedsI64Print {
      wName("imports")
      wName("__print_i64__")
      wU8(0)
      wULEB(ftI64)
    }
    // `__print_f64__` LAST, at function index `gF64PrintIdx` (4 or 5). (Slice 3.)
    if gNeedsF64Print {
      wName("imports")
      wName("__print_f64__")
      wU8(0)
      wULEB(ftF64)
    }
    // `__print_f32__` LAST, at function index `gF32PrintIdx` (4/5/6). (Slice 5.)
    if gNeedsF32Print {
      wName("imports")
      wName("__print_f32__")
      wU8(0)
      wULEB(ftF32)
    }
    // The filesystem entries last, in slot order, each at the function index `scanPrintUse`
    // recorded and each carrying the functype the type section appended for it in the same loop
    // shape, so the two orders cannot diverge without both loops being edited. `emitFail` on a
    // missing index rather than a negative ULEB: the index tables and this loop are the parallel pair this file's own discipline bound-checks.
    let fsim = 0
    while fsim < fsIntrinsicCount() {
      if fsUsedAt(fsim) {
        let fsNm = fsIntrinsicNameAt(fsim)
        if fsNm == "" {
          // Record and carry on, never `return` from here: `curBuf` is bound to `importPayload` for
          // the whole of this block, and returning early would skip the `wTarget(imPrev)` that unbinds
          // it. `emitFail` does not halt emission, so the only safe shape is a placeholder that keeps the entry count honest (written above from `fsImportCount()`) while the recorded failure unwinds the compile.
          emitFail(
            "emitProgram: fs import slot has no name — the slot table and its count have drifted",
          )
          fsNm = "__fs_unknown__"
        }
        wName("imports")
        wName(fsNm)
        wU8(0) // import kind: func
        wULEB(ftFs)
        ftFs = ftFs + 1
      }
      fsim = fsim + 1
    }
    // The user externs last, in manifest order, under their OWN module name so a host can tell a
    // user extern from a std intrinsic without a name convention. The import name is the VL name,
    // unmangled: it is the contract the author wrote (extern-design.md §3).
    let exim = 0
    while exim < externCount() {
      let exNm = externNameAt(exim)
      if exNm == "" {
        emitFail(
          "emitProgram: extern row has no name — the manifest and its count have drifted",
        )
        exNm = "__extern_unknown__"
      }
      wName("extern")
      wName(exNm)
      wU8(0) // import kind: func
      wULEB(ftFs)
      ftFs = ftFs + 1
      exim = exim + 1
    }
    wTarget(imPrev)
    wSection(2, importPayload)
  }
  0
}

function emitFunctionSection(
  n: i32,
  typeOffset: i32,
  hasStart: i32,
  memFn: i32,
  nPrintTypes: i32,
  nHelpers: i32,
) {
  // Function section (id 3): N functions; func i uses functype `typeOffset + i`. The
  // synthetic start function (if any) is the LAST entry — function index `n` — using
  // the `()->()` functype at index `typeOffset + n`.
  const funcPayload: i32[] = []
  const fnPrev = wTarget(funcPayload)
  const wrapF = exportWrapSlots()
  wULEB(n + hasStart + memFn + nHelpers + wrapF.length)
  let fi = 0
  while fi < n {
    // A function whose env-leading signature matches an interned `$fnsig` is declared
    // with that `$fnsig` functype, so a `call_indirect $fnsig` reaching it passes the
    // engine's signature check (its ACTUAL type IS `$fnsig`). Others keep their own
    // functype. Only when `fnValUsed`. (Lambdas.)
    if fnValUsed && fnSigIsClosure(fi) {
      wULEB(fnSigIdxOfFn(fi))
    } else {
      wULEB(typeOffset + fi) // functype index
    }
    fi = fi + 1
  }
  if hasStart == 1 {
    wULEB(typeOffset + n) // start fn functype index
  }
  if memLogUsed {
    // The synthetic `__log__` decoder uses the standalone `(i32,i32)->()` functype
    // emitted after the print functypes.
    wULEB(typeOffset + n + hasStart + nPrintTypes)
  }
  // The shared runtime helpers, each on its own standalone functype (emitted after
  // the `__log__` functype in the SAME helper order, so functype k belongs to
  // helper k).
  const helpTyBase = typeOffset + n + hasStart + nPrintTypes + memFn
  let hi = 0
  while hi < nHelpers {
    wULEB(helpTyBase + hi)
    hi = hi + 1
  }
  // The export wrappers LAST — after every other function, so no existing function index
  // shifts — each on its own functype, emitted in this same order at the tail of the type
  // section (`helpTyBase + nHelpers + k`).
  let wfi = 0
  while wfi < wrapF.length {
    wULEB(helpTyBase + nHelpers + wfi)
    wfi = wfi + 1
  }
  wTarget(fnPrev)
  wSection(3, funcPayload)
  0
}

function emitGlobalSection() {
  // Global section (id 6): one mutable global per top-level `let`/`const`, in declaration
  // order (that order is the global index `global.get`/`global.set` use). Each entry is
  // `<valtype> 0x01 <init constexpr> 0x0b`; a non-constexpr init fails loudly via `emitExpr`.
  // A promoted binding (G2c) emits no cell, so the count is declarations minus promoted, and survivors' indices come from `gCellIdx`, which `userGlobalIdx` is the single translation through.
  const ng = globalStmts.length
  let nCells = 0
  let nci = 0
  while nci < ng {
    if gPromoOk[nci] != 1 { nCells = nCells + 1 }
    nci = nci + 1
  }
  const np = gStrPoolTexts.length
  if nCells + np > 0 {
    const globalPayload: i32[] = []
    // Bind the writer at `globalPayload` for the WHOLE global-section payload build, so
    // the count, each entry's valtype (`fbValtype`), mutability flag, and init constexpr
    // (`fb*` opcodes) all stream to `curBuf == globalPayload`. Restored before framing.
    const gPrev = wTarget(globalPayload)
    wULEB(nCells + np)
    // The string-literal pool first (indices 0..np-1, before the user cells): each entry an
    // immutable non-null string ref whose init constexpr builds the literal once
    // (`array.new_fixed` for the packed backing, then `struct.new` for the header) — every
    // pooled literal fits the cap by construction. `array.new_fixed` and `struct.new` are both constant instructions under the GC proposal, so the pool remains one `global.get` at every use site.
    let pli = 0
    while pli < np {
      wU8(100) // 0x64 (ref $sTypeIdx) — non-null string ref
      wSLEB(sTypeIdx)
      wU8(0)   // immutable
      const pcps = cpsToUtf8(decodeStr(strToCps(gStrPoolTexts[pli])))
      let pci = 0
      while pci < pcps.length {
        fbI32Const(pcps[pci])
        pci = pci + 1
      }
      fbArrayNewFixed(sBackIdx, pcps.length)
      fbI32Const(0)           // start
      fbI32Const(pcps.length) // len
      fbStrNew()              // 0xfb 0x00 <string header>
      fbEnd()                 // 0x0b end of init expr
      pli = pli + 1
    }
    let gi = 0
    while gi < ng {
      // A PROMOTED binding (G2c) emits no cell at all: its value lives in a
      // start-function local and its initializer becomes a `local.set` there.
      if gPromoOk[gi] == 1 {
        gi = gi + 1
        continue
      }
      const g = P.nodes[globalStmts[gi]]
      if g is LetDecl {
        if g.letInit < 0 {
          return emitFail("emitProgram: module global has no initializer")
        }
        if globalIsNonConst(globalStmts[gi]) {
          // A non-constexpr init (a `global.get`+`struct.get`, a reference to another global, a call,
          // etc.) cannot be a WasmGC constant expression. Declare the cell nullable and zero-init it;
          // the synthetic start function below runs the real init via `global.set` before any other code, so reads never see the zero. The cell stays mutable.
          const ck = globalCellKind(globalStmts[gi])
          // For a ref-array cell (kind 5) the second `fbValtype`/`fbRefNullForKind` arg is the ref-list
          // table slot (`globalCellStructIdx` is -1 for a ref array), so the cell valtype and its `ref.null` zero select this global's element wrapper.
          let cs = globalCellStructIdx(globalStmts[gi])
          if ck == "reflist" { cs = globalRefListSlot(globalStmts[gi]) }
          // A NULLABLE ref-array cell (kind 18) selects THIS global's element wrapper
          // (`rlWrapIdx[slot]`) for its `(ref null …)` valtype + `ref.null` zero — the
          // nullable twin of the `reflist` slot seed.
          if ck == "nulreflist" { cs = letAnnRefListSlot(globalStmts[gi]) }
          // A map cell (kind 6) passes its map SHAPE (mv slot / -1 mono / -2 set)
          // so the cell valtype + ref.null zero select THIS map's struct type.
          if ck == "map" { cs = letMapShapeOf(globalStmts[gi], -1) }
          // A NULLABLE map cell (kind `nulmap`) passes the SAME map SHAPE — its `(ref null
          // $mapStruct)` valtype + `ref.null` zero select THIS map's struct type.
          if ck == "nulmap" { cs = nulMapShapeOf(globalStmts[gi], -1) }
          fbValtypeNullable(ck, cs) // nullable valtype
          wU8(1)                    // 0x01 mutable
          if ck == "i32" {
            fbI32Const(0) // i32 scalar zero
          } else if ck == "i64" {
            fbI64Const(0, 0) // i64 scalar zero (Slice 1)
          } else if ck == "f64" {
            fbF64Const("0.0") // f64 scalar zero (Slice 3)
          } else if ck == "f32" {
            fbF32Const("0.0") // f32 scalar zero (Slice 5)
          } else {
            fbRefNullForKind(ck, cs) // ref.null zero
          }
          fbEnd() // 0x0b end of init expr
        } else {
          // The cell's valtype comes from the binding's annotation when present, falling back to the
          // literal-init kind for an un-annotated global. The init constexpr must build the same wasm
          // type: `pendingStructIdx` seeds an `ObjLit` to the annotated struct, and
          // `pendingListKind`/`pendingListSlot` seed an empty `[]` to the annotation's ref/string list, exactly as the local-`let` path threads them.
          const gck = globalCellKind(globalStmts[gi])
          let gcs = globalCellStructIdx(globalStmts[gi])
          if gck == "struct" { pendingStructIdx = gcs }
          // A kind-8 variant cell seeds the variant context instead, so the object-literal init
          // builds the bare variant struct rather than looking for a standalone struct row that does
          // not exist. Bound, because the two ladders can disagree: `gcs` is the variant index only
          // where `globalCellStructIdx` found one, and its last rung falls through to `structIndexOfExpr` — an unbounded seed could pass a struct row's number here instead, another table's index entirely.
          if gck == "variant" {
            if gcs >= 0 && gcs < uVarHeap.length { pendingVariantIdx = gcs }
          }
          // A NULLABLE-struct cell (kind 9) seeds the same struct context: a bare
          // `null` init lowers as `ref.null $S` (a valid constexpr), a struct
          // literal as that struct.
          if gck == "nulstruct" { pendingStructIdx = gcs }
          // A nullable-variant cell seeds the variant context, for the same reason its non-null
          // sibling above does: the init literal must build the concrete variant struct `uVarHeap[vi]`
          // the cell is typed with, not a standalone struct row — there is none. Bounded for the same reason too; the bound already covers the heap read alone, and the seed itself needs the same one.
          if gck == "nulvariant" {
            if gcs >= 0 && gcs < uVarHeap.length {
              pendingVariantIdx = gcs
              pendingNulRefHeap = uVarHeap[gcs]
            }
          }
          const gcLb = letListBuild(globalStmts[gi], -1)
          pendingListKind = gcLb.lbKind
          pendingListSlot = gcLb.lbSlot
          // A DISTINCT-backing nullable scalar list cell (`i64[]|null`, `f32[]|null`, …): seed the
          // leaf list-build code so the const init builds the RIGHT wrapper (a small `i64` literal
          // would otherwise build the i32 list). This is the ONE rung of `expCtxForCell` this path
          // may take: the reset below clears no null rep, so arming one here leaks it (D1563).
          const gNulSLK = nulScalarListBuildKind(gck)
          if gNulSLK != 0 { pendingListKind = gNulSLK }
          // A ref-array cell (kind 5) passes the ref-list table slot as `fbValtype`'s second arg
          // (`globalCellStructIdx` is -1 for a ref array) so the cell valtype selects this global's
          // element wrapper — annotation-first, init-inferred when un-annotated — not slot 0's.
          if gck == "reflist" { gcs = globalRefListSlot(globalStmts[gi]) }
          // A nullable ref-array cell (kind 18): the ref-list table slot selects this global's
          // element wrapper for the `(ref null $rlWrap)` cell valtype, matching the init's reflist build.
          if gck == "nulreflist" { gcs = letAnnRefListSlot(globalStmts[gi]) }
          // A map cell (kind 6): the map SHAPE picks the struct type; the
          // `pendingMapSlot` seed makes the `Map()` init constexpr build it.
          if gck == "map" {
            gcs = letMapShapeOf(globalStmts[gi], -1)
            pendingMapSlot = gcs
          }
          // A NULLABLE map cell (kind `nulmap`): the map SHAPE picks the struct type; a bare `null`
          // init lowers as `ref.null $mapStruct` (`pendingNulRefHeap`), a `Map()` init builds it
          // (`pendingMapSlot`). Both are valid WasmGC constexprs.
          if gck == "nulmap" {
            gcs = nulMapShapeOf(globalStmts[gi], -1)
            pendingMapSlot = gcs
            pendingNulRefHeap = mapTypeIdxOf(gcs)
          }
          fbValtype(gck, gcs) // valtype
          wU8(1)              // 0x01 mutable
          // An `: i64` global lowers its literal init as `i64.const` (kind 10 / 0x7e);
          // an `: f32`/`: f64` global as `f32.const`/`f64.const` (kind 13 / 0x7d, 11 /
          // 0x7c) — re-encoding an integer literal directly so the init stays a valid
          // constexpr (no convert op). (Slice 5.)
          pendingI64 = (gck == "i64")
          pendingF32 = (gck == "f32")
          pendingF64 = (gck == "f64")
          // A literal-union const global (`const D: K = "a"`) lowers its member init as `i32.const <id>`
          // (a valid constexpr).
          if letIsLitUnion(globalStmts[gi]) { pendingLitUnion = 1 }
          // A nullable-litunion const global (`const g: K0 | null = "404"`): the member init lowers
          // as its atom id and a bare `null` as the -1 sentinel, the nullable twin of the arm above.
          // Un-seeded, a member init emitted the string ref into the i32 niche cell — invalid wasm — and a `null` init drew a loud reject.
          if g.letType >= 0 {
            if nodeTyIsNulLitUnion(g.letType) {
              pendingLitUnion = 1
              pendingNulLitUnion = true
            }
          }
          // A UNION cell (kind 4) with a CONST init boxes it in the constexpr —
          // `struct.new` / `array.new_fixed` / `i32.const` are all constant in
          // WasmGC, so `let w: string | i32 = "a"` builds the box inline.
          let gun2 = ""
          if gck == "union" { gun2 = letUnionNameOf(globalStmts[gi], -1) }
          // A module-level `const f = add` aliasing a GENERIC (un-annotated-param) named
          // function, used only as a direct-call callee: emit the closure through the
          // floor-LESS core, exactly as the function-body twin in `emitLetDeclStmt` does.
          // `struct.new` is a valid WasmGC constexpr, so the cell builds inline.
          const gAliasFe = monoGenericAliasFe(globalStmts[gi])
          if gun2 != "" {
            if emitUnionCoerce(globalPayload, gun2, g.letInit, -1) < 0 {
              return -1
            }
          } else if gAliasFe >= 0 {
            if emitClosureValueCore(globalPayload, gAliasFe, -1) < 0 {
              return -1 // init constexpr
            }
          } else {
            if emitExpr(globalPayload, g.letInit, -1) < 0 {
              return -1 // init constexpr
            }
          }
          pendingI64 = false
          pendingF32 = false
          pendingF64 = false
          // The struct/variant seeds are scoped to this cell's init, exactly as the start-fn loop
          // scopes them (D1563). `emitObjLitNode` consumes the variant seed, so only a cell whose init
          // is not an object literal can leave it armed — clearing it here keeps the two global loops the same shape rather than relying on a consumer.
          pendingStructIdx = -1
          pendingVariantIdx = -1
          pendingListKind = 0
          pendingListSlot = 0
          pendingLitUnion = 0
          pendingNulLitUnion = false
          fbEnd() // 0x0b end of init expr
        }
      }
      gi = gi + 1
    }
    wTarget(gPrev)
    wSection(6, globalPayload)
  }
  0
}

// The `fnStmts` slot an export TARGET name resolves to — the FIRST slot carrying it — or
// -1. The module's ABI resolution, in one place: #1260's `monoFirstFnIndexNamed` mirrors
// this same rule inside the monomorphizer, and four sections now depend on it agreeing.
function exportSlotOfTarget(name: string): i32 {
  let tj = 0
  while tj < fnStmts.length {
    const tfn = P.nodes[fnStmts[tj]]
    if tfn is FuncDecl {
      if tfn.fnName == name { return tj }
    }
    tj = tj + 1
  }
  -1
}

// The PUBLIC names the export section publishes, in section order: every alias-table
// entry whose target resolves, minus duplicates (a wasm export name must be unique, and
// a repeated public name keeps its FIRST entry).
function exportPublicNames(): string[] {
  const nms: string[] = []
  let rxi = 0
  while rxi < reExpName.length {
    if (
      exportSlotOfTarget(reExpTarget[rxi]) >= 0 &&
      !capHas(nms, reExpName[rxi])
    ) {
      nms.push(reExpName[rxi])
    }
    rxi = rxi + 1
  }
  nms
}

// The `fnStmts` slot each published name resolves to, PARALLEL to `exportPublicNames`.
// The two walk `reExpName` in the same order under the same two predicates, so entry k of
// one belongs to entry k of the other by construction.
function exportTargetSlots(): i32[] {
  const slots: i32[] = []
  const seen: string[] = []
  let rxi = 0
  while rxi < reExpName.length {
    const hit = exportSlotOfTarget(reExpTarget[rxi])
    if hit >= 0 && !capHas(seen, reExpName[rxi]) {
      seen.push(reExpName[rxi])
      slots.push(hit)
    }
    rxi = rxi + 1
  }
  slots
}

// #1265 — the export entries that need an ABI wrapper, parallel to `exportPublicNames`,
// empty unless the module uses a function value. When `fnValUsed`, every function carries a
// hidden leading `structref env` param — an internal calling convention that the export
// section otherwise leaks, giving an importer calling `f(1)` a boundary TypeError. Each export entry gets its own thin forwarding wrapper, since two public names may alias one function.
function exportWrapSlots(): i32[] {
  const none: i32[] = []
  if !fnValUsed { return none }
  exportTargetSlots()
}

// A wrapper body: supply the env the internal convention wants, forward the declared params,
// tail into the real function. A top-level export cannot capture anything, so `ref.null
// struct` is the correct env, exactly as the direct-call path passes for a non-capturing
// callee. No locals: the wrapper's own params are locals 0..p-1, un-shifted — the one function in the module with no env param.
function emitExportWrapperCode(out: i32[], slot: i32) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(0) // no local runs
  fbRefNullStruct()
  const wfn = P.nodes[fnStmts[slot]]
  if wfn is FuncDecl {
    let pi = 0
    while pi < wfn.fnParams.length {
      fbLocalGet(pi)
      pi = pi + 1
    }
  }
  fbCall(gImports + slot)
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

function emitExportSection(_n: i32, wrapBase: i32) {
  // Export section (id 7): the module's ABI is exactly the alias tables the driver staged —
  // re-export entries plus the root module's plain `export`-marked functions. Nothing else is
  // exported: an internal function stays private, since a program runs by instantiation and a
  // lean surface lets `wasm-opt` prune unreached code. A duplicate public name keeps its first entry (export names must be unique).
  const reExpEi = exportTargetSlots() // the target's `fnStmts` position, parallel to its public name
  const reExpNm = exportPublicNames()
  // P0.2 — export the linear memory (`buffer-design.md` §C5, ruling O4(i)), under the universal
  // name `memory`, gated on the memory existing at all (`memUsed`, the same flag that decides
  // section 5) — so a program that never touches linear memory is byte-identical to before.
  // Automatic rather than a flag, since an unused memory has nothing to opt out of; a user `export function memory()` name collision is rejected loudly, the trade O4(i) makes.
  if memUsed {
    let mci = 0
    while mci < reExpNm.length {
      if reExpNm[mci] == "memory" {
        return emitFail(
          "emitProgram: this program exports a function named 'memory', but a program that uses linear memory exports the memory itself under that name — rename the function",
        )
      }
      mci = mci + 1
    }
  }
  // An export-free program still omits the section unless the memory is exported, in which
  // case section 7 exists to carry that one entry — otherwise a memory-only module would lose its export.
  if reExpNm.length == 0 && !memUsed { return 0 }
  let nExports = reExpNm.length
  if memUsed { nExports = nExports + 1 }
  const exportPayload: i32[] = []
  const exPrev = wTarget(exportPayload)
  wULEB(nExports)
  // Each entry: the bare public name pointing at the target's func index — or, when the module
  // has an env-leading calling convention to hide, at entry `rei`'s ABI wrapper (#1265).
  // `exportWrapSlots` is parallel to `reExpNm`, and the wrappers are appended in that same order after every other function, so entry `rei`'s wrapper is `wrapBase + rei`.
  let rei = 0
  while rei < reExpNm.length {
    wName(reExpNm[rei])
    wU8(0) // export kind: func
    if fnValUsed {
      wULEB(wrapBase + rei)
    } else {
      wULEB(gImports + reExpEi[rei])
    }
    rei = rei + 1
  }
  // The memory entry LAST, so every function export keeps the index it had — the
  // export section is order-insensitive to a host, but keeping the prefix identical
  // makes the A/B byte diff read as a pure append.
  if memUsed {
    wName("memory")
    wU8(2)   // export kind: memory
    wULEB(0) // memory index 0 (the one module-defined memory)
  }
  wTarget(exPrev)
  wSection(7, exportPayload)
  0
}

// Banks one row of the body-span table (D1594): the `[from, to)` byte range, what kind of
// body it is, and the name/arena node a diagnostic can read off it. Ranges are
// payload-relative until `emitCodeSection` rebases them onto the module. Every body the code section writes gets a row, not just the user functions, since an offset inside a row-less body printed a bare number.
function bankFnSpan(
  node: i32,
  pos: i32,
  from: i32,
  to: i32,
  kind: i32,
  tag: string,
) {
  emitFnSpanNode.push(node)
  emitFnSpanPos.push(pos)
  emitFnSpanStart.push(from)
  emitFnSpanEnd.push(to)
  emitFnSpanKind.push(kind)
  emitFnSpanTag.push(tag)
  0
}

// Returns -1 if any function body fails to emit (propagated by the caller), else 0.
function emitCodeSection(n: i32, hasStart: i32, memFn: i32, nHelpers: i32) {
  // Code section (id 10): one size-prefixed body per function, in index order, then
  // (if any) the synthetic start function's body, the `__log__` decoder's, and the
  // shared-runtime-helper bodies LAST (in helper-index order).
  const codePayload: i32[] = []
  const codePrev = wTarget(codePayload)
  const wrapC = exportWrapSlots()
  wULEB(n + hasStart + memFn + nHelpers + wrapC.length)
  wTarget(codePrev)
  let ci = 0
  while ci < n {
    // Bank the body's byte range for the VALIDATE diagnostic (D1578). Recorded HERE, at
    // the one loop that already pairs a `fnStmts` position with the body it writes, so a
    // span cannot name a different function than the code it brackets. Payload-relative
    // until `wSection` below places the payload in the module.
    const bodyAt = codePayload.length
    if emitFuncCode(codePayload, fnStmts[ci], ci) < 0 { return -1 }
    bankFnSpan(fnStmts[ci], ci, bodyAt, codePayload.length, 0, "")
    ci = ci + 1
  }
  if hasStart == 1 {
    // The start function banks a row per top-level statement from inside `emitStartFnCode`
    // (D1594), then this whole-body row as the fallback for the frame bytes no statement covers.
    // Pushed after them, since `emitFnSpanAt` returns the first row whose range holds the offset and the narrower answer is the useful one.
    const startAt = codePayload.length
    if emitStartFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, startAt, codePayload.length, 4, "")
  }
  if memLogUsed {
    const logAt = codePayload.length
    if emitMemLogFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, logAt, codePayload.length, 3, "__log__")
  }
  // The shared runtime helpers, each banked under the name the name section gives it — one body, one row, so a trace and a validate diagnostic cannot disagree about what to call the same function.
  if gHelpStrHash >= 0 {
    let hAt = codePayload.length
    if emitStrHashFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, hAt, codePayload.length, 3, "__str_hash__")
    hAt = codePayload.length
    if emitStrEqFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, hAt, codePayload.length, 3, "__str_eq__")
    hAt = codePayload.length
    if emitStrConcatFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, hAt, codePayload.length, 3, "__str_concat__")
    hAt = codePayload.length
    if emitUtf8DecFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, hAt, codePayload.length, 3, "__utf8_dec__")
    hAt = codePayload.length
    if emitUtf8EncFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, hAt, codePayload.length, 3, "__utf8_enc__")
    hAt = codePayload.length
    if emitUtf8CpLenFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, hAt, codePayload.length, 3, "__utf8_cplen__")
    if gHelpStrBytes >= 0 {
      hAt = codePayload.length
      if emitStrBytesFnCode(codePayload) < 0 { return -1 }
      bankFnSpan(-1, -1, hAt, codePayload.length, 3, "__str_bytes__")
    }
  }
  if gHelpMapProbe >= 0 {
    let mAt = codePayload.length
    if emitMapProbeFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, mAt, codePayload.length, 3, "__map_probe__")
    mAt = codePayload.length
    if emitMapResizeFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, mAt, codePayload.length, 3, "__map_resize__")
  }
  if gHelpMapProbeI32 >= 0 {
    const miAt = codePayload.length
    if emitMapProbeI32FnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, miAt, codePayload.length, 3, "__map_probe_i32__")
  }
  if gHelpF64Rem >= 0 {
    const frAt = codePayload.length
    if emitF64RemFnCode(codePayload) < 0 { return -1 }
    bankFnSpan(-1, -1, frAt, codePayload.length, 3, "__f64_rem__")
  }
  // The export-wrapper bodies LAST, in the same order the function section declared them.
  // A wrapper's row carries the WRAPPED function's slot and node, so its name and the
  // `file:line:col` of its declaration fall out of the same readers a user body uses.
  let wci = 0
  while wci < wrapC.length {
    const wAt = codePayload.length
    emitExportWrapperCode(codePayload, wrapC[wci])
    bankFnSpan(fnStmts[wrapC[wci]], wrapC[wci], wAt, codePayload.length, 2, "")
    wci = wci + 1
  }
  wSection(10, codePayload)
  // Rebases the payload-relative spans onto the module (D1578). `wSection` has just appended
  // the payload to the module buffer, so `wLen() - codePayload.length` is where it starts — a
  // module offset being exactly the coordinate the engine's validator reports. Derived from the length, not the section header's own width, so the ULEB size prefix cannot be counted wrong.
  const codeBase = wLen() - codePayload.length
  let sp = 0
  while sp < emitFnSpanStart.length {
    emitFnSpanStart[sp] = emitFnSpanStart[sp] + codeBase
    emitFnSpanEnd[sp] = emitFnSpanEnd[sp] + codeBase
    sp = sp + 1
  }
  0
}

// The scalar name of the param annotation at `tyNodeIx`, from the arena where the checker
// recorded a `TyPrim` and from the spelling only where it did not. The arena is primary, the
// spelling the documented remainder: `nodeTyPrimName` answers "" both for "not a prim" and
// "no recorded type" (real here — a generic original's param has no recorded arena type). The decision form of `paramScalarName` compares prim-name atoms rather than the widened name text.
function paramScalarIs(
  tyNodeIx: i32,
  spelled: string,
  want: PrimName,
): boolean {
  const pn = tyPrimNameOf(nodeTyIxOf(tyNodeIx))
  if pn != null { return pn == want }
  // The arena HAS a type and it is not a `TyPrim` — an ANSWER, not a gap, so every scalar
  // rung must miss (the `paramScalarName` header's own rule, preserved).
  if nodeTyIxOf(tyNodeIx) >= 0 { return false }
  spelled == want
}
