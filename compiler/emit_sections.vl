    // of the string-ref list. Every other field matches the twin above exactly,
    // which is why the probe/rehash/compact machinery is shared.
    wU8(95)  // 0x5f struct (i32-keyed map)
    wU8(7)   // 7 fields
    wU8(100) // field 0 keys: 0x64 (ref $lTypeIdx) — non-null i32 list
    wSLEB(lTypeIdx)
    wU8(1)   // mutable
    wU8(100) // field 1 vals: 0x64 (ref $lTypeIdx) — non-null
    wSLEB(lTypeIdx)
    wU8(1)   // mutable
    wU8(100) // field 2 live: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    wU8(100) // field 3 index: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    wU8(127) // field 4 count: 0x7f i32
    wU8(1)   // mutable
    wU8(127) // field 5 size: 0x7f i32
    wU8(1)   // mutable
    wU8(100) // field 6 hashes: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
