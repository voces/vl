// Host opt-in for the name section (see `gEmitNames`). The driver does NOT call
// this, so every golden/fixpoint emit leaves names OFF; only the native tool
// turns it on. Idempotent — any nonzero `on` enables, `0` disables.
export function setEmitNames(on: i32) {
  if on != 0 { gEmitNames = 1 } else { gEmitNames = 0 }
  0
}

function emitReset() {
  // NOTE: `gImports` and `startStmts` are NOT reset here — they are assigned by
  // their own passes (the print-detection scan in `emitProgram`, `collectFns`)
  // which run BEFORE `emitModule` calls this; resetting them here would clobber
  // those passes' results.
  W.bytes = []
  curBuf = W.bytes
  0
}

// ── module header ────────────────────────────────────────────────────────────
function emitHeader() {
  // "\0asm" magic + version 1
  wU8(0)
  wU8(97)  // 'a'
  wU8(115) // 's'
  wU8(109) // 'm'
  wU8(1)
  wU8(0)
  wU8(0)
  wU8(0)
  0
}

// Rebuild `localNames` for the function at `fnIx`: clear it, then collect every
// declared-local name in the body (validating each as i32). Returns 0 on success,
// or -1 (via `emitFail`) on any unsupported local. Must run before lowering the
// body so identifier resolution and the locals vector see the full set.
function buildLocals(fnIx: i32) {
  localNames = []
  localIsRef = []
  localStructIdx = []
  localLoopVar = []
  localLoopIter = []
  localLitUnion = []
  // Reset the lexical scope stack per function. `collectLocals` pushes/pops frames as
  // it walks (leaving it balanced/empty), then the emit pass rebuilds it in lockstep.
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  const fn = P.nodes[fnIx]
  if fn is FuncDecl { return collectLocals(fn.fnBody, fnIx) }
  emitFail("emitProgram: not a function declaration")
}

// Verify every parameter of the FuncDecl at `fnIx` is typed `i32` — the only type
// this slice emits. Returns 0 on success or -1 (via `emitFail`) otherwise.
function checkParams(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      const p = P.nodes[params[pi]]
      if p is Param {
        if p.parType < 0 {
          // An UN-ANNOTATED parameter — a contextually-inferred callback literal
          // (`xs.map(function(n) n * 2)`, Slice 5's checker half). The checker has
          // already pinned its type from the receiver; this emitter's default kind
          // for a missing annotation is i32 (`vtKindOfType(-1)` → 0), which is the
          // only inferred-param receiver element kind in scope. Accepted as-is.
          pi = pi + 1
          continue
        }
        const ty = P.nodes[p.parType]
        if ty is TypeRef {
          // i32, `boolean` (which rides in an i32, 0/1 — encoded as the SAME 0x7f
          // valtype), the declared struct type, a NULLABLE struct (`S | null`), an
          // array (`i32[]`), or `string` (the SAME `array i32` of code points) are
          // allowed; anything else fails.
          // (`collectA` already validated every array annotation is i32[].)
          if tyIsFuncType(p.parType) {
            // a function-typed (closure fat-pointer) param — kind 14
          } else if nulCloFlag(p.parType) == 1 {
            // a NULLABLE function-value param (`((i32) => i32) | null`, kind 19) — its `=>` is
            // NESTED so `tyIsFuncType` (top-level-arrow only) no longer matches it; accept it
            // here explicitly, as `vtKindOfType` already maps it to kind 19.
          } else if retNulRefFlag(p.parType) == 1 {
            // accepted — a `(ref null $S)` param
          } else if retNulListFlag(p.parType) == 1 {
            // accepted — a `(ref null $lTypeIdx)` param (`i32[] | null`, kind 15)
          } else if nulScalarListKindOfNode(p.parType) != null {
            // accepted — a DISTINCT-backing nullable scalar-list param (`i64[] | null` etc.):
            // a `(ref null $wrapper)` cell over the leaf list's own wrapper heap type
            // (`fbValtype` nulstrlist/nulf64list/nuli64list/nulf32list arms).
          } else if retNulRefArrFlag(p.parType) == 1 {
            // accepted — a `(ref null $wrapper)` NULLABLE ref-array param (`<ref-array> | null`, kind 18):
            // its `vtKindOfType` is `"nulreflist"` and `paramStructIdxOf` resolves the inner wrapper slot.
            // (`nameIsArray` below would otherwise reject the `| null`-suffixed name.)
          } else if tyIsNulBool(p.parType) {
            // accepted — a `boolean | null` NICHE param (the i32 sentinel 0/1/2)
          } else if retNulStringFlag(p.parType) == 1 {
            // accepted — a `string | null` param (`(ref null $aTypeIdx)`, kind 16)
          } else if retMapFlag(p.parType) == 1 {
            // accepted — a string-keyed map param (kind 6, `(ref $mapStruct)`). The mv
            // SHAPE crosses the boundary (`paramStructIdxOf` → `mapAnnShape`): -1 for a
            // mono i32/boolean map, its slot for a `string`-valued one. A struct/f64/
            // i64-valued map is NOT yet supported — `retMapFlag` returns 0, so it falls
            // through to the reject below.
          } else if retNulMapFlag(p.parType) == 1 {
            // accepted — a NULLABLE map param (`{[string]: V} | null`, kind `nulmap`): the
            // same shape over a `(ref null $mapStruct)` cell. The `!= null` narrow
            // (`ref.is_null`) and the narrowed ops (`t["k"]` / `t["k"] ?? d`) recover the
            // non-null ref at the receiver — the checker proved every such read guarded.
          } else if nodeTyIsLitUnionAlias(p.parType) {
            // accepted — a literal-union param is an i32-backed interned atom (kind 0).
          } else if nodeTyIsNulLitUnion(p.parType) {
            // accepted — a `K | null` NICHE param is the i32 atom with the spare `-1` = null (kind 0).
          } else if ty.tyName != "i32" {
            if ty.tyName != "i64" {
              // i64 rides the 0x7e valtype (Slice 1)
              if ty.tyName != "f64" {
                // f64 rides the 0x7c valtype (Slice 3)
                if ty.tyName != "f32" {
                  // f32 rides the 0x7d valtype (Slice 5)
                  if ty.tyName != "boolean" {
                    if !isSName(ty.tyName) {
                      if !isUName(ty.tyName) {
                        if variantIndexOf(ty.tyName) < 0 {
                          if !nameIsArray(ty.tyName) {
                            if !nameIsString(ty.tyName) {
                              return emitFail(
                                "emitProgram: only i32, i64, f64, f32, boolean, struct, union, array, or string parameters are supported",
                              )
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        } else {
          return emitFail("emitProgram: parameter type is not a type name")
        }
      } else {
        return emitFail("emitProgram: malformed parameter")
      }
      pi = pi + 1
    }
    return 0
  }
  emitFail("emitProgram: not a function declaration")
}

// ── locals-vector emission (derived, never separately counted) ────────────────
// The locals vector is a sequence of (count, valtype) runs. This emitter uses a
// count of 1 per local — one run per declared local and per scratch slot — so the
// run total equals the local count. The run helpers below stream straight to
// `curBuf` (bind it with `wTarget` first); each emits the `1` count then a valtype.

// Build the size-prefixed code-section body for the FuncDecl at `fnIx`: the locals
// vector (declared locals, all i32 — see `buildLocals`), the body's statement
// instructions, then `end`. The framed bytes are appended onto `out`. Returns 0, or
// -1 (via `emitFail`) on any unsupported shape.
//
// The locals vector groups consecutive locals of the same type into (count, valtype)
// runs. Every declared local is i32 here, so it is a single run `(L, 0x7f)` for
// `L = localNames.length` declared locals (or an empty vector `0` when there are
// none). Params are NOT counted here — they are encoded in the functype, not the
// code body's locals vector.
function emitFuncCode(out: i32[], fnIx: i32, fnPos: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    // Anchor any emit failure raised while lowering THIS body at its declaration
    // (`emitFail` snapshots `emitCurFnIx`). Sequential emission means the cursor's
    // value at failure time is the offending function. `fnPos` is the caller's own
    // `fnStmts` loop index; the pair is what `fnStmtsPosOf` reads instead of scanning
    // (see `emitCurFnPos`).
    emitCurFnIx = fnIx
    emitCurFnPos = fnPos
    // Replay the narrowing this frame's closure was WRITTEN inside, for the whole body —
    // locals collection included, because a `const t = <captured narrowed read>` is typed
    // from it. Only a value-union-box capture is seeded (`capNarrowSeed`), so a function
    // that captures nothing narrowed pushes nothing and emits identical bytes. The depth
    // is restored on the success path; a `-1` below fails the entire module, so a leaked
    // depth cannot be observed.
    const savedCapNarrow = capNarrowSeed(fnPos)
    // Collect + validate declared locals BEFORE lowering, so identifier resolution
    // and the locals vector both see the full per-function set.
    if buildLocals(fnIx) < 0 { return -1 }
    // Re-bank the declaration-site narrowing of the frames declared INSIDE this body, now
    // that this frame's local table exists — the only point at which a guard over a
    // function-scope LOCAL resolves (see `capNarrowRecordFrame`). Bodies are emitted in
    // `fnStmts` order and a nested frame is collected after its parent, so the record is
    // banked before the nested body that reads it. Gated on `fnValUsed`: with no function
    // value or capture anywhere in the module there is no frame to bank for, and the scan
    // is skipped entirely.
    if fnValUsed { capNarrowRecordFrame(fnPos) }

    // If this function pushes, reserve three scratch locals after the declared ones.
    // `pushScratchBase` is their first wasm index (= params + declared locals); the
    // inline-push sequence reads `pushScratchBase`+0/+1/+2. Set BEFORE `emitStmts` so a
    // `.push` can resolve its scratch slots. ONE body walk (`blockPushPopBits`)
    // classifies every `.push`/Member-`.pop` receiver once and yields all six kind
    // flags together.
    fnUsesPush = false
    fnUsesRefPush = false
    fnUsesStrPush = false
    fnUsesNulStrPush = false
    fnUsesF64Push = false
    fnUsesI64Push = false
    fnUsesF32Push = false
    applyPushPopBits(blockPushPopBits(fn.fnBody, fnIx))
    fnUsesStrOp = fnHasStrOp(fnIx)
    fnUsesArrNew = fnHasArrNew(fnIx)
    fnUsesCoalesceCall = fnHasCoalesceCall(fnIx)
    fnUsesMap = fnHasMap(fnIx)
    // `fnHasMap` only scans LOCALS/params; also reserve the frame when a map op runs
    // on a GLOBAL struct-field map-array element (e.g. `T.scopes[top][k] = v`).
    if !fnUsesMap { fnUsesMap = fnHasGlobalMapOp(fnIx) }
    // A function-value call (`call_ref`) anywhere in the body reserves the closure
    // scratch slot. Only detected when a function value exists module-wide (lambdas).
    fnUsesCallRef = false
    if fnValUsed { fnUsesCallRef = blockHasCallRef(fn.fnBody, fnIx) }
    // A multi-field CALL result re-boxed into a variant-box union arm stashes the call
    // in the `variantReboxSlot` (a call cannot be re-read per field).
    fnUsesVariantRebox = blockHasVariantRebox(fn.fnBody, fnIx)
    // Collect the DISTINCT ref-list element-type slots this function pushes onto (each
    // gets its own typed 4-slot scratch frame). Empty unless `fnUsesRefPush`.
    fnRefPushSlots = []
    refPushBaseBySlot = []
    collectRefPushSlots(fn.fnBody, fnIx)
    // A Member-receiver ref-list `.pop` (`T.scopes.pop()`) needs the SAME typed scratch
    // frame as a ref `.push` onto that slot — record its slot too, so a pop-only function
    // reserves the frame whose `recvRef` holds the field's wrapper ref.
    collectMemberPopRefSlots(fn.fnBody, fnIx)
    // Collect the `.map`/`.filter` HOF sites this body lowers (each reserves the
    // shared 4-slot frame + one typed src/dst slot per distinct receiver/result type).
    fnUsesMapFilter = false
    fnUsesMapKeys = false
    fnUsesMapVals = false
    fnUsesMapVals = false
    mfSrcKinds = []
    mfSrcSlots = []
    mfSrcBases = []
    mfDstKinds = []
    mfDstSlots = []
    mfDstBases = []
    mfScan(fn.fnBody, fnIx)
    // List `==`/`!=`/`+` frames (collections-design §VL.4/§VL.6). May also flip
    // `fnUsesStrOp` (a string-list compare rides the string-op frame), so it
    // runs AFTER the `fnHasStrOp` assignment above.
    fnUsesListEqI = false
    fnUsesListEqS = false
    fnListEqRSlots = []
    fnUsesCloEq = false
    leqScanBlock(fn.fnBody, fnIx)
    const nLocals = localNames.length
    // Union-box SINK: reserve the shared tag/payload pair when this function's result is
    // the box and it has two or more exits (the RETURN sink), or it binds a union box from
    // an if-expression (the BINDING sink). The frame has to be laid out BEFORE the body
    // (a `local.set` needs the index), so both are predictions; `uSinkFired` records what
    // the return path actually did and decides whether the exit block is emitted at all.
    fnUsesUnionSink = fnUnionRetSinkOk(fnIx)
    fnUsesUnionLetSink = fnUnionLetSinkOk(fnIx)
    uSinkFired = 0
    uBoxNewEnd = -1
    tailCallEnd = -1
    tailCallIdx = -1
    // Lay out every scratch frame after the params + declared locals via the
    // FuncBuilder cursor (Phase H), which sets `pushScratchBase` /
    // `refPushScratchBase` / `refPushBaseBySlot` / `strPushScratchBase` /
    // `strScratchBase` / `mapScratchBase` from ONE running offset in frame order.
    // Scratch frames land after the params AND the hidden env param (local 0) when a
    // function value exists module-wide, so the cursor starts past `envSlotShift`.
    fbBeginFunc(fn.fnParams.length + envSlotShift(fnIx), nLocals)

    const bodyExpr: i32[] = []
    // Bind the writer at `bodyExpr` so the `fb*` opcode methods (which append to
    // `curBuf`) write the function-body instructions; the recursive lowering threads
    // the SAME `bodyExpr` as its `body` arg, so `curBuf == body` throughout and the
    // not-yet-converted raw `body.push(...)` sites interleave identically. Restore
    // the previous target afterwards.
    const exprPrev = wTarget(bodyExpr)
    // Reset the emit-time scope stack + slot cursor; `emitFuncBody` re-walks the body
    // in collect's pre-order, so the n-th `LetDecl` it emits re-derives declared-local
    // slot `n` and binds it for in-scope resolution.
    scopeNames = []
    scopeSlots = []
    scopeFrames = []
    emitLetCursor = 0
    // Reset the loop control-frame tracking (`break`/`continue` branch-depth state)
    // so a previous function's open frames never leak into this one.
    ctrlDepth = 0
    loopContDepth = []
    loopBrkDepth = []
    loopContLabel = []
    loopBrkLabel = []
    if emitFuncBody(bodyExpr, fn.fnBody, fnIx) < 0 { return -1 }
    wTarget(exprPrev)

    const body: i32[] = []
    // Locals vector: one (count=1, valtype) run per DECLARED local, then the scratch
    // frames in `fbBeginFunc`'s layout order. Derived from the local set + scratch
    // flags by the FuncBuilder (Phase H) — the run count and every valtype come from
    // ONE place, so they cannot desync from the frame layout above.
    if fbEmitLocalsVec(body, nLocals) < 0 { return -1 }
    // The return sink's single EXIT BLOCK, opened around the whole body so every sunk
    // `return`'s `br <ctrlDepth>` lands on it. Emitted only when a `return` actually sank
    // — otherwise the body holds no branch to it and the block would be dead weight.
    if uSinkFired > 0 {
      const blkPrev = wTarget(body)
      fbBlock(64) // 0x02 block, 0x40 void blocktype
      wTarget(blkPrev)
    }
    appendAll(body, bodyExpr)
    // Bind the writer at `body` (the framed code entry) for the trailing padding/end
    // opcodes emitted via the `fb*` methods.
    const endPrev = wTarget(body)
    // If the body does NOT end in an explicit `return` / tail value, control
    // structurally falls through to the function `end` with an empty stack (e.g. a
    // body ending in `if c { return a } else { return b }`, whose `return`s exit from
    // inside the structured `if`). The validator requires the function's result type
    // at fallthrough, so something must occupy it. Two cases:
    //   • NULLABLE return — the fall-through is a LIVE path that yields `null` (the
    //     checker permits it precisely because `null` is in the return type), so emit
    //     that null value (`emitNullForRet`) as the function's result.
    //   • non-nullable return — the typechecker has proven the fallthrough is DEAD
    //     (every path returns), so `unreachable` (0x00) is sound padding, never run.
    let isVoidFn = false
    if fnPos >= 0 {
      if fRetVoid[fnPos] == 1 { isVoidFn = true }
    }
    if !isVoidFn && !bodyEndsInReturn(fn.fnBody, fnIx) {
      if fnRetNullBearing(fnIx) {
        if emitNullForRet(body, fnIx) < 0 { return -1 }
        // Inside the sink's exit block this fall-through value cannot simply be left on
        // the stack for the function `end` — the block is void. It terminates like any
        // other exit: sunk when it built a box, a plain `return` otherwise.
        if uSinkFired > 0 { emitUnionRetSink(fnIx) }
      } else {
        fbUnreachable() // 0x00 unreachable (dead padding for the result type)
      }
    }
    // Close the sink's exit block and perform the function's ONE box construction, whose
    // operands every sunk `return` has already written. Falling off the function `end`
    // with it on the stack is the result.
    if uSinkFired > 0 {
      fbEnd() // 0x0b end — the exit block
      fbLocalGet(unionSinkBase)
      fbLocalGet(unionSinkBase + 1)
      fbStructNew(uBoxIdx)
    }
    fbEnd() // 0x0b end
    wTarget(endPrev)
    // Stream the size-prefixed code entry onto `out` (the code-section payload). Bind
    // the writer at `out` explicitly: the caller restores `curBuf` off the payload
    // before this loop, so `curBuf` is NOT `out` on entry here.
    const outPrev = wTarget(out)
    wULEB(body.length)
    wBytes(body)
    wTarget(outPrev)
    restoreNarrow(savedCapNarrow)
    return 0
  }
  emitFail("emitProgram: not a function declaration")
}

// Record the ref-list slot of a bare top-level `recv.push(x)` statement (the
// block-level collector handles pushes nested in loop/if bodies).
function recordStartRefPushSlot(stmtIx: i32) {
  const s = P.nodes[stmtIx]
  if s is Call {
    const callee = P.nodes[s.callFn]
    if callee is Member {
      if callee.memProp == "push" {
        recordRefPushSlot(refListSlotOfExpr(callee.memObj, -1))
      }
    }
  }
  0
}

// Run every scratch-detection walker over one start-fn BLOCK (a loop body, an if
// arm), feeding the `fnUses*` flags + the ref-push slot recorders. The single
// push/pop walk feeds the push flags, mirroring `emitFuncCode`: a `.push` and a
// Member-receiver `.pop` (which reuses the push frame's slots) each need the
// scratch quad.
function startScanBlock(blockIx: i32) {
  applyPushPopBits(blockPushPopBits(blockIx, -1))
  if blockHasStrOp(blockIx, -1) { fnUsesStrOp = true }
  if blockHasArrNew(blockIx) { fnUsesArrNew = true }
  if blockHasCoalesceCall(blockIx) { fnUsesCoalesceCall = true }
  if blockHasMapOp(blockIx, -1) { fnUsesMap = true }
  collectRefPushSlots(blockIx, -1)
  collectMemberPopRefSlots(blockIx, -1)
  0
}

// Run every EXPRESSION-level scratch-detection walker over one start-fn HEADER
// expression — a `while` condition, a `for`-range bound, a `for`-in iterable, an
// `if` condition. `startScanBlock`'s counterpart for the parts of a compound
// statement that are NOT a block: those expressions are lowered into the start
// function's body exactly as a bare top-level statement is, so they need exactly
// the same frames, and every handler they reach (`emitCoalesce`'s call stash,
// `emitArrayNew`'s length slot, the map lowering, the string-op frame,
// `emitPop`) writes its frame with no "frame not reserved" floor. The four
// headers used to be scanned inconsistently: `if` got five of the six walkers,
// `for`-in got four, and `while` / `for`-range got NONE. (A `for`-range `step`
// is not scanned because it cannot hold one of these: a non-constant step is a
// clean emit reject, "for-range step must be a constant integer".)
function startScanHeaderExpr(exprIx: i32) {
  if exprIx < 0 { return 0 }
  if exprHasStrOp(exprIx, -1) { fnUsesStrOp = true }
  if exprHasArrNew(exprIx) { fnUsesArrNew = true }
  if exprHasCoalesceCall(exprIx) { fnUsesCoalesceCall = true }
  if exprHasMapOp(exprIx, -1) { fnUsesMap = true }
  applyPushPopBits(exprPopBits(exprIx, -1))
  collectMemberPopRefSlotsExpr(exprIx, -1)
  0
}

// Scan a TOP-LEVEL `if` chain: the condition expression plus every arm's block
// (an `else if` recurses through this function).
function startScanIf(ifIx: i32) {
  const st = P.nodes[ifIx]
  if st is IfStmt {
    startScanHeaderExpr(st.ifCond)
    // Narrow across each arm (mirroring `ifChainHasStrOp` / `emitStmt`): the
    // then-branch sees the guard's narrowing, the else-branch sees a VALUE
    // union's complement — so a top-level `if w is string { print(w) }`
    // reserves the string scratch frame in the start function.
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(st.ifCond, -1)
    startScanBlock(st.ifThen)
    if narrowed { restoreNarrow(savedTop) }
    if st.ifElse >= 0 {
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(st.ifCond, -1)
      const els = P.nodes[st.ifElse]
      if els is Block { startScanBlock(st.ifElse) }
      if els is IfStmt { startScanIf(st.ifElse) }
      if narrowedElse { restoreNarrow(savedElseTop) }
    }
  }
  0
}

// ── PROMOTION of a top-level binding to a start-function LOCAL (G2c) ─────────
// `emit_state.vl`'s `gPromoOk` header carries the model and the measurement that
// motivates it. This block is the ANALYSIS: the reachability walk, the safety
// predicate, and the one query the four start-fn / global-section gates share.

// Mark every arena node reachable from the TOP-LEVEL REGION — the top-level statement
// list and the top-level initializers — into `marks`, WITHOUT descending into a nested
// `FuncDecl`. That stop is a semantic requirement, not an optimization: a lambda
// literal written at top level is LIFTED to its own wasm function, and its body still
// addresses the binding as a module cell.
//
// A node shape this ladder does not know leaves its descendants UNMARKED, and an
// unmarked mention refuses the promotion — so a hole here costs POPULATION, never
// soundness. That asymmetry is why reachability is computed in this direction rather
// than the obvious one (walk each function body looking for the name): the flat arena
// scan it pairs with in `computeGlobalPromotion` is exhaustive by construction, so a
// hole in THIS walk can only move the answer to the conservative side. A hole in a
// function-body walk would move it to the unsound side.
function promoMark(marks: i32[], ix: i32) {
  if ix < 0 { return 0 }
  if ix >= marks.length { return 0 }
  if marks[ix] == 1 { return 0 }
  marks[ix] = 1
  const n = P.nodes[ix]
  if n is FuncDecl { return 0 }
  if n is Block {
    const bs = n.blkStmts
    let bi = 0
    while bi < bs.length {
      promoMark(marks, bs[bi])
      bi = bi + 1
    }
    return 0
  }
  if n is LetDecl { return promoMark(marks, n.letInit) }
  if n is BinExpr {
    promoMark(marks, n.binLeft)
    return promoMark(marks, n.binRight)
  }
  if n is Call {
    promoMark(marks, n.callFn)
    const args = n.callArgs
    let ai = 0
    while ai < args.length {
      promoMark(marks, args[ai])
      ai = ai + 1
    }
    return 0
  }
  if n is IfStmt {
    promoMark(marks, n.ifCond)
    promoMark(marks, n.ifThen)
    return promoMark(marks, n.ifElse)
  }
  if n is WhileStmt {
    promoMark(marks, n.whileCond)
    return promoMark(marks, n.whileBody)
  }
  if n is ForRange {
    promoMark(marks, n.frFrom)
    promoMark(marks, n.frTo)
    promoMark(marks, n.frStep)
    return promoMark(marks, n.frBody)
  }
  if n is ForIn {
    promoMark(marks, n.fiIter)
    return promoMark(marks, n.fiBody)
  }
  if n is RetStmt { return promoMark(marks, n.retArg) }
  if n is Unary { return promoMark(marks, n.unArg) }
  if n is Paren { return promoMark(marks, n.parInner) }
  if n is Member { return promoMark(marks, n.memObj) }
  if n is OptMember { return promoMark(marks, n.omObj) }
  if n is IsExpr { return promoMark(marks, n.isObj) }
  if n is AsExpr { return promoMark(marks, n.asObj) }
  if n is Index {
    promoMark(marks, n.idxArr)
    return promoMark(marks, n.idxIndex)
  }
  if n is ArrayLit {
    const es = n.arrElems
    let ei = 0
    while ei < es.length {
      promoMark(marks, es[ei])
      ei = ei + 1
    }
    return 0
  }
  if n is ObjLit {
    const fs = n.objFields
    let fi = 0
    while fi < fs.length {
      promoMark(marks, fs[fi])
      fi = fi + 1
    }
    return 0
  }
  if n is FieldInit { return promoMark(marks, n.fiValue) }
  if n is MatchExpr {
    promoMark(marks, n.matchScrut)
    const pats = n.matchPats
    let pi = 0
    while pi < pats.length {
      promoMark(marks, pats[pi])
      pi = pi + 1
    }
    const binds = n.matchBinds
    let bj = 0
    while bj < binds.length {
      promoMark(marks, binds[bj])
      bj = bj + 1
    }
    const bodies = n.matchBodies
    let mj = 0
    while mj < bodies.length {
      promoMark(marks, bodies[mj])
      mj = mj + 1
    }
    return 0
  }
  0
}

// THE CHEAP HALF of the safety predicate — the two clauses that read only this
// binding's own declaration. The reachability clause is applied by
// `computeGlobalPromotion`, which is the only caller.
//
//   P2  The cell kind is a plain numeric scalar (`i32`/`i64`/`f64`/`f32`). For exactly
//       these, `fbValtypeNullable(ck, cs)` and `fbValtype(ck, cs)` are the same byte, so
//       a start-fn local is a drop-in for the cell — and they are precisely the kinds
//       `emitIdentNode`'s non-const `ref.as_non_null` recovery already excludes, so no
//       read-side path changes shape. A REF cell is a NULLABLE global but would be a
//       non-null local; reconciling those two valtypes is a different change and is
//       deliberately not attempted here. Note the i32 kind also carries the
//       literal-union, `K | null` and `boolean | null` NICHE encodings, and promoting
//       them is storage-correct precisely because promotion moves the VALUE and not the
//       BINDING: the row stays in `globalStmts`, so `globalCellKind`, `letIsLitUnion`,
//       `letIsNulBoolAnn` and every other classifier keep answering about the same
//       `LetDecl` and keep answering the same thing.
//   P3  The binding has an initializer. `emitGlobalSection` already rejects one without,
//       and a promoted binding's slot has no other way to acquire a value.
function globalPromotable(gi: i32) {
  const d = P.nodes[globalStmts[gi]]
  if d is LetDecl {
    if d.letInit < 0 { return false }
    const ck = globalCellKind(globalStmts[gi])
    if ck == "i32" { return true }
    if ck == "i64" { return true }
    if ck == "f64" { return true }
    if ck == "f32" { return true }
    return false
  }
  false
}

// Decide, for every top-level binding, whether it lives in a cell or a start-function
// local, and re-densify the cell indices around the ones that leave. Runs ONCE, at the
// top of `emitModule` — after every pass that mutates the arena (monomorphization
// clones nodes, and a clone that mentions a name has to be seen by the scan below) and
// before the first section that reads a global index.
//
// THE SAFETY PREDICATE is P1 here plus P2/P3 in `globalPromotable` plus P4 below:
//
//   P1  There IS a top-level statement list. A binding in a pure-library module has
//       nothing to be faster for, and the clause additionally guarantees `hasStart` is
//       already 1 — so promotion can never MINT a start function for a module that had
//       none, and can never grow one.
//   P4  Every `Ident` node in the arena that spells this binding's name is inside the
//       top-level region. This is the clause that rules out a named function body
//       reading it, a lifted lambda capturing it, a monomorphized clone mentioning it,
//       and any mention reached by a path this file does not model. It is deliberately
//       NAME-keyed and not binding-keyed: a function with its own local of the same
//       name vetoes a promotion it did not need to veto, which costs population and
//       nothing else.
//
// P4 subsumes the export question rather than testing it separately. An `export let`
// produces no export entry at all (`exportSlotOfTarget` matches `FuncDecl`s only), the
// name section has no global-name subsection, and a VL program runs BY INSTANTIATION —
// the start section IS the top level, with nothing before it and nothing after it. So
// the start function's frame is the whole observable lifetime of a binding no other
// function names.
export function computeGlobalPromotion() {
  gPromoInStart = false
  // REBUILT, not reset in place. `collectFns` seeds these three arrays so a
  // `userGlobalIdx` before this pass still answers the identity, but any pass that
  // appends a global after `collectFns` would leave them SHORT — the same hazard
  // `emit_state.vl` records against `globalIndexBySid`, whose "built once" invariant is
  // exactly what a rebuild here does not depend on.
  gPromoOk = []
  gPromoSlot = []
  gCellIdx = []
  let ri = 0
  while ri < globalStmts.length {
    gPromoOk.push(0)
    gPromoSlot.push(-1)
    gCellIdx.push(ri)
    ri = ri + 1
  }
  if startStmts.length == 0 {
    return 0 // P1
  }
  let anyCand = false
  let ci = 0
  while ci < globalStmts.length {
    if globalPromotable(ci) {
      gPromoOk[ci] = 1
      anyCand = true
    }
    ci = ci + 1
  }
  if !anyCand { return 0 }
  // P4, in two halves. The reachability walk marks the top-level region; the flat arena
  // scan then finds every `Ident` the walk did NOT reach and vetoes the binding it
  // names. The scan is over the WHOLE arena, which is what makes "everywhere else"
  // exhaustive without needing to enumerate what "everywhere else" is.
  const marks: i32[] = []
  let mi = 0
  while mi < P.nodes.length {
    marks.push(0)
    mi = mi + 1
  }
  let gi = 0
  while gi < globalStmts.length {
    promoMark(marks, globalStmts[gi])
    gi = gi + 1
  }
  let si = 0
  while si < startStmts.length {
    promoMark(marks, startStmts[si])
    si = si + 1
  }
  let ai = 0
  while ai < P.nodes.length {
    if marks[ai] == 0 {
      const nd = P.nodes[ai]
      if nd is Ident {
        const gj = globalIndexOf(nd.identName)
        if gj >= 0 { gPromoOk[gj] = 0 }
      }
    }
    ai = ai + 1
  }
  // The surviving cells re-densify: a promoted binding emits none, so every cell below
  // a promoted one keeps its index and every cell above it drops by one. `userGlobalIdx`
  // is the single translation and reads this array.
  let cell = 0
  let di = 0
  while di < globalStmts.length {
    if gPromoOk[di] == 1 {
      gCellIdx[di] = -1
    } else {
      gCellIdx[di] = cell
      cell = cell + 1
    }
    di = di + 1
  }
  0
}

// Does the binding at `globalStmts` position `gi` have its initializer RUN by the start
// function? True for a non-constexpr init (its cell is zero-initialized there and the
// start fn stores the real value) and for a PROMOTED binding (which has no cell at all,
// so its init — constexpr or not — becomes the `local.set` that gives the slot its
// value). The four places that must agree on this question are `emitModule`'s `hasStart`
// count, `startFnDetectScratch`'s initializer scan, `emitGlobalSection`'s cell arm, and
// `emitStartFnCode`'s merge loop.
export function globalRunsInStartFn(gi: i32) {
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 { return true }
  globalIsNonConst(globalStmts[gi])
}

// Detect, over the non-const global inits AND the top-level statements, the scratch
// frames the start function's body needs — the start-fn analogue of `emitFuncCode`'s
// per-function `fnHas*` detection. A `.push` is a statement-level void call (never in
// an init VALUE position), so an init's push frames are driven by Member-receiver
// `.pop`s instead (`let x = T.scopes.pop()`, via `exprPopBits`); string and map ops
// are detected over the same exprs. Sets the `fnUses*` flags +
// `fnRefPushSlots`/`refPushBaseBySlot` exactly as `emitFuncCode` does, so the shared
// `fbBeginFunc`/`fbEmitLocalsVec` lay out an identical frame. For the common `curBuf =
// W.bytes` shape (a plain `global.get`+`struct.get`) every flag is false and the
// locals vector is empty.
function startFnDetectScratch() {
  fnUsesPush = false
  fnUsesRefPush = false
  fnUsesStrPush = false
  fnUsesNulStrPush = false
  fnUsesF64Push = false
  fnUsesF32Push = false
  fnUsesI64Push = false
  fnUsesStrOp = false
  fnUsesArrNew = false
  fnUsesCoalesceCall = false
  fnUsesMap = false
  fnUsesCallRef = false
  fnUsesVariantRebox = false
  fnRefPushSlots = []
  refPushBaseBySlot = []
  fnUsesMapFilter = false
  fnUsesMapKeys = false
  mfSrcKinds = []
  mfSrcSlots = []
  mfSrcBases = []
  mfDstKinds = []
  mfDstSlots = []
  mfDstBases = []
  let gi = 0
  while gi < globalStmts.length {
    // A PROMOTED binding's init runs here too (its `local.set` replaces the cell's
    // constexpr), so its scratch needs are detected on the same gate — else a const
    // init that needs a frame would reach the start fn with none reserved.
    if globalRunsInStartFn(gi) {
      const g = P.nodes[globalStmts[gi]]
      if g is LetDecl {
        const ix = g.letInit
        applyPushPopBits(exprPopBits(ix, -1))
        if exprHasStrOp(ix, -1) { fnUsesStrOp = true }
        // A `string` global initialized with a literal-union atom widens via the runtime tower
        // (`emitAtomToStr`), which stages the atom id in the string-op scratch frame.
        if globalInitWidensAtomToStr(globalStmts[gi]) { fnUsesStrOp = true }
        if exprHasArrNew(ix) { fnUsesArrNew = true }
        if exprHasCoalesceCall(ix) { fnUsesCoalesceCall = true }
        if exprHasMapOp(ix, -1) { fnUsesMap = true }
        if fnValUsed {
          if blockHasCallRef(ix, -1) { fnUsesCallRef = true }
        }
        collectMemberPopRefSlotsExpr(ix, -1)
        // A `.map`/`.filter` in a non-const global initializer (`const ys =
        // xs.map(...)`) runs in the start function — reserve its HOF frame here.
        mfScan(ix, -1)
      }
    }
    gi = gi + 1
  }
  // `.map`/`.filter` sites in top-level STATEMENTS (`print(e.map(...).length)`)
  // also run in the start function; `mfScan` recurses every statement shape itself.
  let mfi = 0
  while mfi < startStmts.length {
    mfScan(startStmts[mfi], -1)
    mfi = mfi + 1
  }
  // Top-level STATEMENTS may also need scratch (a `.push` / string op / map op in a
  // top-level `for`/`while`/`if` body or a bare call). Scan each through the same
  // walkers (which recurse into for/while/if bodies). `startScanBlock` runs every
  // block walker over one body; `startScanIf` descends an if/else-if chain.
  let si = 0
  while si < startStmts.length {
    const st = P.nodes[startStmts[si]]
    // The function-VALUE call frame is detected over the WHOLE statement, ahead of the
    // shape split below: `blockHasCallRef` recurses into an `if`/`while`/`for` body
    // itself, whereas `startScanBlock`/`startScanIf` run only the walkers that do not.
    // A `call_ref` stages its fat pointer in `callRefSlot`, so a closure call nested in a
    // top-level block needs the frame exactly as a bare top-level call does — without it
    // the start function emits `local.set` against a local it never declared.
    if fnValUsed {
      if blockHasCallRef(startStmts[si], -1) { fnUsesCallRef = true }
    }
    if st is ForRange {
      // The BOUNDS are part of the start function's body — they were handed to
      // nobody, so a `for i in 0 to (g(2) ?? 0) { }` at module scope emitted
      // `fbLocalSet(coalesceCallSlot)` against a local the vector never
      // declared. The in-function twins ARE covered (`blockHasCoalesceCall` /
      // `blockHasArrNew` / `blockHasMapOp` / `blockPushPopBits` all walk
      // `frFrom` / `frTo`), which is why this hid.
      startScanHeaderExpr(st.frFrom)
      startScanHeaderExpr(st.frTo)
      startScanBlock(st.frBody)
    } else if st is ForIn {
      startScanBlock(st.fiBody)
      startScanHeaderExpr(st.fiIter)
      // A BARE map iterable (`for k in m` at module scope) — asked through the
      // emitter's own header predicate, exactly as `blockHasMapOp`'s ForIn arm
      // does for the in-function twin. `exprHasMapOp` claims only the
      // `m.keys()` / `m.values()` Call spellings.
      if forInMapRecv(st.fiIter, -1) >= 0 { fnUsesMap = true }
    } else if st is WhileStmt {
      // The CONDITION, likewise: `startScanBlock` was given only the body.
      startScanHeaderExpr(st.whileCond)
      startScanBlock(st.whileBody)
    } else if st is IfStmt {
      startScanIf(startStmts[si])
    } else {
      // expression statements (a bare call / assignment): the per-statement push
      // detector plus the expr walkers
      applyPushPopBits(stmtPushBits(startStmts[si], -1))
      applyPushPopBits(exprPopBits(startStmts[si], -1))
      if exprHasStrOp(startStmts[si], -1) { fnUsesStrOp = true }
      if exprHasArrNew(startStmts[si]) { fnUsesArrNew = true }
      if exprHasCoalesceCall(startStmts[si]) { fnUsesCoalesceCall = true }
      if exprHasMapOp(startStmts[si], -1) { fnUsesMap = true }
      if stmtIsPushKind(startStmts[si], -1, "ref") {
        recordStartRefPushSlot(startStmts[si])
      }
      collectMemberPopRefSlotsExpr(startStmts[si], -1)
    }
    si = si + 1
  }
  // Variant-rebox stash for the start function: a multi-field CALL result re-boxed into a
  // variant-box union arm in a non-const global initializer or a top-level statement.
  // `blockHasVariantRebox` recurses into for/while/if bodies itself.
  let vrg = 0
  while vrg < globalStmts.length {
    if globalRunsInStartFn(vrg) {
      const vg = P.nodes[globalStmts[vrg]]
      if vg is LetDecl {
        if vg.letInit >= 0 {
          if blockHasVariantRebox(vg.letInit, -1) { fnUsesVariantRebox = true }
        }
      }
    }
    vrg = vrg + 1
  }
  let vrs = 0
  while vrs < startStmts.length {
    if blockHasVariantRebox(startStmts[vrs], -1) { fnUsesVariantRebox = true }
    vrs = vrs + 1
  }
  // List `==`/`!=`/`+` frames (collections-design §VL.4/§VL.6) — non-const
  // global inits and every top-level statement run in the start function.
  fnUsesListEqI = false
  fnUsesListEqS = false
  fnListEqRSlots = []
  fnUsesCloEq = false
  let lgi = 0
  while lgi < globalStmts.length {
    if globalRunsInStartFn(lgi) {
      const lg = P.nodes[globalStmts[lgi]]
      if lg is LetDecl { leqScanExpr(lg.letInit, -1) }
    }
    lgi = lgi + 1
  }
  let lsi = 0
  while lsi < startStmts.length {
    leqScanStmt(startStmts[lsi], -1)
    lsi = lsi + 1
  }
  0
}

// Collect the start function's DECLARED locals from the top-level statements: a
// `for` range loop's var+bound pair (and any `let`s nested in loop/if bodies, via
// the same collectLocals walkers user functions use, with the module-level
// `fnIx = -1`). Resets the local registry + scope stack like `buildLocals`.
function collectStartLocals() {
  localNames = []
  localIsRef = []
  localStructIdx = []
  localLoopVar = []
  localLoopIter = []
  localLitUnion = []
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  scopePush()
  let i = 0
  while i < startStmts.length {
    const s = P.nodes[startStmts[i]]
    if s is ForRange {
      const fvSlot = addLocalName(s.frVar, "i32", -1)
      markLoopVarSlot(fvSlot)
      scopeBind(s.frVar, fvSlot)
      addLocalName(s.frVar + "#b", "i32", -1)
      if collectLocals(s.frBody, -1) < 0 {
        scopePop()
        return -1
      }
      // The loop variable's scope is the loop (see `scopeUnbind`).
      scopeUnbind()
    } else if s is ForIn {
      // The loop-var / cursor / `#l`-temp declaration is `declareForInLocals` — SHARED with
      // the function-scope walk, because a top-level `for` and an in-function `for` need
      // byte-identical slots (`fnIx` -1 is the only difference, and it is a parameter).
      if declareForInLocals(s, -1) < 0 {
        scopePop()
        return -1
      }
      if collectLocals(s.fiBody, -1) < 0 {
        scopePop()
        return -1
      }
      // The loop variable's scope is the loop (see `scopeUnbind`).
      scopeUnbind()
    } else if s is WhileStmt {
      if collectLocals(s.whileBody, -1) < 0 {
        scopePop()
        return -1
      }
    } else if s is IfStmt {
      if collectLocalsIf(startStmts[i], -1) < 0 {
        scopePop()
        return -1
      }
    }
    i = i + 1
  }
  scopePop()
  // The PROMOTED top-level bindings (G2c) claim their slots LAST, after every local the
  // statement walk declared, so a program that promotes nothing emits a byte-identical
  // frame and a program that promotes leaves every other local's index where it was.
  //
  // The slot is registered under `<name>#g`, NOT under the binding's own name. The `#`
  // cannot occur in a source identifier, so nothing resolves to this slot by NAME —
  // `declaredIndexOf`, `scopeSlotOf` and the whole classifier layer keep seeing the
  // binding as the module global it still is in `globalStmts`, and the ONLY reader of
  // the slot is `emitUserGlobalGet`/`emitUserGlobalSet` via `gPromoSlot`. That is what
  // keeps this change to a storage class instead of a rebinding: the kind ladders,
  // niche flags and narrowing tables are untouched.
  let pgi = 0
  while pgi < globalStmts.length {
    if gPromoOk[pgi] == 1 {
      const pg = P.nodes[globalStmts[pgi]]
      if pg is LetDecl {
        // P2 restricted the cell to a plain numeric scalar, so `structIdx` is never
        // consulted and `fbLocalRun(ck, -1)` writes the same valtype byte the cell's
        // `fbValtypeNullable(ck, -1)` would have.
        gPromoSlot[pgi] = addLocalName(
          pg.letName + "#g",
          globalCellKind(globalStmts[pgi]),
          -1,
        )
      }
    }
    pgi = pgi + 1
  }
  localNames.length
}

// Emit the synthetic start function's size-prefixed code entry onto `out` (the code
// section payload). The body runs every NON-const global initializer in declaration
// order — `emitExpr(body, letInit, -1)` at module scope, then `global.set gi` — so
// each cell holds its real value before any other code runs. Frames exactly as
// `emitFuncCode` does: collect locals, detect scratch frames, lay them out with
// `fbBeginFunc`, emit the locals vector (`fbEmitLocalsVec`), then the body and the
// `end`, size-prefixed. Returns 0, or -1 (via `emitFail`).
function emitStartFnCode(out: i32[]) {
  // Locals FIRST, detection SECOND: the scratch detectors classify expressions
  // through the declared-locals registry (`declaredString(k)` for a `print(k)` over
  // a for-in string element), so the registry must be populated before they run —
  // `declaredSlotOf` falls back to the flat `localNames` scan when no scope frame
  // is active, exactly for detection passes. Then the frames follow the locals.
  const nStartLocals = collectStartLocals()
  if nStartLocals < 0 { return -1 }
  startFnDetectScratch()
  // The start function is void, so it has no union-box return to sink, and its top-level
  // bindings take neither sink; clear the flags the last user function left set, or
  // `fbBeginFunc`/`fbLocalsCount`/`fbEmitLocalsVec` would each reserve a frame for it.
  fnUsesUnionSink = false
  fnUsesUnionLetSink = false
  uSinkFired = 0
  fbBeginFunc(0, nStartLocals)

  const bodyExpr: i32[] = []
  const exprPrev = wTarget(bodyExpr)
  // Reset the emit-time scope/loop bookkeeping (the start fn has its own empty frame),
  // mirroring `emitFuncCode` — no leak from the last user function.
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  emitLetCursor = 0
  ctrlDepth = 0
  loopContDepth = []
  loopBrkDepth = []
  loopContLabel = []
  loopBrkLabel = []
  // Non-const global initializers and top-level STATEMENTS run INTERLEAVED in source
  // order (merged on arena index — top-level statements are parsed sequentially, so
  // arena order IS source order): `xs.push(1)` before `const ys = xs.map(f)` must
  // execute before that init. A program with only inits, or only statements, emits
  // the exact same order as the previous inits-then-statements split (every golden
  // has at most one of the two, so the bytes are unchanged). The emit context is
  // module-level (`fnIx = -1`): identifier reads/writes resolve to globals.
  let gi = 0
  let si = 0
  // Post-statement narrowing for the top-level statement list (the assignment
  // narrowing of `pushPostGuardNarrow` — a top-level guard `if` cannot
  // `return`, so only the assignment arm ever fires here). Restored at loop end.
  const savedStartNarrowTop = narrowTop
  // THE PROMOTION CONTEXT WINDOW (G2c): a promoted binding's `local.get`/`local.set`
  // is only meaningful in THIS frame, so the flag that lets `emitUserGlobalGet` /
  // `emitUserGlobalSet` produce one is armed for exactly the span that streams this
  // body. Every user function body has already been emitted by `emitCodeSection` at
  // this point, and the const cells' constexpr inits by `emitGlobalSection` before
  // that; both ran with the flag false, which is what makes a promoted binding
  // reaching them a loud reject rather than a wrong opcode.
  gPromoInStart = true
  while gi < globalStmts.length || si < startStmts.length {
    let takeGlobal = gi < globalStmts.length
    if takeGlobal && si < startStmts.length {
      if startStmts[si] < globalStmts[gi] { takeGlobal = false }
    }
    if takeGlobal {
      if globalRunsInStartFn(gi) {
        const g = P.nodes[globalStmts[gi]]
        if g is LetDecl {
          // Numeric WIDENING at the global-init boundary (a non-const `: f64`/`: f32`/`: i64`
          // global whose init is a narrower numeric — e.g. `const b: f64 = a` with `a: i32`):
          // the `emitExprAs*` helper inserts the lattice convert so the start-fn `global.set`
          // matches the cell valtype. An i32 cell stays byte-identical. (Slice 5 widening.)
          const gck = globalCellKind(globalStmts[gi])
          if gck == "f32" {
            const savedF32 = pendingF32
            pendingF32 = true
            if emitExprAsF32(bodyExpr, g.letInit, -1) < 0 {
              wTarget(exprPrev)
              return -1
            }
            pendingF32 = savedF32
          } else if gck == "f64" {
            if emitExprAsF64(bodyExpr, g.letInit, -1) < 0 {
              wTarget(exprPrev)
              return -1
            }
          } else if gck == "i64" {
            if emitExprAsI64(bodyExpr, g.letInit, -1) < 0 {
              wTarget(exprPrev)
              return -1
            }
          } else {
            // A map global's start-fn init seeds the map SHAPE (mirrors the
            // local-`let` seeding) so `Map()` builds THIS global's map struct.
            if gck == "map" {
              pendingMapSlot = letMapShapeOf(globalStmts[gi], -1)
            }
            // A NULLABLE map global's start-fn init: seed the map SHAPE (`Map()` builds it) and
            // the null heap (a bare `null` init lowers as `ref.null $mapStruct`).
            if gck == "nulmap" {
              const gnmShape = nulMapShapeOf(globalStmts[gi], -1)
              pendingMapSlot = gnmShape
              pendingNulRefHeap = mapTypeIdxOf(gnmShape)
            }
            // A struct / nullable-struct cell seeds the struct context so a bare
            // `null` init lowers as `ref.null $S` and a literal builds THIS
            // global's annotated struct (mirrors the const-path seeding).
            if gck == "struct" || gck == "nulstruct" {
              pendingStructIdx = globalCellStructIdx(globalStmts[gi])
            }
            // A `boolean|null` NICHE global lowers a bare `null` init as the sentinel 2;
            // a `string|null` global lowers it as `ref.null $aTypeIdx` (kind 16).
            pendingNulBool = letIsNulBoolAnn(globalStmts[gi])
            pendingNulString = letIsNulString(globalStmts[gi], -1)
            if letIsLitUnion(globalStmts[gi]) { pendingLitUnion = 1 }
            // A `K | null` NICHE global's start-fn init: a member literal lowers as
            // its atom id, a bare `null` as the `-1` sentinel — the start-fn twin of
            // the const-path seeding (a `null` init routes here; un-seeded it drew
            // the "bare null needs a struct-typed context" loud reject).
            if g.letType >= 0 {
              if nodeTyIsNulLitUnion(g.letType) {
                pendingLitUnion = 1
                pendingNulLitUnion = true
              }
            }
            // A LIST-annotated global seeds the element kind/slot so its literal init builds
            // the annotation's backing+wrapper, exactly as the const-path and the local-`let`
            // path seed it (0 for a non-list annotation — a no-op). A closure-array's
            // function-ident elements aren't an objlit (`arrLitIsRef` misses them), and a
            // scalar f64[]/i64[]/f32[] literal of bare INT elements doesn't self-identify —
            // without the seed the start-fn init falls to the i32-list path and its wrapper
            // mismatches the cell's (`const xs: f64[] = [-2]`, non-const via the negation).
            pendingListKind = letAnnRefListKind(globalStmts[gi])
            pendingListSlot = letAnnRefListSlot(globalStmts[gi])
            // THE THREE NULLABLE-LIST CELL SEEDS. A bare `null` is never a WasmGC
            // constexpr (`isConstInit` has no `NullLit` arm), so EVERY `= null` global
            // routes here — this block, not the global section's constexpr arm, is the
            // one place a global cell's null rep is decided. The kinds above (map /
            // struct / bool / string / litunion / closure) were each seeded as they were
            // added; the three LIST cells never were, and a plain
            // `const g: i32[] | null = null` therefore reached `emitNullLitNode` with an
            // empty context and rejected the whole module — while the same annotation on
            // a LOCAL lowered fine (`emitLetDeclStmt`'s kind ladder seeds all three).
            // Each mirrors that ladder exactly.
            //
            // Kind 15, the i32-backed `i32[] | null`: `ref.null $lTypeIdx`.
            const savedSNL = pendingNulList
            if gck == "nullist" { pendingNulList = true }
            // The DISTINCT-backing nullable scalar lists (`string[]|null`, `f64[]|null`,
            // `i64[]|null`, `f32[]|null`): `ref.null $wrapper` for a bare `null`, and the
            // leaf build code so a LIST-valued init builds that same wrapper rather than
            // the i32 list. `nulScalarListWrapHeap` is -1 / `nulScalarListBuildKind` 0 for
            // every other kind, so both are inert elsewhere.
            const gSLK = nulScalarListBuildKind(gck)
            if gSLK != 0 { pendingListKind = gSLK }
            const gSLH = nulScalarListWrapHeap(gck)
            if gSLH >= 0 { pendingNulRefHeap = gSLH }
            // Kind 18, a nullable REF array (`i32[][] | null`, `S[] | null`): the null is
            // THIS global's element wrapper (`rlWrapIdx[slot]`), the same slot the cell's
            // valtype selects at `emitGlobalSection`. Armed ONLY when the initializer IS a
            // bare `null` — the #964 SEED-LEAK gate the local ladder and the call-argument
            // boundary both spell, and it is load-bearing here: a LIST-literal init whose
            // ELEMENT is null (`const g: (S | null)[] | null = [null]`) must lower that
            // element as `ref.null $S`, and an un-gated seed retypes it to the wrapper —
            // `array.new_fixed[0] expected (ref null $S), found ref.null $rlWrap`.
            if gck == "nulreflist" {
              if pendingListSlot >= 0 && pendingListSlot < rlWrapIdx.length {
                const gnraInit = P.nodes[unwrapParen(g.letInit)]
                if gnraInit is NullLit {
                  pendingNulRefHeap = rlWrapIdx[pendingListSlot]
                }
              }
            }
            // A nullable-CLOSURE global (kind 19) lowers a bare `null` init as
            // `ref.null $cloStruct`; a function init builds the (non-null) closure value.
            const savedSNC = pendingNulClosure
            if gck == "nulclosure" { pendingNulClosure = true }
            // A UNION cell (kind 4) coerces a raw init value into the box
            // (`let w: string | i32 = n` boxes the i32 read) — a union-valued
            // init (a union-returning call) passes through unchanged.
            let gun = ""
            if gck == "union" { gun = letUnionNameOf(globalStmts[gi], -1) }
            // A module-level `let f = add` aliasing a GENERIC (un-annotated-param) named
            // function, used only as a direct-call callee: the closure through the floor-LESS
            // core, the start-fn twin of the const-cell arm in `emitGlobalSection`.
            const gAliasFe = monoGenericAliasFe(globalStmts[gi])
            if gun != "" {
              if emitUnionCoerce(bodyExpr, gun, g.letInit, -1) < 0 {
                wTarget(exprPrev)
                return -1
              }
            } else if gAliasFe >= 0 {
              if emitClosureValueCore(bodyExpr, gAliasFe, -1) < 0 {
                wTarget(exprPrev)
                return -1
              }
            } else if (
              (gck == "str" || gck == "nulstr") &&
              globalInitIsLitAtom(g.letInit)
            ) {
              // A literal-union atom initializing a `string` global widens to its member string.
              // The start fn is a real function, so the runtime widening tower runs here (unlike a
              // CONST global, whose constexpr init has no `select`/scratch).
              if emitAtomToStr(bodyExpr, g.letInit, -1) < 0 {
                wTarget(exprPrev)
                return -1
              }
            } else {
              if emitExpr(bodyExpr, g.letInit, -1) < 0 {
                wTarget(exprPrev)
                return -1
              }
            }
            pendingNulBool = false
            pendingNulString = false
            pendingNulClosure = savedSNC
            pendingNulList = savedSNL
            pendingMapSlot = -1
            pendingStructIdx = -1
            pendingListKind = 0
            pendingListSlot = 0
            pendingLitUnion = 0
            pendingNulLitUnion = false
            // The ref-heap seed is consumed-and-cleared by `emitNullLitNode`, but a
            // NON-null init leaves it armed — so clear it here too, else the next
            // global's bare `null` would take THIS global's wrapper. (The `nulmap` arm
            // above has always seeded it; the two list arms added here do too.)
            pendingNulRefHeap = -1
          }
          const setPrev = wTarget(bodyExpr)
          if emitUserGlobalSet(gi) < 0 {
            wTarget(setPrev)
            wTarget(exprPrev)
            return -1
          }
          wTarget(setPrev)
        }
      }
      gi = gi + 1
    } else {
      if emitStmt(bodyExpr, startStmts[si], -1) < 0 {
        wTarget(exprPrev)
        return -1
      }
      pushPostGuardNarrow(startStmts[si], -1)
      si = si + 1
    }
  }
  // Close the promotion window. The `return -1` paths above leave it armed, which is
  // inert: a failed body aborts the whole module emit, and `computeGlobalPromotion`
  // clears the flag at the top of the next one.
  gPromoInStart = false
  restoreNarrow(savedStartNarrowTop)
  wTarget(exprPrev)

  const body: i32[] = []
  // Locals vector: the start fn's declared locals (for-loop vars), then the scratch frames.
  if fbEmitLocalsVec(body, nStartLocals) < 0 { return -1 }
  appendAll(body, bodyExpr)
  const endPrev = wTarget(body)
  fbEnd() // 0x0b end (void → void: stack already empty)
  wTarget(endPrev)

  const outPrev = wTarget(out)
  wULEB(body.length)
  wBytes(body)
  wTarget(outPrev)
  0
}

// The synthetic `__log__(offset, length)` decoder body: walk the tag/value pairs in
// linear memory ([offset, offset+length), 8 bytes per pair) and print each value.
// Mirrors the host runner's `__log__` import (compile.ts `runWasm`): tag 0 = plain
// i32, printed via `__print_i32__` (import 0 — `memLogUsed` forces the print family).
// A non-zero tag (i64/f32/f64 payloads, which span extra words) traps (`unreachable`)
// — no corpus program logs them natively yet, and a silent wrong decode is worse.
// DIVERGENCE (justified): the host joins a multi-pair log into ONE space-separated
// line; this prints one line per pair. Every corpus `__log__` call logs exactly one
// pair, so stdout is identical.
function emitMemLogFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  // Locals vector: params occupy 0 (offset) and 1 (length); local 2 is the cursor.
  wULEB(1)      // 1 locals run
  wULEB(1)      // count 1
  wU8(127)      // 0x7f i32
  fbLocalGet(0)
  fbLocalSet(2) // cursor = offset
  fbBlock(64)   // block (void)
  fbLoop(64)    // loop (void)
  fbLocalGet(2)
  fbLocalGet(0)
  fbLocalGet(1)
  fbI32Bin(106) // 0x6a i32.add — offset + length (the end)
  fbI32Bin(78)  // 0x4e i32.ge_s — cursor >= end?
  fbBrIf(1)     // exit the block
  fbLocalGet(2)
  fbI32Load()   // the pair's TAG
  fbIf(64)      // tag != 0 → unsupported payload kind
  fbUnreachable()
  fbEnd()
  fbLocalGet(2)
  fbI32Const(4)
  fbI32Bin(106) // i32.add — the value word
  fbI32Load()
  fbCall(0)     // __print_i32__ (import 0)
  fbLocalGet(2)
  fbI32Const(8)
  fbI32Bin(106) // i32.add
  fbLocalSet(2) // cursor += 8
  fbBr(0)       // next pair
  fbEnd()       // end loop
  fbEnd()       // end block
  fbEnd()       // 0x0b end (void function: stack empty)
  wTarget(prev)
  const outPrev = wTarget(out)
  wULEB(body.length)
  wBytes(body)
  wTarget(outPrev)
  0
}

// ── shared runtime helper BODIES (module-tail functions) ──────────────────────
// Each body below is the once-per-module copy of machinery every lowering site
// used to inline (see `gHelpStrHash` & co. in emit_state). Hand-rolled like the
// `__log__` decoder above: a locals vector, then straight `fb*` opcodes against
// wasm param/local indices (no scratch-frame indirection — params ARE the frame).

// Frame a finished helper body (locals vec + code already in `body`) onto `out`.
function helpFrameBody(out: i32[], body: i32[]) {
  const outPrev = wTarget(out)
  wULEB(body.length)
  wBytes(body)
  wTarget(outPrev)
  0
}

// One `h = (h ^ s[i + k]) * 16777619` step of the FNV chain, against the
// `__str_hash__` frame (s = param 0, h = local 1, i = local 2). `k == 0` skips
// the offset add. Shared by the unrolled block and the remainder loop so the two
// cannot drift into hashing differently.
function fbStrHashStep(k: i32) {
  fbLocalGet(1)
  fbLocalGet(0)
  fbLocalGet(2)
  if k != 0 {
    fbI32Const(k)
    fbI32Bin(106) // i32.add (i + k)
  }
  fbArrayGet(aTypeIdx)
  fbI32Bin(115) // 0x73 i32.xor
  fbI32Const(16777619)
  fbI32Bin(108) // 0x6c i32.mul
  fbLocalSet(1)
  0
}

// `__str_hash__(s) -> i32`: the masked non-negative FNV-1a hash of a string —
// `h = 2166136261; for c in s { h = (h ^ c) * 16777619 }; h & 0x7fffffff`. The
// 32-bit wasm `i32.mul` wraps exactly as the host's hash does. Params: s(0).
// Locals: h(1), i(2), n(3), lim(4).
//
// The walk is UNROLLED FOUR WIDE, then a scalar remainder loop finishes the tail —
// the same shape `__str_eq__` uses, and `lim = n - 4` is likewise a SUBTRACTION so
// a maximal-length string cannot overflow the gate (`n` is an `array.len`, while
// `i + 4` could wrap). For `n < 4` the limit goes negative, `i > lim` is true at
// `i = 0`, and every element is answered by the remainder loop, so short strings
// skip the wide block entirely instead of paying a wasted test.
//
// FNV is a SERIAL dependency chain — each `i32.mul` waits on the previous `h` — so
// the unroll cannot overlap the arithmetic; what it removes is the per-element loop
// control, and `n` is hoisted because a reference local lives in a stack-map slot,
// making `local.get 0; array.len` a memory LOAD on every iteration rather than a
// loop-invariant the engine can hoist. Measured on a 1k-entry / 8M-lookup probe at
// 46-char keys: 2.13 → 1.10 ns per code point, which is ~3 cycles/point and hence
// the `i32.mul` latency floor. Widening to eight is measurably WORSE (more code,
// same chain), and no further unroll can help — the loop is now
// dependency-bound, not overhead-bound. That floor is also what bounds any
// hash-CACHING scheme, and the bound has been measured rather than argued: replacing
// this walk with a constant-time one is worth 1.88x per lookup at ~97-char keys, 1.33x
// at ~33, and NOTHING at ~9 — the length a real key usually is.
function emitStrHashFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(1)                // 1 locals run
  wULEB(4)                // count 4
  wU8(127)                // 0x7f i32
  fbI32Const(-2128831035) // 2166136261 as signed (the FNV offset basis)
  fbLocalSet(1)           // h
  fbI32Const(0)
  fbLocalSet(2)           // i = 0
  fbLocalGet(0)           // s
  fbArrayLen()
  fbLocalSet(3)           // n = array.len(s)
  fbLocalGet(3)
  fbI32Const(4)
  fbI32Bin(107)           // i32.sub
  fbLocalSet(4)           // lim = n - 4
  // Wide block: while i <= lim { 4 chained steps ; i += 4 }
  fbLoop(64)    // loop, void
  fbLocalGet(2) // i
  fbLocalGet(4) // lim
  fbI32Bin(74)  // 0x4a i32.gt_s (i > lim → no full block fits)
  fbIf(64)      // then: done (empty)
  fbElse()
  fbStrHashStep(0)
  fbStrHashStep(1)
  fbStrHashStep(2)
  fbStrHashStep(3)
  fbLocalGet(2)
  fbI32Const(4)
  fbI32Bin(106) // i32.add
  fbLocalSet(2) // i += 4
  fbBr(1)       // → loop header
  fbEnd()       // end (gt_s if)
  fbEnd()       // end (wide loop)
  // Remainder: while i < n { one step ; i += 1 }
  fbLoop(64)    // loop, void
  fbLocalGet(2) // i
  fbLocalGet(3) // n
  fbI32Bin(78)  // 0x4e i32.ge_s (i >= n → done)
  fbIf(64)      // then: done (empty)
  fbElse()
  fbStrHashStep(0)
  fbLocalGet(2)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(2)
  fbBr(1)       // → loop header
  fbEnd()       // end (ge_s if)
  fbEnd()       // end (remainder loop)
  // h & 0x7fffffff — force non-negative (the result).
  fbLocalGet(1)
  fbI32Const(2147483647)
  fbI32Bin(113) // 0x71 i32.and
  fbEnd()       // end (function) — leaves the i32 result
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_eq__(a, b) -> i32`: element-wise string value-equality — 0 if the lengths
// differ or any code point differs, else 1. Params: a(0), b(1). Locals: n(2), i(3),
// lim(4).
//
// The element walk is UNROLLED EIGHT WIDE over an xor/or accumulator, then a
// scalar remainder loop finishes the tail. Eight `a[i+k] ^ b[i+k]` values are
// or-ed together and tested ONCE, so a full block costs one branch instead of
// eight; the accumulator lives entirely on the wasm value stack and needs no
// local. WasmGC has no instruction that compares more than one array element at a
// time, so this is the whole of the available win — it removes branch and
// loop-control overhead, not loads.
//
// `lim = n - 8` is the last index at which a full block still fits, and the gate
// is `i > lim`, which is why it is computed as a SUBTRACTION rather than as
// `i + 8 > n`: `n` is an `array.len` and cannot overflow the subtraction, while
// `i + 8` on a maximal-length string could. For `n < 8` the limit goes negative,
// `i > lim` is true at `i = 0`, and every element is answered by the remainder
// loop — so the short strings that dominate real programs skip the wide loop
// entirely rather than paying a wasted test. Because the block runs only when
// `i <= n - 8`, every index it touches is `< n`; the unroll cannot read past the
// end of either operand.
//
// IDENTITY FAST PATH (`ref.eq`) — the twelve bytes that pay for themselves. A
// string is `(array (mut i32))`, hence an `eqref`, so the two operands can be
// compared BY REFERENCE before anything is read. Same reference ⇒ equal, always:
// there is no aliasing case where an array is unequal to itself, and a length-0
// string already answered 1 down the slow path. So this is a pure short-circuit,
// not a semantic change — every input that reached `1` still reaches `1`, and
// every input that reached `0` still walks (distinct references fall through).
//
// It pays because the string-literal POOL (`emit_state.vl`'s `gStrPoolTexts` /
// `gStrPoolIx`, consumed by `emitStr`) interns every distinct string LITERAL in
// the program as ONE immutable module global: a literal occurrence
// lowers to `global.get`, so the SAME `"IDENT"` in twelve source files is one
// object. Every compare of a pooled literal against a value that came FROM that
// literal — `tok.kind == "IDENT"`, a rep-tree tag, a canonical type spelling —
// is therefore reference-identical and now costs `ref.eq` instead of a walk over
// up to N code points. Measured on a self-compile: `__str_eq__` 424.7 → 360.1
// samples/run (−15.2%) and the whole compile −3.8% (perf-program.md §10).
//
// The NULL corner is stated rather than left to be discovered, and it was
// MEASURED rather than argued: `ref.eq(null, null)` would answer 1 where the old
// body reached `array.len` on a null and TRAPPED. It is unreachable — a
// `string | null` operand is unwrapped BEFORE the call, so `a == b` with both
// null traps upstream of this helper. Both compilers run the probe (two null
// `string | null` values compared with `==`) to the same `wasm trap: null
// reference` at the same address; a reachable corner would have printed `EQ`.
function emitStrEqFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(1)     // 1 locals run
  wULEB(3)     // count 3
  wU8(127)     // 0x7f i32
  fbBlock(127) // block i32 — yields the 0/1 result
  // if ref.eq(a, b) { 1 ; br out }
  fbLocalGet(0)
  fbLocalGet(1)
  wU8(211) // 0xd3 ref.eq
  fbIf(64) // if, void
  fbI32Const(1)
  fbBr(1)  // → out of the i32 block
  fbEnd()
  // n = len(a) ; if n != len(b) { 0 ; br out }
  fbLocalGet(0)
  fbArrayLen()
  fbLocalSet(2) // n
  fbLocalGet(2)
  fbLocalGet(1)
  fbArrayLen()
  fbI32Bin(71)  // 0x47 i32.ne
  fbIf(64)      // if, void
  fbI32Const(0)
  fbBr(1)       // → out of the i32 block
  fbEnd()
  // i = 0
  fbI32Const(0)
  fbLocalSet(3)
  // SHORT-STRING GATE: skip the wide loop and its setup entirely unless a full
  // block can run at least once. Strings shorter than the unroll factor are the
  // common case in real programs (identifiers, keywords, tags), and for them the
  // whole wide region is dead weight — one compare here replaces the limit
  // computation plus a wide-loop trip test that could never succeed.
  fbLocalGet(2)
  fbI32Const(8)
  fbI32Bin(78) // 0x4e i32.ge_s (n >= 8)
  fbIf(64)     // if, void
  // lim = n - 8 — the last start index at which a full eight-element block fits.
  fbLocalGet(2)
  fbI32Const(8)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(4)
  fbLoop(64)    // loop (eight wide), void
  fbLocalGet(3)
  fbLocalGet(4)
  fbI32Bin(74)  // 0x4a i32.gt_s (i > lim → no full block left)
  fbIf(64)      // then: done (empty)
  fbElse()
  // acc = (a[i]^b[i]) | (a[i+1]^b[i+1]) | ... | (a[i+7]^b[i+7]), on the stack.
  let k = 0
  while k < 8 {
    fbLocalGet(0) // a
    fbLocalGet(3) // i
    if k > 0 {
      fbI32Const(k)
      fbI32Bin(106) // i32.add
    }
    fbArrayGet(aTypeIdx)
    fbLocalGet(1) // b
    fbLocalGet(3) // i
    if k > 0 {
      fbI32Const(k)
      fbI32Bin(106) // i32.add
    }
    fbArrayGet(aTypeIdx)
    fbI32Bin(115) // 0x73 i32.xor — 0 exactly when the pair matches
    if k > 0 {
      fbI32Bin(114) // 0x72 i32.or — fold into the accumulator
    }
    k = k + 1
  }
  // A non-zero accumulator means at least one of the eight pairs differed.
  fbIf(64)
  fbI32Const(0)
  fbBr(4) // → out of: if(0)·else(1)·loop(2)·n>=8 if(3)·block(4)
  fbEnd()
  // i = i + 8
  fbLocalGet(3)
  fbI32Const(8)
  fbI32Bin(106)
  fbLocalSet(3)
  fbBr(1) // → loop header
  fbEnd() // end (gt_s if/else)
  fbEnd() // end (eight-wide loop)
  fbEnd() // end (n >= 8 if)
  // Scalar remainder: the fewer than eight elements the wide loop could not cover.
  fbLoop(64)   // loop, void
  fbLocalGet(3)
  fbLocalGet(2)
  fbI32Bin(78) // i32.ge_s (i >= n → done)
  fbIf(64)     // then: done (empty)
  fbElse()
  // if a[i] != b[i] { 0 ; br out }
  fbLocalGet(0)
  fbLocalGet(3)
  fbArrayGet(aTypeIdx)
  fbLocalGet(1)
  fbLocalGet(3)
  fbArrayGet(aTypeIdx)
  fbI32Bin(71) // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(3)      // → out of: if(0)·else(1)·loop(2)·block(3)
  fbEnd()
  // i = i + 1
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(3)
  fbBr(1)       // → loop header
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  fbI32Const(1) // every element matched
  fbEnd()       // end (block)
  fbEnd()       // end (function) — leaves the 0/1 result
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_concat__(a, b) -> (ref str)`: allocate a fresh `lenA + lenB` string and
// `array.copy` both operands in. Params: a(0), b(1). Locals: lenA(2), lenB(3) i32;
// out(4) a NON-NULL `(ref $aTypeIdx)` (set before every read — validation accepts
// a non-defaultable local under init tracking).
function emitStrConcatFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(2) // 2 locals runs
  wULEB(2) // count 2
  wU8(127) // 0x7f i32 (lenA, lenB)
  wULEB(1) // count 1
  wU8(100) // 0x64 (ref $aTypeIdx) — out
  wSLEB(aTypeIdx)
  // lenA = len(a) ; lenB = len(b)
  fbLocalGet(0)
  fbArrayLen()
  fbLocalSet(2)
  fbLocalGet(1)
  fbArrayLen()
  fbLocalSet(3)
  // out = array.new_default $aTypeIdx (lenA + lenB)
  fbLocalGet(2)
  fbLocalGet(3)
  fbI32Bin(106) // i32.add
  fbArrayNewDefault(aTypeIdx)
  fbLocalSet(4)
  // array.copy out 0 a 0 lenA
  fbLocalGet(4)
  fbI32Const(0)
  fbLocalGet(0)
  fbI32Const(0)
  fbLocalGet(2)
  fbArrayCopy(aTypeIdx, aTypeIdx)
  // array.copy out lenA b 0 lenB
  fbLocalGet(4)
  fbLocalGet(2)
  fbLocalGet(1)
  fbI32Const(0)
  fbLocalGet(3)
  fbArrayCopy(aTypeIdx, aTypeIdx)
  fbLocalGet(4)
  fbEnd() // end (function) — leaves the fresh string ref
  wTarget(prev)
  helpFrameBody(out, body)
}

// THE INDEX-CAPACITY POWER-OF-TWO INVARIANT, which both probe helpers and the
// rehash rely on to wrap with `i32.and` instead of `i32.rem_u` (a hardware
// divide on every probe and every collision step). The `index` array's length is
// a power of two at every point in a map's life, from its only three producers:
//   · `emitMapNew` allocates it at INITIAL_CAP*2 = 16;
//   · `__map_resize__` (`emitMapResizeFnCode`) replaces it with `2 * len(index)`;
//   · `emitMapCompact` rebuilds it at `cap = 16; while cap < 2*size { cap *= 2 }`.
// There is exactly one `struct.new` of a map struct and exactly two writes to its
// `index` field, so this list is the whole population — a fourth producer that
// did not preserve the invariant would silently corrupt every probe, so add one
// only together with a `mask = cap - 1` that is still `cap - 1` for it.
//
// `__map_probe__(keyHash, index, hashes, live, keysBacking, key) -> i32`: linear-probe
// (wrapping) from the key's hash to the slot holding either the matching key's entry or
// a free (0) slot — the shared core of every map op. The stored per-entry hash gates the
// string compare, and a tombstoned entry (`live[entry-1] == 0`) probes past (a marker,
// not a hit) — see `emitMapProbe`'s caller-side contract. Returns the PROBE SLOT; the
// caller re-reads `index[slot]` for the entry.
//
// The hash arrives as a PARAM rather than being walked here, because an appending
// `m[k] = v` has to store that same hash into `hashes[]` right after the probe: computing
// it once at the call site is the difference between one `__str_hash__` walk per insert
// and two. It leads the operand list so the call site can emit it FIRST, on an empty
// operand stack — hashing after the four backing `struct.get`s would leave four GC refs
// live across the `__str_hash__` call, which the engine must spill and reload per probe.
// Params: keyHash(0), index(1), hashes(2), live(3), keysBack(4), key(5).
// Locals: mask(6), slot(7), entry(8).
function emitMapProbeFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(1) // 1 locals run
  wULEB(3) // count 3
  wU8(127) // 0x7f i32
  // mask = array.len(index) - 1  (the index length is a power of two)
  fbLocalGet(1)
  fbArrayLen()
  fbI32Const(1)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(6)
  // slot = keyHash & mask   (== keyHash % cap)
  fbLocalGet(0)
  fbLocalGet(6)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(7)
  fbBlock(64)   // block (probe break target), void
  fbLoop(64)    // loop, void
  // entry = index[slot] ; if entry == 0 { br out (miss) }
  fbLocalGet(1)
  fbLocalGet(7)
  fbArrayGet(aTypeIdx)
  fbLocalSet(8)
  fbLocalGet(8)
  fbI32Eqz()
  fbBrIf(1) // → out of the probe block
  // hashes[entry-1] == keyHash && live[entry-1] != 0
  //   ? __str_eq__(keysBack[entry-1], key) : 0
  fbLocalGet(2)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)        // i32.sub (entry - 1)
  fbArrayGet(aTypeIdx)
  fbLocalGet(0)
  fbI32Bin(70)         // 0x46 i32.eq
  fbLocalGet(3)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71)         // 0x47 i32.ne (live != 0)
  fbI32Bin(113)        // 0x71 i32.and — the expensive compare rides an `if`
  fbIf(127)            // if, i32 blocktype
  fbLocalGet(4)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(mkArrIdx) // keysBack[entry-1] — (ref null $aTypeIdx)
  fbRefAsNonNull()     // a stored slot is populated
  fbLocalGet(5)
  fbCall(gHelpStrEq)
  fbElse()
  fbI32Const(0)        // hash/live mismatch → not a hit
  fbEnd()
  // if match { br out (hit) }
  fbBrIf(1)
  // slot = (slot + 1) & mask  (collision OR a tombstone marker: keep probing)
  fbLocalGet(7)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(6)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(7)
  fbBr(0)       // → loop header
  fbEnd()       // end (loop)
  fbEnd()       // end (probe block)
  fbLocalGet(7) // the probe slot
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__map_probe_i32__(index, hashes, live, keysBacking, key) -> i32`: the i32-KEYED
// twin of `__map_probe__`, line for line, with three substitutions — the key is hashed
// by the integer mix (`fbI32HashMix`) instead of `__str_hash__`, the stored-hash gate
// falls through to an `i32.eq` on the key instead of a call into `__str_eq__`, and the
// mix stays INSIDE this helper where the string hash is passed in. That last one is the
// deliberate asymmetry: the string hash is a call over an O(len) walk, so hoisting it to
// the call site saves a whole second walk on an appending insert, while the i32 mix is
// eight inline instructions — hoisting it would copy them into every probe site to save
// one insert-only mix. Everything else (the wrapping linear probe, the free-slot break,
// the tombstone skip, the entry+1 encoding) is IDENTICAL, which is what lets both key
// kinds share `__map_resize__`, the rehash and the compaction. Params: index(0),
// hashes(1), live(2), keysBack(3), key(4). Locals: mask(5), keyHash(6), slot(7),
// entry(8).
function emitMapProbeI32FnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(1) // 1 locals run
  wULEB(4) // count 4
  wU8(127) // 0x7f i32
  // mask = array.len(index) - 1  (the index length is a power of two)
  fbLocalGet(0)
  fbArrayLen()
  fbI32Const(1)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(5)
  // keyHash = mix(key)
  fbI32HashMix(4, 6)
  fbLocalSet(6)
  // slot = keyHash & mask   (== keyHash % cap)
  fbLocalGet(6)
  fbLocalGet(5)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(7)
  fbBlock(64)   // block (probe break target), void
  fbLoop(64)    // loop, void
  // entry = index[slot] ; if entry == 0 { br out (miss) }
  fbLocalGet(0)
  fbLocalGet(7)
  fbArrayGet(aTypeIdx)
  fbLocalSet(8)
  fbLocalGet(8)
  fbI32Eqz()
  fbBrIf(1) // → out of the probe block
  // hashes[entry-1] == keyHash && live[entry-1] != 0
  //   ? keysBack[entry-1] == key : 0
  fbLocalGet(1)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)        // i32.sub (entry - 1)
  fbArrayGet(aTypeIdx)
  fbLocalGet(6)
  fbI32Bin(70)         // 0x46 i32.eq
  fbLocalGet(2)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71)         // 0x47 i32.ne (live != 0)
  fbI32Bin(113)        // 0x71 i32.and
  fbIf(127)            // if, i32 blocktype
  fbLocalGet(3)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTypeIdx) // keysBack[entry-1] — a raw i32
  fbLocalGet(4)
  fbI32Bin(70)         // 0x46 i32.eq
  fbElse()
  fbI32Const(0)        // hash/live mismatch → not a hit
  fbEnd()
  // if match { br out (hit) }
  fbBrIf(1)
  // slot = (slot + 1) & mask  (collision OR a tombstone marker: keep probing)
  fbLocalGet(7)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(5)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(7)
  fbBr(0)       // → loop header
  fbEnd()       // end (loop)
  fbEnd()       // end (probe block)
  fbLocalGet(7) // the probe slot
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__map_resize__(index, hashes, live, count, size) -> (ref $aTypeIdx)`: when the
// load factor crosses 1/2 (`size*2 >= len(index)`) allocate a doubled index and
// RE-PLACE every LIVE entry from its STORED hash (no key re-hashing — mirrors
// `emitMapRehashTo`), returning the fresh backing; otherwise return `index`
// unchanged. The caller unconditionally stores the result back into `M.index`
// (its own map struct type — the one shape-typed step stays at the call site).
// Params: index(0), hashes(1), live(2), count(3), size(4). Locals: newCap(5),
// i(6), rslot(7) i32; newIdx(8) a non-null `(ref $aTypeIdx)` (set before read).
function emitMapResizeFnCode(out: i32[]) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(2) // 2 locals runs
  wULEB(3) // count 3
  wU8(127) // 0x7f i32 (newCap, i, rslot)
  wULEB(1) // count 1
  wU8(100) // 0x64 (ref $aTypeIdx) — newIdx
  wSLEB(aTypeIdx)
  // if size * 2 >= len(index) { grow + rehash + early-return newIdx }
  fbLocalGet(4)
  fbI32Const(2)
  fbI32Bin(108) // i32.mul (size * 2)
  fbLocalGet(0)
  fbArrayLen()
  fbI32Bin(79)  // 0x4f i32.ge_u
  fbIf(64)      // if, void
  // newCap = 2 * len(index) ; newIdx = array.new_default $aTypeIdx newCap
  fbLocalGet(0)
  fbArrayLen()
  fbI32Const(2)
  fbI32Bin(108)
  fbLocalSet(5)
  fbLocalGet(5)
  fbArrayNewDefault(aTypeIdx)
  fbLocalSet(8)
  // i = 0
  fbI32Const(0)
  fbLocalSet(6)
  // loop { if i >= count {} else { re-place LIVE entry i ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(6)
  fbLocalGet(3)
  fbI32Bin(78) // i32.ge_s (i >= count → done)
  fbIf(64)     // then: done (empty)
  fbElse()
  // if live[i] != 0 { rslot = hashes[i] % newCap ; probe free ; newIdx[rslot] = i+1 }
  fbLocalGet(2)
  fbLocalGet(6)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71) // i32.ne
  fbIf(64)
  // rslot = hashes[i] % newCap — RE-PLACE FROM THE STORED HASH
  fbLocalGet(1)
  fbLocalGet(6)
  fbArrayGet(aTypeIdx)
  fbLocalGet(5)
  fbI32Bin(112) // i32.rem_u
  fbLocalSet(7)
  // while newIdx[rslot] != 0 { rslot = (rslot + 1) % newCap }
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(8)
  fbLocalGet(7)
  fbArrayGet(aTypeIdx)
  fbI32Eqz()
  fbBrIf(1) // → out of the inner block
  fbLocalGet(7)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(5)
  fbI32Bin(112)
  fbLocalSet(7)
  fbBr(0)   // → inner loop header
  fbEnd()   // end (inner loop)
  fbEnd()   // end (inner block)
  // newIdx[rslot] = i + 1
  fbLocalGet(8)
  fbLocalGet(7)
  fbLocalGet(6)
  fbI32Const(1)
  fbI32Bin(106)
  fbArraySet(aTypeIdx)
  fbEnd() // end (live if)
  // i = i + 1
  fbLocalGet(6)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(6)
  fbBr(1)       // → outer loop header
  fbEnd()       // end (ge_s if)
  fbEnd()       // end (outer loop)
  fbLocalGet(8)
  fbReturn()    // the fresh, rebuilt index
  fbEnd()       // end (resize if)
  fbLocalGet(0) // load factor fine → the index unchanged
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// Emit the wasm "name" custom section (section id 0, name "name") so a wasmtime
// trap backtrace shows real function names instead of `<wasm function N>`. GATED
// on `gEmitNames` — a no-op when off, so the default emit path (goldens +
// fixpoints) is byte-identical. `n` is the user-function count (`fnStmts.length`)
// and `gImports` the imported-function count (0 or 4); the imports occupy wasm
// indices 0..gImports-1 (the print family), the user functions gImports..gImports+n-1.
//
// Layout (per the WebAssembly name-section appendix):
//   section: id 0, ULEB(size), wName("name"), <subsections>
//   module-name  subsection (id 0): ULEB(size), wName("vl")
//   function-name subsection (id 1): ULEB(size), namemap
//     namemap = ULEB(count), then count * { ULEB(funcidx), wName(name) }
//   indices MUST be strictly increasing — we emit imports (0..3) then user
//   functions in their natural index order, so the sequence is already sorted.
function emitNameSection(n: i32) {
  if gEmitNames == 0 { return 0 }

  // ── function-name subsection (id 1) ──────────────────────────────────────────
  // Build the namemap (count + entries) into a temp buffer, then frame it as the
  // subsection payload. The print imports (if present) are named first at their
  // hardcoded indices 0..3, then each user function at `gImports + i`.
  const fnameMap: i32[] = []
  const mapPrev = wTarget(fnameMap)
  let count = gImports + n
  if gHelpStrHash >= 0 { count = count + 3 }
  if gHelpMapProbe >= 0 { count = count + 2 }
  if gHelpMapProbeI32 >= 0 { count = count + 1 }
  wULEB(count)
  if gImports > 0 {
    wULEB(0)
    wName("__print_i32__")
    wULEB(1)
    wName("__print_bool__")
    wULEB(2)
    wName("__print_char__")
    wULEB(3)
    wName("__print_str_flush__")
    // The 5th import (index 4) is named only when an i64 program prints.
    if gNeedsI64Print {
      wULEB(4)
      wName("__print_i64__")
    }
    // The `__print_f64__` import is named at its computed index (`gF64PrintIdx`, 4 or 5).
    if gNeedsF64Print {
      wULEB(gF64PrintIdx)
      wName("__print_f64__")
    }
    // The `__print_f32__` import is named at its computed index (`gF32PrintIdx`, 4/5/6).
    if gNeedsF32Print {
      wULEB(gF32PrintIdx)
      wName("__print_f32__")
    }
  }
  let fi = 0
  while fi < n {
    const fn = P.nodes[fnStmts[fi]]
    if fn is FuncDecl {
      wULEB(gImports + fi)
      // Prefer a lambda's DEBUG display name (its binding, `const foo = …` → "foo")
      // over the synthesized `__lambda_N`, so a trap backtrace reads `foo`.
      const disp = fnDispNames[fi]
      if disp.length > 0 { wName(disp) } else { wName(fn.fnName) }
    }
    fi = fi + 1
  }
  // The shared runtime helpers (module-tail indices — after the start fn and the
  // `__log__` decoder, so the namemap stays strictly increasing).
  if gHelpStrHash >= 0 {
    wULEB(gHelpStrHash)
    wName("__str_hash__")
    wULEB(gHelpStrEq)
    wName("__str_eq__")
    wULEB(gHelpStrConcat)
    wName("__str_concat__")
  }
  if gHelpMapProbe >= 0 {
    wULEB(gHelpMapProbe)
    wName("__map_probe__")
    wULEB(gHelpMapResize)
    wName("__map_resize__")
  }
  if gHelpMapProbeI32 >= 0 {
    wULEB(gHelpMapProbeI32)
    wName("__map_probe_i32__")
  }
  wTarget(mapPrev)

  // ── assemble the section payload: wName("name") + the two subsections ─────────
  const namePayload: i32[] = []
  const npPrev = wTarget(namePayload)
  wName("name")
  // module-name subsection (id 0): a single name. Its payload is a length-prefixed
  // name, built into a temp so the subsection-size ULEB frames the right length.
  const modName: i32[] = []
  const mnPrev = wTarget(modName)
  wName("vl")
  wTarget(mnPrev)
  wU8(0) // subsection id 0: module name
  wULEB(modName.length)
  wBytes(modName)
  // function-name subsection (id 1): the namemap built above.
  wU8(1) // subsection id 1: function names
  wULEB(fnameMap.length)
  wBytes(fnameMap)
  wTarget(npPrev)

  wSection(0, namePayload) // custom section id 0
  0
}

// Collect the STRING-LITERAL POOL: every distinct `StrLit` lexeme in the arena
// (first-seen arena order — deterministic per program) whose decoded length fits
// one `array.new_fixed` (a constexpr admits no locals, so an over-cap literal
// keeps the inline chunked build). An arena scan over-approximates live code
// (mirroring the print-detection scan): a dead literal costs one small unused
// immutable global, never correctness. Monomorphized clones share one entry —
// the pool dedupes by lexeme.
function collectStrPool() {
  gStrPoolTexts = []
  gStrPoolIx = Map()
  if !aUsed { return 0 }
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is StrLit {
      if (gStrPoolIx[nd.strText] ?? -1) < 0 {
        if decodeStr(strToCps(nd.strText)).length <= NEW_FIXED_MAX {
          gStrPoolIx[nd.strText] = gStrPoolTexts.length
          gStrPoolTexts.push(nd.strText)
        }
      }
    }
    i = i + 1
  }
  0
}

// Assemble the whole module: the header, then each section through its own emitter in
// wasm's mandated section-id order. Before any section bytes go out, this fixes the
// module-wide index spaces every one of them then references — the start-function and
// `__log__` decoder function indices, the shared-helper function indices, the string-
// literal pool, and (via `mAssignTypeIndices`) every heap type — so no section emitter
// has to re-derive an index another already chose. Returns 0, or -1 on a failed body.
function emitModule(_stmts: i32[]) {
  emitReset()
  emitHeader()

  const n = fnStmts.length

  // ── Start-function model (non-const module-global initializers) ──────────────
  // A module global whose initializer is NOT a WasmGC constant expression (a member
  // access like `curBuf = W.bytes`, a reference to another global, a call, …) cannot
  // be emitted inline in the global section. Its cell is zero-initialized there
  // (nullable `ref.null` / `i32.const 0`) and a SINGLE synthetic start function — the
  // LAST function index, so no user index shifts — runs every such init via
  // `global.set` before any other code. Count them up front; the count drives one
  // extra `()->()` functype, one extra function-section + code-section entry, and the
  // start section (id 8). When zero (the case for EVERY golden), nothing below
  // changes, so the module stays byte-identical.
  // Decide the storage class of every top-level binding BEFORE any section reads a
  // global index — the counts, the cell indices and the start-fn frame all derive from
  // it. It runs here rather than as an emit PASS because it must see the arena every
  // pass left behind, monomorphization clones included.
  computeGlobalPromotion()
  let nNonConst = 0
  let gci = 0
  while gci < globalStmts.length {
    if globalRunsInStartFn(gci) { nNonConst = nNonConst + 1 }
    gci = gci + 1
  }
  let hasStart = 0
  if nNonConst > 0 { hasStart = 1 }
  if startStmts.length > 0 { hasStart = 1 }
  // The synthetic start function's index (last, after all `n` user functions, which
  // themselves sit after any imports) and its `()->()` functype index (one past the
  // user functypes). Both unused when no start.
  const startFnIdx = gImports + n
  // The synthetic `__log__` decoder (memory intrinsics) is the LAST function index —
  // after the imports, the user functions, AND the start fn — so no other function
  // index shifts. `memFn` (0 or 1) feeds the function/code section counts.
  let memFn = 0
  if memLogUsed { memFn = 1 }
  gMemLogIdx = gImports + n + hasStart

  // ── shared runtime helpers (module-tail functions) ───────────────────────────
  // Assign each enabled helper the NEXT function index after the start fn and the
  // `__log__` decoder (so no other index shifts), in a FIXED order (string hash /
  // eq / concat, then map probe / resize) keyed only on the type-presence flags —
  // deterministic per program, so the self-compile fixpoint converges. The string
  // trio rides `aUsed` (the string array type exists) and the map pair `mUsed`;
  // an enabled-but-uncalled helper costs a few dozen bytes, never correctness.
  gHelpStrHash = -1
  gHelpStrEq = -1
  gHelpStrConcat = -1
  gHelpMapProbe = -1
  gHelpMapProbeI32 = -1
  gHelpMapResize = -1
  let nHelpers = 0
  const helpBase = gImports + n + hasStart + memFn
  if aUsed {
    gHelpStrHash = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpStrEq = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpStrConcat = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  if mUsed {
    gHelpMapProbe = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpMapResize = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // The i32-KEYED probe, LAST so no existing helper index moves in a program without
  // one (`__map_resize__` is key-agnostic — it re-places from the STORED hashes — so
  // the i32-keyed map shares it and only the probe needs a twin).
  if mI32Used {
    gHelpMapProbeI32 = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }

  // Intern the string-literal pool (its globals PRECEDE the user cells — every
  // user-global index below rides `userGlobalIdx`).
  collectStrPool()

  // Heap-type indices, in type-section order: standalone structs at 0..ns-1, then
  // (for the union path) the variant structs + box, then the raw i32 array, the
  // i32-list wrapper, each ref-list (backing, wrapper) pair, the string-list
  // (backing, wrapper), the map struct, and finally the functypes. Every index is
  // minted by the centralized `mIntern*` counter inside `mAssignTypeIndices`, which
  // assigns the module-global index state (`sHeapIdx`/`uVarHeap`/`uBoxIdx`/`aTypeIdx`/
  // `lTypeIdx`/`rlBackIdx`/`rlWrapIdx`/`raTypeIdx`/`rlTypeIdx`/`mkArrIdx`/`mkListIdx`/
  // `mStructIdx`) in that order and returns the functype base index (`typeOffset` —
  // where the first functype lands). All types are emitted inside ONE recursion
  // group below, so a type may reference one that lands later (a string field's
  // `(ref $aTypeIdx)`).
  const typeOffset = mAssignTypeIndices(n)

  // Each type's byte form lives at its emit site in `emitTypeSection`; the struct,
  // array and wrapper encodings were derived from binaryen's output (`5e 7f 01` for
  // the raw i32 array, its `listType` for the `{backing, len, cap}` wrapper), and that
  // is also where the standalone-vs-rec-group split for the print functypes is
  // explained. `nPrintTypes` is counted HERE, in the coordinator, because TWO sections
  // need it: the type section (its rec-group count EXCLUDES the standalone print
  // functypes) and the function section (whose `__log__` functype index sits past
  // them). A print-free program counts 0, leaving the rectype count at 1.
  let nPrintTypes = 0
  if gImports > 0 {
    nPrintTypes = 2 // (i32)->() and ()->() for the print imports
  }
  if gNeedsI64Print {
    nPrintTypes = nPrintTypes + 1 // + (i64)->() for __print_i64__
  }
  if gNeedsF64Print {
    nPrintTypes = nPrintTypes + 1 // + (f64)->() for __print_f64__
  }
  if gNeedsF32Print {
    nPrintTypes = nPrintTypes + 1 // + (f32)->() for __print_f32__
  }

  emitTypeSection(n, typeOffset, hasStart, memFn, nPrintTypes, nHelpers)

  emitImportSection(n, typeOffset, hasStart)

  emitFunctionSection(n, typeOffset, hasStart, memFn, nPrintTypes, nHelpers)

  // Table section (id 4, between function (3) and memory (5)): the ONE `funcref`
  // table function values dispatch through, sized to cover every user function at its
  // own wasm index (`gImports + i`), so the id a closure already stores IS the table
  // slot — see `gFnTableIdx`. The leading `gImports` slots stay null: they mirror the
  // imported functions, which are never function-value targets, and paying `gImports`
  // (≤ 5) null slots buys an identity index map instead of a bias every call site
  // would have to re-apply. Emitted only when `fnValUsed`, mirroring the element
  // section below, so a module with no function value emits no section 4.
  if fnValUsed {
    const tabPayload: i32[] = []
    const tabPrev = wTarget(tabPayload)
    wULEB(1)            // 1 table
    wU8(112)            // 0x70 funcref element type
    wU8(0)              // limits flag 0x00: min only
    wULEB(gImports + n) // min: every user function, at its own index
    wTarget(tabPrev)
    wSection(4, tabPayload)
  }

  // Memory section (id 5, between function (3) and global (6)): ONE module-DEFINED
  // memory, min 1 page (64 KiB — ample for the corpus' tag/value scratch region), no
  // max. The host IMPORTS `imports.memory` instead; the native runner provides no
  // memory import, so the module defines its own (same observable behavior). Emitted
  // only when a memory intrinsic is used — byte-identical output otherwise.
  if memUsed {
    const memPayload: i32[] = []
    const memPrev = wTarget(memPayload)
    wULEB(1) // 1 memory
    wU8(0)   // limits flag 0x00: min only
    wULEB(1) // min: 1 page
    wTarget(memPrev)
    wSection(5, memPayload)
  }

  emitGlobalSection()

  // The export ABI wrappers (#1265) sit after EVERY other function — user functions, the
  // start fn, the `__log__` decoder and the shared helpers — so adding them shifts no
  // existing function index. Wrapper k belongs to export entry k.
  emitExportSection(n, helpBase + nHelpers)

  // Start section (id 8): names the function the runtime invokes once at instantiation,
  // before any export is callable — here the synthetic start fn that runs the non-const
  // global initializers. Per the section-id order it sits AFTER the export section (7)
  // and BEFORE the code section (10). Omitted entirely when no non-const global exists
  // (so EVERY golden, which has only const globals, emits no start section).
  if hasStart == 1 {
    const startPayload: i32[] = []
    const stPrev = wTarget(startPayload)
    wULEB(startFnIdx)
    wTarget(stPrev)
    wSection(8, startPayload)
  }

  // Element section (id 9): a single ACTIVE elem segment that FILLS the section-4
  // table with every user function at its own wasm index — the initializer for the
  // dispatch table `call_indirect` reads. Flags 0x00 is the plain active form (table
  // 0 implied, an i32 offset expr, then the func-index vec); the offset is `gImports`
  // because entry `gImports + i` must hold user function `i`. Emitted ONLY when a
  // function value exists (`fnValUsed`), so a no-lambda module emits no section 9 and
  // stays byte-identical — mirroring the start-section conditional. Sits AFTER start
  // (8), BEFORE code (10).
  if fnValUsed {
    const elemPayload: i32[] = []
    const elPrev = wTarget(elemPayload)
    wULEB(1) // 1 element segment
    wU8(0)   // flags 0x00: active, table 0, offset expr + func-index vec
    wU8(65)  // 0x41 i32.const — the offset expr
    wSLEB(gImports)
    wU8(11)  // 0x0b end
    wULEB(n) // count of table entries written
    let di = 0
    while di < n {
      wULEB(gImports + di) // func index (imports occupy 0..gImports-1)
      di = di + 1
    }
    wTarget(elPrev)
    wSection(9, elemPayload)
  }

  if emitCodeSection(n, hasStart, memFn, nHelpers) < 0 { return -1 }

  // Custom "name" section LAST (after the code section, where it conventionally
  // lives). A no-op unless `gEmitNames` is set, so the default emit path is
  // byte-identical to every golden.
  emitNameSection(n)
  0
}

// ── emitProgram pass manager ──────────────────────────────────────────────────
// The front half of `emitProgram` is a sequence of ordered passes over the arena.
// The pass TABLE in `emitProgram` is the one place that order lives: each row is
// `"pass"` or `"pass > prereq prereq …"`, rows run top to bottom, and the driver
// asserts every prerequisite has already run before dispatching — so a reordered
// table fails loudly (`emitFail`) instead of miscompiling. A `#2` suffix names an
// explicit RE-RUN of an earlier pass: monomorphization mints late annotations
// (instance-pinned params/returns) that the first arena scans could not see, so
// its dependents re-scan after it.

// True if `done` (the names of the passes run so far) contains the pass name
// spelled at `needs[i..j)` — a membership test without building a substring.
function passDoneHas(done: string[], needs: string, i: i32, j: i32) {
  let d = 0
  while d < done.length {
    const nm = done[d]
    if nm.length == j - i {
      let k = 0
      let same = true
      while k < nm.length {
        if nm[k] != needs[i + k] { same = false }
        k = k + 1
      }
      if same { return true }
    }
    d = d + 1
  }
  false
}

// True if every space-separated pass name in `needs` is present in `done`.
function passNeedsMet(needs: string, done: string[]) {
  let i = 0
  while i < needs.length {
    if needs[i] == 32 {
      i = i + 1 // skip the separator (space)
    } else {
      let j = i
      while j < needs.length && needs[j] != 32 { j = j + 1 }
      if !passDoneHas(done, needs, i, j) { return false }
      i = j
    }
  }
  true
}

// The pass NAME of a table row (`"buildFnMap#2 > monomorphize"` → `"buildFnMap#2"`):
// the leading run up to the first space or `>`.
function passRowName(row: string) {
  let e = 0
  while e < row.length && row[e] != 32 && row[e] != 62 { e = e + 1 }
  const nm = row.slice(0, e)
  nm
}

// The prerequisite list of a table row — everything after the `>` (`""` when the
// row declares none). Space-separated pass names, consumed by `passNeedsMet`.
function passRowNeeds(row: string) {
  let g = 0
  while g < row.length && row[g] != 62 { g = g + 1 }
  if g >= row.length { return "" }
  const nd = row.slice(g + 1, row.length)
  nd
}

// The `collectFns` post-condition, as a pass so the table orders it explicitly:
// a program must declare at least one top-level function or start statement.
function passCheckTopLevel() {
  if fnStmts.length < 1 && startStmts.length < 1 {
    return emitFail(
      "emitProgram: expected at least one top-level function or statement",
    )
  }
  0
}

// Detect `print(...)` / memory-intrinsic use anywhere in the program: any print
// pulls in the 4-import print family (imports shift every local function's wasm
// index, so this is decided up front; a print-free program emits no import
// section at all). Scans the WHOLE arena, so it must run after every pass that
// mints nodes (monomorphization instances, synthesized annotations).
//
// "any print" is the PROPERTY, not the spelling `print(`: the reservation must
// cover every construct the emitter lowers to a `__print_*__` import, whichever
// name the author wrote. Three do — `print(...)`, `__log__(...)` (its decoder
// prints through `__print_i32__`) and `__trap__(<string>)` (its reason streams
// through `__print_char__`/`__print_str_flush__`). A construct that streams but
// is missing here is not a wrong number, it is a module with no import section
// whose streaming calls resolve to USER function indices: invalid wasm that
// `vl check` passes. Grep `fbCall(0)`..`fbCall(4)` and `emitPrintStrExpr` in
// `wasmEmit.vl` before adding a fourth.
function scanPrintUse() {
  gImports = 0
  gNeedsI64Print = false
  gNeedsF64Print = false
  gF64PrintIdx = 0
  gNeedsF32Print = false
  gF32PrintIdx = 0
  memUsed = false
  memLogUsed = false
  let pscan = 0
  let sawI64Ann = false
  let sawF64 = false
  let sawF32 = false
  while pscan < P.nodes.length {
    const pn = P.nodes[pscan]
    if pn is Call {
      const pcallee = P.nodes[pn.callFn]
      if pcallee is Ident {
        if pcallee.identName == "print" { gImports = 4 }
        // The linear-memory intrinsics: any store/load forces the module-defined
        // memory; `__log__` additionally forces the synthetic decoder function,
        // which prints through `__print_i32__` — so it pulls in the print-import
        // family exactly as a `print(...)` call does.
        if (
          pcallee.identName == "__store_i32__" ||
          pcallee.identName == "__load_i32__"
        ) {
          memUsed = true
        }
        // The five other store widths (three wide, two narrow) force the memory exactly
        // as `__store_i32__` does. They add NOTHING to the print-import scan below, and
        // that is a decision, not an omission: a store CONSUMES a scalar and yields none,
        // so it can never route a `print` to an undeclared import — the direction the
        // load matrix has to guard. Membership, not a spelling: a width added to
        // `nameIsMemStoreIntrinsic` forces the memory here the same day.
        if nameIsMemStoreIntrinsic(pcallee.identName) { memUsed = true }
        // The load-WIDTH matrix forces the memory exactly as `__load_i32__` does, and
        // additionally forces a `__print_*__` import when its result is a WIDE scalar:
        // `print(__load_f64__(0))` routes to `__print_f64__` in a program that spells
        // `f64` NOWHERE, so the annotation scan below cannot see it. Read off the NAME
        // (`repMemLoadScalarMask`), which is total — see its comment for why the arena
        // is the wrong source here.
        if nameIsMemLoadIntrinsic(pcallee.identName) {
          memUsed = true
          const lscal = repMemLoadScalarMask(pcallee.identName)
          if (lscal & REP_SCAL_I64) != 0 { sawI64Ann = true }
          if (lscal & REP_SCAL_F64) != 0 { sawF64 = true }
          if (lscal & REP_SCAL_F32) != 0 { sawF32 = true }
        }
        // The BULK PAIR forces the memory for the same reason, and it is the reason
        // that generalises: `memory.copy` / `memory.fill` are instructions ON the
        // memory, so a program whose only contact with linear memory is
        // `__memory_fill__(0, 0, 4)` still needs section 5 emitted or the instruction
        // names a memory that does not exist. Both are void, so like the stores they
        // add nothing to the print-import scan below.
        if nameIsMemBulkIntrinsic(pcallee.identName) { memUsed = true }
        // `memory.size` / `memory.grow` are instructions ON the memory: a program whose
        // ONLY memory contact is `__memory_size__()` still needs section 5 emitted, or
        // the instruction refers to a memory that does not exist and the module fails to
        // validate. Both are i32-valued, so neither touches the print-import scan.
        if (
          pcallee.identName == "__memory_size__" ||
          pcallee.identName == "__memory_grow__"
        ) {
          memUsed = true
        }
        if pcallee.identName == "__log__" {
          memUsed = true
          memLogUsed = true
          gImports = 4
        }
        // `__trap__("reason")` streams its message through the SAME
        // `__print_char__` / `__print_str_flush__` pair `print(<string>)` uses
        // (`wasmEmit.emitPrintStrExpr`), so it pulls in the 4-import print family
        // exactly as a `print(...)` call does. It had no arm here, and the whole
        // defect is that a MESSAGE-carrying trap was the only thing keeping a
        // program's import section alive: `__trap__("boom")` as the only statement
        // reserved nothing, the module got no import section at all, and the two
        // streaming calls landed on USER function indices — invalid wasm with
        // `vl check` rc 0 (measured on 367ab8d: a 351-byte module, "type mismatch:
        // expected (ref $type), found i32"). The sibling classifier in
        // `emit_classify.exprHasStrOp` had ALREADY been taught `__trap__(<string>)`
        // for the string-op scratch frame; this is the other half of that set.
        //
        // Arity-gated on purpose: the BARE `__trap__()` lowers to `unreachable`
        // alone and streams nothing, so reserving for it would put four unused
        // imports and ~118 bytes into every bare-abort module that is already
        // correct. `> 1` argument is the emitter's own loud reject, unchanged.
        if pcallee.identName == "__trap__" {
          if pn.callArgs.length == 1 { gImports = 4 }
        }
        // A numeric-opcode INTRINSIC yields a scalar that the annotation scan below
        // cannot see: `f64bits(x)` is an i64 and `f32fromBits(b)` an f32 in a program
        // that may spell neither type anywhere. Read the CALL's own recorded type, so
        // the print router never routes to an import that was not declared. (The same
        // hazard the `as`-cast arm below covers, at a different producer.)
        if isNumIntrinsicName(pcallee.identName) {
          const iscal = repNodeScalarMask(pscan)
          if iscal >= 0 {
            if (iscal & REP_SCAL_I64) != 0 { sawI64Ann = true }
            if (iscal & REP_SCAL_F64) != 0 { sawF64 = true }
            if (iscal & REP_SCAL_F32) != 0 { sawF32 = true }
          }
        }
      }
    }
    // Any type annotation CONTAINING an i64/f64/f32 leaf anywhere — bare, `T[]`
    // element, union member, `{[…]: T}` map value, `() => T` closure result,
    // struct field, nullable inner — flags the program as using that scalar.
    // Combined with `print`, it pulls in the matching `__print_*__` import (an
    // over-approximation: a program with an i64 binding but no `print(<i64>)`
    // carries one unused import — harmless; a MISSED flag is invalid wasm, a
    // narrowed/read value `print`-routed to a non-existent import index).
    if pn is TypeRef {
      // EXACT containment via the checker's recorded type (`repTyScalarMask`
      // walks the `Ty` arena transitively, terminating on recursive types) —
      // so an alias whose NAME never spells the scalar (`type Big = i64`)
      // still flags it. Only a node with no recorded type (an
      // emitter-internal name past the typed-IR table) falls back to the
      // name-substring test, which sees exactly what the synthesis spelled.
      const scal = repNodeScalarMask(pscan)
      if scal >= 0 {
        if (scal & REP_SCAL_I64) != 0 { sawI64Ann = true }
        if (scal & REP_SCAL_F64) != 0 { sawF64 = true }
        if (scal & REP_SCAL_F32) != 0 { sawF32 = true }
      } else {
        if strContains(pn.tyName, "i64") { sawI64Ann = true }
        if strContains(pn.tyName, "f64") { sawF64 = true }
        if strContains(pn.tyName, "f32") { sawF32 = true }
      }
    }
    // A float `.` literal flags the program as f64-using (the checker types it f64).
    // An INTEGER literal past the i32 range flags it as i64-using (the checker
    // types it i64 — the host `defaultIntegerType` rule), so `print(0xDEAD_BEEF)`
    // pulls in the `__print_i64__` import even with no `i64` annotation.
    if pn is NumLit {
      if numTextIsFloat(pn.numText) { sawF64 = true }
      else if !numLexFitsI32(pn.numText) { sawI64Ann = true }
    }
    // An explicit `x as T` cast TARGET rides as a string field (`asTy`), not a
    // `TypeRef` node, so the annotation scan above misses it. Flag its scalar
    // directly — else `print(x as i64)` / `print(x as f64)` would route to a
    // `__print_*__` import that was never added (invalid wasm).
    if pn is AsExpr {
      if strContains(pn.asTy, "i64") { sawI64Ann = true }
      if strContains(pn.asTy, "f64") { sawF64 = true }
      if strContains(pn.asTy, "f32") { sawF32 = true }
    }
    pscan = pscan + 1
  }
  // When the program both prints (`gImports == 4`, the print family) and names
  // an i64 type, add the 5th `__print_i64__` import.
  if gImports == 4 {
    if sawI64Ann {
      gImports = gImports + 1
      gNeedsI64Print = true
    }
    // Then `__print_f64__` (at the next index — 4 or 5). The f64 import always
    // trails the i64 one so the i64 print index (4) is unchanged. (Slice 3.)
    if sawF64 {
      gF64PrintIdx = gImports
      gImports = gImports + 1
      gNeedsF64Print = true
    }
    // Then `__print_f32__` (at the next index — 4/5/6). It always TRAILS the i64 and
    // f64 imports so their indices are unchanged. (Slice 5.)
    if sawF32 {
      gF32PrintIdx = gImports
      gImports = gImports + 1
      gNeedsF32Print = true
    }
  }
  0
}

// Every function's parameters must be i32 or the struct type before we commit.
function checkFnParams() {
  let i = 0
  while i < fnStmts.length {
    if checkParams(fnStmts[i]) < 0 { return -1 }
    i = i + 1
  }
  0
}

// Dispatch one pass-table row by name. Every pass returns an i32 status (< 0 =
// failed emit). The `#2` rows are the explicit re-run stage — each branch calls
// the same pass function a second time, post-monomorphization.
function runEmitPass(name: string, stmts: i32[]) {
  if name == "collectU" { return collectU(stmts) }
  if name == "collectS" { return collectS(stmts) }
  if name == "collectA" { return collectA(stmts) }
  if name == "collectFns" { return collectFns(stmts) }
  if name == "checkTopLevel" { return passCheckTopLevel() }
  if name == "buildFnMap" { return buildFnMap(stmts) }
  if name == "computeVoidFns" { return computeVoidFns() }
  if name == "computeRetInference" { return computeRetInference() }
  if name == "dispatchRewrite" { return dispatchRewrite(stmts) }
  if name == "captureBoxRewrite" { return captureBoxRewrite(stmts) }
  if name == "synthRetAnnots" { return synthRetAnnots() }
  if name == "monomorphize" { return monomorphize(stmts) }
  if name == "collectGenAliasShapes" { return collectGenAliasShapes() }
  if name == "collectAnnShapes" { return collectAnnShapes() }
  // RE-RUN stage: instance-pinned annotations minted DURING monomorphization
  // (`Box<i32>` applications, structural returns) postdate the first arena scans —
  // rescan so they intern too, then refresh the name→index tables that resolve
  // against the struct table (an instance's `fRetStructIdx` needs its
  // just-interned return shape). All four are idempotent and usage-gated (no new
  // TypeRef → no new shape → identical bytes).
  if name == "collectA#2" { return collectA(stmts) }
  if name == "buildFnMap#2" { return buildFnMap(stmts) }
  if name == "synthParamAnnots" { return synthParamAnnots() }
  if name == "computeVoidFns#2" { return computeVoidFns() }
  if name == "computeRetInference#2" { return computeRetInference() }
  if name == "collectMapFilterUse" { return collectMapFilterUse() }
  if name == "collectFnValUse" { return collectFnValUse() }
  if name == "collectCloSigs" { return collectCloSigs() }
  if name == "scanPrintUse" { return scanPrintUse() }
  if name == "checkFnParams" { return checkFnParams() }
  if name == "capCacheBuild" { return capCacheBuild() }
  if name == "capNarrowBuild" { return capNarrowBuild() }
  if name == "capNarrowBuild#2" { return capNarrowBuild() }
  emitFail("emitProgram: unknown pass in the pass table: " + name)
}

// ── the SID-KEYED TABLE reset — paired with `symbols.sidReset` at every site ────
// The driver calls this beside every `sidReset()`, i.e. at every `P.nodes = []`.
// It exists as ONE function so the pairing is one line at each of the seven sites
// rather than five, and so the enumeration of sid-keyed tables has a single home.
//
// **WHY IT IS NOT ENOUGH TO RESET THESE WHERE THEIR STRING PREDECESSORS WERE.**
// `globalIndexBySid` is rebuilt by `collectFns`, `fnIndexBySid` by `buildFnMap`,
// and both run INSIDE `emitProgram` — so between one program's end and the next
// program's collect pass there is a window in which the rows are stale. That
// window is old (it is the same one `resetLitAtoms`' header describes for
// `startStmts`), and with STRING keys it was almost always harmless: program N+1
// had to reuse a SPELLING to collide. A SID-keyed dense array collides on a
// NUMBER, and the space is dense from 0, so the collision is close to certain.
//
// Measured: without this call the wasm harness — one `WebAssembly.Instance` over
// the whole corpus — failed 18 cases with `array element access out of bounds`
// (a stale `globalIndexBySid` row indexing an emptied `globalStmts`), and every one
// of those cases passed in isolation. That harness is this hazard's witness.
export function sidKeyedTablesReset() {
  // The hash-consed structural-identity table is sid-keyed too — `HC_PRIM` holds the
  // primitive keyword's sid and `HC_OBJ` its field names' — so it resets here, which is
  // what this function exists to be: the one home for that pairing.
  hcReset()
  globalIndexBySid = []
  fnIndexBySid = []
  nestedNameBySid = []
  sidResetParentLet()
  sidResetStartBlockLet()
  0
}

export function emitProgram(rootIx: i32) {
  // ── the ARENA-INDEX SIDECAR reset (method note 7) ───────────────────────────
  // Every column below holds indices into the checker's `T.tys`, which a fresh
  // program rebuilds from scratch. Each ALSO has its own reset inside the collect
  // pass that clears the NAME column it parallels — but those passes run in order
  // (collectU, collectS, collectA), so a query issued by an EARLIER pass would read
  // program N-1's rows. `slotCanonKey` then dereferences one into program N's
  // re-minted arena and TRAPS ("array element access out of bounds"): a stale index
  // traps where a stale NAME is merely wrong text. Only reachable when one compiler
  // instance lowers several programs — the test/batch drivers.
  //
  // So they are emptied HERE, ahead of every pass: the pre-collect window then reads
  // UNCOVERED and every consumer keeps its name path, exactly as it does for the
  // first program an instance ever compiles. Each name column's own reset stays where
  // it has always been — the pass named in brackets below. An uncovered union-member
  // row makes `unionMemberTysOf` false, so its consumer falls back to the member-NAME
  // scan; and a member SET id names a union ROW plus a mask over that row's members,
  // so `msPoolReset`'s generation bump is what retires an id outliving its program.
  mvValTyIx = []        // map-VALUE type per mv slot        [collectA]
  rlElemTyIx = []       // ref-list ELEMENT type per slot    [collectA]
  annRlSlot = []        // ref-list ROW per annotation node  [collectA] — node ixs are
  annRlNul = []         // ...and that row's `| null` flag              stable, ROWS are not
  sTyIx = []            // arena type a struct ROW came from [collectS]
  sFieldElemTyIx = []   // a struct FIELD's element type     [collectS]
  uFieldElemTyIx = []   // a VARIANT field's element type    [collectU]
  sFieldElemKeyI32 = [] // a struct FIELD's map KEY rep    [collectS]
  uFieldElemKeyI32 = [] // a VARIANT field's map KEY rep   [collectU]
  unMemTyStart = []     // union MEMBER types per row        [collectU]
  unMemTyCount = []
  unMemTys = []
  unMemAtoms = []       // the member-REFERENCE columns      [collectU]
  unMemAtomIds = []
  unMemKinds = []
  msPoolReset()         // the member SETS interned over those columns
  // The if-expression arm blocks whose prelude locals the collect pass allocated. ARENA
  // NODE indices, so it is the same hazard as the columns above and worse: a stale index
  // that happens to name a node in program N grants the emitter permission to lower a
  // prelude whose locals were never allocated, which claims another binding's slot. Only
  // reachable across programs on one instance, which is why the corpus driver is where
  // it shows.
  armPreludeBlocks = []
  emitFailed = false
  emitErr = ""
  // Fresh per program: the diagnostic anchor + the "function being lowered"
  // cursor. A failure before any function body emits leaves these -1 (positionless).
  emitErrAt = -1
  emitCurFnIx = -1
  emitCurFnPos = -1
  narrowNames = []
  narrowVariants = []
  narrowTys = []
  narrowSets = []
  narrowRetired = []
  narrowTop = 0
  // The capture cache is only valid for a FINAL AST — drop it before the
  // rewrite/monomorphize passes run (they mutate bodies and `fnStmts` slots).
  capCacheOn = false
  if rootIx < 0 { return emitFail("emitProgram: empty arena (root index < 0)") }
  const root = P.nodes[rootIx]
  if root is Program {
    const stmts = root.progStmts
    if stmts.length < 1 {
      return emitFail("emitProgram: expected at least one top-level statement")
    }
    resetLitAtoms()
    resetParentLetCache()
    // The repOf scratch (visited stamps + component-mask memo) is keyed by
    // `Ty`-arena index — stale across programs, since the arena is re-minted
    // per compile.
    repReset()
    // The ordered pass table — see the pass-manager block comment above
    // `passDoneHas` for the row grammar. WHY each ordering edge holds:
    //  · collectU first, so `collectS` knows whether the program's structs are
    //    union variants vs a single direct struct; then the struct shapes, the
    //    arena arrays, the function list (FuncDecls only), and the name→index
    //    map. Forward references and recursion resolve because every name is
    //    mapped before any body is emitted.
    //  · dispatchRewrite (UFCS `self`-methods, operator overloads, index traps)
    //    resolves `o.f(args)` / `a op b` / `o[k]` into the plain-call forms the
    //    lowerings AND the monomorphizer handle — before mono, so a rewritten
    //    call instantiates per receiver shape.
    //  · captureBoxRewrite boxes captured-MUTATION locals as shared length-1
    //    arrays — before mono, so instances inherit the rewrite.
    //  · synthRetAnnots pins a bound lambda's UNION return annotation from its
    //    annotated closure type — before mono (an instance is cloned with
    //    `nret = fnRet`, so the return must be pinned first or it emits a
    //    single-arm `$fnsig` result the call-site `ref.cast` rejects), and
    //    before the shape passes, so the union's box + variants intern for the
    //    return. Reads the union registry, hence the `collectU` edge.
    //  · monomorphize clones a concretely-annotated instance per distinct call
    //    shape — BEFORE signatures and types are collected.
    //  · the `#2` rows re-scan what monomorphization's late-minted annotations
    //    invalidated (see `runEmitPass`).
    //  · synthParamAnnots fills an un-annotated CALLBACK param's annotation from
    //    the checker's recorded type — after mono (an instance's pinned params
    //    are in place), before the `$fnsig` / map-filter collection that reads
    //    param valtypes.
    //  · collectMapFilterUse flips `fnValUsed` + forces the RESULT list's types;
    //    the `$fnsig` set (collectCloSigs) is collected after it and after
    //    collectFnValUse — both need the re-inferred return kinds.
    //  · scanPrintUse / checkFnParams read the FINAL arena; capCacheBuild
    //    snapshots capture lists only once the AST and `fnStmts` are final —
    //    after every mutating pass.
    //  · capNarrowBuild banks the narrowing active at each closure's DECLARATION
    //    site and must precede computeRetInference, which types a closure whose
    //    return is a narrowed captured read; its `#2` row re-banks because
    //    monomorphization renumbers `fnStmts` and every record is keyed by
    //    position.
    const passTable = [
      "collectU",
      "collectS > collectU",
      "collectA > collectS",
      "collectFns > collectU collectS",
      "checkTopLevel > collectFns",
      "buildFnMap > collectFns",
      "computeVoidFns > buildFnMap",
      "capNarrowBuild > buildFnMap",
      "computeRetInference > buildFnMap computeVoidFns capNarrowBuild",
      "dispatchRewrite > buildFnMap computeRetInference",
      "captureBoxRewrite > collectFns",
      "synthRetAnnots > collectU buildFnMap",
      "monomorphize > dispatchRewrite captureBoxRewrite synthRetAnnots",
      "collectGenAliasShapes > monomorphize",
      "collectAnnShapes > monomorphize",
      "collectA#2 > collectGenAliasShapes collectAnnShapes",
      "buildFnMap#2 > monomorphize collectA#2",
      "synthParamAnnots > monomorphize buildFnMap#2",
      "computeVoidFns#2 > synthParamAnnots",
      "capNarrowBuild#2 > synthParamAnnots",
      "computeRetInference#2 > synthParamAnnots computeVoidFns#2 capNarrowBuild#2",
      "collectMapFilterUse > synthParamAnnots computeRetInference#2",
      "collectFnValUse > synthParamAnnots computeRetInference#2",
      "collectCloSigs > collectMapFilterUse collectFnValUse",
      "scanPrintUse > monomorphize synthParamAnnots",
      "checkFnParams > monomorphize synthParamAnnots",
      "capCacheBuild > monomorphize synthParamAnnots",
    ]
    const passDone: string[] = []
    let pi = 0
    while pi < passTable.length {
      const prow = passTable[pi]
      const pname = passRowName(prow)
      if !passNeedsMet(passRowNeeds(prow), passDone) {
        return emitFail(
          "emitProgram: pass " +
            pname +
            " ran before a prerequisite (pass table reordered)",
        )
      }
      if runEmitPass(pname, stmts) < 0 { return -1 }
      passDone.push(pname)
      pi = pi + 1
    }
    const rc = emitModule(stmts)
    if rc < 0 { return rc }
    // An `emitFail` whose -1 a deep helper swallowed (e.g. inside a valtype write)
    // must still fail the WHOLE emit: a failed module never reaches instantiation.
    if emitFailed { return -1 }
    // The rep-tree differential harness (debug-only; a no-op unless the host
    // armed `setRepShadow`) — swept HERE because the arena is final now.
    repShadowSweep()
    return rc
  }
  emitFail("emitProgram: root node is not a Program")
}

// Emit one shared-runtime-helper FUNCTYPE (`0x60 func`, params, results) onto the
// current buffer. `params`/`res` are valtype descriptor strings, one char per slot:
// 'i' = i32 (`0x7f`), 'a' = a non-null `(ref $aTypeIdx)` string/i32-array ref,
// 'm' = a non-null `(ref $mkArrIdx)` string-list backing ref.
function helpFuncType(params: string, res: string) {
  wU8(96) // 0x60 func
  wULEB(params.length)
  let i = 0
  while i < params.length {
    helpValtype(params[i])
    i = i + 1
  }
  wULEB(res.length)
  let j = 0
  while j < res.length {
    helpValtype(res[j])
    j = j + 1
  }
  0
}

// One descriptor char (see `helpFuncType`) as a valtype.
function helpValtype(c: i32) {
  if c == 'i' {
    wU8(127) // 0x7f i32
    return 0
  }
  wU8(100) // 0x64 (ref ht) — non-null
  if c == 'm' { wSLEB(mkArrIdx) } else { wSLEB(aTypeIdx) }
  0
}

// Read a `;`-terminated decimal index following a ref `$fnsig` token (`s3;`, `r0;`),
// starting at `i` (the first digit). Returns the parsed index; `outNext` receives the
// position just past the `;`. The token scheme (`repSigTokOfKind`/`repKindOfSigTok`)
// terminates every index-carrying ref token with `;`, so the loop is bounded.
function synthSigIdxAt(key: string, i: i32, outNext: i32[]) {
  let idx = 0
  let j = i
  while j < key.length && key[j] != ';' {
    idx = idx * 10 + (key[j] - '0')
    j = j + 1
  }
  outNext.push(j + 1) // skip the ';'
  idx
}

// True if a `$fnsig` token char carries a `;`-terminated index — the ref shapes whose
// functype valtype needs a heap slot. Decodes through the ONE token vocabulary
// (`repKindOfSigTok` → `repSigTokHasSlot`), so a new slot-carrying kind cannot be added
// to the encoders without this parser skipping its digits correctly.
function synthSigTokHasIdx(c: i32) { repSigTokHasSlot(repKindOfSigTok(c)) }

// Emit ONE `$fnsig` functype SYNTHESIZED purely from its interned KEY string — the path
// for a signature interned from a bare union-arm / annotation function type that has NO
// concrete closure (`cloSigRepFn` sentinel -1), so the rep-function-node reader cannot
// run. The bytes are byte-identical to what the rep path emits for the same key, because
// both stream valtypes through the SAME `fbValtype`, and a key token's trailing index IS
// the `fbValtype` heap slot (by construction of `annParamKind`/`cloParamTok`). Shape:
// `(structref env, params...) -> ret` — the env leader (0x6b) exactly as the rep path,
// then each param token's valtype, then 0 results for a `>v` (void) sig or 1 otherwise.
function emitSynthCloSig(key: string) {
  // NOT A TYPE-NAME GRAMMAR (D-CLASSGRAM census note; DECLINED by D-MODGENLT, which
  // owned this file and re-derived the census structurally: this `>` is the only angle
  // bracket in `emit_sections.vl`, and `driver.vl`'s two `<` are the only ones there).
  // The `>` below is the `$fnsig` KEY's param/result SEPARATOR — a character in the ABI
  // token alphabet `repSigTokOfKind`/`repKindOfSigTok` own, on a string the compiler
  // MINTED token by token, not a rendered type. It is the same call #1223 declined twice
  // (`sigParamCoerceKind`, `sigKeyRetTokIx`), and routing it to the generic-application
  // `<`-scan would be a category error, not a dedup: that home scans for `<`, which this
  // alphabet never emits.
  //
  // It is not routable to the ABI family's own last-`>` home (`emit_classify`'s
  // `sigKeyRetTokIx`) either, on THREE counts: that home is un-exported; its SPAN rule is
  // the LAST `>` where this walk wants the FIRST; and its contract returns the position
  // just PAST the marker, or -1 for a result-less key, where both passes below need the
  // marker's own index as their `key[0..gi)` param bound. The two readings are
  // indistinguishable on today's corpus (measured: 0/1508 files change when this scan is
  // switched to last-`>`) — which is exactly what makes the merge a SILENT behaviour
  // change rather than a safe one, since nothing would catch a future two-`>` key.
  //
  // Locate the result marker `>` (no param/index token contains it).
  let gi = 0
  while gi < key.length && key[gi] != '>' { gi = gi + 1 }
  // Pass 1 — count params (advance token by token over `key[0..gi)`).
  let nparams = 0
  let ci = 0
  while ci < gi {
    if synthSigTokHasIdx(key[ci]) {
      ci = ci + 1
      while ci < gi && key[ci] != ';' { ci = ci + 1 }
      ci = ci + 1 // skip ';'
    } else {
      ci = ci + 1
    }
    nparams = nparams + 1
  }
  wU8(96)            // 0x60 func
  wULEB(nparams + 1) // env + declared params
  wU8(107)           // param 0 env: structref (0x6b)
  // Pass 2 — emit each param's valtype.
  let pi = 0
  while pi < gi {
    const pc = key[pi]
    const pk = repKindOfSigTok(pc)
    let pkc: VKind = "i32"
    if pk != null { pkc = pk }
    let pidx = -1
    if synthSigTokHasIdx(pc) {
      const nx: i32[] = []
      pidx = synthSigIdxAt(key, pi + 1, nx)
      pi = nx[0]
    } else {
      pi = pi + 1
    }
    fbValtype(pkc, pidx)
  }
  // Result — a `>v` (void field-closure) sig has 0 results; else the single result token.
  const ri = gi + 1
  if ri < key.length && key[ri] == 'v' {
    wU8(0)
  } else {
    wU8(1)
    const rc = key[ri]
    const rk = repKindOfSigTok(rc)
    let rkc: VKind = "i32"
    if rk != null { rkc = rk }
    let ridx = -1
    if synthSigTokHasIdx(rc) {
      const rnx: i32[] = []
      ridx = synthSigIdxAt(key, ri + 1, rnx)
    }
    fbValtype(rkc, ridx)
  }
  0
}

// Type section (id 1): all WasmGC types in ONE recursion group, followed by the
// standalone print/(log) functypes — the rec-group count excludes those. The inline
// comments below carry the per-type framing.
// ONE function's `0x60` functype, written to the type payload: the param valtypes then
// the result valtype. `withEnv` decides the hidden leading `structref` (see below); every
// other byte is the same either way, which is the whole reason this is a function.
//
// #1265 — IT IS CALLED TWICE PER EXPORTED FUNCTION, and the second call is what makes an
// export wrapper possible: `emitTypeSection`'s main loop passes `fnValUsed` (the real,
// env-leading signature the module calls internally), and the wrapper tail below passes
// FALSE for the clean, env-free ABI signature the same function is PUBLISHED under. The
// two must not drift — the result-type dispatch alone is a dozen branches over void /
// closure / inferred / annotated returns, with per-kind slot resolution for structs, ref
// lists, maps and variants — so they are one function, not a copy.
function emitOneFuncType(ti: i32, withEnv: boolean) {
  const fn = P.nodes[fnStmts[ti]]
  if fn is FuncDecl {
    const params = fn.fnParams
    const nParams = params.length
    wU8(96) // 0x60 func
    // When a function value exists module-wide, EVERY function carries a hidden
    // leading `structref env` param (local 0). The declared params follow at 1..p.
    // A non-capturing function ignores its env; a capturing one `ref.cast`s + reads
    // it. Gated on `fnValUsed` so a no-lambda module's functypes are byte-identical.
    if withEnv {
      wULEB(nParams + 1) // param count incl. the env param
      wU8(107)           // env param: structref (0x6b)
    } else {
      wULEB(nParams) // param count
    }
    let pi = 0
    while pi < nParams {
      fbValtype(vtKindOfParam(params[pi]), paramStructIdxOf(params[pi]))
      pi = pi + 1
    }
    if fRetVoid[ti] == 1 {
      wU8(0) // 0 results — a VOID function (`()->()`)
    } else if fn.fnRet < 0 && fnReturnsClosure(ti) {
      // A function VALUE return (un-annotated; its tail is a function value) — kind 14.
      wU8(1)
      fbValtype("closure", -1)
    } else if fn.fnRet < 0 {
      // UN-ANNOTATED return: the INFERRED kind (computeRetInference set the same
      // stored `fRetKind` slot the annotation path fills). i32 when nothing matched.
      wU8(1) // 1 result
      // The inferred result KIND from the single shared mapping (`inferredRetKindCore`) — so
      // this site and `cloRetValKind` can't drift on a scalar/list/ref kind (the f32/f64/i64
      // inferred-return holes were each one site missing what the other had). The SLOT follows
      // the kind: struct index for a struct / nullable-struct ref (1 / 9), the element wrapper
      // for a ref list (5, via the recorded element name), the map shape for a map (6); every
      // other kind (string / scalar list / scalars) needs no per-function slot.
      const infKind = inferredRetKindCore(ti)
      let infSlot = -1
      if infKind == "struct" || infKind == "nulstruct" {
        infSlot = fRetStructIdx[ti]
      }
      if infKind == "reflist" { infSlot = rlSlotByName(fRetRArrElem[ti]) }
      if infKind == "map" {
        const mrx = fnRetExprOf(fnStmts[ti])
        if mrx >= 0 { infSlot = mapRetExprShape(mrx, ti) }
      }
      fbValtype(infKind, infSlot)
    } else {
      wU8(1) // 1 result
      // A `T[]` return is kind 5 — its second `fbValtype` arg is the ref-list TABLE
      // SLOT for the element type (`retStructIndex` is -1 for a ref array), so the
      // result valtype selects THIS function's element wrapper, not slot 0's.
      let retSlot = retStructIndex(fn.fnRet)
      if retRefArrFlag(fn.fnRet) == 1 { retSlot = tyAnnRefListSlot(fn.fnRet) }
      // A NULLABLE ref-array return (`<ref-array> | null`, kind 18) — its slot is the INNER
      // ref-list element wrapper (`tyAnnRefListSlot` strips the `| null` before resolving), so the
      // `(ref null $wrapper)` result valtype selects THIS function's element wrapper.
      if retNulRefArrFlag(fn.fnRet) == 1 {
        retSlot = tyAnnRefListSlot(fn.fnRet)
      }
      // A string-keyed MAP return's slot is the map SHAPE (mono ⇒ -1, or the value type's mv
      // slot for a `string`-valued map), so the result valtype selects THIS map's `$mapStruct`.
      if retMapFlag(fn.fnRet) == 1 { retSlot = mapAnnShape(fn.fnRet) }
      // A NULLABLE map return (`{[string]: V} | null`, kind `nulmap`) — the SAME map SHAPE selects
      // its `(ref null $mapStruct)` result valtype (`mapAnnShape` is `| null`-aware).
      if retNulMapFlag(fn.fnRet) == 1 { retSlot = mapAnnShape(fn.fnRet) }
      // A `: Cat` concrete-variant return is kind 8 — its `fbValtype` slot is the VARIANT
      // index (`uVarHeap[vi]`), which `retStructIndex` (standalone structs only) misses.
      if retVariantFlag(fn.fnRet) == 1 {
        retSlot = variantIndexOf(tyNameOf(fn.fnRet))
      }
      fbValtype(vtKindOfType(fn.fnRet), retSlot)
    }
  }
}

function emitTypeSection(
  n: i32,
  typeOffset: i32,
  hasStart: i32,
  memFn: i32,
  nPrintTypes: i32,
  nHelpers: i32,
) {
  const typePayload: i32[] = []
  // Bind the writer at `typePayload` for the WHOLE type-section payload build, so the
  // raw framing bytes, `pushFieldStorage`, and `fbValtype` all stream to `curBuf ==
  // typePayload` identically. Restored just before `wSection` frames it (below).
  const tyPrev = wTarget(typePayload)
  const nWrapT = exportWrapSlots().length
  wULEB(1 + nPrintTypes + memFn + nHelpers + nWrapT) // rectypes: the rec group + the standalone print/(log)/helper/export-wrapper functypes
  wU8(78)                                            // 0x4e rec group
  wULEB(n + typeOffset + hasStart)                   // types inside the rec group (print functypes excluded)
  // TWIN SKIP, used by four of the loops below (struct / variant / ref-list pair /
  // ref-valued map): a slot whose `*Twin[i] < i` shares an EARLIER slot's heap type,
  // which was already emitted — so skip it, in lock-step with the
  // `mAssignTypeIndices` allocation that reused that earlier index. Emitting it
  // anyway would desync every heap-type index from here on.
  if sDeclared {
    // One `0x5f` struct per declared type (declaration order = heap-type index),
    // each a struct of its fields in declaration order. A field is `0x7f` i32
    // (`sFieldTypes == 0`) or, for a string field (`== 3`), a non-null `(ref
    // $aTypeIdx)` (`0x64 <aTypeIdx>` — the raw `(array i32)` string rep); both mutable.
    let si = 0
    while si < sNames.length {
      // twin skip
      if sTwin[si] < si {
        si = si + 1
      } else {
        wU8(95) // 0x5f struct
        const cnt = sFieldCount[si]
        wULEB(cnt)
        let fj = 0
        while fj < cnt {
          const fjCode = sFieldTypeAt(si, fj)
          let fjSlot = sFieldRefSlot(si, fj)
          // A NESTED-STRUCT field (code 15) passes its TARGET struct table index.
          if fjCode == 15 { fjSlot = sFieldTgtStructIdx(si, fj) }
          // A MAP-typed field (code 19) — and its NULLABLE twin (code 29) — passes
          // its map SHAPE: the (KEY, VALUE) pair the field row records, not the value
          // alone. `pushFieldStorage` turns it into the field's storage heap type
          // through `mapTypeIdxOf`, which is where an i32-keyed map field would
          // otherwise have named the STRING-keyed map struct — the whole reason the
          // position was a loud reject before the row grew its key column (B6b).
          if fjCode == 19 || fjCode == 29 { fjSlot = sFieldMapShape(si, fj) }
          pushFieldStorage(fjCode, fjSlot)
          wU8(1) // mutable
          fj = fj + 1
        }
        si = si + 1
      }
    }
  }
  if uDeclared {
    // The `nv` variant structs FIRST (heap types 0..nv-1), each a struct of its i32
    // fields in declaration order (`0x5f` struct, count, then `0x7f 0x01` per field —
    // mutable i32). Then the union BOX `{ tag: i32, value: anyref }` at index `nv`:
    // `0x5f` struct, 2 fields — `0x7f 0x00` (i32, IMMUTABLE tag) and `0x6e 0x00`
    // (`anyref` abbreviation, IMMUTABLE value) — mirroring binaryen's `5f 02 7f 00
    // 6e 00` (verified against `toWasm.ts`'s `unionStruct`).
    let vi = 0
    while vi < uVariants.length {
      // twin skip
      if uVarTwin[vi] < vi {
        vi = vi + 1
        continue
      }
      wU8(95) // 0x5f struct
      const cnt = uFieldCount[vi]
      wULEB(cnt)
      let fj = 0
      while fj < cnt {
        const vjCode = variantFieldTypeAt(vi, fj)
        let vjSlot = variantFieldRefSlot(vi, fj)
        // A NESTED-STRUCT variant field (code 15) passes its struct table index.
        if vjCode == 15 { vjSlot = uFieldTgtStructIdx(vi, fj) }
        // A MAP-typed variant field (code 19) — and its NULLABLE twin (code 29) —
        // passes its map SHAPE (the struct loop's rule, one table over).
        if vjCode == 19 || vjCode == 29 { vjSlot = uFieldMapShape(vi, fj) }
        pushFieldStorage(vjCode, vjSlot)
        wU8(1) // mutable
        fj = fj + 1
      }
      vi = vi + 1
    }
    wU8(95)  // 0x5f struct (union box)
    wU8(2)   // 2 fields
    wU8(127) // field 0 tag: 0x7f i32
    wU8(0)   // immutable
    wU8(110) // field 1 value: 0x6e anyref
    wU8(0)   // immutable
    // The per-rep VALUE BOXES — each a one-field immutable struct `{ rep }` that
    // carries a scalar value-union payload behind the box's `anyref` slot
    // (mirroring `toWasm.ts`'s `valueBoxStruct`). Emitted in the SAME fixed order
    // `mAssignTypeIndices` interned them (i32, i64, f32, f64).
    if vbI32Used {
      wU8(95)  // 0x5f struct (i32 value box — boolean shares it)
      wU8(1)
      wU8(127) // 0x7f i32
      wU8(0)   // immutable
    }
    if vbI64Used {
      wU8(95)  // 0x5f struct (i64 value box)
      wU8(1)
      wU8(126) // 0x7e i64
      wU8(0)   // immutable
    }
    if vbF32Used {
      wU8(95)  // 0x5f struct (f32 value box)
      wU8(1)
      wU8(125) // 0x7d f32
      wU8(0)   // immutable
    }
    if vbF64Used {
      wU8(95)  // 0x5f struct (f64 value box)
      wU8(1)
      wU8(124) // 0x7c f64
      wU8(0)   // immutable
    }
  }
  if aUsed {
    wU8(94)  // 0x5e array
    wU8(127) // 0x7f i32 storagetype
    wU8(1)   // mutable
  }
  if lUsed {
    wU8(95)         // 0x5f struct
    wU8(3)          // 3 fields
    wU8(100)        // field 0 backing: 0x64 (ref ht) — non-null
    wSLEB(aTypeIdx) // ...to the raw array heap type
    wU8(1)          // mutable
    wU8(127)        // field 1 len: 0x7f i32
    wU8(1)          // mutable
    wU8(127)        // field 2 cap: 0x7f i32
    wU8(1)          // mutable
  }
  // One (backing, wrapper) PAIR per distinct ref-list element type, interleaved so each
  // wrapper immediately follows (and references) its own backing — the heap indices laid
  // out above. Each backing is `(array (mut (ref null $elem)))` over the slot's element
  // (struct heap idx / union box); each wrapper is `{ backing: (ref $back), len, cap }`.
  let rti = 0
  while rti < rlElemName.length {
    // twin skip — the whole (backing, wrapper) PAIR
    if rlTwin[rti] < rti {
      rti = rti + 1
    } else {
      wU8(94)               // 0x5e array (ref backing)
      wU8(99)               // 0x63 (ref null ht) — nullable element ref
      wSLEB(rlElemHeap[rti])
      wU8(1)                // mutable
      wU8(95)               // 0x5f struct (ref-list wrapper)
      wU8(3)                // 3 fields
      wU8(100)              // field 0 backing: 0x64 (ref ht) — non-null
      wSLEB(rlBackIdx[rti]) // ...to THIS slot's ref backing
      wU8(1)                // mutable
      wU8(127)              // field 1 len: 0x7f i32
      wU8(1)                // mutable
      wU8(127)              // field 2 cap: 0x7f i32
      wU8(1)                // mutable
      rti = rti + 1
    }
  }
  if slUsed || mUsed {
    // The STRING-REF list types, shared by the map's keys list and any `string[]`
    // field. (1) the backing array `(array (mut (ref null $aTypeIdx)))` — element is a
    // NULLABLE string ref (`0x63 <aTypeIdx>`) so `array.new_default` defaults spare
    // slots to null; an element read recovers the non-null string. (2) the list wrapper
    // `{ backing: (ref $mkArrIdx), len, cap }` — the same `{backing,len,cap}` triple as
    // the i32 list, over the string backing.
    wU8(94)  // 0x5e array (keys/string backing)
    wU8(99)  // 0x63 (ref null ht) — nullable string ref
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    wU8(95)  // 0x5f struct (string-list wrapper)
    wU8(3)   // 3 fields
    wU8(100) // field 0 backing: 0x64 (ref ht) — non-null
    wSLEB(mkArrIdx)
    wU8(1)   // mutable
    wU8(127) // field 1 len: 0x7f i32
    wU8(1)   // mutable
    wU8(127) // field 2 cap: 0x7f i32
    wU8(1)   // mutable
  }
  if mUsed {
    // The MAP struct — the 7-field open-addressing rep documented at `mUsed` in
    // emit_state. FIELD ORDER + COUNT match the host's general-purpose rep EXACTLY
    // (`compiler/builtins/maps.ts`, `MAP_HASHES = 6`): keys 0, vals 1, live 2,
    // index 3, count 4, size 5, hashes 6.
    wU8(95)  // 0x5f struct (map)
    wU8(7)   // 7 fields (open-addressing hash map, host-aligned)
    wU8(100) // field 0 keys: 0x64 (ref $mkListIdx) — non-null
    wSLEB(mkListIdx)
    wU8(1)   // mutable
    wU8(100) // field 1 vals: 0x64 (ref $lTypeIdx) — non-null
    wSLEB(lTypeIdx)
    wU8(1)   // mutable
    wU8(100) // field 2 live: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    wU8(100) // field 3 index: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    wU8(127) // field 4 count: 0x7f i32
    wU8(1)   // mutable
    wU8(127) // field 5 size: 0x7f i32
    wU8(1)   // mutable
    wU8(100) // field 6 hashes: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
  }
  if mI32Used {
    // The i32-KEYED map struct — the same 7 fields in the same order, with field 0
    // `keys` re-typed to the i32 list wrapper (`$lTypeIdx` over `$aTypeIdx`) instead
    // of the string-ref list. Every other field is byte-identical to the twin above,
    // which is why the probe/rehash/compact machinery is shared.
    wU8(95)  // 0x5f struct (i32-keyed map)
    wU8(7)   // 7 fields
    wU8(100) // field 0 keys: 0x64 (ref $lTypeIdx) — non-null i32 list
    wSLEB(lTypeIdx)
    wU8(1)   // mutable
    wU8(100) // field 1 vals: 0x64 (ref $lTypeIdx) — non-null
    wSLEB(lTypeIdx)
    wU8(1)   // mutable
    wU8(100) // field 2 live: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    wU8(100) // field 3 index: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    wU8(127) // field 4 count: 0x7f i32
    wU8(1)   // mutable
    wU8(127) // field 5 size: 0x7f i32
    wU8(1)   // mutable
    wU8(100) // field 6 hashes: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
  }
  if fa64Used {
    // The f64 array `(array (mut f64))` (Slice 4): `0x5e` array form, `0x7c` f64
    // storagetype, `0x01` mutable — the f64 analogue of the `5e 7f 01` i32 array.
    wU8(94)  // 0x5e array
    wU8(124) // 0x7c f64 storagetype
    wU8(1)   // mutable
    // The f64-list wrapper `{ backing: (ref $fa64TypeIdx), len: i32, cap: i32 }` — the
    // same `{backing,len,cap}` triple as the i32 list, over the f64 backing.
    wU8(95)            // 0x5f struct
    wU8(3)             // 3 fields
    wU8(100)           // field 0 backing: 0x64 (ref ht) — non-null
    wSLEB(fa64TypeIdx) // ...to the f64 array heap type
    wU8(1)             // mutable
    wU8(127)           // field 1 len: 0x7f i32
    wU8(1)             // mutable
    wU8(127)           // field 2 cap: 0x7f i32
    wU8(1)             // mutable
  }
  if ia64Used {
    // The i64 array `(array (mut i64))` — `0x5e` array form, `0x7e` i64 storagetype,
    // `0x01` mutable (the i64 sibling of the `5e 7c 01` f64 array). Emitted right after the
    // f64 pair, matching the type-index allocation order.
    wU8(94)  // 0x5e array
    wU8(126) // 0x7e i64 storagetype
    wU8(1)   // mutable
    // The i64-list wrapper `{ backing: (ref $ia64TypeIdx), len: i32, cap: i32 }`.
    wU8(95)            // 0x5f struct
    wU8(3)             // 3 fields
    wU8(100)           // field 0 backing: 0x64 (ref ht) — non-null
    wSLEB(ia64TypeIdx) // ...to the i64 array heap type
    wU8(1)             // mutable
    wU8(127)           // field 1 len: 0x7f i32
    wU8(1)             // mutable
    wU8(127)           // field 2 cap: 0x7f i32
    wU8(1)             // mutable
  }
  if fa32Used {
    // The f32 array `(array (mut f32))` — `0x5e` array form, `0x7d` f32 storagetype, `0x01`
    // mutable (the f32 sibling of the `5e 7c 01` f64 / `5e 7e 01` i64 arrays). Emitted right
    // after the i64 pair, matching the type-index allocation order.
    wU8(94)  // 0x5e array
    wU8(125) // 0x7d f32 storagetype
    wU8(1)   // mutable
    // The f32-list wrapper `{ backing: (ref $fa32TypeIdx), len: i32, cap: i32 }`.
    wU8(95)            // 0x5f struct
    wU8(3)             // 3 fields
    wU8(100)           // field 0 backing: 0x64 (ref ht) — non-null
    wSLEB(fa32TypeIdx) // ...to the f32 array heap type
    wU8(1)             // mutable
    wU8(127)           // field 1 len: 0x7f i32
    wU8(1)             // mutable
    wU8(127)           // field 2 cap: 0x7f i32
    wU8(1)             // mutable
  }
  if fnValUsed {
    // The closure fat-pointer struct `{ env: (ref null struct), id: i32 }` (lambdas) —
    // field 0 a nullable `structref` env (null when non-capturing), field 1 the lifted
    // function's wasm INDEX (`gImports + fe`), which is BOTH the identity token for
    // `==` and the `call_indirect` operand. Both IMMUTABLE. ONE closure struct serves
    // every function arity because the id is untyped; a call site supplies the concrete
    // env-leading `$fnsig` as `call_indirect`'s type operand and the engine checks the
    // callee against it, trapping on mismatch. The struct holds NO `funcref`: reading a
    // funcref field back out of the GC heap is a host libcall in wasmtime (~9.4 ns) and
    // writing one interns per closure created (~41 ns), where an i32 field is a plain
    // load. The interned `$fnsig` functypes (one per distinct value-call arity) follow.
    wU8(95)  // 0x5f struct
    wU8(2)   // 2 fields
    wU8(99)  // field 0 env: 0x63 (ref null ht)
    wU8(107) // ...to the abstract `struct` heaptype (structref)
    wU8(0)   // immutable
    wU8(127) // field 1 id: 0x7f i32 — identity token AND dispatch index
    wU8(0)   // immutable
    // One env-leading `$fnsig` functype per distinct eligible SIGNATURE, in
    // `cloSigKeys` order: `(structref, params...) -> ret`, the param/result valtypes
    // read off the representative function (`cloSigRepFn` — every function sharing
    // the key has byte-identical kinds, by construction of the key).
    let sai = 0
    while sai < cloSigKeys.length {
      const repFe = cloSigRepFn[sai]
      // A union-arm / annotation signature with NO concrete closure (`collectCloSigs`
      // interned it from a bare `(…)=>…` type) carries the -1 rep sentinel: synthesize
      // its functype from the KEY string (byte-identical to the rep path for that key).
      if repFe < 0 {
        emitSynthCloSig(cloSigKeys[sai])
        sai = sai + 1
        continue
      }
      const rep = P.nodes[fnStmts[repFe]]
      if rep is FuncDecl {
        const rparams = rep.fnParams
        wU8(96)                   // 0x60 func
        wULEB(rparams.length + 1) // env + declared params
        wU8(107)                  // param 0 env: structref (0x6b)
        let pj = 0
        while pj < rparams.length {
          fbValtype(vtKindOfParam(rparams[pj]), paramStructIdxOf(rparams[pj]))
          pj = pj + 1
        }
        // The RESULT must byte-match the rep function's own functype result so
        // the call site's `call_indirect $fnsig` signature check accepts the callee:
        // a VOID field-closure sig (`>v`) has 0 results; a STRUCT-returning one
        // (`>sN;`) yields the struct ref exactly as the function functype does.
        if fRetVoid[repFe] == 1 {
          wU8(0) // 0 results — the `>v` write-trap sig
        } else {
          wU8(1) // 1 result
          // The result valtype the rep function's OWN functype emits — scalar (i32/f64/
          // i64), string, an i32/string/f64 list, a union box, a nullable scalar/struct,
          // or a struct ref (`cloRetValKind`/`cloRetValSlot`, the shared mapping).
          const rrk = cloRetValKind(repFe)
          let rrkCode: VKind = "i32"
          if rrk != null { rrkCode = rrk }
          fbValtype(rrkCode, cloRetValSlot(repFe))
        }
      }
      sai = sai + 1
    }
    // One env struct per CAPTURING lifted function (`fnEnvIdx[fe] >= 0`), in `fnStmts`
    // order — the order `mAssignTypeIndices` minted them. Each is a struct of one
    // IMMUTABLE i32 field per captured variable (capture order = field order). The
    // corpus captures are all i32 (and one struct-ref capture in `closure.vl`'s
    // `sumPoint`, handled by emitting the captured ref's valtype).
    let fe = 0
    while fe < fnStmts.length {
      if fnEnvIdxOf(fe) >= 0 {
        const caps = captureNamesOf(fe)
        wU8(95) // 0x5f struct
        wULEB(caps.length)
        let ci = 0
        while ci < caps.length {
          fbValtype(
            captureValKind(fe, caps[ci]),
            captureValStructIdx(fe, caps[ci]),
          )
          wU8(0) // immutable
          ci = ci + 1
        }
      }
      fe = fe + 1
    }
  }
  // The ref-valued map structs (one per DISTINCT (key, value) layout), in
  // `mvMapTypeIdx` mint order — the SAME 7-field shape as the mono map struct, with
  // `vals` referencing this slot's ref-list wrapper (the string-list pair for string
  // values, the element's `rlWrapIdx` for struct values) and `keys` referencing this
  // slot's KEY list (the string-ref pair, or the i32 list for a `{[i32]: V}`).
  // Live/index/count/size/hashes are identical across all map structs, so the shared
  // probe/rehash/compact bytes apply as-is — only the two list fields vary.
  let mvs = 0
  while mvs < mvValName.length {
    // twin skip
    if mvTwin[mvs] < mvs {
      mvs = mvs + 1
      continue
    }
    // Field 0's type IS the second half of this slot's identity (`repMapValSlotsTwin`
    // refuses to twin across it), so it is read from the same column the resolvers key
    // on rather than assumed to be the string-ref list.
    let mvKeysWrap = mkListIdx
    if mvSlotKeyI32(mvs) { mvKeysWrap = lTypeIdx }
    wU8(95)  // 0x5f struct (ref-valued map)
    wU8(7)   // 7 fields (host-aligned open-addressing hash map)
    wU8(100) // field 0 keys: 0x64 (ref <this slot's keys wrapper>) — non-null
    wSLEB(mvKeysWrap)
    wU8(1)   // mutable
    wU8(100) // field 1 vals: 0x64 (ref <this slot's wrapper>)
    wSLEB(mvValsWrapOf(mvs))
    wU8(1)   // mutable
    wU8(100) // field 2 live: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    wU8(100) // field 3 index: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    wU8(127) // field 4 count: 0x7f i32
    wU8(1)   // mutable
    wU8(127) // field 5 size: 0x7f i32
    wU8(1)   // mutable
    wU8(100) // field 6 hashes: 0x64 (ref $aTypeIdx) — non-null i32 array
    wSLEB(aTypeIdx)
    wU8(1)   // mutable
    mvs = mvs + 1
  }
  // The functype param/result valtypes (`fbValtype`) stream to `curBuf == typePayload`,
  // interleaved identically with the surrounding raw framing bytes (the `wTarget` bind
  // covering this whole payload build was established above).
  let ti = 0
  while ti < n {
    emitOneFuncType(ti, fnValUsed)
    ti = ti + 1
  }
  // ── the TAIL functypes, in emit order ───────────────────────────────────────
  // Everything from here down is APPENDED after the user functypes, each group after
  // the last, so no earlier functype index ever shifts and the Phase-G assert stays
  // untouched. Each is a `0x60` func rectype; the indices run:
  //   start fn `()->()`     `typeOffset + n`         (only when hasStart)
  //   print `(i32)->()`     +1   shared by __print_i32__ / __print_bool__ / _char__
  //   print `()->()`        +1   __print_str_flush__
  //   `(i64)->()` then `(f64)->()` then `(f32)->()`  one per WIDE scalar the program
  //                              prints, in that order (Slices 1 / 3 / 5)
  //   `(i32,i32)->()`       `typeOffset + n + hasStart + nPrintTypes`  the __log__ decoder
  //   the helper functypes  + memFn + <helper order>  (see `emitFunctionSection`)
  //
  // The PRINT functypes are STANDALONE rectypes, outside the rec group whose count was
  // written above: a strict-GC host (wasmtime) refuses to match a rec-group-member
  // functype — which carries nominal rec-group identity — against a host-provided
  // function, so `__print_i32__` & co. would fail to instantiate. A HELPER functype may
  // still reference an earlier rec-group type (`$aTypeIdx` / `$mkArrIdx`): a later
  // rectype referencing an earlier type index is always valid.
  if hasStart == 1 {
    wU8(96) // 0x60 func
    wU8(0)  // 0 params
    wU8(0)  // 0 results
  }
  if gImports > 0 {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(127) // 0x7f i32
    wU8(0)   // 0 results
    wU8(96)  // 0x60 func
    wU8(0)   // 0 params
    wU8(0)   // 0 results
  }
  if gNeedsI64Print {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(126) // 0x7e i64
    wU8(0)   // 0 results
  }
  if gNeedsF64Print {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(124) // 0x7c f64
    wU8(0)   // 0 results
  }
  if gNeedsF32Print {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(125) // 0x7d f32
    wU8(0)   // 0 results
  }
  if memLogUsed {
    wU8(96)  // 0x60 func — the `__log__` decoder
    wU8(2)   // 2 params
    wU8(127) // 0x7f i32 (offset)
    wU8(127) // 0x7f i32 (length)
    wU8(0)   // 0 results
  }
  // The shared runtime helpers, in helper-index order.
  if gHelpStrHash >= 0 {
    helpFuncType("a", "i")  // __str_hash__: (str) -> i32
    helpFuncType("aa", "i") // __str_eq__: (str, str) -> i32
    helpFuncType("aa", "a") // __str_concat__: (str, str) -> (ref str)
  }
  if gHelpMapProbe >= 0 {
    // __map_probe__: (keyHash, index, hashes, live, keysBacking, key) -> slot
    helpFuncType("iaaama", "i")
    helpFuncType("aaaii", "a") // __map_resize__: (index, hashes, live, count, size) -> index'
  }
  if gHelpMapProbeI32 >= 0 {
    // __map_probe_i32__: (index, hashes, live, keysBacking, key i32) -> slot — the same
    // five operands with an i32 keys backing (`a`) and an i32 KEY (`i`).
    helpFuncType("aaaai", "i")
  }
  // The EXPORT-WRAPPER functypes LAST (#1265), one per export entry, each the target's
  // own signature emitted with `withEnv` FALSE — the clean ABI shape, produced by the
  // same `emitOneFuncType` the main loop uses, so a wrapper's published type cannot drift
  // from the function it forwards to. Empty unless `fnValUsed`, so a module with no
  // function value emits no extra rectype and stays byte-identical.
  const wrapT = exportWrapSlots()
  let wti = 0
  while wti < wrapT.length {
    emitOneFuncType(wrapT[wti], false)
    wti = wti + 1
  }
  wTarget(tyPrev)
  wSection(1, typePayload)
  0
}

function emitImportSection(n: i32, typeOffset: i32, hasStart: i32) {
  // Import section (id 2, between type and function): the 4-entry print family from
  // the host's `"imports"` module, occupying function indices 0..3 in this exact
  // order (the call lowering hardcodes them): __print_i32__, __print_bool__,
  // __print_char__ (all `(i32)->()`), __print_str_flush__ (`()->()`).
  if gImports > 0 {
    const ftI32 = typeOffset + n + hasStart
    const ftVoid = ftI32 + 1
    const ftI64 = ftVoid + 1
    // The `(f64)->()` functype index trails the i64 one when present, else the void one.
    let ftF64 = ftVoid + 1
    if gNeedsI64Print { ftF64 = ftI64 + 1 }
    // The `(f32)->()` functype index trails the f64 one when present, else wherever the
    // f64 index would be (the standalone functypes are emitted i64 → f64 → f32 in order).
    let ftF32 = ftF64
    if gNeedsF64Print { ftF32 = ftF64 + 1 }
    const importPayload: i32[] = []
    const imPrev = wTarget(importPayload)
    // 4 imports normally; +1 each for `__print_i64__` / `__print_f64__` / `__print_f32__`.
    let nImports = 4
    if gNeedsI64Print { nImports = nImports + 1 }
    if gNeedsF64Print { nImports = nImports + 1 }
    if gNeedsF32Print { nImports = nImports + 1 }
    wULEB(nImports)
    wName("imports")
    wName("__print_i32__")
    wU8(0) // import kind: func
    wULEB(ftI32)
    wName("imports")
    wName("__print_bool__")
    wU8(0)
    wULEB(ftI32)
    wName("imports")
    wName("__print_char__")
    wU8(0)
    wULEB(ftI32)
    wName("imports")
    wName("__print_str_flush__")
    wU8(0)
    wULEB(ftVoid)
    // `__print_i64__` LAST, at function index 4 (`fbCall(4)` in the print router), so
    // the existing imports keep indices 0..3 and only this entry is conditionally added.
    if gNeedsI64Print {
      wName("imports")
      wName("__print_i64__")
      wU8(0)
      wULEB(ftI64)
    }
    // `__print_f64__` LAST, at function index `gF64PrintIdx` (4 or 5). (Slice 3.)
    if gNeedsF64Print {
      wName("imports")
      wName("__print_f64__")
      wU8(0)
      wULEB(ftF64)
    }
    // `__print_f32__` LAST, at function index `gF32PrintIdx` (4/5/6). (Slice 5.)
    if gNeedsF32Print {
      wName("imports")
      wName("__print_f32__")
      wU8(0)
      wULEB(ftF32)
    }
    wTarget(imPrev)
    wSection(2, importPayload)
  }
  0
}

function emitFunctionSection(
  n: i32,
  typeOffset: i32,
  hasStart: i32,
  memFn: i32,
  nPrintTypes: i32,
  nHelpers: i32,
) {
  // Function section (id 3): N functions; func i uses functype `typeOffset + i`. The
  // synthetic start function (if any) is the LAST entry — function index `n` — using
  // the `()->()` functype at index `typeOffset + n`.
  const funcPayload: i32[] = []
  const fnPrev = wTarget(funcPayload)
  const wrapF = exportWrapSlots()
  wULEB(n + hasStart + memFn + nHelpers + wrapF.length)
  let fi = 0
  while fi < n {
    // A function whose env-leading signature matches an interned `$fnsig` is declared
    // with that `$fnsig` functype, so a `call_indirect $fnsig` reaching it passes the
    // engine's signature check (its ACTUAL type IS `$fnsig`). Others keep their own
    // functype. Only when `fnValUsed`. (Lambdas.)
    if fnValUsed && fnSigIsClosure(fi) {
      wULEB(fnSigIdxOfFn(fi))
    } else {
      wULEB(typeOffset + fi) // functype index
    }
    fi = fi + 1
  }
  if hasStart == 1 {
    wULEB(typeOffset + n) // start fn functype index
  }
  if memLogUsed {
    // The synthetic `__log__` decoder uses the standalone `(i32,i32)->()` functype
    // emitted after the print functypes.
    wULEB(typeOffset + n + hasStart + nPrintTypes)
  }
  // The shared runtime helpers, each on its own standalone functype (emitted after
  // the `__log__` functype in the SAME helper order, so functype k belongs to
  // helper k).
  const helpTyBase = typeOffset + n + hasStart + nPrintTypes + memFn
  let hi = 0
  while hi < nHelpers {
    wULEB(helpTyBase + hi)
    hi = hi + 1
  }
  // The export wrappers LAST — after every other function, so no existing function index
  // shifts — each on its own functype, emitted in this same order at the tail of the type
  // section (`helpTyBase + nHelpers + k`).
  let wfi = 0
  while wfi < wrapF.length {
    wULEB(helpTyBase + nHelpers + wfi)
    wfi = wfi + 1
  }
  wTarget(fnPrev)
  wSection(3, funcPayload)
  0
}

function emitGlobalSection() {
  // Global section (id 6): one mutable global per top-level `let`/`const`, in
  // declaration order (that order IS the global index `global.get`/`global.set` use).
  // Each entry is `<valtype> 0x01 <init constexpr> 0x0b`. The valtype mirrors `pushVT`'s
  // kind for the initializer (i32 / struct ref / list ref / string ref); the init reuses
  // the ordinary `emitExpr` literal lowering — `i32.const`, `struct.new`, and
  // `array.new_fixed` are all valid WasmGC constant expressions, so no start function is
  // needed for the literal initializers in scope. A non-constexpr init (a reference to a
  // local/param) fails loudly via `emitExpr(fnIx = -1)` (start-fn fallback deferred).
  // A PROMOTED binding (G2c) emits NO cell — it lives in a start-function local — so
  // the count is the declarations MINUS the promoted ones, and the survivors' indices
  // come from `gCellIdx` (which `userGlobalIdx` is the single translation through).
  const ng = globalStmts.length
  let nCells = 0
  let nci = 0
  while nci < ng {
    if gPromoOk[nci] != 1 { nCells = nCells + 1 }
    nci = nci + 1
  }
  const np = gStrPoolTexts.length
  if nCells + np > 0 {
    const globalPayload: i32[] = []
    // Bind the writer at `globalPayload` for the WHOLE global-section payload build, so
    // the count, each entry's valtype (`fbValtype`), mutability flag, and init constexpr
    // (`fb*` opcodes) all stream to `curBuf == globalPayload`. Restored before framing.
    const gPrev = wTarget(globalPayload)
    wULEB(nCells + np)
    // The string-literal POOL first (indices 0..np-1, before the user cells — see
    // `gStrPoolTexts`): each entry an IMMUTABLE non-null string ref whose init
    // constexpr builds the literal once (`i32.const` per code point +
    // `array.new_fixed` — every pooled literal fits the cap by construction).
    let pli = 0
    while pli < np {
      wU8(100) // 0x64 (ref $aTypeIdx) — non-null string ref
      wSLEB(aTypeIdx)
      wU8(0)   // immutable
      const pcps = decodeStr(strToCps(gStrPoolTexts[pli]))
      let pci = 0
      while pci < pcps.length {
        fbI32Const(pcps[pci])
        pci = pci + 1
      }
      fbArrayNewFixed(aTypeIdx, pcps.length)
      fbEnd() // 0x0b end of init expr
      pli = pli + 1
    }
    let gi = 0
    while gi < ng {
      // A PROMOTED binding (G2c) emits no cell at all: its value lives in a
      // start-function local and its initializer becomes a `local.set` there.
      if gPromoOk[gi] == 1 {
        gi = gi + 1
        continue
      }
      const g = P.nodes[globalStmts[gi]]
      if g is LetDecl {
        if g.letInit < 0 {
          return emitFail("emitProgram: module global has no initializer")
        }
        if globalIsNonConst(globalStmts[gi]) {
          // A non-constexpr init (`curBuf = W.bytes` — a `global.get`+`struct.get`, a
          // reference to another global, a call, etc.) cannot be a WasmGC constant
          // expression. Declare the cell NULLABLE and zero-init it (`i32.const 0` for a
          // scalar, `ref.null` for a ref); the synthetic start function below runs the
          // real init via `global.set` before any other code, so reads never see the
          // zero. The cell stays mutable.
          const ck = globalCellKind(globalStmts[gi])
          // For a ref-array cell (kind 5) the second `fbValtype`/`fbRefNullForKind` arg is
          // the ref-list TABLE SLOT (`globalCellStructIdx` is -1 for a ref array), so the
          // cell valtype and its `ref.null` zero select THIS global's element wrapper.
          let cs = globalCellStructIdx(globalStmts[gi])
          if ck == "reflist" { cs = globalRefListSlot(globalStmts[gi]) }
          // A NULLABLE ref-array cell (kind 18) selects THIS global's element wrapper
          // (`rlWrapIdx[slot]`) for its `(ref null …)` valtype + `ref.null` zero — the
          // nullable twin of the `reflist` slot seed.
          if ck == "nulreflist" { cs = letAnnRefListSlot(globalStmts[gi]) }
          // A map cell (kind 6) passes its map SHAPE (mv slot / -1 mono / -2 set)
          // so the cell valtype + ref.null zero select THIS map's struct type.
          if ck == "map" { cs = letMapShapeOf(globalStmts[gi], -1) }
          // A NULLABLE map cell (kind `nulmap`) passes the SAME map SHAPE — its `(ref null
          // $mapStruct)` valtype + `ref.null` zero select THIS map's struct type.
          if ck == "nulmap" { cs = nulMapShapeOf(globalStmts[gi], -1) }
          fbValtypeNullable(ck, cs) // nullable valtype
          wU8(1)                    // 0x01 mutable
          if ck == "i32" {
            fbI32Const(0) // i32 scalar zero
          } else if ck == "i64" {
            fbI64Const(0, 0) // i64 scalar zero (Slice 1)
          } else if ck == "f64" {
            fbF64Const("0.0") // f64 scalar zero (Slice 3)
          } else if ck == "f32" {
            fbF32Const("0.0") // f32 scalar zero (Slice 5)
          } else {
            fbRefNullForKind(ck, cs) // ref.null zero
          }
          fbEnd() // 0x0b end of init expr
        } else {
          // The cell's valtype comes from the binding's ANNOTATION when present (so a
          // global agrees with a same-typed local/param/field on its struct table index),
          // falling back to the literal-init kind for an un-annotated global. The init
          // constexpr (`emitExpr`) lowers the literal — and must build the SAME wasm type:
          // `pendingStructIdx` seeds an `ObjLit` to the annotated struct (not the first
          // field-name match), and `pendingListKind`/`pendingListSlot` seed an empty `[]`
          // to the annotation's ref/string list (not the i32-list the bare literal infers),
          // exactly as the local-`let` path threads them.
          const gck = globalCellKind(globalStmts[gi])
          let gcs = globalCellStructIdx(globalStmts[gi])
          if gck == "struct" { pendingStructIdx = gcs }
          // A NULLABLE-struct cell (kind 9) seeds the same struct context: a bare
          // `null` init lowers as `ref.null $S` (a valid constexpr), a struct
          // literal as that struct.
          if gck == "nulstruct" { pendingStructIdx = gcs }
          pendingListKind = letAnnRefListKind(globalStmts[gi])
          pendingListSlot = letAnnRefListSlot(globalStmts[gi])
          // A DISTINCT-backing nullable scalar list cell (`i64[]|null`, `f32[]|null`, …): seed the
          // leaf list-build code so the const init builds the RIGHT wrapper (a small `i64` literal
          // would otherwise build the i32 list; an `f32` list an f64 one). The non-null list value
          // subtypes the nullable cell.
          const gNulSLK = nulScalarListBuildKind(gck)
          if gNulSLK != 0 { pendingListKind = gNulSLK }
          // A ref-array cell (kind 5) passes the ref-list TABLE SLOT as `fbValtype`'s
          // second arg (`globalCellStructIdx` is -1 for a ref array) so the cell valtype
          // selects THIS global's element wrapper — annotation-first, init-inferred when
          // un-annotated — not slot 0's.
          if gck == "reflist" { gcs = globalRefListSlot(globalStmts[gi]) }
          // A NULLABLE ref-array cell (kind 18): the ref-list TABLE SLOT selects THIS
          // global's element wrapper for the `(ref null $rlWrap)` cell valtype, matching the
          // init's reflist build (`pendingListKind`/`pendingListSlot` above seed the same).
          if gck == "nulreflist" { gcs = letAnnRefListSlot(globalStmts[gi]) }
          // A map cell (kind 6): the map SHAPE picks the struct type; the
          // `pendingMapSlot` seed makes the `Map()` init constexpr build it.
          if gck == "map" {
            gcs = letMapShapeOf(globalStmts[gi], -1)
            pendingMapSlot = gcs
          }
          // A NULLABLE map cell (kind `nulmap`): the map SHAPE picks the struct type; a bare `null`
          // init lowers as `ref.null $mapStruct` (`pendingNulRefHeap`), a `Map()` init builds it
          // (`pendingMapSlot`). Both are valid WasmGC constexprs.
          if gck == "nulmap" {
            gcs = nulMapShapeOf(globalStmts[gi], -1)
            pendingMapSlot = gcs
            pendingNulRefHeap = mapTypeIdxOf(gcs)
          }
          fbValtype(gck, gcs) // valtype
          wU8(1)              // 0x01 mutable
          // An `: i64` global lowers its literal init as `i64.const` (kind 10 / 0x7e);
          // an `: f32`/`: f64` global as `f32.const`/`f64.const` (kind 13 / 0x7d, 11 /
          // 0x7c) — re-encoding an integer literal directly so the init stays a valid
          // constexpr (no convert op). (Slice 5.)
          pendingI64 = (gck == "i64")
          pendingF32 = (gck == "f32")
          pendingF64 = (gck == "f64")
          // A literal-union const global (`const D: K = "a"`) lowers its member init as `i32.const <id>`
          // (a valid constexpr).
          if letIsLitUnion(globalStmts[gi]) { pendingLitUnion = 1 }
          // A NULLABLE-litunion const global (`const g: K0 | null = "404"`): the member
          // init lowers as its atom id and a bare `null` as the `-1` sentinel — the
          // nullable twin of the arm above. Un-seeded, a member init emitted the STRING
          // ref into the i32 niche cell (INVALID-WASM; fuzz post-#1000 sweep plain leg,
          // seed drawn as `K0 | null` p3r) and a `null` init drew a loud reject.
          if g.letType >= 0 {
            if nodeTyIsNulLitUnion(g.letType) {
              pendingLitUnion = 1
              pendingNulLitUnion = true
            }
          }
          // A UNION cell (kind 4) with a CONST init boxes it in the constexpr —
          // `struct.new` / `array.new_fixed` / `i32.const` are all constant in
          // WasmGC, so `let w: string | i32 = "a"` builds the box inline.
          let gun2 = ""
          if gck == "union" { gun2 = letUnionNameOf(globalStmts[gi], -1) }
          // A module-level `const f = add` aliasing a GENERIC (un-annotated-param) named
          // function, used only as a direct-call callee: emit the closure through the
          // floor-LESS core, exactly as the function-body twin in `emitLetDeclStmt` does.
          // `struct.new` is a valid WasmGC constexpr, so the cell builds inline.
          const gAliasFe = monoGenericAliasFe(globalStmts[gi])
          if gun2 != "" {
            if emitUnionCoerce(globalPayload, gun2, g.letInit, -1) < 0 {
              return -1
            }
          } else if gAliasFe >= 0 {
            if emitClosureValueCore(globalPayload, gAliasFe, -1) < 0 {
              return -1 // init constexpr
            }
          } else {
            if emitExpr(globalPayload, g.letInit, -1) < 0 {
              return -1 // init constexpr
            }
          }
          pendingI64 = false
          pendingF32 = false
          pendingF64 = false
          pendingListKind = 0
          pendingListSlot = 0
          pendingLitUnion = 0
          pendingNulLitUnion = false
          fbEnd() // 0x0b end of init expr
        }
      }
      gi = gi + 1
    }
    wTarget(gPrev)
    wSection(6, globalPayload)
  }
  0
}

// The `fnStmts` slot an export TARGET name resolves to — the FIRST slot carrying it — or
// -1. The module's ABI resolution, in one place: #1260's `monoFirstFnIndexNamed` mirrors
// this same rule inside the monomorphizer, and four sections now depend on it agreeing.
function exportSlotOfTarget(name: string): i32 {
  let tj = 0
  while tj < fnStmts.length {
    const tfn = P.nodes[fnStmts[tj]]
    if tfn is FuncDecl {
      if tfn.fnName == name { return tj }
    }
    tj = tj + 1
  }
  -1
}

// The PUBLIC names the export section publishes, in section order: every alias-table
// entry whose target resolves, minus duplicates (a wasm export name must be unique, and
// a repeated public name keeps its FIRST entry).
function exportPublicNames(): string[] {
  const nms: string[] = []
  let rxi = 0
  while rxi < reExpName.length {
    if (
      exportSlotOfTarget(reExpTarget[rxi]) >= 0 &&
      !capHas(nms, reExpName[rxi])
    ) {
      nms.push(reExpName[rxi])
    }
    rxi = rxi + 1
  }
  nms
}

// The `fnStmts` slot each published name resolves to, PARALLEL to `exportPublicNames`.
// The two walk `reExpName` in the same order under the same two predicates, so entry k of
// one belongs to entry k of the other by construction.
function exportTargetSlots(): i32[] {
  const slots: i32[] = []
  const seen: string[] = []
  let rxi = 0
  while rxi < reExpName.length {
    const hit = exportSlotOfTarget(reExpTarget[rxi])
    if hit >= 0 && !capHas(seen, reExpName[rxi]) {
      seen.push(reExpName[rxi])
      slots.push(hit)
    }
    rxi = rxi + 1
  }
  slots
}

// #1265 — THE EXPORT ENTRIES THAT NEED AN ABI WRAPPER, parallel to `exportPublicNames`,
// and EMPTY unless the module uses a function value.
//
// When `fnValUsed`, every function in the module carries a hidden leading `structref env`
// param (`envSlotShift` — a whole-module decision, so it applies to functions that are
// never taken as values and to modules whose only function value is an unrelated lambda
// or a `.map` callback). That param is an INTERNAL calling convention, but the export
// section published the target function DIRECTLY, so it leaked into the module's ABI:
// `export function f(a: i32): i32` in a file that also writes `const g = f` — or merely
// `xs.map(...)` anywhere — published `f` as `(structref, i32) -> i32`. An importer calling
// `f(1)` gets a boundary TypeError ("type incompatibility when transforming from/to JS");
// one that knows to pass `(null, 1)` gets the right answer. Measured, both.
//
// So each export entry gets a thin forwarding wrapper carrying the CLEAN signature, and
// the export names the wrapper. Gated on `fnValUsed` because a module without function
// values has no env param to hide, and must stay byte-identical.
//
// Per ENTRY rather than per slot: two public names may alias one function
// (`export { id, id as identity }`), and one wrapper each is a few bytes against having to
// dedup slots that the parallel-array invariant above would then lose.
function exportWrapSlots(): i32[] {
  const none: i32[] = []
  if !fnValUsed { return none }
  exportTargetSlots()
}

// A wrapper body: supply the env the internal convention wants, forward the declared
// params, tail into the real function. A top-level export cannot capture anything — only
// a NESTED function can, and `export` is top-level only — so `ref.null struct` is the
// correct env, exactly as `wasmEmit`'s direct-call path passes for a non-capturing callee.
// No locals: the wrapper's own params ARE locals 0..p-1, un-shifted, because this function
// is the one function in the module that does NOT carry an env param.
function emitExportWrapperCode(out: i32[], slot: i32) {
  const body: i32[] = []
  const prev = wTarget(body)
  wULEB(0) // no local runs
  fbRefNullStruct()
  const wfn = P.nodes[fnStmts[slot]]
  if wfn is FuncDecl {
    let pi = 0
    while pi < wfn.fnParams.length {
      fbLocalGet(pi)
      pi = pi + 1
    }
  }
  fbCall(gImports + slot)
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

function emitExportSection(_n: i32, wrapBase: i32) {
  // Export section (id 7): the module's ABI is EXACTLY the alias tables the
  // driver staged — re-export entries (`export { name } from "dep"` → the
  // merged, mangled target) plus the root module's plain `export`-marked
  // functions (a single-source program's `export function f` rides the same
  // tables, unmangled). Nothing else is exported: an internal function (a
  // lifted `__lambda_N` closure, a `name#k` mono instance, a dependency's
  // machinery) stays private — a program RUNS by instantiation (the start fn
  // is the top level), and a lean surface lets `wasm-opt` prune unreached
  // code. A name is a UTF-8 byte vec; for an ASCII identifier each `name[i]`
  // char code IS its byte. Entries are resolved against `fnStmts` first so the
  // section count is exact; a duplicate public name keeps its FIRST entry
  // (export names must be unique). An export-free program omits the section.
  const reExpEi = exportTargetSlots() // the target's `fnStmts` position, parallel to its public name
  const reExpNm = exportPublicNames()
  // P0.2 — EXPORT THE LINEAR MEMORY (`buffer-design.md` §C5, ruling O4(i)).
  //
  // The memory is exported under the universal name `memory`, automatically, and
  // gated on the memory EXISTING at all: `memUsed` is the same flag that decides
  // whether section 5 is emitted, so a program that never touches linear memory is
  // byte-identical to before — no new section, no new entry, no new name.
  //
  // Why automatic rather than a `--export-memory` flag: an unused memory is not
  // emitted, so there is nothing to opt out OF, and a flag here would be the first
  // `vl build` option that changes the emitted ABI. Why `memory`: it is what a host
  // reaches for (`instance.exports.memory.buffer`) and the convention every wasm
  // toolchain follows.
  //
  // The collision is real and is rejected LOUDLY. Wasm export names must be unique,
  // so a user `export function memory()` in a memory-using program would otherwise
  // build an invalid module. It is a rare and mechanically fixable reject (rename the
  // function), which is the trade O4(i) makes.
  if memUsed {
    let mci = 0
    while mci < reExpNm.length {
      if reExpNm[mci] == "memory" {
        return emitFail(
          "emitProgram: this program exports a function named 'memory', but a program that uses linear memory exports the memory itself under that name — rename the function",
        )
      }
      mci = mci + 1
    }
  }
  // An export-free program still omits the section — UNLESS the memory is exported,
  // in which case section 7 exists to carry that one entry. (Master returned here
  // whenever there were no function exports, which would have dropped the memory
  // export in exactly the program that wants it most: a memory-only module.)
  if reExpNm.length == 0 && !memUsed { return 0 }
  let nExports = reExpNm.length
  if memUsed { nExports = nExports + 1 }
  const exportPayload: i32[] = []
  const exPrev = wTarget(exportPayload)
  wULEB(nExports)
  // Each entry: the bare public name pointing at the target's func index — or, when the
  // module has an env-leading calling convention to hide, at entry `rei`'s ABI WRAPPER
  // (#1265). `exportWrapSlots` is parallel to `reExpNm`, and the wrappers are appended in
  // that same order after every other function, so entry `rei`'s wrapper is `wrapBase +
  // rei`. Without a wrapper the internal `structref env` param leaked into the ABI.
  let rei = 0
  while rei < reExpNm.length {
    wName(reExpNm[rei])
    wU8(0) // export kind: func
    if fnValUsed {
      wULEB(wrapBase + rei)
    } else {
      wULEB(gImports + reExpEi[rei])
    }
    rei = rei + 1
  }
  // The memory entry LAST, so every function export keeps the index it had — the
  // export section is order-insensitive to a host, but keeping the prefix identical
  // makes the A/B byte diff read as a pure append.
  if memUsed {
    wName("memory")
    wU8(2)   // export kind: memory
    wULEB(0) // memory index 0 (the one module-defined memory)
  }
  wTarget(exPrev)
  wSection(7, exportPayload)
  0
}

// Returns -1 if any function body fails to emit (propagated by the caller), else 0.
function emitCodeSection(n: i32, hasStart: i32, memFn: i32, nHelpers: i32) {
  // Code section (id 10): one size-prefixed body per function, in index order, then
  // (if any) the synthetic start function's body, the `__log__` decoder's, and the
  // shared-runtime-helper bodies LAST (in helper-index order).
  const codePayload: i32[] = []
  const codePrev = wTarget(codePayload)
  const wrapC = exportWrapSlots()
  wULEB(n + hasStart + memFn + nHelpers + wrapC.length)
  wTarget(codePrev)
  let ci = 0
  while ci < n {
    if emitFuncCode(codePayload, fnStmts[ci], ci) < 0 { return -1 }
    ci = ci + 1
  }
  if hasStart == 1 {
    if emitStartFnCode(codePayload) < 0 { return -1 }
  }
  if memLogUsed {
    if emitMemLogFnCode(codePayload) < 0 { return -1 }
  }
  if gHelpStrHash >= 0 {
    if emitStrHashFnCode(codePayload) < 0 { return -1 }
    if emitStrEqFnCode(codePayload) < 0 { return -1 }
    if emitStrConcatFnCode(codePayload) < 0 { return -1 }
  }
  if gHelpMapProbe >= 0 {
    if emitMapProbeFnCode(codePayload) < 0 { return -1 }
    if emitMapResizeFnCode(codePayload) < 0 { return -1 }
  }
  if gHelpMapProbeI32 >= 0 {
    if emitMapProbeI32FnCode(codePayload) < 0 { return -1 }
  }
  // The export-wrapper bodies LAST, in the same order the function section declared them.
  let wci = 0
  while wci < wrapC.length {
    emitExportWrapperCode(codePayload, wrapC[wci])
    wci = wci + 1
  }
  wSection(10, codePayload)
  0
}
