    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(126) // 0x7e i64
    wU8(0)   // 0 results
  }
  if gNeedsF64Print {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(124) // 0x7c f64
    wU8(0)   // 0 results
  }
  if gNeedsF32Print {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(125) // 0x7d f32
    wU8(0)   // 0 results
