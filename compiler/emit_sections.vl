    // triple every other list wrapper uses; only the backing it points at is packed.
    wU8(95)           // 0x5f struct
    wU8(3)            // 3 fields
    wU8(100)          // field 0 backing: 0x64 (ref ht) — non-null
    wSLEB(ba8TypeIdx) // ...to the packed byte array heap type
    wU8(1)            // mutable
    wU8(127)          // field 1 len: 0x7f i32
    wU8(1)            // mutable
    wU8(127)          // field 2 cap: 0x7f i32
    wU8(1)            // mutable
