// Host opt-in for the name section (see `gEmitNames`). The driver does NOT call
// this, so every golden/fixpoint emit leaves names OFF; only the native tool
// turns it on. Idempotent — any nonzero `on` enables, `0` disables.
export function setEmitNames(on: i32) {
  if on != 0 { gEmitNames = 1 } else { gEmitNames = 0 }
  0
}

// Host opt-out for the `vl-src` section (see `gEmitSrcMap`); the name section is unaffected.
// Any nonzero `on` keeps it, `0` drops it.
export function setEmitSrcMap(on: i32) {
  if on != 0 { gEmitSrcMap = 1 } else { gEmitSrcMap = 0 }
  0
}

// Host opt-in for importing the linear memory (see `gImportMemory`). Like `setEmitNames`
// the driver never calls it, so the default emit is unchanged. Any nonzero `on` enables.
export function setImportMemory(on: i32) {
  if on != 0 { gImportMemory = 1 } else { gImportMemory = 0 }
  0
}

// Host opt-in for a shared linear memory with a max of `pages` (see `gSharedMemPages`); the
// driver never calls it. Refuses (-1, unchanged) outside [1, 65536], the i32 memory's page range.
export function setSharedMemory(pages: i32) {
  if pages < 1 || pages > 65536 { return -1 }
  gSharedMemPages = pages
  0
}

// Host opt-in for the memory's initial size and unshared max, in pages (see `gInitialMemPages`);
// `max` 0 declares none. Refuses (-1, unchanged) an initial outside [1, 65536], a max below it or
// past 65536, or an initial past a `--shared-memory` max already set.
export function setMemoryPages(initial: i32, max: i32) {
  if initial < 1 || initial > 65536 { return -1 }
  if max != 0 && (max < initial || max > 65536) { return -1 }
  if gSharedMemPages > 0 && (initial > gSharedMemPages || max != 0) {
    return -1
  }
  gInitialMemPages = initial
  gMaxMemPages = max
  0
}

// Host opt-in for a build `-O` / `-O3` will optimise next (see `gOptimized`); the driver never
// calls it. Any nonzero `on` enables, `0` disables.
export function setOptimized(on: i32) {
  if on != 0 { gOptimized = 1 } else { gOptimized = 0 }
  0
}

// Host opt-in for the low-memory promise (see `gLowMemUnused`); the driver never calls it.
// Refuses (-1, unchanged) a negative size; 0 withdraws the promise.
export function setLowMemoryUnused(bytes: i32) {
  if bytes < 0 { return -1 }
  gLowMemUnused = bytes
  0
}

// Host opt-in for a `std:buffer` heap window (see `gHeapBase`); the driver never calls it.
// Refuses (-1, window unchanged) unless both ends are positive multiples of 8 and the limit is
// at least the base: a base of 0 would make `base == 0` a real `Buf`.
export function setHeapWindow(base: i32, limit: i32) {
  if base <= 0 || (base & 7) != 0 { return -1 }
  if limit < base || (limit & 7) != 0 { return -1 }
  gHeapBase = base
  gHeapLimit = limit
  0
}

// Whether the last module emitted reads the heap window, for the host's warning about a
// unit that shares a memory with no window of its own. 1 or 0.
export function heapWindowRead(): i32 {
  if gHeapUsed { return 1 }
  0
}

// Whether this module takes its memory as the `env.memory` import rather than defining it.
// A module that touches no linear memory has none to import, so the opt-in changes nothing.
function memImported(): boolean { memUsed && gImportMemory != 0 }

function emitReset() {
  // NOTE: `gImports` and `startStmts` are NOT reset here — they are assigned by
  // their own passes (the print-detection scan in `emitProgram`, `collectFns`)
  // which run BEFORE `emitModule` calls this; resetting them here would clobber
  // those passes' results.
  ropeReset(W)
  wStray = []
  curBuf = wStray
  0
}

// ── module header ────────────────────────────────────────────────────────────
function emitHeader() {
  // "\0asm" magic + version 1, the module's first chunk.
  const head: u8[] = []
  const prev = wTarget(head)
  wU8(0)
  wU8(97)  // 'a'
  wU8(115) // 's'
  wU8(109) // 'm'
  wU8(1)
  wU8(0)
  wU8(0)
  wU8(0)
  wTarget(prev)
  ropePush(W, head)
  0
}

// Rebuild the local columns for the function at `fnIx`: clear them, then collect every
// declared local in the body (validating each as i32). Returns 0 on success,
// or -1 (via `emitFail`) on any unsupported local. Must run before lowering the
// body so identifier resolution and the locals vector see the full set.
function buildLocals(fnIx: i32) {
  localIsRef = []
  localStructIdx = []
  localLoopVar = []
  localLoopIter = []
  localPairIter = []
  localDeclIx = []
  localSlotOfDecl = Map()
  localUnset = []
  localByNode = []
  declSlotByNode = Map()
  // Reset the lexical scope stack per function. `collectLocals` pushes/pops frames as
  // it walks (leaving it balanced/empty), then the emit pass rebuilds it in lockstep.
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  const fn = nodeAt(fnIx)
  if fn is FuncDecl { return collectLocals(fn.fnBody, fnIx) }
  emitFail("emitProgram: not a function declaration")
}

// Refuses, as an internal error, a parameter of the function at `fnIx` that has no valtype:
// an annotation naming a type parameter no instance bound, or one with no checker type that
// lowers to no valtype. Every parameter type the checker accepts lowers, so only a
// monomorphizer defect reaches either (D5001). Returns 0, or -1 via `emitFail`.
function paramValtypeFloor(fnIx: i32) {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    for pix in fn.fnParams {
      const p = nodeAt(pix)
      if p is Param {
        if p.parType >= 0 {
          const ty = nodeAt(p.parType)
          if ty is TypeRef && nodeTyHasRepTyVar(p.parType) {
            return emitFail(
              "emitProgram: internal: parameter `"
                + ty.tyName
                + "` names a type parameter no call binds — the checker's uninferable-type-parameter rule should have refused the call",
            )
          }
          if paramTyUnlowered(pix, p.parType, fnIx) {
            return emitFail(
              "emitProgram: internal: a parameter type the valtype ladder has no rung for — every parameter type the checker accepts has one",
            )
          }
        }
      }
    }
  }
  0
}

// Whether the annotation `tyIx` of parameter `pix` carries no checker type and falls to
// `vtKindOfType`'s `i32` default without spelling an `i32`-backed type.
function paramTyUnlowered(pix: i32, tyIx: i32, fnIx: i32): boolean {
  if nodeTyAt(tyIx, fnIx) >= 0 { return false }
  if vtKindOfParam(pix) != "i32" { return false }
  if tyIsNulBool(tyIx) || nodeTyIsNulLitUnion(tyIx) { return false }
  const t = nodeAt(tyIx)
  if t is TypeRef { return t.tyName != "i32" && t.tyName != "boolean" }
  true
}

// ── locals-vector emission (derived, never separately counted) ──
// The locals vector is a sequence of (count, valtype) runs. This emitter uses a count of 1
// per local — one run per declared local and per scratch slot — so the run total equals the
// local count. The run helpers stream straight to `curBuf` (bind it with `wTarget` first); each emits the `1` count then a valtype.

// Clears the per-function scratch flags and slot lists `emitFuncCode` sets before laying out a
// body.
function resetFnScratchFlags() {
  fnUsesPush = false
  fnUsesRefPush = false
  fnUsesStrPush = false
  fnUsesNulStrPush = false
  fnUsesF64Push = false
  fnUsesI64Push = false
  fnUsesF32Push = false
  fnUsesU8Push = false
  fnUsesU8Push = false
  fnUsesAtomStage = false
  fnUsesStrOp = false
  fnUsesArrNew = false
  fnUsesCoalesceCall = false
  fnUsesMap = false
  fnUsesVariantRebox = false
  fnUsesOptRecv = false
  fnUsesListGet = false
  // Collect the DISTINCT ref-list element-type slots this function pushes onto (each
  // gets its own typed 4-slot scratch frame). Empty unless `fnUsesRefPush`.
  fnRefPushSlots = []
  refPushBaseBySlot = []
  // Collect the `.map`/`.filter` HOF sites this body lowers (each reserves the
  // shared 4-slot frame + one typed src/dst slot per distinct receiver/result type).
  fnUsesMapFilter = false
  fnUsesMapKeys = false
  fnUsesMapVals = false
  fnUsesMapVals = false
  mfSrcKinds = []
  mfSrcSlots = []
  mfSrcBases = []
  mfDstKinds = []
  mfDstSlots = []
  mfDstBases = []
  // List `==`/`!=`/`+` frames (collections-design §VL.4/§VL.6). May also flip
  // `fnUsesStrOp` (a string-list compare rides the string-op frame), so its scan leads
  // the sweep and the `fnHasStrOp` leg behind it is skipped once the flag is true.
  fnUsesListEqI = false
  fnUsesListEqS = false
  fnListEqRSlots = []
  fnListCatKinds = []
  fnListCatSlots = []
  fnListEqGKinds = []
  fnListEqGSlots = []
  fnUsesCloEq = false
  // Recomputed unconditionally by `fnDetectScratch` below (never OR'd), so this reset is
  // defensive rather than load-bearing.
  fnMemAddrFoldCount = 0
}

// Resets the emit-time scope stack, the let-slot cursor and the loop control frames, so a
// previous function's open frames never leak into the next body.
function emitResetScopeFrames() {
  // Reset the emit-time scope stack + slot cursor; `emitFuncBody` re-walks the body
  // in collect's pre-order, so the n-th `LetDecl` it emits re-derives declared-local
  // slot `n` and binds it for in-scope resolution.
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  emitLetCursor = 0
  // Reset the loop control-frame tracking (`break`/`continue` branch-depth state)
  // so a previous function's open frames never leak into this one.
  ctrlDepth = 0
  loopContDepth = []
  loopBrkDepth = []
  loopContLabel = []
  loopBrkLabel = []
  if lvFrameDepth.length > 0 { lvFrameDepth = [] }
  if lvFrameLocal.length > 0 { lvFrameLocal = [] }
}

// Seeds `fbRetExtra` with the local of every capture a lifted function at `fnPos` assigns, so
// each of its exits hands them back (D3664).
function fbSeedRetExtra(fnPos: i32) {
  fbRetExtra = []
  let rxi = 0
  while rxi < cloLiftWriteCount(fnPos) {
    fbRetExtra.push(1 + cloLiftWriteCapAt(fnPos, rxi))
    rxi = rxi + 1
  }
}

// Pads a body that does not end in an explicit `return`/tail value, with the writer bound at
// `body`: `null` for a nullable return (sunk when the return sink fired), `unreachable` for a
// non-nullable one, nothing for a void function. Returns 0, or -1 when `emitNullForRet` refuses.
function emitFallThroughPad(
  body: u8[],
  fnBody: i32,
  fnIx: i32,
  fnPos: i32,
): i32 {
  // If the body does not end in an explicit `return`/tail value, control falls through to the
  // function `end` with an empty stack, and the validator requires the function's result type
  // there. A nullable return is a live fall-through path (the checker permits it precisely
  // because `null` is in the return type), so it emits `null`; a non-nullable return means the checker has proven the fall-through dead, so `unreachable` is sound padding, never run.
  let isVoidFn = false
  if fnPos >= 0 {
    if fRetVoid[fnPos] == 1 { isVoidFn = true }
  }
  if !isVoidFn && !bodyEndsInReturn(fnBody, fnIx) {
    if fnRetNullBearing(fnIx) {
      if emitNullForRet(body, fnIx) < 0 { return -1 }
      // Inside the sink's exit block this fall-through value cannot simply be left on
      // the stack for the function `end` — the block is void. It terminates like any
      // other exit: sunk when it built a box, a plain `return` otherwise.
      if uSinkFired > 0 { emitUnionRetSink(fnIx) }
    } else {
      fbUnreachable() // 0x00 unreachable (dead padding for the result type)
    }
  }
  0
}

// Moves the statement span rows banked from `base` on, which are relative to the body
// expression, onto the code payload: `bodyInOut` past the size prefix, then `exprInBody` in.
function rebaseStmtSpans(base: i32, bodyInOut: i32, exprInBody: i32) {
  let ssp = base
  while ssp < emitFnSpanStart.length {
    emitFnSpanStart[ssp] = emitFnSpanStart[ssp] + bodyInOut + exprInBody
    emitFnSpanEnd[ssp] = emitFnSpanEnd[ssp] + bodyInOut + exprInBody
    ssp = ssp + 1
  }
}

// The functions each function declares directly, by enclosing function; built at the first body.
let envCacheKids: {[i32]: i32[]} = Map()
let envCacheKidsBuilt = false

// Fills `envCacheFes`/`envCacheTys` for the body of function `fnPos`: the functions it declares
// by statement that capture and are not lambda-lifted. A lambda is excluded, since each
// evaluation of its expression is a new function value.
function envCacheOpen(fnPos: i32) {
  envCacheFes = []
  envCacheTys = []
  if !fnNestUsed || fnPos < 0 { return 0 }
  if !envCacheKidsBuilt {
    envCacheKidsBuilt = true
    let fe = 0
    while fe < fnParent.length && fe < fnStmts.length {
      const p = fnParent[fe]
      if p >= 0 {
        const have = envCacheKids[p] ?? []
        have.push(fe)
        envCacheKids[p] = have
      }
      fe = fe + 1
    }
  }
  for kid in envCacheKids[fnPos] ?? [] {
    const ty = fnEnvIdxOf(kid)
    if ty >= 0 && !cloLifted(kid) && !criFnIsAnonLambda(kid) {
      envCacheFes.push(kid)
      // A function another frame reads keeps its cell here instead of its env (D7700).
      if kid < cloCellTarget.length && cloCellTarget[kid] == 1 {
        envCacheTys.push(cloCellIdx)
      } else {
        envCacheTys.push(ty)
      }
    }
  }
  0
}

// Builds the size-prefixed code-section body for the `FuncDecl` at `fnIx`: the locals vector
// (declared locals, all i32), the body's statement instructions, then `end`. Framed bytes are
// appended onto `out`. Returns 0, or -1 (via `emitFail`) on any unsupported shape. Every
// declared local is i32, so the vector is one run `(L, 0x7f)`; params are not counted here — they are encoded in the functype, not the locals vector.
function emitFuncCode(out: u8[], fnIx: i32, fnPos: i32, ec: ExpCtx) {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    // Anchors any emit failure raised while lowering this body at its declaration (`emitFail`
    // snapshots `emitCurFnIx`). Sequential emission means the cursor's value at failure time is
    // the offending function; `fnPos` is the caller's own `fnStmts` loop index, which `fnStmtsPosOf` reads instead of scanning.
    emitCurFnIx = fnIx
    emitCurFnPos = fnPos
    envCacheOpen(fnPos)
    // Collect + validate declared locals BEFORE lowering, so identifier resolution
    // and the locals vector both see the full per-function set.
    if paramValtypeFloor(fnIx) < 0 { return -1 }
    if buildLocals(fnIx) < 0 { return -1 }

    // If this function pushes, reserve three scratch locals after the declared ones.
    // `pushScratchBase` is their first wasm index; the inline-push sequence reads
    // `pushScratchBase`+0/+1/+2. Set before `emitStmts` so a `.push` can resolve its scratch
    // slots. One body walk (`blockPushPopBits`) classifies every `.push`/Member-`.pop` receiver once and yields all six kind flags together.
    resetFnScratchFlags()
    fnDetectScratch(fnIx)
    const nLocals = localIsRef.length
    // Union-box sink: reserve the shared tag/payload pair when this function's result is the box
    // and it has two or more exits (the return sink), or it binds a union box from an if-expression
    // (the binding sink). The frame must be laid out before the body (a `local.set` needs the
    // index), so both are predictions; `uSinkFired` records what the return path actually did.
    fnUsesUnionSink = fnUnionRetSinkOk(fnIx)
    fnUsesUnionLetSink = fnUnionLetSinkOk(fnIx)
    uSinkFired = 0
    uBoxNewEnd = -1
    tailCallEnd = -1
    tailCallIdx = -1
    tailCallVoid = false
    liftWbEnd = -1
    fbSeedRetExtra(fnPos)
    // Lays out every scratch frame after the params + declared locals via the FuncBuilder cursor,
    // which sets `pushScratchBase`/`refPushScratchBase`/`refPushBaseBySlot`/`strPushScratchBase`/
    // `strScratchBase`/`mapScratchBase` from one running offset in frame order. Scratch frames
    // land after the params and the hidden env param (local 0) when a function value exists module-wide, so the cursor starts past `envSlotShift`.
    fbBeginFunc(fn.fnParams.length + envSlotShift(fnIx), nLocals)

    const bodyExpr: u8[] = []
    // Binds the writer at `bodyExpr` so the `fb*` opcode methods (which append to `curBuf`) write
    // the function-body instructions; the recursive lowering threads the same `bodyExpr` as its
    // `body` arg, so `curBuf == body` throughout and not-yet-converted raw `body.push(...)` sites
    // interleave identically. Restores the previous target afterwards.
    const exprPrev = wTarget(bodyExpr)
    emitResetScopeFrames()
    // `emitFuncBody` banks a row per STATEMENT, relative to `bodyExpr`; the rebase below
    // moves them onto the code payload with the rest of this entry (ROADMAP row 22).
    const stmtSpanBase = emitFnSpanStart.length
    if emitFuncBody(bodyExpr, fn.fnBody, fnIx, ec) < 0 { return -1 }
    // A void body whose last instruction is a call falls off its end with nothing to hand
    // back, so that call is a tail call (D4655).
    emitVoidTailCall(fnIx)
    wTarget(exprPrev)

    const body: u8[] = []
    // Locals vector: one (count=1, valtype) run per DECLARED local, then the scratch
    // frames in `fbBeginFunc`'s layout order. Derived from the local set + scratch
    // flags by the FuncBuilder (Phase H) — the run count and every valtype come from
    // ONE place, so they cannot desync from the frame layout above.
    if fbEmitLocalsVec(body, nLocals) < 0 { return -1 }
    // The return sink's single exit block, opened around the whole body so every sunk `return`'s
    // `br <ctrlDepth>` lands on it. Emitted only when a `return` actually sank — otherwise the
    // body holds no branch to it and the block would be dead weight.
    if uSinkFired > 0 {
      const blkPrev = wTarget(body)
      fbBlock(64) // 0x02 block, 0x40 void blocktype
      // Not counted: `br <ctrlDepth>` names this block from inside the body, so the fall-through
      // sink emitted below must see the depth the body closed at.
      ctrlDepth = ctrlDepth - 1
      wTarget(blkPrev)
    }
    // Where `bodyExpr` lands INSIDE the body: the locals vector, plus the sink's block
    // opener when there is one. The start function computes the same offset.
    const exprInBody = body.length
    relCopy(bodyExpr, body, exprInBody)
    appendAll(body, bodyExpr)
    // Bind the writer at `body` (the framed code entry) for the trailing padding/end
    // opcodes emitted via the `fb*` methods.
    const endPrev = wTarget(body)
    if emitFallThroughPad(body, fn.fnBody, fnIx, fnPos) < 0 { return -1 }
    // Close the sink's exit block and perform the function's ONE box construction, whose
    // operands every sunk `return` has already written. Falling off the function `end`
    // with it on the stack is the result.
    if uSinkFired > 0 {
      fbEnd() // 0x0b end — the exit block
      fbLocalGet(unionSinkBase)
      fbLocalGet(unionSinkBase + 1)
      fbStructNew(uBoxIdx)
    }
    fbPushRetExtra()
    fbRetExtra = []
    fbEnd() // 0x0b end
    fbEndFunc()
    wTarget(endPrev)
    // Stream the size-prefixed code entry onto `out` (this entry's own buffer, which
    // `placeCodeEntry` joins to the code payload). Bind the writer at `out` explicitly:
    // `curBuf` is NOT `out` on entry here.
    const outPrev = wTarget(out)
    wULEB(body.length)
    // The size prefix is written, so `out.length` is where the body itself begins; `exprInBody`
    // is where `bodyExpr` begins inside it. Same two-step rebase `emitStartFnCode` performs.
    const bodyInOut = out.length
    rebaseStmtSpans(stmtSpanBase, bodyInOut, exprInBody)
    wBytes(body)
    wTarget(outPrev)
    return 0
  }
  emitFail("emitProgram: not a function declaration")
}

// Record the ref-list slot of a bare top-level `recv.push(x)` statement (the
// block-level collector handles pushes nested in loop/if bodies).
function recordStartRefPushSlot(stmtIx: i32) {
  const s = nodeAt(stmtIx)
  if s is Call {
    if s.callFn < 0 { return 0 }
    const callee = nodeAt(s.callFn)
    if callee is Member {
      if callee.memProp == "push" {
        recordRefPushSlot(refListSlotOfExpr(callee.memObj, -1))
      }
    }
  }
  0
}

// Runs every scratch-detection walker over one start-fn block (a loop body, an if
// arm), feeding the `fnUses*` flags and the ref-push slot recorders. The single
// push/pop walk feeds the push flags: a `.push` and a Member-receiver `.pop`
// (which reuses the push frame's slots) each need the scratch quad.
function startScanBlock(blockIx: i32) {
  applyPushPopBits(blockPushPopBits(blockIx, -1))
  if blockHasStrOp(blockIx, -1) { fnUsesStrOp = true }
  // A statement's arm tail is read at its prelude locals, as `emitStmt` reads it (D5333).
  const blk = nodeAt(blockIx)
  if blk is Block {
    let bi = 0
    while bi < blk.blkStmts.length {
      const root = stmtArmRoot(blk.blkStmts[bi])
      if root >= 0 && armScopeOpenOver(root, blk.blkStmts[bi]) {
        if exprHasStrOp(root, -1) { fnUsesStrOp = true }
        scopePop()
      }
      bi = bi + 1
    }
  }
  if blockHasScratch(blockIx, "arrNew") { fnUsesArrNew = true }
  if blockHasScratch(blockIx, "coalesceCall") { fnUsesCoalesceCall = true }
  if blockHasMapOp(blockIx, -1) { fnUsesMap = true }
  collectRefSlots(blockIx, -1)
  0
}

// Runs every expression-level scratch-detection walker over one start-fn header expression —
// a `while` condition, a `for`-range bound, a `for`-in iterable, an `if` condition.
// `startScanBlock`'s counterpart for the parts of a compound statement that are not a block:
// those expressions lower into the start function's body exactly as a bare top-level statement does, so they need the same frames (a `for`-range `step` is excluded — a non-constant step is already a clean emit reject).
function startScanHeaderExpr(exprIx: i32) {
  if exprIx < 0 { return 0 }
  const armScoped = armScopeOpenOver(exprIx, exprIx)
  if exprHasStrOp(exprIx, -1) { fnUsesStrOp = true }
  if armScoped { scopePop() }
  if exprHasScratch(exprIx, "arrNew") { fnUsesArrNew = true }
  if exprHasScratch(exprIx, "coalesceCall") { fnUsesCoalesceCall = true }
  if exprHasMapOp(exprIx, -1) { fnUsesMap = true }
  applyPushPopBits(exprPopBits(exprIx, -1))
  collectMemberPopRefSlotsExpr(exprIx, -1)
  0
}

// Scans a top-level `if` chain: the condition expression plus every arm's block, walking an
// `else if` chain along its spine so its depth costs no stack (D1990).
function startScanIf(ifIx: i32) {
  let cur = ifIx
  while cur >= 0 {
    const st = nodeAt(cur)
    cur = -1
    if st is IfStmt {
      startScanHeaderExpr(st.ifCond)
      // Each arm is scanned as a block; a narrowed read is typed by the checker.
      startScanBlock(st.ifThen)
      if st.ifElse >= 0 {
        const els = nodeAt(st.ifElse)
        if els is IfStmt { cur = st.ifElse } else { startScanBlock(st.ifElse) }
      }
    }
  }
  0
}

// ── PROMOTION of a top-level binding to a start-function LOCAL (G2c) ─────────
// `emit_state.vl`'s `gPromoOk` header carries the model and the measurement that
// motivates it. This block is the ANALYSIS: the reachability walk, the safety
// predicate, and the one query the four start-fn / global-section gates share.

// Marks every arena node reachable from the top-level statements and initializers with `val`
// (the init window's number plus one; -1 once two windows reach it), without descending into a
// nested `FuncDecl`: a lifted top-level lambda still addresses the binding as a module cell.
// A node shape this ladder does not know leaves its descendants unmarked, refusing the promotion — a hole here costs population, never soundness.
function promoMark(marks: i32[], ix: i32, val: i32) {
  if ix < 0 { return 0 }
  if ix >= marks.length { return 0 }
  if marks[ix] == val || marks[ix] == -1 { return 0 }
  let v = val
  if marks[ix] != 0 { v = -1 }
  marks[ix] = v
  const n = nodeAt(ix)
  match n {
    FuncDecl => {
      return 0
    }
    Block => {
      const bs = n.blkStmts
      let bi = 0
      while bi < bs.length {
        promoMark(marks, bs[bi], v)
        bi = bi + 1
      }
      return 0
    }
    LetDecl => {
      return promoMark(marks, n.letInit, v)
    }
    BinExpr => {
      promoMark(marks, n.binLeft, v)
      return promoMark(marks, n.binRight, v)
    }
    Call => {
      promoMark(marks, n.callFn, v)
      const args = n.callArgs
      let ai = 0
      while ai < args.length {
        promoMark(marks, args[ai], v)
        ai = ai + 1
      }
      return 0
    }
    IfStmt => {
      promoMark(marks, n.ifCond, v)
      promoMark(marks, n.ifThen, v)
      return promoMark(marks, n.ifElse, v)
    }
    WhileStmt => {
      promoMark(marks, n.whileCond, v)
      return promoMark(marks, n.whileBody, v)
    }
    ForRange => {
      promoMark(marks, n.frFrom, v)
      promoMark(marks, n.frTo, v)
      promoMark(marks, n.frStep, v)
      return promoMark(marks, n.frBody, v)
    }
    ForIn => {
      promoMark(marks, n.fiIter, v)
      return promoMark(marks, n.fiBody, v)
    }
    RetStmt => {
      return promoMark(marks, n.retArg, v)
    }
    Unary => {
      return promoMark(marks, n.unArg, v)
    }
    Paren => {
      return promoMark(marks, n.parInner, v)
    }
    Member => {
      return promoMark(marks, n.memObj, v)
    }
    OptMember => {
      return promoMark(marks, n.omObj, v)
    }
    IsExpr => {
      return promoMark(marks, n.isObj, v)
    }
    AsExpr => {
      return promoMark(marks, n.asObj, v)
    }
    Index => {
      promoMark(marks, n.idxArr, v)
      return promoMark(marks, n.idxIndex, v)
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      return promoMark(marks, n.spdArg, v)
    }
    ArrayLit => {
      const es = n.arrElems
      let ei = 0
      while ei < es.length {
        promoMark(marks, es[ei], v)
        ei = ei + 1
      }
      return 0
    }
    ObjLit => {
      const fs = n.objFields
      let fi = 0
      while fi < fs.length {
        promoMark(marks, fs[fi], v)
        fi = fi + 1
      }
      return 0
    }
    FieldInit => {
      return promoMark(marks, n.fiValue, v)
    }
    MatchExpr => {
      promoMark(marks, n.matchScrut, v)
      const pats = n.matchPats
      let pi = 0
      while pi < pats.length {
        promoMark(marks, pats[pi], v)
        pi = pi + 1
      }
      const binds = n.matchBinds
      let bj = 0
      while bj < binds.length {
        promoMark(marks, binds[bj], v)
        bj = bj + 1
      }
      const bodies = n.matchBodies
      let mj = 0
      while mj < bodies.length {
        promoMark(marks, bodies[mj], v)
        mj = mj + 1
      }
      return 0
    }
    // a leaf, or a shape whose descendants stay unmarked
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | Param | TypeRef | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | UnionDecl | ImportDecl | LoopVar => {}
  }
  0
}

// The cheap half of the safety predicate, reading only this binding's own declaration (the
// reachability clause is `computeGlobalPromotion`'s). P2: the cell kind is a plain numeric
// scalar, whose `fbValtypeNullable`/`fbValtype` are one byte, so a start-fn local is a drop-in
// that starts at zero as the cell would, whether or not the binding has an initializer.
function globalPromotable(gi: i32) {
  const d = nodeAt(globalStmts[gi])
  if d is LetDecl {
    // A binding the export section publishes, or an import links, is a wasm global by contract.
    if (
      globalIsExportTarget(gi)
      || externGlobalLinkOfNode(globalStmts[gi]) >= 0
    ) {
      return false
    }
    const ck = globalCellKind(globalStmts[gi])
    match ck {
      "i32" | "nulbool" | "i64" | "f64" | "f32" => {
        return true
      }
      // every other cell kind is a ref or a box
      "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "closure" | "nullist" | "nulstr" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
    }
    return false
  }
  false
}

// The init windows: each maximal run of top-level globals and statements, in the order the
// start runs them, written in one module. Window `w` covers globals `iwG0[w]` to `iwG1[w]` and
// statements `iwS0[w]` to `iwS1[w]`, end exclusive; `gWinOf`/`sWinOf` give each node's window.
let iwG0: i32[] = []
let iwG1: i32[] = []
let iwS0: i32[] = []
let iwS1: i32[] = []
let iwMod: i32[] = []
let gWinOf: i32[] = []
let sWinOf: i32[] = []
// The globals and statements the start-function walks cover: everything, or one init's window.
let swG0 = 0
let swG1 = 0
let swS0 = 0
let swS1 = 0
// The windows each init function runs, `ifW0[k]` to `ifW1[k]` end exclusive.
let ifW0: i32[] = []
let ifW1: i32[] = []

// The module node `ix` is written in, or -1 when no token places it.
function topNodeMod(ix: i32): i32 {
  let tk = declNameTokOf(ix)
  if tk < 0 && ix >= 0 && ix < nodeToks.length { tk = nodeToks[ix] }
  if tk < 0 { return -1 }
  srcmapModOfTok(tk)
}

// Splits the top level into init windows. A node no token places joins the module after it,
// or the one before it at the end.
function computeInitWindows() {
  iwG0 = []
  iwG1 = []
  iwS0 = []
  iwS1 = []
  iwMod = []
  gWinOf = []
  sWinOf = []
  const isG: boolean[] = []
  const mods: i32[] = []
  let gi = 0
  let si = 0
  while gi < globalStmts.length || si < startStmts.length {
    let takeGlobal = gi < globalStmts.length
    if takeGlobal && si < startStmts.length {
      if startStmtOrd[si] < globalStmtOrd[gi] { takeGlobal = false }
    }
    isG.push(takeGlobal)
    if takeGlobal {
      mods.push(topNodeMod(globalStmts[gi]))
      gi = gi + 1
    } else {
      mods.push(topNodeMod(startStmts[si]))
      si = si + 1
    }
  }
  let next = -1
  let j = mods.length - 1
  while j >= 0 {
    if mods[j] < 0 { mods[j] = next } else { next = mods[j] }
    j = j - 1
  }
  let last = 0
  gi = 0
  si = 0
  let k = 0
  while k < mods.length {
    if mods[k] < 0 { mods[k] = last } else { last = mods[k] }
    if k == 0 || mods[k] != mods[k - 1] {
      iwG0.push(gi)
      iwG1.push(gi)
      iwS0.push(si)
      iwS1.push(si)
      iwMod.push(mods[k])
    }
    const w = iwMod.length - 1
    if isG[k] {
      gWinOf.push(w)
      gi = gi + 1
      iwG1[w] = gi
    } else {
      sWinOf.push(w)
      si = si + 1
      iwS1[w] = si
    }
    k = k + 1
  }
  0
}

// Whether window `w` lowers any code: a statement, a global whose initialiser runs, or a
// guarded global's progress write.
function initWindowLive(w: i32): boolean {
  if iwS1[w] > iwS0[w] { return true }
  let gi = iwG0[w]
  while gi < iwG1[w] {
    if globalRunsInStartFn(gi) { return true }
    if gi < gInitGuard.length && gInitGuard[gi] >= 1 && gInitAny { return true }
    gi = gi + 1
  }
  false
}

// Groups the live windows into one init function per module, in load order, into
// `gInitMods` and `ifW0`/`ifW1`. A single-file program, a module whose code is split by
// another's, or modules out of load order leave `gInitMods` empty: the start runs it all.
function computeInitFns(hasStart: i32) {
  gInitMods = []
  ifW0 = []
  ifW1 = []
  swG1 = 0
  swS1 = 0
  const order = srcmapLoadOrder()
  if hasStart == 0 || order.length < 2 { return 0 }
  const rank: { [i32]: i32 } = Map()
  let r = 0
  while r < order.length {
    rank[order[r]] = r
    r = r + 1
  }
  let prevRank = -1
  let w = 0
  while w < iwMod.length {
    if initWindowLive(w) {
      const k = gInitMods.length - 1
      if k >= 0 && gInitMods[k] == iwMod[w] {
        ifW1[k] = w + 1
      } else {
        const rk = rank[iwMod[w]] ?? 0
        if rk <= prevRank {
          gInitMods = []
          ifW0 = []
          ifW1 = []
          return 0
        }
        prevRank = rk
        gInitMods.push(iwMod[w])
        ifW0.push(w)
        ifW1.push(w + 1)
      }
    }
    w = w + 1
  }
  0
}

// Sets the start-function walks to cover windows `w0` to `w1`, end exclusive, or the whole
// top level when `w0` is negative.
function startWalkWindows(w0: i32, w1: i32) {
  swG0 = 0
  swG1 = globalStmts.length
  swS0 = 0
  swS1 = startStmts.length
  if w0 >= 0 && w1 > w0 {
    swG0 = iwG0[w0]
    swG1 = iwG1[w1 - 1]
    swS0 = iwS0[w0]
    swS1 = iwS1[w1 - 1]
  }
  0
}

// Decides, for every top-level binding, whether it lives in a cell or a start-function local,
// and re-densifies the cell indices around the ones that leave. Runs once, at the top of
// `emitModule`, after every arena-mutating pass. The safety predicate is P1 here plus P2
// in `globalPromotable` plus P4: P1 requires an existing top-level statement list (promotion never mints a start function); P4 requires every `Ident` spelling this name to sit inside the top-level region.
export function computeGlobalPromotion() {
  gPromoInStart = false
  // Rebuilt, not reset in place. `collectFns` seeds these three arrays so a `userGlobalIdx`
  // before this pass still answers the identity, but any pass that appends a global after
  // `collectFns` would leave them short — the same hazard `emit_state.vl` records against `globalIndexBySid`, whose "built once" invariant does not depend on a rebuild here.
  gPromoOk = []
  gPromoSlot = []
  gCellIdx = []
  gFoldOk = []
  gFoldAt = []
  gFoldLen = []
  gFoldPool = []
  let ri = 0
  while ri < globalStmts.length {
    gPromoOk.push(0)
    gPromoSlot.push(-1)
    gCellIdx.push(-1)
    gFoldOk.push(0)
    gFoldAt.push(-1)
    gFoldLen.push(0)
    ri = ri + 1
  }
  computeInitWindows()
  // P1: promotion never mints a start function, so it needs an existing one: a statement in
  // the binding's own init window.
  let anyCand = false
  if startStmts.length > 0 {
    let ci = 0
    while ci < globalStmts.length {
      const cw = gWinOf[ci]
      if iwS1[cw] > iwS0[cw] && globalPromotable(ci) {
        gPromoOk[ci] = 1
        anyCand = true
      }
      ci = ci + 1
    }
  }
  if anyCand {
    // P4, in two halves. The reachability walk marks the top-level region; the flat arena
    // scan then finds every `Ident` the walk did NOT reach and vetoes the binding it
    // names. The scan is over the WHOLE arena, which is what makes "everywhere else"
    // exhaustive without needing to enumerate what "everywhere else" is.
    const marks: i32[] = []
    let mi = 0
    while mi < P.nodes.length {
      marks.push(0)
      mi = mi + 1
    }
    // Each window marks with its own number, so a read from another window vetoes too: a
    // promoted binding is a local of its window's init function.
    let gi = 0
    while gi < globalStmts.length {
      promoMark(marks, globalStmts[gi], gWinOf[gi] + 1)
      gi = gi + 1
    }
    let si = 0
    while si < startStmts.length {
      promoMark(marks, startStmts[si], sWinOf[si] + 1)
      si = si + 1
    }
    let ai = 0
    while ai < P.nodes.length {
      const nd = nodeAt(ai)
      if nd is Ident {
        // A module-`const` parameter default vetoes promotion unconditionally, marked or not. The
        // reachability walk answers "is this node reached", and a default node is shared by every
        // call site that omits the argument — the same node sits in a top-level call (marked) and a
        // nested function's call (unreached), so marked-ness alone would promote a binding a function body reads. Vetoing is the conservative side this analysis fails towards.
        if isDefaultGlobalRef(ai) {
          const gd = globalIndexOf(nd.identName)
          if gd >= 0 { gPromoOk[gd] = 0 }
        } else if marks[ai] <= 0 || iwG0.length > 1 {
          const gj = globalIndexOf(nd.identName)
          if gj >= 0 && marks[ai] != gWinOf[gj] + 1 { gPromoOk[gj] = 0 }
        }
      }
      ai = ai + 1
    }
  }
  // The surviving cells re-densify: a promoted binding and an imported (`extern let`) one emit
  // none, so every cell below keeps its index and every cell above drops by one.
  // `userGlobalIdx` is the single translation and reads this array.
  let cell = 0
  let di = 0
  while di < globalStmts.length {
    if gPromoOk[di] == 1 || externGlobalLinkOfNode(globalStmts[di]) >= 0 {
      gCellIdx[di] = -1
    } else {
      gCellIdx[di] = cell
      cell = cell + 1
    }
    di = di + 1
  }
  0
}

// Is the binding at `globalStmts` position `gi` one the export section publishes as a wasm
// global — named by an alias row, defined here rather than imported, and scalar-typed?
function globalIsExportTarget(gi: i32): boolean {
  if gi < 0 || gi >= globalStmts.length { return false }
  const g = nodeAt(globalStmts[gi])
  if !(g is LetDecl) { return false }
  let i = 0
  while i < reExpTarget.length {
    if reExpTarget[i] == g.letName {
      return exportGlobalOfTarget(reExpTarget[i]) == gi
    }
    i = i + 1
  }
  false
}

// The `globalStmts` position an export target names, or -1: a defined (not imported) module
// binding whose checked type is a scalar. Any other binding stays a VL-level export only.
function exportGlobalOfTarget(name: string): i32 {
  const gi = globalIndexOf(name)
  if gi < 0 || gi >= globalStmts.length { return -1 }
  if externGlobalLinkOfNode(globalStmts[gi]) >= 0 { return -1 }
  if topLetScalarOf(name) == "" { return -1 }
  gi
}

// Does the binding at `globalStmts` position `gi` have an initializer the start function
// runs? True for a non-constexpr init (the start fn stores the zeroed cell's value) and for a
// promoted binding's (it becomes the slot's `local.set`); false with no initializer. `emitModule`'s `hasStart` count, `startFnDetectScratch`'s scan,
// `emitGlobalSection`'s cell arm, and `emitStartFnCode`'s merge loop must all agree on this.
export function globalRunsInStartFn(gi: i32) {
  if gi < 0 || gi >= globalStmts.length { return false }
  if igLetInit(globalStmts[gi]) < 0 { return false }
  if gi < gPromoOk.length && gPromoOk[gi] == 1 { return true }
  globalIsNonConst(globalStmts[gi])
}

// Sets the stash flags the tree at `ix` needs, asking only of those not yet set: a
// multi-field call re-boxed into a variant arm (`variantReboxSlot`, a call cannot be re-read
// per field), a `?.` base that is not re-readable (`optRecvSlot`), and a `.get` index or
// receiver that is not (the `.get` stash), each staged so it is evaluated once.
function scanStashes(ix: i32, fnIx: i32) {
  let want = 0
  if !fnUsesVariantRebox && (anyStructReboxes() || recCopyAny()) {
    want = want + stashRebox
  }
  if !fnUsesOptRecv { want = want + stashOptRecv }
  if !fnUsesListGet { want = want + stashListGet }
  const hit = want - blockStashMisses(ix, fnIx, want)
  if (hit & stashRebox) != 0 { fnUsesVariantRebox = true }
  if (hit & stashOptRecv) != 0 { fnUsesOptRecv = true }
  if (hit & stashListGet) != 0 { fnUsesListGet = true }
}

// The scratch detection of user function `fnIx`'s body, after the resets in `emitFuncCode`.
function fnDetectScratch(fnIx: i32) {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    // Declaration-time address fold: a pure recount over `localDeclIx` (already built by
    // `buildLocals` above).
    fnMemAddrFoldCount = maFoldCandidateCount(fnIx)
    // ONE body walk (`blockPushPopBits`) classifies every `.push`/Member-`.pop` receiver
    // once and yields all six kind flags together.
    applyPushPopBits(blockPushPopBits(fn.fnBody, fnIx))
    // The list-op scan leads because it also flips `fnUsesStrOp`, and every leg below it
    // asks a predicate whose only effect is a flag that is set and never cleared: a flag
    // already true has no second answer to give, so its walk is skipped. D1595.
    leqScanBlock(fn.fnBody, fnIx)
    if !fnUsesStrOp {
      if fnHasStrOp(fnIx) { fnUsesStrOp = true }
    }
    if !fnUsesArrNew {
      if fnHasScratch(fnIx, "arrNew") { fnUsesArrNew = true }
    }
    if !fnUsesCoalesceCall {
      if fnHasScratch(fnIx, "coalesceCall") { fnUsesCoalesceCall = true }
    }
    if !fnUsesMap {
      if fnHasMap(fnIx) { fnUsesMap = true }
    }
    // `fnHasMap` only scans locals/params; also reserve the frame when a map op runs
    // on a global struct-field map-array element (e.g. `S.maps[top][k] = v`).
    if !fnUsesMap { fnUsesMap = fnHasGlobalMapOp(fnIx) }
    scanStashes(fn.fnBody, fnIx)
    // A Member-receiver ref-list `.pop` (`T.frames.pop()`) needs the same typed scratch frame
    // as a ref `.push` onto that slot, so a pop-only function reserves it too.
    collectRefSlots(fn.fnBody, fnIx)
    mfScan(fn.fnBody, fnIx)
  }
  0
}

// Clears every start-function scratch flag, then detects the frames its body needs over the
// non-const global inits and the top-level statements — the start-fn analogue of
// `emitFuncCode`'s per-function detection, setting the same `fnUses*` flags for the shared frame
// layout.
function startFnDetectFrames() {
  // The declaration-time address fold is scoped to a real `FuncDecl` frame
  // (`emitLetDeclStmt` declines it whenever `fnIx < 0`), so the start function always
  // reserves zero — reset here rather than left holding the last regular function's count.
  fnMemAddrFoldCount = 0
  fnUsesPush = false
  fnUsesRefPush = false
  fnUsesStrPush = false
  fnUsesNulStrPush = false
  fnUsesF64Push = false
  fnUsesF32Push = false
  fnUsesI64Push = false
  // `fnUsesU8Push` and `fnUsesMapVals` are not reset here: the sweep sets them for this body like
  // any other, and a stale true only reserves an unused frame that `fbBeginFunc` and the locals
  // vector lay out from the same flag. Module-scope `values()` and `u8` push probes run.
  fnUsesAtomStage = false
  fnUsesStrOp = false
  fnUsesArrNew = false
  fnUsesCoalesceCall = false
  fnUsesMap = false
  fnUsesVariantRebox = false
  fnUsesOptRecv = false
  fnUsesListGet = false
  fnRefPushSlots = []
  refPushBaseBySlot = []
  fnUsesMapFilter = false
  fnUsesMapKeys = false
  mfSrcKinds = []
  mfSrcSlots = []
  mfSrcBases = []
  mfDstKinds = []
  mfDstSlots = []
  mfDstBases = []
  // List `==`/`!=`/`+` frames (collections-design §VL.4/§VL.6) — non-const
  // global inits and every top-level statement run in the start function.
  fnUsesListEqI = false
  fnUsesListEqS = false
  fnListEqRSlots = []
  fnListCatKinds = []
  fnListCatSlots = []
  fnListEqGKinds = []
  fnListEqGSlots = []
  fnUsesCloEq = false
  startFnDetectScratch()
  0
}

// Whether the start function may read a global init's arm tails at their prelude locals:
// only where no tail decides the global's cell, which `globalCellKind` classifies with no
// arm frame open — an annotated global, or an init no arm tail yields into (D5430).
function globalArmScopeOk(stmtIx: i32): boolean {
  const s = nodeAt(stmtIx)
  if s is LetDecl {
    return globalHasTypeAnn(stmtIx) || !initYieldsArmTail(s.letInit)
  }
  false
}

// Whether a value `if` can yield part of the value at `ix`, through a paren, a non-boolean
// operator's operand, or a list or record element.
function initYieldsArmTail(ix: i32): boolean {
  if ix < 0 { return false }
  const b = unwrapParen(ix)
  if b < 0 || b >= P.nodes.length { return false }
  const n = nodeAt(b)
  if n is BinExpr {
    const op = n.binOp
    if (
      op == "&&"
      || op == "||"
      || op == "=="
      || op == "!="
      || op == "<"
      || op == "<="
      || op == ">"
      || op == ">="
    ) {
      return false
    }
    return initYieldsArmTail(n.binLeft) || initYieldsArmTail(n.binRight)
  }
  if n is IfStmt { return true }
  kidsYieldArmTail(b)
}

// Whether a child of the list literal, record literal, field or spread `b` yields an arm
// tail; any other kind holds no element a value `if` can yield into.
function kidsYieldArmTail(b: i32): boolean {
  if b < 0 || b >= P.nodes.length { return false }
  const n = nodeAt(b)
  if !(n is ArrayLit || n is ObjLit || n is FieldInit || n is Spread) {
    return false
  }
  const kids = nodeChildren(b)
  let k = 0
  while k < kids.length {
    if initYieldsArmTail(kids[k]) { return true }
    k = k + 1
  }
  false
}

// The scratch detection of the start function, after the resets in `startFnDetectFrames`. A
// `.push` is a statement-level void call, never in an init value position, so an init's push
// frames are driven by Member-receiver `.pop`s instead.
function startFnDetectScratch() {
  let gi = swG0
  while gi < swG1 {
    // A PROMOTED binding's init runs here too (its `local.set` replaces the cell's
    // constexpr), so its scratch needs are detected on the same gate — else a const
    // init that needs a frame would reach the start fn with none reserved.
    if globalRunsInStartFn(gi) {
      const g = nodeAt(globalStmts[gi])
      if g is LetDecl {
        const ix = g.letInit
        applyPushPopBits(exprPopBits(ix, -1))
        if exprHasStrOp(ix, -1) { fnUsesStrOp = true }
        // The init's arm tail is read at its prelude locals, as the start emit reads it (D5333).
        if (
          globalArmScopeOk(globalStmts[gi])
          && armScopeOpenOver(ix, globalStmts[gi])
        ) {
          if exprHasStrOp(ix, -1) { fnUsesStrOp = true }
          scopePop()
        }
        // A `string` global initialized with a literal-union atom widens via the runtime tower
        // (`emitAtomToStr`), which stages the atom id in the string-op scratch frame.
        if globalInitWidensAtomToStr(globalStmts[gi]) { fnUsesStrOp = true }
        if exprHasScratch(ix, "arrNew") { fnUsesArrNew = true }
        if exprHasScratch(ix, "coalesceCall") { fnUsesCoalesceCall = true }
        if exprHasMapOp(ix, -1) { fnUsesMap = true }
        collectMemberPopRefSlotsExpr(ix, -1)
        // A `.map`/`.filter` in a non-const global initializer (`const ys =
        // xs.map(...)`) runs in the start function — reserve its HOF frame here.
        mfScan(ix, -1)
      }
    }
    gi = gi + 1
  }
  // `.map`/`.filter` sites in top-level STATEMENTS (`print(e.map(...).length)`)
  // also run in the start function; `mfScan` recurses every statement shape itself.
  let mfi = swS0
  while mfi < swS1 {
    mfScan(startStmts[mfi], -1)
    mfi = mfi + 1
  }
  // Top-level STATEMENTS may also need scratch (a `.push` / string op / map op in a
  // top-level `for`/`while`/`if` body or a bare call). Scan each through the same
  // walkers (which recurse into for/while/if bodies). `startScanBlock` runs every
  // block walker over one body; `startScanIf` descends an if/else-if chain.
  let si = swS0
  while si < swS1 {
    const st = nodeAt(startStmts[si])
    if st is ForRange {
      // The whole HEAD — bounds and step alike — is part of the start function's body, and
      // nothing scans it by default: `for i in 0 to (g(2) ?? 0) { }` at module scope would
      // emit `fbLocalSet(coalesceCallSlot)` against a local the vector never declared. The
      // in-function twins walk it already, which is why this needed its own scan.
      startScanHeaderExpr(st.frFrom)
      startScanHeaderExpr(st.frTo)
      startScanHeaderExpr(st.frStep)
      startScanBlock(st.frBody)
    } else if st is ForIn {
      startScanBlock(st.fiBody)
      startScanHeaderExpr(st.fiIter)
      // A BARE map iterable (`for k in m` at module scope) — asked through the
      // emitter's own header predicate, exactly as `blockHasMapOp`'s ForIn arm
      // does for the in-function twin. `exprHasMapOp` claims only the
      // `m.keys()` / `m.values()` Call spellings.
      if forInMapRecv(st.fiIter, -1) >= 0 { fnUsesMap = true }
    } else if st is WhileStmt {
      // The condition, likewise: `startScanBlock` receives only the body.
      startScanHeaderExpr(st.whileCond)
      startScanBlock(st.whileBody)
    } else if st is IfStmt {
      startScanIf(startStmts[si])
    } else {
      // expression statements (a bare call / assignment): the per-statement push
      // detector plus the expr walkers
      applyPushPopBits(callPushBits(startStmts[si], -1))
      applyPushPopBits(exprPopBits(startStmts[si], -1))
      // The emitter reads an arm tail at its prelude locals (`emitStmt`), so this scan does too.
      const armKept = stmtArmScopeOpen(startStmts[si])
      if exprHasStrOp(startStmts[si], -1) { fnUsesStrOp = true }
      if armKept >= 0 { scopePop() }
      if exprHasScratch(startStmts[si], "arrNew") { fnUsesArrNew = true }
      if exprHasScratch(startStmts[si], "coalesceCall") {
        fnUsesCoalesceCall = true
      }
      if exprHasMapOp(startStmts[si], -1) { fnUsesMap = true }
      if callIsPushKind(startStmts[si], -1, "ref") {
        recordStartRefPushSlot(startStmts[si])
      }
      collectMemberPopRefSlotsExpr(startStmts[si], -1)
    }
    si = si + 1
  }
  // Variant-rebox stash for the start function: a multi-field CALL result re-boxed into a
  // variant-box union arm in a non-const global initializer or a top-level statement.
  // `blockHasVariantRebox` recurses into for/while/if bodies itself.
  let vrg = swG0
  while vrg < swG1 {
    if globalRunsInStartFn(vrg) {
      const vg = nodeAt(globalStmts[vrg])
      if vg is LetDecl {
        if vg.letInit >= 0 { scanStashes(vg.letInit, -1) }
      }
    }
    vrg = vrg + 1
  }
  let vrs = swS0
  while vrs < swS1 {
    scanStashes(startStmts[vrs], -1)
    vrs = vrs + 1
  }
  let lgi = swG0
  while lgi < swG1 {
    if globalRunsInStartFn(lgi) {
      const lg = nodeAt(globalStmts[lgi])
      if lg is LetDecl { leqScanExpr(lg.letInit, -1) }
    }
    lgi = lgi + 1
  }
  let lsi = swS0
  while lsi < swS1 {
    leqScanStmt(startStmts[lsi], -1)
    lsi = lsi + 1
  }
  0
}

// Collect the start function's DECLARED locals from the top-level statements: a
// `for` range loop's var+bound pair (and any `let`s nested in loop/if bodies, via
// the same collectLocals walkers user functions use, with the module-level
// `fnIx = -1`). Resets the local registry + scope stack like `buildLocals`.
function collectStartLocals() {
  localIsRef = []
  localStructIdx = []
  localLoopVar = []
  localLoopIter = []
  localPairIter = []
  localDeclIx = []
  localSlotOfDecl = Map()
  localUnset = []
  localByNode = []
  declSlotByNode = Map()
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  scopePush()
  let i = swS0
  while i < swS1 {
    const s = nodeAt(startStmts[i])
    if s is ForRange {
      if (
        collectExprArms(s.frFrom, -1) < 0
        || collectExprArms(s.frTo, -1) < 0
        || collectExprArms(s.frStep, -1) < 0
      ) {
        scopePop()
        return -1
      }
      // SHARED with the function-scope walk, for the reason the `ForIn` arm below states:
      // a top-level `for` and an in-function `for` need identical slots. Duplicating it is
      // how a non-constant `step` at module scope emitted against a local nothing declared.
      declareForRangeLocals(s, startStmts[i])
      if collectLocals(s.frBody, -1) < 0 {
        scopePop()
        return -1
      }
      // The loop variable's scope is the loop (see `scopeUnbind`).
      scopeUnbind()
    } else if s is ForIn {
      // The loop-var / cursor / `#l`-temp declaration is `declareForInLocals` — SHARED with
      // the function-scope walk, because a top-level `for` and an in-function `for` need
      // identical slots (`fnIx` -1 is the only difference, and it is a parameter).
      if collectExprArms(s.fiIter, -1) < 0 || declareForInLocals(s, -1) < 0 {
        scopePop()
        return -1
      }
      if collectLocals(s.fiBody, -1) < 0 {
        scopePop()
        return -1
      }
      // The loop variable's scope is the loop (see `scopeUnbind`).
      scopeUnbind()
    } else if s is WhileStmt {
      if (
        collectExprArms(s.whileCond, -1) < 0
        || collectLocalsWhile(startStmts[i], -1) < 0
      ) {
        scopePop()
        return -1
      }
    } else if s is IfStmt {
      if collectLocalsIf(startStmts[i], -1) < 0 {
        scopePop()
        return -1
      }
    } else if collectExprArms(startStmts[i], -1) < 0 {
      // Every other statement is an expression, whose if-expression arms' locals are this frame's.
      scopePop()
      return -1
    }
    i = i + 1
  }
  // The promoted top-level bindings (G2c) claim their slots last, after every local the
  // statement walk declared, so a program promoting nothing emits the frame it always did.
  // The slot registers under `<name>#g`, not the binding's own name — `#` cannot occur in a
  // source identifier, so nothing resolves to this slot by name; the only reader is `emitUserGlobalGet`/`emitUserGlobalSet` via `gPromoSlot`.
  let pgi = swG0
  while pgi < swG1 {
    // A global's initializer runs in this function, so its if-expression arms' locals are ours.
    const gd = nodeAt(globalStmts[pgi])
    if gd is LetDecl {
      if collectExprArms(gd.letInit, -1) < 0 {
        scopePop()
        return -1
      }
    }
    if gPromoOk[pgi] == 1 {
      const pg = nodeAt(globalStmts[pgi])
      if pg is LetDecl {
        // P2 restricted the cell to a plain numeric scalar, so `structIdx` is never
        // consulted and `fbLocalRun(ck, -1)` writes the same valtype byte the cell's
        // `fbValtypeNullable(ck, -1)` would have.
        gPromoSlot[pgi] = addLocalSlot(globalCellKind(globalStmts[pgi]), -1)
      }
    }
    pgi = pgi + 1
  }
  scopePop()
  localIsRef.length
}

// Emits the synthetic start function's size-prefixed code entry onto `out`: the pool fills,
// then a call to each module's init function, or every top-level node itself when
// `gInitMods` is empty. `n` is the user function count.
function emitStartFnCode(out: u8[], n: i32, ec: ExpCtx) {
  emitCurFnIx = -1
  emitCurFnPos = -1
  startWalkWindows(-1, -1)
  if gInitMods.length == 0 { return emitStartBodyCode(out, -1, ec) }
  // The whole top level is scanned once, so every init reads one accumulator answer.
  if collectStartLocals() < 0 { return -1 }
  startFnDetectFrames()
  strAccScanStart()
  const body: u8[] = []
  body.push(0)
  const prev = wTarget(body)
  emitStrFillCalls()
  let k = 0
  while k < gInitMods.length {
    fbCall(gImports + n + 1 + k)
    k = k + 1
  }
  fbEnd()
  wTarget(prev)
  const outPrev = wTarget(out)
  wULEB(body.length)
  wBytes(body)
  wTarget(outPrev)
  0
}

// Emits the code entry of init function `k` onto `out`: the top-level nodes of its windows.
function emitInitFnCode(out: u8[], k: i32, ec: ExpCtx) {
  emitCurFnIx = -1
  emitCurFnPos = -1
  startWalkWindows(ifW0[k], ifW1[k])
  fnUsesU8Push = false
  fnUsesMapVals = false
  const rc = emitStartBodyCode(out, k, ec)
  rc
}

// Advances the progress cell past every guarded global whose value top-level position `ord`
// settles (D2652): the one with the highest rank there, so the cell only ever rises.
function emitInitProgressAt(ord: i32) {
  if gInitProgIdx < 0 { return 0 }
  const gi = gInitProgAfter[ord] ?? -1
  if gi < 0 { return 0 }
  fbI32RelOf(RS_GUARD, gi, initGuardValue(gi) + relSkew(RS_GUARD))
  fbGlobalSet(gInitProgIdx)
  0
}

// The body both entries above share, over the nodes `startWalkWindows` set: the whole start
// when `k` is -1, else init function `k`, which runs no pool fill and keeps the narrowing
// its predecessor left. Frames exactly as `emitFuncCode` does.
function emitStartBodyCode(out: u8[], k: i32, ec: ExpCtx) {
  // Locals first, detection second: the scratch detectors classify expressions through the
  // declared-locals registry, so it must be populated first. The start function is synthetic
  // and has no `FuncDecl` to anchor a failure at; -1 is the honest anchor for a failure with no
  // owning declaration, and a node-anchored caller (`emitFailAt`) overrides it.
  emitCurFnIx = -1
  emitCurFnPos = -1
  // Where THIS body's span rows begin (D1594). The merge loop below banks one row per
  // top-level statement at `bodyExpr`-relative offsets; the tail rebases exactly this
  // suffix onto `out` once the locals vector and the size prefix are known.
  const spanBase = emitFnSpanStart.length
  const nStartLocals = collectStartLocals()
  if nStartLocals < 0 { return -1 }
  startFnDetectFrames()
  // Which top-level string bindings are loop accumulators. After the detection sweep, which
  // is what sets `fnUsesStrOp` for this body, and after the last user function's own scan —
  // the start function's code entry is emitted last, so nothing overwrites the answer.
  if k < 0 { strAccScanStart() }
  // The start function is void, so it has no union-box return to sink, and its top-level
  // bindings take neither sink; clear the flags the last user function left set, or
  // `fbBeginFunc`/`fbLocalsCount`/`fbEmitLocalsVec` would each reserve a frame for it.
  fnUsesUnionSink = false
  fnUsesUnionLetSink = false
  uSinkFired = 0
  envCacheOpen(-1)
  fbBeginFunc(0, nStartLocals)

  const bodyExpr: u8[] = []
  const exprPrev = wTarget(bodyExpr)
  // The pool fills first: every later line of the module may read a pool string.
  if k < 0 { emitStrFillCalls() }
  // Reset the emit-time scope/loop bookkeeping (the start fn has its own empty frame),
  // mirroring `emitFuncCode` — no leak from the last user function.
  scopeNames = []
  scopeSlots = []
  scopeFrames = []
  // One frame for the top-level statement list, as `collectStartLocals` pushes for the same
  // walk. A function body takes its frame from `emitStmts` on its `Block`; the top level
  // has no `Block`, so without this the lowering cannot be told from a scope-less detection
  // pass. Popped below; a `return -1` path leaves it, and the next program resets. D1597.
  scopePush()
  emitLetCursor = 0
  ctrlDepth = 0
  loopContDepth = []
  loopBrkDepth = []
  loopContLabel = []
  loopBrkLabel = []
  if lvFrameDepth.length > 0 { lvFrameDepth = [] }
  if lvFrameLocal.length > 0 { lvFrameLocal = [] }
  // Non-const global initializers and top-level statements run interleaved in source order
  // (merged on `startStmtOrd`/`globalStmtOrd`, the list positions): `xs.push(1)` before
  // `const ys = xs.map(f)` must execute before that init. A program with only inits, or only
  // statements, emits the same bytes as before. The emit context is module-level (`fnIx = -1`): identifier reads/writes resolve to globals.
  let gi = swG0
  let si = swS0
  // The promotion context window (G2c): a promoted binding's `local.get`/`local.set` is only
  // meaningful in this frame, so the flag that lets `emitUserGlobalGet`/`emitUserGlobalSet`
  // produce one is armed for exactly the span streaming this body. Every user function body and
  // every const cell's constexpr init has already run with the flag false, so a promoted binding reaching them is a loud reject rather than a wrong opcode.
  gPromoInStart = true
  while gi < swG1 || si < swS1 {
    let takeGlobal = gi < swG1
    if takeGlobal && si < swS1 {
      if startStmtOrd[si] < globalStmtOrd[gi] { takeGlobal = false }
    }
    if takeGlobal {
      // ANCHOR any emit failure raised below at the top-level node being lowered (see
      // `emitCurStmtIx`) — the start function has no declaration of its own to name.
      emitCurStmtIx = globalStmts[gi]
      gInitStartOrd = globalStmtOrd[gi]
      const gSpanAt = bodyExpr.length
      let gArmKept = -1
      if globalArmScopeOk(globalStmts[gi]) {
        gArmKept = stmtArmScopeOpen(globalStmts[gi])
      }
      const gInitRc = emitStartGlobalInit(
        bodyExpr,
        exprPrev,
        gi,
        globalStmts[gi],
        ec,
      )
      if gArmKept >= 0 { stmtArmScopeClose(gArmKept) }
      if gInitRc < 0 { return gInitRc }
      emitInitProgressAt(globalStmtOrd[gi])
      // The row the D1594 diagnostic reads: this initializer's own byte range, so an
      // offset inside it names the `const`/`let` rather than the whole start function.
      // A global whose init did not run here contributes no bytes and no row.
      if bodyExpr.length > gSpanAt {
        bankFnSpan(globalStmts[gi], -1, gSpanAt, bodyExpr.length, 1, "")
      }
      gi = gi + 1
    } else {
      emitCurStmtIx = startStmts[si]
      gInitStartOrd = startStmtOrd[si]
      const sSpanAt = bodyExpr.length
      if emitStmt(bodyExpr, startStmts[si], -1, ec) < 0 {
        wTarget(exprPrev)
        return -1
      }
      emitInitProgressAt(startStmtOrd[si])
      if bodyExpr.length > sSpanAt {
        bankFnSpan(startStmts[si], -1, sSpanAt, bodyExpr.length, 1, "")
      }
      si = si + 1
    }
  }
  scopePop()
  gInitStartOrd = -1
  // The cursor is armed for exactly the span that streams this body; the `return -1` paths
  // above leave it set, which is what carries the anchor out to the diagnostic.
  emitCurStmtIx = -1
  // Close the promotion window. The `return -1` paths above leave it armed, which is
  // inert: a failed body aborts the whole module emit, and `computeGlobalPromotion`
  // clears the flag at the top of the next one.
  gPromoInStart = false
  wTarget(exprPrev)

  const body: u8[] = []
  // Locals vector: the start fn's declared locals (for-loop vars), then the scratch frames.
  if fbEmitLocalsVec(body, nStartLocals) < 0 { return -1 }
  // Where `bodyExpr` lands INSIDE the body — everything before it is the locals vector.
  const exprInBody = body.length
  relCopy(bodyExpr, body, exprInBody)
  appendAll(body, bodyExpr)
  const endPrev = wTarget(body)
  fbEnd() // 0x0b end (void → void: stack already empty)
  fbEndFunc()
  wTarget(endPrev)

  const outPrev = wTarget(out)
  wULEB(body.length)
  // REBASE this body's statement rows off `bodyExpr` and onto the entry (D1594): the size
  // prefix is written, so `out.length` is where the body itself begins. The caller moves
  // them onto the payload and then the module, exactly as it does for a user function's row.
  const bodyInOut = out.length
  let ssp = spanBase
  while ssp < emitFnSpanStart.length {
    emitFnSpanStart[ssp] = emitFnSpanStart[ssp] + bodyInOut + exprInBody
    emitFnSpanEnd[ssp] = emitFnSpanEnd[ssp] + bodyInOut + exprInBody
    ssp = ssp + 1
  }
  wBytes(body)
  wTarget(outPrev)
  0
}

// `emitStartFnCode`'s step for global `gi`, whose statement is `gst`: when its initializer runs
// in the start function, emits it into `bodyExpr` under the cell's context, then its
// `global.set`. On failure restores the writer to `exprPrev` and returns the failure; else 0.
function emitStartGlobalInit(
  bodyExpr: u8[],
  exprPrev: u8[],
  gi: i32,
  gst: i32,
  ec: ExpCtx,
) {
  if globalRunsInStartFn(gi) {
    const g = nodeAt(gst)
    if g is LetDecl {
      // Numeric WIDENING at the global-init boundary (a non-const `: f64`/`: f32`/`: i64`
      // global whose init is a narrower numeric — e.g. `const b: f64 = a` with `a: i32`):
      // the `emitExprAs*` helper inserts the lattice convert so the start-fn `global.set`
      // matches the cell valtype. An i32 cell is untouched. (Slice 5 widening.)
      const gck = globalCellKind(gst)
      if gck == "f32" {
        if emitExprAsF32(bodyExpr, g.letInit, -1, ec) < 0 {
          wTarget(exprPrev)
          return -1
        }
      } else if gck == "f64" {
        if emitExprAsF64(bodyExpr, g.letInit, -1, ec) < 0 {
          wTarget(exprPrev)
          return -1
        }
      } else if gck == "i64" {
        if emitExprAsI64(bodyExpr, g.letInit, -1, ec) < 0 {
          wTarget(exprPrev)
          return -1
        }
      } else {
        emitStartGlobalSeedCtx(gst, ec)
        if (emitStartGlobalInitValue(bodyExpr, exprPrev, gst, g, gck, ec) < 0) {
          return -1
        }
        // Back to idle: a left armed null seed retypes the next global's bare `null` (D1563).
        const idle = expCtxHere(ec)
        idle.nulBool = false
        idle.nulString = false
        idle.litUnion = 0
        idle.nulLitUnion = false
        expCtxApply(idle, ec)
        // Read-only covariance at the module-global binding (D822), a delivery form of its own:
        // a global is not a `let`, so no let-side delivery reaches it. A const
        // global's init is a wasm constexpr and cannot carry a loop, so the widening copy can only go
        // here — which is where a global reading another global always runs anyway (`globalIsNonConst`).
        if gck == "reflist" {
          emitRefListWidenSite(
            bodyExpr,
            g.letInit,
            exprEmittedRefListSlot(g.letInit, -1),
            globalRefListSlot(gst),
          )
        }
        // The scalar dual (D965), and the same argument for it living here: a const global's init is
        // a wasm constexpr and cannot carry a loop, so the copy can only go in the non-const init body — which is where a global reading another global always runs.
        emitScalarListWidenSite(bodyExpr, g.letInit, -1, gck)
        emitGlobalInitArmUnbox(gst, gck, g.letInit)
      }
      const setPrev = wTarget(bodyExpr)
      if emitUserGlobalSet(gi) < 0 {
        wTarget(setPrev)
        wTarget(exprPrev)
        return -1
      }
      wTarget(setPrev)
    }
  }
  0
}

// `emitStartGlobalInit`'s seeding step for global statement `gst`:
// applies the expression context its initializer lowers under — the niche null reps and atoms.
function emitStartGlobalSeedCtx(gst: i32, ec: ExpCtx) {
  const sc = expCtxHere(ec)
  // A `boolean|null` NICHE global lowers a bare `null` init as the sentinel 2;
  // a `string|null` global lowers it as `ref.null $sTypeIdx` (kind 16).
  sc.nulBool = globalCellKind(gst) == "nulbool"
  sc.nulString = letIsNulString(gst, -1)
  // An atom global's start-fn init lowers a member literal as its atom id, and a `K | null`
  // niche's a bare `null` as the `-1` sentinel — the start-fn twin of the const-path seeding.
  if letBindIsAtom(gst, -1) { sc.litUnion = 1 }
  if letBindIsNulAtom(gst, -1) { sc.nulLitUnion = true }
  expCtxApply(sc, ec)
  // The cell's null rep, by kind (the local-`let` and `global.set`
  // boundaries share the resolver). A bare `null` is never a WasmGC constexpr, so every
  // `= null` global routes here and this is where its null rep is decided.
  const cellCtx = expCtxHere(ec)
  expCtxApply(cellCtx, ec)
  0
}

// `emitStartGlobalInit`'s value step for global statement `gst` (its `LetDecl` `g`, cell kind
// `gck`): emits the initializer into `bodyExpr` by the cell's coercion. On
// failure restores the writer to `exprPrev` and returns -1, else 0.
function emitStartGlobalInitValue(
  bodyExpr: u8[],
  exprPrev: u8[],
  gst: i32,
  g: LetDecl,
  gck: VKind,
  ec: ExpCtx,
) {
  let svi = -1
  if gck == "variant" { svi = globalCellStructIdx(gst) }
  // A union cell (kind 4) coerces a raw init value into the box (`let w: string | i32 = n`
  // boxes the i32 read); a union-valued init passes through unchanged. The box-typed
  // position: a union global's cell is always the box (unlike `buildLocals`), so a
  // concrete-variant init must be boxed exactly as a call argument, return, or array element is, or a plain coerce would store the wrong ref into the box cell.
  let gun = ""
  if gck == "union" { gun = letUnionNameOf(gst, -1) }
  // An un-annotated global names its union off the init, and carries no type of its own.
  let gunTy = -1
  if g.letType >= 0 { gunTy = nodeTyIxOf(g.letType) }
  // A module-level `let f = add` aliasing a GENERIC (un-annotated-param) named
  // function, used only as a direct-call callee: the closure through the floor-LESS
  // core, the start-fn twin of the const-cell arm in `emitGlobalSection`.
  const gAliasFe = monoGenericAliasFe(gst)
  // The module-scope twin of `emitLetDeclStmt`'s union-box map-read arm. A bare top-level
  // `const t = m[k]` over a union-valued map must lower its miss as the null-tagged box,
  // because the consuming `!= null`/`is`/`match`/`??` is a tag compare that recovers the box
  // with `ref.as_non_null` first. Without this arm the init falls through to `emitMapGet`'s bare `ref.null` miss — check-clean, then a runtime `null reference` trap.
  const gUmr = letNulMapReadUnionBox(gst, -1)
  if gUmr {
    const gumrN = nodeAt(unwrapParen(g.letInit))
    if gumrN is Index {
      if (
        emitMapGetUnionBox(bodyExpr, gumrN.idxArr, gumrN.idxIndex, -1, ec)
        < 0
      ) {
        wTarget(exprPrev)
        return -1
      }
    } else {
      wTarget(exprPrev)
      return emitFail(
        "emitProgram: union-valued map read binding's init is not an index read",
      )
    }
  } else if gun != "" {
    if emitUnionBoxArg(bodyExpr, gun, gunTy, g.letInit, -1, ec) < 0 {
      wTarget(exprPrev)
      return -1
    }
  } else if (gck == "variant" && svi >= 0 && svi < uVarHeap.length) {
    // A bare-arm cell takes the arm's struct whatever builds it, as a local does (D4639).
    if emitVariantCoerce(bodyExpr, svi, g.letInit, -1, ec) < 0 {
      wTarget(exprPrev)
      return -1
    }
  } else if gAliasFe >= 0 {
    if emitClosureValueCore(bodyExpr, gAliasFe, -1, ec) < 0 {
      wTarget(exprPrev)
      return -1
    }
  } else if gck == "nulnone" {
    // A `null`-typed init that is not a bare `null` runs for its effects (D3355).
    if emitNulNoneBoxPayload(bodyExpr, g.letInit, -1, ec) < 0 {
      wTarget(exprPrev)
      return -1
    }
  } else if (
    (gck == "str" || gck == "nulstr")
    && globalInitIsLitAtom(g.letInit)
  ) {
    // A literal-union atom initializing a `string` global widens to its member string.
    // The start fn is a real function, so the runtime widening tower runs here (unlike a
    // CONST global, whose constexpr init has no `select`/scratch).
    if emitAtomToStr(bodyExpr, g.letInit, -1, ec) < 0 {
      wTarget(exprPrev)
      return -1
    }
  } else {
    if emitExpr(bodyExpr, g.letInit, -1, ec) < 0 {
      wTarget(exprPrev)
      return -1
    }
  }
  0
}

// The synthetic `__log__(offset, length)` decoder body: walks the tag/value pairs in linear
// memory (two words per pair) and prints each value, mirroring the host runner's `__log__`
// import. Tag 0 is a plain i32; a non-zero tag traps (`unreachable`) since no corpus program
// logs one natively and a silent wrong decode is worse. The host joins a multi-pair log into one line, this prints one per pair — harmless, since every corpus call logs exactly one.
function emitMemLogFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  // Locals vector: params occupy 0 (offset) and 1 (length); local 2 is the cursor.
  wULEB(1)      // 1 locals run
  wULEB(1)      // count 1
  wU8(127)      // 0x7f i32
  fbLocalGet(0)
  fbLocalSet(2) // cursor = offset
  fbBlock(64)   // block (void)
  fbLoop(64)    // loop (void)
  fbLocalGet(2)
  fbLocalGet(0)
  fbLocalGet(1)
  fbI32Bin(106) // 0x6a i32.add — offset + length (the end)
  fbI32Bin(78)  // 0x4e i32.ge_s — cursor >= end?
  fbBrIf(1)     // exit the block
  fbLocalGet(2)
  fbI32Load()   // the pair's TAG
  fbIf(64)      // tag != 0 → unsupported payload kind
  fbUnreachable()
  fbEnd()
  fbLocalGet(2)
  fbI32Const(4)
  fbI32Bin(106) // i32.add — the value word
  fbI32Load()
  fbCall(0)     // __print_i32__ (import 0)
  fbLocalGet(2)
  fbI32Const(8)
  fbI32Bin(106) // i32.add
  fbLocalSet(2) // cursor += 8
  fbBr(0)       // next pair
  fbEnd()       // end loop
  fbEnd()       // end block
  fbEnd()       // 0x0b end (void function: stack empty)
  wTarget(prev)
  const outPrev = wTarget(out)
  wULEB(body.length)
  wBytes(body)
  wTarget(outPrev)
  0
}

// ── shared runtime helper bodies (module-tail functions) ──
// Each body below is the once-per-module copy of machinery every lowering site otherwise
// inlines. Hand-rolled like the `__log__` decoder above: a locals vector, then straight `fb*`
// opcodes against wasm param/local indices (no scratch-frame indirection — params are the frame).

// Frame a finished helper body (locals vec + code already in `body`) onto `out`.
function helpFrameBody(out: u8[], body: u8[]) {
  const outPrev = wTarget(out)
  wULEB(body.length)
  wBytes(body)
  wTarget(outPrev)
  0
}

// Frame `__eq_<si>__` onto `out`: the frames a user function comparing row `si` reserves, laid
// out after the two params, then the compare. A list or function field stages its operands
// in those frames, so the locals vector is built as `emitFuncCode` builds one (D9962).
function eqHelpFnCode(out: u8[], si: i32, ec: ExpCtx): i32 {
  resetFnScratchFlags()
  envCacheOpen(-1)
  fnUsesUnionSink = false
  fnUsesUnionLetSink = false
  fnUsesStrOp = true
  if shapeHasCloField(si, []) { fnUsesCloEq = true }
  leqNoteStructRowFields(si, [])
  fbBeginFunc(2, 0)
  const code = eqHelpFnBody(si, ec)
  const body: u8[] = []
  if fbEmitLocalsVec(body, 0) < 0 { return -1 }
  appendAll(body, code)
  helpFrameBody(out, body)
}

// One `h = (h ^ back[i + k]) * 16777619` step of the FNV chain, against the `__str_hash__`
// frame (back = local 5, h = local 1, i = local 2). `k == 0` skips the offset add. Shared by
// the unrolled block and the remainder loop so the two cannot drift into hashing differently.
// `i` is a backing offset, not a view offset: the prologue seeds it from the header's `start` and bounds it at `start + len`.
function fbStrHashStep(k: i32) {
  fbLocalGet(1)
  fbLocalGet(5)
  fbLocalGet(2)
  if k != 0 {
    fbI32Const(k)
    fbI32Bin(106) // i32.add (i + k)
  }
  fbArrayGet(sBackIdx)
  fbI32Bin(115) // 0x73 i32.xor
  fbI32Const(16777619)
  fbI32Bin(108) // 0x6c i32.mul
  fbLocalSet(1)
  0
}

// `__str_hash__(s) -> i32`: the masked non-negative FNV-1a hash of a string. Params: s(0).
// Locals: h(1), i(2), n(3), lim(4), back(5). Memoised in the header's mutable `$hash` field
// (field 3) — sound because the hash is a pure function of the three immutable header
// fields, so one mutable field in an immutable string is a memo, not state; `0` means "not computed yet", so a string whose hash is genuinely 0 re-walks.
function emitStrHashFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(2)     // 2 locals runs
  wULEB(4)     // count 4
  wU8(127)     // 0x7f i32 (h, i, n, lim)
  wULEB(1)     // count 1
  wU8(99)      // 0x63 (ref null ht) — the hoisted backing
  wSLEB(sBackIdx)
  fbBlock(127) // block i32 — yields the hash, cached or freshly walked
  // Memo hit: `h = s.hash ; if h != 0 { yield h }`. Two instructions and a branch on the path
  // that matters — the compiler hashes the same immutable key object (a pooled literal, a token's text, an interned name) over and over.
  fbLocalGet(0)
  fbStrHash()
  fbLocalTee(1)           // h = s.hash
  fbIf(64)                // if h != 0, void
  fbLocalGet(1)
  fbBr(1)                 // → out of the i32 block with the cached hash
  fbEnd()
  fbI32Const(-2128831035) // 2166136261 as signed (the FNV offset basis)
  fbLocalSet(1)           // h
  // Hoist the header ONCE: backing into local 5, the cursor seeded to `start`, the bound to
  // `start + len`. Every element step below then costs one `array.get` and no `struct.get`.
  fbLocalGet(0)
  fbStrBack()
  fbLocalSet(5) // back = s.backing
  fbLocalGet(0)
  fbStrStart()
  fbLocalSet(2) // i = s.start
  fbLocalGet(2)
  fbLocalGet(0)
  fbStrLen()
  fbI32Bin(106) // i32.add
  fbLocalSet(3) // n = s.start + s.len  (one past the last offset)
  fbLocalGet(3)
  fbI32Const(4)
  fbI32Bin(107) // i32.sub
  fbLocalSet(4) // lim = n - 4
  // Wide block: while i <= lim { 4 chained steps ; i += 4 }
  fbLoop(64)    // loop, void
  fbLocalGet(2) // i
  fbLocalGet(4) // lim
  fbI32Bin(74)  // 0x4a i32.gt_s (i > lim → no full block fits)
  fbIf(64)      // then: done (empty)
  fbElse()
  fbStrHashStep(0)
  fbStrHashStep(1)
  fbStrHashStep(2)
  fbStrHashStep(3)
  fbLocalGet(2)
  fbI32Const(4)
  fbI32Bin(106) // i32.add
  fbLocalSet(2) // i += 4
  fbBr(1)       // → loop header
  fbEnd()       // end (gt_s if)
  fbEnd()       // end (wide loop)
  // Remainder: while i < n { one step ; i += 1 }
  fbLoop(64)    // loop, void
  fbLocalGet(2) // i
  fbLocalGet(3) // n
  fbI32Bin(78)  // 0x4e i32.ge_s (i >= n → done)
  fbIf(64)      // then: done (empty)
  fbElse()
  fbStrHashStep(0)
  fbLocalGet(2)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(2)
  fbBr(1)       // → loop header
  fbEnd()       // end (ge_s if)
  fbEnd()       // end (remainder loop)
  // h & 0x7fffffff — force non-negative (the result), then MEMOISE it. The store is the
  // only write anyone ever makes to field 3 and it stores exactly what this walk computed,
  // so a second caller either reads this value or recomputes the identical one.
  fbLocalGet(1)
  fbI32Const(2147483647)
  fbI32Bin(113)  // 0x71 i32.and
  fbLocalSet(1)  // h = the masked result
  fbLocalGet(0)
  fbLocalGet(1)
  fbStrSetHash() // s.hash = h  — 0 stays 0 and simply re-walks next time (see the header)
  fbLocalGet(1)
  fbEnd()        // end (block) — leaves the i32 result
  fbEnd()        // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_eq__(a, b) -> i32`: element-wise string value-equality — 0 if the lengths differ or
// any code point differs, else 1. Params: a(0), b(1). Locals: n(2), i(3), lim(4). Unrolled
// eight wide over an xor/or accumulator; `lim = n - 8` is a subtraction so a maximal-length
// string cannot overflow the gate. Identity fast path (`ref.eq`): the literal pool interns every distinct literal as one module global, so a pooled compare is reference-identical.
function fbStrEqReadA(k: i32) {
  fbLocalGet(5) // aBack
  fbLocalGet(3) // i
  if k > 0 {
    fbI32Const(k)
    fbI32Bin(106) // i32.add
  }
  fbArrayGet(sBackIdx)
  0
}
function fbStrEqReadB(k: i32) {
  fbLocalGet(6) // bBack
  fbLocalGet(3) // i
  fbLocalGet(7) // d = b.start - a.start
  fbI32Bin(106) // i32.add
  if k > 0 {
    fbI32Const(k)
    fbI32Bin(106) // i32.add
  }
  fbArrayGet(sBackIdx)
  0
}

function emitStrEqFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(3)     // 3 locals runs
  wULEB(3)     // count 3
  wU8(127)     // 0x7f i32 (n, i, lim)
  wULEB(2)     // count 2
  wU8(99)      // 0x63 (ref null ht) — the two hoisted backings
  wSLEB(sBackIdx)
  wULEB(1)     // count 1
  wU8(127)     // 0x7f i32 (d — b's start relative to a's)
  fbBlock(127) // block i32 — yields the 0/1 result
  // `if ref.eq(a, b) { 1 ; br out }`. The operands are headers now, so `ref.eq` compares views,
  // not element arrays — still a pure short-circuit (a header trivially equals itself, and it
  // still fires on the literal pool), but it stops covering two distinct headers over the same
  // backing and range, which now walk instead. That is a lost optimisation, never a wrong answer.
  fbLocalGet(0)
  fbLocalGet(1)
  wU8(211) // 0xd3 ref.eq
  fbIf(64) // if, void
  fbI32Const(1)
  fbBr(1)  // → out of the i32 block
  fbEnd()
  // if a.len != b.len { 0 ; br out }
  fbLocalGet(0)
  fbStrLen()
  fbLocalGet(1)
  fbStrLen()
  fbI32Bin(71) // 0x47 i32.ne
  fbIf(64)     // if, void
  fbI32Const(0)
  fbBr(1)      // → out of the i32 block
  fbEnd()
  // Hoist BOTH headers once. The cursor `i` walks A's BACKING coordinates, so an A read is
  // `aBack[i]` with no bias at all and a B read is `bBack[i + d]` for the one-time
  // `d = b.start - a.start`. `n` is A's END offset (`a.start + a.len`).
  fbLocalGet(0)
  fbStrBack()
  fbLocalSet(5) // aBack
  fbLocalGet(1)
  fbStrBack()
  fbLocalSet(6) // bBack
  fbLocalGet(0)
  fbStrStart()
  fbLocalSet(3) // i = a.start
  fbLocalGet(3)
  fbLocalGet(0)
  fbStrLen()
  fbI32Bin(106) // i32.add
  fbLocalSet(2) // n = a.start + a.len
  fbLocalGet(1)
  fbStrStart()
  fbLocalGet(3)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(7) // d = b.start - a.start
  // lim = n - 8 — the last cursor at which a full eight-element block fits. A SUBTRACTION
  // rather than `i + 8 > n`: `n` is bounded by the backing's length and cannot overflow it,
  // while `i + 8` on a maximal-length string could.
  fbLocalGet(2)
  fbI32Const(8)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(4)
  // Short-string gate: skip the wide loop entirely unless a full block can run at least once.
  // Strings shorter than the unroll factor are the common case (identifiers, keywords, tags),
  // and for them the whole wide region is dead weight. The test is `lim >= i` rather than `n >=
  // 8`, because `i` no longer starts at 0 — a view starts at its own `start`, and `n >= 8` would ask about the parent's extent instead of this view's length.
  fbLocalGet(4)
  fbLocalGet(3)
  fbI32Bin(78) // 0x4e i32.ge_s (lim >= i → at least one full block fits)
  fbIf(64)     // if, void
  fbLoop(64)   // loop (eight wide), void
  fbLocalGet(3)
  fbLocalGet(4)
  fbI32Bin(74) // 0x4a i32.gt_s (i > lim → no full block left)
  fbIf(64)     // then: done (empty)
  fbElse()
  // acc = (a[i]^b[i]) | (a[i+1]^b[i+1]) | ... | (a[i+7]^b[i+7]), on the stack.
  let k = 0
  while k < 8 {
    fbStrEqReadA(k)
    fbStrEqReadB(k)
    fbI32Bin(115) // 0x73 i32.xor — 0 exactly when the pair matches
    if k > 0 {
      fbI32Bin(114) // 0x72 i32.or — fold into the accumulator
    }
    k = k + 1
  }
  // A non-zero accumulator means at least one of the eight pairs differed.
  fbIf(64)
  fbI32Const(0)
  fbBr(4) // → out of: if(0)·else(1)·loop(2)·n>=8 if(3)·block(4)
  fbEnd()
  // i = i + 8
  fbLocalGet(3)
  fbI32Const(8)
  fbI32Bin(106)
  fbLocalSet(3)
  fbBr(1) // → loop header
  fbEnd() // end (gt_s if/else)
  fbEnd() // end (eight-wide loop)
  fbEnd() // end (n >= 8 if)
  // Scalar remainder: the fewer than eight elements the wide loop could not cover.
  fbLoop(64)   // loop, void
  fbLocalGet(3)
  fbLocalGet(2)
  fbI32Bin(78) // i32.ge_s (i >= n → done)
  fbIf(64)     // then: done (empty)
  fbElse()
  // if a[i] != b[i] { 0 ; br out }
  fbStrEqReadA(0)
  fbStrEqReadB(0)
  fbI32Bin(71) // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(3)      // → out of: if(0)·else(1)·loop(2)·block(3)
  fbEnd()
  // i = i + 1
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(3)
  fbBr(1)       // → loop header
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  fbI32Const(1) // every element matched
  fbEnd()       // end (block)
  fbEnd()       // end (function) — leaves the 0/1 result
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_concat__(a, b) -> (ref str)`: allocates a fresh `lenA + lenB` backing, `array.copy`s
// both operands' live ranges in, and wraps a whole-backing header around it. Params: a(0),
// b(1). Locals: lenA(2), lenB(3) i32; out(4) a non-null `(ref $sBackIdx)`. Concat is the one
// string op a view cannot make cheaper, but each `array.copy` reads from its operand's `start`, not from 0, so a view operand does not concatenate its parent's leading characters.
function emitStrConcatFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(2) // 2 locals runs
  wULEB(2) // count 2
  wU8(127) // 0x7f i32 (lenA, lenB)
  wULEB(1) // count 1
  wU8(100) // 0x64 (ref $sBackIdx) — out
  wSLEB(sBackIdx)
  // lenA = a.len ; lenB = b.len
  fbLocalGet(0)
  fbStrLen()
  fbLocalSet(2)
  fbLocalGet(1)
  fbStrLen()
  fbLocalSet(3)
  // out = array.new_default $sBackIdx (lenA + lenB)
  fbLocalGet(2)
  fbLocalGet(3)
  fbI32Bin(106) // i32.add
  fbArrayNewDefault(sBackIdx)
  fbLocalSet(4)
  // array.copy out 0 a.backing a.start lenA
  fbLocalGet(4)
  fbI32Const(0)
  fbLocalGet(0)
  fbStrBack()
  fbLocalGet(0)
  fbStrStart()
  fbLocalGet(2)
  fbArrayCopy(sBackIdx, sBackIdx)
  // array.copy out lenA b.backing b.start lenB
  fbLocalGet(4)
  fbLocalGet(2)
  fbLocalGet(1)
  fbStrBack()
  fbLocalGet(1)
  fbStrStart()
  fbLocalGet(3)
  fbArrayCopy(sBackIdx, sBackIdx)
  // The header over the exact-fit backing.
  fbLocalGet(4)
  fbI32Const(0)
  fbLocalGet(2)
  fbLocalGet(3)
  fbI32Bin(106) // i32.add
  fbStrNew()
  fbEnd() // end (function) — leaves the fresh string ref
  wTarget(prev)
  helpFrameBody(out, body)
}

// ── the UTF-8 codec helpers ──
// Three module-tail functions, minted from `aUsed` alongside the string trio above: the codec
// is a loop with a variable stride, the one shape a lowering cannot inline at every use site.
// One copy each: `for cp in s`/`s.cpAt(i)` share `__utf8_dec__`; `fromCodePoint`/`fromCodePoints` share `__utf8_enc__`, which has a fourth twin in VL — `emit_base.cpsToUtf8` — that must agree with it exactly or `"é" == fromCodePoint(233)` goes false.

// Replaces the code point in local `cpL` with U+FFFD when it has no UTF-8 encoding — outside
// [0, 0x10FFFF], or inside the UTF-16 surrogate range D800..DFFF. Emitted into both of
// `__utf8_enc__`'s passes (width and write), since sanitizing changes the width and a width pass that disagreed with the write pass would size the backing wrong.
function fbUtf8Sanitize(cpL: i32) {
  fbLocalGet(cpL)
  fbI32Const(0)
  fbI32Bin(72)      // 0x48 i32.lt_s
  fbLocalGet(cpL)
  fbI32Const(1114111)
  fbI32Bin(74)      // 0x4a i32.gt_s
  fbI32Bin(114)     // 0x72 i32.or
  fbLocalGet(cpL)
  fbI32Const(55296)
  fbI32Bin(78)      // 0x4e i32.ge_s
  fbLocalGet(cpL)
  fbI32Const(57343)
  fbI32Bin(76)      // 0x4c i32.le_s
  fbI32Bin(113)     // 0x71 i32.and
  fbI32Bin(114)     // 0x72 i32.or
  fbIf(64)
  fbI32Const(65533) // U+FFFD
  fbLocalSet(cpL)
  fbEnd()
  0
}

// `(1 << 24) | 0xFFFD` — the decoder's "consume ONE byte, yield the replacement character"
// answer, and the only answer it gives for a byte that begins nothing. Consuming exactly one
// byte is what makes `for cp in s` terminate on arbitrary bytes: a width of 0 would spin.
function fbUtf8DecBad() {
  fbI32Const(16842749) // (1 << 24) | 65533 — width 1, U+FFFD
  fbReturn()
  0
}

// `__utf8_dec__(back, i, end) -> i32` — decodes the UTF-8 sequence beginning at backing offset
// `i`, never reading at or past `end`. Returns `(width << 24) | codepoint`, so one call answers
// both questions a decoding cursor has; `width` is always >= 1. A malformed sequence — a stray
// continuation byte, an invalid lead, a truncated tail, an overlong form, a surrogate, or a value past U+10FFFF — decodes to U+FFFD rather than trapping (Go-lean).
function emitUtf8DecFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(1) // 1 locals run
  wULEB(6) // b, n, cp, k, c, lo
  wU8(127) // 0x7f i32
  // b = back[i]  (array.get_u — the backing is packed i8, so this zero-extends to 0..255)
  fbLocalGet(0)
  fbLocalGet(1)
  fbArrayGet(sBackIdx)
  fbLocalSet(3)
  // ASCII: one byte, the code point IS the byte.
  fbLocalGet(3)
  fbI32Const(128)
  fbI32Bin(72)         // i32.lt_s
  fbIf(64)
  fbI32Const(16777216) // 1 << 24
  fbLocalGet(3)
  fbI32Bin(114)        // i32.or
  fbReturn()
  fbEnd()
  // A lead byte below 0xC2 is a continuation byte or a 2-byte overlong — neither begins a
  // sequence.
  fbLocalGet(3)
  fbI32Const(194)
  fbI32Bin(72) // i32.lt_s
  fbIf(64)
  fbUtf8DecBad()
  fbEnd()
  // n = 2 / 3 / 4 by lead-byte range; 0xF5 and up is not a lead byte at all.
  fbI32Const(2)
  fbLocalSet(4)
  fbLocalGet(3)
  fbI32Const(224)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbI32Const(3)
  fbLocalSet(4)
  fbLocalGet(3)
  fbI32Const(240)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbI32Const(4)
  fbLocalSet(4)
  fbLocalGet(3)
  fbI32Const(245)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbUtf8DecBad()
  fbEnd()
  fbEnd()
  fbEnd()
  // A sequence that runs past `end` is truncated — the slice-off-a-boundary case the API
  // deliberately permits, so it is lenient rather than a trap.
  fbLocalGet(1)
  fbLocalGet(4)
  fbI32Bin(106) // i32.add
  fbLocalGet(2)
  fbI32Bin(74)  // i32.gt_s
  fbIf(64)
  fbUtf8DecBad()
  fbEnd()
  // cp = b & (0x7f >> n) — 0x1f / 0x0f / 0x07 for n = 2 / 3 / 4.
  fbLocalGet(3)
  fbI32Const(127)
  fbLocalGet(4)
  fbI32Bin(118) // 0x76 i32.shr_u
  fbI32Bin(113) // 0x71 i32.and
  fbLocalSet(5)
  // for k in 1..n { c = back[i + k]; require 10xxxxxx; cp = (cp << 6) | (c & 0x3f) }
  fbI32Const(1)
  fbLocalSet(6)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(6)
  fbLocalGet(4)
  fbI32Bin(78)  // i32.ge_s
  fbBrIf(1)
  fbLocalGet(0)
  fbLocalGet(1)
  fbLocalGet(6)
  fbI32Bin(106) // i32.add
  fbArrayGet(sBackIdx)
  fbLocalSet(7)
  fbLocalGet(7)
  fbI32Const(192)
  fbI32Bin(113) // i32.and
  fbI32Const(128)
  fbI32Bin(71)  // 0x47 i32.ne
  fbIf(64)
  fbUtf8DecBad()
  fbEnd()
  fbLocalGet(5)
  fbI32Const(6)
  fbI32Bin(116) // 0x74 i32.shl
  fbLocalGet(7)
  fbI32Const(63)
  fbI32Bin(113) // i32.and
  fbI32Bin(114) // i32.or
  fbLocalSet(5)
  fbLocalGet(6)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(6)
  fbBr(0)
  fbEnd()
  fbEnd()
  // lo = the smallest code point this width is allowed to encode (the overlong test).
  fbI32Const(128)
  fbLocalSet(8)
  fbLocalGet(4)
  fbI32Const(3)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)
  fbI32Const(2048)
  fbLocalSet(8)
  fbEnd()
  fbLocalGet(4)
  fbI32Const(4)
  fbI32Bin(70) // i32.eq
  fbIf(64)
  fbI32Const(65536)
  fbLocalSet(8)
  fbEnd()
  // Overlong, surrogate, or past U+10FFFF: U+FFFD, but consume the WHOLE malformed
  // sequence (width n) — the maximal-subpart rule the lossy decoder already follows.
  fbLocalGet(5)
  fbLocalGet(8)
  fbI32Bin(72) // i32.lt_s
  fbLocalGet(5)
  fbI32Const(1114111)
  fbI32Bin(74) // i32.gt_s
  fbI32Bin(114) // i32.or
  fbLocalGet(5)
  fbI32Const(55296)
  fbI32Bin(78) // i32.ge_s
  fbLocalGet(5)
  fbI32Const(57343)
  fbI32Bin(76) // i32.le_s
  fbI32Bin(113) // i32.and
  fbI32Bin(114) // i32.or
  fbIf(64)
  fbI32Const(65533)
  fbLocalSet(5)
  fbEnd()
  fbLocalGet(4)
  fbI32Const(24)
  fbI32Bin(116) // i32.shl
  fbLocalGet(5)
  fbI32Bin(114) // i32.or
  fbEnd() // end (function) — leaves (width << 24) | cp
  wTarget(prev)
  helpFrameBody(out, body)
}

// Push `[out, w + off]` — the destination array and index for the `off`-th byte of the
// sequence being written. The caller pushes the byte value and closes with `array.set`.
function fbUtf8Put(outL: i32, wL: i32, off: i32) {
  fbLocalGet(outL)
  fbLocalGet(wL)
  if off != 0 {
    fbI32Const(off)
    fbI32Bin(106) // i32.add
  }
  0
}

// `back[start + i]` for `__utf8_enc__`'s source list — the i32 code point at logical index
// `i`, read through `$aTypeIdx` (a plain i32 array, not the packed string backing).
function fbUtf8EncRead(iL: i32, cpL: i32) {
  fbLocalGet(0)
  fbLocalGet(1)
  fbLocalGet(iL)
  fbI32Bin(106) // i32.add
  fbArrayGet(aTypeIdx)
  fbLocalSet(cpL)
  fbUtf8Sanitize(cpL)
  0
}

// `if cp >= <bound> { n = n + 1 }` — one rung of `__utf8_enc__`'s width sum. Three rungs at
// 0x80 / 0x800 / 0x10000 give 1 / 2 / 3 / 4 with no branch tree.
function fbUtf8WidthStep(bound: i32) {
  fbLocalGet(5)
  fbI32Const(bound)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(3)
  fbEnd()
  0
}

// The LEAD byte of a multi-byte sequence: `mark | (cp >> shift)`.
function fbUtf8Lead(mark: i32, shift: i32) {
  fbI32Const(mark)
  fbLocalGet(5)
  fbI32Const(shift)
  fbI32Bin(118) // i32.shr_u
  fbI32Bin(114) // i32.or
  0
}

// A CONTINUATION byte: `0x80 | ((cp >> shift) & 0x3f)`.
function fbUtf8Cont(shift: i32) {
  fbI32Const(128)
  fbLocalGet(5)
  if shift != 0 {
    fbI32Const(shift)
    fbI32Bin(118) // i32.shr_u
  }
  fbI32Const(63)
  fbI32Bin(113) // i32.and
  fbI32Bin(114) // i32.or
  0
}

// `w = w + k` — advance `__utf8_enc__`'s write cursor past the sequence just written.
function fbUtf8Bump(wL: i32, k: i32) {
  fbLocalGet(wL)
  fbI32Const(k)
  fbI32Bin(106) // i32.add
  fbLocalSet(wL)
  0
}

// `__utf8_enc__(back, start, len) -> (ref str)` — UTF-8-encodes `len` i32 code points read
// from `back[start ..]` into a fresh, exact-fit string. Params: back(0) `(ref $aTypeIdx)`,
// start(1), len(2). Locals: n(3), i(4), cp(5), out(6) `(ref $sBackIdx)`, w(7). Two passes,
// because a WasmGC array is fixed-length: pass 1 sums the widths to size the backing, pass 2 writes; both read through `fbUtf8EncRead`, so they cannot disagree about what a code point is.
function emitUtf8EncFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(3) // 3 locals runs — the ref sits BETWEEN two i32 runs, so the vector splits
  wULEB(3) // n(3), i(4), cp(5)
  wU8(127) // 0x7f i32
  wULEB(1)
  wU8(100) // 0x64 (ref $sBackIdx) — out(6), set once at top level before any read
  wSLEB(sBackIdx)
  wULEB(1) // w(7)
  wU8(127) // 0x7f i32
  // pass 1: n = Σ width(cp)
  fbI32Const(0)
  fbLocalSet(3)
  fbI32Const(0)
  fbLocalSet(4)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(4)
  fbLocalGet(2)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  fbUtf8EncRead(4, 5)
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(3)
  fbUtf8WidthStep(128)
  fbUtf8WidthStep(2048)
  fbUtf8WidthStep(65536)
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(4)
  fbBr(0)
  fbEnd()
  fbEnd()
  // out = array.new_default $sBackIdx n
  fbLocalGet(3)
  fbArrayNewDefault(sBackIdx)
  fbLocalSet(6)
  // pass 2: write
  fbI32Const(0)
  fbLocalSet(7)
  fbI32Const(0)
  fbLocalSet(4)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(4)
  fbLocalGet(2)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  fbUtf8EncRead(4, 5)
  // 1 byte: 0xxxxxxx
  fbLocalGet(5)
  fbI32Const(128)
  fbI32Bin(72) // i32.lt_s
  fbIf(64)
  fbUtf8Put(6, 7, 0)
  fbLocalGet(5)
  fbArraySet(sBackIdx)
  fbUtf8Bump(7, 1)
  fbElse()
  // Two-byte form: 110xxxxx 10xxxxxx
  fbLocalGet(5)
  fbI32Const(2048)
  fbI32Bin(72) // i32.lt_s
  fbIf(64)
  fbUtf8Put(6, 7, 0)
  fbUtf8Lead(192, 6)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 1)
  fbUtf8Cont(0)
  fbArraySet(sBackIdx)
  fbUtf8Bump(7, 2)
  fbElse()
  // Three-byte form: 1110xxxx 10xxxxxx 10xxxxxx
  fbLocalGet(5)
  fbI32Const(65536)
  fbI32Bin(72) // i32.lt_s
  fbIf(64)
  fbUtf8Put(6, 7, 0)
  fbUtf8Lead(224, 12)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 1)
  fbUtf8Cont(6)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 2)
  fbUtf8Cont(0)
  fbArraySet(sBackIdx)
  fbUtf8Bump(7, 3)
  fbElse()
  // Four-byte form: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
  fbUtf8Put(6, 7, 0)
  fbUtf8Lead(240, 18)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 1)
  fbUtf8Cont(12)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 2)
  fbUtf8Cont(6)
  fbArraySet(sBackIdx)
  fbUtf8Put(6, 7, 3)
  fbUtf8Cont(0)
  fbArraySet(sBackIdx)
  fbUtf8Bump(7, 4)
  fbEnd()
  fbEnd()
  fbEnd()
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(4)
  fbBr(0)
  fbEnd()
  fbEnd()
  // The whole-backing header over the exact fit.
  fbLocalGet(6)
  fbI32Const(0)
  fbLocalGet(3)
  fbStrNew()
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__utf8_cplen__(s) -> i32` — the code point count of a string view, O(n). Params: s(0).
// Locals: back(1) `(ref null $sBackIdx)`, i(2), end(3), n(4). Drives `__utf8_dec__` rather
// than counting non-continuation bytes: the difference shows only on malformed input, where
// a cheap count and the decode-driven count disagree (a stray continuation byte or truncated sequence each yield their own U+FFFD) — this stays the decode's own answer, not a second one.
function emitUtf8CpLenFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(2)
  wULEB(1)
  wU8(99)       // 0x63 (ref null ht) — the hoisted backing
  wSLEB(sBackIdx)
  wULEB(3)
  wU8(127)      // 0x7f i32 (i, end, n)
  fbLocalGet(0)
  fbStrBack()
  fbLocalSet(1)
  fbLocalGet(0)
  fbStrStart()
  fbLocalSet(2)
  fbLocalGet(2)
  fbLocalGet(0)
  fbStrLen()
  fbI32Bin(106) // i32.add
  fbLocalSet(3)
  fbI32Const(0)
  fbLocalSet(4)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(2)
  fbLocalGet(3)
  fbI32Bin(78)  // i32.ge_s
  fbBrIf(1)
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(4) // one more code point
  fbLocalGet(2)
  fbLocalGet(1)
  wU8(212)      // 0xd4 ref.as_non_null — the hoist slot is nullable; the call is not
  fbLocalGet(2)
  fbLocalGet(3)
  fbCall(gHelpUtf8Dec)
  fbI32Const(24)
  fbI32Bin(118) // 0x76 i32.shr_u — the WIDTH, the same stride `for cp in s` takes
  fbI32Bin(106) // i32.add
  fbLocalSet(2)
  fbBr(0)
  fbEnd()
  fbEnd()
  fbLocalGet(4)
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_bytes__(s) -> (ref $bl8TypeIdx)` — `s.bytes()`, the `u8[]` view of a string's UTF-8
// storage. One `array.copy` of the view's byte range into an exact-fit packed backing,
// wrapped in the ordinary list struct. Params: s(0). Locals: out(1), a non-null
// `(ref $ba8TypeIdx)` set before reads. It copies though the design doc says it should not: a `u8[]` wrapper has no `start` field, so a zero-copy `bytes()` would be silently wrong on `s.slice(1)` (filed, not done).
function emitStrBytesFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(1)
  wULEB(1)
  wU8(100) // 0x64 (ref $ba8TypeIdx) — out
  wSLEB(ba8TypeIdx)
  // out = array.new_default $ba8 (s.len)
  fbLocalGet(0)
  fbStrLen()
  fbArrayNewDefault(ba8TypeIdx)
  fbLocalSet(1)
  // array.copy out 0 s.backing s.start s.len — the cross-heap-type copy is legal because
  // `array.copy` validates on STORAGE types (i8 into i8), not on heap-type identity.
  fbLocalGet(1)
  fbI32Const(0)
  fbLocalGet(0)
  fbStrBack()
  fbLocalGet(0)
  fbStrStart()
  fbLocalGet(0)
  fbStrLen()
  fbArrayCopy(ba8TypeIdx, sBackIdx)
  // { backing: out, len: s.len, cap: s.len } — an exact fit, as `array.new_fixed` makes.
  fbLocalGet(1)
  fbLocalGet(0)
  fbStrLen()
  fbLocalGet(0)
  fbStrLen()
  fbStructNew(bl8TypeIdx)
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_from_bytes__(src, at, count) -> (ref str)` — a fresh exact-fit string over the bytes
// `src[at .. at + count]`, which the caller guarantees are UTF-8. A range outside `src`'s live
// length traps, so stale capacity past `len` is never read. Params: src(0) `(ref $bl8TypeIdx)`,
// at(1), count(2). Locals: out(3), a non-null `(ref $sBackIdx)` set before reads.
function emitStrFromBytesFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(1)
  wULEB(1)
  wU8(100) // 0x64 (ref $sBackIdx) — out
  wSLEB(sBackIdx)
  // at < 0 | count < 0 | (at + count) >u src.len — both non-negative, so the sum cannot wrap unsigned.
  fbLocalGet(1)
  fbI32Const(0)
  fbI32Bin(72) // i32.lt_s
  fbLocalGet(2)
  fbI32Const(0)
  fbI32Bin(72) // i32.lt_s
  fbI32Bin(114) // i32.or
  fbLocalGet(1)
  fbLocalGet(2)
  fbI32Bin(106) // i32.add
  fbLocalGet(0)
  fbStructGet(bl8TypeIdx, 1)
  fbI32Bin(75) // i32.gt_u
  fbI32Bin(114) // i32.or
  fbIf(64)
  fbUnreachable()
  fbEnd()
  // out = array.new_default $sBack count; array.copy out 0 src.backing at count
  fbLocalGet(2)
  fbArrayNewDefault(sBackIdx)
  fbLocalSet(3)
  fbLocalGet(3)
  fbI32Const(0)
  fbLocalGet(0)
  fbStructGet(bl8TypeIdx, 0)
  fbLocalGet(1)
  fbLocalGet(2)
  fbArrayCopy(sBackIdx, ba8TypeIdx)
  // The whole-backing header over the exact fit.
  fbLocalGet(3)
  fbI32Const(0)
  fbLocalGet(2)
  fbStrNew()
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__str_fill__(off, s) -> off + s.len` — copies `s.len` bytes of the pool segment from `off`
// into the zeroed backing of pool string `s`. The start function threads the offset through
// one call per filled entry, so a fill costs a `global.get` and a `call` and no constant.
function emitStrFillFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(0) // no locals
  fbLocalGet(1)
  fbStrBack()
  fbI32Const(0)
  fbLocalGet(0)
  fbLocalGet(1)
  fbStrLen()
  fbArrayInitData(sBackIdx, gStrFillSeg)
  fbLocalGet(0)
  fbLocalGet(1)
  fbStrLen()
  fbI32Bin(106) // i32.add
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// The fill prologue of the start function: every filled pool entry, in segment order.
function emitStrFillCalls() {
  if gHelpStrFill < 0 { return 0 }
  fbI32Const(0)
  let k = 0
  let run = 0
  while k < gStrFillOff.length {
    if gStrFillOff[k] >= 0 {
      if run == STR_FILL_RUN {
        fbDrop()
        fbI32Const(gStrFillOff[k])
        run = 0
      }
      run = run + 1
      fbGlobalGet(externGlobalCount() + k)
      fbCall(gHelpStrFill)
    }
    k = k + 1
  }
  fbDrop()
}

// The wrap-trap's reason, streamed through the same base print pair `__trap__("reason")`
// uses — ONLY when the module already reserves it (`gImports >= 4`), never forced: the
// self-hosted compiler is `Map`'s heaviest user and must keep zero imports (D2290). With
// no other reason to print, the caller falls back to a bare `unreachable`.
function emitMapProbeTrapReason() {
  if gImports < 4 { return 0 }
  for cp in "map probe found no free slot (internal invariant)" {
    fbI32Const(cp)
    fbCall(2) // __print_char__ (import 2)
  }
  fbCall(3) // __print_str_flush__ (import 3)
  0
}

// The probe loop's back-edge, bounded: with the advanced slot on the stack, re-enter the loop
// unless it has wrapped back to `start` (local `startL`), so a probe that has seen every slot traps
// instead of spinning, with a reason when the module has somewhere to print it. `__map_resize__`
// keeps a free slot in every index, so the trap is a broken invariant, never a full map (D2280, D2290).
function emitMapProbeBackEdge(startL: i32) {
  fbLocalGet(startL)
  fbI32Bin(71) // 0x47 i32.ne
  fbBrIf(0)    // → loop header while unvisited slots remain
  emitMapProbeTrapReason()
  fbUnreachable()
}

// A map's index has one layout per key kind, each an i32 array whose slot count `cap` is a power
// of two. A string-keyed map's holds `entry` per slot and its stored hashes gate the key
// compare; an i32-keyed map's holds a (key, entry) pair per slot, so its probe never reads the
// entries. `entry` is 0 free or position + 1; a deleted i32 pair's is -1, a probe marker (D2370).

// `__map_probe__(keyHash, index, hashes, live, keysBacking, key) -> i32`: wrapping linear probe
// of a string-keyed index to the slot holding the key's entry or the free slot ending its chain.
// A dead entry is a probe marker, never a hit; only a module that deletes has one to test.
function emitMapProbeFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(1) // 1 locals run
  wULEB(4) // count 4
  wU8(127) // 0x7f i32 (mask, slot, entry, start)
  // mask = array.len(index) - 1  (the index length is a power of two)
  fbLocalGet(1)
  fbArrayLen()
  fbI32Const(1)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(6)
  // slot = start = keyHash & mask
  fbLocalGet(0)
  fbLocalGet(6)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalTee(7)
  fbLocalSet(9)
  fbBlock(64)   // block (probe break target), void
  fbLoop(64)    // loop, void
  // entry = index[slot] ; if entry == 0 { br out (miss) }
  fbLocalGet(1)
  fbLocalGet(7)
  fbArrayGet(aTypeIdx)
  fbLocalTee(8)
  fbI32Eqz()
  fbBrIf(1) // → out of the probe block
  // hashes[entry-1] == keyHash (&& live[entry-1] != 0) ? __str_eq__(keysBack[entry-1], key) : 0
  fbLocalGet(2)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107) // i32.sub (entry - 1)
  fbArrayGet(aTypeIdx)
  fbLocalGet(0)
  fbI32Bin(70)  // 0x46 i32.eq
  if gMapDeletes {
    fbLocalGet(3)
    fbLocalGet(8)
    fbI32Const(1)
    fbI32Bin(107)
    fbArrayGet(aTypeIdx)
    fbI32Const(0)
    fbI32Bin(71)  // 0x47 i32.ne (live != 0)
    fbI32Bin(113) // 0x71 i32.and
  }
  fbIf(127)            // if, i32 blocktype — the expensive compare rides it
  fbLocalGet(4)
  fbLocalGet(8)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(mkArrIdx) // keysBack[entry-1] — (ref null $aTypeIdx)
  fbRefAsNonNull()     // a stored slot is populated
  fbLocalGet(5)
  fbCall(gHelpStrEq)
  fbElse()
  fbI32Const(0)        // hash/live mismatch → not a hit
  fbEnd()
  fbBrIf(1)            // hit → out of the probe block
  // slot = (slot + 1) & mask  (collision OR a dead marker: keep probing)
  fbLocalGet(7)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(6)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalTee(7)
  emitMapProbeBackEdge(9)
  fbEnd()       // end (loop)
  fbEnd()       // end (probe block)
  fbLocalGet(7) // the probe slot
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__map_probe_i32__(index, key) -> slot`: the i32-keyed probe over (key, entry) pairs, placed
// by `fbMapSlotOf`, to the pair slot holding the key or the free one ending its chain. It reads
// the index alone; a deleted pair (entry -1) is never a hit, and only a module that deletes has one.
function emitMapProbeI32FnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(1) // 1 locals run
  wULEB(4) // count 4
  wU8(127) // 0x7f i32 (mask 2, slot 3, entry 4, start 5)
  // mask = len(index) / 2 - 1 ; slot = start = slotOf(key)
  fbLocalGet(0)
  fbArrayLen()
  fbI32Const(1)
  fbI32Bin(118) // 0x76 i32.shr_u
  fbI32Const(1)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(2)
  fbMapSlotOf(1, 2)
  fbLocalTee(3)
  fbLocalSet(5)
  fbBlock(64)   // block (probe break target), void
  fbLoop(64)    // loop, void
  // entry = index[2*slot + 1] ; if entry == 0 { br out (miss) }
  fbLocalGet(0)
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(116) // 0x74 i32.shl
  fbI32Const(1)
  fbI32Bin(114) // 0x72 i32.or
  fbArrayGet(aTypeIdx)
  fbLocalTee(4)
  fbI32Eqz()
  fbBrIf(1) // → out of the probe block
  // index[2*slot] == key (&& entry > 0) → hit
  fbLocalGet(0)
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(116) // i32.shl
  fbArrayGet(aTypeIdx)
  fbLocalGet(1)
  fbI32Bin(70) // 0x46 i32.eq
  if gMapDeletes {
    fbLocalGet(4)
    fbI32Const(0)
    fbI32Bin(74)  // 0x4a i32.gt_s
    fbI32Bin(113) // 0x71 i32.and
  }
  fbBrIf(1) // hit → out of the probe block
  // slot = (slot + 1) & mask  (collision OR a deleted marker: keep probing)
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(2)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalTee(3)
  emitMapProbeBackEdge(5)
  fbEnd() // end (loop)
  fbEnd() // end (probe block)
  fbLocalGet(3)
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__map_probe_i64__(index, key, keysBacking) -> slot`: the i64-keyed probe over the same pair
// layout, whose tag is `fbMapTagOfI64` of the key, so a tag match is confirmed against the keys
// backing. A deleted pair (entry -1) is never a hit and is never read through.
function emitMapProbeI64FnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(1) // 1 locals run
  wULEB(5) // count 5
  wU8(127) // 0x7f i32 (mask 3, slot 4, entry 5, start 6, tag 7)
  // mask = len(index) / 2 - 1 ; tag = tagOf(key) ; slot = start = slotOf(tag)
  fbLocalGet(0)
  fbArrayLen()
  fbI32Const(1)
  fbI32Bin(118) // 0x76 i32.shr_u
  fbI32Const(1)
  fbI32Bin(107) // 0x6b i32.sub
  fbLocalSet(3)
  fbMapTagOfI64(1)
  fbLocalSet(7)
  fbMapSlotOf(7, 3)
  fbLocalTee(4)
  fbLocalSet(6)
  fbBlock(64)   // block (probe break target), void
  fbLoop(64)    // loop, void
  // entry = index[2*slot + 1] ; if entry == 0 { br out (miss) }
  fbLocalGet(0)
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(116) // 0x74 i32.shl
  fbI32Const(1)
  fbI32Bin(114) // 0x72 i32.or
  fbArrayGet(aTypeIdx)
  fbLocalTee(5)
  fbI32Eqz()
  fbBrIf(1) // → out of the probe block
  // index[2*slot] == tag (&& entry > 0) ? keysBacking[entry-1] == key : 0 → hit
  fbLocalGet(0)
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(116) // i32.shl
  fbArrayGet(aTypeIdx)
  fbLocalGet(7)
  fbI32Bin(70) // 0x46 i32.eq
  if gMapDeletes {
    fbLocalGet(5)
    fbI32Const(0)
    fbI32Bin(74)  // 0x4a i32.gt_s
    fbI32Bin(113) // 0x71 i32.and
  }
  fbIf(127)     // if, i32 blocktype — the key compare rides the tag match
  fbLocalGet(2)
  fbLocalGet(5)
  fbI32Const(1)
  fbI32Bin(107) // i32.sub (entry - 1)
  fbArrayGet(ia64TypeIdx)
  fbLocalGet(1)
  fbI32Bin(81)  // 0x51 i64.eq
  fbElse()
  fbI32Const(0)
  fbEnd()
  fbBrIf(1)     // hit → out of the probe block
  // slot = (slot + 1) & mask  (collision OR a deleted marker: keep probing)
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(3)
  fbI32Bin(113) // 0x71 i32.and
  fbLocalTee(4)
  emitMapProbeBackEdge(6)
  fbEnd() // end (loop)
  fbEnd() // end (probe block)
  fbLocalGet(4)
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// Store `entryL` at the first free slot from `slotL`'s value in the index in `idxL` (mask
// `maskL`), advancing `slotL`: the one insertion loop both resizes and the compaction share.
// With `tagL >= 0` the index is the i32 pair layout, and `tagL`'s value goes beside the entry.
function emitMapPlaceEntry(
  idxL: i32,
  maskL: i32,
  tagL: i32,
  entryL: i32,
  slotL: i32,
) {
  let tw = 0
  if tagL >= 0 { tw = 1 }
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(idxL)
  fbLocalGet(slotL)
  if tw > 0 {
    fbI32Const(1)
    fbI32Bin(116) // i32.shl
    fbI32Const(1)
    fbI32Bin(114) // i32.or
  }
  fbArrayGet(aTypeIdx)
  fbI32Eqz()
  fbBrIf(1) // free → out
  fbLocalGet(slotL)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalGet(maskL)
  fbI32Bin(113) // i32.and
  fbLocalSet(slotL)
  fbBr(0)
  fbEnd() // end (loop)
  fbEnd() // end (block)
  if tw > 0 {
    fbLocalGet(idxL)
    fbLocalGet(slotL)
    fbI32Const(1)
    fbI32Bin(116)
    fbLocalGet(tagL)
    fbArraySet(aTypeIdx)
  }
  fbLocalGet(idxL)
  fbLocalGet(slotL)
  if tw > 0 {
    fbI32Const(1)
    fbI32Bin(116)
    fbI32Const(1)
    fbI32Bin(114)
  }
  fbLocalGet(entryL)
  fbArraySet(aTypeIdx)
  0
}

// `__map_resize__(index, hashes, live, count, size) -> (ref $aTypeIdx)`: when a string-keyed
// map's occupancy crosses 1/2 (`count*2 >= len(index)`), a doubled index with every live entry
// re-placed from its stored hash; else `index` unchanged. The gate is `count`, not `size`,
// because a dead entry's slot stays a probe marker until then.
function emitMapResizeFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(2) // 2 locals runs
  wULEB(4) // count 4
  wU8(127) // 0x7f i32 (mask 5, i 6, rslot 7, entry 8)
  wULEB(1) // count 1
  wU8(100) // 0x64 (ref $aTypeIdx) — newIdx 9
  wSLEB(aTypeIdx)
  // if count * 2 >= len(index) { grow + rehash + early-return newIdx }
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(116) // i32.shl (count * 2)
  fbLocalGet(0)
  fbArrayLen()
  fbI32Bin(79)  // 0x4f i32.ge_u
  fbIf(64)      // if, void
  // newCap = 2 * len(index) ; newIdx = array.new_default newCap ; mask (local 5) = newCap - 1
  fbLocalGet(0)
  fbArrayLen()
  fbI32Const(1)
  fbI32Bin(116)
  fbArrayNewDefault(aTypeIdx)
  fbLocalSet(9)
  fbLocalGet(0)
  fbArrayLen()
  fbI32Const(1)
  fbI32Bin(116)
  fbI32Const(1)
  fbI32Bin(107)
  fbLocalSet(5)
  // for i < count: if entry i is live, place it at hashes[i] & mask
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(6)
  fbLocalGet(3)
  fbI32Bin(78) // i32.ge_s (i >= count → done)
  fbBrIf(1)
  fbLocalGet(6)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(8) // entry = i + 1
  if gMapDeletes {
    fbLocalGet(2)
    fbLocalGet(6)
    fbArrayGet(aTypeIdx)
  } else {
    fbI32Const(1)
  }
  fbIf(64)
  fbLocalGet(1)
  fbLocalGet(6)
  fbArrayGet(aTypeIdx)
  fbLocalGet(5)
  fbI32Bin(113) // i32.and
  fbLocalSet(7)
  emitMapPlaceEntry(9, 5, -1, 8, 7)
  fbEnd()       // end (live if)
  fbLocalGet(8)
  fbLocalSet(6) // i = i + 1
  fbBr(0)
  fbEnd()       // end (loop)
  fbEnd()       // end (block)
  fbLocalGet(9)
  fbReturn()    // the fresh, rebuilt index
  fbEnd()       // end (resize if)
  fbLocalGet(0) // load factor fine → the index unchanged
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__map_resize_i32__(index, count) -> (ref $aTypeIdx)`: the i32-keyed twin, over pairs: when
// `count*2 >= cap`, an index of twice the slots with every pair that is not a deleted marker
// re-placed, reading only the old index; otherwise `index` unchanged.
function emitMapResizeI32FnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(2) // 2 locals runs
  wULEB(6) // count 6
  wU8(127) // 0x7f i32 (oldLen 2, mask 3, i 4, tag 5, entry 6, rslot 7)
  wULEB(1) // count 1
  wU8(100) // 0x64 (ref $aTypeIdx) — newIdx 8
  wSLEB(aTypeIdx)
  // if count * 4 >= len(index) { grow + rehash + early-return newIdx }
  fbLocalGet(1)
  fbI32Const(2)
  fbI32Bin(116) // i32.shl (count * 4)
  fbLocalGet(0)
  fbArrayLen()
  fbLocalTee(2)
  fbI32Bin(79)  // 0x4f i32.ge_u
  fbIf(64)      // if, void
  // newIdx = array.new_default (2 * oldLen) ; mask = oldLen - 1 (the new slot count is oldLen)
  fbLocalGet(2)
  fbI32Const(1)
  fbI32Bin(116)
  fbArrayNewDefault(aTypeIdx)
  fbLocalSet(8)
  fbLocalGet(2)
  fbI32Const(1)
  fbI32Bin(107)
  fbLocalSet(3)
  // for i = 0; i < oldLen; i += 2: if index[i+1] > 0 { place (index[i], index[i+1]) }
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(4)
  fbLocalGet(2)
  fbI32Bin(79)  // i32.ge_u (i >= oldLen → done)
  fbBrIf(1)
  fbLocalGet(0)
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(114) // i32.or
  fbArrayGet(aTypeIdx)
  fbLocalTee(6)
  fbI32Const(0)
  fbI32Bin(74)  // 0x4a i32.gt_s
  fbIf(64)
  fbLocalGet(0)
  fbLocalGet(4)
  fbArrayGet(aTypeIdx)
  fbLocalSet(5)
  fbMapSlotOf(5, 3)
  fbLocalSet(7)
  emitMapPlaceEntry(8, 3, 5, 6, 7)
  fbEnd()       // end (entry if)
  fbLocalGet(4)
  fbI32Const(2)
  fbI32Bin(106)
  fbLocalSet(4)
  fbBr(0)
  fbEnd()       // end (loop)
  fbEnd()       // end (block)
  fbLocalGet(8)
  fbReturn()    // the fresh, rebuilt index
  fbEnd()       // end (resize if)
  fbLocalGet(0) // load factor fine → the index unchanged
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// A map struct's field count: the seven every map has, plus `seqs` and `next` in a module
// that deletes (D2315).
function mapFieldCount() {
  if gMapDeletes { return 9 }
  7
}

// Fields 7 and 8 of a map struct in a module that deletes: `seqs`, the i64 insertion sequence
// of each entry, and `next`, the sequence the next append takes (D2315).
function mapSeqFieldTypes() {
  if !gMapDeletes { return 0 }
  wU8(100) // field 7 seqs: 0x64 (ref $ia64TypeIdx) — non-null i64 array
  wSLEB(ia64TypeIdx)
  wU8(1)   // mutable
  wU8(126) // field 8 next: 0x7e i64
  wU8(1)   // mutable
  0
}

// `__map_resync__(seqs, count, seq) -> i32`: one before the first entry whose sequence is later
// than `seq` (or `count - 1`), for a map walk whose entry a compaction moved. Sequences are i64
// and grow along the entries, so the first later one is where JS `Map` iteration goes next.
function emitMapResyncFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(1)      // 1 locals run
  wULEB(1)      // count 1
  wU8(127)      // 0x7f i32 (i)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(3)
  fbLocalGet(1)
  fbI32Bin(78)  // 0x4e i32.ge_s (i >= count)
  fbBrIf(1)
  fbLocalGet(0)
  fbLocalGet(3)
  fbArrayGet(ia64TypeIdx)
  fbLocalGet(2)
  fbI32Bin(85)  // 0x55 i64.gt_s (later than seq)
  fbBrIf(1)
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(3)
  fbBr(0)
  fbEnd()       // end (loop)
  fbEnd()       // end (block)
  fbLocalGet(3)
  fbI32Const(1)
  fbI32Bin(107) // the caller's step adds one back
  fbEnd()       // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// The resync helper's functype: `(ref <i64 array>, i32, i64) -> i32`.
function mapResyncFuncType() {
  wU8(96)  // 0x60 func
  wULEB(3)
  wU8(100) // 0x64 (ref ht)
  wSLEB(ia64TypeIdx)
  wU8(127) // 0x7f i32
  wU8(126) // 0x7e i64
  wULEB(1)
  wU8(127) // 0x7f i32
  0
}

// The map struct body over the keys list wrapper `keysWrap`: `$mkListIdx` for a string key,
// `$lTypeIdx` for an i32 key, `$il64TypeIdx` for an i64 one. Only field 0 differs between the
// three, which is why the resize and compaction are shared.
function tsMapStructBody(keysWrap: i32) {
  wU8(95)              // 0x5f struct (map)
  wU8(mapFieldCount()) // 7 fields, 9 with seqs
  wU8(100)             // field 0 keys: 0x64 (ref <keysWrap>) — non-null
  wSLEB(keysWrap)
  wU8(1)               // mutable
  wU8(100)             // field 1 vals: 0x64 (ref $lTypeIdx) — non-null
  wSLEB(lTypeIdx)
  wU8(1)               // mutable
  wU8(100)             // field 2 live: 0x64 (ref $aTypeIdx) — non-null i32 array
  wSLEB(aTypeIdx)
  wU8(1)               // mutable
  wU8(100)             // field 3 index: 0x64 (ref $aTypeIdx) — non-null i32 array
  wSLEB(aTypeIdx)
  wU8(1)               // mutable
  wU8(127)             // field 4 count: 0x7f i32
  wU8(1)               // mutable
  wU8(127)             // field 5 size: 0x7f i32
  wU8(1)               // mutable
  wU8(100)             // field 6 hashes: 0x64 (ref $aTypeIdx) — non-null i32 array
  wSLEB(aTypeIdx)
  wU8(1)               // mutable
  mapSeqFieldTypes()
  0
}

// Whether map shape `sh` (-1, -4, or an mv slot) has every heap type its compaction helper
// names, asked without recording a failure: a slot no map op resolved gets no helper.
function mapShapeCompactable(sh: i32): boolean {
  if sh == -1 { return mUsed }
  if sh == -4 { return mI32Used }
  if sh == -6 { return mI64Used }
  if sh < 0 || sh >= mvMapTypeIdx.length { return false }
  const k = mvValKind[sh]
  if k == MVK_STR || k == MVK_I64 || k == MVK_F64 || k == MVK_F32 {
    return true
  }
  const r = mvRlSlot[sh]
  r >= 0 && r < rlBackIdx.length && r < rlWrapIdx.length
}

// The map shape the `k`th compaction helper row serves: row 0 the string-keyed mono map, row 1
// the i32-keyed one, row `2 + s` mv slot `s`, and the last row the i64-keyed one.
function mapCompactRowShape(k: i32) {
  if k == 0 { return -1 }
  if k == 1 { return -4 }
  if k == mvMapTypeIdx.length + 2 { return -6 }
  k - 2
}

// The compaction helper's functype: `(ref <mapTy>) -> ()`.
function mapCompactFuncType(sh: i32) {
  wU8(96)  // 0x60 func
  wULEB(1)
  wU8(100) // 0x64 (ref ht)
  wSLEB(mapTypeIdxOf(sh))
  wULEB(0)
  0
}

// The type indices `__map_compact__` reads for one map shape: the map, its key kind, the keys'
// and values' list wrappers and backing arrays, and the value element's heap type when a
// vacated value slot is cleared to null (-1 for a numeric value).
type MapCompactTys = {
  mapTy: i32,
  keyK: i32,
  keysWrap: i32,
  keysBack: i32,
  valsWrap: i32,
  valsBack: i32,
  valNull: i32,
}

// `__map_compact__`'s type indices for map shape `sh`, as `MapCompactTys` names them.
function mapCompactTysOf(sh: i32): MapCompactTys {
  const mapTy = mapTypeIdxOf(sh)
  const keyK = mapShapeKeyKind(sh)
  let keysWrap = mkListIdx
  let keysBack = mkArrIdx
  if keyK == MAP_KEY_I32 {
    keysWrap = lTypeIdx
    keysBack = aTypeIdx
  } else if keyK == MAP_KEY_I64 {
    keysWrap = il64TypeIdx
    keysBack = ia64TypeIdx
  }
  let valsWrap = lTypeIdx
  let valsBack = aTypeIdx
  let valNull = -1
  if sh >= 0 {
    valsWrap = mvValsWrapOf(sh)
    valsBack = mvValsBackOf(sh)
    const vk = mvValKind[sh]
    if vk != MVK_I64 && vk != MVK_F64 && vk != MVK_F32 {
      valNull = mvValElemHeapOf(sh)
    }
  }
  const t: MapCompactTys = {
    mapTy: mapTy,
    keyK: keyK,
    keysWrap: keysWrap,
    keysBack: keysBack,
    valsWrap: valsWrap,
    valsBack: valsBack,
    valNull: valNull,
  }
  t
}

// `__map_compact__`'s slide: for i < count, a live entry i moves down to entry j and j counts
// it, so j ends as the live count.
function mapCompactSlide(t: MapCompactTys) {
  const mapTy = t.mapTy
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(1)
  fbLocalGet(3)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  fbLocalGet(0)
  fbStructGet(mapTy, 2)
  fbLocalGet(1)
  fbArrayGet(aTypeIdx)
  fbIf(64)     // live[i] != 0
  mapCompactMove(mapTy, 0, t.keysWrap, t.keysBack)
  mapCompactMove(mapTy, 1, t.valsWrap, t.valsBack)
  mapCompactMove(mapTy, 2, -1, aTypeIdx)
  if t.keyK == MAP_KEY_STR { mapCompactMove(mapTy, 6, -1, aTypeIdx) }
  mapCompactMove(mapTy, 7, -1, ia64TypeIdx)
  fbLocalGet(2)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(2)
  fbEnd()      // end (live if)
  fbLocalGet(1)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(1)
  fbBr(0)
  fbEnd()
  fbEnd()
}

// `__map_compact__`'s vacated tail, j <= i < count: each entry dead, with no sequence, and its
// string key and ref value cleared to null.
function mapCompactClearTail(t: MapCompactTys) {
  const mapTy = t.mapTy
  fbLocalGet(2)
  fbLocalSet(1)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(1)
  fbLocalGet(3)
  fbI32Bin(78)
  fbBrIf(1)
  fbLocalGet(0)
  fbStructGet(mapTy, 2)
  fbLocalGet(1)
  fbI32Const(0)
  fbArraySet(aTypeIdx)
  fbLocalGet(0)
  fbStructGet(mapTy, 7)
  fbLocalGet(1)
  fbI64Const(-1, -1)
  fbArraySet(ia64TypeIdx)
  if t.keyK == MAP_KEY_STR {
    fbLocalGet(0)
    fbStructGet(mapTy, 0)
    fbStructGet(t.keysWrap, 0)
    fbLocalGet(1)
    fbRefNull(sTypeIdx)
    fbArraySet(t.keysBack)
  }
  if t.valNull >= 0 {
    fbLocalGet(0)
    fbStructGet(mapTy, 1)
    fbStructGet(t.valsWrap, 0)
    fbLocalGet(1)
    fbRefNull(t.valNull)
    fbArraySet(t.valsBack)
  }
  fbLocalGet(1)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(1)
  fbBr(0)
  fbEnd()
  fbEnd()
}

// `__map_compact__`'s new index cap into local 4: 16, doubled while it is at most
// `4*size + 18`.
function mapCompactGrowCap(mapTy: i32) {
  fbI32Const(16)
  fbLocalSet(4)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(4)
  fbLocalGet(0)
  fbStructGet(mapTy, 5)
  fbI32Const(4)
  fbI32Bin(108) // size * 4
  fbI32Const(18)
  fbI32Bin(106)
  fbI32Bin(75)  // 0x4b i32.gt_u
  fbBrIf(1)
  fbLocalGet(4)
  fbI32Const(2)
  fbI32Bin(108)
  fbLocalSet(4)
  fbBr(0)
  fbEnd()
  fbEnd()
}

// `__map_compact__`'s reindex: idx is the index cleared in place when it already has cap slots
// (a steady churn's case), else a fresh one; then entry i < j is re-placed from the entries,
// never the old index: an i32 key as its own pair tag, an i64 key at its hash, a string key at
// its stored hash. Stores idx back into the map.
function mapCompactReindex(t: MapCompactTys) {
  const mapTy = t.mapTy
  const keyInt = t.keyK != MAP_KEY_STR
  let pairShift = 0
  if keyInt { pairShift = 1 }
  fbLocalGet(0)
  fbStructGet(mapTy, 3)
  fbLocalTee(9)
  fbArrayLen()
  fbLocalGet(4)
  fbI32Const(pairShift)
  fbI32Bin(116) // i32.shl (the index length of cap slots)
  fbI32Bin(70)  // i32.eq
  fbIf(64)
  fbLocalGet(9)
  fbI32Const(0)
  fbI32Const(0)
  fbLocalGet(9)
  fbArrayLen()
  fbArrayFill(aTypeIdx)
  fbElse()
  fbLocalGet(4)
  fbI32Const(pairShift)
  fbI32Bin(116)
  fbArrayNewDefault(aTypeIdx)
  fbLocalSet(9)
  fbEnd()
  fbLocalGet(4)
  fbI32Const(1)
  fbI32Bin(107)
  fbLocalSet(6) // mask = cap - 1
  fbI32Const(0)
  fbLocalSet(1)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(1)
  fbLocalGet(2)
  fbI32Bin(78)  // i32.ge_s (i >= j)
  fbBrIf(1)
  fbLocalGet(1)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(8) // entry = i + 1
  fbLocalGet(0)
  if keyInt {
    fbStructGet(mapTy, 0)
    fbStructGet(t.keysWrap, 0)
    fbLocalGet(1)
    fbArrayGet(t.keysBack)
    if t.keyK == MAP_KEY_I64 {
      fbLocalSet(10)
      fbMapTagOfI64(10)
    }
    fbLocalSet(7) // tag = keys[i], or an i64 key's hash
    fbMapSlotOf(7, 6)
    fbLocalSet(5)
    emitMapPlaceEntry(9, 6, 7, 8, 5)
  } else {
    fbStructGet(mapTy, 6)
    fbLocalGet(1)
    fbArrayGet(aTypeIdx)
    fbLocalGet(6)
    fbI32Bin(113) // i32.and (hashes[i] & mask)
    fbLocalSet(5)
    emitMapPlaceEntry(9, 6, -1, 8, 5)
  }
  fbLocalGet(8)
  fbLocalSet(1) // i = i + 1
  fbBr(0)
  fbEnd()
  fbEnd()
  fbLocalGet(0)
  fbLocalGet(9)
  fbRefAsNonNull()
  fbStructSet(mapTy, 3)
}

// `__map_compact__(m)` for map shape `sh`: slide the live entries down in place, in order and
// with their sequences, clear the vacated tail (refs to null, `seqs` to -1, which no entry
// holds), then rebuild the index at the next power of two above `4*size + 2*INITIAL_CAP`, the
// cap `__map_resize__` would grow into anyway (D2291, D2315). Only a resized index allocates.
function emitMapCompactFnCode(out: u8[], sh: i32) {
  const t = mapCompactTysOf(sh)
  const mapTy = t.mapTy
  const body: u8[] = []
  const prev = wTarget(body)
  // locals: 1 i, 2 j, 3 count, 4 cap, 5 rslot, 6 mask, 7 tag, 8 entry, 9 idx[, 10 an i64 key]
  let runs = 2
  if t.keyK == MAP_KEY_I64 { runs = 3 }
  wULEB(runs) // locals runs
  wULEB(8)
  wU8(127)    // 0x7f i32
  wULEB(1)
  wU8(99)     // 0x63 (ref null ht)
  wSLEB(aTypeIdx)
  if t.keyK == MAP_KEY_I64 {
    wULEB(1)
    wU8(126) // 0x7e i64
  }
  fbLocalGet(0)
  fbStructGet(mapTy, 4)
  fbLocalSet(3)
  mapCompactSlide(t)
  mapCompactClearTail(t)
  // keys.len = vals.len = count = j
  fbLocalGet(0)
  fbStructGet(mapTy, 0)
  fbLocalGet(2)
  fbStructSet(t.keysWrap, 1)
  fbLocalGet(0)
  fbStructGet(mapTy, 1)
  fbLocalGet(2)
  fbStructSet(t.valsWrap, 1)
  fbLocalGet(0)
  fbLocalGet(2)
  fbStructSet(mapTy, 4)
  mapCompactGrowCap(mapTy)
  mapCompactReindex(t)
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// One entry-parallel array's move in `__map_compact__`: `arr[j] = arr[i]`, where `arr` is map
// field `field` (through list wrapper `wrap` when `wrap >= 0`) and `back` its array type.
function mapCompactMove(mapTy: i32, field: i32, wrap: i32, back: i32) {
  fbLocalGet(0)
  fbStructGet(mapTy, field)
  if wrap >= 0 { fbStructGet(wrap, 0) }
  fbLocalGet(2)
  fbLocalGet(0)
  fbStructGet(mapTy, field)
  if wrap >= 0 { fbStructGet(wrap, 0) }
  fbLocalGet(1)
  fbArrayGet(back)
  fbArraySet(back)
  0
}

// Prints `strs[k]` when local `param` equals `k`, for every row: one `if` per row.
// Each `k` is a guard row of space `sp`, its symbol named from `subs[k]`.
function emitInitFailPick(param: i32, strs: string[], sp: i32, subs: i32[]) {
  let k = 0
  while k < strs.length {
    fbLocalGet(param)
    fbI32RelOf(sp, subs[k], k + relSkew(sp))
    fbI32Bin(70) // 0x46 i32.eq
    fbIf(64)
    emitInitFailText(strs[k])
    fbEnd()
    k = k + 1
  }
  0
}

// Streams `text` through `__print_char__`, unflushed.
function emitInitFailText(text: string) {
  for cp in text {
    fbI32Const(cp)
    fbCall(2) // __print_char__ (import 2)
  }
  0
}

// `__init_fail__(g, verb, r)`: prints "`name` read|written before its initializer ran (place),
// via reader" from the rows guard sites interned, then traps (D2652). Each row's text is here
// once, however many sites name it; the code section emits every user body first.
function emitInitFailFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(0) // no locals
  emitInitFailPick(0, gInitGNames, RS_GNAME, gInitGIdx)
  fbLocalGet(1)
  fbIf(64)
  emitInitFailText("written")
  fbElse()
  emitInitFailText("read")
  fbEnd()
  emitInitFailText(" before its initializer ran")
  emitInitFailPick(0, gInitGLocs, RS_GNAME, gInitGIdx)
  const readers: i32[] = []
  while readers.length < gInitReaders.length { readers.push(readers.length) }
  emitInitFailPick(2, gInitReaders, RS_GREAD, readers)
  fbCall(3) // __print_str_flush__ (import 3)
  fbUnreachable()
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// Prints local `x`, a non-negative i32, in decimal: `p` climbs to x's leading power of ten,
// then each digit is `x / p % 10` as `p` falls back to zero. Local `p` is scratch.
function emitAsFailDecimal(x: i32, p: i32) {
  fbI32Const(1)
  fbLocalSet(p)
  fbLoop(64)
  fbLocalGet(x)
  fbLocalGet(p)
  fbI32Bin(110) // 0x6e i32.div_u
  fbI32Const(10)
  fbI32Bin(79) // 0x4f i32.ge_u
  fbIf(64)
  fbLocalGet(p)
  fbI32Const(10)
  fbI32Bin(108) // 0x6c i32.mul
  fbLocalSet(p)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbLoop(64)
  fbLocalGet(x)
  fbLocalGet(p)
  fbI32Bin(110) // 0x6e i32.div_u
  fbI32Const(10)
  fbI32Bin(112) // 0x70 i32.rem_u
  fbI32Const(48)
  fbI32Bin(106) // 0x6a i32.add
  fbCall(2) // __print_char__ (import 2)
  fbLocalGet(p)
  fbI32Const(10)
  fbI32Bin(110) // 0x6e i32.div_u
  fbLocalTee(p)
  fbBrIf(0)
  fbEnd()
  0
}

// `__as_fail__(line, colRow)`: prints "as! <domain> at <line>:<col>: not exact" and returns;
// each site then traps, so a reason costs a site one call rather than a call per character.
function emitAsFailFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(1) // one locals run
  wULEB(1) // p
  wU8(127) // 0x7f i32
  emitInitFailText("as! ")
  let k = 0
  while k < AS_FAIL_DOMS.length {
    fbLocalGet(1)
    fbI32Const(7)
    fbI32Bin(113) // 0x71 i32.and
    fbI32Const(k)
    fbI32Bin(70) // 0x46 i32.eq
    fbIf(64)
    emitInitFailText(AS_FAIL_DOMS[k])
    fbEnd()
    k = k + 1
  }
  fbLocalGet(0)
  fbIf(64)
  emitInitFailText(" at ")
  emitAsFailDecimal(0, 2)
  emitInitFailText(":")
  fbLocalGet(1)
  fbI32Const(3)
  fbI32Bin(118) // 0x76 i32.shr_u
  fbLocalSet(1)
  emitAsFailDecimal(1, 2)
  fbEnd()
  emitInitFailText(": not exact")
  fbCall(3) // __print_str_flush__ (import 3)
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// —— scalar list views (D3028) ——
// A view of pair `p` is `{back, len, cap, src}`, a final subtype of its destination's wrapper:
// the first three fields a snapshot the sync helper refreshes, `src` the list it reads through.

// Reset the view rows, and keep the checker's pairs whose list types this module has.
function svReserve() {
  svViewTy = [-1, -1, -1]
  gHelpSvMk = [-1, -1, -1]
  gHelpSvSync = [-1, -1]
  gHelpSvGet = [-1, -1]
  gHelpSvLen = [-1, -1]
  svPairs = 0
  if lUsed && ia64Used && (scalarViewPairs & 1) != 0 { svPairs = svPairs + 1 }
  if lUsed && fa64Used && (scalarViewPairs & 2) != 0 { svPairs = svPairs + 2 }
  if fa32Used && fa64Used && (scalarViewPairs & 4) != 0 {
    svPairs = svPairs + 4
  }
  0
}

function svDstOf(p: i32): i32 {
  if p == 0 { return 0 }
  1
}

function svSrcWrap(p: i32): i32 {
  if p == 2 { return fl32TypeIdx }
  lTypeIdx
}

function svSrcBack(p: i32): i32 {
  if p == 2 { return fa32TypeIdx }
  aTypeIdx
}

function svDstWrap(d: i32): i32 {
  if d == 0 { return il64TypeIdx }
  fl64TypeIdx
}

function svDstBack(d: i32): i32 {
  if d == 0 { return ia64TypeIdx }
  fa64TypeIdx
}

// The convert from pair `p`'s source element to its destination's: `i64.extend_i32_s`,
// `f64.convert_i32_s` or `f64.promote_f32`.
function svConvOp(p: i32): i32 {
  if p == 0 { return 172 }
  if p == 1 { return 183 }
  187
}

// `ref.test` of a reference against heap type `ty`.
function svRefTest(ty: i32) {
  wU8(251) // 0xfb GC prefix
  wU8(20)  // 0x14 ref.test
  wSLEB(ty)
  0
}

function svHelperCount(): i32 {
  let c = 0
  let p = 0
  while p < 3 {
    if svPairOn(p) { c = c + 1 }
    p = p + 1
  }
  if svDstOn(0) { c = c + 3 }
  if svDstOn(1) { c = c + 3 }
  c
}

function svHelperNames() {
  let p = 0
  while p < 3 {
    if svPairOn(p) {
      wULEB(gHelpSvMk[p])
      wName("__sv_mk_" + i32ToStr(p) + "__")
    }
    p = p + 1
  }
  let d = 0
  while d < 2 {
    if svDstOn(d) {
      wULEB(gHelpSvSync[d])
      wName("__sv_sync_" + i32ToStr(d) + "__")
      wULEB(gHelpSvGet[d])
      wName("__sv_get_" + i32ToStr(d) + "__")
      wULEB(gHelpSvLen[d])
      wName("__sv_len_" + i32ToStr(d) + "__")
    }
    d = d + 1
  }
  0
}

// A functype over `ps`, each a heap type taken as a nullable reference (a narrowed `| null`
// list arrives as one) or -1 for `i32`, returning `res`: a non-null reference to a heap type,
// or -1 `i32`, -2 `i64`, -3 `f64`.
function svFuncType(ps: i32[], res: i32) {
  wU8(96) // 0x60 func
  wULEB(ps.length)
  let i = 0
  while i < ps.length {
    if ps[i] < 0 {
      wU8(127)
    } else {
      wU8(99) // 0x63 (ref null ht)
      wSLEB(ps[i])
    }
    i = i + 1
  }
  wULEB(1)
  if res == -1 {
    wU8(127)
  } else if res == -2 {
    wU8(126)
  } else if res == -3 {
    wU8(124)
  } else {
    wU8(100)
    wSLEB(res)
  }
  0
}

function svHelperFuncTypes() {
  let p = 0
  while p < 3 {
    if svPairOn(p) { svFuncType([svSrcWrap(p)], svDstWrap(svDstOf(p))) }
    p = p + 1
  }
  let d = 0
  while d < 2 {
    if svDstOn(d) {
      const w = svDstWrap(d)
      svFuncType([w], w)
      let elem = -2
      if d == 1 { elem = -3 }
      svFuncType([w, -1], elem)
      svFuncType([w], -1)
    }
    d = d + 1
  }
  0
}

// The helper bodies, in the order `svReserve`'s caller numbered them.
function svPlaceHelpers(codePayload: ByteRope) {
  let p = 0
  while p < 3 {
    if svPairOn(p) {
      const rows = emitFnSpanStart.length
      const entry: u8[] = []
      svMkFnCode(entry, p)
      placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__sv_mk__")
    }
    p = p + 1
  }
  let d = 0
  while d < 2 {
    if svDstOn(d) {
      let rows = emitFnSpanStart.length
      const sync: u8[] = []
      svSyncFnCode(sync, d)
      placeCodeEntry(codePayload, sync, rows, -1, -1, 3, "__sv_sync__")
      rows = emitFnSpanStart.length
      const get: u8[] = []
      svGetFnCode(get, d)
      placeCodeEntry(codePayload, get, rows, -1, -1, 3, "__sv_get__")
      rows = emitFnSpanStart.length
      const len: u8[] = []
      svLenFnCode(len, d)
      placeCodeEntry(codePayload, len, rows, -1, -1, 3, "__sv_len__")
    }
    d = d + 1
  }
  0
}

// Open destination `d`'s wrapper as a type a view may subtype: `sub` with no supertype.
function svOpenParent(d: i32) {
  if !svDstOn(d) { return 0 }
  wU8(80) // 0x50 sub
  wULEB(0)
  0
}

// The view type of pair `p`: `sub final` of its destination's wrapper.
function tsSvView(p: i32) {
  const d = svDstOf(p)
  tsEntryAt(svViewTy[p], "scalar list view")
  wU8(79) // 0x4f sub final
  wULEB(1)
  wULEB(svDstWrap(d))
  wU8(95) // 0x5f struct
  wU8(4)
  wU8(100)
  wSLEB(svDstBack(d))
  wU8(1)
  wU8(127)
  wU8(1)
  wU8(127)
  wU8(1)
  wU8(100) // field 3 src: the source list, immutable
  wSLEB(svSrcWrap(p))
  wU8(0)
  0
}

// `__sv_mk_p__(src) -> (ref $dst)`: a view of `src`, synced.
function svMkFnCode(out: u8[], p: i32) {
  const d = svDstOf(p)
  if p < 0 || p >= svViewTy.length || d >= gHelpSvSync.length { return 0 }
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(0)
  fbI32Const(0)
  fbArrayNewDefault(svDstBack(d))
  fbI32Const(0)
  fbI32Const(0)
  fbLocalGet(0)
  fbRefAsNonNull()
  fbStructNew(svViewTy[p])
  fbCall(gHelpSvSync[d])
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

// The pairs that read as destination `d`, in pair order.
function svPairsOf(d: i32, out: i32[]) {
  let p = 0
  while p < 3 {
    if svPairOn(p) && svDstOf(p) == d { out.push(p) }
    p = p + 1
  }
  0
}

// `__sv_sync_d__(x) -> x`: when `x` is a view, refill its snapshot from its source, converted.
// `x` is never null here: a narrowed `| null` list arrives still typed nullable.
// Locals: 1 `n`, 2 `i`, 3 the backing, then a view and a source local per pair.
function svSyncFnCode(out: u8[], d: i32) {
  const ps: i32[] = []
  svPairsOf(d, ps)
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(2 + 2 * ps.length)
  wULEB(2)
  wU8(127)
  wULEB(1)
  wU8(99) // 0x63 (ref null ht)
  wSLEB(svDstBack(d))
  let j = 0
  while j < ps.length {
    wULEB(1)
    wU8(99)
    wSLEB(svViewTy[ps[j]])
    wULEB(1)
    wU8(99)
    wSLEB(svSrcWrap(ps[j]))
    j = j + 1
  }
  j = 0
  while j < ps.length {
    const p = ps[j]
    const vt = svViewTy[p]
    const vL = 4 + 2 * j
    const sL = 5 + 2 * j
    fbLocalGet(0)
    svRefTest(vt)
    fbIf(64)
    fbLocalGet(0)
    fbRefCast(vt)
    fbLocalSet(vL)
    fbLocalGet(vL)
    fbStructGet(vt, 3)
    fbLocalSet(sL)
    fbLocalGet(sL)
    fbStructGet(svSrcWrap(p), 1)
    fbLocalSet(1)
    fbLocalGet(vL)
    fbStructGet(vt, 2)
    fbLocalGet(1)
    fbI32Bin(72) // 0x48 i32.lt_s
    fbIf(64)
    fbLocalGet(vL)
    fbLocalGet(1)
    fbArrayNewDefault(svDstBack(d))
    fbStructSet(vt, 0)
    fbLocalGet(vL)
    fbLocalGet(1)
    fbStructSet(vt, 2)
    fbEnd()
    fbLocalGet(vL)
    fbStructGet(vt, 0)
    fbLocalSet(3)
    fbI32Const(0)
    fbLocalSet(2)
    fbBlock(64)
    fbLoop(64)
    fbLocalGet(2)
    fbLocalGet(1)
    fbI32Bin(78) // 0x4e i32.ge_s
    fbBrIf(1)
    fbLocalGet(3)
    fbLocalGet(2)
    fbLocalGet(sL)
    fbStructGet(svSrcWrap(p), 0)
    fbLocalGet(2)
    fbArrayGet(svSrcBack(p))
    wU8(svConvOp(p))
    fbArraySet(svDstBack(d))
    fbLocalGet(2)
    fbI32Const(1)
    fbI32Bin(106) // 0x6a i32.add
    fbLocalSet(2)
    fbBr(0)
    fbEnd()
    fbEnd()
    fbLocalGet(vL)
    fbLocalGet(1)
    fbStructSet(vt, 1)
    fbEnd()
    j = j + 1
  }
  fbLocalGet(0)
  fbRefAsNonNull()
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

// Push local `idxL` when it is below the length of the wrapper in local `recv` (type `wrap`),
// else -1, so an out-of-range read traps as `emitListIdxGuard`'s does.
function svGuardedIdx(idxL: i32, recv: i32, wrap: i32) {
  fbLocalGet(idxL)
  fbI32Const(-1)
  fbLocalGet(idxL)
  fbLocalGet(recv)
  fbStructGet(wrap, 1)
  fbI32Bin(73) // 0x49 i32.lt_u
  fbSelect()
  0
}

// `__sv_get_d__(x, i)`: element `i` of `x`, read through the source when `x` is a view.
function svGetFnCode(out: u8[], d: i32) {
  const ps: i32[] = []
  svPairsOf(d, ps)
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(ps.length)
  let j = 0
  while j < ps.length {
    wULEB(1)
    wU8(99)
    wSLEB(svSrcWrap(ps[j]))
    j = j + 1
  }
  j = 0
  while j < ps.length {
    const p = ps[j]
    const vt = svViewTy[p]
    const sL = 2 + j
    fbLocalGet(0)
    svRefTest(vt)
    fbIf(64)
    fbLocalGet(0)
    fbRefCast(vt)
    fbStructGet(vt, 3)
    fbLocalSet(sL)
    fbLocalGet(sL)
    fbStructGet(svSrcWrap(p), 0)
    svGuardedIdx(1, sL, svSrcWrap(p))
    fbArrayGet(svSrcBack(p))
    wU8(svConvOp(p))
    fbReturn()
    fbEnd()
    j = j + 1
  }
  fbLocalGet(0)
  fbStructGet(svDstWrap(d), 0)
  svGuardedIdx(1, 0, svDstWrap(d))
  fbArrayGet(svDstBack(d))
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__sv_len_d__(x) -> i32`: the length of `x`, its source's when `x` is a view.
function svLenFnCode(out: u8[], d: i32) {
  const ps: i32[] = []
  svPairsOf(d, ps)
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(0)
  let j = 0
  while j < ps.length {
    const p = ps[j]
    const vt = svViewTy[p]
    fbLocalGet(0)
    svRefTest(vt)
    fbIf(64)
    fbLocalGet(0)
    fbRefCast(vt)
    fbStructGet(vt, 3)
    fbStructGet(svSrcWrap(p), 1)
    fbReturn()
    fbEnd()
    j = j + 1
  }
  fbLocalGet(0)
  fbStructGet(svDstWrap(d), 1)
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

// —— record-list views (D3041) ——
// A view of source row `p` is `{back, len, cap, src}`, a final subtype of the union-box list's
// wrapper: the first three fields a snapshot the sync helper refreshes, `src` the record list
// whose elements it boxes under variant `rvVariant[p]`.

// Whether this module reserves the view helpers: the checker saw a record row delivered as a
// union-box list from an unfresh root, and the module has a union-box list.
function rvWanted(): boolean {
  if !raUsed || refViewSrcTys.length == 0 { return false }
  let u = 0
  while u < rlElemTyIx.length {
    if rlElemKindAt(u) == RLK_UNION { return true }
    u = u + 1
  }
  false
}

function rvWrap(): i32 { rlWrapIdx[rvUnionSlot] }

function rvBack(): i32 { rlBackIdx[rvUnionSlot] }

function rvSrcWrap(p: i32): i32 { rlWrapIdx[rvSrcSlot[p]] }

function rvSrcBack(p: i32): i32 { rlBackIdx[rvSrcSlot[p]] }

// Whether the view types exist: the helpers are reserved and the union-box list has a row.
function rvBuilt(): boolean {
  gHelpRvSync >= 0
    && rvUnionSlot >= 0
    && rvUnionSlot < rlWrapIdx.length
    && rvUnionSlot < rlBackIdx.length
}

function rvHelperCount(): i32 {
  if gHelpRvSync < 0 { return 0 }
  3
}

function rvHelperNames() {
  if gHelpRvSync < 0 { return 0 }
  wULEB(gHelpRvSync)
  wName("__rv_sync__")
  wULEB(gHelpRvGet)
  wName("__rv_get__")
  wULEB(gHelpRvLen)
  wName("__rv_len__")
  0
}

// The three helper functypes. With no union-box list row resolved, each still needs a type, so
// they take `i32` and name no heap: their bodies are then a bare `unreachable`.
function rvHelperFuncTypes() {
  if gHelpRvSync < 0 { return 0 }
  if !rvBuilt() {
    svFuncType([-1], -1)
    svFuncType([-1, -1], -1)
    svFuncType([-1], -1)
    return 0
  }
  svFuncType([rvWrap()], rvWrap())
  svFuncType([rvWrap(), -1], uBoxIdx)
  svFuncType([rvWrap()], -1)
  0
}

function rvPlaceHelpers(codePayload: ByteRope) {
  if gHelpRvSync < 0 { return 0 }
  let rows = emitFnSpanStart.length
  const sync: u8[] = []
  rvSyncFnCode(sync)
  placeCodeEntry(codePayload, sync, rows, -1, -1, 3, "__rv_sync__")
  rows = emitFnSpanStart.length
  const get: u8[] = []
  rvGetFnCode(get)
  placeCodeEntry(codePayload, get, rows, -1, -1, 3, "__rv_get__")
  rows = emitFnSpanStart.length
  const len: u8[] = []
  rvLenFnCode(len)
  placeCodeEntry(codePayload, len, rows, -1, -1, 3, "__rv_len__")
  0
}

// A helper body for a module whose view rows did not resolve: never called.
function rvUnreachableBody(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(0)
  wU8(0) // unreachable
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

// Open the union-box list's wrapper, at ref-list row `slot`, as a type a view may subtype.
function rvOpenParent(slot: i32) {
  if rvSrcSlot.length == 0 || slot != rvUnionSlot { return 0 }
  wU8(80) // 0x50 sub
  wULEB(0)
  0
}

// The view type of row `p`: `sub final` of the union-box list's wrapper.
function tsRvView(p: i32) {
  tsEntryAt(rvViewTy[p], "record list view")
  wU8(79) // 0x4f sub final
  wULEB(1)
  wULEB(rvWrap())
  wU8(95) // 0x5f struct
  wU8(4)
  wU8(100)
  wSLEB(rvBack())
  wU8(1)
  wU8(127)
  wU8(1)
  wU8(127)
  wU8(1)
  wU8(100) // field 3 src: the record list, immutable
  wSLEB(rvSrcWrap(p))
  wU8(0)
  0
}

// Push element `idx` of the record list in local `sL`, for view row `p`: `idx` a local, or with
// `guard` the index in local 1 bounded against that list's length.
function rvSrcElem(p: i32, sL: i32, idx: i32, guard: boolean) {
  fbLocalGet(sL)
  fbStructGet(rvSrcWrap(p), 0)
  if guard { svGuardedIdx(idx, sL, rvSrcWrap(p)) } else { fbLocalGet(idx) }
  fbArrayGet(rvSrcBack(p))
  0
}

// Box that element under view row `p`'s variant, `{tag, record}`; a `null` element of a
// nullable record row boxes under the null tag, as the element-converting copy does.
function rvBoxElem(p: i32, sL: i32, idx: i32, guard: boolean) {
  if rvNul[p] == 1 {
    rvSrcElem(p, sL, idx, guard)
    wU8(209) // 0xd1 ref.is_null
    fbIfRefNul(uBoxIdx, false)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    fbElse()
    fbI32Rel(RS_TAG, uTags[rvVariant[p]])
    rvSrcElem(p, sL, idx, guard)
    fbStructNew(uBoxIdx)
    fbEnd()
    return 0
  }
  fbI32Rel(RS_TAG, uTags[rvVariant[p]])
  rvSrcElem(p, sL, idx, guard)
  fbStructNew(uBoxIdx)
  0
}

// `__rv_sync__(x) -> x`: when `x` is a view, refill its snapshot from its source, each record
// boxed. Locals: 1 `n`, 2 `i`, 3 the backing, then a view and a source local per row.
function rvSyncFnCode(out: u8[]) {
  if !rvBuilt() { return rvUnreachableBody(out) }
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(2 + 2 * rvViewTy.length)
  wULEB(2)
  wU8(127)
  wULEB(1)
  wU8(99) // 0x63 (ref null ht)
  wSLEB(rvBack())
  let j = 0
  while j < rvViewTy.length {
    wULEB(1)
    wU8(99)
    wSLEB(rvViewTy[j])
    wULEB(1)
    wU8(99)
    wSLEB(rvSrcWrap(j))
    j = j + 1
  }
  j = 0
  while j < rvViewTy.length {
    const vt = rvViewTy[j]
    const vL = 4 + 2 * j
    const sL = 5 + 2 * j
    fbLocalGet(0)
    svRefTest(vt)
    fbIf(64)
    fbLocalGet(0)
    fbRefCast(vt)
    fbLocalSet(vL)
    fbLocalGet(vL)
    fbStructGet(vt, 3)
    fbLocalSet(sL)
    fbLocalGet(sL)
    fbStructGet(rvSrcWrap(j), 1)
    fbLocalSet(1)
    fbLocalGet(vL)
    fbStructGet(vt, 2)
    fbLocalGet(1)
    fbI32Bin(72) // 0x48 i32.lt_s
    fbIf(64)
    fbLocalGet(vL)
    fbLocalGet(1)
    fbArrayNewDefault(rvBack())
    fbStructSet(vt, 0)
    fbLocalGet(vL)
    fbLocalGet(1)
    fbStructSet(vt, 2)
    fbEnd()
    fbLocalGet(vL)
    fbStructGet(vt, 0)
    fbLocalSet(3)
    fbI32Const(0)
    fbLocalSet(2)
    fbBlock(64)
    fbLoop(64)
    fbLocalGet(2)
    fbLocalGet(1)
    fbI32Bin(78) // 0x4e i32.ge_s
    fbBrIf(1)
    fbLocalGet(3)
    fbLocalGet(2)
    rvBoxElem(j, sL, 2, false)
    fbArraySet(rvBack())
    fbLocalGet(2)
    fbI32Const(1)
    fbI32Bin(106) // 0x6a i32.add
    fbLocalSet(2)
    fbBr(0)
    fbEnd()
    fbEnd()
    fbLocalGet(vL)
    fbLocalGet(1)
    fbStructSet(vt, 1)
    fbEnd()
    j = j + 1
  }
  fbLocalGet(0)
  fbRefAsNonNull()
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__rv_get__(x, i)`: element `i` of `x`, boxed from the source when `x` is a view.
function rvGetFnCode(out: u8[]) {
  if !rvBuilt() { return rvUnreachableBody(out) }
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(rvViewTy.length)
  let j = 0
  while j < rvViewTy.length {
    wULEB(1)
    wU8(99)
    wSLEB(rvSrcWrap(j))
    j = j + 1
  }
  j = 0
  while j < rvViewTy.length {
    const vt = rvViewTy[j]
    const sL = 2 + j
    fbLocalGet(0)
    svRefTest(vt)
    fbIf(64)
    fbLocalGet(0)
    fbRefCast(vt)
    fbStructGet(vt, 3)
    fbLocalSet(sL)
    rvBoxElem(j, sL, 1, true)
    fbReturn()
    fbEnd()
    j = j + 1
  }
  fbLocalGet(0)
  fbStructGet(rvWrap(), 0)
  svGuardedIdx(1, 0, rvWrap())
  fbArrayGet(rvBack())
  fbRefAsNonNull()
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__rv_len__(x) -> i32`: the length of `x`, its source's when `x` is a view.
function rvLenFnCode(out: u8[]) {
  if !rvBuilt() { return rvUnreachableBody(out) }
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(0)
  let j = 0
  while j < rvViewTy.length {
    const vt = rvViewTy[j]
    fbLocalGet(0)
    svRefTest(vt)
    fbIf(64)
    fbLocalGet(0)
    fbRefCast(vt)
    fbStructGet(vt, 3)
    fbStructGet(rvSrcWrap(j), 1)
    fbReturn()
    fbEnd()
    j = j + 1
  }
  fbLocalGet(0)
  fbStructGet(rvWrap(), 1)
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

// `__f64_rem__(x, y) -> f64`: the truncated remainder — `x - y * trunc(x / y)` in value, with
// the sign of the dividend (Rust's `f64::rem`, JS's `%`, C's `fmod`; wasm has no instruction
// for it, D1586). Not that identity evaluated directly — it is off by an ulp once the
// quotient passes 2^53 — but a scaled repeated-subtraction form: double `b` to the largest `b * 2^k <= a`, then halve back down subtracting where it fits, each step exact in Sterbenz's range.
function emitF64RemFnCode(out: u8[]) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(1) // one locals run
  wULEB(4) // four of them
  wU8(124) // 0x7c f64 — a, b, t, s
  // x not finite (NaN or ±inf) → NaN. `v - v` is NaN for both and 0 for every finite v, which is
  // the whole finiteness test and needs no `inf` constant to compare against.
  fbLocalGet(0)
  fbLocalGet(0)
  fbI32Bin(161) // 0xa1 f64.sub
  fbLocalTee(5)
  fbLocalGet(5)
  fbI32Bin(98) // 0x62 f64.ne
  fbIf(64)
  fbF64Const("0.0")
  fbF64Const("0.0")
  fbI32Bin(163) // 0xa3 f64.div — 0/0 is the NaN this returns
  fbReturn()
  fbEnd()
  // b = |y|; y NaN, or y zero → NaN. The NaN arm is separate because `|NaN| == 0.0` is FALSE.
  fbLocalGet(1)
  fbI32Bin(153) // 0x99 f64.abs
  fbLocalTee(3)
  fbF64Const("0.0")
  fbI32Bin(97) // 0x61 f64.eq
  fbLocalGet(1)
  fbLocalGet(1)
  fbI32Bin(98) // 0x62 f64.ne
  fbI32Bin(114) // 0x72 i32.or
  fbIf(64)
  fbF64Const("0.0")
  fbF64Const("0.0")
  fbI32Bin(163) // 0xa3 f64.div
  fbReturn()
  fbEnd()
  // y INFINITE → x. y is not NaN by here, so the same `v - v` test names ±inf alone.
  fbLocalGet(1)
  fbLocalGet(1)
  fbI32Bin(161) // 0xa1 f64.sub
  fbLocalTee(5)
  fbLocalGet(5)
  fbI32Bin(98) // 0x62 f64.ne
  fbIf(64)
  fbLocalGet(0)
  fbReturn()
  fbEnd()
  // a = |x|; |x| < |y| → x itself, which is what carries `-0.0 % 1` through unharmed (D1586).
  fbLocalGet(0)
  fbI32Bin(153) // 0x99 f64.abs
  fbLocalTee(2)
  fbLocalGet(3)
  fbI32Bin(99) // 0x63 f64.lt
  fbIf(64)
  fbLocalGet(0)
  fbReturn()
  fbEnd()
  // SCALE UP: t = b, doubling while `t * 2 <= a`. A double that overflows lands on +inf,
  // which is `> a` for every finite a, so the loop exits rather than looping forever.
  fbLocalGet(3)
  fbLocalSet(4)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(4)
  fbF64Const("2.0")
  fbI32Bin(162) // 0xa2 f64.mul
  fbLocalTee(5)
  fbLocalGet(2)
  fbI32Bin(100) // 0x64 f64.gt
  fbBrIf(1)
  fbLocalGet(5)
  fbLocalSet(4)
  fbBr(0)
  fbEnd()
  fbEnd()
  // DESCEND: subtract t where it fits, halve, stop at t == b. `a < 2t` holds at every step,
  // so each subtraction is exact and `a` ends in [0, b) — the remainder's magnitude.
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(2)
  fbLocalGet(4)
  fbI32Bin(102) // 0x66 f64.ge
  fbIf(64)
  fbLocalGet(2)
  fbLocalGet(4)
  fbI32Bin(161) // 0xa1 f64.sub
  fbLocalSet(2)
  fbEnd()
  fbLocalGet(4)
  fbLocalGet(3)
  fbI32Bin(97) // 0x61 f64.eq
  fbBrIf(1)
  fbLocalGet(4)
  fbF64Const("0.5")
  fbI32Bin(162) // 0xa2 f64.mul
  fbLocalSet(4)
  fbBr(0)
  fbEnd()
  fbEnd()
  // The sign is the dividend's, including on a zero result (`-4.0 % 2.0` is `-0.0`; D1586).
  fbLocalGet(2)
  fbLocalGet(0)
  fbI32Bin(166) // 0xa6 f64.copysign
  fbEnd() // end (function)
  wTarget(prev)
  helpFrameBody(out, body)
}

// The start function's `@file:line`. Module 0 is the ENTRY and top-level statements live
// there, so the frame names the entry at line 1; a single-file compile has no module key and
// carries the line alone.
function startLocSuffix(): string {
  // Module 0 is the ENTRY, and the entry is where top-level statements live. NOT the module
  // owning token 0: modules load dependency-first, so token 0 belongs to an IMPORT.
  const file = srcmapPathOf(0)
  if file == "" { return "@1" }
  "@" + file + ":1"
}

// A function's `@file:line` — where it is DECLARED, never the trapping instruction, which
// would need a per-instruction map. `anchorOk` says the caller vouches for the node's anchor
// token as a declaration; see the block inside.
function fnLocSuffix(nodeIx: i32, anchorOk: boolean): string {
  // The name token, else the node's anchor when the caller says that anchor is the
  // declaration. A LAMBDA has no name token and its anchor is its own text, so the anchor is
  // right; a monomorphized CLONE has neither, and its anchor is the PIN — a line the reader
  // did not write the function on — so the caller withholds it and the frame carries none.
  let tk = declNameTokOf(nodeIx)
  if tk < 0 && anchorOk {
    if nodeIx >= 0 && nodeIx < nodeToks.length { tk = nodeToks[nodeIx] }
  }
  if tk < 0 || tk >= P.toks.length { return "" }
  // A single-file compile never loads a module graph, so it has no key to spell and the
  // frame carries the LINE alone — unambiguous, there being one file.
  const file = srcmapFileOfTok(tk)
  if file == "" { return "@" + i32ToStr(P.toks[tk].line) }
  "@" + file + ":" + i32ToStr(P.toks[tk].line)
}

// The function-name subsection's entry count for `n` user functions: the imports, the users,
// the start function when there is one, and each helper the module emits.
function nameMapCount(n: i32): i32 {
  let count = gImports + n
  if startStmts.length > 0 { count = count + 1 }
  count = count + gInitMods.length
  if gHelpStrHash >= 0 { count = count + 6 }
  if gHelpStrBytes >= 0 { count = count + 1 }
  if gHelpMapProbe >= 0 { count = count + 2 }
  if gHelpMapProbeI32 >= 0 { count = count + 2 }
  if gHelpMapProbeI64 >= 0 { count = count + 1 }
  if gHelpF64Rem >= 0 { count = count + 1 }
  if gHelpMapResync >= 0 { count = count + 1 }
  let cnk = 0
  while cnk < gHelpMapCompact.length {
    if gHelpMapCompact[cnk] >= 0 { count = count + 1 }
    cnk = cnk + 1
  }
  if gHelpInitFail >= 0 { count = count + 1 }
  count = count + svHelperCount()
  count = count + rvHelperCount()
  if gHelpAsFail >= 0 { count = count + 1 }
  if gHelpStrFromBytes >= 0 { count = count + 1 }
  if gHelpStrFill >= 0 { count = count + 1 }
  count + gTailFnRows.length
}

// The name-section name of map store helper row `row`.
function mapSetFnName(row: i32): string { "__map_set_" + i32ToStr(row) + "__" }

// The namemap entries of the imports, at their slot indices: the print family, then each used
// fs import, then the user externs. A slot with no index or name is recorded with `emitFail` and
// named by a placeholder, so the entry count is still met.
function nameImports() {
  wULEB(0)
  wName("__print_i32__")
  wULEB(1)
  wName("__print_bool__")
  wULEB(2)
  wName("__print_char__")
  wULEB(3)
  wName("__print_str_flush__")
  // The 5th import (index 4) is named only when an i64 program prints.
  if gNeedsI64Print {
    wULEB(4)
    wName("__print_i64__")
  }
  // The `__print_f64__` import is named at its computed index (`gF64PrintIdx`, 4 or 5).
  if gNeedsF64Print {
    wULEB(gF64PrintIdx)
    wName("__print_f64__")
  }
  // The `__print_f32__` import is named at its computed index (`gF32PrintIdx`, 4/5/6).
  if gNeedsF32Print {
    wULEB(gF32PrintIdx)
    wName("__print_f32__")
  }
  // The fs imports, each at the index `scanPrintUse` recorded. They sit between the print family
  // and the user functions, which is where slot order puts them, so the namemap stays strictly
  // increasing — the one hard requirement the appendix places on this subsection. `count` above
  // already includes them, so writing them here is what makes it honest.
  let fsnm = 0
  while fsnm < fsIntrinsicCount() {
    if fsUsedAt(fsnm) {
      let fsIx = fsIdxAt(fsnm)
      let fsLbl = fsIntrinsicNameAt(fsnm)
      if fsIx < 0 || fsLbl == "" {
        // Same rule as the import section's twin loop: `curBuf` is bound to `fnameMap` here, so
        // record the failure and write a placeholder rather than returning out from under the
        // binding. The namemap count is fixed at `gImports + n` before the loop and must still be met.
        emitFail(
          "emitProgram: fs import is used but has no index or name — the slot tables have drifted",
        )
        fsIx = 0
        fsLbl = "__fs_unknown__"
      }
      wULEB(fsIx)
      wName(fsLbl)
    }
    fsnm = fsnm + 1
  }
  // The user externs, after the fs block, which is where manifest order puts them — so the
  // namemap stays strictly increasing, the appendix's one hard requirement.
  let exnm = 0
  while exnm < externCount() {
    let exIx = externIdxAt(exnm)
    let exLbl = externNameAt(exnm)
    if exIx < 0 || exLbl == "" {
      emitFail(
        "emitProgram: extern import has no index or name — the manifest and its readers have drifted",
      )
      exIx = 0
      exLbl = "__extern_unknown__"
    }
    wULEB(exIx)
    wName(exLbl)
    exnm = exnm + 1
  }
}

// The namemap entries of the `n` user functions at `gImports + i`, each named by a lambda's
// display name or its own name, with its location suffix.
function nameUserFns(n: i32) {
  let fi = 0
  while fi < n {
    const fn = nodeAt(fnStmts[fi])
    if fn is FuncDecl {
      wULEB(gImports + fi)
      wName(fnSymName(fi))
    }
    fi = fi + 1
  }
}

// User function `fi`'s name-section name. A lambda's debug display name (its binding,
// `const foo = …` → "foo") wins over the synthesized `__lambda_N`, so a backtrace reads `foo`.
function fnSymName(fi: i32): string {
  if fi < 0 || fi >= fnStmts.length { return "#" + i32ToStr(fi) }
  const fn = nodeAt(fnStmts[fi])
  if fn is FuncDecl {
    const disp = fnDispNames[fi]
    // A display name means a lambda, whose anchor token IS its declaration.
    const loc = fnLocSuffix(fnStmts[fi], disp.length > 0)
    if disp.length > 0 { return disp + loc }
    return fn.fnName + loc
  }
  "#" + i32ToStr(fi)
}

// The namemap entries of the shared runtime helpers, at their module-tail indices.
function nameHelpers() {
  if gHelpStrHash >= 0 {
    wULEB(gHelpStrHash)
    wName("__str_hash__")
    wULEB(gHelpStrEq)
    wName("__str_eq__")
    wULEB(gHelpStrConcat)
    wName("__str_concat__")
    wULEB(gHelpUtf8Dec)
    wName("__utf8_dec__")
    wULEB(gHelpUtf8Enc)
    wName("__utf8_enc__")
    wULEB(gHelpUtf8CpLen)
    wName("__utf8_cplen__")
  }
  if gHelpStrBytes >= 0 {
    wULEB(gHelpStrBytes)
    wName("__str_bytes__")
  }
  if gHelpMapProbe >= 0 {
    wULEB(gHelpMapProbe)
    wName("__map_probe__")
    wULEB(gHelpMapResize)
    wName("__map_resize__")
  }
  if gHelpMapProbeI32 >= 0 {
    wULEB(gHelpMapProbeI32)
    wName("__map_probe_i32__")
    wULEB(gHelpMapResizeI32)
    wName("__map_resize_i32__")
  }
  if gHelpMapProbeI64 >= 0 {
    wULEB(gHelpMapProbeI64)
    wName("__map_probe_i64__")
  }
  if gHelpF64Rem >= 0 {
    wULEB(gHelpF64Rem)
    wName("__f64_rem__")
  }
  if gHelpMapResync >= 0 {
    wULEB(gHelpMapResync)
    wName("__map_resync__")
  }
  let cnw = 0
  while cnw < gHelpMapCompact.length {
    if gHelpMapCompact[cnw] >= 0 {
      wULEB(gHelpMapCompact[cnw])
      wName("__map_compact_" + i32ToStr(cnw) + "__")
    }
    cnw = cnw + 1
  }
  if gHelpInitFail >= 0 {
    wULEB(gHelpInitFail)
    wName("__init_fail__")
  }
  svHelperNames()
  rvHelperNames()
  if gHelpAsFail >= 0 {
    wULEB(gHelpAsFail)
    wName("__as_fail__")
  }
  if gHelpStrFromBytes >= 0 {
    wULEB(gHelpStrFromBytes)
    wName("__str_from_bytes__")
  }
  if gHelpStrFill >= 0 {
    wULEB(gHelpStrFill)
    wName("__str_fill__")
  }
  for row in gTailFnRows {
    if row >= 0 {
      wULEB(gMapSetFn[row])
      wName(mapSetFnName(row))
    } else {
      wULEB(gEqHelpFn[-1 - row])
      wName(eqHelpFnName(-1 - row))
    }
  }
}

// Emits the wasm "name" custom section (id 0) so a wasmtime trap backtrace shows real
// function names instead of `<wasm function N>`. Gated on `gEmitNames` — a no-op when off, so
// the default emit path (goldens + fixpoints) is untouched. `n` is the user-function count and
// `gImports` the imported-function count; imports occupy indices 0..gImports-1, users after. Indices in the namemap must be strictly increasing, per the name-section appendix.
function emitNameSection(n: i32) {
  if gEmitNames == 0 { return 0 }

  // ── function-name subsection (id 1) ──────────────────────────────────────────
  // Build the namemap (count + entries) into a temp buffer, then frame it as the
  // subsection payload. The print imports (if present) are named first at their
  // hardcoded indices 0..3, then each user function at `gImports + i`.
  const fnameMap: u8[] = []
  const mapPrev = wTarget(fnameMap)
  const count = nameMapCount(n)
  wULEB(count)
  if gImports > 0 { nameImports() }
  nameUserFns(n)
  // The synthetic start function — a module's top-level statements — at its own index,
  // between the user functions and the helpers. Without it a trap in top-level code is the
  // one frame the backtrace still reports as `<wasm function N>`, which is the whole of what
  // a reader of `print(a[7])` sees.
  if startStmts.length > 0 {
    wULEB(gImports + n)
    // Top-level statements have no declaration of their own, so the start frame names the
    // ENTRY file at line 1 — the file a reader opens, which is what the frame is for. With
    // init functions the start holds no source code and names no file, so its name does not
    // repeat the root init's.
    if gInitMods.length > 0 {
      wName("__start__")
    } else {
      wName("__start__" + startLocSuffix())
    }
  }
  // Each init function names its own module, so a trap in its top level names that file.
  let ik = 0
  while ik < gInitMods.length {
    wULEB(gImports + n + 1 + ik)
    wName("__start__@" + srcmapPathOf(gInitMods[ik]) + ":1")
    ik = ik + 1
  }
  // The shared runtime helpers (module-tail indices — after the start fn and the
  // `__log__` decoder, so the namemap stays strictly increasing).
  nameHelpers()
  wTarget(mapPrev)

  // ── assemble the section payload: wName("name") + the two subsections ─────────
  const namePayload: u8[] = []
  const npPrev = wTarget(namePayload)
  wName("name")
  // module-name subsection (id 0): a single name. Its payload is a length-prefixed
  // name, built into a temp so the subsection-size ULEB frames the right length.
  const modName: u8[] = []
  const mnPrev = wTarget(modName)
  wName("vl")
  wTarget(mnPrev)
  wU8(0) // subsection id 0: module name
  wULEB(modName.length)
  wBytes(modName)
  // function-name subsection (id 1): the namemap built above.
  wU8(1) // subsection id 1: function names
  wULEB(fnameMap.length)
  wBytes(fnameMap)
  wTarget(npPrev)

  wSection(0, namePayload) // custom section id 0
  0
}

// Places the recorder's global-section rows once every section is in the module rope: their
// offsets are relative to a payload whose place only the finished rope knows.
function relPlaceSections() {
  if !RELOC_ARMED { return 0 }
  let pos = 8
  while pos < W.len {
    const id = ropeAt(W, pos)
    let size = 0
    let shift = 0
    let q = pos + 1
    let more = true
    while more && q < W.len {
      const b = ropeAt(W, q)
      size = size | ((b & 0x7f) << shift)
      shift = shift + 7
      q = q + 1
      more = (b & 0x80) != 0
    }
    if id == 6 { relPlaceSection(id, q) }
    pos = q + size
  }
  0
}

// The slot key of each of the first `n` user functions: its name-section name, then `#k` when
// `k` earlier functions carry that name too (clones of one declaration, or namesake lambdas).
function fnSymKeys(n: i32): string[] {
  const seen: { [string]: i32 } = Map()
  const out: string[] = []
  let fi = 0
  while fi < n {
    let nm = fnSymName(fi)
    // A lambda's synthesized name counts every lambda of the program, its anchor only its own.
    const fn = nodeAt(fnStmts[fi])
    if fn is FuncDecl && fnDispNames[fi].length == 0 {
      const lam = "__lambda_"
      if (
        fn.fnName.length > lam.length
        && fn.fnName.slice(0, lam.length) == lam
      ) {
        nm = "__lambda" + fnLocSuffix(fnStmts[fi], true)
      }
    }
    const dup = seen[nm] ?? 0
    seen[nm] = dup + 1
    if dup == 0 {
      out.push("f:" + nm)
    } else {
      out.push("f:" + nm + "#" + i32ToStr(dup))
    }
    fi = fi + 1
  }
  out
}

// Each shared runtime helper's function index, keyed to its name-section name, and the
// `__log__` decoder's; a per-module artifact names a call to one by that name.
function runtimeFnNames(): { [i32]: string } {
  const buf: u8[] = []
  const prev = wTarget(buf)
  nameHelpers()
  wTarget(prev)
  const out: { [i32]: string } = Map()
  if memLogUsed { out[gMemLogIdx] = "__log__" }
  const ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  const at = [0]
  while at[0] < buf.length {
    const ix = seedLeb(buf, at)
    const len = seedLeb(buf, at)
    let s = ""
    let i = 0
    while i < len && at[0] < buf.length {
      const c: i32 = buf[at[0]]
      if c >= 32 && c < 127 {
        s = s + ascii.slice(c - 32, c - 31)
      } else {
        s = s + "?"
      }
      at[0] = at[0] + 1
      i = i + 1
    }
    out[ix] = s
  }
  out
}

function seedLeb(b: u8[], at: i32[]): i32 {
  let r = 0
  let sh = 0
  while at[0] < b.length {
    const x: i32 = b[at[0]]
    at[0] = at[0] + 1
    if sh < 32 { r = r | ((x & 127) << sh) }
    sh = sh + 7
    if (x & 128) == 0 { return r }
  }
  r
}

// Per minted group type below `g`, what it stands for beyond its bytes: a record's field names,
// a list's element name, a map's key kind and value name, a closure env's captures. Records
// of both families share one spelling, as twins share one heap type. A module suffix in a
// name reads as `modIdOrderNames` spells it, so the seed does not depend on the build directory.
function typeSeeds(g: i32): string[] {
  const out: string[] = []
  let k = 0
  while k < g {
    let kind = -1
    let slot = 0
    if k < mAllocKind.length && k < mAllocSlot.length {
      kind = mAllocKind[k]
      slot = mAllocSlot[k]
    }
    let s = "k" + i32ToStr(kind)
    if kind == TSK_STRUCT && slot >= 0 && slot < sFieldCount.length {
      s = "R" + seedNames(sFieldNames, sFieldStart[slot], sFieldCount[slot])
    } else if kind == TSK_VARIANT && slot >= 0 && slot < uFieldCount.length {
      s = "R" + seedNames(uFieldNames, uFieldStart[slot], uFieldCount[slot])
    } else if (
      (kind == TSK_REF_BACK || kind == TSK_REF_WRAP)
      && slot >= 0
      && slot < rlElemName.length
    ) {
      s = s + ":" + rlElemName[slot]
    } else if (
      kind == TSK_MV_MAP
      && slot >= 0
      && slot < mvKeyKind.length
      && slot < mvValName.length
    ) {
      s = s + ":" + i32ToStr(mvKeyKind[slot]) + ":" + mvValName[slot]
    } else if kind == TSK_CLO_ENV {
      const caps = captureNamesOf(slot)
      s = s + ":" + seedNames(caps, 0, caps.length)
    }
    out.push(modIdOrderNames(s))
    k = k + 1
  }
  out
}

function seedNames(names: string[], from: i32, n: i32): string {
  let s = ""
  let i = 0
  while i < n && from + i < names.length {
    s = s + names[from + i] + ","
    i = i + 1
  }
  s
}

// The armed recorder's rows as the `vl.reloc` custom section: version 2, the symbols (space,
// UTF-8 key, value) and then per row its module offset and symbol. Written last, so no
// offset moves.
function emitRelocSection(n: i32) {
  if !RELOC_ARMED { return 0 }
  const symAt: { [string]: i32 } = Map()
  const symSp: i32[] = []
  const symKey: string[] = []
  const symVal: i32[] = []
  const rowSym: i32[] = []
  const fnKeys = fnSymKeys(n)
  let k = 0
  while k < relCount() {
    const sp = relSpAt(k)
    const id = i32ToStr(sp)
      + "/"
      + i32ToStr(relSubAt(k))
      + "/"
      + i32ToStr(relValAt(k))
    let s = symAt[id] ?? -1
    if s < 0 {
      s = symKey.length
      symAt[id] = s
      symSp.push(sp)
      symVal.push(relValAt(k))
      const fe = relSubAt(k)
      if sp == RS_SLOT && fe >= 0 && fe < fnKeys.length {
        symKey.push(fnKeys[fe])
      } else if sp == RS_SLOT {
        symKey.push("f#" + i32ToStr(fe))
      } else {
        symKey.push(relSymKey(sp, relSubAt(k), relValAt(k)))
      }
    }
    rowSym.push(s)
    k = k + 1
  }
  const payload: u8[] = []
  const prev = wTarget(payload)
  wName("vl.reloc")
  wU8(RELOC_VERSION)
  wULEB(symKey.length)
  k = 0
  while k < symKey.length {
    wU8(symSp[k])
    const bs = cpsToUtf8(strToCps(symKey[k]))
    wULEB(bs.length)
    for b in bs { wU8(b) }
    wSLEB(symVal[k])
    k = k + 1
  }
  wULEB(relCount())
  k = 0
  while k < relCount() {
    wULEB(relOffAt(k))
    wULEB(rowSym[k])
    k = k + 1
  }
  wTarget(prev)
  wSection(0, payload)
}

// Collects the string-literal pool, in arena order: every `StrLit` lexeme that fits one
// `array.new_fixed` (an over-cap one keeps the inline build), every literal an `is` compares
// with `__str_eq__`, and every string literal type an atom's conversion prints, so a module's
// code reads the pool whatever literals the rest of its program holds.
function collectStrPool() {
  gStrPoolTexts = []
  gStrPoolIx = Map()
  gStrDataIx = Map()
  gStrDataStart = []
  gStrDataLen = []
  gStrDataParts = []
  gStrFillOff = []
  gStrFillSeg = -1
  linkIsReset()
  if !aUsed { return 0 }
  const isLexes: string[] = []
  let i = 0
  while i < P.nodes.length {
    const nd = nodeAt(i)
    if nd is StrLit { strLitCollect(nd.strText) }
    if nd is IsExpr && strPoolIsTest(nd) {
      const texts = tyLitMemberTexts(isVarTyIxOf(i))
      let k = 0
      while k < texts.length {
        isLexes.push(quoteLex(texts[k]))
        linkIsNote(i, isLexes[isLexes.length - 1])
        k = k + 1
      }
    }
    i = i + 1
  }
  let j = 0
  while j < isLexes.length {
    strPoolAdd(isLexes[j])
    j = j + 1
  }
  for t in T.tys {
    if t is TyLit && t.litKind == "str" { strPoolAdd(quoteLex(t.litText)) }
  }
  strFillPlan()
}

// The pool entries the start function fills from one passive segment, by `linkFillPlan`, which
// a split build's link re-derives over the pool it lays out; the segment holds their bytes.
function strFillPlan() {
  const bytes: i32[][] = []
  for lex in gStrPoolTexts { bytes.push(linkPoolBytes(lex)) }
  gStrFillOff = linkFillPlan(bytes, gOptimized)
  if gStrFillOff.length == 0 { return 0 }
  const seg: u8[] = []
  let k = 0
  while k < gStrFillOff.length {
    if gStrFillOff[k] >= 0 {
      for v in bytes[k] { seg.push(v) }
    }
    k = k + 1
  }
  gStrFillSeg = gStrDataLen.length
  gStrDataStart.push(gStrDataParts.length)
  gStrDataParts.push({ b: seg })
  gStrDataLen.push(seg.length)
  0
}

// Whether `is` test `n` compares its literals with `__str_eq__` and so wants them pooled: over a
// `string` or `string | null` whatever the test is spelled, and over a string-stored literal
// union only when the test spells its literals out (a named test there compares otherwise).
function strPoolIsTest(n: IsExpr): boolean {
  if nodeTyIsStringPrim(n.isObj) || nodeTyIsNulString(n.isObj) { return true }
  n.isVariant.length > 0
    && n.isVariant[0] == '"'
    && nodeTyComparesAsString(n.isObj)
}

// Pools raw literal lexeme `lex` unless it is pooled already or past the `array.new_fixed` cap.
function strPoolAdd(lex: string) {
  if (gStrPoolIx[lex] ?? -1) >= 0 { return 0 }
  if (
    lex.length >= LIT_PIECE
    || cpsToUtf8(decodeStr(strToCps(lex))).length > NEW_FIXED_MAX
  ) {
    return 0
  }
  strPoolPut(lex)
}

// Pools a lexeme already known to be within the cap and not yet pooled.
function strPoolPut(lex: string) {
  gStrPoolIx[lex] = gStrPoolTexts.length
  gStrPoolTexts.push(lex)
  0
}

// Files a literal's lexeme: pooled within the `array.new_fixed` cap, else a data segment, as is
// every lexeme too long to decode whole, whatever it decodes to.
function strLitCollect(lex: string) {
  if (gStrPoolIx[lex] ?? -1) >= 0 || (gStrDataIx[lex] ?? -1) >= 0 { return 0 }
  if lex.length < LIT_PIECE {
    if cpsToUtf8(decodeStr(strToCps(lex))).length <= NEW_FIXED_MAX {
      return strPoolPut(lex)
    }
  }
  const start = gStrDataParts.length
  const n = litUtf8(lex, gStrDataParts)
  gStrDataIx[lex] = gStrDataLen.length
  gStrDataStart.push(start)
  gStrDataLen.push(n)
  0
}

// Data count section (id 12): the segment count `array.new_data` validates against, ahead of
// the code section; omitted with no data literal.
function emitDataCountSection() {
  if gStrDataLen.length == 0 { return 0 }
  const dcPayload: u8[] = []
  const dcPrev = wTarget(dcPayload)
  wULEB(gStrDataLen.length)
  wTarget(dcPrev)
  wSection(12, dcPayload)
}

// Data section (id 11): one passive segment per data literal, its bytes framed uncopied.
function emitDataSection() {
  const nSeg = gStrDataLen.length
  if nSeg == 0 { return 0 }
  const rope: ByteRope = { chunks: [], len: 0, seekChunk: 0, seekBase: 0 }
  const head: u8[] = []
  const prev = wTarget(head)
  wULEB(nSeg)
  wTarget(prev)
  ropePush(rope, head)
  let k = 0
  while k < nSeg {
    const sh: u8[] = []
    const sp = wTarget(sh)
    wU8(1) // flags 0x01: passive
    wULEB(gStrDataLen[k])
    wTarget(sp)
    ropePush(rope, sh)
    let end = gStrDataParts.length
    if k + 1 < nSeg { end = gStrDataStart[k + 1] }
    let pi = gStrDataStart[k]
    while pi < end {
      ropePush(rope, gStrDataParts[pi].b)
      pi = pi + 1
    }
    k = k + 1
  }
  wSectionRope(11, rope)
}

// Assembles the whole module: the header, then each section through its own emitter in
// wasm's mandated section-id order. Before any section bytes go out, this fixes the
// module-wide index spaces every section then references — start-function and `__log__`
// indices, shared-helper indices, the string pool, and every heap type — so no emitter has to re-derive an index another already chose.
function emitModule(_stmts: i32[], ec: ExpCtx) {
  emitReset()
  typeOrderReset()
  relReset()
  relKeysReset()
  // The collect passes are done, so this is the last moment before any section indexes a
  // variant: prove the field-span tables cover every `uVariants` row, or fail loudly and pad
  // them, since a short table turns the next thirty reads into a compiler trap. Deliberately not
  // gated on `emitFailed` — the mismatch comes from a swallowed registration failure, so the flag is already set when it matters.
  reconcileVariantFieldSpans()
  emitHeader()

  const n = fnStmts.length

  // ── start-function model (non-const module-global initializers) ──
  // A module global whose initializer is not a WasmGC constant expression cannot be emitted
  // inline in the global section: its cell is zero-initialized there, and a single synthetic
  // start function (the last function index, so no user index shifts) runs every such init via `global.set` first. `computeGlobalPromotion` runs here so it sees the arena every pass left behind, before any section reads a global index.
  computeGlobalPromotion()
  // Intern the string-literal pool (its globals PRECEDE the user cells — every
  // user-global index below rides `userGlobalIdx`). Ahead of the start-function count, since
  // a pool the start function fills is a reason to have one.
  collectStrPool()
  const nNonConst = nonConstGlobalCount()
  let hasStart = 0
  if nNonConst > 0 { hasStart = 1 }
  if startStmts.length > 0 { hasStart = 1 }
  if gStrFillSeg >= 0 { hasStart = 1 }
  // The synthetic start function's index (last, after all `n` user functions, which
  // themselves sit after any imports) and its `()->()` functype index (one past the
  // user functypes). Both unused when no start.
  const startFnIdx = gImports + n
  // The synthetic `__log__` decoder (memory intrinsics) is the LAST function index —
  // after the imports, the user functions, AND the start fn — so no other function
  // index shifts. `memFn` (0 or 1) feeds the function/code section counts.
  let memFn = 0
  if memLogUsed { memFn = 1 }
  // The per-module init functions the start calls sit right after it.
  computeInitFns(hasStart)
  const nStartFns = hasStart + gInitMods.length
  gMemLogIdx = gImports + n + nStartFns

  const nHelpers = assignSharedHelperIndices(gImports + n + nStartFns + memFn)

  // Placed by `emitGlobalSection`, which runs before any function body is emitted.
  gHeapGlobalIdx = -1
  gSynthBase = -1
  gSynthKind = []
  gSynthArg = []
  gSynthInit = []
  gSynthAt = Map()
  cloAdapterCanon = Map()
  cloDeclAt = Map()
  envCacheKids = Map()
  envCacheKidsBuilt = false

  // Heap-type indices, in type-section order: standalone structs, then (for the union path)
  // the variant structs + box, the i32 array/list pair, each ref-list pair, the string-list
  // pair, the map struct, and finally the functypes — minted by the centralized `mIntern*`
  // counter inside `mAssignTypeIndices`, which returns the functype base index (`typeOffset`); the heap types and the closure-signature pool emit inside one recursion group, so one may reference another that lands later.
  const typeOffset = mAssignTypeIndices(n)

  const nPrintTypes = printFnTypeCount()

  emitTypeSection(n, typeOffset, hasStart, memFn, nPrintTypes, nHelpers)

  emitImportSection(n, typeOffset, hasStart)

  emitFunctionSection(n, typeOffset, hasStart, memFn, nPrintTypes, nHelpers)

  if fnValUsed { emitTableSection(n) }

  if memUsed && !memImported() { emitMemorySection() }

  emitGlobalSection(ec)

  emitExportSection(n)

  if hasStart == 1 { emitStartSection(startFnIdx) }

  // The code payload is BUILT here and framed below, after the element section it feeds:
  // lowering a function value is what marks `fnAddrTaken`, so building first is what lets the
  // segment list the addresses the bodies actually took. Sound because no body reads the
  // module rope — every write goes to a payload of its own — so only the framing is ordered.
  const codePayload: ByteRope = {
    chunks: [],
    len: 0,
    seekChunk: 0,
    seekBase: 0,
  }
  const built = buildCodePayload(codePayload, n, hasStart, memFn, nHelpers, ec)
  dfeOn = false
  if built < 0 { return -1 }
  // The global section is framed first: it sits after the function section in the rope, so
  // placing it does not move the chunk the function section is placed before.
  frameGlobalSection()
  frameFunctionSection()

  if fnValUsed { emitElementSection(n) }

  emitDataCountSection()
  if writeCodeSection(codePayload) < 0 { return -1 }
  emitDataSection()
  relPlaceSections()
  // Every section that names a type is written, so the first group can take its final order.
  if !emitFailed { typeOrderRun(typeOffset, typeSeeds(typeOffset)) }

  // Custom "name" section LAST (after the code section, where it conventionally
  // lives). A no-op unless `gEmitNames` is set, so the default emit path is
  // unchanged for every golden.
  emitNameSection(n)
  emitRelocSection(n)
  if RELOC_ARMED {
    emitLinkSection(
      n,
      fnSymKeys(n),
      cloThunkFes,
      runtimeFnNames(),
      exportRootGlobals(),
    )
  }
  if wStray.length > 0 {
    return emitFail(
      "emitProgram: a module byte was written outside any section",
    )
  }
  0
}

// How many module globals run their initializer in the synthetic start function.
function nonConstGlobalCount() {
  let nNonConst = 0
  let gci = 0
  while gci < globalStmts.length {
    if globalRunsInStartFn(gci) { nNonConst = nNonConst + 1 }
    gci = gci + 1
  }
  nNonConst
}

// The standalone functypes ahead of the rec group: the print imports', then one per used fs
// import and one per declared extern, each block trailing the last, so adding one moves no
// earlier functype index. The type and function sections both read it; a print-free program
// counts 0. `emitTypeSection` explains the standalone-vs-rec-group split.
function printFnTypeCount() {
  let nPrintTypes = 0
  if gImports > 0 {
    nPrintTypes = 2 // (i32)->() and ()->() for the print imports
  }
  if gNeedsI64Print {
    nPrintTypes = nPrintTypes + 1 // + (i64)->() for __print_i64__
  }
  if gNeedsF64Print {
    nPrintTypes = nPrintTypes + 1 // + (f64)->() for __print_f64__
  }
  if gNeedsF32Print {
    nPrintTypes = nPrintTypes + 1 // + (f32)->() for __print_f32__
  }
  // One per used import, not one per distinct shape: sharing would make slot k's functype
  // depend on which other slots the program uses, the coupling the append-only slot order
  // exists to avoid.
  nPrintTypes = nPrintTypes + fsImportCount()
  nPrintTypes = nPrintTypes + externCount()
  nPrintTypes
}

// The table section (id 4): the one `funcref` table function values dispatch through, sized
// to every user function at its own wasm index (`gImports + i`), so a closure's stored id is
// its table slot — all of them, since the size is written before the bodies decide which fill.
function emitTableSection(n: i32) {
  const tabPayload: u8[] = []
  const tabPrev = wTarget(tabPayload)
  wULEB(1)            // 1 table
  wU8(112)            // 0x70 funcref element type
  wU8(0)              // limits flag 0x00: min only
  wULEB(gImports + n) // min: every user function, at its own index
  wTarget(tabPrev)
  wSection(4, tabPayload)
}

// The memory section (id 5): one module-defined memory, its limits from `emitMemoryLimits`.
// Emitted only when a memory intrinsic is used and the host does not import the memory.
function emitMemorySection() {
  const memPayload: u8[] = []
  const memPrev = wTarget(memPayload)
  wULEB(1) // 1 memory
  emitMemoryLimits()
  wTarget(memPrev)
  wSection(5, memPayload)
}

// The start section (id 8): names `startFnIdx`, the synthetic start function that runs the
// non-const global initializers once at instantiation, before any export is callable.
function emitStartSection(startFnIdx: i32) {
  const startPayload: u8[] = []
  const stPrev = wTarget(startPayload)
  wULEB(startFnIdx)
  wTarget(stPrev)
  wSection(8, startPayload)
}

// The element section (id 9): one active segment per run of address-taken functions, filling
// entry `gImports + i` with function `i`, or its thunk when `i` has no env param, so
// `call_indirect` needs no translation. Other entries stay null: `markFnAddrTaken` records the
// one site that mints an id, so no expression can call them. Omitted when none is taken.
function emitElementSection(n: i32) {
  const elemRuns = fnAddrTakenRuns(n)
  if elemRuns > 0 {
    const elemPayload: u8[] = []
    const elPrev = wTarget(elemPayload)
    wULEB(elemRuns)
    let di = elemNextTaken(0, n)
    while di < n {
      const de = elemRunEnd(di, n)
      wU8(0)         // flags 0x00: active, table 0, offset expr + func-index vec
      wU8(65)        // 0x41 i32.const — the offset expr
      wSLEB(gImports + di)
      wU8(11)        // 0x0b end
      wULEB(de - di) // count of table entries this run writes
      while di < de {
        wULEB(tableEntryFnIdx(di)) // func index (imports occupy 0..gImports-1)
        di = di + 1
      }
      di = elemNextTaken(di, n)
    }
    wTarget(elPrev)
    wSection(9, elemPayload)
  }
}

// `emitModule`'s shared-helper index assignment: resets every `gHelp*` index, then gives each
// helper the program enables the next function index from `helpBase` on. Returns how many it
// assigned.
function assignSharedHelperIndices(helpBase: i32) {
  // ── shared runtime helpers (module-tail functions) ──
  // Assigns each enabled helper the next function index after the start fn and the `__log__`
  // decoder (so no other index shifts), in a fixed order keyed only on type-presence flags —
  // deterministic per program, so the self-compile fixpoint converges. An enabled-but-uncalled helper costs a few dozen bytes, never correctness.
  gHelpStrHash = -1
  gHelpStrEq = -1
  gHelpStrConcat = -1
  gHelpUtf8Dec = -1
  gHelpUtf8Enc = -1
  gHelpUtf8CpLen = -1
  gHelpStrBytes = -1
  gHelpMapProbe = -1
  gHelpMapProbeI32 = -1
  gHelpMapResize = -1
  gHelpMapResizeI32 = -1
  gHelpF64Rem = -1
  let nHelpers = 0
  if aUsed {
    gHelpStrHash = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpStrEq = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpStrConcat = helpBase + nHelpers
    nHelpers = nHelpers + 1
    // The UTF-8 codec trio, AFTER the string trio so a program's existing helper indices
    // are unmoved by Stage 2c. Same `aUsed` gate and same "enabled-but-uncalled costs a
    // few dozen bytes, never correctness" trade the trio above documents.
    gHelpUtf8Dec = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpUtf8Enc = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpUtf8CpLen = helpBase + nHelpers
    nHelpers = nHelpers + 1
    // `s.bytes()` needs the packed pair to exist, so unlike its three neighbours it is gated on
    // `ba8Used` too — `bl8TypeIdx` is 0 when unminted, and a helper naming it would collide with heap type 0.
    if ba8Used {
      gHelpStrBytes = helpBase + nHelpers
      nHelpers = nHelpers + 1
    }
  }
  if mUsed {
    gHelpMapProbe = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpMapResize = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // The i32-KEYED probe and resize, LAST so no existing helper index moves in a program
  // without one: the i32-keyed index is the pair layout, which neither string helper reads.
  // The i64-keyed rep resizes over the same pairs, so it mints this pair too.
  if mI32Used || mI64Used {
    gHelpMapProbeI32 = helpBase + nHelpers
    nHelpers = nHelpers + 1
    gHelpMapResizeI32 = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  gHelpMapProbeI64 = -1
  if mI64Used {
    gHelpMapProbeI64 = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // The float remainder helper (D1586), last for the reason its neighbour above gives: no
  // existing helper index moves in a program without one. It is the first helper gated on
  // neither `aUsed` nor a map flag — a float program touches no string and no map.
  if gNeedsF64Rem {
    gHelpF64Rem = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // The delete family (D2315), last for the same reason, and only in a module that deletes: a
  // map nothing deletes from never has a dead entry, so it never compacts and no walk resyncs.
  // One compaction helper per map shape, since each names its shape's heap types.
  gHelpMapResync = -1
  gHelpMapCompact = []
  if gMapDeletes && mUsed {
    gHelpMapResync = helpBase + nHelpers
    nHelpers = nHelpers + 1
    let ck = 0
    while ck < mvMapTypeIdx.length + 3 {
      if mapShapeCompactable(mapCompactRowShape(ck)) {
        gHelpMapCompact.push(helpBase + nHelpers)
        nHelpers = nHelpers + 1
      } else {
        gHelpMapCompact.push(-1)
      }
      ck = ck + 1
    }
  }
  // The read-before-init trap (D2652), last for the same reason.
  gHelpInitFail = -1
  gInitGIdx = []
  gInitGNames = []
  gInitGLocs = []
  gInitReaders = []
  if gInitAny {
    gHelpInitFail = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // The scalar list views (D3028), last for the same reason: a maker per pair, then a sync,
  // element and length helper per destination.
  svReserve()
  let svp = 0
  while svp < 3 {
    if svPairOn(svp) {
      gHelpSvMk[svp] = helpBase + nHelpers
      nHelpers = nHelpers + 1
    }
    svp = svp + 1
  }
  let svd = 0
  while svd < 2 {
    if svDstOn(svd) {
      gHelpSvSync[svd] = helpBase + nHelpers
      gHelpSvGet[svd] = helpBase + nHelpers + 1
      gHelpSvLen[svd] = helpBase + nHelpers + 2
      nHelpers = nHelpers + 3
    }
    svd = svd + 1
  }
  // The record-list views (D3041), after them: a sync, an element and a length helper.
  gHelpRvSync = -1
  gHelpRvGet = -1
  gHelpRvLen = -1
  if rvWanted() {
    gHelpRvSync = helpBase + nHelpers
    gHelpRvGet = helpBase + nHelpers + 1
    gHelpRvLen = helpBase + nHelpers + 2
    nHelpers = nHelpers + 3
  }
  // The `as!` reason (SP-056), after them.
  gHelpAsFail = -1
  if gNeedsAsFail {
    gHelpAsFail = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // `__str_from_bytes__` (D4784), after them.
  gHelpStrFromBytes = -1
  if gNeedsStrFromBytes {
    gHelpStrFromBytes = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // `__str_fill__`, after them, only when the pool has a segment to fill from.
  gHelpStrFill = -1
  if gStrFillSeg >= 0 {
    gHelpStrFill = helpBase + nHelpers
    nHelpers = nHelpers + 1
  }
  // The map store helpers reserve only a functype per shape here. Each takes a function index,
  // after every helper above and before the thunks, when a set site first calls it, so a shape
  // no site sets costs a functype and no body. An optimised build reserves none, so every set
  // stores inline where binaryen can scalarise the map.
  gMapSetTy = []
  gMapSetFn = []
  gTailFnRows = []
  gMapSetTyN = 0
  gMapSetTyBase = 0
  gMapSetFnBase = 0
  let sr = 0
  while sr < mvMapTypeIdx.length + 3 {
    if gOptimized == 0 && mapSetRowable(mapCompactRowShape(sr)) {
      gMapSetTy.push(gMapSetTyN)
      gMapSetTyN = gMapSetTyN + 1
    } else {
      gMapSetTy.push(-1)
    }
    gMapSetFn.push(-1)
    sr = sr + 1
  }
  // The struct compare helpers likewise reserve only a functype per qualifying row here.
  eqHelpReserve()
  nHelpers
}

// Whether map shape `sh` has every heap type and shared helper its store helper names.
function mapSetRowable(sh: i32): boolean {
  if !mapShapeCompactable(sh) { return false }
  const k = mapShapeKeyKind(sh)
  if k == MAP_KEY_I32 { return gHelpMapProbeI32 >= 0 }
  if k == MAP_KEY_I64 { return gHelpMapProbeI64 >= 0 && gHelpMapProbeI32 >= 0 }
  gHelpMapProbe >= 0 && gHelpStrHash >= 0
}

// ── emitProgram pass manager ──
// The front half of `emitProgram` is a sequence of ordered passes over the arena. Each pass
// table row names its pass and the passes it needs, rows run top to bottom, and the driver
// asserts every prerequisite has already run before dispatching — so a reordered table fails loudly instead of miscompiling.

// One pass-table row. A `#2` name is the re-run stage of the pass it shares a function with.
type EmitPass = "deadTailDrop"
  | "loopValueRewrite"
  | "nulScalarSplit"
  | "foldMemShared"
  | "shadowRespell"
  | "collectTyParams"
  | "collectU"
  | "collectS"
  | "collectA"
  | "assignValueSpill"
  | "collectFns"
  | "checkTopLevel"
  | "buildFnMap"
  | "computeVoidFns"
  | "computeRetInference"
  | "dispatchRewrite"
  | "captureBoxRewrite"
  | "synthRetAnnots"
  | "synthNulListRetAnns"
  | "scanArrLitCommit"
  | "monomorphize"
  | "collectGenAliasShapes"
  | "collectAnnShapes"
  | "collectA#2"
  | "collectArrNewFrames"
  | "synthGlobalEmptyListAnns"
  | "synthVoidTwins"
  | "synthExternValues"
  | "synthRecEqCores"
  | "buildFnMap#2"
  | "synthParamAnnots"
  | "computeVoidFns#2"
  | "synthCaptureReadAnns"
  | "computeRetInference#2"
  | "collectMapFilterUse"
  | "collectFnValUse"
  | "collectCloSigs"
  | "initGuardScan"
  | "scanPrintUse"
  | "capCacheBuild"
  | "synthCaptureEmptyListAnns"
  | "scanExprArmLocals"
  | "cloLiftScan"

type PassRow = { pass: EmitPass, needs: EmitPass[] }

// True if every pass in `needs` is in `done`, the passes run so far.
function passNeedsMet(needs: EmitPass[], done: EmitPass[]): boolean {
  for n in needs {
    let found = false
    for d in done {
      if d == n { found = true }
    }
    if !found { return false }
  }
  true
}

// A module with no functions and no start statements is a module (D1080). The identical file
// imported by a program that uses its types compiles and runs, so a declarations-only module
// is legal — refusing it here is a clause-2 violation on a `vl check`-clean program. An
// empty wasm module is valid and every section here is already gated on having something to write, so this pass enforces nothing — it stays as a table row for the ordering edge `collectFns` declares.
function passCheckTopLevel() { 0 }

// Records `name` as mentioned at top-level position `ord`; `seen[name]` ORs `bits`: 1 once an
// identifier names it, 2 once one is an assignment's target, 0 for a member name. The first mention reaches every
// `fnStmts` slot declared under that name and queues it for its own walk (`initGuardScan`),
// except a nested one: its body is walked inside its enclosing function, in that scope.
function igMention(
  name: string,
  bits: i32,
  ord: i32,
  seen: Map<string, i32>,
  head: Map<string, i32>,
  next: i32[],
  work: i32[],
) {
  const had = seen.has(name)
  seen[name] = (seen[name] ?? 0) | bits
  if had { return 0 }
  let p = head[name] ?? -1
  while p >= 0 && p < gInitFnReach.length && p < next.length {
    if gInitFnReach[p] == INIT_REACH_NEVER {
      gInitFnReach[p] = ord
      if p >= fnParent.length || fnParent[p] < 0 { work.push(p) }
    }
    p = next[p]
  }
  0
}

// The names a parameter or local in scope binds during `igWalk`: a stack, for restoring on
// return, and a count per name, so a lookup does not scan every binding in scope (D2872).
type IgShadow = { names: string[], live: Map<string, i32> }

function igShadowHas(s: IgShadow, name: string): boolean {
  (s.live[name] ?? 0) > 0
}

function igShadowPush(s: IgShadow, name: string) {
  s.names.push(name)
  s.live[name] = (s.live[name] ?? 0) + 1
  0
}

// Unbinds every name pushed since the stack held `mark` names.
function igShadowPop(s: IgShadow, mark: i32) {
  while s.names.length > mark {
    const name = s.names.pop() ?? ""
    s.live[name] = (s.live[name] ?? 0) - 1
  }
  0
}

// Mentions every identifier, member name and nested function name under `ix` at `ord`,
// except an identifier a parameter or local in scope binds (`shadow`, restored on return).
// A `let` binds for the statements after it in its block; a loop variable, for its body.
function igWalk(
  ix: i32,
  ord: i32,
  shadow: IgShadow,
  seen: Map<string, i32>,
  head: Map<string, i32>,
  next: i32[],
  work: i32[],
) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  const mark = shadow.names.length
  if n is Ident {
    if !igShadowHas(shadow, n.identName) {
      igMention(n.identName, 1, ord, seen, head, next, work)
    }
    return 0
  }
  if n is FuncDecl {
    igMention(n.fnName, 0, ord, seen, head, next, work)
    // A default is substituted at the call site, so it reads the caller's scope.
    let pi = 0
    while pi < n.fnParams.length {
      igWalk(n.fnParams[pi], ord, shadow, seen, head, next, work)
      pi = pi + 1
    }
    pi = 0
    while pi < n.fnParams.length {
      const pn = nodeAt(n.fnParams[pi])
      if pn is Param { igShadowPush(shadow, pn.parName) }
      pi = pi + 1
    }
    igWalk(n.fnBody, ord, shadow, seen, head, next, work)
  } else if n is Block {
    let si = 0
    while si < n.blkStmts.length {
      igWalk(n.blkStmts[si], ord, shadow, seen, head, next, work)
      const sn = nodeAt(n.blkStmts[si])
      if sn is LetDecl { igShadowPush(shadow, sn.letName) }
      si = si + 1
    }
  } else if n is ForRange {
    igWalk(n.frFrom, ord, shadow, seen, head, next, work)
    igWalk(n.frTo, ord, shadow, seen, head, next, work)
    igWalk(n.frStep, ord, shadow, seen, head, next, work)
    igShadowPush(shadow, n.frVar)
    igWalk(n.frBody, ord, shadow, seen, head, next, work)
  } else if n is ForIn {
    igWalk(n.fiIter, ord, shadow, seen, head, next, work)
    igShadowPush(shadow, n.fiVar)
    if n.fiVar2 != "" { igShadowPush(shadow, n.fiVar2) }
    igWalk(n.fiBody, ord, shadow, seen, head, next, work)
  } else {
    if n is Member { igMention(n.memProp, 0, ord, seen, head, next, work) }
    if n is OptMember { igMention(n.omProp, 0, ord, seen, head, next, work) }
    if n is BinExpr {
      if n.binOp == "=" {
        const lhs = nodeAt(n.binLeft)
        if lhs is Ident {
          if !igShadowHas(shadow, lhs.identName) {
            igMention(lhs.identName, 2, ord, seen, head, next, work)
          }
        }
      }
    }
    const kids = nodeChildren(ix)
    let k = 0
    while k < kids.length {
      igWalk(kids[k], ord, shadow, seen, head, next, work)
      k = k + 1
    }
  }
  igShadowPop(shadow, mark)
  0
}

// Whether global `gi`'s value arrives only at run time, or its initializer builds a record or
// list (an early read reaches the object itself): one with no initializer gets it from its first
// assignment, a start-function initializer when it runs (`globalRunsInStartFn`), and a folded
// constant expression keeps the guard its start-function store had.
function igInitAllocates(gi: i32): boolean {
  if gi < 0 || gi >= globalStmts.length { return false }
  const init = igLetInit(globalStmts[gi])
  if init < 0 { return globalIsNonConst(globalStmts[gi]) }
  const e = nodeAt(unwrapParen(init))
  if e is ArrayLit { return true }
  if e is ObjLit { return true }
  const d = nodeAt(globalStmts[gi])
  if d is LetDecl {
    if letInitFoldsExpr(d) { return true }
  }
  globalRunsInStartFn(gi)
}

// The initializer of module binding `letIx`, or -1 when it has none.
function igLetInit(letIx: i32): i32 {
  const d = nodeAt(letIx)
  if d is LetDecl { return d.letInit }
  -1
}

// Decides which module globals need the read-before-init guard (D2652): a global whose
// initializer runs in the start function, or builds a record or list, and whose name is mentioned
// by top-level code at or before its declaration, or by a function that code can call (1); a
// folded scalar or string `let` so assigned (2).
function initGuardScan(): i32 {
  gInitGuard = []
  gInitFnReach = []
  gInitAny = false
  gInitProgIdx = -1
  gInitStartOrd = -1
  initAtCompute()
  let anyCand = false
  let gi = 0
  while gi < globalStmts.length {
    gInitGuard.push(0)
    // A folded `let` is a candidate too (a write can still precede it), and so is a folded
    // record or list, which a mutation can reach early.
    const cd = nodeAt(globalStmts[gi])
    if cd is LetDecl {
      if (
        cd.letKw == "let"
        || globalIsNonConst(globalStmts[gi])
        || igInitAllocates(gi)
      ) {
        anyCand = true
      }
    }
    gi = gi + 1
  }
  const next: i32[] = []
  const head: Map<string, i32> = Map()
  let p = 0
  while p < fnStmts.length {
    gInitFnReach.push(INIT_REACH_NEVER)
    next.push(-1)
    const fd = nodeAt(fnStmts[p])
    if fd is FuncDecl {
      next[p] = head[fd.fnName] ?? -1
      head[fd.fnName] = p
    }
    p = p + 1
  }
  if !anyCand { return 0 }
  const seen: Map<string, i32> = Map()
  const work: i32[] = []
  const shadowLive: Map<string, i32> = Map()
  const shadow: IgShadow = { names: [], live: shadowLive }
  gi = 0
  let si = 0
  let oc = 0
  while gi < globalStmts.length || si < startStmts.length {
    let takeGlobal = gi < globalStmts.length
    if takeGlobal && si < startStmts.length {
      if startStmtOrd[si] < globalStmtOrd[gi] { takeGlobal = false }
    }
    let node = -1
    let ord = 0
    if takeGlobal {
      node = globalStmts[gi]
      ord = globalStmtOrd[gi]
    } else {
      node = startStmts[si]
      ord = startStmtOrd[si]
    }
    igWalk(node, ord, shadow, seen, head, next, work)
    while work.length > 0 {
      const wp = work.pop() ?? -1
      if wp >= 0 && wp < fnStmts.length {
        igWalk(fnStmts[wp], ord, shadow, seen, head, next, work)
      }
    }
    while oc < gInitOrder.length && gInitAt[gInitOrder[oc]] <= ord {
      igSettle(gInitOrder[oc], seen)
      oc = oc + 1
    }
    if takeGlobal { gi = gi + 1 } else { si = si + 1 }
  }
  while oc < gInitOrder.length {
    igSettle(gInitOrder[oc], seen)
    oc = oc + 1
  }
  for g in gInitOrder {
    if gInitGuard[g] >= 1 && gInitAt[g] != INIT_REACH_NEVER {
      gInitProgAfter[gInitAt[g]] = g
    }
  }
  0
}

// Decides global `gi`'s guard once top-level code up to `gInitAt[gi]` has been walked: 1 when a
// name `seen` holds read it before then and its value arrives only at run time, 2 when a folded
// `let` is assigned before then, since it holds its value from instantiation.
function igSettle(gi: i32, seen: Map<string, i32>) {
  if gi < 0 || gi >= globalStmts.length || gi >= gInitGuard.length { return 0 }
  const g = nodeAt(globalStmts[gi])
  if g is LetDecl {
    const bits = seen[g.letName] ?? 0
    if (bits & 1) != 0 && igInitAllocates(gi) {
      gInitGuard[gi] = 1
      gInitAny = true
    } else if (g.letKw == "let" && g.letInit >= 0 && (bits & 2) != 0) {
      gInitGuard[gi] = 2
      gInitAny = true
    }
  }
  0
}

// Fills `gInitAt`, `gInitAtNode`, `gInitOrder` and `gInitRank`. A binding with no initializer
// takes the position of the statement `daTopAssignedAt` names for it.
function initAtCompute() {
  gInitAt = []
  gInitAtNode = []
  gInitOrder = []
  gInitRank = []
  gInitProgAfter = Map()
  const ordOf: Map<i32, i32> = Map()
  let si = 0
  while si < startStmts.length && si < startStmtOrd.length {
    ordOf[startStmts[si]] = startStmtOrd[si]
    si = si + 1
  }
  let gi = 0
  while gi < globalStmts.length && gi < globalStmtOrd.length {
    ordOf[globalStmts[gi]] = globalStmtOrd[gi]
    gi = gi + 1
  }
  gi = 0
  while gi < globalStmts.length {
    let node = globalStmts[gi]
    let at = ordOf[node] ?? INIT_REACH_NEVER
    if igLetInit(node) < 0 && globalIsNonConst(node) {
      node = daTopAssignedAt[globalStmts[gi]] ?? globalStmts[gi]
      at = ordOf[node] ?? INIT_REACH_NEVER
      if node == globalStmts[gi] { at = INIT_REACH_NEVER }
    }
    gInitAt.push(at)
    gInitAtNode.push(node)
    gInitRank.push(0)
    // By position, then declaration order: only the bindings with no initializer move.
    gInitOrder.push(gi)
    let k = gInitOrder.length - 1
    while k > 0 && gInitAt[gInitOrder[k - 1]] > at {
      gInitOrder[k] = gInitOrder[k - 1]
      k = k - 1
    }
    gInitOrder[k] = gi
    gi = gi + 1
  }
  let r = 0
  while r < gInitOrder.length {
    gInitRank[gInitOrder[r]] = r
    r = r + 1
  }
  0
}

// What `scanPrintUse`'s node walk saw: a wide-scalar mention of each width, a float `%`, and
// a `%` with no recorded type.
type PrintScanSaw = {
  sawI64Ann: boolean,
  sawF64: boolean,
  sawF32: boolean,
  sawFloatRem: boolean,
  sawRemUnknown: boolean,
}

// Assigns the import indices `scanPrintUse` reserves after its node walk: the extern result
// widths join `saw`, then the wide-scalar prints, the fs floor and the user externs in order.
function scanPrintAssignImports(saw: PrintScanSaw) {
  // An extern's own RESULT width is a scalar the annotation scan cannot see: `print(nowMillis())`
  // spells `i64` nowhere, and without this the print router would call an undeclared import.
  // Read off the manifest, which is total, exactly as `fsRetIsI64` is for the fs floor.
  let exw = 0
  while exw < externCount() {
    const exwR = externRetAt(exw)
    if exwR == "i64" { saw.sawI64Ann = true }
    if exwR == "f64" { saw.sawF64 = true }
    if exwR == "f32" { saw.sawF32 = true }
    exw = exw + 1
  }
  // When the program both prints (`gImports == 4`, the print family) and names
  // an i64 type, add the 5th `__print_i64__` import.
  if gImports == 4 {
    if saw.sawI64Ann {
      gImports = gImports + 1
      gNeedsI64Print = true
    }
    // Then `__print_f64__` (at the next index — 4 or 5). The f64 import always
    // trails the i64 one so the i64 print index (4) is unchanged. (Slice 3.)
    if saw.sawF64 {
      gF64PrintIdx = gImports
      gImports = gImports + 1
      gNeedsF64Print = true
    }
    // Then `__print_f32__` (at the next index — 4/5/6). It always TRAILS the i64 and
    // f64 imports so their indices are unchanged. (Slice 5.)
    if saw.sawF32 {
      gF32PrintIdx = gImports
      gImports = gImports + 1
      gNeedsF32Print = true
    }
  }
  // The fs imports trail the entire print family — the four fixed entries and all three
  // conditional wide-scalar ones — so no print index ever moves, and within the block they run
  // in slot order over the used slots only (slots are append-only, so adding a syscall never
  // moves an earlier one's index). Outside the `gImports == 4` guard on purpose: by the time this runs `gImports` is 4..7, not 4.
  let fsa = 0
  while fsa < gFsUse.length {
    if gFsUse[fsa] == 1 {
      gFsIdx[fsa] = gImports
      gImports = gImports + 1
    }
    fsa = fsa + 1
  }
  // The user externs trail everything: the print family (whose 0..3 the call lowering hardcodes)
  // and the fs floor. An extern occupies an index, so a program that declares one but does not
  // print still reserves the four print entries — every host provides them already.
  if externCount() > 0 {
    if gImports == 0 { gImports = 4 }
    let exa = 0
    while exa < externCount() {
      gExtIdx[exa] = gImports
      gImports = gImports + 1
      exa = exa + 1
    }
  }
  0
}

// `scanPrintUse`'s first step: every flag and table the scan writes, back to its empty state.
function scanPrintReset() {
  gImports = 0
  mapDeleteReset()
  gNeedsI64Print = false
  gNeedsF64Print = false
  gF64PrintIdx = 0
  gNeedsF32Print = false
  gF32PrintIdx = 0
  memUsed = false
  memLogUsed = false
  gHeapUsed = false
  // The fs tables are rebuilt from scratch, never patched: `scanPrintUse` is the single
  // writer and it runs once per module, so a stale row from a previous compile in the
  // same process would silently declare an import the program never calls.
  gFsUse = []
  gFsIdx = []
  let fsr = 0
  while fsr < fsIntrinsicCount() {
    gFsUse.push(0)
    gFsIdx.push(-1)
    fsr = fsr + 1
  }
  // The extern manifest is the import list, so every row is reserved whether or not the program
  // calls it: the declaration is the contract the host must satisfy, which is the whole point of
  // routing it through the import section (extern-design.md §3).
  gExtIdx = []
  let exr = 0
  while exr < externCount() {
    gExtIdx.push(-1)
    exr = exr + 1
  }
  0
}

// Detects `print(...)`/memory-intrinsic use anywhere in the program: any print pulls in the
// 4-import print family (imports shift every local function's wasm index, so this is decided
// up front). "Any print" is the property, not the spelling `print(` — three constructs lower
// to a `__print_*__` import (`print(...)`, `__log__(...)`, `__trap__(<string>)`); a fourth missed here is invalid wasm that `vl check` passes. Grep `fbCall(0)`..`fbCall(4)` before adding one.
function scanPrintUse() {
  scanPrintReset()
  let pscan = 0
  // D1586 — the `__f64_rem__` reservation, on the same terms as the import reservation this
  // pass exists for: a helper INDEX cannot be discovered mid-emit either. `sawFloatRem` is a
  // `%` the checker recorded at a float type; `sawRemUnknown` is a `%` with no recorded type
  // at all, which only counts once the module is known to mention a float.
  const saw: PrintScanSaw = {
    sawI64Ann: false,
    sawF64: false,
    sawF32: false,
    sawFloatRem: false,
    sawRemUnknown: false,
  }
  while pscan < P.nodes.length {
    const pn = nodeAt(pscan)
    // Any node the checker typed at a wide scalar, at any depth of its type, flags that width:
    // a value built or read, an annotation, a cast target. An unused import is harmless, a
    // missed one is invalid wasm (D14489).
    const nscal = repNodeScalarMask(pscan)
    if nscal > 0 {
      if (nscal & REP_SCAL_I64) != 0 { saw.sawI64Ann = true }
      if (nscal & REP_SCAL_F64) != 0 { saw.sawF64 = true }
      if (nscal & REP_SCAL_F32) != 0 { saw.sawF32 = true }
    }
    // A map an `is` or `as` names joins its struct's tag family even where no union arm is
    // that map, so a pin whose union lacks it cannot answer with a twin's tag (D2493).
    if pn is IsExpr { mapTwinNotePattern(isVarTyIxOf(pscan)) }
    // And a map an expression's union type holds, where a spelling that collapses (`A | B` over
    // two equal maps) registered no union row for it.
    mapTwinNoteUnionTy(nodeTyIxOf(pscan))
    if pn is AsExpr { mapTwinNotePattern(nodeTyIxOf(pscan)) }
    // A shared field read over a record union whose members store the field at different
    // atoms is the box of their join, which nothing else in the program may spell (D3562).
    if pn is Member { registerSharedReadUnion(pscan, pn.memObj) }
    // D1041 — the numeric exact-or-fail cast, both halves this pass is for. (1) `as!` streams its
    // reason before the abort, through the same two imports `__trap__("reason")` uses, so it
    // reserves the print family exactly as that call does. (2) `as?` yields `T | null`, a
    // value-union box, and this is the only place in the program that spelling exists, so registering here is the only route that can ever mint the box heap type.
    if pn is AsExpr {
      // D1517 — and the operand axis is not a type axis. `asExprNumFallible` declines a union
      // operand by construction, so `u as? i32` over `i32 | string` reaches neither rung and its
      // `i32|null` row never mints, while the same program carrying an `i32 | null` annotation
      // anywhere runs. The registration is the node's own recorded result type; `registerValueUnionName` is self-gating on `isValueUnionName`, so `string|null`/`boolean|null` are no-ops.
      if pn.asMode == "null" {
        const asTy = nodeTyIxOf(pscan)
        const asVn = valueUnionNameOfTy(asTy)
        if asVn != "" { registerValueUnionNameAB(50, asVn, asTy) }
      }
      if asExprNumFallible(pscan) || asExprHoleNumSad(pscan) {
        if pn.asMode == "trap" {
          gImports = 4
          gNeedsAsFail = true
        }
        if pn.asMode == "null" {
          registerValueUnionNameAB(
            65,
            asExprNumTgtName(pscan) + "|null",
            nodeTyIxOf(pscan),
          )
        }
      }
    }
    if pn is Call && pn.callFn >= 0 {
      const pcallee = nodeAt(pn.callFn)
      if pcallee is Ident {
        scanPrintCallIntrinsic(pcallee.identName, pn.callArgs.length)
      }
      // `s.bytes()` yields a `u8[]`. It is the one producer of a packed byte list that spells no
      // `u8[]` anywhere — the annotation scan matches a type, and `for b in s.bytes()` has none — so
      // without this the `ba8`/`bl8` pair is never minted and `struct.new $bl8` names a heap type
      // that does not exist. Matched on the property name alone, deliberately: over-forcing is a pair of unused 3-byte types, under-forcing is invalid wasm.
      if pcallee is Member {
        if pcallee.memProp == "bytes" { ba8Used = true }
        // Any `.delete(…)` reserves the map delete family and the i64 array its sequences use
        // (D2315); matched on the name alone, since over-reserving costs unused helpers and a
        // miss only forgoes compaction.
        if pcallee.memProp == "delete" {
          mapDeleteNote(pscan)
          ia64Used = true
        }
      }
    }
    // A FLOAT `%` reserves the `__f64_rem__` helper (D1586). The node's own recorded type
    // decides it: `%` yields the WIDER operand's type, so a float result is exactly a float
    // operand. `binRemFloatNeed` is the three-answer vocabulary, its own header says why.
    if pn is BinExpr {
      if pn.binOp == "%" {
        const rneed = binRemFloatNeed(pscan)
        if rneed > 0 { saw.sawFloatRem = true }
        else if rneed < 0 { saw.sawRemUnknown = true }
      }
      if pn.binOp == "==" || pn.binOp == "!=" {
        if (
          nodeTyPrimName(pn.binLeft) == ""
          && nodeTyPrimName(pn.binRight) == ""
        ) {
          gSawEqOp = true
        }
      }
    }
    pscan = pscan + 1
  }
  // D1586 — the float-remainder helper. A `%` with no recorded type is only counted when
  // the module mentions a float somewhere, which is what keeps an integer-only program's
  // bytes unchanged; the flags this reads are final only now, hence after the loop.
  gNeedsF64Rem = saw.sawFloatRem
    || (saw.sawRemUnknown && (saw.sawF64 || saw.sawF32))
  // A guarded global read streams its reason through the print pair before the abort, as
  // `as!` does, so a program with one reserves the family (D2652).
  if gInitAny { gImports = 4 }
  mapDeleteMerge()
  scanPrintAssignImports(saw)
  0
}

// `scanPrintUse`'s arm for a call of the identifier `name` with `nArgs` arguments: reserves the
// imports, memory and helpers the intrinsic it names needs. The width of a scalar it yields is
// its call node's recorded type, which the scan reads for every node.
function scanPrintCallIntrinsic(name: string, nArgs: i32) {
  if name == "print" { gImports = 4 }
  // The linear-memory intrinsics: any store/load forces the module-defined
  // memory; `__log__` additionally forces the synthetic decoder function,
  // which prints through `__print_i32__` — so it pulls in the print-import
  // family exactly as a `print(...)` call does.
  if (name == "__store_i32__" || name == "__load_i32__") { memUsed = true }
  // The five other store widths force the memory exactly as `__store_i32__` does. They add
  // nothing to the print-import scan below, and that is a decision: a store consumes a scalar
  // and yields none, so it can never route a `print` to an undeclared import. Membership, not a spelling: a width added to `nameIsMemStoreIntrinsic` forces the memory here the same day.
  if nameIsMemStoreIntrinsic(name) { memUsed = true }
  // The load-width matrix forces the memory exactly as `__load_i32__` does.
  if nameIsMemLoadIntrinsic(name) { memUsed = true }
  // The bulk pair forces the memory for the same reason, generalised: `memory.copy`/
  // `memory.fill` are instructions on the memory, so a program whose only contact with linear
  // memory is `__memory_fill__(0, 0, 4)` still needs section 5 emitted or the instruction names
  // a memory that does not exist. Both are void, so like the stores they add nothing to the print-import scan below.
  if nameIsMemBulkIntrinsic(name) { memUsed = true }
  // A SIMD load/store forces the module's memory exactly as `__load_i32__` does — a
  // `v128.load`/`store` names a memory that must exist.
  const srow = simdRow(name)
  if srow >= 0 {
    const ssig = simdRowSig(srow)
    if ssig == SIMD_SIG_LOAD || ssig == SIMD_SIG_STORE { memUsed = true }
  }
  // An atomic names the memory like `__load_i32__` (the fence alone does not).
  const arow = atomicRow(name)
  if arow >= 0 && atomicRowSig(arow) != ATOMIC_SIG_FENCE { memUsed = true }
  // The filesystem floor. Unlike every memory intrinsic above, these are host imports, so a use
  // here reserves a wasm function index — which is exactly why the reservation must happen in
  // this scan rather than at the call site: an extra import shifts every user function's index,
  // and the count cannot be discovered mid-emit. `gImports = 4` pulls in the print family first; the fs imports append after it, so the section every corpus golden pins is not rewritten.
  const fslot = fsIntrinsicSlot(name)
  if fslot >= 0 {
    gImports = 4
    if fslot < gFsUse.length { gFsUse[fslot] = 1 }
    if fsRetIsU8List(fslot) || fsArgIsU8List(fslot, 0) { ba8Used = true }
    // A slot that hands the host a linear-memory ADDRESS forces section 5 exactly as
    // `__memory_size__` below does: a program whose only memory contact is that call
    // would otherwise name a memory that does not exist — and the export the host
    // looks the memory up by would not be emitted.
    if fsSlotTouchesMemory(fslot) { memUsed = true }
  }
  // `memory.size` / `memory.grow` are instructions ON the memory: a program whose
  // ONLY memory contact is `__memory_size__()` still needs section 5 emitted, or
  // the instruction refers to a memory that does not exist and the module fails to
  // validate. Both are i32-valued, so neither touches the print-import scan.
  if (name == "__memory_size__" || name == "__memory_grow__") { memUsed = true }
  // The heap window is two globals a program pays for only when it reads one.
  if (name == "__heap_base__" || name == "__heap_limit__") { gHeapUsed = true }
  if name == "__log__" {
    memUsed = true
    memLogUsed = true
    gImports = 4
  }
  // `__trap__("reason")` streams its message through the same `__print_char__`/
  // `__print_str_flush__` pair `print(<string>)` uses, so it pulls in the 4-import print
  // family exactly as a `print(...)` call does — without an arm here the two streaming calls
  // land on user function indices, invalid wasm with `vl check` rc 0. Arity-gated: a bare `__trap__()` lowers to `unreachable` alone and streams nothing, so reserving for it would be four unused imports.
  if name == "__trap__" {
    if nArgs == 1 { gImports = 4 }
  }
  // `__str_from_bytes__` reserves its helper, and the packed pair and string types it names.
  if name == "__str_from_bytes__" {
    gNeedsStrFromBytes = true
    ba8Used = true
    aUsed = true
  }
  0
}

// The passes that may memoise `captureNamesOf`'s walk (D2017): each either leaves the arena and
// the tables `capScan` reads alone, or reports every edit that mints no node through
// `capMemoNoteEdit`. A pass joins only once that is true of everything it calls.
function passKeepsCaptures(name: string): boolean {
  if name == "dispatchRewrite" { return true }
  if name == "monomorphize" { return true }
  if name == "computeRetInference" { return true }
  if name == "computeRetInference#2" { return true }
  // Writes only `fRetVoid` and `tailSelfFnIx`, which no `capScan` path reads.
  name == "computeVoidFns" || name == "computeVoidFns#2"
}

// Dispatch one pass-table row, exhaustively over `EmitPass`. Every pass returns an i32 status (< 0 =
// failed emit). The `#2` rows are the explicit re-run stage — each branch calls
// the same pass function a second time, post-monomorphization.
function runEmitPass(name: EmitPass, stmts: i32[], rootIx: i32): i32 {
  match name {
    "foldMemShared" => {
      return foldMemShared()
    }
    "deadTailDrop" => {
      return deadTailDrop()
    }
    "loopValueRewrite" => {
      return loopValueRewrite(rootIx)
    }
    "nulScalarSplit" => {
      return nulScalarSplit(rootIx)
    }
    "collectTyParams" => {
      return collectTyParamNames()
    }
    "collectU" => {
      return collectU(stmts)
    }
    "collectS" => {
      return collectS(stmts)
    }
    "collectA" => {
      return collectA(stmts)
    }
    "shadowRespell" => {
      return shadowRespell(stmts)
    }
    "assignValueSpill" => {
      return assignValueSpill(stmts)
    }
    "collectFns" => {
      const nf = collectFns(stmts)
      linkLiftNote()
      return nf
    }
    "checkTopLevel" => {
      return passCheckTopLevel()
    }
    "buildFnMap" => {
      return buildFnMap(stmts)
    }
    "computeVoidFns" => {
      return computeVoidFns()
    }
    "computeRetInference" => {
      return computeRetInference()
    }
    "dispatchRewrite" => {
      return dispatchRewrite(stmts)
    }
    "captureBoxRewrite" => {
      return captureBoxRewrite(stmts)
    }
    "synthRetAnnots" => {
      return synthRetAnnots()
    }
    "synthNulListRetAnns" => {
      return synthNulListRetAnns()
    }
    "scanArrLitCommit" => {
      return scanArrLitCommit(rootIx)
    }
    "monomorphize" => {
      fnFlowShadowBuild(stmts)
      return monomorphize(stmts)
    }
    "collectGenAliasShapes" => {
      return collectGenAliasShapes()
    }
    "collectAnnShapes" => {
      return collectAnnShapes()
    }
    // Re-run stage: instance-pinned annotations minted during monomorphization (`Box<i32>`
    // applications, structural returns) postdate the first arena scans, so this rescans them and
    // refreshes the name→index tables that resolve against the struct table. All four are idempotent and usage-gated (no new `TypeRef` means no new shape means identical bytes).
    "collectA#2" => {
      return collectA(stmts)
    }
    "collectArrNewFrames" => {
      return collectArrNewFrames()
    }
    "synthGlobalEmptyListAnns" => {
      return synthGlobalEmptyListAnns()
    }
    "synthVoidTwins" => {
      return synthVoidTwins(stmts)
    }
    "synthExternValues" => {
      return synthExternValues()
    }
    "synthRecEqCores" => {
      return synthRecEqCores()
    }
    "buildFnMap#2" => {
      return buildFnMap(stmts)
    }
    "synthParamAnnots" => {
      return synthParamAnnots()
    }
    "computeVoidFns#2" => {
      return computeVoidFns()
    }
    "computeRetInference#2" => {
      return computeRetInference()
    }
    "collectMapFilterUse" => {
      return collectMapFilterUse()
    }
    "collectFnValUse" => {
      return collectFnValUse()
    }
    "collectCloSigs" => {
      return collectCloSigs()
    }
    "scanPrintUse" => {
      return scanPrintUse()
    }
    "initGuardScan" => {
      return initGuardScan()
    }
    "capCacheBuild" => {
      return capCacheBuild()
    }
    "synthCaptureEmptyListAnns" => {
      return synthCaptureEmptyListAnns()
    }
    "synthCaptureReadAnns" => {
      return synthCaptureReadAnns()
    }
    "scanExprArmLocals" => {
      return scanExprArmLocals()
    }
    "cloLiftScan" => {
      return cloLiftScan()
    }
  }
}

// ── the sid-keyed table reset — paired with `symbols.sidReset` at every site ──
// The driver calls this beside every `sidReset()`. `globalIndexBySid`/`fnIndexBySid` are
// rebuilt inside `emitProgram`, so between one program's end and the next's collect pass the
// rows are stale. A string-keyed table survived that (program N+1 had to reuse a spelling); a sid-keyed dense array collides on a number from 0, so the collision is close to certain.
export function sidKeyedTablesReset() {
  lbiArenaReset()
  // The hash-consed structural-identity table is sid-keyed too — `HC_PRIM` holds the
  // primitive keyword's sid and `HC_OBJ` its field names' — so it resets here, which is
  // what this function exists to be: the one home for that pairing.
  hcReset()
  globalIndexBySid = []
  fnIndexBySid = []
  uVariantRowBySid = []
  unRowBySid = []
  nestedNameBySid = []
  sidResetParentLet()
  sidResetStartBlockLet()
  rsResetUseIx()
  0
}

// `emitProgram`'s prologue: every per-compile table, scalar and memo back to its empty state,
// so nothing an earlier compile on a shared instance left can reach this one's passes.
function emitProgramReset(rootIx: i32) {
  // First, so no memo key carries an earlier compile's inputs into this one.
  memoCompileReset()
  // Every module's per-compile scalars back to their declared values (lane L7).
  emitStateReset()
  wasmEmitStateReset()
  bcReset()
  bignumReset()
  capMemoEditsReset()
  nfdReset()
  declStructIndexReset()
  isRecvStageReset()
  monoIsCopyReset()
  iisReset()
  mvShapeNestReset()
  printPlanReset()
  rewriteCountersReset()
  shapeRowsReset()
  tailSelfFnReset()
  monoStateReset()
  classifyStateReset()
  callResultTextsReset()
  // Must be per-compile, and is not (a filed hazard). `ba8Used` says this module mints the
  // packed-byte heap types; the indices it guards are recomputed every compile, so a
  // single-compile process never disagrees — but the LSP and the wasm test harness drive many
  // compiles through one instance, where the flag survives from an earlier program while the indices do not. Its siblings (`aUsed`, `fa64Used`, …) share the shape and are not reset; only this one has a witness.
  ba8Used = false
  fa32Used = false
  fa64Used = false
  ia64Used = false
  // Same per-compile rule as `ba8Used` above, and the same failure if it is skipped: the
  // helper INDEX is recomputed every compile while a surviving `true` would declare a
  // `__f64_rem__` this module's tail never emits. `scanPrintUse` writes it (D1586).
  gNeedsF64Rem = false
  gSawEqOp = false
  gNeedsAsFail = false
  gNeedsStrFromBytes = false
  mapDeleteReset()
  gFuncFixedN = 0
  gFuncEntries = []
  gFuncRopeAt = 0
  gGlobalFixedN = 0
  gGlobalRopeAt = 0
  // The hole instances' bindings are read by passes that run before `monomorphize` refills
  // them, so an earlier program's rows would name another arena's types (D2921).
  monoHoleSubRow = Map()
  bodyRebuiltFrom = Map()
  monoHoleSubN = []
  monoHoleSubT = []
  typeDeclNameIxReset()
  callsByCalleeReset()
  tyRegMemoReset()
  gaeDeclsReset()
  collectRegistersReset()
  // ── the arena-index sidecar reset (method note 7) ──
  // Every column below holds indices into the checker's `T.tys`, which a fresh program rebuilds
  // from scratch. Each also has its own reset inside the collect pass that clears the name
  // column it parallels, but a stale index dereferences into program N's re-minted arena and traps, where a stale name is merely wrong text — so these are emptied here, ahead of every pass.
  mvValTyIx = []        // map-VALUE type per mv slot        [collectA]
  rlElemTyIx = []       // ref-list ELEMENT type per slot    [collectA]
  annRlSlot = []        // ref-list ROW per annotation node  [collectA] — node ixs are
  annRlNul = []         // ...and that row's `| null` flag              stable, ROWS are not
  arrLitCommitName = [] // committed element name per ArrayLit [scanArrLitCommit]
  arrLitCommitAnn = []  // ...and its annotation node         [scanArrLitCommit]
  sTyIx = []            // arena type a struct ROW came from [collectS]
  sAnonOwnTy = Map()    // an anon row's minting literal type [collectS]
  sLitMintRow = Map()   // a literal's minted anon row     [collectS]
  sLitMintFn = Map()    // ...and the instance it minted in
  sRowDecl = []         // was the row DECLARED, banked at its mint [collectS]
  // Ordering already covers this one (`collectTyParams` is pass-table row 0), but the
  // column belongs with the other per-program sidecars for the reason this block's header
  // gives: the safety should be structural, not a property of the pass order.
  genTyParamNames = [] // FuncDecl type-parameter names  [collectTyParams]
  genTyParamSeen = 0   // ...and the arena prefix that list covers
  // `collectA`'s own resume state, cleared for the same reason: `caSeenNodes` is an arena
  // prefix and `caRlMark`/`caMvMark` are row counts, so on a shared instance each names the
  // program before this one. -1 makes the next call re-mint in full.
  caSeenNodes = -1
  caResumeArmed = false
  caSeenUnSets = -1
  caSeenUnNames = -1
  caSeenVariants = -1
  caSeenSNames = -1
  caSeenSFields = -1
  caSeenUFields = -1
  caSeenTyParams = -1
  caRlMark = 0
  caMvMark = 0
  // `buildFnMap`'s resume state, for the same reason: `fmSeenFns` is an `fnStmts` prefix, so
  // on a shared instance it names the program before this one. The row cache itself needs no
  // reset — the first call of a program is unarmed and re-mints it (B8 of the perf survey).
  fmSeenFns = -1
  fmResumeArmed = false
  fmSeenUnSets = -1
  fmSeenUnNames = -1
  fmSeenVariants = -1
  fmSeenSNames = -1
  fmSeenSFields = -1
  fmSeenUFields = -1
  fmSeenTyParams = -1
  sFieldElemTyIx = []    // a struct FIELD's element type     [collectS]
  uFieldElemTyIx = []    // a VARIANT field's element type    [collectU]
  sFieldElemKeyKind = [] // a struct FIELD's map KEY rep    [collectS]
  uFieldElemKeyKind = [] // a VARIANT field's map KEY rep   [collectU]
  unMemTyStart = []      // union MEMBER types per row        [collectU]
  unMemTyCount = []
  unMemTys = []
  unMemAtoms = []        // the member-REFERENCE columns      [collectU]
  unMemAtomIds = []
  unMemKinds = []
  msPoolReset()          // the member SETS interned over those columns
  // The if-expression arm blocks whose prelude locals the collect pass allocated. Arena node
  // indices, so it is the same hazard as the columns above and worse: a stale index that happens
  // to name a node in program N grants the emitter permission to lower a prelude with no allocated locals, claiming another binding's slot.
  armPreludeBlocks = Map()
  emitFailed = false
  emitErr = ""
  // Fresh per program: the diagnostic anchor + the "function being lowered"
  // cursor. A failure before any function body emits leaves these -1 (positionless).
  emitErrAt = -1
  emitCurFnIx = -1
  emitCurFnPos = -1
  emitCurStmtIx = -1
  // The VALIDATE diagnostic's function spans (D1578) — ARENA indices and offsets into
  // THIS program's module, so a row surviving onto the next program on a shared instance
  // would name another program's node at another module's offset.
  emitFnSpanNode = []
  emitFnSpanPos = []
  emitFnSpanStart = []
  emitFnSpanEnd = []
  emitFnSpanKind = []
  emitFnSpanTag = []
  // Back to the start of the timeline: the capture cache is only valid for a FINAL AST, and a
  // phase left by the previous program on a shared instance would arm every later-phase reader
  // over this program's whole pass table. See `EmitPhase`.
  emitPhase = "passes"
  capMemoArmed = false
  // The in-flight map-return stack holds `fnStmts` positions, the same arena-keyed index this
  // block exists to stop leaking across programs. It is push/pop-balanced
  // (`inferredRetMapSlot` has no early return), so it is already empty here; clearing it makes that a property of the reset rather than of every rung below it.
  resetRetMapFlight()
  // The module scope, for the classifiers that walk a SCOPE instead of the whole arena
  // (D661). Written here for the same reason every column above is cleared here: it is an
  // ARENA index, so a value surviving into the next program on a shared instance names a
  // node that program never minted.
  emitRootIx = rootIx
  stubWriteRhsReset()
  eqgCoresReset()
}

// The ordered pass table — see the pass-manager block comment above `EmitPass` for the row
// grammar. Each row's `needs` entry is an ordering edge, in three shapes: a pass that
// mutates the arena runs before every pass that scans it (`dispatchRewrite`,
// `captureBoxRewrite`, the synth-annotation passes, `monomorphize`); a pass needing a final arena runs after all of them; and a `#2` row re-scans what monomorphization's late-minted annotations invalidated.
function emitPassTable(): PassRow[] {
  const passTable: PassRow[] = [
    { pass: "deadTailDrop", needs: [] },
    {
      pass: "loopValueRewrite",
      needs: ["deadTailDrop"],
    },
    {
      pass: "nulScalarSplit",
      needs: ["loopValueRewrite"],
    },
    { pass: "foldMemShared", needs: [] },
    {
      pass: "shadowRespell",
      needs: ["foldMemShared", "nulScalarSplit"],
    },
    { pass: "collectTyParams", needs: [] },
    { pass: "collectU", needs: ["collectTyParams"] },
    {
      pass: "collectS",
      needs: ["collectU", "collectTyParams"],
    },
    {
      pass: "collectA",
      needs: ["collectS", "collectTyParams"],
    },
    {
      pass: "assignValueSpill",
      needs: ["shadowRespell"],
    },
    {
      pass: "collectFns",
      needs: [
        "collectU", "collectS", "shadowRespell", "assignValueSpill",
      ],
    },
    { pass: "checkTopLevel", needs: ["collectFns"] },
    { pass: "buildFnMap", needs: ["collectFns"] },
    { pass: "computeVoidFns", needs: ["buildFnMap"] },
    {
      pass: "computeRetInference",
      needs: ["buildFnMap", "computeVoidFns"],
    },
    {
      pass: "dispatchRewrite",
      needs: ["buildFnMap", "computeRetInference"],
    },
    {
      pass: "captureBoxRewrite",
      needs: ["collectFns"],
    },
    {
      pass: "synthRetAnnots",
      needs: ["collectU", "buildFnMap"],
    },
    {
      pass: "synthNulListRetAnns",
      needs: ["collectFns", "computeRetInference"],
    },
    {
      pass: "scanArrLitCommit",
      needs: ["collectU", "buildFnMap", "dispatchRewrite"],
    },
    {
      pass: "monomorphize",
      needs: [
        "dispatchRewrite", "captureBoxRewrite", "synthRetAnnots",
        "synthNulListRetAnns", "scanArrLitCommit",
      ],
    },
    {
      pass: "collectGenAliasShapes",
      needs: ["monomorphize"],
    },
    {
      pass: "collectAnnShapes",
      needs: ["monomorphize"],
    },
    {
      pass: "collectA#2",
      needs: ["collectGenAliasShapes", "collectAnnShapes"],
    },
    {
      pass: "collectArrNewFrames",
      needs: ["collectA#2", "collectFns", "monomorphize"],
    },
    {
      pass: "synthGlobalEmptyListAnns",
      needs: ["collectA#2", "collectFns"],
    },
    {
      pass: "synthVoidTwins",
      needs: ["collectFns", "monomorphize"],
    },
    {
      pass: "synthExternValues",
      needs: ["collectFns", "monomorphize"],
    },
    {
      pass: "synthRecEqCores",
      needs: ["collectA#2", "collectFns", "monomorphize"],
    },
    {
      pass: "buildFnMap#2",
      needs: [
        "monomorphize", "collectA#2", "synthVoidTwins", "synthExternValues",
        "synthRecEqCores",
      ],
    },
    {
      pass: "synthParamAnnots",
      needs: ["monomorphize", "buildFnMap#2"],
    },
    {
      pass: "computeVoidFns#2",
      needs: ["synthParamAnnots"],
    },
    {
      pass: "synthCaptureReadAnns",
      needs: ["synthParamAnnots"],
    },
    {
      pass: "computeRetInference#2",
      needs: [
        "synthParamAnnots", "computeVoidFns#2", "synthCaptureReadAnns",
      ],
    },
    {
      pass: "collectMapFilterUse",
      needs: ["synthParamAnnots", "computeRetInference#2"],
    },
    {
      pass: "collectFnValUse",
      needs: ["synthParamAnnots", "computeRetInference#2"],
    },
    {
      pass: "collectCloSigs",
      needs: ["collectMapFilterUse", "collectFnValUse"],
    },
    {
      pass: "initGuardScan",
      needs: [
        "monomorphize", "synthParamAnnots", "synthVoidTwins",
        "synthExternValues", "synthRecEqCores",
      ],
    },
    {
      pass: "scanPrintUse",
      needs: [
        "monomorphize", "synthParamAnnots", "initGuardScan",
      ],
    },
    {
      pass: "capCacheBuild",
      needs: ["monomorphize", "synthParamAnnots"],
    },
    {
      pass: "synthCaptureEmptyListAnns",
      needs: ["collectA#2", "capCacheBuild"],
    },
    {
      pass: "scanExprArmLocals",
      needs: [
        "monomorphize", "synthParamAnnots", "synthVoidTwins",
        "synthExternValues", "synthRecEqCores",
      ],
    },
    {
      pass: "cloLiftScan",
      needs: ["capCacheBuild", "scanExprArmLocals"],
    },
  ]
  // synthVoidTwins mints the void twins for coerced function VALUES — after
  // mono (`fnStmts` positions are final; the twin table stores them) and
  // before `buildFnMap#2`, whose `retVoidAnnFlag` seed classifies the twins.

  // Last, and the two edges say why. `collectA#2` is the same prerequisite
  // `synthGlobalEmptyListAnns` carries — the synthesis resolves a ref-list row and never mints
  // one, so the intern pass must have already run — and `capCacheBuild` is the pass that makes
  // the capture lists this walks final. It runs before `emitModule` because the section that reads the annotation (the type section's env structs, here) is emitted after it.
  passTable
}

// Runs `emitPassTable`'s rows in order over the program's top-level `stmts`, refusing a row
// whose prerequisites have not run. Returns -1 when a pass fails, else 0.
function runEmitPasses(stmts: i32[], rootIx: i32): i32 {
  const passTable = emitPassTable()
  // An instance's binding is read before `monomorphize` refills it (D3528), so the previous
  // program's must not survive into this one's early passes.
  monoSubTablesReset()
  callBindShadowBegin()
  fnFlowShadowBegin()
  identAuditBegin()
  const passDone: EmitPass[] = []
  let pi = 0
  while pi < passTable.length {
    const prow = passTable[pi]
    const pname = prow.pass
    if !passNeedsMet(prow.needs, passDone) {
      return emitFail(
        "emitProgram: pass "
          + pname
          + " ran before a prerequisite (pass table reordered)",
      )
    }
    capMemoArmed = passKeepsCaptures(pname)
    if pname == "monomorphize" { emitPhase = "monomorphizing" }
    const prc = runEmitPass(pname, stmts, rootIx)
    capMemoArmed = false
    if prc < 0 { return -1 }
    identAuditMark(pname)
    // The phases a pass row advances; see `EmitPhase`.
    if pname == "monomorphize" {
      emitPhase = "monomorphized"
      copiedDeclTysCarry()
    }
    if pname == "capCacheBuild" { emitPhase = "capsCached" }
    passDone.push(pname)
    // The generation a cross-pass classifier memo stamps: a row that fills a table the
    // ladder reads is invisible to an arena-shaped staleness test, so an answer may not
    // outlive the row that computed it (D1655).
    memoPassAdvance()
    // `parentLetOf`'s plan cache is keyed by blockIx alone, so a pass that adds a
    // binding to the SAME block a query already cached (a rewrite's spilled tail temp)
    // leaves the plan stale with no blockIx change to detect it by (D2389).
    plCacheBust()
    pi = pi + 1
  }
  0
}

// Lowers the checked program at `rootIx`; a negative return is a failed emit. A checker
// diagnostic an emit pass raises by re-entering the checker is dropped, as it never fails a
// build, so `vl check --codegen` reports what `vl build` and `vl run` do.
export function emitProgram(rootIx: i32) {
  const d0 = T.diags.length
  const rc = emitProgramRun(rootIx)
  while T.diags.length > d0 { T.diags.pop() }
  rc
}

// The root the elaboration last ran for at the end of check (`elabPrepare`), so emit reuses it;
// -1 when emit has to run it itself.
let elabPreparedFor = -1

// Resets the per-compile state and runs the elaboration over the checked program at `rootIx`,
// as the last step of check; `emitProgram` on the same root then builds from it. A diagnostic an
// instance's re-check owes the program is reported (`elabErrors`); every other one is dropped.
export function elabPrepare(rootIx: i32) {
  elabPreparedFor = -1
  emitProgramReset(rootIx)
  if rootIx < 0 || !(nodeAt(rootIx) is Program) { return 0 }
  const d0 = T.diags.length
  elabPrepareRun()
  while T.diags.length > d0 { T.diags.pop() }
  // What an instance's re-check owed the program is check's error.
  for e in elabErrors { T.diags.push(e) }
  elabPreparedFor = rootIx
  0
}

// The scratch the elaboration reads reset, its defaults primed, and the elaboration run.
function elabPrepareRun() {
  resetLitAtoms()
  resetParentLetCache()
  // The repOf scratch (visited stamps + component-mask memo) is keyed by `Ty`-arena index, stale
  // across programs, since the arena is re-minted per compile.
  repReset()
  monoElabDefaultsPrime()
  canonShowWritten()
  elabRun()
  canonShowCanon()
}

function emitProgramRun(rootIx: i32) {
  const prepared = elabPreparedFor == rootIx && rootIx >= 0
  elabPreparedFor = -1
  if !prepared { emitProgramReset(rootIx) }
  if rootIx < 0 { return emitFail("emitProgram: empty arena (root index < 0)") }
  const root = nodeAt(rootIx)
  if root is Program {
    const stmts = root.progStmts
    // No floor on an empty statement list, for `passCheckTopLevel`'s reason one stage earlier
    // (D1080). A zero-byte or comment-only file parses to a `Program` with no statements — the
    // empty module, valid wasm, already accepted by `vl check`. This site and the pass above are two sentences for one refusal; only this one has no declaration to look at.
    if !prepared { elabPrepareRun() }
    if runEmitPasses(stmts, rootIx) < 0 { return -1 }
    identAuditRun(stmts, fnStmts)
    fnFlowShadowSweep(stmts)
    // The last row has run, so nothing rewrites the arena from here on and a whole-program
    // index is safe to build. Its own contract is on the declaration.
    mapTwinSettle()
    emitPhase = "arenaFinal"
    // After the arena is final, so a literal binding re-seated at a join's row is seen there.
    if auditRecordJoinLeaves() < 0 { return -1 }
    // The expected-type context every emitter threads, unseeded.
    const rc = emitModule(stmts, expCtxDefault())
    if rc < 0 { return rc }
    // An `emitFail` whose -1 a deep helper swallowed (e.g. inside a valtype write)
    // must still fail the WHOLE emit: a failed module never reaches instantiation.
    if emitFailed { return -1 }
    // The rep-tree differential harness (debug-only; a no-op unless the host
    // armed `setRepShadow`) — swept HERE because the arena is final now.
    repShadowSweep()
    // The union registry's own equivalence sweep (SPIKE, same arming, same once-per-program
    // window — see `unionRegistryABSweep`). A no-op unless the harness is armed.
    unionRegistryABSweep()
    unTyKeyShadowSweep()
    // The ladder-vs-descriptor agreement oracle, same arming and window: what every converted
    // classifier site answered beside what `repOfTy` would have. A no-op unless armed.
    repLadderABSweep()
    return rc
  }
  emitFail("emitProgram: root node is not a Program")
}

// Emits one shared-runtime-helper functype (`0x60 func`, params, results) onto the current
// buffer. `params`/`res` are valtype descriptor strings, one char per slot: 'i' = i32, 'a' =
// a non-null `(ref $aTypeIdx)` i32-array ref, 's' = a non-null `(ref $sTypeIdx)` string ref,
// 'm' = a non-null `(ref $mkArrIdx)` string-list backing ref — a wrong functype on any of the six helpers is a call-site type mismatch at every use.
function helpFuncType(params: string, res: string) {
  wU8(96) // 0x60 func
  wULEB(params.length)
  let i = 0
  while i < params.length {
    helpValtype(params[i])
    i = i + 1
  }
  wULEB(res.length)
  let j = 0
  while j < res.length {
    helpValtype(res[j])
    j = j + 1
  }
  0
}

// One descriptor char (see `helpFuncType`) as a valtype.
function helpValtype(c: i32) {
  if c == 'i' {
    wU8(127) // 0x7f i32
    return 0
  }
  if c == 'j' {
    wU8(126) // 0x7e i64 — `__map_probe_i64__`'s key
    return 0
  }
  if c == 'f' {
    // 'f' = f64 — `__f64_rem__`'s two operands and its result (D1586). The only SCALAR
    // descriptor besides 'i', and the reason the two are handled before the ref block:
    // everything below writes a `(ref ht)` prefix and an index, which a number has none of.
    wU8(124) // 0x7c f64
    return 0
  }
  wU8(100) // 0x64 (ref ht) — non-null
  if c == 'm' {
    wSLEB(mkArrIdx)
  } else if c == 's' {
    wSLEB(sTypeIdx)
  } else if c == 'b' {
    // 'b' = the string's backing, `(ref $sBackIdx)` — distinct from 'a' in storage type (packed
    // i8, not i32). `__utf8_dec__` is the only helper that takes one; naming 'a' here would be a call-site type mismatch.
    wSLEB(sBackIdx)
  } else if c == 'y' {
    // 'y' = the `u8[]` WRAPPER, `(ref $bl8TypeIdx)` — `__str_bytes__`'s result.
    wSLEB(bl8TypeIdx)
  } else if c == 'k' {
    // 'k' = the i64 array, `(ref $ia64TypeIdx)` — an i64-keyed map's keys backing.
    wSLEB(ia64TypeIdx)
  } else {
    wSLEB(aTypeIdx)
  }
  0
}

// Read a `;`-terminated decimal index following a ref `$fnsig` token (`s3;`, `r0;`),
// starting at `i` (the first digit). Returns the parsed index; `outNext` receives the
// position just past the `;`. The token scheme (`repSigTokOfKind`/`repKindOfSigTok`)
// terminates every index-carrying ref token with `;`, so the loop is bounded.
function synthSigIdxAt(key: string, i: i32, outNext: i32[]) {
  let idx = 0
  let j = i
  // A map shape can be negative (the mono maps), written with a leading `-`.
  let neg = false
  if j < key.length && key[j] == '-' {
    neg = true
    j = j + 1
  }
  while j < key.length && key[j] != ';' {
    idx = idx * 10 + (key[j] - '0')
    j = j + 1
  }
  outNext.push(j + 1) // skip the ';'
  if neg { return 0 - idx }
  idx
}

// True if a `$fnsig` token char carries a `;`-terminated index — the ref shapes whose
// functype valtype needs a heap slot. Decodes through the ONE token vocabulary
// (`repKindOfSigTok` → `repSigTokHasSlot`), so a new slot-carrying kind cannot be added
// to the encoders without this parser skipping its digits correctly.
function synthSigTokHasIdx(c: i32) { repSigTokHasSlot(repKindOfSigTok(c)) }

// Emit ONE `$fnsig` functype — pool position `sai`'s bytes, and nothing else. Split out
// of `emitTypeSection`'s pool loop so that loop can render an entry, MEASURE it, and
// compare it against the entries already written (D351's twin column) without a second
// render or a scratch copy.
function emitCloSigFunctype(sai: i32) {
  const repFe = cloSigRepFn[sai]
  // A union-arm / annotation signature with NO concrete closure (`collectCloSigs`
  // interned it from a bare `(…)=>…` type) carries the -1 rep sentinel: synthesize
  // its functype from the KEY string (the same bytes the rep path emits for that key).
  if repFe < 0 { return emitSynthCloSig(cloSigKeys[sai]) }
  const rep = nodeAt(fnStmts[repFe])
  if rep is FuncDecl {
    const rparams = rep.fnParams
    wU8(96)                   // 0x60 func
    wULEB(rparams.length + 1) // env + declared params
    wU8(107)                  // param 0 env: structref (0x6b)
    let pj = 0
    while pj < rparams.length {
      fbValtype(vtKindOfParam(rparams[pj]), paramStructIdxOf(rparams[pj]))
      pj = pj + 1
    }
    // The RESULT must byte-match the rep function's own functype result so
    // the call site's `call_indirect $fnsig` signature check accepts the callee:
    // a VOID field-closure sig (`>v`) has 0 results; a STRUCT-returning one
    // (`>sN;`) yields the struct ref exactly as the function functype does.
    if fRetVoid[repFe] == 1 {
      wU8(0) // 0 results — the `>v` write-trap sig
    } else {
      wU8(1) // 1 result
      // The result valtype the rep function's OWN functype emits — scalar (i32/f64/
      // i64), string, an i32/string/f64 list, a union box, a nullable scalar/struct,
      // or a struct ref (`cloRetValKind`/`cloRetValSlot`, the shared mapping).
      const rrk = cloRetValKind(repFe)
      let rrkCode: VKind = "i32"
      if rrk != null { rrkCode = rrk }
      fbValtype(rrkCode, cloRetValSlot(repFe))
    }
  }
  0
}

// Emits one `$fnsig` functype synthesized purely from its interned key string — the path for
// a signature interned from a bare union-arm/annotation function type with no concrete closure
// (`cloSigRepFn` sentinel -1). The bytes match exactly what the rep path emits for the same
// key, since both stream valtypes through the same `fbValtype`, and a key token's trailing index is the `fbValtype` heap slot by construction.
function emitSynthCloSig(key: string) {
  // Not a type-name grammar (D-CLASSGRAM). The `>` below is the `$fnsig` key's param/result
  // separator — a character in the ABI token alphabet on a string the compiler minted token by
  // token, not a rendered type; routing it to the generic-application `<`-scan would be a
  // category error. Nor is it the ABI family's own last-`>` home (`sigKeyRetTokIx`): un-exported, its span rule is the last `>` where this walk wants the first.
  let gi = 0
  while gi < key.length && key[gi] != '>' { gi = gi + 1 }
  // Pass 1 — count params (advance token by token over `key[0..gi)`).
  let nparams = 0
  let ci = 0
  while ci < gi {
    if synthSigTokHasIdx(key[ci]) {
      ci = ci + 1
      while ci < gi && key[ci] != ';' { ci = ci + 1 }
      ci = ci + 1 // skip ';'
    } else {
      ci = ci + 1
    }
    nparams = nparams + 1
  }
  wU8(96)            // 0x60 func
  wULEB(nparams + 1) // env + declared params
  wU8(107)           // param 0 env: structref (0x6b)
  // Pass 2 — emit each param's valtype.
  let pi = 0
  while pi < gi {
    const pc = key[pi]
    const pk = repKindOfSigTok(pc)
    let pkc: VKind = "i32"
    if pk != null { pkc = pk }
    let pidx = -1
    if synthSigTokHasIdx(pc) {
      const nx: i32[] = []
      pidx = synthSigIdxAt(key, pi + 1, nx)
      pi = nx[0]
    } else {
      pi = pi + 1
    }
    fbValtype(pkc, pidx)
  }
  // Result — a `>v` (void field-closure) sig has 0 results; else the single result token.
  const ri = gi + 1
  if ri < key.length && key[ri] == 'v' {
    wU8(0)
  } else {
    wU8(1)
    const rc = key[ri]
    const rk = repKindOfSigTok(rc)
    let rkc: VKind = "i32"
    if rk != null { rkc = rk }
    let ridx = -1
    if synthSigTokHasIdx(rc) {
      const rnx: i32[] = []
      ridx = synthSigIdxAt(key, ri + 1, rnx)
    }
    fbValtype(rkc, ridx)
  }
  0
}

// Type section (id 1): all WasmGC types in one recursion group, followed by the standalone
// print/log functypes — the rec-group count excludes those. One function's `0x60` functype,
// written to the type payload: `withEnv` decides the hidden leading `structref`, every other
// byte the same either way.
function emitOneFuncType(ti: i32) {
  const withEnv = fnHasEnvParam(ti)
  const fn = nodeAt(fnStmts[ti])
  if fn is FuncDecl {
    const params = fn.fnParams
    const nParams = params.length
    // The captures a lifted function assigns are results after its own (D3664).
    let liftCaps: string[] = []
    let nRetCaps = 0
    wU8(96) // 0x60 func
    // A function carrying the env param takes a leading `structref` (local 0), which a
    // capturing one `ref.cast`s and reads; its declared params follow.
    if withEnv {
      // A lifted function's captures follow the env, in capture order (SP-037).
      if cloLifted(ti) {
        liftCaps = captureNamesOf(ti)
        nRetCaps = cloLiftWriteCount(ti)
      }
      wULEB(nParams + 1 + liftCaps.length) // param count incl. the env param
      wU8(107)                             // env param: structref (0x6b)
      let lci = 0
      while lci < liftCaps.length {
        fbValtype(
          captureValKind(ti, liftCaps[lci]),
          captureValStructIdx(ti, liftCaps[lci]),
        )
        lci = lci + 1
      }
    } else {
      wULEB(nParams) // param count
    }
    let pi = 0
    while pi < nParams {
      fbValtype(vtKindOfParam(params[pi]), paramStructIdxOf(params[pi]))
      pi = pi + 1
    }
    if fRetVoid[ti] == 1 {
      wU8(nRetCaps) // no result of its own — a VOID function (`()->()`)
    } else if fnValUsed && !cloLifted(ti) && fnSigIsClosure(ti) {
      // A value-eligible function's result is its `$fnsig`'s, so its body, its direct callers
      // and the table thunk around it all agree on one valtype.
      wU8(1)
      const crk = cloRetValKind(ti)
      let crkCode: VKind = "i32"
      if crk != null { crkCode = crk }
      fbValtype(crkCode, cloRetValSlot(ti))
    } else if fn.fnRet < 0 && fnReturnsClosure(ti) {
      // A function VALUE return (un-annotated; its tail is a function value) — kind 14.
      wU8(1 + nRetCaps)
      fbValtype("closure", -1)
    } else if fn.fnRet < 0 {
      // UN-ANNOTATED return: the INFERRED kind (computeRetInference set the same
      // stored `fRetKind` slot the annotation path fills). i32 when nothing matched.
      wU8(1 + nRetCaps) // 1 result
      // The inferred result kind from the single shared mapping (`inferredRetKindCore`), so this
      // site and `cloRetValKind` cannot drift on a scalar/list/ref kind. The slot follows the kind:
      // struct index for a struct/nullable-struct ref, the element wrapper for a ref list, the map
      // shape for a map; every other kind needs no per-function slot.
      const infKind = inferredRetKindCore(ti)
      let infSlot = -1
      if infKind == "struct" || infKind == "nulstruct" {
        infSlot = fRetStructIdx[ti]
      }
      if infKind == "reflist" { infSlot = fnRetRefListSlot(ti) }
      // A concrete-variant inferred result (kind 8) — the variant index, from the same companion
      // column the struct kinds read. The annotated path below has carried the variant through
      // `retStructIndex` all along; the inferred half had no arm and resolved -1, which
      // `fbValtype`'s bounds guard would turn into a loud `ref valtype with no interned shape` rather than a wrong heap type.
      if infKind == "variant" { infSlot = fRetStructIdx[ti] }
      // D1562 — the nullable-variant twin, from the same companion column, and the signature half
      // of the pair `cloRetValSlot` answers at the call site. The annotated ladder further down carries it through `nulVariantIndexOf`; the inferred half had no arm, so `fbValtype` took -1 and refused the module at check rc 0.
      if infKind == "nulvariant" { infSlot = fRetStructIdx[ti] }
      // A map/nullable-map result carries its value shape, from the one home that also seeds the
      // constructor inside the body (`inferredRetMapSlot`): the assignment cell's shape for an
      // implicit-return assignment, the return expression's otherwise. The `nulmap` half had no arm and defaulted to -1.
      if infKind == "map" || infKind == "nulmap" {
        infSlot = inferredRetMapSlot(ti)
      }
      fbValtype(infKind, infSlot)
    } else {
      wU8(1 + nRetCaps) // 1 result
      // A `T[]` return is kind 5 — its second `fbValtype` arg is the ref-list TABLE
      // SLOT for the element type (`retStructIndex` is -1 for a ref array), so the
      // result valtype selects THIS function's element wrapper, not slot 0's.
      let retSlot = retStructRowIndex(fn.fnRet)
      if retRefArrFlag(fn.fnRet) == 1 { retSlot = tyAnnRefListSlot(fn.fnRet) }
      // A NULLABLE ref-array return (`<ref-array> | null`, kind 18) — its slot is the INNER
      // ref-list element wrapper (`tyAnnRefListSlot` strips the `| null` before resolving), so the
      // `(ref null $wrapper)` result valtype selects THIS function's element wrapper.
      if retNulRefArrFlag(fn.fnRet) == 1 {
        retSlot = tyAnnRefListSlot(fn.fnRet)
      }
      // A string-keyed MAP return's slot is the map SHAPE (mono ⇒ -1, or the value type's mv
      // slot for a `string`-valued map), so the result valtype selects THIS map's `$mapStruct`.
      if retMapFlag(fn.fnRet) == 1 { retSlot = mapAnnShape(fn.fnRet) }
      // A NULLABLE map return (`{[string]: V} | null`, kind `nulmap`) — the SAME map SHAPE selects
      // its `(ref null $mapStruct)` result valtype (`mapAnnShape` is `| null`-aware).
      if retNulMapFlag(fn.fnRet) == 1 { retSlot = mapAnnShape(fn.fnRet) }
      // A `: Cat` concrete-variant return is kind 8 — its `fbValtype` slot is the VARIANT
      // index (`uVarHeap[vi]`), which `retStructIndex` (standalone structs only) misses.
      // The row follows `vtKindOfType`'s kind, so a structural twin of an arm takes that arm's
      // row, read off the recorded type rather than the rendered annotation.
      const retKind = vtKindOfType(fn.fnRet)
      if retVariantFlag(fn.fnRet) == 1 || retKind == "variant" {
        retSlot = repVariantShapeRowOf(nodeTyIxOf(fn.fnRet))
      }
      // A `Circle | null` return (kind `nulvariant`) — the VARIANT index under the null,
      // which the `(ref null $uVarHeap[vi])` result valtype indexes. `retStructIndex` is
      // -1 for it (`collectS` gives a variant no struct row), the same reason every
      // nullable sibling above carries its own line in this ladder.
      if retNulVariantFlag(fn.fnRet) == 1 {
        retSlot = nulVariantIndexOf(fn.fnRet)
      }
      fbValtype(retKind, retSlot)
    }
    let rci = 0
    while rci < nRetCaps {
      const rcName = liftCaps[cloLiftWriteCapAt(ti, rci)]
      fbValtype(captureValKind(ti, rcName), captureValStructIdx(ti, rcName))
      rci = rci + 1
    }
  }
}

// ── the declared-supertype graph (D622) ──
// The emitted storage of struct `si`'s field `fi`, as the (code, slot) pair `emitTypeSection`
// hands to `pushFieldStorage`. Two fields emit the same wasm field type exactly when both
// halves agree — the code alone is not the storage, since a nested-struct/ref-list/map field each carry a slot deciding which heap it points at.
function sFieldStoreCode(si: i32, fi: i32): i32 { sFieldTypeAt(si, fi) }

// Is struct row `p`'s emitted field list a proper prefix of row `c`'s — same names, same
// emitted storage, in the same positions, and strictly shorter? Names are part of it even
// though wasm only reads the storage: the edge carries the checker's structural width rule
// ("`Narrow`'s fields are the first of `Wide`'s"), and an edge between two rows that merely agree on storage would relate types the checker never meant to.
function structRowIsProperPrefix(p: i32, c: i32): boolean {
  if p < 0 || c < 0 || p == c { return false }
  if p >= sFieldCount.length || c >= sFieldCount.length { return false }
  const pn = sFieldCount[p]
  if pn == 0 { return false }
  if pn >= sFieldCount[c] { return false }
  let k = 0
  while k < pn {
    if sFieldNames[sFieldStart[p] + k] != sFieldNames[sFieldStart[c] + k] {
      return false
    }
    if sFieldStoreCode(p, k) != sFieldStoreCode(c, k) { return false }
    if sFieldStorageSlot(p, k) != sFieldStorageSlot(c, k) { return false }
    k = k + 1
  }
  true
}

// Builds `sSuper`/`sSubbed`: every representative struct row takes as its declared supertype
// the longest proper-prefix representative row in the module, or -1. Representatives only, on
// both ends — a twin shares an earlier row's heap index and has no form of its own to carry a
// `sub` or be named a parent. Longest, so the chain is transitively closed: a row's other required prefixes are prefixes of its longest one, and that row takes them in turn.
export function buildStructSupers() {
  sSuper = []
  sSubbed = []
  let i = 0
  while i < sNames.length {
    sSuper.push(-1)
    sSubbed.push(false)
    i = i + 1
  }
  let c = 0
  while c < sNames.length {
    if sTwin[c] == c {
      let best = -1
      let bestLen = 0
      let bestAgrees = false
      const ps = structPrefixCands(c, sNames.length)
      let pi = 0
      while pi < ps.length {
        const p = ps[pi]
        if sTwin[p] == p {
          if structRowIsProperPrefix(p, c) {
            // Of two prefixes of one length, the one agreeing on `i32` against `boolean` (D3693).
            const agrees = rowBoolI32Agree(p, c)
            if (
              sFieldCount[p] > bestLen
              || (sFieldCount[p] == bestLen && agrees && !bestAgrees)
            ) {
              best = p
              bestLen = sFieldCount[p]
              bestAgrees = agrees
            }
          }
        }
        pi = pi + 1
      }
      if best >= 0 {
        sSuper[c] = best
        sSubbed[best] = true
      }
    }
    c = c + 1
  }
  0
}

// The rec-group entries `emitTypeSection` has written so far; entry k is heap type k.
let tsEmitted = 0

// The closure-signature pool's entry offsets and lengths in the section buffer, for the twin
// column `tsCloSig` fills.
let tsPoolStart: i32[] = []
let tsPoolBytes: i32[] = []

// The entry about to be written must be the one the family's own index global records as `idx`.
// A disagreement means that global is set from a different counter position than the entry's
// allocation, which the walk over the recorded order cannot see.
function tsEntryAt(idx: i32, what: string) {
  if idx != tsEmitted {
    emitFail(
      "emitProgram: the type section desyncs from the type-index allocation at the "
        + what
        + " type — `mAssignTypeIndices` recorded index "
        + i32ToStr(idx)
        + ", the section is writing entry "
        + i32ToStr(tsEmitted),
    )
  }
  tsEmitted = tsEmitted + 1
  0
}

// One struct per declared type, in `structEmitOrder` — the same order `mAssignTypeIndices`
// assigned heap indices in: declaration order except that a row waits for every proper prefix
// of it (D622, since wasm needs a supertype's index lower than its subtype's). A field is
// `0x7f` i32, or for a string field a non-null `(ref $sTypeIdx)` (the raw `(array i32)` string rep); both mutable.
function tsStruct(si: i32) {
  tsEntryAt(sHeapIdx[si], "declared struct")
  // The declared-supertype form (D622): a row with a parent, or that is one, is written
  // with WasmGC's `0x50 sub` header instead of a bare `0x5f`, since a type without `sub`
  // is final. `(type $Wide (sub $Narrow …))` is what makes a `(ref $Wide)` acceptable at a `(ref $Narrow)` slot; a module with no proper-prefix pair emits the same bytes as before.
  const sup = sSuperAt(si)
  if sup >= 0 {
    wU8(80)  // 0x50 sub
    wULEB(1) // one supertype
    wULEB(sHeapIdx[sup])
  } else if sSubbedAt(si) {
    wU8(80)  // 0x50 sub
    wULEB(0) // no supertype, but NOT final — something declares this its parent
  }
  wU8(95) // 0x5f struct
  const cnt = sFieldCount[si]
  wULEB(cnt)
  let fj = 0
  while fj < cnt {
    // Which table the code names lives once, in `sFieldStorageSlot`: a nested-struct field
    // (code 15) passes its target struct row, a map field (19, and its nullable twin 29) its map
    // shape — the (key, value) pair `mapTypeIdxOf` turns into the storage heap type — and
    // everything else its ref-list row. The object-literal order stash (D1510) reads the same helper, so a stash local cannot be typed against a different slot than the field it feeds.
    pushFieldStorage(sFieldTypeAt(si, fj), sFieldStorageSlot(si, fj))
    wU8(1) // mutable
    fj = fj + 1
  }
  0
}

// The `nv` variant structs first (heap types 0..nv-1), each a struct of its i32 fields in
// declaration order. Then the union box `{ tag: i32, value: anyref }` at index `nv`: 2 fields
// — an immutable i32 tag and an immutable `anyref` value — mirroring binaryen's `unionStruct` output.
function tsVariant(vi: i32) {
  tsEntryAt(uVarHeap[vi], "union variant")
  wU8(95) // 0x5f struct
  const cnt = uFieldCount[vi]
  wULEB(cnt)
  let fj = 0
  while fj < cnt {
    // The struct loop's rule, one table over — `uFieldStorageSlot`.
    pushFieldStorage(variantFieldTypeAt(vi, fj), uFieldStorageSlot(vi, fj))
    wU8(1) // mutable
    fj = fj + 1
  }
  0
}

function tsUnionBox() {
  tsEntryAt(uBoxIdx, "union box")
  wU8(95)  // 0x5f struct (union box)
  wU8(2)   // 2 fields
  wU8(127) // field 0 tag: 0x7f i32
  wU8(0)   // immutable
  wU8(110) // field 1 value: 0x6e anyref
  wU8(0)   // immutable
  0
}

// The per-rep value boxes — each a one-field immutable struct `{ rep }` carrying a scalar
// value-union payload behind the box's `anyref` slot. `rep` counts in the order
// `mAssignTypeIndices` interns them: i32 (boolean shares it), i64, f32, f64, v128.
function tsValueBox(rep: i32) {
  let idx = vbI32Idx
  let what = "i32 value box"
  let valtype = 127 // 0x7f i32
  if rep == 1 {
    idx = vbI64Idx
    what = "i64 value box"
    valtype = 126 // 0x7e i64
  } else if rep == 2 {
    idx = vbF32Idx
    what = "f32 value box"
    valtype = 125 // 0x7d f32
  } else if rep == 3 {
    idx = vbF64Idx
    what = "f64 value box"
    valtype = 124 // 0x7c f64
  } else if rep == 4 {
    idx = vbV128Idx
    what = "v128 value box"
    valtype = 123 // 0x7b v128
  }
  tsEntryAt(idx, what)
  wU8(95) // 0x5f struct
  wU8(1)
  wU8(valtype)
  wU8(0) // immutable
  0
}

// The entry `idx` as a mutable scalar array `(array (mut <storage>))`, `storage` a valtype or
// packed storage-type byte.
function tsArray(idx: i32, what: string, storage: i32) {
  tsEntryAt(idx, what)
  wU8(94) // 0x5e array
  wU8(storage)
  wU8(1)  // mutable
  0
}

// The entry `idx` as a mutable nullable-ref array `(array (mut (ref null $elem)))`.
function tsRefArray(idx: i32, what: string, elem: i32) {
  tsEntryAt(idx, what)
  wU8(94) // 0x5e array
  wU8(99) // 0x63 (ref null ht)
  wSLEB(elem)
  wU8(1)  // mutable
  0
}

// The body of a list wrapper `{ backing: (ref $back), len: i32, cap: i32 }` — the one triple
// every list rep uses, over its own backing. The caller writes the entry header first.
function tsListWrapBody(back: i32) {
  wU8(95)  // 0x5f struct
  wU8(3)   // 3 fields
  wU8(100) // field 0 backing: 0x64 (ref ht) — non-null
  wSLEB(back)
  wU8(1)   // mutable
  wU8(127) // field 1 len: 0x7f i32
  wU8(1)   // mutable
  wU8(127) // field 2 cap: 0x7f i32
  wU8(1)   // mutable
  0
}

// `$aTypeIdx`, the i32-list and map backing.
function tsI32Array() { tsArray(aTypeIdx, "i32 array", 127) }

// `string`'s own backing array heap type (`$sBackIdx`), minted from the same `aUsed` flag and
// emitted immediately after it. Its storage type is packed i8 and its elements are UTF-8
// bytes, not i32 code points. It is not `ba8TypeIdx` (the `u8[]` backing) even though the two
// are now structurally identical: iso-recursive identity is (rec group, position), so keeping the index separate is what makes a missed lowering site invalid wasm instead of a silent share.
function tsStrBack() { tsArray(sBackIdx, "string backing", 120) }

// The string header (`$sTypeIdx`) — a `string` value is this struct, a view over the backing
// above: `{ backing: (ref $sBackIdx), start: i32, len: i32, hash: i32 }`. Field indices are
// fixed: backing=0, start=1, len=2, hash=3. The first three are immutable, letting a view
// alias its parent's backing with no invalidation risk; `hash` is mutable but is a memo of a pure function of the other three, so a slice memoises its own range and nothing else changes.
function tsStrHeader() {
  tsEntryAt(sTypeIdx, "string header")
  wU8(95)         // 0x5f struct
  wU8(4)          // 4 fields
  wU8(100)        // field 0 backing: 0x64 (ref ht) — non-null
  wSLEB(sBackIdx) // ...to the string backing array
  wU8(0)          // immutable
  wU8(127)        // field 1 start: 0x7f i32
  wU8(0)          // immutable
  wU8(127)        // field 2 len: 0x7f i32
  wU8(0)          // immutable
  wU8(127)        // field 3 hash: 0x7f i32
  wU8(1)          // MUTABLE — the memo, see above
  0
}

function tsI32List() {
  tsEntryAt(lTypeIdx, "i32 list wrapper")
  tsListWrapBody(aTypeIdx)
}

// One (backing, wrapper) PAIR per distinct ref-list element type, interleaved so each
// wrapper immediately follows (and references) its own backing — the heap indices laid
// out above. Each backing is `(array (mut (ref null $elem)))` over the slot's element
// (struct heap idx / union box); each wrapper is `{ backing: (ref $back), len, cap }`.
function tsRefBack(rti: i32) {
  tsRefArray(rlBackIdx[rti], "ref-list backing", rlElemHeap[rti])
}

function tsRefWrap(rti: i32) {
  tsEntryAt(rlWrapIdx[rti], "ref-list wrapper")
  rvOpenParent(rti)
  tsListWrapBody(rlBackIdx[rti])
}

// The string-ref list types, shared by the map's keys list and any `string[]` field. The
// backing's element is nullable so `array.new_default` defaults spare slots to null.
function tsStrListBack() {
  tsRefArray(mkArrIdx, "string-list backing", sTypeIdx)
}

function tsStrListWrap() {
  tsEntryAt(mkListIdx, "string-list wrapper")
  tsListWrapBody(mkArrIdx)
}

// The string-keyed map struct — the open-addressing rep documented at `mUsed`, whose field
// order matches the host's general-purpose rep (`compiler/builtins/maps.ts`).
function tsMap() {
  tsEntryAt(mStructIdx, "map")
  tsMapStructBody(mkListIdx)
}

function tsMapI32() {
  tsEntryAt(mStructI32Idx, "i32-keyed map")
  tsMapStructBody(lTypeIdx)
}

// The i64-keyed twin, the same struct over the i64 list wrapper, minted right after it.
function tsMapI64() {
  tsEntryAt(mStructI64Idx, "i64-keyed map")
  tsMapStructBody(il64TypeIdx)
}

// The scalar list families, each an array then its wrapper, in the type-index allocation
// order: f64 (Slice 4), i64, f32, then u8.
function tsF64Array() { tsArray(fa64TypeIdx, "f64 array", 124) }

function tsF64List() {
  tsEntryAt(fl64TypeIdx, "f64 list wrapper")
  svOpenParent(1)
  tsListWrapBody(fa64TypeIdx)
}

function tsI64Array() { tsArray(ia64TypeIdx, "i64 array", 126) }

function tsI64List() {
  tsEntryAt(il64TypeIdx, "i64 list wrapper")
  svOpenParent(0)
  tsListWrapBody(ia64TypeIdx)
}

function tsF32Array() { tsArray(fa32TypeIdx, "f32 array", 125) }

function tsF32List() {
  tsEntryAt(fl32TypeIdx, "f32 list wrapper")
  tsListWrapBody(fa32TypeIdx)
}

// The `u8[]` backing is the emitter's first packed storage type: `0x78` is not a valtype, so
// `array.get` is invalid on it and `fbArrayGet` dispatches to `array.get_u` off this index.
function tsU8Array() { tsArray(ba8TypeIdx, "u8 array", 120) }

function tsU8List() {
  tsEntryAt(bl8TypeIdx, "u8 list wrapper")
  tsListWrapBody(ba8TypeIdx)
}

function tsClosure() {
  // The closure fat-pointer struct `{ env: (ref null struct), id: i32, decl: i32 }`, all
  // immutable: the env (null when non-capturing), the wasm index `call_indirect` dispatches on,
  // and the index of the function standing for the source declaration, which with the env is
  // the `==` identity. No `funcref` field: reading one back out of the GC heap is a host libcall.
  tsEntryAt(cloStructIdx, "closure")
  wU8(95)           // 0x5f struct
  wU8(3)            // 3 fields
  wU8(99)           // field 0 env: 0x63 (ref null ht)
  wU8(107)          // ...to the abstract `struct` heaptype (structref)
  wU8(0)            // immutable
  fbImmutI32Field() // field 1 id, the dispatch index
  fbImmutI32Field() // field 2 decl, the identity token
  0
}

// The function-value cell `{ v: (mut (ref null $closure)) }` a declaring frame and every frame
// reading its function as a value share (`cloCellTarget`).
function tsCloCell() {
  tsEntryAt(cloCellIdx, "function-value cell")
  fbStructTypeHead(1)
  fbMutRefNullField(cloStructIdx)
  0
}

// One env-leading `$fnsig` functype per distinct eligible signature, in `cloSigKeys` order,
// and — as each is written — the pool's twin column: the smallest earlier entry with
// identical bytes (D351). Compared over the section buffer just rendered into, so every
// entry renders exactly once and emitted bytes are unchanged — a duplicate functype is still emitted at its own index, it simply stops being referenced.
function tsCloSig(sai: i32) {
  const start = wLen()
  tsEntryAt(cloSigBase + sai, "closure signature")
  emitCloSigFunctype(sai)
  const nb = wLen() - start
  let twin = sai
  let pj = 0
  while pj < sai {
    if tsPoolBytes[pj] == nb && wRangeEq(tsPoolStart[pj], start, nb) {
      twin = pj
      pj = sai // stop at the first (smallest) twin
    }
    pj = pj + 1
  }
  cloSigTwin.push(twin)
  tsPoolStart.push(start)
  tsPoolBytes.push(nb)
  0
}

// One env struct per capturing lifted function (`fnEnvIdx[fe] >= 0`), in `fnStmts` order.
// Each is a struct of one immutable i32 field per captured variable, in capture order. The
// corpus captures are all i32, plus one struct-ref capture (`closure.vl`'s `sumPoint`, emitting the captured ref's own valtype).
function tsCloEnv(fe: i32) {
  const caps = captureNamesOf(fe)
  tsEntryAt(fnEnvIdxOf(fe), "closure env")
  wU8(95) // 0x5f struct
  wULEB(caps.length)
  let ci = 0
  while ci < caps.length {
    if capCellTargetOf(caps[ci]) >= 0 {
      fbRefNullValtype(cloCellIdx) // the shared function-value cell
    } else {
      fbValtype(captureValKind(fe, caps[ci]), captureValStructIdx(fe, caps[ci]))
    }
    wU8(0) // immutable
    ci = ci + 1
  }
  0
}

// The ref-valued map structs (one per distinct (key, value) layout), in `mvMapTypeIdx` mint
// order — the same 7-field shape as the mono map struct, with `vals` referencing this slot's
// ref-list wrapper and `keys` referencing this slot's key list. Live/index/count/size/hashes are identical across all map structs, so the shared probe/rehash/compact bytes apply as-is.
function tsMvMap(mvs: i32) {
  // Field 0's type IS the second half of this slot's identity (`repMapValSlotsTwin`
  // refuses to twin across it), so it is read from the same column the resolvers key
  // on rather than assumed to be the string-ref list.
  let mvKeysWrap = mkListIdx
  if mvSlotKeyKind(mvs) == MAP_KEY_I32 { mvKeysWrap = lTypeIdx }
  if mvSlotKeyKind(mvs) == MAP_KEY_I64 { mvKeysWrap = il64TypeIdx }
  tsEntryAt(mvMapTypeIdx[mvs], "ref-valued map")
  wU8(95)              // 0x5f struct (ref-valued map)
  wU8(mapFieldCount()) // 7 fields (host-aligned open-addressing hash map), 9 with seqs
  wU8(100)             // field 0 keys: 0x64 (ref <this slot's keys wrapper>) — non-null
  wSLEB(mvKeysWrap)
  wU8(1)               // mutable
  wU8(100)             // field 1 vals: 0x64 (ref <this slot's wrapper>)
  wSLEB(mvValsWrapOf(mvs))
  wU8(1)               // mutable
  wU8(100)             // field 2 live: 0x64 (ref $aTypeIdx) — non-null i32 array
  wSLEB(aTypeIdx)
  wU8(1)               // mutable
  wU8(100)             // field 3 index: 0x64 (ref $aTypeIdx) — non-null i32 array
  wSLEB(aTypeIdx)
  wU8(1)               // mutable
  wU8(127)             // field 4 count: 0x7f i32
  wU8(1)               // mutable
  wU8(127)             // field 5 size: 0x7f i32
  wU8(1)               // mutable
  wU8(100)             // field 6 hashes: 0x64 (ref $aTypeIdx) — non-null i32 array
  wSLEB(aTypeIdx)
  wU8(1)               // mutable
  mapSeqFieldTypes()
  0
}

// The type-section dispatch: one entry per `mAllocType` call, in allocation order, so the
// section cannot be written in any order other than the one the indices are handed out in.
function tsEmitEntry(kind: i32, slot: i32) {
  if kind == TSK_STRUCT { return tsStruct(slot) }
  if kind == TSK_VARIANT { return tsVariant(slot) }
  if kind == TSK_UNION_BOX { return tsUnionBox() }
  if kind == TSK_VALUE_BOX { return tsValueBox(slot) }
  if kind == TSK_I32_ARRAY { return tsI32Array() }
  if kind == TSK_STR_BACK { return tsStrBack() }
  if kind == TSK_STR_HEADER { return tsStrHeader() }
  if kind == TSK_I32_LIST { return tsI32List() }
  if kind == TSK_REF_BACK { return tsRefBack(slot) }
  if kind == TSK_REF_WRAP { return tsRefWrap(slot) }
  if kind == TSK_STRLIST_BACK { return tsStrListBack() }
  if kind == TSK_STRLIST_WRAP { return tsStrListWrap() }
  if kind == TSK_MAP { return tsMap() }
  if kind == TSK_MAP_I32 { return tsMapI32() }
  if kind == TSK_MAP_I64 { return tsMapI64() }
  if kind == TSK_F64_ARRAY { return tsF64Array() }
  if kind == TSK_F64_LIST { return tsF64List() }
  if kind == TSK_I64_ARRAY { return tsI64Array() }
  if kind == TSK_I64_LIST { return tsI64List() }
  if kind == TSK_F32_ARRAY { return tsF32Array() }
  if kind == TSK_F32_LIST { return tsF32List() }
  if kind == TSK_U8_ARRAY { return tsU8Array() }
  if kind == TSK_U8_LIST { return tsU8List() }
  if kind == TSK_SV_VIEW { return tsSvView(slot) }
  if kind == TSK_RV_VIEW { return tsRvView(slot) }
  if kind == TSK_CLOSURE { return tsClosure() }
  if kind == TSK_CLO_SIG { return tsCloSig(slot) }
  if kind == TSK_CLO_ENV { return tsCloEnv(slot) }
  if kind == TSK_MV_MAP { return tsMvMap(slot) }
  if kind == TSK_CLO_CELL { return tsCloCell() }
  emitFail(
    "emitProgram: the type section has no writer for allocation kind "
      + i32ToStr(kind),
  )
}

function emitTypeSection(
  n: i32,
  typeOffset: i32,
  hasStart: i32,
  memFn: i32,
  nPrintTypes: i32,
  nHelpers: i32,
) {
  tsEmitted = 0
  cloSigTwin = []
  tsPoolStart = []
  tsPoolBytes = []
  const typePayload: u8[] = []
  // Bind the writer at `typePayload` for the WHOLE type-section payload build, so the
  // raw framing bytes, `pushFieldStorage`, and `fbValtype` all stream to `curBuf ==
  // typePayload` identically. Restored just before `wSection` frames it (below).
  const tyPrev = wTarget(typePayload)
  // The rec group holds the heap types and the closure-signature pool. Each user function's
  // own functype and the start functype follow it standalone, because under iso-recursive
  // identity a rec-group member never equals another module's import (D1999); they name only
  // lower-indexed types.
  let nGroup = 0
  if typeOffset > 0 { nGroup = 1 }
  wULEB(
    nGroup
      + n
      + hasStart
      + nPrintTypes
      + memFn
      + nHelpers
      + gMapSetTyN
      + gEqHelpTyN,
  )
  if typeOffset > 0 {
    wU8(78)           // 0x4e rec group
    wULEB(typeOffset) // the heap types and the closure-signature pool
  }
  buildStructSupers()
  let ei = 0
  while ei < mAllocKind.length {
    tsEmitEntry(mAllocKind[ei], mAllocSlot[ei])
    ei = ei + 1
  }
  // The functype param/result valtypes (`fbValtype`) stream to `curBuf == typePayload`,
  // interleaved identically with the surrounding raw framing bytes (the `wTarget` bind
  // covering this whole payload build is established above).
  // The rec group is complete: its entry count is the functype base `mAssignTypeIndices` returned.
  if tsEmitted != typeOffset {
    emitFail(
      "emitProgram: the type section wrote "
        + i32ToStr(tsEmitted)
        + " rec-group entries, `mAssignTypeIndices` allocated "
        + i32ToStr(typeOffset),
    )
  }
  let ti = 0
  while ti < n {
    emitOneFuncType(ti)
    ti = ti + 1
  }
  // ── the tail functypes, in emit order ──
  // Everything from here down is appended after the user functypes, each group after the last,
  // so no earlier functype index ever shifts: the start fn's `()->()` (when present), the print
  // functypes (one per wide scalar printed), `__log__`'s `(i32,i32)->()`, then the helpers — all standalone rectypes, like the user functypes above.
  if hasStart == 1 {
    wU8(96) // 0x60 func
    wU8(0)  // 0 params
    wU8(0)  // 0 results
  }
  if gImports > 0 {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(127) // 0x7f i32
    wU8(0)   // 0 results
    wU8(96)  // 0x60 func
    wU8(0)   // 0 params
    wU8(0)   // 0 results
  }
  if gNeedsI64Print {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(126) // 0x7e i64
    wU8(0)   // 0 results
  }
  if gNeedsF64Print {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(124) // 0x7c f64
    wU8(0)   // 0 results
  }
  if gNeedsF32Print {
    wU8(96)  // 0x60 func
    wU8(1)   // 1 param
    wU8(125) // 0x7d f32
    wU8(0)   // 0 results
  }
  // ── the filesystem functypes ──
  // One `0x60` rectype per used fs slot, in slot order, appended after the print family,
  // standalone outside the rec group — wasmtime will not match a rec-group-member functype
  // against a host-provided function, though a later rectype may reference an earlier type index freely. The wrapper ref is non-null (`0x64`): a failing call answers an empty `u8[]`, and `__fs_errno__()` carries the reason.
  tsEmitFsFuncTypes()
  // ── the extern functypes ──
  // One `0x60` rectype per declared extern, in manifest order, standalone outside the rec group
  // for the reason the fs block above is: wasmtime will not match a rec-group member against a
  // host-provided function. Scalars only, so no heap type is ever named here.
  tsEmitExternFuncTypes()
  if memLogUsed {
    wU8(96)  // 0x60 func — the `__log__` decoder
    wU8(2)   // 2 params
    wU8(127) // 0x7f i32 (offset)
    wU8(127) // 0x7f i32 (length)
    wU8(0)   // 0 results
  }
  // The shared runtime helpers, in helper-index order.
  tsEmitHelperFuncTypes()
  wTarget(tyPrev)
  wSection(1, typePayload)
  0
}

// Writes one functype per used fs slot, in slot order, to the type-section payload
// `emitTypeSection` has bound. A slot with no arity records a failure and writes `() -> i32`.
function tsEmitFsFuncTypes() {
  let fsty = 0
  while fsty < fsIntrinsicCount() {
    if fsUsedAt(fsty) {
      const fsAr = fsIntrinsicArity(fsty)
      if fsAr < 0 {
        // Cannot `return` — `curBuf` is bound to `typePayload` across this whole block, and returning
        // would skip the `wTarget` that unbinds it. Record the failure and write a well-formed 0-param
        // shape so the section stays parseable while it unwinds; the import entry naming this functype comes off the same slot table, so the two stay in step even on this path.
        emitFail(
          "emitProgram: fs import slot has no arity — the slot table and the arity table have drifted",
        )
        wU8(96)  // 0x60 func
        wULEB(0) // 0 params
        wULEB(1)
        wU8(127) // 0x7f i32
      } else {
        wU8(96) // 0x60 func
        wULEB(fsAr)
        let fsp = 0
        while fsp < fsAr {
          if fsArgIsU8List(fsty, fsp) {
            wU8(100) // 0x64 (ref $bl8) — a path or a payload
            wSLEB(bl8TypeIdx)
          } else {
            if fsArgIsI64(fsty, fsp) {
              wU8(126) // 0x7e i64 — a byte offset into the file
            } else {
              wU8(127) // 0x7f i32 — an index, an address, a length or a mode
            }
          }
          fsp = fsp + 1
        }
        // One value per slot — the packed wrapper, an i64 byte count, or an i32 carrying
        // 0/1 or a negative `-errno` — except the diverging one, which returns none.
        if fsRetIsVoid(fsty) {
          wULEB(0)
        } else {
          wULEB(1)
          if fsRetIsU8List(fsty) {
            wU8(100) // 0x64 (ref $bl8) — non-null, EMPTY on error
            wSLEB(bl8TypeIdx)
          } else {
            if fsRetIsI64(fsty) {
              wU8(126) // 0x7e i64 — `__fs_size__`, negative for `-errno`
            } else {
              wU8(127) // 0x7f i32
            }
          }
        }
      }
    }
    fsty = fsty + 1
  }
  0
}

// Writes one functype per declared extern, in manifest order, to the type-section payload
// `emitTypeSection` has bound. A row with no arity records a failure and writes `() -> ()`.
function tsEmitExternFuncTypes() {
  let exty = 0
  while exty < externCount() {
    const exAr = externArityAt(exty)
    wU8(96) // 0x60 func
    if exAr < 0 {
      // Cannot `return` — `curBuf` is bound to `typePayload` across this block. Record and write
      // a well-formed 0-param shape so the section stays parseable while the failure unwinds.
      emitFail(
        "emitProgram: extern row has no arity — the manifest and its readers have drifted",
      )
      wULEB(0)
      wULEB(0)
    } else {
      wULEB(exAr)
      let exp = 0
      while exp < exAr {
        wU8(externValType(externParamAt(exty, exp)))
        exp = exp + 1
      }
      if externRetIsVoid(exty) {
        wULEB(0)
      } else {
        wULEB(1)
        wU8(externValType(externRetAt(exty)))
      }
    }
    exty = exty + 1
  }
  0
}

// Writes the functype of every shared runtime helper in use, in helper-index order, to the
// type-section payload `emitTypeSection` has bound.
function tsEmitHelperFuncTypes() {
  if gHelpStrHash >= 0 {
    helpFuncType("s", "i")   // __str_hash__: (str) -> i32
    helpFuncType("ss", "i")  // __str_eq__: (str, str) -> i32
    helpFuncType("ss", "s")  // __str_concat__: (str, str) -> (ref str)
    helpFuncType("bii", "i") // __utf8_dec__: (strBacking, i, end) -> (width<<24)|cp
    helpFuncType("aii", "s") // __utf8_enc__: (i32Backing, start, len) -> (ref str)
    helpFuncType("s", "i")   // __utf8_cplen__: (str) -> i32
    if ba8Used {
      helpFuncType("s", "y") // __str_bytes__: (str) -> (ref u8[])
    }
  }
  if gHelpMapProbe >= 0 {
    // __map_probe__: (keyHash, index, hashes, live, keysBacking, key) -> slot — three 'a'
    // i32 arrays, the 'm' string-list backing, then the 's' STRING key.
    helpFuncType("iaaams", "i")
    helpFuncType("aaaii", "a") // __map_resize__: (index, hashes, live, count, size) -> index'
  }
  if gHelpMapProbeI32 >= 0 {
    helpFuncType("ai", "i") // __map_probe_i32__: (index, key i32) -> slot
    helpFuncType("ai", "a") // __map_resize_i32__: (index, count) -> index'
  }
  if gHelpMapProbeI64 >= 0 {
    helpFuncType("ajk", "i") // __map_probe_i64__: (index, key i64, keysBacking) -> slot
  }
  if gHelpF64Rem >= 0 {
    helpFuncType("ff", "f") // __f64_rem__: (f64, f64) -> f64
  }
  if gHelpMapResync >= 0 {
    mapResyncFuncType() // __map_resync__: (seqs, count, seq) -> cursor
  }
  let cft = 0
  while cft < gHelpMapCompact.length {
    if gHelpMapCompact[cft] >= 0 { mapCompactFuncType(mapCompactRowShape(cft)) }
    cft = cft + 1
  }
  if gHelpInitFail >= 0 {
    helpFuncType("iii", "") // __init_fail__: (global row, verb, reader row) -> (), never returns
  }
  svHelperFuncTypes()
  rvHelperFuncTypes()
  if gHelpAsFail >= 0 {
    helpFuncType("ii", "") // __as_fail__: (line, col << 3 | domain row) -> ()
  }
  if gHelpStrFromBytes >= 0 {
    helpFuncType("yii", "s") // __str_from_bytes__: (u8[], at, count) -> (ref str)
  }
  if gHelpStrFill >= 0 {
    helpFuncType("is", "i") // __str_fill__: (segment offset, pool string) -> next offset
  }
  let sft = 0
  while sft < gMapSetTy.length {
    if gMapSetTy[sft] >= 0 { mapSetFuncType(mapCompactRowShape(sft)) }
    sft = sft + 1
  }
  let eft = 0
  while eft < gEqHelpTy.length {
    if gEqHelpTy[eft] >= 0 { eqHelpFuncType(eft) }
    eft = eft + 1
  }
  0
}

// The wasm valtype byte an extern's type spelling writes. The set is the checker's
// (`externScalarTy`); a spelling outside it cannot reach here, and the refusal says which of the
// two lists moved rather than writing a malformed functype.
function externValType(spelling: string): i32 {
  if spelling == "i32" { return 127 }
  // A boolean is an i32 at the boundary: the host receives 0 or 1, which is its whole ABI.
  if spelling == "boolean" { return 127 }
  if spelling == "i64" { return 126 }
  if spelling == "f32" { return 125 }
  if spelling == "f64" { return 124 }
  emitFail(
    "emitProgram: extern type `"
      + spelling
      + "` has no wasm valtype — the checker's extern type set and this writer have drifted",
  )
  127
}

function emitImportSection(n: i32, typeOffset: i32, hasStart: i32) {
  // Import section (id 2, between type and function): the 4-entry print family from
  // the host's `"imports"` module, occupying function indices 0..3 in this exact
  // order (the call lowering hardcodes them): __print_i32__, __print_bool__,
  // __print_char__ (all `(i32)->()`), __print_str_flush__ (`()->()`).

  // An imported memory alone still needs the section; its entry trails every function import,
  // and memory imports occupy their own index space, so no function index moves.
  if gImports == 0 {
    if memImported() || externGlobalCount() > 0 {
      const memOnlyPayload: u8[] = []
      const moPrev = wTarget(memOnlyPayload)
      let nNonFn = externGlobalCount()
      if memImported() { nNonFn = nNonFn + 1 }
      wULEB(nNonFn)
      emitGlobalImportEntries()
      if memImported() { emitMemoryImportEntry() }
      wTarget(moPrev)
      wSection(2, memOnlyPayload)
    }
    return 0
  }
  if gImports > 0 {
    const ftI32 = typeOffset + n + hasStart
    const ftVoid = ftI32 + 1
    const ftI64 = ftVoid + 1
    // The `(f64)->()` functype index trails the i64 one when present, else the void one.
    let ftF64 = ftVoid + 1
    if gNeedsI64Print { ftF64 = ftI64 + 1 }
    // The `(f32)->()` functype index trails the f64 one when present, else wherever the
    // f64 index would be (the standalone functypes are emitted i64 → f64 → f32 in order).
    let ftF32 = ftF64
    if gNeedsF64Print { ftF32 = ftF64 + 1 }
    // The first fs functype index — one past wherever the f32 one would sit. `ftF32` is
    // "the next free index" whether or not the f32 print import exists (each of the
    // three conditionals above advances only when its own flag is set), so this
    // continues the same chain rather than re-deriving it.
    let ftFs = ftF32
    if gNeedsF32Print { ftFs = ftF32 + 1 }
    const importPayload: u8[] = []
    const imPrev = wTarget(importPayload)
    // 4 imports normally; +1 each for `__print_i64__` / `__print_f64__` / `__print_f32__`.
    let nImports = 4
    if gNeedsI64Print { nImports = nImports + 1 }
    if gNeedsF64Print { nImports = nImports + 1 }
    if gNeedsF32Print { nImports = nImports + 1 }
    // …and one per USED fs slot, counted from the same table the entries below iterate.
    nImports = nImports + fsImportCount()
    // …and one per declared extern, trailing the fs block.
    nImports = nImports + externCount() + externGlobalCount()
    if memImported() { nImports = nImports + 1 }
    wULEB(nImports)
    wName("imports")
    wName("__print_i32__")
    wU8(0) // import kind: func
    wULEB(ftI32)
    wName("imports")
    wName("__print_bool__")
    wU8(0)
    wULEB(ftI32)
    wName("imports")
    wName("__print_char__")
    wU8(0)
    wULEB(ftI32)
    wName("imports")
    wName("__print_str_flush__")
    wU8(0)
    wULEB(ftVoid)
    // `__print_i64__` LAST, at function index 4 (`fbCall(4)` in the print router), so
    // the existing imports keep indices 0..3 and only this entry is conditionally added.
    if gNeedsI64Print {
      wName("imports")
      wName("__print_i64__")
      wU8(0)
      wULEB(ftI64)
    }
    // `__print_f64__` LAST, at function index `gF64PrintIdx` (4 or 5). (Slice 3.)
    if gNeedsF64Print {
      wName("imports")
      wName("__print_f64__")
      wU8(0)
      wULEB(ftF64)
    }
    // `__print_f32__` LAST, at function index `gF32PrintIdx` (4/5/6). (Slice 5.)
    if gNeedsF32Print {
      wName("imports")
      wName("__print_f32__")
      wU8(0)
      wULEB(ftF32)
    }
    // The filesystem entries last, in slot order, each at the function index `scanPrintUse`
    // recorded and each carrying the functype the type section appended for it in the same loop
    // shape, so the two orders cannot diverge without both loops being edited. `emitFail` on a
    // missing index rather than a negative ULEB: the index tables and this loop are the parallel pair this file's own discipline bound-checks.
    let fsim = 0
    while fsim < fsIntrinsicCount() {
      if fsUsedAt(fsim) {
        let fsNm = fsIntrinsicNameAt(fsim)
        if fsNm == "" {
          // Record and carry on, never `return` from here: `curBuf` is bound to `importPayload` for
          // the whole of this block, and returning early would skip the `wTarget(imPrev)` that unbinds
          // it. `emitFail` does not halt emission, so the only safe shape is a placeholder that keeps the entry count honest (written above from `fsImportCount()`) while the recorded failure unwinds the compile.
          emitFail(
            "emitProgram: fs import slot has no name — the slot table and its count have drifted",
          )
          fsNm = "__fs_unknown__"
        }
        wName("imports")
        wName(fsNm)
        wU8(0) // import kind: func
        wULEB(ftFs)
        ftFs = ftFs + 1
      }
      fsim = fsim + 1
    }
    // The user externs last, in manifest order, under their OWN module name so a host can tell a
    // user extern from a std intrinsic without a name convention. The import name is the VL name,
    // unmangled: it is the contract the author wrote (extern-design.md §3).
    let exim = 0
    while exim < externCount() {
      let exNm = externNameAt(exim)
      if exNm == "" {
        emitFail(
          "emitProgram: extern row has no name — the manifest and its count have drifted",
        )
        exNm = "__extern_unknown__"
      }
      wName("extern")
      wName(exNm)
      wU8(0) // import kind: func
      wULEB(ftFs)
      ftFs = ftFs + 1
      exim = exim + 1
    }
    emitGlobalImportEntries()
    if memImported() { emitMemoryImportEntry() }
    wTarget(imPrev)
    wSection(2, importPayload)
  }
  0
}

// One `(import "extern" "<name>" (global (mut? <valtype>)))` per `extern let`/`extern const`
// link row, in manifest order — which is global index 0.. since imports precede every
// defined global. Same module name as `extern function`, so one host object serves both.
function emitGlobalImportEntries() {
  let gi = 0
  while gi < externGlobalCount() {
    wName("extern")
    wName(extGNames[gi])
    wU8(3) // import kind: global
    wU8(externValType(extGTys[gi]))
    if extGMut[gi] == 1 { wU8(1) } else { wU8(0) }
    gi = gi + 1
  }
  0
}

// One import entry: `(import "env" "memory" (memory 1))` — the limits the defined memory would
// carry (`emitMemoryLimits`), so the two shapes differ only in who supplies it.
function emitMemoryImportEntry() {
  wName("env")
  wName("memory")
  wU8(2) // import kind: memory
  emitMemoryLimits()
  0
}

// The one memory's limits: min `gInitialMemPages` (1 by default) and no max (flag 0x00), a max
// (flag 0x01) under `--max-memory`, or, under `--shared-memory`, shared with that max (flag
// 0x03). A shared memory must declare a max.
function emitMemoryLimits() {
  if gSharedMemPages > 0 {
    wU8(3) // limits flag 0x03: shared, min and max
    wULEB(gInitialMemPages)
    wULEB(gSharedMemPages)
    return 0
  }
  if gMaxMemPages > 0 {
    wU8(1) // limits flag 0x01: min and max
    wULEB(gInitialMemPages)
    wULEB(gMaxMemPages)
    return 0
  }
  wU8(0) // limits flag 0x00: min only
  wULEB(gInitialMemPages)
  0
}

function emitFunctionSection(
  n: i32,
  typeOffset: i32,
  hasStart: i32,
  memFn: i32,
  nPrintTypes: i32,
  nHelpers: i32,
) {
  // Function section (id 3): N functions; func i uses functype `typeOffset + i`. The
  // synthetic start function (if any) is the LAST entry — function index `n` — using
  // the `()->()` functype at index `typeOffset + n`.
  // Framed by `frameFunctionSection` once the bodies have decided the thunks it ends with.
  const funcPayload: u8[] = []
  const fnPrev = wTarget(funcPayload)
  gFuncFixedN = n + hasStart + gInitMods.length + memFn + nHelpers
  let fi = 0
  while fi < n {
    // A function carrying the env param whose signature matches an interned `$fnsig` is
    // declared with that `$fnsig` functype, so a `call_indirect $fnsig` reaching it passes
    // the engine's signature check. Others keep their own functype.
    if fnHasEnvParam(fi) && fnSigIsClosure(fi) && !cloLifted(fi) {
      wULEB(fnSigIdxOfFn(fi))
    } else {
      wULEB(typeOffset + fi) // functype index
    }
    fi = fi + 1
  }
  if hasStart == 1 {
    wULEB(typeOffset + n) // start fn functype index
  }
  // Each init function shares the start's `()->()` functype.
  let ii = 0
  while ii < gInitMods.length {
    wULEB(typeOffset + n)
    ii = ii + 1
  }
  if memLogUsed {
    // The synthetic `__log__` decoder uses the standalone `(i32,i32)->()` functype
    // emitted after the print functypes.
    wULEB(typeOffset + n + hasStart + nPrintTypes)
  }
  // The shared runtime helpers, each on its own standalone functype (emitted after
  // the `__log__` functype in the SAME helper order, so functype k belongs to
  // helper k).
  const helpTyBase = typeOffset + n + hasStart + nPrintTypes + memFn
  let hi = 0
  while hi < nHelpers {
    wULEB(helpTyBase + hi)
    hi = hi + 1
  }
  gMapSetTyBase = helpTyBase + nHelpers
  gMapSetFnBase = gImports + gFuncFixedN
  wTarget(fnPrev)
  gFuncEntries = funcPayload
  gFuncRopeAt = W.chunks.length
  0
}

// What `emitFunctionSection` leaves for `frameFunctionSection`: the count and entries of every
// function but the thunks, and the module rope chunk the section is framed before.
let gFuncFixedN = 0
let gFuncEntries: u8[] = []
let gFuncRopeAt = 0

// The thunks, after every other function so no index shifts: one per address-taken function
// without the env param, in `fnStmts` order. Thunk k is function `thunkBase + k` and is
// declared with its target's `$fnsig`, so it is what the table holds at the target's id.
let cloThunkFes: i32[] = []
// Parallel to `fnStmts`: the function index of each one's thunk, or -1.
let cloThunkOf: i32[] = []

// Collect the thunks from the address-taken set the bodies recorded. `base` is the function
// index after every other function.
function collectCloThunks(n: i32, base: i32) {
  cloThunkFes = []
  cloThunkOf = []
  let fe = 0
  while fe < n {
    if fnValUsed && fnAddrTakenAt(fe) && !fnHasEnvParam(fe) {
      if fnSigIdxOfFn(fe) < 0 {
        emitFail(
          "emitProgram: a function taken as a value has no `$fnsig` for its table thunk",
        )
      }
      cloThunkOf.push(base + cloThunkFes.length)
      cloThunkFes.push(fe)
    } else {
      cloThunkOf.push(-1)
    }
    fe = fe + 1
  }
  0
}

// The function a table entry for function `fe` holds: its thunk when it has one, else itself.
function tableEntryFnIdx(fe: i32): i32 {
  if fe >= 0 && fe < cloThunkOf.length && cloThunkOf[fe] >= 0 {
    return cloThunkOf[fe]
  }
  gImports + fe
}

// Function section (id 3), placed before the table section it precedes in the module.
function frameFunctionSection() {
  const countBuf: u8[] = []
  const thunkBuf: u8[] = []
  const prev = wTarget(countBuf)
  wULEB(gFuncFixedN + gTailFnRows.length + cloThunkFes.length)
  wTarget(thunkBuf)
  for row in gTailFnRows {
    if row >= 0 {
      wULEB(gMapSetTyBase + gMapSetTy[row])
    } else {
      wULEB(gMapSetTyBase + gMapSetTyN + gEqHelpTy[-1 - row])
    }
  }
  let k = 0
  while k < cloThunkFes.length {
    wULEB(fnSigIdxOfFn(cloThunkFes[k]))
    k = k + 1
  }
  wTarget(prev)
  wSectionPartsAt(gFuncRopeAt, 3, [countBuf, gFuncEntries, thunkBuf])
}

// A thunk body: drop the env, forward the declared params, tail-call the target, so a
// recursion through a function value stays in constant stack.
function emitCloThunkCode(out: u8[], fe: i32) {
  const body: u8[] = []
  const prev = wTarget(body)
  wULEB(0) // no local runs
  const tfn = nodeAt(fnStmts[fe])
  if tfn is FuncDecl {
    let pi = 0
    while pi < tfn.fnParams.length {
      fbLocalGet(1 + pi)
      pi = pi + 1
    }
  }
  fbReturnCall(gImports + fe)
  fbEnd()
  wTarget(prev)
  helpFrameBody(out, body)
}

// What `emitGlobalSection` leaves for `frameGlobalSection`: its entry count and bytes, and the
// module rope chunk the section is framed before.
let gGlobalFixedN = 0
let gGlobalEntries: u8[] = []
let gGlobalRopeAt = 0

function emitGlobalSection(ec: ExpCtx) {
  if captureFoldedConsts(ec) < 0 { return -1 }
  // Global section (id 6): one global per top-level `let`/`const`, in declaration
  // order (that order is the global index `global.get`/`global.set` use). Each entry is
  // `<valtype> <mutability> <init constexpr> 0x0b`, immutable for a constant `const`; a non-constexpr init fails loudly via `emitExpr`.
  // A promoted binding (G2c) emits no cell, so the count is declarations minus promoted, and survivors' indices come from `gCellIdx`, which `userGlobalIdx` is the single translation through.
  const ng = globalStmts.length
  let nCells = 0
  let nci = 0
  while nci < ng {
    if gCellIdx[nci] >= 0 { nCells = nCells + 1 }
    nci = nci + 1
  }
  const np = gStrPoolTexts.length
  // The heap-window pair trails the imports, the pool and every user cell, so no existing
  // global moves.
  let nHeap = 0
  if gHeapUsed {
    nHeap = 2
    gHeapGlobalIdx = externGlobalCount() + np + nCells
  }
  // The read-before-init progress cell trails the heap pair, for the same reason (D2652).
  let nProg = 0
  if gInitAny {
    nProg = 1
    gInitProgIdx = externGlobalCount() + np + nCells + nHeap
  }
  // The synthetic constants trail everything, and the section is framed once the bodies that
  // mint them are built (`frameGlobalSection`), at this point of the module.
  gSynthBase = externGlobalCount() + np + nCells + nHeap + nProg
  gGlobalFixedN = nCells + np + nHeap + nProg
  gGlobalRopeAt = W.chunks.length
  gGlobalEntries = []
  if nCells + np + nHeap + nProg > 0 {
    const globalPayload: u8[] = gGlobalEntries
    // Bind the writer at `globalPayload` for the WHOLE global-section payload build, so
    // each entry's valtype (`fbValtype`), mutability flag, and init constexpr (`fb*`
    // opcodes) all stream to `curBuf == globalPayload`. Restored before framing.
    const gPrev = wTarget(globalPayload)
    // The string-literal pool first (indices 0..np-1, before the user cells): each entry an
    // immutable non-null string ref built once, so every use is one `global.get`. Its backing is
    // `array.new_fixed`, or for a filled entry (`gStrFillOff`) a zeroed `array.new_default` the
    // start function copies into, since `array.new_data` is not a constant instruction.
    let pli = 0
    while pli < np {
      wU8(100) // 0x64 (ref $sTypeIdx) — non-null string ref
      wSLEB(sTypeIdx)
      wU8(0)   // immutable
      const pcps = cpsToUtf8(decodeStr(strToCps(gStrPoolTexts[pli])))
      if pli < gStrFillOff.length && gStrFillOff[pli] >= 0 {
        fbI32Const(pcps.length)
        fbArrayNewDefault(sBackIdx)
      } else {
        let pci = 0
        while pci < pcps.length {
          fbI32Const(pcps[pci])
          pci = pci + 1
        }
        fbArrayNewFixed(sBackIdx, pcps.length)
      }
      fbI32Const(0)           // start
      fbI32Const(pcps.length) // len
      fbStrNew()              // 0xfb 0x00 <string header>
      fbEnd()                 // 0x0b end of init expr
      pli = pli + 1
    }
    let gi = 0
    while gi < ng {
      // A PROMOTED binding (G2c) emits no cell at all: its value lives in a
      // start-function local and its initializer becomes a `local.set` there. An imported
      // one (`extern let`) has its cell in the import section instead.
      if gCellIdx[gi] < 0 {
        gi = gi + 1
        continue
      }
      const g = nodeAt(globalStmts[gi])
      if g is LetDecl {
        if globalIsNonConst(globalStmts[gi]) {
          // A non-constexpr init (a `global.get`+`struct.get`, a reference to another global, a call,
          // etc.) cannot be a WasmGC constant expression. Declare the cell nullable and zero-init it;
          // the synthetic start function below runs the real init via `global.set` before any other code, so reads never see the zero. The cell stays mutable.
          const ck = globalCellKind(globalStmts[gi])
          const cs = letCellSlot(globalStmts[gi], -1, ck)
          fbValtypeNullable(ck, cs) // nullable valtype
          wU8(1)                    // 0x01 mutable
          if ck == "i32" || ck == "nulbool" {
            fbI32Const(0) // i32 scalar zero
          } else if ck == "i64" {
            fbI64Const(0, 0) // i64 scalar zero (Slice 1)
          } else if ck == "f64" {
            fbF64Const("0.0") // f64 scalar zero (Slice 3)
          } else if ck == "f32" {
            fbF32Const("0.0") // f32 scalar zero (Slice 5)
          } else if ck == "v128" {
            fbV128ConstZero() // v128 zero; the start function stores the real vector
          } else {
            fbRefNullForKind(ck, cs) // ref.null zero
          }
          fbEnd() // 0x0b end of init expr
        } else {
          const gck = globalCellKind(globalStmts[gi])
          const gcs = letCellSlot(globalStmts[gi], -1, gck)
          fbValtype(gck, gcs) // valtype
          // A `const` cell is immutable: nothing but this constexpr writes it, and an exported one
          // is what an `extern const` import links to. A constexpr `let` stays mutable.
          if globalCellIsImmutable(gi) { wU8(0) } else { wU8(1) }
          if emitConstCellInit(globalPayload, gi, ec) < 0 { return -1 }
          fbEnd() // 0x0b end of init expr
        }
      }
      gi = gi + 1
    }
    // The heap window last: base then limit, immutable, at `gHeapGlobalIdx` and the next index.
    if nHeap == 2 {
      wU8(127) // 0x7f i32
      wU8(0)   // immutable
      fbI32Const(gHeapBase)
      fbEnd()
      wU8(127)
      wU8(0)
      fbI32Const(gHeapLimit)
      fbEnd()
    }
    if nProg == 1 {
      wU8(127) // 0x7f i32
      wU8(1)   // mutable
      fbI32Const(0)
      fbEnd()
    }
    wTarget(gPrev)
    relHold(globalPayload)
  }
  0
}

// Frames the global section at the place `emitGlobalSection` left for it: its entries, then
// one immutable global per synthetic constant the bodies minted, in minting order.
function frameGlobalSection() {
  const n = gGlobalFixedN + gSynthKind.length
  if n == 0 { return 0 }
  const countBuf: u8[] = []
  const synthBuf: u8[] = []
  const prev = wTarget(countBuf)
  wULEB(n)
  wTarget(synthBuf)
  let i = 0
  while i < gSynthKind.length {
    let ty = cloStructIdx
    if gSynthKind[i] != SYNTH_CLOSURE { ty = gSynthArg[i] }
    wU8(100) // 0x64 (ref $ty), non-null
    wSLEB(ty)
    wU8(0)   // immutable
    if gSynthKind[i] == SYNTH_EMPTY_BACKING {
      fbArrayNewFixed(ty, 0)
    } else if gSynthKind[i] == SYNTH_CONST_LIST {
      wBytes(gSynthInit[i])
    } else {
      fbRefNullStruct()
      fbI32RelOf(
        RS_SLOT,
        gSynthArg[i],
        gImports + gSynthArg[i] + relSkew(RS_SLOT),
      )
      const decl = cloDeclAt[gSynthArg[i]] ?? gSynthArg[i]
      fbI32RelOf(RS_SLOT, decl, gImports + decl + relSkew(RS_SLOT))
      fbStructNew(ty)
    }
    fbEnd()
    i = i + 1
  }
  wTarget(prev)
  relSectionParts(6, [countBuf, gGlobalEntries, synthBuf])
  wSectionPartsAt(gGlobalRopeAt, 6, [countBuf, gGlobalEntries, synthBuf])
}

// Lowers the initializer of the constexpr cell at `globalStmts` position `gi` into `buf`, under
// the seeds its cell kind implies. Every seed is scoped to this one init and restored after it:
// a constexpr runs before every function body, so a leaked null rep would retype a bare `null`
// anywhere in the module (D1563). Shared by the global section and `captureFoldedConsts`.
function emitConstCellInit(buf: u8[], gi: i32, ec: ExpCtx): i32 {
  const g = nodeAt(globalStmts[gi])
  if g is LetDecl {
    const gcSaved = expCtxHere(ec)
    const gck = globalCellKind(globalStmts[gi])
    // The rungs a cell derives from its kind alone, shared with the local `let`, the
    // start-function init and the `global.set` arm.
    const cc = expCtxHere(ec)
    // A literal-union const lowers its member init as `i32.const <id>`; a nullable one lowers a
    // bare `null` as the -1 sentinel. Un-seeded, a member init emitted the string ref into the
    // i32 niche cell (invalid wasm) and a `null` init drew a loud reject.
    if letBindIsAtom(globalStmts[gi], -1) { cc.litUnion = 1 }
    if letBindIsNulAtom(globalStmts[gi], -1) { cc.nulLitUnion = true }
    cc.nulBool = gck == "nulbool"
    expCtxApply(cc, ec)
    // A union cell boxes its init in the constexpr (`struct.new` / `array.new_fixed` /
    // `i32.const` are all constant in WasmGC), and a `const f = add` aliasing a generic named
    // function emits its closure through the floor-less core, as `emitLetDeclStmt` does.
    let gun2 = ""
    if gck == "union" { gun2 = letUnionNameOf(globalStmts[gi], -1) }
    let gun2Ty = -1
    if g.letType >= 0 { gun2Ty = nodeTyIxOf(g.letType) }
    const gAliasFe = monoGenericAliasFe(globalStmts[gi])
    // An integer constant expression over other consts is written as its folded value.
    let rc = 0
    const ceSaved = gConstExprEmit
    gConstExprEmit = true
    if letInitFoldsExpr(g) {
      rc = emitConstFoldValue(buf, gck, g.letInit, constFoldOfLet(g).cfV)
    } else if gun2 != "" {
      rc = emitUnionCoerce(buf, gun2, gun2Ty, g.letInit, -1, ec)
    } else if gAliasFe >= 0 {
      rc = emitClosureValueCore(buf, gAliasFe, -1, ec)
    } else {
      rc = emitExpr(buf, g.letInit, -1, ec)
    }
    gConstExprEmit = ceSaved
    // The snapshot restored, rather than a chosen list of seeds cleared: one this function
    // leaves standing would outlive the whole global section.
    expCtxApply(gcSaved, ec)
    if rc < 0 { return -1 }
    return 0
  }
  emitFail("emitProgram: a module global cell that is not a binding")
}

// Writes the folded value `v` of the integer constant expression `init` into `buf` as the
// one `*.const` of a cell of kind `gck`, which must be the init's own width.
function emitConstFoldValue(buf: u8[], gck: VKind, init: i32, v: i64): i32 {
  const wide = nodeTyPrimName(init) == "i64"
  if wide != (gck == "i64") || (!wide && gck != "i32") {
    return emitFail(
      "emitProgram: a folded constant's cell is not its own integer width",
    )
  }
  const prev = wTarget(buf)
  if wide {
    fbI64Const((v >> (32 as i64)) as% i32, v as% i32)
  } else {
    fbI32Const(v as% i32)
  }
  wTarget(prev)
  0
}

// Folds every immutable cell whose own constexpr is exactly one scalar `*.const`: its bytes go
// to `gFoldPool` for `emitFoldedConstRead`, and the cell is dropped unless an export names it.
// Runs before the global section writes its count and before any body reads a global index.
function captureFoldedConsts(ec: ExpCtx): i32 {
  let gi = 0
  while gi < globalStmts.length {
    // A guarded cell keeps its reads, so one before the declaration still traps (D2652).
    const guarded = gi < gInitGuard.length && gInitGuard[gi] >= 1
    if gCellIdx[gi] >= 0 && globalCellIsImmutable(gi) && !guarded {
      const one: u8[] = []
      const prev = wTarget(one)
      const rc = emitConstCellInit(one, gi, ec)
      wTarget(prev)
      if rc < 0 { return -1 }
      if wIsOneScalarConst(one) {
        gFoldOk[gi] = 1
        relFoldBank(one, gi)
        gFoldAt[gi] = gFoldPool.length
        gFoldLen[gi] = one.length
        let k = 0
        while k < one.length {
          gFoldPool.push(one[k])
          k = k + 1
        }
      }
    }
    gi = gi + 1
  }
  let cell = 0
  gi = 0
  while gi < globalStmts.length {
    if gCellIdx[gi] >= 0 {
      if gFoldOk[gi] == 1 && !globalIsExportTarget(gi) {
        gCellIdx[gi] = -1
      } else {
        gCellIdx[gi] = cell
        cell = cell + 1
      }
    }
    gi = gi + 1
  }
  0
}

// The first `fnStmts` slot carrying each function name — the slot an export TARGET resolves
// to. The module's ABI resolution in one place: #1260's `monoFirstFnIndexNamed` mirrors the
// same FIRST-slot rule inside the monomorphizer, and four sections depend on it agreeing.
function fnFirstSlotByName(): {[string]: i32} {
  const first: {[string]: i32} = Map()
  let tj = 0
  while tj < fnStmts.length {
    const tfn = nodeAt(fnStmts[tj])
    if tfn is FuncDecl {
      if !first.has(tfn.fnName) { first[tfn.fnName] = tj }
    }
    tj = tj + 1
  }
  first
}

// The alias-table rows the export section publishes, in section order: every entry whose
// target resolves, minus duplicates (a wasm export name must be unique, and a repeated
// public name keeps its FIRST entry). `first` is `fnFirstSlotByName()`.
function exportPublishedRows(first: {[string]: i32}): i32[] {
  const rows: i32[] = []
  const seen: {[string]: boolean} = Map()
  let rxi = 0
  while rxi < reExpName.length {
    if (first[reExpTarget[rxi]] ?? -1) >= 0 && !seen.has(reExpName[rxi]) {
      seen[reExpName[rxi]] = true
      rows.push(rxi)
    }
    rxi = rxi + 1
  }
  rows
}

// The PUBLIC names the export section publishes, in section order.
function exportPublicNames(): string[] {
  const rows = exportPublishedRows(fnFirstSlotByName())
  const nms: string[] = []
  let k = 0
  while k < rows.length {
    nms.push(reExpName[rows[k]])
    k = k + 1
  }
  nms
}

// The `fnStmts` slot each published name resolves to, PARALLEL to `exportPublicNames`:
// both read the same `exportPublishedRows`, so entry k of one belongs to entry k of the other.
function exportTargetSlots(): i32[] {
  const first = fnFirstSlotByName()
  const rows = exportPublishedRows(first)
  const slots: i32[] = []
  let k = 0
  while k < rows.length {
    slots.push(first[reExpTarget[rows[k]]] ?? -1)
    k = k + 1
  }
  slots
}

// The alias rows the export section publishes as wasm globals, in row order: a scalar binding
// whose public name no function and no earlier row took. The exported memory's name is not
// applied here, so a caller that publishes the memory drops a row named `memory` itself.
function exportGlobalRows(fnNames: string[]): i32[] {
  const rows: i32[] = []
  const taken: string[] = []
  let gxi = 0
  while gxi < reExpName.length {
    if (
      exportGlobalOfTarget(reExpTarget[gxi]) >= 0
      && !strListHas(fnNames, reExpName[gxi])
      && !strListHas(taken, reExpName[gxi])
    ) {
      taken.push(reExpName[gxi])
      rows.push(gxi)
    }
    gxi = gxi + 1
  }
  rows
}

// The root's global exports before the exported memory takes its name, as each public name
// beside the global index it publishes.
function exportRootGlobals(): { names: string[], globals: i32[] } {
  const out: { names: string[], globals: i32[] } = { names: [], globals: [] }
  for row in exportGlobalRows(exportPublicNames()) {
    out.names.push(reExpName[row])
    out.globals.push(userGlobalIdx(exportGlobalOfTarget(reExpTarget[row])))
  }
  out
}

function emitExportSection(_n: i32) {
  // Export section (id 7): the module's ABI is exactly the alias tables the driver staged —
  // re-export entries plus the root module's plain `export`-marked functions. Nothing else is
  // exported: an internal function stays private, since a program runs by instantiation and a
  // lean surface lets `wasm-opt` prune unreached code. A duplicate public name keeps its first entry (export names must be unique).
  const reExpEi = exportTargetSlots() // the target's `fnStmts` position, parallel to its public name
  const reExpNm = exportPublicNames()
  // P0.2 — export the linear memory (`buffer-design.md` §C5, ruling O4(i)), under the universal
  // name `memory`, gated on the memory existing at all (`memUsed`, the same flag that decides
  // section 5) — so a program that never touches linear memory is byte-identical to before.
  // Automatic rather than a flag, since an unused memory has nothing to opt out of; a user `export function memory()` name collision is rejected loudly, the trade O4(i) makes.

  // An IMPORTED memory is not re-exported: its host already holds it, and N units each
  // exporting `memory` is a fatal name conflict when a linker merges them.
  const memExported = memUsed && !memImported()
  // The scalar module bindings the alias rows name, published as wasm globals after every
  // function entry. A public name a function or the exported memory already took keeps it,
  // and the binding stays a VL-level export only.
  const gExpNm: string[] = []
  const gExpIx: i32[] = []
  for row in exportGlobalRows(reExpNm) {
    if !(memExported && reExpName[row] == "memory") {
      gExpNm.push(reExpName[row])
      gExpIx.push(exportGlobalOfTarget(reExpTarget[row]))
    }
  }
  if memExported {
    let mci = 0
    while mci < reExpNm.length {
      if reExpNm[mci] == "memory" {
        return emitFail(
          "emitProgram: this program exports a function named 'memory', but a program that uses linear memory exports the memory itself under that name — rename the function",
        )
      }
      mci = mci + 1
    }
  }
  // An export-free program still omits the section unless the memory is exported, in which
  // case section 7 exists to carry that one entry — otherwise a memory-only module would lose its export.
  if reExpNm.length == 0 && gExpNm.length == 0 && !memExported { return 0 }
  let nExports = reExpNm.length + gExpNm.length
  if memExported { nExports = nExports + 1 }
  const exportPayload: u8[] = []
  const exPrev = wTarget(exportPayload)
  wULEB(nExports)
  // Each entry: the bare public name pointing at the target's func index. A top-level function
  // captures nothing, so it carries no env param and its signature is already the clean ABI.
  let rei = 0
  while rei < reExpNm.length {
    if fnHasEnvParam(reExpEi[rei]) {
      wTarget(exPrev)
      return emitFail(
        "emitProgram: an exported function carries the closure env param — only a nested function can, and none is exported",
      )
    }
    wName(reExpNm[rei])
    wU8(0) // export kind: func
    wULEB(gImports + reExpEi[rei])
    rei = rei + 1
  }
  let gxe = 0
  while gxe < gExpNm.length {
    wName(gExpNm[gxe])
    wU8(3) // export kind: global
    wULEB(userGlobalIdx(gExpIx[gxe]))
    gxe = gxe + 1
  }
  // The memory entry LAST, so every function export keeps the index it had — the
  // export section is order-insensitive to a host, but keeping the prefix identical
  // makes the A/B byte diff read as a pure append.
  if memExported {
    wName("memory")
    wU8(2)   // export kind: memory
    wULEB(0) // memory index 0 (the one module-defined memory)
  }
  wTarget(exPrev)
  wSection(7, exportPayload)
  0
}

// Banks one row of the body-span table (D1594): the `[from, to)` byte range, what kind of
// body it is, and the name/arena node a diagnostic can read off it. Ranges are
// payload-relative until `emitCodeSection` rebases them onto the module. Every body the code section writes gets a row, not just the user functions, since an offset inside a row-less body printed a bare number.
function bankFnSpan(
  node: i32,
  pos: i32,
  from: i32,
  to: i32,
  kind: i32,
  tag: string,
) {
  bankSpanRow(node, pos, from, to, kind, tag)
}

// The byte width of `v` written as a ULEB128 — one element-segment entry's cost.
function ulebWidth(v: i32): i32 {
  let w = 1
  let x = v
  while x >= 128 {
    x = x >> 7
    w = w + 1
  }
  w
}

// The first address-taken function at or after `i`, or `n` when there is none.
function elemNextTaken(i: i32, n: i32): i32 {
  let k = i
  while k < n && !fnAddrTakenAt(k) { k = k + 1 }
  k
}

// One past the last entry of the element segment starting at address-taken function `s`. A run
// crosses a gap when filling it beats a second segment: the constant below is a header's least
// cost — the flags, the `i32.const` offset, its `end`, the count — against the ULEB a filled
// entry costs, and that break-even keeps the narrowed section from exceeding the one it replaced.
function elemRunEnd(s: i32, n: i32): i32 {
  let e = s + 1
  while e < n {
    const nxt = elemNextTaken(e, n)
    if nxt >= n { return e }
    if (nxt - e) * ulebWidth(gImports + nxt) > 5 { return e }
    e = nxt + 1
  }
  e
}

// The element section's segment count, which its own ULEB header needs before the segments
// themselves are written. Walks the same runs the writer below does, so the two cannot disagree.
function fnAddrTakenRuns(n: i32): i32 {
  let runs = 0
  let i = elemNextTaken(0, n)
  while i < n {
    runs = runs + 1
    i = elemNextTaken(elemRunEnd(i, n), n)
  }
  runs
}

// The code section's payload: one size-prefixed body per function, in index order, then (if
// any) the synthetic start function's body, the `__log__` decoder's, and the helper bodies last
// (in helper-index order). Separate from the framing below because the element section is
// written between the two. Returns -1 if any body fails to emit, else 0.
function buildCodePayload(
  codePayload: ByteRope,
  n: i32,
  hasStart: i32,
  memFn: i32,
  nHelpers: i32,
  ec: ExpCtx,
) {
  // The count is written once the bodies have decided the thunks, into the head chunk pushed
  // here; `rowsAt` marks the span rows its width change moves.
  const fixedN = n + hasStart + gInitMods.length + memFn + nHelpers
  const countHead: u8[] = []
  const codePrev = wTarget(countHead)
  wULEB(fixedN)
  wTarget(codePrev)
  ropePush(codePayload, countHead)
  const rowsAt = emitFnSpanStart.length
  dfeArm()
  // Each entry renders into a buffer of its own and joins the payload as one chunk, so no
  // buffer holds more than one function (D1976). `rows` marks the span rows the entry is
  // about to bank, entry-relative until `placeCodeEntry` moves them onto the payload.
  let ci = 0
  while ci < n {
    // Bank the body's byte range for the VALIDATE diagnostic (D1578). Recorded HERE, at
    // the one loop that already pairs a `fnStmts` position with the body it writes, so a
    // span cannot name a different function than the code it brackets. Payload-relative
    // until `writeCodeSection` places the payload in the module.
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitFuncCode(entry, fnStmts[ci], ci, ec) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, fnStmts[ci], ci, 0, "")
    ci = ci + 1
  }
  if hasStart == 1 {
    // The start function banks a row per top-level statement from inside `emitStartFnCode`
    // (D1594), then this whole-body row as the fallback for the frame bytes no statement covers.
    // Pushed after them, since `emitFnSpanAt` returns the first row whose range holds the offset and the narrower answer is the useful one.
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitStartFnCode(entry, n, ec) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 4, "")
  }
  let ik = 0
  while ik < gInitMods.length {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitInitFnCode(entry, ik, ec) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 4, "")
    ik = ik + 1
  }
  if memLogUsed {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitMemLogFnCode(entry) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__log__")
  }
  // The shared runtime helpers, each banked under the name the name section gives it — one body, one row, so a trace and a validate diagnostic cannot disagree about what to call the same function.
  if gHelpStrHash >= 0 {
    const hash: u8[] = []
    let rows = emitFnSpanStart.length
    if emitStrHashFnCode(hash) < 0 { return -1 }
    placeCodeEntry(codePayload, hash, rows, -1, -1, 3, "__str_hash__")
    const eq: u8[] = []
    rows = emitFnSpanStart.length
    if emitStrEqFnCode(eq) < 0 { return -1 }
    placeCodeEntry(codePayload, eq, rows, -1, -1, 3, "__str_eq__")
    const concat: u8[] = []
    rows = emitFnSpanStart.length
    if emitStrConcatFnCode(concat) < 0 { return -1 }
    placeCodeEntry(codePayload, concat, rows, -1, -1, 3, "__str_concat__")
    const dec: u8[] = []
    rows = emitFnSpanStart.length
    if emitUtf8DecFnCode(dec) < 0 { return -1 }
    placeCodeEntry(codePayload, dec, rows, -1, -1, 3, "__utf8_dec__")
    const enc: u8[] = []
    rows = emitFnSpanStart.length
    if emitUtf8EncFnCode(enc) < 0 { return -1 }
    placeCodeEntry(codePayload, enc, rows, -1, -1, 3, "__utf8_enc__")
    const cpLen: u8[] = []
    rows = emitFnSpanStart.length
    if emitUtf8CpLenFnCode(cpLen) < 0 { return -1 }
    placeCodeEntry(codePayload, cpLen, rows, -1, -1, 3, "__utf8_cplen__")
    if gHelpStrBytes >= 0 {
      const bytes: u8[] = []
      rows = emitFnSpanStart.length
      if emitStrBytesFnCode(bytes) < 0 { return -1 }
      placeCodeEntry(codePayload, bytes, rows, -1, -1, 3, "__str_bytes__")
    }
  }
  if gHelpMapProbe >= 0 {
    const probe: u8[] = []
    let rows = emitFnSpanStart.length
    if emitMapProbeFnCode(probe) < 0 { return -1 }
    placeCodeEntry(codePayload, probe, rows, -1, -1, 3, "__map_probe__")
    const resize: u8[] = []
    rows = emitFnSpanStart.length
    if emitMapResizeFnCode(resize) < 0 { return -1 }
    placeCodeEntry(codePayload, resize, rows, -1, -1, 3, "__map_resize__")
  }
  if gHelpMapProbeI32 >= 0 {
    let rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitMapProbeI32FnCode(entry) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__map_probe_i32__")
    const resize: u8[] = []
    rows = emitFnSpanStart.length
    if emitMapResizeI32FnCode(resize) < 0 { return -1 }
    placeCodeEntry(codePayload, resize, rows, -1, -1, 3, "__map_resize_i32__")
  }
  if gHelpMapProbeI64 >= 0 {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitMapProbeI64FnCode(entry) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__map_probe_i64__")
  }
  if gHelpF64Rem >= 0 {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitF64RemFnCode(entry) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__f64_rem__")
  }
  if gHelpMapResync >= 0 {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitMapResyncFnCode(entry) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__map_resync__")
  }
  let cce = 0
  while cce < gHelpMapCompact.length {
    if gHelpMapCompact[cce] >= 0 {
      const rows = emitFnSpanStart.length
      const entry: u8[] = []
      if emitMapCompactFnCode(entry, mapCompactRowShape(cce)) < 0 { return -1 }
      placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__map_compact__")
    }
    cce = cce + 1
  }
  if gHelpInitFail >= 0 {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitInitFailFnCode(entry) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__init_fail__")
  }
  svPlaceHelpers(codePayload)
  rvPlaceHelpers(codePayload)
  if gHelpAsFail >= 0 {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitAsFailFnCode(entry) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__as_fail__")
  }
  if gHelpStrFromBytes >= 0 {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitStrFromBytesFnCode(entry) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__str_from_bytes__")
  }
  if gHelpStrFill >= 0 {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if emitStrFillFnCode(entry) < 0 { return -1 }
    placeCodeEntry(codePayload, entry, rows, -1, -1, 3, "__str_fill__")
  }
  // The map store and struct compare helpers the bodies above called, in the order they first
  // did; a compare helper's body can call another, which joins the list behind it.
  let tfi = 0
  while tfi < gTailFnRows.length {
    const row = gTailFnRows[tfi]
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    if row >= 0 {
      helpFrameBody(entry, mapSetFnBody(mapCompactRowShape(row)))
      placeCodeEntry(codePayload, entry, rows, -1, -1, 3, mapSetFnName(row))
    } else {
      if eqHelpFnCode(entry, -1 - row, ec) < 0 { return -1 }
      placeCodeEntry(
        codePayload,
        entry,
        rows,
        -1,
        -1,
        3,
        eqHelpFnName(-1 - row),
      )
    }
    tfi = tfi + 1
  }
  const nSet = gTailFnRows.length
  // The thunk bodies last, in the order the function section declares them. A thunk's row
  // carries its target's slot and node, so its name and position are the target's.
  collectCloThunks(n, gImports + fixedN + nSet)
  let tci = 0
  while tci < cloThunkFes.length {
    const rows = emitFnSpanStart.length
    const entry: u8[] = []
    emitCloThunkCode(entry, cloThunkFes[tci])
    placeCodeEntry(
      codePayload,
      entry,
      rows,
      fnStmts[cloThunkFes[tci]],
      cloThunkFes[tci],
      0,
      "",
    )
    tci = tci + 1
  }
  dfeFlush(codePayload, n)
  if nSet + cloThunkFes.length > 0 {
    rewriteCodeCount(codePayload, fixedN + nSet + cloThunkFes.length, rowsAt)
  }
  0
}

// Replace the code payload's count head (its first chunk) with `count`, moving the span rows
// banked from `rowsAt` on by the change in its width.
function rewriteCodeCount(codePayload: ByteRope, count: i32, rowsAt: i32) {
  // A failed emit pushes no chunk, and its module is discarded.
  if emitFailed || codePayload.chunks.length == 0 { return 0 }
  const head: u8[] = []
  const prev = wTarget(head)
  wULEB(count)
  wTarget(prev)
  const delta = head.length - codePayload.chunks[0].b.length
  codePayload.chunks[0] = { b: head }
  codePayload.len = codePayload.len + delta
  relRebase(delta)
  let r = rowsAt
  while r < emitFnSpanStart.length {
    emitFnSpanStart[r] = emitFnSpanStart[r] + delta
    emitFnSpanEnd[r] = emitFnSpanEnd[r] + delta
    r = r + 1
  }
  0
}

// The code entries rendered while `dfeOn` holds them back, in function-index order: the
// rendered bytes, the span rows `[rowLo, rowHi)` the render banked, the `dfeCallee` range its
// calls wrote, and the arguments passed to `placeCodeEntry`.
let dfeBuf: ByteChunk[] = []
let dfeRowLo: i32[] = []
let dfeRowHi: i32[] = []
let dfeEdgeLo: i32[] = []
let dfeEdgeHi: i32[] = []
let dfeNode: i32[] = []
let dfePos: i32[] = []
let dfeKind: i32[] = []
let dfeTag: string[] = []
// Where the next held entry's calls begin in `dfeCallee`.
let dfeEdgeAt = 0

// Start holding code entries back and recording calls. Off in an armed relocation build,
// whose units another module may call by symbol.
function dfeArm() {
  dfeOn = !RELOC_ARMED
  dfeCallee = []
  dfeEdgeAt = 0
  dfeBuf = []
  dfeRowLo = []
  dfeRowHi = []
  dfeEdgeLo = []
  dfeEdgeHi = []
  dfeNode = []
  dfePos = []
  dfeKind = []
  dfeTag = []
  0
}

// Place every held entry, replacing each function no root reaches by an `unreachable` body
// so no index moves. Roots: the start and init functions, the exports, and every function
// whose address is taken (with its thunk); a function is reached through a call one writes.
function dfeFlush(code: ByteRope, n: i32) {
  if !dfeOn { return 0 }
  dfeOn = false
  const nE = dfeBuf.length
  const live: i32[] = []
  const work: i32[] = []
  let e = 0
  while e < nE {
    live.push(0)
    if dfeKind[e] == 4 { dfeMark(live, work, e) }
    e = e + 1
  }
  for x in exportTargetSlots() { dfeMark(live, work, x) }
  let fe = 0
  while fe < n {
    if fnAddrTakenAt(fe) {
      dfeMark(live, work, fe)
      dfeMark(live, work, tableEntryFnIdx(fe) - gImports)
    }
    fe = fe + 1
  }
  while work.length > 0 {
    const at = work.pop() ?? -1
    if at >= 0 {
      let k = dfeEdgeLo[at]
      while k < dfeEdgeHi[at] {
        dfeMark(live, work, dfeCallee[k] - gImports)
        k = k + 1
      }
    }
  }
  e = 0
  while e < nE {
    if live[e] == 1 {
      placeCodeEntryRows(
        code,
        dfeBuf[e].b,
        dfeRowLo[e],
        dfeRowHi[e],
        dfeNode[e],
        dfePos[e],
        dfeKind[e],
        dfeTag[e],
      )
    } else {
      // The rows banked inside the dropped body name bytes that are gone: empty them.
      let r = dfeRowLo[e]
      while r < dfeRowHi[e] {
        emitFnSpanStart[r] = 0
        emitFnSpanEnd[r] = 0
        r = r + 1
      }
      const stub: u8[] = [3, 0, 0, 0x0b] // size 3: no locals, unreachable, end
      placeCodeEntryRows(
        code,
        stub,
        dfeRowHi[e],
        dfeRowHi[e],
        dfeNode[e],
        dfePos[e],
        dfeKind[e],
        dfeTag[e],
      )
    }
    e = e + 1
  }
  dfeBuf = []
  dfeCallee = []
  0
}

// Mark held entry `e` live and queue its calls, once. An index outside the held entries (an
// import, or a sentinel) names no body here.
function dfeMark(live: i32[], work: i32[], e: i32) {
  if e < 0 || e >= live.length || live[e] == 1 { return 0 }
  live[e] = 1
  work.push(e)
  0
}

// Append one rendered code entry to `code` and bank its whole-body span row, or hold it back
// for `dfeFlush` while `dfeOn`. The rows banked since `rows` are relative to `entry`.
function placeCodeEntry(
  code: ByteRope,
  entry: u8[],
  rows: i32,
  node: i32,
  pos: i32,
  kind: i32,
  tag: string,
) {
  if dfeOn {
    dfeBuf.push({ b: entry })
    dfeRowLo.push(rows)
    dfeRowHi.push(emitFnSpanStart.length)
    dfeEdgeLo.push(dfeEdgeAt)
    dfeEdgeHi.push(dfeCallee.length)
    dfeEdgeAt = dfeCallee.length
    dfeNode.push(node)
    dfePos.push(pos)
    dfeKind.push(kind)
    dfeTag.push(tag)
    return 0
  }
  placeCodeEntryRows(
    code,
    entry,
    rows,
    emitFnSpanStart.length,
    node,
    pos,
    kind,
    tag,
  )
}

// Append `entry` to `code`, move its span rows `[rows, rowsEnd)` by its payload offset, and
// bank its whole-body row.
function placeCodeEntryRows(
  code: ByteRope,
  entry: u8[],
  rows: i32,
  rowsEnd: i32,
  node: i32,
  pos: i32,
  kind: i32,
  tag: string,
) {
  const at = code.len
  let r = rows
  while r < rowsEnd {
    emitFnSpanStart[r] = emitFnSpanStart[r] + at
    emitFnSpanEnd[r] = emitFnSpanEnd[r] + at
    r = r + 1
  }
  relPlace(entry, at)
  ropePush(code, entry)
  bankFnSpan(node, pos, at, at + entry.length, kind, tag)
}

// Code section (id 10): frame the payload `buildCodePayload` produced onto the module, then
// rebase the body spans onto it.
function writeCodeSection(codePayload: ByteRope) {
  wSectionRope(10, codePayload)
  // Rebases the payload-relative spans onto the module (D1578). `wSectionRope` has just appended
  // the payload to the module rope, so `W.len - codePayload.len` is where it starts — a
  // module offset being exactly the coordinate the engine's validator reports. Derived from the length, not the section header's own width, so the ULEB size prefix cannot be counted wrong.
  const codeBase = W.len - codePayload.len
  relRebase(codeBase)
  let sp = 0
  while sp < emitFnSpanStart.length {
    emitFnSpanStart[sp] = emitFnSpanStart[sp] + codeBase
    emitFnSpanEnd[sp] = emitFnSpanEnd[sp] + codeBase
    sp = sp + 1
  }
  0
}

// A declaration the monomorphizer copied reads its annotation's type, which is this
// instance's; with no typed annotation, the type the checker recorded for its source.
function copiedDeclTysCarry() {
  for c in nodeSrc.keys() {
    const n = nodeAt(c)
    if n is LetDecl && nodeTyIxOf(c) < 0 {
      const at = if n.letType >= 0 { nodeTyIxOf(n.letType) } else { -1 }
      if at >= 0 {
        nodeTyRecord(c, at)
      } else {
        nodeTyCarry(c, nodeSrc[c] ?? -1)
      }
    }
  }
  0
}
