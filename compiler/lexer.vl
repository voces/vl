import { cpCount } from "./strutil"

// A lexer for VL, written in VL — the self-hosted counterpart of
// `compiler/lexer.ts`. It mirrors the host's token set and scanning rules — the
// same keywords, the same one/two-char operator tables, the same number /
// string / char grammar and escape set — but is idiomatic VL, not a
// transliteration. It scans:
//   - identifiers and keywords,
//   - integer / real number literals (`12`, `3.14`, `1.5e-7`),
//   - char literals `'a'` and string literals `"..."`, both with the shared
//     escape grammar `\n \t \r \\ \" \' \0 \b \f \v \xXX \uXXXX \u{…}`,
//   - INTERPOLATION HOLES, spelled `\{expr}` and legal in BOTH quoted forms —
//     `"v=\{x}"` and `` `v=\{x}` `` are the same construct. A literal holding
//     one is scanned as a SPLIT token run (`TEMPLATE_HEAD` / `TEMPLATE_MID` /
//     `TEMPLATE_TAIL`) with the hole EXPRESSIONS lexed as ordinary tokens in
//     between, the JS-lexer shape; a literal holding none stays ONE token
//     (`STRING` or `TEMPLATE`). The run kinds keep their `TEMPLATE_` spelling
//     because the machinery is one and it was built for templates — both forms
//     mint them, and every consumer treats them identically.
//   - backtick TEMPLATE literals `` `text` `` — the multiline form: a raw
//     newline is CONTENT there and a terminator inside `"`, which is the ONLY
//     rule the two literal grammars still disagree about,
//   - the full one- and two-char operator / punctuation set,
//   - `//` line comments and `///` doc comments (retained as trivia in
//     `gComments`, not emitted into the token stream),
//   - whitespace and significant newlines (NEWLINE is a real token, as in the TS
//     lexer; the parser treats it as a statement terminator).
//
// Positions follow the diagnostics convention: `line` is 1-based, `col` is
// 0-based; `start`/`stop` are char offsets into the source (first char, and one
// past the last) so a token span measures source extent.

// ---- token kinds ---------------------------------------------------------
// The CLOSED token vocabulary, as a literal union. This is the token-kind
// ENUMERATION: a literal-union value is represented as an i32 ATOM, so `kind`
// costs one i32 field, every `kind == "IDENT"` lowers to `i32.eq` against a
// constant, and no `__str_eq__` call is made anywhere on the token path.
//
// The SPELLING is minted FROM the atom, never carried beside it: a `TokKind` in
// a `string` position (the `kindDesc`/`foundDesc` fallbacks that render a kind
// tag into an `expected …` message) materialises the pooled literal from the
// atom. A token therefore never holds both representations, and the two cannot
// drift apart.
//
// The checker is a COMPLETE ORACLE over this vocabulary: comparing a `TokKind`
// against a spelling that is not a member is a hard type error ("not a member of
// the union"), so a typo'd or dropped kind cannot compile. That is what makes a
// vocabulary this wide safe to thread through ~570 use sites.
//
// `""` is the NO-MATCH sentinel `oneCharKind`/`twoCharKind`/`threeCharKind`
// return; it is a member so those functions stay total. Members are grouped
// open-class / structural / keyword / punctuation / operator for reading only —
// nothing depends on the ORDER (the atom numbering is the emitter's business).
export type TokKind = ""
  | "IDENT"
  | "NUMBER"
  | "STRING"
  | "CHAR"
  | "TEMPLATE"
  | "TEMPLATE_HEAD"
  | "TEMPLATE_MID"
  | "TEMPLATE_TAIL"
  | "NEWLINE"
  | "EOF"
  | "ERROR"
  | "IF"
  | "IS"
  | "IMPORT"
  | "FUNCTION"
  | "FOR"
  | "FALSE"
  | "CONST"
  | "CONTINUE"
  | "ELSE"
  | "EXPORT"
  | "TYPE"
  | "TRUE"
  | "RETURN"
  | "LET"
  | "WHILE"
  | "AWAIT"
  | "BREAK"
  | "MATCH"
  | "NULL"
  | "LPAREN"
  | "RPAREN"
  | "LBRACE"
  | "RBRACE"
  | "LBRACK"
  | "RBRACK"
  | "COMMA"
  | "SEMI"
  | "DOT"
  | "COLON"
  | "QUESTION"
  | "TILDE"
  | "PLUS"
  | "MINUS"
  | "STAR"
  | "SLASH"
  | "PERCENT"
  | "CARET"
  | "EQUAL"
  | "BANG"
  | "GT"
  | "LT"
  | "PIPE"
  | "AMPERSAND"
  | "PLUSPLUS"
  | "MINUSMINUS"
  | "PLUSEQ"
  | "MINUSEQ"
  | "STAREQ"
  | "SLASHEQ"
  | "SHL"
  | "AND"
  | "OR"
  | "QUESTION_DOT"
  | "QUESTION_QUESTION"
  | "EQ"
  | "NE"
  | "GE"
  | "LE"
  | "SHR"
  | "USHR"

// A lexer diagnostic: a message plus the 1-based line / 0-based column where it
// was raised. Positions are kept numeric and rendered at the
// harness, mirroring the structured `VLDiagnostic` the TS lexer pushes.
//
// `endCol` is the 0-based EXCLUSIVE end column of the offending SPAN, on the same
// line as `col` (`endCol - col` is the caret width the CLI draws, and the LSP
// range's end). A lex diag carries no token anchor, so `diagEndCol` has nothing to
// derive a width from and every one of these used to render as a single-column
// caret; a literal that IS the offence (`'xy'`) has to carry its own end. `col`
// means "no span" — the point rendering, which is right for a diagnostic about one
// character (a stray `_`, a bad escape) and is what `diag`/`diagAt` supply.
// A quoted literal never spans lines (a raw newline terminates it), so one column
// pair covers every span this type carries.
type Diag = {
  msg: string,
  line: i32,
  col: i32,
  endCol: i32
}

// A lexed token.
//   kind  — the closed `TokKind` tag (keyword/literal/operator/structural name),
//           an i32 atom.
//   text  — the raw source lexeme (quotes + backslashes kept for STRING/CHAR).
//   value — for STRING/CHAR: the decoded literal with escapes resolved
//           (including `\xXX` / `\uXXXX` / `\u{…}` via `fromCodePoint`); ""
//           otherwise.
//   start/stop — char offsets [first, one-past-last).
//   line/col   — 1-based line, 0-based column of the first char.
type Tok = {
  kind: TokKind,
  text: string,
  value: string,
  start: i32,
  stop: i32,
  line: i32,
  col: i32
}

// A retained `//` (or doc `///`) comment. Kept OUT of `tokens` so the parser's
// peek/lookahead is untouched — comments are metadata for the formatter / doc
// cross-refs, not grammar tokens. `text` is the VERBATIM lexeme including the
// leading `//`; `start`/`line`/`col` anchor it (char offset, 1-based line,
// 0-based col); `trailing` is true when it sits on the SAME source line AFTER a
// real token (`let x = 1 // c`), false when it stands on its own line. Native
// counterpart of the host lexer's `Comment` (`kind`/`placement`). Defined BEFORE
// `LexResult` so the frozen TS host (which does not hoist type aliases) resolves
// the forward reference.
type Comment = {
  doc: boolean,
  text: string,
  start: i32,
  line: i32,
  col: i32,
  trailing: boolean
}

// The result of lexing: the token stream (EOF-terminated), any diagnostics, and
// the retained comment trivia.
export type LexResult = {
  tokens: Tok[],
  diags: Diag[],
  comments: Comment[]
}

// ---- scanner state (ref-typed module globals) ----------------------------
// The source and cursor travel together for every helper, so they live as
// module globals (including the ref-typed source string and diag array) rather
// than a struct threaded to each call.

export let gSrc = ""
let gPos = 0
let gLine = 1
let gCol = 0
export let gDiags: Diag[] = []
let gComments: Comment[] = []

// ---- interpolated-literal scanner state ----------------------------------
// An interpolated literal is CONTEXT-SENSITIVE: the `}` that ends a hole is
// spelled exactly like the `}` that closes a block, so the scanner has to know
// which one it is looking at. It does, from two numbers: the `{` nesting depth
// (`gBrace`) and, per OPEN hole, the depth that hole started at (`gTplBrace`). A
// `}` resumes the literal iff the depth matches the innermost open hole's —
// every deeper `}` is an ordinary closer. Interpolated literals therefore NEST
// for free (a hole may hold another; each pushes its own row), and the stack is
// the whole reason no re-lexing or bracket-matching pre-pass is needed.
//
// `gTplOpenLine`/`gTplOpenCol`/`gTplOpenPos` are parallel to `gTplBrace`: the
// position of the literal's OPENING DELIMITER, kept so an unterminated one
// reports there rather than at the `}` of whichever part ran off the end. The
// char OFFSET rides along because a SPAN needs it — see `tplLineEndCol`.
//
// `gTplQuote` is the run's DELIMITER (`"` or `` ` ``), and it is what makes ONE
// split-run machinery serve both literal forms: the `}` arm resumes the run in
// the mode it opened in (a `"` run still refuses a raw newline; a backtick run
// still takes one as content), and the unterminated report names the literal the
// author actually opened. Without it a `"a\{x}` and a `` `a\{x} `` would have to
// be two scanners with two escape decoders — the split the template entry was
// built to avoid.
let gTplStop = 0 // why the last part stopped: 0 = closing delimiter, 1 = `\{`, 2 = ran out of input
let gTplOpenLine: i32[] = []
let gTplOpenCol: i32[] = []
let gTplOpenPos: i32[] = []
let gTplBrace: i32[] = []
let gTplQuote: i32[] = []
let gBrace = 0

// ---- character classes (char literals) -----------------------------------

function isDigit(c: i32) { c >= '0' && c <= '9' }

function isIdStart(c: i32) {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

function isIdPart(c: i32) { isIdStart(c) || isDigit(c) }

function isHex(c: i32) {
  isDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

// The numeric value of a hex digit char code (0-15); -1 if not a hex digit.
function hexVal(c: i32) {
  if c >= '0' && c <= '9' { return c - '0' }
  if c >= 'a' && c <= 'f' { return c - 'a' + 10 }
  if c >= 'A' && c <= 'F' { return c - 'A' + 10 }
  -1
}

// One uppercase hex digit char for `d` in 0..15 (the inverse of `hexVal`).
function hexDigit(d: i32) {
  if d < 10 { return fromCodePoint('0' + d) }
  fromCodePoint('A' + (d - 10))
}

// Describe a char code for a diagnostic: quoted verbatim when printable,
// `U+XXXX` (4+ uppercase hex digits) for controls and other unprintables.
function charDesc(c: i32) {
  if c >= ' ' && c != 127 { return "'" + fromCodePoint(c) + "'" }
  let hex = ""
  let m = c
  while m > 0 {
    hex = hexDigit(m % 16) + hex
    m = m / 16
  }
  while hex.length < 4 { hex = "0" + hex }
  "U+" + hex
}

// A binary digit `0` / `1` (for `0b…` literals).
function isBinDigit(c: i32) { c == '0' || c == '1' }

// '0'..'7' — the octal digit set (`0o` literals).
function isOctDigit(c: i32) { c >= '0' && c <= '7' }

// A digit of the given base (16 hex / 2 binary / 8 octal / else decimal).
function isRadixDigit(c: i32, base: i32) {
  if base == 16 { return isHex(c) }
  if base == 2 { return isBinDigit(c) }
  if base == 8 { return isOctDigit(c) }
  isDigit(c)
}

// ---- scanner primitives --------------------------------------------------

// The char code at the current position, or -1 at end of input.
export function peek() {
  if gPos >= gSrc.length { return -1 }
  gSrc[gPos]
}

// The char code one past the current position, or -1 if none.
function peek2() {
  if gPos + 1 >= gSrc.length { return -1 }
  gSrc[gPos + 1]
}

// The char code `n` past the current position, or -1 if none.
function peekN(n: i32) {
  if gPos + n >= gSrc.length { return -1 }
  gSrc[gPos + n]
}

// Consume one char, tracking line/column, and return its code. A line ends at
// `\n` or at a lone `\r` (classic-Mac / stray-CR input) — a `\r` that is part
// of `\r\n` defers the bump to the `\n` so the pair counts as one line.
export function advance() {
  const c = gSrc[gPos]
  gPos = gPos + 1
  if c == '\n' || (c == '\r' && peek() != '\n') {
    gLine = gLine + 1
    gCol = 0
  } else {
    gCol = gCol + 1
  }
  c
}

// Record a diagnostic at the current position. Returns the diagnostic count
// (VL has no `void`; functions infer their return type).
export function diag(msg: string) {
  gDiags.push({ msg: msg, line: gLine, col: gCol, endCol: gCol })
  gDiags.length
}

// Record a diagnostic at an explicit position (1-based line, 0-based column) —
// for reports that anchor at a construct's START (an opening quote, a
// backslash) after the scanner has already moved past it.
function diagAt(msg: string, line: i32, col: i32) {
  gDiags.push({ msg: msg, line: line, col: col, endCol: col })
  gDiags.length
}

// `diagAt` with a SPAN: the report covers `[col, endCol)` on `line` rather than
// rendering as a point. For a diagnostic whose subject is a whole lexeme the
// scanner has just consumed — a char literal of the wrong length, an unterminated
// quote — where `gCol` is already sitting one past it.
function diagSpan(msg: string, line: i32, col: i32, endCol: i32) {
  gDiags.push({ msg: msg, line: line, col: col, endCol: endCol })
  gDiags.length
}

// ---- keyword + operator tables -------------------------------------------
// Linear `==` chains: VL maps (B6a) aren't available yet, and a string-keyed map
// for ~22 keywords / ~31 operators would not buy much here. The tables mirror
// `KEYWORDS` / `TWO_CHAR` / `ONE_CHAR` in compiler/lexer.ts exactly.

// THE VOCABULARY IS CLOSED AND THE DISPATCH IS ON THE FIRST CHARACTER, not on the whole
// string 19 times. Every identifier-shaped token in the program reaches this function, and the
// straight `==` chain it replaced ran up to 19 `__str_eq__` CALLS to answer "IDENT" — the
// answer for the overwhelming majority. Measured on a self-compile at `1517c7f6` (12 warm guest
// profiles, 20,985 samples): 0.76% of all samples were `__str_eq__` reached from here, the
// largest single member of the token-kind string class (2.47% in total).
//
// The shape below is a first-character bucket (at most three keywords share one, and only
// `if`/`is` and `type`/`true` need a second character to separate) so a non-keyword costs one
// character read plus a run of i32 compares, and a keyword costs at most one `__str_eq__`.
// This is the ANSWER TO "keywordKind on interned ids" and it is a NO: interning would move the
// cost from 19 length compares to one HASH of every identifier token in the program, paid at
// the densest point in the pipeline, to answer a question a closed 19-element vocabulary
// answers from two characters. See `docs/internals/identifier-interning-design.md` §4.1.
//
// Byte-for-byte the same function: the keyword set, the spellings and the "IDENT" default are
// unchanged, and the self-compile is the exhaustive test — the compiler's own source uses every
// one of these 19 keywords, so a mis-bucketed entry cannot survive the fixpoint ladder.
//
// THIS FUNCTION IS THE AUTHORITY FOR "WHAT IS A HARD KEYWORD", and four other lists copy it:
// `lexClassOf` (`driver.vl`, the LSP's semantic-token class), `VL_HARD_KEYWORDS`
// (`lsp/src/typeFeatures.ts`, feeding completion + rename's reserved-name refusal), the
// TextMate grammar (`lsp/syntaxes/vital.tmLanguage.json`) and the playground's Monarch table
// (`playground/src/main.ts`). Three of the four had never learned `match`, and the LSP
// consequently ACCEPTED renaming a binding to `match` — producing a file that does not parse.
// `tests/keyword_vocabulary_test.ts` now DERIVES the set from the `return "…"` arms below and
// fails every list that disagrees, so a keyword added here reddens the gate until all four
// follow. Adding one therefore means: add the arm, then run that test and do what it names.
// (Its companion half derives the CONTEXTUAL keywords from `parser.vl`'s `peekTok().text ==`
// guards — `as`/`in`/`to`/`step`/`new`/`flat` — which are NOT reserved and must not move here:
// `const new = 1` and `const flat = 2` both run, measured.)
function keywordKind(text: string): TokKind {
  const n = text.length
  if n < 2 || n > 8 { return "IDENT" }
  const c = text[0]
  if c == 'i' {
    if n == 2 {
      if text[1] == 'f' { return "IF" }
      if text[1] == 's' { return "IS" }
      return "IDENT"
    }
    if text == "import" { return "IMPORT" }
    return "IDENT"
  }
  if c == 'f' {
    if text == "function" { return "FUNCTION" }
    if text == "for" { return "FOR" }
    if text == "false" { return "FALSE" }
    return "IDENT"
  }
  if c == 'c' {
    if text == "const" { return "CONST" }
    if text == "continue" { return "CONTINUE" }
    return "IDENT"
  }
  if c == 'e' {
    if text == "else" { return "ELSE" }
    if text == "export" { return "EXPORT" }
    return "IDENT"
  }
  if c == 't' {
    if text == "type" { return "TYPE" }
    if text == "true" { return "TRUE" }
    return "IDENT"
  }
  if c == 'r' {
    if text == "return" { return "RETURN" }
    return "IDENT"
  }
  if c == 'l' {
    if text == "let" { return "LET" }
    return "IDENT"
  }
  if c == 'w' {
    if text == "while" { return "WHILE" }
    return "IDENT"
  }
  if c == 'a' {
    if text == "await" { return "AWAIT" }
    return "IDENT"
  }
  if c == 'b' {
    if text == "break" { return "BREAK" }
    return "IDENT"
  }
  if c == 'm' {
    if text == "match" { return "MATCH" }
    return "IDENT"
  }
  if c == 'n' {
    if text == "null" { return "NULL" }
    return "IDENT"
  }
  "IDENT"
}

// Single-char operator/punctuation kind for char code `c`, or "" if none.
// `;` lexes as `SEMI`, an OPTIONAL statement separator the block / top-level loops
// treat exactly like a NEWLINE (so `a(); b()` works) — a standalone `?` is still not
// a token and falls through to the unexpected-character path.
function oneCharKind(c: i32): TokKind {
  if c == '+' { return "PLUS" }
  if c == '-' { return "MINUS" }
  if c == '*' { return "STAR" }
  if c == '/' { return "SLASH" }
  if c == '%' { return "PERCENT" }
  if c == '^' { return "CARET" }
  if c == '=' { return "EQUAL" }
  if c == '!' { return "BANG" }
  if c == '>' { return "GT" }
  if c == '<' { return "LT" }
  if c == '(' { return "LPAREN" }
  if c == ')' { return "RPAREN" }
  if c == '{' { return "LBRACE" }
  if c == '}' { return "RBRACE" }
  if c == '[' { return "LBRACK" }
  if c == ']' { return "RBRACK" }
  if c == ',' { return "COMMA" }
  if c == ';' { return "SEMI" }
  if c == '.' { return "DOT" }
  if c == ':' { return "COLON" }
  if c == '|' { return "PIPE" }
  if c == '&' { return "AMPERSAND" }
  // A lone `?` — the OPTIONAL-PARAMETER marker (`a?: i32`). `?.` and `??` are
  // longer matches and are taken first, so this only fires where neither does.
  if c == '?' { return "QUESTION" }
  if c == '~' { return "TILDE" }
  ""
}

// Two-char operator kind for the pair (a, b), or "" if none. Mirrors TWO_CHAR.
function twoCharKind(a: i32, b: i32): TokKind {
  if a == '+' && b == '+' { return "PLUSPLUS" }
  if a == '-' && b == '-' { return "MINUSMINUS" }
  // Compound assignment (`a += b` desugars to `a = a + (b)` in the parser).
  if a == '+' && b == '=' { return "PLUSEQ" }
  if a == '-' && b == '=' { return "MINUSEQ" }
  if a == '*' && b == '=' { return "STAREQ" }
  if a == '/' && b == '=' { return "SLASHEQ" }
  // `<<` left shift. Unlike the closing `>>` of a nested generic, `<<` never
  // collides with generics (two OPENING angles never abut), so it is one token.
  if a == '<' && b == '<' { return "SHL" }
  if a == '&' && b == '&' { return "AND" }
  if a == '|' && b == '|' { return "OR" }
  if a == '?' && b == '.' { return "QUESTION_DOT" }
  if a == '?' && b == '?' { return "QUESTION_QUESTION" }
  if a == '=' && b == '=' { return "EQ" }
  if a == '!' && b == '=' { return "NE" }
  if a == '>' && b == '=' { return "GE" }
  if a == '<' && b == '=' { return "LE" }
  // Bitwise shifts. `>>` is the signed (arithmetic) right shift. VL is
  // generics-free, so — unlike the TS host (whose `>>` collides with a nested
  // generic close `Box<Pair<T,U>>` and is recombined in the parser) — `>>` can
  // be a single lexer token here. `>>>` is handled first as a three-char token.
  if a == '>' && b == '>' { return "SHR" }
  ""
}

// Three-char operator kind for the triple (a, b, c), or "" if none. Checked
// before `twoCharKind` (longest match first). Only `>>>` (unsigned/logical
// right shift) lives here — the `>>>` of the LEB encoders' byte extraction.
function threeCharKind(a: i32, b: i32, c: i32): TokKind {
  if a == '>' && b == '>' && c == '>' { return "USHR" }
  ""
}

// ---- escape decoding -----------------------------------------------------
// Decode a simple escape character `e` (the char after a backslash) to the
// string it denotes, for the single-char escapes. `\xXX` / `\uXXXX` / `\u{…}`
// are handled by the scanner before calling this (they need hex digits + a
// `fromCodePoint`). Returns the decoded fragment, or "" for an unknown escape,
// which the caller renders as the verbatim char (matching the TS lexer's
// lenient policy).
function decodeSimpleEscape(e: i32) {
  if e == 'n' { return "\n" }
  if e == 't' { return "\t" }
  if e == 'r' { return "\r" }
  if e == '\\' { return "\\" }
  if e == '"' { return "\"" }
  if e == '\'' { return "'" }
  if e == '0' { return fromCodePoint(0) }
  if e == 'b' { return fromCodePoint(8) }
  if e == 'f' { return fromCodePoint(12) }
  if e == 'v' { return fromCodePoint(11) }
  ""
}

// ---- token builder -------------------------------------------------------

export function mkTok(
  kind: TokKind,
  value: string,
  start: i32,
  startLine: i32,
  startCol: i32,
): Tok {
  {
    kind: kind,
    text: gSrc.slice(start, gPos),
    value: value,
    start: start,
    stop: gPos,
    line: startLine,
    col: startCol,
  }
}

// Scan the digit run of a base-prefixed integer (`0x`/`0b`/`0o`), the prefix
// ALREADY consumed. Validates digits + `_` separators and emits at most one lex
// diagnostic; consumes any trailing identifier run so a malformed suffix (`0xG`,
// `0x_FF`) never cascades into a separate "undeclared identifier". The caller
// pushes the (recovery) NUMBER token from the span. Returns the diag count.
// NOTE: condition expressions store each `isRadixDigit`/`isIdPart` call in a
// BOOL LOCAL first — the frozen TS host emitter drops a bare boolean call used
// directly as an `if` condition (the native emitter handles it), so mirror the
// existing lexer's `let c = peek(); if isIdStart(c)` shape.
function scanRadix(base: i32, baseName: string, prefixChar: i32) {
  let any = false
  let bad = false
  while gPos < gSrc.length {
    const p = peek()
    const pIsDigit = isRadixDigit(p, base)
    const p2IsDigit = isRadixDigit(peek2(), base)
    if pIsDigit {
      advance()
      any = true
    } else if p == '_' && any && p2IsDigit {
      // A separator is legal only BETWEEN two digits.
      advance()
    } else if p == '_' {
      // A separator at the start, doubled, or trailing (`0x_F`, `0xF__F`, `0xF_`).
      diag("`_` may only separate digits in a numeric literal")
      bad = true
      break
    } else {
      break
    }
  }
  if !bad {
    const pc = peek()
    const stray = isIdPart(pc)
    if !any && stray {
      // No valid digit, a stray id char names the bad digit (`0xG`).
      diag("invalid " + baseName + " digit '" + fromCodePoint(pc) + "'")
      bad = true
    } else if !any {
      // Nothing usable after the prefix (`0x`).
      diag(
        baseName +
          " literal has no digits after `0" +
          fromCodePoint(prefixChar) +
          "`",
      )
      bad = true
    } else if stray {
      // Digits, then a non-base id char (`0xFG`).
      diag("invalid " + baseName + " digit '" + fromCodePoint(pc) + "'")
      bad = true
    }
  }
  if bad {
    while gPos < gSrc.length && isIdPart(peek()) { advance() }
  }
  gDiags.length
}

// ---- string / char scanning ----------------------------------------------
// Scan a quoted literal (the cursor is on the opening quote). `quote` is the
// quote char code. Returns the decoded `value` with escapes resolved; `\xXX` /
// `\uXXXX` / `\u{…}` decode to the actual code point via `fromCodePoint`.
//
// The decoded value is built from `[runStart, gPos)` RUNS of escape-free text —
// one slice per run, concatenating only at escape boundaries — rather than one
// slice per character (which is O(k²) on immutable strings). Every branch that
// consumes non-run input (an escape, the closing quote) flushes the pending run
// first and re-anchors `runStart`; the tail flush after the loop covers the
// unterminated paths.
export function scanQuoted(quote: i32) {
  // The opening quote anchors the unterminated-literal diagnostic: reporting
  // there (not wherever scanning stopped) keeps a missing quote a local error.
  const openLine = gLine
  const openCol = gCol
  // TEMPLATE MODE — `quote == '`'`. Exactly TWO rules differ from `"` and
  // nothing else does: a raw newline is CONTENT (templates are multiline, as in
  // JS, and that is the one thing the `"` form still refuses), and ``\` `` joins
  // the escape set because a backtick is the delimiter there.
  //
  // HOLE MODE — `"` and `` ` ``, never `'`. A `\{` ENDS the part (recorded in
  // `gTplStop`, since VL functions return one value); the "opening quote" the
  // scan consumes is the literal's own delimiter for a HEAD/whole run and a `}`
  // for a MID/TAIL part. ONE scanner for all of it, which is what keeps the
  // escape grammar single-sourced across two literal forms and four part kinds.
  //
  // A char literal is deliberately NOT in hole mode: `'\{'` keeps its
  // "Unknown escape sequence", because a char literal is one code point and a
  // hole could never be one.
  const tpl = quote == '`'
  const holes = tpl || quote == '"'
  if holes { gTplStop = 2 }
  advance() // opening quote
  let value = ""
  let closed = false
  let runStart = gPos
  while gPos < gSrc.length {
    const ch = peek()
    // A raw newline terminates the literal: the closing quote is missing.
    // The newline is left in the input (it becomes an ordinary NEWLINE token),
    // so one missing quote yields a single local error at the opening quote
    // instead of masking every later error up to EOF.
    if !tpl && (ch == '\n' || ch == '\r') { break }
    // A HOLE OPENS. The trigger lives in the ESCAPE NAMESPACE — `\{`, not `${`
    // — and that is what makes interpolation additive to the `"` form at zero
    // cost: `{` stays an ordinary character in every string forever (4,821
    // in-tree literals carry one), while `"a\{b"` was an "Unknown escape
    // sequence" error before this and so had no meaning to break. Tested BEFORE
    // the escape arm below, so `\{` never reaches `decodeSimpleEscape`; `\\{` is
    // therefore a literal backslash followed by a literal brace, since the first
    // backslash is consumed by the `\\` escape and the `{` is read as text.
    if holes && ch == '\\' && peek2() == '{' {
      value = value + gSrc.slice(runStart, gPos)
      advance() // backslash
      advance() // {
      runStart = gPos
      closed = true
      gTplStop = 1
      break
    }
    if ch == '\\' {
      value = value + gSrc.slice(runStart, gPos)
      // Escape diagnostics anchor at the backslash, not the scan position
      // after the sequence has been consumed.
      const escLine = gLine
      const escCol = gCol
      advance() // backslash
      if gPos >= gSrc.length {
        runStart = gPos
        break
      }
      const e = peek()
      // The ONE template-only escape: a template's own delimiter. Handled before
      // `decodeSimpleEscape` so the `"` grammar is unchanged — ``"\`"`` keeps
      // warning "Unknown escape sequence" exactly as it did.
      //
      // `\$` USED TO BE THE OTHER ONE and is RETIRED: with the hole trigger in
      // the escape namespace, `$` is an ordinary character in a template again
      // and needs no escape, so keeping `\$` would be a second spelling for
      // "the character `$`" that only one of the two literal forms accepted —
      // exactly the grammar split this change exists to close. It falls through
      // to the unknown-escape arm below, which names it.
      if tpl && e == '`' {
        advance() // the escaped delimiter
        value = value + fromCodePoint(e)
        runStart = gPos
        continue
      }
      // \xXX — two hex digits.
      if e == 'x' {
        if isHex(peek2()) && isHex(peekN(2)) {
          advance() // x
          const h1 = advance()
          const h2 = advance()
          value = value + fromCodePoint(hexVal(h1) * 16 + hexVal(h2))
        } else {
          advance() // x
          diagAt("Invalid \\x escape (needs two hex digits)", escLine, escCol)
          value = value + "x"
        }
        runStart = gPos
        continue
      }
      // \uXXXX — four hex digits — or \u{…} — 1-6 hex digits.
      if e == 'u' {
        if peek2() == '{' {
          // \u{…}: scan hex digits until `}`, decode the code point.
          advance() // u
          advance() // {
          let cp = 0
          let n = 0
          while gPos < gSrc.length && peek() != '}' && isHex(peek()) {
            cp = cp * 16 + hexVal(advance())
            n = n + 1
          }
          if peek() == '}' && n >= 1 && n <= 6 && cp <= 1114111 {
            advance() // }
            value = value + fromCodePoint(cp)
          } else {
            diagAt(
              "Invalid \\u{…} escape (needs 1-6 hex digits for a valid code point)",
              escLine,
              escCol,
            )
            value = value + "u"
            // Consume a closing `}` if present so the span stays sane.
            if peek() == '}' { advance() }
          }
          runStart = gPos
          continue
        }
        if (
          isHex(peek2()) &&
          isHex(peekN(2)) &&
          isHex(peekN(3)) &&
          isHex(peekN(4))
        ) {
          advance() // u
          const u1 = advance()
          const u2 = advance()
          const u3 = advance()
          const u4 = advance()
          const cp = hexVal(u1) * 4096 +
            hexVal(u2) * 256 +
            hexVal(u3) * 16 +
            hexVal(u4)
          value = value + fromCodePoint(cp)
        } else {
          advance() // u
          diagAt(
            "Invalid \\u escape (needs four hex digits or \\u{…})",
            escLine,
            escCol,
          )
          value = value + "u"
        }
        runStart = gPos
        continue
      }
      // Line continuation: a backslash immediately before a newline drops both.
      if e == '\n' || e == '\r' {
        advance() // the newline char
        if e == '\r' && peek() == '\n' { advance() }
        runStart = gPos
        continue
      }
      // Simple escape (\n \t \r \\ \" \' \0 \b \f \v) or unknown (verbatim char).
      advance() // the escaped char
      const dec = decodeSimpleEscape(e)
      if dec == "" {
        // Unknown escape: keep the char after the backslash verbatim, and warn.
        //
        // `\$` gets its own sentence — and gets it in BOTH literal forms, so no
        // second escape grammar appears. It is the one spelling this change
        // RETIRED (it was a template escape for the week `${` was the hole
        // trigger), so the generic message would leave a reader with working
        // code from six days ago no idea what happened. `${` needs no such arm:
        // it does not become an error, it becomes ordinary text, and inventing a
        // diagnostic for a legal program to warn about a week-old spelling is
        // speculative — measured, ZERO `${` remain in tree after the migration.
        if e == '$' {
          diagAt(
            "`\\$` is not an escape — write `$` (an interpolation hole is `\\{…}`)",
            escLine,
            escCol,
          )
        } else {
          diagAt("Unknown escape sequence", escLine, escCol)
        }
        runStart = gPos - 1
      } else {
        value = value + dec
        runStart = gPos
      }
      continue
    }
    if ch == quote {
      value = value + gSrc.slice(runStart, gPos)
      advance() // closing quote
      runStart = gPos
      closed = true
      if holes { gTplStop = 0 }
      break
    }
    advance()
  }
  value = value + gSrc.slice(runStart, gPos)
  if !closed {
    // AN INTERPOLABLE LITERAL'S "unterminated" REPORT IS THE CALLER'S — only the
    // caller knows where the OPENING DELIMITER was (a MID/TAIL part opens at a
    // `}`, a whole literal away), and only the caller can measure a span for a
    // literal that may be MULTILINE. `gTplStop` carries the verdict there, and
    // `gTplQuote` tells the caller which literal to name.
    //
    // A char literal still reports HERE, spanning the opening quote through
    // whatever the scan reached (the raw newline that broke the loop, or EOF) —
    // the whole run the reader has to look at. That is sound for `'` precisely
    // because a raw newline terminates it, so `gCol` is still on `openLine`.
    // For a `"` run the caller re-derives the identical span (see the `"` arm in
    // `tokenize`): the scan stopped either at that newline or at EOF, so
    // `openCol`..`gCol` and the caller's `openCol`..`gCol` are the same pair.
    if holes {
      gTplStop = 2
    } else {
      diagSpan("Unterminated char literal", openLine, openCol, gCol)
    }
  }
  value
}

// The `"`-quoted STRING LEXEME that means what template part `raw` means — the
// one bridge between the two literal grammars, and a purely LEXICAL rewrite (no
// decode/re-encode round trip, so no second escape decoder exists to drift from
// `scanQuoted`'s).
//
// `raw` is a part's verbatim source lexeme, delimiters included: `` `a\{ ``,
// `}b\{`, `}c` ``, `"a\{`, `}c"`, or a whole `` `d` `` / `"d"`. One leading char
// is always a delimiter (the literal's own quote, or a `}`); the trailing one is
// that quote (1 char) or a `\{` (2).
//
// IT IS DELIMITER-AGNOSTIC ON PURPOSE — both literal forms mint the same part
// kinds and both reach here, so one rewrite serves `"a\{x}b"` and `` `a\{x}b` ``
// alike. The only place the form is even visible is the trailing-delimiter test,
// which accepts either quote.
//
// THE TWO GRAMMARS SHARE THEIR ESCAPE SET, which is what makes the rewrite a
// copy almost everywhere: `\n`, `\xNN`, `\u{…}`, `\\` and the rest are the same
// sequence on both sides and are copied WHOLE (the escaped character included,
// so a `\\` can never be re-read as an escape opener). Exactly three characters
// differ, and each has one rule:
//   ``\` ``         — the template-only escape; a backtick is ordinary inside
//                     `"`, so the backslash is DROPPED.
//   `"`             — ordinary inside a template, a terminator inside `"`, so
//                     it gains a backslash.
//   a raw newline / CR — content inside a template (multiline), a terminator
//                     inside `"`, so it becomes `\n` / `\r`.
// (`\$` was the fourth until the hole trigger moved into the escape namespace.
// It is no longer an escape in EITHER grammar, so it is copied whole like any
// other unknown escape and decodes to `$` on both sides.)
// A backslash-newline (line continuation) is copied by the escape arm above and
// never reaches the newline rule, so it keeps meaning "drop both".
//
// Built from RUNS (`[runStart, i)` slices) rather than character by character:
// `.length` is a BYTE count since Stage 2c, so a multi-byte character must be
// copied by SLICE — re-minting it through `fromCodePoint` would re-encode a
// single byte of it as its own code point.
export function tplPartStrLex(raw: string): string {
  const n = raw.length
  const q = "\""
  if n < 1 { return q + q }
  // The trailing delimiter: the literal's own quote (1 char) or a hole-opening
  // `\{` (2). A part that ends with NEITHER came from an unterminated literal —
  // already a lex error — and keeps everything, which is what leaves the
  // recovery lexeme well-formed.
  let stop = n
  if raw[n - 1] == '`' || raw[n - 1] == '"' { stop = n - 1 }
  else if n >= 2 && raw[n - 2] == '\\' && raw[n - 1] == '{' { stop = n - 2 }
  const start = 1
  if stop <= start { return q + q }
  let out = q
  let runStart = start
  let i = start
  while i < stop {
    const ch = raw[i]
    if ch == '\\' {
      if i + 1 >= stop {
        // A dangling backslash — reachable only from an unterminated template,
        // which is already a lex error. Dropped so the lexeme this returns is
        // still well-formed for the parse that recovers past it.
        out = out + raw.slice(runStart, i)
        i = i + 1
        runStart = i
      } else {
        const e = raw[i + 1]
        if e == '`' {
          out = out + raw.slice(runStart, i) + raw.slice(i + 1, i + 2)
          i = i + 2
          runStart = i
        } else {
          i = i + 2
        }
      }
    } else if ch == '"' {
      out = out + raw.slice(runStart, i) + "\\\""
      i = i + 1
      runStart = i
    } else if ch == '\n' {
      out = out + raw.slice(runStart, i) + "\\n"
      i = i + 1
      runStart = i
    } else if ch == '\r' {
      out = out + raw.slice(runStart, i) + "\\r"
      i = i + 1
      runStart = i
    } else {
      i = i + 1
    }
  }
  out + raw.slice(runStart, stop) + q
}

// ---- main scanner --------------------------------------------------------
// Tokenize `source`, returning the tokens in order, terminated by an EOF token,
// plus any diagnostics. Whitespace is skipped; NEWLINE is emitted as a real
// token; `//` / `///` comments are retained as trivia in `gComments` (for the
// formatter and doc tooling), never emitted into the token stream.
export function tokenize(source: string): LexResult {
  // Reset the module-global scanner state for this run.
  gSrc = source
  gPos = 0
  gLine = 1
  gCol = 0
  const fresh: Diag[] = []
  gDiags = fresh
  const freshC: Comment[] = []
  gComments = freshC
  gTplStop = 0
  const freshTL: i32[] = []
  gTplOpenLine = freshTL
  const freshTC: i32[] = []
  gTplOpenCol = freshTC
  const freshTP: i32[] = []
  gTplOpenPos = freshTP
  const freshTB: i32[] = []
  gTplBrace = freshTB
  const freshTQ: i32[] = []
  gTplQuote = freshTQ
  gBrace = 0

  const toks: Tok[] = []

  while gPos < gSrc.length {
    const startPos = gPos
    const startLine = gLine
    const startCol = gCol
    const c = peek()

    // Newline `\r?\n`. A lone `\r` before `\n` is consumed with it.
    if c == '\r' || c == '\n' {
      if c == '\r' && peek2() == '\n' { advance() }
      advance()
      // SUPPRESSED INSIDE A TEMPLATE HOLE, at the hole's own brace depth. A hole
      // is an EXPRESSION, so a newline there can never be the statement
      // terminator NEWLINE means everywhere else — emitting one would end the
      // hole's expression mid-way. Dropping it is what lets a hole span lines.
      // A newline INSIDE a `{ … }` nested in the hole is deeper than the hole's
      // depth and keeps its NEWLINE: a block there really does hold statements.
      if atTplHoleDepth() { continue }
      toks.push(mkTok("NEWLINE", "", startPos, startLine, startCol))
      continue
    }

    // Whitespace: space, tab.
    if c == ' ' || c == '\t' {
      advance()
      continue
    }

    // Line comment `// ...` (and doc `/// ...`) — consumed up to the newline and
    // RETAINED as trivia in `gComments` (not emitted into `toks`, so the parser
    // is untouched). A doc comment is `///`; a comment is `trailing` when the
    // last emitted token sits on this same source line (`let x = 1 // c`).
    if c == '/' && peek2() == '/' {
      const isDoc = peekN(2) == '/'
      while gPos < gSrc.length && peek() != '\n' && peek() != '\r' { advance() }
      let isTrailing = false
      if toks.length > 0 {
        const lt = toks[toks.length - 1]
        if lt.kind != "NEWLINE" && lt.line == startLine { isTrailing = true }
      }
      gComments.push(
        {
          doc: isDoc,
          text: gSrc.slice(startPos, gPos),
          start: startPos,
          line: startLine,
          col: startCol,
          trailing: isTrailing,
        },
      )
      continue
    }

    // Identifier / keyword.
    if isIdStart(c) {
      while gPos < gSrc.length && isIdPart(peek()) { advance() }
      const text = gSrc.slice(startPos, gPos)
      toks.push(mkTok(keywordKind(text), "", startPos, startLine, startCol))
      continue
    }

    // Number. Hex `0x`/`0X` (digits `[0-9a-fA-F]`) and binary `0b`/`0B` (digits
    // `[01]`) integer forms, plus decimal
    // `[0-9]+ ('.' [0-9]+)? ([eE] [+-]? [0-9]+)?` — the fractional part is taken
    // only when a digit follows the dot, so `a.5` / `p.x` keep `.` as
    // a separate DOT. The NUMBER token's `text` is the RAW source lexeme (via
    // `mkTok`'s span slice), including any `0x`/`0b` prefix; `parseI32` decodes the
    // base from that prefix. This mirrors the host scanner's hex/binary base set
    // (lexer.ts); the host normalizes the token text to decimal up-front, while we
    // keep the raw lexeme and fold the base at value time in `parseI32`.
    if isDigit(c) {
      // Base-prefixed integer: `0x`/`0X` hex, `0b`/`0B` binary, `0o`/`0O` octal.
      // The prefix is recognized REGARDLESS of what follows, so a malformed
      // literal (`0x`, `0xG`, `0x_FF`) becomes ONE clear lex error via `scanRadix`
      // instead of silently splitting into `0` + an identifier.
      if c == '0' && (peek2() == 'x' || peek2() == 'X') {
        advance() // '0'
        advance() // 'x' / 'X'
        scanRadix(16, "hex", 'x')
        toks.push(mkTok("NUMBER", "", startPos, startLine, startCol))
        continue
      }
      if c == '0' && (peek2() == 'b' || peek2() == 'B') {
        advance() // '0'
        advance() // 'b' / 'B'
        scanRadix(2, "binary", 'b')
        toks.push(mkTok("NUMBER", "", startPos, startLine, startCol))
        continue
      }
      if c == '0' && (peek2() == 'o' || peek2() == 'O') {
        advance() // '0'
        advance() // 'o' / 'O'
        scanRadix(8, "octal", 'o')
        toks.push(mkTok("NUMBER", "", startPos, startLine, startCol))
        continue
      }
      // Plain decimal, optional fractional part. A `_` separator is legal only
      // BETWEEN digits (consumed when a digit follows).
      while (
        gPos < gSrc.length &&
        (isDigit(peek()) || (peek() == '_' && isDigit(peek2())))
      ) {
        advance()
      }
      if peek() == '.' && isDigit(peek2()) {
        advance()
        while (
          gPos < gSrc.length &&
          (isDigit(peek()) || (peek() == '_' && isDigit(peek2())))
        ) {
          advance()
        }
      }
      // SCIENTIFIC NOTATION — `e`/`E`, an optional sign, then a decimal digit run
      // with the same `_`-between-digits rule. `1e3`, `1.5e-7`, `2E+10`, `1e0`.
      //
      // Only the DECIMAL arm reaches here: a radix literal returned above, so the
      // `e` of `0x1e5` is a hex digit and is never read as an exponent marker. And
      // the mantissa grammar is UNCHANGED — VL has no bare `.5` or `1.` float, so
      // `.5e3` is still DOT + `5e3` (a parse error at the DOT, as `.5` already was)
      // and `1.e3` is still `1` + DOT + `e3` (member access, as `1.e3` already was).
      // Measured on the pre-change compiler; the exponent is a SPELLING of the
      // existing float literal, not a new mantissa grammar.
      //
      // Taken EAGERLY: once an `e`/`E` follows the mantissa the literal is committed
      // to being a float, so `1e` / `1e+` / `1e_5` report AT THE LITERAL instead of
      // splitting into a NUMBER plus a stray identifier that the PARSER then blames
      // (`expected `)` but found `e``). The recovery consumes the identifier run for
      // the same reason `scanRadix` does — one clear lex error, no cascade.
      let expBad = false
      if peek() == 'e' || peek() == 'E' {
        advance() // 'e' / 'E'
        if peek() == '+' || peek() == '-' { advance() }
        // The bool goes through a local first — the shape `scanRadix`'s header
        // records for every `if` over a boolean call in this file.
        const eDigit = isDigit(peek())
        if eDigit {
          while (
            gPos < gSrc.length &&
            (isDigit(peek()) || (peek() == '_' && isDigit(peek2())))
          ) {
            advance()
          }
        } else {
          diag("float exponent has no digits after `e`")
          expBad = true
          while gPos < gSrc.length && isIdPart(peek()) { advance() }
        }
      }
      // A misplaced separator (doubled `1__0`, trailing `1_`, `1e5_`) — a `_` left
      // here sits at the start, end, or against another `_`, never between digits.
      // Skipped when the exponent already reported: its recovery ate the id run, so
      // a `_` here would be a SECOND diagnostic for one broken literal.
      if !expBad && peek() == '_' {
        diag("`_` may only separate digits in a numeric literal")
        while gPos < gSrc.length && isIdPart(peek()) { advance() }
      }
      toks.push(mkTok("NUMBER", "", startPos, startLine, startCol))
      continue
    }

    // Char literal `'...'`.
    if c == '\'' {
      const value = scanQuoted('\'')
      // A char literal must decode to exactly one code point. Empty `''` or
      // multi-char `'ab'` is an error (we still emit a CHAR token to recover).
      //
      // COUNTED IN CODE POINTS, NOT IN `.length`. Since Stage 2c `.length` is a BYTE
      // count, so `'é'` — one code point, two UTF-8 bytes — would be rejected as
      // multi-character and `'\u{1F600}'` as four. This is the exact seam
      // `string-rep-measurements.md` §2.7 L3 warned Stage 2c would open between the two
      // escape decoders: `decodeStr` must start producing BYTES while `emitCharLitNode`
      // keeps counting CODE POINTS, so the lexer's half has to say which unit it means.
      // `cpCount` is that statement, and it is rep-STABLE (it iterates), which the
      // bootstrap needs — this same source is compiled by a code-point-rep compiler on
      // the seed rung and by a byte-rep one thereafter.
      const cpn = cpCount(value)
      if cpn != 1 {
        // Span the WHOLE literal, opening quote through closing quote: the
        // scanner already sits one past it, so `startCol` is the open quote and
        // `gCol` is the exclusive end. The offence is the literal's LENGTH, so a
        // one-column caret at the open quote (what anchoring alone gave) points
        // at the one character that is not the problem.
        if cpn == 0 {
          diagSpan("Empty char literal", startLine, startCol, gCol)
        } else {
          diagSpan(
            "Char literal must contain exactly one character",
            startLine,
            startCol,
            gCol,
          )
        }
      }
      toks.push(mkTok("CHAR", value, startPos, startLine, startCol))
      continue
    }

    // String literal `"..."` — and, since the hole trigger `\{` lives in the
    // ESCAPE namespace, the same split-run opener a backtick is. A string with
    // no hole is one `STRING` token and nothing downstream changes for it; one
    // with a hole opens a `TEMPLATE_HEAD` and rides the identical machinery.
    if c == '"' {
      const value = scanQuoted('"')
      if gTplStop == 1 {
        tplOpenPush(startLine, startCol, startPos, '"')
        toks.push(mkTok("TEMPLATE_HEAD", value, startPos, startLine, startCol))
      } else {
        // The span `scanQuoted` used to report for itself: the scan stopped at a
        // raw newline (still on `startLine`) or at EOF, so `gCol` is the honest
        // exclusive end either way.
        if gTplStop == 2 {
          diagSpan("Unterminated string literal", startLine, startCol, gCol)
        }
        toks.push(mkTok("STRING", value, startPos, startLine, startCol))
      }
      continue
    }

    // Template literal — the OPENING backtick. A template with no hole is one
    // `TEMPLATE` token; one with holes opens a `TEMPLATE_HEAD` and pushes a row
    // onto the hole stack, which the `}` arm below closes.
    if c == '`' {
      const tv = scanQuoted('`')
      if gTplStop == 1 {
        tplOpenPush(startLine, startCol, startPos, '`')
        toks.push(mkTok("TEMPLATE_HEAD", tv, startPos, startLine, startCol))
      } else {
        if gTplStop == 2 {
          diagSpan(
            "Unterminated template literal",
            startLine,
            startCol,
            tplLineEndCol(startPos, startCol),
          )
        }
        toks.push(mkTok("TEMPLATE", tv, startPos, startLine, startCol))
      }
      continue
    }

    // `{` / `}` — intercepted ahead of the operator tables so the brace DEPTH is
    // tracked (see the template-scanner state block). A `}` at the innermost
    // open hole's depth is not a closer at all: it RESUMES the template.
    if c == '{' {
      gBrace = gBrace + 1
      advance()
      toks.push(mkTok("LBRACE", "", startPos, startLine, startCol))
      continue
    }
    if c == '}' {
      if atTplHoleDepth() {
        // Resumed in the mode the run OPENED in — a `"` run still refuses a raw
        // newline, a backtick run still takes one as content. This is the one
        // read of `gTplQuote` that makes one machinery serve two literal forms.
        const tv2 = scanQuoted(gTplQuote[gTplQuote.length - 1]) // the `}` is this part's opener
        if gTplStop == 1 {
          toks.push(mkTok("TEMPLATE_MID", tv2, startPos, startLine, startCol))
        } else {
          if gTplStop == 2 { tplOpenDiag() }
          tplOpenPop()
          toks.push(mkTok("TEMPLATE_TAIL", tv2, startPos, startLine, startCol))
        }
        continue
      }
      gBrace = gBrace - 1
      advance()
      toks.push(mkTok("RBRACE", "", startPos, startLine, startCol))
      continue
    }

    // Three-char operator (`>>>`) — longest match first.
    //
    // The three no-match tests below run for EVERY token in the input. A
    // `TokKind` is an i32 atom, so `x != ""` is one `i32.ne` against a constant
    // — nothing is called and nothing is measured. (`.length` is not even
    // spellable on a `TokKind`: the checker rejects a field read that is not on
    // every member of the union.)
    const three = threeCharKind(c, peek2(), peekN(2))
    if three != "" {
      advance()
      advance()
      advance()
      toks.push(mkTok(three, "", startPos, startLine, startCol))
      continue
    }

    // Two-char operator (longest match first).
    const two = twoCharKind(c, peek2())
    if two != "" {
      advance()
      advance()
      toks.push(mkTok(two, "", startPos, startLine, startCol))
      continue
    }

    // One-char operator / punctuation.
    const one = oneCharKind(c)
    if one != "" {
      advance()
      toks.push(mkTok(one, "", startPos, startLine, startCol))
      continue
    }

    // Unknown character — record a diagnostic naming the offender (positioned
    // AT the char, not one past it), emit an ERROR token, make progress.
    diag("Unexpected character " + charDesc(c))
    advance()
    toks.push(mkTok("ERROR", "", startPos, startLine, startCol))
  }

  // Input ran out INSIDE a hole (`` `a${x ``): no part ever scanned to EOF, so
  // nothing above reported it. One diagnostic per still-open template.
  while gTplOpenLine.length > 0 {
    tplOpenDiag()
    tplOpenPop()
  }

  toks.push(mkTok("EOF", "", gPos, gLine, gCol))
  { tokens: toks, diags: gDiags, comments: gComments }
}

function tplLineEndCol(pos: i32, col: i32) {
  let p = pos
  while p < gSrc.length && gSrc[p] != '\n' && gSrc[p] != '\r' { p = p + 1 }
  col + (p - pos)
}

// True when the scanner sits inside a template HOLE at that hole's own brace
// depth — the test that tells a hole-closing `}` from a block-closing one, and
// the same test that suppresses NEWLINE there.
function atTplHoleDepth() {
  if gTplBrace.length == 0 { return false }
  gBrace == gTplBrace[gTplBrace.length - 1]
}

// Open a split run: the four stacks move together, and `quote` is the
// delimiter the `}` arm resumes in and the unterminated report names.
function tplOpenPush(line: i32, col: i32, pos: i32, quote: i32) {
  gTplOpenLine.push(line)
  gTplOpenCol.push(col)
  gTplOpenPos.push(pos)
  gTplBrace.push(gBrace)
  gTplQuote.push(quote)
  0
}

// Report the innermost open run as unterminated, AT ITS OPENING DELIMITER —
// naming the literal the AUTHOR opened, which is the only one they can fix.
function tplOpenDiag() {
  const oi = gTplOpenLine.length - 1
  if oi >= 0 {
    let what = "Unterminated string literal"
    if gTplQuote[oi] == '`' { what = "Unterminated template literal" }
    diagSpan(
      what,
      gTplOpenLine[oi],
      gTplOpenCol[oi],
      tplLineEndCol(gTplOpenPos[oi], gTplOpenCol[oi]),
    )
  }
  gDiags.length
}

// The 0-based EXCLUSIVE end column of the source line the character at offset
// `pos` (column `col`) sits on — `col` plus the characters left before the line
// break.
//
// A TEMPLATE IS THE ONE LITERAL THAT SPANS LINES, so the "whole run" span
// `scanQuoted` hands `"` and `'` is not expressible for it: `diagSpan`'s columns
// are one pair on ONE line by construction, and that is sound for a quoted
// literal only because a raw newline terminates one. The honest span for an
// unterminated template is therefore its FIRST line — it opens here and does not
// close before the line ends — which is exactly the run a reader scans for the
// missing backtick. Reported at the OPENING backtick either way, so a
// multi-line template still points at the character that needs fixing.

// Close the innermost open run (the four stacks move together).
function tplOpenPop() {
  if gTplOpenLine.length > 0 {
    gTplOpenLine.pop()
    gTplOpenCol.pop()
    gTplOpenPos.pop()
    gTplBrace.pop()
    gTplQuote.pop()
  }
  0
}
