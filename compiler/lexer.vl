import { cpCount } from "./strutil"

// A lexer for VL, written in VL — the self-hosted scanner the whole pipeline runs on. It
// scans identifiers and keywords, integer and real literals (`12`, `3.14`, `1.5e-7`, and
// `0x`/`0b`/`0o`), char and string literals over one shared escape grammar, backtick
// templates, the one- to three-char operator set, `//` line and `///` doc comments
// (retained as trivia in `gComments`, never emitted as tokens), and significant newlines.
//
// An interpolation hole is spelled `\{expr}` and is legal in both quoted forms: a literal
// holding one scans as a split run (`TEMPLATE_HEAD`/`MID`/`TAIL`) with the hole
// expressions lexed as ordinary tokens between, one holding none stays a single token.
// A raw newline is content in a backtick literal and a terminator inside `"` — the only
// rule the two grammars still disagree about. Positions follow the diagnostics
// convention: `line` 1-based, `col` 0-based, `start` the offset of the first char.

// The closed token vocabulary as a literal union: `kind` is one i32 field, `kind ==
// "IDENT"` lowers to `i32.eq`, and a spelling is minted from the atom rather than carried
// beside it, so the two cannot drift. `""` is the no-match sentinel the `*CharKind` tables
// return and is a member so those stay total; nothing depends on the grouping or order.
export type TokKind = ""
  | "IDENT"
  | "NUMBER"
  | "STRING"
  | "CHAR"
  | "TEMPLATE"
  | "TEMPLATE_HEAD"
  | "TEMPLATE_MID"
  | "TEMPLATE_TAIL"
  | "NEWLINE"
  | "EOF"
  | "ERROR"
  | "IF"
  | "IS"
  | "IMPORT"
  | "FUNCTION"
  | "FOR"
  | "FALSE"
  | "CONST"
  | "CONTINUE"
  | "ELSE"
  | "EXPORT"
  | "EXTERN"
  | "TYPE"
  | "TRUE"
  | "RETURN"
  | "LET"
  | "WHILE"
  | "AWAIT"
  | "BREAK"
  | "MATCH"
  | "NULL"
  | "LPAREN"
  | "RPAREN"
  | "LBRACE"
  | "RBRACE"
  | "LBRACK"
  | "RBRACK"
  | "COMMA"
  | "SEMI"
  | "DOT"
  | "COLON"
  | "QUESTION"
  | "TILDE"
  | "PLUS"
  | "MINUS"
  | "STAR"
  | "SLASH"
  | "PERCENT"
  | "CARET"
  | "EQUAL"
  | "BANG"
  | "GT"
  | "LT"
  | "PIPE"
  | "AMPERSAND"
  | "PLUSPLUS"
  | "MINUSMINUS"
  | "PLUSEQ"
  | "MINUSEQ"
  | "STAREQ"
  | "SLASHEQ"
  | "SHL"
  | "AND"
  | "OR"
  | "QUESTION_DOT"
  | "QUESTION_QUESTION"
  | "EQ"
  | "NE"
  | "GE"
  | "LE"
  | "SHR"
  | "USHR"

// A lexer diagnostic: a message plus the 1-based line and 0-based column it is raised at.
// `endCol` is the 0-based exclusive end column of the offending span on the same line as
// `col` (the caret width the CLI draws); `endCol == col` means no span. One column pair
// covers every span here because a quoted literal never spans lines.
type Diag = {
  msg: string,
  line: i32,
  col: i32,
  endCol: i32
}

// A lexed token: `kind` the closed `TokKind` atom, `text` the raw source lexeme (quotes
// and backslashes kept for a `STRING` or `CHAR`), `start` the char offset of its first
// char, and `line`/`col` the 1-based line and 0-based column. A literal's escapes are
// not resolved here: `decodeStr` (`emit_base.vl`) is the one decoder, working from `text`.
type Tok = {
  kind: TokKind,
  text: string,
  start: i32,
  line: i32,
  col: i32
}

// A retained `//` or `///` comment, kept out of `tokens` so the parser's lookahead is
// untouched: comments are formatter metadata, not grammar. `text` is the verbatim lexeme
// including the leading `//`; `trailing` is true when it sits on the same source line
// after a real token. Declared before `LexResult` because the host does not hoist aliases.
type Comment = {
  doc: boolean,
  text: string,
  start: i32,
  line: i32,
  col: i32,
  trailing: boolean
}

// The result of lexing: the token stream (EOF-terminated), any diagnostics, and
// the retained comment trivia.
export type LexResult = {
  tokens: Tok[],
  diags: Diag[],
  comments: Comment[]
}

// ---- scanner state (ref-typed module globals) ----------------------------
// The source and cursor travel together for every helper, so they live as
// module globals (including the ref-typed source string and diag array) rather
// than a struct threaded to each call.

export let gSrc = ""
let gPos = 0
let gLine = 1
let gCol = 0
export let gDiags: Diag[] = []
let gComments: Comment[] = []

// An interpolated literal is context-sensitive: the `}` that ends a hole is spelled like
// the one that closes a block, and the `{` depth (`gBrace`) against the depth each open
// hole started at (`gTplBrace`) separates them, so holes nest for free. The parallel
// `gTplOpen*` rows hold the opening delimiter, so an unterminated literal reports there.
let gTplStop = 0 // why the last part stopped: 0 = closing delimiter, 1 = `\{`, 2 = ran out of input
let gTplOpenLine: i32[] = []
let gTplOpenCol: i32[] = []
let gTplOpenPos: i32[] = []
let gTplBrace: i32[] = []
let gTplQuote: i32[] = []
let gBrace = 0

// ---- character classes (char literals) -----------------------------------

function isDigit(c: i32) { c >= '0' && c <= '9' }

function isIdStart(c: i32) {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

function isIdPart(c: i32) { isIdStart(c) || isDigit(c) }

function isHex(c: i32) {
  isDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

// The numeric value of a hex digit char code (0-15); -1 if not a hex digit.
function hexVal(c: i32) {
  if c >= '0' && c <= '9' { return c - '0' }
  if c >= 'a' && c <= 'f' { return c - 'a' + 10 }
  if c >= 'A' && c <= 'F' { return c - 'A' + 10 }
  -1
}

// One uppercase hex digit char for `d` in 0..15 (the inverse of `hexVal`).
function hexDigit(d: i32) {
  if d < 10 { return fromCodePoint('0' + d) }
  fromCodePoint('A' + (d - 10))
}

// Describe a char code for a diagnostic: quoted verbatim when printable,
// `U+XXXX` (4+ uppercase hex digits) for controls and other unprintables.
function charDesc(c: i32) {
  if c >= ' ' && c != 127 { return "'" + fromCodePoint(c) + "'" }
  let hex = ""
  let m = c
  while m > 0 {
    hex = hexDigit(m % 16) + hex
    m = m / 16
  }
  while hex.length < 4 { hex = "0" + hex }
  "U+" + hex
}

// A binary digit `0` / `1` (for `0b…` literals).
function isBinDigit(c: i32) { c == '0' || c == '1' }

// '0'..'7' — the octal digit set (`0o` literals).
function isOctDigit(c: i32) { c >= '0' && c <= '7' }

// A digit of the given base (16 hex / 2 binary / 8 octal / else decimal).
function isRadixDigit(c: i32, base: i32) {
  if base == 16 { return isHex(c) }
  if base == 2 { return isBinDigit(c) }
  if base == 8 { return isOctDigit(c) }
  isDigit(c)
}

// ---- scanner primitives --------------------------------------------------

// The char code at the current position, or -1 at end of input.
export function peek() {
  if gPos >= gSrc.length { return -1 }
  gSrc[gPos]
}

// The char code one past the current position, or -1 if none.
function peek2() {
  if gPos + 1 >= gSrc.length { return -1 }
  gSrc[gPos + 1]
}

// The char code `n` past the current position, or -1 if none.
function peekN(n: i32) {
  if gPos + n >= gSrc.length { return -1 }
  gSrc[gPos + n]
}

// Consume one char, tracking line/column, and return its code. A line ends at
// `\n` or at a lone `\r` (classic-Mac / stray-CR input) — a `\r` that is part
// of `\r\n` defers the bump to the `\n` so the pair counts as one line.
export function advance() {
  const c = gSrc[gPos]
  gPos = gPos + 1
  if c == '\n' || (c == '\r' && peek() != '\n') {
    gLine = gLine + 1
    gCol = 0
  } else {
    gCol = gCol + 1
  }
  c
}

// Record a diagnostic at the current position. Returns the diagnostic count
// (VL has no `void`; functions infer their return type).
export function diag(msg: string) {
  gDiags.push({ msg: msg, line: gLine, col: gCol, endCol: gCol })
  gDiags.length
}

// Record a diagnostic at an explicit position (1-based line, 0-based column) —
// for reports that anchor at a construct's start (an opening quote, a
// backslash) after the scanner has already moved past it.
function diagAt(msg: string, line: i32, col: i32) {
  gDiags.push({ msg: msg, line: line, col: col, endCol: col })
  gDiags.length
}

// `diagAt` with a span: the report covers `[col, endCol)` on `line` rather than
// rendering as a point. For a diagnostic whose subject is a whole lexeme the
// scanner has just consumed — a char literal of the wrong length, an unterminated
// quote — where `gCol` is already sitting one past it.
function diagSpan(msg: string, line: i32, col: i32, endCol: i32) {
  gDiags.push({ msg: msg, line: line, col: col, endCol: endCol })
  gDiags.length
}

// ---- keyword + operator tables -------------------------------------------
// Linear `==` chains: a string-keyed map over ~22 keywords or ~31 operators would not pay
// here, and both vocabularies are closed, so the chain cannot fall behind.

// The authority for what is a hard keyword: four other lists copy it (`driver.lexClassOf`,
// the LSP's `VL_HARD_KEYWORDS`, the TextMate grammar, the playground's Monarch table), and
// `tests/keyword_vocabulary_test.ts` derives the set from the `return "…"` arms below and
// reddens on disagreement. A contextual keyword (`as`, `in`, `to`) must not move here.
function keywordKind(text: string): TokKind {
  const n = text.length
  if n < 2 || n > 8 { return "IDENT" }
  const c = text[0]
  if c == 'i' {
    if n == 2 {
      if text[1] == 'f' { return "IF" }
      if text[1] == 's' { return "IS" }
      return "IDENT"
    }
    if text == "import" { return "IMPORT" }
    return "IDENT"
  }
  if c == 'f' {
    if text == "function" { return "FUNCTION" }
    if text == "for" { return "FOR" }
    if text == "false" { return "FALSE" }
    return "IDENT"
  }
  if c == 'c' {
    if text == "const" { return "CONST" }
    if text == "continue" { return "CONTINUE" }
    return "IDENT"
  }
  if c == 'e' {
    if text == "else" { return "ELSE" }
    if text == "export" { return "EXPORT" }
    if text == "extern" { return "EXTERN" }
    return "IDENT"
  }
  if c == 't' {
    if text == "type" { return "TYPE" }
    if text == "true" { return "TRUE" }
    return "IDENT"
  }
  if c == 'r' {
    if text == "return" { return "RETURN" }
    return "IDENT"
  }
  if c == 'l' {
    if text == "let" { return "LET" }
    return "IDENT"
  }
  if c == 'w' {
    if text == "while" { return "WHILE" }
    return "IDENT"
  }
  if c == 'a' {
    if text == "await" { return "AWAIT" }
    return "IDENT"
  }
  if c == 'b' {
    if text == "break" { return "BREAK" }
    return "IDENT"
  }
  if c == 'm' {
    if text == "match" { return "MATCH" }
    return "IDENT"
  }
  if c == 'n' {
    if text == "null" { return "NULL" }
    return "IDENT"
  }
  "IDENT"
}

// Single-char operator/punctuation kind for char code `c`, or "" if none. `;` lexes as
// `SEMI`, an optional statement separator the block and top-level loops treat exactly like
// a NEWLINE (so `a(); b()` works); a standalone `?` is not a token and falls through to
// the unexpected-character path.
function oneCharKind(c: i32): TokKind {
  if c == '+' { return "PLUS" }
  if c == '-' { return "MINUS" }
  if c == '*' { return "STAR" }
  if c == '/' { return "SLASH" }
  if c == '%' { return "PERCENT" }
  if c == '^' { return "CARET" }
  if c == '=' { return "EQUAL" }
  if c == '!' { return "BANG" }
  if c == '>' { return "GT" }
  if c == '<' { return "LT" }
  if c == '(' { return "LPAREN" }
  if c == ')' { return "RPAREN" }
  if c == '{' { return "LBRACE" }
  if c == '}' { return "RBRACE" }
  if c == '[' { return "LBRACK" }
  if c == ']' { return "RBRACK" }
  if c == ',' { return "COMMA" }
  if c == ';' { return "SEMI" }
  if c == '.' { return "DOT" }
  if c == ':' { return "COLON" }
  if c == '|' { return "PIPE" }
  if c == '&' { return "AMPERSAND" }
  // A lone `?` — the optional-parameter marker (`a?: i32`). `?.` and `??` are longer
  // matches and are taken first, so this only fires where neither does.
  if c == '?' { return "QUESTION" }
  if c == '~' { return "TILDE" }
  ""
}

// Two-char operator kind for the pair (a, b), or "" if none. Mirrors TWO_CHAR.
function twoCharKind(a: i32, b: i32): TokKind {
  if a == '+' && b == '+' { return "PLUSPLUS" }
  if a == '-' && b == '-' { return "MINUSMINUS" }
  // Compound assignment (`a += b` desugars to `a = a + (b)` in the parser).
  if a == '+' && b == '=' { return "PLUSEQ" }
  if a == '-' && b == '=' { return "MINUSEQ" }
  if a == '*' && b == '=' { return "STAREQ" }
  if a == '/' && b == '=' { return "SLASHEQ" }
  // `<<` left shift. Unlike the closing `>>` of a nested generic, `<<` never
  // collides with generics (two opening angles never abut), so it is one token.
  if a == '<' && b == '<' { return "SHL" }
  if a == '&' && b == '&' { return "AND" }
  if a == '|' && b == '|' { return "OR" }
  if a == '?' && b == '.' { return "QUESTION_DOT" }
  if a == '?' && b == '?' { return "QUESTION_QUESTION" }
  if a == '=' && b == '=' { return "EQ" }
  if a == '!' && b == '=' { return "NE" }
  if a == '>' && b == '=' { return "GE" }
  if a == '<' && b == '=' { return "LE" }
  // Bitwise shifts. `>>` is the signed (arithmetic) right shift. VL is
  // generics-free, so — unlike the TS host (whose `>>` collides with a nested
  // generic close `Box<Pair<T,U>>` and is recombined in the parser) — `>>` can
  // be a single lexer token here. `>>>` is handled first as a three-char token.
  if a == '>' && b == '>' { return "SHR" }
  ""
}

// Three-char operator kind for the triple (a, b, c), or "" if none. Checked
// before `twoCharKind` (longest match first). Only `>>>` (unsigned/logical
// right shift) lives here — the `>>>` of the LEB encoders' byte extraction.
function threeCharKind(a: i32, b: i32, c: i32): TokKind {
  if a == '>' && b == '>' && c == '>' { return "USHR" }
  ""
}

// Decode a simple escape character `e` (the char after a backslash) to the string it
// denotes. `\xXX` / `\uXXXX` / `\u{…}` are handled by the scanner before this is called,
// since they need hex digits and a `fromCodePoint`. "" for an unknown escape, which the
// caller renders as the verbatim char.
function decodeSimpleEscape(e: i32) {
  if e == 'n' { return "\n" }
  if e == 't' { return "\t" }
  if e == 'r' { return "\r" }
  if e == '\\' { return "\\" }
  if e == '"' { return "\"" }
  if e == '\'' { return "'" }
  if e == '0' { return fromCodePoint(0) }
  if e == 'b' { return fromCodePoint(8) }
  if e == 'f' { return fromCodePoint(12) }
  if e == 'v' { return fromCodePoint(11) }
  ""
}

// ---- token builder -------------------------------------------------------

export function mkTok(
  kind: TokKind,
  start: i32,
  startLine: i32,
  startCol: i32,
): Tok {
  {
    kind: kind,
    text: gSrc.slice(start, gPos),
    start: start,
    line: startLine,
    col: startCol,
  }
}

// Scan the digit run of a base-prefixed integer (`0x`/`0b`/`0o`), the prefix already
// consumed. It validates digits and `_` separators, emits at most one diagnostic, and eats
// a trailing identifier run so `0xG` never cascades into "undeclared identifier". Each
// `isRadixDigit`/`isIdPart` call goes in a bool local: the host drops a bare call as an `if`.
function scanRadix(base: i32, baseName: string, prefixChar: i32) {
  let any = false
  let bad = false
  while gPos < gSrc.length {
    const p = peek()
    const pIsDigit = isRadixDigit(p, base)
    const p2IsDigit = isRadixDigit(peek2(), base)
    if pIsDigit {
      advance()
      any = true
    } else if p == '_' && any && p2IsDigit {
      // A separator is legal only between two digits.
      advance()
    } else if p == '_' {
      // A separator at the start, doubled, or trailing (`0x_F`, `0xF__F`, `0xF_`).
      diag("`_` may only separate digits in a numeric literal")
      bad = true
      break
    } else {
      break
    }
  }
  if !bad {
    const pc = peek()
    const stray = isIdPart(pc)
    if !any && stray {
      // No valid digit, a stray id char names the bad digit (`0xG`).
      diag("invalid " + baseName + " digit '" + fromCodePoint(pc) + "'")
      bad = true
    } else if !any {
      // Nothing usable after the prefix (`0x`).
      diag(
        baseName +
          " literal has no digits after `0" +
          fromCodePoint(prefixChar) +
          "`",
      )
      bad = true
    } else if stray {
      // Digits, then a non-base id char (`0xFG`).
      diag("invalid " + baseName + " digit '" + fromCodePoint(pc) + "'")
      bad = true
    }
  }
  if bad {
    while gPos < gSrc.length && isIdPart(peek()) { advance() }
  }
  gDiags.length
}

// Scan a quoted literal, the cursor on the opening quote; `quote` is the quote char code.
// Returns the decoded code-point count — one per escape plus each escape-free run
// `[runStart, gPos)` — which is all a caller needs (the char literal's "exactly one
// character" rule). The decoded text is `decodeStr`'s at emit time, so there is one decoder.
export function scanQuoted(quote: i32) {
  // The opening quote anchors the unterminated-literal diagnostic: reporting
  // there (not wherever scanning stopped) keeps a missing quote a local error.
  const openLine = gLine
  const openCol = gCol
  // Template mode (`quote` is a backtick) differs from `"` in exactly two rules: a raw
  // newline is content, and an escaped backtick joins the escape set. Hole mode covers `"`
  // and the backtick but never `'`: a `\{` ends the part (recorded in `gTplStop`, since a
  // VL function returns one value), and `'\{'` keeps its unknown-escape diagnostic.
  const tpl = quote == '`'
  const holes = tpl || quote == '"'
  if holes { gTplStop = 2 }
  advance() // opening quote
  let nCp = 0
  let closed = false
  let runStart = gPos
  while gPos < gSrc.length {
    const ch = peek()
    // A raw newline terminates the literal: the closing quote is missing.
    // The newline is left in the input (it becomes an ordinary NEWLINE token),
    // so one missing quote yields a single local error at the opening quote
    // instead of masking every later error up to EOF.
    if !tpl && (ch == '\n' || ch == '\r') { break }
    // A hole opens. The trigger lives in the escape namespace — `\{`, not `${` — so `{`
    // stays an ordinary character in every string, while `\{` had no prior meaning to
    // break. Tested before the escape arm, so `\{` never reaches `decodeSimpleEscape`;
    // `\\{` is a literal backslash then a literal brace.
    if holes && ch == '\\' && peek2() == '{' {
      nCp = nCp + cpCount(gSrc.slice(runStart, gPos))
      advance() // backslash
      advance() // {
      runStart = gPos
      closed = true
      gTplStop = 1
      break
    }
    if ch == '\\' {
      nCp = nCp + cpCount(gSrc.slice(runStart, gPos))
      // Escape diagnostics anchor at the backslash, not the scan position
      // after the sequence has been consumed.
      const escLine = gLine
      const escCol = gCol
      advance() // backslash
      if gPos >= gSrc.length {
        runStart = gPos
        break
      }
      const e = peek()
      // The one template-only escape: a template's own delimiter, handled before
      // `decodeSimpleEscape` so the `"` grammar is unchanged. `\$` is not an escape in
      // either form — `$` is an ordinary character in both — so it falls through to the
      // unknown-escape arm below, which names it.
      if tpl && e == '`' {
        advance() // the escaped delimiter
        nCp = nCp + 1
        runStart = gPos
        continue
      }
      // \xXX — two hex digits.
      if e == 'x' {
        if isHex(peek2()) && isHex(peekN(2)) {
          advance() // x
          advance() // first hex digit
          advance() // second hex digit
        } else {
          advance() // x
          diagAt("Invalid \\x escape (needs two hex digits)", escLine, escCol)
        }
        // One code point either way: the valid escape decodes to one, and the
        // invalid one keeps the `x` verbatim.
        nCp = nCp + 1
        runStart = gPos
        continue
      }
      // \uXXXX — four hex digits — or \u{…} — 1-6 hex digits.
      if e == 'u' {
        if peek2() == '{' {
          // \u{…}: scan hex digits until `}`, decode the code point.
          advance() // u
          advance() // {
          let cp = 0
          let n = 0
          while gPos < gSrc.length && peek() != '}' && isHex(peek()) {
            cp = cp * 16 + hexVal(advance())
            n = n + 1
          }
          if peek() == '}' && n >= 1 && n <= 6 && cp <= 1114111 {
            advance() // }
          } else {
            diagAt(
              "Invalid \\u{…} escape (needs 1-6 hex digits for a valid code point)",
              escLine,
              escCol,
            )
            // Consume a closing `}` if present so the span stays sane.
            if peek() == '}' { advance() }
          }
          nCp = nCp + 1
          runStart = gPos
          continue
        }
        if (
          isHex(peek2()) &&
          isHex(peekN(2)) &&
          isHex(peekN(3)) &&
          isHex(peekN(4))
        ) {
          advance() // u
          advance() // the four hex digits
          advance()
          advance()
          advance()
        } else {
          advance() // u
          diagAt(
            "Invalid \\u escape (needs four hex digits or \\u{…})",
            escLine,
            escCol,
          )
        }
        nCp = nCp + 1
        runStart = gPos
        continue
      }
      // Line continuation: a backslash immediately before a newline drops both.
      if e == '\n' || e == '\r' {
        advance() // the newline char
        if e == '\r' && peek() == '\n' { advance() }
        runStart = gPos
        continue
      }
      // Simple escape (\n \t \r \\ \" \' \0 \b \f \v) or unknown (verbatim char).
      advance() // the escaped char
      const dec = decodeSimpleEscape(e)
      if dec == "" {
        // Unknown escape: keep the char after the backslash verbatim, and warn. `\$` gets
        // its own sentence in both literal forms, so no second escape grammar appears;
        // `${` needs no arm, because it is ordinary text rather than an error.
        if e == '$' {
          diagAt(
            "`\\$` is not an escape — write `$` (an interpolation hole is `\\{…}`)",
            escLine,
            escCol,
          )
        } else {
          diagAt("Unknown escape sequence", escLine, escCol)
        }
        runStart = gPos - 1
      } else {
        nCp = nCp + 1
        runStart = gPos
      }
      continue
    }
    if ch == quote {
      nCp = nCp + cpCount(gSrc.slice(runStart, gPos))
      advance() // closing quote
      runStart = gPos
      closed = true
      if holes { gTplStop = 0 }
      break
    }
    advance()
  }
  nCp = nCp + cpCount(gSrc.slice(runStart, gPos))
  if !closed {
    // An interpolable literal's unterminated report is the caller's: only the caller knows
    // where the opening delimiter is (a `MID` or `TAIL` part opens at a `}`) and can
    // measure a span for a literal that may be multiline. `gTplStop` carries the verdict
    // and `gTplQuote` names the literal; a char literal still reports here.
    if holes {
      gTplStop = 2
    } else {
      diagSpan("Unterminated char literal", openLine, openCol, gCol)
    }
  }
  nCp
}

// The `"`-quoted string lexeme meaning what template part `raw` means — the one bridge
// between the two literal grammars, purely lexical, so no second escape decoder can drift.
// An escape is copied whole, so a `\\` cannot re-open one; an escaped backtick loses its
// backslash, `"` gains one, a newline becomes `\n`. Built from slices: `.length` is bytes.
export function tplPartStrLex(raw: string): string {
  const n = raw.length
  const q = "\""
  if n < 1 { return q + q }
  // The trailing delimiter: the literal's own quote (1 char) or a hole-opening
  // `\{` (2). A part that ends with neither came from an unterminated literal —
  // already a lex error — and keeps everything, which is what leaves the
  // recovery lexeme well-formed.
  let stop = n
  if raw[n - 1] == '`' || raw[n - 1] == '"' { stop = n - 1 }
  else if n >= 2 && raw[n - 2] == '\\' && raw[n - 1] == '{' { stop = n - 2 }
  const start = 1
  if stop <= start { return q + q }
  let out = q
  let runStart = start
  let i = start
  while i < stop {
    const ch = raw[i]
    if ch == '\\' {
      if i + 1 >= stop {
        // A dangling backslash — reachable only from an unterminated template,
        // which is already a lex error. Dropped so the lexeme this returns is
        // still well-formed for the parse that recovers past it.
        out = out + raw.slice(runStart, i)
        i = i + 1
        runStart = i
      } else {
        const e = raw[i + 1]
        if e == '`' {
          out = out + raw.slice(runStart, i) + raw.slice(i + 1, i + 2)
          i = i + 2
          runStart = i
        } else {
          i = i + 2
        }
      }
    } else if ch == '"' {
      out = out + raw.slice(runStart, i) + "\\\""
      i = i + 1
      runStart = i
    } else if ch == '\n' {
      out = out + raw.slice(runStart, i) + "\\n"
      i = i + 1
      runStart = i
    } else if ch == '\r' {
      out = out + raw.slice(runStart, i) + "\\r"
      i = i + 1
      runStart = i
    } else {
      i = i + 1
    }
  }
  out + raw.slice(runStart, stop) + q
}

// ---- main scanner --------------------------------------------------------
// Tokenize `source`, returning the tokens in order terminated by an EOF token, plus any
// diagnostics. Whitespace is skipped, NEWLINE is emitted as a real token, and `//` / `///`
// comments are retained as trivia in `gComments` rather than emitted into the stream.
export function tokenize(source: string): LexResult {
  // Reset the module-global scanner state for this run.
  gSrc = source
  gPos = 0
  gLine = 1
  gCol = 0
  const fresh: Diag[] = []
  gDiags = fresh
  const freshC: Comment[] = []
  gComments = freshC
  gTplStop = 0
  const freshTL: i32[] = []
  gTplOpenLine = freshTL
  const freshTC: i32[] = []
  gTplOpenCol = freshTC
  const freshTP: i32[] = []
  gTplOpenPos = freshTP
  const freshTB: i32[] = []
  gTplBrace = freshTB
  const freshTQ: i32[] = []
  gTplQuote = freshTQ
  gBrace = 0

  const toks: Tok[] = []

  while gPos < gSrc.length {
    const startPos = gPos
    const startLine = gLine
    const startCol = gCol
    const c = peek()

    // Newline `\r?\n`. A lone `\r` before `\n` is consumed with it.
    if c == '\r' || c == '\n' {
      if c == '\r' && peek2() == '\n' { advance() }
      advance()
      // Suppressed inside a template hole, at the hole's own brace depth: a hole is an
      // expression, so a newline there cannot be the statement terminator NEWLINE means
      // elsewhere, and emitting one would end the hole's expression mid-way. A newline
      // inside a `{ … }` nested in the hole is deeper and keeps its NEWLINE.
      if atTplHoleDepth() { continue }
      toks.push(mkTok("NEWLINE", startPos, startLine, startCol))
      continue
    }

    // Whitespace: space, tab.
    if c == ' ' || c == '\t' {
      advance()
      continue
    }

    // Line comment `// ...` (and doc `/// ...`) — consumed up to the newline and
    // retained as trivia in `gComments` (not emitted into `toks`, so the parser
    // is untouched). A doc comment is `///`; a comment is `trailing` when the
    // last emitted token sits on this same source line (`let x = 1 // c`).
    if c == '/' && peek2() == '/' {
      const isDoc = peekN(2) == '/'
      while gPos < gSrc.length && peek() != '\n' && peek() != '\r' { advance() }
      let isTrailing = false
      if toks.length > 0 {
        const lt = toks[toks.length - 1]
        if lt.kind != "NEWLINE" && lt.line == startLine { isTrailing = true }
      }
      gComments.push(
        {
          doc: isDoc,
          text: gSrc.slice(startPos, gPos),
          start: startPos,
          line: startLine,
          col: startCol,
          trailing: isTrailing,
        },
      )
      continue
    }

    // Identifier / keyword.
    if isIdStart(c) {
      while gPos < gSrc.length && isIdPart(peek()) { advance() }
      const text = gSrc.slice(startPos, gPos)
      toks.push(mkTok(keywordKind(text), startPos, startLine, startCol))
      continue
    }

    // Number. Hex `0x`, binary `0b` and octal `0o` integer forms, plus decimal
    // `[0-9]+ ('.' [0-9]+)? ([eE] [+-]? [0-9]+)?` — the fractional part is taken only when
    // a digit follows the dot, so `a.5` and `p.x` keep `.` as a separate DOT. The token's
    // `text` is the raw lexeme; the base is folded at value time in `parseI32`.
    if isDigit(c) {
      // Base-prefixed integer: `0x`/`0X` hex, `0b`/`0B` binary, `0o`/`0O` octal.
      // The prefix is recognized regardless of what follows, so a malformed
      // literal (`0x`, `0xG`, `0x_FF`) becomes one clear lex error via `scanRadix`
      // instead of silently splitting into `0` + an identifier.
      if c == '0' && (peek2() == 'x' || peek2() == 'X') {
        advance() // '0'
        advance() // 'x' / 'X'
        scanRadix(16, "hex", 'x')
        toks.push(mkTok("NUMBER", startPos, startLine, startCol))
        continue
      }
      if c == '0' && (peek2() == 'b' || peek2() == 'B') {
        advance() // '0'
        advance() // 'b' / 'B'
        scanRadix(2, "binary", 'b')
        toks.push(mkTok("NUMBER", startPos, startLine, startCol))
        continue
      }
      if c == '0' && (peek2() == 'o' || peek2() == 'O') {
        advance() // '0'
        advance() // 'o' / 'O'
        scanRadix(8, "octal", 'o')
        toks.push(mkTok("NUMBER", startPos, startLine, startCol))
        continue
      }
      // Plain decimal, optional fractional part. A `_` separator is legal only
      // between digits (consumed when a digit follows).
      while (
        gPos < gSrc.length &&
        (isDigit(peek()) || (peek() == '_' && isDigit(peek2())))
      ) {
        advance()
      }
      if peek() == '.' && isDigit(peek2()) {
        advance()
        while (
          gPos < gSrc.length &&
          (isDigit(peek()) || (peek() == '_' && isDigit(peek2())))
        ) {
          advance()
        }
      }
      // Scientific notation: `e`/`E`, an optional sign, then a decimal digit run with the
      // same `_`-between-digits rule. Only the decimal arm reaches here, so the `e` of
      // `0x1e5` is a hex digit. Taken eagerly — once an `e` follows the mantissa the
      // literal is committed — so `1e` and `1e+` report at the literal, with no cascade.
      let expBad = false
      if peek() == 'e' || peek() == 'E' {
        advance() // 'e' / 'E'
        if peek() == '+' || peek() == '-' { advance() }
        // The bool goes through a local first — the shape `scanRadix`'s header
        // records for every `if` over a boolean call in this file.
        const eDigit = isDigit(peek())
        if eDigit {
          while (
            gPos < gSrc.length &&
            (isDigit(peek()) || (peek() == '_' && isDigit(peek2())))
          ) {
            advance()
          }
        } else {
          diag("float exponent has no digits after `e`")
          expBad = true
          while gPos < gSrc.length && isIdPart(peek()) { advance() }
        }
      }
      // A misplaced separator (doubled `1__0`, trailing `1_`, `1e5_`) — a `_` left
      // here sits at the start, end, or against another `_`, never between digits.
      // Skipped when the exponent already reported: its recovery ate the id run, so
      // a `_` here would be a second diagnostic for one broken literal.
      if !expBad && peek() == '_' {
        diag("`_` may only separate digits in a numeric literal")
        while gPos < gSrc.length && isIdPart(peek()) { advance() }
      }
      toks.push(mkTok("NUMBER", startPos, startLine, startCol))
      continue
    }

    // Char literal `'...'`.
    if c == '\'' {
      // A char literal must decode to exactly one code point; empty `''` or multi-char
      // `'ab'` is an error, and a CHAR token is still emitted to recover. `scanQuoted`
      // counts code points, not bytes — a byte count would reject `'é'` as
      // multi-character — and is rep-stable, which the bootstrap ladder needs.
      const cpn = scanQuoted('\'')
      if cpn != 1 {
        // Span the whole literal, opening quote through closing quote: the scanner sits
        // one past it, so `startCol` is the open quote and `gCol` the exclusive end. The
        // offence is the literal's length, so a one-column caret would point at the one
        // character that is not the problem.
        if cpn == 0 {
          diagSpan("Empty char literal", startLine, startCol, gCol)
        } else {
          diagSpan(
            "Char literal must contain exactly one character",
            startLine,
            startCol,
            gCol,
          )
        }
      }
      toks.push(mkTok("CHAR", startPos, startLine, startCol))
      continue
    }

    // String literal `"..."` — and, since the hole trigger `\{` lives in the
    // escape namespace, the same split-run opener a backtick is. A string with
    // no hole is one `STRING` token and nothing downstream changes for it; one
    // with a hole opens a `TEMPLATE_HEAD` and rides the identical machinery.
    if c == '"' {
      scanQuoted('"')
      if gTplStop == 1 {
        tplOpenPush(startLine, startCol, startPos, '"')
        toks.push(mkTok("TEMPLATE_HEAD", startPos, startLine, startCol))
      } else {
        // The span `scanQuoted` reports for a non-interpolable literal: the scan stopped
        // at a raw newline (still on `startLine`) or at EOF, so `gCol` is the honest
        // exclusive end either way.
        if gTplStop == 2 {
          diagSpan("Unterminated string literal", startLine, startCol, gCol)
        }
        toks.push(mkTok("STRING", startPos, startLine, startCol))
      }
      continue
    }

    // Template literal — the opening backtick. A template with no hole is one
    // `TEMPLATE` token; one with holes opens a `TEMPLATE_HEAD` and pushes a row
    // onto the hole stack, which the `}` arm below closes.
    if c == '`' {
      scanQuoted('`')
      if gTplStop == 1 {
        tplOpenPush(startLine, startCol, startPos, '`')
        toks.push(mkTok("TEMPLATE_HEAD", startPos, startLine, startCol))
      } else {
        if gTplStop == 2 {
          diagSpan(
            "Unterminated template literal",
            startLine,
            startCol,
            tplLineEndCol(startPos, startCol),
          )
        }
        toks.push(mkTok("TEMPLATE", startPos, startLine, startCol))
      }
      continue
    }

    // `{` / `}` — intercepted ahead of the operator tables so the brace depth is
    // tracked (see the template-scanner state block). A `}` at the innermost
    // open hole's depth is not a closer at all: it resumes the template.
    if c == '{' {
      gBrace = gBrace + 1
      advance()
      toks.push(mkTok("LBRACE", startPos, startLine, startCol))
      continue
    }
    if c == '}' {
      if atTplHoleDepth() {
        // Resumed in the mode the run opened in — a `"` run still refuses a raw
        // newline, a backtick run still takes one as content. This is the one
        // read of `gTplQuote` that makes one machinery serve two literal forms.
        scanQuoted(gTplQuote[gTplQuote.length - 1]) // the `}` is this part's opener
        if gTplStop == 1 {
          toks.push(mkTok("TEMPLATE_MID", startPos, startLine, startCol))
        } else {
          if gTplStop == 2 { tplOpenDiag() }
          tplOpenPop()
          toks.push(mkTok("TEMPLATE_TAIL", startPos, startLine, startCol))
        }
        continue
      }
      gBrace = gBrace - 1
      advance()
      toks.push(mkTok("RBRACE", startPos, startLine, startCol))
      continue
    }

    // Three-char operator (`>>>`) — longest match first. The three no-match tests below
    // run for every token: a `TokKind` is an i32 atom, so `x != ""` is one `i32.ne` against
    // a constant. (`.length` is not spellable on a `TokKind` — the checker rejects a field
    // read that is not on every member of the union.)
    const three = threeCharKind(c, peek2(), peekN(2))
    if three != "" {
      advance()
      advance()
      advance()
      toks.push(mkTok(three, startPos, startLine, startCol))
      continue
    }

    // Two-char operator (longest match first).
    const two = twoCharKind(c, peek2())
    if two != "" {
      advance()
      advance()
      toks.push(mkTok(two, startPos, startLine, startCol))
      continue
    }

    // One-char operator / punctuation.
    const one = oneCharKind(c)
    if one != "" {
      advance()
      toks.push(mkTok(one, startPos, startLine, startCol))
      continue
    }

    // Unknown character — record a diagnostic naming the offender (positioned
    // AT the char, not one past it), emit an ERROR token, make progress.
    diag("Unexpected character " + charDesc(c))
    advance()
    toks.push(mkTok("ERROR", startPos, startLine, startCol))
  }

  // Input ran out inside a hole (`` `a${x ``): no part ever scanned to EOF, so
  // nothing above reported it. One diagnostic per still-open template.
  while gTplOpenLine.length > 0 {
    tplOpenDiag()
    tplOpenPop()
  }

  toks.push(mkTok("EOF", gPos, gLine, gCol))
  { tokens: toks, diags: gDiags, comments: gComments }
}

// The 0-based exclusive end column of the source line the character at offset `pos`
// (column `col`) sits on. A template is the one literal that spans lines, so the whole-run
// span `scanQuoted` gives `"` and `'` is not expressible for it — `diagSpan`'s columns are
// one pair on one line — and the honest span for an unterminated one is its first line.
function tplLineEndCol(pos: i32, col: i32) {
  let p = pos
  while p < gSrc.length && gSrc[p] != '\n' && gSrc[p] != '\r' { p = p + 1 }
  col + (p - pos)
}

// True when the scanner sits inside a template hole at that hole's own brace
// depth — the test that tells a hole-closing `}` from a block-closing one, and
// the same test that suppresses NEWLINE there.
function atTplHoleDepth() {
  if gTplBrace.length == 0 { return false }
  gBrace == gTplBrace[gTplBrace.length - 1]
}

// Open a split run: the four stacks move together, and `quote` is the
// delimiter the `}` arm resumes in and the unterminated report names.
function tplOpenPush(line: i32, col: i32, pos: i32, quote: i32) {
  gTplOpenLine.push(line)
  gTplOpenCol.push(col)
  gTplOpenPos.push(pos)
  gTplBrace.push(gBrace)
  gTplQuote.push(quote)
  0
}

// Report the innermost open run as unterminated, at its opening delimiter — naming the
// literal the author opened, which is the only one they can fix.
function tplOpenDiag() {
  const oi = gTplOpenLine.length - 1
  if oi >= 0 {
    let what = "Unterminated string literal"
    if gTplQuote[oi] == '`' { what = "Unterminated template literal" }
    diagSpan(
      what,
      gTplOpenLine[oi],
      gTplOpenCol[oi],
      tplLineEndCol(gTplOpenPos[oi], gTplOpenCol[oi]),
    )
  }
  gDiags.length
}

// Close the innermost open run (the four stacks move together).
function tplOpenPop() {
  if gTplOpenLine.length > 0 {
    gTplOpenLine.pop()
    gTplOpenCol.pop()
    gTplOpenPos.pop()
    gTplBrace.pop()
    gTplQuote.pop()
  }
  0
}
