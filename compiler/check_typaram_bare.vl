// Whether a function names a type parameter only as the whole annotation of some parameters,
// the scan the check records per declaration (`tyParamBareOnlyNote`) and mono reads back.

import {
  AsExpr,
  BinExpr,
  Call,
  FuncDecl,
  Ident,
  IsExpr,
  LetDecl,
  P,
  Param,
  TypeRef,
  callHasTyArgs,
  nodeAt,
  nodeChildren,
} from "./ast"
import { monoAnnHasTyParam, unwrapParen } from "./emit_base"
import { isVarTyIxOf } from "./check_list_union"
import { identDeclOf } from "./symbols"
import { i32ListHas, strListHas } from "./listutil"

// The parameter of `fn` that binding `d` copies: `d` is annotated with a bare type parameter of
// `fn`, nothing assigns it, and it is seeded by a read of a parameter annotated so, directly or
// through such copies. A copy holds the parameter's value, so it takes the parameter's pin; -1
// for any other binding.
export function monoCopySeedParam(fn: FuncDecl, d: i32): i32 {
  let x = d
  let hops = 0
  while hops < 8 {
    hops = hops + 1
    if x < 0 || x >= P.nodes.length { return -1 }
    const n = nodeAt(x)
    if !(n is LetDecl) || !monoBareOwnTyParam(n.letType, fn) || n.letInit < 0 {
      return -1
    }
    if monoBindingAssigned(fn, x) { return -1 }
    const v = unwrapParen(n.letInit)
    if v < 0 || !(nodeAt(v) is Ident) { return -1 }
    const src = identDeclOf(v)
    if src >= 0 && src < P.nodes.length && i32ListHas(fn.fnParams, src) {
      const pn = nodeAt(src)
      if pn is Param && monoBareOwnTyParam(pn.parType, fn) { return src }
      return -1
    }
    x = src
  }
  -1
}

// Whether annotation `t` is a bare type parameter of `fn`.
function monoBareOwnTyParam(t: i32, fn: FuncDecl): boolean {
  if t < 0 || t >= P.nodes.length { return false }
  const tn = nodeAt(t)
  tn is TypeRef && strListHas(fn.fnTyParams, tn.tyName)
}

// Whether anything in `fn`'s body, a nested function included, assigns binding `d`.
function monoBindingAssigned(fn: FuncDecl, d: i32): boolean {
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is BinExpr && n.binOp == "=" {
        const l = unwrapParen(n.binLeft)
        if l >= 0 && nodeAt(l) is Ident && identDeclOf(l) == d { return true }
      }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  false
}

// Whether `fn` names type parameter `tp` only as the whole annotation of some parameters: not
// in its return type, another annotation, an `is`/`as` or a call's type arguments. The check
// records it per declaration (`tyParamBareOnlyNote`), which every reader asks.
export function tyParamOnlyBareParams(fn: FuncDecl, tp: string): boolean {
  const tps: string[] = [tp]
  const bare: i32[] = []
  for pIx in fn.fnParams {
    const p = nodeAt(pIx)
    if p is Param && p.parType >= 0 { bare.push(p.parType) }
  }
  // A copy of a parameter takes that parameter's pin, so its annotation reads `tp` bare too.
  const walk: i32[] = [fn.fnBody]
  while walk.length > 0 {
    const ix = walk.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is LetDecl && monoCopySeedParam(fn, ix) >= 0 { bare.push(n.letType) }
      for c in nodeChildren(ix) { walk.push(c) }
    }
  }
  const stack: i32[] = []
  for pIx in fn.fnParams { stack.push(pIx) }
  stack.push(fn.fnRet)
  stack.push(fn.fnBody)
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is TypeRef && monoAnnHasTyParam(ix, -1, tps) {
        let ok = n.tyName == tp
        if ok {
          ok = false
          for x in bare {
            if x == ix { ok = true }
          }
        }
        if !ok { return false }
      }
      if n is IsExpr && monoAnnHasTyParam(ix, isVarTyIxOf(ix), tps) {
        return false
      }
      if n is AsExpr && monoAnnHasTyParam(ix, -1, tps) { return false }
      if n is Call && callHasTyArgs(ix) { return false }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  true
}
