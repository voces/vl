// Record delivery rows: the deliveries queued for the record-adoption solve, the values that
// may be built at another storage, and the deliveries an adopted pin keeps.
// Does not import the checker.
import {
  ArrayLit,
  BinExpr,
  Call,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  Member,
  Node,
  P,
  arenaSetNode,
  i32ToStr,
  mkTypeRef,
  nodeAt,
  setAnnTs,
  tsToName,
} from "./ast"
import {
  recAdAt,
  recAdDecl,
  recAdDst,
  recAdElem,
  recAdLoose,
  recAdNoAdopt,
  recAdOrigDecl,
  recAdOrigFn,
  recAdOrigName,
  recAdOrigNode,
  recAdOrigTy,
  recAdOwn,
  recAdPinDecl,
  recAdPinTs,
  recAdPinTy,
  recAdPinned,
  recAdSetAt,
  recAdSetDecl,
  recAdSetDst,
  recAdSetElem,
  recAdSetGrp,
  recAdSetGrps,
  recAdSetWhole,
  recAdWhole,
  recAdWidth,
} from "./check_rec_adopt_rows"
import { i32ListHas } from "./listutil"
import {
  T,
  TY_I32,
  TY_STR,
  TyArray,
  TyMap,
  TyObj,
  TyUnion,
  tyAt,
  tyHasInferHole,
  tyHoldsObjDeep,
  tySame,
} from "./check_types"
import {
  CW_UP_LETINIT,
  cwIxUp,
  cwIxUpKind,
  cwPeelValue,
} from "./check_write_scan"
import { nonNulTyOf, tyHasTyVar, tyReachesHole, tyTvsAmong } from "./tyquery"
import { tpEnvNames } from "./check_cursor"
import { substTyDeep } from "./check_relate_core"
import {
  REC_STORE_DEPTH,
  fieldStorageEq,
  objFieldNameSetsEq,
  recAdLanding,
  recNumChanges,
} from "./check_ty_relate"
import { recAdMergeRefuse } from "./check_rec_adopt"

// The deliveries this pass has queued for the record storage rule: the value, its type, the
// type it is delivered as, and where a refusal is reported. Walked once the pass is over, when
// the occurrence index is complete and built once.
export let recPendSrc: i32[] = []
export let recPendSrcTy: i32[] = []
export let recPendDstTy: i32[] = []
export let recPendAt: i32[] = []
export let recPendSeen: {[string]: boolean} = Map()
// The type parameters in scope at each queued delivery, and those of the one being judged.
let recPendTps: string[][] = []
let recAdJudgeTps: string[] = []
let recAdJudging = false
let recBuildRefused = false

// Drop every queued delivery: at a pass's start, and once the pass has judged them.
export function recPendReset() {
  recPendSrc = []
  recPendSrcTy = []
  recPendDstTy = []
  recPendAt = []
  recPendTps = []
  recPendSeen = Map()
  recPendJudge(-1)
}

// Judge queued delivery `i` in the scope it is queued in; -1 returns to the checker's own.
export function recPendJudge(i: i32) {
  recAdJudging = i >= 0 && i < recPendTps.length
  recAdJudgeTps = if recAdJudging { recPendTps[i] } else { [] }
  0
}

// Whether the delivery being judged is refused: its adoptions stand for the re-check to read,
// but it contributes no build.
export function recPendRefusedSet(b: boolean) {
  recBuildRefused = b
  0
}

// The type parameters in scope where the delivery being judged is raised.
function recAdScope(): string[] {
  if recAdJudging { recAdJudgeTps } else { tpEnvNames }
}

// Whether no adoption can be decided at `ty`: it is a hole, reaches an inference hole, or names
// a type variable no generic enclosing the delivery binds.
export function recAdOpen(ty: i32): boolean {
  ty < 0
    || ty >= T.tys.length
    || tyHasInferHole(ty, 0)
    || !tyTvsAmong(ty, recAdScope(), 0)
}

// Whether `own` and `dst` store some part differently at some pin of the enclosing generic: with
// every type parameter bound to `i32`, or to `string`. Without one, at their own types.
export function recAdApartAtPin(own: i32, dst: i32): boolean {
  if !tyHasTyVar(own) && !tyHasTyVar(dst) {
    return !fieldStorageEq(own, dst, REC_STORE_DEPTH)
  }
  recAdApartAt(own, dst, TY_I32) || recAdApartAt(own, dst, TY_STR)
}

function recAdApartAt(own: i32, dst: i32, pin: i32): boolean {
  const names = recAdScope()
  const tys: i32[] = []
  for _ in names { tys.push(pin) }
  !fieldStorageEq(
    substTyDeep(own, names, tys),
    substTyDeep(dst, names, tys),
    REC_STORE_DEPTH,
  )
}

// Queue one delivery, when both types hold a record.
export function recPend(srcExpr: i32, srcTy: i32, dstTy: i32, at: i32) {
  if srcExpr < 0 || srcTy < 0 || dstTy < 0 || srcTy == dstTy { return 0 }
  if !tyHoldsObjDeep(srcTy) || !tyHoldsObjDeep(dstTy) { return 0 }
  const key = i32ToStr(srcExpr) + "#" + i32ToStr(srcTy) + "#" + i32ToStr(dstTy)
  if recPendSeen.has(key) { return 0 }
  recPendSeen[key] = true
  recPendSrc.push(srcExpr)
  recPendSrcTy.push(srcTy)
  recPendDstTy.push(dstTy)
  recPendAt.push(at)
  const tps: string[] = []
  for nm in tpEnvNames { tps.push(nm) }
  recPendTps.push(tps)
  0
}

// Per argument node, the record a built-container read handed to an annotated parameter is stored
// at, where the callee is instanced at that rep (D14532); and each function such an argument
// reaches. Rewritten by every pass, so the emitter reads the last pass's.
let recArgRep: Map<i32, i32> = Map()
let recRepFns: Map<i32, i32> = Map()

export function recArgRepReset() {
  recArgRep = Map()
  recRepFns = Map()
  0
}

// Records that argument `x` of function `fd` is stored at record `rep`.
export function recArgRepNote(x: i32, fd: i32, rep: i32) {
  recArgRep.set(x, rep)
  recRepFns.set(fd, 1)
  0
}

// The record argument `x` is stored at where its callee is instanced at it, else -1.
export function recArgRepOf(x: i32): i32 { recArgRep.get(x) ?? -1 }

// Whether some call hands function `fd` an argument stored at another record than its parameter.
export function recRepFnHas(fd: i32): boolean { (recRepFns.get(fd) ?? 0) == 1 }

// Deliveries of a binding, call or element at a record its own storage matches, kept to be
// asked, once the pass is over, whether the value is also built elsewhere at another storage.
export let recOwnSrc: i32[] = []
export function recOwnSrcSet(v: i32[]) { recOwnSrc = v }

// Queue `srcExpr` (a `srcTy`) when it holds a record and could name a fresh binding or call.
export function recOwnPend(srcExpr: i32, srcTy: i32) {
  if srcExpr < 0 || srcTy < 0 { return 0 }
  if !tyHoldsObjDeep(srcTy) { return 0 }
  const p = cwPeelValue(srcExpr)
  if p < 0 || p >= P.nodes.length { return 0 }
  const e = nodeAt(p)
  if e is Ident || e is Call || e is Index || e is Member || e is BinExpr {
    recOwnSrc.push(p)
  }
  0
}

// Record list literals checked this pass, asked once it is over where their elements are built.
export let recListLits: i32[] = []
export function recListLitsSet(v: i32[]) { recListLits = v }

// Record literals with fields checked outside a capture probe, asked once the check settles which
// arm each is built at (`recArmLitsAdopt`), which empties it.
export let recObjLits: i32[] = []
export function recObjLitsSet(v: i32[]) { recObjLits = v }

// The record list literals `recListLitsBuild` left for the rep rows `callBindAdoptReps` sets.
export let recListLitsLate: i32[] = []
export function recListLitsLateSet(v: i32[]) { recListLitsLate = v }

// Fresh bindings and functions not adopted (a function's result, or a width change into a
// record that drops a nested field): each delivery the emitter builds at the destination's row.
export let recKeptDecl: i32[] = []
export function recKeptDeclSet(v: i32[]) { recKeptDecl = v }

export let recKeptDst: i32[] = []
export function recKeptDstSet(v: i32[]) { recKeptDst = v }

export let recKeptAt: i32[] = []
export function recKeptAtSet(v: i32[]) { recKeptAt = v }

export let recKeptOwn: i32[] = []
export function recKeptOwnSet(v: i32[]) { recKeptOwn = v }

// Keep function `fd`'s result typed `own` and build it as `dst`, for the delivery at `at`.
export function recKeptFnPush(fd: i32, own: i32, dst: i32, at: i32) {
  if fd < 0 || own < 0 || dst < 0 || !(nodeAt(fd) is FuncDecl) { return 0 }
  recKeptDecl.push(fd)
  recKeptDst.push(dst)
  recKeptAt.push(at)
  recKeptOwn.push(own)
  0
}

// The last pass's kept functions, read by the emitter: the declaration, the record its result
// is typed as, and the record the delivery builds it as.
export let recKeptFnDecl: i32[] = []
export let recKeptFnOwn: i32[] = []
export let recKeptFnDst: i32[] = []

// Replace the kept functions with this pass's.
export function recKeptFnNote() {
  recKeptFnDecl = []
  recKeptFnOwn = []
  recKeptFnDst = []
  let k = 0
  while k < recKeptDecl.length && k < recKeptOwn.length {
    if nodeAt(recKeptDecl[k]) is FuncDecl {
      recKeptFnDecl.push(recKeptDecl[k])
      recKeptFnOwn.push(recKeptOwn[k])
      recKeptFnDst.push(recKeptDst[k])
    }
    k = k + 1
  }
  0
}

// The record the result of function `decl`, typed `own`, is built as where a kept delivery
// builds it at another storage, else -1.
export function recKeptFnDstOf(decl: i32, own: i32): i32 {
  let k = 0
  while k < recKeptFnDecl.length {
    if recKeptFnDecl[k] == decl && tySame(recKeptFnOwn[k], own) {
      return recKeptFnDst[k]
    }
    k = k + 1
  }
  -1
}

// This pass's bindings built at another record, and the last pass's, read by the emitter: each
// declaration to the storage its builds agree on, -2 where two disagree. `*Init` maps an
// un-annotated binding's peeled initialiser to it.
let recBuildPass: Map<i32, i32> = Map()
let recBuildPassInit: Map<i32, i32> = Map()
let recBuildLast: Map<i32, i32> = Map()
let recBuildLastInit: Map<i32, i32> = Map()
let recBuildPassN = 0
let recBuildN = 0

// Replace the last pass's built-elsewhere bindings with this pass's, and empty this pass's.
export function recBuildNote() {
  recBuildLast = recBuildPass
  recBuildLastInit = recBuildPassInit
  recBuildN = recBuildPassN
  recBuildPass = Map()
  recBuildPassInit = Map()
  recBuildPassN = 0
  0
}

// Record that the binding `decl`, typed `own`, keeps its type and is built as `dstIn`'s record,
// when the two have one set of field names and store a field differently. With `elem`, `decl`
// holds a list literal and the records are its elements'.
export function recBuildPush(decl: i32, own: i32, dstIn: i32, elem: boolean) {
  if (
    recBuildRefused
    || decl < 0
    || own < 0
    || dstIn < 0
    || own >= T.tys.length
    || dstIn >= T.tys.length
  ) {
    return 0
  }
  if !(nodeAt(decl) is LetDecl) || recBuildHoldsElems(decl) != elem { return 0 }
  if !(tyAt(own) is TyObj) { return 0 }
  const dst = recAdLanding(own, dstIn)
  if dst < 0 || dst >= T.tys.length || !(tyAt(dst) is TyObj) { return 0 }
  if tyReachesHole(own, 8) || tyReachesHole(dst, 8) { return 0 }
  if (
    !objFieldNameSetsEq(own, dst)
    || fieldStorageEq(own, dst, REC_STORE_DEPTH)
  ) {
    return 0
  }
  const cur = recBuildPass[decl] ?? -1
  if cur == -1 {
    recBuildPass[decl] = dst
  } else if cur >= 0 && !fieldStorageEq(cur, dst, REC_STORE_DEPTH) {
    recBuildPass[decl] = -2
  }
  const n = nodeAt(decl)
  if n is LetDecl && n.letType < 0 {
    recBuildPassInit[cwPeelValue(n.letInit)] = decl
  }
  recBuildPassN = recBuildPassN + 1
  0
}

// Whether the binding `decl` is initialised with a list literal or a `Map()`, whose elements or
// values are what its builds record; false for any other node.
export function recBuildHoldsElems(decl: i32): boolean {
  if decl < 0 || decl >= P.nodes.length { return false }
  const d = nodeAt(decl)
  if !(d is LetDecl) || d.letInit < 0 { return false }
  const iv = cwPeelValue(d.letInit)
  if iv < 0 || iv >= P.nodes.length { return false }
  const n = nodeAt(iv)
  if n is ArrayLit { return true }
  if !(n is Call) || n.callArgs.length != 0 || n.callFn < 0 { return false }
  const f = nodeAt(n.callFn)
  f is Ident && f.identName == "Map"
}

// The record the un-annotated binding `decl` of an object literal is built as, where a delivery
// to a record that stores a field differently keeps its own type and every such delivery agrees
// on the storage; else -1. Decided before any instance is elaborated: a use at a type parameter
// follows it.
export function recBuildTyOf(decl: i32): i32 {
  if recBuildHoldsElems(decl) { return -1 }
  recBuildAt(decl)
}

// `recBuildTyOf` for a binding of a list literal or a `Map()`: the record its elements or values
// are built as.
export function recBuildElemTyOf(decl: i32): i32 {
  if !recBuildHoldsElems(decl) { return -1 }
  recBuildAt(decl)
}

// `recBuildElemTyOf` of the binding whose `Map()` initialiser is the Call node `init`; -1 when
// no recorded build names it.
export function recBuildElemTyOfInit(init: i32): i32 {
  const d = recBuildLastInit[init] ?? -1
  if d < 0 { -1 } else { recBuildElemTyOf(d) }
}

// How many bindings the last pass recorded as built at another record.
export function recBuildCount(): i32 { recBuildN }

// `recBuildAt` of every recorded binding: declaration to the storage its builds agree on, -2
// where they disagree. Read through `recBuildTyIn`.
export function recBuildTable(): Map<i32, i32> { recBuildLast }

// The builds the current pass has recorded so far, read like `recBuildTable`'s.
export function recBuildPassTable(): Map<i32, i32> { recBuildPass }

// `recBuildTyOf` (`elems` false) or `recBuildElemTyOf` (true) of `decl`, read from `tbl`.
export function recBuildTyIn(
  tbl: Map<i32, i32>,
  decl: i32,
  elems: boolean,
): i32 {
  const r = tbl[decl] ?? -1
  if r < 0 || recBuildHoldsElems(decl) != elems { -1 } else { r }
}

// The one storage every recorded build of `decl` agrees on, else -1.
function recBuildAt(decl: i32): i32 {
  const r = recBuildLast[decl] ?? -1
  if r < 0 { -1 } else { r }
}

// `recBuildAt` over the builds this pass has recorded so far.
export function recBuildPassAt(decl: i32): i32 {
  const r = recBuildPass[decl] ?? -1
  if r < 0 { -1 } else { r }
}

// While on, each delivery of a fresh value the solve judged: the value's declared name and
// declaration, the delivery, and a REC_DELIV_* flag: built at another storage (kept), at its
// own, or a delivery whose judgement read the value's site count.
export const REC_DELIV_KEPT = 1
export const REC_DELIV_OWN = 2
export const REC_DELIV_READ = 4
export let recDelivOn = false
export let recDelivName: string[] = []
export let recDelivDecl: i32[] = []
export let recDelivAt: i32[] = []
export let recDelivFlag: i32[] = []
export function recDelivArm(on: boolean) {
  recDelivOn = on
  recDelivName = []
  recDelivDecl = []
  recDelivAt = []
  recDelivFlag = []
}

// The declared name of a fresh value's declaration: a function's, a binding's, or the binding
// a lambda is bound to; "" for none. Reads the occurrence index, so it is built first.
function recDelivNameOf(d: i32): string {
  if d < 0 || d >= P.nodes.length { return "" }
  const n = nodeAt(d)
  if n is LetDecl { return n.letName }
  if n is FuncDecl && n.fnName != "" { return n.fnName }
  recDelivInitName(d)
}

// The let whose initialiser is the anonymous function `d`, or "" for any other node.
function recDelivInitName(d: i32): string {
  if (
    !(nodeAt(d) is FuncDecl)
    || d >= cwIxUpKind.length
    || cwIxUpKind[d] != CW_UP_LETINIT
  ) {
    return ""
  }
  const u = cwIxUp[d]
  if u < 0 || u >= P.nodes.length { return "" }
  const ld = nodeAt(u)
  if ld is LetDecl { ld.letName } else { "" }
}

export function recDelivPush(decl: i32, at: i32, flag: i32) {
  if !recDelivOn { return 0 }
  recDelivName.push(recDelivNameOf(decl))
  recDelivDecl.push(decl)
  recDelivAt.push(at)
  recDelivFlag.push(flag)
  0
}

// The record `dstIn` delivers the record `own` as, when the two share field names and neither
// is open; -1 otherwise.
function recAdFitDst(own: i32, dstIn: i32): i32 {
  if own < 0 || own >= T.tys.length || !(tyAt(own) is TyObj) { return -1 }
  const dst = recAdLanding(own, dstIn)
  if dst < 0 || dst >= T.tys.length || !(tyAt(dst) is TyObj) { return -1 }
  if recAdOpen(own) || recAdOpen(dst) { return -1 }
  if !objFieldNameSetsEq(own, dst) { return -1 }
  dst
}

// Push one demand on the declaration `decl`: a binding, or a function with no declared result.
export function recAdPushDecl(
  decl: i32,
  own: i32,
  dstIn: i32,
  elem: boolean,
  at: i32,
) {
  if own < 0 || dstIn < 0 || own >= T.tys.length || dstIn >= T.tys.length {
    return 0
  }
  const ou = tyAt(own)
  // A list literal of several records adopts when every one of them lands on one record.
  if ou is TyUnion && elem {
    const d0 = recAdFitDst(ou.uMembers[0], dstIn)
    for m in ou.uMembers {
      if d0 < 0 || recAdFitDst(m, dstIn) != d0 { return 0 }
    }
    for m in ou.uMembers { recAdPushDecl(decl, m, dstIn, elem, at) }
    return 0
  }
  const dst = recAdFitDst(own, dstIn)
  if dst < 0 { return 0 }
  if !recAdApartAtPin(own, dst) { return 0 }
  if decl < 0 { return 0 }
  const wide = recNumChanges(own, dst, REC_STORE_DEPTH)
  if nodeAt(decl) is FuncDecl {
    recKeptDecl.push(decl)
    recKeptDst.push(dst)
    recKeptAt.push(at)
    recKeptOwn.push(own)
    return 0
  }
  if recAdNoAdopt.has(decl) {
    recBuildPush(decl, own, dst, elem)
    recAdMergeRefuse(decl, own, dst, elem, at)
    return 0
  }
  if wide { recAdWidth[decl] = true }
  recAdDecl.push(decl)
  recAdOwn.push(own)
  recAdDst.push(dst)
  recAdElem.push(elem)
  recAdWhole.push(-1)
  recAdAt.push(at)
  0
}

// A literal list binding of records `own` delivered as a list of the record union `dst`: it
// adopts the union list, so every handle on it shares one element storage.
export function recAdPushUnionList(decl: i32, own: i32, dst: i32, at: i32) {
  if (
    decl < 0
    || own < 0
    || dst < 0
    || own >= T.tys.length
    || dst >= T.tys.length
  ) {
    return 0
  }
  if !(tyAt(own) is TyObj) || !(tyAt(dst) is TyUnion) { return 0 }
  if tyReachesHole(own, 8) || tyReachesHole(dst, 8) { return 0 }
  if !(nodeAt(decl) is LetDecl) || recAdNoAdopt.has(decl) { return 0 }
  recAdDecl.push(decl)
  recAdOwn.push(own)
  recAdDst.push(dst)
  recAdElem.push(true)
  recAdWhole.push(-1)
  recAdAt.push(at)
  0
}

// A delivery that closes binding `decl`'s open function fields, building it as `whole` (a
// record, or a list or map holding records), asked by judged call `grp`: `recAdPushDecl` reads
// the binding's own type as one storage with it, since they differ only in holes, so it is
// queued apart and settled by `recAdSettle`.
export function recAdPushSettled(decl: i32, whole: i32, at: i32, grp: i32) {
  if decl < 0 || decl >= P.nodes.length || !(nodeAt(decl) is LetDecl) {
    return 0
  }
  if whole < 0 || whole >= T.tys.length { return 0 }
  if tyReachesHole(whole, 8) || recAdNoAdopt.has(decl) { return 0 }
  let dst = whole
  let depth = 0
  while depth < REC_STORE_DEPTH && dst >= 0 && dst < T.tys.length {
    const t = tyAt(dst)
    if t is TyArray { dst = t.aElem }
    else if t is TyMap { dst = t.mVal }
    else { break }
    depth = depth + 1
  }
  if dst < 0 || dst >= T.tys.length || !(tyAt(dst) is TyObj) { return 0 }
  recAdSetDecl.push(decl)
  recAdSetDst.push(dst)
  recAdSetElem.push(depth > 0)
  let wh = whole
  if depth == 0 || depth == 1 && tyAt(whole) is TyArray { wh = -1 }
  recAdSetWhole.push(wh)
  recAdSetAt.push(at)
  recAdSetGrp.push(grp)
  0
}

// A fresh tag for one judged call's settled deliveries.
export function recAdSetGroup(): i32 {
  recAdSetGrps = recAdSetGrps + 1
  recAdSetGrps
}

// `recAdPushDecl` for a `Map()` binding of type `own` delivered as the map `dst`: the record
// its values (or its maps' values, or the lists among them) hold, under the same keys,
// delivered as `dst`'s.
export function recAdPushMapDecl(decl: i32, own: i32, dst: i32, at: i32) {
  let o = own
  let d = dst
  let depth = 0
  while depth < REC_STORE_DEPTH {
    if o < 0 || d < 0 || o >= T.tys.length || d >= T.tys.length { return 0 }
    const om = tyAt(o)
    const dm = tyAt(d)
    if !(om is TyMap) || !(dm is TyMap) { break }
    if !tySame(om.mKey, dm.mKey) { return 0 }
    o = om.mVal
    d = dm.mVal
    depth = depth + 1
  }
  if depth == 0 || o < 0 || o >= T.tys.length || d < 0 || d >= T.tys.length {
    return 0
  }
  // A map of lists of records: the records its lists hold.
  const ol = tyAt(o)
  const dl = tyAt(d)
  if ol is TyArray && dl is TyArray {
    o = ol.aElem
    d = dl.aElem
    if o < 0 || d < 0 || o >= T.tys.length || d >= T.tys.length { return 0 }
  }
  if recAdLanding(o, d) != d { return 0 }
  const n = recAdDecl.length
  recAdPushDecl(decl, o, d, true, at)
  if recAdDecl.length > n { recAdWhole[n] = dst }
  0
}

// The list member of the union `dst` a list literal lands on: its one list of records.
// Otherwise `dst`.
export function recAdLandingList(dst: i32): i32 {
  if dst < 0 { return dst }
  const d = tyAt(dst)
  if !(d is TyUnion) { return dst }
  let hit = -1
  for m in d.uMembers {
    const mm = nonNulTyOf(m)
    if mm >= 0 && tyAt(mm) is TyArray && tyHoldsObjDeep(mm) {
      if hit >= 0 { return dst }
      hit = mm
    }
  }
  if hit < 0 { return dst }
  hit
}

// Write each adopted type as its declaration's annotation, keeping the node it replaces.
export function recAdApplyPins() {
  let i = 0
  while i < recAdPinDecl.length {
    recAdPinLet(recAdPinDecl[i], recAdPinTy[i], recAdPinTs[i])
    recAdPinFn(recAdPinDecl[i], recAdPinTy[i], recAdPinTs[i])
    i = i + 1
  }
  0
}

// Remember the declaration `d` an adoption rewrites, with its name, kind and new type.
function recAdKeep(d: i32, n: Node, name: string, isFn: boolean, ty: string) {
  recAdOrigDecl.push(d)
  recAdOrigNode.push(n)
  recAdOrigName.push(name)
  recAdOrigFn.push(isFn)
  recAdOrigTy.push(ty)
  0
}

// The annotation spelled by tree `root` at the declaration `d`, as a written one would be; -1,
// and `d` never adopts, when the adopted type has no tree.
function recAdPinAnn(d: i32, root: i32, pos: i32): i32 {
  if root < 0 {
    recAdNoAdopt[d] = true
    return -1
  }
  const ann = mkTypeRef(tsToName(root), pos)
  setAnnTs(ann, root)
  ann
}

// Write `ty`, spelled by tree `root`, as the annotation of the binding declared at `d`, when it is one.
function recAdPinLet(d: i32, ty: string, root: i32) {
  const n = nodeAt(d)
  if n is LetDecl {
    const ann = recAdPinAnn(d, root, n.pos)
    if ann < 0 { return 0 }
    recAdKeep(d, n, n.letName, false, ty)
    recAdPinned[d] = true
    const nn: Node = {
      letKw: n.letKw,
      letName: n.letName,
      letType: ann,
      letInit: n.letInit,
      pos: n.pos,
    }
    arenaSetNode(d, nn)
  }
  0
}

// Write `ty`, spelled by tree `root`, as the declared result of the function declared at `d`.
function recAdPinFn(d: i32, ty: string, root: i32) {
  const n = nodeAt(d)
  if n is FuncDecl {
    const ann = recAdPinAnn(d, root, n.pos)
    if ann < 0 { return 0 }
    recAdKeep(d, n, n.fnName, true, ty)
    const nn: Node = {
      fnName: n.fnName,
      fnTyParams: n.fnTyParams,
      fnParams: n.fnParams,
      fnRet: ann,
      fnBody: n.fnBody,
      pos: n.pos,
    }
    arenaSetNode(d, nn)
  }
  0
}

// Whether the last solve found a declaration to adopt a wider type.
export function recAdPending(): boolean { recAdPinDecl.length > 0 }

// How many adoptions stand, a mark for `recAdLoosened` and `recAdUndo`.
export function recAdMark(): i32 { recAdOrigDecl.length }

// Whether an adoption since `mark` stands while the re-check refused something other than an
// adopted value handed on whole.
export function recAdLoosened(mark: i32): boolean {
  recAdOrigDecl.length > mark && recAdLoose > 0
}

// Restore the declarations an adoption rewrote since `mark` (only those in `only`, when it is
// not empty), except one adopted across a numeric width (`recAdWidth`), and never adopt them
// again. True when it restored any.
export function recAdUndo(mark: i32, only: i32[]): boolean {
  let any = false
  let i = mark
  let k = mark
  while i < recAdOrigDecl.length {
    const d = recAdOrigDecl[i]
    if recAdWidth.has(d) || (only.length > 0 && !i32ListHas(only, d)) {
      recAdOrigDecl[k] = d
      recAdOrigNode[k] = recAdOrigNode[i]
      recAdOrigName[k] = recAdOrigName[i]
      recAdOrigFn[k] = recAdOrigFn[i]
      recAdOrigTy[k] = recAdOrigTy[i]
      k = k + 1
    } else {
      arenaSetNode(d, recAdOrigNode[i])
      recAdNoAdopt[d] = true
      recAdPinned[d] = false
      any = true
    }
    i = i + 1
  }
  while recAdOrigDecl.length > k {
    recAdOrigDecl.pop()
    recAdOrigNode.pop()
    recAdOrigName.pop()
    recAdOrigFn.pop()
    recAdOrigTy.pop()
  }
  any
}
