// `check_nar_bank.vl` — the declared-type bank under a bare-name narrowing. Before a narrowing
// shadows a binding, `noteNarShadow` banks the type its storage holds, keyed by name, scope depth
// and kind (`NAR_KIND_*`), with one frame mark per scope; `narDeclaredTy` answers from the
// innermost live row. `narBankReset` clears the bank per program, and `narBankPushFrame` and
// `narBankPopFrame` follow the checker's scopes.

import { lookupDepth, scopeDepthsOf } from "./check_scopes"
import { T, tySame } from "./check_types"

// Narrowed bare-name bindings: name → its declared type, banked before a narrowing shadows
// it, with per-scope frame marks. Two kinds ride one bank because one question is asked of both
// — what the storage can hold — and an entry answers only while its own `declare` is the
// innermost binding. `narFnEpoch` counts bodies checked, so a captured narrowing keeps refusing.
export const NAR_KIND_ASG = 0
export const NAR_KIND_GUARD = 1
// The post-guard fall-through's shadow, banked under a kind of its own. `if r is JsonError
// { return }` narrows the rest of the block by a plain `declare`, with no `NAR_KIND_GUARD` row,
// and the deep-`is` walker needs that shadow banked to spell its parameter with the declared
// union. A third kind, so `narGuardSlot` and dead-`??` keep seeing exactly the rows they had.
export const NAR_KIND_POSTGUARD = 2
export let narFnEpoch = 0

export let asgDeclKeys: string[] = []
export let asgDeclTys: i32[] = []
export let asgDeclDepths: i32[] = []
export let asgDeclKinds: i32[] = []
export let asgDeclEpochs: i32[] = []
// Whether the bank row's scope already declares the name at the time it is noted: a write in the
// block that declares a binding, rather than a narrowing layer over an outer one.
export let asgDeclOver: boolean[] = []
export let asgDeclFrames: i32[] = []
// Each row's push number, ascending along the bank and never reused, so a reader can tell
// which prefix of the bank is the one it last saw.
export let asgDeclStamps: i32[] = []
let narBankStampNext = 1
// Each name's bank rows, in bank order, so a question about one name reads only its own rows.
let asgDeclRowsOf: {[string]: i32[]} = Map()
const asgNoRows: i32[] = []

// The bank rows of `name`, oldest first; the caller must not change the list.
export function narBankRowsOf(name: string): i32[] {
  asgDeclRowsOf[name] ?? asgNoRows
}

// The declared type banked for narrowed `name`, or -1 when no live entry of a matching kind
// still shadows the name. `kind` is `NAR_KIND_ASG` / `NAR_KIND_GUARD`, or -1 for either. Entries
// of the wrong kind are skipped rather than stopping the walk, so a guard narrowing layered over
// an assignment narrowing does not hide it from the assignment-kind question.
export function narDeclaredTy(name: string, kind: i32) {
  const d = lookupDepth(name)
  if d < 0 { return -1 }
  const rows = narBankRowsOf(name)
  let k = rows.length - 1
  while k >= 0 {
    const i = rows[k]
    if asgDeclDepths[i] == d {
      if kind < 0 || asgDeclKinds[i] == kind { return asgDeclTys[i] }
    }
    k = k - 1
  }
  -1
}

// The storage type of the binding a read of `name`, typed `t`, narrows, or -1 when the read is
// not narrowed: the outermost banked row of the layers over that binding. A layer with no row
// of its own (a guard repeating a narrowing already in force) is crossed while its type matches.
export function narReadFromTy(name: string, t: i32): i32 {
  const rows = narBankRowsOf(name)
  if rows.length == 0 { return -1 }
  const ds = scopeDepthsOf[name]
  if ds == null { return -1 }
  let st = -1
  let k = ds.length - 1
  while k >= 0 {
    const d = ds[k]
    let row = -1
    let r = rows.length - 1
    while r >= 0 {
      if asgDeclDepths[rows[r]] == d {
        row = rows[r]
        r = 0
      }
      r = r - 1
    }
    let stop = k == 0
    if row >= 0 {
      st = asgDeclTys[row]
      if asgDeclOver[row] { stop = true }
    } else if !stop {
      stop = !tySame(T.scopes[d][name] ?? -1, T.scopes[ds[k - 1]][name] ?? -1)
    }
    k = if stop { -1 } else { k - 1 }
  }
  if st < 0 || tySame(st, t) { return -1 }
  st
}

// The declared type of an assignment-narrowed name, or -1.
export function asgDeclaredTy(name: string) {
  narDeclaredTy(name, NAR_KIND_ASG)
}

// Bank `name`'s declared type before a narrowing shadows it, at the scope depth the shadowing
// `declare` writes to. Idempotent per (name, depth, kind): a second `x = e` must not re-bank the
// already-narrowed type as the declaration.
export function noteNarShadow(name: string, declTy: i32, kind: i32) {
  const d = T.scopes.length - 1
  const rows = narBankRowsOf(name)
  let k = rows.length - 1
  while k >= 0 {
    const i = rows[k]
    if asgDeclDepths[i] == d && asgDeclKinds[i] == kind { return 0 }
    k = k - 1
  }
  const own = asgDeclRowsOf[name]
  if own == null {
    asgDeclRowsOf[name] = [asgDeclKeys.length]
  } else {
    own.push(asgDeclKeys.length)
  }
  asgDeclKeys.push(name)
  asgDeclStamps.push(narBankStampNext)
  narBankStampNext = narBankStampNext + 1
  asgDeclTys.push(declTy)
  asgDeclDepths.push(d)
  asgDeclKinds.push(kind)
  asgDeclEpochs.push(narFnEpoch)
  asgDeclOver.push(T.scopes[d].has(name))
  0
}

// Clear the bank and the body count, once per program.
export function narBankReset() {
  asgDeclKeys = []
  asgDeclStamps = []
  asgDeclTys = []
  asgDeclDepths = []
  asgDeclKinds = []
  asgDeclEpochs = []
  asgDeclOver = []
  asgDeclFrames = []
  asgDeclRowsOf = Map()
  narFnEpoch = 0
  0
}

// Open a scope's frame: its rows start at the bank's current length.
export function narBankPushFrame() {
  asgDeclFrames.push(asgDeclKeys.length)
  0
}

// Close the innermost scope's frame, dropping the rows banked inside it.
export function narBankPopFrame() {
  if asgDeclFrames.length == 0 { return 0 }
  const abase = asgDeclFrames[asgDeclFrames.length - 1]
  asgDeclFrames.pop()
  while asgDeclKeys.length > abase {
    const own = asgDeclRowsOf[asgDeclKeys[asgDeclKeys.length - 1]]
    if own != null { own.pop() }
    asgDeclKeys.pop()
    asgDeclStamps.pop()
    asgDeclTys.pop()
    asgDeclDepths.pop()
    asgDeclKinds.pop()
    asgDeclEpochs.pop()
    asgDeclOver.pop()
  }
  0
}
