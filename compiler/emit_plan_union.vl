// The capture slot `name` reads from the env of capturing function `fnIx`, or -1.
export function captureSlotOf(name: string, fnIx: i32): i32 {
  if fnIx < 0 || !fnNestUsed { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 || fnEnvIdxOf(fe) < 0 { return -1 }
  if emitPhaseReached("capsCached") && fe < capCountTbl.length {
    const start = capStartTbl[fe]
    let fi = 0
    while fi < capCountTbl[fe] {
      if capNamesFlat[start + fi] == name { return fi }
      fi = fi + 1
    }
    return -1
  }
  return strListIndexOf(captureNamesOf(fe), name)
}

// The compile-time value of a monomorphized-instance `is` guard: 1 (always true), 0
// (always false), or -1 (not statically decidable, so `emitIs`'s runtime paths handle
// it). Each instance pins an un-annotated param to one concrete type.
export function monoStaticIsResult(isIx: i32, fnIx: i32) {
  const nd = nodeAt(isIx)
  if nd is IsExpr {
    // A tested type naming a row of a union receiver is the union ladder's, not a static guard;
    // an operand that is no union answers here even when its tested type names a row (#1310).
    if (
      nodeTyIsUnion(nd.isObj)
      && isTestedRowOf(isVarTyIxOf(isIx), nd.isObj) >= 0
    ) {
      return -1
    }
    if exprUnion(nd.isObj, fnIx) { return -1 }
    const objTy = nodeTyAt(unwrapParen(nd.isObj), fnIx)
    if isWholeOfOneListUnion(objTy, isVarTyIxOf(isIx)) { return 1 }

    // An exact instance knows the operand's type, where a spelling renders a Set as its
    // boolean map: a union is no static answer, and a single type is its own (D2753).
    const ext = exactOperandTyOf(nd.isObj, fnIx)
    if ext >= 0 {
      const exm: i32[] = []
      flattenVariantsInto(ext, exm)
      if exm.length > 1 { return -1 }
      const ept = isVarTyIxOf(isIx)
      if ept >= 0 {
        if tySameSet(ext, ept) { return 1 }
        if tySameSpelled(ext, ept) { return 0 }
      }
    }

    if nodeTyIsNullable(nd.isObj) { return -1 }
    // A join the instance re-typed at its pin answers only for its own type; the name cascade
    // below reads its arms' reps instead (D3568).
    const jo = unwrapParen(nd.isObj)
    if jo >= 0 && nodeAt(jo) is IfStmt {
      const jt = nodeTyIxOf(jo)
      if jt >= 0 && !tyHasTyVar(jt) {
        const ept = isVarTyIxOf(isIx)
        if ept >= 0 && tySameSet(jt, ept) { return 1 }
        return -1
      }
    }
    // The instance's operand type against the checker's tested type, by the checker's `is`
    // relation (D15252).
    const cmpTy = isVarTyIxOf(isIx)
    if cmpTy < 0 { return -1 }
    const pin = if ext >= 0 { ext } else { instanceReadTyOf(nd.isObj, fnIx) }
    return isTestAnswer(pin, cmpTy)
  }
  return -1
}

// Whether `xTy` is the one list a union of one-list members `recvTy` reps as, with a plain
// scalar leaf: every value of `recvTy` fits it, whichever member spelled it (D6770).
export function isWholeOfOneListUnion(recvTy: i32, xTy: i32): boolean {
  if recvTy < 0 || xTy < 0 || xTy >= T.tys.length { return false }
  if oneListUnionRender(recvTy) == "" { return false }
  const ru = tyAt(recvTy)
  if !(ru is TyUnion) { return false }
  const xd = listLeafDepth(xTy)
  if xd <= 0 { return false }
  const pn = tyPrimNameOf(listLeafOf(xTy))
  if pn == null || pn == "string" { return false }
  const m = ru.uMembers[0]
  if listLeafDepth(m) != xd { return false }
  return tyScalarBasePrim(listLeafOf(m)) == pn
}

// How many list levels `ty` has before its leaf, or -1 on an arena hole.
function listLeafDepth(ty: i32): i32 {
  let cur = ty
  let d = 0
  while d < 64 {
    if cur < 0 || cur >= T.tys.length { return -1 }
    const t = tyAt(cur)
    if !(t is TyArray) { return d }
    cur = tyElemOf(t)
    d = d + 1
  }
  return -1
}

// The leaf element type of the list `ty`, or `ty` itself when it is no list.
function listLeafOf(ty: i32): i32 {
  let cur = ty
  let d = 0
  while d < 64 && cur >= 0 && cur < T.tys.length {
    const t = tyAt(cur)
    if !(t is TyArray) { return cur }
    cur = tyElemOf(t)
    d = d + 1
  }
  return cur
}

// Whether no arm of the union box `recvIx` reads at can carry the value-arm tag `tag`: each arm
// claims another value tag, or is a struct variant, whose tag is below every value tag. False
// when the union is unnamed or an arm is neither, so its tag set is not known.
function unionBoxLacksTag(recvIx: i32, tag: i32, fnIx: i32): boolean {
  if tag < uVariants.length { return false }
  if !exprUnion(recvIx, fnIx) { return false }
  const uTy = unionBoxTyOfRead(recvIx, fnIx)
  const arms: i32[] = []
  if !unionTyMemberTys(uTy, arms) || arms.length == 0 { return false }
  const u = unRowOfTyKey(uTy)
  let i = 0
  while i < arms.length {
    const t = isArmTagOfTy(arms[i])
    if t == tag { return false }
    if (
      t < 0
      && variantRowInRowOfTy(u, arms[i]) < 0
      && !(tyAt(arms[i]) is TyObj)
    ) {
      return false
    }
    i = i + 1
  }
  return true
}

// The value-atom kind the payload of box arm `armTy` rides, given the arm's own kind `k`: a
// literal-union arm (kind -1, no value atom) is held as its member string, so it rides kind 2.
// Read off the arm's type, never its spelling, so an alias arm resolves too (D5260).
function boxArmKindOfTy(k: i32, armTy: i32): i32 {
  if k >= 0 { return k }
  if tyIsLitUnion(armTy) { return 2 }
  return k
}

// `isArmTagOfTy` at receiver `recv`: a list of Sets, which shares its slot with the boolean-map
// list, takes the slot's tag where `recv`'s union holds it and no other member at that slot, so
// the tag names it alone (D16172).
export function isArmTagOfTyAt(ity: i32, recv: i32, fnIx: i32): i32 {
  const t = isArmTagOfTy(ity)
  if t >= 0 || ity < 0 || !unMemIsRefElemArray(ity) { return t }
  if !tyMentionsSet(tyRefArrElemOf(ity), TY_WALK_DEPTH) { return t }
  // Read, never minted: a row minted here would move the slots the boxing sites chose.
  const sl = rlSlotOfTy(tyRefArrElemOf(ity))
  if sl < 0 { return t }
  const ms: i32[] = []
  flattenVariantsInto(nodeTyAt(recv, fnIx), ms)
  let found = false
  for m in ms {
    if m >= 0 && unMemIsRefElemArray(m) && rlSlotOfTy(tyRefArrElemOf(m)) == sl {
      if !tySameSet(m, ity) { return t }
      found = true
    }
  }
  return if found { refArrSlotTag(sl) } else { t }
}

// Whether a receiver of base `base` can be read once and compared with every one of `texts`:
// a float holds any of them; otherwise each is an integer, fitting `i32` where the base is.
function numLitOnceReadOk(base: string, texts: string[]): boolean {
  if base == "f64" || base == "f32" { return true }
  const narrow = base == "i32"
  for t in texts {
    if numLexIsFloat(t) || narrow && !numLexFitsI32(t) { return false }
  }
  return narrow || base == "i64"
}

// The base numeric scalar an `is` receiver reps as in this instance — `"i32"`/`"i64"`/
// `"f64"`, or `""` otherwise. `nodeNumScalarBaseName` reads the checker's bank; an
// un-annotated parameter has none, so its pin type answers per instance. A nullable
// receiver is refused, since its name would drop the `null`.
function isNumRecvBaseName(recvIx: i32, fnIx: i32) {
  const nb = nodeNumScalarBaseName(recvIx)
  if nb != "" { return nb }
  if tyIsPrimNamed(nodeTyIxOf(unwrapParen(recvIx)), "f32") { return "f32" }
  if nodeTyIsNullable(recvIx) { return "" }
  const t = monoArgClosedPinTy(recvIx, fnIx)[0]
  if t < 0 || t >= T.tys.length { return "" }
  if tyIsPrimNamed(t, "i32") { return "i32" }
  if tyIsPrimNamed(t, "i64") { return "i64" }
  if tyIsPrimNamed(t, "f64") { return "f64" }
  return if tyAt(t) is TyUnion { numLitUnionBaseName(t) } else { "" }
}

// True when the union with member set `s` and type `ty` carries a literal-union arm beside another
// value arm: the box shape where `x is K` is membership over the payload, never a tag compare. The
// set answers where it can, else the type. A union neither answers for has no arm reading, which
// is a loud floor.
export function unionCarriesLitUnionArmOfSet(s: i32, ty: i32): boolean {
  const v = msSetCarriesLitUnionArm(s)
  if v >= 0 { return v == 1 }
  const tv = tyCarriesLitUnionArm(ty)
  if tv >= 0 { return tv == 1 }
  emitFail(
    "emitProgram: a union's literal-union arms are read off neither its member set nor its type",
  )
  return false
}

// Whether union type `ty` is a value union with a literal-union arm, read off its declared
// members, so an alias arm stays whole: every member a value atom, `null` or a literal union, one
// literal union and 2+ non-null members. A bare literal member is its base. -1 where `ty` is no
// union, or carries a literal union beside a shape this walk does not claim.
function tyCarriesLitUnionArm(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  let ms: i32[] = []
  if t is TyUnion {
    ms = t.uMembers
  } else if t is TyNullable {
    if t.nInner < 0 { return -1 }
    const it = tyAt(t.nInner)
    if it is TyUnion { ms = it.uMembers } else { ms = [t.nInner] }
  } else {
    return -1
  }
  let lit = false
  let unclaimed = false
  let nonNull = 0
  for m in ms {
    if m >= 0 {
      if tyIsLitUnionOfAnyBase(m) {
        lit = true
        nonNull = nonNull + 1
      } else {
        const k = valueRowKind(m)
        if k == -2 { unclaimed = true }
        if k == -1 { return 0 }
        if k >= 0 && k != 6 { nonNull = nonNull + 1 }
      }
    }
  }
  if !lit { return 0 }
  if unclaimed { return -1 }
  return if nonNull >= 2 { 1 } else { 0 }
}

// Whether `m` is a union of literals only, of any base.
function tyIsLitUnionOfAnyBase(m: i32): boolean {
  const t = tyAt(m)
  if !(t is TyUnion) || t.uMembers.length < 1 { return false }
  for u in t.uMembers {
    if u < 0 || !(tyAt(u) is TyLit) { return false }
  }
  return true
}

// True when `recvIx` is a receiver `emitLitMemberEq` can be applied to repeatedly: a
// value-union box, a string-repped litunion, a plain `string`, or the `string | null`
// niche (whose compare answers false for null).
function litMembershipRecvOk(recvIx: i32, fnIx: i32) {
  if exprUnion(recvIx, fnIx) {
    const bxr: i32[] = []
    const bxNm = unionNameRowOfExpr(recvIx, fnIx, bxr)
    if bxNm == "" { return false }
    const bxs = msSetOfRow(bxr[0])
    if isValueUnionOfSet(bxs, bxr[1]) { return true }
    return unionCarriesLitUnionArmOfSet(bxs, bxr[1])
  }
  if nodeTyIsLitUnion(recvIx) { return true }
  if exprString(recvIx, fnIx) { return true }

  return exprNullableString(recvIx, fnIx)
}

// The primitive the tested type `ity` denotes, when it is one of the six value
// primitives; `""` for every shape a niche member cannot be confused with (struct, list,
// map, closure, literal, union). `ity` is the checker's own banked type, never re-parsed.
export function isTestValuePrimName(ity: i32) {
  if ity < 0 { return "" }
  match tyPrimNameOf(ity) {
    "i32" => {
      return "i32"
    }
    "i64" => {
      return "i64"
    }
    "f32" => {
      return "f32"
    }
    "f64" => {
      return "f64"
    }
    "boolean" => {
      return "boolean"
    }
    "string" => {
      return "string"
    }
    // Not a value primitive a niche member can be confused with, or not a primitive at all.
    "void" | "null" | "never" | "u8" | "i8" | "u16" | "i16" | "v128" | null => {}
  }
  return ""
}

// The rep class of the sole non-null member of nullable niche `recvIx`: `"boolean"` /
// `"string"` for the two primitive niches, `"#ref"` for every reference shape, `""` for a
// receiver the `is`-niche ladder does not claim.
function nulNicheBaseClass(recvIx: i32, fnIx: i32) {
  const nk = exprNulKind(recvIx, fnIx)
  if nk == "nulbool" { return "boolean" }
  if nk == "nulstr" { return "string" }
  if nodeRepIsRefKind(recvIx, fnIx) { return "#ref" }
  return ""
}

// True when `ity` provably cannot be the sole non-null member of nullable niche `recvIx`,
// so `recv is <ity>` is statically false — else the niche's own null test would wrongly
// answer true for every present value too. One-sided: both halves must be positively known.
export function nulNicheIsTestImpossible(recvIx: i32, ity: i32, fnIx: i32) {
  // An exact instance knows the member the niche holds: its twin shares the pattern's row (D2753).
  if exactUnionLacksTwin(recvIx, ity, fnIx) { return true }
  // A record niche holds the instance's own record, so a tested record the `is` relation says
  // it never is cannot be the value, and the test is not the null check (D16370).
  if tyIsRecord(ity) {
    const inner = nullableInnerOrNone(instanceReadTyOf(recvIx, fnIx))
    if inner >= 0 && tyIsRecord(inner) && isTestAnswer(inner, ity) == 0 {
      return true
    }
  }
  // So does a list niche: its list's annotation fixes its elements, so a list the relation
  // says it never is cannot be the value, even empty (D16713).
  if tyArrayElemIx(ity) >= 0 {
    const inner = nullableInnerOrNone(instanceReadTyOf(recvIx, fnIx))
    if (
      inner >= 0
      && tyArrayElemIx(inner) >= 0
      && isTestAnswer(inner, ity) == 0
    ) {
      return true
    }
  }
  // A map niche holds one map type: a pattern naming another map is never it (D2493).
  if unMemIsMap(ity) && !exprUnion(recvIx, fnIx) {
    // An instance parameter's pin names the niche's map exactly; a spelling needs the lenient
    // comparison, which declines where a Set or a literal union could be either.
    const pin = mapPinnedParamTyOf(recvIx, fnIx)
    if pin >= 0 { return !mapTwinExact(pin, ity) }
    // An instance keyed by its exact pins binds the receiver's type parameter to one type.
    const held = mapExactHeldTyOf(recvIx, fnIx)
    if held >= 0 { return !mapTwinExact(held, ity) }
    // No pin reaches this receiver, and the answer turns on which of the instance's maps it
    // holds, which its spelling cannot say (D2684).
    if mapNicheNeedsPin(fnIx, ity) {
      emitFailAt(
        "emitProgram: `is` cannot tell "
          + tyToEmitName(ity)
          + " from this instance's pinned map yet: test the parameter itself",
        recvIx,
      )
      return false
    }
    return mapNicheLacks(mapValueTyOf(recvIx, fnIx), ity)
  }
  const pTest = isTestValuePrimName(ity)
  if pTest == "" {
    // A record is never the member of a `string` or `boolean` niche, nor a literal union of a
    // reference or `boolean` one (D3344).
    // A call result's niche is its recorded rep.
    if readIsCallResult(recvIx, fnIx) {
      return (nodeRepIs(recvIx, "nulstr", fnIx)
        || nodeRepIs(recvIx, "nulbool", fnIx))
        && tyIsRecord(ity)
    }
    const pb = nulNicheBaseClass(recvIx, fnIx)
    if tyIsRecord(ity) { return pb == "string" || pb == "boolean" }
    if tyIsLitUnion(ity) { return pb == "#ref" || pb == "boolean" }
    // …nor a literal union of numbers the member of any of them (D3546).
    return pb != "" && numLitUnionBaseName(ity) != ""
  }
  const base = nulNicheBaseClass(recvIx, fnIx)
  if base == "" { return false }
  return base != pTest
}

// Whether variant `vi` has a discriminant field its tag alone does not settle.
export function variantNeedsDiscrim(vi: i32): boolean {
  if vi < 0 || vi >= uFieldCount.length { return false }
  let fp = 0
  while fp < uFieldCount[vi] {
    if variantDiscrimFieldNeeded(vi, fp) { return true }
    fp = fp + 1
  }
  return false
}

// The member of the union `recvIx` holds that a tested map `patTy` names up to the order of its
// value union's members or a nested Set's spelling, so the test reads that member's tag; `patTy`
// itself when the union has it exactly, has no such member, or `patTy` is not a map (D2733).
function isPatUnionArmTy(recvIx: i32, patTy: i32, fnIx: i32): i32 {
  if patTy < 0 || !unMemIsMap(patTy) { return patTy }
  if !exprUnion(recvIx, fnIx) { return patTy }
  const arms: i32[] = []
  unionTyMemberTys(unionBoxTyOfRead(recvIx, fnIx), arms)
  let same = -1
  let i = 0
  while i < arms.length {
    const a = arms[i]
    if a >= 0 && unMemIsMap(a) {
      if mapTwinSame(a, patTy) { return patTy }
      if same < 0 && tySameSet(a, patTy) { same = a }
      if same < 0 && tySameSpelled(a, patTy) { same = a }
    }
    i = i + 1
  }
  if same >= 0 { return same }
  return patTy
}

// A box test naming a map with a numeric literal-union value, or its base twin, where the box
// cannot say which it holds: the receiver's union has two members of that one member class, or
// the instance is pinned at the other (D2493). The map type that clashes, or -1.
export function mapSoftTwinClashOf(recvIx: i32, patTy: i32, fnIx: i32): i32 {
  if patTy < 0 { return -1 }
  const pat: i32[] = []
  flattenVariantsInto(patTy, pat)
  // Only a map member can clash; most patterns have none, and the scan below is not cheap.
  let anyMap = false
  for pm in pat {
    if unMemIsMap(pm) { anyMap = true }
  }
  if !anyMap { return -1 }
  const arms: i32[] = []
  if exprUnion(recvIx, fnIx) {
    unionTyMemberTys(unionBoxTyOfRead(recvIx, fnIx), arms)
  }
  const pins: i32[] = []
  instancePinnedMaps(fnIx, pins)
  let i = 0
  while i < pat.length {
    const pm = pat[i]
    if unMemIsMap(pm) {
      let inClass = 0
      let soft = false
      let j = 0
      while j < arms.length {
        if unMemIsMap(arms[j]) && mapTwinSame(arms[j], pm) {
          inClass = inClass + 1
          if !mapTwinExact(arms[j], pm) { soft = true }
        }
        j = j + 1
      }
      let q = 0
      while q < pins.length {
        if pins[q] >= 0 && mapSoftTwin(pins[q], pm) {
          soft = true
          inClass = 2
        }
        q = q + 1
      }
      if soft && inClass > 1 { return pm }
    }
    i = i + 1
  }
  return -1
}

// Whether literal test `nd` (a literal or literal set) can never hold at instance `fnIx`: the
// operand's type there, a type parameter's or a hole's pin, has no member the checker's
// `assignable` relates to a tested member in either direction (D15251).
function litIsPinNever(isIx: i32, nd: IsExpr, fnIx: i32): boolean {
  const t = isVarTyIxOf(isIx)
  if t < 0 || t >= T.tys.length || !tyIsLitUnionOrLit(t) { return false }
  const own = nodeTyIxOf(unwrapParen(nd.isObj))
  if own < 0 || (!tyHasTyVar(own) && !tyHasHole(own)) { return false }
  const pin = instanceReadTyOf(nd.isObj, fnIx)
  if pin < 0 || pin >= T.tys.length || tyHasTyVar(pin) || tyHasHole(pin) {
    return false
  }
  const pins: i32[] = []
  flattenVariantsInto(pin, pins)
  const tests: i32[] = []
  flattenVariantsInto(t, tests)
  if pins.length == 0 || tests.length == 0 { return false }
  for m in pins {
    for x in tests {
      if assignable(x, m) || assignable(m, x) { return false }
    }
  }
  return true
}

// Whether `emitIs` hands the box test `isIx` to `emitIsTest` over a plain read: its box receiver
// is not read at its storage, and the tested type does not hold every member.
export function isBoxGuardPlain(isIx: i32, fnIx: i32): boolean {
  const nd = nodeAt(isIx)
  return nd is IsExpr
    && exprUnion(nd.isObj, fnIx)
    && isPreArmOf(isIx, fnIx) == "test"
}

// Whether every member of union operand type `op` is a member of the tested type `t`, the
// meet the checker recorded for the test.
export function isTestedEveryMember(op: i32, t: i32): boolean {
  if op < 0 || t < 0 || op >= T.tys.length || t >= T.tys.length { return false }
  const ms: i32[] = []
  flattenVariantsInto(op, ms)
  const ts: i32[] = []
  flattenVariantsInto(t, ts)
  if ms.length < 2 { return false }
  for m in ms {
    if !i32ListHas(ts, m) { return false }
  }
  return true
}

// Whether `emitIs` tests operand `recvIx` at its storage: a read the checker narrowed, unless
// the storage itself holds the narrowed rep (a capture whose env field is not the union box).
export function isTestsStorage(recvIx: i32, fnIx: i32): boolean {
  if readNarrowedTyAt(recvIx, fnIx) < 0 { return false }
  const r = nodeAt(unwrapParen(recvIx))
  if r is Ident {
    if capturedKindOf(fnIx, r.identName) != null {
      return capturedIsUnionBox(fnIx, r.identName)
    }
  }
  return true
}

// The box tag of list type `ty` for `emitListIsAcrossReps`: `isArmTagOfTy`'s, or for a list of
// `i32` literals the `i32[]` tag it shares, which a tag test alone does not decide (D14041).
export function listIsArmTag(ty: i32): i32 {
  const t = isArmTagOfTy(ty)
  if t >= 0 { return t }
  const e = tyArrayElemIx(ty)
  if e < 0 || numLitUnionBaseName(e) != "i32" || boxTagOfTy(ty) != 7 {
    return -1
  }
  return scalarTagOfKind(7)
}

// Plans `recv is chk` for list type `chk` over a box: one entry per tag in `tags`, with how
// `fits` tests it and the reflist `slotsAt` its element loop walks. False when the operand is
// not a box of list arms, when some arm has no test, or when the tag alone answers.
export function listIsAcrossRepsPlan(
  recv: i32,
  chk: i32,
  fnIx: i32,
  tags: i32[],
  fits: i32[],
  slotsAt: i32[][],
): boolean {
  if !exprUnion(recv, fnIx) { return false }
  if tyArrayElemIx(chk) < 0 { return false }
  const arms: i32[] = []
  if (!unionTyMemberTys(unionBoxTyOfRead(recv, fnIx), arms)) { return false }
  const chkTag = listIsArmTag(chk)
  // A list of `i32` literals at any depth shares its rows with the `i32` lists, so a box can
  // hold either under its tag (D16894).
  const numLeaf = listArmNumsDepth(chk, chk) >= 0
  let other = false
  for a in arms {
    if tyArrayElemIx(a) >= 0 {
      const t = listIsArmTag(a)
      if t < 0 { return false }
      // A ref-element arm's list row is minted here, where the test is lowered: the branch the
      // test narrows reads that arm's elements through it.
      if unMemIsRefElemArray(a) { unMemRefArrArmSlot(a) }
      // A list of `i32` literals is read by its elements even as its own arm: the box it shares
      // with `i32[]` may hold either.
      let k = if !tySame(a, chk) { listArmFitAcrossReps(a, chk) } else if !numLeaf { LIST_ARM_OWN } else { 0 }
      const slots: i32[] = []
      // A wide numeric arm's element loop reads the arm's own list, so the plan keeps its type.
      if k == LIST_ARM_WIDE { slots.push(a) }
      // A record-list arm fits when each record does, by its fields (D16989).
      if k == 0 && recListArmFits(a, chk) {
        const rs = unMemRefArrArmSlot(a)
        if rs < 0 || rs >= rlWrapIdx.length { return false }
        k = LIST_ARM_RECS
        slots.push(rs)
        slots.push(a)
      }
      if k == 0 {
        // An arm with another tag holds a list whose element type is fixed apart from the
        // test's: it never fits, empty or not (the D16047 refinement). A list of `i32` literals
        // is the exception: an `i32` list arm as deep fits it by its elements (D4778).
        if t != chkTag && listArmNumsDepth(a, chk) < 0 { continue }
        k = listArmSharedTagFit(a, chk, slots)
        if k == 0 { return false }
      }
      if !tySame(a, chk) { other = true }
      let j = tags.length - 1
      while j >= 0 && tags[j] != t { j = j - 1 }
      if j < 0 {
        tags.push(t)
        fits.push(k)
        slotsAt.push(slots)
      } else if fits[j] != k {
        // Only `L` itself and an arm whose elements may fit `L` share a tag, and the element
        // test answers for both.
        const elemK = k == LIST_ARM_ATOMS
          || k == LIST_ARM_NULLS
          || k == LIST_ARM_NONNULL
          || k == LIST_ARM_NUMS
        const elemJ = (fits[j] == LIST_ARM_ATOMS
          || fits[j] == LIST_ARM_NULLS
          || fits[j] == LIST_ARM_NONNULL
          || fits[j] == LIST_ARM_NUMS)
        if elemK && fits[j] == LIST_ARM_OWN {
          fits[j] = k
          slotsAt[j] = slots
        } else if !(k == LIST_ARM_OWN && elemJ) {
          return false
        }
      }
    }
  }
  // `L` alone is tested by its tag in the later rungs, unless only this plan has its tag.
  return other || numLeaf || isArmTagOfTy(chk) < 0
}

// Whether record-list arm `a` holds records that may each fit record list `chk`'s by their
// fields, every `chk` record an `a` record: the shape `emitListRecArmFit` tests (D16989).
function recListArmFits(a: i32, chk: i32): boolean {
  const ae = tyArrayElemIx(a)
  const ce = tyArrayElemIx(chk)
  if ae < 0 || ce < 0 || tySame(ae, ce) { return false }
  if !(tyAt(ae) is TyObj) || !(tyAt(ce) is TyObj) { return false }
  const names: string[] = []
  const sets: i32[] = []
  return recFitNarrowedFields(ae, ce, names, sets) >= 0 && names.length > 0
}

// How `emitListIsAcrossReps` tests one tag: by the tag alone (`L`, or an arm every element of
// which fits), a `string[]` arm's strings, an atom arm's atoms, a
// `(boolean | null)[]` arm tested as `null[]` (every element the null sentinel 2), or a
// `(string | null)[]` arm tested as `string[]` (no element null).
export const LIST_ARM_OWN = 1

export const LIST_ARM_WIDE = 3

const LIST_ARM_ATOMS = 4

export const LIST_ARM_NULLS = 5

export const LIST_ARM_NONNULL = 6

export const LIST_ARM_NUMS = 7

export const LIST_ARM_RECS = 8

// How `emitListIsAcrossReps` tests list arm `a` against `chk` when the two share one tag and
// rep: by `a`'s atoms (filling `slots`), by null elements, by no null element, or 0 when no
// element test tells them apart.
function listArmSharedTagFit(a: i32, chk: i32, slots: i32[]): i32 {
  if tyIsLitUnion(listLeafTyOf(chk)) {
    const d = atomLeafListDepthOfTy(chk)
    if d >= 0 && atomLeafListDepthOfTy(a) == d && atomArmSlots(a, d, slots) {
      return LIST_ARM_ATOMS
    }
  }
  if isNullTy(tyArrayElemIx(chk)) && !isNullTy(tyArrayElemIx(a)) {
    return LIST_ARM_NULLS
  }
  const nd = listArmNumsDepth(a, chk)
  if nd >= 0 && atomArmSlots(a, nd, slots) { return LIST_ARM_NUMS }
  if listArmIsNullableStrs(a, chk) { return LIST_ARM_NONNULL }
  return 0
}

// The list layers below the outermost when list arm `a` is `i32[]…[]` or a list of `i32` literals
// and `chk` a list of `i32` literals as deep, which a value of `a` fits exactly when every leaf is a member (D4778); -1
// otherwise.
function listArmNumsDepth(a: i32, chk: i32): i32 {
  let ae = tyArrayElemIx(a)
  let ce = tyArrayElemIx(chk)
  let d = 0
  while ae >= 0 && ce >= 0 && tyArrayElemIx(ae) >= 0 && tyArrayElemIx(ce) >= 0 {
    ae = tyArrayElemIx(ae)
    ce = tyArrayElemIx(ce)
    d = d + 1
  }
  if ae < 0 || ce < 0 { return -1 }
  if tyPrimNameOf(ae) != "i32" && numLitUnionBaseName(ae) != "i32" { return -1 }
  if tyArrayElemIx(ae) >= 0 || tyArrayElemIx(ce) >= 0 { return -1 }
  return if numLitUnionBaseName(ce) == "i32" { d } else { -1 }
}

// Whether list arm `a` is `(string | null)[]` and `chk` is `string[]`, so the two share the
// string list's tag and an `a` value fits `chk` exactly when no element is null.
function listArmIsNullableStrs(a: i32, chk: i32): boolean {
  const ae = tyArrayElemIx(a)
  const ce = tyArrayElemIx(chk)
  if ae < 0 || ce < 0 || tyPrimNameOf(ce) != "string" { return false }
  const an = nonNullTy(ae)
  return an != ae && tyPrimNameOf(an) == "string"
}

// The innermost element type of list type `ty`, below every list layer.
export function listLeafTyOf(ty: i32): i32 {
  let cur = ty
  let guard = 0
  while tyArrayElemIx(cur) >= 0 && guard < 64 {
    cur = tyArrayElemIx(cur)
    guard = guard + 1
  }
  return cur
}

// Pushes onto `slots` the reflist slot of each of the `depth` outer layers of the atom-leaf list
// arm `a`, outermost first, as `emitListFitLoop` walks them; false when a layer is not the
// reflist its type names.
function atomArmSlots(a: i32, depth: i32, slots: i32[]): boolean {
  if depth == 0 { return true }
  let s = unMemRefArrArmSlot(a)
  let k = 0
  while k < depth {
    if s < 0 || s >= rlElemTyIx.length || s >= rlWrapIdx.length { return false }
    slots.push(s)
    const ek = rlElemKindAt(s)
    if k < depth - 1 {
      if ek != RLK_REF_LIST { return false }
      s = rlElemInnerSlot(s)
    } else if ek != RLK_I32_LIST {
      return false
    }
    k = k + 1
  }
  return true
}

// The literal and niche arms `emitIsTestLitArms` writes, in order; `none` where none answers.
export type LitIsArm = "mapNull"
  | "mapHas"
  | "nicheNever"
  | "nicheTest"
  | "nicheRaw"
  | "atomNotNul"
  | "atomTrue"
  | "atomEq"
  | "boxLits"
  | "numBox"
  | "memberTrue"
  | "memberNoRecv"
  | "memberEq"
  | "none"

// The literal arm of `is` test `isIx`: a scalar map read's presence, a ref niche's null test, an
// atom's membership, a box's literal arms, or literal membership over a plain receiver.
export function litIsArmOf(isIx: i32, nd: IsExpr, fnIx: i32): LitIsArm {
  const t = isVarTyIxOf(isIx)
  const imk = mapReadScalarBoxKind(nd.isObj, fnIx)
  const rd = nodeAt(unwrapParen(nd.isObj))
  // `m[k] is T` over a bare scalar-valued map read (D2466): `is null` is a miss, and `is` the
  // value's own scalar a hit.
  if imk >= 0 && rd is Index {
    const tn = tyPrimNameOf(t)
    if tn != null && tn == "null" { return "mapNull" }
    if tn != null && tn == scalarAtomNameOfKind(imk) { return "mapHas" }
  }
  if exprNullableRefNiche(nd.isObj, fnIx) {
    if nulNicheIsTestImpossible(nd.isObj, t, fnIx) { return "nicheNever" }
    if nulTestArmOf(nd.isObj, fnIx, !isTestsNull(isIx), true) != "none" {
      return "nicheTest"
    }
    // The storage is the ref niche even where the checked type holds no `null`.
    return "nicheRaw"
  }
  const atom = exprIsLitAtom(nd.isObj, fnIx)
  const texts = tyLitMemberTexts(t)
  const reread = unionEqOperandOk(nd.isObj)
  if atom {
    // Every member of a literal union is a string, so `is string` holds of the atom outright,
    // and of the `K | null` niche exactly when it is not the `-1` null (D2154).
    if tyPrimNameOf(t) == "string" {
      return if exprNulLitUnion(nd.isObj, fnIx) { "atomNotNul" } else { "atomTrue" }
    }
    if texts.length > 0 && nodeLitMembersWithin(nd.isObj, texts) {
      return "atomTrue"
    }
    if texts.length > 0 && (texts.length == 1 || reread) { return "atomEq" }
  }
  // Every arm below tests literal members, numeric or not.
  if texts.length == 0 && !numLitUnionHasBase(t) { return "none" }
  const lur: i32[] = []
  const luNm = unionNameRowOfExpr(nd.isObj, fnIx, lur)
  const carries = luNm != ""
    && unionCarriesLitUnionArmOfSet(msSetOfRow(lur[0]), lur[1])
  if carries && texts.length > 0 && reread { return "boxLits" }
  if (
    numLitUnionHasBase(t)
    && tyNumLitMemberTexts(t).length > 0
    && exprUnion(nd.isObj, fnIx)
    && reread
    && luNm != ""
    && (isValueUnionOfSet(msSetOfRow(lur[0]), lur[1]) || carries)
  ) {
    return "numBox"
  }
  if !atom && texts.length > 0 && litMembershipRecvOk(nd.isObj, fnIx) {
    if nodeTyIsLitUnion(nd.isObj) && nodeLitMembersWithin(nd.isObj, texts) {
      return "memberTrue"
    }
    return if texts.length == 1 || reread { "memberEq" } else { "memberNoRecv" }
  }
  return "none"
}

// The box-tag arms `emitIsTestArmTag` writes, in order; `none` where none answers.
export type TagIsArm = "boxLitSet"
  | "softTwin"
  | "lacks"
  | "strTag"
  | "tagAbsent"
  | "identBox"
  | "memNarrow"
  | "memStruct"
  | "memVariant"
  | "optField"
  | "box"
  | "none"

// The box-tag arm of `is` test `isIx`: a literal set over a box's string payload, a map the
// box cannot hold, or the arm's tag read off the box wherever the receiver keeps it.
export function tagIsArmOf(isIx: i32, nd: IsExpr, fnIx: i32): TagIsArm {
  const t = isVarTyIxOf(isIx)
  const box = exprUnion(nd.isObj, fnIx)
  // A literal union tested against a box whose string arm is a plain `string` is membership
  // over the payload: the tag alone answers true for a non-member string (D3348).
  if (
    tyLitMemberTexts(t).length > 0
    && tyIsLitUnion(t)
    && box
    && unionEqOperandOk(nd.isObj)
    && msSetCarriesLitUnionArm(msSetOfUnionBox(nd.isObj, fnIx)) != 1
    && msSetTakesAtomAsStr(msSetOfUnionBox(nd.isObj, fnIx))
    && !readIsCallResult(nd.isObj, fnIx)
  ) {
    return "boxLitSet"
  }
  const patTy = isArmPatTy(isIx, nd, fnIx)
  if mapSoftTwinClashOf(nd.isObj, patTy, fnIx) >= 0 { return "softTwin" }
  const armTag = isArmTagOfTyAt(patTy, nd.isObj, fnIx)
  // An exact instance's union may hold the pattern's twin under one tag (a Set and its boolean
  // map), so a member set without the pattern itself answers false. A map type no arm of the
  // box registered is a member of no value it can hold.
  if (
    unMemIsMap(patTy) && box && exactUnionLacksMap(nd.isObj, t, fnIx)
    || box && exactUnionLacksTwin(nd.isObj, t, fnIx)
    || armTag < 0 && unMemIsMap(patTy) && box
  ) {
    return "lacks"
  }
  // A literal union tested by its string tag would answer true for every string the box holds.
  if armTag == 2 && tyIsLitUnion(t) { return "strTag" }
  if armTag >= 0 {
    const r = unwrapParen(nd.isObj)
    const vrecv = nodeAt(unwrapParen(nd.isObj))
    if vrecv is Ident {
      if unionBoxLacksTag(nd.isObj, armTag, fnIx) { return "tagAbsent" }
      if unionNameOfRead(r, fnIx) != "" && identSlotIsUnionBox(fnIx, r) {
        return "identBox"
      }
    }
    if vrecv is Member && memberUnionFieldNameRead(r, fnIx) != "" {
      if memReadArmOf(r, fnIx) == "narrowed" { return "memNarrow" }
      const msi = structIndexOfExpr(vrecv.memObj, fnIx)
      if msi >= 0 && sFieldIndex(msi, vrecv.memProp) >= 0 { return "memStruct" }
      const vi = exprVariantIndex(vrecv.memObj, fnIx)
      if vi >= 0 && variantFieldIndex(vi, vrecv.memProp) >= 0 {
        return "memVariant"
      }
    }
    if vrecv is OptMember {
      const si = optChainStructIdxOf(vrecv.omObj, fnIx)
      if si >= 0 {
        const fi = sFieldIndex(si, vrecv.omProp)
        if fi >= 0 && sFieldIsUnionBox(si, fi) { return "optField" }
      }
    }
    return tagIsValueArm(nd, fnIx)
  }
  return "none"
}

// Any other receiver: the arm's tag read off a box value, or no tag arm.
function tagIsValueArm(nd: IsExpr, fnIx: i32): TagIsArm {
  return if exprUnion(nd.isObj, fnIx) { "box" } else { "none" }
}

// How `emitIsTestNumLit` compares a numeric receiver with a numeric literal pattern: `nlBase` the
// width, `nlTexts` the members, `nlOnce` a receiver read once into a slot of that width; an
// empty base where it does not.
export type NumIsPlan = { nlBase: string, nlTexts: string[], nlOnce: boolean }

export function numIsPlanOf(isIx: i32, nd0: IsExpr, fnIx: i32): NumIsPlan {
  const no: NumIsPlan = { nlBase: "", nlTexts: [], nlOnce: false }
  if exprUnion(nd0.isObj, fnIx) { return no }
  let nlBase = numLitUnionBaseName(isVarTyIxOf(isIx))
  let nlTexts = tyNumLitMemberTexts(isVarTyIxOf(isIx))
  // An `i64` receiver compares at `i64`, which holds every member of an `i32` union and
  // of an integer union over both widths (D3658).
  if isNumRecvBaseName(nd0.isObj, fnIx) == "i64" {
    if nlBase == "" {
      nlTexts = tyIntLitWideTexts(isVarTyIxOf(isIx))
      if nlTexts.length > 0 { nlBase = "i64" }
    }
    if nlBase == "i32" { nlBase = "i64" }
  }
  // A float receiver compares each integer member by value, converted to its width (D3689).
  const fb = isNumRecvBaseName(nd0.isObj, fnIx)
  if fb == "f64" || fb == "f32" {
    if nlBase == "" { nlTexts = tyIntLitWideTexts(isVarTyIxOf(isIx)) }
    if (
      nlBase == "" && nlTexts.length > 0
      || nlBase == "i32"
      || nlBase == "i64"
    ) {
      nlBase = fb
    }
  }
  if (
    nlBase == ""
    || isNumRecvBaseName(nd0.isObj, fnIx) != nlBase
    || nlTexts.length == 0
  ) {
    return no
  }
  if nlTexts.length == 1 || unionEqOperandOk(nd0.isObj) {
    const eq: NumIsPlan = { nlBase: nlBase, nlTexts: nlTexts, nlOnce: false }
    return eq
  }
  // A receiver that cannot be re-read is read once into a slot of its base; the name fold below
  // answers by spelling and would say false for a member (D3570, D3590).
  if !numLitOnceReadOk(nlBase, nlTexts) { return no }
  const once: NumIsPlan = { nlBase: nlBase, nlTexts: nlTexts, nlOnce: true }
  return once
}

// The variant row `is` test `isIx` answers by a box's tag alone, or -1: a tested row no other
// member shares, a box receiver no static fold knows, no cross-tag fit and no discriminant.
export function isVariantTagPlain(isIx: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) || !exprUnion(nd.isObj, fnIx) { return -1 }
  const t = isVarTyIxOf(isIx)
  const vi = isTestedRowOf(t, nd.isObj)
  if vi < 0 || vi >= uTags.length || armRowSharedAtRecv(nd.isObj, vi) {
    return -1
  }
  if exprVariantIndex(nd.isObj, fnIx) >= 0 || variantNeedsDiscrim(vi) {
    return -1
  }
  return if isFitsAcrossTagRows(vi, t, nd.isObj, fnIx) { -1 } else { vi }
}

// 1 or 0 when the re-readable operand of `is` at `isIx` holds only `null` at instance `fnIx`,
// so the test is whether the tested type admits `null`; -1 otherwise. The name cascade would
// read such an operand as the `i32` it shares a pin with (D8182).
export function nullInstanceIsResult(isIx: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return -1 }
  if !isNullTy(instanceReadTyOf(nd.isObj, fnIx)) { return -1 }
  if !exprReReadable(unwrapParen(nd.isObj)) { return -1 }
  const nlt = isVarTyIxOf(isIx)
  if nlt < 0 || nlt >= T.tys.length || tyAt(nlt) is TyVar { return -1 }
  return if tyAdmitsNull(nlt) { 1 } else { 0 }
}

// The rep a membership test's receiver is staged at (D12060), or -1 to read it in place: a
// literal-union test re-reads its receiver once per member, so one that is not a re-readable
// place is evaluated first into a local. 0 a union box, 1 an atom id, 2 a nullable string,
// 3 a string.
export function isRecvStageRep(isIx: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) || unionEqOperandOk(nd.isObj) { return -1 }
  const ity = isVarTyIxOf(isIx)
  // A box tested against integers by value reads it twice (D3689).
  if (
    exprUnion(nd.isObj, fnIx)
    && emFloatIntLitTest(nodeTyAt(unwrapParen(nd.isObj), fnIx), ity)
  ) {
    return 0
  }
  if tyLitMemberTexts(ity).length < 2 && tyNumLitMemberTexts(ity).length < 2 {
    return -1
  }
  if exprUnion(nd.isObj, fnIx) { return 0 }
  if exprIsLitAtom(nd.isObj, fnIx) { return 1 }
  if exprNullableString(nd.isObj, fnIx) { return 2 }
  if exprString(nd.isObj, fnIx) { return 3 }
  return -1
}

// The rungs of `emitIsTest`, in their load-bearing order (`isArmOf`). A rung that may answer
// writes the test; one that declines, which only the try rungs do, passes to the next.
export type IsArm = "optNull"
  | "nullInst"
  | "never"
  | "floatLits"
  | "recordFit"
  | "listFit"
  | "listAcross"
  | "pinNever"
  | "litArms"
  | "emptyFit"
  | "armTag"
  | "numLit"
  | "litMember"
  | "nulTest"
  | "noMembership"
  | "static"
  | "nulClosure"
  | "noUnion"
  | "variant"
  | "notIs"

// The first rung at rank `from` or later that may answer `is` test `isIx` in `fnIx`. A try rung
// (`recordFit` to `numLit`) may still decline when written; every other rung answers. `staged`:
// the receiver is read from the stash `emitIsTest` staged it in.
export function isArmOf(
  isIx: i32,
  fnIx: i32,
  from: i32,
  staged: boolean,
): IsArm {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) {
    return if !uDeclared && isIx >= 0 { "noUnion" } else { "notIs" }
  }
  const t = isVarTyIxOf(isIx)
  const nul = isTestsNull(isIx)
  const box = exprUnion(nd.isObj, fnIx)
  const obj = nodeAt(unwrapParen(nd.isObj))
  if from <= 0 && nul && obj is OptMember { return "optNull" }
  if from <= 1 && nullInstanceIsResult(isIx, fnIx) >= 0 { return "nullInst" }
  if (
    from <= 2
    && (t == TY_NEVER || elabIsTyIn(isIx, elabKeyAt(fnIx)) == TY_NEVER)
  ) {
    return "never"
  }
  if (
    from <= 3
    && box
    && emFloatIntLitTest(nodeTyAt(unwrapParen(nd.isObj), fnIx), t)
    && (unionEqOperandOk(nd.isObj) || staged)
  ) {
    return "floatLits"
  }
  if from <= 4 && !nul && !box && recordFitIsShape(isIx, nd, fnIx) >= 0 {
    return "recordFit"
  }
  if from <= 5 && !nul && !box && listFitIsLeaf(isIx, nd, fnIx) {
    return "listFit"
  }
  if from <= 6 && !nul && listAcrossIsPlanned(isIx, nd, fnIx) {
    return "listAcross"
  }
  if from <= 7 && litIsPinNever(isIx, nd, fnIx) { return "pinNever" }
  if from <= 8 && litIsArmOf(isIx, nd, fnIx) != "none" { return "litArms" }
  // A list `K[]` can never meet is a fit exactly when empty, which neither a box's tag nor a
  // non-null test can say (D4912).
  if from <= 9 && t >= 0 && tyAt(t) is TyArray { return "emptyFit" }
  if from <= 10 && tagIsArmOf(isIx, nd, fnIx) != "none" { return "armTag" }
  if from <= 11 && numIsPlanOf(isIx, nd, fnIx).nlBase != "" { return "numLit" }
  if from <= 12 && isTestedLitLex(t) != "" { return "litMember" }
  if from <= 13 && isNulTestAnswers(isIx, nd, fnIx) { return "nulTest" }
  if from <= 14 && isNoMembershipRecv(isIx, nd, fnIx) { return "noMembership" }
  if from <= 15 && monoStaticIsResult(isIx, fnIx) >= 0 { return "static" }
  if from <= 16 && tyDenotesFunc(t) && exprNulClosure(nd.isObj, fnIx) {
    return "nulClosure"
  }
  if !uDeclared { return "noUnion" }
  return "variant"
}

// The shape `emitRecordFitIs` tests a record receiver's narrowed fields by, or -1.
function recordFitIsShape(isIx: i32, nd: IsExpr, fnIx: i32): i32 {
  const names: string[] = []
  const sets: i32[] = []
  return recFitNarrowedFields(
    nodeTyAt(nd.isObj, fnIx),
    isVarTyIxOf(isIx),
    names,
    sets,
  )
}

// Whether `emitListFitIs` tests a list receiver's elements against a literal set.
function listFitIsLeaf(isIx: i32, nd: IsExpr, fnIx: i32): boolean {
  const instTy = listIsRecvTyOf(nd.isObj, fnIx)
  const recvTy = if nodeTyIsNullable(nd.isObj) { nonNullTy(instTy) } else { instTy }
  const layers: i32[] = []
  if listFitLitLeafOf(isVarTyIxOf(isIx), recvTy, layers) < 0 { return false }
  const rep = exprListRep(nd.isObj, fnIx)
  return recvTy >= 0
    || rep == "list"
    || rep == "i64list"
    || rep == "strlist"
    || rep == "reflist"
}

// Whether `emitListIsAcrossReps` asks which list arm a list-union rewrite stored.
function listAcrossIsPlanned(isIx: i32, nd: IsExpr, fnIx: i32): boolean {
  // A list-union rewrite's test over closed arms asks which arm is stored: the tag alone, unless
  // the arm has no tag of its own, as a numeric literal-union list sharing `i32[]`'s (D4770).
  const luT = luIsTyOf(isIx)
  if luT >= 0 && !tyHasTyVar(luT) && isArmTagOfTy(luT) >= 0 { return false }
  const tags: i32[] = []
  const fits: i32[] = []
  const slotsAt: i32[][] = []
  return listIsAcrossRepsPlan(
    nd.isObj,
    isVarTyIxOf(isIx),
    fnIx,
    tags,
    fits,
    slotsAt,
  )
}

// The arm type `emitIsTestArmTag` tests the tag of: a numeric literal union's base where the
// pattern is that primitive (D3522).
export function isArmPatTy(isIx: i32, nd: IsExpr, fnIx: i32): i32 {
  const patTy = isPatUnionArmTy(nd.isObj, isVarTyIxOf(isIx), fnIx)
  if tyIsPrimIx(patTy) { return patTy }
  const plb = numLitUnionBaseTy(patTy)
  const pat = isPatTyIxOf(isIx)
  if (
    plb >= 0
    && tyIsPrimIx(pat)
    && tyEmitPrimOf(plb) != null
    && tyEmitPrimOf(pat) == tyEmitPrimOf(plb)
  ) {
    return plb
  }
  return patTy
}

// Whether the niche null test answers: a receiver that is no box, atom niche or literal union,
// tested where its niche can say.
function isNulTestAnswers(isIx: i32, nd: IsExpr, fnIx: i32): boolean {
  const nul = isTestsNull(isIx)
  if !nul {
    if exprNulLitUnion(nd.isObj, fnIx) || tyIsLitUnion(isVarTyIxOf(isIx)) {
      return false
    }
    // A box holds every member under its own tag, so being non-null is not being the arm:
    // the variant rungs test the tag (D2267).
    if exprUnion(nd.isObj, fnIx) { return false }
  }
  return nulNicheIsTestImpossible(nd.isObj, isVarTyIxOf(isIx), fnIx)
    || nulTestArmOf(nd.isObj, fnIx, !nul, true) != "none"
}

// A literal-union test over a receiver typed at a union of type parameters the checker did not
// keep apart, which cannot be re-read: no rep this fold can trust (D3528).
function isNoMembershipRecv(isIx: i32, nd: IsExpr, fnIx: i32): boolean {
  const msObj = nodeTyAt(unwrapParen(nd.isObj), fnIx)
  return tyIsLitUnion(isVarTyIxOf(isIx))
    && !unionEqOperandOk(nd.isObj)
    && msObj >= 0
    && tyHasTyVar(msObj)
    && tyIsUnionShaped(msObj)
    && !tyIsTpJoinUnion(msObj)
}

// Which arm of `emitMem` reads member `memIx`: `narrowed`, a box receiver narrowed to one
// variant (`emitNarrowedMem`); `variant` or `nulVariant`, a bare or nullable variant receiver;
// `shared`, the shared-field dispatch and the struct read under it, and any non-member node.
export type MemReadArm = "narrowed" | "variant" | "nulVariant" | "shared"

// The arm `emitMem` and the IR's member reads take for `memIx`, in `emitMem`'s order.
export function memReadArmOf(memIx: i32, fnIx: i32): MemReadArm {
  const m = nodeAt(memIx)
  if !(m is Member) { return "shared" }
  if memNarrowVariantIndex(memIx, fnIx) >= 0 && exprUnion(m.memObj, fnIx) {
    return "narrowed"
  }
  if exprVariantIndex(m.memObj, fnIx) >= 0 { return "variant" }
  return if nulVariantIdxOfExpr(m.memObj, fnIx) >= 0 { "nulVariant" } else { "shared" }
}

// The variant field `emitExpr` reads off a narrowed box local in `emitNarrowedMem`'s plain form,
// or -1: no null-unit or niche read, no `length`, a box receiver read raw, and no union-box field
// to unbox.
export function narrowedFieldPlain(memIx: i32, fnIx: i32): i32 {
  const m = nodeAt(memIx)
  if !memberReadPlain(memIx, fnIx) || !(m is Member) { return -1 }
  if !(nodeAt(m.memObj) is Ident) || memReadArmOf(memIx, fnIx) != "narrowed" {
    return -1
  }
  const vi = memNarrowVariantIndex(memIx, fnIx)
  if vi < 0 || vi >= uFieldStart.length { return -1 }
  const idx = variantFieldIndex(vi, m.memProp)
  if idx < 0 || fieldRowIsUnionBox(uFieldStart[vi] + idx) { return -1 }
  return idx
}

// Keyed on the atom's kind, not on its rendered spelling: kind 7 is exactly the i32-list
// backings (`i32[]`, `boolean[]`, a litunion `K[]`, the `(boolean | null)[]` and `(K | null)[]`
// niches), kind 9 exactly the string-list backings, and kinds 8 / 10 / 12 arise only from the
// spellings `f64[]` / `i64[]` / `f32[]`. The caller already needs the kind for its tag.
export function listWrapHeapOfKind(k: i32) {
  if k == 7 { return lTy() }
  // A boolean list rides the i32 list; its tag code exists only once a union registered it.
  if k == 17 || k == 18 {
    if vbBoolListTop < 0 { return -1 }
    return lTy()
  }
  if k == 8 { return fl64Ty() }
  if k == 9 { return mkListTy() }
  if k == 10 { return il64Ty() }
  if k == 12 { return fl32Ty() }
  if k == V128_LIST_KIND { return fl128Ty() }
  // The packed byte list rides the box's anyref as its own `{backing, len, cap}` wrapper like
  // the five above; only its backing's element is the packed `i8` storage type.
  // `vbU8ArmUsed` is the guard: `uAtomBandTop` lifts the slot bands off it, so a kind-13 tag
  // without it collides with `refArrSlotTag(0)`.
  if k == 13 {
    if !vbU8ArmUsed { return -1 }
    return bl8Ty()
  }
  // A wider or signed packed list rides its own row's wrapper; its code exists only once a
  // union arm registered the row.
  const pr = pkRowOfKind(k)
  if pr > PK_U8 {
    if pkTwinCodeOfRow(pr) < 0 { return -1 }
    return pkWrapAt(pr)
  }
  return -1
}

// Whether `x is chk` answers right for a value of arm `other` boxed under `chk`'s tag: every
// such value fits `chk`, or the list test reads the elements (`emitListIsAcrossReps`).
function armTagTestHolds(chk: i32, other: i32): boolean {
  if tyFitKind(other, chk) == 1 { return true }
  if tyArrayElemIx(chk) < 0 || tyArrayElemIx(other) < 0 { return false }
  if listArmFitAcrossReps(other, chk) != 0 || recListArmFits(other, chk) {
    return true
  }
  return listArmSharedTagFit(other, chk, []) != 0
}

// The refusal for a box into the union typed `unionTy` (a union, else the row its key reaches)
// where two members claim one box tag (`isArmTagOfTy`) and an `is` over one would answer wrong
// for the other; "" when none do. Record and literal members are tagged elsewhere.
export function unionArmTagClash(unionTy: i32): string {
  const mems: i32[] = []
  if unionTy >= 0 && tyAt(unionTy) is TyUnion {
    flattenVariantsInto(unionTy, mems)
  } else if !unionMemberTysOfRow(unRowOfTyKey(unionTy), mems) {
    return ""
  }
  const tags: i32[] = []
  for m in mems { tags.push(isArmTagOfTy(m)) }
  let i = 0
  while i < mems.length {
    let j = i + 1
    while j < mems.length {
      if (
        tags[i] >= 0
        && tags[i] == tags[j]
        && (!armTagTestHolds(mems[i], mems[j])
          || !armTagTestHolds(mems[j], mems[i]))
      ) {
        return "emitProgram: union members `"
          + tyToStr(mems[i])
          + "` and `"
          + tyToStr(mems[j])
          + "` share one box tag, so `is` could not tell them apart"
      }
      j = j + 1
    }
    i = i + 1
  }
  return ""
}

// The set id of coerce target `unionName`: `uSet` when the caller resolved it, else by name.
function coerceSetOf(uSet: i32, uTy: i32): i32 {
  if uSet >= 0 { return uSet }
  return msSetOfTyAny(uTy)
}

// Whether coerce target `unionName`, of set id `uSet` (-1 when unresolved) and arena type `uTy`,
// admits `null`.
export function coerceSetHasNull(
  uSet: i32,
  unionName: string,
  uTy: i32,
): boolean {
  if uSet >= 0 { return msHasNull(uSet) }
  return unionSetHasNullTy(unionName, uTy)
}

// Whether a coerce target of set id `uSet`, else of arena type `uTy`, boxes a literal-union atom
// as its member string. False when the caller holds neither.
export function coerceTakesAtomAsStr(uSet: i32, uTy: i32): boolean {
  if uSet >= 0 { return msSetTakesAtomAsStr(uSet) }
  return tyBoxTakesAtomAsStr(uTy)
}

// Why a `K | null` atom `exprIx` does not box into set `uSet` (type `uTy`) as its member string,
// or "": the union holds `null` and no plain `string` arm, and every spelling of the read holds
// the atom (a binding, a parameter, a capture, a niche field or map read, a niche call).
export function atomNulStrWhy(
  unionName: string,
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  fnIx: i32,
): string {
  // Beside a plain `string` arm the join is `string | null`, not this box.
  const nlStrArm = msHasPlainValKind(msSetOfTyAny(uTy), 2)
  // A binding typed `K | null` holds the atom at every spelling; a parameter does too, unless
  // its function's declared return reads the box at the declaration's rep.
  const nlArg = nodeAt(unwrapParen(exprIx))
  let nlParam = false
  if (nlArg is Ident && (fnIx < 0 || paramPosOfRead(fnIx, exprIx) < 0)) {
    nlParam = true
  }
  if nlArg is Ident && fnIx >= 0 {
    const nlFn = nodeAt(fnIx)
    // A pinned instance's parameter holds the atom too: the instance reads it at its own rep.
    if nlFn is FuncDecl && (nlFn.fnRet < 0 || fnInPinnedInstance(fnIx)) {
      if paramPosOfRead(fnIx, exprIx) >= 0 { nlParam = true }
    }
    // A `K | null` niche parameter holds the atom id whatever the function's return (D4041).
    if (paramPosOfRead(fnIx, exprIx) >= 0 && exprNulLitUnion(exprIx, fnIx)) {
      nlParam = true
    }
    // A capture whose env field holds the atom is the atom, as a parameter is (D3358).
    if capturedKindOf(fnIx, nlArg.identName) == "i32" { nlParam = true }
  }
  // A declared `K | null` field or an atom-valued map read is the niche, outside an instance
  // or where the instance's own type for the read is that niche.
  if (
    (nlArg is Member || nlArg is Index)
    && ((!fnInPinnedInstance(fnIx) && !nodeTyHasTyVar(unwrapParen(exprIx)))
      || tyIsNulLitUnionNiche(holeOperandTyOf(exprIx, fnIx)))
    && exprNulLitUnion(exprIx, fnIx)
  ) {
    nlParam = true
  }
  if nlArg is Index && fnInPinnedInstance(fnIx) {
    if tyIsLitUnion(tyMapValOf(mapRecvTyIn(nlArg.idxArr, fnIx))) {
      nlParam = true
    }
  }
  // A call whose callee hands its result back as the niche holds the atom (D12466).
  if nlArg is Call && exprNulLitUnion(exprIx, fnIx) { nlParam = true }
  if !coerceSetHasNull(uSet, unionName, uTy) || nlStrArm || !nlParam {
    return "emitProgram: literal-union string widening with no members"
  }
  return ""
}

// The value-atom code `exprIx` boxes at entering `unionName`, before any list widening.
export function coerceValueAtomKind(
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
): i32 {
  // Classify the value's atom. Order mirrors the print-import ladder (f32 before f64 — a float
  // literal classifies f64 too; string, bool and i64 are disjoint). The default is i32 unless
  // the union has no `i32` member but does have `i64`, or the literal exceeds the i32 range.

  // The ladder settles the value-atom code, not a spelling: the box tag, the rides-the-anyref
  // test, the scalar value box, the six `atom == …` compares picking the widened emit and the
  // two list re-encodes are all projections of that one code. Faithful because the map is
  // `valueAtomKind`'s own first-match ladder over exactly these eleven lexemes.
  let cak = 0 // "i32"
  // D209 — the third end of the same channel. When the read site delivers the atom rather than
  // the box (`memReadUnboxAtomKind`, the predicate `exprUnion` also asks), the value's atom is
  // that predicate's answer and not this ladder's: every arm below reads the read as a code-16
  // box and declines, so a `string | i32` field read boxes a string ref as an i32.

  // And the atom is taken only where this destination stores it as itself. Where the read's own
  // field widened the payload on the way in, taking the delivered atom raw tags the box `i32`
  // over a slot whose only numeric arm is `i64` — valid wasm, `is i64` silently false.
  // `unionStoreAtomKind` makes the two sides of the round trip inverses.
  const d209k = memReadUnboxAtomKind(bareIx, fnIx)
  if d209k >= 0 && unionStoreAtomKindOfSet(uSet, uTy, d209k) == d209k {
    cak = d209k
  } else if exprString(exprIx, fnIx) {
    cak = 2 // "string"
  } else if exprStringArray(bareIx, fnIx) {
    // A list is classified by the literal under any parens, which is the node that adopts the
    // destination's element (a paren keeps the literal's own type).
    cak = 9 // "string[]" — a list member rides as a wrapper ref (like a string)
  } else if exprF32Array(bareIx, fnIx) {
    // Checked BEFORE the f64 arm: an f32-typed list value (an `f32[]` local/param/
    // narrowed read) must not be mis-claimed as `f64[]`. A bare float LITERAL still
    // classifies f64 (`exprF32Array` never claims it) — the `f64[]` → `f32[]`
    // re-encode below retargets it when only the f32 arm exists.
    cak = 12 // "f32[]"
  } else if exprListRep(bareIx, fnIx) == "v128list" {
    cak = V128_LIST_KIND
  } else if exprF64Array(bareIx, fnIx) {
    cak = 8 // "f64[]"
  } else if exprI64Array(bareIx, fnIx) {
    cak = 10 // "i64[]"
  } else if exprU8Array(bareIx, fnIx) {
    // Before the i32-list arm: a packed element reads as an i32, so that arm would claim it and
    // tag the box `i32[]` over a packed backing. Every packed width classifies here, and its row
    // picks `u8[]`'s code or its own twin's.
    cak = pkKindOfRow(exprPackedRow(bareIx, fnIx))
  } else if exprArray(bareIx, fnIx) {
    cak = 7 // "i32[]"
    // "boolean[]" (17) or "(boolean | null)[]" (18), read at this instance's pin
    const bcode = exprBoolListCode(bareIx, fnIx)
    if bcode == 17 || bcode == 18 { cak = bcode }
    // A literal the union holds as another list on the same storage (`[false]` into a
    // `(boolean | null)[]` arm) takes that arm's code.
    if cak == 17 && !unionHasAtomKindArm(coerceSetOf(uSet, uTy), 17) {
      if unionHasAtomKindArm(coerceSetOf(uSet, uTy), 18) { cak = 18 }
    }
  } else if exprIsV128(exprIx, fnIx) {
    cak = 14 // "v128"
  } else if exprIsF32(exprIx, fnIx) {
    // D978 — ask the union which arm stores an f32, do not assume the f32 one. A union with
    // only an `f64` arm stores it there, losslessly, and assuming kind 5 asks for an f32 box
    // the module never minted.
    cak = 5 // "f32"
    // Only when the union genuinely offers an `f64` ARM and no `f32` one. Asking
    // `unionStoreAtomKind` in general moved a case it should not have
    // (`d901_fold_f32_dest`, a `{q: f32} | null` whose f32 is a FIELD and not an arm), so
    // the test is spelled out here instead of widening that shared mapper.
    const f32Set = coerceSetOf(uSet, uTy)
    if !unionHasAtomK(f32Set, "f32", 5) {
      if unionHasAtomK(f32Set, "f64", 4) { cak = 4 }
    }
  } else if exprIsF64(exprIx, fnIx) {
    cak = 4 // "f64"
  } else if exprIsI64(exprIx, fnIx) {
    // D978's shape one arm down: ask the union which arm stores an i64 rather than assuming
    // the i64 one. A union with only a float arm holds an exact integer LITERAL there, which
    // is the only i64-classified value the checker admits into it (D1890's grant is
    // exactness-gated), and assuming kind 3 asks for an i64 value box the module never minted.
    cak = 3 // "i64"
    const i64Set = coerceSetOf(uSet, uTy)
    if !unionHasAtomK(i64Set, "i64", 3) {
      if unionHasAtomK(i64Set, "f64", 4) { cak = 4 }
      else if unionHasAtomK(i64Set, "f32", 5) { cak = 5 }
    }
  } else if exprIsBool(exprIx, fnIx) {
    cak = 1 // "boolean"
  } else {
    // The union's own promotion of an i32-classified value: no `i32` arm but a wider numeric
    // one, so the value is stored as that arm. `unionStoreAtomKind` is that ladder's one home —
    // the same function the un-narrowed read asks to learn which value box holds the payload
    // it is looking at (D291).

    // Promoting to `i64` alone is not enough: an integer flowing into a union whose only numeric
    // atom is a float would stay `cak = 0` and box an i32 into the f64 or f32 value box, which
    // is check-clean invalid wasm in the global, local and argument positions. f64 before f32,
    // matching the list arm.
    const usw = unionStoreAtomKindOfSet(uSet, uTy, 0)
    if usw >= 0 { cak = usw }
    if numLitWidth(bareIx, fnIx) == "i64" { cak = 3 }
  }
  // A float literal types f64 by default, but if the union's float atom is f32 (`f32 | string`,
  // no f64) the literal re-encodes at f32 — pick the f32 atom so it boxes into the f32 value
  // box. The same promotion ladder, entered at f64 instead of i32. The `cak == 4` gate is
  // hoisted out of the call below so the set resolution is paid only by a float value.
  if cak == 4 {
    const fsw = unionStoreAtomKindOfSet(uSet, uTy, 4)
    if fsw >= 0 { cak = fsw }
  }
  return cak
}

// The value-atom kind of union type `uTy`'s packed list arm, the first width in row order, or
// -1 when it has none.
function unionPackedListKindOfTy(uTy: i32): i32 {
  if unionHasAtomOfTy(uTy, "u8", true) { return 13 }
  if unionHasAtomOfTy(uTy, "i8", true) { return pkKindOfRow(PK_I8) }
  if unionHasAtomOfTy(uTy, "u16", true) { return pkKindOfRow(PK_U16) }
  if unionHasAtomOfTy(uTy, "i16", true) { return pkKindOfRow(PK_I16) }
  return -1
}

// The type list literal `ix` is built at in `fnIx` (`nodeRepTyAt`) when it is one of union
// `uTy`'s list members, else -1.
function arrLitUnionArmTy(ix: i32, uTy: i32, fnIx: i32): i32 {
  if ix < 0 || ix >= P.nodes.length || !(nodeAt(ix) is ArrayLit) { return -1 }
  const at = nodeRepTyAt(ix, fnIx)
  if at < 0 || at >= T.tys.length || !(tyAt(at) is TyArray) { return -1 }
  const ms: i32[] = []
  flattenVariantsInto(nonNullTy(uTy), ms)
  for m in ms {
    if m >= 0 && tyEq(m, at) { return at }
  }
  return -1
}

// The list widening of the atom code `cak0` entering union type `uTy`: a list literal whose
// union holds it as a wider or packed list takes that arm's code, and builds at that arm's type.
export function coerceListAtomOf(
  cak0: i32,
  uTy: i32,
  bareIx: i32,
  fnIx: i32,
): i32 {
  // A list literal is built at the union arm the checker recorded for it, so it boxes under that
  // arm's kind; an `i32`-kind arm keeps the ladder below (D16971).
  const arm = arrLitUnionArmTy(bareIx, uTy, fnIx)
  if arm >= 0 {
    const ak = boxTagOfTy(arm)
    if ak >= 0 && ak != 7 { return ak }
  }
  let cak = cak0
  // An int-element list whose union has no `i32[]` member but an `i64[]` or `f64[]` one: the
  // elements are small int literals, so the list classifies `i32[]` while the union demands the
  // wider list. A boolean list is its own arm, never a number to widen (D2796), and so is a list
  // of string-literal-union atoms (D4902).
  if (
    cak == 7
    && !unionHasAtomOfTy(uTy, "i32", true)
    && !(unionHasAtomOfTy(uTy, "boolean", true) && exprIsBoolList(bareIx, fnIx))
    && !exprIsAtomList(bareIx, fnIx)
  ) {
    if unionHasAtomOfTy(uTy, "i64", true) {
      cak = 10 // "i64[]"
    } else if unionHasAtomOfTy(uTy, "f64", true) {
      cak = 8 // "f64[]"
    } else if unionHasAtomOfTy(uTy, "f32", true) {
      cak = 12 // "f32[]"
    } else {
      // An empty `[]` classifies `i32[]` too: into `u8[] | Buf` it is the packed list.
      const pk = unionPackedListKindOfTy(uTy)
      if pk >= 0 { cak = pk }
    }
  }
  // A float-element literal classifies `f64[]`; where the union's only float-list atom is
  // `f32[]` the checker adopted that arm.
  if (
    cak == 8
    && !unionHasAtomOfTy(uTy, "f64", true)
    && unionHasAtomOfTy(uTy, "f32", true)
  ) {
    cak = 12 // "f32[]"
  }
  return cak
}

// How a value is boxed into its recorded box: the null tag (`null`), a box as itself (`pass`), a
// value-atom box of kind `hbKind` widened from `hbSrc` unless -1 (`atom`), that box over a literal
// at the payload width (`lit`), a `K | null` atom as its member string (`atomStr`), a record as
// itself under arm `hbKind`'s tag (`rec`), or the box writer's own ladder (`ladder`).
export type HoleBoxArm = "null"
  | "pass"
  | "atom"
  | "lit"
  | "atomStr"
  | "rec"
  | "ladder"

export type HoleBox = { hbArm: HoleBoxArm, hbKind: i32, hbSrc: i32 }

function holeBox(arm: HoleBoxArm, kind: i32, src: i32): HoleBox {
  const p: HoleBox = { hbArm: arm, hbKind: kind, hbSrc: src }
  return p
}

// The plan for boxing `exprIx` into `unionTy`, shared by the IR and `emitUnionBoxArg`: it decides
// only the `T | null` boxes, and every rung of the ladder it skips declines the values it takes.
export function holeBoxPlanOf(exprIx: i32, unionTy: i32, fnIx: i32): HoleBox {
  const ladder = holeBox("ladder", -1, -1)
  const ur = repNodeAt(repNodeOfTy(unionTy))
  // A non-null value union's box and a boxed `T | null` share the box's tag and payload.
  if (
    !(ur is RBox || ur is RNullable && ur.rnDisc == 4)
    || mapTwinUnionMember(unionTy) >= 0
  ) {
    return ladder
  }
  if boxDstName("", unionTy) == "" || unionArmTagClash(unionTy) != "" {
    return ladder
  }
  const bareIx = unwrapParen(exprIx)
  if bareIx < 0 { return ladder }
  const bare = nodeAt(bareIx)
  if bare is IfStmt || bare is Index || callIsNever(bareIx) { return ladder }
  if exprUnion(exprIx, fnIx) { return holePassPlanOf(exprIx, unionTy, fnIx) }
  // `emitUnionArmValueBox`'s two plain rungs: a record boxed as itself under its arm.
  if (
    exprVariantIndex(exprIx, fnIx) >= 0
    || structIndexOfExpr(exprIx, fnIx) >= 0
  ) {
    const rv = armValuePlainOf(unionTy, exprIx, fnIx)
    if rv >= 0 { return holeBox("rec", rv, -1) }
  }
  // Every rung below takes a value the record, niche and map rungs above it decline.
  if (
    nulVariantIdxOfExpr(exprIx, fnIx) >= 0
    || exprVariantIndex(exprIx, fnIx) >= 0
    || structIndexOfExpr(exprIx, fnIx) >= 0
    || exprNulBool(bareIx, fnIx)
    || coalesceNulRefNicheOperand(bareIx, fnIx)
    || mapReadScalarBoxKind(exprIx, fnIx) >= 0
  ) {
    return ladder
  }
  // `emitUnionCoerceUnder`'s literal rung, or the null-typed value's.
  if bare is NullLit { return holeBox("null", -1, -1) }
  if exprIsNulNone(exprIx, fnIx) || !unionTyHasValueAtom(unionTy) {
    return ladder
  }
  const uSet = msSetOfRow(unRowOfTyKey(unionTy))
  if exprIsLitAtom(exprIx, fnIx) {
    const ur2 = unRowOfTyKey(unionTy)
    const ums = unionMemberSetOfRow(ur2, boxDstName("", unionTy))
    const un = if ums != "" { ums } else { boxDstName("", unionTy) }
    const ok = coerceTakesAtomAsStr(uSet, unionTy)
      && nulAtomWidenTexts(exprIx, fnIx).length > 0
      && atomNulStrWhy(un, uSet, unionTy, exprIx, fnIx) == ""
    return if ok { holeBox("atomStr", 2, -1) } else { ladder }
  }
  // A scalar list rides the box as itself under its list kind's tag (`emitUnionCoerceAtomBox`):
  // a literal, a ref-element list, a closure and the atom list each have a rung of their own.
  const bareTy = nodeTyAt(bareIx, fnIx)
  if (
    bareTy >= 0
    && tyAt(bareTy) is TyArray
    && !(bare is ArrayLit)
    && !exprRefArray(exprIx, fnIx)
    && !exprIsClosure(exprIx, fnIx)
  ) {
    const lk = coerceListAtomOf(
      coerceValueAtomKind(uSet, unionTy, exprIx, bareIx, fnIx),
      unionTy,
      bareIx,
      fnIx,
    )
    if lk > 5 && listWrapHeapOfKind(lk) >= 0 {
      if lk == 7 && exprIsAtomList(bareIx, fnIx) { return ladder }
      return holeBox("atom", lk, -1)
    }
  }
  const pn = tyPrimNameOf(nodeTyAt(bareIx, fnIx))
  if pn == null { return ladder }
  const pk = holePrimKind(pn)
  if pk < 0 { return ladder }
  const k = coerceListAtomOf(
    coerceValueAtomKind(uSet, unionTy, exprIx, bareIx, fnIx),
    unionTy,
    bareIx,
    fnIx,
  )
  if k < 0 || k > 5 { return ladder }
  if k < 3 { return if k == pk { holeBox("atom", k, -1) } else { ladder } }
  const w = widenPlanOf(exprIx, k, fnIx)
  return match w.wpArm {
    "plain" => holeBox("atom", k, w.wpSrc)
    "instLit" | "floatLit" => holeBox("lit", k, -1)
    "asgLit" | "radix" | "convert" => ladder
  }
}

// DIAG helpers.
function diagKindOf(exprIx: i32, bareIx: i32, fnIx: i32): string {
  const b = nodeAt(bareIx)
  if b is ArrayLit { return "arraylit" }
  if exprRefArray(exprIx, fnIx) { return "reflist" }
  if exprIsClosure(exprIx, fnIx) { return "closure" }
  if exprMap(exprIx, fnIx) { return "map" }
  if tyBearsNull(nodeTyAt(bareIx, fnIx)) { return "nullable" }
  if b is ObjLit { return "objlit" }
  if b is Call { return "call" }
  return "other " + tyToStr(nodeTyAt(bareIx, fnIx))
}

function diagDeclineOf(exprIx: i32, bareIx: i32, fnIx: i32): string {
  if nulVariantIdxOfExpr(exprIx, fnIx) >= 0 { return "nulvariant" }
  if exprVariantIndex(exprIx, fnIx) >= 0 { return "variant" }
  if structIndexOfExpr(exprIx, fnIx) >= 0 { return "struct" }
  if exprNulBool(bareIx, fnIx) { return "nulbool" }
  if coalesceNulRefNicheOperand(bareIx, fnIx) { return "coalesce niche" }
  return "map read"
}

// DIAG: why the box plan answers ladder.
export function holeBoxPlanWhyDiag(exprIx: i32, unionTy: i32, fnIx: i32): string {
    const ur = repNodeAt(repNodeOfTy(unionTy))
  // A non-null value union's box and a boxed `T | null` share the box's tag and payload.
  if (
    !(ur is RBox || ur is RNullable && ur.rnDisc == 4)
    || mapTwinUnionMember(unionTy) >= 0
  ) {
    return "L1 return ladder"
  }
  if boxDstName("", unionTy) == "" || unionArmTagClash(unionTy) != "" {
    return "L2 return ladder"
  }
  const bareIx = unwrapParen(exprIx)
  if bareIx < 0 { return "L3 if bareIx  0  return ladder " }
  const bare = nodeAt(bareIx)
  if bare is IfStmt || bare is Index || callIsNever(bareIx) { return "L4 if bare is IfStmt  bare is Index  callIsNeverbareI" }
  if exprUnion(exprIx, fnIx) { return if holePassPlanOf(exprIx, unionTy, fnIx).hbArm == "ladder" { "pass ladder" } else { "" } }
  // `emitUnionArmValueBox`'s two plain rungs: a record boxed as itself under its arm.
  if (
    exprVariantIndex(exprIx, fnIx) >= 0
    || structIndexOfExpr(exprIx, fnIx) >= 0
  ) {
    const rv = armValuePlainOf(unionTy, exprIx, fnIx)
    if rv >= 0 { return "" }
  }
  // Every rung below takes a value the record, niche and map rungs above it decline.
  if (
    nulVariantIdxOfExpr(exprIx, fnIx) >= 0
    || exprVariantIndex(exprIx, fnIx) >= 0
    || structIndexOfExpr(exprIx, fnIx) >= 0
    || exprNulBool(bareIx, fnIx)
    || coalesceNulRefNicheOperand(bareIx, fnIx)
    || mapReadScalarBoxKind(exprIx, fnIx) >= 0
  ) {
    return "L5 " + diagDeclineOf(exprIx, bareIx, fnIx)
  }
  // `emitUnionCoerceUnder`'s literal rung, or the null-typed value's.
  if bare is NullLit { return "" }
  if exprIsNulNone(exprIx, fnIx) || !unionTyHasValueAtom(unionTy) {
    return "L6 return ladder"
  }
  const uSet = msSetOfRow(unRowOfTyKey(unionTy))
  if exprIsLitAtom(exprIx, fnIx) {
    const ur2 = unRowOfTyKey(unionTy)
    const ums = unionMemberSetOfRow(ur2, boxDstName("", unionTy))
    const un = if ums != "" { ums } else { boxDstName("", unionTy) }
    const ok = coerceTakesAtomAsStr(uSet, unionTy)
      && nulAtomWidenTexts(exprIx, fnIx).length > 0
      && atomNulStrWhy(un, uSet, unionTy, exprIx, fnIx) == ""
    return if ok { "" } else { "atomStr declined" }
  }
  // A scalar list rides the box as itself under its list kind's tag (`emitUnionCoerceAtomBox`):
  // a literal, a ref-element list, a closure and the atom list each have a rung of their own.
  const bareTy = nodeTyAt(bareIx, fnIx)
  if (
    bareTy >= 0
    && tyAt(bareTy) is TyArray
    && !(bare is ArrayLit)
    && !exprRefArray(exprIx, fnIx)
    && !exprIsClosure(exprIx, fnIx)
  ) {
    const lk = coerceListAtomOf(
      coerceValueAtomKind(uSet, unionTy, exprIx, bareIx, fnIx),
      unionTy,
      bareIx,
      fnIx,
    )
    if lk > 5 && listWrapHeapOfKind(lk) >= 0 {
      if lk == 7 && exprIsAtomList(bareIx, fnIx) { return "L7 if lk  7  exprIsAtomListbareIx fnIx  return ladder" }
      return ""
    }
  }
  const pn = tyPrimNameOf(nodeTyAt(bareIx, fnIx))
  if pn == null { return "L8 nonprim " + diagKindOf(exprIx, bareIx, fnIx) }
  const pk = holePrimKind(pn)
  if pk < 0 { return "L9 if pk  0  return ladder " }
  const k = coerceListAtomOf(
    coerceValueAtomKind(uSet, unionTy, exprIx, bareIx, fnIx),
    unionTy,
    bareIx,
    fnIx,
  )
  if k < 0 || k > 5 { return "L10 if k  0  k  5  return ladder " }
  if k < 3 { return if k == pk { "" } else { "atom kind mismatch" } }
  const w = widenPlanOf(exprIx, k, fnIx)
  return match w.wpArm {
    "plain" => ""
    "instLit" | "floatLit" => ""
    "asgLit" | "radix" | "convert" => "widen " + w.wpArm
  }
}

// The arm of `unionTy` record `exprIx` boxes under as itself, or -1: a record, or a bare variant
// whose heap no arm holds, its row a subtype of the arm's; never a literal naming an arm, a value
// that can be null, or a box. `emitUnionWideArmBox`'s plain rung, and the box plan's `rec` arm.
export function wideArmPlainOf(unionTy: i32, exprIx: i32, fnIx: i32): i32 {
  const bareIx = unwrapParen(exprIx)
  if bareIx < 0 || bareIx >= P.nodes.length { return -1 }
  if nodeAt(bareIx) is ObjLit && exprVariantIndex(exprIx, fnIx) >= 0 {
    return -1
  }
  if tyBearsNull(nodeTyAt(bareIx, fnIx)) || exprUnion(exprIx, fnIx) {
    return -1
  }
  const atoms: i32[] = []
  unionArmRowsOfTy(unionTy, atoms)
  const svi = exprVariantIndex(exprIx, fnIx)
  let row = -1
  if svi >= 0 {
    if armsHoldHeap(atoms, variantHeap(svi)) { return -1 }
    row = variantRowOf(svi)
  } else {
    row = structIndexOfExpr(exprIx, fnIx)
  }
  const vi = wideArmOfRow(row, atoms)
  return if vi < 0 || vi >= uTags.length { -1 } else { vi }
}

// The arm `emitUnionArmValueBox` boxes non-null record `exprIx` under as itself, or -1: the arm
// its row subtypes (`wideArmPlainOf`), else its own variant's arm where it is built on that
// variant's heap. A value that may be null, a box, or a record rebuilt onto the arm is -1.
export function armValuePlainOf(unionTy: i32, exprIx: i32, fnIx: i32): i32 {
  const bareIx = unwrapParen(exprIx)
  if (
    exprUnion(exprIx, fnIx)
    || nodeTyIsNullable(bareIx)
    || tyBearsNull(nodeTyAt(bareIx, fnIx))
  ) {
    return -1
  }
  const wv = wideArmPlainOf(unionTy, exprIx, fnIx)
  if wv >= 0 { return wv }
  const svi = exprVariantIndex(exprIx, fnIx)
  if svi < 0 || svi >= uTags.length { return -1 }
  const si = structIndexOfExpr(exprIx, fnIx)
  if si >= 0 && si < sHeapIdx.length && sHeapIdx[si] != variantHeap(svi) {
    return -1
  }
  return svi
}

// The value-atom kind of primitive `pn`, -1 for one that is no value atom here.
function holePrimKind(pn: PrimName): i32 {
  return match pn {
    "i32" => 0
    "boolean" => 1
    "string" => 2
    "i64" => 3
    "f64" => 4
    "f32" => 5
    "void" | "null" | "never" | "u8" | "i8" | "u16" | "i16" | "v128" => -1
  }
}

// `pass` for a box `exprIx` delivered into `unionTy` as it stands: no member re-tagged, re-boxed
// or rebuilt on the way, else `ladder`.
function holePassPlanOf(exprIx: i32, unionTy: i32, fnIx: i32): HoleBox {
  const ladder = holeBox("ladder", -1, -1)
  if exprNullableMap(exprIx, fnIx) || nodeIsNumUnion(exprIx, fnIx) {
    return ladder
  }
  const vty = nodeTyAt(unwrapParen(exprIx), fnIx)
  if vty >= 0 && tyAt(vty) is TyObj { return ladder }
  const ft: i32[] = []
  const tt: i32[] = []
  wideRetagPairs(exprIx, fnIx, unionTy, ft, tt)
  if ft.length > 0 { return ladder }
  if (
    !deliveryRetagHas(exprIx)
    && boxRetagArmsOfTys(unionBoxTyIxOfExpr(exprIx, fnIx), unionTy, [], [])
  ) {
    return ladder
  }
  return holeBox("pass", -1, -1)
}

// The tags of `exprIx`'s union whose arm is wider than an arm of `unionTy` into `fromTags`,
// and that arm's tag beside each into `toTags`.
export function wideRetagPairs(
  exprIx: i32,
  fnIx: i32,
  unionTy: i32,
  fromTags: i32[],
  toTags: i32[],
) {
  const fa: i32[] = []
  const sty = unionBoxTyIxOfExpr(exprIx, fnIx)
  if sty >= 0 && armRowsOfUnionTy(sty, fa) {
    if tySame(sty, unionTy) { return 0 }
  } else {
    // A union whose arms do not resolve by type is a row-less value union: no record arm to retag.
    return 0
  }
  const ta: i32[] = []
  unionArmRowsOfTy(unionTy, ta)
  for vi in fa {
    if vi >= 0 && vi < uTags.length && !armsHoldHeap(ta, variantHeap(vi)) {
      const w = wideArmOfRow(variantRowOf(vi), ta)
      if w >= 0 && w < uTags.length {
        fromTags.push(uTags[vi])
        toTags.push(uTags[w])
      }
    }
  }
  return 0
}

// `armRowsOfUnionTy` of union type `unionTy`, else the rows its arms' spellings name, read off
// the row `unionTy` boxes in: a hole's scalar `T | null` box has no member set of its own.
export function unionArmRowsOfTy(unionTy: i32, rows: i32[]) {
  if unionTy >= 0 && armRowsOfUnionTy(unionTy, rows) { return 0 }
  const atoms: string[] = []
  if !unionArmsOfRow(nulScalarBoxRowOf(unionTy), atoms) {
    return emitFail(
      "emitProgram: a union's arm rows were asked of a type no row holds",
    )
  }
  for a in atoms { rows.push(exactArmRowOfTy(cUserTypes[a] ?? -1)) }
  return 0
}

// Whether one of the variant rows `arms` is on heap type `heap`.
export function armsHoldHeap(arms: i32[], heap: i32): boolean {
  if heap < 0 { return false }
  for vi in arms {
    if vi >= 0 && variantHeap(vi) == heap { return true }
  }
  return false
}

// The variant row among `arms` whose struct row is on struct row `si`'s supertype chain, or -1;
// -1 too when `si` is itself on one of their heaps, since then the value is that arm.
export function wideArmOfRow(si: i32, arms: i32[]): i32 {
  if si < 0 || si >= sHeapIdx.length || armsHoldHeap(arms, sHeapIdx[si]) {
    return -1
  }
  let x = sSuperAt(si)
  let guard = 0
  while x >= 0 && guard < 64 {
    for vi in arms {
      if vi >= 0 && variantRowOf(vi) == x { return vi }
    }
    x = sSuperAt(x)
    guard = guard + 1
  }
  return -1
}

// Whether a box value fitting variant `vi` may be laid out as another arm (D4056), so its payload
// cannot be cast to `vi`'s struct.
export function variantHasCrossTagFits(
  vi: i32,
  exprIx: i32,
  fnIx: i32,
): boolean {
  if vi < 0 || vi >= uVarTyIx.length { return false }
  const rows: i32[] = []
  const kinds: i32[] = []
  crossTagFitRows(vi, uVarTyIx[vi], exprIx, rows, kinds, fnIx)
  return rows.length > 0
}

// The interned member set of the union box at `boxIx`: the row its read's type keys, else, for
// a nullable read, its non-null union's row. With no set the box's literal-union arm reads as
// absent (D12050). -1 when neither names a row.
export function msSetOfUnionBox(boxIx: i32, fnIx: i32): i32 {
  const ty = unionBoxTyOfRead(boxIx, fnIx)
  const s = msSetOfTy(ty)
  if s >= 0 || ty < 0 { return s }
  // A nullable read keying no row is a box of its non-null union, whose miss rides the null tag.
  const t = tyAt(ty)
  return if t is TyNullable { msSetOfTy(t.nInner) } else { -1 }
}

// The element type of field row `ufi` (`sFieldElemTyIx`), or -1 out of range.
export function sFieldElemTyIxOfRow(ufi: i32): i32 {
  return if ufi >= 0 && ufi < sFieldElemTyIx.length { fieldElemTyIn(sFieldElemTyIx, sFieldStoreTy, ufi) } else { -1 }
}

// The arm columns of a box `==` over union type `uty`, index-parallel to its member types `tys`: a struct arm
// carries its variant row in `vis` and -1 in `aks`, a scalar arm the reverse. False declines
// before any byte is written, so an arm set the lowering cannot serve keeps its caller's loud refusal.
const UNION_BOX_EQ_NO_ARMS_MSG = "emitProgram: a union box compared with `==` has no type to read its arms from"

export function unionBoxEqColumns(
  uty: i32,
  tys: i32[],
  vis: i32[],
  aks: i32[],
): boolean {
  const rows: i32[] = []
  const urows: i32[] = []
  if uty >= 0 && armRowTysOfUnionTy(uty, tys, urows) {
    // A struct arm's columns are keyed by the first row of its type, as each frame it stages is.
    let k = 0
    while k < tys.length {
      rows.push(if urows[k] >= 0 { exactArmRowOfTy(tys[k]) } else { -1 })
      k = k + 1
    }
  } else {
    emitFail(UNION_BOX_EQ_NO_ARMS_MSG)
    return false
  }
  if tys.length < 2 { return false }
  let i = 0
  while i < tys.length {
    const vi = rows[i]
    if vi < 0 {
      // NOT A VARIANT: the arm is servable exactly when it is a value ATOM whose payload
      // this lowering can unbox and compare — the same bound `emitUnionPayloadUnbox` and
      // `atomEqOpcodeOfKind` enforce, asked BEFORE any byte is written so an unservable arm
      // still DECLINES (keeping the caller's loud message) instead of failing loudly here.
      let ak = boxAtomKindOfMemberTy(tys[i])
      if ak < 0 { ak = boxArmKindOfTy(ak, tys[i]) }
      if ak < 0 { return false }
      if ak == 2 {
        // a string arm is servable: its compare mints the string types.
      } else if ak != nullValKind() && ak != 11 {
        // A list arm is servable too: its payload is the wrapper ref, so the unbox is a
        // `ref.cast` and the compare is the generic list core. A closure arm (11) rides the same
        // shape and compares by identity (D1098). Everything left still needs a scalar value box
        // and declines without one.
        if listWrapHeapOfKind(ak) < 0 {
          if vbHeapIdxOfKind(ak) < 0 { return false }
        }
      }
      vis.push(-1)
      aks.push(ak)
      i = i + 1
      continue
    }
    if vi >= uVarRow.length { return false }
    if vi >= uTags.length { return false }
    if vi >= uFieldStart.length { return false }
    if vi >= uFieldCount.length { return false }
    if !variantFieldsComparable(vi) { return false }
    vis.push(vi)
    aks.push(-1)
    i = i + 1
  }
  return true
}

// The scalar of number kind `k` (`i32`, `i64`, `f64` or `f32`), or null for any other kind.
export function numPrimOfKind(k: i32): RpPrim | null {
  if k == 0 { return "i32" }
  if k == 3 { return "i64" }
  if k == 4 { return "f64" }
  if k == 5 { return "f32" }
  return null
}

// Can every field of variant `vi` be compared by this lowering? Codes 0 (i32 / boolean) and
// 3 (string) only — a ref, list or map field would need the recursive machinery the struct
// table carries, and declining keeps the caller's loud refusal for those.
export function variantFieldsComparable(vi: i32): boolean {
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  let j = 0
  while j < cnt {
    if start + j >= sFieldNames.length { return false }
    if !variantFieldComparable(vi, start + j) { return false }
    j = j + 1
  }
  return true
}

// D1096 — the admission is the field's rep, not the three codes the ladder happens to have arms
// for: one unservable field declines the whole compare, so a `{ d: f64 }` arm would refuse
// `p == a` while the identical field compares fine at its direct spelling. Most of those cores
// exist already; `i64` and `f32` are the two the struct ladder does not serve either.
function variantFieldComparable(vi: i32, ufi: i32): boolean {
  const c = fieldRowKind(ufi)
  if c == "nulnone" {
    return true // `null` has one value: the core drops both reads and answers true
  }
  if c == "i32" || c == "nulbool" {
    // i32 and boolean, and the two i32-sentinel niches that share the slot (D1180) — the struct
    // ladder's own rung. Their null rides in the value space, so `i32.eq` answers `null == null`
    // true with no guard.
    return true
  }
  if c == "str" {
    return true // string
  }
  if c == "f64" {
    return true // f64
  }
  if c == "i64" {
    return true // i64
  }
  if c == "f32" {
    return true // f32
  }
  if c == "closure" {
    return true // a function-valued field: identity (id + env)
  }
  // D974 — a nested shape field (code 15) is comparable when its shape has an interned struct
  // row, which `collectU` mints for exactly these (`internInlineShapeTy`). No row, no compare —
  // the same decline discipline every other code gets.
  if eqKindIsRecord(c) { return variantNestedRow(vi, ufi) >= 0 }
  // A ref-list field needs the ref-list slot its element name resolves to, both to reserve the
  // frame and to pick the element core; without one there is no compare to emit.
  if c == "reflist" { return variantRefListFieldSlot(ufi) >= 0 }
  // A BOX field is comparable when the shared box core can serve every arm (D1290).
  if c == "union" { return variantBoxFieldComparable(ufi) }
  // D1180 — a ref-niche field (`string | null`, `T[] | null`) is its non-null twin's core under
  // a null guard, so it is comparable exactly when that twin is. Same table, same guard and the
  // same admission rule as the struct ladder's: one home, two ladders.
  const cn = nulFieldInnerKind(c)
  if cn != null { return variantFieldCodeComparable(vi, ufi, cn) }
  return eqVariantListKind(c) >= 0
}

// Can the shared box core serve every arm of a code-16 variant field's union? The field's
// recorded elem name is the atom-set name the box is built against.
function variantBoxFieldComparable(ufi: i32): boolean {
  const bty = sFieldElemTyIxOfRow(ufi)
  if bty < 0 { return false }
  const bArms: i32[] = []
  const bVis: i32[] = []
  const bAks: i32[] = []
  return unionBoxEqColumns(bty, bArms, bVis, bAks)
}

// The admission question keyed by an EXPLICIT code, so the niche rung above can ask it of the
// non-null twin without re-entering the niche arm.
function variantFieldCodeComparable(vi: i32, ufi: i32, c: VKind): boolean {
  if c == "i32" || c == "nulbool" { return true }
  if c == "str" { return true }
  if c == "f64" { return true }
  if c == "i64" { return true }
  if c == "f32" { return true }
  if c == "closure" { return true }
  if eqKindIsRecord(c) { return variantNestedRow(vi, ufi) >= 0 }
  if c == "reflist" { return variantRefListFieldSlot(ufi) >= 0 }
  return eqVariantListKind(c) >= 0
}

// The ref-list slot of the code-5 variant field at flat row `ufi`, or -1 — keyed by the
// field's recorded element type, as `variantFieldRefSlot` keys it by (variant, field).
export function variantRefListFieldSlot(ufi: i32): i32 {
  if fieldRowSlotTable(ufi) != "reflist" { return 0 - 1 }
  if ufi >= sFieldElemTyIx.length { return 0 - 1 }
  return rlSlotOfTyOrTwin(fieldElemTyIn(sFieldElemTyIx, sFieldStoreTy, ufi))
}

// D974 — the struct row variant `vi`'s nested-record field `ufi` (a flat row) is stored at,
// found by the field's type; a type with no row has already had the arm mint's one chance.
export function variantNestedRow(vi: i32, ufi: i32): i32 {
  if vi < 0 || vi >= uFieldStart.length { return -1 }
  if ufi < 0 || ufi >= sFieldNames.length { return -1 }
  const stored = uFieldTgtStructIdx(vi, ufi - uFieldStart[vi])
  if stored >= 0 && stored < sHeapIdx.length { return stored }
  return emitFail(
    "emitProgram: a variant's nested record field has no struct row to compare it at",
  )
}

// The union type an `==` operand is compared at: a map read's value union (its miss is the
// caller's), else the union a narrowed read is stored in, else the operand's own type. A
// narrowed read still holds its box, so its arms come from the storage, not the narrowing.
function unionEqOperandTy(ix: i32, fnIx: i32): i32 {
  if nodeAt(unwrapParen(ix)) is Index { return unionBoxTyIxOfExpr(ix, fnIx) }
  const st = unionBoxStoreTyOf(ix, fnIx)
  if st >= 0 { return st }
  return nodeTyAt(unwrapParen(ix), fnIx)
}

// The union operand `ix` of `==` is boxed in, named from its box type (`boxTyName`), else by the
// declared alias its type is; "" where neither names one.
function unionEqNameOf(ix: i32, fnIx: i32): string {
  const n = boxTyName(unionBoxTyIxOfExpr(ix, fnIx))
  if n != "" { return n }
  return unionAliasDeclNameOfTy(nodeTyAt(unwrapParen(ix), fnIx))
}

// Whether union operand `ix` is typed at a union `unionEqNameOf` names none for: its name would
// come from a spelling, so the compare is refused.
export function unionEqNameless(ix: i32, fnIx: i32): boolean {
  if unionEqNameOf(ix, fnIx) != "" { return false }
  const t = nodeTyAt(unwrapParen(ix), fnIx)
  return t >= 0
    && t < T.tys.length
    && (tyAt(t) is TyUnion || tyAt(t) is TyNullable)
}

// Of union types `a` and `b`, the one that carries `null` when the two have the same
// non-null members (`memberTySame`) and only one carries it; -1 for any other pair.
function unionNulTwinTy(a: i32, b: i32): i32 {
  const am: i32[] = []
  const bm: i32[] = []
  const an = nonNullVariantsInto(a, am)
  const bn = nonNullVariantsInto(b, bm)
  if an == bn || am.length != bm.length || am.length == 0 { return -1 }
  for x in am {
    let hit = false
    for y in bm {
      if memberTySame(x, y) { hit = true }
    }
    if !hit { return -1 }
  }
  if an { return a }
  return b
}

// Appends the non-null variants of `ty` to `out`, answering whether it has a `null` one.
function nonNullVariantsInto(ty: i32, out: i32[]): boolean {
  const vs: i32[] = []
  flattenVariantsInto(ty, vs)
  let had = false
  for v in vs {
    if isNullTy(v) { had = true } else { out.push(v) }
  }
  return had
}

// The two operands' union names and the union type a union `==` reads its arms from.
type UeNames = { uenL: string, uenR: string, uenTy: i32 }

export function unionEqNamesOf(lIx: i32, rIx: i32, fnIx: i32): UeNames {
  const nm: UeNames = {
    uenL: unionEqNameOf(lIx, fnIx),
    uenR: unionEqNameOf(rIx, fnIx),
    uenTy: unionEqOperandTy(lIx, fnIx),
  }
  const lt = nodeTyAt(unwrapParen(lIx), fnIx)
  const rt = nodeTyAt(unwrapParen(rIx), fnIx)
  // Two spellings of one member set are one union: both name the row their types reach.
  if nm.uenL != nm.uenR {
    const lr = unRowOfRecordTy(lt)
    if lr >= 0 && lr == unRowOfRecordTy(rt) {
      nm.uenL = unNames[lr]
      nm.uenR = nm.uenL
      nm.uenTy = lt
    }
  }
  // A union beside its own `| null` twin is one box, `null` one more tag of it: the compare
  // reads the arms of the side that carries `null`.
  if nm.uenL != nm.uenR {
    const nt = unionNulTwinTy(lt, rt)
    if nt >= 0 {
      if nt == lt { nm.uenR = nm.uenL } else { nm.uenL = nm.uenR }
      nm.uenTy = nt
    }
  }
  return nm
}

// Whether a union `==` under `nm` first tries the struct union's field compare (D973).
export function unionEqStructFirst(nm: UeNames): boolean {
  return nm.uenL != ""
    && nm.uenL == nm.uenR
    && !isValueUnionOfSet(msSetOfTyAny(nm.uenTy), nm.uenTy)
}

// The staged compare's columns for a union `==` under `nm` whose right operand is `rIx`, into
// `arms`/`vis`/`aks` and the right union's kinds `rKs`: "" when it serves them, else the refusal.
export function unionEqStagedPlan(
  nm: UeNames,
  rIx: i32,
  fnIx: i32,
  arms: i32[],
  vis: i32[],
  aks: i32[],
  rKs: i32[],
): string {
  if (
    nm.uenL == ""
    || nm.uenR == ""
    || !unionBoxEqColumns(nm.uenTy, arms, vis, aks)
  ) {
    return "emitProgram: union `==`: an operand's union has arms the box compare cannot serve"
  }
  if !msMemberValKindsOf(msSetOfTyAny(unionEqOperandTy(rIx, fnIx)), rKs) {
    return "emitProgram: a union `==` operand's type has no banked member kinds"
  }
  return ""
}

// Whether `emitBinExprNode` routes compare `e` to `emitUnionUnionEq` and its staged compare
// serves the two unions: neither side a `null` literal, a scalar map read or an atom operand.
export function unionUnionEqStagedOf(e: BinExpr, fnIx: i32): boolean {
  if e.binIdent != 0 || e.binOp != "==" && e.binOp != "!=" { return false }
  if numUnionMinted && njDispatches(e, fnIx) { return false }
  const l = e.binLeft
  const r = e.binRight
  if nodeAt(unwrapParen(l)) is NullLit || nodeAt(unwrapParen(r)) is NullLit {
    return false
  }
  if mapReadScalarBoxKind(l, fnIx) >= 0 || mapReadScalarBoxKind(r, fnIx) >= 0 {
    return false
  }
  if !exprUnion(l, fnIx) || eqAtomOperandOk(l, fnIx) { return false }
  if !exprUnion(r, fnIx) || eqAtomOperandOk(r, fnIx) { return false }
  if unionEqNameless(l, fnIx) || unionEqNameless(r, fnIx) { return false }
  const nm = unionEqNamesOf(l, r, fnIx)
  if unionEqStructFirst(nm) { return false }
  // The columns refuse a union with no arm rows loudly; that refusal stays legacy's.
  const tys: i32[] = []
  const rows: i32[] = []
  if nm.uenTy < 0 || !armRowTysOfUnionTy(nm.uenTy, tys, rows) { return false }
  const arms: i32[] = []
  const vis: i32[] = []
  const aks: i32[] = []
  const rKs: i32[] = []
  return unionEqStagedPlan(nm, r, fnIx, arms, vis, aks, rKs) == ""
}

// Whether `obj` has a float member and no integer arm and `chk` is a set of integer literals:
// the test compares by value, the literal converted to the float (`tyFloatIntLitTest`, D3689).
export function emFloatIntLitTest(obj: i32, chk: i32): boolean {
  const tx = tyNumLitMemberTexts(chk)
  if tx.length == 0 || obj < 0 { return false }
  for t in tx {
    if numLexIsFloat(t) { return false }
  }
  const ms: i32[] = []
  flattenVariantsInto(obj, ms)
  let float = false
  for m in ms {
    if tyIsPrimNamed(m, "i32") || tyIsPrimNamed(m, "i64") { return false }
    if tyNumLitMemberTexts(m).length > 0 { return false }
    if tyIsPrimNamed(m, "f64") || tyIsPrimNamed(m, "f32") { float = true }
  }
  return float
}

// The SPELLING of a scalar value-atom kind — the inverse of `valueAtomKind` over exactly
// the four widths `mapReadScalarBoxKind` can answer with. Only those four: this is a
// membership query against a union's rendered atoms, and every other code either has a
// niche of its own (so it never reaches here) or is not a scalar at all.
export function scalarAtomNameOfKind(k: i32): string {
  if k == 14 { return "v128" }
  return numPrimOfKind(k) ?? ""
}

// Whether a box held at union type `fromTy` needs a retag to be read at `toTy`, filling the
// member types of each (`unionTyMemberTys`). False where either type is -1 or names no arms: a box
// whose union no type covers is read as built.
export function boxRetagArmsOfTys(
  fromTy: i32,
  toTy: i32,
  ft: i32[],
  tt: i32[],
): boolean {
  if fromTy < 0 || toTy < 0 { return false }
  if !unionTyMemberTys(fromTy, ft) || !unionTyMemberTys(toTy, tt) {
    return false
  }
  for pt in ft {
    if boxAtomRetagKind(pt, tt, ft) >= 0 { return true }
  }
  return false
}

// The kind of the member of `toTys` that member `pt` of `fromTys` is rebuilt as, or -1: widened
// by `boxWidenAtomFor`'s first-match rule, else narrowed back by its exact inverse
// (`boxNarrowAtomFor`); a stored member two members widen to answers -1, never a guess.
export function boxAtomRetagKind(pt: i32, toTys: i32[], fromTys: i32[]): i32 {
  const w = boxWidenAtomFor(pt, toTys, fromTys)
  if w >= 0 { return w }
  const n = boxNarrowAtomFor(pt, toTys, fromTys)
  if n >= 0 { return n }
  return -1
}

// Whether read `ix` can be the `null` unit: only a read checked `null`, or one whose type is
// open in a type variable, has that store, so any other skips `exprIsNulNone`'s read rep.
export function readMayBeNulUnit(ix: i32): boolean {
  const t = nodeTyIxOf(unwrapParen(ix))
  return t < 0 || isNullTy(t) || tyHasTyVar(t)
}

// The expression whose rep the `emitExprAs*` widenings must classify: an assignment in
// value position classifies by the re-read of its target cell (`asgReadNode`), since `g = 7`
// leaves the cell's rep on the stack (`emitBinExprNode`'s `=` arm stores, then re-reads the
// target). Only the classification moves — the right-hand side still evaluates once — so a widening cell in any value position is not double-widened (`i64.extend_i32_s` over an already-i64 value: invalid wasm).
function widenClassifyExpr(exprIx: i32, fnIx: i32) {
  const wce = nodeAt(unwrapParen(exprIx))
  if wce is BinExpr {
    if wce.binOp == "=" {
      // Only an IDENT target is a value expression here (`emitBinExprNode` rejects the
      // rest), and its rep is the one `asgReadNode` names for the re-read.
      const wct = nodeAt(wce.binLeft)
      if wct is Ident { return asgReadNode(unwrapParen(exprIx), fnIx) }
    }
  }
  return exprIx
}

// How `emitWidened` builds a value at a wider number kind: a literal at that width (`instLit` in a
// pinned instance, `floatLit` a float literal at f32), a stored literal (`asgLit`), a radix
// assignment (`radix`, `wpWide` its prim), a numeric union converted per member (`convert`), or
// the value as kind `wpSrc` widened (`plain`).
export type WidenArm = "instLit"
  | "floatLit"
  | "asgLit"
  | "radix"
  | "convert"
  | "plain"

export type WidenPlan = { wpArm: WidenArm, wpSrc: i32, wpWide: string }

function widenPlan(arm: WidenArm, src: i32, wide: string): WidenPlan {
  const p: WidenPlan = { wpArm: arm, wpSrc: src, wpWide: wide }
  return p
}

// The plan for building `ix` at kind `dst` (3 i64, 4 f64, 5 f32), asked in each width's order: a
// classifier may mint on its first ask, so none is asked that the order does not reach.
export function widenPlanOf(ix: i32, dst: i32, fnIx: i32): WidenPlan {
  const inner = unwrapParen(ix)
  const instLit = cexLitPeel(ix) >= 0 && fnInPinnedInstance(fnIx)
  if instLit && dst != 4 { return widenPlan("instLit", -1, "") }
  if dst == 5 && cexLitPeel(ix) >= 0 && isFloatLitExpr(inner) {
    return widenPlan("floatLit", -1, "")
  }
  if asgLitApplies(ix, fnIx) { return widenPlan("asgLit", -1, "") }
  const rw = asgRadixWidePrim(inner, fnIx)
  if rw != "" { return widenPlan("radix", -1, rw) }
  const cls = widenClassifyExpr(ix, fnIx)
  if dst == 3 {
    // A join whose wide arm claims `i64` can still be a box of numbers (D3517).
    if exprIsI64(cls, fnIx) { return widenAtOwn(ix, 3, fnIx) }
  } else if dst == 4 {
    // An f32 source promotes before the f64 fast path, which a float literal operand would claim.
    if exprIsF32(cls, fnIx) { return widenPlan("plain", 5, "") }
    const f64 = exprIsF64(cls, fnIx)
    if f64 || exprIsI64(cls, fnIx) {
      if njBoxWidens(ix, fnIx) { return widenPlan("convert", 6, "") }
    }
    if f64 { return widenPlan("plain", 4, "") }
    if instLit { return widenPlan("instLit", -1, "") }
    if exprIsI64(cls, fnIx) { return widenPlan("plain", 3, "") }
  } else if exprIsF32(cls, fnIx) {
    return widenAtOwn(ix, 5, fnIx)
  }
  // A numeric union converts at the member it holds; anything else is an i32.
  if njWidensOut(ix, fnIx) { return widenPlan("convert", 6, "") }
  return widenPlan("plain", 1, "")
}

// A value already at kind `k`: plain, unless it lowers as a box of numbers.
function widenAtOwn(ix: i32, k: i32, fnIx: i32): WidenPlan {
  if njBoxWidens(ix, fnIx) { return widenPlan("convert", 6, "") }
  return widenPlan("plain", k, "")
}

// Whether `exprIx` is an assignment whose value is its right side's number literal.
function asgLitApplies(exprIx: i32, fnIx: i32): boolean {
  const ix = unwrapParen(exprIx)
  if ix < 0 || ix >= P.nodes.length || asgLitWidth(ix, fnIx) == "" {
    return false
  }
  return nodeAt(ix) is BinExpr
}

// The lexeme (quotes kept) operand `ix` is statically known to be: a string literal, or an
// expression whose type is exactly one string literal (a bare `"z"`, or a one-member literal
// union); "" otherwise. A type is the value set, so a one-literal type is one value.
function staticStrLitLex(ix: i32, fnIx: i32): string {
  const u = unwrapParen(ix)
  if u < 0 { return "" }
  const n = nodeAt(u)
  if n is StrLit { return n.strText }
  if nodeHasWideStrLit(u) { return quoteLex(nodeWideStrLitText(u)) }
  const t = nodeTyAt(u, fnIx)
  if !tyIsOneStrLit(t) { return "" }
  return quoteLex(tyLitMemberTexts(t)[0])
}

// Whether two string lexemes (quotes kept) spell the same value — decoded, so an escape and the
// character it stands for agree.
export function strLexSameValue(a: string, b: string): boolean {
  if a == b { return true }
  const da = decodeStr(strToCps(a))
  const db = decodeStr(strToCps(b))
  if da.length != db.length { return false }
  let i = 0
  while i < da.length {
    if da[i] != db[i] { return false }
    i = i + 1
  }
  return true
}

// The lexeme (quotes kept) of the member in `texts` whose value `lex` spells, else `lex` itself —
// whose interned id then matches no member's.
function memberLexOfValue(texts: string[], lex: string): string {
  // With no backslash on either side a lexeme's value is its text between the quotes, so the
  // compare is the raw one and nothing is decoded.
  const plain = !strHasBackslash(lex)
  const inner = lex.slice(1, lex.length - 1)
  for t in texts {
    if plain && !strHasBackslash(t) {
      if t == inner { return quoteLex(t) }
    } else if strLexSameValue(quoteLex(t), lex) {
      return quoteLex(t)
    }
  }
  return lex
}

// Whether `s` holds a backslash, the only character `decodeStr` reads as other than itself.
function strHasBackslash(s: string): boolean {
  for c in s {
    if c == '\\' { return true }
  }
  return false
}

// True when `ix` can be lowered in atom context — the interned i32 id the litunion atom
// `==` needs on both sides: an atom-repped expression, a member string literal, or a
// string-repped litunion. A plain `string` is excluded on purpose: `emitStrToAtom`'s
// tower needs membership guaranteed, which a plain `string` does not carry.
export function eqAtomOperandOk(ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return true }
  const av = unwrapParen(ix)
  if av < 0 { return false }
  const e = nodeAt(av)
  if e is StrLit { return true }
  if exprUnion(ix, fnIx) { return false }
  return nodeTyIsLitUnion(av)
}

// Which arm of `emitIdentNode` past its list overrides reads Ident `ix`, in the ladder's order;
// `pastNull` once a null read found no other null to deliver. The IR reads `local` off it.
export type IdentReadArm = "nulnone" | "nullread" | "defglobal" | "unbox" | "niche"
  | "reflist" | "map" | "capture" | "nonlocal" | "local"

export function identReadArmOf(
  e: Ident,
  ix: i32,
  fnIx: i32,
  pastNull: boolean,
): IdentReadArm {
  if identCellVKind(ix, fnIx) == "nulnone" { return "nulnone" }
  if !pastNull && isNullTy(readNarrowedTyAt(ix, fnIx)) { return "nullread" }
  if isDefaultGlobalRef(ix) && globalIndexOfSid(sidOfNode(ix)) >= 0 {
    return "defglobal"
  }
  if identReadAtomKindAt(ix, fnIx) >= 0 { return "unbox" }
  if (
    nicheReadKindAt(ix, fnIx) >= 0
    && identReadsUnionBox(e.identName, ix, fnIx)
  ) {
    return "niche"
  }
  const con = identReadContainerAt(ix, fnIx)
  if con == RC_REF_LIST && identReadsUnionBox(e.identName, ix, fnIx) {
    return "reflist"
  }
  if con == RC_MAP { return "map" }
  if captureSlotOf(e.identName, fnIx) >= 0 { return "capture" }
  return if localIndexOf(fnIx, ix) < 0 { "nonlocal" } else { "local" }
}

// Whether variant `vi`'s record is rep `rep`: the destination a narrowed box read is unboxed for.
export function narrowedVariantRepIs(vi: i32, rep: i32): boolean {
  return vi >= 0 && vi < uVarTyIx.length && repNodeOfTy(uVarTyIx[vi]) == rep
}

// The variant a box local's plain read `ix` unboxes to at a destination of that variant
// (`emitVariantCoerce`'s box arm), or -1; a cross-tag fit owes a refusal there.
export function narrowedBoxVariantPlain(ix: i32, fnIx: i32): i32 {
  const n = nodeAt(ix)
  if !(n is Ident) || identReadArmOf(n, ix, fnIx, false) != "local" {
    return -1
  }
  if exprVariantIndex(ix, fnIx) >= 0 || !exprUnion(ix, fnIx) { return -1 }
  const vi = narrowedStructArmVi(ix, fnIx)
  if vi < 0 || variantHasCrossTagFits(vi, ix, fnIx) { return -1 }
  return vi
}

// Whether a narrowed read of `name` finds the union box it unboxes: a binding of this frame
// with a union render, a capture held as a box, or the typed-IR net for a binding with neither.
function identReadsUnionBox(name: string, exprIx: i32, fnIx: i32): boolean {
  const r = (unionNameOfRead(exprIx, fnIx) != ""
    || capturedIsUnionBox(fnIx, name)
    || identChainTyBoxedUnion(exprIx, fnIx, 4))
  return r
}

// Whether the value at `ix` is a union of numeric primitives (`njMembersOf`).
export function nodeIsNumUnion(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  // Nearly every operand is typed at one primitive, which answers without a walk.
  if tyIsPrimIx(nodeTyAt(ix, fnIx)) { return false }
  return njMembersOf(ix, fnIx).length > 0
}

// Whether the value at `ix` is a box of numbers a widening delivery converts out of member by
// member: a numeric union, or an integer-literal union over two bases (D3491), which mints no
// numeric union and so is asked without that gate.
function njWidensOut(ix: i32, fnIx: i32): boolean {
  // Nearly every widened value is typed at one primitive, which is no box.
  if tyIsPrimIx(nodeTyAt(ix, fnIx)) { return false }
  if numUnionMinted && nodeIsNumUnion(ix, fnIx) { return true }
  return njLitBasesOf(ix, fnIx).length > 0
}

// Whether the value at `ix` lowers as a box of numbers that converts out member by member,
// though a widening's fast path classified it at the destination's width.
function njBoxWidens(ix: i32, fnIx: i32): boolean {
  return njWidensOut(ix, fnIx) && exprUnion(ix, fnIx)
}

// The bases of the two-base literal-number union the value at `ix` holds (`litNumUnionBasesOf`):
// its recorded type's, at the instance `fnIx` where that is a hole or type parameter (D9523).
// Empty otherwise.
export function njLitBasesOf(ix: i32, fnIx: i32): i32[] {
  return litNumUnionBasesOf(njSideTyOf(ix, fnIx))
}

// The type of operand `ix` a dispatch reads its literal bases off: its recorded type, or where
// that is a hole or type parameter, the one instance `fnIx` binds it to.
export function njSideTyOf(ix: i32, fnIx: i32): i32 {
  const t = nodeTyAt(ix, fnIx)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyVar) { return t }
  const it = nodeTyInOf(ix, fnIx)
  if it < 0 || it >= T.tys.length || tyHasTyVar(it) { return t }
  return it
}

// The member types of the numeric union at `ix`: its recorded type's, or, where an instance
// left that a type parameter, the members of the union its box is lowered as. Empty otherwise.
export function njMembersOf(ix: i32, fnIx: i32): i32[] {
  const t = nodeTyAt(ix, fnIx)
  const ms = numUnionMembersOf(t)
  if ms.length > 0 { return ms }
  const lb = njLitBasesOf(ix, fnIx)
  if lb.length > 0 { return lb }
  const none: i32[] = []
  // Only a name can be a box its recorded type does not name; any other node is typed by it,
  // at the instance's pin where it records a hole (D9701).
  const u = nodeAt(unwrapParen(ix))
  if !(u is Ident) {
    if t >= 0 && t < T.tys.length && tyAt(t) is TyVar {
      return numUnionMembersOf(njSideTyOf(ix, fnIx))
    }
    return none
  }
  if tyIsNumericBox(t) { return none }
  // An instance's parameter can carry no recorded type at all; its box still names the members.
  if t >= 0 && !tyHasTyVar(t) { return none }
  if !exprUnion(ix, fnIx) { return none }
  const nr: i32[] = []
  const name = unionNameRowOfExpr(ix, fnIx, nr)
  if name == "" { return none }
  const out: i32[] = []
  for k in njKindsOfUnion(nr[0]) {
    if k == 6 {
      // Skipped: an operator reaches a type parameter's box only past a check that excluded
      // `null` (the template's narrowing), whatever member set the instance's name spells.
    } else if k != 0 && k != 3 && k != 4 && k != 5 {
      return none
    } else {
      out.push(numPrimTyOfKind(k))
    }
  }
  if out.length < 2 { return none }
  return out
}

// Whether `e` is an operator over a numeric union and a number: not a `null` test, an
// assignment or a short-circuit.
export function njDispatches(e: BinExpr, fnIx: i32): boolean {
  // Two primitive operands, nearly every operator, answer without a call each.
  if (
    tyIsPrimIx(nodeTyAt(e.binLeft, fnIx))
    && tyIsPrimIx(nodeTyAt(e.binRight, fnIx))
  ) {
    return false
  }
  if !nodeIsNumUnion(e.binLeft, fnIx) && !nodeIsNumUnion(e.binRight, fnIx) {
    return false
  }
  if nodeAt(unwrapParen(e.binLeft)) is NullLit { return false }
  if nodeAt(unwrapParen(e.binRight)) is NullLit { return false }
  // An equality can meet the `null` an instance's box holds, which the dispatch skips; the
  // union equality tests the tag first (D3520).
  if (
    (e.binOp == "==" || e.binOp == "!=")
    && (njBoxHoldsNull(e.binLeft, fnIx) || njBoxHoldsNull(e.binRight, fnIx))
  ) {
    return false
  }
  return e.binOp != "=" && e.binOp != "&&" && e.binOp != "||" && e.binOp != "??"
}

// Whether the name at `ix` is an instance's box whose member set holds a `null` it has not
// been narrowed past: the member `njMembersOf` skips.
function njBoxHoldsNull(ix: i32, fnIx: i32): boolean {
  const u = nodeAt(unwrapParen(ix))
  if !(u is Ident) { return false }
  const t = nodeTyIxOf(ix)
  if t < 0 || !tyHasTyVar(t) || !exprUnion(ix, fnIx) { return false }
  // A read the checker narrowed past `null` holds none.
  if readNarrowedStoreAt(ix, fnIx) >= 0 && !readNarrowedToNull(ix, fnIx) {
    return false
  }
  const nr: i32[] = []
  const name = unionNameRowOfExpr(ix, fnIx, nr)
  if name == "" { return false }
  for k in njKindsOfUnion(nr[0]) {
    if k == 6 { return true }
  }
  return false
}

// The value-atom kinds of the members of union row `u`: the row's banked kinds. A row with none is
// a compile failure.
function njKindsOfUnion(u: i32): i32[] {
  const ks: i32[] = []
  if msMemberValKindsOf(msSetOfRow(u), ks) { return ks }
  emitFail("emitProgram: a numeric union's row has no banked member kinds")
  return ks
}

// Which arm legacy's `==`/`!=` over an atom takes. `fold`: both operands are typed as one string
// literal (`aqLex`, `aqLexR`), so the compare is a constant. `static`: one side is such a literal
// beside an atom (`aqStaticLeft` names it), spelled as the member `aqLex` it equals, since an atom
// is interned by its member's lexeme. `ids`: two atom values. `none`: another compare.
export type AtomEqArm = "fold" | "static" | "ids" | "none"

export type AtomEqPlan = {
  aqArm: AtomEqArm,
  aqStaticLeft: boolean,
  aqLex: string,
  aqLexR: string,
}

// The atom compare arm of `==`/`!=` node `e` (D2156); see `AtomEqPlan`.
export function atomEqPlanOf(e: BinExpr, fnIx: i32): AtomEqPlan {
  const none: AtomEqPlan = {
    aqArm: "none",
    aqStaticLeft: false,
    aqLex: "",
    aqLexR: "",
  }
  if e.binOp != "==" && e.binOp != "!=" { return none }
  const slL = staticStrLitLex(e.binLeft, fnIx)
  const slR = staticStrLitLex(e.binRight, fnIx)
  if slL != "" && slR != "" {
    const f: AtomEqPlan = {
      aqArm: "fold",
      aqStaticLeft: false,
      aqLex: slL,
      aqLexR: slR,
    }
    return f
  }
  const slAtomL = slL != "" && exprIsLitAtom(e.binRight, fnIx)
  const slAtomR = slR != "" && exprIsLitAtom(e.binLeft, fnIx)
  if slAtomL || slAtomR {
    // A value no member equals keeps its own lexeme, whose id no atom carries, so `==` is false.
    const atomIx = if slAtomL { e.binRight } else { e.binLeft }
    const lex = if slAtomL { slL } else { slR }
    const st: AtomEqPlan = {
      aqArm: "static",
      aqStaticLeft: slAtomL,
      aqLex: memberLexOfValue(
        litAtomWidenTexts(atomIx, fnIx),
        lex,
      ),
      aqLexR: "",
    }
    return st
  }
  // A `null` operand is the nullable-struct compare's: a litunion atom never equals it, and
  // lowering that `null` as an atom would mis-route it to a bare-null struct context.
  if nodeAt(unwrapParen(e.binLeft)) is NullLit { return none }
  if nodeAt(unwrapParen(e.binRight)) is NullLit { return none }
  if !exprIsLitAtom(e.binLeft, fnIx) && !exprIsLitAtom(e.binRight, fnIx) {
    return none
  }
  // A mixed pair is the string compare's, which widens the atom to its member string.
  if !eqAtomOperandOk(e.binLeft, fnIx) || !eqAtomOperandOk(e.binRight, fnIx) {
    return none
  }
  const ids: AtomEqPlan = {
    aqArm: "ids",
    aqStaticLeft: false,
    aqLex: "",
    aqLexR: "",
  }
  return ids
}

// Whether union type `ty` has a non-null member that boxes as a value atom: one with a read atom
// kind, a string literal set, or an all-literal member (kept whole by the canonical walk) with a
// literal whose softened scalar has one. False for an all-struct union.
export function unionTyHasValueAtom(ty: i32): boolean {
  const ms: i32[] = []
  if !canonUnionMemberTysOf(ty, ms) { return false }
  for m in ms {
    if m >= 0 {
      if readAtomKindOfTy(m) >= 0 || tyIsLitUnionOrLit(m) { return true }
      if litSetHasValueAtom(m) { return true }
    }
  }
  return false
}

// Whether `m` is a union of literals only, one of whose softened scalars reads as a value atom.
function litSetHasValueAtom(m: i32): boolean {
  const mt = tyAt(m)
  if !(mt is TyUnion) || mt.uMembers.length == 0 { return false }
  for u in mt.uMembers {
    if u < 0 || !(tyAt(u) is TyLit) { return false }
  }
  for u in mt.uMembers {
    if readAtomKindOfTy(softenLitTy(u)) >= 0 { return true }
  }
  return false
}

// Whether a plain compare's operand `exprIx`, read as a narrowed nullable niche or a nullable
// closure, is recovered to its non-null ref after it is written (`emitEqRecoverNarrowed`).
export function eqOperandRecovers(exprIx: i32, fnIx: i32): boolean {
  return nulRecvNeedsRecover(exprIx, fnIx) || exprNulClosure(exprIx, fnIx)
}

// True when `exprIx` names a narrowed nullable collection whose cell still holds a
// `(ref null $wrap)` — every rep a list/map operation must `ref.as_non_null` before the
// wrapper `struct.get`. The read dual of `emitNulIsNullTest`'s niche disjunction, so a rep
// the null test claims but this does not would be check-clean invalid wasm, never a diagnostic.
export function nulRecvNeedsRecover(exprIx: i32, fnIx: i32) {
  return nulCollWrapHeap(exprIx, fnIx) != -1
}

// Whether `emitExpr` reads member `memIx` through `emitMem`'s plain arms: no null-unit or niche
// read, no `length` but a record's own field, no two-list use, and a receiver read raw unless it is
// a field read, which recovers itself.
function memberReadPlain(memIx: i32, fnIx: i32): boolean {
  const m = nodeAt(memIx)
  if !(m is Member) { return false }
  if m.memProp == "length" && !lengthIsField(m, memIx, fnIx) { return false }
  if readMayBeNulUnit(memIx) && exprIsNulNone(memIx, fnIx) { return false }
  if placeNicheAtomKind(memIx, fnIx) >= 0 { return false }
  // A field read's receiver recovers in its own read; any other receiver owing one is not plain.
  return twoListUseMsg(m.memObj, m.memProp, fnIx) == ""
    && (nodeAt(m.memObj) is Member || !readOwesNonNullRecover(m.memObj, fnIx))
}

// Whether `.length` read `m` at `memIx` is a record's own field, which `emitMemberNode` reads as
// any field: a struct or variant receiver, with no list-fit grow row and no union-of-containers arm.
export function lengthIsField(m: Member, memIx: i32, fnIx: i32): boolean {
  const o = m.memObj
  if structIndexOfExpr(o, fnIx) < 0 && exprVariantIndex(o, fnIx) < 0 {
    return false
  }
  return listFitGrowRow(o, -1, fnIx) < 0 && !armSiteReads(memIx, fnIx)
}

// The field `emitExpr` reads off a bare variant receiver in `emitMemVariantRead`'s plain form,
// or -1: a plain member read, no narrowed box, and no union-box field to unbox.
export function variantFieldPlain(memIx: i32, fnIx: i32): i32 {
  const m = nodeAt(memIx)
  if !memberReadPlain(memIx, fnIx) || !(m is Member) { return -1 }
  if memReadArmOf(memIx, fnIx) != "variant" { return -1 }
  const vi = exprVariantIndex(m.memObj, fnIx)
  if vi >= uFieldStart.length { return -1 }
  const idx = variantFieldIndex(vi, m.memProp)
  if idx < 0 { return -1 }
  if fieldRowIsUnionBox(uFieldStart[vi] + idx) { return idx }
  return if fieldStoresRead(uFieldStart[vi] + idx, memIx, fnIx) { idx } else { -1 }
}

// Whether flat field row `row` stores the kind member read `memIx` records, or its nullable twin
// the read recovers (`emitReadRecover`): a row adopted at another kind converts at the delivery.
function fieldStoresRead(row: i32, memIx: i32, fnIx: i32): boolean {
  const sk = fieldRowStorageKind(row)
  const rk = repOfNode(memIx, fnIx).rdKind
  if sk == null { return false }
  if sk == rk || sk == "nulstr" && rk == "str" { return true }
  return vkNonNullRefTwin(sk) == rk && readOwesNonNullRecover(memIx, fnIx)
}

// The field `emitExpr` reads off a plain struct receiver in `emitMemStructRead`'s plain form, or
// -1: a plain member read of no variant, union or nullable struct, with no narrowing op and no
// union-box field.
export function structFieldPlain(memIx: i32, fnIx: i32): i32 {
  const m = nodeAt(memIx)
  if !memberReadPlain(memIx, fnIx) || !(m is Member) || !sDeclared { return -1 }
  const o = m.memObj
  if memReadArmOf(memIx, fnIx) != "shared" || exprUnion(o, fnIx) { return -1 }
  if nodeTyAt(o, fnIx) == TY_NEVER || exprNullableStruct(o, fnIx) { return -1 }
  const si = structIndexOfExpr(o, fnIx)
  if si < 0 || si >= sHeapIdx.length { return -1 }
  const idx = sFieldIndex(si, m.memProp)
  if idx < 0 || memReadNarrowOp(memIx, fnIx) >= 0 { return -1 }
  // A union-box field's tail unboxes to the read's own type, but never an ambiguous box.
  if sFieldIsUnionBox(si, idx) {
    return if memReadBoxAmbiguous(memIx, fnIx) { -1 } else { idx }
  }
  return if fieldStoresRead(sFieldStart[si] + idx, memIx, fnIx) { idx } else { -1 }
}

// Whether plain member read `memIx` reads a union-box field, whose tail delivers the read's own rep.
export function memFieldUnionBox(memIx: i32, fnIx: i32): boolean {
  const m = nodeAt(memIx)
  if !(m is Member) { return false }
  const vi = exprVariantIndex(m.memObj, fnIx)
  if vi >= 0 {
    const vf = variantFieldIndex(vi, m.memProp)
    return vf >= 0 && fieldRowIsUnionBox(uFieldStart[vi] + vf)
  }
  const si = structIndexOfExpr(m.memObj, fnIx)
  if si < 0 || si >= sHeapIdx.length { return false }
  const sf = sFieldIndex(si, m.memProp)
  return sf >= 0 && sFieldIsUnionBox(si, sf)
}

// Which rung of `emitIs` answers `is` test `isIx`, in its order: `storage`, tested at its storage;
// `tautology`, a frame local typed exactly the tested type; `covers`/`fits`, every member tested,
// union or not; `prim`/`pin`, a non-union operand a primitive or a pin decides; else `test`,
// `emitIsTest`'s rungs, which a float against integer literals takes too (D3689).
export type IsPreArm = "storage"
  | "tautology"
  | "covers"
  | "fits"
  | "prim"
  | "pin"
  | "test"

export function isPreArmOf(isIx: i32, fnIx: i32): IsPreArm {
  const nd0 = nodeAt(isIx)
  if !(nd0 is IsExpr) { return "test" }
  if isTestsStorage(nd0.isObj, fnIx) { return "storage" }
  const tested = isVarTyIxOf(isIx)
  const covOp = nodeTyAt(nd0.isObj, fnIx)
  const union = exprUnion(nd0.isObj, fnIx)
  const tl = nodeAt(unwrapParen(nd0.isObj))
  if (
    tl is Ident
    && localIndexOf(fnIx, unwrapParen(nd0.isObj)) >= 0
    && covOp >= 0
    && tested >= 0
    && !isUnionOfTy(covOp)
    && !union
    && tySame(covOp, tested)
  ) {
    return "tautology"
  }
  if union && isTestedEveryMember(covOp, tested) { return "covers" }
  if (
    covOp >= 0
    && !isUnionOfTy(covOp)
    && !union
    && tyUnionCovers(tested, covOp)
  ) {
    return "fits"
  }
  if emFloatIntLitTest(covOp, tested) { return "test" }
  if tyPrimNameOf(covOp) != null && tyPrimNameOf(tested) != null && !union {
    return "prim"
  }
  if !union && (isPinOwn(covOp, tested) || isPinUnrelated(covOp, tested)) {
    return "pin"
  }
  return "test"
}

// Whether closed record or list type `op` is the tested type `t` itself.
export function isPinOwn(op: i32, t: i32): boolean {
  if op < 0 || op >= T.tys.length || t < 0 || t >= T.tys.length { return false }
  const ot = tyAt(op)
  if tyHasTyVar(op) || tyHasHole(op) || !(ot is TyObj || ot is TyArray) {
    return false
  }
  return tySame(op, t)
}

// Whether closed non-union type `op` is related by `assignable`, in either direction, to no
// member of tested type `t`, a list against a list excepted.
function isPinUnrelated(op: i32, t: i32): boolean {
  if op < 0 || op >= T.tys.length || t < 0 || t >= T.tys.length { return false }
  if (
    isUnionOfTy(op)
    || tyHasTyVar(op)
    || tyHasHole(op)
    || tyAt(op) is TyNullable
  ) {
    return false
  }
  const tests: i32[] = []
  flattenVariantsInto(t, tests)
  if tests.length == 0 { return false }
  const opList = tyAt(op) is TyArray
  for x in tests {
    if x < 0 || assignable(x, op) || assignable(op, x) { return false }
    // An empty list fits every list type, so a list tested against a list is not decided.
    if opList && tyAt(x) is TyArray { return false }
  }
  return true
}
