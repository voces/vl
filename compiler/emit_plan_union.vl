// The union decisions both emitters read: whether a narrowed arm is unboxed where it is
// delivered, and which record arms a value's type names.
// It writes no bytes and imports nothing from `wasmEmit.vl` or `ir_*.vl`.

import { T, TyUnion, tyAt, tyIsRecord } from "./check_types"
import { unwrapParen } from "./emit_base"
import { nodeTyAt } from "./emit_capture_frames"
import { exprUnion } from "./emit_classify"
import { narrowedStructArmVi } from "./emit_local_scope"
import { narrowedNulStructArm } from "./emit_shape_rows"
import { flattenVariantsInto, nullableInnerOrNone } from "./tyquery"

// The cast target is the destination's heap and not `variantHeap(vi)`: the slot is what the store
// must satisfy, and where the arm is merged with a declared twin the indices are the same
// anyway. Not a change to `exprUnion`, which would move every narrowed struct receiver.
export function narrowedArmNeedsUnbox(exprIx: i32, fnIx: i32): boolean {
  if (
    narrowedStructArmVi(exprIx, fnIx) < 0
    && !narrowedNulStructArm(exprIx, fnIx)
    && !exprTyIsRecord(exprIx, false, fnIx)
    && !exprTyIsRecord(exprIx, true, fnIx)
    && exprRecordArmsTy(exprIx, fnIx) < 0
  ) {
    return false
  }
  return exprUnion(exprIx, fnIx)
}

// The checker's union type of `exprIx` where every member is a record, which the checker let a
// record slot take because each member fits it (D16321); -1 otherwise.
export function exprRecordArmsTy(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const ty = nodeTyAt(unwrapParen(exprIx), fnIx)
  if ty < 0 || ty >= T.tys.length || !(tyAt(ty) is TyUnion) { return -1 }
  const ms: i32[] = []
  flattenVariantsInto(ty, ms)
  for m in ms {
    if !tyIsRecord(m) { return -1 }
  }
  return ty
}

// Whether the checker typed `exprIx` as one record, or as `record | null` when `nullable`.
// A box of that type is a union of same-shape records collapsed to the record (D4989), so
// its payload is the record itself.
export function exprTyIsRecord(
  exprIx: i32,
  nullable: boolean,
  fnIx: i32,
): boolean {
  if exprIx < 0 { return false }
  const ty = nodeTyAt(unwrapParen(exprIx), fnIx)
  if nullable { return ty >= 0 && tyIsRecord(nullableInnerOrNone(ty)) }
  return tyIsRecord(ty)
}
