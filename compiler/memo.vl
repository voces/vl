// `memo.vl` — the generation counters a cross-pass memo is keyed on, and the one comparison
// every key makes. A memo stamped on table LENGTHS cannot see a table filled in place (D1655):
// a key here compares and records each input in one call, so the inputs it tests and the
// inputs it stamps cannot drift apart, and the pass generation is one call away. The arena's
// own counters stay with the arena (`arenaEpochNow`, `arenaRefWritesNow` in `ast.vl`).

// How many pass-table rows have run for this program. A classifier memo whose ladder reads
// a table a later pass still fills (`fRetKind` is one) may cache only within the pass that
// computed it, so this is the generation such a memo stamps (D1655).
export let emitPassGen = 0

// `emitProgram` calls this after each pass-table row.
export function memoPassAdvance() {
  emitPassGen = emitPassGen + 1
  0
}

// Every in-place rewrite of a struct or union table row, which no table length shows; part of
// the type-registry generation (`tyRegGenNow`, compiler/emit_classify.vl).
export let tyRegWrites = 0

export function tyRegNoteWrite() {
  tyRegWrites = tyRegWrites + 1
  0
}

// Every in-place re-lay of a union variant field row's code, the generation the tag-key memo
// stamps (`variantTagKey`, compiler/emit_classify.vl).
export let uFieldReLays = 0

export function uFieldReLayNote() {
  uFieldReLays = uFieldReLays + 1
  tyRegNoteWrite()
}

// A memo's key: the value each of its inputs had when the key last read it, -1 before then.
export type MemoKey = { seen: i32[] }

// A key over `n` inputs, numbered 0 to n-1, none read yet.
export function memoKeyNew(n: i32): MemoKey {
  const seen: i32[] = []
  while seen.length < n { seen.push(-1) }
  { seen: seen }
}

// Whether input `i` of `k` differs from `v`, recording `v`. Every input is non-negative, so
// a key's first read of an input always moves. Combine with `||` AFTER the call
// (`moved = memoMoved(k, i, v) || moved`) so every input is recorded.
export function memoMoved(k: MemoKey, i: i32, v: i32): boolean {
  if k.seen[i] == v { return false }
  k.seen[i] = v
  true
}

// `memoMoved` on input `i` for the pass generation, the input D1655's memo lacked.
export function memoPassMoved(k: MemoKey, i: i32): boolean {
  memoMoved(k, i, emitPassGen)
}
