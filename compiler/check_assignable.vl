// Record call `ix` through the marked binding `decl`, which re-asked the constraints `used` owns,
// with what it bound; `fsbRecheckCalls` re-asks those of every other function written to it.
export function fsbNoteCall(
  ix: i32,
  decl: i32,
  used: i32,
  who: string,
  hNames: string[],
  hNo: i32[],
  hNode: i32[],
  argTys: i32[],
) {
  if decl < 0 || inferQuiet { return 0 }
  if fsbCallSeen(ix, decl, used, argTys) { return 0 }
  fsbCallArgTysPush(argTys)
  fsbCallIxPush(ix)
  fsbCallDeclPush(decl)
  fsbCallUsedPush(used)
  fsbCallWhoPush(who)
  fsbCallHNamesPush(hNames)
  fsbCallHNoPush(hNo)
  fsbCallHNodePush(hNode)
  fsbCallOwnNPush(0)
  // The writes already seen are re-asked here, inside the body the call stands in, so a pair
  // naming that body's type parameter is deferred to its instances as a direct call's is.
  fsbRecheckFrom(fsbCallIx.length - 1)
}

// Whether call `ix` through `decl` at `argTys` is already recorded. A re-asked constraint can
// deliver the binding again at the same types, and recording it anew would re-ask without end.
function fsbCallSeen(ix: i32, decl: i32, used: i32, argTys: i32[]): boolean {
  let c = 0
  while c < fsbCallIx.length {
    if (
      fsbCallIx[c] == ix
      && fsbCallDecl[c] == decl
      && fsbCallUsed[c] == used
      && i32ListEq(fsbCallArgTys[c], argTys)
    ) {
      return true
    }
    c = c + 1
  }
  false
}

// Each write `rhs` of the function type `rt`, rewritten into an adapter at call `c`'s argument
// types when a parameter it fixes takes another rep than the argument there (D4892).
function fsbAdaptWrites(c: i32, rt: i32, nm: string[], ty: i32[], rhs: i32[]) {
  const f = tyAt(rt)
  if !(f is TyFunc) || f.fnRet < 0 { return 0 }
  // A call through the set a written `let` reads as runs each member at its own instance.
  if c < 0 || c >= fsbCallIx.length { return 0 }
  const cn = nodeAt(fsbCallIx[c])
  if cn is Call && fnLetIsWide(nodeTyIxOf(cn.callFn)) { return 0 }
  const args = fsbCallArgTys[c]
  if args.length != f.fnParamTypes.length { return 0 }
  let fixed = false
  let j = 0
  while j < args.length {
    const p = f.fnParamTypes[j]
    if p >= 0 && args[j] >= 0 && !tyHasTyVar(p) && p != widenLitTy(args[j]) {
      fixed = true
    }
    j = j + 1
  }
  if !fixed { return 0 }
  const sps: i32[] = []
  const dps: i32[] = []
  let i = 0
  while i < args.length {
    const sp = substTyDeep(f.fnParamTypes[i], nm, ty)
    if sp < 0 || args[i] < 0 { return 0 }
    sps.push(sp)
    dps.push(widenLitTy(args[i]))
    i = i + 1
  }
  const ret = substTyDeep(f.fnRet, nm, ty)
  const src = mkFuncTy(sps, ret)
  const dst = mkFuncTy(dps, ret)
  if tyHasTyVar(dst) || tyReachesHole(dst, 8) || !fvaFnMayDiffer(src, dst, 8) {
    return 0
  }
  for r in rhs { fvaAdapt(r, rt, dst) }
  0
}

// Re-ask, at call `c`, each owner row recorded since it last asked.
export function fsbRecheckFrom(c: i32) {
  if c < 0 || c >= fsbCallOwnN.length { return 0 }
  let w = fsbCallOwnN[c]
  while w < fsbOwnDecl.length {
    if fsbOwnerReaches(fsbCallDecl[c], fsbOwnDecl[w], 0) {
      fsbRecheckOne(c, fsbOwnFn[w], fsbOwnTy[w], fsbOwnRhs[w])
    }
    w = w + 1
  }
  fsbCallOwnNSetAt(c, fsbOwnDecl.length)
  0
}

// One call `c` re-asks owner `o`'s constraints with each type-variable parameter of the written
// function type `rt` bound, by position, to the argument the call passes there. Only the written
// function's own parameters are bound: the seed's type variables name another declaration's.
function fsbRecheckOne(c: i32, o: i32, rt: i32, rhs: i32[]) {
  const nm: string[] = []
  const ty: i32[] = []
  const added = fsbBindParams(rt, fsbCallArgTys[c], nm, ty)
  if added == 0 || o == fsbCallUsed[c] { return 0 }
  if !fsbArgsFit(c, rt, nm, ty) { return 0 }
  fsbAdaptWrites(c, rt, nm, ty, rhs)
  const modeWas = substNestMode
  const declWas = substNestDecl
  substNestModeSet(SUBST_ALL)
  if o >= 0 { substNestModeSet(SUBST_DECLARED) }
  const ix = fsbCallIx[c]
  const who = fsbCallWho[c]
  const callee = fsbOwnerCallee(o)
  cstrOwnedStrictSet(o >= 0)
  adoptHoleLitArgs(nm, ty, callee, fsbCallHNames[c], fsbCallHNode[c])
  validateBinCstrs(
    nm,
    ty,
    ix,
    callee,
    who,
    fsbCallHNames[c],
    fsbCallHNo[c],
    fsbCallHNode[c],
  )
  validatePrintCstrs(nm, ty, ix, callee, who)
  validateIsCstrs(nm, ty, ix, callee, who)
  validateArgCstrs(nm, ty, ix, callee, fsbCallHNames[c], fsbCallHNode[c])
  validateRetCstrs(nm, ty, ix, callee, who)
  validateLetCstrs(nm, ty, ix, callee, who)
  validateBmCstrs(nm, ty, ix, callee, who)
  validateMemCstrs(
    nm,
    ty,
    ix,
    callee,
    who,
    fsbCallHNames[c],
    fsbCallHNo[c],
    fsbCallHNode[c],
  )
  cstrOwnedStrictSet(false)
  substNestModeSet(modeWas)
  substNestDeclSet(declWas)
  0
}

// A delivery of the marked binding `src` to the concrete function type `dst` is a call at `dst`'s
// parameters for every function written to it (D3968).
function fsbNoteFnDelivery(src: i32, dst: i32) {
  if dst < 0 || dst >= T.tys.length || src < 0 { return 0 }
  const f = tyAt(dst)
  // An element of an array literal, or a field of an object literal, is delivered to the
  // destination's element or field type.
  const sn = nodeAt(parenPeelIx(src))
  if f is TyNullable { return fsbNoteFnDelivery(src, f.nInner) }
  if sn is ArrayLit {
    if f is TyArray {
      for e in sn.arrElems { fsbNoteFnDelivery(e, f.aElem) }
    }
    return 0
  }
  if sn is ObjLit {
    if f is TyObj {
      for fi in sn.objFields {
        const fn = nodeAt(fi)
        if fn is FieldInit {
          fsbNoteFnDelivery(fn.fiValue, objFieldType(f, fn.fiName))
        }
      }
    }
    return 0
  }
  if !(f is TyFunc) || tyHasTyVar(dst) { return 0 }
  const d = fsbDeclAtNode(src)
  if d < 0 { return 0 }
  const args: i32[] = []
  for p in f.fnParamTypes { args.push(p) }
  const none: string[] = []
  const noIx: i32[] = []
  const noNode: i32[] = []
  fsbNoteCall(src, d, CSTR_ANYFN, "", none, noIx, noNode, args)
}

// The if-joins of `calleeFn` a call re-asks at its bindings: a join that stays apart there
// re-checks the callee's body at the pinned parameter types `pTys`, and one still open (a
// generic caller) is parked until the caller's own pin (D2832).
export function validateTpIfJoins(
  bNames: string[],
  bTys: i32[],
  pTys: i32[],
  retTy: i32,
  ix: i32,
  calleeFn: i32,
) {
  if calleeFn < 0 || monoRecheckDepth > 0 || inferQuiet { return 0 }
  const owner = cstrOwnerTop()
  if tysHaveTyVarIn(bTys) {
    if owner >= 0 && tpIfFnHasRow(calleeFn) {
      noteTpIfRe(calleeFn, owner, bNames, bTys, pTys)
    }
  } else {
    tpIfPinCheck(calleeFn, pTys, bNames, bTys, retTy, ix)
  }
  // The joins a generic callee of this body left open, now pinned in this body's terms.
  const n0 = tpIfReFn.length
  let r = 0
  while r < n0 {
    if tpIfReOwner[r] == calleeFn {
      const rNames: string[] = []
      const rTys: i32[] = []
      let q = 0
      while q < tpIfReCount[r] {
        rNames.push(tpIfReNames[tpIfReStart[r] + q])
        rTys.push(substTyDeep(tpIfReTys[tpIfReStart[r] + q], bNames, bTys))
        q = q + 1
      }
      const rParams: i32[] = []
      const ps = tpIfReParams[r]
      let pi = 0
      while pi < ps.length {
        rParams.push(substTyDeep(ps[pi], bNames, bTys))
        pi = pi + 1
      }
      if tysHaveTyVarIn(rTys) {
        if owner >= 0 { noteTpIfRe(tpIfReFn[r], owner, rNames, rTys, rParams) }
      } else {
        tpIfPinCheck(tpIfReFn[r], rParams, rNames, rTys, -1, ix)
      }
    }
    r = r + 1
  }
  0
}

// The joins of `fn` at the concrete bindings `bNames`/`bTys`: one that stays apart where it is
// not built as a union refuses the call, and otherwise the body is re-checked there.
function tpIfPinCheck(
  fn: i32,
  pTys: i32[],
  bNames: string[],
  bTys: i32[],
  retTy: i32,
  ix: i32,
) {
  let apartJ = -1
  let unbuilt = -1
  let k = 0
  while k < tpIfFn.length {
    if tpIfFn[k] == fn {
      const sj = substTyDeep(tpIfJoin[k], bNames, bTys)
      if sj >= 0 && !tyHasTyVar(sj) && tyReachesUnion(sj, 6) {
        // The widest names the whole chain of an `else if`, whose links are rows too.
        if apartJ < 0 || unionMemberCountOf(sj) > unionMemberCountOf(apartJ) {
          apartJ = sj
        }
        if unbuilt < 0 && !tpIfRowBuilt(k) { unbuilt = sj }
      }
    }
    k = k + 1
  }
  if apartJ < 0 { return 0 }
  let msg = ""
  if unbuilt >= 0 {
    apartJ = unbuilt
    msg = "no one list holds it where its value goes — bind it to a `const`, or deliver it where its union is declared"
  } else {
    msg = tpIfRecheck(fn, pTys, bNames, bTys, retTy)
  }
  if msg == "" { return 0 }
  let fWho = "the callee's body"
  const fd = nodeAt(fn)
  if fd is FuncDecl {
    if fd.fnName != "" { fWho = "the body of `" + fd.fnName + "`" }
  }
  tErr(
    "at the call's argument types, the branches of an `if`, `match` or `??` in "
      + fWho
      + " join "
      + tpMembersListText(apartJ)
      + ": "
      + msg,
    ix,
  )
  0
}

// Re-checks the body of `fn` at the pinned parameter types `pTys`, where a join of its is a
// union of lists, and answers the first sentence that body earns there ("" for none). A value
// the body hands back is held to the call's type `retTy` (-1: not asked), and a list or record
// the instance would build of the join at the template's one-list type is refused.
function tpIfRecheck(
  fn: i32,
  pTys: i32[],
  bNames: string[],
  bTys: i32[],
  retTy: i32,
): string {
  const dn = nodeAt(fn)
  if !(dn is FuncDecl) { return "" }
  let i = 0
  while i < pTys.length {
    if pTys[i] < 0 || tyHasTyVar(pTys[i]) { return "" }
    i = i + 1
  }
  let want = retTy
  if want >= 0 && (tyHasTyVar(want) || want == TY_ERR || isVoidTy(want)) {
    want = -1
  }
  if prbArmed { prbEnter() }
  const cs = checkMark()
  const savedRet = T.curRet
  const savedFn = curFnDeclIx
  const savedNat = retNatural
  const savedNatErr = retNaturalErr
  // An unasked return is `TY_ERR`, which every value passes: `-2` would bank the returns as
  // witnesses of whatever function is being inferred around this call.
  if want >= 0 { T.curRet = want } else { T.curRet = TY_ERR }
  curFnDeclIx = fn
  const savedNjFn = njFnIx
  njFnIxSet(fn)
  cstrOwnerStack.push(fn)
  tpIfCmpNamesSet(bNames)
  tpIfCmpTysSet(bTys)
  tpIfCmpBadSet("")
  tpIfCmpOnSet(true)
  const d0 = T.diags.length
  let msg = ""
  const sv = monoRecheckBegin(fn, pTys, bNames, bTys)
  if sv != null {
    if T.diags.length > d0 { msg = T.diags[d0].tmsg }
    if msg == "" && want >= 0 {
      const rets: i32[] = []
      collectRetValues(dn.fnBody, rets)
      let r = 0
      while r < rets.length && msg == "" {
        const rt = checkNodeHook(rets[r])
        if rt >= 0 && rt != TY_ERR && rt != TY_VOID && rt != TY_NEVER {
          if !assignable(rt, want) {
            msg = "it returns "
              + tyToStr(rt)
              + ", which the call reads as "
              + tyToStr(want)
          }
        }
        r = r + 1
      }
    }
    monoRecheckEnd(sv)
  }
  tpIfCmpOnSet(false)
  if msg == "" { msg = tpIfCmpBad }
  cstrOwnerStack.pop()
  curFnDeclIx = savedFn
  njFnIxSet(savedNjFn)
  T.curRet = savedRet
  retNaturalSet(savedNat)
  retNaturalErrSet(savedNatErr)
  checkRollback(cs, RB_PINNED)
  if prbArmed { prbLeave("tpIfRecheck") }
  msg
}

// A declared generic function delivered by name as a value to the concrete function type
// `dstTy` is instantiated there, so the constraints its body deferred are adjudicated at the
// bindings that type gives its parameters, as a direct call's are (D3080).
export function genFnValueCstrs(srcExpr: i32, srcTy: i32, dstTy: i32) {
  // A validator re-delivers a recorded value through `assignableExpr`, which must not re-enter.
  // With no generic or hole-typed lambda declared, or no function type at the destination, there
  // is nothing to bind.
  const anyCand = cstrCandAny || valBindLambda.length > 0
  if genFnCstrBusy || !anyCand || !tyMayHoldFn(dstTy, 0) { return 0 }
  genFnCstrBusySet(true)
  genFnValueCstrsAt(srcExpr, srcTy, dstTy, 0)
  genFnCstrBusySet(false)
  0
}

// `genFnValueCstrs` at `srcExpr`, reaching through the fields of an object literal and the
// elements of a list literal delivered to a record or list type, `depth` levels down.
function genFnValueCstrsAt(srcExpr: i32, srcTy: i32, dstTy: i32, depth: i32) {
  if srcExpr < 0 || dstTy < 0 || depth > 8 { return 0 }
  const lit = nodeAt(parenPeelIx(srcExpr))
  if lit is ObjLit {
    const dobj = tyAt(dstTy)
    if dobj is TyObj {
      for fi in lit.objFields {
        const f = nodeAt(fi)
        if f is FieldInit {
          const ft = objFieldType(dobj, f.fiName)
          if ft >= 0 {
            genFnValueCstrsAt(f.fiValue, nodeTyOf(f.fiValue), ft, depth + 1)
          }
        }
      }
    }
    return 0
  }
  if lit is ArrayLit {
    const darr = tyAt(dstTy)
    if darr is TyArray {
      for el in lit.arrElems {
        genFnValueCstrsAt(el, nodeTyOf(el), darr.aElem, depth + 1)
      }
    }
    return 0
  }
  ctnWrittenJudge(srcExpr, srcTy, dstTy)
  const e = lit
  if !(e is Ident) { return 0 }
  let st = srcTy
  if st < 0 { st = identTyOf(parenPeelIx(srcExpr), e.identName) }
  if st < 0 { return 0 }
  let decl = fnDeclIx[e.identName] ?? CSTR_NODECL
  // A generic nested in the enclosing function, delivered where that function's own type
  // parameters type the destination (`return b` at `(T) => void`): its demands are re-recorded
  // at those parameters, as a call of it in the enclosing body is (D3896).
  let nested = false
  if decl < 0 {
    const nd = identFnDeclOf(parenPeelIx(srcExpr))
    if nestParentOf.has(nd) {
      decl = nd
      nested = true
    }
  }
  if decl >= P.nodes.length { return 0 }
  if decl < 0 {
    const d0 = T.diags.length
    holeFnValueCstrsAt(srcExpr, st, dstTy, e.identName)
    const vd = cwFnValueDeclOf(srcExpr)
    if T.diags.length == d0 && vd >= 0 {
      holeDeclValueCstrsAt(srcExpr, vd, st, dstTy, e.identName)
    }
    // A re-pointed `let` delivered at a function type is called at its parameters.
    let fdt = dstTy
    const fdn = tyAt(fdt)
    if fdn is TyNullable { fdt = fdn.nInner }
    const fdf = tyAt(fdt)
    if T.diags.length == d0 && vd < 0 && fdf is TyFunc {
      holeLetWritesDisagree(srcExpr, fdf.fnParamTypes)
    }
    return 0
  }
  const fd = nodeAt(decl)
  if !(fd is FuncDecl) { return 0 }
  if fd.fnTyParams.length == 0 {
    const d0 = T.diags.length
    holeFnValueCstrsAt(srcExpr, st, dstTy, e.identName)
    if T.diags.length == d0 {
      holeDeclValueCstrsAt(srcExpr, decl, st, dstTy, e.identName)
    }
    return 0
  }
  let dt = dstTy
  const dn = tyAt(dt)
  if dn is TyNullable { dt = dn.nInner }
  // At a concrete destination a nested generic is the function-value adapter's to check, which
  // reports the same demand as its reason.
  const open = tyHasTyVar(dt)
  if dt < 0 || (nested && !open) { return 0 }
  // A generic declared elsewhere is deferred only to the generic whose body is being checked,
  // so every type variable of the destination must be that generic's.
  if !nested && open && !tyVarsOfEnclosingGeneric(dt) { return 0 }
  const s = tyAt(st)
  const d = tyAt(dt)
  if !(s is TyFunc) || !(d is TyFunc) { return 0 }
  if s.fnParamTypes.length != d.fnParamTypes.length { return 0 }
  const bNames: string[] = []
  const bTys: i32[] = []
  let i = 0
  while i < s.fnParamTypes.length {
    bindGenWalk(s.fnParamTypes[i], d.fnParamTypes[i], bNames, bTys)
    i = i + 1
  }
  if bNames.length == 0 { return 0 }
  const who = e.identName
  const noArgs: i32[] = []
  const modeWas = substNestMode
  const declWas = substNestDecl
  const strictWas = cstrOwnedStrict
  const cvWas = cvNow
  let owner = decl
  if nested {
    owner = CSTR_NODECL
    substNestModeSet(SUBST_NESTED)
    substNestDeclSet(decl)
  } else if open {
    // A destination typed by the enclosing generic's parameters defers what it cannot decide to
    // that generic, as a direct call in its body does; only the delivered function's own
    // constraints are re-asked (D3923).
    substNestModeSet(SUBST_DECLARED)
    cstrOwnedStrictSet(true)
    // What is deferred carries this delivery, which the refusal at the pin names.
    cvNow = srcExpr
  }
  pinBmCstrElems(bNames, bTys, srcExpr, owner, noArgs)
  declCstrsAtBinding(bNames, bTys, srcExpr, owner, who)
  cstrOwnedStrictSet(strictWas)
  cvNow = cvWas
  substNestModeSet(modeWas)
  substNestDeclSet(declWas)
  0
}

// `ctnWrittenCstrsAt`, then for a value it does not refuse the place the value reads, traced
// through aliases and returns (D10150). A value an assignment replaced on every path to the
// delivery is judged by neither (D10202).
function ctnWrittenJudge(srcExpr: i32, srcTy: i32, dstTy: i32) {
  const d0 = T.diags.length
  if ctnCutArm(ctnDeliveredDeclOf(srcExpr), parenPeelIx(srcExpr)) {
    ctnWrittenCstrsAt(srcExpr, srcTy, dstTy)
    if T.diags.length == d0 { holeSlotDeliveryJudge(srcExpr, srcTy, dstTy) }
  }
  ctnCutClear()
  0
}

// A container binding delivered, whole or by element, where the destination fixes the type
// variables of its element: each function value written into the binding is judged at those
// types, as a call through it at that type judges it (D10080).
function ctnWrittenCstrsAt(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcTy < 0 || !tyHasTyVar(srcTy) || tyHasTyVar(dstTy) { return 0 }
  const d = ctnDeliveredDeclOf(srcExpr)
  if d < 0 { return 0 }
  const bNames: string[] = []
  const bTys: i32[] = []
  bindGenWalk(srcTy, nonNullTy(dstTy), bNames, bTys)
  if bNames.length == 0 { return 0 }
  const at = " (written into `"
    + ctnDeclName(d)
    + "`, delivered at "
    + tyToStr(dstTy)
    + ")"
  let ci = 0
  while ci < bmCstr.got.length {
    if ctnWrDeclOf(bmCstr.ix[ci]) == d && !ctnCutKills(bmCstr.ix[ci]) {
      const bg = substTyDeep(bmCstr.got[ci], bNames, bTys)
      const bw = substTyDeep(bmCstr.want[ci], bNames, bTys)
      let bc = bmCstr.ctx[ci]
      if bc >= 0 { bc = substTyDeep(bc, bNames, bTys) }
      if !tyHasHole(bg) && !tyHasHole(bw) {
        if !bmArgPred(bmCstr.form[ci], bg, bw, bmCstr.ix[ci]) {
          const m = bmArgMsg(bmCstr.form[ci], bmCstr.label[ci], bg, bw, bc)
          tErr(m + at, srcExpr)
          return 0
        }
      }
    }
    ci = ci + 1
  }
  ci = 0
  while ci < letCstr.got.length {
    if ctnWrDeclOf(letCstr.ix[ci]) == d && !ctnCutKills(letCstr.ix[ci]) {
      const lg = substTyDeep(letCstr.got[ci], bNames, bTys)
      const lw = substTyDeep(letCstr.want[ci], bNames, bTys)
      if !tyHasHole(lg) && !tyHasHole(lw) {
        if !assignableExpr(letCstr.ix[ci], lg, lw) {
          const m = letAssignMsg(letCstr.ix[ci], lg, lw, letCstr.name[ci], -1)
          tErr(m + at, srcExpr)
          return 0
        }
      }
    }
    ci = ci + 1
  }
  0
}

// `ctnWrittenCstrsAt` for argument `li` of a generic call, whose parameter's type variables the
// bindings `bNames`/`bTys` left on another function's type variable: each is closed at the type
// an argument binds it to that carries none, as the call instances it there (D10150).
export function ctnWrittenCstrsAtCall(
  params: i32[],
  args: i32[],
  li: i32,
  bNames: string[],
  bTys: i32[],
) {
  if li >= args.length || li >= params.length || args[li] < 0 { return 0 }
  const cNames: string[] = []
  const cTys: i32[] = []
  let j = 0
  while j < args.length && j < params.length {
    if args[j] >= 0 {
      const jn: string[] = []
      const jt: i32[] = []
      bindGenWalk(params[j], nodeTyOf(args[j]), jn, jt)
      let k = 0
      while k < jn.length {
        const t = jt[k]
        if (
          t >= 0
          && !tyHasTyVar(t)
          && !tyHasHole(t)
          && !strListHas(cNames, jn[k])
        ) {
          cNames.push(jn[k])
          cTys.push(widenLitTy(t))
        }
        k = k + 1
      }
    }
    j = j + 1
  }
  if cNames.length == 0 { return 0 }
  const fin = substTyDeep(substTyDeep(params[li], cNames, cTys), bNames, bTys)
  if tyHasTyVar(fin) || tyHasHole(fin) { return 0 }
  ctnWrittenJudge(args[li], nodeTyOf(args[li]), fin)
}

// The `let`/`const` declaration whose binding `ix` delivers: read directly, or handed back by
// every return of a top-level function declaring no type parameter that `ix` calls (D10121).
function ctnDeliveredDeclOf(ix: i32): i32 {
  const d = ctnBindingDeclOf(ix)
  if d >= 0 { return d }
  const c = nodeAt(parenPeelIx(ix))
  if !(c is Call) || c.callFn < 0 || c.callFn >= P.nodes.length { return -1 }
  const cf = nodeAt(parenPeelIx(c.callFn))
  if !(cf is Ident) { return -1 }
  const fx = fnDeclIx[cf.identName] ?? -1
  if (
    fx < 0
    || fx >= P.nodes.length
    || identFnDeclOf(parenPeelIx(c.callFn)) != fx
  ) {
    return -1
  }
  const fd = nodeAt(fx)
  if !(fd is FuncDecl) || fd.fnTyParams.length > 0 || fd.fnBody < 0 {
    return -1
  }
  const rv: i32[] = []
  collectRetValues(fd.fnBody, rv)
  let out = -1
  for v in rv {
    const vd = ctnBindingDeclOf(v)
    if vd < 0 || (out >= 0 && vd != out) { return -1 }
    out = vd
  }
  out
}

// The name declaration `d` binds, or "" when it is no `let`/`const`.
function ctnDeclName(d: i32): string {
  const n = nodeAt(d)
  if n is LetDecl { return n.letName }
  ""
}

// Every constraint `owner`'s body deferred, adjudicated at the bindings `bNames`/`bTys` and
// reported at `srcExpr`, as a direct call of `who` reports them.
function declCstrsAtBinding(
  bNames: string[],
  bTys: i32[],
  srcExpr: i32,
  owner: i32,
  who: string,
) {
  const noN: string[] = []
  const noNo: i32[] = []
  const noNode: i32[] = []
  validateBinCstrs(bNames, bTys, srcExpr, owner, who, noN, noNo, noNode)
  validatePrintCstrs(bNames, bTys, srcExpr, owner, who)
  validateNestCstrs(bNames, bTys, srcExpr, owner, who)
  validateArgCstrs(bNames, bTys, srcExpr, owner, noN, noNode)
  validateRetCstrs(bNames, bTys, srcExpr, owner, who)
  validateLetCstrs(bNames, bTys, srcExpr, owner, who)
  validateBmCstrs(bNames, bTys, srcExpr, owner, who)
  validateMemCstrs(bNames, bTys, srcExpr, owner, who, noN, noNo, noNode)
  validateUfcsCstrs(bNames, bTys, srcExpr, owner, who)
  0
}

// A top-level function `decl` with un-annotated parameters, named at `srcExpr` and typed
// `srcTy`, instanced at the concrete function type `inst`: its body's deferred constraints are
// adjudicated there, as a direct call at those argument types adjudicates them (D6190).
export function holeDeclCstrsAt(
  srcExpr: i32,
  decl: i32,
  srcTy: i32,
  inst: i32,
) {
  const bNames: string[] = []
  const bTys: i32[] = []
  holeDeclCstrsBind(srcExpr, decl, srcTy, inst, bNames, bTys)
}

// `holeDeclCstrsAt`, leaving in `bNames`/`bTys` the holes that instance binds, its parameters'
// and those its constraints derive from them, as a returned element (D6301).
export function holeDeclCstrsBind(
  srcExpr: i32,
  decl: i32,
  srcTy: i32,
  inst: i32,
  bNames: string[],
  bTys: i32[],
) {
  if srcTy < 0 || inst < 0 || decl < 0 || decl >= P.nodes.length { return 0 }
  const fd = nodeAt(decl)
  const s = tyAt(srcTy)
  const d = tyAt(inst)
  if !(fd is FuncDecl) || !(s is TyFunc) || !(d is TyFunc) { return 0 }
  if (
    fd.fnTyParams.length > 0
    || s.fnParamTypes.length != d.fnParamTypes.length
  ) {
    return 0
  }
  let i = 0
  while i < s.fnParamTypes.length {
    if tyIsHole(s.fnParamTypes[i]) {
      bindGenWalk(s.fnParamTypes[i], d.fnParamTypes[i], bNames, bTys)
    }
    i = i + 1
  }
  if bNames.length == 0 { return 0 }
  const modeWas = substNestMode
  const strictWas = cstrOwnedStrict
  substNestModeSet(SUBST_DECLARED)
  cstrOwnedStrictSet(true)
  declCstrsAtBinding(bNames, bTys, srcExpr, decl, fd.fnName)
  cstrOwnedStrictSet(strictWas)
  substNestModeSet(modeWas)
  0
}

// A function value `who` whose parameters are inference holes (an un-annotated function, or a
// lambda bound to an un-annotated `const`) delivered at the concrete function type `dstTy`: its
// holes take that type's parameters and its body's demands on them are judged there, as a
// direct call through it would judge them (D5932).
function holeFnValueCstrsAt(srcExpr: i32, srcTy: i32, dstTy: i32, who: string) {
  if dstTy < 0 || srcTy < 0 { return 0 }
  let dt = dstTy
  const dn = tyAt(dt)
  if dn is TyNullable { dt = dn.nInner }
  if dt < 0 || tyHasTyVar(dt) || tyHasHole(dt) { return 0 }
  const s = tyAt(srcTy)
  const d = tyAt(dt)
  if !(s is TyFunc) || !(d is TyFunc) { return 0 }
  if s.fnParamTypes.length != d.fnParamTypes.length { return 0 }
  let anyHole = false
  for pt in s.fnParamTypes {
    if tyIsHole(pt) { anyHole = true }
  }
  if !anyHole { return 0 }
  holeFnDeliveryDemands(srcTy, dt, srcExpr, "`" + who + "`")
  0
}

// Un-annotated function `decl` delivered by name at the concrete function type `dstTy`: every
// constraint its body deferred is judged at that type's parameters, as a direct call there is,
// so a member read the parameter type lacks is refused at the delivery (D8980).
function holeDeclValueCstrsAt(
  srcExpr: i32,
  decl: i32,
  srcTy: i32,
  dstTy: i32,
  who: string,
) {
  let dt = dstTy
  const dn = tyAt(dt)
  if dn is TyNullable { dt = dn.nInner }
  if dt < 0 || tyHasTyVar(dt) || tyHasHole(dt) { return 0 }
  const fd = nodeAt(decl)
  if !(fd is FuncDecl) || fd.fnTyParams.length > 0 { return 0 }
  if fd.fnName != "" && (fnDeclIx[fd.fnName] ?? -1) == decl {
    return holeDeclCstrsAt(srcExpr, decl, srcTy, dt)
  }
  // A lambda owns no constraint of its own, so its holes are judged over the constraints its
  // own body recorded: another delivery of the same lambda is not part of it.
  const s = tyAt(srcTy)
  const d = tyAt(dt)
  if !(s is TyFunc) || !(d is TyFunc) { return 0 }
  if s.fnParamTypes.length != d.fnParamTypes.length { return 0 }
  const bNames: string[] = []
  const bTys: i32[] = []
  let i = 0
  while i < s.fnParamTypes.length {
    if tyIsHole(s.fnParamTypes[i]) {
      bindGenWalk(s.fnParamTypes[i], d.fnParamTypes[i], bNames, bTys)
    }
    i = i + 1
  }
  if bNames.length == 0 { return 0 }
  const modeWas = substNestMode
  const declWas = substNestDecl
  substNestModeSet(SUBST_NESTED)
  substNestDeclSet(decl)
  declCstrsAtBinding(bNames, bTys, srcExpr, CSTR_NODECL, who)
  substNestModeSet(modeWas)
  substNestDeclSet(declWas)
  0
}

// Each un-annotated function an `if` / `match` the value `a` may be read from chooses, judged at
// the closed parameter types `pts` as a direct call of it there is: a call through the choice is
// typed by its first arm alone (D13740).
export function holeChoiceArmCstrsAt(a: i32, pts: i32[]) {
  const wp: i32[] = []
  for p in pts {
    if p < 0 || tyHasTyVar(p) { return 0 }
    wp.push(widenLitTy(p))
  }
  const arms: i32[] = []
  const decls: i32[] = []
  holeChoiceArmsOf(a, arms, decls)
  if arms.length == 0 { return 0 }
  const inst = mkFuncTy(wp, TY_I32)
  const d0 = T.diags.length
  let k = 0
  while k < arms.length && T.diags.length == d0 {
    const fd = nodeAt(decls[k])
    let who = ""
    if fd is FuncDecl { who = fd.fnName }
    holeDeclValueCstrsAt(arms[k], decls[k], nodeTyOf(arms[k]), inst, who)
    k = k + 1
  }
  0
}

// A `u8` storage slot, the only position `u8` is legal in, takes any `i32` value: the store
// truncates to the low 8 bits. The one refusal is a non-negative integer literal past 255.
// `assignable(i32, u8)` stays false, so an `i32[]` still cannot flow into a `u8[]`.
function assignableU8Slot(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  if srcExpr >= 0 {
    const u8e = nodeAt(srcExpr)
    if u8e is Paren { return assignableExpr(u8e.parInner, srcTy, dstTy) }
    if u8e is NumLit {
      if numLexIsFloat(u8e.numText) { return false }
      if u8LexValue(u8e.numText) > 255 {
        if !inferQuiet {
          tErr(
            "the literal "
              + u8e.numText
              + " does not fit a `u8` element (0..255) — a computed value truncates to its low 8 bits, but a literal this size is a mistake the compiler can see",
            srcExpr,
          )
        }
        // Reported here and answered true, the same discipline `objShapeAdapterlessErr` follows:
        // the position is otherwise well-typed, so a second "cannot assign" from the caller
        // would contradict this message.
        return true
      }
      return true
    }
  }
  const u8s = primNameOf(srcTy)
  return u8s == "i32" || u8s == "u8"
}

// A literal source `srcExpr` meeting `dstTy` after the type-level answer said no: a bare
// literal flows wherever its literal type is a member (`"a"` into `"a" | "b"`), and an
// object or array literal adapts field- or element-wise. False when no literal rule applies.
function assignableLitExpr(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  const lTy = litTyOfExpr(srcExpr)
  if lTy >= 0 {
    if assignable(lTy, dstTy) { return true }
  }
  // An object literal checks field-wise against a literal-bearing object target, so a field's
  // bare literal can match a literal-union field (`{tag: "circle", r: 5}` against
  // `{tag: "circle" | "square", r: i32}`).
  const e = nodeAt(srcExpr)
  match e {
    Paren => {
      const pok = assignableExpr(e.parInner, srcTy, dstTy)
      // A wrapping paren takes the f32 list its literal adopted, so both nodes read alike.
      if pok && !inferQuiet && f32ListUnder(srcExpr, e.parInner) {
        nodeTySet(srcExpr, nodeTyIxOf(e.parInner))
      }
      return pok
    }
    ObjLit => {
      const s = tyAt(srcTy)
      if s is TyObj {
        // A nullable struct target (`S | null`, or a `V?` map value) peels its wrapper so an object
        // literal still adapts field-wise into the inner struct — the ObjLit dual of the ArrayLit
        // peel below. The peel iterates: a nullable-value map slot stacks two wrappers, and a
        // single unwrap leaves the literal against `S | null`.
        let dtix = dstTy
        let dPeel = true
        while dPeel {
          const dNW = tyAt(dtix)
          if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
        }
        const d = tyAt(dtix)
        match d {
          TyObj => {
            return assignableObjLitFields(srcExpr, srcTy, dstTy, e, s, dtix, d)
          }
          // A struct literal flowing into a union adopts the first struct arm it adapts into
          // field-wise (`{f: 97.5}` into `{f: f32} | {w: i32}`). The emitter already boxes a struct
          // literal into a union slot at a direct binding; this is the checker seam that lets a
          // widening field reach that same rep. The concrete arm is recorded on the literal node.
          TyUnion => {
            return assignableObjLitUnion(srcExpr, srcTy, dstTy, e)
          }
          // no other target adapts an object literal
          TyPrim | TyErr | TyFunc | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
        }
      }
    }
    // An array literal checks element-wise against the target's element type, so a bare element
    // adapts exactly as it would at a binding — the array analogue of the ObjLit recursion above.
    // This subsumes the scalar float-literal into `f32[]` rule at any element type and nesting
    // depth. An empty `[]` fits any element; a non-literal element still rejects a lossy demote.
    ArrayLit => {
      // A map value or niche slot is `V?` (`{[string]: f32[]}` seeds `f32[]?`) — peel the nullable
      // wrappers so a literal array still adapts into the inner element type; a nullable-value map
      // slot stacks two, so the peel iterates like the ObjLit one above.
      let dtix = dstTy
      let dPeel = true
      while dPeel {
        const dNW = tyAt(dtix)
        if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
      }
      const d = tyAt(dtix)
      match d {
        TyArray => {
          return assignableArrLitElems(srcExpr, srcTy, dstTy, e, dtix, d)
        }
        // An array literal flowing into a union adopts the first array arm it adapts into
        // element-wise (`["a"]` into `K0[] | {w: i32}`, `[1.5]` into `f32[] | i64`) — the array dual
        // of the ObjLit union-arm adoption above. The concrete arm is recorded on the literal node so
        // the emitter classifies the list with the arm's element rep, not the literal's softened one.
        TyUnion => {
          return assignableArrLitUnion(srcExpr, srcTy, d)
        }
        // no other target adapts an array literal
        TyPrim | TyErr | TyObj | TyFunc | TyNullable | TyMap | TyVar | TyLit | TyNeg => {}
      }
    }
    // no other expression has a literal rule
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// The list member of union `dstTy` that the list literal `srcExpr` is delivered to: its own type
// if a member, else the first list member it fits, looking through `| null` and nested unions;
// -1 where `srcExpr` is no list literal or no member takes it. Asked quietly, records nothing.
function listArmOfUnionFit(srcExpr: i32, srcTy: i32, dstTy: i32): i32 {
  if !(nodeAt(parenPeelIx(srcExpr)) is ArrayLit) { return -1 }
  const own = listArmIn(srcExpr, srcTy, dstTy, true, 6)
  if own >= 0 { return own }
  const ex = listLitExactArm(dstTy, srcExpr)
  if ex >= 0 { return ex }
  listArmIn(srcExpr, srcTy, dstTy, false, 6)
}

// One pass of `listArmOfUnionFit`: `exact` asks for `srcTy` itself, else the first list member
// `srcExpr` fits. `depth` bounds the walk through nested unions.
function listArmIn(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
  exact: boolean,
  depth: i32,
): i32 {
  const d = nonNullTy(dstTy)
  if depth <= 0 || d < 0 { return -1 }
  const u = tyAt(d)
  if !(u is TyUnion) { return -1 }
  for m in u.uMembers {
    if m >= 0 {
      if exact && m == srcTy { return m }
      if !exact && tyAt(m) is TyArray && assignableExpr(srcExpr, srcTy, m) {
        return m
      }
      const inner = listArmIn(srcExpr, srcTy, m, exact, depth - 1)
      if inner >= 0 { return inner }
    }
  }
  -1
}

// Whether `srcExpr` (of type `srcTy`) delivers to `dstTy`; a delivery that holds where stamps
// stand records `dstTy` as the node's contextual type.
export function assignableExpr(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  const ok = assignableExprIn(srcExpr, srcTy, dstTy)
  if ok { recordCtxTy(srcExpr, dstTy) }
  ok
}

function assignableExprIn(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  lbiNoteDelivery(srcExpr, dstTy, nlAsgTgt)
  nolNoteDelivery(srcExpr, dstTy)
  if fsbName.length > 0 && !inferQuiet && srcExpr >= 0 {
    fsbNoteFnDelivery(srcExpr, dstTy)
  }
  // A number union converted to its destination still hands over its literals there (`x ?? 5`).
  if numUnionMinted && numUnionConverts(srcTy, dstTy) && !njExprHeld(srcExpr) {
    numLitAdoptDeep(srcExpr, dstTy, 6)
    return true
  }
  if litNumUnionConverts(srcTy, dstTy) && !njExprHeld(srcExpr) {
    numUnionMinted = true
    numLitAdoptDeep(srcExpr, dstTy, 6)
    return true
  }
  if srcExpr >= 0 && dstTy >= 0 {
    const cse = nodeAt(srcExpr)
    if cse is NumLit || cse is Unary || cse is Paren {
      if cexDeliver(srcExpr, dstTy) { return true }
    }
  }
  // A value already of its destination's type holds its literals at that width.
  if srcTy != dstTy {
    if numLitReadopt(srcExpr, srcTy, dstTy) { return true }
    numLitAdoptDeep(srcExpr, dstTy, 6)
  }
  // A bare `{}` completes against a record destination; a required field it omits is refused
  // here, in words, instead of as the site's generic mismatch (D2223).
  if bareBraceDeliver(srcExpr, dstTy, 8, true) { return true }
  // A generic function value meeting a concrete function type is decided by instantiation inside
  // `assignable`'s `TyFunc` case (`genericFnAssignable`), so it governs nested positions like an
  // array element too, not just this expression-level entry.
  recordElemRepArrayLit(srcExpr, dstTy, 6)
  // Only a delivery that holds builds the literal at its destination: one refused (`{r: 1.5}`
  // or `{r: null}` meeting `{r: i32}` in a join) stays at its own type.
  const lwd = listFieldWidenDst(srcExpr, dstTy)
  const nh = stampsStand()
    && srcExpr >= 0
    && tyHasNullHole(nodeTyIxOf(srcExpr), 6)
  if lwd >= 0 || nh {
    const q = inferQuiet
    inferQuiet = true
    quietDepth = quietDepth + 1
    const dOk = assignableExpr(srcExpr, srcTy, dstTy)
    quietDepth = quietDepth - 1
    inferQuiet = q
    if dOk {
      recordNullHoleObjAdopt(srcExpr, dstTy, 6)
      if lwd >= 0 { recordRepTyAdopt(srcExpr, lwd, 6) }
    }
  }
  // A hex / binary / octal literal is a bit pattern of the destination's width, and this seam is
  // where every binding / argument / return / field / element / store position delivers one.
  if srcTy == TY_I32 && litTreeAdoptDst(parenPeelIx(srcExpr), dstTy) >= 0 {
    return true
  }
  if radixLitAdoptDst(srcExpr, dstTy) == 2 { return true }
  // Rep sidecar: an ObjLit/ArrayLit reaching an unresolved empty-collection hole (`{nodes: []}`)
  // or a destination union is stamped with the destination so the emitter keys that shape. Only
  // a delivery that holds is stamped: a refused one (`{r: null}` meeting `{r: K}` in a join)
  // stays at its own type. Writes only `nodeRepTyIx`.
  const rtStamp = stampsStand()
    && srcExpr >= 0
    && (tyReachesEmptyHole(srcTy, 8)
    || tyReachesUnion(dstTy, 8)
    || litAtDstStorage(srcExpr, dstTy)
    || deliversNullLit(srcExpr))
  if rtStamp && (repStampableLit(srcExpr) || deliversNullLit(srcExpr)) {
    const q = inferQuiet
    inferQuiet = true
    quietDepth = quietDepth + 1
    const sOk = assignableExpr(srcExpr, srcTy, dstTy)
    const at = if sOk { listArmOfUnionFit(srcExpr, srcTy, dstTy) } else { -1 }
    quietDepth = quietDepth - 1
    inferQuiet = q
    if sOk { recordRepTyAdopt(srcExpr, if at >= 0 { at } else { dstTy }, 6) }
  }
  // A generic function named at a closed function type (an argument, a store, a field, a
  // return) is built at that type.
  adoptFnNameAt(srcExpr, dstTy)
  fvaValueRowNote(srcTy, dstTy)
  fvaBindingRowsNote(srcExpr, dstTy)
  // The flow hook for the un-annotated-parameter solve. It sits above the `assignable`
  // short-circuit because a hole source always returns there, so this is the only point in the
  // function a hole reaches — and every binding / argument / return / field / element / store
  // position flows through here. Inert unless the parameter-solve probe is running.
  noteHoleFlow(srcTy, dstTy, srcExpr)
  if !inferQuiet && narListDeliveryErr(srcExpr, srcTy, dstTy) { return true }
  if assignable(srcTy, dstTy) {
    if !inferQuiet && srcExpr >= 0 { genFnValueCstrs(srcExpr, srcTy, dstTy) }
    if fvaAdapt(srcExpr, srcTy, dstTy) { return true }
    // The constraint probe records a hole delivery's pin as well, so a caller whose body is
    // checked before this one still re-asks it at its own pins.
    if cstrProbe && srcExpr >= 0 { rcwPinProbe(srcExpr, srcTy, dstTy) }
    // The object-shape floor. `assignable` accepts structural subtyping between two object shapes
    // and the emitter has no adapter for it (`objShapeAdapterless`), so the pair would reach codegen
    // and fail there on a file `vl check` reports clean. It belongs at this seam, the one every
    // delivery flows through. Reported here and answered true, the program being type-valid.
    if !inferQuiet && srcExpr >= 0 {
      // The `Writable` floor (D793). A covariant list assignment whose value is written through
      // cannot be lowered by either answer the language has — an alias admits a type-confused read,
      // and a converting copy gives one handle a private list. The assignment itself is illegal,
      // reported at this seam and answered true, the program being type-valid.
      const cwCode = covarWriteThrough(srcExpr, srcTy, dstTy)
      if cwCode == 1 {
        covarWriteThroughErr(srcExpr, srcTy, dstTy)
        return true
      }
      // D853 — the second arm is a different unsoundness and says so. Two declared unions over one
      // written-through list share one box, so nothing is copied and "the two element storages
      // differ" would be false. The message names the arms rather than the storages.
      if cwCode == 2 {
        covarTwoUnionsErr(srcExpr, srcTy, dstTy)
        return true
      }
      noteRefListView(srcExpr, srcTy, dstTy)
      recordListCopy(srcExpr, srcTy, dstTy)
      // D2060 — the record twin: a field widened by this delivery is shared with the source,
      // so it is legal only where nothing the delivery reaches writes it.
      rcwPend(srcExpr, srcTy, dstTy)
      if mapDeliveryMayRecord(srcExpr, srcTy, dstTy) {
        recordMapUnbox(srcExpr, srcTy, dstTy, 8)
      } else if tyWideUnionMinted {
        recordListWidenRetag(srcExpr, srcTy, dstTy)
      }
      if !wsSuppress && objShapeAdapterlessAt(srcExpr, srcTy, dstTy) {
        objShapeAdapterlessErr(srcExpr, srcTy, dstTy)
      } else if srcTy != dstTy {
        recPend(srcExpr, srcTy, dstTy, srcExpr)
        recordRecCopy(srcExpr, srcTy, dstTy)
      } else if tyAt(srcTy) is TyObj || tyAt(srcTy) is TyArray {
        recOwnPend(srcExpr, srcTy)
      }
    }
    return true
  }
  if !inferQuiet && srcExpr >= 0 && recAdForce(srcExpr, srcTy, dstTy) {
    return true
  }
  // Nominal newtype: a syntactic literal is brand-polymorphic and adopts the destination's brand
  // (`const e: EntityId = 1`). A literal has no prior identity, so it cannot be the confusion a
  // newtype exists to catch. Only the destination's own brand is waived, by retrying against the
  // base index; an object literal needs no arm, its field-wise block re-applying the rule per field.
  if nomLitAdopts(srcExpr, srcTy, dstTy) { return true }
  // Function value into a void slot: a `(P…) => T` value is assignable where `(P…) => void` is
  // expected — the coercion that keeps "extract the inline lambda to a named function" from breaking
  // the call that worked. Keyed on the expected type's return being void, and granted only for the
  // set `synthVoidTwins` can mint a capture-free void twin for; other values keep the mismatch.
  if fnValVoidCoerce(srcExpr, srcTy, dstTy) { return true }
  if primNameOf(dstTy) == "u8" {
    return assignableU8Slot(srcExpr, srcTy, dstTy)
  }
  // A literal re-encodes exactly at f32, so it flows into any destination whose f32 position it
  // fits: a bare `f32`, a nullable `f32?`, or an f32 member of a union. An arbitrary f64 or i32
  // value is not covered. Destination first, and that order is load-bearing for compile time: the
  // integer half folds the lexeme into a bignum, while `dstAdmitsF32` is a short arena walk.
  if dstAdmitsF32(dstTy) {
    if isF32AdoptingLitExpr(srcExpr) {
      cexFloatUse(srcExpr)
      return true
    }
    if f32LitTailsAdopt(srcExpr, dstTy) { return true }
  }
  // The same grant one width up, and only its integer half: an i32-typed literal already rides
  // the `i32 -> f64` lattice edge, so what this admits is the literals between 2^31 and 2^53 that
  // type `i64` and would otherwise meet the lossy `i64 -> f64` refusal. D1890.
  if dstAdmitsF64(dstTy) {
    if isExactF64IntLitExpr(srcExpr) {
      cexFloatUse(srcExpr)
      return true
    }
    // A join that is `i64` only because one of its literals outgrew i32 (D5712).
    if f64ExactJoinLeaves(srcExpr, srcTy, dstTy) { return true }
  }
  // A `const` literal, or a join of them, read as `string`: a literal-typed destination takes it at
  // the literal type it is, in a list or object literal exactly as at an argument (D2157).
  if srcExpr >= 0 && srcExpr < wideLitByNode.length {
    const uw = wideLitByNode[srcExpr]
    if uw >= 0 && uw != srcTy {
      if assignable(uw, dstTy) { return true }
    }
  }
  if srcExpr >= 0 { return assignableLitExpr(srcExpr, srcTy, dstTy) }
  false
}

// An object literal `e` of shape `s` delivered field-wise into the record `d` (`dtix`, `dstTy`
// with its nullable wrappers peeled): an omitted field must admit null, a written one adapts
// literal-aware. A field the record does not declare is refused at the literal, answered true.
function assignableObjLitFields(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
  e: ObjLit,
  s: TyObj,
  dtix: i32,
  d: TyObj,
): boolean {
  const dnames = d.objFieldNames
  const dtys = d.objFieldTypes
  let i = 0
  let ok = true
  while i < dnames.length {
    const sft = objFieldType(s, dnames[i])
    if sft < 0 {
      // Completion coercion: an object literal may omit a field whose declared type admits
      // null — the field is materialized as `null` at construction. A non-nullable omitted
      // field is still required. Scoped to this expression-aware path, not to general
      // structural assignability, so it never widens through a container or variance.
      if !tyAdmitsNull(dtys[i]) { ok = false }
    } else {
      // The field's value expression, for the literal-aware recursion.
      let fexpr = -1
      const fl = e.objFields
      let fi = 0
      while fi < fl.length {
        const fn = nodeAt(fl[fi])
        if fn is FieldInit {
          if fn.fiName == dnames[i] { fexpr = fn.fiValue }
        }
        fi = fi + 1
      }
      if !assignableExpr(fexpr, sft, dtys[i]) { ok = false }
    }
    i = i + 1
  }
  // Rep sidecar: a field-wise-adopted ObjLit builds the destination struct rep (a boxed
  // union field, an i64/f32 field, an omitted nullable field), so record it on the literal
  // node and the emitter's row resolver keys the shape it builds, not the self-inference.
  if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
  // A field the record does not declare is refused where the literal is written, as at
  // a destination `assignable` accepts by width (#1460). Reported and answered true.
  if (
    ok
    && bareBraceSpec == 0
    && !inferQuiet
    && srcExpr != argLitAt
    && !recAdPinInit
    && objLitSetsUndeclared(e, dtix)
  ) {
    if !objLitHasDupKey(srcExpr) {
      objLitUndeclaredErr(srcExpr, srcTy, dtix, "")
    }
  }
  return ok
}

// An object literal `e` delivered into the union `dstTy`: the first struct arm it adapts into
// field-wise, preferring one that declares every field it sets, is recorded on the literal.
// False when no arm adapts.
function assignableObjLitUnion(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
  e: ObjLit,
): boolean {
  // Flattened, because a union member may itself be a union: `type Shape = Circle | Rect`
  // used as an arm of `Shape | ParseError` leaves a `TyUnion` in `uMembers`, which the
  // `mt is TyObj` test skips. Each candidate is still gated by `unionArmBoxSafe` and still
  // recorded as the concrete arm; canon's union-alias flatten covers both spellings.
  const members: i32[] = []
  flattenVariantsInto(dstTy, members)
  // An arm declaring every field the literal sets is preferred; an arm that would drop
  // one is taken only when no other accepts, and then refused as at a record (#1460).
  let mi = 0
  let pass = 0
  while pass < 2 {
    mi = 0
    while mi < members.length {
      const mt = tyAt(members[mi])
      if (
        mt is TyObj
        && unionArmBoxSafe(members[mi])
        && objLitSetsUndeclared(e, members[mi]) == (pass == 1)
      ) {
        bareBraceSpecSet(bareBraceSpec + 1)
        const armOk = assignableExpr(srcExpr, srcTy, members[mi])
        bareBraceSpecSet(bareBraceSpec - 1)
        if armOk && pass == 1 {
          if (
            !inferQuiet
            && bareBraceSpec == 0
            && !recAdPinInit
            && !objLitHasDupKey(srcExpr)
          ) {
            objLitUndeclaredErr(
              srcExpr,
              srcTy,
              members[mi],
              " (reached through "
                + tyToStr(srcTy)
                + " into "
                + tyToStr(dstTy)
                + ")",
            )
          }
          return true
        }
        if armOk {
          if !inferQuiet {
            while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
            nodeTySet(srcExpr, members[mi])
            // Rep sidecar: the struct literal builds the concrete arm struct's rep — record
            // it, recursing into fields, for the row resolver.
            recordRepTyAdopt(srcExpr, members[mi], 6)
          }
          return true
        }
      }
      mi = mi + 1
    }
    pass = pass + 1
  }
  false
}

// An array literal `e` delivered element-wise into the list `d` (`dtix`, `dstTy` with its
// nullable wrappers peeled); an atom, niche-nullable, joined or converted element list takes
// `dtix` as the literal's own type.
function assignableArrLitElems(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
  e: ArrayLit,
  dtix: i32,
  d: TyArray,
): boolean {
  let i = 0
  let ok = true
  const cexWas = cexConverted
  cexConverted = false
  while i < e.arrElems.length {
    const sp = nodeAt(e.arrElems[i])
    if sp is Spread {
      // A spread hands over its list's elements, each delivered as one element (D3253).
      let spe = tyArrayElemIx(nodeTyIxOf(sp.spdArg))
      if spe >= 0 && tyHasHole(spe) && litPinN.length > 0 {
        spe = substTyDeep(spe, litPinN, litPinT)
      }
      if spe >= 0 && !assignable(spe, d.aElem) { ok = false }
    } else if (
      !assignableExpr(e.arrElems[i], litElemSrcTy(e.arrElems[i], srcTy), d.aElem)
    ) {
      ok = false
    }
    i = i + 1
  }
  // A whole float constant an element became is an integer, so the list is built at the
  // destination's element type.
  const cexElem = cexConverted
  cexConverted = cexWas || cexElem
  // Context adoption (atom lists): a literal array accepted by a literal-union element target
  // is that atom list (`const ks: VK[] = ["aa", "bb"]`), so the destination array type is
  // recorded on the literal node and the emitter classifies it as the i32 atom-id list. The
  // niche-nullable scalar elements record the same way — `[null]` carries no other signal.
  if (
    ok
    && !inferQuiet
    && (tyIsLitUnion(d.aElem)
      || tyIsNicheNulScalarElem(d.aElem)
      || arrLitJoinUnionElem(srcExpr, dtix)
      || arrLitSoftenedUnionElem(srcExpr, dtix)
      || cexElem
      || f32ElemsAdoptedOver(srcExpr, d.aElem))
  ) {
    if srcExpr < nodeTyIx.length { nodeTySet(srcExpr, dtix) }
  }
  // Rep sidecar: a literal array adopted element-wise (a struct-element list widened, an
  // i64/f32 element) builds the destination element rep — recurse into the elements so each
  // element ObjLit resolves the shape the emitter builds.
  if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
  return ok
}

// An array literal delivered into the union `d`: the list arm whose elements it has exactly,
// else the first it adapts into, is recorded on the literal (`[1, 2]` into `f64[] | i32[]` is
// an `i32[]`). False when no arm adapts.
function assignableArrLitUnion(srcExpr: i32, srcTy: i32, d: TyUnion): boolean {
  const ex = listLitExactMember(d.uMembers, srcExpr)
  if ex >= 0 && assignableArrLitArm(srcExpr, srcTy, ex) { return true }
  for m in d.uMembers {
    if m >= 0 && tyAt(m) is TyArray && assignableArrLitArm(srcExpr, srcTy, m) {
      return true
    }
  }
  false
}

// Delivers list literal `srcExpr` to list arm `m`, recording the arm as its type where it fits.
function assignableArrLitArm(srcExpr: i32, srcTy: i32, m: i32): boolean {
  // An `f32[]` arm adopts like any other list arm: the f32-list value atom (kind 12) gives the
  // box a real rep, and the emitter's coerce re-encodes the literal's f64 elements at f32.
  bareBraceSpecSet(bareBraceSpec + 1)
  const armOk = assignableExpr(srcExpr, srcTy, m)
  bareBraceSpecSet(bareBraceSpec - 1)
  if armOk && !inferQuiet {
    while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
    nodeTySet(srcExpr, m)
    // Rep sidecar: record the concrete array arm, recursing into elements, so the row
    // resolver keys the arm the checker picked.
    recordRepTyAdopt(srcExpr, m, 6)
  }
  armOk
}

// ── the top-level split lives in `tyname.tyTopLevelSplit` ───────────────────
// It cannot live in `emit_base.vl`, which imports this file — a call from here would cycle the
// module graph. `tyname.vl` is the zero-import leaf that already holds `tyTopIndexOf`.

// The expression-aware retry for a slot checked with the bare structural `assignable` — the
// map `.set` key. `assignableExpr` covers both scalar-literal brand adoption and object-literal
// field-wise adaptation, which `nomLitAdopts` alone cannot supply. Gated on the destination
// actually carrying a brand, so a brand-free program keeps its bare structural check unchanged.
function nomSlotAccepts(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if nwTyIxs.length == 0 { return false }
  if srcExpr < 0 { return false }
  if !tyReachesBrand(dstTy, 6) { return false }
  assignableExpr(srcExpr, srcTy, dstTy)
}

// —— the mixed-union literal-run regroup, canon's side ——
// `tyToNameGo`'s union arm regroups the flattened string-literal members of a mixed
// union back into their registered alias (`K0 | f64` renders `K0|f64`); canon must spell the
// same union the same way, so this classifies member spellings by the same three-way rule the renderer applies to arena members.

// —— the subsumed-arm collapse, canon's side ——
// The arena drops a union arm that adds no values; canon must drop the same arm or the two
// producers agree about the type and disagree about the rep — the arena saying `string`
// while canon spells `Kind|string` reserves a union box for a plain-string binding (D1048).

// The predicate that arm asks, in one home with a sharper consequence: the pin has to ask
// exactly what the body asked or it disagrees with the direct spelling in one of two ways.
// Asking the plain predicate where the arm asks the expression invents a false reject — the
// float-literal-into-f32 rule lives at the expression seam (D551).
export function bmArgPred(form: i32, got: i32, want: i32, argIx: i32) {
  if form == BM_PUSH || form == BM_SETVAL || form == BM_KEYMUST {
    return assignableExpr(argIx, got, want)
  }
  if form == BM_SETKEY || form == BM_ADDKEY {
    // The expression form first: a MEMBER literal is a legal key of a literal-union-keyed
    // map or set, and its own type is the member, not the `string` `checkNode` hands back (D1748).
    if assignableExpr(argIx, got, want) { return true }
    return nomSlotAccepts(argIx, got, want)
  }
  assignable(got, want)
}

// `argCstrFits` for demand `ci` at a pin that knows its argument nodes: a hole callee's scalar
// argument whose origin node is known is asked the direct call's own question of that node, so
// a literal adopts the parameter's width and a `boolean` literal is refused as it is directly.
function argCstrFitsAt(
  rat: i32,
  rexp: i32,
  ci: i32,
  hNames: string[],
  hArgNode: i32[],
) {
  const form = argCstr.form[ci]
  if form <= 0 { return argCstrFits(rat, rexp, form) }
  const org = holeArgOriginNode(ci, hNames, hArgNode)
  if org < 0 { return argCstrFits(rat, rexp, form) }
  if !scalarPrimPair(rat, rexp) {
    // A composite side is asked the same question of the node, or a list reaches a scalar
    // parameter through `call_ref` unconverted (D5790).
    if tyHasHole(rat) || tyHasHole(rexp) { return argCstrFits(rat, rexp, form) }
    // An argument whose type is already an earlier diagnostic's error is not refused again.
    if tyMentionsErr(rat, 8) { return true }
    // A literal already retyped for another of the hole's demands is that type now; it is not
    // rebuilt a second time for this one.
    // A forwarder's literal some caller copied at this type fits it (D5880).
    if holeLitCopyOf(parenPeelIx(org), rexp) >= 0 { return true }
    const pinned = holeLitPinOf(parenPeelIx(org))
    if pinned >= 0 {
      return pinned == rexp
        || assignable(pinned, rexp) && assignable(rexp, pinned)
    }
    // Loud at a pin that is not itself a probe: a container delivery reports its own refusal
    // and answers true, so a quiet ask cannot see it (D5840).
    if !inferQuiet && !(nodeAt(parenPeelIx(org)) is ObjLit) {
      return assignableExpr(org, rat, rexp)
    }
  }
  const savedQuiet = inferQuiet
  if prbArmed { prbEnter() }
  inferQuiet = true
  quietDepth = quietDepth + 1
  const ok = assignableExpr(org, rat, rexp)
  inferQuiet = savedQuiet
  quietDepth = quietDepth - 1
  if prbArmed { prbLeave("argCstrFitsAt") }
  ok
}

// The type another demand retyped demand `ci`'s literal at, else `rat`.
function litPinnedOr(
  rat: i32,
  ci: i32,
  hNames: string[],
  hArgNode: i32[],
): i32 {
  const org = holeArgOriginNode(ci, hNames, hArgNode)
  if org < 0 { return rat }
  const pinned = holeLitPinOf(parenPeelIx(org))
  if pinned >= 0 { return pinned }
  rat
}

// The function type a lambda handed to hole `holeTy` takes from the call the callee's body makes
// through another hole this call already bound (D5842); -1 for none, or two. `calleeFn` scopes the
// demands to a declared callee; -1 reads them by the hole's qualified name alone.
export function holeLambdaSeedTy(
  calleeFn: i32,
  holeTy: i32,
  bNames: string[],
  bTys: i32[],
): i32 {
  if holeTy < 0 || !tyIsHole(holeTy) { return -1 }
  const hv = tyAt(holeTy)
  if !(hv is TyVar) { return -1 }
  let got = -1
  let ci = 0
  while ci < argCstr.at.length {
    const mine = calleeFn < 0 || argCstr.fn[ci] == calleeFn
    if argCstr.form[ci] > 0 && mine && tyVarNamed(argCstr.at[ci], hv.tvName) {
      const rexp = substTyDeep(argCstr.exp[ci], bNames, bTys)
      if rexp >= 0 && !tyHasHole(rexp) && tyAt(rexp) is TyFunc {
        if got >= 0 && !tySame(got, rexp) { return -1 }
        got = rexp
      }
    }
    ci = ci + 1
  }
  got
}

// Whether `t` is a function type whose result is a union of two or more members, or nullable.
function fnRetIsUnion(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const f = tyAt(t)
  if !(f is TyFunc) || f.fnRet < 0 || f.fnRet >= T.tys.length { return false }
  tyAt(f.fnRet) is TyUnion || tyAt(f.fnRet) is TyNullable
}

// Whether function type `t` returns `null`.
function fnRetIsNull(t: i32): boolean {
  const f = tyAt(t)
  f is TyFunc && isNullTy(f.fnRet)
}

// The type a closed function value `at` handed to hole `holeTy` is delivered at, when the callee
// hands the hole on to a function parameter with a union or nullable result: that parameter, its
// open type parameter bound from `at`'s result. A hand-on the call's other arguments closed wins
// over one left open (D10243). -1 for no such hand-on, or two that disagree.
export function holeFnArgUnionRetTy(calleeFn: i32, holeTy: i32, at: i32): i32 {
  if calleeFn < 0 || holeTy < 0 || !tyIsHole(holeTy) { return -1 }
  if at < 0 || at >= T.tys.length || !(tyAt(at) is TyFunc) || tyHasTyVar(at) {
    return -1
  }
  const hv = tyAt(holeTy)
  if !(hv is TyVar) { return -1 }
  const closed = holeFnArgRetTy(calleeFn, hv.tvName, at, true)
  if closed >= 0 { return closed }
  if closed == -2 { return -1 }
  const open = holeFnArgRetTy(calleeFn, hv.tvName, at, false)
  if open >= 0 { open } else { -1 }
}

// `holeFnArgUnionRetTy` over the hand-ons whose parameter type is `closed`, or else open: -1 for
// none, -2 for two that disagree.
function holeFnArgRetTy(
  calleeFn: i32,
  hole: string,
  at: i32,
  closed: boolean,
): i32 {
  let got = -1
  let ci = 0
  while ci < argCstr.at.length {
    if (
      argCstr.form[ci] == ACF_PLAIN
      && argCstr.fn[ci] == calleeFn
      && tyVarNamed(argCstr.at[ci], hole)
      && fnRetIsUnion(argCstr.exp[ci])
      && closed == !tyHasTyVar(argCstr.exp[ci])
    ) {
      if closed {
        if got >= 0 && !tySame(got, argCstr.exp[ci]) { return -2 }
        got = argCstr.exp[ci]
        ci = ci + 1
        continue
      }
      const uNames: string[] = []
      const uTys: i32[] = []
      bindGenFnRetUnionArm(argCstr.exp[ci], at, uNames, uTys, false)
      if uNames.length == 0 && !fnRetIsNull(at) {
        bindGenWalk(argCstr.exp[ci], at, uNames, uTys)
      }
      if uNames.length > 0 {
        const dst = substTyDeep(argCstr.exp[ci], uNames, uTys)
        if dst >= 0 && !tyHasTyVar(dst) {
          if got >= 0 && !tySame(got, dst) { return -2 }
          got = dst
        }
      }
    }
    ci = ci + 1
  }
  got
}

// Whether the callee's body hands the lambda at hole `holeTy` on through a hole this call bound
// to another hole, so the function type it takes is the enclosing function's pin to decide.
export function holeLambdaDefers(
  calleeFn: i32,
  holeTy: i32,
  bNames: string[],
  bTys: i32[],
): boolean {
  if calleeFn < 0 || holeTy < 0 || !tyIsHole(holeTy) { return false }
  const hv = tyAt(holeTy)
  if !(hv is TyVar) { return false }
  let ci = 0
  while ci < argCstr.at.length {
    if (
      argCstr.form[ci] > 0
      && argCstr.fn[ci] == calleeFn
      && tyVarNamed(argCstr.at[ci], hv.tvName)
    ) {
      const rexp = substTyDeep(argCstr.exp[ci], bNames, bTys)
      if rexp != argCstr.exp[ci] && hdKindIs(rexp, HD_PARAM) { return true }
    }
    ci = ci + 1
  }
  false
}

function tyVarNamed(t: i32, name: string): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const v = tyAt(t)
  v is TyVar && v.tvName == name
}

// A composite argument demand at the pin that closes it: its node is asked the direct call's
// question under the pin's bindings. One still open is left, not moved out to every caller,
// so a generic chain pays for it once per pin rather than once per hop.
function validateCompArgCstr(
  ci: i32,
  rat: i32,
  rexp: i32,
  bNames: string[],
  bTys: i32[],
  ix: i32,
) {
  if tyHasHole(rexp) || tyHasHole(rat) { return 0 }
  const savedQuiet = inferQuiet
  if prbArmed { prbEnter() }
  inferQuiet = true
  quietDepth = quietDepth + 1
  const ok = litPinAssignable(argCstr.node[ci], rat, rexp, bNames, bTys)
  inferQuiet = savedQuiet
  quietDepth = quietDepth - 1
  if prbArmed { prbLeave("validateCompArgCstr") }
  if ok { return 0 }
  argFlowErr(rat, rexp, ci, ix)
}

// The pin of an `ACF_CHOICE` demand `ci`, its call's function type `rat` under this call's
// bindings: still open, it moves out to the caller's pin; closed, every function the call may
// run is judged at those types (D13782).
function validateChoiceCstr(ci: i32, rat: i32, calleeFn: i32) {
  if ci < 0 || ci >= argCstr.at.length || rat < 0 { return 0 }
  if tyHasTyVar(rat) {
    if calleeFn >= 0 && rat != argCstr.at[ci] {
      noteArgCstrAt(
        rat,
        rat,
        argCstr.who[ci],
        ACF_CHOICE,
        argCstr.node[ci],
        argCstr.call[ci],
      )
    }
    return 0
  }
  const ft = tyAt(rat)
  if !(ft is TyFunc) { return 0 }
  const none: i32[] = []
  holeLetWritesDisagreeAt(argCstr.node[ci], ft.fnParamTypes, none)
  0
}

// Re-validates every deferred call-argument constraint this call's callee owns
// (`cstrOwnedBy`), substituting the hole to the call's argument type. A hole that substitutes
// to another hole is re-recorded under it for the outer call that pins it, and only where the
// callee is named, as `validateBinCstrs` does.
export function validateArgCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  hNames: string[],
  hArgNode: i32[],
) {
  const nOrig = argCstr.at.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrig {
    if !cstrOwnedBy(argCstr.fn[ci], calleeFn) {
      ci = ci + 1
      continue
    }
    cvNow = cvPick(CV_ARG, ci, cvWas)
    const rat = substTyDeep(argCstr.at[ci], bNames, bTys)
    const rexp = substTyDeep(argCstr.exp[ci], bNames, bTys)
    // Two type parameters an outer generic's own parameters substitute to stay apart for its pin.
    if (
      calleeFn >= 0
      && rat != argCstr.at[ci]
      && tyParamsApartIn(rat, rexp, cstrOwnerTop())
    ) {
      noteArgCstrAt(
        rat,
        rexp,
        argCstr.who[ci],
        argCstr.form[ci],
        argCstr.node[ci],
        argCstr.call[ci],
      )
    }
    if argCstr.form[ci] == ACF_COMP {
      validateCompArgCstr(ci, rat, rexp, bNames, bTys, ix)
      ci = ci + 1
      continue
    }
    if argCstr.form[ci] == ACF_CHOICE {
      validateChoiceCstr(ci, rat, calleeFn)
      ci = ci + 1
      continue
    }
    if rat != argCstr.at[ci] && calleeFn >= 0 {
      if tyIsHole(rat) || tyIsDeferredJoin(rat) {
        if !tyIsHole(rexp) {
          noteArgCstrAt(
            rat,
            rexp,
            argCstr.who[ci],
            argCstr.form[ci],
            -1,
            argCstr.call[ci],
          )
        }
      }
    }
    // A hole callee's parameter still unpinned here moves out to the caller's hole with its
    // argument, whichever side this call resolved.
    if (
      (calleeFn >= 0 || calleeFn == CSTR_NODECL)
      && argCstr.form[ci] > 0
      && hdKindIs(rexp, HD_PARAM)
    ) {
      if rat != argCstr.at[ci] || rexp != argCstr.exp[ci] {
        let mvNode = -1
        if !tyIsHole(rat) { mvNode = holeArgOriginNode(ci, hNames, hArgNode) }
        if mvNode >= 0 && !inferQuiet { holeLitMovedSet(parenPeelIx(mvNode)) }
        noteArgCstrAt(
          rat,
          rexp,
          argCstr.who[ci],
          argCstr.form[ci],
          mvNode,
          argCstr.call[ci],
        )
      }
    }
    // A side still carrying a hole — bare, or as a deferred-join arm — is undecided at this
    // site and defers to the call that pins it.
    if !tyIsHole(rat) && !tyIsDeferredJoin(rat) {
      // A declared generic's parameter, a bare variable among them, is asked at the argument as
      // its direct call asks it.
      const gWant = holeGenericParamAt(
        argCstr.exp[ci],
        rat,
        argCstr.node[ci],
        calleeFn,
        bNames,
        bTys,
      )
      if gWant >= 0 && !assignable(rat, gWant) {
        argCstrErr(litPinnedOr(rat, ci, hNames, hArgNode), gWant, ci, ix)
      } else if !tyIsHole(rexp) && !tyIsDeferredJoin(rexp) {
        if !argCstrFitsAt(rat, rexp, ci, hNames, hArgNode) {
          argCstrErr(litPinnedOr(rat, ci, hNames, hArgNode), rexp, ci, ix)
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Moves each demand `calleeFn` owns on a hole parameter, under the binding `bNames`/`bTys`, out
// to the caller's hole it substitutes to: `validateArgCstrs`'s move for a list element other
// than the one the call is typed at, judging nothing (D12701).
export function moveElemArgCstrs(bNames: string[], bTys: i32[], calleeFn: i32) {
  const nOrig = argCstr.at.length
  let ci = 0
  while ci < nOrig {
    if cstrOwnedBy(argCstr.fn[ci], calleeFn) && argCstr.form[ci] > 0 {
      const rat = substTyDeep(argCstr.at[ci], bNames, bTys)
      const rexp = substTyDeep(argCstr.exp[ci], bNames, bTys)
      if (
        hdKindIs(rexp, HD_PARAM)
        && (rat != argCstr.at[ci] || rexp != argCstr.exp[ci])
      ) {
        noteArgCstrAt(
          rat,
          rexp,
          argCstr.who[ci],
          argCstr.form[ci],
          -1,
          argCstr.call[ci],
        )
      }
    }
    ci = ci + 1
  }
  0
}

// A literal argument handed to a hole parameter that the body delivers to a function value's
// concrete parameter takes that parameter's type, as it does at the direct call, so the instance
// passes `call_ref` the callee's own rep (D5840). Rebinds `bTys` in place, once per hole.
export function adoptHoleLitArgs(
  bNames: string[],
  bTys: i32[],
  calleeFn: i32,
  hNames: string[],
  hArgNode: i32[],
) {
  if calleeFn < 0 && calleeFn != CSTR_NODECL { return 0 }
  const done: string[] = []
  let ci = 0
  while ci < argCstr.at.length {
    if argCstr.form[ci] > 0 && cstrOwnedBy(argCstr.fn[ci], calleeFn) {
      adoptHoleLitArg(ci, bNames, bTys, calleeFn, hNames, hArgNode, done)
    }
    ci = ci + 1
  }
  0
}

// `adoptHoleLitArgs` for demand `ci`; `done` holds the holes already rebound. A demand moved out
// of a forwarder carries its literal and that literal's own type in place of the hole. A call
// with no declaration (a hole lambda) adopts only for the holes it binds itself.
function adoptHoleLitArg(
  ci: i32,
  bNames: string[],
  bTys: i32[],
  calleeFn: i32,
  hNames: string[],
  hArgNode: i32[],
  done: string[],
) {
  const at = argCstr.at[ci]
  if at < 0 || at >= T.tys.length { return 0 }
  const hv = tyAt(at)
  const rexp = substTyDeep(argCstr.exp[ci], bNames, bTys)
  if !(hv is TyVar) {
    if calleeFn < 0 { return 0 }
    const mv = argCstr.node[ci]
    if mv < 0 || !holeLitMovedHas(parenPeelIx(mv)) { return 0 }
    const mvLit = nodeAt(parenPeelIx(mv))
    if !(mvLit is ArrayLit || mvLit is ObjLit) { return 0 }
    const lx = parenPeelIx(mv)
    if holeLitPinOf(lx) >= 0 || holeLitClaimedHas(lx) {
      holeLitCopyAt(lx, rexp)
      return 0
    }
    if holeLitAdopts(mv, at, rexp) { holeLitAdopt(mv, at, rexp) }
    if !inferQuiet { holeLitClaimSet(lx) }
    return 0
  }
  if strListHas(done, hv.tvName) { return 0 }
  if calleeFn < 0 && !strListHas(hNames, hv.tvName) { return 0 }
  let k = 0
  while k < bNames.length && bNames[k] != hv.tvName { k = k + 1 }
  if k >= bNames.length || k >= bTys.length { return 0 }
  const org = holeArgOriginNode(ci, hNames, hArgNode)
  if org < 0 { return 0 }
  const lit = nodeAt(parenPeelIx(org))
  if !(lit is ArrayLit || lit is ObjLit || lit is StrLit) { return 0 }
  if !holeLitAdopts(org, bTys[k], rexp) { return 0 }
  holeLitAdopt(org, bTys[k], rexp)
  bTys[k] = rexp
  done.push(hv.tvName)
  0
}

// Whether literal `org` of type `rat` is rebuilt at `rexp`: the direct call would retype it, and
// its own type is not already the same rep (a wider record literal fits by width as it is).
function holeLitAdopts(org: i32, rat: i32, rexp: i32): boolean {
  if rat == rexp || tyHasHole(rexp) { return false }
  const empty = tyReachesEmptyHole(rat, 8)
  if tyHasHole(rat) && !empty { return false }
  if scalarPrimPair(rat, rexp) { return false }
  if !empty && assignable(rat, rexp) && assignable(rexp, rat) { return false }
  if nodeAt(parenPeelIx(org)) is ObjLit && objWidthFitsExact(rat, rexp) {
    return false
  }
  const savedQuiet = inferQuiet
  inferQuiet = true
  quietDepth = quietDepth + 1
  const ok = assignableExpr(org, rat, rexp)
  inferQuiet = savedQuiet
  quietDepth = quietDepth - 1
  ok
}

// Retypes literal `org` at `rexp` for the checker and for the instance mono builds.
function holeLitAdopt(org: i32, rat: i32, rexp: i32) {
  if inferQuiet { return 0 }
  assignableExpr(org, rat, rexp)
  nodeTySet(org, rexp)
  recordRepTyAdopt(org, rexp, 6)
  // A string literal already pins at its literal union through the atom channel.
  if !(nodeAt(parenPeelIx(org)) is StrLit) {
    holeLitPinSet(parenPeelIx(org), rexp)
  }
  0
}

// A copy of forwarder literal `lx`, already retyped for one caller, at the type `rexp` another
// caller hands it to, so each instance of the forwarder passes its own (D5880). Nothing for a
// probe, a type the literal already has, or a literal holding anything but literals.
function holeLitCopyAt(lx: i32, rexp: i32) {
  if inferQuiet || rexp < 0 || tyHasHole(rexp) { return 0 }
  let pinned = holeLitPinOf(lx)
  if pinned < 0 { pinned = nodeTyOf(lx) }
  if pinned < 0 { return 0 }
  if pinned == rexp || holeLitCopyOf(lx, rexp) >= 0 { return 0 }
  if assignable(pinned, rexp) && assignable(rexp, pinned) { return 0 }
  const cp = holeLitDeepCopy(lx)
  if cp < 0 { return 0 }
  nodeTyRecord(cp, rexp)
  const ct = checkNodeHook(cp)
  if ct < 0 { return 0 }
  if holeLitAdopts(cp, ct, rexp) {
    holeLitAdopt(cp, ct, rexp)
  } else if ct == rexp || assignable(ct, rexp) && assignable(rexp, ct) {
    nodeTySet(cp, rexp)
    holeLitPinSet(cp, rexp)
  } else {
    return 0
  }
  holeLitCopyAdd(lx, cp)
  0
}

// The copy of literal `lx` retyped at `ty`, or -1.
function holeLitCopyOf(lx: i32, ty: i32): i32 {
  for c in holeLitCopiesOf(lx) {
    const pt = holeLitPinOf(c)
    if pt == ty || pt >= 0 && assignable(pt, ty) && assignable(ty, pt) {
      return c
    }
  }
  -1
}

// A fresh copy of literal `ix`, every node of which is a literal; -1 when one is not.
function holeLitDeepCopy(ix: i32): i32 {
  if ix < 0 { return -1 }
  const n = nodeAt(ix)
  if n is NumLit { return mkNum(n.numText, n.pos) }
  if n is StrLit { return mkStr(n.strText, n.pos) }
  if n is BoolLit { return mkBool(n.boolVal, n.pos) }
  if n is NullLit { return mkNull(n.nullKw, n.pos) }
  if n is Unary {
    if n.unOp != "-" { return -1 }
    const ua = holeLitDeepCopy(n.unArg)
    if ua < 0 { return -1 }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = holeLitDeepCopy(n.parInner)
    if pi < 0 { return -1 }
    return mkParen(pi, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    for e in n.arrElems {
      const ce = holeLitDeepCopy(e)
      if ce < 0 { return -1 }
      es.push(ce)
    }
    return mkArrayLit(es, n.pos)
  }
  if n is ObjLit {
    const fs: i32[] = []
    for f in n.objFields {
      const fi = nodeAt(f)
      if !(fi is FieldInit) { return -1 }
      const cv = holeLitDeepCopy(fi.fiValue)
      if cv < 0 { return -1 }
      fs.push(mkFieldInit(fi.fiName, cv, fi.pos))
    }
    return mkObjLit(fs, n.pos)
  }
  holeLitNotCopied()
}

// The answer `holeLitDeepCopy` gives a node of any other kind: it is no literal, so a
// literal tree holding it is not copied and each caller keeps the shared one (-1).
function holeLitNotCopied(): i32 { -1 }

// True when record `wide` carries every field of `narrow` at the identical type, so a wider
// literal already fits by width and needs no retyping (an extra field stays readable).
function objWidthFitsExact(wide: i32, narrow: i32): boolean {
  if wide < 0 || wide >= T.tys.length || narrow < 0 || narrow >= T.tys.length {
    return false
  }
  const w = tyAt(wide)
  const n = tyAt(narrow)
  if !(w is TyObj) || !(n is TyObj) { return false }
  let i = 0
  while i < n.objFieldNames.length {
    let j = 0
    while (
      j < w.objFieldNames.length
      && w.objFieldNames[j] != n.objFieldNames[i]
    ) {
      j = j + 1
    }
    if j >= w.objFieldTypes.length || i >= n.objFieldTypes.length {
      return false
    }
    if w.objFieldTypes[j] != n.objFieldTypes[i] { return false }
    i = i + 1
  }
  true
}

// Whether a return-type mismatch is nominal-only, at a destination the author has no syntax
// to spell: the hole sits on the declared side alone (`wOnly`), the destination is a newtype
// brand, and the body type already fits the brand's unbranded base — the repair would be `x
// as A`, which the language has no form for (`wOnly` is what keeps a body-side hole under a concrete declaration a loud reject, D551).
function retNomOnlyAtHole(wOnly: i32, ix: i32, rg: i32, rw: i32) {
  if wOnly != 1 { return false }
  if !tyIsNewtypeBrand(rw) { return false }
  const b = nomBaseTyIx(rw)
  if b < 0 { return false }
  if b == rw { return false }
  assignableExpr(ix, rg, b)
}

// "; the call binds no type to `A`, so give it an explicit type argument" for the parameters
// `bNames` reads as `never` because the call left them open, or "" when it left none (D14802).
function unboundParamsNote(bNames: string[], bTys: i32[]): string {
  let ns = ""
  let k = 0
  while k < bNames.length && k < bTys.length {
    if bTys[k] == TY_NEVER {
      if ns != "" { ns = ns + ", " }
      ns = ns + "`" + bNames[k] + "`"
    }
    k = k + 1
  }
  if ns == "" { return "" }
  "; the call binds no type to " + ns + ", so give it an explicit type argument"
}

// The members of union `t` that hold no hole, as one type; -1 when `t` is no union or every
// member holds one.
function boundUnionMembers(t: i32): i32 {
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyUnion) { return -1 }
  const ms: i32[] = []
  flattenVariantsInto(t, ms)
  const kept: i32[] = []
  for m in ms {
    if !tyHasHole(m) { kept.push(m) }
  }
  if kept.length == 0 { return -1 }
  if kept.length == 1 { return kept[0] }
  mkUnionTy(kept)
}

// `assignableExpr` with the pin's bindings staged for a literal's elements (`litElemSrcTy`).
function litPinAssignable(
  ix: i32,
  src: i32,
  dst: i32,
  bNames: string[],
  bTys: i32[],
): boolean {
  const sN = litPinN
  const sT = litPinT
  litPinNSet(bNames)
  litPinTSet(bTys)
  const ok = assignableExpr(ix, src, dst) || joinLitsFitAt(ix, dst)
  litPinNSet(sN)
  litPinTSet(sT)
  ok
}

// Re-validates every deferred return-type constraint this call resolves: substitutes the
// call's bindings into the body's returned type and the declared return type, and asks the
// mismatch question the body could only answer vacuously. Re-defers like `validateArgCstrs`
// when a hole substitutes to another hole; the message is the direct spelling's, verbatim.
export function validateRetCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigR = retCstr.got.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigR {
    if (
      cstrOwnedBy(retCstr.fn[ci], calleeFn)
      && !nestCstrOutside(retCstr.ix[ci])
    ) {
      cvNow = cvPick(CV_RET, ci, cvWas)
      const rg = substTyDeep(retCstr.got[ci], bNames, bTys)
      const rw = substTyDeep(retCstr.want[ci], bNames, bTys)
      // Re-records only when the callee is named — an unnamed call cannot reassign ownership
      // — and gates on either side still holding a hole, not just the body side.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if rg != retCstr.got[ci] || rw != retCstr.want[ci] {
          if tyHasHole(rg) || tyHasHole(rw) {
            noteRetCstr(rg, rw, retCstr.ix[ci])
          }
        }
      }
      // A union whose holes this call leaves open is checked by its bound members, which are
      // in every instance's value whatever the holes become (D14801).
      let rgc = rg
      if tyHasHole(rg) && !tyHasHole(rw) { rgc = boundUnionMembers(rg) }
      if rgc >= 0 && !tyHasHole(rgc) {
        if (
          !tyHasHole(rw)
          && !retNomOnlyAtHole(retCstr.wOnly[ci], retCstr.ix[ci], rgc, rw)
        ) {
          if !litPinAssignable(retCstr.ix[ci], rgc, rw, bNames, bTys) {
            let rWho = "the callee's return"
            if who != "" { rWho = "the return of `" + who + "`" }
            tErr(
              "return type mismatch: expected "
                + tyToStr(rw)
                + ", got "
                + tyToStr(rgc)
                + boolForNumberNote(rgc, rw)
                + " ("
                + rWho
                + " at the call's argument types"
                + unboundParamsNote(bNames, bTys)
                + ")",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Whether the deferred destination constraints this binding resolves hold — the twin of
// Whether every hole of `t` sits inside a function type, reached through lists, nullables and
// record fields only: a hole anywhere else is a value's own open type, not a delivered function's.
function holesOnlyInFns(t: i32, depth: i32): boolean {
  if t < 0 || t >= T.tys.length || depth > 16 { return false }
  if !tyHasHole(t) { return true }
  const x = tyAt(t)
  match x {
    TyFunc => {
      return true
    }
    TyArray => {
      return holesOnlyInFns(x.aElem, depth + 1)
    }
    TyNullable => {
      return holesOnlyInFns(x.nInner, depth + 1)
    }
    TyObj => {
      for ft in x.objFieldTypes {
        if !holesOnlyInFns(ft, depth + 1) { return false }
      }
      return true
    }
    // a hole in any other position is a value's own open type
    TyPrim | TyErr | TyUnion | TyMap | TyVar | TyLit | TyNeg => {}
  }
  false
}

// Whether every hole the deferred pair `got`/`want` leaves open is a lambda's own parameter,
// bound by the closed `want`: the delivery types the lambda's copy there, so a call of the
// lambda at another type does not re-ask the pair.
function lambdaCopyOnly(got: i32, want: i32): boolean {
  if (
    want < 0
    || tyHasHole(want)
    || tyHasTyVar(want)
    || !holesOnlyInFns(got, 0)
  ) {
    return false
  }
  const bn: string[] = []
  const bt: i32[] = []
  bindGenWalk(got, want, bn, bt)
  if bn.length == 0 { return false }
  for nm in bn {
    if nm.length < 3 || nm.slice(0, 3) != "?#L" { return false }
  }
  !tyHasHole(substTyDeep(got, bn, bt))
}

// `validateRetCstrs` for a `let`/`const` binding rather than a return (D572 is why the two
// need separate tables). Same re-deferral rule; the message is `letAssignMsg`'s, verbatim,
// with the attribution appended since the reader wrote no assignment.
export function validateLetCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigL = letCstr.got.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigL {
    if (
      cstrOwnedBy(letCstr.fn[ci], calleeFn)
      && !lambdaCopyOnly(letCstr.got[ci], letCstr.want[ci])
      && !nestCstrOutside(letCstr.ix[ci])
      && !wrUnreachedBy(ci, ix, calleeFn)
      && !ctnWrUnreachedBy(letCstr.ix[ci], letCstr.got[ci], letCstr.fn[ci], ix)
    ) {
      cvNow = cvPick(CV_LET, ci, cvWas)
      const lg = substTyDeep(letCstr.got[ci], bNames, bTys)
      const lw = substTyDeep(letCstr.want[ci], bNames, bTys)
      // Re-records only when the callee is named, for the same ownership reason
      // `validateRetCstrs` gates on; also gated on either side holding a hole.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if lg != letCstr.got[ci] || lw != letCstr.want[ci] {
          if tyHasHole(lg) || tyHasHole(lw) {
            noteLetCstr(lg, lw, letCstr.ix[ci], letCstr.name[ci])
          }
        }
      }
      if !tyHasHole(lg) {
        if !tyHasHole(lw) {
          if !litPinAssignable(letCstr.ix[ci], lg, lw, bNames, bTys) {
            let lWho = "the callee's body"
            if who != "" { lWho = "the body of `" + who + "`" }
            tErr(
              letAssignMsg(letCstr.ix[ci], lg, lw, letCstr.name[ci], -1)
                + " ("
                + lWho
                + " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Whether the deferred builtin-method-argument constraints this binding resolves hold — the
// twin of `validateLetCstrs` for a `.push`/`.set`/`.add` argument rather than an assignment
// (D582 is why `argCstr*` cannot serve this position). Same re-deferral rule, gated on either
// side; the message is the arm's own (`bmArgMsg`), verbatim, with the attribution appended.
export function validateBmCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigB = bmCstr.got.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigB {
    if (
      cstrOwnedBy(bmCstr.fn[ci], calleeFn)
      && !nestCstrOutside(bmCstr.ix[ci])
      && !ctnWrUnreachedBy(bmCstr.ix[ci], bmCstr.got[ci], bmCstr.fn[ci], ix)
    ) {
      cvNow = cvPick(CV_BM, ci, cvWas)
      const bg = substTyDeep(bmCstr.got[ci], bNames, bTys)
      const bw = substTyDeep(bmCstr.want[ci], bNames, bTys)
      let bc = bmCstr.ctx[ci]
      if bc >= 0 { bc = substTyDeep(bc, bNames, bTys) }
      // Re-records only when the callee is named — an unnamed call cannot reassign
      // ownership of the constraint.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if bg != bmCstr.got[ci] || bw != bmCstr.want[ci] {
          if tyHasHole(bg) || tyHasHole(bw) {
            noteBmCstr(
              bmCstr.form[ci],
              bmCstr.label[ci],
              bg,
              bw,
              bc,
              bmCstr.ix[ci],
            )
          }
        }
      }
      if !tyHasHole(bg) {
        if !tyHasHole(bw) {
          const held = stampsHeld
          stampsHeldSet(true)
          const fits = bmArgPred(bmCstr.form[ci], bg, bw, bmCstr.ix[ci])
          stampsHeldSet(held)
          if !fits {
            let bWho = "the callee's body"
            if who != "" { bWho = "the body of `" + who + "`" }
            tErr(
              bmArgMsg(bmCstr.form[ci], bmCstr.label[ci], bg, bw, bc)
                + " ("
                + bWho
                + " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Binds each type parameter of the generic return `ret` from the type the call's destination
// expects, when every argument that would bind it is a literal adapting to that type, so
// `const hs: f32[] = filled(4, 0.0)` is `filled<f32>` as an annotated literal is an `f32` (D3539).
export function dstBindLitTyParams(
  ix: i32,
  ret: i32,
  params: i32[],
  args: i32[],
  bNames: string[],
  bTys: i32[],
  outNames: string[],
) {
  const dst = dstForArgs(callDstTyOf(ix), args, ret)
  if dst < 0 || ret < 0 || !anyArgIsLitOnly(args) || !tyHasTyVar(ret) {
    return 0
  }
  const dN: string[] = []
  const dT: i32[] = []
  bindGenWalk(ret, dst, dN, dT)
  let k = 0
  while k < dN.length {
    if bindOf(bNames, bTys, dN[k]) < 0 {
      if prbArmed { prbEnter() }
      const held = holePinHeldSet(true)
      const adapts = dstTyParamAdapts(dN[k], dT[k], params, args, ix, ret, dst)
      holePinHeldSet(held)
      if prbArmed { prbLeave("dstTyParamAdapts") }
      if adapts {
        bNames.push(dN[k])
        bTys.push(dT[k])
        outNames.push(dN[k])
        // The annotation chose the instance, so it is not redundant (D1442).
        cbSeedUsedSet(cbSeedUsed + 1)
      }
    }
    k = k + 1
  }
  0
}

// Whether the destination's `cand` for type parameter `name` replaces the arguments' binding at
// call `ix`: always for a bare `null` beside arguments `cand` holds; for a literal union only
// when every argument is a literal member of it; otherwise when every argument is a
// literal `cand` holds in its kind and the arguments' own instance cannot reach `dst` (D4024).
function dstTyParamAdapts(
  name: string,
  cand: i32,
  params: i32[],
  args: i32[],
  ix: i32,
  ret: i32,
  dst: i32,
): boolean {
  if (
    cand < 0
    || cand == TY_ERR
    || isVoidTy(cand)
    || tyHasTyVar(cand)
    || dstTyOpen(cand)
  ) {
    return false
  }
  // A body computing on `T` can leave a literal union (D3602), so only literal members of it
  // choose one.
  const litU = tyIsLitUnionLike(cand, 4)
  if litU {
    if litUnionOneBase(cand, 4) < 0 { return false }
    const cn = nodeAt(ix)
    if cn is Call {
      if !genericBodyClosed(callGenericDeclIx(cn), 0) { return false }
    } else {
      return false
    }
  }
  const one: string[] = [name]
  const oneT: i32[] = [cand]
  let seen = 0
  let own = -1
  let nulls = 0
  const others: i32[] = []
  let i = 0
  while i < params.length {
    if tyMentionsTyVarNamed(params[i], name, 8) {
      if i >= args.length || args[i] < 0 { return false }
      const want = substTyDeep(params[i], one, oneT)
      if argIsNullLit(args[i]) {
        // A bare `null` binds `T` to the null type (DV-402).
        if !assignable(TY_NULL, want) { return false }
        nulls = nulls + 1
        seen = seen + 1
        if own < 0 { own = TY_NULL }
        i = i + 1
        continue
      }
      if litU {
        const lt = litLeafFitting(parenPeelIx(args[i]), want, 0)
        if lt < 0 { return false }
        seen = seen + 1
        if own < 0 { own = widenLitTy(lt) }
        i = i + 1
        continue
      }
      if !argIsLitOnly(args[i], 4) {
        others.push(i)
        i = i + 1
        continue
      }
      const x = parenPeelIx(args[i])
      if x < 0 || x >= P.nodes.length { return false }
      const isCall = nodeAt(x) is Call
      const savedQ = inferQuiet
      let at = -1
      if isCall {
        // A nested call is asked twice, speculatively: what it binds on its own, and whether the
        // destination's type, delivered to it in turn, is what it then answers.
        inferQuiet = true
        quietDepth = quietDepth + 1
        setCallDstTy(x, -1)
        at = checkNodeHook(args[i])
        setCallDstTy(x, want)
        inferQuiet = savedQ
        quietDepth = quietDepth - 1
      } else {
        at = checkNodeHook(args[i])
      }
      const aN: string[] = []
      const aT: i32[] = []
      bindGenWalk(params[i], at, aN, aT)
      if own < 0 { own = bindOf(aN, aT, name) }
      // Within the literal's kind only: an integer literal never makes `T` a float (B′).
      const wk = numKindMask(want, 8)
      if wk == 0 || (wk & ~numKindMask(at, 8)) != 0 { return false }
      inferQuiet = true
      quietDepth = quietDepth + 1
      if isCall { at = checkNodeHook(args[i]) }
      const ok = at >= 0 && assignableExpr(args[i], at, want)
      inferQuiet = savedQ
      quietDepth = quietDepth - 1
      if !ok { return false }
      seen = seen + 1
    }
    i = i + 1
  }
  // A non-literal argument goes along only beside a `null`, and only one the binding holds.
  if others.length > 0 {
    if nulls == 0 { return false }
    for oi in others {
      const want = substTyDeep(params[oi], one, oneT)
      const savedQ = inferQuiet
      inferQuiet = true
      quietDepth = quietDepth + 1
      let at = nodeTyIxOf(args[oi])
      if at < 0 { at = checkNodeHook(args[oi]) }
      const ok = at >= 0 && assignable(at, want)
      inferQuiet = savedQ
      quietDepth = quietDepth - 1
      if !ok { return false }
    }
    return true
  }
  if seen == 0 || own < 0 || tySame(own, cand) { return false }
  if nulls > 0 || litU { return true }
  // Only where the arguments' own instance cannot be delivered: anywhere it can, that instance
  // is the program's, and a body doing arithmetic on `T` must keep computing at it.
  const savedQ2 = inferQuiet
  inferQuiet = true
  quietDepth = quietDepth + 1
  const one2: string[] = [name]
  const own2: i32[] = [own]
  const ownRet = substTyDeep(ret, one2, own2)
  // `assignable` alone admits a list into a wider-element list; the delivery refuses that.
  const deliverable = assignable(ownRet, dst)
    && !objShapeAdapterlessAt(ix, ownRet, dst)
  inferQuiet = savedQ2
  quietDepth = quietDepth - 1
  !deliverable
}

// The pinned re-check, opened and closed around the caller's read: begin/end rather than a
// result selector, because the read must happen inside the isolation, scope and suppression flags still active.
export function monoRecheckBegin(
  declIx: i32,
  paramTyIxs: i32[],
  tpNames: string[],
  tpTys: i32[],
): MonoSave | null {
  if declIx < 0 { return null }
  const dn = nodeAt(declIx)
  if !(dn is FuncDecl) { return null }
  if dn.fnBody < 0 { return null }
  const body = nodeAt(dn.fnBody)
  if !(body is Block) { return null }
  if prbArmed { prbEnter() }
  monoRecheckDepthSet(monoRecheckDepth + 1)
  const sv: MonoSave = { quiet: inferQuiet, sym: symEnabled, mark: checkMark() }
  inferQuiet = true
  quietDepth = quietDepth + 1
  symEnabled = 0
  njFnStack.push(njFnIx)
  njFnIxSet(declIx)
  // Binds the type parameters too, not only the value ones: `checkFuncDecl` keeps them in
  // scope as an opaque hole, so a body annotation naming one would otherwise stay a hole forever.
  let tpb = 0
  while tpb < tpNames.length {
    if tpb < tpTys.length {
      if tpTys[tpb] >= 0 {
        tpEnvNames.push(tpNames[tpb])
        tpEnvTys.push(tpTys[tpb])
      }
    }
    tpb = tpb + 1
  }
  // Checks the body statements directly in the pushed scope (not via `checkNode` on the
  // block), which would push/pop its own scope and drop the local before it can be read back.
  crFnEnter(declIx)
  pushScope(dn.fnBody)
  const params = dn.fnParams
  let pi = 0
  while pi < params.length {
    const p = nodeAt(params[pi])
    if p is Param {
      let pty = TY_ERR
      if pi < paramTyIxs.length {
        if paramTyIxs[pi] >= 0 { pty = paramTyIxs[pi] }
      }
      declareDecl(params[pi], p.parName, pty)
    }
    pi = pi + 1
  }
  const stmts = body.blkStmts
  let restMark = -1
  let s = 0
  while s < stmts.length {
    checkNodeHook(stmts[s])
    restMark = elabDeadRestOpen(restMark)
    s = s + 1
  }
  elabDeadRestClose(restMark)
  sv
}

// ── a function value at another function type (D3073) ──────────────────────
// A function value keeps the `$fnsig` it carries, so a call through a function type of another
// rep traps. The delivery is rewritten in place into `(p…): R => f(p…)` at the destination's
// type and checked as written code; a conversion that code cannot make is refused there.

// A value `if`, `match` or block delivered at a function type `dstTy` (or its nullable): each
// function-value tail is adapted to `dstTy` and, if any needed it, the join is typed `dstTy`, so
// the emitter builds it at one `$fnsig` (D9781, D9881). False when no tail needed an adapter.
export function fvaAdaptJoin(srcExpr: i32, dstTy: i32): boolean {
  const lix = valueJoinAt(srcExpr)
  if lix < 0 { return false }
  const dt = nonNullTy(dstTy)
  if dt < 0 || !(tyAt(dt) is TyFunc) { return false }
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(lix, spine, leaves)
  if spine.length == 0 || leaves.length == 0 { return false }
  let adapted = false
  for lf in leaves {
    const lt = nodeTyIxOf(lf)
    if lt >= 0 && lt < T.tys.length && tyAt(lt) is TyFunc {
      if fvaAdapt(lf, lt, dt) { adapted = true }
    }
  }
  if !adapted { return false }
  for sp in spine {
    if sp < nodeTyIx.length { nodeTySet(sp, dstTy) }
  }
  true
}

// A list literal of type `listTy` whose elements hold functions: each element is adapted to the
// joined element type, so every slot holds one `$fnsig` (D9882). False when `ix` is no list literal.
export function fvaAdaptListLit(ix: i32, listTy: i32): boolean {
  const lix = parenPeelIx(ix)
  if lix < 0 || listTy < 0 || listTy >= T.tys.length { return false }
  const lit = nodeAt(lix)
  if !(lit is ArrayLit) { return false }
  const la = tyAt(nonNullTy(listTy))
  if !(la is TyArray) || !tyMayHoldFn(la.aElem, 0) { return false }
  for el in lit.arrElems {
    if spreadArgOf(el) < 0 { fvaAdapt(el, nodeTyIxOf(el), la.aElem) }
  }
  true
}

// Set while `fvaAdaptEnclosing` lets an adapter name the enclosing generic's type parameters.
let fvaEnclosingOk = false

// Whether `s` returns a type parameter that `d`'s otherwise identical function type returns as
// one member of a nullable or union result.
function fnRetTyVarWidens(s: i32, d: i32): boolean {
  if s < 0 || d < 0 || s >= T.tys.length || d >= T.tys.length { return false }
  const sf = tyAt(s)
  const df = tyAt(d)
  if !(sf is TyFunc) || !(df is TyFunc) || sf.fnRet < 0 || df.fnRet < 0 {
    return false
  }
  const rv = tyAt(sf.fnRet)
  if !(rv is TyVar) || tpEnvTyOfName(rv.tvName) < 0 { return false }
  if sf.fnParamTypes.length != df.fnParamTypes.length { return false }
  let i = 0
  while i < sf.fnParamTypes.length {
    const p = sf.fnParamTypes[i]
    if tyHasTyVar(p) || !tySame(p, df.fnParamTypes[i]) { return false }
    i = i + 1
  }
  const inner = nonNullTy(df.fnRet)
  if inner != df.fnRet { return tySame(inner, sf.fnRet) }
  const r = tyAt(df.fnRet)
  if r is TyUnion {
    for m in r.uMembers {
      if tySame(m, sf.fnRet) { return true }
    }
  }
  false
}

// `fvaAdapt` inside a generic body, for a function value returning the body's own type
// parameter delivered where that parameter is one member of the result: the adapter names the
// parameter, so each instance boxes its own result (D10241).
export function fvaAdaptEnclosing(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
): boolean {
  if !fnRetTyVarWidens(srcTy, dstTy) { return false }
  fvaEnclosingOk = true
  fvaAdapt(srcExpr, srcTy, dstTy)
}

// The un-annotated function the value `site` holds: the one a name reads, or the one every
// value a called function hands back holds; -1 else.
function fvaHoleDeclOf(site: i32, depth: i32): i32 {
  const d = holeFnArgDecl(site)
  if d >= 0 || depth <= 0 { return d }
  const ix = parenPeelIx(site)
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if !(n is Call) { return -1 }
  const cd = cwCalleeDeclOf(n.callFn)
  if cd < 0 || cd >= P.nodes.length { return -1 }
  const f = nodeAt(cd)
  if !(f is FuncDecl) || f.fnBody < 0 { return -1 }
  const rv: i32[] = []
  collectRetValues(f.fnBody, rv)
  let out = -1
  for v in rv {
    const vd = fvaHoleDeclOf(v, depth - 1)
    if vd < 0 || out >= 0 && vd != out { return -1 }
    out = vd
  }
  out
}

// The type of the un-annotated function value `site` holds, called at closed function type
// `dt`'s parameters, when its result's rep differs from `dt`'s, so it is delivered through an
// adapter as its annotated spelling is (D13781); -1 when it does not or is not known there.
function fvaHoleInstTy(site: i32, dt: i32): i32 {
  const decl = fvaHoleDeclOf(site, 4)
  if decl < 0 || dt < 0 || dt >= T.tys.length { return -1 }
  const d = tyAt(dt)
  if !(d is TyFunc) { return -1 }
  const noN: string[] = []
  const noT: i32[] = []
  const r = holeLamRetAt(decl, dt, noN, noT)
  if r < 0 || tyReachesHole(r, 8) { return -1 }
  const inst = mkFuncTy(d.fnParamTypes, widenLitTy(r))
  if !fvaFnMayDiffer(inst, dt, 8) { return -1 }
  inst
}

// Whether function type `d` is closed but for parameters or a result that are sets of functions,
// which are closed as a value: each member is instanced at the call through it.
function fvaSetSlotsClosed(d: TyFunc): boolean {
  let any = false
  const slots = d.fnParamTypes.slice(0, d.fnParamTypes.length)
  slots.push(d.fnRet)
  for t in slots {
    if fnTagSetValueOfTy(t) { any = true }
    else if tyHasTyVar(t) || tyReachesHole(t, 8) { return false }
  }
  any
}

// Whether `s` and `d` take and return the very same types, slot by slot.
function fvaSameSlots(s: TyFunc, d: TyFunc): boolean {
  if s.fnRet != d.fnRet || s.fnParamTypes.length != d.fnParamTypes.length {
    return false
  }
  let i = 0
  while i < s.fnParamTypes.length {
    if s.fnParamTypes[i] != d.fnParamTypes[i] { return false }
    i = i + 1
  }
  true
}

// Banks the instance of each generic function a value of type `srcTy` holds at closed type
// `dstTy`, through record fields, list elements and a nullable: a function's type parameters are
// bound by its signature against the destination function type's.
function fvaValueRowNote(srcTy: i32, dstTy: i32) {
  fvaValueRowWalk(srcTy, dstTy, 4)
}

// Banks the instance at closed function type `dstTy` of each generic function a binding read
// `srcExpr` may hold, every value assigned to it included (a closure's writes too).
function fvaBindingRowsNote(srcExpr: i32, dstTy: i32) {
  const p = parenPeelIx(srcExpr)
  if p < 0 || p >= P.nodes.length || identDeclOf(p) < 0 { return 0 }
  const dt = nonNullTy(dstTy)
  if dt < 0 || dt >= T.tys.length || !(tyAt(dt) is TyFunc) { return 0 }
  for t in cwFnValueTargets(cwBindingOf(p)) { fvaValueRowAt(t, dt) }
  0
}

// `fvaValueRowNote` for each value body `body` hands back, at the instance's closed result `ret`.
export function fvaRetRowsNote(body: i32, ret: i32) {
  const rv: i32[] = []
  collectRetValues(body, rv)
  for v in rv { fvaValueRowNote(elabLiveTyOf(v), ret) }
  0
}

function fvaValueRowWalk(srcTy: i32, dstTy: i32, depth: i32) {
  if depth <= 0 || srcTy < 0 || srcTy >= T.tys.length { return 0 }
  const dt = nonNullTy(dstTy)
  if dt < 0 || dt >= T.tys.length { return 0 }
  const s = tyAt(srcTy)
  const d = tyAt(dt)
  if s is TyObj && d is TyObj {
    let i = 0
    while i < s.objFieldNames.length && i < s.objFieldTypes.length {
      const ft = objFieldType(d, s.objFieldNames[i])
      if ft >= 0 { fvaValueRowWalk(s.objFieldTypes[i], ft, depth - 1) }
      i = i + 1
    }
    return 0
  }
  if s is TyArray && d is TyArray {
    return fvaValueRowWalk(s.aElem, d.aElem, depth - 1)
  }
  // Each generic member of a set is banked at the destination, as one alone is.
  for m in elabFnSetOf(srcTy) { fvaValueRowAt(m, dt) }
  0
}

// Banks generic function `decl`'s instance at closed function type `dt`, its type parameters
// bound by its signature against `dt`'s.
function fvaValueRowAt(decl: i32, dt: i32) {
  if decl < 0 || decl >= P.nodes.length || dt < 0 || dt >= T.tys.length {
    return 0
  }
  const d = tyAt(dt)
  const fn = nodeAt(decl)
  const st = nodeTyIxOf(decl)
  if !(fn is FuncDecl) || fn.fnTyParams.length == 0 || !(d is TyFunc) {
    return 0
  }
  if st < 0 || st >= T.tys.length { return 0 }
  const sf = tyAt(st)
  if !(sf is TyFunc) || sf.fnParamTypes.length != d.fnParamTypes.length {
    return 0
  }
  const bn: string[] = []
  const bt: i32[] = []
  let i = 0
  while i < sf.fnParamTypes.length {
    bindGenWalk(sf.fnParamTypes[i], d.fnParamTypes[i], bn, bt)
    i = i + 1
  }
  const names: string[] = []
  const tys: i32[] = []
  i = 0
  while i < bn.length && i < bt.length {
    for tp in fn.fnTyParams {
      if bn[i] == tp { names.push(bn[i]); tys.push(bt[i]) }
    }
    i = i + 1
  }
  elabValueRowNote(decl, names, tys)
  elabWideRowNote(decl, names, tys, d.fnRet)
}

// Rewrites the function value at `srcExpr`, of type `srcTy`, into an adapter at `dstTy`'s
// function type, when the two may differ in rep. True when the delivery is settled here,
// rewritten or refused; false leaves it to the caller unchanged.
export function fvaAdapt(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  const encOk = fvaEnclosingOk
  fvaEnclosingOk = false
  fvaValueRowNote(srcTy, dstTy)
  if inferQuiet || monoRecheckDepth > 0 { return false }
  if srcExpr < 0 || srcTy < 0 || dstTy < 0 { return false }
  if srcTy >= T.tys.length || dstTy >= T.tys.length { return false }
  // A join typed at the destination still carries each tail's own function value.
  if fvaAdaptJoin(srcExpr, dstTy) { return srcTy != dstTy }
  if srcTy == dstTy || !tyMayHoldFn(dstTy, 0) { return false }
  // A literal delivers each element or field at the destination's own type, one seam down.
  const lit = nodeAt(parenPeelIx(srcExpr))
  if lit is ArrayLit {
    const da = tyAt(nonNullTy(dstTy))
    if da is TyArray {
      for el in lit.arrElems {
        if spreadArgOf(el) < 0 { fvaAdapt(el, nodeTyIxOf(el), da.aElem) }
      }
    }
    return false
  }
  if lit is ObjLit {
    const dob = tyAt(nonNullTy(dstTy))
    if dob is TyObj {
      for fi in lit.objFields {
        const f = nodeAt(fi)
        if f is FieldInit {
          const ft = objFieldType(dob, f.fiName)
          if ft >= 0 { fvaAdapt(f.fiValue, nodeTyIxOf(f.fiValue), ft) }
        }
      }
    }
    return false
  }
  const dt = nonNullTy(dstTy)
  if dt < 0 { return false }
  const d = tyAt(dt)
  const s = tyAt(srcTy)
  if s is TyFunc && d is TyUnion {
    // A function delivered into a union lands in the one function arm it converts to.
    const arm = fvaUnionArm(d, srcTy)
    if arm >= 0 { return fvaAdapt(srcExpr, srcTy, arm) }
    if arm == -2 {
      fvaRefuse(
        srcExpr,
        srcTy,
        dt,
        "it converts into more than one function arm of the union",
      )
      return true
    }
  }
  if !(s is TyFunc) || !(d is TyFunc) {
    // A function inside a container is not rewritten on the way, so a call through the
    // destination's function type would reach it at another signature.
    if fvaNestedFnDiffers(srcTy, dstTy, 0, 8) {
      fvaRefuseNested(srcExpr, srcTy, dstTy)
      return true
    }
    return false
  }
  if s.fnRet < 0 || d.fnRet < 0 { return false }
  const dOpen = !encOk && !fvaSetSlotsClosed(d)
  if (
    tyHasTyVar(dt) && dOpen
    || s.fnParamTypes.length != d.fnParamTypes.length
  ) {
    return false
  }
  const site = srcExpr
  const pe = nodeAt(parenPeelIx(site))
  // A generic function named as a value is instantiated by the adapter's direct call, whatever
  // type the checker gave the name (D3112); any other type parameter in the source is an
  // enclosing generic's, pinned per instance.
  if fvaDone[site] ?? false { return false }
  // A generic named at a delivery re-validated at one call's pin is shared by every instance,
  // so it is not instantiated there (D6501).
  if litPinN.length > 0 && fvaNamesGeneric(pe, parenPeelIx(site)) {
    return false
  }
  if tyReachesHole(dt, 8) && dOpen { return false }
  // The source at the destination's parameters, when it is a hole function that needs boxing.
  let holeInst = -1
  // A value of a set of functions is called through at the destination's parameters, a call
  // each member serves at its own instance, so no one instance of the value is needed. A
  // function named at the delivery is its own instance, not a value of its set.
  const namedFn = pe is Ident && identFnDeclOf(parenPeelIx(site)) >= 0
  const setSrc = fnTagChoiceAt(srcExpr, srcTy)
    || fnTagSetValueOfTy(srcTy) && !namedFn
  // A destination taking or returning a set is built once the decision has tagged that set.
  const setDst = fvaSetSlotsClosed(d)
  // A function already typed at the destination's own slots is delivered as it is.
  if !setSrc && fvaSameSlots(s, d) { return false }
  if !fvaNamesGeneric(pe, parenPeelIx(site)) {
    // Any other hole is pinned later, where the value's use decides it.
    if (
      !encOk
      && (fnTyHasHole(srcTy) || tyHasTyVar(srcTy) || tyReachesHole(srcTy, 8))
    ) {
      holeInst = fvaHoleInstTy(site, dt)
      if holeInst < 0 && !setSrc { return false }
      // A choice is built here only once the decision has tagged its set.
      if holeInst < 0 && !fnTagEtaAt(site) {
        fnTagEscapeNote(site, srcTy)
        return false
      }
    } else if (setSrc || setDst) && !fnTagEtaAt(site) {
      fnTagEscapeNote(site, if setSrc { srcTy } else { dt })
      return false
    } else if !setSrc && !fvaFnMayDiffer(srcTy, dt, 8) {
      return false
    }
  }
  const pos = nodePos(site)
  const params: i32[] = []
  const args: i32[] = []
  let i = 0
  while i < d.fnParamTypes.length {
    // A parameter of a set of functions has no spelling; it is annotated by the type itself.
    const dp = d.fnParamTypes[i]
    const pt = if fnTagSetValueOfTy(dp) { fvaAnnotMinted(dp, site, pos) } else { fvaAnnot(dp, site, pos) }
    if pt < 0 {
      fvaRefuse(srcExpr, srcTy, dt, "")
      return true
    }
    const pn = "$fp" + i32ToStr(i)
    const pd = luAt(mkParam(pn, pt, -1, 0, 0, pos), site)
    params.push(pd)
    args.push(luRef(pd, site, pos))
    // A set passed on to a closed parameter is built there too, by this same check.
    if (
      setDst
      && fnTagSetValueOfTy(dp)
      && i < s.fnParamTypes.length
      && s.fnParamTypes[i] != dp
    ) {
      fnTagEtaInner(args[i])
    }
    i = i + 1
  }
  const rt = fvaAnnot(d.fnRet, site, pos)
  if rt < 0 {
    fvaRefuse(srcExpr, srcTy, dt, "")
    return true
  }
  // A function declaration or a `const` is stable; any other value is read once, as the
  // argument of an enclosing lambda called in place, so the adapter calls the delivered value
  // rather than what a `let` later holds.
  const stable = fvaStableName(pe, parenPeelIx(site))
  let callee = -1
  let fvParam = -1
  if stable {
    if pe is Ident {
      callee = luAt(mkIdent(pe.identName, pos), site)
      identFrom(callee, parenPeelIx(site))
    }
  } else {
    let held = srcTy
    if holeInst >= 0 { held = holeInst }
    // A set has no spelling; its parameter is annotated by the type itself.
    const st = if setSrc && holeInst < 0 { fvaAnnotMinted(held, site, pos) } else { fvaAnnot(held, site, pos) }
    if st < 0 {
      fvaRefuse(srcExpr, srcTy, dt, "")
      return true
    }
    const fv = "$fv" + i32ToStr(site)
    fvParam = luAt(mkParam(fv, st, -1, 0, 0, pos), site)
    callee = luRef(fvParam, site, pos)
  }
  const lam = fvaLambda(
    params,
    rt,
    luAt(mkCall(callee, args, pos), site),
    site,
    pos,
  )
  fvaDone.set(site, true)
  fvaBuilt.set(site, true)
  const mark = T.diags.length
  if stable {
    arenaSetNode(site, lam)
  } else {
    const siteNode = nodeAt(site)
    const moved = addNode(siteNode)
    if siteNode is Ident { identFrom(moved, site) }
    adoptNodeTok(moved, site)
    const li = luAt(addNode(lam), site)
    const outerPs: i32[] = []
    outerPs.push(fvParam)
    const outer = luAt(addNode(fvaLambda(outerPs, -1, li, site, pos)), site)
    const outerArgs: i32[] = []
    outerArgs.push(moved)
    const names: string[] = []
    const c: Node = {
      callFn: outer,
      callArgs: outerArgs,
      callArgNames: names,
      pos: pos,
    }
    arenaSetNode(site, c)
  }
  luGrow()
  const t = checkNodeHook(site)
  if T.diags.length > mark || !assignable(t, dstTy) {
    let why = ""
    if T.diags.length > mark { why = T.diags[mark].tmsg }
    while T.diags.length > mark { T.diags.pop() }
    fvaRefuse(site, srcTy, dt, why)
  }
  true
}
