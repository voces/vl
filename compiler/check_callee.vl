// `check_callee.vl` — which declaration a call or operator site runs. `callDeclFnIx` sorts a
// call's callee into a `FuncDecl`, an opaque target or an intrinsic, looking through the bodies
// on the `weRoots` stack for a nested declaration; the built-in method tables say which member
// calls a receiver's own type answers and what each does to the receiver; and the operator
// tables hold every declared index and binary operator and the one the checker resolved at each
// site, which the emitter's dispatch rewrite reads back. The checker fills the operator tables
// and pushes `weRoots`; `calleeReset` clears every table per program.
import { declTyOf, identTyOf } from "./check_nar_store"
import { identFnDeclOf } from "./check_scopes"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  OP_INDEX_GET,
  OP_INDEX_SET,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  elseIfLink,
  isBinOpFuncName,
  nodeAt,
  nodeSpineChildren,
  ufcsAliasAtSite,
} from "./ast"
import { crOpOpaque } from "./check_capture_rows"
import { crOpOf } from "./check_capture_walks"
import { nodeTyOf } from "./check_node_tys"
import { listMethodNames, strMethodNames } from "./check_suggest"
import { nomErasedTyIx } from "./check_ty_rep"
import { nonNullTy } from "./tyquery"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  tyAt,
} from "./check_types"
import {
  cwBindingOf,
  cwFnValueTargets,
  cwFramedNode,
  cwKeyOfRoot,
  cwLambdaDeclOf,
  fnDeclIx,
} from "./check_write_scan"
import { strListHas, strListIndexOf } from "./listutil"
import { memberDeclOf, methodFnOfDecl } from "./symbols"

// Every `function "[]"(self: T, …)` / `function "[]="(self: T, …)` the program declares, as the
// operator it implements and the possibly merge-mangled name it declared under, collected by the
// top-level hoist (with its declaration) so the registry describes the merged program. Dispatch is by the receiver's
// type: a candidate wins when the receiver is `assignable` to its `self` parameter.
export let opIdxOps: string[] = []
export let opIdxFns: string[] = []
export let opIdxDecls: i32[] = []

// The declaration of the operator function the checker resolved at an operator site, keyed by
// the node it resolved it at: an `Index` for a read, the assignment `BinExpr` for an index
// write, the `BinExpr` for a binary operator. Later passes read it rather than re-derive it.
export let opSiteDecl: {[i32]: i32} = Map()

// The function bodies currently being summarised, innermost last. A call inside a callee body may
// name a function declared in that body, or in a sibling frame of it, and a by-name lookup reads
// the caller's scope chain, where neither is visible — answering "not a function" there makes the
// whole nested-write route fail open.
export let weRoots: i32[] = []

// The `FuncDecl` named `name` declared inside any body currently being summarised,
// innermost frame first, or -1.
export function findFnDeclInRoots(name: string) {
  let i = weRoots.length - 1
  while i >= 0 {
    const d = findFnDeclIn(weRoots[i], name)
    if d >= 0 { return d }
    i = i - 1
  }
  -1
}

// The first `FuncDecl` named `name` in the subtree at `rootIx` in pre-order, the root itself
// included, or -1. Every query inside one summary asks the same root under many names, so the
// subtree is walked once per root into a table of every name it declares (`weFnDeclTabs`). Keying
// on the root is load-bearing — a name-only table can answer a declaration this walk never reaches.
export function findFnDeclIn(rootIx: i32, name: string) {
  if rootIx < 0 || rootIx >= P.nodes.length { return -1 }
  let slot = weFnDeclSlot[rootIx] ?? -1
  if slot < 0 {
    slot = weFnDeclTabs.length
    const tab: {[string]: i32} = Map()
    findFnDeclWalk(rootIx, tab)
    weFnDeclTabs.push(tab)
    weFnDeclSlot[rootIx] = slot
  }
  weFnDeclTabs[slot][name] ?? -1
}

// Per subtree root, the slot in `weFnDeclTabs` of its name → first-declaration table.
let weFnDeclSlot: {[i32]: i32} = Map()
let weFnDeclTabs: {[string]: i32}[] = []

// The pre-order walk behind `findFnDeclIn`: each `FuncDecl` at or below `rootIx` is entered in
// `tab` under its name unless an earlier one already holds it.
function findFnDeclWalk(rootIx: i32, tab: {[string]: i32}) {
  if rootIx < 0 || rootIx >= P.nodes.length { return 0 }
  const n = nodeAt(rootIx)
  if n is FuncDecl {
    if !tab.has(n.fnName) { tab[n.fnName] = rootIx }
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = rootIx
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      findFnDeclWalk(kids[i], tab)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// A call's argument places in callee-parameter order. A UFCS or method callee (`o.m(a)`) puts the
// receiver at parameter 0, which is how `m(o, a)` declares it; every other shape is the written
// argument list.
export function callArgPlaces(cn: Call, callIx: i32) {
  const out: i32[] = []
  if cn.callFn >= 0 {
    const cf = nodeAt(cn.callFn)
    if cf is Member {
      if callDeclFnIx(cn, callIx) >= 0 { out.push(cf.memObj) }
    }
  }
  let i = 0
  while i < cn.callArgs.length {
    out.push(cn.callArgs[i])
    i = i + 1
  }
  out
}

// The parameters of a callback not yet checked whose type is already known, so a write check run
// before its body (`cbElemNarrowFor`) resolves a method called on one (`cbPendCollect`).
export let cbPendNames: string[] = []
export let cbPendTys: i32[] = []

export function cbPendClear() {
  cbPendNames = []
  cbPendTys = []
  0
}

// The type recorded for the method receiver `ix`, or for a not-yet-checked callback parameter
// it names, the type `cbPendCollect` gave it; -1 when neither is known.
export function recvTyOf(ix: i32): i32 {
  const t = nodeTyOf(ix)
  if t >= 0 || cbPendNames.length == 0 { return t }
  let px = ix
  while px >= 0 && px < P.nodes.length && nodeAt(px) is Paren {
    const pn = nodeAt(px)
    if pn is Paren { px = pn.parInner }
  }
  if px < 0 || px >= P.nodes.length { return -1 }
  const n = nodeAt(px)
  if n is Ident {
    const j = strListIndexOf(cbPendNames, n.identName)
    if j >= 0 { return cbPendTys[j] }
  }
  -1
}

// The callee classification behind every invalidation decision: `>= 0` is the `FuncDecl` the call
// resolves to statically, with a UFCS receiver at parameter 0; `-1` is opaque — a function value,
// a struct field holding one, or an unresolved receiver — so assume it writes anything reachable;
// `-2` is an intrinsic, which writes no field of an object handed to it.
export function callDeclFnIx(cn: Call, callIx: i32) {
  if cn.callFn < 0 { return -1 }
  const cf = nodeAt(cn.callFn)
  match cf {
    Ident => {
      const d = identFnDeclOf(cn.callFn)
      if d >= 0 { return d }
      const nd = findFnDeclInRoots(cf.identName)
      if nd >= 0 { return nd }
      if identTyOf(cn.callFn, cf.identName) >= 0 {
        // A binding bound once to a lambda, never re-pointed, calls that lambda's body; the write
        // shapes see a write through an alias of a captured object (D2461). Anything else stays
        // opaque.
        if cwFramedNode(cn.callFn) && cwKeyOfRoot(cn.callFn) >= 0 {
          const ld = cwLambdaDeclOf(cwBindingOf(cn.callFn))
          if ld >= 0 { return ld }
        }
        return -1 // a function VALUE: target unknown
      }
      return -2 // an intrinsic named by a bare identifier
    }
    Member => {
      // A built-in of the receiver's type runs whatever `self`-function shares its name.
      if builtinMethodOn(recvTyOf(cf.memObj), cf.memProp) { return -2 }
      // The declaration the binder recorded for the spelling; a `self` lambda is a value.
      const md = memberDeclOf(cn.callFn)
      if md >= 0 {
        const mf = methodFnOfDecl(md)
        if mf == md { return md }
        if mf >= 0 { return -1 }
        return memberCalleeKind(cf)
      }
      // A `self`-function merged from another module, by the name this site resolved to.
      if callIx >= 0 {
        const ad = fnDeclIx[ufcsAliasAtSite(callIx, cf.memProp)] ?? -1
        if ad >= 0 && methodFnOfDecl(ad) == ad { return ad }
      }
      const nd = findFnDeclInRoots(cf.memProp)
      if nd >= 0 { return nd }
      return memberCalleeKind(cf)
    }
    // any other callee is a value: target unknown
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The declarations a call `callDeclFnIx` answers -1 for may run when its callee names a
// binding: every function stored into it (`cwFnValueTargets`). [] when that set is not known,
// which every caller reads as the opaque -1 (D5017).
export function callFnValueDecls(cn: Call): i32[] {
  if cn.callFn < 0 || cn.callFn >= P.nodes.length { return [] }
  const cf = nodeAt(cn.callFn)
  if !(cf is Ident) { return [] }
  if !cwFramedNode(cn.callFn) || cwKeyOfRoot(cn.callFn) < 0 { return [] }
  cwFnValueTargets(cwBindingOf(cn.callFn))
}

// A non-UFCS member callee: a struct field holding a function is opaque, the value it holds not
// being statically one body; anything else is a collection or string method.
function memberCalleeKind(cf: Member) {
  const rt = recvTyOf(cf.memObj)
  if rt < 0 {
    return -1 // receiver type unresolved → fail closed
  }
  const t = tyAt(rt)
  // A record or a collection has no other built-in method, so one not resolved above is a
  // `self`-function this reading cannot see: opaque.
  if t is TyObj || t is TyArray || t is TyMap { return -1 }
  -2
}

// Whether a receiver of type `rt`, or its non-null part for an optional call, has the built-in
// method `p` (`builtinMethodClaims`). Any other method is a `self`-function or a field.
export function builtinMethodOn(rt: i32, p: string): boolean {
  if rt < 0 { return false }
  builtinMethodClaims(nonNullTy(rt), p)
}

// Whether a built-in method may run a function it is handed: only `map` and `filter` take one.
export function builtinMethodRunsArgs(p: string): boolean {
  p == "map" || p == "filter"
}

// Whether a built-in named by a bare identifier runs none of its arguments.
export function builtinRunsNoArg(nm: string): boolean {
  nm == "print"
    || nm == "Map"
    || nm == "Set"
    || nm == "fromCodePoint"
    || nm == "fromCodePoints"
    || nm == "__str_from_bytes__"
}

// The operand places an operator site hands its declaration, in parameter order: `a op b`,
// `p[i]`, and `p[i] = x`.
export function opSiteArgs(ix: i32): i32[] {
  if crOpOf(ix) == OP_INDEX_GET { return opIndexReadArgs(ix) }
  opBinSiteArgs(ix)
}

// The receiver and subscript of an index read `p[i]`.
function opIndexReadArgs(ix: i32): i32[] {
  const out: i32[] = []
  const n = nodeAt(ix)
  if n is Index {
    out.push(n.idxArr)
    out.push(n.idxIndex)
  }
  out
}

// The operands of `a op b`, or the receiver, subscript and value of `p[i] = x`.
function opBinSiteArgs(ix: i32): i32[] {
  const out: i32[] = []
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "=" {
      const t = nodeAt(n.binLeft)
      if t is Index {
        out.push(t.idxArr)
        out.push(t.idxIndex)
        out.push(n.binRight)
      }
      return out
    }
    out.push(n.binLeft)
    out.push(n.binRight)
  }
  out
}

// The declarations an operator site may run: the one the checker resolved there, else every
// declaration of its operator; -1 stands for an operator closure field, whose body is opaque.
// Empty when the site dispatches to nothing.
export function opSiteDecls(ix: i32): i32[] {
  const out: i32[] = []
  if ix < 0 || ix >= P.nodes.length { return out }
  if crOpOpaque[ix] ?? false {
    out.push(-1)
    return out
  }
  if !crIsDispatchSite(ix) { return out }
  const op = crOpOf(ix)
  const od = opDeclAtNode(ix)
  if od >= 0 {
    out.push(od)
    return out
  }
  // An index into a list, map or string runs the built-in, whatever operators are declared (D5590).
  if (op == OP_INDEX_GET || op == OP_INDEX_SET) && opRecvBuiltinIndexed(ix) {
    return out
  }
  let i = 0
  while i < opIdxOps.length {
    if opIdxOps[i] == op { out.push(fnDeclIx[opIdxFns[i]] ?? -1) }
    i = i + 1
  }
  out
}

// Whether index site `ix`'s receiver is already typed as a list, map or string. A receiver not
// typed yet, or typed by a type variable a pin may still bind to a record, answers false.
function opRecvBuiltinIndexed(ix: i32): boolean {
  const t = opIndexRecvTy(ix)
  if t < 0 || t >= T.tys.length { return false }
  const r = tyAt(t)
  if r is TyArray || r is TyMap { return true }
  r is TyPrim && r.primName == "string"
}

// The recorded type of index site `ix`'s receiver, or -1: not an index site, or not typed yet.
function opIndexRecvTy(ix: i32): i32 {
  const op = crOpOf(ix)
  if op != OP_INDEX_GET && op != OP_INDEX_SET { return -1 }
  const args = opSiteArgs(ix)
  if args.length == 0 { return -1 }
  nodeTyOf(args[0])
}

// Whether `opSiteDecls(ix)` charged every declared index operator only because the receiver has
// no type recorded yet, so an answer built on it must not be kept.
export function opSiteRecvUntyped(ix: i32): boolean {
  if !crIsDispatchSite(ix) || (crOpOpaque[ix] ?? false) { return false }
  if opDeclAtNode(ix) >= 0 { return false }
  const op = crOpOf(ix)
  (op == OP_INDEX_GET || op == OP_INDEX_SET) && opIndexRecvTy(ix) < 0
}

// Whether a node that is not a `Call` may still call a user declaration: a declared binary
// operator, or any index read or index write once the program declares an index operator.
// Asked before the node is checked, so it cannot read which declaration dispatched.
export function crIsDispatchSite(ix: i32): boolean {
  const op = crOpOf(ix)
  if op == OP_INDEX_GET || op == OP_INDEX_SET { return opIdxDeclared() }
  op != "" && isBinOpFuncName(op) && binOpSymDeclared(op)
}

// Map/set intrinsic names, gated exactly as `checkCallNode`'s own arms gate them: `set`/
// `get` are a map surface a set must not leak, and `add` a set surface a map must not.
export function mapMethodNames(recvTy: i32) {
  const out = ["has", "delete", "clear", "keys", "values", "length"]
  const rt = tyAt(recvTy)
  if rt is TyMap {
    if rt.mSet == 0 {
      out.push("set")
      out.push("get")
    }
    if rt.mSet == 1 { out.push("add") }
  }
  out
}

const noMethodNames: string[] = []

// The built-in method names of a receiver of `recvTy`'s representation, from the tables
// above; a record, function, union, nullable, type parameter, literal or negation has none.
export function builtinMethodNamesOf(recvTy: i32): string[] {
  if recvTy < 0 { return noMethodNames }
  const ix = nomErasedTyIx(recvTy)
  if ix < 0 || ix >= T.tys.length { return noMethodNames }
  const t = tyAt(ix)
  match t {
    TyArray => {
      return listMethodNames
    }
    TyMap => {
      return mapMethodNames(ix)
    }
    TyPrim => {
      if t.primName == "string" { return strMethodNames }
    }
    TyErr | TyObj | TyFunc | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {}
  }
  noMethodNames
}

// Whether a built-in method arm of `checkMemberCallNode` claims `recv.prop(…)`. `length` is a
// member read, so its call spelling falls through to a `self`-function.
export function builtinMethodClaims(recvTy: i32, prop: string): boolean {
  if prop == "length" { return false }
  strListHas(builtinMethodNamesOf(recvTy), prop)
}

// What a built-in method does to the cells its receiver holds before the call — the effect
// column every write question reads, the narrowing summaries and the getter effects alike. NONE
// reads or builds; APPENDS adds a cell and leaves every held one untouched; CELLS may replace or
// remove one.
export const BME_NONE = 0
const BME_APPENDS = 1
export const BME_CELLS = 2
export function builtinMethodEffect(p: string): i32 {
  if p == "push" || p == "add" { return BME_APPENDS }
  if p == "pop" || p == "clear" || p == "set" || p == "delete" {
    return BME_CELLS
  }
  BME_NONE
}

// Does the program declare ANY index operator? The single inertness gate: false
// for every program that declares none, and then no index expression anywhere
// does any extra work and nothing is banked.
export function opIdxDeclared() { opIdxFns.length > 0 }

// The declaration of the operator function the checker resolved at site `ix`, or -1.
export function opDeclAtNode(ix: i32): i32 { opSiteDecl[ix] ?? -1 }

// Whether any receiver's declaration of binary operator symbol `op` is registered — the
// pin-deferral gate's question, keyed on the symbol across all receivers, since an operator
// declaration takes no `fnDeclIx` slot.
export function binOpSymDeclared(op: string): boolean {
  let i = 0
  while i < opIdxOps.length {
    if opIdxOps[i] == op {
      if declTyOf(opIdxDecls[i]) >= 0 { return true }
    }
    i = i + 1
  }
  false
}

export function calleeReset() {
  opIdxOps = []
  opIdxFns = []
  opIdxDecls = []
  opSiteDecl = Map()
  weRoots = []
  weFnDeclSlot = Map()
  weFnDeclTabs = []
  cbPendClear()
  0
}

// The callee's written name, for the diagnostic. `"?"` when the callee is neither a
// bare name nor a member access (a parenthesised or computed callee).
export function calleeNameOf(callIx: i32) {
  const cn = nodeAt(callIx)
  if cn is Call {
    if cn.callFn < 0 { return "?" }
    const cf = nodeAt(cn.callFn)
    match cf {
      Ident => {
        return cf.identName
      }
      Member => {
        return cf.memProp
      }
      // a parenthesised or computed callee has no written name
      NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
    }
  }
  "?"
}
