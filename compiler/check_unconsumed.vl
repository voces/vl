// Which functions' results no caller consumes, and the return-shape predicates that question
// shares with the checker and the emitter: whether a body holds a bare `return` or a
// `return <value>`, and whether a statement is the value of a `break v`. Every answer is a walk
// of the node arena; nothing here reads a type, so the checker imports it and it imports only
// `./ast`, `parenPeelIx` and `cwPeel`. `tailValueLeaves` and `joinLeavesOf` follow a value's tails. `ucCompute` fills the table once per program and `fnResultUnconsumed` reads it.
import {
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  OptMember,
  P,
  Param,
  Program,
  RetStmt,
  StrLit,
  TypeRef,
  WhileStmt,
  brkValSeen,
  declExported,
  nodeAt,
  nodeChildren,
  stmtAlwaysExits,
} from "./ast"
import { parenPeelIx } from "./check_places"
import { cwPeel } from "./check_write_scan"

// Un-annotated top-level functions whose result no caller consumes, by declaration node: the
// checker hoists and checks each as `: void` and `computeVoidFns` agrees, so a tail value
// nobody reads is never typed for lowering (D2631). Filled once per program by `ucCompute`.
let fnUnconsumedAt: {[i32]: boolean} = Map()

export function fnResultUnconsumed(fnIx: i32): boolean {
  if fnIx < 0 { return false }
  fnUnconsumedAt[fnIx] ?? false
}

// A walk position: the value is read, discarded, or the tail of candidate `k >= 0` — read
// exactly when that candidate's own result is.
const UC_VALUE = -2
const UC_DISCARD = -1
let ucCandIx: {[string]: i32} = Map()
let ucCandNode: i32[] = []
let ucConsumed: boolean[] = []
// Whether anything calls candidate `k`: a function nothing calls keeps its inferred return.
let ucCalled: boolean[] = []
// Tail calls as one linked list per caller: `ucEdgeHead[k]` is candidate `k`'s first edge.
let ucEdgeHead: i32[] = []
let ucEdgeTo: i32[] = []
let ucEdgeNext: i32[] = []

// A candidate's name: a plain identifier, so no getter (`T.p`) or operator declaration, both
// of which the compiler calls without a name at the site.
function ucNameIsPlain(name: string): boolean {
  if name.length == 0 { return false }
  let i = 0
  while i < name.length {
    const c = name.charCodeAt(i)
    const ok = (c >= 48 && c <= 57)
      || (c >= 65 && c <= 90)
      || (c >= 97 && c <= 122)
    if !ok && c != 95 && c != 36 { return false }
    i = i + 1
  }
  true
}

// Could the top-level declaration at `ix` stop returning its value? Only an un-annotated,
// un-exported plain function with a body, no `self` receiver (a protocol may call one) and no
// `return <value>`.
function ucIsCandidate(ix: i32): boolean {
  const n = nodeAt(ix)
  if !(n is FuncDecl) { return false }
  if n.fnRet >= 0 || !ucNameIsPlain(n.fnName) || declExported(ix) {
    return false
  }
  if n.fnBody < 0 || !(nodeAt(n.fnBody) is Block) { return false }
  if n.fnParams.length > 0 {
    const p0 = nodeAt(n.fnParams[0])
    if p0 is Param {
      if p0.parName == "self" { return false }
    }
  }
  !blockHasValuedRet(n.fnBody)
}

// A use of `name` whose value is read: a candidate so named keeps its result.
function ucUse(name: string) {
  const k = ucCandIx[name] ?? -1
  if k >= 0 { ucConsumed[k] = true }
  0
}

// A call of `name` at position `ctx`.
function ucCallUse(name: string, ctx: i32) {
  const k = ucCandIx[name] ?? -1
  if k < 0 { return 0 }
  ucCalled[k] = true
  if ctx == UC_VALUE {
    ucConsumed[k] = true
  } else if ctx >= 0 {
    ucEdgeTo.push(k)
    ucEdgeNext.push(ucEdgeHead[ctx])
    ucEdgeHead[ctx] = ucEdgeTo.length - 1
  }
  0
}

// Every statement of a block but the last is discarded; the last is at `lastCtx`.
function ucBlock(ix: i32, lastCtx: i32) {
  const b = nodeAt(ix)
  if b is Block {
    const n = b.blkStmts.length
    let i = 0
    while i < n {
      let c = UC_DISCARD
      if i == n - 1 { c = lastCtx }
      // A `break v`'s value is the statement before the break, and it is read.
      if brkValSeen && breakValueAt(b.blkStmts, i) { c = UC_VALUE }
      ucWalk(b.blkStmts[i], c)
      i = i + 1
    }
  }
  0
}

// An `if` or `match` arm: a block takes the arm's position, a bare expression is read.
function ucArm(ix: i32, ctx: i32) {
  if ix < 0 { return 0 }
  if nodeAt(ix) is Block { return ucBlock(ix, ctx) }
  ucWalk(ix, UC_VALUE)
}

// The position a function body's last statement takes: a declared or bare-`return` void
// discards it, a candidate reads it only when its own result is read, anything else reads it.
function ucBodyCtx(ix: i32, n: FuncDecl): i32 {
  if n.fnRet >= 0 {
    const r = nodeAt(n.fnRet)
    if r is TypeRef {
      if r.tyName == "void" { return UC_DISCARD }
    }
    return UC_VALUE
  }
  if n.fnBody >= 0 && blockHasBareReturn(n.fnBody) { return UC_DISCARD }
  const k = ucCandIx[n.fnName] ?? -1
  if k >= 0 && ucCandNode[k] == ix { return k }
  UC_VALUE
}

// Walks `ix` at position `ctx`, recording each candidate use. A nested declaration or a lambda
// is not a candidate, and a candidate's declaration met anywhere but the top level is read.
// The commonest kinds are asked first; every arm is disjoint, so the order changes no answer.
function ucWalk(ix: i32, ctx: i32) {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const at = cur
    const n = nodeAt(at)
    cur = -1
    if n is Ident {
      ucUse(n.identName)
    } else if n is Call {
      if n.callFn < 0 {
        ucWalk(n.callFn, UC_VALUE)
      } else {
        const c = nodeAt(n.callFn)
        if c is Ident {
          ucCallUse(c.identName, ctx)
        } else if c is Member {
          ucCallUse(c.memProp, ctx)
          ucWalk(c.memObj, UC_VALUE)
        } else {
          ucWalk(n.callFn, UC_VALUE)
        }
      }
      let ai = 0
      while ai < n.callArgs.length {
        ucWalk(n.callArgs[ai], UC_VALUE)
        ai = ai + 1
      }
    } else if n is BinExpr {
      ucWalk(n.binLeft, UC_VALUE)
      ucWalk(n.binRight, UC_VALUE)
    } else if n is Member {
      ucUse(n.memProp)
      ucWalk(n.memObj, UC_VALUE)
    } else if (
      n is NumLit
      || n is StrLit
      || n is BoolLit
      || n is NullLit
      || n is CharLit
    ) {
      // A literal has no child and names nothing.
    } else if n is Block {
      ucBlock(at, ctx)
    } else if n is IfStmt {
      ucWalk(n.ifCond, UC_VALUE)
      ucArm(n.ifThen, ctx)
      if n.ifElse >= 0 {
        if nodeAt(n.ifElse) is IfStmt {
          cur = n.ifElse
        } else {
          ucArm(n.ifElse, ctx)
        }
      }
    } else if n is MatchExpr {
      ucWalk(n.matchScrut, UC_VALUE)
      let mi = 0
      while mi < n.matchBodies.length {
        ucArm(n.matchBodies[mi], ctx)
        mi = mi + 1
      }
    } else if n is OptMember {
      ucUse(n.omProp)
      ucWalk(n.omObj, UC_VALUE)
    } else if n is WhileStmt {
      ucWalk(n.whileCond, UC_VALUE)
      // A labelled block's tail is its value, read as the block is.
      let tailCtx = UC_DISCARD
      if n.whileBlk == 1 { tailCtx = ctx }
      ucBlock(n.whileBody, tailCtx)
    } else if n is ForRange {
      ucWalk(n.frFrom, UC_VALUE)
      ucWalk(n.frTo, UC_VALUE)
      ucWalk(n.frStep, UC_VALUE)
      ucBlock(n.frBody, UC_DISCARD)
    } else if n is ForIn {
      ucWalk(n.fiIter, UC_VALUE)
      ucBlock(n.fiBody, UC_DISCARD)
    } else if n is FuncDecl {
      ucFunc(at, n, false)
    } else {
      // Every other kind reads each child it has.
      const kids = nodeChildren(at)
      let ki = 0
      while ki < kids.length {
        ucWalk(kids[ki], UC_VALUE)
        ki = ki + 1
      }
    }
  }
  0
}

function ucFunc(ix: i32, n: FuncDecl, top: boolean) {
  if !top {
    const k = ucCandIx[n.fnName] ?? -1
    if k >= 0 && ucCandNode[k] == ix { ucConsumed[k] = true }
  }
  let pi = 0
  while pi < n.fnParams.length {
    const p = nodeAt(n.fnParams[pi])
    if p is Param { ucWalk(p.parDefault, UC_VALUE) }
    pi = pi + 1
  }
  let bctx = UC_VALUE
  if top { bctx = ucBodyCtx(ix, n) }
  else if n.fnRet >= 0 { bctx = ucBodyCtx(ix, n) }
  ucBlock(n.fnBody, bctx)
  0
}

// Fills `fnUnconsumedAt` for the program at `rootIx`: one walk records each candidate's reads
// and its tail calls, then a read or never-called candidate's tail callees are read too.
export function ucCompute(rootIx: i32) {
  fnUnconsumedAt = Map()
  ucCandIx = Map()
  ucCandNode = []
  ucConsumed = []
  ucCalled = []
  ucEdgeHead = []
  ucEdgeTo = []
  ucEdgeNext = []
  const root = nodeAt(rootIx)
  if !(root is Program) { return 0 }
  const stmts = root.progStmts
  let i = 0
  while i < stmts.length {
    const s = nodeAt(stmts[i])
    if s is FuncDecl {
      // -3 is a name some other top-level declaration holds, so it is never a candidate.
      const prev = ucCandIx[s.fnName] ?? -1
      if prev >= 0 { ucConsumed[prev] = true }
      if prev != -1 || !ucIsCandidate(stmts[i]) {
        ucCandIx[s.fnName] = -3
      } else {
        ucCandIx[s.fnName] = ucCandNode.length
        ucCandNode.push(stmts[i])
        ucConsumed.push(false)
        ucCalled.push(false)
        ucEdgeHead.push(-1)
      }
    }
    i = i + 1
  }
  if ucCandNode.length == 0 { return 0 }
  i = 0
  while i < stmts.length {
    const s = nodeAt(stmts[i])
    if s is FuncDecl {
      ucFunc(stmts[i], s, true)
    } else {
      ucWalk(stmts[i], UC_DISCARD)
    }
    i = i + 1
  }
  let c = 0
  while c < ucCandNode.length {
    if !ucCalled[c] { ucConsumed[c] = true }
    c = c + 1
  }
  ucSettle()
  let k = 0
  while k < ucCandNode.length {
    if !ucConsumed[k] { fnUnconsumedAt[ucCandNode[k]] = true }
    k = k + 1
  }
  0
}

// Marks every candidate a read candidate tail-calls as read, transitively: a worklist over the
// edge lists, so each edge is followed once.
function ucSettle() {
  const work: i32[] = []
  let k = 0
  while k < ucConsumed.length {
    if ucConsumed[k] { work.push(k) }
    k = k + 1
  }
  let wi = 0
  while wi < work.length {
    const from = work[wi]
    wi = wi + 1
    let e = ucEdgeHead[from]
    while e >= 0 {
      const to = ucEdgeTo[e]
      if !ucConsumed[to] {
        ucConsumed[to] = true
        work.push(to)
      }
      e = ucEdgeNext[e]
    }
  }
  0
}

// Does the node hold a `return <value>`, in any statement or expression but a nested function?
function blockHasValuedRet(ix: i32): boolean {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const at = cur
    const n = nodeAt(at)
    cur = -1
    if n is RetStmt {
      if n.retArg >= 0 { return true }
    } else if n is FuncDecl {
      return false
    } else if n is IfStmt {
      if blockHasValuedRet(n.ifCond) || blockHasValuedRet(n.ifThen) {
        return true
      }
      cur = n.ifElse
    } else {
      const kids = nodeChildren(at)
      let ki = 0
      while ki < kids.length {
        if blockHasValuedRet(kids[ki]) { return true }
        ki = ki + 1
      }
    }
  }
  false
}

// Does the block hold a bare `return`, recursing into if/while/for bodies but never into a
// nested function, whose returns are its own? A bare `return` is legal only where nothing is
// owed, so one anywhere in a body is the author writing `: void`; the checker pins the return
// type from it and `computeVoidFns` asks this same predicate for the functype (D1600).
export function blockHasBareReturn(blockIx: i32): boolean {
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const st = nodeAt(stmts[i])
      if st is RetStmt {
        if st.retArg < 0 { return true }
      } else if st is IfStmt {
        if ifChainHasBareReturn(stmts[i]) { return true }
      } else if st is WhileStmt {
        if blockHasBareReturn(st.whileBody) { return true }
      } else if st is ForRange {
        if blockHasBareReturn(st.frBody) { return true }
      } else if st is ForIn {
        if blockHasBareReturn(st.fiBody) { return true }
      }
      i = i + 1
    }
  }
  false
}

// The `else if` hop of `blockHasBareReturn`: a chain's arms are the same question.
function ifChainHasBareReturn(ifIx: i32): boolean {
  let cur = ifIx // walks the chain's spine, so its depth costs no stack (D1990)
  while cur >= 0 {
    const st = nodeAt(cur)
    cur = -1
    if st is IfStmt {
      if blockHasBareReturn(st.ifThen) { return true }
      if st.ifElse >= 0 {
        if nodeAt(st.ifElse) is IfStmt { cur = st.ifElse }
        else if blockHasBareReturn(st.ifElse) { return true }
      }
    }
  }
  false
}

// Whether `stmts[i]` is the value of a `break v`: the next statement is a break carrying one.
export function breakValueAt(stmts: i32[], i: i32): boolean {
  if i + 1 >= stmts.length { return false }
  const bi = stmts[i + 1]
  if bi < 0 || bi >= P.nodes.length { return false }
  const b = nodeAt(bi)
  if b is BreakStmt { return b.brkHasVal == 1 }
  false
}

// When `p` is an `if`, queues its then arm and its else arm or `else if` link.
export function tailPushIfArms(p: i32, todo: i32[]): boolean {
  const n = nodeAt(p)
  if n is IfStmt {
    todo.push(n.ifThen)
    if n.ifElse >= 0 { todo.push(n.ifElse) }
    return true
  }
  false
}

// When `p` is a `match` not yet desugared, queues each arm's body.
export function tailPushMatchArms(p: i32, todo: i32[]): boolean {
  const n = nodeAt(p)
  if n is MatchExpr {
    let i = 0
    while i < n.matchBodies.length {
      todo.push(n.matchBodies[i])
      i = i + 1
    }
    return true
  }
  false
}

// When `p` is a block, queues its last statement unless the one before it exits.
export function tailPushBlockTail(p: i32, todo: i32[]): boolean {
  const n = nodeAt(p)
  if n is Block {
    const k = n.blkStmts.length
    if k == 1 { todo.push(n.blkStmts[0]) }
    if k > 1 {
      if !stmtAlwaysExits(n.blkStmts[k - 2]) { todo.push(n.blkStmts[k - 1]) }
    }
    return true
  }
  false
}

// The value expressions a tail at `ix` yields: each arm of an `if`/`else` or `match`, followed
// down nested ones and an arm's block tail, else `ix` itself. A worklist, so a long `else if`
// chain costs no stack. A block whose tail follows an exit yields nothing (D2234).
export function tailValueLeaves(ix: i32, out: i32[]) {
  const todo: i32[] = [ix]
  while todo.length > 0 {
    const at = cwPeel(todo.pop() ?? -1)
    if at >= 0 && at < P.nodes.length {
      if (
        !tailPushIfArms(at, todo)
        && !tailPushMatchArms(at, todo)
        && !tailPushBlockTail(at, todo)
      ) {
        out.push(at)
      }
    }
  }
  0
}

// Every `if` and `match` whose value is `ix`'s, through arms and block tails.
export function joinLeavesOf(ix: i32): i32[] {
  const out: i32[] = []
  const todo: i32[] = [ix]
  let guard = 0
  while todo.length > 0 && guard < 64 {
    guard = guard + 1
    const at = parenPeelIx(todo.pop() ?? -1)
    if at >= 0 && at < P.nodes.length {
      const an = nodeAt(at)
      if an is IfStmt || an is MatchExpr { out.push(at) }
      if !tailPushIfArms(at, todo) && !tailPushMatchArms(at, todo) {
        tailPushBlockTail(at, todo)
      }
    }
  }
  out
}
