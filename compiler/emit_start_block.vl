// `emit_start_block.vl` — the start block's `let` rows, and the narrowed value,
// map or ref array a read resolves to.

import {
  BinExpr,
  Block,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  LetDecl,
  Param,
  TypeRef,
  WhileStmt,
  nodeAt,
} from "./ast"
import { nodeTyIsUnionAlias } from "./check_decl_scan"
import { nodeTyPinIxOf } from "./check_hole_pins"
import { luDeclPosOf } from "./check_list_union"
import { isValueUnionName, nameIsLitUnionArmValueUnion } from "./check_ty_rep"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  tyAt,
  tyEmitNameNonEmpty,
  tyIsLitUnion,
  tyIsNulValueUnionBox,
  tyLitMemberTexts,
} from "./check_types"
import { annRetNameOf, normTypeAtom, unwrapParen } from "./emit_base"
import { nodeTyAt } from "./emit_capture_frames"
import { bodyLetReadAtSid } from "./emit_fn_ret_kinds"
import {
  sblSortCount,
  sblSortStart,
  sblSortedCand,
  sblSortedOwner,
  sblSortedPos,
  sblSortedSkip,
  sblStamp,
  sblVal,
} from "./emit_lit_atoms"
import { unMemRefArrArmSlot } from "./emit_map_value_slots"
import { globalLetOfSid, slotLetDecl } from "./emit_narrow_slots"
import { paramTypeNode } from "./emit_query"
import { boxTagOfTy, unRowOfKey } from "./emit_rep"
import { tyIsRefArray } from "./emit_shape_rows"
import { fnBlockShadowsAt } from "./emit_sig_tokens"
import {
  localDeclIx,
  scopeSlotOf,
  startStmts,
  unMemTyCount,
  unNames,
  unVarCount,
} from "./emit_state"
import { declaredKind } from "./emit_struct_order"
import { holeOperandTyOf, pinSubOperandTyOf } from "./emit_ty_canon"
import {
  UNION_SPELLING_DECLINE,
  annRowOfNode,
  unionArmMemberTys,
  unionHasMapArm,
  unionSpellingOfTy,
  valueUnionKeyTextOfTy,
  valueUnionNameOfTy,
} from "./emit_union_atoms"
import { SCRATCH_BY_CODE, scratchSlot } from "./emit_union_casts"
import {
  isUNameDeclAB,
  unMemIsMap,
  unMemIsRefElemArray,
  unRowOfCanon,
  unRowOfName,
  unionNameNonNullCount,
  unionRowNameAB,
} from "./emit_union_registry"
import {
  identDeclOf,
  sidArrGet,
  sidArrPut,
  sidOfNode,
  sidText,
} from "./symbols"
import { nameIsParenOpen } from "./tyname"
import { intLitUnionBasesOf, tyHasTyVar, tyIsUnionShaped } from "./tyquery"

// True if the parameter `name` of function `fnIx` is the union type.
export function paramUnion(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  // STRUCTURAL fast-path (C1): a recorded declared value-union param, else the name test.
  if nodeTyIsUnionAlias(pt) { return true }
  false
}

// True if the already-collected declared local `name` is a union ref (code `4`).
export function declaredUnion(name: string) { declaredKind(name) == "union" }

// Whether node `ix` has a union type whose members are all integer literals (`1 | 2`).
export function nodeTyIsNumLitUnion(ix: i32, fnIx: i32): boolean {
  const ty = nodeTyAt(ix, fnIx)
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyUnion {
    if t.uMembers.length < 2 { return false }
    // Integer members of two widths are the value box, not one scalar (D3491).
    if intLitUnionBasesOf(ty).length > 0 { return false }
    let i = 0
    while i < t.uMembers.length {
      const m = tyAt(t.uMembers[i])
      if m is TyLit {
        if m.litKind != "int" { return false }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}

// Every start-scope `LetDecl` binding `targetSid`, appended to `tmpCand`/`tmpOwner` in
// ascending arena order. A direct walk of `ix`'s own ladder, not `parentLetOfAt`'s: that
// primitive rebuilds a whole per-block plan on every distinct blockIx, which is the cost
// this avoids over many siblings (D2326 perf).
function sblFind(
  ix: i32,
  owner: i32,
  targetSid: i32,
  tmpCand: i32[],
  tmpOwner: i32[],
) {
  if ix < 0 { return 0 }
  const st = nodeAt(ix)
  if st is LetDecl {
    if sidOfNode(ix) == targetSid {
      tmpCand.push(ix)
      tmpOwner.push(owner)
    }
  } else if st is IfStmt {
    let cur = ix
    while cur >= 0 {
      const c = nodeAt(cur)
      cur = -1
      if c is IfStmt {
        sblFind(c.ifThen, c.ifThen, targetSid, tmpCand, tmpOwner)
        if c.ifElse >= 0 {
          if nodeAt(c.ifElse) is IfStmt {
            cur = c.ifElse
          } else {
            sblFind(c.ifElse, c.ifElse, targetSid, tmpCand, tmpOwner)
          }
        }
      }
    }
  } else if st is WhileStmt {
    sblFind(st.whileBody, st.whileBody, targetSid, tmpCand, tmpOwner)
  } else if st is ForRange {
    sblFind(st.frBody, st.frBody, targetSid, tmpCand, tmpOwner)
  } else if st is ForIn {
    sblFind(st.fiBody, st.fiBody, targetSid, tmpCand, tmpOwner)
  } else if st is Block {
    const stmts = st.blkStmts
    let i = 0
    while i < stmts.length {
      sblFind(stmts[i], ix, targetSid, tmpCand, tmpOwner)
      i = i + 1
    }
  }
  0
}

// The `LetDecl` for a module-scope binding declared inside a top-level block, or -1 — a
// start-function local neither `globalLetOf` nor `parentLetOf` can see. Memoized per sid
// (`sblStamp`) over a fresh `sblFind` search of every start statement, never `parentLetOf`'s
// plan cache (D2326).
function startBlockLetRowOfSid(sid: i32) {
  if startStmts.length < 1 { return -1 }
  if sid < 0 { return -1 }
  if sidArrGet(sblStamp, sid) == 1 { return sidArrGet(sblVal, sid) }
  const tmpCand: i32[] = []
  const tmpOwner: i32[] = []
  let si = 0
  while si < startStmts.length {
    sblFind(startStmts[si], startStmts[si], sid, tmpCand, tmpOwner)
    si = si + 1
  }
  const found = sblBuildSorted(sid, tmpCand, tmpOwner)
  sidArrPut(sblStamp, sid, 1)
  sidArrPut(sblVal, sid, found)
  found
}

// Builds `sid`'s sorted-plus-skip slice from `tmpCand`/`tmpOwner` (already ascending — one
// monotonic-stack pass, `plBuildSortedDup`'s own shape) and answers the first (smallest)
// binding, `startBlockLetRowOfSid`'s unpositioned answer.
function sblBuildSorted(sid: i32, tmpCand: i32[], tmpOwner: i32[]): i32 {
  const start = sblSortedCand.length
  const stack: i32[] = []
  let j = 0
  while j < tmpCand.length {
    const cand = tmpCand[j]
    const cpos = luDeclPosOf(cand)
    while stack.length > 0 && sblSortedOwner[stack[stack.length - 1]] <= cpos {
      stack.pop()
    }
    let skip = -1
    if stack.length > 0 { skip = stack[stack.length - 1] }
    const idx = sblSortedCand.length
    sblSortedCand.push(cand)
    sblSortedPos.push(cpos)
    sblSortedOwner.push(tmpOwner[j])
    sblSortedSkip.push(skip)
    stack.push(idx)
    j = j + 1
  }
  sidArrPut(sblSortStart, sid, start)
  sidArrPut(sblSortCount, sid, tmpCand.length)
  if tmpCand.length > 0 { return tmpCand[0] }
  -1
}

// The start-block binding of `sid` the resolver bound the read at `atIx` to, or -1 when it bound
// none of them (or `atIx` is unknown).
function startBlockLetBoundOf(sid: i32, atIx: i32): i32 {
  if atIx < 0 || startBlockLetRowOfSid(sid) < 0 { return -1 }
  const rd = identDeclOf(atIx)
  if rd < 0 { return -1 }
  const start = sidArrGet(sblSortStart, sid)
  const count = sidArrGet(sblSortCount, sid)
  let r = start
  while r < start + count {
    if sblSortedCand[r] == rd { return rd }
    r = r + 1
  }
  -1
}

// `startBlockLetRowOfSid`, positioned: the memoized unpositioned answer gates the search,
// skipped when `sid` binds nowhere at start scope. Otherwise binary searches `sid`'s
// sorted-plus-skip slice for the rightmost binding `< atIx`, then follows the skip column —
// no statement's plan is rebuilt and no other sid's rows are walked (D2326).
function startBlockLetRowOfAt(sid: i32, atIx: i32) {
  const first = startBlockLetRowOfSid(sid)
  if first < 0 { return -1 }
  if atIx < 0 { return first }
  const start = sidArrGet(sblSortStart, sid)
  const count = sidArrGet(sblSortCount, sid)
  // A read the resolver bound to one of these bindings denotes it wherever its node sits, so
  // a rewrite's minted read past every block's arena range still finds its own (D5771).
  const rd = startBlockLetBoundOf(sid, atIx)
  if rd >= 0 { return rd }
  let lo = 0
  let hi = count - 1
  let pos = -1
  while lo <= hi {
    const mid = (lo + hi) / 2
    if sblSortedPos[start + mid] < atIx {
      pos = mid
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  let k = start + pos
  let searching = pos >= 0
  let best = -1
  while searching && k >= start {
    if atIx <= sblSortedOwner[k] {
      best = sblSortedCand[k]
      searching = false
    } else {
      k = sblSortedSkip[k]
      if k < start { searching = false }
    }
  }
  best
}

// The start-block `LetDecl` a read of `sid` denotes, or -1 — the one home both union rungs
// consult. The live lexical slot (`scopeSlotOf` → `localDeclIx`, unaffected by `atIx`)
// outranks the sibling-block scan `startBlockLetRowOfAt` positions (D2326); only reached at
// module scope, since a function-scope caller's own scan runs first. D1593.
export function startBlockLetOfAt(sid: i32, fnIx: i32, atIx: i32) {
  // A read the resolver bound to one of `sid`'s start-block bindings denotes it, whatever the
  // live slot holds: a chase into an outer binding's initializer runs under an inner shadow (D9681).
  const rd = startBlockLetBoundOf(sid, atIx)
  if rd >= 0 { return rd }
  if fnIx < 0 {
    const slot = scopeSlotOf(sidText(sid))
    if slot >= 0 && slot < localDeclIx.length { return slotLetDecl(slot) }
  }
  startBlockLetRowOfAt(sid, atIx)
}

// The declaration's arena type for a union-typed ident — `unionNameOfIdentSid`'s type-taking
// twin, arm for arm over its two annotation arms (D1491). Answers from the annotation's type,
// not the expression's, since a narrowed read's own type differs from what names its member
// set; the inferred/captured/loop-var arms answer -1, an honest "no id here".
export function letUnionDeclTyIxOf(letIx: i32): i32 {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 { return annRowOfNode(d.letType) }
  }
  -1
}

// The binding's type: its annotation's, else an un-annotated initializer's own type read in
// frame `fnIx` (the type `letUnionNameOf` names an inferred union by), else -1.
export function letUnionTyIxOf(letIx: i32, fnIx: i32): i32 {
  if letIx < 0 { return -1 }
  const a = letUnionDeclTyIxOf(letIx)
  if a >= 0 { return a }
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType < 0 && d.letInit >= 0 { return nodeTyAt(d.letInit, fnIx) }
  }
  -1
}

// `unionDeclTyIxOfIdentSid`'s positioned form, same shape as `unionNameOfIdentAt` (D2326):
// `atIx` picks among sibling blocks binding one name, and a block shadow of a same-named
// parameter wins over the param's own annotation (`fnBlockShadowsAt`, D2325) — the two rungs
// answer the same binding, so they must agree on which one that is.
export function unionDeclTyIxOfIdentAt(sid: i32, fnIx: i32, atIx: i32): i32 {
  identBindingTyAt(sid, fnIx, atIx, false)
}

// The same binding's type with an un-annotated `let`'s initializer answering too
// (`letUnionTyIxOf`); a captured or loop-variable binding still answers -1.
export function unionTyIxOfIdentAt(sid: i32, fnIx: i32, atIx: i32): i32 {
  identBindingTyAt(sid, fnIx, atIx, true)
}

function letBindingTy(letIx: i32, fnIx: i32, inferred: boolean): i32 {
  if inferred { return letUnionTyIxOf(letIx, fnIx) }
  letUnionDeclTyIxOf(letIx)
}

function identBindingTyAt(
  sid: i32,
  fnIx: i32,
  atIx: i32,
  inferred: boolean,
): i32 {
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl {
      const body = fn.fnBody
      const params = fn.fnParams
      // Cheap scan first — see `unionNameOfIdentAt`'s identical guard for why.
      let pIx = -1
      let i = 0
      while i < params.length {
        if sidOfNode(params[i]) == sid {
          pIx = params[i]
          break
        }
        i = i + 1
      }
      if pIx >= 0 && !fnBlockShadowsAt(fnIx, sid, atIx) {
        const p = nodeAt(pIx)
        if p is Param { return annRowOfNode(p.parType) }
      }
      const li = bodyLetReadAtSid(body, sid, atIx)
      if li >= 0 { return letBindingTy(li, fnIx, inferred) }
    }
  }
  const gi = globalLetOfSid(sid)
  if gi >= 0 { return letBindingTy(gi, -1, inferred) }
  const bl = startBlockLetOfAt(sid, fnIx, atIx)
  if bl >= 0 { return letBindingTy(bl, -1, inferred) }
  -1
}

// The same question of an expression: the declaration's type where the ident has one, else
// the node's own — mirroring `letUnionNameOf`'s annotation-first, expression-second order.
// The fallback is load-bearing: without it, an ident resolvable through its declaration
// loses that answer and reports no type instead.
export function unionDeclTyIxOfExpr(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const e = nodeAt(unwrapParen(exprIx))
  if e is Ident {
    const un = unwrapParen(exprIx)
    const di = unionDeclTyIxOfIdentAt(sidOfNode(un), fnIx, un)
    if di >= 0 { return di }
  }
  nodeTyAt(unwrapParen(exprIx), fnIx)
}

// The declared type of the binding identifier `exprIx` reads, or -1 for any other expression
// and for an unannotated binding: never the read's own type, which may narrow the box's union.
export function unionDeclTyIxOfIdentRead(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  if !(nodeAt(unwrapParen(exprIx)) is Ident) { return -1 }
  const un = unwrapParen(exprIx)
  unionDeclTyIxOfIdentAt(sidOfNode(un), fnIx, un)
}

// The UNION return of a function-type NAME (`(i32) => A | B` → "A | B", an alias `(i32) => Sh` → its
// member set via its union row), or "" when the name is not a function type returning a multi-member union.
export function unionRetOfFnType(fnTyName: string) {
  // Mirrors `annRetNameOf`'s gate (#1144) and `emit_base.nameIsParenOpen`'s open-only test,
  // hoisted ahead of the scan as in the `forceCloResult*` twins.
  if nameIsParenOpen(fnTyName) {
    const ret0 = annRetNameOf(fnTyName)
    if ret0 == "" { return "" }
    return unionRetName(normTypeAtom(ret0))
  }
  ""
}

// `ret` when a function result of that name boxes as a union, else "".
export function unionRetName(ret: string) {
  if isUNameDeclAB(73, ret) { return ret }
  if isValueUnionName(ret) { return ret }
  // A value union with a litunion-alias arm (`K0 | i64`) is neither a registered union alias
  // nor `isValueUnionName`, yet still boxes as a value union via the alias arm's atom.
  if nameIsLitUnionArmValueUnion(ret) { return ret }
  ""
}

// The union return-type NAME of a closure-typed PARAM `name` of function `fnIx` (`g: (i32) => A | B`
// → "A | B"), or "" when `name` is not a union-returning closure param. Lets a value call THROUGH a
// closure param (`g(x)` inside a HOF) classify its result union so a narrowed read unboxes.
export function paramUnionRetName(fnIx: i32, name: string) {
  if fnIx < 0 { return "" }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    let i = 0
    while i < fn.fnParams.length {
      const p = nodeAt(fn.fnParams[i])
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            const ty = nodeAt(p.parType)
            if ty is TypeRef { return unionRetOfFnType(ty.tyName) }
          }
          return ""
        }
      }
      i = i + 1
    }
  }
  ""
}

// The registered name of a MIXED union — one carrying both a struct VARIANT arm and a value
// atom — that node `ix`'s own type is, or "". A `??` result reps as the value box exactly
// there: an all-atom union is `isValueUnionName`'s, and a literal union is an interned i32 this
// must not claim, which is what asking for a variant arm excludes (D1703).
export function nodeMixedUnionName(ix: i32): string {
  const nm = nodeRegisteredUnionName(ix)
  if nm == "" { return "" }
  const u = unRowOfName(nm)
  if u < 0 { return "" }
  if unVarCount[u] < 1 { return "" }
  // The ROW's member count, not the name's: a registered union answers by its ALIAS here, and
  // `unionMemberCount` reads a `|`-joined spelling, so an alias would count as one member and
  // every mixed row would read as all-variant.
  if unVarCount[u] >= unMemTyCount[u] { return "" }
  nm
}

// Whether union `ty` has a string-literal member, directly or through a literal-union member;
// a numeric literal union (`0 | 1`) is its base scalar and holds none.
function unionHoldsStrLit(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  let u = ty
  const t = tyAt(ty)
  if t is TyNullable { u = t.nInner }
  if u < 0 || u >= T.tys.length { return false }
  const ut = tyAt(u)
  if !(ut is TyUnion) { return false }
  for m in ut.uMembers {
    if tyIsLitUnion(m) { return true }
    if m >= 0 && m < T.tys.length {
      const mt = tyAt(m)
      if mt is TyLit {
        if mt.litKind == "str" { return true }
      }
    }
  }
  false
}

// The registered row of node `ix`'s type inside `fnIx` (an instance reads its hole's pin), when
// that type is a union other than a literal union, or "". A `??` joining a scalar to a literal
// union (`i32 | "a" | "b"`) is the value box, and neither the value-union render nor the mixed
// rung names its row.
export function nodeJoinRowName(ix: i32, fnIx: i32): string {
  let pin = nodeTyPinIxOf(ix)
  const held = holeOperandTyOf(ix, fnIx)
  if held >= 0 { pin = held }
  if (
    pin < 0
    || !tyIsUnionShaped(pin)
    || tyIsLitUnion(pin)
    || !unionHoldsStrLit(pin)
  ) {
    return ""
  }
  unionRowNameAB(4, "", pin)
}

// The registered name of a union carrying at least one struct VARIANT or map arm, or "". Wider
// than `nodeMixedUnionName`, whose second clause also excludes an ALL-variant join (`A | B`);
// both exclude a literal union, which is an interned i32 and not a box. A map arm boxes under
// its own tag with no variant row, so a join of two maps is the box too (D2666).
export function nodeVariantUnionName(ix: i32): string {
  const nm = nodeRegisteredUnionName(ix)
  if nm == "" { return "" }
  const u = unRowOfName(nm)
  if u < 0 { return "" }
  if unVarCount[u] < 1 && !unionHasMapArm(nm) { return "" }
  nm
}

// The union a `??` RESULT reps as, or "": the checker's own type for the node when its render
// names a value union, else the variant-bearing row keyed on the node's canon. One home, so
// the lowering, the destination and the stash reservation cannot disagree about the rep.
export function coalesceResultUnionName(ix: i32): string {
  const nm = unionSpellingOfTy(nodeTyPinIxOf(ix), 8)
  if nm != UNION_SPELLING_DECLINE {
    if isValueUnionName(nm) { return nm }
    // A join grouping string literals into a literal-union arm (`K|i32`) boxes as its row (D2952).
    if nameIsLitUnionArmValueUnion(nm) && unRowOfName(nm) >= 0 { return nm }
  }
  const vn = nodeVariantUnionName(ix)
  if vn != "" { return vn }
  // A row whose arm is a list of lists is a box too, though it has no variant (D2819).
  const rn = nodeRegisteredUnionName(ix)
  if rn != "" && unionHasRefArrayArm(rn) { return rn }
  ""
}

// Does the union row `name` carry an arm that is a list of references?
function unionHasRefArrayArm(name: string): boolean {
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return false }
  let i = 0
  while i < mems.length {
    if unMemRefArrArmSlot(mems[i]) >= 0 { return true }
    i = i + 1
  }
  false
}

// Is the `??` at `ix` typed as a union box, two or more non-null members under one row? Then
// no single record row answers for its value, whatever rep its left operand has (D2373).
export function coalesceResultIsBox(ix: i32): boolean {
  if ix < 0 { return false }
  const e = nodeAt(ix)
  if e is BinExpr {
    if e.binOp != "??" { return false }
    // The arena answers first: a result that is no union, or a one-member niche, renders nothing.
    let rt = nodeTyPinIxOf(ix)
    if rt < 0 || rt >= T.tys.length { return false }
    const rtt = tyAt(rt)
    if rtt is TyNullable { rt = rtt.nInner }
    if rt < 0 || rt >= T.tys.length { return false }
    const rtu = tyAt(rt)
    if !(rtu is TyUnion) { return false }
    if rtu.uMembers.length < 2 { return false }
    const jn = coalesceResultUnionName(ix)
    if jn == "" { return false }
    return unionNameNonNullCount(jn) >= 2
  }
  false
}

// The first operand of a left-nested `??` chain, parens peeled: `emitCoalesceGo` lowers
// `(a ?? b) ?? d` as `a ?? (b ?? d)` under the chain's type, so `a` is the operand whose
// niche the lowering tests, never the inner link's box.
export function coalesceChainLeftmost(ix: i32): i32 {
  let l = unwrapParen(ix)
  let more = true
  while more && l >= 0 {
    more = false
    const ln = nodeAt(l)
    if ln is BinExpr {
      if ln.binOp == "??" {
        l = unwrapParen(ln.binLeft)
        more = true
      }
    }
  }
  l
}

// The registered union a node's own type is, when its render cannot name it: an inference
// (a desugared `??`, a hole-param call) renders its union arms structurally, so a name-keyed
// registry scan finds nothing. `unRowOfCanon` answers from the canon-keyed reverse index
// instead, naming the row every downstream member-set, narrow and variant lookup keys on. D1561.
export function nodeRegisteredUnionName(ix: i32): string {
  const ty = nodeTyPinIxOf(unwrapParen(ix))
  if ty < 0 { return "" }
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less. A nullable union is a union too — `string | A | null`
  // interns as `TyNullable` over the non-null members — and the `unRowOfCanon` scan is a pass
  // over every registered row, so only those two shapes pay it.
  match t {
    TyUnion => {
      if t.uMembers.length < 2 { return "" }
      const u = unRowOfCanon(ty)
      if u >= 0 { return unNames[u] }
    }
    TyNullable => {
      // The inner is an arena HOLE for a never-filled `let x = null` (`mkNullableTy(-1)`), so
      // the index is bound-tested before the read — unguarded it trapped the compiler (D1721).
      if t.nInner < 0 { return "" }
      const it = tyAt(t.nInner)
      if it is TyUnion {
        if it.uMembers.length < 2 { return "" }
        if tyIsLitUnion(t.nInner) { return "" }
        const nu = unRowOfCanon(ty)
        if nu >= 0 { return unNames[nu] }
      }
    }
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyLit | TyNeg => {
      // Not a union shape; no registered row to name.
    }
  }
  ""
}

// The union a value `if`'s JOIN reps as, read off the join's own recorded type and never off
// an arm alone: an arm narrowed by the `if`'s own condition (`if n != null { n } …`) keeps its
// declared union, while the join is the bare scalar. "" when the join is not a union.
export function ifJoinUnionName(ifIx: i32) {
  // Through the banked pin, as the `??` arm below is: a `??` in an ARM makes the join a
  // deferred hole, and without this name the pinned face falls to a numeric block type (D1702).
  const pin = nodeTyPinIxOf(ifIx)
  const vu = valueUnionNameOfTy(pin)
  if vu != "" { return vu }
  // A pin with a hole has no row; a cycle (-1) is asked, as its render may be non-empty.
  if tyEmitNameNonEmpty(pin) != 0 {
    const jn = unionRowNameAB(4, "", pin)
    if jn != "" { return jn }
  }
  // A `??` over a declared struct union desugars to this `if`, whose recorded type renders
  // structurally, so the two rungs above miss it — named off the type instead. D1561.
  const irn = nodeRegisteredUnionName(ifIx)
  if irn != "" { return irn }
  // A nullable box join no rung above names (a map `??` over a union value): the row its type
  // keys to, `null` included, so an arm that is a nullable niche boxes its null as the union's
  // null (D2251).
  nulValueUnionBoxRowName(pin)
}

// `ifJoinUnionName` inside function `fnIx`, where a join over an instance's type parameters
// is named at the pin (D3528).
export function ifJoinUnionNameIn(ifIx: i32, fnIx: i32): string {
  const own = ifJoinUnionName(ifIx)
  if own != "" { return own }
  const t = nodeTyPinIxOf(ifIx)
  if t < 0 || !tyHasTyVar(t) { return "" }
  const ps = pinSubOperandTyOf(t, fnIx)
  if ps < 0 { return "" }
  const vu = valueUnionKeyTextOfTy(ps)
  if vu != "" { return vu }
  nulValueUnionBoxRowName(ps)
}

// The name of the row a nullable value-union box `ty` keys to, else "".
function nulValueUnionBoxRowName(ty: i32): string {
  if !tyIsNulValueUnionBox(ty) { return "" }
  const u = unRowOfKey(ty)
  if u < 0 { return "" }
  unNames[u]
}

// The value-atom kind a read of checked type `ty` unboxes to from a union box, or -1 when `ty`
// is no single atom (a union, null, a struct).
export function readAtomKindOfTy(ty: i32): i32 {
  const k = boxTagOfTy(ty)
  if k == 6 { -1 } else { k }
}

// The container a read of checked type `ty` unboxes to from a union box: `RC_REF_LIST` for a
// list the ref-list layer names a row for, `RC_MAP` for a map, 0 for anything else.
export const RC_REF_LIST = 101
export const RC_MAP = 102
export function readContainerKindOfTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return 0 }
  if unMemIsMap(ty) { return RC_MAP }
  if !(tyAt(ty) is TyArray) { return 0 }
  if readAtomKindOfTy(ty) >= 0 { return 0 }
  if unMemIsRefElemArray(ty) && tyIsRefArray(ty) { return RC_REF_LIST }
  0
}

// The stash a niche read parks a field's or cell's box in between its tag test and its payload
// read. It shares the literal-`is` stash, code 17: neither holds it across any user code.
export function nicheReadStashSlot() {
  scratchSlot(17, "i32", 0, SCRATCH_BY_CODE)
}

// The niche kind of a nullable literal union read out of a box: the atom id, `-1` for null.
export const NICHE_NUL_LIT = 3

// The member texts of a nullable literal union `ty`, read through its `null`.
export function nulLitMemberTexts(ty: i32): string[] {
  if ty >= 0 {
    const t = tyAt(ty)
    if t is TyNullable { return tyLitMemberTexts(t.nInner) }
  }
  tyLitMemberTexts(ty)
}
