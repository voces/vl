// `emit_atom_kinds.vl` — which value-atom kind a type, list element or declared row
// field lowers as, and whether a declared row's scalar fields fit an instance.

import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  nodeAt,
} from "./ast"
import { nodeRepTyIxOf } from "./check_core_state"
import { isVarTyIxOf } from "./check_list_union"
import { nodeTyIxOf } from "./check_node_tys"
import { nodeTyAt } from "./emit_capture_frames"
import { holeFnArgRetAtParams } from "./check_relate_core"
import { nomErasedTyIx } from "./check_ty_rep"
import {
  PrimName,
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  litBaseTy,
  tyAt,
  tyEq,
  tyFieldTyOf,
  tyIsLitUnionArray,
  tyIsLitUnionOrLit,
  tyPrimNameOf,
} from "./check_types"
import { objFieldVal, unionEqOperandOk, unwrapParen } from "./emit_base"
import {
  declTyIxOfName,
  repCanonId,
  repNameCanonId,
  repRowId,
  sFieldElemTyIxAt,
} from "./emit_rep"
import {
  FC_I32,
  FC_I32_LIST,
  armFieldElemTyIx,
  armFieldTypes,
  fnStmts,
  sAnonOwnTy,
  sFieldCount,
  sFieldElemName,
  sFieldElemTyIx,
  sFieldNames,
  sFieldStart,
  sFieldTypes,
  sIsRefRow,
  sNames,
  sTyIx,
  uFieldStart,
  uVarTyIx,
} from "./emit_state"
import { memoKeyNew, memoPassMoved } from "./memo"
import { strContains } from "./strutil"
import { hashMixPair } from "./hash_mix"
import { recFitNarrowedFields } from "./check_fit_rules"
import { nonNullTy, tyHasTyVar } from "./tyquery"

// The wasm-type code (`0` i32, `3` string, `4` i32-list, `5` ref-list) of struct `si`'s
// field at field index `fi`.
export function sFieldTypeAt(si: i32, fi: i32) {
  sFieldTypes[sFieldStart[si] + fi]
}

// The ref-list element type-name of struct `si`'s field `fi` (a code-5 field), "" otherwise.
export function sFieldElemNameAt(si: i32, fi: i32) {
  sFieldElemName[sFieldStart[si] + fi]
}

// The `sFieldElemTyIxAt` twin for variant fields (`uFieldElemTyIx`).
export function uFieldElemTyIxAt(vi: i32, fi: i32): i32 {
  const ix = uFieldStart[vi] + fi
  if ix >= armFieldElemTyIx().length { return -1 }
  armFieldElemTyIx()[ix]
}

// ── the struct-row arena index ───────────────────────────────────────────────
// Push-only column (`recordSTyIx` pads with -1 and pushes), first match wins,
// reset explicitly per program since a watermark can't see `collectS`'s reset.
// Keyed by arena index — a dense space, so a plain array beats a map; -1 entries skipped.
let sTyRow: i32[] = []
let sTyRowLen = 0
let sTyAlias: i32[] = []
let sTyCanonAlias: {[i32]: i32} = Map()

export function structTyIxReset() {
  sTyRow = []
  sTyRowLen = 0
  sTyAlias = []
  sTyCanonAlias = Map()
  0
}

function sTyRowSync() {
  if sTyRowLen > sTyIx.length { structTyIxReset() }
  while sTyRowLen < sTyIx.length {
    const ty = sTyIx[sTyRowLen]
    if ty >= 0 && !sIsRefRow(sTyRowLen) {
      while sTyRow.length <= ty { sTyRow.push(-1) }
      if sTyRow[ty] < 0 { sTyRow[ty] = sTyRowLen }
    }
    sTyRowLen = sTyRowLen + 1
  }
  0
}

// The arena types the emitter minted for a shape it synthesized, which no other row can
// record; only these take a deduplicated row as an alias. Cleared at compile start.
let sTyAliasable: boolean[] = []

export function structTyAliasableReset() {
  sTyAliasable = []
  0
}

export function structTyMarkAliasable(ty: i32) {
  if ty < 0 { return 0 }
  while sTyAliasable.length <= ty { sTyAliasable.push(false) }
  sTyAliasable[ty] = true
  0
}

// Records that arena type `ty`, deduplicated onto row `row`, denotes it: by exact id, and by
// row id (`repRowId`) when marked aliasable. An earlier record wins.
export function structTyIxAlias(ty: i32, row: i32) {
  if ty < 0 || row < 0 { return 0 }
  const aliasable = ty < sTyAliasable.length && sTyAliasable[ty]
  while sTyAlias.length <= ty { sTyAlias.push(-1) }
  if sTyAlias[ty] < 0 { sTyAlias[ty] = row }
  if !aliasable { return 0 }
  const ck = repRowId(ty)
  if ck >= 0 && !sTyCanonAlias.has(ck) { sTyCanonAlias[ck] = row }
  0
}

// The struct-table row for an arena type — `structIndexByName`'s arena-input twin,
// scanning `sTyIx` (the arena type each row denotes) instead of the name column, same
// first-match-wins order. -1 when the sidecar doesn't cover the row, so it never matches
// a real type and the caller falls through to its name path.
export function structIndexOfTy(ty: i32): i32 {
  const own = structRowRecordingTy(ty)
  if own >= 0 { return own }
  if ty < 0 { return -1 }
  if ty < sTyAlias.length && sTyAlias[ty] >= 0 { return sTyAlias[ty] }
  const ca = sTyCanonAlias.get(repRowId(ty)) ?? -1
  if ca >= 0 { return ca }
  // A `new` brand is a second arena index over its base and erases to it at run time, so it
  // denotes the base's row; no row records the brand's own index (D3762).
  const b = nomErasedTyIx(ty)
  if b == ty || b < 0 || b >= sTyRow.length { return -1 }
  sTyRow[b]
}

// The first row whose own recorded arena type (`sTyIx`) is `ty`, or -1: the index alone,
// without `structIndexOfTy`'s alias and brand rungs.
export function structRowRecordingTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  sTyRowSync()
  if ty < sTyRow.length { return sTyRow[ty] }
  -1
}

// The struct-table row a nested-struct field (code 15) targets — the chokepoint every
// code-15 consumer shares (default / literal seed / struct-eq / type section / closure
// scan / optional-chain). Arena first (`sFieldElemTyIx` to `structIndexOfTy`), then the
// recorded name (`structIndexByName`) for a row the sidecar doesn't cover.
export function sFieldTgtStructIdx(si: i32, fi: i32): i32 {
  const a = structIndexOfTy(sFieldElemTyIxAt(si, fi))
  if a >= 0 { return a }
  structIndexByName(sFieldElemNameAt(si, fi))
}

// The arena type struct `si` declares for its field `fi`, read off the row's own type
// (`sTyIx`, else an anonymous row's `sAnonOwnTy`); -1 when the row carries no object type.
export function sFieldRowTyAt(si: i32, fi: i32): i32 {
  if si < 0 || si >= sTyIx.length { return -1 }
  const nm = sFieldNames[sFieldStart[si] + fi]
  const t = tyFieldTyOf(sTyIx[si], nm)
  if t >= 0 { return t }
  tyFieldTyOf(sAnonOwnTy.get(si) ?? -1, nm)
}

// `sFieldRowTyAt`'s variant twin, off the variant's own arena type (`uVarTyIx`).
function uFieldRowTyAt(vi: i32, fj: i32): i32 {
  if vi < 0 || vi >= uVarTyIx.length { return -1 }
  tyFieldTyOf(uVarTyIx[vi], sFieldNames[uFieldStart[vi] + fj])
}

// True if struct `si`'s field `fi` is a literal-union atom field: code 0 whose element sidecar,
// else the row's own field type, is a literal set. Tests `tyIsLitUnionOrLit` — a one-member set
// is atom material at both of its spellings (D1460). False when neither type is known.
export function sFieldIsLitUnion(si: i32, fi: i32) {
  if sFieldTypeAt(si, fi) != FC_I32 { return false }
  const ety = sFieldElemTyIxAt(si, fi)
  if ety >= 0 { return tyIsLitUnionOrLit(ety) }
  const fty = sFieldRowTyAt(si, fi)
  fty >= 0 && tyIsLitUnionOrLit(fty)
}

// True if struct `si`'s field `fi` is an atom-array field (`f: K[]`, code 4 over a literal
// set), read off the same two types as `sFieldIsLitUnion`. The field IS the i32 list, so
// construction and assignment seed the atom-element context for member literals.
export function sFieldIsLitUnionArray(si: i32, fi: i32) {
  if sFieldTypeAt(si, fi) != FC_I32_LIST { return false }
  const ety = sFieldElemTyIxAt(si, fi)
  if ety >= 0 { return tyIsLitUnionArray(ety) }
  const fty = sFieldRowTyAt(si, fi)
  fty >= 0 && tyIsLitUnionArray(fty)
}

// The variant twin of `sFieldIsLitUnionArray`: variant `vi`'s field `fj` is an atom-array
// field, so the variant payload build seeds the atom context for its literal.
export function variantFieldIsLitUnionArray(vi: i32, fj: i32) {
  if variantFieldTypeAt(vi, fj) != FC_I32_LIST { return false }
  const ety = uFieldElemTyIxAt(vi, fj)
  if ety >= 0 { return tyIsLitUnionArray(ety) }
  const fty = uFieldRowTyAt(vi, fj)
  fty >= 0 && tyIsLitUnionArray(fty)
}

// The variant twin of `sFieldIsLitUnion`: variant `vi`'s field `fj` is a literal-union atom
// field, so `emitVariantStruct`'s construct arm and `exprIsLitAtom`'s member read seed the
// atom rep for it.
export function variantFieldIsLitUnion(vi: i32, fj: i32) {
  if variantFieldTypeAt(vi, fj) != FC_I32 { return false }
  const ety = uFieldElemTyIxAt(vi, fj)
  if ety >= 0 { return tyIsLitUnionOrLit(ety) }
  const fty = uFieldRowTyAt(vi, fj)
  fty >= 0 && tyIsLitUnionOrLit(fty)
}

// ── the struct-row name index ────────────────────────────────────────────────
// Incremental, not rebuilt on demand: `sNames` is push-only within a program, so the
// index scans only rows past its watermark, first match wins. Reset is explicit
// (`structNameIxReset`) — a watermark alone can't see `collectS` resetting `sNames`.
let sNameIx: {[string]: i32} = Map()
let sNameIxLen = 0

export function structNameIxReset() {
  sNameIx = Map()
  sNameIxLen = 0
  0
}

function sNameIxSync() {
  // Defensive, and free: a table that shrank without the explicit reset would otherwise
  // answer from a longer past; costs one compare per query.
  if sNameIxLen > sNames.length { structNameIxReset() }
  while sNameIxLen < sNames.length {
    const nm = sNames[sNameIxLen]
    if (sNameIx[nm] ?? -1) < 0 && !sIsRefRow(sNameIxLen) {
      sNameIx[nm] = sNameIxLen
    }
    sNameIxLen = sNameIxLen + 1
  }
  0
}

// ── the struct-row field-name index (D3738) ─────────────────────────────────
// Per field name, the rows carrying it and the rows it comes first in, ascending, and the rows
// with no field at all. A row joins once its names are stored, so a reader takes every row
// past `sfnLen` as a candidate itself.
let sfnRows: {[string]: i32[]} = Map()
let sfnFirst: {[string]: i32[]} = Map()
let sfnEmpty: i32[] = []
let sfnLen = 0

export function structFieldNameIxReset() {
  sfnRows = Map()
  sfnFirst = Map()
  sfnEmpty = []
  sfnLen = 0
  0
}

function sfnSync() {
  if sfnLen > sNames.length { structFieldNameIxReset() }
  const n = sScanLim()
  while sfnLen < n {
    const st = sFieldStart[sfnLen]
    const cnt = sFieldCount[sfnLen]
    if st + cnt > sFieldNames.length { return 0 }
    if sIsRefRow(sfnLen) {
      sfnLen = sfnLen + 1
      continue
    }
    if cnt == 0 {
      sfnEmpty.push(sfnLen)
    } else {
      const fb = sfnFirst[sFieldNames[st]] ?? []
      if fb.length == 0 { sfnFirst[sFieldNames[st]] = fb }
      fb.push(sfnLen)
    }
    let j = 0
    while j < cnt {
      const nm = sFieldNames[st + j]
      const b = sfnRows[nm] ?? []
      if b.length == 0 { sfnRows[nm] = b }
      if b.length == 0 || b[b.length - 1] != sfnLen { b.push(sfnLen) }
      j = j + 1
    }
    sfnLen = sfnLen + 1
  }
  0
}

// Whether some struct row may carry a field named `name`: false only when every row is indexed
// and none does, so a reader can skip resolving a receiver's row to look the field up.
export function structFieldNameUsed(name: string): boolean {
  sfnSync()
  if sfnLen < sNames.length { return true }
  (sfnRows[name] ?? []).length > 0
}

// The rows below `lim`, ascending, that can be a proper prefix of row `c`: those whose first
// field is `c`'s first, then each row the index has not reached. A row with no field has none.
export function structPrefixCands(c: i32, lim: i32): i32[] {
  sfnSync()
  const out: i32[] = []
  if c < 0 || c >= sFieldCount.length || c >= sFieldStart.length { return out }
  if sFieldCount[c] == 0 || sFieldStart[c] >= sFieldNames.length { return out }
  sfnCands(sfnFirst[sFieldNames[sFieldStart[c]]] ?? [], lim, out)
}

// Append to `out` the rows of bucket `b` below `lim`, then every row from `sfnLen` to `lim`.
function sfnCands(b: i32[], lim: i32, out: i32[]): i32[] {
  let i = 0
  while i < b.length && b[i] < lim {
    out.push(b[i])
    i = i + 1
  }
  let si = sfnLen
  while si < lim {
    if !sIsRefRow(si) { out.push(si) }
    si = si + 1
  }
  out
}

// The struct table index whose name is `name`, or -1 if `name` is not a declared struct type.
export function structIndexByName(name: string) {
  sNameIxSync()
  sNameIx[name] ?? -1
}

// The number of fully-collected struct entries — the scan bound for any matcher reading
// a struct's field metadata. During `collectS`'s field-coding loop the in-flight
// declaration has `sNames` pushed but `sFieldCount` not yet, and `fieldTypeCode` can
// re-enter these matchers, so a raw `sNames.length` bound would read `sFieldCount` out of bounds.
export function sScanLim() {
  let n = sNames.length
  if sFieldCount.length < n { n = sFieldCount.length }
  if sFieldStart.length < n { n = sFieldStart.length }
  n
}

// Whether declared row `si`'s field `mfi` stores field `name` of the object literal at `objIx`
// with the scalar type the checker gave it. Two rows of one field name can share a code (`i32`
// and `boolean`) or differ by one the value's code cannot see (an `i32` beside an `f32`), and a
// read formats and types by the row. Refutation only: an unknown kind on either side agrees.
export function declRowFieldKindFits(
  objIx: i32,
  name: string,
  si: i32,
  mfi: i32,
  fnIx: i32,
): boolean {
  if si < 0 || si >= sTyIx.length { return true }
  if mfi < 0 || mfi >= sFieldCount[si] { return true }
  const rt = tyFieldTyOf(sTyIx[si], sFieldNames[sFieldStart[si] + mfi])
  const lt = tyFieldTyOf(nodeRepTyIxOf(objIx), name)
  const own = objFieldOwnTyOf(objIx, name, lt, fnIx)
  if !fnFieldTyFits(own, rt) { return false }
  if !holeFnFieldFits(objFieldVal(objIx, name), own, rt) { return false }
  const rk = fieldScalarKindOf(rt)
  if rk == 0 { return true }
  if ownTyIsFunc(own) { return false }
  const lk = fieldScalarKindOf(lt)
  if lk == 0 { return true }
  fieldKindWidens(lk, rk)
}

// `fnFieldTyFits` against field `name` of row `si` where that row is declared; true for an
// anonymous row, whose closure fields `anonValueFitsField` checks by signature instead.
export function declRowFnFieldFits(lt: i32, si: i32, name: string): boolean {
  if sIsAnonRow(si) { return true }
  if !holeFnTyFieldFits(lt, si, name) { return false }
  rowFnFieldFits(lt, si, name)
}

// Every object-literal field value named `fiName` whose checked type is a function with holes,
// collected once per pass and resumed as the arena grows: a type alone cannot say what such a
// function returns, so `holeFnTyFieldFits` asks its values (D9530).
const hfvKey = memoKeyNew(1)
let hfvTys: i32[] = []
let hfvVals: i32[] = []
let hfvNames: string[] = []
let hfvScanned = 0

function hfvSync() {
  if memoPassMoved(hfvKey, 0) {
    hfvTys = []
    hfvVals = []
    hfvNames = []
    hfvScanned = 0
  }
  let i = hfvScanned
  while i < P.nodes.length {
    const n = nodeAt(i)
    if n is FieldInit {
      const t = nodeTyIxOf(unwrapParen(n.fiValue))
      if ownTyIsFunc(t) && tyHasTyVar(t) {
        hfvTys.push(t)
        hfvVals.push(n.fiValue)
        hfvNames.push(n.fiName)
      }
    }
    i = i + 1
  }
  hfvScanned = P.nodes.length
  0
}

// `holeFnFieldFits` for a field type `lt` with no literal at hand: refuted when any field value
// `name` checked at `lt` gives a result other than row `si`'s declared signature does (D9571).
function holeFnTyFieldFits(lt: i32, si: i32, name: string): boolean {
  if !ownTyIsFunc(lt) || !tyHasTyVar(lt) { return true }
  if si < 0 || si >= sTyIx.length { return true }
  const rt = tyFieldTyOf(sTyIx[si], name)
  hfvSync()
  let j = 0
  while j < hfvTys.length {
    if hfvTys[j] == lt && hfvNames[j] == name {
      if !holeFnFieldFits(unwrapParen(hfvVals[j]), lt, rt) { return false }
    }
    j = j + 1
  }
  true
}

// `fnFieldTyFits` against field `name` of row `si`'s recorded type, declared or anonymous.
export function rowFnFieldFits(lt: i32, si: i32, name: string): boolean {
  if si < 0 || si >= sTyIx.length { return true }
  fnFieldTyFits(lt, tyFieldTyOf(sTyIx[si], name))
}

// `declRowFnFieldFits` for a field spelled `text`, resolved only where it spells an arrow and
// row `si` declares that field a function.
export function declRowFnSpellingFits(
  text: string,
  si: i32,
  name: string,
): boolean {
  if si < 0 || si >= sTyIx.length || sIsAnonRow(si) { return true }
  if !strContains(text, "=>") { return true }
  const rt = tyFieldTyOf(sTyIx[si], name)
  const rf = nonNullTy(rt)
  if rf < 0 || rf >= T.tys.length || !(tyAt(rf) is TyFunc) { return true }
  fnFieldTyFits(declTyIxOfName(text), rt)
}

// Field `name`'s type `lt` in the object literal at `objIx`, or, where that names a hole (a
// literal handed to an un-annotated parameter), the field value's own checked type.
function objFieldOwnTyOf(objIx: i32, name: string, lt: i32, fnIx: i32): i32 {
  if lt >= 0 && !tyHasTyVar(lt) { return lt }
  const fv = objFieldVal(objIx, name)
  if fv < 0 { return lt }
  nodeTyAt(unwrapParen(fv), fnIx)
}

// Whether `ty` is a function type, generic or not: no scalar field slot holds one (D6373).
function ownTyIsFunc(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  tyAt(ty) is TyFunc
}

// Whether a field of function type `lt` may be stored at a declared field of type `rt`: a call
// through the row reads its closure at the row's signature, so the two must be one signature
// (`| null` on the row aside), and no scalar field holds one. Refutation only otherwise: a
// non-function value, a union field or a type parameter agrees (D3181).
function fnFieldTyFits(lt: i32, rt: i32): boolean {
  if lt < 0 || rt < 0 || lt >= T.tys.length || rt >= T.tys.length {
    return true
  }
  if !(tyAt(lt) is TyFunc) { return true }
  const rf = nonNullTy(rt)
  if rf < 0 { return true }
  // A function never fits a scalar field, nullable or not.
  if tyAt(rf) is TyPrim { return false }
  if !(tyAt(rf) is TyFunc) { return true }
  if tyHasTyVar(rf) { return true }
  if tyHasTyVar(lt) { return tyVarsCanBind(lt, rf, [], []) }
  tyEq(lt, rf)
}

// Whether some binding of the type variables in `lt` makes it `rt`: each variable names one type
// throughout, so `(T) => T` is no `(i32) => f64`. Refutation only past functions and variables.
function tyVarsCanBind(lt: i32, rt: i32, names: string[], tys: i32[]): boolean {
  if lt < 0 || rt < 0 || lt >= T.tys.length || rt >= T.tys.length {
    return true
  }
  if !tyHasTyVar(lt) { return tyEq(lt, rt) }
  const l = tyAt(lt)
  let ok = true
  match l {
    TyVar => {
      ok = tyVarBinds(l.tvName, rt, names, tys)
    }
    TyFunc => {
      ok = fnTyVarsCanBind(l, rt, names, tys)
    }
    // A variable under any other kind is not refuted here.
    TyErr | TyPrim | TyObj | TyUnion | TyNullable | TyArray | TyMap | TyLit | TyNeg => {}
  }
  ok
}

// Binds variable `name` to `rt` in the parallel `names`/`tys`, or tests it against its binding.
function tyVarBinds(
  name: string,
  rt: i32,
  names: string[],
  tys: i32[],
): boolean {
  let i = 0
  while i < names.length {
    if names[i] == name { return tyEq(tys[i], rt) }
    i = i + 1
  }
  names.push(name)
  tys.push(rt)
  true
}

// `tyVarsCanBind` for function type `l`: `rt` is a function of as many parameters, each and the
// result bindable under the one binding.
function fnTyVarsCanBind(
  l: TyFunc,
  rt: i32,
  names: string[],
  tys: i32[],
): boolean {
  const r = tyAt(rt)
  if !(r is TyFunc) { return false }
  if l.fnParamTypes.length != r.fnParamTypes.length { return false }
  let k = 0
  while k < l.fnParamTypes.length {
    if !tyVarsCanBind(l.fnParamTypes[k], r.fnParamTypes[k], names, tys) {
      return false
    }
    k = k + 1
  }
  tyVarsCanBind(l.fnRet, r.fnRet, names, tys)
}

// Whether the un-annotated function field value `fv` (typed `lt`, with holes) gives the result of
// declared field type `rt` when called at its parameters, as a call through the row reads it.
// Refutation only: an unknown or literal result, or a non-function, agrees (D9530).
function holeFnFieldFits(fv: i32, lt: i32, rt: i32): boolean {
  if fv < 0 || lt < 0 || rt < 0 || lt >= T.tys.length || rt >= T.tys.length {
    return true
  }
  if !(tyAt(lt) is TyFunc) || !tyHasTyVar(lt) { return true }
  const rf = nonNullTy(rt)
  if rf < 0 || rf >= T.tys.length || tyHasTyVar(rf) { return true }
  const w = tyAt(rf)
  if !(w is TyFunc) { return true }
  const hr = holeFnArgRetAtParams(fv, w.fnParamTypes)
  if hr < 0 || hr >= T.tys.length || tyAt(hr) is TyLit { return true }
  tyEq(hr, w.fnRet)
}

// Whether `ty` is a record, list, map or function: a reference that no scalar slot holds.
export function tyIsRefShaped(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  t is TyObj || t is TyArray || t is TyMap || t is TyFunc
}

// Whether a field of kind `lk` (`fieldScalarKindOf`) may be stored at one of kind `rk`: the same
// kind, a numeric widening the checker lets a record take, or either into a `| null`. An `i32`
// field is not an `f32` one, since the checker refuses that record assignment.
export function fieldKindWidens(lk: i32, rk: i32): boolean {
  if lk == rk { return true }
  if rk > 8 {
    if lk > 8 { return fieldKindWidens(lk - 8, rk - 8) }
    return fieldKindWidens(lk, rk - 8)
  }
  if lk > 8 { return false }
  if lk == 1 { return rk == 3 || rk == 5 }
  if lk == 3 || lk == 4 { return rk == 5 }
  false
}

// The layout kind of a union field type: 7 when every member is a string literal (`"a" | "b"`,
// stored as a member id, not a string), else 0. A `| null` over it is the `TyNullable` around it.
function litSetScalarKindOf(members: i32[]): i32 {
  let i = 0
  while i < members.length {
    const m = members[i]
    if m < 0 || m >= T.tys.length { return 0 }
    const mt = tyAt(m)
    if !(mt is TyLit) { return 0 }
    if mt.litKind != "str" { return 0 }
    i = i + 1
  }
  if members.length == 0 { return 0 }
  7
}

// The layout kind of a record field of type `ty`: 1 `i32`, 2 `boolean`, 3 `i64`, 4 `f32`,
// 5 `f64`, 6 `string`, 7 a string literal set, each plus 8 as `| null`; a literal type reads as
// its base. 0 for any other type, which `declRowFieldKindFits` does not refute on.
export function fieldScalarKindOf(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return 0 }
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less.
  match t {
    TyNullable => {
      const k = fieldScalarKindOf(t.nInner)
      if k == 0 || k > 8 { return 0 }
      return k + 8
    }
    TyLit => {
      return fieldScalarKindOf(litBaseTy(t))
    }
    TyUnion => {
      return litSetScalarKindOf(t.uMembers)
    }
    TyPrim => {
      return primScalarKindOf(t.primName)
    }
    TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyNeg => {
      return 0
    }
  }
}

// `fieldScalarKindOf` of a primitive; 0 for one no record field stores as a scalar.
function primScalarKindOf(p: PrimName): i32 {
  // Exhaustive over `PrimName` and `_`-less.
  match p {
    "i32" => {
      return 1
    }
    "boolean" => {
      return 2
    }
    "i64" => {
      return 3
    }
    "f32" => {
      return 4
    }
    "f64" => {
      return 5
    }
    "string" => {
      return 6
    }
    "v128" | "void" | "null" | "never" | "u8" => {
      return 0
    }
  }
}

// The code-0 kind of type `ty`: 1 `i32`, 2 `boolean`, 3 a string literal or literal set, 0
// for anything else, which no caller refutes on.
export function code0KindOf(ty: i32): i32 {
  if ty < 0 { return 0 }
  const p = tyPrimNameOf(ty)
  if p != null {
    // Exhaustive over `PrimName` and `_`-less: only two prims are code-0 kinds.
    match p {
      "i32" => {
        return 1
      }
      "boolean" => {
        return 2
      }
      "string" | "i64" | "f64" | "f32" | "v128" | "void" | "null" | "never" | "u8" => {
        return 0
      }
    }
  }
  if tyIsLitUnionOrLit(ty) { return 3 }
  0
}

// Whether a nested-record field of type `fty` may share row `si`'s field `fi`: the field's
// target row and `fty` must agree canonically where both are known (D2841).
export function nestedAnonRowFits(fty: i32, si: i32, fi: i32): boolean {
  if tyHasTyVar(fty) { return true }
  // The row's recorded element type answers the common agreeing case without resolving a name.
  const ety = sFieldElemTyIxAt(si, fi)
  if ety >= 0 && repCanonId(ety) == repCanonId(fty) { return true }
  const rowElem = sFieldElemNameAt(si, fi)
  if rowElem == "" { return true }
  let cr = repNameCanonId(rowElem)
  if cr < 0 { cr = rowCanonIdOfName(rowElem) }
  if cr < 0 { return true }
  repCanonId(fty) == cr
}

// Whether a code-0 field of type `fty` may share row `si`'s field `fi`: false only when both
// code-0 kinds are known and differ (D2841).
export function code0TyFitsRow(fty: i32, si: i32, fi: i32): boolean {
  const tk = code0KindOf(fty)
  if tk == 0 || si < 0 || si >= sTyIx.length { return true }
  const rk = code0KindOf(
    tyFieldTyOf(sTyIx[si], sFieldNames[sFieldStart[si] + fi]),
  )
  rk == 0 || rk == tk
}

// An open-addressed pair table, generation-stamped so a new walk costs no clearing: a slot is
// live only while its stamp equals the walk id, and the capacity is sized once per emit pass.
// The arrays are the caller's, so two users cannot share a slot (D1705).
export function pxSized(
  cap: i32,
  keyA: i32[],
  keyB: i32[],
  stamp: i32[],
  val: i32[],
) {
  while keyA.length < cap {
    keyA.push(-1)
    keyB.push(-1)
    stamp.push(-1)
    val.push(-1)
  }
  0
}

// The capacity for a table over `want` keys: a power of two at least four times it, so the
// probe stays short, floored at 1024 and capped so one table cannot outgrow the heap.
export function pxCapFor(want: i32): i32 {
  let cap = 1024
  while cap < want * 4 {
    if cap >= 262144 { return 262144 }
    cap = cap * 2
  }
  cap
}

// The slot `(a, b)` occupies on walk `walk`, or the free slot it would take; -1 when the probe
// finds neither, which is the caller's named default. Reading a free slot back is how a caller
// answers "not seen", so both callers read the slot rather than a boolean. `cap` is a power of
// two (`pxCapFor`).
export function pxSlotOf(
  keyA: i32[],
  keyB: i32[],
  stamp: i32[],
  cap: i32,
  walk: i32,
  a: i32,
  b: i32,
): i32 {
  if cap < 16 { return -1 }
  if keyA.length < cap { return -1 }
  let h = hashMixPair(a, b) & (cap - 1)
  let steps = 0
  while steps < cap {
    if stamp[h] != walk { return h }
    if keyA[h] == a {
      if keyB[h] == b { return h }
    }
    h = h + 1
    if h == cap { h = 0 }
    steps = steps + 1
  }
  -1
}

export const ercGenKey = memoKeyNew(1)
// True if struct-table row `si` is an anonymous shape — one `collectAnonShapes` minted
// from an object literal under a synthetic `#anonN` name, rather than a declared `type`
// or inline-shape annotation. An anon row's codes read directly off the literal (exact); a
// declared row's come from an annotation the checker can reach with values the code omits.
export function sIsAnonRow(si: i32) {
  if si < 0 || si >= sNames.length { return false }
  const nm = sNames[si]
  nm.length >= 5 && nm.slice(0, 5) == "#anon"
}

// A memo over `structIndexOfObjCtxGo`, keyed by node index and the querying `fnIx` (the
// f64 axis is per-instance). An answer holds while neither the struct rows nor the union
// rows grow, since a field value's code is read off the union registry. Reset per program
// in `collectS` (`sioMemoReset`).
export let sioMemoIx: i32[] = []
export let sioMemoFn: i32[] = []
export let sioMemoVer: i32[] = []
export let sioMemoUn: i32[] = []
export function sioMemoReset() {
  sioMemoIx = []
  sioMemoFn = []
  sioMemoVer = []
  sioMemoUn = []
}

// True if lifted function `fe` has any un-annotated parameter — a generic whose param is
// a per-call-site inference hole. Such a function monomorphizes per direct call but
// i32-defaults when taken as a value, so the value site rejects it.
export function fnHasUnannotatedParam(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = nodeAt(ps[i])
      if p is Param {
        if p.parType < 0 { return true }
      }
      i = i + 1
    }
  }
  false
}

// True if `exprIx` is a re-readable place — a bare name, or a `.`/`?.` chain bottoming out
// in a name. Such a receiver is an effect-free `local.get`/`struct.get` sequence, so a `?.`
// lowering may emit it twice; anything else is staged once (`optChainStagesRecv`).
export function optRecvReReadable(exprIx: i32) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is Ident { return true }
  if e is Member { return optRecvReReadable(e.memObj) }
  if e is OptMember { return optRecvReReadable(e.omObj) }
  // The default is named, not fallen through: see `optRecvNotAPlace`.
  optRecvNotAPlace()
}

// Every `Node` kind `optRecvReReadable`'s ladder does not test, as one answer: not a place.
// A call, an index, an operator and a literal are all VALUES, so a second emission of one
// recomputes it — cheaply for a literal, observably for a call. Fails closed on purpose: an
// unclassified kind is staged rather than re-emitted.
function optRecvNotAPlace(): boolean { false }

// The bottom of the `?.` chain at `exprIx` — the receiver that is not itself a `?.`, and the
// only arbitrary expression in the chain (every link above it is a `struct.get`). -1 when
// `exprIx` is no chain at all.
export function optChainBaseOf(exprIx: i32) {
  const inner = unwrapParen(exprIx)
  if inner < 0 { return -1 }
  const e = nodeAt(inner)
  if e is OptMember {
    const b = optChainBaseOf(e.omObj)
    if b >= 0 { return b }
    return unwrapParen(e.omObj)
  }
  -1
}

// Is the node at `ix` a record-fit `is` (a literal-set field test) whose receiver is not a
// re-readable place, so its lowering stages the receiver once in `optRecvSlot`?
export function recordFitIsStagesRecv(ix: i32): boolean {
  const n = nodeAt(ix)
  if !(n is IsExpr) { return false }
  if n.isVariant == "null" || unionEqOperandOk(n.isObj) { return false }
  const names: string[] = []
  const sets: i32[] = []
  recFitNarrowedFields(nodeTyIxOf(n.isObj), isVarTyIxOf(ix), names, sets) > 0
}

// Is the node at `ix` a `?.` whose chain base must be STAGED — evaluated once into
// `optRecvSlot` — because it is not a re-readable place? One home for the question, so the
// slot reserved and the code emitted cannot disagree (D1671).
export function optChainStagesRecv(ix: i32): boolean {
  const b = optChainBaseOf(ix)
  if b < 0 { return false }
  !optRecvReReadable(b)
}

// A `.get` INDEX the lowering may emit twice: a literal, a name, or a NEGATIVE literal, whose
// unsigned bounds compare maps it past `len` and so takes the absent arm. Anything else is
// evaluated once into the index stash (D1677).
export function listGetIdxReReadable(idxIx: i32): boolean {
  const n = nodeAt(unwrapParen(idxIx))
  match n {
    NumLit => {
      return true
    }
    Ident => {
      return true
    }
    Unary => {
      if n.unOp == "-" {
        const inner = nodeAt(unwrapParen(n.unArg))
        if inner is NumLit { return true }
      }
    }
    // any other index is evaluated once into the stash
    StrLit | CharLit | BoolLit | NullLit | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// Is the node at `ix` a `.get(i)` whose index or receiver must be STAGED, because it is not a
// re-readable place? One home for the question, so the slots reserved and the code emitted
// cannot disagree (D1677).
export function listGetStagesOperand(ix: i32): boolean {
  const c = nodeAt(unwrapParen(ix))
  if !(c is Call) { return false }
  const callee = nodeAt(unwrapParen(c.callFn))
  if !(callee is Member) { return false }
  if callee.memProp != "get" { return false }
  if !optRecvReReadable(callee.memObj) { return true }
  if c.callArgs.length != 1 { return false }
  !listGetIdxReReadable(c.callArgs[0])
}

// The canonical identity of the struct row named `name` from the type it recorded, or -1.
export function rowCanonIdOfName(name: string): i32 {
  const si = structIndexByName(name)
  if si < 0 || si >= sTyIx.length { return -1 }
  const ty = sTyIx[si]
  if ty < 0 || tyHasTyVar(ty) { return -1 }
  repCanonId(ty)
}

// The wasm-type code (`0` i32, `3` string) of variant `vi`'s field at field index `fi`.
export function variantFieldTypeAt(vi: i32, fi: i32) {
  armFieldTypes()[uFieldStart[vi] + fi]
}

// The ELEMENT/atom-set NAME recorded for variant `vi`'s field `fi` — a union-box field
// (code 16) records its atom-set name (the key `emitUnionCoerce` boxes against), a
// ref-list its element name, a nested-struct its target. "" for a plain scalar field.
export function variantFieldElemName(vi: i32, fi: i32) {
  sFieldElemName[uFieldStart[vi] + fi]
}
