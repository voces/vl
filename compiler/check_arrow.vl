// `check_arrow.vl` — the arrow rule's solver output (`l2-inferred-interfaces-design.md` §4.1,
// `BK_ARROW`): at each call, every call its callee's body makes through a hole callee, with the
// callee's type and the argument types the call's solve closes them to. Keyed by the outer call,
// beside `InstReq`, never in an `Iface`: one body's hole call reads differently per caller.
// Nothing here decides storage; `fnTagDecide` reads it.

import { i32ToStr } from "./ast"

// One row per (outer call, hole call): the callee's type and each argument's type there, -1 for
// an argument no bound has named.
let arOuter: i32[] = []
let arHole: i32[] = []
let arCallee: i32[] = []
let arFrom: i32[] = []
let arArgs: i32[][] = []
let arSlot: {[string]: i32} = Map()

// Clears the table (called with the checker's other per-run state).
export function arrowReset() {
  arOuter = []
  arHole = []
  arCallee = []
  arFrom = []
  arArgs = []
  arSlot = Map()
  return 0
}

// Records that hole call `hole` in the callee of call `outer` calls `callee`, handed by the outer
// call's argument node `from` (-1 when none), with argument `n` (1-based) of type `arg` there. A
// later solve of the same pair overwrites what it names.
export function arrowNote(
  outer: i32,
  hole: i32,
  callee: i32,
  from: i32,
  n: i32,
  arg: i32,
) {
  if n < 1 { return 0 }
  const k = i32ToStr(outer) + ":" + i32ToStr(hole)
  let r = arSlot[k] ?? -1
  if r < 0 {
    r = arOuter.length
    arSlot[k] = r
    arOuter.push(outer)
    arHole.push(hole)
    arCallee.push(callee)
    arFrom.push(from)
    arArgs.push([])
  }
  arCallee[r] = callee
  arFrom[r] = from
  while arArgs[r].length < n { arArgs[r].push(-1) }
  arArgs[r][n - 1] = arg
  return 0
}

// How many rows stand.
export function arrowCount(): i32 { return arOuter.length }

// Row `r`'s outer call.
export function arrowOuterOf(r: i32): i32 { return arOuter[r] }

// Row `r`'s hole call, a call in the outer call's callee.
export function arrowHoleOf(r: i32): i32 { return arHole[r] }

// Row `r`'s callee type at the outer call.
export function arrowCalleeOf(r: i32): i32 { return arCallee[r] }

// Row `r`'s outer argument node handing the callee, -1 when the callee is not a parameter.
export function arrowFromOf(r: i32): i32 { return arFrom[r] }

// Row `r`'s argument types at the outer call, -1 where none was named.
export function arrowArgsOf(r: i32): i32[] { return arArgs[r] }
