// The widening literals: the literal types a `const` inferred from its initializer, by arena
// index, and the type each node had before `widenLitTy` widened it, by node. `mkWideStrLitTy`
// and `noteWideLitNode` write them; `isWideLitJoin`, `nodeUnwidenedTyOf` and the
// `nodeWideStrLit*` pair read them for the checker and the emitter. `wideLitsReset` clears
// both per program; nothing here imports the checker.
import { nodeTyIxOf } from "./check_node_tys"
import { TyLit, TyUnion, litMemberTy, tyAt } from "./check_types"

// Arena indices of the literal types a `const` inferred from its initializer. Each is minted
// fresh, so the flag belongs to that binding's type alone: kept at every read, and widened to
// its base where the value is stored somewhere reassignable — a `let`, a list or object literal,
// a type argument.
export let wideLitTyIxs: boolean[] = []

// The widening literal type of string lexeme `lex` (quotes kept), or `fallback` when `lex` is
// not a quoted literal.
export function mkWideStrLitTy(lex: string, fallback: i32): i32 {
  const lt = litMemberTy(lex)
  if lt < 0 { return fallback }
  while wideLitTyIxs.length <= lt { wideLitTyIxs.push(false) }
  wideLitTyIxs[lt] = true
  lt
}

// Whether `ty` is a widening literal, or a union made only of them.
export function isWideLitJoin(ty: i32): boolean {
  if isWideLitTy(ty) { return true }
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyUnion {
    if t.uMembers.length == 0 { return false }
    let i = 0
    while i < t.uMembers.length {
      if !isWideLitTy(t.uMembers[i]) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// Whether `ty` is a widening literal: a `const` inferred it and nobody declared it.
function isWideLitTy(ty: i32): boolean {
  if ty < 0 || ty >= wideLitTyIxs.length { return false }
  wideLitTyIxs[ty]
}

// The type a node had before `widenLitTy`, by node index; -1 where widening changed nothing.
export let wideLitByNode: i32[] = []

export function noteWideLitNode(ix: i32, ty: i32) {
  while wideLitByNode.length <= ix { wideLitByNode.push(-1) }
  wideLitByNode[ix] = ty
  0
}

// Whether node `ix` read a `const` bound to a string literal. The recorded type of such a node
// is `string`; this and `nodeWideStrLitText` are the one place the literal is asked for (D2157).
export function nodeHasWideStrLit(ix: i32): boolean {
  if ix < 0 || ix >= wideLitByNode.length { return false }
  const ty = wideLitByNode[ix]
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyLit { return t.litKind == "str" }
  false
}

// Node `ix`'s type before a `const` literal inside it widened to `string` — a join of such
// literals is a literal union a literal-typed destination narrows from — else its recorded type.
export function nodeUnwidenedTyOf(ix: i32): i32 {
  if ix >= 0 && ix < wideLitByNode.length {
    if wideLitByNode[ix] >= 0 { return wideLitByNode[ix] }
  }
  nodeTyIxOf(ix)
}

// The raw text (no quotes) of the literal `nodeHasWideStrLit` found at `ix`; ask that first,
// since `const E = ""` holds a literal whose text is empty.
export function nodeWideStrLitText(ix: i32): string {
  if ix < 0 || ix >= wideLitByNode.length { return "" }
  const ty = wideLitByNode[ix]
  if ty < 0 { return "" }
  const t = tyAt(ty)
  if t is TyLit { return t.litText }
  ""
}

// Clears both tables, before a program's check.
export function wideLitsReset() {
  wideLitTyIxs = []
  wideLitByNode = []
  0
}
