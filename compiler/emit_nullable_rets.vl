// The `__array_new__` element kind named by an annotated-PARAMETER fill: the list a value of
// the parameter's declared `VKind` is an element of. The one channel a monomorphized instance
// still has, its annotation carrying the pin while the recorded type is the original's
// unpinned `T`. `"none"` for a fill that is not an annotated parameter.
export function arrNewFillAnnKind(callIx: i32, fnIx: i32): ArrNewKind {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length == 2 {
      const a = nodeAt(c.callArgs[1])
      if a is Ident {
        const pt = paramTypeNodeOfRead(fnIx, c.callArgs[1])
        if pt >= 0 { return arrNewKindOfElemVKind(vtKindOfType(pt)) }
      }
    }
  }
  "none"
}

// Whether function `fnIx` returns the nullable atom `K | null`, annotated or inferred, whose
// fall-through null is the `-1` sentinel (D5340).
export function fnRetIsNulAtom(fnIx: i32): boolean {
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return false }
  if fn.fnRet >= 0 { return nodeTyIsNulLitUnion(fn.fnRet) }
  tyIsNullableLitUnion(inferRetTyIxOf(inferRetFnKey(fnIx, fn.fnName)))
}

export function fnRetNullBearing(fnIx: i32) {
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return false }
  const r = fn.fnRet
  if tyIsNulBool(r) { return true }
  if nodeRepIs(r, "nulstr", fnIx) { return true }
  if nodeRepIs(r, "nulstruct", fnIx) { return true }
  if retNulVariantFlag(r) == 1 { return true }
  if nodeRepIs(r, "nullist", fnIx) { return true }
  // Every list rep `emitNullForRet` has a `ref.null` for, not only the i32-backed one (D2495).
  if nulScalarListKindOfNode(r) != null { return true }
  if retNulRefArrFlag(r) == 1 { return true }
  if retNulMapFlag(r) == 1 { return true }
  // A nullable closure, whose `ref.null $cloStruct` `emitNullForRet` already emits (D4349).
  if nulCloFlag(r) == 1 { return true }
  if fnRetIsNulAtom(fnIx) { return true }
  // The arena, not the render's `|`-split: `nodeTyBearsNull` covers both shapes
  // `retUnionFlag` admits (a `TyUnion` with a `null` member and a `TyNullable` scalar).
  if retUnionFlag(r) == 1 { return nodeTyBearsNull(r) }
  if r < 0 {
    const irk = inferRetFnKey(fnIx, fn.fnName)
    const im = inferRetNameOf(irk)
    if isValueUnionName(im) {
      // The arena, reached through the inferred-return table's own type column
      // (`inferRetTyIxOf`), rather than splitting a rendered member set on `|`. The
      // fallback below is unreachable and kept only as a total-function guard:
      // `isValueUnionName(im)` being true already proves `inferRetTyIxOf` resolves.
      return inferRetBearsNull(irk)
    }
    if inferNicheNullByName(irk) != "" { return true }
  }
  false
}

// D1240 — a member call the checker typed non-void, which the emitter can deliver as a
// value. One predicate for three consumers that must agree: `computeVoidFns`,
// `emitFuncBody`/`emitStmtTail` (the tail is the result), and `emitCallStmt`'s discard.
// Reads the checker's type at every method, not a by-name exclusion list (D1301, D1592).
export function memberCallYieldsValue(stmtIx: i32) {
  const s = nodeAt(unwrapParen(stmtIx))
  if s is Call {
    if s.callFn < 0 { return false }
    const callee = nodeAt(s.callFn)
    if callee is Member || callee is OptMember {
      // An unrecorded type (-1) is "cannot answer", never a value. A per-instance copy of a
      // call records no type of its own and answers the checked call it copies (D4670).
      let t = nodeTyIxOf(stmtIx)
      if t < 0 { t = nodeTyIxOf(ufcsSiteRoot(stmtIx)) }
      if t < 0 { return false }
      return tyPrimNameOf(t) != "void"
    }
  }
  false
}

// Whether assignment `asgIx`'s value is typed a non-nullable function.
export function asgValueIsFunc(asgIx: i32, fnIx: i32): boolean {
  const vt = nodeTyAt(asgIx, fnIx)
  vt >= 0 && vt < T.tys.length && tyAt(vt) is TyFunc
}

// Whether `spillTail` turns the field or element write at `asgIx` into a store and a read of
// the value, or a fresh `null` for a bare one. Declined: a nullable map or function value (no
// inferred-return rep, D2498), a write to a captured cell (boxed after `spillTail`), and a
// `null` at a lambda's or nested function's tail, whose `null` result does not lower.
export function assignTargetSpills(asgIx: i32): boolean {
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return false }
  if a.binOp != "=" { return false }
  const v = unwrapParen(a.binRight)
  if v < 0 { return false }
  const t = unwrapParen(a.binLeft)
  if t < 0 { return false }
  if !(nodeAt(t) is Member || nodeAt(t) is Index) { return false }
  const vt = nodeTyIxOf(asgIx)
  if nodeAt(v) is NullLit { return true }
  if vt < 0 || vt >= T.tys.length { return false }
  if tyAt(vt) is TyMap { return !asgTargetIsCell(t) }
  const nt = tyAt(nonNullTy(vt))
  !(nt is TyMap || nt is TyFunc)
}

// Whether the write target `t` is a captured binding's cell, `cell[0]`.
function asgTargetIsCell(t: i32): boolean {
  const tn = nodeAt(t)
  if !(tn is Index) { return false }
  const cell = nodeAt(tn.idxArr)
  if !(cell is Ident) { return false }
  cboxReadsCell(tn.idxArr)
}

// Whether the function a tail is classified in is a lifted lambda or a nested function: the
// one `computeVoidFns` stages, else the one being lowered; false when neither is set.
function asgFrameIsClosure(): boolean {
  let f = tailSelfFnIx
  if f < 0 { f = emitCurFnIx }
  if f < 0 || f >= P.nodes.length { return false }
  const fn = nodeAt(f)
  if !(fn is FuncDecl) { return false }
  const nm = fn.fnName
  if nm.length >= 8 && nm.slice(0, 8) == "__lambda" { return true }
  const pos = fnStmtsIndexOf(f)
  pos >= 0 && pos < fnParent.length && fnParent[pos] >= 0
}

// The function `computeVoidFns` is classifying, or -1: its own call in tail position yields
// what the rest of its tail yields, so it is assumed void there, by name or through its
// closure (D3828).
export let tailSelfFnIx = 0 - 1

// Unstages `tailSelfFnIx` at compile start, so no function of an earlier program is assumed.
export function tailSelfFnReset() {
  tailSelfFnIx = 0 - 1
  0
}

// Stages `tailSelfFnIx`.
export function tailSelfFnSet(fnIx: i32) {
  tailSelfFnIx = fnIx
  0
}

// Whether the function at `fnIx` can return the `null` its inferred nullable return falls
// through to: a rep `fnRetNullBearing` reads now, or one `synthNulListRetAnns` pins later.
export function inferNullFallsThrough(fnIx: i32): boolean {
  if fnRetNullBearing(fnIx) { return true }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return false }
  if fn.fnRet >= 0 { return false }
  if inferRetNulPinned(inferRetFnKey(fnIx, fn.fnName)) { return true }
  // An anonymous lambda's row is keyed by its node, which `fnRetNullBearing` does not ask.
  const nk = "#" + i32ToStr(fnIx)
  if inferRetNulPinned(nk) || inferNicheNullByName(nk) != "" { return true }
  isValueUnionName(inferRetNameOf(nk)) && inferRetBearsNull(nk)
}

// The inferred returns `synthNulListRetAnns` pins: a nullable list, or a nullable declared
// struct row resolved by the pair `inferNulStructRow` asks, so the pin and `retNulRefIndex`
// cannot resolve different rows (D1220).
export function inferRetNulPinned(irk: string): boolean {
  if inferRetIsNulList(irk) { return true }
  const itx = inferRetTyIxOf(irk)
  if itx < 0 { return false }
  const it = tyAt(itx)
  if !(it is TyNullable) { return false }
  const inner = it.nInner
  if inner < 0 { return false }
  // A union arm with no struct row of its own is the `nulvariant` kind, never pinned here.
  if repVariantShapeRowOf(inner) >= 0 { return false }
  structRowOfTy(inner) >= 0 || repRowOfTyStruct(inner, sScanLim()) >= 0
}

// True if the arm at `blockIx` is a BLOCK with no statements — the shape that has no tail to
// give a value, and therefore no value for `emitIfTail` to place. A non-Block arm (an
// `else if` chain) is never "empty" in this sense and answers false.
export function ifTailArmIsEmpty(blockIx: i32): boolean {
  if blockIx < 0 { return false }
  const ab = nodeAt(blockIx)
  if ab is Block { return ab.blkStmts.length == 0 }
  false
}

// True when the function node `fnIx` carries a return annotation other than `void`.
export function fnDeclaresNonVoid(fnIx: i32): boolean {
  if fnIx < 0 { return false }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return false }
  fn.fnRet >= 0 && retVoidAnnFlag(fn.fnRet) == 0
}

// How many value-producing exits one return value contributes. An if-expression
// (`return if c { a } else { b }`) lowers as a void statement-`if` whose arms each
// terminate as their own return, so it contributes one exit per arm — what makes such a
// function eligible for the sink at all. Every other expression is a single exit.
export function retValueExitCount(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const bare = nodeAt(unwrapParen(exprIx))
  if bare is IfStmt {
    // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
    let total = 0
    let cur = unwrapParen(exprIx)
    while cur >= 0 {
      const c = nodeAt(cur)
      cur = -1
      if c is IfStmt {
        total = total + retArmExitCount(c.ifThen, fnIx)
        if c.ifElse >= 0 && nodeAt(c.ifElse) is IfStmt {
          cur = c.ifElse
        } else {
          total = total + retArmExitCount(c.ifElse, fnIx)
        }
      }
    }
    return total
  }
  1
}

// One arm of a returned if-EXPRESSION: an `else if` chain link is another if-expression,
// a block's single tail value recurses (a NESTED if-expression contributes its own arms),
// and anything else is one exit.
function retArmExitCount(armIx: i32, fnIx: i32) {
  if armIx < 0 { return 0 }
  const a = nodeAt(armIx)
  match a {
    IfStmt => {
      return retValueExitCount(armIx, fnIx)
    }
    Block => {
      const av = ifArmValueExpr(armIx)
      if av >= 0 { return retValueExitCount(av, fnIx) }
    }
    // any other arm is one exit
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  1
}

// Is the local `collectLocals` gave the `let` at `declIx` the union box rep (kind 4)? The
// binding sink's prediction asks this: `buildLocals` has already run.
function letIsUnionSlot(declIx: i32) {
  const s = localSlotOfDecl[declIx] ?? -1
  s >= 0 && localIsRef[s] == "union"
}

// Does the statement at `stmtIx` hold a `let`/`const` of the union BOX rep whose init is
// an if-EXPRESSION — the shape the binding sink rewrites? Deliberately does NOT descend
// into a nested `FuncDecl`, whose locals belong to its own lifted wasm function.
function blockHasUnionLetIf(stmtIx: i32) {
  if stmtIx < 0 { return false }
  const s = nodeAt(stmtIx)
  match s {
    FuncDecl => {
      return false
    }
    LetDecl => {
      if exprIsIfStmt(s.letInit) { return letIsUnionSlot(stmtIx) }
      return false
    }
    Block => {
      const stmts = s.blkStmts
      let i = 0
      while i < stmts.length {
        if blockHasUnionLetIf(stmts[i]) { return true }
        i = i + 1
      }
      return false
    }
    IfStmt => {
      if blockHasUnionLetIf(s.ifThen) { return true }
      return blockHasUnionLetIf(s.ifElse)
    }
    WhileStmt => {
      return blockHasUnionLetIf(s.whileBody)
    }
    ForRange => {
      return blockHasUnionLetIf(s.frBody)
    }
    ForIn => {
      return blockHasUnionLetIf(s.fiBody)
    }
    // no other statement holds a binding
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | Param | TypeRef | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// True when function `fnIx` should reserve the union-box sink pair for a binding: it holds
// a union-box `let`/`const` initialized by an if-expression, so an arm's box can be sunk
// past the merge. A prediction only (`unionIfBindingAllBox` decides at lowering time
// whether the rewrite fires); over-firing costs two unused locals, under-firing declines a sink.
export function fnUnionLetSinkOk(fnIx: i32) {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl { return blockHasUnionLetIf(fn.fnBody) }
  false
}

export function retNulRefFlag(tyIx: i32) {
  if tyIx >= 0 {
    // The checker recorded this node's type as a nullable declared struct (`S | null`).
    if nodeTyIsNulStruct(tyIx) { return 1 }
    const ty = nodeAt(tyIx)
    if ty is TypeRef {
      // A union variant with no struct row is `nulvariant`, not kind 9 (`retNulVariantFlag`
      // is the positive answer) — excluded here, at the one producer: `collectS` refuses a
      // variant its own struct row, so every `nulstruct` answer pairs a real struct index.
      if nulVariantIndexOf(tyIx) >= 0 { return 0 }
      // Otherwise the rep column answers: a nullable object is kind 9, and `string | null`
      // (the kind-16 ref) or a node with no nullable rep is not.
      const nrt = nodeRepTyIxOf(tyIx)
      if nrt >= 0 {
        const tn = tyAt(nrt)
        if tn is TyNullable {
          if tn.nInner >= 0 {
            const ti2 = tyAt(tn.nInner)
            if ti2 is TyObj { return 1 }
          }
        }
      }
    }
  }
  0
}

// A nullable union variant annotation or expression (`Circle | null`, `x as? Circle`) — `1`,
// else `0`. Disjoint from `retNulRefFlag`, which returns 0 wherever this index answers.
// Defined in terms of the index (`nulVariantIndexOf`), so the kind/slot pair can't disagree.
export function retNulVariantFlag(tyIx: i32) {
  if nulVariantIndexOf(tyIx) >= 0 { return 1 }
  0
}

// The variant table index behind a concrete-variant annotation at `tyIx`, or -1: its declared
// name's row, else the row of its recorded type, which a generic instance spells by shape
// (`{r:i32}` for a pinned `T`) where the name table has no entry (D12900), else the row of
// an arm of the same shape, which a structural twin of that arm is.
export function annVariantRowOf(tyIx: i32): i32 {
  if tyIx < 0 { return -1 }
  const n = nodeAt(tyIx)
  if n is TypeRef {
    const vi = variantIndexOf(n.tyName)
    if vi >= 0 { return vi }
  }
  repVariantShapeRowOf(nodeTyIxOf(tyIx))
}

// The variant table index behind a `Circle | null` annotation or expression at `tyIx`, or
// -1 — the `nulvariant` half of `annValtypeSlotOf`'s kind/slot pairing, read off the recorded
// type, so a context-typed lambda parameter spelled by shape (`{r:i32}|null`) finds the row
// its declared twin does. A variant that also has a struct row keeps kind 9.
export function nulVariantIndexOf(tyIx: i32) {
  if tyIx < 0 { return -1 }
  const nvt = nodeTyIxOf(tyIx)
  if nvt >= 0 {
    const nvty = tyAt(nvt)
    if nvty is TyNullable { return repVariantShapeRowOf(nvty.nInner) }
  }
  -1
}

// The base struct table index of a `S | null` annotation at `tyIx`, or -1.
export function retNulRefIndex(tyIx: i32) {
  if tyIx >= 0 {
    // Structural-first: the checker's recorded arena type resolves the slot directly
    // (`repSlotOfTy`, nominal identity plus the structural-declared bridge). Confirms only.
    const rt = nodeRepTyIxOf(tyIx)
    if rt >= 0 {
      const t = tyAt(rt)
      if t is TyNullable {
        const ds = repSlotOfTy(t.nInner)
        if ds >= 0 { return ds }
      }
    }
    const ty = nodeAt(tyIx)
    if ty is TypeRef {
      const nb = nulBaseStructRow(tyIx)
      if nb >= 0 { return nb }
    }
  }
  -1
}

// The struct row of the base of a nullable-struct annotation (`S | null` -> `S`'s row), or -1.
// The canonical row when the type picks one, else the first declared or annotation row whose
// recorded type is the base: a `??` family's object literal records its context's type while
// its fields are boxed, so a literal row is never this annotation's layout.
export function nulBaseStructRow(tyIx: i32): i32 {
  const nt = nodeRepTyIxOf(tyIx)
  if nt < 0 { return -1 }
  const t = tyAt(nt)
  if !(t is TyNullable) { return -1 }
  const inner = t.nInner
  if inner < 0 { return -1 }
  if !(tyAt(inner) is TyObj) { return -1 }
  const ar = repRowOfTyStruct(inner, sScanLim())
  if ar >= 0 { return ar }
  namedRowOfTy(inner)
}

// The first struct row not minted for an object literal whose recorded type is `ty`, by
// identity and then by `tySame`, or -1.
function namedRowOfTy(ty: i32): i32 {
  let s = 0
  while s < sTyIx.length {
    if sTyIx[s] == ty && !sIsAnonRow(s) && !sIsRefRow(s) { return s }
    s = s + 1
  }
  let q = 0
  while q < sTyIx.length {
    if sTyIx[q] >= 0 && !sIsAnonRow(q) && !sIsRefRow(q) {
      if tySame(sTyIx[q], ty) { return q }
    }
    q = q + 1
  }
  -1
}

// `1` if the type-annotation node at `tyIx` names the struct, else `0` (i32 / none).
// Used for functype param/result valtypes and the `"struct"` return kind. Returning the
// flag (not pushing bytes) keeps each call free of a `0→1` local reassignment, which
// pins a `let x = 0` to the literal `0` type and fails to typecheck.
export function retTRFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a declared struct —
    // confirm directly, skipping the O(nodes) `nameIsStructDecl` scan `isSName` walks. Only
    // CONFIRMS (never denies), so anything it doesn't cover falls to the name test below.
    if nodeTyIsStruct(tyIx) { return 1 }
    return 0
  }
  0
}

// The struct-TABLE row the type annotation at `tyIx` names, or -1. Struct rows only: a
// union-variant name has no row of its own, and its VARIANT index belongs to another table.
// The two coincide only while the arm's struct is row 0, so a reader wanting a row asks
// here and never the twin below (D1737).
export function retStructRowIndex(tyIx: i32) {
  if tyIx < 0 { return -1 }
  const ds = repSlotOfTy(nodeRepTyIxOf(tyIx))
  if ds >= 0 { return ds }
  const ty = nodeAt(tyIx)
  if ty is TypeRef {
    const si = structIndexByName(ty.tyName)
    if si >= 0 { return si }
    // The arena rung the name scan needs: a struct that is also a union VARIANT has its row
    // registered under the structural render, not its declared name, so only a match on the
    // recorded TYPE finds it. Without this the variant-table index answered in its place.
    const rr = repRowOfTyStruct(nodeRepTyIxOf(tyIx), sScanLim())
    if rr >= 0 { return rr }
    // An annotation served by a wider row a literal already interned is recorded against its
    // arena type only, since no row carries its spelling (D8340).
    const ar = structIndexOfTy(nodeRepTyIxOf(tyIx))
    if ar >= 0 { return ar }
    return nulBaseStructRow(tyIx)
  }
  -1
}

// The struct table index named by the type-annotation node at `tyIx`, or -1 if it
// names no declared struct.
export function retStructIndex(tyIx: i32) {
  if tyIx >= 0 {
    // Structural-first (the first arena-keyed row consumer): a struct annotation resolves
    // its slot off the checker's arena type (`repSlotOfTy`), skipping the name scan. This
    // includes the structural-declared bridge (an inline `{…}` resolving to its unique
    // declared twin), byte-safe now that the sig-canon slice renders twin-safe `$fnsig` digits.
    const ds = repSlotOfTy(nodeRepTyIxOf(tyIx))
    if ds >= 0 { return ds }
    const ty = nodeAt(tyIx)
    if ty is TypeRef {
      const si = structIndexByName(ty.tyName)
      if si >= 0 { return si }
      // A union-variant name carries its VARIANT index here (consumed by `pushVT`'s
      // `kind == 8` variant-struct case); not a standalone struct, so it is -1 above.
      const vi = variantIndexOf(ty.tyName)
      if vi >= 0 { return vi }
      // A `S | null` annotation resolves to its BASE struct's index — the single
      // chokepoint the param/local/return struct lookups read, so a nullable-struct
      // binding's member layout resolves without separate plumbing.
      return nulBaseStructRow(tyIx)
    }
  }
  -1
}

// The name the emitter's own shape table claims for the arena struct row `ty`, or "" when
// no row claims it (D592). The monomorphizer's un-annotated struct return needs a real
// name, not a printed shape (`tyToStructStr` prints `{x: i32}`, which nothing registered);
// `sNames[si]` is the row's own name, what every name-keyed consumer resolves.
export function monoRetRowName(ty: i32) {
  const si = repSlotOfTy(ty)
  if si >= 0 {
    if si < sNames.length { return sNames[si] }
  }
  // D681 — the anonymous row, by arena identity and nothing else: `repSlotOfTy` covers
  // declared rows only, so a shape that only appeared as an object literal answers -1
  // there even though `collectAnonShapes` interned exactly this row, under an `#anonN`
  // handle. Nominal, not structural — a printed-spelling match can't tell two generic instances apart.
  const ai = sAnonRowByTy(ty)
  if ai >= 0 { return sNames[ai] }
  ""
}

// The ANONYMOUS struct-table row whose D0 `sTyIx` sidecar entry IS the arena type `ty`, or
// -1 — `repSlotOfTyDecl`'s nominal leg with the `sRowDecl` gate replaced by its complement.
// First match wins, as in every other row scan; the sidecar holds -1 for a row it does not
// cover, which never matches a real type.
function sAnonRowByTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  let i = 0
  while i < sTyIx.length {
    if sTyIx[i] == ty {
      if sIsAnonRow(i) { return i }
    }
    i = i + 1
  }
  -1
}

// The ref-list table slot a type-annotation node at `tyIx` names (`Tok[]` → the `Tok`
// slot), or 0 when it isn't a ref-array annotation.
export function tyAnnRefListSlot(tyIx: i32) {
  if repShadowOn { repABNote("clamp", "tyAnnRefListSlot", "call") }
  if tyIx >= 0 {
    // Which ref-list ROW holds this annotation's element — the recorded type first,
    // then the row the INTERN pass banked on the node. `| null`-tolerant, exactly as
    // the intern arm is.
    const raS = annRefArrSlot(tyIx)
    if raS >= 0 { return raS }
  }
  if repShadowOn {
    // The distinction that decides the hazard: a clamp for an annotation that is NOT a ref
    // list is the correct "no row of mine"; a clamp for one that IS is the missing row.
    if retRefArrFlag(tyIx) == 1 || retNulRefArrFlag(tyIx) == 1 {
      repABNote("clamp", "tyAnnRefListSlot", "CLAMPED-isRefList")
    } else {
      repABNote("clamp", "tyAnnRefListSlot", "CLAMPED-notRefList")
    }
  }
  0
}

// `1` if the type-annotation node at `tyIx` is a REF array (`S[]`/`N[]`), else `0`.
// Feeds the `kind == 5` (ref list) branch of `pushVT`.
export function retRefArrFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node as an array of a declared struct
    // (`S[]`) — the clean base case, without the O(nodes) name scan the bare element match walks.
    if nodeTyIsStructArray(tyIx) { return 1 }
    // A ref-list ROW for the annotation's element IS the intern-state question, and covers the
    // nested / union / niche element spellings the struct-array fast path above declines. Gated
    // to a NON-nullable annotation — a `S[] | null` spelling is `retNulRefArrFlag`'s.
    if annBareRefArrSlot(tyIx) >= 0 { return 1 }
  }
  0
}

// `1` if the type-annotation node at `tyIx` is a nullable ref array (`<ref-array> | null` —
// e.g. `S[] | null`, `i32[][] | null`), else `0`. The value/composite-position analogue of
// the local ladder's `letIsNulRefArray` (kind 18, `"nulreflist"`): a `(ref null $wrapper)`
// slot over the inner ref-list's element wrapper. Feeds the `"nulreflist"` arm of `vtKindOfType`.
export function retNulRefArrFlag(tyIx: i32) {
  if tyIx >= 0 {
    // A `TyNullable` annotation whose inner array's element owns a ref-list ROW, with the
    // nullable gate carried by `annNulRefArrSlot` so a bare `S[]` still answers 0.
    if annNulRefArrSlot(tyIx) >= 0 { return 1 }
  }
  0
}

// The folded list-rep code of a function return annotation `tyIx`: `2` i32-list, `5`
// ref-list, `7` string-list, `12` f64-list, or `0` (not a list). The four `nameIs*Array`
// predicates are mutually exclusive by name, so the priority order is immaterial.
export function retListKindFlag(tyIx: i32) {
  if retArrFlag(tyIx) == 1 { return 2 }
  if retRefArrFlag(tyIx) == 1 { return 5 }
  if retStrArrFlag(tyIx) == 1 { return 7 }
  if retF64ArrFlag(tyIx) == 1 { return 12 }
  0
}

// The ref-list element type-NAME of a function RETURN type node `tyIx` (an `S[]`/`N[]`),
// or "". Populates `fRetRArrElem`.
export function retRefArrElemName(tyIx: i32) {
  if tyIx >= 0 {
    const ty = nodeAt(tyIx)
    // The row keyed by the annotation's element type; "" for a non-ref-array annotation is
    // the same "" this function's tail returns.
    if ty is TypeRef { return annBareRefArrElemName(tyIx) }
  }
  ""
}

// An emitter-synthesized type-annotation node (a mono clone, an inferred-list synthesis, a
// contextual return/param pin). Records the concrete type on the new node so the
// structural classifiers cover it (`recordClonedNodeTy`), uniformly across every synthesis
// site. The returned node carries its resolved type, so a caller reads it off the node.
export function synthTypeRef(name: string, pos: i32) {
  synthTypeRefTy(name, pos, -1)
}

// `synthTypeRef` with a FALLBACK type: the name is resolved first and wins, and `tyFb` is
// used only where it does not resolve — where `synthTypeRef` records a coarse placeholder.
// See `recordClonedNodeTyFb` for the measurement that fixes this precedence.
export function synthTypeRefFb(name: string, pos: i32, tyFb: i32) {
  const n = mkTypeRef(name, pos)
  const pin = pinKindOfName(name)
  recordNodePin(n, pin)
  recordClonedNodeTyFb(n, name, pin, tyFb)
  n
}

// `synthTypeRef` with the type handed over instead of parsed back out of `name`. See
// `recordClonedNodeTyKnown`. `tyIx` of -1 is exactly `synthTypeRef`.
export function synthTypeRefTy(name: string, pos: i32, tyIx: i32) {
  const n = mkTypeRef(name, pos)
  const root = tyTsExact(tyIx)
  if root >= 0 { setAnnTs(n, root) }
  const pin = pinKindOfNameTy(name, tyIx)
  recordNodePin(n, pin)
  recordClonedNodeTyKnown(n, name, pin, tyIx)
  n
}

// `pinKindOfName` for a caller holding the name's arena type `ty`, or -1: a spelled shape
// whose type is a record is placed by its field types rather than by texts cut from `name`.
function pinKindOfNameTy(name: string, ty: i32) {
  if sigKeyPinPayload(name) != "" { return PIN_SIGKEY }
  if structIndexOfTypeNameTy(name, ty) >= 0 { return PIN_ANON }
  PIN_NONE
}

// The mint-side bridge of the pin column: which provenance, if any, the synthesized name
// `name` carries. Every pin enters the arena through `synthTypeRef` above, so classifying
// here covers the column completely. The anon leg is an exact-name query
// (`isSName`) — a prefix test would also match `"#anon3[]"`, an array of an interned shape.
export function pinKindOfName(name: string) {
  if sigKeyPinPayload(name) != "" { return PIN_SIGKEY }
  if isSName(name) { return PIN_ANON }
  PIN_NONE
}

// The nullable-scalar-list VKind of annotation node `tyIx`, or `null`. Arena-first and
// total where it covers: the spelling can't tell the four cases apart any more, since
// `canonEmitName` softens a bare inline literal union to its base scalar. A covered
// annotation outside the four answers `null` outright, not a name that lost the distinction.
export function nulScalarListKindOfNode(tyIx: i32): VKind | null {
  if tyIx < 0 { return null }
  const rk = annRepKindOf(tyIx)
  if rk != null {
    if isNulScalarListKind(rk) { return rk }
    return null
  }
  const ty = nodeAt(tyIx)
  if ty is TypeRef { return nulScalarListKind(ty.tyName) }
  null
}
// The `emitArr` list-build code (`LBK_*`) a nullable-scalar-list
// value's list literal builds with: strlist 3 · f64list 4 · i64list 6 · f32list 7 (the leaf-list
// build codes), or 0 if `kind` is not a nullable scalar list.
export function nulScalarListBuildKind(kind: VKind | null): i32 {
  // Exhaustive over `VKind` and `_`-less, `null` included: `0` is a real answer — not a
  // nullable scalar list — so a new kind must say whether it has a build code (D1898).
  match kind {
    "nulstrlist" => {
      return LBK_STR_LIST
    }
    "nulf64list" => {
      return LBK_F64_LIST
    }
    "nuli64list" => {
      return LBK_I64_LIST
    }
    "nulf32list" => {
      return LBK_F32_LIST
    }
    "nulu8list" => {
      return LBK_NUL_U8_LIST
    }
    "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulmap" | "nulnone" | "u8list" | "v128" | null => {
      // Not a nullable scalar list, so it builds through no leaf-list code of its own.
      return LBK_I32_LIST
    }
  }
}
// True if `kind` is one of the four distinct-backing nullable-scalar-list VKinds.
export function isNulScalarListKind(kind: VKind | null): boolean {
  if kind == null { return false }
  kind == "nulstrlist"
    || kind == "nulf64list"
    || kind == "nuli64list"
    || kind == "nulf32list"
    || kind == "nulu8list"
}
// The nullable-scalar-list VKind behind a field code, or null: the inverse of
// `nulScalarListFieldCode`, so the store/read/null paths recover the leaf's build kind
// (`nulScalarListBuildKind`) and wrapper heap (`nulScalarListWrapHeap`) from the code alone.
export function nulScalarListCodeKind(code: i32): VKind | null {
  const k = listRepOfFieldCode(code)
  if isNulScalarListKind(k) { return k }
  null
}
// True if field code `c` is one of the distinct-backing nullable-scalar-list codes.
export function isNulScalarListFieldCode(c: i32): boolean {
  nulScalarListCodeKind(c) != null
}

// The same question asked of an arena index rather than an annotation node — an array
// whose element is a nullable string, needed after `annIsNulStrListDeep` peels an outer
// `| null` and has no node left to ask.
function tyIsNulStrArr(ty: i32) {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyArray {
    if t.aElem < 0 { return false }
    const e = tyAt(t.aElem)
    if e is TyNullable {
      if e.nInner < 0 { return false }
      const inner = tyAt(e.nInner)
      if inner is TyPrim { return inner.primName == "string" }
    }
  }
  false
}

// True if the type-annotation node at `tyIx` is a `(string | null)[]`, also through one
// `| null` wrapper (the form a `!= null` narrow leaves). An inline `(("a" | "b") | null)[]` is
// the atom niche, not the string backing. A node with no recorded type answers false.
export function annIsNulStrListDeep(tyIx: i32) {
  if tyIx < 0 { return false }
  let ty = nodeTyIxOf(tyIx)
  if ty >= 0 {
    const t = tyAt(ty)
    if t is TyNullable { ty = t.nInner }
  }
  if tyIsNulLitUnionArr(ty) { return false }
  if ty >= 0 { return tyIsNulStrArr(ty) }
  false
}

export function vtKindOfType(tyIx: i32): VKind {
  const rk = annRepKindOf(tyIx)
  if rk != null { return rk }
  // An annotation with no recorded type: a nullable numeric literal union (`1 | null`) is the
  // value-union box; any other takes the scalar default.
  if nodeTyIsNulNumLitUnion(tyIx) { return "union" }
  "i32"
}

// `1` if the type-annotation node at `tyIx` is a string-keyed map (`{[string]: V}`), else `0`.
// Feeds the `kind == 6` (map struct ref) branch of `vtKindOfType`, so a map can be a param /
// return / functype valtype (the `(ref $mapStruct)` cell), not only a local.
export function retMapFlag(tyIx: i32) {
  if tyIx >= 0 {
    const ty = nodeAt(tyIx)
    if ty is TypeRef {
      // A string-keyed map crosses a call boundary as kind 6 (`(ref $mapStruct)`), gated by
      // the same classifier the local path interns with (`mvValKindOfName`). A map-member
      // union (`{[string]: V} | X`) also starts with `{[`, but the arena distinguishes a
      // bare `TyMap` from a `TyUnion` with no false positive (D-BAREMAP).
      if nodeTyIsMap(tyIx) {
        // The arena's value type, not the annotation's spelling: reached through
        // `nodeTyMapValName`, so an alias or softened literal union can't change the
        // answer. Not fully spelling-free — `mvValKindOfName` still tests a name, just one read from the arena.
        if mapNodeValKindLowerable(tyIx) { return 1 }
      }
    }
  }
  0
}

// `1` if the type-annotation node at `tyIx` is a nullable string-keyed map (`{[string]: V}
// | null`), else `0` — the map analogue of `retNulRefFlag`/`retNulRefArrFlag`: a
// `(ref null $mapStruct)` niche. Gated to the same supported value kinds as the non-null
// `retMapFlag`, so an unrepresentable nullable-map value keeps failing loudly (D-BAREMAP).
export function retNulMapFlag(tyIx: i32) {
  if tyIx >= 0 {
    const ty = nodeAt(tyIx)
    if ty is TypeRef {
      if tyIsNulBareMap(tyIx) {
        if mapTyValKindLowerable(nonNullTy(nodeTyIxOf(tyIx))) { return 1 }
      }
    }
  }
  0
}

// The map shape (`fbValtype`/`mapTypeIdxOf` second arg) of a string-keyed map type
// annotation: -1 for the mono i32/boolean map, or the value type's interned mv slot. Safe
// for a non-map/un-interned value, since `retMapFlag` only admits supported value types.
// Shared by the param/return valtype and the body shape resolution (`mapShapeOfExpr`).
export function mapAnnShape(tyIx: i32) {
  if tyIx >= 0 {
    const ty = nodeAt(tyIx)
    if ty is TypeRef {
      // A NULLABLE map annotation (`{[string]: V} | null`) resolves its shape from the BARE inner
      // map — its `(ref null $mapStruct)` cell selects the SAME `$mapStruct` its non-null twin does.
      let mn = ty.tyName
      const nim = nulMapInnerName(mn)
      if nim != "" { mn = nim }
      if nameIsMap(mn) {
        // The key selects which map struct family the annotation names — the param/
        // return/nulmap valtype and the body shape must agree. The arena answers where it
        // covers the node (`nodeTyMapKeyKindSpan`, recursing `TyNullable` so the folded
        // nulmap spelling is covered too); an uncovered node keeps the name bridge.
        let kAn = mapNameKeyKind(mn)
        if nodeTyIxOf(tyIx) >= 0 { kAn = nodeTyMapKeyKindSpan(tyIx) }
        // The value is the node's banked type (D-MAPNODETY), named as the mint names it; an
        // uncovered node has no value to name and resolves by key alone below.
        const vtAn = nodeMapValTyIx(tyIx)
        const vn = mvDeclNameOfValTy(vtAn)
        // A mono value rides the shared struct of its own key rep: the `-1`/`-4` pair.
        if vn == "i32" || vn == "boolean" { return mapMonoShapeOfKey(kAn) }
        if vn != "" {
          // The slot's key and arm hint come off this node exactly as the mint computes them
          // (D48): `vn` alone cannot tell an arm from its layout twin, and a find that keys
          // differently from the mint mints a second slot whose map struct is never filled in.
          const vnA = mvArmKeyName(vn, vtAn)
          const armAn = mvArmHintOfShapeTy(vtAn)
          let aAn = mvSlotOfTyKArm(vtAn, kAn, armAn)
          if aAn < 0 { aAn = mvSlotOfValNameTyKArm(vnA, kAn, armAn) }
          if aAn >= 0 { return aAn }
          const nmAn = mvSlotByValNameKArm(vnA, kAn, armAn)
          if nmAn >= 0 { return nmAn }
        }
        // A mono-repped value spelling the two scans above never intern (a literal-union
        // atom, a nullable atom) still resolves by KEY alone.
        if kAn != MAP_KEY_STR { return mapMonoShapeOfKey(kAn) }
      }
    }
  }
  -1
}

// The map SHAPE of the map PARAM `name` of function `fnIx` (its annotation's value type),
// or -1. Lets `mapShapeOfExpr` resolve a map param's VALUE type instead of assuming mono i32.
export function paramMapShape(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = nodeAt(params[i])
      if p is Param {
        if p.parName == name { return mapAnnShape(p.parType) }
      }
      i = i + 1
    }
  }
  -1
}

// ── the re-entrancy guard on an inferred map return's shape ──────────────────
// The `fnStmts` positions whose inferred map-return shape is currently being resolved. A
// stack, not a flag, since a chain of map factories nests legitimately. On re-entry the
// answer is the checker's own recorded type on the call node, never a bare -1 (D30).
export let retMapFlight: i32[] = []

// Drop any in-flight map-return resolution. Called from `emitProgram`'s state block.
export function resetRetMapFlight() {
  retMapFlight = []
  0
}

// True when `fe`'s inferred map-return shape is already being resolved further up the stack.
export function retMapInFlight(fe: i32) { i32ListHas(retMapFlight, fe) }

// The map shape the CHECKER recorded on the call node at `callIx`, or -1 — the re-entry
// answer, and the same rung `mapShapeOfExpr` / `mapRetExprShape` fall through to when the
// syntactic path cannot name the callee.
export function mapRecordedCallShape(callIx: i32) {
  if callIx >= 0 {
    if nodeTyIsMap(callIx) { return mapFindShapeOfNodeTy(callIx) }
  }
  -1
}

// `1` if the type-annotation node at `tyIx` names a union VARIANT struct (e.g. `TyObj`
// of `Ty`), else `0`. Feeds the `kind == 8` (concrete variant struct ref) branch of
// `pushVT`. A variant-struct param/result is the unboxed variant ref directly — gap #2.
export function retVariantFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a union-variant member.
    if nodeTyIsVariant(tyIx) { return 1 }
    return 0
  }
  0
}

// `1` if the type-annotation node at `tyIx` names the declared union alias, else `0`.
// Feeds the `kind == 4` (union box) branch of `pushVT`.
export function retUnionFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a declared value-union box.
    if nodeTyIsUnionAlias(tyIx) { return 1 }
    return 0
  }
  0
}

// The `pushVT` `VKind` for a parameter node at `paramIx` (`"struct"`, `"list"`,
// `"str"`, `"i32"`, …) — its annotation's `vtKindOfType`, or `"i32"` for a node
// that is not a `Param`.
export function vtKindOfParam(paramIx: i32): VKind {
  const p = nodeAt(paramIx)
  if p is Param { return vtKindOfType(p.parType) }
  "i32"
}

// The second `fbValtype` arg for the parameter node at `paramIx` — its annotation's
// companion slot, through the shared ladder below. The PARAM storage class's name for
// `annValtypeSlotOf`, kept so `emitTypeSection` and the `$fnsig` tokens read a
// param-shaped question; every kind-to-table pairing lives in the one home.
export function paramStructIdxOf(paramIx: i32) {
  const p = nodeAt(paramIx)
  if p is Param { return annValtypeSlotOf(p.parType) }
  -1
}

// The one home for "which interned table slot does this type annotation's `fbValtype`
// select" — the companion index every ref-bearing `VKind` needs: `reflist`/`nulreflist`
// read the ref-list table slot, `map`/`nulmap` the map shape (mono ⇒ -1), `variant` the
// union-variant index, everything else `retStructIndex`.
export function annValtypeSlotOf(tyIx: i32) {
  if retRefArrFlag(tyIx) == 1 { return tyAnnRefListSlot(tyIx) }
  // A nullable ref array (kind 18) — its `(ref null $wrapper)` slot is the inner ref-list
  // element wrapper (`tyAnnRefListSlot` is `| null`-aware), mirroring the non-null one above.
  if retNulRefArrFlag(tyIx) == 1 { return tyAnnRefListSlot(tyIx) }
  if retMapFlag(tyIx) == 1 { return mapAnnShape(tyIx) }
  // A nullable map (`{[string]: V} | null`) — the same map shape selects its
  // `(ref null $mapStruct)` cell's heap type (`mapAnnShape` is `| null`-aware).
  if retNulMapFlag(tyIx) == 1 { return mapAnnShape(tyIx) }
  // The variant kind is `annRepKindOf`'s where it answers, so the slot follows it to a twin.
  const variant = retVariantFlag(tyIx) == 1 || annRepKindOf(tyIx) == "variant"
  if variant && tyIx >= 0 && tyIx < P.nodes.length {
    if nodeAt(tyIx) is TypeRef { return annVariantRowOf(tyIx) }
  }
  // `Circle | null` — the variant index under the null, the slot `fbValtype`'s
  // `nulvariant` arm indexes `variantHeap` with. The struct rung below cannot answer it:
  // a variant has no struct row.
  if retNulVariantFlag(tyIx) == 1 { return nulVariantIndexOf(tyIx) }
  // Row-only: every variant kind is answered above, so a variant index reaching this tail
  // would be one table's index in the struct kinds' channel (D1737).
  retStructRowIndex(tyIx)
}

// Whether the module global of symbol `sid` has a non-const initializer — used at READ sites
// (`global.get`) to decide whether the (nullable) cell needs a `ref.as_non_null`.
export function globalNameIsNonConstSid(sid: i32) {
  globalIsNonConst(globalLetOfSid(sid))
}

// ── the `globalCellKind` walk memo (D1513) ───────────────────────────────────
// This ladder re-enters itself: a rung asks an `expr*` predicate that reaches a
// referenced global, whose kind comes back through here, so one link in a chain
// multiplies the work instead of adding to it, exhausting the GC heap on a valid program.
export let gckHave: i32[] = []
export let gckVal: VKind[] = []
export let gckGen = 1
const gckGenKey = memoKeyNew(7)

// Has any input the ladder reads changed since the key last read it? The arena's in-place
// epoch, the LENGTH of every append-only collect table a rung consults, and the PASS a slot's
// answer belongs to — a rung reads `fRetKind`, which a pass further down the table fills in
// place, so an answer may not outlive its own pass (D1655).
export function gckStale(): boolean {
  // The common answer, read without recording: nothing moved since the last ask.
  const s = gckGenKey.seen
  if (
    s[0] == tyMutEpoch
    && s[1] == sNames.length
    && s[2] == sFieldCount.length
    && s[3] == unNames.length
    && s[4] == uVariants.length
    && s[5] == emitPassGen
    && s[6] == P.nodes.length
  ) {
    return false
  }
  let moved = memoMoved(gckGenKey, 0, tyMutEpoch)
  moved = memoMoved(gckGenKey, 1, sNames.length) || moved
  moved = memoMoved(gckGenKey, 2, sFieldCount.length) || moved
  moved = memoMoved(gckGenKey, 3, unNames.length) || moved
  moved = memoMoved(gckGenKey, 4, uVariants.length) || moved
  moved = memoPassMoved(gckGenKey, 5) || moved
  memoMoved(gckGenKey, 6, P.nodes.length) || moved
}

// Forget every answer in one step: a slot is a hit only while its own stamp equals the live
// generation, so nothing computed under an older one can be read. Emptying the columns
// instead re-grew them from zero to a module global's arena index on the next question, once
// per minted generic instance — the memo's own cost, not its ladder's (D1513).
export function gckDrop() {
  gckGen = gckGen + 1
  // A wrapped generation could alias a slot's old stamp; restarting from an empty column
  // cannot. Unreachable in a compile (one bump per arena change), cheap to make impossible.
  if gckGen < 0 {
    gckHave = []
    gckVal = []
    grStamp = []
    grLet = []
    grKnown = []
    grVal = []
    gckGen = 1
  }
  0
}

// ── the module-global read memo (D3051) ──────────────────────────────────────
// Whether a global reads as an f64, an i64 or a string re-classifies its initializer, which
// names earlier globals, so a const chain naming its predecessor twice is 2^depth walks. One
// answer per global and question, under `globalCellKind`'s generation: same inputs, same pass.
export let grStamp: i32[] = []
export let grLet: i32[] = []
export let grKnown: i32[] = []
export let grVal: i32[] = []

// True if the type-name `name` refers to one of the declared struct types.
export function isSName(name: string) { structIndexOfTypeName(name) >= 0 }

// The struct-table ROW whose arena type is `ty`, or -1 — `isStructOfTy`'s index-returning
// twin, with the same two passes and the same first-match-wins rule.
export function structRowOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  const own = structRowRecordingTy(ty)
  if own >= 0 { return own }
  let q = 0
  while q < sTyIx.length {
    if tySame(sTyIx[q], ty) && !sIsRefRow(q) { return q }
    q = q + 1
  }
  -1
}

// The struct-table index for a ref-list element name, stripping a `| null` niche suffix
// first (a nullable-struct array's slot keys on the full `"P | null"`, but the struct it
// stores/reads is the bare `P`). Nominal first (`structIndexByName`), then the structural
// bridge (`structIndexOfTypeName`) for an inline-shape element deduped onto its declared twin.
export function structIdxOfElemName(name: string) {
  const n = nonNulBaseOf(name)
  // Nominal exact-name match first: unambiguous, cheap, and it moves no bytes.
  const sbn = structIndexOfTypeName(n)
  if sbn >= 0 { return sbn }
  // The same nominal floor `rlElemStructRow` carries, at the second copy of this ladder
  // (D63): a registered union variant that isn't also a registered plain struct has no
  // struct-table row (its heap is `variantHeap(vi)`), so every structural rung below must
  // decline rather than bridge the arm's shape onto a standalone struct row (D32, D36/D38).
  if variantIndexOf(n) >= 0 { return -1 }
  // Consults the canon-key vocabulary (`repRowOfName` → `resolveAnnot` → `repRowOfTyStruct`)
  // rather than the lenient fieldset scan, since it distinguishes a same-fieldset nested
  // twin (`{f: {f: i64 | null}}` vs its inner row) by the full nested field type. After the
  // nominal consult, before the fieldset scan: trust the arena where it covers the element.
  const rr = repRowOfName(n, sScanLim())
  if rr >= 0 { return rr }
  structIndexOfTypeName(n)
}

// The ladder↔descriptor agreement oracle: per (family, ladder answer, descriptor answer)
// tallies, so a family is graded "0 disagreements" over the corpus before its ladder is
// deleted. Keyed by the PAIR, so a new family needs no slot arithmetic and the report names
// the exact disagreement. Accumulated during emit, reported after `repShadowSweep`'s reset.
let repABKeys: string[] = []
let repABCnt: i32[] = []
let repABIx: {[string]: i32} = Map()

// One (ladder, descriptor) pair recorded. Called only when armed, so the map growth and the
// read-modify-write are off the unarmed path entirely.
export function repABNote(family: string, ladder: string, desc: string) {
  const k = family + " " + ladder + " -> " + desc
  const i = repABIx[k] ?? -1
  if i >= 0 {
    repABCnt[i] = repABCnt[i] + 1
    return 0
  }
  repABIx[k] = repABKeys.length
  repABKeys.push(k)
  repABCnt.push(1)
  0
}

// Reported once per program beside `unionRegistryABSweep`, after `repShadowSweep` has reset
// the bucket table — a bump during emit would not survive that reset.
export function repLadderABSweep() {
  if !repShadowOn { return 0 }
  let i = 0
  while i < repABKeys.length {
    repShadowAddReason("repAB/" + repABKeys[i], repABCnt[i])
    i = i + 1
  }
  repABKeys = []
  repABCnt = []
  repABIx = Map()
  0
}

// The one home of the monomorphized closure pin's marker: the `$fnsig` key a closure-pinned
// parameter carries in its `TypeRef.tyName` slot behind a bare `"=>"` prefix (`"=>i>d"`), or
// "" when `nm` is not a pin. Not the function-type arrow (which sits at a positive index
// behind a parenthesized param list) — this asks whether the column holds an interned ABI key.
export function sigKeyPinPayload(nm: string) {
  if nm.length <= 2 { return "" }
  if nm[0] != '=' { return "" }
  if nm[1] != '>' { return "" }
  // Bound rather than left as the trailing expression: a bare member-call statement is not
  // a lowerable form, the same reason `arrElemNameRaw`/`annRetNameOf` bind their slices.
  const payload = nm.slice(2, nm.length)
  payload
}
