// Inferred-null holes and the loop-value columns: a `let x = null` binding's fill, the
// exit-first arms and bindings, and the value type of a loop or labelled block.
// Does not import the checker.
import { Block, IfStmt, LetDecl, MatchExpr, NullLit, P, Paren } from "./ast"
import { inferQuiet } from "./check_cursor"
import { T, TyNullable } from "./check_types"
import { cwPeel } from "./check_write_scan"
import { i32ListAt } from "./listutil"

// D1576 — the never-filled A-infer-null hole. `let x = null` binds `mkNullableTy(-1)` and the
// first non-null assignment fills the inner in place, so at the declaration nobody can say
// whether the binding is `T | null` or just `null`. `flushUninferred` re-reads `nInner` at scope
// close; a hole still open there has type `null`, whose rep is `nullref`.
export let nhPendIxs: i32[] = []
export let nhPendTys: i32[] = []
export let nhPendDepths: i32[] = []
export let nhUnfilledIxs: i32[] = []
// The holes a write did fill, as LetDecl node and its filled `T | null`, banked at the same close.
export let nhFilledIxs: i32[] = []
export let nhFilledTys: i32[] = []

// Record an A-infer-null hole for the deferred scope-close re-read (D1576).
export function noteNullHole(ty: i32, at: i32) {
  nhPendIxs.push(at)
  nhPendTys.push(ty)
  nhPendDepths.push(T.scopes.length - 1)
  0
}

// Is the binding at LetDecl node `letIx` an A-infer-null hole nothing ever filled — a
// `let x = null` / `const x = null` whose only value is `null`? Its type is the `null` type,
// and the emitter reps it `nullref`. Answered only after the declaring scope has closed,
// which is where `flushUninferred` banks it (D1576).
export function letNullHoleUnfilled(letIx: i32): boolean {
  if letIx < 0 { return false }
  let i = 0
  while i < nhUnfilledIxs.length {
    if nhUnfilledIxs[i] == letIx { return true }
    i = i + 1
  }
  false
}

// The `T | null` a write filled the A-infer-null hole of LetDecl `letIx` with, or -1 for a
// binding that is not such a hole or that nothing filled. Answered after the scope closed.
export function letNullHoleFilledTy(letIx: i32): i32 {
  if letIx < 0 { return -1 }
  let i = 0
  while i < nhFilledIxs.length {
    if nhFilledIxs[i] == letIx { return nhFilledTys[i] }
    i = i + 1
  }
  -1
}

// D1576 — every pin gets its chance, then the hole is answered. At the close of the scope that
// declared it, an A-infer-null hole with `nInner` still `-1` is one no assignment ever filled,
// so the binding's only value is `null` and its type is the `null` type. Banked rather than
// reported: this is an inference that succeeded, and the emitter lowers it as `nullref`.
export function flushNullHoles(depth: i32) {
  const keepI: i32[] = []
  const keepT: i32[] = []
  const keepD: i32[] = []
  let i = 0
  while i < nhPendIxs.length {
    if nhPendDepths[i] == depth {
      const ty = nhPendTys[i]
      if ty >= 0 && ty < T.tys.length {
        const t = T.tys[ty]
        if t is TyNullable {
          if t.nInner < 0 {
            nhUnfilledIxs.push(nhPendIxs[i])
          } else {
            nhFilledIxs.push(nhPendIxs[i])
            nhFilledTys.push(ty)
            noteFilledJoinLet(nhPendIxs[i])
          }
        }
      }
    } else {
      keepI.push(nhPendIxs[i])
      keepT.push(nhPendTys[i])
      keepD.push(nhPendDepths[i])
    }
    i = i + 1
  }
  nhPendIxs = keepI
  nhPendTys = keepT
  nhPendDepths = keepD
  0
}

// Whether `ix`, or the first-arm tail an `if` or `match` at `ix` reads through, is a value
// construct whose first arm always exits (`noteExitFirst`).
export function exitFirstOnSpine(ix: i32, depth: i32): boolean {
  if ix < 0 || ix >= P.nodes.length || depth > 64 { return false }
  if i32ListAt(exitFirstAt, ix) == 1 { return true }
  const n = P.nodes[ix]
  let arm = -1
  if n is IfStmt { arm = n.ifThen }
  if n is MatchExpr {
    if n.matchBodies.length > 0 { arm = n.matchBodies[0] }
  }
  if n is Paren { return exitFirstOnSpine(n.parInner, depth + 1) }
  if arm < 0 { return false }
  const b = P.nodes[arm]
  if b is Block {
    if b.blkStmts.length == 0 { return false }
    return exitFirstOnSpine(b.blkStmts[b.blkStmts.length - 1], depth + 1)
  }
  exitFirstOnSpine(arm, depth + 1)
}

// By loop node: the type of a loop or labelled block that carries a value, and whether that
// value is used rather than discarded. Written by each check of the node.
export let lpValTy: i32[] = []
export let lpValUsed: i32[] = []
// By labelled block: the tail statement whose value it ends with, where it has one.
export let lpValTail: i32[] = []

// Writes `v` at node `ix` of a per-node column, growing it with -1 up to the index.
export function lpColSet(col: i32[], ix: i32, v: i32) {
  if ix < 0 { return 0 }
  while col.length <= ix { col.push(-1) }
  col[ix] = v
  0
}

// The value type of the loop or labelled block at `ix` where that value is used, or -1: the
// emitter lowers these through a result binding and every other loop as a statement.
export function loopValTyOf(ix: i32): i32 {
  if i32ListAt(lpValUsed, ix) != 1 { return -1 }
  i32ListAt(lpValTy, ix)
}

// The arm blocks of value `if`s that always exit, each once: the join left them out, and the
// emitter ends each with a `never` value so the arm meets the join's blocktype (D3222).
export let exitArmBlocks: i32[] = []
export let exitArmSeen: i32[] = []

export function noteExitArm(blk: i32) {
  if inferQuiet || i32ListAt(exitArmSeen, blk) == 1 { return 0 }
  lpColSet(exitArmSeen, blk, 1)
  exitArmBlocks.push(blk)
  0
}

// The value `if`s and `match`es whose FIRST arm always exits, and the un-annotated bindings they
// initialize. The emitter's classifiers read a construct's first arm, so each such binding takes
// its checked type as an annotation, the spelling the other arm order already reads (D3222).
export let exitFirstAt: i32[] = []
export let exitFirstLets: i32[] = []
export let exitFirstLetSeen: i32[] = []

export function noteExitFirst(ix: i32) {
  if inferQuiet { return 0 }
  lpColSet(exitFirstAt, ix, 1)
  0
}

// A binding initialized by a `null`-typed construct rather than a bare `null`, whose hole a later
// write filled: the emitter reads the construct's arms, which say only `null`, so it takes the
// filled type as an annotation too (D3355).
function noteFilledJoinLet(ix: i32) {
  const d = P.nodes[ix]
  if d is LetDecl {
    if (
      d.letType >= 0
      || d.letInit < 0
      || P.nodes[cwPeel(d.letInit)] is NullLit
    ) {
      return 0
    }
    if i32ListAt(exitFirstLetSeen, ix) != 1 {
      lpColSet(exitFirstLetSeen, ix, 1)
      exitFirstLets.push(ix)
    }
  }
  0
}

// How many bindings `exitFirstLets` holds, and the `i`th.
export function exitFirstLetCount(): i32 { exitFirstLets.length }
export function exitFirstLetAt(i: i32): i32 {
  if i < 0 || i >= exitFirstLets.length { return -1 }
  exitFirstLets[i]
}

// How many arm blocks `noteExitArm` recorded, and the `i`th.
export function exitArmCount(): i32 { exitArmBlocks.length }
export function exitArmBlockAt(i: i32): i32 {
  if i < 0 || i >= exitArmBlocks.length { return -1 }
  exitArmBlocks[i]
}

// The tail statement a labelled block at `ix` ends with as its value, or -1.
export function loopValTailOf(ix: i32): i32 { i32ListAt(lpValTail, ix) }

// Clears this module's tables (called from `initChecker`).
export function nullHolesReset() {
  lpValTy = []
  lpValUsed = []
  lpValTail = []
  exitArmBlocks = []
  exitArmSeen = []
  exitFirstAt = []
  exitFirstLets = []
  exitFirstLetSeen = []
  nhPendIxs = []
  nhPendTys = []
  nhPendDepths = []
  nhUnfilledIxs = []
  nhFilledIxs = []
  nhFilledTys = []
}
