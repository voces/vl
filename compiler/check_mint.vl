// `check_mint.vl` — the calls an instance of a function makes through a set-typed value.
// The elaboration notes one fact per call an instance makes through a parameter it binds to a
// function set: the set, the call's parameter types and what each member returns there
// (D14430, `elabMintFacts`). Scopes are rows by instance key; facts are rows by scope and call
// node, and both are cleared before the elaboration notes them.
import { i32ToStr } from "./ast"

// The check's generation: a restart re-mints every type, so no row of an earlier one is read.
let mintGen = 0

// One row per instance: its declared function, the key spelling its bindings, those bindings,
// its generation.
let mintScopeFn: i32[] = []
let mintScopeKey: string[] = []
let mintScopeNames: string[][] = []
let mintScopeTys: i32[][] = []
let mintScopeGen: i32[] = []
let mintScopeOf: {[string]: i32} = Map()
// By scope row: its call nodes' fact rows.
let mintScopeFacts: Map<i32, i32>[] = []

// One row per fact: its scope row, call node, set id, the call's parameter types' spelling,
// whether the members' results differ, those results, and the row it replaced for the same
// scope and call (-1 for none).
let mintFactScope: i32[] = []
let mintFactCall: i32[] = []
let mintFactSet: i32[] = []
let mintFactKey: string[] = []
let mintFactSplit: boolean[] = []
let mintFactRs: i32[][] = []
let mintFactPrev: i32[] = []

// Forgets every row; once per check, and again on each restart of it.
export function mintReset() {
  mintGen = mintGen + 1
  mintScopeFn = []
  mintScopeKey = []
  mintScopeNames = []
  mintScopeTys = []
  mintScopeGen = []
  mintScopeOf = Map()
  mintScopeFacts = []
  mintFactScope = []
  mintFactCall = []
  mintFactSet = []
  mintFactKey = []
  mintFactSplit = []
  mintFactRs = []
  mintFactPrev = []
  mintPartial = []
  mintParamSets = Map()
  mintParamFwds = Map()
  0
}

// Each function's parameter, keyed `decl|index`, → the parameters it is handed on to as
// `[decl, index, ...]`.
let mintParamFwds: {[string]: i32[]} = Map()

// Records that parameter `i` of `decl` is handed on to parameter `j` of `d2`.
export function mintParamFwdNote(decl: i32, i: i32, d2: i32, j: i32) {
  const key = i32ToStr(decl) + "|" + i32ToStr(i)
  const have = mintParamFwds[key] ?? []
  have.push(d2)
  have.push(j)
  mintParamFwds[key] = have
  0
}

// Each function's parameter, keyed `decl|index`, → the sets the calls through it go through in
// some instance.
let mintParamSets: {[string]: i32[]} = Map()

// Records that a call through parameter `i` of `decl` goes through set `s`.
export function mintParamSetNote(decl: i32, i: i32, s: i32) {
  const key = i32ToStr(decl) + "|" + i32ToStr(i)
  const have = mintParamSets[key] ?? []
  for x in have {
    if x == s { return 0 }
  }
  have.push(s)
  mintParamSets[key] = have
  0
}

// The sets some instance calls through a parameter that another instance of its function binds
// to no set or to another set.
let mintPartial: i32[] = []

export function mintSetPartialNote(s: i32) {
  if s >= 0 && !mintSetPartial(s) { mintPartial.push(s) }
  0
}

export function mintSetPartial(s: i32): boolean {
  for x in mintPartial {
    if x == s { return true }
  }
  false
}

// Whether some instance's calls through parameter `i` of `decl` go through set `s`, directly or
// through a parameter it is handed on to.
export function mintParamTakes(decl: i32, i: i32, s: i32): boolean {
  mintParamTakesGo(decl, i, s, 0)
}

function mintParamTakesGo(decl: i32, i: i32, s: i32, depth: i32): boolean {
  if depth > 8 { return false }
  const key = i32ToStr(decl) + "|" + i32ToStr(i)
  for x in mintParamSets[key] ?? [] {
    if x == s { return true }
  }
  const fw = mintParamFwds[key] ?? []
  let k = 0
  while k + 1 < fw.length {
    if mintParamTakesGo(fw[k], fw[k + 1], s, depth + 1) { return true }
    k = k + 2
  }
  false
}

// The scope row of the instance of function `fn` binding `names` to `tys`, spelled `key`, made
// on first ask.
export function mintScopeAt(
  fn: i32,
  key: string,
  names: string[],
  tys: i32[],
): i32 {
  const sk = key + "@" + i32ToStr(fn)
  const had = mintScopeOf[sk] ?? -1
  if had >= 0 && had < mintScopeGen.length && mintScopeGen[had] == mintGen {
    return had
  }
  const r = mintScopeFn.length
  mintScopeFn.push(fn)
  mintScopeKey.push(key)
  mintScopeNames.push(names.slice(0, names.length))
  mintScopeTys.push(tys.slice(0, tys.length))
  mintScopeGen.push(mintGen)
  mintScopeOf[sk] = r
  mintScopeFacts.push(Map())
  r
}

// Records that call `call`, typed in scope row `scope`, goes through set `s` at parameter types
// spelled `key`, its members returning `rs` there (`split` when they differ). A later note of
// the same scope and call replaces it.
export function mintFactNote(
  scope: i32,
  call: i32,
  s: i32,
  key: string,
  split: boolean,
  rs: i32[],
) {
  if scope < 0 || scope >= mintScopeFacts.length { return 0 }
  const at = mintScopeFacts[scope]
  mintFactPrev.push(at[call] ?? -1)
  at[call] = mintFactScope.length
  mintFactScope.push(scope)
  mintFactCall.push(call)
  mintFactSet.push(s)
  mintFactKey.push(key)
  mintFactSplit.push(split)
  mintFactRs.push(rs)
  0
}

// How many fact rows stand; a probe's mark.
export function mintFactCount(): i32 { mintFactScope.length }

// Drops every fact row from `n` on, putting back the row each one replaced.
export function mintFactsTruncate(n: i32) {
  while mintFactScope.length > n {
    const r = mintFactScope.length - 1
    const sc = mintFactScope[r]
    if sc >= 0 && sc < mintScopeFacts.length {
      mintScopeFacts[sc][mintFactCall[r]] = mintFactPrev[r]
    }
    mintFactScope.pop()
    mintFactCall.pop()
    mintFactSet.pop()
    mintFactKey.pop()
    mintFactSplit.pop()
    mintFactRs.pop()
    mintFactPrev.pop()
  }
  0
}

// The fact rows that stand: each scope and call's latest note, in the order noted.
export function mintFactRows(): i32[] {
  const out: i32[] = []
  let r = 0
  while r < mintFactScope.length {
    const sc = mintFactScope[r]
    if (
      sc >= 0
      && sc < mintScopeFacts.length
      && (mintScopeFacts[sc][mintFactCall[r]] ?? -1) == r
    ) {
      out.push(r)
    }
    r = r + 1
  }
  out
}

// Fact row `r`'s call node, set id and whether its members' results differ.
export function mintFactCallOf(r: i32): i32 {
  if r < 0 || r >= mintFactCall.length { return -1 }
  mintFactCall[r]
}
export function mintFactSetOf(r: i32): i32 {
  if r < 0 || r >= mintFactSet.length { return -1 }
  mintFactSet[r]
}
export function mintFactSplits(r: i32): boolean {
  r >= 0 && r < mintFactSplit.length && mintFactSplit[r]
}

// What each member of fact row `r`'s set returns at its call, in set order.
export function mintFactRsOf(r: i32): i32[] {
  const none: i32[] = []
  if r < 0 || r >= mintFactRs.length { return none }
  mintFactRs[r]
}

// The one set every standing fact for call `call` goes through, or -1 when none does or two
// differ.
export function mintCallSoleSet(call: i32): i32 {
  let s = -1
  for r in mintFactRows() {
    if mintFactCall[r] == call {
      if s >= 0 && mintFactSet[r] != s { return -1 }
      s = mintFactSet[r]
    }
  }
  s
}

// The fact row standing for call `call` in the scope of fact row `r`, or -1.
export function mintFactInScope(r: i32, call: i32): i32 {
  if r < 0 || r >= mintFactScope.length { return -1 }
  const sc = mintFactScope[r]
  if sc < 0 || sc >= mintScopeFacts.length { return -1 }
  mintScopeFacts[sc][call] ?? -1
}

// The scope rows some standing fact row is in, each once, in the order first noted.
export function mintScopeRows(): i32[] {
  const out: i32[] = []
  const seen: boolean[] = []
  while seen.length < mintScopeFn.length { seen.push(false) }
  for r in mintFactRows() {
    const sc = mintFactScope[r]
    if sc >= 0 && sc < seen.length && !seen[sc] {
      seen[sc] = true
      out.push(sc)
    }
  }
  out
}

// Scope row `sc`'s declared function, and the names and types its bindings pair.
export function mintScopeFnOf(sc: i32): i32 {
  if sc < 0 || sc >= mintScopeFn.length { return -1 }
  mintScopeFn[sc]
}
export function mintScopeNamesOf(sc: i32): string[] {
  const none: string[] = []
  if sc < 0 || sc >= mintScopeNames.length { return none }
  mintScopeNames[sc]
}
export function mintScopeTysOf(sc: i32): i32[] {
  const none: i32[] = []
  if sc < 0 || sc >= mintScopeTys.length { return none }
  mintScopeTys[sc]
}
