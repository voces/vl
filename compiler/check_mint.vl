// `check_mint.vl` — the calls an instance of a function makes through a set-typed value.
// The elaboration notes one fact per call an instance makes through a parameter it binds to a
// function set: the set, the call's parameter types and what each member returns there
// (D14430, `elabMintFacts`). Scopes are rows by instance key; facts are rows by scope and call
// node, and both are cleared before the elaboration notes them.
import { i32ToStr } from "./ast"
import { i32ListHas } from "./listutil"

// The check's generation: a restart re-mints every type, so no row of an earlier one is read.
let mintGen = 0

// One row per instance: its declared function, the key spelling its bindings, those bindings,
// its generation.
let mintScopeFn: i32[] = []
let mintScopeKey: string[] = []
let mintScopeNames: string[][] = []
let mintScopeTys: i32[][] = []
let mintScopeGen: i32[] = []
let mintScopeOf: {[string]: i32} = Map()
// By scope row: its call nodes' fact rows.
let mintScopeFacts: Map<i32, i32>[] = []

// One row per fact: its scope row, call node, set id, the call's parameter types' spelling,
// whether the members' results differ, those results, and the row it replaced for the same
// scope and call (-1 for none).
let mintFactScope: i32[] = []
let mintFactCall: i32[] = []
let mintFactSet: i32[] = []
let mintFactKey: string[] = []
let mintFactSplit: boolean[] = []
let mintFactRs: i32[][] = []
let mintFactPrev: i32[] = []

// Forgets every row; once per check, and again on each restart of it.
// The nested declarations the elaboration built once per instance of their encloser, so a read
// in their body is that instance's (nested-per-encloser-2026-11.md).
let mintNestedPerEncl: {[i32]: boolean} = Map()

// Records that nested declaration `d` is built per encloser instance.
export function mintNestedPerEnclNote(d: i32) {
  mintNestedPerEncl[d] = true
  0
}

// Whether nested declaration `d` is built per encloser instance.
export function mintNestedPerEnclOf(d: i32): boolean {
  mintNestedPerEncl[d] ?? false
}

export function mintReset() {
  mintGen = mintGen + 1
  mintNestedPerEncl = Map()
  mintScopeFn = []
  mintScopeKey = []
  mintScopeNames = []
  mintScopeTys = []
  mintScopeGen = []
  mintScopeOf = Map()
  mintScopeFacts = []
  mintFactScope = []
  mintCloAt = []
  mintParamHeld = Map()
  mintCloTy = []
  mintCloSet = []
  mintFactCall = []
  mintFactSet = []
  mintFactKey = []
  mintFactSplit = []
  mintFactRs = []
  mintFactPrev = []
  mintPartial = []
  mintParamSets = Map()
  mintSeedDecl = []
  mintSeedPar = []
  mintSeedHeld = []
  mintSeedWide = []
  mintSeedBind = []
  mintParamFwds = Map()
  mintRetParams = Map()
  mintAliases = []
  0
}

// Each declared function → the positions of the parameters it hands back: every value it returns
// is a read of that parameter, at an instance binding the parameter to a function.
let mintRetParams: {[i32]: i32[]} = Map()

// Records that declared function `fn` hands back its parameter `i`; 1 when the fact is new.
export function mintRetNote(fn: i32, i: i32): i32 {
  const at = mintRetParams[fn] ?? []
  for j in at {
    if j == i { return 0 }
  }
  at.push(i)
  mintRetParams[fn] = at
  1
}

// The parameter positions declared function `fn` hands back, as `mintRetNote` noted them.
export function mintRetParamsOf(fn: i32): i32[] { mintRetParams[fn] ?? [] }

// Each function's parameter, keyed `decl|index`, → the parameters it is handed on to as
// `[decl, index, ...]`.
let mintParamFwds: {[string]: i32[]} = Map()

// Records that parameter `i` of `decl` is handed on to parameter `j` of `d2`.
export function mintParamFwdNote(decl: i32, i: i32, d2: i32, j: i32) {
  const key = i32ToStr(decl) + "|" + i32ToStr(i)
  const have = mintParamFwds[key] ?? []
  have.push(d2)
  have.push(j)
  mintParamFwds[key] = have
  0
}

// Each function's parameter, keyed `decl|index`, → the sets the calls through it go through in
// some instance.
let mintParamSets: {[string]: i32[]} = Map()

// Records that a call through parameter `i` of `decl` goes through set `s`.
export function mintParamSetNote(decl: i32, i: i32, s: i32) {
  const key = i32ToStr(decl) + "|" + i32ToStr(i)
  const have = mintParamSets[key] ?? []
  for x in have {
    if x == s { return 0 }
  }
  have.push(s)
  mintParamSets[key] = have
  0
}

// The sets the calls through parameter `i` of `decl` go through, as `mintParamSetNote` noted them.
export function mintParamSetsOf(decl: i32, i: i32): i32[] {
  mintParamSets[i32ToStr(decl) + "|" + i32ToStr(i)] ?? []
}

// One row per instance where parameter `mintSeedPar` of `mintSeedDecl`, holding set
// `mintSeedHeld`, initialises written binding `mintSeedBind`, which holds set `mintSeedWide` there.
let mintSeedDecl: i32[] = []
let mintSeedPar: i32[] = []
let mintSeedHeld: i32[] = []
let mintSeedWide: i32[] = []
let mintSeedBind: i32[] = []

// Records that parameter `i` of `decl`, holding set `s`, initialises written binding `d`, which
// holds set `w` in the same instance.
export function mintSeedNote(decl: i32, i: i32, s: i32, d: i32, w: i32) {
  let r = 0
  while r < mintSeedDecl.length {
    if (
      mintSeedDecl[r] == decl
      && mintSeedPar[r] == i
      && mintSeedHeld[r] == s
      && mintSeedBind[r] == d
      && mintSeedWide[r] == w
    ) {
      return 0
    }
    r = r + 1
  }
  mintSeedDecl.push(decl)
  mintSeedPar.push(i)
  mintSeedHeld.push(s)
  mintSeedBind.push(d)
  mintSeedWide.push(w)
  0
}

// The sets of the bindings parameter `i` of `decl` initialises while it holds set `s`.
export function mintSeedWideOfParam(decl: i32, i: i32, s: i32): i32[] {
  const out: i32[] = []
  let r = 0
  while r < mintSeedDecl.length {
    if (
      mintSeedDecl[r] == decl
      && mintSeedPar[r] == i
      && mintSeedHeld[r] == s
      && !i32ListHas(out, mintSeedWide[r])
    ) {
      out.push(mintSeedWide[r])
    }
    r = r + 1
  }
  out
}

// The sets parameter-initialised written binding `d` holds.
export function mintSeedWideOfBind(d: i32): i32[] {
  const out: i32[] = []
  let r = 0
  while r < mintSeedBind.length {
    if mintSeedBind[r] == d && !i32ListHas(out, mintSeedWide[r]) {
      out.push(mintSeedWide[r])
    }
    r = r + 1
  }
  out
}

// The parameter-initialised written bindings that hold set `w`.
export function mintSeedBindsOf(w: i32): i32[] {
  const out: i32[] = []
  let r = 0
  while r < mintSeedWide.length {
    if mintSeedWide[r] == w && !i32ListHas(out, mintSeedBind[r]) {
      out.push(mintSeedBind[r])
    }
    r = r + 1
  }
  out
}

// The sets the parameters initialising a binding of set `w` hold there.
export function mintSeedHeldOf(w: i32): i32[] {
  const out: i32[] = []
  let r = 0
  while r < mintSeedWide.length {
    if mintSeedWide[r] == w && !i32ListHas(out, mintSeedHeld[r]) {
      out.push(mintSeedHeld[r])
    }
    r = r + 1
  }
  out
}

// The written bindings the elaboration reads as the parameter they hold.
let mintAliases: i32[] = []

// Records that the elaboration reads written binding `d` as the parameter it holds.
export function mintAliasNote(d: i32) {
  for x in mintAliases {
    if x == d { return 0 }
  }
  mintAliases.push(d)
  0
}

// Whether `mintAliasNote` recorded binding `d`.
export function mintAliasHas(d: i32): boolean {
  for x in mintAliases {
    if x == d { return true }
  }
  false
}

// The sets some instance calls through a parameter that another instance of its function binds
// to no set or to another set.
let mintPartial: i32[] = []

// Parameter reads an instance hands to a named function's parameter of a closed function type
// while binding them to a set of one named function: the read, that type and the set. A read two
// instances bind to different sets has set -2.
let mintCloAt: i32[] = []
let mintCloTy: i32[] = []
let mintCloSet: i32[] = []

// Notes that read `ix` is delivered to closed function type `ty` as set `s`'s one member; false
// once an instance delivered it as another set or at another type.
export function mintCloDeliveryNote(ix: i32, ty: i32, s: i32): boolean {
  let i = 0
  while i < mintCloAt.length {
    if mintCloAt[i] == ix {
      if mintCloSet[i] != s || mintCloTy[i] != ty { mintCloSet[i] = -2 }
      return mintCloSet[i] >= 0
    }
    i = i + 1
  }
  mintCloAt.push(ix)
  mintCloTy.push(ty)
  mintCloSet.push(s)
  true
}

// Each hole parameter, by its declaration node, → the one set every instance binds it to; -2 where
// two instances bind it to different sets, or one to no set.
let mintParamHeld: {[i32]: i32} = Map()

// Records that an instance binds parameter `par` to set `s` (-1 for none).
export function mintParamHeldNote(par: i32, s: i32) {
  const had = mintParamHeld.get(par) ?? -3
  mintParamHeld[par] = if had == -3 && s >= 0 || had == s { s } else { -2 }
  0
}

// The sets some parameter's every instance binds it to, each once.
export function mintParamHeldSets(): i32[] {
  const out: i32[] = []
  for v in mintParamHeld.values() {
    if v >= 0 && !i32ListHas(out, v) { out.push(v) }
  }
  out
}

// The one set every instance binds parameter `par` to, or -1.
export function mintParamHeldOf(par: i32): i32 {
  const s = mintParamHeld.get(par) ?? -1
  if s >= 0 { s } else { -1 }
}

// The rows `mintCloDeliveryNote` holds, by index: the read, its type and its set (-2 apart).
export function mintCloRows(): i32 { mintCloAt.length }
export function mintCloAtOf(r: i32): i32 { mintCloAt[r] }
export function mintCloTyOf(r: i32): i32 { mintCloTy[r] }
export function mintCloSetOf(r: i32): i32 { mintCloSet[r] }

export function mintSetPartialNote(s: i32) {
  if s >= 0 && !mintSetPartial(s) { mintPartial.push(s) }
  0
}

export function mintSetPartial(s: i32): boolean {
  for x in mintPartial {
    if x == s { return true }
  }
  false
}

// Whether some instance's calls through parameter `i` of `decl` go through set `s`, directly or
// through a parameter it is handed on to.
export function mintParamTakes(decl: i32, i: i32, s: i32): boolean {
  mintParamTakesGo(decl, i, s, 0)
}

function mintParamTakesGo(decl: i32, i: i32, s: i32, depth: i32): boolean {
  if depth > 8 { return false }
  const key = i32ToStr(decl) + "|" + i32ToStr(i)
  for x in mintParamSets[key] ?? [] {
    if x == s { return true }
  }
  const fw = mintParamFwds[key] ?? []
  let k = 0
  while k + 1 < fw.length {
    if mintParamTakesGo(fw[k], fw[k + 1], s, depth + 1) { return true }
    k = k + 2
  }
  false
}

// The scope row of the instance of function `fn` binding `names` to `tys`, spelled `key`, made
// on first ask.
export function mintScopeAt(
  fn: i32,
  key: string,
  names: string[],
  tys: i32[],
): i32 {
  const sk = key + "@" + i32ToStr(fn)
  const had = mintScopeOf[sk] ?? -1
  if had >= 0 && had < mintScopeGen.length && mintScopeGen[had] == mintGen {
    return had
  }
  const r = mintScopeFn.length
  mintScopeFn.push(fn)
  mintScopeKey.push(key)
  mintScopeNames.push(names.slice(0, names.length))
  mintScopeTys.push(tys.slice(0, tys.length))
  mintScopeGen.push(mintGen)
  mintScopeOf[sk] = r
  mintScopeFacts.push(Map())
  r
}

// Records that call `call`, typed in scope row `scope`, goes through set `s` at parameter types
// spelled `key`, its members returning `rs` there (`split` when they differ). A later note of
// the same scope and call replaces it.
export function mintFactNote(
  scope: i32,
  call: i32,
  s: i32,
  key: string,
  split: boolean,
  rs: i32[],
) {
  if scope < 0 || scope >= mintScopeFacts.length { return 0 }
  const at = mintScopeFacts[scope]
  mintFactPrev.push(at[call] ?? -1)
  at[call] = mintFactScope.length
  mintFactScope.push(scope)
  mintFactCall.push(call)
  mintFactSet.push(s)
  mintFactKey.push(key)
  mintFactSplit.push(split)
  mintFactRs.push(rs)
  0
}

// How many fact rows stand; a probe's mark.
export function mintFactCount(): i32 { mintFactScope.length }

// Drops every fact row from `n` on, putting back the row each one replaced.
export function mintFactsTruncate(n: i32) {
  while mintFactScope.length > n {
    const r = mintFactScope.length - 1
    const sc = mintFactScope[r]
    if sc >= 0 && sc < mintScopeFacts.length {
      mintScopeFacts[sc][mintFactCall[r]] = mintFactPrev[r]
    }
    mintFactScope.pop()
    mintFactCall.pop()
    mintFactSet.pop()
    mintFactKey.pop()
    mintFactSplit.pop()
    mintFactRs.pop()
    mintFactPrev.pop()
  }
  0
}

// The fact rows that stand: each scope and call's latest note, in the order noted.
export function mintFactRows(): i32[] {
  const out: i32[] = []
  let r = 0
  while r < mintFactScope.length {
    const sc = mintFactScope[r]
    if (
      sc >= 0
      && sc < mintScopeFacts.length
      && (mintScopeFacts[sc][mintFactCall[r]] ?? -1) == r
    ) {
      out.push(r)
    }
    r = r + 1
  }
  out
}

// The declared function of fact row `r`'s instance, or -1.
export function mintFactFnOf(r: i32): i32 {
  if r < 0 || r >= mintFactScope.length { return -1 }
  mintScopeFnOf(mintFactScope[r])
}

// Fact row `r`'s call node, set id and whether its members' results differ.
export function mintFactCallOf(r: i32): i32 {
  if r < 0 || r >= mintFactCall.length { return -1 }
  mintFactCall[r]
}
export function mintFactSetOf(r: i32): i32 {
  if r < 0 || r >= mintFactSet.length { return -1 }
  mintFactSet[r]
}
export function mintFactSplits(r: i32): boolean {
  r >= 0 && r < mintFactSplit.length && mintFactSplit[r]
}

// What each member of fact row `r`'s set returns at its call, in set order.
export function mintFactRsOf(r: i32): i32[] {
  const none: i32[] = []
  if r < 0 || r >= mintFactRs.length { return none }
  mintFactRs[r]
}

// The one set every standing fact for call `call` goes through, or -1 when none does or two
// differ.
export function mintCallSoleSet(call: i32): i32 {
  let s = -1
  for r in mintFactRows() {
    if mintFactCall[r] == call {
      if s >= 0 && mintFactSet[r] != s { return -1 }
      s = mintFactSet[r]
    }
  }
  s
}

// The fact row standing for call `call` in the scope of fact row `r`, or -1.
export function mintFactInScope(r: i32, call: i32): i32 {
  if r < 0 || r >= mintFactScope.length { return -1 }
  const sc = mintFactScope[r]
  if sc < 0 || sc >= mintScopeFacts.length { return -1 }
  mintScopeFacts[sc][call] ?? -1
}

// The scope rows some standing fact row is in, each once, in the order first noted.
export function mintScopeRows(): i32[] {
  const out: i32[] = []
  const seen: boolean[] = []
  while seen.length < mintScopeFn.length { seen.push(false) }
  for r in mintFactRows() {
    const sc = mintFactScope[r]
    if sc >= 0 && sc < seen.length && !seen[sc] {
      seen[sc] = true
      out.push(sc)
    }
  }
  out
}

// Scope row `sc`'s declared function, and the names and types its bindings pair.
export function mintScopeFnOf(sc: i32): i32 {
  if sc < 0 || sc >= mintScopeFn.length { return -1 }
  mintScopeFn[sc]
}
export function mintScopeNamesOf(sc: i32): string[] {
  const none: string[] = []
  if sc < 0 || sc >= mintScopeNames.length { return none }
  mintScopeNames[sc]
}
export function mintScopeTysOf(sc: i32): i32[] {
  const none: i32[] = []
  if sc < 0 || sc >= mintScopeTys.length { return none }
  mintScopeTys[sc]
}
