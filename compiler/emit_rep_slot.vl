// `emit_rep_slot.vl` — the table slot a value of a type is stored under, and the `$fnsig`
// token that a parameter or a result of that type keys. The kind is `repOfTy`'s answer and
// the slot is `repSlotOfKind`'s, so a signature token has no producer of its own.

import { recNarrowRecordOf } from "./check_bind_adopt"
import { canonUnionMemberTysOf } from "./check_program"
import { mapKeyKindOfTy } from "./check_ty_rep"
import { setShapeOfTy } from "./emit_base"
import {
  T,
  TyLit,
  TyMap,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  mkNullableTy,
  softenLitTy,
  structNameOfTy,
  tyAt,
  tySame,
} from "./check_types"
import {
  sScanLim,
  structIndexOfTy,
  structRowRecordingTy,
} from "./emit_atom_kinds"
import { tyRefArrElemOf } from "./emit_map_value_slots"
import { mvSlotOfValTyK } from "./emit_mv_slots"
import {
  repRowOfTyStruct,
  repSigKindOfTy,
  repSigSlotTokOfKind,
  repSigTokHasSlot,
  repSigTokOfKind,
  repVariantShapeRowOf,
} from "./emit_rep"
import {
  asrGen,
  asrRow,
  mvSlotOfMapKeyKTys,
  repVariantSlotRep,
  rlRowTyOfElem,
  rlSlotOfRowTy,
  rlSlotOfTyOrTwin,
  tyRegGenNow,
  wholeShapeRowOf,
} from "./emit_shape_rows"
import { rlSlotOfUnionMembers } from "./emit_struct_order"
import { VKind } from "./emit_state"
import { intLitUnionBasesOf, tyPeelNul } from "./tyquery"

// The table slot a value of type `ty` with rep kind `kind` is stored under: a struct row, a
// folded variant row, a ref-list row (else its element's row type's) or a map shape. A
// nullable kind reads its inner type's.
// A map shape may be negative (a mono shape), so test the answer with `repSlotIsRow`.
export function repSlotOfKind(kind: VKind | null, ty: i32): i32 {
  const none = if kind == "map" || kind == "nulmap" { -3 } else { -1 }
  if ty < 0 || ty >= T.tys.length || !repSigTokHasSlot(kind) { return none }
  const inner = tyPeelNul(ty)
  if inner < 0 { return none }
  if kind == "struct" || kind == "nulstruct" { return repStructRowOfTy(inner) }
  if kind == "variant" || kind == "nulvariant" {
    return repVariantSlotRep(repVariantShapeRowOf(inner))
  }
  if kind == "reflist" || kind == "nulreflist" {
    const e = tyRefArrElemOf(inner)
    const s = rlSlotOfTyOrTwin(e)
    if s >= 0 { return s }
    const r = rlSlotOfRowTy(rlRowTyOfElem(e))
    if r >= 0 { return r }
    return rlSlotOfCanonElem(e)
  }
  repMapSlotOfTy(inner)
}

// The ref-list slot of element `e` keyed at its canonical spelling: integer literals of two
// widths at their bases' union, a literal or one-base literal union at its base, a union at its
// canonical members (one of them alone, a lone one beside `null` its nullable).
// -1 when no row holds that spelling.
function rlSlotOfCanonElem(e: i32): i32 {
  const bases = intLitUnionBasesOf(e)
  if bases.length > 0 { return rlSlotOfUnionMembers(bases) }
  const c = rlCanonElemTy(e)
  if c >= 0 && c != e { return rlSlotOfTyOrTwin(c) }
  if c != -2 { return -1 }
  const tys: i32[] = []
  if !canonUnionMemberTysOf(e, tys) { return -1 }
  rlSlotOfUnionMembers(tys)
}

// Element `e` at its canonical type, `e` itself when canon spells it so, or -2 for a union of
// two or more non-null canonical members, which has no single type to stand for it.
function rlCanonElemTy(e: i32): i32 {
  if e < 0 || e >= T.tys.length { return e }
  const t = tyAt(e)
  if t is TyLit { return softenLitTy(e) }
  if t is TyUnion {
    const sl = softenLitTy(e)
    if sl != e { return sl }
  }
  if t is TyNullable {
    const i = rlCanonElemTy(t.nInner)
    if i < 0 || i == t.nInner { return e }
    return mkNullableTy(i)
  }
  if !(t is TyUnion) { return e }
  const tys: i32[] = []
  if !canonUnionMemberTysOf(e, tys) { return e }
  let one = -1
  let n = 0
  let nul = false
  for m in tys {
    if m < 0 {
      nul = true
    } else {
      one = m
      n = n + 1
    }
  }
  if n != 1 {
    if nul { return e }
    return -2
  }
  if nul { return mkNullableTy(one) }
  one
}

// The map shape a map type `ty` is stored under: a Set's flavour by its key, else the slot its
// value's declared name keys, else the mv slot its value type holds; -3 when `ty`
// is not a map or its value has no slot.
function repMapSlotOfTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -3 }
  const t = tyAt(ty)
  if t is TyMap {
    const set = setShapeOfTy(ty)
    if set != 0 { return set }
    const ki = mapKeyKindOfTy(t.mKey)
    const named = mvSlotOfMapKeyKTys(ki, t.mVal, t.mVal)
    if named != -3 { return named }
    const direct = mvSlotOfValTyK(t.mVal, ki)
    if direct >= 0 { return direct }
    return -3
  }
  -3
}

// Whether `repSlotOfKind`'s answer `slot` for `kind` names a row rather than none.
export function repSlotIsRow(kind: VKind | null, slot: i32): boolean {
  if kind == "map" || kind == "nulmap" { return slot != -3 }
  slot >= 0
}

// The `$fnsig` token of a parameter of type `ty`, or "" when its rep has none or no row holds it.
export function repSigTokOfTy(ty: i32): string {
  // A `u8` is a storage type: a value read from one crosses as the `i32` it widens to.
  if ty >= 0 && ty < T.tys.length {
    const pt = tyAt(ty)
    if pt is TyPrim && pt.primName == "u8" { return repSigTokOfKind("i32") }
  }
  const k = repSigKindOfTy(ty)
  if !repSigTokHasSlot(k) { return repSigTokOfKind(k) }
  const s = repSlotOfKind(k, repSigSlotTyOf(ty))
  if !repSlotIsRow(k, s) { return "" }
  repSigSlotTokOfKind(k, s)
}

// The type `ty`'s slot is read from: the member of a one-member union around a record, whose rep
// is that record's (an intersection folds to one), else `ty`.
function repSigSlotTyOf(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return ty }
  const u = tyAt(ty)
  if u is TyUnion && u.uMembers.length == 1 {
    const m = u.uMembers[0]
    if m >= 0 && m < T.tys.length && tyAt(m) is TyObj { return m }
  }
  ty
}

// The `$fnsig` token of a result of type `ty`: `>` and its parameter token, `>v` for `void`
// and for `never` (whose callee leaves nothing), or "" when its rep has none.
export function repSigRetTokOfTy(ty: i32): string {
  if ty >= 0 && ty < T.tys.length {
    const t = tyAt(ty)
    if t is TyPrim && (t.primName == "void" || t.primName == "never") {
      return ">v"
    }
  }
  const tok = repSigTokOfTy(ty)
  if tok == "" { return "" }
  ">" + tok
}

// The struct row a record `ty` is stored under: a row spelled by its shape, the row recording
// it, its declared name's row, then its rep row and, undeclared, the field-set scan; -1 for none.
function repStructRowOfTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const shp = repStructRowByShape(ty)
  if shp >= 0 { return shp }
  const own = structRowRecordingTy(ty)
  if own >= 0 { return own }
  if !(tyAt(ty) is TyObj) { return -1 }
  if structNameOfTy(ty) != "" {
    const dr = structIndexOfTy(ty)
    if dr >= 0 { return dr }
    return repRowOfTyStruct(ty, sScanLim())
  }
  const kr = repRowOfTyStruct(ty, sScanLim())
  if kr >= 0 { return kr }
  const al = structIndexOfTy(ty)
  if al >= 0 { return al }
  // A record narrower than one declared record is stored as it, as its literals are built.
  const nr = recNarrowRecordOf(ty)
  if nr >= 0 && !tySame(nr, ty) { repStructRowOfTy(nr) } else { -1 }
}

// The first struct row named by a record shape whose type is structurally `ty`, or -1, each
// answer stamped by the `tyRegGenNow` read before computing it.
function repStructRowByShape(ty: i32): i32 {
  if !(tyAt(ty) is TyObj) { return -1 }
  const slot = ty
  const gen = tyRegGenNow()
  if slot < asrGen.length && asrGen[slot] == gen { return asrRow[slot] }
  const r = wholeShapeRowOf(ty)
  if tyRegGenNow() == gen {
    while asrGen.length <= slot {
      asrGen.push(-1)
      asrRow.push(-1)
    }
    asrGen[slot] = gen
    asrRow[slot] = r
  }
  r
}
