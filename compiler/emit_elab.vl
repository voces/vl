// The instances: declaration, binding names and types, and the canonical key.
export let ekDecl: i32[] = []
export let ekNames: string[][] = []
export let ekTys: i32[][] = []
// Declaration → its instances, oldest first.
let ekByDecl: {[i32]: i32[]} = Map()
let ekIndex: {[string]: i32} = Map()
// Instance → the wider result a delivery builds it returning, where it has one.
let ekRetWide: {[i32]: i32} = Map()
// "parent^decl" → the instances of `decl` under that parent.
let ekKids: {[string]: i32[]} = Map()
// Node → [key, type, key, type, ...] over every elaborated instance.
export let elabNodeTys: {[i32]: i32[]} = Map()
// Literal → [key, type, ...]: the type each instance's elaboration stamped it to be built at.
let elabNodeReps: {[i32]: i32[]} = Map()
// Literal → [key, union, ...]: the union each instance's elaboration adopted it into an arm of.
let elabNodeRepUnions: {[i32]: i32[]} = Map()

// Node → (instance key, the destination type it is delivered at there) pairs.
let elabNodeCtxs: {[i32]: i32[]} = Map()

// Node → (instance key, union) pairs, from `elabCapBox`.
let elabNodeBoxs: {[i32]: i32[]} = Map()
// Narrowed read → [key, storage type, ...]: what each instance's re-check read it out of.
let elabNodeNarrowed: {[i32]: i32[]} = Map()
// The type the checker left on each node, taken before the emitter's passes rewrite any body; a
// node the emitter has since retyped, or minted, reads none.
let elabGenTy: i32[] = []

// The instances under which each node sits in the arm of a test the instance makes dead.
let elabDeadKs: {[i32]: i32[]} = Map()

// The cap past which an instance is not enqueued: polymorphic recursion grows without bound.
const ELAB_MAX_KEYS = 20000

function elabKeyOf(decl: i32, names: string[], tys: i32[]): string {
  // Sorted by name, so two calls binding the same names in another order share a key; a body
  // testing a type parameter spells each binding exactly, a set apart from its map (D2684).
  const exact = elabTestsTyVar(decl)
  let k = ""
  for o in elabNameOrder(names) {
    if o < tys.length {
      const v = if elabIsRowEntry(names[o]) { elabDeliveredRowClassFn(tys[o]) } else { elabBindStr(tys[o], exact) }
      k = k + names[o] + "=" + v + ";"
    }
  }
  i32ToStr(decl) + "|" + k
}

// The types call bind row `r` instances its call at: its rep row (`callBindRepTysAt`) where the
// checker keys the instance there (`callBindRepKeyedAt`); else its own.
function elabRowTys(r: i32): i32[] {
  if callBindRepKeyedAt(r) { callBindRepTysAt(r) } else { callBindTysAt(r) }
}

// The record-row class of a delivered record (`recordRowClassOf`), installed by the emitter before
// the elaboration runs, since the row module sits above this one in the import graph; a read before
// that traps.
function elabDeliveredRowClassUnset(_ty: i32): string { __trap__() }
export let elabDeliveredRowClassFn: (ty: i32) => string = elabDeliveredRowClassUnset

// Whether binding name `nm` is a delivered-row entry (`#r.<param>`), keyed by its record's row class.
function elabIsRowEntry(nm: string): boolean {
  nm.length > 3 && nm.slice(0, 3) == "#r."
}

// The record a call argument `i` of call `call` is delivered at: the record the checker rebuilds
// it at (`recRebuiltLeafRow`); -1 for none, for a binding (D15172's answer) and for a literal,
// whose built row is the record build's own fact.
function elabArgRowTy(call: i32, i: i32): i32 {
  const cn = if call >= 0 && call < P.nodes.length { nodeAt(call) } else { nodeAt(0) }
  if !(cn is Call) || i >= cn.callArgs.length { return -1 }
  const ax = parenPeelIx(cn.callArgs[i])
  if ax < 0 || !(nodeAt(ax) is Call) { return -1 }
  recRebuiltLeafRow(ax, REC_REBUILT_DEPTH)
}

// Appends to `names`/`tys` a delivered-row entry per un-annotated parameter of `decl` whose
// argument at call `call` is delivered as a record other than the hole's closed binding, beside
// that binding, which this leaves alone; an open binding is closed by the demand (D15173).
function elabRowEntries(call: i32, decl: i32, names: string[], tys: i32[]) {
  const f = if decl >= 0 && decl < P.nodes.length { nodeAt(decl) } else { nodeAt(0) }
  if !(f is FuncDecl) { return 0 }
  let i = 0
  while i < f.fnParams.length {
    const p = nodeAt(f.fnParams[i])
    if p is Param && p.parType < 0 {
      const rt = elabArgRowTy(call, i)
      const hb = bindOf(names, tys, "?" + f.fnName + "." + i32ToStr(i))
      if (
        rt >= 0
        && hb >= 0
        && elabTyClosed(hb, 0)
        && !tySame(hb, rt)
        && elabDeliveredRowClassFn(rt) != ""
      ) {
        names.push("#r." + i32ToStr(i))
        tys.push(rt)
      }
    }
    i = i + 1
  }
  0
}

// Per declaration: 1 when its body tests a value of a type parameter, directly or by handing one
// to a generic that does; 0 when not; 2 for a "no" that read a declaration still on the walk's
// stack, which stands for the rest of that walk and is settled at its root.
let elabExactMemo: {[i32]: i32} = Map()
let elabExactOnStack: {[i32]: boolean} = Map()
let elabExactDepth = 0
let elabExactPending: i32[] = []

// Whether generic `decl`'s body tests a value whose type names a type parameter (D2684). A root
// walk's "no" means nothing it reached tests one; its "yes" drops the provisional answers.
export function elabTestsTyVar(decl: i32): boolean {
  if decl < 0 || decl >= P.nodes.length { return false }
  const m = elabExactMemo.get(decl) ?? -1
  if m >= 0 { return m == 1 }
  if elabExactOnStack.get(decl) ?? false { return false }
  const fn = nodeAt(decl)
  if !(fn is FuncDecl) { return false }
  elabExactOnStack.set(decl, true)
  elabExactDepth = elabExactDepth + 1
  const r = elabTestsTyVarIn(fn.fnBody)
  elabExactDepth = elabExactDepth - 1
  elabExactOnStack.set(decl, false)
  if r || elabExactDepth == 0 {
    elabExactMemo.set(decl, if r { 1 } else { 0 })
  } else {
    elabExactMemo.set(decl, 2)
    elabExactPending.push(decl)
  }
  if elabExactDepth == 0 {
    for d in elabExactPending { elabExactMemo.set(d, if r { -1 } else { 0 }) }
    elabExactPending = []
  }
  r
}

// Whether node `ix`'s recorded type names a type parameter.
function elabTyVarTyped(ix: i32): boolean {
  const t = nodeTyIxOf(parenPeelIx(ix))
  t >= 0 && tyHasTyVar(t)
}

// `elabTestsTyVar`'s walk over one subtree, nested lambdas included.
function elabTestsTyVarIn(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is IsExpr && elabTyVarTyped(n.isObj) { return true }
  if n is AsExpr && elabTyVarTyped(n.asObj) { return true }
  if n is MatchExpr && elabTyVarTyped(n.matchScrut) { return true }
  if n is Call && n.callFn >= 0 {
    const cd = identDeclOf(n.callFn)
    if cd >= 0 && nodeAt(n.callFn) is Ident && monoIsGenericDecl(cd) {
      let passes = callTyArgsOf(ix).length > 0
      let a = 0
      while a < n.callArgs.length && !passes {
        passes = elabTyVarTyped(n.callArgs[a])
        a = a + 1
      }
      if passes && elabTestsTyVar(cd) { return true }
    }
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    for kid in nodeSpineChildren(cur) {
      if elabTestsTyVarIn(kid) { return true }
    }
    cur = elseIfLink(cur)
  }
  false
}

// One binding's spelling in a key; `canon` spells each union's members in sorted order.
function elabBindStr(t: i32, canon: boolean): string {
  // A function value stands for itself only while its type is not closed on its own, at any
  // depth: a list of one is keyed by the functions it holds.
  const fds = if tyHasTyVar(t) { elabFnSetOf(t) } else { elabFnNone }
  if fds.length > 0 {
    let fk = "Fn"
    for fd in fds { fk = fk + "#" + i32ToStr(fd) }
    return fk
  }
  let r = if canon { elabCanonStr(t, ELAB_CANON_DEPTH) } else { tyToStructStr(t) }
  if tyHasTyVar(t) {
    const ds: i32[] = []
    elabFnIdsIn(t, ds, 0)
    for d in ds { r = r + "#" + i32ToStr(d) }
  }
  r
}

const ELAB_CANON_DEPTH = 16

// Type `t` spelled structurally with every union's members sorted, so two orders of one union
// spell alike; past `depth` levels, its plain structural spelling.
function elabCanonStr(t: i32, depth: i32): string {
  if t < 0 || t >= T.tys.length || depth <= 0 { return tyToStructStr(t) }
  const ty = tyAt(t)
  match ty {
    TyUnion => {
      const ms: string[] = []
      for m in ty.uMembers {
        const s = elabCanonStr(m, depth - 1)
        let j = ms.length
        ms.push(s)
        while j > 0 && ms[j - 1] > s {
          ms[j] = ms[j - 1]
          j = j - 1
        }
        ms[j] = s
      }
      let r = "("
      let i = 0
      while i < ms.length {
        if i > 0 { r = r + "|" }
        r = r + ms[i]
        i = i + 1
      }
      r + ")"
    }
    TyArray => {
      const ro = if ty.aRead != 0 { "readonly " } else { "" }
      "(" + ro + elabCanonStr(ty.aElem, depth - 1) + ")[]"
    }
    TyNullable => "(" + elabCanonStr(ty.nInner, depth - 1) + ")?"
    TyMap => {
      const kind = if ty.mSet != 0 { "set" } else { "map" }
      kind
        + "{"
        + elabCanonStr(ty.mKey, depth - 1)
        + ":"
        + elabCanonStr(ty.mVal, depth - 1)
        + "}"
    }
    TyObj => {
      let r = "{"
      let i = 0
      while i < ty.objFieldNames.length && i < ty.objFieldTypes.length {
        r = r
          + ty.objFieldNames[i]
          + ":"
          + elabCanonStr(ty.objFieldTypes[i], depth - 1)
          + ","
        i = i + 1
      }
      r + "}"
    }
    TyFunc => {
      let r = "fn("
      for p in ty.fnParamTypes { r = r + elabCanonStr(p, depth - 1) + "," }
      r + ")=>" + elabCanonStr(ty.fnRet, depth - 1)
    }
    TyNeg => "!(" + elabCanonStr(ty.negTy, depth - 1) + ")"
    TyPrim | TyErr | TyVar | TyLit => tyToStructStr(t)
  }
}

// The instance enclosing instance `k`'s body, -1 at the root.
export let ekParent: i32[] = []

// Whether `d` has instances of its own: a type parameter, or a parameter typed by a type variable.
// A return that is open only through a nested function value does not count.
function declOpen(d: i32): boolean {
  const n = nodeAt(d)
  if !(n is FuncDecl) { return false }
  if n.fnTyParams.length > 0 { return true }
  for p in n.fnParams {
    const t = nodeTyIxOf(p)
    if t >= 0 && t < T.tys.length && tyHasTyVar(t) { return true }
  }
  false
}

// The parent key a call from instance `from` gives nested declaration `d`: the nearest enclosing
// declaration instanced on `from`'s chain, -1 when `d` reads none of the type variables open
// around it, -2 when an enclosing declaration whose type variables `d` reads is open and not on
// the chain (the open enclosing instance reaches it instead).
function elabParentFor(d: i32, from: i32): i32 {
  elabParentForAt(d, from, true)
}

// `elabParentFor`, where `lam` says whether an anonymous lambda takes its open encloser's instance
// as parent though it reads none of its type variables.
function elabParentForAt(d: i32, from: i32, lam: boolean): i32 {
  let e = elabEncl.get(d) ?? -1
  let anyOpen = false
  let guard = 0
  while e >= 0 && guard < 64 {
    let a = from
    let g2 = 0
    while a >= 0 && g2 < 64 {
      if ekDecl[a] == e {
        // A lambda declared in an instanced body is keyed under that instance, so each instance
        // holds its own (per-instance-identity-2026-11.md, M3 step 2).
        if (
          elabReadsChainOf(d, a)
          || anyOpen
          || (lam && elabLamPerEncl(d) && declOpen(e))
        ) {
          return a
        }
        return -1
      }
      a = ekParent[a]
      g2 = g2 + 1
    }
    if declOpen(e) && elabReadsOpenOf(d, e) { anyOpen = true }
    e = elabEncl.get(e) ?? -1
    guard = guard + 1
  }
  if anyOpen { return 0 - 2 }
  -1
}

// Whether `d` is an anonymous lambda with an un-annotated parameter, whose key takes its encloser
// instance as parent; a lambda with nothing to key is its template at every instance.
function elabLamPerEncl(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const n = nodeAt(d)
  // Lifting renames a lambda `__lambda_N` after the run, and mono asks for it under that name.
  if !(n is FuncDecl) { return false }
  if (
    n.fnName != ""
    && !(n.fnName.length >= 8 && n.fnName.slice(0, 8) == "__lambda")
  ) {
    return false
  }
  for p in n.fnParams {
    const pn = nodeAt(p)
    if pn is Param && pn.parType < 0 { return true }
  }
  false
}

// Whether nested declaration `d` reads the type variable `nm` an enclosing declaration binds:
// where `d` binds `nm` itself, only through a binding declared outside `d` whose type names it.
function elabReadsOuter(d: i32, nm: string): boolean {
  if !elabOwnName(d, nm) { return elabDeclReads(d, nm) }
  const key = i32ToStr(d) + "^" + nm
  const have = elabReadsMemo.get(key)
  if have != null { return have }
  const r = elabCapReads(d, d, nm)
  elabReadsMemo[key] = r
  r
}

// Whether a read in the subtree at `ix` names a binding declared outside `d` whose type names `nm`.
function elabCapReads(d: i32, ix: i32, nm: string): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  let cur = ix
  while cur >= 0 {
    const dc = identDeclOf(cur)
    if (
      dc >= 0
      && !nodeContains(d, dc)
      && tyMentionsTyVarNamed(nodeTyIxOf(dc), nm, 16)
    ) {
      return true
    }
    for kid in nodeSpineChildren(cur) {
      if elabCapReads(d, kid, nm) { return true }
    }
    cur = elseIfLink(cur)
  }
  false
}

// Whether nested declaration `d` reads a type variable instance `a`'s substitution binds, or an
// alias a shadow rename minted for one; a name `d` binds itself shadows the outer one.
function elabReadsChainOf(d: i32, a: i32): boolean {
  for nm in ekNames[a] {
    if elabReadsOuter(d, nm) { return true }
  }
  for al in elabAliases {
    if elabDeclReads(d, al) { return true }
  }
  false
}

// Whether nested declaration `d` reads a type variable open declaration `e` binds: one of its
// type parameters, or one its parameters' types name.
function elabReadsOpenOf(d: i32, e: i32): boolean {
  const n = nodeAt(e)
  if !(n is FuncDecl) { return false }
  const names: string[] = []
  for tp in n.fnTyParams { names.push(tp) }
  for p in n.fnParams { elabTyVarNamesIn(nodeTyIxOf(p), names, 0) }
  for nm in names {
    if elabReadsOuter(d, nm) { return true }
  }
  false
}

// Appends each type variable name type `t` mentions to `out`.
function elabTyVarNamesIn(t: i32, out: string[], depth: i32) {
  if t < 0 || t >= T.tys.length || depth > 16 { return 0 }
  const x = T.tys[t]
  match x {
    TyVar => {
      out.push(x.tvName)
    }
    TyArray => {
      elabTyVarNamesIn(x.aElem, out, depth + 1)
    }
    TyNullable => {
      elabTyVarNamesIn(x.nInner, out, depth + 1)
    }
    TyMap => {
      elabTyVarNamesIn(x.mKey, out, depth + 1)
      elabTyVarNamesIn(x.mVal, out, depth + 1)
    }
    TyObj => {
      for ft in x.objFieldTypes { elabTyVarNamesIn(ft, out, depth + 1) }
    }
    TyFunc => {
      for pt in x.fnParamTypes { elabTyVarNamesIn(pt, out, depth + 1) }
      elabTyVarNamesIn(x.fnRet, out, depth + 1)
    }
    TyUnion => {
      for m in x.uMembers { elabTyVarNamesIn(m, out, depth + 1) }
    }
    TyPrim | TyErr | TyLit | TyNeg => {}
  }
  0
}
// The diagnostics instances' re-checks owed the program, in the order the instances ran.
export let elabErrors: TDiag[] = []
// Set while a check re-runs for a program whose build stands clean: its instances' diagnostics
// belong to a program the split plan replaces, so none is reported.
export let elabErrorsMuted = false

export function elabErrorsMuteSet(on: boolean) {
  elabErrorsMuted = on
  0
}

// Keeps `d` unless two instances raised the same diagnostic at the same node.
function elabErrorNote(d: TDiag) {
  for e in elabErrors {
    if e.tat == d.tat && e.tmsg == d.tmsg { return 0 }
  }
  elabErrors.push(d)
  0
}

// How many diagnostics the last elaboration reports.
export function elabErrorCount(): i32 {
  if elabErrorsMuted { 0 } else { elabErrors.length }
}
// The instances `elabSetRepRow` makes as representations mono builds, and those they make.
let elabReprKeys: {[i32]: boolean} = Map()
let elabRepresenting = false
let elabHoleCur = 0
// The hole-pin rows the last elaboration made no instance of, each with the instance it is
// enqueued under (`elabHoleRowShortCount`).
let elabShortRows: i32[] = []
let elabShortFrom: i32[] = []

// How many of `elabShortRows` name, once completed from their call's binding, an instance the
// elaboration does not have (`elabHoleRowBindKey`).
export function elabHoleRowShortCount(): i32 {
  let n = 0
  let i = 0
  while i < elabShortRows.length {
    const key = elabHoleRowBindKey(elabShortRows[i], elabShortFrom[i])
    if key != "" && (ekIndex[key] ?? -1) < 0 { n = n + 1 }
    i = i + 1
  }
  n
}

// Row `r`'s binding into `outN`/`outT` with each name of its declaration its call's binding holds
// and the row leaves out added; false when the binding adds none.
function elabHoleRowCompleted(r: i32, outN: string[], outT: i32[]): boolean {
  if r < 0 || r >= elabHoleRowDecl.length { return false }
  const d = elabHoleRowDecl[r]
  for nm in elabHoleRowN[r] { outN.push(nm) }
  for ty in elabHoleRowT[r] { outT.push(ty) }
  const bn = elabHoleRowBindN[r]
  const bt = elabHoleRowBindT[r]
  let added = false
  let j = 0
  while j < bn.length && j < bt.length {
    if (
      !strListHas(outN, bn[j])
      && (elabOwnName(d, bn[j]) || elabSigReads(d, bn[j]))
    ) {
      outN.push(bn[j])
      outT.push(bt[j])
      added = true
    }
    j = j + 1
  }
  added
}

// Whether row `r` binds one of its names to a set of functions.
function elabHoleRowHoldsSet(r: i32): boolean {
  for ty in elabHoleRowT[r] {
    if fnTagSetOfTy(ty) >= 0 { return true }
  }
  false
}

// The key row `r` enqueued under `from` takes once completed (`elabHoleRowCompleted`), when that
// binding closes; else "".
function elabHoleRowBindKey(r: i32, from: i32): string {
  const n0: string[] = []
  const t0: i32[] = []
  if !elabHoleRowCompleted(r, n0, t0) { return "" }
  const d = elabHoleRowDecl[r]
  if d < 0 || !(nodeAt(d) is FuncDecl) { return "" }
  const names: string[] = []
  const tys: i32[] = []
  if !elabCanon(d, n0, t0, names, tys) { return "" }
  const parent = elabParentFor(d, from)
  if parent == 0 - 2 { return "" }
  const fn: string[] = names.slice(0, names.length)
  const ft: i32[] = tys.slice(0, tys.length)
  if parent >= 0 {
    let i = 0
    while i < ekNames[parent].length {
      fn.push(ekNames[parent][i])
      ft.push(ekTys[parent][i])
      i = i + 1
    }
  }
  if !elabParamsClosed(d, fn, ft) { return "" }
  i32ToStr(parent) + "^" + elabKeyOf(d, names, tys)
}

// Root hole rows of a declaration that reads its enclosing declaration's open types, and the
// instance count each has been enqueued up to.
let elabHoleDeferred: i32[] = []
let elabHoleDeferredAt: i32[] = []

// Enqueues the hole-pin rows recorded since the last drain. A root row of a declaration that
// reads an enclosing declaration's open types is enqueued under each instance of that
// enclosing declaration instead, as those instances appear.
function elabDrainHoleRows() {
  while elabHoleCur < elabHoleRowDecl.length {
    const r = elabHoleCur
    if tysClosed(elabHoleRowT[r]) && elabHoleRowFrom[r] < ekDecl.length {
      const d = elabHoleRowDecl[r]
      const from = elabHoleRowFrom[r]
      if from >= 0 {
        elabOwnHoleRows[i32ToStr(from) + "^" + i32ToStr(d)] = true
      }
      if from < 0 && elabParentFor(d, -1) == -2 {
        elabHoleDeferred.push(r)
        elabHoleDeferredAt.push(0)
      } else {
        // An instance only a D4551 default asks for is a guess, as the default instance is.
        elabGuessing = from < 0 && elabDefaultRowHas(d, elabHoleRowT[r])
        let k0 = elabEnqueue(d, elabHoleRowN[r], elabHoleRowT[r], from)
        // A row binding a set that the epochs left short of a name its call binds is the
        // set-keyed instance at that binding.
        const n1: string[] = []
        const t1: i32[] = []
        if k0 < 0 && elabHoleRowHoldsSet(r) && elabHoleRowCompleted(r, n1, t1) {
          elabGuessing = from < 0 && elabDefaultRowHas(d, t1)
          k0 = elabEnqueue(d, n1, t1, from)
        }
        if k0 < 0 {
          elabShortRows.push(r)
          elabShortFrom.push(from)
        }
        elabReachNote(from, k0, -1)
        elabGuessing = false
        // A lambda pinned by the template check is also keyed under each instance of its
        // encloser, which is where mono asks for it.
        if from < 0 && elabLamPerEncl(d) && elabEncl.has(d) {
          elabHoleDeferred.push(r)
          elabHoleDeferredAt.push(0)
        }
      }
    }
    elabHoleCur = elabHoleCur + 1
  }
  elabDrainWideRows()
  let i = 0
  while i < elabHoleDeferred.length {
    const r = elabHoleDeferred[i]
    const d = elabHoleRowDecl[r]
    const e = elabEncl.get(d) ?? -1
    let a = elabHoleDeferredAt[i]
    elabHoleDeferredAt[i] = ekDecl.length
    while a < ekDecl.length {
      if ekDecl[a] == e {
        // A template row of a lambda keyed per encloser instance fills only an instance whose own
        // walk pinned it nowhere: an instance that did holds its own pins (D15112).
        if (
          !(elabLamPerEncl(d)
            && elabHoleRowFrom[r] < 0
            && (elabOwnHoleRows[i32ToStr(a) + "^" + i32ToStr(d)] ?? false))
        ) {
          elabReachNote(
            a,
            elabEnqueue(d, elabHoleRowN[r], elabHoleRowT[r], a),
            -1,
          )
        }
      }
      a = a + 1
    }
    i = i + 1
  }
  0
}

// Each `instance^declaration` whose own walk banked a hole-pin row, marked as the rows drain.
let elabOwnHoleRows: {[string]: boolean} = Map()

// Builds each delivered value whose result only converts to its destination's as that result,
// beside the instance at its own (D9282).
let elabWideCur = 0
function elabDrainWideRows() {
  while elabWideCur < elabWideRowDecl.length {
    const r = elabWideCur
    elabWideCur = elabWideCur + 1
    const from = elabWideRowFrom[r]
    const d = elabWideRowDecl[r]
    // A key past this run's table belongs to an earlier run; the instance that banked the row
    // banks it again when this run re-checks it (D15407).
    if from >= ekDecl.length {
      0
    } else if from >= 0 || elabParentFor(d, -1) != -2 {
      const k = elabEnqueue(d, elabWideRowN[r], elabWideRowT[r], from)
      const w = if k >= 0 { elabWidenedRet(elabRetOf(k), elabWideRowRet[r]) } else { -1 }
      if w >= 0 { elabWideTwin(k, w, from) }
    }
  }
  0
}

function tysClosed(tys: i32[]): boolean {
  for t in tys {
    if !elabTyClosed(t, 0) { return false }
  }
  true
}

// Whether binding `t` is a tagged set's own type, which `elabSetArgBind` binds where the call
// delivers the set's id: final although it names holes, so no pass closes it to a signature
// (D15177).
function elabSetBinding(t: i32): boolean { fnTagTyIsTagged(t) }

// Whether every binding of a root row is final: closed, or a set's binding.
function elabRowClosedOrSet(tys: i32[]): boolean {
  for t in tys {
    if !elabTyClosed(t, 0) && !elabSetBinding(t) { return false }
  }
  true
}

// The type parameters of each declaration an inferred call that leaves them unbound defaults, and
// the type they default to (D4551); primed by the monomorphizer before the worklist runs.
export let elabTpDefaults: {[i32]: string[]} = Map()
export let elabTpDefaultTy = -1

export function elabTpDefaultsSet(d: i32, names: string[], t: i32) {
  elabTpDefaults[d] = names
  elabTpDefaultTy = t
  0
}

// Each source declaration by its body, so an emitted rebuild finds the declaration it copies.
let elabBodyDecl: {[i32]: i32} = Map()

export function elabBodyDeclNote(d: i32, body: i32) {
  if body >= 0 { elabBodyDecl[body] = d }
  0
}

// Per `<call>:<argument>`, the stub type an argument of only uncalled hole functions is delivered
// at; primed by the monomorphizer before the worklist runs.
let elabStubArg: {[string]: i32} = Map()

export function elabStubArgSet(ix: i32, k: i32, t: i32) {
  elabStubArg[i32ToStr(ix) + ":" + i32ToStr(k)] = t
  0
}

export function elabTpDefaultsReset() {
  elabStubArg = Map()
  elabTpDefaults = Map()
  elabBodyDecl = Map()
  0
}

// Whether `name` is a type variable declaration `decl` binds itself: a type parameter or a hole.
function elabOwnName(decl: i32, name: string): boolean {
  const n = nodeAt(decl)
  if n is FuncDecl {
    for tp in n.fnTyParams {
      if tp == name { return true }
    }
  }
  elabHoleDeclOf(name) == decl
}

// The type parameter each slot-scoped alias an emission rename minted stands for, and the
// declaration declaring it, so a demand made after the rename keys the instance one made before.
let elabAliasOf: {[string]: string} = Map()
let elabAliasDecl: {[string]: i32} = Map()
let elabAliases: string[] = []

export function elabAliasNote(alias: string, name: string, declarer: i32) {
  if !elabAliasOf.has(alias) { elabAliases.push(alias) }
  elabAliasOf[alias] = name
  elabAliasDecl[alias] = elabSrcDecl(declarer)
  0
}

// Whether a parameter or the signature of `decl` names type variable `name`.
function elabSigReads(decl: i32, name: string): boolean {
  const n = nodeAt(decl)
  if !(n is FuncDecl) { return false }
  for p in n.fnParams {
    if tyMentionsTyVarNamed(nodeTyIxOf(p), name, 16) { return true }
  }
  tyMentionsTyVarNamed(nodeTyIxOf(decl), name, 16)
}

// The canonical binding of `decl` from `names0`/`tys0`: its own names and the ones its signature
// reads, each once, first binding kept, plus the D4551 defaults; false when one of them is open.
function elabCanon(
  decl: i32,
  names0: string[],
  tys0: i32[],
  names: string[],
  tys: i32[],
): boolean {
  const exact = elabTestsTyVar(decl)
  let i0 = 0
  while i0 < names0.length && i0 < tys0.length {
    const al = names0[i0]
    const nm = if (elabAliasDecl.get(al) ?? -1) == decl { elabAliasOf[al] ?? al } else { al }
    let has = false
    for x in names {
      if x == nm { has = true }
    }
    if (
      !has
      && (elabOwnName(decl, nm) || elabSigReads(decl, nm) || elabIsRowEntry(nm))
    ) {
      if !elabTyClosed(tys0[i0], 0) { return false }
      names.push(nm)
      tys.push(if exact { tys0[i0] } else { widenLitTy(tys0[i0]) })
    }
    i0 = i0 + 1
  }
  // A type parameter the call leaves unbound takes the type of the parameter a binding annotated
  // with it is seeded from (D6760), else defaults as the instance it emits as (D4551).
  for tp in elabTpDefaults[decl] ?? [] {
    let has = false
    for nm in names {
      if nm == tp { has = true }
    }
    if !has {
      const st = elabTpSeedTy(decl, tp, names, tys)
      names.push(tp)
      tys.push(if st >= 0 { st } else { elabTpDefaultTy })
    }
  }
  // A string literal bound where the signature names a literal lowers as the `string` the
  // monomorphizer builds the instance at, so the instance is keyed at it.
  const sig = nodeTyIxOf(decl)
  if sig >= 0 && sig < T.tys.length {
    const f = tyAt(sig)
    if f is TyFunc && elabSigHasLit(f) {
      let i = 0
      while i < tys.length {
        tys[i] = elabStrLitWiden(tys[i], 4)
        i = i + 1
      }
    }
  }
  true
}

// `t` widened to `string` where it is a lone string literal, and its string literal members
// widened where it is a union that also holds another member; a union of string literals alone
// is kept, as the monomorphizer keeps it.
function elabStrLitWiden(t: i32, depth: i32): i32 {
  if t < 0 || t >= T.tys.length || tyIsLitUnion(t) { return t }
  elabStrLitWidenGo(t, depth)
}

function elabStrLitWidenGo(t: i32, depth: i32): i32 {
  if t < 0 || t >= T.tys.length || depth <= 0 { return t }
  const ty = tyAt(t)
  if ty is TyLit { return if ty.litKind == "str" { TY_STR } else { t } }
  if !(ty is TyUnion) { return t }
  let acc = -1
  let changed = false
  for m in ty.uMembers {
    const w = elabStrLitWidenGo(m, depth - 1)
    if w != m { changed = true }
    acc = if acc < 0 { w } else { joinTys(acc, w) }
  }
  if changed && acc >= 0 { acc } else { t }
}

// The closed type, under `names`/`tys`, of what seeds a binding of `decl`'s body annotated bare
// with type parameter `tp`: a parameter of `decl`, or a binding annotated with a bound name;
// -1 when no binding is so seeded, or two seeds disagree.
function elabTpSeedTy(decl: i32, tp: string, names: string[], tys: i32[]): i32 {
  const dn = nodeAt(decl)
  if !(dn is FuncDecl) { return -1 }
  let out = -1
  const stack: i32[] = [dn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if (
        n is LetDecl
        && n.letType >= 0
        && n.letInit >= 0
        && nodeAt(n.letType) is TypeRef
      ) {
        const tn = nodeAt(n.letType)
        const v = parenPeelIx(n.letInit)
        if (
          tn is TypeRef
          && tn.tyName == tp
          && v >= 0
          && nodeAt(v) is Ident
          && !elabLetAnnotated(identDeclOf(v), tp)
        ) {
          const t = elabSeedReadTy(decl, identDeclOf(v), names, tys)
          if t < 0 || (out >= 0 && out != t) { return -1 }
          out = t
        }
      }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  out
}

// Whether `d` is a binding annotated bare with type parameter `tp`.
function elabLetAnnotated(d: i32, tp: string): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const n = nodeAt(d)
  if !(n is LetDecl) || n.letType < 0 { return false }
  const tn = nodeAt(n.letType)
  tn is TypeRef && tn.tyName == tp
}

// The closed type under `names`/`tys` of declaration `d` read as a seed: a parameter of `decl`,
// or a binding annotated bare with a bound name; -1 otherwise.
function elabSeedReadTy(decl: i32, d: i32, names: string[], tys: i32[]): i32 {
  if d < 0 || d >= P.nodes.length || decl < 0 || decl >= P.nodes.length {
    return -1
  }
  const n = nodeAt(d)
  let t = -1
  if n is Param {
    const dn = nodeAt(decl)
    let own = false
    if dn is FuncDecl {
      for p in dn.fnParams {
        if p == d { own = true }
      }
    }
    if own {
      const held = holePinHeldSet(true)
      t = substTyDeep(nodeTyIxOf(d), names, tys)
      holePinHeldSet(held)
    }
  } else if n is LetDecl && n.letType >= 0 {
    const tn = nodeAt(n.letType)
    if tn is TypeRef {
      let i = 0
      while i < names.length && i < tys.length {
        if names[i] == tn.tyName { t = tys[i] }
        i += 1
      }
    }
  }
  if t >= 0 && elabTyClosed(t, 0) { t } else { -1 }
}

// Whether binding `names`/`tys` closes every parameter `decl`'s body reads, and each declared type
// parameter its return names; any other hole in the return may stay open, as may a function
// value's own. A question, not a pin: the substitution banks none.
function elabParamsClosed(decl: i32, names: string[], tys: i32[]): boolean {
  const dn = nodeAt(decl)
  if !(dn is FuncDecl) { return false }
  const marks: i32[] = []
  for t in tys {
    marks.push(
      if t >= 0 && t < T.tys.length && tyHasTyVar(t) { TY_ERR } else { t },
    )
  }
  const held = holePinHeldSet(true)
  let open = false
  for p in dn.fnParams {
    const t = nodeTyIxOf(p)
    if !open && t >= 0 && t < T.tys.length && tyHasTyVar(t) {
      open = !elabTyClosed(substTyDeep(t, names, marks), 0)
    }
  }
  const sig = nodeTyIxOf(decl)
  if !open && dn.fnTyParams.length > 0 && sig >= 0 && sig < T.tys.length {
    const f = tyAt(sig)
    if f is TyFunc {
      const rt = substTyDeep(f.fnRet, names, marks)
      for tp in dn.fnTyParams {
        if !open && tyMentionsTyVarNamed(rt, tp, 16) { open = true }
      }
    }
  }
  holePinHeldSet(held)
  !open
}

// Enqueues the instance of `decl` at `names0`/`tys0`; answers its key, or -1.
// The instances only a D4551 default asks for, and those made inside one: mono builds them for
// parity, no call needs their bodies, so a diagnostic in one is not the program's.
let elabGuessKeys: {[i32]: boolean} = Map()
let elabGuessing = false

// The candidates: instances minted for a decision the tag decision after the elaboration may
// take, and those made inside one. Mono builds one only where a demand reaches it, so a
// diagnostic in one is not the program's, and it binds no mint fact.
let elabCandKeys: {[i32]: boolean} = Map()
let elabCandidating = false

// `elabDemandFrom` for a candidate; its key, or -1.
function elabDemandCandidate(decl: i32, pTys: i32[], call: i32): i32 {
  const none: string[] = []
  const noTys: i32[] = []
  elabCandidating = true
  const k = elabDemandFrom(decl, none, noTys, pTys, -1, call)
  elabCandidating = false
  k
}

// Whether `elabSetRepTy` has answered a set with the no-argument stub since the last clear.
let elabRepStubbed = false

// Whether `elabRun` has returned in this compile; a key minted after it is a late demand.
let elabRunDone = false
// The declaration name of each key minted after `elabRun` returned (`$VL_LATE_DEMANDS`).
let elabLateNames: string[] = []

// How many keys the elaboration minted after `elabRun` returned, and the name of the `i`th.
export function elabLateCount(): i32 { elabLateNames.length }

export function elabLateLen(i: i32): i32 { elabLateNames[i].length }

export function elabLateAt(i: i32, j: i32): i32 { elabLateNames[i][j] }

function elabEnqueue(decl: i32, names0: string[], tys0: i32[], from: i32): i32 {
  if decl < 0 || !(nodeAt(decl) is FuncDecl) { return -1 }
  const names: string[] = []
  const tys: i32[] = []
  if !elabCanon(decl, names0, tys0, names, tys) { return -1 }
  const parent = elabParentFor(decl, from)
  if parent == 0 - 2 { return -1 }
  const key = i32ToStr(parent) + "^" + elabKeyOf(decl, names, tys)
  const have = ekIndex[key] ?? -1
  if have >= 0 { return have }
  if ekDecl.length >= ELAB_MAX_KEYS { return -1 }
  // The full substitution: this call's own, then the parent's, which a redeclared name shadows.
  const fn: string[] = []
  const ft: i32[] = []
  let i = 0
  while i < names.length && i < tys.length {
    fn.push(names[i])
    ft.push(tys[i])
    i = i + 1
  }
  if parent >= 0 {
    i = 0
    while i < ekNames[parent].length {
      fn.push(ekNames[parent][i])
      ft.push(ekTys[parent][i])
      i = i + 1
    }
  }
  if !elabParamsClosed(decl, fn, ft) { return -1 }
  const k = ekDecl.length
  ekIndex[key] = k
  if elabGuessing || (from >= 0 && (elabGuessKeys[from] ?? false)) {
    elabGuessKeys[k] = true
  }
  if elabRepresenting || (from >= 0 && (elabReprKeys[from] ?? false)) {
    elabReprKeys[k] = true
  }
  if elabSigAlting || (from >= 0 && (elabSigAltKeys[from] ?? false)) {
    elabSigAltKeys[k] = true
  }
  if elabCandidating || (from >= 0 && (elabCandKeys[from] ?? false)) {
    elabCandKeys[k] = true
  }
  const kk = i32ToStr(parent) + "^" + i32ToStr(decl)
  const kids = ekKids[kk] ?? []
  kids.push(k)
  ekKids[kk] = kids
  if elabRunDone { elabLateNames.push(elabLateName(decl)) }
  ekByDeclNote(decl, k)
  ekDecl.push(decl)
  ekNames.push(fn)
  ekTys.push(ft)
  ekParent.push(parent)
  ekDone.push(false)
  ekReach.push([])
  k
}

// Whether each instance's body has been checked.
let ekDone: boolean[] = []
// The instances whose bodies the monomorphizer is walking, innermost last.
let elabWalkKeys: i32[] = []

// Appends to `names`/`tys` the pins of lambda `d`'s one key under the instance being walked, the
// key `elabReturnCredits` or an instance's own call minted for it there; false when it has none.
export function elabLamPinsUnderWalk(
  d: i32,
  names: string[],
  tys: i32[],
): boolean {
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  if top < 0 || d < 0 { return false }
  const kids = ekKids[i32ToStr(top) + "^" + i32ToStr(d)] ?? []
  if kids.length != 1 { return false }
  const k = kids[0]
  let i = 0
  while i < ekNames[k].length && i < ekTys[k].length {
    names.push(ekNames[k][i])
    tys.push(ekTys[k][i])
    i = i + 1
  }
  true
}

// The instance being walked, the key a nested lambda's instances are indexed under; -1 outside one.
export function elabWalkTop(): i32 {
  if elabWalkKeys.length > 0 {
    elabWalkKeys[elabWalkKeys.length - 1]
  } else {
    -1
  }
}

export function elabWalkPush(k: i32) {
  elabWalkKeys.push(k)
  0
}

export function elabWalkPop() {
  elabWalkKeys.pop()
  0
}

// By `instance|call`, the set each instance's call through a parameter goes through, as
// `elabMintFactAt` notes it (nested-per-encloser-2026-11.md, slice 1).
let elabCallInstSets: {[string]: i32} = Map()

// The set call `ix` goes through at the instance being walked, as the mint facts noted it; -1 for
// none.
export function elabCallSetIn(ix: i32): i32 {
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  if top < 0 || ix < 0 { return -1 }
  elabCallInstSets[i32ToStr(top) + "|" + i32ToStr(ix)] ?? -1
}

// Node `ix`'s closed type at the instance being walked, or -1 outside one or where it stays open.
export function elabWalkTy(ix: i32): i32 {
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  if top < 0 || ix < 0 { return -1 }
  elabNodeTy(ix, top)
}

// The read `ix`'s type at the instance being walked where that instance narrowed it, else -1.
export function elabWalkNarrowedTy(ix: i32): i32 {
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  if top < 0 || ix < 0 || elabPairIn(elabNodeNarrowed, ix, top) < 0 {
    return -1
  }
  elabNodeTy(ix, top)
}

// The instances of nested declaration `d` under instance `k`: those under the parent key
// `elabParentFor` names, narrowed to the ones `k`'s body reaches when that key holds several.
function elabKidsAt(d: i32, k: i32): i32[] {
  const parent = elabParentFor(d, k)
  if parent < -1 { return [] }
  const ks = ekKids[i32ToStr(parent) + "^" + i32ToStr(d)] ?? []
  if ks.length < 2 || k < 0 { return ks }
  const out: i32[] = []
  for kd in ks {
    if elabReaches(k, kd) { out.push(kd) }
  }
  if out.length == 0 { return ks }
  out
}

// The result nested declaration `d`'s instances under the instance being walked agree on; -1
// when it has none, they disagree, or one stays open.
export function elabWalkKidRet(d: i32): i32 {
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  if top < 0 || d < 0 { return -1 }
  let r = -1
  for kd in elabKidsAt(d, top) {
    const kr = elabRetOf(kd)
    if kr < 0 || (r >= 0 && kr != r) { return -1 }
    r = kr
  }
  r
}

// Drops from `names`/`tys` each name `decl`, a lambda declaring no type parameter, inherits from
// its enclosing instance but whose signature reads only through another generic's same-named
// variable: that variable is not the enclosing instance's to bind (D15034).
export function elabLamInheritedOwn(
  decl0: i32,
  names: string[],
  tys: i32[],
  outN: string[],
  outT: i32[],
) {
  const decl = elabSrcDecl(decl0)
  const fd = if decl >= 0 && decl < P.nodes.length { nodeAt(decl) } else { nodeAt(0) }
  const lam = fd is FuncDecl
    && fd.fnTyParams.length == 0
    && topFnOwnerOf(decl) == ""
  const self = elabEnclOwner(decl)
  const sig = if decl >= 0 { nodeTyIxOf(decl) } else { -1 }
  let i = 0
  while i < names.length && i < tys.length {
    const foreign = lam
      && tyMentionsTyVarNamed(sig, names[i], 16)
      && !tyMentionsOwnVarNamed(sig, names[i], self, 16)
    if !foreign {
      outN.push(names[i])
      outT.push(tys[i])
    }
    i = i + 1
  }
  0
}

// The top-level function `decl` is or is nested in, by owner key; "" at module scope.
function elabEnclOwner(decl: i32): string {
  let d = decl
  let hops = 0
  while d >= 0 && hops < 32 {
    const o = topFnOwnerOf(d)
    if o != "" { return o }
    d = elabEncl.get(d) ?? -1
    hops = hops + 1
  }
  ""
}

// The instance of emitted declaration `decl0` at `names0`/`tys0` and parameter types `pTys`,
// found or checked now under the instance being walked; -1 when none can be.
export function elabDemand(
  decl0: i32,
  names0: string[],
  tys0: i32[],
  pTys: i32[],
  call: i32,
  slotRet: i32,
): i32 {
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  if top < -1 { return -1 }
  const k = elabDemandFrom(decl0, names0, tys0, pTys, top, call)
  if k < 0 || slotRet < 0 { return k }
  const w = elabWidenedRet(elabRetOf(k), slotRet)
  if w < 0 { return k }
  elabWideTwin(k, w, top)
}

// The result `slot` a delivery whose own result is `own` builds the instance returning: `slot`
// where `own` only converts to it, else -1 (D9282).
export function elabWidenedRet(own: i32, slot: i32): i32 {
  if own < 0 || slot < 0 || own >= T.tys.length || slot >= T.tys.length {
    return -1
  }
  if tySame(own, slot) || !assignable(own, slot) { return -1 }
  slot
}

// Whether the elaboration holds maker `decl` built at closed result `ret` (its wide twin).
export function elabMakerTwinHeld(decl: i32, ret: i32): boolean {
  for k in ekRetWide.keys() {
    if (
      k >= 0
      && k < ekDecl.length
      && ekDecl[k] == decl
      && tySame(ekRetWide[k] ?? -1, ret)
    ) {
      return true
    }
  }
  false
}

// Instance `k` built returning the wider `w`: the same binding under its own key, its body
// checked once more there; `k` itself when no key is left.
function elabWideTwin(k: i32, w: i32, from: i32): i32 {
  const key = i32ToStr(k) + "=>" + elabCanonStr(w, ELAB_CANON_DEPTH)
  const have = ekIndex[key] ?? -1
  if have >= 0 { return have }
  if ekDecl.length >= ELAB_MAX_KEYS { return k }
  const k2 = ekDecl.length
  ekIndex[key] = k2
  if elabGuessKeys[k] ?? false { elabGuessKeys[k2] = true }
  if elabReprKeys[k] ?? false { elabReprKeys[k2] = true }
  if elabSigAltKeys[k] ?? false { elabSigAltKeys[k2] = true }
  if elabRunDone { elabLateNames.push(elabLateName(ekDecl[k])) }
  ekByDeclNote(ekDecl[k], k2)
  ekDecl.push(ekDecl[k])
  ekNames.push(ekNames[k])
  ekTys.push(ekTys[k])
  ekParent.push(ekParent[k])
  ekDone.push(false)
  ekReach.push([])
  ekRetWide[k2] = w
  const n0 = ekDecl.length
  elabReachNote(from, k2, -1)
  elabOne(k2)
  elabSettle(n0)
  k2
}

// `elabDemand` under instance `from` (the root when -1) for template call `call` (-1 for none),
// answered with the call's checker instance where `elabCkUsable` and the pins allow. Otherwise a
// parameter the call's instance binds to a function value its body reaches at two instances keeps
// that `Fn#d` binding: no one closed type holds it, and a closed pin is only its rep.
function elabDemandFrom(
  decl0: i32,
  names0: string[],
  tys0: i32[],
  pTys: i32[],
  from: i32,
  call: i32,
): i32 {
  const decl = elabSrcDecl(decl0)
  const names: string[] = []
  const tys: i32[] = []
  const sig = if decl >= 0 { nodeTyIxOf(decl) } else { -1 }
  const byId: boolean[] = []
  const ck = if call >= 0 { elabCallInstFrom(call, from) } else { -1 }
  if ck >= 0 && ekDecl[ck] == decl && sig >= 0 && sig < T.tys.length {
    const f = tyAt(sig)
    if f is TyFunc {
      for pt in f.fnParamTypes {
        const bt = substTyDeep(pt, ekNames[ck], ekTys[ck])
        const ds: i32[] = []
        if bt >= 0 && tyHasTyVar(bt) { elabFnIdsIn(bt, ds, 0) }
        let id = false
        for d in ds {
          if elabReachedOf(ck, d) < -1 { id = true }
        }
        if id { bindGenWalk(pt, bt, names, tys) }
        byId.push(id)
      }
    }
  }
  // A bundle pin is the call's own instance, whose lambda set it carries closures for (D14841).
  if (
    ck >= 0
    && ekDecl[ck] == decl
    && elabPinsHoldBundle(ck, pTys)
    && elabCkTakesPins(ck, sig, pTys)
  ) {
    elabReachNote(from, ck, -1)
    const nb = ekDecl.length
    if !ekDone[ck] { elabOne(ck) }
    elabSettle(nb)
    return ck
  }
  // A lambda pinned at the bundle of its own parameter's calls is the instance that made them.
  const lk = elabLamBundleInst(decl, pTys)
  if lk >= 0 {
    elabReachNote(from, lk, -1)
    return lk
  }
  // An argument holding a tagged set binds its hole parameter to the set itself, which no
  // checker instance at the set's rep has.
  const tagged = elabCallTaggedArgs(call, decl, from)
  if (
    !tagged
    && elabCkUsable(decl, call, from) >= 0
    && elabCkTakesPins(ck, sig, pTys)
  ) {
    elabReachNote(from, ck, -1)
    const n1 = ekDecl.length
    if !ekDone[ck] { elabOne(ck) }
    elabSettle(n1)
    return ck
  }
  let i = 0
  while i < names0.length && i < tys0.length {
    names.push(names0[i])
    tys.push(tys0[i])
    i = i + 1
  }
  if sig >= 0 && sig < T.tys.length {
    const f = tyAt(sig)
    if f is TyFunc {
      let p = 0
      while p < f.fnParamTypes.length && p < pTys.length {
        const at = if tagged { elabCallArgSetTy(call, decl, p, from) } else { -1 }
        if at >= 0 {
          // The set's own type replaces the rep a caller's pin binds the same variable to.
          const an: string[] = []
          const atys: i32[] = []
          bindGenWalk(f.fnParamTypes[p], at, an, atys)
          let j = 0
          while j < an.length && j < atys.length {
            const w = strListIndexOf(names, an[j])
            if w >= 0 {
              tys[w] = atys[j]
            } else {
              names.push(an[j])
              tys.push(atys[j])
            }
            j = j + 1
          }
        } else if elabTyClosed(pTys[p], 0) && !(p < byId.length && byId[p]) {
          bindGenWalk(f.fnParamTypes[p], pTys[p], names, tys)
        }
        p = p + 1
      }
    }
  }
  // A declaration with no type variable to bind is its generic pass's own typing: the root.
  if names.length == 0 && elabBindsNothing(decl) { return -1 }
  // A binding kept as a set where the elaboration already holds the instance at every closed pin
  // (a rep row's) is that instance.
  let anyId = false
  for b in byId {
    if b { anyId = true }
  }
  if anyId && !tagged {
    const pk = elabKeyAtPins(decl, names0, tys0, pTys, from)
    if pk >= 0 { return pk }
  }
  elabRowEntries(call, decl, names, tys)
  const n0 = ekDecl.length
  const k = elabEnqueue(decl, names, tys, from)
  elabReachNote(from, k, -1)
  if k >= 0 && !ekDone[k] { elabOne(k) }
  elabSettle(n0)
  k
}

// The instance of `decl` under `from` already keyed by `names0`/`tys0` with each parameter bound
// at its closed pin in `pTys`; -1 when the elaboration holds none.
function elabKeyAtPins(
  decl: i32,
  names0: string[],
  tys0: i32[],
  pTys: i32[],
  from: i32,
): i32 {
  const sig = nodeTyIxOf(decl)
  if sig < 0 || sig >= T.tys.length { return -1 }
  const f = tyAt(sig)
  if !(f is TyFunc) { return -1 }
  const bn: string[] = []
  const bt: i32[] = []
  let p = 0
  while p < f.fnParamTypes.length && p < pTys.length {
    if elabTyClosed(pTys[p], 0) {
      bindGenWalk(f.fnParamTypes[p], pTys[p], bn, bt)
    }
    p = p + 1
  }
  let i = 0
  while i < names0.length && i < tys0.length {
    if !strListHas(bn, names0[i]) {
      bn.push(names0[i])
      bt.push(tys0[i])
    }
    i = i + 1
  }
  const names: string[] = []
  const tys: i32[] = []
  if !elabCanon(decl, bn, bt, names, tys) { return -1 }
  const parent = elabParentFor(decl, from)
  if parent == 0 - 2 { return -1 }
  ekIndex[i32ToStr(parent) + "^" + elabKeyOf(decl, names, tys)] ?? -1
}

// The tagged set, or list of one, argument `p` of call `call` to `decl` hands an un-annotated
// parameter, or one its own type parameter alone annotates, or -1.
function elabCallArgSetTy(call: i32, decl: i32, p: i32, from: i32): i32 {
  if call < 0 || call >= P.nodes.length || decl < 0 || decl >= P.nodes.length {
    return -1
  }
  const cn = nodeAt(call)
  const f = nodeAt(decl)
  if !(cn is Call) || !(f is FuncDecl) { return -1 }
  if p >= cn.callArgs.length || p >= f.fnParams.length { return -1 }
  if p < cn.callArgNames.length && cn.callArgNames[p] != "" { return -1 }
  const q = nodeAt(f.fnParams[p])
  if !(q is Param) || q.parType >= 0 && !fnTagOwnTyParamJoins(f, p, []) {
    return -1
  }
  const ax = parenPeelIx(cn.callArgs[p])
  const t = if ax >= 0 { nodeTyIxOf(ax) } else { -1 }
  if fnTagSetIsTagged(fnTagSetOfTy(t)) || fnTagListTy(t) { return t }
  // A parameter of the calling instance handed on holds the set that instance binds it to.
  const it = if ax >= 0 && from >= 0 { elabNodeTy(ax, from) } else { -1 }
  if fnTagSetIsTagged(fnTagSetOfTy(it)) || fnTagListTy(it) { it } else { -1 }
}

// Whether some argument of call `call` to `decl` is a tagged set its parameter takes as itself.
function elabCallTaggedArgs(call: i32, decl: i32, from: i32): boolean {
  if call < 0 || call >= P.nodes.length { return false }
  const cn = nodeAt(call)
  if !(cn is Call) { return false }
  let p = 0
  while p < cn.callArgs.length {
    if elabCallArgSetTy(call, decl, p, from) >= 0 { return true }
    p = p + 1
  }
  false
}

// Whether declaration `decl`, and each declaration enclosing it, is no generic and has no
// un-annotated parameter (a nested one none typed from context): an instance of it would bind
// nothing, under any enclosing instance.
function elabBindsNothing(decl: i32): boolean {
  let d = decl
  let guard = 0
  while d >= 0 && guard < 32 {
    if d >= P.nodes.length { return false }
    const f = nodeAt(d)
    if !(f is FuncDecl) || f.fnTyParams.length > 0 { return false }
    const sig = nodeTyIxOf(d)
    if sig < 0 || sig >= T.tys.length || tyHasTyVar(sig) { return false }
    // A nested declaration typed from its context is checked under its enclosing instance
    // where its body calls a generic.
    if elabEncl.has(d) && !elabParamsAnnotated(f) && elabBodyCallsGeneric(d) {
      return false
    }
    d = elabEncl[d] ?? -1
    guard = guard + 1
  }
  d < 0
}

// Whether nested declaration `d` is checked as an instance of its own with nothing bound: no
// declaration from it outward binds anything, it is typed from its context, and its body calls
// a generic.
function elabNestedOwnInstance(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const f = nodeAt(d)
  if !(f is FuncDecl) || f.fnTyParams.length > 0 || elabParamsAnnotated(f) {
    return false
  }
  const sig = nodeTyIxOf(d)
  if sig < 0 || sig >= T.tys.length || tyHasTyVar(sig) { return false }
  const e = elabEncl[d] ?? -1
  (e < 0 || elabBindsNothing(e)) && elabBodyCallsGeneric(d)
}

// `elabNestedOwnInstance` for a declaration whose encloser binds: one instance per instance of the
// encloser, at that instance's bindings, as mono builds a nested declaration per enclosing
// instance.
function elabNestedPerEncl() {
  for d in elabEncl.keys() {
    const f = nodeAt(d)
    const e = elabEncl[d] ?? -1
    const sig = nodeTyIxOf(d)
    if (
      e >= 0
      && !elabBindsNothing(e)
      && f is FuncDecl
      && f.fnTyParams.length == 0
      && sig >= 0
      && sig < T.tys.length
      && !tyHasTyVar(sig)
      && ((!elabParamsAnnotated(f) && elabBodyCallsGeneric(d))
        || (elabBodyReadsOpen(d) && elabSnapIx.has(elabSnapKey(-1, d))))
    ) {
      let a = 0
      const n = ekDecl.length
      while a < n {
        if ekDecl[a] == e && tysClosed(ekTys[a]) {
          elabReachNote(a, elabEnqueue(d, ekNames[a], ekTys[a], a), -1)
        }
        a = a + 1
      }
    } else if (
      e >= 0
      && f is FuncDecl
      && f.fnTyParams.length == 0
      && sig >= 0
      && sig < T.tys.length
      && !tyHasTyVar(sig)
      && elabReadsEnclParam(d, e)
    ) {
      // A closed nested declaration reading an un-annotated parameter of its encloser is that
      // encloser instance's program, so it is built under each.
      let a = 0
      const n = ekDecl.length
      while a < n {
        if ekDecl[a] == e && tysClosed(ekTys[a]) {
          const nk = elabEnqueue(d, ekNames[a], ekTys[a], a)
          if nk >= 0 {
            elabPerEnclDecls[d] = true
            elabReachNote(a, nk, -1)
          }
        }
        a = a + 1
      }
    }
  }
  elabSettle(0)
}

// The nested declarations `elabNestedPerEncl`'s third branch built per encloser instance.
let elabPerEnclDecls: {[i32]: boolean} = Map()

// Whether nested declaration `d`'s body reads an un-annotated parameter of its encloser `e`, or of
// an encloser of `e` whose instances `e` is built under.
function elabReadsEnclParam(d: i32, e: i32): boolean {
  if e < 0 || e >= P.nodes.length || d < 0 || d >= P.nodes.length {
    return false
  }
  if elabReadsParamOf(d, e) { return true }
  const up = elabEncl[e] ?? -1
  (elabPerEnclDecls[e] ?? false) && elabReadsEnclParam(d, up)
}

// Whether nested declaration `d`'s body reads an un-annotated parameter of declaration `e`.
function elabReadsParamOf(d: i32, e: i32): boolean {
  const en = nodeAt(e)
  const dn = nodeAt(d)
  if !(en is FuncDecl) || !(dn is FuncDecl) { return false }
  const stack: i32[] = [dn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      if nodeAt(ix) is Ident {
        const pd = identDeclOf(ix)
        const pn = if pd >= 0 && pd < P.nodes.length { nodeAt(pd) } else { nodeAt(ix) }
        if pn is Param && pn.parType < 0 && i32ListHas(en.fnParams, pd) {
          return true
        }
      }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  false
}

// Whether `d` has an instance whose parent is instance `k`.
function elabHasInstUnder(d: i32, k: i32): boolean {
  let a = 0
  while a < ekDecl.length {
    if ekDecl[a] == d && ekParent[a] == k { return true }
    a = a + 1
  }
  false
}

// Whether declaration `d`'s body reads a captured value its template types with an open type, so
// each instance of its encloser types it apart (D4046).
function elabBodyReadsOpen(d: i32): boolean {
  const dn = nodeAt(d)
  if !(dn is FuncDecl) { return false }
  const stack: i32[] = [dn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is Ident {
        const dd = identDeclOf(ix)
        const t = nodeTyIxOf(ix)
        if (
          dd >= 0
          && !nodeContains(d, dd)
          && t >= 0
          && t < T.tys.length
          && tyHasTyVar(t)
        ) {
          return true
        }
      }
      if !(n is FuncDecl) {
        for c in nodeChildren(ix) { stack.push(c) }
      }
    }
  }
  false
}

// Whether every parameter of `f` carries a written annotation.
function elabParamsAnnotated(f: FuncDecl): boolean {
  for p in f.fnParams {
    const pn = nodeAt(p)
    if !(pn is Param) || pn.parType < 0 { return false }
  }
  true
}

// Two calls of one declaration whose arguments are built at the same wider record (D14532's rep
// row) while the checker typed them apart are one instance at that rep, which mono pins and
// neither checker instance answers alone; it is checked here, not demanded by the build.
function elabRepRowInstances() {
  const rows: i32[] = []
  const cks: i32[] = []
  const n = callBindCount()
  let r = 0
  while r < n {
    const reps = callBindRepTysAt(r)
    const ck = if reps.length > 0 && tysClosed(reps) { elabCallInstFrom(callBindIxAt(r), -1) } else { -1 }
    if ck >= 0 && elabCkUsable(ekDecl[ck], callBindIxAt(r), -1) == ck {
      rows.push(r)
      cks.push(ck)
    }
    r = r + 1
  }
  let grew = false
  let i = 0
  while i < rows.length {
    // A list argument mono pins at its rep is that instance alone (D14733).
    if elabListArgAtRep(callBindIxAt(rows[i]), ekDecl[cks[i]]) {
      const k = elabEnqueue(
        ekDecl[cks[i]],
        callBindNamesAt(rows[i]),
        callBindRepTysAt(rows[i]),
        -1,
      )
      elabReachNote(-1, k, -1)
      grew = true
    }
    let j = i + 1
    while j < rows.length {
      if (
        cks[i] != cks[j]
        && ekDecl[cks[i]] == ekDecl[cks[j]]
        && elabSameRow(rows[i], rows[j])
      ) {
        const k = elabEnqueue(
          ekDecl[cks[i]],
          callBindNamesAt(rows[i]),
          callBindRepTysAt(rows[i]),
          -1,
        )
        elabReachNote(-1, k, -1)
        grew = true
        j = rows.length
      }
      j = j + 1
    }
    i = i + 1
  }
  if grew { elabSettle(0) }
}

// Whether call `ix` of `decl` hands a parameter annotated as a list of a type parameter an
// argument built at a wider list than the instance's type (`callArgRepTy`), as mono pins it.
function elabListArgAtRep(ix: i32, decl: i32): boolean {
  const f = if decl >= 0 && decl < P.nodes.length { nodeAt(decl) } else { null }
  if !(f is FuncDecl) { return false }
  let a = 0
  while a < f.fnParams.length {
    const pn = nodeAt(f.fnParams[a])
    const pt = if pn is Param && pn.parType >= 0 { nodeAt(pn.parType) } else { null }
    if pt is TypeRef {
      const nm = pt.tyName
      const n = nm.length
      const el = if n > 2 && nm.slice(n - 2, n) == "[]" { nm.slice(0, n - 2) } else { "" }
      if el != "" && strListHas(f.fnTyParams, el) {
        const et = elabCallParamTy(ix, a)
        if et >= 0 && callArgRepTy(ix, a, et) != et { return true }
      }
    }
    a = a + 1
  }
  false
}

// Whether bind rows `a` and `b` bind the same names to the same rep types.
function elabSameRow(a: i32, b: i32): boolean {
  const an = callBindNamesAt(a)
  const bn = callBindNamesAt(b)
  const at = callBindRepTysAt(a)
  const bt = callBindRepTysAt(b)
  if (
    an.length != bn.length
    || at.length != bt.length
    || at.length != an.length
  ) {
    return false
  }
  let q = 0
  while q < an.length {
    if an[q] != bn[q] || !(at[q] == bt[q] || tySame(at[q], bt[q])) {
      return false
    }
    q = q + 1
  }
  true
}

// Whether declaration `d`'s subtree holds a call the checker bound type variables at.
function elabBodyCallsGeneric(d: i32): boolean {
  let r = 0
  const n = callBindCount()
  while r < n {
    if nodeContains(d, callBindIxAt(r)) { return true }
    r = r + 1
  }
  false
}

// The checker's instance of `decl` that call `call` reaches from instance `from`, when a demand
// answers with it: its bindings carry no function value, no hole and no error type. Else -1.
function elabCkUsable(decl: i32, call: i32, from: i32): i32 {
  if call < 0 || decl < 0 { return -1 }
  const ck = elabCallInstFrom(call, from)
  if ck < 0 || ekDecl[ck] != decl { return -1 }
  for t in ekTys[ck] {
    if t < 0 || t >= T.tys.length || tyHasHole(t) || tyMentionsErr(t, 8) {
      return -1
    }
    const ds: i32[] = []
    elabFnIdsIn(t, ds, 0)
    if ds.length > 0 { return -1 }
  }
  ck
}

// Whether each closed parameter pin in `pTys` is assignable to instance `ck`'s parameter of
// signature `sig`, or is that parameter's brand erased, or its numeric literals widened where no
// other instance of the declaration takes the same pins: a pin the instance cannot take keeps the
// pin's own instance.
function elabCkTakesPins(ck: i32, sig: i32, pTys: i32[]): boolean {
  if sig < 0 || sig >= T.tys.length { return false }
  const f = tyAt(sig)
  if !(f is TyFunc) { return false }
  let widened = false
  let strWidened = false
  let p = 0
  while p < f.fnParamTypes.length && p < pTys.length {
    if (
      elabTyClosed(pTys[p], 0)
      && !elabBundlePinTaken(ck, p, pTys[p])
      && !tySame(elabKeyRowAt(ck, p), pTys[p])
    ) {
      const bt = substTyDeep(f.fnParamTypes[p], ekNames[ck], ekTys[ck])
      const how = elabPinTakes(pTys[p], bt)
      if how == 0 { return false }
      if how == 2 { widened = true }
      if how == 2 && !isNumericPrimTy(pTys[p]) { strWidened = true }
    }
    p = p + 1
  }
  // A string literal lowers as an atom, so a signature that also names one would read the
  // literal instance's atoms where the widened pin builds strings.
  if strWidened && elabSigHasLit(f) { return false }
  !widened || elabSoleTaker(ck, f, pTys)
}

// The record instance `k` delivers its parameter `i` at (its `#r.<i>` entry, D15173), or -1: a
// pin naming that record is the instance's own row, its walk keeping the hole's binding.
function elabKeyRowAt(k: i32, i: i32): i32 {
  if k < 0 || k >= ekNames.length { return -1 }
  const nm = "#r." + i32ToStr(i)
  let j = 0
  while j < ekNames[k].length && j < ekTys[k].length {
    if ekNames[k][j] == nm { return ekTys[k][j] }
    j = j + 1
  }
  -1
}

// The record the instance call `ix` reaches delivers its parameter `i` at, or -1 (D15173).
export function elabCallParamRowTy(ix: i32, i: i32): i32 {
  const from = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  elabKeyRowAt(elabCallInstFrom(ix, from), i)
}

// Whether one of the pins `pTys` is the bundle of instance `ck`'s parameter at its position.
function elabPinsHoldBundle(ck: i32, pTys: i32[]): boolean {
  let p = 0
  while p < pTys.length {
    if elabBundlePinTaken(ck, p, pTys[p]) { return true }
    p = p + 1
  }
  false
}

// The instance of lambda `d` whose calls through a parameter one of the pins `pTys` holds the
// bundle of, as `elabLamParamSigs` records them; -1 where no pin is such a bundle.
function elabLamBundleInst(d: i32, pTys: i32[]): i32 {
  let p = 0
  while p < pTys.length && p < 64 {
    const sigs = elabLamSigs.get(elabBundleKey(d, p)) ?? []
    if sigs.length >= 2 && elabPinIsBundleOf(pTys[p], sigs) {
      return elabLamSigInst.get(elabBundleKey(d, p)) ?? -1
    }
    p = p + 1
  }
  -1
}

// Whether `pin` is the record whose field `c<j>` is the `j`th of `sigs`.
function elabPinIsBundleOf(pin: i32, sigs: i32[]): boolean {
  if pin < 0 || pin >= T.tys.length { return false }
  const o = tyAt(pin)
  if !(o is TyObj) || o.objFieldNames.length != sigs.length { return false }
  let j = 0
  while j < sigs.length {
    const at = strListIndexOf(o.objFieldNames, "c" + i32ToStr(j))
    if at < 0 || !tySame(o.objFieldTypes[at], sigs[j]) { return false }
    j = j + 1
  }
  true
}

// Whether `pin` is the bundle of instance `ck`'s parameter `p`: the record whose field `c<j>` is
// the `j`th signature the instance calls the parameter's lambdas at. Every encloser handing its
// own lambda at those signatures shares the instance (D14841).
function elabBundlePinTaken(ck: i32, p: i32, pin: i32): boolean {
  const sigs = elabBundleSigs.get(elabBundleKey(ck, p)) ?? []
  if sigs.length >= 2 && elabPinIsBundleOf(pin, sigs) { return true }
  elabCloBundlePinTaken(ck, p, pin)
}

// Whether `pin` is the closure of a lambda instance `ck`'s parameter `p` holds, taking the bundle
// of that lambda's calls through its own parameter (`elabLamBundleInst`).
function elabCloBundlePinTaken(ck: i32, p: i32, pin: i32): boolean {
  if pin < 0 || pin >= T.tys.length { return false }
  const pf = tyAt(pin)
  if !(pf is TyFunc) { return false }
  const dn = nodeAt(ekDecl[ck])
  if !(dn is FuncDecl) || p >= dn.fnParams.length { return false }
  const ds = elabFnSetOf(
    substTyDeep(nodeTyIxOf(dn.fnParams[p]), ekNames[ck], ekTys[ck]),
  )
  if ds.length == 0 { return false }
  for d in ds {
    if elabLamBundleInst(d, pf.fnParamTypes) < 0 { return false }
  }
  true
}

// Whether function type `f` names a literal in its result or a parameter, under a union.
function elabSigHasLit(f: TyFunc): boolean {
  if tyHasLitLeaf(f.fnRet, 4) { return true }
  for pt in f.fnParamTypes {
    if tyHasLitLeaf(pt, 4) { return true }
  }
  false
}

// How parameter type `bt` takes pin `pin`: 1 assignable or its brand erased, 2 its numeric
// literals widened, 0 not at all.
function elabPinTakes(pin: i32, bt: i32): i32 {
  if bt < 0 { return 0 }
  if assignable(pin, bt) || tySame(pin, nomErasedTyIx(bt)) { return 1 }
  // A pin spelled as the binding is, a set by its map or a record by its twin, is that binding.
  if tyToStructStr(pin) == tyToStructStr(bt) { return 1 }
  if tySame(pin, elabLitBaseTy(bt, 6)) { return 2 }
  // A record pin wider than the binding is the record the argument is built at, its rep only.
  if recRepWidens(bt, pin) { return 2 }
  // A storage pin of a value the call's narrowing proved non-null (`P[] | null` beside `P[]`).
  const nn = nonNullTy(pin)
  if nn != pin && nn >= 0 && (tySame(nn, bt) || tyEq(nn, bt)) { return 2 }
  0
}

// Whether `ck` is the one instance of its declaration, under its parent, whose parameter types
// (of signature `f`) take the pins `pTys`: a body built at those pins then serves only `ck`.
function elabSoleTaker(ck: i32, f: TyFunc, pTys: i32[]): boolean {
  let k = 0
  while k < ekDecl.length {
    if k != ck && ekDecl[k] == ekDecl[ck] && ekParent[k] == ekParent[ck] {
      let takes = true
      let p = 0
      while p < f.fnParamTypes.length && p < pTys.length && takes {
        const bt = substTyDeep(f.fnParamTypes[p], ekNames[k], ekTys[k])
        if elabTyClosed(pTys[p], 0) && elabPinTakes(pTys[p], bt) == 0 {
          takes = false
        }
        p = p + 1
      }
      if takes { return false }
    }
    k = k + 1
  }
  true
}

// `t` with each numeric literal widened to its base, through unions, nullables, list elements and
// record fields: the type a monomorphizer pin spells such a binding at, which lowers alike (a
// string literal union does not: it is an atom). `t` itself when nothing widens.
function elabLitBaseTy(t: i32, depth: i32): i32 {
  if t < 0 || t >= T.tys.length || depth <= 0 { return t }
  const lb = litMembersBaseTy(t)
  if lb != t { return lb }
  const ty = tyAt(t)
  match ty {
    TyUnion => {
      let acc = -1
      let changed = false
      for m in ty.uMembers {
        const w = elabLitBaseTy(m, depth - 1)
        if w != m { changed = true }
        acc = if acc < 0 { w } else { joinTys(acc, w) }
      }
      return if changed && acc >= 0 { acc } else { t }
    }
    TyNullable => {
      const w = elabLitBaseTy(ty.nInner, depth - 1)
      return if w != ty.nInner { mkNullableTy(w) } else { t }
    }
    TyArray => {
      const w = elabLitBaseTy(ty.aElem, depth - 1)
      return if w != ty.aElem { mkArrayTy(w) } else { t }
    }
    // A literal widened above; a map or function type is pinned as written.
    TyPrim => {
      return t
    }
    TyErr => {
      return t
    }
    TyObj => {
      const fs: i32[] = []
      let changed = false
      for ft in ty.objFieldTypes {
        const w = elabLitBaseTy(ft, depth - 1)
        if w != ft { changed = true }
        fs.push(w)
      }
      return if changed { mkObjTy(ty.objFieldNames, fs) } else { t }
    }
    TyFunc => {
      return t
    }
    TyMap => {
      return t
    }
    TyVar => {
      return t
    }
    TyLit => {
      return t
    }
    TyNeg => {
      return t
    }
  }
}

// Instance `k`'s elaboration, spelled without its parent: the bindings of the type variables its
// declaration reads, each once and with union members in sorted order. Two instances it agrees
// on check alike.
export function elabInstSpelling(k: i32): string {
  if k < 0 || k >= ekDecl.length { return "" }
  const decl = ekDecl[k]
  const names: string[] = []
  const tys: i32[] = []
  let i = 0
  while i < ekNames[k].length && i < ekTys[k].length {
    const nm = ekNames[k][i]
    let has = false
    for x in names {
      if x == nm { has = true }
    }
    if !has && elabDeclReads(decl, nm) {
      names.push(nm)
      tys.push(ekTys[k][i])
    }
    i = i + 1
  }
  let r = i32ToStr(decl) + "|"
  for o in elabNameOrder(names) {
    r = r + names[o] + "=" + elabBindStr(tys[o], true) + ";"
  }
  r
}

// The indices of `names` in sorted order.
function elabNameOrder(names: string[]): i32[] {
  const ord: i32[] = []
  let i = 0
  while i < names.length {
    let j = ord.length
    ord.push(i)
    while j > 0 && names[ord[j - 1]] > names[i] {
      ord[j] = ord[j - 1]
      j = j - 1
    }
    ord[j] = i
    i = i + 1
  }
  ord
}

// `elabDeclReads` by `decl|name`, for one elaboration run.
let elabReadsMemo: {[string]: boolean} = Map()

// Whether declaration `decl` reads type variable `name`: its own, its signature's, or one a node
// type or a call's bind row in its subtree names, nested declarations included.
function elabDeclReads(decl: i32, name: string): boolean {
  if elabOwnName(decl, name) || elabSigReads(decl, name) { return true }
  const key = i32ToStr(decl) + "|" + name
  const have = elabReadsMemo.get(key)
  if have != null { return have }
  const r = elabSubtreeReads(decl, name)
  elabReadsMemo[key] = r
  r
}

// Whether a node in the subtree at `ix` has a type, or a bind row, naming type variable `name`.
function elabSubtreeReads(ix: i32, name: string): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  let cur = ix
  while cur >= 0 {
    if tyMentionsTyVarNamed(nodeTyIxOf(cur), name, 16) { return true }
    const row = callBindRowOf(cur)
    if row >= 0 {
      for t in callBindTysAt(row) {
        if tyMentionsTyVarNamed(t, name, 16) { return true }
      }
    }
    for kid in nodeSpineChildren(cur) {
      if elabSubtreeReads(kid, name) { return true }
    }
    cur = elseIfLink(cur)
  }
  false
}

// Emitted function slot → the instance it is, or -2 for one no demand keyed.
let elabSlotKeys: {[i32]: i32} = Map()

export function elabSlotNote(pos: i32, k: i32) {
  elabSlotKeys[pos] = if k >= 0 { k } else { 0 - 2 }
  0
}

// The top-level function whose instance `k` is, or encloses it: a lambda's instance answers its
// nearest enclosing instance's; "" when none is one.
function elabOwnerOf(k: i32): string {
  let kk = k
  let hops = 0
  while kk >= 0 && kk < ekDecl.length && hops < 32 {
    const o = topFnOwnerOf(ekDecl[kk])
    if o != "" { return o }
    kk = if kk < ekParent.length { ekParent[kk] } else { -1 }
    hops = hops + 1
  }
  ""
}

// Checks instance `k`'s body once, recording each node's type.
// Binding `names` with each name kept at its first entry, the one `bindOf` reads: a nested
// generic redeclaring its parent's `T` binds its own first, and a scope that reads the last
// pushed name would otherwise take the parent's.
function elabNamesFirst(names: string[]): string[] {
  const out: string[] = []
  for nm in names {
    if !strListHas(out, nm) { out.push(nm) }
  }
  out
}

// The types of `elabNamesFirst(names)`, in its order.
function elabTysFirst(names: string[], tys: i32[]): i32[] {
  const seen: string[] = []
  const out: i32[] = []
  let i = 0
  while i < names.length && i < tys.length {
    if !strListHas(seen, names[i]) {
      seen.push(names[i])
      out.push(tys[i])
    }
    i = i + 1
  }
  out
}

// Walks key `k`, with `k` the key every hole row its walk banks records.
function elabOne(k: i32) {
  const was = elabWalkNowSet(k)
  const r = elabOneAt(k)
  elabWalkNowSet(was)
  r
}

function elabOneAt(k: i32) {
  const decl = ekDecl[k]
  ekDone[k] = true
  const dn = nodeAt(decl)
  if !(dn is FuncDecl) { return 0 }
  const names = ekNames[k]
  const tys = ekTys[k]
  const pTys: i32[] = []
  for p in dn.fnParams {
    const pn = nodeAt(p)
    let pt = nodeTyIxOf(p)
    if pn is Param {
      if pt < 0 && pn.parType >= 0 { pt = nodeTyIxOf(pn.parType) }
    }
    if pt >= 0 { pt = substTyDeep(pt, names, tys) }
    pTys.push(pt)
  }
  let ret = TY_ERR
  const ft = nodeTyIxOf(decl)
  if ft >= 0 && ft < T.tys.length {
    const f = tyAt(ft)
    if f is TyFunc {
      const r = substTyDeep(f.fnRet, names, tys)
      if r >= 0 && !tyHasTyVar(r) { ret = r }
    }
  }
  const savedRet = T.curRet
  const savedFn = curFnDeclIx
  const savedNj = njFnIx
  // An inferred result is the body's own join, so only a written one is checked against.
  T.curRet = if dn.fnRet >= 0 { ret } else { TY_ERR }
  curFnDeclIx = decl
  cstrOwnerStack.push(decl)
  // A nested declaration's free names resolve against what its enclosing instance saw.
  let snap = -1
  if elabEncl.has(decl) {
    snap = elabSnapIx.get(elabSnapKey(ekParent[k], decl)) ?? -1
    // A parent whose capture never reached it leaves the template's own view.
    if snap < 0 { snap = elabSnapIx.get(elabSnapKey(-1, decl)) ?? -1 }
  }
  if snap >= 0 {
    pushScope(-1)
    elabSnapDeclare(snap)
  }
  const savedKey = elabCapKey
  elabCapKeySet(k)
  elabCapBegin(quietDepth + 1)
  const cbm = cbExpMark()
  const em = checkMark()
  const ed0 = T.diags.length
  const sv = monoRecheckBegin(
    decl,
    pTys,
    elabNamesFirst(names),
    elabTysFirst(names, tys),
  )
  // The instance's return literals, and the generic functions it returns, are built at its closed
  // result type.
  if sv != null && ret != TY_ERR {
    adoptRetLits(dn, ret)
    fvaRetRowsNote(dn.fnBody, ret)
  }
  elabCapEnd()
  if elabGuessKeys[k] ?? false { elabCapDeadDiagsSet(T.diags.length - ed0) }
  // A diagnostic the re-check raises outside a dead arm, in an instance the program needs, is the
  // program's error: the first one is kept past the rollback for check to report.
  // An instance at a set's rep, or at one signature of the generic it holds, is a representation
  // mono builds, as is every instance it makes; the set-keyed instance answers for the program.
  if (
    T.diags.length - ed0 > elabCapDeadDiags
    && !(elabReprKeys[k] ?? false)
    && !(elabCandKeys[k] ?? false)
  ) {
    elabErrorNote(T.diags[ed0])
  }
  if sv != null { monoRecheckEnd(sv) }
  checkRollback(em, RB_ALL)
  cbExpTruncate(cbm)
  elabCapKeySet(savedKey)
  if snap >= 0 { popScope() }
  cstrOwnerStack.pop()
  curFnDeclIx = savedFn
  njFnIxSet(savedNj)
  T.curRet = savedRet
  // Bank the body's types under `k`.
  for ix in elabCapTy.keys() {
    if ix >= elabGenTy.length { continue }
    const ps = elabNodeTys[ix] ?? []
    ps.push(k)
    ps.push(elabCapTy[ix] ?? -1)
    elabNodeTys[ix] = ps
  }
  // A stamp that only repeats the literal's own anonymous type there names no destination: not
  // banked; a named or generic-application record is a row of its own.
  for ix in elabCapRep.keys() {
    const rt = elabCapRep[ix] ?? -1
    const own = elabCapTy[ix] ?? -1
    if (
      rt < 0
      || (own >= 0
        && tyEq(rt, own)
        && structNameOfTy(rt) == ""
        && genAppRowOf(rt) < 0)
    ) {
      continue
    }
    const rs = elabNodeReps[ix] ?? []
    rs.push(k)
    rs.push(rt)
    elabNodeReps[ix] = rs
  }
  for ix in elabCapCtx.keys() {
    const cs = elabNodeCtxs[ix] ?? []
    cs.push(k)
    cs.push(elabCapCtx[ix] ?? -1)
    elabNodeCtxs[ix] = cs
  }
  for ix in elabCapBox.keys() {
    const bs = elabNodeBoxs[ix] ?? []
    bs.push(k)
    bs.push(elabCapBox[ix] ?? -1)
    elabNodeBoxs[ix] = bs
  }
  for ix in elabCapRepUnion.keys() {
    const us = elabNodeRepUnions[ix] ?? []
    us.push(k)
    us.push(elabCapRepUnion[ix] ?? -1)
    elabNodeRepUnions[ix] = us
  }
  for ix in elabCapNarrowed.keys() {
    const st = elabCapNarrowed[ix] ?? -1
    if st < 0 { continue }
    const ns = elabNodeNarrowed[ix] ?? []
    ns.push(k)
    ns.push(st)
    elabNodeNarrowed[ix] = ns
  }
  for ix in elabCapDeadIx.keys() {
    const ds = elabDeadKs[ix] ?? []
    ds.push(k)
    elabDeadKs[ix] = ds
  }
  // The body's closed calls are instances too.
  let c = 0
  while c < elabCallIx.length {
    const cn: string[] = []
    const ct0: i32[] = []
    if !elabSelfRow(k, elabCallIx[c], elabCallD[c], cn, ct0) {
      for x in elabCallN[c] { cn.push(x) }
      for x in elabCallT[c] { ct0.push(x) }
    }
    // An instance's call binds a tagged set or a primed stub as a root call does.
    const ct = elabSetArgBind(elabCallIx[c], cn, ct0)
    if tysClosed(ct) {
      elabRowEntries(elabCallIx[c], elabCallD[c], cn, ct)
      elabReachNote(k, elabEnqueue(elabCallD[c], cn, ct, k), elabCallIx[c])
      elabArgRows(elabCallIx[c], elabCallD[c], cn, ct, k)
    }
    const cx = nodeAt(elabCallIx[c])
    if cx is Call {
      const cft = elabCapTy[cx.callFn] ?? nodeTyIxOf(cx.callFn)
      elabSetCallRows(elabCallIx[c], elabCallN[c], elabCallT[c], k, cft)
    }
    c = c + 1
  }
  let b = 0
  while b < elabCbD.length {
    if tysClosed(elabCbT[b]) {
      const cbk = elabEnqueue(elabCbD[b], elabCbN[b], elabCbT[b], k)
      elabValueKeyNote(elabCbD[b], k, cbk)
      elabReachNote(k, cbk, -1)
    }
    b = b + 1
  }
  0
}

// The functions the parameter `x` reads holds in instance `k`: what its argument holds at each
// call that reached `k`; [-1] when one of those arguments is not known to hold only functions.
function elabParamArgTargets(k: i32, x: i32): i32[] {
  const d = identDeclOf(parenPeelIx(x))
  if k < 0 || k >= ekDecl.length || d < 0 { return [-1] }
  const f = nodeAt(ekDecl[k])
  if !(f is FuncDecl) { return [-1] }
  const pi = i32ListIndexOf(f.fnParams, d)
  // An instance at a set's rep is reached by the calls whose rows it reps.
  let cs = elabKeyCalls[k] ?? []
  if cs.length == 0 { cs = elabRepRowCalls[k] ?? [] }
  if pi < 0 || cs.length == 0 { return [-1] }
  const out: i32[] = []
  for c in cs {
    const cn = nodeAt(c)
    if !(cn is Call) || pi >= cn.callArgs.length { return [-1] }
    const a = cn.callArgs[pi]
    if elabOpenParamRead(a) { return [-1] }
    // A type parameter several arguments share is bound to their joined set, whose every member
    // the parameter may hold.
    const js = fnTagSharedJoinSet(f, pi, cn.callArgs)
    const ts = if js >= 0 { fnTagMembers(js) } else { elabCalleeTargets(a) }
    if ts.length == 0 { return [-1] }
    for t in ts {
      if !i32ListHas(out, t) { out.push(t) }
    }
  }
  out
}

// Whether `x` reads a parameter whose declared or inferred type still holds a type variable.
function elabOpenParamRead(x: i32): boolean {
  const p = parenPeelIx(x)
  if p < 0 || p >= P.nodes.length || !(nodeAt(p) is Ident) { return false }
  const d = identDeclOf(p)
  if d < 0 || d >= P.nodes.length || !(nodeAt(d) is Param) { return false }
  const t = nodeTyIxOf(d)
  t >= 0 && t < T.tys.length && tyHasTyVar(t)
}

// Whether node `d` is a function declaration with no type parameters of its own.
function elabIsHoleFn(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const f = nodeAt(d)
  f is FuncDecl && f.fnTyParams.length == 0
}

// Enqueues under `from` each function the callee of call `ix` (of type `calleeTy`, or its node's
// type for -1) may hold, bound by its signature against the call's parameter types at
// `names`/`tys`: a call through two or more functions reaches every one. A function with
// nothing to bind is no instance.
function elabSetCallRows(
  ix: i32,
  names: string[],
  tys: i32[],
  from: i32,
  calleeTy: i32,
) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const cn = nodeAt(ix)
  if !(cn is Call) { return 0 }
  // A call through an open parameter runs what each instance binds it to: the functions the
  // instance's own type of it names, when it names any, and nothing at the root.
  const openParam = elabOpenParamRead(cn.callFn)
  if from < 0 && openParam { return 0 }
  const ct = if calleeTy >= 0 { calleeTy } else { nodeTyIxOf(cn.callFn) }
  if ct < 0 || ct >= T.tys.length { return 0 }
  // A call through a literal list's constant element that is a hole function runs that element
  // alone (D10893); a declared generic element is instanced at every call, as mono builds it.
  const el = constListFnElemDecl(cn.callFn)
  let all = if elabIsHoleFn(el) { [el] } else { elabCalleeTargets(cn.callFn) }
  if openParam {
    let own = elabParamArgTargets(from, cn.callFn)
    if own.length > 0 && own[0] < 0 { own = elabFnSetOf(ct) }
    if own.length > 0 && own[0] >= 0 { all = own }
    // An instance no call reaches that types the parameter at a closed function type with no set
    // (a set's rep) calls through that value; its members' instances come from the calls that
    // hand them over.
    if (
      (own.length == 0 || own[0] < 0)
      && (elabKeyCalls[from] ?? []).length == 0
      && (elabRepRowCalls[from] ?? []).length == 0
      && elabTyClosed(ct, 0)
    ) {
      return 0
    }
  }
  // A call through a value has no row of its own: each generic declaration it may hold is
  // instanced at its types, a lambda keeping the instance its own context types.
  const byValue = elabCallDeclOf(ix) < 0
  if all.length < 2 && !byValue { return 0 }
  const ms: i32[] = []
  for m in all {
    const mn = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { cn }
    if !byValue || all.length >= 2 || (mn is FuncDecl && mn.fnName != "") {
      ms.push(m)
    }
  }
  if ms.length < 1 { return 0 }
  const cf = tyAt(ct)
  if !(cf is TyFunc) { return 0 }
  const pts: i32[] = []
  // Substituting names the callee's holes; a probe pins none of them, as `elabParamsClosed`'s.
  const held = holePinHeldSet(true)
  for pt in cf.fnParamTypes { pts.push(substTyDeep(pt, names, tys)) }
  holePinHeldSet(held)
  for st in pts {
    if st < 0 || !elabTyClosed(st, 0) && !elabSetBinding(st) { return 0 }
  }
  // Inside an instance, each member of a set binds at the arguments' own types, not at the
  // set's one signature, which another member's parameters may have fixed.
  if from >= 0 && ms.length >= 2 && cn.callArgs.length == pts.length {
    let i = 0
    while i < pts.length {
      const a = cn.callArgs[i]
      const at = if a >= 0 { elabCapTy[a] ?? -1 } else { -1 }
      if at >= 0 && elabTyClosed(at, 0) { pts[i] = at }
      i = i + 1
    }
  }
  for m in ms {
    const sig = if m >= 0 && m < P.nodes.length { nodeTyIxOf(m) } else { -1 }
    if sig < 0 || sig >= T.tys.length { continue }
    const sf = tyAt(sig)
    if !(sf is TyFunc) || sf.fnParamTypes.length != pts.length { continue }
    const mn: string[] = []
    const mt: i32[] = []
    let i = 0
    while i < pts.length {
      bindGenWalk(sf.fnParamTypes[i], pts[i], mn, mt)
      i = i + 1
    }
    if mn.length > 0 {
      const mk = elabEnqueue(m, mn, mt, from)
      elabReachNote(from, mk, -1)
      elabValCallNote(from, ix, mk)
      elabArgRows(ix, m, mn, mt, from)
    }
    if from >= 0 && elabArmTakesSet(ix, m) { elabArmAt(ix, m, from, pts) }
  }
  0
}

// Whether call `ix` of `d` is through a set whose arm hands `d` a set of functions, which is
// instanced at each arm alone rather than at the call's row.
function elabRowByArms(ix: i32, d: i32): boolean {
  const rc = nodeAt(ix)
  rc is Call
    && identDeclOf(parenPeelIx(rc.callFn)) != d
    && elabArmTakesSet(ix, d)
}

// Whether call `ix` through a tagged set has an arm handing member `m` a set of functions,
// which is instanced at the set instead of at the call's one signature.
function elabArmTakesSet(ix: i32, m: i32): boolean {
  for a in fnTagCallArms(ix) {
    const an = nodeAt(a)
    if an is Call && identDeclOf(an.callFn) == m && elabArmHandsSet(a, m) {
      return true
    }
  }
  false
}

// Demands under instance `from` member `m`'s instance for each arm of call `ix` calling it, at
// argument types `pts` there, a parameter handed a tagged set taking the set.
function elabArmAt(ix: i32, m: i32, from: i32, pts: i32[]) {
  for a in fnTagCallArms(ix) {
    const an = nodeAt(a)
    if (
      an is Call
      && identDeclOf(an.callFn) == m
      && an.callArgs.length == pts.length
    ) {
      const pTys: i32[] = []
      let i = 0
      while i < pts.length {
        const setTy = elabCallArgSetTy(a, m, i, from)
        pTys.push(if setTy >= 0 { setTy } else { widenLitTy(pts[i]) })
        i = i + 1
      }
      if tysClosed(pTys) {
        const none: string[] = []
        const noTys: i32[] = []
        elabSigAlting = elabRowAtSetRep(a, m)
        const k = elabDemandFrom(m, none, noTys, pTys, from, a)
        elabSigAlting = false
        elabReachNote(from, k, a)
      }
    }
  }
  0
}

// Enqueues under `from` the instance of each generic function an argument of call `ix` (to `d`,
// bound at `names`/`tys`) holds, at its parameter's type under that binding: a function value
// handed to a function-typed parameter, or the elements of a list literal handed to a list of
// them.
function elabArgRows(ix: i32, d: i32, names: string[], tys: i32[], from: i32) {
  if ix < 0 || ix >= P.nodes.length || d < 0 || d >= P.nodes.length { return 0 }
  const cn = nodeAt(ix)
  const sig = nodeTyIxOf(d)
  if !(cn is Call) || sig < 0 || sig >= T.tys.length { return 0 }
  const f = tyAt(sig)
  if !(f is TyFunc) || f.fnParamTypes.length != cn.callArgs.length { return 0 }
  let i = 0
  while i < cn.callArgs.length {
    // Substituting names the callee's holes; a probe pins none of them, as `elabParamsClosed`'s.
    const held = holePinHeldSet(true)
    const dt = substTyDeep(f.fnParamTypes[i], names, tys)
    holePinHeldSet(held)
    if dt >= 0 && dt < T.tys.length && elabTyClosed(dt, 0) {
      elabArgValueRows(cn.callArgs[i], dt, from)
    }
    i = i + 1
  }
  0
}

// `elabArgRows` for one argument `a` delivered at closed type `dt`.
function elabArgValueRows(a: i32, dt: i32, from: i32) {
  const p = parenPeelIx(a)
  if p < 0 || p >= P.nodes.length { return 0 }
  const d = tyAt(dt)
  const pn = nodeAt(p)
  if pn is ArrayLit {
    if d is TyArray {
      for e in pn.arrElems { elabArgValueRows(e, d.aElem, from) }
    }
    return 0
  }
  if !(d is TyFunc) { return 0 }
  for m in elabCalleeTargets(p) {
    const ms = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { pn }
    const sig = if m >= 0 && m < P.nodes.length { nodeTyIxOf(m) } else { -1 }
    // A hole function binds its parameter holes as a generic binds its type parameters.
    if (
      ms is FuncDecl
      && (ms.fnTyParams.length > 0 || elabIsHoleFn(m))
      && sig >= 0
      && sig < T.tys.length
    ) {
      const sf = tyAt(sig)
      if sf is TyFunc && sf.fnParamTypes.length == d.fnParamTypes.length {
        const mn: string[] = []
        const mt: i32[] = []
        let j = 0
        while j < sf.fnParamTypes.length {
          bindGenWalk(sf.fnParamTypes[j], d.fnParamTypes[j], mn, mt)
          j = j + 1
        }
        if mn.length > 0 {
          const vk = elabEnqueue(m, mn, mt, from)
          elabValueKeyNote(p, from, vk)
          elabReachNote(from, vk, -1)
        }
      }
    }
  }
  0
}

// The binding of call `ix` to `d`, a declaration on instance `k`'s chain, from its arguments' types
// at `k`, into `names`/`tys`: the checker's row read `d`'s own type variables through `k`'s
// binding of them. False, binding none, for any other callee or an argument list it cannot pair.
function elabSelfRow(
  k: i32,
  ix: i32,
  d: i32,
  names: string[],
  tys: i32[],
): boolean {
  let a = k
  let on = false
  while a >= 0 && !on {
    on = ekDecl[a] == d
    a = ekParent[a]
  }
  if !on { return false }
  const cn = nodeAt(ix)
  const dn = nodeAt(d)
  if (
    !(cn is Call)
    || !(dn is FuncDecl)
    || cn.callArgs.length != dn.fnParams.length
  ) {
    return false
  }
  let p = 0
  while p < cn.callArgs.length {
    const at = elabCapTy[cn.callArgs[p]] ?? -1
    if at < 0 { return false }
    bindGenWalk(nodeTyIxOf(dn.fnParams[p]), at, names, tys)
    p = p + 1
  }
  true
}

// The functions some set of functions holds beside another member, less those only tagged sets
// hold, read once per `elabMintFacts`.
let elabMintValueFns: i32[] = []

// Replaces the mint facts with one per call each instance makes through a parameter it binds to
// a function set: the set, the call's argument types and each member's result there, so the tag
// decision sees every call an instance makes. The number of facts noted.
export function elabMintFacts(): i32 {
  mintReset()
  for pe in elabPerEnclDecls.keys() { mintNestedPerEnclNote(pe) }
  elabHandBackMemo = Map()
  elabMintValueFns = elabFnSetMembersUntagged()
  elabMintCalls = Map()
  elabBundleSigs = Map()
  elabBundleJoinRoot = Map()
  elabHandMembers = Map()
  elabHandOwners = Map()
  elabLamSigs = Map()
  elabLamSigInst = Map()
  elabMintSets = Map()
  elabCallInstSets = Map()
  let n = 0
  let k = 0
  while k < ekDecl.length {
    const dn = nodeAt(ekDecl[k])
    if dn is FuncDecl && dn.fnBody >= 0 && !(elabCandKeys[k] ?? false) {
      const sc = mintScopeAt(
        ekDecl[k],
        elabInstSpelling(k),
        ekNames[k],
        ekTys[k],
      )
      // The set each hole parameter a copy lists holds at this instance, for the decision to try.
      for pd in dn.fnParams {
        const pn = nodeAt(pd)
        if pn is Param && pn.parType < 0 && ftParamListCopied(dn, pd) {
          n = n + 1
          mintParamHeldNote(
            fnTagSetOfTy(substTyDeep(nodeTyIxOf(pd), ekNames[k], ekTys[k])),
          )
        }
      }
      // The hand-back first: the reads below ask it.
      n = n + elabMintRetFact(k)
      n = n + elabMintFactsIn(dn.fnBody, ekDecl[k], k, sc)
    }
    k = k + 1
  }
  elabBundleForwardsJoin()
  // A set one instance calls through a parameter that another instance of the same function
  // binds to no set has no one rep there, so it is partial.
  for c in elabMintCalls.keys() {
    const at = elabMintCalls[c] ?? []
    const d = if at.length > 0 { ekDecl[at[0]] } else { -1 }
    let all = d >= 0
    let kk = 0
    while all && kk < ekDecl.length {
      if (
        ekDecl[kk] == d
        && !i32ListHas(at, kk)
        && !(elabGuessKeys[kk] ?? false)
        && !(elabCbRepKeys[kk] ?? false)
        && !(elabSigAltKeys[kk] ?? false)
        && !elabKeyUncalled(kk)
        && !elabKeyCallsHandSet(kk, c, d)
        && !elabKeyCallsHandClosure(kk, c, d)
        && !elabKeyCallsHandSetValue(kk, c, d)
      ) {
        all = false
      }
      kk = kk + 1
    }
    if !all { mintSetPartialNote(elabMintSets[c] ?? -1) }
  }
  // A delivery to a closed function type is a fact the decision reads too.
  n + mintCloRows()
}

// Whether instance `k` is reached by no call, as a checker pin a later decision outdated is.
function elabKeyUncalled(k: i32): boolean {
  (elabKeyCalls[k] ?? []).length == 0 && (elabRepRowCalls[k] ?? []).length == 0
}

// Whether instance `k` is a guess, a callback rep or a signature alternative.
function elabKeySpeculative(k: i32): boolean {
  (elabGuessKeys[k] ?? false)
    || (elabCbRepKeys[k] ?? false)
    || (elabSigAltKeys[k] ?? false)
}

// Whether every call reaching instance `k` names the function `d` itself and hands, at the
// parameter `c` calls through, a member of `c`'s set by name: the set's decision re-keys that pin
// to the set, so it binds the parameter to no other set (G2e).
function elabKeyCallsHandSet(k: i32, c: i32, d: i32): boolean {
  const cs = elabKeyCalls[k] ?? []
  if cs.length == 0 || (elabRepRowCalls[k] ?? []).length > 0 { return false }
  const dn = nodeAt(d)
  const cn = nodeAt(c)
  if !(dn is FuncDecl) || dn.fnName == "" || !(cn is Call) { return false }
  const pi = i32ListIndexOf(dn.fnParams, identDeclOf(parenPeelIx(cn.callFn)))
  const ms = fnTagMembers(elabMintSets[c] ?? -1)
  if pi < 0 || ms.length == 0 { return false }
  for x in cs {
    const xn = nodeAt(x)
    if !(xn is Call) || pi >= xn.callArgs.length { return false }
    if elabCalleeNamesDecl(xn.callFn) != d { return false }
    const a = parenPeelIx(xn.callArgs[pi])
    if a < 0 || !(nodeAt(a) is Ident) || !i32ListHas(ms, identDeclOf(a)) {
      return false
    }
  }
  true
}

// Whether every call reaching instance `k` names the function `d` itself and hands, at the
// parameter `c` calls through, a value the reaching instance types as `c`'s set: `k` is that
// call's instance at the set's rep, which a tagged set's direct call does not build.
function elabKeyCallsHandSetValue(k: i32, c: i32, d: i32): boolean {
  const cn = nodeAt(c)
  if !(cn is Call) { return false }
  const dn = nodeAt(d)
  if !(dn is FuncDecl) { return false }
  const pi = i32ListIndexOf(dn.fnParams, identDeclOf(parenPeelIx(cn.callFn)))
  elabReachHandsSet(k, d, pi, elabMintSets[c] ?? -1, 0)
}

// Whether every call reaching instance `k` of `d` hands, at parameter `pi`, a value its reaching
// instance types as set `s`, or a read of that instance's own parameter every call reaching it
// hands the set at in turn: a closure-keyed instance on a chain the set entered (D15400).
function elabReachHandsSet(
  k: i32,
  d: i32,
  pi: i32,
  s: i32,
  depth: i32,
): boolean {
  const cs = elabKeyCalls[k] ?? []
  if cs.length == 0 || (elabRepRowCalls[k] ?? []).length > 0 { return false }
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || dn.fnName == "" || pi < 0 || s < 0 || depth > 8 {
    return false
  }
  for x in cs {
    const xn = nodeAt(x)
    if !(xn is Call) || pi >= xn.callArgs.length { return false }
    if elabCalleeNamesDecl(xn.callFn) != d { return false }
    const ks = elabCallKeys[x] ?? []
    let j = 0
    while j + 1 < ks.length {
      // A reach from a speculative instance is that instance's own guess, not this call's value.
      if ks[j + 1] == k && !(ks[j] >= 0 && elabKeySpeculative(ks[j])) {
        // A reach from module scope types the value as the template does.
        const ax = xn.callArgs[pi]
        const at = if ks[j] < 0 { nodeTyIxOf(ax) } else { elabNodeTy(ax, ks[j]) }
        if (
          fnTagSetOfTy(at) != s
          && !elabReachParamHandsSet(ks[j], ax, s, depth)
        ) {
          return false
        }
      }
      j = j + 2
    }
  }
  true
}

// Whether argument `ax`, read in instance `from`, is a parameter of `from`'s declaration that
// every call reaching `from` hands set `s` at (`elabReachHandsSet`).
function elabReachParamHandsSet(
  from: i32,
  ax: i32,
  s: i32,
  depth: i32,
): boolean {
  if from < 0 { return false }
  const a = parenPeelIx(ax)
  if a < 0 || a >= P.nodes.length || !(nodeAt(a) is Ident) { return false }
  const fd = ekDecl[from]
  const fn = nodeAt(fd)
  if !(fn is FuncDecl) { return false }
  const q = i32ListIndexOf(fn.fnParams, identDeclOf(a))
  q >= 0 && elabReachHandsSet(from, fd, q, s, depth + 1)
}

// Whether every call reaching instance `k` hands, at the parameter of `d` that call `c` calls
// through, a read of a parameter written with a closed function type: a closure no set's id
// reaches, so `k` is an instance of its own apart from the ones binding the set.
function elabKeyCallsHandClosure(k: i32, c: i32, d: i32): boolean {
  const cs = elabKeyCalls[k] ?? []
  if cs.length == 0 || (elabRepRowCalls[k] ?? []).length > 0 { return false }
  const dn = nodeAt(d)
  const cn = nodeAt(c)
  if !(dn is FuncDecl) || !(cn is Call) { return false }
  const pi = i32ListIndexOf(dn.fnParams, identDeclOf(parenPeelIx(cn.callFn)))
  if pi < 0 { return false }
  for x in cs {
    const xn = nodeAt(x)
    if !(xn is Call) || pi >= xn.callArgs.length { return false }
    if pi < xn.callArgNames.length && xn.callArgNames[pi] != "" { return false }
    const a = parenPeelIx(xn.callArgs[pi])
    if a < 0 || !(nodeAt(a) is Ident) { return false }
    const pd = identDeclOf(a)
    if pd < 0 || pd >= P.nodes.length { return false }
    const pn = nodeAt(pd)
    if !(pn is Param) || pn.parType < 0 { return false }
    const t = nodeTyIxOf(pd)
    if t < 0 || t >= T.tys.length || !(tyAt(t) is TyFunc) { return false }
    if !elabTyClosed(t, 0) || fnTagSetOfTy(t) >= 0 { return false }
  }
  true
}

// The declaration callee `f` names: directly, or through one `const` binding of its name; else -1.
function elabCalleeNamesDecl(f: i32): i32 {
  const x = parenPeelIx(f)
  if x < 0 || !(nodeAt(x) is Ident) { return -1 }
  const dx = identDeclOf(x)
  if dx < 0 || dx >= P.nodes.length { return -1 }
  const dn = nodeAt(dx)
  if dn is FuncDecl { return dx }
  if !(dn is LetDecl) || dn.letKw != "const" || dn.letInit < 0 { return -1 }
  const y = parenPeelIx(dn.letInit)
  if y < 0 || !(nodeAt(y) is Ident) { return -1 }
  const dy = identDeclOf(y)
  if dy >= 0 && dy < P.nodes.length && nodeAt(dy) is FuncDecl { dy } else { -1 }
}

// Notes instance `k`'s hand-back: every value its function returns reads one parameter, which
// the instance binds to a function, so a call's value is that argument's. 1 when noted.
function elabMintRetFact(k: i32): i32 {
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || dn.fnBody < 0 { return 0 }
  const one = elabHandBackIx(ekDecl[k], dn)
  // Or each of several parameters one bare type parameter annotates, every value it returns
  // reading one of them: the call's value is one argument's, of the set they share (D15461).
  const ats = if one >= 0 { [one] } else { elabHandBackShared(ekDecl[k], dn) }
  let noted = 0
  for at in ats {
    let pt = elabTyIn(dn.fnParams[at], k)
    if pt < 0 { pt = elabParamBoundTy(dn.fnParams[at], k) }
    if pt >= 0 && pt < T.tys.length && tyAt(pt) is TyFunc {
      noted = noted + mintRetNote(ekDecl[k], at)
    }
  }
  if noted > 0 { 1 } else { 0 }
}

// The parameters of `dn` (declared at `decl`) every value it returns reads, when there are two or
// more, one bare type parameter annotates each, and each is read nowhere but as a returned value;
// [] otherwise.
function elabHandBackShared(decl: i32, dn: FuncDecl): i32[] {
  const none: i32[] = []
  if decl < 0 { return none }
  const vs: i32[] = []
  collectRetValues(dn.fnBody, vs)
  const ats: i32[] = []
  let tp = ""
  for v in vs {
    const x = parenPeelIx(v)
    if x < 0 || !(nodeAt(x) is Ident) { return none }
    const i = i32ListIndexOf(dn.fnParams, identDeclOf(x))
    if i < 0 { return none }
    const pn = nodeAt(dn.fnParams[i])
    const tn = if pn is Param && pn.parType >= 0 { nodeAt(pn.parType) } else { null }
    if !(tn is TypeRef) || !strListHas(dn.fnTyParams, tn.tyName) { return none }
    if tp != "" && tn.tyName != tp { return none }
    tp = tn.tyName
    if !i32ListHas(ats, i) { ats.push(i) }
  }
  if ats.length < 2 { return none }
  for i in ats {
    if !elabParamOnlyReturned(dn, dn.fnParams[i], vs) { return none }
  }
  ats
}

// Whether read `ix` is a value function `decl` returns, and `decl` hands back parameter `i`.
function elabRetHandsBack(decl: i32, ix: i32, i: i32): boolean {
  if !i32ListHas(mintRetParamsOf(decl), i) { return false }
  const dn = nodeAt(decl)
  if !(dn is FuncDecl) || dn.fnBody < 0 { return false }
  const vs: i32[] = []
  collectRetValues(dn.fnBody, vs)
  const rets: i32[] = []
  for v in vs {
    if parenPeelIx(v) == ix { return true }
    rets.push(parenPeelIx(v))
  }
  // So is the seed of a returned copy of the parameter (`elabCopySeedsNote`).
  for r in rets.slice(0) {
    if r >= 0 && nodeAt(r) is Ident {
      const cd = identDeclOf(r)
      if cd >= 0 && fnTagParamCopyOf(dn, cd) == dn.fnParams[i] {
        elabCopySeedsNote(cd, rets)
      }
    }
  }
  i32ListHas(rets, ix)
}

// Each declared function → the parameter every value it returns reads, else -1; a property of
// the body, so one walk per function serves all its instances.
let elabHandBackMemo: {[i32]: i32} = Map()

// The un-annotated parameter `dn` (declared at `decl`) hands back: its own (`elabHandBackIx`), or
// the one every returned value reads through a call of a declared function handing back that
// argument (`fw2(f) { return fw(f) }`); -1 otherwise.
function elabHoleHandBackIx(decl: i32, dn: FuncDecl, depth: i32): i32 {
  const own = elabHandBackIx(decl, dn)
  if own >= 0 || depth > 8 { return own }
  const vs: i32[] = []
  collectRetValues(dn.fnBody, vs)
  let at = -1
  for v in vs {
    const x = parenPeelIx(v)
    const cn = if x >= 0 { nodeAt(x) } else { nodeAt(0) }
    if !(cn is Call) { return -1 }
    const g = identFnDeclOf(parenPeelIx(cn.callFn))
    const gn = if g >= 0 && g < P.nodes.length { nodeAt(g) } else { nodeAt(0) }
    if !(gn is FuncDecl) { return -1 }
    const j = elabHoleHandBackIx(g, gn, depth + 1)
    if j < 0 || j >= cn.callArgs.length { return -1 }
    if j < cn.callArgNames.length && cn.callArgNames[j] != "" { return -1 }
    const ad = parenPeelIx(cn.callArgs[j])
    const i = if ad >= 0 && nodeAt(ad) is Ident { i32ListIndexOf(dn.fnParams, identDeclOf(ad)) } else { -1 }
    if i < 0 || at >= 0 && i != at { return -1 }
    at = i
  }
  if at < 0 { return -1 }
  const pn = nodeAt(dn.fnParams[at])
  if (
    !(pn is Param)
    || pn.parType >= 0
    || !elabParamOnlyReturned(dn, dn.fnParams[at], vs)
  ) {
    return -1
  }
  at
}

function elabHandBackIx(decl: i32, dn: FuncDecl): i32 {
  const had = elabHandBackMemo[decl] ?? -2
  if had > -2 { return had }
  let at = -1
  const vs: i32[] = []
  collectRetValues(dn.fnBody, vs)
  for v in vs {
    const x = parenPeelIx(v)
    let i = if x >= 0 && nodeAt(x) is Ident { i32ListIndexOf(dn.fnParams, identDeclOf(x)) } else { -1 }
    // A returned `const` copy of a parameter hands that parameter back.
    if i < 0 && x >= 0 && nodeAt(x) is Ident {
      i = i32ListIndexOf(dn.fnParams, fnTagParamCopyOf(dn, identDeclOf(x)))
    }
    if i < 0 || at >= 0 && i != at {
      elabHandBackMemo[decl] = -1
      return -1
    }
    at = i
  }
  // A parameter read any other way (called, stored, handed on, captured) reaches a place that
  // holds a closure, so only a parameter whose every read is a returned value is handed back.
  if at >= 0 && !elabParamOnlyReturned(dn, dn.fnParams[at], vs) { at = -1 }
  elabHandBackMemo[decl] = at
  at
}

// Whether every read of parameter `par` in `body`, nested functions included, is one of the
// returned values `vs`.
function elabParamOnlyReturned(fn: FuncDecl, par: i32, vs: i32[]): boolean {
  const rets: i32[] = []
  for v in vs { rets.push(parenPeelIx(v)) }
  // The seed of a returned copy of `par` reads it as the returned value does.
  for r in rets.slice(0) {
    if r >= 0 && nodeAt(r) is Ident {
      const cd = identDeclOf(r)
      if (
        cd >= 0
        && fnTagParamCopyOf(fn, cd) == par
        && elabCopyOnlyReturned(fn.fnBody, cd, rets)
      ) {
        elabCopySeedsNote(cd, rets)
      }
    }
  }
  const todo: i32[] = [fn.fnBody]
  const reads: i32[] = []
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const n = nodeAt(x)
      if n is Ident && identDeclOf(x) == par && !i32ListHas(rets, x) {
        reads.push(x)
      }
      // A positional argument landing in an un-annotated parameter of a declared function is
      // bound there to the argument's own function, so it reaches no closure holder.
      if n is Call { elabHoleArgsNote(n, rets) }
      for k in nodeChildren(x) { todo.push(k) }
    }
  }
  for r in reads {
    if !i32ListHas(rets, r) { return false }
  }
  true
}

// Whether every read of binding `d` in `body` is one of `rets`.
function elabCopyOnlyReturned(body: i32, d: i32, rets: i32[]): boolean {
  const todo: i32[] = [body]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      if nodeAt(x) is Ident && identDeclOf(x) == d && !i32ListHas(rets, x) {
        return false
      }
      for k in nodeChildren(x) { todo.push(k) }
    }
  }
  true
}

// Pushes onto `out` the seed read of copy `d` and of each copy it is seeded from in turn.
function elabCopySeedsNote(d: i32, out: i32[]) {
  let x = d
  let hops = 0
  while hops < 8 && x >= 0 && x < P.nodes.length {
    hops = hops + 1
    const n = nodeAt(x)
    if !(n is LetDecl) || n.letInit < 0 { return 0 }
    const v = parenPeelIx(n.letInit)
    if v < 0 || !(nodeAt(v) is Ident) { return 0 }
    out.push(v)
    x = identDeclOf(v)
  }
  0
}

// Pushes onto `out` each positional argument of call `c` to a declared function that lands in
// one of its un-annotated parameters.
function elabHoleArgsNote(c: Call, out: i32[]) {
  const d = elabCalleeNamesDecl(c.callFn)
  if d < 0 { return 0 }
  const dn = nodeAt(d)
  if !(dn is FuncDecl) { return 0 }
  let i = 0
  while i < c.callArgs.length && i < dn.fnParams.length {
    const p = nodeAt(dn.fnParams[i])
    const named = i < c.callArgNames.length && c.callArgNames[i] != ""
    if !named && p is Param && p.parType < 0 {
      out.push(parenPeelIx(c.callArgs[i]))
    }
    i = i + 1
  }
  0
}

// The type instance `k` binds parameter `par`'s own type variable to, else -1.
function elabParamBoundTy(par: i32, k: i32): i32 {
  if k < 0 || k >= ekNames.length || k >= ekTys.length { return -1 }
  const t = nodeTyIxOf(par)
  if t < 0 || t >= T.tys.length { return -1 }
  const tv = tyAt(t)
  if !(tv is TyVar) { return -1 }
  const at = strListIndexOf(ekNames[k], tv.tvName)
  if at < 0 || at >= ekTys[k].length { return -1 }
  ekTys[k][at]
}

// The instances a list method's callback takes at its set's rep, which the members' calls never
// reach through the parameter.
let elabCbRepKeys: {[i32]: boolean} = Map()
// The instances `elabSetRepRow` makes at an untagged set's rep or per signature of the one
// generic it holds, and those they reach: a tagged set's calls reach none of them.
let elabSigAltKeys: {[i32]: boolean} = Map()
let elabSigAlting = false

// Each call `elabMintFacts` noted → the instances it noted it in, and the set it went through.
let elabMintCalls: {[i32]: i32[]} = Map()
let elabMintSets: {[i32]: i32} = Map()

// By instance and parameter (`elabBundleKey`): the closed signatures the instance calls a lambda
// through that parameter at, each once, in first-call order. Two or more, with the lambda's set
// untagged, is a bundle: one closure per signature, delivered through the one parameter.
let elabBundleSigs: {[i32]: i32[]} = Map()
// By lambda declaration and parameter (`elabBundleKey`): the closed signatures any instance of
// the lambda calls that parameter at, and the instance that noted the last of them.
let elabLamSigs: {[i32]: i32[]} = Map()
let elabLamSigInst: {[i32]: i32} = Map()

// The named function and parameter position argument `ix` of call `p` lands in, as
// `[decl, index]`, when it is a positional argument of a call by name or `const` alias to an
// un-annotated parameter, or one its own type parameter annotates alone or shared by arguments
// that bind it one set; [] otherwise.
function elabMintFwdTarget(ix: i32, p: i32): i32[] {
  const none: i32[] = []
  if p < 0 || p >= P.nodes.length { return none }
  const pn = nodeAt(p)
  if !(pn is Call) { return none }
  const d2 = elabConstCalleeDecl(parenPeelIx(pn.callFn), 8)
  if d2 < 0 || d2 >= P.nodes.length { return none }
  const f2 = nodeAt(d2)
  if !(f2 is FuncDecl) { return none }
  const j = i32ListIndexOf(pn.callArgs, ix)
  if j < 0 || j >= f2.fnParams.length { return none }
  if j < pn.callArgNames.length && pn.callArgNames[j] != "" { return none }
  const q = nodeAt(f2.fnParams[j])
  if (
    !(q is Param)
    || q.parType >= 0 && !fnTagOwnTyParamJoins(f2, j, pn.callArgs)
  ) {
    return none
  }
  [d2, j]
}

// Notes parameter `i` of `decl`, read at `ix` as a positional argument of call `p` through a
// set of functions (as instance `k` types its callee), as forwarded to every member's
// parameter there; false when `p` is no such call or set `st` is none.
function elabMintSetFwd(
  decl: i32,
  i: i32,
  ix: i32,
  p: i32,
  k: i32,
  st: i32,
): boolean {
  if st < 0 { return false }
  const to = elabSetFwdTarget(ix, p, k)
  if to.length == 0 { return false }
  let a = 1
  while a < to.length {
    mintParamFwdNote(decl, i, to[a], to[0])
    a = a + 1
  }
  true
}

// `[j, member, ...]` when `ix` is positional argument `j` of call `p` through a set of functions
// (as instance `k` types its callee) whose every member takes it un-annotated; else [].
function elabSetFwdTarget(ix: i32, p: i32, k: i32): i32[] {
  const none: i32[] = []
  if p < 0 || p >= P.nodes.length { return none }
  const pn = nodeAt(p)
  if !(pn is Call) { return none }
  const j = i32ListIndexOf(pn.callArgs, ix)
  if j < 0 || j < pn.callArgNames.length && pn.callArgNames[j] != "" {
    return none
  }
  const ms = fnTagMembers(fnTagSetOfTy(elabNodeTy(parenPeelIx(pn.callFn), k)))
  if ms.length == 0 { return none }
  const out: i32[] = [j]
  for m in ms {
    const f2 = nodeAt(m)
    if !(f2 is FuncDecl) || j >= f2.fnParams.length { return none }
    const q = nodeAt(f2.fnParams[j])
    if !(q is Param) || q.parType >= 0 { return none }
    out.push(m)
  }
  out
}

// Notes parameter `i` of `fn` (declared at `decl`), copied into binding `d`, unannotated or
// annotated with the type parameter annotating `i`, as forwarded wherever `d` is read: true only
// when every read of `d` in `fn`'s body is a positional argument of a call through a set of
// functions or of a named function's open parameter, and none sits in a nested function.
function elabAliasSetFwd(
  decl: i32,
  i: i32,
  d: i32,
  fn: FuncDecl,
  k: i32,
  st: i32,
) {
  if st < 0 || d < 0 || d >= P.nodes.length { return false }
  const ln = nodeAt(d)
  if !(ln is LetDecl) { return false }
  if ln.letType >= 0 {
    const own = elabTyParamNameOf(fn, d)
    if (
      own == ""
      || i >= fn.fnParams.length
      || !elabTyParamsAgreeAt(own, elabTyParamNameOf(fn, fn.fnParams[i]), k)
    ) {
      return false
    }
  }
  const tos: i32[][] = []
  const todo: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  const ins: boolean[] = [false]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    const inFn = ins.pop() ?? false
    if x >= 0 && x < P.nodes.length {
      if nodeAt(x) is Ident && identDeclOf(x) == d {
        // A nested function's read is one body for every instance (D14842).
        if inFn { return false }
        // An element of a `const` list literal nothing reads hands the set nowhere.
        if elabUnreadConstLit(p, fn) { continue }
        const to = elabSetFwdTarget(x, p, k)
        const named = if to.length == 0 { elabMintFwdTarget(x, p) } else { [] }
        if to.length == 0 && named.length != 2 { return false }
        tos.push(if to.length > 0 { to } else { [named[1], named[0]] })
      }
      const deeper = inFn || nodeAt(x) is FuncDecl
      for c in nodeChildren(x) {
        todo.push(c)
        par.push(x)
        ins.push(deeper)
      }
    }
  }
  if tos.length == 0 { return false }
  for to in tos {
    let a = 1
    while a < to.length {
      mintParamFwdNote(decl, i, to[a], to[0])
      a = a + 1
    }
  }
  true
}

// Whether `lit` is a list literal bound by a `const` of `fn`'s body that nothing reads but its
// `.length`, which reads no element.
function elabUnreadConstLit(lit: i32, fn: FuncDecl): boolean {
  if lit < 0 || lit >= P.nodes.length || !(nodeAt(lit) is ArrayLit) {
    return false
  }
  let d = -1
  const todo: i32[] = [fn.fnBody]
  while todo.length > 0 && d < 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if (
        xn is LetDecl
        && xn.letKw == "const"
        && parenPeelIx(xn.letInit) == lit
      ) {
        d = x
      }
      for c in nodeChildren(x) { todo.push(c) }
    }
  }
  if d < 0 { return false }
  todo.push(fn.fnBody)
  const par: i32[] = [-1]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const pn = if p >= 0 { nodeAt(p) } else { nodeAt(x) }
      const len = pn is Member && pn.memObj == x && pn.memProp == "length"
      if nodeAt(x) is Ident && identDeclOf(x) == d && !len { return false }
      for c in nodeChildren(x) {
        todo.push(c)
        par.push(x)
      }
    }
  }
  true
}

// The declaration the callee name `v` reads, through at most `depth` `const` aliases; -1 when
// it reads no declaration.
function elabConstCalleeDecl(v: i32, depth: i32): i32 {
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return -1 }
  const r = identDeclOf(v)
  if r < 0 || r >= P.nodes.length { return -1 }
  const rn = nodeAt(r)
  if rn is LetDecl && rn.letKw == "const" && rn.letInit >= 0 && depth > 0 {
    return elabConstCalleeDecl(parenPeelIx(rn.letInit), depth - 1)
  }
  r
}

// The parameter of `decl` the binding `d` reads an element of, where `d` is initialised by an
// element read of that parameter (`xs[i]`) and every read of `d` in the body, so never a write, is
// a call's callee (D15365); -1 otherwise.
function elabElemCallAlias(d: i32, decl: i32): i32 {
  if d < 0 || d >= P.nodes.length || decl < 0 || decl >= P.nodes.length {
    return -1
  }
  const ln = nodeAt(d)
  const fn = nodeAt(decl)
  if !(ln is LetDecl) || ln.letType >= 0 { return -1 }
  if !(fn is FuncDecl) { return -1 }
  const init = parenPeelIx(ln.letInit)
  if init < 0 || init >= P.nodes.length || !(nodeAt(init) is Index) {
    return -1
  }
  const root = elabSlotRoot(init)
  if root < 0 || root >= P.nodes.length || !(nodeAt(root) is Ident) {
    return -1
  }
  const pd = identDeclOf(root)
  if !i32ListHas(fn.fnParams, pd) { return -1 }
  const todo: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      if nodeAt(x) is Ident && identDeclOf(x) == d {
        const pn = if p >= 0 { nodeAt(p) } else { nodeAt(x) }
        if !(pn is Call && parenPeelIx(pn.callFn) == x) { return -1 }
      }
      for c in nodeChildren(x) {
        todo.push(c)
        par.push(x)
      }
    }
  }
  pd
}

// Callee `cf`, or the element read it aliases when it names such a binding of `decl`.
function elabElemAliasInit(cf: i32, decl: i32): i32 {
  if cf < 0 || cf >= P.nodes.length || !(nodeAt(cf) is Ident) { return cf }
  const d = identDeclOf(cf)
  if d < 0 || d >= P.nodes.length || elabElemCallAlias(d, decl) < 0 {
    return cf
  }
  const ln = nodeAt(d)
  if ln is LetDecl { return parenPeelIx(ln.letInit) }
  cf
}

// `elabMintFacts` over the subtree at `ix` of declaration `decl`'s body, nested functions aside.
function elabMintFactsIn(ix: i32, decl: i32, k: i32, sc: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  let n = 0
  let cur = ix
  while cur >= 0 {
    const cn = nodeAt(cur)
    if cn is FuncDecl {
      // A nested declaration built under this instance gives its facts as its own instance.
      if !((elabPerEnclDecls[cur] ?? false) && elabHasInstUnder(cur, k)) {
        elabMintHandedIn(cur, -1, decl, k, sc)
      }
      return n
    }
    if cn is Call && elabMintFactAt(cn, cur, decl, k, sc) { n = n + 1 }
    // A set-holding list mapped by a lambda that only calls its elements hands nothing on.
    const cb = if cn is Call { elabMintCallbacksAt(cn, decl, k, sc) } else { -1 }
    if cb > 0 { n = n + cb }
    for kid in nodeSpineChildren(cur) {
      if cn is Call && kid == cn.callFn {
        if cb <= 0 { n = n + elabMintCalleeIn(kid, decl, k, sc) }
      } else if (
        cn is LetDecl
        && kid == cn.letInit
        && elabElemCallAlias(cur, decl) >= 0
      ) {
        // An element alias only ever called reads its holder's slot, as the callee chain does.
        n = n + elabMintCalleeIn(kid, decl, k, sc)
      } else {
        elabMintHandedIn(kid, cur, decl, k, sc)
        n = n + elabMintFactsIn(kid, decl, k, sc)
      }
    }
    cur = elseIfLink(cur)
  }
  n
}

// Whether `elabMintFactAt` is noting a call in a lambda one body's instances share.
let elabMintInLambda = false
// Whether that lambda maps a list that is the instance's own parameter, so each instance's call
// goes through its own set (`elabCallSetIn`).
let elabMintOwnRecv = false

// `elabMintFactsIn` for `map` called on a list parameter of `decl` holding a set of functions, with
// a lambda that only calls its element: the fact of each such call, which the instance types at
// that set (D14886). The number noted, or -1 where the call is not that shape and its receiver is
// handed on.
function elabMintCallbacksAt(c: Call, decl: i32, k: i32, sc: i32): i32 {
  const cf = parenPeelIx(c.callFn)
  if cf < 0 || cf >= P.nodes.length { return -1 }
  const fm = nodeAt(cf)
  if !(fm is Member) { return -1 }
  if fm.memProp != "map" { return -1 }
  const recv = parenPeelIx(fm.memObj)
  const pd = elabCalleeParam(recv, decl, k)
  if pd < 0 || pd >= P.nodes.length || !(nodeAt(pd) is Param) { return -1 }
  if elabHeldSetOf(elabNodeTy(recv, k)) < 0 || c.callArgs.length != 1 {
    return -1
  }
  const ax = parenPeelIx(c.callArgs[0])
  const an = if ax >= 0 && ax < P.nodes.length { nodeAt(ax) } else { nodeAt(cf) }
  if !(an is FuncDecl) || an.fnParams.length == 0 { return -1 }
  const declOk = decl >= 0 && decl < P.nodes.length
  const dn = if declOk { nodeAt(decl) } else { an }
  elabMintInLambda = true
  elabMintOwnRecv = declOk && dn is FuncDecl && i32ListHas(dn.fnParams, pd)
  const r = elabMintCallbackBodyIn(an.fnBody, -1, ax, an.fnParams[0], k, sc)
  elabMintInLambda = false
  elabMintOwnRecv = false
  if r <= 0 { return -1 }
  r
}

// The facts for the calls through element parameter `pe` of lambda `lam` in the body at `ix`,
// parent `p`; -1 where `pe` is read other than as a call's callee that takes a fact.
function elabMintCallbackBodyIn(
  ix: i32,
  p: i32,
  lam: i32,
  pe: i32,
  k: i32,
  sc: i32,
): i32 {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const xn = nodeAt(ix)
  if xn is Ident && identDeclOf(ix) == pe {
    const pn = if p >= 0 { nodeAt(p) } else { nodeAt(ix) }
    if (
      pn is Call
      && parenPeelIx(pn.callFn) == ix
      && elabMintFactAt(pn, p, lam, k, sc)
    ) {
      return 1
    }
    return -1
  }
  let n = 0
  for kid in nodeChildren(ix) {
    const r = elabMintCallbackBodyIn(kid, ix, lam, pe, k, sc)
    if r < 0 { return -1 }
    n = n + r
  }
  n
}

// `elabMintFactsIn` over callee `ix`, where the root of an element chain is read as
// the callee's slot, not handed on.
function elabMintCalleeIn(ix: i32, decl: i32, k: i32, sc: i32): i32 {
  let n = 0
  let cur = ix
  let hops = 0
  while cur >= 0 && cur < P.nodes.length && hops < 16 {
    const next = elabChainStep(cur)
    if next < 0 {
      hops = 16
    } else {
      const xn = nodeAt(cur)
      if xn is Index {
        elabMintHandedIn(xn.idxIndex, cur, decl, k, sc)
        n = n + elabMintFactsIn(xn.idxIndex, decl, k, sc)
      }
      cur = next
      hops = hops + 1
    }
  }
  n + elabMintFactsIn(cur, decl, k, sc)
}

// The function type at the leaves of list type `t`, at any depth, or -1.
function elabHeldFnTyOf(t: i32): i32 {
  let e = t
  let depth = 0
  while e >= 0 && e < T.tys.length && depth < 16 {
    const a = tyAt(e)
    if !(a is TyArray) { return if depth > 0 { e } else { -1 } }
    e = a.aElem
    depth = depth + 1
  }
  -1
}

// The set the elements of list type `t`, at any depth, belong to, or -1.
function elabHeldSetOf(t: i32): i32 {
  let e = t
  let depth = 0
  while e >= 0 && e < T.tys.length && depth < 16 {
    const a = tyAt(e)
    if !(a is TyArray) { return if depth > 0 { fnTagSetOfTy(e) } else { -1 } }
    e = a.aElem
    depth = depth + 1
  }
  -1
}

// The parameter of `decl` read `root` names: the parameter itself, or a `const` alias of it
// that is only ever called (`elabCallOnlyAlias`, at instance `k`); else -1.
function elabCalleeParam(root: i32, decl: i32, k: i32): i32 {
  const d = identDeclOf(root)
  if d < 0 || d >= P.nodes.length || decl < 0 || decl >= P.nodes.length {
    return -1
  }
  const dn = nodeAt(decl)
  if !(dn is FuncDecl) { return -1 }
  if nodeAt(d) is Param { return d }
  const ap = elabCallOnlyAlias(d, dn, k)
  if ap >= 0 { return ap }
  const lp = elabHolderParamSource(d, dn)
  if lp >= 0 { return lp }
  elabWrittenParamAlias(d, dn)
}

// `elabListParamSource`, or else `elabRecParamSource`.
function elabHolderParamSource(d: i32, fn: FuncDecl): i32 {
  const lp = elabListParamSource(d, fn)
  if lp >= 0 { return lp }
  elabRecParamSource(d, fn)
}

// The parameter of `fn` every field of the record literal bound at `d` reads, `d` a `const` or a
// `let` nothing re-points, where each read of `d` in `fn`'s own body is a field called in place
// (`d.f(...)`); else -1 (D15445).
function elabRecParamSource(d: i32, fn: FuncDecl): i32 {
  if d < 0 || d >= P.nodes.length { return -1 }
  const ln = nodeAt(d)
  if !(ln is LetDecl) || ln.letType >= 0 { return -1 }
  if ln.letKw != "const" && !cwLetUnwritten(d) { return -1 }
  const li = parenPeelIx(ln.letInit)
  if li < 0 || li >= P.nodes.length { return -1 }
  const ol = nodeAt(li)
  if !(ol is ObjLit) || ol.objFields.length == 0 { return -1 }
  let pd = -1
  for f in ol.objFields {
    const fi = nodeAt(f)
    if !(fi is FieldInit) { return -1 }
    const ex = parenPeelIx(fi.fiValue)
    if ex < 0 || ex >= P.nodes.length || !(nodeAt(ex) is Ident) { return -1 }
    const src0 = identDeclOf(ex)
    const src = if i32ListHas(fn.fnParams, src0) { src0 } else { elabParamCopyOf(src0, fn) }
    if src < 0 || pd >= 0 && src != pd { return -1 }
    pd = src
  }
  const todo: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  const gpar: i32[] = [-1]
  const deep: boolean[] = [false]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    const g = gpar.pop() ?? -1
    const nested = deep.pop() ?? false
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is Ident && identDeclOf(x) == d {
        if nested || p < 0 || g < 0 { return -1 }
        const pn = nodeAt(p)
        const gn = nodeAt(g)
        if !(pn is Member) || pn.memObj != x { return -1 }
        if !(gn is Call) || parenPeelIx(gn.callFn) != p { return -1 }
      }
      for c in nodeChildren(x) {
        todo.push(c)
        par.push(x)
        gpar.push(p)
        deep.push(nested || xn is FuncDecl)
      }
    }
  }
  pd
}

// The binding a call through field read `x` reads, where `x` reads a field of a record
// `elabRecParamSource` takes; else `x` itself.
function elabRecFieldRoot(x: i32, fn: FuncDecl): i32 {
  if x < 0 || x >= P.nodes.length { return x }
  const m = nodeAt(x)
  if !(m is Member) { return x }
  const o = parenPeelIx(m.memObj)
  if o < 0 || o >= P.nodes.length || !(nodeAt(o) is Ident) { return x }
  if elabRecParamSource(identDeclOf(o), fn) < 0 { return x }
  o
}

// Whether field initialiser `fi` belongs to a record literal that initialises a binding in
// `fn`'s body `elabRecParamSource` takes as parameter `pd`.
function elabRecLitOfParam(fi: i32, fn: FuncDecl, pd: i32): boolean {
  const todo: i32[] = [fn.fnBody]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is LetDecl {
        const li = parenPeelIx(xn.letInit)
        const ol = if li >= 0 && li < P.nodes.length { nodeAt(li) } else { nodeAt(x) }
        if ol is ObjLit && i32ListHas(ol.objFields, fi) {
          return elabRecParamSource(x, fn) == pd
        }
      }
      for c in nodeChildren(x) { todo.push(c) }
    }
  }
  false
}

// The parameter of `fn` every element of the list literal bound at `d` reads, `d` a `const` or a
// `let` nothing re-points, where each read of `d` in `fn`'s own body is an element called in place
// (`d[i](...)`); else -1.
function elabListParamSource(d: i32, fn: FuncDecl): i32 {
  if d < 0 || d >= P.nodes.length { return -1 }
  const ln = nodeAt(d)
  if !(ln is LetDecl) || ln.letType >= 0 { return -1 }
  if ln.letKw != "const" && !cwLetUnwritten(d) { return -1 }
  const li = parenPeelIx(ln.letInit)
  if li < 0 || li >= P.nodes.length { return -1 }
  const al = nodeAt(li)
  if !(al is ArrayLit) || al.arrElems.length == 0 { return -1 }
  let pd = -1
  for e in al.arrElems {
    const ex = parenPeelIx(e)
    if ex < 0 || ex >= P.nodes.length || !(nodeAt(ex) is Ident) { return -1 }
    const src0 = identDeclOf(ex)
    const src = if i32ListHas(fn.fnParams, src0) { src0 } else { elabParamCopyOf(src0, fn) }
    if src < 0 || pd >= 0 && src != pd { return -1 }
    pd = src
  }
  const todo: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  const gpar: i32[] = [-1]
  const deep: boolean[] = [false]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    const g = gpar.pop() ?? -1
    const nested = deep.pop() ?? false
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is Ident && identDeclOf(x) == d {
        if nested || p < 0 || g < 0 { return -1 }
        const pn = nodeAt(p)
        const gn = nodeAt(g)
        if !(pn is Index) || pn.idxArr != x { return -1 }
        if !(gn is Call) || parenPeelIx(gn.callFn) != p { return -1 }
      }
      for c in nodeChildren(x) {
        todo.push(c)
        par.push(x)
        gpar.push(p)
        deep.push(nested || xn is FuncDecl)
      }
    }
  }
  pd
}

// The parameter of `fn` that binding `d` copies: an un-annotated `const`, or a `let` nothing
// re-points (`cwLetUnwritten`), initialised by a read of it or of such a copy, at most 8 deep;
// -1 otherwise.
function elabParamCopyOf(d: i32, fn: FuncDecl): i32 {
  let cur = d
  let hops = 0
  while hops < 8 {
    if cur < 0 || cur >= P.nodes.length { return -1 }
    const ln = nodeAt(cur)
    if !(ln is LetDecl) || ln.letType >= 0 { return -1 }
    if ln.letKw != "const" && !cwLetUnwritten(cur) { return -1 }
    const v = parenPeelIx(ln.letInit)
    if v < 0 || !(nodeAt(v) is Ident) { return -1 }
    const src = identDeclOf(v)
    if i32ListHas(fn.fnParams, src) { return src }
    // A copy of a copy reads the parameter too (D15051).
    cur = src
    hops = hops + 1
  }
  -1
}

// Whether the `const` copy `d` of parameter `pd` is read only as an element of list literals
// `elabListParamSource` takes as `pd`.
function elabCopyOnlyListed(d: i32, fn: FuncDecl, pd: i32): boolean {
  const todo: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  let seen = false
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      if nodeAt(x) is Ident && identDeclOf(x) == d {
        // A further `const` copy read only in such literals is such a read too (D15051).
        const chained = p >= 0
          && nodeAt(p) is LetDecl
          && elabParamCopyOf(p, fn) == pd
          && elabCopyOnlyListed(p, fn, pd)
        if (
          !chained
          && (p < 0 || !(nodeAt(p) is ArrayLit) || !elabListLitOfParam(p, fn, pd))
          && (p < 0 || !(nodeAt(p) is FieldInit) || !elabRecLitOfParam(p, fn, pd))
        ) {
          return false
        }
        seen = true
      }
      for c in nodeChildren(x) {
        todo.push(c)
        par.push(x)
      }
    }
  }
  seen
}

// Whether list literal `lit` initialises a binding in `fn`'s body that `elabListParamSource`
// takes as parameter `pd`.
function elabListLitOfParam(lit: i32, fn: FuncDecl, pd: i32): boolean {
  const todo: i32[] = [fn.fnBody]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is LetDecl && parenPeelIx(xn.letInit) == lit {
        return elabListParamSource(x, fn) == pd
      }
      for c in nodeChildren(x) { todo.push(c) }
    }
  }
  false
}

// The un-annotated written `let` of `fn` that parameter read `ix`, the child of `p`, initialises
// or is assigned to, where every value written to it names a declared function or a parameter of
// `fn` and every read is a callee, an assignment's target, or a hand-on to a named function's or
// (as instance `k` types it) a set's open parameter, none nested; -1 otherwise.
function elabParamFeedsWritten(ix: i32, p: i32, fn: FuncDecl, k: i32): i32 {
  if p < 0 || p >= P.nodes.length { return -1 }
  const pn = nodeAt(p)
  let d = -1
  if pn is LetDecl && parenPeelIx(pn.letInit) == ix { d = p }
  if pn is BinExpr && pn.binOp == "=" && parenPeelIx(pn.binRight) == ix {
    const l = parenPeelIx(pn.binLeft)
    if l >= 0 && l < P.nodes.length && nodeAt(l) is Ident { d = identDeclOf(l) }
  }
  if d < 0 || d >= P.nodes.length { return -1 }
  const ln = nodeAt(d)
  if !(ln is LetDecl) || ln.letKw != "let" || ln.letType >= 0 { return -1 }
  cwIxWant()
  const vs = cwBindingWrittenValues(d)
  if vs.length < 2 || cwLetWrittenInClosure(d) { return -1 }
  for v in vs {
    const vx = parenPeelIx(v)
    if vx < 0 || vx >= P.nodes.length || !(nodeAt(vx) is Ident) { return -1 }
    const vd = identDeclOf(vx)
    if vd < 0 || vd >= P.nodes.length { return -1 }
    const vn = nodeAt(vd)
    const named = vn is FuncDecl && vn.fnName != ""
    if !named && !i32ListHas(fn.fnParams, vd) { return -1 }
  }
  if !elabSeededReadsOk(d, fn, k) { return -1 }
  d
}

// The `const`, or `let` nothing re-points, of `fn` whose list literal `p` holds parameter read `ix`,
// or whose element `ix` is assigned to by `p`, where every value its slots hold is a named function
// or a parameter of `fn`, one written after the literal, and every read, none nested, is an element
// called in place or an element assignment's target; -1 otherwise.
function elabParamSeedsListSlot(ix: i32, p: i32, fn: FuncDecl): i32 {
  if p < 0 || p >= P.nodes.length { return -1 }
  const pn = nodeAt(p)
  let d = -1
  if pn is BinExpr && pn.binOp == "=" && parenPeelIx(pn.binRight) == ix {
    const l = nodeAt(parenPeelIx(pn.binLeft))
    const a = if l is Index { parenPeelIx(l.idxArr) } else { -1 }
    if a >= 0 && a < P.nodes.length && nodeAt(a) is Ident { d = identDeclOf(a) }
    if d < 0 || d >= P.nodes.length { return -1 }
  } else if !(pn is ArrayLit) {
    return -1
  }
  const todo: i32[] = [fn.fnBody]
  while todo.length > 0 && d < 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is LetDecl && xn.letType < 0 && parenPeelIx(xn.letInit) == p {
        d = x
      }
      for c in nodeChildren(x) { todo.push(c) }
    }
  }
  if d < 0 { return -1 }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letKw != "const" && !cwLetUnwritten(d) { return -1 }
  if !elabSlotValuesOk(d, "[]", ix, fn) || !elabSlotReadsOk(d, "[]", fn) {
    return -1
  }
  d
}

// Whether every value stored at slot `nm` (a field name, or "[]" for an element) of binding `d`,
// one written after its literal, is `ix`, a named function or a parameter of `fn`.
function elabSlotValuesOk(d: i32, nm: string, ix: i32, fn: FuncDecl): boolean {
  cwIxWant()
  const vals: i32[] = []
  const ats: i32[] = []
  if cwSlotWrittenValues(cwKeyOfDecl(d), [nm], vals, ats) < 1 { return false }
  for v in vals {
    const vx = parenPeelIx(v)
    if vx != ix {
      if vx < 0 || vx >= P.nodes.length || !(nodeAt(vx) is Ident) {
        return false
      }
      const vd = identDeclOf(vx)
      if vd < 0 || vd >= P.nodes.length { return false }
      const vn = nodeAt(vd)
      const named = vn is FuncDecl && vn.fnName != ""
      if !named && !i32ListHas(fn.fnParams, vd) { return false }
    }
  }
  true
}

// Whether every read of binding `d` in `fn`'s body, none nested, is its slot `nm` (a field name,
// or "[]" for an element) called in place or assigned to.
function elabSlotReadsOk(d: i32, nm: string, fn: FuncDecl): boolean {
  const work: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  const gpar: i32[] = [-1]
  const deep: boolean[] = [false]
  while work.length > 0 {
    const x = work.pop() ?? -1
    const q = par.pop() ?? -1
    const g = gpar.pop() ?? -1
    const nested = deep.pop() ?? false
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is Ident && identDeclOf(x) == d {
        if nested || q < 0 || g < 0 { return false }
        const qn = nodeAt(q)
        const gn = nodeAt(g)
        const elem = nm == "[]" && qn is Index && qn.idxArr == x
        const field = nm != "[]"
          && qn is Member
          && qn.memObj == x
          && qn.memProp == nm
        if !elem && !field { return false }
        const called = gn is Call && parenPeelIx(gn.callFn) == q
        const stored = gn is BinExpr
          && gn.binOp == "="
          && gn.binCompound == ""
          && gn.binLeft == q
        if !called && !stored { return false }
      }
      for c in nodeChildren(x) {
        work.push(c)
        par.push(x)
        gpar.push(q)
        deep.push(nested || xn is FuncDecl)
      }
    }
  }
  true
}

// The `const`, or `let` nothing re-points, of `fn` whose record literal holds parameter read `ix`
// at field `fld[0]`, or whose field `ix` is assigned to by `p`, where every value the field holds is
// a named function or a parameter of `fn`, one written after the literal, and every read, none
// nested, is that field called in place or assigned to (D15455); -1 otherwise.
function elabParamSeedsRecField(
  ix: i32,
  p: i32,
  fn: FuncDecl,
  fld: string[],
): i32 {
  if p < 0 || p >= P.nodes.length { return -1 }
  const pn = nodeAt(p)
  let d = -1
  let nm = ""
  if (
    pn is BinExpr
    && pn.binOp == "="
    && pn.binCompound == ""
    && parenPeelIx(pn.binRight) == ix
  ) {
    const l = nodeAt(parenPeelIx(pn.binLeft))
    const a = if l is Member { parenPeelIx(l.memObj) } else { -1 }
    if a >= 0 && a < P.nodes.length && nodeAt(a) is Ident && l is Member {
      d = identDeclOf(a)
      nm = l.memProp
    }
  } else if pn is FieldInit && parenPeelIx(pn.fiValue) == ix {
    nm = pn.fiName
    const todo: i32[] = [fn.fnBody]
    while todo.length > 0 && d < 0 {
      const x = todo.pop() ?? -1
      if x >= 0 && x < P.nodes.length {
        const xn = nodeAt(x)
        const li = if xn is LetDecl { parenPeelIx(xn.letInit) } else { -1 }
        const ol = if li >= 0 && li < P.nodes.length { nodeAt(li) } else { xn }
        if ol is ObjLit && i32ListHas(ol.objFields, p) { d = x }
        for c in nodeChildren(x) { todo.push(c) }
      }
    }
  }
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letType >= 0 { return -1 }
  if dn.letKw != "const" && !cwLetUnwritten(d) { return -1 }
  const li = parenPeelIx(dn.letInit)
  if li < 0 || li >= P.nodes.length || !(nodeAt(li) is ObjLit) { return -1 }
  if !elabSlotValuesOk(d, nm, -1, fn) || !elabSlotReadsOk(d, nm, fn) {
    return -1
  }
  fld.push(nm)
  d
}

// Whether every read of binding `d` in `fn`'s own body is a call's callee, an assignment's target,
// or a positional argument of a named function's or (as instance `k` types it) a set's open
// parameter, and none is in a nested function.
function elabSeededReadsOk(d: i32, fn: FuncDecl, k: i32): boolean {
  const todo: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  const deep: boolean[] = [false]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    const nested = deep.pop() ?? false
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is Ident && identDeclOf(x) == d {
        if nested || p < 0 { return false }
        const pn = nodeAt(p)
        const callee = pn is Call && parenPeelIx(pn.callFn) == x
        const target = pn is BinExpr && pn.binOp == "=" && pn.binLeft == x
        if (
          !callee
          && !target
          && !elabHolderOnlyCalled(p, fn)
          && elabMintFwdTarget(x, p).length != 2
          && elabSetFwdTarget(x, p, k).length == 0
        ) {
          return false
        }
      }
      for c in nodeChildren(x) {
        todo.push(c)
        par.push(x)
        deep.push(nested || xn is FuncDecl)
      }
    }
  }
  true
}

// Whether `p`, the record field or list literal a read sits in, belongs to the initialiser of a
// `const` in `fn`'s own body whose every read is a field or an element called in place: the holder
// holds the read's set, and each call through it dispatches between that set's members.
function elabHolderOnlyCalled(p: i32, fn: FuncDecl): boolean {
  if p < 0 || p >= P.nodes.length { return false }
  const pn = nodeAt(p)
  if !(pn is FieldInit) && !(pn is ArrayLit) { return false }
  let d = -1
  const todo: i32[] = [fn.fnBody]
  while todo.length > 0 && d < 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is LetDecl && xn.letKw == "const" && xn.letType < 0 {
        const li = parenPeelIx(xn.letInit)
        const ln = if li >= 0 && li < P.nodes.length { nodeAt(li) } else { xn }
        if (
          ln is ObjLit && i32ListHas(ln.objFields, p)
          || li == p && pn is ArrayLit
        ) {
          d = x
        }
      }
      for c in nodeChildren(x) { todo.push(c) }
    }
  }
  if d < 0 { return false }
  const work: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  const gpar: i32[] = [-1]
  const deep: boolean[] = [false]
  while work.length > 0 {
    const x = work.pop() ?? -1
    const q = par.pop() ?? -1
    const g = gpar.pop() ?? -1
    const nested = deep.pop() ?? false
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is Ident && identDeclOf(x) == d {
        if nested || q < 0 || g < 0 { return false }
        const qn = nodeAt(q)
        const gn = nodeAt(g)
        const held = qn is Member && qn.memObj == x
          || qn is Index && qn.idxArr == x
        if !held { return false }
        if !(gn is Call) || parenPeelIx(gn.callFn) != q { return false }
      }
      for c in nodeChildren(x) {
        work.push(c)
        par.push(x)
        gpar.push(q)
        deep.push(nested || xn is FuncDecl)
      }
    }
  }
  true
}

// The first parameter of `elabWrittenParamSources`, or -1.
function elabWrittenParamAlias(d: i32, fn: FuncDecl): i32 {
  const ps = elabWrittenParamSources(d, fn)
  if ps.length == 0 { return -1 }
  ps[0]
}

// The parameters of `fn` a written `let` binding `d` holds, where every value written to it is
// a parameter of `fn` annotated by one own type parameter, nothing in a nested function reads or
// writes it, and each read is a call's callee or a hand-on to a named function's open parameter.
function elabWrittenParamSources(d: i32, fn: FuncDecl): i32[] {
  const none: i32[] = []
  if d < 0 || d >= P.nodes.length { return none }
  const ln = nodeAt(d)
  if !(ln is LetDecl) || ln.letKw != "let" { return none }
  cwIxWant()
  const vs = cwBindingWrittenValues(d)
  if vs.length < 2 || cwLetWrittenInClosure(d) { return none }
  const out: i32[] = []
  let ty = ""
  for v in vs {
    const ix = parenPeelIx(v)
    if ix < 0 || ix >= P.nodes.length || !(nodeAt(ix) is Ident) { return none }
    const pd = identDeclOf(ix)
    if !i32ListHas(fn.fnParams, pd) { return none }
    const t = elabTyParamNameOf(fn, pd)
    if t == "" || out.length > 0 && t != ty { return none }
    ty = t
    if !i32ListHas(out, pd) { out.push(pd) }
  }
  if ln.letType >= 0 && elabTyParamNameOf(fn, d) != ty { return none }
  if !elabWrittenAliasReadsOk(d, fn) { return none }
  mintAliasNote(d)
  out
}

// The name of `fn`'s own type parameter that parameter or binding `d` is annotated with, or "".
function elabTyParamNameOf(fn: FuncDecl, d: i32): string {
  const n = nodeAt(d)
  const at = if n is Param { n.parType } else if n is LetDecl { n.letType } else { -1 }
  if at < 0 || at >= P.nodes.length { return "" }
  const tn = nodeAt(at)
  if !(tn is TypeRef) || !strListHas(fn.fnTyParams, tn.tyName) { return "" }
  tn.tyName
}

// Whether every read of binding `d` in `fn`'s own body is a call's callee, the target of an
// assignment, or a hand-on to a named function's open parameter, and none is in a nested function.
function elabWrittenAliasReadsOk(d: i32, fn: FuncDecl): boolean {
  const todo: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  const deep: boolean[] = [false]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    const nested = deep.pop() ?? false
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is Ident && identDeclOf(x) == d {
        if nested || p < 0 { return false }
        const pn = nodeAt(p)
        const callee = pn is Call && parenPeelIx(pn.callFn) == x
        const target = pn is BinExpr && pn.binOp == "=" && pn.binLeft == x
        if !callee && !target && elabMintFwdTarget(x, p).length != 2 {
          return false
        }
      }
      for k in nodeChildren(x) {
        todo.push(k)
        par.push(x)
        deep.push(nested || xn is FuncDecl)
      }
    }
  }
  true
}

// The parameter of `fn` that binding `d` is initialised with, directly or through a chain of
// such bindings, where every read of `d` in `fn`'s body is a call's callee or the initialiser of
// another such binding: the alias hands the set nowhere else and nothing re-points it; else -1.
function elabCallOnlyAlias(d: i32, fn: FuncDecl, k: i32): i32 {
  const pd = elabAliasSource(d, fn, 8, k)
  if pd < 0 || !elabAliasReadsOk(d, fn, 8, k) { return -1 }
  pd
}

// The parameter of `fn` the binding `d` is initialised with, through at most `depth` bindings
// each initialised with the one before it; -1 when the chain reaches anything else.
function elabAliasSource(d: i32, fn: FuncDecl, depth: i32, k: i32): i32 {
  if depth <= 0 || d < 0 || d >= P.nodes.length { return -1 }
  const ln = nodeAt(d)
  if !(ln is LetDecl) || ln.letInit < 0 { return -1 }
  // A binding annotated with `fn`'s own type parameter is a copy of a parameter annotated the same.
  const own = if ln.letType >= 0 { elabTyParamNameOf(fn, d) } else { "" }
  if ln.letType >= 0 && own == "" { return -1 }
  const ix = parenPeelIx(ln.letInit)
  if ix < 0 || !(nodeAt(ix) is Ident) { return -1 }
  const src = identDeclOf(ix)
  const r = if i32ListHas(fn.fnParams, src) { src } else { elabAliasSource(src, fn, depth - 1, k) }
  if r >= 0 && own != "" && !elabOwnAgreesWith(fn, own, r, k) { return -1 }
  r
}

// Whether own type parameter `own` names parameter `r`'s type at instance `k`: the type parameter
// annotating `r` agrees with it, or `r` is un-annotated and `k` binds `own` to `r`'s closed type.
function elabOwnAgreesWith(fn: FuncDecl, own: string, r: i32, k: i32): boolean {
  // A type parameter no parameter names is inferred from the parameter its bindings copy.
  if elabTyParamSeedParam(fn, own) == r { return true }
  const pn = nodeAt(r)
  if !(pn is Param) || pn.parType >= 0 {
    return elabTyParamsAgreeAt(own, elabTyParamNameOf(fn, r), k)
  }
  if k < 0 || k >= ekDecl.length { return false }
  const ta = bindOf(ekNames[k], ekTys[k], own)
  const tr = elabNodeTy(r, k)
  ta >= 0 && tr >= 0 && tySame(ta, tr) && elabTyClosed(ta, 0)
}

// The parameter of `fn` whose value own type parameter `tp` is inferred from: `tp` annotates no
// parameter, and every binding annotated bare with `tp` is initialised by a read of a parameter,
// directly or through bindings each initialised by a read of the one before. The first such
// binding in source order names the seed; -1 when there is none.
export function elabTyParamSeedParam(fn: FuncDecl, tp: string): i32 {
  if anyParamMentionsTyParam(fn.fnParams, [tp]) { return -1 }
  let seed = -1
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is LetDecl && n.letType >= 0 && n.letType < P.nodes.length {
        const tn = nodeAt(n.letType)
        if tn is TypeRef && tn.tyName == tp {
          const r = elabReadSeedParam(n.letInit, fn, 8)
          if r < 0 { return -1 }
          if seed < 0 { seed = r }
        }
      }
      const kids = nodeChildren(ix)
      let c = kids.length - 1
      while c >= 0 {
        stack.push(kids[c])
        c -= 1
      }
    }
  }
  seed
}

// The parameter of `fn` that `ix` reads, directly or through bindings each initialised by a read
// of the one before, within `depth` bindings; else -1.
function elabReadSeedParam(ix: i32, fn: FuncDecl, depth: i32): i32 {
  const v = parenPeelIx(ix)
  if depth <= 0 || v < 0 || !(nodeAt(v) is Ident) { return -1 }
  const d = identDeclOf(v)
  if i32ListHas(fn.fnParams, d) { return d }
  if d < 0 || d >= P.nodes.length { return -1 }
  const ln = nodeAt(d)
  if !(ln is LetDecl) { return -1 }
  elabReadSeedParam(ln.letInit, fn, depth - 1)
}

// Gives each type parameter of `decl` that `elabTyParamSeedParam` infers from a parameter the rep
// of that parameter's binding in row `names`/`rep`, appending it to the row when absent. A seed
// whose set holds one generic and has no closed rep takes the one signature the calls through it
// and its copies instance that generic at. True when the row changed.
function elabSeedReps(
  decl: i32,
  names: string[],
  tys: i32[],
  rep: i32[],
): boolean {
  if decl < 0 || decl >= P.nodes.length { return false }
  const fn = nodeAt(decl)
  if !(fn is FuncDecl) { return false }
  let changed = false
  for tp in fn.fnTyParams {
    const pd = elabTyParamSeedParam(fn, tp)
    const j = i32ListIndexOf(fn.fnParams, pd)
    const sn = if j >= 0 { elabSeedBindName(fn, decl, j) } else { "" }
    const w = strListIndexOf(names, sn)
    if w >= 0 && w < rep.length && w < tys.length {
      if !(rep[w] >= 0 && elabTyClosed(rep[w], 0)) {
        const ms = elabFnSetOf(tys[w])
        const r = if ms.length == 1 { elabCallsRep(elabSeedCalls(fn, pd), ms[0], names, tys) } else { -1 }
        if r >= 0 {
          rep[w] = r
          changed = true
        }
      }
      const i = strListIndexOf(names, tp)
      if i < 0 {
        names.push(tp)
        rep.push(rep[w])
        changed = true
      } else if i < rep.length && rep[i] != rep[w] {
        rep[i] = rep[w]
        changed = true
      }
    }
  }
  changed
}

// The calls in `fn`'s body, outside nested functions, whose callee reads parameter `pd` or a
// binding `elabReadSeedParam` traces to it.
function elabSeedCalls(fn: FuncDecl, pd: i32): i32[] {
  const out: i32[] = []
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length && !(nodeAt(ix) is FuncDecl) {
      const n = nodeAt(ix)
      if n is Call {
        const cf = parenPeelIx(n.callFn)
        if (
          cf >= 0
          && nodeAt(cf) is Ident
          && elabReadSeedParam(cf, fn, 8) == pd
        ) {
          out.push(ix)
        }
      }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  out
}

// The name an instance binds parameter `j` of `fn` by: the own type parameter annotating it bare,
// or its hole's name when un-annotated; "" otherwise.
function elabSeedBindName(fn: FuncDecl, decl: i32, j: i32): string {
  const pn = nodeAt(fn.fnParams[j])
  if !(pn is Param) { return "" }
  if pn.parType >= 0 { return elabTyParamNameOf(fn, fn.fnParams[j]) }
  paramHoleName(fn.fnName, decl, j)
}

// The closed type the elaboration's instance of `decl0` for `call`, reached from the instance
// being walked, binds type parameter `tp` to, where that is the type of the parameter
// `elabTyParamSeedParam` infers `tp` from; -1 when the instance does not bind it so.
export function elabCallSeedBind(decl0: i32, call: i32, tp: string): i32 {
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  const decl = elabSrcDecl(decl0)
  if call < 0 || decl < 0 || decl >= P.nodes.length { return -1 }
  const fn = nodeAt(decl)
  if !(fn is FuncDecl) { return -1 }
  const pd = elabTyParamSeedParam(fn, tp)
  const k = elabCallInstFrom(call, top)
  if pd < 0 || k < 0 || k >= ekDecl.length || ekDecl[k] != decl { return -1 }
  const t = bindOf(ekNames[k], ekTys[k], tp)
  const st = elabNodeTy(pd, k)
  if t < 0 || st < 0 || !tySame(t, st) || !elabTyClosed(t, 0) { return -1 }
  t
}

// Whether own type parameters `a` and `b` name one type: the same name, or two that instance `k`
// binds to one closed type.
function elabTyParamsAgreeAt(a: string, b: string, k: i32): boolean {
  if a == b { return true }
  if a == "" || b == "" || k < 0 || k >= ekDecl.length { return false }
  const ta = bindOf(ekNames[k], ekTys[k], a)
  const tb = bindOf(ekNames[k], ekTys[k], b)
  ta >= 0 && tb >= 0 && tySame(ta, tb) && elabTyClosed(ta, 0)
}

// Whether every read of binding `d` in `fn`'s body is a call's callee, or the initialiser of a
// binding (unannotated, or a copy `elabAliasSource` takes) whose own reads are so, within `depth`
// bindings.
function elabAliasReadsOk(d: i32, fn: FuncDecl, depth: i32, k: i32): boolean {
  if depth <= 0 { return false }
  const todo: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      if nodeAt(x) is Ident && identDeclOf(x) == d {
        const pn = if p >= 0 { nodeAt(p) } else { nodeAt(x) }
        const callee = pn is Call && parenPeelIx(pn.callFn) == x
          || elabClosedDestTy(x, p) >= 0
        const seeds = pn is LetDecl
          && parenPeelIx(pn.letInit) == x
          && (pn.letType < 0 || elabAliasSource(p, fn, depth, k) >= 0)
          && elabAliasReadsOk(p, fn, depth - 1, k)
        if !callee && !seeds { return false }
      }
      for c in nodeChildren(x) {
        todo.push(c)
        par.push(x)
      }
    }
  }
  true
}

// Whether parameter read `ix`, the child of `p`, is a value written to a binding
// `elabWrittenParamAlias` takes: its initialiser or the right side of an assignment to it.
function elabWrittenAliasSeed(ix: i32, p: i32, fn: FuncDecl): boolean {
  if p < 0 || p >= P.nodes.length { return false }
  const pn = nodeAt(p)
  if pn is LetDecl && parenPeelIx(pn.letInit) == ix {
    return elabWrittenParamAlias(p, fn) >= 0
  }
  if !(pn is BinExpr) || pn.binOp != "=" || parenPeelIx(pn.binRight) != ix {
    return false
  }
  const l = parenPeelIx(pn.binLeft)
  if l < 0 || l >= P.nodes.length || !(nodeAt(l) is Ident) { return false }
  elabWrittenParamAlias(identDeclOf(l), fn) >= 0
}

// The encloser of `decl` declaring parameter `pd`, reached through enclosers built per instance of
// theirs, or -1.
function elabEnclOwning(decl: i32, pd: i32): i32 {
  let e = elabEncl.get(decl) ?? -1
  let n = 0
  while e >= 0 && e < P.nodes.length && n < P.nodes.length {
    const en = nodeAt(e)
    if en is FuncDecl && i32ListHas(en.fnParams, pd) { return e }
    if !(elabPerEnclDecls[e] ?? false) { return -1 }
    e = elabEncl.get(e) ?? -1
    n = n + 1
  }
  -1
}

// Marks partial the set instance `k` binds a parameter of `decl` to, where node `ix` (the child
// of `p`, or inside a nested function when `p` is -1) reads that parameter other than as a
// callee: a set handed on is typed where it lands, which this decision does not see.
function elabMintHandedIn(ix: i32, p: i32, decl: i32, k: i32, sc: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const xn = nodeAt(ix)
  // A list's length reads no element.
  const pn = if p >= 0 { nodeAt(p) } else { nodeAt(ix) }
  if xn is Ident && pn is Member && pn.memObj == ix && pn.memProp == "length" {
    return 0
  }
  if xn is Ident {
    const pd = identDeclOf(ix)
    const dn = nodeAt(decl)
    // In a nested declaration built per encloser instance, a read of the encloser's parameter is
    // that parameter's, typed at this instance.
    if (
      (elabPerEnclDecls[decl] ?? false)
      && pd >= 0
      && dn is FuncDecl
      && !i32ListHas(dn.fnParams, pd)
    ) {
      const own = elabEnclOwning(decl, pd)
      if own >= 0 { return elabMintHandedIn(ix, p, own, k, sc) }
    }
    if pd >= 0 && dn is FuncDecl && i32ListHas(dn.fnParams, pd) {
      // So does a `const` copy of it read only in such literals.
      if (
        p >= 0
        && nodeAt(p) is LetDecl
        && elabParamCopyOf(p, dn) == pd
        && elabCopyOnlyListed(p, dn, pd)
      ) {
        return 0
      }
      // So does a `const` list literal of it whose elements are only ever called.
      if (p >= 0 && nodeAt(p) is ArrayLit && elabListLitOfParam(p, dn, pd)) {
        return 0
      }
      // So does one a copy reads element by element into a closed holder, whose adapter calls
      // each element (D15432).
      if p >= 0 && nodeAt(p) is ArrayLit && ftParamListCopied(dn, pd) {
        return 0
      }
      // So does a `const` record literal of it whose fields are only ever called.
      if p >= 0 && nodeAt(p) is FieldInit && elabRecLitOfParam(p, dn, pd) {
        return 0
      }
      // A `const` alias that is only ever called reads the set where its calls do.
      if p >= 0 && nodeAt(p) is LetDecl && elabCallOnlyAlias(p, dn, k) == pd {
        // Its reads handed to a closed function type are deliveries of the parameter's set.
        if !elabAliasCloNote(p, pd, dn, k) {
          mintSetPartialNote(elabHeldSetOf(elabNodeTy(ix, k)))
        }
        return 0
      }
      // So does a written binding every value of which is such a parameter.
      if elabWrittenAliasSeed(ix, p, dn) {
        const ss = fnTagSetOfTy(elabNodeTy(ix, k))
        if ss >= 0 {
          mintParamSetNote(decl, i32ListIndexOf(dn.fnParams, pd), ss)
        }
        return 0
      }
      // So does a written `let` it seeds whose other values are named functions.
      const fed = elabParamFeedsWritten(ix, p, dn, k)
      if fed >= 0 {
        const ss = fnTagSetOfTy(elabNodeTy(ix, k))
        const ws = fnTagSetOfTy(elabNodeTy(fed, k))
        if ss >= 0 && ws >= 0 {
          mintSeedNote(decl, i32ListIndexOf(dn.fnParams, pd), ss, fed, ws)
          return 0
        }
      }
      // So does a list it seeds whose slots are written only with named functions or parameters
      // (D15453).
      const ls = elabParamSeedsListSlot(ix, p, dn)
      if ls >= 0 {
        const ss = fnTagSetOfTy(elabNodeTy(ix, k))
        const lt = elabNodeTy(ls, k)
        const la = if lt >= 0 && lt < T.tys.length { tyAt(lt) } else { null }
        const ws = if la is TyArray { fnTagSetOfTy(la.aElem) } else { -1 }
        if ss >= 0 && ws >= 0 {
          mintSeedNote(decl, i32ListIndexOf(dn.fnParams, pd), ss, ls, ws)
          return 0
        }
      }
      // So does a record it seeds whose field is written only with named functions or parameters
      // (D15455).
      const rfld: string[] = []
      const rs = elabParamSeedsRecField(ix, p, dn, rfld)
      if rs >= 0 {
        const ss = fnTagSetOfTy(elabNodeTy(ix, k))
        const ws = fnTagSetOfTy(recFieldTyOf(elabNodeTy(rs, k), rfld[0]))
        if ss >= 0 && ws >= 0 {
          mintSeedNote(decl, i32ListIndexOf(dn.fnParams, pd), ss, rs, ws)
          return 0
        }
      }
      // A parameter handed back lands at the call's own value, which the decision reads.
      if elabRetHandsBack(decl, ix, i32ListIndexOf(dn.fnParams, pd)) {
        return 0
      }
      // A binding copying it that is read only as an argument of calls through a set of
      // functions forwards it there, as the parameter itself would.
      if (
        p >= 0
        && nodeAt(p) is LetDecl
        && elabAliasSetFwd(
          decl,
          i32ListIndexOf(dn.fnParams, pd),
          p,
          dn,
          k,
          fnTagSetOfTy(elabNodeTy(ix, k)),
        )
      ) {
        return 0
      }
      // A read handed to a named function's parameter of a closed function type is the closure
      // there of the set's one named member (D6741).
      if elabCloNoteAt(ix, p, pd, k) { return 0 }
      mintSetPartialNote(elabHeldSetOf(elabNodeTy(ix, k)))
      const st = fnTagSetOfTy(elabNodeTy(ix, k))
      const to = elabMintFwdTarget(ix, p)
      if to.length == 2 && st >= 0 {
        mintParamFwdNote(decl, i32ListIndexOf(dn.fnParams, pd), to[0], to[1])
      } else if (
        !elabMintSetFwd(decl, i32ListIndexOf(dn.fnParams, pd), ix, p, k, st)
      ) {
        mintSetPartialNote(st)
      }
    }
    if pd >= 0 && dn is FuncDecl && nodeAt(pd) is LetDecl {
      const to = elabMintFwdTarget(ix, p)
      for src in elabWrittenParamSources(pd, dn) {
        if to.length == 2 {
          mintParamFwdNote(decl, i32ListIndexOf(dn.fnParams, src), to[0], to[1])
        }
      }
    }
    return 0
  }
  if xn is Paren { return elabMintHandedIn(xn.parInner, p, decl, k, sc) }
  if p >= 0 { return 0 }
  for kid in nodeChildren(ix) { elabMintHandedNested(kid, ix, decl, k, sc) }
  0
}

// The closed function type of the named function's parameter that read `ix`, an argument of call
// `p`, is handed to; -1 for any other read.
function elabClosedDestTy(ix: i32, p: i32): i32 {
  if p < 0 || p >= P.nodes.length { return -1 }
  const pn = nodeAt(p)
  if (
    !(pn is Call)
    || parenPeelIx(pn.callFn) == ix
    || hasNamedArgs(pn.callArgNames)
  ) {
    return -1
  }
  let ai = -1
  let i = 0
  while i < pn.callArgs.length {
    const a = pn.callArgs[i]
    if a >= 0 && nodeAt(a) is Spread { return -1 }
    if parenPeelIx(a) == ix { ai = i }
    i = i + 1
  }
  const cf = parenPeelIx(pn.callFn)
  if ai < 0 || cf < 0 || cf >= P.nodes.length || !(nodeAt(cf) is Ident) {
    return -1
  }
  const fd = identDeclOf(cf)
  if fd < 0 || fd >= P.nodes.length { return -1 }
  const fdn = nodeAt(fd)
  if !(fdn is FuncDecl) || fdn.fnName == "" || ai >= fdn.fnParams.length {
    return -1
  }
  const dt = nodeTyIxOf(fdn.fnParams[ai])
  if dt < 0 || dt >= T.tys.length || !(tyAt(dt) is TyFunc) { return -1 }
  if tyHasTyVar(dt) || tyReachesHole(dt, 8) { return -1 }
  dt
}

// The closed function type of the elements of the untagged list `p` pushes read `ix` onto
// (`xs.push(ix)`) at instance `k`: the element, or where that is open the signature calls through
// a list binding of its set close (`elabListSigRow`); -1 for any other read or none closing.
function elabPushDestTy(ix: i32, p: i32, k: i32): i32 {
  if p < 0 || p >= P.nodes.length || k < 0 { return -1 }
  const pn = nodeAt(p)
  if (
    !(pn is Call)
    || pn.callArgs.length != 1
    || parenPeelIx(pn.callArgs[0]) != ix
  ) {
    return -1
  }
  const cf = nodeAt(parenPeelIx(pn.callFn))
  if !(cf is Member) || cf.memProp != "push" { return -1 }
  const lt = elabNodeTy(parenPeelIx(cf.memObj), k)
  if lt < 0 || lt >= T.tys.length { return -1 }
  const la = tyAt(lt)
  if !(la is TyArray) { return -1 }
  const dt = la.aElem
  if (
    dt < 0
    || dt >= T.tys.length
    || !(tyAt(dt) is TyFunc)
    || fnTagTyIsTagged(dt)
  ) {
    return -1
  }
  if !tyHasTyVar(dt) && !tyReachesHole(dt, 8) { return dt }
  // An open element is the signature calls through a list binding of the holder's set close.
  const hs = fnTagSetOfTy(dt)
  if hs < 0 || fnTagSetIsTagged(hs) { return -1 }
  elabListSigOfSet.get(hs) ?? -1
}

// Whether read `ix` of parameter `pd` of instance `k`'s function, handed as `p`'s argument to a
// closed function type, delivers the closure there of the one named member of the set the
// instance binds `pd` to, the same at every instance; it records that delivery (D6741).
function elabCloNoteAt(ix: i32, p: i32, pd: i32, k: i32): boolean {
  let dt = elabClosedDestTy(ix, p)
  if dt < 0 {
    dt = elabPushDestTy(ix, p, k)
    // A guess's or a representation's key is no instance a value reaches: its push is no delivery.
    if dt >= 0 && ((elabGuessKeys[k] ?? false) || (elabReprKeys[k] ?? false)) {
      return true
    }
  }
  if dt < 0 || pd < 0 || pd >= P.nodes.length || !(nodeAt(pd) is Param) {
    return false
  }
  if k < 0 || k >= ekDecl.length { return false }
  // The parameter's type at the instance names the set; a read delivered elsewhere first may be
  // recorded at that delivery's signature.
  const st = fnTagSetOfTy(substTyDeep(nodeTyIxOf(pd), ekNames[k], ekTys[k]))
  const ms = fnTagMembers(st)
  if ms.length != 1 || ms[0] < 0 || ms[0] >= P.nodes.length { return false }
  const m = nodeAt(ms[0])
  if !(m is FuncDecl) || m.fnName == "" { return false }
  if !mintCloDeliveryNote(ix, dt, st) { return false }
  // The parameter takes the set here as a call through it would.
  const dn = nodeAt(ekDecl[k])
  if dn is FuncDecl {
    mintParamSetNote(ekDecl[k], i32ListIndexOf(dn.fnParams, pd), st)
  }
  true
}

// The reads of the `const` copy `d` of parameter `pd` that `elabCloNoteAt` takes as deliveries,
// noted for instance `k`; false when one of them does not take.
function elabAliasCloNote(d: i32, pd: i32, fn: FuncDecl, k: i32): boolean {
  const todo: i32[] = [fn.fnBody]
  const par: i32[] = [-1]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    const p = par.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      if (
        nodeAt(x) is Ident
        && identDeclOf(x) == d
        && elabClosedDestTy(x, p) >= 0
      ) {
        if !elabCloNoteAt(x, p, pd, k) { return false }
      }
      for c in nodeChildren(x) {
        todo.push(c)
        par.push(x)
      }
    }
  }
  true
}

// `elabMintHandedIn` inside a function nested in `decl`'s body, with each node's parent `p`: a
// captured parameter handed on to a named function's hole is a forward, one called there is a
// fact of scope row `sc` where its arguments close, and any other read is partial.
function elabMintHandedNested(ix: i32, p: i32, decl: i32, k: i32, sc: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const xn = nodeAt(ix)
  if xn is Ident {
    const pd = identDeclOf(ix)
    const dn = nodeAt(decl)
    if pd >= 0 && dn is FuncDecl && i32ListHas(dn.fnParams, pd) {
      const st = fnTagSetOfTy(elabNodeTy(ix, k))
      const to = elabMintFwdTarget(ix, p)
      const pn = if p >= 0 { nodeAt(p) } else { nodeAt(ix) }
      // A forward through a set from here would be one body's for every instance (D14842).
      if to.length == 2 && st >= 0 {
        mintParamFwdNote(decl, i32ListIndexOf(dn.fnParams, pd), to[0], to[1])
      } else if (
        !(pn is Call && pn.callFn == ix && elabMintFactAt(pn, p, decl, k, sc))
      ) {
        mintSetPartialNote(st)
      }
    }
    return 0
  }
  for kid in nodeChildren(ix) { elabMintHandedNested(kid, ix, decl, k, sc) }
  0
}

// The node a callee read `x` reads its slot of: `x` itself, or the root an element or field
// chain (`r[i]`, `r[i][j]`) starts from.
function elabSlotRoot(x: i32): i32 {
  let r = x
  let depth = 0
  while r >= 0 && r < P.nodes.length && depth < 16 {
    const next = elabChainStep(r)
    if next < 0 { return r }
    r = next
    depth = depth + 1
  }
  r
}

// The node chain read `x` steps to: a paren's inner or an index's holder; -1 for
// any other node.
function elabChainStep(x: i32): i32 {
  const n = nodeAt(x)
  match n {
    Paren => {
      return n.parInner
    }
    Index => {
      return parenPeelIx(n.idxArr)
    }
    // A field read is typed by its record's own row, which the facts here do not reach.
    Member => {
      return -1
    }
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      return -1
    }
  }
}

// Joins the bundle signatures of a parameter an instance hands on whole as a call's argument with
// the callee instance's parameter there: parameters such hands link hold one record, so each takes
// the union of their calls in walk order. The union draws only on signatures already noted, so a
// cycle of hands settles.
function elabBundleForwardsJoin() {
  const up: Map<i32, i32> = Map()
  // Each hand as five entries: the call, its instance, the argument, and both parameter keys.
  const hands: i32[] = []
  let k = 0
  while k < ekDecl.length {
    const dn = nodeAt(ekDecl[k])
    if dn is FuncDecl && dn.fnBody >= 0 && dn.fnParams.length < 64 {
      const todo: i32[] = [dn.fnBody]
      while todo.length > 0 {
        const x = todo.pop() ?? -1
        if x >= 0 && x < P.nodes.length {
          const n = nodeAt(x)
          if n is Call {
            const kc = elabCallInstFrom(x, k)
            let i = 0
            while kc >= 0 && i < n.callArgs.length && i < 64 {
              const a = parenPeelIx(n.callArgs[i])
              const ok = if a >= 0 && nodeAt(a) is Ident { elabParamOwnerKey(identDeclOf(a), k) } else { -1 }
              if ok >= 0 {
                elabBundleUnite(up, ok, elabBundleKey(kc, i))
                hands.push(x)
                hands.push(k)
                hands.push(i)
                hands.push(ok)
                hands.push(elabBundleKey(kc, i))
              }
              i = i + 1
            }
          }
          // A nested function's calls are its own instance's.
          if !(n is FuncDecl) {
            for c in nodeChildren(x) { todo.push(c) }
          }
        }
      }
    }
    k = k + 1
  }
  const roots: i32[] = []
  const lists: i32[][] = []
  // The chain's set is that of the first member whose instance binds the parameter to one.
  const setKeys: i32[] = []
  for key in up.keys() {
    const r = elabBundleRoot(up, key)
    let at = i32ListIndexOf(roots, r)
    if at < 0 {
      roots.push(r)
      lists.push([])
      setKeys.push(-1)
      at = roots.length - 1
    }
    if setKeys[at] < 0 && elabBundleKeySet(key) >= 0 { setKeys[at] = key }
    for t in elabBundleOwnSigs(key) {
      let have = false
      for u in lists[at] {
        if tySame(u, t) { have = true }
      }
      if !have { lists[at].push(t) }
    }
  }
  // A chain a closure hands into, or a call through a copy of a function, joins only where each
  // function its members are bound to already has an instance at every signature, as the hand is
  // read after the instances are built.
  const dropped: i32[] = []
  let h = 0
  while h + 4 < hands.length {
    const r = elabBundleRoot(up, hands[h + 3])
    const at = i32ListIndexOf(roots, r)
    if (
      (hands[h + 3] / 64 != hands[h + 1] || !elabCallsNamedFn(hands[h]))
      && at >= 0
      && !i32ListHas(dropped, r)
      && !elabChainMembersBuilt(up, r, lists[at])
    ) {
      dropped.push(r)
    }
    h = h + 5
  }
  for key in up.keys() {
    const r = elabBundleRoot(up, key)
    const at = i32ListIndexOf(roots, r)
    if at >= 0 && lists[at].length >= 2 && !i32ListHas(dropped, r) {
      elabBundleSigs[key] = lists[at].slice(0)
      elabBundleJoinRoot[key] = if setKeys[at] >= 0 { setKeys[at] } else { r }
    }
  }
  elabHandMembersNote(hands)
  elabResultMembersNote()
  0
}

// What `elabResultMembersNote` reads, banked by the elaboration's one pass over the arena: each
// call a `const` binding is initialised by, each binding's reads and the calls through it, each
// call that is another call's callee, and each call that is a statement whose value is dropped.
let elabResHolder: {[i32]: i32} = Map()
let elabResReads: {[i32]: i32} = Map()
let elabResThrough: {[i32]: i32[]} = Map()
let elabResCalleeOf: {[i32]: i32} = Map()
let elabResStmt: {[i32]: boolean} = Map()
let elabResArgOf: {[i32]: i32} = Map()
// Per binding, the (call, argument index) pairs that hand its read on whole.
let elabResHands: {[i32]: i32[]} = Map()
// Per `let` holder, the calls it is written from (its initialiser first), and whether any write
// is not a plain assignment of a call.
let elabResWrites: {[i32]: i32[]} = Map()
let elabResBadWrite: {[i32]: boolean} = Map()
// Per `let` holder, the holders a plain assignment writes into it, and per holder, the holders
// it is written into.
let elabResAsgFrom: {[i32]: i32[]} = Map()
let elabResAsgTo: {[i32]: i32[]} = Map()
// Per parameter, the unannotated `const` bindings initialised with a read of it; per bundle key,
// whether a call hands that parameter a record whole.
let elabResCopies: {[i32]: i32[]} = Map()
// Per holder, the `return` statements that return it.
let elabResRets: {[i32]: i32[]} = Map()
let elabRecParams: {[i32]: boolean} = Map()
// Per named function, its reads and those that are a call's callee; per instance, the record it
// returns as a call's value (`elabRetCallRecord`, memoised).
let elabFnReads: {[i32]: i32} = Map()
let elabFnCalleeReads: {[i32]: i32} = Map()
let elabRetRecMemo: {[i32]: i32[]} = Map()
// Per plain function, the record it returns; per call to one, that function.
let elabPlainRecMemo: {[i32]: i32[]} = Map()
let elabResPlainCalls: {[i32]: i32} = Map()
let elabAnyRetRecord = false
// Per call, the member of the record its callee returns that the call's value is used as (-1
// for a value dropped); per holder binding, that member's function type.
let elabResMembers: {[i32]: i32[]} = Map()
let elabResHolderTys: {[i32]: i32[]} = Map()
let elabResTys: {[i32]: i32[]} = Map()

function elabResultScanReset() {
  elabResHolder = Map()
  elabResReads = Map()
  elabResThrough = Map()
  elabResCalleeOf = Map()
  elabResStmt = Map()
  elabResArgOf = Map()
  elabResHands = Map()
  elabResWrites = Map()
  elabResBadWrite = Map()
  elabResCopies = Map()
  elabResAsgFrom = Map()
  elabResAsgTo = Map()
  elabResRets = Map()
  elabRecParams = Map()
  elabFnReads = Map()
  elabFnCalleeReads = Map()
  elabRetRecMemo = Map()
  elabPlainRecMemo = Map()
  elabResPlainCalls = Map()
  elabAnyRetRecord = false
  elabArgRecs = Map()
  elabResMembers = Map()
  elabResHolderTys = Map()
  elabResTys = Map()
  elabHolderRecs = Map()
  elabResKeeps = Map()
  elabThroughMembers = Map()
  elabSlotRecDecl = []
  elabResSlotCalls = []
  elabStoreMembers = Map()
  elabSlotRecField = []
  elabSlotRecAt = []
  elabPlaceRecs = Map()
  elabRecTable = []
  0
}

// `elabRun`'s pass over node `g` for `elabResultMembersNote`.
function elabResultScanAt(g: i32) {
  elabResScanLet(g)
  elabResScanIdent(g)
  elabResScanCall(g)
  elabResScanBlock(g)
  elabResScanAssign(g)
  elabResScanRet(g)
  elabResScanSlots(g)
  0
}

// Each value literal or map store `g` writes a slot, where it is a call that can return a record or
// a read of a `const` call holder: a slot record's candidate. Read off the literal or store itself,
// so the candidate set depends on no other index having been built.
function elabResScanSlots(g: i32) {
  const n = nodeAt(g)
  if n is ArrayLit {
    for e in n.arrElems { elabResSlotValue(e) }
  } else if n is ObjLit {
    for fx in n.objFields {
      const fv = nodeAt(fx)
      if fv is FieldInit { elabResSlotValue(fv.fiValue) }
    }
  } else if n is BinExpr && n.binOp == "=" && n.binCompound == "" {
    if nodeAt(parenPeelIx(n.binLeft)) is Index { elabResSlotValue(n.binRight) }
  } else if n is Call && n.callArgs.length == 2 {
    const fm = nodeAt(parenPeelIx(n.callFn))
    if fm is Member && fm.memProp == "set" { elabResSlotValue(n.callArgs[1]) }
  }
  0
}

// `elabResScanSlots` for value `e`.
function elabResSlotValue(e: i32) {
  const v = parenPeelIx(e)
  if v < 0 || v >= P.nodes.length { return 0 }
  if elabResMayReturnRecord(v) || elabSlotHolderOf(v) >= 0 {
    elabResSlotCalls.push(v)
  }
  0
}

// A `return` of a holder reads it whole.
function elabResScanRet(g: i32) {
  const n = nodeAt(g)
  if n is RetStmt {
    const a = parenPeelIx(n.retArg)
    if a >= 0 && a < P.nodes.length && nodeAt(a) is Ident {
      const d = identDeclOf(a)
      if elabResMayHold(d) {
        const rs = elabResRets.get(d) ?? []
        rs.push(g)
        elabResRets[d] = rs
      }
    }
  }
  0
}

// A binding initialised by a call holds that call's value; one initialised with a parameter's
// read is a copy of it.
function elabResScanLet(g: i32) {
  if elabResMayHold(g) {
    const n = nodeAt(g)
    if n is LetDecl {
      const v = parenPeelIx(n.letInit)
      if v >= 0 && v < P.nodes.length && nodeAt(v) is Call {
        elabResHolder[v] = g
        const ws = elabResWrites.get(g) ?? []
        ws.push(v)
        elabResWrites[g] = ws
      } else {
        const pd = identDeclOf(v)
        const cs = elabResCopies.get(pd) ?? []
        cs.push(g)
        elabResCopies[pd] = cs
      }
    }
  }
  0
}

// An assignment to a `let` holder writes it; only a plain assignment of a call is a producer.
function elabResScanAssign(g: i32) {
  const n = nodeAt(g)
  if n is BinExpr && (n.binOp == "=" || n.binCompound != "") {
    const l = parenPeelIx(n.binLeft)
    const d = if l >= 0 && nodeAt(l) is Ident { identDeclOf(l) } else { -1 }
    if elabResMayHold(d) {
      const v = parenPeelIx(n.binRight)
      if (
        n.binOp == "="
        && n.binCompound == ""
        && v >= 0
        && elabResMayReturnRecord(v)
      ) {
        elabResHolder[v] = d
        const ws = elabResWrites.get(d) ?? []
        ws.push(v)
        elabResWrites[d] = ws
      } else if elabResHolderLink(g, d, v) {
        const fs = elabResAsgFrom.get(d) ?? []
        fs.push(identDeclOf(v))
        elabResAsgFrom[d] = fs
        const ts = elabResAsgTo.get(identDeclOf(v)) ?? []
        ts.push(d)
        elabResAsgTo[identDeclOf(v)] = ts
      } else {
        elabResBadWrite[d] = true
      }
    }
  }
  0
}

// Whether assignment `g` to holder `d`, in the function declaring `d`, writes it a read `v` of
// another call holder.
function elabResHolderLink(g: i32, d: i32, v: i32): boolean {
  const n = nodeAt(g)
  if !(n is BinExpr) || n.binOp != "=" || n.binCompound != "" { return false }
  if (
    v < 0
    || !(nodeAt(v) is Ident)
    || elabEnclosingFn(g) != elabEnclosingFn(d)
  ) {
    return false
  }
  const s = identDeclOf(v)
  s != d && elabResMayHold(s) && elabResCallHolder(s)
}

// A read counts against the binding it reads.
function elabResScanIdent(g: i32) {
  const n = nodeAt(g)
  if n is Ident {
    const d = identDeclOf(g)
    if elabResMayHold(d) { elabResReads[d] = (elabResReads.get(d) ?? 0) + 1 }
    if d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl {
      elabFnReads[d] = (elabFnReads.get(d) ?? 0) + 1
    }
  }
  0
}

// Whether declaration `d` can hold a record: a binding initialised by a call that can return a
// record, or an unannotated `const` initialised with a parameter's read. The scan banks reads of
// such a binding alone, as nothing else can be a holder.
function elabResMayHold(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const n = nodeAt(d)
  if !(n is LetDecl) || n.letInit < 0 { return false }
  const v = parenPeelIx(n.letInit)
  if v < 0 { return false }
  if nodeAt(v) is Call { return elabResMayReturnRecord(v) }
  if n.letKw != "const" || n.letType >= 0 || !(nodeAt(v) is Ident) {
    return false
  }
  const pd = identDeclOf(v)
  if pd < 0 || pd >= P.nodes.length { return false }
  nodeAt(pd) is Param || elabResCallHolder(pd)
}

// Whether declaration `d` is a binding initialised by a call that can return a record.
function elabResCallHolder(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const n = nodeAt(d)
  if !(n is LetDecl) || n.letInit < 0 { return false }
  const v = parenPeelIx(n.letInit)
  v >= 0 && v < P.nodes.length && elabResMayReturnRecord(v)
}

// The `const` call holder read `v` names, written only by its initialiser; -1 for any other node.
function elabSlotHolderOf(v: i32): i32 {
  const x = parenPeelIx(v)
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return -1 }
  const h = identDeclOf(x)
  const hn = if h >= 0 && h < P.nodes.length { nodeAt(h) } else { null }
  if !(hn is LetDecl) || hn.letKw != "const" || hn.letType >= 0 { return -1 }
  if !elabResCallHolder(h) || (elabResWrites.get(h) ?? []).length > 1 {
    return -1
  }
  h
}

// The call a slot's written value `v` stands for: itself, or a holder read's initialiser.
function elabSlotValueCall(v: i32): i32 {
  const h = elabSlotHolderOf(v)
  if h < 0 { return parenPeelIx(v) }
  const hn = nodeAt(h)
  if hn is LetDecl { parenPeelIx(hn.letInit) } else { -1 }
}

// Holder read `c`, stored into field `f` of the record binding `d` whose type closes the field at
// one function type: the holder holds its record whole, and the store takes the member of that
// type, by the rule a hand to a parameter of one closure type takes (`elabRecMemberAt`).
function elabSlotStoreMemberNote(c: i32, d: i32, f: string) {
  const h = elabSlotHolderOf(c)
  if h < 0 || !elabInPlainCode(c) { return 0 }
  const call = elabSlotValueCall(c)
  const rec = elabCallRecord(call, -1, 4)
  if rec.length < 2 { return 0 }
  const dt = nodeTyIxOf(d)
  const o = if dt >= 0 && dt < T.tys.length { tyAt(dt) } else { null }
  if !(o is TyObj) { return 0 }
  let ft = -1
  let k = 0
  while k < o.objFieldNames.length && k < o.objFieldTypes.length {
    if o.objFieldNames[k] == f { ft = o.objFieldTypes[k] }
    k = k + 1
  }
  if ft < 0 || ft >= T.tys.length || !(tyAt(ft) is TyFunc) || tyHasTyVar(ft) {
    return 0
  }
  const m = elabRecMemberAt(rec, ft)
  if m < 0 || !elabSlotHolderHolds(h, 1, rec) { return 0 }
  elabRecTable.push(rec)
  const at = elabRecTable.length - 1
  elabAnyRetRecord = true
  elabTriplePut(elabHolderRecs, h, -1, at)
  elabTriplePut(elabResKeeps, call, -1, 1)
  for t in elabResThrough.get(h) ?? [] {
    elabTriplePut(elabThroughMembers, t, -1, elabCallSigMember(t, rec))
  }
  elabStoreMembers[c] = m
  0
}

// Per holder read stored into a field of one closure type, the member of its record it stores.
let elabStoreMembers: {[i32]: i32} = Map()

// The member holder read `x` stores into a field of one closure type, or -2 for no such store.
export function elabStoreMemberOf(x: i32): i32 { elabStoreMembers.get(x) ?? -2 }

// Whether holder `h`, stored `stores` times into a slot of record `rec`, is read only by those
// stores and by calls through it at the record's signatures, all in its own function.
function elabSlotHolderHolds(h: i32, stores: i32, rec: i32[]): boolean {
  const through = elabResThrough.get(h) ?? []
  if through.length + stores != (elabResReads.get(h) ?? 0) { return false }
  const fd = elabEnclosingFn(h)
  for t in through {
    if elabEnclosingFn(t) != fd || elabCallSigMember(t, rec) < 0 {
      return false
    }
  }
  true
}

// Whether call `v` can return a record: its callee names a function with no return annotation,
// as only such an instance returns one.
function elabResMayReturnRecord(v: i32): boolean {
  const c = nodeAt(v)
  if !(c is Call) { return false }
  const cf = parenPeelIx(c.callFn)
  if cf < 0 || !(nodeAt(cf) is Ident) { return false }
  const fd = identDeclOf(cf)
  if fd < 0 || fd >= P.nodes.length { return false }
  const fn = nodeAt(fd)
  fn is FuncDecl && fn.fnRet < 0
}

// A call through a binding, and a call that is another call's callee.
function elabResScanCall(g: i32) {
  const n = nodeAt(g)
  if n is Call {
    const cf = parenPeelIx(n.callFn)
    if cf >= 0 && nodeAt(cf) is Ident {
      const d = identDeclOf(cf)
      if d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl {
        elabFnCalleeReads[d] = (elabFnCalleeReads.get(d) ?? 0) + 1
        if elabPlainCallee(g) >= 0 { elabResPlainCalls[g] = d }
      }
      if elabResMayHold(d) {
        const at = elabResThrough.get(d) ?? []
        at.push(g)
        elabResThrough[d] = at
      }
    }
    if cf >= 0 && nodeAt(cf) is Call { elabResCalleeOf[cf] = g }
    let i = 0
    while i < n.callArgs.length && i < 64 {
      const a = parenPeelIx(n.callArgs[i])
      if a >= 0 && nodeAt(a) is Call { elabResArgOf[a] = g * 64 + i }
      if a >= 0 && nodeAt(a) is Ident {
        const ad = identDeclOf(a)
        if elabResMayHold(ad) {
          const hs = elabResHands.get(ad) ?? []
          hs.push(g)
          hs.push(i)
          elabResHands[ad] = hs
        }
      }
      i = i + 1
    }
  }
  0
}

// A call that is a block's statement before its last drops its value.
function elabResScanBlock(g: i32) {
  const n = nodeAt(g)
  if n is Block && n.blkStmts.length > 1 {
    let i = 0
    while i + 1 < n.blkStmts.length {
      const st = parenPeelIx(n.blkStmts[i])
      if st >= 0 && nodeAt(st) is Call { elabResStmt[st] = true }
      i = i + 1
    }
  }
  0
}

// For each call outside every instance whose callee instance returns a parameter that holds a
// record, the member its value is used as: dropped as a statement, called at once, or held by a
// `const` every read of which is the callee of a call at one of the record's signatures.
function elabResultMembersNote() {
  for c in elabCallKeys.keys() {
    const row = elabCallKeys[c] ?? []
    let j = 0
    while j + 1 < row.length {
      elabResultMemberNote(c, row[j], row[j + 1])
      j = j + 2
    }
  }
  for c in elabCallKeys.keys() {
    const row = elabCallKeys[c] ?? []
    let j = 0
    while j + 1 < row.length {
      elabHolderRecordNote(c, row[j], row[j + 1])
      elabArgRecordNote(c, row[j], row[j + 1])
      j = j + 2
    }
  }
  if elabResCopies.length > 0 { elabCopyRecordsNote() }
  elabRetRecordKeepsNote()
  if elabResPlainCalls.length > 0 { elabPlainCallsNote() }
  for c in elabResSlotCalls { elabSlotRecordNote(c) }
  0
}

// Each call initialising a slot of a literal, whose callee can return a record (the candidates
// `elabSlotRecordNote` asks), in the order `elabRun` met them.
let elabResSlotCalls: i32[] = []
// Each slot `d.f` of an un-annotated record literal the `let` `d` binds, holding a returned record
// of members whole, keyed as the write scan keys slots (binding, path): an index into
// `elabRecTable`.
let elabSlotRecDecl: i32[] = []
let elabSlotRecField: string[] = []
let elabSlotRecAt: i32[] = []
// Each call through such a field's place, with the record it calls a member of.
let elabPlaceRecs: {[i32]: i32[]} = Map()

// Call `c` in plain code, initialising slot `d.f` or `d[]` of an un-annotated literal `let` `d`, keeps
// its record whole there when every write of the slot (`cwSlotWrittenValues`) is such a call and
// every read of `d` reads the slot (a call through it at one of the record's signatures, or a
// `const` read only by such calls), a sibling field, or a list's length.
function elabSlotRecordNote(c: i32) {
  if c < 0 || c >= P.nodes.length || !elabInPlainCode(c) { return 0 }
  cwIxBuild()
  if !cwIxCovers(c) { return 0 }
  const lit = cwIxUp[c]
  const uk0 = cwIxUpKind[c]
  let f = ""
  if uk0 == CW_UP_FIELD {
    const fx = cwIxUpAux[c]
    const fiv = if fx >= 0 && fx < P.nodes.length { nodeAt(fx) } else { null }
    if !(fiv is FieldInit) { return 0 }
    f = fiv.fiName
  } else if uk0 == CW_UP_ELEM {
    f = "[]"
  } else if uk0 == CW_UP_ASG_RHS || uk0 == CW_UP_ARG {
    f = "[]"
  } else {
    return 0
  }
  // A map's value is stored by `d[k] = c` or `d.set(k, c)` into a fresh `Map()`.
  const md = if uk0 == CW_UP_ASG_RHS || uk0 == CW_UP_ARG { elabMapStoreDecl(c) } else { -1 }
  const isMap = md >= 0
  if !isMap {
    if lit < 0 || !cwIxCovers(lit) || cwIxUpKind[lit] != CW_UP_LETINIT {
      return 0
    }
  }
  const isList = f == "[]" && !isMap
  const d = if isMap { md } else { cwIxUp[lit] }
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) { return 0 }
  // A binding annotated at one closure type for the field stores the member of that type.
  if dn.letType >= 0 {
    if !isMap && !isList { elabSlotStoreMemberNote(c, d, f) }
    return 0
  }
  if !isMap {
    const ln = nodeAt(lit)
    if isList && !(ln is ArrayLit) || !isList && !(ln is ObjLit) { return 0 }
  }
  if elabSlotFieldRecord(d, f).length > 0 { return 0 }
  const rec = elabCallRecord(elabSlotValueCall(c), -1, 4)
  if rec.length < 2 { return 0 }
  // Every value the slot is written is a call returning the same record.
  const vals: i32[] = []
  const ats: i32[] = []
  if cwSlotWrittenValues(d, [f], vals, ats) < 0 || vals.length == 0 { return 0 }
  // A value that reads a holder stands for the holder's call, and the holder is held whole.
  const linked: i32[] = []
  const stores: i32[] = []
  for v0 in vals {
    const v = elabSlotValueCall(v0)
    if (
      v < 0
      || v >= P.nodes.length
      || !(nodeAt(v) is Call)
      || !elabInPlainCode(v)
      || !elabInPlainCode(parenPeelIx(v0))
    ) {
      return 0
    }
    if !elabTyListSame(elabCallRecord(v, -1, 4), rec) { return 0 }
    const h = elabSlotHolderOf(v0)
    if h >= 0 {
      const li = i32ListIndexOf(linked, h)
      if li >= 0 {
        stores[li] = stores[li] + 1
      } else {
        linked.push(h)
        stores.push(1)
      }
    }
  }
  let li = 0
  while li < linked.length {
    if !elabSlotHolderHolds(linked[li], stores[li], rec) { return 0 }
    li = li + 1
  }
  const places: i32[] = []
  const ms: i32[] = []
  const holders: i32[] = []
  const ow = cwOccWalk(d)
  while cwOccNext(ow) {
    const k = cwIxKind[ow.row]
    const u = cwIxNode[ow.row]
    if k == CW_OCC_USE {
      if (
        cwUseInOtherFrame(u)
        || !cwIxCovers(u)
        || cwIxUpKind[u] != CW_UP_OBJ
      ) {
        return 0
      }
      const m = cwIxUp[u]
      const mn = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { null }
      // The slot's own place: the field `f`, any element of the list, or a map's value read by
      // index or `get`; its `set` is a write the slot's writes already hold.
      let own = false
      let place = m
      if isMap {
        if mn is Index {
          own = true
        } else if mn is Member && (mn.memProp == "get" || mn.memProp == "set") {
          const mk = if cwIxCovers(m) { cwIxUpKind[m] } else { -1 }
          if mk != CW_UP_CALLEE { return 0 }
          own = mn.memProp == "get"
          place = cwIxUp[m]
        } else if !(mn is Member) || mn.memProp != "has" {
          return 0
        }
      } else if isList {
        if mn is Index { own = true }
        else if !(mn is Member) || mn.memProp != "length" { return 0 }
      } else {
        if !(mn is Member) { return 0 }
        own = mn.memProp == f
      }
      if own && isMap {
        // A map's value reads as nullable: held by a `const` that is tested, called or copied.
        const pk = if place >= 0 && cwIxCovers(place) { cwIxUpKind[place] } else { -1 }
        if pk == CW_UP_ASG_LHS || pk == CW_UP_CMP { continue }
        // A call through the index read, narrowed by a null test, takes its member.
        if pk == CW_UP_CALLEE && mn is Index {
          const pm = elabCallSigMember(cwIxUp[place], rec)
          if pm < 0 { return 0 }
          places.push(cwIxUp[place])
          ms.push(pm)
          continue
        }
        if pk != CW_UP_LETINIT { return 0 }
        const nh = cwIxUp[place]
        if !elabSlotNulHolderOk(nh, rec, holders) { return 0 }
        holders.push(nh)
      } else if own {
        const uk = if cwIxCovers(m) { cwIxUpKind[m] } else { -1 }
        if uk == CW_UP_CALLEE {
          const pm = elabCallSigMember(cwIxUp[m], rec)
          if pm < 0 { return 0 }
          places.push(cwIxUp[m])
          ms.push(pm)
        } else if uk == CW_UP_LETINIT {
          if !elabSlotHolderOk(cwIxUp[m], rec) { return 0 }
          holders.push(cwIxUp[m])
        } else if uk != CW_UP_ASG_LHS {
          return 0
        }
      }
    } else if k != CW_OCC_BIND && k != CW_OCC_ASG {
      return 0
    }
  }
  elabRecTable.push(rec)
  const at = elabRecTable.length - 1
  elabSlotRecDecl.push(d)
  elabSlotRecField.push(f)
  elabSlotRecAt.push(at)
  elabAnyRetRecord = true
  for v in vals { elabTriplePut(elabResKeeps, elabSlotValueCall(v), -1, 1) }
  for h in linked {
    elabTriplePut(elabHolderRecs, h, -1, at)
    for t in elabResThrough.get(h) ?? [] {
      elabTriplePut(elabThroughMembers, t, -1, elabCallSigMember(t, rec))
    }
  }
  let i = 0
  while i < places.length {
    elabTriplePut(elabPlaceRecs, places[i], -1, at)
    elabTriplePut(elabThroughMembers, places[i], -1, ms[i])
    i = i + 1
  }
  for h in holders {
    elabTriplePut(elabHolderRecs, h, -1, at)
    for t in elabSlotHolderCalls(h) {
      if t >= 0 {
        elabTriplePut(elabThroughMembers, t, -1, elabCallSigMember(t, rec))
      }
    }
  }
  0
}

// The `let` binding a fresh `Map()` whose value call `c` stores, by `d[k] = c` or `d.set(k, c)`;
// -1 for any other call.
function elabMapStoreDecl(c: i32): i32 {
  const up = cwIxUp[c]
  const un = if up >= 0 && up < P.nodes.length { nodeAt(up) } else { null }
  let recv = -1
  if un is BinExpr && un.binOp == "=" {
    const l = nodeAt(parenPeelIx(un.binLeft))
    if l is Index { recv = parenPeelIx(l.idxArr) }
  } else if un is Call && cwIxUpAux[c] == 1 && un.callArgs.length == 2 {
    const fm = nodeAt(parenPeelIx(un.callFn))
    if fm is Member && fm.memProp == "set" { recv = parenPeelIx(fm.memObj) }
  }
  if recv < 0 || !(nodeAt(recv) is Ident) { return -1 }
  const d = identDeclOf(recv)
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) { return -1 }
  const mc = nodeAt(parenPeelIx(dn.letInit))
  if !(mc is Call) || mc.callArgs.length != 0 { return -1 }
  const mf = nodeAt(parenPeelIx(mc.callFn))
  if (
    mf is Ident
    && mf.identName == "Map"
    && identDeclOf(parenPeelIx(mc.callFn)) < 0
  ) {
    return d
  }
  -1
}

// Whether `const` binding `h`, holding a map's nullable value of record `rec`, is read only by a
// comparison, a call through it at one of the record's signatures, or the initialiser of a `const`
// copy (`elabSlotHolderOk`), which joins `copies`.
function elabSlotNulHolderOk(h: i32, rec: i32[], copies: i32[]): boolean {
  const hn = if h >= 0 && h < P.nodes.length { nodeAt(h) } else { null }
  if !(hn is LetDecl) || hn.letKw != "const" || hn.letType >= 0 { return false }
  const hw = cwOccWalk(h)
  while cwOccNext(hw) {
    const k = cwIxKind[hw.row]
    const u = cwIxNode[hw.row]
    if k == CW_OCC_USE {
      if cwUseInOtherFrame(u) || !cwIxCovers(u) { return false }
      const uk = cwIxUpKind[u]
      if uk == CW_UP_LETINIT {
        if !elabSlotHolderOk(cwIxUp[u], rec) { return false }
        copies.push(cwIxUp[u])
      } else if uk == CW_UP_CALLEE {
        if elabCallSigMember(cwIxUp[u], rec) < 0 { return false }
      } else if uk != CW_UP_CMP {
        return false
      }
    } else if k == CW_OCC_CALL {
      if elabCallSigMember(u, rec) < 0 { return false }
    } else if k != CW_OCC_BIND {
      return false
    }
  }
  true
}

// Whether `const` binding `h` holds record `rec` read from a slot: un-annotated, read only as the
// callee of a call at one of the record's signatures, in its own frame.
function elabSlotHolderOk(h: i32, rec: i32[]): boolean {
  const hn = if h >= 0 && h < P.nodes.length { nodeAt(h) } else { null }
  if !(hn is LetDecl) || hn.letKw != "const" || hn.letType >= 0 { return false }
  for t in elabSlotHolderCalls(h) {
    if t < 0 || elabCallSigMember(t, rec) < 0 { return false }
  }
  true
}

// The calls through binding `h`, each a call row of its own (`CW_OCC_CALL`) in `h`'s frame; a -1
// entry where `h` is read any other way.
function elabSlotHolderCalls(h: i32): i32[] {
  const out: i32[] = []
  const hw = cwOccWalk(h)
  while cwOccNext(hw) {
    const k = cwIxKind[hw.row]
    const u = cwIxNode[hw.row]
    const cn = if u >= 0 && u < P.nodes.length { nodeAt(u) } else { null }
    let t = -1
    if k == CW_OCC_CALL {
      if cn is Call && cn.callFn >= 0 && !cwUseInOtherFrame(cn.callFn) { t = u }
    } else if k == CW_OCC_USE {
      // A read that is a call's callee is the same call, filed by the read.
      const ok = cwIxCovers(u) && cwIxUpKind[u] == CW_UP_CALLEE
      if ok && !cwUseInOtherFrame(u) { t = cwIxUp[u] }
    } else if k == CW_OCC_BIND {
      continue
    }
    if t < 0 || !i32ListHas(out, t) { out.push(t) }
  }
  out
}

// The calls through parameter or binding `d`, the rows of its name that resolve to another binding
// left out; a -1 entry where `d` itself is read any other way.
export function elabBindingCalls(d: i32): i32[] {
  const out: i32[] = []
  const hw = cwOccWalk(d)
  while cwOccNext(hw) {
    const k = cwIxKind[hw.row]
    const u = cwIxNode[hw.row]
    const un = if u >= 0 && u < P.nodes.length { nodeAt(u) } else { null }
    if k == CW_OCC_CALL {
      if (
        un is Call
        && identDeclOf(parenPeelIx(un.callFn)) == d
        && !i32ListHas(out, u)
      ) {
        out.push(u)
      }
    } else if k == CW_OCC_USE && u >= 0 && identDeclOf(u) == d {
      const callee = cwIxCovers(u) && cwIxUpKind[u] == CW_UP_CALLEE
      const t = if callee { cwIxUp[u] } else { -1 }
      if t < 0 || !i32ListHas(out, t) { out.push(t) }
    }
  }
  out
}

// The calls a value of the set slot `path` (`e` an element, empty the value) of binding `d`
// carries in its type can reach: every call whose callee the check typed at that set or at a join
// holding all of its functions; empty when the slot's type carries none.
export function elabSlotSetCalls(d: i32, path: string[]): i32[] {
  const out: i32[] = []
  let t = if d >= 0 && d < P.nodes.length { nodeTyIxOf(d) } else { -1 }
  // A binding a rewrite declared carries its type on its annotation or its initializer.
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { nodeAt(0) }
  if fnTagSetOfTy(t) < 0 && dn is LetDecl {
    const at = if dn.letType >= 0 { nodeTyIxOf(dn.letType) } else { -1 }
    const it = if dn.letInit >= 0 { nodeTyIxOf(dn.letInit) } else { -1 }
    t = if fnTagSetOfTy(at) >= 0 { at } else if fnTagSetOfTy(it) >= 0 { it } else { t }
  }
  for k in path {
    if k == "e" && t >= 0 && t < T.tys.length && tyAt(t) is TyArray {
      t = tyArrayElemIx(t)
    } else {
      t = -1
    }
  }
  const s = fnTagSetOfTy(t)
  if s < 0 { return out }
  const ms = fnTagMembers(s)
  for c in fnTagCalls() {
    const cs = fnTagCallSetOf(c)
    if (
      cs >= 0
      && !i32ListHas(out, c)
      && (cs == s || elabMembersWithin(ms, fnTagMembers(cs)))
    ) {
      out.push(c)
    }
  }
  out
}

// Whether every function of `ms` is one of `of`: a value holding one of `ms` may reach a call
// through `of`'s set, a join wider than its own.
function elabMembersWithin(ms: i32[], of: i32[]): boolean {
  if ms.length == 0 { return false }
  for m in ms {
    if !i32ListHas(of, m) { return false }
  }
  true
}

// How many slots hold a returned record of members whole, and the binding of slot `i`: mono types
// each at its record before its walk.
export function elabSlotRecCount(): i32 { elabSlotRecDecl.length }
export function elabSlotRecDeclAt(i: i32): i32 {
  if i >= 0 && i < elabSlotRecDecl.length { elabSlotRecDecl[i] } else { -1 }
}

// The record signatures the elements of the binding list literal `lit` initialises hold whole;
// none where it initialises no such binding.
export function elabSlotRecordListSigs(lit: i32): i32[] {
  let i = 0
  while i < elabSlotRecDecl.length {
    const d = elabSlotRecDecl[i]
    const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
    const at = elabSlotRecAt[i]
    if (
      elabSlotRecField[i] == "[]"
      && dn is LetDecl
      && parenPeelIx(dn.letInit) == lit
      && at >= 0
      && at < elabRecTable.length
    ) {
      return elabRecTable[at]
    }
    i = i + 1
  }
  []
}

// The record signatures slot `d.f` of the `let` `d` holds whole; none where it holds none.
export function elabSlotFieldRecord(d: i32, f: string): i32[] {
  let i = 0
  while i < elabSlotRecDecl.length {
    if elabSlotRecDecl[i] == d && elabSlotRecField[i] == f {
      const at = elabSlotRecAt[i]
      if at >= 0 && at < elabRecTable.length { return elabRecTable[at] }
    }
    i = i + 1
  }
  []
}

// The record signatures call `c` through a field's place calls a member of, under instance `k`;
// none where it is no such call.
export function elabPlaceRecordAt(c: i32, k: i32): i32[] {
  const at = elabPairUnder(elabPlaceRecs, c, k)
  if at >= 0 && at < elabRecTable.length { elabRecTable[at] } else { [] }
}

// For each instance of a function whose parameter a call hands a record whole, each copy of that
// parameter in the function's own body holds the same record, keyed by that instance.
function elabCopyRecordsNote() {
  let k = 0
  while k < ekDecl.length {
    const dn = nodeAt(ekDecl[k])
    if dn is FuncDecl {
      let i = 0
      while i < dn.fnParams.length && i < 64 {
        const cs = elabResCopies.get(dn.fnParams[i]) ?? []
        const taken = cs.length > 0
          && (elabRecParams.get(elabBundleKey(k, i)) ?? false)
        const rec = if taken { elabBundleSigs.get(elabBundleKey(k, i)) ?? [] } else { [] }
        if rec.length >= 2 {
          for d in cs {
            if elabCopyInFn(d, ekDecl[k]) {
              elabHolderRecordWith(d, k, rec, -1)
            }
          }
        }
        i = i + 1
      }
    }
    k = k + 1
  }
  0
}

// Whether copy `d`, its calls through and its hands are all in function `fd`'s own body.
function elabCopyInFn(d: i32, fd: i32): boolean {
  if elabEnclosingFn(d) != fd { return false }
  for t in elabResThrough.get(d) ?? [] {
    if elabEnclosingFn(t) != fd { return false }
  }
  const hands = elabResHands.get(d) ?? []
  let j = 0
  while j < hands.length {
    if elabEnclosingFn(hands[j]) != fd { return false }
    j = j + 2
  }
  true
}

// For call `c` from instance `from` into instance `kc` returning a record: the member its value
// is used as, keyed by that instance (slice A's one-signature uses).
function elabResultMemberNote(c: i32, from: i32, kc: i32) {
  const rec = if kc >= 0 { elabReturnedBundleSigs(kc) } else { [] }
  elabResultMemberWith(c, from, rec)
}

// `elabResultMemberNote` for call `c` from instance `from` returning record `rec`.
function elabResultMemberWith(c: i32, from: i32, rec: i32[]) {
  if rec.length < 2 { return 0 }
  let m = -2
  if elabResStmt.get(c) ?? false { m = -1 }
  const outer = elabResCalleeOf.get(c) ?? -1
  if outer >= 0 { m = elabCallSigMember(outer, rec) }
  const h = elabResHolder.get(c) ?? -1
  if h >= 0 {
    const through = elabResThrough.get(h) ?? []
    const reads = through.length + elabResWriteReads(h)
    if !elabHolderWritesAgree(h, from, rec) {
      m = -2
    } else if through.length > 0 && reads == (elabResReads.get(h) ?? 0) {
      m = elabCallSigMember(through[0], rec)
      for t in through {
        if elabCallSigMember(t, rec) != m { m = -2 }
      }
      if m >= 0 { elabTriplePut(elabResHolderTys, h, from, rec[m]) }
    }
  }
  // An argument to a parameter bound to one closed function type takes that member.
  const packed = elabResArgOf.get(c) ?? -1
  if m == -2 && packed >= 0 {
    m = elabArgParamMember(packed / 64, packed % 64, from, rec)
  }
  // A value delivered where the checker expects one closed function type takes that member.
  if m == -2 { m = elabRecIndexOf(rec, callDstTyOf(c)) }
  // A dropped value is stored as 1 and a member as itself plus 2, so -1 reads as no fact.
  if m >= -1 { elabTriplePut(elabResMembers, c, from, m + 2) }
  if m >= 0 { elabTriplePut(elabResTys, c, from, rec[m]) }
  0
}

// The member of record `rec` call `outer` from instance `from` takes at argument `i`: the index
// of the closed function type its parameter is bound to, by the callee instance or, for a callee
// with no type parameter, by the parameter's annotation; -2 for none.
function elabArgParamMember(outer: i32, i: i32, from: i32, rec: i32[]): i32 {
  const hm = elabHandMemberOf(outer, i, from, rec)
  if hm >= 0 { return hm }
  const on = nodeAt(outer)
  if !(on is Call) { return -2 }
  const cf = parenPeelIx(on.callFn)
  if cf < 0 || cf >= P.nodes.length || !(nodeAt(cf) is Ident) { return -2 }
  const d = identDeclOf(cf)
  if d < 0 || d >= P.nodes.length { return -2 }
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || dn.fnTyParams.length > 0 || i >= dn.fnParams.length {
    return -2
  }
  const pn = nodeAt(dn.fnParams[i])
  if !(pn is Param) || pn.parType < 0 { return -2 }
  const t = nodeTyIxOf(pn.parType)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyFunc) { return -2 }
  let j = 0
  while j < rec.length {
    if tySame(rec[j], t) { return j }
    j = j + 1
  }
  -2
}

// The index in record `rec` of closed function type `t`, through a nullable; -2 for none.
function elabRecIndexOf(rec: i32[], t0: i32): i32 {
  if t0 < 0 || t0 >= T.tys.length { return -2 }
  const n = tyAt(t0)
  const t = if n is TyNullable { n.nInner } else { t0 }
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyFunc) || tyHasTyVar(t) {
    return -2
  }
  let j = 0
  while j < rec.length {
    if tySame(rec[j], t) { return j }
    j = j + 1
  }
  -2
}

// For call `c` from instance `from` into instance `kc` returning a record, held whole by a
// `const` called through at more than one of its signatures: the holder's record and each
// call's member, keyed by that instance.
function elabHolderRecordNote(c: i32, from: i32, kc: i32) {
  const h = elabResHolder.get(c) ?? -1
  if h < 0 || kc < 0 { return 0 }
  const rec = elabReturnedBundleSigs(kc)
  if rec.length < 2 { return 0 }
  elabHolderRecordWith(h, from, rec, c)
}

// Holder `h` in instance `from` holding record `rec`, written by call `c` (-1 for a copy of a
// parameter): its record and each call's member, where every read is a call through it or a hand.
function elabHolderRecordWith(h: i32, from: i32, rec: i32[], c: i32) {
  const through = elabResThrough.get(h) ?? []
  const hands = elabResHands.get(h) ?? []
  const rets = elabResRets.get(h) ?? []
  const copies = if c >= 0 { elabResCopies.get(h) ?? [] } else { [] }
  const reads = through.length
    + hands.length / 2
    + elabResWriteReads(h)
    + rets.length
    + copies.length
    + elabResLinkReads(h)
  if (
    reads != (elabResReads.get(h) ?? 0)
    || !elabHolderWritesAgree(h, from, rec)
    || !elabHolderLinksHold(h, from, rec)
  ) {
    return 0
  }
  if rets.length > 0 && !elabHolderCanHoldReturned(h, from, rec) { return 0 }
  if copies.length > 0 && !elabHolderCopiesHold(h, copies, rec) { return 0 }
  const ms: i32[] = []
  let two = hands.length > 0
    || c < 0
    || rets.length > 0
    || copies.length > 0
    || elabResLinkReads(h) > 0
  for t in through {
    const m = elabCallSigMember(t, rec)
    if m < 0 { return 0 }
    if ms.length > 0 && m != ms[0] { two = true }
    ms.push(m)
  }
  if !two { return 0 }
  // Each hand goes to a parameter its instance calls at the record's signatures.
  let j = 0
  while j + 1 < hands.length {
    const whole = elabHandTakesRecord(hands[j], hands[j + 1], from, rec)
    if !whole && elabHandMemberOf(hands[j], hands[j + 1], from, rec) < 0 {
      return 0
    }
    j = j + 2
  }
  elabRecTable.push(rec)
  const at = elabRecTable.length - 1
  elabTriplePut(elabHolderRecs, h, from, at)
  if c >= 0 { elabTriplePut(elabResKeeps, c, from, 1) }
  // Each copy holds the same record, and each call through it takes its member.
  for w in copies {
    elabTriplePut(elabHolderRecs, w, from, at)
    for t in elabResThrough.get(w) ?? [] {
      elabTriplePut(elabThroughMembers, t, from, elabCallSigMember(t, rec))
    }
  }
  let i = 0
  while i < through.length {
    elabTriplePut(elabThroughMembers, through[i], from, ms[i])
    i = i + 1
  }
  j = 0
  while j + 1 < hands.length {
    const hm = elabHandMemberOf(hands[j], hands[j + 1], from, rec)
    if hm >= 0 {
      const row = elabHandMembers.get(hands[j]) ?? []
      row.push(from)
      row.push(hands[j + 1])
      row.push(hm)
      elabHandMembers[hands[j]] = row
    } else {
      elabTriplePut(elabArgRecs, hands[j] * 64 + hands[j + 1], from, at)
    }
    j = j + 2
  }
  0
}

// Whether holder `h` in instance `from`, returned whole, holds record `rec`: every read is a call
// through it at one of the record's signatures, a write target or a `return`, there is no hand,
// and each is in the function declaring `h`. Pure, so a function's result fact can ask it.
function elabHolderCanHoldReturned(h: i32, from: i32, rec: i32[]): boolean {
  const through = elabResThrough.get(h) ?? []
  const rets = elabResRets.get(h) ?? []
  if rets.length == 0 || (elabResHands.get(h) ?? []).length > 0 { return false }
  const reads = through.length + elabResWriteReads(h) + rets.length
  if (
    reads != (elabResReads.get(h) ?? 0)
    || !elabHolderWritesAgree(h, from, rec)
  ) {
    return false
  }
  const fd = elabEnclosingFn(h)
  for r in rets {
    if elabEnclosingFn(r) != fd { return false }
  }
  for t in through {
    if elabEnclosingFn(t) != fd || elabCallSigMember(t, rec) < 0 {
      return false
    }
  }
  true
}

// Whether every copy in `copies` of holder `h` can hold record `rec`: it is read only by calls
// through it at the record's signatures, in its own function, which is the function declaring
// `h` or a lambda nested in it that captures `h`. Pure, so the holder and its copies are recorded
// together or not at all.
function elabHolderCopiesHold(h: i32, copies: i32[], rec: i32[]): boolean {
  const fd = elabEnclosingFn(h)
  for w in copies {
    const wf = elabEnclosingFn(w)
    const through = elabResThrough.get(w) ?? []
    if (
      !elabLambdaWithin(wf, fd)
      || through.length != (elabResReads.get(w) ?? 0)
    ) {
      return false
    }
    for t in through {
      if elabEnclosingFn(t) != wf || elabCallSigMember(t, rec) < 0 {
        return false
      }
    }
  }
  true
}

// Whether function `f` is `fd` or a lambda nested in it through lambdas alone; -1 is the top level.
function elabLambdaWithin(f: i32, fd: i32): boolean {
  let cur = f
  let guard = 0
  while cur != fd && guard < 64 {
    if cur < 0 || cur >= P.nodes.length { return false }
    const cn = nodeAt(cur)
    if !(cn is FuncDecl) || cn.fnName != "" { return false }
    cur = elabEnclosingFn(cur)
    guard = guard + 1
  }
  cur == fd
}

// The reads of holder `h` that link it to another holder: the target of an assignment from one,
// and the value of an assignment into one.
function elabResLinkReads(h: i32): i32 {
  (elabResAsgFrom.get(h) ?? []).length + (elabResAsgTo.get(h) ?? []).length
}

// Whether holder `h`, linked to other holders by assignments, holds record `rec` together with
// each of them: every one is a call holder read only by calls through it at the record's
// signatures, copies, links and write targets, written only by calls returning `rec`, all in the
// function declaring `h`, and a link's source has no link into it. True for an unlinked holder.
function elabHolderLinksHold(h: i32, from: i32, rec: i32[]): boolean {
  if elabResLinkReads(h) == 0 { return true }
  const group: i32[] = [h]
  for f in elabResAsgFrom.get(h) ?? [] { group.push(f) }
  for t in elabResAsgTo.get(h) ?? [] { group.push(t) }
  const fd = elabEnclosingFn(h)
  for g in group {
    if (
      (elabResAsgFrom.get(g) ?? []).length > 0
      && (elabResAsgTo.get(g) ?? []).length > 0
    ) {
      return false
    }
    if !elabHolderLinkedHolds(g, from, rec, fd) { return false }
  }
  true
}

// `elabHolderLinksHold` for one member `g` of a linked group declared in function `fd`.
function elabHolderLinkedHolds(
  g: i32,
  from: i32,
  rec: i32[],
  fd: i32,
): boolean {
  const through = elabResThrough.get(g) ?? []
  const copies = elabResCopies.get(g) ?? []
  if (
    elabEnclosingFn(g) != fd
    || (elabResHands.get(g) ?? []).length > 0
    || (elabResRets.get(g) ?? []).length > 0
    || !elabResCallHolder(g)
    || !elabHolderWritesAgree(g, from, rec)
    || (elabResWrites.get(g) ?? []).length == 0
    || !elabTyListSame(
      elabCallRecord((elabResWrites.get(g) ?? [])[0], from, 4),
      rec,
    )
  ) {
    return false
  }
  const reads = through.length
    + elabResWriteReads(g)
    + copies.length
    + elabResLinkReads(g)
  if reads != (elabResReads.get(g) ?? 0) { return false }
  if copies.length > 0 && !elabHolderCopiesHold(g, copies, rec) { return false }
  for t in through {
    if elabEnclosingFn(t) != fd || elabCallSigMember(t, rec) < 0 {
      return false
    }
  }
  true
}

// The reads of holder `h` that are the targets of its assignments.
function elabResWriteReads(h: i32): i32 {
  const n = (elabResWrites.get(h) ?? []).length
  if n > 1 { n - 1 } else { 0 }
}

// Whether every write of holder `h` from instance `from` is a call returning record `rec`, in
// its order, inside the function that declares `h`. A `const` has its initialiser alone.
function elabHolderWritesAgree(h: i32, from: i32, rec: i32[]): boolean {
  const ws = elabResWrites.get(h) ?? []
  if ws.length < 2 { return true }
  if elabResBadWrite.get(h) ?? false { return false }
  const fd = elabEnclosingFn(h)
  for w in ws {
    if elabEnclosingFn(w) != fd { return false }
    if !elabTyListSame(elabCallRecord(w, from, 4), rec) { return false }
  }
  for t in elabResThrough.get(h) ?? [] {
    if elabEnclosingFn(t) != fd { return false }
  }
  const hands = elabResHands.get(h) ?? []
  let j = 0
  while j < hands.length {
    if elabEnclosingFn(hands[j]) != fd { return false }
    j = j + 2
  }
  true
}

// The function declaration whose body holds node `x`; -1 at the top level, -2 where the parent
// table does not reach `x`.
function elabEnclosingFn(x: i32): i32 {
  if x < 0 || !cwIxCovers(x) { return -2 }
  let cur = cwIxParent[x]
  let guard = 0
  while cur >= 0 && guard < 4096 {
    if cur >= P.nodes.length || !cwIxCovers(cur) { return -2 }
    if nodeAt(cur) is FuncDecl { return cur }
    cur = cwIxParent[cur]
    guard = guard + 1
  }
  if guard >= 4096 { -2 } else { -1 }
}

// The member of record `rec` call `x` from instance `from` hands at argument `i` to a parameter
// bound to one closed function type, or -1 where the parameter is no such one.
function elabHandMemberOf(x: i32, i: i32, from: i32, rec: i32[]): i32 {
  const ko = elabCallInstFrom(x, from)
  if ko < 0 || i >= 64 { return -1 }
  if (elabBundleSigs.get(elabBundleKey(ko, i)) ?? []).length >= 2 { return -1 }
  elabRecMemberAt(rec, elabBundleKeyClosedFn(elabBundleKey(ko, i)))
}

// The member of record `rec` whose closure type is `t`: its index, or -1 where none is.
function elabRecMemberAt(rec: i32[], t: i32): i32 {
  if t < 0 { return -1 }
  let j = 0
  while j < rec.length {
    if tySame(rec[j], t) { return j }
    j = j + 1
  }
  -1
}

// Whether call `x` from instance `from` takes record `rec` whole at argument `i`: the callee
// instance calls that parameter at exactly the record's signatures, whose order it then takes.
function elabHandTakesRecord(x: i32, i: i32, from: i32, rec: i32[]): boolean {
  const ko = elabCallInstFrom(x, from)
  if ko < 0 || i >= 64 { return false }
  const want = elabBundleSigs.get(elabBundleKey(ko, i)) ?? []
  if !elabSigsPermute(want, rec) { return false }
  elabBundleSigs[elabBundleKey(ko, i)] = rec.slice(0)
  elabRecParams[elabBundleKey(ko, i)] = true
  true
}

// For call `c` from instance `from` into instance `kc` returning a record, handed as an
// argument to a parameter whose instance calls it at the same signatures: the call keeps the
// record whole, and the outer call's argument is noted as delivering it.
function elabArgRecordNote(c: i32, from: i32, kc: i32) {
  if kc < 0 { return 0 }
  elabArgRecordWith(c, from, elabReturnedBundleSigs(kc))
}

// `elabArgRecordNote` for call `c` from instance `from` returning record `rec`.
function elabArgRecordWith(c: i32, from: i32, rec: i32[]) {
  const packed = elabResArgOf.get(c) ?? -1
  if packed < 0 || rec.length < 2 { return 0 }
  const outer = packed / 64
  const ai = packed % 64
  const ko = elabCallInstFrom(outer, from)
  if ko < 0 { return 0 }
  const want = elabBundleSigs.get(elabBundleKey(ko, ai)) ?? []
  if !elabSigsPermute(want, rec) { return 0 }
  // The parameter takes the record as it is built, so its signatures take the record's order.
  elabBundleSigs[elabBundleKey(ko, ai)] = rec.slice(0)
  elabRecParams[elabBundleKey(ko, ai)] = true
  elabRecTable.push(rec)
  elabTriplePut(elabResKeeps, c, from, 1)
  elabTriplePut(elabArgRecs, packed, from, elabRecTable.length - 1)
  0
}

// Whether signature lists `a` and `b` hold the same types, in any order.
function elabSigsPermute(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  for t in a {
    let have = false
    for u in b {
      if tySame(t, u) { have = true }
    }
    if !have { return false }
  }
  true
}

// Per (call, argument) key `call * 64 + i`, pairs of the instance and the record the argument
// delivers whole.
let elabArgRecs: {[i32]: i32[]} = Map()

// The record signatures call `ix`'s argument `i` delivers whole under the instance being
// walked; none where it delivers no record.
export function elabCallArgRecordSigs(ix: i32, i: i32): i32[] {
  const from = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  const at = if i >= 0 && i < 64 { elabPairUnder(elabArgRecs, ix * 64 + i, from) } else { -1 }
  if at >= 0 && at < elabRecTable.length { elabRecTable[at] } else { [] }
}

// Each holder's record (an index into `elabRecTable`), each call whose value a holder keeps
// whole, and each call through a holder's member, as pairs of the instance and the value.
let elabHolderRecs: {[i32]: i32[]} = Map()
let elabResKeeps: {[i32]: i32[]} = Map()
let elabThroughMembers: {[i32]: i32[]} = Map()
let elabRecTable: i32[][] = []

// Adds the pair (`k`, `v`) to node `x`'s row in `tab`.
function elabTriplePut(tab: {[i32]: i32[]}, x: i32, k: i32, v: i32) {
  const row = tab.get(x) ?? []
  row.push(k)
  row.push(v)
  tab[x] = row
  0
}

// The value `tab` holds for node `x` under instance `k` or the nearest instance enclosing it,
// else under no instance; -1 where none is.
function elabPairUnder(tab: {[i32]: i32[]}, x: i32, k: i32): i32 {
  const row = tab.get(x) ?? []
  if row.length == 0 { return -1 }
  let a = k
  let guard = 0
  while guard < 64 {
    let j = 0
    while j + 1 < row.length {
      if row[j] == a { return row[j + 1] }
      j = j + 2
    }
    if a < 0 || a >= ekParent.length { return -1 }
    a = ekParent[a]
    guard = guard + 1
  }
  -1
}

// Whether `const` binding `d` holds a returned record whole under any instance.
export function elabHoldsRecordAnywhere(d: i32): boolean {
  elabHolderRecs.has(d)
}

// The record signatures `const` binding `d` holds whole under instance `k`; none where it holds
// no record.
export function elabHolderRecordAt(d: i32, k: i32): i32[] {
  const at = elabPairUnder(elabHolderRecs, d, k)
  if at >= 0 && at < elabRecTable.length { elabRecTable[at] } else { [] }
}

// Whether call `c`'s value, under instance `k`, is a record a holder keeps whole.
export function elabCallKeepsRecordAt(c: i32, k: i32): boolean {
  elabPairUnder(elabResKeeps, c, k) == 1
}

// The member of its holder's record call `c` through it calls under instance `k`, or -1.
export function elabThroughMemberAt(c: i32, k: i32): i32 {
  elabPairUnder(elabThroughMembers, c, k)
}

// The record signatures instance `k` returns a parameter holding, whole; none where it returns
// no such parameter.
function elabReturnedBundleSigs(k: i32): i32[] { elabReturnedSigsAt(k, 4) }

// `elabReturnedBundleSigs` through at most `depth` functions returning another's call.
function elabReturnedSigsAt(k: i32, depth: i32): i32[] {
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || dn.fnRet >= 0 { return [] }
  let i = 0
  while i < dn.fnParams.length && i < 64 {
    const sigs = elabBundleSigs.get(elabBundleKey(k, i)) ?? []
    if sigs.length >= 2 && elabBodyReturnsParam(dn.fnBody, dn.fnParams[i]) {
      return sigs
    }
    i = i + 1
  }
  elabRetCallRecord(k, depth)
}

// The record call `c` from instance `from` returns: its callee instance's, or a plain callee's
// (`elabPlainRetRecord`); none where it returns no record.
function elabCallRecord(c: i32, from: i32, depth: i32): i32[] {
  const kc = elabCallInstFrom(c, from)
  if kc >= 0 { return elabReturnedSigsAt(kc, depth) }
  const d = elabPlainCallee(c)
  if d >= 0 { elabPlainRetRecord(d, depth) } else { [] }
}

// The plain function call `c` names: a declaration with no type parameter, every parameter
// annotated and no return annotation, which the elaboration does not instance; else -1.
function elabPlainCallee(c: i32): i32 {
  const cn = nodeAt(c)
  if !(cn is Call) { return -1 }
  const cf = parenPeelIx(cn.callFn)
  if cf < 0 || !(nodeAt(cf) is Ident) { return -1 }
  const d = identDeclOf(cf)
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || dn.fnRet >= 0 || dn.fnTyParams.length > 0 {
    return -1
  }
  for p in dn.fnParams {
    const pn = nodeAt(p)
    if !(pn is Param) || pn.parType < 0 { return -1 }
  }
  d
}

// Whether function `d` may return a record as a call's value: named, not exported, read only
// as a callee, with no return annotation.
function elabRetRecordShape(d: i32): boolean {
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || dn.fnName == "" || dn.fnRet >= 0 { return false }
  if (elabFnReads.get(d) ?? 0) != (elabFnCalleeReads.get(d) ?? 0) {
    return false
  }
  !declIsExportedFn(d)
}

// The one record every value body `body` returns is, each a call from instance `from`; none
// where any is another value or the records disagree.
function elabRetValuesRecord(body: i32, from: i32, depth: i32): i32[] {
  const none: i32[] = []
  const rets: i32[] = []
  if !elabRetValues(body, rets) || rets.length == 0 { return none }
  let rec: i32[] = []
  for c in rets {
    const hc = elabRetHolderCall(c)
    const r = elabCallRecord(if hc >= 0 { hc } else { c }, from, depth - 1)
    if r.length < 2 || rec.length > 0 && !elabTyListSame(r, rec) { return none }
    if hc >= 0 && !elabHolderCanHoldReturned(identDeclOf(c), from, r) {
      return none
    }
    rec = r
  }
  rec
}

// The record instance `k` returns as a call's value (`elabRetRecordShape`); none otherwise.
function elabRetCallRecord(k: i32, depth: i32): i32[] {
  const none: i32[] = []
  if depth <= 0 || k < 0 || k >= ekDecl.length { return none }
  const memo = elabRetRecMemo.get(k)
  if memo is i32[] { return memo }
  elabRetRecMemo[k] = none
  const d = ekDecl[k]
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || !elabRetRecordShape(d) { return none }
  const rec = elabRetValuesRecord(dn.fnBody, k, depth)
  elabRetRecMemo[k] = rec
  rec
}

// The record plain function `d` returns as a call's value, its calls made outside every
// instance; none otherwise.
function elabPlainRetRecord(d: i32, depth: i32): i32[] {
  const none: i32[] = []
  if depth <= 0 { return none }
  const memo = elabPlainRecMemo.get(d)
  if memo is i32[] { return memo }
  elabPlainRecMemo[d] = none
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || !elabRetRecordShape(d) { return none }
  const rec = elabRetValuesRecord(dn.fnBody, -1, depth)
  elabPlainRecMemo[d] = rec
  // A maker handing back a record of members is built whole, never at the one member's result
  // a destination or a use names (D15243).
  if rec.length >= 2 { elabMakerBlock(d) }
  rec
}

// Appends to `out` every value function body `body` returns, by `return` or as its last
// statement, nested functions aside; false where one is not a call, a `return` is bare, or the
// body ends in another statement.
function elabRetValues(body: i32, out: i32[]): boolean {
  if body < 0 || !(nodeAt(body) is Block) { return false }
  const b = nodeAt(body)
  if !(b is Block) || b.blkStmts.length == 0 { return false }
  const t = parenPeelIx(b.blkStmts[b.blkStmts.length - 1])
  if t < 0 { return false }
  if nodeAt(t) is Call { out.push(t) }
  else if !(nodeAt(t) is RetStmt) { return false }
  elabStmtRetValues(body, out)
}

// The initialiser call of the holder returned read `a` names, or -1 where `a` is no such read.
function elabRetHolderCall(a: i32): i32 {
  if a < 0 || a >= P.nodes.length || !(nodeAt(a) is Ident) { return -1 }
  const d = identDeclOf(a)
  if d < 0 || d >= P.nodes.length || !elabResMayHold(d) { return -1 }
  const dn = nodeAt(d)
  if !(dn is LetDecl) { return -1 }
  const v = parenPeelIx(dn.letInit)
  if v >= 0 && v < P.nodes.length && nodeAt(v) is Call { v } else { -1 }
}

// `elabRetValues`'s `return`s inside statement `x`.
function elabStmtRetValues(x: i32, out: i32[]): boolean {
  if x < 0 || x >= P.nodes.length { return true }
  const n = nodeAt(x)
  if n is RetStmt {
    const a = parenPeelIx(n.retArg)
    if a < 0 || a >= P.nodes.length { return false }
    if !(nodeAt(a) is Call) && elabRetHolderCall(a) < 0 { return false }
    out.push(a)
    return true
  }
  if (
    n is Block
    || n is IfStmt
    || n is WhileStmt
    || n is ForIn
    || n is ForRange
  ) {
    for k in nodeChildren(x) {
      if !elabStmtRetValues(k, out) { return false }
    }
  }
  true
}

// Each call to a plain function returning a record, as the other notes take a call into an
// instance: its member, its holder and its hand to a parameter, in each instance of its caller.
function elabPlainCallsNote() {
  for c in elabResPlainCalls.keys() {
    const d = elabResPlainCalls[c] ?? -1
    const rec = if d >= 0 { elabPlainRetRecord(d, 4) } else { [] }
    const froms = if rec.length >= 2 { elabCallerKeys(c) } else { [] }
    if froms.length > 0 {
      elabAnyRetRecord = true
      for from in froms {
        elabResultMemberWith(c, from, rec)
        const h = elabResHolder.get(c) ?? -1
        if h >= 0 { elabHolderRecordWith(h, from, rec, c) }
        elabArgRecordWith(c, from, rec)
      }
      const dn = nodeAt(d)
      const rets: i32[] = []
      if dn is FuncDecl && elabRetValues(dn.fnBody, rets) {
        for r in rets {
          if nodeAt(r) is Call { elabTriplePut(elabResKeeps, r, -1, 1) }
        }
      }
    }
  }
  0
}

// The keys node `x` runs under: -1 in plain code, else each instance of the nearest named
// function enclosing it, through any lambdas.
function elabCallerKeys(x: i32): i32[] {
  if elabInPlainCode(x) { return [-1] }
  let f = elabEnclosingFn(x)
  let guard = 0
  while f >= 0 && f < P.nodes.length && guard < 64 {
    const ln = nodeAt(f)
    if !(ln is FuncDecl) || ln.fnName != "" { break }
    f = elabEnclosingFn(f)
    guard = guard + 1
  }
  const out: i32[] = []
  if f < 0 || f >= P.nodes.length { return out }
  const fn = nodeAt(f)
  if !(fn is FuncDecl) || fn.fnName == "" { return out }
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == f { out.push(k) }
    k = k + 1
  }
  out
}

// Whether node `x` is outside every instanced function: at the top level or in a plain one.
function elabInPlainCode(x: i32): boolean {
  let f = elabEnclosingFn(x)
  let guard = 0
  while f >= 0 && guard < 64 {
    const fn = nodeAt(f)
    // A lambda's body runs under the keys of the function enclosing it.
    if fn is FuncDecl && fn.fnName == "" {
      f = elabEnclosingFn(f)
      guard = guard + 1
      continue
    }
    if !(fn is FuncDecl) || fn.fnTyParams.length > 0 { return false }
    for p in fn.fnParams {
      const pn = nodeAt(p)
      if !(pn is Param) || pn.parType < 0 { return false }
    }
    f = elabEnclosingFn(f)
    guard = guard + 1
  }
  f == -1
}

// Each call instance `k` returns as its record, from instance `k`, keeps that record whole.
function elabRetRecordKeepsNote() {
  let k = 0
  while k < ekDecl.length {
    const dn = nodeAt(ekDecl[k])
    if dn is FuncDecl && dn.fnName != "" && dn.fnRet < 0 {
      if elabRetCallRecord(k, 4).length >= 2 {
        const rets: i32[] = []
        if elabRetValues(dn.fnBody, rets) {
          for c in rets {
            if nodeAt(c) is Call { elabTriplePut(elabResKeeps, c, k, 1) }
          }
          elabAnyRetRecord = true
        }
      }
    }
    k = k + 1
  }
  0
}

// Whether any instance returns a record as a call's value.
export function elabHasRetRecords(): boolean { elabAnyRetRecord }

// The record signatures instance `k` returns as a call's value, for emit's pick at its callers;
// none where it returns no such record.
export function elabFnReturnsRecordAt(k: i32): i32[] {
  if !elabAnyRetRecord || k < 0 || k >= ekDecl.length { return [] }
  elabRetRecMemo.get(k) ?? []
}

// The record plain function `d` returns as a call's value, for emit's pick at its callers.
export function elabPlainReturnsRecord(d: i32): i32[] {
  if !elabAnyRetRecord { return [] }
  elabPlainRecMemo.get(d) ?? []
}

// Whether function body `body` returns parameter `par` whole, by `return` or as its last
// statement; nested functions aside.
function elabBodyReturnsParam(body: i32, par: i32): boolean {
  if body < 0 { return false }
  const b = nodeAt(body)
  if b is Block && b.blkStmts.length > 0 {
    const t = parenPeelIx(b.blkStmts[b.blkStmts.length - 1])
    if t >= 0 && nodeAt(t) is Ident && identDeclOf(t) == par { return true }
  }
  elabStmtReturnsParam(body, par)
}

// Whether statement `x` holds a `return` of parameter `par`, nested functions aside.
function elabStmtReturnsParam(x: i32, par: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  if n is RetStmt {
    const a = parenPeelIx(n.retArg)
    return a >= 0 && nodeAt(a) is Ident && identDeclOf(a) == par
  }
  if (
    n is Block
    || n is IfStmt
    || n is WhileStmt
    || n is ForIn
    || n is ForRange
  ) {
    for k in nodeChildren(x) {
      if elabStmtReturnsParam(k, par) { return true }
    }
  }
  false
}

// The index in `rec` of the signature call `c` is made at, by its arguments' closed types; -2
// where none is.
function elabCallSigMember(c: i32, rec: i32[]): i32 {
  const cn = nodeAt(c)
  if !(cn is Call) { return -2 }
  let j = 0
  while j < rec.length {
    const f = tyAt(rec[j])
    if f is TyFunc && f.fnParamTypes.length == cn.callArgs.length {
      let same = true
      let i = 0
      while i < cn.callArgs.length {
        const a = cn.callArgs[i]
        const et = elabNodeTy(a, -1)
        const at = widenLitTy(if et >= 0 { et } else { nodeTyIxOf(a) })
        if at < 0 || !tySame(at, f.fnParamTypes[i]) { same = false }
        i = i + 1
      }
      if same { return j }
    }
    j = j + 1
  }
  -2
}

// The member call `c`, under instance `k`, uses of the record its callee returns: its index, -1
// for a value dropped, -2 where the elaboration noted none.
export function elabCallResultMember(c: i32, k: i32): i32 {
  if !elabResMembers.has(c) { return -2 }
  const v = elabPairUnder(elabResMembers, c, k)
  if v < 0 { -2 } else { v - 2 }
}

// Whether call `c` has a member fact under some instance, asked before resolving one.
export function elabHasResultFact(c: i32): boolean { elabResMembers.has(c) }

// The function type call `c`'s value is, as the member of a returned record it is used as; -1.
export function elabCallResultTy(c: i32, k: i32): i32 {
  if elabResTys.has(c) { elabPairUnder(elabResTys, c, k) } else { -1 }
}

// Whether call `c`'s value is a member's type under some instance.
export function elabHasResultTy(c: i32): boolean { elabResTys.has(c) }

// The function type `const` binding `d` holds as one member of a returned record, or -1.
export function elabHolderMemberTy(d: i32, k: i32): i32 {
  if elabResHolderTys.has(d) {
    elabPairUnder(elabResHolderTys, d, k)
  } else {
    -1
  }
}

// Whether `const` binding `d` holds one member's type under some instance.
export function elabHasHolderMemberTy(d: i32): boolean {
  elabResHolderTys.has(d)
}

// Whether call `c`'s callee is a read of a named function.
function elabCallsNamedFn(c: i32): boolean {
  const cn = nodeAt(c)
  if !(cn is Call) { return false }
  const cf = parenPeelIx(cn.callFn)
  const d = if cf >= 0 && nodeAt(cf) is Ident { identDeclOf(cf) } else { -1 }
  d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl
}

// Whether every function each key of the chain rooted at `r` in `up` binds its parameter to, or
// is handed there by a call, has an instance at each of `sigs`. Each one that has none is a
// demand the next round of the elaboration makes (`elabJoinDemandNote`).
function elabChainMembersBuilt(
  up: Map<i32, i32>,
  r: i32,
  sigs: i32[],
): boolean {
  let ok = true
  const ks: i32[] = []
  for key in up.keys() {
    if elabBundleRoot(up, key) == r {
      if !elabKeyMembersBuilt(key, sigs) { ok = false }
      ks.push(key)
    }
  }
  for c in elabCallKeys.keys() {
    const row = elabCallKeys[c] ?? []
    let j = 0
    while j + 1 < row.length {
      if !elabCallArgsBuilt(c, row[j + 1], ks, sigs) { ok = false }
      j = j + 2
    }
  }
  ok
}

// Whether call `c` into instance `kc` hands, at each parameter whose key is in `ks`, a lambda or
// named function with an instance at each of `sigs`; a parameter it hands is the chain's own.
function elabCallArgsBuilt(c: i32, kc: i32, ks: i32[], sigs: i32[]): boolean {
  const cn = nodeAt(c)
  if !(cn is Call) { return true }
  let ok = true
  let i = 0
  while i < cn.callArgs.length && i < 64 {
    if i32ListHas(ks, elabBundleKey(kc, i)) {
      const a = parenPeelIx(cn.callArgs[i])
      const d = if a >= 0 && nodeAt(a) is Ident { identDeclOf(a) } else { a }
      if d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl {
        if !elabMembersAt(d, sigs) { ok = false }
      }
    }
    i = i + 1
  }
  ok
}

// Whether every function parameter key `key`'s instance binds the parameter to has an instance at
// each of `sigs`.
function elabKeyMembersBuilt(key: i32, sigs: i32[]): boolean {
  const k = key / 64
  const i = key % 64
  if k < 0 || k >= ekDecl.length { return false }
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || i >= dn.fnParams.length { return false }
  const ds = elabFnSetOf(
    substTyDeep(nodeTyIxOf(dn.fnParams[i]), ekNames[k], ekTys[k]),
  )
  let ok = true
  for d in ds {
    if !elabMembersAt(d, sigs) { ok = false }
  }
  ok
}

// Whether function `d` has an instance at each of `sigs`; each one it has none at is noted as a
// demand.
function elabMembersAt(d: i32, sigs: i32[]): boolean {
  let ok = true
  for t in sigs {
    const f = tyAt(t)
    if !(f is TyFunc) {
      ok = false
    } else if elabMemberKeyAt(d, f.fnParamTypes) < 0 {
      elabJoinDemandNote(d, f.fnParamTypes)
      ok = false
    }
  }
  ok
}

// The instances a chain's join found missing, carried from one round of the elaboration to the
// next and enqueued at its start: each function and the parameter types it is wanted at.
let elabJoinDemDecls: i32[] = []
let elabJoinDemTys: i32[][] = []
let elabJoinDemNew = false
let elabJoinRounds = 0

// Clears the carried demands, once per preparation of a program.
export function elabJoinDemandsReset() {
  elabJoinDemDecls = []
  elabJoinDemTys = []
  elabJoinDemNew = false
  elabJoinRounds = 0
  0
}

// Whether the last join noted a demand no earlier round carried, which a further round makes;
// counted in `elabJoinRoundsOf`.
export function elabJoinDemandsTake(): boolean {
  const grew = elabJoinDemNew
  elabJoinDemNew = false
  if grew { elabJoinRounds = elabJoinRounds + 1 }
  grew
}

// The rounds this preparation took for the join's demands.
export function elabJoinRoundsOf(): i32 { elabJoinRounds }

// Notes function `d` wanted at parameter types `pts`, once.
function elabJoinDemandNote(d: i32, pts: i32[]) {
  let i = 0
  while i < elabJoinDemDecls.length && i < elabJoinDemTys.length {
    if elabJoinDemDecls[i] == d && elabTyListSame(elabJoinDemTys[i], pts) {
      return 0
    }
    i = i + 1
  }
  elabJoinDemDecls.push(d)
  elabJoinDemTys.push(pts.slice(0))
  elabJoinDemNew = true
  0
}

// Whether type lists `a` and `b` hold the same types in order.
function elabTyListSame(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  let j = 0
  while j < a.length {
    if !tySame(a[j], b[j]) { return false }
    j = j + 1
  }
  true
}

// Enqueues each carried demand, so this round mints it on time.
function elabJoinDemandsEnqueue() {
  let i = 0
  while i < elabJoinDemDecls.length && i < elabJoinDemTys.length {
    elabEnqueueAtParams(elabJoinDemDecls[i], elabJoinDemTys[i])
    i = i + 1
  }
  0
}

// The parameter key of declaration `d` as instance `k` reads it: `k`'s own parameter, else that
// of the enclosing instance whose function declares it; -1 where `d` is no such parameter.
function elabParamOwnerKey(d: i32, k: i32): i32 {
  let a = k
  let guard = 0
  while a >= 0 && a < ekDecl.length && guard < 64 {
    const dn = nodeAt(ekDecl[a])
    if dn is FuncDecl {
      const pi = i32ListIndexOf(dn.fnParams, d)
      if pi >= 0 { return if pi < 64 { elabBundleKey(a, pi) } else { -1 } }
    }
    a = ekParent[a]
    guard = guard + 1
  }
  -1
}

// For each hand of a record to a parameter bound to one closed function type, the record member
// whose signature that type is, or -1 where none is; for every hand, the key of the parameter it
// reads.
function elabHandMembersNote(hands: i32[]) {
  let h = 0
  while h + 4 < hands.length {
    const orow = elabHandOwners.get(hands[h]) ?? []
    orow.push(hands[h + 1])
    orow.push(hands[h + 2])
    orow.push(hands[h + 3])
    elabHandOwners[hands[h]] = orow
    const rec = elabBundleSigs.get(hands[h + 3]) ?? []
    const t = elabBundleKeyClosedFn(hands[h + 4])
    if rec.length >= 2 && t >= 0 {
      let m = -1
      let j = 0
      while j < rec.length {
        if m < 0 && tySame(rec[j], t) { m = j }
        j = j + 1
      }
      const row = elabHandMembers.get(hands[h]) ?? []
      row.push(hands[h + 1])
      row.push(hands[h + 2])
      row.push(m)
      elabHandMembers[hands[h]] = row
    }
    h = h + 5
  }
  0
}

// Per call, triples of the instance, the argument and the member `elabHandMembersNote` chose.
let elabHandMembers: {[i32]: i32[]} = Map()
// Per call, triples of the instance, the argument and the key of the parameter it hands.
let elabHandOwners: {[i32]: i32[]} = Map()

// The key of the parameter call `ix`'s argument `i` hands whole, under the instance being walked:
// the caller's own parameter or a captured one; -1 where the argument hands none.
export function elabCallHandOwner(ix: i32, i: i32): i32 {
  elabTripleUnderWalk(elabHandOwners.get(ix) ?? [], i, -1)
}

// The key the instance being walked passes to call `ix`'s argument `i` as the callee's
// parameter, or -1.
export function elabCallParamKey(ix: i32, i: i32): i32 {
  const from = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  const k = elabCallInstFrom(ix, from)
  if k < 0 || i < 0 || i >= 64 { -1 } else { elabBundleKey(k, i) }
}

// The value `row`'s triple for the instance being walked and argument `i` holds, else `none`.
function elabTripleUnderWalk(row: i32[], i: i32, none: i32): i32 {
  const from = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  let j = 0
  while j + 2 < row.length {
    if row[j] == from && row[j + 1] == i { return row[j + 2] }
    j = j + 3
  }
  none
}

// The record member call `ix`'s argument `i`, under the instance being walked, hands to a
// parameter bound to one closure: its index, -1 where the record holds no member at that
// parameter's type, -2 where the argument is no such hand.
export function elabCallHandMember(ix: i32, i: i32): i32 {
  elabTripleUnderWalk(elabHandMembers.get(ix) ?? [], i, -2)
}

// Each parameter key `elabBundleForwardsJoin` gave a joined list, and the chain member whose set
// the chain takes (its root where no member binds one).
let elabBundleJoinRoot: {[i32]: i32} = Map()

// The set instance `key / 64` binds its parameter `key % 64` to, or -1.
function elabBundleKeySet(key: i32): i32 {
  const k = key / 64
  const i = key % 64
  if k < 0 || k >= ekDecl.length { return -1 }
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || i >= dn.fnParams.length { return -1 }
  fnTagSetOfTy(substTyDeep(nodeTyIxOf(dn.fnParams[i]), ekNames[k], ekTys[k]))
}

// The signatures parameter key `key` adds to its chain: those its instance's calls noted, else
// the one closed function type the instance binds the parameter to.
function elabBundleOwnSigs(key: i32): i32[] {
  const own = elabBundleSigs.get(key) ?? []
  if own.length > 0 { return own }
  const t = elabBundleKeyClosedFn(key)
  if t < 0 { own } else { [t] }
}

// The closed function type instance `key / 64` binds its parameter `key % 64` to, or -1.
function elabBundleKeyClosedFn(key: i32): i32 {
  const k = key / 64
  const i = key % 64
  if k < 0 || k >= ekDecl.length { return -1 }
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || i >= dn.fnParams.length { return -1 }
  const t = substTyDeep(nodeTyIxOf(dn.fnParams[i]), ekNames[k], ekTys[k])
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyFunc) || tyHasTyVar(t) {
    return -1
  }
  if elabTyClosed(t, 0) { t } else { -1 }
}

// The root of `key` in the union `up`; a key never united is its own.
function elabBundleRoot(up: Map<i32, i32>, key: i32): i32 {
  let r = key
  let guard = 0
  while guard < 4096 {
    const n = up.get(r) ?? r
    if n == r { return r }
    r = n
    guard = guard + 1
  }
  r
}

// Unites `a` and `b` in `up`, the smaller root standing for both.
function elabBundleUnite(up: Map<i32, i32>, a: i32, b: i32) {
  if !up.has(a) { up[a] = a }
  if !up.has(b) { up[b] = b }
  const ra = elabBundleRoot(up, a)
  const rb = elabBundleRoot(up, b)
  if ra < rb { up[rb] = ra }
  else if rb < ra { up[ra] = rb }
  0
}

// Notes the signature call `c` in instance `k` makes through `pd`, a parameter of a function
// enclosing `k`'s, for the bundle of the enclosing instance that binds it. Only members already
// instanced at the call's types count, so nothing is enqueued here.
function elabCapturedBundleSigNote(c: Call, pd: i32, k: i32) {
  let a = if k >= 0 && k < ekParent.length { ekParent[k] } else { -1 }
  let pi = -1
  let guard = 0
  while a >= 0 && pi < 0 && guard < 64 {
    const an = nodeAt(ekDecl[a])
    if an is FuncDecl { pi = i32ListIndexOf(an.fnParams, pd) }
    if pi < 0 { a = ekParent[a] }
    guard = guard + 1
  }
  if a < 0 || pi < 0 { return 0 }
  const st = elabNodeTy(parenPeelIx(c.callFn), k)
  const ds = elabFnSetOf(st)
  if ds.length == 0 || fnTagSetOfTy(st) < 0 { return 0 }
  const wp: i32[] = []
  for x in c.callArgs {
    const at = elabNodeTy(x, k)
    if at < 0 || !elabTyClosed(at, 0) { return 0 }
    wp.push(widenLitTy(at))
  }
  let r0 = -1
  for d in ds {
    const r = elabMemberResultAt(d, wp)
    if r < 0 { return 0 }
    if r0 >= 0 && !tySame(widenLitTy(r), r0) { return 0 }
    r0 = widenLitTy(r)
  }
  elabBundleSigNote(a, pi, ds, wp, r0)
}

// The key of instance `k`'s parameter `i` in `elabBundleSigs`.
function elabBundleKey(k: i32, i: i32): i32 { k * 64 + i }

// Whether function `d` is a member of some set beside a nested function its encloser's instance
// owns: that set is bundled, so every set holding `d` is decided the same way (D15446).
function elabBundledBeside(d: i32): boolean {
  let s = 0
  const n = fnTagSetCount()
  while s < n {
    const ms = fnTagMembers(s)
    if i32ListHas(ms, d) {
      for m in ms {
        if m != d && elabNestedInClosed(m) { return true }
      }
    }
    s = s + 1
  }
  false
}

// Whether declaration `d` is nested in functions none of which is generic or has an un-annotated
// parameter: its one body serves one encloser instance, so a closure per signature is its own.
function elabNestedInClosed(d: i32): boolean {
  let e = elabEncl.get(d) ?? -1
  if e < 0 { return false }
  let guard = 0
  while e >= 0 && guard < 64 {
    const en = nodeAt(e)
    if !(en is FuncDecl) || en.fnTyParams.length > 0 { return false }
    for p in en.fnParams {
      const pn = nodeAt(p)
      if !(pn is Param) || pn.parType < 0 { return false }
    }
    e = elabEncl.get(e) ?? -1
    guard = guard + 1
  }
  true
}

// Notes signature `wp` => `r` for a call instance `k` makes through its parameter `i` bound to
// a set `ds` of lambdas and nested functions, or of any functions where `k` is a lambda's instance.
function elabBundleSigNote(k: i32, i: i32, ds: i32[], wp: i32[], r: i32) {
  if ds.length == 0 || i < 0 || i >= 64 || k < 0 { return 0 }
  elabLamSigNote(k, i, mkFuncTy(wp.slice(0), r))
  const kd = nodeAt(ekDecl[k])
  const lamK = kd is FuncDecl && kd.fnName == ""
  // A set holding a nested function its encloser's instance owns is no tagged set's, so its named
  // members are bundled with it.
  let nested = false
  for d in ds {
    if elabNestedInClosed(d) || elabBundledBeside(d) { nested = true }
  }
  for d in ds {
    const m = nodeAt(d)
    if !(m is FuncDecl) || m.fnName != "" && !lamK && !nested { return 0 }
  }
  const sig = mkFuncTy(wp.slice(0), r)
  const key = elabBundleKey(k, i)
  const have = elabBundleSigs.get(key) ?? []
  for t in have {
    if tySame(t, sig) { return 0 }
  }
  have.push(sig)
  elabBundleSigs[key] = have
  0
}

// Notes signature `sig` for a call lambda instance `k` makes through its parameter `i`, whatever
// set the parameter holds; a lambda instanced twice keeps the union of its instances' calls.
function elabLamSigNote(k: i32, i: i32, sig: i32) {
  const d = ekDecl[k]
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || dn.fnName != "" { return 0 }
  const key = elabBundleKey(d, i)
  const have = elabLamSigs.get(key) ?? []
  for t in have {
    if tySame(t, sig) { return 0 }
  }
  have.push(sig)
  elabLamSigs[key] = have
  elabLamSigInst[key] = k
  0
}

// The signatures every instance of lambda `d` calls its parameter `i` at, each once, with the
// instance last noting one in `inst[0]`; none where it calls the parameter at fewer than two.
export function elabLamParamSigs(d: i32, i: i32, inst: i32[]): i32[] {
  const none: i32[] = []
  if d < 0 || i < 0 || i >= 64 { return none }
  const sigs = elabLamSigs.get(elabBundleKey(d, i)) ?? none
  if sigs.length < 2 { return none }
  inst[0] = elabLamSigInst.get(elabBundleKey(d, i)) ?? -1
  sigs
}

// The signatures call `ix`'s instance, reached from the instance being walked, calls the lambda
// handed to its parameter `i` at: two or more, with the lambda's set untagged; else none.
export function elabCallBundleSigs(ix: i32, i: i32): i32[] {
  const none: i32[] = []
  const from = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  const k = elabCallInstFrom(ix, from)
  if k < 0 || i < 0 || i >= 64 { return none }
  const sigs = elabBundleSigs.get(elabBundleKey(k, i)) ?? none
  if sigs.length < 2 { return none }
  // A parameter a forward joined takes its chain's record, so the set is the chain's.
  const root = elabBundleJoinRoot.get(elabBundleKey(k, i))
    ?? elabBundleKey(k, i)
  const rk = root / 64
  const ri = root % 64
  if rk < 0 || rk >= ekDecl.length { return none }
  const dn = nodeAt(ekDecl[rk])
  if !(dn is FuncDecl) || ri >= dn.fnParams.length { return none }
  const s = fnTagSetOfTy(
    substTyDeep(nodeTyIxOf(dn.fnParams[ri]), ekNames[rk], ekTys[rk]),
  )
  if s < 0 || fnTagSetIsTagged(s) { return none }
  // The callee reads the record only as a callee, or hands it whole to a named function: any
  // other read of the parameter wants one closure.
  const ck = elabCallParamKey(ix, i)
  const cd = nodeAt(ekDecl[k])
  if !(cd is FuncDecl) || i >= cd.fnParams.length { return none }
  if (
    elabBodyReadsOtherThanCalled(
      cd.fnBody,
      cd.fnParams[i],
      true,
      if ck >= 0 { ck / 64 } else { -1 },
    )
  ) {
    return none
  }
  sigs
}

// Whether node `x` or one beneath it reads parameter `par` other than as the callee of a call in
// its own function's body (`own`): handed on, stored, or read by a nested function. With `fwd`, a
// read handed whole to a named function as a positional argument is not counted, and with `cap` a
// call through it or such a hand in a nested function at any depth is not either.
export function elabParamReadOtherThanCalled(
  x: i32,
  par: i32,
  own: boolean,
  fwd: boolean,
  cap: boolean,
): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  if n is Ident { return identDeclOf(x) == par }
  if n is FuncDecl {
    for k in nodeChildren(x) {
      if elabParamReadOtherThanCalled(k, par, cap, cap, cap) { return true }
    }
    return false
  }
  if n is Call {
    const cf = parenPeelIx(n.callFn)
    const cd = if cf >= 0 && nodeAt(cf) is Ident { identDeclOf(cf) } else { -1 }
    const called = own && cd == par
    const named = own
      && fwd
      && cd >= 0
      && cd < P.nodes.length
      && (nodeAt(cd) is FuncDecl || elabConstFnCopy(cd))
    for k in nodeChildren(x) {
      const ku = parenPeelIx(k)
      const handed = named
        && i32ListHas(n.callArgs, k)
        && ku >= 0
        && nodeAt(ku) is Ident
        && identDeclOf(ku) == par
      if (
        !(called && ku == cf)
        && !handed
        && elabParamReadOtherThanCalled(k, par, own, fwd, cap)
      ) {
        return true
      }
    }
    return false
  }
  for k in nodeChildren(x) {
    if elabParamReadOtherThanCalled(k, par, own, fwd, cap) { return true }
  }
  false
}

// Whether `d` is a `const` binding whose value is a read of a named function.
function elabConstFnCopy(d: i32): boolean {
  const n = nodeAt(d)
  if !(n is LetDecl) || n.letKw != "const" { return false }
  const v = parenPeelIx(n.letInit)
  if v < 0 || !(nodeAt(v) is Ident) { return false }
  const fd = identDeclOf(v)
  fd >= 0 && fd < P.nodes.length && nodeAt(fd) is FuncDecl
}

// `elabParamReadOtherThanCalled` over function body `body`, where with `fwd` a return of `par`
// from the function itself, by `return` or as the body's last statement, is not counted either,
// nor is a copy the elaboration holds the record in under callee instance `hk`.
function elabBodyReadsOtherThanCalled(
  body: i32,
  par: i32,
  fwd: boolean,
  hk: i32,
): boolean {
  if body < 0 { return false }
  const b = nodeAt(body)
  if !(b is Block) {
    return elabParamReadOtherThanCalled(body, par, true, fwd, fwd)
  }
  if !fwd {
    for st in b.blkStmts {
      if (
        !elabCopyHeld(st, par, hk)
        && elabParamReadOtherThanCalled(st, par, true, false, false)
      ) {
        return true
      }
    }
    return false
  }
  let i = 0
  while i < b.blkStmts.length {
    const st = b.blkStmts[i]
    const last = i == b.blkStmts.length - 1
    if !(last && elabIsParamRead(st, par)) && elabStmtReadsOther(st, par, hk) {
      return true
    }
    i = i + 1
  }
  false
}

// Whether node `x` is a read of parameter `par`, under parentheses.
export function elabIsParamRead(x: i32, par: i32): boolean {
  const u = if x >= 0 { parenPeelIx(x) } else { -1 }
  u >= 0 && nodeAt(u) is Ident && identDeclOf(u) == par
}

// Whether statement `x` is a copy of parameter `par` the elaboration holds the record in under
// callee instance `hk`.
function elabCopyHeld(x: i32, par: i32, hk: i32): boolean {
  if hk < 0 || x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  n is LetDecl
    && elabIsParamRead(n.letInit, par)
    && elabHolderRecordAt(x, hk).length > 0
}

// `elabBodyReadsOtherThanCalled` for statement `x` of the function's own body.
function elabStmtReadsOther(x: i32, par: i32, hk: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  if n is RetStmt && elabIsParamRead(n.retArg, par) { return false }
  if elabCopyHeld(x, par, hk) { return false }
  if (
    n is Block
    || n is IfStmt
    || n is WhileStmt
    || n is ForIn
    || n is ForRange
  ) {
    for k in nodeChildren(x) {
      if elabStmtReadsOther(k, par, hk) { return true }
    }
    return false
  }
  elabParamReadOtherThanCalled(x, par, true, true, true)
}

// Notes the fact for call `c` at `ix` when its callee is a parameter of `decl` that instance `k`
// binds to a set of functions each instanced at the call's closed argument types.
function elabMintFactAt(c: Call, ix: i32, decl: i32, k: i32, sc: i32): boolean {
  const cf = parenPeelIx(c.callFn)
  const dn0 = nodeAt(decl)
  const root0 = elabSlotRoot(elabElemAliasInit(cf, decl))
  const root = if dn0 is FuncDecl { elabRecFieldRoot(root0, dn0) } else { root0 }
  const pd = elabCalleeParam(root, decl, k)
  if pd < 0 || pd >= P.nodes.length || !(nodeAt(pd) is Param) {
    if elabMintOuterSlotFactAt(c, ix, k, sc) { return true }
    return elabMintParamRowFactAt(c, ix, decl, k, sc)
  }
  const dn = nodeAt(decl)
  if !(dn is FuncDecl) { return false }
  if !i32ListHas(dn.fnParams, pd) {
    if root == cf { elabCapturedBundleSigNote(c, pd, k) }
    return false
  }
  // A chain's callee the instance types at its rep reads the set its root's list holds.
  const st = if root != cf && fnTagSetOfTy(elabNodeTy(cf, k)) < 0 { elabHeldFnTyOf(elabNodeTy(root, k)) } else { elabNodeTy(cf, k) }
  const ds = elabFnSetOf(st)
  if ds.length == 0 || fnTagSetOfTy(st) < 0 { return false }
  const wp: i32[] = []
  let key = ""
  for a in c.callArgs {
    const at = elabNodeTy(a, k)
    if at < 0 || !elabTyClosed(at, 0) { return false }
    const w = widenLitTy(at)
    wp.push(w)
    key = key + tyToStr(w) + ","
  }
  const rs: i32[] = []
  let split = false
  for d in ds {
    const r = elabMemberResultAt(d, wp)
    if r < 0 { return false }
    const w = widenLitTy(r)
    if rs.length > 0 && !tySame(w, rs[0]) { split = true }
    rs.push(w)
  }
  mintFactNote(sc, ix, fnTagSetOfTy(st), key, split, rs)
  if !split { elabNodeTyFill(ix, k, rs[0]) }
  // An element of a list literal of the parameter is the parameter's value, so its call goes
  // through the parameter's set too.
  if root != cf && elabHolderParamSource(identDeclOf(root), dn) == pd {
    mintParamSetNote(decl, i32ListIndexOf(dn.fnParams, pd), fnTagSetOfTy(st))
  }
  if root == cf {
    mintParamSetNote(decl, i32ListIndexOf(dn.fnParams, pd), fnTagSetOfTy(st))
    if !split {
      elabBundleSigNote(k, i32ListIndexOf(dn.fnParams, pd), ds, wp, rs[0])
    }
  }
  const at = elabMintCalls[ix] ?? []
  at.push(k)
  elabMintCalls[ix] = at
  // One call through two sets in two instances takes each instance's own arms; a callee read
  // out of a holder, a lambda's element, or a caller held beside another function, shares the
  // call's arms with the other, so both stay closures. A list literal of the parameter is typed
  // per instance, so it holds each instance's own set.
  const was = elabMintSets[ix] ?? fnTagSetOfTy(st)
  elabCallInstSets[i32ToStr(k) + "|" + i32ToStr(ix)] = fnTagSetOfTy(st)
  // A holder that is the instance's own parameter, or a lambda mapping it, is typed per instance:
  // mono keys the instance by the set and resolves the call by `elabCallSetIn`.
  const own = root != cf && identDeclOf(root) == pd
  const held = root != cf
    && !own
    && elabHolderParamSource(identDeclOf(root), dn) != pd
  if (
    was != fnTagSetOfTy(st)
    && (held
      || elabMintInLambda && !elabMintOwnRecv
      || i32ListHas(elabMintValueFns, decl))
  ) {
    mintSetPartialNote(was)
    mintSetPartialNote(fnTagSetOfTy(st))
  }
  elabMintSets[ix] = fnTagSetOfTy(st)
  true
}

// Notes the fact for call `c` at `ix` in instance `k` when its callee is an element of a
// module-scope list binding whose element holds a set: each member at the call's closed
// argument types, a lambda member instanced there by the elaboration.
function elabMintOuterSlotFactAt(c: Call, ix: i32, k: i32, sc: i32): boolean {
  const cf = parenPeelIx(c.callFn)
  const root = elabSlotRoot(cf)
  if (
    root == cf
    || root < 0
    || root >= P.nodes.length
    || !(nodeAt(root) is Ident)
  ) {
    return false
  }
  const bd = identDeclOf(root)
  if bd < 0 || bd >= P.nodes.length || !(nodeAt(bd) is LetDecl) { return false }
  if cwFrameOfDecl(bd) != CW_FR_MOD { return false }
  // The binding's own type holds every function its scope writes into the list.
  const bn = nodeAt(bd)
  const lit = if bn is LetDecl { parenPeelIx(bn.letInit) } else { -1 }
  const ws = if lit >= 0 { elabFnListWideSet(bd, nodeTyIxOf(lit)) } else { -1 }
  const set = if ws >= 0 { ws } else { fnTagSetOfTy(elabNodeTy(cf, k)) }
  const ds = fnTagMembers(set)
  if set < 0 || ds.length == 0 { return false }
  // A lambda written inside a generic or hole function is a value per instance of it.
  for d in ds {
    const dn = nodeAt(d)
    if dn is FuncDecl && dn.fnName == "" && ftWithinInstancedFn(d) {
      return false
    }
  }
  const wp: i32[] = []
  let key = ""
  for a in c.callArgs {
    const at = elabNodeTy(a, k)
    if at < 0 || !elabTyClosed(at, 0) { return false }
    const w = widenLitTy(at)
    wp.push(w)
    key = key + tyToStr(w) + ","
  }
  const rs: i32[] = []
  let split = false
  for d in ds {
    let r = elabMemberResultAt(d, wp)
    const dn = nodeAt(d)
    if r < 0 && dn is FuncDecl && dn.fnName == "" {
      const n0 = ekDecl.length
      elabEnqueueAtParams(d, wp)
      elabSettle(n0)
      r = elabMemberResultAt(d, wp)
    }
    if r < 0 { return false }
    const w = widenLitTy(r)
    if rs.length > 0 && !tySame(w, rs[0]) { split = true }
    rs.push(w)
  }
  mintFactNote(sc, ix, set, key, split, rs)
  if !split { elabNodeTyFill(ix, k, rs[0]) }
  const at = elabMintCalls[ix] ?? []
  at.push(k)
  elabMintCalls[ix] = at
  true
}

// Notes the fact for call `c` at `ix` in instance `k` when its callee is an element or a `get`
// read out of a parameter of `decl`, directly or by a `const` bound to that read, and the
// instance types the callee at a set the check's typing of the body could not see.
function elabMintParamRowFactAt(
  c: Call,
  ix: i32,
  decl: i32,
  k: i32,
  sc: i32,
): boolean {
  const cf = parenPeelIx(c.callFn)
  if cf < 0 || cf >= P.nodes.length { return false }
  const dn = nodeAt(decl)
  if !(dn is FuncDecl) { return false }
  if !elabElemRead(cf, 0) || elabParamRowRoot(cf, dn, 0) < 0 { return false }
  const st = nonNullTy(elabNodeTy(cf, k))
  const set = fnTagSetOfTy(st)
  if set < 0 || fnTagSetOfTy(nonNullTy(nodeTyIxOf(cf))) >= 0 { return false }
  const ds = fnTagMembers(set)
  if ds.length == 0 { return false }
  const wp: i32[] = []
  let key = ""
  for a in c.callArgs {
    const at = elabNodeTy(a, k)
    if at < 0 || !elabTyClosed(at, 0) { return false }
    const w = widenLitTy(at)
    wp.push(w)
    key = key + tyToStr(w) + ","
  }
  const rs: i32[] = []
  let split = false
  for d in ds {
    const r = elabMemberResultAt(d, wp)
    if r < 0 { return false }
    const w = widenLitTy(r)
    if rs.length > 0 && !tySame(w, rs[0]) { split = true }
    rs.push(w)
  }
  mintFactNote(sc, ix, set, key, split, rs)
  if !split { elabNodeTyFill(ix, k, rs[0]) }
  const at = elabMintCalls[ix] ?? []
  at.push(k)
  elabMintCalls[ix] = at
  elabCallInstSets[i32ToStr(k) + "|" + i32ToStr(ix)] = set
  elabMintSets[ix] = set
  true
}

// Whether `x` reads an element of a list or a map's value, directly or as a `const` bound to such
// a read: a field's function is typed by its record's own row, which these facts do not reach.
function elabElemRead(x: i32, depth: i32): boolean {
  if x < 0 || x >= P.nodes.length || depth > 4 { return false }
  const n = nodeAt(x)
  if n is Index { return true }
  if n is Paren { return elabElemRead(parenPeelIx(n.parInner), depth) }
  if n is Call {
    const g = parenPeelIx(n.callFn)
    const gn = if g >= 0 && g < P.nodes.length { nodeAt(g) } else { null }
    return gn is Member && gn.memProp == "get" && n.callArgs.length == 1
  }
  if !(n is Ident) { return false }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return false }
  const dn = nodeAt(d)
  dn is LetDecl
    && dn.letKw == "const"
    && dn.letInit >= 0
    && elabElemRead(parenPeelIx(dn.letInit), depth + 1)
}

// The parameter of `fn` the read `x` is taken out of through fields, elements, a map's `get` and
// `const` bindings of such reads, `depth` bindings deep; -1 when `x` is the parameter itself or
// reads no parameter of `fn`.
function elabParamRowRoot(x: i32, fn: FuncDecl, depth: i32): i32 {
  let r = x
  let steps = 0
  while r >= 0 && r < P.nodes.length && steps < 16 {
    const n = nodeAt(r)
    if n is Paren {
      r = n.parInner
    } else if n is Index {
      r = parenPeelIx(n.idxArr)
    } else if n is Member {
      r = parenPeelIx(n.memObj)
    } else if n is Call {
      const g = parenPeelIx(n.callFn)
      const gn = if g >= 0 && g < P.nodes.length { nodeAt(g) } else { null }
      if !(gn is Member) || gn.memProp != "get" || n.callArgs.length != 1 {
        return -1
      }
      r = parenPeelIx(gn.memObj)
    } else if n is Ident {
      const d = identDeclOf(r)
      if d < 0 || d >= P.nodes.length { return -1 }
      if i32ListHas(fn.fnParams, d) { return if steps > 0 { d } else { -1 } }
      const dn = nodeAt(d)
      if (
        !(dn is LetDecl)
        || dn.letKw != "const"
        || dn.letInit < 0
        || depth > 4
      ) {
        return -1
      }
      return elabParamRowRoot(parenPeelIx(dn.letInit), fn, depth + 1)
    } else {
      return -1
    }
    steps = steps + 1
  }
  -1
}

// Records `t` as call `ix`'s type at instance `k` where the re-check left it open: a callee whose
// type is a type parameter bound to the set types no result of its own.
function elabNodeTyFill(ix: i32, k: i32, t: i32) {
  if ix < 0 || ix >= elabGenTy.length || t < 0 || !elabTyClosed(t, 0) {
    return 0
  }
  const ps = elabNodeTys[ix] ?? []
  let i = 0
  while i + 1 < ps.length {
    if ps[i] == k {
      if !elabTyClosed(ps[i + 1], 0) { ps[i + 1] = t }
      elabNodeTys[ix] = ps
      return 0
    }
    i = i + 2
  }
  ps.push(k)
  ps.push(t)
  elabNodeTys[ix] = ps
  0
}

// The key of the instance of function `d` the elaboration made at parameter types `pTys`, or -1.
function ekByDeclNote(d: i32, k: i32) {
  const ks = ekByDecl[d] ?? []
  ks.push(k)
  ekByDecl[d] = ks
  if ks.length == 2 { elabFnHoldingMemo = Map() }
  0
}

// The parameter types every instance of function `d` closes its signature at, when they agree
// on one list; empty with no instance, two that differ, one left open, or one made under an
// instance that binds a type, whose lifted function each such instance builds apart.
export function elabDeclOnePin(d: i32): i32[] {
  const none: i32[] = []
  const sig = if d >= 0 && d < P.nodes.length { nodeTyIxOf(d) } else { -1 }
  if sig < 0 || sig >= T.tys.length { return none }
  const f = tyAt(sig)
  if !(f is TyFunc) { return none }
  let pick: i32[] = []
  let have = false
  for k in ekByDecl[d] ?? [] {
    const pk = ekParent[k]
    if pk >= 0 && pk < ekNames.length && ekNames[pk].length > 0 { return none }
    const ps: i32[] = []
    for p in f.fnParamTypes {
      const st = substTyDeep(p, ekNames[k], ekTys[k])
      if st < 0 || tyHasTyVar(st) || tyReachesHole(st, 8) { return none }
      ps.push(widenLitTy(st))
    }
    if !have {
      pick = ps
      have = true
    } else {
      if ps.length != pick.length { return none }
      let i = 0
      while i < ps.length {
        if !tySame(ps[i], pick[i]) { return none }
        i = i + 1
      }
    }
  }
  pick
}

export function elabMemberKeyAt(d: i32, pTys: i32[]): i32 {
  const sig = if d >= 0 && d < P.nodes.length { nodeTyIxOf(d) } else { -1 }
  if sig < 0 || sig >= T.tys.length { return -1 }
  const f = tyAt(sig)
  if !(f is TyFunc) || f.fnParamTypes.length != pTys.length { return -1 }
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == d && elabKeyTakesTys(k, f, pTys) { return k }
    k = k + 1
  }
  -1
}

// Whether instance `k`, of a declaration typed `f`, takes parameter types `pTys`.
function elabKeyTakesTys(k: i32, f: TyFunc, pTys: i32[]): boolean {
  let i = 0
  while i < pTys.length {
    const st = substTyDeep(f.fnParamTypes[i], ekNames[k], ekTys[k])
    if st < 0 || !tySame(widenLitTy(st), pTys[i]) { return false }
    i = i + 1
  }
  true
}

// `elabMemberKeyAt` among the instances of nested declaration `d` under the instance being walked,
// where the walk has any; -1 when none of those takes `pTys`.
function elabMemberKeyUnderWalk(d: i32, pTys: i32[]): i32 {
  const sig = if d >= 0 && d < P.nodes.length { nodeTyIxOf(d) } else { -1 }
  if sig < 0 || sig >= T.tys.length { return -1 }
  const f = tyAt(sig)
  if !(f is TyFunc) || f.fnParamTypes.length != pTys.length { return -1 }
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  if top < 0 { return -1 }
  for k in elabKidsAt(d, top) {
    if elabKeyTakesTys(k, f, pTys) { return k }
  }
  -1
}

// The result of the instance of `d` the elaboration made at parameter types `pTys`, else of the
// instances whose parameters accept them where those agree, or -1.
function elabMemberResultAt(d: i32, pTys: i32[]): i32 {
  const sig = if d >= 0 && d < P.nodes.length { nodeTyIxOf(d) } else { -1 }
  if sig < 0 || sig >= T.tys.length { return -1 }
  const f = tyAt(sig)
  if !(f is TyFunc) || f.fnParamTypes.length != pTys.length { return -1 }
  const ek = elabMemberKeyAt(d, pTys)
  if ek >= 0 { return elabResultOf(ek) }
  // No instance at exactly these types: the one instance whose parameters accept them, as a
  // `null` argument lands at `T | null`.
  let hit = -1
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == d {
      let fits = true
      let i = 0
      while i < pTys.length {
        const st = substTyDeep(f.fnParamTypes[i], ekNames[k], ekTys[k])
        if st < 0 || !elabTyClosed(st, 0) || !assignable(pTys[i], st) {
          fits = false
        }
        i = i + 1
      }
      if fits {
        if hit >= 0 && !tySame(elabResultOf(hit), elabResultOf(k)) { return -1 }
        hit = k
      }
    }
    k = k + 1
  }
  if hit >= 0 { elabResultOf(hit) } else { -1 }
}

// Whether call `ix` of `d` by name hands an untagged set of functions to an un-annotated
// parameter, or one its own type parameter alone annotates, which its row then binds at the
// set's rep (`elabSetArgBind` keys a tagged one).
function elabRowAtSetRep(ix: i32, d: i32): boolean {
  if ix < 0 || ix >= P.nodes.length || d < 0 || d >= P.nodes.length {
    return false
  }
  const cn = nodeAt(ix)
  if !(cn is Call) { return false }
  if identDeclOf(parenPeelIx(cn.callFn)) != d && !elabArmsName(ix, d) {
    return false
  }
  const f = nodeAt(d)
  if !(f is FuncDecl) { return false }
  let i = 0
  while i < cn.callArgs.length && i < f.fnParams.length {
    const ax = parenPeelIx(cn.callArgs[i])
    const st = if ax >= 0 { nodeTyIxOf(ax) } else { -1 }
    const pn = nodeAt(f.fnParams[i])
    if (
      pn is Param
      && (pn.parType < 0 || fnTagOwnTyParamJoins(f, i, []))
      && fnTagSetOfTy(st) >= 0
      && !fnTagSetIsTagged(fnTagSetOfTy(st))
    ) {
      return true
    }
    i = i + 1
  }
  false
}

// Demands member `ad`'s instance for its arm `an` (node `a`) of a call through a set: each
// parameter a type parameter of `ad` names takes the argument's type, one handed a tagged set
// takes the set, and any other keeps its own.
function elabArmEarly(ad: i32, an: Call, a: i32) {
  if ad < 0 || ad >= P.nodes.length { return 0 }
  const f = nodeAt(ad)
  const sig = nodeTyIxOf(ad)
  // A member generic by its un-annotated parameters is demanded at the set an argument holds, as
  // the row's own member is: keyed there when the set is tagged, else as the set's rep.
  const holeSet = f is FuncDecl
    && f.fnTyParams.length == 0
    && elabArmHandsSet(a, ad)
  if (
    !(f is FuncDecl)
    || f.fnTyParams.length == 0 && !holeSet
    || sig < 0
    || sig >= T.tys.length
  ) {
    return 0
  }
  const st = tyAt(sig)
  if !(st is TyFunc) || st.fnParamTypes.length != an.callArgs.length {
    return 0
  }
  const pTys: i32[] = []
  let i = 0
  while i < an.callArgs.length {
    const p = st.fnParamTypes[i]
    const setTy = if holeSet { elabCallArgSetTy(a, ad, i, -1) } else { -1 }
    const at = if tyHasTyVar(p) { widenLitTy(nodeTyIxOf(an.callArgs[i])) } else { p }
    pTys.push(if setTy >= 0 { setTy } else { at })
    i = i + 1
  }
  if !tysClosed(pTys) { return 0 }
  const none: string[] = []
  const noTys: i32[] = []
  elabSigAlting = holeSet && elabRowAtSetRep(a, ad)
  const k = elabDemandFrom(ad, none, noTys, pTys, -1, a)
  elabSigAlting = false
  elabReachNote(-1, k, a)
}

// Per arm of a call through a set, the closed type each argument takes in the member the call's row
// instanced, -1 where it binds none: mono builds every arm at the row's types, and the tag decision
// admits a lambda only where each member calls it at one type (`ftLamArgOk`).
let elabArmAltTys: {[i32]: i32[]} = Map()

function elabArmAltNote(a: i32, d: i32, rn: string[], rt: i32[]) {
  const an = nodeAt(a)
  const sig = if d >= 0 && d < P.nodes.length { nodeTyIxOf(d) } else { -1 }
  if !(an is Call) || sig < 0 || sig >= T.tys.length { return 0 }
  const st = tyAt(sig)
  if !(st is TyFunc) { return 0 }
  const out: i32[] = []
  let i = 0
  while i < an.callArgs.length {
    let t = -1
    if i < st.fnParamTypes.length {
      const p = st.fnParamTypes[i]
      const pv = if p >= 0 && p < T.tys.length { tyAt(p) } else { null }
      if pv is TyVar {
        const w = strListIndexOf(rn, pv.tvName)
        if w >= 0 && w < rt.length && elabTyClosed(rt[w], 0) { t = rt[w] }
      }
    }
    out.push(t)
    i = i + 1
  }
  elabArmAltTys[a] = out
  0
}

// Demands at the root the un-annotated function `ad` call `a` reaches, at the call's arguments'
// closed types, so the call mono builds for it reads that instance's parameters.
function elabHoleCallAt(a: i32, ad: i32) {
  const an = nodeAt(a)
  if !(an is Call) { return 0 }
  if ad < 0 || ad >= P.nodes.length { return 0 }
  const f = nodeAt(ad)
  const sig = nodeTyIxOf(ad)
  if (
    !(f is FuncDecl)
    || f.fnTyParams.length > 0
    || sig < 0
    || sig >= T.tys.length
  ) {
    return 0
  }
  const st = tyAt(sig)
  if !(st is TyFunc) || st.fnParamTypes.length != an.callArgs.length {
    return 0
  }
  if !tyHasTyVar(sig) { return 0 }
  const alt = elabArmAltTys.get(a) ?? []
  const pTys: i32[] = []
  let i = 0
  while i < an.callArgs.length {
    const p = st.fnParamTypes[i]
    let pt = if tyHasTyVar(p) { widenLitTy(nodeTyIxOf(an.callArgs[i])) } else { p }
    if tyHasTyVar(p) && i < alt.length && alt[i] >= 0 { pt = alt[i] }
    pTys.push(pt)
    i = i + 1
  }
  if !tysClosed(pTys) { return 0 }
  const none: string[] = []
  const noTys: i32[] = []
  elabReachNote(-1, elabDemandFrom(ad, none, noTys, pTys, -1, a), a)
}

// The module-level un-annotated function call `c` reaches through a `const` initialized with its
// name, or -1. A nested function's free names need its enclosing instance, which the root lacks.
function elabSoleCalleeHole(c: i32): i32 {
  const cn = nodeAt(c)
  if !(cn is Call) || fnTagCallArms(c).length > 0 { return -1 }
  const p = parenPeelIx(cn.callFn)
  if p < 0 || !(nodeAt(p) is Ident) { return -1 }
  const pd = identDeclOf(p)
  if pd < 0 || pd >= P.nodes.length { return -1 }
  const ld = nodeAt(pd)
  if !(ld is LetDecl) || ld.letKw != "const" || ld.letInit < 0 { return -1 }
  const iv = parenPeelIx(ld.letInit)
  if iv < 0 || !(nodeAt(iv) is Ident) { return -1 }
  const d = identDeclOf(iv)
  if !elabIsHoleFn(d) || (elabEncl[d] ?? -1) >= 0 { return -1 }
  d
}

// Whether call `ix` through a tagged set has an arm calling `d`.
function elabArmsName(ix: i32, d: i32): boolean {
  for a in fnTagCallArms(ix) {
    const an = nodeAt(a)
    if an is Call && identDeclOf(an.callFn) == d { return true }
  }
  false
}

// Whether arm `a` of a call through a set hands member `ad` a set of functions at an
// un-annotated parameter.
function elabArmHandsSet(a: i32, ad: i32): boolean {
  const an = nodeAt(a)
  const f = nodeAt(ad)
  if !(an is Call) || !(f is FuncDecl) { return false }
  let i = 0
  while i < an.callArgs.length && i < f.fnParams.length {
    const q = nodeAt(f.fnParams[i])
    const ax = parenPeelIx(an.callArgs[i])
    if (
      q is Param
      && q.parType < 0
      && ax >= 0
      && fnTagSetOfTy(nodeTyIxOf(ax)) >= 0
    ) {
      return true
    }
    i = i + 1
  }
  false
}

// Runs the worklist from the generic pass's closed calls.
export function elabRun() {
  elabRunDone = false
  elabLateNames = []
  elabPinsClosedSet(false)
  elabCbRepKeys = Map()
  elabSigAltKeys = Map()
  elabErrors = []
  elabReprKeys = Map()
  elabGuessKeys = Map()
  elabCandKeys = Map()
  elabPerEnclDecls = Map()
  elabListSigRows = []
  elabListSigOfSet = Map()
  elabListSigNames = []
  elabListSigTys = []
  elabListSigReps = []
  ekDecl = []
  ekNames = []
  ekTys = []
  ekByDecl = Map()
  elabFnHoldingMemo = Map()
  ekIndex = Map()
  ekRetWide = Map()
  elabExactMemo = Map()
  elabExactOnStack = Map()
  elabExactDepth = 0
  elabExactPending = []
  ekKids = Map()
  ekParent = []
  ekReach = []
  elabReadsMemo = Map()
  elabCallKeys = Map()
  elabValCalls = Map()
  elabValueKeys = Map()
  elabHoleMapMemo = Map()
  elabKeyCalls = Map()
  elabRepRowCalls = Map()
  elabLitArg = Map()
  elabArgInner = Map()
  elabSpreadInner = Map()
  litKeptMemo = Map()
  elabAliasOf = Map()
  elabAliasDecl = Map()
  elabAliases = []
  elabHoleCur = 0
  elabShortRows = []
  elabShortFrom = []
  elabWideCur = 0
  elabHoleDeferred = []
  elabOwnHoleRows = Map()
  elabHoleDeferredAt = []
  ekDone = []
  elabWalkKeys = []
  elabSlotKeys = Map()
  elabNodeTys = Map()
  elabNodeReps = Map()
  elabSlotTys = Map()
  elabHandBackMemo = Map()
  elabNodeRepUnions = Map()
  elabNodeCtxs = Map()
  elabNodeBoxs = Map()
  elabNodeNarrowed = Map()
  elabGenTy = []
  elabArmAltTys = Map()
  elabDeadKs = Map()
  let g = 0
  const setLams: i32[] = []
  elabCalls = []
  elabResultScanReset()
  while g < P.nodes.length {
    elabGenTy.push(nodeTyIxOf(g))
    if elabLamTakesSet(g) { setLams.push(g) }
    if nodeAt(g) is Call { elabCalls.push(g) }
    elabResultScanAt(g)
    g = g + 1
  }
  const callees: {[i32]: boolean} = Map()
  for c in elabCalls {
    const cn = nodeAt(c)
    if cn is Call { callees[cn.callFn] = true }
  }
  elabValueDecls = Map()
  g = 0
  while g < P.nodes.length {
    if nodeAt(g) is Ident && callees.get(g) == null {
      const d = identDeclOf(g)
      if d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl {
        elabValueDecls[elabSrcDecl(d)] = true
      }
    }
    g = g + 1
  }
  // A value holding a kept function's result, and a literal the record solve builds at another
  // record, is stamped with the type it is built as.
  if recKeptFnDecl.length > 0 || recBuildCount() > 0 {
    const bt = recBuildTable()
    g = 0
    while g < P.nodes.length {
      litKeptStamp(g)
      litBuildStampLet(g, bt)
      litBuildStampStore(g, bt)
      g = g + 1
    }
  }
  let r = 0
  const n = callBindCount()
  while r < n {
    const ix = callBindIxAt(r)
    const tys = elabSetArgBind(ix, callBindNamesAt(r), elabRowTys(r))
    elabSetCallRows(ix, callBindNamesAt(r), tys, -1, -1)
    if elabRowClosedOrSet(tys) {
      const d = elabCallDeclOf(ix)
      const rn: string[] = []
      const rt: i32[] = []
      elabRowComplete(ix, d, callBindNamesAt(r), tys, rn, rt)
      elabRowEntries(ix, d, rn, rt)
      if elabRowByArms(ix, d) {
        // The row's own instance serves a set left untagged; no call reaches it.
        elabSigAlting = elabRowAtSetRep(ix, d)
        elabReachNote(-1, elabEnqueue(d, rn, rt, -1), -1)
        elabSigAlting = false
        for a in fnTagCallArms(ix) {
          const an = nodeAt(a)
          if an is Call {
            const ad = identDeclOf(an.callFn)
            elabArmEarly(ad, an, a)
            if d >= 0 && ad != d {
              elabArmAltNote(a, d, rn, rt)
              elabHoleCallAt(a, ad)
            }
          }
        }
        r = r + 1
        continue
      }
      // A row binding an untagged set's value at its rep is that rep's instance.
      elabSigAlting = elabRowAtSetRep(ix, d)
      const k = elabEnqueue(d, rn, rt, -1)
      elabSigAlting = false
      elabReachNote(-1, k, ix)
      elabArgRows(ix, d, rn, rt, -1)
      // A call through a set reaches the called member through the direct call built for it;
      // another member's call is checked here too, at its own arguments.
      for a in fnTagCallArms(ix) {
        const an = nodeAt(a)
        if an is Call {
          const ad = identDeclOf(an.callFn)
          if ad == d {
            elabReachNote(-1, k, a)
          } else {
            elabArmEarly(ad, an, a)
            elabArmAltNote(a, d, rn, rt)
            elabHoleCallAt(a, ad)
          }
        }
      }
    }
    r = r + 1
  }
  // An arm no row keyed reaches its un-annotated member at the arm's own arguments, as does a
  // call through a `const` naming one.
  for c in elabCalls {
    for a in fnTagCallArms(c) {
      const an = nodeAt(a)
      if an is Call && elabCallInstFrom(a, -1) < 0 {
        elabHoleCallAt(a, identDeclOf(an.callFn))
      }
    }
    if elabCallInstFrom(c, -1) < 0 { elabHoleCallAt(c, elabSoleCalleeHole(c)) }
  }
  // A call of a module binding above its declaration, at its arguments' own types.
  for ec in elabEarlyCalls { elabEarlyCallRows(ec) }
  // A generic named as a list method's callback, at the element.
  let cb = 0
  while cb < elabCbRootD.length {
    if tysClosed(elabCbRootT[cb]) {
      elabReachNote(
        -1,
        elabEnqueue(elabCbRootD[cb], elabCbRootN[cb], elabCbRootT[cb], -1),
        -1,
      )
    }
    cb = cb + 1
  }
  // A nested declaration typed from its context, with nothing to bind, whose body calls a
  // generic is checked as an instance of its own: the call is typed there.
  for nd in elabEncl.keys() {
    if elabNestedOwnInstance(nd) {
      const none: string[] = []
      const noTys: i32[] = []
      elabReachNote(-1, elabEnqueue(nd, none, noTys, -1), -1)
    }
  }
  // Each instance the checker typed a call through a set-bound parameter in, at its bindings.
  for sc in mintScopeRows() {
    const tys = mintScopeTysOf(sc)
    if tysClosed(tys) {
      elabReachNote(
        -1,
        elabEnqueue(mintScopeFnOf(sc), mintScopeNamesOf(sc), tys, -1),
        -1,
      )
    }
  }
  // The instances an earlier round's join found missing are this round's demands.
  elabJoinDemandsEnqueue()
  elabSettle(0)
  elabRepRowInstances()
  // A row binding a set of functions is also the instance at the set's rep, which mono builds.
  const stubRows: i32[] = []
  r = 0
  while r < n {
    const ix = callBindIxAt(r)
    const tys = elabSetArgBind(ix, callBindNamesAt(r), callBindTysAt(r))
    const ck = elabCallInstFrom(ix, -1)
    if !elabRowByArms(ix, elabCallDeclOf(ix)) {
      if ck >= 0 { elabSetRepRow(ix, callBindNamesAt(r), tys, ck) }
      elabSetRepRow(ix, callBindNamesAt(r), tys, -1)
    }
    if elabRepStubbed { stubRows.push(r) }
    r = r + 1
  }
  // A row whose set took the stub rep inside a container, a hole-function member of which no
  // instance reaches, takes the rep that member's default instance (its parameter holes at `i32`)
  // gives; a bare set value stays the stub, built as no body.
  if stubRows.length > 0 {
    let grew = false
    for sr in stubRows {
      const tys = elabSetArgBind(
        callBindIxAt(sr),
        callBindNamesAt(sr),
        callBindTysAt(sr),
      )
      const ms: i32[] = []
      for t in tys {
        if !(tyAt(t) is TyFunc) { elabFnIdsIn(t, ms, 0) }
      }
      for m in ms {
        const mn = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { nodeAt(0) }
        if mn is FuncDecl && elabIsHoleFn(m) && !elabHasInstance(m) {
          const pts: i32[] = []
          for _p in mn.fnParams { pts.push(TY_I32) }
          elabGuessing = true
          elabEnqueueAtParams(m, pts)
          elabGuessing = false
          grew = true
        }
      }
    }
    if grew {
      elabSettle(0)
      for sr in stubRows {
        const ix = callBindIxAt(sr)
        const tys = elabSetArgBind(ix, callBindNamesAt(sr), callBindTysAt(sr))
        elabSetRepRow(ix, callBindNamesAt(sr), tys, -1)
      }
    }
  }
  // A generic used as a value is also built at its default when nothing binds it (D4551).
  for m in elabFnSetMembers() {
    const ms = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { nodeAt(0) }
    if (
      m >= 0
      && m < P.nodes.length
      && ms is FuncDecl
      && ms.fnTyParams.length > 0
    ) {
      const tys: i32[] = []
      for _tp in ms.fnTyParams { tys.push(TY_I32) }
      elabGuessing = true
      const gk = elabEnqueue(m, ms.fnTyParams, tys, -1)
      elabGuessing = false
      elabReachNote(-1, gk, -1)
    }
  }
  elabSettle(0)
  // A lambda whose parameter holds a set of functions is also the instance at the set's rep.
  for lam in setLams { elabLamRepInstance(lam) }
  // A function named as a list method's callback over a set of functions is also the instance
  // at the set's rep, or at the member instances its own calls through the parameter take.
  let cr = 0
  while cr < elabCbRootD.length {
    const d = elabCbRootD[cr]
    if tysClosed(elabCbRootT[cr]) {
      const rep: i32[] = []
      let moved = false
      for t in elabCbRootT[cr] {
        elabRepStubbed = false
        let rt = elabSetRepTy(t, 4, -1)
        if (rt < 0 || elabRepStubbed) && tyAt(t) is TyFunc {
          rt = elabLamCallRep(d, 0, t)
        }
        if rt != t { moved = true }
        rep.push(rt)
      }
      if moved && tysClosed(rep) {
        const n0 = ekDecl.length
        const ck = elabEnqueue(d, elabCbRootN[cr], rep, -1)
        if ck >= n0 { elabCbRepKeys[ck] = true }
        elabReachNote(-1, ck, -1)
      }
    }
    cr = cr + 1
  }
  elabSettle(0)
  // A row a function argument's result leaves open closes at that function's instance.
  r = 0
  while r < n {
    const ix = callBindIxAt(r)
    const tys = elabSetArgBind(ix, callBindNamesAt(r), callBindTysAt(r))
    if !elabRowClosedOrSet(tys) {
      let ct = elabRowByFnResults(ix, callBindNamesAt(r), tys)
      if ct.length == 0 { ct = elabRowByPlainArgs(ix, callBindNamesAt(r), tys) }
      // A row only the D4551 default closes is a guess, as the default instance is.
      let byDefault = false
      if ct.length == 0 {
        ct = elabRowArgDefaults(ix, tys)
        byDefault = ct.length > 0
      }
      if ct.length == 0 { ct = elabRowEmptyListDefaults(ix, tys) }
      if ct.length > 0 {
        elabArgRows(ix, elabCallDeclOf(ix), callBindNamesAt(r), ct, -1)
        const dk = elabEnqueue(elabCallDeclOf(ix), callBindNamesAt(r), ct, -1)
        elabReachNote(-1, dk, ix)
        if byDefault && dk >= 0 { elabGuessKeys[dk] = true }
        elabSettle(0)
      }
    }
    r = r + 1
  }
  elabCellPeers()
  elabNestedPerEncl()
  elabSoleRekey()
  elabListMemberSigs()
  elabClosedLamRootKeys()
  elabReturnCredits()
  let lr = 0
  while lr < elabListSigRows.length {
    elabListSigRow(
      elabListSigRows[lr],
      elabListSigNames[lr],
      elabListSigTys[lr],
      elabListSigReps[lr],
    )
    lr = lr + 1
  }
  elabHeldListFacts()
  elabSlotFacts()
  elabPinsClosedSet(true)
  elabRunDone = true
}

// Stamps each instance's record-list literal whose stored functions are left open to be built at
// the type `elabHeldClosedTy` closes them to, where that instance stamped it at nothing else; mono
// reads it per instance through `elabNodeRepAt`.
function elabHeldListFacts() {
  const n0 = ekDecl.length
  const fills: i32[] = []
  for ix in elabNodeTys.keys() {
    if ix < 0 || ix >= P.nodes.length { continue }
    const lit = nodeAt(ix)
    if !(lit is ArrayLit) || lit.arrElems.length == 0 { continue }
    const ps = elabNodeTys[ix] ?? []
    let i = 0
    while i + 1 < ps.length {
      const t = ps[i + 1]
      const lt = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
      const et = if lt is TyArray { lt.aElem } else { -1 }
      // A stored set a call reaches is left to the instance (D15296).
      const ds: i32[] = []
      elabFnIdsIn(et, ds, 0)
      if (
        et >= 0
        && et < T.tys.length
        && tyAt(et) is TyObj
        && tyHasTyVar(et)
        && !fnSetCalledWithAny(ds)
      ) {
        const nv = elabHeldClosedTy(et, lit.arrElems, 0)
        if nv >= 0 && !tyHasTyVar(nv) {
          fills.push(ix)
          fills.push(ps[i])
          fills.push(mkArrayTy(nv))
        }
      }
      i = i + 2
    }
  }
  let f = 0
  while f + 2 < fills.length {
    if elabPairIn(elabNodeReps, fills[f], fills[f + 1]) < 0 {
      const rs = elabNodeReps[fills[f]] ?? []
      rs.push(fills[f + 1])
      rs.push(fills[f + 2])
      elabNodeReps[fills[f]] = rs
    }
    f = f + 3
  }
  if ekDecl.length > n0 { elabSettle(0) }
  0
}

// Keys each per-instance lambda an open function's instance returns under that instance, at the
// pins the call through the returned value gives its holes: the call `f(x)(y)` pins the lambda
// `f`'s instance returned, which no instance's own body pins (per-instance-identity-2026-11.md, M5).
function elabReturnCredits() {
  for c in elabCalls {
    const cn = nodeAt(c)
    if !(cn is Call) { continue }
    const inner = parenPeelIx(cn.callFn)
    if inner < 0 || inner >= P.nodes.length || !(nodeAt(inner) is Call) {
      continue
    }
    const ik = elabCallInstFrom(inner, -1)
    if ik < 0 || ik >= ekDecl.length || !declOpen(ekDecl[ik]) { continue }
    const lam = elabReturnedLam(ekDecl[ik])
    const lt = if lam >= 0 { nodeTyIxOf(lam) } else { -1 }
    const lf = if lt >= 0 && lt < T.tys.length { tyAt(lt) } else { null }
    const ln = if lam >= 0 { nodeAt(lam) } else { null }
    if !(lf is TyFunc) || !(ln is FuncDecl) { continue }
    const names: string[] = []
    const tys: i32[] = []
    let i = 0
    while i < ln.fnParams.length && i < cn.callArgs.length {
      const pn = nodeAt(ln.fnParams[i])
      const at = nodeTyIxOf(cn.callArgs[i])
      // The parameter's checker type may be another declaration's variable, unified with this one.
      if (
        pn is Param
        && pn.parType < 0
        && at >= 0
        && elabTyClosed(at, 0)
        && i < lf.fnParamTypes.length
      ) {
        bindGenWalk(lf.fnParamTypes[i], widenLitTy(at), names, tys)
      }
      i = i + 1
    }
    if names.length > 0 {
      elabReachNote(ik, elabEnqueue(lam, names, tys, ik), c)
    }
  }
  elabSettle(0)
}

// The per-instance lambda of `f` among the functions the checker says `f` may return: a lambda it
// returns, or one in the function set of a `let` it returns. -1 for none, and -1 when two
// different lambdas qualify, since no one key then serves the call through the result.
function elabReturnedLam(f: i32): i32 {
  let found = -1
  for lf in recFnValueLeaves(f) {
    const x = parenPeelIx(lf)
    const ds: i32[] = [x]
    const b = if x >= 0 && x < P.nodes.length && nodeAt(x) is Ident { identDeclOf(x) } else { -1 }
    if b >= 0 && b < P.nodes.length && nodeAt(b) is LetDecl {
      for d in elabFnLetMembers(b) { ds.push(d) }
    }
    for d in ds {
      if (
        d >= 0
        && d < P.nodes.length
        && nodeAt(d) is FuncDecl
        && elabLamPerEncl(d)
        && (elabEncl.get(d) ?? -1) == f
      ) {
        if found >= 0 && found != d { return -1 }
        found = d
      }
    }
  }
  found
}

// Keys at the root each lambda keyed per encloser instance whose checked type the checker closed:
// it is one lambda at every instance, and mono pins it from that type outside every walk.
function elabClosedLamRootKeys() {
  for d in elabEncl.keys() {
    const e = elabEncl.get(d) ?? -1
    if elabLamPerEncl(d) && e >= 0 && declOpen(e) {
      const t = nodeTyIxOf(d)
      if t >= 0 && elabTyClosed(t, 0) {
        const none: string[] = []
        const noTys: i32[] = []
        elabEnqueue(d, none, noTys, -1)
      }
    }
  }
  elabSettle(0)
}

// Mints, as candidates, each named member of an untagged set holding a capturing lambda that a
// call through a list element reaches, at the closed signature the call gives it: the instance
// a closure in the list needs if the set stays untagged.
function elabListMemberSigs() {
  for c in elabCalls {
    const cn = nodeAt(c)
    if !(cn is Call) { continue }
    const cf = parenPeelIx(cn.callFn)
    const cd = if cf >= 0 && nodeAt(cf) is Ident { identDeclOf(cf) } else { -1 }
    if !(nodeAt(cf) is Index) && !(cd >= 0 && nodeAt(cd) is LoopVar) {
      continue
    }
    const s = fnTagSetOfTy(nodeTyIxOf(cf))
    if s < 0 || fnTagSetIsTagged(s) || !fnSetHasCapturingLambda(s) { continue }
    for m in fnTagMembers(s) {
      const pTys = elabMemberCallSig(m, cn.callArgs)
      if pTys.length > 0 {
        const k = elabDemandCandidate(m, pTys, c)
        elabReachNote(-1, k, c)
      }
    }
  }
  elabSettle(0)
}

// The closed parameter types named function `m` takes from a call with `args`: a hole parameter
// handed a function takes `(p...) => r`, `p` the one set of argument types `m`'s body calls it
// with and `r` that function's result there; any other takes its argument's type. [] when one
// stays open.
function elabMemberCallSig(m: i32, args: i32[]): i32[] {
  const none: i32[] = []
  const f = nodeAt(m)
  if !(f is FuncDecl) || f.fnName == "" || f.fnTyParams.length > 0 {
    return none
  }
  if f.fnParams.length != args.length { return none }
  const out: i32[] = []
  let fnHole = false
  let i = 0
  while i < args.length {
    const pn = nodeAt(f.fnParams[i])
    const at = nodeTyIxOf(parenPeelIx(args[i]))
    const ads = elabFnSetOf(at)
    if pn is Param && pn.parType < 0 && ads.length > 0 {
      const wp = elabParamCallArgTys(f.fnBody, f.fnParams[i])
      if wp.length == 0 { return none }
      let r = -1
      for d in ads {
        const dr = widenLitTy(elabMemberResultAt(d, wp))
        if dr < 0 || r >= 0 && !tySame(r, dr) { return none }
        r = dr
      }
      out.push(mkFuncTy(wp, r))
      fnHole = true
    } else {
      if at < 0 || !elabTyClosed(at, 0) { return none }
      out.push(widenLitTy(at))
    }
    i = i + 1
  }
  if !fnHole { return none }
  out
}

// The widened, closed argument types every call in `body` through parameter `pd` passes, when
// they are one list and there is at least one such call; else [].
function elabParamCallArgTys(body: i32, pd: i32): i32[] {
  const none: i32[] = []
  let got: i32[] = []
  let seen = false
  const todo: i32[] = [body]
  while todo.length > 0 {
    const y = todo.pop() ?? -1
    if y < 0 || y >= P.nodes.length { continue }
    const n = nodeAt(y)
    if n is FuncDecl && y != body { continue }
    if n is Call {
      const cf = parenPeelIx(n.callFn)
      if cf >= 0 && nodeAt(cf) is Ident && identDeclOf(cf) == pd {
        const tys: i32[] = []
        for a in n.callArgs {
          const at = widenLitTy(nodeTyIxOf(a))
          if at < 0 || !elabTyClosed(at, 0) { return none }
          tys.push(at)
        }
        if seen && !tysSameList(got, tys) { return none }
        got = tys
        seen = true
      }
    }
    for ch in nodeChildren(y) { todo.push(ch) }
  }
  got
}

function tysSameList(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if !tySame(a[i], b[i]) { return false }
    i = i + 1
  }
  true
}

// Keys each root call that hands back a hole lambda, left open by its row, at that lambda's one
// instance: the instance exists only once the run has settled, after the call's own key (D14885).
function elabSoleRekey() {
  let r = 0
  const n = callBindCount()
  while r < n {
    const ix = callBindIxAt(r)
    const ok = ix >= 0 && ix < P.nodes.length
    const cn = if ok { nodeAt(ix) } else { nodeAt(0) }
    const d = if ok { elabCallDeclOf(ix) } else { -1 }
    const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { cn }
    if ok && cn is Call && f is FuncDecl {
      const i = elabHandBackIx(d, f)
      const k0 = elabCallInstFrom(ix, -1)
      if (
        i >= 0
        && i < cn.callArgs.length
        && !(k0 >= 0 && elabParamTyClosed(k0, i))
      ) {
        const st = elabSoleInstFnTy(parenPeelIx(cn.callArgs[i]))
        const hn = elabParamTyVarName(f, i)
        if st >= 0 && hn != "" {
          const names = callBindNamesAt(r)
          const tys = callBindTysAt(r).slice(0)
          let j = 0
          while j < names.length && j < tys.length {
            if names[j] == hn { tys[j] = st }
            j = j + 1
          }
          const n0 = ekDecl.length
          const k = elabEnqueue(d, names, tys, -1)
          elabReachNote(-1, k, ix)
          if k >= 0 && !ekDone[k] { elabOne(k) }
          elabSettle(n0)
        }
      }
    }
    r = r + 1
  }
  0
}

// Whether parameter `i` of instance `k` is at a closed type holding no hole, or a set's binding.
function elabParamTyClosed(k: i32, i: i32): boolean {
  const t = elabParamTyOf(k, i)
  if t >= 0 && t < T.tys.length && !tyHasTyVar(t) && !tyHasHole(t) {
    return true
  }
  elabSetBinding(elabParamBoundTyOf(k, i))
}

// The name a late key reports: its function's, or `<lambda>` for an anonymous one.
function elabLateName(decl: i32): string {
  const d = nodeAt(decl)
  if d is FuncDecl && d.fnName != "" { return d.fnName }
  "<lambda>"
}

// A `let` holding several un-annotated functions is one cell, which mono builds at one
// signature: each such member no instance reaches takes the parameter types an instanced one has
// (D3851). A generic the cell also holds is instanced by its own writes.
function elabCellPeers() {
  for bd in elabFnLetBindings() {
    const ms = elabFnLetMembers(bd)
    const hs: i32[] = []
    for m in ms {
      if elabIsHoleFn(m) { hs.push(m) }
    }
    if ms.length >= 2 && hs.length > 0 {
      let pts: i32[] = []
      for m in hs {
        if pts.length == 0 { pts = elabInstParamTys(m) }
      }
      if pts.length > 0 {
        for m in hs {
          if elabInstParamTys(m).length == 0 { elabEnqueueAtParams(m, pts) }
        }
      }
    }
  }
  elabCellDeliveries()
  elabSettle(0)
}

// Every call node, collected by `elabRun`'s walk.
let elabCalls: i32[] = []

// A cell handed to a parameter declared a closed function type is built there at that type, so
// each function it holds is an instance at that type's parameters.
function elabCellDeliveries() {
  const cells: {[i32]: boolean} = Map()
  for bd in elabFnLetBindings() { cells[bd] = true }
  if cells.length == 0 { return 0 }
  for ix in elabCalls {
    const cn = nodeAt(ix)
    if cn is Call {
      const fd = identDeclOf(parenPeelIx(cn.callFn))
      const f = if fd >= 0 { nodeAt(fd) } else { nodeAt(ix) }
      let i = 0
      while f is FuncDecl && i < cn.callArgs.length && i < f.fnParams.length {
        const ax = parenPeelIx(cn.callArgs[i])
        const bd = if ax >= 0 && nodeAt(ax) is Ident { identDeclOf(ax) } else { -1 }
        const pt = nodeTyIxOf(f.fnParams[i])
        if bd >= 0 && (cells[bd] ?? false) && pt >= 0 && pt < T.tys.length {
          const ft = tyAt(pt)
          if ft is TyFunc && !tyHasTyVar(pt) {
            for m in elabFnLetMembers(bd) {
              elabEnqueueAtParams(m, ft.fnParamTypes)
            }
          }
        }
        i = i + 1
      }
    }
  }
  0
}

// Whether some instance of declaration `d` has been enqueued.
function elabHasInstance(d: i32): boolean {
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == d { return true }
    k = k + 1
  }
  false
}

// The closed parameter types of an instance of `d`, or [] when none has them.
function elabInstParamTys(d: i32): i32[] {
  const sig = if d >= 0 && d < P.nodes.length { nodeTyIxOf(d) } else { -1 }
  if sig < 0 || sig >= T.tys.length { return [] }
  const f = tyAt(sig)
  if !(f is TyFunc) { return [] }
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == d {
      const out: i32[] = []
      for pt in f.fnParamTypes {
        const st = substTyDeep(pt, ekNames[k], ekTys[k])
        if st >= 0 && elabTyClosed(st, 0) { out.push(st) }
      }
      if out.length == f.fnParamTypes.length { return out }
    }
    k = k + 1
  }
  []
}

// Enqueues `d` bound by its signature against parameter types `pts`.
function elabEnqueueAtParams(d: i32, pts: i32[]) {
  const sig = nodeTyIxOf(d)
  if sig < 0 || sig >= T.tys.length { return 0 }
  const f = tyAt(sig)
  if !(f is TyFunc) || f.fnParamTypes.length != pts.length { return 0 }
  const names: string[] = []
  const tys: i32[] = []
  let i = 0
  while i < pts.length {
    bindGenWalk(f.fnParamTypes[i], pts[i], names, tys)
    i = i + 1
  }
  if names.length > 0 && tysClosed(tys) {
    elabReachNote(-1, elabEnqueue(d, names, tys, -1), -1)
  }
  0
}

// Whether node `g` is a lambda, enclosed by nothing that binds, a parameter of which holds a set
// of functions.
function elabLamTakesSet(g: i32): boolean {
  const f = nodeAt(g)
  if !(f is FuncDecl) || f.fnName != "" || f.fnTyParams.length > 0 {
    return false
  }
  const e = elabEncl[g] ?? -1
  if e >= 0 && !elabBindsNothing(e) { return false }
  const sig = nodeTyIxOf(g)
  if sig < 0 || sig >= T.tys.length { return false }
  const sf = tyAt(sig)
  if !(sf is TyFunc) { return false }
  for pt in sf.fnParamTypes {
    const ds: i32[] = []
    elabFnIdsIn(pt, ds, 0)
    if ds.length > 0 { return true }
  }
  false
}

// Enqueues lambda `lam` at each parameter's set taking its rep (`elabSetRepTy` over the root
// instances), bound as a demand at those parameter types binds it.
function elabLamRepInstance(lam: i32) {
  const sig = nodeTyIxOf(lam)
  const sf = if sig >= 0 && sig < T.tys.length { tyAt(sig) } else { tyAt(0) }
  if !(sf is TyFunc) { return 0 }
  const names: string[] = []
  const tys: i32[] = []
  let pi = 0
  for pt in sf.fnParamTypes {
    let rt = elabSetRepTy(pt, 4, -1)
    if rt < 0 { rt = elabLamCallRep(lam, pi, pt) }
    if rt < 0 || !elabTyClosed(rt, 0) { return 0 }
    bindGenWalk(pt, rt, names, tys)
    pi = pi + 1
  }
  if names.length == 0 { return 0 }
  elabReachNote(-1, elabEnqueue(lam, names, tys, -1), -1)
  elabSettle(0)
}

// The signature the set of functions parameter `pi` (of type `pt`) of lambda `lam` runs at: each
// member's instance at the argument types of the lambda's own calls through that parameter; -1
// when they disagree, a call's arguments do not close or no member is instanced there.
function elabLamCallRep(lam: i32, pi: i32, pt: i32): i32 {
  const f = nodeAt(lam)
  if !(f is FuncDecl) || pi >= f.fnParams.length || !(tyAt(pt) is TyFunc) {
    return -1
  }
  const calls: i32[] = []
  elabCallsThrough(f.fnBody, f.fnParams[pi], calls)
  const ms = elabFnSetOf(pt)
  let rep = -1
  for c in calls {
    const cn = nodeAt(c)
    const ats: i32[] = []
    if cn is Call {
      for a in cn.callArgs { ats.push(widenLitTy(nodeTyIxOf(a))) }
    }
    if !tysClosed(ats) { return -1 }
    for m in ms {
      const ft = elabMemberAt(m, ats)
      if ft < 0 || (rep >= 0 && !tySame(rep, ft)) { return -1 }
      rep = ft
    }
  }
  rep
}

// Type `t` (a container of a set of functions) at the signature every function call `ix`'s callee
// writes into it through the parameter whose hole is `hole` has (`p.push(f)`, `p.set(k, f)`,
// `p[i] = f`, a generic at its D4551 default); -1 when it writes none, or two that disagree.
function elabWrittenRep(ix: i32, hole: string, t: i32): i32 {
  const d = elabCallDeclOf(ix)
  if d < 0 || d != elabHoleDeclOf(hole) { return -1 }
  const dn = nodeAt(d)
  if !(dn is FuncDecl) { return -1 }
  let dot = hole.length - 1
  while dot > 0 && hole[dot] != '.' { dot = dot - 1 }
  const pi = decDigitsOf(hole.slice(dot + 1, hole.length))
  if pi < 0 || pi >= dn.fnParams.length { return -1 }
  const vals: i32[] = []
  elabParamWrites(dn.fnBody, dn.fnParams[pi], vals)
  if vals.length == 0 { return -1 }
  // A record literal written there holds its function-valued fields.
  const fns: i32[] = []
  for v in vals {
    const vn = nodeAt(parenPeelIx(v))
    if vn is ObjLit {
      for fi in vn.objFields {
        const f = nodeAt(fi)
        if f is FieldInit { fns.push(f.fiValue) }
      }
    } else {
      fns.push(v)
    }
  }
  let sig = -1
  for v in fns {
    const fd = cwFnValueDeclOf(v)
    let st = if fd >= 0 { nodeTyIxOf(fd) } else { -1 }
    // A generic written there is built at its default (D4551).
    if st >= 0 && !elabTyClosed(st, 0) { st = elabDefaultSig(fd) }
    if st < 0 || !elabTyClosed(st, 0) { return -1 }
    if sig >= 0 && !tySame(sig, st) { return -1 }
    sig = st
  }
  elabReplaceFnTy(t, sig, 0)
}

// Appends to `out` each value the code under `ix`, outside a nested function, writes into the
// parameter `pd`'s slots: `pd.push(v)`, `pd.unshift(v)`, `pd.set(k, v)` and `pd[i] = v`.
function elabParamWrites(ix: i32, pd: i32, out: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  if n is Call && n.callArgs.length > 0 {
    const f = nodeAt(parenPeelIx(n.callFn))
    if f is Member && identDeclOf(parenPeelIx(f.memObj)) == pd {
      if f.memProp == "push" || f.memProp == "unshift" {
        out.push(n.callArgs[0])
      }
      if f.memProp == "set" && n.callArgs.length == 2 {
        out.push(n.callArgs[1])
      }
    }
  }
  if n is BinExpr && n.binOp == "=" {
    const l = nodeAt(parenPeelIx(n.binLeft))
    if l is Index && identDeclOf(parenPeelIx(l.idxArr)) == pd {
      out.push(n.binRight)
    }
  }
  for c in nodeChildren(ix) { elabParamWrites(c, pd, out) }
  0
}

// Type `t` with each function type inside it, through lists, maps and record fields, replaced by
// `sig`; -1 past the depth bound.
function elabReplaceFnTy(t: i32, sig: i32, depth: i32): i32 {
  if t < 0 || t >= T.tys.length || depth > 8 { return -1 }
  const x = tyAt(t)
  match x {
    TyFunc => sig
    TyArray => {
      const e = elabReplaceFnTy(x.aElem, sig, depth + 1)
      if e < 0 { -1 } else { mkArrayTy(e) }
    }
    TyMap => {
      const e = elabReplaceFnTy(x.mVal, sig, depth + 1)
      if e < 0 { -1 } else { mkMapTy(x.mKey, e, x.mSet) }
    }
    TyObj => {
      const fs: i32[] = []
      for ft in x.objFieldTypes {
        const e = elabReplaceFnTy(ft, sig, depth + 1)
        if e < 0 { return -1 }
        fs.push(e)
      }
      mkObjTy(x.objFieldNames, fs)
    }
    TyNullable => {
      const e = elabReplaceFnTy(x.nInner, sig, depth + 1)
      if e < 0 { -1 } else { mkNullableTy(e) }
    }
    TyPrim | TyErr | TyUnion | TyVar | TyLit | TyNeg => t
  }
}

// Whether some instance of `m` that is not a guess has been enqueued.
function elabCalledAnywhere(m: i32): boolean {
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == m && !(elabGuessKeys[k] ?? false) { return true }
    k = k + 1
  }
  false
}

// The signature generic `m` runs at when call `ix`'s callee, bound at `names`/`tys`, calls it through
// the parameter whose hole is `hole`: its type parameters bound from those calls' arguments, a
// lambda argument by its instance at the parameter types already bound; -1 when they do not close
// or disagree.
function elabGenericCallRep(
  ix: i32,
  hole: string,
  m: i32,
  names: string[],
  tys: i32[],
): i32 {
  const d = elabCallDeclOf(ix)
  const msig = if m >= 0 && m < P.nodes.length { nodeTyIxOf(m) } else { -1 }
  if d < 0 || d != elabHoleDeclOf(hole) || msig < 0 || msig >= T.tys.length {
    return -1
  }
  const dn = nodeAt(d)
  const mf = tyAt(msig)
  if !(dn is FuncDecl) || !(mf is TyFunc) { return -1 }
  let dot = hole.length - 1
  while dot > 0 && hole[dot] != '.' { dot = dot - 1 }
  const pi = decDigitsOf(hole.slice(dot + 1, hole.length))
  if pi < 0 || pi >= dn.fnParams.length { return -1 }
  const calls: i32[] = []
  elabCallsThrough(dn.fnBody, dn.fnParams[pi], calls)
  elabCallsRep(calls, m, names, tys)
}

// The one signature at which generic `m` is instanced by every call in `calls`, their argument
// types read under `names`/`tys`; -1 when one does not close or two disagree.
function elabCallsRep(calls: i32[], m: i32, names: string[], tys: i32[]): i32 {
  const msig = if m >= 0 && m < P.nodes.length { nodeTyIxOf(m) } else { -1 }
  if msig < 0 || msig >= T.tys.length { return -1 }
  const mf = tyAt(msig)
  if !(mf is TyFunc) || calls.length == 0 { return -1 }
  let rep = -1
  for c in calls {
    const cn = nodeAt(c)
    if !(cn is Call) || cn.callArgs.length != mf.fnParamTypes.length {
      return -1
    }
    const bn: string[] = []
    const bt: i32[] = []
    const lams: i32[] = []
    let j = 0
    while j < cn.callArgs.length {
      const a = parenPeelIx(cn.callArgs[j])
      if a >= 0 && nodeAt(a) is FuncDecl {
        lams.push(j)
      } else {
        const at = substTyDeep(nodeTyIxOf(cn.callArgs[j]), names, tys)
        if at < 0 || !elabTyClosed(at, 0) { return -1 }
        bindGenWalk(mf.fnParamTypes[j], widenLitTy(at), bn, bt)
      }
      j = j + 1
    }
    for lj in lams {
      const lp = substTyDeep(mf.fnParamTypes[lj], bn, bt)
      const lf = if lp >= 0 && lp < T.tys.length { tyAt(lp) } else { mf }
      if !(lf is TyFunc) || !tysClosed(lf.fnParamTypes) { return -1 }
      const ft = elabMemberAt(parenPeelIx(cn.callArgs[lj]), lf.fnParamTypes)
      if ft < 0 { return -1 }
      bindGenWalk(mf.fnParamTypes[lj], ft, bn, bt)
    }
    const f = substTyDeep(msig, bn, bt)
    if f < 0 || !elabTyClosed(f, 0) { return -1 }
    if rep >= 0 && !tySame(rep, f) { return -1 }
    rep = f
  }
  rep
}

// Appends to `out` each call under node `ix`, outside a nested function, whose callee reads the
// parameter `pd`.
function elabCallsThrough(ix: i32, pd: i32, out: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  if n is Call && identDeclOf(parenPeelIx(n.callFn)) == pd { out.push(ix) }
  for c in nodeChildren(ix) { elabCallsThrough(c, pd, out) }
  0
}

// The signature of the instance of function `m` whose parameter types are `ats`, its result
// widened; -1 for none.
function elabMemberAt(m: i32, ats: i32[]): i32 {
  const sig = if m >= 0 && m < P.nodes.length { nodeTyIxOf(m) } else { -1 }
  if sig < 0 || sig >= T.tys.length { return -1 }
  const sf = tyAt(sig)
  if !(sf is TyFunc) || sf.fnParamTypes.length != ats.length { return -1 }
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == m {
      const ps: i32[] = []
      let same = true
      let i = 0
      while i < ats.length {
        const p = substTyDeep(sf.fnParamTypes[i], ekNames[k], ekTys[k])
        if p < 0 || !tySame(p, ats[i]) { same = false }
        ps.push(p)
        i = i + 1
      }
      const r = if same { elabResultOf(k) } else { -1 }
      if r >= 0 { return mkFuncTy(ps, widenLitTy(r)) }
    }
    k = k + 1
  }
  -1
}

// The root rows `elabSetRepRow` built, each with its names, types and reps, which
// `elabListSigRow` reads once every instance is in.
let elabListSigRows: i32[] = []
let elabListSigNames: string[][] = []
let elabListSigTys: i32[][] = []
let elabListSigReps: i32[][] = []

// Call `ix`'s root row `names`/`tys`, at `rep` but with each list binding of an untagged set handed
// to it taken at the signature the calls through its elements give (`elabListCallSig`), enqueued
// as a candidate when that moves a type: mono types such a list there where the set's rep is
// not that signature (D15062).
function elabListSigRow(ix: i32, names: string[], tys: i32[], rep: i32[]) {
  const cn = nodeAt(ix)
  const d = elabCallDeclOf(ix)
  if !(cn is Call) || d < 0 || rep.length != tys.length { return 0 }
  const f = nodeAt(d)
  if !(f is FuncDecl) { return 0 }
  const out = rep.slice(0)
  let moved = false
  elabListSigFound = []
  elabListSigFoundTy = []
  let pi = 0
  while pi < f.fnParams.length && pi < cn.callArgs.length {
    const nm = elabParamTyVarName(f, pi)
    const j = if nm == "" { -1 } else { strListIndexOf(names, nm) }
    const ax = parenPeelIx(cn.callArgs[pi])
    const isId = ax >= 0 && ax < P.nodes.length && nodeAt(ax) is Ident
    const bd = if j >= 0 && isId { identDeclOf(ax) } else { -1 }
    const lt = if j >= 0 { tyAt(tys[j]) } else { tyAt(TY_VOID) }
    if bd >= 0 && lt is TyArray {
      const s = fnTagSetOfTy(lt.aElem)
      const sig = if s >= 0 && !fnTagSetIsTagged(s) { elabListCallSig(bd, s) } else { -1 }
      if sig >= 0 && (out[j] < 0 || !tySame(out[j], mkArrayTy(sig))) {
        out[j] = mkArrayTy(sig)
        elabListSigFound.push(s)
        elabListSigFoundTy.push(sig)
        const had = elabListSigOfSet.get(s) ?? -2
        elabListSigOfSet[s] = if had == -2 || had >= 0 && tySame(had, sig) { sig } else { -1 }
        moved = true
      }
    }
    pi = pi + 1
  }
  if !moved { return 0 }
  // A function of one of those sets handed beside the list, with no rep or at the stub, is
  // delivered into it at the list's signature.
  let j2 = 0
  while j2 < out.length {
    const ms = elabFnSetOf(tys[j2])
    const open = out[j2] < 0 || elabIsStubTy(out[j2])
    if ms.length > 0 && open && elabSigOfMembers(ms) >= 0 {
      out[j2] = elabSigOfMembers(ms)
    }
    j2 = j2 + 1
  }
  if !tysClosed(out) { return 0 }
  elabCandidating = true
  const k = elabEnqueue(d, names, out, -1)
  elabCandidating = false
  elabReachNote(-1, k, -1)
  elabSettle(0)
}

// Each untagged set `elabListSigRow` found a list binding of it called at one signature through,
// and that signature; -1 for a set two lists of which are called at two.
let elabListSigOfSet: {[i32]: i32} = Map()

// The sets `elabListSigRow` found a list signature for, in its current row, and each signature.
let elabListSigFound: i32[] = []
let elabListSigFoundTy: i32[] = []

// The list signature found for a set holding every one of `ms`, or -1.
function elabSigOfMembers(ms: i32[]): i32 {
  let i = 0
  while i < elabListSigFound.length {
    const held = fnTagMembers(elabListSigFound[i])
    let all = true
    for m in ms {
      if !i32ListHas(held, m) { all = false }
    }
    if all { return elabListSigFoundTy[i] }
    i = i + 1
  }
  -1
}

// Whether `t` is the no-argument stub a set no member gives a signature reps as.
function elabIsStubTy(t: i32): boolean {
  const ty = tyAt(t)
  ty is TyFunc && ty.fnParamTypes.length == 0 && ty.fnRet == TY_VOID
}

// The closed signature every call through an element of list binding `bd` gives the members of
// set `s`: the calls' widened argument types and the members' one result there; -1 when there is
// no such call, two disagree, or one stays open.
function elabListCallSig(bd: i32, s: i32): i32 {
  let sig = -1
  for c in elabCalls {
    const cn = nodeAt(c)
    if !(cn is Call) { continue }
    const cf = parenPeelIx(cn.callFn)
    if cf < 0 || cf >= P.nodes.length { continue }
    const cfn = nodeAt(cf)
    if !(cfn is Index) { continue }
    const ar = parenPeelIx(cfn.idxArr)
    if ar < 0 || ar >= P.nodes.length || !(nodeAt(ar) is Ident) { continue }
    if identDeclOf(ar) != bd { continue }
    const wp: i32[] = []
    for a in cn.callArgs {
      const at = widenLitTy(nodeTyIxOf(a))
      if at < 0 || !elabTyClosed(at, 0) { return -1 }
      wp.push(at)
    }
    let r = -1
    for m in fnTagMembers(s) {
      const mr = widenLitTy(elabMemberResultAt(m, wp))
      if mr < 0 || r >= 0 && !tySame(r, mr) { return -1 }
      r = mr
    }
    if r < 0 { return -1 }
    const one = mkFuncTy(wp, r)
    if sig >= 0 && !tySame(sig, one) { return -1 }
    sig = one
  }
  sig
}

// Enqueues call `ix`'s row `names`/`tys` with each set of functions taking its rep at `ck`
// (`elabSetRepTy`), when one moves and the row closes.
function elabSetRepRow(ix: i32, names: string[], tys: i32[], ck: i32) {
  // A direct call by name reaches the set-keyed instance once the set is tagged; a call through
  // a value reaches the function at its rep, whatever the set.
  const cn0 = nodeAt(ix)
  const direct = cn0 is Call
    && identDeclOf(parenPeelIx(cn0.callFn)) == elabCallDeclOf(ix)
  const rep: i32[] = []
  let moved = false
  elabRepStubbed = false
  let i0 = 0
  for t in tys {
    const stubbed0 = elabRepStubbed
    elabRepStubbed = false
    // The one generic a set holds runs at what the callee's own calls through the parameter bind,
    // else at the set's rep.
    let rt = -1
    const ms = elabFnSetOf(t)
    if ms.length == 1 && i0 < names.length && !elabIsHoleFn(ms[0]) {
      rt = elabGenericCallRep(ix, names[i0], ms[0], names, tys)
    }
    // A set the callee writes functions into through the parameter runs at their signature.
    const held: i32[] = []
    elabFnIdsIn(t, held, 0)
    if rt < 0 && i0 < names.length && held.length > 0 {
      rt = elabWrittenRep(ix, names[i0], t)
    }
    if rt < 0 { rt = elabSetRepTy(t, 4, ck) }
    // A tagged set is keyed by itself, so it has no instance at its rep.
    if direct && fnTagSetIsTagged(fnTagSetOfTy(t)) { rt = t }
    elabRepStubbed = elabRepStubbed || stubbed0
    if rt != t { moved = true }
    rep.push(rt)
    i0 = i0 + 1
  }
  const rowN = names.slice(0)
  if elabSeedReps(elabCallDeclOf(ix), rowN, tys, rep) { moved = true }
  if ck < 0 {
    elabListSigRows.push(ix)
    elabListSigNames.push(rowN)
    elabListSigTys.push(tys.slice(0))
    elabListSigReps.push(rep.slice(0))
  }
  if moved && rep.length > 0 && tysClosed(rep) {
    // A set no member gives a signature reps as a stub no call reaches, so its instance is a guess.
    elabGuessing = elabRepStubbed
    elabRepresenting = true
    elabSigAlting = direct
    const rk = elabEnqueue(elabCallDeclOf(ix), rowN, rep, -1)
    elabSigAlting = false
    elabRepresenting = false
    elabReachNote(-1, rk, -1)
    if rk >= 0 {
      const rc = elabRepRowCalls[rk] ?? []
      if !i32ListHas(rc, ix) { rc.push(ix) }
      elabRepRowCalls[rk] = rc
    }
    elabGuessing = false
    elabSettle(0)
    return 0
  }
  // A binding to the one generic a set holds, whose root instances disagree, is an instance per
  // signature of theirs when the declaration hands the value back: each use runs it at one.
  if ck >= 0 { return 0 }
  let at = -1
  let i = 0
  while i < tys.length {
    if rep[i] < 0 {
      if at >= 0 { return 0 }
      at = i
    }
    i = i + 1
  }
  if at < 0 { return 0 }
  const ms = elabFnSetOf(tys[at])
  if ms.length != 1 || !elabReturnsParam(elabCallDeclOf(ix), names[at]) {
    return 0
  }
  // A tagged set is keyed by itself, so it has no instance per signature.
  if fnTagSetIsTagged(fnTagSetOfTy(tys[at])) { return 0 }
  for f in elabMemberSigs(ms[0]) {
    const alt = tys.slice(0, tys.length)
    alt[at] = f
    if tysClosed(alt) {
      elabRepresenting = true
      elabSigAlting = true
      elabReachNote(-1, elabEnqueue(elabCallDeclOf(ix), names, alt, -1), -1)
      elabSigAlting = false
      elabRepresenting = false
    }
  }
  elabSettle(0)
}

// The name of declaration `d`'s parameter that hole or type parameter `nm` types, or "".
function elabParamNameOf(d: i32, nm: string): string {
  if d < 0 || d >= P.nodes.length { return "" }
  const dn = nodeAt(d)
  if !(dn is FuncDecl) { return "" }
  let k = -1
  if nm.length > 1 && nm[0] == '?' {
    let dot = nm.length - 1
    while dot > 0 && nm[dot] != '.' { dot = dot - 1 }
    if dot > 0 { k = decDigitsOf(nm.slice(dot + 1, nm.length)) }
  }
  let i = 0
  while i < dn.fnParams.length {
    const pn = nodeAt(dn.fnParams[i])
    if pn is Param {
      if i == k { return pn.parName }
      if k < 0 && pn.parType >= 0 {
        const tn = nodeAt(pn.parType)
        if tn is TypeRef {
          if tn.tyName == nm { return pn.parName }
        }
      }
    }
    i = i + 1
  }
  ""
}

// Whether node `e` is the identifier `name`.
function elabNamesIdent(e: i32, name: string): boolean {
  if e < 0 || e >= P.nodes.length { return false }
  const en = nodeAt(e)
  if en is Ident { return en.identName == name }
  false
}

// Whether declaration `d` returns, by a top-level `return` or its tail, the parameter `nm` types,
// bare or handed to the call it returns.
function elabReturnsParam(d: i32, nm: string): boolean {
  const pn = elabParamNameOf(d, nm)
  if pn == "" { return false }
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || dn.fnBody < 0 { return false }
  const b = nodeAt(dn.fnBody)
  if !(b is Block) { return false }
  let i = 0
  while i < b.blkStmts.length {
    let e = b.blkStmts[i]
    const sn = nodeAt(e)
    if sn is RetStmt { e = sn.retArg }
    if (sn is RetStmt || i == b.blkStmts.length - 1) && e >= 0 {
      if elabNamesIdent(e, pn) { return true }
      const en = nodeAt(e)
      if en is Call {
        for a in en.callArgs {
          if elabNamesIdent(a, pn) { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// The signature of each root instance of function `m`, at its closed parameters and result.
function elabMemberSigs(m: i32): i32[] {
  const out: i32[] = []
  const sig = if m >= 0 && m < P.nodes.length { nodeTyIxOf(m) } else { -1 }
  if sig < 0 || sig >= T.tys.length { return out }
  const sf = tyAt(sig)
  if !(sf is TyFunc) { return out }
  for k in elabRepInstances(-1, m) {
    const ps: i32[] = []
    for p in sf.fnParamTypes { ps.push(substTyDeep(p, ekNames[k], ekTys[k])) }
    const r = elabResultOf(k)
    if r >= 0 && tysClosed(ps) { out.push(mkFuncTy(ps, widenLitTy(r))) }
  }
  out
}

// `t` with each set of functions in it replaced by its rep at instance `ck`: the one signature
// of every member instance `ck` reaches (every root instance, for `ck` -1), or a no-argument stub
// when there is none; -1 when two disagree or one member is reached at two instances.
function elabSetRepTy(t: i32, depth: i32, ck: i32): i32 {
  if t < 0 || t >= T.tys.length || depth <= 0 { return t }
  const ty = tyAt(t)
  if ty is TyArray {
    const e = elabSetRepTy(ty.aElem, depth - 1, ck)
    return if e < 0 { -1 } else if e != ty.aElem { mkArrayTy(e) } else { t }
  }
  if ty is TyNullable {
    const e = elabSetRepTy(ty.nInner, depth - 1, ck)
    return if e < 0 { -1 } else if e != ty.nInner { mkNullableTy(e) } else { t }
  }
  if ty is TyMap {
    const e = elabSetRepTy(ty.mVal, depth - 1, ck)
    return if e < 0 { -1 } else if e != ty.mVal { mkMapTy(ty.mKey, e, ty.mSet) } else { t }
  }
  if ty is TyObj {
    const fs: i32[] = []
    let moved = false
    for ft in ty.objFieldTypes {
      const e = elabSetRepTy(ft, depth - 1, ck)
      if e < 0 { return -1 }
      if e != ft { moved = true }
      fs.push(e)
    }
    return if moved { mkObjTy(ty.objFieldNames, fs) } else { t }
  }
  if !(ty is TyFunc) { return t }
  const ms = elabFnSetOf(t)
  if ms.length == 0 { return t }
  let rep = -1
  for m in ms {
    // A generic no instance reaches is built at its default (D4551), unless calls elsewhere
    // instance it, when it gives the set nothing and an unwritten set reps as the stub (D4123).
    let skip = false
    if ck >= 0 && elabReachedOf(ck, m) == -1 {
      skip = elabCalledAnywhere(m)
      const d = if skip { -1 } else { elabDefaultSig(m) }
      if d >= 0 {
        if rep >= 0 && !tySame(rep, d) { return -1 }
        rep = d
      }
    }
    for k in if skip { [] } else { elabRepInstances(ck, m) } {
      if k < 0 { return -1 }
      const sig = nodeTyIxOf(m)
      const sf = if sig >= 0 && sig < T.tys.length { tyAt(sig) } else { ty }
      if !(sf is TyFunc) { return -1 }
      const ps: i32[] = []
      for p in sf.fnParamTypes { ps.push(substTyDeep(p, ekNames[k], ekTys[k])) }
      const r = elabResultOf(k)
      if r < 0 || !tysClosed(ps) { return -1 }
      const f = mkFuncTy(ps, widenLitTy(r))
      if rep >= 0 && !tySame(rep, f) { return -1 }
      rep = f
    }
  }
  if rep < 0 {
    elabRepStubbed = true
    return mkFuncTy([], TY_VOID)
  }
  rep
}

// Generic `m`'s signature with every type parameter at the default `i32` (D4551); -1 for a
// declaration that is not generic or whose signature does not close.
function elabDefaultSig(m: i32): i32 {
  if m < 0 || m >= P.nodes.length { return -1 }
  const f = nodeAt(m)
  const sig = nodeTyIxOf(m)
  if !(f is FuncDecl) || f.fnTyParams.length == 0 || sig < 0 { return -1 }
  const tys: i32[] = []
  for _tp in f.fnTyParams { tys.push(TY_I32) }
  const s = substTyDeep(sig, f.fnTyParams, tys)
  if s < 0 || s >= T.tys.length || !elabTyClosed(s, 0) { return -1 }
  s
}

// The instances of `m` a set's rep reads: the one instance `ck` reaches ([] for none, [-1] for
// two), or for `ck` -1 every root instance of `m`.
function elabRepInstances(ck: i32, m: i32): i32[] {
  if ck >= 0 {
    const r = elabReachedOf(ck, m)
    return if r == -1 { [] } else if r < 0 { [-1] } else { [r] }
  }
  const out: i32[] = []
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == m && ekParent[k] < 0 { out.push(k) }
    k = k + 1
  }
  out
}

// Row `names`/`tys` of call `ix` with each name a function-typed parameter's result binds taken
// from the result of every function its argument may hold, instanced at that parameter's closed
// types, when they all agree; [] when the row stays open.
function elabRowByFnResults(ix: i32, names: string[], tys: i32[]): i32[] {
  if ix < 0 || ix >= P.nodes.length { return [] }
  const cn = nodeAt(ix)
  const d = elabCallDeclOf(ix)
  if !(cn is Call) || d < 0 || d >= P.nodes.length { return [] }
  const sig = nodeTyIxOf(d)
  if sig < 0 || sig >= T.tys.length { return [] }
  const f = tyAt(sig)
  if !(f is TyFunc) || f.fnParamTypes.length != cn.callArgs.length { return [] }
  const out = tys.slice(0, tys.length)
  let i = 0
  while i < cn.callArgs.length {
    const pt = f.fnParamTypes[i]
    const pf = if pt >= 0 && pt < T.tys.length { tyAt(pt) } else { tyAt(sig) }
    if pt >= 0 && pt < T.tys.length && pf is TyFunc {
      const r = elabArgResultAt(cn.callArgs[i], pf, names, out)
      if r >= 0 {
        const rn: string[] = []
        const rt: i32[] = []
        bindGenWalk(pf.fnRet, r, rn, rt)
        let j = 0
        while j < rn.length {
          let q = 0
          while q < names.length && q < out.length {
            if names[q] == rn[j] && !elabTyClosed(out[q], 0) { out[q] = rt[j] }
            q = q + 1
          }
          j = j + 1
        }
      }
    }
    i = i + 1
  }
  if tysClosed(out) { out } else { [] }
}

// Enqueues each generic or hole function the callee of call `ix` may hold, bound by its signature
// against the call's arguments at their own closed types.
function elabEarlyCallRows(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const cn = nodeAt(ix)
  if !(cn is Call) { return 0 }
  const ats: i32[] = []
  for a in cn.callArgs {
    const at = widenLitTy(nodeTyIxOf(a))
    if at < 0 || at >= T.tys.length || !elabTyClosed(at, 0) { return 0 }
    ats.push(at)
  }
  for m in elabCalleeTargets(cn.callFn) {
    const sig = if m >= 0 && m < P.nodes.length { nodeTyIxOf(m) } else { -1 }
    const sf = if sig >= 0 && sig < T.tys.length { tyAt(sig) } else { cn }
    if sf is TyFunc && sf.fnParamTypes.length == ats.length {
      const mn: string[] = []
      const mt: i32[] = []
      let i = 0
      while i < ats.length {
        bindGenWalk(sf.fnParamTypes[i], ats[i], mn, mt)
        i = i + 1
      }
      if mn.length > 0 { elabReachNote(-1, elabEnqueue(m, mn, mt, -1), -1) }
    }
  }
  0
}

// Row `names`/`tys` of call `ix` to `d` into `outN`/`outT`, with each type parameter of `d` it does
// not bind taken from the arguments: a bare member of a union parameter (`U | string` handed a
// `string`) takes the argument's type, as mono does; a parameter still unbound stays out.
function elabRowComplete(
  ix: i32,
  d: i32,
  names: string[],
  tys: i32[],
  outN: string[],
  outT: i32[],
) {
  let i = 0
  while i < names.length && i < tys.length {
    outN.push(names[i])
    outT.push(tys[i])
    i = i + 1
  }
  if ix < 0 || ix >= P.nodes.length || d < 0 || d >= P.nodes.length { return 0 }
  const cn = nodeAt(ix)
  const f = nodeAt(d)
  if !(cn is Call) || !(f is FuncDecl) || f.fnTyParams.length <= names.length {
    return 0
  }
  for tp in f.fnTyParams {
    if strListHas(outN, tp) { continue }
    const gs = elabTpGenericSeed(f, tp, cn)
    if gs >= 0 {
      outN.push(tp)
      outT.push(gs)
      continue
    }
    let a = 0
    while a < f.fnParams.length && a < cn.callArgs.length {
      const pt = nodeTyIxOf(f.fnParams[a])
      const u = if pt >= 0 && pt < T.tys.length { tyAt(pt) } else { cn }
      const at = widenLitTy(nodeTyIxOf(cn.callArgs[a]))
      if (
        u is TyNullable
        && at >= 0
        && at < T.tys.length
        && elabTyClosed(at, 0)
      ) {
        const iv = if u.nInner >= 0 && u.nInner < T.tys.length { tyAt(u.nInner) } else { cn }
        if iv is TyVar && iv.tvName == tp && !strListHas(outN, tp) {
          outN.push(tp)
          outT.push(at)
        }
      }
      if u is TyUnion && at >= 0 && at < T.tys.length && elabTyClosed(at, 0) {
        for m in u.uMembers {
          const mv = if m >= 0 && m < T.tys.length { tyAt(m) } else { cn }
          if mv is TyVar && mv.tvName == tp && !strListHas(outN, tp) {
            outN.push(tp)
            outT.push(at)
          }
        }
      }
      a = a + 1
    }
  }
  0
}

// The signature of the one generic function call `cn` hands the parameter of `f` that seeds a
// binding of `f`'s body annotated bare with type parameter `tp`, so each call through the binding
// instances the generic at its own types; -1 when no such seed holds one generic, or two disagree.
function elabTpGenericSeed(f: FuncDecl, tp: string, cn: Call): i32 {
  let out = -1
  const stack: i32[] = [f.fnBody]
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is LetDecl && n.letType >= 0 && n.letInit >= 0 {
        const tn = nodeAt(n.letType)
        const v = parenPeelIx(n.letInit)
        if tn is TypeRef && tn.tyName == tp && v >= 0 && nodeAt(v) is Ident {
          const pd = identDeclOf(v)
          let a = 0
          while a < f.fnParams.length && f.fnParams[a] != pd { a = a + 1 }
          if a >= f.fnParams.length || a >= cn.callArgs.length { return -1 }
          const ms = elabCalleeTargets(cn.callArgs[a])
          if ms.length != 1 || ms[0] < 0 || ms[0] >= P.nodes.length {
            return -1
          }
          const g = nodeAt(ms[0])
          if !(g is FuncDecl) || g.fnTyParams.length == 0 { return -1 }
          const t = nodeTyIxOf(parenPeelIx(cn.callArgs[a]))
          if t < 0 || !tyHasTyVar(t) || (out >= 0 && out != t) { return -1 }
          out = t
        }
      }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  out
}

// Row `names`/`tys` of call `ix` with each open binding taken from an argument that is no function
// value, at its own closed type, by its parameter's declared type (`u: U` handed `"ab"`); [] when
// the row stays open.
function elabRowByPlainArgs(ix: i32, names: string[], tys: i32[]): i32[] {
  if ix < 0 || ix >= P.nodes.length { return [] }
  const cn = nodeAt(ix)
  const d = elabCallDeclOf(ix)
  if !(cn is Call) || d < 0 || d >= P.nodes.length { return [] }
  const sig = nodeTyIxOf(d)
  if sig < 0 || sig >= T.tys.length { return [] }
  const f = tyAt(sig)
  if !(f is TyFunc) || f.fnParamTypes.length != cn.callArgs.length { return [] }
  const out = tys.slice(0, tys.length)
  let i = 0
  while i < cn.callArgs.length {
    const at = widenLitTy(nodeTyIxOf(cn.callArgs[i]))
    const pt = f.fnParamTypes[i]
    const pf = if pt >= 0 && pt < T.tys.length { tyAt(pt) } else { tyAt(sig) }
    if at >= 0 && at < T.tys.length && elabTyClosed(at, 0) && !(pf is TyFunc) {
      const rn: string[] = []
      const rt: i32[] = []
      bindGenWalk(pt, at, rn, rt)
      // A bare member of a union parameter (`U | string` handed a `string`) takes the argument.
      if pf is TyUnion {
        for m in pf.uMembers {
          const mv = if m >= 0 && m < T.tys.length { tyAt(m) } else { pf }
          if mv is TyVar {
            rn.push(mv.tvName)
            rt.push(at)
          }
        }
      }
      let j = 0
      while j < rn.length {
        let q = 0
        while q < names.length && q < out.length {
          if names[q] == rn[j] && !elabTyClosed(out[q], 0) { out[q] = rt[j] }
          q = q + 1
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  if tysClosed(out) { out } else { [] }
}

// Row `tys` of call `ix` with each open list whose element is an inference hole nothing pinned (an
// empty `[]`, alone or joined with `null`) taken at `i32` elements, the list mono builds there; []
// when the row stays open.
function elabRowEmptyListDefaults(ix: i32, tys: i32[]): i32[] {
  if ix < 0 || ix >= P.nodes.length { return [] }
  const out: i32[] = []
  for t in tys {
    if t >= 0 && !elabTyClosed(t, 0) {
      out.push(elabEmptyElemsAtI32(t))
    } else {
      out.push(t)
    }
  }
  if tysClosed(out) { out } else { [] }
}

// `t` with each list of an unpinned inference-hole element, under any nullable, at `i32[]`, and a
// nullable of nothing at `null`.
function elabEmptyElemsAtI32(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return t }
  const x = tyAt(t)
  match x {
    TyNullable => {
      // A binding only `null` fills (`const n = null`) holds `null`, as mono builds it.
      if x.nInner < 0 { return TY_NULL }
      return mkNullableTy(elabEmptyElemsAtI32(x.nInner))
    }
    TyArray => {
      if x.aElem < 0 { return mkArrayTy(TY_I32) }
      if x.aElem < T.tys.length {
        const e = tyAt(x.aElem)
        if e is TyVar && (e.tvName.length == 0 || e.tvName[0] == "?"[0]) {
          return mkArrayTy(TY_I32)
        }
      }
      return t
    }
    TyPrim | TyFunc | TyObj | TyUnion | TyMap | TyVar | TyLit | TyNeg | TyErr => {
      // No list whose element is unpinned at the top or under a nullable.
      return t
    }
  }
}

// Row `tys` of call `ix` with each binding that is a bare type variable of a generic an argument
// holds at the default `i32` (D4551): nothing binds a generic handed only to an open slot. []
// when the row still does not close.
function elabRowArgDefaults(ix: i32, tys: i32[]): i32[] {
  if ix < 0 || ix >= P.nodes.length { return [] }
  const cn = nodeAt(ix)
  if !(cn is Call) { return [] }
  const own: string[] = []
  for a in cn.callArgs {
    for m in elabCalleeTargets(a) {
      const ms = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { cn }
      if ms is FuncDecl {
        for tp in ms.fnTyParams { own.push(tp) }
      }
    }
  }
  if own.length == 0 { return [] }
  const out: i32[] = []
  for t in tys {
    const tv = if t >= 0 && t < T.tys.length { tyAt(t) } else { cn }
    if tv is TyVar && strListHas(own, tv.tvName) {
      out.push(TY_I32)
    } else {
      out.push(t)
    }
  }
  if tysClosed(out) { out } else { [] }
}

// The one result every function argument `a` may hold gives at function type `pf`'s parameters
// under `names`/`tys`, each instanced there; -1 when they are not closed or disagree.
function elabArgResultAt(a: i32, pf: TyFunc, names: string[], tys: i32[]): i32 {
  const pts: i32[] = []
  for p in pf.fnParamTypes {
    const st = substTyDeep(p, names, tys)
    if st < 0 || !elabTyClosed(st, 0) { return -1 }
    pts.push(st)
  }
  const ms = elabCalleeTargets(a)
  const hd = holeFnArgDecl(a)
  if hd >= 0 && !i32ListHas(ms, hd) { ms.push(hd) }
  if ms.length == 0 { return -1 }
  let out = -1
  for m in ms {
    const sig = if m >= 0 && m < P.nodes.length { nodeTyIxOf(m) } else { -1 }
    if sig < 0 || sig >= T.tys.length { return -1 }
    const sf = tyAt(sig)
    if !(sf is TyFunc) || sf.fnParamTypes.length != pts.length { return -1 }
    const mn: string[] = []
    const mt: i32[] = []
    let i = 0
    while i < pts.length {
      bindGenWalk(sf.fnParamTypes[i], pts[i], mn, mt)
      i = i + 1
    }
    const n0 = ekDecl.length
    const k = elabEnqueue(m, mn, mt, -1)
    elabReachNote(-1, k, -1)
    elabSettle(n0)
    const r = if k >= 0 { elabResultOf(k) } else { -1 }
    if r < 0 || !elabTyClosed(r, 0) || (out >= 0 && !tySame(out, r)) {
      return -1
    }
    out = r
  }
  widenLitTy(out)
}

// The closed map an open map whose key or value nothing types is built at: a hole key as `string`,
// a hole value as `i32`, the other side kept (D1887). -1 for a set, a closed map, a map whose
// typed side still names a type variable, and every other type.
export function elabHoleMapClosed(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const m = tyAt(t)
  if !(m is TyMap) || m.mSet == 1 { return -1 }
  const kh = m.mKey < 0 || (tyAt(m.mKey) is TyVar && tyHasInferHole(m.mKey, 0))
  const vh = m.mVal < 0 || (tyAt(m.mVal) is TyVar && tyHasInferHole(m.mVal, 0))
  if !kh && !vh { return -1 }
  if (!kh && tyHasTyVar(m.mKey)) || (!vh && tyHasTyVar(m.mVal)) { return -1 }
  const k = if kh { TY_STR } else { m.mKey }
  const v = if vh { TY_I32 } else { m.mVal }
  const key = i32ToStr(k) + ":" + i32ToStr(v)
  const have = elabHoleMapMemo[key] ?? -1
  if have >= 0 { return have }
  const c = mkMapTy(k, v, 0)
  elabHoleMapMemo[key] = c
  c
}

// `elabHoleMapClosed`'s maps since the last `elabRun`, by key and value.
let elabHoleMapMemo: {[string]: i32} = Map()

// The closed function type an open function `t` no instance reaches is built at: each open
// parameter and an open result as `i32`, a default no program can observe since no call reaches
// it (D9100). -1 for a closed or non-function type.
export function elabHoleFnClosed(t: i32): i32 {
  if t < 0 || t >= T.tys.length || !tyHasTyVar(t) { return -1 }
  const f = tyAt(t)
  if !(f is TyFunc) { return -1 }
  const ps: i32[] = []
  for p in f.fnParamTypes { ps.push(if tyHasTyVar(p) { TY_I32 } else { p }) }
  const r = if tyHasTyVar(f.fnRet) { TY_I32 } else { f.fnRet }
  mkFuncTy(ps, r)
}

// The one closed signature every function `ds` names is instanced at outside a guess, or the
// D9100 default where none is instanced and no call reaches one of them; -1 where two
// instances disagree, only some are instanced, or a call no instance answers reaches them.
function elabHeldFnTy(t: i32, ds: i32[], holder: i32, path: string[]): i32 {
  // The slot's own calls, where they agree on one closed tuple, decide before any instance.
  const own = if holder >= 0 { fnSlotCallArgsOf(holder, path) } else { [] }
  if own.length > 0 && ds.length > 0 { return elabHeldAtArgs(ds, own) }
  let sig = -1
  let bare = 0
  const bares: i32[] = []
  for d in ds {
    if d < 0 { return -1 }
    let seen = false
    let k = 0
    while k < ekDecl.length {
      if ekDecl[k] == d && !(elabGuessKeys.get(k) ?? false) {
        const st = elabSubstClosed(nodeTyIxOf(d), k)
        if st < 0 || (sig >= 0 && !tySame(sig, st)) { return -1 }
        sig = st
        seen = true
      }
      k = k + 1
    }
    if !seen {
      bare = bare + 1
      bares.push(d)
    }
  }
  if sig >= 0 && bare == 0 { return sig }
  // A member no instance answers yet is demanded at the others' parameters, and must agree.
  const so = if sig >= 0 { tyAt(sig) } else { null }
  if so is TyFunc {
    for d in bares {
      if (
        !elabTopFn(d)
        || !tySame(elabResultAtParams(d, so.fnParamTypes), so.fnRet)
      ) {
        return -1
      }
    }
    return sig
  }
  if ds.length == 0 { return -1 }
  if !fnSetCalledWithAny(ds) { return elabHoleFnClosed(t) }
  // Called through a function value at one closed tuple no instance records yet: each member's
  // instance there, demanded now, gives the signature when every one agrees.
  const pts = fnSetCallArgsOf(ds)
  if pts.length == 0 { return -1 }
  let r = -1
  for d in ds {
    if holder >= 0 && !elabTopFn(d) { return -1 }
    const dr = elabResultAtParams(d, pts)
    if dr < 0 || (r >= 0 && !tySame(r, dr)) { return -1 }
    r = dr
  }
  if r < 0 { -1 } else { mkFuncTy(pts, r) }
}

// The signature every top-level function of `ds` has at closed parameters `pts`, demanding each
// instance there; -1 where one is not top-level or two results disagree.
function elabHeldAtArgs(ds: i32[], pts: i32[]): i32 {
  let r = -1
  for d in ds {
    if !elabTopFn(d) { return -1 }
    const dr = elabResultAtParams(d, pts)
    if dr < 0 || (r >= 0 && !tySame(r, dr)) { return -1 }
    r = dr
  }
  if r < 0 { -1 } else { mkFuncTy(pts, r) }
}

// Whether the slot producer may demand an instance of `d`: a top-level declaration, or a lambda
// whose enclosing scope is the module, which captures no local and so has the instance a top-level
// declaration would. A nested or capturing one checks only in its own scope.
function elabTopFn(d: i32): boolean {
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is FuncDecl) { return false }
  if dn.fnName != "" && (fnDeclIx[dn.fnName] ?? -1) == d { return true }
  elabModuleLam(d)
}

// Whether lambda `d` sits in a module-level statement with no function, block or loop around it,
// so every name it reads is the module's.
function elabModuleLam(d: i32): boolean {
  let cur = if cwIxCovers(d) { cwIxParent[d] } else { -1 }
  let guard = 0
  while cur >= 0 && cur < P.nodes.length && guard < 64 {
    const c = nodeAt(cur)
    if c is Program { return true }
    if (
      c is FuncDecl
      || c is Block
      || c is ForIn
      || c is ForRange
      || c is WhileStmt
      || c is MatchExpr
    ) {
      return false
    }
    cur = if cwIxCovers(cur) { cwIxParent[cur] } else { -1 }
    guard = guard + 1
  }
  false
}

// Type `t` a list, record or map holds, the values `vals` stored at it, with each open function
// leaf at the signature `elabHeldFnTy` gives the functions its set and those values name, and
// each open map at `elabHoleMapClosed`, through lists, records and maps (D15294). `t` where
// nothing is open; -1 where a leaf cannot close or a stored value is not followed.
function elabHeldClosedTy(t: i32, vals: i32[], depth: i32): i32 {
  const none: string[] = []
  elabHeldClosedTyAt(t, vals, depth, -1, none, -1)
}

// `elabHeldClosedTy` at slot `path` of binding `holder` (-1 for none), whose calls decide a
// function leaf's parameters first, and where a value that reads another binding takes that
// binding's slot fact. In instance `k` (-1 for the program) a function leaf is closed from `k`'s
// own calls and the instances already enumerated under it (`elabHeldFnTyIn`).
function elabHeldClosedTyAt(
  t: i32,
  vals: i32[],
  depth: i32,
  holder: i32,
  path: string[],
  k: i32,
): i32 {
  if t < 0 || t >= T.tys.length || depth > 8 { return -1 }
  if !tyHasTyVar(t) { return t }
  const bound = elabHeldBoundTy(vals)
  if bound >= 0 { return bound }
  const o = tyAt(t)
  match o {
    TyFunc => {
      const ds: i32[] = []
      for d in elabFnSetOf(t) {
        if !i32ListHas(ds, d) { ds.push(d) }
      }
      const closed: i32[] = []
      for v in vals {
        if !elabHeldValFns(parenPeelIx(v), ds, closed) { return -1 }
      }
      if ds.length == 0 && closed.length > 0 {
        return elabHeldClosedAgree(closed[0], closed)
      }
      const ft = if k >= 0 { elabHeldFnTyIn(ds, holder, path, k) } else { elabHeldFnTy(t, ds, holder, path) }
      return elabHeldClosedAgree(ft, closed)
    }
    TyArray => {
      const ev: i32[] = []
      for v in vals {
        const x = parenPeelIx(v)
        const xn = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
        if !(xn is ArrayLit) { return -1 }
        for e in xn.arrElems { ev.push(e) }
      }
      const e = elabHeldClosedTyAt(
        o.aElem,
        ev,
        depth + 1,
        holder,
        elabPathPlus(path, "e"),
        k,
      )
      return if e < 0 { -1 } else if e == o.aElem { t } else { mkArrayTy(e) }
    }
    TyObj => {
      const tys: i32[] = []
      let i = 0
      while i < o.objFieldNames.length {
        const fv: i32[] = []
        for v in vals {
          const x = parenPeelIx(v)
          const xn = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
          if !(xn is ObjLit) { return -1 }
          for fx in xn.objFields {
            const f = nodeAt(fx)
            if f is FieldInit && f.fiName == o.objFieldNames[i] {
              fv.push(f.fiValue)
            }
          }
        }
        const c = elabHeldClosedTyAt(
          o.objFieldTypes[i],
          fv,
          depth + 1,
          holder,
          elabPathPlus(path, "f." + o.objFieldNames[i]),
          k,
        )
        if c < 0 { return -1 }
        tys.push(c)
        i = i + 1
      }
      const names: string[] = []
      for nm in o.objFieldNames { names.push(nm) }
      return mkObjTy(names, tys)
    }
    TyMap => {
      // A binding stored here is built at its own type, which a reader settles before asking.
      if vals.length > 0 { return -1 }
      const hm = elabHoleMapClosed(t)
      if hm >= 0 { return hm }
      const noVals: i32[] = []
      const v = elabHeldClosedTyAt(
        o.mVal,
        noVals,
        depth + 1,
        holder,
        elabPathPlus(path, "v"),
        k,
      )
      if v < 0 || tyHasTyVar(o.mKey) { return -1 }
      return mkMapTy(o.mKey, v, o.mSet)
    }
    // No other kind holds a function a slot can close.
    TyPrim | TyErr | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {
      return -1
    }
  }
}

// Adds the functions stored value `x` holds to `ds`: a declaration, or one a name reads; any other
// value at its own checked type, a closed function type pushed onto `closed`, an open one adding
// the top-level functions its set names. False where `x` has neither, or its set a lambda.
function elabHeldValFns(x: i32, ds: i32[], closed: i32[]): boolean {
  const xn = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
  let d = -1
  if xn is FuncDecl { d = x }
  else if xn is Ident { d = identDeclOf(x) }
  if d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl {
    if !i32ListHas(ds, d) { ds.push(d) }
    return true
  }
  const vt = if xn != null { nodeTyIxOf(x) } else { -1 }
  if vt < 0 || vt >= T.tys.length || !(tyAt(vt) is TyFunc) { return false }
  if !tyHasTyVar(vt) {
    closed.push(vt)
    return true
  }
  const ms = elabFnSetOf(vt)
  for m in ms {
    if !elabTopFn(m) { return false }
    if !i32ListHas(ds, m) { ds.push(m) }
  }
  ms.length > 0
}

// `ft` where every type of `closed` is the same as it; -1 otherwise.
function elabHeldClosedAgree(ft: i32, closed: i32[]): i32 {
  if ft < 0 { return -1 }
  for c in closed {
    if !tySame(c, ft) { return -1 }
  }
  ft
}

// `path` with step `k` appended, a fresh list.
function elabPathPlus(path: string[], k: string): string[] {
  const out: string[] = []
  for p in path { out.push(p) }
  out.push(k)
  out
}

// The slot fact of the binding every one of `vals` reads, where they all read bindings that have
// one and agree; -1 otherwise.
function elabHeldBoundTy(vals: i32[]): i32 {
  if vals.length == 0 { return -1 }
  let t = -1
  for v in vals {
    const x = parenPeelIx(v)
    if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return -1 }
    const d = identDeclOf(x)
    const ft = elabSlotTys[elabSlotKey(d, -1)] ?? -1
    if ft < 0 || (t >= 0 && !tySame(t, ft)) { return -1 }
    t = ft
  }
  t
}

// Holder and instance → the closed type the holder's value is built at there: a `let` binding's
// declaration, or a function's for the value it returns. Present only where the elaboration
// closed it; read through `elabSlotTyAt`.
let elabSlotTys: {[string]: i32} = Map()

function elabSlotKey(holder: i32, k: i32): string {
  i32ToStr(holder) + "|" + i32ToStr(k)
}

// The closed type slot `path` (`e`, `v`, `f.<name>`, outermost last; empty for the value) of
// `holder` is built at in emitted function `fnIx`'s frame, a generic's instance at that instance's
// own fact; -1 where the elaboration has none, and in a generic's own template.
export function elabSlotTyAt(holder: i32, path: string[], fnIx: i32): i32 {
  if holder < 0 { return -1 }
  const fd = if fnIx >= 0 && fnIx < P.nodes.length { nodeAt(fnIx) } else { null }
  if fd is FuncDecl && fd.fnTyParams.length > 0 { return -1 }
  // A generic's instance has its own fact under its key; any other frame reads the program's.
  const ik = if fnIx >= 0 { elabKeyAt(fnIx) } else { -1 }
  // A generic's body is cloned per instance; the fact is keyed at the clone's source binding.
  const hs = nodeSrc[holder] ?? -1
  const src = if hs >= 0 { hs } else { holder }
  const own = if ik >= 0 { elabSlotTys[elabSlotKey(src, ik)] ?? -1 } else { -1 }
  let t = if own >= 0 { own } else { elabSlotTys[elabSlotKey(holder, -1)] ?? -1 }
  for p in path {
    if t < 0 || t >= T.tys.length { return -1 }
    const o = tyAt(t)
    if p == "e" && o is TyArray {
      t = o.aElem
    } else if p == "v" && o is TyMap {
      t = o.mVal
    } else if o is TyObj && p.length > 2 && p.slice(0, 2) == "f." {
      const nm = p.slice(2, p.length)
      let next = -1
      let i = 0
      while i < o.objFieldNames.length {
        if o.objFieldNames[i] == nm { next = o.objFieldTypes[i] }
        i = i + 1
      }
      t = next
    } else {
      return -1
    }
  }
  t
}

// Closes every `let` binding outside a generic whose value holds an open function leaf, and every
// such function's returned list literals, at the type `elabHeldClosedTyAt` gives the values its
// slots are written, for `elabSlotTyAt`.
function elabSlotFacts() {
  const n0 = ekDecl.length
  const inst: i32[] = []
  const instFn: i32[] = []
  let ix = 0
  while ix < P.nodes.length {
    const n = nodeAt(ix)
    if n is LetDecl && n.letType < 0 && n.letInit >= 0 {
      const t = nodeTyIxOf(ix)
      if elabSlotOpenFn(t) {
        // A binding in an instanced function's body is closed per instance only: a program-level
        // fact would be one computed at the template's open types, and an instance must never read it.
        const fd = recEnclosingFn(ix)
        const fdn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
        if fdn is FuncDecl && elabFnInstanced(fdn) {
          inst.push(ix)
          instFn.push(fd)
        } else {
          const ft = elabSlotClose(ix, t, [n.letInit], -1)
          if ft >= 0 { elabSlotTys[elabSlotKey(ix, -1)] = ft }
        }
      }
    }
    if (
      n is FuncDecl
      && n.fnRet < 0
      && n.fnTyParams.length == 0
      && n.fnBody >= 0
    ) {
      const ft0 = nodeTyIxOf(ix)
      const fo = if ft0 >= 0 && ft0 < T.tys.length { tyAt(ft0) } else { null }
      if fo is TyFunc && elabSlotOpenFn(fo.fnRet) {
        const vs: i32[] = []
        collectRetValues(n.fnBody, vs)
        const ev = elabSlotRetElems(vs)
        if ev.length > 0 {
          const ft = elabSlotCloseElems(-1, fo.fnRet, ev, -1)
          if ft >= 0 { elabSlotTys[elabSlotKey(ix, -1)] = ft }
        }
      }
    }
    ix = ix + 1
  }
  if ekDecl.length > n0 { elabSettle(0) }
  elabSlotInstFacts(inst, instFn)
  0
}

// Closes each binding of `hs`, declared in the generic `fns[i]`, once per non-guess instance of it,
// keyed by that instance. Asked after the run's last settle, so every instance has been re-checked
// and its keyed call notes are complete; it demands nothing.
// Whether `fd` is instanced per call: generic, or with a parameter written without a type.
function elabFnInstanced(fd: FuncDecl): boolean {
  if fd.fnTyParams.length > 0 { return true }
  for p in fd.fnParams {
    const pn = nodeAt(p)
    if pn is Param && pn.parType < 0 { return true }
  }
  false
}

function elabSlotInstFacts(hs: i32[], fns: i32[]) {
  let i = 0
  while i < hs.length && i < fns.length {
    const h = hs[i]
    const hn = nodeAt(h)
    let k = 0
    while k < ekDecl.length {
      if (
        ekDecl[k] == fns[i]
        && !(elabGuessKeys.get(k) ?? false)
        && hn is LetDecl
      ) {
        const ft = elabSlotClose(h, nodeTyIxOf(h), [hn.letInit], k)
        if ft >= 0 && !tyHasTyVar(ft) { elabSlotTys[elabSlotKey(h, k)] = ft }
      }
      k = k + 1
    }
    i = i + 1
  }
  0
}

// `elabHeldFnTy` in instance `k`: the one closed signature the functions `ds` have at the instances
// already enumerated under `k`, the one `k`'s own calls through slot `path` of `holder` make where
// they make one; -1 where none is enumerated, none fits those calls, or two differ. Demands none.
function elabHeldFnTyIn(ds: i32[], holder: i32, path: string[], k: i32): i32 {
  if ds.length == 0 { return -1 }
  const own = fnSlotCallArgsAt(holder, path, k)
  let sig = -1
  for d in ds {
    let ds1 = -1
    for kd in elabKidsAt(d, k) {
      if !(elabGuessKeys.get(kd) ?? false) {
        const st = elabSubstClosed(nodeTyIxOf(d), kd)
        const so = if st >= 0 && st < T.tys.length { tyAt(st) } else { null }
        if (
          so is TyFunc
          && (own.length == 0 || elabTysSame(so.fnParamTypes, own))
        ) {
          if ds1 >= 0 && !tySame(ds1, st) { return -1 }
          ds1 = st
        }
      }
    }
    if ds1 < 0 || (sig >= 0 && !tySame(sig, ds1)) { return -1 }
    sig = ds1
  }
  sig
}

// The elements every value of `vs` stores, a list literal's own or those a `let` binding's slot is
// written; empty when one is neither.
function elabSlotRetElems(vs: i32[]): i32[] {
  const none: i32[] = []
  const ev: i32[] = []
  for v in vs {
    const x = parenPeelIx(v)
    const xn = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
    if xn is ArrayLit {
      for e in xn.arrElems { ev.push(e) }
    } else if (
      xn is Ident
      && identDeclOf(x) >= 0
      && nodeAt(identDeclOf(x)) is LetDecl
    ) {
      const ats: i32[] = []
      if cwSlotWrittenValues(identDeclOf(x), ["[]"], ev, ats) < 0 {
        return none
      }
    } else {
      return none
    }
  }
  ev
}

// The list type `t` built at the closed type its elements `ev` give its element, read at slot `e`
// of `d` (-1 for none), in instance `k` (-1 for the program); -1 where it does not close.
function elabSlotCloseElems(d: i32, t: i32, ev: i32[], k: i32): i32 {
  const o = tyAt(t)
  if !(o is TyArray) || ev.length == 0 { return -1 }
  const path: string[] = ["e"]
  const e = elabHeldClosedTyAt(o.aElem, ev, 0, d, path, k)
  if e < 0 || tyHasTyVar(e) { -1 } else { mkArrayTy(e) }
}

// Whether `t` is an open list, record or map holding a function leaf.
function elabSlotOpenFn(t: i32): boolean {
  if t < 0 || t >= T.tys.length || !tyHasTyVar(t) { return false }
  const o = tyAt(t)
  if !(o is TyArray) && !(o is TyObj) && !(o is TyMap) { return false }
  const ds: i32[] = []
  elabFnIdsIn(t, ds, 0)
  ds.length > 0
}

// The closed type of a value of type `t` stored from `inits`, a list's elements read through every
// write the binding `d` (-1 for none) takes at them, in instance `k` (-1 for the program); -1 where
// one does not close or a write is not followed.
function elabSlotClose(d: i32, t: i32, inits: i32[], k: i32): i32 {
  const o = tyAt(t)
  if o is TyArray {
    const ev: i32[] = []
    const ats: i32[] = []
    if cwSlotWrittenValues(d, ["[]"], ev, ats) < 0 {
      return if k < 0 { elabSlotFromSources(d, t) } else { -1 }
    }
    return elabSlotCloseElems(d, t, ev, k)
  }
  // A map binding's values are what its writes store; an open key closes as an unwritten one does.
  if o is TyMap && o.mSet != 1 {
    const mv: i32[] = []
    const ats: i32[] = []
    const wr = cwSlotWrittenValues(d, ["[]"], mv, ats)
    if wr < 0 { return if k < 0 { elabSlotFromSources(d, t) } else { -1 } }
    if mv.length == 0 { return -1 }
    const path: string[] = ["v"]
    const v = elabHeldClosedTyAt(o.mVal, mv, 0, d, path, k)
    if v < 0 || tyHasTyVar(v) { return -1 }
    const kt = if tyHasInferHole(o.mKey, 0) { TY_STR } else { o.mKey }
    return if tyHasTyVar(kt) { -1 } else { mkMapTy(kt, v, o.mSet) }
  }
  const none: string[] = []
  const c = elabHeldClosedTyAt(t, inits, 0, d, none, k)
  if c < 0 || tyHasTyVar(c) { -1 } else { c }
}

// The closed list or map type `t` of `let` binding `d` whose initialiser reads other holders'
// slots (`slotOfRead`, each `...b` of a literal one more) rather than a literal: their one closed
// fact, the functions `d`'s own writes and the literal's other elements store agreeing at it; -1
// where a source has no fact, two differ, or a stored function is not that type at its parameters.
function elabSlotFromSources(d: i32, t: i32): i32 {
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letInit < 0 || t < 0 || t >= T.tys.length {
    return -1
  }
  const init = parenPeelIx(dn.letInit)
  if init < 0 || init >= P.nodes.length { return -1 }
  const own: i32[] = []
  const srcs: i32[] = []
  const il = nodeAt(init)
  if il is ArrayLit {
    for e in il.arrElems {
      const en = nodeAt(parenPeelIx(e))
      if en is Spread { srcs.push(en.spdArg) } else { own.push(e) }
    }
  } else {
    srcs.push(init)
  }
  if srcs.length == 0 { return -1 }
  // A copy of a whole binding (`b.slice(...)`, `[...b, v]`) holds `b`'s values and is decided at
  // its own calls; a read of a slot or a call's result holds that slot's fact.
  const ev: i32[] = []
  let whole = true
  for x in srcs {
    const path: string[] = []
    const h = slotOfRead(x, path)
    const hn = if h >= 0 && h < P.nodes.length { nodeAt(h) } else { null }
    if !(hn is LetDecl) || path.length > 0 || h == d {
      whole = false
    } else {
      const ats0: i32[] = []
      if cwSlotWrittenValues(h, ["[]"], ev, ats0) < 0 { whole = false }
    }
  }
  if whole && tyAt(t) is TyArray {
    for v in own { ev.push(v) }
    const ats1: i32[] = []
    if cwSlotValuesFrom(d, dn.letInit, [], ["[]"], ev, ats1) < 0 { return -1 }
    return elabSlotCloseElems(d, t, ev, -1)
  }
  let st = -1
  for x in srcs {
    const path: string[] = []
    const h = slotOfRead(x, path)
    if h < 0 || h == d { return -1 }
    const ft = elabSlotTyAt(h, path, -1)
    if ft < 0 || tyHasTyVar(ft) || (st >= 0 && !tySame(st, ft)) { return -1 }
    st = ft
  }
  const ats: i32[] = []
  if cwSlotValuesFrom(d, dn.letInit, [], ["[]"], own, ats) < 0 { return -1 }
  if own.length == 0 { return st }
  const so = tyAt(st)
  const ot = tyAt(t)
  const et = if so is TyArray { so.aElem } else if so is TyMap { so.mVal } else { -1 }
  const oe = if ot is TyArray { ot.aElem } else if ot is TyMap { ot.mVal } else { -1 }
  const ef = if et >= 0 { tyAt(et) } else { null }
  if !(ef is TyFunc) || oe < 0 || !(tyAt(oe) is TyFunc) { return -1 }
  const ds: i32[] = []
  const closed: i32[] = []
  for v in own {
    if !elabHeldValFns(parenPeelIx(v), ds, closed) { return -1 }
  }
  const r = if ds.length > 0 { elabHeldAtArgs(ds, ef.fnParamTypes) } else { et }
  if elabHeldClosedAgree(r, closed) < 0 || !tySame(r, et) { return -1 }
  st
}

// Binding `tys` of call `ix` with each un-annotated parameter, or one its own type parameter
// alone annotates, handed a tagged set bound to the set itself: the instance calls each member at its own arguments, so no one signature stands for it.
// One handed only uncalled hole functions is bound to the stub the monomorphizer primed.
function elabSetArgBind(ix: i32, names: string[], tys: i32[]): i32[] {
  const cn = nodeAt(ix)
  const d = elabCallDeclOf(ix)
  if !(cn is Call) || d < 0 { return tys }
  const f = nodeAt(d)
  if !(f is FuncDecl) { return tys }
  let out = tys
  let copied = false
  let i = 0
  while i < cn.callArgs.length && i < f.fnParams.length {
    const ax = parenPeelIx(cn.callArgs[i])
    // A function named where the late decision made it an id carries its set, as mono reads it.
    const ls = if fnTagTyIsTagged(nodeTyIxOf(ax)) { -1 } else { fnTagLeafSetOf(ax) }
    const st = if ls >= 0 && fnTagSetTy(ls) >= 0 { fnTagSetTy(ls) } else { nodeTyIxOf(ax) }
    const named = i < cn.callArgNames.length && cn.callArgNames[i] != ""
    const pn = nodeAt(f.fnParams[i])
    const alone = pn is Param
      && pn.parType >= 0
      && fnTagOwnTyParamJoins(f, i, cn.callArgs)
    // An argument of only uncalled hole functions binds the stub it is delivered at (D6881),
    // unless it is a tagged set's id.
    const stub = elabStubArg.get(i32ToStr(ix) + ":" + i32ToStr(i)) ?? -1
    const js = if pn is Param && pn.parType >= 0 { fnTagSharedJoinSet(f, i, cn.callArgs) } else { -1 }
    // An open map the call binds a type parameter to is that parameter's closed map (D1887).
    const hmTv = if pn is Param { elabParamTyVarName(f, i) } else { "" }
    let j0 = 0
    while !named && hmTv != "" && j0 < names.length && j0 < out.length {
      const hm = if names[j0] == hmTv { elabHoleMapClosed(out[j0]) } else { -1 }
      if hm >= 0 {
        if !copied {
          out = tys.slice(0, tys.length)
          copied = true
        }
        out[j0] = hm
      }
      j0 = j0 + 1
    }
    if (
      !named
      && pn is Param
      && pn.parType < 0
      && stub >= 0
      && !fnTagTyIsTagged(st)
    ) {
      const hn = elabHoleRootName(nodeTyIxOf(f.fnParams[i]))
      let j = 0
      while j < names.length && j < out.length {
        if hn != "" && names[j] == hn && (tys[j] < 0 || tyHasTyVar(tys[j])) {
          if !copied {
            out = tys.slice(0, tys.length)
            copied = true
          }
          out[j] = stub
        }
        j = j + 1
      }
    } else if !named && pn is Param && js >= 0 && js != fnTagSetOfTy(st) {
      // Two generic functions a type parameter shares bind it to their union, tagged or not, so
      // the instance's facts are the union's.
      fnTagJoinFromNote(js, fnTagSetOfTy(st))
      fnTagCallJoinNote(ix, i, js)
      const tn = nodeAt(pn.parType)
      let j = 0
      while tn is TypeRef && j < names.length && j < out.length {
        if names[j] == tn.tyName {
          if !copied {
            out = tys.slice(0, tys.length)
            copied = true
          }
          out[j] = fnTagSetTy(js)
        }
        j = j + 1
      }
    } else if (
      !named
      && pn is Param
      && (pn.parType < 0 || alone)
      && fnTagTyIsTagged(st)
    ) {
      const tn = if alone { nodeAt(pn.parType) } else { nodeAt(f.fnParams[i]) }
      const hn = if tn is TypeRef { tn.tyName } else { elabHoleRootName(nodeTyIxOf(f.fnParams[i])) }
      let j = 0
      while j < names.length && j < out.length {
        if hn != "" && names[j] == hn {
          if !copied {
            out = tys.slice(0, tys.length)
            copied = true
          }
          out[j] = st
        }
        j = j + 1
      }
    } else if (
      !named
      && pn is Param
      && (i == elabHandBackIx(d, f)
        || pn.parType < 0 && i == elabHoleHandBackIx(d, f, 0))
    ) {
      // A function handed back to a closed function-typed destination is bound at that type:
      // the call's value is delivered there, and the open binding names no instance. A hole
      // parameter takes, failing that, the one type every call through the value takes (D5530).
      const cx = elabClosedFnCtx(ix)
      const ct = if cx >= 0 || pn.parType >= 0 { cx } else { elabResultCallTy(ix) }
      const hn = elabParamTyVarName(f, i)
      let j = 0
      while ct >= 0 && j < names.length && j < out.length {
        if (hn != "" && names[j] == hn && (tys[j] < 0 || tyHasTyVar(tys[j]))) {
          if !copied {
            out = tys.slice(0, tys.length)
            copied = true
          }
          out[j] = ct
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  out
}

// The closed function type of the one instance of the hole lambda read `ax` names, or -1 when it
// names none, or that lambda has no instance or more than one (D14885).
function elabSoleInstFnTy(ax: i32): i32 {
  if ax < 0 || ax >= P.nodes.length || !(nodeAt(ax) is Ident) { return -1 }
  let d = identDeclOf(ax)
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if dn is LetDecl {
    if dn.letKw != "const" || dn.letInit < 0 { return -1 }
    d = parenPeelIx(dn.letInit)
  }
  if d < 0 || d >= P.nodes.length { return -1 }
  const f = nodeAt(d)
  if !(f is FuncDecl) || f.fnTyParams.length > 0 { return -1 }
  let hole = false
  for p in f.fnParams {
    const q = nodeAt(p)
    if q is Param && q.parType < 0 { hole = true }
  }
  if !hole { return -1 }
  let k1 = -1
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == d {
      if k1 >= 0 { return -1 }
      k1 = k
    }
    k = k + 1
  }
  if k1 < 0 { return -1 }
  const t = elabSubstClosed(nodeTyIxOf(d), k1)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyFunc) { return -1 }
  t
}

// The closed function type call `ix`'s value is delivered at, else -1.
function elabClosedFnCtx(ix: i32): i32 {
  const t = nodeCtxTyIxOf(ix)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyFunc) || !elabTyClosed(t, 0) {
    return -1
  }
  t
}

// The closed function type every call through call `ix`'s value takes: the call `ix` is the
// callee of, or each call through the un-annotated `const` it initialises when that binding is
// read only as a callee (D5530); -1 when there is none, one is open, or two differ.
function elabResultCallTy(ix: i32): i32 {
  // A call minted after the index's build has no row there.
  if ix < 0 || ix >= cwIxCoveredLen() { return -1 }
  const up = cwIxUp[ix]
  const k = cwIxUpKind[ix]
  let calls: i32[] = []
  if k == CW_UP_CALLEE {
    calls.push(up)
  } else if k == CW_UP_LETINIT && up >= 0 && up < P.nodes.length {
    const ln = nodeAt(up)
    if !(ln is LetDecl) || ln.letKw != "const" || ln.letType >= 0 { return -1 }
    calls = elabSlotHolderCalls(up)
  }
  let t = -1
  for c in calls {
    const ct = elabCallSiteFnTy(c)
    if ct < 0 || t >= 0 && !tySame(t, ct) { return -1 }
    t = ct
  }
  t
}

// The function type call `c` is made at: its positional arguments' types and its own, when each
// is closed; -1 otherwise.
function elabCallSiteFnTy(c: i32): i32 {
  if c < 0 || c >= P.nodes.length { return -1 }
  const cn = nodeAt(c)
  if !(cn is Call) { return -1 }
  const ps: i32[] = []
  let i = 0
  while i < cn.callArgs.length {
    if i < cn.callArgNames.length && cn.callArgNames[i] != "" { return -1 }
    const ax = parenPeelIx(cn.callArgs[i])
    if ax < 0 || nodeAt(ax) is Spread { return -1 }
    ps.push(widenLitTy(nodeTyIxOf(ax)))
    i = i + 1
  }
  const ft = mkFuncTy(ps, nodeTyIxOf(c))
  if ft < 0 || !elabTyClosed(ft, 0) { return -1 }
  ft
}

// The type variable parameter `i` of `f` is typed by: its own type parameter, or its hole's.
function elabParamTyVarName(f: FuncDecl, i: i32): string {
  const pn = nodeAt(f.fnParams[i])
  if !(pn is Param) { return "" }
  if pn.parType >= 0 {
    const tn = nodeAt(pn.parType)
    if tn is TypeRef && strListHas(f.fnTyParams, tn.tyName) { return tn.tyName }
    return ""
  }
  elabHoleRootName(nodeTyIxOf(f.fnParams[i]))
}

// Checks each instance from key `k0` on, and those the hole-pin rows record enqueue: the rows
// check banked before any instance, and those each body records.
function elabSettle(k0: i32) {
  let k = k0
  elabDrainHoleRows()
  while k < ekDecl.length {
    elabDrainHoleRows()
    if !ekDone[k] { elabOne(k) }
    elabDrainHoleRows()
    k = k + 1
  }
  0
}

// The type instance `k` recorded for node `ix` (or for the node it copies), -1 when
// none, -2 when the emitter has retyped the node since.
function elabTyIn(ix: i32, k: i32): i32 {
  let src = ix
  let ps = elabNodeTys[ix] ?? []
  if ps.length == 0 {
    src = nodeSrc[ix] ?? -1
    ps = elabNodeTys[src] ?? []
  }
  if (
    ps.length > 0
    && (src < 0 || src >= elabGenTy.length || elabGenTy[src] != elabCheckedTyOf(ix))
  ) {
    return -2
  }
  let i = 0
  while i + 1 < ps.length {
    if ps[i] == k { return ps[i + 1] }
    i = i + 2
  }
  -1
}

// Node `ix`'s checker type; a minted copy the emitter never typed has its source's.
export function elabCheckedTyOf(ix: i32): i32 {
  const own = nodeTyIxOf(ix)
  if own >= 0 { own } else { nodeTyIxOf(nodeSrc[ix] ?? -1) }
}

// The closed function types slot `path` (steps `e`, `v`, `f.<name>`) of binding or literal `d` is
// delivered at in instance `k` and the instances it reaches (every instance at -1): each read's
// recorded destination (`recordCtxTy`), each call through a read, and the slot's own closed type.
// A literal answers for the bindings holding it.
export function elabSlotDeliveries(d0: i32, path: string[], k: i32): i32[] {
  // A literal or name an instance minted after the write index has no index facts to read; a
  // binding answers through its source (`declOrigOf`).
  const d = elabCellLitBinding(d0)
  // A program whose check never asked for the write index builds it here.
  cwIxBuild()
  const late = d >= cwIxCoveredLen()
  if (
    d < 0
    || (late && !elabIsBinding(nodeAt(d)) && (lvExitLoops[d] ?? -1) < 0)
  ) {
    const none: i32[] = []
    return none
  }
  // A loop's value carrier holds what the loop's value is delivered at.
  const lv = if late { lvCarrierLoopOf(d) } else { -1 }
  if lv >= 0 && lv < cwIxCoveredLen() {
    const lout: i32[] = []
    const lseen: i32[] = []
    const was0 = elabDlvKey
    const wasAdmit0 = elabDlvAdmit
    elabDlvKey = k
    elabDlvAdmit = elabReachClosure(k)
    elabSlotClimb(lv, path, lout, lseen)
    elabDlvKey = was0
    elabDlvAdmit = wasAdmit0
    return lout
  }
  // An outermost plain query is answered once per arena epoch.
  const memo = elabDlvDepth == 0
    && elabDlvOmit.length == 0
    && !elabCallSinkOn
    && !elabCallRec
  let mk = ""
  if memo {
    if elabDlvMemoEpoch != arenaEpochNow() {
      elabDlvMemo = Map()
      elabDlvMemoEpoch = arenaEpochNow()
    }
    mk = i32ToStr(d)
      + ":"
      + i32ToStr(k)
      + (if elabDlvAnnOnly { ":a" } else { "" })
    for st in path { mk = mk + ":" + st }
    const hit = elabDlvMemo.get(mk)
    if hit != null {
      const cp: i32[] = []
      for t in hit { cp.push(t) }
      return cp
    }
  }
  const was = elabDlvKey
  const wasAdmit = elabDlvAdmit
  elabDlvKey = k
  elabDlvAdmit = elabReachClosure(k)
  const all = elabSlotDeliveriesAt(d, path)
  elabDlvKey = was
  elabDlvAdmit = wasAdmit
  // A function value is delivered only at its own arity; another is a placeholder's inferred type.
  const own = elabSlotTyOf(nodeTyIxOf(d), path)
  const of = if own >= 0 && own < T.tys.length { tyAt(own) } else { null }
  const out: i32[] = []
  for t in all {
    const ft = tyAt(t)
    if (
      !(of is TyFunc)
      || (ft is TyFunc && ft.fnParamTypes.length == of.fnParamTypes.length)
    ) {
      out.push(t)
    }
  }
  if memo {
    const keep: i32[] = []
    for t in out { keep.push(t) }
    elabDlvMemo[mk] = keep
  }
  out
}

// The closed results of the closed function types written destinations deliver slot `path` of `d`
// at, in instance `k`, each once; a call names no return, and an open result answers nothing.
export function elabSlotAnnRets(d: i32, path: string[], k: i32): i32[] {
  const was = elabDlvAnnOnly
  elabDlvAnnOnly = true
  const ts = elabSlotDeliveries(d, path, k)
  elabDlvAnnOnly = was
  const out: i32[] = []
  for t in ts {
    const ft = tyAt(t)
    // An open result names no representation, so it is no answer.
    const r = if ft is TyFunc { ft.fnRet } else { -1 }
    if r >= 0 && !tyHasTyVar(r) && !tyReachesHole(r, 8) && !i32ListHas(out, r) {
      out.push(r)
    }
  }
  out
}

// Whether `elabSlotDeliveries` counts only the types written destinations deliver.
let elabDlvAnnOnly = false

// `elabSlotDeliveries`' answers by query, and the arena epoch that keeps them valid.
let elabDlvMemo: {[string]: i32[]} = Map()
let elabDlvMemoEpoch = -1

// A cell literal the capture rewrite minted, or an instance's copy of one, answers as the binding
// it seeds; any other node as itself.
function elabCellLitBinding(d: i32): i32 {
  cboxCellLits[d] ?? (cboxCellLits[nodeSrc[d] ?? -1] ?? d)
}

function elabIsBinding(n: Node): boolean {
  n is LetDecl || n is Param || n is FuncDecl
}

// Instance `k` and every instance its body reaches, transitively.
function elabReachClosure(k: i32): {[i32]: boolean} {
  const got: {[i32]: boolean} = Map()
  if k < 0 { return got }
  const todo: i32[] = [k]
  got[k] = true
  let i = 0
  while i < todo.length {
    const x = todo[i]
    const rs = if x < ekReach.length { ekReach[x] } else { [] }
    for r in rs {
      if !got.has(r) {
        got[r] = true
        todo.push(r)
      }
    }
    i = i + 1
  }
  got
}

// `elabSlotDeliveries` leaving out what calls `omit` deliver: their arguments' and result's types
// and the stamp of the read each calls through.
export function elabSlotDeliveriesOmitting(
  d: i32,
  path: string[],
  k: i32,
  omit: i32[],
): i32[] {
  const was = elabDlvOmit
  elabDlvOmit = omit
  const out = elabSlotDeliveries(d, path, k)
  elabDlvOmit = was
  out
}

let elabDlvOmit: i32[] = []

// Whether the instances of the function declaring `d` deliver slot `path` at different closed
// function types, so its delivery is asked per instance.
export function elabSlotPerInstance(d1: i32, p0: string[]): boolean {
  let d0 = elabCellLitBinding(d1)
  // A capture temp holds its cell's element.
  let path = p0
  const wc = cboxWriteCells[d0] ?? (cboxWriteCells[declOrigOf(d0)] ?? -1)
  if wc >= 0 {
    const full: string[] = ["e"]
    for st in p0 { full.push(st) }
    d0 = wc
    path = full
  }
  // A node an instance minted after the write index is asked as its source.
  const late = cwIxCoveredLen() > 0 && d0 >= cwIxCoveredLen()
  const d = if late && declOrigOf(d0) >= 0 { declOrigOf(d0) } else { d0 }
  if d < 0 || (cwIxCoveredLen() > 0 && d >= cwIxCoveredLen()) { return false }
  // A slot in a closure the instances share differs with the instances of the function around it.
  // A `let` the index files no parent for is found by the function its check ran in.
  let fd = if recEnclosingFn(d) >= 0 { recEnclosingFn(d) } else { elabInstancedFnHolding(d) }
  let hops = 0
  while fd >= 0 && (ekByDecl[fd] ?? []).length < 2 && hops < 16 {
    fd = recEnclosingFn(fd)
    hops = hops + 1
  }
  const ks = if fd >= 0 { ekByDecl[fd] ?? [] } else { [] }
  if ks.length < 2 { return false }
  const first = elabSlotDeliveries(d, path, ks[0])
  let i = 1
  while i < ks.length {
    const other = elabSlotDeliveries(d, path, ks[i])
    if !elabSameTys(first, other) { return true }
    i = i + 1
  }
  false
}

// The innermost function with two or more instance keys whose body holds `d`, or -1: what a
// declaration the index files no parent for (a generic template's own) is found by.
function elabInstancedFnHolding(d: i32): i32 {
  const memo = elabFnHoldingMemo[d] ?? -2
  if memo != -2 { return memo }
  let best = -1
  for f in ekByDecl.keys() {
    if (ekByDecl[f] ?? []).length >= 2 && f != d && nodeContains(f, d) {
      if best < 0 || nodeContains(best, f) { best = f }
    }
  }
  elabFnHoldingMemo[d] = best
  best
}
let elabFnHoldingMemo: {[i32]: i32} = Map()

// Whether `a` and `b` hold the same types, in any order.
function elabSameTys(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  for t in a {
    if !i32ListHas(b, t) { return false }
  }
  true
}

// The instance key `elabSlotDeliveries` answers for, -1 for every instance, and the instances its
// body reaches.
let elabDlvKey = -1
let elabDlvAdmit: {[i32]: boolean} = Map()

// Whether instance key `kk` is one the asked instance reaches, or nested in one.
function elabDlvKeyOk(kk: i32): boolean {
  if elabDlvKey < 0 { return true }
  let x = kk
  let hops = 0
  while x >= 0 && x < ekParent.length && hops < 32 {
    if elabDlvAdmit.has(x) { return true }
    x = ekParent[x]
    hops = hops + 1
  }
  false
}

// Narrows the instance filter to the instances call `c` ran from an admitted caller (from any
// caller when every instance is admitted), and what they reach; unchanged where it ran none.
function elabDlvEnterCall(c: i32) {
  const row = elabCallKeys[c] ?? []
  const admit: {[i32]: boolean} = Map()
  let first = -1
  let i = 0
  while i + 1 < row.length {
    const from = row[i]
    const to = row[i + 1]
    if to >= 0 && (elabDlvKey < 0 || (from >= 0 && elabDlvKeyOk(from))) {
      for kk in elabReachClosure(to).keys() { admit[kk] = true }
      if first < 0 { first = to }
    }
    i = i + 2
  }
  if first < 0 { return 0 }
  elabDlvKey = first
  elabDlvAdmit = admit
  0
}

// `elabSlotDeliveries` under the instance filter.
function elabSlotDeliveriesAt(d: i32, path: string[]): i32[] {
  const out: i32[] = []
  if d < 0 || d >= P.nodes.length || elabDlvDepth > 8 { return out }
  elabDlvDepth = elabDlvDepth + 1
  elabSlotDeliveriesInto(d, path, out)
  elabDlvDepth = elabDlvDepth - 1
  out
}

// How deep `elabSlotDeliveries` has followed values into the bindings handing them on.
let elabDlvDepth = 0

// `elabSlotDeliveries` into `out`.
function elabSlotDeliveriesInto(d: i32, path: string[], out: i32[]) {
  // A parameter holds what each call hands it, so its slot is delivered where the argument's is.
  const pd = nodeAt(d)
  if pd is Param {
    const fd = recEnclosingFn(d)
    const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
    const pi = if fn is FuncDecl { i32ListIndexOf(fn.fnParams, d) } else { -1 }
    if pi >= 0 {
      const calls: i32[] = []
      cwFnCalls(fd, calls)
      for c in calls {
        const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
        const a = if cn is Call && pi < cn.callArgs.length { parenPeelIx(cn.callArgs[pi]) } else { -1 }
        if (
          a >= 0
          && a < P.nodes.length
          && nodeAt(a) is Ident
          && identDeclOf(a) >= 0
        ) {
          // The argument is the caller's, read in no instance of this function.
          for t in elabSlotDeliveries(identDeclOf(a), path, -1) {
            elabRetsAdd(out, t)
          }
        }
      }
    }
  }
  // A list or record literal is delivered where the bindings holding it are.
  const dn = nodeAt(d)
  if dn is ArrayLit || dn is ObjLit {
    const rf0 = elabLitReturnedBy(d)
    // The literal's own type is a delivery unless only un-annotated functions fill the slot: their
    // type there is inferred, not delivered.
    const lt = elabSlotTyOf(nodeTyIxOf(d), path)
    if (
      lt >= 0
      && tyAt(lt) is TyFunc
      && elabLitSlotDepth == 0
      && !elabDlvAnnOnly
      && !elabLitSlotAllHole(d, path, 0)
    ) {
      elabRetsAdd(out, lt)
    }
    for h in elabLitHolders(d) {
      for t in elabSlotDeliveriesAt(h, path) { elabRetsAdd(out, t) }
    }
    // A literal read in place is delivered where that read is.
    if path.length > 0 && elabLitSlotDepth < 4 {
      const lseen: i32[] = []
      elabSlotClimb(d, path, out, lseen)
    }
    // A returned literal is also read where each call of its function is.
    if rf0 >= 0 {
      const rseen: i32[] = []
      elabRetSlotOn(rf0, path, out, rseen)
    }
    // An element or field of an outer literal is delivered where that literal's slot is.
    cwIxWant()
    if (
      cwIxCovers(d)
      && (cwIxUpKind[d] == CW_UP_ELEM || cwIxUpKind[d] == CW_UP_FIELD)
    ) {
      const up = cwIxUp[d]
      const fi = if cwIxUpKind[d] == CW_UP_FIELD { nodeAt(cwIxUpAux[d]) } else { null }
      const step = if fi is FieldInit { "f." + fi.fiName } else { "e" }
      const outer: string[] = [step]
      for k in path { outer.push(k) }
      if up >= 0 && up < P.nodes.length && outer.length < 12 {
        for t in elabSlotDeliveriesAt(up, outer) { elabRetsAdd(out, t) }
      }
    }
    return 0
  }
  const seen: i32[] = []
  // A function named by value is delivered where that occurrence's value flows on.
  if dn is Ident {
    cwIxWant()
    // A name minted after the index has no read to climb; only a replaced loop's carrier seeds one.
    const r = if d < cwIxCoveredLen() { elabSlotReadUp(d, path) } else { -1 }
    const fd = identFnDeclOf(d)
    const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
    elabGenericByValue = fn is FuncDecl && fn.fnTyParams.length > 0
    elabGenericRead = r
    if r >= 0 { elabReadOn(r, out, seen) }
    // A value a replaced loop hands out is delivered where that loop's value flows.
    const lx = lvExitLoops[d] ?? -1
    if lx >= 0 && lx < P.nodes.length { elabSlotClimb(lx, path, out, seen) }
    elabGenericByValue = false
    elabGenericRead = -1
    if d >= cwIxCoveredLen() { return 0 }
  }
  // A temp the capture rewrite minted for a closure's tail write holds the cell's element; an
  // instance's copy of the temp, its source's cell.
  const wc = cboxWriteCells[d] ?? (cboxWriteCells[declOrigOf(d)] ?? -1)
  if wc >= 0 && wc < P.nodes.length && elabLitSlotDepth < 4 {
    const full: string[] = ["e"]
    for st in path { full.push(st) }
    elabLitSlotDepth = elabLitSlotDepth + 1
    for t in elabSlotDeliveriesAt(wc, full) { elabRetsAdd(out, t) }
    elabLitSlotDepth = elabLitSlotDepth - 1
  }
  const o = if declOrigOf(d) >= 0 { declOrigOf(d) } else { d }
  elabSlotReadDeliveries(o, path, out, seen)
  // A shared cell the capture rewrite made holds the binding's value at its one element.
  if (
    path.length > 0
    && path[0] == "e"
    && (cboxCellDecls[cboxDeclKey(d)] ?? 0) == 1
  ) {
    const rest: string[] = []
    let j = 1
    while j < path.length {
      rest.push(path[j])
      j = j + 1
    }
    elabSlotReadDeliveries(o, rest, out, seen)
  }
  const cp: string[] = []
  for st in path {
    if st == "e" || st == "v" {
      cp.push("[]")
    } else if st.length > 2 && st.slice(0, 2) == "f." {
      cp.push(st.slice(2, st.length))
    } else {
      return 0
    }
  }
  for c in elabCallsReading(o, cp) { elabCallDeliveryAdd(c, out) }
  // Reached through an edge, only a written type is a delivery; an inferred one is the value's own.
  const own = elabSlotTyOf(nodeTyIxOf(o), path)
  if (
    own >= 0
    && tyAt(own) is TyFunc
    && ((elabLitSlotDepth == 0 && !elabDlvAnnOnly) || elabDeclAnnotated(o))
  ) {
    elabRetsAdd(out, own)
  }
  0
}

// Adds to `out` the closed function types each read of slot `path` of binding `b` is delivered at
// (its context type, checked and in each instance), following the value into the bindings an
// un-annotated `let`, an assignment or a call's argument gives it; `seen` holds the bindings walked.
function elabSlotReadDeliveries(
  b: i32,
  path: string[],
  out: i32[],
  seen: i32[],
) {
  const key = b * 8 + path.length
  if (
    b < 0
    || b >= P.nodes.length
    || path.length >= 8
    || i32ListHas(seen, key)
    || seen.length > 32
  ) {
    return 0
  }
  seen.push(key)
  cwIxWant()
  const ow = cwOccWalk(b)
  while cwOccNext(ow) {
    const u = cwIxNode[ow.row]
    if (
      cwIxKind[ow.row] == CW_OCC_USE
      && u >= 0
      && u < P.nodes.length
      && (identDeclOf(u) == b || srcDeclOf(u) == b)
    ) {
      elabSlotClimb(u, path, out, seen)
    } else if path.length > 0 && cwIxKind[ow.row] == CW_OCC_ASG {
      // A binding re-pointed at another binding's value shares that value's slots.
      const ax = if u >= 0 && u < P.nodes.length && nodeAt(u) is BinExpr { u } else if u >= 0 && u < cwIxUp.length && cwIxCovers(u) && cwIxUpKind[u] == CW_UP_ASG_LHS { cwIxUp[u] } else { -1 }
      const an = if ax >= 0 && ax < P.nodes.length { nodeAt(ax) } else { null }
      if (
        an is BinExpr
        && an.binOp == "="
        && parenPeelIx(an.binLeft) >= 0
        && nodeAt(parenPeelIx(an.binLeft)) is Ident
      ) {
        // Only a whole binding re-pointed at another; a capture cell's `c[0] = v` is the value edge's.
        const rx = parenPeelIx(an.binRight)
        if (
          rx >= 0
          && rx < P.nodes.length
          && nodeAt(rx) is Ident
          && (cboxCellDecls[cboxDeclKey(b)] ?? 0) != 1
        ) {
          elabSlotReadDeliveries(identDeclOf(rx), path, out, seen)
        }
      }
    } else if path.length == 0 && cwIxKind[ow.row] == CW_OCC_CALL {
      // A call by the binding's own name is filed on the call, not as a read of the name.
      const cn = if u >= 0 && u < P.nodes.length { nodeAt(u) } else { null }
      const fx = if cn is Call { parenPeelIx(cn.callFn) } else { -1 }
      if (
        fx >= 0
        && fx < P.nodes.length
        && nodeAt(fx) is Ident
        && (identDeclOf(fx) == b || srcDeclOf(fx) == b)
      ) {
        elabCallDeliveryAdd(u, out)
      }
    }
  }
  // An unwritten alias of another binding, or of one of its slots, shares that slot's slots.
  const bn = nodeAt(b)
  if (
    bn is LetDecl
    && !elabLetTypeWritten(bn.letType)
    && bn.letInit >= 0
    && (bn.letKw == "const" || cwLetUnwritten(b))
  ) {
    const steps: string[] = []
    const root = cwSlotPath(parenPeelIx(bn.letInit), steps)
    if root >= 0 && steps.length + path.length > 0 {
      const full: string[] = []
      for st in steps { full.push(if st == "[]" { "e" } else { "f." + st }) }
      for k in path { full.push(k) }
      elabSlotReadDeliveries(identDeclOf(root), full, out, seen)
    }
    // A literal's slot holding a named binding shares that binding's slots past the step.
    const lit = parenPeelIx(bn.letInit)
    if path.length > 1 && lit >= 0 && lit < P.nodes.length {
      const rest: string[] = []
      let j = 1
      while j < path.length {
        rest.push(path[j])
        j = j + 1
      }
      for v in elabLitSlotValues(lit, path[0]) {
        if v >= 0 && v < P.nodes.length && nodeAt(v) is Ident {
          elabSlotReadDeliveries(identDeclOf(v), rest, out, seen)
        }
      }
    }
  }
  0
}

// The values literal `lit` holds at slot step `step`: each element for `e`, the field's for
// `f.<name>`; empty for any other node.
function elabLitSlotValues(lit: i32, step: string): i32[] {
  const out: i32[] = []
  const n = nodeAt(lit)
  if n is ArrayLit && step == "e" {
    for e in n.arrElems { out.push(parenPeelIx(e)) }
  } else if n is ObjLit && step.length > 2 && step.slice(0, 2) == "f." {
    for fx in n.objFields {
      const fi = nodeAt(fx)
      if fi is FieldInit && "f." + fi.fiName == step {
        out.push(parenPeelIx(fi.fiValue))
      }
    }
  }
  out
}

// The node reading slot `path` (steps `e`, `v`, `f.<name>`) of the value `u` reads, climbing its
// index and member parents; -1 where a step does not match.
function elabSlotReadUp(u: i32, path: string[]): i32 {
  let cur = u
  for k in path {
    const p = elabPlaceUp(cur)
    if p < 0 || p >= P.nodes.length { return -1 }
    const pn = nodeAt(p)
    if (k == "e" || k == "v") && pn is Index && parenPeelIx(pn.idxArr) == cur {
      cur = p
    } else if (
      (k == "e" || k == "v")
      && pn is Member
      && parenPeelIx(pn.memObj) == cur
      && elabElemMethod(pn.memProp)
    ) {
      // A method handing back an element reads the slot at its call.
      const c = elabPlaceUp(p)
      const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
      if !(cn is Call) || cn.callFn != p { return -1 }
      cur = c
    } else if (
      pn is Member
      && parenPeelIx(pn.memObj) == cur
      && k == "f." + pn.memProp
    ) {
      cur = p
    } else if (
      cur >= 0
      && cur < cwIxUpKind.length
      && cwIxUpKind[cur] == CW_UP_OBJ
      && elabStepIs(placeStepOf(p), k)
    ) {
      // A place a rewrite replaced still reads the step the source program read there.
      cur = p
    } else {
      return -1
    }
  }
  cur
}

// Whether source step `src` (`e`, or `f.<name>`) reads path step `k`. A replaced `length` read
// stays declined: a record's `length` field is answered by the list-length route (D4125).
function elabStepIs(src: string, k: string): boolean {
  if src == "e" { return k == "e" || k == "v" }
  src != "" && src != "f.length" && src == k
}

// The node `x` is projected out of or called by, from the index's consumer edge, else its parent
// in the index; -1 for neither.
function elabPlaceUp(x: i32): i32 {
  if x < 0 || x >= cwIxUp.length || !cwIxCovers(x) { return -1 }
  const k = cwIxUpKind[x]
  if k == CW_UP_OBJ || k == CW_UP_CALLEE { return cwIxUp[x] }
  if x < cwIxParent.length { cwIxParent[x] } else { -1 }
}

// Adds to `out` where slot `path` of the value `u` reads is delivered: climbs the steps its index,
// member and element-method parents read, then follows the value the climb stops at with the steps
// left.
function elabSlotClimb(u: i32, path: string[], out: i32[], seen: i32[]) {
  // Each value and path is climbed once per query: the alias edges reach one from several sides.
  // A name's occurrence is climbed once already, by its binding's walk.
  if u < 0 || u >= P.nodes.length || path.length >= 8 { return 0 }
  if !(nodeAt(u) is Ident) {
    const key = elabClimbKey - u * 8 - path.length
    if i32ListHas(seen, key) { return 0 }
    seen.push(key)
  }
  // A value a replaced loop hands out is that loop's value.
  const lx = lvExitLoops[u] ?? -1
  if lx >= 0 && lx < P.nodes.length {
    return elabSlotClimb(lx, path, out, seen)
  }
  let cur = u
  let i = 0
  let guard = 0
  while i < path.length && guard < 16 {
    guard = guard + 1
    // A guarded read the check minted for a `?.` read stands where that read stands.
    cur = optReadPartOf[cur] ?? cur
    const k = path[i]
    const p = elabPlaceUp(cur)
    const pn = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
    const c = elabPlaceUp(p)
    const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
    const called = cn is Call && cn.callFn == p
    if (k == "e" || k == "v") && pn is Index && parenPeelIx(pn.idxArr) == cur {
      cur = p
      i = i + 1
    } else if (
      pn is Member
      && parenPeelIx(pn.memObj) == cur
      && k == "f." + pn.memProp
    ) {
      cur = p
      i = i + 1
    } else if (
      pn is OptMember
      && parenPeelIx(pn.omObj) == cur
      && k == "f." + pn.omProp
    ) {
      cur = p
      i = i + 1
    } else if (
      (k == "e" || k == "v")
      && pn is Member
      && parenPeelIx(pn.memObj) == cur
      && called
      && elabElemMethod(pn.memProp)
    ) {
      cur = c
      i = i + 1
    } else if (
      k == "e"
      && pn is Member
      && parenPeelIx(pn.memObj) == cur
      && cn is Call
      && called
      && elabCallbackParamAt(pn.memProp) >= 0
    ) {
      // A callback method hands each element to its function argument's parameter; `filter`'s
      // result then holds the same elements.
      const fa = if cn.callArgs.length > 0 { cwFnValueDeclOf(cn.callArgs[0]) } else { -1 }
      const fn = if fa >= 0 && fa < P.nodes.length { nodeAt(fa) } else { null }
      const pi = elabCallbackParamAt(pn.memProp)
      if fn is FuncDecl && pi < fn.fnParams.length {
        const rest: string[] = []
        let j = i + 1
        while j < path.length {
          rest.push(path[j])
          j = j + 1
        }
        elabSlotReadDeliveries(fn.fnParams[pi], rest, out, seen)
      }
      if !elabSameSlotsMethod(pn.memProp) { return 0 }
      cur = c
    } else if (
      k == "e"
      && pn is Member
      && parenPeelIx(pn.memObj) == cur
      && called
      && elabSameSlotsMethod(pn.memProp)
    ) {
      // A copy of the list holds the same elements.
      cur = c
    } else if (
      p >= 0
      && cur >= 0
      && cur < cwIxUpKind.length
      && cwIxUpKind[cur] == CW_UP_OBJ
      && elabStepIs(placeStepOf(p), k)
    ) {
      // A place a rewrite replaced still reads the step the source program read there, and the
      // read it replaced keeps its checked stamps.
      const rest0: string[] = []
      let j0 = i
      while j0 < path.length {
        rest0.push(path[j0])
        j0 = j0 + 1
      }
      elabReadStampsAt(cur, rest0, out)
      cur = p
      i = i + 1
    } else {
      const rest: string[] = []
      while i < path.length {
        rest.push(path[i])
        i = i + 1
      }
      elabSlotAliasOn(cur, rest, out, seen)
      elabReadStampsAt(cur, rest, out)
      return 0
    }
  }
  if i == path.length {
    elabReadDeliveries(optReadPartOf[cur] ?? cur, out, seen)
  }
  0
}

// Adds to `out` the closed function types at slot `rest` of each type the check stamped read `r` as
// delivered at, where that destination's type is written.
function elabReadStampsAt(r: i32, rest: string[], out: i32[]) {
  if !elabWrittenDest(r) { return 0 }
  const ts: i32[] = [nodeCtxTyIxOf(r)]
  const cs = elabNodeCtxs[r] ?? []
  let i = 0
  while i + 1 < cs.length {
    if elabDlvKeyOk(cs[i]) { ts.push(cs[i + 1]) }
    i = i + 2
  }
  for t in ts {
    const st = if t >= 0 && t < T.tys.length { elabSlotTyOf(t, rest) } else { -1 }
    if st >= 0 && st < T.tys.length && tyAt(st) is TyFunc {
      elabRetsAdd(out, st)
    }
  }
  0
}

// The parameter of list method `m`'s function argument that receives each element, or -1.
function elabCallbackParamAt(m: string): i32 {
  if (
    m == "map"
    || m == "filter"
    || m == "forEach"
    || m == "find"
    || m == "findIndex"
    || m == "some"
    || m == "every"
  ) {
    return 0
  }
  if m == "reduce" { return 1 }
  -1
}

// Whether list method `m` hands back a list of the receiver's own elements.
function elabSameSlotsMethod(m: string): boolean {
  m == "slice" || m == "filter" || m == "reverse" || m == "concat"
}

// Keys the climb's `seen` entries apart from the bindings' (`b * 8 + n`) and returns' (`-2 - ...`).
const elabClimbKey = 0 - 1073741824

// Whether list or map method `m` hands back one of the receiver's elements.
function elabElemMethod(m: string): boolean {
  m == "pop" || m == "get" || m == "at" || m == "find"
}

// Adds to `out` the closed function types read `r` is delivered at, and follows its value on.
function elabReadDeliveries(r: i32, out: i32[], seen: i32[]) {
  // A value given to a binding or returned from a function with no written type is stamped with
  // what that destination infers.
  if (
    (elabGivenTo(r) >= 0 && !elabDeclAnnotated(elabGivenTo(r)))
    || elabRetUnwritten(r)
  ) {
    return elabReadOn(r, out, seen)
  }
  elabReadStamps(r, out)
  elabReadOn(r, out, seen)
}

// Adds to `out` the closed function types the check stamped node `r` as delivered at, checked
// and in each admitted instance; nothing for the callee read of a call left out.
function elabReadStamps(r: i32, out: i32[]) {
  if (
    elabDlvOmit.length > 0
    && cwIxCovers(r)
    && cwIxUpKind[r] == CW_UP_CALLEE
    && i32ListHas(elabDlvOmit, cwIxUp[r])
  ) {
    return 0
  }
  const ct = nodeCtxTyIxOf(r)
  if ct >= 0 && ct < T.tys.length && tyAt(ct) is TyFunc { elabRetsAdd(out, ct) }
  const cs = elabNodeCtxs[r] ?? []
  let i = 0
  while i + 1 < cs.length {
    const t = cs[i + 1]
    if elabDlvKeyOk(cs[i]) && t >= 0 && t < T.tys.length && tyAt(t) is TyFunc {
      elabRetsAdd(out, t)
    }
    i = i + 2
  }
  0
}

// The calls the value of `d` reaches as their callee, recorded while `elabValueOnlyCall` climbs.
let elabCallRec = false
let elabCallsSeen: i32[] = []

// The parameter types of the one closed function type lambda `lam` is delivered at with `n`
// parameters, under the instance key its slot is read in; empty for none or several.
export function elabLamDeliveredParams(lam: i32, n: i32): i32[] {
  const none: i32[] = []
  const k = elabKeyAt(lam)
  let hit: i32[] = none
  let count = 0
  for t in elabSlotDeliveries(lam, [], if k >= 0 { k } else { -1 }) {
    const f = tyAt(t)
    if f is TyFunc && f.fnParamTypes.length == n {
      count = count + 1
      hit = f.fnParamTypes
    }
  }
  if count == 1 { hit } else { none }
}

// The one call the value bound at `d` (a binding, parameter or literal) reaches as its callee,
// following it forward through arguments, aliases, joins, returns and slots; -1 for none, for two,
// and for a value the write index does not cover.
export function elabValueOnlyCall(d: i32): i32 {
  if d < 0 || d >= P.nodes.length { return -1 }
  elabCallRec = true
  elabCallsSeen = []
  const dn = nodeAt(d)
  if dn is LetDecl || dn is Param || dn is ArrayLit || dn is ObjLit {
    elabSlotDeliveries(d, [], -1)
  } else if d < cwIxCoveredLen() {
    const out: i32[] = []
    const seen: i32[] = []
    elabSlotClimb(d, [], out, seen)
  }
  elabCallRec = false
  if elabCallsSeen.length == 1 { elabCallsSeen[0] } else { -1 }
}

// Adds to `out` what the value read at `r` is delivered at where it flows on, leaving out `r`'s own
// stamps.
function elabReadOn(r: i32, out: i32[], seen: i32[]) {
  if !cwIxCovers(r) { return 0 }
  const k = cwIxUpKind[r]
  const up = cwIxUp[r]
  if k == CW_UP_CALLEE && up >= 0 {
    if elabCallRec && !i32ListHas(elabCallsSeen, up) { elabCallsSeen.push(up) }
    if elabNoCallParam < 0 || identDeclOf(r) != elabNoCallParam {
      elabCallDeliveryAdd(up, out)
    }
  } else if k == CW_UP_LETINIT && up >= 0 && up < P.nodes.length {
    const ln = nodeAt(up)
    // A written type stops the delivery, not the value: a call search follows it on.
    if ln is LetDecl && (!elabLetTypeWritten(ln.letType) || elabCallRec) {
      elabSlotReadDeliveries(up, [], out, seen)
    }
  } else if k == CW_UP_ASG_RHS && up >= 0 && up < P.nodes.length {
    const an = nodeAt(up)
    const l = if an is BinExpr { parenPeelIx(an.binLeft) } else { -1 }
    const ln = if l >= 0 && l < P.nodes.length { nodeAt(l) } else { null }
    if ln is Ident {
      elabSlotReadDeliveries(identDeclOf(l), [], out, seen)
    } else if ln is Index {
      // A write into a shared cell `c[0] = v` the capture rewrite made gives the cell's binding.
      const a = parenPeelIx(ln.idxArr)
      const cd = if a >= 0 && a < P.nodes.length && nodeAt(a) is Ident { identDeclOf(a) } else { -1 }
      if cd >= 0 && (cboxCellDecls[cboxDeclKey(cd)] ?? 0) == 1 {
        elabSlotReadDeliveries(cd, ["e"], out, seen)
      }
    } else if ln is Member && elabCallRec {
      // A call search follows a value written into a named binding's field to that field's reads.
      const o = parenPeelIx(ln.memObj)
      const od = if o >= 0 && o < P.nodes.length && nodeAt(o) is Ident { identDeclOf(o) } else { -1 }
      if od >= 0 { elabSlotReadDeliveries(od, ["f." + ln.memProp], out, seen) }
    }
  } else if (
    (k == CW_UP_COAL || k == CW_UP_ARM)
    && up >= 0
    && up < P.nodes.length
  ) {
    elabReadDeliveries(up, out, seen)
  } else if k == CW_UP_ELEM && up >= 0 {
    elabLitSlotDeliveries(up, "e", out)
  } else if k == CW_UP_FIELD && up >= 0 {
    const fi = nodeAt(cwIxUpAux[r])
    if fi is FieldInit { elabLitSlotDeliveries(up, "f." + fi.fiName, out) }
  } else if (k == CW_UP_RET || k == CW_UP_TAIL) && up >= 0 {
    // A returned value is delivered where each call of the returning function is.
    const f = if k == CW_UP_RET { cwFrameOfDecl(up) } else { up }
    if elabRetSinkOn && !i32ListHas(elabRetSink, f) { elabRetSink.push(f) }
    if f >= 0 && f < P.nodes.length && !i32ListHas(seen, -2 - f) {
      seen.push(-2 - f)
      const calls: i32[] = []
      elabRetCalls(f, calls)
      elabValueCalls(f, calls, 0)
      for c in calls {
        if c >= 0 && c < P.nodes.length && elabCallRanAdmitted(c) {
          elabReadDeliveries(c, out, seen)
        }
      }
      // A `.map` callback's result is an element of the list the call builds.
      const mc = elabMapCallOf(f)
      if mc >= 0 { elabSlotClimb(mc, ["e"], out, seen) }
    }
  } else if (
    k == CW_UP_ARG
    && up >= 0
    && up < P.nodes.length
    && (fvaBuilt[up] ?? false)
    && !elabCallRec
  ) {
    // A function-value adapter around the value carries the delivery's own stamps; a call search
    // still enters the callee.
    elabReadStamps(up, out)
  } else if k == CW_UP_ARG && up >= 0 && up < P.nodes.length {
    const cn = nodeAt(up)
    const ai = cwIxUpAux[r]
    // A call search follows a value pushed onto a named list to that list's element reads.
    const pd = if (elabCallRec || elabCallSinkOn) && cn is Call { elabPushRecvDecl(cn) } else { -1 }
    if pd >= 0 { elabSlotReadDeliveries(pd, ["e"], out, seen) }
    const fds = if cn is Call && cn.callFn >= 0 { elabCalleeFns(cn) } else { [] }
    for fd in fds {
      const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
      if fn is FuncDecl && ai >= 0 && ai < fn.fnParams.length {
        // A declared generic handed to a parameter with no written type is instanced at each call
        // made through that parameter; only where its value flows on out is it delivered.
        const hole = elabGenericByValue
          && r == elabGenericRead
          && !elabDeclAnnotated(fn.fnParams[ai])
        const was = elabNoCallParam
        if hole { elabNoCallParam = fn.fnParams[ai] }
        // The parameter is read in the instances this call ran.
        const wasKey = elabDlvKey
        const wasAdmit = elabDlvAdmit
        elabDlvEnterCall(up)
        elabEntryFns.push(fd)
        elabEntryCalls.push(up)
        // Another instance reads the parameter afresh; what this one saw says nothing of it.
        const narrowed = elabDlvKey != wasKey && elabEntryFns.length < 8
        const inSeen = if narrowed { elabSeenFresh() } else { seen }
        const got: i32[] = []
        elabSlotReadDeliveries(fn.fnParams[ai], [], got, inSeen)
        // An instance minted under the call that its key row does not name still reads it.
        if narrowed && got.length == 0 {
          elabDlvKey = wasKey
          elabDlvAdmit = wasAdmit
          elabSlotReadDeliveries(fn.fnParams[ai], [], got, seen)
        }
        for t in got { elabRetsAdd(out, t) }
        elabEntryFns.pop()
        elabEntryCalls.pop()
        elabDlvKey = wasKey
        elabDlvAdmit = wasAdmit
        elabNoCallParam = was
      }
    }
  }
  0
}

// The binding call `c` pushes onto (`xs.push(v)`, `xs.unshift(v)`, `xs` a named binding that is no
// capture cell); -1 for any other call.
function elabPushRecvDecl(c: Call): i32 {
  const cf = parenPeelIx(c.callFn)
  const fm = if cf >= 0 && cf < P.nodes.length { nodeAt(cf) } else { null }
  if !(fm is Member) || (fm.memProp != "push" && fm.memProp != "unshift") {
    return -1
  }
  const o = parenPeelIx(fm.memObj)
  if o < 0 || o >= P.nodes.length || !(nodeAt(o) is Ident) { return -1 }
  const d = identDeclOf(o)
  if (
    d < 0
    || d >= cwIxCoveredLen()
    || (cboxCellDecls[cboxDeclKey(d)] ?? 0) == 1
  ) {
    return -1
  }
  d
}

// The functions call `c`'s callee can be: the declared function it names, else each function the
// slot it reads can hold (a binding aliasing a function value, a list element, a joined value).
function elabCalleeFns(c: Call): i32[] {
  const cf = parenPeelIx(c.callFn)
  const fd = identFnDeclOf(cf)
  if fd >= 0 { return [fd] }
  const out: i32[] = []
  // A `for` loop's one variable holds each function the list it walks holds.
  const cn = if cf >= 0 && cf < P.nodes.length { nodeAt(cf) } else { null }
  const vd = if cn is Ident { identDeclOf(cf) } else { -1 }
  const lv = if vd >= 0 && vd < cwIxCoveredLen() { nodeAt(vd) } else { null }
  if lv is LoopVar {
    const ln = if lv.lvLoop >= 0 && lv.lvLoop < P.nodes.length { nodeAt(lv.lvLoop) } else { null }
    if ln is ForIn && ln.fiVar2 == "" {
      const it = parenPeelIx(ln.fiIter)
      const itn = if it >= 0 && it < P.nodes.length { nodeAt(it) } else { null }
      if itn is ArrayLit {
        for e in itn.arrElems {
          const f = identFnDeclOf(parenPeelIx(e))
          if f >= 0 && !i32ListHas(out, f) { out.push(f) }
        }
      } else if (
        itn is Ident
        && identDeclOf(it) >= 0
        && identDeclOf(it) < cwIxCoveredLen()
      ) {
        for f in elabSlotHeldFns(identDeclOf(it), ["e"]) {
          if (
            f >= 0
            && f < P.nodes.length
            && nodeAt(f) is FuncDecl
            && !i32ListHas(out, f)
          ) {
            out.push(f)
          }
        }
      }
    }
    return out
  }
  const steps: string[] = []
  const root = cwSlotPath(cf, steps)
  const d0 = if root >= 0 { identDeclOf(root) } else { -1 }
  // A read a rewrite re-resolved past the index answers as the declaration it named there.
  const d = if d0 >= cwIxCoveredLen() && srcDeclOf(root) >= 0 { srcDeclOf(root) } else { d0 }
  // A binding the write index does not cover (one minted after its build) has no frame to read.
  if d < 0 || d >= cwIxCoveredLen() { return out }
  const path: string[] = []
  for st in steps { path.push(if st == "[]" { "e" } else { "f." + st }) }
  for f in elabSlotHeldFns(d, path) {
    if f >= 0 && f < P.nodes.length && nodeAt(f) is FuncDecl { out.push(f) }
  }
  // A bare binding also holds each function written to it, its initialiser included.
  if path.length == 0 {
    for v in cwBindingWrittenValues(cwBindingOf(root)) {
      const f = cwPeelValue(v)
      if (
        f >= 0
        && f < P.nodes.length
        && nodeAt(f) is FuncDecl
        && !i32ListHas(out, f)
      ) {
        out.push(f)
      }
    }
  }
  out
}

let elabLitSlotDepth = 0
function elabSeenFresh(): i32[] {
  const s: i32[] = []
  s
}
// The functions a walk entered through an argument, and the calls it entered them at.
const elabEntryFns: i32[] = []
const elabEntryCalls: i32[] = []

// Pushes onto `calls` the calls a value returned from `f` comes back out of: the one call the walk
// entered `f` at, else every call of `f`.
function elabRetCalls(f: i32, calls: i32[]) {
  let i = elabEntryFns.length - 1
  while i >= 0 {
    if elabEntryFns[i] == f {
      calls.push(elabEntryCalls[i])
      return 0
    }
    i = i - 1
  }
  cwFnCalls(f, calls)
  0
}
let elabGenericByValue = false
let elabGenericRead = -1
// The parameter whose own calls deliver nothing (a declared generic handed to it by value), or -1.
let elabNoCallParam = -1

// The binding read `r` initialises, or the parameter of a declared function it is an argument to;
// -1 for any other position.
function elabGivenTo(r: i32): i32 {
  if r < 0 || r >= cwIxUp.length || !cwIxCovers(r) { return -1 }
  if cwIxUpKind[r] == CW_UP_LETINIT { return cwIxUp[r] }
  // An element or field is typed by its literal, so it is given where the literal is.
  if cwIxUpKind[r] == CW_UP_ELEM || cwIxUpKind[r] == CW_UP_FIELD {
    return if elabLitSlotDepth < 4 { elabGivenTo(cwIxUp[r]) } else { -1 }
  }
  if cwIxUpKind[r] != CW_UP_ARG { return -1 }
  const up = cwIxUp[r]
  const cn = if up >= 0 && up < P.nodes.length { nodeAt(up) } else { null }
  const fd = if cn is Call && cn.callFn >= 0 { identFnDeclOf(parenPeelIx(cn.callFn)) } else { -1 }
  const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  const ai = cwIxUpAux[r]
  if fn is FuncDecl && ai >= 0 && ai < fn.fnParams.length {
    fn.fnParams[ai]
  } else {
    -1
  }
}

// Whether read `r` is returned from a declared function with no written return type.
function elabRetUnwritten(r: i32): boolean {
  if r < 0 || r >= cwIxUp.length || !cwIxCovers(r) { return false }
  const k = cwIxUpKind[r]
  if k != CW_UP_RET && k != CW_UP_TAIL { return false }
  const f = if k == CW_UP_RET { cwFrameOfDecl(cwIxUp[r]) } else { cwIxUp[r] }
  const fn = if f >= 0 && f < P.nodes.length { nodeAt(f) } else { null }
  fn is FuncDecl && fn.fnRet < 0
}

// Whether read `r` is given to a destination whose type is written: an annotated binding or
// declared function's parameter, or the result of a function with a written return type.
function elabWrittenDest(r: i32): boolean {
  if r < 0 || r >= cwIxUp.length || !cwIxCovers(r) { return false }
  const g = elabGivenTo(r)
  if g >= 0 { return elabDeclAnnotated(g) }
  const k = cwIxUpKind[r]
  if k != CW_UP_RET && k != CW_UP_TAIL { return false }
  const f = if k == CW_UP_RET { cwFrameOfDecl(cwIxUp[r]) } else { cwIxUp[r] }
  const fn = if f >= 0 && f < P.nodes.length { nodeAt(f) } else { null }
  fn is FuncDecl && fn.fnRet >= 0
}

// The `.map` call function `f` is the callback argument of, or -1.
function elabMapCallOf(f: i32): i32 {
  if (
    f < 0
    || f >= cwIxUp.length
    || !cwIxCovers(f)
    || cwIxUpKind[f] != CW_UP_ARG
  ) {
    return -1
  }
  const c = cwIxUp[f]
  const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
  const m = if cn is Call && cn.callFn >= 0 { nodeAt(parenPeelIx(cn.callFn)) } else { null }
  if m is Member && m.memProp == "map" { c } else { -1 }
}

// Pushes onto `calls` the calls made through value `x`, a lambda or a call's result, where it
// flows into an unwritten binding called by name, or out of a function each call of which is such
// a value; `depth` bounds the walk.
function elabValueCalls(x: i32, calls: i32[], depth: i32) {
  if depth > 4 || x < 0 || x >= cwIxUp.length || !cwIxCovers(x) { return 0 }
  const k = cwIxUpKind[x]
  const up = cwIxUp[x]
  if up < 0 || up >= P.nodes.length { return 0 }
  const un = nodeAt(up)
  if k == CW_UP_LETINIT && un is LetDecl && !elabLetTypeWritten(un.letType) {
    if un.letKw != "const" && !cwLetUnwritten(up) { return 0 }
    const ow = cwOccWalk(up)
    while cwOccNext(ow) {
      const c = cwIxNode[ow.row]
      const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
      if cwIxKind[ow.row] == CW_OCC_CALL && cn is Call {
        const fx = parenPeelIx(cn.callFn)
        if (
          fx >= 0
          && fx < P.nodes.length
          && nodeAt(fx) is Ident
          && identDeclOf(fx) == up
        ) {
          if !i32ListHas(calls, c) { calls.push(c) }
        }
      }
    }
  } else if k == CW_UP_RET || k == CW_UP_TAIL {
    const f = if k == CW_UP_RET { cwFrameOfDecl(up) } else { up }
    const fc: i32[] = []
    if f >= 0 && f < P.nodes.length { cwFnCalls(f, fc) }
    for c in fc { elabValueCalls(c, calls, depth + 1) }
  } else if (
    (k == CW_UP_ELEM || k == CW_UP_FIELD)
    && cwIxCovers(up)
    && cwIxUpKind[up] == CW_UP_LETINIT
  ) {
    // An element or field of a literal an unwritten binding holds is called through that slot.
    const fi = if k == CW_UP_FIELD { nodeAt(cwIxUpAux[x]) } else { null }
    const step = if fi is FieldInit { "f." + fi.fiName } else { "e" }
    const b = cwIxUp[up]
    const bn = if b >= 0 && b < P.nodes.length { nodeAt(b) } else { null }
    if (
      bn is LetDecl
      && !elabLetTypeWritten(bn.letType)
      && (bn.letKw == "const" || cwLetUnwritten(b))
    ) {
      const ow = cwOccWalk(b)
      while cwOccNext(ow) {
        const u = cwIxNode[ow.row]
        if (
          cwIxKind[ow.row] == CW_OCC_USE
          && u >= 0
          && u < P.nodes.length
          && identDeclOf(u) == b
        ) {
          const r = elabSlotReadUp(u, [step])
          if r >= 0 && cwIxCovers(r) && cwIxUpKind[r] == CW_UP_CALLEE {
            const c = cwIxUp[r]
            if c >= 0 && !i32ListHas(calls, c) { calls.push(c) }
          }
        }
      }
    }
  }
  0
}

// Whether binding `b` is a `let` or parameter with a written type.
function elabDeclAnnotated(b: i32): boolean {
  if b < 0 || b >= P.nodes.length { return false }
  elabLetWritten(nodeAt(b)) || elabParamWritten(nodeAt(b))
}

// Whether a `let`'s type node `t` comes from the source program rather than a later rewrite.
function elabLetTypeWritten(t: i32): boolean { t >= 0 && t < cwIxCoveredLen() }

function elabLetWritten(n: Node): boolean {
  n is LetDecl && elabLetTypeWritten(n.letType)
}

function elabParamWritten(n: Node): boolean { n is Param && n.parType >= 0 }

// Adds to `out` what slot `step` of literal `lit` is delivered at, a bounded number of literals deep.
function elabLitSlotDeliveries(lit: i32, step: string, out: i32[]) {
  if elabLitSlotDepth >= 4 { return 0 }
  elabLitSlotDepth = elabLitSlotDepth + 1
  for t in elabSlotDeliveriesAt(lit, [step]) { elabRetsAdd(out, t) }
  elabLitSlotDepth = elabLitSlotDepth - 1
  0
}

// Follows the whole binding `u` reads into the binding an un-annotated `let`, an assignment or a
// declared function's parameter gives it, at the same slot `path`.
function elabSlotAliasOn(u: i32, path: string[], out: i32[], seen: i32[]) {
  if !cwIxCovers(u) { return 0 }
  const k = cwIxUpKind[u]
  const up = cwIxUp[u]
  if up < 0 || up >= P.nodes.length { return 0 }
  const un = nodeAt(up)
  if k == CW_UP_LETINIT && un is LetDecl && !elabLetTypeWritten(un.letType) {
    elabSlotReadDeliveries(up, path, out, seen)
  } else if k == CW_UP_ASG_RHS && un is BinExpr {
    const l = parenPeelIx(un.binLeft)
    const ln = if l >= 0 && l < P.nodes.length { nodeAt(l) } else { null }
    if ln is Ident {
      elabSlotReadDeliveries(identDeclOf(l), path, out, seen)
    } else if ln is Index || ln is Member {
      // A write into an element or field of a named binding is held at that slot of it.
      const c = if ln is Index { parenPeelIx(ln.idxArr) } else if ln is Member { parenPeelIx(ln.memObj) } else { -1 }
      const ct = if c >= 0 { nodeTyIxOf(c) } else { -1 }
      const step = if ln is Member { "f." + ln.memProp } else if ct >= 0 && ct < T.tys.length && tyAt(nonNullTy(ct)) is TyMap { "v" } else { "e" }
      // A capture cell's element write is the binding's own write, read by the value edge.
      const cd = if c >= 0 && c < P.nodes.length && nodeAt(c) is Ident { identDeclOf(c) } else { -1 }
      if cd >= 0 && (cboxCellDecls[cboxDeclKey(cd)] ?? 0) != 1 {
        const full: string[] = [step]
        for st in path { full.push(st) }
        elabSlotReadDeliveries(cd, full, out, seen)
      }
    }
  } else if k == CW_UP_ARG && un is Call && un.callFn >= 0 {
    const ai = cwIxUpAux[u]
    // A call search follows a value pushed onto a named list to that list's element reads.
    const pd = if elabCallRec || elabCallSinkOn { elabPushRecvDecl(un) } else { -1 }
    if pd >= 0 {
      const full: string[] = ["e"]
      for st in path { full.push(st) }
      elabSlotReadDeliveries(pd, full, out, seen)
    }
    for fd in elabCalleeFns(un) {
      const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
      if fn is FuncDecl && ai >= 0 && ai < fn.fnParams.length {
        // The parameter is read in the instances this call ran.
        const wasKey = elabDlvKey
        const wasAdmit = elabDlvAdmit
        elabDlvEnterCall(up)
        elabEntryFns.push(fd)
        elabEntryCalls.push(up)
        const inSeen = if elabDlvKey != wasKey && elabEntryFns.length < 8 { elabSeenFresh() } else { seen }
        elabSlotReadDeliveries(fn.fnParams[ai], path, out, inSeen)
        elabEntryFns.pop()
        elabEntryCalls.pop()
        elabDlvKey = wasKey
        elabDlvAdmit = wasAdmit
      }
    }
  } else if (k == CW_UP_ELEM || k == CW_UP_FIELD) && elabLitSlotDepth < 4 {
    // A value written as a literal's element or field is held at that slot of the literal.
    const fi = if k == CW_UP_FIELD { nodeAt(cwIxUpAux[u]) } else { null }
    const step = if fi is FieldInit { "f." + fi.fiName } else { "e" }
    const outer: string[] = [step]
    for st in path { outer.push(st) }
    elabLitSlotDepth = elabLitSlotDepth + 1
    for t in elabSlotDeliveriesAt(up, outer) { elabRetsAdd(out, t) }
    elabLitSlotDepth = elabLitSlotDepth - 1
  } else if k == CW_UP_COAL || k == CW_UP_ARM {
    // A `??` operand or a branch's value is the expression's own, slots and all.
    elabSlotClimb(up, path, out, seen)
  } else if k == CW_UP_SPREAD && path.length > 0 && path[0] == "e" {
    // A list spread into a list literal hands its elements to the literal's.
    const lit = if cwIxCovers(up) && cwIxUpKind[up] == CW_UP_ELEM { cwIxUp[up] } else { -1 }
    if lit >= 0 && lit < P.nodes.length && nodeAt(lit) is ArrayLit {
      for t in elabSlotDeliveriesAt(lit, path) { elabRetsAdd(out, t) }
    }
  } else if k == CW_UP_ITER && un is ForIn && path.length > 0 {
    // A loop over a list binds its element, over a map its value.
    const b = if path[0] == "e" { un.fiDecl1 } else if path[0] == "v" { un.fiDecl2 } else { -1 }
    const rest: string[] = []
    let j = 1
    while j < path.length {
      rest.push(path[j])
      j = j + 1
    }
    if b >= 0 { elabLoopVarDeliveries(b, rest, out, seen) }
  } else if k == CW_UP_RET || k == CW_UP_TAIL {
    elabRetSlotOn(
      if k == CW_UP_RET { cwFrameOfDecl(up) } else { up },
      path,
      out,
      seen,
    )
  }
  0
}

// Adds to `out` where slot `path` of loop variable `b` is delivered. Its reads come from the write
// index, since a rewrite of the loop body can name another declaration for them.
function elabLoopVarDeliveries(
  b: i32,
  path: string[],
  out: i32[],
  seen: i32[],
) {
  const key = b * 8 + path.length
  if i32ListHas(seen, key) || seen.length > 32 { return 0 }
  seen.push(key)
  const ow = cwOccWalk(b)
  while cwOccNext(ow) {
    const u = cwIxNode[ow.row]
    if (
      cwIxKind[ow.row] == CW_OCC_USE
      && u >= 0
      && u < P.nodes.length
      && u != b
    ) {
      elabSlotClimb(u, path, out, seen)
    }
  }
  0
}

// Adds to `out` where slot `path` of the value function `f` returns is delivered: read at each call
// of `f`, or handed on from it.
function elabRetSlotOn(f: i32, path: string[], out: i32[], seen: i32[]) {
  const key = 0 - 2 - (f * 8 + path.length)
  if f < 0 || f >= P.nodes.length || i32ListHas(seen, key) || seen.length > 32 {
    return 0
  }
  seen.push(key)
  const calls: i32[] = []
  elabRetCalls(f, calls)
  // A lambda is called through the binding it initialises.
  cwIxWant()
  const lb = if cwIxCovers(f) && cwIxUpKind[f] == CW_UP_LETINIT { cwIxUp[f] } else { -1 }
  const ln = if lb >= 0 && lb < P.nodes.length { nodeAt(lb) } else { null }
  if (
    ln is LetDecl
    && !elabLetTypeWritten(ln.letType)
    && (ln.letKw == "const" || cwLetUnwritten(lb))
  ) {
    cwFnCalls(lb, calls)
  }
  for c in calls {
    if c >= 0 && c < P.nodes.length && elabCallRanAdmitted(c) {
      elabSlotClimb(c, path, out, seen)
    }
  }
  0
}

// Whether call `c` ran an instance the walk admits: every call does under no instance key, and so
// does one with no instance row.
function elabCallRanAdmitted(c: i32): boolean {
  if elabDlvKey < 0 { return true }
  const row = elabCallKeys[c] ?? []
  if row.length == 0 { return true }
  let i = 0
  while i + 1 < row.length {
    if row[i + 1] >= 0 && elabDlvKeyOk(row[i + 1]) { return true }
    i = i + 2
  }
  false
}

// The bindings literal `lit` initialises: the `let` it is the initialiser of, or, when the function
// declaring it returns it, each `let` a call of that function initialises.
function elabLitHolders(lit: i32): i32[] {
  const out: i32[] = []
  cwIxWant()
  if !cwIxCovers(lit) { return out }
  if cwIxUpKind[lit] == CW_UP_LETINIT {
    out.push(cwIxUp[lit])
    return out
  }
  const fd = elabLitReturnedBy(lit)
  if fd < 0 { return out }
  const calls: i32[] = []
  cwFnCalls(fd, calls)
  for c in calls {
    if (
      c >= 0
      && cwIxCovers(c)
      && cwIxUpKind[c] == CW_UP_LETINIT
      && !i32ListHas(out, cwIxUp[c])
    ) {
      out.push(cwIxUp[c])
    }
  }
  out
}

// Whether every value at slot `path` of literal `lit` names an un-annotated or generic function;
// false where the slot holds none or a step leaves the literals.
function elabLitSlotAllHole(lit: i32, path: string[], at: i32): boolean {
  const v = parenPeelIx(lit)
  if v < 0 || v >= P.nodes.length { return false }
  if at >= path.length { return holeFnArgDecl(v) >= 0 || elabGenericByName(v) }
  const n = nodeAt(v)
  const st = path[at]
  const vals: i32[] = []
  if st == "e" && n is ArrayLit {
    for e in n.arrElems { vals.push(e) }
  } else if n is ObjLit && st.length > 2 && st.slice(0, 2) == "f." {
    for f in n.objFields {
      const fi = nodeAt(f)
      if fi is FieldInit && "f." + fi.fiName == st { vals.push(fi.fiValue) }
    }
  }
  if vals.length == 0 { return false }
  for x in vals {
    if !elabLitSlotAllHole(x, path, at + 1) { return false }
  }
  true
}

// Whether `v` names a declared generic function, itself or through `const` aliases.
function elabGenericByName(v: i32): boolean {
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return false }
  const fd = cwFnValueDeclOf(v)
  const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  fn is FuncDecl && fn.fnTyParams.length > 0
}

// The function returning literal `lit` as one of its values, or -1.
function elabLitReturnedBy(lit: i32): i32 {
  const fd = recEnclosingFn(lit)
  const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  if !(fn is FuncDecl) || fn.fnBody < 0 { return -1 }
  const rv: i32[] = []
  collectRetValues(fn.fnBody, rv)
  for v in rv {
    if parenPeelIx(v) == lit { return fd }
  }
  -1
}

// The one call slot `path` of `d` is delivered at, open or closed (the calls `elabSlotDeliveries`
// reaches), with its arguments' checked types pushed onto `tys`; -1 for none or for two.
export function elabSlotOnlyCall(d: i32, path: string[], tys: i32[]): i32 {
  elabCallSink = []
  elabCallSinkOn = true
  elabSlotDeliveries(d, path, -1)
  elabCallSinkOn = false
  const hits = elabCallSink
  elabCallSink = []
  if hits.length != 1 { return -1 }
  const hn = nodeAt(hits[0])
  if !(hn is Call) { return -1 }
  for a in hn.callArgs { tys.push(nodeTyIxOf(a)) }
  hits[0]
}

// The one closed argument tuple every call the value of `d` reaches as its callee is made at,
// leaving out calls inside the functions `skip`, pushed onto `tys`; false for no such call, an open
// argument, or two tuples.
export function elabValueAgreedCallTys(
  d: i32,
  skip: i32[],
  tys: i32[],
): boolean {
  elabCallSink = []
  elabCallSinkOn = true
  elabSlotDeliveries(d, [], -1)
  elabCallSinkOn = false
  const hits = elabCallSink
  elabCallSink = []
  let one: i32[] = []
  let key = ""
  let have = false
  for c in hits {
    const cn = nodeAt(c)
    if cn is Call && !i32ListHas(skip, recEnclosingFn(c)) {
      const tup: i32[] = []
      let k = ""
      for a in cn.callArgs {
        const t = nodeTyIxOf(a)
        if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return false }
        const w = widenLitTy(t)
        tup.push(w)
        k = k + tyToStr(w) + ","
      }
      if have && k != key { return false }
      one = tup
      key = k
      have = true
    }
  }
  for t in one { tys.push(t) }
  have
}

// The one closed argument tuple every value slot `step` (`e`, or `f.<name>`) of list or record
// literal `a` holds reaches as its callee (`elabValueAgreedCallTys`), pushed onto `qs`, with those
// values pushed onto `vals`; false for a spread, a value reaching no call or an open one, or two.
export function elabLitSlotCallTys(
  a: i32,
  step: string,
  qs: i32[],
  vals: i32[],
): boolean {
  const n = if a >= 0 && a < P.nodes.length { nodeAt(a) } else { null }
  if n is ArrayLit && step == "e" {
    for e in n.arrElems { vals.push(e) }
  } else if n is ObjLit {
    for f in n.objFields {
      const fn = nodeAt(f)
      if !(fn is FieldInit) { return false }
      if "f." + fn.fiName == step { vals.push(fn.fiValue) }
    }
  }
  if vals.length == 0 { return false }
  let have = false
  for v in vals {
    if nodeAt(v) is Spread { return false }
    const q: i32[] = []
    if !elabValueAgreedCallTys(v, [], q) { return false }
    if have {
      if q.length != qs.length { return false }
      let i = 0
      while i < q.length {
        if !tySame(q[i], qs[i]) { return false }
        i = i + 1
      }
    } else {
      for t in q { qs.push(t) }
    }
    have = true
  }
  true
}

// Whether the value bound at declaration `d` reaches a return of function `f`, as the forward
// climb follows it through aliases, joins and slots.
export function elabValueReturnsFrom(d: i32, f: i32): boolean {
  elabRetSink = []
  elabRetSinkOn = true
  elabSlotDeliveries(d, [], -1)
  elabRetSinkOn = false
  const hit = i32ListHas(elabRetSink, f)
  elabRetSink = []
  hit
}

// The functions a delivery walk reached a return of, recorded while `elabRetSinkOn`.
let elabRetSink: i32[] = []
let elabRetSinkOn = false

// The calls a delivery walk reached, recorded while `elabCallSinkOn`.
let elabCallSink: i32[] = []
let elabCallSinkOn = false

// The calls in `elabCalls` whose callee reads slot `cp` of binding `o`, itself or through an
// un-annotated `const` aliasing it, in `elabCalls` order.
function elabCallsReading(o: i32, cp: string[]): i32[] {
  if elabReadIxEpoch != arenaEpochNow() || elabReadIxLen != elabCalls.length {
    elabReadIx = Map()
    for c in elabCalls {
      const cn = nodeAt(c)
      if cn is Call && cn.callFn >= 0 {
        for k in elabSlotReadKeys(cn.callFn) {
          const row = elabReadIx[k] ?? []
          if row.length == 0 || row[row.length - 1] != c { row.push(c) }
          elabReadIx[k] = row
        }
      }
    }
    elabReadIxEpoch = arenaEpochNow()
    elabReadIxLen = elabCalls.length
  }
  elabReadIx[elabSlotReadKey(o, cp)] ?? []
}

// Each call by the slot key (`elabSlotReadKey`) its callee reads, for one arena epoch.
let elabReadIx: {[string]: i32[]} = Map()
let elabReadIxEpoch = -1
let elabReadIxLen = -1

function elabSlotReadKey(o: i32, cp: string[]): string {
  let k = i32ToStr(o)
  for st in cp { k = k + "/" + st }
  k
}

// The slot keys callee `x` reads: its own place, and through each un-annotated unwritten `let`
// its root names, that binding's initialiser's.
function elabSlotReadKeys(x: i32): string[] {
  const out: string[] = []
  let at = parenPeelIx(x)
  let hops = 0
  while hops < 8 {
    const p: string[] = []
    const root = cwSlotPath(at, p)
    if root < 0 { return out }
    const rd = identDeclOf(root)
    const ro = if declOrigOf(rd) >= 0 { declOrigOf(rd) } else { rd }
    out.push(elabSlotReadKey(ro, p))
    if p.length > 0 || rd < 0 || rd >= P.nodes.length { return out }
    const rn = nodeAt(rd)
    if (
      !(rn is LetDecl)
      || elabLetTypeWritten(rn.letType)
      || rn.letInit < 0
      || !cwLetUnwritten(rd)
    ) {
      return out
    }
    at = parenPeelIx(rn.letInit)
    hops = hops + 1
  }
  out
}

// Adds to `out` the closed function type call `c` is made at: its arguments' and result's types
// in every instance where they agree, else in each instance that closes them.
function elabCallDeliveryAdd(c: i32, out: i32[]) {
  const cn = nodeAt(c)
  if !(cn is Call) || i32ListHas(elabDlvOmit, c) || elabDlvAnnOnly { return 0 }
  if elabCallSinkOn && !i32ListHas(elabCallSink, c) { elabCallSink.push(c) }
  const agreed = elabCallArgTysAgreed(c)
  const r = elabNodeTyAgreed(c)
  if elabDlvKey < 0 && agreed.length == cn.callArgs.length && r >= 0 {
    elabRetsAdd(out, mkFuncTy(agreed, r))
    return 0
  }
  const ks = elabNodeTys[c] ?? []
  // A call no instance elaborated is typed by the check.
  if ks.length == 0 {
    const tys: i32[] = []
    for a in cn.callArgs {
      const t = nodeTyIxOf(a)
      if t >= 0 && !tyHasTyVar(t) { tys.push(widenLitTy(t)) }
    }
    const rt = nodeTyIxOf(c)
    if tys.length == cn.callArgs.length && rt >= 0 {
      elabRetsAdd(out, mkFuncTy(tys, rt))
    }
    return 0
  }
  let i = 0
  while i + 1 < ks.length {
    const k = ks[i]
    if !elabDlvKeyOk(k) {
      i = i + 2
      continue
    }
    const tys: i32[] = []
    for a in cn.callArgs {
      const t = elabTyIn(a, k)
      if t >= 0 && !tyHasTyVar(t) { tys.push(t) }
    }
    if tys.length == cn.callArgs.length && ks[i + 1] >= 0 {
      elabRetsAdd(out, mkFuncTy(tys, ks[i + 1]))
    }
    i = i + 2
  }
  0
}

// The type at slot `path` of a value of type `t`, nullable wrappers looked through; -1 where a step
// does not apply.
function elabSlotTyOf(t: i32, path: string[]): i32 {
  let c = t
  for k in path {
    c = nonNullTy(c)
    if c < 0 || c >= T.tys.length { return -1 }
    const ct = tyAt(c)
    if (k == "e" || k == "v") && ct is TyArray {
      c = ct.aElem
    } else if (k == "e" || k == "v") && ct is TyMap {
      c = ct.mVal
    } else if ct is TyObj && k.length > 2 && k.slice(0, 2) == "f." {
      const i = strListIndexOf(ct.objFieldNames, k.slice(2, k.length))
      if i < 0 { return -1 }
      c = ct.objFieldTypes[i]
    } else {
      return -1
    }
  }
  nonNullTy(c)
}

// Adds closed type `t` to `out` unless one the same is there.
function elabRetsAdd(out: i32[], t: i32) {
  if t < 0 || t >= T.tys.length { return 0 }
  const ft = tyAt(t)
  if !(ft is TyFunc) { return 0 }
  for p in ft.fnParamTypes {
    if p < 0 || tyHasTyVar(p) || tyReachesHole(p, 8) { return 0 }
  }
  for o in out {
    if tySame(o, t) { return 0 }
  }
  out.push(t)
  0
}

// `elabSlotHeldFns` of a slot below the binding's own value, [] for the value itself.
export function elabSlotSrcFns(d: i32, path: string[]): i32[] {
  if path.length == 0 { return [] }
  elabSlotHeldFns(d, path)
}

// The function declaring the `let` `d` stands for, -1 at module scope; -2 for any other
// declaration, or one the write index does not describe.
export function elabDeclFnOf(d: i32): i32 {
  const o = if d >= 0 && declOrigOf(d) >= 0 { declOrigOf(d) } else { d }
  if o < 0 || o >= P.nodes.length || !(nodeAt(o) is LetDecl) { return -2 }
  cwIxBuild()
  // A `let` a rewrite minted after the index is in the scope of the node it stands beside.
  const a = if o >= cwIxCoveredLen() { mintDeclAnchorOf(o) } else { o }
  if a < 0 || a >= cwIxCoveredLen() { return -2 }
  recEnclosingFn(a)
}

// Whether nothing calls the value of slot `path` of binding `d`: no call through the set its type
// carries, no closed delivery, and none of the functions it holds escapes to a call the program
// does not declare (architecture-target §3.3).
export function elabSlotUncalled(d: i32, path: string[]): boolean {
  if d < 0 || fnSlotCalled(d, path) || elabSlotSetCalls(d, path).length > 0 {
    return false
  }
  if elabSlotDeliveries(d, path, -1).length > 0 { return false }
  for f in elabSlotHeldFns(d, path) {
    if fnEscapes(f) { return false }
  }
  true
}

// Every function the slot `path` (steps `e`, `v`, `r`, `f.<name>`) of binding declaration `d` can
// hold: the members of the set its type carries, in the checked tree and in each instance of the
// function declaring it, and each function the write index stores at that slot.
export function elabSlotHeldFns(d: i32, path: string[]): i32[] {
  const out: i32[] = []
  if d < 0 || d >= P.nodes.length { return out }
  const o = if declOrigOf(d) >= 0 { declOrigOf(d) } else { d }
  for t in [nodeTyIxOf(d), nodeTyIxOf(o)] {
    for m in fnTagSlotMembers(t, path) {
      if !i32ListHas(out, m) { out.push(m) }
    }
  }
  const fd = recEnclosingFn(o)
  let k = 0
  while k < ekDecl.length {
    if ekDecl[k] == fd {
      for m in fnTagSlotMembers(elabNodeTy(o, k), path) {
        if !i32ListHas(out, m) { out.push(m) }
      }
    }
    k = k + 1
  }
  if path.length > 0 {
    const cp: string[] = []
    for st in path {
      if st == "e" || st == "v" {
        cp.push("[]")
      } else if st.length > 2 && st.slice(0, 2) == "f." {
        cp.push(st.slice(2, st.length))
      } else {
        return out
      }
    }
    cwIxWant()
    // A binding a call initialises holds what the called function returns there.
    const on = nodeAt(o)
    const ci = if on is LetDecl && on.letInit >= 0 { parenPeelIx(on.letInit) } else { -1 }
    const cn = if ci >= 0 && ci < P.nodes.length { nodeAt(ci) } else { null }
    const rets: i32[] = []
    const ts = if cn is Call && holeSlotCallRets(cn, rets) { cwPathFnTargetsFrom(o, cp, rets) } else { cwPathFnTargets(o, cp) }
    for f in ts {
      if f >= 0 && !i32ListHas(out, f) { out.push(f) }
    }
    // A list spread into another, or spreading one, holds the other's elements too.
    if path[0] == "e" {
      const seen: i32[] = [o]
      const todo: i32[] = cwSpreadPeers(o)
      while todo.length > 0 && seen.length < 16 {
        const b = todo.pop() ?? -1
        if b >= 0 && !i32ListHas(seen, b) {
          seen.push(b)
          for m in fnTagSlotMembers(nodeTyIxOf(b), path) {
            if !i32ListHas(out, m) { out.push(m) }
          }
          for f in cwPathFnTargets(b, cp) {
            if f >= 0 && !i32ListHas(out, f) { out.push(f) }
          }
          for x in cwSpreadPeers(b) { todo.push(x) }
        }
      }
    }
  }
  out
}

// The closed type of node `ix` at instance `k`: what the elaboration recorded, else (a node it
// never checked, one the emitter minted or retyped) its recorded type under `k`'s substitution;
// -1 when that is still open.
export function elabNodeTy(ix: i32, k: i32): i32 {
  const t = elabTyIn(ix, k)
  let raw = elabCheckedTyOf(ix)
  if t >= 0 && t < T.tys.length {
    const open = tyHasTyVar(t)
    if elabTyClosed(t, 0) { return t }
    // A part still unknown (an empty literal its later writes type) reads the generic type.
    if open { raw = t }
  }
  elabSubstClosed(raw, k)
}

// Type `t` under instance `k`'s binding, or -1 where that does not close.
// `t` at the instance emitted function `fnIx` is, or is lifted inside: that instance's binding
// substituted; -1 outside one or where the substitution leaves it open.
export function elabInstTyAt(t: i32, fnIx: i32): i32 {
  if fnIx < 0 { return -1 }
  elabSubstClosed(t, elabKeyAt(fnIx))
}

export function elabSubstClosed(t: i32, k: i32): i32 {
  if t < 0 || t >= T.tys.length || k < 0 || k >= ekNames.length { return -1 }
  let names = ekNames[k]
  let tys = ekTys[k]
  // A row a shadow rename moved to an alias reads the binding of the name it stands for, at
  // the instance of the alias's declarer on `k`'s chain.
  if elabAliases.length > 0 {
    names = names.slice(0)
    tys = tys.slice(0)
    let kk = k
    while kk >= 0 && kk < ekDecl.length {
      for a in elabAliases {
        if (elabAliasDecl.get(a) ?? -1) == ekDecl[kk] {
          names.push(a)
          tys.push(bindOf(ekNames[kk], ekTys[kk], elabAliasOf[a] ?? a))
        }
      }
      kk = ekParent[kk]
    }
  }
  // A lambda instance reads its enclosing generic's binding, which speaks for that generic's own
  // variables only, not another's of the same name the lambda is typed at (D15034).
  const s = substTyDeepOf(t, names, tys, elabOwnerOf(k))
  if (s < 0 || s >= T.tys.length || s == TY_ERR || !elabTyClosed(s, 0)) {
    return -1
  }
  s
}

// The record every call reaching instance `k` is built at, as the checker stamped each call's
// delivery (`nodeRepTyIxOf`), when they all agree and it is closed; -1 otherwise (D14900).
export function elabDeliveredRowOf(k: i32): i32 {
  if k < 0 || k >= ekDecl.length { return -1 }
  const cs = elabKeyCalls[k] ?? []
  if cs.length == 0 { return -1 }
  let row = -1
  for c in cs {
    const st = nodeRepTyIxOf(c)
    if st < 0 || st >= T.tys.length || !(tyAt(st) is TyObj) || tyHasTyVar(st) {
      return -1
    }
    if row >= 0 && !tySame(row, st) { return -1 }
    row = st
  }
  row
}

// Instance `k`'s result: its template's checked return with `k`'s binding substituted, or the
// wider record a kept delivery builds that result as; -1 where it does not close.
export function elabRetOf(k: i32): i32 {
  if k < 0 || k >= ekDecl.length { return -1 }
  const wide = ekRetWide[k] ?? -1
  if wide >= 0 { return wide }
  const ft = nodeTyIxOf(ekDecl[k])
  if ft < 0 || ft >= T.tys.length { return -1 }
  const f = tyAt(ft)
  if !(f is TyFunc) { return -1 }
  let r = elabSubstClosed(f.fnRet, k)
  if r < 0 { r = elabRetOfValues(k) }
  if r < 0 { return -1 }
  const kd = recKeptFnDstOf(ekDecl[k], r)
  if kd >= 0 { kd } else { r }
}

// The type every value instance `k`'s body hands back has there, when each is a call through a
// parameter and they agree and close: the signature leaves such a result open; else -1.
function elabRetOfValues(k: i32): i32 {
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || dn.fnBody < 0 { return -1 }
  const vs: i32[] = []
  collectRetValues(dn.fnBody, vs)
  let t = -1
  for v in vs {
    const vn = if v >= 0 && v < P.nodes.length { nodeAt(v) } else { nodeAt(dn.fnBody) }
    if !(vn is Call) { return -1 }
    const pd = identDeclOf(parenPeelIx(vn.callFn))
    if pd < 0 || pd >= P.nodes.length || !(nodeAt(pd) is Param) { return -1 }
    const vt = elabNodeTy(v, k)
    if vt < 0 { return -1 }
    const w = widenLitTy(vt)
    if t >= 0 && !tySame(t, w) { return -1 }
    t = w
  }
  t
}

// Node `ix`'s type at the instance `fnIx` is, or -1 where its elaboration leaves it open. A
// module-scope argument the callee's type parameters type reads at the instance the call reaches;
// outside every instance, a call is the result of the instance it reaches. An un-annotated
// binding left open holds its initializer's type there.
export function elabNodeTyAt(ix: i32, fnIx: i32): i32 {
  const k = if fnIx >= 0 { elabKeyAt(fnIx) } else { elabKeyAtPos(monoArgInstFe.get(ix) ?? -1) }
  const t = if k >= 0 { elabNodeTy(ix, k) } else if k == -1 { elabRootCallTy(ix) } else { -1 }
  if t >= 0 || ix < 0 || ix >= P.nodes.length { return t }
  const n = nodeAt(ix)
  if n is LetDecl && n.letType < 0 && n.letInit >= 0 {
    return elabNodeTyAt(parenPeelIx(n.letInit), fnIx)
  }
  -1
}

// The result of the instance call `ix` reaches from the root; -1 for any other node.
function elabRootCallTy(ix: i32): i32 {
  if ix < 0 || !(nodeAt(ix) is Call) { return -1 }
  elabResultOf(elabCallInstFrom(ix, -1))
}

// The result of declaration `decl0`'s instance at parameter types `pTys`, found or checked now
// from the root; -1 when its signature does not bind them or the result stays open.
export function elabResultAtParams(decl0: i32, pTys: i32[]): i32 {
  if !tysClosed(pTys) { return -1 }
  const none: string[] = []
  const noTys: i32[] = []
  elabResultOf(elabDemandFrom(decl0, none, noTys, pTys, -1, -1))
}

// Instance `k`'s result: `elabRetOf`, else, for a template with no written result, the one type
// its elaboration gives every value the body yields; -1 where those disagree or stay open.
export function elabResultOf(k: i32): i32 {
  const r = elabRetOf(k)
  if r >= 0 || k < 0 { return r }
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || dn.fnRet >= 0 || dn.fnBody < 0 { return -1 }
  const vals: i32[] = []
  a20RetWalk(dn.fnBody, true, vals)
  let t = -1
  for v in vals {
    const vt = elabNodeTy(v, k)
    if vt < 0 || (t >= 0 && !tySame(t, vt)) { return -1 }
    t = vt
  }
  t
}

// The type emitted function `fnIx`'s instance elaboration stamped node `ix` with, or -1.
// The destination type node `ix` is delivered at in emitted function `fnIx`'s instance, or -1.
export function elabNodeCtxAt(ix: i32, fnIx: i32): i32 {
  if ix < 0 || !elabBankHolds(elabNodeCtxs, ix) { return -1 }
  elabPairIn(elabNodeCtxs, ix, elabKeyAt(fnIx))
}

// The union node `ix` is delivered into in emitted function `fnIx`'s instance, or -1.
export function elabNodeBoxAt(ix: i32, fnIx: i32): i32 {
  if ix < 0 || !elabBankHolds(elabNodeBoxs, ix) { return -1 }
  elabPairIn(elabNodeBoxs, ix, elabKeyAt(fnIx))
}

export function elabNodeRepAt(ix: i32, fnIx: i32): i32 {
  if ix < 0 { return -1 }
  elabPairIn(elabNodeReps, ix, elabKeyAt(fnIx))
}

// The union whose arm literal `ix` (or its copy source) is adopted into in emitted function
// `fnIx`'s instance: that elaboration's record where it stamped the literal, else the checker's;
// -1 where no adoption went through a union.
export function litRepUnionAt(ix: i32, fnIx: i32): i32 {
  if ix < 0 { return -1 }
  const k = elabKeyAt(fnIx)
  if elabPairIn(elabNodeReps, ix, k) >= 0 {
    return elabPairIn(elabNodeRepUnions, ix, k)
  }
  const src = nodeSrc[ix] ?? -1
  const at = if ix < nodeRepTyIx.length && nodeRepTyIx[ix] >= 0 { ix } else { src }
  nodeRepUnionIx[at] ?? (-1)
}

// The type literal `ix` (or its copy source) is built at in emitted function `fnIx`'s instance:
// that elaboration's stamp, else the parameter its call closes, else its own closed stamp, else
// the type the instance checked it at (`litRepTyIn`), else its own type under that binding, else
// its checker type where closed; -1 where none closes.
export function litRepTyAt(ix: i32, fnIx: i32): i32 {
  if ix < 0 { return -1 }
  const k = elabKeyAt(fnIx)
  const r = elabPairIn(elabNodeReps, ix, k)
  if r >= 0 { return r }
  // The record solve's closed stamp is where the literal is built; the parameter its call
  // closes is only where it is delivered (D15288).
  if nodeRepStamped(ix) && !tyHasTyVar(nodeRepTyIx[ix]) {
    return nodeRepTyIx[ix]
  }
  const pa = elabArgTyAt(ix, k, 0)
  if pa >= 0 { return pa }
  const sp = elabSpreadInner[ix] ?? -1
  const ht = if sp >= 0 { litRepTyAt(sp >> 1, fnIx) } else { -1 }
  if (sp & 1) == 1 && ht >= 0 { return ht }
  const he = if ht >= 0 && ht < T.tys.length { T.tys[ht] } else { null }
  if he is TyArray && he.aElem >= 0 { return he.aElem }
  let s = if ix < nodeRepTyIx.length { nodeRepTyIx[ix] } else { -1 }
  const src = if s < 0 { nodeSrc[ix] ?? -1 } else { -1 }
  if src >= 0 && src < nodeRepTyIx.length { s = nodeRepTyIx[src] }
  if s >= 0 && s < T.tys.length && !tyHasTyVar(s) { return s }
  const c = litRepTyIn(ix, k)
  if c >= 0 { return c }
  const t = nodeRepTyIxOf(ix)
  if t >= 0 && !tyHasTyVar(t) { return t }
  const e = if t >= 0 { elabNodeTyAt(ix, fnIx) } else { -1 }
  if e >= 0 { return e }
  const own = nodeTyIxOf(ix)
  if (
    own >= 0
    && own < T.tys.length
    && !tyHasTyVar(own)
    && !tyHasInferHole(own, 0)
  ) {
    return own
  }
  -1
}

// The type value `ix` is built as from what it holds, where a kept function's result (`recKeptFnDstOf`)
// is under it: that call's record, a list literal whose every element is such, or a record literal
// with such a field. -1 where nothing under it is, or a list literal mixes it with other elements.
function litKeptRepOf(ix: i32, depth: i32): i32 {
  if recKeptFnDecl.length == 0 || depth <= 0 || ix < 0 { return -1 }
  const m = litKeptMemo[ix] ?? -2
  if m != -2 { return m }
  const r = litKeptRepFrom(ix, depth)
  litKeptMemo[ix] = r
  r
}

// `litKeptRepOf`, unmemoised.
function litKeptRepFrom(ix: i32, depth: i32): i32 {
  const p = parenPeelIx(ix)
  if p < 0 || p >= P.nodes.length { return -1 }
  const n = nodeAt(p)
  // A call copied where it is delivered lands at the declared record the checker recorded for it,
  // not at its function's build (D14818).
  if n is Call && recCopyTyOf(p) >= 0 { return recCopyTyOf(p) }
  if n is Call { return litKeptCallRep(p, depth) }
  if n is ArrayLit {
    let r = -1
    for e in n.arrElems {
      const er = litKeptRepOf(e, depth - 1)
      if er < 0 || (r >= 0 && !tySame(r, er)) { return -1 }
      r = er
    }
    return if r >= 0 { mkArrayTy(r) } else { -1 }
  }
  litKeptObjRep(p, depth)
}

// `litKeptRepOf` at a call `p`: a kept function's record, through a generic or hole identity
// to its argument, or through a function every result of which is a binding of such a call.
function litKeptCallRep(p: i32, depth: i32): i32 {
  const sa = recSolePinArg(p)
  if sa >= 0 { return litKeptRepOf(sa, depth - 1) }
  const fd = recInferredFnOf(p)
  if fd < 0 { return -1 }
  const kd = recKeptFnDstOf(fd, nonNulTyOf(nodeTyIxOf(p)))
  if kd >= 0 { return kd }
  const ha = recHoleIdentityArg(p, fd)
  if ha >= 0 { return litKeptRepOf(ha, depth - 1) }
  let r = -1
  for lf in recFnValueLeaves(fd) {
    const hd = if lf >= 0 && nodeAt(lf) is Ident { recHeldDecl(lf) } else { -1 }
    const hn = if hd >= 0 { nodeAt(hd) } else { null }
    if !(hn is LetDecl) { return -1 }
    const lr = litKeptRepOf(hn.letInit, depth - 1)
    if lr < 0 || (r >= 0 && !tySame(r, lr)) { return -1 }
    r = lr
  }
  r
}

// `litKeptRepOf` at a record literal `p`: its own type with each field holding a kept result
// retyped to that result's, or -1 where `p` is no record literal or no field holds one.
function litKeptObjRep(p: i32, depth: i32): i32 {
  const n = nodeAt(p)
  if n is ObjLit {
    const own = nonNulTyOf(nodeRepTyIxOf(p))
    const o = if own >= 0 && own < T.tys.length { T.tys[own] } else { null }
    if !(o is TyObj) { return -1 }
    const tys = o.objFieldTypes.slice(0)
    let any = false
    for f in n.objFields {
      const fi = nodeAt(f)
      if !(fi is FieldInit) { return -1 }
      const fr = litKeptRepOf(fi.fiValue, depth - 1)
      let at = 0
      while at < o.objFieldNames.length && o.objFieldNames[at] != fi.fiName {
        at = at + 1
      }
      if fr >= 0 && at < tys.length {
        tys[at] = fr
        any = true
      }
    }
    return if any { mkObjTy(o.objFieldNames, tys) } else { -1 }
  }
  -1
}

// Stamps the record literal an un-annotated binding `x` holds with the record the solve builds
// it at (`recBuildTyOf`), or the list literal it holds with the record its elements are built at
// (`recBuildElemTyOf`), both read from `bt` (`recBuildTable`); 0 where `x` is no such binding.
function litBuildStampLet(x: i32, bt: Map<i32, i32>): i32 {
  const d = nodeAt(x)
  if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return 0 }
  const v = cwPeelValue(d.letInit)
  if v < 0 || v >= P.nodes.length { return 0 }
  const t = recBuildTyIn(bt, x, false)
  if t >= 0 {
    return if nodeAt(v) is ObjLit { recordRepTyAdopt(v, t, 8) } else { 0 }
  }
  const et = recBuildTyIn(bt, x, true)
  const a = nodeAt(v)
  if et < 0 || !(a is ArrayLit) { return 0 }
  recordRepTyAdopt(v, mkArrayTy(et), 8)
}

// Stamps a record stored by `m[k] = {...}` into a binding `litBuildStampLet` stamps with that
// binding's element record; 0 where `x` is no such store.
function litBuildStampStore(x: i32, bt: Map<i32, i32>): i32 {
  const d = nodeAt(x)
  if !(d is BinExpr) || d.binOp != "=" || !(nodeAt(d.binRight) is ObjLit) {
    return 0
  }
  const b = indexBaseOf(d.binLeft)
  if b < 0 { return 0 }
  const et = recBuildTyIn(bt, identDeclOf(b), true)
  if et < 0 { return 0 }
  recordRepTyAdopt(d.binRight, et, 8)
}

// The list an index place `x` reads, or -1 where `x` is not an index.
function indexBaseOf(x: i32): i32 {
  const l = nodeAt(x)
  if l is Index { l.idxArr } else { -1 }
}

// Records `t` as the type node `x` is built at; 1.
function repStampNode(x: i32, t: i32): i32 {
  while nodeRepTyIx.length <= x { nodeRepTyIx.push(-1) }
  nodeRepTyIx[x] = t
  1
}

// Stamps node `x` with the type `litKeptRepOf` builds it as, where that is one.
function litKeptStamp(x: i32): i32 {
  const r = litKeptRepOf(x, 8)
  if r < 0 { return 0 }
  repStampNode(x, r)
}

// The type instance `k` delivers literal argument `ix` (or the node it copies) into: the parameter
// its call's instance closes, or for a list nested in one, that list's element; -1 where none.
function elabArgTyAt(ix: i32, k: i32, depth: i32): i32 {
  if ix < 0 || k < 0 || depth > 16 { return -1 }
  let n = ix
  if !elabLitArg.has(n) && !elabArgInner.has(n) { n = nodeSrc[ix] ?? -1 }
  const ca = elabLitArg[n] ?? []
  if ca.length >= 2 { return elabParamTyOf(elabCallInstFrom(ca[0], k), ca[1]) }
  const up = elabArgInner[n] ?? -1
  const pt = if up >= 0 { elabArgTyAt(up, k, depth + 1) } else { -1 }
  if pt < 0 || pt >= T.tys.length { return -1 }
  const p = T.tys[pt]
  if p is TyArray { p.aElem } else { -1 }
}

// Links each list literal nested in list literal `a`'s elements to the list holding it.
function elabArgInnerNote(a: i32) {
  const n = nodeAt(a)
  if !(n is ArrayLit) { return 0 }
  for e in n.arrElems {
    if e >= 0 && e < P.nodes.length && nodeAt(e) is ArrayLit {
      elabArgInner[e] = a
      elabArgInnerNote(e)
    }
  }
  0
}

// Links each list literal that list literal `a` holds to `a`, where `a` holds a spread or is
// itself so linked: an element is built at `a`'s element type, a spread operand at `a`'s own type.
export function elabSpreadNote(a: i32) {
  const n = nodeAt(a)
  if (
    !(n is ArrayLit)
    || (!elabSpreadInner.has(a) && !hasSpreadItem(n.arrElems))
  ) {
    return 0
  }
  for e in n.arrElems {
    const x = if e >= 0 && e < P.nodes.length { nodeAt(e) } else { null }
    const op = x is Spread
    let c = if x is Spread { x.spdArg } else { e }
    while c >= 0 && c < P.nodes.length && nodeAt(c) is Paren {
      const p = nodeAt(c)
      c = if p is Paren { p.parInner } else { -1 }
    }
    if c >= 0 && c < P.nodes.length && nodeAt(c) is ArrayLit {
      elabSpreadInner[c] = a * 2 + (if op { 1 } else { 0 })
    }
  }
  0
}

// Links list `run`, which the emitter makes of the plain elements beside a spread in list `h` or
// of a variadic push's arguments into receiver `h`, to `h`: the run is built at `h`'s own type.
// The node whose list type list literal `ix` is built at, as a run of plain elements or a
// spread argument the emitter minted or reached; -1 for any other literal.
export function elabSpreadRunHolderOf(ix: i32): i32 {
  const sp = elabSpreadInner[ix] ?? -1
  if sp < 0 || (sp & 1) != 1 { return -1 }
  sp >> 1
}

export function elabSpreadRunNote(run: i32, h: i32) {
  if h >= 0 && h < P.nodes.length { elabSpreadInner[run] = h * 2 + 1 }
  0
}

// Node `ix`'s type wherever it is built: its recorded type where that carries no type parameter
// or no instance records it, else its closed type at each instance that does, without repeats.
export function elabNodeInstTys(ix: i32): i32[] {
  const ty = nodeTyIxOf(ix)
  let ps = elabNodeTys[ix] ?? []
  if ps.length == 0 { ps = elabNodeTys[nodeSrc[ix] ?? -1] ?? [] }
  if ty < 0 || ty >= T.tys.length || !tyHasTyVar(ty) || ps.length == 0 {
    return [ty]
  }
  const out: i32[] = []
  let i = 0
  while i + 1 < ps.length {
    const t = elabNodeTy(ix, ps[i])
    let seen = t < 0
    for o in out {
      if o == t { seen = true }
    }
    if !seen { out.push(t) }
    i = i + 2
  }
  out
}

// The function type every instance that records list node `ix` builds its element at, or the one
// a module-scope argument is built at for the instance its call reaches; -1 when it stays open,
// is no list of functions, or two instances disagree.
export function elabListFnElemTy(ix: i32): i32 {
  let tys = elabNodeInstTys(ix)
  if tys.length == 1 && (tys[0] < 0 || tyHasTyVar(tys[0])) {
    tys = [elabNodeTyAt(ix, -1)]
  }
  let one = -1
  for t in tys {
    if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return -1 }
    const a = tyAt(t)
    if !(a is TyArray) { return -1 }
    const e = a.aElem
    if e < 0 || !(tyAt(e) is TyFunc) { return -1 }
    if one >= 0 && !tySame(one, e) { return -1 }
    one = e
  }
  one
}

// The closed types instances build literal `ix` (or the node it copies) at: what each one's
// elaboration gave it (`litRepTyIn`), else its own type there. Each instance that records the
// literal contributes at most one.
export function elabLitInstTys(ix: i32): i32[] {
  const out: i32[] = []
  let ps = elabNodeTys[ix] ?? []
  if ps.length == 0 { ps = elabNodeTys[nodeSrc[ix] ?? -1] ?? [] }
  let i = 0
  while i + 1 < ps.length {
    let t = litRepTyIn(ix, ps[i])
    if t < 0 { t = elabNodeTy(ix, ps[i]) }
    if t >= 0 { out.push(t) }
    i = i + 2
  }
  out
}

// The worklist key emitted function `fnIx` is: the nearest demanded slot up its lift chain, then
// each declaration emitted in place below it resolved to its one instance under that key. -1 at
// the root, -2 under a slot no demand keyed, -3 where an in-place declaration has several.
export function elabKeyAt(fnIx: i32): i32 { elabKeyAtPos(fnStmtsPosOf(fnIx)) }

// The slot whose instance key `pos`'s body is read under: `pos` or its nearest encloser with a
// key; -1 where none has one, or the key is not an instance.
export function elabInstSlotAt(pos0: i32): i32 {
  let pos = pos0
  let guard = 0
  while pos >= 0 && guard < 64 {
    const k = elabSlotKeys.get(pos) ?? 0 - 4
    if k > -4 { return if k >= 0 { pos } else { -1 } }
    pos = if pos < fnParent.length { fnParent[pos] } else { -1 }
    guard = guard + 1
  }
  -1
}

export function elabKeyAtPos(pos0: i32): i32 {
  let pos = pos0
  let k = -1
  const inPlace: i32[] = []
  let guard = 0
  while pos >= 0 && guard < 64 {
    if elabSlotKeys.has(pos) {
      k = elabSlotKeys[pos] ?? 0 - 2
      pos = -1
    } else {
      if pos < fnStmts.length { inPlace.push(elabSrcDecl(fnStmts[pos])) }
      pos = if pos < fnParent.length { fnParent[pos] } else { -1 }
    }
    guard = guard + 1
  }
  if k == 0 - 2 { return k }
  let i = inPlace.length - 1
  while i >= 0 {
    const d = inPlace[i]
    const ks = elabKidsAt(d, k)
    if ks.length == 1 { k = ks[0] }
    if ks.length > 1 { return -3 }
    i = i - 1
  }
  k
}

// The root of the body chain a rewrite rebuilt `b` from.
function elabBodyRoot(b: i32): i32 {
  let cur = b
  let guard = 0
  while guard < 64 {
    const up = bodyRebuiltFrom.get(cur) ?? -1
    if up < 0 { return cur }
    cur = up
    guard = guard + 1
  }
  cur
}

// The source declaration emitted declaration `d` copies: the one its body is rebuilt
// from, else its lambda template's, else `d`.
export function elabSrcDecl(d: i32): i32 {
  if d < 0 || d >= P.nodes.length { return -1 }
  let t = d
  let guard = 0
  while guard < 64 {
    const n = nodeAt(t)
    if !(n is FuncDecl) { return t }
    const b = elabBodyDecl.get(elabBodyRoot(n.fnBody)) ?? -1
    if b >= 0 { return b }
    if !monoLamCloneTmpl.has(t) { return t }
    t = monoLamCloneTmpl.get(t) ?? t
    guard = guard + 1
  }
  t
}

// The slots the emitter resolved the lambda dispatch arm callees of the dispatches it is emitting
// to, innermost last: a lambda arm's instance is the row's per frame, which only the emitter reads.
const elabArmStageAt: i32[] = []
const elabArmStageFe: i32[] = []

// Answers `elabArmFeOf` for arm callee `at` with slot `fe` until the matching pop.
export function elabArmStagePush(at: i32, fe: i32) {
  elabArmStageAt.push(at)
  elabArmStageFe.push(fe)
  0
}

export function elabArmStagePop() {
  elabArmStageAt.pop()
  elabArmStageFe.pop()
  0
}

// The closed signature dispatch arm call `call` calls its lambda at in frame `fnIx`: its arguments'
// types to its own; -1 where one does not close. The arm's callee keeps the lambda's open type.
export function elabArmSigAt(call: i32, fnIx: i32): i32 {
  const c = nodeAt(call)
  if !(c is Call) { return -1 }
  const ps: i32[] = []
  for a in c.callArgs {
    let t = elabNodeTyAt(a, fnIx)
    if t < 0 { t = nodeTyIxOf(a) }
    if !elabSigTyClosed(t) { return -1 }
    ps.push(t)
  }
  let r = elabNodeTyAt(call, fnIx)
  if r < 0 { r = nodeTyIxOf(call) }
  if !elabSigTyClosed(r) { return -1 }
  mkFuncTy(ps, r)
}

// Whether `t` is closed as a built closure's signature part: no type variable, or a tagged set,
// whose rep is the member id whatever its members' parameters.
export function elabSigTyClosed(t: i32): boolean {
  t >= 0 && t < T.tys.length && (fnTagTyIsTagged(t) || !tyHasTyVar(t))
}

// The slot a set's dispatch arm callee read `atIx`, still named `name` for its member, calls: that
// member's function, whatever the name resolves to where it is read; -1 for any other read. The one
// reader every name resolver asks before its own scope rule.
export function elabArmFeOf(atIx: i32, name: string): i32 {
  let i = elabArmStageAt.length - 1
  while i >= 0 {
    if elabArmStageAt[i] == atIx { return elabArmStageFe[i] }
    i = i - 1
  }
  const armD = fnTagArmCalleeOf(atIx)
  if armD < 0 || !fnDeclNameIs(armD, name) { return -1 }
  fnStmtsPosOf(armD)
}

// The frame that is frame `fnIx`'s chain's own copy of named nested function `decl`, matched by
// source declaration (`elabSrcDecl`): an instance's frame finds its copy, not its origin's by
// name, though the read naming it is shared by every instance's clone; -1 when no frame on the
// chain nests one, or the nearest nests two, which are two instances the read alone cannot pick.
export function elabNestedCopyOnChain(decl: i32, fnIx: i32): i32 {
  if decl < 0 || decl >= P.nodes.length { return -1 }
  const dn = nodeAt(decl)
  if !(dn is FuncDecl) || dn.fnName == "" { return -1 }
  if fnChildHead.length != fnStmts.length { buildFnChildIndex() }
  let pp = fnStmtsPosOf(fnIx)
  let steps = 0
  while pp >= 0 && steps <= fnStmts.length {
    let hit = -1
    let i = if pp < fnChildHead.length { fnChildHead[pp] } else { -1 }
    while i >= 0 {
      if elabSrcDecl(fnStmts[i]) == decl {
        if hit >= 0 { return -1 }
        hit = i
      }
      i = fnChildNext[i]
    }
    if hit >= 0 { return hit }
    let up = if pp < fnParent.length { fnParent[pp] } else { -1 }
    if up < 0 && pp < fnInstOrigin.length { up = fnInstOrigin[pp] }
    pp = up
    steps = steps + 1
  }
  -1
}

// The instances each instance's body reached, by its calls and its hole pins.
let ekReach: i32[][] = []
// The calls through a function value in each instance's body: instance → [call, key, ...].
let elabValCalls: {[i32]: i32[]} = Map()
// Each function value argument or callback the elaboration instanced: node → [from, key, ...].
let elabValueKeys: {[i32]: i32[]} = Map()
// Each call's instance by the instance its body sits in: call → [from, key, from, key, ...].
let elabCallKeys: {[i32]: i32[]} = Map()
// The calls that reached each instance: key → call nodes.
let elabKeyCalls: {[i32]: i32[]} = Map()
// Each instance at a set's rep (`elabSetRepRow`): key → the calls whose rows it reps.
let elabRepRowCalls: {[i32]: i32[]} = Map()
// Each list or record literal argument of a call an instance reaches: literal → [call, position].
let elabLitArg: {[i32]: i32[]} = Map()
// Each list literal nested in such an argument's elements → the list literal holding it.
let elabArgInner: {[i32]: i32} = Map()
// Each list literal a spread-bearing list literal holds → that holder times two, plus one for a
// spread operand.
let elabSpreadInner: {[i32]: i32} = Map()

// `litKeptRepOf`'s answers since the last `elabRun`.
let litKeptMemo: {[i32]: i32} = Map()

// Notes that function value `x` (an argument, or a callback's declaration) in instance `from`'s
// body is instanced at `k`.
function elabValueKeyNote(x: i32, from: i32, k: i32) {
  if k < 0 || x < 0 { return 0 }
  const vs = elabValueKeys[x] ?? []
  vs.push(from)
  vs.push(k)
  elabValueKeys[x] = vs
  0
}

// The instance key of declaration `decl` the elaboration made for the call or function value at
// `x` under the instance being walked: a call's own key, a value call's member, else the key it
// noted for that value; -1 for none. Read by the instance-key shadow (architecture-target §3.4).
export function elabWalkKeyOf(x: i32, isCall: boolean, decl: i32): i32 {
  if x < 0 { return -1 }
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  const d = elabSrcDecl(decl)
  if isCall {
    const k = elabCallInstFrom(x, top)
    if k >= 0 { return k }
    return elabValCallInst(top, x, d)
  }
  const vs = elabValueKeys[x] ?? []
  let j = 0
  while j + 1 < vs.length {
    if vs[j] == top && ekDecl[vs[j + 1]] == d { return vs[j + 1] }
    j = j + 2
  }
  -1
}

// Whether instance `k` of `d`, typed `f`, takes parameter types `pTys`, reading a hole parameter's
// type from the binding `k` holds for its hole name.
function elabKeyBindsParams(k: i32, d: i32, f: TyFunc, pTys: i32[]): boolean {
  const fd = nodeAt(d)
  const nm = if fd is FuncDecl { fd.fnName } else { "" }
  let i = 0
  while i < pTys.length {
    let st = substTyDeep(f.fnParamTypes[i], ekNames[k], ekTys[k])
    if st >= 0 && tyHasHole(st) {
      const at = strListIndexOf(ekNames[k], paramHoleName(nm, d, i))
      st = if at >= 0 && at < ekTys[k].length { ekTys[k][at] } else { -1 }
    }
    if st < 0 || !tySame(widenLitTy(st), pTys[i]) { return false }
    i = i + 1
  }
  true
}

// The key the elaboration noted for function value `x` of `decl` under the instance being walked;
// where it noted several (a bundle, one instance per signature), the one taking parameter types
// `pTys`. -1 for none.
export function elabValueKeyAt(x: i32, decl: i32, pTys: i32[]): i32 {
  if x < 0 { return -1 }
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  const d = elabSrcDecl(decl)
  const sig = if d >= 0 && d < P.nodes.length { nodeTyIxOf(d) } else { -1 }
  const f = if sig >= 0 && sig < T.tys.length { tyAt(sig) } else { tyAt(0) }
  const vs = elabValueKeys[x] ?? []
  let first = -1
  let j = 0
  while j + 1 < vs.length {
    const k = vs[j + 1]
    if vs[j] == top && ekDecl[k] == d {
      if first < 0 { first = k }
      if (
        f is TyFunc
        && f.fnParamTypes.length == pTys.length
        && elabKeyBindsParams(k, d, f, pTys)
      ) {
        return k
      }
    }
    j = j + 2
  }
  if (first >= 0 && f is TyFunc && f.fnParamTypes.length == pTys.length) {
    for k in elabKidsAt(d, top) {
      if elabKeyBindsParams(k, d, f, pTys) { return k }
    }
  }
  first
}

// The instance of `decl` a function value at `x` delivered to a typed slot is: the one the
// elaboration made at the parameter types of the function type the checker recorded for `x`,
// its own or else its destination's; -1 for none.
export function elabDeliveryKeyOf(x: i32, decl: i32): i32 {
  if x < 0 || x >= P.nodes.length { return -1 }
  const k = elabMemberKeyAtFnTy(nodeTyIxOf(x), decl)
  if k >= 0 { return k }
  elabMemberKeyAtFnTy(nodeCtxTyIxOf(x), decl)
}

// The source declarations of the named functions some node reads as a value rather than as a
// call's callee, filled by `elabRun`.
let elabValueDecls: {[i32]: boolean} = Map()

// Whether named function `decl` is ever delivered as a value: read by name anywhere other than
// as the callee of a call. Its instances are keyed by the value half (architecture-target §3.4).
export function elabDeclIsValue(decl: i32): boolean {
  elabValueDecls.get(elabSrcDecl(decl)) != null
}

// `elabMemberKeyAt` at the parameter types of closed function type `t`, else -1.
export function elabMemberKeyAtFnTy(t: i32, decl: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const f = tyAt(t)
  if !(f is TyFunc) { return -1 }
  elabMemberKeyAtTys(f.fnParamTypes, decl)
}

// `elabMemberKeyAt` at closed parameter types `tys`, preferring an instance nested under the
// instance being walked over another parent's, else -1.
export function elabMemberKeyAtTys(tys: i32[], decl: i32): i32 {
  if tys.length == 0 { return -1 }
  for p in tys {
    if p < 0 || p >= T.tys.length || tyHasTyVar(p) || tyHasHole(p) { return -1 }
  }
  const d = elabSrcDecl(decl)
  const kw = elabMemberKeyUnderWalk(d, tys)
  if kw >= 0 { return kw }
  elabMemberKeyAt(d, tys)
}

// Notes that call `ix` through a function value in instance `from`'s body (the root when -1) ran
// instance `k`.
function elabValCallNote(from: i32, ix: i32, k: i32) {
  if k < 0 { return 0 }
  const cs = elabValCalls[from] ?? []
  cs.push(ix)
  cs.push(k)
  elabValCalls[from] = cs
  0
}

// Notes that instance `from`'s body (the root when -1) reached instance `k`, through call `ix`
// where that is >= 0.
function elabReachNote(from: i32, k: i32, ix: i32) {
  if k < 0 { return 0 }
  if ix >= 0 { elabGuessKeys[k] = false }
  if from >= 0 && from < ekReach.length { ekReach[from].push(k) }
  if ix >= 0 {
    const ks = elabCallKeys[ix] ?? []
    ks.push(from)
    ks.push(k)
    elabCallKeys[ix] = ks
    const cs = elabKeyCalls[k] ?? []
    if !i32ListHas(cs, ix) { cs.push(ix) }
    elabKeyCalls[k] = cs
    const cn = nodeAt(ix)
    if cn is Call {
      let p = 0
      for a in cn.callArgs {
        if argIsLitAggregate(a) {
          elabLitArg[a] = [ix, p]
          elabArgInnerNote(a)
        }
        p = p + 1
      }
    }
  }
  0
}

// The function declarations a type carries as their singleton `Fn#d`, each once, into `ds`.
function elabFnIdsIn(t: i32, ds: i32[], depth: i32) {
  if t < 0 || t >= T.tys.length || depth > 16 { return 0 }
  const x = T.tys[t]
  if x is TyFunc {
    const fs = elabFnSetOf(t)
    for d in fs {
      if !i32ListHas(ds, d) { ds.push(d) }
    }
    if fs.length > 0 { return 0 }
  }
  match x {
    TyArray => {
      elabFnIdsIn(x.aElem, ds, depth + 1)
    }
    TyNullable => {
      elabFnIdsIn(x.nInner, ds, depth + 1)
    }
    TyMap => {
      elabFnIdsIn(x.mKey, ds, depth + 1)
      elabFnIdsIn(x.mVal, ds, depth + 1)
    }
    TyObj => {
      for ft in x.objFieldTypes { elabFnIdsIn(ft, ds, depth + 1) }
    }
    TyFunc => {
      for pt in x.fnParamTypes { elabFnIdsIn(pt, ds, depth + 1) }
      elabFnIdsIn(x.fnRet, ds, depth + 1)
    }
    TyUnion => {
      for m in x.uMembers { elabFnIdsIn(m, ds, depth + 1) }
    }
    TyVar | TyPrim | TyErr | TyLit | TyNeg => {}
  }
  0
}

// Whether instance `k`'s body reaches instance `t`, directly or through the instances it reaches.
function elabReaches(k: i32, t: i32): boolean {
  const seen: {[i32]: boolean} = Map()
  const work: i32[] = [k]
  while work.length > 0 {
    const a = work.pop() ?? -1
    if a < 0 || a >= ekReach.length || (seen[a] ?? false) { continue }
    seen[a] = true
    for r in ekReach[a] {
      if r == t { return true }
      work.push(r)
    }
  }
  false
}

// The one instance of `d` reached from instance `k`'s body, directly or through the instances it
// reaches; -1 when none is, -2 when two are.
function elabReachedOf(k: i32, d: i32): i32 {
  let found = -1
  const seen: {[i32]: boolean} = Map()
  const work: i32[] = [k]
  while work.length > 0 {
    const a = work.pop() ?? -1
    if a < 0 || a >= ekReach.length || (seen[a] ?? false) { continue }
    seen[a] = true
    for r in ekReach[a] {
      if ekDecl[r] == d {
        if found >= 0 && found != r { return 0 - 2 }
        found = r
      }
      work.push(r)
    }
  }
  found
}

// The one instance of `d` that parameter `i` of instance `k` carries: called as the callee, or
// handed as an argument to a parameter of the instance that call reached, whose carry is followed.
// -1 when it carries none, -2 when it carries two or a read of it is not one of those.
function elabParamReachedOf(k: i32, d: i32, i: i32, seen: i32[]): i32 {
  if k < 0 || k >= ekReach.length || seen.length > 64 { return 0 - 2 }
  // A parameter the walk already follows, as a recursion hands one on, adds no instance.
  let q = 0
  while q + 1 < seen.length {
    if seen[q] == k && seen[q + 1] == i { return -1 }
    q = q + 2
  }
  seen.push(k)
  seen.push(i)
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || i < 0 || i >= dn.fnParams.length { return 0 - 2 }
  const p = dn.fnParams[i]
  const calls: i32[] = []
  if !elabParamReadsPlaced(dn, p, calls) { return 0 - 2 }
  let found = -1
  for cx in calls {
    const c = nodeAt(cx)
    if c is Call {
      let hit = -1
      if elabReadsDecl(dn, c.callFn, p) {
        hit = elabValCallInst(k, cx, d)
        if hit < 0 { return 0 - 2 }
      }
      let j = 0
      while j < c.callArgs.length {
        if elabReadsDecl(dn, c.callArgs[j], p) && !elabArgRepins(cx, j) {
          const r = elabCallInstFrom(cx, k)
          // A non-generic callee's parameter of a closed function type takes the member's one
          // instance at that type (D15403).
          const dt = if r < 0 { elabClosedDestTy(c.callArgs[j], cx) } else { -1 }
          const h = if r >= 0 { elabParamReachedOf(r, d, j, seen) } else if dt >= 0 { elabInstAtTy(d, dt) } else { 0 - 2 }
          if h == 0 - 2 { return 0 - 2 }
          if h >= 0 {
            if hit >= 0 && hit != h { return 0 - 2 }
            hit = h
          }
        }
        j = j + 1
      }
      if hit >= 0 {
        if found >= 0 && found != hit { return 0 - 2 }
        found = hit
      }
    }
  }
  found
}

// The one instance of generic `d` whose own type is the closed function type `dt`; -2 when none
// or two are.
function elabInstAtTy(d: i32, dt: i32): i32 {
  const ft = nodeTyIxOf(d)
  if ft < 0 { return 0 - 2 }
  let found = 0 - 2
  let q = 0
  while q < ekDecl.length {
    if ekDecl[q] == d && tySame(substTyDeep(ft, ekNames[q], ekTys[q]), dt) {
      if found >= 0 { return 0 - 2 }
      found = q
    }
    q = q + 1
  }
  found
}

// `e` with its parentheses taken off.
function elabUnparen(e: i32): i32 {
  let x = e
  while x >= 0 && x < P.nodes.length {
    const n = nodeAt(x)
    if n is Paren { x = n.parInner } else { return x }
  }
  -1
}

// Whether argument `j` of call `cx` lands on a parameter the callee annotates with a type parameter
// read only as such annotations: a generic handed there keeps its own pin and is instanced at that
// parameter's calls, so it carries nothing back to the caller's parameter (D6202).
function elabArgRepins(cx: i32, j: i32): boolean {
  const c = nodeAt(cx)
  if !(c is Call) { return false }
  const f = elabUnparen(c.callFn)
  if f < 0 || !(nodeAt(f) is Ident) { return false }
  const cd = identDeclOf(f)
  if cd < 0 || cd >= P.nodes.length { return false }
  const fd = nodeAt(cd)
  if !(fd is FuncDecl) || j >= fd.fnParams.length { return false }
  const pn = nodeAt(fd.fnParams[j])
  if !(pn is Param) || pn.parType < 0 { return false }
  const tn = nodeAt(pn.parType)
  if (
    !(tn is TypeRef
      && strListHas(fd.fnTyParams, tn.tyName)
      && tyParamIsBareOnly(cd, tn.tyName))
  ) {
    return false
  }
  const seen: i32[] = []
  elabParamStaysIn(fd, fd.fnParams[j], seen)
}

// Whether the value of parameter `p` of `fn` never leaves it: every read of it, or of a copy of
// it, is a callee or an argument, and every argument it is lands on a declared function's
// parameter that also stays in. A value that is returned, stored or captured leaves.
function elabParamStaysIn(fn: FuncDecl, p: i32, seen: i32[]): boolean {
  if i32ListHas(seen, p) { return true }
  if seen.length > 64 { return false }
  seen.push(p)
  const calls: i32[] = []
  if !elabParamReadsPlaced(fn, p, calls) { return false }
  for cx in calls {
    const c = nodeAt(cx)
    if c is Call {
      let j = 0
      while j < c.callArgs.length {
        if elabReadsDecl(fn, c.callArgs[j], p) {
          const f = elabUnparen(c.callFn)
          if f < 0 || !(nodeAt(f) is Ident) { return false }
          const cd = identDeclOf(f)
          if cd < 0 || cd >= P.nodes.length { return false }
          const fd = nodeAt(cd)
          if !(fd is FuncDecl) || j >= fd.fnParams.length { return false }
          if !elabParamStaysIn(fd, fd.fnParams[j], seen) { return false }
        }
        j = j + 1
      }
    }
  }
  true
}

// The one instance of `d` call `cx`, through a function value in instance `k`'s body, ran; -1 for
// none or two.
function elabValCallInst(k: i32, cx: i32, d: i32): i32 {
  let r = -1
  const vc = elabValCalls[k] ?? []
  let v = 0
  while v + 1 < vc.length {
    if vc[v] == cx && ekDecl[vc[v + 1]] == d {
      if r >= 0 && r != vc[v + 1] { return -1 }
      r = vc[v + 1]
    }
    v = v + 2
  }
  const ks = elabCallKeys[cx] ?? []
  let j = 0
  while j + 1 < ks.length {
    if ks[j] == k && ekDecl[ks[j + 1]] == d {
      if r >= 0 && r != ks[j + 1] { return -1 }
      r = ks[j + 1]
    }
    j = j + 2
  }
  r
}

// Whether every read of parameter `p` of `fn`, or of a copy of it, is a callee or an argument of
// a call in `fn`'s own body or the seed of such a copy; those calls go to `calls`.
function elabParamReadsPlaced(fn: FuncDecl, p: i32, calls: i32[]): boolean {
  const copies: i32[] = []
  let reads = 0
  let placed = 0
  const all: i32[] = [fn.fnBody]
  while all.length > 0 {
    const ix = all.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is Ident {
        const dd = identDeclOf(ix)
        if dd == p || (dd >= 0 && elabCopiedParam(fn, dd) == p) {
          reads = reads + 1
        }
      }
      for c in nodeChildren(ix) { all.push(c) }
    }
  }
  const own: i32[] = [fn.fnBody]
  while own.length > 0 {
    const ix = own.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is Call {
        let here = 0
        if elabReadsDecl(fn, n.callFn, p) { here = here + 1 }
        for a in n.callArgs {
          if elabReadsDecl(fn, a, p) { here = here + 1 }
        }
        if here > 0 {
          calls.push(ix)
          placed = placed + here
        }
      }
      if (
        n is LetDecl
        && elabCopiedParam(fn, ix) == p
        && !i32ListHas(copies, ix)
      ) {
        copies.push(ix)
        placed = placed + 1
      }
      if !(n is FuncDecl) {
        for c in nodeChildren(ix) { own.push(c) }
      }
    }
  }
  reads == placed
}

// Whether expression `e` is a bare read of parameter `p` of `fn`, or of a copy of it that takes
// its pin (`elabCopiedParam`).
function elabReadsDecl(fn: FuncDecl, e: i32, p: i32): boolean {
  let x = e
  while x >= 0 && x < P.nodes.length {
    const n = nodeAt(x)
    if n is Paren {
      x = n.parInner
    } else {
      if !(n is Ident) { return false }
      const d = identDeclOf(x)
      return d == p || (d >= 0 && elabCopiedParam(fn, d) == p)
    }
  }
  false
}

// The parameter of `fn` that binding `d` is a copy of, taking its pin; -1 for any other binding.
function elabCopiedParam(fn: FuncDecl, d: i32): i32 { paramCopySeedOf(fn, d) }

// Whether `d` declares type parameters of its own.
function elabIsGenericDecl(d: i32): boolean {
  const n = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  n is FuncDecl && n.fnTyParams.length > 0
}

// The one instance of declaration `d`, -1 for none, -2 for several.
function elabSoleInstOf(d: i32): i32 {
  let found = -1
  let i = 0
  while i < ekDecl.length {
    if ekDecl[i] == d {
      if found >= 0 { return 0 - 2 }
      found = i
    }
    i = i + 1
  }
  found
}

// Type `t`, read at instance `k`, closed: each function value it carries as `Fn#d` takes the
// instance of `d` `k` reaches, else, for a generic `d`, its only instance (its D4551 default,
// D14784); a member with neither adds none. -1 where one is reached at two, or `t` stays open.
export function elabOutTy(t: i32, k: i32): i32 { elabOutTyVia(t, k, -1) }

// `elabOutTy`, each function value taking the instance parameter `via` of `k` carries
// (`elabParamReachedOf`) rather than the one `k`'s whole body reaches; -1 `via` reads the whole body.
function elabOutTyVia(t: i32, k: i32, via: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  if !tyHasTyVar(t) { return t }
  const ds: i32[] = []
  elabFnIdsIn(t, ds, 0)
  const names: string[] = []
  const tys: i32[] = []
  for d in ds {
    const seen: i32[] = []
    let r = if via >= 0 { elabParamReachedOf(k, d, via, seen) } else { elabReachedOf(k, d) }
    if r == -1 && elabIsGenericDecl(d) {
      const so = elabSoleInstOf(d)
      if so >= 0 { r = so }
    }
    if r == -1 { continue }
    if r < 0 { return -1 }
    let i = 0
    while i < ekNames[r].length {
      names.push(ekNames[r][i])
      tys.push(ekTys[r][i])
      i = i + 1
    }
    const ft = nodeTyIxOf(d)
    const rt = elabRetOf(r)
    if ft >= 0 && ft < T.tys.length && rt >= 0 {
      const f = tyAt(ft)
      if f is TyFunc && f.fnRet >= 0 && f.fnRet < T.tys.length {
        const rv = tyAt(f.fnRet)
        if rv is TyVar {
          names.push(rv.tvName)
          tys.push(rt)
        }
      }
    }
  }
  const s = substTyDeep(t, names, tys)
  if s < 0 || s >= T.tys.length || tyHasTyVar(s) { return -1 }
  s
}

// The closed type every instance the elaboration made gives node `a`, when they agree; -1 when
// none does or two differ.
export function elabNodeTyAgreed(a: i32): i32 {
  const ps = elabNodeTys[a] ?? []
  let t = -1
  let i = 0
  while i + 1 < ps.length {
    const at = ps[i + 1]
    if at < 0 || tyHasTyVar(at) || t >= 0 && !tySame(t, at) { return -1 }
    t = at
    i = i + 2
  }
  t
}

// The closed types call `cx`'s positional arguments take in every instance the elaboration made of
// the function holding it, when each argument has one; empty when one has none or two differ.
export function elabCallArgTysAgreed(cx: i32): i32[] {
  const none: i32[] = []
  if cx < 0 || cx >= P.nodes.length { return none }
  const cn = nodeAt(cx)
  if !(cn is Call) { return none }
  const out: i32[] = []
  for a in cn.callArgs {
    const t = elabNodeTyAgreed(a)
    if t < 0 { return none }
    out.push(t)
  }
  out
}

// `elabCallParamTy` of the instance call `ix` makes from instance `from` (-1 at the root).
export function elabCallParamTyFrom(ix: i32, i: i32, from: i32): i32 {
  elabParamTyOf(elabCallInstFrom(ix, from), i)
}

// The closed type of parameter `i` of the instance call `ix` reaches from the instance being
// walked, its function values taking the instances its body reaches; -1 where that does not close.
export function elabCallParamTy(ix: i32, i: i32): i32 {
  const from = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  elabParamTyOf(elabCallInstFrom(ix, from), i)
}

// `elabCallParamTy`, its function values taking the instances parameter `i` itself carries.
export function elabCallParamTyOwn(ix: i32, i: i32): i32 {
  const from = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  elabParamTyOwnAt(elabCallInstFrom(ix, from), i)
}

// The closed type of parameter `i` of instance `k` (a frame's key, `elabKeyAt`), its function
// values taking the instances that parameter itself carries; -1 where that does not close.
export function elabParamTyOwnAt(k: i32, i: i32): i32 {
  if k < 0 || k >= ekDecl.length { return -1 }
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || i >= dn.fnParams.length { return -1 }
  const pt = nodeTyIxOf(dn.fnParams[i])
  if pt < 0 { return -1 }
  elabOutTyVia(substTyDeep(pt, ekNames[k], ekTys[k]), k, i)
}

// The closed type the copy binding `d` (`paramCopySeedOf`) takes in the instance being walked:
// its parameter's own (`elabParamTyOwnAt`); -1 where `d` copies no parameter or that does not close.
export function elabCopyTyOwn(d: i32): i32 {
  const k = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  if k < 0 || k >= ekDecl.length { return -1 }
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) { return -1 }
  const pi = i32ListIndexOf(dn.fnParams, paramCopySeedOf(dn, d))
  if pi < 0 { return -1 }
  elabParamTyOwnAt(k, pi)
}

// The closed type of parameter `i` of instance `k`, or -1.
function elabParamTyOf(k: i32, i: i32): i32 {
  if k < 0 { return -1 }
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || i >= dn.fnParams.length { return -1 }
  const pt = nodeTyIxOf(dn.fnParams[i])
  if pt < 0 { return -1 }
  elabOutTy(substTyDeep(pt, ekNames[k], ekTys[k]), k)
}

// The type call `ix` binds parameter `i` of its callee `d` to, holes and sets kept: the instance
// the call reaches, else, for a call through a function value, the instance of member `d` it ran;
// -1 where neither is (D15260).
export function elabCallParamBoundTy(ix: i32, d: i32, i: i32): i32 {
  const from = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  const k = elabCallInstFrom(ix, from)
  elabParamBoundTyOf(
    if k >= 0 { k } else { elabValCallInst(from, ix, elabSrcDecl(d)) },
    i,
  )
}

// The type instance `k` binds its parameter `i` to, holes and sets kept; -1 for none.
function elabParamBoundTyOf(k: i32, i: i32): i32 {
  if k < 0 { return -1 }
  const dn = nodeAt(ekDecl[k])
  if !(dn is FuncDecl) || i >= dn.fnParams.length { return -1 }
  const pt = nodeTyIxOf(dn.fnParams[i])
  if pt < 0 { return -1 }
  substTyDeep(pt, ekNames[k], ekTys[k])
}

// The instance call `ix` reaches from instance `from`'s body (the root when -1), or -1.
function elabCallInstFrom(ix: i32, from: i32): i32 {
  const ks = elabCallKeys[ix] ?? []
  let k = -1
  let j = 0
  while j + 1 < ks.length {
    if ks[j] == from { k = ks[j + 1] }
    j = j + 2
  }
  k
}

// The closed type call `call` binds type parameter `tp` to under the instance being walked: its
// checker instance's binding, else at the root its bind row's; -1 for none (D2459).
export function elabCallBindTy(call: i32, tp: string): i32 {
  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
  const ck = elabCallInstFrom(call, top)
  const t = if ck >= 0 { bindOf(ekNames[ck], ekTys[ck], tp) } else if top < 0 { callBindTyOf(call, tp) } else { -1 }
  if t >= 0 && elabTyClosed(t, 0) { t } else { -1 }
}

// The type instance `k` builds literal `ix` (or the node it copies) at: the stamp its
// elaboration made, else, for a literal whose own type names a type parameter, the closed type
// that elaboration checked it at; -1 for none.
function litRepTyIn(ix: i32, k: i32): i32 {
  if k < 0 { return -1 }
  const s = elabPairIn(elabNodeReps, ix, k)
  if s >= 0 { return s }
  const own = nodeTyIxOf(ix)
  if own >= 0 && own < T.tys.length && !tyHasTyVar(own) { return -1 }
  const t = elabPairIn(elabNodeTys, ix, k)
  if t >= 0 && t < T.tys.length && !tyHasTyVar(t) { t } else { -1 }
}

// The closed type the checker stamped node `ix` to be built at in emitted function `fnIx`'s
// instance, else outside every instance; -1 for none, never the type the node merely has.
export function elabStampAt(ix: i32, fnIx: i32): i32 {
  if ix < 0 { return -1 }
  const r = elabPairIn(elabNodeReps, ix, elabKeyAt(fnIx))
  if r >= 0 { return r }
  const s = if ix < nodeRepTyIx.length { nodeRepTyIx[ix] } else { -1 }
  if s >= 0 && s < T.tys.length && !tyHasTyVar(s) { s } else { -1 }
}

// Gives the copy `to` of the read `from` the narrowings every instance recorded for `from`.
export function elabNarrowedCarry(from: i32, to: i32) {
  const ns = elabNodeNarrowed[from] ?? []
  if ns.length > 0 { elabNodeNarrowed[to] = ns }
  0
}

// The storage type the read `ix` is narrowed out of in emitted function `fnIx`'s instance, -1 where
// that instance reads it unnarrowed, or -2 where no instance re-checked the read.
export function elabNarrowedFromAt(ix: i32, fnIx: i32): i32 {
  // -2 before the instance-key walk: a node no instance re-checked has no entry in either bank.
  if !elabHasPairs(elabNodeTys, ix) && !elabHasPairs(elabNodeNarrowed, ix) {
    return -2
  }
  const k = if fnIx >= 0 { elabKeyAt(fnIx) } else { -1 }
  if k < 0 { return -2 }
  const st = elabPairIn(elabNodeNarrowed, ix, k)
  if st >= 0 { return st }
  if elabPairIn(elabNodeTys, ix, k) < 0 { return -2 }
  -1
}

// The storage type the read `ix` is narrowed out of inside emitted function `fnIx`: its instance's
// answer where one re-checked the read, else the template's. -1 when the read is not narrowed.
export function readNarrowedStoreAt(ix: i32, fnIx: i32): i32 {
  if ix < 0 { return -1 }
  const r = parenPeelIx(ix)
  const el = elabNarrowedFromAt(r, fnIx)
  if el == -2 { narrowedFromTyOf(r) } else { el }
}

// The operand a type guard or a lifted `null` read is reading at its storage, or -1: that read
// is the box, unnarrowed.
let storageReadIx = -1

// Mark `ix` as read at its storage; returns the mark to restore.
export function storageReadEnter(ix: i32): i32 {
  const saved = storageReadIx
  storageReadIx = parenPeelIx(ix)
  saved
}

export function storageReadLeave(saved: i32) { storageReadIx = saved }

// Whether `ix` is the operand being read at its storage (`storageReadEnter`).
export function isStorageRead(ix: i32): boolean {
  ix >= 0 && parenPeelIx(ix) == storageReadIx
}

// Whether `ix` (or the node it copies) has any instance's entry in a `[key, type, ...]` bank.
function elabHasPairs(bank: {[i32]: i32[]}, ix: i32): boolean {
  if (bank[ix] ?? elabFnNone).length > 0 { return true }
  (bank[nodeSrc[ix] ?? -1] ?? elabFnNone).length > 0
}

// Instance `k`'s entry for node `ix` (or the node it copies) in a `[key, type, ...]` bank; -1
// for none.
// Whether `bank` holds a row for node `ix` or for the source node it copies, so a reader can
// decline before it walks to the instance's key.
function elabBankHolds(bank: {[i32]: i32[]}, ix: i32): boolean {
  bank.has(ix) || bank.has(nodeSrc[ix] ?? -1)
}

function elabPairIn(bank: {[i32]: i32[]}, ix: i32, k: i32): i32 {
  if k < 0 { return -1 }
  let rs = bank[ix] ?? elabFnNone
  if rs.length == 0 { rs = bank[nodeSrc[ix] ?? -1] ?? elabFnNone }
  let i = 0
  while i + 1 < rs.length {
    if rs[i] == k { return rs[i + 1] }
    i = i + 2
  }
  -1
}

// The empty member list a closed type keys by.
const elabFnNone: i32[] = []

// Whether `a` and `b` name the same types in order.
function elabTysSame(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if !tySame(a[i], b[i]) { return false }
    i = i + 1
  }
  true
}
