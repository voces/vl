// The closure-capture walks that read syntax only: which names a nested function writes, mentions
// or lets escape (`crwEnsure`, `crEscWalk`), whether a capture is by reference (`crCaptureByRef`)
// and which bindings are ever assigned a value that may be `null` (`crNulledWalk`). The checker
// resets the tables and asks the questions; nothing here reads the type arena or the scope chain.
// Writes are keyed by binding, through `./check_write_scan`'s `cwKeyOfRoot`.
import {
  ArrayLit,
  BinExpr,
  BoolLit,
  Call,
  CharLit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  OP_INDEX_GET,
  OP_INDEX_SET,
  ObjLit,
  P,
  Param,
  StrLit,
  WhileStmt,
  elseIfLink,
  hasNamedArgs,
  nodeAt,
  nodeSpineChildren,
  nodeToks,
} from "./ast"
import { crUnParen } from "./check_narrow_ends"
import { cexLitPeel } from "./check_num_lits"
import { placeKeyOf } from "./check_places"
import { i32ListHas, i32ListPlus } from "./listutil"
import { identDeclOf, sidOfNode } from "./symbols"
import { CW_FR_MOD, cwKeyFrame, cwKeyOfRoot } from "./check_write_scan"

export const crNoNames: string[] = []

// The writer analysis of root `crwRoot`: its nested functions, each one's binding name ("" when
// it is not bound by a `const`, a `let`, an assignment or its own name), the bindings written
// (by `cwKeyOfRoot` key) and names mentioned anywhere inside it, and every identifier use in
// the root with its role.
export let crwRoot = -2
export let crwFns: i32[] = []
export let crwFnHandle: string[] = []
let crwFnWrites: {[i32]: boolean}[] = []
let crwFnWriteSids: {[i32]: boolean}[] = []
export let crwFnMentions: {[string]: boolean}[] = []
// Every key some nested function's `crwFnWrites` holds, its interned name, and its bare name.
let crwAnyWrites: {[i32]: boolean} = Map()
let crwAnyWriteSids: {[i32]: boolean} = Map()
export let crwAnyWriteBase: {[string]: boolean} = Map()
// Advanced each time the analysis is rebuilt, so a cache over it can tell it is stale.
export let crwGen = 0
export let crwUseNames: string[] = []
export let crwUseKinds: i32[] = []
// Per use, the key of the binding an assignment target writes, or -1 for any other use.
export let crwUseKeys: i32[] = []
export let crwBound: {[string]: boolean} = Map()
let crwStack: i32[] = []
let crwCallee: {[i32]: boolean} = Map()
let crwAsgLhs: {[i32]: boolean} = Map()
export let crwBindOf: {[i32]: string} = Map()
// The declaration of the binding a nested function is held by, beside its name in `crwBindOf`.
export let crwBindDeclOf: {[i32]: i32} = Map()
// A lambda written as a call's argument, mapped to that call.
export let crwArgCall: {[i32]: i32} = Map()

// Build the writer analysis of `root` unless it is the one already built.
export function crwEnsure(root: i32) {
  if root == crwRoot { return 0 }
  crwRoot = root
  crwGen = crwGen + 1
  crwFns = []
  crwFnHandle = []
  crwFnWrites = []
  crwFnWriteSids = []
  crwAnyWrites = Map()
  crwAnyWriteSids = Map()
  crwAnyWriteBase = Map()
  crwFnMentions = []
  crwUseNames = []
  crwUseKinds = []
  crwUseKeys = []
  crwBound = Map()
  crwStack = []
  crwCallee = Map()
  crwAsgLhs = Map()
  crwBindOf = Map()
  crwBindDeclOf = Map()
  crwArgCall = Map()
  if root < 0 || root >= P.nodes.length { return 0 }
  const r = nodeAt(root)
  if r is FuncDecl {
    crwBindParams(r)
    crwVisit(r.fnBody)
  } else {
    crwVisit(root)
  }
  0
}

function crwBindParams(fd: FuncDecl) {
  let i = 0
  while i < fd.fnParams.length {
    const p = nodeAt(fd.fnParams[i])
    if p is Param { crwBound[p.parName] = true }
    i = i + 1
  }
  0
}

// Whether the writes `keys`/`sids` (`crKeyAdd`) may write the binding of key `k`: its own key, the
// key standing for every binding of its name, or for such a key any write of the name.
export function crKeyHit(
  keys: {[i32]: boolean},
  sids: {[i32]: boolean},
  k: i32,
): boolean {
  if k == -1 { return false }
  if k <= -2 { return sids.has(-2 - k) }
  keys.has(k) || keys.has(-2 - sidOfNode(k))
}

// Record a write of the binding of key `k` into `keys`, and its interned name into `sids`.
export function crKeyAdd(
  keys: {[i32]: boolean},
  sids: {[i32]: boolean},
  k: i32,
) {
  if k == -1 { return 0 }
  keys[k] = true
  if k <= -2 { sids[-2 - k] = true }
  else if k < P.nodes.length { sids[sidOfNode(k)] = true }
  0
}

// Whether nested function `j` of the root writes the binding of key `k`.
export function crwWrites(j: i32, k: i32): boolean {
  crKeyHit(crwFnWrites[j], crwFnWriteSids[j], k)
}

// Whether some nested function of the root writes the binding of key `k`.
export function crwWritten(k: i32): boolean {
  crKeyHit(crwAnyWrites, crwAnyWriteSids, k)
}

// The stack height from which nested functions are inside the frame declaring the binding of
// key `k`: past that frame's entry, or 0 for the root's own level, the module or no frame.
function crwDeclHeight(k: i32): i32 {
  if k < 0 { return 0 }
  const fr = cwKeyFrame(k)
  let p = crwStack.length - 1
  while p >= 0 {
    if crwFns[crwStack[p]] == fr { return p + 1 }
    p = p - 1
  }
  0
}

// One walk of the root. A nested function is recorded on entry, so a use inside it can say
// which one holds it; a write or mention inside it counts for every function around it too, up
// to the one declaring the binding it writes.
function crwVisit(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl {
    const j = crwFns.length
    crwFns.push(ix)
    let h = n.fnName
    if h == "" { h = crwBindOf[ix] ?? "" }
    crwFnHandle.push(h)
    crwFnWrites.push(Map())
    crwFnWriteSids.push(Map())
    crwFnMentions.push(Map())
    if n.fnName != "" { crwBound[n.fnName] = true }
    crwBindParams(n)
    crwStack.push(j)
    crwVisit(n.fnBody)
    crwStack.pop()
    return 0
  }
  if n is Ident {
    let kind = 0
    let key = -1
    if crwAsgLhs[ix] ?? false {
      kind = 2
      key = cwKeyOfRoot(ix)
    }
    if crwCallee[ix] ?? false { kind = 1 }
    crwUseNames.push(n.identName)
    crwUseKinds.push(kind)
    crwUseKeys.push(key)
    let s = 0
    while s < crwStack.length {
      const f = crwStack[s]
      crwFnMentions[f][n.identName] = true
      s = s + 1
    }
    return 0
  }
  if n is BinExpr {
    if n.binOp == "=" {
      const l = nodeAt(n.binLeft)
      if l is Ident {
        crwAsgLhs[n.binLeft] = true
        const wk = cwKeyOfRoot(n.binLeft)
        let s = crwDeclHeight(wk)
        while s < crwStack.length {
          const f = crwStack[s]
          crKeyAdd(crwFnWrites[f], crwFnWriteSids[f], wk)
          crKeyAdd(crwAnyWrites, crwAnyWriteSids, wk)
          crwAnyWriteBase[l.identName] = true
          s = s + 1
        }
        if nodeAt(n.binRight) is FuncDecl {
          crwBindOf[n.binRight] = l.identName
          crwBindDeclOf[n.binRight] = identDeclOf(n.binLeft)
        }
      }
    }
  } else if n is LetDecl {
    crwBound[n.letName] = true
    if n.letInit >= 0 {
      if nodeAt(n.letInit) is FuncDecl {
        crwBindOf[n.letInit] = n.letName
        crwBindDeclOf[n.letInit] = ix
      }
    }
  } else if n is Call {
    if n.callFn >= 0 && nodeAt(n.callFn) is Ident { crwCallee[n.callFn] = true }
    let a = 0
    while a < n.callArgs.length {
      const an = n.callArgs[a]
      if an >= 0 && an < P.nodes.length {
        if nodeAt(an) is FuncDecl { crwArgCall[an] = ix }
      }
      a = a + 1
    }
  } else if n is ForRange {
    crwBound[n.frVar] = true
  } else if n is ForIn {
    crwBound[n.fiVar] = true
    if n.fiVar2 != "" { crwBound[n.fiVar2] = true }
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      crwVisit(kids[k])
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// Does `mentions` hold any name of `hs`?
export function crwMentionsAny(
  mentions: {[string]: boolean},
  hs: string[],
): boolean {
  let i = 0
  while i < hs.length {
    if mentions.has(hs[i]) { return true }
    i = i + 1
  }
  false
}

// The operator a node may dispatch to a declaration of: a binary node's own, `"[]="` for an
// assignment to an index, `"[]"` for an index read, or "" — which `crOpIsReacher` answers true
// for, a call of no known shape reaching whatever it might.
export function crOpOf(ix: i32): string {
  const n = nodeAt(ix)
  if n is BinExpr { return crBinOpName(n) }
  crIndexOpOf(ix)
}

function crBinOpName(n: BinExpr): string {
  if n.binOp == "=" {
    if nodeAt(n.binLeft) is Index { return OP_INDEX_SET }
  }
  n.binOp
}

function crIndexOpOf(ix: i32): string {
  if nodeAt(ix) is Index { return OP_INDEX_GET }
  ""
}

// Record in `crNulledKeys` each assignment under `ix` that may store `null` into a module binding,
// or into a binding whose frame the write scan does not know.
export function crNulledWalk(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "=" && nodeAt(crUnParen(n.binLeft)) is Ident {
      const k = cwKeyOfRoot(n.binLeft)
      if (k <= -2 || cwKeyFrame(k) == CW_FR_MOD) && !crRhsNonNull(n.binRight) {
        crKeyAdd(crNulledKeys, crNulledSids, k)
      }
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      crNulledWalk(kids[k])
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// The bare name `ix` assigns (`x = e`), or "".
export function crAssignTarget(ix: i32): string {
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "=" {
      const l = nodeAt(crUnParen(n.binLeft))
      if l is Ident { return l.identName }
    }
  }
  ""
}

// Whether expression `ix` is a literal that cannot be `null`, or a `??` defaulting to one, so
// writing it keeps a narrowing that only removed `null`. Anything else may be `null` as far as
// this syntactic test knows.
export function crRhsNonNull(ix: i32): boolean {
  const u = crUnParen(ix)
  if u < 0 || u >= P.nodes.length { return false }
  if cexLitPeel(u) >= 0 || crCoalesceNonNull(u) { return true }
  const n = nodeAt(u)
  n is StrLit
    || n is CharLit
    || n is BoolLit
    || n is ObjLit
    || n is ArrayLit
    || n is FuncDecl
}

function crCoalesceNonNull(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is BinExpr { return n.binOp == "??" && crRhsNonNull(n.binRight) }
  false
}

export function crNodeTok(ix: i32): i32 {
  if ix >= 0 && ix < nodeToks.length { return nodeToks[ix] }
  -1
}

// Whether a closure made in `frame` may see a write of `null` to its binding `name` made after
// it captured it: a nested function writes it, or an assignment follows a capture or shares a
// loop with one that the binding's own declaration is not inside. Such a closure shares the
// binding's cell. Never finer than the emitter's `cboxByRef`, since it tells no arm apart.
export function crCaptureByRef(
  frame: i32,
  name: string,
  anyWrite: boolean,
): boolean {
  if !crByRefMemo.has(frame) { crByRefFrame(frame) }
  if anyWrite { return (crByRefAnyMemo[frame] ?? crNoByRef)[name] ?? false }
  (crByRefMemo[frame] ?? crNoByRef)[name] ?? false
}

const crNoByRef: {[string]: boolean} = Map()

// Every name of `frame` whose capture is by reference, from one walk of the frame.
function crByRefFrame(frame: i32) {
  const byRef: {[string]: boolean} = Map()
  const byRefAny: {[string]: boolean} = Map()
  crByRefMemo[frame] = byRef
  crByRefAnyMemo[frame] = byRefAny
  crbrOrd = 0
  crbrFnOrd = -1
  crbrFnLoops = []
  crbrArgFloor = -1
  crbrCapNames = []
  crbrCapOrds = []
  crbrCapLoops = []
  crbrAsgNames = []
  crbrAsgOrds = []
  crbrAsgLoops = []
  crbrAsgNested = []
  crbrAsgNull = []
  crbrDeclLoops = Map()
  let body = frame
  const fd = nodeAt(frame)
  if fd is FuncDecl { body = fd.fnBody }
  crbrWalk(body, 0, crNoLoops)
  // The first capture of each name, and the loops its captures sit in.
  const firstCap: {[string]: i32} = Map()
  const capLoops: {[string]: i32[]} = Map()
  let c = 0
  while c < crbrCapNames.length {
    const nm = crbrCapNames[c]
    const f0 = firstCap[nm] ?? -1
    if f0 < 0 || crbrCapOrds[c] < f0 { firstCap[nm] = crbrCapOrds[c] }
    const ls: i32[] = capLoops[nm] ?? []
    capLoops[nm] = ls
    for l in crbrCapLoops[c] { ls.push(l) }
    c = c + 1
  }
  let a = 0
  while a < crbrAsgNames.length {
    const nm = crbrAsgNames[a]
    const f0 = firstCap[nm] ?? -1
    if f0 >= 0 {
      if (
        crbrAsgNested[a]
        || crbrAsgOrds[a] > f0
        || crbrLoopsMeet(
          capLoops[nm] ?? crNoLoops,
          crbrAsgLoops[a],
          crbrDeclLoops[nm] ?? crNoLoops,
        )
      ) {
        byRefAny[nm] = true
        if crbrAsgNull[a] { byRef[nm] = true }
      }
    }
    a = a + 1
  }
  0
}

// One walk of a frame, in the emitter's order: an assignment is ordered after its operands, and a
// nested function at its start, or at the call's start when it is a named call's argument. Only
// an assignment that may store `null` is recorded.
function crbrWalk(ix: i32, depth: i32, loops: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is Ident {
    if depth > 0 {
      crbrCapNames.push(n.identName)
      crbrCapOrds.push(crbrFnOrd)
      crbrCapLoops.push(crbrFnLoops)
    }
    return 0
  }
  if n is FuncDecl {
    if depth == 0 {
      crbrOrd = crbrOrd + 1
      crbrFnOrd = crbrOrd
      if crbrArgFloor >= 0 { crbrFnOrd = crbrArgFloor }
      crbrFnLoops = loops
    }
    return crbrWalk(n.fnBody, depth + 1, loops)
  }
  let inner = loops
  if crIsLoop(ix) {
    inner = i32ListPlus(loops, ix)
    if depth == 0 { crbrNoteLoopDecl(ix, inner) }
  }
  if depth == 0 { crbrNoteLetDecl(ix, loops) }
  const savedFloor = crbrArgFloor
  if depth == 0 && savedFloor < 0 && crIsNamedCall(ix) {
    crbrArgFloor = crbrOrd
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      crbrWalk(kids[k], depth, inner)
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  crbrArgFloor = savedFloor
  const tgt = crAssignTarget(ix)
  if tgt != "" {
    crbrOrd = crbrOrd + 1
    crbrAsgNames.push(tgt)
    crbrAsgOrds.push(crbrOrd)
    crbrAsgLoops.push(loops)
    crbrAsgNested.push(depth > 0)
    crbrAsgNull.push(!crAsgRhsNonNull(ix))
  }
  0
}

function crAsgRhsNonNull(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is BinExpr { return crRhsNonNull(n.binRight) }
  false
}

// A frame's own declaration of a name records the loops it sits in; the first one wins, as in
// the emitter's `cboxDeclare`.
function crbrNoteLetDecl(ix: i32, loops: i32[]) {
  const n = nodeAt(ix)
  if n is LetDecl {
    if !crbrDeclLoops.has(n.letName) { crbrDeclLoops[n.letName] = loops }
  }
  0
}

// A loop variable is declared inside its own loop.
function crbrNoteLoopDecl(ix: i32, inner: i32[]) {
  crbrNoteRangeDecl(ix, inner)
  crbrNoteForInDecl(ix, inner)
}

function crbrNoteRangeDecl(ix: i32, inner: i32[]) {
  const n = nodeAt(ix)
  if n is ForRange {
    if !crbrDeclLoops.has(n.frVar) { crbrDeclLoops[n.frVar] = inner }
  }
  0
}

function crbrNoteForInDecl(ix: i32, inner: i32[]) {
  const n = nodeAt(ix)
  if n is ForIn {
    if !crbrDeclLoops.has(n.fiVar) { crbrDeclLoops[n.fiVar] = inner }
    if n.fiVar2 != "" && !crbrDeclLoops.has(n.fiVar2) {
      crbrDeclLoops[n.fiVar2] = inner
    }
  }
  0
}

export function crIsNamedCall(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is Call { return hasNamedArgs(n.callArgNames) }
  false
}

function crIsLoop(ix: i32): boolean {
  const n = nodeAt(ix)
  n is WhileStmt || n is ForRange || n is ForIn
}

// Whether two loop paths share a loop that the declaration's own path `decl` does not hold: a
// loop around the declaration makes a fresh binding each time round.
function crbrLoopsMeet(a: i32[], b: i32[], decl: i32[]): boolean {
  let i = 0
  while i < a.length {
    if i32ListHas(b, a[i]) && !i32ListHas(decl, a[i]) { return true }
    i = i + 1
  }
  false
}

// Per frame, then per name: `crCaptureByRef` for a write that may store `null`, and for any write.
export let crByRefMemo: {[i32]: {[string]: boolean}} = Map()
export let crNulledKeys: {[i32]: boolean} = Map()
export let crNulledSids: {[i32]: boolean} = Map()
export let crNulledBuilt = false
let crbrOrd = 0
let crbrFnOrd = -1
// The loops around a node, outermost first, as node indices.
const crNoLoops: i32[] = []
let crbrFnLoops: i32[] = []
let crbrArgFloor = -1
let crbrCapNames: string[] = []
let crbrCapOrds: i32[] = []
let crbrCapLoops: i32[][] = []
let crbrAsgNames: string[] = []
let crbrAsgOrds: i32[] = []
let crbrAsgLoops: i32[][] = []
let crbrAsgNested: boolean[] = []
let crbrAsgNull: boolean[] = []
export let crByRefAnyMemo: {[i32]: {[string]: boolean}} = Map()
let crbrDeclLoops: {[string]: i32[]} = Map()

// One walk of a body, adding to `out` every name used other than as that body's own callee: an
// identifier in any other position, or any identifier inside a nested function.
export function crEscWalk(ix: i32, nested: boolean, out: {[string]: boolean}) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is Ident {
    out[n.identName] = true
    return 0
  }
  if n is FuncDecl { return crEscWalk(n.fnBody, true, out) }
  let skip = -1
  if n is Call {
    if !nested && n.callFn >= 0 && nodeAt(n.callFn) is Ident { skip = n.callFn }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if kids[k] != skip { crEscWalk(kids[k], nested, out) }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// The `crParamOnlyCalled` questions open higher in the recursion, `decl * 64 + param`; one met
// again is answered yes, the least fixpoint of a forwarding cycle that stores nothing.
export const crPocOpen: i32[] = []

// Whether any identifier in the subtree is named `name`.
export function crSubtreeMentions(ix: i32, name: string): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is Ident { return n.identName == name }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if crSubtreeMentions(kids[k], name) { return true }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// Whether a fact after index `i` names the same place as `places[i]`.
export function crNameFacedLater(places: i32[], i: i32): boolean {
  let j = i + 1
  while j < places.length {
    if places[j] == places[i] { return true }
    j = j + 1
  }
  false
}

// The first assignment in the subtree at `ix` whose target is the bare name `name`, or -1.
export function crFirstAssignOf(ix: i32, name: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is FuncDecl { return -1 }
  if n is BinExpr {
    if n.binOp == "=" && placeKeyOf(n.binLeft) == name { return ix }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const a = crFirstAssignOf(kids[k], name)
      if a >= 0 { return a }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}
