// A recursive-descent parser for VL, written in VL: it consumes the token stream on the
// global `P` (filled by the driver from `lexer.vl`) and builds the discriminated-union
// arena AST of `compiler/ast.vl`. The grammar it covers is listed in
// `docs/internals/parser-notes.md` §"Grammar covered".
//
// Two invariants the code maintains. Every parser function declares `: i32`, the arena
// index it produces: recursive descent is mutually recursive by construction, and a
// forward-referenced function must declare its return type. And the walk always
// terminates — VL has no exceptions, so an error appends a `Diag` and recovers by
// synthesizing an `ErrExpr` leaf or skipping a token.
//
// All parser state lives in `Parser` struct fields reached through the module global `P`.

// The AST data layer (`compiler/ast.vl`): the token type, the global parser state
// `P`, and the arena `mk*` constructors. The parser's own `advance`/`peekTok`
// cursor primitives stay private to this module.
import { TokKind, tplPartStrLex } from "./lexer"
import { externAdd, isBinOpFuncName, mkMatch } from "./ast"
import { BinExpr, Ident, P, Tok, dgMarkLossless, mkDeclNameTok } from "./ast"
// The free index-operator declaration-name encoding — the parser is where
// `function "[]"(self: T, …)` gets the receiver-carrying name it declares under.
import {
  OP_INDEX_GET,
  OP_INDEX_SET,
  Param,
  TypeRef,
  i32ToStr,
  opDeclName,
} from "./ast"
// The type-spelling side arena — the structure `parseTypeName` builds while it
// recurses, recorded instead of being thrown away with the string it returns.
import {
  TS_APP,
  TS_ARR,
  TS_ERR,
  TS_FIELD,
  TS_FUNC,
  TS_ISECT,
  TS_LITNUM,
  TS_LITSTR,
  TS_MAP,
  TS_METHOD,
  TS_NAME,
  TS_NEG,
  TS_NULL,
  TS_OBJ,
  TS_PAREN,
  TS_UNION,
  setAnnTs,
  setBodyTyDecl,
  setDeclBound,
  setDeclGp,
  setFnTpBound,
  setUdTs,
  tsKind,
  tsLeaf,
  tsMark,
  tsMk,
  tsMkKids,
  tsPop,
  tsWrap,
} from "./ast"
import {
  AsMode,
  TPL_RENDER_LOCAL,
  mkArrayLit,
  mkAsExpr,
  mkBinary,
  mkBlock,
  mkBool,
  mkBreak,
  mkCall,
  mkCallN,
  mkChar,
  mkCompoundAssign,
  mkContinue,
  mkErr,
  mkFieldDef,
  mkFieldInit,
  mkForIn,
  mkForRange,
  mkFunc,
  mkIdent,
  mkIf,
  mkImport,
  mkIndex,
  mkIsExpr,
  mkIsExprNeg,
  mkLet,
  mkMember,
  mkNull,
  mkNum,
  mkObjLit,
  mkOptMember,
  mkParam,
  mkParen,
  mkPreIncr,
  mkProgram,
  mkReturn,
  mkStr,
  mkTplConcat,
  mkTplHole,
  mkTypeDecl,
  mkTypeRef,
  mkUnary,
  mkUnionDecl,
  mkWhile,
} from "./ast"

// ── cursor primitives ────────────────────────────────────────────────────────

// The current token. Past the end, returns the EOF token (the stream always ends
// with one), so callers never index out of range.
function peekTok(): Tok {
  if P.pos >= P.toks.length { return P.toks[P.toks.length - 1] }
  P.toks[P.pos]
}

// The current token's kind — the common discriminating `==` compare.
function peekKind(): TokKind { peekTok().kind }

// The kind of the token after the current one (one-token lookahead), for spotting a
// two-token sequence like `=>` (`EQUAL` `GT`) without consuming. EOF past the end.
function peek2Kind(): TokKind {
  if P.pos + 1 >= P.toks.length { return P.toks[P.toks.length - 1].kind }
  P.toks[P.pos + 1].kind
}

// Consume and return the current token.
function advance(): Tok {
  const t = peekTok()
  if P.pos < P.toks.length { P.pos = P.pos + 1 }
  t
}

// The kind of the token `i` positions from the stream start (an absolute index), clamped
// to the trailing EOF so a lookahead never indexes out of range. Unlike the
// cursor-relative `peekKind`, this reads an absolute index without moving the cursor, for
// the multi-token lookaheads that scan ahead with raw indices.
function kindAt(i: i32): TokKind {
  let j = i
  if j >= P.toks.length { j = P.toks.length - 1 }
  P.toks[j].kind
}

// The lexeme of the token at absolute index `i`, clamped to the trailing EOF exactly as
// `kindAt` clamps, for the lookaheads that must read a contextual keyword's spelling.
function textAt(i: i32): string {
  let j = i
  if j >= P.toks.length { j = P.toks.length - 1 }
  P.toks[j].text
}

// If the current token has `kind`, consume it and return true; else leave the
// cursor put and return false. (The "match" combinator.)
export function accept(kind: TokKind) {
  if peekKind() == kind {
    P.pos = P.pos + 1
    return true
  }
  false
}

// Skip any run of NEWLINE or SEMI tokens at the cursor, for the braced constructs
// (type-declaration field lists, union-variant lists) that may span several source lines.
// The statement-sequence parsers already skip newlines in their own loops; this gives the
// brace and `|` parsers the same tolerance.
function skipNewlines() {
  let going = peekKind() == "NEWLINE" || peekKind() == "SEMI"
  while going {
    P.pos = P.pos + 1
    going = peekKind() == "NEWLINE" || peekKind() == "SEMI"
  }
  0
}

// The statement-boundary tokens, the panic-mode sync points: NEWLINE and SEMI end the
// statement, `}` closes an enclosing block, EOF ends the input. The enclosing statement
// loops recover at these, so the `expect` error paths must never consume them — eating a
// closer is how one mis-parse cascades.
function isSyncKind(k: TokKind) {
  k == "NEWLINE" || k == "SEMI" || k == "RBRACE" || k == "EOF"
}

// Whether the token kind plausibly starts a statement — the mirror of `isSyncKind` (those
// are where a mis-parse recovers at, these where it may resume from), and the gate on
// `parseBracedBody`'s unbraced-body recovery. `{` is excluded because a braced body is the
// ordinary path, and `else` because `if c else { … }` is a missing then-branch.
function startsStmt(k: TokKind) {
  if isStmtKeyword(k) { return true }
  k == "IDENT" ||
    k == "NUMBER" ||
    k == "STRING" ||
    k == "TEMPLATE" ||
    k == "TEMPLATE_HEAD" ||
    k == "CHAR" ||
    k == "TRUE" ||
    k == "FALSE" ||
    k == "NULL" ||
    k == "MATCH" ||
    k == "LPAREN" ||
    k == "LBRACK" ||
    k == "BANG" ||
    k == "MINUS" ||
    k == "TILDE" ||
    k == "PLUSPLUS" ||
    k == "MINUSMINUS"
}

// Whether the token kind plausibly starts an expression — `startsStmt`'s set minus the
// statement keywords, plus `if`, since those are the value-returning keyword forms
// `parsePrimary` dispatches. `{` is left out on purpose: after a complete element a `{` is
// far more often a missing closer than a missing comma, so a lossy recovery is kept.
function startsExprTok(k: TokKind) {
  if k == "IF" { return true }
  if isStmtKeyword(k) { return false }
  startsStmt(k)
}

// The kind tag as text — the one place a `TokKind` atom is turned back into its spelling,
// so the chain over the whole vocabulary is emitted once, in a function only the
// diagnostic paths call. The `return` is load-bearing: an atom-to-string materialisation
// reached as a tail expression emits an out-of-range local and the module fails to load.
function kindTag(k: TokKind): string { return k }

// The display form of a token kind in an `expected …` message: the concrete
// lexeme for punctuation, a noun for the open classes, the raw kind tag as the
// fallback for the rest.
function kindDesc(k: TokKind): string {
  if k == "RPAREN" { return "`)`" }
  if k == "RBRACK" { return "`]`" }
  if k == "RBRACE" { return "`}`" }
  if k == "LPAREN" { return "`(`" }
  if k == "LBRACK" { return "`[`" }
  if k == "LBRACE" { return "`{`" }
  if k == "GT" { return "`>`" }
  if k == "COLON" { return "`:`" }
  if k == "EQUAL" { return "`=`" }
  if k == "COMMA" { return "`,`" }
  if k == "IDENT" { return "an identifier" }
  if k == "NEWLINE" { return "end of line" }
  if k == "EOF" { return "end of input" }
  kindTag(k)
}

// The display form of the offending token: its source lexeme, backticked. NEWLINE and EOF
// have no printable lexeme and get a noun instead.
function foundDesc(t: Tok) {
  if t.kind == "NEWLINE" { return "end of line" }
  if t.kind == "EOF" { return "end of input" }
  if t.text == "" { return kindTag(t.kind) }
  "`" + t.text + "`"
}

// Consume a token of the expected `kind`; on mismatch record a diagnostic and
// advance past the offender — unless it is a sync token (or a `{` opening a
// nested construct), which is left for the enclosing recovery to handle.
function expect(kind: TokKind) {
  if peekKind() == kind {
    P.pos = P.pos + 1
    return true
  }
  P.diags.push(
    {
      msg: "expected " + kindDesc(kind) + " but found " + foundDesc(peekTok()),
      at: P.pos,
    },
  )
  const k = peekKind()
  if !isSyncKind(k) && k != "LBRACE" { P.pos = P.pos + 1 }
  false
}

// `expect` for a structural closer (`)`, `]`, `}`, the generic `>`): on mismatch, diagnose
// once and skip forward to the closer, consuming it, bounded by the sync tokens, a
// statement-start keyword and `{`. A zero-token skip is a faithful recovery and is marked
// lossless; a skip that consumed tokens is not, because those tokens are gone.
function expectClose(kind: TokKind) {
  if peekKind() == kind {
    P.pos = P.pos + 1
    return true
  }
  const dgIx = P.diags.length // the index this push is about to occupy
  P.diags.push(
    {
      msg: "expected " + kindDesc(kind) + " but found " + foundDesc(peekTok()),
      at: P.pos,
    },
  )
  const from = P.pos
  let scanning = true
  while scanning {
    const k = peekKind()
    if k == kind {
      P.pos = P.pos + 1
      scanning = false
    } else if isSyncKind(k) || isStmtKeyword(k) || k == "LBRACE" {
      scanning = false
    } else {
      P.pos = P.pos + 1
    }
  }
  if P.pos == from { dgMarkLossless(dgIx) }
  false
}

// Whether a delimited list continues past the element just parsed. A real `,` is consumed;
// a missing one (`f(1 2)`) is diagnosed and inserted, so every element lands in the tree,
// and `startsElem` is the caller's element-start test. The insert is same-line only, or a
// missing closer at end of line reads as a missing comma and swallows the next statement.
function takeSep(startsElem: boolean): boolean {
  if peekKind() == "COMMA" {
    advance()
    return true
  }
  if !startsElem { return false }
  if P.pos == 0 || kindAt(P.pos - 1) == "NEWLINE" { return false }
  dgMarkLossless(P.diags.length) // the index this push is about to occupy
  P.diags.push(
    { msg: "expected `,` but found " + foundDesc(peekTok()), at: P.pos },
  )
  true
}

// Binary-operator binding power; higher binds tighter, and `0` means "not a binary
// operator", which is also the climber's loop-terminating sentinel. The ladder, loosest
// first: `??`/`||` < `&&` < `|` < `^` < `&` < `==`/`!=` < relational < shifts < `+`/`-` <
// `*` `/` `%`. A flat `==` ladder, since the common answer is `0`.
function binPrec(kind: TokKind): i32 {
  // The frequent non-operators, so the common `0` exits early.
  if (
    kind == "NEWLINE" ||
    kind == "COMMA" ||
    kind == "RPAREN" ||
    kind == "RBRACE" ||
    kind == "RBRACK" ||
    kind == "SEMI" ||
    kind == "COLON" ||
    kind == "LBRACE" ||
    kind == "EOF"
  ) {
    return 0
  }
  if kind == "PLUS" { return 10 }
  if kind == "MINUS" { return 10 }
  if kind == "STAR" { return 11 }
  if kind == "SLASH" { return 11 }
  if kind == "PERCENT" { return 11 }
  if kind == "EQ" { return 7 }
  if kind == "NE" { return 7 }
  if kind == "LT" { return 8 }
  if kind == "GT" { return 8 }
  if kind == "LE" { return 8 }
  if kind == "GE" { return 8 }
  if kind == "AND" { return 3 }
  if kind == "OR" { return 2 }
  if kind == "QUESTION_QUESTION" {
    return 2 // `a ?? b` nullish-coalescing (QUESTION_DOT is postfix, not binary)
  }
  if kind == "EQUAL" {
    return 1 // assignment (right-associative)
  }
  // Compound assignment (`+=` etc.) sits with assignment; the climber desugars it.
  if kind == "PLUSEQ" { return 1 }
  if kind == "MINUSEQ" { return 1 }
  if kind == "STAREQ" { return 1 }
  if kind == "SLASHEQ" { return 1 }
  if kind == "PIPE" {
    return 4 // bitwise OR  (`|`  -> i32.or)
  }
  if kind == "CARET" {
    return 5 // bitwise XOR (`^`  -> i32.xor) — between | and &
  }
  if kind == "AMPERSAND" {
    return 6 // bitwise AND (`&`  -> i32.and)
  }
  if kind == "SHL" {
    return 9 // left shift           (`<<`  -> i32.shl)
  }
  if kind == "SHR" {
    return 9 // signed right shift   (`>>`  -> i32.shr_s)
  }
  if kind == "USHR" {
    return 9 // unsigned right shift (`>>>` -> i32.shr_u)
  }
  0
}

// How many `(`, `[` or object-literal `{` are open around the expression being parsed.
// Inside one there is no statement a NEWLINE could end, so even `-` continues the line; at
// depth 0 only a token no expression can begin with does. A block resets it to 0, because a
// `{ … }` inside a call argument holds statements. D1581.
let brDepth = 0

// The absolute index of the first token at the cursor that is not a NEWLINE. Reads through
// `kindAt`, so the scan neither moves the cursor nor runs off the stream; comments are
// trivia and never reach `P.toks`, so a comment line between two lines costs nothing.
function afterNewlines(): i32 {
  let j = P.pos
  while kindAt(j) == "NEWLINE" { j = j + 1 }
  j
}

// Whether a line-leading binary operator continues the previous expression rather than
// starting a statement. Derived from `binPrec` so the set cannot drift: `-` is the only
// entry that can also begin an expression, and outside brackets a leading `-x` line is a
// block's value (DECISIONS "A line beginning with a token that cannot start an expression").
function continuesLine(kind: TokKind): boolean {
  if binPrec(kind) == 0 { return false }
  brDepth > 0 || kind != "MINUS"
}

// The absolute index of the binary operator a NEWLINE run at the cursor leads to, or -1
// when it leads to anything else. Sibling of `chainDotAfterNewlines`, with the same
// look-before-consume discipline: the cursor moves only once the answer is known, so a run
// leading to a closer is left in place for `takeSep` to read off `P.pos - 1`.
function binOpAfterNewlines(): i32 {
  const j = afterNewlines()
  if continuesLine(kindAt(j)) { return j }
  -1
}

// The absolute index of the `is` a NEWLINE run at the cursor leads to, or -1 otherwise.
// `!is` is deliberately absent: `!` can begin an expression, so a leading `!` stays a
// statement.
function isAfterNewlines(): i32 {
  const j = afterNewlines()
  if kindAt(j) == "IS" { return j }
  -1
}

// The absolute index of the contextual `as` at the cursor, past any NEWLINE run, or -1.
// `as` stays an IDENT token and is a legal identifier, so a leading one joins only when a
// named cast target follows: `as = 12` on its own line is an assignment to a variable
// called `as`, not a cast. With no newline crossed the same-line rule is unchanged.
function asAfterNewlines(): i32 {
  const j = afterNewlines()
  if kindAt(j) != "IDENT" { return -1 }
  if textAt(j) != "as" { return -1 }
  if j == P.pos { return j }
  let t = j + 1
  const suf = kindAt(t)
  if suf == "QUESTION" || suf == "BANG" || suf == "PERCENT" { t = t + 1 }
  if kindAt(t) == "IDENT" { return j }
  -1
}

// The right-associative operators (assignment): their RHS parses at the same
// precedence, not `prec + 1`, so `a = b = c` nests as `a = (b = c)`.
function rightAssoc(kind: TokKind) {
  kind == "EQUAL" ||
    kind == "PLUSEQ" ||
    kind == "MINUSEQ" ||
    kind == "STAREQ" ||
    kind == "SLASHEQ"
}

// ── type annotations ─────────────────────────────────────────────────────────

// `>`s still owed by a consumed `>>` or `>>>` token. This lexer fuses them into one token,
// so a nested generic close (`Box<Pair<i32, string>>`) arrives as a single token that must
// close two levels. Consuming it credits the extra `>`s here, and the enclosing closes
// drain the credit before reading another token.
let pendingGt = 0

// Consume one closing `>` of a generic argument list: a banked `>` from an
// earlier `>>`/`>>>` first, else a `GT` token, else a `SHR`/`USHR` token (which
// banks its remaining `>`s).
function expectTypeGt() {
  if pendingGt > 0 {
    pendingGt = pendingGt - 1
    return 0
  }
  const k = peekKind()
  if k == "SHR" {
    advance() // ">>" — one level now, one banked
    pendingGt = 1
    return 0
  }
  if k == "USHR" {
    advance() // ">>>" — one level now, two banked
    pendingGt = 2
    return 0
  }
  expectClose("GT")
  0
}

// True when the next token is `kind` and it may extend the type just parsed — that is, no
// `>` is still owed. A banked credit is an unclosed enclosing generic, and the close is the
// only thing that may happen next: in `Box<Box<i32>> | i32` a raw `peekKind` would let the
// outer `|` extend the argument. The three continuation loops all read the token here.
function atTypeCont(kind: TokKind) { pendingGt == 0 && peekKind() == kind }

// D1045 — a `type` declared inside a block is lexically scoped. The mechanism is the module
// merge's, not a second one: the declaration is minted under a unique name (`P` → `P$b7`),
// every reference in its lexical extent is spelled at that name, and the node is hoisted
// into `progStmts`, so every consumer that looks a type up by name works unchanged.
let btDepth = 0
// The scope chain, innermost last: the source name as written, the mangled base it is
// minted under, and the captured type parameters comma-joined ("" when there are none).
let btNames: string[] = []
let btBases: string[] = []
let btArgs: string[] = []
// Whether the row's name is also spelled in value position. Two forms are: a `flat type TV`
// answers `TV.size` and `TV.field` as a constant fold, and a nominal `type Id = new …` is
// the declaration a future constructor spelling would take. Set after the `new` marker is
// read, which sits past the `=`, so it is a column rather than part of the push.
let btIsNew: boolean[] = []
// The enclosing functions' live type parameters, outermost first.
let btTyParams: string[] = []
// The mint counter and the hoist list, both per program (`parseProgram` resets
// them): a name only has to be unique within its module, because the merge
// renames each module's top-level declarations — these included — apart.
let btSeq = 0
let btHoisted: i32[] = []
// The declaration currently being parsed, when it is body-scoped: its mangled
// base, or "" at module scope. Read by the five `mkTypeDecl`/`mkUnionDecl` exits.
let btPendingBase = ""

// The innermost scope row binding `name`, or -1. The walk stops at the first
// match, which IS the shadowing rule: an inner `type P` hides an outer one, and
// an outer one hides the module-scope declaration (which is not in this table at
// all, so an unmatched name falls through to module resolution unchanged).
function btLookup(name: string): i32 {
  let i = btNames.length - 1
  while i >= 0 {
    if btNames[i] == name { return i }
    i = i - 1
  }
  -1
}

// Trim the three scope columns back to `saved` rows (rebuilt rather than popped —
// a bare `.pop()` statement is an emit gap in the native pipeline, the same reason
// `driver.modTrimTo` exists).
function btTrimTo(saved: i32) {
  const ns: string[] = []
  const bs: string[] = []
  const as: string[] = []
  const nw: boolean[] = []
  let i = 0
  while i < saved {
    ns.push(btNames[i])
    bs.push(btBases[i])
    as.push(btArgs[i])
    nw.push(btIsNew[i])
    i = i + 1
  }
  btNames = ns
  btBases = bs
  btArgs = as
  btIsNew = nw
  0
}

function btTyParamsTrimTo(saved: i32) {
  const keep: string[] = []
  let i = 0
  while i < saved {
    keep.push(btTyParams[i])
    i = i + 1
  }
  btTyParams = keep
  0
}

// The live type parameters the rest of this declaration mentions, in declaration order —
// the capture set of a body-scoped `type` (D1045). A token lookahead, not a walk of the
// parsed body, because a self-reference (`type N = { next: N | null }`) is spelled while
// the body is read and must carry the same arguments every other reference does.
function btCaptureScan(): string[] {
  const out: string[] = []
  if btTyParams.length == 0 { return out }
  const seen: boolean[] = []
  let s = 0
  while s < btTyParams.length {
    seen.push(false)
    s = s + 1
  }
  let depth = 0
  let i = P.pos
  let going = true
  while going && i < P.toks.length {
    const t = P.toks[i]
    const k = t.kind
    if k == "EOF" {
      going = false
    } else if k == "LBRACE" || k == "LPAREN" || k == "LBRACK" {
      depth = depth + 1
    } else if k == "RBRACE" || k == "RPAREN" || k == "RBRACK" {
      if depth == 0 { going = false } else { depth = depth - 1 }
    } else if k == "NEWLINE" || k == "SEMI" {
      if depth == 0 {
        let j = i + 1
        while j < P.toks.length && P.toks[j].kind == "NEWLINE" { j = j + 1 }
        if j < P.toks.length && P.toks[j].kind == "PIPE" {
          i = j
        } else {
          going = false
        }
      }
    } else if k == "IDENT" {
      let p = 0
      while p < btTyParams.length {
        if btTyParams[p] == t.text { seen[p] = true }
        p = p + 1
      }
    }
    i = i + 1
  }
  let q = 0
  while q < btTyParams.length {
    if seen[q] { out.push(btTyParams[q]) }
    q = q + 1
  }
  out
}

// Join a captured-parameter list into the comma-separated argument text a
// reference spells (`"T,U"`), and push one `TS_NAME` leaf per parameter so the
// reference's `TS_APP` closes over them as its trailing arguments.
function btCaptureText(caps: string[]): string {
  let out = ""
  let i = 0
  while i < caps.length {
    if i > 0 { out = out + "," }
    out = out + caps[i]
    i = i + 1
  }
  out
}

function btPushCaptureLeaves(capt: string) {
  let start = 0
  let i = 0
  while i <= capt.length {
    if i == capt.length || capt[i] == ',' {
      if i > start { tsMk(TS_NAME, capt.slice(start, i), tsMark()) }
      start = i + 1
    }
    i = i + 1
  }
  0
}

// A `flat type` and a nominal `new` type are the `type` forms whose declared name is also
// spelled in expression position — `TV.size` folds against the flat layout — so an
// identifier naming one renames like its annotation does. Restricted to those rows: a plain
// struct, union or alias name has no meaning in expression position.
function btValueName(name: string): string {
  const row = btLookup(name)
  if row < 0 { return name }
  if !btIsNew[row] { return name }
  btBases[row]
}

// Record a body-scoped declaration node: marked for the two consumers that must
// not double-count it (the formatter's top-level walk and the module merge — see
// `ast.bodyTyDeclNode`) and queued for the hoist into `progStmts`.
function btNoteDecl(ix: i32) {
  if btPendingBase == "" { return 0 }
  setBodyTyDecl(ix)
  btHoisted.push(ix)
  0
}

// A type-name leaf (`i32`, `string`, a user type), optionally followed by one or more `[]`
// array suffixes. Each `[]` appends the literal characters to the type name, so an array
// type is a `TypeRef` whose name carries the brackets and the emitter discriminates on that
// suffix. Single-token lookahead only: after a base name an `[` must be followed by `]`.
export function parseType() {
  const p0 = peekTok().start
  const nm = parseTypeName()
  // The spelling tree the name comes from — recorded on the annotation node it becomes, so
  // a later pass can read the structure instead of re-deriving it from `tyName`. Popped
  // before the node is made: `mkTypeRef` pushes no spelling, and the producer left exactly
  // one root on the stack.
  const root = tsPop()
  const ix = mkTypeRef(nm, p0)
  setAnnTs(ix, root)
  // A well-formed annotation drains every `>` a `>>`/`>>>` banked (the credits
  // are consumed by the enclosing generic closes inside the recursion above).
  // A credit left here is an extra `>` — report it and drop it, or it would
  // silently close some later unrelated generic annotation.
  if pendingGt > 0 {
    pendingGt = 0
    P.diags.push({ msg: "extra `>` in type annotation", at: P.pos })
  }
  ix
}

// Parse a type annotation and return its synthetic name string (the lexeme the
// emitter discriminates on), without building a node. Splitting the name out lets the
// map case embed the value type's name into its own synthetic name without a
// `P.nodes[...] is TypeRef` round-trip (an arena-element read `is` can't narrow here).
export function parseTypeName() {
  // The spelling stack mark: every member `parseTypeIsect` returns pushes its
  // own root, so a union closes over exactly the region above this.
  const tm = tsMark()
  let members = 1
  let name = parseTypeIsect()
  // Inline union annotation `A | B | null`. In type position a `|` is a union separator,
  // against the bitwise-or operator in expression position. Encoded as the synthetic name
  // `"A|B"`, which the checker splits to build the union or nullable type. A member is an
  // intersection chain, so `A | B & C` is `A | (B & C)`.
  let more = atTypeCont("PIPE")
  while more {
    advance() // "|"
    name = name + "|" + parseTypeIsect()
    members = members + 1
    more = atTypeCont("PIPE")
  }
  // A one-member "union" is the member — mirroring the name, which is the
  // member's own text with no `|` in it.
  if members > 1 { tsMk(TS_UNION, "", tm) }
  name
}

// An intersection chain `A & B [& …]` — `&` binds tighter than the union `|` and looser
// than the prefix `!` and the `[]` suffix. Encoded as the synthetic name `"A&B"`; the
// checker splits on the top-level `&` and folds the operands through `intersectTy`.
function parseTypeIsect() {
  const tm = tsMark()
  let operands = 1
  let name = parseTypeAtom()
  let more = atTypeCont("AMPERSAND")
  while more {
    advance() // "&"
    name = name + "&" + parseTypeAtom()
    operands = operands + 1
    more = atTypeCont("AMPERSAND")
  }
  if operands > 1 { tsMk(TS_ISECT, "", tm) }
  name
}

// A method member's tail, shared by the two grammars that read a `{ … }` member list. The
// caller has already consumed the member name and holds its spelling mark; this consumes
// `( argument types ) : result`. The parameters are the call's arguments and the receiver is
// implicit. Renders to `f(A,B):R` and leaves one `TS_METHOD` root, result kid last.
function parseMethodMemberTail(fname: string, fm: i32) {
  advance() // "("
  let inner = ""
  if peekKind() != "RPAREN" {
    inner = parseTypeName()
    let pmore = peekKind() == "COMMA"
    while pmore {
      advance() // ","
      if peekKind() == "RPAREN" {
        pmore = false // tolerated trailing comma, as the function-type arm allows
      } else {
        inner = inner + "," + parseTypeName()
        pmore = peekKind() == "COMMA"
      }
    }
  }
  expectClose("RPAREN")
  expect("COLON")
  // The result extends as far right as it can, exactly as a function type's does
  // (`(i32) => i32 | null`): `{ find(): Circle | null }` is a method returning a
  // nullable, not a nullable method.
  const retName = parseTypeName()
  tsMk(TS_METHOD, fname, fm)
  fname + "(" + inner + "):" + retName
}

// One type atom: a map `{[K]:V}`, the `null` type, a literal type (`"a"`, `0`, `1.5`), a
// parenthesized group `(A | B)`, a prefix negation `!A`, or a bare name — each with any
// number of trailing `[]` suffixes. The union and intersection chains belong to the callers.
// A string literal keeps its quoted lexeme, so the depth-aware name scanners skip it.
function parseTypeAtom() {
  // Each arm below closes one spelling node over the region above this mark, so
  // the atom leaves exactly one root on the stack — including the error arm,
  // which pushes `TS_ERR` for the `""` name it returns.
  const tm = tsMark()
  let name = ""
  if peekKind() == "BANG" {
    // Prefix negation `!A` — binds tighter than `&` (so `A & !B` is "A but not
    // B"); recurses through the atom so `!!A` and `!(A | B)` parse.
    advance() // "!"
    name = "!" + parseTypeAtom()
    tsMk(TS_NEG, "", tm)
  } else if peekKind() == "STRING" {
    // A string-literal type: the raw lexeme keeps its quotes, so the synthetic
    // name is `"a"` and the checker decodes the member with the quotes intact.
    name = advance().text
    tsMk(TS_LITSTR, name, tm)
  } else if peekKind() == "NUMBER" {
    // A numeric-literal type (`0 | 1 | 2`, `1.5 | 2.5`): the raw lexeme is the
    // member name; the checker classifies int vs float by the `.`.
    name = advance().text
    tsMk(TS_LITNUM, name, tm)
  } else if peekKind() == "LPAREN" {
    // Either a function type `(params) => ret`, disambiguated by an `=>` after the `)`, or
    // a parenthesized group `(A | B)`, kept in the synthetic name so the checker's `|` and
    // `&` splitters honour the grouping. The paren contents parse as a comma-separated type
    // list either way.
    advance() // "("
    let inner = ""
    if peekKind() != "RPAREN" {
      inner = parseTypeName()
      let pmore = peekKind() == "COMMA"
      while pmore {
        advance() // ","
        if peekKind() == "RPAREN" {
          pmore = false // tolerated trailing comma
        } else {
          inner = inner + "," + parseTypeName()
          pmore = peekKind() == "COMMA"
        }
      }
    }
    expectClose("RPAREN")
    if peekKind() == "EQUAL" && peek2Kind() == "GT" {
      advance() // "="
      advance() // ">"
      // The return type extends as far right as it can: `(i32) => i32 | null` is a function
      // returning `i32 | null`, not a nullable function — parenthesize the function for
      // that. This grouping is `nameToTy`'s, not a choice: the checker takes a top-level
      // `=>` as binding looser than `|` and `&` (`parser-notes.md` §"function-type return").
      const retName = parseTypeName()
      name = "(" + inner + ")=>" + retName
      // Kids = the parameter list in order, then the return atom last (it is the
      // one child every function spelling has; a zero-param `() => T` has only it).
      tsMk(TS_FUNC, "", tm)
    } else {
      name = "(" + inner + ")"
      tsMk(TS_PAREN, "", tm)
    }
  } else if peekKind() == "LBRACE" {
    advance() // "{"
    if peekKind() == "LBRACK" {
      // An index-signature map type `{ [K]: V }` (e.g. `{[string]: i32}`). Encoded
      // as the synthetic name `"{[K]:V}"` — the emitter discriminates a map
      // annotation by that brace/bracket shape, mirroring how `i32[]` carries its
      // `[]` suffix, so no separate annotation node is needed.
      advance() // "["
      let keyName = ""
      if peekKind() == "IDENT" {
        keyName = advance().text
      } else {
        expect("IDENT")
      }
      expectClose("RBRACK")           // "]"
      expect("COLON")                 // ":"
      const valName = parseTypeName() // the value type's name (recurses for nesting)
      expectClose("RBRACE")           // "}"
      name = "{[" + keyName + "]:" + valName + "}"
      // The key is a bare identifier token, not a parsed type, so it stays text
      // on the node; the one kid is the value spelling.
      tsMk(TS_MAP, keyName, tm)
    } else {
      // An inline object type `{ x: i32, y: string }`, encoded as the synthetic name
      // `"{x:i32,y:string}"` which the checker splits back into a `TyObj`. A member may also
      // be a method (`{ toString(): string }`) — the same production, discriminated by the
      // `(` where a `:` would be. Only a bound can consume one; value position is refused.
      name = "{"
      let first = true
      let fgoing = peekKind() != "RBRACE"
      while fgoing {
        const fm = tsMark()
        let fname = ""
        if peekKind() == "IDENT" {
          fname = advance().text
        } else {
          expect("IDENT")
        }
        let ftyName = ""
        if peekKind() == "LPAREN" {
          if !first { name = name + "," }
          name = name + parseMethodMemberTail(fname, fm)
          first = false
          if peekKind() == "COMMA" {
            advance()
            fgoing = peekKind() != "RBRACE"
          } else {
            fgoing = false
          }
          continue
        }
        expect("COLON")
        ftyName = parseTypeName()
        tsMk(TS_FIELD, fname, fm)
        if !first { name = name + "," }
        name = name + fname + ":" + ftyName
        first = false
        if peekKind() == "COMMA" {
          advance()
          fgoing = peekKind() != "RBRACE"
        } else {
          fgoing = false
        }
      }
      expectClose("RBRACE")
      name = name + "}"
      tsMk(TS_OBJ, "", tm)
    }
  } else if peekKind() == "NULL" {
    advance() // `null` is a valid union member type
    name = "null"
    tsMk(TS_NULL, "null", tm)
  } else if peekKind() == "IDENT" {
    name = advance().text
    // D1045 — a block-scoped `type` name resolves here, and this is the only site that has
    // to: every type-position identifier reaches this atom, so the substitution is total by
    // the grammar rather than by a list of positions. An unbound name is returned unchanged
    // and resolves module-wide, keeping an outer `P` visible until a local one shadows it.
    const btRow = btLookup(name)
    let capt = ""
    if btRow >= 0 {
      name = btBases[btRow]
      capt = btArgs[btRow]
    }
    const head = name // the identifier alone — the name grows a `<…>` below
    if peekKind() == "LT" {
      // A generic-alias application `Box<i32>` — in type position the `<` is unambiguous,
      // since no comparison can appear here. The arguments join into the synthetic name.
      // One trailing comma before the `>` is tolerated, and `>>`/`>>>` close nested
      // applications through `expectTypeGt`.
      advance() // "<"
      name = name + "<" + parseTypeName()
      let gmore = peekKind() == "COMMA"
      while gmore {
        advance() // ","
        const gk = peekKind()
        if gk == "GT" || gk == "SHR" || gk == "USHR" || pendingGt > 0 {
          gmore = false // trailing comma — the `>` closes the list
        } else {
          name = name + "," + parseTypeName()
          gmore = peekKind() == "COMMA"
        }
      }
      expectTypeGt() // ">"
      // A body-scoped generic alias that also captured the enclosing function's
      // type parameters takes them as trailing arguments, after its own.
      if capt != "" {
        name = name + "," + capt
        btPushCaptureLeaves(capt)
      }
      name = name + ">"
      tsMk(TS_APP, head, tm)
    } else if capt != "" {
      // A body-scoped `type` naming the enclosing `T` is minted as the generic alias
      // `P$b7<T>`; every reference to it is that application.
      btPushCaptureLeaves(capt)
      name = name + "<" + capt + ">"
      tsMk(TS_APP, head, tm)
    } else {
      tsMk(TS_NAME, head, tm)
    }
  } else {
    expect("IDENT")
    // The recovery leaf for the `""` name this arm returns — pushed so the atom
    // leaves exactly one root even on a malformed annotation.
    tsMk(TS_ERR, "", tm)
  }
  let going = atTypeCont("LBRACK")
  while going {
    advance()             // "["
    expectClose("RBRACK") // "]"
    name = name + "[]"
    tsWrap(TS_ARR, "")
    going = atTypeCont("LBRACK")
  }
  name
}

// ── expressions ──────────────────────────────────────────────────────────────

// A literal / identifier / parenthesized expression. The recursion base; re-enters
// `parseExpr` inside parentheses.
function parsePrimary() {
  // The construct's start offset is the current token's char offset — captured
  // before any token is consumed so it anchors at the leading token.
  const p0 = peekTok().start
  const k = peekKind()
  if k == "NUMBER" { return mkNum(advance().text, p0) }
  if k == "STRING" { return mkStr(advance().text, p0) }
  if k == "TEMPLATE" || k == "TEMPLATE_HEAD" { return parseTemplate(p0) }
  if k == "CHAR" { return mkChar(advance().text, p0) }
  if k == "TRUE" {
    advance()
    return mkBool(1, p0)
  }
  if k == "FALSE" {
    advance()
    return mkBool(0, p0)
  }
  if k == "NULL" {
    advance()
    return mkNull("null", p0)
  }
  if k == "FUNCTION" {
    // There is no `function(...)` expression form: an anonymous function is an arrow lambda
    // `(params) => body`. A named `function f(...)` declaration is a statement, dispatched
    // by `parseStmt` before expression parsing, so a `function` token here is a misplaced
    // lambda.
    P.diags.push(
      {
        msg: "anonymous functions use arrow syntax `(params) => body`, not `function(...)`",
        at: P.pos,
      },
    )
    advance()
    return mkErr("expr", P.pos, p0)
  }
  if k == "IF" {
    // `if` as an expression (`print(if a > b { a } else { b })`) — the host's
    // `parsePrimary` dispatches `IF` to `parseIf` in expression position; the
    // same If node serves as statement and expression downstream.
    return parseIf()
  }
  if k == "MATCH" {
    // `match` is value-returning (an expression); dispatched here so it serves both
    // statement and expression position (like `if`).
    return parseMatch()
  }
  if k == "IDENT" { return mkIdent(btValueName(advance().text), p0) }
  if k == "LPAREN" {
    // `(params) => body` — an arrow lambda — when `=>` follows the matching `)`;
    // otherwise a grouped expression `(expr)`.
    if looksLikeArrowLambda() { return parseArrowLambda(p0) }
    advance()
    const brSavedP = brDepth
    brDepth = brDepth + 1
    skipNewlines() // a newline may immediately follow `(`
    const inner = parseExpr()
    skipNewlines() // …and immediately precede `)`
    brDepth = brSavedP
    expectClose("RPAREN")
    return mkParen(inner, p0)
  }
  if k == "LBRACE" {
    // A `{` in expression position is an object literal `{ name: value, ... }`.
    // (A block statement is dispatched by `parseStmt`'s `LBRACE` case before
    // any expression is parsed, so a `{` ever reaching `parsePrimary` — an
    // expression context — is unambiguously an object literal, never a block.)
    return parseObjLit()
  }
  if k == "LBRACK" {
    // A `[` in expression position is an array literal `[e, e, ...]`. (Index
    // access `a[i]` is a postfix in `parsePostfix`, where the `[` follows an
    // already-parsed expression — so a `[` reaching `parsePrimary` always starts
    // a literal.)
    return parseArrayLit()
  }
  P.diags.push(
    { msg: "expected an expression but found " + kindTag(k), at: P.pos },
  )
  advance()
  mkErr("expr", P.pos, p0)
}

// An interpolated literal, desugared here into the string concatenation it means: both
// `` `v=\{x} ok` `` and `"v=\{x} ok"` become `"v=" + <render>(x) + " ok"`, and nothing below
// asks which delimiter opened it. The desugar is here rather than a `TemplateLit` node kind
// because `nodeTyIx` is sized at `checkProgram` entry, so a later-minted node reads -1 (D969).
function parseTemplate(p0: i32) {
  const t0 = advance()
  // No hole: one `TEMPLATE` token, and the string literal it becomes keeps the
  // template's own span, so `vl fmt` reprints the author's bytes for free.
  if t0.kind == "TEMPLATE" { return mkStr(tplPartStrLex(t0.text), p0) }

  // The concat operands in order: the leading text part, then per hole a render call and,
  // unless it is empty, the text part after it. An empty part is dropped — except the
  // leading one, which stays so the result is a `string` concatenation and the root is
  // always a `+` to mark.
  const ops: i32[] = []
  ops.push(mkStr(tplPartStrLex(t0.text), -1))
  let going = true
  while going {
    const holePos = peekTok().start
    const hk = peekKind()
    let hole = -1
    if hk == "TEMPLATE_MID" || hk == "TEMPLATE_TAIL" {
      // `\{}` — the delimiters with nothing between them. Reported here rather
      // than left to "expected an expression but found TEMPLATE_TAIL", which
      // names a token the author never typed.
      P.diags.push(
        { msg: "an interpolation hole `\\{}` needs an expression", at: P.pos },
      )
      hole = mkErr("interpolation hole", P.pos, holePos)
    } else {
      hole = parseExpr()
    }
    mkTplHole(hole)
    const args: i32[] = []
    args.push(hole)
    ops.push(mkCall(mkIdent(TPL_RENDER_LOCAL, holePos), args, holePos))
    // The hole's expression must end at the closing `}` — the lexer only mints a `MID` or
    // `TAIL` there. Anything else is leftover input; skip to the next delimiter so one bad
    // hole does not swallow the rest of the file.
    let k2 = peekKind()
    if k2 != "TEMPLATE_MID" && k2 != "TEMPLATE_TAIL" && k2 != "EOF" {
      P.diags.push(
        {
          msg: "expected `}` to close the interpolation hole but found " + kindTag(k2),
          at: P.pos,
        },
      )
      while k2 != "TEMPLATE_MID" && k2 != "TEMPLATE_TAIL" && k2 != "EOF" {
        advance()
        k2 = peekKind()
      }
    }
    if k2 == "EOF" {
      // The input ran out inside the hole; the lexer already reported the
      // unterminated literal at its opening delimiter.
      going = false
    } else {
      const part = advance()
      const lex = tplPartStrLex(part.text)
      if lex != "\"\"" { ops.push(mkStr(lex, -1)) }
      if part.kind == "TEMPLATE_TAIL" { going = false }
    }
  }

  // Folded after the closing token is consumed, so every `+` anchors at it and
  // the root's `[pos, nodeEndOf)` is the template's own source span.
  let acc = ops[0]
  let i = 1
  while i < ops.length {
    if i == ops.length - 1 {
      acc = mkTplConcat(acc, ops[i], p0)
    } else {
      acc = mkBinary("+", acc, ops[i], p0)
    }
    i = i + 1
  }
  acc
}

// The per-argument names of the argument list `parseArgs` last completed ("" for
// positional), parallel to its returned values. A module global rather than a second return
// value, and safe against nesting because `parseArgs` assigns it at the end: an inner call's
// list is finished before the outer list resumes collecting into its own local.
let gCallArgNames: string[] = []

// A comma-separated argument list, already past the `(`, consuming the `)`; returns the
// argument node indices. Each argument may carry a name — `f(a: 2, b: 1)` — recognized as an
// IDENT immediately followed by a COLON. The name binds to the parameter with that name in
// the checker and emitter, not to its source position; names collect into `gCallArgNames`.
function parseArgs() {
  const args: i32[] = []
  const names: string[] = []
  const brSavedA = brDepth
  brDepth = brDepth + 1
  // An argument list may span lines and allow one trailing comma before `)`.
  skipNewlines()
  if peekKind() != "RPAREN" {
    parseOneArg(args, names)
    skipNewlines()
    // `takeSep` consumes a real `,` and inserts a missing one (`f(1 2)`), so the loop's
    // element advance lives there rather than here.
    let more = takeSep(startsExprTok(peekKind()))
    while more {
      skipNewlines()
      if peekKind() == "RPAREN" {
        more = false
      } else {
        parseOneArg(args, names)
        skipNewlines()
        more = takeSep(startsExprTok(peekKind()))
      }
    }
  }
  brDepth = brSavedA
  expectClose("RPAREN")
  gCallArgNames = names
  args
}

// One argument: an optional `name:` prefix (IDENT directly followed by COLON —
// the host's `at("ID") && peek(1).kind === "COLON"` test), then the value
// expression. Pushes the value onto `args` and the name ("" if positional)
// onto `names`.
function parseOneArg(args: i32[], names: string[]) {
  if peekKind() == "IDENT" && kindAt(P.pos + 1) == "COLON" {
    names.push(advance().text)
    advance() // COLON
    skipNewlines()
  } else {
    names.push("")
  }
  args.push(parseExpr())
  0
}

// An object literal `{ name: value, … }`, the cursor on the leading `{`. A field is
// `IDENT ":" expr`, a string key `"+": expr` (operator and index-trap fields, decoded with
// quotes stripped), a method shorthand `add(a, b) { … }`, or a bare-IDENT shorthand `{ x }`.
// `objFields` are the `FieldInit` indices in the source order the emitter binds by.
function parseObjLit() {
  const p0 = peekTok().start // the opening `{`
  expect("LBRACE")
  const brSavedO = brDepth
  brDepth = brDepth + 1
  // An object literal may span several source lines. Newlines are skipped after `{`, before
  // each field, after each field (before the `,` or `}`), after the `,`, and before the
  // closing `}`, so a field, a comma or the closer may sit on any line.
  skipNewlines()
  const fields: i32[] = []
  let going = peekKind() != "RBRACE"
  while going {
    const fp0 = peekTok().start // the field's leading token (its key)
    let name = ""
    let stringKey = false
    let badKey = false
    if peekKind() == "IDENT" {
      name = advance().text
    } else if peekKind() == "STRING" {
      // A STRING key (`"+": fn`, `"[]": fn`) names an operator / index-trap
      // field. The host uses the lexer-decoded value so the key matches the
      // operator lexeme; those keys carry no escapes, so stripping the quotes
      // is equivalent.
      const raw = advance().text
      name = raw.slice(1, raw.length - 1)
      stringKey = true
    } else {
      // A friendlier message than the generic `expect("IDENT")` ("expected IDENT
      // but found COMMA") — name what's wanted and show the offending lexeme.
      P.diags.push(
        {
          msg: "expected a field name but found `" + peekTok().text + "`",
          at: P.pos,
        },
      )
      advance()
      badKey = true
    }
    if badKey {
      // Recover from a malformed field key (e.g. a doubled comma `{ x: 1,, y }`):
      // skip to the next `,`/`}` so it yields one diagnostic ("expected IDENT …")
      // rather than a cascade of mis-parses from the leftover tokens.
      while (
        peekKind() != "COMMA" &&
        peekKind() != "RBRACE" &&
        peekKind() != "EOF"
      ) {
        advance()
      }
    } else {
      let value = -1
      if !stringKey && peekKind() == "LPAREN" {
        // Method shorthand `add(a, b) { … }` — a `(` directly after the IDENT key
        // (no `:`) marks it; the value is an anonymous function whose params /
        // return / body parse exactly as a lambda's (the host parses it via
        // `parseFunctionDeclaration` from the key token).
        const mtps: string[] = []
        value = parseFuncTail("", mtps, -1, fp0)
      } else if !stringKey && peekKind() != "COLON" {
        // Bare-IDENT shorthand `{ x }` → `{ x: x }` (the host's `parsePair` fallback).
        value = mkIdent(name, fp0)
      } else {
        expect("COLON")
        value = parseExpr()
      }
      fields.push(mkFieldInit(name, value, fp0))
    }
    skipNewlines()
    // An object literal's element starts with its key — an IDENT or a STRING
    // (`"+": fn`) — so `{x: 1 y: 2}` is a missing separator, not a missing `}`.
    if takeSep(peekKind() == "IDENT" || peekKind() == "STRING") {
      skipNewlines()
      going = peekKind() != "RBRACE"
    } else {
      going = false
    }
  }
  brDepth = brSavedO
  expectClose("RBRACE")
  mkObjLit(fields, p0)
}

// An array literal `[e, e, ...]`, the cursor on the leading `[`. Elements are
// comma-separated expressions (a trailing comma is tolerated), or empty `[]`.
// Returns an `ArrayLit` whose `arrElems` are the element node indices in source
// order — that order IS the fixed array's element order for `array.new_fixed`.
function parseArrayLit() {
  const p0 = peekTok().start // the opening `[`
  expect("LBRACK")
  const brSavedL = brDepth
  brDepth = brDepth + 1
  // A literal may span lines and allows one trailing comma before `]` — a line break is
  // insignificant until the `]`.
  skipNewlines()
  const elems: i32[] = []
  let going = peekKind() != "RBRACK"
  while going {
    elems.push(parseExpr())
    skipNewlines()
    if takeSep(startsExprTok(peekKind())) {
      skipNewlines()
      going = peekKind() != "RBRACK"
    } else {
      going = false
    }
  }
  brDepth = brSavedL
  expectClose("RBRACK")
  mkArrayLit(elems, p0)
}

// The absolute index of the `.` or `?.` a NEWLINE run at the cursor leads to, or -1 when it
// leads to anything else. Member access joins a line at every bracket depth: neither token
// can begin an expression, so there is no statement the newline could have been ending.
function chainDotAfterNewlines(): i32 {
  const j = afterNewlines()
  const k = kindAt(j)
  if k == "DOT" || k == "QUESTION_DOT" { return j }
  -1
}

// `primary` then a chain of call `(args)`, member `.name` and index `[i]` postfixes. A
// leading `.` or `?.` on a later line continues the chain — see the NEWLINE arm.
function parsePostfix() {
  // The whole postfix chain anchors at the leading token of its primary operand
  // (`f` in `f(a).b[i]`), captured before the primary is parsed.
  const p0 = peekTok().start
  let node = parsePrimary()
  let going = true
  while going {
    const k = peekKind()
    if k == "LPAREN" {
      advance()
      const args = parseArgs()
      node = mkCallN(node, args, gCallArgNames, p0)
    } else if k == "DOT" {
      advance()
      let prop = ""
      if peekKind() == "IDENT" {
        prop = advance().text
      } else {
        expect("IDENT")
      }
      node = mkMember(node, prop, p0)
    } else if k == "QUESTION_DOT" {
      // `o?.field` — null-safe member access; the checker types it as the field's
      // type re-wrapped nullable when the receiver is nullable.
      advance()
      let oprop = ""
      if peekKind() == "IDENT" {
        oprop = advance().text
      } else {
        expect("IDENT")
      }
      node = mkOptMember(node, oprop, p0)
    } else if k == "LBRACK" {
      advance()
      const brSavedI = brDepth
      brDepth = brDepth + 1
      const index = parseExpr()
      brDepth = brSavedI
      expectClose("RBRACK")
      node = mkIndex(node, index, p0)
    } else if k == "NEWLINE" {
      // A NEWLINE run whose next real token is `.` or `?.` continues this chain: skip to
      // that dot and let the loop take it next pass. Anything else ends the chain with the
      // newlines left in place, since `(` on a new line is a legal parenthesised statement.
      // Hence the look-before-consume, and hence NEWLINE only — a `;` ends the statement.
      const j = chainDotAfterNewlines()
      if j < 0 { going = false } else { P.pos = j }
    } else {
      going = false
    }
  }
  // Postfix `x++` / `x--` on an IDENT. The increment is `x = x ± 1`, but a postfix
  // expression must yield the old value, so the assignment is wrapped in a postfix `Unary`
  // (`"p+"`/`"p-"`): the emitter unwraps it to the plain assignment in statement position
  // and recovers the pre-increment value in expression position.
  const pk2 = peekKind()
  if pk2 == "PLUSPLUS" || pk2 == "MINUSMINUS" {
    const pt = P.nodes[node]
    if pt is Ident {
      advance()
      let pop = "+"
      let pfop = "p+"
      if pk2 == "MINUSMINUS" {
        pop = "-"
        pfop = "p-"
      }
      // The desugar's `1` literal has no source token (synthesized) → `-1`; the
      // assignment/unary wrappers anchor at the postfix operand's start `p0`.
      node = mkUnary(
        pfop,
        mkBinary("=", node, mkBinary(pop, node, mkNum("1", -1), p0), p0),
        p0,
      )
    } else {
      // A postfix `++`/`--` on a non-identifier (`a.b++`, `a[i]++`) isn't
      // supported: say so and consume the operator — left in the stream it
      // would silently re-parse as a prefix operator on whatever follows.
      let opTxt = "++"
      if pk2 == "MINUSMINUS" { opTxt = "--" }
      P.diags.push(
        { msg: "postfix `" + opTxt + "` target must be an identifier", at: P.pos },
      )
      advance()
    }
  }
  node
}

// Prefix `!` / `-`, else fall through to postfix, then an optional trailing type
// guard `<postfix> is TypeName` (A6). `is` binds looser than the postfix operators
// (so `n.x is A` is `(n.x) is A`) but tighter than the binary operators, matching
// its use as an `if` condition `if n is A {`. The RHS is a bare type name.
function parseUnary() {
  // The operator token (or, falling through, the operand's first token) is the
  // construct's start — captured before anything is consumed.
  const p0 = peekTok().start
  const k = peekKind()
  if k == "BANG" {
    advance()
    return mkUnary("!", parseUnary(), p0)
  }
  // Prefix `++x` / `--x` desugars to `x = x + 1` / `x = x - 1` (assignment-as-
  // expression yields the new value - the prefix semantics exactly), tagged with
  // the surface `++`/`--` so the printer reprints the prefix form (`mkPreIncr`).
  if k == "PLUSPLUS" || k == "MINUSMINUS" {
    advance()
    let incr = "++"
    if k == "MINUSMINUS" { incr = "--" }
    const itgt = parseUnary()
    return mkPreIncr(incr, itgt, p0)
  }
  if k == "MINUS" {
    advance()
    return mkUnary("-", parseUnary(), p0)
  }
  // Prefix bitwise not `~x` — flips every bit (lowered as `x ^ -1` in emit).
  if k == "TILDE" {
    advance()
    return mkUnary("~", parseUnary(), p0)
  }
  let node = parsePostfix()
  // `x as T` — an explicit numeric cast. `as` is a contextual keyword: it stays a plain
  // IDENT token and is special only here, directly after a postfix operand. It shares the
  // `is` guard's precedence slot, looser than postfix and tighter than every binary
  // operator, and is chainable. A line may lead with it, so newlines before it are skipped.
  let asAt = asAfterNewlines()
  while asAt >= 0 {
    P.pos = asAt
    advance() // `as`
    // The family's suffix (`error-handling-design.md` §Trio): `as` propagates, `as?` coalesces
    // to null, `as!` traps, `as%` wraps. Read immediately after the keyword, before the type,
    // so the happy-path grammar is identical in all four. `as !T` reads as the trap form, and
    // the `%` cannot be a remainder — a binary operator needs a left operand, and `as` took it.
    let asMode: AsMode = "prop"
    if peekKind() == "QUESTION" {
      advance()
      asMode = "null"
    } else if peekKind() == "BANG" {
      advance()
      asMode = "trap"
    } else if peekKind() == "PERCENT" {
      advance()
      asMode = "wrap"
    }
    // The cast target's spelling is recorded on the `AsExpr` node, exactly as the `is` arm
    // records its check type: the root travels in `lastTyTsRoot` and is banked immediately
    // after the node is minted, so `annTsNode` stays strictly increasing. The consumer is
    // the module merge — an `as` target may be a user alias it renames at the declaration.
    const asNm = parseAsType()
    const asRoot = lastTyTsRoot
    const asIx = mkAsExpr(node, asNm, asMode, p0)
    setAnnTs(asIx, asRoot)
    node = asIx
    asAt = asAfterNewlines()
  }
  // A line may lead with `is`, which can never begin an expression. `!is` is not in the
  // set: its `!` can, so a leading `!` stays a statement and the pair is left alone.
  const isAt = isAfterNewlines()
  if isAt >= 0 { P.pos = isAt }
  const pk = peekKind()
  // `x is T` / `x !is T` — the right side is a type, not an expression, so `x is {x: i32}`,
  // `x is A | B` and `x is null` all parse. `!is` inverts the boolean by desugaring to
  // `!(x is T)`, which the checker's narrowing already understands.
  if pk == "IS" {
    advance() // "is"
    // The check type's spelling is recorded on the `IsExpr` node (D-PARSETY P2):
    // the root must be taken from `lastTyTsRoot` before the node is minted, and
    // banked immediately after, so `annTsNode` stays strictly increasing.
    const isNm = parseIsType()
    const isRoot = lastTyTsRoot
    const isIx = mkIsExpr(node, isNm, p0)
    setAnnTs(isIx, isRoot)
    return isIx
  }
  if pk == "BANG" && kindAt(P.pos + 1) == "IS" {
    advance() // "!"
    advance() // "is"
    const ngNm = parseIsType()
    const ngRoot = lastTyTsRoot
    const ngIx = mkIsExprNeg(node, ngNm, p0)
    setAnnTs(ngIx, ngRoot)
    return mkUnary("!", ngIx, p0)
  }
  node
}

// The spelling root of the type the last string-returning type producer built. Those
// producers return a name, not a node, and their callers mint the owning node afterwards, so
// the root travels in this one-slot channel and the caller banks it on the node it just
// made. Read immediately after the call; any further type parsing overwrites it.
let lastTyTsRoot = -1

// The type on the right of `is` / `!is`, as the synthetic name string the checker resolves
// with `nameToTy`. `null` is its own one-token type; anything else is a full annotation. The
// spelling is kept and banked on the `IsExpr` node by the caller. The `null` arm builds its
// `TS_NULL` leaf directly, since the one-token type never enters `parseTypeName`.
function parseIsType() {
  if peekKind() == "NULL" {
    advance()
    lastTyTsRoot = tsLeaf(TS_NULL, "null")
    return "null"
  }
  const nm = parseTypeName()
  lastTyTsRoot = tsPop()
  nm
}

// The target type of an `x as T` cast, as a synthetic name string. A single type atom, not a
// full `parseTypeName`: a top-level `|` or `&` must stay a binary operator after the cast, so
// `a as i32 | b` is `(a as i32) | b`. The spelling is kept and banked on the `AsExpr` node by
// the caller, because a cast target may be a user alias whose declaration the merge renames.
function parseAsType() {
  const nm = parseTypeAtom()
  lastTyTsRoot = tsPop()
  nm
}

// One `type N = A | B` variant, and one `type AB = { … } & { … }` operand. A
// `UnionDecl` holds its members as a `string[]`, so a member's root cannot ride
// the single-root `annTs` table; the caller collects them and banks the list on
// the `UnionDecl` node (`setUdTs`) once the node exists. D-PARSETY P2.
function parseVariantName() {
  const nm = parseTypeIsect()
  lastTyTsRoot = tsPop()
  nm
}

function parseVariantAtom() {
  const nm = parseTypeAtom()
  lastTyTsRoot = tsPop()
  nm
}

// Precedence climbing from `minPrec`, seeded by an already-parsed `left`. A
// binary expression anchors at its left operand's start offset (`leftPos`, the
// char offset of `left`'s first token) — every node built here carries it, so
// `a + b * c` and its `b * c` subtree both point at their own leftmost token.
function parseBinary(left: i32, minPrec: i32, leftPos: i32) {
  let acc = left
  let going = true
  while going {
    let k = peekKind()
    // A NEWLINE run leading to an operator that cannot begin an expression is whitespace,
    // not a terminator, so the continuation line may lead with that operator (`continuesLine`
    // owns the set). Look-before-consume, like `chainDotAfterNewlines`: a run leading
    // anywhere else is left in place for the caller.
    if k == "NEWLINE" {
      const jb = binOpAfterNewlines()
      if jb >= 0 {
        P.pos = jb
        k = peekKind()
      }
    }
    const prec = binPrec(k)
    if prec == 0 || prec < minPrec {
      going = false
    } else {
      const opTok = P.pos // the operator token (anchors the mixing diagnostic)
      const opText = advance().text
      // A binary operator at the end of a line continues onto the next, so a NEWLINE or
      // SEMI may sit between the operator and the right operand. Skip it: the operator
      // already commits the expression to continue, so the line break is not a statement
      // terminator, which is what lets a long `+`-concatenation break across lines.
      skipNewlines()
      let nextMin = prec + 1
      if rightAssoc(k) { nextMin = prec }
      const rightPos = peekTok().start // the right operand's leading token
      const right = parseBinary(parseUnary(), nextMin, rightPos)
      if k == "PLUSEQ" || k == "MINUSEQ" || k == "STAREQ" || k == "SLASHEQ" {
        // `a += b` desugars to `a = a + (b)` (the host's ARITH_ASSIGN_OPS), tagged
        // with the surface op so the printer reprints `a += b` (see `mkCompoundAssign`).
        acc = mkCompoundAssign(opText.slice(0, 1), acc, right, leftPos)
      } else {
        // `??` never shares an unparenthesized operand chain with `||` or `&&`: they sit on
        // one precedence tier here, so `a ?? b || c` would group left to right, a coin flip
        // for the reader. A `Paren` operand is explicit grouping; only a direct `BinExpr`
        // operand of the other family trips the error.
        const mixed = coalesceMixOp(opText, acc, right)
        if mixed != "" {
          P.diags.push(
            {
              msg: "unparenthesized `??` mixed with `" +
                mixed +
                "` — add parentheses to make the grouping explicit",
              at: opTok,
            },
          )
        }
        acc = mkBinary(opText, acc, right, leftPos)
      }
    }
  }
  acc
}

// The `binOp` of node `ix` when it is a (non-parenthesized) binary expression, else "".
function binOpOf(ix: i32) {
  if ix >= 0 && ix < P.nodes.length {
    const n = P.nodes[ix]
    if n is BinExpr { return n.binOp }
  }
  ""
}

// Building `l op r`: does the coalesce-versus-logical mixing rule fire? Returns the
// conflicting operator's text for the diagnostic, or "" when the mix is fine. The rule's
// vocabulary is closed — `??`, `||`, `&&` — and every binary node reaches this, so it
// dismisses by width and first character before comparing a lexeme.
function coalesceMixOp(op: string, l: i32, r: i32) {
  if op.length < 2 { return "" }
  const c0 = op[0]
  if c0 == '?' {
    if op != "??" { return "" }
    const lo = binOpOf(l)
    if lo == "||" || lo == "&&" { return lo }
    const ro = binOpOf(r)
    if ro == "||" || ro == "&&" { return ro }
    return ""
  }
  if c0 == '|' || c0 == '&' {
    if op != "||" && op != "&&" { return "" }
    if binOpOf(l) == "??" { return op }
    if binOpOf(r) == "??" { return op }
  }
  ""
}

// The expression entry point: a unary operand, then binary precedence climbing
// from the lowest level (assignment).
export function parseExpr() {
  const p0 = peekTok().start
  parseBinary(parseUnary(), 1, p0)
}

// ── statements ───────────────────────────────────────────────────────────────

// `("let" | "const") IDENT (":" type)? ("=" expr)?`
function parseLet() {
  const p0 = peekTok().start // the `let`/`const` keyword
  const kw = advance().text  // "let" or "const"
  let name = ""
  let nameTok = -1
  if peekKind() == "IDENT" {
    nameTok = P.pos // the name token's index (consumed next)
    name = advance().text
  } else {
    expect("IDENT")
  }
  let ty = -1
  if accept("COLON") { ty = parseType() }
  let init = -1
  if accept("EQUAL") { init = parseExpr() }
  const ix = mkLet(kw, name, ty, init, p0)
  mkDeclNameTok(ix, nameTok)
  ix
}

// A struct type declaration `type N = { field: type, … }`; fields are comma-separated with a
// tolerated trailing comma, and `tdFields` are the `FieldDef` indices in order. `flatAt` is
// the source offset of a preceding `flat` modifier, or -1, and doubles as the declaration's
// position: the formatter reprints from a verbatim slice at `pos`, which would drop `flat`.
function parseTypeDecl(flatAt: i32) {
  let p0 = peekTok().start // the `type` keyword
  if flatAt >= 0 { p0 = flatAt }
  const isFlat = flatAt >= 0
  advance()                // "type"
  let name = ""
  let nameTok = -1
  if peekKind() == "IDENT" {
    nameTok = P.pos
    name = advance().text
  } else {
    expect("IDENT")
  }
  // Generic alias parameters `type Box<T> = …`. The names fold into the declared name
  // (`Box<T>`), and are also kept: the base name and the parameter list are banked on the
  // declaration node by every `mkTypeDecl`/`mkUnionDecl` exit below. `gpBase` doubles as the
  // "did a `<` follow" marker — "" for a non-generic declaration, which records nothing.
  let gpBase = ""
  const gpNames: string[] = []
  if peekKind() == "LT" {
    advance() // "<"
    gpBase = name
    name = name + "<"
    let tfirst = true
    let tgoing = peekKind() == "IDENT"
    while tgoing {
      if !tfirst { name = name + "," }
      const tpn = advance().text
      name = name + tpn
      gpNames.push(tpn)
      tfirst = false
      if peekKind() == "COMMA" {
        advance()
        tgoing = peekKind() == "IDENT"
      } else {
        tgoing = false
      }
    }
    expectClose("GT") // ">"
    name = name + ">"
  }
  // D1045 — a body-scoped declaration is minted unique, and the scope row goes in before the
  // body is parsed. `btDepth > 0` is "inside a block", the parser's own nesting rather than a
  // list of positions. The row is pushed here so a recursive local type resolves its own
  // name, and popped by the enclosing block's `btTrimTo`, not here.
  btPendingBase = ""
  if btDepth > 0 {
    let srcName = name
    if gpBase != "" { srcName = gpBase }
    btSeq = btSeq + 1
    const mangled = srcName + "$b" + i32ToStr(btSeq)
    const caps = btCaptureScan()
    if caps.length > 0 || gpBase != "" {
      // Declared generic, or made generic by capture: the captured parameters are
      // appended after the declaration's own, which is the order every reference
      // spells them in (`parseTypeAtom`).
      let ci = 0
      while ci < caps.length {
        gpNames.push(caps[ci])
        ci = ci + 1
      }
      gpBase = mangled
      name = mangled + "<"
      let ni = 0
      while ni < gpNames.length {
        if ni > 0 { name = name + "," }
        name = name + gpNames[ni]
        ni = ni + 1
      }
      name = name + ">"
    } else {
      name = mangled
    }
    btNames.push(srcName)
    btBases.push(mangled)
    btArgs.push(btCaptureText(caps))
    btIsNew.push(false)
    btPendingBase = mangled
  }
  // A bodyless `type Bar` is reported once, at the declaration, instead of cascading
  // "expected EQUAL" from mis-parsing the following line as the body. Recovery is a sentinel
  // `TypeDecl` (`tdFields == [-1]`) the checker registers as an error type, so the use site
  // does not cascade either.
  const eqHere = peekKind() == "EQUAL"
  if !eqHere {
    P.diags.push(
      {
        msg: "A type alias requires a body; write `type " +
          name +
          " = …` to define `" +
          name +
          "`",
        at: nameTok,
      },
    )
    const bodyless: i32[] = []
    bodyless.push(-1)
    const blix = mkTypeDecl(name, bodyless, p0, 0, 0)
    if gpBase != "" { setDeclGp(blix, gpBase, gpNames) }
    mkDeclNameTok(blix, nameTok)
    btNoteDecl(blix)
    return blix
  }
  expect("EQUAL")
  // A nominal newtype: `type EntityId = new i32` declares a type distinct from its body in
  // the checker and erased at emit. `new` is a contextual keyword recognized only here, one
  // token of lookahead, so it stays a legal identifier everywhere else. The guard is the
  // second token: `type N = new` alone still means an alias of the type named `new`.
  let isNew = 0
  if peekKind() == "IDENT" {
    if peekTok().text == "new" {
      const k2 = peek2Kind()
      if k2 == "IDENT" || k2 == "LBRACE" || k2 == "LPAREN" {
        advance()
        isNew = 1
      }
    }
  }
  // D1045: mark the scope row as having a value-position spelling, so a `TV.size`
  // fold renames with its annotation (`btValueName`). Read here rather than at the
  // push because `new` sits after the `=`, and the row has to exist before the
  // body is parsed.
  if btPendingBase != "" && (isNew == 1 || isFlat) {
    if btIsNew.length > 0 { btIsNew[btIsNew.length - 1] = true }
  }
  // `type N = A | B | C` — a discriminated-union alias, parsed as `member (PIPE member)*`
  // into a `UnionDecl`; a single bare name is a one-member union. A `{`-leading right side is
  // the struct body below, except an index-signature map (`{[K]: V}`), whose `{` opens a map.
  // The lookahead is exactly `parseTypeAtom`'s, so the two grammars cannot disagree.
  const afterEq = peekKind()
  if afterEq != "LBRACE" || peek2Kind() == "LBRACK" {
    const variants: string[] = []
    // Each member's spelling root, in member order (D-PARSETY P2) — banked on
    // the `UnionDecl` node below, once it exists.
    const vroots: i32[] = []
    variants.push(parseVariantName())
    vroots.push(lastTyTsRoot)
    // A multiline union puts each `|` on its own line, so newlines are skipped before
    // testing for the pipe. `endTok` pins the cursor just past the last variant so the
    // trailing skip does not stretch the declaration's end token onto a following blank or
    // comment line, which would make the formatter's verbatim slice swallow it.
    let endTok = P.pos
    skipNewlines()
    let more = peekKind() == "PIPE"
    while more {
      advance()      // "|"
      skipNewlines() // and after it, before the variant name
      variants.push(parseVariantName())
      vroots.push(lastTyTsRoot)
      endTok = P.pos
      skipNewlines()
      more = peekKind() == "PIPE"
    }
    P.pos = endTok
    if isFlat { flatNeedsRecord(name, nameTok) }
    const uix = mkUnionDecl(name, variants, p0, isNew)
    setUdTs(uix, vroots)
    if gpBase != "" { setDeclGp(uix, gpBase, gpNames) }
    mkDeclNameTok(uix, nameTok)
    btNoteDecl(uix)
    return uix
  }
  expect("LBRACE")
  const fields: i32[] = []
  // `synth` mirrors the field list as the inline-object synthetic name
  // (`{a:i32,b:i32}`), so a `{ … } & …` / `{ … } | …` continuation can
  // re-encode the whole RHS as a UnionDecl alias without re-parsing.
  let synth = ""
  // The field names and their type spelling roots, kept for the `{ … } & … | …` re-encode
  // below: that path's first union member is the synthetic `{…}` text, assembled from this
  // list rather than returned by a type producer, so its spelling tree is assembled the same
  // way. Nothing is built unless the continuation fires.
  const fNames: string[] = []
  const fRoots: i32[] = []
  // Every member in source order — the bound body, assembled into a spelling tree below and
  // only if a method member appears, so an ordinary `type X = { … }` mints no node. A
  // separate column from `fRoots`, which is the field list for the `& … | …` re-encode; a
  // method member contributes no field.
  const mNames: string[] = []
  const mRoots: i32[] = []
  const mIsMethod: boolean[] = []
  let sawMethod = false
  skipNewlines() // a multiline `{` puts the first field on the next line
  let going = peekKind() != "RBRACE"
  while going {
    const fp0 = peekTok().start // the field's name token
    let fname = ""
    if peekKind() == "IDENT" { fname = advance().text } else { expect("IDENT") }
    // A method member (`toString(): string`) — the same production `parseTypeAtom`'s inline
    // object arm reads, so the two spellings of one bound cannot drift. It declares a call,
    // not a field, so it pushes no `FieldDef`: the declaration is minted with the fields it
    // has and the whole body travels as the bound annotation assembled below.
    if peekKind() == "LPAREN" {
      const mm = tsMark()
      if synth != "" { synth = synth + "," }
      synth = synth + parseMethodMemberTail(fname, mm)
      mNames.push(fname)
      mRoots.push(tsPop())
      mIsMethod.push(true)
      sawMethod = true
      skipNewlines()
      if peekKind() == "COMMA" {
        advance()
        skipNewlines()
        going = peekKind() != "RBRACE"
      } else {
        going = false
      }
      continue
    }
    expect("COLON")
    const typ0 = peekTok().start // the field type's leading token
    const ftyName = parseTypeName()
    const froot = tsPop()
    const ftyIx = mkTypeRef(ftyName, typ0)
    setAnnTs(ftyIx, froot)
    fields.push(mkFieldDef(fname, ftyIx, fp0))
    fNames.push(fname)
    fRoots.push(froot)
    mNames.push(fname)
    mRoots.push(froot)
    mIsMethod.push(false)
    if synth != "" { synth = synth + "," }
    synth = synth + fname + ":" + ftyName
    skipNewlines()               // a field may be followed by a NEWLINE before the `,`/`}`
    if peekKind() == "COMMA" {
      advance()
      skipNewlines() // and the `,` by a NEWLINE before the next field / `}`
      going = peekKind() != "RBRACE"
    } else {
      going = false
    }
  }
  expectClose("RBRACE")
  // A bound alias — `type Showable = { toString(): string }`. A body with a method member
  // declares a call contract, not a layout, so it exits here rather than continuing into the
  // struct, `&` and `|` machinery, none of which composes with it. What is minted is an
  // empty-field `TypeDecl` plus the whole body as one object annotation on `declBound*`.
  if sawMethod {
    if (
      atTypeCont("LBRACK") ||
      peekKind() == "AMPERSAND" ||
      peekKind() == "PIPE"
    ) {
      P.diags.push(
        {
          msg: "a bound (a type with method members) cannot be combined with `&`, `|` or `[]` — it constrains a type parameter and has no values of its own",
          at: P.pos,
        },
      )
    }
    const bKids: i32[] = []
    let bk = 0
    while bk < mRoots.length {
      if mIsMethod[bk] {
        bKids.push(mRoots[bk])
      } else {
        const oneKid: i32[] = []
        oneKid.push(mRoots[bk])
        bKids.push(tsMkKids(TS_FIELD, mNames[bk], oneKid))
      }
      bk = bk + 1
    }
    const bRoot = tsMkKids(TS_OBJ, "", bKids)
    const bAnn = mkTypeRef("{" + synth + "}", p0)
    setAnnTs(bAnn, bRoot)
    const noFields: i32[] = []
    if isFlat { flatNeedsRecord(name, nameTok) }
    const bix = mkTypeDecl(name, noFields, p0, isNew, 0)
    setDeclBound(bix, bAnn)
    if gpBase != "" { setDeclGp(bix, gpBase, gpNames) }
    mkDeclNameTok(bix, nameTok)
    btNoteDecl(bix)
    return bix
  }
  // D188 — an array suffix on a `{ … }` body: `type L = {n: i32}[]` reaches here with `[`
  // `]` still on the stream and, unclaimed, would complete as the plain struct `{n: i32}`.
  // It is consumed here rather than in a continuation arm because it binds tighter than `&`
  // and `|`, and no newline is skipped ahead of it — a `[` on the next line is a statement.
  let arrSuffix = 0
  let asGoing = atTypeCont("LBRACK")
  while asGoing {
    advance()             // "["
    expectClose("RBRACK") // "]"
    arrSuffix = arrSuffix + 1
    asGoing = atTypeCont("LBRACK")
  }
  // Object-type structural intersection `type AB = { … } & { … }`, or a union whose first
  // variant is an inline object: the struct body is only the first operand. The right side
  // re-encodes as a `UnionDecl` over synthetic names, which `nameToTy` folds. Newlines are
  // skipped before testing for the continuation and the cursor restored when none follows.
  const afterBrace = P.pos
  skipNewlines()
  if arrSuffix > 0 || peekKind() == "AMPERSAND" || peekKind() == "PIPE" {
    let first = "{" + synth + "}"
    // The same object, as a spelling: a `TS_FIELD` per field over the type root the field
    // already recorded, under one `TS_OBJ`. `tsToName` renders it back to exactly
    // `"{" + synth + "}"`, the same concatenations `synth` is built by.
    const fkids: i32[] = []
    let fk = 0
    while fk < fNames.length {
      const oneKid: i32[] = []
      oneKid.push(fRoots[fk])
      fkids.push(tsMkKids(TS_FIELD, fNames[fk], oneKid))
      fk = fk + 1
    }
    let firstRoot = tsMkKids(TS_OBJ, "", fkids)
    // …and the `[]`s the suffix loop counted, appended to the synthetic name and wrapped
    // around the spelling root in the same order `parseTypeAtom` uses, so `tsToName` renders
    // this member back to exactly the characters `first` holds. Off-stack, because the root
    // is already popped.
    let asLeft = arrSuffix
    while asLeft > 0 {
      first = first + "[]"
      const arrKid: i32[] = []
      arrKid.push(firstRoot)
      firstRoot = tsMkKids(TS_ARR, "", arrKid)
      asLeft = asLeft - 1
    }
    let igoing = peekKind() == "AMPERSAND"
    // The `&` operands join the object under a `TS_ISECT`, mirroring the `"&"`
    // the name is built with.
    const iKids: i32[] = []
    iKids.push(firstRoot)
    while igoing {
      advance() // "&"
      first = first + "&" + parseVariantAtom()
      iKids.push(lastTyTsRoot)
      igoing = peekKind() == "AMPERSAND"
    }
    if iKids.length > 1 { firstRoot = tsMkKids(TS_ISECT, "", iKids) }
    const variants: string[] = []
    const vroots2: i32[] = []
    variants.push(first)
    vroots2.push(firstRoot)
    // Pin the end-token past the last variant (see the sibling union path) so a
    // trailing newline-skip cannot stretch the decl span onto a following line.
    let endTok2 = P.pos
    skipNewlines()
    let umore = peekKind() == "PIPE"
    while umore {
      advance() // "|"
      skipNewlines()
      variants.push(parseVariantName())
      vroots2.push(lastTyTsRoot)
      endTok2 = P.pos
      skipNewlines()
      umore = peekKind() == "PIPE"
    }
    P.pos = endTok2
    if isFlat { flatNeedsRecord(name, nameTok) }
    const u2ix = mkUnionDecl(name, variants, p0, isNew)
    setUdTs(u2ix, vroots2)
    if gpBase != "" { setDeclGp(u2ix, gpBase, gpNames) }
    mkDeclNameTok(u2ix, nameTok)
    btNoteDecl(u2ix)
    return u2ix
  }
  P.pos = afterBrace
  let flatMark = 0
  if isFlat { flatMark = 1 }
  const tdix = mkTypeDecl(name, fields, p0, isNew, flatMark)
  if gpBase != "" { setDeclGp(tdix, gpBase, gpNames) }
  mkDeclNameTok(tdix, nameTok)
  btNoteDecl(tdix)
  tdix
}

// `flat` on a body that is not a `{ … }` record. Reported here, at the syntactic fork that
// decides the declaration form, because that is where the fact is: a scalar alias, a union
// and an intersection have no layout, so there is nothing to measure and no reason to carry
// the marker onto a `UnionDecl`. Recovery is total — it parses as the ordinary alias.
function flatNeedsRecord(name: string, nameTok: i32) {
  P.diags.push(
    {
      msg: "a `flat` type needs a record body — write `flat type " +
        name +
        " = { field: i32, … }`, or drop `flat`",
      at: nameTok,
    },
  )
  0
}

// `"?" ":" type` — the optional-parameter annotation, desugared here to `T | null`. The `?`
// is pure surface, so one mechanism serves both spellings. The synthetic name and the
// spelling tree are built together, because `tsToName(annTsOf(ix))` must reproduce
// `TypeRef.tyName` exactly: the root is re-parented under a `TS_UNION` beside a `TS_NULL`.
function parseOptionalParamType(name: string) {
  const p0 = peekTok().start
  const nm = parseTypeName()
  const inner = tsPop()
  // A function type would need grouping parens to survive the `| null` suffix
  // (`((i32) => i32) | null` — bare, the trailing union binds into the result),
  // and `?` has no place to put them. Reject rather than mint a name whose
  // spelling tree and text disagree.
  if inner >= 0 && inner < tsKind.length {
    if tsKind[inner] == TS_FUNC {
      P.diags.push(
        {
          msg: "`?` does not apply to a function type — write `" +
            name +
            ": ((…) => …) | null = null`",
          at: P.pos,
        },
      )
    }
  }
  const kids: i32[] = []
  kids.push(inner)
  kids.push(tsLeaf(TS_NULL, "null"))
  const ix = mkTypeRef(nm + "|null", p0)
  setAnnTs(ix, tsMkKids(TS_UNION, "", kids))
  ix
}

// `IDENT "?"? (":" type)? ("=" expr)?` — two surface spellings, one mechanism. `a?: T` is
// sugar for `a: T | null = null`, desugared right here, so `parType` already carries the
// `| null` and only `parOpt` records which form the author wrote. A default is filled in at
// each direct call site that omits the argument, so it is evaluated in the caller's frame.
function parseParam() {
  const p0 = peekTok().start // the parameter's name token
  let name = ""
  let nameTok = -1
  if peekKind() == "IDENT" {
    nameTok = P.pos
    name = advance().text
  } else {
    expect("IDENT")
  }
  const opt = accept("QUESTION")
  let ty = -1
  let dflt = -1
  if accept("COLON") {
    if opt {
      ty = parseOptionalParamType(name)
      dflt = mkNull("null", p0)
    } else {
      ty = parseType()
    }
  } else if opt {
    P.diags.push(
      {
        msg: "an optional parameter needs a type — write `" + name + "?: T`",
        at: P.pos,
      },
    )
  }
  if accept("EQUAL") {
    const d = parseExpr()
    if opt {
      // `a?: T = e` spells the same thing twice and disagrees about the value.
      P.diags.push(
        {
          msg: "`?` already means `= null` — write `" +
            name +
            ": T | null = e` for a different default",
          at: P.pos,
        },
      )
    } else {
      dflt = d
    }
  }
  let optMark = 0
  if opt { optMark = 1 }
  const ix = mkParam(name, ty, dflt, optMark, p0)
  mkDeclNameTok(ix, nameTok)
  ix
}

// `"(" params? ")"` — the parameter list shared by every function form and the arrow lambda,
// the cursor on the `(`. A signature may span several source lines: newlines are skipped
// after `(`, around each `,` and before `)`, so the list tolerates line breaks anywhere a
// separator may appear. A trailing comma before `)` is allowed.
function parseParamList() {
  expect("LPAREN")
  skipNewlines()
  const params: i32[] = []
  if peekKind() != "RPAREN" {
    params.push(parseParam())
    skipNewlines()
    // A parameter's element start is its name, so `function f(a: i32 b: i32)` is
    // a missing separator; `takeSep` inserts it and consumes a real `,`.
    let more = takeSep(peekKind() == "IDENT")
    while more {
      skipNewlines()
      // Trailing comma: a `,` immediately before `)` closes the list.
      if peekKind() == "RPAREN" {
        more = false
      } else {
        params.push(parseParam())
        skipNewlines()
        more = takeSep(peekKind() == "IDENT")
      }
    }
  }
  expectClose("RPAREN")
  params
}

// Parse a function body and build the `FuncDecl`, the cursor on the body's first token. The
// body is a bare expression (implicit return, wrapped in a one-statement `Block`), empty
// braces (a block, never an empty object), braces that shape up as an object literal (an
// implicit-return expression), or a braced statement block. `funcPos` is the form's start.
function parseFuncBodyAndBuild(
  name: string,
  typarams: string[],
  params: i32[],
  ret: i32,
  nameTok: i32,
  funcPos: i32,
) {
  // A bare-expression body (`function dbl(x: i32) x * 2`) is a single expression with an
  // implicit return, wrapped in a synthetic one-statement `Block`; empty braces stay a block.
  // D1045 — the body's live type parameters are pushed here rather than in `parseFuncHead`,
  // because this is the one entry every body goes through and the signature is already parsed.
  const btTpSaved = btTyParams.length
  let tpi = 0
  while tpi < typarams.length {
    btTyParams.push(typarams[tpi])
    tpi = tpi + 1
  }
  if peekKind() != "LBRACE" {
    const e = parseExpr()
    const stmts: i32[] = []
    stmts.push(e)
    // The wrapper Block is synthesized (no `{` source token) → `-1`; the
    // FuncDecl anchors at the function form's start.
    const bix = mkFunc(name, typarams, params, ret, mkBlock(stmts, -1), funcPos)
    mkDeclNameTok(bix, nameTok)
    btTyParamsTrimTo(btTpSaved)
    return bix
  }
  let scan = P.pos + 1
  let snl = kindAt(scan) == "NEWLINE"
  while snl {
    scan = scan + 1
    snl = kindAt(scan) == "NEWLINE"
  }
  const emptyBraces = kindAt(scan) == "RBRACE"
  if !emptyBraces && looksLikeObject(P.pos) {
    const oe = parseExpr()
    const ostmts: i32[] = []
    ostmts.push(oe)
    const oix = mkFunc(
      name,
      typarams,
      params,
      ret,
      mkBlock(ostmts, -1),
      funcPos,
    )
    mkDeclNameTok(oix, nameTok)
    btTyParamsTrimTo(btTpSaved)
    return oix
  }
  const body = parseBlock()
  const fix = mkFunc(name, typarams, params, ret, body, funcPos)
  mkDeclNameTok(fix, nameTok)
  btTyParamsTrimTo(btTpSaved)
  fix
}

// The shared tail of every `function`-keyword form — the cursor on the `(` of the
// param list. Parses `"(" params? ")" (":" type)? body` and builds the `FuncDecl`.
// `funcPos` is the function form's start offset (the `function` keyword, or the
// method-shorthand key) — captured by the caller and stamped on the FuncDecl.
function parseFuncTail(
  name: string,
  typarams: string[],
  nameTok: i32,
  funcPos: i32,
) {
  const params = parseParamList()
  // An index-operator declaration is named for its receiver as well as its operator, so
  // several may coexist (`ast.opDeclName`). The receiver is the `self` parameter, which is
  // why the mint waits for the parameter list.
  let dname = name
  if name == OP_INDEX_GET || name == OP_INDEX_SET {
    dname = indexOpDeclName(name, params, nameTok)
  }
  // D444 — the arity of a non-index operator declaration. Operator dispatch is binary and
  // only binary: `checkBinary`'s `opSelfFnTy` returns -1 unless the declaration is exactly
  // `(self, other)`, so a declaration at any other arity can never fire and no call can be
  // written for it. Reported here because arity is syntactic.
  if isBinOpFuncName(name) {
    if params.length != 2 {
      P.diags.push(
        {
          msg: "operator `" +
            name +
            "` takes 2 parameters (self, other), got " +
            i32ToStr(params.length) +
            " — operator dispatch is binary only, so this declaration could never fire",
          at: nameTok,
        },
      )
    } else {
      // D471 — at the right arity, `opSelfFnTy` still returns -1 unless the first parameter
      // is named `self`, before it consults any type, so an arity-2 declaration whose first
      // parameter is named anything else is inert at every receiver. A reject and not an open
      // question: there is no call syntax at any arity. Syntactic, so it belongs here.
      const bp0 = P.nodes[params[0]]
      if bp0 is Param {
        if bp0.parName != "self" {
          P.diags.push(
            {
              msg: "operator `" +
                name +
                "`'s first parameter must be named `self`, got `" +
                bp0.parName +
                "` — operator dispatch binds the LEFT operand to `self`, so this declaration could never fire",
              at: nameTok,
            },
          )
        }
      }
    }
  }
  let ret = -1
  if accept("COLON") { ret = parseType() }
  parseFuncBodyAndBuild(dname, typarams, params, ret, nameTok, funcPos)
}

// The minted declaration name for an index-operator function — the operator plus the `self`
// parameter's annotation spelling. The annotation is required: the operator dispatches on the
// receiver's type, and an un-annotated `self` is an inference hole that would accept every
// receiver, which is both an unmintable name and a dispatch nobody could predict.
function indexOpDeclName(op: string, params: i32[], nameTok: i32) {
  let recv = ""
  if params.length > 0 {
    const p0 = P.nodes[params[0]]
    if p0 is Param {
      if p0.parName == "self" {
        if p0.parType >= 0 {
          const tr = P.nodes[p0.parType]
          if tr is TypeRef { recv = tr.tyName }
        }
      }
    }
  }
  if recv == "" {
    P.diags.push(
      {
        msg: "an index operator needs an annotated `self` parameter — write `function \"" +
          op +
          "\"(self: T, …)` (the receiver TYPE is what it dispatches on)",
        at: nameTok,
      },
    )
    return op
  }
  opDeclName(op, recv)
}

// Lookahead from a `(` in expression position: is this an arrow-lambda parameter list rather
// than a grouped expression? Scan to the `)` that matches the opening `(` and test whether
// `=>` or a return-type `:` immediately follows. A grouped expression's `)` is never followed
// by either, so this is unambiguous. The cursor stays put — pure lookahead.
function looksLikeArrowLambda() {
  let depth = 0
  let i = P.pos
  let scanning = true
  while scanning {
    const t = kindAt(i)
    if t == "LPAREN" {
      depth = depth + 1
    } else if t == "RPAREN" {
      depth = depth - 1
      if depth == 0 { scanning = false }
    } else if t == "EOF" {
      return false
    }
    if scanning { i = i + 1 }
  }
  // `i` indexes the matching `)`. A lambda iff `=>` immediately follows, or a `:`
  // opens a return-type annotation (which `parseArrowLambda` consumes before `=>`).
  if kindAt(i + 1) == "COLON" { return true }
  kindAt(i + 1) == "EQUAL" && kindAt(i + 2) == "GT"
}

// `"(" params? ")" (":" type)? "=>" body` — an arrow lambda: anonymous, with an optional
// return annotation that parses into `fnRet` exactly like a `function`-form return type. It
// parses to the same nameless `FuncDecl`, so the checker and emitter treat the two forms
// identically. `p0` is the `(`'s offset, stamped on the node.
function parseArrowLambda(p0: i32) {
  const params = parseParamList()
  let ret = -1
  if accept("COLON") { ret = parseType() }
  expect("EQUAL") // the `=` of `=>`
  expect("GT")    // the `>` of `=>`
  const noTyParams: string[] = []
  parseFuncBodyAndBuild("", noTyParams, params, ret, -1, p0)
}

// The operator tokens a function name may be (`function +(self, b)` — a free operator
// function; `a + b` on user objects dispatches to it). Mirrors the host's
// `OPERATOR_FUNC_NAMES` set.
function isOpFuncName(kind: TokKind) {
  kind == "PLUS" ||
    kind == "MINUS" ||
    kind == "STAR" ||
    kind == "SLASH" ||
    kind == "PERCENT" ||
    kind == "CARET" ||
    kind == "GT" ||
    kind == "GE" ||
    kind == "LT" ||
    kind == "LE" ||
    kind == "EQ" ||
    kind == "NE"
}

// The operator names a quoted function name may spell — `isBinOpFuncName`'s
// symbol-token set (`ast.vl`) plus the two bracket operators, which have no token
// spelling at all.
function isStrFuncName(name: string) {
  name == OP_INDEX_GET ||
    name == OP_INDEX_SET ||
    name == "+" ||
    name == "-" ||
    name == "*" ||
    name == "/" ||
    name == "%" ||
    name == "^" ||
    name == ">" ||
    name == ">=" ||
    name == "<" ||
    name == "<=" ||
    name == "==" ||
    name == "!="
}

// `"function" IDENT? "<" typarams? ">" …tail` — the shared head of the two
// `function`-keyword forms: an optional name (an identifier, an operator symbol,
// or a quoted operator; required for a declaration, optional for an expression),
// optional generic type parameters, then the common `parseFuncTail`.
function parseFuncHead(requireName: boolean) {
  const p0 = peekTok().start // the `function` keyword
  advance()                  // "function"
  let name = ""
  let nameTok = -1
  if peekKind() == "IDENT" {
    nameTok = P.pos
    name = advance().text
  } else if isOpFuncName(peekKind()) {
    // An operator-symbol name (`function +(self, b)`); checked after the IDENT
    // case, so `function <(a, b)` reads the `<` as the name (host order).
    nameTok = P.pos
    name = advance().text
  } else if peekKind() == "STRING" {
    // A string-literal operator name (`function "[]"(self: V, i: i32)`). This is the only
    // spelling the bracket operators have — `[` and `]` open an index expression everywhere
    // else — and it is the same spelling their closure-field form uses. The symbol-token
    // operators accept it too, so `function "+"` and `function +` name the same function.
    nameTok = P.pos
    // A token's `text` is its raw source span, so strip the quotes — the same
    // equivalence the STRING object-literal key relies on (an operator lexeme
    // carries no escapes).
    const rawName = advance().text
    name = rawName.slice(1, rawName.length - 1)
    if !isStrFuncName(name) {
      P.diags.push(
        {
          msg: "a quoted function name must be an operator (" +
            OP_INDEX_GET +
            ", " +
            OP_INDEX_SET +
            ", +, -, *, /, %, ^, <, <=, >, >=), not \"" +
            name +
            "\"",
          at: nameTok,
        },
      )
    }
  } else if requireName {
    expect("IDENT")
  }
  // D46 — `==` and `!=` are not overloadable, and this is the one place both spellings
  // converge, so one test covers the symbol-token arm and the quoted arm. Rejected rather
  // than implemented because the refusal's own customer is a container, whose compare
  // recurses through three cores with no per-element dispatch hook.
  if name == "==" || name == "!=" {
    P.diags.push(
      {
        msg: "`" +
          name +
          "` is not overloadable — every type compares structurally, and a `function \"" +
          name +
          "\"` declaration would be ignored",
        at: nameTok,
      },
    )
  }
  // Generic type parameters `<T, U>` — declaration position only, so there is no ambiguity
  // with the `<` comparison. A parameter may carry a bound (`<T: Showable>`), parsed by the
  // ordinary annotation producer so an alias name, an inline object and a method-member
  // literal all arrive the same way. Bounds are banked against the `FuncDecl` once it exists.
  const typarams: string[] = []
  const tpBoundIxs: i32[] = []
  const tpBoundAnns: i32[] = []
  if peekKind() == "LT" {
    advance() // "<"
    let tgoing = peekKind() == "IDENT"
    while tgoing {
      typarams.push(advance().text)
      if peekKind() == "COLON" {
        advance() // ":"
        tpBoundIxs.push(typarams.length - 1)
        tpBoundAnns.push(parseType())
      }
      if peekKind() == "COMMA" {
        advance()
        tgoing = peekKind() == "IDENT"
      } else {
        tgoing = false
      }
    }
    expectClose("GT") // ">"
  }
  parseFuncTailBounded(name, typarams, tpBoundIxs, tpBoundAnns, nameTok, p0)
}

// `parseFuncTail`, plus the bound bank. Split so the four other `parseFuncTail`
// callers (lambdas, methods, the flat forms) keep their signature: none of them
// can carry a `<T: B>` list, so none of them has a bank to write.
function parseFuncTailBounded(
  name: string,
  typarams: string[],
  tpBoundIxs: i32[],
  tpBoundAnns: i32[],
  nameTok: i32,
  p0: i32,
) {
  const fix = parseFuncTail(name, typarams, nameTok, p0)
  let bi = 0
  while bi < tpBoundIxs.length {
    setFnTpBound(fix, tpBoundIxs[bi], tpBoundAnns[bi])
    bi = bi + 1
  }
  fix
}

function parseFunc() { parseFuncHead(true) }

// The type spelling of the annotation node at `ix`, or `""` for none. Every annotation is a
// `TypeRef` carrying a synthetic name, so one read covers `i32`, `u8[]` and `A | B` alike.
function annNameOf(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = P.nodes[ix]
  if n is TypeRef { return n.tyName }
  ""
}

// `extern function name(p: T, …): R` — a host function declared in ordinary VL syntax, with
// no body. The name is the wasm import name, so the declaration is banked in the program-wide
// manifest (`ast.externAdd`) and contributes NO statement: an extern has no body to run and
// no local index to occupy.
function parseExtern() {
  // `export extern function …` — ordinary visibility, exactly as on a `function`: the
  // declaring module keeps a non-exported extern to itself, and an exported one is importable
  // by name. The link name it points at is shared either way.
  if peekKind() == "EXPORT" { advance() }
  advance() // "extern"
  if peekKind() != "FUNCTION" {
    P.diags.push(
      {
        msg: "`extern` declares a host function — write `extern function name(…): T`",
        at: P.pos,
      },
    )
    return 0
  }
  advance() // "function"
  let name = ""
  const nameTok = P.pos
  if peekKind() == "IDENT" { name = advance().text } else { expect("IDENT") }
  const ptys: string[] = []
  parseExternParams(ptys)
  let ret = ""
  if accept("COLON") { ret = annNameOf(parseType()) }
  externAdd(name, ptys, ret, nameTok)
  externRejectBody()
}

// `"(" (IDENT ":" type ("," …)*)? ")"` — an extern's parameter list, appending each
// parameter's type spelling to `out`. Its own reader rather than `parseParamList`, which
// mints `Param` nodes an extern has nothing to attach them to.
function parseExternParams(out: string[]) {
  expect("LPAREN")
  skipNewlines()
  let going = peekKind() != "RPAREN"
  while going {
    skipNewlines()
    if peekKind() == "IDENT" { advance() } else { expect("IDENT") }
    if accept("COLON") {
      out.push(annNameOf(parseType()))
    } else {
      P.diags.push(
        {
          msg: "an `extern` parameter needs a type — a host import's signature is the whole contract",
          at: P.pos,
        },
      )
      out.push("")
    }
    skipNewlines()
    if peekKind() == "COMMA" {
      advance()
      skipNewlines()
      going = peekKind() != "RPAREN"
    } else {
      going = false
    }
  }
  expectClose("RPAREN")
}

// A body on an `extern function` is the one shape that would silently never run: the call
// site lowers to the host import, so the statements would be emitted and unreachable.
function externRejectBody() {
  if peekKind() == "LBRACE" {
    P.diags.push(
      {
        msg: "an `extern function` has no body — the host provides it, so a body here would never run",
        at: P.pos,
      },
    )
  }
  0
}

// The recovered arm: exactly one statement, wrapped in a synthesized `Block` (`-1` for no
// `{` source token). Every consumer downstream then sees the shape the braced form produces,
// so nothing past the parser can tell a recovered body from a written one. Every unbraced
// body rides this, `else` included.
function oneStmtBlock(): i32 {
  // The recovered one-statement arm is a block, so it opens a `type` scope like
  // any other (`parseBlock`) — a `type` declared in it is scoped to it.
  const btSaved = btNames.length
  btDepth = btDepth + 1
  const one: i32[] = []
  one.push(parseStmt())
  btDepth = btDepth - 1
  btTrimTo(btSaved)
  mkBlock(one, -1)
}

// A body that requires braces — `if`, `while`, `for` and `else` — with bounded recovery for
// the unbraced form, since one missing brace otherwise cascades into a phantom diagnostic.
// When the offending token plausibly starts a statement, take it as the body: one diagnostic
// anchored there and exactly one statement, and the arm is marked lossless.
function parseBracedBody(msg: string): i32 {
  if peekKind() != "LBRACE" && startsStmt(peekKind()) {
    dgMarkLossless(P.diags.length) // the index this push is about to occupy
    P.diags.push({ msg: msg, at: P.pos })
    return oneStmtBlock()
  }
  parseBlock()
}

// `"if" expr block ("else" (ifStmt | block))?`, serving statement and expression position. A
// recovered else branch wraps in a one-statement `Block`, so every branch downstream is a
// `Block` or an `If`. A chain is `else if` — an `else` whose branch is another `if`, since
// there is no fused `elseif` keyword.
function parseIf() {
  const p0 = peekTok().start // the `if` keyword
  advance()                  // "if"
  const cond = parseExpr()
  // There is no `then` single-statement sugar: the branch is a brace block. Source that
  // spells it gets a targeted refusal naming the fix — the generic "expected {" would strand
  // it — and then recovery-parses that shape so later errors still surface (DECISIONS.md).
  let thenB = -1
  if peekKind() == "IDENT" && peekTok().text == "then" {
    P.diags.push(
      {
        msg: "`then` was removed — wrap the branch in braces: `if cond { … }`",
        at: P.pos,
      },
    )
    advance()              // the stranded "then"
    thenB = oneStmtBlock() // recovery: the old one-stmt wrapper
  } else {
    thenB = parseBracedBody("an `if` body requires braces: `if cond { … }`")
  }
  let els = -1
  // The `else` may sit on a new line after the then-block's `}`. Scan past any newlines to
  // look for it, but consume them only if an `else` actually follows: a trailing block whose
  // `}` is merely followed by a newline must leave the cursor on that newline so the
  // enclosing statement loop sees the next statement.
  let look = P.pos
  let scanning = kindAt(look) == "NEWLINE" || kindAt(look) == "SEMI"
  while scanning {
    look = look + 1
    scanning = kindAt(look) == "NEWLINE" || kindAt(look) == "SEMI"
  }
  if kindAt(look) == "ELSE" {
    P.pos = look + 1 // consume the skipped newlines and the `else`
    // An `else {`-brace is a block unless it shapes up as an object literal —
    // and empty braces (`else {}`) stay a block (the same tie-break as a
    // function body: `looksLikeObject` calls `{}` an object, which here would
    // synthesize a spurious `{}` expression).
    let ebraceBlock = false
    if peekKind() == "LBRACE" {
      let escan = P.pos + 1
      let enl = kindAt(escan) == "NEWLINE"
      while enl {
        escan = escan + 1
        enl = kindAt(escan) == "NEWLINE"
      }
      ebraceBlock = kindAt(escan) == "RBRACE" || !looksLikeObject(P.pos)
    }
    if peekKind() == "IF" {
      els = parseIf()
    } else if ebraceBlock {
      els = parseBlock()
    } else if peekKind() == "LBRACE" {
      // `else { a: 1 }` is an object literal, not a block — `looksLikeObject` above tells the
      // two readings apart. It is braced, so the rule below is satisfied and this arm keeps
      // its reading, diagnostic-free; `vl fmt` renders it as the unambiguous `else { { … } }`.
      els = oneStmtBlock()
    } else {
      // There is no `else <stmt>` single-statement form: an `else` takes a brace block or
      // another `if`, the same rule the other bodies have. It rides the shared required-brace
      // recovery, so `else print(2)` costs one diagnostic and the parse continues; an `else`
      // followed by something that starts no statement keeps the plain `expected `{`` reading.
      els = parseBracedBody("an `else` body requires braces: `else { … }`")
    }
  }
  mkIf(cond, thenB, els, p0)
}

// `match scrut { pat [| pat]* => body … }` — exhaustive value dispatch, reached from
// `parsePrimary`, so a bare `match` statement is an expression statement. An arm is one or
// more patterns joined by `|`, then `=>` and a body; arms are newline- or comma-separated.
// The scrutinee node is threaded into the pattern parser, so a type pattern rides `x is T`.
function parseMatch(): i32 {
  const p0 = peekTok().start // "match"
  advance()                  // "match"
  const scrut = parseExpr()
  expect("LBRACE")
  skipNewlines()
  const pats: i32[] = []
  // Parallel to `pats`: each pattern's payload-binding clause (a `Block` of `const` decls) or -1.
  // `parseMatchPattern` pushes exactly one entry per pattern, on every exit including its error
  // arm — the two columns are indexed by the same `armStart`/`armCount`, so a missed push would
  // silently shift every later arm's bindings onto the wrong pattern.
  const binds: i32[] = []
  const armStart: i32[] = []
  const armCount: i32[] = []
  const bodies: i32[] = []
  let going = peekKind() != "RBRACE" && peekKind() != "EOF"
  while going {
    armStart.push(pats.length)
    let cnt = 0
    let morePat = true
    while morePat {
      pats.push(parseMatchPattern(scrut, binds))
      cnt = cnt + 1
      if peekKind() == "PIPE" {
        advance() // "|"  (an OR-pattern)
        skipNewlines()
      } else {
        morePat = false
      }
    }
    armCount.push(cnt)
    expect("EQUAL") // `=` of `=>`
    expect("GT")    // `>` of `=>`
    skipNewlines()
    let body = -1
    if peekKind() == "LBRACE" {
      body = parseBlock()
    } else {
      body = parseExpr()
    }
    bodies.push(body)
    skipNewlines()
    if peekKind() == "COMMA" {
      advance()
      skipNewlines()
    }
    going = peekKind() != "RBRACE" && peekKind() != "EOF"
  }
  expectClose("RBRACE")
  mkMatch(scrut, pats, binds, armStart, armCount, bodies, p0)
}

// Whether the token at the cursor can start a match arm's type pattern: a name, an inline
// object or the `null` type. Kept a closed set so a token that starts no type still gets the
// pattern diagnostic below rather than `parseTypeAtom`'s generic recovery. A number is
// deliberately not here (D1572): a numeric lexeme in pattern position is the integer literal.
function matchPatStartsType() {
  const k = peekKind()
  if k == "IDENT" { return true }
  if k == "LBRACE" { return true }
  if k == "NULL" { return true }
  false
}

// One match arm pattern: a string literal, an integer literal, `_` (the wildcard, lexed as
// the identifier), or a type. A type pattern is minted as a real `IsExpr` over the scrutinee
// — exactly what `scrut is T` produces — so there is no second narrowing path, and it is
// minted here because `isVarTyIx` and `nodeTyIx` are sized at `checkProgram` entry.
function parseMatchPattern(scrut: i32, binds: i32[]): i32 {
  const pp = peekTok().start
  if peekKind() == "STRING" {
    binds.push(-1)
    return mkStr(advance().text, pp)
  }
  if peekKind() == "IDENT" && peekTok().text == "_" {
    binds.push(-1)
    return mkIdent(advance().text, pp)
  }
  // D1572 — an integer-literal pattern (`0x10 => …`, `-1 => …`), minted as the number
  // expression it reads as rather than a numeric literal type, so `desugarMatchAt`'s
  // non-`IsExpr` arm turns it into `scrut == pat` and an integer match is the hand-written
  // if-chain. The `-` belongs to the pattern, so only an immediately-following number is taken.
  if peekKind() == "NUMBER" {
    binds.push(-1)
    return mkNum(advance().text, pp)
  }
  if peekKind() == "MINUS" && peek2Kind() == "NUMBER" {
    advance() // "-"
    const np = peekTok().start
    const numIx = mkNum(advance().text, np)
    binds.push(-1)
    return mkUnary("-", numIx, pp)
  }
  if matchPatStartsType() {
    // The spelling root must be taken off the stack before the node is minted and banked
    // immediately after — `parseIsType`'s contract, with `parseTypeAtom` in place of
    // `parseTypeName` (the atom leaves exactly one root, including on its error arm).
    const nm = parseTypeAtom()
    const root = tsPop()
    const isIx = mkIsExpr(scrut, nm, pp)
    setAnnTs(isIx, root)
    // The payload clause is parsed after the pattern node is minted and banked, so it mints no
    // type spelling of its own and `annTsNode` stays strictly increasing.
    binds.push(parseMatchPayload(scrut))
    return isIx
  }
  binds.push(-1)
  const patMsg = "match pattern must be a type, a string literal, an integer literal, or `_`"
  P.diags.push({ msg: patMsg, at: P.pos })
  advance()
  mkErr("pat", P.pos, pp)
}

// The optional payload clause of a variant pattern: `Move{x, y}` binds one arm-local
// `const x = <scrut>.x` per named field, returning a `Block` of those `LetDecl`s or -1. The
// clause is unambiguous where it is legal — after a pattern's type atom the arm grammar
// allows only `|`, `=` and this `{`. The initializer reads the shared scrutinee node.
function parseMatchPayload(scrut: i32): i32 {
  if peekKind() != "LBRACE" { return -1 }
  const bp = peekTok().start
  advance() // "{"
  skipNewlines()
  const lets: i32[] = []
  let going = peekKind() != "RBRACE" && peekKind() != "EOF"
  while going {
    const fp = peekTok().start
    if peekKind() == "IDENT" {
      const fname = advance().text
      const mem = mkMember(scrut, fname, fp)
      lets.push(mkLet("const", fname, -1, mem, fp))
    } else {
      P.diags.push(
        { msg: "match payload binding must be a field name", at: P.pos },
      )
      advance()
    }
    skipNewlines()
    if peekKind() == "COMMA" {
      advance()
      skipNewlines()
    }
    going = peekKind() != "RBRACE" && peekKind() != "EOF"
  }
  expectClose("RBRACE")
  mkBlock(lets, bp)
}

// `"while" expr block` — `label` is the loop's label when dispatched from the
// labelled-statement form `name: while …` ("" otherwise; host: `parseWhile(label, t)`).
function parseWhile(label: string) {
  const p0 = peekTok().start // the `while` keyword
  advance()                  // "while"
  const cond = parseExpr()
  const body = parseBracedBody(
    "a `while` body requires braces: `while cond { … }`",
  )
  mkWhile(cond, body, label, p0)
}

// `for v in <from> to <to> [step <s>] { body }` (a numeric range) or
// `for v in <iterable> { body }` (a for-in over an array). `in`, `to` and `step` are soft
// keywords, lexed as IDENT and matched by text; the form is decided after the `in`-expression,
// a following soft `to` meaning a range. `label` is the label from the `name: for …` form.
function parseFor(label: string) {
  const p0 = peekTok().start // the `for` keyword
  advance()                  // "for"
  let v = ""
  let vTok = -1
  if peekKind() == "IDENT" {
    vTok = P.pos
    v = advance().text
  } else {
    expect("IDENT")
  }
  // soft keyword `in`
  if peekKind() == "IDENT" && peekTok().text == "in" {
    advance()
  } else {
    P.diags.push({ msg: "expected `in` in for-loop", at: P.pos })
  }
  const first = parseExpr() // the range start, or the iterable
  if peekKind() == "IDENT" && peekTok().text == "to" {
    advance()     // "to"
    const to = parseExpr()
    let step = -1 // -1 => implicit +1 step
    if peekKind() == "IDENT" && peekTok().text == "step" {
      advance() // "step"
      step = parseExpr()
    }
    const rbody = parseBracedBody(
      "a `for` body requires braces: `for v in … { … }`",
    )
    const frix = mkForRange(v, first, to, step, rbody, label, p0)
    mkDeclNameTok(frix, vTok)
    return frix
  }
  const ibody = parseBracedBody(
    "a `for` body requires braces: `for v in … { … }`",
  )
  const fiix = mkForIn(v, first, ibody, label, p0)
  mkDeclNameTok(fiix, vTok)
  fiix
}

// `"break" [label]` — a loop-control statement with an optional loop label after
// the keyword (an IDENT on the same line — a NEWLINE token stops the lookahead,
// exactly as the host's `at("ID")` does). Mirrors the `case "BREAK"` arm in
// `parser.ts`.
function parseBreak() {
  const p0 = peekTok().start // the `break` keyword
  const kw = advance()       // "break"
  let label = ""
  if peekKind() == "IDENT" { label = advance().text }
  mkBreak(kw.text, label, p0)
}

// `"continue" [label]` — see `parseBreak`. Mirrors the `case "CONTINUE"` arm in
// `parser.ts`.
function parseContinue() {
  const p0 = peekTok().start // the `continue` keyword
  const kw = advance()       // "continue"
  let label = ""
  if peekKind() == "IDENT" { label = advance().text }
  mkContinue(kw.text, label, p0)
}

// `"return" expr?`
function parseReturn() {
  const p0 = peekTok().start // the `return` keyword
  advance()                  // "return"
  let arg = -1
  const k = peekKind()
  const stops = k == "RBRACE" || k == "NEWLINE" || k == "EOF" || k == "SEMI"
  if !stops { arg = parseExpr() }
  mkReturn(arg, p0)
}

// `"{" stmt* "}"`
function parseBlock() {
  const p0 = peekTok().start // the opening `{`
  expect("LBRACE")
  // D1045: a block opens a `type` scope. The mark is taken here and trimmed at
  // the close, which is the whole of "lexically scoped to the block".
  const btSaved = btNames.length
  btDepth = btDepth + 1
  // D1581 — a block holds statements, so its newlines are terminators again even
  // inside `f(() => { … })`. Without the reset, `a` NEWLINE `-b` in a lambda body
  // nested in a call argument would join into one subtraction.
  const brSavedB = brDepth
  brDepth = 0
  const stmts: i32[] = []
  let going = true
  while going {
    const k = peekKind()
    if k == "RBRACE" || k == "EOF" { going = false }
    else if k == "NEWLINE" || k == "SEMI" { advance() }
    else { stmts.push(parseStmt()) }
  }
  brDepth = brSavedB
  expectClose("RBRACE")
  btDepth = btDepth - 1
  btTrimTo(btSaved)
  mkBlock(stmts, p0)
}

// The statement-leading keywords: a `{` whose first token (after newlines) is
// one of these is a block, never an object literal (mirrors the host's
// `STATEMENT_KEYWORDS` set, consulted by `looksLikeObject`).
export function isStmtKeyword(kind: TokKind) {
  kind == "LET" ||
    kind == "CONST" ||
    kind == "RETURN" ||
    kind == "IF" ||
    kind == "WHILE" ||
    kind == "FOR" ||
    kind == "BREAK" ||
    kind == "CONTINUE" ||
    kind == "TYPE" ||
    kind == "FUNCTION"
}

// Decide whether the `{` at absolute token index `bracePos` opens an object literal rather
// than a block, which at statement position is otherwise the dispatch. Skipping newlines
// after `{`: a `}` or an IDENT or STRING followed by `:` (or an IDENT followed by a balanced
// `( … )` and a `{`) is an object; a statement keyword or anything else is a block.
function looksLikeObject(bracePos: i32) {
  let i = bracePos + 1
  let going = kindAt(i) == "NEWLINE"
  while going {
    i = i + 1
    going = kindAt(i) == "NEWLINE"
  }
  const first = kindAt(i)
  if first == "RBRACE" { return true }
  if isStmtKeyword(first) { return false }
  if first == "IDENT" || first == "STRING" {
    let j = i + 1
    let g = kindAt(j) == "NEWLINE"
    while g {
      j = j + 1
      g = kindAt(j) == "NEWLINE"
    }
    const nk = kindAt(j)
    if first == "STRING" { return nk == "COLON" }
    // An object literal is identified by a key-value pair. A bare `{ name }` or `{ a, b }`
    // shorthand is not treated as one in the ambiguous body positions this gates: it is a
    // block, so a body returning a bare binding reads as a block whose tail expression is
    // the value. A genuine shorthand object there must be parenthesized: `({ x })`.
    if nk == "COLON" { return true }
    // Method shorthand `{ add(a,b){…} }`: an IDENT directly followed by a
    // balanced `( … )` and then a `{` body. An optional return annotation
    // `add(a): T { … }` is scanned past with `{`/`[`/`(` depth tracking so an
    // object/array type in the annotation doesn't swallow the body brace.
    if nk == "LPAREN" {
      let depth = 0
      let k = j
      let scanning = true
      while scanning {
        const t = kindAt(k)
        if t == "LPAREN" { depth = depth + 1 }
        else if t == "RPAREN" { depth = depth - 1 }
        else if t == "EOF" { return false }
        k = k + 1
        scanning = depth > 0
      }
      let g2 = kindAt(k) == "NEWLINE"
      while g2 {
        k = k + 1
        g2 = kindAt(k) == "NEWLINE"
      }
      if kindAt(k) == "COLON" {
        k = k + 1
        let d = 0
        let tscan = true
        while tscan {
          const t2 = kindAt(k)
          if t2 == "EOF" { return false }
          if d == 0 && t2 == "LBRACE" {
            tscan = false
          } else {
            if t2 == "LBRACE" || t2 == "LBRACK" || t2 == "LPAREN" {
              d = d + 1
            } else if t2 == "RBRACE" || t2 == "RBRACK" || t2 == "RPAREN" {
              d = d - 1
            }
            k = k + 1
          }
        }
      }
      return kindAt(k) == "LBRACE"
    }
    return false
  }
  false
}

// One statement: dispatch on the leading keyword, else an expression statement.
export function parseStmt() {
  // No type annotation spans statements, so any `>` credit still banked here belongs to a
  // malformed generic in an earlier declaration — drop it rather than let it silently close
  // some later unrelated `Box<T` annotation.
  pendingGt = 0
  // `export` is a top-level visibility modifier — the back end exports every
  // top-level function by name regardless, so the AST drops the modifier and
  // parses the underlying `function`/`type`/`let`/`const` declaration.
  if peekKind() == "EXPORT" { advance() }
  const k = peekKind()
  if k == "LET" || k == "CONST" { return parseLet() }
  if k == "FUNCTION" { return parseFunc() }
  if k == "TYPE" { return parseTypeDecl(-1) }
  // A flat record: `flat type TValue = { … }`. `flat` is a contextual keyword — it stays a
  // legal identifier everywhere else — and the guard is exact rather than heuristic, because
  // `type` is a hard lexer keyword and an IDENT followed by it is not a legal statement under
  // any parse, so the widening is total (`docs/internals/flat-records-design.md` §1).
  if k == "IDENT" && kindAt(P.pos + 1) == "TYPE" {
    if peekTok().text == "flat" {
      const flatAt = peekTok().start
      advance() // "flat"
      return parseTypeDecl(flatAt)
    }
  }
  if k == "IF" { return parseIf() }
  if k == "WHILE" { return parseWhile("") }
  if k == "FOR" { return parseFor("") }
  if k == "BREAK" { return parseBreak() }
  if k == "CONTINUE" { return parseContinue() }
  if k == "RETURN" { return parseReturn() }
  if k == "LBRACE" {
    // A `{` at statement position is a block unless it shapes up as an object literal
    // (`{ k: v, … }` — an expression statement or implicit return). `looksLikeObject`
    // disambiguates, and the object form parses as an expression through `parsePrimary`.
    if looksLikeObject(P.pos) { return parseExpr() }
    return parseBlock()
  }
  // Labelled loop `name: while …` / `name: for …` — an IDENT directly followed
  // by a COLON and a loop keyword (host: the `case "ID"` arm's `peek(1)`/
  // `peek(2)` test). Anything else falls through to an expression statement.
  if k == "IDENT" && kindAt(P.pos + 1) == "COLON" {
    const lk = kindAt(P.pos + 2)
    if lk == "WHILE" {
      const label = advance().text
      advance() // COLON
      return parseWhile(label)
    }
    if lk == "FOR" {
      const label = advance().text
      advance() // COLON
      return parseFor(label)
    }
  }
  parseExpr()
}

// The sentence for a char-quoted module specifier (`from 'std:fs'`), in one home because the
// parser and the driver's token-level `modScan` both say it, and two scanners over one
// statement drifting apart is the whole defect. `raw` is the char literal's raw lexeme,
// quotes included, so an escape survives verbatim; it names the spelling, not the resolution.
export function importSpecCharMsg(raw: string): string {
  let inner = raw
  if inner.length >= 2 { inner = inner.slice(1, inner.length - 1) }
  "An import specifier is a string — single quotes are a char literal; write \"" +
    inner +
    "\""
}

// Parse an `import { a, b as c, … } from "path"` into an `ImportDecl`, the cursor on the
// leading `import`. Binding stays the driver's `modScan`, which never reads this node; the
// node exists for AST consumers. Token consumption runs to and including the trailing path
// STRING, bounded by a line break or `;` outside the braces, or a statement-start keyword.
function parseImport(): i32 {
  const kwAt = P.pos // the `import` keyword, anchor for the diagnostic
  const p0 = peekTok().start
  advance()
  let depth = 0 // `{ … }` nesting — a NEWLINE inside the name list is legal
  let found = false
  let going = true
  const names: string[] = []
  const locals: string[] = []
  const nameToks: i32[] = []
  let path = ""
  while going {
    const k = peekKind()
    if k == "STRING" {
      // The path literal — the statement ends here. The STRING token's `text`
      // keeps its surrounding quotes (mirroring `modScan`): strip them.
      let raw = advance().text
      if raw.length >= 2 {
        if raw[0] == '"' && raw[raw.length - 1] == '"' {
          raw = raw.slice(1, raw.length - 1)
        }
      }
      path = raw
      found = true
      going = false
    } else if k == "CHAR" && depth == 0 {
      // A CHAR literal where the path belongs — the statement has a specifier
      // (so this is not the `malformed import` case), it is just spelled with the
      // wrong quotes. Report it here and stop: this is the specifier.
      P.diags.push({ msg: importSpecCharMsg(peekTok().text), at: P.pos })
      advance()
      found = true
      going = false
    } else if k == "EOF" {
      going = false
    } else if (k == "NEWLINE" || k == "SEMI") && depth == 0 {
      going = false
    } else if isStmtKeyword(k) {
      going = false // a name list never contains these — an unclosed clause
    } else {
      if k == "LBRACE" { depth = depth + 1 }
      if k == "RBRACE" && depth > 0 { depth = depth - 1 }
      if k == "IDENT" && depth == 1 {
        // One name-list item: `a` or `a as b`, the `as` riding as an IDENT. On the rename
        // form, consume through the `as` so the loop's shared `advance()` lands past the alias.
        const nmTok = P.pos
        const nm = peekTok().text
        let loc = nm
        if kindAt(P.pos + 1) == "IDENT" && kindAt(P.pos + 2) == "IDENT" {
          if P.toks[P.pos + 1].text == "as" {
            advance() // the source name
            advance() // `as` — the cursor lands on the local alias
            loc = peekTok().text
          }
        }
        names.push(nm)
        locals.push(loc)
        nameToks.push(nmTok)
      }
      advance()
    }
  }
  if !found {
    P.diags.push(
      { msg: "malformed import: expected a module path string literal", at: kwAt },
    )
  }
  mkImport(path, names, locals, nameToks, p0)
}

// Consume a re-export `export { a, b as c, … } from "path"`, the cursor on the leading
// `export`. Like an import it is a module-front-end concern and produces no AST node; tokens
// up to and including the trailing path STRING are skipped, the `from` riding as an IDENT.
// Distinguished from an `export function`/`let`/`type` by the `{` immediately after `export`.
function skipReexport() { skipModuleClause("re-export") }

// The bounded skip for the re-export form, the cursor on the leading `export`. It skips the
// clause — a brace-enclosed name list, which may span lines, or a bare name — then the `from`
// identifier and the path string. Bounded by a line break or `;` outside the braces, or by a
// statement-start keyword, so a clause missing its path cannot swallow the following code.
function skipModuleClause(what: string) {
  const kwAt = P.pos // the `import`/`export` keyword, anchor for the diagnostic
  advance()
  let depth = 0 // `{ … }` nesting — a NEWLINE inside the name list is legal
  let found = false
  let going = true
  while going {
    const k = peekKind()
    if k == "STRING" {
      advance() // the path literal — the statement ends here
      found = true
      going = false
    } else if k == "CHAR" && depth == 0 {
      // A char-quoted path — `parseImport`'s arm, at the re-export spelling.
      P.diags.push({ msg: importSpecCharMsg(peekTok().text), at: P.pos })
      advance()
      found = true
      going = false
    } else if k == "EOF" {
      going = false
    } else if (k == "NEWLINE" || k == "SEMI") && depth == 0 {
      going = false
    } else if isStmtKeyword(k) {
      going = false // a name list never contains these — an unclosed clause
    } else {
      if k == "LBRACE" { depth = depth + 1 }
      if k == "RBRACE" && depth > 0 { depth = depth - 1 }
      advance()
    }
  }
  if !found {
    P.diags.push(
      {
        msg: "malformed " + what + ": expected a module path string literal",
        at: kwAt,
      },
    )
  }
  0
}

// The public entry point: parse a whole program, return the root node index.
export function parseProgram() {
  // Module-global parser state must not leak in from an earlier (possibly
  // malformed) run: a banked `>` credit would silently close some later
  // unrelated generic.
  pendingGt = 0
  // D1581: bracket depth is per program too. An unclosed `(` in an earlier
  // (malformed) parse would otherwise leave it raised and make every later
  // statement break newline-terminate at a leading operator.
  brDepth = 0
  // D1045: the block-scope machinery is per program. A mint counter only has to
  // be unique within its module — the merge renames each module's top-level
  // declarations, these included, apart — and a leaked scope row from an earlier
  // (possibly malformed) parse would silently rename an unrelated annotation.
  btDepth = 0
  btSeq = 0
  btPendingBase = ""
  btNames = []
  btBases = []
  btArgs = []
  btIsNew = []
  btTyParams = []
  btHoisted = []
  const p0 = peekTok().start // the first token of the source
  const stmts: i32[] = []
  let going = true
  while going {
    const k = peekKind()
    if k == "EOF" { going = false }
    else if k == "NEWLINE" || k == "SEMI" { advance() }
    else if k == "IMPORT" { stmts.push(parseImport()) }
    else if k == "EXPORT" && kindAt(P.pos + 1) == "LBRACE" { skipReexport() }
    else if k == "EXTERN" { parseExtern() }
    else if k == "EXPORT" && kindAt(P.pos + 1) == "EXTERN" { parseExtern() }
    else { stmts.push(parseStmt()) }
  }
  // D1045 — the hoist. A body-scoped declaration is also a top-level statement of the
  // program, which is what makes the checker's passes register it and the emitter mint its
  // rep, all of which read `progStmts` and only `progStmts`. Appended, so a hoisted
  // declaration registers after every module-scope one; the node stays where it lexically is.
  let hi = 0
  while hi < btHoisted.length {
    stmts.push(btHoisted[hi])
    hi = hi + 1
  }
  mkProgram(stmts, p0)
}
