// The niche twin of `mvListValKind` — the nullable `VKind` a `{[K]: T[] | null}` value binds,
// or null when the value is not a list. Composed on `mvListValKind` so the element-kind to rep
// mapping has one home. It is half of a pair: the `.values()` loop var binds the niche here
// and `emitForInStmt` must leave the element read raw, or the stored null traps.
export function mvNulListValKind(slot: i32): VKind | null {
  const k = mvListValKind(slot)
  if k == null { return null }
  vkNulNicheOf(k)
}

// The `$fnsig` key of a closure-element ref-list slot, off the arena: peel the `| null` niche,
// since the narrowed indexed call casts to the same functype a non-null element does, then key
// the `TyFunc` spine directly rather than re-parsing the rendered signature. "" when uncovered
// or not a function type.
export function rlElemCloSigKey(slot: i32): string {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return "" }
  let b = ty
  const t = tyAt(ty)
  if t is TyNullable { b = t.nInner }
  if b < 0 { return "" }
  const bt = tyAt(b)
  if bt is TyFunc { return sigKeyOfTy(b) }
  ""
}

// The emitter-format name of the list union `ty`, a record element spelled by its row
// (`Circle[]|i32[]`); "" when a member has no name.
export function listUnionEmitName(ty: i32): string {
  if ty < 0 || ty >= T.tys.length { return "" }
  const t = tyAt(ty)
  match t {
    TyNullable => {
      const inn = listUnionEmitName(t.nInner)
      if inn == "" { return "" }
      return inn + "|null"
    }
    TyUnion => {
      let nm = ""
      let i = 0
      while i < t.uMembers.length {
        const mt = t.uMembers[i]
        let mn = declNominalOfTy(mt)
        // A member no declaration names, such as a scalar list, keeps its own spelling.
        if mn == "" { mn = tyToEmitName(mt) }
        if mn == "" { return "" }
        if i > 0 { nm = nm + "|" }
        nm = nm + mn
        i = i + 1
      }
      return nm
    }
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyLit | TyNeg => {
      // `tyIsListUnion` admits only the two shapes above.
      return ""
    }
  }
}

// ── the non-null ref kind and its nullable niche (D1115) ──
// Every nullable ref niche is `(ref null $H)` over the same heap `$H` its non-null kind is
// `(ref $H)` over; this table doubles as "is `K` a non-null ref". Stated once, since two
// hand-written kind lists can drift out of step with each other otherwise.
export function vkNulNicheOf(k: VKind): VKind | null {
  // Exhaustive over `VKind` and `_`-less: `null` means no nullable niche is owed, so a new
  // kind has to declare whether it has one rather than silently owe nothing.
  match k {
    "struct" => {
      return "nulstruct"
    }
    "variant" => {
      return "nulvariant"
    }
    "list" => {
      return "nullist"
    }
    "reflist" => {
      return "nulreflist"
    }
    "strlist" => {
      return "nulstrlist"
    }
    "f64list" => {
      return "nulf64list"
    }
    "i64list" => {
      return "nuli64list"
    }
    "f32list" => {
      return "nulf32list"
    }
    "u8list" => {
      return "nulu8list"
    }
    "map" => {
      return "nulmap"
    }
    "str" => {
      return "nulstr"
    }
    "closure" => {
      return "nulclosure"
    }
    "i32" | "union" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f32" | "v128" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" => {
      // No nullable niche is owed: the scalars ride a sentinel, and the `nul*` kinds are
      // already the niche.
      return null
    }
  }
}

// D1222 — the struct-field destination's rep kind, from its field code: a field names its
// destination by code while every other delivery names it by kind, so this is the code-to-
// kind edge, feeding the same `vkNulNicheOf` table. Only the non-null ref codes answer; a
// scalar, nullable, union-box, or unrepresentable field code is `null` — nothing is owed.

// Membership is `pushFieldStorage`'s own test: a code answers here exactly when it stores
// `0x64`. Code 15 stores `0x63`, since one hop carries both `S` and `S | null`, so a store
// into it never owes the recover and asking for one traps on `null` (D1720).
export function fieldCodeVKind(code: i32): VKind | null {
  if code == FC_STR { return "str" }
  if code == FC_CLOSURE { return "closure" }
  if code == FC_MAP { return "map" }
  listRepOrNull(listRepOfFieldCode(code))
}

// The declared-local SLOT an ident expression names, or -1 — `identCellVKind`'s twin, so a
// delivery boundary reads the `localIsRef`/`localStructIdx` pair the binding boundary reads.
// Deriving the row from the expression's type instead answers -1 for a cell holding an
// inferred union's arm, which is a `variant` (D1685).
export function identCellSlot(exprIx: i32): i32 {
  const e = nodeAt(unwrapParen(exprIx))
  if e is Ident { return declaredSlotOf(unwrapParen(exprIx)) }
  -1
}

// True if the already-collected declared local `name` is a struct ref. Resolves to
// the IN-SCOPE binding's slot (so a same-named binding in a sibling/inner block reads
// ITS own valtype, not an unrelated branch's).
export function declaredStruct(ix: i32) { declaredKind(ix) == "struct" }

// True if the binding's annotation is a single inline object shape (with a trailing `|
// null` stripped) that is not interned as a struct — its shape could not be built (an
// unsupported field type). Checked only after union/nullable-struct/struct classification,
// so a valid inline-struct binding never reaches it; catches the remainder so it rejects cleanly.
export function letAnnIsUninternedShape(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType < 0 { return false }
    const nm = nonNulBaseOf(tyNameOf(d.letType))
    // The spelled-shape half asks the tree, not the arena: `nameIsShapeSpanEnds` is character
    // surgery over the rendering, testing whether the author wrote an inline object shape
    // rather than a map. The arena's `TyObj` sees through a named alias or generic application
    // to the object it denotes, so testing it directly admits false positives it must reject.
    if !annIsSpelledInlineShape(d.letType, nm) { return false }
    // The struct-table lookup stays name-keyed: `sTyRow` is not populated for every shape
    // `sNames` knows, and the row's identity is the name. That is the interning layer, not a
    // type decision.
    if structIndexOfTypeNameTy(nm, nodeTyIxOf(d.letType)) >= 0 { return false }
    // The third resolver's fall-through, mirroring `paramStructIndex`'s inline-shape rung
    // (D111): the name above cannot find an inline shape a declared struct of the same
    // layout already owns, since `internInlineShapeTy` dedups onto that row and pushes no
    // `sNames` entry. `monoAnnPinName`'s inline-shape rung must land first; not safe alone.
    repSlotOfTy(nodeRepTyIxOf(d.letType)) < 0
  }
  false
}

// True if the `LetDecl` at `letIx` carries a value-union annotation — the declared-spelling
// half of `letIsUnion`, asked without looking at the initializer. A literal union is
// excluded, since it reps as an interned i32 atom, not the box. The initializer-free
// reading is what makes it usable from `structIndexOfLet`, on the path `exprUnion` reaches.
export function letAnnIsUnion(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // Not `nodeTyIsUnionAlias(d.letType)`, though it reads as exactly this conjunction:
        // its body has two more positive arms — a same-shape-collapsed `TyObj` and a
        // nullable numeric literal union — both wider than the registry test, and this site needs the
        // narrower set. Trying it broke six passing tests.
        return isUNameAnnAB(2, d.letType) && !nodeTyIsLitUnionAlias(d.letType)
      }
    }
  }
  false
}

// ── multi-struct index resolution ──
// Parallel to the boolean `exprStruct` family, these return the struct table index a
// struct-typed expression, param, local, or return produces, so a field read/write can
// resolve the right heap type and field layout. Return -1 when not a struct.

// The struct table index of the param `name` of function `fnIx` (from its annotation), or -1,
// through the three-rung ladder below.
export function paramStructIndex(fnIx: i32, name: string) {
  if fnIx < 0 {
    return -1 // module-scope initializer (no enclosing function)
  }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = nodeAt(params[i])
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            const ty = nodeAt(p.parType)
            if ty is TypeRef {
              // A plain struct name, or the `S | null` nullable base — not a union variant,
              // since a variant-typed param rides the gap-#2 path. Typed only outside a generic
              // original: there the arena's recorded type is the un-substituted shape, while
              // the shadow ruling correctly says the parameter binds nothing.
              let pty = -1
              if fn.fnTyParams.length == 0 { pty = nodeTyAt(params[i], fnIx) }
              // A parameter stored at a wider record than its type reads its annotation's.
              if recRepWidens(pty, nodeTyIxOf(p.parType)) {
                pty = nodeTyIxOf(p.parType)
              }
              const psi = structIndexOfTypeNameTy(ty.tyName, pty)
              if psi >= 0 { return psi }
              const pnb = nulBaseStructRow(p.parType)
              if pnb >= 0 { return pnb }
              // The inline-shape rung (`annValtypeSlotOf`'s, verbatim): an inline shape whose
              // row a declared struct of the same layout already owns dedups with no `sNames`
              // entry, while the functype for the same node resolves through `repSlotOfTy`
              // (D53). Last, inline-shape only, and not a generic original — each guard answers a recorded failure.
              if fn.fnTyParams.length == 0 {
                if nameIsShapeSpanEnds(ty.tyName) {
                  if variantIndexOf(ty.tyName) < 0 {
                    const pbr = repSlotOfTy(nodeRepTyIxOf(p.parType))
                    if pbr >= 0 { return pbr }
                  }
                }
                // A generic alias applied at an instance (`B<i32>`) names no row and is no
                // inline shape; its record type takes the row the functype's slot reads (D10882).
                if retVariantFlag(p.parType) != 1 {
                  const prt = nodeRepTyIxOf(p.parType)
                  if prt >= 0 && tyAt(prt) is TyObj {
                    return retStructRowIndex(p.parType)
                  }
                }
              }
            }
          }
          return -1
        }
      }
      i = i + 1
    }
  }
  -1
}

// The union-VARIANT table index a function `name` returns (its `: Cat` return
// annotation), or -1.
export function fnRetVariantIndexSid(
  sid: i32,
  name: string,
  fnIx: i32,
  at: i32,
) {
  const fe = fnIndexOfInScopeAt(sid, name, fnIx, at)
  if fe >= 0 {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl {
      if fn.fnRet >= 0 {
        // The kind decides, not the name: `variantIndexOf` answers for any spelling
        // `uVariants` holds, including one that still lowers as the standalone struct because
        // the checker never called it a variant. Taking the index anyway would feed a
        // `uVarHeap` cell from an `sHeapIdx` value — invalid wasm.
        if retVariantFlag(fn.fnRet) != 1 { return -1 }
        const rt = nodeAt(fn.fnRet)
        if rt is TypeRef { return variantIndexOf(rt.tyName) }
        return -1
      }
      // The un-annotated callee, by the same rule the arm above states: when there is no
      // annotation, the predicate is `fRetKind`/`fRetStructIdx`, the pair `emitOneFuncType`'s
      // inferred variant arm emits — reading the same pair here is agreement, not a second
      // opinion. Without it the callee validates but the caller does not (D52).
      if fe < fRetKind.length {
        if fRetKind[fe] == "variant" { return fRetStructIdx[fe] }
      }
    }
  }
  -1
}

// The union-variant table index of the local the `Ident` at `ix` reads (a kind-8 variant
// local — its `localStructIdx` holds the variant index), or -1.
export function declaredVariantIndex(ix: i32) {
  const slot = declaredSlotOf(ix)
  if slot < 0 { return -1 }
  if localIsRef[slot] == "variant" { return localStructIdx[slot] }
  -1
}

// The struct table index of the local the `Ident` at `ix` reads (recorded in
// `localStructIdx`), or -1 if it reads no struct local.
export function declaredStructIndex(ix: i32) {
  const slot = declaredSlotOf(ix)
  if slot < 0 { return -1 }
  match localIsRef[slot] {
    "struct" | "nulstruct" => {
      return localStructIdx[slot]
    }
    // every other local kind is not a struct
    "i32" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "i64" | "f64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
  }
  -1
}

// Whether arena type `ty` is a string literal union, bare or nullable, aliased or inline — the
// interned i32 atom in a `$fnsig`. False for -1.
function annTyIsLitUnion(ty: i32): boolean {
  ty >= 0 && (tyIsLitUnion(ty) || tyIsNullableLitUnion(ty))
}

// The closure-ABI param-kind code for type name `t` with arena type `ty` (-1 when unknown) —
// the annotation-string analogue of `cloParamTok` (which reads the AST), producing the
// identical token per valtype so a value call over an annotated higher-order callee resolves
// the same interned `$fnsig`. "" for a type outside the value-call ABI.
export function annParamKindTy(t: string, ty: i32) {
  if t == "i32" || t == "boolean" { return repSigTokOfKind("i32") }
  if t == "f64" { return repSigTokOfKind("f64") }
  if t == "i64" { return repSigTokOfKind("i64") }
  if t == "f32" { return repSigTokOfKind("f32") }
  if t == "v128" { return repSigTokOfKind("v128") }
  // A string literal union, bare or nullable, aliased or inline, is the interned i32 atom —
  // before the string test, which would read an inline spelling as `str`.
  if annTyIsLitUnion(ty) { return repSigTokOfKind("i32") }
  // Any other registered union is the `{tag, value}` box: found by the type's softened key,
  // or by the name where no type came.
  if ty >= 0 {
    if unRowOfKeyId(softKeyOrNameKey(t, ty, [])) >= 0 {
      return repSigTokOfKind("union")
    }
  } else if isUNameDeclAB(69, t) {
    return repSigTokOfKind("union")
  }
  if nameIsString(t) { return repSigTokOfKind("str") }
  // The scalar-element list backings, via the one home `scalarListRepOfName` — the same
  // enumeration `annRetKindTy` reads, so the two `$fnsig` producers cannot drift.
  const sk = scalarListRepOfName(t)
  if sk != null { return repSigTokOfKind(sk) }
  // A nullable scalar-element list, the dual of `cloParamTok`'s niche tokens (D2399).
  const nsk = annNulListKind(t, ty)
  if nsk != null { return repSigTokOfKind(nsk) }
  const si = structIndexOfTypeNameTy(t, ty)
  if si >= 0 { return repSigSlotTokOfKind("struct", si) }
  // A concrete-variant name (`Cat`), keyed by the variant index (matches `cloParamTok`).
  const vti = variantIndexOf(t)
  if vti >= 0 { return repSigVariantTok(vti) }
  // A ref-list param — the recursive dual of `annRetKindTy`'s ref-list result. Before the arrow
  // case so a closure-element array's nested `=>` isn't misread as a single closure.
  const rs = annRefListSlot(ty)
  if rs >= 0 { return repSigSlotTokOfKind("reflist", rs) }
  // A map param, the annotation-string twin of `cloParamTok`'s map arm (D701 wired the AST
  // side) — without it a map-param lambda call keys "" against the closure's interned map sig.
  if nameIsBareMap(t) {
    return repSigSlotTokOfKind(
      "map",
      mvSlotOfMapNameTys(t, -1, tyMapValOfHeld(ty)),
    )
  }
  // A function-type param is the shared closure fat-pointer, matching `cloParamTok` — without
  // it a higher-order closure param left its `$fnsig` un-interned (invalid wasm). Read off the
  // type, so a parenthesised spelling `((i32) => i32)` is a function too.
  if ty >= 0 && tyAt(ty) is TyFunc { return repSigTokOfKind("closure") }
  // A struct param the checker rendered structurally resolves by field-set to the same index
  // the AST producer's `cloParamTok` keys, matching a nominal name too.
  const sti = structIndexOfTypeNameTy(t, ty)
  if sti >= 0 { return repSigSlotTokOfKind("struct", sti) }
  // The nullable and union params, the name twin of `cloParamTok`'s niche kinds: without them
  // an annotation or arena type naming `string | null` keyed nothing, and the call fell to an
  // unrelated arity functype (D2552).
  const uslot = [-1]
  const uk = annUnionSigKind(t, uslot, ty)
  if repSigTokHasSlot(uk) { return repSigSlotTokOfKind(uk, uslot[0]) }
  if uk != null { return repSigTokOfKind(uk) }
  ""
}

// The nullable-list `VKind` of type name `t` with arena type `ty` that has a `$fnsig` token: the
// i32-backed `nullist` or one of the distinct-backing scalar lists, else `null`.
function annNulListKind(t: string, ty: i32): VKind | null {
  if tyIsNulI32List(ty) { return "nullist" }
  nulScalarListKind(t)
}

// `annParamKindTy`'s result twin for a result spelled `t` with no arena type: its `>X` token.
function annRetKindTy(t: string) {
  if t == "i32" || t == "boolean" { return ">" + repSigTokOfKind("i32") }
  if t == "f64" { return ">" + repSigTokOfKind("f64") }
  if t == "void" { return ">v" }
  if t == "string" { return ">" + repSigTokOfKind("str") }
  if t == "i64" { return ">" + repSigTokOfKind("i64") }
  if t == "f32" { return ">" + repSigTokOfKind("f32") }
  if t == "v128" { return ">" + repSigTokOfKind("v128") }
  // A list return, matching `cloRetKeySuffix` — `nameIsI32Array` folds `boolean[]` and a
  // litunion `K[]` into the same i32-list token the param dual already keys.
  const sk = scalarListRepOfName(t)
  if sk != null { return ">" + repSigTokOfKind(sk) }
  const nsk = nulScalarListKind(t)
  if nsk != null { return ">" + repSigTokOfKind(nsk) }
  // A map return: a map-member union also starts `{[` but falls to the `>u` arm below.
  if nameIsBareMap(t) {
    return ">" + repSigSlotTokOfKind("map", mvSlotOfMapNameTys(t, -1, -1))
  }
  const si = structIndexOfTypeNameTy(t, -1)
  if si >= 0 { return ">" + repSigSlotTokOfKind("struct", si) }
  // A union/nullable return boxes; a union alias resolves to its member set first.
  const uslot = [-1]
  const uk = annUnionSigKind(t, uslot, -1)
  if repSigTokHasSlot(uk) { return ">" + repSigSlotTokOfKind(uk, uslot[0]) }
  if uk != null { return ">" + repSigTokOfKind(uk) }
  ""
}

// The ref-list slot of the list type `ty`: -1 when `ty` is no ref list, -2 for one with no
// slot.
function annRefListSlot(ty: i32): i32 {
  if !tyIsRefArray(ty) { return -1 }
  const rs = repSlotOfKind("reflist", ty)
  if rs < 0 { return -2 }
  rs
}

// The value-ABI kind a union or `X | null` spelling `t` reps as in a `$fnsig`, shared by the
// result and parameter producers: `nulstr`, `nullist`, `nulstruct`, `nulvariant` or
// `nulreflist` (its slot in `slotOut[0]`), `nulclosure`, or `union` for the box. null for a
// non-union and for a niche outside the ABI. `ty` is `t`'s arena type, or -1.
function annUnionSigKind(t: string, slotOut: i32[], ty: i32): VKind | null {
  const parts: string[] = []
  annSplitPipe(unionMemberSetOf(t), parts)
  if parts.length < 2 { return null }
  const nonNull: string[] = []
  let hasNull = false
  let pi = 0
  while pi < parts.length {
    const p = parts[pi]
    if p == "null" { hasNull = true }
    else if p.length > 0 { nonNull.push(p) }
    pi = pi + 1
  }
  if nonNull.length >= 2 { return "union" }
  if !hasNull || nonNull.length != 1 { return null }
  if nonNull[0] == "string" { return "nulstr" }
  // A nullable i32-backed list: the i32-list wrapper made nullable, slot-free, matching
  // `cloRetKeySuffix`'s `>o`; distinct-backing nullable lists fall through to null.
  if nameIsI32Array(nonNull[0]) { return "nullist" }
  // A nullable ref list, keyed by its ref-list slot like `cloParamTok`'s niche arm (D5882).
  const nrs = annRefListSlot(tyPeelNul(ty))
  if nrs == -2 { return null }
  if nrs >= 0 {
    slotOut[0] = nrs
    return "nulreflist"
  }
  const msi = structIndexOfTypeNameTy(nonNull[0], ty)
  if msi >= 0 {
    slotOut[0] = msi
    return "nulstruct"
  }
  // A nullable union arm, keyed by its variant row like `cloParamTok`'s niche arm.
  const mvi = variantIndexOf(nonNull[0])
  if mvi >= 0 {
    slotOut[0] = repVariantSlotRep(mvi)
    return "nulvariant"
  }
  // A nullable closure: the shared fat-pointer made nullable, slot-free, matching `>C`.
  if strContains(nonNull[0], "=>") { return "nulclosure" }
  // A nullable numeric scalar or vector reps as the value-union box; `boolean | null` is the
  // i32-sentinel niche instead and crosses as the plain `i` token.
  if (
    nonNull[0] == "i32"
    || nonNull[0] == "i64"
    || nonNull[0] == "f64"
    || nonNull[0] == "f32"
    || nonNull[0] == "v128"
  ) {
    return "union"
  }
  null
}

// The `$fnsig` KEY of a SOURCE function-type annotation `(params)=>ret` whose arena type is
// `fty` (a `TyFunc`, or -1) — the SAME encoding `fnSigKeyOf` produces for a function (`"i>i"`,
// `"s3;>i"`). A type with the spelling's arity is keyed by `sigKeyOfTy`, the spelling only
// without one. "" if any param or the return is outside the value-call ABI.
export function annSigKeyTy(name: string, fty: i32) {
  const parts: string[] = []
  const retStr = annFnDecompose(name, parts)
  if retStr == "" { return "" }
  if fty >= 0 {
    const ft = tyAt(fty)
    if ft is TyFunc && ft.fnParamTypes.length == parts.length {
      return sigKeyOfTy(fty)
    }
  }
  let key = ""
  let i = 0
  while i < parts.length {
    const pc = annParamKindTy(parts[i], -1)
    if pc == "" { return "" }
    key = key + pc
    i = i + 1
  }
  const rc = annRetKindTy(retStr)
  if rc == "" { return "" }
  key + rc
}

// The `$fnsig` key of function type `funcTyIx`: each parameter's `repSigTokOfTy`, then its
// result's `repSigRetTokOfTy`; "" when any part has no token.
export function sigKeyOfTy(funcTyIx: i32): string {
  if funcTyIx < 0 { return "" }
  const gen = tyRegGenNow()
  while sktGen.length <= funcTyIx {
    sktGen.push(-1)
    sktKey.push("")
  }
  if sktGen[funcTyIx] == gen { return sktKey[funcTyIx] }
  const k = sigKeyOfTyGo(funcTyIx)
  sktGen[funcTyIx] = gen
  sktKey[funcTyIx] = k
  k
}

function sigKeyOfTyGo(funcTyIx: i32): string {
  const t = tyAt(funcTyIx)
  if !(t is TyFunc) { return "" }
  let key = ""
  let i = 0
  while i < t.fnParamTypes.length {
    const pc = repSigTokOfTy(t.fnParamTypes[i])
    if pc == "" { return "" }
    key = key + pc
    i = i + 1
  }
  const rc = repSigRetTokOfTy(t.fnRet)
  if rc == "" { return "" }
  key + rc
}

// The struct row of record type `ty` when the declared record of its name owns that row, else -1.
function sigDeclRecSlotOfTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length || !(tyAt(ty) is TyObj) { return -1 }
  const nm = structNameOfTy(ty)
  if nm == "" { return -1 }
  const si = structIndexOfTy(ty)
  if si < 0 || repSlotOfTy(ty) != si { return -1 }
  si
}

// The struct row record `ty` owns, by its declared name or, with none, its rep slot; -1 when it
// owns none or a twin row shares it. A render names the wrong row once a record nested past the
// spelling cap matches a shallower one.
export function recRowOfTy(ty: i32): i32 {
  let si = sigDeclRecSlotOfTy(ty)
  if (
    si < 0
    && ty >= 0
    && ty < T.tys.length
    && tyAt(ty) is TyObj
    && structNameOfTy(ty) == ""
  ) {
    si = repSlotOfTy(ty)
  }
  if si < 0 || !sigRowHasNoTwin(si) || !sigRowHasNoArmTwin(si) { return -1 }
  si
}

// Whether type `ty` may be something other than the i32 valtype: only a derived `i32` or
// `boolean | null` rep is known to ride an i32, so an underived rep answers true.
export function cloArityRepIsWide(ty: i32): boolean {
  const d = repOfTy(ty)
  if d.rdCovered == 0 { return true }
  d.rdKind != "i32" && d.rdKind != "nulbool"
}

// The `$fnsig` key of a union member-set arm (a `splitUnionAtoms` atom) whose arena type is
// `ty` (-1 when unknown), or "" for a non-closure arm or a signature outside the value-call
// ABI. A closure arm arrives wrapped in its disambiguating parens and may carry `| `-split
// whitespace — normalized here so the key byte-matches the narrowed call site's.
export function unionArmSigKeyTy(arm: string, ty: i32) {
  annSigKeyTy(normTypeAtom(arm), ty)
}

// The function-type annotation of the local `LetDecl` the read `readIx` resolves to in `fnIx`,
// or -1. Placed by `readPosIn`, which picks among sibling blocks binding one name (D2316).
export function identFnTypeAnnNodeOfRead(readIx: i32, fnIx: i32) {
  if fnIx >= 0 && readIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl {
      const li = bodyLetReadAtSid(
        fn.fnBody,
        sidOfNode(readIx),
        readPosIn(readIx, fnIx),
      )
      if li >= 0 {
        const d = nodeAt(li)
        if d is LetDecl {
          if tyIsFuncType(d.letType) { return d.letType }
        }
      }
    }
  }
  -1
}

// The `$fnsig` key of a closure or nullable closure of arena type `ty`, read off the type. The
// name `nm` is parsed only when the type cannot key it (-1, or a hole a call pins), and only as
// a bare closure: a nullable closure is keyed by its type alone. "" when neither resolves, so
// the call keeps its all-i32 arity fallback.
export function cloNameSigKeyTy(nm: string, ty: i32) {
  const fty = tyPeelNul(ty)
  if fty >= 0 && tyAt(fty) is TyFunc {
    const tk = sigKeyOfTy(fty)
    if tk != "" { return tk }
  }
  annSigKeyTy(nm, ty)
}

// True when a function-scoped block binding of `sid` is still open at `atIx` — reusing
// `parentLetCoversAt` (D2325) rather than a second duplicate-tracking walk. Asked before the
// loop-variable/parameter/anon-leaf rungs, which answer for the OUTER declaration with no
// notion of a nearer block shadow; shared with `monoBakeCallback`'s direct-call rewrite.
export function fnBlockShadowsAt(fnIx: i32, sid: i32, atIx: i32): boolean {
  if fnIx < 0 { return false }
  if atIx < 0 { return false }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl { return parentLetCoversAt(fn.fnBody, sid, atIx) }
  false
}

// The links `moduleCopySigKey` follows: the monomorphizer's own alias-chain limit.
export const COPY_CHAIN_MAX = 64

// The last arena index of frame `fnIx`'s source (its body block; the program node for the
// start function), or -1. The arena is post-order, so a node past it is a rewrite's own.
export function frameBodyEnd(fnIx: i32): i32 {
  if fnIx < 0 { return emitRootIx }
  if fnIx >= P.nodes.length { return -1 }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl { return fn.fnBody }
  -1
}

// The node a read is placed at among its frame's blocks: its own, or for a minted callee, which
// has no place, its call's (D2479).
export function readPosIn(readIx: i32, fnIx: i32): i32 {
  const o = callOriginOf(readIx)
  if o >= 0 && o <= frameBodyEnd(fnIx) { return o }
  readIx
}

// The `$fnsig` key of the callee node at `atIx` from its own checker type, or "" when it has
// no function type or no position (`atIx < 0`).
export function calleeNodeSigKey(atIx: i32, fnIx: i32): string {
  if atIx < 0 { return "" }
  const aty = nodeTyAt(atIx, fnIx)
  if aty >= 0 {
    if tyAt(aty) is TyFunc { return sigKeyOfTy(aty) }
  }
  ""
}

// Whether the frame binding a capture `name` of lifted frame `fe` binds it as a loop variable:
// the table lookups `captureLoopVarIterOf` starts with, without its element-kind reads. False
// means that function answers -1.
export function enclosingLoopVarBinds(fe: i32, name: string): boolean {
  captureLoopNodeOf(fe, name) >= 0
}

// The position of a `$fnsig` key's result token char — just past the last `>` (params never
// contain one) — or -1 for an empty/result-less key. The one last-`>` scan every result-side
// reader (`sigKeyRetKind`/`sigKeyRetIsVoid`/`sigKeyRetSlot`) decodes through, instead of
// re-scanning the key string per site. Not a type-name grammar — the `$fnsig` ABI alphabet.
function sigKeyRetTokIx(k: string) {
  const n = k.length
  let gt = -1
  let i = 0
  while i < n {
    if k[i] == '>' { gt = i }
    i = i + 1
  }
  if gt < 0 || gt + 1 >= n { return -1 }
  gt + 1
}

// The result value-kind encoded in a closure `$fnsig` key (the atom after the final `>`), or
// `null` when the key is empty or malformed. Shared by the Ident-callee path
// (`calleeRetKindOfRead`), the indexed-element path (`cloArrCallRetKind`), and — for a
// monomorphized closure-pinned param — the instance-return pin (emit_mono).
export function sigKeyRetKind(k: string): VKind | null {
  const ti = sigKeyRetTokIx(k)
  if ti < 0 { return null }
  const c = k[ti]
  // Void is the ABSENCE of a result kind, not a member of the token
  // vocabulary — tested before the shared table.
  if c == 'v' { return null }
  // ONE vocabulary with the encode sites: the token decodes through the
  // canonical char→kind table (`repKindOfSigTok` — the inverse of the
  // `repSigTokOfKind` the encoders read). Every encoder arm must carry a decoder twin.
  repKindOfSigTok(c)
}

// True when a `$fnsig` key's result token is the literal void marker (`…>v`) —
// distinguishable from an EMPTY/unresolved key, which `sigKeyRetKind` folds into the
// same `null` a void result yields.
export function sigKeyRetIsVoid(k: string) {
  const ti = sigKeyRetTokIx(k)
  ti >= 0 && k[ti] == 'v'
}

// True when the `TyUnion` at `ty` has a member that is an array whose element is itself a
// value union (`(i64 | boolean)[]`) — the deferred hole in a closure-result union, since the
// box-of-value-union-element-array rep does not yet compose through a closure result. A
// struct/closure/plain-scalar-list arm is not flagged — those rep fine.
export function tyUnionHasValueUnionElemArrayArm(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    const m = tyAt(t.uMembers[i])
    if m is TyArray && m.aElem >= 0 {
      const el = tyAt(m.aElem)
      if el is TyUnion {
        // A VALUE union element (2+ members, at least one scalar) — not a variant union.
        if el.uMembers.length >= 2 {
          let hasPrim = false
          let j = 0
          while j < el.uMembers.length {
            if tyAt(el.uMembers[j]) is TyPrim { hasPrim = true }
            j = j + 1
          }
          if hasPrim { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// True when `mt` is a declared member of the union type `ut` — used by the `is` emitter's
// loud floor to tell apart "not a union variant" (the tested type isn't in the union) from
// "a declared member with no interned rep" (the arm is checker-approved but nothing ever
// boxed a value into it). A nullable union receiver peels; structural, because VL is.
export function tyIsUnionMemberOf(ut: i32, mt: i32): boolean {
  if ut < 0 || mt < 0 { return false }
  let u = ut
  const un = tyAt(u)
  if un is TyNullable { u = un.nInner }
  if u < 0 { return false }
  const t = tyAt(u)
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    if tySame(t.uMembers[i], mt) { return true }
    i = i + 1
  }
  false
}

// The interned slot of a slot-carrying result token (`>s3;`, `>n1;`, `>V0;`, `>r2;`,
// `>m0;`) — the `;`-terminated decimal after the token char — or -1 when the key's result
// kind carries no slot or the digits are malformed. The one result-slot digit parser;
// callers gate on `sigKeyRetKind` for which table the slot indexes.
export function sigKeyRetSlot(k: string) { sigSlotAtTok(k, sigKeyRetTokIx(k)) }

// The `;`-terminated decimal SLOT of the token starting at `ti`, or -1 when `ti` names no
// token or that kind carries no slot / malformed digits; a map shape may itself be negative.
// The ONE slot-digit parse, read by both key decoders that want one (`sigKeyRetSlot` for
// the result token, `sigParamSlotAt` for the param spine).
export function sigSlotAtTok(k: string, ti: i32): i32 {
  if ti < 0 || ti >= k.length { return -1 }
  if !repSigTokHasSlot(repKindOfSigTok(k[ti])) { return -1 }
  let j = ti + 1
  let acc = 0
  let saw = false
  // A map shape can be negative (the mono maps), written with a leading `-`.
  let neg = false
  if j < k.length && k[j] == '-' {
    neg = true
    j = j + 1
  }
  while j < k.length && k[j] != ';' {
    const d = k[j]
    if d < '0' || d > '9' { return -1 }
    acc = acc * 10 + (d - '0')
    saw = true
    j = j + 1
  }
  if !saw { return -1 }
  if neg { return 0 - acc }
  acc
}

// `exprIsClosure` restricted to forms safe to query during return-kind classification
// (avoids recursion through `declaredSlotOf`, which needs the local registry built): a
// function name, a `function(...)` literal, or an object field — the arm this ladder
// lacked, a closure-typed param or local returned by name.
function frameBindingNode(fnIx: i32, name: string): i32 {
  if fnIx < 0 { return -1 }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = nodeAt(params[i])
      if p is Param {
        if p.parName == name { return params[i] }
      }
      i = i + 1
    }
    const li = parentLetOf(fn.fnBody, name)
    if li >= 0 { return li }
    return parentLoopVarOf(fn.fnBody, name)
  }
  -1
}

// The binding the name read at `atIx` denotes as seen from frame `fnIx` or a frame around it:
// that frame's copy of the read's parameter or `let`, or the loop of a loop variable. -1 when
// none is, the only case where the name can denote a module-level global or function.
export function identBindingOfRead(fnIx: i32, atIx: i32): i32 {
  const d = identDeclOf(unwrapParen(atIx))
  if d < 0 || d >= P.nodes.length { return -1 }
  const lp = loopVarLoop(d)
  if lp >= 0 { return lp }
  const dn = nodeAt(d)
  if dn is ForRange || dn is ForIn { return d }
  if !(dn is Param || dn is LetDecl) { return -1 }
  let f = fnIx
  let pp = fnStmtsPosOf(fnIx)
  let steps = 0
  while f >= 0 && steps <= fnStmts.length {
    const hit = frameCopyOfDecl(f, d)
    if hit >= 0 { return hit }
    if pp < 0 || pp >= fnParent.length { return -1 }
    pp = fnParent[pp]
    if pp < 0 || pp >= fnStmts.length { return -1 }
    f = fnStmts[pp]
    steps = steps + 1
  }
  -1
}

// Frame `fnIx`'s copy of parameter or `let` declaration `d`: `d` itself, or the one an instance
// re-declared at its position; -1 when the frame declares neither.
function frameCopyOfDecl(fnIx: i32, d: i32): i32 {
  if fnIx < 0 || fnIx >= P.nodes.length || d < 0 || d >= P.nodes.length {
    return -1
  }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return -1 }
  const dn = nodeAt(d)
  if dn is Param {
    for p in fn.fnParams {
      if p == d || declOrigOf(p) == d { return p }
      const pn = nodeAt(p)
      if pn is Param && pn.pos == dn.pos && pn.parName == dn.parName {
        return p
      }
    }
    return -1
  }
  bodyLetOfDecl(fn.fnBody, d)
}

// Whether a frame enclosing the lifted function at position `fe` (node `fnIx`) binds `name`
// where `fnIx` reads it: any binding but a loop variable, and a loop variable only when `fnIx`
// sits inside that loop.
export function outerFrameBinds(fe: i32, fnIx: i32, name: string): boolean {
  let pp = fe
  let steps = 0
  while pp >= 0 && pp < fnParent.length && steps <= fnStmts.length {
    pp = fnParent[pp]
    if pp < 0 || pp >= fnStmts.length { return false }
    const hit = frameBindingNode(fnStmts[pp], name)
    if hit >= 0 {
      const hn = nodeAt(hit)
      if !(hn is ForRange || hn is ForIn) { return true }
      if nodeSubtreeHas(hit, fnIx) { return true }
    }
    steps = steps + 1
  }
  false
}

// True if field `prop` of struct table index `si` is a function-valued field — a bare
// closure (code 14) or a NULLABLE closure (code 22). Both read back as a closure and call
// via `call_ref`; the nullable one is recovered to non-null at the call site.
export function structFieldIsClosure(si: i32, prop: string) {
  if si < 0 || si >= sNames.length { return false }
  const cnt = sFieldCount[si]
  const start = sFieldStart[si]
  let fj = 0
  while fj < cnt {
    if sFieldNames[start + fj] == prop {
      const fc = sFieldTypeAt(si, fj)
      return fc == FC_CLOSURE || fc == FC_NUL_CLOSURE
    }
    fj = fj + 1
  }
  false
}

// Is `k` the result kind of a non-nullable list?
export function vkIsPlainList(k: VKind | null): boolean {
  k == "list"
    || k == "f64list"
    || k == "strlist"
    || k == "reflist"
    || k == "i64list"
    || k == "f32list"
    || k == "u8list"
}

// Is `k` the result kind of a nullable list, a map, a nullable map or a nullable closure?
export function vkIsBoxedRefElem(k: VKind | null): boolean {
  k == "nullist"
    || k == "nulreflist"
    || k == "nulstrlist"
    || k == "nulf64list"
    || k == "nuli64list"
    || k == "nulf32list"
    || k == "nulu8list"
    || k == "map"
    || k == "nulmap"
    || k == "nulclosure"
}

// The `.map` result kind where callback `fe` reads as `i32`. An un-annotated callback holds that
// kind until return inference reaches it, so the call's checked list rep answers where it names
// another list.
export function mfI32ResultOrColumn(callIx: i32, fnIx: i32, fe: i32): MfKind {
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return "i32" }
  }
  const d = nodeRepIn(callIx, fnIx)
  if d.rdCovered != 1 { return "i32" }
  const ks: MfKind[] = ["ref", "str", "f64", "i64", "f32"]
  let i = 0
  while i < ks.length {
    if listRepOfMf(ks[i]) == d.rdKind { return ks[i] }
    i = i + 1
  }
  "i32"
}

// The `unNames` row a box of `ty` reads through: the one whose flattened members are exactly
// `ty`'s without the repeats a substitution leaves (`T | i32` at `T := i32 | null`), else the
// first holding every one of them. A box's tag names its member, so a wider row reads it
// right. -1 when no row holds them all.
export function unRowOfFlatMembers(ty: i32): i32 {
  const xs = flatDistinctMembers(ty)
  if xs.length < 2 { return -1 }
  let cover = -1
  let u = 0
  while u < unTyIx.length {
    const ys: i32[] = []
    if unTyIx[u] >= 0 { flattenVariantsInto(unTyIx[u], ys) }
    let all = ys.length > 0
    let k = 0
    while k < xs.length {
      if !tyListHasEq(ys, xs[k]) { all = false }
      k = k + 1
    }
    if all && ys.length == xs.length { return u }
    if all && cover < 0 { cover = u }
    u = u + 1
  }
  cover
}

// `ty`'s flattened members with the repeats a substitution leaves dropped; empty when one is
// unresolved.
function flatDistinctMembers(ty: i32): i32[] {
  const raw: i32[] = []
  flattenVariantsInto(ty, raw)
  const xs: i32[] = []
  let i = 0
  while i < raw.length {
    if raw[i] < 0 { return [] }
    if !tyListHasEq(xs, raw[i]) { xs.push(raw[i]) }
    i = i + 1
  }
  xs
}

// Whether some member of `xs` is `tyEq` to `t`.
function tyListHasEq(xs: i32[], t: i32): boolean {
  let i = 0
  while i < xs.length {
    if xs[i] >= 0 && tyEq(xs[i], t) { return true }
    i = i + 1
  }
  false
}

// True if the lifted callback at `fe` returns a BOOLEAN (its annotation, or the
// inferred `fRetBool`) — the element-bool-ness of a `.map` result, threaded to the
// print import choice (`__print_bool__` renders true/false).
export function mfCbRetIsBool(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      // Drops the `rt is TypeRef` gate the spelling path needed: a non-`TypeRef` return
      // annotation still has a recorded type, so the name form couldn't even ask.
      return tyIsBool(fn.fnRet)
    }
    if fe < fRetBool.length { return fRetBool[fe] == 1 }
  }
  false
}

// The function-type nominalizer, on the arena: built from `TyFunc`'s own param and result
// types instead of by slicing a rendered function name apart and re-parsing each piece.
// Each part is nominalized by `shapeNominalOfTy` and otherwise rendered. "" means the type
// is not a `TyFunc`. A litunion alias keeps its name at both parameter and result positions.
function nominalizePartOfTy(ty: i32): string {
  const al = litUnionAliasNameOfTy(ty)
  if al != "" { return al }
  const sn = shapeNominalOfTy(ty)
  if sn != "" { return sn }
  tyToEmitName(ty)
}

export function nominalizeFnTypeOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const t = tyAt(ty)
  if !(t is TyFunc) { return "" }
  let out = "("
  const pts = t.fnParamTypes
  let i = 0
  while i < pts.length {
    if i > 0 { out = out + "," }
    out = out + nominalizePartOfTy(pts[i])
    i = i + 1
  }
  out + ")=>" + fnResultEmitName(t.fnRet)
}

// A function type's result as the emitter spells it: `never` lowers as `void`, since the
// callee leaves nothing and each call site follows it with `unreachable` (D1972).
function fnResultEmitName(ty: i32): string {
  if ty >= 0 {
    const r = tyAt(ty)
    if r is TyPrim {
      if r.primName == "never" { return "void" }
    }
  }
  nominalizePartOfTy(ty)
}

// Does struct `si` carry a closure-valued field `name` (code 14)?
export function drwFieldClosure(si: i32, name: string) {
  if si < 0 { return false }
  const fi = sFieldIndex(si, name)
  if fi < 0 { return false }
  sFieldTypeAt(si, fi) == FC_CLOSURE
}

// `shapeNominalOfTy` asked of an ARRAY's ELEMENT: peel the `TyArray`, then resolve. "" when the
// node is not an array or the element does not resolve to a declared row.
export function arrElemNominalOfTy(arrIx: i32): string {
  const aty = nodeTyIxOf(arrIx)
  if aty < 0 { return "" }
  const at = tyAt(aty)
  if at is TyArray { return shapeNominalOfTy(at.aElem) }
  ""
}

// The map-value twin of `arrElemNominalOfTy` (D88): `shapeNominalOfTy` recurses through
// `TyArray`, but nothing asked it about a map value, so `tyToEmitName` rendered a declared
// arm structurally there instead — two map structs for one map, `vl check` rc 0 and the
// engine refusing. The value's variant row is the narrowing kept; only the value text changes.
export function nodeMapArmNominalName(ix: i32, fnIx: i32): string {
  const ty = nodeTyAt(ix, fnIx)
  if ty < 0 { return "" }
  const t = tyAt(ty)
  if t is TyMap {
    const vr = repVariantShapeRowOf(t.mVal)
    if vr < 0 { return "" }
    if vr >= uVariants.length { return "" }
    const whole = tyToEmitName(ty)
    if mapSpellKeyEnd(whole) < 0 { return "" }
    return "{[" + mapSpellKeyName(whole) + "]:" + uVariants[vr] + "}"
  }
  ""
}

// The declared struct or variant name the record (or record list) type `ty` resolves to, or ""
// for none. A literal's `#anon` row names no type, so it counts as none (D5049).
function declNominalOfTy(ty: i32): string {
  const nm = shapeNominalOfTy(ty)
  if strContains(nm, "#anon") { return "" }
  nm
}

// `declNominalOfTy`, else `spelled`, the caller's render of `ty`, unchanged.
export function shapeNominalOr(ty: i32, spelled: string): string {
  const nm = declNominalOfTy(ty)
  if nm == "" { return spelled }
  nm
}

// Does the annotation at `ix` spell a function type anywhere? The tree when it survives,
// the rendered name's arrow scan when it does not.
export function annCloSigSpelled(ix: i32, nm: string): boolean {
  const root = annTsOf(ix)
  if root >= 0 { return tsHasKind(root, TS_FUNC) }
  strContains(nm, "=>")
}

// Is the annotation at `ix` spelled as an inline object shape (`{a: i32}`, not a map
// `{[k]: v}`)? The tree's root kind where the tree survives, the rendering's opening
// characters where it does not.
function annIsSpelledInlineShape(ix: i32, nm: string): boolean {
  const root = annTsOf(ix)
  if root >= 0 { return tsKind[root] == TS_OBJ }
  nameIsShapeSpanEnds(nm)
}
