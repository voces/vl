// `emit_sig_tokens.vl` — the signature tokens of parameters and returns, and the
// annotated kind a parameter or return lowers as.

import { recRepWidens } from "./check_bind_adopt"
import {
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  LetDecl,
  P,
  Param,
  TS_OBJ,
  TypeRef,
  annTsOf,
  loopVarLoop,
