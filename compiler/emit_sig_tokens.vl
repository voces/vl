} from "./check_types"
import { sFieldTypeAt } from "./emit_atom_kinds"
import {
  callOriginOf,
  nameIsShapeSpanEnds,
  normTypeAtom,
  parentLetCoversAt,
  parentLetOf,
  parentLoopVarOf,
  tyIsBool,
  tyIsFuncType,
