} from "./emit_shape_rows"
import {
  FC_CLOSURE,
  FC_MAP,
  FC_NUL_CLOSURE,
  FC_STR,
  VKind,
  emitRootIx,
  fRetBool,
  fRetKind,
  fRetStructIdx,
