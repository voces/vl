// Which FILE a token came from, and how that file is spelled. One table, one reader: the
// driver fills it while it loads modules, and both the driver's `modOfTok` and the emitter's
// name section read through the functions below — so a backtrace, a diagnostic and
// find-references cannot spell one file two ways. A leaf with no imports and no top-level
// work: the LSP compiles on every keystroke and must not pay for loading this.

// A module's tokens occupy a contiguous range of the merged `P.toks`. `smStart[i]` is where
// range `i` begins and `smMod[i]` is the module table index it belongs to, pushed in load
// order. `smKeys` is the resolved key per module, `[0]` being the entry.
let smStart: i32[] = []
let smMod: i32[] = []
let smKeys: string[] = []
// Whether `smStart` is non-decreasing in push order, so a binary search finds the same range
// the scan would. Only this file writes `smStart`, and only by push and reset.
let smSorted = true

// Drop the previous program's ranges. Called where the driver resets its module tables, so a
// second compile in one process cannot read the first one's files.
export function srcmapReset() {
  smStart = []
  smMod = []
  smKeys = []
  smSorted = true
  0
}

// Record that module `mod`'s tokens begin at `start`.
export function srcmapPush(start: i32, mod: i32) {
  if smStart.length > 0 && start < smStart[smStart.length - 1] {
    smSorted = false
  }
  smStart.push(start)
  smMod.push(mod)
  0
}

// The resolved module keys, `[0]` the entry. Copied rather than aliased: the driver reuses
// its own array across compiles.
export function srcmapSetKeys(keys: string[]) {
  smKeys = []
  let i = 0
  while i < keys.length {
    smKeys.push(keys[i])
    i = i + 1
  }
  0
}

// The module (table index) token `tok` belongs to — the LAST range that starts at or before
// it. Single-file mode records no range and answers 0, which is the entry.
export function srcmapModOfTok(tok: i32): i32 {
  if smSorted {
    // The first range starting after `tok`; the one before it is the last at or before it.
    let lo = 0
    let hi = smStart.length
    while lo < hi {
      const mid = (lo + hi) / 2
      if smStart[mid] <= tok { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { return 0 }
    return smMod[lo - 1]
  }
  let best = 0
  let o = 0
  while o < smStart.length {
    if smStart[o] <= tok { best = smMod[o] }
    o = o + 1
  }
  best
}

// Every module with a range, in load order, each once; empty in single-file mode.
export function srcmapLoadOrder(): i32[] {
  const out: i32[] = []
  for m in smMod {
    let seen = false
    for x in out {
      if x == m { seen = true }
    }
    if !seen { out.push(m) }
  }
  out
}

// The one-past-the-end index of `s`'s last `/`, or 0 when it has none — the length of the
// directory prefix, so `slice(0, dirEnd)` is the directory and `slice(dirEnd)` the file name.
function smDirEnd(s: string): i32 {
  let cut = 0
  let i = 0
  while i < s.length {
    if s[i] == '/' { cut = i + 1 }
    i = i + 1
  }
  cut
}

// How module `mod` is SPELLED in a backtrace: relative to the ENTRY module's directory, which
// is the key the merged graph already uses, so one file reads one way everywhere. The entry
// is its own bare file name. A key outside the entry's directory keeps its full spelling
// rather than growing a `../` chain nothing else in the tree prints.
export function srcmapPathOf(mod: i32): string {
  if mod < 0 || mod >= smKeys.length { return "" }
  const key = smKeys[mod]
  if smKeys.length == 0 { return key }
  const dirEnd = smDirEnd(smKeys[0])
  if dirEnd == 0 { return key }
  if key.length <= dirEnd { return key }
  if key.slice(0, dirEnd) != smKeys[0].slice(0, dirEnd) { return key }
  key.slice(dirEnd, key.length)
}

// The file a TOKEN came from, spelled as `srcmapPathOf` spells it. The one call the emitter
// makes, so it never touches the module table itself.
export function srcmapFileOfTok(tok: i32): string {
  srcmapPathOf(srcmapModOfTok(tok))
}
