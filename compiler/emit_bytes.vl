// `emit_bytes.vl` — the wasm byte-emission layer: the streaming writers (`wU8`/`wULEB`/
// `wSLEB`/`wName`/`wSection`) and the `fb*` instruction/type encoders (`fbValtype`,
// `fbStructNew`, `fbCallIndirect`, …), plus `emitFail` and the map-type-index helpers they
// use. It reads/writes the shared `emit_state` and calls the pure lower modules, but
// never the lowering — a clean layer (`emit_state → emit_bytes → wasmEmit`).

import { f32Bytes, f64Bytes, gIeeeOverflow } from "./emit_bignum"
import {
  MfKind,
  VKind,
  W,
  aTypeIdx,
  aUsed,
  arrNewScratchBase,
  atomStageSlot,
  ba8TypeIdx,
  ba8Used,
  bl8TypeIdx,
  callRefSlot,
  cloEqScratchBase,
  cloStructIdx,
  coalesceCallBoolSlot,
  coalesceCallSlot,
  coalesceCallStrSlot,
  curBuf,
  emitCurFnIx,
  emitCurStmtIx,
  emitErr,
  emitErrAt,
  emitFailed,
  f32PushScratchBase,
  f64PushScratchBase,
  fa32TypeIdx,
  fa64TypeIdx,
  fbScratchCur,
  fl32TypeIdx,
  fl64TypeIdx,
  fnListCatKinds,
  fnListCatSlots,
  fnListEqGKinds,
  fnListEqGSlots,
  fnListEqRSlots,
  fnMvBase,
  fnRefPushSlots,
  fnUsesArrNew,
  fnUsesAtomStage,
  fnUsesCallRef,
  fnUsesCloEq,
  fnUsesCoalesceCall,
  fnUsesF32Push,
  fnUsesF64Push,
  fnUsesI64Push,
  fnUsesListEqI,
  fnUsesListEqS,
  fnUsesMap,
  fnUsesMapFilter,
  fnUsesMapKeys,
  fnUsesMapVals,
  fnUsesNulStrPush,
  fnUsesNumCast,
  fnUsesPush,
  fnUsesStrOp,
  fnUsesStrPush,
  fnUsesU8Push,
  fnUsesUnionAs,
  fnUsesUnionLetSink,
  fnUsesUnionSink,
  fnUsesVariantRebox,
  i64PushScratchBase,
  ia64TypeIdx,
  il64TypeIdx,
  lTypeIdx,
  lcatBases,
  leqIScratchBase,
  leqRBases,
  leqSScratchBase,
  leqgBases,
  liBack,
  liKinds,
  liSlots,
  listIdxScratchBase,
  localIsRef,
  localStructIdx,
  mI32Used,
  mStructI32Idx,
  mStructIdx,
  mapI32Base,
  mapKeysBase,
  mapScratchBase,
  mapValsBase,
  mfDstBases,
  mfDstKinds,
  mfDstSlots,
  mfScratchBase,
  mfSrcBases,
  mfSrcKinds,
  mfSrcSlots,
  mkArrIdx,
  mkListIdx,
  mvMapTypeIdx,
  mvRlSlot,
  mvValKind,
  mvValName,
  mvValStructIdx,
  mvValsOutBase,
  numCastF32Slot,
  numCastF64Slot,
  numCastI64Slot,
  pushScratchBase,
  refPushBaseBySlot,
  refPushScratchBase,
  rlBackIdx,
  rlElemHeap,
  rlElemNullable,
  rlWrapIdx,
  sBackIdx,
  sHeapIdx,
  sTypeIdx,
  strCatSlotIx,
  strPushScratchBase,
  strScratchBase,
  u8PushScratchBase,
  uBoxIdx,
  uBoxNewEnd,
  uVarHeap,
  unionAsSlot,
  unionSinkBase,
  variantReboxSlot,
} from "./emit_state"

// ── wasm opcode / type-byte constants ─────────────────────────────────────────
// Named constants for the raw wasm bytes this encoder emits — instruction opcodes,
// GC-prefixed sub-opcodes, valtype/reftype/heaptype bytes. Data bytes (SLEB
// payloads, counts, indices, memarg align/offset) are not named — operands, not opcodes.
const OP_UNREACHABLE = 0x00
const OP_BLOCK = 0x02
const OP_LOOP = 0x03
const OP_IF = 0x04
const OP_ELSE = 0x05
const OP_END = 0x0b
const OP_BR = 0x0c
const OP_BR_IF = 0x0d
const OP_RETURN = 0x0f
const OP_CALL = 0x10
const OP_CALL_INDIRECT = 0x11
const OP_RETURN_CALL = 0x12
const OP_DROP = 0x1a
const OP_SELECT = 0x1b
// Locals / globals.
const OP_LOCAL_GET = 0x20
const OP_LOCAL_SET = 0x21
const OP_LOCAL_TEE = 0x22
const OP_GLOBAL_GET = 0x23
const OP_GLOBAL_SET = 0x24
// Memory.
const OP_I32_LOAD = 0x28
const OP_I32_STORE = 0x36
// Numeric consts.
const OP_I32_CONST = 0x41
const OP_I64_CONST = 0x42
const OP_F32_CONST = 0x43
const OP_F64_CONST = 0x44
// Comparisons / conversions.
const OP_I32_EQZ = 0x45
// The numeric conversion block (wasm 1.0, §5.4.6) is contiguous 0xa7..0xbb; the
// signed members below are the ones the explicit `x as T` cast (B2) can select.
const OP_I32_WRAP_I64 = 0xa7
const OP_I32_TRUNC_F32_S = 0xa8
const OP_I32_TRUNC_F64_S = 0xaa
const OP_I64_EXTEND_I32_S = 0xac
const OP_I64_TRUNC_F32_S = 0xae
const OP_I64_TRUNC_F64_S = 0xb0
const OP_F32_CONVERT_I32_S = 0xb2
const OP_F32_CONVERT_I64_S = 0xb4
const OP_F32_DEMOTE_F64 = 0xb6
const OP_F64_CONVERT_I32_S = 0xb7
const OP_F64_CONVERT_I64_S = 0xb9
const OP_F64_PROMOTE_F32 = 0xbb
// The exactness-test opcodes the numeric `as` trio needs (D1041): a cast to an integer
// target succeeds iff the value is exactly representable there, so the lowering asks "is
// it integral" and "is it in range" before converting. Grouped here as a block since
// nothing else in the emitter compares two floats or truncates one toward an integral float.
const OP_I32_AND = 0x71
const OP_I64_EQ = 0x51
const OP_I64_LE_S = 0x57
const OP_I64_GE_S = 0x59
const OP_F32_EQ = 0x5b
const OP_F32_LT = 0x5d
const OP_F32_LE = 0x5f
const OP_F32_GE = 0x60
const OP_F64_EQ = 0x61
const OP_F64_LT = 0x63
const OP_F64_LE = 0x65
const OP_F64_GE = 0x66
const OP_F32_TRUNC = 0x8f
const OP_F64_TRUNC = 0x9d
// Reference instructions.
const OP_REF_NULL = 0xd0
const OP_REF_AS_NON_NULL = 0xd4
// GC prefix (0xfb) + its sub-opcodes (the byte following the prefix).
const GC_PREFIX = 0xfb
const GC_STRUCT_NEW = 0x00 // struct.new
const GC_STRUCT_GET = 0x02 // struct.get
const GC_STRUCT_SET = 0x05 // struct.set
const GC_ARRAY_NEW = 0x06 // array.new
const GC_ARRAY_NEW_DEFAULT = 0x07 // array.new_default
const GC_ARRAY_NEW_FIXED = 0x08 // array.new_fixed
const GC_ARRAY_GET = 0x0b // array.get
// The PACKED read. `array.get_s` (0x0c) sign-extends and `array.get_u` (0x0d)
// zero-extends; `u8[]` is unsigned by name and by the 0..255 range its element type
// claims, so only the `_u` form appears. (An `i8[]` storage type, if VL ever grows one,
// is the same machinery with 0x0c — see the report.)
const GC_ARRAY_GET_U = 0x0d // array.get_u
const GC_ARRAY_SET = 0x0e // array.set
const GC_ARRAY_LEN = 0x0f // array.len
const GC_ARRAY_COPY = 0x11 // array.copy
const GC_REF_CAST = 0x16 // ref.cast (non-null)
// Value-type bytes.
const VT_F64 = 0x7c
const VT_F32 = 0x7d
const VT_I64 = 0x7e
const VT_I32 = 0x7f
// Reference-type leading bytes.
const RT_REF_NULL = 0x63 // (ref null ht) — nullable ref
const RT_REF = 0x64 // (ref ht) — non-null ref
// Abstract heap-type bytes (operand of `ref.null`).
const HT_STRUCT = 0x6b // structref
const HT_NONE = 0x71 // none
// `anyref` — the SHORTHAND valtype byte, i.e. `(ref null any)` written as one byte.
// It is the declared type of the union box's payload field (`emit_sections`' box type
// bytes write the same 0x6e), so a local holding a payload en route to the box's single
// construction site is spelled with it.
const VT_ANYREF = 0x6e
// Redirect the writer at `buf`; return the PREVIOUS current buffer so the caller
// can restore it (closure-free save/restore — replaces threading `body`/`payload`
// through every helper).
export function wTarget(buf: i32[]) {
  const prev = curBuf
  curBuf = buf
  prev
}
// Append one byte (low 8 bits) to the current buffer.
export function wU8(b: i32) {
  curBuf.push(b & 0xff)
  0
}
// How many bytes the current buffer holds — the cursor a PEEPHOLE needs to describe
// the instruction it is about to rewrite.
export function wLen() { curBuf.length }
// The byte `back` positions from the END of the current buffer (`0` = the last one),
// or `-1` when the buffer is shorter than that. Reading past the start is a question,
// not an error: a peephole asks it precisely to find out whether its pattern fits.
export function wPeekBack(back: i32) {
  const n = curBuf.length
  if back < 0 { return -1 }
  if back >= n { return -1 }
  curBuf[n - 1 - back]
}
// Whether the `n` bytes of the current buffer at `a` equal the `n` at `b` — the byte-
// identity question a pool asks of two entries it has just rendered into one buffer,
// without a copy or a second render. Used by the `$fnsig` pool's twin column (D351); a
// range running past the end answers `false` rather than reading out of bounds.
export function wRangeEq(a: i32, b: i32, n: i32) {
  if a == b { return true }
  if a < 0 || b < 0 || n < 0 { return false }
  if a + n > curBuf.length || b + n > curBuf.length { return false }
  let i = 0
  while i < n {
    if curBuf[a + i] != curBuf[b + i] { return false }
    i = i + 1
  }
  true
}
// Drop the last `n` bytes of the current buffer. The ONLY unwriting primitive; a
// peephole uses it to remove an instruction it has just matched, and must re-emit a
// replacement leaving the wasm operand stack in the same state.
export function wDropBack(n: i32) {
  let k = n
  while k > 0 {
    if curBuf.length == 0 { return 0 }
    curBuf.pop()
    k = k - 1
  }
  0
}
// Append every byte of `bs` in order to the current buffer.
export function wBytes(bs: i32[]) {
  let i = 0
  while i < bs.length {
    wU8(bs[i])
    i = i + 1
  }
  0
}
// Streaming unsigned-LEB: append straight to the current buffer (used for
// section-length framing and operand encoding). A direct 7-bit shift loop —
// one LEB is written per wasm operand, so this path must not allocate.
export function wULEB(value: i32) {
  let v = value
  let more = true
  while more {
    const byte = v & 0x7f
    v = v >>> 7
    if v == 0 {
      curBuf.push(byte)
      more = false
    } else {
      curBuf.push(byte | 0x80)
    }
  }
  0
}
// Streaming signed-LEB: append straight to the current buffer. Same shift loop
// with the SLEB termination rule: stop once the remaining value is all-0 with
// the sign bit clear, or all-1 with the sign bit set.
export function wSLEB(value: i32) {
  let v = value
  let more = true
  while more {
    const byte = v & 0x7f
    v = v >> 7
    let signBit = 0
    if (byte & 0x40) != 0 { signBit = 1 }
    if (v == 0 && signBit == 0) || (v == -1 && signBit == 1) {
      curBuf.push(byte)
      more = false
    } else {
      curBuf.push(byte | 0x80)
    }
  }
  0
}
// Writes a name: ULEB(byte length) followed by the name's UTF-8 encoding. Only correct
// for ASCII, where each `s[i]` char code is its own byte — a code point past 0x7F needs
// multi-byte UTF-8 this writer does not produce, so it fails loudly rather than corrupt
// the section. Identifiers lex ASCII-only today.
export function wName(s: string) {
  wULEB(s.length)
  let i = 0
  while i < s.length {
    if s[i] > 0x7f {
      return emitFail("emitProgram: non-ASCII name is not encodable: " + s)
    }
    wU8(s[i])
    i = i + 1
  }
  0
}
// ── section framing ─────────────────────────────────────────────────────────
// A section is: id byte, then ULEB(byte-length of payload), then payload. The payload
// is built eagerly into a temporary `i32[]`, then framed onto the current buffer — no
// backpatching, no closures or builder objects.
export function wSection(id: i32, payload: i32[]) {
  wU8(id)
  wULEB(payload.length)
  wBytes(payload)
  0
}
// ── control flow / locals / consts (the universal base — Phase B) ─────────────
// local.get / local.set / local.tee: 0x20/0x21/0x22 <localidx-uleb>.
export function fbLocalGet(i: i32) {
  wU8(OP_LOCAL_GET) // 0x20 local.get
  wULEB(i)
  0
}
export function fbLocalSet(i: i32) {
  wU8(OP_LOCAL_SET) // 0x21 local.set
  wULEB(i)
  0
}
// `local.tee i` — store the stack top into local `i` and LEAVE it on the stack, i.e.
// `local.set` + `local.get` in one opcode. For a value that is both consumed here and
// needed again later, this is the one-instruction spelling of the pair.
export function fbLocalTee(i: i32) {
  wU8(OP_LOCAL_TEE) // 0x22 local.tee
  wULEB(i)
  0
}
// global.get / global.set: 0x23/0x24 <globalidx-uleb>.
export function fbGlobalGet(i: i32) {
  wU8(OP_GLOBAL_GET) // 0x23 global.get
  wULEB(i)
  0
}
export function fbGlobalSet(i: i32) {
  wU8(OP_GLOBAL_SET) // 0x24 global.set
  wULEB(i)
  0
}
// i32.const: 0x41 <value-sleb>.
export function fbI32Const(v: i32) {
  wU8(OP_I32_CONST) // 0x41 i32.const
  wSLEB(v)
  0
}
// Signed-LEB128 over a 64-bit value carried as a `(hi, lo)` i32 pair, both read as
// unsigned 32-bit lanes, shifted right 7 bits at a time across the lane boundary by
// hand — `wSLEB`'s i32 form cannot be reused, since its `v >> 7` is a 32-bit arithmetic
// shift. Stops once the remaining value is all-0 (sign bit clear) or all-1 (sign bit set).
export function wSLEB64(hi: i32, lo: i32) {
  let h = hi
  let l = lo
  let more = true
  while more {
    const byte = l & 0x7f
    // Arithmetic 64-bit right shift by 7: the low lane gets its top 25 bits plus the
    // low 7 bits of `hi` rotated in; the high lane is a signed `>> 7` so a negative
    // value's sign bit propagates. For a non-negative value signed and unsigned shift
    // agree, so it encodes the same either way.
    const newLo = (l >>> 7) | (h << 25)
    const newHi = h >> 7
    l = newLo
    h = newHi
    let signBit = 0
    if (byte & 0x40) != 0 { signBit = 1 }
    // Remaining value is "done" when both lanes are 0 (non-negative tail) or both
    // lanes are all-ones, i.e. -1 (negative tail) — matching SLEB's sign rule.
    if l == 0 && h == 0 {
      if signBit == 0 {
        wU8(byte)
        more = false
      } else {
        wU8(byte | 0x80)
      }
    } else if l == (-1) && h == (-1) {
      if signBit == 1 {
        wU8(byte)
        more = false
      } else {
        wU8(byte | 0x80)
      }
    } else {
      wU8(byte | 0x80)
    }
  }
  0
}
// i64.const: 0x42 <value-sleb64>. The 64-bit literal value is carried as a (hi,
// lo) i32 pair (`parseI64Pair`) and signed-LEB-encoded over 64 bits (`wSLEB64`).
export function fbI64Const(hi: i32, lo: i32) {
  wU8(OP_I64_CONST) // 0x42 i64.const
  wSLEB64(hi, lo)
  0
}
// i64.extend_i32_s: 0xac. Sign-extends an i32 on the stack to i64 — the bridge
// inserted when an i32-typed value (e.g. a bare integer literal) is used where i64
// is expected. (Slice 1 prefers typing the literal directly as i64; this is the
// fallback for a non-literal i32 source.)
export function fbI64ExtendI32S() {
  wU8(OP_I64_EXTEND_I32_S) // 0xac i64.extend_i32_s
  0
}
// f64.const: 0x44 followed by the raw little-endian IEEE-754 double (`f64Bytes`). A
// literal whose magnitude overflows f64 is a compile error — the checker rejects it
// first (`f64LitOverflows`); this `gIeeeOverflow` read is the emitter's defensive
// backstop on any unchecked path, using the same flag and encoder so the two agree.
export function fbF64Const(text: string) {
  wU8(OP_F64_CONST) // 0x44 f64.const
  wBytes(f64Bytes(text))
  if gIeeeOverflow {
    return emitFail("emitProgram: float literal overflows f64: " + text)
  }
  0
}
// f64.convert_i32_s: 0xb7 — widen a signed i32 on the stack to f64 (the bridge for a
// mixed i32/f64 operand, mirroring i64.extend_i32_s). (Slice 3.)
export function fbF64ConvertI32S() {
  wU8(OP_F64_CONVERT_I32_S) // 0xb7 f64.convert_i32_s
  0
}
// f32.const: 0x43 followed by the raw little-endian IEEE-754 float (`f32Bytes`).
// Same overflow backstop as `fbF64Const`, at the f32 range.
export function fbF32Const(text: string) {
  wU8(OP_F32_CONST) // 0x43 f32.const
  wBytes(f32Bytes(text))
  if gIeeeOverflow {
    return emitFail("emitProgram: float literal overflows f32: " + text)
  }
  0
}
// f32.convert_i32_s: 0xb2 — widen a signed i32 on the stack to f32. (Slice 5.)
export function fbF32ConvertI32S() {
  wU8(OP_F32_CONVERT_I32_S) // 0xb2 f32.convert_i32_s
  0
}
// f64.convert_i64_s: 0xb9 — convert a signed i64 to f64. (Slice 5.)
export function fbF64ConvertI64S() {
  wU8(OP_F64_CONVERT_I64_S) // 0xb9 f64.convert_i64_s
  0
}
// f64.promote_f32: 0xbb — promote an f32 on the stack to f64 (lossless). (Slice 5.)
export function fbF64PromoteF32() {
  wU8(OP_F64_PROMOTE_F32) // 0xbb f64.promote_f32
  0
}
// ── explicit `x as T` cast conversions (B2) — the narrowing / reinterpreting
// half of the numeric-conversion block the implicit-widening helpers never emit.
// i32.wrap_i64: 0xa7 — drop the high 32 bits of an i64 (`i64 as i32`), wrapping.
export function fbI32WrapI64() {
  wU8(OP_I32_WRAP_I64) // 0xa7 i32.wrap_i64
  0
}
// f32.demote_f64: 0xb6 — round an f64 to f32 (`f64 as f32`), nearest-even.
export function fbF32DemoteF64() {
  wU8(OP_F32_DEMOTE_F64) // 0xb6 f32.demote_f64
  0
}
// f32.convert_i64_s: 0xb4 — convert a signed i64 to f32 (`i64 as f32`, may lose
// precision — the point of an explicit cast).
export function fbF32ConvertI64S() {
  wU8(OP_F32_CONVERT_I64_S) // 0xb4 f32.convert_i64_s
  0
}
// The float→integer truncating conversions are the trapping family: a NaN or an
// out-of-range operand aborts at runtime (`i32.trunc`/`i64.trunc`, not the saturating
// `_sat` variants) — deliberate, since VL's principle is that a value which cannot
// hold the cast is a program error, not something to clamp silently.
export function fbI32TruncF32S() {
  wU8(OP_I32_TRUNC_F32_S) // 0xa8 i32.trunc_f32_s
  0
}
// i32.trunc_f64_s: 0xaa — `f64 as i32`, truncate toward zero (trapping).
export function fbI32TruncF64S() {
  wU8(OP_I32_TRUNC_F64_S) // 0xaa i32.trunc_f64_s
  0
}
// i64.trunc_f32_s: 0xae — `f32 as i64`, truncate toward zero (trapping).
export function fbI64TruncF32S() {
  wU8(OP_I64_TRUNC_F32_S) // 0xae i64.trunc_f32_s
  0
}
// i64.trunc_f64_s: 0xb0 — `f64 as i64`, truncate toward zero (trapping).
export function fbI64TruncF64S() {
  wU8(OP_I64_TRUNC_F64_S) // 0xb0 i64.trunc_f64_s
  0
}
// ── the numeric exact-or-fail test (D1041) ─────────────────────────────────────────
// One writer per opcode, so the cast lowering in `wasmEmit.vl` reads as the instruction
// sequence it is. `f64.trunc`/`f32.trunc` round toward zero and stay in the float type,
// answering "is this value integral"; a NaN answers false for free (`NaN == trunc(NaN)`).
export function fbI32And() {
  wU8(OP_I32_AND)
  0
}
// i64.eq: 0x51 — the `i64 → i32` round trip's compare.
export function fbI64Eq() {
  wU8(OP_I64_EQ)
  0
}
// i64.le_s / i64.ge_s: 0x57 / 0x59.
export function fbI64LeS() {
  wU8(OP_I64_LE_S)
  0
}
export function fbI64GeS() {
  wU8(OP_I64_GE_S)
  0
}
// f64.eq / f64.lt / f64.ge: 0x61 / 0x63 / 0x66.
export function fbF64Eq() {
  wU8(OP_F64_EQ)
  0
}
export function fbF64Lt() {
  wU8(OP_F64_LT)
  0
}
export function fbF64Le() {
  wU8(OP_F64_LE)
  0
}
export function fbF64Ge() {
  wU8(OP_F64_GE)
  0
}
// f32.eq / f32.lt / f32.ge: 0x5b / 0x5d / 0x60.
export function fbF32Eq() {
  wU8(OP_F32_EQ)
  0
}
export function fbF32Lt() {
  wU8(OP_F32_LT)
  0
}
export function fbF32Ge() {
  wU8(OP_F32_GE)
  0
}
// f32.le: 0x5f — the `u8` domain's upper bound is exact at f32, so its test is `<=` where
// i32's and i64's round up and need `<` (D1587).
export function fbF32Le() {
  wU8(OP_F32_LE)
  0
}
// f64.trunc / f32.trunc: 0x9d / 0x8f — truncate toward zero WITHIN the float type.
export function fbF64Trunc() {
  wU8(OP_F64_TRUNC)
  0
}
export function fbF32Trunc() {
  wU8(OP_F32_TRUNC)
  0
}
// if: 0x04 <blocktype>. `blockType` is a single byte (0x40 void, or a valtype byte).
export function fbIf(blockType: i32) {
  wU8(OP_IF) // 0x04 if
  wU8(blockType)
  0
}
export function fbElse() {
  wU8(OP_ELSE) // 0x05 else
  0
}
// if: 0x04 <blocktype> where the block type is a REF to an interned heap type — the
// two-byte-plus-SLEB form (0x64 `(ref ht)` / 0x63 `(ref null ht)`) rather than `fbIf`'s
// single valtype byte. `nul` picks the nullable prefix.
export function fbIfRefNul(heapIdx: i32, nul: boolean) {
  wU8(OP_IF) // 0x04 if
  if nul {
    wU8(99) // 0x63 (ref null ht)
  } else {
    wU8(100) // 0x64 (ref ht)
  }
  wSLEB(heapIdx)
  0
}
// `fbIfRefNul` for the NON-null form — `if (result (ref <heapIdx>))`.
export function fbIfRef(heapIdx: i32) { fbIfRefNul(heapIdx, false) }
// block / loop: 0x02/0x03 <blocktype> (single byte, as `fbIf`).
export function fbBlock(blockType: i32) {
  wU8(OP_BLOCK) // 0x02 block
  wU8(blockType)
  0
}
export function fbLoop(blockType: i32) {
  wU8(OP_LOOP) // 0x03 loop
  wU8(blockType)
  0
}
// br / br_if: 0x0c/0x0d <depth-uleb>.
export function fbBr(depth: i32) {
  wU8(OP_BR) // 0x0c br
  wULEB(depth)
  0
}
export function fbBrIf(depth: i32) {
  wU8(OP_BR_IF) // 0x0d br_if
  wULEB(depth)
  0
}
export function fbEnd() {
  wU8(OP_END) // 0x0b end
  0
}
export function fbDrop() {
  wU8(OP_DROP) // 0x1a drop
  0
}
// The UNTYPED `select` — the operand type is inferred, so it is valid only where both
// values have the same NUMERIC valtype (a ref-typed pick needs `select_t`, 0x1c, which
// carries the valtype explicitly and is hand-written at its two sites).
export function fbSelect() {
  wU8(OP_SELECT) // 0x1b select
  0
}
export function fbUnreachable() {
  wU8(OP_UNREACHABLE) // 0x00 unreachable
  0
}
export function fbReturn() {
  wU8(OP_RETURN) // 0x0f return
  0
}
// call: 0x10 <funcidx-uleb>.
export function fbCall(fnIdx: i32) {
  wU8(OP_CALL) // 0x10 call
  wULEB(fnIdx)
  0
}
// return_call: 0x12 <funcidx-uleb> — the tail form of `fbCall`, returning the callee's
// result as the caller's own after discarding the caller's frame. Validates under the
// same subtyping rule `return` already imposes, so `emitUnionRetSink`'s `call f;
// return` → this rewrite needs no result-type comparison of its own.
export function fbReturnCall(fnIdx: i32) {
  wU8(OP_RETURN_CALL) // 0x12 return_call
  wULEB(fnIdx)
  0
}
// i32.eqz: 0x45 (used for `!a` and the while-condition inversion).
export function fbI32Eqz() {
  wU8(OP_I32_EQZ) // 0x45 i32.eqz
  0
}
// One i32 arithmetic / comparison opcode (the `binOpcode` set: 0x6a add, 0x6b sub,
// 0x6c mul, 0x6d div_s, 0x6f rem_s, 0x46 eq, 0x47 ne, 0x48 lt_s, 0x4a gt_s, 0x4c le_s,
// 0x4e ge_s). The opcode byte is resolved by `binOpcode`; this just writes it.
export function fbI32Bin(op: i32) {
  wU8(op)
  0
}
// The i32-keyed map's key hash: the murmur3 32-bit finalizer, masked non-negative to
// match `__str_hash__`'s contract, since the stored `hashes` array and `i32.rem_u` slot
// pick are shared with the string-keyed rep. Emitted at two sites from one generator so
// they cannot drift; reads the key from `srcLocal`, leaves the hash on the stack.
export function fbI32HashMix(srcLocal: i32, tmpLocal: i32) {
  fbLocalGet(srcLocal)
  fbLocalSet(tmpLocal)
  // h = (h ^ (h >>> 16)) * 0x85ebca6b
  fbLocalGet(tmpLocal)
  fbLocalGet(tmpLocal)
  fbI32Const(16)
  fbI32Bin(118)              // 0x76 i32.shr_u
  fbI32Bin(115)              // 0x73 i32.xor
  fbI32Const(0 - 2048144789) // 0x85ebca6b
  fbI32Bin(108)              // 0x6c i32.mul
  fbLocalSet(tmpLocal)
  // h = (h ^ (h >>> 13)) * 0xc2b2ae35
  fbLocalGet(tmpLocal)
  fbLocalGet(tmpLocal)
  fbI32Const(13)
  fbI32Bin(118)
  fbI32Bin(115)
  fbI32Const(0 - 1028477387) // 0xc2b2ae35
  fbI32Bin(108)
  fbLocalSet(tmpLocal)
  // h = (h ^ (h >>> 16)) & 0x7fffffff — non-negative, like `__str_hash__`
  fbLocalGet(tmpLocal)
  fbLocalGet(tmpLocal)
  fbI32Const(16)
  fbI32Bin(118)
  fbI32Bin(115)
  fbI32Const(2147483647)
  fbI32Bin(113) // 0x71 i32.and
  0
}
// i32.store: 0x36 <align-exp> <offset> — fixed four-byte align (exponent 2), offset 0,
// matching the host's `__store_i32__` builtin body (`m.i32.store(0, 4, addr, v)`).
export function fbI32Store() {
  wU8(OP_I32_STORE) // 0x36 i32.store
  wU8(2)            // align exponent (4-byte alignment)
  wU8(0)            // offset 0
  0
}
// i32.load: 0x28 <align-exp> <offset> — the `__load_i32__` twin of `fbI32Store`.
export function fbI32Load() {
  wU8(OP_I32_LOAD) // 0x28 i32.load
  wU8(2)           // align exponent (4-byte alignment)
  wU8(0)           // offset 0
  0
}
// ── opcode-method stubs for later families ────────────────────────────────────
// Names declared now so the method set is coherent and self-documenting; their call
// sites are not converted yet — they still push raw bytes. Each stub already emits
// the exact bytes its family's sites emit, so converting a site later is a pure swap.
export function fbStructNew(heapIdx: i32) {
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_STRUCT_NEW) // struct.new
  wULEB(heapIdx)
  // Leave the return sink's cursor on a UNION-box construction (see `uBoxNewEnd`): the
  // rewrite is legal only while this instruction is still the last one written.
  if heapIdx == uBoxIdx { uBoxNewEnd = curBuf.length }
  0
}
// ── string header accessors ───────────────────────────────────────────────────
// A `string` value is `(ref $sTypeIdx)`, the 4-field view header `{ backing, start,
// len, hash }`. These accessors are the only place the field numbers live — a direct
// `fbStructGet` elsewhere would be a second writing of the field order.
export function fbStrBack() {
  fbStructGet(sTypeIdx, 0)
  0
}
export function fbStrStart() {
  fbStructGet(sTypeIdx, 1)
  0
}
export function fbStrLen() {
  fbStructGet(sTypeIdx, 2)
  0
}
// `[string] -> [i32]` — the CACHED hash, or 0 for "not computed yet". Field 3 is the only
// MUTABLE field in the header; see the type-section comment in `emit_sections.vl` for why a
// memo does not weaken the immutability the aliasing arguments rest on.
export function fbStrHash() {
  fbStructGet(sTypeIdx, 3)
  0
}
// `[string, i32] -> []` — write the memo. The ONLY writer is `__str_hash__`'s epilogue, and
// it stores exactly the value a fresh walk returns.
export function fbStrSetHash() {
  fbStructSet(sTypeIdx, 3)
  0
}
// `[backing, start, len] -> [string]`. The hash sentinel is pushed here, not at the
// call sites: every string in the program is born through this one function, so a `0`
// written here is a `0` written by all of them — a fresh backing has no hash yet, and
// a slice cannot inherit its parent's (different bytes → different hash).
export function fbStrNew() {
  fbI32Const(0) // field 3 hash: the "not computed yet" sentinel
  fbStructNew(sTypeIdx)
  0
}

export function fbStructGet(heapIdx: i32, field: i32) {
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_STRUCT_GET) // struct.get
  wULEB(heapIdx)
  wULEB(field)
  0
}
export function fbStructSet(heapIdx: i32, field: i32) {
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_STRUCT_SET) // struct.set
  wULEB(heapIdx)
  wULEB(field)
  0
}
// GC array ops (Phase D):
export function fbArrayNew(heapIdx: i32) {
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_ARRAY_NEW) // array.new
  wULEB(heapIdx)
  0
}
export function fbArrayNewDefault(heapIdx: i32) {
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_ARRAY_NEW_DEFAULT) // array.new_default
  wULEB(heapIdx)
  0
}
export function fbArrayNewFixed(heapIdx: i32, n: i32) {
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_ARRAY_NEW_FIXED) // array.new_fixed
  wULEB(heapIdx)
  wULEB(n)
  0
}
// The packed-read dispatch, and the one place it lives: `array.get` is invalid on a
// packed-storage element, since a byte read must say whether it sign- or zero-extends.
// `u8[]` and the string backing (both `(array (mut i8))`) zero-extend, so every element
// read routes through here. Keyed on the heap index, which every reader already passes.
function heapIsPacked(heapIdx: i32) {
  if ba8Used && heapIdx == ba8TypeIdx { return true }
  aUsed && heapIdx == sBackIdx
}

export function fbArrayGet(heapIdx: i32) {
  if heapIsPacked(heapIdx) {
    wU8(GC_PREFIX)
    wU8(GC_ARRAY_GET_U) // 0x0d array.get_u — zero-extend the byte into an i32
    wULEB(heapIdx)
    return 0
  }
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_ARRAY_GET) // 0x0b array.get
  wULEB(heapIdx)
  0
}
export function fbArraySet(heapIdx: i32) {
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_ARRAY_SET) // 0x0e array.set
  wULEB(heapIdx)
  0
}
export function fbArrayLen() {
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_ARRAY_LEN) // 0x0f array.len
  0
}
export function fbArrayCopy(destHeapIdx: i32, srcHeapIdx: i32) {
  wU8(GC_PREFIX)     // 0xfb GC prefix
  wU8(GC_ARRAY_COPY) // 0x11 array.copy
  wULEB(destHeapIdx) // dest array type index
  wULEB(srcHeapIdx)  // src array type index
  0
}
// GC ref ops (Phases C/D/F):
export function fbRefCast(heapIdx: i32) {
  wU8(GC_PREFIX) // 0xfb GC prefix
  wU8(GC_REF_CAST) // 0x16 ref.cast (non-null)
  // The `ref.cast` immediate is a heaptype (s33), not a plain `typeidx`: a non-negative
  // value is a concrete type index, a negative one an abstract heaptype. Must be
  // signed-LEB128 — an unsigned write would decode a concrete index >= 64 as a negative
  // abstract heaptype. `wSLEB` is neutral below 64 (the compiler's own max is 59).
  wSLEB(heapIdx)
  0
}
// `call_indirect <typeidx> <tableidx>` (0x11): calls through the function-index i32
// popped off the stack, after the env and args. `typeidx` is the `$fnsig` functype,
// checked against the callee at runtime; `tableidx` is the funcref table, whose entry
// `i` holds wasm function `i`. A funcref field is not used: reading one back is a libcall.
export function fbCallIndirect(typeIdx: i32, tableIdx: i32) {
  wU8(OP_CALL_INDIRECT) // 0x11 call_indirect
  wULEB(typeIdx)
  wULEB(tableIdx)
  0
}
// `ref.null struct` (0xd0 0x6b) — the null env for a non-capturing function value.
export function fbRefNullStruct() {
  wU8(OP_REF_NULL) // 0xd0 ref.null
  wU8(HT_STRUCT) // structref abstract heaptype (0x6b)
  0
}
// `ref.null none` (0xd0 0x71) — the bottom null of the `any` hierarchy, the
// payload slot of a boxed union's `null` tag (the slot is `anyref`; the tag says
// it is never read).
export function fbRefNullNone() {
  wU8(OP_REF_NULL) // 0xd0 ref.null
  wU8(HT_NONE) // none abstract heaptype (0x71)
  0
}
// `ref.null <heaptype>` (0xd0 <s33>) — a typed null (a missing map value, etc.).
export function fbRefNull(heapIdx: i32) {
  wU8(OP_REF_NULL) // 0xd0 ref.null
  wSLEB(heapIdx)
  0
}
// `ref.as_non_null` (0xd4) — recover the non-null ref a nullable slot holds.
export function fbRefAsNonNull() {
  wU8(OP_REF_AS_NON_NULL) // 0xd4 ref.as_non_null
  0
}
// Record an unsupported-shape failure: keep the first message and drop any bytes
// emitted so far, so a partial/garbage module can never reach instantiation.
// Returns -1, the sentinel `emitProgram` propagates so callers can branch on it.
export function emitFail(msg: string) {
  // Anchor the diagnostic at the function currently being lowered (if any), so
  // the emit failure carries a source span instead of rendering positionless. Inside the
  // SYNTHETIC start function there is no such function — the cursor still names the last
  // user body — so the top-level statement cursor wins whenever it is armed.
  if emitCurStmtIx >= 0 { return emitFailAt(msg, emitCurStmtIx) }
  emitFailAt(msg, emitCurFnIx)
}
// The node-anchored form. `emitCurFnIx` names a whole function, wrong for a top-level
// statement since the start function lowers after every user body — the cursor would
// still name the last function in the file. A caller that has the offending node passes
// it instead, resolved through `nodeToks` like a type diag's node anchor.
export function emitFailAt(msg: string, at: i32) {
  if !emitFailed {
    emitFailed = true
    emitErr = msg
    emitErrAt = at
  }
  W.bytes = []
  -1
}
// Per-slot type accessors, each answering for the mono map on slot < 0 so callers
// thread one code everywhere: `mapTypeIdxOf` the struct.get/set type immediate,
// `mvValsWrapOf`/`mvValsBackOf` the vals list heap types, `mvValElemHeapOf` a ref value
// slot's heap type. Each guards its table read: an unresolved slot fails loudly, never traps.
export function mapTypeIdxOf(slot: i32) {
  // The i32-keyed shapes (`-4` map, `-5` Set) select the i32-keyed struct. Guarded
  // rather than assumed: reaching here with the flag unset means the collect walk
  // never saw this map's spelling, so no heap type is minted — fail loudly instead
  // of emitting a `struct.get` against the string-keyed twin (invalid wasm).
  if slot == -4 || slot == -5 {
    if !mI32Used {
      emitFail(
        "emitProgram: i32-keyed map but its map struct was not collected",
      )
      return 0
    }
    return mStructI32Idx
  }
  if slot < 0 { return mStructIdx }
  if slot >= mvMapTypeIdx.length {
    emitFail("emitProgram: map value slot has no minted map struct type")
    return 0
  }
  mvMapTypeIdx[slot]
}
export function mvValsBackOf(slot: i32) {
  if slot < 0 { return aTypeIdx }
  if mvValKind[slot] == 3 { return mkArrIdx }
  if mvValKind[slot] == 11 {
    return fa64TypeIdx // f64-valued map: f64 array backing
  }
  if mvValKind[slot] == 10 {
    return ia64TypeIdx // i64-valued map: i64 array backing
  }
  if mvValKind[slot] == 13 {
    return fa32TypeIdx // f32-valued map: f32 array backing
  }
  if mvRlSlot[slot] < 0 || mvRlSlot[slot] >= rlBackIdx.length {
    emitFail("emitProgram: map value slot has no resolved vals backing")
    return 0
  }
  rlBackIdx[mvRlSlot[slot]]
}
export function mvValElemHeapOf(slot: i32) {
  if slot < 0 { return aTypeIdx }
  if mvValKind[slot] == 3 { return sTypeIdx }
  if mvValKind[slot] == 11 {
    return fa64TypeIdx // f64-valued map: f64 array backing
  }
  if mvValKind[slot] == 10 {
    return ia64TypeIdx // i64-valued map: i64 array backing
  }
  if mvValKind[slot] == 13 {
    return fa32TypeIdx // f32-valued map: f32 array backing
  }
  if mvValKind[slot] == 6 || mvValKind[slot] == 2 || mvValKind[slot] == 14 {
    // A NESTED-map / LIST value (kind 6), a UNION value (kind 2), or a CLOSURE value (kind 14):
    // the element heap is what the ref-list slot resolved — the inner map struct (elem kind 3)
    // / list wrapper (4/6/7/8) / the union box (elem kind 2 → `uBoxIdx`) / the closure
    // fat-pointer (elem kind 5 → `cloStructIdx`).
    if mvRlSlot[slot] < 0 || mvRlSlot[slot] >= rlElemHeap.length {
      emitFail("emitProgram: map value slot has no resolved vals ref-list")
      return 0
    }
    return rlElemHeap[mvRlSlot[slot]]
  }
  // A struct value (kind 1) reads the same ref-list answer (D34) the other ref kinds use,
  // rather than re-deriving one from the struct table — the two agree for a plain struct,
  // but not for a union arm, whose slot is interned under the arm's own spelling
  // (`mvValArmName`). One source of truth, so the backing and element casts cannot disagree.
  if mvValKind[slot] == 1 {
    if mvRlSlot[slot] < 0 || mvRlSlot[slot] >= rlElemHeap.length {
      emitFail("emitProgram: map value slot has no resolved vals ref-list")
      return 0
    }
    return rlElemHeap[mvRlSlot[slot]]
  }
  if mvValStructIdx[slot] < 0 || mvValStructIdx[slot] >= sHeapIdx.length {
    emitFail("emitProgram: map value slot has no resolved struct shape")
    return 0
  }
  sHeapIdx[mvValStructIdx[slot]]
}
// Does this function reserve the union-box SINK pair (`unionSinkBase`)? The RETURN sink
// and the BINDING sink share one frame (`emit_state.vl` states why the pair's live ranges
// cannot interleave), so its reservation, its contribution to the locals COUNT and its
// two valtype runs must all read the same condition — this is where that condition lives.
function fbUsesSinkPair() { fnUsesUnionSink || fnUsesUnionLetSink }
// The WRAPPER heap-type index of a concat rep — the `{backing, len, cap}` struct both
// operands and the result are. Reads the module's interned indices, so it is only
// meaningful after `mAssignTypeIndices`; every caller runs inside a function body.
export function catWrapIdxOf(kind: i32, slot: i32) {
  if kind == 1 {
    if slot >= 0 && slot < rlWrapIdx.length { return rlWrapIdx[slot] }
    return lTypeIdx
  }
  if kind == 3 { return mkListIdx }
  if kind == 4 { return fl64TypeIdx }
  if kind == 6 { return il64TypeIdx }
  if kind == 7 { return fl32TypeIdx }
  if kind == 10 { return bl8TypeIdx }
  lTypeIdx
}

// The BACKING heap-type index of a concat rep — the raw `(array (mut T))` the two
// `array.copy`s move elements between. Paired with `catWrapIdxOf` arm for arm.
export function catBackIdxOf(kind: i32, slot: i32) {
  if kind == 1 {
    if slot >= 0 && slot < rlBackIdx.length { return rlBackIdx[slot] }
    return aTypeIdx
  }
  if kind == 3 { return mkArrIdx }
  if kind == 4 { return fa64TypeIdx }
  if kind == 6 { return ia64TypeIdx }
  if kind == 7 { return fa32TypeIdx }
  if kind == 10 { return ba8TypeIdx }
  aTypeIdx
}
// Reserve `n` wasm locals at the current cursor, returning the frame's base index
// and advancing the cursor past the frame. The single place the cursor moves.
export function fbReserve(n: i32) {
  const base = fbScratchCur
  fbScratchCur = fbScratchCur + n
  base
}
// Lays out this function's local frame: sets every `*ScratchBase` global from one
// running cursor walked in frame order. Must run after the `fnUses*`/`fnRefPushSlots`
// usage flags are populated and after `buildLocals` (so `nLocals` is final). Returns
// the cursor's end index, the first local past all scratch frames.
export function fbBeginFunc(nParams: i32, nLocals: i32) {
  fbScratchCur = nParams + nLocals
  // i32-list push grow quad (val / cap / backing / recvRef).
  pushScratchBase = fbScratchCur
  if fnUsesPush { fbReserve(4) }
  // One typed 4-slot ref-push frame per distinct pushed element-type slot, in
  // `fnRefPushSlots` order; `refPushScratchBase` aliases the FIRST such frame.
  refPushScratchBase = fbScratchCur
  let rk = 0
  while rk < fnRefPushSlots.length {
    refPushBaseBySlot.push(fbReserve(4))
    rk = rk + 1
  }
  // String-list push quad.
  strPushScratchBase = fbScratchCur
  if fnUsesStrPush { fbReserve(4) }
  // f64-list push quad (val f64 / cap / backing / recvRef).
  f64PushScratchBase = fbScratchCur
  if fnUsesF64Push { fbReserve(4) }
  // i64-list push quad (val i64 / cap / backing / recvRef).
  i64PushScratchBase = fbScratchCur
  if fnUsesI64Push { fbReserve(4) }
  // f32-list push quad (val f32 / cap / backing / recvRef).
  f32PushScratchBase = fbScratchCur
  if fnUsesF32Push { fbReserve(4) }
  // `u8[]` push quad (val i32 / cap / backing / recvRef). LAST among the push quads, so
  // every earlier frame base is unchanged in a program with no `u8[]`.
  u8PushScratchBase = fbScratchCur
  if fnUsesU8Push { fbReserve(4) }
  // String-op frame (2 string headers + the out BACKING + 4 i32 temporaries + the two
  // hoisted operand backings + their two `start` offsets — 11 slots, Stage 2b).
  strScratchBase = fbScratchCur
  if fnUsesStrOp { fbReserve(11) }
  // G8 map scratch frame (15 slots).
  mapScratchBase = fbScratchCur
  if fnUsesMap { fbReserve(15) }
  // The i32-KEYED map's extra slots (5), reserved only in a module that has one — so
  // every frame after it keeps its existing index in a string-keyed-only program.
  mapI32Base = fbScratchCur
  if fnUsesMap && mI32Used { fbReserve(5) }
  // `m.keys()` / `for k in m` key-list builder frame (6 slots).
  mapKeysBase = fbScratchCur
  if fnUsesMapKeys { fbReserve(6) }
  // `m.values()` (mono i32 map) value-list builder frame (6 slots).
  mapValsBase = fbScratchCur
  if fnUsesMapVals { fbReserve(6) }
  // Closure scratch frame (1 slot, a `(ref $cloStruct)`) for `call_ref` (lambdas).
  callRefSlot = fbScratchCur
  if fnUsesCallRef { fbReserve(1) }
  // `.map`/`.filter` HOF frame: 4 shared slots (i, n, j, the callback closure), then
  // one typed src-wrapper slot per distinct receiver list type and one typed
  // dst-backing slot per distinct result element kind.
  mfScratchBase = fbScratchCur
  if fnUsesMapFilter { fbReserve(4) }
  mfSrcBases = []
  let mfk = 0
  while mfk < mfSrcKinds.length {
    mfSrcBases.push(fbReserve(1))
    mfk = mfk + 1
  }
  mfDstBases = []
  let mfd = 0
  while mfd < mfDstKinds.length {
    mfDstBases.push(fbReserve(1))
    mfd = mfd + 1
  }
  // Ref-valued map frames: 3 typed slots per module mv slot in any map-using function
  // — mapRef, valsBk, and valStash (the pushVal/get value temporary). Allocated for
  // every mv slot rather than per-function-used ones, since locals are cheap and an
  // mv-free module reserves zero, keeping existing layouts' indices.
  fnMvBase = fbScratchCur
  if fnUsesMap {
    let mvk = 0
    while mvk < mvValName.length {
      fbReserve(3)
      mvk = mvk + 1
    }
  }
  // `m.values()` per-mv-slot OUTPUT backing (1 slot per module mv slot), reserved only when
  // the function builds a value list — the typed dual of the mv frame's `valsBk` source.
  mvValsOutBase = fbScratchCur
  if fnUsesMapVals {
    let mvo = 0
    while mvo < mvValName.length {
      fbReserve(1)
      mvo = mvo + 1
    }
  }
  // List `==`/`!=`/`+` frames (collections-design §VL.4/§VL.6), appended LAST so
  // every existing layout is untouched: the i32-list frame (A/B wrappers + the
  // concat out backing + n + i), the string-list frame, then one typed frame per
  // compared ref-list slot.
  leqIScratchBase = fbScratchCur
  if fnUsesListEqI { fbReserve(5) }
  leqSScratchBase = fbScratchCur
  if fnUsesListEqS { fbReserve(4) }
  leqRBases = []
  let lqk = 0
  while lqk < fnListEqRSlots.length {
    leqRBases.push(fbReserve(4))
    lqk = lqk + 1
  }
  // One 4-slot CONCAT frame per non-i32 list rep this function concatenates (A/B
  // wrappers, the out backing, n). Reserved AFTER the compare frames, so a function
  // that only compares keeps the layout it had.
  lcatBases = []
  let lck = 0
  while lck < fnListCatKinds.length {
    lcatBases.push(fbReserve(4))
    lck = lck + 1
  }
  // One 4-slot generic COMPARE frame per list rep this function compares that has no
  // core of its own (A/B wrappers, n, i). Reserved AFTER the concat frames, so a
  // function that only compares or only concatenates keeps the layout it had.
  leqgBases = []
  let lgk = 0
  while lgk < fnListEqGKinds.length {
    leqgBases.push(fbReserve(4))
    lgk = lgk + 1
  }
  // Closure equality frame (2 `(ref $cloStruct)` slots), appended LAST so every
  // existing layout is untouched.
  cloEqScratchBase = fbScratchCur
  if fnUsesCloEq { fbReserve(2) }
  // Array-intrinsic frame (1 i32 slot — the staged runtime length `n` of an
  // `__array_new__`/`__array_new_default__` allocation), appended after every
  // existing frame so layouts without it are untouched.
  arrNewScratchBase = fbScratchCur
  if fnUsesArrNew { fbReserve(1) }
  // Call-LHS `??` stash, appended after every existing frame so layouts without it are
  // untouched: a `(ref $uBoxIdx)` box slot, then a `(ref null $sTypeIdx)` string|null
  // slot, then an i32 boolean|null slot — one per rep the call result may take.
  coalesceCallSlot = fbScratchCur
  if fnUsesCoalesceCall { fbReserve(1) }
  coalesceCallStrSlot = fbScratchCur
  if fnUsesCoalesceCall { fbReserve(1) }
  coalesceCallBoolSlot = fbScratchCur
  if fnUsesCoalesceCall { fbReserve(1) }
  // Variant-rebox stash (1 `(ref null struct)` slot, appended after every eager frame):
  // holds a multi-field CALL result once so `emitStructExprAsVariantBox` re-reads each of
  // its fields to rebuild the arm's variant struct. Off ⇒ zero slots ⇒ layout untouched.
  variantReboxSlot = fbScratchCur
  if fnUsesVariantRebox { fbReserve(1) }
  // Union-box sink frame (2 slots: i32 tag, then anyref payload), appended after every
  // eager frame so layouts without it are untouched. Reserved from the prediction
  // (`fbUsesSinkPair`) since a `local.set` in the body needs the index before the body
  // is lowered; the exit block reading them is emitted only if a `return` actually sank.
  unionSinkBase = fbScratchCur
  if fbUsesSinkPair() { fbReserve(2) }
  // Union-`as` box slot (1 slot, a non-null `(ref $uBoxIdx)`). LAST of the EAGER frames, so
  // every earlier base is unchanged in a program that does not use the cast; the lazy list
  // frame below still follows it, exactly as it follows every other eager frame.
  unionAsSlot = fbScratchCur
  if fnUsesUnionAs { fbReserve(1) }
  // Literal-union atom-NARROW staging slot (1 slot, a non-null `(ref $sTypeIdx)`), appended
  // after `unionAsSlot` so every earlier base is unchanged in a program that never stages a
  // narrow — which is every program with no string literal union (`gLitUnionUsed` gates the
  // scan bit, so the self-hosted compiler reserves nothing).
  atomStageSlot = fbScratchCur
  if fnUsesAtomStage { fbReserve(1) }
  // Numeric exact-or-fail `as` staging (3 slots — f64, f32, i64 — one per SOURCE rep the
  // exactness test can read twice), appended after `atomStageSlot` so every earlier base is
  // unchanged in a program with no fallible numeric cast.
  numCastF64Slot = fbScratchCur
  numCastF32Slot = fbScratchCur + 1
  numCastI64Slot = fbScratchCur + 2
  if fnUsesNumCast { fbReserve(3) }
  // List-index bounds-check frame: slot 0 the shared i32 index stash, then one nullable
  // wrapper-ref slot per distinct indexed list kind, discovered lazily during lowering
  // (`listIdxWrapSlot`). Nothing is reserved here — the frame sits after every eager
  // frame, fixing its base before its size is known.
  listIdxScratchBase = fbScratchCur
  liKinds = []
  liSlots = []
  liBack = []
  strCatSlotIx = []
  lhName = []
  lhKind = []
  lhSlot = []
  lhBack = []
  lhLen = []
  lhStart = []
  lhLive = []
  lhOpen = []
  lhScanName = []
  lhScanRep = []
  fbScratchCur
}
// List-header hoist rows: a row caches one binding's list header (backing ref, `len`)
// in locals of the lazy list frame, so a loop that cannot reallocate the list reads
// them with `local.get`. Keyed on `lhName`/`lhKind`/`lhSlot`; `lhStart` is -1 on every
// list row (`hoistRowIsStr`'s discriminator), and `lhLive` scopes a header across loops.
export let lhName: string[] = []
export let lhKind: MfKind[] = []
export let lhSlot: i32[] = []
export let lhBack: i32[] = []
export let lhLen: i32[] = []
// The raw-string row's `start` local; -1 on a list row (which has no such field).
export let lhStart: i32[] = []
export let lhLive: i32[] = []
// The rows each open loop activated, innermost last — `loopHoistClose` pops the
// count its own `loopHoistOpen` returned.
export let lhOpen: i32[] = []
// Scratch for the candidate scan: the distinct identifiers used as an index
// RECEIVER in the loop body being considered, each with one representative
// `Index` node (the node the rep classifiers are asked about).
export let lhScanName: string[] = []
export let lhScanRep: i32[] = []
// One (1, i32) run — `0x7f`.
export function fbI32Run() {
  wU8(1)
  wU8(VT_I32) // 0x7f i32
  0
}
// One (1, f64) run — `0x7c`.
export function fbF64Run() {
  wU8(1)
  wU8(VT_F64) // 0x7c f64
  0
}
// One (1, i64) run — `0x7e`.
export function fbI64Run() {
  wU8(1)
  wU8(VT_I64) // 0x7e i64
  0
}
// One (1, f32) run — `0x7d`.
export function fbF32Run() {
  wU8(1)
  wU8(VT_F32) // 0x7d f32
  0
}
// One (1, anyref) run — `0x6e`. Defaultable (it is a nullable ref), so a local
// declared with it needs no pre-seed before its first `local.set`.
export function fbAnyRun() {
  wU8(1)
  wU8(VT_ANYREF) // 0x6e anyref
  0
}
// One (1, (ref ht)) run — non-null `0x64 <uleb heapIdx>`.
export function fbRefRun(heapIdx: i32) {
  wU8(1)
  wU8(RT_REF) // 0x64 (ref ht) — non-null ref
  wSLEB(heapIdx)
  0
}
// One (1, valtype) run for a DECLARED local, via the shared `fbValtype` switch
// (`kind`/`structIdx` are the `localIsRef`/`localStructIdx` codes).
export function fbLocalRun(kind: VKind, structIdx: i32) {
  wU8(1)
  fbValtype(kind, structIdx)
  0
}
// The number of (count=1) runs this function's locals vector holds: one per declared
// local plus the slot count of every reserved scratch frame. DERIVED from the same
// `fnUses*` flags + `fnRefPushSlots` that drove `fbBeginFunc`, so it cannot desync
// from the actual layout.
export function fbLocalsCount(nLocals: i32) {
  let n = nLocals
  if fnUsesPush { n = n + 4 }
  n = n + fnRefPushSlots.length * 4
  if fnUsesStrPush { n = n + 4 }
  if fnUsesF64Push { n = n + 4 }
  if fnUsesI64Push { n = n + 4 }
  if fnUsesF32Push { n = n + 4 }
  if fnUsesU8Push { n = n + 4 }
  if fnUsesStrOp { n = n + 11 }
  if fnUsesMap { n = n + 15 + mvValName.length * 3 }
  if fnUsesMap && mI32Used { n = n + 5 }
  if fnUsesMapKeys { n = n + 6 }
  if fnUsesMapVals { n = n + 6 + mvValName.length }
  if fnUsesCallRef { n = n + 1 }
  if fnUsesMapFilter { n = n + 4 }
  n = n + mfSrcKinds.length + mfDstKinds.length
  if fnUsesListEqI { n = n + 5 }
  if fnUsesListEqS { n = n + 4 }
  n = n + fnListEqRSlots.length * 4
  n = n + fnListCatKinds.length * 4
  n = n + fnListEqGKinds.length * 4
  if fnUsesCloEq { n = n + 2 }
  if fnUsesArrNew { n = n + 1 }
  if fnUsesCoalesceCall { n = n + 3 }
  if fnUsesVariantRebox { n = n + 1 }
  if fbUsesSinkPair() { n = n + 2 }
  if fnUsesUnionAs { n = n + 1 }
  if fnUsesAtomStage { n = n + 1 }
  if fnUsesNumCast { n = n + 3 }
  if liKinds.length > 0 { n = n + 1 + liKinds.length }
  n
}
// Emits the full locals vector onto `body`: the run count, then one `(1, valtype)` run
// per declared local, then the scratch frames in `fbBeginFunc`'s layout order (i32-push,
// per-slot ref-push, string-push, string-op, map). Derived from the local set and
// scratch flags rather than separately counted.
export function fbEmitLocalsVec(body: i32[], nLocals: i32) {
  const prev = wTarget(body)
  wULEB(fbLocalsCount(nLocals))
  // Declared locals (struct / list / string / ref-list ref or i32 — see `fbValtype`).
  let li = 0
  while li < nLocals {
    fbLocalRun(localIsRef[li], localStructIdx[li])
    li = li + 1
  }
  // i32-list push grow quad: pushVal i32, pushNewCap i32, pushNewBacking (ref $aTypeIdx),
  // pushRecvRef (ref $lTypeIdx) — the wrapper ref for a struct-FIELD receiver (gap #3).
  if fnUsesPush {
    fbI32Run()
    fbI32Run()
    fbRefRun(aTypeIdx)
    fbRefRun(lTypeIdx)
  }
  // One typed 4-slot ref-push frame per distinct pushed element-type slot, in
  // `fnRefPushSlots` order: pushRefVal (ref $elem), pushRefCap i32,
  // pushRefBacking (ref $back), pushRefRecvRef (ref $wrap).
  let rfk = 0
  while rfk < fnRefPushSlots.length {
    const rfs = fnRefPushSlots[rfk]
    // The push value slot is normally a non-null `(ref $elem)`, but a nullable-niche
    // element list (`(P | null)[]`, the interned `rlElemNullable` bit) pushes a
    // `(ref null $elem)` value, so its value slot must be nullable too — else
    // `xs.push(null)` mismatches.
    if rlElemNullable[rfs] == 1 {
      fbRefNullRun(rlElemHeap[rfs])
    } else {
      fbRefRun(rlElemHeap[rfs])
    }
    fbI32Run()
    fbRefRun(rlBackIdx[rfs])
    fbRefRun(rlWrapIdx[rfs])
    rfk = rfk + 1
  }
  // String-list push quad: pushStrVal (ref $sTypeIdx), pushStrCap i32,
  // pushStrBacking (ref $mkArrIdx), pushStrRecvRef (ref $mkListIdx).
  if fnUsesStrPush {
    // The VALUE slot is `(ref null $aTypeIdx)` in a function that pushes onto a
    // `(string | null)[]` — the niche shares this backing (whose element slot is already
    // nullable), so only the staging local differs. The ref-push frame above makes the same
    // distinction per element slot; here one flag covers the one string backing.
    if fnUsesNulStrPush { fbRefNullRun(sTypeIdx) } else { fbRefRun(sTypeIdx) }
    fbI32Run()
    fbRefRun(mkArrIdx)
    fbRefRun(mkListIdx)
  }
  // f64-list push quad: pushF64Val f64, pushF64Cap i32, pushF64Backing
  // (ref $fa64TypeIdx), pushF64RecvRef (ref $fl64TypeIdx).
  if fnUsesF64Push {
    wU8(1)
    wU8(VT_F64) // 0x7c f64
    fbI32Run()
    fbRefRun(fa64TypeIdx)
    fbRefRun(fl64TypeIdx)
  }
  // i64-list push quad: pushI64Val i64, pushI64Cap i32, pushI64Backing
  // (ref $ia64TypeIdx), pushI64RecvRef (ref $il64TypeIdx).
  if fnUsesI64Push {
    wU8(1)
    wU8(VT_I64) // 0x7e i64
    fbI32Run()
    fbRefRun(ia64TypeIdx)
    fbRefRun(il64TypeIdx)
  }
  // f32-list push quad: pushF32Val f32, pushF32Cap i32, pushF32Backing
  // (ref $fa32TypeIdx), pushF32RecvRef (ref $fl32TypeIdx).
  if fnUsesF32Push {
    wU8(1)
    wU8(VT_F32) // 0x7d f32
    fbI32Run()
    fbRefRun(fa32TypeIdx)
    fbRefRun(fl32TypeIdx)
  }
  // `u8[]` push quad: pushU8Val i32, pushU8Cap i32, pushU8Backing (ref $ba8TypeIdx),
  // pushU8RecvRef (ref $bl8TypeIdx). The VALUE slot is a plain i32 — a byte value is an
  // i32 in wasm, and the truncation to one byte happens in `array.set` on the packed
  // backing, not in this local.
  if fnUsesU8Push {
    fbI32Run()
    fbI32Run()
    fbRefRun(ba8TypeIdx)
    fbRefRun(bl8TypeIdx)
  }
  // String-op frame: strScrA/strScrB (string header refs), strScrOut (the backing under
  // construction), strScrI0..strScrI3 (i32 temporaries), and the hoisted operand
  // backings/offsets (strScrABk/strScrBBk, strScrAOff/strScrBOff) that keep an element
  // loop at one `array.get` per step — binaryen's LICM does not hoist a GC `struct.get`.
  if fnUsesStrOp {
    fbRefRun(sTypeIdx)
    fbRefRun(sTypeIdx)
    fbRefRun(sBackIdx)
    fbI32Run()
    fbI32Run()
    fbI32Run()
    fbI32Run()
    fbRefNullRun(sBackIdx)
    fbRefNullRun(sBackIdx)
    fbI32Run()
    fbI32Run()
  }
  // G8 map scratch frame, in slot order: mapRef, keyRef, curRef, slot, cap, entry,
  // keysBk, valsBk, chr, hcur, idxBk, rslot, liveBk, hashBk, valSet (the mono SET
  // value stash, reserved across the probe). Types match each `fbRefRun`/`fbI32Run`
  // call below, one per slot, in this same order.
  if fnUsesMap {
    fbRefRun(mStructIdx)
    fbRefRun(sTypeIdx)
    fbRefRun(sTypeIdx)
    fbI32Run()
    fbI32Run()
    fbI32Run()
    fbRefRun(mkArrIdx)
    fbRefRun(aTypeIdx)
    fbI32Run()
    fbI32Run()
    fbRefRun(aTypeIdx)
    fbI32Run()
    fbRefRun(aTypeIdx)
    fbRefRun(aTypeIdx)
    fbI32Run()
  }
  // The i32-KEYED map's extra slots, in `fbBeginFunc`'s reservation order:
  //   0 keyI32 i32, 1 keysBk (ref $aTypeIdx), 2 kOut (ref $aTypeIdx),
  //   3 kSrc (ref $aTypeIdx), 4 mapRef (ref $mStructI32Idx).
  if fnUsesMap && mI32Used {
    fbI32Run()
    fbRefRun(aTypeIdx)
    fbRefRun(aTypeIdx)
    fbRefRun(aTypeIdx)
    fbRefRun(mStructI32Idx)
  }
  // `m.keys()` / `for k in m` key-list builder frame (6 slots): outBack (ref $mkArrIdx),
  // keysBack (ref $mkArrIdx), live (ref $aTypeIdx), i, j, count (3 i32).
  if fnUsesMapKeys {
    fbRefRun(mkArrIdx)
    fbRefRun(mkArrIdx)
    fbRefRun(aTypeIdx)
    fbI32Run()
    fbI32Run()
    fbI32Run()
  }
  // `m.values()` value-list builder frame (6 slots): outBack (ref $aTypeIdx), valsBack
  // (ref $aTypeIdx), live (ref $aTypeIdx), i, j, count (3 i32).
  if fnUsesMapVals {
    fbRefRun(aTypeIdx)
    fbRefRun(aTypeIdx)
    fbRefRun(aTypeIdx)
    fbI32Run()
    fbI32Run()
    fbI32Run()
  }
  // Closure scratch slot (1, (ref $cloStruct)) for `call_ref` (lambdas).
  if fnUsesCallRef { fbRefRun(cloStructIdx) }
  // `.map`/`.filter` HOF frame: i, n, j (3 i32) + the callback closure
  // (ref $cloStruct), then the typed src-wrapper slots, then the typed dst-backing
  // slots — in `fbBeginFunc`'s reservation order.
  if fnUsesMapFilter {
    fbI32Run()
    fbI32Run()
    fbI32Run()
    fbRefRun(cloStructIdx)
  }
  let mfv = 0
  while mfv < mfSrcKinds.length {
    // The map-filter SOURCE wrapper valtype per element kind — the declarative MfKind->type-index
    // table as an EXHAUSTIVE `match` (a new `MfKind` member with no arm is a compile error).
    const sk = mfSrcKinds[mfv]
    match sk {
      "f64" => fbRefRun(fl64TypeIdx)
      "i64" => fbRefRun(il64TypeIdx)
      "f32" => fbRefRun(fl32TypeIdx)
      "ref" => fbRefRun(rlWrapIdx[mfSrcSlots[mfv]])
      "str" => fbRefRun(mkListIdx)
      "i32" => fbRefRun(lTypeIdx)
      "u8" => fbRefRun(bl8TypeIdx)
    }
    mfv = mfv + 1
  }
  let mfw = 0
  while mfw < mfDstKinds.length {
    // The map-filter DEST backing valtype per result element kind — same declarative table.
    const dk = mfDstKinds[mfw]
    match dk {
      "f64" => fbRefRun(fa64TypeIdx)
      "i64" => fbRefRun(ia64TypeIdx)
      "f32" => fbRefRun(fa32TypeIdx)
      "ref" => fbRefRun(rlBackIdx[mfDstSlots[mfw]])
      "str" => fbRefRun(mkArrIdx)
      "i32" => fbRefRun(aTypeIdx)
      "u8" => fbRefRun(ba8TypeIdx)
    }
    mfw = mfw + 1
  }
  // Ref-valued map frames (3 typed slots per module mv slot, map-using functions
  // only — `fbBeginFunc`'s reservation order): mapRef, valsBk, valStash (nullable —
  // it holds a vals-slot read, which is a `(ref null <elem>)`).
  if fnUsesMap {
    let mvr = 0
    while mvr < mvValName.length {
      fbRefRun(mvMapTypeIdx[mvr])
      fbRefRun(mvValsBackOf(mvr))
      // valStash: a SCALAR f64/i64 local for an f64/i64-valued map (kind 11/10), else the
      // nullable `(ref null <elem>)` that holds a string/struct vals-slot read.
      if mvValKind[mvr] == 11 { fbF64Run() }
      else if mvValKind[mvr] == 10 { fbI64Run() }
      else if mvValKind[mvr] == 13 { fbF32Run() }
      else { fbRefNullRun(mvValElemHeapOf(mvr)) }
      mvr = mvr + 1
    }
  }
  // `m.values()` per-mv-slot output backing (1 per mv slot, typed as the value backing).
  if fnUsesMapVals {
    let mvo = 0
    while mvo < mvValName.length {
      fbRefRun(mvValsBackOf(mvo))
      mvo = mvo + 1
    }
  }
  // List `==`/`!=`/`+` frames, in `fbBeginFunc`'s reservation order: the
  // i32-list frame (A/B wrapper refs, the concat out backing, n, i), the
  // string-list frame (A/B wrapper refs, n, i), then one typed frame per
  // compared ref-list slot (A/B wrapper refs, n, i).
  if fnUsesListEqI {
    fbRefRun(lTypeIdx)
    fbRefRun(lTypeIdx)
    fbRefRun(aTypeIdx)
    fbI32Run()
    fbI32Run()
  }
  if fnUsesListEqS {
    fbRefRun(mkListIdx)
    fbRefRun(mkListIdx)
    fbI32Run()
    fbI32Run()
  }
  let lqv = 0
  while lqv < fnListEqRSlots.length {
    const lqs = fnListEqRSlots[lqv]
    fbRefRun(rlWrapIdx[lqs])
    fbRefRun(rlWrapIdx[lqs])
    fbI32Run()
    fbI32Run()
    lqv = lqv + 1
  }
  // The concat frames, in `fbBeginFunc`'s reservation order: A/B wrapper refs, the
  // freshly-allocated out BACKING, then n. The two heap indices come off the ONE home
  // the emitter reads (`catWrapIdxOf`/`catBackIdxOf`), so a slot declared here and a
  // slot written by `emitListConcatG` cannot be two different types.
  let lcv = 0
  while lcv < fnListCatKinds.length {
    const lck2 = fnListCatKinds[lcv]
    const lcs = fnListCatSlots[lcv]
    fbRefRun(catWrapIdxOf(lck2, lcs))
    fbRefRun(catWrapIdxOf(lck2, lcs))
    fbRefRun(catBackIdxOf(lck2, lcs))
    fbI32Run()
    lcv = lcv + 1
  }
  // The generic COMPARE frames, in `fbBeginFunc`'s reservation order: A/B wrapper refs,
  // then the two i32 loop counters. Same one home for the wrapper index as the concat
  // frames above (`catWrapIdxOf`), so a slot declared here and a slot written by
  // `emitListEqGCore` cannot be two different types.
  let lgv = 0
  while lgv < fnListEqGKinds.length {
    fbRefRun(catWrapIdxOf(fnListEqGKinds[lgv], fnListEqGSlots[lgv]))
    fbRefRun(catWrapIdxOf(fnListEqGKinds[lgv], fnListEqGSlots[lgv]))
    fbI32Run()
    fbI32Run()
    lgv = lgv + 1
  }
  // Closure equality frame (2 `(ref $cloStruct)` slots, appended LAST).
  if fnUsesCloEq {
    fbRefRun(cloStructIdx)
    fbRefRun(cloStructIdx)
  }
  // Array-intrinsic frame (1 i32 slot — the staged allocation length).
  if fnUsesArrNew { fbI32Run() }
  // Call-LHS `??` stash (3 slots, appended LAST): the `(ref $uBoxIdx)` box, the
  // `(ref null $sTypeIdx)` string|null niche, then the i32 boolean|null niche.
  if fnUsesCoalesceCall {
    fbRefRun(uBoxIdx)
    fbRefNullRun(sTypeIdx)
    fbI32Run()
  }
  // Variant-rebox stash: one `(ref null struct)` slot (holds any plain-struct source ref;
  // recovered by `ref.cast (ref $plainStruct)` at each field re-read).
  if fnUsesVariantRebox {
    wU8(1)
    wU8(RT_REF_NULL) // 0x63 (ref null ht)
    wU8(HT_STRUCT) // structref abstract heaptype (0x6b)
  }
  // Union-box sink frame: the i32 tag, then the `anyref` payload — the two operands of
  // the box's single `struct.new`, in the field order it pops them.
  if fbUsesSinkPair() {
    fbI32Run()
    fbAnyRun()
  }
  // The union-`as` box slot — non-null, `local.set` before every read.
  if fnUsesUnionAs { fbRefRun(uBoxIdx) }
  // The atom-narrow staging slot — likewise non-null, `local.set` before every read.
  if fnUsesAtomStage { fbRefRun(sTypeIdx) }
  // The numeric exact-or-fail staging slots, in `fbBeginFunc`'s order: f64, f32, i64.
  if fnUsesNumCast {
    fbF64Run()
    fbF32Run()
    fbI64Run()
  }
  // Lazy list scratch frame (appended last, after every eager frame above): the shared
  // i32 index stash, then one nullable typed slot per `liBack` code — 0 a bounds-check
  // wrapper, 1/3 a list-literal destination backing, 2 an indexed-store element value,
  // 4 a cached header's hoisted `len`, plus codes 5+ documented at their own arm below.
  if liKinds.length > 0 {
    fbI32Run()
    let lix = 0
    while lix < liKinds.length {
      const lk = liKinds[lix]
      if liBack[lix] >= 100 {
        // D1510 — an object-literal order stash slot: the code carries the field code
        // (`liBack - 100`), so `100 + code` cannot collide with a code above.
        fbFieldStorageRun(liBack[lix] - 100, liSlots[lix])
      } else if liBack[lix] == 5 {
        // A chunked long string literal's destination backing (`arrLitChunkStart`'s
        // `strBack`) — the raw `(ref null $sBackIdx)` element array, not a list backing
        // and not the finished string (the header wraps it once every chunk arrives).
        // `liKinds` reads "i32" here too, so the string backing needs its own code.
        fbRefNullRun(sBackIdx)
      } else if liBack[lix] == 6 {
        // A string header stash (`strHdrSlot`) — the `(ref null $sTypeIdx)` receiver of an
        // `s[i]`/`s.charCodeAt(i)`, parked so the lowering reads `backing`, `start` and `len`
        // off one evaluation. Like code 5, its own code rather than a kind match.
        fbRefNullRun(sTypeIdx)
      } else if liBack[lix] == 7 {
        // The shared-union-field receiver stash (`sharedFieldRecvSlot`) — the
        // `(ref null $uBoxIdx)` box of a per-tag dispatch whose receiver cannot be
        // re-emitted per arm. Its own code, like 5 and 6, rather than a kind match.
        fbRefNullRun(uBoxIdx)
      } else if liBack[lix] == 8 {
        // D791 — the element-converting copy's source wrapper (`widenSrcWrapSlot`): its
        // own code rather than `liBack` 0's wrapper slot, since the bounds-check stash may
        // be live across the copy (a widening delivery can sit inside an indexed read's
        // receiver), and two writers of one slot is how a hoisted header gets clobbered.
        fbRefNullRun(rlWrapIdx[liSlots[lix]])
      } else if liBack[lix] == 9 {
        // The converting copy's fresh destination BACKING (`widenDstBackSlot`) — the
        // `(ref null $rlBack)` array the loop `array.set`s into. Same argument as code 8
        // for not sharing `liBack` 1/3's backing slot.
        fbRefNullRun(rlBackIdx[liSlots[lix]])
      } else if liBack[lix] == 13 {
        // The union-`==` operand stash (`unionEqStashSlot`, D972) — a `(ref null $uBoxIdx)`
        // box parked so the compare can read its TAG and its PAYLOAD off ONE evaluation.
        // Kind is "i32" for the reason codes 5, 6 and 7 are: the type comes from the code.
        fbRefNullRun(uBoxIdx)
      } else if liBack[lix] == 15 {
        // The RIGHT operand's box in a struct-union `==` (`unionEqStashSlot2`, D973).
        fbRefNullRun(uBoxIdx)
      } else if liBack[lix] == 17 {
        // The literal-`is` receiver stash (`unionLitIsStashSlot`, D1060) — a
        // `(ref null $uBoxIdx)` box parked so the tag test and the payload read share ONE
        // evaluation of a receiver that is not a re-readable place. Kind is "i32" for the
        // same reason codes 5, 6, 7 and 13 are: the type comes from the code.
        fbRefNullRun(uBoxIdx)
      } else if liBack[lix] == 16 {
        // A nested-shape compare's operand pair (`structEqStashSlot`, D974) — the RIGHT
        // operand is keyed `row + 1024`, so the heap lookup masks that off.
        let srow = liSlots[lix]
        if srow >= 1024 { srow = srow - 1024 }
        fbRefNullRun(sHeapIdx[srow])
      } else if liBack[lix] == 14 {
        // A struct-union `==` arm's casted payload (`unionEqArmSlot`, D973) — the RIGHT
        // operand's slot is keyed `vi + 1024`, so the heap lookup masks that off.
        let vsl = liSlots[lix]
        if vsl >= 1024 { vsl = vsl - 1024 }
        fbRefNullRun(uVarHeap[vsl])
      } else if liBack[lix] == 11 {
        // D965 — the scalar converting copy's source wrapper (`widenScalarWrapSlot`).
        // `liKinds` holds the element kind here, so the wrapper mapping matches the
        // default arm below; its own code exists only so the key space cannot collide
        // with a list row index.
        match lk {
          "f64" => fbRefNullRun(fl64TypeIdx)
          "i64" => fbRefNullRun(il64TypeIdx)
          "f32" => fbRefNullRun(fl32TypeIdx)
          "i32" => fbRefNullRun(lTypeIdx)
          "u8" => fbRefNullRun(bl8TypeIdx)
          "ref" => fbRefNullRun(rlWrapIdx[liSlots[lix]])
          "str" => fbRefNullRun(mkListIdx)
        }
      } else if liBack[lix] == 12 {
        // The scalar copy's fresh destination BACKING (`widenScalarBackSlot`) — the
        // `(ref null $fa64TypeIdx)` / `$ia64TypeIdx` array the loop `array.set`s the
        // CONVERTED element into. Same kind→backing mapping as code 1/3.
        match lk {
          "f64" => fbRefNullRun(fa64TypeIdx)
          "i64" => fbRefNullRun(ia64TypeIdx)
          "f32" => fbRefNullRun(fa32TypeIdx)
          "i32" => fbRefNullRun(aTypeIdx)
          "u8" => fbRefNullRun(ba8TypeIdx)
          "ref" => fbRefNullRun(rlBackIdx[liSlots[lix]])
          "str" => fbRefNullRun(mkArrIdx)
        }
      } else if liBack[lix] == 10 {
        // The converting copy's two i32 temporaries (`widenTmpSlot`): 0 the loop index,
        // 1 the length. `liSlots` is the WHICH, not a ref-list row.
        fbI32Run()
      } else if liBack[lix] == 18 {
        // An n-ary string concat's PART stash (`strCatSlot`) — a `(ref null $sTypeIdx)`
        // header parked so the fused lowering reads `backing`/`start`/`len` off ONE
        // evaluation of each part. Kind is "i32" for the reason codes 5, 6 and 7 are: the
        // slot type comes from the code, not from a list element kind.
        fbRefNullRun(sTypeIdx)
      } else if liBack[lix] == 1 || liBack[lix] == 3 {
        match lk {
          "f64" => fbRefNullRun(fa64TypeIdx)
          "i64" => fbRefNullRun(ia64TypeIdx)
          "f32" => fbRefNullRun(fa32TypeIdx)
          "ref" => fbRefNullRun(rlBackIdx[liSlots[lix]])
          "str" => fbRefNullRun(mkArrIdx)
          "i32" => fbRefNullRun(aTypeIdx)
          "u8" => fbRefNullRun(ba8TypeIdx)
        }
      } else if liBack[lix] == 4 {
        fbI32Run()
      } else if liBack[lix] == 2 {
        match lk {
          "f64" => fbF64Run()
          "i64" => fbI64Run()
          "f32" => fbF32Run()
          "ref" => fbRefNullRun(rlElemHeap[liSlots[lix]])
          "str" => fbRefNullRun(sTypeIdx)
          "i32" => fbI32Run()
          "u8" => fbI32Run()
        }
        // A `u8[]` element VALUE is an i32 — the byte width lives in the backing only.

      } else {
        match lk {
          "f64" => fbRefNullRun(fl64TypeIdx)
          "i64" => fbRefNullRun(il64TypeIdx)
          "f32" => fbRefNullRun(fl32TypeIdx)
          "ref" => fbRefNullRun(rlWrapIdx[liSlots[lix]])
          "str" => fbRefNullRun(mkListIdx)
          "i32" => fbRefNullRun(lTypeIdx)
          "u8" => fbRefNullRun(bl8TypeIdx)
        }
      }
      lix = lix + 1
    }
  }
  wTarget(prev)
  0
}
// One (1, (ref null ht)) run — nullable `0x63 <uleb heapIdx>`.
export function fbRefNullRun(heapIdx: i32) {
  wU8(1)
  wU8(RT_REF_NULL) // 0x63 (ref null ht) — nullable ref
  wSLEB(heapIdx)
  0
}
// Emits `ref.null <heaptype>` for a global cell of ref `kind`: the zero initializer
// that lets the cell be declared nullable before the start function `global.set`s the
// real value. Mirrors `fbValtype`'s kind→heap-index map. A scalar global (kind 0)
// never reaches here — it zero-inits with `i32.const 0`.
export function fbRefNullForKind(kind: VKind, structIdx: i32) {
  wU8(OP_REF_NULL) // 0xd0 ref.null
  // Same unresolved-slot guard as `fbValtype`: fail loudly, never read a table OOB.
  if (
    kind == "struct" ||
    kind == "reflist" ||
    kind == "nulreflist" ||
    kind == "variant" ||
    kind == "nulvariant" ||
    kind == "nulstruct"
  ) {
    if (
      structIdx < 0 ||
      ((kind == "struct" || kind == "nulstruct") && structIdx >= sHeapIdx.length) ||
      ((kind == "variant" || kind == "nulvariant") &&
        structIdx >= uVarHeap.length) ||
      ((kind == "reflist" || kind == "nulreflist") &&
        structIdx >= rlWrapIdx.length)
    ) {
      wSLEB(aTypeIdx)
      return emitFail("emitProgram: ref.null with no interned shape")
    }
  }
  if kind == "struct" || kind == "nulstruct" {
    wSLEB(sHeapIdx[structIdx])
  } else if kind == "variant" || kind == "nulvariant" {
    // The variant table, not `sHeapIdx`: without this arm a nullable-variant global cell
    // zero-inits with a `ref.null` of an unrelated type while its own valtype says
    // `uVarHeap[vi]` — a module that does not even parse. The third member of the
    // kind/slot pairing trio, and the one an exhaustiveness check does not cover (an `if`-chain).
    wSLEB(uVarHeap[structIdx])
  } else if kind == "list" || kind == "nullist" {
    wSLEB(lTypeIdx)
  } else if kind == "str" {
    wSLEB(sTypeIdx)
  } else if kind == "nulstr" {
    // `string | null` — the same string heap type, the nullability in the slot. Spelled
    // as its own arm rather than riding the `else`, since only the scalar `VKind`
    // members reach `else` here — a fallthrough answering for one rep is the shape this
    // emitter keeps re-finding as a missing arm. `fbValtype`/`fbValtypeNullable` agree.
    wSLEB(sTypeIdx)
  } else if kind == "union" {
    wSLEB(uBoxIdx)
  } else if kind == "reflist" || kind == "nulreflist" {
    wSLEB(rlWrapIdx[structIdx]) // THIS ref-list slot's wrapper struct heap-type index
  } else if kind == "map" || kind == "nulmap" {
    wSLEB(mapTypeIdxOf(structIdx)) // mono map, or THIS mv slot's map struct (nullable cell)
  } else if kind == "strlist" {
    wSLEB(mkListIdx)
  } else if kind == "f64list" {
    wSLEB(fl64TypeIdx) // the f64-list wrapper struct heap type (Slice 4)
  } else if kind == "i64list" {
    wSLEB(il64TypeIdx) // the i64-list wrapper struct heap type
  } else if kind == "f32list" {
    wSLEB(fl32TypeIdx) // the f32-list wrapper struct heap type
  } else if kind == "u8list" {
    wSLEB(bl8TypeIdx) // the `u8[]` wrapper struct heap type (packed backing)
  } else if kind == "nulstrlist" {
    wSLEB(mkListIdx) // `string[] | null` cell
  } else if kind == "nulf64list" {
    wSLEB(fl64TypeIdx) // `f64[] | null` cell
  } else if kind == "nuli64list" {
    wSLEB(il64TypeIdx) // `i64[] | null` cell
  } else if kind == "nulf32list" {
    wSLEB(fl32TypeIdx) // `f32[] | null` cell
  } else if kind == "nulu8list" {
    wSLEB(bl8TypeIdx) // `u8[] | null` cell
  } else if kind == "closure" || kind == "nulclosure" {
    wSLEB(cloStructIdx) // the closure fat-pointer struct heap type (14 non-null, 19 nullable)
  } else if kind == "variant" {
    // A kind-8 concrete-variant cell zero-inits against its own variant struct — the
    // same `uVarHeap` heap type the non-null `variant` arms write. Bounds-guarded like
    // the struct arm above: `emitFail` records and returns rather than halting, so an
    // unresolved slot must not index the table.
    if structIdx < 0 || structIdx >= uVarHeap.length {
      wSLEB(aTypeIdx)
      return emitFail("emitProgram: ref.null with no interned shape")
    }
    wSLEB(uVarHeap[structIdx])
  } else if kind == "nulnone" {
    // D1567 — the `null` type's cell: its zero is its only value, and the heaptype is
    // the abstract `none` byte, not an `s33` index — the one arm in this chain that is not a
    // table read. Paired with `fbValtype`/`fbValtypeNullable`'s own `nulnone` arms.
    wU8(HT_NONE)
  } else {
    wSLEB(aTypeIdx)
  }
  0
}
// The wrapper heap-type index a nullable-scalar-list VKind's value stores/reads through (the SAME
// wrapper the non-null leaf list uses), or -1 if `kind` is not a nullable scalar list.
export function nulScalarListWrapHeap(kind: VKind): i32 {
  if kind == "nulstrlist" { return mkListIdx }
  if kind == "nulf64list" { return fl64TypeIdx }
  if kind == "nuli64list" { return il64TypeIdx }
  if kind == "nulf32list" { return fl32TypeIdx }
  if kind == "nulu8list" { return bl8TypeIdx }
  -1
}
// The same wrapper keyed by the struct/variant field code (31 `string[]|null`, 32
// `f64[]|null`, 33 `i64[]|null`, 34 `f32[]|null`) instead of the binding VKind, for the
// field position's `pushFieldStorage`/omitted-null/value-seed lookup. Kept beside the
// type indices so the byte layer needs no classifier import.
export function nulScalarListFieldWrapHeap(code: i32): i32 {
  if code == 31 { return mkListIdx }
  if code == 32 { return fl64TypeIdx }
  if code == 33 { return il64TypeIdx }
  if code == 34 { return fl32TypeIdx }
  -1
}
// The wasm storage valtype of a struct/union-variant field, from the field's type code
// and ref-table slot — the one table both `emitTypeSection`'s field list and the D1510
// order-stash local read, so the two cannot disagree. `emitFail` does not halt, so an
// unresolved arm still writes a well-formed `0x7f` placeholder before recording the failure.
export function pushFieldStorage(code: i32, refSlot: i32) {
  if code == 3 {
    wU8(100)
    wSLEB(sTypeIdx)
  } else if code == 4 {
    wU8(100)
    wSLEB(lTypeIdx)
  } else if code == 5 {
    if refSlot < 0 || refSlot >= rlWrapIdx.length {
      wU8(127)
      return emitFail(
        "emitProgram: ref-list field element type is not interned",
      )
    }
    wU8(100)
    wSLEB(rlWrapIdx[refSlot])
  } else if code == 6 {
    wU8(100)
    wSLEB(mkListIdx)
  } else if code == 14 {
    wU8(100)
    wSLEB(cloStructIdx)
  } else if code == 15 {
    if refSlot < 0 || refSlot >= sHeapIdx.length {
      wU8(127)
      return emitFail(
        "emitProgram: nested-struct field element type is not interned",
      )
    }
    wU8(99)
    wSLEB(sHeapIdx[refSlot])
  } else if code == 16 {
    wU8(100)
    wSLEB(uBoxIdx)
  } else if code == 17 {
    wU8(124)
  } else if code == 23 {
    wU8(126)
  } else if code == 24 {
    wU8(125)
  } else if code == 35 {
    // D1008 — the packed byte list field: a non-null ref to the u8 list WRAPPER, the same
    // heap type the `u8[]` global / param / return / binding already store.
    wU8(100)
    wSLEB(bl8TypeIdx)
  } else if code == 25 {
    wU8(100)
    wSLEB(fl64TypeIdx)
  } else if code == 26 {
    wU8(100)
    wSLEB(il64TypeIdx)
  } else if code == 27 {
    wU8(100)
    wSLEB(fl32TypeIdx)
  } else if code == 18 {
    wU8(99)
    wSLEB(lTypeIdx)
  } else if nulScalarListFieldWrapHeap(code) >= 0 {
    wU8(99)
    wSLEB(nulScalarListFieldWrapHeap(code))
  } else if code == 28 {
    if refSlot < 0 || refSlot >= rlWrapIdx.length {
      wU8(127)
      return emitFail(
        "emitProgram: nullable ref-list field element type is not interned",
      )
    }
    wU8(99)
    wSLEB(rlWrapIdx[refSlot])
  } else if code == 19 {
    wU8(100)
    wSLEB(mapTypeIdxOf(refSlot))
  } else if code == 29 {
    wU8(99)
    wSLEB(mapTypeIdxOf(refSlot))
  } else if code == 20 {
    wU8(99)
    wSLEB(sTypeIdx)
  } else if code == 22 {
    wU8(99)
    wSLEB(cloStructIdx)
  } else {
    wU8(127)
  }
  0
}
// One `(1, <field storage valtype>)` locals run for the object-literal order stash's
// slot (D1510), typed off the same `pushFieldStorage` table the type section uses. A
// non-null field gets a non-null local: it is `local.set` before `local.get`, straight-
// line at one block depth, satisfying wasm's definite-assignment rule.
export function fbFieldStorageRun(code: i32, storageSlot: i32) {
  wU8(1)
  pushFieldStorage(code, storageSlot)
}
// Emit a global cell valtype, NULLABLE for refs (`0x63` instead of `0x64`) so a
// non-const ref cell can be `ref.null`-initialized. The scalar case (kind 0) is the
// same `0x7f` i32 as `fbValtype`. Only used for NON-const globals; const globals keep
// the non-null `fbValtype` (so goldens are unchanged).
export function fbValtypeNullable(kind: VKind, structIdx: i32) {
  // A struct/ref-list kind with NO resolved table slot (or one past its table)
  // would read a table out of bounds (a trap). Fail loudly instead, writing a
  // placeholder i32 so the buffer stays well-formed while `emitFail` unwinds.
  if (
    kind == "struct" ||
    kind == "reflist" ||
    kind == "nulreflist" ||
    kind == "variant" ||
    kind == "nulvariant" ||
    kind == "nulstruct"
  ) {
    if (
      structIdx < 0 ||
      ((kind == "struct" || kind == "nulstruct") && structIdx >= sHeapIdx.length) ||
      ((kind == "variant" || kind == "nulvariant") &&
        structIdx >= uVarHeap.length) ||
      ((kind == "reflist" || kind == "nulreflist") &&
        structIdx >= rlWrapIdx.length)
    ) {
      // The variant kinds read `uVarHeap`; an index past the variant table would index
      // out of bounds and trap, which this guard converts into a loud reject instead
      // (`emitFail` records and returns rather than halting, so emission keeps running
      // and an unbounded read here would otherwise still be reached).

      wU8(VT_I32)
      return emitFail("emitProgram: ref valtype with no interned shape")
    }
  }
  // The declarative VKind → nullable-cell valtype table, exhaustive like `fbValtype`'s:
  // a new VKind member without an arm is a checker-caught compile error, not a silent
  // `0x7f` — no `_` arm, deliberately. `i32` and `nulbool` are both the i32 valtype;
  // `variant` is the same `uVarHeap` struct ref `fbValtype`'s non-null arm writes, nullable.
  match kind {
    "i32" => {
      wU8(VT_I32) // 0x7f i32 (scalar, never a nullable ref)
    }
    "nulbool" => {
      wU8(VT_I32) // 0x7f i32 — the `boolean | null` sentinel niche rides an i32
    }
    "i64" => {
      wU8(VT_I64) // 0x7e i64 (scalar, never a nullable ref)
    }
    "f64" => {
      wU8(VT_F64) // 0x7c f64 (scalar, never a nullable ref)
    }
    "f32" => {
      wU8(VT_F32) // 0x7d f32 (scalar, never a nullable ref)
    }
    "struct" => {
      wU8(RT_REF_NULL) // 0x63 (ref null ht)
      wSLEB(sHeapIdx[structIdx])
    }
    "nulstruct" => {
      wU8(RT_REF_NULL)
      wSLEB(sHeapIdx[structIdx])
    }
    "list" => {
      wU8(RT_REF_NULL)
      wSLEB(lTypeIdx)
    }
    "nullist" => {
      wU8(RT_REF_NULL) // `i32[] | null` (already nullable)
      wSLEB(lTypeIdx)
    }
    "str" => {
      wU8(RT_REF_NULL)
      wSLEB(sTypeIdx)
    }
    "nulstr" => {
      wU8(RT_REF_NULL) // `string | null`: the nullable raw-array ref
      wSLEB(sTypeIdx)
    }
    "union" => {
      wU8(RT_REF_NULL)
      wSLEB(uBoxIdx)
    }
    "variant" => {
      wU8(RT_REF_NULL) // the concrete union-variant struct ref, made nullable
      wSLEB(uVarHeap[structIdx])
    }
    "nulvariant" => {
      // `Circle | null` — the SAME cell as the non-null `variant` above, because a wasm
      // local is declared nullable either way; the two differ only in the SIGNATURE
      // positions, which `fbValtype` writes.
      wU8(RT_REF_NULL)
      wSLEB(uVarHeap[structIdx])
    }
    "reflist" => {
      wU8(RT_REF_NULL)
      wSLEB(rlWrapIdx[structIdx]) // THIS ref-list slot's wrapper struct heap-type index
    }
    "nulreflist" => {
      wU8(RT_REF_NULL)
      wSLEB(rlWrapIdx[structIdx])
    }
    "map" => {
      wU8(RT_REF_NULL)
      wSLEB(mapTypeIdxOf(structIdx)) // mono map, or THIS mv slot's map struct
    }
    "nulmap" => {
      wU8(RT_REF_NULL) // `{[string]: V} | null` — the nullable map struct ref
      wSLEB(mapTypeIdxOf(structIdx))
    }
    "strlist" => {
      wU8(RT_REF_NULL)
      wSLEB(mkListIdx)
    }
    "nulstrlist" => {
      wU8(RT_REF_NULL) // `string[] | null`: the nullable string-list wrapper ref
      wSLEB(mkListIdx)
    }
    "f64list" => {
      wU8(RT_REF_NULL)
      wSLEB(fl64TypeIdx) // the f64-list wrapper struct heap-type index
    }
    "nulf64list" => {
      wU8(RT_REF_NULL) // `f64[] | null`
      wSLEB(fl64TypeIdx)
    }
    "i64list" => {
      wU8(RT_REF_NULL)
      wSLEB(il64TypeIdx) // the i64-list wrapper struct heap-type index
    }
    "nuli64list" => {
      wU8(RT_REF_NULL) // `i64[] | null`
      wSLEB(il64TypeIdx)
    }
    "f32list" => {
      wU8(RT_REF_NULL)
      wSLEB(fl32TypeIdx) // the f32-list wrapper struct heap-type index
    }
    "nulf32list" => {
      wU8(RT_REF_NULL) // `f32[] | null`
      wSLEB(fl32TypeIdx)
    }
    "nulu8list" => {
      wU8(RT_REF_NULL) // `u8[] | null` — the PACKED byte list's wrapper, made nullable
      wSLEB(bl8TypeIdx)
    }
    "u8list" => {
      wU8(RT_REF_NULL)
      wSLEB(bl8TypeIdx) // the `u8[]` wrapper struct heap-type index (packed backing)
    }
    "closure" => {
      wU8(RT_REF_NULL) // 0x63 (ref null) — nullable closure ref (lambdas)
      wSLEB(cloStructIdx)
    }
    "nulclosure" => {
      wU8(RT_REF_NULL) // 0x63 (ref null) — `((i32) => i32) | null` (already nullable)
      wSLEB(cloStructIdx)
    }
    "nulnone" => {
      // `nullref` is ALREADY the nullable bottom, so its nullable form is itself — the one
      // arm in this table where the nullable and non-null spellings coincide (D1567).
      wU8(HT_NONE)
    }
  }
  0
}

// The null value of the cell `fbValtypeNullable` declares: `ref.null $ht` for a ref
// kind, the niche sentinel for a kind riding a scalar, and a loud refusal for a bare
// scalar (its nullable rep is the union box, whose null its own sink builds). Paired
// with `fbValtypeNullable` arm for arm — a mismatch between the two is invalid wasm.
export function fbRefNullOfKind(kind: VKind, structIdx: i32) {
  // The same out-of-bounds guard `fbValtypeNullable` carries, for the same tables.
  if (
    kind == "struct" ||
    kind == "reflist" ||
    kind == "nulreflist" ||
    kind == "variant" ||
    kind == "nulvariant" ||
    kind == "nulstruct"
  ) {
    if (
      structIdx < 0 ||
      ((kind == "struct" || kind == "nulstruct") && structIdx >= sHeapIdx.length) ||
      ((kind == "variant" || kind == "nulvariant") &&
        structIdx >= uVarHeap.length) ||
      ((kind == "reflist" || kind == "nulreflist") &&
        structIdx >= rlWrapIdx.length)
    ) {
      return emitFail("emitProgram: ref null with no interned shape")
    }
  }
  match kind {
    "i32" => {
      return emitFail("emitProgram: an i32 has no null of its own")
    }
    "nulbool" => {
      fbI32Const(2) // the `boolean | null` sentinel niche
    }
    "i64" => {
      return emitFail("emitProgram: an i64 has no null of its own")
    }
    "f64" => {
      return emitFail("emitProgram: an f64 has no null of its own")
    }
    "f32" => {
      return emitFail("emitProgram: an f32 has no null of its own")
    }
    "struct" => {
      fbRefNull(sHeapIdx[structIdx])
    }
    "nulstruct" => {
      fbRefNull(sHeapIdx[structIdx])
    }
    "list" => {
      fbRefNull(lTypeIdx)
    }
    "nullist" => {
      fbRefNull(lTypeIdx)
    }
    "str" => {
      fbRefNull(sTypeIdx)
    }
    "nulstr" => {
      fbRefNull(sTypeIdx)
    }
    "union" => {
      fbRefNull(uBoxIdx)
    }
    "variant" => {
      fbRefNull(uVarHeap[structIdx])
    }
    "nulvariant" => {
      fbRefNull(uVarHeap[structIdx])
    }
    "reflist" => {
      fbRefNull(rlWrapIdx[structIdx])
    }
    "nulreflist" => {
      fbRefNull(rlWrapIdx[structIdx])
    }
    "map" => {
      fbRefNull(mapTypeIdxOf(structIdx))
    }
    "nulmap" => {
      fbRefNull(mapTypeIdxOf(structIdx))
    }
    "strlist" => {
      fbRefNull(mkListIdx)
    }
    "nulstrlist" => {
      fbRefNull(mkListIdx)
    }
    "f64list" => {
      fbRefNull(fl64TypeIdx)
    }
    "nulf64list" => {
      fbRefNull(fl64TypeIdx)
    }
    "i64list" => {
      fbRefNull(il64TypeIdx)
    }
    "nuli64list" => {
      fbRefNull(il64TypeIdx)
    }
    "f32list" => {
      fbRefNull(fl32TypeIdx)
    }
    "nulf32list" => {
      fbRefNull(fl32TypeIdx)
    }
    "nulu8list" => {
      fbRefNull(bl8TypeIdx)
    }
    "u8list" => {
      fbRefNull(bl8TypeIdx)
    }
    "closure" => {
      fbRefNull(cloStructIdx)
    }
    "nulclosure" => {
      fbRefNull(cloStructIdx)
    }
    "nulnone" => {
      // The cell's declaration is `nullref`, so its null value is `ref.null none` — the
      // ONLY value the cell can hold (D1567). Paired with the arm in `fbValtypeNullable`.
      fbRefNullNone()
    }
  }
  0
}
// ── valtype emission ───────────────────────────────────────────────────────────
// Writes a wasm value type onto the current buffer. `kind` is a `VKind` member;
// `structIdx` is the table slot it resolves through — a ref-list kind must select the
// caller's own slot, since each ref-list element type has its own wrapper, never the first.
export function fbValtype(kind: VKind, structIdx: i32) {
  // Same out-of-bounds guard as `fbValtypeNullable`: a struct/ref-list kind whose
  // table slot never resolved (or overran its table) fails loudly, never traps.
  if (
    kind == "struct" ||
    kind == "reflist" ||
    kind == "variant" ||
    kind == "nulvariant" ||
    kind == "nulstruct" ||
    kind == "nulreflist"
  ) {
    if (
      structIdx < 0 ||
      ((kind == "struct" || kind == "nulstruct") && structIdx >= sHeapIdx.length) ||
      ((kind == "variant" || kind == "nulvariant") &&
        structIdx >= uVarHeap.length) ||
      ((kind == "reflist" || kind == "nulreflist") &&
        structIdx >= rlWrapIdx.length)
    ) {
      // Same `uVarHeap` bound as `fbValtypeNullable`'s guard — see there.

      wU8(VT_I32)
      return emitFail("emitProgram: ref valtype with no interned shape")
    }
  }
  // The declarative VKind → wasm valtype table. A non-null ref is `0x64` (100), a nullable
  // ref `0x63` (99); the scalars are their valtype bytes (i32 `0x7f`/127, i64 `0x7e`/126,
  // f64 `0x7c`/124, f32 `0x7d`/125). `nulbool` rides the i32 niche. EXHAUSTIVE — a new
  // VKind member without an arm is a compile error, not a silent i32 fallthrough.
  match kind {
    "i32" => {
      wU8(VT_I32)
    }
    "nulbool" => {
      wU8(VT_I32)
    }
    "i64" => {
      wU8(VT_I64)
    }
    "f64" => {
      wU8(VT_F64)
    }
    "f32" => {
      wU8(VT_F32)
    }
    "struct" => {
      wU8(RT_REF)
      wSLEB(sHeapIdx[structIdx])
    }
    "list" => {
      wU8(RT_REF)
      wSLEB(lTypeIdx)
    }
    "str" => {
      wU8(RT_REF)
      wSLEB(sTypeIdx)
    }
    "union" => {
      wU8(RT_REF)
      wSLEB(uBoxIdx)
    }
    "reflist" => {
      wU8(RT_REF)
      wSLEB(rlWrapIdx[structIdx])
    }
    "map" => {
      wU8(RT_REF)
      wSLEB(mapTypeIdxOf(structIdx))
    }
    "strlist" => {
      wU8(RT_REF)
      wSLEB(mkListIdx)
    }
    "variant" => {
      wU8(RT_REF)
      wSLEB(uVarHeap[structIdx])
    }
    "nulvariant" => {
      // The variant-table twin of `nulstruct` just below: a NULLABLE ref (0x63) to the
      // variant's own heap type, which is what makes `Circle | null` a niche rather than
      // a box — no allocation, and `null` is the ref's own null.
      wU8(RT_REF_NULL)
      wSLEB(uVarHeap[structIdx])
    }
    "f64list" => {
      wU8(RT_REF)
      wSLEB(fl64TypeIdx)
    }
    "i64list" => {
      wU8(RT_REF)
      wSLEB(il64TypeIdx)
    }
    "f32list" => {
      wU8(RT_REF)
      wSLEB(fl32TypeIdx)
    }
    "u8list" => {
      wU8(RT_REF)
      wSLEB(bl8TypeIdx) // the `u8[]` wrapper struct heap-type index (packed backing)
    }
    "closure" => {
      wU8(RT_REF)
      wSLEB(cloStructIdx)
    }
    "nulstruct" => {
      wU8(RT_REF_NULL)
      wSLEB(sHeapIdx[structIdx])
    }
    "nullist" => {
      wU8(RT_REF_NULL)
      wSLEB(lTypeIdx)
    }
    "nulstr" => {
      wU8(RT_REF_NULL)
      wSLEB(sTypeIdx)
    }
    "nulreflist" => {
      wU8(RT_REF_NULL)
      wSLEB(rlWrapIdx[structIdx])
    }
    "nulclosure" => {
      wU8(RT_REF_NULL)
      wSLEB(cloStructIdx)
    }
    "nulstrlist" => {
      wU8(RT_REF_NULL)
      wSLEB(mkListIdx)
    }
    "nulf64list" => {
      wU8(RT_REF_NULL)
      wSLEB(fl64TypeIdx)
    }
    "nuli64list" => {
      wU8(RT_REF_NULL)
      wSLEB(il64TypeIdx)
    }
    "nulf32list" => {
      wU8(RT_REF_NULL)
      wSLEB(fl32TypeIdx)
    }
    "nulu8list" => {
      wU8(RT_REF_NULL)
      wSLEB(bl8TypeIdx)
    }
    "nulmap" => {
      // `{[string]: V} | null` — the map struct ref made NULLABLE (`0x63`). The heap
      // type is THIS value-shape's `$mapStruct` (mono ⇒ `$mStructIdx`), exactly like the
      // non-null `"map"` arm; only the ref nullability differs (the `struct → nulstruct`
      // relationship, hoisted to the map struct).
      wU8(RT_REF_NULL)
      wSLEB(mapTypeIdxOf(structIdx))
    }
    "nulnone" => {
      // `nullref` — the one-byte abstract form (`0x71`), not `0x63 <typeidx>`: `none` is
      // an abstract heap type with no interned shape, so there is no index to write. It
      // is the bottom of the GC hierarchy, which is what makes a `null`-typed result
      // assignable to every nullable ref destination without a cast (D1567).
      wU8(HT_NONE)
    }
  }
  0
}
