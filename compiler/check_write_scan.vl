// The syntax half of the covariant write scan: which binding a name means (the frame table),
// every occurrence of a name and the node above it (the occurrence index), how a callee, a
// parameter and a receiver resolve, and where a list handle escapes into a container or is
// claimed by one. The checker resets the memo tables and asks the questions, and keeps the
// halves that read the type arena; nothing here reads a type or the scope chain.
// This module imports `./ast`, `./symbols`, `./listutil` and `./check_suggest`.
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  arenaEpochNow,
  elseIfLink,
  hasNamedArgs,
  loopVarLoop,
  nodeAt,
  nodeChildrenPush,
  nodeSpineChildrenPush,
} from "./ast"
import {
  identDeclOf,
  memberDeclOf,
  methodFnOfDecl,
  sidLookup,
  sidOf,
  sidOfNode,
} from "./symbols"
import { i32ListHas, i32ListIndexOf } from "./listutil"
import { demangleName } from "./check_suggest"
import { hashMixPair } from "./hash_mix"

// —— which binding does a name mean: the frame table the write scan keys on (D1610/D1611) ——
// A name is not a value: two functions may each bind `b` and mean two lists. Every predicate
// below keys on the pair (name, frame), so a same-named handle another frame cannot reach
// neither spends D852's aliasing guard nor counts as a write through this one.

// A top-level function's name to its `FuncDecl` arena index, so a forward call can infer the
// callee on demand and a call site here can name its callee. The checker fills and resets it.
export let fnDeclIx: {[string]: i32} = Map()

// The enclosing function frame of every arena node: a `FuncDecl` index, `CW_FR_MOD` at module
// scope, `CW_FR_UNKNOWN` for a node no `Program` reaches. Frames are FUNCTION-wide, not block-
// wide, deliberately: `parentLetOf` gives the emitter one local per name per body, so a finer
// answer here would license a copy the emitter then applies to a conflated slot.
const CW_FR_MOD = -1
// Matches every frame — the conservative answer. A binder this walk does not model (a
// `MatchExpr` arm's payload `const`, before `desugarMatchAt` rewrites it) lands here, so an
// unmodelled shape stays exactly as coarse as a bare name is, never coarser.
export const CW_FR_UNKNOWN = -2
export let cwFrameOf: i32[] = []
// One row per declaration, in walk order: the declaring node, the frame it declares into and
// the interned name. The membership table below is what keeps a lookup independent of the
// frame's size, and module scope's is the whole program's top-level names.
let cwDeclNode: i32[] = []
let cwDeclFr: i32[] = []
let cwDeclSid: i32[] = []
// `(frame, sid)` membership, open-addressed with linear probing over the rows above. A slot
// with `cwDeclSlotSid == -1` is free, and the table is sized to twice the rows, so a probe
// always meets one.
let cwDeclSlotFr: i32[] = []
let cwDeclSlotSid: i32[] = []
// How many declarations the occupied slot holds: a frame may bind one name twice (two blocks).
let cwDeclSlotN: i32[] = []
// The slot's first declaration, and per arena node the first declaration of its own slot or -1:
// the key the occurrence index files a binding's rows under, one per emitted local.
let cwDeclSlotRep: i32[] = []
let cwDeclRep: i32[] = []
let cwDeclCap = 0
// The enclosing frame of a frame, indexed by its `FuncDecl` node — the chain a name walks out
// along. A lambda is a `FuncDecl` with an empty name, so capture needs no arm of its own.
// Keyed by the frames only: a node that opens none reads `CW_FR_MOD`. A map, not an
// arena-length column, so the frame build allocates nothing per node (D7740).
let cwFrameUp: {[i32]: i32} = Map()
let cwFramesBuilt = false
// The join sites (list literals, `if`s, `match`es, `??`, functions) and the `return`s the frame
// walk reaches, for the record rule's end-of-check pass, which then needs no occurrence index.
export let cwFrJoins: i32[] = []
export let cwFrRets: i32[] = []
// Each node's parent as the frame walk saw it — `cwIxParent`'s answer, filed by the walk that
// already reads every edge — and the arena epoch of that walk, -1 before a build.
let cwFrParent: i32[] = []
let cwFrParentEpoch = -1
// Whether this compilation has built an index; until it has, a frame build keeps no parents,
// since a program whose checks never ask for the index would only hold the column.
let cwIxWanted = false

export function cwFrameReset() {
  cwLexStores = Map()
  cwLexSlotStores = Map()
  cwLexDone = Map()
  cwLexBailed = Map()
  cwFrJoins = []
  cwFrRets = []
  cwFrameOf = []
  cwFrParent = []
  cwFrParentEpoch = -1
  cwDeclNode = []
  cwDeclFr = []
  cwDeclSid = []
  cwDeclSlotFr = []
  cwDeclSlotSid = []
  cwDeclSlotN = []
  cwDeclSlotRep = []
  cwDeclRep = []
  cwDeclCap = 0
  cwFrameUp = Map()
  cwFramesBuilt = false
  cwIxReset()
  0
}

// —— the occurrence index every query below reads (D1628) ——
// One grow pass over the arena, memoised beside the frame table and dropped with it, so a
// question about a NAME costs that name's own occurrences rather than a walk of the program.
// A whole-arena scan per binding is what made a self-compile non-terminating (D1090).
export const CW_OCC_USE = 0
export const CW_OCC_BIND = 1
export const CW_OCC_ASG = 2
export const CW_OCC_CALL = 3
// A method-spelled call `recv.m(…)`, filed under `m`'s plain name, carrying no frame.
export const CW_OCC_MCALL = 4
// A named `FuncDecl`, filed under its plain name so a method spelling finds merged declarations.
export const CW_OCC_FDECL = 5
// Per interned name (`sidOf`), the head of its occurrence chain, or -1.
let cwIxHead: i32[] = []
// The chain's rows: the next row, the arena node, the frame it resolves in, and which of the
// four kinds above it is. A `CW_OCC_CALL` row carries no frame.
export let cwIxNext: i32[] = []
export let cwIxNode: i32[] = []
export let cwIxFr: i32[] = []
export let cwIxKind: i32[] = []
// Per arena node: the container a place projects out of (`w` in `w.f`) and -1 elsewhere;
// whether the node IS such an object; and whether a named destination consumes this call.
let cwIxObj: i32[] = []
let cwIxIsObj: i32[] = []
let cwIxHeld: i32[] = []
// Per arena node, what CONSUMES it: the consuming node, which of the roles below that is,
// and the role's own payload (an object literal's `FieldInit`, a call argument's position).
// `CW_UP_NONE` is a form no reader models, which is what makes the whitelist below sound —
// a use the index cannot place is a use nothing claims.
export const CW_UP_NONE = 0
export const CW_UP_LETINIT = 1
export const CW_UP_ASG_LHS = 2
export const CW_UP_ASG_RHS = 3
export const CW_UP_CMP = 4
export const CW_UP_ARG = 5
export const CW_UP_CALLEE = 6
export const CW_UP_OBJ = 7
export const CW_UP_FIELD = 8
export const CW_UP_ELEM = 9
export const CW_UP_RET = 10
export const CW_UP_TAIL = 11
export const CW_UP_ITER = 12
// An operand of `??`, whose value is the expression's own. No list reader claims it.
export const CW_UP_COAL = 13
// The operand of `x is T`, which yields a boolean and narrows the same binding in place.
export const CW_UP_IS = 14
// The tail statement of an `if` arm, or an `else if` link, whose value is the `if`'s own.
export const CW_UP_ARM = 15
// The operand of `...xs`: its elements become elements of the list or arguments it sits in.
export const CW_UP_SPREAD = 16
export let cwIxUp: i32[] = []
// Per arena node, the node whose children include it (an `else if` link's is the `if` before
// it), or -1. Read by the record rule to tell a discarded statement from a consumed value.
export let cwIxParent: i32[] = []
export let cwIxUpKind: i32[] = []
export let cwIxUpAux: i32[] = []
// The note pass's own cursor: how many nodes it has read, so the walk is a grow loop over
// columns phase one has already sized to the arena.
let cwIxNotedN = 0
// Per interned name, the first named `FuncDecl` that declares it, or -1 — the callee
// resolution the argument and call-result edges key on.
let cwIxFnDecl: i32[] = []
// The writes whose receiver roots at no name (`m["k"][0] = v`, `f().push(…)`): the statement
// node and the receiver expression, or -1 for `__array_copy__`, which names no receiver at
// all. Set-independent, so the write pass reads them rather than rescanning.
let cwIxWrNode: i32[] = []
let cwIxWrRecv: i32[] = []
// 1 where the program holds any list write at all — the gate that keeps the closure off a
// program with nothing to separate.
let cwIxAnyWrite = 0
let cwIxBuilt = false
// Whether `cwIxParent` is the frame walk's column, so the note pass files no parent itself.
let cwIxParentFiled = false
// The same rows chained per declaration (`cwDeclRep`), built for a name on its first query: each
// row's next row on its chain, the newest row per declaration, and per name the newest row that
// resolves to no declaration — a call, which may write anything — and whether it is chained. A
// reader walks its declaration's chain and that one (D2688).
let cwIxDNext: i32[] = []
let cwIxDHead: i32[] = []
let cwIxUHead: i32[] = []
let cwIxDDone: i32[] = []
// `cwFnValueTargets` memo: a binding's declaration (`cwBindingOf`) to its row in `cwFvSets`, or
// -2 while that binding is being resolved, so a cycle of bindings declines.
let cwFvSlot: {[i32]: i32} = Map()
let cwFvSets: i32[][] = []
// `cwBoundInitOf` memo: a binding's declaration to its answer, so a binding named at every call
// of a long body is resolved once.
let cwBiSlot: {[i32]: i32} = Map()

function cwIxReset() {
  cwIxHead = []
  cwIxNext = []
  cwIxDNext = []
  cwIxDHead = []
  cwIxUHead = []
  cwIxDDone = []
  cwIxNode = []
  cwIxFr = []
  cwIxKind = []
  cwIxObj = []
  cwIxIsObj = []
  cwIxHeld = []
  cwIxUp = []
  cwIxParent = []
  cwIxUpKind = []
  cwIxUpAux = []
  cwIxNotedN = 0
  cwIxFnDecl = []
  cwIxWrNode = []
  cwIxWrRecv = []
  cwIxAnyWrite = 0
  cwIxBuilt = false
  cwIxParentFiled = false
  cwFvSlot = Map()
  cwFvSets = []
  cwBiSlot = Map()
  0
}

// File one occurrence of the name `sid`, newest first — order does not matter, every reader
// counts the whole chain.
function cwIxOcc(sid: i32, node: i32, fr: i32, kind: i32) {
  while cwIxHead.length <= sid { cwIxHead.push(-1) }
  cwIxNext.push(cwIxHead[sid])
  cwIxNode.push(node)
  cwIxFr.push(fr)
  cwIxKind.push(kind)
  cwIxHead[sid] = cwIxNext.length - 1
  0
}

// The chain key of a row of `sid` declared by `d`: the first declaration sharing `d`'s frame and
// name, or -1 when `d` declares nothing the frame walk filed.
function cwIxKey(sid: i32, d: i32): i32 {
  if d < 0 || d >= cwDeclRep.length { return -1 }
  const r = cwDeclRep[d]
  if r < 0 || r >= P.nodes.length { return -1 }
  if sidOfNode(r) != sid { return -1 }
  r
}

// The chain key of row `r` of `sid`: the key of the declaration it binds, or the one its read or
// assigned name resolves to; -1 for a row resolving to no frame, a call among them.
function cwIxRowKey(r: i32, sid: i32): i32 {
  if r < 0 || r >= cwIxNode.length { return -1 }
  if cwIxFr[r] == CW_FR_UNKNOWN { return -1 }
  const at = cwIxNode[r]
  const k = cwIxKind[r]
  if k == CW_OCC_BIND { return cwIxKey(sid, at) }
  if k == CW_OCC_USE { return cwIxKey(sid, identDeclOf(at)) }
  const n = nodeAt(at)
  if n is BinExpr { return cwIxKey(sid, identDeclOf(cwPeelValue(n.binLeft))) }
  -1
}

// Chains every row of `sid`'s name chain onto its declaration's chain, once per built index. The
// name chain is newest first, so its rows are placed oldest first to keep each chain newest first.
function cwIxDeclEnsure(sid: i32) {
  if !cwIxBuilt || sid < 0 || sid >= cwIxHead.length { return 0 }
  if cwIxDDone.length < cwIxHead.length {
    cwIxDDone = __array_new__(cwIxHead.length, 0)
    cwIxUHead = __array_new__(cwIxHead.length, -1)
    cwIxDNext = __array_new__(cwIxNext.length, -1)
  }
  if cwIxDDone[sid] == 1 { return 0 }
  cwIxDDone[sid] = 1
  const rows: i32[] = []
  let r = cwIxHead[sid]
  while r >= 0 {
    rows.push(r)
    r = cwIxNext[r]
  }
  let i = rows.length - 1
  while i >= 0 {
    const row = rows[i]
    const key = cwIxRowKey(row, sid)
    if key >= 0 && key < cwIxDHead.length {
      cwIxDNext[row] = cwIxDHead[key]
      cwIxDHead[key] = row
    } else {
      cwIxDNext[row] = cwIxUHead[sid]
      cwIxUHead[sid] = row
    }
    i = i - 1
  }
  0
}

// Record that `at` projects out of `obj`, and that `obj` is consumed by projecting.
function cwIxPlace(at: i32, obj: i32) {
  const p = cwPeel(obj)
  cwIxObj[at] = p
  if p >= 0 && p < cwIxIsObj.length { cwIxIsObj[p] = 1 }
  cwIxUpSet(obj, at, CW_UP_OBJ, 0)
  0
}

// Record that `at` consumes the expression `child` in the role `kind`. Peels first: the
// readers all ask about the value, and a `Paren` carries no fact of its own.
function cwIxUpSet(child: i32, at: i32, kind: i32, aux: i32) {
  const p = cwPeel(child)
  if p < 0 || p >= cwIxUp.length { return 0 }
  cwIxUp[p] = at
  cwIxUpKind[p] = kind
  cwIxUpAux[p] = aux
  0
}

// Record that a named destination consumes the call at `p`, when `p` is one.
function cwIxHold(p: i32) {
  if p < 0 || p >= cwIxHeld.length { return 0 }
  const n = nodeAt(p)
  if n is Call { cwIxHeld[p] = 1 }
  0
}

// The FIRST named `FuncDecl` for an interned name wins: a second declaration of the same
// name answers for nothing, so a callee edge resolves to one frame or to none.
function cwIxFn(sid: i32, at: i32) {
  while cwIxFnDecl.length <= sid { cwIxFnDecl.push(-1) }
  if cwIxFnDecl[sid] < 0 { cwIxFnDecl[sid] = at }
  0
}

// `xs[i] = v` at `at`, whose destination place is `l`. A receiver rooting at no name could
// be any list, so the write pass reads it back rather than rescanning for it.
function cwIxNoteIdxWrite(at: i32, l: i32) {
  if l < 0 || l >= P.nodes.length { return 0 }
  const ln = nodeAt(l)
  if ln is Index {
    cwIxAnyWrite = 1
    if covarRootName(ln.idxArr) == "" {
      cwIxWrNode.push(at)
      cwIxWrRecv.push(cwPeel(ln.idxArr))
    }
  }
  0
}

// The write a call at `at` with callee `cf` performs: a mutating method on its receiver, or
// `__array_copy__`, whose destination this walk does not read at all — so it is filed with
// no receiver and declines rather than being reasoned about.
function cwIxNoteCallWrite(at: i32, cf: i32) {
  if cf < 0 || cf >= P.nodes.length { return 0 }
  const cn = nodeAt(cf)
  match cn {
    Member => {
      if cwMutatesList(cn.memProp) {
        cwIxAnyWrite = 1
        if covarRootName(cn.memObj) == "" {
          cwIxWrNode.push(at)
          cwIxWrRecv.push(cwPeel(cn.memObj))
        }
      }
    }
    Ident => {
      if cn.identName == "__array_copy__" {
        cwIxAnyWrite = 1
        cwIxWrNode.push(at)
        cwIxWrRecv.push(-1)
      }
    }
    // no other callee writes
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  0
}

// Every fact this index carries about the node `at`. A kind with no arm here contributes no
// row and no flag, which is what the readers below read as "this analysis knows nothing
// about it" — the same answer a bare name got before the index existed.
function cwIxNote(at: i32) {
  const n = nodeAt(at)
  // The facts only the record rule (D2060) reads — parents and the value edges of `if`/`match`
  // arms and spreads — are filed for live nodes only.
  if !cwIxParentFiled && cwIxLive(at) { cwIxNoteParent(at) }
  // The arms run in descending kind frequency: a `match` tests them in order.
  match n {
    // A name no program root reaches is not a read: a match's scrutinee whose every arm test
    // reads a copy of it is left behind by the lowering (D14539).
    Ident => {
      if cwIxLive(at) {
        const sid = sidOfNode(at)
        cwIxOcc(sid, at, cwFrameOfUse(at), CW_OCC_USE)
      }
    }
    BinExpr => {
      if n.binOp == "=" {
        cwIxUpSet(n.binLeft, at, CW_UP_ASG_LHS, 0)
        cwIxUpSet(n.binRight, at, CW_UP_ASG_RHS, 0)
        cwIxNoteIdxWrite(at, cwPeel(n.binLeft))
        const ls = covarRootSid(n.binLeft)
        if ls >= 0 {
          cwIxOcc(ls, at, cwFrameOfUse(cwPeelValue(n.binLeft)), CW_OCC_ASG)
          cwIxHold(cwPeel(n.binRight))
        }
      }
      if n.binOp == "==" || n.binOp == "!=" {
        cwIxUpSet(n.binLeft, at, CW_UP_CMP, 0)
        cwIxUpSet(n.binRight, at, CW_UP_CMP, 0)
      }
      if n.binOp == "??" {
        cwIxUpSet(n.binLeft, at, CW_UP_COAL, 0)
        cwIxUpSet(n.binRight, at, CW_UP_COAL, 0)
      }
    }
    // no fact is filed for these kinds
    Block | NumLit | StrLit | TypeRef | Paren | Unary => {}
    Call => {
      cwIxUpSet(n.callFn, at, CW_UP_CALLEE, 0)
      let a = 0
      while a < n.callArgs.length {
        cwIxUpSet(n.callArgs[a], at, CW_UP_ARG, a)
        a = a + 1
      }
      cwIxNoteCallWrite(at, cwPeel(n.callFn))
      const cs = covarRootSid(n.callFn)
      if cs >= 0 { cwIxOcc(cs, at, CW_FR_UNKNOWN, CW_OCC_CALL) }
      const mcf = nodeAt(cwPeel(n.callFn))
      if mcf is Member {
        cwIxOcc(
          sidOf(demangleName(mcf.memProp)),
          at,
          CW_FR_UNKNOWN,
          CW_OCC_MCALL,
        )
      }
    }
    Member => {
      cwIxPlace(at, n.memObj)
    }
    MatchExpr => {
      if cwIxLive(at) {
        let mb = 0
        while mb < n.matchBodies.length {
          cwIxUpSet(rcwBlockTail(n.matchBodies[mb]), at, CW_UP_ARM, 0)
          mb = mb + 1
        }
      }
    }
    Spread => {
      if cwIxLive(at) { cwIxUpSet(n.spdArg, at, CW_UP_SPREAD, 0) }
    }
    IfStmt => {
      if cwIxLive(at) {
        cwIxUpSet(rcwBlockTail(n.ifThen), at, CW_UP_ARM, 0)
        if n.ifElse >= 0 && n.ifElse < P.nodes.length {
          const el = nodeAt(n.ifElse)
          if el is IfStmt {
            cwIxUpSet(n.ifElse, at, CW_UP_ARM, 0)
          } else {
            cwIxUpSet(rcwBlockTail(n.ifElse), at, CW_UP_ARM, 0)
          }
        }
      }
    }
    // A parameter and a loop's variable bind where they stand, as a `let` does.
    Param | ForRange | LoopVar => {
      cwIxOcc(sidOfNode(at), at, cwFrameOfDecl(at), CW_OCC_BIND)
    }
    OptMember => {
      cwIxPlace(at, n.omObj)
    }
    Index => {
      cwIxPlace(at, n.idxArr)
    }
    ForIn => {
      cwIxUpSet(n.fiIter, at, CW_UP_ITER, 0)
    }
    IsExpr => {
      cwIxUpSet(n.isObj, at, CW_UP_IS, 0)
    }
    RetStmt => {
      if n.retArg >= 0 { cwIxUpSet(n.retArg, at, CW_UP_RET, 0) }
    }
    FuncDecl => {
      if n.fnName != "" {
        cwIxFn(sidOfNode(at), at)
        cwIxOcc(sidOf(demangleName(n.fnName)), at, CW_FR_UNKNOWN, CW_OCC_FDECL)
      }
      const tail = cwFnTailStmt(at)
      if tail >= 0 { cwIxUpSet(tail, at, CW_UP_TAIL, 0) }
    }
    ObjLit => {
      let k = 0
      while k < n.objFields.length {
        const f = nodeAt(n.objFields[k])
        if f is FieldInit {
          cwIxUpSet(f.fiValue, at, CW_UP_FIELD, n.objFields[k])
        }
        k = k + 1
      }
    }
    ArrayLit => {
      let e = 0
      while e < n.arrElems.length {
        cwIxUpSet(n.arrElems[e], at, CW_UP_ELEM, e)
        e = e + 1
      }
    }
    LetDecl => {
      cwIxOcc(sidOfNode(at), at, cwFrameOfDecl(at), CW_OCC_BIND)
      if n.letInit >= 0 {
        cwIxHold(cwPeel(n.letInit))
        cwIxUpSet(n.letInit, at, CW_UP_LETINIT, 0)
      }
    }
    // no fact is filed for these kinds
    CharLit | BoolLit | NullLit | ErrExpr | WhileStmt | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | AsExpr | ImportDecl => {}
  }
  0
}

// Whether `at` is reachable from a program root — a node a rewrite copied elsewhere and left
// behind (`arenaReplaceNode`) is not, and must not claim its children a second time.
function cwIxLive(at: i32): boolean {
  if nodeAt(at) is Program { return true }
  at < cwFrameOf.length && cwFrameOf[at] != CW_FR_UNKNOWN
}

// File `at` as the parent of each of its children, and of the `else if` link after it.
function cwIxNoteParent(at: i32) {
  const base = cwKids.length
  const n = nodeSpineChildrenPush(at, cwKids)
  let i = 0
  while i < n {
    const k = cwKids[base + i]
    if k >= 0 && k < cwIxParent.length { cwIxParent[k] = at }
    i = i + 1
  }
  const link = elseIfLink(at)
  if link >= 0 && link < cwIxParent.length { cwIxParent[link] = at }
  0
}

// Declare that an index build follows, so a frame walk run first keeps the parents the build
// will adopt rather than leaving the note pass to file them again.
export function cwIxWant() {
  cwIxWanted = true
  0
}

// Whether the frame walk's parents describe an arena of `len` nodes with no slot rewritten
// since the walk ran, so the index may take them as its own.
function cwFrParentCurrent(len: i32): boolean {
  if cwFrParent.length != len { return false }
  cwFrParentEpoch == arenaEpochNow()
}

// Build the index once for this arena: every per-node column is sized before the note loop,
// so a note may file a fact about a node it has not reached — a parent naming its own child,
// which arena order does not promise.
export function cwIxBuild() {
  if cwIxBuilt { return 0 }
  cwBuildFrames()
  const len = P.nodes.length
  cwIxObj = __array_new__(len, -1)
  cwIxIsObj = __array_new__(len, 0)
  cwIxHeld = __array_new__(len, 0)
  cwIxUp = __array_new__(len, -1)
  cwIxParentFiled = cwFrParentCurrent(len)
  cwIxWanted = true
  if cwIxParentFiled {
    cwIxParent = cwFrParent
  } else {
    cwIxParent = __array_new__(len, -1)
  }
  cwIxUpKind = __array_new__(len, CW_UP_NONE)
  cwIxUpAux = __array_new__(len, 0)
  cwIxDHead = __array_new__(len, -1)
  while cwIxNotedN < P.nodes.length {
    const at = cwIxNotedN
    cwIxNotedN = at + 1
    cwIxNote(at)
  }
  cwKids = []
  cwIxBuilt = true
  0
}

// A walk of one declaration's rows and its name's unresolved rows, the larger row first, so
// newest first; with `all`, of every row of the name instead.
export type CwOccWalk = { a: i32, u: i32, all: boolean, row: i32 }

// The rows of the binding `d` declares: those resolving to it or to a declaration sharing its
// frame and name, and the calls that may write it. Every row of its name when `d` has no frame
// or is a key (`cwKeyOfDecl`) standing for every binding of a name.
export function cwOccWalk(d: i32): CwOccWalk {
  if d <= -2 { return cwOccWalkAll(-2 - d) }
  if d < 0 || d >= P.nodes.length { return cwOccWalkAll(-1) }
  const sid = sidOfNode(d)
  if cwFrameOfDecl(d) == CW_FR_UNKNOWN { return cwOccWalkAll(sid) }
  cwOccWalkOf(cwIxKey(sid, d), sid)
}

// `cwOccWalk` of the declaration the read `p` resolves to.
export function cwOccWalkUse(p: i32): CwOccWalk {
  if cwFrameOfUse(p) == CW_FR_UNKNOWN { return cwOccWalkAll(sidOfNode(p)) }
  cwOccWalk(identDeclOf(p))
}

// The key an alias set carries for the binding declaration `d` makes: the first declaration
// sharing its frame and name, `d` itself where the frame walk filed none, or `-2 - sid` where
// `d` has no frame, which stands for every binding of the name. -1 for no declaration.
export function cwKeyOfDecl(d: i32): i32 {
  if d < 0 || d >= P.nodes.length { return -1 }
  if cwFrameOfDecl(d) == CW_FR_UNKNOWN { return cwKeyAnyOf(sidOfNode(d)) }
  const r = cwDeclRepOf(d)
  if r >= 0 { return r }
  d
}

// The key of the name the expression `ix` roots at (`covarRootName`), or -1 where it roots at
// no name.
export function cwKeyOfRoot(ix: i32): i32 {
  const p = cwPeelValue(ix)
  if p < 0 || p >= P.nodes.length { return -1 }
  const n = nodeAt(p)
  if !(n is Ident) || n.identName == "" { return -1 }
  if cwFrameOfUse(p) == CW_FR_UNKNOWN { return cwKeyAnyOf(sidOfNode(p)) }
  cwKeyOfDecl(identDeclOf(p))
}

// The key standing for every binding of the interned name `sid`.
function cwKeyAnyOf(sid: i32): i32 {
  if sid < 0 { return -1 }
  -2 - sid
}

// The interned name of the key `k`, or -1.
function cwKeySid(k: i32): i32 {
  if k <= -2 { return -2 - k }
  if k < 0 || k >= P.nodes.length { return -1 }
  sidOfNode(k)
}

// The frame the key `k`'s binding declares into; `CW_FR_UNKNOWN` for a key standing for every
// binding of a name.
export function cwKeyFrame(k: i32): i32 {
  if k < 0 { return CW_FR_UNKNOWN }
  cwFrameOfDecl(k)
}

// Whether two keys may name one binding: the same key, or a key standing for every binding of
// the other's name.
export function cwKeySame(a: i32, b: i32): boolean {
  if a == b { return true }
  if a >= -1 && b >= -1 { return false }
  const s = cwKeySid(a)
  s >= 0 && s == cwKeySid(b)
}

function cwOccWalkOf(key: i32, sid: i32): CwOccWalk {
  cwIxBuild()
  cwIxDeclEnsure(sid)
  let a = -1
  if key >= 0 && key < cwIxDHead.length { a = cwIxDHead[key] }
  let u = -1
  if sid >= 0 && sid < cwIxUHead.length { u = cwIxUHead[sid] }
  const w: CwOccWalk = { a: a, u: u, all: false, row: -1 }
  w
}

function cwOccWalkAll(sid: i32): CwOccWalk {
  cwIxBuild()
  let a = -1
  if sid >= 0 && sid < cwIxHead.length { a = cwIxHead[sid] }
  const w: CwOccWalk = { a: a, u: -1, all: true, row: -1 }
  w
}

// Moves walk `w` to its next row, left in `w.row`; false when no row is left.
export function cwOccNext(w: CwOccWalk): boolean {
  if w.a < 0 && w.u < 0 { return false }
  if w.u > w.a {
    w.row = w.u
    w.u = cwIxDNext[w.row]
    return true
  }
  w.row = w.a
  if w.all { w.a = cwIxNext[w.row] } else { w.a = cwIxDNext[w.row] }
  true
}

// Every arena node that is an occurrence of a member of `set` in the kind `kind`. A member is
// a binding's key (`cwKeyOfDecl`), so a same-named handle in another frame contributes nothing.
export function cwSetOccs(set: i32[], kind: i32, out: i32[]) {
  cwIxBuild()
  let i = 0
  while i < set.length {
    const ow = cwOccWalk(set[i])
    while cwOccNext(ow) {
      const r = ow.row
      if cwIxKind[r] == kind { out.push(cwIxNode[r]) }
    }
    i = i + 1
  }
  0
}

// Record that frame `fr` declares the interned name `sid`. Module scope (`CW_FR_MOD`) is a real
// frame here and files rows like any other; a frame id outside the arena declares nothing.
function cwDeclare(d: i32, fr: i32) {
  if fr != CW_FR_MOD {
    if fr < 0 || fr >= cwFrameOf.length { return 0 }
  }
  cwDeclNode.push(d)
  cwDeclFr.push(fr)
  cwDeclSid.push(sidOfNode(d))
  0
}

// The slot `(fr, sid)` occupies, or the free slot it would take; -1 while no table is open.
function cwDeclSlotOf(fr: i32, sid: i32): i32 {
  let h = hashMixPair(fr, sid) & (cwDeclCap - 1)
  if h < 0 || h >= cwDeclSlotSid.length { return -1 }
  while cwDeclSlotSid[h] >= 0 {
    if cwDeclSlotSid[h] == sid {
      if cwDeclSlotFr[h] == fr { return h }
    }
    h = h + 1
    if h == cwDeclCap { h = 0 }
  }
  h
}

// Place every row in the membership table. Runs once, at the end of the frame walk, so no
// reader can meet a half-filled table and read a declaration as absent.
function cwDeclIndex() {
  let cap = 16
  while cap < cwDeclSid.length * 2 { cap = cap * 2 }
  cwDeclCap = cap
  while cwDeclSlotSid.length < cap {
    cwDeclSlotSid.push(-1)
    cwDeclSlotFr.push(0)
    cwDeclSlotN.push(0)
    cwDeclSlotRep.push(-1)
  }
  cwDeclRep = __array_new__(cwFrameOf.length, -1)
  let i = 0
  while i < cwDeclSid.length {
    const s = cwDeclSlotOf(cwDeclFr[i], cwDeclSid[i])
    if s >= 0 && s < cwDeclSlotSid.length {
      cwDeclSlotFr[s] = cwDeclFr[i]
      cwDeclSlotSid[s] = cwDeclSid[i]
      cwDeclSlotN[s] = cwDeclSlotN[s] + 1
      if cwDeclSlotRep[s] < 0 { cwDeclSlotRep[s] = cwDeclNode[i] }
      const d = cwDeclNode[i]
      if d >= 0 && d < cwDeclRep.length { cwDeclRep[d] = cwDeclSlotRep[s] }
    }
    i = i + 1
  }
  0
}

// How many declarations share declaration `d`'s frame and name, `d` among them: the emitter
// gives a body one local per name, so a binding is the declaration's own only when this is 1.
function cwDeclCount(d: i32): i32 {
  if d < 0 || d >= P.nodes.length { return 0 }
  const fr = cwFrameOfDecl(d)
  if fr == CW_FR_UNKNOWN || cwDeclCap == 0 { return 0 }
  const sid = sidOfNode(d)
  const s = cwDeclSlotOf(fr, sid)
  if s < 0 || s >= cwDeclSlotSid.length { return 0 }
  if cwDeclSlotSid[s] != sid || cwDeclSlotFr[s] != fr { return 0 }
  cwDeclSlotN[s]
}

// The walk. Mirrors `lint.vl`'s `bindScan` arm for arm — a binder it grows and this does not
// is a name that resolves to `CW_FR_UNKNOWN`, which matches everything, so the two may differ
// in precision but never in soundness.
function cwFrameWalk(ix: i32, fr: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  cwFrameOf[ix] = fr
  const n = nodeAt(ix)
  let chain = false
  // The record rule's join sites and `return`s, gathered by the walk that reaches them. The
  // arms run in descending kind frequency, and a leaf returns before the child loop.
  match n {
    Ident | NumLit | StrLit | TypeRef => {
      return 0
    }
    BinExpr => {
      if n.binOp == "??" || n.binOp == "+" { cwFrJoins.push(ix) }
    }
    IfStmt => {
      cwFrJoins.push(ix)
      chain = true
    }
    ArrayLit | MatchExpr => {
      cwFrJoins.push(ix)
    }
    RetStmt => {
      cwFrRets.push(ix)
    }
    LetDecl => {
      cwDeclare(ix, fr)
    }
    ForRange => {
      cwDeclare(ix, fr)
    }
    // The element variables are no child of the loop, so their frame is filed here.
    ForIn => {
      cwLoopVarDeclare(n.fiDecl1, fr)
      cwLoopVarDeclare(n.fiDecl2, fr)
    }
    FuncDecl => {
      cwFrJoins.push(ix)
      // The declaration's own name binds OUTSIDE the frame it opens; its params and body are in.
      cwDeclare(ix, fr)
      cwFrameUp[ix] = fr
      let p = 0
      while p < n.fnParams.length {
        const pix = n.fnParams[p]
        cwFrParentNote(pix, ix)
        if pix >= 0 && pix < P.nodes.length {
          const pn = nodeAt(pix)
          if pn is Param { cwDeclare(pix, ix) }
          cwFrameWalk(pix, ix)
        }
        p = p + 1
      }
      cwFrParentNote(n.fnRet, ix)
      cwFrParentNote(n.fnBody, ix)
      cwFrameWalk(n.fnBody, ix)
      return 0
    }
    // walked for their children only
    Block | Call | Member | Paren | Index | Param | Unary | CharLit | BoolLit | NullLit | OptMember | ErrExpr | WhileStmt | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | UnionDecl | IsExpr | AsExpr | ImportDecl | Spread | LoopVar => {}
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    if cur != ix {
      cwFrameOf[cur] = fr
      cwFrJoins.push(cur)
    }
    const base = cwKids.length
    const k = nodeSpineChildrenPush(cur, cwKids)
    let i = 0
    while i < k {
      const kid = cwKids[base + i]
      cwFrParentNote(kid, cur)
      cwFrameWalk(kid, fr)
      i = i + 1
    }
    if chain {
      const link = elseIfLink(cur)
      cwFrParentNote(link, cur)
      cur = link
    } else {
      cur = -1
    }
  }
  0
}

function cwLoopVarDeclare(d: i32, fr: i32) {
  if d < 0 || d >= cwFrameOf.length { return 0 }
  cwFrameOf[d] = fr
  cwDeclare(d, fr)
}

// File `at` as a parent of `k`. The note pass filed each live node's children in arena order,
// so the parent that stands is the highest-numbered one, whatever order the walk meets it in.
function cwFrParentNote(k: i32, at: i32) {
  if k >= 0 && k < cwFrParent.length && cwFrParent[k] < at {
    cwFrParent[k] = at
  }
  0
}

// The children list the frame walk and the parent pass share: a node's window is pushed above
// whatever its callers' windows hold and never popped, so it is dropped once a build is done.
let cwKids: i32[] = []

// Size both frame columns, collect the roots, then walk them — several `Program` nodes stand
// in one arena after a module merge (D661).
// Memoised on `cwFramesBuilt`, which `covarValueWriteState` drops with the rest of the memo
// when the monomorphizer has grown the arena under it.
export function cwBuildFrames() {
  if cwFramesBuilt { return 0 }
  cwFrameReset()
  const roots: i32[] = []
  const len = P.nodes.length
  cwFrameOf = __array_new__(len, CW_FR_UNKNOWN)
  let at = 0
  for nd in P.nodes {
    if nd is Program { roots.push(at) }
    at = at + 1
  }
  // A merged root lists each module's statements again; one walk declares them once. Each
  // root files itself as its statements' parent first, so a statement already holding one
  // is a repeat listing, and the latest root is the parent that stands.
  cwFrParent = __array_new__(len, -1)
  cwFrParentEpoch = arenaEpochNow()
  const tops: i32[] = []
  let r = 0
  while r < roots.length {
    const pn = nodeAt(roots[r])
    if pn is Program {
      let s = 0
      while s < pn.progStmts.length {
        const st = pn.progStmts[s]
        // an index outside the arena walks nothing
        if st >= 0 && st < len {
          if cwFrParent[st] < 0 { tops.push(st) }
          cwFrParent[st] = roots[r]
        }
        s = s + 1
      }
    }
    r = r + 1
  }
  if !cwIxWanted {
    cwFrParent = []
    cwFrParentEpoch = -1
  }
  let t = 0
  while t < tops.length {
    cwFrameWalk(tops[t], CW_FR_MOD)
    t = t + 1
  }
  cwKids = []
  cwDeclIndex()
  cwFramesBuilt = true
  0
}

// Whether node `ix` is in the frame index, so a frame question about it has an answer rather
// than the match-anything `CW_FR_UNKNOWN`.
export function cwFramedNode(ix: i32): boolean {
  if ix < 0 { return false }
  cwBuildFrames()
  ix < cwFrameOf.length
}

// The frame that declares what the `Ident` read `ix` names, by the binder. `CW_FR_UNKNOWN` for a
// built-in, an unresolved name or a declaration the walk did not reach; that matches every
// frame rather than none.
export function cwFrameOfUse(ix: i32): i32 {
  if !cwFrameOfOpen(ix) { return CW_FR_UNKNOWN }
  cwFrameOfDecl(identDeclOf(ix))
}

// Whether the read `ix` is from a function nested in the one that declares what it names, a
// capture; false for a module binding, true where the frames do not model the binder.
export function cwUseCaptures(ix: i32): boolean {
  if !cwFrameOfOpen(ix) { return true }
  const fr = cwFrameOfUse(ix)
  fr != CW_FR_MOD && fr != cwFrameOf[ix]
}

// Whether the node `ix` has a frame to resolve a name from: the frame walk reached it. A node
// it has no row for (a rewrite added it) answers the coarsest frame, as an unreached one does.
function cwFrameOfOpen(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return false }
  cwBuildFrames()
  if ix >= cwFrameOf.length { return false }
  cwFrameOf[ix] != CW_FR_UNKNOWN
}

// The emitter rewrites and the monomorphizer add nodes to the arena after `check`, so an
// answer computed over the smaller arena describes a program that has since changed: drop the
// alias-closure memo and the frames, which read every `Ident` in the arena.
export function cwArenaSync() {
  if P.nodes.length != cwArenaLen {
    cwRootKeys = []
    cwAnswers = []
    cwSplits = []
    cwWriteAts = []
    cwFrameReset()
    cwArenaLen = P.nodes.length
  }
  0
}

// The alias-closure memo, keyed by the binding key (`cwKeyOfDecl`) of the root that seeded
// the analysis, so two functions' same-named handles get two rows (D1610/D1611). The arena
// does not change between `check` and `emit`; `cwArenaLen` drops the memo once it does.
export let cwRootKeys: i32[] = []
export let cwAnswers: i32[] = []
// Parallel to `cwAnswers`: 1 where the alias set demands two element storages
// (`cwSplitStorage`), 0 otherwise. Meaningful only where the closure actually ran.
export let cwSplits: i32[] = []
// Parallel to `cwAnswers`: the node of the write that decided a `1`, else -1, so a refusal
// can name the line that forced it.
export let cwWriteAts: i32[] = []
// The write node the last `cwWrites` pass decided on, or -1.
export let cwLastWriteAt = -1
export let cwArenaLen = -1

// `unwrapParen`'s twin — that one lives in `emit_base`, which is downstream of this file.
export function cwPeel(ix: i32): i32 {
  let cur = ix
  let done = false
  while !done {
    if cur < 0 || cur >= P.nodes.length { return cur }
    const n = nodeAt(cur)
    if n is Paren { cur = n.parInner } else { done = true }
  }
  cur
}

// `cwPeel`, and through an assignment used as a value to its right side, the value it yields
// (D2411).
export function cwPeelValue(ix: i32): i32 {
  const p = cwPeel(ix)
  const r = cwAsgRight(p)
  if r < 0 { return p }
  cwPeelValue(r)
}

// The right side of the plain assignment at `p`, or -1 for any other node.
function cwAsgRight(p: i32): i32 {
  if p < 0 || p >= P.nodes.length { return -1 }
  const n = nodeAt(p)
  if n is BinExpr {
    if n.binOp == "=" && n.binCompound == "" { return n.binRight }
  }
  -1
}

// The name an expression roots at — a bare (possibly parenthesised) identifier, or what an
// assignment used as a value yields — or "". A member read, index, call result or literal
// roots at nothing on purpose: those forms' provenance this analysis does not follow, and ""
// routes them to the `2` answer.
export function covarRootName(ix: i32): string {
  const p = cwPeelValue(ix)
  if p < 0 || p >= P.nodes.length { return "" }
  const n = nodeAt(p)
  if n is Ident { return n.identName }
  ""
}

// `covarRootName(ix)`'s interned id, or -1 where that name is "".
function covarRootSid(ix: i32): i32 {
  const p = cwPeelValue(ix)
  if p < 0 || p >= P.nodes.length { return -1 }
  const n = nodeAt(p)
  if n is Ident {
    if n.identName == "" { return -1 }
    return sidOfNode(p)
  }
  -1
}

// Is the binding key `k` in the alias set? A key is per declaration, so two same-named handles
// in different functions are two values (D1610/D1611).
export function cwHas(set: i32[], k: i32): boolean {
  for m in set {
    if cwKeySame(m, k) { return true }
  }
  false
}

// Add the binding key `k` to the set unless it is already there; -1 names no binding.
export function cwAdd(set: i32[], k: i32): boolean {
  if k == -1 || cwHas(set, k) { return false }
  set.push(k)
  true
}

// The frame a BINDING node declares into — its own enclosing frame, which is the function
// frame for a `Param` because the walk enters params under the `FuncDecl` they belong to.
export function cwFrameOfDecl(ix: i32): i32 {
  if ix < 0 { return CW_FR_UNKNOWN }
  cwBuildFrames()
  if ix >= cwFrameOf.length { return CW_FR_UNKNOWN }
  cwFrameOf[ix]
}

// The mutating list methods, `rlSlotWrittenScan`'s own set. `set`/`add`/`delete` are map
// and Set operations; naming them costs a decline on a map sharing a member name and keeps
// the list honest if a list ever grows one.
export function cwMutatesList(p: string): boolean {
  const k = collMethodKind(p)
  k == CM_STORES || k == CM_REMOVES_ONE || k == CM_REMOVES
}

// What a built-in collection method does to its receiver's element slots — the one table every
// method question reads. STORES puts an argument in a slot; REMOVES_ONE takes one out and
// hands it back; REMOVES hands nothing back; RETURNS hands a slot's value back; READS none.
const CM_OTHER = 0
export const CM_STORES = 1
export const CM_REMOVES_ONE = 2
export const CM_REMOVES = 3
export const CM_RETURNS = 4
export const CM_READS = 5
export function collMethodKind(p: string): i32 {
  if p == "push" || p == "set" || p == "add" { return CM_STORES }
  if p == "pop" { return CM_REMOVES_ONE }
  if p == "clear" || p == "delete" { return CM_REMOVES }
  if p == "get" { return CM_RETURNS }
  if (
    p == "includes"
    || p == "indexOf"
    || p == "has"
    || p == "join"
    || p == "keys"
  ) {
    return CM_READS
  }
  CM_OTHER
}

// The `FuncDecl` the name `fnName` declares, or -1. Never mints an id: a name the arena
// does not carry declares nothing.
export function cwFnDeclOf(fnName: string): i32 {
  cwIxBuild()
  const sid = sidLookup(fnName)
  if sid < 0 || sid >= cwIxFnDecl.length { return -1 }
  cwIxFnDecl[sid]
}

// The lambda the binding `b` (`cwBindingOf`) is bound to, or -1. It must be bound exactly once
// and never re-pointed, so one parameter list answers for every call through the name;
// a binding initialised with anything else — a function-typed parameter, a call result — has
// no parameter list in the arena and declines. D1683.
export function cwLambdaDeclOf(b: i32): i32 {
  const init = cwBoundInitOf(b)
  if init >= 0 && nodeAt(init) is FuncDecl { return init }
  -1
}

// The function declaration or lambda node `a` names: itself, the declaration a name resolves
// to, or the initialiser of the un-annotated `const` or once-bound `let` it reads, followed
// through aliases (D8981); -1 else.
export function cwFnValueDeclOf(a: i32): i32 {
  let ix = cwPeel(a)
  let hops = 0
  while ix >= 0 && ix < P.nodes.length && hops < 8 {
    const n = nodeAt(ix)
    if n is FuncDecl { return ix }
    if !(n is Ident) { return -1 }
    const d = identDeclOf(ix)
    if d < 0 || d >= P.nodes.length { return -1 }
    const dn = nodeAt(d)
    if dn is FuncDecl { return d }
    if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return -1 }
    if dn.letKw == "const" {
      ix = cwPeel(dn.letInit)
    } else {
      ix = cwBoundInitOf(cwBindingOf(ix))
    }
    hops = hops + 1
  }
  -1
}

// The function declaration or lambda the name `a` holds, read from the source alone, so before
// the checker has resolved it: a declared function, or what a binding bound once holds, followed
// through aliases; -1 else.
export function cwHeldFnOf(a: i32): i32 {
  let ix = cwPeel(a)
  let hops = 0
  while ix >= 0 && ix < P.nodes.length && hops < 8 {
    const n = nodeAt(ix)
    if n is FuncDecl { return ix }
    if !(n is Ident) { return -1 }
    const f = fnDeclIx[n.identName] ?? -1
    if f >= 0 { return f }
    ix = cwBoundInitOf(cwBindingOf(ix))
    hops = hops + 1
  }
  -1
}

// The declaration standing for the binding the read `ix` names, the first one its frame files
// under the name; -1 when the read's frame is not known or files no such declaration.
export function cwBindingOf(ix: i32): i32 {
  const k = cwKeyOfRoot(ix)
  if k < 0 { return -1 }
  cwDeclRepOf(k)
}

// The first declaration sharing declaration `d`'s frame and name, or -1 when the frame walk
// filed none for it.
function cwDeclRepOf(d: i32): i32 {
  cwBuildFrames()
  if d < 0 || d >= cwDeclRep.length { return -1 }
  cwDeclRep[d]
}

// The initialiser, parens peeled, of the binding `b` (`cwBindingOf`) when it is bound exactly
// once and never re-pointed, or -1.
export function cwBoundInitOf(b: i32): i32 {
  if b < 0 { return -1 }
  cwIxBuild()
  const m = cwBiSlot.get(b)
  if m != null { return m }
  const init = cwBoundInitScan(b)
  cwBiSlot[b] = init
  init
}

function cwBoundInitScan(b: i32): i32 {
  if !cwBoundOnce(cwOccWalk(b)) { return -1 }
  const ow = cwOccWalk(b)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_BIND {
      const bn = nodeAt(cwIxNode[r])
      if bn is LetDecl {
        const init = cwPeel(bn.letInit)
        if init >= 0 && init < P.nodes.length { return init }
      }
    }
  }
  -1
}

// The `LetDecl` or `Param` the `Ident` read `ix` names, by the binder, or -1 when it names
// another declaration or its frame declares the name more than once.
export function cwSoleBinderAt(ix: i32): i32 {
  if !cwFrameOfOpen(ix) || !(nodeAt(ix) is Ident) { return -1 }
  cwSoleDecl(identDeclOf(ix))
}

// `d` when it is a `LetDecl` or `Param` its frame declares no other of the same name, else -1.
function cwSoleDecl(d: i32): i32 {
  if d < 0 || d >= P.nodes.length || cwDeclCount(d) != 1 { return -1 }
  const n = nodeAt(d)
  if n is LetDecl || n is Param { return d }
  -1
}

// Every function a call through the binding `b` (`cwBindingOf`) may run: its initialiser and
// each value assigned to it, where a parameter holds what every call of its function hands it.
// [] when one of them is not a named function or a lambda, or a loop or function binds it.
export function cwFnValueTargets(b: i32): i32[] {
  const ts = cwFvTargetsOf(b)
  if ts.length == 0 || ts[0] < 0 { return [] }
  ts
}

// `cwFnValueTargets` with [-1] for a set not known, so a binding no call fills is the empty set.
function cwFvTargetsOf(b: i32): i32[] {
  if b < 0 { return [-1] }
  cwIxBuild()
  const s = cwFvSlot[b] ?? -1
  if s >= 0 && s < cwFvSets.length { return cwFvSets[s] }
  if s == -2 { return [-1] }
  cwFvSlot[b] = -2
  let out: i32[] = []
  if !cwFvCollect(b, out) { out = [-1] }
  cwFvSlot[b] = cwFvSets.length
  cwFvSets.push(out)
  out
}

// Add to `out` every value stored into the binding `b`; false when one is unresolved or its
// frame declares the name by a loop or by a function, which store no value of their own.
function cwFvCollect(b: i32, out: i32[]): boolean {
  const fr = cwFrameOfDecl(b)
  let binds = 0
  let bd = -1
  const ow = cwOccWalk(b)
  while cwOccNext(ow) {
    const r = ow.row
    const at = cwIxNode[r]
    const n = nodeAt(at)
    if cwIxKind[r] == CW_OCC_BIND {
      if cwIxFr[r] == fr {
        binds = binds + 1
        bd = at
      }
      if n is LetDecl {
        if n.letInit >= 0 && !cwFvAddValue(n.letInit, out) { return false }
      } else if n is Param {
        if !cwFvAddParam(at, out) { return false }
      } else {
        return false
      }
    }
    if cwIxKind[r] == CW_OCC_ASG {
      if n is BinExpr {
        // Only `nm = v` re-points the binding; a write into a part of it stores no function.
        if nodeAt(cwPeel(n.binLeft)) is Ident {
          if !cwFvAddValue(n.binRight, out) { return false }
        }
      }
    }
  }
  binds > 0 && binds == cwDeclCount(bd)
}

// The write that stores function `decl` into the binding `b` (`cwBindingOf`): the `let`
// initialiser or the `nm = v` assignment whose value may be `decl`; -1 when no such write does.
export function cwFnValueWriteOf(b: i32, decl: i32): i32 {
  if b < 0 { return -1 }
  const ow = cwOccWalk(b)
  while cwOccNext(ow) {
    const r = ow.row
    const at = cwIxNode[r]
    const n = nodeAt(at)
    const one: i32[] = []
    if cwIxKind[r] == CW_OCC_BIND && n is LetDecl && n.letInit >= 0 {
      if cwFvAddValue(n.letInit, one) && i32ListHas(one, decl) {
        return n.letInit
      }
    } else if cwIxKind[r] == CW_OCC_ASG && n is BinExpr {
      if nodeAt(cwPeel(n.binLeft)) is Ident && cwFvAddValue(n.binRight, one) {
        if i32ListHas(one, decl) { return at }
      }
    }
  }
  -1
}

// The functions the `let` node `bd` may hold: its initialiser and each assignment its own scope
// resolves to it, ascending; [-1] when one is not a function or a binder this does not model
// shadows its name. Sees the block a name is declared in, which the frames do not.
export function cwLetFnTargets(bd: i32): i32[] {
  const bad: i32[] = [-1]
  const n = nodeAt(bd)
  if !(n is LetDecl) || !cwLexScopeOk(bd) { return bad }
  const out: i32[] = []
  if !cwFvAddValue(n.letInit, out) { return bad }
  const none: i32[] = []
  for v in cwLexStores[bd] ?? none {
    if !cwFvAddValue(v, out) { return bad }
  }
  out
}

// The functions the `let` node `bd`, binding `x`, has written into its slots by `x[k] = v`,
// `x.push(v)` and `x.set(k, v)` in its own scope; [-1] when one is not a function or the
// scope is not modelled.
export function cwLetSlotFnTargets(bd: i32): i32[] {
  const bad: i32[] = [-1]
  if !cwLexScopeOk(bd) { return bad }
  const out: i32[] = []
  const none: i32[] = []
  for v in cwLexSlotStores[bd] ?? none {
    if !cwFvAddValue(v, out) { return bad }
  }
  out
}

// Walks the scope of the initialised `let` node `bd` for its name once; false when it has a
// binder the walk does not model.
function cwLexScopeOk(bd: i32): boolean {
  const n = nodeAt(bd)
  if !(n is LetDecl) || n.letInit < 0 { return false }
  const nm = n.letName
  const fr = cwFrameOfDecl(bd)
  const key = cwDeclRepOf(bd)
  if fr == CW_FR_UNKNOWN || key < 0 { return false }
  if !(cwLexDone.get(key) ?? false) {
    cwLexDone.set(key, true)
    cwLexBail = false
    if fr == CW_FR_MOD {
      for nd in P.nodes {
        if nd is Program { cwLexSeq(nd.progStmts, nm, -1) }
      }
    } else if fr >= 0 && fr < P.nodes.length {
      const f = nodeAt(fr)
      if f is FuncDecl { cwLexWalk(f.fnBody, nm, -1) } else { cwLexBail = true }
    } else {
      cwLexBail = true
    }
    if cwLexBail { cwLexBailed.set(key, true) }
  }
  !(cwLexBailed.get(key) ?? false)
}

// Whether node `e`, parentheses peeled, reads the binding the `let` node `bd` declares.
function cwLexReadsDecl(e: i32, bd: i32): boolean {
  const v = cwPeel(e)
  if bd < 0 || v < 0 || v >= P.nodes.length { return false }
  nodeAt(v) is Ident && identDeclOf(v) == bd
}

// Files value `v` as written into a slot of the `let` node `bd`.
function cwLexSlotPush(bd: i32, v: i32) {
  const have = cwLexSlotStores[bd] ?? []
  have.push(v)
  cwLexSlotStores[bd] = have
  0
}

// By `let` node, the values its scope's `nm = v` writes store, and the values its slot writes
// store; by the first declaration of a frame's name, whether that frame has been walked for it,
// and whether the walk met a binder it does not model.
let cwLexSlotStores: Map<i32, i32[]> = Map()
let cwLexStores: Map<i32, i32[]> = Map()
let cwLexDone: Map<i32, boolean> = Map()
let cwLexBailed: Map<i32, boolean> = Map()
let cwLexBail = false

// Walks statements `xs` in order, `cur` the `let` of `nm` in scope (-1 for another binder).
function cwLexSeq(xs: i32[], nm: string, cur: i32) {
  let c = cur
  for x in xs { c = cwLexWalk(x, nm, c) }
  0
}

// Files each `nm = v` under node `ix` against the `let` it resolves to, starting from `cur`;
// the binding in scope after `ix`.
function cwLexWalk(ix: i32, nm: string, cur: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return cur }
  const n = nodeAt(ix)
  const kids: i32[] = []
  let inner = cur
  let after = cur
  match n {
    Block => {
      cwLexSeq(n.blkStmts, nm, cur)
      return cur
    }
    LetDecl => {
      cwLexWalk(n.letInit, nm, cur)
      if n.letName == nm { return ix }
      return cur
    }
    FuncDecl => {
      if n.fnName == nm { after = -1 }
      for p in n.fnParams {
        const pn = nodeAt(p)
        if pn is Param && pn.parName == nm { inner = -1 }
      }
      if n.fnName == nm { inner = -1 }
      cwLexWalk(n.fnBody, nm, inner)
      return after
    }
    ForIn => {
      cwLexWalk(n.fiIter, nm, cur)
      if n.fiVar == nm || n.fiVar2 == nm { inner = -1 }
      cwLexWalk(n.fiBody, nm, inner)
      return cur
    }
    ForRange => {
      cwLexWalk(n.frFrom, nm, cur)
      cwLexWalk(n.frTo, nm, cur)
      cwLexWalk(n.frStep, nm, cur)
      if n.frVar == nm { inner = -1 }
      cwLexWalk(n.frBody, nm, inner)
      return cur
    }
    MatchExpr => {
      // A payload binding enters an arm only once the match is desugared.
      for b in n.matchBinds {
        const bn = if b >= 0 { nodeAt(b) } else { null }
        if bn is Block {
          for st in bn.blkStmts {
            const sn = nodeAt(st)
            if sn is LetDecl && sn.letName == nm { cwLexBail = true }
          }
        }
      }
      nodeChildrenPush(ix, kids)
    }
    BinExpr => {
      const l = nodeAt(cwPeel(n.binLeft))
      if n.binOp == "=" && l is Ident && l.identName == nm && cur >= 0 {
        const have = cwLexStores[cur] ?? []
        have.push(n.binRight)
        cwLexStores[cur] = have
      }
      if n.binOp == "=" && l is Index && cwLexReadsDecl(l.idxArr, cur) {
        cwLexSlotPush(cur, n.binRight)
      }
      nodeChildrenPush(ix, kids)
    }
    Call => {
      const cf = if n.callFn >= 0 { nodeAt(n.callFn) } else { null }
      if cf is Member && cwLexReadsDecl(cf.memObj, cur) {
        if cf.memProp == "push" {
          for a in n.callArgs { cwLexSlotPush(cur, a) }
        } else if cf.memProp == "set" && n.callArgs.length == 2 {
          cwLexSlotPush(cur, n.callArgs[1])
        }
      }
      nodeChildrenPush(ix, kids)
    }
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Member | OptMember | ErrExpr | Paren | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ImportDecl | Spread | LoopVar => {
      nodeChildrenPush(ix, kids)
    }
  }
  for k in kids { cwLexWalk(k, nm, cur) }
  cur
}

// Every value stored into the binding `b` (`cwBindingOf`): its `let` initialiser and the value
// of each `nm = v`; [] for a binding with no index rows.
export function cwBindingWrittenValues(b: i32): i32[] {
  const out: i32[] = []
  if b < 0 { return out }
  const ow = cwOccWalk(b)
  while cwOccNext(ow) {
    const r = ow.row
    const n = nodeAt(cwIxNode[r])
    if cwIxKind[r] == CW_OCC_BIND && n is LetDecl && n.letInit >= 0 {
      out.push(n.letInit)
    } else if cwIxKind[r] == CW_OCC_ASG && n is BinExpr {
      if nodeAt(cwPeel(n.binLeft)) is Ident { out.push(n.binRight) }
    }
  }
  out
}

// The root identifier of the place `a` reads through list elements and record fields, with the
// steps from it in `path` root first (a field name, or "[]" for an element); -1 for any other root.
// A `for` loop's element variable reads an element of what the loop walks.
export function cwSlotPath(a: i32, path: string[]): i32 {
  const rev: string[] = []
  let ix = cwPeel(a)
  while ix >= 0 && ix < P.nodes.length && rev.length < 16 {
    const n = nodeAt(ix)
    const fi = cwForInBinderOf(ix)
    if fi >= 0 {
      const fl = nodeAt(fi)
      if !(fl is ForIn) { return -1 }
      rev.push("[]")
      ix = cwPeel(fl.fiIter)
    } else if n is Ident && cwElemCallbackRecvOfRead(ix) >= 0 {
      rev.push("[]")
      ix = cwPeel(cwElemCallbackRecvOfRead(ix))
    } else if n is Ident {
      let k = rev.length - 1
      while k >= 0 {
        path.push(rev[k])
        k = k - 1
      }
      return ix
    } else if n is Index {
      rev.push("[]")
      ix = cwPeel(n.idxArr)
    } else if cwGetRecv(ix) >= 0 {
      rev.push("[]")
      ix = cwPeel(cwGetRecv(ix))
    } else if n is Member {
      rev.push(n.memProp)
      ix = cwPeel(n.memObj)
    } else if n is OptMember {
      rev.push(n.omProp)
      ix = cwPeel(n.omObj)
    } else {
      return -1
    }
  }
  -1
}

// The receiver of `ix` when it is a `.get(k)` call, which reads an element of a list or a value
// of a map as an index does; -1 otherwise.
export function cwGetRecv(ix: i32): i32 {
  const x = cwPeel(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const c = nodeAt(x)
  if !(c is Call) || c.callArgs.length != 1 || c.callFn < 0 { return -1 }
  if hasNamedArgs(c.callArgNames) { return -1 }
  const m = nodeAt(cwPeel(c.callFn))
  if !(m is Member) || m.memProp != "get" { return -1 }
  m.memObj
}

// Whether `x` is a fresh `Map()`, which holds no value yet.
function cwFreshMap(x: i32): boolean {
  const c = nodeAt(x)
  if !(c is Call) || c.callArgs.length != 0 || c.callFn < 0 { return false }
  const f = nodeAt(cwPeel(c.callFn))
  f is Ident && f.identName == "Map" && identDeclOf(cwPeel(c.callFn)) < 0
}

// Every value stored at `path` under the binding `b0` (`cwBindingOf`) in `vals`, each blamed in
// `ats` on its literal, its `p = v` (at `path` or a prefix) or its `p.push(v)`, through any alias.
// Returns how many came from a write after the initialiser, or -1 when one is not a literal's part.
export function cwSlotWrittenValues(
  b0: i32,
  path: string[],
  vals: i32[],
  ats: i32[],
): i32 {
  if b0 < 0 || path.length == 0 { return -1 }
  // An alias holds the list or record of the binding that initialises it: start from that one.
  let b = b0
  let steps = 0
  while steps < 16 {
    const up = cwSlotAliasOf(b)
    if up < 0 { break }
    b = cwBindingOf(up)
    steps = steps + 1
  }
  const bd = cwSoleDecl(b)
  if bd < 0 { return -1 }
  const bn = nodeAt(bd)
  if !(bn is LetDecl) { return -1 }
  const inits = [bn.letInit]
  cwSlotValuesFrom(b, bn.letInit, inits, path, vals, ats)
}

// `cwSlotWrittenValues` for the `let` binding `b` whose initialiser `init` stores the values
// `inits`: a call's returned values, when the call returns a fresh list or record.
export function cwSlotValuesFrom(
  b: i32,
  init: i32,
  inits: i32[],
  path: string[],
  vals: i32[],
  ats: i32[],
): i32 {
  for v in inits {
    if !cwSlotDescend(v, path, 0, -1, vals, ats) { return -1 }
  }
  const nBound = vals.length
  for v in cwBindingWrittenValues(b) {
    if v != init && !cwSlotDescend(v, path, 0, -1, vals, ats) { return -1 }
  }
  if b < 0 { return -1 }
  if !cwSlotWritesInto(b, path, vals, ats, 0) { return -1 }
  vals.length - nBound
}

// Add what each write through a handle on the container keyed `k` (`cwKeyOfDecl`), or on a
// list or record literal holding it, stores at `path` (D12239); false when one is not a
// literal's part.
function cwSlotWritesInto(
  k: i32,
  path: string[],
  vals: i32[],
  ats: i32[],
  depth: i32,
): boolean {
  if depth > 8 { return false }
  const keys: i32[] = []
  cwContainerAliases(k, keys)
  let i = 0
  while i < keys.length {
    if i == 0 || cwSlotHandle(keys[i]) {
      if !cwSlotWritesThrough(keys[i], path, vals, ats) { return false }
      if !cwSlotHeldWrites(keys[i], path, vals, ats, depth) { return false }
    }
    i = i + 1
  }
  true
}

// `cwSlotWritesInto` at each `let` whose literal holds the binding keyed `k` as an element or
// field value, at the literal's path to it followed by `path`.
function cwSlotHeldWrites(
  k: i32,
  path: string[],
  vals: i32[],
  ats: i32[],
  depth: i32,
): boolean {
  const fr = cwKeyFrame(k)
  const ow = cwOccWalk(k)
  while cwOccNext(ow) {
    const r = ow.row
    const u = cwIxNode[r]
    if (
      cwIxKind[r] == CW_OCC_USE
      && cwIxFr[r] == fr
      && u >= 0
      && u < cwIxUpKind.length
    ) {
      const uk = cwIxUpKind[u]
      let fld = ""
      if uk == CW_UP_ELEM { fld = CW_ELEM_FLD }
      if uk == CW_UP_FIELD { fld = cwFieldNameOf(cwIxUpAux[u]) }
      const on: i32[] = []
      const op: string[] = []
      if fld != "" && cwLitOwners(cwIxUp[u], fld, on, op, 0) {
        let j = 0
        while j < on.length {
          const steps = cwSplitPath(op[j])
          // A write re-pointing the place that held the name stores another container there.
          if !cwSlotRepointed(on[j], steps) {
            for s in path { steps.push(s) }
            if !cwSlotWritesInto(on[j], steps, vals, ats, depth + 1) {
              return false
            }
          }
          j = j + 1
        }
      }
    }
  }
  true
}

// Whether a write through a handle on the container keyed `k` stores at `held` or at a place
// holding it.
function cwSlotRepointed(k: i32, held: string[]): boolean {
  const keys: i32[] = []
  cwContainerAliases(k, keys)
  let i = 0
  while i < keys.length {
    if i == 0 || cwSlotHandle(keys[i]) {
      const fr = cwKeyFrame(keys[i])
      const ow = cwOccWalk(keys[i])
      while cwOccNext(ow) {
        const r = ow.row
        if cwIxKind[r] == CW_OCC_USE && cwIxFr[r] == fr {
          let top = cwIxNode[r]
          while (
            top >= 0
            && top < cwIxUpKind.length
            && cwIxUpKind[top] == CW_UP_OBJ
          ) {
            top = cwIxUp[top]
          }
          const lp: string[] = []
          if (
            top >= 0
            && top < cwIxUpKind.length
            && cwIxUpKind[top] == CW_UP_ASG_LHS
            && cwSlotPath(top, lp) >= 0
            && lp.length > 0
            && cwPathPrefix(lp, held)
          ) {
            return true
          }
        }
      }
    }
    i = i + 1
  }
  false
}

// The steps of a path key `cwJoinPath` spelled.
function cwSplitPath(p: string): string[] {
  const out: string[] = []
  let at = 0
  let i = 0
  while i <= p.length {
    if i == p.length || p.slice(i, i + 1) == "." {
      if i > at { out.push(p.slice(at, i)) }
      at = i + 1
    }
    i = i + 1
  }
  out
}

// The identifier the `let` binding `b` is bound once to when it names another `let`, or -1.
function cwSlotAliasOf(b: i32): i32 {
  const bd = cwSoleDecl(b)
  if bd < 0 || bd >= P.nodes.length || !cwBoundOnce(cwOccWalk(bd)) { return -1 }
  const bn = nodeAt(bd)
  if !(bn is LetDecl) { return -1 }
  const init = cwPeel(bn.letInit)
  if init < 0 || init >= P.nodes.length || !cwFramedNode(init) { return -1 }
  const inn = nodeAt(init)
  if !(inn is Ident) { return -1 }
  const ib = cwSoleBinderAt(init)
  if ib < 0 || ib >= P.nodes.length || !(nodeAt(ib) is LetDecl) { return -1 }
  init
}

// Whether a write through the alias keyed `k` reaches the list or record it names:
// a parameter, or a `let` bound once to another binding.
function cwSlotHandle(k: i32): boolean {
  const bd = cwSoleDecl(k)
  if bd < 0 || bd >= P.nodes.length { return false }
  if nodeAt(bd) is Param { return true }
  cwSlotAliasOf(bd) >= 0
}

// Add to `vals` and `ats` what each write through the binding keyed `k` stores at `path`;
// false when one stored value is not a literal's part.
function cwSlotWritesThrough(
  k: i32,
  path: string[],
  vals: i32[],
  ats: i32[],
): boolean {
  const fr = cwKeyFrame(k)
  const ow = cwOccWalk(k)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_USE && cwIxFr[r] == fr {
      // Climb from the name to the outermost element or field read it roots.
      let top = cwIxNode[r]
      while (
        top >= 0
        && top < cwIxUpKind.length
        && cwIxUpKind[top] == CW_UP_OBJ
      ) {
        top = cwIxUp[top]
      }
      if top >= 0 && top < cwIxUpKind.length {
        const up = cwIxUp[top]
        const uk = cwIxUpKind[top]
        const tn = nodeAt(top)
        const lp: string[] = []
        if uk == CW_UP_ASG_LHS && up >= 0 {
          const an = nodeAt(up)
          if an is BinExpr {
            if (
              cwSlotPath(top, lp) >= 0
              && lp.length > 0
              && cwPathPrefix(lp, path)
            ) {
              let blame = -1
              if lp.length == path.length { blame = up }
              if (
                !cwSlotDescend(an.binRight, path, lp.length, blame, vals, ats)
              ) {
                return false
              }
            }
          }
        } else if uk == CW_UP_CALLEE && up >= 0 && tn is Member {
          // A `push` onto the list holding the place adds an element to it, or a record or list
          // holding it (D9370).
          const c = nodeAt(up)
          if tn.memProp == "push" && c is Call {
            if (
              cwSlotPath(tn.memObj, lp) >= 0
              && lp.length < path.length
              && path[lp.length] == "[]"
              && cwPathPrefix(lp, path)
            ) {
              for v in c.callArgs {
                if nodeAt(cwPeel(v)) is Spread { return false }
                if lp.length == path.length - 1 {
                  vals.push(v)
                  ats.push(v)
                } else if (
                  !cwSlotDescend(v, path, lp.length + 1, -1, vals, ats)
                ) {
                  return false
                }
              }
            }
          }
          // A `set` on the map holding the place stores its value there (D9311).
          if tn.memProp == "set" && c is Call && c.callArgs.length == 2 {
            if (
              !hasNamedArgs(c.callArgNames)
              && cwSlotPath(tn.memObj, lp) >= 0
              && lp.length < path.length
              && path[lp.length] == "[]"
              && cwPathPrefix(lp, path)
            ) {
              if (
                !cwSlotDescend(c.callArgs[1], path, lp.length + 1, -1, vals, ats)
              ) {
                return false
              }
            }
          }
        }
      }
    }
  }
  true
}

// The `for` loop whose element variable the read `ix` names, or -1.
export function cwForInBinderOf(ix: i32): i32 {
  const p = cwPeel(ix)
  if p < 0 || p >= P.nodes.length || !cwFramedNode(p) { return -1 }
  if !(nodeAt(p) is Ident) { return -1 }
  const d = identDeclOf(p)
  const lp = loopVarLoop(d)
  if lp < 0 || lp >= P.nodes.length { return -1 }
  const l = nodeAt(lp)
  if l is ForIn {
    if l.fiDecl1 == d { return lp }
  }
  -1
}

// Whether every step of `p` is the step of `path` at its position.
function cwPathPrefix(p: string[], path: string[]): boolean {
  if p.length > path.length { return false }
  let k = 0
  while k < p.length {
    if p[k] != path[k] { return false }
    k = k + 1
  }
  true
}

// Add to `vals` what value `e` holds at the steps of `path` from `k`, through list and record
// literals and the bindings they name, blamed on `blame` (or on the value itself at -1); false at
// any other node.
function cwSlotDescend(
  e: i32,
  path: string[],
  k: i32,
  blame: i32,
  vals: i32[],
  ats: i32[],
): boolean {
  const v = cwPeel(e)
  if v < 0 || v >= P.nodes.length { return false }
  if k >= path.length {
    vals.push(v)
    if blame >= 0 { ats.push(blame) } else { ats.push(v) }
    return true
  }
  const n = nodeAt(v)
  if n is Ident { return cwSlotDescendBinding(v, path, k, vals, ats) }
  if path[k] == "[]" {
    if cwFreshMap(v) { return true }
    if !(n is ArrayLit) { return false }
    for el in n.arrElems {
      if nodeAt(cwPeel(el)) is Spread { return false }
      if !cwSlotDescend(el, path, k + 1, blame, vals, ats) { return false }
    }
    return true
  }
  if !(n is ObjLit) { return false }
  for f in n.objFields {
    const fi = nodeAt(f)
    if !(fi is FieldInit) { return false }
    if fi.fiName == path[k] {
      return cwSlotDescend(fi.fiValue, path, k + 1, blame, vals, ats)
    }
  }
  false
}

let cwDescendDepth = 0

// `cwSlotDescend` at the binding the identifier `v` names: every value it holds at the steps of
// `path` from `k`, so `const r0 = { f: half }; m.set("b", r0)` stores `half` (D9470). False when
// `v` is not a framed binding bound once, or the chain of bindings is deeper than 16.
function cwSlotDescendBinding(
  v: i32,
  path: string[],
  k: i32,
  vals: i32[],
  ats: i32[],
): boolean {
  if !cwFramedNode(v) || cwDescendDepth >= 16 { return false }
  const b = cwBindingOf(v)
  if b < 0 { return false }
  const sub: string[] = []
  let i = k
  while i < path.length {
    sub.push(path[i])
    i = i + 1
  }
  cwDescendDepth = cwDescendDepth + 1
  const got = cwSlotWrittenValues(b, sub, vals, ats)
  cwDescendDepth = cwDescendDepth - 1
  got >= 0
}

// Add the functions the value expression `e` may be to `out`: a lambda, or what the name it is
// spells may be. False for anything else.
function cwFvAddValue(e: i32, out: i32[]): boolean {
  const v = cwPeel(e)
  if v < 0 || v >= P.nodes.length { return false }
  if nodeAt(v) is FuncDecl {
    if !i32ListHas(out, v) { out.push(v) }
    return true
  }
  cwFvAddNamed(v, out)
}

// Add the functions the identifier at `v` may be to `out`: the function it declares, or every
// function the binding it names may hold. False when `v` is not an identifier.
function cwFvAddNamed(v: i32, out: i32[]): boolean {
  const n = nodeAt(v)
  if n is Ident {
    const vf = cwFrameOfUse(v)
    if vf == CW_FR_UNKNOWN { return false }
    const d = cwFnDeclOf(n.identName)
    if d >= 0 && d < cwFrameOf.length && cwFrameOf[d] == vf {
      if cwDeclCount(d) != 1 { return false }
      if !i32ListHas(out, d) { out.push(d) }
      return true
    }
    const ts = cwFvTargetsOf(cwBindingOf(v))
    if ts.length > 0 && ts[0] < 0 { return false }
    let i = 0
    while i < ts.length {
      if !i32ListHas(out, ts[i]) { out.push(ts[i]) }
      i = i + 1
    }
    return true
  }
  false
}

// Add what the parameter at `pIx` may hold: the argument every call of its named function hands
// it, or its default where a call omits it. False when the function is reached any other way —
// as a value, a method, through a spread or named arguments — or the parameter is a rest one.
function cwFvAddParam(pIx: i32, out: i32[]): boolean {
  const vs: i32[] = []
  if !cwParamArgs(pIx, vs) { return false }
  for v in vs {
    if !cwFvAddValue(v, out) { return false }
  }
  true
}

// Add to `out` the value expression every call of the named function declaring the parameter at
// `pIx` hands it: its argument, or the default where a call omits it. False under the
// `cwFvAddParam` declines.
export function cwParamArgs(pIx: i32, out: i32[]): boolean {
  const pn = nodeAt(pIx)
  if !(pn is Param) { return false }
  if pn.parRest == 1 { return false }
  const f = cwFrameOfDecl(pIx)
  if f < 0 || f >= P.nodes.length { return false }
  const fd = nodeAt(f)
  if !(fd is FuncDecl) { return false }
  if fd.fnName == "" { return false }
  const j = i32ListIndexOf(fd.fnParams, pIx)
  if j < 0 { return false }
  // A method spelling of the name may reach this function with a receiver in front.
  let m = cwIxChain(demangleName(fd.fnName))
  while m >= 0 {
    if cwIxKind[m] == CW_OCC_MCALL { return false }
    m = cwIxNext[m]
  }
  let r = cwIxChain(fd.fnName)
  while r >= 0 {
    if cwIxKind[r] == CW_OCC_USE {
      const u = cwIxNode[r]
      if cwIxUpKind[u] != CW_UP_CALLEE { return false }
      const c = nodeAt(cwIxUp[u])
      if !(c is Call) { return false }
      if hasNamedArgs(c.callArgNames) { return false }
      let a = 0
      while a < c.callArgs.length && a <= j {
        if nodeAt(cwPeel(c.callArgs[a])) is Spread { return false }
        a = a + 1
      }
      if j < c.callArgs.length { out.push(c.callArgs[j]) }
      else if pn.parDefault >= 0 { out.push(pn.parDefault) }
      else { return false }
    }
    r = cwIxNext[r]
  }
  true
}

// The list a `.map` / `.filter` call runs the lambda declaring the parameter at `pIx` over, when
// that parameter is the lambda's first and so holds each element of it; -1 otherwise (D9172).
export function cwElemCallbackRecv(pIx: i32): i32 {
  if pIx < 0 || pIx >= P.nodes.length { return -1 }
  const pn = nodeAt(pIx)
  if !(pn is Param) || pn.parRest == 1 { return -1 }
  const f = cwFrameOfDecl(pIx)
  if f < 0 || f >= P.nodes.length { return -1 }
  const fd = nodeAt(f)
  if !(fd is FuncDecl) || fd.fnParams.length == 0 || fd.fnParams[0] != pIx {
    return -1
  }
  const ln = fd.fnName
  if ln != "" && (ln.length < 8 || ln.slice(0, 8) != "__lambda") { return -1 }
  cwIxBuild()
  let at = -1
  if f < cwIxParent.length { at = cwIxParent[f] }
  while at >= 0 && at < P.nodes.length && nodeAt(at) is Paren {
    if at < cwIxParent.length { at = cwIxParent[at] } else { at = -1 }
  }
  if at < 0 || at >= P.nodes.length { return -1 }
  const c = nodeAt(at)
  if !(c is Call) || c.callArgs.length != 1 || cwPeel(c.callArgs[0]) != f {
    return -1
  }
  const cf = cwPeel(c.callFn)
  if cf < 0 || cf >= P.nodes.length { return -1 }
  const m = nodeAt(cf)
  if !(m is Member) || (m.memProp != "map" && m.memProp != "filter") {
    return -1
  }
  m.memObj
}

// `cwElemCallbackRecv` of the parameter the read `ix` names; -1 when it names anything else.
function cwElemCallbackRecvOfRead(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length || !cwFramedNode(ix) { return -1 }
  const n = nodeAt(ix)
  if !(n is Ident) { return -1 }
  cwElemCallbackRecv(cwSoleBinderAt(ix))
}

// The `FuncDecl` a callee EXPRESSION resolves to: the declared function its name binds, or
// the lambda a `const` in scope binds. A function VALUE's parameter list is in the arena
// either way; the name-keyed index holds only declared functions. -1 for a callee this
// cannot place, which is the decline the callers turn into the `2` answer. D1683.
export function cwCalleeDeclOf(callFnIx: i32): i32 {
  const nm = covarRootName(callFnIx)
  if nm == "" { return cwUfcsDeclOf(callFnIx) }
  const d = cwFnDeclOf(nm)
  if d >= 0 { return d }
  cwLambdaDeclOf(cwBindingOf(callFnIx))
}

// The declaration a UFCS callee (`xs.f(y)`) reaches: the member's PROPERTY names the free
// `self`-function, which `covarRootName` cannot spell. Gated on the declaration actually
// taking `self` first, so a closure-valued field read (`o.fn(x)`) does not resolve to an
// unrelated top-level `fn`. D1799.
export function cwUfcsDeclOf(callFnIx: i32): i32 {
  const cf = cwPeel(callFnIx)
  if cf < 0 || cf >= P.nodes.length { return -1 }
  const m = nodeAt(cf)
  if m is Member {
    const r = cwRecordedMethodOf(cf)
    if r != -2 { return r }
    if !declFirstParamIsSelf(m.memProp) { return -1 }
    return cwFnDeclOf(m.memProp)
  }
  -1
}

// The function member callee `memIx`'s recorded declaration declares as a method: a declared
// function, or the lambda a `const` binds, so one parameter list answers every call; -1 for
// any other binding, and -2 when the spelling recorded none.
function cwRecordedMethodOf(memIx: i32): i32 {
  const d = memberDeclOf(memIx)
  if d < 0 { return -2 }
  const f = methodFnOfDecl(d)
  if f < 0 || f == d { return f }
  const dn = nodeAt(d)
  if dn is LetDecl {
    if dn.letKw == "const" { return f }
  }
  -1
}

// The parameter-slot offset an ARGUMENT index needs at this callee: 0 for a direct call, 1
// for a UFCS spelling, whose receiver fills parameter 0. Every reader of the
// argument->parameter edge applies this one answer, so none can outrun another (D1658).
export function cwCalleeArgOff(callFnIx: i32): i32 {
  if covarRootName(callFnIx) != "" { return 0 }
  if cwUfcsDeclOf(callFnIx) < 0 { return 0 }
  1
}

// The `Param` node at position `argIx` of the `FuncDecl` `dIx`, or -1 past its list or at a
// parameter with no name.
export function cwParamOfDecl(dIx: i32, argIx: i32): i32 {
  if dIx < 0 || dIx >= P.nodes.length { return -1 }
  const d = nodeAt(dIx)
  if d is FuncDecl {
    if argIx >= 0 && argIx < d.fnParams.length {
      const pIx = d.fnParams[argIx]
      const p = nodeAt(pIx)
      if p is Param {
        if p.parName != "" { return pIx }
      }
    }
  }
  -1
}

// The type-annotation node of the parameter at position `argIx` of `FuncDecl` `dIx`, or -1
// past the list, at an un-annotated parameter, or where the callee cannot be placed.
export function cwParamAnnOfDecl(dIx: i32, argIx: i32): i32 {
  if dIx < 0 || dIx >= P.nodes.length { return -1 }
  const d = nodeAt(dIx)
  if d is FuncDecl {
    if argIx < d.fnParams.length {
      const p = nodeAt(d.fnParams[argIx])
      if p is Param { return p.parType }
    }
  }
  -1
}

// The `FuncDecl` node of the top-level function `fnName`, or `CW_FR_UNKNOWN`. A parameter
// declares into the frame its own function opens, so this is the frame the argument edge
// binds the parameter in.
function cwParamFrame(fnName: string): i32 {
  const dIx = cwFnDeclOf(fnName)
  if dIx < 0 { return CW_FR_UNKNOWN }
  dIx
}

// The binding key (`cwKeyOfDecl`) of the parameter an expression consumed as a call ARGUMENT
// is delivered to, or -1 where the consuming call names no callee this can read a parameter
// list off. The closure's edge and the claim's own test read this one resolver. D1658.
export function cwArgParamKey(x: i32): i32 {
  if x < 0 || x >= cwIxUpKind.length { return -1 }
  if cwIxUpKind[x] != CW_UP_ARG { return -1 }
  const up = cwIxUp[x]
  if up < 0 || up >= P.nodes.length { return -1 }
  const n = nodeAt(up)
  if n is Call {
    if hasNamedArgs(n.callArgNames) { return -1 }
    const pIx = cwParamOfDecl(
      cwCalleeDeclOf(n.callFn),
      cwIxUpAux[x] + cwCalleeArgOff(n.callFn),
    )
    return cwKeyOfDecl(pIx)
  }
  -1
}

// The `flds` entry an ARRAY or MAP escape records. No field name can spell it, so a
// `Member` read never collides with the `Index` read it stands for.
export const CW_ELEM_FLD = "[]"

// —— the escape key: a container name plus the path inside it (D1628, deepened by D1682) ——
// Join two path segments. The one spelling rule the key has, so the side that FILES a key and
// the side that recognises a handle cannot disagree about how a nested one is written.
function cwJoinPath(a: string, b: string): string {
  if a == "" { return b }
  if b == "" { return a }
  a + "." + b
}

// The identifier a projection chain bottoms out at, or -1 where it bottoms out at anything
// else — a call result, a literal — which names no container.
export function cwProjRootNode(ix: i32): i32 {
  const p = cwPeel(ix)
  if p < 0 || p >= P.nodes.length { return -1 }
  const n = nodeAt(p)
  match n {
    Ident => {
      return p
    }
    Member => {
      return cwProjRootNode(n.memObj)
    }
    OptMember => {
      return cwProjRootNode(n.omObj)
    }
    Index => {
      return cwProjRootNode(n.idxArr)
    }
    // any other root names no container
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The dotted path from that root to `ix`: `"xs"` for `sf.xs`, `"inn.xs"` for `o.inn.xs`,
// `CW_ELEM_FLD` for an index, `""` for the root name itself. An index position is not read,
// so one recorded element makes every element a handle — the safe direction.
function cwProjPath(ix: i32): string {
  const p = cwPeel(ix)
  if p < 0 || p >= P.nodes.length { return "" }
  const n = nodeAt(p)
  match n {
    Member => {
      return cwJoinPath(cwProjPath(n.memObj), n.memProp)
    }
    OptMember => {
      return cwJoinPath(cwProjPath(n.omObj), n.omProp)
    }
    Index => {
      return cwJoinPath(cwProjPath(n.idxArr), CW_ELEM_FLD)
    }
    // the root, or a form with no path
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  ""
}

// —— naming the container a store delivers into (D1628) ——
// The container expression a peeled store destination projects out of — `w` in `w.f`, `xs`
// in `xs[i]` and in a `push` call's own callee — or -1 for a form with no container.
function cwEscapeObj(dst: i32): i32 {
  if dst < 0 || dst >= P.nodes.length { return -1 }
  cwIxBuild()
  cwIxObj[dst]
}

// The container's binding key, or -1 exactly where this analysis cannot identify it — no
// name at the root, or a name re-bound in its frame, which would name two containers rather
// than one. Nothing is then recorded and nothing is claimed.
export function cwEscapeKey(dst: i32): i32 {
  const rt = cwProjRootNode(cwEscapeObj(dst))
  if rt < 0 { return -1 }
  const k = cwKeyOfRoot(rt)
  if k == -1 { return -1 }
  if !cwBoundOnce(cwOccWalkUse(cwPeelValue(rt))) { return -1 }
  k
}

// The key the escape is filed under. `elem` forces the element key for a form whose member
// name is not a field: a `push` callee spells the METHOD, and an index spells no name.
function cwEscapeFld(dst: i32, elem: boolean): string {
  if elem { return cwJoinPath(cwProjPath(cwEscapeObj(dst)), CW_ELEM_FLD) }
  if dst < 0 || dst >= P.nodes.length { return "" }
  cwProjPath(dst)
}

// —— one container, every name that reaches it (D1658) ——
// A container bound to a second name, or handed to a function, is still one container, so a
// read through either is a handle on what it holds. `keys` collects the closure from `k`; the
// answer is whether every use of every binding in it is one this analysis models.
function cwContainerAliases(k: i32, keys: i32[]): boolean {
  cwIxBuild()
  cwAdd(keys, k)
  let ok = true
  let i = 0
  while i < keys.length {
    // A name bound twice, or re-pointed, names two containers rather than one.
    if cwBoundOnceSealed(cwOccWalk(keys[i])) < 1 { ok = false }
    // The set grows by at least one binding per binding visited or the walk ends, so the
    // bound is the number of bindings in the program; a surprise past it declines.
    if keys.length > 256 { return false }
    const ow = cwOccWalk(keys[i])
    while cwOccNext(ow) {
      const r = ow.row
      if cwIxKind[r] == CW_OCC_USE {
        if !cwAliasUse(cwIxNode[r], keys) { ok = false }
      }
    }
    i = i + 1
  }
  ok
}

// Is the use `u` of a container name one this analysis models? Projecting out of it reads
// what it holds and a comparison yields a boolean, so neither hands the container on; a
// passthrough binding, a store to a plain name and a call argument each hand it a second
// name, which joins the closure. Any other form leaves the container unmodelled.
function cwAliasUse(u: i32, keys: i32[]): boolean {
  if u < 0 || u >= cwIxUpKind.length { return false }
  const k = cwIxUpKind[u]
  if k == CW_UP_OBJ { return true }
  if k == CW_UP_CMP { return true }
  const up = cwIxUp[u]
  if up < 0 || up >= P.nodes.length { return false }
  if k == CW_UP_LETINIT {
    const d = nodeAt(up)
    if d is LetDecl {
      cwAdd(keys, cwKeyOfDecl(up))
      return true
    }
    return false
  }
  if k == CW_UP_ASG_RHS {
    const n = nodeAt(up)
    if n is BinExpr {
      const lk = cwKeyOfRoot(n.binLeft)
      if lk == -1 { return false }
      cwAdd(keys, lk)
      // The assignment yields its right side, so a binding, a write or an argument that
      // consumes the assignment is one more handle (D2411).
      const vk = cwIxUpKind[up]
      if vk == CW_UP_LETINIT || vk == CW_UP_ASG_RHS || vk == CW_UP_ARG {
        return cwAliasUse(up, keys)
      }
      return true
    }
    return false
  }
  if k == CW_UP_ARG {
    const pk = cwArgParamKey(u)
    if pk == -1 { return false }
    cwAdd(keys, pk)
    return true
  }
  false
}

// File the container keyed `ok` under `fld`, and every binding that stands for the same
// container with it. The claim pass reads the same closure, so a container it passes a
// delivery through is one whose every handle is filed here. D1658.
export function cwFileEscape(
  ok: i32,
  fld: string,
  owners: i32[],
  flds: string[],
) {
  const keys: i32[] = []
  cwContainerAliases(ok, keys)
  let i = 0
  while i < keys.length {
    if !cwEscapedPairHas(keys[i], fld, owners, flds) {
      owners.push(keys[i])
      flds.push(fld)
    }
    i = i + 1
  }
  0
}

// The field name a `FieldInit` node spells, or "" — the key the object-literal escape is
// filed under.
export function cwFieldNameOf(fiIx: i32): string {
  if fiIx < 0 || fiIx >= P.nodes.length { return "" }
  const f = nodeAt(fiIx)
  if f is FieldInit { return f.fiName }
  ""
}

// The destination one call of a returning function delivers its result to, added to
// `keys`: a binding, a store to a plain name, or the parameter of a further call —
// `cwGrow`'s own call-result edge. False for a result reaching a name this cannot spell.
function cwCallDestKey(c: i32, keys: i32[]): boolean {
  if c < 0 || c >= cwIxUpKind.length { return false }
  const k = cwIxUpKind[c]
  const up = cwIxUp[c]
  if up < 0 || up >= P.nodes.length { return false }
  if k == CW_UP_LETINIT {
    const d = nodeAt(up)
    if d is LetDecl {
      cwAdd(keys, cwKeyOfDecl(up))
      return true
    }
    return false
  }
  if k == CW_UP_ASG_RHS {
    const n = nodeAt(up)
    if n is BinExpr {
      const lk = cwKeyOfRoot(n.binLeft)
      if lk == -1 { return false }
      cwAdd(keys, lk)
      return true
    }
    return false
  }
  if k == CW_UP_ARG {
    const pk = cwArgParamKey(c)
    if pk == -1 { return false }
    cwAdd(keys, pk)
    return true
  }
  false
}

// Every name a call of the function `fnIx` delivers its RESULT to — the containers a literal
// returned from it is reached through. False where some call hands the result on in a form
// with no name, which leaves the container unidentified. D1682.
function cwRetDestKeys(fnIx: i32, keys: i32[]): boolean {
  if fnIx < 0 || fnIx >= P.nodes.length { return false }
  const f = nodeAt(fnIx)
  if f is FuncDecl {
    const nm = f.fnName
    if nm == "" { return false }
    // A name a second declaration answers for resolves to that one, so calls of it are not
    // this frame's — the same guard the call-result edge takes.
    if cwParamFrame(nm) != fnIx { return false }
    cwIxBuild()
    let ok = true
    let r = cwIxChain(nm)
    while r >= 0 {
      if cwIxKind[r] == CW_OCC_CALL {
        if !cwCallDestKey(cwIxNode[r], keys) { ok = false }
      }
      r = cwIxNext[r]
    }
    return ok
  }
  false
}

// The containers a literal is reached through, and the path to `fld` inside each. A literal
// bound to a name is that name; one nested in another literal is the enclosing literal's own
// containers with the field prepended; one RETURNED is every destination its function's calls
// deliver to. False where the literal is consumed by a form with no container identity. D1682.
function cwLitOwners(
  lit: i32,
  fld: string,
  keys: i32[],
  paths: string[],
  depth: i32,
): boolean {
  if lit < 0 || lit >= cwIxUpKind.length { return false }
  // Literal nesting is a tree in the arena and cannot cycle; the cap turns a surprise into a
  // decline rather than a hang.
  if depth > 64 { return false }
  const k = cwIxUpKind[lit]
  const up = cwIxUp[lit]
  if k == CW_UP_LETINIT {
    if up < 0 || up >= P.nodes.length { return false }
    const d = nodeAt(up)
    if d is LetDecl {
      if !cwBoundOnce(cwOccWalk(up)) { return false }
      keys.push(cwKeyOfDecl(up))
      paths.push(fld)
      return true
    }
    return false
  }
  if k == CW_UP_FIELD {
    // A field this cannot name would leave the path unchanged, so the key would spell the
    // inner container's own field for the outer one's. Decline instead.
    const outer = cwJoinPath(cwFieldNameOf(cwIxUpAux[lit]), fld)
    if outer == fld { return false }
    return cwLitOwners(up, outer, keys, paths, depth + 1)
  }
  if k == CW_UP_ELEM {
    return cwLitOwners(up, cwJoinPath(CW_ELEM_FLD, fld), keys, paths, depth + 1)
  }
  if k == CW_UP_RET {
    return cwLitRetOwners(cwFrameOfDecl(up), fld, keys, paths)
  }
  if k == CW_UP_TAIL { return cwLitRetOwners(up, fld, keys, paths) }
  false
}

// A literal returned by `fnIx`: its containers are the destinations of every call, each
// holding the value at the same path.
function cwLitRetOwners(
  fnIx: i32,
  fld: string,
  keys: i32[],
  paths: string[],
): boolean {
  const dest: i32[] = []
  if !cwRetDestKeys(fnIx, dest) { return false }
  if dest.length == 0 { return false }
  let i = 0
  while i < dest.length {
    keys.push(dest[i])
    paths.push(fld)
    i = i + 1
  }
  true
}

// `{ xs: b }` / `[b]`: the literal `lit` carries a member, so the containers it is reached
// through hold that member at `fld`. A literal reached through nothing files no escape.
export function cwEscapeByLit(
  lit: i32,
  fld: string,
  owners: i32[],
  flds: string[],
) {
  const keys: i32[] = []
  const paths: string[] = []
  if !cwLitOwners(lit, fld, keys, paths, 0) { return 0 }
  let i = 0
  while i < keys.length {
    cwFileEscape(keys[i], paths[i], owners, flds)
    i = i + 1
  }
  0
}

// `w.f = b` / `xs[i] = b` / `m[k] = b` at `i`: the same escape by assignment rather than by a
// literal, so the value inside is reached by the same `<owner>.<f>` / `<owner>[i]` handle.
export function cwEscapeByStore(i: i32, owners: i32[], flds: string[]) {
  const n = nodeAt(i)
  if n is BinExpr {
    const dst = cwPeel(n.binLeft)
    const ok = cwEscapeKey(dst)
    if ok != -1 { cwFileEscape(ok, cwEscapeFld(dst, false), owners, flds) }
  }
  0
}

// Every read back out of a container the set escaped into — `<owner>.<f>` for a recorded
// pair, `<owner>[i]` for an element. Such a read is a handle on the value with no name of
// its own, so the closure and the write scan bind it exactly as they bind a member name.
export function cwEscapedHandleNodes(
  owners: i32[],
  flds: string[],
  out: i32[],
) {
  cwIxBuild()
  let i = 0
  while i < owners.length {
    const ow = cwOccWalk(owners[i])
    while cwOccNext(ow) {
      const r = ow.row
      if cwIxKind[r] == CW_OCC_USE {
        cwHandleUpChain(cwIxNode[r], flds[i], out)
      }
    }
    i = i + 1
  }
  0
}

// Climb the projections above the occurrence `u` and push the one whose path off the
// container spells `fld`. A chain that stops short — an intermediate handed a name of its own
// — pushes nothing, and a write through that name is then one the scan declines on rather
// than one it claims.
function cwHandleUpChain(u: i32, fld: string, out: i32[]) {
  let at = u
  let steps = 0
  while at >= 0 && at < cwIxUpKind.length && cwIxUpKind[at] == CW_UP_OBJ {
    const p = cwIxUp[at]
    if p < 0 || p >= P.nodes.length { return 0 }
    if cwProjPath(p) == fld {
      out.push(p)
      return 0
    }
    at = p
    steps = steps + 1
    // A projection chain is only as deep as the source spells it; the cap turns a surprise
    // into a decline rather than a hang.
    if steps > 64 { return 0 }
  }
  0
}

// How usable is the binding whose rows `ow` walks as a container identity? 0 = not bound
// exactly once by a `let` or parameter, or re-pointed by `bx = other`. 1 = a single binding.
// 2 = that, and every use projects, so its handles are the ones `cwIsEscapedHandle` names.
// Per declaration, not program-wide (D1610).
function cwBoundOnceSealed(ow: CwOccWalk): i32 {
  let binds = 0
  let uses = 0
  let proj = 0
  // Each projection has one object and each identifier one parent, so counting the two sides
  // is the same answer as marking them, and it fits the one chain walk.
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_ASG { return 0 }
    if cwIxKind[r] == CW_OCC_BIND {
      // A loop's variable is bound afresh each iteration, so it names no one container.
      const bn = nodeAt(cwIxNode[r])
      if !(bn is LetDecl) && !(bn is Param) { return 0 }
      binds = binds + 1
    }
    if cwIxKind[r] == CW_OCC_USE {
      uses = uses + 1
      if cwIxIsObj[cwIxNode[r]] == 1 { proj = proj + 1 }
    }
  }
  if binds != 1 { return 0 }
  if uses == proj { return 2 }
  1
}

// The head of `nm`'s occurrence chain, or -1 when the index holds none. Never mints an id:
// a name the arena does not carry has no row to find.
export function cwIxChain(nm: string): i32 {
  const sid = sidLookup(nm)
  if sid < 0 || sid >= cwIxHead.length { return -1 }
  cwIxHead[sid]
}

// Is the binding whose rows `ow` walks (`cwOccWalk`, `cwOccWalkUse`) bound exactly once and
// never assigned? The guard that makes a binding usable as a container identity.
export function cwBoundOnce(ow: CwOccWalk): boolean {
  cwBoundOnceSealed(ow) >= 1
}

// Is `ix` a read of an escaped field (`<owner>.<f>` for a recorded pair)? Such a read is a
// handle on the value with no name of its own; the three edges bind it exactly as they bind
// a member name, so `const c = bx.xs` joins `c` and `bx.xs.push(…)` is a write.
export function cwIsEscapedHandle(
  ix: i32,
  owners: i32[],
  flds: string[],
): boolean {
  if flds.length == 0 { return false }
  const p = cwPeel(ix)
  if p < 0 || p >= P.nodes.length { return false }
  const rt = cwProjRootNode(p)
  // The root name itself is not a handle on what it holds, and a chain rooting at anything
  // else — `f().xs`, `{ … }.xs` — names no container this can have filed.
  if rt < 0 || rt == p { return false }
  cwEscapedPairHas(cwKeyOfRoot(rt), cwProjPath(p), owners, flds)
}

function cwEscapedPairHas(
  ok: i32,
  prop: string,
  owners: i32[],
  flds: string[],
): boolean {
  if ok == -1 { return false }
  let i = 0
  while i < owners.length {
    if flds[i] == prop {
      if cwKeySame(owners[i], ok) { return true }
    }
    i = i + 1
  }
  false
}

// The statement a function body's implicit return is: the last statement of its block, or
// -1. The parser leaves a tail expression a bare statement, so the two return forms are this
// one and an explicit `RetStmt`.
export function cwFnTailStmt(fnIx: i32): i32 {
  if fnIx < 0 || fnIx >= P.nodes.length { return -1 }
  const f = nodeAt(fnIx)
  if f is FuncDecl {
    if f.fnBody < 0 || f.fnBody >= P.nodes.length { return -1 }
    const b = nodeAt(f.fnBody)
    if b is Block {
      if b.blkStmts.length == 0 { return -1 }
      return b.blkStmts[b.blkStmts.length - 1]
    }
  }
  -1
}

// The `FuncDecl` indices whose return hands a member of `set` back to the caller — the
// frames whose call result the closure must root at. Costs the set's own occurrences rather
// than the program's nodes, once per closure round (D1090).
export function cwRetFrames(set: i32[], frames: i32[]) {
  const uses: i32[] = []
  cwSetOccs(set, CW_OCC_USE, uses)
  let i = 0
  while i < uses.length {
    const u = uses[i]
    let owner = -1
    if cwIxUpKind[u] == CW_UP_RET { owner = cwFrameOfDecl(cwIxUp[u]) }
    if cwIxUpKind[u] == CW_UP_TAIL { owner = cwIxUp[u] }
    if owner >= 0 {
      if !i32ListHas(frames, owner) { frames.push(owner) }
    }
    i = i + 1
  }
  0
}

// Every call of a function in `frames`. The call result is a handle with no name of its
// own, so the destination it is delivered to joins the set.
export function cwCallResultNodes(frames: i32[], out: i32[]) {
  cwIxBuild()
  let i = 0
  while i < frames.length {
    const f = nodeAt(frames[i])
    if f is FuncDecl {
      if f.fnName != "" {
        // A name a second declaration answers for resolves to that one, so calls of it
        // are not this frame's. `cwParamFrame` is the single resolver both sides read.
        if cwParamFrame(f.fnName) == frames[i] {
          let r = cwIxChain(f.fnName)
          while r >= 0 {
            if cwIxKind[r] == CW_OCC_CALL { out.push(cwIxNode[r]) }
            r = cwIxNext[r]
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// The `self`-function a receiver member `x.f` or `x?.f` calls, or -1 — `cwUfcsDeclOf` with
// the optional-chain spelling, whose receiver binds `self` the same way.
export function cwRecvDeclOf(mIx: i32): i32 {
  const mp = cwPeel(mIx)
  if mp < 0 || mp >= P.nodes.length { return -1 }
  const m = nodeAt(mp)
  if m is OptMember {
    const r = cwRecordedMethodOf(mp)
    if r != -2 { return r }
    if !declFirstParamIsSelf(m.omProp) { return -1 }
    return cwFnDeclOf(m.omProp)
  }
  cwUfcsDeclOf(mIx)
}

// Is `a` a whole-segment prefix of `b`? The escape key joins segments with a dot, so `"inn"`
// is one of `"inn.xs"` and `"in"` is not.
function cwPathPrefixOf(a: string, b: string): boolean {
  if a.length + 1 >= b.length { return false }
  if b.slice(0, a.length) != a { return false }
  b[a.length] == '.'
}

// Walk the projections above `u`: every one whose path is a proper prefix of `path` is an
// INTERMEDIATE container, and must be projected through or compared rather than handed a name
// of its own — `const q = o.inn` is a handle on the same value that spells no filed key.
function cwChainSealed(u: i32, path: string): boolean {
  let at = u
  let steps = 0
  while at >= 0 && at < cwIxUpKind.length && cwIxUpKind[at] == CW_UP_OBJ {
    const p = cwIxUp[at]
    if p < 0 || p >= P.nodes.length { return true }
    const pp = cwProjPath(p)
    // The handle itself, and a chain reading something else, both end the walk.
    if pp == path { return true }
    if !cwPathPrefixOf(pp, path) { return true }
    const k = cwIxUpKind[p]
    if k != CW_UP_OBJ && k != CW_UP_CMP { return false }
    at = p
    steps = steps + 1
    // A projection chain is only as deep as the source spells it; a surprise past the cap
    // declines rather than claims.
    if steps > 64 { return false }
  }
  true
}

// Is the binding keyed `k` usable as a container identity for a value held at `path` — every name that
// reaches it bound once, never re-pointed, used only by projecting, and every intermediate on
// the path projected through? `cwEscapedFields` files the escaped value under all those names,
// so a handle the write scan cannot see is a form this declines on. D1628, D1658, D1682.
function cwContainerSealed(k: i32, path: string): boolean {
  const keys: i32[] = []
  if !cwContainerAliases(k, keys) { return false }
  let i = 0
  while i < keys.length {
    const ow = cwOccWalk(keys[i])
    while cwOccNext(ow) {
      const r = ow.row
      if cwIxKind[r] == CW_OCC_USE {
        if !cwChainSealed(cwIxNode[r], path) { return false }
      }
    }
    i = i + 1
  }
  true
}

// Is the literal `lit`, carrying the value at `fld`, delivered into a container the claim may
// pass through? `cwLitOwners` is the same walk the escape filing takes, so what the claim
// passes a delivery through is exactly what the write scan can see. D1628, D1682.
function cwLitClaimed(lit: i32, fld: string): boolean {
  const keys: i32[] = []
  const paths: string[] = []
  if !cwLitOwners(lit, fld, keys, paths, 0) { return false }
  if keys.length == 0 { return false }
  let i = 0
  while i < keys.length {
    if !cwContainerSealed(keys[i], paths[i]) { return false }
    i = i + 1
  }
  true
}

// Is the store destination `dst` a container the delivery into it may be claimed through?
// The identity guard (`cwEscapeKey`) plus the seal: `cwEscapedFields` files the handle
// under the container's own binding, so a container reachable under a second name has handles
// the write scan would miss. `elem` is `cwEscapeFld`'s own flag for a `push` callee.
function cwStoreSealed(dst: i32, elem: boolean): boolean {
  const ok = cwEscapeKey(dst)
  if ok == -1 { return false }
  cwContainerSealed(ok, cwEscapeFld(dst, elem))
}

// Does every call of `fnIx` deliver its result to a name `cwGrow`'s call-result edge added —
// a binding, an assignment, or the parameter of a further call? A result going into a
// receiver or a container reaches a handle no name does, so the return stays unclaimed;
// anonymous, and a name another declaration answers for, are out (a callee resolves by name).
function cwReturnConsumed(fnIx: i32): boolean {
  if fnIx < 0 || fnIx >= P.nodes.length { return false }
  const f = nodeAt(fnIx)
  if f is FuncDecl {
    const nm = f.fnName
    if nm == "" { return false }
    if cwParamFrame(nm) != fnIx { return false }
    cwIxBuild()
    let r = cwIxChain(nm)
    while r >= 0 {
      if cwIxKind[r] == CW_OCC_CALL {
        const c = cwIxNode[r]
        if cwIxHeld[c] == 0 {
          if cwArgParamKey(c) == -1 { return false }
        }
      }
      r = cwIxNext[r]
    }
    return true
  }
  false
}

// The accounting pass, a whitelist rather than a list of escapes — the only sound shape of
// this test, since a form nobody thought of reads as safe under the other one. The single
// home of "is this delivery claimed", for every delivery: a second predicate answering the
// same question is what would let them disagree. Unclaimed is the `2` answer. D852, D1628.
export function cwClaimed(set: i32[]): boolean {
  const idents: i32[] = []
  cwSetOccs(set, CW_OCC_USE, idents)
  // The frames whose return the closure rooted a call result at AND every call of which
  // delivers into such a destination: those returns are the fourth claimed delivery.
  const retFrames: i32[] = []
  cwRetFrames(set, retFrames)
  const retOk: i32[] = []
  let rf = 0
  while rf < retFrames.length {
    if cwReturnConsumed(retFrames[rf]) { retOk.push(retFrames[rf]) }
    rf = rf + 1
  }
  let i = 0
  while i < idents.length {
    if !cwUseAccounted(idents[i], retOk) { return false }
    i = i + 1
  }
  true
}

// Is the occurrence `u` of a member name in a form this analysis accounts for? The index
// names what consumes it, and a form with no arm here is `CW_UP_NONE` — unaccounted, which
// is the `2` answer rather than a guess.
function cwUseAccounted(u: i32, retOk: i32[]): boolean {
  const k = cwIxUpKind[u]
  const up = cwIxUp[u]
  if k == CW_UP_LETINIT { return true }
  if k == CW_UP_ASG_LHS { return true }
  // A comparison reads its operands and yields a boolean, so no handle leaves it —
  // `m[k] != null` before the narrowed read is the shape that needs saying so.
  if k == CW_UP_CMP { return true }
  if k == CW_UP_OBJ { return true }
  // `for e in b` binds each ELEMENT, so the loop takes no handle on the list itself — the
  // same reason an index read is claimed, one syntax over.
  if k == CW_UP_ITER { return true }
  if k == CW_UP_ASG_RHS {
    const n = nodeAt(up)
    if n is BinExpr {
      if covarRootName(n.binLeft) != "" { return true }
      // a store INTO a container: claimed only where the container is sealed
      return cwStoreSealed(cwPeel(n.binLeft), false)
    }
    return false
  }
  if k == CW_UP_ARG {
    const c = nodeAt(up)
    if c is Call {
      if covarRootName(c.callFn) != "" { return true }
      // A method call delivers into its RECEIVER, not into a parameter list: `xs.push(b)`
      // is a container store and is claimed on the container's terms.
      return cwStoreSealed(cwPeel(c.callFn), true)
    }
    return false
  }
  if k == CW_UP_FIELD { return cwLitClaimed(up, cwFieldNameOf(cwIxUpAux[u])) }
  if k == CW_UP_ELEM { return cwLitClaimed(up, CW_ELEM_FLD) }
  if k == CW_UP_RET { return i32ListHas(retOk, cwFrameOfDecl(up)) }
  if k == CW_UP_TAIL { return i32ListHas(retOk, up) }
  false
}

// Does this program contain any list write at all? The gate that keeps the closure off every
// program with nothing to separate, answered by the index's write half alone.
export function cwProgramHasWrite(): boolean {
  cwIxBuild()
  cwIxAnyWrite == 1
}

// The write pass over a completed alias set. A write whose receiver roots at a member is a
// definite hit (1); one rooting at nothing (`m["k"][0] = v`, `f()[0] = v`) could be any list
// and is a decline (2). An escaped-field receiver (`p.xs.push(…)`, D852) is tested before the decline, since that shape has no name.
export function cwWrites(set: i32[], owners: i32[], flds: string[]): i32 {
  // The EARLIEST write in arena order decides: a decline standing before a definite hit is
  // the answer, so the two lists below merge by node position and not by gather order.
  let at = -1
  let ans = 0
  const uses: i32[] = []
  cwSetOccs(set, CW_OCC_USE, uses)
  let i = 0
  while i < uses.length {
    const w = cwWriteNodeOf(uses[i])
    if w >= 0 {
      if at < 0 || w < at {
        at = w
        ans = 1
      }
    }
    i = i + 1
  }
  let j = 0
  while j < cwIxWrNode.length {
    const w2 = cwIxWrNode[j]
    if at < 0 || w2 < at {
      at = w2
      ans = 2
      if cwIxWrRecv[j] >= 0 {
        if cwIsEscapedHandle(cwIxWrRecv[j], owners, flds) { ans = 1 }
      }
    }
    j = j + 1
  }
  cwLastWriteAt = -1
  if ans == 1 { cwLastWriteAt = at }
  ans
}

// The statement node that writes through the occurrence `u`, or -1. An index assignment
// through it, or a mutating method called on it — the two shapes a list is written by.
function cwWriteNodeOf(u: i32): i32 {
  if u < 0 || u >= cwIxUpKind.length { return -1 }
  if cwIxUpKind[u] != CW_UP_OBJ { return -1 }
  const p = cwIxUp[u]
  if p < 0 || p >= P.nodes.length { return -1 }
  const pn = nodeAt(p)
  match pn {
    Index => {
      if cwIxUpKind[p] == CW_UP_ASG_LHS { return cwIxUp[p] }
    }
    Member => {
      if cwMutatesList(pn.memProp) {
        if cwIxUpKind[p] == CW_UP_CALLEE { return cwIxUp[p] }
      }
    }
    // no other parent writes through the use
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// Does this value have to be stored two ways? A converting copy — and the divergence a
// write would expose — exists only where one list value is demanded at both a union-box
// element row and a plain struct row; where every handle is a union it is built at the box
// and every handle aliases it (D381). Also asks whether any element is read: reading only `a.length` is correct and refusing it is a clause-2 false reject.
export function cwElemRead(set: i32[]): boolean {
  const uses: i32[] = []
  cwSetOccs(set, CW_OCC_USE, uses)
  let i = 0
  while i < uses.length {
    const u = uses[i]
    if cwIxUpKind[u] == CW_UP_ITER { return true }
    if cwIxUpKind[u] == CW_UP_OBJ {
      const p = cwIxUp[u]
      const pn = nodeAt(p)
      match pn {
        Index => {
          // The destination of `xs[i] = v` is not a read; every other index is.
          if cwIxUpKind[p] != CW_UP_ASG_LHS { return true }
        }
        Member => {
          if pn.memProp == "pop" || pn.memProp == "get" {
            if cwIxUpKind[p] == CW_UP_CALLEE { return true }
          }
        }
        // no other parent reads an element
        NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
      }
    }
    i = i + 1
  }
  false
}

// The type annotation a binding node carries, or -1 — the declared handle the two rules
// above read the element storage off.
export function cwBindAnnOf(ix: i32): i32 {
  const n = nodeAt(ix)
  match n {
    LetDecl => {
      return n.letType
    }
    Param => {
      return n.parType
    }
    // no other node carries a binding annotation
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The value statement a block ends with, or -1 when it ends in none (an empty block).
export function rcwBlockTail(bIx: i32): i32 {
  if bIx < 0 || bIx >= P.nodes.length { return -1 }
  const b = nodeAt(bIx)
  if b is Block {
    if b.blkStmts.length == 0 { return -1 }
    return b.blkStmts[b.blkStmts.length - 1]
  }
  bIx
}

// The store or mutating call the use `u` of a name sits under, or -1: the assignment node for
// `x[i] = v` / `x.f = v`, the call node for `x.push(v)`.
export function cwUseStoreNode(u: i32): i32 {
  let at = u
  let steps = 0
  while at >= 0 && at < cwIxUpKind.length && cwIxUpKind[at] == CW_UP_OBJ {
    const p = cwIxUp[at]
    if p < 0 || p >= P.nodes.length || p >= cwIxUpKind.length { return -1 }
    const pk = cwIxUpKind[p]
    if pk == CW_UP_ASG_LHS { return cwIxUp[p] }
    const pn = nodeAt(p)
    if pn is Member {
      if pk == CW_UP_CALLEE {
        if cwMutatesList(pn.memProp) { return cwIxUp[p] }
        return -1
      }
    }
    at = p
    steps = steps + 1
    if steps > 64 { return -1 }
  }
  -1
}

// The parameter nodes of the top-level `FuncDecl` named `name`, or the empty list. Resolved by
// name with no scope walk, so it answers a diagnostic about a free function; a call site asks the
// declaration it names instead (`calleeDeclParams`, `memberDeclOf`), or an unrelated declaration of
// the name decides whether the call checks (D1604).
export function fnDeclParamsOf(name: string) {
  const none: i32[] = []
  const dIx = fnDeclIx[name] ?? -1
  if dIx >= 0 {
    const d = nodeAt(dIx)
    if d is FuncDecl { return d.fnParams }
  }
  none
}

// Whether `name` is a declared function whose first parameter is named `self` — the UFCS
// reachability rule, asked of the declaration. UFCS in VL is exactly the `self`-function
// rule, so a callee that fails this is a program the design forbids; returning -1 falls
// through to the caller's own member-access error, naming the receiver and the property.
export function declFirstParamIsSelf(name: string) {
  const ps = fnDeclParamsOf(name)
  if ps.length == 0 { return false }
  const p0 = nodeAt(ps[0])
  if p0 is Param { return p0.parName == "self" }
  false
}
