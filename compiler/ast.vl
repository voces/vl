// AST + token model for the VL-in-VL parser (the H3 self-hosting track). The data
// layer the parser builds onto; `compiler/parser.vl` imports the token type, the
// parser state `P`, and the arena constructors from here.
//
// ── A discriminated-union AST ────────────────────────────────────────────────
// Each node KIND is its own struct `type` (`NumLit`, `BinExpr`, `Call`, …); the
// `Node` alias unions them, and the parser/printer discriminate with `is`. The
// kind is the runtime VARIANT, not a tag field, so a mis-parse can't silently
// read the wrong slot.
//
// Discrimination is by structural SHAPE (WasmGC erases field names but the variant
// tag is field-name-aware): two variants tell apart iff their field-name sets
// differ. So every variant uses a DISTINCT field-name prefix (`num*`, `bin*`,
// `call*`, …) — no variant's fields are a subset of another's — which keeps `is`
// unambiguous across all kinds. (A discriminant `tag` field would also work for
// genuinely same-shape variants; here the natural shapes already differ.)
//
// ── Children by ARENA INDEX ──────────────────────────────────────────────────
// A node references its children by their `i32` position in a flat `Node[]` arena
// (`-1` == none), and child LISTS by `i32[]`. This is orthogonal to the union: it
// sidesteps needing a *recursive* type alias (`BinExpr` holding `left: Node`),
// which VL's alias resolver can't express yet (a union alias can't forward- or
// self-reference its members), and is how many production self-hosted parsers
// represent their AST anyway. The arena lives in a STRUCT FIELD (`Parser.nodes`),
// and constructors `.push` straight onto it. (The struct is reached via a module
// GLOBAL rather than a parameter — see the `Parser` note below for why.)

// ── Token ────────────────────────────────────────────────────────────────────
// A token consumed by the parser. `kind` is a plain string tag, matching the
// convention the self-hosted lexer uses: VL has no enum / closed-literal-union tag
// representation yet, and a bare `string` compares with `==` and prints directly.
//
// SOURCE POSITIONS: besides `pos` — the token's INDEX in the stream (the cursor
// unit the parser/diags use) — a token carries the SOURCE position of its first
// char, mirroring the lexer's `LexTok`:
//   start — char offset of the first char (0-based, into the source string).
//   line  — 1-based source line of the first char.
//   col   — 0-based column of the first char.
// The parser itself never reads these; diagnostics reach them through the
// `nodeToks` side table (below). The bridge that converts the lexer's `LexTok`
// stream into this `Tok` (the compiler driver and the self-host test harnesses)
// fills them from the lexed token; a hand-built token stream that has no real
// source may pass `0`/`1`/`0`.
export type Tok = {
  kind: string,
  text: string,
  pos: i32,
  start: i32,
  line: i32,
  col: i32,
}

// ── AST node variants ──────────────────────────────────────────────────────
// One struct per kind. `i32` fields holding a child are an arena INDEX (`-1` ==
// none); `i32[]` fields are a child list. Literal payloads keep their source
// `text` (the parser has no reason to evaluate a number, and keeping the lexeme
// also sidesteps int→f64 field coercion). `boolVal` is `0`/`1` (no `boolean`
// field needed). Field names are per-variant prefixed so `is` discriminates.
//
// SOURCE POSITION: every variant carries `pos` — the CHAR OFFSET of the START
// token of the construct that produced the node (the token where parsing of the
// construct BEGAN, captured before its children are parsed), or `-1` for a
// synthesized/desugared node with no source token. The SAME field on every
// variant preserves `is`-discrimination: each variant pair still differs by its
// original distinct field-name prefix, so no variant's field-name set becomes a
// subset of another's. The parser/printer/checker never discriminate on `pos`;
// it is read only by the diagnostics layer (a later rung) to render `line:col`.

// Expressions ----------------------------------------------------------------
export type NumLit = { numText: string, pos: i32 }         // 12, 3.14
export type StrLit = { strText: string, pos: i32 }         // "hi" (raw)
export type CharLit = { charText: string, pos: i32 }       // 'a'  (raw)
export type BoolLit = { boolVal: i32, pos: i32 }           // true=1 / false=0
export type NullLit = { nullKw: string, pos: i32 }         // null
export type Ident = { identName: string, pos: i32 }        // x
export type Unary = { unOp: string, unArg: i32, pos: i32 } // !x  -x
// `binCompound` is the SURFACE compound-assignment operator (`+`/`-`/`*`/`/`) for
// an `a += b` that desugars to `a = a + b`, else "" — a faithful-surface marker
// (the host's `compoundOperator`) the printer reads to reprint the written form
// without re-scanning tokens. Typecheck/emit ignore it (they read the desugared
// `binLeft`/`binRight`).
export type BinExpr = {
  binOp: string,
  binLeft: i32,
  binRight: i32,
  pos: i32,
  binCompound: string,
} // a + b,  a = b,  a += b
// A call `f(a, b)` / `f(a: 2, b: 1)`. `callArgs` are the argument VALUE nodes in
// SOURCE order; `callArgNames` is the parallel per-argument NAME list ("" = a
// positional argument). An all-positional call may carry an EMPTY names list
// (the common case — every consumer treats a missing entry as ""). Mirrors the
// host's `VLArgumentNode.name` (`makeArgument` in parser.ts); binding to
// parameters happens in the checker/emitter via `orderArgsByParamNames`.
export type Call = {
  callFn: i32,
  callArgs: i32[],
  callArgNames: string[],
  pos: i32,
}  // f(a, b) / f(b: 1, a: 2)
export type Member = { memObj: i32, memProp: string, pos: i32 }  // o.field
export type OptMember = { omObj: i32, omProp: string, pos: i32 } // o?.field (null-safe)
export type Paren = { parInner: i32, pos: i32 }                  // ( e )
export type ErrExpr = { errWhat: string, errAt: i32, pos: i32 }  // recovery leaf

// Statements -----------------------------------------------------------------
export type LetDecl = { // let/const x: T = e
  letKw: string, // "let" | "const"
  letName: string,
  letType: i32,  // type-annotation node, -1 if none
  letInit: i32,  // initializer node, -1 if none
  pos: i32,
}
export type Param = { parName: string, parType: i32, pos: i32 } // a: i32
export type TypeRef = { tyName: string, pos: i32 }              // i32 (annotation)
export type FuncDecl = {                                        // function f<T?>(..): T {..}
  fnName: string,
  fnTyParams: string[], // generic type-parameter names (`<T, U>`), empty if none
  fnParams: i32[],
  fnRet: i32,           // return-type node, -1 if none
  fnBody: i32,          // block node
  pos: i32,
}
export type IfStmt = { // if c {..} else {..}
  ifCond: i32,
  ifThen: i32, // then block
  ifElse: i32, // else node (block or nested if), -1 if none
  pos: i32,
}
// Loops carry an optional LABEL (`outer: while …` / `outer: for …`; "" = none),
// the target of a labelled `break`/`continue` — mirroring the host's
// `label: string | undefined` on `VLWhileNode`/`VLForNode`/`VLForInNode`.
export type WhileStmt = {
  whileCond: i32,
  whileBody: i32,
  whileLabel: string,
  pos: i32,
} // [l:] while c { body }
// `break` / `continue` loop-control statements. Each carries the optional loop
// LABEL it targets (`break outer`; "" = the innermost loop) plus a marker field
// (`brkKw` / `contKw`, the source keyword text) that gives the `brk`/`cont`
// prefixes a distinct field-name SET — the header's discrimination rule. Mirrors
// `VLBreakNode` / `VLContinueNode` (whose `label` is undefined when absent).
export type BreakStmt = { brkKw: string, brkLabel: string, pos: i32 } // break [label]
export type ContinueStmt = { contKw: string, contLabel: string, pos: i32 } // continue [label]
// `for v in A to B [step S] { body }` — a numeric RANGE loop; `frStep` is the step
// EXPRESSION node index, or -1 for the implicit +1. `for v in iterable { body }` —
// a for-IN loop over an array, binding `v` to the element type.
export type ForRange = {
  frVar: string,
  frFrom: i32,
  frTo: i32,
  frStep: i32,
  frBody: i32,
  frLabel: string,
  pos: i32,
}
export type ForIn = {
  fiVar: string,
  fiIter: i32,
  fiBody: i32,
  fiLabel: string,
  pos: i32,
} // [l:] for v in arr { body }
// `match scrut { pat => body … }` — exhaustive value dispatch. Each arm `i` matches one of the
// patterns in `matchPats[matchArmStart[i] .. +matchArmCount[i]]` (an OR-group; a wildcard `_` is an
// `Ident "_"` pattern) and runs `matchBodies[i]` (an expr, often a Block). Value-returning.
//
// `matchBinds` is PARALLEL TO `matchPats` (not to the arms): entry `matchBinds[p]` is pattern `p`'s
// payload-binding clause `{x, y}` — a `Block` node holding one `const x = scrut.x` per bound field
// — or -1 when the pattern has none. The `LetDecl`s are minted in the PARSER beside the pattern
// (phase 2b; `nodeTyIx` is sized to the arena at `checkProgram` entry, so a node minted at desugar
// time reads back -1 forever), and the desugar prepends them to the arm's block. They are NOT in
// the body until then, so the formatter prints the arm the user wrote.
export type MatchExpr = {
  matchScrut: i32,
  matchPats: i32[],
  matchBinds: i32[],
  matchArmStart: i32[],
  matchArmCount: i32[],
  matchBodies: i32[],
  pos: i32,
}
export type RetStmt = { retArg: i32, pos: i32 }      // return e?  (-1 bare)
export type Block = { blkStmts: i32[], pos: i32 }    // { stmt* }
export type Program = { progStmts: i32[], pos: i32 } // top-level stmt*

// Modules ---------------------------------------------------------------------
// An `import { a, b as c, … } from "path"` statement. A TOOLING node: module
// RESOLUTION stays the driver's token-level `modScan` (which never reads the
// AST), the checker/emitter skip it, and the formatter keeps reproducing
// imports from the token stream — the node exists so AST consumers (the lint
// tier) can SEE imports (e.g. flag a never-referenced imported name).
//   impPath     — the module specifier, quotes stripped ("" when malformed).
//   impNames    — the imported (source) names, in source order.
//   impLocals   — parallel local bindings (the `as` alias, else the name).
//   impNameToks — parallel TOKEN indices of each name token (diagnostic anchors).
// A bare `import x from "path"` records NO names (a pure graph edge — exactly
// `modScan`'s reading). A re-export `export { … } from "path"` stays a no-op in
// the AST (deferred; the parser still consumes it without a node).
export type ImportDecl = {
  impPath: string,
  impNames: string[],
  impLocals: string[],
  impNameToks: i32[],
  pos: i32,
}

// Structs --------------------------------------------------------------------
// A struct TYPE declaration `type Name = { field: Type, ... }` and the OBJECT
// LITERAL `{ field: value, ... }` that constructs one. Prefixes: `td`/`fd` for
// the type decl + its fields, `obj`/`fi` for the literal + its field inits. A
// struct-type ANNOTATION (`p: Point`) reuses the existing `TypeRef` (a bare name).
export type FieldDef = { fdName: string, fdType: i32, pos: i32 } // x: i32  (in a type decl)
// `tdNew` is 1 for a NOMINAL NEWTYPE body (`type F32View = new { … }`, webcraft
// P1.5) — a declaration-surface marker read by exactly one consumer, the
// checker's declaration pre-pass, which brands the declaration's arena index.
// Nothing downstream of the checker sees it: a newtype is fully erased by emit
// time, so the emitter's vocabulary is the un-branded shape's (see
// `docs/internals/newtype-design.md` §3).
// `tdFlat` is 1 for a FLAT RECORD body (`flat type TValue = { … }`, webcraft P1.2)
// — the second declaration-surface marker beside `tdNew`, and read by the same one
// consumer, the checker's declaration pre-pass. A flat type is an ORDINARY record
// that has additionally been validated (scalars / newtypes over scalars / nested
// flat only) and MEASURED (byte offsets + total size); nothing is subtracted, so
// nothing downstream of the checker sees the marker and a `flat` declaration emits
// byte-identically to the same declaration without it. There is no `udFlat` twin:
// a non-record body is rejected at the parser's syntactic fork, so the marker never
// has to travel on a `UnionDecl`. See `docs/internals/flat-records-design.md`.
export type TypeDecl = {
  tdName: string,
  tdFields: i32[],
  pos: i32,
  tdNew: i32,
  tdFlat: i32,
} // type Name = { f: T, ... }
export type FieldInit = { fiName: string, fiValue: i32, pos: i32 } // x: 7    (in an object literal)
export type ObjLit = { objFields: i32[], pos: i32 }                // { x: 7, y: 9 }

// Arrays ---------------------------------------------------------------------
// An ARRAY LITERAL `[e, e, ...]` that constructs a fixed-length WasmGC array and
// an INDEX access `a[i]` (read, or — when the LHS of a `=` — write). Prefixes:
// `arr` for the literal's element list, `idx` for the index's array+index pair. An
// array TYPE annotation (`a: i32[]`) reuses `TypeRef` with a synthetic `"i32[]"`
// name — see `parseType` — so no new annotation node is needed.
export type ArrayLit = { arrElems: i32[], pos: i32 }         // [1, 2, 3]
export type Index = { idxArr: i32, idxIndex: i32, pos: i32 } // a[i]

// Unions ---------------------------------------------------------------------
// A discriminated-union TYPE ALIAS `type Name = A | B | C` (a `UnionDecl` whose
// `udVariants` are the member type-NAMES, in source order) and the type-guard
// EXPRESSION `x is T` (an `IsExpr` testing whether `isObj` is currently the
// variant named `isVariant`, yielding a boolean and — in an `if` — narrowing
// `isObj` to that variant). Prefixes: `ud` for the union decl, `is` for the guard.
// `udNew` is the `tdNew` twin for the non-`{`-bodied forms: every
// `type N = <not a brace body>` parses as a one-member `UnionDecl`, so a scalar
// newtype (`type EntityId = new i32`) is a one-member union carrying this marker.
export type UnionDecl = {
  udName: string,
  udVariants: string[],
  pos: i32,
  udNew: i32,
} // type N = A | B
// `isNeg` is 1 for a surface `x !is T` (desugared to `!(x is T)`), else 0 — a
// faithful-surface marker the printer reads to reprint `!is`. Typecheck/emit
// ignore it (the wrapping `Unary "!"` carries the negation).
export type IsExpr = { isObj: i32, isVariant: string, pos: i32, isNeg: i32 } // x is T,  x !is T

// EXPRESSION `x as T` — an explicit, CHECKED numeric conversion (B2). `asObj` is
// the arena index of the operand expression; `asTy` is the target type stored as
// a synthetic NAME STRING (mirroring `IsExpr.isVariant`), which the checker
// resolves with `nameToTy`. The `as` field prefix keeps this variant's field-name
// set distinct so `is`-discrimination stays unambiguous.
export type AsExpr = { asObj: i32, asTy: string, pos: i32 } // x as T

// The unified node type. Declared AFTER its members (a union alias can't forward-
// reference). Discriminated with `is`.
export type Node = NumLit |
  StrLit |
  CharLit |
  BoolLit |
  NullLit |
  Ident |
  Unary |
  BinExpr |
  Call |
  Member |
  OptMember |
  Paren |
  ErrExpr |
  LetDecl |
  Param |
  TypeRef |
  FuncDecl |
  IfStmt |
  WhileStmt |
  BreakStmt |
  ContinueStmt |
  RetStmt |
  Block |
  Program |
  FieldDef |
  TypeDecl |
  FieldInit |
  ObjLit |
  ArrayLit |
  Index |
  UnionDecl |
  IsExpr |
  AsExpr |
  ForRange |
  ForIn |
  MatchExpr |
  ImportDecl

// A parse diagnostic: a message plus the token index it was raised at. VL has no
// exceptions, so errors are accumulated, not thrown.
export type Diag = { msg: string, at: i32 }

// ── Parser state (all in STRUCT FIELDS, held in a module GLOBAL) ──────────────
// The whole parser state is one struct: the token stream, the node arena, the
// diagnostics, and the cursor. The arena and diagnostics live in struct fields
// and the constructors `.push` straight onto them.
//
// The struct is reached through a module GLOBAL `P` — a STYLE choice: it keeps
// every call site free of a boilerplate state argument.
export type Parser = {
  toks: Tok[],
  nodes: Node[],
  diags: Diag[],
  pos: i32,
}

// The single parser instance. The harness fills `P.toks`, runs the parser, and
// reads `P.nodes` / `P.diags` back out.
export let P: Parser = { toks: [], nodes: [], diags: [], pos: 0 }

// ── Node → token side table ──────────────────────────────────────────────────
// `nodeToks[i]` is the TOKEN INDEX of the LAST token consumed when `P.nodes[i]`
// was constructed (`addNode` records `P.pos - 1`). Constructors run right after
// their construct's final token is consumed, so this anchors a node at its last
// token — exact for single-token leaves (Ident, NumLit, …), the closing token
// for larger constructs. Good enough to render a `line:col` on a diagnostic;
// a full start/stop span is a later refinement (docs/selfhost-spans-design.md).
// A SIDE ARRAY (not a field on each node variant) keeps every node struct —
// and the `is`-discrimination shape set — untouched.
//
// CONSUMERS MUST BOUNDS-CHECK: a harness that resets `P.nodes` without resetting
// `nodeToks` (or pushes nodes by hand) can leave the table misaligned; readers
// (`tErr` in typecheck.vl, the driver's `diagLine`/`diagCol`) treat an index out
// of range — of this table or of `P.toks` — as "no position". The production
// driver resets `nodeToks` alongside `P.nodes`.
export let nodeToks: i32[] = []

// ── Declaration name → token side table (LSP symbols) ────────────────────────
// `declNameTok[i]` is the TOKEN INDEX of the DECLARING IDENTIFIER for the node
// `P.nodes[i]`, when that node is a declaration (`let`/`const`, `function`,
// param, `type`, union, a for-loop variable). `nodeToks[i]` anchors a node at
// its LAST token (the closing token of `let x = expr` is `expr`'s end, not `x`),
// which is the wrong span for go-to-definition / find-references: an editor jumps
// to / highlights the NAME. So the parser records the name token here at the
// declaration site (`mkDeclNameTok`); a `-1` (the default for non-declarations,
// or a node whose name token was never stamped) tells readers to fall back to
// `nodeToks`. PARALLEL to `P.nodes` — grown lazily, so it stays cheap when the
// symbol table is not being built. BOUNDS-CHECK on read (a misaligned table is
// "no name token", never a trap), the same contract as `nodeToks`.
export let declNameTok: i32[] = []

// Record `tok` as the declaring-identifier token of `nodeIx`. Grows the parallel
// table to cover `nodeIx` (filling the gap with `-1`). The parser calls this
// right after constructing a declaration node, passing the token index it
// captured when it read the name.
export function mkDeclNameTok(nodeIx: i32, tok: i32) {
  while declNameTok.length <= nodeIx { declNameTok.push(-1) }
  declNameTok[nodeIx] = tok
  0
}

// The declaring-identifier token of `nodeIx` (its NAME token), or `-1` when none
// was stamped — readers then fall back to the node's anchor token (`nodeToks`).
export function declNameTokOf(nodeIx: i32) {
  if nodeIx >= 0 && nodeIx < declNameTok.length { return declNameTok[nodeIx] }
  -1
}

// The END char offset (one-past-last) of the source `P.nodes[nodeIx]` spans — the
// STOP offset of the LAST token consumed when the node was built (its `nodeToks`
// anchor). Paired with the node's `pos` (its START offset), this is the
// `[start, stop)` source span the formatter slices verbatim. A token's lexeme IS
// its exact source slice, so its stop offset is `start + text.length` (offsets and
// `string.length` count the same unit). Returns `-1` when `nodeIx`, its `nodeToks`
// entry, or the resolved token is out of range — the same "no span" signal a
// negative `pos` gives for a synthesized node. BOUNDS-CHECKED, like `nodeToks` /
// `declNameTok`: a misaligned table is "no span", never a trap. Reads only
// concrete `Tok` fields (no node-union field access — VL has no common-field read
// across variants), so it stays a plain index→offset lookup.
export function nodeEndOf(nodeIx: i32) {
  if nodeIx < 0 || nodeIx >= nodeToks.length { return -1 }
  const tk = nodeToks[nodeIx]
  if tk < 0 || tk >= P.toks.length { return -1 }
  const t = P.toks[tk]
  t.start + t.text.length
}

// ── Type-SPELLING side arena (the parser KEEPS what it parsed) ───────────────
// `parseTypeName` is a recursive-descent parser that has the annotation's whole
// structure in hand and returns a STRING built by concatenation (`"A|B"`,
// `"i32[]"`, `"{[string]:i32}"`, `"(i32)=>S"`). Every later pass that needs the
// structure back takes that string apart again. This arena is the parser's
// record of what it saw, built as it recurses — a flat SPELLING tree:
//
//   tsKind[i]     — the node kind (`TS_*` below)
//   tsText[i]     — identifier / literal lexeme / field name / map key ("" if unused)
//   tsKidStart[i] — the children are `tsKids[start, start + count)`
//   tsKidCount[i]
//
// It is a SPELLING tree, not a type. `Box<i32>` is recorded as an APPLICATION of
// the identifier `Box`, not as the object it resolves to, because resolution
// needs the program's declared-type environment (`cUserTypes`, the live `<T>`
// bindings) and that does not exist while the parser runs — a type may be
// declared after its use, or in another module. The parser records the
// SPELLING; interning it is the checker's job.
//
// Children are collected on a shared STACK rather than a per-node array: every
// producer pushes its finished node, and `tsMk` moves the stack region above a
// caller-taken mark into the flat `tsKids` column. Depth-first parsing makes
// that region contiguous and exclusively the caller's, so a spelling node costs
// four column pushes and NO per-annotation allocation.
export const TS_NAME = 0    // a bare identifier or primitive name (`i32`, `Cat`, `T`)
export const TS_APP = 1     // `Head<a, b>` — tsText = head, kids = the arguments
export const TS_ARR = 2     // `X[]` — one kid
export const TS_UNION = 3   // `A | B | …` — two or more kids
export const TS_ISECT = 4   // `A & B` — two or more kids
export const TS_NEG = 5     // `!A` — one kid
export const TS_PAREN = 6   // `(A)` / `(A, B)` — the comma list
export const TS_FUNC = 7    // `(params) => ret` — kids = the params, then the RETURN last
export const TS_MAP = 8     // `{[K]: V}` — tsText = the key name, one kid = V
export const TS_OBJ = 9     // `{x: T, y: U}` — kids = `TS_FIELD` nodes
export const TS_FIELD = 10  // one inline-object field — tsText = its name, one kid = its type
export const TS_LITSTR = 11 // a string-literal type — tsText keeps the QUOTED lexeme
export const TS_LITNUM = 12 // a numeric-literal type — tsText is the raw lexeme
export const TS_NULL = 13   // the `null` type
export const TS_ERR = 14    // the `expect("IDENT")` recovery leaf (the parser's `""` name)

export let tsKind: i32[] = []
export let tsText: string[] = []
export let tsKidStart: i32[] = []
export let tsKidCount: i32[] = []
export let tsKids: i32[] = []
// The child stack. Only ever holds the nodes of the spellings currently OPEN on
// the parser's recursion, so it is empty between annotations.
let tsStack: i32[] = []

// The stack mark a producer takes BEFORE parsing its children.
export function tsMark() { tsStack.length }

// Finish a spelling node whose children are the stack region above `mark`: move
// them into `tsKids`, pop them, push the new node. Returns its arena index.
export function tsMk(kind: i32, text: string, mark: i32) {
  const start = tsKids.length
  let i = mark
  while i < tsStack.length {
    tsKids.push(tsStack[i])
    i = i + 1
  }
  const cnt = tsKids.length - start
  while tsStack.length > mark { tsStack.pop() }
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(start)
  tsKidCount.push(cnt)
  const ix = tsKind.length - 1
  tsStack.push(ix)
  ix
}

// Wrap the node on top of the stack (the `[]` array suffix: `X` → `X[]`).
export function tsWrap(kind: i32, text: string) {
  let mark = tsStack.length - 1
  if mark < 0 { mark = 0 }
  tsMk(kind, text, mark)
}

// A CHILDLESS spelling node built OFF the stack. `tsMk`'s contract is "the
// children are the stack region above a mark", which only a producer that is
// mid-recursion can satisfy; a caller that already holds finished roots (the
// `type N = {…} & …` re-encode below, the `is null` leaf) needs the plain
// constructor. Nothing is pushed to `tsStack`, so the recursion's balance is
// untouched.
export function tsLeaf(kind: i32, text: string) {
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(tsKids.length)
  tsKidCount.push(0)
  tsKind.length - 1
}

// The same, with an explicit child list. Used where the parser assembles a
// spelling from roots it already popped — `parseTypeDecl`'s `{ … } & …`
// re-encode, whose first union member is built from the FIELD list it just
// parsed rather than by a `parseTypeName` call.
export function tsMkKids(kind: i32, text: string, kids: i32[]) {
  const start = tsKids.length
  let i = 0
  while i < kids.length {
    tsKids.push(kids[i])
    i = i + 1
  }
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(start)
  tsKidCount.push(kids.length)
  tsKind.length - 1
}

// Take the finished root a type producer left on the stack. Every producer
// pushes exactly one node — the error arm pushes `TS_ERR` — so this is total on
// a producer's return; the `-1` guard is the same "never trap on a misaligned
// side table" contract `nodeToks` / `declNameTok` keep.
export function tsPop() {
  const n = tsStack.length
  if n == 0 { return -1 }
  const ix = tsStack[n - 1]
  tsStack.pop()
  ix
}

// The annotation-node → spelling-root map, as two parallel PUSH columns:
// `annTsNode[r]` is a `TypeRef` node index and `annTsRoot[r]` its spelling root.
//
// SPARSE, not parallel to `P.nodes`, and that is a measured choice: annotations
// are ~2.4% of the node arena, so a `declNameTok`-shaped column (grown lazily to
// the last annotation's index) costs one `i32` per AST NODE — 225,619 entries on
// the compiler's own self-compile against 5,398 annotations, 21x the storage for
// the same information. Two pushed rows per annotation cost what the information
// costs.
//
// `annTsNode` is STRICTLY INCREASING by construction: a row is pushed
// immediately after the `mkTypeRef` it describes, and the node arena only
// appends — so `annTsOf` is a binary search, not a scan. A harness that resets
// `P.nodes` without resetting these leaves earlier programs' rows in front of
// the current one's, which the search finds first: a missing reset is a WRONG
// ANSWER a consumer can see, not a silently-absorbed hole.
export let annTsNode: i32[] = []
export let annTsRoot: i32[] = []

export function setAnnTs(nodeIx: i32, root: i32) {
  annTsNode.push(nodeIx)
  annTsRoot.push(root)
  0
}

// The MULTI-root twin, for a node whose type spellings are a LIST: a
// `UnionDecl`'s members, which live on the node as a `string[]` and so cannot
// key one root each in the single-root table above. One row per MEMBER, pushed
// in member order immediately after the `mkUnionDecl` that owns them, so
// `udTsNode` is NON-DECREASING (equal within a node, increasing across nodes)
// and a member's root is `udTsRoot[first(node) + k]`.
//
// A member root may be -1 — a member whose producer left nothing on the stack
// (`tsPop` on an empty stack, only reachable from a malformed parse). Its
// consumer keeps the string fall-through, so the pass is total either way. The
// `type N = { … } & … | …` re-encode's FIRST member, which no type producer
// returns, is NOT such a case: `parseTypeDecl` assembles its spelling from the
// field list (`tsMkKids`) so that member has a real root like every other.
export let udTsNode: i32[] = []
export let udTsRoot: i32[] = []

export function setUdTs(nodeIx: i32, roots: i32[]) {
  let i = 0
  while i < roots.length {
    udTsNode.push(nodeIx)
    udTsRoot.push(roots[i])
    i = i + 1
  }
  0
}

// The `k`-th member spelling root recorded for `nodeIx`, or -1 when the node has
// none (or fewer than `k + 1`). Binary search for the LEFTMOST row of `nodeIx`
// over the non-decreasing key column, then index by `k`.
export function udTsRootAt(nodeIx: i32, k: i32) {
  let lo = 0
  let hi = udTsNode.length - 1
  let first = -1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = udTsNode[mid]
    if at < nodeIx {
      lo = mid + 1
    } else {
      if at == nodeIx { first = mid }
      hi = mid - 1
    }
  }
  if first < 0 { return -1 }
  const r = first + k
  if r >= udTsNode.length { return -1 }
  if udTsNode[r] != nodeIx { return -1 }
  udTsRoot[r]
}

// The spelling-tree root recorded for `nodeIx`, or `-1` when none was — every
// non-`TypeRef` node, an emitter-SYNTHESIZED `TypeRef` (`synthTypeRef`, built
// from a name the emitter computed that never passed through the parser), and
// the string-only type spellings the parser still drops (`as`).
export function annTsOf(nodeIx: i32) {
  let lo = 0
  let hi = annTsNode.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = annTsNode[mid]
    if at == nodeIx { return annTsRoot[mid] }
    if at < nodeIx { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// Clear the spelling arena and its node columns. The driver calls this alongside
// `P.nodes = []` / `nodeToks = []` — a recorded root indexes THIS program's
// arena and means nothing against the next one's.
export function tsReset() {
  tsKind = []
  tsText = []
  tsKidStart = []
  tsKidCount = []
  tsKids = []
  tsStack = []
  annTsNode = []
  annTsRoot = []
  udTsNode = []
  udTsRoot = []
  0
}

// Render a spelling node back to the synthetic type NAME the parser built from
// it — arm for arm, the exact concatenations of `parseTypeName` /
// `parseTypeIsect` / `parseTypeAtom` (`compiler/parser.vl`), so
// `tsToName(annTsOf(ix))` reproduces `TypeRef.tyName` character for character on
// every annotation the parser recorded.
//
// This is the tree's WRITE-BACK, and it is what lets a pass rewrite the
// STRUCTURE and hand the string side its result instead of scanning characters
// (D-PARSETY P1: the module merge). -1 renders "" — the same empty name the
// parser's recovery arm returns.
export function tsToName(ix: i32): string {
  if ix < 0 { return "" }
  const k = tsKind[ix]
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  if k == TS_NAME { return tsText[ix] }
  if k == TS_LITSTR { return tsText[ix] }
  if k == TS_LITNUM { return tsText[ix] }
  if k == TS_NULL { return "null" }
  if k == TS_ERR { return "" }
  if k == TS_ARR { return tsToName(tsKids[start]) + "[]" }
  if k == TS_NEG { return "!" + tsToName(tsKids[start]) }
  if k == TS_MAP {
    return "{[" + tsText[ix] + "]:" + tsToName(tsKids[start]) + "}"
  }
  if k == TS_FIELD { return tsText[ix] + ":" + tsToName(tsKids[start]) }
  if k == TS_APP || k == TS_PAREN || k == TS_OBJ || k == TS_FUNC {
    // The comma-joined child list. `TS_FUNC` holds its RETURN as the LAST kid
    // (`parseTypeAtom`'s contract), so the join stops one short of it.
    let last = cnt
    if k == TS_FUNC { last = cnt - 1 }
    let inner = ""
    let i = 0
    while i < last {
      if i > 0 { inner = inner + "," }
      inner = inner + tsToName(tsKids[start + i])
      i = i + 1
    }
    if k == TS_APP { return tsText[ix] + "<" + inner + ">" }
    if k == TS_PAREN { return "(" + inner + ")" }
    if k == TS_OBJ { return "{" + inner + "}" }
    return "(" + inner + ")=>" + tsToName(tsKids[start + cnt - 1])
  }
  // `TS_UNION` / `TS_ISECT` — the members joined by their own separator.
  let sep = "|"
  if k == TS_ISECT { sep = "&" }
  let out = ""
  let i = 0
  while i < cnt {
    if i > 0 { out = out + sep }
    out = out + tsToName(tsKids[start + i])
    i = i + 1
  }
  out
}

// ── Arena constructors ───────────────────────────────────────────────────────
// Each appends its variant to `P.nodes` and returns the new node's index. Every
// constructor takes `pos` — the CHAR OFFSET of the construct's START token (the
// parser captures it at the construct's parse entry, BEFORE the children parse),
// or `-1` for a synthesized/desugared node with no source token — and stores it
// on the built variant.

export function addNode(n: Node) {
  P.nodes.push(n)
  let tk = P.pos - 1
  if tk < 0 { tk = 0 }
  nodeToks.push(tk)
  P.nodes.length - 1
}

export function mkNum(text: string, pos: i32) {
  const n: Node = { numText: text, pos: pos }
  addNode(n)
}

export function mkStr(text: string, pos: i32) {
  const n: Node = { strText: text, pos: pos }
  addNode(n)
}

export function mkChar(text: string, pos: i32) {
  const n: Node = { charText: text, pos: pos }
  addNode(n)
}

export function mkBool(v: i32, pos: i32) {
  const n: Node = { boolVal: v, pos: pos }
  addNode(n)
}

export function mkNull(kw: string, pos: i32) {
  const n: Node = { nullKw: kw, pos: pos }
  addNode(n)
}

export function mkIdent(name: string, pos: i32) {
  const n: Node = { identName: name, pos: pos }
  addNode(n)
}

export function mkUnary(op: string, arg: i32, pos: i32) {
  const n: Node = { unOp: op, unArg: arg, pos: pos }
  addNode(n)
}

export function mkBinary(op: string, left: i32, right: i32, pos: i32) {
  const n: Node = {
    binOp: op,
    binLeft: left,
    binRight: right,
    pos: pos,
    binCompound: "",
  }
  addNode(n)
}

// A compound assignment `target op= value`, desugared to `target = (target op
// value)` for typecheck/emit but tagged with the SURFACE operator (`binCompound`)
// so the printer reprints `target op= value`. The target node is SHARED between
// the read (inner arith) and the write (outer `=`) — arena reads are pure.
export function mkCompoundAssign(
  op: string,
  target: i32,
  value: i32,
  pos: i32,
) {
  const inner = mkBinary(op, target, value, pos)
  const n: Node = {
    binOp: "=",
    binLeft: target,
    binRight: inner,
    pos: pos,
    binCompound: op,
  }
  addNode(n)
}

// A prefix increment `++target` / `--target` (`incr` is `"++"`/`"--"`), desugared
// to `target = (target ± 1)` — yielding the NEW value, the prefix semantics — and
// tagged on `binCompound` with the surface `++`/`--` so the printer reprints the
// prefix form (postfix `x++` rides a `Unary "p+"` instead; see the parser).
export function mkPreIncr(incr: string, target: i32, pos: i32) {
  let op = "+"
  if incr == "--" { op = "-" }
  const inner = mkBinary(op, target, mkNum("1", -1), pos)
  const n: Node = {
    binOp: "=",
    binLeft: target,
    binRight: inner,
    pos: pos,
    binCompound: incr,
  }
  addNode(n)
}

export function mkCall(fn: i32, args: i32[], pos: i32) {
  // All-positional (the synthesizers' constructor): an empty names list.
  const names: string[] = []
  mkCallN(fn, args, names, pos)
}

// A call with per-argument NAMES (parallel to `args`; "" = positional) — the
// parser's constructor for argument lists that may carry `name: value` entries.
export function mkCallN(fn: i32, args: i32[], names: string[], pos: i32) {
  const n: Node = { callFn: fn, callArgs: args, callArgNames: names, pos: pos }
  addNode(n)
}

// True iff any per-argument name is present (a non-"" entry) — the cheap gate
// every consumer checks before paying for `orderArgsByParamNames`.
export function hasNamedArgs(names: string[]) {
  let i = 0
  while i < names.length {
    if names[i] != "" { return true }
    i = i + 1
  }
  false
}

// ── UFCS cross-module alias (the module merge's bridge to UFCS resolution) ────
// A UFCS member-call `recv.prop(args)` whose `prop` names a free `self`-function
// keeps `prop` plain on its `Member` — so a struct callable-field of the same
// name keeps precedence, decided by the receiver TYPE in the checker/emitter. The
// module merge MANGLES such functions (`shout` → `shout$m1`); `ufcsAliasOf` maps
// the plain `prop` back to the mangled name in the checker's and emitter's UFCS
// resolution, which runs only AFTER the field check. EMPTY in single-file mode
// (no merge populates it), so every non-module consumer is byte-identical and the
// emit-fixpoint goldens are unaffected. Defined here (the foundation file shared
// by every concatenation) because both `typecheck.vl` and `wasmEmit.vl` consult
// it while the driver — which populates it — is concatenated last.
export let ufcsAliasFrom: string[] = []
export let ufcsAliasTo: string[] = []
export function ufcsAliasReset() {
  ufcsAliasFrom = []
  ufcsAliasTo = []
  0
}
export function ufcsAliasAdd(plain: string, mangled: string) {
  let i = 0
  while i < ufcsAliasFrom.length {
    if ufcsAliasFrom[i] == plain && ufcsAliasTo[i] == mangled { return 0 }
    i = i + 1
  }
  ufcsAliasFrom.push(plain)
  ufcsAliasTo.push(mangled)
  0
}
// The mangled self-function a UFCS `prop` resolves to, or `name` unchanged when
// no merge alias applies (single-file mode, or a `prop` naming no self-function).
export function ufcsAliasOf(name: string) {
  let i = 0
  while i < ufcsAliasFrom.length {
    if ufcsAliasFrom[i] == name { return ufcsAliasTo[i] }
    i = i + 1
  }
  name
}

// ── free INDEX-OPERATOR declaration names (B14) ──────────────────────────────
// `function "[]"(self: T, i: I)` and `function "[]="(self: T, i: I, v: V)` are
// free functions whose NAME is an operator, so a program may declare several —
// one per receiver type. Every name-keyed table in the checker and the emitter
// (`fnDeclIx`, `lookup`, `fnIndexOf`) holds ONE entry per name, so the several
// declarations must not share one: the parser mints a DECLARATION NAME that
// carries the receiver's annotation spelling, `"[]" for F32View` → `[]@F32View`.
//
// The `@` is what makes the encoding total: it cannot occur in an identifier,
// so no ordinary function's name is ever read as an operator's, and a genuine
// duplicate (the same operator for the same receiver spelling) collides on the
// minted name and is caught by the ordinary redeclaration rule.
//
// The module merge renames a declaration by appending `$mN`, which leaves the
// prefix — and therefore the operator — intact (`[]@F32View$m1`). That is the
// whole of the merge story for these: the checker's registry is built from the
// MERGED program, so it holds mangled names and needs no plain→mangled alias.
export const OP_INDEX_GET = "[]"
export const OP_INDEX_SET = "[]="

// The declaration name for operator `op` on a receiver spelled `recv`.
export function opDeclName(op: string, recv: string): string { op + "@" + recv }

// The offset of the `@` separator in `name`, or -1 when it carries none.
function opDeclAt(name: string): i32 {
  let i = 0
  while i < name.length {
    if name[i] == '@' { return i }
    i = i + 1
  }
  -1
}

// The INDEX OPERATOR a declaration name implements, or "" when `name` is an
// ordinary function's. Total over merge-mangled names (the `$mN` rides in the
// receiver half) and over every identifier (no identifier contains `@`).
export function opDeclOpOf(name: string): string {
  const at = opDeclAt(name)
  if at < 0 { return "" }
  const op = name.slice(0, at)
  if op == OP_INDEX_GET { return op }
  if op == OP_INDEX_SET { return op }
  ""
}

// The receiver-spelling half of an operator declaration name (with any `$mN`
// the merge appended), or "" for an ordinary name.
export function opDeclRecvOf(name: string): string {
  if opDeclOpOf(name) == "" { return "" }
  const recv = name.slice(opDeclAt(name) + 1, name.length)
  recv
}

// How an operator declaration reads back to a USER: `"[]" for F32View`. Every
// diagnostic that would otherwise print the minted name routes through this, so
// the `@` encoding never reaches a message. An ordinary name is returned as-is.
export function opDeclLabel(name: string): string {
  const op = opDeclOpOf(name)
  if op == "" { return name }
  "\"" + op + "\" for " + opDeclRecvOf(name)
}

// Bind call ARGUMENTS to parameter slots by NAME, then positionally — the exact
// matching the host's `orderArgumentsByParameters` (typecheck.ts) performs, and
// the single source of truth shared by the checker and the emitter. Returns one
// VALUE-node index per parameter (in PARAMETER order; -1 where no argument
// filled the slot), followed by any leftover/unmatched arguments (a named arg
// with no matching parameter, a named collision, or surplus positionals) in
// source order — so the result never silently drops an argument. Pure: callers
// (`checkNode`'s Call arm, `emitCall`) diagnose arity/name errors themselves.
export function orderArgsByParamNames(
  paramNames: string[],
  args: i32[],
  argNames: string[],
) {
  const slots: i32[] = []
  let i = 0
  while i < paramNames.length {
    slots.push(-1)
    i = i + 1
  }
  const leftover: i32[] = []
  const positional: i32[] = []
  // First place named arguments by parameter name.
  let j = 0
  while j < args.length {
    let nm = ""
    if j < argNames.length { nm = argNames[j] }
    if nm == "" {
      positional.push(args[j])
    } else {
      let pIx = -1
      let k = 0
      while k < paramNames.length {
        if pIx < 0 && paramNames[k] == nm { pIx = k }
        k = k + 1
      }
      if pIx < 0 || slots[pIx] >= 0 {
        // Unknown name, or a slot already filled (named collision): leave it
        // for the caller to diagnose rather than overwriting.
        leftover.push(args[j])
      } else {
        slots[pIx] = args[j]
      }
    }
    j = j + 1
  }
  // Then fill the remaining slots, in order, with positional arguments.
  let nx = 0
  let p = 0
  while p < positional.length {
    while nx < slots.length && slots[nx] >= 0 { nx = nx + 1 }
    if nx < slots.length {
      slots[nx] = positional[p]
      nx = nx + 1
    } else {
      leftover.push(positional[p])
    }
    p = p + 1
  }
  let r = 0
  while r < leftover.length {
    slots.push(leftover[r])
    r = r + 1
  }
  slots
}

export function mkMember(obj: i32, prop: string, pos: i32) {
  const n: Node = { memObj: obj, memProp: prop, pos: pos }
  addNode(n)
}

export function mkIndex(arr: i32, idx: i32, pos: i32) {
  const n: Node = { idxArr: arr, idxIndex: idx, pos: pos }
  addNode(n)
}

export function mkArrayLit(elems: i32[], pos: i32) {
  const n: Node = { arrElems: elems, pos: pos }
  addNode(n)
}

export function mkOptMember(obj: i32, prop: string, pos: i32) {
  const n: Node = { omObj: obj, omProp: prop, pos: pos }
  addNode(n)
}

export function mkParen(inner: i32, pos: i32) {
  const n: Node = { parInner: inner, pos: pos }
  addNode(n)
}

export function mkErr(what: string, at: i32, pos: i32) {
  const n: Node = { errWhat: what, errAt: at, pos: pos }
  addNode(n)
}

export function mkLet(kw: string, name: string, ty: i32, init: i32, pos: i32) {
  const n: Node = {
    letKw: kw,
    letName: name,
    letType: ty,
    letInit: init,
    pos: pos,
  }
  addNode(n)
}

export function mkParam(name: string, ty: i32, pos: i32) {
  const n: Node = { parName: name, parType: ty, pos: pos }
  addNode(n)
}

export function mkTypeRef(name: string, pos: i32) {
  const n: Node = { tyName: name, pos: pos }
  addNode(n)
}

export function mkFunc(
  name: string,
  typarams: string[],
  params: i32[],
  ret: i32,
  body: i32,
  pos: i32,
) {
  const n: Node = {
    fnName: name,
    fnTyParams: typarams,
    fnParams: params,
    fnRet: ret,
    fnBody: body,
    pos: pos,
  }
  addNode(n)
}

export function mkIf(cond: i32, thenB: i32, els: i32, pos: i32) {
  const n: Node = { ifCond: cond, ifThen: thenB, ifElse: els, pos: pos }
  addNode(n)
}

// Loop constructors take the optional loop LABEL last ("" = unlabelled).
export function mkWhile(cond: i32, body: i32, label: string, pos: i32) {
  const n: Node = {
    whileCond: cond,
    whileBody: body,
    whileLabel: label,
    pos: pos,
  }
  addNode(n)
}

export function mkForRange(
  v: string,
  from: i32,
  to: i32,
  step: i32,
  body: i32,
  label: string,
  pos: i32,
) {
  const n: Node = {
    frVar: v,
    frFrom: from,
    frTo: to,
    frStep: step,
    frBody: body,
    frLabel: label,
    pos: pos,
  }
  addNode(n)
}

export function mkForIn(
  v: string,
  iter: i32,
  body: i32,
  label: string,
  pos: i32,
) {
  const n: Node = {
    fiVar: v,
    fiIter: iter,
    fiBody: body,
    fiLabel: label,
    pos: pos,
  }
  addNode(n)
}

export function mkMatch(
  scrut: i32,
  pats: i32[],
  binds: i32[],
  armStart: i32[],
  armCount: i32[],
  bodies: i32[],
  pos: i32,
) {
  const n: Node = {
    matchScrut: scrut,
    matchPats: pats,
    matchBinds: binds,
    matchArmStart: armStart,
    matchArmCount: armCount,
    matchBodies: bodies,
    pos: pos,
  }
  addNode(n)
}

export function mkBreak(kw: string, label: string, pos: i32) {
