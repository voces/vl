  addNode(n)
}

export function mkIsExpr(obj: i32, variant: string, pos: i32) {
  const n: Node = { isObj: obj, isVariant: variant, pos: pos, isNeg: 0 }
  addNode(n)
}

// A NEGATED type guard `x !is T`, desugared to `!(x is T)` (a `Unary "!"` over
// this node) for typecheck/emit's narrowing, but flagged `isNeg` so the printer
// reprints the surface `!is` instead of `!(… is …)`.
export function mkIsExprNeg(obj: i32, variant: string, pos: i32) {
  const n: Node = { isObj: obj, isVariant: variant, pos: pos, isNeg: 1 }
  addNode(n)
}

// `x as T` — an explicit numeric cast (B2). `ty` is the target type NAME string.
export function mkAsExpr(obj: i32, ty: string, pos: i32) {
  const n: Node = { asObj: obj, asTy: ty, pos: pos }
  addNode(n)
}

// ── int → string ─────────────────────────────────────────────────────────────
// A hand-rolled decimal converter. `i32ToStr` is the shared count/index renderer
// across the self-host: the checker, emitter, and driver import it for
// diagnostics and synthetic names.
function digitChar(d: i32) {
  if d == 0 { return "0" }
  if d == 1 { return "1" }
  if d == 2 { return "2" }
  if d == 3 { return "3" }
  if d == 4 { return "4" }
  if d == 5 { return "5" }
  if d == 6 { return "6" }
  if d == 7 { return "7" }
  if d == 8 { return "8" }
  "9"
}

export function i32ToStr(n: i32) {
  if n == 0 { return "0" }
  // Peel digits in the NEGATIVE range: every i32 (including INT_MIN, whose
  // magnitude overflows i32) is representable as -|n|, so negate positives
  // instead of negatives. Wasm `rem_s` of a negative operand yields -digit.
  const neg = n < 0
  let m = n
  if !neg { m = 0 - m }
  let out = ""
  while m < 0 {
    out = digitChar(0 - (m % 10)) + out
    m = m / 10
  }
  if neg { out = "-" + out }
  out
}
