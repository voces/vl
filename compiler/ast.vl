// AST and token model for the VL-in-VL parser — the data layer the parser builds onto.
// `compiler/parser.vl` imports the token type, the parser state `P` and the arena
// constructors from here.
//
// Each node kind is its own struct `type`; the `Node` alias unions them and every pass
// discriminates with `is`, so the kind is the runtime variant rather than a tag field.
// Discrimination is by structural shape — WasmGC erases field names but the variant tag
// is field-name-aware — so every variant uses a distinct field-name prefix (`num*`,
// `bin*`, `call*`, …) and no variant's fields may become a subset of another's.
//
// Children are referenced by `i32` position in the flat `Node[]` arena (`-1` for none)
// and child lists by `i32[]`, which sidesteps a recursive type alias VL cannot express.

import { strListHas } from "./listutil"

// The parser's token is the lexer's `Tok`. Its stream position is its index, not a field, so
// one lexed token object can sit in every stream that replays its module; a test stream may
// pass zero positions, because diagnostics reach them only through `nodeToks`.
export { Tok } from "./lexer"

// One struct per node kind. An `i32` field holding a child is an arena index (`-1` for
// none) and an `i32[]` field a child list; a literal payload keeps its source `text`.
// `pos` is on every variant — the char offset of the construct's start token, or -1 for a
// synthesized node — and only the diagnostics layer reads it; no pass discriminates on it.

// Expressions ----------------------------------------------------------------
export type NumLit = { numText: string, pos: i32 }         // 12, 3.14
export type StrLit = { strText: string, pos: i32 }         // "hi" (raw)
export type CharLit = { charText: string, pos: i32 }       // 'a'  (raw)
export type BoolLit = { boolVal: i32, pos: i32 }           // true=1 / false=0
export type NullLit = { nullKw: string, pos: i32 }         // null
export type Ident = { identName: string, pos: i32 }        // x
export type Unary = { unOp: string, unArg: i32, pos: i32 } // !x  -x
// `binCompound` is the surface compound-assignment operator (`+`, `%`, `>>>`, ...) for an
// `a op= b` that desugars to `a = a op b`, else "". `binTpl` is 1 on the root `+` of the
// concatenation a backtick template desugared to, its span covering the whole template.
// Both are faithful-surface markers the printer reads; typecheck and emit ignore them.
export type BinExpr = {
  binOp: string,
  binLeft: i32,
  binRight: i32,
  pos: i32,
  binCompound: string,
  binTpl: i32,
  binRegion: i32, // 1 on a long arithmetic chain's root, where the classifier memo starts (D2445)
} // a + b,  a = b,  a += b
// A call `f(a, b)` or `f(a: 2, b: 1)`. `callArgs` are the argument value nodes in source
// order and `callArgNames` the parallel per-argument name list ("" for a positional one);
// an all-positional call may carry an empty names list, and every consumer treats a
// missing entry as "". Binding to parameters is `orderArgsByParamNames`'s.
export type Call = {
  callFn: i32,
  callArgs: i32[],
  callArgNames: string[],
  pos: i32,
}  // f(a, b) / f(b: 1, a: 2)
export type Member = { memObj: i32, memProp: string, pos: i32 } // o.field
// `o?.field`. `omDot` is true on a link the source spelled with a plain `.` after an earlier
// `?.` in the same chain: one `?.` guards everything to its right, so `o?.y.z` is two links
// and the second may not re-guard a nullable field of its own.
export type OptMember = {
  omObj: i32,
  omProp: string,
  omDot: boolean,
  pos: i32,
}
export type Paren = { parInner: i32, pos: i32 }                 // ( e )
export type ErrExpr = { errWhat: string, errAt: i32, pos: i32 } // recovery leaf

// Statements -----------------------------------------------------------------
export type LetDecl = { // let/const x: T = e
  letKw: string, // "let" | "const"
  letName: string,
  letType: i32,  // type-annotation node, -1 if none
  letInit: i32,  // initializer node, -1 if none
  pos: i32,
}
// A parameter `a: i32`, with `parDefault` the default expression's arena index (-1 for none).
// `parOpt` is 1 for `a?: i32`, sugar for `a: i32 | null = null`; `parRest` is 1 for the rest
// parameter `...xs: T[]`, whose `parType` is the list the trailing arguments pack into. Both
// are surface markers the printer reads; downstream reads `parType` and `parDefault`.
export type Param = {
  parName: string,
  parType: i32,
  parDefault: i32,
  parOpt: i32,
  parRest: i32,
  pos: i32,
} // a: i32,  a: i32 = 0,  a?: i32,  ...xs: i32[]
export type TypeRef = { tyName: string, pos: i32 } // i32 (annotation)
export type FuncDecl = {                           // function f<T?>(..): T {..}
  fnName: string,
  fnTyParams: string[], // generic type-parameter names (`<T, U>`), empty if none
  fnParams: i32[],
  fnRet: i32,           // return-type node, -1 if none
  fnBody: i32,          // block node
  pos: i32,
}
export type IfStmt = { // if c {..} else {..}
  ifCond: i32,
  ifThen: i32, // then block
  ifElse: i32, // else node (block or nested if), -1 if none
  pos: i32,
}
// Loops carry an optional label ("" = none), the target of `break @l` / `continue @l`.
// `whileBlk` 1 is a labelled block `@B { … }`: a `while true` run once, which `break` leaves and
// `continue` never targets. `whileLv` is the declaration of the binding a non-null loop value
// leaves through (-1 for none), set by the emitter's value rewrite.
export type WhileStmt = {
  whileCond: i32,
  whileBody: i32,
  whileLabel: string,
  pos: i32,
  whileBlk: i32,
  whileLv: i32,
} // [l:] while c { body }, or l: { body }
// `break` / `continue` loop-control statements. Each carries the optional label it targets
// ("" for the innermost loop) plus a marker field (`brkKw` / `contKw`, the
// source keyword text) that gives the two prefixes distinct field-name sets. `brkHasVal` is 1
// for `break v`: the value is the statement just before the break in the same block.
export type BreakStmt = {
  brkKw: string,
  brkLabel: string,
  pos: i32,
  brkHasVal: i32,
} // break [:label] [value]
export type ContinueStmt = { contKw: string, contLabel: string, pos: i32 } // continue [label]
// `for v in A to B [step S] { body }` — a numeric range loop; `frStep` is the step
// expression node index, or -1 for the implicit +1. `frExcl` marks the half-open `until`
// form (exit when `v < B`); false is the inclusive `to` form (exit when `v <= B`).
// `for v in iterable { body }` — a for-IN loop over an array, binding `v` to the element type.
export type ForRange = {
  frVar: string,
  frFrom: i32,
  frTo: i32,
  frStep: i32,
  frExcl: boolean,
  frBody: i32,
  frLabel: string,
  pos: i32,
}
export type ForIn = {
  fiVar: string,
  fiVar2: string,
  fiDecl1: i32,
  fiDecl2: i32,
  fiIter: i32,
  fiBody: i32,
  fiLabel: string,
  pos: i32,
} // [l:] for v[, i] in arr { body }
// A `for` loop variable's declaration: slot 0 or 1 of loop `lvLoop`, whose `fiVar` or `fiVar2`
// spells it. Clones of the loop share it; the loop node itself declares nothing.
export type LoopVar = { lvLoop: i32, lvSlot: i32, pos: i32 }
// `match scrut { pat => body … }` — exhaustive value dispatch. Arm `i` matches one of
// `matchPats[matchArmStart[i] .. +matchArmCount[i]]` and runs `matchBodies[i]`.
// `matchBinds` is parallel to `matchPats`, not the arms: entry `p` is that pattern's
// payload-binding `Block` or -1, entering the body only at desugar (the formatter's need).
export type MatchExpr = {
  matchScrut: i32,
  matchPats: i32[],
  matchBinds: i32[],
  matchArmStart: i32[],
  matchArmCount: i32[],
  matchBodies: i32[],
  pos: i32,
}
export type RetStmt = { retArg: i32, pos: i32 }      // return e?  (-1 bare)
export type Block = { blkStmts: i32[], pos: i32 }    // { stmt* }
export type Program = { progStmts: i32[], pos: i32 } // top-level stmt*

// An `import { a, b as c, … } from "path"` statement, a tooling node: module resolution
// stays the driver's token-level `modScan`, the checker and emitter skip it, and the
// formatter reproduces imports from the token stream. `impNames` are the imported source
// names, `impLocals` the parallel local bindings, `impNameToks` the parallel name tokens.
export type ImportDecl = {
  impPath: string,
  impNames: string[],
  impLocals: string[],
  impNameToks: i32[],
  pos: i32,
}

// A struct type declaration `type Name = { field: Type, … }` and the object literal that
// constructs one. Prefixes: `td`/`fd` for the type declaration and its fields, `obj`/`fi`
// for the literal and its field inits. A struct-type annotation (`p: Point`) reuses
// `TypeRef`, a bare name.
export type FieldDef = { fdName: string, fdType: i32, pos: i32 } // x: i32  (in a type decl)
// `tdNew` marks a nominal newtype body (`type F32View = new { … }`) and `tdFlat` a flat
// record body — declaration-surface markers read only by the checker's declaration
// pre-pass and erased before emit, so `flat` emits exactly as the same declaration
// without it. No `udFlat` twin: the parser's syntactic fork rejects a non-record body.
export type TypeDecl = {
  tdName: string,
  tdFields: i32[],
  pos: i32,
  tdNew: i32,
  tdFlat: i32,
} // type Name = { f: T, ... }
export type FieldInit = { fiName: string, fiValue: i32, pos: i32 } // x: 7    (in an object literal)
export type ObjLit = { objFields: i32[], pos: i32 }                // { x: 7, y: 9 }

// An array literal `[e, e, …]` constructing a fixed-length WasmGC array, and an index
// access `a[i]` (a read, or a write when it is the left side of a `=`). Prefixes: `arr`
// for the literal's element list, `idx` for the index's array and index pair. An array
// type annotation reuses `TypeRef` with a synthetic `"i32[]"` name — see `parseType`.
export type ArrayLit = { arrElems: i32[], pos: i32 } // [1, 2, 3]
// `...e` before a call argument or a list element — the operand's list is unpacked in
// place. A node kind and not a parallel column on `Call`/`ArrayLit`, so a pass that has
// not learned about it fails loudly instead of dropping the marker. The parser mints one
// only in those two positions; `...` anywhere else is a parse error.
export type Spread = { spdArg: i32, pos: i32 }               // ...ys
export type Index = { idxArr: i32, idxIndex: i32, pos: i32 } // a[i]

// A discriminated-union type alias `type Name = A | B | C` (`udVariants` are the member
// type names in source order) and the type-guard expression `x is T`. Prefixes: `ud` for
// the declaration, `is` for the guard. `udNew` is `tdNew`'s twin for the non-brace forms:
// every `type N = <not a brace body>` parses as a one-member `UnionDecl`.
export type UnionDecl = {
  udName: string,
  udVariants: string[],
  pos: i32,
  udNew: i32,
} // type N = A | B
// `isNeg` is 1 for a surface `x !is T` (desugared to `!(x is T)`), else 0 — a
// faithful-surface marker the printer reads to reprint `!is`. Typecheck/emit
// ignore it (the wrapping `Unary "!"` carries the negation).
export type IsExpr = { isObj: i32, isVariant: string, pos: i32, isNeg: i32 } // x is T,  x !is T

// `x as T`, a checked numeric conversion: `asObj` the operand's arena index, `asTy` the
// target as a name the checker resolves with `nameToTy`, `asMode` the family member
// (`error-handling-design.md` §Trio). The exact three differ only in the sad path and
// `wrap` (`x as% T`) has none, so one node carries all four.
export type AsMode = "prop" | "null" | "trap" | "wrap"
export type AsExpr = { asObj: i32, asTy: string, asMode: AsMode, pos: i32 } // x as T

// The unified node type. Declared after its members, since a union alias cannot
// forward-reference. Discriminated with `is`.
export type Node = NumLit |
  StrLit |
  CharLit |
  BoolLit |
  NullLit |
  Ident |
  Unary |
  BinExpr |
  Call |
  Member |
  OptMember |
  Paren |
  ErrExpr |
  LetDecl |
  Param |
  TypeRef |
  FuncDecl |
  IfStmt |
  WhileStmt |
  BreakStmt |
  ContinueStmt |
  RetStmt |
  Block |
  Program |
  FieldDef |
  TypeDecl |
  FieldInit |
  ObjLit |
  ArrayLit |
  Index |
  UnionDecl |
  IsExpr |
  AsExpr |
  ForRange |
  ForIn |
  MatchExpr |
  ImportDecl |
  Spread |
  LoopVar

// A parse diagnostic: a message plus the token index it is raised at. VL has no
// exceptions, so errors accumulate rather than throw.
export type Diag = { msg: string, at: i32 }

// The whole parser state as one struct: the token stream, the node arena, the diagnostics
// and the cursor, with the constructors pushing straight onto the arena and diagnostics
// fields. It is reached through the module global `P`, which keeps every call site free of
// a state argument.
export type Parser = {
  toks: Tok[],
  nodes: Node[],
  diags: Diag[],
  pos: i32,
}

// The single parser instance. The harness fills `P.toks`, runs the parser, and
// reads `P.nodes` / `P.diags` back out.
export let P: Parser = { toks: [], nodes: [], diags: [], pos: 0 }

// The arena node at `ix`; one body holds the bounds check that an inline `P.nodes[ix]`
// repeats at every read site.
export function nodeAt(ix: i32): Node { P.nodes[ix] }

// Whether `n` joins the values of several arms: an `if`, a `match`, a block, a `??`, or a loop or
// labelled block (its `break` values and its tail). The checker reads it before a `match` is
// desugared to an `if`.
export function exprJoinsArms(n: Node): boolean {
  if n is BinExpr { return n.binOp == "??" }
  n is IfStmt
    || n is MatchExpr
    || n is Block
    || n is WhileStmt
    || n is ForRange
    || n is ForIn
}

// The value of labelled block `x` when its body is only `break @L v` to its own label, which is
// then `v` evaluated once; -1 for any other node or body.
export function labelBlockValue(x: i32): i32 {
  if x < 0 || x >= P.nodes.length { return -1 }
  const w = nodeAt(x)
  if !(w is WhileStmt) || w.whileBlk != 1 { return -1 }
  const b = nodeAt(w.whileBody)
  if !(b is Block) || b.blkStmts.length != 2 { return -1 }
  const k = b.blkStmts[1]
  const kn = if k >= 0 && k < P.nodes.length { nodeAt(k) } else { b }
  if !(kn is BreakStmt) || kn.brkHasVal != 1 { return -1 }
  if kn.brkLabel != w.whileLabel { return -1 }
  b.blkStmts[0]
}

// The operator count from which a chain's root is marked `binRegion`. A chain the mark misses
// costs the emitter time, never an answer.
export const ARITH_CHAIN_MIN = 16

// The operators whose result width follows their operands', which an arithmetic chain joins.
export function opIsArith(op: string) {
  op == "+"
    || op == "-"
    || op == "*"
    || op == "/"
    || op == "%"
    || op == "&"
    || op == "|"
    || op == "^"
    || op == "<<"
    || op == ">>"
    || op == ">>>"
}

// Whether any node carries `binRegion`, so a program with none tests one flag, not a field.
export let arithRegionSeen = false

// Mark the root of every run of `ARITH_CHAIN_MIN` or more arithmetic operators along the left
// spine under `root` (a loop of the precedence climber), so a chain an operator outside the
// arithmetic tiers wraps (`a + … + a == 0`) is marked at its own root (D2445).
export function markArithRuns(root: i32) {
  let cur = root
  let top = -1
  let n = 0
  while cur >= 0 {
    const e = nodeAt(cur)
    if e is BinExpr {
      if opIsArith(e.binOp) {
        if n == 0 { top = cur }
        n = n + 1
      } else {
        if n >= ARITH_CHAIN_MIN { markArithRegion(top) }
        n = 0
      }
      cur = e.binLeft
    } else {
      cur = -1
    }
  }
  if n >= ARITH_CHAIN_MIN { markArithRegion(top) }
  0
}

// Mark node `ix`, when it is a binary operator, as the root of a long arithmetic chain.
export function markArithRegion(ix: i32) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  if n is BinExpr {
    n.binRegion = 1
    arithRegionSeen = true
  }
  0
}

// The `P.diags` indices whose diagnostic came from a recovery that provably preserved the
// program the author wrote: no token dropped, none invented. The driver lets the checker
// run past parse diagnostics only when every one is in here. Sparse and index-keyed, since
// a dense column would need pushing in lockstep by every `P.diags.push` in the tree.
let dgLossless: i32[] = []
// A parse diagnostic whose span runs past its anchor token: the `P.diags` index and the token
// it ends at, pushed in pairs. Sparse for the same reason as `dgLossless`.
let dgSpanIdx: i32[] = []
let dgSpanTok: i32[] = []
// A parse diagnostic's stable code, for one `check --fix` can act on: the `P.diags` index and
// its code, pushed in pairs. Sparse for the same reason as `dgLossless`.
let dgCodeIdx: i32[] = []
let dgCodeVal: string[] = []

// The `ObjLit` nodes of a bare `{}` standing as a statement, which the parser has already
// refused as an empty block (D2223); the checker skips its own value refusal for these.
export const stmtBraceNodes: i32[] = []
// The subset of `stmtBraceNodes` that end their block, whose value may be used: the parser
// leaves their message to the checker, which knows whether a value is expected there.
export const stmtBraceTails: i32[] = []
// The bare names that are a whole braced statement, `{ steps }`: a block yielding the name,
// which reads as a record shorthand to a JavaScript hand. The checker says so where a record is
// wanted (DV-1216).
export const braceNameStmts: i32[] = []

// Clear the column (and `stmtBraceNodes`). Paired with `P.diags = []`; see `vcDgReset` in driver.vl.
export function dgLosslessReset() {
  dgLossless = []
  dgSpanIdx = []
  dgSpanTok = []
  dgCodeIdx = []
  dgCodeVal = []
  while stmtBraceNodes.length > 0 { stmtBraceNodes.pop() }
  while stmtBraceTails.length > 0 { stmtBraceTails.pop() }
  while braceNameStmts.length > 0 { braceNameStmts.pop() }
  0
}

// Mark the `P.diags` index `i` as a lossless recovery's diagnostic. Callers pass
// the index the push is about to occupy (`P.diags.length`), matching `vcDgPush`.
export function dgMarkLossless(i: i32) {
  dgLossless.push(i)
  0
}

// Make the `P.diags` index `i` span from its anchor through token `tok`. Callers pass the
// index the push is about to occupy (`P.diags.length`), matching `dgMarkLossless`.
export function dgMarkSpanEnd(i: i32, tok: i32) {
  dgSpanIdx.push(i)
  dgSpanTok.push(tok)
  0
}

// The code of a JavaScript `===` or `!==`, which `check --fix` rewrites to VL's operator.
export const STRICT_EQ_CODE = "strict-equality"

// Give the `P.diags` index `i` the stable code `code`. Callers pass the index the push is about
// to occupy (`P.diags.length`), matching `dgMarkLossless`.
export function dgMarkCode(i: i32, code: string) {
  dgCodeIdx.push(i)
  dgCodeVal.push(code)
  0
}

// The code of parse diagnostic `i`, or "" when it has none.
export function dgCodeOf(i: i32): string {
  let k = 0
  while k < dgCodeIdx.length {
    if dgCodeIdx[k] == i { return dgCodeVal[k] }
    k = k + 1
  }
  ""
}

// The token parse diagnostic `i` ends at, or -1 when it ends at its own anchor.
export function dgSpanEndTok(i: i32): i32 {
  let k = 0
  while k < dgSpanIdx.length {
    if dgSpanIdx[k] == i { return dgSpanTok[k] }
    k = k + 1
  }
  -1
}

// Whether every parse diagnostic raised so far is a lossless recovery's — vacuously true
// for a clean parse, so a caller that cares tests `P.diags.length` itself, as the driver's
// `vcParseBlocked` does. The scan is O(diags × marks), both user-error counts.
export function dgAllLossless(): boolean {
  let i = 0
  while i < P.diags.length {
    let found = false
    let k = 0
    while k < dgLossless.length {
      if dgLossless[k] == i { found = true }
      k = k + 1
    }
    if !found { return false }
    i = i + 1
  }
  true
}

// Every event that makes `P.nodes` something other than the tree one parse built: a fresh
// `parseProgram`, and each in-place rewrite of a slot or of a name a node already carries.
// Monotone, so `driver.vl`'s parse bank compares its own reading and nothing resets it.
let arenaEpoch = 0

// Stamp a rewrite the parse bank cannot undo by popping the rows a pass appended.
export function arenaEpochBump() {
  arenaEpoch = arenaEpoch + 1
  0
}

export function arenaEpochNow(): i32 { arenaEpoch }

// Every in-place write that changes which name an existing node refers to: an identifier
// renamed (`sidNoteNodeName`) or a call's callee repointed. Monotone, like the epoch.
let arenaRefWrites = 0

export function arenaNoteRefWrite() {
  arenaRefWrites = arenaRefWrites + 1
  0
}

export function arenaRefWritesNow(): i32 { arenaRefWrites }

// The slots the logged edits below rewrote, in order, and how many epoch bumps they made: a
// reader whose read predates only logged bumps refreshes those slots instead of the tree.
let arenaEditSlots: i32[] = []
export let arenaEditBumps = 0

// Stamp an in-place edit of slot `ix`: its node replaced, or a child list of it rewritten.
export function arenaNoteEdit(ix: i32) {
  arenaEditSlots.push(ix)
  arenaEditBumps = arenaEditBumps + 1
  arenaEpochBump()
}

export function arenaEditCount(): i32 { arenaEditSlots.length }
// The slot of logged edit `i`, or -1 past the log.
export function arenaEditSlotAt(i: i32): i32 {
  if i < 0 || i >= arenaEditSlots.length { return -1 }
  arenaEditSlots[i]
}
export function arenaEditBumpCount(): i32 { arenaEditBumps }

// Forget the logged slots; a reader holding a position into the log rereads the tree instead.
export function arenaEditLogReset() {
  arenaEditSlots = []
  0
}

// Overwrite arena slot `ix` with the node at `from` — the four checker lowerings that
// replace a node in place, stamped here so the bank cannot miss one.
export function arenaReplaceNode(ix: i32, from: i32) {
  P.nodes[ix] = nodeAt(from)
  arenaNoteEdit(ix)
  0
}

// The same overwrite from a node the caller built rather than an arena index — the deep-`is`
// rewrite's two sites.
export function arenaSetNode(ix: i32, n: Node) {
  P.nodes[ix] = n
  arenaNoteEdit(ix)
  0
}

// `nodeToks[i]` is the token index of the last token consumed while building `P.nodes[i]`
// (`addNode` records `P.pos - 1`) — enough to render a `line:col`. A side array, not a
// field per variant, so no node struct changes. Consumers must bounds-check: a harness
// that resets `P.nodes` and not this leaves it misaligned, and out of range is "no span".
export let nodeToks: i32[] = []

// `declNameTok[i]` is the token index of the declaring identifier for `P.nodes[i]` when
// that node is a declaration. `nodeToks[i]` anchors a node at its last token, the wrong
// span for go-to-definition, which jumps to the name. `-1` means fall back to `nodeToks`.
// Parallel to `P.nodes`, grown lazily, bounds-checked on read like `nodeToks`.
export let declNameTok: i32[] = []

// Record `tok` as the declaring-identifier token of `nodeIx`. Grows the parallel
// table to cover `nodeIx` (filling the gap with `-1`). The parser calls this
// right after constructing a declaration node, passing the token index it
// captured when it read the name.
export function mkDeclNameTok(nodeIx: i32, tok: i32) {
  while declNameTok.length <= nodeIx { declNameTok.push(-1) }
  declNameTok[nodeIx] = tok
  0
}

// The declaring-identifier token of `nodeIx` (its name token), or `-1` when none is
// stamped — readers then fall back to the node's anchor token (`nodeToks`).
export function declNameTokOf(nodeIx: i32) {
  if nodeIx >= 0 && nodeIx < declNameTok.length { return declNameTok[nodeIx] }
  -1
}

// Whether the top-level declaration at arena node `ix` carried an `export` modifier. The
// parser drops the keyword from the AST, so it is recovered from the token stream: a
// top-level `function` is `EXPORT? FUNCTION IDENT`, so the name token is exported exactly
// when the token two positions back is `EXPORT`. Lives here as `declNameTok`'s reader.
export function declHasExportKw(ix: i32) {
  const t = declNameTokOf(ix)
  if t < 2 { return false }
  const kw = t - 2
  if kw >= 0 && kw < P.toks.length { return P.toks[kw].kind == "EXPORT" }
  false
}

// Two sidecars parallel to `P.nodes`, lazily grown, bounds-checked, reset per compile.
// `callSiteLoc[callIx]` is the `__callsite__` `ObjLit` minted for that call in a pre-pass
// (a node minted after `nodeTyIx` is sized reads its type back as -1 forever, D969), and
// `defaultGlobalRef[identIx]` marks a default that resolved to a module-scope `const`.
let callSiteLoc: i32[] = []
let defaultGlobalRef: i32[] = []

// The spelling of the call-site intrinsic. Legal only as a parameter default
// value; anywhere else it is an ordinary (undeclared) identifier, and the
// checker says so by name.
export const CALLSITE_NAME = "__callsite__"

export function paramDefaultTablesReset() {
  callSiteLoc = []
  defaultGlobalRef = []
  retypedLet = []
  0
}

// `retypedLet[letIx]` marks a literal `let` the checker gave its uses' type (D3246): as a `const`
// it would be its literal at every read instead, so `prefer-const` does not suggest it.
let retypedLet: boolean[] = []

export function markLetRetyped(letIx: i32) {
  if letIx < 0 { return 0 }
  while retypedLet.length <= letIx { retypedLet.push(false) }
  retypedLet[letIx] = true
  0
}

export function letWasRetyped(letIx: i32): boolean {
  letIx >= 0 && letIx < retypedLet.length && retypedLet[letIx]
}

export function setCallSiteLoc(callIx: i32, locIx: i32) {
  if callIx < 0 { return 0 }
  while callSiteLoc.length <= callIx { callSiteLoc.push(-1) }
  callSiteLoc[callIx] = locIx
  0
}

export function callSiteLocOf(callIx: i32) {
  if callIx >= 0 && callIx < callSiteLoc.length { return callSiteLoc[callIx] }
  -1
}

export function markDefaultGlobalRef(nodeIx: i32) {
  if nodeIx < 0 { return 0 }
  while defaultGlobalRef.length <= nodeIx { defaultGlobalRef.push(0) }
  defaultGlobalRef[nodeIx] = 1
  0
}

export function isDefaultGlobalRef(nodeIx: i32) {
  if nodeIx >= 0 && nodeIx < defaultGlobalRef.length {
    return defaultGlobalRef[nodeIx] == 1
  }
  false
}

// Is `dIx` the `__callsite__` intrinsic — the one default form whose value is per call
// site rather than per declaration? The parser leaves it a plain `Ident`; nothing declares
// that name, so this spelling test is exact.
export function paramDefaultIsCallsite(dIx: i32) {
  if dIx < 0 || dIx >= P.nodes.length { return false }
  const d = nodeAt(dIx)
  if d is Ident { return d.identName == CALLSITE_NAME }
  false
}

// The end char offset (one past the last) of the source `P.nodes[nodeIx]` spans — the stop
// offset of the last token consumed while the node is built. Paired with the node's `pos`
// this is the `[start, stop)` span the formatter slices verbatim. `-1` when `nodeIx`, its
// `nodeToks` entry or the resolved token is out of range, the "no span" a `pos < 0` gives.
export function nodeEndOf(nodeIx: i32) {
  if nodeIx < 0 || nodeIx >= nodeToks.length { return -1 }
  const tk = nodeToks[nodeIx]
  if tk < 0 || tk >= P.toks.length { return -1 }
  const t = P.toks[tk]
  t.start + t.text.length
}

// The type-spelling side arena: `parseTypeName` returns a string every later pass takes
// apart again, so this records what the parser saw as a flat tree — `tsKind[i]` the kind,
// `tsText[i]` the lexeme, children at `tsKids[tsKidStart[i], +tsKidCount[i])`. A spelling
// tree, not a type: resolving `Box<i32>` needs an environment the parser cannot have.
export const TS_NAME = 0    // a bare identifier or primitive name (`i32`, `Cat`, `T`)
export const TS_APP = 1     // `Head<a, b>` — tsText = head, kids = the arguments
export const TS_ARR = 2     // `X[]` — one kid
export const TS_UNION = 3   // `A | B | …` — two or more kids
export const TS_ISECT = 4   // `A & B` — two or more kids
export const TS_NEG = 5     // `!A` — one kid
export const TS_PAREN = 6   // `(A)` / `(A, B)` — the comma list
export const TS_FUNC = 7    // `(params) => ret` — kids = the params, then the RETURN last
export const TS_MAP = 8     // `{[K]: V}` — tsText = the key name, one kid = V
export const TS_OBJ = 9     // `{x: T, y: U}` — kids = `TS_FIELD` nodes
export const TS_FIELD = 10  // one inline-object field — tsText = its name, one kid = its type
export const TS_LITSTR = 11 // a string-literal type — tsText keeps the QUOTED lexeme
export const TS_LITNUM = 12 // a numeric-literal type — tsText is the raw lexeme
export const TS_NULL = 13   // the `null` type
export const TS_ERR = 14    // the `expect("IDENT")` recovery leaf (the parser's `""` name)
// `m(A, B): R` — a method member of a type literal. `tsText` is the member's name and the
// kids are the call's argument types with the result last, `TS_FUNC`'s layout, because a
// method member is a call shape with the receiver implicit. A sibling of `TS_FIELD`, not a
// flavour: `{f: () => string}` demands a closure value, `{f(): string}` only that it types.
export const TS_METHOD = 15

// The synthesized-annotation pin kinds. An emitter-synthesized `TypeRef` can carry a name
// the annotation grammar cannot resolve, because it is an emitter-internal handle rather
// than a type spelling. That provenance travels in its own column — `typecheck`'s pin
// sidecar, keyed by node index — with the payload beside the kind, so no consumer slices.
export const PIN_NONE = 0   // an ordinary type name — `nameToTy` resolves it
export const PIN_SIGKEY = 1 // a monomorphized CLOSURE pin; payload = the `$fnsig` key
export const PIN_ANON = 2   // an interned ANONYMOUS-SHAPE row name (the emitter's `sNames`)

export let tsKind: i32[] = []
export let tsText: string[] = []
export let tsKidStart: i32[] = []
export let tsKidCount: i32[] = []
export let tsKids: i32[] = []
// The child stack. Only ever holds the nodes of the spellings currently open on
// the parser's recursion, so it is empty between annotations.
let tsStack: i32[] = []

// The stack mark a producer takes before parsing its children.
export function tsMark() { tsStack.length }

// Finish a spelling node whose children are the stack region above `mark`: move
// them into `tsKids`, pop them, push the new node. Returns its arena index.
export function tsMk(kind: i32, text: string, mark: i32) {
  const start = tsKids.length
  let i = mark
  while i < tsStack.length {
    tsKids.push(tsStack[i])
    i = i + 1
  }
  const cnt = tsKids.length - start
  while tsStack.length > mark { tsStack.pop() }
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(start)
  tsKidCount.push(cnt)
  const ix = tsKind.length - 1
  tsStack.push(ix)
  ix
}

// Wrap the node on top of the stack (the `[]` array suffix: `X` → `X[]`).
export function tsWrap(kind: i32, text: string) {
  let mark = tsStack.length - 1
  if mark < 0 { mark = 0 }
  tsMk(kind, text, mark)
}

// Stamp a marker onto a finished spelling node. The one field of the spelling arena a
// producer writes after the fact: `readonly` binds the OUTERMOST `[]` suffix, and which
// suffix that is becomes known only once the suffix loop has ended.
export function tsSetText(ix: i32, text: string) {
  if ix >= 0 {
    if ix < tsText.length { tsText[ix] = text }
  }
  0
}

// A childless spelling node built off the stack. `tsMk`'s contract is "the children are
// the stack region above a mark", which only a producer mid-recursion can satisfy; a
// caller holding finished roots needs this plain constructor. Nothing is pushed to
// `tsStack`, so the recursion's balance is untouched.
export function tsLeaf(kind: i32, text: string) {
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(tsKids.length)
  tsKidCount.push(0)
  tsKind.length - 1
}

// The same, with an explicit child list. Used where the parser assembles a
// spelling from roots it already popped — `parseTypeDecl`'s `{ … } & …`
// re-encode, whose first union member is built from the field list it just
// parsed rather than by a `parseTypeName` call.
export function tsMkKids(kind: i32, text: string, kids: i32[]) {
  const start = tsKids.length
  let i = 0
  while i < kids.length {
    tsKids.push(kids[i])
    i = i + 1
  }
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(start)
  tsKidCount.push(kids.length)
  tsKind.length - 1
}

// The tree of a list of `el`: `el[]`, grouped when `el` is a union, intersection or function
// type, which the `[]` would otherwise bind into. -1 stays -1.
export function tsListOf(el: i32) {
  if el < 0 { return -1 }
  let k = el
  if tsGroupsAsKid(el) { k = tsMkKids(TS_PAREN, "", [el]) }
  tsMkKids(TS_ARR, "", [k])
}

// Whether tree `ix` needs grouping parens to stand as one operand of `|`, `&` or `[]`.
function tsGroupsAsKid(ix: i32): boolean {
  const k = tsKind[ix]
  k == TS_UNION || k == TS_ISECT || k == TS_FUNC
}

// Take the finished root a type producer left on the stack. Every producer
// pushes exactly one node — the error arm pushes `TS_ERR` — so this is total on
// a producer's return; the `-1` guard is the same "never trap on a misaligned
// side table" contract `nodeToks` / `declNameTok` keep.
export function tsPop() {
  const n = tsStack.length
  if n == 0 { return -1 }
  const ix = tsStack[n - 1]
  tsStack.pop()
  ix
}

// The annotation-node → spelling-root map, as two parallel push columns: `annTsNode[r]` is
// a `TypeRef` node index and `annTsRoot[r]` its spelling root. Sparse rather than parallel
// to `P.nodes`, since annotations are a minority. `annTsNode` is strictly increasing by
// construction, so `annTsOf` is a binary search; a missed reset is a wrong answer, not a hole.
export let annTsNode: i32[] = []
let annTsRoot: i32[] = []
// The root as the parser banked it, which `clearAnnTs` never drops: what the author wrote,
// for editor display only (`annTsWrittenOf`), since after canon it may describe another type.
let annTsWritten: i32[] = []

// A match arm pattern's value spelling, where the module merge renamed its type spelling to a
// different name: a local value shadows the name there, so a `const` arm reads it (D3271).
let matchPatValNames: {[i32]: string} = Map()

export function setMatchPatValueName(nodeIx: i32, name: string) {
  matchPatValNames[nodeIx] = name
  0
}

// The value spelling of arm pattern `nodeIx`, or `typeName` where the merge kept the two equal.
export function matchPatValueName(nodeIx: i32, typeName: string) {
  matchPatValNames[nodeIx] ?? typeName
}

export function setAnnTs(nodeIx: i32, root: i32) {
  annTsNode.push(nodeIx)
  annTsRoot.push(root)
  annTsWritten.push(root)
  0
}

// Explicit call-site type arguments (`f<A, B>(x)`): one row per call that wrote any, its
// argument `TypeRef` nodes in source order. Pushed as the `Call` is minted, so `callTaCall`
// is strictly increasing. `callTaEnds` holds each argument's source end offset (-1 when
// synthesized), since a token span cannot say where a fused `>>` splits.
let callTaCall: i32[] = []
let callTaStart: i32[] = []
let callTaCount: i32[] = []
let callTaNodes: i32[] = []
let callTaEnds: i32[] = []

export function setCallTyArgs(callIx: i32, tyArgs: i32[], ends: i32[]) {
  callTaCall.push(callIx)
  callTaStart.push(callTaNodes.length)
  callTaCount.push(tyArgs.length)
  let i = 0
  while i < tyArgs.length {
    callTaNodes.push(tyArgs[i])
    if i < ends.length { callTaEnds.push(ends[i]) } else { callTaEnds.push(-1) }
    i = i + 1
  }
  0
}

// The `TypeRef` nodes the call `callIx` wrote as explicit type arguments, or an empty list.
export function callTyArgsOf(callIx: i32): i32[] { callTyArgCol(callIx, false) }

// Whether any call in the arena wrote explicit type arguments.
export function callTyArgsAny(): boolean { callTaCall.length > 0 }

// Whether the call `callIx` wrote explicit type arguments: `callTyArgsOf` without the list.
export function callHasTyArgs(callIx: i32): boolean {
  if callTaCall.length == 0 { return false }
  callTyArgsOf(callIx).length > 0
}

// `callTyArgsOf`'s parallel list of source end offsets (-1 where synthesized).
export function callTyArgEndsOf(callIx: i32): i32[] {
  callTyArgCol(callIx, true)
}

function callTyArgCol(callIx: i32, ends: boolean): i32[] {
  const out: i32[] = []
  let lo = 0
  let hi = callTaCall.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = callTaCall[mid]
    if at == callIx {
      let i = 0
      while i < callTaCount[mid] {
        const ti = callTaStart[mid] + i
        if ends { out.push(callTaEnds[ti]) } else { out.push(callTaNodes[ti]) }
        i = i + 1
      }
      return out
    }
    if at < callIx { lo = mid + 1 } else { hi = mid - 1 }
  }
  out
}

// The multi-root twin, for a node whose type spellings are a list: a `UnionDecl`'s members
// live on the node as a `string[]` and cannot key one root each above. One row per member
// in member order, so `udTsNode` is non-decreasing and a member's root is
// `udTsRoot[first(node) + k]`. A member root may be -1, and the consumer falls back.
let udTsNode: i32[] = []
let udTsRoot: i32[] = []
// `annTsWritten`'s twin: the member roots `clearUdTs` never drops, for display only.
let udTsWritten: i32[] = []

export function setUdTs(nodeIx: i32, roots: i32[]) {
  let i = 0
  while i < roots.length {
    udTsNode.push(nodeIx)
    udTsRoot.push(roots[i])
    udTsWritten.push(roots[i])
    i = i + 1
  }
  0
}

// The generic type declaration's parameter list as the parser read it: `type Box<T>` folds
// its parameters into the declared name, and the parser hands the list over rather than
// leaving consumers to take it back out with a `<`-scan. One row per declaration that
// consumed a `<` — so `type Box<> = …` is a row — holding the base name and a name slice.
let declGpNode: i32[] = []
let declGpBase: string[] = []
let declGpStart: i32[] = []
let declGpCount: i32[] = []
let declGpName: string[] = []

export function setDeclGp(nodeIx: i32, base: string, names: string[]) {
  declGpNode.push(nodeIx)
  declGpBase.push(base)
  declGpStart.push(declGpName.length)
  declGpCount.push(names.length)
  let i = 0
  while i < names.length {
    declGpName.push(names[i])
    i = i + 1
  }
  0
}

// The row index of `nodeIx`, or -1 when it is not a generic declaration.
function declGpRowOf(nodeIx: i32) {
  let i = 0
  while i < declGpNode.length {
    if declGpNode[i] == nodeIx { return i }
    i = i + 1
  }
  -1
}

// The base name of the generic declaration at `nodeIx` (`Box` of `Box<T>`), or
// "" when the node is not one — which is the answer every caller already treats
// as "this declared name is its own base".
export function declGpBaseOf(nodeIx: i32) {
  const r = declGpRowOf(nodeIx)
  if r < 0 { return "" }
  declGpBase[r]
}

// Its type-parameter names in declaration order; empty for a non-generic node.
export function declGpParamsOf(nodeIx: i32): string[] {
  const out: string[] = []
  const r = declGpRowOf(nodeIx)
  if r < 0 { return out }
  const start = declGpStart[r]
  let i = 0
  while i < declGpCount[r] {
    out.push(declGpName[start + i])
    i = i + 1
  }
  out
}

// D1045 — the body-scoped `type` declarations, marked where they are minted. A `type`
// declared inside a block is lexically scoped, and the parser implements that by mangling
// the name unique (`P` → `P$b7`) and hoisting the declaration into `progStmts`. The node
// is then reachable twice, so the formatter and the merge ask here not to double-count.
export let bodyTyDeclNode: i32[] = []

export function setBodyTyDecl(nodeIx: i32) {
  bodyTyDeclNode.push(nodeIx)
  0
}

// Is `nodeIx` a declaration the parser found inside a block and hoisted into `progStmts`?
// False for every module-scope declaration and every other node kind.
export function isBodyTyDecl(nodeIx: i32): boolean {
  let i = 0
  while i < bodyTyDeclNode.length {
    if bodyTyDeclNode[i] == nodeIx { return true }
    i = i + 1
  }
  false
}

// ── extern declarations: link rows and declaration rows ──────────────────────

// The LINK rows: one per distinct wasm import name in the module graph, in
// first-declaration order — the order the import section writes, which is what fixes each
// extern's wasm function index. Two modules declaring one extern share a row, so the name
// they both spell is one import.
export let extNames: string[] = []
let extRets: string[] = []
export let extSigs: string[] = []
export let extPoss: i32[] = []
let extParBase: i32[] = []
let extParN: i32[] = []
// The parameter type spellings of every link row, contiguous per row — flat rather than a
// `string[][]`, so a row's parameters are `extParTys[base + i]` with no nested list.
let extParTys: string[] = []

// The DECLARATION rows: one per `extern function` written anywhere in the graph. `extDeclVl`
// is the name VL resolves — mangled by the module merge, so a module-private extern is
// private to name lookup while the link name it points at stays shared. `extDeclSig` is that
// declaration's own rendered signature, which the checker compares against its link row's.
export let extDeclVl: string[] = []
export let extDeclLink: i32[] = []
export let extDeclSig: string[] = []
export let extDeclPos: i32[] = []
export let extDeclMod: i32[] = []
// Each declaration row's own parameters and return, which its link row keeps only for the
// first declarer: the parse bank replays a module's rows through `externAdd` from these.
let extDeclRet: string[] = []
let extDeclParBase: i32[] = []
let extDeclParN: i32[] = []
let extDeclParTys: string[] = []
// `externLinkOf`'s index: each VL name's FIRST declaration row. Rebuilt when a rename has
// made it stale, extended in place by `externAdd` otherwise (D2310).
let extDeclIx: {[string]: i32} = Map()
let extDeclIxStale = true
// The module index `externAdd` stamps on a declaration. The driver's per-module parse loop
// sets it; a single-source program never does, and its one module is 0 by construction.
let externCurMod = 0

export function externSetMod(m: i32) {
  externCurMod = m
  0
}

// Per-compile reset, called wherever `P.nodes = []` is: the tables span the whole module
// graph, so they must outlive one module's parse and must not outlive one program's compile.
export function externReset() {
  extNames = []
  extRets = []
  extSigs = []
  extPoss = []
  extParBase = []
  extParN = []
  extParTys = []
  extDeclVl = []
  extDeclLink = []
  extDeclSig = []
  extDeclPos = []
  extDeclMod = []
  extDeclRet = []
  extDeclParBase = []
  extDeclParN = []
  extDeclParTys = []
  extDeclIx = Map()
  extDeclIxStale = true
  externCurMod = 0
  extGNames = []
  extGTys = []
  extGMut = []
  extGDeclNode = []
  extGDeclLink = []
  extGDeclTy = []
  extGDeclMut = []
  extGDeclPos = []
  0
}

// ── extern globals: `extern let` / `extern const` ────────────────────────────

// The LINK rows: one imported wasm global per distinct name, in first-declaration order —
// which is its global index, since imported globals precede every defined one. `extGMut` is 1
// for `extern let` (a mutable import) and 0 for `extern const`.
export let extGNames: string[] = []
export let extGTys: string[] = []
export let extGMut: i32[] = []
// The DECLARATION rows: the `LetDecl` each `extern let`/`extern const` mints (its name is the
// one the module merge mangles), the link row it resolves to, and its own type and mutability,
// which the checker compares against the link row's.
export let extGDeclNode: i32[] = []
export let extGDeclLink: i32[] = []
export let extGDeclTy: string[] = []
export let extGDeclMut: i32[] = []
export let extGDeclPos: i32[] = []

export function externGlobalCount(): i32 { extGNames.length }

// The link row the top-level `LetDecl` at `nodeIx` imports, or -1 for an ordinary binding.
export function externGlobalLinkOfNode(nodeIx: i32): i32 {
  let i = 0
  while i < extGDeclNode.length {
    if extGDeclNode[i] == nodeIx { return extGDeclLink[i] }
    i = i + 1
  }
  -1
}

// The link row whose `LetDecl` is currently named `vlName` (after the merge's rename), or -1.
export function externGlobalLinkOfName(vlName: string): i32 {
  let i = 0
  while i < extGDeclNode.length {
    const ix = extGDeclNode[i]
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is LetDecl {
        if n.letName == vlName { return extGDeclLink[i] }
      }
    }
    i = i + 1
  }
  -1
}

// Record one `extern let`/`extern const` whose `LetDecl` is `nodeIx`, answering its
// declaration row. A name already linked reuses that row, so two modules declaring one
// global are one import and only a disagreement reaches the checker.
export function externGlobalAdd(
  name: string,
  ty: string,
  mut: i32,
  pos: i32,
  nodeIx: i32,
) {
  let link = -1
  let i = 0
  while i < extGNames.length && link < 0 {
    if extGNames[i] == name { link = i }
    i = i + 1
  }
  if link < 0 {
    extGNames.push(name)
    extGTys.push(ty)
    extGMut.push(mut)
    link = extGNames.length - 1
  }
  extGDeclNode.push(nodeIx)
  extGDeclLink.push(link)
  extGDeclTy.push(ty)
  extGDeclMut.push(mut)
  extGDeclPos.push(pos)
  extGDeclNode.length - 1
}

// The link row whose import name is `name`, or -1. Keyed on the name the AUTHOR wrote, which
// is what makes two modules' declarations one import.
function externSlot(name: string): i32 {
  let i = 0
  while i < extNames.length {
    if extNames[i] == name { return i }
    i = i + 1
  }
  -1
}

// The link row a VL name resolves to, or -1 — the lookup every consumer past the merge takes,
// since a call site carries the merged (possibly mangled) name and not the import name.
export function externLinkOf(vlName: string): i32 {
  if extDeclIxStale { extDeclIxRebuild() }
  const d = extDeclIx[vlName] ?? -1
  if d < 0 || d >= extDeclLink.length { return -1 }
  extDeclLink[d]
}

function extDeclIxRebuild() {
  extDeclIx = Map()
  let i = 0
  while i < extDeclVl.length {
    if (extDeclIx[extDeclVl[i]] ?? -1) < 0 { extDeclIx[extDeclVl[i]] = i }
    i = i + 1
  }
  extDeclIxStale = false
  0
}

// How many imports the manifest declares — the entry count the import section writes and the
// standalone functype count the type section appends.
export function externCount(): i32 { extNames.length }

export function externDeclCount(): i32 { extDeclVl.length }

export function externNameAt(k: i32): string {
  if k < 0 || k >= extNames.length { return "" }
  extNames[k]
}

// The return type spelling of link row `k`; `""` when the declaration named none, which the
// checker refuses (an extern has no body to infer a result from).
export function externRetAt(k: i32): string {
  if k < 0 || k >= extRets.length { return "" }
  extRets[k]
}

// True when link row `k` is a result-less import: declared `: void` or `: never`, or declared
// with no return type (refused by the checker, and lowered the same way so the refusal stays the
// only diagnostic). False for `-1`, so a caller may pass `externLinkOf`'s miss straight in.
export function externRetIsVoid(k: i32): boolean {
  if k < 0 || k >= extRets.length { return false }
  extRets[k] == "" || extRets[k] == "void" || extRets[k] == "never"
}

// The parameter count of link row `k`, or -1 out of range — which every caller treats as
// "this row is not emittable", never as an arity.
export function externArityAt(k: i32): i32 {
  if k < 0 || k >= extParN.length { return -1 }
  extParN[k]
}

// The type spelling of parameter `i` of link row `k`, or `""` out of range — read by the
// functype writer and the call lowering, which treat `""` as an unemittable row.
export function externParamAt(k: i32, i: i32): string {
  if k < 0 || k >= extParN.length { return "" }
  if i < 0 || i >= extParN[k] { return "" }
  const at = extParBase[k] + i
  if at < 0 || at >= extParTys.length { return "" }
  extParTys[at]
}

// Rebind declaration `d`'s VL name — the module merge's hook, which mangles a declared name
// so a module-private extern cannot be reached by spelling it in another module. The LINK
// name is untouched, so the import section still carries what the author wrote.
export function externRenameDecl(d: i32, vlName: string) {
  if d < 0 || d >= extDeclVl.length { return 0 }
  extDeclVl[d] = vlName
  extDeclIxStale = true
  0
}

// Record one `extern function`, answering its declaration row. A name already linked reuses
// that link row rather than appending a second import, so two modules declaring one extern
// agree by construction and only a DISAGREEMENT of signatures reaches the checker.
export function externAdd(
  name: string,
  params: string[],
  ret: string,
  pos: i32,
) {
  let sig = "("
  let i = 0
  while i < params.length {
    if i > 0 { sig = sig + "," }
    sig = sig + params[i]
    i = i + 1
  }
  sig = sig + ")->" + ret
  let link = externSlot(name)
  if link < 0 {
    extNames.push(name)
    extRets.push(ret)
    extSigs.push(sig)
    extPoss.push(pos)
    extParBase.push(extParTys.length)
    extParN.push(params.length)
    let j = 0
    while j < params.length {
      extParTys.push(params[j])
      j = j + 1
    }
    link = extNames.length - 1
  }
  extDeclVl.push(name)
  if !extDeclIxStale && (extDeclIx[name] ?? -1) < 0 {
    extDeclIx[name] = extDeclVl.length - 1
  }
  extDeclLink.push(link)
  extDeclSig.push(sig)
  extDeclPos.push(pos)
  extDeclMod.push(externCurMod)
  extDeclRet.push(ret)
  extDeclParBase.push(extDeclParTys.length)
  extDeclParN.push(params.length)
  let k = 0
  while k < params.length {
    extDeclParTys.push(params[k])
    k = k + 1
  }
  extDeclVl.length - 1
}

// Constraints phase 1: bounds, kept where annotations are kept. Both tables store an
// annotation node index, never a rendered name, because a declared bound is an annotation
// and rides the path that works end to end — D976 records that the column the checker
// writes for an inferred shape does not. One row per bounded parameter; `<T>` answers -1.
let fnTpBoundFn: i32[] = []
let fnTpBoundIx: i32[] = []
let fnTpBoundAnn: i32[] = []

export function setFnTpBound(fnIx: i32, k: i32, annIx: i32) {
  fnTpBoundFn.push(fnIx)
  fnTpBoundIx.push(k)
  fnTpBoundAnn.push(annIx)
  0
}

// The bound annotation node on type parameter `k` of the `FuncDecl` at `fnIx`, or
// -1 when that parameter is unbounded (or the node is not a function).
export function fnTpBoundOf(fnIx: i32, k: i32) {
  let i = 0
  while i < fnTpBoundFn.length {
    if fnTpBoundFn[i] == fnIx && fnTpBoundIx[i] == k { return fnTpBoundAnn[i] }
    i = i + 1
  }
  -1
}

// Does this function declare any bounded type parameter? The cheap gate every
// consumer takes before doing bound work, so an unbounded generic pays one scan.
export function fnHasTpBound(fnIx: i32) {
  let i = 0
  while i < fnTpBoundFn.length {
    if fnTpBoundFn[i] == fnIx { return true }
    i = i + 1
  }
  false
}

// One row per bound alias declaration (`type Showable = { toString(): string }`, a `type`
// whose body carries at least one method member). The row holds the whole body as one
// synthetic-object annotation node, so `<T: Showable>` and `<T: { toString(): string }>`
// reach the identical spelling tree. The declaration itself is minted with no fields.
let declBoundNode: i32[] = []
let declBoundAnn: i32[] = []

export function setDeclBound(nodeIx: i32, annIx: i32) {
  declBoundNode.push(nodeIx)
  declBoundAnn.push(annIx)
  0
}

// The bound-body annotation node of the declaration at `nodeIx`, or -1 when it is
// an ordinary type declaration.
export function declBoundOf(nodeIx: i32) {
  let i = 0
  while i < declBoundNode.length {
    if declBoundNode[i] == nodeIx { return declBoundAnn[i] }
    i = i + 1
  }
  -1
}

// The module merge renames a declaration's base segment (`Box` → `Box$m1`) and writes it
// back into `tdName`/`udName`. The bank is a second copy of that segment and must move
// with it — the same lockstep `modRwType` keeps between a `TypeRef`'s tree and its name; a
// stale base registers the alias under a name no application spells.
export function setDeclGpBase(nodeIx: i32, base: string) {
  const r = declGpRowOf(nodeIx)
  if r >= 0 { declGpBase[r] = base }
  0
}

// The `k`-th member spelling root recorded for `nodeIx`, or -1 when the node has
// none (or fewer than `k + 1`). Binary search for the leftmost row of `nodeIx`
// over the non-decreasing key column, then index by `k`.
export function udTsRootAt(nodeIx: i32, k: i32) {
  let lo = 0
  let hi = udTsNode.length - 1
  let first = -1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = udTsNode[mid]
    if at < nodeIx {
      lo = mid + 1
    } else {
      if at == nodeIx { first = mid }
      hi = mid - 1
    }
  }
  if first < 0 { return -1 }
  const r = first + k
  if r >= udTsNode.length { return -1 }
  if udTsNode[r] != nodeIx { return -1 }
  udTsRoot[r]
}

// Drop the `k`-th member spelling root of `nodeIx` — `clearAnnTs`'s twin for the multi-root
// table, under the same invariant: a live root renders to the spelling the node currently
// carries. `canonEmitTypeNames`'s `UnionDecl` arm rewrites `udVariants[k]` in place, which
// is not a rename. The same binary search `udTsRootAt` walks; a node with no row is spared.
export function clearUdTs(nodeIx: i32, k: i32) {
  let lo = 0
  let hi = udTsNode.length - 1
  let first = -1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = udTsNode[mid]
    if at < nodeIx {
      lo = mid + 1
    } else {
      if at == nodeIx { first = mid }
      hi = mid - 1
    }
  }
  if first < 0 { return 0 }
  const r = first + k
  if r >= udTsNode.length { return 0 }
  if udTsNode[r] != nodeIx { return 0 }
  udTsRoot[r] = -1
  0
}

// Undo every `clearAnnTs` and `clearUdTs`: each root reads what the parser banked again. The
// twin of canon's spelling restore, so a re-check sees the trees for the names it gets back.
export function restoreAnnTsAll() {
  let i = 0
  while i < annTsRoot.length {
    annTsRoot[i] = annTsWritten[i]
    i = i + 1
  }
  let k = 0
  while k < udTsRoot.length {
    udTsRoot[k] = udTsWritten[k]
    k = k + 1
  }
  0
}

let tsHeldRow: i32[] = []
let tsHeldRoot: i32[] = []
let tsHeldUd: boolean[] = []

// The row of `nodeIx`'s `k`-th member root in the multi-root table, or -1.
function udTsRowAt(nodeIx: i32, k: i32) {
  let lo = 0
  let hi = udTsNode.length - 1
  let first = -1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = udTsNode[mid]
    if at < nodeIx {
      lo = mid + 1
    } else {
      if at == nodeIx { first = mid }
      hi = mid - 1
    }
  }
  if first < 0 { return -1 }
  const r = first + k
  if r >= udTsNode.length || udTsNode[r] != nodeIx { return -1 }
  r
}

// Show the parser's tree for `nodeIx` (its `k`-th member root when `k >= 0`) until
// `annTsShowHeld`, holding the root it replaces.
export function annTsShowWrittenAt(nodeIx: i32, k: i32) {
  if k < 0 {
    const r = annTsRowOf(nodeIx)
    if r < 0 { return 0 }
    tsHeldRow.push(r)
    tsHeldRoot.push(annTsRoot[r])
    tsHeldUd.push(false)
    annTsRoot[r] = annTsWritten[r]
    return 0
  }
  const u = udTsRowAt(nodeIx, k)
  if u < 0 { return 0 }
  tsHeldRow.push(u)
  tsHeldRoot.push(udTsRoot[u])
  tsHeldUd.push(true)
  udTsRoot[u] = udTsWritten[u]
  0
}

// Put back every root `annTsShowWrittenAt` held, newest first.
export function annTsShowHeld() {
  let i = tsHeldRow.length - 1
  while i >= 0 {
    if tsHeldUd[i] {
      udTsRoot[tsHeldRow[i]] = tsHeldRoot[i]
    } else {
      annTsRoot[tsHeldRow[i]] = tsHeldRoot[i]
    }
    i = i - 1
  }
  tsHeldRow = []
  tsHeldRoot = []
  tsHeldUd = []
  0
}

// The spelling-tree root recorded for `nodeIx`, or `-1` when none is — every non-`TypeRef`
// node, an emitter-synthesized `TypeRef` built from a name that never passed through the
// parser, and the string-only type spellings the parser still drops (`as`).
export function annTsOf(nodeIx: i32) {
  const r = annTsRowOf(nodeIx)
  if r < 0 { return -1 }
  annTsRoot[r]
}

// The spelling root the parser banked for `nodeIx` even when canon has since dropped it from
// `annTsOf`, or -1. What the author wrote, for editor display; never a type's identity.
export function annTsWrittenOf(nodeIx: i32) {
  const r = annTsRowOf(nodeIx)
  if r < 0 { return -1 }
  annTsWritten[r]
}

// The row of `nodeIx` in the annotation columns, or -1 — a binary search over `annTsNode`.
function annTsRowOf(nodeIx: i32) {
  let lo = 0
  let hi = annTsNode.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = annTsNode[mid]
    if at == nodeIx { return mid }
    if at < nodeIx { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// One-member alias name → its written spelling root, first declaration wins. Built from the
// member table on the first ask and rebuilt only when that push-only table has grown, so
// every checked binding may ask without walking it; `tsReset` drops it with the program.
let aliasRootMap: {[string]: i32} = Map()
let aliasRootLen = -1

// The written spelling root of the one-member alias `type <name> = …`, or -1 when `name`
// declares none. Asked per checked binding, so it reads the name map, never the table.
function aliasTsRootOf(name: string) {
  if aliasRootLen != udTsNode.length { aliasRootBuild() }
  aliasRootMap[name] ?? -1
}

function aliasRootBuild() {
  aliasRootMap = Map()
  let r = 0
  while r < udTsNode.length {
    const n = udTsNode[r]
    if n >= 0 && n < P.nodes.length {
      const nd = nodeAt(n)
      if nd is UnionDecl {
        if nd.udVariants.length == 1 && !aliasRootMap.has(nd.udName) {
          aliasRootMap[nd.udName] = udTsWritten[r]
        }
      }
    }
    r = r + 1
  }
  aliasRootLen = udTsNode.length
  0
}

// The parameter names a function-type spelling wrote, or `[]` when it wrote none or does
// not take exactly `arity` parameters. Sees through parentheses and a one-member alias
// name; `depth` bounds an alias cycle. Display only: a function type's identity has no names.
export function tsFnParamNames(root: i32, arity: i32, depth: i32): string[] {
  const none: string[] = []
  if root < 0 || root >= tsKind.length || depth > 8 { return none }
  const k = tsKind[root]
  if k == TS_PAREN && tsKidCount[root] == 1 {
    return tsFnParamNames(tsKids[tsKidStart[root]], arity, depth + 1)
  }
  if k == TS_NAME {
    return tsFnParamNames(aliasTsRootOf(tsText[root]), arity, depth + 1)
  }
  if k != TS_FUNC { return none }
  const text = tsText[root]
  if text.length == 0 || tsKidCount[root] - 1 != arity { return none }
  const names: string[] = []
  let start = 0
  let i = 0
  while i <= text.length {
    if i == text.length || text[i] == ',' {
      names.push(text.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if names.length != arity { return none }
  names
}

// Whether this program wrote any parameter name in a function type, so a program that
// wrote none pays nothing for `tsWritesParamNames`.
let tsAnyParamNames = false
export function tsNoteParamNames() {
  tsAnyParamNames = true
  0
}

// Whether spelling `root` names a function type's parameters anywhere, through one-member
// alias names too; `depth` bounds an alias cycle. An annotation that does is documentation.
export function tsWritesParamNames(root: i32, depth: i32): boolean {
  if !tsAnyParamNames { return false }
  if root < 0 || root >= tsKind.length || depth > 8 { return false }
  const k = tsKind[root]
  if k == TS_FUNC && tsText[root].length > 0 { return true }
  if k == TS_NAME {
    return tsWritesParamNames(aliasTsRootOf(tsText[root]), depth + 1)
  }
  let i = 0
  while i < tsKidCount[root] {
    if tsWritesParamNames(tsKids[tsKidStart[root] + i], depth) { return true }
    i = i + 1
  }
  false
}

// `tsFnParamNames` for the one-member alias spelled `name`.
export function aliasFnParamNames(name: string, arity: i32): string[] {
  tsFnParamNames(aliasTsRootOf(name), arity, 0)
}

// Drop the spelling root recorded for `nodeIx`, so `annTsOf` answers -1 and every consumer
// falls back to the node's name. The invariant this table is only useful under is that a
// live root renders to the node's current name, and canon rewrites `TypeRef.tyName` in
// place without renaming it, so the tree it leaves behind describes a different type.
export function clearAnnTs(nodeIx: i32) {
  let lo = 0
  let hi = annTsNode.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = annTsNode[mid]
    if at == nodeIx {
      annTsRoot[mid] = -1
      return 0
    }
    if at < nodeIx { lo = mid + 1 } else { hi = mid - 1 }
  }
  0
}

// Clear the spelling arena and its node columns. The driver calls this alongside
// `P.nodes = []` / `nodeToks = []` — a recorded root indexes this program's
// arena and means nothing against the next one's.
export function tsReset() {
  tsKind = []
  tsText = []
  tsKidStart = []
  tsKidCount = []
  tsKids = []
  tsStack = []
  annTsNode = []
  annTsRoot = []
  annTsWritten = []
  tsAnyParamNames = false
  matchPatValNames = Map()
  callTaCall = []
  callTaStart = []
  callTaCount = []
  callTaNodes = []
  callTaEnds = []
  udTsNode = []
  udTsRoot = []
  udTsWritten = []
  aliasRootMap = Map()
  aliasRootLen = -1
  declGpNode = []
  declGpBase = []
  declGpStart = []
  declGpCount = []
  declGpName = []
  bodyTyDeclNode = []
  fnTpBoundFn = []
  fnTpBoundIx = []
  fnTpBoundAnn = []
  declBoundNode = []
  declBoundAnn = []
  // D1003 — the plain→mangled UFCS alias table belongs to one program too. A single-file
  // compile following a module compile on the same instance would otherwise inherit the
  // previous program's rows, so UFCS resolution answers with a mangled name no function in
  // the new program declares. Invisible from the CLI; live in the LSP and the harness.
  ufcsAliasReset()
  ufcsImpReset()
  funcDeclNodes = []
  0
}

// The tree `ix` with every type-position leaf naming one of `names` replaced by the parallel
// tree of `reps`, grouped in a `TS_PAREN` where it stands as an operand. Unchanged
// subtrees are shared. -1 when a map key would be replaced by anything but a name.
export function tsSubstTree(ix: i32, names: string[], reps: i32[]): i32 {
  tsSubstGo(ix, names, reps, true)
}

function tsSubstGo(ix: i32, names: string[], reps: i32[], top: boolean): i32 {
  if ix < 0 { return -1 }
  const k = tsKind[ix]
  if k == TS_NAME {
    const r = tsRepOf(tsText[ix], names, reps)
    if r < 0 { return ix }
    if !top && tsGroupsAsKid(r) { return tsMkKids(TS_PAREN, "", [r]) }
    return r
  }
  let text = tsText[ix]
  if k == TS_MAP {
    const r = tsRepOf(text, names, reps)
    if r >= 0 {
      if tsKind[r] != TS_NAME { return -1 }
      text = tsText[r]
    }
  }
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  const kids: i32[] = []
  let changed = text != tsText[ix]
  let i = 0
  while i < cnt {
    const old = tsKids[start + i]
    const nk = tsSubstGo(old, names, reps, false)
    if nk < 0 && old >= 0 { return -1 }
    if nk != old { changed = true }
    kids.push(nk)
    i = i + 1
  }
  if !changed { return ix }
  tsMkKids(k, text, kids)
}

// The tree `reps` holds for the type name `leaf`, or -1 when `names` does not name it.
function tsRepOf(leaf: string, names: string[], reps: i32[]): i32 {
  let i = 0
  while i < names.length && i < reps.length {
    if names[i] == leaf { return reps[i] }
    i = i + 1
  }
  -1
}

// Render a spelling node back to the synthetic type name the parser built from it — arm
// for arm, the exact concatenations of `parseTypeName` / `parseTypeIsect` /
// `parseTypeAtom`, so `tsToName(annTsOf(ix))` reproduces `TypeRef.tyName` character for
// character. This is the tree's write-back; -1 renders "", the parser's recovery answer.
export function tsToName(ix: i32): string {
  if ix < 0 { return "" }
  const k = tsKind[ix]
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  if k == TS_NAME { return tsText[ix] }
  if k == TS_LITSTR { return tsText[ix] }
  if k == TS_LITNUM { return tsText[ix] }
  if k == TS_NULL { return "null" }
  if k == TS_ERR { return "" }
  if k == TS_ARR {
    // A read-only list view marks the `[]` node it binds, so the marker rides that suffix
    // and an inner array keeps its own spelling.
    if tsText[ix] == "readonly" {
      return "readonly " + tsToName(tsKids[start]) + "[]"
    }
    return tsToName(tsKids[start]) + "[]"
  }
  if k == TS_NEG { return "!" + tsToName(tsKids[start]) }
  if k == TS_MAP {
    return "{[" + tsText[ix] + "]:" + tsToName(tsKids[start]) + "}"
  }
  if k == TS_FIELD { return tsText[ix] + ":" + tsToName(tsKids[start]) }
  if (
    k == TS_APP
    || k == TS_PAREN
    || k == TS_OBJ
    || k == TS_FUNC
    || k == TS_METHOD
  ) {
    // The comma-joined child list. `TS_FUNC` and `TS_METHOD` hold their result as
    // the last kid (`parseTypeAtom` / `parseMethodMemberTail`'s contract), so the
    // join stops one short of it.
    let last = cnt
    if k == TS_FUNC || k == TS_METHOD { last = cnt - 1 }
    let inner = ""
    let i = 0
    while i < last {
      if i > 0 { inner = inner + "," }
      inner = inner + tsToName(tsKids[start + i])
      i = i + 1
    }
    if k == TS_APP { return tsText[ix] + "<" + inner + ">" }
    if k == TS_PAREN { return "(" + inner + ")" }
    if k == TS_OBJ { return "{" + inner + "}" }
    if k == TS_METHOD {
      return tsText[ix] + "(" + inner + "):" + tsToName(tsKids[start + cnt - 1])
    }
    return "(" + inner + ")=>" + tsToName(tsKids[start + cnt - 1])
  }
  // `TS_UNION` / `TS_ISECT` — the members joined by their own separator.
  let sep = "|"
  if k == TS_ISECT { sep = "&" }
  let out = ""
  let i = 0
  while i < cnt {
    if i > 0 { out = out + sep }
    out = out + tsToName(tsKids[start + i])
    i = i + 1
  }
  out
}

// Does the spelling tree rooted at `ix` contain a node of kind `kind` anywhere? The
// structural form of "the rendered name contains `=>`" and its siblings — a whole-tree
// question, where `tsMentionsAnyName` asks a whole-leaf one.
export function tsHasKind(ix: i32, kind: i32): boolean {
  if ix < 0 || ix >= tsKind.length { return false }
  if tsKind[ix] == kind { return true }
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  let j = 0
  while j < cnt {
    if tsHasKind(tsKids[start + j], kind) { return true }
    j = j + 1
  }
  false
}

// Does the spelling tree rooted at `ix` name any of `names`? It walks the structure
// `resolveAnnotTs` resolves against, so it answers about the annotation the author wrote
// rather than a synthetic name string: `T`, `T[]`, `Box<T>` and `{a: T}` all mention `T`,
// while `Trace` does not (a leaf is compared whole). The `TS_APP` head is compared too.
export function tsMentionsAnyName(ix: i32, names: string[]) {
  if ix < 0 || ix >= tsKind.length || names.length == 0 { return false }
  const k = tsKind[ix]
  if k == TS_NAME || k == TS_APP {
    let i = 0
    while i < names.length {
      if names[i] == tsText[ix] { return true }
      i = i + 1
    }
  }
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  let j = 0
  while j < cnt {
    if tsMentionsAnyName(tsKids[start + j], names) { return true }
    j = j + 1
  }
  false
}

// ── Arena constructors ───────────────────────────────────────────────────────
// Each appends its variant to `P.nodes` and returns the new node's index. Every
// constructor takes `pos` — the char offset of the construct's start token, captured at
// parse entry before the children parse, or `-1` for a synthesized node.

export function addNode(n: Node) {
  P.nodes.push(n)
  let tk = P.pos - 1
  if tk < 0 { tk = 0 }
  nodeToks.push(tk)
  P.nodes.length - 1
}

export function mkNum(text: string, pos: i32) {
  const n: Node = { numText: text, pos: pos }
  addNode(n)
}

export function mkStr(text: string, pos: i32) {
  const n: Node = { strText: text, pos: pos }
  addNode(n)
}

export function mkChar(text: string, pos: i32) {
  const n: Node = { charText: text, pos: pos }
  addNode(n)
}

export function mkBool(v: i32, pos: i32) {
  const n: Node = { boolVal: v, pos: pos }
  addNode(n)
}

export function mkNull(kw: string, pos: i32) {
  const n: Node = { nullKw: kw, pos: pos }
  addNode(n)
}

export function mkIdent(name: string, pos: i32) {
  const n: Node = { identName: name, pos: pos }
  addNode(n)
}

export function mkUnary(op: string, arg: i32, pos: i32) {
  const n: Node = { unOp: op, unArg: arg, pos: pos }
  addNode(n)
}

export function mkBinary(op: string, left: i32, right: i32, pos: i32) {
  const n: Node = {
    binOp: op,
    binLeft: left,
    binRight: right,
    pos: pos,
    binCompound: "",
    binTpl: 0,
    binRegion: 0,
  }
  addNode(n)
}

// The identifier a template hole's desugared call names. It is deliberately unspellable —
// `$` is not an identifier character — so no user program can declare, shadow or reference
// it, which is what makes a template's meaning independent of the author's imports. The
// merge rewrites it to `toStr$mN` through an ordinary rename row.
export const TPL_RENDER_LOCAL = "$tpl$render"

// The root `+` of a template literal's concatenation — `mkBinary` plus the
// faithful-surface marker the printer reads (see `BinExpr.binTpl`).
export function mkTplConcat(left: i32, right: i32, pos: i32) {
  const n: Node = {
    binOp: "+",
    binLeft: left,
    binRight: right,
    pos: pos,
    binCompound: "",
    binTpl: 1,
    binRegion: 0,
  }
  addNode(n)
}

// Parallel to `P.nodes`, grown lazily, bounds-checked on read — `nodeToks`' contract. `1`
// marks a node that is a template hole's expression. A side table and not a node kind
// because the hole is an ordinary expression: the single consumer is the checker's
// argument-mismatch report, and the mark has to survive the merge's identifier rewrite.
export let tplHole: i32[] = []

// Mark `nodeIx` as a template hole's expression. Bounds-guarded on the write as well as
// the read: every caller passes a constructor's result and so cannot pass a negative, but
// a `tplHole[-1] = 1` would trap inside the compiler with no diagnostic and no position.
export function mkTplHole(nodeIx: i32) {
  if nodeIx < 0 { return 0 }
  while tplHole.length <= nodeIx { tplHole.push(0) }
  tplHole[nodeIx] = 1
  0
}

// True when `nodeIx` is the expression of a `${…}` hole.
export function nodeIsTplHole(nodeIx: i32) {
  if nodeIx < 0 || nodeIx >= tplHole.length { return false }
  tplHole[nodeIx] == 1
}

// A record type naming a field twice, as (repeat, first) pairs of inert `ErrExpr` anchors on
// the two field-name tokens, in parse order. Truncated and reset with `tplHole`; the checker's
// duplicate-field refusal is the one reader.
export let recDupField: i32[] = []

// Record that the field named at anchor `dupIx` repeats the one at anchor `firstIx`.
export function mkRecDupField(dupIx: i32, firstIx: i32) {
  if dupIx < 0 || firstIx < 0 { return 0 }
  recDupField.push(dupIx)
  recDupField.push(firstIx)
  0
}

// Parallel to `P.nodes` on `tplHole`'s contract. `1` marks a `Call` whose trailing arguments
// have already been packed into the list its callee's rest parameter takes. The mark is what
// makes `restCallPack` idempotent: a packed call's arity already equals its parameter count,
// so nothing about the argument list itself distinguishes it from an unpacked one.
export let callRestPacked: i32[] = []

export function markCallRestPacked(nodeIx: i32) {
  if nodeIx < 0 { return 0 }
  while callRestPacked.length <= nodeIx { callRestPacked.push(0) }
  callRestPacked[nodeIx] = 1
  0
}

// True when `nodeIx` is a call whose trailing arguments are already packed.
export function callIsRestPacked(nodeIx: i32) {
  if nodeIx < 0 || nodeIx >= callRestPacked.length { return false }
  callRestPacked[nodeIx] == 1
}

// Parallel to `P.nodes` on `tplHole`'s contract. `1` marks a `Call` whose type is `never` — it
// cannot return, so `stmtAlwaysExits` ends a path at it (D1972). The checker marks from the call's
// type; a lint run on a bare parse marks by declaration instead (`markNeverCallsByDecl`).
export let callNever: i32[] = []

export function markCallNever(nodeIx: i32) {
  if nodeIx < 0 { return 0 }
  while callNever.length <= nodeIx { callNever.push(0) }
  callNever[nodeIx] = 1
  0
}

// True when `nodeIx` is a call that never returns.
export function callIsNever(nodeIx: i32) {
  if nodeIx < 0 || nodeIx >= callNever.length { return false }
  callNever[nodeIx] == 1
}

// The parse-only producer of `callNever`, for a lint pass with no checker behind it: a call to
// `__trap__`, or by bare name to a function this parse declares `: never` and binds nowhere
// else — a parameter, local or other function of that name anywhere in the file drops it, so
// a shadowing callback never reads as a terminator. Marks a subset of the checker's answer.
export function markNeverCallsByDecl() {
  const names: string[] = ["__trap__"]
  let i = 0
  while i < P.nodes.length {
    const nv = neverFnNameAt(i)
    if nv != "" { names.push(nv) }
    i = i + 1
  }
  // The other binders are read only for a declared `never` name, so a parse with none skips them.
  const others: string[] = []
  let k = 0
  while names.length > 1 && k < P.nodes.length {
    if neverFnNameAt(k) == "" {
      const b = binderNameAt(k)
      if b != "" { others.push(b) }
    }
    k = k + 1
  }
  let j = 0
  while j < P.nodes.length {
    const callee = identCalleeAt(j)
    if callee != "" && strListHas(names, callee) {
      if callee == "__trap__" || !strListHas(others, callee) {
        markCallNever(j)
      }
    }
    j = j + 1
  }
  0
}

// The name of the function declared `: never` at `ix`, or "".
function neverFnNameAt(ix: i32) {
  const d = nodeAt(ix)
  if d is FuncDecl {
    if d.fnName != "" && d.fnRet >= 0 {
      const r = nodeAt(d.fnRet)
      if r is TypeRef {
        if r.tyName == "never" { return d.fnName }
      }
    }
  }
  ""
}

// The name bound at `ix` by a parameter, a `let`/`const` or a function, or "".
export function binderNameAt(ix: i32) {
  const pn = paramNameAt(ix)
  if pn != "" { return pn }
  const ln = letNameAt(ix)
  if ln != "" { return ln }
  const vn = loopVarName(ix)
  if vn != "" { return vn }
  fnDeclNameAt(ix)
}

function paramNameAt(ix: i32) {
  const d = nodeAt(ix)
  if d is Param { return d.parName }
  ""
}

function letNameAt(ix: i32) {
  const d = nodeAt(ix)
  if d is LetDecl { return d.letName }
  ""
}

function fnDeclNameAt(ix: i32) {
  const d = nodeAt(ix)
  if d is FuncDecl { return d.fnName }
  ""
}

// The callee name of a call by bare identifier at `ix`, or "".
function identCalleeAt(ix: i32) {
  const c = nodeAt(ix)
  if c is Call {
    if c.callFn < 0 { return "" }
    const callee = nodeAt(c.callFn)
    if callee is Ident { return callee.identName }
  }
  ""
}

// A compound assignment `target op= value`, desugared to `target = (target op
// value)` for typecheck/emit but tagged with the SURFACE operator (`binCompound`)
// so the printer reprints `target op= value`. The target node is shared between
// the read (inner arith) and the write (outer `=`) — arena reads are pure.
export function mkCompoundAssign(
  op: string,
  target: i32,
  value: i32,
  pos: i32,
) {
  const inner = mkBinary(op, target, value, pos)
  const n: Node = {
    binOp: "=",
    binLeft: target,
    binRight: inner,
    pos: pos,
    binCompound: op,
    binTpl: 0,
    binRegion: 0,
  }
  addNode(n)
}

// A prefix increment `++target` / `--target` (`incr` is `"++"`/`"--"`), desugared
// to `target = (target ± 1)` — yielding the new value, the prefix semantics — and
// tagged on `binCompound` with the surface `++`/`--` so the printer reprints the
// prefix form (postfix `x++` rides a `Unary "p+"` instead; see the parser).
export function mkPreIncr(incr: string, target: i32, pos: i32) {
  let op = "+"
  if incr == "--" { op = "-" }
  const inner = mkBinary(op, target, mkNum("1", -1), pos)
  const n: Node = {
    binOp: "=",
    binLeft: target,
    binRight: inner,
    pos: pos,
    binCompound: incr,
    binTpl: 0,
    binRegion: 0,
  }
  addNode(n)
}

export function mkCall(fn: i32, args: i32[], pos: i32) {
  // All-positional (the synthesizers' constructor): an empty names list.
  const names: string[] = []
  mkCallN(fn, args, names, pos)
}

// A call with per-argument names (parallel to `args`; "" = positional) — the
// parser's constructor for argument lists that may carry `name: value` entries.
export function mkCallN(fn: i32, args: i32[], names: string[], pos: i32) {
  const n: Node = { callFn: fn, callArgs: args, callArgNames: names, pos: pos }
  addNode(n)
}

// True iff any per-argument name is present (a non-"" entry) — the cheap gate
// every consumer checks before paying for `orderArgsByParamNames`.
export function hasNamedArgs(names: string[]) {
  let i = 0
  while i < names.length {
    if names[i] != "" { return true }
    i = i + 1
  }
  false
}

// UFCS resolution across the module merge. A member call `recv.prop(args)` whose `prop`
// names a free `self`-function keeps `prop` plain on its `Member`, so a struct callable
// field of the same name keeps precedence. The merge mangles such functions, so the merged
// name is recovered where UFCS resolves, after the field check. Empty in single-file mode.

// D1120 — the plain name is not a key: two merged modules may each export a `self`-function
// called `area`, so the answer is banked per call site in `ufcsSiteTo[callIx]`. Node indices
// are stable from the merge walk through `checkProgram` and `emitProgram`, which is what
// lets three consumers in two phases read one answer.

// D1191 — and the plain name is not a scope either: a global name-keyed map let a module's
// own un-exported `self`-function answer another module's call. The rule is the direct
// call's rule, that a UFCS candidate must be a name the caller binds. `ufcsScope*` is that
// scope, one row per (module, plain name); `ufcsModBound` maps a node back to its module.
export let ufcsSiteTo: string[] = []
let ufcsScopeMod: i32[] = []
let ufcsScopeFrom: string[] = []
let ufcsScopeTo: string[] = []
// Parallel to the scope rows: whether module `m` EXPORTS this `self`-function. The
// caller-scope reader ignores it (a module reaches its own private methods); the
// type-bound reader gates on it, so a foreign call sees only the public surface.
let ufcsScopeExp: boolean[] = []
let ufcsModBound: i32[] = []
let ufcsModIx: i32[] = []
// The rung member call `callIx` resolved through: the checker banks `MC_RUNG_BUILTIN` or
// `MC_RUNG_SELF_FN` (0 for none) so the emitter's rewrite cannot pick the other (D2476); the
// rewrite's `MC_RUNG_PER_INSTANCE` leaves a type-parameter receiver's call to each instance.
// `MC_RUNG_FIELD` is never banked: only `memberRungOnTy` answers it.
export const MC_RUNG_BUILTIN = 1
export const MC_RUNG_SELF_FN = 2
export const MC_RUNG_FIELD = 3
export const MC_RUNG_PER_INSTANCE = 4
let memberCallRung: i32[] = []
export function memberCallRungAdd(callIx: i32, rung: i32) {
  if callIx < 0 { return 0 }
  while memberCallRung.length <= callIx { memberCallRung.push(0) }
  // The rewrite's mark outlives a later re-check of the template at one instance's types.
  if memberCallRung[callIx] == MC_RUNG_PER_INSTANCE { return 0 }
  memberCallRung[callIx] = rung
  0
}
// A copied call that banked no rung of its own answers its original's (D4030).
export function memberCallRungOf(callIx: i32) {
  if callIx >= 0 && callIx < memberCallRung.length {
    if memberCallRung[callIx] != 0 { return memberCallRung[callIx] }
  }
  const at = ufcsSiteRoot(callIx)
  if at != callIx && at >= 0 && at < memberCallRung.length {
    return memberCallRung[at]
  }
  0
}
export function ufcsAliasReset() {
  memberCallRung = []
  ufcsSiteTo = []
  ufcsSiteFrom = []
  ufcsScopeMod = []
  ufcsScopeFrom = []
  ufcsScopeTo = []
  ufcsScopeExp = []
  ufcsModBound = []
  ufcsModIx = []
  ovReset()
  0
}
// Bank the mangled self-function the UFCS member-call node `callIx` resolves to.
export function ufcsSiteAdd(callIx: i32, mangled: string) {
  if callIx < 0 { return 0 }
  while ufcsSiteTo.length <= callIx { ufcsSiteTo.push("") }
  ufcsSiteTo[callIx] = mangled
  0
}
// The per-site answer for the call at `callIx`, or "" when the walk banked none.
function ufcsSiteOf(callIx: i32) {
  if callIx >= 0 && callIx < ufcsSiteTo.length { return ufcsSiteTo[callIx] }
  ""
}
// The spelling member call `callIx`'s property takes where the call stands: the merged name the
// merge walk (or a checker pick) banked on the site, else the property `plain` as written.
export function ufcsSpellingAt(callIx: i32, plain: string) {
  const site = ufcsSiteOf(ufcsSiteRoot(callIx))
  if site != "" { return site }
  plain
}
// A call node minted as a copy of another, mapped to the node it copies, or -1. A copy is the
// same call site, so it resolves as the merge-walked original does (D4030).
let ufcsSiteFrom: i32[] = []
// Record that call `to` copies call `from`; returns `to`.
export function ufcsSiteCarry(to: i32, from: i32) {
  if to < 0 || from < 0 || to == from { return to }
  while ufcsSiteFrom.length <= to { ufcsSiteFrom.push(-1) }
  ufcsSiteFrom[to] = from
  to
}
// The merge-walked node call `callIx` copies, or `callIx` itself.
export function ufcsSiteRoot(callIx: i32) {
  let at = callIx
  while at >= 0 && at < ufcsSiteFrom.length && ufcsSiteFrom[at] >= 0 {
    at = ufcsSiteFrom[at]
  }
  at
}
// Module `m` binds plain `plain` to the merged `self`-function `mangled` — one
// row per name in that module's scope, declaration or import (alias included).
// `exp` is whether `m` exports `plain`, read only by the type-bound reader.
export function ufcsScopeAdd(
  m: i32,
  plain: string,
  mangled: string,
  exp: boolean,
) {
  ufcsScopeMod.push(m)
  ufcsScopeFrom.push(plain)
  ufcsScopeTo.push(mangled)
  ufcsScopeExp.push(exp)
  0
}
// The merged `self`-function module `m` binds `plain` to, or "" when it binds
// none — the UFCS half of "is this name in scope here".
function ufcsScopeIn(m: i32, plain: string) {
  let i = 0
  while i < ufcsScopeFrom.length {
    if ufcsScopeMod[i] == m && ufcsScopeFrom[i] == plain {
      return ufcsScopeTo[i]
    }
    i = i + 1
  }
  ""
}
// Mark in `out` every plain name some module's UFCS scope binds to a function in `targets`.
export function ufcsPlainsOfInto(
  targets: {[string]: boolean},
  out: {[string]: boolean},
) {
  let i = 0
  while i < ufcsScopeTo.length {
    if targets.has(ufcsScopeTo[i]) { out[ufcsScopeFrom[i]] = true }
    i = i + 1
  }
  0
}
// The merged `self`-function module `m` EXPORTS under `plain`, or "" — the type-bound
// reader's key (§C). Gated on the export flag so a foreign `x.m(…)` reaches only `m`'s
// public surface, never an un-exported method (the D1191 boundary, cross-module).
export function ufcsExportedScopeIn(m: i32, plain: string) {
  let i = 0
  while i < ufcsScopeFrom.length {
    if ufcsScopeMod[i] == m && ufcsScopeFrom[i] == plain && ufcsScopeExp[i] {
      return ufcsScopeTo[i]
    }
    i = i + 1
  }
  ""
}
// Record module `m`'s highest arena node (its `Program` root, minted last). Pushed
// in merge-walk order, so the bounds ascend and `ufcsModOfNode` is one scan.
export function ufcsModBoundAdd(m: i32, rootIx: i32) {
  ufcsModIx.push(m)
  ufcsModBound.push(rootIx)
  0
}
// The module owning arena node `ix`, or -1 when no merge ran (a single file) or the node
// is minted after parsing (a desugar's fresh node, past every root). -1 means "no scope to
// check", which the readers below spell as the plain name.
export function ufcsModOfNode(ix: i32) {
  let i = 0
  while i < ufcsModBound.length {
    if ix <= ufcsModBound[i] { return ufcsModIx[i] }
    i = i + 1
  }
  -1
}
// The merged `self`-function plain `name` resolves to in the scope of the module
// owning node `nodeIx` — the reader for a question asked away from a call site
// (`witnessOf` judges a bound before any call exists). Identity when that module
// binds no such name, so the ordinary `no field` refusal follows.
export function ufcsAliasInScope(nodeIx: i32, name: string) {
  const m = ufcsModOfNode(nodeIx)
  if m < 0 { return name }
  const t = ufcsScopeIn(m, name)
  if t != "" { return t }
  name
}
// The mangled self-function the UFCS member call at `callIx` resolves to: that site's own
// answer when the merge walk banked one (D1120), else the caller's module scope. The one
// entry point for the three consumers that hold a call node, so the checker and the emitter
// cannot pick different modules' functions for one call.
export function ufcsAliasAtSite(callIx: i32, name: string) {
  const at = ufcsSiteRoot(callIx)
  const site = ufcsSiteOf(at)
  if site != "" { return site }
  ufcsAliasInScope(at, name)
}

// Receiver overloading (owner ruling O1, `docs/internals/receiver-overloading.md`): a module
// may bind one plain name to several functions whose first parameters' head classes are
// pairwise disjoint. One set per (module, name), the local declaration first; a member call
// that must choose names its set, and the chosen candidate is banked through `ufcsSiteAdd`.
export let ovSetMod: i32[] = []
export let ovSetName: string[] = []
export let ovSetCands: string[][] = []
// How the module names each candidate's module: its import specifier, "" for its own.
export let ovSetSpecs: string[][] = []
// A set the merge refused (two candidates overlap); its sites stay unresolved.
export let ovSetBad: boolean[] = []
let ovSiteRow: {[i32]: i32} = Map()
// Plain calls the local declaration answers while the set has imported candidates too.
let ovPlainRow: {[i32]: i32} = Map()
// The head class of every merged function's first parameter (`ovHeadsOverlap`).
export let ovFnHead: {[string]: string} = Map()
// Per monomorphized instance, the candidate a generic body's member call took there.
export let ovInstSite: i32[] = []
export let ovInstRecv: string[] = []
export let ovInstPick: string[] = []

export function ovReset() {
  ovSetMod = []
  ovSetName = []
  ovSetCands = []
  ovSetSpecs = []
  ovSetBad = []
  ovSiteRow = Map()
  ovPlainRow = Map()
  ovFnHead = Map()
  ovInstSite = []
  ovInstRecv = []
  ovInstPick = []
  0
}

export function ovSetAdd(
  m: i32,
  name: string,
  cands: string[],
  specs: string[],
) {
  ovSetMod.push(m)
  ovSetName.push(name)
  ovSetCands.push(cands)
  ovSetSpecs.push(specs)
  ovSetBad.push(false)
  ovSetMod.length - 1
}

// The set module `m` binds `name` to, or -1 when it binds one function or none.
export function ovSetOf(m: i32, name: string) {
  let i = 0
  while i < ovSetMod.length {
    if ovSetMod[i] == m && ovSetName[i] == name { return i }
    i = i + 1
  }
  -1
}

export function ovSiteAdd(callIx: i32, row: i32) {
  ovSiteRow[callIx] = row
  0
}

// The set member call `callIx` must choose from, or -1.
export function ovSiteSetOf(callIx: i32) {
  if ovSetMod.length == 0 { return -1 }
  // A copied call that banked no set of its own answers its original's (D4030).
  const row = ovSiteRow[callIx] ?? ovSiteRow[ufcsSiteRoot(callIx)] ?? -1
  if row < 0 || ovSetBad[row] { return -1 }
  row
}

export function ovPlainAdd(callIx: i32, row: i32) {
  ovPlainRow[callIx] = row
  0
}

// The set whose local declaration plain call `callIx` reached, or -1.
export function ovPlainSetOf(callIx: i32) {
  if ovSetMod.length == 0 { return -1 }
  ovPlainRow[callIx] ?? -1
}

// Whether two head classes can both take one receiver: equal classes overlap, and an open
// first parameter (`any`: a bare type parameter, a hole, a union) overlaps every class.
export function ovHeadsOverlap(a: string, b: string) {
  a == b || a == "any" || b == "any"
}

// The head class of a primitive type name, "" for any other name. The one classifier both the
// merge (first-parameter spellings) and the checker (receiver types) ask.
const OV_PRIM_NAMES = [
  "string", "boolean", "i32", "i64", "f32", "f64", "u8", "u32", "u64",
]
const OV_PRIM_CLASSES = [
  "str", "bool", "num", "num", "num", "num", "num", "num", "num",
]
export function ovPrimClass(name: string) {
  let i = 0
  while i < OV_PRIM_NAMES.length {
    if OV_PRIM_NAMES[i] == name { return OV_PRIM_CLASSES[i] }
    i = i + 1
  }
  ""
}

// A head class as a diagnostic phrases it.
export function ovHeadText(key: string) {
  if key == "none" { return "no parameters" }
  if key == "any" {
    return "an open first parameter, which overlaps every kind"
  }
  if key == "str" { return "a `string` first" }
  if key == "arr" { return "a list first" }
  if key == "map" { return "a `Map` first" }
  if key == "set" { return "a `Set` first" }
  if key == "bool" { return "a `boolean` first" }
  if key == "num" { return "a number first" }
  if key == "fn" { return "a function first" }
  if key.length > 4 && key.slice(0, 4) == "rec:" {
    return "`" + ovDemangle(key.slice(4, key.length)) + "` first"
  }
  "an open first parameter, which overlaps every kind"
}

// `name$m3` → `name`: a merged name as its author spelled it.
export function ovDemangle(nm: string) {
  let i = 0
  while i + 1 < nm.length {
    if nm[i] == '$' && nm[i + 1] == 'm' { return nm.slice(0, i) }
    i = i + 1
  }
  nm
}

// One candidate of set `row` as a diagnostic names it: its module and its head.
export function ovCandText(row: i32, k: i32) {
  const fnm = ovSetCands[row][k]
  let from = "the local `" + ovSetName[row] + "`"
  const sp = ovSetSpecs[row][k]
  if sp != "" { from = "`" + ovSetName[row] + "` from \"" + sp + "\"" }
  from + " (" + ovHeadText(ovFnHead[fnm] ?? "any") + ")"
}

// Every candidate of set `row`, joined for a sentence.
export function ovCandsText(row: i32) {
  let out = ""
  let k = 0
  const last = ovSetCands[row].length - 1
  while k <= last {
    if k > 0 && k == last { out = out + " and " }
    else if k > 0 { out = out + ", " }
    out = out + ovCandText(row, k)
    k = k + 1
  }
  out
}

// UFCS candidates the entry file has not imported (D1230's diagnostic). UFCS is explicit:
// `toEqual` resolves only against names in scope, so the program is illegal — but the one
// thing the compiler knows and does not say is that `toEqual` sits in a module the file
// already names. A row is a candidate, not a verdict; `ufcsWouldDispatch` decides per call.
export let ufcsImpName: string[] = []    // the plain source name (`toEqual`)
export let ufcsImpMangled: string[] = [] // the merged name (`toEqual$m1`)
export let ufcsImpSpec: string[] = []    // how the ENTRY names that module (`std:test`)
// Whether the entry's OWN imports already name `ufcsImpSpec[i]`'s module (some other
// name from it), so D1230's sentence can say "add to the existing import" rather than
// "add an import" — the same fact `modUfcsSpecFromEntry` decided, carried alongside.
let ufcsImpAlready: boolean[] = []
export function ufcsImpReset() {
  ufcsImpName = []
  ufcsImpMangled = []
  ufcsImpSpec = []
  ufcsImpAlready = []
  0
}
export function ufcsImpAdd(
  plain: string,
  mangled: string,
  spec: string,
  already: boolean,
) {
  let i = 0
  while i < ufcsImpName.length {
    if ufcsImpName[i] == plain && ufcsImpMangled[i] == mangled { return 0 }
    i = i + 1
  }
  ufcsImpName.push(plain)
  ufcsImpMangled.push(mangled)
  ufcsImpSpec.push(spec)
  ufcsImpAlready.push(already)
  0
}

// Whether `spec` (one of `ufcsMissingImportSpecs`' candidates) is a module the entry
// already imports something from — the lookup `ufcsNotImportedMsg` needs to phrase
// D1230's closing clause as an edit to an existing import rather than a new one.
export function ufcsSpecAlreadyImported(spec: string): boolean {
  let i = 0
  while i < ufcsImpSpec.length {
    if ufcsImpSpec[i] == spec { return ufcsImpAlready[i] }
    i = i + 1
  }
  false
}

// Free index-operator declaration names. `function "[]"(self: T, i: I)` and `"[]="` are
// free functions whose name is an operator, so a program may declare one per receiver type,
// while every name-keyed table holds one entry per name — so the parser mints
// `[]@F32View`. The `@` cannot occur in an identifier, which makes the encoding total.
export const OP_INDEX_GET = "[]"
export const OP_INDEX_SET = "[]="

// The operator names whose dispatch is binary: the quoted-function-name set minus the two
// bracket operators, whose arity is the index rule's and is checked at the hoist, and minus
// `==`/`!=`, which `parseFuncHead` refuses by name (D46). Here rather than in `parser.vl`
// because three declaration-site gates read it and none may drift from the others.
export function isBinOpFuncName(name: string) {
  name == "+"
    || name == "-"
    || name == "*"
    || name == "/"
    || name == "%"
    || name == "^"
    || name == ">"
    || name == ">="
    || name == "<"
    || name == "<="
}

// The declaration name for operator `op` on a receiver spelled `recv`.
export function opDeclName(op: string, recv: string): string { op + "@" + recv }

// The offset of the `@` separator in `name`, or -1 when it carries none.
function opDeclAt(name: string): i32 {
  let i = 0
  while i < name.length {
    if name[i] == '@' { return i }
    i = i + 1
  }
  -1
}

// The index operator a declaration name implements, or "" when `name` is an ordinary
// function's. Total over merge-mangled names (the `$mN` rides in the receiver half) and
// over every identifier, since no identifier contains `@`.
export function opDeclOpOf(name: string): string {
  const at = opDeclAt(name)
  if at < 0 { return "" }
  const op = name.slice(0, at)
  if op == OP_INDEX_GET { return op }
  if op == OP_INDEX_SET { return op }
  // A binary operator declaration is receiver-keyed the same way (`+@Vec3`), so several
  // may coexist — one per receiver type — the way `[]`/`[]=` already do (B14, generalized).
  if isBinOpFuncName(op) { return op }
  ""
}

// Whether a declaration NAME is a binary operator — the bare symbol (`+`) or the
// receiver-keyed form (`+@Vec3`). The one test to use where a decl's name may already
// carry its receiver; `isBinOpFuncName` alone sees only the bare spelling.
export function isBinOpDecl(name: string): boolean {
  if isBinOpFuncName(name) { return true }
  isBinOpFuncName(opDeclOpOf(name))
}

// The receiver-spelling half of an operator declaration name (with any `$mN`
// the merge appended), or "" for an ordinary name.
function opDeclRecvOf(name: string): string {
  if opDeclOpOf(name) == "" { return "" }
  const recv = name.slice(opDeclAt(name) + 1, name.length)
  recv
}

// How an operator declaration reads back to a user: `"[]" for F32View`. Every
// diagnostic that would otherwise print the minted name routes through this, so
// the `@` encoding never reaches a message. An ordinary name is returned as-is.
export function opDeclLabel(name: string): string {
  const op = opDeclOpOf(name)
  if op == "" { return name }
  "\"" + op + "\" for " + opDeclRecvOf(name)
}

// The message spelling for a declaration name that may be a binary operator: the bare symbol
// (`+`), so a diagnostic naming one reads the same regardless of receiver keying. An index
// operator keeps the receiver-qualified `opDeclLabel` form (`"[]" for V`).
export function opDeclLabelBin(name: string): string {
  const op = opDeclOpOf(name)
  if op == "" { return name }
  if op == OP_INDEX_GET { return opDeclLabel(name) }
  if op == OP_INDEX_SET { return opDeclLabel(name) }
  op
}

// A getter's declaration name: `get x(self: F32x4)` mints `F32x4.x`, which is also how a trap
// backtrace names it. `.` opens no identifier, so no source spelling can name a getter: it is
// reached only through its receiver's type, never lexically (property-access-design.md §D3a).
export function getDeclName(prop: string, recv: string): string {
  recv + "." + prop
}

// The offset of the `.` separating a getter name's receiver from its property, or -1. A type
// spelling holds no `.`, and no other declaration name holds one at all.
function getDeclDot(name: string): i32 {
  let i = name.length - 1
  while i >= 0 {
    if name[i] == '.' { return i }
    i = i - 1
  }
  -1
}

// The property a getter declaration name implements, or "" for any other name. Total over
// merge-mangled names, whose `$mN` rides after the property.
export function getDeclPropOf(name: string): string {
  const dot = getDeclDot(name)
  if dot <= 0 { return "" }
  let prop = name.slice(dot + 1, name.length)
  const dollar = prop.indexOf("$")
  if dollar >= 0 { prop = prop.slice(0, dollar) }
  prop
}

// How a getter declaration name reads back to a user (`getter` + the property + `on F32x4`),
// the merge suffix dropped. An ordinary name is returned as-is.
export function getDeclLabel(name: string): string {
  const prop = getDeclPropOf(name)
  if prop == "" { return name }
  "getter `" + prop + "` on " + name.slice(0, getDeclDot(name))
}

// The getter declarations the parser saw, by `FuncDecl` node, and whether each is spelled
// `export get`. The parser drops `export`, so this is the only record of a getter's visibility.
let getDeclNodes: i32[] = []
let getDeclExps: boolean[] = []

export function getDeclAdd(fnIx: i32, exported: boolean) {
  getDeclNodes.push(fnIx)
  getDeclExps.push(exported)
  0
}

// Whether the getter declared at `fnIx` is exported; false for a node the parser never recorded.
export function getDeclExported(fnIx: i32): boolean {
  let i = 0
  while i < getDeclNodes.length {
    if getDeclNodes[i] == fnIx { return getDeclExps[i] }
    i = i + 1
  }
  false
}

// The `export function`/`let`/`const` declarations the parser saw, by node: the parser drops
// the keyword, and a caller in another module or the host may consume what one returns.
let exportDeclNodes: {[i32]: boolean} = Map()
// The same nodes in add order, so a bank reads a module's rows off this list rather than
// probing the map at every node of its range.
let exportDeclOrder: i32[] = []

export function exportDeclAdd(ix: i32) {
  exportDeclNodes[ix] = true
  exportDeclOrder.push(ix)
  ix
}

export function declExported(ix: i32): boolean { exportDeclNodes[ix] ?? false }

// The `if` and `match` nodes the parser met in expression position, by node: the only places
// an if-expression can sit outside a statement list, which the emitter scans for arm locals
// instead of the whole arena (D2785). A `match` is recorded at the node its desugar replaces.
export let valueIfNodes: i32[] = []

export function valueIfAdd(ix: i32) {
  valueIfNodes.push(ix)
  ix
}

// Take back the record of an expression statement that is itself the `if` or `match`: it
// stands in a statement list, where the statement walk reaches it.
export function valueIfDrop(ix: i32) {
  const n = valueIfNodes.length
  if n > 0 && valueIfNodes[n - 1] == ix { valueIfNodes.pop() }
  ix
}

// Per-compile reset, paired with `externReset`.
export function getDeclReset() {
  getDeclNodes = []
  getDeclExps = []
  exportDeclNodes = Map()
  exportDeclOrder = []
  valueIfNodes = []
  brkValSeen = false
  lblBlkSeen = false
  0
}

// The name a caller writes for parameter `nm`: a parameter named like an ambient function is
// renamed apart by the merge (`name$m<k>`), and its label stays the declared name.
export function paramLabel(nm: string): string {
  let i = nm.length - 1
  while i >= 0 && nm[i] >= '0' && nm[i] <= '9' { i = i - 1 }
  if i >= 1 && i < nm.length - 1 && nm[i] == 'm' && nm[i - 1] == '$' {
    return nm.slice(0, i - 1)
  }
  nm
}

// Bind call arguments to parameter slots by name, then positionally — the single source of
// truth shared by the checker and the emitter. Returns one value-node index per parameter
// in parameter order (-1 where no argument filled the slot), followed by any leftover
// arguments in source order, so nothing is silently dropped. Callers diagnose the errors.
export function orderArgsByParamNames(
  paramNames: string[],
  args: i32[],
  argNames: string[],
) {
  const slots: i32[] = []
  let i = 0
  while i < paramNames.length {
    slots.push(-1)
    i = i + 1
  }
  const leftover: i32[] = []
  const positional: i32[] = []
  // First place named arguments by parameter name.
  let j = 0
  while j < args.length {
    let nm = ""
    if j < argNames.length { nm = argNames[j] }
    if nm == "" {
      positional.push(args[j])
    } else {
      let pIx = -1
      let k = 0
      while k < paramNames.length {
        if pIx < 0 && paramLabel(paramNames[k]) == nm { pIx = k }
        k = k + 1
      }
      if pIx < 0 || slots[pIx] >= 0 {
        // Unknown name, or a slot already filled (named collision): leave it
        // for the caller to diagnose rather than overwriting.
        leftover.push(args[j])
      } else {
        slots[pIx] = args[j]
      }
    }
    j = j + 1
  }
  // Then fill the remaining slots, in order, with positional arguments.
  let nx = 0
  let p = 0
  while p < positional.length {
    while nx < slots.length && slots[nx] >= 0 { nx = nx + 1 }
    if nx < slots.length {
      slots[nx] = positional[p]
      nx = nx + 1
    } else {
      leftover.push(positional[p])
    }
    p = p + 1
  }
  let r = 0
  while r < leftover.length {
    slots.push(leftover[r])
    r = r + 1
  }
  slots
}

export function mkMember(obj: i32, prop: string, pos: i32) {
  const n: Node = { memObj: obj, memProp: prop, pos: pos }
  addNode(n)
}

export function mkIndex(arr: i32, idx: i32, pos: i32) {
  const n: Node = { idxArr: arr, idxIndex: idx, pos: pos }
  addNode(n)
}

export function mkArrayLit(elems: i32[], pos: i32) {
  const n: Node = { arrElems: elems, pos: pos }
  addNode(n)
}

export function mkSpread(arg: i32, pos: i32) {
  const n: Node = { spdArg: arg, pos: pos }
  addNode(n)
}

// Give node `dst` node `src`'s token anchor. A node minted after parsing takes the parser's
// final cursor, which puts a diagnostic over it at the end of the file; the anchor is the
// only thing `nodeStartTok` resolves, so adopting one is the whole of the fix.
export function adoptNodeTok(dst: i32, src: i32) {
  if dst < 0 || dst >= nodeToks.length { return 0 }
  if src < 0 || src >= nodeToks.length { return 0 }
  nodeToks[dst] = nodeToks[src]
  0
}

// The operand of a spread element, or -1 when `ix` is not one — the reader every consumer
// of an argument or element list uses to ask "is this item a spread, and of what".
export function spreadArgOf(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is Spread { return n.spdArg }
  -1
}

// True iff any item in an argument or element list is a spread — the cheap gate a consumer
// checks before paying for the packing path, the shape `hasNamedArgs` already has.
export function hasSpreadItem(items: i32[]) {
  const nodes = P.nodes
  for ix in items {
    if ix >= 0 && ix < nodes.length {
      const n = nodes[ix]
      if n is Spread && n.spdArg >= 0 { return true }
    }
  }
  false
}

export function mkOptMember(obj: i32, prop: string, dot: boolean, pos: i32) {
  const n: Node = { omObj: obj, omProp: prop, omDot: dot, pos: pos }
  addNode(n)
}

export function mkParen(inner: i32, pos: i32) {
  const n: Node = { parInner: inner, pos: pos }
  addNode(n)
}

export function mkErr(what: string, at: i32, pos: i32) {
  const n: Node = { errWhat: what, errAt: at, pos: pos }
  addNode(n)
}

export function mkLet(kw: string, name: string, ty: i32, init: i32, pos: i32) {
  const n: Node = {
    letKw: kw,
    letName: name,
    letType: ty,
    letInit: init,
    pos: pos,
  }
  addNode(n)
}

export function mkParam(
  name: string,
  ty: i32,
  dflt: i32,
  opt: i32,
  rest: i32,
  pos: i32,
) {
  const n: Node = {
    parName: name,
    parType: ty,
    parDefault: dflt,
    parOpt: opt,
    parRest: rest,
    pos: pos,
  }
  addNode(n)
}

// Whether the parameter node `pIx` is the rest parameter `...xs: T[]`. The one reader of
// `parRest` outside the parser and the printer, so a caller never re-narrows the node.
export function paramIsRest(pIx: i32) {
  if pIx < 0 || pIx >= P.nodes.length { return false }
  const p = nodeAt(pIx)
  if p is Param { return p.parRest == 1 }
  false
}

// The index of a parameter list's rest parameter, or -1 when it has none. A rest is last
// by rule (`parseParamList` refuses any other position), so only the tail is asked.
export function restParamIndex(params: i32[]) {
  if params.length == 0 { return -1 }
  if paramIsRest(params[params.length - 1]) { return params.length - 1 }
  -1
}

// The default-value expression of the parameter node `pIx`, or -1 when it has
// none (or `pIx` is not a `Param`). The one reader of `parDefault` outside the
// parser/printer, so a caller never re-narrows the node itself.
export function paramDefaultOf(pIx: i32) {
  if pIx < 0 || pIx >= P.nodes.length { return -1 }
  const p = nodeAt(pIx)
  if p is Param { return p.parDefault }
  -1
}

// Fill every unfilled slot of a parameter-ordered argument list with that parameter's
// default expression, in place; returns the position of the first slot that stays unfilled,
// or -1. The default's node is shared by every call site rather than cloned, exact because
// it carries no per-occurrence state. `__callsite__` is the exception, which `callIx` serves.
export function fillArgDefaults(slots: i32[], dParams: i32[], callIx: i32) {
  let i = 0
  while i < slots.length {
    if slots[i] < 0 {
      let d = -1
      if i < dParams.length { d = paramDefaultOf(dParams[i]) }
      if d < 0 { return i }
      if paramDefaultIsCallsite(d) { d = callSiteLocOf(callIx) }
      if d < 0 { return i }
      slots[i] = d
    }
    i = i + 1
  }
  -1
}

// How many leading arguments a direct call must supply: every parameter up to the first
// one carrying a default. Defaults are trailing-only, so this is the low end of the
// accepted arity range and `params.length` the high end; a list with no defaults answers
// its own length.
export function fnRequiredArity(params: i32[]) {
  let i = 0
  while i < params.length {
    if paramDefaultOf(params[i]) >= 0 { return i }
    i = i + 1
  }
  params.length
}

export function mkTypeRef(name: string, pos: i32) {
  const n: Node = { tyName: name, pos: pos }
  addNode(n)
}

export function mkFunc(
  name: string,
  typarams: string[],
  params: i32[],
  ret: i32,
  body: i32,
  pos: i32,
) {
  const n: Node = {
    fnName: name,
    fnTyParams: typarams,
    fnParams: params,
    fnRet: ret,
    fnBody: body,
    pos: pos,
  }
  const ix = addNode(n)
  funcDeclNodes.push(ix)
  ix
}

// Every `FuncDecl` `mkFunc` has built this compile, in arena order, so a pass that needs the
// lambdas (which sit in expressions) reads them without scanning the arena. Cleared by `tsReset`.
export let funcDeclNodes: i32[] = []

export function mkIf(cond: i32, thenB: i32, els: i32, pos: i32) {
  const n: Node = { ifCond: cond, ifThen: thenB, ifElse: els, pos: pos }
  addNode(n)
}

// The emitter's lowering of the bare `{ … }` statement at `blockIx` (starting at `pos`):
// `if true { … }`, whose `true` shares the `if`'s position — which no parsed `if true` can,
// since its keyword comes first. `isBareBlockIf` reads that tell back.
export function mkBareBlockIf(blockIx: i32, pos: i32) {
  mkIf(mkBool(1, pos), blockIx, -1, pos)
}

// True if the node at `ix` is an `if` minted by `mkBareBlockIf`.
export function isBareBlockIf(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const s = nodeAt(ix)
  if s is IfStmt {
    if s.ifElse >= 0 || s.ifCond < 0 { return false }
    const c = nodeAt(s.ifCond)
    if c is BoolLit { return c.boolVal == 1 && c.pos == s.pos }
  }
  false
}

// Loop constructors take the optional loop label last ("" = unlabelled).
export function mkWhile(
  cond: i32,
  body: i32,
  label: string,
  pos: i32,
  blk: i32,
) {
  if blk == 1 { lblBlkSeen = true }
  const n: Node = {
    whileCond: cond,
    whileBody: body,
    whileLabel: label,
    pos: pos,
    whileBlk: blk,
    whileLv: -1,
  }
  addNode(n)
}

// A copy of the `while` `w` over the condition `cond` and body `body`, every other field kept.
export function mkWhileAs(w: WhileStmt, cond: i32, body: i32) {
  const n: Node = {
    whileCond: cond,
    whileBody: body,
    whileLabel: w.whileLabel,
    pos: w.pos,
    whileBlk: w.whileBlk,
    whileLv: w.whileLv,
  }
  addNode(n)
}

export function mkForRange(
  v: string,
  from: i32,
  to: i32,
  step: i32,
  excl: boolean,
  body: i32,
  label: string,
  pos: i32,
) {
  const n: Node = {
    frVar: v,
    frFrom: from,
    frTo: to,
    frStep: step,
    frExcl: excl,
    frBody: body,
    frLabel: label,
    pos: pos,
  }
  addNode(n)
}

export function mkForIn(
  v: string,
  v2: string,
  iter: i32,
  body: i32,
  label: string,
  pos: i32,
) {
  const n: ForIn = {
    fiVar: v,
    fiVar2: v2,
    fiDecl1: -1,
    fiDecl2: -1,
    fiIter: iter,
    fiBody: body,
    fiLabel: label,
    pos: pos,
  }
  const ix = addNode(n)
  n.fiDecl1 = mkLoopVar(ix, 0, pos)
  if v2 != "" { n.fiDecl2 = mkLoopVar(ix, 1, pos) }
  ix
}

// A copy of loop `n` over `iter` and `body`, declaring the same variables `n` does.
export function mkForInCopy(n: ForIn, iter: i32, body: i32) {
  const c: Node = {
    fiVar: n.fiVar,
    fiVar2: n.fiVar2,
    fiDecl1: n.fiDecl1,
    fiDecl2: n.fiDecl2,
    fiIter: iter,
    fiBody: body,
    fiLabel: n.fiLabel,
    pos: n.pos,
  }
  addNode(c)
}

// The declaration of slot `slot` (0 or 1) of loop `loop`.
export function mkLoopVar(loop: i32, slot: i32, pos: i32) {
  const n: Node = { lvLoop: loop, lvSlot: slot, pos: pos }
  addNode(n)
}

// Points the variable declarations of `for` loop `loop` at it, for a loop a rewrite moved to a new
// node; any other node is left as it is.
export function loopVarsMoveTo(loop: i32) {
  if loop < 0 || loop >= P.nodes.length { return 0 }
  const l = nodeAt(loop)
  if !(l is ForIn) { return 0 }
  for d in [l.fiDecl1, l.fiDecl2] {
    if d >= 0 && d < P.nodes.length {
      const n = nodeAt(d)
      if n is LoopVar { n.lvLoop = loop }
    }
  }
  0
}

// The name loop-variable declaration `d` binds, or "" when `d` is no `LoopVar`.
export function loopVarName(d: i32): string {
  if d < 0 || d >= P.nodes.length { return "" }
  const n = nodeAt(d)
  if !(n is LoopVar) || n.lvLoop < 0 || n.lvLoop >= P.nodes.length { return "" }
  const l = nodeAt(n.lvLoop)
  if !(l is ForIn) { return "" }
  if n.lvSlot == 1 { return l.fiVar2 }
  l.fiVar
}

// The `for` loop declaration `d` names a variable of, or -1 when `d` is no `LoopVar`. Copies of a
// loop share its declarations, so this is the loop the parser built.
export function loopVarLoop(d: i32): i32 {
  if d < 0 || d >= P.nodes.length { return -1 }
  const n = nodeAt(d)
  if !(n is LoopVar) { return -1 }
  n.lvLoop
}

export function mkMatch(
  scrut: i32,
  pats: i32[],
  binds: i32[],
  armStart: i32[],
  armCount: i32[],
  bodies: i32[],
  pos: i32,
) {
  const n: Node = {
    matchScrut: scrut,
    matchPats: pats,
    matchBinds: binds,
    matchArmStart: armStart,
    matchArmCount: armCount,
    matchBodies: bodies,
    pos: pos,
  }
  addNode(n)
}

export function mkBreak(kw: string, label: string, pos: i32) {
  mkBreakVal(kw, label, pos, 0)
}

// `mkBreak` for `break v`, whose value is the statement before it (`hasVal` 1).
export function mkBreakVal(kw: string, label: string, pos: i32, hasVal: i32) {
  if hasVal == 1 { brkValSeen = true }
  const n: Node = { brkKw: kw, brkLabel: label, pos: pos, brkHasVal: hasVal }
  addNode(n)
}

// Whether this parse holds a `break v`, so a walk that only folds those can skip the tree.
export let brkValSeen = false
// Whether this parse holds a labelled block, whose tail can make it carry a value.
export let lblBlkSeen = false

// The four whole-graph parse flags as bits: arith region 1, `break v` 2, labelled block 4,
// fn-type parameter names 8. The driver takes them before each module's parse and merges the
// earlier modules' bits back after, so between the two they are what that one module saw.
export function parseFlagsNow(): i32 {
  let b = 0
  if arithRegionSeen { b = b + 1 }
  if brkValSeen { b = b + 2 }
  if lblBlkSeen { b = b + 4 }
  if tsAnyParamNames { b = b + 8 }
  b
}

// `parseFlagsNow`, clearing all four.
export function parseFlagsTake(): i32 {
  const b = parseFlagsNow()
  arithRegionSeen = false
  brkValSeen = false
  lblBlkSeen = false
  tsAnyParamNames = false
  b
}

// Set every flag whose bit is in `bits`; never clears one.
export function parseFlagsMerge(bits: i32) {
  if (bits & 1) != 0 { arithRegionSeen = true }
  if (bits & 2) != 0 { brkValSeen = true }
  if (bits & 4) != 0 { lblBlkSeen = true }
  if (bits & 8) != 0 { tsAnyParamNames = true }
  0
}

export function mkContinue(kw: string, label: string, pos: i32) {
  const n: Node = { contKw: kw, contLabel: label, pos: pos }
  addNode(n)
}

export function mkReturn(arg: i32, pos: i32) {
  const n: Node = { retArg: arg, pos: pos }
  addNode(n)
}

export function mkBlock(stmts: i32[], pos: i32) {
  const n: Node = { blkStmts: stmts, pos: pos }
  addNode(n)
}

export function mkProgram(stmts: i32[], pos: i32) {
  const n: Node = { progStmts: stmts, pos: pos }
  addNode(n)
}

export function mkImport(
  path: string,
  names: string[],
  locals: string[],
  nameToks: i32[],
  pos: i32,
) {
  const n: Node = {
    impPath: path,
    impNames: names,
    impLocals: locals,
    impNameToks: nameToks,
    pos: pos,
  }
  addNode(n)
}

export function mkFieldDef(name: string, ty: i32, pos: i32) {
  const n: Node = { fdName: name, fdType: ty, pos: pos }
  addNode(n)
}

export function mkTypeDecl(
  name: string,
  fields: i32[],
  pos: i32,
  isNew: i32,
  isFlat: i32,
) {
  const n: Node = {
    tdName: name,
    tdFields: fields,
    pos: pos,
    tdNew: isNew,
    tdFlat: isFlat,
  }
  addNode(n)
}

export function mkFieldInit(name: string, value: i32, pos: i32) {
  const n: Node = { fiName: name, fiValue: value, pos: pos }
  addNode(n)
}

export function mkObjLit(fields: i32[], pos: i32) {
  const n: Node = { objFields: fields, pos: pos }
  addNode(n)
}

export function mkUnionDecl(
  name: string,
  variants: string[],
  pos: i32,
  isNew: i32,
) {
  const n: Node = { udName: name, udVariants: variants, pos: pos, udNew: isNew }
  addNode(n)
}

export function mkIsExpr(obj: i32, variant: string, pos: i32) {
  const n: Node = { isObj: obj, isVariant: variant, pos: pos, isNeg: 0 }
  addNode(n)
}

// A negated type guard `x !is T`, desugared to `!(x is T)` (a `Unary "!"` over
// this node) for typecheck/emit's narrowing, but flagged `isNeg` so the printer
// reprints the surface `!is` instead of `!(… is …)`.
export function mkIsExprNeg(obj: i32, variant: string, pos: i32) {
  const n: Node = { isObj: obj, isVariant: variant, pos: pos, isNeg: 1 }
  addNode(n)
}

// `x as T` — an explicit numeric cast (B2). `ty` is the target type name string.
export function mkAsExpr(obj: i32, ty: string, mode: AsMode, pos: i32) {
  const n: Node = { asObj: obj, asTy: ty, asMode: mode, pos: pos }
  addNode(n)
}

// ── int → string ─────────────────────────────────────────────────────────────
// A hand-rolled decimal converter. `i32ToStr` is the shared count/index renderer
// across the self-host: the checker, emitter, and driver import it for
// diagnostics and synthetic names.
function digitChar(d: i32) {
  if d == 0 { return "0" }
  if d == 1 { return "1" }
  if d == 2 { return "2" }
  if d == 3 { return "3" }
  if d == 4 { return "4" }
  if d == 5 { return "5" }
  if d == 6 { return "6" }
  if d == 7 { return "7" }
  if d == 8 { return "8" }
  "9"
}

export function i32ToStr(n: i32) {
  if n == 0 { return "0" }
  // Peel digits in the negative range: every i32 (including INT_MIN, whose
  // magnitude overflows i32) is representable as -|n|, so negate positives
  // instead of negatives. Wasm `rem_s` of a negative operand yields -digit.
  const neg = n < 0
  let m = n
  if !neg { m = 0 - m }
  let out = ""
  while m < 0 {
    out = digitChar(0 - (m % 10)) + out
    m = m / 10
  }
  if neg { out = "-" + out }
  out
}

// True if control never falls out of statement `ix`: the one rule narrowing, definite assignment,
// return totality, the emitter and the lint share. A block exits once any statement does; an `if`
// needs an `else` and both arms exiting; a `match`, every arm; a call, when its type is `never`;
// a `while true` or a labelled block, when no `break` leaves it.
export function stmtAlwaysExits(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const s = nodeAt(ix)
  if s is RetStmt {
    return true
  } else if s is Call {
    return callIsNever(ix)
  } else if s is BreakStmt {
    return true
  } else if s is ContinueStmt {
    return true
  } else if s is WhileStmt {
    // A labelled block is left by its name alone; its body's bare `break` leaves an outer loop.
    if s.whileBlk == 1 {
      return stmtAlwaysExits(s.whileBody)
        && !breakLeaves(s.whileBody, s.whileLabel, false)
    }
    return condLitTrue(s.whileCond)
      && !breakLeaves(s.whileBody, s.whileLabel, true)
  } else if s is Block {
    const st = s.blkStmts
    let i = 0
    while i < st.length {
      if stmtAlwaysExits(st[i]) { return true }
      i = i + 1
    }
    return false
  } else if s is IfStmt {
    // The emitter's lowered bare block runs its arm unconditionally, so it answers as its
    // block does, or the passes on either side of that rewrite would disagree.
    if isBareBlockIf(ix) { return stmtAlwaysExits(s.ifThen) }
    // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
    let cur = ix
    while cur >= 0 {
      const c = nodeAt(cur)
      cur = -1
      if c is IfStmt {
        if c.ifElse < 0 { return false }
        if !stmtAlwaysExits(c.ifThen) { return false }
        if nodeAt(c.ifElse) is IfStmt && !isBareBlockIf(c.ifElse) {
          cur = c.ifElse
        } else {
          return stmtAlwaysExits(c.ifElse)
        }
      }
    }
    return false
  } else if s is MatchExpr {
    // A checked `match` is exhaustive, and its desugar is an if/else chain ending in a bare
    // `else`, so this answer and the one read off the lowered chain agree.
    const bodies = s.matchBodies
    if bodies.length == 0 { return false }
    let k = 0
    while k < bodies.length {
      if !stmtAlwaysExits(bodies[k]) { return false }
      k = k + 1
    }
    return true
  }
  false
}

// Whether a `break` under `root` leaves the loop or labelled block whose body it is: a
// `break @label`, or with `bare`, a bare one outside any nested loop. A function is a boundary.
export function breakLeaves(root: i32, label: string, bare: boolean): boolean {
  const todo: i32[] = [root]
  const inLoop: boolean[] = [false]
  while todo.length > 0 {
    const ix = todo.pop() ?? -1
    const nested = inLoop.pop() ?? true
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is BreakStmt {
        if n.brkLabel == "" {
          if bare && !nested { return true }
        } else if n.brkLabel == label {
          return true
        }
      }
      if !(n is FuncDecl) {
        let inner = nested || n is ForRange || n is ForIn
        if n is WhileStmt { inner = inner || n.whileBlk == 0 }
        const kids = nodeChildren(ix)
        let i = 0
        while i < kids.length {
          todo.push(kids[i])
          inLoop.push(inner)
          i = i + 1
        }
      }
    }
  }
  false
}

// Whether the condition at `ix` is the literal `true` (through parentheses).
export function condLitTrue(ix: i32): boolean {
  let c = ix
  while c >= 0 && nodeAt(c) is Paren {
    const pn = nodeAt(c)
    if pn is Paren { c = pn.parInner }
  }
  if c < 0 { return false }
  const b = nodeAt(c)
  if b is BoolLit { return b.boolVal == 1 }
  false
}

// Whether the last of `stmts` is dead: some statement before it always exits, so the tail never
// yields the block's value or a function's implicit return. The checker and emitter share it (D8720).
export function blockTailIsDead(stmts: i32[]): boolean {
  let i = 0
  while i < stmts.length - 1 {
    if stmtAlwaysExits(stmts[i]) { return true }
    i = i + 1
  }
  false
}

// The empty child list, shared rather than minted per call. Safe for the same reason a
// kind whose children are exactly one arena field returns that field: `nodeChildren`'s
// result is read-only to every caller — all of them index it and read `.length`, none
// appends — and just under half the nodes in a parse have no children at all.
const nodeNoKids: i32[] = []

// The next link of an `else if` chain: the else of the `if` at `ix` when that else is itself
// an `if`, otherwise -1. A recursive walker loops on it rather than descending, so a chain's
// depth — a `match` desugars to one link per arm — costs no stack (D1990).
export function elseIfLink(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is IfStmt {
    if n.ifElse >= 0 && n.ifElse < P.nodes.length {
      if nodeAt(n.ifElse) is IfStmt { return n.ifElse }
    }
  }
  -1
}

// `nodeChildren` with an `else if` link left out (its slot reads -1), for a walker that loops
// `cur = elseIfLink(cur)` around its child loop. Every other kind answers as `nodeChildren`.
export function nodeSpineChildren(ix: i32) {
  const next = elseIfLink(ix)
  if next < 0 { return nodeChildren(ix) }
  const n = nodeAt(ix)
  if n is IfStmt {
    const out: i32[] = [n.ifCond, n.ifThen, -1]
    return out
  }
  nodeChildren(ix)
}

// The child arena indices of `P.nodes[ix]` in source order; a slot holding `-1` is pushed
// as-is and the walker's bounds check skips it. Covers value children and type-annotation
// slots. A `MatchExpr`'s patterns are deliberately not children — a pattern is a shape, not
// a value reference — and `matchBinds` is out because it reads the shared scrutinee node.
export function nodeChildren(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return nodeNoKids }
  nodeKidsOf(nodeAt(ix))
}

// Whether node `target` is `ix` or lies under it; a loop variable lies where its loop does.
export function nodeContains(ix: i32, target: i32): boolean {
  if ix == target { return ix >= 0 && ix < P.nodes.length }
  const lp = loopVarLoop(target)
  if lp >= 0 { return nodeContainsAt(ix, lp) }
  nodeContainsAt(ix, target)
}

// `nodeContains` over the syntax tree alone.
function nodeContainsAt(ix: i32, target: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if ix == target { return true }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if nodeContainsAt(kids[i], target) { return true }
    i = i + 1
  }
  false
}

// `nodeChildren` of a node already read, for a caller that has asked its kind first.
function nodeKidsOf(n: Node): i32[] {
  // Arms in descending kind frequency, each returning, so the ladder is walked only to the
  // rung a node needs; a kind with no arm falls out of the end without allocating.
  match n {
    Ident => {
      return nodeNoKids
    }
    BinExpr => {
      const out: i32[] = [n.binLeft, n.binRight]
      return out
    }
    Block => {
      return n.blkStmts
    }
    Call => {
      const out: i32[] = [n.callFn]
      let i = 0
      while i < n.callArgs.length {
        out.push(n.callArgs[i])
        i = i + 1
      }
      return out
    }
    NumLit => {
      return nodeNoKids
    }
    IfStmt => {
      const out: i32[] = [n.ifCond, n.ifThen, n.ifElse]
      return out
    }
    Member => {
      const out: i32[] = [n.memObj]
      return out
    }
    RetStmt => {
      const out: i32[] = [n.retArg]
      return out
    }
    LetDecl => {
      const out: i32[] = [n.letType, n.letInit]
      return out
    }
    StrLit => {
      return nodeNoKids
    }
    TypeRef => {
      return nodeNoKids
    }
    Paren => {
      const out: i32[] = [n.parInner]
      return out
    }
    Index => {
      const out: i32[] = [n.idxArr, n.idxIndex]
      return out
    }
    Param => {
      const out: i32[] = [n.parType, n.parDefault]
      return out
    }
    FuncDecl => {
      const out: i32[] = []
      let i = 0
      while i < n.fnParams.length {
        out.push(n.fnParams[i])
        i = i + 1
      }
      out.push(n.fnRet)
      out.push(n.fnBody)
      return out
    }
    ArrayLit => {
      return n.arrElems
    }
    Spread => {
      const out: i32[] = [n.spdArg]
      return out
    }
    LoopVar => {
      return nodeNoKids
    }
    ObjLit => {
      return n.objFields
    }
    FieldInit => {
      const out: i32[] = [n.fiValue]
      return out
    }
    Unary => {
      const out: i32[] = [n.unArg]
      return out
    }
    IsExpr => {
      const out: i32[] = [n.isObj]
      return out
    }
    WhileStmt => {
      const out: i32[] = [n.whileCond, n.whileBody]
      return out
    }
    AsExpr => {
      const out: i32[] = [n.asObj]
      return out
    }
    ForIn => {
      const out: i32[] = [n.fiIter, n.fiBody]
      return out
    }
    ForRange => {
      const out: i32[] = [n.frFrom, n.frTo, n.frStep, n.frBody]
      return out
    }
    MatchExpr => {
      const out: i32[] = [n.matchScrut]
      let i = 0
      while i < n.matchBodies.length {
        out.push(n.matchBodies[i])
        i = i + 1
      }
      return out
    }
    OptMember => {
      const out: i32[] = [n.omObj]
      return out
    }
    FieldDef => {
      const out: i32[] = [n.fdType]
      return out
    }
    TypeDecl => {
      return n.tdFields
    }
    Program => {
      return n.progStmts
    }
    // these kinds have no child slot
    CharLit | BoolLit | NullLit | ErrExpr | BreakStmt | ContinueStmt | UnionDecl | ImportDecl => {}
  }
  nodeNoKids
}

function pushAll(out: i32[], xs: i32[]) {
  let i = 0
  while i < xs.length {
    out.push(xs[i])
    i = i + 1
  }
  xs.length
}

// `nodeSpineChildren(ix)` appended to `out`, element for element, returning how many it
// appended — for a walker that pops them after its loop rather than allocating a list per
// node. A recursive walker shares one stack: its loop reads its own window, every nested
// call pushes and pops above it.
export function nodeSpineChildrenPush(ix: i32, out: i32[]): i32 {
  nodeKidsPush(ix, out, true)
}

// `nodeChildren(ix)` appended to `out`, element for element, returning how many it appended:
// the allocation-free form for a walker that pushes children onto its own stack.
export function nodeChildrenPush(ix: i32, out: i32[]): i32 {
  nodeKidsPush(ix, out, false)
}

// The two push forms' one arm table; `spine` pushes `-1` for an `else if` link.
function nodeKidsPush(ix: i32, out: i32[], spine: boolean): i32 {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  match n {
    Ident | NumLit | StrLit | TypeRef => {
      return 0
    }
    BinExpr => {
      out.push(n.binLeft)
      out.push(n.binRight)
      return 2
    }
    Block => {
      return pushAll(out, n.blkStmts)
    }
    Call => {
      out.push(n.callFn)
      return pushAll(out, n.callArgs) + 1
    }
    IfStmt => {
      out.push(n.ifCond)
      out.push(n.ifThen)
      if spine && elseIfLink(ix) >= 0 {
        out.push(-1)
      } else {
        out.push(n.ifElse)
      }
      return 3
    }
    Member => {
      out.push(n.memObj)
      return 1
    }
    RetStmt => {
      out.push(n.retArg)
      return 1
    }
    LetDecl => {
      out.push(n.letType)
      out.push(n.letInit)
      return 2
    }
    Paren => {
      out.push(n.parInner)
      return 1
    }
    Index => {
      out.push(n.idxArr)
      out.push(n.idxIndex)
      return 2
    }
    Param => {
      out.push(n.parType)
      out.push(n.parDefault)
      return 2
    }
    FuncDecl => {
      const k = pushAll(out, n.fnParams)
      out.push(n.fnRet)
      out.push(n.fnBody)
      return k + 2
    }
    ArrayLit => {
      return pushAll(out, n.arrElems)
    }
    Spread => {
      out.push(n.spdArg)
      return 1
    }
    LoopVar => {
      return 0
    }
    ObjLit => {
      return pushAll(out, n.objFields)
    }
    FieldInit => {
      out.push(n.fiValue)
      return 1
    }
    Unary => {
      out.push(n.unArg)
      return 1
    }
    IsExpr => {
      out.push(n.isObj)
      return 1
    }
    WhileStmt => {
      out.push(n.whileCond)
      out.push(n.whileBody)
      return 2
    }
    AsExpr => {
      out.push(n.asObj)
      return 1
    }
    ForIn => {
      out.push(n.fiIter)
      out.push(n.fiBody)
      return 2
    }
    ForRange => {
      out.push(n.frFrom)
      out.push(n.frTo)
      out.push(n.frStep)
      out.push(n.frBody)
      return 4
    }
    MatchExpr => {
      out.push(n.matchScrut)
      return pushAll(out, n.matchBodies) + 1
    }
    OptMember => {
      out.push(n.omObj)
      return 1
    }
    FieldDef => {
      out.push(n.fdType)
      return 1
    }
    TypeDecl => {
      return pushAll(out, n.tdFields)
    }
    Program => {
      return pushAll(out, n.progStmts)
    }
    // these kinds have no child slot
    CharLit | BoolLit | NullLit | ErrExpr | BreakStmt | ContinueStmt | UnionDecl | ImportDecl => {}
  }
  0
}

// `nodeChildren` minus the type-annotation and declaration slots — the value children a
// source rewrite may descend into. Only the five kinds carrying such a slot have an arm;
// every other kind is `nodeChildren` verbatim, so one arm table serves both walks and a
// new `Node` variant is one edit, in the ladder the kind-ladder ratchet already watches.
export function nodeValueChildren(ix: i32): i32[] {
  if ix < 0 || ix >= P.nodes.length { return nodeNoKids }
  const n = nodeAt(ix)
  if n is LetDecl {
    const out: i32[] = [n.letInit]
    return out
  }
  if n is FuncDecl {
    const out: i32[] = [n.fnBody]
    return out
  }
  if n is Param { return nodeNoKids }
  if n is FieldDef { return nodeNoKids }
  if n is TypeDecl { return nodeNoKids }
  nodeKidsOf(n)
}

// `nodeValueChildren` with an `else if` link left out, the value-walk twin of
// `nodeSpineChildren`.
export function nodeValueSpineChildren(ix: i32): i32[] {
  if elseIfLink(ix) >= 0 { return nodeSpineChildren(ix) }
  nodeValueChildren(ix)
}

// ── per-module parse images ──────────────────────────────────────────────────

// Index `x` of arena `k` printed for a parse image: `sp[2k]..sp[2k+1]` is the module's range
// in that arena (nodes, tokens, spelling nodes, spelling kids, diagnostics, extern rows,
// extern-global rows). `rel` rebases on the range's start; a negative sentinel prints as
// itself and an index outside the module's range as `!<absolute>`.
export function piIx(x: i32, sp: i32[], k: i32, rel: boolean): string {
  if x < 0 { return i32ToStr(x) }
  const b = sp[2 * k]
  if x < b || x >= sp[2 * k + 1] { return "!" + i32ToStr(x) }
  if rel { return i32ToStr(x - b) }
  i32ToStr(x)
}

// True when `x` lies in arena `k`'s range of `sp`.
function piIn(x: i32, sp: i32[], k: i32): boolean {
  x >= sp[2 * k] && x < sp[2 * k + 1]
}

// A string field of a parse image, length-prefixed so no payload can forge a separator.
export function piStr(s: string): string { i32ToStr(s.length) + ":" + s }

// `xs` as a bracketed list of arena-`k` indices.
export function piIxs(xs: i32[], sp: i32[], k: i32, rel: boolean): string {
  let out = "["
  let i = 0
  while i < xs.length {
    if i > 0 { out = out + "," }
    out = out + piIx(xs[i], sp, k, rel)
    i = i + 1
  }
  out + "]"
}

// The members of `xs` inside arena `k`'s range, printed in table order.
function piIxsIn(xs: i32[], sp: i32[], k: i32, rel: boolean): string {
  const kept: i32[] = []
  let i = 0
  while i < xs.length {
    if piIn(xs[i], sp, k) { kept.push(xs[i]) }
    i = i + 1
  }
  piIxs(kept, sp, k, rel)
}

// One module's rows of the side tables the parser writes, for `parse_image.vl`: each row is
// keyed by a node, diagnostic or extern row inside the module's range of `sp`, in table order.
// An extern row names its link by import name, since link rows are shared across modules.
export function parseImageTables(sp: i32[], rel: boolean, out: string[]) {
  piAnnRows(sp, rel, out)
  piDeclRows(sp, rel, out)
  out.push("btd " + piIxsIn(bodyTyDeclNode, sp, 0, rel))
  out.push("vif " + piIxsIn(valueIfNodes, sp, 0, rel))
  out.push("fns " + piIxsIn(funcDeclNodes, sp, 0, rel))
  out.push("sbr " + piIxsIn(stmtBraceNodes, sp, 0, rel))
  out.push("sbt " + piIxsIn(stmtBraceTails, sp, 0, rel))
  out.push("bns " + piIxsIn(braceNameStmts, sp, 0, rel))
  const exps: i32[] = []
  const holes: i32[] = []
  let i = sp[0]
  while i < sp[1] {
    if exportDeclNodes[i] ?? false { exps.push(i) }
    if i < tplHole.length && tplHole[i] == 1 { holes.push(i) }
    i = i + 1
  }
  out.push("exp " + piIxs(exps, sp, 0, rel))
  out.push("tpl " + piIxs(holes, sp, 0, rel))
  let r = 0
  while r + 1 < recDupField.length {
    if piIn(recDupField[r], sp, 0) {
      out.push(
        "rdf "
          + piIx(recDupField[r], sp, 0, rel)
          + " "
          + piIx(recDupField[r + 1], sp, 0, rel),
      )
    }
    r = r + 2
  }
  piDiagRows(sp, rel, out)
  piExternRows(sp, rel, out)
  0
}

// The spelling-root and explicit type-argument rows of `parseImageTables`.
function piAnnRows(sp: i32[], rel: boolean, out: string[]) {
  let r = 0
  while r < annTsNode.length {
    if piIn(annTsNode[r], sp, 0) {
      out.push(
        "ann "
          + piIx(annTsNode[r], sp, 0, rel)
          + " "
          + piIx(annTsWritten[r], sp, 2, rel),
      )
    }
    r = r + 1
  }
  r = 0
  while r < udTsNode.length {
    if piIn(udTsNode[r], sp, 0) {
      out.push(
        "ud "
          + piIx(udTsNode[r], sp, 0, rel)
          + " "
          + piIx(udTsWritten[r], sp, 2, rel),
      )
    }
    r = r + 1
  }
  r = 0
  while r < callTaCall.length {
    if piIn(callTaCall[r], sp, 0) {
      let row = "cta " + piIx(callTaCall[r], sp, 0, rel)
      let j = callTaStart[r]
      while j < callTaStart[r] + callTaCount[r] {
        row = row
          + " "
          + piIx(callTaNodes[j], sp, 0, rel)
          + "@"
          + i32ToStr(callTaEnds[j])
        j = j + 1
      }
      out.push(row)
    }
    r = r + 1
  }
  0
}

// The generic-parameter, bound and getter rows of `parseImageTables`.
function piDeclRows(sp: i32[], rel: boolean, out: string[]) {
  let r = 0
  while r < declGpNode.length {
    if piIn(declGpNode[r], sp, 0) {
      let row = "gp "
        + piIx(declGpNode[r], sp, 0, rel)
        + " "
        + piStr(declGpBase[r])
      let j = declGpStart[r]
      while j < declGpStart[r] + declGpCount[r] {
        row = row + " " + piStr(declGpName[j])
        j = j + 1
      }
      out.push(row)
    }
    r = r + 1
  }
  r = 0
  while r < fnTpBoundFn.length {
    if piIn(fnTpBoundFn[r], sp, 0) {
      out.push(
        "tpb "
          + piIx(fnTpBoundFn[r], sp, 0, rel)
          + " "
          + i32ToStr(fnTpBoundIx[r])
          + " "
          + piIx(fnTpBoundAnn[r], sp, 0, rel),
      )
    }
    r = r + 1
  }
  r = 0
  while r < declBoundNode.length {
    if piIn(declBoundNode[r], sp, 0) {
      out.push(
        "dbd "
          + piIx(declBoundNode[r], sp, 0, rel)
          + " "
          + piIx(declBoundAnn[r], sp, 0, rel),
      )
    }
    r = r + 1
  }
  r = 0
  while r < getDeclNodes.length {
    if piIn(getDeclNodes[r], sp, 0) {
      let e = "0"
      if getDeclExps[r] { e = "1" }
      out.push("get " + piIx(getDeclNodes[r], sp, 0, rel) + " " + e)
    }
    r = r + 1
  }
  0
}

// The diagnostic-keyed rows of `parseImageTables`.
function piDiagRows(sp: i32[], rel: boolean, out: string[]) {
  out.push("dgl " + piIxsIn(dgLossless, sp, 4, rel))
  let r = 0
  while r < dgSpanIdx.length {
    if piIn(dgSpanIdx[r], sp, 4) {
      out.push(
        "dgs "
          + piIx(dgSpanIdx[r], sp, 4, rel)
          + " "
          + piIx(dgSpanTok[r], sp, 1, rel),
      )
    }
    r = r + 1
  }
  r = 0
  while r < dgCodeIdx.length {
    if piIn(dgCodeIdx[r], sp, 4) {
      out.push(
        "dgc " + piIx(dgCodeIdx[r], sp, 4, rel) + " " + piStr(dgCodeVal[r]),
      )
    }
    r = r + 1
  }
  0
}

// The module's extern declaration rows. The link row is named, never indexed, and the module
// is implicit; `rel` false prints both indices as the shared tables hold them.
function piExternRows(sp: i32[], rel: boolean, out: string[]) {
  let r = sp[10]
  while r < sp[11] {
    let at = ""
    if !rel {
      at = " link="
        + i32ToStr(extDeclLink[r])
        + " mod="
        + i32ToStr(extDeclMod[r])
    }
    out.push(
      "ext "
        + piStr(extDeclVl[r])
        + " "
        + piStr(extNames[extDeclLink[r]])
        + " "
        + piStr(extDeclSig[r])
        + " "
        + piIx(extDeclPos[r], sp, 1, rel)
        + at,
    )
    r = r + 1
  }
  r = sp[12]
  while r < sp[13] {
    let at = ""
    if !rel { at = " link=" + i32ToStr(extGDeclLink[r]) }
    out.push(
      "extg "
        + piIx(extGDeclNode[r], sp, 0, rel)
        + " "
        + piStr(extGNames[extGDeclLink[r]])
        + " "
        + piStr(extGDeclTy[r])
        + " "
        + i32ToStr(extGDeclMut[r])
        + " "
        + piIx(extGDeclPos[r], sp, 1, rel)
        + at,
    )
    r = r + 1
  }
  0
}

// ── the parse bank's side tables ─────────────────────────────────────────────

// One module's rows of every side table its parse appends, each index held relative to the
// module's own range, so `parse_bank.vl` can replay them on any later arena ends. `ok` is
// false when some index left its range, which makes the module unbankable.
export type PbSide = {
  ok: boolean,
  ntok: i32[],
  dntOn: boolean,
  dnt: i32[],
  tplOn: boolean,
  tpl: i32[],
  tsK: i32[],
  tsT: string[],
  tsS: i32[],
  tsC: i32[],
  tsKd: i32[],
  annN: i32[],
  annR: i32[],
  annW: i32[],
  ctaC: i32[],
  ctaS: i32[],
  ctaN: i32[],
  ctaNd: i32[],
  ctaE: i32[],
  udN: i32[],
  udR: i32[],
  udW: i32[],
  gpN: i32[],
  gpB: string[],
  gpS: i32[],
  gpC: i32[],
  gpNm: string[],
  btd: i32[],
  vif: i32[],
  fns: i32[],
  sbr: i32[],
  sbt: i32[],
  bns: i32[],
  exps: i32[],
  rdf: i32[],
  tpbF: i32[],
  tpbI: i32[],
  tpbA: i32[],
  dbdN: i32[],
  dbdA: i32[],
  getN: i32[],
  getE: boolean[],
  exN: string[],
  exR: string[],
  exP: string[],
  exPB: i32[],
  exPN: i32[],
  exPos: i32[],
  egN: string[],
  egT: string[],
  egM: i32[],
  egPos: i32[],
  egNd: i32[],
}

let pbBad = false

// `x` moved by `d` when it lies in `[lo, hi)`; a negative sentinel is kept as it is, and any
// other index outside the range marks the move bad.
export function pbMv(x: i32, lo: i32, hi: i32, d: i32): i32 {
  if x < 0 { return x }
  if x < lo || x >= hi {
    pbBad = true
    return x
  }
  x + d
}

// Whether a `pbMv` since the last call went out of range, clearing the mark.
export function pbBadTake(): boolean {
  const b = pbBad
  pbBad = false
  b
}

// A fresh list of `xs[from..]`, each moved by `pbMv`.
export function pbMvList(
  xs: i32[],
  from: i32,
  lo: i32,
  hi: i32,
  d: i32,
): i32[] {
  if from >= xs.length { return [] }
  const out: i32[] = __array_new__(xs.length - from, 0)
  let i = from
  while i < xs.length {
    // `pbMv`, inlined: this loop carries most of a bank's indices.
    let x = xs[i]
    if x >= 0 {
      if x < lo || x >= hi { pbBad = true } else { x = x + d }
    }
    out[i - from] = x
    i = i + 1
  }
  out
}

function pbMvPush(dst: i32[], xs: i32[], lo: i32, hi: i32, d: i32) {
  let i = 0
  while i < xs.length {
    let x = xs[i]
    if x >= 0 {
      if x < lo || x >= hi { pbBad = true } else { x = x + d }
    }
    dst.push(x)
    i = i + 1
  }
  0
}

// A fresh copy of `xs[from..]`.
export function pbInts(xs: i32[], from: i32): i32[] {
  if from >= xs.length { return [] }
  const out: i32[] = __array_new__(xs.length - from, 0)
  __array_copy__(out, 0, xs, from, xs.length - from)
  out
}

export function pbStrs(xs: string[], from: i32): string[] {
  if from >= xs.length { return [] }
  const out: string[] = __array_new__(xs.length - from, "")
  let i = from
  while i < xs.length {
    out[i - from] = xs[i]
    i = i + 1
  }
  out
}

function pbBools(xs: boolean[], from: i32): boolean[] {
  const out: boolean[] = []
  let i = from
  while i < xs.length {
    out.push(xs[i])
    i = i + 1
  }
  out
}

// `dst` with bank column `xs` appended moved by `d`, as `pbMvPush` would leave it; an empty
// `dst` with no move takes a copy, since `pbSideTake` already proved the rows in range.
function pbMvCat(dst: i32[], xs: i32[], hi: i32, d: i32): i32[] {
  if dst.length == 0 && d == 0 { return pbInts(xs, 0) }
  pbMvPush(dst, xs, 0, hi, d)
  dst
}

function pbIntPush(dst: i32[], xs: i32[]) {
  let i = 0
  while i < xs.length {
    dst.push(xs[i])
    i = i + 1
  }
  0
}

function pbStrPush(dst: string[], xs: string[]) {
  let i = 0
  while i < xs.length {
    dst.push(xs[i])
    i = i + 1
  }
  0
}

// Every arena and side-table length a module parse may append to, taken before its tokens
// load; `pbSideTake` reads the module's rows back as the tail past each.
export function pbSideOpen(): i32[] {
  [
    P.nodes.length,
    P.toks.length,
    tsKind.length,
    tsKids.length,
    P.diags.length,
    nodeToks.length,
    declNameTok.length,
    tplHole.length,
    annTsNode.length,
    callTaCall.length,
    callTaNodes.length,
    udTsNode.length,
    declGpNode.length,
    declGpName.length,
    bodyTyDeclNode.length,
    valueIfNodes.length,
    funcDeclNodes.length,
    stmtBraceNodes.length,
    stmtBraceTails.length,
    braceNameStmts.length,
    recDupField.length,
    fnTpBoundFn.length,
    declBoundNode.length,
    getDeclNodes.length,
    extDeclVl.length,
    extGDeclNode.length,
    dgLossless.length,
    dgSpanIdx.length,
    dgCodeIdx.length,
    tsStack.length,
    exportDeclOrder.length,
  ]
}

// A table shorter than its opening length has been edited outside this parse's rows.
function pbGrew(len: i32, open: i32) {
  if len < open { pbBad = true }
  0
}

// The exported declarations in `[nb, ne)`, ascending and moved by `-nb`: read off the rows
// added since `from` when those are ascending and in range, else by probing every node.
function pbExportsIn(from: i32, nb: i32, ne: i32): i32[] {
  const exps: i32[] = []
  let k = from
  while k < exportDeclOrder.length {
    const x = exportDeclOrder[k]
    const n = exps.length
    if x < nb || x >= ne || (n > 0 && exps[n - 1] >= x - nb) {
      return pbExportsScan(nb, ne)
    }
    exps.push(x - nb)
    k = k + 1
  }
  exps
}

function pbExportsScan(nb: i32, ne: i32): i32[] {
  const exps: i32[] = []
  let i = nb
  while i < ne {
    if exportDeclNodes[i] ?? false { exps.push(i - nb) }
    i = i + 1
  }
  exps
}

// The side-table rows the parse since `pbSideOpen` (`o`) appended, relative to its ranges.
export function pbSideTake(o: i32[]): PbSide {
  pbBad = false
  const nb = o[0]
  const ne = P.nodes.length
  const tb = o[1]
  const te = P.toks.length
  const sb = o[2]
  const se = tsKind.length
  const kb = o[3]
  const ke = tsKids.length
  if P.diags.length != o[4] { pbBad = true }
  if dgLossless.length != o[26] || dgSpanIdx.length != o[27] { pbBad = true }
  if dgCodeIdx.length != o[28] || tsStack.length != o[29] { pbBad = true }
  if nodeToks.length - o[5] != ne - nb { pbBad = true }
  pbGrew(declNameTok.length, o[6])
  pbGrew(tplHole.length, o[7])
  pbGrew(valueIfNodes.length, o[15])
  const dntOn = declNameTok.length > o[6]
  if dntOn && o[6] > nb { pbBad = true }
  const tplOn = tplHole.length > o[7]
  if tplOn && o[7] > nb { pbBad = true }
  let dntFrom = nb
  if !dntOn { dntFrom = declNameTok.length }
  let tplFrom = nb
  if !tplOn { tplFrom = tplHole.length }
  const exps = pbExportsIn(o[30], nb, ne)
  const exPB: i32[] = []
  const exPN: i32[] = []
  const exP: string[] = []
  let r = o[24]
  while r < extDeclVl.length {
    exPB.push(exP.length)
    exPN.push(extDeclParN[r])
    let j = 0
    while j < extDeclParN[r] {
      exP.push(extDeclParTys[extDeclParBase[r] + j])
      j = j + 1
    }
    r = r + 1
  }
  const egN: string[] = []
  let g = o[25]
  while g < extGDeclLink.length {
    egN.push(extGNames[extGDeclLink[g]])
    g = g + 1
  }
  const s: PbSide = {
    ok: true,
    ntok: pbMvList(nodeToks, o[5], tb, te, -tb),
    dntOn: dntOn,
    dnt: pbMvList(declNameTok, dntFrom, tb, te, -tb),
    tplOn: tplOn,
    tpl: pbInts(tplHole, tplFrom),
    tsK: pbInts(tsKind, sb),
    tsT: pbStrs(tsText, sb),
    tsS: pbMvList(tsKidStart, sb, kb, ke + 1, -kb),
    tsC: pbInts(tsKidCount, sb),
    tsKd: pbMvList(tsKids, kb, sb, se, -sb),
    annN: pbMvList(annTsNode, o[8], nb, ne, -nb),
    annR: pbMvList(annTsRoot, o[8], sb, se, -sb),
    annW: pbMvList(annTsWritten, o[8], sb, se, -sb),
    ctaC: pbMvList(callTaCall, o[9], nb, ne, -nb),
    ctaS: pbMvList(
      callTaStart,
      o[9],
      o[10],
      callTaNodes.length + 1,
      -o[10],
    ),
    ctaN: pbInts(callTaCount, o[9]),
    ctaNd: pbMvList(callTaNodes, o[10], nb, ne, -nb),
    ctaE: pbInts(callTaEnds, o[10]),
    udN: pbMvList(udTsNode, o[11], nb, ne, -nb),
    udR: pbMvList(udTsRoot, o[11], sb, se, -sb),
    udW: pbMvList(udTsWritten, o[11], sb, se, -sb),
    gpN: pbMvList(declGpNode, o[12], nb, ne, -nb),
    gpB: pbStrs(declGpBase, o[12]),
    gpS: pbMvList(
      declGpStart,
      o[12],
      o[13],
      declGpName.length + 1,
      -o[13],
    ),
    gpC: pbInts(declGpCount, o[12]),
    gpNm: pbStrs(declGpName, o[13]),
    btd: pbMvList(bodyTyDeclNode, o[14], nb, ne, -nb),
    vif: pbMvList(valueIfNodes, o[15], nb, ne, -nb),
    fns: pbMvList(funcDeclNodes, o[16], nb, ne, -nb),
    sbr: pbMvList(stmtBraceNodes, o[17], nb, ne, -nb),
    sbt: pbMvList(stmtBraceTails, o[18], nb, ne, -nb),
    bns: pbMvList(braceNameStmts, o[19], nb, ne, -nb),
    exps: exps,
    rdf: pbMvList(recDupField, o[20], nb, ne, -nb),
    tpbF: pbMvList(fnTpBoundFn, o[21], nb, ne, -nb),
    tpbI: pbInts(fnTpBoundIx, o[21]),
    tpbA: pbMvList(fnTpBoundAnn, o[21], nb, ne, -nb),
    dbdN: pbMvList(declBoundNode, o[22], nb, ne, -nb),
    dbdA: pbMvList(declBoundAnn, o[22], nb, ne, -nb),
    getN: pbMvList(getDeclNodes, o[23], nb, ne, -nb),
    getE: pbBools(getDeclExps, o[23]),
    exN: pbStrs(extDeclVl, o[24]),
    exR: pbStrs(extDeclRet, o[24]),
    exP: exP,
    exPB: exPB,
    exPN: exPN,
    exPos: pbMvList(extDeclPos, o[24], tb, te, -tb),
    egN: egN,
    egT: pbStrs(extGDeclTy, o[25]),
    egM: pbInts(extGDeclMut, o[25]),
    egPos: pbMvList(extGDeclPos, o[25], tb, te, -tb),
    egNd: pbMvList(extGDeclNode, o[25], nb, ne, -nb),
  }
  s.ok = !pbBadTake()
  s
}

// Whether `pbSidePut` can lay a bank down on the arena as it stands: the two lazily grown
// columns must not already reach past the nodes, or padding them would not match a parse.
export function pbSideFits(): boolean {
  declNameTok.length <= P.nodes.length && tplHole.length <= P.nodes.length
}

// Append bank `s` as the parse of a module with `nn` nodes from `nb` and `nt` tokens from
// `tb` would have: the same rows, every index moved onto the current ends.
export function pbSidePut(s: PbSide, nb: i32, nn: i32, tb: i32, nt: i32) {
  const sb = tsKind.length
  const kb = tsKids.length
  const ns = s.tsK.length
  const nk = s.tsKd.length
  pbIntPush(tsKind, s.tsK)
  pbStrPush(tsText, s.tsT)
  pbMvPush(tsKidStart, s.tsS, 0, nk + 1, kb)
  pbIntPush(tsKidCount, s.tsC)
  pbMvPush(tsKids, s.tsKd, 0, ns, sb)
  nodeToks = pbMvCat(nodeToks, s.ntok, nt, tb)
  if s.dntOn {
    while declNameTok.length < nb { declNameTok.push(-1) }
    declNameTok = pbMvCat(declNameTok, s.dnt, nt, tb)
  }
  if s.tplOn {
    while tplHole.length < nb { tplHole.push(0) }
    if tplHole.length == 0 {
      tplHole = pbInts(s.tpl, 0)
    } else {
      pbIntPush(tplHole, s.tpl)
    }
  }
  pbMvPush(annTsNode, s.annN, 0, nn, nb)
  pbMvPush(annTsRoot, s.annR, 0, ns, sb)
  pbMvPush(annTsWritten, s.annW, 0, ns, sb)
  const cb = callTaNodes.length
  pbMvPush(callTaCall, s.ctaC, 0, nn, nb)
  pbMvPush(callTaStart, s.ctaS, 0, s.ctaNd.length + 1, cb)
  pbIntPush(callTaCount, s.ctaN)
  pbMvPush(callTaNodes, s.ctaNd, 0, nn, nb)
  pbIntPush(callTaEnds, s.ctaE)
  pbMvPush(udTsNode, s.udN, 0, nn, nb)
  pbMvPush(udTsRoot, s.udR, 0, ns, sb)
  pbMvPush(udTsWritten, s.udW, 0, ns, sb)
  const gb = declGpName.length
  pbMvPush(declGpNode, s.gpN, 0, nn, nb)
  pbStrPush(declGpBase, s.gpB)
  pbMvPush(declGpStart, s.gpS, 0, s.gpNm.length + 1, gb)
  pbIntPush(declGpCount, s.gpC)
  pbStrPush(declGpName, s.gpNm)
  pbMvPush(bodyTyDeclNode, s.btd, 0, nn, nb)
  pbMvPush(valueIfNodes, s.vif, 0, nn, nb)
  pbMvPush(funcDeclNodes, s.fns, 0, nn, nb)
  pbMvPush(stmtBraceNodes, s.sbr, 0, nn, nb)
  pbMvPush(stmtBraceTails, s.sbt, 0, nn, nb)
  pbMvPush(braceNameStmts, s.bns, 0, nn, nb)
  let i = 0
  while i < s.exps.length {
    exportDeclAdd(s.exps[i] + nb)
    i = i + 1
  }
  pbMvPush(recDupField, s.rdf, 0, nn, nb)
  pbMvPush(fnTpBoundFn, s.tpbF, 0, nn, nb)
  pbIntPush(fnTpBoundIx, s.tpbI)
  pbMvPush(fnTpBoundAnn, s.tpbA, 0, nn, nb)
  pbMvPush(declBoundNode, s.dbdN, 0, nn, nb)
  pbMvPush(declBoundAnn, s.dbdA, 0, nn, nb)
  pbMvPush(getDeclNodes, s.getN, 0, nn, nb)
  let q = 0
  while q < s.getE.length {
    getDeclExps.push(s.getE[q])
    q = q + 1
  }
  pbExternPut(s, tb, nt, nb, nn)
  0
}

// The module's extern rows, re-added in declaration order so the link rows dedupe against
// the modules parsed ahead of it exactly as a fresh parse's would.
function pbExternPut(s: PbSide, tb: i32, nt: i32, nb: i32, nn: i32) {
  let r = 0
  while r < s.exN.length {
    const ps: string[] = []
    let j = 0
    while j < s.exPN[r] {
      ps.push(s.exP[s.exPB[r] + j])
      j = j + 1
    }
    externAdd(s.exN[r], ps, s.exR[r], pbMv(s.exPos[r], 0, nt, tb))
    r = r + 1
  }
  let g = 0
  while g < s.egN.length {
    externGlobalAdd(
      s.egN[g],
      s.egT[g],
      s.egM[g],
      pbMv(s.egPos[g], 0, nt, tb),
      pbMv(s.egNd[g], 0, nn, nb),
    )
    g = g + 1
  }
  0
}
