export function mkFieldInit(name: string, value: i32, pos: i32) {
  const n: Node = { fiName: name, fiValue: value, pos: pos }
  addNode(n)
}

export function mkObjLit(fields: i32[], pos: i32) {
  const n: Node = { objFields: fields, pos: pos }
  addNode(n)
}

export function mkUnionDecl(
  name: string,
  variants: string[],
  pos: i32,
  isNew: i32,
) {
