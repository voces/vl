// AST + token model for the VL-in-VL parser (the H3 self-hosting track). The data
// layer the parser builds onto; `compiler/parser.vl` imports the token type, the
// parser state `P`, and the arena constructors from here.
//
// ── A discriminated-union AST ────────────────────────────────────────────────
// Each node KIND is its own struct `type` (`NumLit`, `BinExpr`, `Call`, …); the
// `Node` alias unions them, and the parser/printer discriminate with `is`. The
// kind is the runtime VARIANT, not a tag field, so a mis-parse can't silently
// read the wrong slot.
//
// Discrimination is by structural SHAPE (WasmGC erases field names but the variant
// tag is field-name-aware): two variants tell apart iff their field-name sets
// differ. So every variant uses a DISTINCT field-name prefix (`num*`, `bin*`,
// `call*`, …) — no variant's fields are a subset of another's — which keeps `is`
// unambiguous across all kinds. (A discriminant `tag` field would also work for
// genuinely same-shape variants; here the natural shapes already differ.)
//
// ── Children by ARENA INDEX ──────────────────────────────────────────────────
// A node references its children by their `i32` position in a flat `Node[]` arena
// (`-1` == none), and child LISTS by `i32[]`. This is orthogonal to the union: it
// sidesteps needing a *recursive* type alias (`BinExpr` holding `left: Node`),
// which VL's alias resolver can't express yet (a union alias can't forward- or
// self-reference its members), and is how many production self-hosted parsers
// represent their AST anyway. The arena lives in a STRUCT FIELD (`Parser.nodes`),
// and constructors `.push` straight onto it. (The struct is reached via a module
// GLOBAL rather than a parameter — see the `Parser` note below for why.)

import { TokKind } from "./lexer"

// ── Token ────────────────────────────────────────────────────────────────────
// A token consumed by the parser. `kind` is the lexer's closed `TokKind` literal
// union — an i32 atom, so a `kind == "IDENT"` test is an `i32.eq` and a kind that
// is not in the vocabulary is a type error rather than a silent never-match.
//
// `pos` is the token's INDEX in the stream (the cursor unit the parser and diags
// use); `start` / `line` / `col` are the SOURCE position of its first char (char
// offset 0-based, line 1-based, column 0-based), mirroring the lexer's `LexTok`.
// The parser never reads those three — diagnostics reach them through the
// `nodeToks` side table below — so a hand-built token stream with no real source
// (a self-host test harness) may pass `0` / `1` / `0` for them.
export type Tok = {
  kind: TokKind,
  text: string,
  pos: i32,
  start: i32,
  line: i32,
  col: i32,
}

// ── AST node variants ──────────────────────────────────────────────────────
// One struct per kind. `i32` fields holding a child are an arena INDEX (`-1` ==
// none); `i32[]` fields are a child list. Literal payloads keep their source
// `text` (the parser has no reason to evaluate a number, and keeping the lexeme
// also sidesteps int→f64 field coercion). `boolVal` is `0`/`1` (no `boolean`
// field needed). Field names are per-variant prefixed so `is` discriminates.
//
// `pos` is on EVERY variant — the CHAR OFFSET of the construct's START token
// (captured before its children are parsed), or -1 for a synthesized node. One
// shared field is safe for `is` because each variant pair still differs by its
// prefixed field names, so no variant's name set becomes a subset of another's.
// Only the diagnostics layer reads it; no pass discriminates on it.

// Expressions ----------------------------------------------------------------
export type NumLit = { numText: string, pos: i32 }         // 12, 3.14
export type StrLit = { strText: string, pos: i32 }         // "hi" (raw)
export type CharLit = { charText: string, pos: i32 }       // 'a'  (raw)
export type BoolLit = { boolVal: i32, pos: i32 }           // true=1 / false=0
export type NullLit = { nullKw: string, pos: i32 }         // null
export type Ident = { identName: string, pos: i32 }        // x
export type Unary = { unOp: string, unArg: i32, pos: i32 } // !x  -x
// `binCompound` is the SURFACE compound-assignment operator (`+`/`-`/`*`/`/`) for
// an `a += b` that desugars to `a = a + b`, else "" — a faithful-surface marker
// (the host's `compoundOperator`) the printer reads to reprint the written form
// without re-scanning tokens. Typecheck/emit ignore it (they read the desugared
// `binLeft`/`binRight`).
// `binTpl` is the second faithful-surface marker beside `binCompound`: 1 marks
// the ROOT `+` of the concatenation a backtick TEMPLATE literal desugared to, so
// the printer reprints the template's own source bytes instead of the concat.
// Its span covers the whole template (the node is built after the closing
// backtick is consumed, so `pos` .. `nodeEndOf` is `` ` `` .. `` ` ``), which is
// all `format.vl` needs. Typecheck/emit ignore it, exactly as they ignore
// `binCompound`.
export type BinExpr = {
  binOp: string,
  binLeft: i32,
  binRight: i32,
  pos: i32,
  binCompound: string,
  binTpl: i32,
} // a + b,  a = b,  a += b
// A call `f(a, b)` / `f(a: 2, b: 1)`. `callArgs` are the argument VALUE nodes in
// SOURCE order; `callArgNames` is the parallel per-argument NAME list ("" = a
// positional argument). An all-positional call may carry an EMPTY names list
// (the common case — every consumer treats a missing entry as ""). Mirrors the
// host's `VLArgumentNode.name` (`makeArgument` in parser.ts); binding to
// parameters happens in the checker/emitter via `orderArgsByParamNames`.
export type Call = {
  callFn: i32,
  callArgs: i32[],
  callArgNames: string[],
  pos: i32,
}  // f(a, b) / f(b: 1, a: 2)
export type Member = { memObj: i32, memProp: string, pos: i32 }  // o.field
export type OptMember = { omObj: i32, omProp: string, pos: i32 } // o?.field (null-safe)
export type Paren = { parInner: i32, pos: i32 }                  // ( e )
export type ErrExpr = { errWhat: string, errAt: i32, pos: i32 }  // recovery leaf

// Statements -----------------------------------------------------------------
export type LetDecl = { // let/const x: T = e
  letKw: string, // "let" | "const"
  letName: string,
  letType: i32,  // type-annotation node, -1 if none
  letInit: i32,  // initializer node, -1 if none
  pos: i32,
}
// A parameter `a: i32`, optionally carrying a DEFAULT VALUE (`a: i32 = 0`).
// `parDefault` is the default expression's arena index (-1 = none); `parOpt` is
// 1 for the surface spelling `a?: i32`, which is sugar for `a: i32 | null =
// null` — a faithful-surface marker the printer reads to reprint `?`, exactly
// as `IsExpr.isNeg` marks a surface `!is`. Everything downstream of the parser
// reads the desugared `parType` + `parDefault` and ignores `parOpt`.
export type Param = {
  parName: string,
  parType: i32,
  parDefault: i32,
  parOpt: i32,
  pos: i32,
} // a: i32,  a: i32 = 0,  a?: i32
export type TypeRef = { tyName: string, pos: i32 } // i32 (annotation)
export type FuncDecl = {                           // function f<T?>(..): T {..}
  fnName: string,
  fnTyParams: string[], // generic type-parameter names (`<T, U>`), empty if none
  fnParams: i32[],
  fnRet: i32,           // return-type node, -1 if none
  fnBody: i32,          // block node
  pos: i32,
}
export type IfStmt = { // if c {..} else {..}
  ifCond: i32,
  ifThen: i32, // then block
  ifElse: i32, // else node (block or nested if), -1 if none
  pos: i32,
}
// Loops carry an optional LABEL (`outer: while …` / `outer: for …`; "" = none),
// the target of a labelled `break`/`continue` — mirroring the host's
// `label: string | undefined` on `VLWhileNode`/`VLForNode`/`VLForInNode`.
export type WhileStmt = {
  whileCond: i32,
  whileBody: i32,
  whileLabel: string,
  pos: i32,
} // [l:] while c { body }
// `break` / `continue` loop-control statements. Each carries the optional loop
// LABEL it targets (`break outer`; "" = the innermost loop) plus a marker field
// (`brkKw` / `contKw`, the source keyword text) that gives the `brk`/`cont`
// prefixes a distinct field-name SET — the header's discrimination rule. Mirrors
// `VLBreakNode` / `VLContinueNode` (whose `label` is undefined when absent).
export type BreakStmt = { brkKw: string, brkLabel: string, pos: i32 } // break [label]
export type ContinueStmt = { contKw: string, contLabel: string, pos: i32 } // continue [label]
// `for v in A to B [step S] { body }` — a numeric RANGE loop; `frStep` is the step
// EXPRESSION node index, or -1 for the implicit +1. `for v in iterable { body }` —
// a for-IN loop over an array, binding `v` to the element type.
export type ForRange = {
  frVar: string,
  frFrom: i32,
  frTo: i32,
  frStep: i32,
  frBody: i32,
  frLabel: string,
  pos: i32,
}
export type ForIn = {
  fiVar: string,
  fiIter: i32,
  fiBody: i32,
  fiLabel: string,
  pos: i32,
} // [l:] for v in arr { body }
// `match scrut { pat => body … }` — exhaustive value dispatch. Each arm `i` matches one of the
// patterns in `matchPats[matchArmStart[i] .. +matchArmCount[i]]` (an OR-group; a wildcard `_` is an
// `Ident "_"` pattern) and runs `matchBodies[i]` (an expr, often a Block). Value-returning.
//
// `matchBinds` is PARALLEL TO `matchPats` (not to the arms): entry `matchBinds[p]` is pattern `p`'s
// payload-binding clause `{x, y}` — a `Block` node holding one `const x = scrut.x` per bound field
// — or -1 when the pattern has none. The `LetDecl`s are minted in the PARSER beside the pattern
// (phase 2b; `nodeTyIx` is sized to the arena at `checkProgram` entry, so a node minted at desugar
// time reads back -1 forever), and the desugar prepends them to the arm's block. They are NOT in
// the body until then, so the formatter prints the arm the user wrote.
export type MatchExpr = {
  matchScrut: i32,
  matchPats: i32[],
  matchBinds: i32[],
  matchArmStart: i32[],
  matchArmCount: i32[],
  matchBodies: i32[],
  pos: i32,
}
export type RetStmt = { retArg: i32, pos: i32 }      // return e?  (-1 bare)
export type Block = { blkStmts: i32[], pos: i32 }    // { stmt* }
export type Program = { progStmts: i32[], pos: i32 } // top-level stmt*

// Modules ---------------------------------------------------------------------
// An `import { a, b as c, … } from "path"` statement. A TOOLING node: module
// RESOLUTION stays the driver's token-level `modScan` (which never reads the
// AST), the checker/emitter skip it, and the formatter keeps reproducing
// imports from the token stream — the node exists so AST consumers (the lint
// tier) can SEE imports (e.g. flag a never-referenced imported name).
//   impPath     — the module specifier, quotes stripped ("" when malformed).
//   impNames    — the imported (source) names, in source order.
//   impLocals   — parallel local bindings (the `as` alias, else the name).
//   impNameToks — parallel TOKEN indices of each name token (diagnostic anchors).
// A bare `import x from "path"` records NO names (a pure graph edge, exactly
// `modScan`'s reading); a re-export `export { … } from "path"` stays a no-op.
export type ImportDecl = {
  impPath: string,
  impNames: string[],
  impLocals: string[],
  impNameToks: i32[],
  pos: i32,
}

// Structs --------------------------------------------------------------------
// A struct TYPE declaration `type Name = { field: Type, ... }` and the OBJECT
// LITERAL `{ field: value, ... }` that constructs one. Prefixes: `td`/`fd` for
// the type decl + its fields, `obj`/`fi` for the literal + its field inits. A
// struct-type ANNOTATION (`p: Point`) reuses the existing `TypeRef` (a bare name).
export type FieldDef = { fdName: string, fdType: i32, pos: i32 } // x: i32  (in a type decl)
// `tdNew` marks a NOMINAL NEWTYPE body (`type F32View = new { … }`) and `tdFlat` a
// FLAT RECORD body (`flat type TValue = { … }`) — two declaration-surface markers
// read by exactly ONE consumer, the checker's declaration pre-pass, and erased
// before emit. A newtype's emit vocabulary is the un-branded shape's; a flat type
// is an ORDINARY record that has additionally been validated (scalars / newtypes
// over scalars / nested flat only) and MEASURED (byte offsets, total size), so
// nothing is subtracted and `flat` emits exactly as the same declaration without
// it. There is no `udFlat` twin: the parser's syntactic fork rejects a non-record
// body, so the marker never has to travel on a `UnionDecl`. See
// `docs/internals/newtype-design.md` §3 and `docs/internals/flat-records-design.md`.
export type TypeDecl = {
  tdName: string,
  tdFields: i32[],
  pos: i32,
  tdNew: i32,
  tdFlat: i32,
} // type Name = { f: T, ... }
export type FieldInit = { fiName: string, fiValue: i32, pos: i32 } // x: 7    (in an object literal)
export type ObjLit = { objFields: i32[], pos: i32 }                // { x: 7, y: 9 }

// Arrays ---------------------------------------------------------------------
// An ARRAY LITERAL `[e, e, ...]` that constructs a fixed-length WasmGC array and
// an INDEX access `a[i]` (read, or — when the LHS of a `=` — write). Prefixes:
// `arr` for the literal's element list, `idx` for the index's array+index pair. An
// array TYPE annotation (`a: i32[]`) reuses `TypeRef` with a synthetic `"i32[]"`
// name — see `parseType` — so no new annotation node is needed.
export type ArrayLit = { arrElems: i32[], pos: i32 }         // [1, 2, 3]
export type Index = { idxArr: i32, idxIndex: i32, pos: i32 } // a[i]

// Unions ---------------------------------------------------------------------
// A discriminated-union TYPE ALIAS `type Name = A | B | C` (a `UnionDecl` whose
// `udVariants` are the member type-NAMES, in source order) and the type-guard
// EXPRESSION `x is T` (an `IsExpr` testing whether `isObj` is currently the
// variant named `isVariant`, yielding a boolean and — in an `if` — narrowing
// `isObj` to that variant). Prefixes: `ud` for the union decl, `is` for the guard.
// `udNew` is the `tdNew` twin for the non-`{`-bodied forms: every
// `type N = <not a brace body>` parses as a one-member `UnionDecl`, so a scalar
// newtype (`type EntityId = new i32`) is a one-member union carrying this marker.
export type UnionDecl = {
  udName: string,
  udVariants: string[],
  pos: i32,
  udNew: i32,
} // type N = A | B
// `isNeg` is 1 for a surface `x !is T` (desugared to `!(x is T)`), else 0 — a
// faithful-surface marker the printer reads to reprint `!is`. Typecheck/emit
// ignore it (the wrapping `Unary "!"` carries the negation).
export type IsExpr = { isObj: i32, isVariant: string, pos: i32, isNeg: i32 } // x is T,  x !is T

// EXPRESSION `x as T` — an explicit, CHECKED numeric conversion (B2). `asObj` is
// the arena index of the operand expression; `asTy` is the target type stored as
// a synthetic NAME STRING (mirroring `IsExpr.isVariant`), which the checker
// resolves with `nameToTy`. The `as` field prefix keeps this variant's field-name
// set distinct so `is`-discrimination stays unambiguous.
// Which member of the ruled `as` TRIO this cast is (`error-handling-design.md` §Trio):
// `"prop"` early-returns the remainder to the caller, `"null"` yields `null`, `"trap"` traps.
// The happy path is identical in all three — `x as T`, `x as? T` and `x as! T` all yield a `T`
// when `x` is a `T`; only the sad path differs, which is why one node carries all three.
export type AsMode = "prop" | "null" | "trap"
export type AsExpr = { asObj: i32, asTy: string, asMode: AsMode, pos: i32 } // x as T

// The unified node type. Declared AFTER its members (a union alias can't forward-
// reference). Discriminated with `is`.
export type Node = NumLit |
  StrLit |
  CharLit |
  BoolLit |
  NullLit |
  Ident |
  Unary |
  BinExpr |
  Call |
  Member |
  OptMember |
  Paren |
  ErrExpr |
  LetDecl |
  Param |
  TypeRef |
  FuncDecl |
  IfStmt |
  WhileStmt |
  BreakStmt |
  ContinueStmt |
  RetStmt |
  Block |
  Program |
  FieldDef |
  TypeDecl |
  FieldInit |
  ObjLit |
  ArrayLit |
  Index |
  UnionDecl |
  IsExpr |
  AsExpr |
  ForRange |
  ForIn |
  MatchExpr |
  ImportDecl

// A parse diagnostic: a message plus the token index it was raised at. VL has no
// exceptions, so errors are accumulated, not thrown.
export type Diag = { msg: string, at: i32 }

// ── Parser state (all in STRUCT FIELDS, held in a module GLOBAL) ──────────────
// The whole parser state is one struct: the token stream, the node arena, the
// diagnostics, and the cursor. The arena and diagnostics live in struct fields
// and the constructors `.push` straight onto them.
//
// The struct is reached through a module GLOBAL `P` — a STYLE choice: it keeps
// every call site free of a boilerplate state argument.
export type Parser = {
  toks: Tok[],
  nodes: Node[],
  diags: Diag[],
  pos: i32,
}

// The single parser instance. The harness fills `P.toks`, runs the parser, and
// reads `P.nodes` / `P.diags` back out.
export let P: Parser = { toks: [], nodes: [], diags: [], pos: 0 }

// ── The LOSSLESS column, beside `P.diags` ────────────────────────────────────
// The `P.diags` INDICES whose diagnostic came from a recovery that PROVABLY
// preserved the program the user wrote: no token dropped, none invented. The
// driver's stage-1 rule (DECISIONS.md, 2026-09-01) lets the checker run past
// parse diagnostics IFF EVERY one is in here — so a real type error after a
// recovered mistake is reported rather than swallowed, without the PHANTOM
// errors a lossy recovery invents (`f(1 2)` re-parses to a hole-free `f(1)`).
// SPARSE and index-keyed like the driver's `vcDg*` table: a dense column would
// need pushing in LOCKSTEP by every `P.diags.push` in the tree, and the one that
// forgot would mis-key every later entry — absent is the safe default. Reset per
// compile from `vcDgReset`; the LSP re-enters `checkSrc` per keystroke on one
// instance, so a stale index would vouch for the PREVIOUS program's diagnostic.
export let dgLossless: i32[] = []

// Clear the column. Paired with `P.diags = []`; see `vcDgReset` in driver.vl.
export function dgLosslessReset() {
  dgLossless = []
  0
}

// Mark the `P.diags` index `i` as a lossless recovery's diagnostic. Callers pass
// the index the push is ABOUT to occupy (`P.diags.length`), matching `vcDgPush`.
export function dgMarkLossless(i: i32) {
  dgLossless.push(i)
  0
}

// Whether EVERY parse diagnostic raised so far is a lossless recovery's. VACUOUSLY
// TRUE for a clean parse — callers that care about the difference test
// `P.diags.length` themselves, as the driver's `vcParseBlocked` does. The scan is
// O(diags × marks) and both are user-error counts, so it is a handful of
// comparisons on the only path that reaches it.
export function dgAllLossless(): boolean {
  let i = 0
  while i < P.diags.length {
    let found = false
    let k = 0
    while k < dgLossless.length {
      if dgLossless[k] == i { found = true }
      k = k + 1
    }
    if !found { return false }
    i = i + 1
  }
  true
}

// ── Node → token side table ──────────────────────────────────────────────────
// `nodeToks[i]` is the TOKEN INDEX of the LAST token consumed when `P.nodes[i]`
// was constructed (`addNode` records `P.pos - 1`) — exact for single-token leaves,
// the closing token for larger constructs. Enough to render a `line:col`; a full
// start/stop span is a later refinement (docs/selfhost-spans-design.md). A SIDE
// ARRAY, not a field per variant, keeps every node struct — and the
// `is`-discrimination shape set — untouched.
//
// CONSUMERS MUST BOUNDS-CHECK: a harness that resets `P.nodes` without resetting
// `nodeToks` can leave the table misaligned, so readers (`tErr` in typecheck.vl,
// the driver's `diagLine`/`diagCol`) treat an index out of range — of this table
// or of `P.toks` — as "no position". The production driver resets both together.
export let nodeToks: i32[] = []

// ── Declaration name → token side table (LSP symbols) ────────────────────────
// `declNameTok[i]` is the TOKEN INDEX of the DECLARING IDENTIFIER for the node
// `P.nodes[i]`, when that node is a declaration (`let`/`const`, `function`,
// param, `type`, union, a for-loop variable). `nodeToks[i]` anchors a node at
// its LAST token (the closing token of `let x = expr` is `expr`'s end, not `x`),
// which is the wrong span for go-to-definition / find-references: an editor jumps
// to / highlights the NAME. So the parser records the name token here at the
// declaration site (`mkDeclNameTok`); a `-1` (the default for non-declarations,
// or a node whose name token was never stamped) tells readers to fall back to
// `nodeToks`. PARALLEL to `P.nodes` — grown lazily, so it stays cheap when the
// symbol table is not being built. BOUNDS-CHECK on read (a misaligned table is
// "no name token", never a trap), the same contract as `nodeToks`.
export let declNameTok: i32[] = []

// Record `tok` as the declaring-identifier token of `nodeIx`. Grows the parallel
// table to cover `nodeIx` (filling the gap with `-1`). The parser calls this
// right after constructing a declaration node, passing the token index it
// captured when it read the name.
export function mkDeclNameTok(nodeIx: i32, tok: i32) {
  while declNameTok.length <= nodeIx { declNameTok.push(-1) }
  declNameTok[nodeIx] = tok
  0
}

// The declaring-identifier token of `nodeIx` (its NAME token), or `-1` when none
// was stamped — readers then fall back to the node's anchor token (`nodeToks`).
export function declNameTokOf(nodeIx: i32) {
  if nodeIx >= 0 && nodeIx < declNameTok.length { return declNameTok[nodeIx] }
  -1
}

// Whether the top-level declaration at arena node `ix` carried an `export`
// modifier. The native parser DROPS the `export` keyword from the AST (the back
// end exports every top-level function by name regardless), so it is recovered
// from the token stream: a top-level `function` is `EXPORT? FUNCTION IDENT`, so
// the name token `declNameTokOf(ix)` is exported iff the token two positions back
// is the `EXPORT` keyword.
//
// LIVES HERE, next to `declNameTokOf`, because it is that table's reader and has
// two callers with nothing else in common: `lint.declIsExported`'s three
// unused-* rules, and `check_query.symUfcsScanAt`, which must not offer a dep
// module's PRIVATE `self`-function as an importable UFCS method (`std:str`'s
// `mapAsciiCase` — a helper, not an export, so an import of it is refused).
export function declHasExportKw(ix: i32) {
  const t = declNameTokOf(ix)
  if t < 2 { return false }
  const kw = t - 2
  if kw >= 0 && kw < P.toks.length { return P.toks[kw].kind == "EXPORT" }
  false
}

// ── Parameter-DEFAULT side tables (default arguments v1) ─────────────────────
// Two sidecars PARALLEL to `P.nodes`, lazily grown and bounds-checked on read
// (the `nodeToks` contract), reset by `paramDefaultTablesReset` before each
// `checkProgram` so a re-parsed arena never reads the previous program's marks.
// `callSiteLoc[callIx]` — the `__callsite__` `ObjLit` minted for THAT call from
// its own anchor token. A PRE-PASS (`csPreMintLocs`, driver.vl), not a rewrite:
// a node minted after `checkProgram` sizes `nodeTyIx` reads its type back as -1
// forever (D969), and this one must be typed, repped and collected. Every OTHER
// default is a node shared by every call site; `__callsite__` alone is per-site.
// `defaultGlobalRef[identIx]` — 1 when this `Ident` default resolved to a
// MODULE-SCOPE `const` at the DECLARATION, so checker and emitter skip the local
// scope and a caller-local binding of that name cannot capture the reference.
export let callSiteLoc: i32[] = []
export let defaultGlobalRef: i32[] = []

// The spelling of the call-site intrinsic. Legal ONLY as a parameter default
// value; anywhere else it is an ordinary (undeclared) identifier, and the
// checker says so by name.
export const CALLSITE_NAME = "__callsite__"

export function paramDefaultTablesReset() {
  callSiteLoc = []
  defaultGlobalRef = []
  0
}

export function setCallSiteLoc(callIx: i32, locIx: i32) {
  if callIx < 0 { return 0 }
  while callSiteLoc.length <= callIx { callSiteLoc.push(-1) }
  callSiteLoc[callIx] = locIx
  0
}

export function callSiteLocOf(callIx: i32) {
  if callIx >= 0 && callIx < callSiteLoc.length { return callSiteLoc[callIx] }
  -1
}

export function markDefaultGlobalRef(nodeIx: i32) {
  if nodeIx < 0 { return 0 }
  while defaultGlobalRef.length <= nodeIx { defaultGlobalRef.push(0) }
  defaultGlobalRef[nodeIx] = 1
  0
}

export function isDefaultGlobalRef(nodeIx: i32) {
  if nodeIx >= 0 && nodeIx < defaultGlobalRef.length {
    return defaultGlobalRef[nodeIx] == 1
  }
  false
}

// Is `dIx` the `__callsite__` intrinsic — the one default form whose value is
// per-CALL-SITE rather than per-declaration? The parser leaves it as a plain
// `Ident`; nothing declares that name, so this spelling test is exact.
export function paramDefaultIsCallsite(dIx: i32) {
  if dIx < 0 || dIx >= P.nodes.length { return false }
  const d = P.nodes[dIx]
  if d is Ident { return d.identName == CALLSITE_NAME }
  false
}

// The END char offset (one-past-last) of the source `P.nodes[nodeIx]` spans — the
// STOP offset of the LAST token consumed when the node was built (its `nodeToks`
// anchor). Paired with the node's `pos` (its START offset), this is the
// `[start, stop)` source span the formatter slices verbatim. A token's lexeme IS
// its exact source slice, so its stop offset is `start + text.length` (offsets and
// `string.length` count the same unit). Returns `-1` when `nodeIx`, its `nodeToks`
// entry, or the resolved token is out of range — the same "no span" signal a
// negative `pos` gives for a synthesized node. BOUNDS-CHECKED, like `nodeToks` /
// `declNameTok`: a misaligned table is "no span", never a trap. Reads only
// concrete `Tok` fields (no node-union field access — VL has no common-field read
// across variants), so it stays a plain index→offset lookup.
export function nodeEndOf(nodeIx: i32) {
  if nodeIx < 0 || nodeIx >= nodeToks.length { return -1 }
  const tk = nodeToks[nodeIx]
  if tk < 0 || tk >= P.toks.length { return -1 }
  const t = P.toks[tk]
  t.start + t.text.length
}

// ── Type-SPELLING side arena (the parser KEEPS what it parsed) ───────────────
// `parseTypeName` returns a STRING (`"A|B"`, `"i32[]"`, `"{[string]:i32}"`,
// `"(i32)=>S"`) that every later pass takes apart again. This arena is what the
// parser saw, as a flat SPELLING tree: `tsKind[i]` the kind (`TS_*` below),
// `tsText[i]` the identifier / lexeme / field / map key, children at
// `tsKids[tsKidStart[i], +tsKidCount[i])`.
// A SPELLING tree, NOT a type: `Box<i32>` is an APPLICATION of the identifier
// `Box`. Resolving it needs the declared-type environment (`cUserTypes`, the live
// `<T>` bindings), which cannot exist while the parser runs — a type may be
// declared after its use, or in another module — so interning is the checker's
// job. Children ride a shared STACK that `tsMk` moves into `tsKids` above a
// caller-taken mark, contiguous by depth-first parsing: four pushes, no allocation.
export const TS_NAME = 0    // a bare identifier or primitive name (`i32`, `Cat`, `T`)
export const TS_APP = 1     // `Head<a, b>` — tsText = head, kids = the arguments
export const TS_ARR = 2     // `X[]` — one kid
export const TS_UNION = 3   // `A | B | …` — two or more kids
export const TS_ISECT = 4   // `A & B` — two or more kids
export const TS_NEG = 5     // `!A` — one kid
export const TS_PAREN = 6   // `(A)` / `(A, B)` — the comma list
export const TS_FUNC = 7    // `(params) => ret` — kids = the params, then the RETURN last
export const TS_MAP = 8     // `{[K]: V}` — tsText = the key name, one kid = V
export const TS_OBJ = 9     // `{x: T, y: U}` — kids = `TS_FIELD` nodes
export const TS_FIELD = 10  // one inline-object field — tsText = its name, one kid = its type
export const TS_LITSTR = 11 // a string-literal type — tsText keeps the QUOTED lexeme
export const TS_LITNUM = 12 // a numeric-literal type — tsText is the raw lexeme
export const TS_NULL = 13   // the `null` type
export const TS_ERR = 14    // the `expect("IDENT")` recovery leaf (the parser's `""` name)
// `m(A, B): R` — a METHOD member of a type literal (constraints phase 1). tsText
// is the member's name; the kids are the CALL's argument types, then the RESULT
// last — `TS_FUNC`'s layout, because a method member IS a call shape with the
// receiver left implicit (`docs/constraints-design.md`, OQ-1 as ruled). It is a
// sibling of `TS_FIELD`, not a flavour of it: `{f: () => string}` demands that the
// value CARRY a closure, `{f(): string}` demands only that `x.f()` type-check.
export const TS_METHOD = 15

// ── the synthesized-annotation PIN KINDS (census W11) ────────────────────────
// An emitter-SYNTHESIZED `TypeRef` (`synthTypeRef`) sometimes carries a name the
// checker's annotation grammar cannot resolve, because the name is not a type
// SPELLING at all — it is an emitter-internal handle whose PROVENANCE is the only
// thing a reader wants. Two such handles exist, and both used to announce
// themselves by a PREFIX riding the node's `tyName` column (`"=>ii>i"`,
// `"#anon3"`), decoded by every consumer with its own character compares.
//
// A name is a name; a prefix-coded value is not. The provenance now travels in
// its OWN column — `typecheck`'s pin sidecar, keyed by node index — and these are
// its vocabulary. The payload (a `$fnsig` key, for `PIN_SIGKEY`) rides the column
// beside the kind, so a consumer neither slices nor re-parses the name.
export const PIN_NONE = 0   // an ordinary type name — `nameToTy` resolves it
export const PIN_SIGKEY = 1 // a monomorphized CLOSURE pin; payload = the `$fnsig` key
export const PIN_ANON = 2   // an interned ANONYMOUS-SHAPE row name (the emitter's `sNames`)

export let tsKind: i32[] = []
export let tsText: string[] = []
export let tsKidStart: i32[] = []
export let tsKidCount: i32[] = []
export let tsKids: i32[] = []
// The child stack. Only ever holds the nodes of the spellings currently OPEN on
// the parser's recursion, so it is empty between annotations.
let tsStack: i32[] = []

// The stack mark a producer takes BEFORE parsing its children.
export function tsMark() { tsStack.length }

// Finish a spelling node whose children are the stack region above `mark`: move
// them into `tsKids`, pop them, push the new node. Returns its arena index.
export function tsMk(kind: i32, text: string, mark: i32) {
  const start = tsKids.length
  let i = mark
  while i < tsStack.length {
    tsKids.push(tsStack[i])
    i = i + 1
  }
  const cnt = tsKids.length - start
  while tsStack.length > mark { tsStack.pop() }
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(start)
  tsKidCount.push(cnt)
  const ix = tsKind.length - 1
  tsStack.push(ix)
  ix
}

// Wrap the node on top of the stack (the `[]` array suffix: `X` → `X[]`).
export function tsWrap(kind: i32, text: string) {
  let mark = tsStack.length - 1
  if mark < 0 { mark = 0 }
  tsMk(kind, text, mark)
}

// A CHILDLESS spelling node built OFF the stack. `tsMk`'s contract is "the
// children are the stack region above a mark", which only a producer that is
// mid-recursion can satisfy; a caller that already holds finished roots (the
// `type N = {…} & …` re-encode below, the `is null` leaf) needs the plain
// constructor. Nothing is pushed to `tsStack`, so the recursion's balance is
// untouched.
export function tsLeaf(kind: i32, text: string) {
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(tsKids.length)
  tsKidCount.push(0)
  tsKind.length - 1
}

// The same, with an explicit child list. Used where the parser assembles a
// spelling from roots it already popped — `parseTypeDecl`'s `{ … } & …`
// re-encode, whose first union member is built from the FIELD list it just
// parsed rather than by a `parseTypeName` call.
export function tsMkKids(kind: i32, text: string, kids: i32[]) {
  const start = tsKids.length
  let i = 0
  while i < kids.length {
    tsKids.push(kids[i])
    i = i + 1
  }
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(start)
  tsKidCount.push(kids.length)
  tsKind.length - 1
}

// Take the finished root a type producer left on the stack. Every producer
// pushes exactly one node — the error arm pushes `TS_ERR` — so this is total on
// a producer's return; the `-1` guard is the same "never trap on a misaligned
// side table" contract `nodeToks` / `declNameTok` keep.
export function tsPop() {
  const n = tsStack.length
  if n == 0 { return -1 }
  const ix = tsStack[n - 1]
  tsStack.pop()
  ix
}

// The annotation-node → spelling-root map, as two parallel PUSH columns:
// `annTsNode[r]` is a `TypeRef` node index and `annTsRoot[r]` its spelling root.
//
// SPARSE, not parallel to `P.nodes`, and deliberately: annotations are a small
// minority of the node arena, so a `declNameTok`-shaped column (lazily grown to
// the last annotation's index) would cost one `i32` per AST NODE to hold what
// only annotations have. Two pushed rows per annotation cost what it costs.
// `annTsNode` is STRICTLY INCREASING by construction — a row is pushed right
// after the `mkTypeRef` it describes, and the node arena only appends — so
// `annTsOf` is a binary search. A harness that resets `P.nodes` without resetting
// these leaves stale rows IN FRONT of the current program's, which the search
// finds first: a missing reset is a WRONG ANSWER a consumer sees, not a hole.
export let annTsNode: i32[] = []
export let annTsRoot: i32[] = []

export function setAnnTs(nodeIx: i32, root: i32) {
  annTsNode.push(nodeIx)
  annTsRoot.push(root)
  0
}

// The MULTI-root twin, for a node whose type spellings are a LIST: a
// `UnionDecl`'s members, which live on the node as a `string[]` and so cannot
// key one root each in the single-root table above. One row per MEMBER, pushed
// in member order right after the `mkUnionDecl` that owns them, so `udTsNode` is
// NON-DECREASING (equal within a node, increasing across nodes) and a member's
// root is `udTsRoot[first(node) + k]`.
//
// A member root may be -1 — its producer left nothing on the stack (`tsPop` on
// an empty stack, reachable only from a malformed parse) — and the consumer
// keeps the string fall-through, so the pass is total either way. The
// `type N = { … } & … | …` re-encode's FIRST member is NOT such a case:
// `parseTypeDecl` assembles its spelling from the field list (`tsMkKids`).
export let udTsNode: i32[] = []
export let udTsRoot: i32[] = []

export function setUdTs(nodeIx: i32, roots: i32[]) {
  let i = 0
  while i < roots.length {
    udTsNode.push(nodeIx)
    udTsRoot.push(roots[i])
    i = i + 1
  }
  0
}

// ── the generic type-DECLARATION's parameter list, as the parser read it ──────
// `type Box<T>` folds its parameters INTO the declared name (`mkTypeDecl("Box<T>",
// …)`), and three consumers used to take them back out of that concatenation with
// a `<`-scan: `typecheck`'s generic-alias registration, and `driver.modGenBase` /
// `modGenParams`. The parser HAS the list — it advanced over the very `IDENT`
// tokens it joined — so it hands it over instead (the ANNOTATION half of the same
// arc is `annTsRoot` above).
// One row per generic declaration, keyed by the `TypeDecl` / `UnionDecl` node,
// holding the BASE name (`Box`) and a slice of the flat parameter-name column. A
// row exists iff the parser consumed a `<`, matching the `gaeLtAt(name) > 0` guard
// the copies used — a test for the `<`, not for a parameter — so `type Box<> = …`
// is still a row. Linear-scanned: generic declarations are a handful per program.
export let declGpNode: i32[] = []
export let declGpBase: string[] = []
export let declGpStart: i32[] = []
export let declGpCount: i32[] = []
export let declGpName: string[] = []

export function setDeclGp(nodeIx: i32, base: string, names: string[]) {
  declGpNode.push(nodeIx)
  declGpBase.push(base)
  declGpStart.push(declGpName.length)
  declGpCount.push(names.length)
  let i = 0
  while i < names.length {
    declGpName.push(names[i])
    i = i + 1
  }
  0
}

// The row index of `nodeIx`, or -1 when it is not a generic declaration.
function declGpRowOf(nodeIx: i32) {
  let i = 0
  while i < declGpNode.length {
    if declGpNode[i] == nodeIx { return i }
    i = i + 1
  }
  -1
}

// The BASE name of the generic declaration at `nodeIx` (`Box` of `Box<T>`), or
// "" when the node is not one — which is the answer every caller already treats
// as "this declared name is its own base".
export function declGpBaseOf(nodeIx: i32) {
  const r = declGpRowOf(nodeIx)
  if r < 0 { return "" }
  declGpBase[r]
}

// Its type-PARAMETER names in declaration order; empty for a non-generic node.
export function declGpParamsOf(nodeIx: i32): string[] {
  const out: string[] = []
  const r = declGpRowOf(nodeIx)
  if r < 0 { return out }
  const start = declGpStart[r]
  let i = 0
  while i < declGpCount[r] {
    out.push(declGpName[start + i])
    i = i + 1
  }
  out
}

// ── D1045: the BODY-SCOPED `type` declarations, marked where they are minted ──
// A `type` declared inside a block is lexically scoped (DECISIONS.md §"A `type`
// declared in a function body is legal and lexically scoped"), and the parser
// implements that scope by MANGLING the declared name unique (`P` → `P$b7`) and
// HOISTING the declaration into the program's top-level statement list — so every
// consumer that looks a type up BY NAME works on it unchanged, exactly as the
// module merge's `name$mN` rename makes two modules' `Pair` two types.
// The node is therefore reachable TWICE — at its lexical position and in
// `progStmts` — so the two consumers that must not double-count it ask here: the
// FORMATTER (which would print the declaration a second time, the reason it also
// filters `ImportDecl`) and the module merge (whose top-level visit would rename
// it with the enclosing function's type parameters NOT shadowed). Linear-scanned.
export let bodyTyDeclNode: i32[] = []

export function setBodyTyDecl(nodeIx: i32) {
  bodyTyDeclNode.push(nodeIx)
  0
}

// Was `nodeIx` declared inside a BLOCK (and hoisted into `progStmts` by the
// parser)? False for every module-scope declaration and every other node kind.
export function isBodyTyDecl(nodeIx: i32): boolean {
  let i = 0
  while i < bodyTyDeclNode.length {
    if bodyTyDeclNode[i] == nodeIx { return true }
    i = i + 1
  }
  false
}

// ── constraints phase 1: BOUNDS, kept where annotations are kept ─────────────
// Two tables, sparse and linear-scanned for `declGp*`'s reason. Both store an
// ANNOTATION NODE INDEX, never a rendered name, and that is architectural rather
// than a storage preference: a declared bound IS an annotation — present at
// parse, no inference — so it rides the path that already works end to end. The
// merge renames it through `modRwType` like any other `TypeRef`, `tsToName`
// writes its spelling tree back, and the checker resolves it with the same
// `nameToTy` every parameter type uses. The alternative is what forced this:
// D976 records that the column the CHECKER writes for an inferred parameter
// shape does not survive into emit, and a bound MUST (the monomorphizer
// re-resolves each instance's member calls against the substituted receiver).
// One row per BOUNDED type parameter; an unbounded `<T>` gets none, answers -1.
export let fnTpBoundFn: i32[] = []
export let fnTpBoundIx: i32[] = []
export let fnTpBoundAnn: i32[] = []

export function setFnTpBound(fnIx: i32, k: i32, annIx: i32) {
  fnTpBoundFn.push(fnIx)
  fnTpBoundIx.push(k)
  fnTpBoundAnn.push(annIx)
  0
}

// The bound annotation node on type parameter `k` of the `FuncDecl` at `fnIx`, or
// -1 when that parameter is unbounded (or the node is not a function).
export function fnTpBoundOf(fnIx: i32, k: i32) {
  let i = 0
  while i < fnTpBoundFn.length {
    if fnTpBoundFn[i] == fnIx && fnTpBoundIx[i] == k { return fnTpBoundAnn[i] }
    i = i + 1
  }
  -1
}

// Does this function declare ANY bounded type parameter? The cheap gate every
// consumer takes before doing bound work, so an unbounded generic pays one scan.
export function fnHasTpBound(fnIx: i32) {
  let i = 0
  while i < fnTpBoundFn.length {
    if fnTpBoundFn[i] == fnIx { return true }
    i = i + 1
  }
  false
}

// `declBound*` — one row per BOUND ALIAS declaration (`type Showable = { toString():
// string }`, i.e. a `type` whose body carries at least one METHOD member). The row
// holds the whole body as ONE synthetic-object annotation node, so `<T: Showable>`
// and `<T: { toString(): string }>` reach the identical spelling tree and one
// decoder serves both. The declaration node itself is minted with an EMPTY field
// list — a bound is not a value type and has no fields to lay out (see
// `typecheck.declaredTyOfName`, which turns a value-position use into a sentence).
export let declBoundNode: i32[] = []
export let declBoundAnn: i32[] = []

export function setDeclBound(nodeIx: i32, annIx: i32) {
  declBoundNode.push(nodeIx)
  declBoundAnn.push(annIx)
  0
}

// The bound-body annotation node of the declaration at `nodeIx`, or -1 when it is
// an ordinary type declaration.
export function declBoundOf(nodeIx: i32) {
  let i = 0
  while i < declBoundNode.length {
    if declBoundNode[i] == nodeIx { return declBoundAnn[i] }
    i = i + 1
  }
  -1
}

// The module merge renames a declaration's base segment (`Box` → `Box$m1`) and
// writes the result back into `tdName`/`udName`. The BANK is a second copy of
// that segment, so it moves with it — the same lockstep `modRwType` keeps
// between a `TypeRef`'s tree and its name, and the same bug class if it does
// not (a stale base makes the checker register the alias under a name no
// application spells).
export function setDeclGpBase(nodeIx: i32, base: string) {
  const r = declGpRowOf(nodeIx)
  if r >= 0 { declGpBase[r] = base }
  0
}

// The `k`-th member spelling root recorded for `nodeIx`, or -1 when the node has
// none (or fewer than `k + 1`). Binary search for the LEFTMOST row of `nodeIx`
// over the non-decreasing key column, then index by `k`.
export function udTsRootAt(nodeIx: i32, k: i32) {
  let lo = 0
  let hi = udTsNode.length - 1
  let first = -1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = udTsNode[mid]
    if at < nodeIx {
      lo = mid + 1
    } else {
      if at == nodeIx { first = mid }
      hi = mid - 1
    }
  }
  if first < 0 { return -1 }
  const r = first + k
  if r >= udTsNode.length { return -1 }
  if udTsNode[r] != nodeIx { return -1 }
  udTsRoot[r]
}

// DROP the `k`-th member spelling root of `nodeIx` — `clearAnnTs`'s twin for the
// MULTI-root table, for exactly the reason that one exists: *a live root renders
// to the spelling the node CURRENTLY carries*.
//
// `typecheck.canonEmitTypeNames`'s `UnionDecl` arm rewrites `udVariants[k]` in
// place (a softened literal member, a folded intersection, a generic APPLICATION
// replaced by its structural shape), and that rewrite is not a rename any more
// than the `TypeRef` arm's is. The table had no reader downstream of canon until
// the intersection fold started reading this root, which is what makes the
// invariant worth stating on this table too.
//
// The same binary search `udTsRootAt` walks; a node/`k` with no row is left alone.
export function clearUdTs(nodeIx: i32, k: i32) {
  let lo = 0
  let hi = udTsNode.length - 1
  let first = -1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = udTsNode[mid]
    if at < nodeIx {
      lo = mid + 1
    } else {
      if at == nodeIx { first = mid }
      hi = mid - 1
    }
  }
  if first < 0 { return 0 }
  const r = first + k
  if r >= udTsNode.length { return 0 }
  if udTsNode[r] != nodeIx { return 0 }
  udTsRoot[r] = -1
  0
}

// The spelling-tree root recorded for `nodeIx`, or `-1` when none was — every
// non-`TypeRef` node, an emitter-SYNTHESIZED `TypeRef` (`synthTypeRef`, built
// from a name the emitter computed that never passed through the parser), and
// the string-only type spellings the parser still drops (`as`).
export function annTsOf(nodeIx: i32) {
  let lo = 0
  let hi = annTsNode.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = annTsNode[mid]
    if at == nodeIx { return annTsRoot[mid] }
    if at < nodeIx { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// DROP the spelling root recorded for `nodeIx`, so `annTsOf` answers -1 from
// here on and every consumer falls back to the node's NAME.
//
// The one caller is `typecheck.canonEmitTypeNames`, and the reason is the
// invariant this table is only useful under: **a live root renders to the node's
// CURRENT name**. Canon rewrites `TypeRef.tyName` IN PLACE, and it is not a
// rename — it softens a literal member to its base scalar, folds an intersection,
// strips a whole-name paren — so the tree it leaves behind describes a DIFFERENT
// TYPE. The module merge (`driver.modRwType`) hit this one pass earlier and fixed
// it the other way, by rewriting the TREE and re-rendering; canon cannot
// (`canonEmitName` is not `tyToEmitName ∘ nameToTy`), so the honest move is to
// stop claiming a tree for a name the tree no longer describes.
export function clearAnnTs(nodeIx: i32) {
  let lo = 0
  let hi = annTsNode.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = annTsNode[mid]
    if at == nodeIx {
      annTsRoot[mid] = -1
      return 0
    }
    if at < nodeIx { lo = mid + 1 } else { hi = mid - 1 }
  }
  0
}

// Clear the spelling arena and its node columns. The driver calls this alongside
// `P.nodes = []` / `nodeToks = []` — a recorded root indexes THIS program's
// arena and means nothing against the next one's.
export function tsReset() {
  tsKind = []
  tsText = []
  tsKidStart = []
  tsKidCount = []
  tsKids = []
  tsStack = []
  annTsNode = []
  annTsRoot = []
  udTsNode = []
  udTsRoot = []
  declGpNode = []
  declGpBase = []
  declGpStart = []
  declGpCount = []
  declGpName = []
  bodyTyDeclNode = []
  fnTpBoundFn = []
  fnTpBoundIx = []
  fnTpBoundAnn = []
  declBoundNode = []
  declBoundAnn = []
  // D1003 — THE PLAIN→MANGLED UFCS ALIAS TABLE BELONGS TO ONE PROGRAM TOO, and
  // until this line it was reset ONLY on the module-merge path (`driver`, before
  // `modCollectSelfFns`). A single-file compile that followed a MODULE compile on
  // the same instance inherited the previous program's rows, so UFCS resolution
  // answered with a mangled name no function in the new program declares and the
  // lookup missed — surfacing as D952's EMPTY `[ERROR]:` at the member call.
  //
  // Invisible from the CLI (one process per compile) and reproducible in the two
  // places that reuse an instance: `tests/cases_wasm_test.ts`'s shared module, and
  // the LSP server, which compiles on every keystroke. Found by a `tests/cases`
  // file that passed alone and failed beside its neighbours.
  ufcsAliasReset()
  ufcsImpReset()
  0
}

// Render a spelling node back to the synthetic type NAME the parser built from
// it — arm for arm, the exact concatenations of `parseTypeName` /
// `parseTypeIsect` / `parseTypeAtom` (`compiler/parser.vl`), so
// `tsToName(annTsOf(ix))` reproduces `TypeRef.tyName` character for character on
// every annotation the parser recorded.
//
// This is the tree's WRITE-BACK, and it is what lets a pass rewrite the
// STRUCTURE and hand the string side its result instead of scanning characters
// (D-PARSETY P1: the module merge). -1 renders "" — the same empty name the
// parser's recovery arm returns.
export function tsToName(ix: i32): string {
  if ix < 0 { return "" }
  const k = tsKind[ix]
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  if k == TS_NAME { return tsText[ix] }
  if k == TS_LITSTR { return tsText[ix] }
  if k == TS_LITNUM { return tsText[ix] }
  if k == TS_NULL { return "null" }
  if k == TS_ERR { return "" }
  if k == TS_ARR { return tsToName(tsKids[start]) + "[]" }
  if k == TS_NEG { return "!" + tsToName(tsKids[start]) }
  if k == TS_MAP {
    return "{[" + tsText[ix] + "]:" + tsToName(tsKids[start]) + "}"
  }
  if k == TS_FIELD { return tsText[ix] + ":" + tsToName(tsKids[start]) }
  if (
    k == TS_APP ||
    k == TS_PAREN ||
    k == TS_OBJ ||
    k == TS_FUNC ||
    k == TS_METHOD
  ) {
    // The comma-joined child list. `TS_FUNC` and `TS_METHOD` hold their RESULT as
    // the LAST kid (`parseTypeAtom` / `parseMethodMemberTail`'s contract), so the
    // join stops one short of it.
    let last = cnt
    if k == TS_FUNC || k == TS_METHOD { last = cnt - 1 }
    let inner = ""
    let i = 0
    while i < last {
      if i > 0 { inner = inner + "," }
      inner = inner + tsToName(tsKids[start + i])
      i = i + 1
    }
    if k == TS_APP { return tsText[ix] + "<" + inner + ">" }
    if k == TS_PAREN { return "(" + inner + ")" }
    if k == TS_OBJ { return "{" + inner + "}" }
    if k == TS_METHOD {
      return tsText[ix] + "(" + inner + "):" + tsToName(tsKids[start + cnt - 1])
    }
    return "(" + inner + ")=>" + tsToName(tsKids[start + cnt - 1])
  }
  // `TS_UNION` / `TS_ISECT` — the members joined by their own separator.
  let sep = "|"
  if k == TS_ISECT { sep = "&" }
  let out = ""
  let i = 0
  while i < cnt {
    if i > 0 { out = out + sep }
    out = out + tsToName(tsKids[start + i])
    i = i + 1
  }
  out
}

// Does the spelling tree rooted at `ix` NAME any of `names`? Walks the same
// structure `resolveAnnotTs` resolves against, so it answers about the
// annotation the author wrote rather than about a synthetic name string:
// `T`, `T[]`, `Box<T>` and `{a: T}` all mention `T`, while `Trace` does not
// (a leaf is compared whole, never as a substring). The `TS_APP` head is
// compared too, so a type parameter used as an application head counts.
// Does the spelling tree rooted at `ix` contain a node of kind `kind` ANYWHERE? The
// structural form of "the rendered name contains `=>`" (`TS_FUNC`) and its siblings — a
// whole-TREE question, where `tsMentionsAnyName` asks a whole-LEAF one.
export function tsHasKind(ix: i32, kind: i32): boolean {
  if ix < 0 || ix >= tsKind.length { return false }
  if tsKind[ix] == kind { return true }
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  let j = 0
  while j < cnt {
    if tsHasKind(tsKids[start + j], kind) { return true }
    j = j + 1
  }
  false
}

export function tsMentionsAnyName(ix: i32, names: string[]) {
  if ix < 0 || ix >= tsKind.length || names.length == 0 { return false }
  const k = tsKind[ix]
  if k == TS_NAME || k == TS_APP {
    let i = 0
    while i < names.length {
      if names[i] == tsText[ix] { return true }
      i = i + 1
    }
  }
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  let j = 0
  while j < cnt {
    if tsMentionsAnyName(tsKids[start + j], names) { return true }
    j = j + 1
  }
  false
}

// ── Arena constructors ───────────────────────────────────────────────────────
// Each appends its variant to `P.nodes` and returns the new node's index. Every
// constructor takes `pos` — the CHAR OFFSET of the construct's START token (the
// parser captures it at the construct's parse entry, BEFORE the children parse),
// or `-1` for a synthesized/desugared node with no source token — and stores it
// on the built variant.

export function addNode(n: Node) {
  P.nodes.push(n)
  let tk = P.pos - 1
  if tk < 0 { tk = 0 }
  nodeToks.push(tk)
  P.nodes.length - 1
}

export function mkNum(text: string, pos: i32) {
  const n: Node = { numText: text, pos: pos }
  addNode(n)
}

export function mkStr(text: string, pos: i32) {
  const n: Node = { strText: text, pos: pos }
  addNode(n)
}

export function mkChar(text: string, pos: i32) {
  const n: Node = { charText: text, pos: pos }
  addNode(n)
}

export function mkBool(v: i32, pos: i32) {
  const n: Node = { boolVal: v, pos: pos }
  addNode(n)
}

export function mkNull(kw: string, pos: i32) {
  const n: Node = { nullKw: kw, pos: pos }
  addNode(n)
}

export function mkIdent(name: string, pos: i32) {
  const n: Node = { identName: name, pos: pos }
  addNode(n)
}

export function mkUnary(op: string, arg: i32, pos: i32) {
  const n: Node = { unOp: op, unArg: arg, pos: pos }
  addNode(n)
}

export function mkBinary(op: string, left: i32, right: i32, pos: i32) {
  const n: Node = {
    binOp: op,
    binLeft: left,
    binRight: right,
    pos: pos,
    binCompound: "",
    binTpl: 0,
  }
  addNode(n)
}

// ── the template renderer's LOCAL NAME (the injected import's near half) ─────
// The identifier a template hole's desugared call names. It is deliberately
// UNSPELLABLE — `$` is not an identifier character (`lexer.isIdStart`), so no
// user program can declare it, shadow it, or reference it — which is the whole
// mechanism behind "a template's meaning does not depend on the user's imports"
// (DECISIONS.md, owner ruling 2026-09-01). The module merge rewrites it to the
// merged `toStr$mN` through an ordinary rename row, so it never reaches the
// checker's scope and never appears in hover or completion.
//
// The FAR half — which std export it denotes — is `TPL_RENDER_EXPORT` in
// `driver.vl`, and that is the ONE line the queued `toStr` → `toString` rename
// touches.
export const TPL_RENDER_LOCAL = "$tpl$render"

// The ROOT `+` of a template literal's concatenation — `mkBinary` plus the
// faithful-surface marker the printer reads (see `BinExpr.binTpl`).
export function mkTplConcat(left: i32, right: i32, pos: i32) {
  const n: Node = {
    binOp: "+",
    binLeft: left,
    binRight: right,
    pos: pos,
    binCompound: "",
    binTpl: 1,
  }
  addNode(n)
}

// ── template holes (the parser's record of what a `${…}` was) ────────────────
// PARALLEL to `P.nodes`, grown lazily, bounds-checked on read — the `nodeToks` /
// `declNameTok` contract. `1` marks a node that IS a template hole's expression.
//
// WHY A SIDE TABLE AND NOT A NODE KIND: the hole is an ORDINARY expression and
// every pass should treat it as one. The single consumer is the checker's
// argument-mismatch report, which owes a template hole a sentence about templates
// rather than about the call the user never wrote — and the mark has to survive
// the module merge's identifier rewrite, which a callee NAME does not. A
// `TemplateLit` node kind would instead need an `is` arm in nine files' dispatch
// chains, each with a SILENTLY failing catch-all, to buy nothing the desugar does
// not already give (`format.vl` recovers the surface from the source span).
export let tplHole: i32[] = []

// Mark `nodeIx` as a template hole's expression. Bounds-guarded on the WRITE
// too, not only the read: every caller passes a constructor's result and so
// cannot pass a negative, but a `tplHole[-1] = 1` would be an out-of-bounds
// TRAP inside the compiler — no diagnostic, no position — and this table is not
// worth that risk.
export function mkTplHole(nodeIx: i32) {
  if nodeIx < 0 { return 0 }
  while tplHole.length <= nodeIx { tplHole.push(0) }
  tplHole[nodeIx] = 1
  0
}

// True when `nodeIx` is the expression of a `${…}` hole.
export function nodeIsTplHole(nodeIx: i32) {
  if nodeIx < 0 || nodeIx >= tplHole.length { return false }
  tplHole[nodeIx] == 1
}

// A compound assignment `target op= value`, desugared to `target = (target op
// value)` for typecheck/emit but tagged with the SURFACE operator (`binCompound`)
// so the printer reprints `target op= value`. The target node is SHARED between
// the read (inner arith) and the write (outer `=`) — arena reads are pure.
export function mkCompoundAssign(
  op: string,
  target: i32,
  value: i32,
  pos: i32,
) {
  const inner = mkBinary(op, target, value, pos)
  const n: Node = {
    binOp: "=",
    binLeft: target,
    binRight: inner,
    pos: pos,
    binCompound: op,
    binTpl: 0,
  }
  addNode(n)
}

// A prefix increment `++target` / `--target` (`incr` is `"++"`/`"--"`), desugared
// to `target = (target ± 1)` — yielding the NEW value, the prefix semantics — and
// tagged on `binCompound` with the surface `++`/`--` so the printer reprints the
// prefix form (postfix `x++` rides a `Unary "p+"` instead; see the parser).
export function mkPreIncr(incr: string, target: i32, pos: i32) {
  let op = "+"
  if incr == "--" { op = "-" }
  const inner = mkBinary(op, target, mkNum("1", -1), pos)
  const n: Node = {
    binOp: "=",
    binLeft: target,
    binRight: inner,
    pos: pos,
    binCompound: incr,
    binTpl: 0,
  }
  addNode(n)
}

export function mkCall(fn: i32, args: i32[], pos: i32) {
  // All-positional (the synthesizers' constructor): an empty names list.
  const names: string[] = []
  mkCallN(fn, args, names, pos)
}

// A call with per-argument NAMES (parallel to `args`; "" = positional) — the
// parser's constructor for argument lists that may carry `name: value` entries.
export function mkCallN(fn: i32, args: i32[], names: string[], pos: i32) {
  const n: Node = { callFn: fn, callArgs: args, callArgNames: names, pos: pos }
  addNode(n)
}

// True iff any per-argument name is present (a non-"" entry) — the cheap gate
// every consumer checks before paying for `orderArgsByParamNames`.
export function hasNamedArgs(names: string[]) {
  let i = 0
  while i < names.length {
    if names[i] != "" { return true }
    i = i + 1
  }
  false
}

// ── UFCS resolution across the module merge ──────────────────────────────────
// A UFCS member-call `recv.prop(args)` whose `prop` names a free `self`-function
// keeps `prop` plain on its `Member` — so a struct callable-field of the same
// name keeps precedence, decided by the receiver TYPE in the checker/emitter. The
// merge MANGLES such functions (`shout` → `shout$m1`), so the merged name has to
// be recovered where UFCS resolves, AFTER the field check. EMPTY in single-file
// mode (no merge populates it), so a non-module program takes exactly the paths
// it took before. Defined here (the foundation file shared by every
// concatenation) because `typecheck.vl` and `wasmEmit.vl` consult it while the
// driver — which populates it — is concatenated last.

// D1120 — THE PLAIN NAME IS NOT A KEY. Two merged modules may each export a
// `self`-function called `area`, so the answer is banked per CALL SITE:
// `ufcsSiteTo[callIx]`, the node-index sidecar shape `callSiteLoc` uses. Node
// indices are stable from the merge walk through `checkProgram` and
// `emitProgram`, which is what lets three consumers in two phases read one answer.

// D1191 — AND THE PLAIN NAME IS NOT A SCOPE EITHER. The name-keyed map this
// replaces was GLOBAL: a row banked by lib's own `b.hidden()` answered the ENTRY's
// `b.hidden()` too, so an un-exported `self`-function became callable from a module
// that never imported it — while the direct spelling `hidden(b)` stayed `undeclared
// identifier`. The rule is the direct call's rule: a UFCS candidate must be a name
// the CALLER binds. `ufcsScope*` is that scope, one row per (module, plain name)
// the module binds to a `self`-function, built from the rename map that already
// decides every other reference; `ufcsModBound` maps a node back to its module.
export let ufcsSiteTo: string[] = []
export let ufcsScopeMod: i32[] = []
export let ufcsScopeFrom: string[] = []
export let ufcsScopeTo: string[] = []
export let ufcsModBound: i32[] = []
export let ufcsModIx: i32[] = []
export function ufcsAliasReset() {
  ufcsSiteTo = []
  ufcsScopeMod = []
  ufcsScopeFrom = []
  ufcsScopeTo = []
  ufcsModBound = []
  ufcsModIx = []
  0
}
// Bank the mangled self-function the UFCS member-call NODE `callIx` resolves to.
export function ufcsSiteAdd(callIx: i32, mangled: string) {
  if callIx < 0 { return 0 }
  while ufcsSiteTo.length <= callIx { ufcsSiteTo.push("") }
  ufcsSiteTo[callIx] = mangled
  0
}
// The per-site answer for the call at `callIx`, or "" when the walk banked none.
export function ufcsSiteOf(callIx: i32) {
  if callIx >= 0 && callIx < ufcsSiteTo.length { return ufcsSiteTo[callIx] }
  ""
}
// Module `m` binds plain `plain` to the merged `self`-function `mangled` — one
// row per name in that module's scope, declaration or import (alias included).
export function ufcsScopeAdd(m: i32, plain: string, mangled: string) {
  ufcsScopeMod.push(m)
  ufcsScopeFrom.push(plain)
  ufcsScopeTo.push(mangled)
  0
}
// The merged `self`-function module `m` binds `plain` to, or "" when it binds
// none — the UFCS half of "is this name in scope here".
export function ufcsScopeIn(m: i32, plain: string) {
  let i = 0
  while i < ufcsScopeFrom.length {
    if ufcsScopeMod[i] == m && ufcsScopeFrom[i] == plain {
      return ufcsScopeTo[i]
    }
    i = i + 1
  }
  ""
}
// Record module `m`'s highest arena node (its `Program` root, minted last). Pushed
// in merge-walk order, so the bounds ascend and `ufcsModOfNode` is one scan.
export function ufcsModBoundAdd(m: i32, rootIx: i32) {
  ufcsModIx.push(m)
  ufcsModBound.push(rootIx)
  0
}
// The module owning arena node `ix`, or -1 when no merge ran (single file) or the
// node was minted AFTER parsing (a desugar's fresh node, past every root). -1
// means "no scope to check", which the readers below spell as the plain name.
export function ufcsModOfNode(ix: i32) {
  let i = 0
  while i < ufcsModBound.length {
    if ix <= ufcsModBound[i] { return ufcsModIx[i] }
    i = i + 1
  }
  -1
}
// The merged `self`-function plain `name` resolves to in the scope of the module
// owning node `nodeIx` — the reader for a question asked away from a call site
// (`witnessOf` judges a bound before any call exists). Identity when that module
// binds no such name, so the ordinary `no field` refusal follows.
export function ufcsAliasInScope(nodeIx: i32, name: string) {
  const m = ufcsModOfNode(nodeIx)
  if m < 0 { return name }
  const t = ufcsScopeIn(m, name)
  if t != "" { return t }
  name
}
// The mangled self-function the UFCS member-call at `callIx` resolves to: THAT
// SITE's own answer when the merge walk banked one (D1120), else the CALLER's
// module scope (D1191). The one entry point for the three consumers that hold a
// call node — `ufcsCallTy`, `drwWalk`, and `emitCall`'s unrewritten-member
// fallback — so the checker and the emitter cannot pick different modules'
// functions for one call.
export function ufcsAliasAtSite(callIx: i32, name: string) {
  const site = ufcsSiteOf(callIx)
  if site != "" { return site }
  ufcsAliasInScope(callIx, name)
}

// ── UFCS candidates the entry file has NOT imported (D1230's diagnostic) ─────
// UFCS is EXPLICIT: `expect(1).toEqual(2)` resolves `toEqual` only against names
// IN SCOPE, and the compiler does not look into the module that defines the
// receiver's type (DECISIONS.md §"UFCS is never implicit"). The program is
// therefore illegal — but `no field 'toEqual' on Expectation<i32>` is a true
// sentence about a fact that will never change, and the ONE thing the compiler
// knows and does not say is that `toEqual` sits in a module the file already names.
// This registry carries that knowledge across the phase boundary: the merge
// (`driver.modCollectSelfFns`) knows every module's exported free `self`-functions
// and the specifier the ENTRY file names each module by; the checker knows the
// receiver type and the call's arity. A ROW IS A CANDIDATE, NOT A VERDICT —
// whether it would dispatch is `typecheck.ufcsWouldDispatch`'s question, per call.
export let ufcsImpName: string[] = []    // the plain source name (`toEqual`)
export let ufcsImpMangled: string[] = [] // the merged name (`toEqual$m1`)
export let ufcsImpSpec: string[] = []    // how the ENTRY names that module (`std:test`)
export function ufcsImpReset() {
  ufcsImpName = []
  ufcsImpMangled = []
  ufcsImpSpec = []
  0
}
export function ufcsImpAdd(plain: string, mangled: string, spec: string) {
  let i = 0
  while i < ufcsImpName.length {
    if ufcsImpName[i] == plain && ufcsImpMangled[i] == mangled { return 0 }
    i = i + 1
  }
  ufcsImpName.push(plain)
  ufcsImpMangled.push(mangled)
  ufcsImpSpec.push(spec)
  0
}

// ── free INDEX-OPERATOR declaration names (B14) ──────────────────────────────
// `function "[]"(self: T, i: I)` and `function "[]="(self: T, i: I, v: V)` are
// free functions whose NAME is an operator, so a program may declare several —
// one per receiver type. Every name-keyed table in the checker and the emitter
// (`fnDeclIx`, `lookup`, `fnIndexOf`) holds ONE entry per name, so the parser
// mints a DECLARATION NAME carrying the receiver's annotation spelling:
// `"[]" for F32View` → `[]@F32View`.
// The `@` is what makes the encoding total — it cannot occur in an identifier, so
// no ordinary function's name reads as an operator's, and a genuine duplicate
// collides on the minted name and is caught by the ordinary redeclaration rule.
// The merge's `$mN` suffix leaves the prefix intact (`[]@F32View$m1`), so the
// checker's registry, built from the MERGED program, needs no plain→mangled alias.
export const OP_INDEX_GET = "[]"
export const OP_INDEX_SET = "[]="

// The operator names whose DISPATCH is binary — the quoted-function-name set
// (`parser.vl`'s `isStrFuncName`) minus the two BRACKET operators, whose arity is
// the index rule's `(self, index[, value])` and is checked at the hoist against
// the resolved receiver, and minus `==`/`!=`, which `parseFuncHead` already
// refuses BY NAME (D46). Listing those two here as well would put a second
// diagnostic on one declaration for one mistake.
//
// HERE rather than in `parser.vl` because BOTH declaration-site gates over this
// family read it and neither may drift from the other: the parser's arity (D444)
// and first-parameter-NAME (D471) rules are syntactic, and the checker's
// dead-`self` rule (D425) needs the resolved type. One list, three gates.
export function isBinOpFuncName(name: string) {
  name == "+" ||
    name == "-" ||
    name == "*" ||
    name == "/" ||
    name == "%" ||
    name == "^" ||
    name == ">" ||
    name == ">=" ||
    name == "<" ||
    name == "<="
}

// The declaration name for operator `op` on a receiver spelled `recv`.
export function opDeclName(op: string, recv: string): string { op + "@" + recv }

// The offset of the `@` separator in `name`, or -1 when it carries none.
function opDeclAt(name: string): i32 {
  let i = 0
  while i < name.length {
    if name[i] == '@' { return i }
    i = i + 1
  }
  -1
}

// The INDEX OPERATOR a declaration name implements, or "" when `name` is an
// ordinary function's. Total over merge-mangled names (the `$mN` rides in the
// receiver half) and over every identifier (no identifier contains `@`).
export function opDeclOpOf(name: string): string {
  const at = opDeclAt(name)
  if at < 0 { return "" }
  const op = name.slice(0, at)
  if op == OP_INDEX_GET { return op }
  if op == OP_INDEX_SET { return op }
  ""
}

// The receiver-spelling half of an operator declaration name (with any `$mN`
// the merge appended), or "" for an ordinary name.
export function opDeclRecvOf(name: string): string {
  if opDeclOpOf(name) == "" { return "" }
  const recv = name.slice(opDeclAt(name) + 1, name.length)
  recv
}

// How an operator declaration reads back to a USER: `"[]" for F32View`. Every
// diagnostic that would otherwise print the minted name routes through this, so
// the `@` encoding never reaches a message. An ordinary name is returned as-is.
export function opDeclLabel(name: string): string {
  const op = opDeclOpOf(name)
  if op == "" { return name }
  "\"" + op + "\" for " + opDeclRecvOf(name)
}

// Bind call ARGUMENTS to parameter slots by NAME, then positionally — the exact
// matching the host's `orderArgumentsByParameters` (typecheck.ts) performs, and
// the single source of truth shared by the checker and the emitter. Returns one
// VALUE-node index per parameter (in PARAMETER order; -1 where no argument
// filled the slot), followed by any leftover/unmatched arguments (a named arg
// with no matching parameter, a named collision, or surplus positionals) in
// source order — so the result never silently drops an argument. Pure: callers
// (`checkNode`'s Call arm, `emitCall`) diagnose arity/name errors themselves.
export function orderArgsByParamNames(
  paramNames: string[],
  args: i32[],
  argNames: string[],
) {
  const slots: i32[] = []
  let i = 0
  while i < paramNames.length {
    slots.push(-1)
    i = i + 1
  }
  const leftover: i32[] = []
  const positional: i32[] = []
  // First place named arguments by parameter name.
  let j = 0
  while j < args.length {
    let nm = ""
    if j < argNames.length { nm = argNames[j] }
    if nm == "" {
      positional.push(args[j])
    } else {
      let pIx = -1
      let k = 0
      while k < paramNames.length {
        if pIx < 0 && paramNames[k] == nm { pIx = k }
        k = k + 1
      }
      if pIx < 0 || slots[pIx] >= 0 {
        // Unknown name, or a slot already filled (named collision): leave it
        // for the caller to diagnose rather than overwriting.
        leftover.push(args[j])
      } else {
        slots[pIx] = args[j]
      }
    }
    j = j + 1
  }
  // Then fill the remaining slots, in order, with positional arguments.
  let nx = 0
  let p = 0
  while p < positional.length {
    while nx < slots.length && slots[nx] >= 0 { nx = nx + 1 }
    if nx < slots.length {
      slots[nx] = positional[p]
      nx = nx + 1
    } else {
      leftover.push(positional[p])
    }
    p = p + 1
  }
  let r = 0
  while r < leftover.length {
    slots.push(leftover[r])
    r = r + 1
  }
  slots
}

export function mkMember(obj: i32, prop: string, pos: i32) {
  const n: Node = { memObj: obj, memProp: prop, pos: pos }
  addNode(n)
}

export function mkIndex(arr: i32, idx: i32, pos: i32) {
  const n: Node = { idxArr: arr, idxIndex: idx, pos: pos }
  addNode(n)
}

export function mkArrayLit(elems: i32[], pos: i32) {
  const n: Node = { arrElems: elems, pos: pos }
  addNode(n)
}

export function mkOptMember(obj: i32, prop: string, pos: i32) {
  const n: Node = { omObj: obj, omProp: prop, pos: pos }
  addNode(n)
}

export function mkParen(inner: i32, pos: i32) {
  const n: Node = { parInner: inner, pos: pos }
  addNode(n)
}

export function mkErr(what: string, at: i32, pos: i32) {
  const n: Node = { errWhat: what, errAt: at, pos: pos }
  addNode(n)
}

export function mkLet(kw: string, name: string, ty: i32, init: i32, pos: i32) {
  const n: Node = {
    letKw: kw,
    letName: name,
    letType: ty,
    letInit: init,
    pos: pos,
  }
  addNode(n)
}

export function mkParam(name: string, ty: i32, dflt: i32, opt: i32, pos: i32) {
  const n: Node = {
    parName: name,
    parType: ty,
    parDefault: dflt,
    parOpt: opt,
    pos: pos,
  }
  addNode(n)
}

// The default-value expression of the parameter node `pIx`, or -1 when it has
// none (or `pIx` is not a `Param`). The ONE reader of `parDefault` outside the
// parser/printer, so a caller never re-narrows the node itself.
export function paramDefaultOf(pIx: i32) {
  if pIx < 0 || pIx >= P.nodes.length { return -1 }
  const p = P.nodes[pIx]
  if p is Param { return p.parDefault }
  -1
}

// Fill every UNFILLED slot of a PARAMETER-ORDERED argument list with that
// parameter's DEFAULT expression, in place. Returns the position of the first
// slot that stays unfilled (no argument supplied and no default declared), or
// -1 when the list came out complete.
//
// The default's arena node is SHARED by every call site that omits the argument
// rather than cloned: a literal and a module-scope `const` carry no
// per-occurrence state — their emitted valtype comes from the parameter they land
// on and their walk is idempotent — so sharing is exact for both. `__callsite__`
// IS the exception, and `callIx` is why this takes the call node: its value is the
// CALL's own position, so the slot takes the per-site `ObjLit` `csPreMintLocs`
// banked on that call. A call with no banked location leaves the slot UNFILLED.
export function fillArgDefaults(slots: i32[], dParams: i32[], callIx: i32) {
  let i = 0
  while i < slots.length {
    if slots[i] < 0 {
      let d = -1
      if i < dParams.length { d = paramDefaultOf(dParams[i]) }
      if d < 0 { return i }
      if paramDefaultIsCallsite(d) { d = callSiteLocOf(callIx) }
      if d < 0 { return i }
      slots[i] = d
    }
    i = i + 1
  }
  -1
}

// How many LEADING arguments a DIRECT call to a function with these parameters
// must supply: every parameter up to the first one carrying a default. Defaults
// are trailing-only (the checker rejects a non-defaulted parameter after a
// defaulted one), so this is the low end of the accepted arity range and
// `params.length` is the high end. A list with no defaults answers its own
// length, which is the exact-arity gate every call site had before.
export function fnRequiredArity(params: i32[]) {
  let i = 0
  while i < params.length {
    if paramDefaultOf(params[i]) >= 0 { return i }
    i = i + 1
  }
  params.length
}

export function mkTypeRef(name: string, pos: i32) {
  const n: Node = { tyName: name, pos: pos }
  addNode(n)
}

export function mkFunc(
  name: string,
  typarams: string[],
  params: i32[],
  ret: i32,
  body: i32,
  pos: i32,
) {
  const n: Node = {
    fnName: name,
    fnTyParams: typarams,
    fnParams: params,
    fnRet: ret,
    fnBody: body,
    pos: pos,
  }
  addNode(n)
}

export function mkIf(cond: i32, thenB: i32, els: i32, pos: i32) {
  const n: Node = { ifCond: cond, ifThen: thenB, ifElse: els, pos: pos }
  addNode(n)
}

// Loop constructors take the optional loop LABEL last ("" = unlabelled).
export function mkWhile(cond: i32, body: i32, label: string, pos: i32) {
  const n: Node = {
    whileCond: cond,
    whileBody: body,
    whileLabel: label,
    pos: pos,
  }
  addNode(n)
}

export function mkForRange(
  v: string,
  from: i32,
  to: i32,
  step: i32,
  body: i32,
  label: string,
  pos: i32,
) {
  const n: Node = {
    frVar: v,
    frFrom: from,
    frTo: to,
    frStep: step,
    frBody: body,
    frLabel: label,
    pos: pos,
  }
  addNode(n)
}

export function mkForIn(
  v: string,
  iter: i32,
  body: i32,
  label: string,
  pos: i32,
) {
  const n: Node = {
    fiVar: v,
    fiIter: iter,
    fiBody: body,
    fiLabel: label,
    pos: pos,
  }
  addNode(n)
}

export function mkMatch(
  scrut: i32,
  pats: i32[],
  binds: i32[],
  armStart: i32[],
  armCount: i32[],
  bodies: i32[],
  pos: i32,
) {
  const n: Node = {
    matchScrut: scrut,
    matchPats: pats,
    matchBinds: binds,
    matchArmStart: armStart,
    matchArmCount: armCount,
    matchBodies: bodies,
    pos: pos,
  }
  addNode(n)
}

export function mkBreak(kw: string, label: string, pos: i32) {
  const n: Node = { brkKw: kw, brkLabel: label, pos: pos }
  addNode(n)
}

export function mkContinue(kw: string, label: string, pos: i32) {
  const n: Node = { contKw: kw, contLabel: label, pos: pos }
  addNode(n)
}

export function mkReturn(arg: i32, pos: i32) {
  const n: Node = { retArg: arg, pos: pos }
  addNode(n)
}

export function mkBlock(stmts: i32[], pos: i32) {
  const n: Node = { blkStmts: stmts, pos: pos }
  addNode(n)
}

export function mkProgram(stmts: i32[], pos: i32) {
  const n: Node = { progStmts: stmts, pos: pos }
  addNode(n)
}

export function mkImport(
  path: string,
  names: string[],
  locals: string[],
  nameToks: i32[],
  pos: i32,
) {
  const n: Node = {
    impPath: path,
    impNames: names,
    impLocals: locals,
    impNameToks: nameToks,
    pos: pos,
  }
  addNode(n)
}

export function mkFieldDef(name: string, ty: i32, pos: i32) {
  const n: Node = { fdName: name, fdType: ty, pos: pos }
  addNode(n)
}

export function mkTypeDecl(
  name: string,
  fields: i32[],
  pos: i32,
  isNew: i32,
  isFlat: i32,
) {
  const n: Node = {
    tdName: name,
    tdFields: fields,
    pos: pos,
    tdNew: isNew,
    tdFlat: isFlat,
  }
  addNode(n)
}

export function mkFieldInit(name: string, value: i32, pos: i32) {
  const n: Node = { fiName: name, fiValue: value, pos: pos }
  addNode(n)
}

export function mkObjLit(fields: i32[], pos: i32) {
  const n: Node = { objFields: fields, pos: pos }
  addNode(n)
}

export function mkUnionDecl(
  name: string,
  variants: string[],
  pos: i32,
  isNew: i32,
) {
  const n: Node = { udName: name, udVariants: variants, pos: pos, udNew: isNew }
  addNode(n)
}

export function mkIsExpr(obj: i32, variant: string, pos: i32) {
  const n: Node = { isObj: obj, isVariant: variant, pos: pos, isNeg: 0 }
  addNode(n)
}

// A NEGATED type guard `x !is T`, desugared to `!(x is T)` (a `Unary "!"` over
// this node) for typecheck/emit's narrowing, but flagged `isNeg` so the printer
// reprints the surface `!is` instead of `!(… is …)`.
export function mkIsExprNeg(obj: i32, variant: string, pos: i32) {
  const n: Node = { isObj: obj, isVariant: variant, pos: pos, isNeg: 1 }
  addNode(n)
}

// `x as T` — an explicit numeric cast (B2). `ty` is the target type NAME string.
export function mkAsExpr(obj: i32, ty: string, mode: AsMode, pos: i32) {
  const n: Node = { asObj: obj, asTy: ty, asMode: mode, pos: pos }
  addNode(n)
}

// ── int → string ─────────────────────────────────────────────────────────────
// A hand-rolled decimal converter. `i32ToStr` is the shared count/index renderer
// across the self-host: the checker, emitter, and driver import it for
// diagnostics and synthetic names.
function digitChar(d: i32) {
  if d == 0 { return "0" }
  if d == 1 { return "1" }
  if d == 2 { return "2" }
  if d == 3 { return "3" }
  if d == 4 { return "4" }
  if d == 5 { return "5" }
  if d == 6 { return "6" }
  if d == 7 { return "7" }
  if d == 8 { return "8" }
  "9"
}

export function i32ToStr(n: i32) {
  if n == 0 { return "0" }
  // Peel digits in the NEGATIVE range: every i32 (including INT_MIN, whose
  // magnitude overflows i32) is representable as -|n|, so negate positives
  // instead of negatives. Wasm `rem_s` of a negative operand yields -digit.
  const neg = n < 0
  let m = n
  if !neg { m = 0 - m }
  let out = ""
  while m < 0 {
    out = digitChar(0 - (m % 10)) + out
    m = m / 10
  }
  if neg { out = "-" + out }
  out
}

// ── Generic child enumeration ────────────────────────────────────────────────
// The child arena indices of `P.nodes[ix]`, in source order; a slot holding `-1`
// (absent) is pushed as-is and the walker's bounds check skips it. Covers VALUE
// children and type-annotation slots (`TypeRef`/`FieldDef` — inert leaves for
// every current rule, traversed so a richer type AST is covered automatically).
// It started in `lint.vl` and lives here because it depends on nothing but the
// node arena, which is this module — the lint tier, the checker and the emitter share it.
// A `MatchExpr`'s PATTERNS are deliberately NOT children: a pattern is a literal
// shape or the wildcard `_`, not a value reference, so a reference rule must not
// count one as a use. `matchBinds` is out for that reason and one more — a
// binding's initializer is a `Member` over the SHARED scrutinee node, so walking
// it would count the scrutinee once per bound field. The desugar covers the loss.
export function nodeChildren(ix: i32) {
  const out: i32[] = []
  if ix < 0 || ix >= P.nodes.length { return out }
  const n = P.nodes[ix]
  if n is Unary {
    out.push(n.unArg)
  } else if n is BinExpr {
    out.push(n.binLeft)
    out.push(n.binRight)
  } else if n is Call {
    out.push(n.callFn)
    let i = 0
    while i < n.callArgs.length {
      out.push(n.callArgs[i])
      i = i + 1
    }
  } else if n is Member {
    out.push(n.memObj)
  } else if n is OptMember {
    out.push(n.omObj)
  } else if n is Paren {
    out.push(n.parInner)
  } else if n is Index {
    out.push(n.idxArr)
    out.push(n.idxIndex)
  } else if n is ArrayLit {
    let i = 0
    while i < n.arrElems.length {
      out.push(n.arrElems[i])
      i = i + 1
    }
  } else if n is ObjLit {
    let i = 0
    while i < n.objFields.length {
      out.push(n.objFields[i])
      i = i + 1
    }
  } else if n is FieldInit {
    out.push(n.fiValue)
  } else if n is IsExpr {
    out.push(n.isObj)
  } else if n is AsExpr {
    out.push(n.asObj)
  } else if n is LetDecl {
    out.push(n.letType)
    out.push(n.letInit)
  } else if n is Param {
    out.push(n.parType)
    out.push(n.parDefault)
  } else if n is FuncDecl {
    let i = 0
    while i < n.fnParams.length {
      out.push(n.fnParams[i])
      i = i + 1
    }
    out.push(n.fnRet)
    out.push(n.fnBody)
  } else if n is IfStmt {
    out.push(n.ifCond)
    out.push(n.ifThen)
    out.push(n.ifElse)
  } else if n is WhileStmt {
    out.push(n.whileCond)
    out.push(n.whileBody)
  } else if n is ForRange {
    out.push(n.frFrom)
    out.push(n.frTo)
    out.push(n.frStep)
    out.push(n.frBody)
  } else if n is ForIn {
    out.push(n.fiIter)
    out.push(n.fiBody)
  } else if n is MatchExpr {
    out.push(n.matchScrut)
    let i = 0
    while i < n.matchBodies.length {
      out.push(n.matchBodies[i])
      i = i + 1
    }
  } else if n is RetStmt {
    out.push(n.retArg)
  } else if n is Block {
    let i = 0
    while i < n.blkStmts.length {
      out.push(n.blkStmts[i])
      i = i + 1
    }
  } else if n is Program {
    let i = 0
    while i < n.progStmts.length {
      out.push(n.progStmts[i])
      i = i + 1
    }
  } else if n is FieldDef {
    out.push(n.fdType)
  } else if n is TypeDecl {
    let i = 0
    while i < n.tdFields.length {
      out.push(n.tdFields[i])
      i = i + 1
    }
  }
  out
}
