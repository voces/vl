// AST and token model for the VL-in-VL parser — the data layer the parser builds onto.
// `compiler/parser.vl` imports the token type, the parser state `P` and the arena
// constructors from here.
//
// Each node kind is its own struct `type`; the `Node` alias unions them and every pass
// discriminates with `is`, so the kind is the runtime variant rather than a tag field.
// Discrimination is by structural shape — WasmGC erases field names but the variant tag
// is field-name-aware — so every variant uses a distinct field-name prefix (`num*`,
// `bin*`, `call*`, …) and no variant's fields may become a subset of another's.
//
// Children are referenced by `i32` position in the flat `Node[]` arena (`-1` for none)
// and child lists by `i32[]`, which sidesteps a recursive type alias VL cannot express.

import { TokKind } from "./lexer"

// A token consumed by the parser. `kind` is the lexer's closed `TokKind` atom, `pos` its
// index in the stream (the cursor unit the parser and diagnostics use), and
// `start`/`line`/`col` the source position of its first char. The parser never reads those
// three — diagnostics reach them through `nodeToks` — so a test stream may pass zeros.
export type Tok = {
  kind: TokKind,
  text: string,
  pos: i32,
  start: i32,
  line: i32,
  col: i32,
}

// One struct per node kind. An `i32` field holding a child is an arena index (`-1` for
// none) and an `i32[]` field a child list; a literal payload keeps its source `text`.
// `pos` is on every variant — the char offset of the construct's start token, or -1 for a
// synthesized node — and only the diagnostics layer reads it; no pass discriminates on it.

// Expressions ----------------------------------------------------------------
export type NumLit = { numText: string, pos: i32 }         // 12, 3.14
export type StrLit = { strText: string, pos: i32 }         // "hi" (raw)
export type CharLit = { charText: string, pos: i32 }       // 'a'  (raw)
export type BoolLit = { boolVal: i32, pos: i32 }           // true=1 / false=0
export type NullLit = { nullKw: string, pos: i32 }         // null
export type Ident = { identName: string, pos: i32 }        // x
export type Unary = { unOp: string, unArg: i32, pos: i32 } // !x  -x
// `binCompound` is the surface compound-assignment operator (`+`/`-`/`*`/`/`) for an
// `a += b` that desugars to `a = a + b`, else "". `binTpl` is 1 on the root `+` of the
// concatenation a backtick template desugared to, its span covering the whole template.
// Both are faithful-surface markers the printer reads; typecheck and emit ignore them.
export type BinExpr = {
  binOp: string,
  binLeft: i32,
  binRight: i32,
  pos: i32,
  binCompound: string,
  binTpl: i32,
} // a + b,  a = b,  a += b
// A call `f(a, b)` or `f(a: 2, b: 1)`. `callArgs` are the argument value nodes in source
// order and `callArgNames` the parallel per-argument name list ("" for a positional one);
// an all-positional call may carry an empty names list, and every consumer treats a
// missing entry as "". Binding to parameters is `orderArgsByParamNames`'s.
export type Call = {
  callFn: i32,
  callArgs: i32[],
  callArgNames: string[],
  pos: i32,
}  // f(a, b) / f(b: 1, a: 2)
export type Member = { memObj: i32, memProp: string, pos: i32 }  // o.field
export type OptMember = { omObj: i32, omProp: string, pos: i32 } // o?.field (null-safe)
export type Paren = { parInner: i32, pos: i32 }                  // ( e )
export type ErrExpr = { errWhat: string, errAt: i32, pos: i32 }  // recovery leaf

// Statements -----------------------------------------------------------------
export type LetDecl = { // let/const x: T = e
  letKw: string, // "let" | "const"
  letName: string,
  letType: i32,  // type-annotation node, -1 if none
  letInit: i32,  // initializer node, -1 if none
  pos: i32,
}
// A parameter `a: i32`, optionally carrying a default value. `parDefault` is the default
// expression's arena index (-1 for none); `parOpt` is 1 for the surface `a?: i32`, sugar
// for `a: i32 | null = null` and a faithful-surface marker the printer reads. Everything
// downstream reads the desugared `parType` and `parDefault` and ignores `parOpt`.
export type Param = {
  parName: string,
  parType: i32,
  parDefault: i32,
  parOpt: i32,
  pos: i32,
} // a: i32,  a: i32 = 0,  a?: i32
export type TypeRef = { tyName: string, pos: i32 } // i32 (annotation)
export type FuncDecl = {                           // function f<T?>(..): T {..}
  fnName: string,
  fnTyParams: string[], // generic type-parameter names (`<T, U>`), empty if none
  fnParams: i32[],
  fnRet: i32,           // return-type node, -1 if none
  fnBody: i32,          // block node
  pos: i32,
}
export type IfStmt = { // if c {..} else {..}
  ifCond: i32,
  ifThen: i32, // then block
  ifElse: i32, // else node (block or nested if), -1 if none
  pos: i32,
}
// Loops carry an optional label (`outer: while …` / `outer: for …`; "" = none),
// the target of a labelled `break`/`continue` — mirroring the host's
// `label: string | undefined` on `VLWhileNode`/`VLForNode`/`VLForInNode`.
export type WhileStmt = {
  whileCond: i32,
  whileBody: i32,
  whileLabel: string,
  pos: i32,
} // [l:] while c { body }
// `break` / `continue` loop-control statements. Each carries the optional loop label it
// targets ("" for the innermost loop) plus a marker field (`brkKw` / `contKw`, the source
// keyword text) that gives the two prefixes distinct field-name sets, which the header's
// discrimination rule needs.
export type BreakStmt = { brkKw: string, brkLabel: string, pos: i32 } // break [label]
export type ContinueStmt = { contKw: string, contLabel: string, pos: i32 } // continue [label]
// `for v in A to B [step S] { body }` — a numeric range loop; `frStep` is the step
// expression node index, or -1 for the implicit +1. `for v in iterable { body }` —
// a for-IN loop over an array, binding `v` to the element type.
export type ForRange = {
  frVar: string,
  frFrom: i32,
  frTo: i32,
  frStep: i32,
  frBody: i32,
  frLabel: string,
  pos: i32,
}
export type ForIn = {
  fiVar: string,
  fiIter: i32,
  fiBody: i32,
  fiLabel: string,
  pos: i32,
} // [l:] for v in arr { body }
// `match scrut { pat => body … }` — exhaustive value dispatch. Arm `i` matches one of
// `matchPats[matchArmStart[i] .. +matchArmCount[i]]` and runs `matchBodies[i]`.
// `matchBinds` is parallel to `matchPats`, not the arms: entry `p` is that pattern's
// payload-binding `Block` or -1, entering the body only at desugar (the formatter's need).
export type MatchExpr = {
  matchScrut: i32,
  matchPats: i32[],
  matchBinds: i32[],
  matchArmStart: i32[],
  matchArmCount: i32[],
  matchBodies: i32[],
  pos: i32,
}
export type RetStmt = { retArg: i32, pos: i32 }      // return e?  (-1 bare)
export type Block = { blkStmts: i32[], pos: i32 }    // { stmt* }
export type Program = { progStmts: i32[], pos: i32 } // top-level stmt*

// An `import { a, b as c, … } from "path"` statement, a tooling node: module resolution
// stays the driver's token-level `modScan`, the checker and emitter skip it, and the
// formatter reproduces imports from the token stream. `impNames` are the imported source
// names, `impLocals` the parallel local bindings, `impNameToks` the parallel name tokens.
export type ImportDecl = {
  impPath: string,
  impNames: string[],
  impLocals: string[],
  impNameToks: i32[],
  pos: i32,
}

// A struct type declaration `type Name = { field: Type, … }` and the object literal that
// constructs one. Prefixes: `td`/`fd` for the type declaration and its fields, `obj`/`fi`
// for the literal and its field inits. A struct-type annotation (`p: Point`) reuses
// `TypeRef`, a bare name.
export type FieldDef = { fdName: string, fdType: i32, pos: i32 } // x: i32  (in a type decl)
// `tdNew` marks a nominal newtype body (`type F32View = new { … }`) and `tdFlat` a flat
// record body — declaration-surface markers read only by the checker's declaration
// pre-pass and erased before emit, so `flat` emits exactly as the same declaration
// without it. No `udFlat` twin: the parser's syntactic fork rejects a non-record body.
export type TypeDecl = {
  tdName: string,
  tdFields: i32[],
  pos: i32,
  tdNew: i32,
  tdFlat: i32,
} // type Name = { f: T, ... }
export type FieldInit = { fiName: string, fiValue: i32, pos: i32 } // x: 7    (in an object literal)
export type ObjLit = { objFields: i32[], pos: i32 }                // { x: 7, y: 9 }

// An array literal `[e, e, …]` constructing a fixed-length WasmGC array, and an index
// access `a[i]` (a read, or a write when it is the left side of a `=`). Prefixes: `arr`
// for the literal's element list, `idx` for the index's array and index pair. An array
// type annotation reuses `TypeRef` with a synthetic `"i32[]"` name — see `parseType`.
export type ArrayLit = { arrElems: i32[], pos: i32 }         // [1, 2, 3]
export type Index = { idxArr: i32, idxIndex: i32, pos: i32 } // a[i]

// A discriminated-union type alias `type Name = A | B | C` (`udVariants` are the member
// type names in source order) and the type-guard expression `x is T`. Prefixes: `ud` for
// the declaration, `is` for the guard. `udNew` is `tdNew`'s twin for the non-brace forms:
// every `type N = <not a brace body>` parses as a one-member `UnionDecl`.
export type UnionDecl = {
  udName: string,
  udVariants: string[],
  pos: i32,
  udNew: i32,
} // type N = A | B
// `isNeg` is 1 for a surface `x !is T` (desugared to `!(x is T)`), else 0 — a
// faithful-surface marker the printer reads to reprint `!is`. Typecheck/emit
// ignore it (the wrapping `Unary "!"` carries the negation).
export type IsExpr = { isObj: i32, isVariant: string, pos: i32, isNeg: i32 } // x is T,  x !is T

// `x as T`, a checked numeric conversion: `asObj` the operand's arena index, `asTy` the
// target as a name the checker resolves with `nameToTy`, `asMode` the family member
// (`error-handling-design.md` §Trio). The exact three differ only in the sad path and
// `wrap` (`x as% T`) has none, so one node carries all four.
export type AsMode = "prop" | "null" | "trap" | "wrap"
export type AsExpr = { asObj: i32, asTy: string, asMode: AsMode, pos: i32 } // x as T

// The unified node type. Declared after its members, since a union alias cannot
// forward-reference. Discriminated with `is`.
export type Node = NumLit |
  StrLit |
  CharLit |
  BoolLit |
  NullLit |
  Ident |
  Unary |
  BinExpr |
  Call |
  Member |
  OptMember |
  Paren |
  ErrExpr |
  LetDecl |
  Param |
  TypeRef |
  FuncDecl |
  IfStmt |
  WhileStmt |
  BreakStmt |
  ContinueStmt |
  RetStmt |
  Block |
  Program |
  FieldDef |
  TypeDecl |
  FieldInit |
  ObjLit |
  ArrayLit |
  Index |
  UnionDecl |
  IsExpr |
  AsExpr |
  ForRange |
  ForIn |
  MatchExpr |
  ImportDecl

// A parse diagnostic: a message plus the token index it is raised at. VL has no
// exceptions, so errors accumulate rather than throw.
export type Diag = { msg: string, at: i32 }

// The whole parser state as one struct: the token stream, the node arena, the diagnostics
// and the cursor, with the constructors pushing straight onto the arena and diagnostics
// fields. It is reached through the module global `P`, which keeps every call site free of
// a state argument.
export type Parser = {
  toks: Tok[],
  nodes: Node[],
  diags: Diag[],
  pos: i32,
}

// The single parser instance. The harness fills `P.toks`, runs the parser, and
// reads `P.nodes` / `P.diags` back out.
export let P: Parser = { toks: [], nodes: [], diags: [], pos: 0 }

// The `P.diags` indices whose diagnostic came from a recovery that provably preserved the
// program the author wrote: no token dropped, none invented. The driver lets the checker
// run past parse diagnostics only when every one is in here. Sparse and index-keyed, since
// a dense column would need pushing in lockstep by every `P.diags.push` in the tree.
export let dgLossless: i32[] = []

// Clear the column. Paired with `P.diags = []`; see `vcDgReset` in driver.vl.
export function dgLosslessReset() {
  dgLossless = []
  0
}

// Mark the `P.diags` index `i` as a lossless recovery's diagnostic. Callers pass
// the index the push is about to occupy (`P.diags.length`), matching `vcDgPush`.
export function dgMarkLossless(i: i32) {
  dgLossless.push(i)
  0
}

// Whether every parse diagnostic raised so far is a lossless recovery's — vacuously true
// for a clean parse, so a caller that cares tests `P.diags.length` itself, as the driver's
// `vcParseBlocked` does. The scan is O(diags × marks), both user-error counts.
export function dgAllLossless(): boolean {
  let i = 0
  while i < P.diags.length {
    let found = false
    let k = 0
    while k < dgLossless.length {
      if dgLossless[k] == i { found = true }
      k = k + 1
    }
    if !found { return false }
    i = i + 1
  }
  true
}

// `nodeToks[i]` is the token index of the last token consumed while building `P.nodes[i]`
// (`addNode` records `P.pos - 1`) — enough to render a `line:col`. A side array, not a
// field per variant, so no node struct changes. Consumers must bounds-check: a harness
// that resets `P.nodes` and not this leaves it misaligned, and out of range is "no span".
export let nodeToks: i32[] = []

// `declNameTok[i]` is the token index of the declaring identifier for `P.nodes[i]` when
// that node is a declaration. `nodeToks[i]` anchors a node at its last token, the wrong
// span for go-to-definition, which jumps to the name. `-1` means fall back to `nodeToks`.
// Parallel to `P.nodes`, grown lazily, bounds-checked on read like `nodeToks`.
export let declNameTok: i32[] = []

// Record `tok` as the declaring-identifier token of `nodeIx`. Grows the parallel
// table to cover `nodeIx` (filling the gap with `-1`). The parser calls this
// right after constructing a declaration node, passing the token index it
// captured when it read the name.
export function mkDeclNameTok(nodeIx: i32, tok: i32) {
  while declNameTok.length <= nodeIx { declNameTok.push(-1) }
  declNameTok[nodeIx] = tok
  0
}

// The declaring-identifier token of `nodeIx` (its name token), or `-1` when none is
// stamped — readers then fall back to the node's anchor token (`nodeToks`).
export function declNameTokOf(nodeIx: i32) {
  if nodeIx >= 0 && nodeIx < declNameTok.length { return declNameTok[nodeIx] }
  -1
}

// Whether the top-level declaration at arena node `ix` carried an `export` modifier. The
// parser drops the keyword from the AST, so it is recovered from the token stream: a
// top-level `function` is `EXPORT? FUNCTION IDENT`, so the name token is exported exactly
// when the token two positions back is `EXPORT`. Lives here as `declNameTok`'s reader.
export function declHasExportKw(ix: i32) {
  const t = declNameTokOf(ix)
  if t < 2 { return false }
  const kw = t - 2
  if kw >= 0 && kw < P.toks.length { return P.toks[kw].kind == "EXPORT" }
  false
}

// Two sidecars parallel to `P.nodes`, lazily grown, bounds-checked, reset per compile.
// `callSiteLoc[callIx]` is the `__callsite__` `ObjLit` minted for that call in a pre-pass
// (a node minted after `nodeTyIx` is sized reads its type back as -1 forever, D969), and
// `defaultGlobalRef[identIx]` marks a default that resolved to a module-scope `const`.
export let callSiteLoc: i32[] = []
export let defaultGlobalRef: i32[] = []

// The spelling of the call-site intrinsic. Legal only as a parameter default
// value; anywhere else it is an ordinary (undeclared) identifier, and the
// checker says so by name.
export const CALLSITE_NAME = "__callsite__"

export function paramDefaultTablesReset() {
  callSiteLoc = []
  defaultGlobalRef = []
  0
}

export function setCallSiteLoc(callIx: i32, locIx: i32) {
  if callIx < 0 { return 0 }
  while callSiteLoc.length <= callIx { callSiteLoc.push(-1) }
  callSiteLoc[callIx] = locIx
  0
}

export function callSiteLocOf(callIx: i32) {
  if callIx >= 0 && callIx < callSiteLoc.length { return callSiteLoc[callIx] }
  -1
}

export function markDefaultGlobalRef(nodeIx: i32) {
  if nodeIx < 0 { return 0 }
  while defaultGlobalRef.length <= nodeIx { defaultGlobalRef.push(0) }
  defaultGlobalRef[nodeIx] = 1
  0
}

export function isDefaultGlobalRef(nodeIx: i32) {
  if nodeIx >= 0 && nodeIx < defaultGlobalRef.length {
    return defaultGlobalRef[nodeIx] == 1
  }
  false
}

// Is `dIx` the `__callsite__` intrinsic — the one default form whose value is per call
// site rather than per declaration? The parser leaves it a plain `Ident`; nothing declares
// that name, so this spelling test is exact.
export function paramDefaultIsCallsite(dIx: i32) {
  if dIx < 0 || dIx >= P.nodes.length { return false }
  const d = P.nodes[dIx]
  if d is Ident { return d.identName == CALLSITE_NAME }
  false
}

// The end char offset (one past the last) of the source `P.nodes[nodeIx]` spans — the stop
// offset of the last token consumed while the node is built. Paired with the node's `pos`
// this is the `[start, stop)` span the formatter slices verbatim. `-1` when `nodeIx`, its
// `nodeToks` entry or the resolved token is out of range, the "no span" a `pos < 0` gives.
export function nodeEndOf(nodeIx: i32) {
  if nodeIx < 0 || nodeIx >= nodeToks.length { return -1 }
  const tk = nodeToks[nodeIx]
  if tk < 0 || tk >= P.toks.length { return -1 }
  const t = P.toks[tk]
  t.start + t.text.length
}

// The type-spelling side arena: `parseTypeName` returns a string every later pass takes
// apart again, so this records what the parser saw as a flat tree — `tsKind[i]` the kind,
// `tsText[i]` the lexeme, children at `tsKids[tsKidStart[i], +tsKidCount[i])`. A spelling
// tree, not a type: resolving `Box<i32>` needs an environment the parser cannot have.
export const TS_NAME = 0    // a bare identifier or primitive name (`i32`, `Cat`, `T`)
export const TS_APP = 1     // `Head<a, b>` — tsText = head, kids = the arguments
export const TS_ARR = 2     // `X[]` — one kid
export const TS_UNION = 3   // `A | B | …` — two or more kids
export const TS_ISECT = 4   // `A & B` — two or more kids
export const TS_NEG = 5     // `!A` — one kid
export const TS_PAREN = 6   // `(A)` / `(A, B)` — the comma list
export const TS_FUNC = 7    // `(params) => ret` — kids = the params, then the RETURN last
export const TS_MAP = 8     // `{[K]: V}` — tsText = the key name, one kid = V
export const TS_OBJ = 9     // `{x: T, y: U}` — kids = `TS_FIELD` nodes
export const TS_FIELD = 10  // one inline-object field — tsText = its name, one kid = its type
export const TS_LITSTR = 11 // a string-literal type — tsText keeps the QUOTED lexeme
export const TS_LITNUM = 12 // a numeric-literal type — tsText is the raw lexeme
export const TS_NULL = 13   // the `null` type
export const TS_ERR = 14    // the `expect("IDENT")` recovery leaf (the parser's `""` name)
// `m(A, B): R` — a method member of a type literal. `tsText` is the member's name and the
// kids are the call's argument types with the result last, `TS_FUNC`'s layout, because a
// method member is a call shape with the receiver implicit. A sibling of `TS_FIELD`, not a
// flavour: `{f: () => string}` demands a closure value, `{f(): string}` only that it types.
export const TS_METHOD = 15

// The synthesized-annotation pin kinds. An emitter-synthesized `TypeRef` can carry a name
// the annotation grammar cannot resolve, because it is an emitter-internal handle rather
// than a type spelling. That provenance travels in its own column — `typecheck`'s pin
// sidecar, keyed by node index — with the payload beside the kind, so no consumer slices.
export const PIN_NONE = 0   // an ordinary type name — `nameToTy` resolves it
export const PIN_SIGKEY = 1 // a monomorphized CLOSURE pin; payload = the `$fnsig` key
export const PIN_ANON = 2   // an interned ANONYMOUS-SHAPE row name (the emitter's `sNames`)

export let tsKind: i32[] = []
export let tsText: string[] = []
export let tsKidStart: i32[] = []
export let tsKidCount: i32[] = []
export let tsKids: i32[] = []
// The child stack. Only ever holds the nodes of the spellings currently open on
// the parser's recursion, so it is empty between annotations.
let tsStack: i32[] = []

// The stack mark a producer takes before parsing its children.
export function tsMark() { tsStack.length }

// Finish a spelling node whose children are the stack region above `mark`: move
// them into `tsKids`, pop them, push the new node. Returns its arena index.
export function tsMk(kind: i32, text: string, mark: i32) {
  const start = tsKids.length
  let i = mark
  while i < tsStack.length {
    tsKids.push(tsStack[i])
    i = i + 1
  }
  const cnt = tsKids.length - start
  while tsStack.length > mark { tsStack.pop() }
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(start)
  tsKidCount.push(cnt)
  const ix = tsKind.length - 1
  tsStack.push(ix)
  ix
}

// Wrap the node on top of the stack (the `[]` array suffix: `X` → `X[]`).
export function tsWrap(kind: i32, text: string) {
  let mark = tsStack.length - 1
  if mark < 0 { mark = 0 }
  tsMk(kind, text, mark)
}

// A childless spelling node built off the stack. `tsMk`'s contract is "the children are
// the stack region above a mark", which only a producer mid-recursion can satisfy; a
// caller holding finished roots needs this plain constructor. Nothing is pushed to
// `tsStack`, so the recursion's balance is untouched.
export function tsLeaf(kind: i32, text: string) {
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(tsKids.length)
  tsKidCount.push(0)
  tsKind.length - 1
}

// The same, with an explicit child list. Used where the parser assembles a
// spelling from roots it already popped — `parseTypeDecl`'s `{ … } & …`
// re-encode, whose first union member is built from the field list it just
// parsed rather than by a `parseTypeName` call.
export function tsMkKids(kind: i32, text: string, kids: i32[]) {
  const start = tsKids.length
  let i = 0
  while i < kids.length {
    tsKids.push(kids[i])
    i = i + 1
  }
  tsKind.push(kind)
  tsText.push(text)
  tsKidStart.push(start)
  tsKidCount.push(kids.length)
  tsKind.length - 1
}

// Take the finished root a type producer left on the stack. Every producer
// pushes exactly one node — the error arm pushes `TS_ERR` — so this is total on
// a producer's return; the `-1` guard is the same "never trap on a misaligned
// side table" contract `nodeToks` / `declNameTok` keep.
export function tsPop() {
  const n = tsStack.length
  if n == 0 { return -1 }
  const ix = tsStack[n - 1]
  tsStack.pop()
  ix
}

// The annotation-node → spelling-root map, as two parallel push columns: `annTsNode[r]` is
// a `TypeRef` node index and `annTsRoot[r]` its spelling root. Sparse rather than parallel
// to `P.nodes`, since annotations are a minority. `annTsNode` is strictly increasing by
// construction, so `annTsOf` is a binary search; a missed reset is a wrong answer, not a hole.
export let annTsNode: i32[] = []
export let annTsRoot: i32[] = []

export function setAnnTs(nodeIx: i32, root: i32) {
  annTsNode.push(nodeIx)
  annTsRoot.push(root)
  0
}

// The multi-root twin, for a node whose type spellings are a list: a `UnionDecl`'s members
// live on the node as a `string[]` and cannot key one root each above. One row per member
// in member order, so `udTsNode` is non-decreasing and a member's root is
// `udTsRoot[first(node) + k]`. A member root may be -1, and the consumer falls back.
export let udTsNode: i32[] = []
export let udTsRoot: i32[] = []

export function setUdTs(nodeIx: i32, roots: i32[]) {
  let i = 0
  while i < roots.length {
    udTsNode.push(nodeIx)
    udTsRoot.push(roots[i])
    i = i + 1
  }
  0
}

// The generic type declaration's parameter list as the parser read it: `type Box<T>` folds
// its parameters into the declared name, and the parser hands the list over rather than
// leaving consumers to take it back out with a `<`-scan. One row per declaration that
// consumed a `<` — so `type Box<> = …` is a row — holding the base name and a name slice.
export let declGpNode: i32[] = []
export let declGpBase: string[] = []
export let declGpStart: i32[] = []
export let declGpCount: i32[] = []
export let declGpName: string[] = []

export function setDeclGp(nodeIx: i32, base: string, names: string[]) {
  declGpNode.push(nodeIx)
  declGpBase.push(base)
  declGpStart.push(declGpName.length)
  declGpCount.push(names.length)
  let i = 0
  while i < names.length {
    declGpName.push(names[i])
    i = i + 1
  }
  0
}

// The row index of `nodeIx`, or -1 when it is not a generic declaration.
function declGpRowOf(nodeIx: i32) {
  let i = 0
  while i < declGpNode.length {
    if declGpNode[i] == nodeIx { return i }
    i = i + 1
  }
  -1
}

// The base name of the generic declaration at `nodeIx` (`Box` of `Box<T>`), or
// "" when the node is not one — which is the answer every caller already treats
// as "this declared name is its own base".
export function declGpBaseOf(nodeIx: i32) {
  const r = declGpRowOf(nodeIx)
  if r < 0 { return "" }
  declGpBase[r]
}

// Its type-parameter names in declaration order; empty for a non-generic node.
export function declGpParamsOf(nodeIx: i32): string[] {
  const out: string[] = []
  const r = declGpRowOf(nodeIx)
  if r < 0 { return out }
  const start = declGpStart[r]
  let i = 0
  while i < declGpCount[r] {
    out.push(declGpName[start + i])
    i = i + 1
  }
  out
}

// D1045 — the body-scoped `type` declarations, marked where they are minted. A `type`
// declared inside a block is lexically scoped, and the parser implements that by mangling
// the name unique (`P` → `P$b7`) and hoisting the declaration into `progStmts`. The node
// is then reachable twice, so the formatter and the merge ask here not to double-count.
export let bodyTyDeclNode: i32[] = []

export function setBodyTyDecl(nodeIx: i32) {
  bodyTyDeclNode.push(nodeIx)
  0
}

// Is `nodeIx` a declaration the parser found inside a block and hoisted into `progStmts`?
// False for every module-scope declaration and every other node kind.
export function isBodyTyDecl(nodeIx: i32): boolean {
  let i = 0
  while i < bodyTyDeclNode.length {
    if bodyTyDeclNode[i] == nodeIx { return true }
    i = i + 1
  }
  false
}

// ── extern declarations: the wasm import manifest ────────────────────────────

// One row per DISTINCT `extern function` name in the module graph, in first-declaration
// order — the order the import section writes, which is what fixes each extern's wasm
// function index. A re-declaration of a name already here lands in the duplicate table
// below, so this stays one row per import.
export let extNames: string[] = []
export let extRets: string[] = []
export let extSigs: string[] = []
export let extPoss: i32[] = []
export let extParBase: i32[] = []
export let extParN: i32[] = []
// The parameter type spellings of every row, contiguous per row — flat rather than a
// `string[][]`, so a row's parameters are `extParTys[base + i]` with no nested list.
export let extParTys: string[] = []
// Every re-declaration of a name already in the manifest, with its rendered signature and
// its own name token. The checker compares each against the manifest row and reports only
// the ones that disagree, so declaring one extern in two modules costs nothing.
export let extDupNames: string[] = []
export let extDupSigs: string[] = []
export let extDupPoss: i32[] = []

// Per-compile reset, called wherever `P.nodes = []` is: the manifest spans the whole module
// graph, so it must outlive one module's parse and must not outlive one program's compile.
export function externReset() {
  extNames = []
  extRets = []
  extSigs = []
  extPoss = []
  extParBase = []
  extParN = []
  extParTys = []
  extDupNames = []
  extDupSigs = []
  extDupPoss = []
  0
}

// The manifest row for `name`, or -1. This index is the identity of an extern everywhere
// downstream: the checker's declaration, the import entry and the call lowering all key on it.
export function externSlot(name: string): i32 {
  let i = 0
  while i < extNames.length {
    if extNames[i] == name { return i }
    i = i + 1
  }
  -1
}

// How many imports the manifest declares — the entry count the import section writes and the
// standalone functype count the type section appends.
export function externCount(): i32 { extNames.length }

export function externNameAt(k: i32): string {
  if k < 0 || k >= extNames.length { return "" }
  extNames[k]
}

// The return type spelling of row `k`; `""` when the declaration named none, which is a void
// import and not a missing one.
export function externRetAt(k: i32): string {
  if k < 0 || k >= extRets.length { return "" }
  extRets[k]
}

// The parameter count of row `k`, or -1 out of range — which every caller treats as "this row
// is not emittable", never as an arity.
export function externArityAt(k: i32): i32 {
  if k < 0 || k >= extParN.length { return -1 }
  extParN[k]
}

// The type spelling of parameter `i` of row `k`, or `""` out of range — read by the functype
// writer and the call lowering, which treat `""` as an unemittable row rather than as a type.
export function externParamAt(k: i32, i: i32): string {
  if k < 0 || k >= extParN.length { return "" }
  if i < 0 || i >= extParN[k] { return "" }
  const at = extParBase[k] + i
  if at < 0 || at >= extParTys.length { return "" }
  extParTys[at]
}

// Record one `extern function` and answer its manifest row. A name already in the manifest
// banks its signature in the duplicate table instead of appending a second import, so two
// modules declaring one extern agree by construction and only a DISAGREEMENT reaches the checker.
export function externAdd(
  name: string,
  params: string[],
  ret: string,
  pos: i32,
) {
  let sig = "("
  let i = 0
  while i < params.length {
    if i > 0 { sig = sig + "," }
    sig = sig + params[i]
    i = i + 1
  }
  sig = sig + ")->" + ret
  const prior = externSlot(name)
  if prior >= 0 {
    extDupNames.push(name)
    extDupSigs.push(sig)
    extDupPoss.push(pos)
    return prior
  }
  extNames.push(name)
  extRets.push(ret)
  extSigs.push(sig)
  extPoss.push(pos)
  extParBase.push(extParTys.length)
  extParN.push(params.length)
  let j = 0
  while j < params.length {
    extParTys.push(params[j])
    j = j + 1
  }
  extNames.length - 1
}

// Constraints phase 1: bounds, kept where annotations are kept. Both tables store an
// annotation node index, never a rendered name, because a declared bound is an annotation
// and rides the path that works end to end — D976 records that the column the checker
// writes for an inferred shape does not. One row per bounded parameter; `<T>` answers -1.
export let fnTpBoundFn: i32[] = []
export let fnTpBoundIx: i32[] = []
export let fnTpBoundAnn: i32[] = []

export function setFnTpBound(fnIx: i32, k: i32, annIx: i32) {
  fnTpBoundFn.push(fnIx)
  fnTpBoundIx.push(k)
  fnTpBoundAnn.push(annIx)
  0
}

// The bound annotation node on type parameter `k` of the `FuncDecl` at `fnIx`, or
// -1 when that parameter is unbounded (or the node is not a function).
export function fnTpBoundOf(fnIx: i32, k: i32) {
  let i = 0
  while i < fnTpBoundFn.length {
    if fnTpBoundFn[i] == fnIx && fnTpBoundIx[i] == k { return fnTpBoundAnn[i] }
    i = i + 1
  }
  -1
}

// Does this function declare any bounded type parameter? The cheap gate every
// consumer takes before doing bound work, so an unbounded generic pays one scan.
export function fnHasTpBound(fnIx: i32) {
  let i = 0
  while i < fnTpBoundFn.length {
    if fnTpBoundFn[i] == fnIx { return true }
    i = i + 1
  }
  false
}

// One row per bound alias declaration (`type Showable = { toString(): string }`, a `type`
// whose body carries at least one method member). The row holds the whole body as one
// synthetic-object annotation node, so `<T: Showable>` and `<T: { toString(): string }>`
// reach the identical spelling tree. The declaration itself is minted with no fields.
export let declBoundNode: i32[] = []
export let declBoundAnn: i32[] = []

export function setDeclBound(nodeIx: i32, annIx: i32) {
  declBoundNode.push(nodeIx)
  declBoundAnn.push(annIx)
  0
}

// The bound-body annotation node of the declaration at `nodeIx`, or -1 when it is
// an ordinary type declaration.
export function declBoundOf(nodeIx: i32) {
  let i = 0
  while i < declBoundNode.length {
    if declBoundNode[i] == nodeIx { return declBoundAnn[i] }
    i = i + 1
  }
  -1
}

// The module merge renames a declaration's base segment (`Box` → `Box$m1`) and writes it
// back into `tdName`/`udName`. The bank is a second copy of that segment and must move
// with it — the same lockstep `modRwType` keeps between a `TypeRef`'s tree and its name; a
// stale base registers the alias under a name no application spells.
export function setDeclGpBase(nodeIx: i32, base: string) {
  const r = declGpRowOf(nodeIx)
  if r >= 0 { declGpBase[r] = base }
  0
}

// The `k`-th member spelling root recorded for `nodeIx`, or -1 when the node has
// none (or fewer than `k + 1`). Binary search for the leftmost row of `nodeIx`
// over the non-decreasing key column, then index by `k`.
export function udTsRootAt(nodeIx: i32, k: i32) {
  let lo = 0
  let hi = udTsNode.length - 1
  let first = -1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = udTsNode[mid]
    if at < nodeIx {
      lo = mid + 1
    } else {
      if at == nodeIx { first = mid }
      hi = mid - 1
    }
  }
  if first < 0 { return -1 }
  const r = first + k
  if r >= udTsNode.length { return -1 }
  if udTsNode[r] != nodeIx { return -1 }
  udTsRoot[r]
}

// Drop the `k`-th member spelling root of `nodeIx` — `clearAnnTs`'s twin for the multi-root
// table, under the same invariant: a live root renders to the spelling the node currently
// carries. `canonEmitTypeNames`'s `UnionDecl` arm rewrites `udVariants[k]` in place, which
// is not a rename. The same binary search `udTsRootAt` walks; a node with no row is spared.
export function clearUdTs(nodeIx: i32, k: i32) {
  let lo = 0
  let hi = udTsNode.length - 1
  let first = -1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = udTsNode[mid]
    if at < nodeIx {
      lo = mid + 1
    } else {
      if at == nodeIx { first = mid }
      hi = mid - 1
    }
  }
  if first < 0 { return 0 }
  const r = first + k
  if r >= udTsNode.length { return 0 }
  if udTsNode[r] != nodeIx { return 0 }
  udTsRoot[r] = -1
  0
}

// The spelling-tree root recorded for `nodeIx`, or `-1` when none is — every non-`TypeRef`
// node, an emitter-synthesized `TypeRef` built from a name that never passed through the
// parser, and the string-only type spellings the parser still drops (`as`).
export function annTsOf(nodeIx: i32) {
  let lo = 0
  let hi = annTsNode.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = annTsNode[mid]
    if at == nodeIx { return annTsRoot[mid] }
    if at < nodeIx { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// Drop the spelling root recorded for `nodeIx`, so `annTsOf` answers -1 and every consumer
// falls back to the node's name. The invariant this table is only useful under is that a
// live root renders to the node's current name, and canon rewrites `TypeRef.tyName` in
// place without renaming it, so the tree it leaves behind describes a different type.
export function clearAnnTs(nodeIx: i32) {
  let lo = 0
  let hi = annTsNode.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = annTsNode[mid]
    if at == nodeIx {
      annTsRoot[mid] = -1
      return 0
    }
    if at < nodeIx { lo = mid + 1 } else { hi = mid - 1 }
  }
  0
}

// Clear the spelling arena and its node columns. The driver calls this alongside
// `P.nodes = []` / `nodeToks = []` — a recorded root indexes this program's
// arena and means nothing against the next one's.
export function tsReset() {
  tsKind = []
  tsText = []
  tsKidStart = []
  tsKidCount = []
  tsKids = []
  tsStack = []
  annTsNode = []
  annTsRoot = []
  udTsNode = []
  udTsRoot = []
  declGpNode = []
  declGpBase = []
  declGpStart = []
  declGpCount = []
  declGpName = []
  bodyTyDeclNode = []
  fnTpBoundFn = []
  fnTpBoundIx = []
  fnTpBoundAnn = []
  declBoundNode = []
  declBoundAnn = []
  // D1003 — the plain→mangled UFCS alias table belongs to one program too. A single-file
  // compile following a module compile on the same instance would otherwise inherit the
  // previous program's rows, so UFCS resolution answers with a mangled name no function in
  // the new program declares. Invisible from the CLI; live in the LSP and the harness.
  ufcsAliasReset()
  ufcsImpReset()
  0
}

// Render a spelling node back to the synthetic type name the parser built from it — arm
// for arm, the exact concatenations of `parseTypeName` / `parseTypeIsect` /
// `parseTypeAtom`, so `tsToName(annTsOf(ix))` reproduces `TypeRef.tyName` character for
// character. This is the tree's write-back; -1 renders "", the parser's recovery answer.
export function tsToName(ix: i32): string {
  if ix < 0 { return "" }
  const k = tsKind[ix]
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  if k == TS_NAME { return tsText[ix] }
  if k == TS_LITSTR { return tsText[ix] }
  if k == TS_LITNUM { return tsText[ix] }
  if k == TS_NULL { return "null" }
  if k == TS_ERR { return "" }
  if k == TS_ARR { return tsToName(tsKids[start]) + "[]" }
  if k == TS_NEG { return "!" + tsToName(tsKids[start]) }
  if k == TS_MAP {
    return "{[" + tsText[ix] + "]:" + tsToName(tsKids[start]) + "}"
  }
  if k == TS_FIELD { return tsText[ix] + ":" + tsToName(tsKids[start]) }
  if (
    k == TS_APP ||
    k == TS_PAREN ||
    k == TS_OBJ ||
    k == TS_FUNC ||
    k == TS_METHOD
  ) {
    // The comma-joined child list. `TS_FUNC` and `TS_METHOD` hold their result as
    // the last kid (`parseTypeAtom` / `parseMethodMemberTail`'s contract), so the
    // join stops one short of it.
    let last = cnt
    if k == TS_FUNC || k == TS_METHOD { last = cnt - 1 }
    let inner = ""
    let i = 0
    while i < last {
      if i > 0 { inner = inner + "," }
      inner = inner + tsToName(tsKids[start + i])
      i = i + 1
    }
    if k == TS_APP { return tsText[ix] + "<" + inner + ">" }
    if k == TS_PAREN { return "(" + inner + ")" }
    if k == TS_OBJ { return "{" + inner + "}" }
    if k == TS_METHOD {
      return tsText[ix] + "(" + inner + "):" + tsToName(tsKids[start + cnt - 1])
    }
    return "(" + inner + ")=>" + tsToName(tsKids[start + cnt - 1])
  }
  // `TS_UNION` / `TS_ISECT` — the members joined by their own separator.
  let sep = "|"
  if k == TS_ISECT { sep = "&" }
  let out = ""
  let i = 0
  while i < cnt {
    if i > 0 { out = out + sep }
    out = out + tsToName(tsKids[start + i])
    i = i + 1
  }
  out
}

// Does the spelling tree rooted at `ix` contain a node of kind `kind` anywhere? The
// structural form of "the rendered name contains `=>`" and its siblings — a whole-tree
// question, where `tsMentionsAnyName` asks a whole-leaf one.
export function tsHasKind(ix: i32, kind: i32): boolean {
  if ix < 0 || ix >= tsKind.length { return false }
  if tsKind[ix] == kind { return true }
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  let j = 0
  while j < cnt {
    if tsHasKind(tsKids[start + j], kind) { return true }
    j = j + 1
  }
  false
}

// Does the spelling tree rooted at `ix` name any of `names`? It walks the structure
// `resolveAnnotTs` resolves against, so it answers about the annotation the author wrote
// rather than a synthetic name string: `T`, `T[]`, `Box<T>` and `{a: T}` all mention `T`,
// while `Trace` does not (a leaf is compared whole). The `TS_APP` head is compared too.
export function tsMentionsAnyName(ix: i32, names: string[]) {
  if ix < 0 || ix >= tsKind.length || names.length == 0 { return false }
  const k = tsKind[ix]
  if k == TS_NAME || k == TS_APP {
    let i = 0
    while i < names.length {
      if names[i] == tsText[ix] { return true }
      i = i + 1
    }
  }
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  let j = 0
  while j < cnt {
    if tsMentionsAnyName(tsKids[start + j], names) { return true }
    j = j + 1
  }
  false
}

// ── Arena constructors ───────────────────────────────────────────────────────
// Each appends its variant to `P.nodes` and returns the new node's index. Every
// constructor takes `pos` — the char offset of the construct's start token, captured at
// parse entry before the children parse, or `-1` for a synthesized node.

export function addNode(n: Node) {
  P.nodes.push(n)
  let tk = P.pos - 1
  if tk < 0 { tk = 0 }
  nodeToks.push(tk)
  P.nodes.length - 1
}

export function mkNum(text: string, pos: i32) {
  const n: Node = { numText: text, pos: pos }
  addNode(n)
}

export function mkStr(text: string, pos: i32) {
  const n: Node = { strText: text, pos: pos }
  addNode(n)
}

export function mkChar(text: string, pos: i32) {
  const n: Node = { charText: text, pos: pos }
  addNode(n)
}

export function mkBool(v: i32, pos: i32) {
  const n: Node = { boolVal: v, pos: pos }
  addNode(n)
}

export function mkNull(kw: string, pos: i32) {
  const n: Node = { nullKw: kw, pos: pos }
  addNode(n)
}

export function mkIdent(name: string, pos: i32) {
  const n: Node = { identName: name, pos: pos }
  addNode(n)
}

export function mkUnary(op: string, arg: i32, pos: i32) {
  const n: Node = { unOp: op, unArg: arg, pos: pos }
  addNode(n)
}

export function mkBinary(op: string, left: i32, right: i32, pos: i32) {
  const n: Node = {
    binOp: op,
    binLeft: left,
    binRight: right,
    pos: pos,
    binCompound: "",
    binTpl: 0,
  }
  addNode(n)
}

// The identifier a template hole's desugared call names. It is deliberately unspellable —
// `$` is not an identifier character — so no user program can declare, shadow or reference
// it, which is what makes a template's meaning independent of the author's imports. The
// merge rewrites it to `toStr$mN` through an ordinary rename row.
export const TPL_RENDER_LOCAL = "$tpl$render"

// The root `+` of a template literal's concatenation — `mkBinary` plus the
// faithful-surface marker the printer reads (see `BinExpr.binTpl`).
export function mkTplConcat(left: i32, right: i32, pos: i32) {
  const n: Node = {
    binOp: "+",
    binLeft: left,
    binRight: right,
    pos: pos,
    binCompound: "",
    binTpl: 1,
  }
  addNode(n)
}

// Parallel to `P.nodes`, grown lazily, bounds-checked on read — `nodeToks`' contract. `1`
// marks a node that is a template hole's expression. A side table and not a node kind
// because the hole is an ordinary expression: the single consumer is the checker's
// argument-mismatch report, and the mark has to survive the merge's identifier rewrite.
export let tplHole: i32[] = []

// Mark `nodeIx` as a template hole's expression. Bounds-guarded on the write as well as
// the read: every caller passes a constructor's result and so cannot pass a negative, but
// a `tplHole[-1] = 1` would trap inside the compiler with no diagnostic and no position.
export function mkTplHole(nodeIx: i32) {
  if nodeIx < 0 { return 0 }
  while tplHole.length <= nodeIx { tplHole.push(0) }
  tplHole[nodeIx] = 1
  0
}

// True when `nodeIx` is the expression of a `${…}` hole.
export function nodeIsTplHole(nodeIx: i32) {
  if nodeIx < 0 || nodeIx >= tplHole.length { return false }
  tplHole[nodeIx] == 1
}

// A compound assignment `target op= value`, desugared to `target = (target op
// value)` for typecheck/emit but tagged with the SURFACE operator (`binCompound`)
// so the printer reprints `target op= value`. The target node is shared between
// the read (inner arith) and the write (outer `=`) — arena reads are pure.
export function mkCompoundAssign(
  op: string,
  target: i32,
  value: i32,
  pos: i32,
) {
  const inner = mkBinary(op, target, value, pos)
  const n: Node = {
    binOp: "=",
    binLeft: target,
    binRight: inner,
    pos: pos,
    binCompound: op,
    binTpl: 0,
  }
  addNode(n)
}

// A prefix increment `++target` / `--target` (`incr` is `"++"`/`"--"`), desugared
// to `target = (target ± 1)` — yielding the new value, the prefix semantics — and
// tagged on `binCompound` with the surface `++`/`--` so the printer reprints the
// prefix form (postfix `x++` rides a `Unary "p+"` instead; see the parser).
export function mkPreIncr(incr: string, target: i32, pos: i32) {
  let op = "+"
  if incr == "--" { op = "-" }
  const inner = mkBinary(op, target, mkNum("1", -1), pos)
  const n: Node = {
    binOp: "=",
    binLeft: target,
    binRight: inner,
    pos: pos,
    binCompound: incr,
    binTpl: 0,
  }
  addNode(n)
}

export function mkCall(fn: i32, args: i32[], pos: i32) {
  // All-positional (the synthesizers' constructor): an empty names list.
  const names: string[] = []
  mkCallN(fn, args, names, pos)
}

// A call with per-argument names (parallel to `args`; "" = positional) — the
// parser's constructor for argument lists that may carry `name: value` entries.
export function mkCallN(fn: i32, args: i32[], names: string[], pos: i32) {
  const n: Node = { callFn: fn, callArgs: args, callArgNames: names, pos: pos }
  addNode(n)
}

// True iff any per-argument name is present (a non-"" entry) — the cheap gate
// every consumer checks before paying for `orderArgsByParamNames`.
export function hasNamedArgs(names: string[]) {
  let i = 0
  while i < names.length {
    if names[i] != "" { return true }
    i = i + 1
  }
  false
}

// UFCS resolution across the module merge. A member call `recv.prop(args)` whose `prop`
// names a free `self`-function keeps `prop` plain on its `Member`, so a struct callable
// field of the same name keeps precedence. The merge mangles such functions, so the merged
// name is recovered where UFCS resolves, after the field check. Empty in single-file mode.

// D1120 — the plain name is not a key: two merged modules may each export a `self`-function
// called `area`, so the answer is banked per call site in `ufcsSiteTo[callIx]`. Node indices
// are stable from the merge walk through `checkProgram` and `emitProgram`, which is what
// lets three consumers in two phases read one answer.

// D1191 — and the plain name is not a scope either: a global name-keyed map let a module's
// own un-exported `self`-function answer another module's call. The rule is the direct
// call's rule, that a UFCS candidate must be a name the caller binds. `ufcsScope*` is that
// scope, one row per (module, plain name); `ufcsModBound` maps a node back to its module.
export let ufcsSiteTo: string[] = []
export let ufcsScopeMod: i32[] = []
export let ufcsScopeFrom: string[] = []
export let ufcsScopeTo: string[] = []
export let ufcsModBound: i32[] = []
export let ufcsModIx: i32[] = []
export function ufcsAliasReset() {
  ufcsSiteTo = []
  ufcsScopeMod = []
  ufcsScopeFrom = []
  ufcsScopeTo = []
  ufcsModBound = []
  ufcsModIx = []
  0
}
// Bank the mangled self-function the UFCS member-call node `callIx` resolves to.
export function ufcsSiteAdd(callIx: i32, mangled: string) {
  if callIx < 0 { return 0 }
  while ufcsSiteTo.length <= callIx { ufcsSiteTo.push("") }
  ufcsSiteTo[callIx] = mangled
  0
}
// The per-site answer for the call at `callIx`, or "" when the walk banked none.
export function ufcsSiteOf(callIx: i32) {
  if callIx >= 0 && callIx < ufcsSiteTo.length { return ufcsSiteTo[callIx] }
  ""
}
// Module `m` binds plain `plain` to the merged `self`-function `mangled` — one
// row per name in that module's scope, declaration or import (alias included).
export function ufcsScopeAdd(m: i32, plain: string, mangled: string) {
  ufcsScopeMod.push(m)
  ufcsScopeFrom.push(plain)
  ufcsScopeTo.push(mangled)
  0
}
// The merged `self`-function module `m` binds `plain` to, or "" when it binds
// none — the UFCS half of "is this name in scope here".
export function ufcsScopeIn(m: i32, plain: string) {
  let i = 0
  while i < ufcsScopeFrom.length {
    if ufcsScopeMod[i] == m && ufcsScopeFrom[i] == plain {
      return ufcsScopeTo[i]
    }
    i = i + 1
  }
  ""
}
// Record module `m`'s highest arena node (its `Program` root, minted last). Pushed
// in merge-walk order, so the bounds ascend and `ufcsModOfNode` is one scan.
export function ufcsModBoundAdd(m: i32, rootIx: i32) {
  ufcsModIx.push(m)
  ufcsModBound.push(rootIx)
  0
}
// The module owning arena node `ix`, or -1 when no merge ran (a single file) or the node
// is minted after parsing (a desugar's fresh node, past every root). -1 means "no scope to
// check", which the readers below spell as the plain name.
export function ufcsModOfNode(ix: i32) {
  let i = 0
  while i < ufcsModBound.length {
    if ix <= ufcsModBound[i] { return ufcsModIx[i] }
    i = i + 1
  }
  -1
}
// The merged `self`-function plain `name` resolves to in the scope of the module
// owning node `nodeIx` — the reader for a question asked away from a call site
// (`witnessOf` judges a bound before any call exists). Identity when that module
// binds no such name, so the ordinary `no field` refusal follows.
export function ufcsAliasInScope(nodeIx: i32, name: string) {
  const m = ufcsModOfNode(nodeIx)
  if m < 0 { return name }
  const t = ufcsScopeIn(m, name)
  if t != "" { return t }
  name
}
// The mangled self-function the UFCS member call at `callIx` resolves to: that site's own
// answer when the merge walk banked one (D1120), else the caller's module scope. The one
// entry point for the three consumers that hold a call node, so the checker and the emitter
// cannot pick different modules' functions for one call.
export function ufcsAliasAtSite(callIx: i32, name: string) {
  const site = ufcsSiteOf(callIx)
  if site != "" { return site }
  ufcsAliasInScope(callIx, name)
}

// UFCS candidates the entry file has not imported (D1230's diagnostic). UFCS is explicit:
// `toEqual` resolves only against names in scope, so the program is illegal — but the one
// thing the compiler knows and does not say is that `toEqual` sits in a module the file
// already names. A row is a candidate, not a verdict; `ufcsWouldDispatch` decides per call.
export let ufcsImpName: string[] = []    // the plain source name (`toEqual`)
export let ufcsImpMangled: string[] = [] // the merged name (`toEqual$m1`)
export let ufcsImpSpec: string[] = []    // how the ENTRY names that module (`std:test`)
// Whether the entry's OWN imports already name `ufcsImpSpec[i]`'s module (some other
// name from it), so D1230's sentence can say "add to the existing import" rather than
// "add an import" — the same fact `modUfcsSpecFromEntry` decided, carried alongside.
export let ufcsImpAlready: boolean[] = []
export function ufcsImpReset() {
  ufcsImpName = []
  ufcsImpMangled = []
  ufcsImpSpec = []
  ufcsImpAlready = []
  0
}
export function ufcsImpAdd(
  plain: string,
  mangled: string,
  spec: string,
  already: boolean,
) {
  let i = 0
  while i < ufcsImpName.length {
    if ufcsImpName[i] == plain && ufcsImpMangled[i] == mangled { return 0 }
    i = i + 1
  }
  ufcsImpName.push(plain)
  ufcsImpMangled.push(mangled)
  ufcsImpSpec.push(spec)
  ufcsImpAlready.push(already)
  0
}

// Whether `spec` (one of `ufcsMissingImportSpecs`' candidates) is a module the entry
// already imports something from — the lookup `ufcsNotImportedMsg` needs to phrase
// D1230's closing clause as an edit to an existing import rather than a new one.
export function ufcsSpecAlreadyImported(spec: string): boolean {
  let i = 0
  while i < ufcsImpSpec.length {
    if ufcsImpSpec[i] == spec { return ufcsImpAlready[i] }
    i = i + 1
  }
  false
}

// Free index-operator declaration names. `function "[]"(self: T, i: I)` and `"[]="` are
// free functions whose name is an operator, so a program may declare one per receiver type,
// while every name-keyed table holds one entry per name — so the parser mints
// `[]@F32View`. The `@` cannot occur in an identifier, which makes the encoding total.
export const OP_INDEX_GET = "[]"
export const OP_INDEX_SET = "[]="

// The operator names whose dispatch is binary: the quoted-function-name set minus the two
// bracket operators, whose arity is the index rule's and is checked at the hoist, and minus
// `==`/`!=`, which `parseFuncHead` refuses by name (D46). Here rather than in `parser.vl`
// because three declaration-site gates read it and none may drift from the others.
export function isBinOpFuncName(name: string) {
  name == "+" ||
    name == "-" ||
    name == "*" ||
    name == "/" ||
    name == "%" ||
    name == "^" ||
    name == ">" ||
    name == ">=" ||
    name == "<" ||
    name == "<="
}

// The declaration name for operator `op` on a receiver spelled `recv`.
export function opDeclName(op: string, recv: string): string { op + "@" + recv }

// The offset of the `@` separator in `name`, or -1 when it carries none.
function opDeclAt(name: string): i32 {
  let i = 0
  while i < name.length {
    if name[i] == '@' { return i }
    i = i + 1
  }
  -1
}

// The index operator a declaration name implements, or "" when `name` is an ordinary
// function's. Total over merge-mangled names (the `$mN` rides in the receiver half) and
// over every identifier, since no identifier contains `@`.
export function opDeclOpOf(name: string): string {
  const at = opDeclAt(name)
  if at < 0 { return "" }
  const op = name.slice(0, at)
  if op == OP_INDEX_GET { return op }
  if op == OP_INDEX_SET { return op }
  ""
}

// The receiver-spelling half of an operator declaration name (with any `$mN`
// the merge appended), or "" for an ordinary name.
export function opDeclRecvOf(name: string): string {
  if opDeclOpOf(name) == "" { return "" }
  const recv = name.slice(opDeclAt(name) + 1, name.length)
  recv
}

// How an operator declaration reads back to a user: `"[]" for F32View`. Every
// diagnostic that would otherwise print the minted name routes through this, so
// the `@` encoding never reaches a message. An ordinary name is returned as-is.
export function opDeclLabel(name: string): string {
  const op = opDeclOpOf(name)
  if op == "" { return name }
  "\"" + op + "\" for " + opDeclRecvOf(name)
}

// Bind call arguments to parameter slots by name, then positionally — the single source of
// truth shared by the checker and the emitter. Returns one value-node index per parameter
// in parameter order (-1 where no argument filled the slot), followed by any leftover
// arguments in source order, so nothing is silently dropped. Callers diagnose the errors.
export function orderArgsByParamNames(
  paramNames: string[],
  args: i32[],
  argNames: string[],
) {
  const slots: i32[] = []
  let i = 0
  while i < paramNames.length {
    slots.push(-1)
    i = i + 1
  }
  const leftover: i32[] = []
  const positional: i32[] = []
  // First place named arguments by parameter name.
  let j = 0
  while j < args.length {
    let nm = ""
    if j < argNames.length { nm = argNames[j] }
    if nm == "" {
      positional.push(args[j])
    } else {
      let pIx = -1
      let k = 0
      while k < paramNames.length {
        if pIx < 0 && paramNames[k] == nm { pIx = k }
        k = k + 1
      }
      if pIx < 0 || slots[pIx] >= 0 {
        // Unknown name, or a slot already filled (named collision): leave it
        // for the caller to diagnose rather than overwriting.
        leftover.push(args[j])
      } else {
        slots[pIx] = args[j]
      }
    }
    j = j + 1
  }
  // Then fill the remaining slots, in order, with positional arguments.
  let nx = 0
  let p = 0
  while p < positional.length {
    while nx < slots.length && slots[nx] >= 0 { nx = nx + 1 }
    if nx < slots.length {
      slots[nx] = positional[p]
      nx = nx + 1
    } else {
      leftover.push(positional[p])
    }
    p = p + 1
  }
  let r = 0
  while r < leftover.length {
    slots.push(leftover[r])
    r = r + 1
  }
  slots
}

export function mkMember(obj: i32, prop: string, pos: i32) {
  const n: Node = { memObj: obj, memProp: prop, pos: pos }
  addNode(n)
}

export function mkIndex(arr: i32, idx: i32, pos: i32) {
  const n: Node = { idxArr: arr, idxIndex: idx, pos: pos }
  addNode(n)
}

export function mkArrayLit(elems: i32[], pos: i32) {
  const n: Node = { arrElems: elems, pos: pos }
  addNode(n)
}

export function mkOptMember(obj: i32, prop: string, pos: i32) {
  const n: Node = { omObj: obj, omProp: prop, pos: pos }
  addNode(n)
}

export function mkParen(inner: i32, pos: i32) {
  const n: Node = { parInner: inner, pos: pos }
  addNode(n)
}

export function mkErr(what: string, at: i32, pos: i32) {
  const n: Node = { errWhat: what, errAt: at, pos: pos }
  addNode(n)
}

export function mkLet(kw: string, name: string, ty: i32, init: i32, pos: i32) {
  const n: Node = {
    letKw: kw,
    letName: name,
    letType: ty,
    letInit: init,
    pos: pos,
  }
  addNode(n)
}

export function mkParam(name: string, ty: i32, dflt: i32, opt: i32, pos: i32) {
  const n: Node = {
    parName: name,
    parType: ty,
    parDefault: dflt,
    parOpt: opt,
    pos: pos,
  }
  addNode(n)
}

// The default-value expression of the parameter node `pIx`, or -1 when it has
// none (or `pIx` is not a `Param`). The one reader of `parDefault` outside the
// parser/printer, so a caller never re-narrows the node itself.
export function paramDefaultOf(pIx: i32) {
  if pIx < 0 || pIx >= P.nodes.length { return -1 }
  const p = P.nodes[pIx]
  if p is Param { return p.parDefault }
  -1
}

// Fill every unfilled slot of a parameter-ordered argument list with that parameter's
// default expression, in place; returns the position of the first slot that stays unfilled,
// or -1. The default's node is shared by every call site rather than cloned, exact because
// it carries no per-occurrence state. `__callsite__` is the exception, which `callIx` serves.
export function fillArgDefaults(slots: i32[], dParams: i32[], callIx: i32) {
  let i = 0
  while i < slots.length {
    if slots[i] < 0 {
      let d = -1
      if i < dParams.length { d = paramDefaultOf(dParams[i]) }
      if d < 0 { return i }
      if paramDefaultIsCallsite(d) { d = callSiteLocOf(callIx) }
      if d < 0 { return i }
      slots[i] = d
    }
    i = i + 1
  }
  -1
}

// How many leading arguments a direct call must supply: every parameter up to the first
// one carrying a default. Defaults are trailing-only, so this is the low end of the
// accepted arity range and `params.length` the high end; a list with no defaults answers
// its own length.
export function fnRequiredArity(params: i32[]) {
  let i = 0
  while i < params.length {
    if paramDefaultOf(params[i]) >= 0 { return i }
    i = i + 1
  }
  params.length
}

export function mkTypeRef(name: string, pos: i32) {
  const n: Node = { tyName: name, pos: pos }
  addNode(n)
}

export function mkFunc(
  name: string,
  typarams: string[],
  params: i32[],
  ret: i32,
  body: i32,
  pos: i32,
) {
  const n: Node = {
    fnName: name,
    fnTyParams: typarams,
    fnParams: params,
    fnRet: ret,
    fnBody: body,
    pos: pos,
  }
  addNode(n)
}

export function mkIf(cond: i32, thenB: i32, els: i32, pos: i32) {
  const n: Node = { ifCond: cond, ifThen: thenB, ifElse: els, pos: pos }
  addNode(n)
}

// Loop constructors take the optional loop label last ("" = unlabelled).
export function mkWhile(cond: i32, body: i32, label: string, pos: i32) {
  const n: Node = {
    whileCond: cond,
    whileBody: body,
    whileLabel: label,
    pos: pos,
  }
  addNode(n)
}

export function mkForRange(
  v: string,
  from: i32,
  to: i32,
  step: i32,
  body: i32,
  label: string,
  pos: i32,
) {
  const n: Node = {
    frVar: v,
    frFrom: from,
    frTo: to,
    frStep: step,
