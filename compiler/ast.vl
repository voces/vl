  addNode(n)
}

export function mkIsExpr(obj: i32, variant: string, pos: i32) {
  const n: Node = { isObj: obj, isVariant: variant, pos: pos, isNeg: 0 }
  addNode(n)
}

// A negated type guard `x !is T`, desugared to `!(x is T)` (a `Unary "!"` over
// this node) for typecheck/emit's narrowing, but flagged `isNeg` so the printer
// reprints the surface `!is` instead of `!(… is …)`.
export function mkIsExprNeg(obj: i32, variant: string, pos: i32) {
  const n: Node = { isObj: obj, isVariant: variant, pos: pos, isNeg: 1 }
  addNode(n)
}

// `x as T` — an explicit numeric cast (B2). `ty` is the target type name string.
export function mkAsExpr(obj: i32, ty: string, mode: AsMode, pos: i32) {
  const n: Node = { asObj: obj, asTy: ty, asMode: mode, pos: pos }
  addNode(n)
}

// ── int → string ─────────────────────────────────────────────────────────────
// A hand-rolled decimal converter. `i32ToStr` is the shared count/index renderer
// across the self-host: the checker, emitter, and driver import it for
// diagnostics and synthetic names.
function digitChar(d: i32) {
  if d == 0 { return "0" }
  if d == 1 { return "1" }
  if d == 2 { return "2" }
  if d == 3 { return "3" }
  if d == 4 { return "4" }
  if d == 5 { return "5" }
  if d == 6 { return "6" }
  if d == 7 { return "7" }
  if d == 8 { return "8" }
  "9"
}

export function i32ToStr(n: i32) {
  if n == 0 { return "0" }
  // Peel digits in the negative range: every i32 (including INT_MIN, whose
  // magnitude overflows i32) is representable as -|n|, so negate positives
  // instead of negatives. Wasm `rem_s` of a negative operand yields -digit.
  const neg = n < 0
  let m = n
  if !neg { m = 0 - m }
  let out = ""
  while m < 0 {
    out = digitChar(0 - (m % 10)) + out
    m = m / 10
  }
  if neg { out = "-" + out }
  out
}

// The empty child list, shared rather than minted per call. Safe for the same reason a
// kind whose children are exactly one arena field returns that field: `nodeChildren`'s
// result is read-only to every caller — all of them index it and read `.length`, none
// appends — and just under half the nodes in a parse have no children at all.
const nodeNoKids: i32[] = []

// The child arena indices of `P.nodes[ix]` in source order; a slot holding `-1` is pushed
// as-is and the walker's bounds check skips it. Covers value children and type-annotation
// slots. A `MatchExpr`'s patterns are deliberately not children — a pattern is a shape, not
// a value reference — and `matchBinds` is out because it reads the shared scrutinee node.
export function nodeChildren(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return nodeNoKids }
  const n = P.nodes[ix]
  // Arms in descending kind frequency, each returning, so the ladder is walked only to the
  // rung a node needs; a kind with no arm falls out of the end without allocating.
  if n is Ident { return nodeNoKids }
  if n is BinExpr {
    const out: i32[] = [n.binLeft, n.binRight]
    return out
  }
  if n is Block { return n.blkStmts }
  if n is Call {
    const out: i32[] = [n.callFn]
    let i = 0
    while i < n.callArgs.length {
      out.push(n.callArgs[i])
      i = i + 1
    }
    return out
  }
  if n is NumLit { return nodeNoKids }
  if n is IfStmt {
    const out: i32[] = [n.ifCond, n.ifThen, n.ifElse]
    return out
  }
  if n is Member {
    const out: i32[] = [n.memObj]
    return out
  }
  if n is RetStmt {
    const out: i32[] = [n.retArg]
    return out
  }
  if n is LetDecl {
    const out: i32[] = [n.letType, n.letInit]
    return out
  }
  if n is StrLit { return nodeNoKids }
  if n is TypeRef { return nodeNoKids }
  if n is Paren {
    const out: i32[] = [n.parInner]
    return out
  }
  if n is Index {
    const out: i32[] = [n.idxArr, n.idxIndex]
    return out
  }
  if n is Param {
    const out: i32[] = [n.parType, n.parDefault]
    return out
  }
  if n is FuncDecl {
    const out: i32[] = []
    let i = 0
    while i < n.fnParams.length {
      out.push(n.fnParams[i])
      i = i + 1
    }
    out.push(n.fnRet)
    out.push(n.fnBody)
    return out
  }
  if n is ArrayLit { return n.arrElems }
  if n is ObjLit { return n.objFields }
  if n is FieldInit {
    const out: i32[] = [n.fiValue]
    return out
  }
  if n is Unary {
    const out: i32[] = [n.unArg]
    return out
  }
  if n is IsExpr {
    const out: i32[] = [n.isObj]
    return out
  }
  if n is WhileStmt {
    const out: i32[] = [n.whileCond, n.whileBody]
    return out
  }
  if n is AsExpr {
    const out: i32[] = [n.asObj]
    return out
  }
  if n is ForIn {
    const out: i32[] = [n.fiIter, n.fiBody]
    return out
  }
  if n is ForRange {
    const out: i32[] = [n.frFrom, n.frTo, n.frStep, n.frBody]
    return out
  }
  if n is MatchExpr {
    const out: i32[] = [n.matchScrut]
    let i = 0
    while i < n.matchBodies.length {
      out.push(n.matchBodies[i])
      i = i + 1
    }
    return out
  }
  if n is OptMember {
    const out: i32[] = [n.omObj]
    return out
  }
  if n is FieldDef {
    const out: i32[] = [n.fdType]
    return out
  }
  if n is TypeDecl { return n.tdFields }
  if n is Program { return n.progStmts }
  nodeNoKids
}
