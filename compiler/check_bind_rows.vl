// Binding rows: the depth-tagged marks for collapsed, object-literal and function-literal
// bindings, the rows a write above its declaration waits in, and each call's bind row.
// Emptied by `bindRowsReset`. Does not import the checker.
import {
  cexLitPeel,
  numLitFitsStore,
  numLitInsertBySpan,
  numLitValuesFit,
} from "./check_num_lits"
import { identFnAliasOf, identFnDeclOf, identTyOf } from "./check_scopes"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
