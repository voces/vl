// `check_types.vl` — the type checker's type arena and the queries that read only it.
// `T` holds the arena `T.tys`, the scope chain and the diagnostics; the `Ty` variants are
// its rows, every nested type an `i32` index into it, and the `mk*` constructors here
// append them (`mkUnionTy` and `mkTyVar` read checker state, so they stay in the checker).
// Beside the arena sit the named-type registries (`cStruct*`, `cUnion*`, the
// generic-application rows `gaApp*`) and the literal-union naming table (`lu*`), with
// rendering (`tyToStr`, `tyToEmitName`), equality (`tyEq`) and the `ty*` predicates over
// them. Nothing here reads a node, the scope chain's bindings or `tErr`; `typecheck.vl`
// resets the tables in `initChecker`.

import { numLexBaseAt, numLexFitsI32, numLexIsFloat } from "./emit_bignum"
import {
  TS_APP,
  TS_ARR,
  TS_FIELD,
  TS_FUNC,
  TS_LITNUM,
  TS_LITSTR,
  TS_MAP,
  TS_NAME,
  TS_NEG,
  TS_NULL,
  TS_OBJ,
  TS_PAREN,
  TS_UNION,
  i32ToStr,
  tsKidCount,
  tsKidStart,
  tsKids,
  tsKind,
  tsLeaf,
  tsMkKids,
  tsText,
} from "./ast"
import {
  closedQuoteEnd,
  demangleSpelling,
  groupInnerOf,
  nameIsBareIdent,
  nameIsQuotedWhole,
} from "./tyname"
import { i32ListHas } from "./listutil"
import { pairMemoClear, pairMemoGet, pairMemoNew, pairMemoPut } from "./memo"
import {
  builtinTyNames,
  demangleName,
  foreignGenericSpell,
  tyEditDist,
  tyFoldedEq,
  tySameInitial,
  tySpellFrom,
  tySpellTo,
  tySuggestBudget,
} from "./check_suggest"

// The primitive vocabulary: a closed set spelled in the source, so every
// `primName == "i32"` is an `i32.eq` against an interned atom and a name outside the set
// is a hard type error rather than a silently false comparison.
export type PrimName = "i32"
  | "i64"
  | "f32"
  | "f64"
  | "boolean"
  | "string"
  | "void"
  | "null"
  | "never"
  // A storage type, not a value type — the one member of this union that may not appear
  // as the type of a local, param, return, binding, map value, union member or generic
  // argument. See `TY_U8`.
  | "u8"
  // The 128-bit SIMD vector, a WasmGC-invisible scalar (wasm `v128`, valtype 0x7b) that
  // flows through locals/params/returns like `i64`. Not spelled in source: it is the
  // substrate the `std:simd` newtypes will brand, reached only via the `__…_v128__`
  // intrinsics. See `TY_V128` and `docs/internals/simd-design.md` §D6.
  | "v128"

// A primitive.
export type TyPrim = { primName: PrimName }

// The error/unknown type — produced on a type failure so checking continues without
// cascading; assignable to and from anything. `errKind` is write-only and exists only
// because `is` discriminates the arena union on field names, so the variant needs one
// field to be distinguishable; an `i32` carries that for no allocation.
export type TyErr = { errKind: i32 }

// A structural object: parallel arrays of field names and their type-arena
// indices. (Constructed by the harness to seed object-typed bindings; the parser
// subset has no object-type literal syntax yet, so it is not built from source.)
export type TyObj = { objFieldNames: string[], objFieldTypes: i32[] }

// A function: parameter type indices and a return type index.
export type TyFunc = { fnParamTypes: i32[], fnRet: i32 }

// A union `A | B | …`: member type-arena indices.
export type TyUnion = { uMembers: i32[] }

// A nullable `T?` / `T | null`: the inner type-arena index.
export type TyNullable = { nInner: i32 }

// A list `T[]`: the element type-arena index (`-1` for an empty `[]` whose element is not
// yet known — assignable to any array, like a hole). `aRead` is 1 for the read-only view
// `readonly T[]`, 0 for the growable list; the two rep identically, since `repCanonId`
// reads the element alone, so a view is the same value and never a copy.
export type TyArray = { aElem: i32, aRead: i32 }

// A string-keyed map `{[K]: V}` or a set over it: key and value type-arena indices (`-1`
// for the holes of a bare `Map()`/`Set()`, pinned by the binding annotation or the first
// `.set`/`.add`). `mSet` is 1 for the set flavor, which is internally a boolean-valued map
// but exposes only `.add`/`.has`/`.delete`/`.length`/`.values()`.
export type TyMap = { mKey: i32, mVal: i32, mSet: i32 }

// A generic type parameter (`T` in `function id<T>(x: T): T`): opaque inside the generic
// body (assignable both ways, like the err hole); at a call site each TyVar param binds to
// its argument's type and the return substitutes through.
export type TyVar = { tvName: string }

// The literal-member vocabulary — a closed set, so every producer is a literal
// `mkLitTy("str"/"int", …)` and a member outside it is a hard type error. There is no float
// literal type: `floatLitTypeMsg` refuses one where it is written.
export type LitKind = "str" | "int"

// A literal type (`"a"`, `0`), interned by `mkLitTy`. `litText` is the raw text between the
// quotes for "str", the canonical integer lexeme for "int". `litWide` marks the form a `const`
// infers, widened to its base where it is stored somewhere reassignable (`litRegularTy`).
export type TyLit = { litKind: LitKind, litText: string, litWide: boolean }

// A negation `!T` — "anything but `T`". Almost always consumed by `intersectTy`
// (`A & !B` subtracts); a residual standalone negation accepts any source not assignable
// to its inner type.
export type TyNeg = { negTy: i32 }

// The unified type. Declared after its members (a union alias can't forward-
// reference). Discriminated with `is`, exactly like the AST `Node`.
export type Ty = TyPrim |
  TyErr |
  TyObj |
  TyFunc |
  TyUnion |
  TyNullable |
  TyArray |
  TyMap |
  TyVar |
  TyLit |
  TyNeg

// A type diagnostic: a message, the node it is raised at, 1-based `tline` (0 = no position)
// and 0-based `tcol` for the start, and `tendTok` — the TOKEN the span ends at, so
// `diagEndLine` and `diagEndCol` read one token and cannot disagree; `-1` for no end.
// `tcode` is the stable category code, `""` for a soundness verdict; `tdata` the payload.
export type TDiag = {
  tmsg: string,
  tat: i32,
  tline: i32,
  tcol: i32,
  tendTok: i32,
  tcode: string,
  tdata: string,
}

// `tys` is the type arena; `frames` the scope chain, each frame its first entry in
// `check_scopes.vl`'s binding log (index 0 the module frame); `diags`
// the accumulated diagnostics; `curRet` the enclosing function's return type while its
// body is checked, `-1` outside any function.
export type Checker = {
  tys: Ty[],
  frames: i32[],
  diags: TDiag[],
  curRet: i32,
}

// The single checker instance. The harness calls `initChecker()` then the entry
// point `checkProgram(root)` and reads `T.diags`.
export let T: Checker = { tys: [], frames: [], diags: [], curRet: -1 }

// The type arena row at `ix`; one body holds the bounds check that an inline `T.tys[ix]`
// repeats at every read site.
export function tyAt(ix: i32): Ty { T.tys[ix] }

// `cUserTypes` — declared struct/union types, `name → type-arena index`, built in a
// pre-pass over the program's `type` declarations so a struct name in an annotation or in
// a later struct's field resolves. A module global rather than a `Checker` field because
// the emitter handles a bare-map global but not a bare-map struct field. `initChecker` resets it.
export let cUserTypes: {[string]: i32} = Map()

// Whether this check offered a near name from the program's own declarations, for a module
// check that leaves some declarations out. `initChecker` resets it.
export let nearNamesRead = false
export function nearNamesNote(): void { nearNamesRead = true }

// `tyMutEpoch` advances on every in-place mutation of an existing `T.tys` entry — any
// event that can change a type's canonical structural key (`repCanonKey`, `emit_rep.vl`),
// whose memos are stamped with it. A bump is always safe and a missed one is a soundness
// bug; minting a new index needs none. `cUserTypesVer` does the same for `cUserTypes` writes.
export let tyMutEpoch = 0

export let cUserTypesVer = 0

// The declaration node of each type-parameter row of a generic nested in another function.
// Bindings are by name, so a substitution binds a nested row only at that generic's own calls
// (`substTyDeep`, D3853).
export let tvNestOf: {[i32]: i32} = Map()

// Depth guard for `tyToStr` on recursive named types: a cyclic arena shape would otherwise
// render forever, so past a fixed depth a type already being rendered prints `…`. An acyclic
// type renders whole to a far deeper cap, since a render is a table key (D2751).
export let tyToStrDepth = 0

export let tyToStrStack: i32[] = []

// The nodes a render may still spend past the shallow depth.
let tyToStrBudget = 4096

// The top-level atom width of the render the last `tyToStrAt` returned, produced by the renderer
// rather than re-derived by scanning the finished string: a render gains a top-level `|` at
// exactly two places, the union arm's join and the nullable arm's ` | null` suffix. It exists so
// this renderer can reach `arrElemRender`, the shared array-grouping home, which needs the width.
let tyStrAtoms = 1

// Does `ty` reach an unresolved empty-collection hole through struct fields, arrays, maps or
// nullable wrappers — the deep analogue of `unresolvedHole`. It gates `recordRepTyAdopt`: an
// object/array literal carrying such a hole is plainly `assignable` to a concrete destination,
// so the short-circuit would skip the adoption block that records the destination rep.
export function tyReachesEmptyHole(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyArray => {
      if t.aElem < 0 { return true }
      tyReachesEmptyHole(t.aElem, depth - 1)
    }
    TyMap => {
      if t.mKey < 0 || t.mVal < 0 { return true }
      tyReachesEmptyHole(t.mVal, depth - 1)
    }
    TyObj => {
      let i = 0
      while i < t.objFieldTypes.length {
        if tyReachesEmptyHole(t.objFieldTypes[i], depth - 1) { return true }
        i = i + 1
      }
      false
    }
    TyNullable => tyReachesEmptyHole(t.nInner, depth - 1)
    // A union is not descended: the adoption it gates re-stamps a field, never a member.
    TyPrim | TyFunc | TyUnion | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// True when `ty` contains a `TyUnion` reachable through struct fields, array elements, map
// values or nullable inners. Gates `recordRepTyAdopt` for the union-softening case: an ObjLit
// field value narrower than a destination union field softens the recorded rep, so a
// same-fieldset twin resolves wrong; re-stamping the rep to the destination corrects it.
export function tyReachesUnion(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyUnion => true
    TyArray => tyReachesUnion(t.aElem, depth - 1)
    TyMap => tyReachesUnion(t.mVal, depth - 1)
    TyNullable => tyReachesUnion(t.nInner, depth - 1)
    TyObj => {
      let i = 0
      while i < t.objFieldTypes.length {
        if tyReachesUnion(t.objFieldTypes[i], depth - 1) { return true }
        i = i + 1
      }
      false
    }
    // No union is reachable through any of these.
    TyPrim | TyFunc | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// The shapes `constrainEmptyD` descends — a destination witness worth banking for the
// deferred inferred-return pin. A scalar witness would occupy the slot and pin nothing.
export function tyPinsEmptyHoles(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = tyAt(ty)
  if t is TyNullable { return tyPinsEmptyHoles(t.nInner, depth - 1) }
  t is TyArray || t is TyMap || t is TyObj
}

// Well-known primitive type-arena indices, pinned by `initChecker` so the hot
// primitives are interned once (not re-pushed per use). `-1` until initialized.
export let TY_I32 = -1

export let TY_I64 = -1

export let TY_F64 = -1

export let TY_F32 = -1

export let TY_BOOL = -1

export let TY_STR = -1

export let TY_VOID = -1

export let TY_ERR = -1

export let TY_NULL = -1

// `never` — the empty type: what an intersection of disjoint concrete types folds to. The bottom
// type, assignable to anything, with nothing but itself and err assignable to it.
export let TY_NEVER = -1

// `u8` — a storage type. Wasm has no 8-bit value type, but WasmGC has packed storage types and
// VL mirrors that: a `u8` value would be an i32 with nothing enforcing 0..255, while a `u8` slot
// is backed by one byte, so the store truncates and every read yields 0..255. Legal only as an
// array element, so `primTyOfName` declines it and `tyVarMayBind` refuses it as a `T` binding.
export let TY_U8 = -1

// `v128` — the 128-bit SIMD vector scalar. WasmGC-invisible like `i64`; the emitter lowers
// it to the wasm `v128` valtype (0x7b) in every position a scalar flows through. Never
// spelled in source — the `__…_v128__` intrinsics produce and consume it (`simd-design.md` §G).
export let TY_V128 = -1

// Whether `ty` is a record type.
export function tyIsRecord(ty: i32): boolean {
  ty >= 0 && ty < T.tys.length && tyAt(ty) is TyObj
}

// Whether `ty` is the primitive `i64` or `f64`.
export function tyIsWidePrim(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyPrim { return t.primName == "i64" || t.primName == "f64" }
  false
}

// A literal union whose values rep as an i32, so the integer mix hashes them: a string one as
// the interned atom, a numeric one as its base, and only where that base is i32 (D1748).
export function tyLitUnionHashesI32(k: i32): boolean {
  if tyIsLitUnion(k) { return true }
  numLitUnionBaseTy(k) == TY_I32
}

// Renames type variable row `ix` in place, keeping its owner; a no-op on any other row. The
// emitter's way to tell apart two declared parameters one name spells.
export function tyVarRenameRow(ix: i32, name: string) {
  if ix < 0 || ix >= T.tys.length || !(tyAt(ix) is TyVar) { return 0 }
  const t: Ty = { tvName: name }
  T.tys[ix] = t
  tyVarRenames = tyVarRenames + 1
  0
}

// How many `tyVarRenameRow` rewrites have run: an in-place arena write `tyMutEpoch` does not count.
export let tyVarRenames = 0

// Nominal-identity sidecar: the `Ty`-arena indices of declared struct types (`cStructTyIxs`) and
// of union-variant member types (`cVariantMemberTyIxs`). `nodeTyIsStruct` reads them as "its
// recorded type is a declared struct and not a variant member". The arena stays purely
// structural — `TyObj` has no name — so nominal-ness is checker metadata, not a `Ty`.
export let cStructTyIxs: i32[] = []

export let cStructTyIxSet: boolean[] = []

// The declared name of each `cStructTyIxs` entry, so a declared-struct arena index resolves back
// to its alias name, as `cUnionTyIxs`/`cUnionNames` already do for unions. The name-faithful
// renderer (`tyToNominalName`) uses it to render a nominal struct as its name rather than a
// structural expansion, so an arena walk reproduces the name walk's registration keys.
export let cStructNames: string[] = []

// The first `cStructTyIxs` position of each arena index, indexed by it (-1 for none), so
// `structNameOfTy` answers without a scan. `cStructPush` keeps the three in step.
export let cStructFirstPos: i32[] = []

// Records declared struct `ix` named `name` in the struct sidecar.
export function cStructPush(ix: i32, name: string) {
  cStructTyIxs.push(ix)
  cStructNames.push(name)
  if ix >= 0 {
    while cStructTyIxSet.length <= ix { cStructTyIxSet.push(false) }
    cStructTyIxSet[ix] = true
    while cStructFirstPos.length <= ix { cStructFirstPos.push(-1) }
    if cStructFirstPos[ix] < 0 { cStructFirstPos[ix] = cStructTyIxs.length - 1 }
  }
  0
}

export let cVariantMemberTyIxs: i32[] = []

export let cVariantMemberTyIxSet: boolean[] = []

// Declared union-alias `Ty` indices (`type T = A | B`), for the emitter's union registry.
export let cUnionTyIxs: i32[] = []

export let cUnionTyIxSet: boolean[] = []

// The declared name of each `cUnionTyIxs` entry, so a union type index resolves back to its alias
// name, which pins an anonymous lambda's litunion return as the alias, an inline litunion
// spelling repping as a string ref.
export let cUnionNames: string[] = []

// Generic-application nominal sidecar, the third reverse map in the `cStructTyIxs`/`cUnionTyIxs`
// family: the arena knows what `Box<i32>` expands to and nothing about an application having been
// written, so the nominal renderer would produce the structural `{value: i32}`. Recorded at
// `applyGenAliasArgs`; the head is a name, the arguments are arena indices the renderer recurses.
export let gaAppTyIxs: i32[] = []

export let gaAppTyIxSet: boolean[] = []

export let gaAppHeads: string[] = []

// The arguments of each `gaAppTyIxs` entry, flattened: entry `i` owns
// `gaAppArgFlat[gaAppArgStart[i] .. + gaAppArgCount[i]]`. Same flat-slice shape as the
// `gaParamNames`/`gaParamStart`/`gaParamCount` triple this file already uses for the
// declaration side.
export let gaAppArgStart: i32[] = []

export let gaAppArgCount: i32[] = []

export let gaAppArgFlat: i32[] = []

// Per-row finiteness memo for the reader's cycle guard: -1 unknown, 0 the expansion is cyclic
// (decline, see `tyReachesSelf`), 1 finite.
export let gaAppFinite: i32[] = []

// Nominal newtype sidecar, the fourth member of the `cStructTyIxs`/`cUnionTyIxs`/`gaAppTyIxs`
// family, built to the same rule: the arena stays structural and nominal-ness is a column beside
// it. A brand is a name and that is the whole representation — a branded index is a second index
// over the same `Ty` payload, so only `assignable`/`tyEq` and the operator rule consult the column.
export let nwDeclNames: string[] = []

export let nwTyIxs: i32[] = []

export let nwNames: string[] = []

export let nwBaseTyIxs: i32[] = []

// Whether `m` is `cap` or one of its members.
export function tyMemberWithin(m: i32, cap: i32): boolean {
  if m < 0 || cap < 0 { return false }
  if tySame(m, cap) { return true }
  let c = cap
  const ct = tyAt(cap)
  if ct is TyNullable {
    if ct.nInner < 0 { return false }
    if tySame(m, ct.nInner) { return true }
    c = ct.nInner
  }
  if c < 0 { return false }
  const cu = tyAt(c)
  if cu is TyUnion {
    let i = 0
    while i < cu.uMembers.length {
      if tySame(m, cu.uMembers[i]) { return true }
      i = i + 1
    }
  }
  false
}

// The base scalar a literal type softens to: a string literal to `string`, an integer to its
// magnitude-defaulted integer type. An integer literal past the i32 range softens
// to i64, so the literal-aware assignability path never sneaks an out-of-range literal into an
// i32 slot.
export function litBaseTy(t: TyLit) {
  if t.litKind == "str" { return TY_STR }
  if numLexFitsI32(t.litText) { return TY_I32 }
  TY_I64
}

// The emit name of that base scalar — `litBaseTy` rendered. One home for the four-way rule, so no
// renderer's `TyLit` arm re-derives `str`/`flt` from the characters. The prim test is total by
// `litBaseTy`'s own arms: every one of them returns a `TyPrim`.
function tyLitBasePrim(t: TyLit): PrimName | null {
  const bt = tyAt(litBaseTy(t))
  if bt is TyPrim { return bt.primName }
  null
}

// The same answer as text, for the renderers that spell it. Declaring the return `string` is what
// widens the atom into a materialized string, so the atom form above is the one every deciding
// caller should ask.
function tyLitBaseName(t: TyLit) { primNameStr(tyLitBasePrim(t)) }

// Soften a literal or all-literal union operand to its base scalar: a numeric-literal union is its
// base type for arithmetic and ordering, the union constraining what may be assigned rather than
// what may be computed. A mixed union — different bases, or any non-literal member — is left alone.
export function softenLitTy(ty: i32) {
  if ty < 0 { return ty }
  const t = tyAt(ty)
  match t {
    TyLit => litBaseTy(t)
    TyUnion => {
      const members = t.uMembers
      let base = -1
      let i = 0
      while i < members.length {
        const m = members[i]
        if m < 0 { return ty }
        const mt = tyAt(m)
        if mt is TyLit {
          const b = litBaseTy(mt)
          if base < 0 { base = b }
          else if base != b { return ty }
        } else {
          return ty
        }
        i = i + 1
      }
      if base >= 0 { return base }
      ty
    }
    // Nothing else carries a literal to soften.
    TyPrim | TyFunc | TyObj | TyNullable | TyArray | TyMap | TyNeg | TyVar | TyErr => ty
  }
}

// A number, `boolean` or `string`: a type with one rep under any inference.
export function tyIsPlainScalar(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyPrim {
    match t.primName {
      "i32" | "i64" | "f32" | "f64" | "boolean" | "string" => {
        return true
      }
      "void" | "null" | "never" | "u8" | "v128" => {
        return false
      }
    }
  }
  false
}

// Whether `ty` is or holds, through lists, a union, a nullable or a function: a value whose rep
// depends on the destination it is built for. Unknown below `depth`.
export function tyRepVaries(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return true }
  const t = tyAt(ty)
  match t {
    TyUnion | TyNullable | TyFunc => true
    TyArray => tyRepVaries(t.aElem, depth - 1)
    TyPrim | TyErr | TyObj | TyMap | TyVar | TyLit | TyNeg => false
  }
}

// The primitive name as text, for the few consumers that spell it into a string rather than decide
// on it — a rep key builder, and the `as`-target spelling the canon pass writes back onto the node.
// Absence renders empty, which is what those sites read.
export function primNameStr(p: PrimName | null): string {
  if p == null { return "" }
  p
}

// Whether `t` is a declared type parameter, not an inference hole.
export function tyIsDeclaredParam(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const tt = tyAt(t)
  if tt is TyVar { return tt.tvName.length > 0 && tt.tvName[0] != "?"[0] }
  false
}

// Whether `t` is a primitive type, which no union box is.
export function tyIsPrimIx(t: i32): boolean {
  t >= 0 && t < T.tys.length && tyAt(t) is TyPrim
}

// Whether `ty` is a union whose every member is a list.
export function tyUnionAllLists(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const m = t.uMembers[i]
      if m < 0 || m >= T.tys.length { return false }
      if !(tyAt(m) is TyArray) { return false }
      i = i + 1
    }
    return t.uMembers.length >= 2
  }
  false
}

// Whether the declared type parameter `an` and the type `b` are two differently named ones.
export function tyParamNamesPart(an: string, b: i32): boolean {
  const tb = tyAt(b)
  if tb is TyVar {
    if an.length == 0 || tb.tvName.length == 0 { return false }
    if an[0] == "?"[0] || tb.tvName[0] == "?"[0] { return false }
    return an != tb.tvName
  }
  false
}

// Whether `ty` is a record, or a union or nullable with a record member.
export function tyHoldsRecord(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth > 8 { return false }
  const t = tyAt(ty)
  match t {
    TyObj => {
      return true
    }
    TyNullable => {
      return tyHoldsRecord(t.nInner, depth + 1)
    }
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        if tyHoldsRecord(t.uMembers[i], depth + 1) { return true }
        i = i + 1
      }
      return false
    }
    TyPrim | TyErr | TyFunc | TyArray | TyVar | TyLit | TyNeg | TyMap => {
      // A list or map of records is its own rep, not a record in the field itself.
      return false
    }
  }
}

// Whether a value of type `ty` can hold a function, `depth` levels into it.
export function tyMayHoldFn(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth > 8 { return false }
  const t = tyAt(ty)
  match t {
    TyFunc => {
      return true
    }
    TyArray => {
      return tyMayHoldFn(t.aElem, depth + 1)
    }
    TyNullable => {
      return tyMayHoldFn(t.nInner, depth + 1)
    }
    TyMap => {
      return tyMayHoldFn(t.mVal, depth + 1)
    }
    TyObj => {
      for ft in t.objFieldTypes {
        if tyMayHoldFn(ft, depth + 1) { return true }
      }
      return false
    }
    TyUnion => {
      for m in t.uMembers {
        if tyMayHoldFn(m, depth + 1) { return true }
      }
      return false
    }
    TyPrim | TyErr | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// True when the type at `ti` carries a bare-`null` hole in a struct-field or array-element position
// (`{f: null}`, `{f: {f: null}}`, `null[]` inside a field): such a render is a literal's own
// structural inference, never a spellable annotation, so no registered shape row can match it and a
// name-keyed consumer mis-keys. Walks `TyObj`/`TyArray` only; depth-capped against recursive types.
export function tyHasNullHole(ti: i32, depth: i32): boolean {
  if ti < 0 || depth <= 0 { return false }
  const t = tyAt(ti)
  match t {
    TyPrim => t.primName == "null"
    TyObj => {
      const fts = t.objFieldTypes
      let i = 0
      while i < fts.length {
        if tyHasNullHole(fts[i], depth - 1) { return true }
        i = i + 1
      }
      false
    }
    TyArray => tyHasNullHole(t.aElem, depth - 1)
    // Not walked: a `null` under one of these is spellable, or not a literal's own inference.
    TyFunc | TyUnion | TyNullable | TyMap | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// True when the type structure reachable from `ti` nests deeper than `budget` levels of
// obj/array/nullable/union wrappers — in particular a recursive type (`type L = {n: L | null}`)
// exceeds every finite budget. `recordNullHoleObjAdopt` skips such destinations: a recursive
// re-stamp would send `tyToEmitName`, which has no back-edge vocabulary, into unbounded recursion.
export function tyDeeperThan(ti: i32, budget: i32): boolean {
  if ti < 0 { return false }
  if budget <= 0 { return true }
  tyWrapHeight(ti) >= budget
}

// The wrapper height `tyDeeperThan` compares, memoised per arena index and stamped with
// `tyMutEpoch`, so a sub-type a diamond shares is walked once (D9930); a cycle is unbounded.
const TD_UNBOUNDED = 1073741824
const TD_BUSY = -2
const tdHeight: i32[] = []
const tdStamp: i32[] = []

function tyWrapHeight(ti: i32): i32 {
  while tdHeight.length <= ti {
    tdHeight.push(0)
    tdStamp.push(-1)
  }
  if tdStamp[ti] == tyMutEpoch {
    if tdHeight[ti] == TD_BUSY { return TD_UNBOUNDED }
    return tdHeight[ti]
  }
  const ep = tyMutEpoch
  tdStamp[ti] = ep
  tdHeight[ti] = TD_BUSY
  let h = 0
  const t = tyAt(ti)
  match t {
    TyObj => {
      const fts = t.objFieldTypes
      let i = 0
      while i < fts.length {
        h = tyWrapStep(h, fts[i])
        i = i + 1
      }
    }
    TyArray => {
      h = tyWrapStep(h, t.aElem)
    }
    TyNullable => {
      h = tyWrapStep(h, t.nInner)
    }
    TyUnion => {
      const ms = t.uMembers
      let i = 0
      while i < ms.length {
        h = tyWrapStep(h, ms[i])
        i = i + 1
      }
    }
    // Leaves, and wrappers the re-stamp does not descend.
    TyPrim | TyFunc | TyMap | TyNeg | TyVar | TyLit | TyErr => {}
  }
  tdStamp[ti] = ep
  tdHeight[ti] = h
  h
}

// `h` raised to one more than child `c`'s height; a hole (`c < 0`) adds nothing.
function tyWrapStep(h: i32, c: i32): i32 {
  if c < 0 { return h }
  const ch = tyWrapHeight(c)
  if ch >= TD_UNBOUNDED { return TD_UNBOUNDED }
  if ch + 1 > h { return ch + 1 }
  h
}

// D-ARRGROUP — the one home of the array-element grouping rule, shared by all three renderers.
// The element is wrapped in grouping parens before the `[]` exactly when the suffix would
// otherwise re-bind: a function element, where the trailing `[]` binds into the closure's result,
// or a union element, parenthesized so its `|`s stop being top-level. The width is the producer's.
function arrElemRender(el: string, elTy: i32, elAtoms: i32): string {
  if tyIxIsFunc(elTy) { return "(" + el + ")[]" }
  if elAtoms > 1 { return "(" + el + ")[]" }
  el + "[]"
}

// Is arena index `ix` a `readonly T[]` view? Total in `ix`, like `tyIxIsFunc`.
export function tyIxIsView(ix: i32): boolean {
  if ix < 0 || ix >= T.tys.length { return false }
  const t = tyAt(ix)
  if t is TyArray { return t.aRead == 1 }
  false
}

// Is arena index `ix` a function type? Total in `ix`, and that is the whole reason it exists: `-1`
// is the declared hole an empty `[]` element or an unresolved lambda result carries, and
// `T.tys[-1]` is an out-of-bounds `array.get` that traps the compiler. The display renderer must
// render every type it is handed, holes included, so it reaches the test with `-1` in hand.
export function tyIxIsFunc(ix: i32): boolean {
  if ix < 0 || ix >= T.tys.length { return false }
  const t = tyAt(ix)
  if t is TyFunc { return true }
  false
}

// The suggestion for unresolved spelling `name`, or "" for none: first `tySpellFrom`/
// `tySpellTo`, then edit distance over `builtinTyNames` and declared types, built-ins
// first so ties keep the earlier candidate. Offered under `demangleName`'s source
// spelling; a composite key is never offered.
function tySuggestFor(name: string) {
  if name.length < 2 { return "" }
  if !nameIsBareIdent(name) { return "" }
  let si = 0
  while si < tySpellFrom.length {
    if tyFoldedEq(name, tySpellFrom[si]) { return tySpellTo[si] }
    si = si + 1
  }
  const budget = tySuggestBudget(name.length)
  let best = ""
  let bestD = budget + 1
  let bi = 0
  while bi < builtinTyNames.length {
    const bn = builtinTyNames[bi]
    const bd = tyEditDist(name, bn)
    // A capitalised name is a user type's; a builtin is near it only from the same letter
    // (`Strng` → `string`), never across one (`Level` is not a typo of `never`).
    if (
      bd < bestD
      && (!(name[0] >= 'A' && name[0] <= 'Z') || tySameInitial(name, bn))
    ) {
      bestD = bd
      best = bn
    }
    bi = bi + 1
  }
  nearNamesNote()
  for k in cUserTypes.keys() {
    const un = demangleName(k)
    if un.length >= 2 && un != name && nameIsBareIdent(un) {
      const ud = tyEditDist(name, un)
      if ud < bestD {
        bestD = ud
        best = un
      }
    }
  }
  best
}

// The `; did you mean '<name>'?` clause, or "" when nothing is near enough. A suffix by
// construction, so a consumer matching the `unknown type '<name>'` prefix keeps matching;
// callers with a clause of their own route through `unknownTyTextIn` instead of
// concatenating after this.
export function tyDidYouMean(name: string) {
  const g = foreignGenericSpell(name)
  if g.length > 0 { return g }
  const s = tySuggestFor(name)
  if s.length == 0 { return "" }
  "; did you mean '" + s + "'?"
}

// —— type → string (for diagnostics) ——
// Renders a type-arena index as a readable name. The `nominal` bit: true renders a
// declared type by its name (`Cat`, `Box<i32>`); false is the structural spelling the
// emitter's name-keyed tables need — both spell composites as VL source does (`=>`, `T | null`).
export function tyToStr(ix: i32) { tyToStrAt(ix, true) }

// The structural render — `tyToStr`'s recursion with the nominal legs off. Read by the
// checker's emitter-facing name producers, whose result is a key into an emitter table
// keyed by structural spelling (`structIndexOfTypeName` matches a `{…}` shape by field
// set) — a nominal name there is a key those tables do not hold.
export function tyToStructStr(ix: i32) { tyToStrAt(ix, false) }

function tyToStrAt(ix: i32, nominal: boolean) {
  // Both bail-outs return single tokens — one atom, like every arm that writes no
  // top-level `|`.
  tyStrAtoms = 1
  // No arena entry (`ix < 0`) — an empty `[]`/`Map()`/`Set()` nothing constrained — renders
  // `_`, the same token the `TyVar` hole arm uses: both mean "no type is known here".
  // Angle brackets are reserved for an error that already happened (`<error>` for `TyErr`);
  // collapsing the two would send a reader with a rejected annotation to hunt a missing one.
  if ix < 0 { return "_" }
  if tyToStrDepth <= 8 {
    if tyToStrDepth == 0 { tyToStrBudget = 4096 }
    tyToStrDepth = tyToStrDepth + 1
    const s0 = tyToStrGo(ix, nominal)
    tyToStrDepth = tyToStrDepth - 1
    return s0
  }
  // A cycle entered past the shallow depth meets one of its own types again there, and a
  // shared subtree (a diamond) is bounded by a node budget per render.
  if tyToStrDepth > 64 || tyToStrBudget <= 0 || i32ListHas(tyToStrStack, ix) {
    return "…"
  }
  tyToStrBudget = tyToStrBudget - 1
  tyToStrDepth = tyToStrDepth + 1
  tyToStrStack.push(ix)
  const s = tyToStrGo(ix, nominal)
  tyToStrStack.pop()
  tyToStrDepth = tyToStrDepth - 1
  s
}

function tyToStrGo(ix: i32, nominal: boolean) {
  const nn = tyToStrNameOf(ix, nominal)
  if nn != "" { return nn }
  const t = tyAt(ix)
  // Exhaustive over `Ty`, deliberately without a `_` arm: a new variant breaks the
  // self-compile here instead of silently printing `<?>` in a diagnostic.
  match t {
    TyPrim => {
      return t.primName
    }
    TyErr => {
      return "<error>"
    }
    TyObj => {
      return tyToStrObj(t, nominal)
    }
    TyFunc => {
      return tyToStrFunc(t, nominal)
    }
    TyUnion => {
      return tyToStrUnion(t, nominal)
    }
    TyNullable => {
      return tyToStrNullable(t, nominal)
    }
    TyArray => {
      return tyToStrArray(t, nominal)
    }
    TyMap => {
      return tyToStrMap(t, nominal)
    }
    TyVar => {
      // An inference hole (`?fn.N`) renders as the blank `_` — deliberately not an
      // identifier-shaped word, since a bareword spelling reads as a type name to write. `_`
      // must never join the LSP's absence filter (`ABSENT_TYPE_MARKERS`): as a substring of
      // ordinary identifiers it would delete hints from healthy code (`{foo_bar: i32}`).
      if t.tvName[0] == '?' { return "_" }
      return t.tvName
    }
    TyLit => {
      // A literal type renders as its member text — quoted for a string literal
      // (host `stringifyType`: `expected "a" | "b", got "c"`).
      if t.litKind == "str" { return "\"" + t.litText + "\"" }
      return t.litText
    }
    TyNeg => {
      const ns = tyToStrAt(t.negTy, nominal)
      // A residual negation has no source spelling at all, so its width is nominal — one
      // atom, like every other non-`|`-writing arm.
      tyStrAtoms = 1
      return "!" + ns
    }
  }
}

// The name type `ix` renders as before any structural render: a newtype's name always, and
// under `nominal` a declared struct, generic application or union alias. "" when none applies.
function tyToStrNameOf(ix: i32, nominal: boolean): string {
  // A nominal newtype renders as its name — the only renderer that must, since "cannot
  // assign i32 to i32" for `const e: EntityId = n` hides the very distinction the type
  // exists to draw. The emit renderers (`tyToEmitName`, `canonEmitName`) deliberately lack
  // this arm: a newtype must be erased in the emitter's vocabulary (`newtype-design.md` §3).
  const nwn = nomNameOfTy(ix)
  if nwn != "" { return nwn }
  // Nominal-first, in the same order `tyToNameGo`/`transparentMemberEmitName` use:
  // declared struct, generic application, declared union alias — application before union,
  // since an application expands to the `TyObj`/`TyUnion` this exists to replace. Each leg
  // declines with "" for a type it cannot name, so an unnamed type still renders structurally.
  if nominal {
    const sdn = structNameOfTy(ix)
    if sdn != "" { return sdn }
    const gan = genAppNameOfTy(ix)
    if gan != "" { return gan }
    const udn = unionAliasDeclNameOfTy(ix)
    if udn != "" { return udn }
  }
  ""
}

// A record type's render, `{a: A, b: B}`, one atom.
function tyToStrObj(t: TyObj, nominal: boolean): string {
  // `.length`/index chained directly on an array field of an `is`-narrowed value
  // miscompiles, so the array fields are bound to locals first.
  const names = t.objFieldNames
  const ftys = t.objFieldTypes
  let s = "{"
  let i = 0
  while i < names.length {
    if i > 0 { s = s + ", " }
    s = s + names[i] + ": " + tyToStrAt(ftys[i], nominal)
    i = i + 1
  }
  // Every field separator sits inside the braces — one atom. Set explicitly rather
  // than inherited, since a field's own render leaves its last width behind.
  tyStrAtoms = 1
  s + "}"
}

// A function type's render, `(params) => ret`, one atom; a function result keeps its parens.
function tyToStrFunc(t: TyFunc, nominal: boolean): string {
  const ptys = t.fnParamTypes
  let s = "("
  let i = 0
  while i < ptys.length {
    if i > 0 { s = s + ", " }
    s = s + tyToStrAt(ptys[i], nominal)
    i = i + 1
  }
  let rs = tyToStrAt(t.fnRet, nominal)
  // A function type is one atom: params are parenthesized and everything after the
  // top-level arrow belongs to the result. Set explicitly, since the param/result
  // renders leave their own widths behind.
  tyStrAtoms = 1
  // VL writes a function type `(params) => ret`. A function result that is itself a
  // function keeps grouping parens — the same rule `arrElemRender` carries for array
  // elements.
  if tyIxIsFunc(t.fnRet) { rs = "(" + rs + ")" }
  s + ") => " + rs
}

// A union's render, its members joined by ` | `, with `tyStrAtoms` set to their summed width.
function tyToStrUnion(t: TyUnion, nominal: boolean): string {
  const members = t.uMembers
  let s = ""
  // The render's atom count, accumulated as members join: a member is not always one
  // atom (a nullable member renders `X | null`), so this is summed rather than read
  // off `members.length`.
  let psum = 0
  let i = 0
  while i < members.length {
    if i > 0 { s = s + " | " }
    let ms = tyToStrAt(members[i], nominal)
    let mw = tyStrAtoms
    // A function-type member renders parenthesized (`((i32) => f64) | string`) —
    // bare, the closure's result would swallow the union's sibling members
    // (`(i32) => f64 | string` returns `f64 | string`, a different type).
    if tyIxIsFunc(members[i]) {
      ms = "(" + ms + ")"
      mw = 1
    }
    s = s + ms
    psum = psum + mw
    i = i + 1
  }
  tyStrAtoms = psum
  s
}

// A nullable's render, `T | null`, one atom wider than its inner's.
function tyToStrNullable(t: TyNullable, nominal: boolean): string {
  const inner = tyToStrAt(t.nInner, nominal)
  const innerAtoms = tyStrAtoms
  // VL has no `T?` suffix — a nullable is written `T | null`. A nullable function
  // type keeps grouping parens (`((i32) => string) | null`), else ` | null` binds
  // into the closure's result and spells a different type.
  if tyIxIsFunc(t.nInner) {
    // The grouped closure is one atom; `null` is the second.
    tyStrAtoms = 2
    return "(" + inner + ") | null"
  }
  // A union inner keeps its own top-level `|`s (`A | B | null`), so the `null` arm
  // adds to the inner render's width rather than making the whole render two atoms.
  tyStrAtoms = innerAtoms + 1
  inner + " | null"
}

// A list's render, `T[]` or `readonly T[]`, one atom; a wide or view element is grouped.
function tyToStrArray(t: TyArray, nominal: boolean): string {
  const el = tyToStrAt(t.aElem, nominal)
  const elw = tyStrAtoms
  // A list render is one atom in every form — a wide element is parenthesized so its
  // `|`s stop being top-level. Set explicitly, since the element render left its own width behind.
  tyStrAtoms = 1
  // A view element is grouped: `readonly T[][]` spells a view of `T[][]` (D2195).
  let row = arrElemRender(el, t.aElem, elw)
  if tyIxIsView(t.aElem) { row = "(" + el + ")[]" }
  if t.aRead == 1 { return "readonly " + row }
  row
}

// A map's render, `{[K]: V}`, or under `nominal` a set's `Set<K>`; one atom.
function tyToStrMap(t: TyMap, nominal: boolean): string {
  const mk = tyToStrAt(t.mKey, nominal)
  // A set is its own type and reads as one; the structural render keeps the index
  // signature the emitter's name tables are keyed by.
  if t.mSet == 1 && nominal {
    tyStrAtoms = 1
    return "Set<" + mk + ">"
  }
  const mv = tyToStrAt(t.mVal, nominal)
  // The key/value separators sit inside the braces — one atom.
  tyStrAtoms = 1
  "{[" + mk + "]: " + mv + "}"
}

// The spelling tree of `tyToStr(ix)`: the tree `parseType` builds from that render, built from
// the type rather than by parsing the string, so a synthesized annotation carries what a written
// one would. -1 when the render is no annotation: an error, a cycle, a map keyed by no name.
export function tyToTs(ix: i32): i32 {
  tyTsBudget = 4096
  tyTsGo(ix, 0)
}

// The nodes `tyToTs` may still build, so a shared subtree cannot blow the render up.
let tyTsBudget = 4096

function tyTsGo(ix: i32, depth: i32): i32 {
  if ix < 0 { return tsLeaf(TS_NAME, "_") }
  if depth > 64 || tyTsBudget <= 0 { return -1 }
  tyTsBudget = tyTsBudget - 1
  const nn = tyTsNameOf(ix, depth)
  if nn != -2 { return nn }
  const t = tyAt(ix)
  match t {
    TyPrim => {
      if t.primName == "null" { return tsLeaf(TS_NULL, "null") }
      return tsLeaf(TS_NAME, t.primName)
    }
    TyErr => {
      return -1
    }
    TyObj => {
      return tyTsObj(t, depth)
    }
    TyFunc => {
      const kids: i32[] = []
      for p in t.fnParamTypes {
        const pk = tyTsGo(p, depth + 1)
        if pk < 0 { return -1 }
        kids.push(pk)
      }
      const r = tyTsGroupFn(t.fnRet, tyTsGo(t.fnRet, depth + 1))
      if r < 0 { return -1 }
      kids.push(r)
      return tsMkKids(TS_FUNC, "", kids)
    }
    TyUnion => {
      const kids: i32[] = []
      for m in t.uMembers {
        const mk = tyTsGroupFn(m, tyTsGo(m, depth + 1))
        if mk < 0 { return -1 }
        tyTsJoin(kids, mk)
      }
      if kids.length == 1 { return kids[0] }
      return tsMkKids(TS_UNION, "", kids)
    }
    TyNullable => {
      const kids: i32[] = []
      const ik = tyTsGroupFn(t.nInner, tyTsGo(t.nInner, depth + 1))
      if ik < 0 { return -1 }
      tyTsJoin(kids, ik)
      kids.push(tsLeaf(TS_NULL, "null"))
      return tsMkKids(TS_UNION, "", kids)
    }
    TyArray => {
      return tyTsArray(t, depth)
    }
    TyMap => {
      const k = tyTsGo(t.mKey, depth + 1)
      if k < 0 { return -1 }
      if t.mSet == 1 { return tsMkKids(TS_APP, "Set", [k]) }
      if tsKind[k] != TS_NAME { return -1 }
      const v = tyTsGo(t.mVal, depth + 1)
      if v < 0 { return -1 }
      return tsMkKids(TS_MAP, tsText[k], [v])
    }
    TyVar => {
      if t.tvName[0] == '?' { return tsLeaf(TS_NAME, "_") }
      return tsLeaf(TS_NAME, t.tvName)
    }
    TyLit => {
      if t.litKind == "str" {
        return tsLeaf(TS_LITSTR, "\"" + t.litText + "\"")
      }
      return tsLeaf(TS_LITNUM, t.litText)
    }
    TyNeg => {
      const n = tyTsGo(t.negTy, depth + 1)
      if n < 0 { return -1 }
      return tsMkKids(TS_NEG, "", [n])
    }
  }
}

// `tyToStrNameOf`'s tree: a name leaf, or a generic application over its arguments' trees; -2
// when `ix` renders structurally, -1 when an argument has no tree.
function tyTsNameOf(ix: i32, depth: i32): i32 {
  const nwn = nomNameOfTy(ix)
  if nwn != "" { return tsLeaf(TS_NAME, nwn) }
  const sdn = structNameOfTy(ix)
  if sdn != "" { return tsLeaf(TS_NAME, sdn) }
  if genAppNameOfTy(ix) != "" {
    const row = genAppRowOf(ix)
    if row < 0 || row >= gaAppArgCount.length { return -1 }
    const kids: i32[] = []
    let a = 0
    while a < gaAppArgCount[row] {
      const k = tyTsGo(gaAppArgFlat[gaAppArgStart[row] + a], depth + 1)
      if k < 0 { return -1 }
      kids.push(k)
      a = a + 1
    }
    return tsMkKids(TS_APP, gaAppHeads[row], kids)
  }
  const udn = unionAliasDeclNameOfTy(ix)
  if udn != "" { return tsLeaf(TS_NAME, udn) }
  -2
}

// `tyToStrObj`'s tree: one field node per field; -1 when a field has no tree.
function tyTsObj(t: TyObj, depth: i32): i32 {
  const names = t.objFieldNames
  const ftys = t.objFieldTypes
  const kids: i32[] = []
  let i = 0
  while i < names.length {
    const f = tyTsGo(ftys[i], depth + 1)
    if f < 0 { return -1 }
    kids.push(tsMkKids(TS_FIELD, names[i], [f]))
    i = i + 1
  }
  tsMkKids(TS_OBJ, "", kids)
}

// `tyToStrArray`'s tree: a function, union or view element grouped, a view marked `readonly`.
function tyTsArray(t: TyArray, depth: i32): i32 {
  let el = tyTsGo(t.aElem, depth + 1)
  if el < 0 { return -1 }
  if tyIxIsFunc(t.aElem) || tyIxIsView(t.aElem) || tsKind[el] == TS_UNION {
    el = tsMkKids(TS_PAREN, "", [el])
  }
  const ro = if t.aRead == 1 { "readonly" } else { "" }
  tsMkKids(TS_ARR, ro, [el])
}

// Tree `k` of type `ty`, grouped when `ty` is a function type, which a bare `|` or `[]` after
// it would join; -1 stays -1.
function tyTsGroupFn(ty: i32, k: i32): i32 {
  if k < 0 || !tyIxIsFunc(ty) { return k }
  tsMkKids(TS_PAREN, "", [k])
}

// Append tree `k` to the union member list `kids`, its own members when it is a union.
function tyTsJoin(kids: i32[], k: i32) {
  if tsKind[k] != TS_UNION {
    kids.push(k)
    return 0
  }
  let i = 0
  while i < tsKidCount[k] {
    kids.push(tsKids[tsKidStart[k] + i])
    i = i + 1
  }
  0
}

// Is arena type `ix` a nullable value-union box — a `TyUnion` with a `null` member and two
// or more non-null members? That is the rep whose `??` has no emit lowering: its null is a
// tag in the box's field 0 rather than a `ref.null`, so `br_on_non_null` cannot serve it. A
// one-member nullable (`T | null`) is the niche and keeps its own lowering (D962).
export function tyIsNulValueUnionBox(ix: i32): boolean {
  if ix < 0 { return false }
  const t0 = tyAt(ix)
  // `string | i32 | null` can arrive as a union carrying a `null` member or as a
  // `TyNullable` over the two-member union — the checker normalises some spellings to the
  // second, and peeling here makes the predicate answer about the rep, not the spelling.
  if t0 is TyNullable {
    // A literal union is excluded here: `K | null` is a `TyNullable` over a 2-member
    // `TyUnion` by shape, but its rep is the interned i32 atom with `-1` for null — a
    // niche, not a box. `t0.nInner` can be the unfilled `let x = null` hole (`-1`), so every
    // reader here bound-tests before indexing the arena or the compiler traps (D1575).
    if t0.nInner < 0 || t0.nInner >= T.tys.length { return false }
    if tyIsLitUnion(t0.nInner) { return false }
    const inner = tyAt(t0.nInner)
    if inner is TyUnion { return inner.uMembers.length >= 2 }
    return false
  }
  const t = tyAt(ix)
  if t is TyUnion {
    let hasNull = false
    let others = 0
    let i = 0
    while i < t.uMembers.length {
      const m = tyAt(t.uMembers[i])
      let isNull = false
      if m is TyPrim {
        if m.primName == "null" { isNull = true }
      }
      if isNull { hasNull = true } else { others = others + 1 }
      i = i + 1
    }
    return hasNull && others >= 2
  }
  false
}

// The primitive name arena type `ix` renders as (`tyToStr`), or "" when it renders as
// anything else — `tyEq`'s discipline for the one-primitive case, read off the arena rather
// than a built string. Unwraps a single-member union too, since `tyToStr`'s union arm
// prints one member bare.
export function tyPrimNameOf(ix: i32): PrimName | null {
  if ix < 0 { return null }
  const t = tyAt(ix)
  match t {
    TyPrim => t.primName
    TyUnion => {
      if t.uMembers.length == 1 { return tyPrimNameOf(t.uMembers[0]) }
      null
    }
    // None of these renders as a bare primitive name.
    TyFunc | TyObj | TyNullable | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => null
  }
}

// Whether arena type `ix` is the primitive `nm` — the decision form of `tyPrimNameOf`,
// replacing `tyToStr(ix) == "i32"` at sites asking a structural question ("is the inner
// the string primitive?") by rendering.
export function tyIsPrimNamed(ix: i32, nm: PrimName): boolean {
  tyPrimNameOf(ix) == nm
}

// —— the element row of an array type, empty-`[]` hole answered once ——
// The element arena index of `TyArray` `ix`, or `-1` when `ix` isn't an array or its
// element is still the unconstrained-`[]` hole — a declared state, not a corruption.
// `T.tys[t.aElem]` without this check is an out-of-bounds `array.get` inside the compiler.
export function tyArrayElemIx(ix: i32): i32 {
  if ix < 0 || ix >= T.tys.length { return -1 }
  const t = tyAt(ix)
  if t is TyArray {
    if t.aElem < 0 || t.aElem >= T.tys.length { return -1 }
    return t.aElem
  }
  -1
}

// ── structural type equality ──
// Whether two arena types render identically (`tyToStr(a) == tyToStr(b)`), decided
// structurally — mirrors the render rules (union layers flatten, holes compare equal,
// field order matters), not mutual assignability, which `sameVariantTy` keeps separate.
const tyEqAStack: i32[] = []

const tyEqBStack: i32[] = []

// Set only inside `tyEqSameHoles`: `tyEq` then tells two inference holes apart by name.
let tyEqHolesExact = false

// `tyEq` with each inference hole equal only to itself, so two types it calls equal name the
// same holes and substitute alike.
export function tyEqSameHoles(a: i32, b: i32): boolean {
  if a == b { return true }
  const was = tyEqHolesExact
  tyEqHolesExact = true
  const r = tyEq(a, b)
  tyEqHolesExact = was
  r
}

// Set only inside `tyEqSoftLits`: `tyEq` then compares a lone literal as its base scalar.
let tyEqSoft = false

// `tyEq` with a lone literal equal to its base scalar at every depth, as the canon key widens
// a literal run; a literal union still compares as itself. A rolled and an unrolled spelling
// of one recursive arm then compare equal although only one of them softened its tags.
export function tyEqSoftLits(a: i32, b: i32): boolean {
  if a == b { return true }
  const was = tyEqSoft
  tyEqSoft = true
  const r = tyEq(a, b)
  tyEqSoft = was
  r
}

export function tyEq(a0: i32, b0: i32) {
  let a = a0
  let b = b0
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  if tyEqSoft {
    const ta = tyAt(a)
    const tb = tyAt(b)
    if ta is TyLit { a = litBaseTy(ta) }
    if tb is TyLit { b = litBaseTy(tb) }
    if a == b { return true }
  }
  // A pair already being compared higher in the recursion is assumed equal — the cycle
  // guard for recursive named types, like `assignable`'s.
  let gi = tyEqAStack.length - 1
  while gi >= 0 {
    if tyEqAStack[gi] == a && tyEqBStack[gi] == b {
      tyEqGuardHits = tyEqGuardHits + 1
      return true
    }
    gi = gi - 1
  }
  const tag = tyEqMemoTag()
  const seen = pairMemoGet(tyEqMemo, a, b, tag)
  if seen >= 0 { return seen == 1 }
  const hits = tyEqGuardHits
  tyEqAStack.push(a)
  tyEqBStack.push(b)
  const ok = tyEqGo(a, b)
  tyEqAStack.pop()
  tyEqBStack.pop()
  if tyEqAStack.length > 0 && tyEqGuardHits == hits && tyAt(a) is TyObj {
    pairMemoPut(tyEqMemo, a, b, tag, ok)
  }
  if tyEqAStack.length == 0 { pairMemoClear(tyEqMemo) }
  ok
}

// The record pairs one outermost `tyEq` call decided without assuming a pair still being
// compared, so a sub-record a diamond shares is compared once per call (D9930).
let tyEqGuardHits = 0

const tyEqMemo = pairMemoNew()

// The modes an answer is decided under.
function tyEqMemoTag(): i32 {
  let f = 0
  if tyEqSoft { f = f + 1 }
  if tyEqHolesExact { f = f + 2 }
  f
}

// Flattens nested union layers only — a nullable renders `T?` here, not `T | null`, so
// (unlike `flattenVariantsInto`) it stays opaque rather than being inlined.
function unionMembersInto(ty: i32, out: i32[]) {
  if ty >= 0 {
    const t = tyAt(ty)
    if t is TyUnion {
      const ms = t.uMembers
      let i = 0
      while i < ms.length {
        unionMembersInto(ms[i], out)
        i = i + 1
      }
      return 0
    }
  }
  out.push(ty)
  0
}

// Union render-equality: the flattened member sequences match pairwise.
function unionEq(a: i32, b: i32) {
  const av: i32[] = []
  unionMembersInto(a, av)
  const bv: i32[] = []
  unionMembersInto(b, bv)
  if av.length != bv.length { return false }
  let i = 0
  while i < av.length {
    if !tyEq(av[i], bv[i]) { return false }
    i = i + 1
  }
  true
}

function tyEqGo(a: i32, b: i32) {
  // `tyEq` answers "do these render identically", and a nominal newtype renders as its
  // name — so two brands, or a brand and its base, are not equal here either, keeping the
  // predicate consistent with `tyToStr`.
  if nomNameOfTy(a) != nomNameOfTy(b) { return false }
  const ta = tyAt(a)
  const tb = tyAt(b)
  // Either side being a union routes to the same member-sequence comparison, so this
  // asymmetric pre-test sits ahead of the exhaustive dispatch on `ta` — that dispatch's
  // own `TyUnion` arm would otherwise shadow the `b`-side case.
  if tb is TyUnion { return unionEq(a, b) }
  // Exhaustive over `Ty`, deliberately without a `_` arm: a new variant breaks the
  // self-compile here instead of silently answering `false` ("these types differ"),
  // which every caller reads as a settled verdict.
  match ta {
    TyUnion => {
      return unionEq(a, b)
    }
    TyPrim => {
      if tb is TyPrim { return ta.primName == tb.primName }
      return false
    }
    TyErr => {
      if tb is TyErr { return true }
      return false
    }
    TyVar => {
      if tb is TyVar {
        // An inference hole renders `_` regardless of its internal name, except to a caller
        // asking for the same holes (`tyEqSameHoles`).
        if ta.tvName[0] == '?' && !tyEqHolesExact { return tb.tvName[0] == '?' }
        // Two declarations' parameters of one name substitute apart.
        if (
          tyEqHolesExact
          && (tvNestOf.get(a) ?? -1) != (tvNestOf.get(b) ?? -1)
        ) {
          return false
        }
        return ta.tvName == tb.tvName
      }
      return false
    }
    TyLit => {
      if tb is TyLit {
        return ta.litKind == tb.litKind && ta.litText == tb.litText
      }
      return false
    }
    TyNullable => {
      if tb is TyNullable { return tyEq(ta.nInner, tb.nInner) }
      return false
    }
    TyArray => {
      if tb is TyArray {
        // A view and its list render differently and accept different operations, so they
        // are not the same type — `readonly Shape[]` never keys a `Shape[]` registry row.
        if ta.aRead != tb.aRead { return false }
        return tyEq(ta.aElem, tb.aElem)
      }
      return false
    }
    TyMap => {
      if tb is TyMap {
        if ta.mSet != tb.mSet { return false }
        return tyEq(ta.mKey, tb.mKey) && tyEq(ta.mVal, tb.mVal)
      }
      return false
    }
    TyFunc => {
      if tb is TyFunc {
        const ap = ta.fnParamTypes
        const bp = tb.fnParamTypes
        if ap.length != bp.length { return false }
        if !tyEq(ta.fnRet, tb.fnRet) { return false }
        let i = 0
        while i < ap.length {
          if !tyEq(ap[i], bp[i]) { return false }
          i = i + 1
        }
        return true
      }
      return false
    }
    TyObj => {
      if tb is TyObj {
        const an = ta.objFieldNames
        const bn = tb.objFieldNames
        if an.length != bn.length { return false }
        const aty = ta.objFieldTypes
        const bty = tb.objFieldTypes
        let i = 0
        while i < an.length {
          if an[i] != bn[i] { return false }
          if !tyEq(aty[i], bty[i]) { return false }
          i = i + 1
        }
        return true
      }
      return false
    }
    TyNeg => {
      if tb is TyNeg { return tyEq(ta.negTy, tb.negTy) }
      return false
    }
  }
}

// The type-arena index of object `o`'s field `name`, or `-1` if absent — takes a concrete
// `TyObj` already narrowed by the caller. The `tyStep*` peel family's object arm, exported
// because the shape interner's descent needs the matching arena field for a shape's field
// text. Declines on a non-`TyObj` or a missing name; the caller then takes the name leg unchanged.
export function tyFieldTyOf(ty: i32, name: string): i32 {
  if ty < 0 { return -1 }
  const t = tyAt(ty)
  if t is TyObj { return objFieldType(t, name) }
  -1
}

export function objFieldType(o: TyObj, name: string) {
  const names = o.objFieldNames
  const ftys = o.objFieldTypes
  const n = name.length
  let i = 0
  while i < names.length {
    // The length test is inline so a name of another length skips the string compare's call.
    const fi = names[i]
    if fi.length == n && fi == name { return ftys[i] }
    i = i + 1
  }
  -1
}

// Per arena row, the field-name count `objRowNamesDistinct` last decided at (`-1` unasked)
// and its answer. Stamped with the count because a hole shape gains fields in place; the
// arena reset clears both.
let objDistinctLen: i32[] = []
let objDistinctAns: boolean[] = []

export function objNamesDistinctReset() {
  objDistinctLen = []
  objDistinctAns = []
}

// Whether arena row `ix` is an object whose field names are pairwise distinct. A refused
// duplicate field or key still mints a row that repeats one. A walk over such a row's fields
// can take a same-named field at its own position in another object as the first so named.
export function objRowNamesDistinct(ix: i32): boolean {
  if ix < 0 || ix >= T.tys.length { return false }
  const t = tyAt(ix)
  if !(t is TyObj) { return false }
  const names = t.objFieldNames
  while objDistinctLen.length <= ix {
    objDistinctLen.push(-1)
    objDistinctAns.push(false)
  }
  if objDistinctLen[ix] == names.length { return objDistinctAns[ix] }
  let ok = true
  let i = 1
  while ok && i < names.length {
    const ni = names[i]
    let j = 0
    while ok && j < i {
      const nj = names[j]
      if nj.length == ni.length && nj == ni { ok = false }
      j = j + 1
    }
    i = i + 1
  }
  objDistinctLen[ix] = names.length
  objDistinctAns[ix] = ok
  ok
}

// Whether `ix` has an emitter-classifiable synthetic name (`tyToEmitName(ix) != ""`),
// decided structurally without building the name and paying its allocation. Same arms in
// the same order as `tyToEmitName`; the litunion-alias legs aren't mirrored since they only
// change the spelling, never the answer. Has no cycle guard, matching `tyToEmitName`.
export function tyIsEmitRepresentable(ix: i32): boolean {
  if ix < 0 { return false }
  const t = tyAt(ix)
  // Exhaustive over `Ty`, deliberately without a `_` arm: a new variant breaks the
  // self-compile here instead of silently answering `false`, sending every caller down
  // its fallback path.
  match t {
    TyPrim => {
      return t.primName != "never"
    }
    TyLit => {
      return true
    }
    TyUnion => {
      const members = t.uMembers
      // An empty union produces no parts, and `tyToEmitName` returns "" for it.
      if members.length == 0 { return false }
      let i = 0
      while i < members.length {
        if !tyIsEmitRepresentable(members[i]) { return false }
        i = i + 1
      }
      return true
    }
    TyNullable => {
      return tyIsEmitRepresentable(t.nInner)
    }
    TyObj => {
      // A field-less shape renders `{}` — non-empty, so representable.
      const ftys = t.objFieldTypes
      let i = 0
      while i < ftys.length {
        if !tyIsEmitRepresentable(ftys[i]) { return false }
        i = i + 1
      }
      return true
    }
    TyArray => {
      return tyIsEmitRepresentable(t.aElem)
    }
    TyMap => {
      if !tyIsEmitRepresentable(t.mKey) { return false }
      return tyIsEmitRepresentable(t.mVal)
    }
    TyFunc => {
      const ps = t.fnParamTypes
      let i = 0
      while i < ps.length {
        if !tyIsEmitRepresentable(ps[i]) { return false }
        i = i + 1
      }
      return tyIsEmitRepresentable(t.fnRet)
    }
    TyVar => {
      // An unsolved type parameter has no emitter name.
    }
    TyNeg => {
      // A residual negation — `intersectTy` folds the rest — has no emitter name.
    }
    TyErr => {
      // The error/unknown hole has no emitter name.
    }
  }
  // The type-parameter, negation and error arms land here: `tyToEmitName` spells "" for
  // each, so the capability answer is false.
  false
}

// Whether `tyToEmitName(ix)` is non-empty, decided once per arena node of the walk rather than
// per path, so a type nesting one record twice per level is not walked whole: 1 non-empty,
// 0 empty, -1 when the walk meets a cycle, whose render depends on the ancestors it is asked under.
export function tyEmitNameNonEmpty(ix: i32): i32 {
  const memo: {[i32]: i32} = Map()
  tyEmitNameNonEmptyGo(ix, memo)
}

// The walk of `tyEmitNameNonEmpty`; `memo` holds each finished node's answer and 2 for one
// still on the walk's stack.
function tyEmitNameNonEmptyGo(ix: i32, memo: {[i32]: i32}): i32 {
  if ix < 0 || ix >= T.tys.length { return 0 }
  const seen = memo[ix] ?? -2
  if seen == 2 { return -1 }
  if seen != -2 { return seen }
  memo[ix] = 2
  const r = tyEmitNameNonEmptyArm(ix, memo)
  memo[ix] = r
  r
}

// The answer for one node, its children asked through the memo: the conjunction of
// `tyToEmitName`'s "" conditions, arm for arm.
function tyEmitNameNonEmptyArm(ix: i32, memo: {[i32]: i32}): i32 {
  const t = tyAt(ix)
  match t {
    TyPrim => {
      if t.primName == "never" { return 0 }
      return 1
    }
    TyLit => {
      return 1
    }
    TyUnion => {
      if t.uMembers.length == 0 { return 0 }
      return tyEmitNameAllNonEmpty(t.uMembers, memo)
    }
    TyNullable => {
      return tyEmitNameNonEmptyGo(t.nInner, memo)
    }
    TyObj => {
      return tyEmitNameAllNonEmpty(t.objFieldTypes, memo)
    }
    TyArray => {
      return tyEmitNameNonEmptyGo(t.aElem, memo)
    }
    TyMap => {
      return tyEmitNameAllNonEmpty([t.mKey, t.mVal], memo)
    }
    TyFunc => {
      const ps = tyEmitNameAllNonEmpty(t.fnParamTypes, memo)
      if ps != 1 { return ps }
      if t.fnRet < 0 { return 0 }
      // A `never` result spells `void`.
      if t.fnRet == TY_NEVER { return 1 }
      return tyEmitNameNonEmptyGo(t.fnRet, memo)
    }
    TyVar | TyNeg | TyErr => {
      return 0
    }
  }
}

// 1 when every type in `tys` renders non-empty, -1 when one meets a cycle, else 0.
function tyEmitNameAllNonEmpty(tys: i32[], memo: {[i32]: i32}): i32 {
  let i = 0
  while i < tys.length {
    const r = tyEmitNameNonEmptyGo(tys[i], memo)
    if r != 1 { return r }
    i = i + 1
  }
  1
}

// The render-context vocabulary — the `ctx` half of the one agreed emit renderer
// (`renderEmit(ty, ctx)`). A parameter at all because the policy is not global: a litunion
// alias softens in a direct union but is preserved in a closure result, map value, array
// element or struct field — the position decides. Bits, not an enum: rules quantify over sets of positions.
export const RC_ROOT = 0 // a top-level render: no enclosing position at all

export const RC_UNION_MEM = 1 // a member of a union

export const RC_NULLABLE = 2 // under a nullable — see the STICKY note below

export const RC_FIELD = 4 // an object field's type

export const RC_ELEM = 8 // an array element's type

export const RC_MAP_KEY = 16 // a map key's type

export const RC_MAP_VAL = 32 // a map value's type

export const RC_FN_PARAM = 64 // a function type's parameter

export const RC_FN_RES = 128 // a function type's result

export const RC_UNION_KEY = 256 // a member of a union being spelled as the registry KEY

// The top-level atom count of the name the last render returned, at either face, produced
// by the renderer rather than re-derived by scanning the finished string. A name gains a
// top-level `|` at exactly two places (the union join, the nullable `|null` suffix); every
// other arm is one atom. Meaningful only for a non-empty render, never carried between calls.
export let tyNameAtoms = 1

// The ancestor stack of the render in progress, `isEquatable`'s `seen` guard applied to the
// renderer: a recursive type is a cycle in the arena, and rendering one structurally without
// this is an infinite string that traps the compiler's call stack. Push/pop balanced around
// the recursive entry, so a shape mentioning one struct twice as siblings still renders both.
const emitNameSeen: i32[] = []

// The count of renders the cycle guard answered, so a walk that leaves it unchanged knows its
// answer does not depend on the ancestors it is asked under.
let emitNameCycleHits = 0

// One outermost render's memo of its records, so a record nested twice in a type is walked
// once: an entry stands for the render that stamped it (`emitNameGen`), and only past
// `EMIT_NAME_MEMO_AFTER` record visits, so a small type pays no lookups (D9330).
let emitNameDepth = 0
let emitNameGen = 0
let emitNameObjVisits = 0
const EMIT_NAME_MEMO_AFTER = 32
const emitNameMemoGen: {[i32]: i32} = Map()
const emitNameMemoVal: {[i32]: string} = Map()

// The memoised render of record `ix` in this outermost render, or "".
function emitNameMemoOf(ix: i32): string {
  if emitNameObjVisits < EMIT_NAME_MEMO_AFTER { return "" }
  if (emitNameMemoGen[ix] ?? -1) != emitNameGen { return "" }
  emitNameMemoVal[ix] ?? ""
}

// Records the render `r` of `ix` when it is a record whose walk met no cycle, so it is the
// same under any ancestors; counts the visit either way.
function emitNameMemoSet(ix: i32, r: string) {
  if r == "" || ix < 0 || ix >= T.tys.length || !(tyAt(ix) is TyObj) { return }
  emitNameObjVisits = emitNameObjVisits + 1
  if emitNameObjVisits < EMIT_NAME_MEMO_AFTER { return }
  emitNameMemoGen[ix] = emitNameGen
  emitNameMemoVal[ix] = r
}

// Renders a resolved arena type as an emitter-classifiable synthetic name, or "" when it
// has none (a `TyVar`, a residual negation, err/never, or a recursive type). Ask
// `tyIsEmitRepresentable` for "does it have one at all", not this for "". The position-free
// entry: every outside caller asks about a type standing on its own (`RC_ROOT` by definition).
export function tyToEmitName(ix: i32) { tyToEmitNameAt(ix, RC_ROOT) }

// The same render, told the position it occupies in its parent — the cycle guard lives
// here so the recursive calls, the only ones that can close a cycle, pass through it. On a
// revisit it answers a declared alias's own name (any revisited one, not just the
// outermost), else "" as for an anonymous shape (D1021).
export function aliasNameOfTyIx(ix: i32): string {
  for k in cUserTypes.keys() {
    if (cUserTypes[k] ?? -1) == ix { return k }
  }
  ""
}

export function tyToEmitNameAt(ix: i32, ctx: i32) {
  let si = 0
  while si < emitNameSeen.length {
    if emitNameSeen[si] == ix {
      tyNameAtoms = 1
      emitNameCycleHits = emitNameCycleHits + 1
      const selfNm = aliasNameOfTyIx(ix)
      if selfNm != "" { return selfNm }
      return ""
    }
    si = si + 1
  }
  if emitNameDepth == 0 {
    emitNameGen = emitNameGen + 1
    emitNameObjVisits = 0
  }
  const memo = emitNameMemoOf(ix)
  if memo != "" {
    tyNameAtoms = 1
    return memo
  }
  const before = emitNameCycleHits
  emitNameDepth = emitNameDepth + 1
  emitNameSeen.push(ix)
  const r = tyToNameGo(ix, ctx, false)
  emitNameSeen.pop()
  emitNameDepth = emitNameDepth - 1
  if emitNameCycleHits == before { emitNameMemoSet(ix, r) }
  // An empty render is not an answer, and a declared name always beats it: `type J = null |
  // f64 | JO` folds to a one-member `TyUnion` whose member is a `TyNullable`, so the cycle
  // guard cannot name that index and `J` would otherwise get no emit name at all. Gated on
  // `r == ""`, since "" is not a spelling any consumer can use (D1037).
  if r == "" {
    const fnm = nulFoldAliasNameOf(ix)
    if fnm != "" { return fnm }
  }
  r
}

// The declared name whose 0a placeholder holds `ix` as its single nullable member — the
// shape `type X = … | null` leaves behind (D1037), "" when `ix` is not such a member.
// Arity one and a nullable member are both required: a one-member union also wraps a
// transparent alias, and naming that member would re-spell an already-working render.
function nulFoldAliasNameOf(ix: i32): string {
  if nulFoldWrapperTyIxOf(ix) >= 0 { return nulFoldWrapperNameOf(ix) }
  ""
}

// The same lookup, returning the wrapper's arena index rather than its name — the mv layer
// needs the index, since its `is` test resolves a map arm's slot by arena type while the
// store interned it by name, and under the fold those are the member and the wrapper
// respectively. Without a way back the two tag the same arm differently (D1037).
export function nulFoldWrapperTyIxOf(ix: i32): i32 {
  if ix < 0 { return -1 }
  const it = tyAt(ix)
  if !(it is TyNullable) { return -1 }
  for k in cUserTypes.keys() {
    const wx = cUserTypes[k] ?? -1
    if wx >= 0 {
      const wt = tyAt(wx)
      if wt is TyUnion {
        const wm = wt.uMembers
        if wm.length == 1 && wm[0] == ix { return wx }
      }
    }
  }
  -1
}

function nulFoldWrapperNameOf(ix: i32): string {
  for k in cUserTypes.keys() {
    const wx = cUserTypes[k] ?? -1
    if wx >= 0 {
      const wt = tyAt(wx)
      if wt is TyUnion {
        const wm = wt.uMembers
        if wm.length == 1 && wm[0] == ix { return k }
      }
    }
  }
  ""
}

// The position a composite's interior stands at, for the structural renderer — normally the
// interior's own position, but `RC_ROOT` when `ix` is a registered generic-application
// instance. Canon spells the application's argument at `RC_ROOT`, so this renderer must
// agree or the same argument gets two positions and two names — invalid wasm.
function appKidCtx(ix: i32, ctx: i32): i32 {
  if tyIsGenAppInstance(ix) { return RC_ROOT }
  ctx
}

// Whether `ix` is a registered generic-application instance, whose interior the structural
// renderer spells at the root position rather than at its own.
export function tyIsGenAppInstance(ix: i32): boolean {
  cTyIxSetHas(gaAppTyIxSet, ix)
}

// The kid position the two faces disagree about: the structural face re-roots a registered
// generic application's interior, the nominal face leaves the position alone. Nominal only
// reaches a registered application when `genAppNameOfTy` declined or `RC_UNION_KEY` held its
// arm back, and re-rooting there would respell a member the union key already banked.
function nameKidCtx(ix: i32, ctx: i32, nominal: boolean): i32 {
  if nominal { return ctx }
  appKidCtx(ix, ctx)
}

// The recursive entry of the face being rendered. The two `At`s keep their own bodies: the
// structural one answers a revisited alias's own name and retries the null-fold, the nominal
// one records the cut in `nomNameCycle`.
function tyToNameAt(ix: i32, ctx: i32, nominal: boolean): string {
  if nominal { return tyToNominalNameAt(ix, ctx) }
  tyToEmitNameAt(ix, ctx)
}

// The registered string-litunion alias whose literals are exactly the string-literal members
// of `members`, when at least two are and a non-null, non-literal member stands beside them
// (`"a" | "b" | i32` with `type K = "a" | "b"` → "K"); "" otherwise. The mixed-union preserve.
export function mixedLitRunAliasOf(members: i32[]): string {
  const texts: string[] = []
  let nonLit = false
  let i = 0
  while i < members.length {
    const m = tyAt(members[i])
    if m is TyLit {
      if m.litKind == "str" { texts.push(m.litText) }
    } else {
      let isNull = false
      if m is TyPrim {
        if m.primName == "null" { isNull = true }
      }
      if !isNull { nonLit = true }
    }
    i = i + 1
  }
  if !nonLit || texts.length < 2 { return "" }
  litUnionAliasOfLitTexts(texts)
}

// Whether a union's members are records and not all one type, as arms that differ only in a
// lone literal are; identical arms are one record.
export function tyMembersDistinctRecords(members: i32[]): boolean {
  if members.length < 2 { return false }
  let distinct = false
  for m in members {
    if !(tyAt(m) is TyObj) { return false }
    if !tyEq(m, members[0]) { distinct = true }
  }
  distinct
}

// Whether `ty` is a union, bare or nullable, of distinct record arms that all render one shape,
// as arms that differ only in a lone literal do.
export function tyIsTwinRecordUnion(ty: i32): boolean {
  if ty < 0 { return false }
  const n = tyAt(ty)
  if n is TyNullable { return tyIsTwinRecordUnion(n.nInner) }
  const t = tyAt(ty)
  if !(t is TyUnion) { return false }
  const recs: i32[] = []
  for m in t.uMembers {
    const mt = tyAt(m)
    let isNull = false
    if mt is TyPrim { isNull = mt.primName == "null" }
    if !isNull { recs.push(m) }
  }
  if !tyMembersDistinctRecords(recs) { return false }
  const keep = tyNameAtoms
  const shape = tyToNameAt(recs[0], RC_UNION_MEM, false)
  let same = shape != ""
  for m in recs {
    if same && tyToNameAt(m, RC_UNION_MEM, false) != shape { same = false }
  }
  tyNameAtoms = keep
  same
}

// The render of a union whose record arms differ only in a lone literal, given its deduped
// `parts`: the one shape once per arm, then `null` when a member is, as the declaration's row
// is keyed (D5157); "" when the members are not such arms. Sets `tyNameAtoms`.
function twinRecordsRender(members: i32[], parts: string[]): string {
  const recs: i32[] = []
  let hasNull = false
  for m in members {
    const mt = tyAt(m)
    let isNull = false
    if mt is TyPrim { isNull = mt.primName == "null" }
    if isNull { hasNull = true } else { recs.push(m) }
  }
  let shape = ""
  for p in parts {
    if p != "null" {
      if shape != "" { return "" }
      shape = p
    }
  }
  if shape == "" || !tyMembersDistinctRecords(recs) { return "" }
  let rep = shape
  let r = 1
  while r < recs.length {
    rep = rep + "|" + shape
    r = r + 1
  }
  tyNameAtoms = recs.length
  if hasNull {
    tyNameAtoms = recs.length + 1
    return rep + "|null"
  }
  rep
}

// `tyToNameGo`'s nominal-first prelude: the name a declared struct, generic application or
// union alias of `ix` spells as, or "" when the structural render below owns `ix`.
function tyNameNominal(ix: i32, ctx: i32): string {
  // Nominal-first: a declared struct or union alias renders as its name — one identifier,
  // so one atom.
  const sdn = structNameOfTy(ix)
  if sdn != "" { return sdn }
  // …and a generic application renders as the application (`Box<i32>`), ahead of the union
  // arm for the same reason `structNameOfTy` is. Declines ("") for an uninstantiated or
  // cyclic argument. Not taken at `RC_UNION_KEY`, though: a generic application standing as
  // a union member is spelled by its shape on the annotation side (`unionMemberGenAppShape`).
  if (ctx & RC_UNION_KEY) == 0 {
    const gan = genAppNameOfTy(ix)
    if gan != "" { return gan }
  }
  const udn = unionAliasDeclNameOfTy(ix)
  if udn != "" {
    // …except a declared alias for a numeric literal union (`type Z = 0 | 1`), which
    // denotes its base scalar, never the alias name — the emitter cannot classify that
    // name, so the registry would otherwise claim a union box while every read lowers as a
    // plain scalar. `canonEmitName` reaches this by name, this renderer by arena index.
    const nlb = numLitUnionBaseName(ix)
    if nlb != "" { return nlb }
    // …and an alias whose lists all spell one list denotes that list, rendered below.
    if oneListUnionRender(ix) == "" { return udn }
  }
  ""
}

// `tyToNameGo`'s union arm: the members of `t` (arena index `ix`) rendered and joined with
// `|`, duplicates dropped, with `tyNameAtoms` set to the render's atom count. "" if a member
// is unrenderable.
function tyNameUnion(ix: i32, t: TyUnion, ctx: i32, nominal: boolean): string {
  const members = t.uMembers
  // A pure inline literal union keeps its members — canon's `litUnionPreserve`/
  // `nulLitUnionPreserve` pair, mirrored off the arena. Without it every `TyLit` member
  // renders its base and dedups away, so `{tag: "a"|"b"}` would render `{tag:string}`
  // while the annotation spells `{tag:"a"|"b"}` — one arena type, two names.
  const luiN = litUnionInlineNameOfTy(ix)
  if luiN != "" {
    if luiHasNull {
      tyNameAtoms = luiAtoms + 1
      return luiN + "|null"
    }
    if ctxKeepsLitUnion(ctx) {
      tyNameAtoms = luiAtoms
      return luiN
    }
  }
  // The mixed-union preserve: a string-litunion alias as a union member keeps its alias
  // name (`K0 | f64` renders `K0|f64`, not `string|f64`) — the flattened spelling fails
  // `nameIsLitUnionType` and the box loses its string arm. Mirrored by
  // `canonEmitNameAt`'s `mixedUnionLitAliasRegroup`, so the annotation side agrees.
  const rgAlias = mixedLitRunAliasOf(members)
  const parts: string[] = []
  // The render's atom count, accumulated as parts are kept: a part is not always one
  // atom (a nullable member renders `X|null`), so this is summed rather than read off
  // `parts.length`, and a duplicate part contributes nothing.
  let psum = 0
  let rgDone = false
  let i = 0
  while i < members.length {
    // A member that is a registered litunion alias (`K0 | i64`) keeps its alias name
    // rather than softening to `string`: the alias reps as the i32 atom in the union
    // box, and every `$fnsig`/slot key derived here must agree with the annotation side's spelling.
    const rgm = tyAt(members[i])
    if rgAlias != "" && rgm is TyLit {
      if !rgDone {
        rgDone = true
        parts.push(rgAlias)
        psum = psum + 1
      }
      i = i + 1
      continue
    }
    // An alias name is one identifier — one atom. Only the render leg can be wider,
    // and it reports its own width in `tyNameAtoms`.
    let sc = 1
    let s = litUnionAliasNameOfTy(members[i])
    if s == "" {
      // A union member, carrying the sticky nullable bit down so this arm agrees with
      // canon's flat `A|B|null` split about what "under a nullable" means.
      s = tyToNameAt(members[i], RC_UNION_MEM | (ctx & RC_NULLABLE), nominal)
      sc = tyNameAtoms
    }
    if s == "" { return "" }
    // A function-type member renders parenthesized (`(()=>f32|null)|{w:i32}`) — bare,
    // the closure's result would swallow the union's sibling members, producing a
    // divergent `ref.cast` functype at the value call. Grouping parens keep it one atom.
    if rgm is TyFunc {
      s = "(" + s + ")"
      sc = 1
    }
    let dup = false
    let j = 0
    while j < parts.length {
      if parts[j] == s { dup = true }
      j = j + 1
    }
    if !dup {
      parts.push(s)
      psum = psum + sc
    }
    i = i + 1
  }
  if parts.length == 0 { return "" }
  // Record arms that differ only in a lone literal render one shape, yet are distinct
  // types and keep their box: the render repeats the shape once per arm, as the
  // declaration's own row is keyed (D5157).
  const twin = twinRecordsRender(members, parts)
  if twin != "" { return twin }
  let out = parts[0]
  let k = 1
  while k < parts.length {
    out = out + "|" + parts[k]
    k = k + 1
  }
  tyNameAtoms = psum
  return out
}

// `tyToNameGo`'s nullable arm: the inner of `t` rendered with its `|null` arm, keeping a
// literal-union alias or inline literal union whole. "" if the inner is unrenderable.
function tyNameNullable(t: TyNullable, nominal: boolean): string {
  // A nullable litunion-alias (`K0 | null`) keeps its alias rather than softening to
  // `string|null` — the two spell different reps (the alias niche is the i32 atom with
  // a `-1` sentinel; `string|null` is the nullable string ref).
  const nal = litUnionAliasNameOfTy(t.nInner)
  if nal != "" {
    // An alias identifier plus the `null` arm — two atoms.
    tyNameAtoms = 2
    return nal + "|null"
  }
  // …and an un-aliased one keeps its members, at every position: canon's
  // `nulLitUnionPreserve` has no `ctxKeepsLitUnion` gate. The same preference
  // `litUnionInlineNameOfTy` applies internally, so the two cannot disagree.
  const nlui = litUnionInlineNameOfTy(t.nInner)
  if nlui != "" {
    tyNameAtoms = luiAtoms + 1
    return nlui + "|null"
  }
  // …and so does one string literal, its one-member set's atom niche (D7446).
  const none = oneStrLitSpelling(t.nInner)
  if none != "" {
    tyNameAtoms = 2
    return none + "|null"
  }
  // At the nominal face this is where a nullable declared struct or union keeps its
  // name (`S|null`, `U|null`) — the prelude claims it one recursion down.
  const inner = tyToNameAt(t.nInner, RC_NULLABLE, nominal)
  const innerAtoms = tyNameAtoms
  if inner == "" { return "" }
  // A nullable function type keeps grouping parens (`((i32)=>string)|null`) — bare,
  // the render would spell a closure returning `string|null` instead, the same
  // swallowed-arm ambiguity as the union-member case.
  if t.nInner >= 0 && tyAt(t.nInner) is TyFunc {
    // The grouped closure is one atom; `null` is the second.
    tyNameAtoms = 2
    return "(" + inner + ")|null"
  }
  // A union inner keeps its own top-level `|`s (`A|B|null`), so the `null` arm adds to
  // the inner render's width rather than making the whole name two atoms.
  tyNameAtoms = innerAtoms + 1
  return inner + "|null"
}

// `tyToNameGo`'s record arm: `{name:type,…}` over the fields of `t` (arena index `ix`), a
// literal-union alias field kept by name. "" if any field is unrenderable.
function tyNameObj(ix: i32, t: TyObj, nominal: boolean): string {
  const names = t.objFieldNames
  const ftys = t.objFieldTypes
  let out = "{"
  let fi = 0
  while fi < names.length {
    // A field preserves a literal-union alias (`{f: K0}`, `{f: K0 | null}`) rather
    // than the softened `string`, so a rendered shape resolves the same struct index
    // the annotation side interned — the field dual of the `TyFunc`-result preservation.
    let fs = tyNameObjFieldPreserve(ftys[fi])
    if fs == "" {
      fs = tyToNameAt(ftys[fi], nameKidCtx(ix, RC_FIELD, nominal), nominal)
    }
    if fs == "" { return "" }
    if fi > 0 { out = out + "," }
    out = out + names[fi] + ":" + fs
    fi = fi + 1
  }
  // Every field separator sits inside the braces — one atom. Set explicitly, since a
  // field's own render leaves `tyNameAtoms` holding its last width.
  tyNameAtoms = 1
  return out + "}"
}

// The spelling a record field of type `ft` keeps instead of its render: a literal-union alias,
// nullable or not, or a lone string literal, which reps as the atom (D7220); "" otherwise.
function tyNameObjFieldPreserve(ft: i32): string {
  const ftn = tyAt(ft)
  if ftn is TyNullable {
    const fal = litUnionAliasNameOfTy(ftn.nInner)
    if fal != "" { return fal + "|null" }
  }
  const fbal = litUnionAliasNameOfTy(ft)
  if fbal != "" { return fbal }
  oneStrLitSpelling(ft)
}

// A key two types share exactly when `tyToEmitName` renders them alike, without building a
// render that doubles per level of a nested record: a deep record, or a list or nullable of one,
// spells each inner record by an interned id. A deep record and a non-record that render alike
// key apart; "" when the render is "" (D2780, D9330).
export function tyEmitNameKey(ix: i32): string {
  if ix < 0 || ix >= T.tys.length || !tyDeeperThan(ix, 8) {
    return tyToEmitName(ix)
  }
  if !tyWrapsRecord(ix) { return tyToEmitName(ix) }
  emitKeyMemo = Map()
  emitKeyWrapped(ix)
}

// Whether `ix` is a record, or a list or nullable whose peel down those wrappers is one.
export function tyWrapsRecord(ix: i32): boolean {
  let k = ix
  let steps = 0
  while k >= 0 && k < T.tys.length && steps < 64 {
    const t = tyAt(k)
    match t {
      TyObj => {
        return true
      }
      TyNullable => {
        k = t.nInner
      }
      TyArray => {
        k = t.aElem
      }
      TyPrim | TyErr | TyFunc | TyUnion | TyMap | TyVar | TyLit | TyNeg => {
        return false
      }
    }
    steps = steps + 1
  }
  false
}

// `tyToEmitNameAt`'s walk over a type `tyWrapsRecord` admits: a record by `emitKeyObj`, a
// nullable as `tyNameNullable` spells a record's, a list as `arrElemRender` groups its element.
function emitKeyWrapped(ix: i32): string {
  const t = tyAt(ix)
  if t is TyObj { return emitKeyObj(ix, t) }
  for a in emitNameSeen {
    if a == ix {
      emitNameCycleHits = emitNameCycleHits + 1
      return aliasNameOfTyIx(ix)
    }
  }
  emitNameSeen.push(ix)
  let r = ""
  if t is TyNullable {
    const k = emitKeyWrapped(t.nInner)
    if k != "" { r = k + "|null" }
  } else if t is TyArray {
    const k = emitKeyWrapped(t.aElem)
    if k != "" {
      if (
        t.aElem >= 0
        && t.aElem < T.tys.length
        && tyAt(t.aElem) is TyNullable
      ) {
        r = "(" + k + ")[]"
      } else {
        r = k + "[]"
      }
    }
  }
  emitNameSeen.pop()
  if r == "" { return nulFoldAliasNameOf(ix) }
  r
}

// The interned ids of the record spellings `tyEmitNameKey` has built, and one call's memo of
// the records whose key does not depend on the ancestors they are asked under.
const emitKeyIds: {[string]: i32} = Map()
let emitKeyCount = 0
let emitKeyMemo: {[i32]: string} = Map()

// `tyNameObj`'s walk over record `t` (arena index `ix`), each field spelled by its preserved
// name, its record key, or its render; "" when any field's is "". Pushes `ix` as
// `tyToEmitNameAt` does, so the renders it delegates see the same ancestors.
function emitKeyObj(ix: i32, t: TyObj): string {
  for a in emitNameSeen {
    if a == ix {
      emitNameCycleHits = emitNameCycleHits + 1
      return aliasNameOfTyIx(ix)
    }
  }
  const hit = emitKeyMemo[ix] ?? "\n"
  if hit != "\n" { return hit }
  const before = emitNameCycleHits
  emitNameSeen.push(ix)
  const names = t.objFieldNames
  const ftys = t.objFieldTypes
  let out = "{"
  let fi = 0
  while fi < names.length {
    let fs = tyNameObjFieldPreserve(ftys[fi])
    if fs == "" {
      const ft = tyAt(ftys[fi])
      if ft is TyObj {
        fs = emitKeyObj(ftys[fi], ft)
      } else {
        fs = tyToEmitNameAt(ftys[fi], appKidCtx(ix, RC_FIELD))
      }
    }
    if fs == "" {
      out = ""
      fi = names.length
    } else {
      if fi > 0 { out = out + "," }
      out = out + names[fi] + ":" + fs
      fi = fi + 1
    }
  }
  emitNameSeen.pop()
  let r = ""
  if out != "" {
    out = out + "}"
    let id = emitKeyIds[out] ?? -1
    if id < 0 {
      id = emitKeyCount
      emitKeyCount = emitKeyCount + 1
      emitKeyIds[out] = id
    }
    r = "~" + i32ToStr(id)
  }
  if emitNameCycleHits == before { emitKeyMemo[ix] = r }
  r
}

// `tyToNameGo`'s function arm: the closure-annotation form `(p1,p2)=>ret` of `t` (arena
// index `ix`). "" if any parameter or the result is unrenderable.
function tyNameFunc(ix: i32, t: TyFunc, nominal: boolean): string {
  // A function type renders the emitter's closure-annotation form `(p1, p2) => ret`, so
  // an inferred closure value recovers a name `annSigKeyTy` can key. "" if any param or
  // the result is unrenderable.

  const ps = t.fnParamTypes
  let out = "("
  let i = 0
  while i < ps.length {
    const ps1 = tyToNameAt(ps[i], RC_FN_PARAM, nominal)
    if ps1 == "" { return "" }
    if i > 0 { out = out + "," }
    out = out + ps1
    i = i + 1
  }
  // A function result preserves a literal-union alias (`() => K0`, `() => K0 | null`)
  // rather than the softened `string`, so an inferred closure value keys the litunion's
  // i32-atom token, byte-matching the constructed lambda's `$fnsig`.
  // A hole result (a hole function's parameter called for its value) is unrenderable (D6794).
  if t.fnRet < 0 { return "" }
  let rs = ""
  // A `never` result lowers as `void`: the callee leaves nothing, and each call site
  // follows it with `unreachable` (D1972).
  if t.fnRet == TY_NEVER && t.fnRet >= 0 { rs = "void" }
  const rtn = tyAt(t.fnRet)
  if rtn is TyNullable {
    const nal = litUnionAliasNameOfTy(rtn.nInner)
    if nal != "" { rs = nal + "|null" }
  }
  if rs == "" {
    const bal = litUnionAliasNameOfTy(t.fnRet)
    if bal != "" { rs = bal }
  }
  if rs == "" {
    rs = tyToNameAt(t.fnRet, nameKidCtx(ix, RC_FN_RES, nominal), nominal)
  }
  if rs == "" { return "" }
  // A function-type result keeps grouping parens so the outer `$fnsig` producers see a
  // single result token (`(i32)=>((i32)=>i32)`), matching the source-annotation form.
  const rt = tyAt(t.fnRet)
  if rt is TyFunc { rs = "(" + rs + ")" }
  // A function type is one atom: params are parenthesized and everything after the
  // top-level `=>` belongs to the result — `unionMemberCount` implements this by
  // stopping at a top-level arrow, so `(i32)=>A|B` counts 1, not 2.
  tyNameAtoms = 1
  return out + ")=>" + rs
}

// The structural render, at one of two faces: `nominal` turns on the nominal-first prelude
// (a declared struct, generic application or union alias spells as its own name) and selects
// the recursion's face. One body because the two faces and canon must spell one arena type
// one way, or the name-keyed registries hold a row per spelling; `tyToStrGo` is the precedent.
function tyToNameGo(ix: i32, ctx: i32, nominal: boolean): string {
  tyNameAtoms = 1
  if ix < 0 { return "" }
  if nominal {
    const nn = tyNameNominal(ix, ctx)
    if nn != "" { return nn }
  }
  const t = tyAt(ix)
  // Exhaustive over `Ty`, deliberately without a `_` arm: a new variant breaks the
  // self-compile here instead of silently rendering "" — which every name-keyed registry
  // downstream reads as a settled answer.
  match t {
    TyPrim => {
      if t.primName == "never" { return "" }
      return t.primName
    }
    TyLit => {
      // A literal renders as its base scalar, at the one home that answers that
      // (`tyLitBaseName`).
      return tyLitBaseName(t)
    }
    TyUnion => {
      return tyNameUnion(ix, t, ctx, nominal)
    }
    TyNullable => {
      return tyNameNullable(t, nominal)
    }
    TyObj => {
      return tyNameObj(ix, t, nominal)
    }
    TyArray => {
      // A litunion-alias element (`K0[]`) keeps its alias name rather than softening to
      // `string[]` — the two spell different reps (the alias array is the interned-i32 atom
      // list; `string[]` is the string-ref list), so widening it would mint a twin mv slot.
      let el = litUnionAliasNameOfTy(t.aElem)
      // The element's own atom width, as its producer reported it — an alias identifier is
      // one atom, the render leg reports its own.
      let elw = 1
      // So does a lone string literal element, its one-member set's atom (D7340).
      if el == "" { el = oneStrLitSpelling(t.aElem) }
      if el == "" {
        el = tyToNameAt(t.aElem, nameKidCtx(ix, RC_ELEM, nominal), nominal)
        elw = tyNameAtoms
      }
      if el == "" { return "" }
      // A list name is one atom in every form — a union element is parenthesized so its
      // `|`s stop being top-level. Set explicitly, since the element render leaves its own
      // width behind; the grouping itself is `arrElemRender`'s.
      tyNameAtoms = 1
      return arrElemRender(el, t.aElem, elw)
    }
    TyMap => {
      const mk = tyToNameAt(t.mKey, RC_MAP_KEY, nominal)
      // A litunion-alias map value (`{[string]: K0}`) keeps its alias name rather than
      // softening to `string` — an atom-valued map is the mono i32 map, and every
      // `$fnsig`/mv-slot key derived here must agree with the annotation side's spelling.
      let mv = litUnionAliasNameOfTy(t.mVal)
      if mv == "" {
        mv = tyToNameAt(t.mVal, nameKidCtx(ix, RC_MAP_VAL, nominal), nominal)
      }
      if mk == "" || mv == "" { return "" }
      // The key/value separators sit inside the braces — one atom.
      tyNameAtoms = 1
      return "{[" + mk + "]:" + mv + "}"
    }
    TyFunc => {
      return tyNameFunc(ix, t, nominal)
    }
    TyVar => {
      // An unsolved type parameter has no name at either face — the monomorphizer names
      // the instance.
    }
    TyNeg => {
      // A residual negation — `intersectTy` folds the rest — has no name at either face.
    }
    TyErr => {
      // The error/unknown hole has no name at either face; a rejected program never
      // reaches the emitter that would need one.
    }
  }
  // The type-parameter, negation and error arms land here: "" is the renderer's own
  // signal, which `tyIsEmitRepresentable` predicts structurally arm-for-arm.
  ""
}

// The declared name of declared-struct arena index `ty` (`type S = {…}` → "S"), or "" when
// `ty` is not a registered declared struct — the reverse of `cUserTypes` via the parallel
// `cStructTyIxs`/`cStructNames` arrays. First-match wins: a redeclared name shares the last
// arena index with its predecessor, so either name is interchangeable.
export function structNameOfTy(ty: i32): string {
  if ty < 0 || ty >= cStructFirstPos.length { return "" }
  const i = cStructFirstPos[ty]
  if i < 0 || i >= cStructNames.length { return "" }
  cStructNames[i]
}

// The declared alias name of declared-union arena index `ty` (`type U = A | B` → "U"), or
// "" when `ty` is not a registered union alias — `litUnionAliasNameOfTy`'s index-match leg,
// generalized to value unions.
export function unionAliasDeclNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  luIndexSync()
  if ty >= luPosByTy.length { return "" }
  const a = luPosByTy[ty]
  if a < 0 { return "" }
  cUnionNames[a]
}

// Does arena type `ix` reach itself — is its expansion cyclic? The guard the nominal
// short-circuit needs: `type L<T> = {head: T, tail: L<T>[]}` at `i32` mints a `TyObj`
// whose `tail` element is that same index, so the application has a finite nominal name
// while its expansion does not, and `guardFiniteUserTypes` rejects such a program by this.
export function tyReachesSelf(ix: i32): boolean {
  if ix < 0 { return false }
  const seen: i32[] = []
  tyReachesGo(ix, ix, seen, 0)
}

// Does arena type `ix` reach a cycle — itself, or a type that reaches itself, as an arm a join
// re-minted around a recursive alias does?
export function tyReachesCycle(ix: i32): boolean {
  if ix < 0 { return false }
  const stack: i32[] = []
  const done: i32[] = []
  tyCycleGo(ix, stack, done)
}

function tyCycleGo(cur: i32, stack: i32[], done: i32[]): boolean {
  if cur < 0 || i32ListHas(done, cur) { return false }
  if i32ListHas(stack, cur) { return true }
  stack.push(cur)
  const kids: i32[] = []
  tyChildrenOf(cur, kids)
  for k in kids {
    if tyCycleGo(k, stack, done) { return true }
  }
  stack.pop()
  done.push(cur)
  false
}

function tyReachesGo(cur: i32, target: i32, seen: i32[], depth: i32): boolean {
  if cur < 0 { return false }
  if depth > 64 { return false }
  const kids: i32[] = []
  tyChildrenOf(cur, kids)
  let i = 0
  while i < kids.length {
    const k = kids[i]
    if k == target { return true }
    if k >= 0 {
      let dup = false
      let j = 0
      while j < seen.length {
        if seen[j] == k { dup = true }
        j = j + 1
      }
      if !dup {
        seen.push(k)
        if tyReachesGo(k, target, seen, depth + 1) { return true }
      }
    }
    i = i + 1
  }
  false
}

// The direct child type indices of arena entry `ix`, appended to `out`. The leaf
// constructors (`TyPrim`/`TyLit`/`TyVar`/`TyErr`) have none.
export function tyChildrenOf(ix: i32, out: i32[]) {
  if ix < 0 { return 0 }
  const t = tyAt(ix)
  match t {
    TyArray => out.push(t.aElem)
    TyNullable => out.push(t.nInner)
    TyNeg => out.push(t.negTy)
    TyUnion => {
      const ms = t.uMembers
      let i = 0
      while i < ms.length {
        out.push(ms[i])
        i = i + 1
      }
    }
    TyObj => {
      const fs = t.objFieldTypes
      let i = 0
      while i < fs.length {
        out.push(fs[i])
        i = i + 1
      }
    }
    TyFunc => {
      const ps = t.fnParamTypes
      let i = 0
      while i < ps.length {
        out.push(ps[i])
        i = i + 1
      }
      out.push(t.fnRet)
    }
    TyMap => {
      out.push(t.mKey)
      out.push(t.mVal)
    }
    // The leaf constructors have no child.
    TyPrim | TyLit | TyVar | TyErr => {}
  }
  0
}

// The generic application `ty` traces back to, rendered nominally (`Box<i32>`,
// `Pair<i32,string>`), or "" when `ty` is not a recorded application. Arguments render
// through `tyToNominalNameAt` in field position, so a nested application spells in full;
// the separator is `,` with no space, matching `gaeArgsTextOf`/`canonEmitName` byte-for-byte.
export function genAppNameOfTy(ty: i32): string {
  const i = genAppRowOf(ty)
  if i < 0 { return "" }
  // Cyclic expansion: decline, so the caller descends and the cycle bank fills as it
  // did before this arm existed. Memoized per row (`-1` unknown / `0` cyclic / `1`
  // finite) — the answer cannot change once `applyGenAliasArgs` has filled the shape.
  if gaAppFinite[i] < 0 {
    if tyReachesSelf(ty) { gaAppFinite[i] = 0 } else { gaAppFinite[i] = 1 }
  }
  if gaAppFinite[i] == 0 { return "" }
  const st = gaAppArgStart[i]
  const cn = gaAppArgCount[i]
  // A zero-argument row cannot arise (`applyGenAliasArgs` rejects an arity mismatch
  // before the memo), but a head with no arguments would render `Box<>` — not a
  // spelling anything can resolve. Bail to "" so the caller keeps its own route.
  if cn <= 0 { return "" }
  let s = ""
  let a = 0
  while a < cn {
    // `RC_ROOT` — an argument stands where the parameter it binds stands, a position
    // this rewrite has no way to know, so it must use the same context every other
    // whole-annotation entry uses. A different context here is invisible until the
    // inline litunion leg reads it, splitting one arena type into two rendered names.
    const an = tyToNominalNameAt(gaAppArgFlat[st + a], RC_ROOT)
    // An argument with no nominal name (a `TyVar`, or a cycle) makes the whole
    // application unspellable. Decline rather than emit `Box<>` or a partial name.
    if an == "" { return "" }
    if a > 0 { s = s + "," }
    s = s + an
    a = a + 1
  }
  // The application is one top-level atom, whatever the recursion left in the bank.
  tyNameAtoms = 1
  gaAppHeads[i] + "<" + s + ">"
}

// The `gaAppTyIxs` row recording `ty` as a generic application, or -1 when it is not one.
export function genAppRowOf(ty: i32): i32 {
  if ty < 0 { return -1 }
  let i = 0
  while i < gaAppTyIxs.length {
    if gaAppTyIxs[i] == ty { return i }
    i = i + 1
  }
  -1
}

// The ancestor stack of the nominal render in progress, `emitNameSeen`'s twin: nominal-first
// tames a declared recursive struct by short-circuiting to its name, but not a recursive
// generic alias — `type L<T> = {head: T, tail: L<T> | null}` resolves to a genuinely cyclic,
// anonymous arena entry, and without this the render traps the compiler's call stack.
const nomNameSeen: i32[] = []

// True when the last top-level `tyToNominalName` call is cut by the ancestor stack. ""
// alone cannot carry that: this renderer also returns "" for a `TyVar`, `never`, or any arm
// with no name, none of which is a cycle — testing the string would reject every generic alias.
export let nomNameCycle = false

// The name-faithful face: a declared struct renders as its name, a declared union alias as
// its alias name, rather than the structural expansion — which tames recursion too, since a
// declared type short-circuits before its fields re-enter. Position-free, as on the
// structural sibling; the cycle bank is per top-level render, so it resets here.
export function tyToNominalName(ix: i32): string {
  nomNameCycle = false
  tyToNominalNameAt(ix, RC_ROOT)
}

// Did the last `tyToNominalName` hit a cycle — i.e. does that type have no finite nominal
// name at all? Read by `emit_collect.vl`'s `guardFiniteUserTypes`, which rejects such a
// program by name instead of letting any renderer trap on it.
export function tyNomNameCycled(): boolean { nomNameCycle }

export function tyToNominalNameAt(ix: i32, ctx: i32): string {
  tyNameAtoms = 1
  if ix < 0 { return "" }
  let si = 0
  while si < nomNameSeen.length {
    if nomNameSeen[si] == ix {
      tyNameAtoms = 1
      nomNameCycle = true
      return ""
    }
    si = si + 1
  }
  nomNameSeen.push(ix)
  const r = tyToNameGo(ix, ctx, true)
  nomNameSeen.pop()
  r
}

// The brand arena index `ix` carries, or "" when it is an ordinary structural type. The
// single reader of the sidecar; every nominal decision in the checker asks it.
export function nomNameOfTy(ix: i32) {
  if ix < 0 { return "" }
  let i = 0
  while i < nwTyIxs.length {
    if nwTyIxs[i] == ix { return nwNames[i] }
    i = i + 1
  }
  ""
}

// Does `dstTy` carry a nominal brand at or under its wrappers? The gate for the
// expression-aware retry `nomLitAdopts` uses: shallow on purpose, since a slot check meets
// only the type itself or one or two wrappers over it (`V?`, `V[]`, `V | null`).
export function tyReachesBrand(ty: i32, d: i32) {
  if ty < 0 { return false }
  if d <= 0 { return false }
  if nomNameOfTy(ty) != "" { return true }
  const t = tyAt(ty)
  match t {
    TyNullable => tyReachesBrand(t.nInner, d - 1)
    TyArray => tyReachesBrand(t.aElem, d - 1)
    TyUnion => {
      const ms = t.uMembers
      let i = 0
      let any = false
      while i < ms.length {
        if tyReachesBrand(ms[i], d - 1) { any = true }
        i = i + 1
      }
      any
    }
    // Shallow on purpose: a brand under a field, map or closure is its own slot's question.
    TyPrim | TyFunc | TyObj | TyMap | TyNeg | TyVar | TyLit | TyErr => false
  }
}

export function tyIsNewtypeBrand(ty: i32): boolean {
  if ty < 0 { return false }
  let i = 0
  while i < nwTyIxs.length {
    if nwTyIxs[i] == ty { return true }
    i = i + 1
  }
  false
}

// The base-scalar emit name of a numeric literal-union type (`0 | 1` → "i32"), or "" for
// anything else — a projection of the checker's own algebra (`softenLitTy`). The string base
// is excluded on purpose: a string litunion keeps its alias name as its atom identity, while
// a numeric one has none, since its members are plain i32/i64/f64 values.
export function numLitUnionBaseTy(ty: i32): i32 {
  let cur = ty
  let peels = 0
  while peels < 8 {
    if cur < 0 { return -1 }
    const t = tyAt(cur)
    let inner = -1
    if t is TyUnion {
      if t.uMembers.length == 1 { inner = t.uMembers[0] }
    }
    if inner < 0 {
      peels = 8
    } else {
      cur = inner
      peels = peels + 1
    }
  }
  if cur < 0 { return -1 }
  const soft = softenLitTy(cur)
  if soft == cur { return -1 }
  if soft < 0 { return -1 }
  const st = tyAt(soft)
  if st is TyPrim {
    const pn = st.primName
    if pn == "i32" || pn == "i64" || pn == "f64" { return soft }
  }
  -1
}

// The base as the atom: `PrimName` is a literal union, so this stays an interned atom and a
// caller's `== "i64"` is an `i32.eq`; declaring it `string` would widen it.
function numLitUnionBasePrim(ty: i32): PrimName | null {
  const b = numLitUnionBaseTy(ty)
  if b < 0 { return null }
  const bt = tyAt(b)
  if bt is TyPrim { return bt.primName }
  null
}

// The base as text — for the callers that genuinely propagate a name upward (the nominal
// renderers), where the widening belongs at that boundary rather than on every ask.
export function numLitUnionBaseName(ty: i32): string {
  primNameStr(numLitUnionBasePrim(ty))
}

// The single base numeric scalar every value of `ty` reps as at emit, or "" when not
// uniformly one of the three. The receiver side of the numeric-litunion `is` membership
// test, so it must answer for a mixed spelling like `K | i32`, which collapses to that base
// with no union box — `numLitUnionBaseName` cannot, since `softenLitTy` stops at a non-`TyLit` member.
export function tyNumScalarBaseName(ty: i32): string {
  const work: i32[] = [ty]
  let wi = 0
  let base = ""
  while wi < work.length {
    if wi >= 64 { return "" }
    const cur = work[wi]
    wi = wi + 1
    if cur < 0 { return "" }
    const t = tyAt(cur)
    let nm = ""
    let leaf = true
    match t {
      TyUnion => {
        leaf = false
        let i = 0
        while i < t.uMembers.length {
          work.push(t.uMembers[i])
          i = i + 1
        }
      }
      TyPrim => {
        nm = t.primName
      }
      TyLit => {
        nm = tyLitBaseName(t)
      }
      // No numeric scalar base: `nm` stays "" and the whole answer is "".
      TyFunc | TyObj | TyNullable | TyArray | TyMap | TyNeg | TyVar | TyErr => {}
    }
    if leaf {
      if nm != "i32" && nm != "i64" && nm != "f64" { return "" }
      if base == "" { base = nm }
      else if base != nm { return "" }
    }
  }
  base
}

// The base scalar type `ty` reps as, or `null` for anything that isn't a scalar rep — the
// kind-agnostic sibling of `tyNumScalarBaseName`. Three arena shapes rep as one base scalar
// and the emitter cannot tell them apart at a param cell: a `TyPrim`, a single-member
// `TyLit`, and a `TyUnion` of `TyLit`s over one base — the one home for this question.
export function tyScalarBasePrim(ty: i32): PrimName | null {
  let cur = ty
  let peels = 0
  while peels < 8 {
    if cur < 0 { return null }
    const t = tyAt(cur)
    match t {
      TyPrim => {
        return t.primName
      }
      TyLit => {
        return tyLitBasePrim(t)
      }
      TyUnion => {
        if t.uMembers.length == 1 {
          cur = t.uMembers[0]
          peels = peels + 1
        } else {
          // Every member a literal over one base, or this is not a scalar rep.
          let base: PrimName | null = null
          let i = 0
          while i < t.uMembers.length {
            const m = tyAt(t.uMembers[i])
            let nm: PrimName | null = null
            if m is TyLit { nm = tyLitBasePrim(m) }
            if nm == null { return null }
            if base == null { base = nm }
            else if base != nm { return null }
            i = i + 1
          }
          return base
        }
      }
      // None of these reps as one base scalar.
      TyFunc | TyObj | TyNullable | TyArray | TyMap | TyNeg | TyVar | TyErr => {
        return null
      }
    }
  }
  null
}

// The decision form — `tyIsPrimNamed`'s shape, over the peeling base. No string exists at
// any point on this path.
export function tyScalarBaseIs(ty: i32, nm: PrimName): boolean {
  tyScalarBasePrim(ty) == nm
}

// The value-atom kind of the non-null member of a `<numeric scalar> | null` arena type — `0`
// i32, `3` i64, `4` f64, `5` f32, `14` v128 — else -1. Only these reps have every bit pattern
// already taken by a real value (unlike `boolean`/`string`/litunion/struct, each of which
// has a spare bit or its own niche), so `i32 | null` is the box. A plain `TyPrim` inner only.
export function tyNulNumScalarValKind(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = tyAt(ty)
  if t is TyNullable {
    const ii = t.nInner
    if ii < 0 { return -1 }
    const it = tyAt(ii)
    if it is TyPrim {
      // Exhaustive over `PrimName` and `_`-less: `-1` (the outer return) is "not a nullable
      // numeric scalar", a real answer, so a new prim must decide here.
      match it.primName {
        "i32" => {
          return 0
        }
        "i64" => {
          return 3
        }
        "f64" => {
          return 4
        }
        "f32" => {
          return 5
        }
        "v128" => {
          return 14
        }
        "boolean" | "string" | "void" | "null" | "never" | "u8" => {
          // Not a boxed nullable numeric scalar; the outer `-1` stands.
        }
      }
    }
  }
  -1
}

// True when a nullable type's non-null member is a literal union (a singleton `TyLit`
// counts too). That rep's absence rides the `-1` sentinel below every interned atom id, not
// the `{tag, anyref}` box, so a checked list read at this rep needs the sentinel arm —
// without one the read stays unchecked and an out-of-range `.get` traps (D1281).
export function tyNulLitUnionInner(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyNullable { return tyIsLitUnionOrLit(t.nInner) }
  false
}

// True at the render positions where a literal union keeps its members — the positive half
// of the policy `tyToNameGo`'s array/object/map arms already apply. False at `RC_ROOT`,
// `RC_FN_PARAM` and `RC_FN_RES`: a container's slot really does hold the interned atom, but
// a function result is the same scalar position a declaration's return occupies.
export function ctxKeepsLitUnion(ctx: i32) {
  if (ctx & RC_ELEM) != 0 { return true }
  if (ctx & RC_FIELD) != 0 { return true }
  if (ctx & RC_MAP_VAL) != 0 { return true }
  false
}

// Does `ty` hold a record anywhere: itself, a `| null`, a union member, a list element, a map
// entry, or a function's parameter or result?
export function tyHoldsObj(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyObj => {
      return true
    }
    TyNullable => {
      return tyHoldsObj(t.nInner, depth - 1)
    }
    TyArray => {
      return tyHoldsObj(t.aElem, depth - 1)
    }
    TyMap => {
      return tyHoldsObj(t.mKey, depth - 1) || tyHoldsObj(t.mVal, depth - 1)
    }
    TyUnion => {
      for m in t.uMembers {
        if tyHoldsObj(m, depth - 1) { return true }
      }
      return false
    }
    TyFunc => {
      if tyHoldsObj(t.fnRet, depth - 1) { return true }
      for pt in t.fnParamTypes {
        if tyHoldsObj(pt, depth - 1) { return true }
      }
      return false
    }
    // A leaf holds no record.
    TyPrim | TyErr | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// `tyHoldsObj` at any depth: a record however many lists, maps or unions down. Each type is
// asked once, so a type that holds itself ends.
export function tyHoldsObjDeep(ty: i32): boolean {
  const seen: i32[] = []
  tyHoldsObjDeepIn(ty, seen)
}

function tyHoldsObjDeepIn(ty: i32, seen: i32[]): boolean {
  if ty < 0 || ty >= T.tys.length || i32ListHas(seen, ty) { return false }
  seen.push(ty)
  const t = tyAt(ty)
  match t {
    TyObj => true
    TyNullable => tyHoldsObjDeepIn(t.nInner, seen)
    TyArray => tyHoldsObjDeepIn(t.aElem, seen)
    TyMap => tyHoldsObjDeepIn(t.mKey, seen) || tyHoldsObjDeepIn(t.mVal, seen)
    TyUnion => {
      for m in t.uMembers {
        if tyHoldsObjDeepIn(m, seen) { return true }
      }
      false
    }
    TyFunc => {
      if tyHoldsObjDeepIn(t.fnRet, seen) { return true }
      for pt in t.fnParamTypes {
        if tyHoldsObjDeepIn(pt, seen) { return true }
      }
      false
    }
    // A leaf holds no record.
    TyPrim | TyErr | TyVar | TyLit | TyNeg => false
  }
}

// Does `ty` hold a list anywhere a store could reach one?
export function tyContainsList(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyArray => {
      return true
    }
    TyNullable => {
      return tyContainsList(t.nInner, depth - 1)
    }
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        if tyContainsList(t.uMembers[i], depth - 1) { return true }
        i = i + 1
      }
      return false
    }
    TyObj => {
      let i = 0
      while i < t.objFieldTypes.length {
        if tyContainsList(t.objFieldTypes[i], depth - 1) { return true }
        i = i + 1
      }
      return false
    }
    TyMap => {
      return tyContainsList(t.mKey, depth - 1)
        || tyContainsList(t.mVal, depth - 1)
    }
    TyPrim | TyErr | TyFunc | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// Membership test over a small arena-type list, by structural type identity — the second
// dedup of the same alternatives `noteHoleAlt`/`holeAltIndex` already dedup by `tyEq`,
// rather than the render-equality `tyToStr(m)` keys on: that truncates at depth and renders
// `Nullable(TyFunc)`/`TyFunc(→ Nullable)` alike, so `tyEq` decides structurally instead.
export function tyArrHasEq(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if tyEq(xs[i], v) { return true }
    i = i + 1
  }
  false
}

// A type that is still an inference hole (`TyVar`): an un-annotated param, or a derived hole.
export function tyIsHole(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = tyAt(tyIx)
  if t is TyVar { return true }
  false
}

// —— "is a hole" vs "contains a hole", and the deferred-constraint machinery needs the second ——
// `tyIsHole` answers about the type itself, so `function eqT<T>(a: T, b: T)` deferred the
// constraint while the `T[]` spelling did not — a `TyArray` over a hole is not a hole (D35).
// Depth-bounded rather than cycle-tracked, in the safe direction: a recursive named type returns false at the floor.
export function tyHasHole(tyIx: i32) { tyHasHoleAt(tyIx, 0) }

// Whether `tyIx` holds an inference hole (a `?`-named variable), not only declared parameters.
export function tyHasInferHole(tyIx: i32, depth: i32): boolean {
  if tyIx < 0 || tyIx >= T.tys.length || depth > 8 { return false }
  const t = tyAt(tyIx)
  match t {
    TyVar => {
      return t.tvName.length == 0 || t.tvName[0] == "?"[0]
    }
    TyArray => {
      return tyHasInferHole(t.aElem, depth + 1)
    }
    TyNullable => {
      return tyHasInferHole(t.nInner, depth + 1)
    }
    TyMap => {
      return tyHasInferHole(t.mKey, depth + 1)
        || tyHasInferHole(t.mVal, depth + 1)
    }
    TyObj => {
      for ft in t.objFieldTypes {
        if tyHasInferHole(ft, depth + 1) { return true }
      }
      return false
    }
    TyFunc => {
      for pt in t.fnParamTypes {
        if tyHasInferHole(pt, depth + 1) { return true }
      }
      return tyHasInferHole(t.fnRet, depth + 1)
    }
    TyUnion => {
      for m in t.uMembers {
        if tyHasInferHole(m, depth + 1) { return true }
      }
      return false
    }
    TyPrim | TyErr | TyLit | TyNeg => {
      return false
    }
  }
}

// The answer only grows as `depth` falls, so each arena index keeps the deepest `depth` known
// true and the shallowest known false, stamped with `tyMutEpoch`: a sub-type shared within one
// walk or asked again by a later one is walked once per bound.
const hhTrueAt: i32[] = []
const hhFalseAt: i32[] = []
const hhStamp: i32[] = []

function tyHasHoleAt(tyIx: i32, depth: i32): boolean {
  if tyIx < 0 { return false }
  if depth > 8 { return false }
  while hhStamp.length <= tyIx {
    hhStamp.push(-1)
    hhTrueAt.push(-1)
    hhFalseAt.push(9)
  }
  if hhStamp[tyIx] != tyMutEpoch {
    hhStamp[tyIx] = tyMutEpoch
    hhTrueAt[tyIx] = -1
    hhFalseAt[tyIx] = 9
  } else {
    if depth <= hhTrueAt[tyIx] { return true }
    if depth >= hhFalseAt[tyIx] { return false }
  }
  const r = tyHasHoleWalk(tyIx, depth)
  if r {
    if depth > hhTrueAt[tyIx] { hhTrueAt[tyIx] = depth }
  } else if depth < hhFalseAt[tyIx] {
    hhFalseAt[tyIx] = depth
  }
  r
}

function tyHasHoleWalk(tyIx: i32, depth: i32): boolean {
  const t = tyAt(tyIx)
  match t {
    TyVar => true
    TyArray => tyHasHoleAt(t.aElem, depth + 1)
    TyNullable => tyHasHoleAt(t.nInner, depth + 1)
    TyMap => {
      if tyHasHoleAt(t.mKey, depth + 1) { return true }
      tyHasHoleAt(t.mVal, depth + 1)
    }
    TyObj => {
      const ofts = t.objFieldTypes
      let i = 0
      while i < ofts.length {
        if tyHasHoleAt(ofts[i], depth + 1) { return true }
        i = i + 1
      }
      false
    }
    TyFunc => {
      const pts = t.fnParamTypes
      let k = 0
      while k < pts.length {
        if tyHasHoleAt(pts[k], depth + 1) { return true }
        k = k + 1
      }
      tyHasHoleAt(t.fnRet, depth + 1)
    }
    TyUnion => {
      const ums = t.uMembers
      let u = 0
      while u < ums.length {
        if tyHasHoleAt(ums[u], depth + 1) { return true }
        u = u + 1
      }
      false
    }
    // Leaves with no type variable, and a negation the hole never stands under.
    TyPrim | TyNeg | TyLit | TyErr => false
  }
}

// A type that definitively CANNOT be indexed `[i]`: a scalar primitive (i32 / f64 / i64 /
// f32 / boolean / null / …) — anything but a `string`. An array / string / struct (may carry
// a `"[]"` trap) / map / hole / error is NOT rejected here (it resolves or defers).
export function tyIsNonIndexableScalar(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = tyAt(tyIx)
  if t is TyPrim { return t.primName != "string" }
  false
}

// A type an indexed hole (`self[i]`, so the body demanded an array) cannot take. A
// non-indexable scalar cannot be indexed at all; a map can, but by its key and to a nullable
// value — a discipline the body's own array-typed read does not assume, so accepting a map
// here would mismatch it. Ambiguity between `i32[]` and `{[i32]: V}` is rejected rather than guessed (ROADMAP E5).
export function tyRefusesArrayDemand(tyIx: i32) {
  if tyIsNonIndexableScalar(tyIx) { return true }
  if tyIx < 0 { return false }
  const t = tyAt(tyIx)
  t is TyMap
}

// Whether an argument cannot take a hole the body writes as a list (`a.push(x)`, `a[i] = x`): a
// string, literal or not, can be indexed but not written (D6332).
export function tyRefusesArrayWrite(tyIx: i32): boolean {
  const s = softenLitTy(tyIx)
  if s < 0 || s >= T.tys.length { return false }
  const t = tyAt(s)
  t is TyPrim && t.primName == "string"
}

// A function-typed parameter, read off the arena. The demand this row parks is a FUNCTION
// value's signature; a scalar or shape parameter whose argument rides a hole is the recorded
// demand's business (`holeDemandOk`) and already reports, so parking one would say it twice.
export function tyIsFuncArena(tyIx: i32): boolean {
  if tyIx < 0 || tyIx >= T.tys.length { return false }
  const t = tyAt(tyIx)
  t is TyFunc
}

// A type whose indexing is the language's own, not a user operator's: arrays, maps, strings,
// an un-pinned inference hole, and the error type — the swallow that reaches the built-in
// arms exactly as with no operator declared. A newtype over one of these is deliberately
// included, since a brand renames a type without re-opening a primitive's syntax.
export function tyBuiltinIndexable(ty: i32) {
  if ty < 0 { return true }
  const t = tyAt(ty)
  match t {
    TyArray | TyMap | TyVar | TyErr => true
    TyPrim => t.primName == "string"
    // A user operator may index these.
    TyFunc | TyObj | TyUnion | TyNullable | TyNeg | TyLit => false
  }
}

// Whether `ty` denotes an object — the one left-operand shape `checkBinary`'s operator
// dispatch admits — looking through a one-member alias box `declaredTyOfName` otherwise keeps
// opaque for the emitter's naming (D425). The look-through happens only at the declaration:
// doing it at the call site would collapse the box the emitter's own twin still reads (D402).
export function tyDenotesObj(ty: i32) {
  if ty < 0 { return false }
  const t = tyAt(ty)
  match t {
    TyObj => true
    TyUnion => {
      if t.uMembers.length == 1 {
        const m = tyAt(t.uMembers[0])
        if m is TyObj { return true }
      }
      false
    }
    // No other shape is an object operand.
    TyPrim | TyFunc | TyNullable | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// Does arena type `ty` name the type variable `name` anywhere in its tree? The arena twin of
// `tsMentionsAnyName`, for a return type inference settled rather than one an author wrote.
// An inference hole (`?fn.N`) never matches: its name is the checker's, not a declaration's.
// Depth-bounded, and out of depth answers false — declining to refuse is the safe direction.
export function tyMentionsTyVarNamed(
  ty: i32,
  name: string,
  depth: i32,
): boolean {
  if ty < 0 { return false }
  if depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyVar => {
      return t.tvName == name
    }
    TyArray => {
      return tyMentionsTyVarNamed(t.aElem, name, depth - 1)
    }
    TyNullable => {
      return tyMentionsTyVarNamed(t.nInner, name, depth - 1)
    }
    TyNeg => {
      return tyMentionsTyVarNamed(t.negTy, name, depth - 1)
    }
    TyMap => {
      if tyMentionsTyVarNamed(t.mKey, name, depth - 1) { return true }
      return tyMentionsTyVarNamed(t.mVal, name, depth - 1)
    }
    TyObj => {
      let oi = 0
      while oi < t.objFieldTypes.length {
        if tyMentionsTyVarNamed(t.objFieldTypes[oi], name, depth - 1) {
          return true
        }
        oi = oi + 1
      }
    }
    TyUnion => {
      let um = 0
      while um < t.uMembers.length {
        if tyMentionsTyVarNamed(t.uMembers[um], name, depth - 1) { return true }
        um = um + 1
      }
    }
    TyFunc => {
      let fp = 0
      while fp < t.fnParamTypes.length {
        if tyMentionsTyVarNamed(t.fnParamTypes[fp], name, depth - 1) {
          return true
        }
        fp = fp + 1
      }
      return tyMentionsTyVarNamed(t.fnRet, name, depth - 1)
    }
    TyPrim => {}
    TyErr => {}
    TyLit => {}
  }
  false
}

// Whether type `ty` is, or holds within `depth` levels, the error type an earlier
// diagnostic produced.
export function tyMentionsErr(ty: i32, depth: i32): boolean {
  if ty < 0 { return false }
  if depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyErr => {
      return true
    }
    TyArray => {
      return tyMentionsErr(t.aElem, depth - 1)
    }
    TyNullable => {
      return tyMentionsErr(t.nInner, depth - 1)
    }
    TyNeg => {
      return tyMentionsErr(t.negTy, depth - 1)
    }
    TyMap => {
      if tyMentionsErr(t.mKey, depth - 1) { return true }
      return tyMentionsErr(t.mVal, depth - 1)
    }
    TyObj => {
      for f in t.objFieldTypes {
        if tyMentionsErr(f, depth - 1) { return true }
      }
    }
    TyUnion => {
      for m in t.uMembers {
        if tyMentionsErr(m, depth - 1) { return true }
      }
    }
    TyFunc => {
      for p in t.fnParamTypes {
        if tyMentionsErr(p, depth - 1) { return true }
      }
      return tyMentionsErr(t.fnRet, depth - 1)
    }
    TyPrim => {}
    TyVar => {}
    TyLit => {}
  }
  false
}

// Whether `t` is an un-annotated parameter's hole (`paramHoleName`), not a declared type
// parameter, whose body is checked for every instance by design.
export function tyIsParamHole(t: i32): boolean {
  if t < 0 { return false }
  const v = tyAt(t)
  if v is TyVar { return v.tvName.length > 0 && v.tvName[0] == '?' }
  false
}

// True if struct-arena entry `er` (a `TyObj`) carries a `TyMap` field directly or inside a
// nested `TyObj` field (any depth). The `structMapFieldRetName` gate.
export function tyObjHasMapField(er: i32) {
  const t = tyAt(er)
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      const ft = tyAt(t.objFieldTypes[i])
      match ft {
        TyMap => {
          return true
        }
        TyObj => {
          if tyObjHasMapField(t.objFieldTypes[i]) { return true }
        }
        // Only a direct or record-nested map field counts.
        TyPrim | TyFunc | TyUnion | TyNullable | TyArray | TyNeg | TyVar | TyLit | TyErr => {}
      }
      i = i + 1
    }
  }
  false
}

// Whether `x` is outside `print`'s domain by being a WasmGC reference: an array, a struct, a
// map/set, a function value, a union carrying one of those, and any of them behind `| null`.
// A domain rule, not a lowering gap (D711): the language has never defined how a container
// renders, not merely failed to implement it yet, and a 128-bit vector has no rendering either. A `TyVar` answers false since it has no rep yet; `validatePrintCstrs` asks again at the pin (D401).
export function tyPrintsAsRef(pt: i32, depth: i32) {
  if pt < 0 { return false }
  if depth <= 0 { return false }
  const t = tyAt(pt)
  match t {
    TyPrim => t.primName == "v128"
    TyArray | TyObj | TyMap | TyFunc => true
    TyNullable => tyPrintsAsRef(t.nInner, depth - 1)
    TyUnion => {
      const ms = t.uMembers
      let i = 0
      while i < ms.length {
        if tyPrintsAsRef(ms[i], depth - 1) { return true }
        i = i + 1
      }
      false
    }
    // No rep yet, a literal's scalar, or the error type: none is a reference.
    TyNeg | TyVar | TyLit | TyErr => false
  }
}

// Whether `er` is a union of two or more members at least one of which is a struct, declared or
// not. `valueUnionRetName` renders "" for every such union and each reps as the box, so a binding or join inferring one needs its row minted from this side
// rather than from a name nothing spells (D2373).
export function tyIsStructBearingUnion(er: i32) {
  if er < 0 { return false }
  const t = tyAt(er)
  // A nullable union is a union too: `string | A | null` interns as `TyNullable` over its
  // non-null members, and the niche holds exactly one non-null member, so two or more is the
  // same box with `null` as a member tag (D1721).
  if t is TyNullable { return tyIsStructBearingUnion(t.nInner) }
  if !(t is TyUnion) { return false }
  const ms = t.uMembers
  if ms.length < 2 { return false }
  let nObj = 0
  let i = 0
  while i < ms.length {
    // A statement `if` whose one arm yields a record joins it with `void`, which is no value.
    if ms[i] == TY_VOID { return false }
    if ms[i] >= 0 {
      const m = tyAt(ms[i])
      if m is TyObj { nObj = nObj + 1 }
    }
    i = i + 1
  }
  nObj > 0
}

// Whether a leaf of the union or nullable `er` is a literal, within `depth` levels.
export function tyHasLitLeaf(er: i32, depth: i32): boolean {
  if er < 0 || er >= T.tys.length || depth <= 0 { return false }
  const t = tyAt(er)
  match t {
    TyLit => {
      return true
    }
    TyNullable => {
      return tyHasLitLeaf(t.nInner, depth - 1)
    }
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        if tyHasLitLeaf(t.uMembers[i], depth - 1) { return true }
        i = i + 1
      }
    }
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyNeg => {
      // A leaf that is no literal, or a container whose elements are not the union's leaves.
    }
  }
  false
}

// Whether union `er` has a litunion-array member (`K0[]`, `("a"|"b")[]`) — the arm
// `litUnionArrayValueUnionRetName` exists for, decided from the arena instead of from
// `litUnionArrayElemOf` over a rendered member name.
export function tyUnionHasLitUnionArrayMember(er: i32) {
  if er < 0 { return false }
  const t = tyAt(er)
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const m = tyAt(t.uMembers[i])
      if m is TyArray {
        if tyIsLitUnion(m.aElem) { return true }
      }
      i = i + 1
    }
  }
  false
}

// Whether nullable-inner type `it` is an array of a plain `i32`/`boolean` element — the
// `T[] | null` shape that reps as the `nullist` niche and carries the `>o` value-call result
// token. A distinct-backing leaf (`i64`/`f64`/`f32`/`string`) is not this, and a litunion
// element is excluded because its lambda adoption still mis-keys the sig producers.
export function tyIsNulI32BackedListInner(itIx: i32) {
  if itIx < 0 { return false }
  const it = tyAt(itIx)
  if it is TyArray {
    if it.aElem < 0 { return false }
    const el = tyAt(it.aElem)
    match el {
      TyPrim => {
        return el.primName == "i32" || el.primName == "boolean"
      }
      // A niche-nullable boolean element (`(boolean | null)[] | null`) rides its null in the
      // shared i32 sentinel, so it keeps the same backing and this recognizes it too.
      TyNullable => {
        if el.nInner < 0 || el.nInner >= T.tys.length { return false }
        const ei = tyAt(el.nInner)
        if ei is TyPrim { return ei.primName == "boolean" }
      }
      // A composite or literal element has a backing of its own.
      TyFunc | TyObj | TyUnion | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => {}
    }
  }
  false
}

// Whether `er` is a union, or a nullable one, that a join of maps makes: two or more map types,
// which a delivery would not widen one into the other, or for an `if` one map beside any other
// member, whose binding is the box (D2666).
export function tyIsMapJoinUnion(er: i32, isIf: boolean): boolean {
  if er < 0 { return false }
  const t = tyAt(er)
  match t {
    TyNullable => {
      return tyIsMapJoinUnion(t.nInner, isIf)
    }
    TyUnion => {
      let maps = 0
      let i = 0
      while i < t.uMembers.length {
        const m = t.uMembers[i]
        if m == TY_VOID { return false }
        if m >= 0 {
          if tyAt(m) is TyMap { maps = maps + 1 }
        }
        i = i + 1
      }
      if isIf { return maps >= 1 && t.uMembers.length >= 2 }
      return maps >= 2
    }
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// Whether `ty` is the primitive `name`.
export function tyPrimNameIs(ty: i32, name: string): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyPrim { return t.primName == name }
  false
}

// Whether `ty` is a map or holds one through unions and `| null`: the cheap gate a retag
// needs, which allocates nothing.
export function tyHasMapMember(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyMap => {
      return true
    }
    TyNullable => {
      return tyHasMapMember(t.nInner, depth - 1)
    }
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        if tyHasMapMember(t.uMembers[i], depth - 1) { return true }
        i = i + 1
      }
      return false
    }
    // No other type is or holds a union member that is a map.
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// Whether `ty` is `tyEq` to one of `tys`.
export function tyAmong(ty: i32, tys: i32[]): boolean {
  let i = 0
  while i < tys.length {
    if tyEq(ty, tys[i]) { return true }
    i = i + 1
  }
  false
}

// Whether `ty` is a union every member of which is a map.
export function tyAllMaps(ty: i32): boolean {
  const s = tyAt(ty)
  if s is TyUnion {
    let i = 0
    while i < s.uMembers.length {
      const m = s.uMembers[i]
      if m < 0 || m >= T.tys.length { return false }
      if !(tyAt(m) is TyMap) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// The inner type of arena type `ty` when it is a `TyNullable` whose inner is resolved, else -1:
// `nInner` is bound-tested rather than trusted, since an unresolved inner is the hole -1 and
// `T.tys[-1]` traps (D1440).
export function tyNulInnerTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = tyAt(ty)
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return -1 }
    return t.nInner
  }
  -1
}

// Whether arena type `ty` is a `TyNullable` whose resolved inner is the primitive `p`.
export function tyNulInnerIsPrim(ty: i32, p: PrimName): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const inner = tyAt(t.nInner)
    if inner is TyPrim { return inner.primName == p }
  }
  false
}

// Whether arena type `ty` is a plain declared or inline struct: a `TyObj` that is not a variant
// member. -1 answers false.
export function tyIsPlainStructTy(ty: i32): boolean {
  if ty < 0 { return false }
  if cTyIxSetHas(cVariantMemberTyIxSet, ty) { return false }
  if cTyIxSetHas(cStructTyIxSet, ty) { return true }
  const t = tyAt(ty)
  if t is TyObj { return true }
  false
}

// The `primName` of `ty`'s array element, or "" unless `ty` is a `TyArray` whose element is a
// bare `TyPrim` — the arena twin of the `arrElemNameRaw(name) == "<scalar>"` cut, factored
// here so its consumers read one line. Deliberately unfiltered (answers `boolean` too); a
// caller that must stay narrower than the name cut applies its own whitelist.
export function tyArrayElemPrim(ty: i32): PrimName | null {
  if ty < 0 { return null }
  const t = tyAt(ty)
  if t is TyArray {
    if t.aElem >= 0 {
      const el = tyAt(t.aElem)
      if el is TyPrim { return el.primName }
    }
  }
  null
}

// The decision form — `tyIsPrimNamed`'s shape over the array element.
export function tyArrayElemPrimIs(ty: i32, nm: PrimName): boolean {
  tyArrayElemPrim(ty) == nm
}

// The element prim as text, for the one consumer that carries it onward as a name.
export function tyArrayElemPrimName(ty: i32): string {
  primNameStr(tyArrayElemPrim(ty))
}

// Whether `ty` is `string | null`. A one-literal `"x" | null` is not: its inner is the
// literal's one-member set, the atom niche (D7446).
export function tyIsNulStringRep(ty: i32): boolean {
  tyNulInnerIsPrim(ty, "string")
}

export function tyHasRepHoleAt(tyIx: i32, depth: i32) {
  if tyIx < 0 { return false }
  if depth > 8 { return false }
  const t = tyAt(tyIx)
  match t {
    TyVar => true
    TyArray => tyHasRepHoleAt(t.aElem, depth + 1)
    TyNullable => tyHasRepHoleAt(t.nInner, depth + 1)
    TyMap => {
      if tyHasRepHoleAt(t.mKey, depth + 1) { return true }
      tyHasRepHoleAt(t.mVal, depth + 1)
    }
    TyObj => {
      const ofts = t.objFieldTypes
      let i = 0
      while i < ofts.length {
        if tyHasRepHoleAt(ofts[i], depth + 1) { return true }
        i = i + 1
      }
      false
    }
    TyUnion => {
      const ums = t.uMembers
      let u = 0
      while u < ums.length {
        if tyHasRepHoleAt(ums[u], depth + 1) { return true }
        u = u + 1
      }
      false
    }
    // A `TyFunc` is deliberately not descended into — a closure parameter's rep does not
    // depend on what its own params/return contain (see `nodeTyHasRepTyVar`).
    TyFunc | TyPrim | TyNeg | TyLit | TyErr => false
  }
}

// Membership in the set `flags` indexes. Out of range answers false and never traps, which
// covers both a negative index and an arena that outgrew the set.
export function cTyIxSetHas(flags: boolean[], v: i32) {
  if v < 0 { return false }
  if v >= flags.length { return false }
  flags[v]
}

// Whether type `ty` reaches a closure — as itself, through a nullable wrapper, an array
// element, an object field, a union arm, or a map value. The arena form of
// `collectFnValUse`'s closure-field scan; wider than the name walk it replaced (itself
// alias-blind), safely so because `fnValUsed` is monotone — an extra true changes nothing.
export function tyReachesClosure(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyFunc => true
    TyNullable => tyReachesClosure(t.nInner, depth - 1)
    TyArray => tyReachesClosure(t.aElem, depth - 1)
    TyObj => {
      let i = 0
      while i < t.objFieldTypes.length {
        if tyReachesClosure(t.objFieldTypes[i], depth - 1) { return true }
        i = i + 1
      }
      false
    }
    TyUnion => {
      let j = 0
      while j < t.uMembers.length {
        if tyReachesClosure(t.uMembers[j], depth - 1) { return true }
        j = j + 1
      }
      false
    }
    TyMap => tyReachesClosure(t.mVal, depth - 1)
    // Leaves: no closure under any of these.
    TyPrim | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// The declared alias name of litunion type index `ty` (`type K = "a" | "b"` -> "K"), or "" when
// `ty` is not a registered litunion alias. Reverse of `cUserTypes` via the parallel
// `cUnionTyIxs`/`cUnionNames` arrays — pins an anonymous lambda's adopted litunion return
// as its alias (the alias reps as an i32 atom; the inline member spelling would rep as a string).
export function litUnionAliasNameOfTy(ty: i32) {
  if ty < 0 { return "" }
  if !tyIsLitUnion(ty) { return "" }
  const own = unionAliasDeclNameOfTy(ty)
  if own != "" { return own }
  // Structural fallback: an annotation position may rebuild the alias's member union at a
  // fresh arena index, so matching by member-literal set (not index) is exact, not a guess.
  const tu = tyAt(ty)
  if tu is TyUnion {
    const texts: string[] = []
    let m0 = 0
    while m0 < tu.uMembers.length {
      const mt = tyAt(tu.uMembers[m0])
      if mt is TyLit { texts.push(mt.litText) }
      m0 = m0 + 1
    }
    return litUnionAliasOfLitTexts(texts)
  }
  ""
}

// The registered litunion ALIAS whose member-literal set is EXACTLY `texts` (`["pd",
// "42"]` -> "K0"), or "" — shared by the structural fallback above and the
// flattened-member regroup in `variantBoxUnionRetName`.
export function litUnionAliasOfLitTexts(texts: string[]): string {
  const a = luPosOfTexts(texts)
  if a < 0 { return "" }
  cUnionNames[a]
}

// The same alias's arena type, or -1.
export function litUnionAliasTyOfLitTexts(texts: string[]): i32 {
  const a = luPosOfTexts(texts)
  if a < 0 { return -1 }
  cUnionTyIxs[a]
}

// —— the member-set index over registered unions ——
// `cUnionTyIxs` position of the first registered literal union per member-set key, the first
// position per arena index, and the registrations not yet indexed. A declaration registers an
// empty placeholder that pass 0b fills later, so an entry with no members yet stays pending.
export let luPosByKey: {[string]: i32} = Map()

export let luPosByTy: i32[] = []

export let luIxCursor = 0

export let luPending: i32[] = []

// The order-free key of a literal member set: its distinct texts sorted, each length-prefixed so
// no text can spell a separator.
function luSetKey(texts: string[]): string {
  const sorted: string[] = []
  let i = 0
  while i < texts.length {
    const t = texts[i]
    let dup = false
    let k = 0
    while k < sorted.length {
      if sorted[k] == t { dup = true }
      k = k + 1
    }
    if !dup {
      sorted.push(t)
      let j = sorted.length - 1
      while j > 0 && sorted[j - 1] > sorted[j] {
        const tmp = sorted[j - 1]
        sorted[j - 1] = sorted[j]
        sorted[j] = tmp
        j = j - 1
      }
    }
    i = i + 1
  }
  let key = ""
  let q = 0
  while q < sorted.length {
    key = key + i32ToStr(sorted[q].length) + ":" + sorted[q]
    q = q + 1
  }
  key
}

// The first registered literal union whose member set is exactly `texts`, as a `cUnionTyIxs`
// position, or -1.
export function luPosOfTexts(texts: string[]): i32 {
  if texts.length == 0 { return -1 }
  luIndexSync()
  luPosByKey[luSetKey(texts)] ?? -1
}

// Indexes position `a` under its member set when it is a filled literal union; true when it is
// still an empty placeholder. An earlier position displaces a later one, so a declaration that
// fills after a hidden alias of its set still comes first.
function luIndexPos(a: i32): boolean {
  const ty = cUnionTyIxs[a]
  const t = tyAt(ty)
  if t is TyUnion {
    if t.uMembers.length == 0 { return true }
  }
  if !tyIsLitUnion(ty) { return false }
  const key = luSetKey(tyLitMemberTexts(ty))
  const cur = luPosByKey[key] ?? -1
  if cur < 0 || a < cur { luPosByKey[key] = a }
  false
}

function luIndexSync() {
  if luIxCursor == cUnionTyIxs.length && luPending.length == 0 { return 0 }
  const still: i32[] = []
  let p = 0
  while p < luPending.length {
    if luIndexPos(luPending[p]) { still.push(luPending[p]) }
    p = p + 1
  }
  while luIxCursor < cUnionTyIxs.length {
    const a = luIxCursor
    const ty = cUnionTyIxs[a]
    while luPosByTy.length <= ty { luPosByTy.push(-1) }
    if luPosByTy[ty] < 0 { luPosByTy[ty] = a }
    if luIndexPos(a) { still.push(a) }
    luIxCursor = luIxCursor + 1
  }
  luPending = still
  0
}

// The atom width of the last `litUnionInlineNameOfTy` answer, and whether that union
// carried a `null` member — the arena twin of canon's `lupAtoms` / `nulLitUnionPreserve`'s
// `hasNull`. Banked rather than returned because a VL function has one result.
let luiAtoms = 1

let luiHasNull = false

// The inline spelling of the string-literal run of union `ty`, from its arena members
// (`"a"|"b"`), or "" when `ty` is not a string-literal union — the un-aliased sibling of
// `litUnionAliasNameOfTy` and the arena twin of canon's `litUnionPreserve`. A `null` member
// does not disqualify the run; `luiHasNull` reports whether the caller's union carried one.
export function litUnionInlineNameOfTy(ty: i32): string {
  luiAtoms = 1
  luiHasNull = false
  if ty < 0 { return "" }
  const t = tyAt(ty)
  if t is TyUnion {
    const texts: string[] = []
    let sawNull = false
    let i = 0
    while i < t.uMembers.length {
      const m = tyAt(t.uMembers[i])
      if m is TyLit {
        if m.litKind != "str" { return "" }
        let dup = false
        let d = 0
        while d < texts.length {
          if texts[d] == m.litText { dup = true }
          d = d + 1
        }
        if !dup { texts.push(m.litText) }
      } else if m is TyPrim {
        if m.primName != "null" { return "" }
        sawNull = true
      } else {
        return ""
      }
      i = i + 1
    }
    // One literal beside `null` is its one-member set's atom niche, kept as well (D7446).
    if texts.length < 2 && !(sawNull && texts.length == 1) { return "" }
    luiHasNull = sawNull
    const al = litUnionAliasOfLitTexts(texts)
    if al != "" {
      // An alias name is one identifier — one atom.
      luiAtoms = 1
      return al
    }
    // A quoted member holds no top-level `|` of its own, so the join writes exactly
    // `texts.length - 1` separators — canon's `lupAtoms = kept.length`.
    let out = "\"" + texts[0] + "\""
    let k = 1
    while k < texts.length {
      out = out + "|\"" + texts[k] + "\""
      k = k + 1
    }
    luiAtoms = texts.length
    return out
  }
  ""
}

// Whether `ty` is a REGISTERED literal union: a declared alias or an annotated inline set. Every
// string literal union reps as the atom (`tyIsLitUnion`); this narrower test serves node
// consumers whose producer may still deliver a string ref, such as a generic instance whose
// pin softened a single literal to `string` (D2827).
export function tyIsLitUnionAlias(ty: i32): boolean {
  if ty < 0 { return false }
  if !cTyIxSetHas(cUnionTyIxSet, ty) { return false }
  tyIsLitUnion(ty)
}

// Structural type equality over the arena, depth-bounded: two indices are the same type when
// their rows have the same variant and their components are recursively the same. The arena
// is an append log, so index equality is construction identity, not type identity — not a
// replacement for index equality where identity is nominal (a declared union's is its declaration).
export function tySame(a: i32, b: i32): boolean { tySameAt(a, b, 24) }

function tySameAt(a: i32, b: i32, depth: i32): boolean {
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  if depth <= 0 { return false }
  const x = tyAt(a)
  const y = tyAt(b)
  match x {
    TyPrim => {
      match y {
        TyPrim => {
          return x.primName == y.primName
        }
        TyErr | TyObj | TyFunc | TyUnion | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {
          return false
        }
      }
    }
    TyArray => {
      match y {
        TyArray => {
          return tySameAt(x.aElem, y.aElem, depth - 1)
        }
        TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyNullable | TyMap | TyVar | TyLit | TyNeg => {
          return false
        }
      }
    }
    TyNullable => {
      match y {
        TyNullable => {
          return tySameAt(x.nInner, y.nInner, depth - 1)
        }
        TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyArray | TyMap | TyVar | TyLit | TyNeg => {
          return false
        }
      }
    }
    TyUnion => {
      match y {
        TyUnion => {
          if x.uMembers.length != y.uMembers.length { return false }
          let i = 0
          while i < x.uMembers.length {
            if !tySameAt(x.uMembers[i], y.uMembers[i], depth - 1) {
              return false
            }
            i = i + 1
          }
          return true
        }
        TyPrim | TyErr | TyObj | TyFunc | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {
          return false
        }
      }
    }
    // Compares fields by name set, not position (`{a,b}` and `{b,a}` are the same type) — safe by
    // construction since field names within one object are unique, making a name-keyed lookup exact.
    TyObj => {
      match y {
        TyObj => {
          if x.objFieldNames.length != y.objFieldNames.length { return false }
          let f = 0
          while f < x.objFieldNames.length {
            let hit = false
            let g = 0
            while g < y.objFieldNames.length {
              if y.objFieldNames[g] == x.objFieldNames[f] {
                if tySameAt(x.objFieldTypes[f], y.objFieldTypes[g], depth - 1) {
                  hit = true
                }
              }
              g = g + 1
            }
            if !hit { return false }
            f = f + 1
          }
          return true
        }
        TyPrim | TyErr | TyFunc | TyUnion | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {
          return false
        }
      }
    }
    TyMap => {
      match y {
        TyMap => {
          if x.mSet != y.mSet { return false }
          if !tySameAt(x.mKey, y.mKey, depth - 1) { return false }
          return tySameAt(x.mVal, y.mVal, depth - 1)
        }
        TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyNullable | TyArray | TyVar | TyLit | TyNeg => {
          return false
        }
      }
    }
    // A FUNCTION member: same parameter list and same result. Unions of closures
    // (`((i32)=>i32) | ((i32)=>string)`) are ordinary inline unions and reach here.
    TyFunc => {
      match y {
        TyFunc => {
          if x.fnParamTypes.length != y.fnParamTypes.length { return false }
          let q = 0
          while q < x.fnParamTypes.length {
            if !tySameAt(x.fnParamTypes[q], y.fnParamTypes[q], depth - 1) {
              return false
            }
            q = q + 1
          }
          return tySameAt(x.fnRet, y.fnRet, depth - 1)
        }
        TyPrim | TyErr | TyObj | TyUnion | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {
          return false
        }
      }
    }
    // An error, a type variable, a literal or a negation is the same only as its own index.
    TyErr | TyVar | TyLit | TyNeg => {}
  }
  false
}

// Whether a type bears null — structurally, without rendering it and splitting on `|`. Two
// shapes, and missing the first is the trap this replaced: a `TyNullable` over a scalar bears
// null exactly as a `TyUnion` with a null member does, so a predicate that only walked
// `uMembers` answered false for `i32 | null`, leaving a `return null` unboxed.
export function tyBearsNull(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  match t {
    TyNullable => true
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        const mi = t.uMembers[i]
        const m = tyAt(mi)
        if m is TyPrim {
          if m.primName == "null" { return true }
        }
        // Recurses into nested union/nullable members (the arena nests them, e.g. `i32 | (string |
        // null)`) — but not into an array/object member, which is a leaf here just as it is there.
        if tyBearsNull(mi) { return true }
        i = i + 1
      }
      false
    }
    // A bare `null` is a member's question, asked by the union arm; the rest hold no null.
    TyPrim | TyFunc | TyObj | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// The one member a union holds when every member is that type (`A | B` with `A` ≡ `B`), else
// -1. Such a union is that member at every position, so nothing boxes it. A record member keeps
// its union's variant arms, which are nominal, so a union of records never answers.
export function unionSoleMember(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  if !(t is TyUnion) { return -1 }
  if t.uMembers.length == 0 { return -1 }
  const m0 = t.uMembers[0]
  if t.uMembers.length == 1 { return m0 }
  if m0 < 0 { return -1 }
  let p = m0
  const pt = tyAt(p)
  if pt is TyUnion {
    if pt.uMembers.length == 1 { p = pt.uMembers[0] }
  }
  if p < 0 || tyAt(p) is TyObj { return -1 }
  for m in t.uMembers {
    if !tyEq(m, m0) { return -1 }
  }
  m0
}

// The one list a union of 2+ lists renders as when every member spells it, nominally too
// (`i32[] | K[]` over a numeric literal union `K`, not `Rec[] | Rec2[]`), else "". Such a union
// is that list at every position, never a box: an `is` has nothing to tell its members by (D4743).
// A string-literal-union leaf never merges with another leaf, since its ids read as integers (D4906).
export function oneListUnionRender(ty: i32): string {
  if ty < 0 || ty >= T.tys.length { return "" }
  const t = tyAt(ty)
  if !(t is TyUnion) { return "" }
  if t.uMembers.length < 2 { return "" }
  for m in t.uMembers {
    if m < 0 { return "" }
    if !(tyAt(m) is TyArray) { return "" }
  }
  // Both renders write the renderer's globals, which a caller mid-render still reads.
  const atoms0 = tyNameAtoms
  const cyc0 = nomNameCycle
  const nom0 = tyToNominalName(t.uMembers[0])
  const atom0 = tyListLeafIsStrLitUnion(t.uMembers[0])
  let same = nom0 != ""
  for m in t.uMembers {
    if same && tyToNominalName(m) != nom0 { same = false }
    if tyListLeafIsStrLitUnion(m) != atom0 { same = false }
  }
  let r = ""
  if same {
    r = tyToEmitName(ty)
    if tyNameAtoms != 1 { r = "" }
  }
  tyNameAtoms = atoms0
  nomNameCycle = cyc0
  r
}

// Whether the list `ty`'s innermost element, its `| null` aside, is a string literal set: an
// atom id where an `i32[]` holds a number, so the two never share one list (D4906).
function tyListLeafIsStrLitUnion(ty: i32): boolean {
  let cur = ty
  let d = 0
  while cur >= 0 && cur < T.tys.length && d < 64 {
    const t = tyAt(cur)
    if !(t is TyArray) { break }
    cur = t.aElem
    d = d + 1
  }
  if cur < 0 || cur >= T.tys.length { return false }
  const leaf = tyAt(cur)
  if leaf is TyNullable { cur = leaf.nInner }
  if cur < 0 { return false }
  const lt = tyAt(cur)
  if lt is TyLit { return lt.litKind == "str" }
  tyIsLitUnion(cur)
}

// How a value of list arm `a` fits the list type `chk` when the two keep their elements in
// different reps: 1 always (a list of string literals tested as `string[]`), 2 when every
// element is a member (a `string[]` tested as a list of string literals), 0 otherwise (D4779).
export function listArmFitAcrossReps(a: i32, chk: i32): i32 {
  const ae = tyArrayElemIx(a)
  const ce = tyArrayElemIx(chk)
  if ae < 0 || ce < 0 { return 0 }
  if tyIsLitUnion(ae) && tyIsPrimNamed(ce, "string") { return 1 }
  if tyIsPrimNamed(ae, "string") && tyIsLitUnion(ce) { return 2 }
  0
}

// —— arena-level (Ty-index-keyed) nominal queries ——————————————————————————
// The emitter's `repOf` descriptor derivation classifies types (`Ty`-arena indices), where the
// `nodeTy*` twins above classify a node's recorded type. These expose only the
// checker-private nominal-identity sidecar sets that a structural walk cannot re-derive.
export function tyIxIsVariantMember(ty: i32) {
  if ty < 0 { return false }
  cTyIxSetHas(cVariantMemberTyIxSet, ty)
}

// The nested-array element gate: true when a nested-array element (the `i32[]` in `i32[][]`)
// has a render at all. Asked by both `nodeArrayElemName`'s nested arm and
// `arrLitNestedElemName`'s interning decision, so the annotation and the intern agree on the
// same leaf set (D702).
export function tyNestedArrLeafRenders(elemTy: i32): boolean {
  if elemTy < 0 { return false }
  const el = tyAt(elemTy)
  if el is TyArray {
    if el.aElem < 0 { return false }
    return tyToEmitName(elemTy) != ""
  }
  false
}

// Whether `ty` carries a literal anywhere in its member tree, so its `RC_ROOT` emit render is
// lossy: `ctxKeepsLitUnion` is false at `RC_ROOT`, so `"pp" | "qq"`, `1 | 2` and `K | string`
// all render as the base scalar their members soften to. Two such types render alike without
// denoting the same value set, so any equality test over `tyToEmitName` must decline them.
export function tyRenderSoftensLits(ty: i32) { tyRenderSoftensLitsGo(ty, 8) }

function tyRenderSoftensLitsGo(ty: i32, depth: i32) {
  if ty < 0 || depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyLit => true
    TyUnion => {
      const ms = t.uMembers
      let i = 0
      while i < ms.length {
        if tyRenderSoftensLitsGo(ms[i], depth - 1) { return true }
        i = i + 1
      }
      false
    }
    // Softening happens only at a union's members; a literal under these keeps its render.
    TyPrim | TyFunc | TyObj | TyNullable | TyArray | TyMap | TyNeg | TyVar | TyErr => false
  }
}

// `tyIsLitUnion` including its one-member spelling — a bare string `TyLit`, which is not a
// `TyUnion` and so answers no there. Deliberately a second predicate rather than a widening of
// `tyIsLitUnion`, which decides the rep of a declared type at a dozen sites where a bare
// `"aa"` annotation reps as a real string today. Only the conversion seam asks this one.
export function tyIsLitUnionOrLit(ty: i32) {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyLit { return t.litKind == "str" }
  tyIsLitUnion(ty)
}

// Whether `ty` is a union whose members are all string-literal types (`"a" | "b"`) — a
// "literal union", which the emitter lowers as an interned i32 atom, one id per member string.
export function tyIsLitUnion(ty: i32) {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyUnion {
    if t.uMembers.length < 1 { return false }
    let i = 0
    while i < t.uMembers.length {
      const m = tyAt(t.uMembers[i])
      if m is TyLit {
        if m.litKind != "str" { return false }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}

// Whether type-arena entry `ty` is an array whose element is a literal union (`K[]`, an
// inline `("a"|"b")[]`) — `nameIsLitUnionArray`'s structural dual. Exactly one `TyArray` hop is
// taken; a 2-D `K[][]`, a `(K | null)[]`, and a `("a"|"b"|null)[]` all answer false here just
// as the name path does.
export function tyIsLitUnionArray(ty: i32) {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyArray {
    const r = tyIsLitUnion(t.aElem)
    return r
  }
  false
}

// Whether `ti` is a `TyMap` whose value — at any map-nesting depth, one nullable wrapper
// peeled per level — is a literal union. The map-value usage arm of `anyLitUnionUsed`.
export function tyMapValIsLitUnion(ti: i32, depth: i32): boolean {
  if ti < 0 || depth <= 0 { return false }
  const t = tyAt(ti)
  if t is TyMap {
    let v = t.mVal
    if v < 0 { return false }
    const vt = tyAt(v)
    if vt is TyNullable { v = vt.nInner }
    if v < 0 { return false }
    if tyIsLitUnion(v) { return true }
    return tyMapValIsLitUnion(v, depth - 1)
  }
  false
}

// Whether type `ty` is a nullable literal union — either the two-part form `K | null` (a
// `TyNullable` over a litunion) or the expanded member form `"a" | "b" | null` (a `TyUnion`
// with a null member and every other member a string literal). Both must classify as the atom
// niche, since an adopted annotation gives one form and an inferred element type the other.
export function tyIsNullableLitUnion(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  match t {
    TyNullable => tyIsLitUnion(t.nInner)
    TyUnion => {
      if t.uMembers.length < 2 { return false }
      let sawNull = false
      let sawLit = false
      let i = 0
      while i < t.uMembers.length {
        const m = tyAt(t.uMembers[i])
        match m {
          TyPrim => {
            if m.primName != "null" { return false }
            sawNull = true
          }
          TyLit => {
            if m.litKind != "str" { return false }
            sawLit = true
          }
          // Any other member is no literal-union atom.
          TyFunc | TyObj | TyUnion | TyNullable | TyArray | TyMap | TyNeg | TyVar | TyErr => {
            return false
          }
        }
        i = i + 1
      }
      sawNull && sawLit
    }
    // Only a nullable or a union can be a nullable literal union.
    TyPrim | TyFunc | TyObj | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// Whether a literal union reps as one i32 cell: an all-string union (interned atoms) or an
// all-numeric one whose single base is `i32`. No `f32` arm: `litBaseTy` never answers `f32` for
// a pure literal union, so this predicate cannot be asked about one. An `i64`/`f64`-based union
// is a different wrapper and must NOT match, or `+` writes a module the engine refuses (D102).
export function tyLitUnionIsI32Backed(ty: i32): boolean {
  if tyIsLitUnion(ty) { return true }
  numLitUnionBaseName(ty) == "i32"
}

// Whether array-element type `ty` is a niche-nullable scalar the emitter reps without a box —
// `K | null` (litunion atom, sentinel `-1`), `boolean | null` (sentinel 2), `string | null`
// (`(ref null $sTypeIdx)`). Gates the ArrayLit context-adoption recording: a literal accepted
// by such an element target is the niche list.
export function tyIsNicheNulScalarElem(ty: i32): boolean {
  if tyIsNullableLitUnion(ty) { return true }
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const inn = tyAt(t.nInner)
    if inn is TyPrim {
      return inn.primName == "boolean" || inn.primName == "string"
    }
  }
  false
}

// The member literal texts (raw lexeme, no quotes) of atom-repped type `ty`, in source order:
// every string-literal member of a union, or the single text of a bare literal type. Empty for
// anything else, including a nullable (`K | null`) — the null arm has no member text, so a
// caller reading an empty list off a nullable must say so, not emit a chain matching nothing.
export function tyLitMemberTexts(ty: i32) {
  const out: string[] = []
  if ty < 0 { return out }
  const t = tyAt(ty)
  match t {
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        const m = tyAt(t.uMembers[i])
        if m is TyLit {
          if m.litKind == "str" { out.push(m.litText) }
        }
        i = i + 1
      }
    }
    TyLit => {
      if t.litKind == "str" { out.push(t.litText) }
    }
    // No member text: a nullable included, as the contract above says.
    TyPrim | TyFunc | TyObj | TyNullable | TyArray | TyMap | TyNeg | TyVar | TyErr => {}
  }
  out
}

export function tyReachesMap(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  match t {
    TyMap => true
    TyNullable => tyReachesMap(t.nInner)
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        if tyReachesMap(t.uMembers[i]) { return true }
        i = i + 1
      }
      false
    }
    // Not descended: a map under a field, element or closure is that slot's own.
    TyPrim | TyFunc | TyObj | TyArray | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// Whether arena type `ty` is a map or a set (`{[K]: V}`, `Set<K>`).
export function tyIsMap(ty: i32) {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  t is TyMap
}

// Whether arm pattern type `pt` is a composite (a union or a nullable) rather than one
// variant. An arm tests its type with a single `is`, and `x is A | B` is a shape the emitter
// does not lower, so a pattern resolving to one is rejected at the pattern, with the spelling
// that does work named.
export function tyIsCompositePat(pt: i32) {
  const t = tyAt(pt)
  match t {
    TyUnion | TyNullable => true
    // One variant each, which a single `is` tests.
    TyPrim | TyFunc | TyObj | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => false
  }
}

// Whether `ty` is exactly one string literal: a bare `"z"`, or a literal union of one member.
// A value of it is known at compile time, so a compare against it needs no read.
export function tyIsOneStrLit(ty: i32): boolean {
  if !tyIsLitUnionOrLit(ty) { return false }
  tyLitMemberTexts(ty).length == 1
}

// The quoted spelling of `ty` when it is exactly one string literal, else "".
export function oneStrLitSpelling(ty: i32): string {
  if !tyIsOneStrLit(ty) { return "" }
  "\"" + tyLitMemberTexts(ty)[0] + "\""
}

// ── type-arena constructors ──────────────────────────────────────────────────
// Each appends a variant to `T.tys` and returns its index — the same shape as the AST's `mk*`
// constructors, for the parallel arena.

export function addTy(t: Ty) {
  T.tys.push(t)
  T.tys.length - 1
}

export function mkPrim(name: PrimName) {
  const t: Ty = { primName: name }
  addTy(t)
}

export function mkErrTy() {
  const t: Ty = { errKind: 0 }
  addTy(t)
}

export function mkObjTy(names: string[], typeIxs: i32[]) {
  const t: Ty = { objFieldNames: names, objFieldTypes: typeIxs }
  addTy(t)
}

export function mkFuncTy(params: i32[], ret: i32) {
  const t: Ty = { fnParamTypes: params, fnRet: ret }
  addTy(t)
}

export function mkNullableTy(inner: i32) {
  // D1026 — nullable is idempotent: `(T | null) | null` is `T | null`, and `null | null` is
  // `null`. The language has no second null, so both are artefacts of composing a type that
  // already holds `null`, and folding at this one home keeps each spelling one type.
  if inner >= 0 {
    const innerT = tyAt(inner)
    if innerT is TyNullable { return inner }
    if innerT is TyPrim {
      if innerT.primName == "null" { return inner }
    }
  }
  if tyIsWidePrim(inner) { tyWideUnionMinted = true }
  const t: Ty = { nInner: strLitAsSet(inner) }
  addTy(t)
}

export function mkArrayTy(elem: i32) {
  const t: Ty = { aElem: strLitAsSet(elem), aRead: 0 }
  addTy(t)
}

// A list element, map value or nullable inner of one string literal is its one-member set, so
// `"a"[]` and `"a" | null` are `K[]` and `K | null` over `type K = "a"`, one atom (D7340, D7446).
export function strLitAsSet(elem: i32): i32 {
  if elem < 0 || elem >= T.tys.length { return elem }
  const t = tyAt(elem)
  if t is TyLit {
    if t.litKind == "str" {
      const u: Ty = { uMembers: [elem] }
      return addTy(u)
    }
  }
  elem
}

// `ty | null`, for an emit-side rewrite that needs a box over a value with no niche (D2826).
export function mkNullableTyOf(ty: i32) { mkNullableTy(ty) }

// The read-only view over the same element (`readonly T[]`). A sibling constructor rather
// than a flag on `mkArrayTy`, so every existing mint stays a mutable list by construction.
export function mkArrayViewTy(elem: i32) {
  const t: Ty = { aElem: strLitAsSet(elem), aRead: 1 }
  addTy(t)
}

export function mkMapTy(key: i32, val: i32, isSet: i32) {
  tyMapMinted = true
  const t: Ty = { mKey: key, mVal: strLitAsSet(val), mSet: isSet }
  addTy(t)
}

// Whether any map type has been minted in this instance. Only ever set, so a gate on it can
// skip work, never a map (`mapDeliveryMayRecord`).
export let tyMapMinted = false

// Whether any union or `| null` with an `i64` or `f64` member has been minted: the same kind of
// gate for a delivery a narrower member widens into (`recordWidenRetag`).
export let tyWideUnionMinted = false

// The canonical decimal form of an integer literal lexeme (`0x10` → `16`, `1_000` → `1000`,
// `007` → `7`), so literal-type identity compares values rather than raw spellings and `0x10` is
// a member of `16 | 32`. A lexeme whose value exceeds the i32 range keeps its raw spelling, an
// i64-sized literal never denoting a literal-union member.
export function canonIntLexeme(t: string) {
  if !numLexFitsI32(t) { return t }
  // Plain decimal digits with no leading zero are already the canonical form.
  let plain = t.length == 1 || (t.length > 1 && t[0] != '0')
  let j = 0
  while plain && j < t.length {
    if t[j] < '0' || t[j] > '9' { plain = false }
    j = j + 1
  }
  if plain { return t }
  let v = 0
  let i = 0
  const base = numLexBaseAt(t, 0)
  if base != 10 { i = 2 }
  while i < t.length {
    const c = t[i]
    if c != '_' {
      let d = 0
      if c >= '0' && c <= '9' { d = c - '0' }
      else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
      else { d = c - 'A' + 10 }
      v = v * base + d
    }
    i = i + 1
  }
  i32ToStr(v)
}

// The literal type of `kind` and `text`, interned, so one literal is one arena index (D14540).
export function mkLitTy(kind: LitKind, text: string) {
  let canon = text
  if kind == "int" { canon = canonIntLexeme(text) }
  internLitTy(kind, canon, false)
}

// The one producer of `TyLit` rows, keyed on kind, canonical text and the widening bit.
function internLitTy(kind: LitKind, canon: string, wide: boolean): i32 {
  let key = kind + ":" + canon
  if wide { key = "w" + key }
  const hit = litTyIntern.get(key) ?? -1
  if hit >= 0 { return hit }
  if wide { wideLitMinted = true }
  const t: Ty = { litKind: kind, litText: canon, litWide: wide }
  const ix = addTy(t)
  litTyIntern.set(key, ix)
  ix
}

// `ty` with its widening bit set to `wide` when it is a literal type, else `ty` itself.
export function litWithWide(ty: i32, wide: boolean): i32 {
  if ty < 0 || ty >= T.tys.length { return ty }
  const t = tyAt(ty)
  if t is TyLit {
    if t.litWide == wide { return ty }
    return internLitTy(t.litKind, t.litText, wide)
  }
  ty
}

// The declared form of `ty`: a widening literal's twin without the bit; any other type itself.
export function litRegularTy(ty: i32): i32 { litWithWide(ty, false) }

// Whether `ty` is a widening literal: a `const` inferred it and nobody declared it.
export function isWideLitTy(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyLit { return t.litWide }
  false
}

// The arena index of each literal type, by its `internLitTy` key; reset with the arena.
export let litTyIntern: {[string]: i32} = Map()

// Whether this arena holds any widening literal; `widenLitTy` skips its walk when not.
export let wideLitMinted = false

// The arena type of one literal-member lexeme — `"a"` → the `str` literal type, `0x10` → `int`
// — or -1 when `name` is not a literal member (a float lexeme is none: `floatLitTypeMsg`). The one home for
// that lexeme grammar, so `nameToTy`'s annotation resolver and `canonEmitName`'s literal arm both
// ask for the type and let the renderer name it rather than each carrying the rule.
export function litMemberTy(name: string) {
  if name.length == 0 { return -1 }
  // A string-literal type `"a"`: the quoted lexeme is the member, and the raw inner text is kept,
  // since the literal expression side keeps its raw lexeme too and membership compares the same
  // characters. The quote test (`tyname.nameIsQuotedWhole`) stays here because the group-interior
  // cut at its home is delimiter-blind by design; its bound is the length test two lines up.
  if nameIsQuotedWhole(name) { return mkLitTy("str", groupInnerOf(name)) }
  // An integer-literal type (`0`, `0x10`). A float lexeme (`1.5`, `1e3`) names no type.
  if name[0] >= '0' && name[0] <= '9' {
    if numLexIsFloat(name) { return -1 }
    return mkLitTy("int", name)
  }
  -1
}

export function mkNegTy(inner: i32) {
  const t: Ty = { negTy: inner }
  addTy(t)
}

// Strip every `$m<digits>` module-merge and `$b<digits>` block-scope mangle suffix from a free-form
// diagnostic message: the merge renames a module's declarations and the parser renames a
// body-scoped `type` (D1045), both internal names that must not surface. The two suffixes compose,
// and the scan handles that by restarting after the digits. One home, in `tyname.demangleSpelling`.
export function demangleMsg(s: string) {
  inlineLitUnionUnhide(demangleSpelling(s))
}

// Replaces each hidden inline-literal-union alias (`#lu3`) in a message with its member set,
// parenthesized before an array suffix, so a canon-rendered spelling reads as the source does.
// A closed quoted segment is a user's literal text, copied as written (D11850).
function inlineLitUnionUnhide(s: string): string {
  let h = 0
  while h < s.length && s[h] != '#' { h = h + 1 }
  if h == s.length { return s }
  let out = ""
  let i = 0
  while i < s.length {
    const q = if s[i] == '"' { closedQuoteEnd(s, i) } else { -1 }
    if q > 0 {
      out = out + s.slice(i, q)
      i = q
    } else if (
      s[i] == '#'
      && i + 3 < s.length
      && s.slice(i, i + 3) == inlineLitUnionPrefix
    ) {
      let j = i + 3
      while j < s.length && s[j] >= '0' && s[j] <= '9' { j = j + 1 }
      const hit = cUserTypes[s.slice(i, j)]
      if j > i + 3 && hit is i32 {
        let r = tyToStructStr(hit)
        if j < s.length && s[j] == '[' { r = "(" + r + ")" }
        out = out + r
        i = j
      } else {
        out = out + s.slice(i, i + 1)
        i = i + 1
      }
    } else {
      out = out + s.slice(i, i + 1)
      i = i + 1
    }
  }
  out
}

export const inlineLitUnionPrefix = "#lu"

// —— the user-facing render pathway (demangle → render) ——
// Every type string a person reads is rendered here and nowhere else, since the module
// merge renames every declaration `name` → `name$mN` and a raw render would leak it.
// `tyToStr`/`tyToStructStr` stay raw, since those strings are spelling-dependent table keys.
export function tyToStrUser(ix: i32) { demangleMsg(tyToStr(ix)) }

export function tyToStructStrUser(ix: i32) { demangleMsg(tyToStructStr(ix)) }
