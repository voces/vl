// `compiler/tyname.vl` — the type-name grammar, and nothing else. A rendered type name
// is a bracket language the parser writes and later passes read back: `{x:i32}` shape,
// `{[K]:V}` map, `T[]` array, `(…)` group and param list, `Head<A,B>` generic
// application, `"a"` literal member, the separators `|` `&` `,` `:` and the arrow `=>`.
// Every question asked of it — where a group opens, whether it spans the whole name,
// where it closes, what the element, key or value is — lives only here.
//
// The module is a leaf with zero imports, and that is its whole contract: every body
// below is a pure function of a string, with no type arena, no node arena, no
// diagnostics and no module state, so nothing here can observe the program being
// compiled or be reached by an import cycle. Every consumer imports it directly; an
// `export … from "./tyname"` line elsewhere is a regression.

// Skip a quoted string-literal segment inside a synthetic type name, the cursor on the
// opening `"`: the index just past the closing quote, `\` escaping the next char. Every
// depth-aware scanner here calls it so a literal member's characters never count as
// separators; an unterminated segment ends at `name.length`, so a span copy is total.
export function skipQuotedName(name: string, start: i32) {
  let i = start + 1
  while i < name.length {
    const c = name[i]
    if c == '\\' { i = i + 2 }
    else if c == '"' { return i + 1 }
    else { i = i + 1 }
  }
  i
}

// Is this type-name atom a string-literal member — `"a"` of `"a"|"b"`, the `is` right
// side of `v is "a"`. `skipQuotedName` owns where a quoted segment ends; this owns where
// one begins. No length guard by design: VL string indexing traps out of bounds where
// `.slice` clamps, and the callers do not agree on which bound they want in front.
export function nameIsQuotedLeaf(name: string) { name[0] == '"' }

// The identifier character class of a rendered type name: `[A-Za-z0-9_]`. Digits are in
// (a run is `i32`, `f64`, `K0`), which makes it a different set from the lexer's
// identifier-start class. `driver.modTypeRenamed` is the one body that walks a name as
// runs, taking the class from here and the quoted-member skip from `skipQuotedName`.
export function nameIdentChar(c: i32) {
  if c >= 'a' && c <= 'z' { return true }
  if c >= 'A' && c <= 'Z' { return true }
  if c >= '0' && c <= '9' { return true }
  c == '_'
}

// The bare-identifier test: every character of `name` an identifier character, with a
// non-digit first. It is the negative of every composite arm at once — a name reaching
// the end of this loop holds no `|`, `&`, `!`, `(`, `[`, `{`, `<`, `:`, `,`, `=`, space
// or quote. `$` is in (a merged declaration is `Point$m2`); a leading digit is out.
export function nameIsBareIdent(name: string) {
  const n = name.length
  if n == 0 { return false }
  let i = 0
  while i < n {
    const c = name[i]
    const isLower = c >= 97 && c <= 122
    const isUpper = c >= 65 && c <= 90
    const isDigit = c >= 48 && c <= 57
    if !(isLower || isUpper || isDigit || c == 95 || c == 36) { return false }
    if i == 0 && isDigit { return false }
    i = i + 1
  }
  true
}

// Does the spelling `name` contain `id` as a whole identifier, not as a substring of a
// longer one? `K` is mentioned by `{a: K[]}` and by `K | null`, and not by `Kind` or
// `myK`. The boundary on each side is the character class `nameIsBareIdent` walks.
export function nameMentionsIdent(name: string, id: string) {
  const n = name.length
  const m = id.length
  if m == 0 { return false }
  if n < m { return false }
  let i = 0
  while i + m <= n {
    let hit = true
    let j = 0
    while j < m {
      if name[i + j] != id[j] { hit = false }
      j = j + 1
    }
    if hit {
      let okL = true
      if i > 0 {
        const c = name[i - 1]
        const l = c >= 97 && c <= 122
        const u = c >= 65 && c <= 90
        const d = c >= 48 && c <= 57
        if l || u || d || c == 95 || c == 36 { okL = false }
      }
      let okR = true
      if i + m < n {
        const c2 = name[i + m]
        const l2 = c2 >= 97 && c2 <= 122
        const u2 = c2 >= 65 && c2 <= 90
        const d2 = c2 >= 48 && c2 <= 57
        if l2 || u2 || d2 || c2 == 95 || c2 == 36 { okR = false }
      }
      if okL && okR { return true }
    }
    i = i + 1
  }
  false
}

// Does `name` contain no space at all — the assertion half of the space-free rule. The
// two renderers disagree: `tyToStr` spaces a shape (`{a: i32}`) for diagnostics and
// `tyToEmitName` renders it tight (`{a:i32}`) for the `sNames` intern keys, so a space is
// the tell that a name came from the wrong renderer. `nameStripSpaces` enforces it.
export function nameIsSpaceFree(name: string) {
  let i = 0
  while i < name.length {
    if name[i] == ' ' { return false }
    i = i + 1
  }
  true
}
// `name` with every space dropped — the enforcement half of the space-free rule. It
// returns `name` itself when there is nothing to drop, so the majority carrying no space
// pay no allocation: the scan runs first and the rebuild starts from `name.slice(0, i)`
// at the first space. It counts no brackets and asks nothing about structure.
export function nameStripSpaces(name: string) {
  let i = 0
  while i < name.length {
    if name[i] == ' ' {
      let out = name.slice(0, i)
      let j = i
      while j < name.length {
        if name[j] != ' ' { out = out + fromCodePoint(name[j]) }
        j = j + 1
      }
      return out
    }
    i = i + 1
  }
  name
}

// `>` at index `i` closes a generic application exactly when an earlier `<` is still open
// (`angOpen`, the caller's running count) and it is not the second character of the arrow
// `=>`. These scanners serve three string languages, two of which spell a `>` that closes
// nothing (`tyToStr`'s `->`, the `$fnsig` key), so a `>` closing nothing must stay inert.
export function tyGtIsClose(name: string, i: i32, angOpen: i32) {
  if angOpen <= 0 { return false }
  if i > 0 { return name[i - 1] != '=' }
  true
}

// ── the one type-name scanner ────────────────────────────────────────────────
// The two entry points below are the whole grammar: everything else that counts a
// bracket asks them a question, and nothing else counts one. `tyGtIsClose` is exported
// because the close rule is part of their contract, not because a copy needs it.

// The index of the first top-level occurrence of `a` — or of `b`, when `b` is not 0 —
// at or after `from`, or -1. Quoted members skip whole, `{}`/`[]`/`()`/`<>` nest, a `>`
// closes only against an open `<`, and `'='` means the arrow, matching only before `>`.
// Depth counts from `from`, exact because a resume point is a position of depth 0.
export function tyTopIndexOf(name: string, a: i32, b: i32, from: i32) {
  let depth = 0
  let angOpen = 0
  let i = from
  while i < name.length {
    const c = name[i]
    if c == '"' {
      i = skipQuotedName(name, i)
    } else {
      if c == '{' || c == '[' || c == '(' {
        depth = depth + 1
      } else if c == '<' {
        depth = depth + 1
        angOpen = angOpen + 1
      } else if c == '}' || c == ']' || c == ')' {
        depth = depth - 1
      } else if c == '>' && tyGtIsClose(name, i, angOpen) {
        depth = depth - 1
        angOpen = angOpen - 1
      } else if depth == 0 && (c == a || c == b) {
        if c != '=' { return i }
        if i + 1 < name.length && name[i + 1] == '>' { return i }
      }
      i = i + 1
    }
  }
  -1
}

// Append the top-level `sep`-separated parts of `s` to `out`, as verbatim slices; a
// separator inside a literal member is not a split point. `dropEmpty` is the one axis
// callers differ on: a generic argument list drops the empty part of `Box<i32,>`, while
// the param, pipe and shape-body splits need an empty input to yield one empty part.
export function tyTopLevelSplit(
  s: string,
  sep: i32,
  dropEmpty: boolean,
  out: string[],
) {
  let start = 0
  let going = true
  while going {
    let end = tyTopIndexOf(s, sep, 0, start)
    if end < 0 {
      end = s.length
      going = false
    }
    const part = s.slice(start, end)
    if part.length > 0 || !dropEmpty { out.push(part) }
    start = end + 1
  }
  0
}

// ── the union-atom split: the same walk with the arrow as a second stop ──────
// An inline union annotation parses to a `TypeRef` whose synthetic name is the
// pipe-joined member list (`"A|B"`). A top-level `=>` stops both bodies below, so
// `(i32) => i32 | string` is one function type whose return absorbs the pipe.

// Is the span `name[from .. to)` the same text as `want`? A length check and a
// code-point loop with no slice — the allocation-free half of "does this union spelling
// contain this atom", for callers that only ever compared the atom a split materialized.
export function spanEqAt(
  name: string,
  from: i32,
  to: i32,
  want: string,
): boolean {
  if to - from != want.length { return false }
  let i = 0
  while i < want.length {
    if name[from + i] != want[i] { return false }
    i = i + 1
  }
  true
}

// Append the member atoms of the synthetic union name `name` to `out`, split on its
// top-level `|` separators; a bare name with no `|` appends one atom. Atoms are verbatim
// slices, never a per-code-point accumulation, whose copy-on-concat walks the whole atom
// again per character. The flat `out` keeps this off the empty-ref-array return path.
export function splitUnionAtoms(name: string, out: string[]) {
  // Depth counts every grouper, so a paren-grouped arm stays whole: `(i32 | string)[] |
  // {w: i32}` is two atoms, where a brace-and-bracket-only depth yields the garbage
  // `(i32` + `string)[]` and the binding silently drops its union rep. `<…>` counts too.
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    if at < 0 || name[at] == '=' {
      out.push(name.slice(start, name.length))
      going = false
    } else {
      out.push(name.slice(start, at))
      start = at + 1
    }
  }
  0
}

// The number of top-level `|`-separated members in the synthetic name `name` (1 for a
// bare name). Counts separators without materializing the atom strings.
export function unionMemberCount(name: string) {
  // The counting dual of `splitUnionAtoms`: a top-level `=>` stops the count, so
  // `(i32) => i32 | string` is one function type and not a two-member union.
  let n = 1
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    if at < 0 || name[at] == '=' {
      going = false
    } else {
      n = n + 1
      start = at + 1
    }
  }
  n
}

// The index at which the group opened by `name[from - 1]` closes — the first closer that
// would take the depth (counted from `from`) below zero — or -1 when it never closes.
// Callers gate on the opener themselves, which is what makes `from` meaningful; a `>`
// cannot be the closer found here, since `tyGtIsClose` needs an open `<`.
export function tyGroupEndIndex(name: string, from: i32) {
  let depth = 0
  let angOpen = 0
  let i = from
  while i < name.length {
    const c = name[i]
    if c == '"' {
      i = skipQuotedName(name, i)
    } else {
      if c == '{' || c == '[' || c == '(' {
        depth = depth + 1
      } else if c == '<' {
        depth = depth + 1
        angOpen = angOpen + 1
      } else if c == '}' || c == ']' || c == ')' {
        if depth == 0 { return i }
        depth = depth - 1
      } else if c == '>' && tyGtIsClose(name, i, angOpen) {
        if depth == 0 { return i }
        depth = depth - 1
        angOpen = angOpen - 1
      }
      i = i + 1
    }
  }
  -1
}

// `name` minus its first and last characters — the body of a one-character-delimited
// group (`{x:i32}` → `x:i32`, `(i32|null)` → `i32|null`), `""` when it is too short. It
// carries no endpoint test by design: it serves three delimiters whose callers ask four
// different tests in front of it, so folding any one in would be wrong for the others.
export function groupInnerOf(name: string) {
  if name.length < 2 { return "" }
  const inner = name.slice(1, name.length - 1)
  inner
}

// True if the type-name `name` is a function type (`() => i64`, `(i32) => i32`) — a
// top-level `=>` with parens, braces and brackets balanced. A union member that is a
// closure rides the box's anyref `value` as the closure fat pointer, so it is a ref atom
// (kind 11) with no per-rep scalar value box.
export function nameIsFuncTypeAtom(nameIn: string) {
  // A union member keeps its grouping parens (`(() => i64) | i64` splits to the atom
  // `(() => i64)`), so peel every fully-enclosing balanced layer before the top-level
  // `=>` scan — otherwise the arrow reads as nested and misses.
  const name = peelGroupParens(nameIn)
  tyTopIndexOf(name, '=', 0, 0) >= 0
}

// True when the leading bracket of `name` closes only at the final char, i.e. the outer
// group encloses the whole string (`(()=>i64)` yes; `(i32)=>(i32)` no). Both callers gate
// on `name.length >= 2` and a leading `(` before calling, and must keep doing so: on the
// empty name this answers true, and a bare `Box<i32>` answers true without being a peel.
export function parenEnclosesWhole(name: string) {
  tyGroupEndIndex(name, 1) == name.length - 1
}

// ── the paren grammar: `nameIsParenOpen` opens, `nameIsParenSpanEnds` spans ──
// Neither carries a balance walk. Adding one would silently tighten the sites that have
// none today; `parenEnclosesWhole` above is the walk, kept as a separate conjunct at the
// two call sites that want it.
export function nameIsParenOpen(name: string) {
  if name.length < 1 { return false }
  name[0] == '('
}
// The paren-group endpoint span: `nameIsParenOpen` and a final `)`. A layer over the
// opener, not a second copy — the `'('` compare lives once, above. The `length >= 2`
// bound most callers spell is implied, not dropped: on a one-character name the first
// and last character are the same one, and no character is both `(` and `)`.
export function nameIsParenSpanEnds(name: string) {
  if !nameIsParenOpen(name) { return false }
  name[name.length - 1] == ')'
}
// Peel every fully-enclosing balanced grouping-paren layer from `name` (`(() => i64)` →
// `() => i64`), returning a non-parenthesized name unchanged. `splitUnionAtoms` keeps a
// closure member's grouping parens while the bare `is`-test spelling drops them, so an
// atom-equality compare must peel first. Shared with `nameIsFuncTypeAtom`'s prelude.
export function peelGroupParens(nameIn: string) {
  let name = nameIn
  while nameIsParenSpanEnds(name) && parenEnclosesWhole(name) {
    name = groupInnerOf(name)
  }
  name
}

// `(p1, p2) => ret` split into the param-list interior and the return, given the index
// of the top-level `=>`. The index is passed in and never re-scanned: the arrow finders
// stay in three places for import-direction reasons, and only the cut — pure, given the
// index — is shared. It folds in no guard; its callers gate on four different predicates.
export function fnParamsTextOf(name: string, at: i32) {
  const ps = name.slice(1, at - 1)
  ps
}
// The return of `(p1, p2) => ret` given the top-level `=>` at `at`: everything past the
// two arrow characters. Bound rather than left as the trailing expression, because a
// bare member-call statement is not a lowerable form.
export function fnRetTextOf(name: string, at: i32) {
  const ret = name.slice(at + 2, name.length)
  ret
}

// ── the array-name grammar: `nameIsArray` tests it, `arrElemNameRaw` cuts it ─
// True if the type-name `name` is an array type — its lexeme ends in `[]`, the suffix
// `parseType` appends for every `T[]` annotation.
export function nameIsArray(name: string) {
  const n = name.length
  if n < 2 { return false }
  if name[n - 2] != '[' { return false }
  if name[n - 1] != ']' { return false }
  // D954 — a union whose last member is an array is not an array: the suffix test alone
  // reads `string | i32[]` as a list, because those two characters belong to the last
  // member. Top-level atoms only, so `(i32|string)[]` — an array of a union — still is
  // one, which is why this asks the counter rather than for a `|`.
  unionMemberCount(name) < 2
}
// Does the span `name[from .. to)` open a map spelling (`{[`) and not end in `[]`, which
// would make it a list of maps rather than a map.
export function nameIsMapSpan(name: string, from: i32, to: i32): boolean {
  if to - from < 2 { return false }
  if name[from] != '{' { return false }
  if name[from + 1] != '[' { return false }
  if name[to - 2] == '[' {
    if name[to - 1] == ']' { return false }
  }
  true
}

// `unionMemberCount` over a span. `tyTopIndexOf` already takes a `from`; a separator it
// finds at or past `to` is outside the span, which is the same as finding none. Depth is
// tracked from `from`, so this is exact for any span balanced on its own — which every
// element or leaf cut of a rendered type name is.
export function unionMemberCountSpan(name: string, from: i32, to: i32): i32 {
  let n = 1
  let start = from
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    if at < 0 || at >= to || name[at] == '=' {
      going = false
    } else {
      n = n + 1
      start = at + 1
    }
  }
  n
}

export function arrElemIsArrayOf(name: string, want: string): boolean {
  if !nameIsArray(name) { return false }
  const to = name.length - 2
  if to < 2 { return false }
  if name[to - 2] != '[' { return false }
  if name[to - 1] != ']' { return false }
  spanEqAt(name, 0, to - 2, want)
}

export function arrElemIs(name: string, want: string): boolean {
  if !nameIsArray(name) { return false }
  spanEqAt(name, 0, name.length - 2, want)
}

// The raw 1-D element name of an array type name — `name` minus its final two characters
// — or "" when `name` is not an array name. Raw deliberately: `listElemNameOf` below is
// this cut plus the naive grouping-paren strip, and the two are not interchangeable. `""`
// doubles as "not an array name" and as the element of the degenerate `"[]"`.
export function arrElemNameRaw(name: string) {
  if !nameIsArray(name) { return "" }
  const elem = name.slice(0, name.length - 2)
  elem
}
// The 1-D list-element peel: the trailing `[]` cut plus the one layer of disambiguating
// grouping parens a composite element carries (`(boolean|null)[]` → `boolean|null`), and
// "" when `name` is not an array name. The paren strip is deliberately the naive endpoint
// test, not `peelGroupParens`: widening it would reclassify `(a)|(b)`-shaped elements.
export function listElemNameOf(name: string) {
  let elem = arrElemNameRaw(name)
  if elem == "" { return "" }
  if nameIsParenSpanEnds(elem) { elem = groupInnerOf(elem) }
  elem
}

// Does `name` start an inline struct shape (`{x:i32}`) rather than a map shape
// (`{[string]:i32}`) — `length >= 2 && name[0] == '{' && name[1] != '['`. The other
// `{`…`}` tests in the tree drop that second conjunct and so accept a map name; they
// belong to the wide span below, and routing them here would blind map-valued shapes.
export function nameIsShapeOpen(name: string) {
  if name.length < 2 { return false }
  name[0] == '{' && name[1] != '['
}
// The wide brace endpoint span: `length >= 2`, a `{` at index 0 and a `}` as the final
// character, without the `name[1] != '['` conjunct — so it accepts a map name as well as
// a shape, and accepts `{a:{b:i32}}|{c:i32}`, which a balance walk rejects. It is the
// widest of the brace family; tightening a caller to another is a behaviour change.
export function nameIsBraceSpanEnds(name: string) {
  if name.length < 2 { return false }
  name[0] == '{' && name[name.length - 1] == '}'
}

// ── the field-colon cut: the shape body's per-field split ────────────────────
// A `{…}` shape body is a comma-separated list of `name:type` fields; this owns the cut
// at the colon, with the index passed in and no guard folded in — four callers spell four
// different guards and two different finders, so either fold would be wrong for the rest.
export function fieldNameOf(field: string, ci: i32) {
  const fname = field.slice(0, ci)
  fname
}
// The field type text of a shape-body field `name:type`, given the colon at `ci` —
// everything past the colon to the end of the field. The field's own end is the caller's:
// every site has already cut the field out of the shape body, so the tail runs to
// `field.length` and not `length - 1`, which is what separates it from `gaeArgsTextOf`.
export function fieldTypeTextOf(field: string, ci: i32) {
  const ftext = field.slice(ci + 1, field.length)
  ftext
}

// The map-name grammar, `{[K]:V}`: `parser.vl` writes the spelling as
// `"{[" + key + "]:" + val + "}"` with the key a bare `IDENT` token, so the key holds no
// bracket and its `]` is both the first `]` and the depth-0 closer. `emit_base.mapValNameOf`
// is not `mapSpellValName` — it gates on `nameIsMap`, so it accepts `{[string]:i32}|null`.
export function nameIsMapOpen(name: string) {
  if name.length < 2 { return false }
  name[0] == '{' && name[1] == '['
}
// The map-name span: the opener and a final `}`, so the whole name is the map and not
// something carrying one (`{[string]:i32}[]` is a list of maps, `{[string]:i32}|null` a
// union with one, and neither ends `}`). A layer over the opener, not a second copy;
// `emit_base.nameIsShapeSpanEnds` cannot serve, since it rejects every map name.
export function nameIsMapSpanEnds(name: string) {
  if !nameIsMapOpen(name) { return false }
  name[name.length - 1] == '}'
}
// The index of the `]` that closes the key of a `{[`-opening name, or -1 when `name` does
// not open a map spelling or its key never closes into a `]:` pair. The walk is
// `tyGroupEndIndex` entered at index 2, the character after the `[` this function has just
// proved is at index 1, which is that home's `from`-gating contract.
export function mapSpellKeyEnd(name: string) {
  if !nameIsMapOpen(name) { return -1 }
  const ke = tyGroupEndIndex(name, 2)
  if ke < 0 { return -1 }
  if ke + 1 >= name.length { return -1 }
  if name[ke] != ']' { return -1 }
  if name[ke + 1] != ':' { return -1 }
  ke
}
// The key type-name `K` of a `{[K]:V}` spelling — the text between the `{[` and the key's
// closing `]` — or "" when `name` does not open one. It deliberately does not ask for the
// closing `}`, so it answers for a list of maps (`{[i32]:i32}[]`) and a nullable one as
// readily as for a whole span; `emit_base.nameIsI32KeyedMap` is the caller that needs it.
export function mapSpellKeyName(name: string) {
  const ke = mapSpellKeyEnd(name)
  if ke < 0 { return "" }
  const k = name.slice(2, ke)
  k
}
// The value type-name `V` of a `{[K]:V}` spelling — the text after the `]:` and before
// the closing `}` — or "" when `name` is not a whole map spelling. Unlike the key cut this
// one takes the span, because the closing `}` is the value's right edge: without it there
// is no value text to cut, only a suffix of a bigger name.
export function mapSpellValName(name: string) {
  if !nameIsMapSpanEnds(name) { return "" }
  const ke = mapSpellKeyEnd(name)
  if ke < 0 { return "" }
  const v = name.slice(ke + 2, name.length - 1)
  v
}

// The generic-application grammar. `parseTypeName` folds a generic's arguments into the
// declared name, so a declaration is `Box<T>` and an application is `Box<i32>`; the head
// is an identifier run, so the first `<` is its right edge. The `<`-scan and the span are
// two predicates, not one — a declaration wants only the `<`. Index 0 does not count.
export function gaeLtAt(name: string) {
  let i = 0
  while i < name.length {
    if name[i] == '<' { return i }
    i = i + 1
  }
  -1
}
// The generic-application span test: a name whose final character is `>` and which has a
// `<` at a positive index — `Box<i32>`, `Pair<K, V>`. The `>` compare stays in front of
// `gaeLtAt`'s scan, so a name that plainly does not end in `>` never pays a whole-name
// walk; `gaeLtAt(ann) > 0` then implies `ann.length >= 2`, so the final read is in bounds.
export function annGenAppSpanEnds(ann: string) {
  const n = ann.length
  if n < 3 { return false }
  if ann[n - 1] != '>' { return false }
  gaeLtAt(ann) > 0
}
// The generic-application cut: the head before the `<` and the argument text between it
// and the closing `>`. The index is passed in, never re-scanned — every routed site
// already holds the `<` position — and the cut is delimiter-blind, because the sites do
// not agree on the guard: most ask the span, one only `lt >= 0`, one a declaration's `<`.
export function gaeHeadNameOf(name: string, lt: i32) {
  const head = name.slice(0, lt)
  head
}
// The argument text of a generic application or declaration name `Head<A,B>` — everything
// between the `<` at `lt` and the name's last character, the closing `>` taken
// positionally. The callers split it themselves or store it raw and do not agree on
// which, which is why the split is not folded in here.
export function gaeArgsTextOf(name: string, lt: i32) {
  const args = name.slice(lt + 1, name.length - 1)
  args
}

// Strip the mangle suffixes: the module merge appends `$mN` for the module's table index
// and the parser appends `$bN` to a `type` declared inside a block (D1045), and the two
// compose (`P$b7$m1`). A spelling, not a bare name — a suffix can sit mid-text
// (`Box$m1<i32>`) — so every occurrence is cut; `typecheck.demangleName` is the bare twin.
export function demangleSpelling(s: string): string {
  let out = ""
  let runStart = 0
  let i = 0
  while i < s.length {
    if (
      s[i] == '$' &&
      i + 2 < s.length &&
      (s[i + 1] == 'm' || s[i + 1] == 'b') &&
      s[i + 2] >= '0' &&
      s[i + 2] <= '9'
    ) {
      out = out + s.slice(runStart, i)
      i = i + 2
      while i < s.length && s[i] >= '0' && s[i] <= '9' { i = i + 1 }
      runStart = i
    } else {
      i = i + 1
    }
  }
  out + s.slice(runStart, s.length)
}
