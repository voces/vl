// `compiler/tyname.vl` — THE TYPE-NAME GRAMMAR, AND NOTHING ELSE.
// A rendered type NAME is a little bracket language the parser writes and later passes
// read back: `{x:i32}` shape, `{[K]:V}` map, `T[]` array, `(…)` group and param list,
// `Head<A,B>` generic application, `"a"` literal member, the separators `|` `&` `,` `:`
// and the arrow `=>`. Every question asked OF it — where a group opens, whether it spans
// the whole name, where it closes, what the element / key / value is — lives only here.
//
// **THIS MODULE IS A LEAF: IT HAS ZERO IMPORTS, AND THAT IS ITS WHOLE CONTRACT.** Every
// body below is a pure function of a STRING — no `T.` type arena, no `P.` node arena, no
// diagnostics, no module state, no `emit_*` — so nothing here can observe the program
// being compiled or be reached by an import cycle. That is what lets every consumer
// import it DIRECTLY; an `export … from "./tyname"` line elsewhere is a regression.
// ── WHAT IS IN, IN DEPENDENCY ORDER (re-derive it, never carry it forward) ────────────
//   the WALK    `skipQuotedName` (private) · `nameIsQuotedLeaf` · `tyGtIsClose` ·
//               `tyTopIndexOf` · `tyGroupEndIndex` · `spanEqAt`
//   the SPLIT   `tyTopLevelSplit` (generic top-level `sep`) · `splitUnionAtoms` /
//               `unionMemberCount` / `unionMemberCountSpan` — the `|` split and its
//               counting duals, ARROW-stopped where the generic split is not
//   SPACE RULE  `nameIsSpaceFree` (assert) · `nameStripSpaces` (enforce)
//   IDENT RUNS  `nameIdentChar` (the CLASS; the run TOKENIZER is measured and declined) ·
//               `nameIsBareIdent` · `nameMentionsIdent`
//   GROUP INNER `groupInnerOf` — the ONE cut every delimiter shares
//   PAREN       `nameIsFuncTypeAtom` · `parenEnclosesWhole` · `nameIsParenOpen` ·
//               `nameIsParenSpanEnds` · `peelGroupParens`
//   FN ARROW    `fnParamsTextOf` · `fnRetTextOf` — the CUT; the INDEX stays out
//   ARRAY       `nameIsArray` · `arrElemNameRaw` · `arrElemIs` · `arrElemIsArrayOf` ·
//               `listElemNameOf`
//   BRACE       `nameIsShapeOpen` · `nameIsBraceSpanEnds`
//   FIELD COLON `fieldNameOf` · `fieldTypeTextOf` — the CUT; the FINDER stays out
//   MAP         `nameIsMapOpen` · `nameIsMapSpan` · `nameIsMapSpanEnds` ·
//               `mapSpellKeyEnd` · `mapSpellKeyName` · `mapSpellValName`
//   GENERIC APP `gaeLtAt` · `annGenAppSpanEnds` · `gaeHeadNameOf` · `gaeArgsTextOf`
//   MANGLE      `demangleSpelling` — the `$mN` / `$bN` suffix strip (D1045)
//
// OUT, with the reason, because the boundary is "pure function of a string":
// `isTopLevelFuncTypeName` stays in `typecheck.vl` — it WRITES a module-level bank
// (`funcArrowAt`) two call sites read on the next line, so it is not a leaf; its CUT is
// here, the FINDER is what is stuck. `nameHasSep` / `nameHasPipe` stay (checker-private).
// `emit_base.mapValNameOf` / `nameIsShapeSpanEnds` stay: LAYERS on these homes, not copies.
// Census tables and refuted candidates: `docs/internals/destringify-types-program.md`.

// Skip a QUOTED string-literal segment inside a synthetic type name (the
// cursor is ON the opening `"`): returns the index just past the closing
// quote. A `\` escape skips the next char, so an escaped quote stays inside.
// Every depth-aware name scanner calls this so a literal member's characters
// (`"a|b"`) never count as separators or depth.
//
// An UNTERMINATED segment ends at `name.length`, so a caller that copies the
// span `[start, skipQuotedName(name, start))` is total on any input.
//
// Exported for `driver.modTypeRenamed`, the one quoted-segment scan outside this
// file: the module-merge rename copies a literal member verbatim, and "where the
// member ends" has to be the same question there as it is here.
export function skipQuotedName(name: string, start: i32) {
  let i = start + 1
  while i < name.length {
    const c = name[i]
    if c == '\\' { i = i + 2 }
    else if c == '"' { return i + 1 }
    else { i = i + 1 }
  }
  i
}

// ── the QUOTED-LEAF test: the OTHER half of the `"` alphabet ───────────────────────────
//
// THE ONE HOME of "is this type-name atom a string-literal member" — `"a"` of `"a"|"b"`,
// the `is` RHS of `v is "a"`, one member of an inline literal union. `skipQuotedName`
// above owns where a quoted segment ENDS; this owns where one BEGINS.
// **NO LENGTH GUARD, AND THAT IS THE FAITHFUL FORM.** VL string indexing TRAPS out of
// bounds (unlike `.slice`, which clamps), so folding a bound in here would turn a trap
// into `false` at the routed sites that do NOT carry one — `litMemberTy`, guarded one
// line up by `name.length == 0`, and `emitUnionLitIs`, reached only through
// `isLitVariantName`, which carries one. The rest guard themselves and do NOT agree on
// the bound (some spell `length < 2`, some `> 0`), so any folded-in bound would be wrong
// for the others. Same delimiter-blind ruling as `groupInnerOf` below.
export function nameIsQuotedLeaf(name: string) { name[0] == '"' }

// ── the IDENTIFIER-RUN walk: the CLASSIFIER is the home, the TOKENIZER is REFUTED ──────
// A rendered type name is identifier RUNS separated by the punctuation the rest of this
// file names, and `driver.modTypeRenamed` is the one body that walks it that way — taking
// the class from here and the quoted-member skip from `skipQuotedName` above. A run
// TOKENIZER (`nameIdentRuns`) was built, routed and measured, and is DECLINED: its one
// legal consumer is quote-AWARE (a quote-blind tokenizer renames inside literal members),
// and two materialised index columns plus their push loops cost more compiler bytes than
// the single accumulating run they remove. `typecheck.nameNeedsCanon` is not this family
// either — its digit rule is member-START, not run-start, and `Box<0>` separates them.
// See `docs/internals/destringify-types-program.md`.
// The identifier character class of a rendered type name: `[A-Za-z0-9_]`. Digits are IN
// (a run is `i32`, `f64`, `K0`) — a different set from the LEXER's identifier-START.
export function nameIdentChar(c: i32) {
  if c >= 'a' && c <= 'z' { return true }
  if c >= 'A' && c <= 'Z' { return true }
  if c >= '0' && c <= '9' { return true }
  c == '_'
}

// ── the SPACE-FREE NORMALISATION: one rule, ASSERTED in one place, ENFORCED in one ─────
// "A CANONICAL type name has no spaces" matters because the two renderers disagree:
// `tyToStr` renders a shape SPACED (`{a: i32, b: string}`) for DIAGNOSTICS, `tyToEmitName`
// tight (`{a:i32}`) for the `sNames` intern keys — so a space is the tell that a name came
// from the wrong renderer. `nameIsSpaceFree` asserts the rule, `nameStripSpaces` enforces
// it; a site that TRIMS the ends or SKIPS a run of spaces at an index is a THIRD operation
// and stays where it is.
// THE ONE HOME of the BARE-IDENTIFIER assertion: every character of `name` an identifier
// character, with a non-digit first. It is the NEGATIVE of every composite arm at once —
// a name reaching the end of this loop holds no `|`, `&`, `!`, `(`, `[`, `{`, `<`, `:`,
// `,`, `=`, space or quote, so only the shared leaf ladder is left. `$` is IN (a merged
// declaration is `Point$m2`); a leading digit is OUT (a NUMERIC literal is another arm).
export function nameIsBareIdent(name: string) {
  const n = name.length
  if n == 0 { return false }
  let i = 0
  while i < n {
    const c = name[i]
    const isLower = c >= 97 && c <= 122
    const isUpper = c >= 65 && c <= 90
    const isDigit = c >= 48 && c <= 57
    if !(isLower || isUpper || isDigit || c == 95 || c == 36) { return false }
    if i == 0 && isDigit { return false }
    i = i + 1
  }
  true
}

// THE ONE HOME of the IDENTIFIER-MENTION test: does the spelling `name` contain `id` as a
// WHOLE identifier — not as a substring of a longer one? `K` is mentioned by `{a: K[]}` and
// by `K | null`, and is NOT mentioned by `Kind` or `myK`. The boundary on each side is
// "not an identifier character", which is the same character class `nameIsBareIdent` walks.
export function nameMentionsIdent(name: string, id: string) {
  const n = name.length
  const m = id.length
  if m == 0 { return false }
  if n < m { return false }
  let i = 0
  while i + m <= n {
    let hit = true
    let j = 0
    while j < m {
      if name[i + j] != id[j] { hit = false }
      j = j + 1
    }
    if hit {
      let okL = true
      if i > 0 {
        const c = name[i - 1]
        const l = c >= 97 && c <= 122
        const u = c >= 65 && c <= 90
        const d = c >= 48 && c <= 57
        if l || u || d || c == 95 || c == 36 { okL = false }
      }
      let okR = true
      if i + m < n {
        const c2 = name[i + m]
        const l2 = c2 >= 97 && c2 <= 122
        const u2 = c2 >= 65 && c2 <= 90
        const d2 = c2 >= 48 && c2 <= 57
        if l2 || u2 || d2 || c2 == 95 || c2 == 36 { okR = false }
      }
      if okL && okR { return true }
    }
    i = i + 1
  }
  false
}

// THE ONE HOME of the ASSERTION: does `name` contain no space at all.
export function nameIsSpaceFree(name: string) {
  let i = 0
  while i < name.length {
    if name[i] == ' ' { return false }
    i = i + 1
  }
  true
}
// THE ONE HOME of the ENFORCEMENT: `name` with every space dropped.
//
// **IT RETURNS `name` ITSELF WHEN THERE IS NOTHING TO DROP, AND THAT IS THE POINT, NOT A
// DEFENSIVE HABIT.** The normalisation is live on a large minority of shape names, so the
// majority that carry no space must not pay an allocation for it: the scan runs first and
// the rebuild starts from `name.slice(0, i)` at the FIRST space — the copies' shape, kept
// exactly.
//
// It is NOT a depth ladder: it counts no brackets and asks nothing about structure, so it
// reintroduces none of the grammar this file's other bodies own.
export function nameStripSpaces(name: string) {
  let i = 0
  while i < name.length {
    if name[i] == ' ' {
      let out = name.slice(0, i)
      let j = i
      while j < name.length {
        if name[j] != ' ' { out = out + fromCodePoint(name[j]) }
        j = j + 1
      }
      return out
    }
    i = i + 1
  }
  name
}

// `>` at index `i` is a generic-application CLOSER exactly when an earlier `<` is still
// OPEN (`angOpen` — the caller's running count of unclosed `<`) and it is not the second
// character of the function arrow `=>`.
// The only `<` these scanners ever see comes from `parseTypeAtom`'s generic-APPLICATION
// arm (`parser.vl`), where the token is unambiguous: a parser-built type name holds no
// EXPRESSION, so a RELATIONAL `<`/`>` cannot reach here. A bare `>` is different, and
// `angOpen` is the gate because these scanners serve three string languages, two of which
// spell a `>` that closes nothing — `tyToStr`'s DIAGNOSTIC arrow `->`, and the `$fnsig`
// closure-key param/return split (`"=>ii>i"`). A `>` that closes nothing must stay inert,
// so `angOpen > 0` is the total condition. The `=` exemption sits INSIDE the gate, for the
// one case where both hold — `Box<(i32)=>i32>`, whose arrow `>` would otherwise close the
// application one bracket early.
export function tyGtIsClose(name: string, i: i32, angOpen: i32) {
  if angOpen <= 0 { return false }
  if i > 0 { return name[i - 1] != '=' }
  true
}

// ── THE ONE TYPE-NAME SCANNER ────────────────────────────────────────────────
// A rendered type name is a bracket language: `{}` object / map, `[]` array, `()` group
// and param list, `<>` generic application, `"…"` literal member, plus the separators
// `|` `&` `,` `:` and the function arrow `=>`. Walking it at TOP LEVEL — the same
// `depth`/`angOpen`/quote-skip ladder — used to be hand-written out in this file and in
// three emitter modules, and that was not a style problem but the compiler's
// most-repeated BUG SHAPE: every extension of the grammar had to be re-taught to each
// copy, and the copies were twice caught disagreeing.
// The two entry points below are the WHOLE grammar. Everything else that counts a bracket
// asks them a question; nothing else counts one. `tyGtIsClose` stays exported because the
// close rule is part of their contract, not because a copy needs it. Per-consumer diffs
// and the copy census are in `docs/internals/destringify-types-program.md`.

// The index of the first TOP-LEVEL occurrence of `a` — or of `b`, when `b` is not
// 0 — at or after `from`, or -1. Quoted literal members skip whole (escape-aware,
// via `skipQuotedName`); `{}`/`[]`/`()`/`<>` nest; a `>` closes only against an
// OPEN `<` (`tyGtIsClose`), so the arrow's own `>` and `tyToStr`'s `->` stay inert.
//
// `'='` means the function ARROW: it matches only when the next character is `>`.
// The four callers that hand-rolled that two-character lookahead now share it.
// DEPTH IS COUNTED FROM `from`, and that is exact rather than approximate: a caller
// resuming a split at the character after a top-level separator resumes where the depth
// was 0 by the split's own condition, so restarting the count there reproduces it. A
// whole split therefore still costs ONE pass over the name, which is what keeps
// `splitUnionAtoms` — the hottest caller — off the O(n²) path its own header warns about.
export function tyTopIndexOf(name: string, a: i32, b: i32, from: i32) {
  let depth = 0
  let angOpen = 0
  let i = from
  while i < name.length {
    const c = name[i]
    if c == '"' {
      i = skipQuotedName(name, i)
    } else {
      if c == '{' || c == '[' || c == '(' {
        depth = depth + 1
      } else if c == '<' {
        depth = depth + 1
        angOpen = angOpen + 1
      } else if c == '}' || c == ']' || c == ')' {
        depth = depth - 1
      } else if c == '>' && tyGtIsClose(name, i, angOpen) {
        depth = depth - 1
        angOpen = angOpen - 1
      } else if depth == 0 && (c == a || c == b) {
        if c != '=' { return i }
        if i + 1 < name.length && name[i + 1] == '>' { return i }
      }
      i = i + 1
    }
  }
  -1
}

// THE ONE HOME of the type-name depth walk, "SPLIT" form: append the TOP-LEVEL
// (grouper depth 0) `sep`-separated parts of `s` to `out`. A RESUME LOOP over
// `tyTopIndexOf` above, not a second ladder — the FIND form counts depth FROM `from`, and
// a resume point is always a position where the depth was 0 by the split's own condition,
// so restarting the count there reproduces it. A whole split costs ONE pass over `s`.
// `dropEmpty` is the ONE axis its callers differ on: a generic ARGUMENT list drops an
// empty part (a tolerated trailing comma — `Box<i32,>`), while the param-list, pipe and
// shape-body splits keep it, because an EMPTY input must yield exactly ONE empty part for
// them to read as their "no parts / malformed" case (`annFnDecompose`'s empty-param guard
// exists because of it). Parts are VERBATIM SLICES of `s`, and the quote skip is
// load-bearing: a separator inside a literal member (`Box<"a,b" | "c">`) is not a split
// point, which the emitter's pre-home ladder got wrong.
export function tyTopLevelSplit(
  s: string,
  sep: i32,
  dropEmpty: boolean,
  out: string[],
) {
  let start = 0
  let going = true
  while going {
    let end = tyTopIndexOf(s, sep, 0, start)
    if end < 0 {
      end = s.length
      going = false
    }
    const part = s.slice(start, end)
    if part.length > 0 || !dropEmpty { out.push(part) }
    start = end + 1
  }
  0
}

// ── the UNION-ATOM split: the same operation with the ARROW as a second stop ───────────
//
// An INLINE union annotation (`v: A | B`) parses to a `TypeRef` whose synthetic name is
// the pipe-joined member list (`"A|B"`, mirroring the `i32[]` / `{[K]:V}` synthetic names
// — see `parser.vl`'s `parseTypeName`), and both the checker and four emitter modules ask
// that name for its members. These two are that question, in its materialising and its
// counting form.
// They are NOT `tyTopLevelSplit(name, '|', false, out)`, and that is the whole reason
// they are two bodies and not a delegation: a TOP-LEVEL `=>` STOPS them, so
// `(i32) => i32 | string` is ONE function type whose return absorbs the pipe, where the
// generic split would report two members. `tyTopIndexOf(name, '|', '=', start)` asks for
// the separator OR the arrow at once, which is what keeps this off a second walk.

// Append the member atoms of the synthetic union name `name` to `out`, split on its
// TOP-LEVEL `|` separators (depth tracked so a nested `{…}` / `[…]` member is not
// split inside). A bare name with no `|` appends one atom. The flat `out` accumulator
// (vs returning a fresh `string[]`) keeps this off the self-host emitter's
// empty-ref-array-literal return path.
// Is the span `name[from .. to)` the same text as `want`? A length check and a code-point
// loop, with NO slice — the allocation-free half of "does this union spelling contain this
// atom", for callers that only ever compared the atom the split materialized.
export function spanEqAt(
  name: string,
  from: i32,
  to: i32,
  want: string,
): boolean {
  if to - from != want.length { return false }
  let i = 0
  while i < want.length {
    if name[from + i] != want[i] { return false }
    i = i + 1
  }
  true
}

export function splitUnionAtoms(name: string, out: string[]) {
  // Atoms are VERBATIM substrings of `name` between top-level `|` separators, so each is
  // one `slice` from the last separator (`start`) — never a per-code-point accumulation,
  // whose repeated copy-on-concat walks the whole atom AGAIN per char and made one
  // 30-line program over a recursive struct's render quadratic (the third recurrence of
  // that class — see `retAtomsCheap`, which now also gates that render away).
  //
  // Paren-aware splitting keeps a paren-GROUPED arm whole: `(i32 | string)[] | {w: i32}`
  // splits to `(i32 | string)[]` + `{w: i32}`. A brace/bracket-only depth mis-split it
  // into the garbage atoms `(i32` + `string)[]`, so the WHOLE union mis-classified — the
  // binding silently dropped its union rep and every `is` against the list arm const-folded
  // FALSE, a live miscompile. `<…>` counts too, so `Box<i32|null>` stays ONE atom. A
  // TOP-LEVEL `=>` stops the split: its return's `|` is split separately.
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    if at < 0 || name[at] == '=' {
      out.push(name.slice(start, name.length))
      going = false
    } else {
      out.push(name.slice(start, at))
      start = at + 1
    }
  }
  0
}

// The number of TOP-LEVEL `|`-separated members in the synthetic name `name` (1 for a
// bare name). Counts separators without materializing the atom strings.
export function unionMemberCount(name: string) {
  // The counting dual of `splitUnionAtoms` — the same query, without materializing the
  // atom strings (a top-level `=>` stops the count, so `(i32) => i32 | string` is ONE
  // function type and not a 2-member union).
  let n = 1
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    if at < 0 || name[at] == '=' {
      going = false
    } else {
      n = n + 1
      start = at + 1
    }
  }
  n
}

// The index at which the group opened by `name[from - 1]` CLOSES — the first
// closer that would take the depth (counted from `from`) below zero — or -1 when
// the group never closes. The same ladder as `tyTopIndexOf`, with the closer as
// the target instead of a separator.
//
// Callers gate on the OPENER themselves (`name[0] == '('`, `inner[0] == '['`),
// which is what makes `from` meaningful; a `>` cannot be the closer found here
// because `tyGtIsClose` needs an open `<` that a `from`-relative depth of 0 has
// not seen.
export function tyGroupEndIndex(name: string, from: i32) {
  let depth = 0
  let angOpen = 0
  let i = from
  while i < name.length {
    const c = name[i]
    if c == '"' {
      i = skipQuotedName(name, i)
    } else {
      if c == '{' || c == '[' || c == '(' {
        depth = depth + 1
      } else if c == '<' {
        depth = depth + 1
        angOpen = angOpen + 1
      } else if c == '}' || c == ']' || c == ')' {
        if depth == 0 { return i }
        depth = depth - 1
      } else if c == '>' && tyGtIsClose(name, i, angOpen) {
        if depth == 0 { return i }
        depth = depth - 1
        angOpen = angOpen - 1
      }
      i = i + 1
    }
  }
  -1
}

// ── the GROUP-INTERIOR cut: ONE cut, and it is deliberately DELIMITER-BLIND ────────────
//
// THE ONE HOME of the group-interior peel: `name` minus its FIRST and LAST characters —
// the body of a one-character-delimited group. `{x:i32}` → `x:i32`, `(i32|null)` →
// `i32|null`, `"a"` → `a`. `""` for a name too short to have an interior.
// **IT CARRIES NO ENDPOINT TEST, AND THAT IS THE DESIGN, NOT AN OMISSION.** The array cut
// could fold its test in (`arrElemNameRaw` gates on `nameIsArray`) because the array
// grammar has exactly ONE test. This cut serves THREE delimiters and its callers do not
// agree on which test they want in front of it — some ask `nameIsParenSpanEnds`, some
// `nameIsShapeSpanEnds`, one the bare `nameIsShapeOpen`, and some are gated by their
// CALLER. Folding in any one would be wrong for the others and the DISJUNCTION would be
// wider than every site, so the test stays at the call site. See destringify-types-program.md.
export function groupInnerOf(name: string) {
  if name.length < 2 { return "" }
  const inner = name.slice(1, name.length - 1)
  inner
}

// True if the type-name `name` is a FUNCTION type (`() => i64`, `(i32) => i32`) — a
// TOP-LEVEL `=>` (parens/braces/brackets balanced). A value-union member that is a
// closure rides the box's anyref `value` as the closure fat-pointer struct (a
// `structref` subtype), exactly as a string/list member rides its wrapper ref — so it
// is a REF atom (kind 11), with no per-rep scalar value box. Local to typecheck (the
// emitter's `annArrowAt` lives in `emit_base`, which imports THIS module).
export function nameIsFuncTypeAtom(nameIn: string) {
  // A union member keeps its GROUPING parens (`(() => i64) | i64` splits to the atom
  // `(() => i64)`), so peel every fully-enclosing balanced paren layer before the
  // top-level `=>` scan — otherwise the arrow reads as nested (depth 1) and misses.
  // THIS LOOP WAS THE HAND-WRITTEN COPY `peelGroupParens` was carved out of: character
  // for character the same span test, the same walk conjunct, the same slice. It could
  // not call the home while the home lived in `emit_base.vl` (which imports THIS file);
  // now the home lives below and this is one call. The `length >= 2` conjunct is IMPLIED
  // by the span test, not dropped — a one-character name cannot be both `(` and `)`.
  const name = peelGroupParens(nameIn)
  tyTopIndexOf(name, '=', 0, 0) >= 0
}

// True when the LEADING bracket of `name` closes only at the FINAL char — i.e. the outer
// group encloses the whole string (`(()=>i64)` yes; `(i32)=>(i32)` no, the first `)`
// closes mid-string). Lets `nameIsFuncTypeAtom` strip only genuine grouping parens.
// Both callers (`nameIsFuncTypeAtom`, `peelGroupParens`) gate on `name.length >= 2` and
// `name[0] == '('` before calling, so the `<…>` arm only ever runs on a group NESTED
// inside those parens; a bare `Box<i32>` reaching here would answer true, which is
// correct for "the leading bracket closes at the end" but is not a paren peel — do not
// drop those guards. The LENGTH guard is load-bearing too, and differently: on the EMPTY
// name this answers true (`tyGroupEndIndex` returns -1, and `"".length - 1` is also -1)
// where the hand-written scan it replaces answered false. No caller can reach it — both
// require two characters — but a third caller must gate, or add the guard here.
export function parenEnclosesWhole(name: string) {
  tyGroupEndIndex(name, 1) == name.length - 1
}

// ── the PAREN grammar: `nameIsParenOpen` OPENS it, `nameIsParenSpanEnds` SPANS it ──────
// THE HOMES LIVE HERE, ONE MODULE BELOW THE EMITTER, AND THAT IS THE WHOLE POINT. They
// were carved out in `emit_base.vl`, which imports THIS module — so the checker, which
// hand-wrote the same character compares at six sites of its own, could not reach them.
// Relocating them here inverts the home's LOCATION without touching the import graph.
// **THE NAIVE HOME IS THE HOME FOR NEITHER.** "A parenthesized type name" most obviously
// means the endpoints PLUS a balance walk proving the group opened at index 0 is still
// open at the last character — `parenEnclosesWhole` above does exactly that — and routing
// the span sites to it would have silently TIGHTENED the sites that carry no walk today.
// So this home carries NO walk, exactly as `emit_base.nameIsShapeSpanEnds` carries none,
// and the two sites that DO walk keep it as a separate conjunct at the call site. The
// arrow-, array- and close-only spellings are NOT this predicate and stay inline.
export function nameIsParenOpen(name: string) {
  if name.length < 1 { return false }
  name[0] == '('
}
// THE ONE HOME of the paren-group ENDPOINT span: `nameIsParenOpen` AND the final character
// is `)`. A LAYER over the opener, not a second copy of it — the `'('` compare lives once,
// above.
//
// The `length >= 2` bound five of the six routed sites spell (as `< 2` early returns, or as
// enclosing `length > 1` blocks one scope up) is IMPLIED, not dropped: on a one-character
// name `name[0]` and `name[name.length - 1]` are the SAME character, and no character is
// both `(` and `)`, so the explicit bound and this opener-gated form agree on every input.
// The sixth (`emit_classify.rlCanonLitUnionAtoms` 10046) bounds only `length >= 1` and is
// the same argument read the other way round.
export function nameIsParenSpanEnds(name: string) {
  if !nameIsParenOpen(name) { return false }
  name[name.length - 1] == ')'
}
// Peel every fully-enclosing balanced grouping-paren layer from `name` (`(() => i64)` →
// `() => i64`), returning a non-parenthesized name unchanged. `splitUnionAtoms` KEEPS a closure
// member's grouping parens (`(() => i64) | i32` → atom `(() => i64)`), but the bare `is`-test /
// annotation spelling drops them (`() => i64`) — so an atom-equality compare must peel first.
// (A ref-array / closure-array element ends in `]`, a struct in `}`, so only a BARE closure atom
// is affected; the paren-peel is the `nameIsFuncTypeAtom` prelude, shared to stay in lockstep.)
export function peelGroupParens(nameIn: string) {
  let name = nameIn
  // The PAREN grammar's SPAN half at its home, then the walk. `parenEnclosesWhole`'s header
  // requires both its callers to gate on `length >= 2` and a leading `(` before calling: the
  // home enforces both — it can only answer true when two distinct characters are `(` and
  // `)` — so the contract survives the routing intact. The walk stays a separate conjunct
  // because the OTHER walk-carrying site (`emit_base.normTypeAtom`) rides a DIFFERENT walk.
  // The GROUP-INTERIOR cut at its home (`groupInnerOf`) — the SPAN test above is the guard
  // this cut deliberately does not carry, so the pair reads exactly as it did inline.
  while nameIsParenSpanEnds(name) && parenEnclosesWhole(name) {
    name = groupInnerOf(name)
  }
  name
}

// ── the FUNCTION-ARROW CUT: the pair whose INDEX could not come with it ───────────────
//
// `(p1, p2) => ret` split into the PARAM-LIST interior and the RETURN, GIVEN the index of
// the top-level `=>`.
// **THE INDEX STAYS WHERE IT IS, AND THAT IS THE WHOLE SHAPE OF THIS PAIR.** Pointing the
// checker at `emit_base.annArrowAt` is an UP-move (`emit_base.vl` imports `typecheck.vl`),
// and the checker's own arrow FINDER, `isTopLevelFuncTypeName`, cannot move DOWN here
// either: it writes the module-level `funcArrowAt` bank that two of its call sites read
// on the very next line, and a body reaching module state is not a leaf. So the FINDERS
// stay in three places and only the CUT — pure, given the index — moves. Every routed
// site hands its own index in, no call is inserted between a predicate's return and its
// bank read, and the cut folds in NO guard: its callers gate on four different predicates.
export function fnParamsTextOf(name: string, at: i32) {
  const ps = name.slice(1, at - 1)
  ps
}
// The RETURN of `(p1, p2) => ret` given the top-level `=>` at `at`: everything past the two
// arrow characters. (Bound rather than left as the trailing expression: a bare member-call
// statement is not a lowerable form, the same reason `emit_base.annRetNameOf` binds its own
// slice — which is now this call.)
export function fnRetTextOf(name: string, at: i32) {
  const ret = name.slice(at + 2, name.length)
  ret
}

// ── the ARRAY-NAME grammar: `nameIsArray` TESTS it, `arrElemNameRaw` CUTS it ───────────
//
// **BOTH HOMES MOVED DOWN HERE FROM `emit_base.vl` (D-ARRDOWN), for the same reason the
// PAREN pair above did:** they are pure character grammar over a type-name STRING, and
// living above the checker meant the checker re-wrote them. `nameToTyReal`, `canonEmitName`,
// `nulElemListAtomKind` and `litUnionArrayElemOf` each carried their own copy of the
// two-character suffix test, and three of them their own copy of the cut.
//
// True if the type-name `name` is an ARRAY type — its lexeme ends in `[]` (the suffix
// `parseType` appends for every `T[]` annotation).
export function nameIsArray(name: string) {
  const n = name.length
  if n < 2 { return false }
  if name[n - 2] != '[' { return false }
  if name[n - 1] != ']' { return false }
  // D954 — A UNION WHOSE LAST MEMBER IS AN ARRAY IS NOT AN ARRAY. The suffix test alone
  // reads `string | i32[]` as a list type, because the two characters it looks at belong to
  // the last MEMBER rather than to the whole name. That made one type's two spellings
  // disagree: `{ a: string | i32[] }` stored a string ref into a list-typed field and was
  // check-clean INVALID WASM, while `{ a: i32[] | string }` — the same type, members
  // swapped — boxed correctly and ran.
  //
  // THE MAP GRAMMAR ALREADY GUARDS THE IDENTICAL HAZARD one member position over
  // (`nameIsMapMemberUnion`); the array grammar simply never got it. TOP-LEVEL atoms only,
  // so `(i32|string)[]` — an array OF a union — is still an array: its `|` sits inside the
  // parens and `unionMemberCount`'s depth-aware scan does not see it. That distinction is
  // the whole reason this asks the counter rather than for a `|`.
  unionMemberCount(name) < 2
}
// THE ONE HOME of the trailing-`[]` CUT: the RAW 1-D element name of an array type name
// — `name` minus its final two characters — or "" when `name` is not an array name.
// It is RAW deliberately: `listElemNameOf` below is this cut PLUS the naive grouping-paren
// strip, and the two are not interchangeable — `emit_mono.vl`'s own comment at its former
// hand-written copy said exactly that, which is a caller asking for a home that did not
// exist yet.
// `""` doubles as "not an array name" and as the element of the degenerate `"[]"`, the
// convention `listElemNameOf` documents and its callers read as `false`. The sites where
// those two answers are NOT interchangeable keep an explicit `nameIsArray` test in front,
// so this merge asserts nothing about whether `"[]"` is a producible type name. The
// one-call form was built and sabotage-tested; it is filed with its measurement in
// `docs/internals/destringify-types-program.md` and the faithful two-call form ships.
export function nameIsMapSpan(name: string, from: i32, to: i32): boolean {
  if to - from < 2 { return false }
  if name[from] != '{' { return false }
  if name[from + 1] != '[' { return false }
  if name[to - 2] == '[' {
    if name[to - 1] == ']' { return false }
  }
  true
}

// `unionMemberCount` over a SPAN. `tyTopIndexOf` already takes a `from`; a separator it
// finds at or past `to` is outside the span, which is the same as finding none. Depth is
// tracked from `from`, so this is exact for any span that is balanced on its own — which is
// what every element/leaf cut of a rendered type name is.
export function unionMemberCountSpan(name: string, from: i32, to: i32): i32 {
  let n = 1
  let start = from
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    if at < 0 || at >= to || name[at] == '=' {
      going = false
    } else {
      n = n + 1
      start = at + 1
    }
  }
  n
}

export function arrElemIsArrayOf(name: string, want: string): boolean {
  if !nameIsArray(name) { return false }
  const to = name.length - 2
  if to < 2 { return false }
  if name[to - 2] != '[' { return false }
  if name[to - 1] != ']' { return false }
  spanEqAt(name, 0, to - 2, want)
}

export function arrElemIs(name: string, want: string): boolean {
  if !nameIsArray(name) { return false }
  spanEqAt(name, 0, name.length - 2, want)
}

export function arrElemNameRaw(name: string) {
  if !nameIsArray(name) { return "" }
  const elem = name.slice(0, name.length - 2)
  elem
}
// THE ONE HOME of the 1-D LIST-ELEMENT peel: the trailing `[]` cut plus the ONE layer of
// disambiguating grouping parens a composite element carries (`(boolean|null)[]` →
// `boolean|null`, `K[]` → `K`). "" when `name` is not an array name.
//
// The `[]` cut itself is `arrElemNameRaw`'s, above: this is the RAW cut plus the paren
// strip, not a second copy of the cut. The paren strip is deliberately the NAIVE one the
// copies carried (`nameIsParenSpanEnds` — first char `(`, last char `)`, no balance walk),
// NOT `peelGroupParens`: every element reaching here is a single canonical atom, and
// widening the strip to a balanced one would change what `(a)|(b)`-shaped elements
// classify as. THIS IS THE SITE THE WALK-CARRYING HOME WOULD HAVE TIGHTENED, and the
// reason the span home above carries no walk. `""` doubles as "not an array" and as the
// element of the degenerate `"[]"` — every consumer answers `false` for both.
export function listElemNameOf(name: string) {
  let elem = arrElemNameRaw(name)
  if elem == "" { return "" }
  if nameIsParenSpanEnds(elem) { elem = groupInnerOf(elem) }
  elem
}

// ── the BRACE grammar: `nameIsShapeOpen` OPENS a shape, `nameIsBraceSpanEnds` SPANS ANY ──
//
// THE ONE HOME of the inline-object-shape OPENER: does `name` start an inline struct shape
// (`{x:i32}`) rather than a map shape (`{[string]:i32}`) — the
// `length >= 2 && name[0] == '{' && name[1] != '['` triple. The WIDE span followed it down
// from `emit_base.vl`; only the CONJUNCTION of the two (`nameIsShapeSpanEnds`) stays up
// there, because no site in this file asks for it.
// **THIS FILE'S OTHER `{`…`}` TESTS ARE NOT THIS PREDICATE** (`nameToTyReal`'s
// inline-object arm, `canonEmitName`'s shape arm, `isObjShapeName`): each is
// `name[0] == '{' && name[len - 1] == '}'` WITHOUT the `name[1] != '['` conjunct, so each
// ACCEPTS a map name, and routing them here would blind the checker to map-valued shapes.
// They belong to the WIDE span directly below. See destringify-types-program.md.
export function nameIsShapeOpen(name: string) {
  if name.length < 2 { return false }
  name[0] == '{' && name[1] != '['
}
// THE ONE HOME of the WIDE BRACE ENDPOINT span: `length >= 2`, a `{` at index 0, and a `}`
// as the final character — WITHOUT the `name[1] != '['` conjunct, so it accepts a MAP name
// as well as a shape. It lives HERE rather than in `emit_base.vl`, where it was carved
// out, because `emit_base.vl` imports THIS module and a route upward would have cycled the
// module graph — the same inversion the PAREN / ARRAY / SHAPE-OPEN grammars took.
//
// The brace family is four predicates over `length >= 2` names opening with `{`:
// `nameIsShapeOpen` (OPEN · NOT2ND, above) · `nameIsMapOpen` (OPEN · 2ND, the complement,
// below) · `nameIsBraceSpanEnds` (OPEN · CLOSE, this home) · `emit_base.nameIsShapeSpanEnds`
// (the first ANDed with this one). This is the WIDEST: it accepts `{[string]:i32}`, which
// the others reject, and `{a:{b:i32}}|{c:i32}`, which a balance walk rejects. Tightening a
// caller to another of them is a behaviour change owing its own graded population.
export function nameIsBraceSpanEnds(name: string) {
  if name.length < 2 { return false }
  name[0] == '{' && name[name.length - 1] == '}'
}

// ── the FIELD-COLON CUT: the shape BODY's per-field split ─────────────────────────────
//
// A `{…}` shape body is a comma-separated list of `name:type` fields, and every pass that
// reads one splits a field at its colon INDEX. The brace grammar above owns where the
// group opens and spans, `groupInnerOf` owns the interior peel; this owns the cut every
// one of their callers takes NEXT.
// **THE INDEX IS PASSED IN, AND THE CUT IS DELIMITER-BLIND** — the same ruling
// `groupInnerOf`, `gaeArgsTextOf` and `fnRetTextOf` took, and here the evidence is four
// different GUARDS in front of one operation (`ci <= 0`, `ci < 0`, `colonAt > 0`,
// `colonAt >= 0`) and two different FINDERS (`indexOf(":")`, depth-blind over an already
// flattened name; and `tyTopIndexOf(field, ':', 0, 0)`, the first TOP-LEVEL colon).
// Folding either in would be wrong for the other sites; both stay where they are.
export function fieldNameOf(field: string, ci: i32) {
  const fname = field.slice(0, ci)
  fname
}
// The field TYPE TEXT of a shape-body field `name:type`, given the colon at `ci` —
// everything past the colon, to the end of the field. The field's own END is the caller's:
// all five sites have already cut the field out of the shape body (at a top-level comma or
// via `gaeSplitArgs`), so the tail runs to `field.length` and NOT to `length - 1` — which is
// the one character that separates this cut from `gaeArgsTextOf`, whose operand still carries
// its closing `>`.
export function fieldTypeTextOf(field: string, ci: i32) {
  const ftext = field.slice(ci + 1, field.length)
  ftext
}

// ── the MAP-NAME grammar: `{[K]:V}` — OPEN, SPAN, and the KEY/VALUE CUT ───────────────
//
// The parser's index-signature spelling is not assembled character by character by the
// thing that READS it, but by the thing that WRITES it: `parser.vl` builds
// `"{[" + keyName + "]:" + valName + "}"`, and the KEY is a bare `IDENT` token, not a
// parsed type. Every property this family relies on is a property of that one
// concatenation, which is why the grammar can be stated once instead of re-derived — the
// key holds no bracket, so its `]` is both the first `]` and the depth-0 closer. This home
// keeps the WALK (`tyGroupEndIndex`) rather than hand-rolling a scan of its own.
// **`emit_base.mapValNameOf` IS NOT `mapSpellValName` AND MUST NOT BE MERGED BY EYEBALL.**
// It has a DIFFERENT span rule — it gates on `nameIsMap` where this one gates on a closing
// `}` — so it ACCEPTS `{[string]:i32}|null` and returns a garbled tail its callers strip.
export function nameIsMapOpen(name: string) {
  if name.length < 2 { return false }
  name[0] == '{' && name[1] == '['
}
// THE ONE HOME of the map-name SPAN: the opener AND a final `}`, so the whole name is the
// map and not something carrying one (`{[string]:i32}[]` is a LIST of maps and
// `{[string]:i32}|null` a union with one — both open `{[` and neither ends `}`). A LAYER
// over the opener, not a second copy of it. This is the map twin of
// `emit_base.nameIsShapeSpanEnds`, which cannot serve because it carries the
// `name[1] != '['` conjunct that makes it reject every map name.
export function nameIsMapSpanEnds(name: string) {
  if !nameIsMapOpen(name) { return false }
  name[name.length - 1] == '}'
}
// THE ONE HOME of the KEY CUT's scan: the index of the `]` that closes the KEY of a
// `{[`-opening name, or -1 when `name` does not open a map spelling or its key never closes
// into a `]:` pair.
//
// The walk is `tyGroupEndIndex`, entered at index 2 — the character after the `[` this
// function has just proved is at index 1, which is exactly the `from`-gating contract that
// home documents ("Callers gate on the OPENER themselves"). The `]:` pair is confirmed at
// the site the walk stopped: the walk answers where the key's bracket closes, the grammar
// additionally requires a `:` after it, and a closer that is not `]` at all (reachable only
// on a name no producer writes) is rejected rather than sliced around. The `length >= 5`
// bound the two scanning copies spelled is IMPLIED and dropped — a name passing here
// already has `{`, `[`, a `]` at index >= 2 and a `:` after it.
export function mapSpellKeyEnd(name: string) {
  if !nameIsMapOpen(name) { return -1 }
  const ke = tyGroupEndIndex(name, 2)
  if ke < 0 { return -1 }
  if ke + 1 >= name.length { return -1 }
  if name[ke] != ']' { return -1 }
  if name[ke + 1] != ':' { return -1 }
  ke
}
// THE ONE HOME of the KEY CUT: the key type-name `K` of a `{[K]:V}` spelling — the text
// between the `{[` and the key's closing `]` — or "" when `name` does not open one. It
// deliberately does NOT ask for the closing `}`, so it answers for a LIST of i32-keyed maps
// (`{[i32]:i32}[]`) and a nullable one as readily as for a whole span.
//
// The unsupported-map-key DIAGNOSTIC is no longer this function's: it names its key
// by descending the PARSER's spelling tree (`typecheck.tsMapKeyNodeOf`), not by slicing a
// rendered name, and the wide-not-whole-span gate moved there with it. What is left here
// are the two NAME-side consumers that have no node to descend — `typecheck.nameToTyReal`'s
// map arm and `canonEmitName`'s map arm — plus `emit_base.nameIsI32KeyedMap`, the only
// caller that exercises the not-whole-span width.
export function mapSpellKeyName(name: string) {
  const ke = mapSpellKeyEnd(name)
  if ke < 0 { return "" }
  const k = name.slice(2, ke)
  k
}
// THE ONE HOME of the VALUE CUT: the value type-name `V` of a `{[K]:V}` spelling — the text
// after the `]:` and before the closing `}` — or "" when `name` is not a WHOLE map spelling.
// Unlike the key cut this one takes the SPAN, because the closing `}` is the value's right
// edge: without it there is no value text to cut, only a suffix of a bigger name.
export function mapSpellValName(name: string) {
  if !nameIsMapSpanEnds(name) { return "" }
  const ke = mapSpellKeyEnd(name)
  if ke < 0 { return "" }
  const v = name.slice(ke + 2, name.length - 1)
  v
}

// ── the GENERIC-APPLICATION grammar: `gaeLtAt` FINDS the `<`, `annGenAppSpanEnds` SPANS ──
// Both homes live HERE rather than in `emit_base.vl`, where they were carved out: the
// CHECKER asks both questions, `emit_base.vl` imports THIS module, and a route upward
// would cycle the module graph — the same inversion the PAREN / ARRAY / SHAPE / BRACE
// grammars took.
// The spelling is the parser's: `parseTypeName` folds a generic's arguments into the
// declared name, so a DECLARATION is `Box<T>` and an APPLICATION is `Box<i32>`. The head is
// an identifier run, so the FIRST `<` is its right edge. **THE `<`-SCAN AND THE SPAN ARE
// TWO PREDICATES, NOT ONE**: a DECLARATION registration wants only the `<` and re-reads the
// trailing `>` later through the parameter-list cut, so routing it to the span would be a
// tightening, not a dedup. Index 0 does not count — a name whose FIRST character is `<` has
// no head, so every caller gates on `> 0`, never `>= 0`.
export function gaeLtAt(name: string) {
  let i = 0
  while i < name.length {
    if name[i] == '<' { return i }
    i = i + 1
  }
  -1
}
// THE ONE HOME of the GENERIC-APPLICATION SPAN test: a name whose FINAL character is `>` and
// which has a `<` at a positive index — `Box<i32>`, `Pair<K, V>`. The TEST half of the
// `Head<…>` grammar, split out from `emit_base.annGenAppDecompose` because callers want only
// the boolean and their own cut, not the split argument list.
//
// The `>` compare stays in FRONT of `gaeLtAt`'s scan, exactly as the inline spellings had it:
// running a whole-name scan on every annotation that plainly does not end in `>` would be a
// work regression. `gaeLtAt(ann) > 0` implies `ann.length >= 2`, so the final-character read
// below is in bounds for every name that reaches it, and the `n < 3` cheap reject is kept as
// the fast path it always was — `lt > 0` plus a trailing `>` already forces `n >= 3`, so it
// decides nothing. Routed callers re-ask `gaeLtAt` for their own slices rather than threading
// the index out, which costs a second scan only on a name that already ended in `>`.
export function annGenAppSpanEnds(ann: string) {
  const n = ann.length
  if n < 3 { return false }
  if ann[n - 1] != '>' { return false }
  gaeLtAt(ann) > 0
}
// ── the GENERIC-APPLICATION CUT: the fourth "test half homed, cut half not" ────────────
//
// `gaeLtAt` FINDS the `<` and `annGenAppSpanEnds` TESTS the span; this owns the two SLICES
// every one of their callers takes next — the HEAD before the `<` and the ARGUMENT TEXT
// between it and the closing `>`.
// **THE INDEX IS PASSED IN, NOT RE-SCANNED, AND THAT IS THE WHOLE SHAPE OF THIS CUT.**
// Every routed site already holds the `<` position in a local when it takes its slice,
// several of them precisely because `gaeLtAt` was re-asked after `annGenAppSpanEnds`
// returned; a home that re-scanned would add a third walk of the same name to each of them.
// DELIMITER-BLIND for `groupInnerOf`'s reason: the sites do not agree on the guard — most
// ask `annGenAppSpanEnds`, one asks only `lt >= 0` and MUST fall through to the whole name
// when there is no `<`, one asks `gaeLtAt(...) > 0` on a DECLARATION with no trailing `>`.
export function gaeHeadNameOf(name: string, lt: i32) {
  const head = name.slice(0, lt)
  head
}
// The ARGUMENT TEXT of a generic application/declaration name `Head<A,B>` — everything
// between the `<` at `lt` and the name's LAST character. The callers split it themselves
// (`gaeSplitArgs`, `tyTopLevelSplit`) or store it raw (`gaeCollectDecls`, `applyGenAlias`), and
// they do not agree on which, which is why the SPLIT is not folded in here.
//
// The closing `>` is taken positionally — `name.length - 1` — exactly as all seven writings
// spelled it, including the two that spelled the length as a hoisted local (`emit_base`'s
// `n`, `typecheck.nameToTyReal`'s `nlen`). Those two are the LENGTH-EXPRESSION normalisation
// failure #1250 recorded costing W1 a site twice; this census normalised for it up front.
export function gaeArgsTextOf(name: string, lt: i32) {
  const args = name.slice(lt + 1, name.length - 1)
  args
}

// ── the MANGLE SUFFIXES, stripped ────────────────────────────────────────────
// Two passes rename a declaration to keep two same-spelled ones apart, and both
// take the same shape: the module merge appends `$mN` (N = the module's table
// index) so two modules' `Pair` are two types to the tables that hold them, and
// the parser appends `$bN` to a `type` declared inside a BLOCK (D1045) so two
// functions' `P` are two types for the same reason. `$` is not a legal source
// identifier character (the lexer), so the pattern is unambiguous, and the two
// COMPOSE — a hoisted body-scoped declaration is a top-level statement, so the
// merge renames it as well and `P$b7$m1` reaches here.
// A SPELLING, not a bare name: a suffix can sit mid-text — inside a rendered type
// (`Box$m1<i32>`) or inside a whole diagnostic sentence — so every occurrence is
// cut, not just a trailing one. `demangleName` (typecheck.vl) is the bare-name twin.
export function demangleSpelling(s: string): string {
  let out = ""
  let runStart = 0
  let i = 0
  while i < s.length {
    if (
      s[i] == '$' &&
      i + 2 < s.length &&
      (s[i + 1] == 'm' || s[i + 1] == 'b') &&
      s[i + 2] >= '0' &&
      s[i + 2] <= '9'
    ) {
      out = out + s.slice(runStart, i)
      i = i + 2
      while i < s.length && s[i] >= '0' && s[i] <= '9' { i = i + 1 }
      runStart = i
    } else {
      i = i + 1
    }
  }
  out + s.slice(runStart, s.length)
}
