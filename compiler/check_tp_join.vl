// `check_tp_join.vl` — joins over type parameters, and the gradual parameters they read.
// A join of two type parameters, or of a parameter and a concrete type, is kept apart as an
// implicit parameter rather than boxed (`tpOpenJoin`, `keptParamUnion`), and re-joins at each
// pin; the tables here name the unions and holes kept apart, and the deferred joins a call
// site parks or lets escape. The predicates over declared and gradual parameters
// (`tyIsNamedParamHole`, `tyIsGradualParam`, `tyParamOfInnermostBody`) are what those
// decisions read. `joinRowsReset` clears the join rows per program.

import { FuncDecl, P, i32ToStr, nodeAt } from "./ast"
import {
  cstrOwnerStack,
  curFnDeclIx,
  lamCheckDepth,
  lamRefoldDepth,
} from "./check_cursor"
import {
  HD_BINOP,
  hdAlt,
  hdKind,
  hdRootTy,
  hdRowOf,
  holeBaseTy,
  tyIsNonNullHoleRead,
  tyParamsApart,
  tyVarOwnerOf,
} from "./check_hole_pins"
import {
  UM_DJOIN_RELAYED,
  UM_TP_IF_JOIN_AT,
  UM_TP_IF_OK_AT,
  undoReplayBool,
  undoReplayI32,
  undoSetBool,
  undoSetI32,
} from "./check_map_undo"
import {
  flattenVariantsInto,
  isNullTy,
  nonNullTy,
  tyHasTyVar,
  tyParamBesideConcrete,
} from "./tyquery"
import {
  T,
  TY_ERR,
  TY_VOID,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  mkNullableTy,
  tyArrayElemIx,
  tyAt,
  tyBearsNull,
  tyEq,
  tyEqSameHoles,
  tyIsDeclaredParam,
  tyIsHole,
  tyNulInnerTy,
} from "./check_types"
import { mkUnionTy } from "./check_union_mint"
import { i32ListHas } from "./listutil"
import { fnDeclIx } from "./check_write_scan"
import { declOrigOf } from "./symbols"

// The unions `joinTys` made of two type parameters (D2760). At a pin their members re-join as a
// non-generic join would, so `A | B` at `i32` and `f64` is `f64`, not a box of the two.
export let tpJoinUnions: {[i32]: i32} = Map()

// The else remainders of an `is` test over a type parameter's list, keyed by a fresh copy of the
// union read there: `substTyDeep` reads the copy as its base, and a pin subtracts the tested type
// at the instance, where `T[]` and `i32[]` are apart (or one list).
export let tvElseBase: {[i32]: i32} = Map()
export let tvElseTested: {[i32]: i32} = Map()

// A copy of union `cur` that pins to `cur − tIdx` per instance, or -1 when `cur` is not a union.
export function mkTvElseRemTy(cur: i32, tIdx: i32): i32 {
  const u = tyAt(cur)
  if !(u is TyUnion) { return -1 }
  const ms: i32[] = []
  for m in u.uMembers { ms.push(m) }
  const f = mkUnionTy(ms)
  const j = tpJoinUnions.get(cur)
  if j != null { tpJoinUnions[f] = j }
  tvElseBase[f] = cur
  tvElseTested[f] = tIdx
  f
}

// The parameter holes some join kept apart as an implicit type parameter (D3333): an instance
// binding one re-joins such a join through its holes' binding.
export let holeTpJoinNames: {[string]: boolean} = Map()
// The names `holeTpJoinNames` gained, in order, so a rollback can drop the newer ones.
export let holeTpJoinLog: string[] = []

// `V | null` when one side is a declared type parameter and the other is `null`, else -1.
// `null` is assignable to `V` only until an instance binds it, so absorbing it would type
// `[x, null]` as `V[]` and every instance would lose the null its concrete twin keeps (D2533).
export function joinTyParamNull(a: i32, b: i32) {
  let tv = -1
  if isNullTy(b) { tv = a }
  else if isNullTy(a) { tv = b }
  if tv < 0 || tv >= T.tys.length { return -1 }
  const t = tyAt(tv)
  if t is TyVar {
    // A hole's name starts with `?`; a declared parameter's is an identifier. A parameter's
    // hole in the body declaring it is one as well (D3303).
    if t.tvName.length > 0 && t.tvName[0] != "?"[0] { return mkNullableTy(tv) }
    if (
      tyIsNamedParamHole(tv)
      && (tyParamOfInnermostBody(tv) || lamParamOfOpenBody(tv))
    ) {
      noteHoleTpJoin(tv)
      return mkNullableTy(tv)
    }
  }
  -1
}

// Whether `t` is the hole of a named function's un-annotated parameter (`paramHoleName`), an
// implicit type parameter gradual as a declared one (D3333). A derived hole, a lambda
// parameter's and a call's fresh one are not.
function tyIsNamedParamHole(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const tt = tyAt(t)
  if tt is TyVar {
    const nm = tt.tvName
    if nm.length < 2 || nm[0] != "?"[0] || nm[1] == "#"[0] { return false }
    return tyVarOwnerOf(t) == nm
  }
  false
}

// Whether `t` is a declared type parameter or a parameter's hole (`tyIsNamedParamHole`).
export function tyIsGradualParam(t: i32): boolean {
  tyIsDeclaredParam(t) || tyIsNamedParamHole(t)
}

// Records each parameter hole among `t`'s members as one a join kept apart (`holeTpJoinNames`).
export function noteHoleTpJoin(t: i32) {
  const ms: i32[] = []
  flattenVariantsInto(t, ms)
  for m0 in ms {
    let m = m0
    if tyIsNonNullHoleRead(m) { m = holeBaseTy(m) }
    if tyIsNamedParamHole(m) {
      const mt = tyAt(m)
      if mt is TyVar && !(holeTpJoinNames.get(mt.tvName) ?? false) {
        holeTpJoinNames[mt.tvName] = true
        holeTpJoinLog.push(mt.tvName)
      }
    }
  }
  0
}

// Unmarks the names `noteHoleTpJoin` added after the first `n` it logged. They are set false
// rather than deleted: one map `.delete` anywhere puts every map in the program on the slower
// tombstone-aware lowering.
export function holeTpJoinTruncate(n: i32) {
  while holeTpJoinLog.length > n {
    const name = holeTpJoinLog.pop() ?? ""
    holeTpJoinNames[name] = false
  }
  0
}

// Whether one of the hole names `ns` is a parameter hole some join kept apart.
export function holeNamesTpJoin(ns: string[]): boolean {
  if holeTpJoinNames.length == 0 { return false }
  for n in ns {
    if holeTpJoinNames.get(n) ?? false { return true }
  }
  false
}

// Whether `name` is the hole of one of the parameters of function declaration `owner`.
function holeNameOfDecl(name: string, owner: i32): boolean {
  if name.length < 2 || name[0] != "?"[0] { return false }
  if owner < 0 || owner >= P.nodes.length { return false }
  const fd = nodeAt(owner)
  if fd is FuncDecl {
    if fd.fnName == "" { return false }
    return holeNameIsParamOf(name, fd.fnName, owner, fd.fnParams.length)
  }
  false
}

// Whether `at` and `exp` hold type parameters an instance may bind apart (`tyParamsApart`),
// every hole among them a parameter of `owner`, the body whose pin then asks (D6482).
export function tyParamsApartIn(at: i32, exp: i32, owner: i32): boolean {
  tyParamsApart(at, exp)
    && tyHolesOwnedBy(at, owner, 0)
    && tyHolesOwnedBy(exp, owner, 0)
}

// Whether every hole `ty` holds is a parameter of function declaration `owner`, so a pair the
// pin keeps apart names the enclosing body's own parameters rather than a callee's (D6482). It
// walks the list and nullable shapes `tyParamsApart` admits.
function tyHolesOwnedBy(ty: i32, owner: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth > 8 { return false }
  const t = tyAt(ty)
  if t is TyVar {
    return t.tvName.length == 0
      || t.tvName[0] != "?"[0]
      || holeNameOfDecl(t.tvName, owner)
  }
  const el = tyArrayElemIx(ty)
  if el >= 0 { return tyHolesOwnedBy(el, owner, depth + 1) }
  const inner = tyNulInnerTy(ty)
  inner < 0 || tyHolesOwnedBy(inner, owner, depth + 1)
}

// A union holding a declared type parameter is gradual as the bare parameter is: an operation
// is checked in the body against its concrete members, and each pin re-checks it against the
// whole substituted union. The concrete members' type, or `ty` when it is no such union.
export function tpGradualView(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return ty }
  const t = tyAt(ty)
  if !(t is TyUnion) { return ty }
  const keep: i32[] = []
  let tp = false
  let hole = -1
  for m in t.uMembers {
    if m < 0 || m >= T.tys.length { return ty }
    if tyAt(m) is TyVar {
      if tpGradualMember(m) { tp = true }
      if hole < 0 { hole = m }
    } else {
      if tyHasTyVar(m) { return ty }
      keep.push(m)
    }
  }
  if !tp { return ty }
  // Every member a parameter or a hole: the union is as open as a bare one.
  if keep.length == 0 { return hole }
  if keep.length == 1 { return keep[0] }
  mkUnionTy(keep)
}

// Whether union member `m` is a gradual parameter, or the non-null read of one under a null test.
function tpGradualMember(m: i32): boolean {
  if tyIsNonNullHoleRead(m) { return tyIsGradualParam(holeBaseTy(m)) }
  tyIsGradualParam(m)
}

// Whether a `??` over non-null left type `l` with a default typed `d` joins apart: `l` is a
// declared type parameter and `d` a concrete type, or another declared parameter.
export function coalParamDefault(l: i32, d: i32): boolean {
  if l < 0 || d < 0 || l == d || !tyIsDeclaredParam(l) { return false }
  if d >= T.tys.length || isNullTy(d) { return false }
  if tyIsDeclaredParam(d) { return !sameDeclaredTyParam(l, d) }
  !tyHasTyVar(d)
}

// Whether a member of `ms` is a declared type parameter or a parameter hole.
export function unionHasDeclaredParam(ms: i32[]): boolean {
  for m in ms {
    if tyIsGradualParam(m) { return true }
  }
  false
}

// Whether `a` and `b` are two rows of one declared type parameter or one parameter's hole:
// substitution matches by name.
export function sameDeclaredTyParam(a: i32, b: i32): boolean {
  const ta = tyAt(a)
  const tb = tyAt(b)
  if ta is TyVar {
    if tb is TyVar {
      if ta.tvName != tb.tvName { return false }
      return tyIsDeclaredParam(a) || tyIsNamedParamHole(a)
    }
  }
  false
}

// Whether collapsing `o` into `u` would drop a null: `u` holds a declared type parameter, or a
// parameter's hole in its own body, and no null, `o` bears one. The parameter accepts null only
// until a pin binds it (D2533, D3487, D3497).
export function paramJoinDropsNull(u: i32, o: i32): boolean {
  if u < 0 || o < 0 || u >= T.tys.length || o >= T.tys.length { return false }
  if !isNullTy(o) && !tyBearsNull(o) { return false }
  if isNullTy(u) || tyBearsNull(u) { return false }
  const ms: i32[] = []
  flattenVariantsInto(u, ms)
  for m in ms {
    if m >= 0 && m < T.tys.length {
      if tyIsDeclaredParam(m) { return true }
      if tyIsNamedParamHole(m) && tyParamOfInnermostBody(m) { return true }
      if tyIsNamedParamHole(m) && lamParamOfOpenBody(m) { return true }
    }
  }
  false
}

// Whether `t` is a union holding a declared type parameter, decided per instance.
export function tyIsParamUnion(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const u = tyAt(t)
  u is TyUnion && unionHasDeclaredParam(u.uMembers)
}

// How many `if`/`match` arm joins are being taken: the one place `tpOpenJoin` applies.
export let tpArmJoinDepth = 0

// Whether `t` is a union, or a nullable one, holding a type variable and no join's mark.
export function writtenTpUnion(t: i32): boolean {
  if t < 0 || t >= T.tys.length || tyIsTpJoinUnion(t) || !tyHasTyVar(t) {
    return false
  }
  const u = nonNullTy(t)
  u >= 0 && u < T.tys.length && tyAt(u) is TyUnion
}

// Gives `to` the mark `from` carries as a join kept apart, if any.
export function tpJoinCarry(from: i32, to: i32) {
  const j = tpJoinUnions.get(from)
  if j != null { tpJoinUnions[to] = j }
  0
}

// Marks a join kept apart over a type parameter (`tpJoinUnions`), or the union inside its
// nullable, as one of runtime arms: a pin re-joins its members apart too (`rejoinMembers`).
export function markTpJoinApart(j: i32) {
  if j < 0 || j >= T.tys.length || tpJoinUnions.length == 0 { return 0 }
  if tpJoinUnions.has(j) { tpJoinUnions[j] = 2 }
  const jt = tyAt(j)
  if jt is TyNullable {
    if tpJoinUnions.has(jt.nInner) { tpJoinUnions[jt.nInner] = 2 }
  }
  0
}

// Whether `t` is arithmetic over a declared type parameter or a parameter's hole, beside an
// `i64` or `f64` operand when `wide`: a pin may type it apart from that parameter, so a join
// keeps the two apart (D9631, D9680).
function paramArithHole(t: i32, wide: boolean): boolean {
  const r = hdRowOf(t)
  if r < 0 || hdKind[r] != HD_BINOP || (wide && hdAlt[r] < 0) { return false }
  tyIsGradualParam(hdRootTy(t))
}

// The join of `a` and `b` when every member is a declared type parameter, a null, or a
// parameter's arithmetic where one member is beside a wide operand (`paramArithHole`), and one
// parameter is the checked body's own: each member once, re-joined at each pin. -1 otherwise.
export function tpOpenJoin(a: i32, b: i32): i32 {
  if tpArmJoinDepth == 0 { return -1 }
  const ms: i32[] = []
  flattenVariantsInto(a, ms)
  flattenVariantsInto(b, ms)
  const kept: i32[] = []
  let hasNull = false
  let open = false
  let anyWide = false
  for m in ms {
    if paramArithHole(m, true) { anyWide = true }
  }
  for m in ms {
    if m < 0 || m >= T.tys.length || m == TY_ERR || m == TY_VOID { return -1 }
    const mt = tyAt(m)
    if isNullTy(m) {
      hasNull = true
    } else if mt is TyVar {
      const wide = anyWide && paramArithHole(m, false)
      if !wide && !tyIsGradualParam(m) { return -1 }
      if tyParamOfInnermostBody(hdRootTy(m)) { open = true }
      let dup = false
      for k in kept {
        if k == m || sameDeclaredTyParam(k, m) { dup = true }
        if wide && tyEqSameHoles(k, m) { dup = true }
      }
      if !dup { kept.push(m) }
    } else {
      // A concrete member is joined by the rules above (D2906, D3212).
      return -1
    }
  }
  if !open || kept.length == 0 { return -1 }
  if kept.length == 1 {
    if !hasNull { return -1 }
    noteHoleTpJoin(kept[0])
    return mkNullableTy(kept[0])
  }
  const u = mkUnionTy(kept)
  tpJoinUnions[u] = 1
  noteHoleTpJoin(u)
  if !hasNull { return u }
  const res = mkNullableTy(u)
  tpJoinUnions[res] = 1
  res
}

// Whether `t` is a join `joinTys` kept apart over a type parameter, re-joined at each pin.
export function tyIsTpJoinUnion(t: i32): boolean {
  t >= 0 && tpJoinUnions.length > 0 && tpJoinUnions.has(t)
}

// Whether `p` is a bare declared type parameter of a body being checked and `c` a concrete
// non-null value type. Outside its body an unbound parameter is absorbed as before.
export function tyParamBesideBare(p: i32, c: i32): boolean {
  if p < 0 || c < 0 || p >= T.tys.length || c >= T.tys.length { return false }
  if c == TY_VOID || isNullTy(c) { return false }
  if tyIsNonNullHoleRead(p) { return tyParamBesideBare(holeBaseTy(p), c) }
  if tyIsNamedParamHole(p) { return holeParamBesideConcrete(p, c) }
  tyParamBesideConcrete(p, c) && tyParamOfOpenBody(p)
}

// The inner parameter of `p`, a nullable bare declared parameter of a body being checked beside
// `c`, a concrete non-null value type; -1 when `p` is no such nullable (D4174).
export function nullParamBesideBare(p: i32, c: i32): i32 {
  if p < 0 || p >= T.tys.length { return -1 }
  const tp = tyAt(p)
  if !(tp is TyNullable) || !(tyAt(tp.nInner) is TyVar) { return -1 }
  if !tyParamBesideBare(tp.nInner, c) { return -1 }
  tp.nInner
}

// Whether `p` is a declared type parameter of a body being checked and `h` an operator's pending
// answer there (`a ?? 5`): the answer resolves at each pin, so taking it alone drops `p`'s values.
export function tyParamBesideDerived(p: i32, h: i32): boolean {
  if p < 0 || h < 0 || p >= T.tys.length || h >= T.tys.length || p == h {
    return false
  }
  const tp = tyAt(p)
  if !(tp is TyVar) || tp.tvName.length == 0 || hdRowOf(h) < 0 { return false }
  // A parameter's hole of the body being checked is an implicit type parameter.
  if tyIsNamedParamHole(p) { return tyParamOfInnermostBody(p) }
  tp.tvName[0] != "?"[0] && tyParamOfOpenBody(p)
}

// Whether `p` is a parameter's hole of the body being checked and `c` a type holding no
// variable: the hole is an implicit type parameter, apart from `c` as a declared one is.
export function holeParamBesideConcrete(p: i32, c: i32): boolean {
  if p < 0 || c < 0 || p >= T.tys.length || c >= T.tys.length { return false }
  if !tyIsNamedParamHole(p) { return false }
  c != TY_ERR && !tyHasTyVar(c) && tyParamOfInnermostBody(p)
}

// Whether type variable `p` names a type parameter of the innermost declaration being checked,
// whose joins keep parameters apart: not inside a lambda, whose instances do not yet build such
// a join (D3358).
export function tyParamOfInnermostBody(p: i32): boolean {
  const tp = tyAt(p)
  if tp is TyVar {
    const k = cstrOwnerStack.length - 1
    if k < 0 { return false }
    const owner = cstrOwnerStack[k]
    if owner >= 0 && owner < P.nodes.length {
      const fd = nodeAt(owner)
      if fd is FuncDecl {
        for nm in fd.fnTyParams {
          if nm == tp.tvName { return true }
        }
        if lamCheckDepth == 0 && holeNameOfDecl(tp.tvName, owner) {
          return true
        }
      }
    }
    // A nested generic's body is checked under its encloser's constraint owner.
    if (
      curFnDeclIx >= 0
      && curFnDeclIx < P.nodes.length
      && curFnDeclIx != owner
    ) {
      const cd = nodeAt(curFnDeclIx)
      if cd is FuncDecl {
        for nm in cd.fnTyParams {
          if nm == tp.tvName { return true }
        }
      }
    }
  }
  false
}

// Whether `p` is a declared type parameter, or a parameter's hole, of a declaration whose body
// is being checked.
function gradualParamOfOpenBody(p: i32): boolean {
  if tyIsDeclaredParam(p) { return tyParamOfOpenBody(p) }
  if !tyIsNamedParamHole(p) { return false }
  const tp = tyAt(p)
  if tp is TyVar {
    for owner in cstrOwnerStack {
      if holeNameOfDecl(tp.tvName, owner) { return true }
    }
  }
  false
}

// Whether `p` is such a parameter seen from inside a lambda in that body, where a join keeps
// its `null` apart as the body's own does (D3506). A call re-folding its callee's deferred
// return is no lambda body (D3520).
function lamParamOfOpenBody(p: i32): boolean {
  lamCheckDepth > lamRefoldDepth && gradualParamOfOpenBody(p)
}

// Whether type variable `p` names a type parameter of a declaration whose body is being checked.
function tyParamOfOpenBody(p: i32): boolean {
  const tp = tyAt(p)
  if tp is TyVar {
    for owner in cstrOwnerStack {
      if owner >= 0 && owner < P.nodes.length {
        const fd = nodeAt(owner)
        if fd is FuncDecl {
          for nm in fd.fnTyParams {
            if nm == tp.tvName { return true }
          }
        }
      }
    }
  }
  false
}

// A call's deferred join `tyIx` as a union each pin of the body being checked re-joins apart,
// when `keep` (the callee joins its arms apart, or declares its return) and every member is
// that body's own parameter; -1 for `collapseDeferredJoin` to decide.
export function keptParamUnion(tyIx: i32, keep: boolean): i32 {
  if tyIx < 0 || tyIx >= T.tys.length || !keep { return -1 }
  const ms: i32[] = []
  flattenVariantsInto(tyIx, ms)
  const own: i32[] = []
  let nul = false
  for m in ms {
    if isNullTy(m) { nul = true }
    else if !i32ListHas(own, m) { own.push(m) }
  }
  const tc = mkUnionTy(own)
  if !tpOwnParamsOnly(tc) { return -1 }
  tpJoinUnions[tc] = 2
  noteHoleTpJoin(tc)
  if !nul { return tc }
  // The null stays the wrapper, as a body declaring these parameters keeps it (D3612).
  const res = mkNullableTy(tc)
  tpJoinUnions[res] = 2
  noteHoleTpJoin(res)
  res
}

// Whether deferred join `tyIx` is two or more of the checked body's own parameters beside a null:
// the callee boxes that join at every pin, so it is kept rather than collapsed. Without the null
// a pin may join the two as one number, which only the collapse reads (D3612).
export function joinOverOwnParams(tyIx: i32): boolean {
  if tyIx < 0 || tyIx >= T.tys.length { return false }
  const ms: i32[] = []
  flattenVariantsInto(tyIx, ms)
  const own: i32[] = []
  let nul = false
  for m in ms {
    if isNullTy(m) { nul = true }
    else if !i32ListHas(own, m) { own.push(m) }
  }
  if !nul || own.length < 2 { return false }
  for m in own {
    if !tyIsGradualParam(m) || !tyParamOfInnermostBody(m) { return false }
  }
  true
}

// Whether union `t`'s members are two or more parameters of the body being checked, declared or
// holes, and nothing else.
function tpOwnParamsOnly(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const u = tyAt(t)
  if !(u is TyUnion) || u.uMembers.length < 2 { return false }
  for m in u.uMembers {
    if !tyIsGradualParam(m) || !tyParamOfInnermostBody(m) { return false }
  }
  true
}

// Whether deferred join `tyIx` holds two or more type parameters, or parameter holes, of a body
// being checked and no other hole: a lambda's join of them, which each instance builds at its pin.
export function deferredJoinOverOpenParams(tyIx: i32): boolean {
  if tyIx < 0 || tyIx >= T.tys.length { return false }
  const ms: i32[] = []
  flattenVariantsInto(tyIx, ms)
  const names: string[] = []
  let hole = false
  let nul = false
  for m in ms {
    if m < 0 || m >= T.tys.length { return false }
    const mt = tyAt(m)
    if isNullTy(m) { nul = true }
    if mt is TyVar {
      if !gradualParamOfOpenBody(m) { return false }
      if !tyIsDeclaredParam(m) { hole = true }
      let seen = false
      for nm in names {
        if nm == mt.tvName { seen = true }
      }
      if !seen { names.push(mt.tvName) }
    }
  }
  // A hole instance reads a join of holes only through its null (D3616).
  names.length >= 2 && (nul || !hole)
}

// A type that is, or wraps, a deferred join — a union still carrying a hole member. It denotes no
// runtime shape of its own: each call site re-folds it to the single arm that site's pinned
// argument reaches, so the codegen-support floors that reject a genuine inferred union skip it.
export function tyIsDeferredJoin(tyIx: i32) {
  if tyIx < 0 { return false }
  // A declared parameter's join with a concrete type is a real union, not a placeholder.
  if tpJoinUnions.length > 0 && tpJoinUnions.has(tyIx) { return false }
  const t = tyAt(tyIx)
  match t {
    TyNullable => {
      return tyIsDeferredJoin(t.nInner)
    }
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        if tyIsHole(t.uMembers[i]) { return true }
        i = i + 1
      }
      return false
    }
    // no other type wraps a deferred join
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
  }
  false
}

// A deferred join with a concrete, non-null arm beside its holes (`string | _`): every pin
// re-folds it to a union wider than the hole alone. False for `_ | null` and for a join of
// holes only, which a pin may fold to one of its holes (D3125, D3616).
export function tyIsArmedDeferredJoin(tyIx: i32): boolean {
  if !tyIsDeferredJoin(tyIx) || tyBearsNull(tyIx) { return false }
  const t = tyAt(tyIx)
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    if !tyIsHole(t.uMembers[i]) { return true }
    i = i + 1
  }
  false
}

// The hole name of parameter `pi`, its identity across the hoist, the body check and the solve
// table: a registered top-level declaration keys on its name and position, a nested namesake adds
// its original declaration node (D13281), and an anonymous lambda keys on its node alone, also
// once emission has named it `__lambda_N`.
export function paramHoleName(fnName: string, fnIx: i32, pi: i32) {
  const anon = fnName.length > 9
    && fnName.slice(0, 9) == "__lambda_"
    && !fnDeclIx.has(fnName)
  if fnName == "" || anon { return "?#L" + i32ToStr(fnIx) + "." + i32ToStr(pi) }
  const top = fnDeclIx[fnName] ?? -1
  let o = declOrigOf(fnIx)
  if o < 0 { o = fnIx }
  if top == fnIx || top == o { return "?" + fnName + "." + i32ToStr(pi) }
  "?" + fnName + "@" + i32ToStr(o) + "." + i32ToStr(pi)
}

// Is `name` the hole name of one of `fnIx`'s own parameters? A probe's body reaches
// other functions' holes too (a callee's un-annotated parameter, a nested function's),
// and those are not this declaration's to solve.
export function holeNameIsParamOf(
  name: string,
  fnName: string,
  fnIx: i32,
  nParams: i32,
) {
  let k = 0
  while k < nParams {
    if paramHoleName(fnName, fnIx, k) == name { return true }
    k = k + 1
  }
  false
}

// The uncollapsed deferred join a call site could not decide, parked under that call's node
// index. `collapseDeferredJoin` hands the emitter-safe collapse out as the call's type — a
// deferred join has no runtime shape — but that collapse is lossy, so the return-inference
// path reads the parked join back (`inferRetTyOf`). Only that path reads it.
export let dJoinNode: i32[] = []
export let dJoinTy: i32[] = []

// The deferred joins `inferRetTyOf` has handed a return accumulator, by type: a call's join,
// not a join of the returning body's own arms. Rolled back with the dJoin rows.
export let dJoinRelayed: {[i32]: boolean} = Map()
export function dJoinRelayedMark(t: i32) {
  undoSetBool(UM_DJOIN_RELAYED, dJoinRelayed, t, true)
}

// Deferred joins that escaped a call site lossily — the collapse handed out one arm while the
// join still named holes this site could not pin. Parallel arrays: the uncollapsed join, the
// call node to anchor a diagnostic on, and the callee's name. `validateEscJoins` re-folds each
// at the pinning call and rejects loudly when the arms really do disagree.
export let escJoinTy: i32[] = []
export let escJoinIx: i32[] = []
export let escJoinWho: string[] = []

// The body each join escaped inside (`cstrOwnerTop`), -1 at module scope (D2805).
export let escJoinFn: i32[] = []

// The if-joins a generic body keeps apart (`tpIfJoinAt`), by owning declaration, re-asked at
// each call that pins the owner.
export let tpIfFn: i32[] = []
export let tpIfJoin: i32[] = []
export let tpIfNode: i32[] = []

// Whether each row's join is delivered where an instance builds its union (`tpIfMarkOk`).
export let tpIfOk: boolean[] = []

// The apart join a generic body reads collapsed (`T[]` beside `string[]` is `T[]`), by `if`
// node, which a pin re-joins (D2832); rolled back with the rows.
export let tpIfJoinAt: {[i32]: i32} = Map()
export function tpIfJoinAtSet(ix: i32, aj: i32) {
  undoSetI32(UM_TP_IF_JOIN_AT, tpIfJoinAt, ix, aj)
}

// The `if`s and `match`es delivered where an instance builds that union (`tpIfMarkOk`). Every
// rollback puts back a probe's marks (`tpIfOkAtUndo`), since the pass that keeps a node marks
// it again.
export let tpIfOkAt: {[i32]: boolean} = Map()
export function tpIfOkAtMark(ix: i32) {
  undoSetBool(UM_TP_IF_OK_AT, tpIfOkAt, ix, true)
}

export function tpIfOkAtUndo(undo: i32) {
  tpIfOkAt = undoReplayBool(undo, UM_TP_IF_OK_AT, tpIfOkAt)
}

// A call from a generic body whose pin leaves such a join open: the callee, the caller that
// pins it later, and the callee's bindings and parameter types in the caller's terms.
export let tpIfReFn: i32[] = []
export let tpIfReOwner: i32[] = []
export let tpIfReStart: i32[] = []
export let tpIfReCount: i32[] = []
export let tpIfReNames: string[] = []
export let tpIfReTys: i32[] = []
export let tpIfReParams: i32[][] = []

export function tpIfFnHasRow(fn: i32): boolean {
  let k = 0
  while k < tpIfFn.length {
    if tpIfFn[k] == fn { return true }
    k = k + 1
  }
  false
}

// Parks the bindings of a call to `fn` its caller `owner` pins later, with `fn`'s parameters.
export function noteTpIfRe(
  fn: i32,
  owner: i32,
  names: string[],
  tys: i32[],
  params: i32[],
) {
  let k = 0
  while k < tpIfReFn.length {
    if (
      tpIfReFn[k] == fn
      && tpIfReOwner[k] == owner
      && tpIfReCount[k] == tys.length
    ) {
      let same = true
      let q = 0
      while q < tys.length && same {
        if !tyEq(tpIfReTys[tpIfReStart[k] + q], tys[q]) { same = false }
        q = q + 1
      }
      if same { return 0 }
    }
    k = k + 1
  }
  tpIfReFn.push(fn)
  tpIfReOwner.push(owner)
  tpIfReStart.push(tpIfReNames.length)
  tpIfReCount.push(names.length)
  let i = 0
  while i < names.length {
    tpIfReNames.push(names[i])
    tpIfReTys.push(tys[i])
    i = i + 1
  }
  const ps: i32[] = []
  let p = 0
  while p < params.length {
    ps.push(params[p])
    p = p + 1
  }
  tpIfReParams.push(ps)
  0
}

// Drops the deferred-join rows past `n`, both columns together, and the relays logged since
// `undo`.
export function dJoinTruncate(n: i32, undo: i32) {
  dJoinRelayed = undoReplayBool(undo, UM_DJOIN_RELAYED, dJoinRelayed)
  while dJoinNode.length > n {
    dJoinNode.pop()
    dJoinTy.pop()
  }
  0
}

// Drops the escaped-join rows past `n`, every column together.
export function escJoinTruncate(n: i32) {
  while escJoinTy.length > n {
    escJoinTy.pop()
    escJoinIx.pop()
    escJoinWho.pop()
    escJoinFn.pop()
  }
  0
}

// Drops the `tpIf*` rows past `rows` and the `tpIfRe*` rows past `res`; the latter's names and
// types are spans `tpIfReStart` indexes, so they are left for the next row to overwrite.
// `tpIfJoinAt` puts back each write logged since `undo`.
export function tpIfTruncate(rows: i32, res: i32, undo: i32) {
  tpIfJoinAt = undoReplayI32(undo, UM_TP_IF_JOIN_AT, tpIfJoinAt)
  while tpIfFn.length > rows {
    tpIfFn.pop()
    tpIfJoin.pop()
    tpIfNode.pop()
    tpIfOk.pop()
  }
  while tpIfReFn.length > res {
    tpIfReFn.pop()
    tpIfReOwner.pop()
    tpIfReStart.pop()
    tpIfReCount.pop()
    tpIfReParams.pop()
  }
  0
}

// The joins typed by their destination rather than their arms.
export let joinByWant: {[i32]: boolean} = Map()

// Clears the deferred, escaped and `tpIf*` join rows, their keyed maps and `joinByWant` for a new
// program.
export function joinRowsReset() {
  tpIfFn = []
  tpIfJoin = []
  tpIfNode = []
  tpIfOk = []
  tpIfReFn = []
  tpIfReOwner = []
  tpIfReStart = []
  tpIfReCount = []
  tpIfReNames = []
  tpIfReTys = []
  tpIfReParams = []
  dJoinNode = []
  dJoinTy = []
  dJoinRelayed = Map()
  tpIfJoinAt = Map()
  tpIfOkAt = Map()
  escJoinTy = []
  escJoinIx = []
  escJoinWho = []
  escJoinFn = []
  joinByWant = Map()
  0
}
