// `check_inst_keys.vl` — the instance-key shadow (STORE stage A0): the instances the check's
// per-call bindings (`instVecAt` rows) close to by substitution, against the keys the elaboration
// minted; and the storage shadow (B0): per call, parameter and set, the facts a storage decision
// per (key, parameter) reads. Built only when the host asks (`$VL_INST_KEYS`); nothing reads it.
// Design: the STORE instance-key note in docs/internals/refactor-notes/.

import {
  BinExpr,
  Call,
  FuncDecl,
  Ident,
  LetDecl,
  P,
  Param,
  TypeRef,
  fnNameIsLambda,
  i32ToStr,
  nodeAt,
} from "./ast"
import {
  instVecCalleeAt,
  instVecCount,
  instVecIxAt,
  instVecNamesAt,
  instVecTysAt,
} from "./check_bind_rows"
import { cwIxBuild, cwIxParent, cwLetUnwritten } from "./check_write_scan"
import { arrowArgsOf, arrowCount } from "./check_arrow"
import {
  arrowHolePrefix,
  arrowParamDeclOf,
  arrowPathRoot,
  arrowPathTy,
  arrowRowBinding,
  arrowSetsHeld,
  arrowSetsOf,
  arrowSrcOf,
} from "./check_arrow_facts"
import { fnTagMembers, fnTagSetIsTagged, fnTagSetOfTy } from "./check_elab_cap"
import { nodeTyIxOf } from "./check_node_tys"
import { setMemberRetAt, substTyDeepUnbanked } from "./check_relate_core"
import { TY_NEVER, TY_VOID, mkFuncTy } from "./check_types"
import { tyHasTyVar } from "./tyquery"
import { ekDecl, ekNames, ekTys, elabKeyStrFor, elabKeyStrs } from "./emit_elab"
import { MONO_NEST_MAX } from "./emit_mono"
import { parenPeelIx } from "./check_places"
import { identDeclOf } from "./symbols"
import { i32ListHas, strListHas } from "./listutil"
import { setBindWrittenJoin } from "./check_set_bind"
import { mintSeedWideOfParam } from "./check_mint"

let ikRows: string[] = []

// Builds the report rows; returns how many.
export function instKeysBuild(): i32 {
  ikRows = []
  cwIxBuild()
  // Per declaration, the bindings it is instanced at, as the check's rows close them.
  const keyNames: {[i32]: string[][]} = Map()
  const keyTys: {[i32]: i32[][]} = Map()
  const seen: {[string]: boolean} = Map()
  const checkKeys: string[] = []
  const work: i32[] = []
  const workDepth: i32[] = []
  let openFn = 0
  let openHole = 0
  let openCanon = 0
  let openUnbound = 0
  let plain = 0
  let capped = 0
  let arrowKeys = 0
  let openArrowArgs = 0
  let openArrowShape = 0
  // Roots: rows whose binding is closed as recorded.
  let r = 0
  while r < instVecCount() {
    const d = instVecCalleeAt(r)
    if d < 0 {
      openFn = openFn + 1
    } else if !ikGeneric(d) {
      plain = plain + 1
    } else if ikUnbound(r) {
      openUnbound = openUnbound + 1
    } else if !ikRelative(r) {
      const ns: string[] = []
      const ts: i32[] = []
      const k = ikKeyFor(d, instVecNamesAt(r), instVecTysAt(r), [], [], ns, ts)
      if k == "" {
        openCanon = openCanon + 1
      } else if ikBindsNothing(d, k) {
        openUnbound = openUnbound + 1
      } else if !(seen[k] ?? false) {
        seen[k] = true
        checkKeys.push(k)
        ikKeyAdd(keyNames, keyTys, d, ns, ts)
        work.push(d)
        workDepth.push(0)
      }
    }
    r = r + 1
  }
  // A call through a function value is closed by the arrow rule's row at its outer call: each
  // member of the set its callee holds there takes the call's argument types (the join of a
  // SetBind with the parameter's BK_ARROW bounds, l2 design §4.3).
  let a = 0
  while a < arrowCount() {
    const args = arrowArgsOf(a)
    if !ikClosed(args) {
      openArrowArgs = openArrowArgs + 1
    } else {
      for st in arrowSetsOf(a) {
        for m in fnTagMembers(st) {
          if !ikGeneric(m) {
            plain = plain + 1
          } else {
            const bn: string[] = []
            const bt: i32[] = []
            if !ikMemberBinding(m, args, bn, bt) {
              openArrowShape = openArrowShape + 1
            } else {
              const ns: string[] = []
              const ts: i32[] = []
              const k = ikKeyFor(m, bn, bt, [], [], ns, ts)
              if k == "" {
                openCanon = openCanon + 1
              } else if ikBindsNothing(m, k) {
                openUnbound = openUnbound + 1
              } else if !(seen[k] ?? false) {
                seen[k] = true
                checkKeys.push(k)
                arrowKeys = arrowKeys + 1
                ikKeyAdd(keyNames, keyTys, m, ns, ts)
                work.push(m)
                workDepth.push(0)
              }
            }
          }
        }
      }
    }
    a = a + 1
  }
  // Each new instance of a declaration closes the open rows its body makes, by substitution.
  const done: {[string]: boolean} = Map()
  let w = 0
  while w < work.length {
    const e = work[w]
    const depth = workDepth[w]
    w = w + 1
    const ens = keyNames[e] ?? []
    const ets = keyTys[e] ?? []
    let ki = 0
    while ki < ens.length {
      const tag = i32ToStr(e) + "#" + i32ToStr(ki)
      if !(done[tag] ?? false) {
        done[tag] = true
        let q = 0
        while q < instVecCount() {
          const d = instVecCalleeAt(q)
          if (
            d >= 0
            && ikGeneric(d)
            && !ikUnbound(q)
            && ikRelative(q)
            && ikEnclosingFn(instVecIxAt(q)) == e
          ) {
            const st: i32[] = []
            for t in instVecTysAt(q) {
              st.push(substTyDeepUnbanked(t, ens[ki], ets[ki]))
            }
            if !ikClosed(st) {
              openHole = openHole + 1
            } else if depth + 1 >= MONO_NEST_MAX {
              capped = capped + 1
            } else {
              const ns: string[] = []
              const ts: i32[] = []
              const k = ikKeyFor(
                d,
                instVecNamesAt(q),
                st,
                ens[ki],
                ets[ki],
                ns,
                ts,
              )
              if k == "" {
                openCanon = openCanon + 1
              } else if ikBindsNothing(d, k) {
                openUnbound = openUnbound + 1
              } else if !(seen[k] ?? false) {
                seen[k] = true
                checkKeys.push(k)
                ikKeyAdd(keyNames, keyTys, d, ns, ts)
                work.push(d)
                workDepth.push(depth + 1)
              }
            }
          }
          q = q + 1
        }
      }
      ki = ki + 1
    }
  }
  // Rows whose binding stays open with no enclosing instance to close it.
  let q = 0
  while q < instVecCount() {
    const d = instVecCalleeAt(q)
    if d >= 0 && ikGeneric(d) && !ikUnbound(q) && ikRelative(q) {
      const e = ikEnclosingFn(instVecIxAt(q))
      if e < 0 || (keyNames[e] ?? []).length == 0 { openHole = openHole + 1 }
    }
    q = q + 1
  }
  const elab = elabKeyStrs()
  const inElab: {[string]: boolean} = Map()
  for k in elab { inElab[k] = true }
  let equal = 0
  const checkOnly: string[] = []
  for k in checkKeys {
    if inElab[k] ?? false { equal = equal + 1 } else { checkOnly.push(k) }
  }
  const elabOnly: string[] = []
  const elabSeen: {[string]: boolean} = Map()
  for k in elab {
    if !(seen[k] ?? false) && !(elabSeen[k] ?? false) {
      elabSeen[k] = true
      elabOnly.push(k)
    }
  }
  ikRows.push(
    "summary equal="
      + i32ToStr(equal)
      + " check-only="
      + i32ToStr(checkOnly.length)
      + " elab-only="
      + i32ToStr(elabOnly.length)
      + " open.fn-value="
      + i32ToStr(openFn)
      + " open.outer-hole="
      + i32ToStr(openHole)
      + " open.unbound="
      + i32ToStr(openUnbound)
      + " open.canon="
      + i32ToStr(openCanon)
      + " plain="
      + i32ToStr(plain)
      + " arrow="
      + i32ToStr(arrowKeys)
      + " open.arrow-args="
      + i32ToStr(openArrowArgs)
      + " open.arrow-shape="
      + i32ToStr(openArrowShape)
      + " capped="
      + i32ToStr(capped),
  )
  for k in checkOnly {
    ikRows.push("check-only " + ikNamed(k) + ikNearest(k, elab))
  }
  // Per declaration, whether some row calls it, and whether one of them closed to a key.
  const called: {[i32]: boolean} = Map()
  let c = 0
  while c < instVecCount() {
    const d = instVecCalleeAt(c)
    if d >= 0 { called[d] = true }
    c = c + 1
  }
  for k in elabOnly {
    const d = ikDeclOf(k)
    const why = if ikArgKeyed(k) { "arg-keyed" } else if !(called[d] ?? false) { "unrecorded" } else if (keyNames[d] ?? []).length == 0 { "open" } else { "differs" }
    ikRows.push("elab-only " + why + " " + ikNamed(k) + ikNearest(k, checkKeys))
  }
  ikStorageRows(inElab)
  return ikRows.length
}

// The storage shadow (STORE B0): one row per (key, function-holding parameter, set), with the
// facts a decision per row reads and why a row lacks them, beside the storage the elaboration
// gave the set. Appended to the report; nothing reads it.
function ikStorageRows(inElab: {[string]: boolean}) {
  // Per parameter declaration: the calls through it (nested: in a function inside its owner),
  // and whether it seeds a written binding.
  const callsOf: {[i32]: i32[]} = Map()
  const nestedOf: {[i32]: boolean} = Map()
  const seeds: {[i32]: i32[]} = Map()
  let freeJoins = 0
  let seedEq = 0
  let seedDiff = 0
  let seedCheckOnly = 0
  let seedOpen = 0
  // B1, per key, parameter and seeded binding: the join over the key's calls, and the elaboration's.
  const seedKeys: string[] = []
  const seedSeen: {[string]: boolean} = Map()
  const seedJoin: {[string]: i32[]} = Map()
  const seedOpenAt: {[string]: boolean} = Map()
  const seedElab: {[string]: string[]} = Map()
  const seedLabel: {[string]: string} = Map()
  const seedOwn: {[string]: string} = Map()
  let seedOwnN = 0
  let x = 0
  while x < P.nodes.length {
    const n = nodeAt(x)
    if arrowSrcOf(x) == x {
      if n is Call {
        const b = arrowParamDeclOf(arrowPathRoot(n.callFn))
        if b >= 0 {
          if ikEnclosingFn(x) == ikEnclosingFn(b) {
            const cs = callsOf[b] ?? []
            cs.push(x)
            callsOf[b] = cs
          } else {
            nestedOf[b] = true
          }
        }
      }
      if (
        n is LetDecl
        && n.letKw == "let"
        && n.letInit >= 0
        && !cwLetUnwritten(x)
      ) {
        const b = arrowParamDeclOf(n.letInit)
        if b >= 0 { ikSeedAdd(seeds, b, x) }
        // A written binding no parameter seeds joins the functions written to it in any instance.
        const js = setBindWrittenJoin(x, [], [])
        if b < 0 && js.length > 1 {
          freeJoins = freeJoins + 1
          ikRows.push(
            "seed free "
              + ikDeclName(ikEnclosingFn(x))
              + " "
              + n.letName
              + " "
              + ikMembersNames(js),
          )
        }
      }
      if n is BinExpr && n.binOp == "=" {
        const b = arrowParamDeclOf(n.binRight)
        const l = parenPeelIx(n.binLeft)
        const ld = if l >= 0 && l < P.nodes.length && nodeAt(l) is Ident { identDeclOf(l) } else { -1 }
        if b >= 0 && ld >= 0 && nodeAt(ld) is LetDecl {
          ikSeedAdd(seeds, b, ld)
        }
      }
    }
    x = x + 1
  }
  // Per set: rows, complete rows, open reasons, call shapes over complete rows, elab-only rows.
  const sets: i32[] = []
  const nRows: {[i32]: i32} = Map()
  const nDone: {[i32]: i32} = Map()
  const whys: {[i32]: string} = Map()
  const shapes: {[i32]: string[]} = Map()
  const nElab: {[i32]: i32} = Map()
  let rows = 0
  let done = 0
  let oKey = 0
  let oWritten = 0
  let oArgs = 0
  let oNested = 0
  let unmatched = 0
  let elabRows = 0
  // One row per call the check records (`instVecAt`), per parameter, per set its argument holds:
  // the argument node keeps the set the binding vector's signature loses.
  let r = 0
  while r < instVecCount() {
    const d = instVecCalleeAt(r)
    const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
    const cx = instVecIxAt(r)
    const cn = if cx >= 0 && cx < P.nodes.length { nodeAt(cx) } else { null }
    // The key the row closes to, "" when it stays open.
    const ns: string[] = []
    const ts: i32[] = []
    const key = if f is FuncDecl && cn is Call && ikGeneric(d) { ikStorageKey(r, d, f, cn, ns, ts) } else { "" }
    let i = 0
    while (
      f is FuncDecl
      && cn is Call
      && i < f.fnParams.length
      && i < cn.callArgs.length
    ) {
      const b = f.fnParams[i]
      const t = nodeTyIxOf(parenPeelIx(cn.callArgs[i]))
      const own = fnTagSetOfTy(t)
      const held: i32[] = []
      if own >= 0 { held.push(own) }
      arrowSetsHeld(t, held, [])
      for st in held {
        rows = rows + 1
        if !i32ListHas(sets, st) { sets.push(st) }
        nRows[st] = (nRows[st] ?? 0) + 1
        let why = ""
        if key == "" {
          why = "key"
          oKey = oKey + 1
        } else if !(inElab[key] ?? false) {
          why = "unmatched"
          unmatched = unmatched + 1
        } else if (seeds[b] ?? []).length > 0 {
          why = "written"
          oWritten = oWritten + 1
          // B1: the join each binding it seeds holds in this row's instance, against the
          // elaboration's (`mintSeed`).
          const handed: i32[][] = []
          let j = 0
          while j < f.fnParams.length {
            const ax = if j < cn.callArgs.length { parenPeelIx(cn.callArgs[j]) } else { -1 }
            const hs = if ax >= 0 { fnTagSetOfTy(nodeTyIxOf(ax)) } else { -1 }
            const ad = if ax >= 0 && ax < P.nodes.length && nodeAt(ax) is Ident { identDeclOf(ax) } else { -1 }
            // A declared function handed by name holds itself, a closed one included.
            const one = ad >= 0 && ad < P.nodes.length && nodeAt(ad) is FuncDecl
            handed.push(
              if hs >= 0 { fnTagMembers(hs) } else if one { [ad] } else { [] },
            )
            j = j + 1
          }
          for sd in seeds[b] ?? [] {
            const sk = key + "|" + i32ToStr(i) + "|" + i32ToStr(sd)
            const js = setBindWrittenJoin(sd, f.fnParams, handed)
            const was = seedJoin[sk] ?? []
            if !(seedSeen[sk] ?? false) {
              seedSeen[sk] = true
              seedKeys.push(sk)
              const elab: string[] = []
              for w in mintSeedWideOfParam(d, i, st) {
                elab.push(ikMembersNames(fnTagMembers(w)))
              }
              seedElab[sk] = elab
              seedLabel[sk] = f.fnName
                + " p"
                + i32ToStr(i)
                + " "
                + ikSetNames(st)
              seedOwn[sk] = ikSetNames(st)
            }
            // A value outside the join's reach leaves the key's join open.
            if js.length == 0 { seedOpenAt[sk] = true }
            for m in js {
              if !i32ListHas(was, m) { was.push(m) }
            }
            seedJoin[sk] = was
          }
        } else if nestedOf[b] ?? false {
          why = "nested"
          oNested = oNested + 1
        }
        let shape = ""
        if why == "" {
          for c in callsOf[b] ?? [] {
            const hn = nodeAt(c)
            // Only a call whose callee path holds this row's set is asked of it.
            if hn is Call && fnTagSetOfTy(arrowPathTy(t, hn.callFn)) == st {
              const args: i32[] = []
              for a in hn.callArgs {
                args.push(
                  substTyDeepUnbanked(nodeTyIxOf(parenPeelIx(a)), ns, ts),
                )
              }
              if !ikClosed(args) {
                why = "args"
              } else {
                const ft = mkFuncTy(args, TY_VOID)
                shape = shape + "("
                for m in fnTagMembers(st) {
                  shape = shape + i32ToStr(setMemberRetAt(m, ft)) + ","
                }
                shape = shape + ")"
              }
            }
          }
          if why == "args" { oArgs = oArgs + 1 }
        }
        if why == "" {
          done = done + 1
          nDone[st] = (nDone[st] ?? 0) + 1
          const sh = shapes[st] ?? []
          if shape != "" && !strListHas(sh, shape) { sh.push(shape) }
          shapes[st] = sh
        } else {
          const w = whys[st] ?? ""
          if w.indexOf(why) < 0 { whys[st] = w + " " + why }
        }
      }
      i = i + 1
    }
    r = r + 1
  }
  // The elaboration's instance rows: each instance's function-holding parameter, per set.
  let k = 0
  while k < ekDecl.length {
    const d = ekDecl[k]
    const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
    const key = if f is FuncDecl { elabKeyStrFor(d, ekNames[k], ekTys[k]) } else { "" }
    if f is FuncDecl && key != "" {
      for b in f.fnParams {
        const t = substTyDeepUnbanked(nodeTyIxOf(b), ekNames[k], ekTys[k])
        const held: i32[] = []
        const own = fnTagSetOfTy(t)
        if own >= 0 { held.push(own) }
        arrowSetsHeld(t, held, [])
        for st in held {
          elabRows = elabRows + 1
          if !i32ListHas(sets, st) { sets.push(st) }
          nElab[st] = (nElab[st] ?? 0) + 1
        }
      }
    }
    k = k + 1
  }
  let multi = 0
  for st in sets {
    if (shapes[st] ?? []).length > 1 { multi = multi + 1 }
  }
  ikRows.push(
    "storage summary rows="
      + i32ToStr(rows)
      + " complete="
      + i32ToStr(done)
      + " open.key="
      + i32ToStr(oKey)
      + " open.written="
      + i32ToStr(oWritten)
      + " open.args="
      + i32ToStr(oArgs)
      + " open.nested="
      + i32ToStr(oNested)
      + " unmatched="
      + i32ToStr(unmatched)
      + " elab="
      + i32ToStr(elabRows)
      + " sets="
      + i32ToStr(sets.length)
      + " multi-shape="
      + i32ToStr(multi),
  )
  for sk in seedKeys {
    const cj = ikMembersNames(seedJoin[sk] ?? [])
    const elab = seedElab[sk] ?? []
    // A join that adds nothing to the parameter's own set widens no storage.
    const own = cj == (seedOwn[sk] ?? "")
    const verdict = if seedOpenAt[sk] ?? false { "open" } else if elab.length == 0 && own { "unwidened" } else if elab.length == 0 { "check-only" } else if strListHas(elab, cj) { "equal" } else { "differs" }
    if verdict == "unwidened" { seedOwnN = seedOwnN + 1 }
    if verdict == "open" { seedOpen = seedOpen + 1 }
    if verdict == "check-only" { seedCheckOnly = seedCheckOnly + 1 }
    if verdict == "equal" { seedEq = seedEq + 1 }
    if verdict == "differs" { seedDiff = seedDiff + 1 }
    if verdict != "equal" && verdict != "unwidened" {
      ikRows.push(
        "seed "
          + verdict
          + " "
          + (seedLabel[sk] ?? "")
          + " check="
          + cj
          + " elab="
          + ikJoinStrs(elab),
      )
    }
  }
  ikRows.push(
    "seed summary equal="
      + i32ToStr(seedEq)
      + " differs="
      + i32ToStr(seedDiff)
      + " unwidened="
      + i32ToStr(seedOwnN)
      + " check-only="
      + i32ToStr(seedCheckOnly)
      + " open="
      + i32ToStr(seedOpen)
      + " free="
      + i32ToStr(freeJoins),
  )
  for st in sets {
    const ms = fnTagMembers(st)
    const elab = if ms.length == 1 { "direct" } else if fnTagSetIsTagged(st) { "id" } else { "closure" }
    ikRows.push(
      "storage set "
        + ikSetNames(st)
        + " elab="
        + elab
        + " rows="
        + i32ToStr(nRows[st] ?? 0)
        + " complete="
        + i32ToStr(nDone[st] ?? 0)
        + " shapes="
        + i32ToStr((shapes[st] ?? []).length)
        + " elab-rows="
        + i32ToStr(nElab[st] ?? 0)
        + " open:"
        + (whys[st] ?? ""),
    )
  }
  return 0
}

// The key call row `r` (`cn`, to `f` at `d`) closes to (`arrowRowBinding`); "" when open.
function ikStorageKey(
  r: i32,
  d: i32,
  f: FuncDecl,
  cn: Call,
  ns: string[],
  ts: i32[],
): string {
  const tys: i32[] = []
  if !arrowRowBinding(r, d, f, cn, tys) { return "" }
  return ikKeyFor(d, instVecNamesAt(r), tys, [], [], ns, ts)
}

// Notes that parameter `b` initialises or is written to binding `d`.
function ikSeedAdd(seeds: {[i32]: i32[]}, b: i32, d: i32) {
  const ds = seeds[b] ?? []
  if !i32ListHas(ds, d) { ds.push(d) }
  seeds[b] = ds
  return 0
}

// Declaration `d`'s name, `-` for none.
function ikDeclName(d: i32): string {
  const n = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  return if n is FuncDecl { n.fnName } else { "-" }
}

// `xs` joined with `|`.
function ikJoinStrs(xs: string[]): string {
  let out = ""
  for x in xs { out = if out == "" { x } else { out + "|" + x } }
  return out
}

// Set `s`'s members by name, `{a,b}`.
function ikSetNames(s: i32): string { return ikMembersNames(fnTagMembers(s)) }

// Declarations `ms` by name in declaration order, `{a,b}`.
function ikMembersNames(ms: i32[]): string {
  const ds: i32[] = []
  for m in ms {
    ds.push(m)
    let at = ds.length - 1
    while at > 0 && ds[at - 1] > m {
      ds[at] = ds[at - 1]
      at = at - 1
    }
    ds[at] = m
  }
  let out = ""
  for m in ds {
    const mn = nodeAt(m)
    const nm = if mn is FuncDecl && !fnNameIsLambda(mn.fnName) { mn.fnName } else { "<lambda>" }
    out = if out == "" { nm } else { out + "," + nm }
  }
  return "{" + out + "}"
}

export function instKeysLen(i: i32): i32 {
  return if i >= 0 && i < ikRows.length { ikRows[i].length } else { 0 }
}

export function instKeysAt(i: i32, j: i32): i32 {
  return if i >= 0 && i < ikRows.length && j >= 0 && j < ikRows[i].length { ikRows[i][j] } else { 0 }
}

// The key callee `d` takes at binding `names`/`tys`, made inside an instance of the enclosing
// declaration bound at `encNames`/`encTys`. A name the check padded with `never` takes the
// enclosing binding of that name, else is left to the elaboration's default (`elabCanon`). The
// binding used is left in `ns`/`ts`, which the key's own body calls substitute with.
function ikKeyFor(
  d: i32,
  names: string[],
  tys: i32[],
  encNames: string[],
  encTys: i32[],
  ns: string[],
  ts: i32[],
): string {
  let i = 0
  while i < names.length && i < tys.length {
    let t = tys[i]
    if t == TY_NEVER {
      let j = 0
      while j < encNames.length && j < encTys.length {
        if encNames[j] == names[i] { t = encTys[j] }
        j = j + 1
      }
    }
    if t != TY_NEVER {
      ns.push(names[i])
      ts.push(t)
    }
    i = i + 1
  }
  return elabKeyStrFor(d, ns, ts)
}

// Whether row `r` left one of its callee's names unbound: the check padded it with `never`, or
// named none of them.
function ikUnbound(r: i32): boolean {
  if instVecNamesAt(r).length == 0 && ikOwnVars(instVecCalleeAt(r)) {
    return true
  }
  for t in instVecTysAt(r) {
    if t == TY_NEVER { return true }
  }
  return false
}

// Whether key `k` of declaration `d` binds none of `d`'s own variables: the row named another
// declaration's, so it says nothing about `d`'s instance.
function ikBindsNothing(d: i32, k: string): boolean {
  return k.length > 0 && k[k.length - 1] == 124 && ikOwnVars(d)
}

// Whether declaration `d` has an instance per binding: it has a type parameter or an
// un-annotated one, or sits in a declaration that does.
function ikGeneric(d: i32): boolean {
  let e = d
  while e >= 0 {
    if ikOwnVars(e) { return true }
    e = ikEnclosingFn(e)
  }
  return false
}

// Whether declaration `d` has a type parameter or an un-annotated parameter of its own.
function ikOwnVars(d: i32): boolean {
  const n = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(n is FuncDecl) { return false }
  if n.fnTyParams.length > 0 { return true }
  for p in n.fnParams {
    const pn = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
    if pn is Param && pn.parType < 0 { return true }
  }
  return false
}

// Whether row `r` is read under an instance of its enclosing declaration: its binding is open, or
// its callee is nested in an un-annotated or generic declaration whose names it may read.
function ikRelative(r: i32): boolean {
  if !ikClosed(instVecTysAt(r)) { return true }
  const d = instVecCalleeAt(r)
  const e = ikEnclosingFn(d)
  const en = if e >= 0 && e < P.nodes.length { nodeAt(e) } else { null }
  if !(en is FuncDecl) { return false }
  if en.fnTyParams.length > 0 { return true }
  for p in en.fnParams {
    const pn = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
    if pn is Param && pn.parType < 0 { return true }
  }
  return false
}

// Member `m`'s binding at argument types `args`: a parameter with no annotation binds its hole,
// one annotated with a type parameter of `m` binds that name. False when an annotation reads a
// type parameter in a shape this does not solve, or the arity differs.
function ikMemberBinding(
  m: i32,
  args: i32[],
  names: string[],
  tys: i32[],
): boolean {
  const f = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { null }
  if !(f is FuncDecl) || f.fnParams.length != args.length { return false }
  let i = 0
  while i < f.fnParams.length {
    const pn = nodeAt(f.fnParams[i])
    if pn is Param {
      if pn.parType < 0 {
        names.push(arrowHolePrefix(f, m) + i32ToStr(i))
        tys.push(args[i])
      } else {
        const tn = nodeAt(pn.parType)
        if tn is TypeRef && ikNamesTyParam(f, tn.tyName) {
          names.push(tn.tyName)
          tys.push(args[i])
        } else if ikReadsTyParam(f, f.fnParams[i]) {
          return false
        }
      }
    }
    i = i + 1
  }
  return true
}

function ikNamesTyParam(f: FuncDecl, nm: string): boolean {
  for tp in f.fnTyParams {
    if tp == nm { return true }
  }
  return false
}

// Whether parameter node `p` of `f` is typed with one of `f`'s type parameters inside it.
function ikReadsTyParam(f: FuncDecl, p: i32): boolean {
  if f.fnTyParams.length == 0 { return false }
  const ty = nodeTyIxOf(p)
  return ty < 0 || tyHasTyVar(ty)
}

// Whether every type in `tys` is closed.
function ikClosed(tys: i32[]): boolean {
  for t in tys {
    if t < 0 || tyHasTyVar(t) { return false }
  }
  return true
}

function ikKeyAdd(
  keyNames: {[i32]: string[][]},
  keyTys: {[i32]: i32[][]},
  d: i32,
  names: string[],
  tys: i32[],
) {
  const ns = keyNames[d] ?? []
  const ts = keyTys[d] ?? []
  ns.push(names)
  ts.push(tys)
  keyNames[d] = ns
  keyTys[d] = ts
  return 0
}

// The declared function whose body holds node `x`, or -1.
function ikEnclosingFn(x: i32): i32 {
  let p = if x >= 0 && x < cwIxParent.length { cwIxParent[x] } else { -1 }
  while p >= 0 && p < P.nodes.length {
    if nodeAt(p) is FuncDecl { return p }
    p = if p < cwIxParent.length { cwIxParent[p] } else { -1 }
  }
  return -1
}

// Key `k` (`decl|bindings`) with its declaration's name in front.
// The declaration key `k` (`decl|bindings`) names, or -1.
function ikDeclOf(k: string): i32 {
  const c = k.indexOf("|")
  if c <= 0 { return -1 }
  let d = 0
  let i = 0
  while i < c {
    if k[i] < 48 || k[i] > 57 { return -1 }
    d = d * 10 + (k[i] - 48)
    i = i + 1
  }
  return d
}

// Whether key `k` is of the argument-keyed family: its bindings start with another `|` field.
function ikArgKeyed(k: string): boolean {
  const c = k.indexOf("|")
  if c < 0 { return false }
  const rest = k.slice(c + 1, k.length)
  const bar = rest.indexOf("|")
  const eq = rest.indexOf("=")
  return bar >= 0 && (eq < 0 || bar < eq)
}

// Key `k` (`decl|bindings`) with its declaration's name in front.
function ikNamed(k: string): string {
  const d = ikDeclOf(k)
  const n = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  const nm = if n is FuncDecl { n.fnName } else { "?" }
  return nm + " " + k
}

// The bindings in which key `k` differs from the nearest key of the same declaration in `others`.
function ikNearest(k: string, others: string[]): string {
  const c = k.indexOf("|")
  if c < 0 { return "" }
  const head = k.slice(0, c + 1)
  const mine = ikParts(k.slice(c + 1, k.length))
  let best = ""
  let bestN = -1
  for o in others {
    if o.length > head.length && o.slice(0, head.length) == head {
      const theirs = ikParts(o.slice(head.length, o.length))
      let diff = ""
      let n = 0
      for p in mine {
        let same = false
        for t in theirs {
          if t == p { same = true }
        }
        if !same {
          n = n + 1
          diff = diff + " " + p
        }
      }
      if bestN < 0 || n < bestN {
        bestN = n
        best = diff
      }
    }
  }
  return if bestN < 0 { " (no peer)" } else { " (differs:" + best + ")" }
}

function ikParts(s: string): string[] {
  const out: string[] = []
  let i = 0
  let j = 0
  while j < s.length {
    if s[j] == 59 {
      out.push(s.slice(i, j))
      i = j + 1
    }
    j = j + 1
  }
  if i < s.length { out.push(s.slice(i, s.length)) }
  return out
}
