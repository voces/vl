} from "./lint"
import {
  fmtAddComment,
  fmtResetComments,
  fmtSetSource,
  formatProgram,
} from "./format"
import { i32ListHas, strListHas } from "./listutil"

const vcAcc = cpAccNew()
// The in-module source channel, set when a VL caller already holds the source string
// — as opposed to the host channel below, which arrives one element at a time. Exactly
// one of the two is used per compile, so `vcSource` chooses between them on whether
// `vcAcc` holds anything rather than carrying a second flag to keep in step.
let vcSrcStr = ""
export function srcReset(): i32 {
  cpAccReset(vcAcc)
  vcSrcStr = ""
  0
}
export function srcPush(c: i32): i32 {
  cpAccPush(vcAcc, c)
  0
}
// Stages a source string directly, with no per-element round trip. A byte producer
// feeding a code-point consumer (`srcPush` per char, then `fromCodePoints`) re-encodes
// every non-ASCII character before the lexer sees it — `'é'` would lex as two
// characters. A string handed over as a string has no unit to get wrong.
export function srcSetStr(s: string): i32 {
  cpAccReset(vcAcc)
  vcSrcStr = s
  0
}
// ── the host-seed ABI stamp ───────────────────────────────────────────────────
// The number a `vl` binary checks before it trusts this seed, compared with `==`. A
// mismatch is silent wrong output at a successful exit code, not a loud failure — bump
// it in the same commit that changes the guest-host ABI it covers (`docs/internals/cli-design.md`).
export function hostAbi(): i32 { 2 }

// ── bulk source intake over linear memory ─────────────────────────────────────
// `srcPush` above is one host call per code point; this batched form replaces N calls
// with N/16384, the host writing a chunk into linear memory before `cpAccLoad` copies
// it out — WasmGC has no memory→GC-array copy, so only the call boundary is bought.
export function srcLoad(count: i32): i32 {
  cpAccLoad(vcAcc, count)
  0
}
function vcSource(): string {
  if cpAccEmpty(vcAcc) { return vcSrcStr }
  cpAccString(vcAcc)
}
// How many of `P.diags`' LEADING entries the module order/validate phase produced
// (an unresolvable specifier, an import cycle). `modCompile` runs that phase before a
// token is loaded and returns straight after, so its findings are always a prefix —
// which is what lets `diagStage` call them `import` rather than `parse`.
let modResolveDiagN = 0
// Clears the index-keyed `P.diags` side tables — the tokenless-diag position table in
// `tok_load.vl` and the parser's lossless column — in one home for the seven entry
// points that must stay in lockstep. A stale lossless entry claims a different program's
// diagnostic is lossless, the direction that wrongly lets the checker proceed.
function vcDgReset() {
  vcDgIdx = []
  vcDgLine = []
  vcDgCol = []
  vcDgEnd = []
  vcDgMod = []
  vcLoadMod = 0
  modResolveDiagN = 0
  dgLosslessReset()
  0
}

// ── H3 module-table state (globals precede their first textual use; the module
// SUBSYSTEM itself — exports, scan, pipeline, rewrite — lives at the bottom of
// this file) ──────────────────────────────────────────────────────────────────
let modKeys: string[] = []   // resolved module keys, [0] = the entry
let modSrcs: string[] = []   // module sources ("" when missing)
let modFound: i32[] = []     // 1 = read ok, 0 = host could not read the key
const modKeyAcc = cpAccNew() // accumulators for the NEXT commit
const modSrcAcc = cpAccNew()
// Key -> its FIRST row in `modKeys`; a key is an absolute path, so a scan's compares grow
// with the path's length as well as the table's.
let modKeyIx: {[string]: i32} = Map()
// Flat per-import-entry tables (filled by the token scan at each commit):
let impMod: i32[] = []      // importing module's table index
let impSpec: string[] = []  // the raw specifier text (diagnostics)
let impKey: string[] = []   // resolved key ("" = unsupported specifier)
let impName: string[] = []  // the exported (source) name ("" = bare import)
let impLocal: string[] = [] // the local binding name (after `as`)
// Source positions per import entry (1-based line, 0-based col): the imported name
// token and the specifier string token. `modVisit` anchors resolution diagnostics
// here — a spec-shaped problem (unsupported/unresolvable/cycle) at the specifier, a
// name-shaped one (not exported) at the name.
let impNameLine: i32[] = []
let impNameCol: i32[] = []
let impSpecLine: i32[] = []
let impSpecCol: i32[] = []
// The specifier's EXCLUSIVE end column, so the "unsupported specifier" report can
// underline the whole literal rather than its first character.
let impSpecEnd: i32[] = []
// What stood where the specifier belongs, one of the `SPEC_*` codes below. Only
// `SPEC_STRING` resolves; the others are recorded rather than skipped so the reader
// is told what stood there instead of getting an empty-specifier message (D3559).
let impSpecChar: i32[] = []
const SPEC_STRING = 0
// A char literal (`'std:fs'`); `impSpec` carries its raw lexeme for `importSpecCharMsg`.
const SPEC_CHAR = 1
// No path token at all: `import { x } from` or `export { x } from`, cut short.
const SPEC_ABSENT = 2
// An export list with no `from`: `export { x }`. Only a re-export takes a list.
const SPEC_NO_FROM = 3
// Flat per-module export-name sets (token scan: `export`-modified declarations).
let expMod: i32[] = []
let expName: string[] = []
// Re-exports (`export { a, b as c } from "spec"`): the public name each surfaces
// (`a`/`c`) and the importing module, parallel arrays. Also recorded as an import (so
// the symbol is pulled and the dependency edge exists), and drives the emitter to
// alias the merged target function under its bare public name in the export section.
let reExpMod: i32[] = []       // the re-exporting module's table index
let reExpPublic: string[] = [] // the public bare name (the `as` alias, else the source name)
let reExpLocal: string[] = []  // the local binding the import created (resolves to the target)
// The public name token's position and the `export` keyword's, parallel to
// `reExpPublic`, plus the resolved key of the module the name comes FROM. The editor
// surface needs a re-export to carry the same span pair a declaration does, and the
// origin key is what tells the two apart (a declaration has none).
let reExpNameLine: i32[] = []
let reExpNameCol: i32[] = []
let reExpKwLine: i32[] = []
let reExpKwCol: i32[] = []
let reExpKey: string[] = []
// Filled by `modCompile` once renames are known: the public name → the merged
// target function name, consumed by `emitProgram`'s export section. Defined on the
// emitter side and imported here so the driver→emitter→driver read forms no cycle.
// The export name token's position, parallel to `expName` — the go-to-definition target.
let expDeclLine: i32[] = []
let expDeclCol: i32[] = []
// The `export` KEYWORD token's source position, parallel to `expName` — the target
// for the "redundant export keyword" hint (an export imported by no other module).
let expKwLine: i32[] = []
let expKwCol: i32[] = []
// The modules each name is exported from, by `expName` row and by `reExpPublic` row: an index
// over the two tables' rows `[0, *Read)`, extended on each read and dropped by `modReset`.
let expOwnBy: {[string]: i32[]} = Map()
let expReBy: {[string]: i32[]} = Map()
let expOwnRead = 0
let expReRead = 0
// Resolved keys imported by committed modules that are neither committed nor
// marked missing — what the host fetch loop reads next. Recomputed per commit.
let modPending: string[] = []

// How many `impKey` rows `modRecomputePending` has read, and every key among them.
let modPendScanned = 0

let modPendSeen: {[string]: i32} = Map()

// DFS state: 0 unvisited, 1 loading (a back-edge is a cycle), 2 done; `modOrder`
// collects table indices dependency-first; `modDiags` the resolution errors.
let modState: i32[] = []
let modOrder: i32[] = []
let modDiags: string[] = []
// Per-module token-load ranges, recorded as each module's tokens append to the
// shared `P.toks` during `modCompile`: `modLoadStart[o]` is the first token index
// of the o-th loaded module, `modLoadMod[o]` its TABLE index. `modOfTok` maps an
// occurrence's token back to its owning module — cross-file find-references.
let modLoadStart: i32[] = []
let modLoadMod: i32[] = []
// Per-module rename map (`name` → `name$mN`) and the lexical shadow stack, keyed by
// interned id so a reader is one `sidLookup` plus one array read rather than a linear
// scan. Two index arrays because the readers disagree on a duplicate key by design:
// `modRenamed` takes the first matching row, `modRwTsName`/`modTypeRenamed` the last.
let modRenameTo: string[] = []
// The `from` keys, parallel to `modRenameTo`. The sid views index BY name and
// cannot be walked back to the spellings, and D1191's per-module UFCS scope is
// exactly a walk of this map: every row whose TARGET is a registered
// `self`-function is a plain name this module binds to one.
let modRenameFrom: string[] = []
const modRenameFirstBySid: i32[] = []
const modRenameLastBySid: i32[] = []
// The sids `modRenamePush` has set a slot of since the last `modRenameClear`.
let modRenameSids: i32[] = []
// The interned `from` of each row, parallel to `modRenameFrom`.
let modRenameRowSid: i32[] = []
// The collect pass's map of the o-th module in merge order, kept so the rewrite pass replays
// it rather than building it again; live only inside `modRewriteAll`.
let modRenameKeptTo: string[][] = []
let modRenameKeptFrom: string[][] = []
let modRenameKeptSid: i32[][] = []
// One string per merged name for the whole program, so every module's references to a
// declaration share one string and later compares answer by identity.
let modCanonTo: {[string]: string} = Map()
let modShadow: string[] = []
// Parallel to `modShadow`: the name the binding is renamed to, or "" when it keeps its own.
// Only a binding named like an ambient function is renamed (`modShadowBind`).
let modShadowTo: string[] = []
// The module whose suffix a renamed ambient-named binding takes.
let modAmbMod = 0
// The module whose statements `modRwStmt` is rewriting, -1 outside the rewrite.
let modRwMod = -1
// The callee `Ident` of the plain call being rewritten: a call, not a function value.
let modRwCalleeIx = -1
// Uses of an overloaded name the rewrite found, raised only when the set itself is legal:
// the node, its set row, and whether it is a plain call (else a function value).
let modOvUseIx: i32[] = []
let modOvUseRow: i32[] = []
let modOvUseCall: boolean[] = []
// The mangled name of every top-level free `self`-function across all modules, for the
// module UFCS scope rows (`modBankUfcsScope`).
let modSelfFnSet: {[string]: boolean} = Map()

function modSelfFnReset() {
  modSelfFnSet = Map()
  0
}

// Registers the `self`-function `name`.
function modSelfFnAdd(name: string) {
  modSelfFnSet[name] = true
  0
}
// Generic type-parameter names live inside the rewrite of their declaration
// (`T` while inside `id<T>`'s annotations/body or `Box<T>`'s definition): a
// segment matching one must NOT rewrite through the rename map — it names the
// parameter, not a top-level binding.
let modTyShadow: string[] = []
// D1571 — the merged targets of `type` declarations that took a builtin type name, the
// only rows allowed to rewrite such a name in type position. The rename map is one
// namespace but the language is two: a builtin has no declaration of its own, so
// without this its value row alone wrongly renamed `u8[]` too. Almost always empty.
let modBuiltinTyTargets: string[] = []
// ── per-instance module scan/token cache ──────────────────────────────────────
// One slot per module key, holding that module's import/export scan and its token
// stream, replayable under any later table index. A source change DROPS the key's
// slot, so an editor re-committing one file cannot bank a slot per keystroke.
let modCacheKeys: string[] = []
let modCacheSrcs: string[] = []
let modCacheImpOff: i32[] = []
let modCacheImpEnd: i32[] = []
let modCacheReOff: i32[] = []
let modCacheReEnd: i32[] = []
let modCacheExpOff: i32[] = []
let modCacheExpEnd: i32[] = []
// Each slot's token stream, the lexer's own array held by reference, and its length (-1 =
// not captured); a replay pushes those tokens as they are, which is sound because no pass
// writes a token or this array. Only a CLEAN tokenization (no lex diags) is cached, so a
// hit never has diags to re-fold. `modCacheTokLive` sums the live slots' captured lengths.
let modCacheTokArr: Tok[][] = []
let modCacheTokN: i32[] = []
let modCacheTokLive = 0
// The module's `///` rows, banked with its tokens because both come from the same lex: the
// cache exists so a module is not re-lexed, so a doc table filled only by `vcLoadToks` is
// empty for every module the cache serves (D1863).
let modCacheDocOff: i32[] = []
let modCacheDocEnd: i32[] = []
// Set by a host that compiles once per instance and then drops it (`setOneShot`). Such an
// instance never looks a module up again, so the cache is released once the parse has
// replayed it, which keeps it out of the heap the check and emit passes run in (D2317).
let modOneShot = 0
// What a non-trailing drop leaves behind: the slot itself, since its tokens go with their
// array. The whole cache clears once the dead slots outgrow the live ones, bounding the
// storage without a compaction pass.
let modCacheDeadSlots = 0
let modCacheClears = 0
// The token stream `modScan` just banked and its length (-1 = not banked), handed to
// `modScanCached` for the slot it appends. `modScan` is called from exactly one
// place and its result is recorded immediately, so scalars carry it
// without threading a return type through the scan.
let modScanToks: Tok[] = []
let modScanTokN = -1
let modScanDocOff = -1
let modScanDocEnd = -1
// Flat storage backing the slices above.
let modCacheImpSpec: string[] = []
let modCacheImpKey: string[] = []
let modCacheImpName: string[] = []
let modCacheImpLocal: string[] = []
let modCacheImpNameLine: i32[] = []
let modCacheImpNameCol: i32[] = []
let modCacheImpSpecLine: i32[] = []
let modCacheImpSpecCol: i32[] = []
let modCacheImpSpecEnd: i32[] = []
let modCacheImpSpecChar: i32[] = []
let modCacheRePublic: string[] = []
let modCacheReLocal: string[] = []
let modCacheReNameLine: i32[] = []
let modCacheReNameCol: i32[] = []
let modCacheReKwLine: i32[] = []
let modCacheReKwCol: i32[] = []
let modCacheReKey: string[] = []
let modCacheExpName: string[] = []
let modCacheExpDeclLine: i32[] = []
let modCacheExpDeclCol: i32[] = []
let modCacheExpKwLine: i32[] = []
let modCacheExpKwCol: i32[] = []
let modCacheDocLine: i32[] = []
let modCacheDocText: string[] = []
// The slot holding `key`, or -1. A dropped slot keeps its row but takes the empty
// key, which no module can carry, so it is skipped here and reused by nothing.
function modCacheSlotOfKey(key: string): i32 {
  if key == "" { return -1 }
  let i = 0
  while i < modCacheKeys.length {
    if modCacheKeys[i] == key { return i }
    i = i + 1
  }
  -1
}
// The cache slot for (key, src), or -1. The key has at most one slot, so a source
// that does not match it is a miss and the slot is the one about to be dropped.
function modCacheLookup(key: string, src: string): i32 {
  const i = modCacheSlotOfKey(key)
  if i >= 0 && modCacheSrcs[i] == src { return i }
  -1
}
// Empties every cache array. Called only when the dead rows outgrow the live ones;
// the cache is transparent, so the cost of a clear is one re-scan per module.
function modCacheClear(): i32 {
  modCacheKeys = []
  modCacheSrcs = []
  modCacheImpOff = []
  modCacheImpEnd = []
  modCacheReOff = []
  modCacheReEnd = []
  modCacheExpOff = []
  modCacheExpEnd = []
  modCacheTokArr = []
  modCacheTokN = []
  modCacheTokLive = 0
  modCacheDocOff = []
  modCacheDocEnd = []
  modCacheImpSpec = []
  modCacheImpKey = []
  modCacheImpName = []
  modCacheImpLocal = []
  modCacheImpNameLine = []
  modCacheImpNameCol = []
  modCacheImpSpecLine = []
  modCacheImpSpecCol = []
  modCacheImpSpecEnd = []
  modCacheImpSpecChar = []
  modCacheRePublic = []
  modCacheReLocal = []
  modCacheReNameLine = []
  modCacheReNameCol = []
  modCacheReKwLine = []
  modCacheReKwCol = []
  modCacheReKey = []
  modCacheExpName = []
  modCacheExpDeclLine = []
  modCacheExpDeclCol = []
  modCacheExpKwLine = []
  modCacheExpKwCol = []
  modCacheDocLine = []
  modCacheDocText = []
  modCacheDeadSlots = 0
  modCacheClears = modCacheClears + 1
  0
}
// Truncates `arr` back to `n`, for the trailing-row release below.
function modCachePopTo(arr: string[], n: i32): i32 {
  while arr.length > n { arr.pop() }
  0
}
function modCachePopToI(arr: i32[], n: i32): i32 {
  while arr.length > n { arr.pop() }
  0
}
// Releases slot `ci`. Its key, source and any TRAILING flat rows go immediately —
// the editor's own shape, since the file being edited commits first and so banked
// last. Rows that are not trailing are left behind; the slot's tokens go with their array.
function modCacheDrop(ci: i32): i32 {
  if modCacheTokN[ci] >= 0 {
    modCacheTokLive = modCacheTokLive - modCacheTokN[ci]
    modCacheTokN[ci] = -1
    const none: Tok[] = []
    modCacheTokArr[ci] = none
  }
  // The doc rows are a flat store with its own trailing test.
  const doff = modCacheDocOff[ci]
  if doff >= 0 && modCacheDocEnd[ci] == modCacheDocLine.length {
    modCachePopToI(modCacheDocLine, doff)
    modCachePopTo(modCacheDocText, doff)
  }
  if modCacheImpEnd[ci] == modCacheImpSpec.length {
    const ioff = modCacheImpOff[ci]
    modCachePopTo(modCacheImpSpec, ioff)
    modCachePopTo(modCacheImpKey, ioff)
    modCachePopTo(modCacheImpName, ioff)
    modCachePopTo(modCacheImpLocal, ioff)
    modCachePopToI(modCacheImpNameLine, ioff)
    modCachePopToI(modCacheImpNameCol, ioff)
    modCachePopToI(modCacheImpSpecLine, ioff)
    modCachePopToI(modCacheImpSpecCol, ioff)
    modCachePopToI(modCacheImpSpecEnd, ioff)
    modCachePopToI(modCacheImpSpecChar, ioff)
  }
  if modCacheReEnd[ci] == modCacheRePublic.length {
    const roff = modCacheReOff[ci]
    modCachePopTo(modCacheRePublic, roff)
    modCachePopTo(modCacheReLocal, roff)
    modCachePopToI(modCacheReNameLine, roff)
    modCachePopToI(modCacheReNameCol, roff)
    modCachePopToI(modCacheReKwLine, roff)
    modCachePopToI(modCacheReKwCol, roff)
    modCachePopTo(modCacheReKey, roff)
  }
  if modCacheExpEnd[ci] == modCacheExpName.length {
    const eoff = modCacheExpOff[ci]
    modCachePopTo(modCacheExpName, eoff)
    modCachePopToI(modCacheExpDeclLine, eoff)
    modCachePopToI(modCacheExpDeclCol, eoff)
    modCachePopToI(modCacheExpKwLine, eoff)
    modCachePopToI(modCacheExpKwCol, eoff)
  }
  modCacheKeys[ci] = ""
  modCacheSrcs[ci] = ""
  if ci == modCacheKeys.length - 1 {
    modCachePopTo(modCacheKeys, ci)
    modCachePopTo(modCacheSrcs, ci)
    modCachePopToI(modCacheImpOff, ci)
    modCachePopToI(modCacheImpEnd, ci)
    modCachePopToI(modCacheReOff, ci)
    modCachePopToI(modCacheReEnd, ci)
    modCachePopToI(modCacheExpOff, ci)
    modCachePopToI(modCacheExpEnd, ci)
    while modCacheTokArr.length > ci { modCacheTokArr.pop() }
    modCachePopToI(modCacheTokN, ci)
    modCachePopToI(modCacheDocOff, ci)
    modCachePopToI(modCacheDocEnd, ci)
  } else {
    modCacheDeadSlots = modCacheDeadSlots + 1
  }
  0
}
// The storage bound, applied after a bank rather than inside the drop: the editor drops a
// slot and re-banks the same key at once, so a check between the two reads one module's
// slot as half the cache and clears on every keystroke.
function modCacheBound(): i32 {
  if modCacheDeadSlots > modCacheKeys.length - modCacheDeadSlots {
    return modCacheClear()
  }
  0
}

// The entry source and the stream the lexer produced from it, held by reference: the bank
// is `P.toks` itself, never a second copy, so banking allocates nothing and keeps no extra
// stream alive for the collector to walk. `vcEtLen` is the length the lexer left, and only
// a diagnostic-free lex banks, so a replay owes no diagnostic either.
let vcEtSrc = ""
let vcEtToks: Tok[] = []
let vcEtLen = 0
// The doc table that lex produced, banked beside the stream: a replay restores `P.toks`
// without re-lexing, and one that left `docCmt*` behind would answer hover with whatever
// the previous file's lex had put there.
let vcEtDocLine: i32[] = []
let vcEtDocText: string[] = []
let vcEtDocMod: i32[] = []
// Releases the bank. Module mode never replays it — each module's stream comes from
// `vcLoadToksMod` — so a graph check that kept the previous file's array would hold a
// stream alive that nothing can read.
function vcEtDrop(): i32 {
  const fresh: Tok[] = []
  vcEtToks = fresh
  vcEtLen = 0
  vcEtSrc = ""
  vcEtDocLine = []
  vcEtDocText = []
  vcEtDocMod = []
  0
}
// `vcLoadToks` for the entry source, through the bank above: `tokenize` is a pure function
// of its source, so a later pass over the same bytes takes the array back instead of
// re-lexing. Both sides need an empty `P.toks`. The pop drops the deep-`is` stage's generated
// tail, the one thing appended after a bank.
function vcLoadToksEntry(src: string): i32 {
  vcEpDrop()
  if P.toks.length == 0 && vcEtLen > 0 && vcEtSrc == src {
    P.toks = vcEtToks
    while P.toks.length > vcEtLen { P.toks.pop() }
    docCmtLine = vcEtDocLine
    docCmtText = vcEtDocText
    docCmtMod = vcEtDocMod
    return P.toks.length
  }
  const tokBefore = P.toks.length
  const diagBefore = P.diags.length
  vcEtDrop()
  vcLoadToks(src)
  if tokBefore == 0 && P.diags.length == diagBefore {
    vcEtSrc = src
    vcEtToks = P.toks
    vcEtLen = P.toks.length
    vcEtDocLine = docCmtLine
    vcEtDocText = docCmtText
    vcEtDocMod = docCmtMod
  }
  P.toks.length
}
// The entry parse, banked by reference: `P.nodes` and its three parallel columns ARE the
// bank, so banking allocates nothing. `vcEpEpoch` is `arenaEpochNow()` as the parser left it
// — a fresh parse and every in-place arena rewrite bump it — so a replay is offered only a
// tree that is still the one banked, carrying rows appended past its lengths.
let vcEpSrc = ""
let vcEpRoot = -1
let vcEpEpoch = -1
let vcEpNodeN = 0
let vcEpTokN = 0
let vcEpDeclN = 0
let vcEpTplN = 0
let vcEpDupN = 0

// Releases the bank. Every entry token load takes it, since that load is what precedes a
// fresh parse; module mode and the graph lint take it for the same reason, one module ahead.
function vcEpDrop(): i32 {
  vcEpSrc = ""
  vcEpRoot = -1
  vcEpEpoch = -1
  0
}

// Bank the tree `parseProgram` just built for `src`. Only a diagnostic-free parse banks, so
// a replay owes no diagnostic and the `vcDg*` side tables stay the ones this parse filled.
function vcEpBank(src: string, root: i32): i32 {
  if P.diags.length > 0 { return vcEpDrop() }
  vcEpSrc = src
  vcEpRoot = root
  vcEpEpoch = arenaEpochNow()
  vcEpNodeN = P.nodes.length
  vcEpTokN = nodeToks.length
  vcEpDeclN = declNameTok.length
  vcEpTplN = tplHole.length
  vcEpDupN = recDupField.length
  0
}

// The banked root for `src` when the check left that tree intact, or -1. What a check leaves,
// table by table, is `perf-opportunities-2026-09.md` §B6c: rows APPENDED past these lengths,
// which the pop drops; four spellings rewritten in place, which the sweep's own bank puts
// back; and six slot rewrites, which the epoch retires the bank for.
function vcEpReplay(src: string): i32 {
  if vcEpEpoch < 0 || vcEpRoot < 0 { return -1 }
  if arenaEpochNow() != vcEpEpoch { return -1 }
  if vcEpSrc != src { return -1 }
  if P.nodes.length < vcEpNodeN || nodeToks.length < vcEpTokN { return -1 }
  if declNameTok.length < vcEpDeclN || tplHole.length < vcEpTplN { return -1 }
  if recDupField.length < vcEpDupN { return -1 }
  canonRestoreSpellings()
  while P.nodes.length > vcEpNodeN { P.nodes.pop() }
  sidNodeTruncate(vcEpNodeN)
  while nodeToks.length > vcEpTokN { nodeToks.pop() }
  while declNameTok.length > vcEpDeclN { declNameTok.pop() }
  while tplHole.length > vcEpTplN { tplHole.pop() }
  while recDupField.length > vcEpDupN { recDupField.pop() }
  vcEpRoot
}

// The top-level names a single-source program declared under an ambient function's name, each
// renamed to `name$m0` by `ambientRenameSingle`.
let ambTopRenamed: string[] = []

// Whether any node of the program binds an ambient function's name.
function progBindsAmbientName(): boolean {
  let i = 0
  while i < P.nodes.length {
    const n = nodeAt(i)
    let nm = ""
    if n is FuncDecl { nm = n.fnName }
    if n is LetDecl { nm = n.letName }
    if n is Param { nm = n.parName }
    if n is ForRange { nm = n.frVar }
    if n is ForIn {
      if isAmbientFnName(n.fiVar2) { return true }
      nm = n.fiVar
    }
    if nm != "" && isAmbientFnName(nm) { return true }
    i = i + 1
  }
  false
}

// The single-source half of the module merge's ambient rename: a binding named like an ambient
// function shadows it for its whole scope, the call and its type alike (spec Q11), so a program
// that binds one is walked once with only those rows. A program that binds none is untouched.
function ambientRenameSingle(root: i32): i32 {
  ambTopRenamed = []
  if !progBindsAmbientName() { return 0 }
  modRenameClear()
  modSelfFnReset()
  const r = nodeAt(root)
  if r is Program {
    for sx in r.progStmts {
      const st = nodeAt(sx)
      let nm = ""
      if st is FuncDecl { nm = st.fnName }
      if st is LetDecl { nm = st.letName }
      if nm != "" && isAmbientFnName(nm) && !strListHas(ambTopRenamed, nm) {
        ambTopRenamed.push(nm)
        modRenamePush(nm, nm + modSuffixOf(0))
      }
      if st is FuncDecl {
        if isAmbientFnName(st.fnName) && st.fnParams.length > 0 {
          const p0 = nodeAt(st.fnParams[0])
          if p0 is Param {
            if p0.parName == "self" { modSelfFnAdd(st.fnName + modSuffixOf(0)) }
          }
        }
      }
    }
  }
  modShadow = []
  modShadowTo = []
  modTyShadow = []
  modRwMod = -1
  modAmbMod = 0
  modRwStmt(root)
  modSelfFnReset()
  0
}

// The wasm export target of a single-source program's top-level `name`.
function ambTopTarget(name: string): string {
  if strListHas(ambTopRenamed, name) { return name + modSuffixOf(0) }
  name
}

// Parse-side state every entry that re-parses clears first. `callNever` and the sid-keyed
// tables are per-parse; a stale row would answer for the previous program's nodes.
function parseStateReset(): i32 {
  P.toks = []
  P.nodes = []
  sidReset()
  externReset()
  getDeclReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  recDupField = []
  callRestPacked = []
  callNever = []
  vcDgReset()
  0
}

// The reset prelude of a compile or check entry: the parse state, the emit-stage ABI (so a
// prior compile's `W`/`emitErr` cannot leak into a check's read-back or diagnostics) and
// the checker. The caller states the `symSetEnabled` mode and whether `vcEpBank` follows.
function pipelineReset(): i32 {
  parseStateReset()
  elabCapReset()
  ropeReset(W)
  emitErr = ""
  fnNames = []
  fnIndices = []
  globalStmts = []
  initChecker()
  0
}

// 0 = ok; 1 = lex/parse error; 2 = type error; 3 = emit error. A program whose only emit
// error is a function binding wanting two signatures compiles again with an instance record
// (`fn_split.vl`), once more per round that asks for a parse node no earlier round asked
// for (D6262); when none builds, the first compile's error is the one reported.
export function compileSrc(): i32 {
  fsReset()
  const rc = compileSrcOnce()
  if rc != 3 || !fsAsked() { return rc }
  let going = true
  while going {
    fsSetMode(FS_PLAN)
    if compileSrcOnce() != 0 {
      going = false
    } else {
      fsSetMode(FS_APPLY)
      const rc3 = compileSrcOnce()
      if rc3 == 0 {
        fsSetMode(FS_COMPILE)
        return 0
      }
      if rc3 != 3 || !fsGrew() { going = false }
    }
  }
  fsSetMode(FS_COMPILE)
  compileSrcOnce()
}

function compileSrcOnce(): i32 {
  plusLinksClear()
  symSetEnabled(0)
  pipelineReset()
  // Module mode (H3): a non-empty module table runs the multi-file pipeline
  // (order/validate → parse-merge → rename/rewrite → check/emit). With an EMPTY
  // table (every existing consumer) the single-source path below is untouched.
  if modKeys.length > 0 { return modCompile(1) }
  vcLoadToksEntry(vcSource())
  const root = parseProgram()
  if vcParseBlocked() { return 1 }
  if fsAfterParse() < 0 { return 3 }
  // No vcEpBank: only a check's tree is replayed by the lint, and a compile never is.
  ambientRenameSingle(root)
  csPreMintLocs()
  expInfSetEntryStd(entryIsStdModule())
  checkProgram(root)
  checkMemSharedOrigin()
  plusLinksBank()
  // Emit never proceeds past a parse diagnostic, lossless or not: `vl build`/`vl run`
  // still keep rc 1 and the same parse message. The only difference lossless recovery
  // makes is that the checker's type errors are reported alongside it, not hidden.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  // A single-source program's wasm ABI is its `export`-marked functions and module
  // bindings, staged through the same alias tables a module build fills (public name →
  // target; unmangled here — no merge). Reset first: a PRIOR module compile on this
  // instance left its aliases behind. The emitter exports only these entries.
  reExpName = []
  reExpTarget = []
  const xSeen: {[string]: boolean} = Map()
  let xt = 0
  while xt + 2 < P.toks.length {
    const xk = P.toks[xt + 1].kind
    if (
      P.toks[xt].kind == "EXPORT"
      && (xk == "FUNCTION" || xk == "LET" || xk == "CONST")
      && P.toks[xt + 2].kind == "IDENT"
      && !xSeen.has(P.toks[xt + 2].text)
    ) {
      xSeen[P.toks[xt + 2].text] = true
      reExpName.push(P.toks[xt + 2].text)
      reExpTarget.push(ambTopTarget(P.toks[xt + 2].text))
    }
    xt = xt + 1
  }
  if fsModeOf() == FS_PLAN { return fsPlan(root) }
  const rc = emitProgram(root)
  if rc < 0 { return 3 }
  emitSrcSection()
  emitExternBoolSection()
  0
}
export function rbyteLen(): i32 { W.len }
export function rbyteAt(i: i32): i32 { ropeAt(W, i) }
// ── bulk result read-back over linear memory — the out mirror of `srcLoad` ───────
// `rbyteAt` above is one host call per emitted byte; this batched form has the guest
// write the staging window and the host copy out, packed four bytes per i32 word so
// the copy is a `memcpy`. A return of 0 or more than `count` is a protocol violation.
export function rbyteStore(off: i32, count: i32): i32 {
  const avail = W.len - off
  let n = count
  if n > avail { n = avail }
  if n <= 0 { return 0 }
  // The module is a rope, so the window may straddle chunks; each word packs the next four
  // bytes little-endian whichever chunk they come from.
  let c = ropeSeek(W, off)
  if c < 0 { return 0 }
  let bs = W.chunks[c].b
  let at = off - W.seekBase
  let w = 0
  let i = 0
  while i < n {
    if at >= bs.length {
      c = c + 1
      bs = W.chunks[c].b
      at = 0
    }
    w = w | (bs[at] << ((i & 3) * 8))
    at = at + 1
    i = i + 1
    if (i & 3) == 0 {
      __store_i32__(i - 4, w)
      w = 0
    }
  }
  if (i & 3) != 0 { __store_i32__(i - (i & 3), w) }
  n
}
// `vl check`: parse and typecheck only, no emit. 0 = ok, 1 = lex/parse, 2 = type.
// Skipping emit makes `check` faster on large inputs and avoids rejecting a type-
// valid program the emitter cannot yet lower — an emit-coverage gap is not a check
// failure. Shares the diagnostic stores (`diagLen`/`diagAt`) with `compileSrc`.
export function checkSrc(): i32 {
  plusLinksClear()
  symSetEnabled(0)
  pipelineReset()
  // Every check starts unserved and unbanked, an import-free one included.
  wiServedLast = false
  wiBankedKeys = []
  wiBankedMods = []
  wiBankedHolds = []
  wiSrvDiags = []
  wiSrvRc = 0
  // Module mode (H3) — see compileSrc; `check` runs the same pipeline minus emit.
  if modKeys.length > 0 {
    if wiServe() { return wiSrvRc }
    const rc = modCompile(0)
    if rc != SK_RERUN { return rc }
    // A declined skip has already checked part of the graph into the arena, so the whole
    // check runs again from the reset, as a check with nothing banked would.
    skMute = true
    plusLinksClear()
    pipelineReset()
    const again = modCompile(0)
    skMute = false
    return again
  }
  wiCountSingle()
  vcLoadToksEntry(vcSource())
  const root = parseProgram()
  if vcParseBlocked() { return 1 }
  // Banked for the lint that pairs with this check; a compile has no lint to serve.
  vcEpBank(vcSource(), root)
  ambientRenameSingle(root)
  csPreMintLocs()
  expInfSetEntryStd(entryIsStdModule())
  checkProgram(root)
  checkMemSharedOrigin()
  plusLinksBank()
  // A lossless-recovered file reports BOTH streams and keeps rc 1 — the parse
  // mistake is still the headline error, the type errors ride with it.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  0
}

// ── the typed sites the last check banked, for the lint ─────────────────────────
// Per module and byte offset: `+` left operands and index receivers that checked as a string,
// and reads under a discarded operator statement that checked as a plain scalar. Only a lint
// paired with that check reads them (`lintUseCheck`): equal text is another program elsewhere.
let plSrcs: string[] = []
let plLinks: {[i32]: i32}[] = []
let plStrIdx: {[i32]: i32}[] = []
let plScalar: {[i32]: i32}[] = []
let plGen = 0
let plBankGen = -1
let plArmed = false

// Retire the bank: every check entry calls this before it parses, so a check that stops
// early leaves nothing a later lint could mistake for its own.
function plusLinksClear(): i32 {
  plGen = plGen + 1
  plSrcs = []
  plLinks = []
  plStrIdx = []
  plScalar = []
  0
}

// The generation of the most recent check, for a caller to hand back to `lintUseCheck`.
export function checkGen(): i32 { plGen }

// Let the next `lintSrc`/`lintGraph` read the bank, when `gen` names the check that filled
// it and no check has started since. The caller asserts the lint is of that check's program.
export function lintUseCheck(gen: i32): i32 {
  plArmed = gen == plGen && plBankGen == plGen
  0
}

function plusLinksBank(): i32 {
  plSrcs = []
  plLinks = []
  plStrIdx = []
  plScalar = []
  plBankGen = plGen
  if modKeys.length == 0 {
    plSrcs.push(vcSource())
  } else {
    let m = 0
    while m < modSrcs.length {
      plSrcs.push(modSrcs[m])
      m = m + 1
    }
  }
  let k = 0
  while k < plSrcs.length {
    const e: {[i32]: i32} = Map()
    plLinks.push(e)
    const x: {[i32]: i32} = Map()
    plStrIdx.push(x)
    const c: {[i32]: i32} = Map()
    plScalar.push(c)
    k = k + 1
  }
  plBankSites(plLinks, "plus")
  plBankSites(plStrIdx, "strIdx")
  plBankSites(plScalar, "scalar")
  0
}

// The checker's three site tables `plBankSites` folds.
type PlTable = "plus" | "strIdx" | "scalar"

// Fold the checker's rows of `table` into `banks`, one map per module: a site reads 1 only
// when every check of it answered 1.
function plBankSites(banks: {[i32]: i32}[], table: PlTable): i32 {
  const n = match table {
    "plus" => plusLinkCount()
    "strIdx" => strIdxCount()
    "scalar" => discLeafCollect()
  }
  let i = 0
  while i < n {
    let tk = -1
    let v = 0
    match table {
      "plus" => {
        tk = plusLinkTokAt(i)
        v = plusLinkStrAt(i)
      }
      "strIdx" => {
        tk = strIdxTokAt(i)
        v = strIdxStrAt(i)
      }
      "scalar" => {
        tk = discLeafTokAt(i)
        v = discLeafScalarAt(i)
      }
    }
    if tk >= 0 && tk < P.toks.length {
      const m = modOfTok(tk)
      if m >= 0 && m < banks.length {
        const bank = banks[m]
        const off = P.toks[tk].start
        const was = bank[off] ?? 1
        bank[off] = if was == 1 && v == 1 { 1 } else { 0 }
      }
    }
    i = i + 1
  }
  0
}

// Hand the lint module `m`'s banked links when the bank covers `src`, else none.
function plusLinksFor(m: i32, src: string): i32 {
  const ok = plArmed && m >= 0 && m < plSrcs.length && m < plLinks.length
  if ok && m < plStrIdx.length && m < plScalar.length && plSrcs[m] == src {
    lintSetPlusLinks(plLinks[m], true)
    lintSetStrIndexes(plStrIdx[m], true)
    lintSetScalarReads(plScalar[m], true)
  } else {
    const none: {[i32]: i32} = Map()
    lintSetPlusLinks(none, false)
    lintSetStrIndexes(none, false)
    lintSetScalarReads(none, false)
  }
  0
}

// Per module of the resolved graph, the import locals that bind a map global of the module
// they come from (what `sentinel-index-unguarded` reads as a key subscript) and those binding
// a top-level function (what `kind-ladder-incomplete` reads as a delegation). Built once per
// lint run, in one pass over the import entries; `only` >= 0 limits it to that importer.
let ilMaps: {[string]: i32}[] = []
let ilFns: {[string]: i32}[] = []
// Each module's two global scans by key, kept with the source they read: both are pure
// functions of it, so one check run walks a module shared by many roots once.
const ilGlobSrc: {[string]: string} = Map()
const ilGlobMaps: {[string]: {[string]: i32}} = Map()
const ilGlobFns: {[string]: {[string]: i32}} = Map()

function importedNamesBuild(only: i32): i32 {
  ilMaps = []
  ilFns = []
  // A graph with no module whose rules read these facts stages none, as `importedNamesFor`
  // does for a module it has no row for.
  if only < 0 && !graphLintReadsGraph() {
    ilHoles = Map()
    ilReaders = []
    ilScanOf = []
    return 0
  }
  const globals: {[string]: i32}[] = []
  const fns: {[string]: i32}[] = []
  const scanned: boolean[] = []
  let m = 0
  while m < modKeys.length && m < modSrcs.length {
    globals.push(Map())
    fns.push(Map())
    scanned.push(false)
    ilMaps.push(Map())
    ilFns.push(Map())
    m = m + 1
  }
  let k = 0
  while (
    k < impMod.length
    && k < impKey.length
    && k < impName.length
    && k < impLocal.length
  ) {
    const from = impMod[k]
    const to = modKeyIx[impKey[k]] ?? -1
    const wanted = only < 0 || from == only
    if (
      wanted
      && from >= 0
      && from < ilMaps.length
      && to >= 0
      && to < globals.length
    ) {
      if !scanned[to] {
        const key = modKeys[to]
        const keptMaps = ilGlobMaps[key]
        const keptFns = ilGlobFns[key]
        if (
          keptMaps != null
          && keptFns != null
          && (ilGlobSrc[key] ?? "") == modSrcs[to]
        ) {
          globals[to] = keptMaps
          fns[to] = keptFns
        } else {
          globals[to] = lintMapGlobalsOf(modSrcs[to])
          fns[to] = lintFnGlobalsOf(modSrcs[to])
          ilGlobSrc[key] = modSrcs[to]
          ilGlobMaps[key] = globals[to]
          ilGlobFns[key] = fns[to]
        }
        scanned[to] = true
      }
      if (globals[to][impName[k]] ?? 0) == 1 { ilMaps[from][impLocal[k]] = 1 }
      if (fns[to][impName[k]] ?? 0) == 1 { ilFns[from][impLocal[k]] = 1 }
    }
    k = k + 1
  }
  graphHolesBuild()
  graphReadersBuild()
}

// Whether some module `lintGraphRun` lints is scoped to a rule that reads the graph facts.
function graphLintReadsGraph(): boolean {
  let m = 0
  while m < modKeys.length && m < modFound.length {
    const reads = lintScopeReadsGraph(lintScopeKeyOf(modKeys[m]))
    if modFound[m] != 0 && lgWants(m) && reads { return true }
    m = m + 1
  }
  false
}

// Per module, the import locals naming a reader of the module they come from
// (`lintSetImportedReaders`), closed over the graph: a module is re-closed only while one
// of its imports gains a reader. Each source is walked once per change, into its lint
// scan slot (`ilScanSlot`, by key), never once per round.
let ilReaders: {[string]: i32}[] = []
let ilScanOf: i32[] = []
const ilScanSrc: {[string]: string} = Map()
const ilScanSlot: {[string]: i32} = Map()

function graphReadersBuild(): i32 {
  ilReaders = []
  ilScanOf = []
  const own: {[string]: i32}[] = []
  const stale: boolean[] = []
  let m = 0
  while m < modKeys.length && m < modSrcs.length && m < modFound.length {
    const key = modKeys[m]
    let slot = ilScanSlot[key] ?? -1
    if modFound[m] != 0 && (slot < 0 || (ilScanSrc[key] ?? "") != modSrcs[m]) {
      slot = lintReaderScanOf(modSrcs[m], slot)
      ilScanSlot[key] = slot
      ilScanSrc[key] = modSrcs[m]
    }
    ilScanOf.push(slot)
    ilReaders.push(Map())
    own.push(Map())
    stale.push(modFound[m] != 0)
    m = m + 1
  }
  let again = true
  while again {
    again = false
    m = 0
    while m < own.length {
      if stale[m] { own[m] = lintReadersOf(ilScanOf[m], ilReaders[m]) }
      stale[m] = false
      m = m + 1
    }
    let k = 0
    while (
      k < impMod.length
      && k < impKey.length
      && k < impName.length
      && k < impLocal.length
    ) {
      const from = impMod[k]
      const to = modKeyIx[impKey[k]] ?? -1
      const nm = impName[k]
      if from >= 0 && from < own.length && to >= 0 && to < own.length {
        const isReader = (own[to][nm] ?? 0) == 1
          || (ilReaders[to][nm] ?? 0) == 1
        if isReader && (ilReaders[from][impLocal[k]] ?? 0) != 1 {
          ilReaders[from][impLocal[k]] = 1
          stale[from] = modFound[from] != 0
          again = true
        }
      }
      k = k + 1
    }
  }
  0
}

// The hole fields of every module the graph read (`lintSetGraphHoles`), and each module's
// own set, kept by module key while its source is unchanged.
let ilHoles: {[string]: i32} = Map()
const ilHoleSrc: {[string]: string} = Map()
const ilHoleSet: {[string]: {[string]: i32}} = Map()

function graphHolesBuild(): i32 {
  ilHoles = Map()
  let m = 0
  while m < modKeys.length && m < modSrcs.length && m < modFound.length {
    if modFound[m] != 0 {
      const key = modKeys[m]
      let set = ilHoleSet[key] ?? Map()
      if (ilHoleSrc[key] ?? "") != modSrcs[m] || ilHoleSet[key] == null {
        set = lintHoleFieldsOf(modSrcs[m])
        ilHoleSrc[key] = modSrcs[m]
        ilHoleSet[key] = set
      }
      for f in set.keys() {
        if (set[f] ?? 0) == 1 { ilHoles[f] = 1 }
      }
    }
    m = m + 1
  }
  0
}

// Stage module `m`'s imported map globals and functions when the graph's source for `m` is
// `src`, else none.
function importedNamesFor(m: i32, src: string): i32 {
  const ok = m >= 0
    && m < ilMaps.length
    && m < ilFns.length
    && m < ilReaders.length
    && m < ilScanOf.length
    && m < modSrcs.length
  if ok && modSrcs[m] == src {
    lintSetImportedMaps(ilMaps[m])
    lintSetImportedFns(ilFns[m])
    lintSetGraphHoles(ilHoles)
    lintSetImportedReaders(ilReaders[m], ilScanOf[m])
  } else {
    lintSetImportedMaps(Map())
    lintSetImportedFns(Map())
    lintSetGraphHoles(Map())
    lintSetImportedReaders(Map(), -1)
  }
  0
}

// The current document's path, staged one code point at a time — the same protocol
// `srcPush`/`srcReset` uses for source text, since a JS host cannot construct a VL
// `string` argument directly (only another VL caller can, via `srcSetStr`). A
// caller that never stages one leaves `scaPath` at "" — every path-scoped rule declines.
const lpAcc = cpAccNew()
export function lintPathReset(): i32 {
  cpAccReset(lpAcc)
  0
}
export function lintPathPush(c: i32): i32 {
  cpAccPush(lpAcc, c)
  0
}
export function lintPathCommit(): i32 {
  lintSetPath(cpAccTake(lpAcc))
  0
}

// The VL checkout this process resolves `std:` from — the same tree `std_source()`
// (scripts/vl-host/src/main.rs) picks, so a worktree pinned by `$VL_STD` scopes to
// itself. Staged once, at startup; "" on a distribution binary (embedded std has no
// directory) — the CLI then declines every path-scoped rule for an absolute target.
const vrAcc = cpAccNew()
export function vlRootPush(c: i32): i32 {
  cpAccPush(vrAcc, c)
  0
}
export function vlRootCommit(): i32 {
  vlCheckoutRoot = cpAccTake(vrAcc)
  0
}
let vlCheckoutRoot = ""

// This process's current working directory, staged once at startup like `vlCheckoutRoot`
// — what a relative CLI argument resolves against, so `lintScopeKeyOf` (D2355) judges
// it by where it actually is rather than trusting its spelling. "" on a caller (a test
// harness, an older seed) that never stages it.
const cwAcc = cpAccNew()
export function cwdPush(c: i32): i32 {
  cpAccPush(cwAcc, c)
  0
}
export function cwdCommit(): i32 {
  vlCwd = cpAccTake(cwAcc)
  0
}
let vlCwd = ""

// Each module's project root, as the host found it from the module's own path (the nearest
// ancestor holding `deno.json`, `package.json` or `.git`), keyed by the module key the host
// read. "" when no ancestor holds one. `modIdKeyOf` hashes the path relative to it (D5760).
// Kept across `modReset`: a file's root does not depend on the graph it is read into.
const mrKeyAcc = cpAccNew()
const mrDirAcc = cpAccNew()
const modRootOfKey: {[string]: string} = Map()
export function modRootKeyPush(c: i32): i32 {
  cpAccPush(mrKeyAcc, c)
  0
}
export function modRootKeyLoad(count: i32): i32 {
  cpAccLoad(mrKeyAcc, count)
  0
}
export function modRootDirPush(c: i32): i32 {
  cpAccPush(mrDirAcc, c)
  0
}
export function modRootDirLoad(count: i32): i32 {
  cpAccLoad(mrDirAcc, count)
  0
}
export function modRootCommit(): i32 {
  const key = cpAccTake(mrKeyAcc)
  modRootOfKey[key] = cpAccTake(mrDirAcc)
  0
}

// The file being checked, RAW (not relativized) — a bare compile with no imports never
// populates `modKeys`, so this is the only way `checkMemSharedOrigin` (D2355) learns
// which file it is in. `cli.vl` stages it beside `lintSetPath`; the LSP beside
// `vlRootPush`. Committed on every check, so a stale value cannot outlive its file.
const cepAcc = cpAccNew()
export function checkEntryPathPush(c: i32): i32 {
  cpAccPush(cepAcc, c)
  0
}
export function checkEntryPathCommit(): i32 {
  checkEntryPath = cpAccTake(cepAcc)
  0
}
// The VL-to-VL twin of the push/commit pair above — `cli.vl` already holds a real
// `string`, so it sets it directly rather than re-encoding through the accumulator.
export function checkEntryPathSet(p: string): i32 {
  checkEntryPath = p
  0
}
let checkEntryPath = ""

// `rawKey` as `lintSetPath` wants it. Relative (a module-graph key, or a CLI argument
// run the documented way) — unchanged, trusting a lint finding is not a capability.
// Absolute and inside the staged checkout root — stripped to the relative remainder;
// outside it, or with no root staged, "".
export function lintScopeKeyOf(rawKey: string): string {
  if rawKey.length == 0 || !modSpecAbsolute(rawKey) { return rawKey }
  if vlCheckoutRoot.length == 0 { return "" }
  const p = vlCheckoutRoot + "/"
  if rawKey.length <= p.length || rawKey.slice(0, p.length) != p { return "" }
  rawKey.slice(p.length, rawKey.length)
}

// `rawKey` as `checkMemSharedOrigin` (D2355) wants it — like `lintScopeKeyOf` above,
// but a relative key is joined with the staged cwd and normalized rather than trusted
// by spelling, since this decides a real capability rather than a lint finding: a
// folder merely named `std/` outside the real checkout must not pass.
export function checkOriginKeyOf(rawKey: string): string {
  if rawKey.length == 0 { return rawKey }
  let abs = rawKey
  if !modSpecAbsolute(rawKey) {
    if vlCwd.length == 0 { return "" }
    abs = modNormalize(vlCwd + "/" + rawKey)
  }
  if vlCheckoutRoot.length == 0 { return "" }
  const p = vlCheckoutRoot + "/"
  if abs.length <= p.length || abs.slice(0, p.length) != p { return "" }
  abs.slice(p.length, abs.length)
}

// ── lint tier ──────────────────────────────────────────────────────────────────
// Runs the AST-derivable lint pass (`compiler/lint.vl`), on the parse alone with
// no typecheck, matching the standalone lint harness. Returns the finding count,
// or -1 on a lex/parse error; the host reads each via `lintCount`/`lintSev*`/`lintMsg*`.
export function lintSrc(): i32 {
  const n = lintSrcRun()
  plArmed = false
  n
}

function lintSrcRun(): i32 {
  symSetEnabled(0)
  // The tree the check on this source already built, when it left it intact — the resets
  // below are what a re-parse needs, and there is nothing to re-parse.
  const banked = vcEpReplay(vcSource())
  if banked >= 0 {
    lintSetSource(vcSource())
    plusLinksFor(0, vcSource())
    importedNamesBuild(0)
    importedNamesFor(0, vcSource())
    lint(banked)
    return lintCount()
  }
  parseStateReset()
  vcLoadToksEntry(vcSource())
  const root = parseProgram()
  // A lossless-recovered AST is the one the user wrote, so lint's findings over it
  // are as real as any other file's; only a lossy parse still returns -1. The parse
  // diagnostics are not lost — every caller reads them from the error stream before
  // or beside this call.
  if vcParseBlocked() {
    // `lint(root)` is what normally clears the sink AND consumes a staged path into
    // `scaRunPath`; neither runs here, so both must be done by hand, or a caller
    // reading regardless is handed the PREVIOUS source's findings — or its PATH.
    lintReset()
    lintSetPath("")
    return -1
  }
  // No checker ran, so the never-returning calls are marked from the declarations alone.
  markNeverCallsByDecl()
  // Comments never reach the arena; the comment-budget rules read the text.
  lintSetSource(vcSource())
  plusLinksFor(0, vcSource())
  importedNamesBuild(0)
  importedNamesFor(0, vcSource())
  lint(root)
  lintCount()
}

export function lintSevLen(i: i32): i32 { lintSevAt(i).length }
export function lintSevByte(i: i32, j: i32): i32 { lintSevAt(i)[j] }
export function lintMsgLen(i: i32): i32 { lintMsgAt(i).length }
export function lintMsgByte(i: i32, j: i32): i32 { lintMsgAt(i)[j] }
// The stable rule `code` (e.g. "unused-variable", "prefer-const") drives the LSP
// quick-fixes, and the 1-based line / 0-based col place the squiggle.
export function lintCodeLen(i: i32): i32 { lintCodeAt(i).length }
export function lintCodeByte(i: i32, j: i32): i32 { lintCodeAt(i)[j] }
export function lintLine(i: i32): i32 { lintLineAt(i) }
export function lintCol(i: i32): i32 { lintColAt(i) }
// The exclusive 0-based end column of the finding's span on `lintLine(i)`. A rule with
// no wider subject reports `lintCol(i) + 1`; the three ratcheted rules span their read,
// their ladder's first arm and their loop head.
export function lintEnd(i: i32): i32 { lintEndAt(i) }

// ── module-graph lint (per-module, with file attribution) ─────────────────────
// Runs the lint pass over every resolved module of the graph, not just the entry,
// so a finding is reported against its own file — each module on a fresh arena of its
// own. Resets `P.toks`/`nodeToks`, so error-tier anchors must be read first.
let lgCodes: string[] = []
let lgMsgs: string[] = []
let lgSevs: string[] = []
let lgLines: i32[] = []
let lgCols: i32[] = []
let lgEnds: i32[] = []
let lgMods: i32[] = []

// Copy the lint sink (one module's `lint(root)` run) into the graph accumulators
// under module index `m`.
function lgCopySink(m: i32): i32 {
  let i = 0
  while i < lintCount() {
    lgCodes.push(lintCodeAt(i))
    lgMsgs.push(lintMsgAt(i))
    lgSevs.push(lintSevAt(i))
    lgLines.push(lintLineAt(i))
    lgCols.push(lintColAt(i))
    lgEnds.push(lintEndAt(i))
    lgMods.push(m)
    i = i + 1
  }
  0
}

// Every module of the graph, each against its own file.
export function lintGraph(): i32 {
  lgOther = true
  const n = lintGraphOf(true, true)
  lgOther = false
  n
}

// `lintGraph` over the entry and only the imports the CLI's scope names: a relative one when
// `rel`, a `std:` one when `std`, and one under any other scheme prefix never. A module left
// out is not linted at all, so it carries no finding; its errors come from the check.
export function lintGraphOf(rel: boolean, std: boolean): i32 {
  lgRel = rel
  lgStd = std
  const n = lintGraphRun()
  plArmed = false
  lgRel = true
  lgStd = true
  n
}
let lgRel = true
let lgStd = true
let lgOther = false

// Whether `lintGraphRun` lints module `m`: the entry always, an import by its scheme.
function lgWants(m: i32): boolean {
  if m <= 0 || m >= modKeys.length { return true }
  const scheme = modKeyScheme(modKeys[m])
  if scheme == "" { return lgRel }
  if scheme == "std" { return lgStd }
  lgOther
}

function lintGraphRun(): i32 {
  lgCodes = []
  lgMsgs = []
  lgSevs = []
  lgLines = []
  lgCols = []
  lgEnds = []
  lgMods = []
  if modKeys.length == 0 {
    // No graph: the single-source path (module 0 = the entry, like `lintSrc`).
    if lintSrc() < 0 { return 0 }
    lgCopySink(0)
    return lgCodes.length
  }
  symSetEnabled(0)
  importedNamesBuild(-1)
  let m = 0
  while m < modKeys.length {
    if modFound[m] != 0 && lgWants(m) {
      // Each module lints a fresh arena, so the reset is per iteration. The check banked
      // each clean module parse before it touched the tree, so that copy is replayed.
      parseStateReset()
      const pbo = parseBankOpen(modOneShot)
      vcLoadToksMod(m)
      let root = parseBankServe(modKeys[m], modSrcs[m], pbo, true)
      if root < 0 { root = parseProgram() }
      // Same rule as `lintSrc`: a clean parse OR an all-lossless recovery.
      if !vcParseBlocked() {
        markNeverCallsByDecl()
        lintSetSource(modSrcs[m])
        lintSetPath(lintScopeKeyOf(modKeys[m]))
        plusLinksFor(m, modSrcs[m])
        importedNamesFor(m, modSrcs[m])
        lint(root)
        lgCopySink(m)
      }
    }
    m = m + 1
  }
  lgCodes.length
}

// Per-finding accessors (the `lint*` idiom, plus the owning module's index).
export function lintGraphCount(): i32 { lgCodes.length }
export function lintGraphModule(i: i32): i32 { lgMods[i] }
export function lintGraphLine(i: i32): i32 { lgLines[i] }
export function lintGraphCol(i: i32): i32 { lgCols[i] }
export function lintGraphEnd(i: i32): i32 { lgEnds[i] }
export function lintGraphSevLen(i: i32): i32 { lgSevs[i].length }
export function lintGraphSevByte(i: i32, j: i32): i32 { lgSevs[i][j] }
export function lintGraphMsgLen(i: i32): i32 { lgMsgs[i].length }
export function lintGraphMsgByte(i: i32, j: i32): i32 { lgMsgs[i][j] }
export function lintGraphCodeLen(i: i32): i32 { lgCodes[i].length }
export function lintGraphCodeByte(i: i32, j: i32): i32 { lgCodes[i][j] }
// String reads for same-assembly consumers (the CLI): the code/sev/msg values.
export function lintGraphCodeAt(i: i32): string { lgCodes[i] }
export function lintGraphSevAt(i: i32): string { lgSevs[i] }
export function lintGraphMsgAt(i: i32): string { lgMsgs[i] }

// ── format tier ────────────────────────────────────────────────────────────────
// Runs the AST-driven formatter (`compiler/format.vl`) and exposes its canonical
// output, re-parsing it as a round-trip safety gate. Returns the formatted length;
// -1 when the input does not parse, -2 when the output does not re-parse (a formatter bug).
export let vcFmtOut = ""
export function formatSrc(): i32 {
  symSetEnabled(0)
  parseStateReset()
  const src = vcSource()
  // Lex once, feeding tokens into the parser AND the formatter's comment table
  // (the formatter slices spans from `src` and places comments around them).
  fmtSetSource(src)
  fmtResetComments()
  const r = tokenize(src)
  let i = 0
  while i < r.tokens.length {
    P.toks.push(r.tokens[i])
    i = i + 1
  }
  let d = 0
  while d < r.diags.length {
    // Keep the lex diag's real position and span (`diagLine`/`diagCol`/
    // `diagEndCol` read the vcDg* side table), so a caller can point at the
    // offending source.
    vcDgPush(
      P.diags.length,
      r.diags[d].line,
      r.diags[d].col,
      r.diags[d].endCol,
      0,
    )
    P.diags.push({ msg: r.diags[d].msg, at: -1 })
    d = d + 1
  }
  let c = 0
  while c < r.comments.length {
    const cm = r.comments[c]
    let tr = 0
    if cm.trailing { tr = 1 }
    fmtAddComment(cm.text, cm.start, cm.line, tr)
    c = c + 1
  }
  if P.diags.length > 0 { return -1 }
  const root = parseProgram()
  // Not `vcParseBlocked`: the formatter is the one consumer that must keep the "any"
  // reading. A lossless recovery preserves the program's meaning, which is all the
  // checker needs, but the formatter writes its output back over the file (`vl fmt
  // -w`), so printing the recovered AST would silently re-spell the user's mistake.
  if P.diags.length > 0 { return -1 }
  vcFmtOut = formatProgram(root)
  // ── round-trip safety gate ──────────────────────────────────────────────────
  // Re-lexes and re-parses the output before handing it back: a printer bug that
  // emits unparseable text must surface as a loud -2, never as data loss through
  // `fmt -w`. An output equal to the input needs no gate, at zero extra cost.
  if vcFmtOut == src { return vcFmtOut.length }
  P.toks = []
  P.nodes = []
  sidReset()
  externReset()
  getDeclReset()
  sidKeyedTablesReset()
  P.diags = []
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  recDupField = []
  callRestPacked = []
  callNever = []
  vcDgReset()
  vcLoadToks(vcFmtOut)
  if P.diags.length == 0 { parseProgram() }
  if P.diags.length > 0 { return -2 }
  vcFmtOut.length
}
export function fmtLen(): i32 { vcFmtOut.length }
export function fmtByteAt(j: i32): i32 { vcFmtOut[j] }

// ── LSP symbol query: a symbol-aware check ────────────────────────────────────
// The host's capability probe for "`checkSrcSym`'s diagnostics ARE `checkSrc`'s", so one
// symbol-aware check can serve an editor's diagnostics AND its symbol queries. A seed
// predating the parity does not export this, and the host runs the two checks separately.
export function checkSymDiagsComplete(): i32 { 1 }

// Identical to `checkSrc` but with the symbol table on, so the query accessors
// below can read occurrence and binding-type tables. Used only by the LSP's
// go-to-def/find-refs/hover path; every other consumer forces the table off.
export function checkSrcSym(): i32 {
  plusLinksClear()
  symSetEnabled(1)
  pipelineReset()
  if modKeys.length > 0 {
    // The symbol tables need every module checked, so a symbol check never serves one.
    skMute = true
    const mrc = modCompile(0)
    skMute = false
    return mrc
  }
  vcLoadToksEntry(vcSource())
  const root = parseProgram()
  if vcParseBlocked() { return 1 }
  // Banked for the lint that pairs with this check; a compile has no lint to serve.
  vcEpBank(vcSource(), root)
  ambientRenameSingle(root)
  csPreMintLocs()
  expInfSetEntryStd(entryIsStdModule())
  checkProgram(root)
  checkMemSharedOrigin()
  plusLinksBank()
  // Lossless recovery: the symbol tables ARE populated for the rc-1 result too,
  // so hover / go-to-def / find-refs keep answering across a missing brace.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  0
}

// The occurrence table (parallel to the host's `SymbolOccurrence[]`). After a
// `checkSrcSym`, the host reads `symCount()` occurrences; for each, its source span,
// `symIsDecl(i)` (1 = declaration, 0 = use), and `symBindingId(i)` — the declaring
// node index, the stable identity two occurrences share iff they name the same binding.
export function symCount(): i32 { symOccCount() }
export function symSpanStartLine(i: i32): i32 { symOccStartLine(i) }
export function symSpanStartCol(i: i32): i32 { symOccStartCol(i) }
export function symSpanEndLine(i: i32): i32 { symOccEndLine(i) }
export function symSpanEndCol(i: i32): i32 { symOccEndCol(i) }
export function symIsDecl(i: i32): i32 { symOccIsDeclAt(i) }
export function symBindingId(i: i32): i32 { symOccBinding(i) }

// Cross-file find-references: the module (table index) occurrence `i` belongs to.
// A module's tokens occupy a contiguous range of the merged `P.toks`, recorded as
// `modLoadStart`/`modLoadMod`; maps the occurrence's anchor token into that range.
// Single-file mode (no module load) is always 0.
export function modOfTok(tok: i32): i32 { srcmapModOfTok(tok) }

// Whether the entry being checked is a std module: by its graph key, else by the entry path
// relativized against the checkout root.
function entryIsStdModule(): boolean {
  if modKeys.length > 0 && modKeyIsStd(modKeys[0]) { return true }
  const rel = checkOriginKeyOf(checkEntryPath)
  rel.length >= 4 && rel.slice(0, 4) == "std/"
}

// `__memory_shared__()` is std-internal (D2355): a call outside std is refused, once
// `checkProgram` fills `memSharedCalls` with every call it resolved to the intrinsic.
// Origin is the call's module key (`std:` only from a real specifier) OR, for the
// entry, `checkEntryPath` relativized against the checkout root (`lintScopeKeyOf`).
function checkMemSharedOrigin(): i32 {
  let i = 0
  while i < memSharedCalls.length {
    const ix = memSharedCalls[i]
    let std = false
    // Whether `ix`'s module is the ENTRY — true by default, since a bare compile with
    // no imports never populates `modKeys` at all, and its one module IS the entry.
    let isEntry = true
    if modKeys.length > 0 && ix >= 0 && ix < nodeToks.length {
      const m = modOfTok(nodeToks[ix])
      if m >= 0 && m < modKeys.length {
        std = modKeyIsStd(modKeys[m])
        isEntry = m == 0
      }
    }
    // Only the entry: a std module reaches its siblings solely through a `std:`
    // specifier, never a relative one, so a raw path elsewhere in the graph is
    // always a user file.
    if !std && isEntry {
      const rel = checkOriginKeyOf(checkEntryPath)
      std = rel.length >= 4 && rel.slice(0, 4) == "std/"
    }
    if !std {
      tErr(
        "'__memory_shared__' is internal to std; build-dependent code is not a user feature yet",
        ix,
      )
    }
    i = i + 1
  }
  0
}
// `__callsite__` mints one location-value node per call, before the checker runs,
// since a default's value here IS the site (every other default form shares one
// node). A pre-pass, not a rewrite: minted before `checkProgram` sizes `nodeTyIx`
// (D969), or a later-minted node would read its type back as -1 forever.
let csLoose = false
let csAnyDefault = false

// The names of the declarations carrying a `__callsite__` default; `csLoose` is set when
// such a default belongs to no declaration, and every call is then minted for.
function csCallsiteFns(): {[string]: boolean} {
  const fns: {[string]: boolean} = Map()
  let all = 0
  let held = 0
  let i = 0
  while i < P.nodes.length {
    const n = nodeAt(i)
    if n is FuncDecl {
      for p in n.fnParams {
        if paramDefaultIsCallsite(paramDefaultOf(p)) {
          held = held + 1
          fns[n.fnName] = true
        }
      }
    } else {
      all = all + csParamCallsite(i)
    }
    i = i + 1
  }
  csLoose = held != all
  csAnyDefault = all > 0
  fns
}

// 1 when node `i` is a parameter whose default is `__callsite__`, else 0.
function csParamCallsite(i: i32): i32 {
  const n = nodeAt(i)
  if n is Param {
    if paramDefaultIsCallsite(n.parDefault) { return 1 }
  }
  0
}

// The plain member names that may resolve to one of `fns`: a UFCS scope row's or an
// overload set's, beside the declared names themselves.
function csCallsitePlains(fns: {[string]: boolean}): {[string]: boolean} {
  const plains: {[string]: boolean} = Map()
  ufcsPlainsOfInto(fns, plains)
  let r = 0
  while r < ovSetName.length && r < ovSetCands.length {
    for c in ovSetCands[r] {
      if fns.has(c) { plains[ovSetName[r]] = true }
    }
    r = r + 1
  }
  plains
}

// Whether call `n` at `ix` may take a `__callsite__` default: its callee names one of `fns`,
// or is a member whose name may resolve to one, or is any other callee.
function csMayDefault(
  ix: i32,
  n: Call,
  fns: {[string]: boolean},
  plains: {[string]: boolean},
): boolean {
  if csLoose || n.callFn < 0 || n.callFn >= P.nodes.length { return true }
  const cf = nodeAt(n.callFn)
  if cf is Ident { return fns.has(cf.identName) }
  if cf is Member {
    const prop = cf.memProp
    return fns.has(prop)
      || plains.has(prop)
      || fns.has(ufcsAliasAtSite(ix, prop))
  }
  true
}

// `s` as a string-literal lexeme — quotes kept, `"` and `\` escaped. `StrLit`
// carries the raw lexeme (`decodeStr` resolves the escapes later), so a synthesized
// literal has to be built in that same currency.
function csStrLexeme(s: string): string {
  const buf: i32[] = []
  buf.push(34)
  for cp in s {
    if cp == 34 || cp == 92 { buf.push(92) }
    buf.push(cp)
  }
  buf.push(34)
  fromCodePoints(buf)
}

// The module whose KEY names the token at `tok`'s file, or -1 for the file "". A
// single-source compile has no module table and answers -1, which is the honest
// reading: nothing in that pipeline knows the entry's path (the CLI prints one it
// holds host-side, and never tells the compiler).
function csFileOfTok(tok: i32): i32 {
  if modKeys.length == 0 { return -1 }
  const m = modOfTok(tok)
  if m < 0 || m >= modKeys.length { return -1 }
  m
}

// Mints only for a call that can reach such a default (`csMayDefault`): every other call's
// node would be checked, sized and scanned for nothing.
export function csPreMintLocs(): i32 {
  paramDefaultTablesReset()
  const fns = csCallsiteFns()
  if !csAnyDefault { return 0 }
  const plains = csCallsitePlains(fns)
  // Snapshot the length FIRST — minting appends, and the nodes appended are not
  // themselves calls.
  const n0 = P.nodes.length
  // Each module's key as a lexeme, built once per module rather than once per call.
  const lexOfMod: string[] = []
  for _ in modKeys { lexOfMod.push("") }
  const noFileLex = csStrLexeme("")
  let i = 0
  while i < n0 {
    const n = nodeAt(i)
    if n is Call && csMayDefault(i, n, fns, plains) {
      let ln = 0
      let co = 0
      let fileLex = noFileLex
      // The callee's own anchor token — `where` in `where(1)`, `f` in `x.f(1)` —
      // what a reader means by "the call site". Not `tokIndexAt(n.pos)`: that binary
      // search assumes `P.toks[i].start` ascends, which fails across a module
      // boundary in the merged stream. `nodeToks` has no such assumption.
      let tk = -1
      if n.callFn >= 0 && n.callFn < nodeToks.length { tk = nodeToks[n.callFn] }
      if tk < 0 {
        if i < nodeToks.length { tk = nodeToks[i] }
      }
      if tk >= 0 && tk < P.toks.length {
        ln = P.toks[tk].line
        co = P.toks[tk].col + 1
        const fm = csFileOfTok(tk)
        if fm >= 0 {
          if lexOfMod[fm].length == 0 {
            lexOfMod[fm] = csStrLexeme(modKeys[fm])
          }
          fileLex = lexOfMod[fm]
        }
      }
      const fields: i32[] = []
      fields.push(mkFieldInit("file", mkStr(fileLex, -1), -1))
      fields.push(mkFieldInit("line", mkNum(i32ToStr(ln), -1), -1))
      fields.push(mkFieldInit("col", mkNum(i32ToStr(co), -1), -1))
      // The `ObjLit` keeps the CALL's position so a type error on this argument
      // points at the call the author wrote, not at nowhere.
      setCallSiteLoc(i, mkObjLit(fields, n.pos))
    }
    i = i + 1
  }
  0
}

export function symOccModuleAt(i: i32): i32 {
  const tok = symOccTokAt(i)
  if tok < 0 { return 0 }
  modOfTok(tok)
}

// Semantic tokens: after a `checkSrcSym`, the recorded occurrences are the
// classified identifiers, so `tokCount` is `symCount` and spans reuse `symSpan*`.
// The one addition is `tokBindKindAt(i)` (0=local, 1=param, 2=function, -1
// otherwise). Identifiers only; the host keeps its own pass for everything else.
export function tokCount(): i32 { symOccCount() }
export function tokBindKindAt(i: i32): i32 { symOccKindAt(i) }
export function tokSpanStartLine(i: i32): i32 { symOccStartLine(i) }
export function tokSpanStartCol(i: i32): i32 { symOccStartCol(i) }
export function tokSpanEndCol(i: i32): i32 { symOccEndCol(i) }

// Go-to-definition: the occurrence index of the DECLARATION for the binding whose
// occurrence covers (line, col), or -1 when the cursor is off any tracked name.
// Read its span via the `symSpan*` accessors.
export function defAt(line: i32, col: i32): i32 { symDefAt(line, col) }

// Find-references: the count of occurrences (declaration + uses) of the binding
// at (line, col), and the k-th such occurrence INDEX (its span via `symSpan*`).
export function refsCountAt(line: i32, col: i32): i32 {
  symRefsCountAt(line, col)
}
export function refAt(line: i32, col: i32, k: i32): i32 {
  symRefAt(line, col, k)
}

// Hover-types: the rendered type string of the binding at (line, col), exposed
// per-codepoint (the `rbyte*` idiom). `typeStrAt` computes the string and returns
// its length; `typeStrCharAt(j)` reads code point `j` of it. A cursor off any
// tracked binding yields a zero-length string.
let symTyBuf: string = ""
export function typeStrAt(line: i32, col: i32): i32 {
  symTyBuf = symTypeStrAt(line, col)
  symTyBuf.length
}
export function typeStrLen(): i32 { symTyBuf.length }
export function typeStrCharAt(j: i32): i32 { symTyBuf[j] }

// Exact-constant hover: the `symConstAt` lines for the name at (line, col), exposed
// per-codepoint like `typeStrAt`; 0 length off an un-annotated literal `const`.
let constBuf: string = ""
export function constAt(line: i32, col: i32): i32 {
  constBuf = symConstAt(line, col)
  constBuf.length
}
export function constCharAt(j: i32): i32 { constBuf[j] }

// Doc hover: the `///` block above the declaration the name at (line, col) resolves to,
// exposed per-codepoint like `typeStrAt`. "" when the declaration carries none, which is
// also what a `//` comment and a block separated by a blank line produce.
let docBuf: string = ""
export function docAt(line: i32, col: i32): i32 {
  docBuf = symDocAt(line, col)
  docBuf.length
}
export function docCharAt(j: i32): i32 { docBuf[j] }

// Effects hover: the summary of the function the name at (line, col) resolves to — what it
// writes, whether it allocates, its cost in steps and its host calls — exposed per-codepoint
// like `typeStrAt`. "" when the name is not a declared function (function-effects-design §D).
let effectsBuf: string = ""
export function effectsAt(line: i32, col: i32): i32 {
  effectsBuf = ""
  const occ = symDefAt(line, col)
  if occ >= 0 { effectsBuf = esTextOfDecl(symOccBinding(occ)) }
  effectsBuf.length
}
export function effectsCharAt(j: i32): i32 { effectsBuf[j] }

// Every summary of the entry module's functions and their pinned instances, one per line,
// for the dump fixture; `effectsDump` computes it after a check and returns its length.
let effectsDumpBuf: string = ""
export function effectsDump(): i32 {
  effectsDumpBuf = esDumpText()
  effectsDumpBuf.length
}
export function effectsDumpCharAt(j: i32): i32 { effectsDumpBuf[j] }

// Type-alias hover: the rendered type of the user `type` NAME (struct/union alias)
// under (line, col) — its decl name or a use in an annotation — exposed
// per-codepoint like `typeStrAt`. "" when the cursor is off a known user type.
let typeAliasBuf: string = ""
export function typeAliasAt(line: i32, col: i32): i32 {
  typeAliasBuf = symTypeAliasAt(line, col)
  typeAliasBuf.length
}
export function typeAliasCharAt(j: i32): i32 { typeAliasBuf[j] }

// Type-name completion: the `type` NAMES this file can complete to — its own top-level
// declarations plus the ones it imports. `typeScan` records the set and takes no position,
// since every name it answers is in scope for the whole file; the accessors read each one's
// name, rendered body and `///` block.
export function typeScan(): i32 { symTypeScan() }
export function typeScanCount(): i32 { symTypeScanCount() }
export function typeScanNameLen(i: i32): i32 { symTypeScanNameLen(i) }
export function typeScanNameCharAt(i: i32, j: i32): i32 {
  symTypeScanNameCharAt(i, j)
}
export function typeScanDetailLen(i: i32): i32 { symTypeScanDetailLen(i) }
export function typeScanDetailCharAt(i: i32, j: i32): i32 {
  symTypeScanDetailCharAt(i, j)
}
export function typeScanDocLen(i: i32): i32 { symTypeScanDocLen(i) }
export function typeScanDocCharAt(i: i32, j: i32): i32 {
  symTypeScanDocCharAt(i, j)
}

// Inlay hints: after a `checkSrcSym`, the inferred type at each unannotated
// declaration. `inlayScan` records the set; accessors read each hint's kind (0 =
// value binding's type, 1 = function's return type), the name-end position, and
// the rendered type label (per-codepoint).
export function inlayScan(): i32 { symInlayScan() }
export function inlayCount(): i32 { symInlayCount() }
export function inlayKindAt(i: i32): i32 { symInlayKindAt(i) }
export function inlayLineAt(i: i32): i32 { symInlayLineAt(i) }
export function inlayColAt(i: i32): i32 { symInlayColAt(i) }
export function inlayTypeLen(i: i32): i32 { symInlayTypeLen(i) }
export function inlayTypeCharAt(i: i32, j: i32): i32 {
  symInlayTypeCharAt(i, j)
}
// The module (table index) hint `i` belongs to (0 = the entry). A whole-program
// compile records a hint for every module's unannotated decls, so the host keeps
// only the entry's — else a dependency's hints render against the importer's own
// lines. Mirrors `symOccModuleAt` for the semantic-token slice.
export function inlayModuleAt(i: i32): i32 { symOccModuleAt(symInlayOccAt(i)) }

// The module a redundant-type finding belongs to (its name token's owner). Lets
// the cli keep only the ENTRY module's (== 0) findings in a multi-module compile,
// where every module's AST is merged. Single-file mode has no module table, so
// `modOfTok` returns 0 throughout (nothing filtered). Mirrors `inlayModuleAt`.
export function redunModuleAt(i: i32): i32 { modOfTok(redunTokAt(i)) }
// Whether finding `i` is a function's return annotation, which `check --fix` leaves alone.
export function redunIsReturnAt(i: i32): boolean { redunRetAt(i) }

// The redundant-annotation finding's message, per code point — the same byte ABI
// `lintMsg*`/`diagMsg*` use. Type-informed, so it never appears in the parse-only
// `lintSrc` stream; `redunMsgAt` rebuilds the string on every call, deliberately not
// memoized, since an index-keyed cache would serve a stale program's message.
export function redunMsgLen(i: i32): i32 { redunMsgAt(i).length }
export function redunMsgByte(i: i32, j: i32): i32 { redunMsgAt(i)[j] }

// The dead-`??`-default stream's module + message ABI, the exact twin of the
// redundant-annotation pair above and for the same reason: the finding is
// type-informed, so it never appears in the parse-only `lintSrc` stream and would
// otherwise be visible to the CLI alone.
export function rcoalModuleAt(i: i32): i32 { modOfTok(rcoalTokAt(i)) }
export function rcoalMsgLen(i: i32): i32 { rcoalMsgAt(i).length }
export function rcoalMsgByte(i: i32, j: i32): i32 { rcoalMsgAt(i)[j] }

// The collapsed-operand `is` stream's module + message ABI — the same twin again,
// for the same reason (type-informed, so invisible to `lintSrc`).
export function isvalModuleAt(i: i32): i32 { modOfTok(isvalTokAt(i)) }
export function isvalMsgLen(i: i32): i32 { isvalMsgAt(i).length }
export function isvalMsgByte(i: i32, j: i32): i32 { isvalMsgAt(i)[j] }

// The inferred-export-parameter stream's module + message ABI, the same twin (D3817).
export function expInfModuleAt(i: i32): i32 { modOfTok(expInfTokAt(i)) }
export function expInfMsgLen(i: i32): i32 { expInfMsgAt(i).length }
export function expInfMsgByte(i: i32, j: i32): i32 { expInfMsgAt(i)[j] }

// Member hover: the rendered type string of the member access whose property name
// is at (line, col) — `o.x`/`o?.y` — exposed per-codepoint like `typeStrAt`. A
// cursor off any recorded member access yields a zero-length string.
let memTyBuf: string = ""
export function memberTypeStrAt(line: i32, col: i32): i32 {
  memTyBuf = symMemTypeStrAt(line, col)
  memTyBuf.length
}
export function memberTypeStrLen(): i32 { memTyBuf.length }
export function memberTypeStrCharAt(j: i32): i32 { memTyBuf[j] }

// Signature help: after a `checkSrcSym`, the parameter table of the function whose
// name sits at (line, col). `sigAt` returns the row count, or -1 when nothing there
// is callable — a zero-parameter function is a real empty-table signature, so the
// host tells the two apart by the sign. Accessors read each parameter's name and type.
export function sigAt(line: i32, col: i32): i32 { symSigAt(line, col) }
export function sigParamNameLen(i: i32): i32 { symSigParamNameLen(i) }
export function sigParamNameCharAt(i: i32, j: i32): i32 {
  symSigParamNameCharAt(i, j)
}
export function sigParamTypeLen(i: i32): i32 { symSigParamTypeLen(i) }
export function sigParamTypeCharAt(i: i32, j: i32): i32 {
  symSigParamTypeCharAt(i, j)
}
// The parameter's default value as source text, zero length when it has none —
// what makes a defaulted parameter render as `b: i32 = 10` in an editor that has
// no other way to flag it optional.
export function sigParamDefaultLen(i: i32): i32 { symSigParamDefaultLen(i) }
export function sigParamDefaultCharAt(i: i32, j: i32): i32 {
  symSigParamDefaultCharAt(i, j)
}
export function sigRetLen(): i32 { symSigRetLen() }
export function sigRetCharAt(j: i32): i32 { symSigRetCharAt(j) }

// Member semantic tokens: after a `checkSrcSym`, every member-access property name
// the checker resolved — `memberCount()` then per-index span and class. A member is
// a `method` when its resolved type is a function, else a `property`. Lets the wasm
// semantic-tokens path classify `o.x`/`xs.get` itself.
export function memberCount(): i32 { symMemberCount() }
export function memberLineAt(i: i32): i32 { symMemberLine(i) }
export function memberColAt(i: i32): i32 { symMemberCol(i) }
export function memberLenAt(i: i32): i32 { symMemberLen(i) }
export function memberIsMethodAt(i: i32): i32 { symMemberIsMethod(i) }
// 1 when member `i` reads a getter: the editor keeps it a `property`, marked read-only.
export function memberIsGetterAt(i: i32): i32 { symMemberIsGetter(i) }

// Scope-at-position (completion): after a `checkSrcSym`, the user bindings visible at
// (line, col). `scopeAt` returns the set's count; accessors read each binding's name,
// kind and rendered type. Multi-module: filtered to bindings declared in the entry
// plus the dep declarations it imports, else a dep's whole span would leak in.
export function scopeAt(line: i32, col: i32): i32 {
  const n = symScopeAt(line, col)
  // The merged names the entry's imports denote — the only dep rows kept.
  const okDep: {[string]: i32} = Map()
  let ij = 0
  while ij < impMod.length {
    if impMod[ij] == 0 && impLocal[ij] != "" && impName[ij] != "" {
      const dd = modIndexOfKey(impKey[ij])
      if dd >= 0 { okDep[modMergedTargetOf(dd, impName[ij])] = 1 }
    }
    ij = ij + 1
  }
  let w = 0
  let i = 0
  while i < n {
    const fromEntry = modOfTok(scopeResTok[i]) == 0
    if fromEntry || (okDep[scopeResRaw[i]] ?? 0) == 1 {
      if w != i {
        scopeResName[w] = scopeResName[i]
        scopeResKind[w] = scopeResKind[i]
        scopeResType[w] = scopeResType[i]
        scopeResRaw[w] = scopeResRaw[i]
        scopeResTok[w] = scopeResTok[i]
        scopeResConst[w] = scopeResConst[i]
      }
      w = w + 1
    }
    i = i + 1
  }
  while scopeResName.length > w {
    scopeResName.pop()
    scopeResKind.pop()
    scopeResType.pop()
    scopeResRaw.pop()
    scopeResTok.pop()
    scopeResConst.pop()
  }
  w
}
export function scopeNameLen(i: i32): i32 { symScopeNameLen(i) }
export function scopeNameCharAt(i: i32, j: i32): i32 {
  symScopeNameCharAt(i, j)
}
export function scopeKindAt(i: i32): i32 { symScopeKindAt(i) }
export function scopeTypeLen(i: i32): i32 { symScopeTypeLen(i) }
export function scopeTypeCharAt(i: i32, j: i32): i32 {
  symScopeTypeCharAt(i, j)
}
// The `///` block of scope result `i` — the completion panel's prose, the same text
// `docAt` gives hover. 0 length when the binding carries none.
export function scopeDocLen(i: i32): i32 { symScopeDocLen(i) }
export function scopeDocCharAt(i: i32, j: i32): i32 { symScopeDocCharAt(i, j) }
// Scope result `i`'s exact-constant fields, the `cqConstFields` lines; 0 length for a binding
// that is no un-annotated literal `const`.
export function scopeConstLen(i: i32): i32 {
  if i < 0 || i >= scopeResConst.length { return 0 }
  scopeResConst[i].length
}
export function scopeConstCharAt(i: i32, j: i32): i32 {
  if i < 0 || i >= scopeResConst.length { return 0 }
  scopeResConst[i][j]
}

// Member completion: after a `checkSrcSym`, the members of the receiver type whose
// binding is under (line, col). `memberScanAt` resolves and records the set;
// accessors read each member's name, detail type, and method flag. The host strips
// the trailing `.` so the receiver parses as a bare expression at its original position.
export function memberScanAt(line: i32, col: i32): i32 {
  symMemberScanAt(line, col)
}
export function memberScanCount(): i32 { symMemberScanCount() }
export function memberScanNameLen(i: i32): i32 { symMemberScanNameLen(i) }
export function memberScanNameCharAt(i: i32, j: i32): i32 {
  symMemberScanNameCharAt(i, j)
}
export function memberScanTypeLen(i: i32): i32 { symMemberScanTypeLen(i) }
export function memberScanTypeCharAt(i: i32, j: i32): i32 {
  symMemberScanTypeCharAt(i, j)
}
export function memberScanIsFn(i: i32): i32 { symMemberScanIsFn(i) }
// 1 when completion member `i` is a getter, which the editor offers as a property.
export function memberScanIsGetter(i: i32): i32 { symMemberScanIsGetter(i) }
// The `///` block of member `i` — the same text `docAt` gives hover for that field's
// declaration. 0 length for a `string` builtin method, which has none.
export function memberScanDocLen(i: i32): i32 { symMemberScanDocLen(i) }
export function memberScanDocCharAt(i: i32, j: i32): i32 {
  symMemberScanDocCharAt(i, j)
}

// UFCS candidates: after a `checkSrcSym`, the free `self`-functions the receiver
// under (line, col) dispatches to — the half `memberScanAt` cannot see, since it
// reads the receiver's field set while this reads the program's declarations.
// Accessors read each candidate's demangled name, signature, and owning module.
export function ufcsScanAt(line: i32, col: i32): i32 {
  symUfcsScanAt(line, col)
}
export function ufcsScanCount(): i32 { symUfcsScanCount() }
export function ufcsScanNameLen(i: i32): i32 { symUfcsScanNameLen(i) }
export function ufcsScanNameCharAt(i: i32, j: i32): i32 {
  symUfcsScanNameCharAt(i, j)
}
export function ufcsScanDetailLen(i: i32): i32 { symUfcsScanDetailLen(i) }
export function ufcsScanDetailCharAt(i: i32, j: i32): i32 {
  symUfcsScanDetailCharAt(i, j)
}
export function ufcsScanModuleAt(i: i32): i32 {
  const tk = symUfcsScanTokAt(i)
  if tk < 0 { return 0 }
  modOfTok(tk)
}
export function ufcsScanExportedAt(i: i32): i32 { symUfcsScanExportedAt(i) }
// The `///` block of UFCS candidate `i` — the same text `docAt` gives hover for that
// declaration. 0 length when it carries none.
export function ufcsScanDocLen(i: i32): i32 { symUfcsScanDocLen(i) }
export function ufcsScanDocCharAt(i: i32, j: i32): i32 {
  symUfcsScanDocCharAt(i, j)
}

// Builtin completions: the compiler's builtin surface — type names, builtin
// functions, and linear-memory intrinsics — kept here beside the compiler that owns
// it. Static: `builtinScan` fills the table, accessors read each entry's name, kind
// and detail type. Hand-listed since these are special-cased call arms with no scope entry.
let blName: string[] = []
let blKind: i32[] = []
let blType: string[] = []
function blPush(n: string, k: i32, t: string) {
  blName.push(n)
  blKind.push(k)
  blType.push(t)
}
export function builtinScan(): i32 {
  // Every type string below is read by a person as the completion `detail`, so it is
  // spelled the way VL source spells a type, `(params) => ret`. Hand-written rather
  // than rendered, which is the shape that can drift from `tyToStr`'s own answer.
  blName = []
  blKind = []
  blType = []
  blPush("i32", 0, "i32")
  blPush("i64", 0, "i64")
  blPush("f32", 0, "f32")
  blPush("f64", 0, "f64")
  blPush("boolean", 0, "boolean")
  blPush("string", 0, "string")
  // `print` is an overload set, not a polymorphic function, so the accepted set
  // renders as a union of the reps that actually print. Advertised and enforced
  // domain are literally one `printDomainStr()` (also `tyPrintsAsRef`'s refusal
  // string), so they cannot drift. `toString` lives in `std:fmt` instead (DECISIONS.md).
  blPush("print", 1, "(" + printDomainStr() + ") => void")
  blPush("fromCodePoint", 1, "(i32) => string")
  blPush("fromCodePoints", 1, "(i32[]) => string")
  // D1582 — the DETAIL names the type a completion produces, and `Map`/`Set` are
  // not type names: the index signature is. Naming them here handed the one reader
  // who could still be told the spelling a type that does not resolve.
  blPush("Map", 1, "() => {[K]: V}")
  blPush("Set", 1, "() => {[K]: boolean}")
  // The linear-memory intrinsics that actually lower — only completed so a name that
  // passes `vl check` cannot then fail at emit. The addresses are byte offsets and
  // the ops match the wasm instructions' signatures exactly: `__load_i8__` sign-
  // extends into the i32 result, `__load_u8__` zero-extends; stores are sign-agnostic.
  blPush("__store_i32__", 1, "(i32, i32) => void")
  blPush("__store_i64__", 1, "(i32, i64) => void")
  blPush("__store_f32__", 1, "(i32, f32) => void")
  blPush("__store_f64__", 1, "(i32, f64) => void")
  blPush("__load_i32__", 1, "(i32) => i32")
  blPush("__load_i8__", 1, "(i32) => i32")
  blPush("__load_u8__", 1, "(i32) => i32")
  blPush("__load_i16__", 1, "(i32) => i32")
  blPush("__load_u16__", 1, "(i32) => i32")
  blPush("__load_i64__", 1, "(i32) => i64")
  blPush("__load_f32__", 1, "(i32) => f32")
  blPush("__load_f64__", 1, "(i32) => f64")
  blPush("__load_u8_i64__", 1, "(i32) => i64")
  blPush("__load_u16_i64__", 1, "(i32) => i64")
  blPush("__load_u32_i64__", 1, "(i32) => i64")
  // `memory.size` is the CURRENT size in 64 KiB pages; `memory.grow` returns the
  // size BEFORE the growth, or -1 if it failed.
  blPush("__memory_size__", 1, "() => i32")
  blPush("__memory_grow__", 1, "(i32) => i32")
  // The build's `std:buffer` heap window: the first address it may hand out, and one past
  // the last. `vl build --heap-base=/--heap-limit=` set them; 1024 and 2^31-8 otherwise.
  blPush("__heap_base__", 1, "() => i32")
  blPush("__heap_limit__", 1, "() => i32")
  // std-internal: whether `vl build --shared-memory` declared the memory shared (no guarantee).
  blPush("__memory_shared__", 1, "() => boolean")
  // The host floor beneath `std:fs`, `std:args`, `std:process` and `std:env`, one row per
  // slot of its table — the only host-imported intrinsics spellable in VL source. Not the
  // surface an author reaches for, but a host embedder implementing the ABI needs them.
  let fk = 0
  while fk < fsIntrinsicCount() {
    blPush(fsIntrinsicNameAt(fk), 1, fsIntrinsicSig(fk))
    fk = fk + 1
  }
  blName.length
}
export function builtinCount(): i32 { blName.length }
export function builtinNameLen(i: i32): i32 { blName[i].length }
export function builtinNameCharAt(i: i32, j: i32): i32 { blName[i][j] }
export function builtinKindAt(i: i32): i32 { blKind[i] }
export function builtinTypeLen(i: i32): i32 { blType[i].length }
export function builtinTypeCharAt(i: i32, j: i32): i32 { blType[i][j] }

// ── LSP lexical semantic tokens: keywords / operators / literals / comments ────
// Needs no typecheck: `lexScan()` tokenizes the staged source and records, per
// coloured token, a lexical class (0 keyword .. 5 template text) plus its position;
// uncoloured kinds (identifiers, strings, punctuation) drop out at class < 0.
let lexCls: i32[] = []
let lexLine: i32[] = []
let lexCol: i32[] = []
let lexLen: i32[] = []

// The lexical class for a lexer token kind, or -1 for kinds that get no token.
// Keyed off the lexer's actual kind tags, so every operator the lexer emits colours.
// The keyword arms copy `keywordKind`'s (`lexer.vl`); `tests/keyword_vocabulary_test.ts`
// derives the set from the lexer and fails this function when an arm is missing.
function lexClassOf(kind: TokKind): i32 {
  if kind == "NUMBER" { return 2 }
  if (
    kind == "TEMPLATE"
    || kind == "TEMPLATE_HEAD"
    || kind == "TEMPLATE_MID"
    || kind == "TEMPLATE_TAIL"
  ) {
    return 5
  }
  if kind == "TRUE" || kind == "FALSE" || kind == "NULL" { return 3 }
  if (
    kind == "FUNCTION"
    || kind == "IF"
    || kind == "ELSE"
    || kind == "WHILE"
    || kind == "FOR"
    || kind == "CONST"
    || kind == "LET"
    || kind == "RETURN"
    || kind == "IS"
    || kind == "AWAIT"
    || kind == "BREAK"
    || kind == "CONTINUE"
    || kind == "TYPE"
    || kind == "IMPORT"
    || kind == "EXPORT"
    || kind == "EXTERN"
    || kind == "MATCH"
  ) {
    return 0
  }
  if (
    kind == "PLUS"
    || kind == "MINUS"
    || kind == "STAR"
    || kind == "SLASH"
    || kind == "PERCENT"
    || kind == "CARET"
    || kind == "EQUAL"
    || kind == "PLUSEQ"
    || kind == "MINUSEQ"
    || kind == "STAREQ"
    || kind == "SLASHEQ"
    || kind == "PERCENTEQ"
    || kind == "AMPEQ"
    || kind == "PIPEEQ"
    || kind == "CARETEQ"
    || kind == "SHLEQ"
    || kind == "SHREQ"
    || kind == "USHREQ"
    || kind == "PLUSPLUS"
    || kind == "MINUSMINUS"
    || kind == "AND"
    || kind == "OR"
    || kind == "BANG"
    || kind == "EQ"
    || kind == "NE"
    || kind == "GT"
    || kind == "GE"
    || kind == "LT"
    || kind == "LE"
    || kind == "PIPE"
    || kind == "AMPERSAND"
    || kind == "TILDE"
    || kind == "SHL"
    || kind == "SHR"
    || kind == "USHR"
    || kind == "QUESTION_DOT"
    || kind == "QUESTION_QUESTION"
    || kind == "ELLIPSIS"
  ) {
    return 1
  }
  -1
}

export function lexScan(): i32 {
  lexCls = []
  lexLine = []
  lexCol = []
  lexLen = []
  const r = tokenize(vcSource())
  let i = 0
  while i < r.tokens.length {
    const t = r.tokens[i]
    const c = lexClassOf(t.kind)
    if c >= 0 {
      lexCls.push(c)
      lexLine.push(t.line)
      lexCol.push(t.col)
      lexLen.push(t.text.length)
    }
    i = i + 1
  }
  // Retained comments → class COMMENT. The lexeme text includes the leading `//`
  // or `///`, so its length spans the whole comment to end of line.
  let k = 0
  while k < r.comments.length {
    const cm = r.comments[k]
    lexCls.push(4)
    lexLine.push(cm.line)
    lexCol.push(cm.col)
    lexLen.push(cm.text.length)
    k = k + 1
  }
  lexCls.length
}
// ── LSP declaration and block extents: the nested outline and body folding ────
// Parse only — no typecheck, no module resolution — because the editor asks on every
// keystroke and a file that does not check must still outline. A parse error is not a
// failure: `parseProgram` recovers, and the rows that closed are the answer.
export function extentScan(): i32 {
  parseStateReset()
  vcLoadToksEntry(vcSource())
  extCollect(parseProgram())
}

export function lexCount(): i32 { lexCls.length }
export function lexClassAt(i: i32): i32 { lexCls[i] }
export function lexLineAt(i: i32): i32 { lexLine[i] }
export function lexColAt(i: i32): i32 { lexCol[i] }
export function lexLenAt(i: i32): i32 { lexLen[i] }

// All failure diagnostics, newline-joined: parse diags, then typecheck diags,
// then the emit failure message (whichever stage failed populated its store).
function vcDiags(): string {
  let out = ""
  let i = 0
  while i < P.diags.length {
    const d = P.diags[i]
    out = out + demangleMsg(d.msg) + "\n"
    i = i + 1
  }
  let j = 0
  while j < T.diags.length {
    const d2 = T.diags[j]
    out = out + demangleMsg(d2.tmsg) + "\n"
    j = j + 1
  }
  if emitErr.length > 0 { out = out + demangleMsg(emitErr) + "\n" }
  out
}
// The host reads the joined text one code point per call (`diagAt(i)`), so
// re-rendering on each read would make error reporting quadratic in the diagnostic
// text. Memoized (the `symTyBuf` idiom); the pipeline entry points invalidate it
// (`vcDiagMemoReset`) before repopulating the diagnostic stores.
let vcDiagsBuf = ""
let vcDiagsBufValid = 0
function vcDiagsMemo(): string {
  if vcDiagsBufValid == 0 {
    vcDiagsBuf = vcDiags()
    vcDiagsBufValid = 1
  }
  vcDiagsBuf
}
// Per-message memo for the structured stream (`diagMsgAt(i, j)` is likewise
// read once per character): the last (index, rendered message) pair.
let vcDiagMsgBufI = -1
let vcDiagMsgBuf = ""
function vcDiagMemoReset(): i32 {
  vcDiagsBufValid = 0
  vcDiagMsgBufI = -1
  0
}
export function diagLen(): i32 { vcDiagsMemo().length }
export function diagAt(i: i32): i32 { vcDiagsMemo()[i] }

// ── structured per-diagnostic exports (positions) ─────────────────────────────
// Parallel to `diagLen`/`diagAt`, which stay byte-compatible for corpus `@error`
// substring matches. The host reads `diagCount()` diagnostics, each with a
// per-byte message and a position (`diagLine`, 0 = no position; `diagCol`, 0-based).
export function vcDiagMsg(i: i32): string {
  // Demangle the module-merge `$mN` rename artifact so the user sees SOURCE names.
  if i < P.diags.length { return demangleMsg(P.diags[i].msg) }
  const j = i - P.diags.length
  if j < T.diags.length { return demangleMsg(T.diags[j].tmsg) }
  demangleMsg(emitErr)
}
export function diagCount(): i32 {
  let n = P.diags.length + T.diags.length
  if emitErr.length > 0 { n = n + 1 }
  n
}
// The stage that produced diagnostic `i`, over the same index math every other `diag*`
// accessor uses: `P.diags` is the front end's stream, `T.diags` the checker's, and the
// trailing `emitErr` the emitter's one refusal. `import`, `parse`, `type` or `emit` —
// the four the return-code ladder and the module phase distinguish.
export function diagStage(i: i32): string {
  if i < P.diags.length {
    if i < modResolveDiagN { return "import" }
    return "parse"
  }
  const j = i - P.diags.length
  if j < T.diags.length { return "type" }
  "emit"
}
function vcDiagMsgMemo(i: i32): string {
  if vcDiagMsgBufI != i {
    vcDiagMsgBuf = vcDiagMsg(i)
    vcDiagMsgBufI = i
  }
  vcDiagMsgBuf
}
export function diagMsgLen(i: i32): i32 { vcDiagMsgMemo(i).length }
export function diagMsgAt(i: i32, j: i32): i32 { vcDiagMsgMemo(i)[j] }
export function diagLine(i: i32): i32 {
  if i < P.diags.length {
    // A tokenless diag (lex / module-resolution) carries its own position.
    const k = vcDgFind(i)
    if k >= 0 { return vcDgLine[k] }
    // A parse diag is anchored at a token index; out of range ⇒ no position.
    const at = P.diags[i].at
    if at >= 0 && at < P.toks.length { return P.toks[at].line }
    return 0
  }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tline }
  // The emit failure (the last diagnostic): anchored at the function being lowered
  // when it failed (`emitErrAt`, resolved through `nodeToks` like a type diag), so
  // the diagnostic carries a source span. -1 ⇒ positionless (rendered bare).
  const et = emitErrTokIx()
  if et >= 0 { return P.toks[et].line }
  0
}
export function diagCol(i: i32): i32 {
  if i < P.diags.length {
    const k = vcDgFind(i)
    if k >= 0 { return vcDgCol[k] }
    const at = P.diags[i].at
    if at >= 0 && at < P.toks.length { return P.toks[at].col }
    return 0
  }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tcol }
  const et = emitErrTokIx()
  if et >= 0 { return P.toks[et].col }
  0
}
// The token index the emit-failure diagnostic anchors at (its function's decl),
// or -1 for a positionless (module-level) failure — the `emitErrAt` node resolved
// through `nodeToks`, mirroring a type diag's node→token resolution.
function emitErrTokIx(): i32 { declAnchorTokIx(emitErrAt) }

// The token an emit-side diagnostic anchors arena node `nodeIx` at, or -1. Prefers
// the declaring-name token over `nodeToks`' closing-brace anchor for a `FuncDecl`,
// since the name is where an editor jumps. D1578 — the one speller shared by the
// refusal channel and the validate diagnostic's function spans, so they cannot drift.
function declAnchorTokIx(nodeIx: i32): i32 {
  if nodeIx < 0 { return -1 }
  const nm = declNameTokOf(nodeIx)
  if nm >= 0 && nm < P.toks.length { return nm }
  if nodeIx >= nodeToks.length { return -1 }
  const at = nodeToks[nodeIx]
  if at >= 0 && at < P.toks.length { return at }
  -1
}

// A min-tree over the tokens' start offsets, built by `emitSrcSection` for its own rows and
// dropped after. Node 1 is the root, node `k` has children `2k` and `2k + 1`, and leaf
// `satSize + t` holds `P.toks[t].start`; the padding leaves hold the largest i32.
let satMin: i32[] = []
let satSize = 0
let satLive = false

function satBuild() {
  const n = P.toks.length
  let sz = 1
  while sz < n { sz = sz * 2 }
  satMin = []
  let k = 0
  while k < 2 * sz {
    satMin.push(2147483647)
    k = k + 1
  }
  k = 0
  while k < n {
    satMin[sz + k] = P.toks[k].start
    k = k + 1
  }
  k = sz - 1
  while k >= 1 {
    const l = satMin[2 * k]
    const r = satMin[2 * k + 1]
    if l < r { satMin[k] = l } else { satMin[k] = r }
    k = k - 1
  }
  satSize = sz
  satLive = true
  0
}

function satDrop() {
  satMin = []
  satSize = 0
  satLive = false
  0
}

// The largest token index `t <= last` in node `node`'s span `[nl, nr]` whose start is at or
// before `at`, or -1 when none is.
function satFind(node: i32, nl: i32, nr: i32, last: i32, at: i32): i32 {
  if node < 1 || node >= satMin.length { return -1 }
  if nl > last || satMin[node] > at { return -1 }
  if nl == nr { return nl }
  const mid = nl + (nr - nl) / 2
  const right = satFind(2 * node + 1, mid + 1, nr, last, at)
  if right >= 0 { return right }
  satFind(2 * node, nl, mid, last, at)
}

// The token a module-scope statement's diagnostic anchors at: its declaring name, else its
// first token rather than `nodeToks`' closing one — the first, walking back from the last, that
// starts at or before the node. `emitSrcSection` asks this of every statement, so there
// `satFind` answers it instead of a walk as long as the statement (D2190).
function stmtAnchorTokIx(nodeIx: i32): i32 {
  const nm = declNameTokOf(nodeIx)
  if nm >= 0 && nm < P.toks.length { return nm }
  if nodeIx < 0 || nodeIx >= nodeToks.length { return -1 }
  const last = nodeToks[nodeIx]
  if last < 0 || last >= P.toks.length { return -1 }
  const at = nodePos(nodeIx)
  if at < 0 { return last }
  if satLive && satSize >= P.toks.length {
    const found = satFind(1, 0, satSize - 1, last, at)
    if found >= 0 && P.toks[found].start == at { return found }
    return last
  }
  let t = last
  while t >= 0 {
    const s = P.toks[t].start
    if s == at { return t }
    if s < at { return last }
    t = t - 1
  }
  last
}

// ── the emitted module's byte offset → the function that owns it (D1578) ─────
// A module the engine refuses reports a byte offset into bytes the author never
// sees; `emitCodeSection`'s banked per-body byte ranges turn that into
// `file:line:col` plus the function's name. Lookup is a scan, deliberately.
export function emitFnSpanAt(off: i32): i32 {
  let i = 0
  while i < emitFnSpanStart.length {
    // Kind 5 is a per-statement row banked for the `vl-src` section. This lookup answers the
    // invalid-module diagnostic, whose position is the declaration's by contract (D1578).
    if emitFnSpanKindOf(i) != 5 && emitFnSpanKindOf(i) != 6 {
      if off >= emitFnSpanStart[i] && off < emitFnSpanEnd[i] { return i }
    }
    i = i + 1
  }
  -1
}

// What the body at row `i` is: 0 a user function, 1 a module-scope statement or global
// initializer, 2 an export wrapper, 3 a shared runtime helper, 4 the start function outside
// any statement, 5 a statement and 6 an element read inside a body, -1 for no row. Decoded
// here and in the host's `SpanWhere::what`.
export function emitFnSpanKindOf(i: i32): i32 {
  if i < 0 || i >= emitFnSpanKind.length { return -1 }
  emitFnSpanKind[i]
}
function emitFnSpanTokIx(i: i32): i32 {
  if i < 0 || i >= emitFnSpanNode.length { return -1 }
  // A module-scope statement anchors at its own node (D1594). The stamp test below
  // keeps a synthesized body positionless; a top-level statement is parsed, never
  // synthesized, so requiring a `declNameTok` would throw away its real position.
  // Kind 5 anchors the way a module-scope statement does — at the statement itself.
  const sk = emitFnSpanKindOf(i)
  // Kind 6 is an element read inside a body, anchored at the read itself.
  if sk == 1 || sk == 5 || sk == 6 { return stmtAnchorTokIx(emitFnSpanNode[i]) }
  // The slot's pre-monomorphization original first: a mono instance, a lifted lambda
  // copy, and a pruned stub are all minted after parsing, so `addNode` anchors them
  // at the EOF token — a position that reads as real but points at the file's last
  // line. `monoOrigNode` holds the pristine declaration; only it carries `declNameTok`.
  const orig = monoOrigNodeOfSlot(emitFnSpanPos[i])
  if declNameTokOf(orig) >= 0 { return declAnchorTokIx(orig) }
  const nd = emitFnSpanNode[i]
  if declNameTokOf(nd) >= 0 { return declAnchorTokIx(nd) }
  -1
}
// The pristine pre-pass `FuncDecl` for `fnStmts` slot `fe`, or -1: the slot's own entry
// when the pass froze one, else the ORIGIN slot's when `fe` is an appended instance.
function monoOrigNodeOfSlot(fe: i32): i32 {
  if fe < 0 { return -1 }
  if fe < monoOrigNode.length { return monoOrigNode[fe] }
  let q = 0
  while q < monoInstFe.length {
    if monoInstFe[q] == fe {
      const of = monoInstOrig[q]
      if of >= 0 && of < monoOrigNode.length { return monoOrigNode[of] }
      return -1
    }
    q = q + 1
  }
  -1
}
export function emitFnSpanLine(i: i32): i32 {
  const t = emitFnSpanTokIx(i)
  if t >= 0 { return P.toks[t].line }
  0
}
export function emitFnSpanCol(i: i32): i32 {
  const t = emitFnSpanTokIx(i)
  if t >= 0 { return P.toks[t].col }
  0
}
export function emitFnSpanModule(i: i32): i32 {
  const t = emitFnSpanTokIx(i)
  if t >= 0 { return modOfTok(t) }
  0
}
// ── the `vl-src` custom section: a module byte offset → the source line ──────────
// Serialises the `emitFnSpan*` table plus its per-statement rows, so a host turns a trap
// frame's offset into the instruction's line with no compiler session. Rows are already
// module-relative. Rides `--names` — DECISIONS.md §"The `vl-src` section rides `--names`".
function emitSrcSection(): i32 {
  if gEmitNames == 0 || gEmitSrcMap == 0 { return 0 }
  if emitFnSpanStart.length == 0 { return 0 }
  // The file table, in module order, through the one speller the name section's own suffix
  // uses — so the two cannot spell a file two ways (open-rulings §trap-frame-path-spelling).
  satBuild()
  const files: string[] = []
  let r = 0
  while r < emitFnSpanStart.length {
    const m = emitFnSpanModule(r)
    while files.length <= m { files.push("") }
    if files[m] == "" { files[m] = srcmapPathOf(m) }
    r = r + 1
  }
  // A single-file program has no module table: its one file is the entry, spelled as the
  // module table spells an entry, by its name.
  if files.length > 0 && files[0] == "" {
    files[0] = srcEntryName(checkEntryPath)
  }
  const payload: u8[] = []
  const prev = wTarget(payload)
  wULEB(files.length)
  let f = 0
  while f < files.length {
    wName(files[f])
    f = f + 1
  }
  // One row per span: the byte range, its anchor's line and column, and which file. A row
  // with line 0 has no anchor at all, so it is dropped rather than written and skipped — and
  // the count is a ULEB prefix, so the kept rows are counted before any are written.
  let kept = 0
  let c = 0
  while c < emitFnSpanStart.length {
    if emitFnSpanLine(c) > 0 { kept = kept + 1 }
    c = c + 1
  }
  wULEB(kept)
  let i = 0
  while i < emitFnSpanStart.length {
    const ln = emitFnSpanLine(i)
    if ln > 0 {
      wULEB(emitFnSpanStart[i])
      wULEB(emitFnSpanEnd[i])
      wULEB(ln)
      wULEB(emitFnSpanCol(i))
      wULEB(emitFnSpanModule(i))
    }
    i = i + 1
  }
  wTarget(prev)
  satDrop()
  const sec: u8[] = []
  const secPrev = wTarget(sec)
  wName("vl-src")
  wBytes(payload)
  wTarget(secPrev)
  // Appended to the finished module: legal for a custom section, and it leaves every other
  // section's bytes at the offsets the rows name.
  wSection(0, sec)
  0
}

// The file name in path `p`: what follows its last `/`.
function srcEntryName(p: string): string {
  let cut = 0
  let i = 0
  while i < p.length {
    if p[i] == '/' { cut = i + 1 }
    i = i + 1
  }
  p.slice(cut, p.length)
}

// The `vl-extern-bool` custom section: the extern globals declared `boolean`, which cross as a
// plain i32, so a host supplying one can refuse a value that is neither 0 nor 1 (D2636). It is
// written only when there is one, so no other module's bytes change.
function emitExternBoolSection(): i32 {
  const names: string[] = []
  let i = 0
  while i < extGNames.length && i < extGTys.length {
    if extGTys[i] == "boolean" { names.push(extGNames[i]) }
    i = i + 1
  }
  if names.length == 0 { return 0 }
  const sec: u8[] = []
  const prev = wTarget(sec)
  wName("vl-extern-bool")
  wULEB(names.length)
  let k = 0
  while k < names.length {
    wName(names[k])
    k = k + 1
  }
  wTarget(prev)
  wSection(0, sec)
  0
}

// The name the name section gives this body — a lambda's binding display name where
// it has one, else the declared name — so the host's sentence and the engine's own
// `function[N]::<name>` cannot disagree.
function emitFnSpanName(i: i32): string {
  if i < 0 || i >= emitFnSpanPos.length { return "" }
  // A body with no `FuncDecl` behind it carries its name directly (the shared
  // runtime helpers), spelled as the name section spells it.
  if i < emitFnSpanTag.length {
    if emitFnSpanTag[i].length > 0 { return emitFnSpanTag[i] }
  }
  const p = emitFnSpanPos[i]
  if p >= 0 && p < fnDispNames.length {
    if fnDispNames[p].length > 0 { return fnDispNames[p] }
  }
  // A SYNTHETIC body's row carries node -1, and `P.nodes[-1]` is a trap, not a miss.
  const nd = emitFnSpanNode[i]
  if nd < 0 || nd >= P.nodes.length { return "" }
  const fn = nodeAt(nd)
  if fn is FuncDecl { return fn.fnName }
  ""
}

// The VL type wasm heap type `written` of the module just emitted represents, or "" when it is
// not one this names (a function type, a closure environment) or when several VL types share
// it. A runtime rep shared by several VL types is named by its rep, never by one of its users.
function emitTypeLabel(written: i32): string {
  if written < 0 { return "" }
  const idx = typeOrderOldOf(written)
  const named = emitTypeLabelNamed(idx)
  if named != "" { return named }
  if uDeclared && idx == uBoxIdx { return "union box" }
  if aUsed {
    if idx == sTypeIdx { return "string" }
    if idx == sBackIdx { return "string bytes" }
    if idx == aTypeIdx { return "i32 array (list and map storage)" }
  }
  if lUsed && idx == lTypeIdx { return "list of i32-represented elements" }
  if ba8Used {
    if idx == bl8TypeIdx { return "u8[]" }
    if idx == ba8TypeIdx { return "u8[] storage" }
  }
  if slUsed || mUsed {
    if idx == mkListIdx { return "string list" }
    if idx == mkArrIdx { return "string list storage" }
  }
  if mUsed && idx == mStructIdx { return "string-keyed map or set" }
  ""
}

// The one VL name a declared struct, union variant or ref-list slot gives heap type `idx`, or
// "" when none does or two distinct names share it (a struct and its twins share one heap type).
function emitTypeLabelNamed(idx: i32): string {
  let found = ""
  let clash = false
  if sDeclared {
    let i = 0
    while i < sHeapIdx.length && i < sNames.length {
      if sHeapIdx[i] == idx {
        const n = demangleSpelling(sNames[i])
        if found == "" { found = n }
        else if found != n { clash = true }
      }
      i = i + 1
    }
  }
  if uDeclared {
    let v = 0
    while v < uVarHeap.length && v < uVariants.length {
      if uVarHeap[v] == idx {
        const n = demangleSpelling(uVariants[v])
        if found == "" { found = n }
        else if found != n { clash = true }
      }
      v = v + 1
    }
  }
  let r = 0
  while r < rlElemName.length && r < rlWrapIdx.length && r < rlBackIdx.length {
    if rlWrapIdx[r] == idx || rlBackIdx[r] == idx {
      let n = emitTypeListOf(demangleSpelling(rlElemName[r]))
      if rlBackIdx[r] == idx { n = n + " storage" }
      if found == "" { found = n }
      else if found != n { clash = true }
    }
    r = r + 1
  }
  if clash { return "" }
  found
}

// The list type of element spelling `el`, parenthesised when it is a union.
function emitTypeListOf(el: string): string {
  let i = 0
  while i < el.length {
    if el[i] == '|' { return "(" + el + ")[]" }
    i = i + 1
  }
  el + "[]"
}

export function emitTypeLabelLen(idx: i32): i32 { emitTypeLabel(idx).length }
export function emitTypeLabelAt(idx: i32, j: i32): i32 {
  const s = emitTypeLabel(idx)
  if j >= 0 && j < s.length { return s[j] }
  0
}

// The clause a diagnostic puts after "the emitted module failed to validate", for
// the body at row `i` — "" when no row owns the offset. The host carries the same
// ladder in Rust (`SpanWhere::what`), since `vl build`/`vl run` never enter the CLI
// pump; the two channels move together, as `engineFailOffset` (engine_msg.vl) and its twin do.
export function emitFnSpanWhere(i: i32): string {
  const k = emitFnSpanKindOf(i)
  if k < 0 { return "" }
  if k == 1 || k == 4 { return " inside the module's top-level code" }
  if k == 2 {
    return " inside the export wrapper for `" + emitFnSpanShown(i) + "`"
  }
  if k == 3 {
    return " inside the shared runtime helper `" + emitFnSpanShown(i) + "`"
  }
  " inside `" + emitFnSpanShown(i) + "`"
}

// `emitFnSpanName` as the source spells it: a module merge's `$m1` suffix is not.
function emitFnSpanShown(i: i32): string { demangleSpelling(emitFnSpanName(i)) }
export function emitFnSpanNameLen(i: i32): i32 { emitFnSpanShown(i).length }
export function emitFnSpanNameAt(i: i32, j: i32): i32 {
  const s = emitFnSpanShown(i)
  if j >= 0 && j < s.length { return s[j] }
  0
}

// The token diagnostic `i`'s span ENDS at, or -1 when it has none. A TYPE diag stores the
// token its raise chose (`tendTok`), so the end cannot be derived from a different token than
// the raise picked; a parse diag and the emit failure each end at their one anchor token; a
// lex or module diag is tokenless and carries its own columns in the `vcDg*` side table.
function diagEndTok(i: i32): i32 {
  let at = -1
  if i < P.diags.length {
    if vcDgFind(i) >= 0 { return -1 }
    at = P.diags[i].at
    const spanEnd = dgSpanEndTok(i)
    if spanEnd >= 0 { at = spanEnd }
  } else {
    const j = i - P.diags.length
    if j < T.diags.length {
      at = T.diags[j].tendTok
    } else {
      at = emitErrTokIx()
    }
  }
  if at < 0 || at >= P.toks.length { return -1 }
  at
}

// The 1-based line diagnostic `i`'s span ends on — `diagEndCol` is a column on THIS line, not
// on `diagLine`. Degrades to `diagLine` for a diagnostic whose end is unrecorded or on the
// start line, so a single-line span answers exactly what it did before this export existed.
export function diagEndLine(i: i32): i32 {
  const tk = diagEndTok(i)
  if tk >= 0 {
    const el = tokEndLine(tk)
    if el > diagLine(i) { return el }
  }
  diagLine(i)
}

// The diagnostic's exclusive end column on `diagEndLine`. A span that ends on a LATER line
// takes that line's column whatever its value; one ending on the start line must be wider
// than `diagCol` to be a span at all, and degrades to `diagCol` when it is not.
export function diagEndCol(i: i32): i32 {
  const tk = diagEndTok(i)
  if tk >= 0 {
    const ec = tokEndCol(tk)
    if tokEndLine(tk) > diagLine(i) { return ec }
    if ec > diagCol(i) { return ec }
    return diagCol(i)
  }
  if i < P.diags.length {
    const k = vcDgFind(i)
    if k >= 0 && vcDgEnd[k] > vcDgCol[k] { return vcDgEnd[k] }
  }
  diagCol(i)
}
// The diagnostic's stable category code, "" when it has none: "unsupported-lowering" on a
// type-valid construct codegen cannot lower yet, apart from a soundness verdict. A parse
// diagnostic carries one only when `check --fix` acts on it (`dgMarkCode`), an emit one never.
export function vcDiagCode(i: i32): string {
  if i < P.diags.length { return dgCodeOf(i) }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tcode }
  ""
}
export function diagCodeLen(i: i32): i32 { vcDiagCode(i).length }
export function diagCodeByte(i: i32, j: i32): i32 { vcDiagCode(i)[j] }

// The diagnostic's structured payload, "" when it has none — the second half of
// the coded-diagnostic ABI. The code names a bare category (`ufcs-not-imported`)
// and this carries what that category needs, netstring-encoded so no value's
// characters can bite the framing (`typecheck.diagDataField` documents it).
export function vcDiagData(i: i32): string {
  if i < P.diags.length { return "" }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tdata }
  ""
}
export function diagDataLen(i: i32): i32 { vcDiagData(i).length }
export function diagDataByte(i: i32, j: i32): i32 { vcDiagData(i)[j] }

// ── native module resolution ───────────────────────────────────────────────────
// The module-table half of `docs/native-modules-design.md`. The host runs a fetch
// loop: commits the entry, asks `modPendingCount` which resolved keys are still
// needed, and repeats until the graph closes. An empty table behaves exactly as before.
export function modReset(): i32 {
  modIdReset()
  modKeys = []
  modKeyIx = Map()
  modSrcs = []
  modFound = []
  cpAccReset(modKeyAcc)
  cpAccReset(modSrcAcc)
  impMod = []
  impSpec = []
  impKey = []
  impName = []
  impLocal = []
  impNameLine = []
  impNameCol = []
  impSpecLine = []
  impSpecCol = []
  impSpecEnd = []
  impSpecChar = []
  expMod = []
  expName = []
  expDeclLine = []
  expDeclCol = []
  expKwLine = []
  expKwCol = []
  reExpMod = []
  reExpPublic = []
  reExpLocal = []
  reExpNameLine = []
  reExpNameCol = []
  reExpKwLine = []
  reExpKwCol = []
  reExpKey = []
  reExpName = []
  reExpTarget = []
  expOwnBy = Map()
  expReBy = Map()
  expOwnRead = 0
  expReRead = 0
  modPending = []
  modPendScanned = 0
  modPendSeen = Map()
  // Clears the token-load ranges too: a subsequent single-file check must not
  // inherit a prior graph's ranges, or `symOccModuleAt` would mis-attribute its
  // occurrences. The leaf holds the same ranges and is cleared with them.
  modLoadStart = []
  modLoadMod = []
  srcmapReset()
  0
}
export function modKeyPush(c: i32): i32 {
  cpAccPush(modKeyAcc, c)
  0
}
export function modSrcPush(c: i32): i32 {
  cpAccPush(modSrcAcc, c)
  0
}
// The `modKey`/`modSrc` twins of `srcLoad` — same protocol and staging window.
// `modSrcLoad` carries every module of a multi-file graph (the whole compiler
// during a self-compile); `modKeyLoad` carries only module keys. Both channels
// need the batched form, or the un-converted one keeps paying per code point silently.
export function modKeyLoad(count: i32): i32 {
  cpAccLoad(modKeyAcc, count)
  0
}
export function modSrcLoad(count: i32): i32 {
  cpAccLoad(modSrcAcc, count)
  0
}
// Register the accumulated (key, source) pair. `found = 0` marks "the host could
// not read this key" so the unresolvable diagnostic fires instead of an infinite
// re-request. A found module is token-scanned immediately (imports + exports).
export function modCommit(found: i32): i32 {
  const key = cpAccTake(modKeyAcc)
  const src = cpAccTake(modSrcAcc)
  modCommitStr(key, src, found)
}
// The direct entry point, for a caller that already holds the strings —
// `cliModCommitOne`, VL calling VL with no host boundary. Stages the string
// directly rather than pushing it element by element into the accumulators, which
// would double-encode non-ASCII text; those remain only for the genuine host channel.
export function modCommitStr(key: string, src: string, found: i32): i32 {
  if modKeyIx[key] == null { modKeyIx[key] = modKeys.length }
  modKeys.push(key)
  modSrcs.push(src)
  modFound.push(found)
  if found != 0 { modScanCached(modKeys.length - 1, key, src) }
  modRecomputePending()
  0
}
// Commits the accumulated key from the cache's own copy of its source, so an unchanged
// dependency costs the host no source push. `srcBytes` is the caller's own UTF-8 length,
// and a disagreement is a miss. Returns 1 when the cache served it; 0 leaves the key
// staged, so a miss is finished by `modSrcPush` + `modCommit`.
export function modCommitCached(srcBytes: i32): i32 {
  const key = cpAccString(modKeyAcc)
  const ci = modCacheSlotOfKey(key)
  if ci < 0 { return 0 }
  if modCacheSrcs[ci].length != srcBytes { return 0 }
  cpAccReset(modKeyAcc)
  cpAccReset(modSrcAcc)
  modCommitStr(key, modCacheSrcs[ci], 1)
