import { pushCps } from "./strutil"
// The source-in / bytes-out driver — the interface `scripts/vl-host` embeds against.
// A real `import`/`export` module that imports the pipeline (lexer → ast → parser →
// typecheck → wasmEmit → lint → format) and exposes the host ABI
// (`srcReset`/`compileSrc`/`checkSrc`/`lintSrc`/`formatSrc` plus the LSP query
// families). `compiler/entry.vl` re-exports this ABI under bare names so the
// module-resolved build keeps a stable surface.
//
// Source accumulates as an i32 code-point list (amortized push — string concat per
// char is quadratic copy churn), converted once by the `fromCodePoints` builtin.
import {
  ArrayLit,
