  checkProgram(merged)
  if T.diags.length > 0 { return 2 }
  if emit != 0 {
    const rc = emitProgram(merged)
    if rc < 0 { return 3 }
  }
  0
}

// ── per-module rename map (state at the top of this file) ─────────────────────
// `modRenameFrom[i]` → `modRenameTo[i]`: every top-level value/type name of the
// module maps to `name$mN` (N = the module's TABLE index — entry 0); an imported
// local maps to the EXPORTING module's mangled export name. A generic TYPE
// declaration (`Box<T>` — the parser folds alias parameters into the declared
// name) renames by its BASE segment, so the declaration (→ `Box$mN<T>`) and
// every application (`Box<i32>` → `Box$mN<i32>`) rewrite consistently through
// the segment rewriter. Generic FUNCTIONS carry their parameters out-of-name
// (`fnTyParams`) and rename like any value.
// Both cuts below take the head/argument split from the ONE `<`-scan
// (`typecheck.gaeLtAt`, D-GENAPPDOWN) rather than re-rolling it. This file held the
// FOURTH and FIFTH hand-written copies of that loop — the pair D-GENAPPDOWN filed
// when it moved the home down and could not reach them; `driver.vl` imports
// `typecheck.vl`, so the route is DOWN the graph and legal (D-MODGENLT).
//
// Neither site wants the generic-application SPAN (`annGenAppSpanEnds`). Both are
// asked about a DECLARED name in the merge rename map, where a non-generic name is
// the common case and must fall through to "no cut"; the span's trailing-`>` compare
// would answer false for exactly the names that need the `<` found. Same split pass 0a
// established at the home: the `<`-scan and the span are two predicates, not one.
//
// The base segment of a declared name (`Box` of `Box<T>`); a non-generic name
// is its own base. `gaeLtAt`'s -1 IS the non-generic answer; index 0 keeps the
// copies' own reading (a leading `<` cuts to ""), since `slice(0, 0)` is what the
// hand-rolled loop returned there.
//
// The HEAD cut itself is `tyname.gaeHeadNameOf`, the delimiter-blind home (W2), which
// takes the index this function already holds rather than re-scanning for it. The `lt < 0`
// fall-through STAYS here: it is this site's own reading (a non-generic name is its own
// base) and one of the three disagreeing guards that keep the cut blind. Index 0 keeps the
// copies' reading too (a leading `<` cuts to ""), since `slice(0, 0)` is what the
// hand-rolled loop returned there. The tail is a plain CALL, which lowers — it is a bare
// member-call statement that does not (`emitProgram: unsupported member-call statement`),
// which is why the home binds its slice and this site no longer has to.
function modGenBase(name: string): string {
  const lt = gaeLtAt(name)
  if lt < 0 { return name }
  gaeHeadNameOf(name, lt)
}
// The type-parameter names folded into a generic declared name (`Pair<A,B>` →
