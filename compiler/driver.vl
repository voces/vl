  let i = 0
  while i <= tn.length {
    const atEnd = i == tn.length
    let c = 0
    if !atEnd { c = tn[i] }
    let isIdent = false
    if !atEnd { isIdent = nameIdentChar(c) }
    if isIdent {
      if runStart < 0 { runStart = i }
    } else {
      if runStart >= 0 && i > runStart {
        const seg = tn.slice(runStart, i)
        runStart = 0 - 1
