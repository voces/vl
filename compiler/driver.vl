}
// A VALUE reference: shadowed locals win, then the rename map, else unchanged.
function modRenamed(name: string): string {
  if capHas(modShadow, name) { return name }
  let j = 0
  while j < modRenameFrom.length {
    if modRenameFrom[j] == name { return modRenameTo[j] }
    j = j + 1
  }
  name
}
// A TYPE-position name: annotations are SYNTHETIC strings ("A|B", "Point[]",
// "Box<i32>"), so rewrite identifier SEGMENTS through the rename map (types are
// never shadowed by locals — VL has no local type declarations). Quoted
// string-literal segments (`"a"|"b"`) are copied verbatim.
//
// The identifier CHARACTER CLASS is `tyname.nameIdentChar` (W8) — the half this body shares
// with `modGenParams` above, character for character. The RUN WALK is not routed and the
// reason is measured: the quoted-segment skip below is the NAIVE one ("no escapes in type
// names") while the leaf's is `skipQuotedName`, which honours `\`, and they disagree on a
// literal member carrying an escaped quote (`type T = "a\"b"`, which the compiler accepts
// and runs). Adopting the leaf's rule would rename inside a quoted member differently —
// arguably better, certainly a BEHAVIOUR change — so it is filed rather than taken here.
function modTypeRenamed(tn: string): string {
  const out: i32[] = []
  let run: i32[] = []
  let i = 0
  while i <= tn.length {
    const atEnd = i == tn.length
    let c = 0
    if !atEnd { c = tn[i] }
    let isIdent = false
    if !atEnd { isIdent = nameIdentChar(c) }
    if isIdent {
      run.push(c)
    } else {
      if run.length > 0 {
        const seg = fromCodePoints(run)
        run = []
        let rep = seg
        // A live generic type-parameter name is the PARAMETER here, never the
        // top-level binding it may textually collide with.
        if !capHas(modTyShadow, seg) {
          let j = 0
          while j < modRenameFrom.length {
            if modRenameFrom[j] == seg { rep = modRenameTo[j] }
            j = j + 1
          }
        }
        let k = 0
        while k < rep.length {
          out.push(rep[k])
          k = k + 1
        }
      }
      if !atEnd {
        if c == '"' {
          // copy a quoted literal segment verbatim (no escapes in type names)
          out.push(c)
          i = i + 1
          let copying = true
          while copying && i < tn.length {
            out.push(tn[i])
            if tn[i] == '"' { copying = false }
            i = i + 1
          }
          i = i - 1
        } else {
          out.push(c)
        }
      }
    }
    i = i + 1
  }
  fromCodePoints(out)
}

// ── scope-aware arena rewrite (port of the host's moduleRewrite.ts) ───────────
// Rewrites Name references, call targets, declaration names — and (NATIVE
// DIVERGENCE, mechanism not semantics) type-annotation references and type
// declaration names, since the native checker resolves type names from the
// merged program (the host resolves imported types at parse time, so its
// rewriter never sees them). A top-level name shadowed by a param, loop var, or
// block-local `let`/`function` is left alone for that scope's extent
// (`modShadow`, a save/restore stack).
// ── D-PARSETY P1: the merge rewrites the SPELLING TREE, not the string ───────
// Rename every TYPE-position identifier in the spelling subtree rooted at `root`
// through the module's rename map: the head of a `TS_NAME` / `TS_APP` (`Point`,
// `Box` of `Box<i32>`) and a `TS_MAP`'s KEY (itself a type name). A live generic
// type-parameter (`modTyShadow`) is the parameter, never a colliding top-level
// binding — the same guard `modTypeRenamed` applies per segment.
//
// What the TREE knows and the segment scanner cannot: `TS_FIELD.tsText` is a
// FIELD name and `TS_LITSTR` / `TS_LITNUM` are literal lexemes, so none of them
// is a rename candidate. `modTypeRenamed` sees only "an identifier run", so an
// inline object field whose name collides with a top-level type declaration in
// the same module (`type v = i32` + an annotation `{v: i32}`) had its FIELD
// renamed to `v$mN` — the annotation then described a struct with a field no
// literal has, and the diagnostic demangler stripped the `$mN` so the two types
// RENDERED identically (`cannot assign {v: i32} to 'h' of type {v: i32}`). Pin:
// `tests/cases/modules/field-name-shadows-type/`.
function modRwTsName(root: i32): i32 {
  if root < 0 { return 0 }
  const k = tsKind[root]
  if k == TS_NAME || k == TS_APP || k == TS_MAP {
    const seg = tsText[root]
    if seg.length > 0 && !capHas(modTyShadow, seg) {
      let j = 0
      while j < modRenameFrom.length {
        if modRenameFrom[j] == seg { tsText[root] = modRenameTo[j] }
        j = j + 1
      }
    }
  }
  const start = tsKidStart[root]
  const cnt = tsKidCount[root]
  let i = 0
  while i < cnt {
    modRwTsName(tsKids[start + i])
    i = i + 1
  }
  0
}
function modRwType(tyIx: i32): i32 {
  if tyIx < 0 { return 0 }
  const t = P.nodes[tyIx]
  if t is TypeRef {
    // The parser recorded this annotation's structure — rewrite THAT and render
    // the name from it, so the tree and the string stay in lockstep (note 22: an
    // in-place string rewrite between producer and consumer is exactly what left
    // the spelling tree describing the PRE-merge name).
    const root = annTsOf(tyIx)
    if root >= 0 {
      modRwTsName(root)
      t.tyName = tsToName(root)
      return 0
    }
    // No recorded spelling: a `TypeRef` the parser never built. None exist at
    // merge time (the emitter's `synthTypeRef` runs much later) — a sabotage
    // build that poisons this arm is corpus byte-, message- and run-identical
    // over 1,282 files — but the character scanner stays as the fall-through so
    // the pass is total either way.
    t.tyName = modTypeRenamed(t.tyName)
  }
  0
}
// The first `saved` entries of a shadow stack (rebuild — a bare `.pop()`
// STATEMENT is an emit gap in the native pipeline).
function modTrimTo(stack: string[], saved: i32): string[] {
  const keep: string[] = []
  let ki = 0
  while ki < saved {
    keep.push(stack[ki])
    ki = ki + 1
  }
  keep
}
function modShadowTrim(saved: i32): i32 {
  modShadow = modTrimTo(modShadow, saved)
  0
}
function modRwFunc(ix: i32): i32 {
  const n = P.nodes[ix]
  if n is FuncDecl {
    n.fnName = modRenamed(n.fnName)
    const saved = modShadow.length
    const tySaved = modTyShadow.length
    // The function's generic type parameters are live across its annotations
    // and body — segments naming them must not rewrite (see `modTyShadow`).
    let ti = 0
    while ti < n.fnTyParams.length {
      modTyShadow.push(n.fnTyParams[ti])
      ti = ti + 1
    }
    let pi = 0
    while pi < n.fnParams.length {
      const p = P.nodes[n.fnParams[pi]]
      if p is Param {
        modShadow.push(p.parName)
        modRwType(p.parType)
      }
      pi = pi + 1
    }
    modRwType(n.fnRet)
    modRwStmt(n.fnBody)
    modShadowTrim(saved)
    modTyShadow = modTrimTo(modTyShadow, tySaved)
  }
  0
}
// Push arm `k`'s payload-binding names onto the merge's shadow set (the caller trims). Reads them
// off the `LetDecl`s the parser banked in `matchBinds[armStart[k] + j]` — the SAME nodes the
// desugar prepends to the arm body, so the shadow set and the eventual declarations cannot drift.
function modShadowMatchBinds(n: MatchExpr, k: i32): i32 {
  const start = n.matchArmStart[k]
  let j = 0
  while j < n.matchArmCount[k] {
    const bIx = n.matchBinds[start + j]
    if bIx >= 0 {
      const bn = P.nodes[bIx]
      if bn is Block {
        let s = 0
        while s < bn.blkStmts.length {
          const st = P.nodes[bn.blkStmts[s]]
          if st is LetDecl { modShadow.push(st.letName) }
          s = s + 1
        }
      }
    }
    j = j + 1
  }
  0
}
function modRwBlock(ix: i32): i32 {
  const n = P.nodes[ix]
  if n is Block {
    // Block-local `let`/`function` names shadow a same-named top-level binding
    // for the WHOLE block (VL `let` is block-scoped, visible across the block).
    const saved = modShadow.length
    let pre = 0
    while pre < n.blkStmts.length {
      const st = P.nodes[n.blkStmts[pre]]
      if st is LetDecl { modShadow.push(st.letName) }
      if st is FuncDecl {
        if st.fnName != "" { modShadow.push(st.fnName) }
      }
      pre = pre + 1
    }
    let i = 0
    while i < n.blkStmts.length {
      modRwStmt(n.blkStmts[i])
      i = i + 1
    }
    modShadowTrim(saved)
  }
  0
}
function modRwStmt(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Program {
    let i = 0
    while i < n.progStmts.length {
      modRwStmt(n.progStmts[i])
      i = i + 1
    }
    return 0
  }
  if n is Block { return modRwBlock(ix) }
  if n is LetDecl {
    // The initializer evaluates in the ENCLOSING scope; rewrite it before the
    // name. At the top level the declaration name is RENAMED; in a nested block
    // it is pre-collected into the shadow set, so `modRenamed` is a no-op.
    if n.letInit >= 0 { modRwExpr(n.letInit) }
    modRwType(n.letType)
    n.letName = modRenamed(n.letName)
    return 0
  }
  if n is FuncDecl { return modRwFunc(ix) }
  if n is RetStmt {
    if n.retArg >= 0 { modRwExpr(n.retArg) }
    return 0
  }
  if n is IfStmt {
    modRwExpr(n.ifCond)
    modRwStmt(n.ifThen)
    if n.ifElse >= 0 { modRwStmt(n.ifElse) }
    return 0
  }
  if n is WhileStmt {
    modRwExpr(n.whileCond)
    modRwStmt(n.whileBody)
    return 0
  }
  if n is ForRange {
    modRwExpr(n.frFrom)
    modRwExpr(n.frTo)
    if n.frStep >= 0 { modRwExpr(n.frStep) }
    const frSaved = modShadow.length
    modShadow.push(n.frVar)
    modRwStmt(n.frBody)
    modShadowTrim(frSaved)
    return 0
  }
  if n is ForIn {
    modRwExpr(n.fiIter)
    const fiSaved = modShadow.length
    modShadow.push(n.fiVar)
    modRwStmt(n.fiBody)
    modShadowTrim(fiSaved)
    return 0
  }
  if n is BreakStmt { return 0 }
  if n is ContinueStmt { return 0 }
  if n is TypeDecl {
    // A generic alias's parameters (folded into the declared name) are live
    // across the name and the field annotations.
    const tdTySaved = modTyShadow.length
    const tdPs = modGenParams(n.tdName)
    let tdPi = 0
    while tdPi < tdPs.length {
      modTyShadow.push(tdPs[tdPi])
      tdPi = tdPi + 1
    }
    n.tdName = modTypeRenamed(n.tdName)
    let i = 0
    while i < n.tdFields.length {
      const f = P.nodes[n.tdFields[i]]
      if f is FieldDef { modRwType(f.fdType) }
      i = i + 1
    }
    modTyShadow = modTrimTo(modTyShadow, tdTySaved)
    return 0
  }
  if n is UnionDecl {
    const udTySaved = modTyShadow.length
    const udPs = modGenParams(n.udName)
    let udPi = 0
    while udPi < udPs.length {
      modTyShadow.push(udPs[udPi])
      udPi = udPi + 1
    }
    n.udName = modTypeRenamed(n.udName)
    const vs: string[] = []
    let i = 0
    while i < n.udVariants.length {
      // D-PARSETY P2: each MEMBER's spelling is banked on this node in member
      // order (`setUdTs`), so the merge renames the tree and renders. Same
      // repair, same bug, third position: `type v = i32` + a member `{ v: i32 }`
      // renamed the FIELD, and the union's own member no longer matched the
      // literal that builds it. Pin:
      // `tests/cases/modules/union-variant-field-shadows-type/`.
      const vRoot = udTsRootAt(ix, i)
      if vRoot >= 0 {
        modRwTsName(vRoot)
        vs.push(tsToName(vRoot))
      } else {
        vs.push(modTypeRenamed(n.udVariants[i]))
      }
      i = i + 1
    }
    n.udVariants = vs
    modTyShadow = modTrimTo(modTyShadow, udTySaved)
    return 0
  }
  modRwExpr(ix)
}

// The CHECK-TYPE half of the `IsExpr` merge rename, split out so a `match` arm's TYPE pattern
// — an `IsExpr` whose object is the shared scrutinee node, already rewritten by the owning
// `MatchExpr` arm — can rename its type WITHOUT re-walking that object. A no-op on any other
// node kind, so the caller need not pre-classify.
//
// D-PARSETY P2: the `is` check type is a parser SPELLING banked on this node, so the merge
// renames the TREE and renders — the same repair P1 made for a `TypeRef`, and it fixes the same
// bug in this position (`type v = i32` in a module + `x is { v: i32 }` renamed the FIELD, and
// the check type stopped being a variant of its own union). Pin:
// `tests/cases/modules/is-type-field-shadows-type/`.
function modRwIsType(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is IsExpr {
    const isRoot = annTsOf(ix)
    if isRoot >= 0 {
      modRwTsName(isRoot)
      n.isVariant = tsToName(isRoot)
      return 0
    }
    n.isVariant = modTypeRenamed(n.isVariant)
  }
  0
}

function modRwExpr(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Ident {
    n.identName = modRenamed(n.identName)
    return 0
  }
  if n is Call {
    // A UFCS member-call `recv.prop(args)` whose `prop` names a free
    // `self`-function (matching arity) that the merge MANGLED — same-module
    // (`inc` → `inc$m0`) or imported (`shout` → `shout$m1`). The property string
    // on the `Member` is NOT rewritten (a callable field/struct method of the
    // same name must keep field precedence, which the checker/emitter decide from
    // the receiver TYPE — info the rename walker lacks). Instead, record the
    // plain→mangled alias so the checker's/emitter's UFCS resolution (which runs
    // AFTER the field check, with the plain `prop`) can find the mangled function.
    const cf = P.nodes[n.callFn]
    if cf is Member {
      const target = modSelfFnTarget(cf.memProp, n.callArgs.length)
      if target != "" { ufcsAliasAdd(cf.memProp, target) }
    }
    modRwExpr(n.callFn)
    let i = 0
    while i < n.callArgs.length {
      modRwExpr(n.callArgs[i])
      i = i + 1
    }
    return 0
  }
  if n is Member {
    // The property is a field label, never a top-level binding — receiver only.
    modRwExpr(n.memObj)
    return 0
  }
  if n is OptMember {
    modRwExpr(n.omObj)
    return 0
  }
  if n is Index {
    modRwExpr(n.idxArr)
    modRwExpr(n.idxIndex)
    return 0
  }
  if n is BinExpr {
    modRwExpr(n.binLeft)
    modRwExpr(n.binRight)
    return 0
  }
  if n is Unary {
    modRwExpr(n.unArg)
    return 0
  }
  if n is Paren {
    modRwExpr(n.parInner)
    return 0
  }
  if n is ObjLit {
    let i = 0
    while i < n.objFields.length {
      const f = P.nodes[n.objFields[i]]
      if f is FieldInit { modRwExpr(f.fiValue) }
      i = i + 1
    }
    return 0
  }
  if n is ArrayLit {
    let i = 0
    while i < n.arrElems.length {
      modRwExpr(n.arrElems[i])
      i = i + 1
    }
    return 0
  }
  if n is IsExpr {
    modRwExpr(n.isObj)
    return modRwIsType(ix)
  }
  if n is AsExpr {
    modRwExpr(n.asObj)
    // The cast TARGET is renamable. #1121 left this arm operand-only on the
    // reading that "`asTy` is a numeric primitive, never a renamable import";
    // what the checker requires is that the target RESOLVE to a numeric scalar
    // (`primNameOf(nameToTyAt(asTy))`), and a user alias does — `type Id = i32`
    // + `x as Id` is a legal single-file program. The merge renamed the
    // declaration to `Id$mN` and left the cast spelling alone, so EVERY module
    // program casting to a named alias failed with ``unknown type `Id` in `as`
    // cast`` — whether the alias was declared in the entry module, in another
    // module, imported, or reached through a chain. Pin:
    // `tests/cases/modules/as-cast-alias/`.
    //
    // The TREE leg, not the scanner: `modTypeRenamed` is itself a hand-rolled
    // identifier-segment parser over a rendered type name (the one this program
    // is retiring — 5 call sites on master, 3 already arena-first). Routing the
    // new consumer through it would have added a SIXTH live one. Stated plainly:
    // the scanner alone WOULD have fixed both pins (measured — a build with the
    // tree leg deleted runs them), because the checker only admits a cast target
    // that resolves to a numeric scalar, so no field name and no literal lexeme
    // — the two things the tree knows and the scanner cannot — can appear here.
    // The defect was a MISSING CONSUMER, not a scanner defect.
    const asRoot = annTsOf(ix)
    if asRoot >= 0 {
      modRwTsName(asRoot)
      n.asTy = tsToName(asRoot)
      return 0
    }
    n.asTy = modTypeRenamed(n.asTy)
    return 0
  }
  // A `match` (value- or statement-position; `modRwStmt` falls through to here). The merge
  // rename must descend into the scrutinee and EVERY arm body — else an imported / merged
  // name used in an arm (`match k { "a" => sink(1) }`) keeps its bare spelling and resolves
  // to nothing after the export's rename. A body may be a block (its own scope) or a bare
  // expression — `modRwStmt` dispatches both.
  //
  // PATTERNS: a string literal / the `_` wildcard hold no renamable identifier, but a TYPE
  // pattern is an `IsExpr` whose check type IS renamable (`match u { Shape => … }` over an
  // imported `Shape`), and its OBJECT is the scrutinee node this arm already rewrote — so the
  // patterns take `modRwIsType`, the check-type half of the `IsExpr` arm above, and NOT
  // `modRwExpr`, which would walk the shared scrutinee once more per arm and rename it n+1
  // times over (`x` → `x$m0` → `x$m0$m0`).
  if n is MatchExpr {
    modRwExpr(n.matchScrut)
    let p = 0
    while p < n.matchPats.length {
      modRwIsType(n.matchPats[p])
      p = p + 1
    }
    let i = 0
    while i < n.matchBodies.length {
      // PAYLOAD BINDINGS (phase 2b) hold nothing this pass renames — a bind's initializer is a
      // `Member` over the SHARED scrutinee node (renamed once, above) and its `letName` is an
      // arm-local. But the names must SHADOW: the desugar later prepends them to this very body,
      // so a module-level `const x` renamed to `x$m0` would otherwise capture the body's `x` and
      // the arm would read the global instead of its own binding. `modRwBlock` already does this
      // for a `const` written inside the block — the clause is the same declaration, one desugar
      // step early.
      const saved = modShadow.length
      modShadowMatchBinds(n, i)
      modRwStmt(n.matchBodies[i])
      modShadowTrim(saved)
      i = i + 1
    }
    return 0
  }
  if n is FuncDecl { return modRwFunc(ix) }
  0
}
