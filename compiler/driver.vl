// `modSelfFnTarget`, asked of a rename TARGET rather than of a call.
function modSelfFnDeclared(name: string): boolean {
  let i = 0
  while i < modSelfFnName.length {
    if modSelfFnName[i] == name { return true }
    i = i + 1
  }
