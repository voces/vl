  const lt = gaeLtAt(name)
  if lt < 0 { return out }
  let run: i32[] = []
  let i = lt + 1
  while i < name.length {
    const c = name[i]
    if nameIdentChar(c) {
      run.push(c)
    } else if run.length > 0 {
      out.push(fromCodePoints(run))
      run = []
    }
    i = i + 1
  }
  out
}
// Diagnose every top-level declaration of module `m` whose name (base segment,
