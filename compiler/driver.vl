  0
}
function modIndexOfKey(key: string): i32 {
  let i = 0
  while i < modKeys.length {
    if modKeys[i] == key { return i }
    i = i + 1
  }
  -1
}
function modRecomputePending(): i32 {
  modPending = []
  let i = 0
  while i < impKey.length {
    const k = impKey[i]
    if k != "" && modIndexOfKey(k) < 0 {
      if !capHas(modPending, k) { modPending.push(k) }
    }
    i = i + 1
  }
  0
}

// ── module pipeline (order/validate → parse-merge → rename/rewrite) ───────────
// DFS state lives at the top of this file: 0 unvisited, 1 loading (on the stack
// — a back-edge is a cycle), 2 done. `modOrder` collects table indices in
// dependency-first (post) order.
// Record one module-resolution diagnostic with its position and owning module.
// Deduped on (module, message) — the same missing module imported by TWO files
// is two findings, one per importer; repeated imports WITHIN one module (e.g.
// several names pulled from one unresolvable specifier) still fold into one.
let modDiagLine: i32[] = []
let modDiagCol: i32[] = []
let modDiagMod: i32[] = []
function modDiag(m: i32, line: i32, col: i32, msg: string): i32 {
  let i = 0
  while i < modDiags.length {
    if modDiagMod[i] == m && modDiags[i] == msg { return 0 }
    i = i + 1
  }
  modDiags.push(msg)
  modDiagLine.push(line)
  modDiagCol.push(col)
  modDiagMod.push(m)
  0
}
// Is `name` part of module `m`'s PUBLIC surface? The surface is the UNION of two
// tables, and reading only the first was the whole of the `export … from` gap: a
// declaration marked `export` lands in `expName`, but a RE-EXPORT
// (`export { name } from "dep"`) lands in `reExpPublic` and NOTHING ever writes it
// to `expName` — so a sibling importing a re-exported name was told `"name" is not
// exported by "./mid"` even though `modScan` had recorded the re-export correctly.
//
// The two tables stay SEPARATE rather than merging at the scan: `expName` doubles as
// "declarations that carry the keyword HERE" for the LSP's cross-file
// go-to-definition (it publishes each entry's decl line/col) and its
// redundant-export-keyword hint, and a re-export declares nothing in this module —
// folding it into `expName` would make go-to-definition land on the re-export line
// and make the hint fire on every re-export. Visibility is the union; provenance is
// not.
function modExportsHas(m: i32, name: string): boolean {
  let i = 0
  while i < expMod.length {
    if expMod[i] == m && expName[i] == name { return true }
    i = i + 1
  }
  // A re-export publishes its PUBLIC name (`reExpPublic` — the `as` alias, else the
  // source name), so `export { a as b } from "dep"` surfaces `b` and NOT `a`.
  let r = 0
  while r < reExpMod.length {
    if reExpMod[r] == m && reExpPublic[r] == name { return true }
    r = r + 1
  }
