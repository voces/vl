}
// `vcLoadToks` for module `m` through the per-instance cache: on a hit, re-pushes
// the cached token objects (only a clean tokenization is cached); on a miss, tokenizes
// and banks the stream if it produced no lex diags. The miss covers a module the scan
// skipped or one whose lex diags made it unbankable.
function vcLoadToksMod(m: i32): i32 {
  vcEpDrop()
  const ci = modCacheLookup(modKeys[m], modSrcs[m])
  if ci >= 0 && modCacheTokN[ci] >= 0 {
    const cached = modCacheTokArr[ci]
    const dst = P.toks
    const n = cached.length
    let ti = 0
    while ti < n {
      dst.push(cached[ti])
      ti = ti + 1
    }
    // The docs ride the same slot: a replay that restored the tokens alone would answer
    // every doc query about this module with nothing at all.
    let di = modCacheDocOff[ci]
    while di >= 0 && di < modCacheDocEnd[ci] {
      docCmtLine.push(modCacheDocLine[di])
      docCmtText.push(modCacheDocText[di])
      docCmtMod.push(vcLoadMod)
      di = di + 1
    }
