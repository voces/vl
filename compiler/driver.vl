}
// Declares that this instance compiles one program and is then dropped, so nothing kept
// for a later compile on it is worth its memory. A host that reuses an instance (an editor,
// a batch harness sharing one) never calls it. Returns 0.
export function setOneShot(on: i32): i32 {
  modOneShot = on
  0
}
// The cache's own counters, for the test that grades the storage bound: 0 = slots,
// 1 = live token rows, 2 = slots a non-trailing drop stranded, 3 = whole-cache clears.
export function modCacheStat(which: i32): i32 {
  if which == 0 { return modCacheKeys.length }
  if which == 1 { return modCacheTokLive }
  if which == 2 { return modCacheDeadSlots }
  if which == 3 { return modCacheClears }
  -1
}
// `modScan` through the per-instance cache: replay a recorded scan under table
