        }
      } else {
        const d = modIndexOfKey(key)
        if d < 0 {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Cannot resolve import \"" + spec + "\" (no module `" + key + "`)",
