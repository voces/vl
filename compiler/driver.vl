export let vcCodes: i32[] = []
// The IN-MODULE source channel — set when a VL caller already holds the source string
// (`cli.cliStageEntry`), as opposed to the host channel below which has to arrive one
// element at a time. Exactly one of the two is used per compile, which is what lets
// `vcSource` choose between them on `vcCodes.length` alone rather than carrying a flag
// (a flag would be a second thing to keep in step, and `srcReset` clears both).
let vcSrcStr = ""
export function srcReset(): i32 {
  vcCodes = []
  vcSrcStr = ""
  0
}
export function srcPush(c: i32): i32 {
  vcCodes.push(c)
  0
}
// Stage a source string DIRECTLY, with no per-element round trip.
//
// STAGE 2c MADE THE ROUND TRIP WRONG, not merely wasteful. `cli.cliStageEntry` used to run
// `while i < src.length { srcPush(src[i]) }` and `vcSource` rebuilt the string with
// `fromCodePoints` — a byte producer feeding a code-point consumer, so every non-ASCII
// character in the file being compiled was re-encoded into two before the lexer saw it, and
// `'é'` lexed as two characters. That is `str-byte-semantics.md` §Builders' defect sitting
// on the compiler's own entry path, and the fix is the same one the audit prescribes: stop
// naming a unit. A string handed over as a string has no unit to get wrong.
export function srcSetStr(s: string): i32 {
  vcCodes = []
  vcSrcStr = s
  0
}
// ── THE HOST↔SEED ABI STAMP ─────────────────────────────────────────────────
//
// The number a `vl` binary checks before it trusts this seed, compared with `==`
// (a host cannot speak an ABI it was not written for in either direction, and an
// absent export is a mismatch too). A mismatch is an ERROR: the two artifacts do
// not fail loudly when they disagree, they produce WRONG OUTPUT AT A SUCCESSFUL
// EXIT CODE — changing a string's element unit adds, removes and re-types nothing,
// so the negotiation still reports "compatible". It covers the guest→host string
// element unit, the bulk `Load`/`Store` packing, and the `CMD_*` table; bump it in
// the SAME commit that changes any of them. A hand-bumped integer, not a build
// stamp: `compile(source)` must stay a pure function of the source, or the fixpoint
// ladder never finds a self-reproducing rung. `docs/internals/cli-design.md`.
export function hostAbi(): i32 { 2 }

// ── BULK SOURCE INTAKE over linear memory (`docs/internals/perf-program.md` §3.1)
//
// `srcPush` above is ONE HOST CALL PER SOURCE CODE POINT; the batched ABI the host
// probes for (`StrIn`, `scripts/vl-host/src/main.rs`) replaces N calls with N/16384:
// the host writes a chunk of UTF-32LE code points into the exported linear memory at
// byte 0 and calls `<name>Load(count)`, and this loop copies them out. WasmGC has no
// runtime memory→GC-array copy (`memory-gc-design.md` §2 #10), so the per-element
// loop is the ONLY mechanism — what is bought is the CALL boundary, not the element
// move. `__load_i32__`'s mere presence sets `memUsed` and forces the memory section:
// that is how a module that never says `std:buffer` acquires an `ioMem`. No
// `<name>Reserve` exists — VL has no capacity primitive. The staging window
// `ioMem[0 .. 4*count)` is page 0, owned by this protocol; nothing else may claim it.
export function srcLoad(count: i32): i32 {
  let i = 0
  while i < count {
    const cp = __load_i32__(i * 4)
    vcCodes.push(cp)
    i = i + 1
  }
  0
}
export function vcSource(): string {
  if vcCodes.length == 0 { return vcSrcStr }
  fromCodePoints(vcCodes)
}
// Source positions (and owning module) for the `P.diags` entries that carry NO
// token anchor: LEX diagnostics (`Diag.at` is a token index, which a lex diag
// doesn't have) and MODULE-RESOLUTION diagnostics (emitted before any tokens
// load). Keyed by the diagnostic's `P.diags` INDEX (`vcDgIdx`), so tokenless
// and token-anchored entries interleave freely (a multi-module parse aggregates
// both); `diagLine`/`diagCol`/`diagEndCol`/`diagModule` consult this table
// first. Reset per compile.
let vcDgIdx: i32[] = []
let vcDgLine: i32[] = []
let vcDgCol: i32[] = []
// The 0-based EXCLUSIVE end column of the entry's span, on `vcDgLine`. A token
// anchor is where `diagEndCol` normally gets a width, and these entries have
// none — so without this every lex and module-resolution diagnostic rendered as a
// single-column caret however much source it was about. Equal to `vcDgCol` for an
// entry with no span (the point rendering).
let vcDgEnd: i32[] = []
let vcDgMod: i32[] = []
// The module whose source `vcLoadToks` is currently loading — a lex diag's
// owner. The modCompile parse loop sets it per module; 0 elsewhere.
let vcLoadMod = 0
// The side-table slot for `P.diags` index `i`, or -1 (a token-anchored diag).
function vcDgFind(i: i32): i32 {
  let k = 0
  while k < vcDgIdx.length {
    if vcDgIdx[k] == i { return k }
    k = k + 1
  }
  -1
}
// Clear the index-keyed `P.diags` side tables — the tokenless-diag position
// table above (and the module it attributes to), plus the parser's LOSSLESS
// column (ast.vl). ONE home for the six assignments, which seven entry points
// make in lockstep — a table that grew a column and left one of them behind
// would mis-key every later entry, and for the lossless column specifically a
// stale entry claims a PREVIOUS program's diagnostic was lossless, which is the
// direction that lets the checker run when it must not.
function vcDgReset() {
  vcDgIdx = []
  vcDgLine = []
  vcDgCol = []
  vcDgEnd = []
  vcDgMod = []
  vcLoadMod = 0
  dgLosslessReset()
  0
}

// ── The stage-1 lossless-recovery gate ───────────────────────────────────────
// Whether the pipeline must STOP at the parse stage: any parse diagnostic that is not
// a LOSSLESS recovery's. A file whose every parse diagnostic came from the unbraced-body
// recovery (`parseBracedBody`, parser.vl) has an AST that is exactly what the user wrote,
// so its type errors are REAL and worth reporting alongside the parse mistake — the LSP
// compiles per keystroke, and a blanket bail drops ALL type feedback mid-edit.
//
// The quantifier is ALL, not ANY, and that is what makes it safe by construction:
// one lossy recovery anywhere in the file (a skip-to-closer that dropped tokens)
// restores the bail for the whole file. The ANY reading buys phantom type errors
// over fiction the parser invented (DECISIONS.md). EMIT is not gated on this and
// never proceeds past a parse diagnostic: a recovered program CHECKS, not BUILDS.
function vcParseBlocked(): boolean { P.diags.length > 0 && !dgAllLossless() }
// Record one tokenless diagnostic's position, owner and span, keyed on the
// `P.diags` index it is about to occupy. The caller pushes the `P.diags` entry.
function vcDgPush(idx: i32, line: i32, col: i32, endCol: i32, mod: i32) {
  vcDgIdx.push(idx)
  vcDgLine.push(line)
  vcDgCol.push(col)
  vcDgEnd.push(endCol)
  vcDgMod.push(mod)
  0
}

// ── H3 module-table state (globals precede their first textual use; the module
// SUBSYSTEM itself — exports, scan, pipeline, rewrite — lives at the bottom of
// this file) ──────────────────────────────────────────────────────────────────
let modKeys: string[] = [] // resolved module keys, [0] = the entry
let modSrcs: string[] = [] // module sources ("" when missing)
let modFound: i32[] = []   // 1 = read ok, 0 = host could not read the key
let modKeyAcc: i32[] = []  // accumulators for the NEXT commit
let modSrcAcc: i32[] = []
// Flat per-import-entry tables (filled by the token scan at each commit):
let impMod: i32[] = []      // importing module's table index
let impSpec: string[] = []  // the raw specifier text (diagnostics)
let impKey: string[] = []   // resolved key ("" = unsupported specifier)
let impName: string[] = []  // the exported (source) name ("" = bare import)
let impLocal: string[] = [] // the local binding name (after `as`)
// Source positions per import entry (1-based line, 0-based col — the
// diagnostic convention): the imported NAME token (the `import`/`export`
// keyword for a bare import) and the specifier STRING token (the keyword when
// the statement never reaches a string). `modVisit` anchors its resolution
// diagnostics here — a spec-shaped problem (unsupported / unresolvable /
// cycle) at the specifier, a name-shaped one (not exported) at the name.
let impNameLine: i32[] = []
let impNameCol: i32[] = []
let impSpecLine: i32[] = []
let impSpecCol: i32[] = []
// The specifier's EXCLUSIVE end column, so the "unsupported specifier" report can
// underline the whole literal rather than its first character.
let impSpecEnd: i32[] = []
// 1 when a CHAR literal (`'std:fs'`) sat where the specifier belongs. A specifier
// is a STRING, so this is not a resolvable key and never becomes one — it is
// recorded rather than skipped because the SENTENCE the reader needs ("that is a
// char literal") is not the one an empty specifier produces, and only the scan
// knows which happened. `impSpec` then carries the char literal's RAW LEXEME, the
// one thing `importSpecCharMsg` needs to show the spelling that was meant.
let impSpecChar: i32[] = []
// Flat per-module export-name sets (token scan: `export`-modified declarations).
let expMod: i32[] = []
let expName: string[] = []
// RE-EXPORTS (`export { a, b as c } from "spec"`): the PUBLIC name each re-export
// surfaces (`a`/`c`) and the importing module — parallel arrays. The re-export is
// ALSO recorded as an import (so the symbol is pulled + the dependency edge exists);
// these tables additionally drive the emitter to alias the (merged, mangled) target
// function under its bare PUBLIC name in the wasm export section, giving a stable ABI.
let reExpMod: i32[] = []       // the re-exporting module's table index
let reExpPublic: string[] = [] // the public bare name (the `as` alias, else the source name)
let reExpLocal: string[] = []  // the local binding the import created (resolves to the target)
// Filled by `modCompile` once renames are known: the public name → the merged
// (mangled) target function name, consumed by `emitProgram`'s export section.
// `reExpName`/`reExpTarget` are DEFINED on the emitter side (`emit_state`) and
// imported here, so the driver→emitter→driver read does not form an import cycle.
// The export NAME token's source position (1-based line, 0-based col), parallel to
// `expName` — the cross-file go-to-definition target (the exporting module's decl).
let expDeclLine: i32[] = []
let expDeclCol: i32[] = []
// The `export` KEYWORD token's source position, parallel to `expName` — the target
// for the "redundant export keyword" hint (an export imported by no other module).
let expKwLine: i32[] = []
let expKwCol: i32[] = []
// Resolved keys imported by committed modules that are neither committed nor
// marked missing — what the host fetch loop reads next. Recomputed per commit.
let modPending: string[] = []
// DFS state: 0 unvisited, 1 loading (a back-edge is a cycle), 2 done; `modOrder`
// collects table indices dependency-first; `modDiags` the resolution errors.
let modState: i32[] = []
let modOrder: i32[] = []
let modDiags: string[] = []
// Per-module token-load ranges, recorded as each module's tokens append to the
// shared `P.toks` during `modCompile`: `modLoadStart[o]` is the first token index
// of the o-th loaded module, `modLoadMod[o]` its TABLE index. `modOfTok` maps an
// occurrence's token back to its owning module — cross-file find-references.
let modLoadStart: i32[] = []
let modLoadMod: i32[] = []
// Per-module rename map (`name` → `name$mN`) and the lexical shadow stack.
// The map is KEYED BY INTERNED ID — `symbols.vl` R6, the dense-array form of a
// name→row lookup — because it is probed once per identifier over a table large
// enough that a linear scan would be the merge's quadratic term. A reader is one
// `sidLookup` plus one array read.
//
// TWO index arrays because the map's readers disagree about a DUPLICATE key and
// the disagreement is pre-existing: `modRenamed` returns at the FIRST matching
// row, while `modRwTsName` / `modTypeRenamed` keep scanning and so take the LAST.
// Which row wins decides the diagnostic TEXT and which import a reference resolves
// to, so each reader keeps its own view rather than being quietly normalized onto
// the other's.
let modRenameTo: string[] = []
// The `from` keys, parallel to `modRenameTo`. The sid views index BY name and
// cannot be walked back to the spellings, and D1191's per-module UFCS scope is
// exactly a walk of this map: every row whose TARGET is a registered
// `self`-function is a plain name this module binds to one.
let modRenameFrom: string[] = []
let modRenameFirstBySid: i32[] = []
let modRenameLastBySid: i32[] = []
let modShadow: string[] = []
// Registry of every top-level free `self`-function across all modules, keyed by its
// MANGLED name (`shout$m1`) with its parameter arity. A UFCS call `"x".shout()` is a
// `Call` whose callee is a `Member` (`memProp == shout`), and the merge cannot rewrite
// `memProp` — a same-named struct field must keep precedence, decided by the receiver
// TYPE the walker lacks. So it records a plain→mangled `ufcsAlias` for every site whose
// `prop` resolves through this registry to a self-function of matching arity; the
// checker/emitter follow the alias AFTER the field check.
//
// TWO arities per row, because a parameter DEFAULT makes a call's arity a RANGE
// (D1044): `modSelfFnArity` is the declared count, `modSelfFnMinArity` is
// `fnRequiredArity` over the same list — the range `ufcsCallTy` and `drwSelfFnOf`
// already accept. One exact count admits no alias row for a defaulted call.
let modSelfFnName: string[] = []
let modSelfFnArity: i32[] = []
let modSelfFnMinArity: i32[] = []
// Generic type-parameter names live inside the rewrite of their declaration
// (`T` while inside `id<T>`'s annotations/body or `Box<T>`'s definition): a
// segment matching one must NOT rewrite through the rename map — it names the
// parameter, not a top-level binding.
let modTyShadow: string[] = []
// D1571 — the merged targets of `type` declarations that TOOK A BUILTIN TYPE NAME, and the
// only rows allowed to rewrite such a name in TYPE position (`modTypeRenamed`).
// THE RENAME MAP IS ONE NAMESPACE AND THE LANGUAGE IS TWO. A `type Circle` and a
// `function Circle` coexist — in one file and across an import — and they are harmless to
// each other here because both mint the same `Circle$mN` target. A BUILTIN name has no
// declaration and therefore no row of its own, so the VALUE row was the only one and
// `import { u8 } from "./lib"` rewrote every `u8[]` in the importer to `u8$m1[]`:
// `unknown type 'u8' within 'u8[]'`, on an annotation naming the primitive (glean VL-015).
// Filled dependency-first by `modBuildRename`, so an importer's map is built with its deps'
// rows already registered; almost always EMPTY, which is what makes the test free.
let modBuiltinTyTargets: string[] = []
// ── per-INSTANCE module scan/token cache ──────────────────────────────────────
// A directory check (`vl check <dir>`) rebuilds the module table once PER FILE
// (modReset + the fetch loop), so a shared dependency is token-scanned
// (modCommit → modScan) once per dependent. Cache per (module key, source text):
// the scan's import/export entries replay under the new table index, and its token
// stream re-pushes with fresh global `pos` anchors — so the parse stage
// (modCompile → vcLoadToksMod) replays rather than tokenizing, and ONE tokenization
// serves both stages for every module of every build, single-file included. Slices
// are FLATTENED into shared arrays with per-slot [off, end) ranges (`string[][]` is
// not self-host-emittable). The cache spans modReset by design; a slot is keyed on
// the exact source, so a rewrite (e.g. `check --fix`) misses and a fresh slot is
// appended.
const modCacheKeys: string[] = []
const modCacheSrcs: string[] = []
const modCacheImpOff: i32[] = []
const modCacheImpEnd: i32[] = []
const modCacheReOff: i32[] = []
const modCacheReEnd: i32[] = []
const modCacheExpOff: i32[] = []
const modCacheExpEnd: i32[] = []
// Token slice (-1 = not captured); only a CLEAN tokenization (no lex diags) is
// cached, so a hit never has diags to re-fold.
const modCacheTokOff: i32[] = []
const modCacheTokEnd: i32[] = []
// The token range `modScan` just banked into the flat storage, handed to
// `modScanCached` for the slot it appends. `modScan` is called from exactly one
// place and its result is recorded immediately, so a scalar pair carries it
// without threading a return type through the scan.
let modScanTokOff = -1
let modScanTokEnd = -1
// Flat storage backing the slices above.
const modCacheImpSpec: string[] = []
const modCacheImpKey: string[] = []
const modCacheImpName: string[] = []
const modCacheImpLocal: string[] = []
const modCacheImpNameLine: i32[] = []
const modCacheImpNameCol: i32[] = []
const modCacheImpSpecLine: i32[] = []
const modCacheImpSpecCol: i32[] = []
const modCacheImpSpecEnd: i32[] = []
const modCacheImpSpecChar: i32[] = []
const modCacheRePublic: string[] = []
const modCacheReLocal: string[] = []
const modCacheExpName: string[] = []
const modCacheExpDeclLine: i32[] = []
const modCacheExpDeclCol: i32[] = []
const modCacheExpKwLine: i32[] = []
const modCacheExpKwCol: i32[] = []
const modCacheTokKind: TokKind[] = []
const modCacheTokText: string[] = []
const modCacheTokStart: i32[] = []
const modCacheTokLine: i32[] = []
const modCacheTokCol: i32[] = []
// The cache slot for (key, src), or -1. Duplicate keys may exist (a source
// rewritten mid-run appends a new slot); the src must match exactly.
function modCacheLookup(key: string, src: string): i32 {
  let i = 0
  while i < modCacheKeys.length {
    if modCacheKeys[i] == key && modCacheSrcs[i] == src { return i }
    i = i + 1
  }
  -1
}

function vcLoadToks(src: string): i32 {
  const r = tokenize(src)
  let i = 0
  while i < r.tokens.length {
    const t = r.tokens[i]
    // `pos` is the GLOBAL P.toks index (single-source: identical to the per-call
    // index; module mode APPENDS each module's tokens, so anchors stay correct).
    P.toks.push(
      {
        kind: t.kind,
        text: t.text,
        pos: P.toks.length,
        start: t.start,
        line: t.line,
        col: t.col,
      },
    )
    i = i + 1
  }
  // Fold the lexer's diagnostics into the parse-stage store so a LEX error (e.g.
  // an empty `''` or multi-char `'ab'` char literal) is rejected at the parse
  // stage. Mirrors the host's `checkOnly`, which seeds its diagnostics list from
  // `tokenize(...).diagnostics` BEFORE appending parse errors. A lex diag has no
  // token to anchor at (at: -1); its REAL source position (and owning module)
  // rides in the index-keyed `vcDg*` side table.
  let d = 0
  while d < r.diags.length {
    vcDgPush(
      P.diags.length,
      r.diags[d].line,
      r.diags[d].col,
      r.diags[d].endCol,
      vcLoadMod,
    )
    P.diags.push({ msg: r.diags[d].msg, at: -1 })
    d = d + 1
  }
  P.toks.length
}
// ── DEEP `is` OVER A `Json` VALUE — the SECOND CHECK PASS (D1035) ────────────
//
// `r is T` for a JSON-SHAPE `T` that is not one of the union's arms is a runtime
// SHAPE WALK (`docs/serde-design.md` §"Deep `is` / `as` over a `Json` value").
// The checker cannot lower one, so pass 1 only RECORDS which sites are that and
// what they walk; this runs after it, generates one predicate + one builder per
// distinct target as ordinary VL SOURCE, parses that fragment into the SAME arena,
// appends its declarations to the program root, rewrites each site into a call, and
// re-checks. A program with no deep `is` has an empty `jwSiteNode` and returns on
// the first line, so it pays neither the second parse nor the second check.
// THE REWRITE REFUSING IS A HARD STOP: a deep `is` the rewrite cannot route would
// reach the emitter as a bare arm test and answer `false` for every value (D1035).
function jwSecondPass(root: i32): i32 {
  if jwSiteNode.length == 0 { return 0 }
  const gen = jwGenerateSource()
  if gen == "" { return 0 }
  // The fragment is tokenized ONTO the existing stream (the module pipeline's
  // own move) and parsed with `P.pos` at its first token, so every node the user
  // wrote keeps its arena index and the recorded sites stay valid.
  P.pos = P.toks.length
  const jwGenTok = P.toks.length
  vcLoadToks(gen)
  jwRestoreMangling(jwGenTok)
  const frag = parseProgram()
  if vcParseBlocked() { return 1 }
  if !jwSplice(root, frag) {
    vcDgPush(P.diags.length, 1, 0, 0, 0)
    P.diags.push(
      { msg: "internal: deep `is` walkers could not be spliced", at: -1 },
    )
    return 1
  }
  // A refusal is already a positioned TYPE error on the offending `is` site; rc 2 is the
  // type-error rung, exactly as pass 1's own diagnostics take.
  if jwRewriteAll() > 0 { return 2 }
  initChecker()
  // AFTER the reset, not before: `initChecker` clears the walker worklist and this marker
  // with it. The style tier must not report a finding about code the author never wrote,
  // and the marker is the first generated token (`jwTokIsGenerated` reads it).
  jwSetGenTokStart(jwGenTok)
  checkProgram(root)
  0
}

// 0 = ok; 1 = lex/parse error; 2 = type error; 3 = emit error.
export function compileSrc(): i32 {
  symSetEnabled(0)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  W.bytes = []
  emitErr = ""
  fnNames = []
  fnIndices = []
  localNames = []
  globalStmts = []
  globalNames = []
  initChecker()
  // Module mode (H3): a non-empty module table runs the multi-file pipeline
  // (order/validate → parse-merge → rename/rewrite → check/emit). With an EMPTY
  // table (every existing consumer) the single-source path below is untouched.
  if modKeys.length > 0 { return modCompile(1) }
  vcLoadToks(vcSource())
  const root = parseProgram()
  if vcParseBlocked() { return 1 }
  csPreMintLocs()
  checkProgram(root)
  // EMIT NEVER PROCEEDS PAST A PARSE DIAGNOSTIC, lossless or not. A recovered
  // file's diagnostics are still ERRORS — `vl build`/`vl run` keep rc 1 and the
  // same parse message; the only difference is that the type errors the checker
  // just found are now reported with it instead of hidden behind it.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  const jwRc = jwSecondPass(root)
  if jwRc != 0 { return jwRc }
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  // A single-source program's wasm ABI is its `export`-marked functions, staged
  // through the same alias tables a module build fills (public name → target;
  // unmangled here — no merge). Reset first: a PRIOR module compile on this
  // instance left its aliases behind. The emitter exports only these entries.
  reExpName = []
  reExpTarget = []
  let xt = 0
  while xt + 2 < P.toks.length {
    if (
      P.toks[xt].kind == "EXPORT" &&
      P.toks[xt + 1].kind == "FUNCTION" &&
      P.toks[xt + 2].kind == "IDENT" &&
      !capHas(reExpName, P.toks[xt + 2].text)
    ) {
      reExpName.push(P.toks[xt + 2].text)
      reExpTarget.push(P.toks[xt + 2].text)
    }
    xt = xt + 1
  }
  const rc = emitProgram(root)
  if rc < 0 { return 3 }
  0
}
export function rbyteLen(): i32 { W.bytes.length }
export function rbyteAt(i: i32): i32 { W.bytes[i] }
// ── BULK RESULT READ-BACK over linear memory — the OUT mirror of `srcLoad`
// (`docs/internals/perf-program.md` §7) ───────────────────────────────────────
// `rbyteAt` above is ONE HOST CALL PER EMITTED BYTE. This is `srcLoad`'s trade in the
// other direction — the GUEST writes the staging window, the host copies out — so
// protocol, window and fallback are deliberately identical; read `srcLoad`'s header
// first. `rbyteStore(off, count)` writes min(count, rbyteLen() - off) bytes from
// `W.bytes[off]` PACKED FOUR PER i32 WORD (little-endian), so the host's copy is a
// `memcpy` and not a strided gather. A return of 0 or more than `count` is a protocol
// violation the host FAILS on rather than re-requesting: a re-request loop is a hang,
// and a hang breaks every comparator. The tail word starts at most at `cap - 4`, so
// its padding lands INSIDE the window; `W.bytes` is masked to 0..255 at its one
// append site (`emit_bytes.vl`).
export function rbyteStore(off: i32, count: i32): i32 {
  const bs = W.bytes
  const avail = bs.length - off
  let n = count
  if n > avail { n = avail }
  if n < 0 { n = 0 }
  let i = 0
  while i + 4 <= n {
    const b0 = bs[off + i]
    const b1 = bs[off + i + 1]
    const b2 = bs[off + i + 2]
    const b3 = bs[off + i + 3]
    __store_i32__(i, b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))
    i = i + 4
  }
  if i < n {
    let w = 0
    let k = n - 1
    while k >= i {
      w = (w << 8) | bs[off + k]
      k = k - 1
    }
    __store_i32__(i, w)
  }
  n
}
// `vl check`: parse + typecheck ONLY, no emit. 0 = ok; 1 = lex/parse; 2 = type.
// Emit is `vl build`'s job — skipping it makes `check` markedly faster on large
// inputs AND avoids rejecting a type-VALID program the emitter can't yet lower (an
// emit-coverage gap is not a check failure). Shares the diagnostic stores
// (`diagLen`/`diagAt`) with compileSrc.
export function checkSrc(): i32 {
  symSetEnabled(0)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  fnNames = []
  fnIndices = []
  localNames = []
  globalStmts = []
  globalNames = []
  // `check` never emits, so clear the emit-stage ABI a prior `compileSrc` on
  // this instance populated: stale `W.bytes` would read back through
  // `rbyteLen`/`rbyteAt`, and a stale `emitErr` would append a phantom emit
  // diagnostic to THIS check's `diagCount`/`vcDiags` stream.
  W.bytes = []
  emitErr = ""
  initChecker()
  // Module mode (H3) — see compileSrc; `check` runs the same pipeline minus emit.
  if modKeys.length > 0 { return modCompile(0) }
  vcLoadToks(vcSource())
  const root = parseProgram()
  if vcParseBlocked() { return 1 }
  csPreMintLocs()
  checkProgram(root)
  // A lossless-recovered file reports BOTH streams and keeps rc 1 — the parse
  // mistake is still the headline error, the type errors ride with it.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  // `check` runs the deep-`is` second pass too: a site the rewrite cannot route
  // is a hard error, and `vl check` must not say yes to a program `vl build`
  // then refuses.
  const jwRc = jwSecondPass(root)
  if jwRc != 0 { return jwRc }
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  0
}

// ── Lint tier (LSP-on-wasm Stage 3) ───────────────────────────────────────────
// Run the AST-derivable lint pass (compiler/lint.vl) over the current source and
// expose its diagnostics, so the corpus oracle (cases_wasm_test) can adjudicate
// `@warning`/`@info`/`@hint` cases on the self-hosted compiler too. Lint runs on
// the PARSE alone (no typecheck — matching the standalone lint harness). Returns
// the lint diagnostic count, or -1 on a lex/parse error (lint needs a valid AST).
// The host reads each diagnostic via `lintCount()` + `lintSevLen`/`lintSevByte`,
// `lintMsgLen`/`lintMsgByte` (per code point, like the diag stream), and the
// positions via lint.vl's own `lintLineAt`/`lintColAt` (1-based line, 0-based col).
export function lintSrc(): i32 {
  symSetEnabled(0)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  vcLoadToks(vcSource())
  const root = parseProgram()
  // A LOSSLESS-recovered AST is the one the user wrote, so lint's findings over
  // it are as real as any other file's; only a lossy parse still returns -1. The
  // parse diagnostics themselves are NOT lost — every caller (the CLI's
  // `cliCheckCurFileRest`, the LSP's separate `check`) reads them from the error
  // stream before or beside this call.
  if vcParseBlocked() { return -1 }
  // Comments never reach the arena; the comment-budget rules read the text.
  lintSetSource(vcSource())
  lint(root)
  lintCount()
}

export function lintSevLen(i: i32): i32 { lintSevAt(i).length }
export function lintSevByte(i: i32, j: i32): i32 { lintSevAt(i)[j] }
export function lintMsgLen(i: i32): i32 { lintMsgAt(i).length }
export function lintMsgByte(i: i32, j: i32): i32 { lintMsgAt(i)[j] }
// The stable rule `code` (e.g. "unused-variable", "prefer-const") drives the LSP
// quick-fixes, and the 1-based line / 0-based col place the squiggle.
export function lintCodeLen(i: i32): i32 { lintCodeAt(i).length }
export function lintCodeByte(i: i32, j: i32): i32 { lintCodeAt(i)[j] }
export function lintLine(i: i32): i32 { lintLineAt(i) }
export function lintCol(i: i32): i32 { lintColAt(i) }

// ── Module-graph lint (per-module, with file attribution) ─────────────────────
// Run the lint pass over EVERY resolved module of the committed graph — not just
// the entry — so an unused local in an imported file (or an unused import in the
// importer) is reported against THAT file. Each module is re-parsed IN ISOLATION
// (its own arena — the merged/renamed program would leak `name$mN` mangles into
// messages and break the token-scan `export` detection), linted, and its findings
// copied into the accumulators below with the owning module's TABLE index. A module
// that fails to parse is skipped (the error tier already reported it); a missing
// module (`modFound` 0) likewise. With an EMPTY module table this lints `vcSource()`
// as module 0, byte-compatible with `lintSrc`, so callers can use it unconditionally.
// Returns the total finding count. Like `lintSrc` it resets `P.toks`/`nodeToks`, so
// error-tier anchors (`diagModule`) must be read BEFORE calling.
let lgCodes: string[] = []
let lgMsgs: string[] = []
let lgSevs: string[] = []
let lgLines: i32[] = []
let lgCols: i32[] = []
let lgMods: i32[] = []

// Copy the lint sink (one module's `lint(root)` run) into the graph accumulators
// under module index `m`.
function lgCopySink(m: i32): i32 {
  let i = 0
  while i < lintCount() {
    lgCodes.push(lintCodeAt(i))
    lgMsgs.push(lintMsgAt(i))
    lgSevs.push(lintSevAt(i))
    lgLines.push(lintLineAt(i))
    lgCols.push(lintColAt(i))
    lgMods.push(m)
    i = i + 1
  }
  0
}

export function lintGraph(): i32 {
  lgCodes = []
  lgMsgs = []
  lgSevs = []
  lgLines = []
  lgCols = []
  lgMods = []
  if modKeys.length == 0 {
    // No graph: the single-source path (module 0 = the entry, like `lintSrc`).
    if lintSrc() < 0 { return 0 }
    lgCopySink(0)
    return lgCodes.length
  }
  symSetEnabled(0)
  let m = 0
  while m < modKeys.length {
    if modFound[m] != 0 {
      P.toks = []
      P.nodes = []
      // THE SHARPEST EDGE THE CARRIER HAS. This loop re-parses each module into a
      // FRESH arena, so index 5 is a different identifier every iteration; without
      // this reset `sidOfNode(5)` would answer with the PREVIOUS module's name.
      sidReset()
      sidKeyedTablesReset()
      P.diags = []
      vcDiagMemoReset()
      P.pos = 0
      nodeToks = []
      tsReset()
      declNameTok = []
      tplHole = []
      vcDgReset()
      vcLoadToksMod(m)
      const root = parseProgram()
      // Same rule as `lintSrc`: a clean parse OR an all-lossless recovery.
      if !vcParseBlocked() {
        lintSetSource(modSrcs[m])
        lintSetPath(modKeys[m])
        lint(root)
        lgCopySink(m)
      }
    }
    m = m + 1
  }
  lgCodes.length
}

// Per-finding accessors (the `lint*` idiom, plus the owning module's index).
export function lintGraphCount(): i32 { lgCodes.length }
export function lintGraphModule(i: i32): i32 { lgMods[i] }
export function lintGraphLine(i: i32): i32 { lgLines[i] }
export function lintGraphCol(i: i32): i32 { lgCols[i] }
export function lintGraphSevLen(i: i32): i32 { lgSevs[i].length }
export function lintGraphSevByte(i: i32, j: i32): i32 { lgSevs[i][j] }
export function lintGraphMsgLen(i: i32): i32 { lgMsgs[i].length }
export function lintGraphMsgByte(i: i32, j: i32): i32 { lgMsgs[i][j] }
export function lintGraphCodeLen(i: i32): i32 { lgCodes[i].length }
export function lintGraphCodeByte(i: i32, j: i32): i32 { lgCodes[i][j] }
// String reads for same-assembly consumers (the CLI): the code/sev/msg values.
export function lintGraphCodeAt(i: i32): string { lgCodes[i] }
export function lintGraphSevAt(i: i32): string { lgSevs[i] }
export function lintGraphMsgAt(i: i32): string { lgMsgs[i] }

// ── Format tier (kill-TS step 1) ──────────────────────────────────────────────
// Run the AST-driven formatter (compiler/format.vl) over the current source and
// expose its canonical-form output as a string, so the native `vl fmt` and the
// deno harness can reformat VL. Lexes (capturing the retained `//`/`///` comments
// the formatter places), parses, formats, and RE-PARSES the output (the
// round-trip safety gate). Returns the formatted string length; -1 when the
// INPUT does not lex/parse (the formatter needs a valid AST; its diagnostics
// stay readable via `diagCount`/`vcDiagMsg`/…); -2 when the OUTPUT does not
// re-parse — a formatter bug, so callers must keep the input bytes and report.
// The host then reads the bytes via `fmtByteAt(j)` (one UTF-32 code point per
// call, like the other string accessors), 0 ≤ j < the returned length.
export let vcFmtOut = ""
export function formatSrc(): i32 {
  symSetEnabled(0)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  const src = vcSource()
  // Lex once, feeding tokens into the parser AND the formatter's comment table
  // (the formatter slices spans from `src` and places comments around them).
  fmtSetSource(src)
  fmtResetComments()
  const r = tokenize(src)
  let i = 0
  while i < r.tokens.length {
    const t = r.tokens[i]
    P.toks.push(
      {
        kind: t.kind,
        text: t.text,
        pos: P.toks.length,
        start: t.start,
        line: t.line,
        col: t.col,
      },
    )
    i = i + 1
  }
  let d = 0
  while d < r.diags.length {
    // Keep the lex diag's real position and span (`diagLine`/`diagCol`/
    // `diagEndCol` read the vcDg* side table), so a caller can point at the
    // offending source.
    vcDgPush(
      P.diags.length,
      r.diags[d].line,
      r.diags[d].col,
      r.diags[d].endCol,
      0,
    )
    P.diags.push({ msg: r.diags[d].msg, at: -1 })
    d = d + 1
  }
  let c = 0
  while c < r.comments.length {
    const cm = r.comments[c]
    let tr = 0
    if cm.trailing { tr = 1 }
    fmtAddComment(cm.text, cm.start, cm.line, tr)
    c = c + 1
  }
  if P.diags.length > 0 { return -1 }
  const root = parseProgram()
  // NOT `vcParseBlocked` — the formatter is the one consumer that must keep the
  // ANY reading. A lossless recovery preserves the program's MEANING, which is
  // all the checker needs; the formatter WRITES ITS OUTPUT BACK OVER THE FILE
  // (`vl fmt -w`), so printing the recovered AST would silently re-spell the
  // user's mistake as the braced form and erase the diagnostic with it.
  if P.diags.length > 0 { return -1 }
  vcFmtOut = formatProgram(root)
  // ── round-trip safety gate ────────────────────────────────────────────────
  // Re-lex + re-parse the OUTPUT before handing it back: a printer bug that emits
  // unparseable text must surface as a loud diagnostic (-2, callers keep the input
  // bytes), never as data loss through `fmt -w`. The gate costs one extra lex+parse
  // of the formatted text — no re-format, no typecheck. An output equal to the input
  // needs no gate (the input just parsed), which keeps every file of a green
  // `fmt --check` run at zero extra cost — and that matters under the non-freeing GC,
  // where a re-lex per file in a directory run accumulates for the whole process life.
  if vcFmtOut == src { return vcFmtOut.length }
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  vcLoadToks(vcFmtOut)
  if P.diags.length == 0 { parseProgram() }
  if P.diags.length > 0 { return -2 }
  vcFmtOut.length
}
export function fmtLen(): i32 { vcFmtOut.length }
export function fmtByteAt(j: i32): i32 { vcFmtOut[j] }

// ── LSP symbol query (Stage 2): a SYMBOL-AWARE check ──────────────────────────
// Identical to `checkSrc` but with the symbol table turned ON, so the checker
// records the occurrence + binding-type tables the query exports below read.
// Used ONLY by the LSP's go-to-def / find-refs / hover path; every other consumer
// calls `checkSrc`/`compileSrc`, which force the table OFF (zero cost, and emit is
// unaffected — the tables never feed the emitter). The codes match `checkSrc`
// (0 ok, 1 lex/parse, 2 type); the symbol tables are populated for a 0 OR 2 result
// (a type error still yields partial occurrences), and stay valid until the next
// check. Module mode rides the same `modCompile` path.
export function checkSrcSym(): i32 {
  symSetEnabled(1)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  fnNames = []
  fnIndices = []
  localNames = []
  globalStmts = []
  globalNames = []
  // Clear the emit-stage ABI — see checkSrc (a symbol-aware check never emits).
  W.bytes = []
  emitErr = ""
  initChecker()
  if modKeys.length > 0 {
    const mrc = modCompile(0)
    return mrc
  }
  vcLoadToks(vcSource())
  const root = parseProgram()
  if vcParseBlocked() { return 1 }
  csPreMintLocs()
  checkProgram(root)
  // Lossless recovery: the symbol tables ARE populated for the rc-1 result too,
  // so hover / go-to-def / find-refs keep answering across a missing brace.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  0
}

// The occurrence table (parallel to the host's `SymbolOccurrence[]`). After a
// `checkSrcSym`, the host reads `symCount()` occurrences; for each, its source
// span via `symSpanStartLine/Col` + `symSpanEndLine/Col` (1-based line, 0-based
// col — the diagnostic convention), `symIsDecl(i)` (1 = the binding's declaration,
// 0 = a use), and `symBindingId(i)` (the declaring node index — the stable
// binding identity two occurrences share iff they refer to the same binding).
export function symCount(): i32 { symOccCount() }
export function symSpanStartLine(i: i32): i32 { symOccStartLine(i) }
export function symSpanStartCol(i: i32): i32 { symOccStartCol(i) }
export function symSpanEndLine(i: i32): i32 { symOccEndLine(i) }
export function symSpanEndCol(i: i32): i32 { symOccEndCol(i) }
export function symIsDecl(i: i32): i32 { symOccIsDeclAt(i) }
export function symBindingId(i: i32): i32 { symOccBinding(i) }

// Cross-file find-references: the MODULE (table index) occurrence `i` belongs to.
// A module's tokens occupy a contiguous range of the merged `P.toks` (recorded as
// `modLoadStart`/`modLoadMod` during `modCompile`); map the occurrence's anchor
// token into that range. Single-file mode (no module load) → 0. Lets the host
// attribute each occurrence to its source file and collect refs across the graph.
export function modOfTok(tok: i32): i32 {
  let best = 0
  let o = 0
  while o < modLoadStart.length {
    if modLoadStart[o] <= tok { best = modLoadMod[o] }
    o = o + 1
  }
  best
}
// ── `__callsite__`: mint one location value per CALL, before the checker runs ─
//
// Parameter defaults are CALL-SITE SUGAR — the declaration's expression is substituted
// into each call that omits the argument — and every form but `__callsite__` means the
// same thing at every site, so every other form shares one node. Its value IS the site.
//
// A PRE-PASS, NOT A REWRITE: `nodeTyIx` is sized to the arena at `checkProgram` entry,
// so a node minted later reads its type back as -1 forever (D969, and the reason
// `parseTemplate` desugars in the PARSER); these are minted BEFORE that sizing, and
// the checker splices the banked node into the omitted slot (`fillArgDefaults`).
// USAGE-GATED: a program declaring no `__callsite__` default mints and banks nothing,
// so the arena — and every byte the emitter writes — is identical to before this pass.
function csAnyCallsiteDefault(): boolean {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is Param {
      if paramDefaultIsCallsite(n.parDefault) { return true }
    }
    i = i + 1
  }
  false
}

// `s` as a STRING-LITERAL LEXEME — quotes kept, `"` and `\` escaped. `StrLit`
// carries the RAW lexeme (`wasmEmit`'s `decodeStr` resolves the escapes), so a
// synthesized literal has to be built in that same currency.
function csStrLexeme(s: string): string {
  const buf: i32[] = []
  buf.push(34)
  for cp in s {
    if cp == 34 || cp == 92 { buf.push(92) }
    buf.push(cp)
  }
  buf.push(34)
  fromCodePoints(buf)
}

// The module KEY owning the token at `tok` — the merged program's name for the
// file. A single-source compile has no module table and answers "", which is the
// honest reading: nothing in that pipeline knows the entry's path (the CLI
// prints one it holds host-side, and never tells the compiler).
function csFileOfTok(tok: i32): string {
  if modKeys.length == 0 { return "" }
  const m = modOfTok(tok)
  if m < 0 || m >= modKeys.length { return "" }
  modKeys[m]
}

export function csPreMintLocs(): i32 {
  paramDefaultTablesReset()
  if !csAnyCallsiteDefault() { return 0 }
  // Snapshot the length FIRST — minting appends, and the nodes appended are not
  // themselves calls.
  const n0 = P.nodes.length
  let i = 0
  while i < n0 {
    const n = P.nodes[i]
    if n is Call {
      let ln = 0
      let co = 0
      let file = ""
      // THE CALLEE'S OWN ANCHOR TOKEN — `where` in `where(1)`, `f` in `x.f(1)`
      // — which is what a reader means by "the call site" and what Swift's
      // `#line` / Rust's `Location::caller()` report for the same call.
      //
      // NOT `tokIndexAt(n.pos)`, and the reason is worth recording: that binary
      // search assumes `P.toks[i].start` ascends, and in MODULE mode the merged
      // stream APPENDS each module's tokens with that module's own offsets, so
      // `start` restarts at every module boundary and the search silently
      // misses. Measured — every call in a module build fell to the fallback.
      // `nodeToks` is a per-node index into the merged stream and has no such
      // assumption.
      let tk = -1
      if n.callFn >= 0 && n.callFn < nodeToks.length { tk = nodeToks[n.callFn] }
      if tk < 0 {
        if i < nodeToks.length { tk = nodeToks[i] }
      }
      if tk >= 0 && tk < P.toks.length {
        ln = P.toks[tk].line
        co = P.toks[tk].col + 1
        file = csFileOfTok(tk)
      }
      const fields: i32[] = []
      fields.push(mkFieldInit("file", mkStr(csStrLexeme(file), -1), -1))
      fields.push(mkFieldInit("line", mkNum(i32ToStr(ln), -1), -1))
      fields.push(mkFieldInit("col", mkNum(i32ToStr(co), -1), -1))
      // The `ObjLit` keeps the CALL's position so a type error on this argument
      // points at the call the author wrote, not at nowhere.
      setCallSiteLoc(i, mkObjLit(fields, n.pos))
    }
    i = i + 1
  }
  0
}

export function symOccModuleAt(i: i32): i32 {
  const tok = symOccTokAt(i)
  if tok < 0 { return 0 }
  modOfTok(tok)
}

// Semantic tokens (Stage 2): after a `checkSrcSym`, the recorded occurrences ARE
// the classified identifiers, so `tokCount` is just `symCount` and a token's span
// reads via the same `symSpan*` accessors. The ONE addition is each token's
// CLASSIFICATION — `tokBindKindAt(i)` (0=local 1=param 2=function, -1 otherwise),
// the binding kind a lexer can't see. This slice classifies identifiers only;
// the host keeps its lexical pass for keywords/operators/literals/comments and
// its member walk for properties/methods (neither is recorded here). Declaration
// vs use comes from `symIsDecl(i)`; the span from `symSpan*`.
export function tokCount(): i32 { symOccCount() }
export function tokBindKindAt(i: i32): i32 { symOccKindAt(i) }
export function tokSpanStartLine(i: i32): i32 { symOccStartLine(i) }
export function tokSpanStartCol(i: i32): i32 { symOccStartCol(i) }
export function tokSpanEndCol(i: i32): i32 { symOccEndCol(i) }

// Go-to-definition: the occurrence index of the DECLARATION for the binding whose
// occurrence covers (line, col), or -1 when the cursor is off any tracked name.
// Read its span via the `symSpan*` accessors.
export function defAt(line: i32, col: i32): i32 { symDefAt(line, col) }

// Find-references: the count of occurrences (declaration + uses) of the binding
// at (line, col), and the k-th such occurrence INDEX (its span via `symSpan*`).
export function refsCountAt(line: i32, col: i32): i32 {
  symRefsCountAt(line, col)
}
export function refAt(line: i32, col: i32, k: i32): i32 {
  symRefAt(line, col, k)
}

// Hover-types: the rendered type string of the binding at (line, col), exposed
// per-codepoint via a result buffer the host fills then reads (mirrors the
// `rbyte*` idiom). `typeStrAt` computes the string and returns its length;
// `typeStrCharAt(j)` reads code point `j` of that last-computed string. A cursor
// off any tracked binding yields a zero-length string.
let symTyBuf: string = ""
export function typeStrAt(line: i32, col: i32): i32 {
  symTyBuf = symTypeStrAt(line, col)
  symTyBuf.length
}
export function typeStrLen(): i32 { symTyBuf.length }
export function typeStrCharAt(j: i32): i32 { symTyBuf[j] }

// Type-alias hover: the rendered type of the user `type` NAME (struct/union alias)
// under (line, col) — its decl name or a use in an annotation — exposed
// per-codepoint like `typeStrAt`. "" when the cursor is off a known user type.
let typeAliasBuf: string = ""
export function typeAliasAt(line: i32, col: i32): i32 {
  typeAliasBuf = symTypeAliasAt(line, col)
  typeAliasBuf.length
}
export function typeAliasCharAt(j: i32): i32 { typeAliasBuf[j] }

// Inlay hints (LSP): after a `checkSrcSym`, the inferred type at each UNANNOTATED
// declaration — `inlayScan` records the set, the per-index accessors read each
// hint's KIND (0 = value binding → its type; 1 = function → its RETURN type),
// the NAME-end position (1-based line, 0-based col — the host walks to the `)`
// for a function and applies its own annotation/range filters), and the rendered
// type label (per-codepoint). The native `deriveInlayHints`.
export function inlayScan(): i32 { symInlayScan() }
export function inlayCount(): i32 { symInlayCount() }
export function inlayKindAt(i: i32): i32 { symInlayKindAt(i) }
export function inlayLineAt(i: i32): i32 { symInlayLineAt(i) }
export function inlayColAt(i: i32): i32 { symInlayColAt(i) }
export function inlayTypeLen(i: i32): i32 { symInlayTypeLen(i) }
export function inlayTypeCharAt(i: i32, j: i32): i32 {
  symInlayTypeCharAt(i, j)
}
// The MODULE (table index) hint `i` belongs to — its occurrence's module (0 =
// the entry). A whole-program compile records a hint for every module's
// unannotated decls, each with module-local line/col; the host keeps only the
// entry's (module 0) so a dependency's hints don't render against the importer
// (`./mathx`'s function-return hints bleeding onto the `import` line). Mirrors
// `symOccModuleAt` for the semantic-token slice.
export function inlayModuleAt(i: i32): i32 { symOccModuleAt(symInlayOccAt(i)) }

// The module a redundant-type finding belongs to (its name token's owner). Lets
// the cli keep only the ENTRY module's (== 0) findings in a multi-module compile,
// where every module's AST is merged. Single-file mode has no module table, so
// `modOfTok` returns 0 throughout (nothing filtered). Mirrors `inlayModuleAt`.
export function redunModuleAt(i: i32): i32 { modOfTok(redunTokAt(i)) }

// The redundant-annotation finding's message, per code point — the same byte ABI
// the `lintMsg*`/`diagMsg*` streams use, so a host reading diagnostics reads all
// three the same way. Without it this stream is INVISIBLE to any host that is not
// the CLI: the finding is type-informed (populated by `checkSrc`/`compileSrc`),
// so it never appears in the parse-only `lintSrc` stream, and the corpus oracle —
// which adjudicates lint expectations off `lintSrc` alone — could not see it.
// `redunMsgAt` BUILDS the string, so each accessor rebuilds it. Deliberately NOT
// memoized on the index: the finding stream is rebuilt by every check, and an
// index-keyed cache serves the PREVIOUS program's message for the same index —
// silently, as plausible text about the wrong binding.
export function redunMsgLen(i: i32): i32 { redunMsgAt(i).length }
export function redunMsgByte(i: i32, j: i32): i32 { redunMsgAt(i)[j] }

// The dead-`??`-default stream's module + message ABI, the exact twin of the
// redundant-annotation pair above and for the same reason: the finding is
// type-informed, so it never appears in the parse-only `lintSrc` stream and would
// otherwise be visible to the CLI alone.
export function rcoalModuleAt(i: i32): i32 { modOfTok(rcoalTokAt(i)) }
export function rcoalMsgLen(i: i32): i32 { rcoalMsgAt(i).length }
export function rcoalMsgByte(i: i32, j: i32): i32 { rcoalMsgAt(i)[j] }

// The collapsed-operand `is` stream's module + message ABI — the same twin again,
// for the same reason (type-informed, so invisible to `lintSrc`).
export function isvalModuleAt(i: i32): i32 { modOfTok(isvalTokAt(i)) }
export function isvalMsgLen(i: i32): i32 { isvalMsgAt(i).length }
export function isvalMsgByte(i: i32, j: i32): i32 { isvalMsgAt(i)[j] }

// Member hover: the rendered type string of the member access whose PROPERTY NAME
// is at (line, col) — `o.x` / `o?.y` — exposed per-codepoint like `typeStrAt`. A
// cursor off any recorded member access yields a zero-length string.
let memTyBuf: string = ""
export function memberTypeStrAt(line: i32, col: i32): i32 {
  memTyBuf = symMemTypeStrAt(line, col)
  memTyBuf.length
}
export function memberTypeStrLen(): i32 { memTyBuf.length }
export function memberTypeStrCharAt(j: i32): i32 { memTyBuf[j] }

// Signature help (D9.10): after a `checkSrcSym`, the parameter table of the
// function whose NAME sits at (line, col) — 1-based line, 0-based col. `sigAt`
// computes the table and returns its ROW COUNT, or -1 when nothing there is
// callable; a zero-parameter function is a real signature with an empty table, so
// the host must tell the two apart by the SIGN, not by emptiness. The per-index
// accessors read each parameter's NAME (per-codepoint, zero length when the name is
// not knowable — a function-typed value carries none) and rendered TYPE; `sigRet*`
// reads the return type. The host's own tokenizer finds the callee name by walking
// back from the open paren and counts the commas that make the ACTIVE parameter —
// neither is a question the checker is asked here.
export function sigAt(line: i32, col: i32): i32 { symSigAt(line, col) }
export function sigParamNameLen(i: i32): i32 { symSigParamNameLen(i) }
export function sigParamNameCharAt(i: i32, j: i32): i32 {
  symSigParamNameCharAt(i, j)
}
export function sigParamTypeLen(i: i32): i32 { symSigParamTypeLen(i) }
export function sigParamTypeCharAt(i: i32, j: i32): i32 {
  symSigParamTypeCharAt(i, j)
}
// The parameter's DEFAULT VALUE as source text, zero length when it has none —
// what makes a defaulted parameter render as `b: i32 = 10` and therefore READ as
// optional in an editor that has no flag for optionality.
export function sigParamDefaultLen(i: i32): i32 { symSigParamDefaultLen(i) }
export function sigParamDefaultCharAt(i: i32, j: i32): i32 {
  symSigParamDefaultCharAt(i, j)
}
export function sigRetLen(): i32 { symSigRetLen() }
export function sigRetCharAt(j: i32): i32 { symSigRetCharAt(j) }

// Member semantic tokens: after a `checkSrcSym`, every member-access property
// name the checker resolved — `memberCount()` then per-index span + class. A
// member is a `method` (`memberIsMethodAt(i) == 1`) when its resolved type is a
// function, else a `property`. The native counterpart of the host's AST member
// walk; lets the wasm semantic-tokens path classify `o.x`/`xs.get` itself.
export function memberCount(): i32 { symMemberCount() }
export function memberLineAt(i: i32): i32 { symMemberLine(i) }
export function memberColAt(i: i32): i32 { symMemberCol(i) }
export function memberLenAt(i: i32): i32 { symMemberLen(i) }
export function memberIsMethodAt(i: i32): i32 { symMemberIsMethod(i) }

// Scope-at-position (completion): after a `checkSrcSym`, the user bindings
// (var/param/function) visible at (line, col) — 1-based line, 0-based col. `scopeAt`
// returns the set's count; the per-index accessors read each binding's NAME
// (per-codepoint), KIND (0=variable 1=parameter 2=function) and rendered TYPE.
// Builtins/imports/types are not included — the host folds those in.
//
// Multi-module: `symScopeAt` walks the MERGED program's visibility table, whose spans
// are per-module source coordinates, so a dep's top-level span contains most entry
// positions and every dep binding would otherwise leak into the entry's set. Filter to
// bindings DECLARED in the entry (`modOfTok(decl tok) == 0`, also 0 throughout a
// single-module check) plus the dep declarations the entry IMPORTS, matched by exact
// MERGED name (`modMergedTargetOf`, so an alias or re-export keeps exactly one).
export function scopeAt(line: i32, col: i32): i32 {
  const n = symScopeAt(line, col)
  // The merged names the entry's imports denote — the only dep rows kept.
  const okDep: {[string]: i32} = Map()
  let ij = 0
  while ij < impMod.length {
    if impMod[ij] == 0 && impLocal[ij] != "" && impName[ij] != "" {
      const dd = modIndexOfKey(impKey[ij])
      if dd >= 0 { okDep[modMergedTargetOf(dd, impName[ij])] = 1 }
    }
    ij = ij + 1
  }
  let w = 0
  let i = 0
  while i < n {
    const fromEntry = modOfTok(scopeResTok[i]) == 0
    if fromEntry || (okDep[scopeResRaw[i]] ?? 0) == 1 {
      if w != i {
        scopeResName[w] = scopeResName[i]
        scopeResKind[w] = scopeResKind[i]
        scopeResType[w] = scopeResType[i]
        scopeResRaw[w] = scopeResRaw[i]
        scopeResTok[w] = scopeResTok[i]
      }
      w = w + 1
    }
    i = i + 1
  }
  while scopeResName.length > w {
    scopeResName.pop()
    scopeResKind.pop()
    scopeResType.pop()
    scopeResRaw.pop()
    scopeResTok.pop()
  }
  w
}
export function scopeNameLen(i: i32): i32 { symScopeNameLen(i) }
export function scopeNameCharAt(i: i32, j: i32): i32 {
  symScopeNameCharAt(i, j)
}
export function scopeKindAt(i: i32): i32 { symScopeKindAt(i) }
export function scopeTypeLen(i: i32): i32 { symScopeTypeLen(i) }
export function scopeTypeCharAt(i: i32, j: i32): i32 {
  symScopeTypeCharAt(i, j)
}

// Member completion (LSP): after a `checkSrcSym`, the members of the receiver type
// whose binding is under (line, col) — `memberScanAt` resolves + records the set,
// the per-index accessors read each member's NAME (per-codepoint), detail TYPE
// string (per-codepoint), and method flag (`memberScanIsFn` = 1 for a
// function-typed member). The host strips the trailing `.` so the receiver parses
// as a bare expression at its original position. The native `receiverObjectType` +
// `memberCompletions`.
export function memberScanAt(line: i32, col: i32): i32 {
  symMemberScanAt(line, col)
}
export function memberScanCount(): i32 { symMemberScanCount() }
export function memberScanNameLen(i: i32): i32 { symMemberScanNameLen(i) }
export function memberScanNameCharAt(i: i32, j: i32): i32 {
  symMemberScanNameCharAt(i, j)
}
export function memberScanTypeLen(i: i32): i32 { symMemberScanTypeLen(i) }
export function memberScanTypeCharAt(i: i32, j: i32): i32 {
  symMemberScanTypeCharAt(i, j)
}
export function memberScanIsFn(i: i32): i32 { symMemberScanIsFn(i) }

// UFCS candidates (LSP): after a `checkSrcSym`, the free `self`-functions the
// receiver under (line, col) DISPATCHES to — the other half of what `x.` can offer,
// and the half `memberScanAt` structurally cannot see (it reads the receiver's field
// set; this reads the program's declarations). The host strips the trailing `.` as it
// does for `memberScanAt`, so one repaired source serves both. Per-index accessors
// read each candidate's NAME (demangled), its rendered SIGNATURE with the receiver
// row dropped, and the owning MODULE — `modOfTok` over the decl-name token, which is
// what the host needs to spell `import { name } from "<key>"`.
//
// A candidate outside the entry is NOT necessarily out of scope, and the HOST decides
// that: it holds the file's import statements and already answers the same question
// for std auto-import. Answering here would be a second answer, renames in between.
export function ufcsScanAt(line: i32, col: i32): i32 {
  symUfcsScanAt(line, col)
}
export function ufcsScanCount(): i32 { symUfcsScanCount() }
export function ufcsScanNameLen(i: i32): i32 { symUfcsScanNameLen(i) }
export function ufcsScanNameCharAt(i: i32, j: i32): i32 {
  symUfcsScanNameCharAt(i, j)
}
export function ufcsScanDetailLen(i: i32): i32 { symUfcsScanDetailLen(i) }
export function ufcsScanDetailCharAt(i: i32, j: i32): i32 {
  symUfcsScanDetailCharAt(i, j)
}
export function ufcsScanModuleAt(i: i32): i32 {
  const tk = symUfcsScanTokAt(i)
  if tk < 0 { return 0 }
  modOfTok(tk)
}
export function ufcsScanExportedAt(i: i32): i32 { symUfcsScanExportedAt(i) }

// Builtin completions (LSP): the compiler's builtin surface the host folds into
// identifier completion — the numeric/string TYPE names, the builtin FUNCTIONS
// (`print`/`Map`/`Set`/`fromCodePoint[s]`) and the LINEAR-MEMORY intrinsics, kept
// HERE next to the compiler that owns them as the single source of truth. Static (no
// source / `checkSrcSym` needed): `builtinScan` fills the table and the per-index
// accessors read each entry's NAME, KIND (0=type, 1=function) and detail TYPE string.
//
// TWO FAMILIES sit behind "builtin", and the distinction matters to anyone extending
// this list. `print`/`Map`/… and the numeric-opcode intrinsics are special-cased call
// arms with NO scope entry — nothing to enumerate, so they can only be listed by hand.
// The memory intrinsics are `declare`d into `T.scopes[0]` (`typecheck.vl`), which is
// enumerable — listing them here is a duplication a later change could retire.
let blName: string[] = []
let blKind: i32[] = []
let blType: string[] = []
function blPush(n: string, k: i32, t: string) {
  blName.push(n)
  blKind.push(k)
  blType.push(t)
}
export function builtinScan(): i32 {
  // EVERY TYPE STRING BELOW IS READ BY A PERSON — it is the completion `detail` — so it
  // is spelled the way VL source spells a type, `(params) => ret`. Hand-written rather
  // than rendered (see the note above on why these cannot be enumerated), which is
  // exactly the shape that drifts from `tyToStr`'s answer for the same column.
  blName = []
  blKind = []
  blType = []
  blPush("i32", 0, "i32")
  blPush("i64", 0, "i64")
  blPush("f32", 0, "f32")
  blPush("f64", 0, "f64")
  blPush("boolean", 0, "boolean")
  blPush("string", 0, "string")
  // `print` is an OVERLOAD SET, not a polymorphic function: the checker arm accepts a
  // value of any printable type and the emitter picks a `__print_*__` sink per runtime
  // rep, so there is one signature per rep and no boxed argument is admitted. VL spells
  // neither overloads nor `any`, so the accepted set renders as a union of the reps that
  // actually print; arity is exactly one and the result is `void`. Shapes with no single
  // scalar rep — arrays, structs, maps, sets, function values — are OUTSIDE THE DOMAIN,
  // and `tyPrintsAsRef` refuses them with this same string: advertised and enforced
  // domain are literally one `printDomainStr()`, so they cannot drift. WIDENING IT IS A
  // LANGUAGE DECISION, NOT AN EMITTER ONE — a container's rep is an ordinary `(ref $t)`
  // the emitter already builds; what is missing is a defined RENDERING (D711).
  // `toString` is NOT here any more: it is `std:fmt`'s export (DECISIONS.md), so
  // completion for it arrives through the importing file's own scope.
  blPush("print", 1, "(" + printDomainStr() + ") => void")
  blPush("fromCodePoint", 1, "(i32) => string")
  blPush("fromCodePoints", 1, "(i32[]) => string")
  // D1582 — the DETAIL names the type a completion produces, and `Map`/`Set` are
  // not type names: the index signature is. Naming them here handed the one reader
  // who could still be told the spelling a type that does not resolve.
  blPush("Map", 1, "() => {[K]: V}")
  blPush("Set", 1, "() => {[K]: boolean}")
  // The LINEAR-MEMORY intrinsics that actually LOWER. Listed so the tier is
  // discoverable at all — until now none of the memory dunders completed, so a
  // consumer had to already know the names to type them. Only lowered ops are
  // listed: completing `__store_string__` would hand the author a name that passes
  // `vl check` and then fails at emit, which is worse than not offering it. (The
  // three WIDE stores below joined this list the day they acquired a lowering, by
  // exactly that rule.)
  //
  // The addresses are BYTE offsets and the ops are the wasm instructions'
  // signatures exactly — `__load_i8__` sign-extends into the i32 result,
  // `__load_u8__` zero-extends, and stores are sign-agnostic.
  blPush("__store_i32__", 1, "(i32, i32) => void")
  blPush("__store_i64__", 1, "(i32, i64) => void")
  blPush("__store_f32__", 1, "(i32, f32) => void")
  blPush("__store_f64__", 1, "(i32, f64) => void")
  blPush("__load_i32__", 1, "(i32) => i32")
  blPush("__load_i8__", 1, "(i32) => i32")
  blPush("__load_u8__", 1, "(i32) => i32")
  blPush("__load_i16__", 1, "(i32) => i32")
  blPush("__load_u16__", 1, "(i32) => i32")
  blPush("__load_i64__", 1, "(i32) => i64")
  blPush("__load_f32__", 1, "(i32) => f32")
  blPush("__load_f64__", 1, "(i32) => f64")
  // `memory.size` is the CURRENT size in 64 KiB pages; `memory.grow` returns the
  // size BEFORE the growth, or -1 if it failed.
  blPush("__memory_size__", 1, "() => i32")
  blPush("__memory_grow__", 1, "(i32) => i32")
  // The FILESYSTEM floor — the only host-imported intrinsics that are spellable in VL
  // source (the `__print_*__` family is reachable only through `print`, so it has no
  // scope entry and nothing to complete). Listed by the same rule as the memory tier:
  // only names that actually LOWER, so a completion never hands the author something
  // that passes `vl check` and dies at emit.
  //
  // These are the floor beneath `std:fs`, not the surface — an author reaches for
  // `readTextFile`, not `__fs_read__`. They are listed anyway because the tier is
  // otherwise undiscoverable and because a host embedder implementing the ABI needs the
  // signatures; the `u8[]` in them is the honest type, and `std:utf8` is what turns it
  // into a `string`.
  blPush("__fs_read__", 1, "(u8[]) => u8[]")
  blPush("__fs_write__", 1, "(u8[], u8[]) => i32")
  blPush("__fs_list__", 1, "(u8[]) => u8[]")
  blPush("__fs_stat__", 1, "(u8[]) => i32")
  blPush("__args_count__", 1, "() => i32")
  blPush("__args_get__", 1, "(i32) => u8[]")
  blPush("__fs_errno__", 1, "() => i32")
  blName.length
}
export function builtinCount(): i32 { blName.length }
export function builtinNameLen(i: i32): i32 { blName[i].length }
export function builtinNameCharAt(i: i32, j: i32): i32 { blName[i][j] }
export function builtinKindAt(i: i32): i32 { blKind[i] }
export function builtinTypeLen(i: i32): i32 { blType[i].length }
export function builtinTypeCharAt(i: i32, j: i32): i32 { blType[i][j] }

// ── LSP lexical semantic tokens: keywords / operators / literals / comments ────
// The lexical highlighting layer the host used to own; it needs no typecheck.
// `lexScan()` tokenizes the staged source (srcReset/srcPush first) and records, per
// COLOURED token, a lexical CLASS plus its 1-based line / 0-based col / length;
// retained `//` and `///` comments fold in as class COMMENT. Tokens that get no
// colour — identifiers (owned by the symbol slice), strings (left to the TextMate
// grammar, whose finer escape scopes survive) and structural punctuation — drop out
// at class < 0. TEMPLATE literals are the ONE literal that does get a class, because
// a template is not one token: its text runs arrive as `TEMPLATE*` with the hole
// EXPRESSIONS lexed between, so TextMate would colour a hole's identifiers as string
// content. Class 5 paints only the text parts and the `${` / `}` riding on them.
//   class: 0 keyword  1 operator  2 number  3 boolean  4 comment  5 template text
let lexCls: i32[] = []
let lexLine: i32[] = []
let lexCol: i32[] = []
let lexLen: i32[] = []

// The lexical class for a lexer token kind, or -1 for kinds that get no token.
// Operators span arithmetic / logical / comparison / bitwise / compound-assign /
// nullish. Keyed off the lexer's ACTUAL kind tags (`SLASH`/`PERCENT`/`BANG`/`EQ`…)
// rather than the host's older guesses, so every operator the lexer emits colours.
//
// THE KEYWORD ARMS ARE A COPY of `keywordKind`'s (`lexer.vl`) — one of four, and
// this one had never learned `MATCH`, so `match` painted as nothing at all in the
// editor. `tests/keyword_vocabulary_test.ts` derives the set from the lexer and
// fails this function when an arm is missing; a hard keyword the lexer mints must
// land in the `0` (keyword) group or the `3` (boolean/null literal) group.
function lexClassOf(kind: TokKind): i32 {
  if kind == "NUMBER" { return 2 }
  if (
    kind == "TEMPLATE" ||
    kind == "TEMPLATE_HEAD" ||
    kind == "TEMPLATE_MID" ||
    kind == "TEMPLATE_TAIL"
  ) {
    return 5
  }
  if kind == "TRUE" || kind == "FALSE" || kind == "NULL" { return 3 }
  if (
    kind == "FUNCTION" ||
    kind == "IF" ||
    kind == "ELSE" ||
    kind == "WHILE" ||
    kind == "FOR" ||
    kind == "CONST" ||
    kind == "LET" ||
    kind == "RETURN" ||
    kind == "IS" ||
    kind == "AWAIT" ||
    kind == "BREAK" ||
    kind == "CONTINUE" ||
    kind == "TYPE" ||
    kind == "IMPORT" ||
    kind == "EXPORT" ||
    kind == "MATCH"
  ) {
    return 0
  }
  if (
    kind == "PLUS" ||
    kind == "MINUS" ||
    kind == "STAR" ||
    kind == "SLASH" ||
    kind == "PERCENT" ||
    kind == "CARET" ||
    kind == "EQUAL" ||
    kind == "PLUSEQ" ||
    kind == "MINUSEQ" ||
    kind == "STAREQ" ||
    kind == "SLASHEQ" ||
    kind == "PLUSPLUS" ||
    kind == "MINUSMINUS" ||
    kind == "AND" ||
    kind == "OR" ||
    kind == "BANG" ||
    kind == "EQ" ||
    kind == "NE" ||
    kind == "GT" ||
    kind == "GE" ||
    kind == "LT" ||
    kind == "LE" ||
    kind == "PIPE" ||
    kind == "AMPERSAND" ||
    kind == "TILDE" ||
    kind == "SHL" ||
    kind == "SHR" ||
    kind == "USHR" ||
    kind == "QUESTION_DOT" ||
    kind == "QUESTION_QUESTION"
  ) {
    return 1
  }
  -1
}

export function lexScan(): i32 {
  lexCls = []
  lexLine = []
  lexCol = []
  lexLen = []
  const r = tokenize(vcSource())
  let i = 0
  while i < r.tokens.length {
    const t = r.tokens[i]
    const c = lexClassOf(t.kind)
    if c >= 0 {
      lexCls.push(c)
      lexLine.push(t.line)
      lexCol.push(t.col)
      lexLen.push(t.text.length)
    }
    i = i + 1
  }
  // Retained comments → class COMMENT. The lexeme text includes the leading `//`
  // or `///`, so its length spans the whole comment to end of line.
  let k = 0
  while k < r.comments.length {
    const cm = r.comments[k]
    lexCls.push(4)
    lexLine.push(cm.line)
    lexCol.push(cm.col)
    lexLen.push(cm.text.length)
    k = k + 1
  }
  lexCls.length
}
export function lexCount(): i32 { lexCls.length }
export function lexClassAt(i: i32): i32 { lexCls[i] }
export function lexLineAt(i: i32): i32 { lexLine[i] }
export function lexColAt(i: i32): i32 { lexCol[i] }
export function lexLenAt(i: i32): i32 { lexLen[i] }

// All failure diagnostics, newline-joined: parse diags, then typecheck diags,
// then the emit failure message (whichever stage failed populated its store).
function vcDiags(): string {
  let out = ""
  let i = 0
  while i < P.diags.length {
    const d = P.diags[i]
    out = out + demangleMsg(d.msg) + "\n"
    i = i + 1
  }
  let j = 0
  while j < T.diags.length {
    const d2 = T.diags[j]
    out = out + demangleMsg(d2.tmsg) + "\n"
    j = j + 1
  }
  if emitErr.length > 0 { out = out + demangleMsg(emitErr) + "\n" }
  out
}
// The host reads the joined text ONE CODE POINT PER CALL (`diagAt(i)`), so
// re-rendering — re-demangling and re-joining every message — on each read
// makes error reporting quadratic in the diagnostic text. Memoize the rendered
// string (the `symTyBuf` idiom); the pipeline entry points invalidate it
// (`vcDiagMemoReset`) before repopulating the diagnostic stores.
let vcDiagsBuf = ""
let vcDiagsBufValid = 0
function vcDiagsMemo(): string {
  if vcDiagsBufValid == 0 {
    vcDiagsBuf = vcDiags()
    vcDiagsBufValid = 1
  }
  vcDiagsBuf
}
// Per-message memo for the structured stream (`diagMsgAt(i, j)` is likewise
// read once per character): the last (index, rendered message) pair.
let vcDiagMsgBufI = -1
let vcDiagMsgBuf = ""
function vcDiagMemoReset(): i32 {
  vcDiagsBufValid = 0
  vcDiagMsgBufI = -1
  0
}
export function diagLen(): i32 { vcDiagsMemo().length }
export function diagAt(i: i32): i32 { vcDiagsMemo()[i] }

// ── Structured per-diagnostic exports (positions) ─────────────────────────────
// PARALLEL to `diagLen`/`diagAt` (which stay byte-compatible: corpus `@error`
// directives and host-parity tests substring-match that newline-joined TEXT).
// The host reads `diagCount()` diagnostics; for each, the message text via the
// per-byte `diagMsgLen(i)`/`diagMsgAt(i, j)` idiom and its source position via
// `diagLine(i)` (1-based; 0 = "no position, render the message bare") and
// `diagCol(i)` (0-based — the lexer's and `@error-at`'s convention). Order
// matches `vcDiags`: parse diags (lex diags first), then type diags, then the
// emit failure message (positionless).
export function vcDiagMsg(i: i32): string {
  // Demangle the module-merge `$mN` rename artifact so the user sees SOURCE names.
  if i < P.diags.length { return demangleMsg(P.diags[i].msg) }
  const j = i - P.diags.length
  if j < T.diags.length { return demangleMsg(T.diags[j].tmsg) }
  demangleMsg(emitErr)
}
export function diagCount(): i32 {
  let n = P.diags.length + T.diags.length
  if emitErr.length > 0 { n = n + 1 }
  n
}
function vcDiagMsgMemo(i: i32): string {
  if vcDiagMsgBufI != i {
    vcDiagMsgBuf = vcDiagMsg(i)
    vcDiagMsgBufI = i
  }
  vcDiagMsgBuf
}
export function diagMsgLen(i: i32): i32 { vcDiagMsgMemo(i).length }
export function diagMsgAt(i: i32, j: i32): i32 { vcDiagMsgMemo(i)[j] }
export function diagLine(i: i32): i32 {
  if i < P.diags.length {
    // A tokenless diag (lex / module-resolution) carries its own position.
    const k = vcDgFind(i)
    if k >= 0 { return vcDgLine[k] }
    // A parse diag is anchored at a token index; out of range ⇒ no position.
    const at = P.diags[i].at
    if at >= 0 && at < P.toks.length { return P.toks[at].line }
    return 0
  }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tline }
  // The emit failure (the last diagnostic): anchored at the function being lowered
  // when it failed (`emitErrAt`, resolved through `nodeToks` like a type diag), so
  // the diagnostic carries a source span. -1 ⇒ positionless (rendered bare).
  const et = emitErrTokIx()
  if et >= 0 { return P.toks[et].line }
  0
}
export function diagCol(i: i32): i32 {
  if i < P.diags.length {
    const k = vcDgFind(i)
    if k >= 0 { return vcDgCol[k] }
    const at = P.diags[i].at
    if at >= 0 && at < P.toks.length { return P.toks[at].col }
    return 0
  }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tcol }
  const et = emitErrTokIx()
  if et >= 0 { return P.toks[et].col }
  0
}
// The token index the emit-failure diagnostic anchors at (its function's decl),
// or -1 for a positionless (module-level) failure — the `emitErrAt` node resolved
// through `nodeToks`, mirroring a type diag's node→token resolution.
function emitErrTokIx(): i32 { declAnchorTokIx(emitErrAt) }

// The token an emit-side diagnostic anchors arena node `nodeIx` at, or -1.
//
// Prefer the DECLARING-NAME token (the function name) — `nodeToks` anchors a FuncDecl at
// its CLOSING brace (the last token), the wrong span to point a reader at; the name is
// where an editor jumps. Fall back to the node anchor.
//
// ONE SPELLER for the two emit-side channels: the refusal (`emitErrTokIx`) and the
// VALIDATE diagnostic's function spans (`emitFnSpanTokIx`, D1578). They anchor the same
// kind of node and must not drift into naming different tokens for it.
function declAnchorTokIx(nodeIx: i32): i32 {
  if nodeIx < 0 { return -1 }
  const nm = declNameTokOf(nodeIx)
  if nm >= 0 && nm < P.toks.length { return nm }
  if nodeIx >= nodeToks.length { return -1 }
  const at = nodeToks[nodeIx]
  if at >= 0 && at < P.toks.length { return at }
  -1
}

// ── the emitted module's byte offset → the function that owns it (D1578) ─────
// A module the engine REFUSES reports a byte offset into bytes the author never sees, so
// the failure was unreadable. The emit channel got positions in D1519; this is the same
// for the VALIDATE channel. `emitCodeSection` banked each user body's module byte range;
// these turn the engine's offset into `file:line:col` plus the function's own name.
//
// LOOKUP IS A SCAN, deliberately: at most once per compile and only on the failure
// path, where the module is already known not to load.
//
// -1 / 0 for an offset inside no recorded body — a synthetic start, a shared runtime
// helper, an export wrapper, or a failure in another section. The caller then prints
// the engine's own text, which is what it printed before.
export function emitFnSpanAt(off: i32): i32 {
  let i = 0
  while i < emitFnSpanStart.length {
    if off >= emitFnSpanStart[i] && off < emitFnSpanEnd[i] { return i }
    i = i + 1
  }
  -1
}
function emitFnSpanTokIx(i: i32): i32 {
  if i < 0 || i >= emitFnSpanNode.length { return -1 }
  // THE SLOT'S PRE-MONOMORPHIZATION ORIGINAL FIRST. An instance, a lifted lambda copy
  // and a pruned stub are all minted AFTER parsing, so `addNode` anchors them at the EOF
  // token — a position that reads as real and points at the last line of the file.
  // `monoOrigNode` holds the pristine declaration for the slot, and the STAMP is the
  // test: only a parsed declaration carries a `declNameTok`, so requiring one is what
  // keeps a synthesized body positionless instead of confidently wrong.
  const orig = monoOrigNodeOfSlot(emitFnSpanPos[i])
  if declNameTokOf(orig) >= 0 { return declAnchorTokIx(orig) }
  const nd = emitFnSpanNode[i]
  if declNameTokOf(nd) >= 0 { return declAnchorTokIx(nd) }
  -1
}
// The pristine pre-pass `FuncDecl` for `fnStmts` slot `fe`, or -1: the slot's own entry
// when the pass froze one, else the ORIGIN slot's when `fe` is an appended instance.
function monoOrigNodeOfSlot(fe: i32): i32 {
  if fe < 0 { return -1 }
  if fe < monoOrigNode.length { return monoOrigNode[fe] }
  let q = 0
  while q < monoInstFe.length {
    if monoInstFe[q] == fe {
      const of = monoInstOrig[q]
      if of >= 0 && of < monoOrigNode.length { return monoOrigNode[of] }
      return -1
    }
    q = q + 1
  }
  -1
}
export function emitFnSpanLine(i: i32): i32 {
  const t = emitFnSpanTokIx(i)
  if t >= 0 { return P.toks[t].line }
  0
}
export function emitFnSpanCol(i: i32): i32 {
  const t = emitFnSpanTokIx(i)
  if t >= 0 { return P.toks[t].col }
  0
}
export function emitFnSpanModule(i: i32): i32 {
  const t = emitFnSpanTokIx(i)
  if t >= 0 { return modOfTok(t) }
  0
}
// The name the NAME SECTION gives this body — a lambda's binding display name where it
// has one, else the declared name — so the host's sentence and the engine's own
// `function[N]::<name>` cannot disagree about what to call it.
export function emitFnSpanName(i: i32): string {
  if i < 0 || i >= emitFnSpanPos.length { return "" }
  const p = emitFnSpanPos[i]
  if p >= 0 && p < fnDispNames.length {
    if fnDispNames[p].length > 0 { return fnDispNames[p] }
  }
  const fn = P.nodes[emitFnSpanNode[i]]
  if fn is FuncDecl { return fn.fnName }
  ""
}
export function emitFnSpanNameLen(i: i32): i32 { emitFnSpanName(i).length }
export function emitFnSpanNameAt(i: i32, j: i32): i32 {
  const s = emitFnSpanName(i)
  if j >= 0 && j < s.length { return s[j] }
  0
}

// The BYTE OFFSET an engine validation message names, or -1 when it names none.
//
// wasmtime spells it two ways and both arrive here: `(at offset 0x11b)` from
// `Module::validate` (the CMD_VALIDATE round-trip) and `at offset 188` from
// `Module::new`'s translation error. The LAST occurrence wins — a `Caused by:` chain
// repeats the inner message under the outer one.
//
// THE HOST CARRIES THE SAME PARSER IN RUST (`engine_fail_offset`,
// scripts/vl-host/src/main.rs): `vl build` / `vl run` never enter the CLI pump, so each
// channel reads the engine's own spelling for itself. They move together.
export function engineFailOffset(msg: string): i32 {
  const key = "at offset "
  let at = -1
  let i = 0
  while i + key.length <= msg.length {
    let k = 0
    let same = true
    while k < key.length {
      if msg[i + k] != key[k] {
        same = false
        break
      }
      k = k + 1
    }
    if same { at = i + key.length }
    i = i + 1
  }
  if at < 0 { return -1 }
  let p = at
  let hex = false
  if p + 1 < msg.length {
    if msg[p] == '0' && msg[p + 1] == 'x' {
      hex = true
      p = p + 2
    }
  }
  let v = 0
  let n = 0
  while p < msg.length {
    const c = msg[p]
    let d = -1
    if c >= '0' && c <= '9' { d = c - '0' }
    else if hex && c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
    else if hex && c >= 'A' && c <= 'F' { d = c - 'A' + 10 }
    if d < 0 { break }
    if hex { v = v * 16 + d } else { v = v * 10 + d }
    n = n + 1
    p = p + 1
  }
  if n == 0 { return -1 }
  v
}
// The diagnostic's END column: the anchor token's start + its lexeme length
// (lexemes never span lines, so the end LINE is `diagLine`). A parse diag is
// anchored at a TOKEN index; a type diag at an AST NODE index, resolved through
// the `nodeToks` side table — the same resolution `tErr` applies. A TOKENLESS
// diag (lex / module-resolution) carries its OWN end in the `vcDg*` side table,
// because there is no token to derive one from — a char literal of the wrong
// length is about the whole literal and rendered as a one-column caret until it
// could say so. A positionless/out-of-range anchor, or a side-table entry with no
// span recorded, degrades to `diagCol` — a zero-width range at the start, which an
// LSP host may widen client-side.
export function diagEndCol(i: i32): i32 {
  let at = -1
  if i < P.diags.length {
    const k = vcDgFind(i)
    if k >= 0 {
      if vcDgEnd[k] > vcDgCol[k] { return vcDgEnd[k] }
      return diagCol(i)
    }
    at = P.diags[i].at
  } else {
    const j = i - P.diags.length
    if j < T.diags.length {
      const nd = T.diags[j].tat
      if nd >= 0 && nd < nodeToks.length { at = nodeToks[nd] }
    } else {
      // The emit failure — anchored at its function's decl token (`emitErrAt`).
      at = emitErrTokIx()
    }
  }
  if at >= 0 && at < P.toks.length {
    return P.toks[at].col + tokFirstLineLen(P.toks[at].text)
  }
  diagCol(i)
}

// The lexeme's length UP TO its first line break — the width a `col + len` end
// column may honestly claim.
//
// `col + text.length` is the whole width only while a token cannot span lines,
// and TEMPLATE literals can (a raw newline is content in one, the JS rule). An
// unclamped end column for a multi-line template runs past the end of its own
// line and lands wherever the arithmetic falls, on a line the span never names —
// a nonsense range for the CLI's caret and for the LSP's. Clamping to the first
// line is the same answer `diagSpan` reaches on the lexer side, and for the same
// reason: a span here is ONE column pair on ONE line by construction, so the
// most it can describe is where the construct starts and how far it runs before
// the line ends. Every other token is single-line and this is the identity.
function tokFirstLineLen(text: string) {
  let i = 0
  while i < text.length && text[i] != '\n' && text[i] != '\r' { i = i + 1 }
  i
}
// The diagnostic's stable CATEGORY code, "" when it has none. A TYPE diagnostic
// carries "unsupported-lowering" when the program is type-valid but uses a
// construct codegen cannot lower yet (`tErrUnsupported`), so tooling can
// distinguish an emitter-capability rejection from a type-soundness verdict;
// parse and emit diagnostics carry "". Read via the per-byte idiom, mirroring
// `lintCodeLen`/`lintCodeByte`.
function vcDiagCode(i: i32): string {
  if i < P.diags.length { return "" }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tcode }
  ""
}
export function diagCodeLen(i: i32): i32 { vcDiagCode(i).length }
export function diagCodeByte(i: i32, j: i32): i32 { vcDiagCode(i)[j] }

// The diagnostic's STRUCTURED PAYLOAD, "" when it has none — the second half of
// the coded-diagnostic ABI, read exactly as the code pair is. The code names a
// bare CATEGORY (`ufcs-not-imported`) and this carries the answer that category
// needs (which member, from which modules, on which receiver), so no consumer has
// to split a code string and no value's characters can bite the framing. The
// encoding is netstring fields — `typecheck.diagDataField` documents it, and
// `compiler/diagnostics.ts` `decodeDiagData` is the reader. Parse diagnostics and
// every uncoded type diagnostic answer "".
function vcDiagData(i: i32): string {
  if i < P.diags.length { return "" }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tdata }
  ""
}
export function diagDataLen(i: i32): i32 { vcDiagData(i).length }
export function diagDataByte(i: i32, j: i32): i32 { vcDiagData(i)[j] }

// ── H3: native module resolution ──────────────────────────────────────────────
// The module-table half of docs/native-modules-design.md (state declared at the
// top of this file — globals precede their first textual use). The host (Rust
// driver) runs a FETCH LOOP: it commits the entry, asks `modPendingCount` which
// resolved keys are still needed, reads + commits them, and repeats until the
// graph is closed; `compileSrc`/`checkSrc` then run the module pipeline
// (order/validate → parse-merge → rename/rewrite → check/emit). With an EMPTY
// table they behave exactly as before — the back-compat branch every existing
// consumer (the selfhost harnesses, the fixpoint assemblies) rides.
export function modReset(): i32 {
  modKeys = []
  modSrcs = []
  modFound = []
  modKeyAcc = []
  modSrcAcc = []
  impMod = []
  impSpec = []
  impKey = []
  impName = []
  impLocal = []
  impNameLine = []
  impNameCol = []
  impSpecLine = []
  impSpecCol = []
  impSpecEnd = []
  impSpecChar = []
  expMod = []
  expName = []
  expDeclLine = []
  expDeclCol = []
  expKwLine = []
  expKwCol = []
  reExpMod = []
  reExpPublic = []
  reExpLocal = []
  reExpName = []
  reExpTarget = []
  modPending = []
  // Clear the token-load ranges too: a subsequent SINGLE-FILE check (no imports →
  // no `modCompile`) must not inherit a prior graph's ranges, or `symOccModuleAt`
  // would mis-attribute its occurrences.
  modLoadStart = []
  modLoadMod = []
  0
}
export function modKeyPush(c: i32): i32 {
  modKeyAcc.push(c)
  0
}
export function modSrcPush(c: i32): i32 {
  modSrcAcc.push(c)
  0
}
// The `modKey`/`modSrc` twins of `srcLoad` — see its header for the protocol, the
// staging window and why the loop cannot be a bulk copy. `modSrcLoad` is the one
// that matters: it carries EVERY module of a multi-file graph (the whole compiler
// during a self-compile), and `modSrcPush` was the 5th hottest function in the
// profile that motivated this. `modKeyLoad` carries only module keys (paths) and
// is here because a half-converted family is the defect the classifier memo warns
// about: the host probes each channel independently, so a channel left behind just
// keeps paying per code point, silently.
export function modKeyLoad(count: i32): i32 {
  let i = 0
  while i < count {
    const cp = __load_i32__(i * 4)
    modKeyAcc.push(cp)
    i = i + 1
  }
  0
}
// The four loops are deliberately the SAME shape. A local-alias + byte-cursor
// variant (`const acc = modSrcAcc`, `while off < count * 4`) was built and A/B'd
// interleaved: 135 vs 139 ms of `stage_program` over 9 runs — under the floor, and
// the box's load moved more than the edit did. Uniformity wins on a tie.
export function modSrcLoad(count: i32): i32 {
  let i = 0
  while i < count {
    const cp = __load_i32__(i * 4)
    modSrcAcc.push(cp)
    i = i + 1
  }
  0
}
// Register the accumulated (key, source) pair. `found = 0` marks "the host could
// not read this key" so the unresolvable diagnostic fires instead of an infinite
// re-request. A found module is token-scanned immediately (imports + exports).
export function modCommit(found: i32): i32 {
  const key = fromCodePoints(modKeyAcc)
  const src = fromCodePoints(modSrcAcc)
  modKeyAcc = []
  modSrcAcc = []
  modCommitStr(key, src, found)
}
// The direct entry point, for a caller that ALREADY HOLDS the strings. `cliModCommitOne`
// is that caller — it is VL calling VL, with no host boundary between them — and it used to
// push its two strings element by element into the accumulators above just so this function
// could rebuild them. That cost two full copies of every module's source per compile, and
// once `s[i]` became a UTF-8 BYTE (Stage 2c) while `fromCodePoints` still meant CODE POINTS
// it also silently double-encoded every non-ASCII character in the program being compiled,
// BEFORE the lexer saw it. The accumulators remain for the genuine host channel
// (`modKeyLoad`/`modSrcLoad` stage UTF-32 words through linear memory), which is the only
// place a per-element protocol is forced on us.
export function modCommitStr(key: string, src: string, found: i32): i32 {
  modKeys.push(key)
  modSrcs.push(src)
  modFound.push(found)
  if found != 0 { modScanCached(modKeys.length - 1, key, src) }
  modRecomputePending()
  0
}
// `modScan` through the per-instance cache: replay a recorded scan under table
// index `m` on a hit; on a miss, scan and record the entries the scan appended
// (modScan only ever appends, and only for `m`, so the [before, after) slice IS
// this module's scan result) together with the token range it banked.
function modScanCached(m: i32, key: string, src: string): i32 {
  const ci = modCacheLookup(key, src)
  if ci >= 0 {
    let ii = modCacheImpOff[ci]
    while ii < modCacheImpEnd[ci] {
      impMod.push(m)
      impSpec.push(modCacheImpSpec[ii])
      impKey.push(modCacheImpKey[ii])
      impName.push(modCacheImpName[ii])
      impLocal.push(modCacheImpLocal[ii])
      impNameLine.push(modCacheImpNameLine[ii])
      impNameCol.push(modCacheImpNameCol[ii])
      impSpecLine.push(modCacheImpSpecLine[ii])
      impSpecCol.push(modCacheImpSpecCol[ii])
      impSpecEnd.push(modCacheImpSpecEnd[ii])
      impSpecChar.push(modCacheImpSpecChar[ii])
      ii = ii + 1
    }
    let ri = modCacheReOff[ci]
    while ri < modCacheReEnd[ci] {
      reExpMod.push(m)
      reExpPublic.push(modCacheRePublic[ri])
      reExpLocal.push(modCacheReLocal[ri])
      ri = ri + 1
    }
    let ei = modCacheExpOff[ci]
    while ei < modCacheExpEnd[ci] {
      expMod.push(m)
      expName.push(modCacheExpName[ei])
      expDeclLine.push(modCacheExpDeclLine[ei])
      expDeclCol.push(modCacheExpDeclCol[ei])
      expKwLine.push(modCacheExpKwLine[ei])
      expKwCol.push(modCacheExpKwCol[ei])
      ei = ei + 1
