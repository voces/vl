import { importSpecCharMsg, isStmtKeyword, parseProgram } from "./parser"
// The identifier-intern table (`docs/internals/identifier-interning-design.md`).
// The driver owns two of its obligations: the per-compile RESET (R2 — the carrier
// is keyed by arena INDEX, so a reset arena that reuses index 5 for a different
// identifier would read the previous program's answer), and three of the eight
