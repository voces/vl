}
// Visit module `m`: resolve + validate its imports (unsupported specifier,
// unresolvable key, cycle back-edge, name-not-exported), recursing into deps
// first. Message texts are pinned by the corpus `@error`s, which substring them.
// The DFS recurses once per import-chain link, so an adversarially deep chain
// would overflow the wasm call stack — an opaque trap. Capped with a real
// diagnostic instead; genuine dependency chains sit orders of magnitude below.
const MOD_DEPTH_MAX = 256
function modVisit(m: i32, depth: i32): i32 {
  modState[m] = 1
  let i = 0
  while i < impMod.length {
    if impMod[i] == m {
      const spec = impSpec[i]
      const key = impKey[i]
      if key == "" {
        // Texts mirror the host's `loadProgram` — keep them aligned. Spec-shaped
        // problems anchor at the specifier STRING token of THIS import.
        if impSpecChar[i] == 1 {
          // A CHAR literal where the specifier belongs — the parser's sentence,
          // shared (`importSpecCharMsg`), because the two scanners must agree.
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            importSpecCharMsg(spec),
          )
        } else if modKeyIsStd(modKeys[m]) && modIsRelative(spec) {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Unsupported import specifier \"" +
              spec +
              "\" — std modules import only via `std:` specifiers (relative imports inside std are not allowed)",
          )
        } else {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Unsupported import specifier \"" +
              spec +
              "\" — supported: relative paths (`./`, `../`) and `std:` modules; bare specifiers are not yet implemented",
