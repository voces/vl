}
export function modPendingCount(): i32 { modPending.length }
export function modPendingLen(i: i32): i32 { modPending[i].length }
export function modPendingAt(i: i32, j: i32): i32 { modPending[i][j] }
// The whole key as a STRING. The per-element pair above is the HOST's ABI (its reader
// collects bytes); an in-module caller wants the string itself, and reassembling it from
// elements is the §Builders double-encode since Stage 2c made those elements bytes.
export function modPendingKeyAt(i: i32): string { modPending[i] }

// Cross-file symbols: the import/export surface the module scan already built
// (`imp*`/`exp*`), exposed as accessors. After committing the graph, the host reads
// each import specifier's local alias, exported name, and resolved key, and each
// module's exports with position. Disk crawl and dedup stay host-side.
export function impCount(): i32 { impMod.length }
export function impModAt(i: i32): i32 { impMod[i] }
export function impLocalLen(i: i32): i32 { impLocal[i].length }
export function impLocalCharAt(i: i32, j: i32): i32 { impLocal[i][j] }
export function impNameLen(i: i32): i32 { impName[i].length }
export function impNameCharAt(i: i32, j: i32): i32 { impName[i][j] }
export function impKeyLen(i: i32): i32 { impKey[i].length }
export function impKeyCharAt(i: i32, j: i32): i32 { impKey[i][j] }

export function expCount(): i32 { expMod.length }
export function expModAt(i: i32): i32 { expMod[i] }
export function expNameLen(i: i32): i32 { expName[i].length }
export function expNameCharAt(i: i32, j: i32): i32 { expName[i][j] }
export function expDeclLineAt(i: i32): i32 { expDeclLine[i] }
export function expDeclColAt(i: i32): i32 { expDeclCol[i] }
export function expKwLineAt(i: i32): i32 { expKwLine[i] }
export function expKwColAt(i: i32): i32 { expKwCol[i] }

// The `exp*` twins for a re-export. A second table rather than rows folded into
// `exp*`, because `expName` also means "declared with the keyword here" — the
// emitter's alias pass and the UFCS candidate registry both read it that way, and
// `reExpKey*` is the origin a reader needs to tell the two apart.
export function reExpCount(): i32 { reExpMod.length }
export function reExpModAt(i: i32): i32 { reExpMod[i] }
export function reExpNameLen(i: i32): i32 { reExpPublic[i].length }
export function reExpNameCharAt(i: i32, j: i32): i32 { reExpPublic[i][j] }
export function reExpDeclLineAt(i: i32): i32 { reExpNameLine[i] }
export function reExpDeclColAt(i: i32): i32 { reExpNameCol[i] }
export function reExpKwLineAt(i: i32): i32 { reExpKwLine[i] }
export function reExpKwColAt(i: i32): i32 { reExpKwCol[i] }
export function reExpKeyLen(i: i32): i32 { reExpKey[i].length }
export function reExpKeyCharAt(i: i32, j: i32): i32 { reExpKey[i][j] }

// The committed modules' KEYS, by table index — lets the host map an import's
// resolved key to the module that owns a matching export (`impKey` ↔ `expMod`).
export function modKeyCount(): i32 { modKeys.length }
export function modKeyAtLen(m: i32): i32 { modKeys[m].length }
export function modKeyAtCharAt(m: i32, j: i32): i32 { modKeys[m][j] }

// The table index of the module that owns diagnostic `i` (via `modOfTok`), or 0
// (the entry) when the anchor is positionless. Mirrors `diagLine`/`diagEndCol`'s
// anchor resolution. Must be read before `lintSrc` re-parses the entry, which resets
// `P.toks`/`nodeToks`, after which the anchor would fail to map.
export function diagModule(i: i32): i32 {
  let at = -1
  if i < P.diags.length {
    // A tokenless diag (lex / module-resolution) records its owner directly.
    const k = vcDgFind(i)
    if k >= 0 { return vcDgMod[k] }
    at = P.diags[i].at
  } else {
    const j = i - P.diags.length
    if j < T.diags.length {
      const nd = T.diags[j].tat
      if nd >= 0 && nd < nodeToks.length { at = nodeToks[nd] }
    } else {
      // D1519 — the emit failure arm: `diagLine`/`diagCol`/`diagEndCol` all resolve it
      // through `emitErrTokIx`, so a refusal inside an imported module already prints
      // that module's own line and column. Without this arm the fallthrough names
      // module 0, misreporting an imported file's refusal against the entry's path.
      at = emitErrTokIx()
    }
  }
  if at >= 0 && at < P.toks.length { return modOfTok(at) }
  0
}

// ── specifier resolution (ports of the host's pure string math) ───────────────
// Whether import specifier `spec` separates segments with a backslash (`.\\util`, `C:\\x`).
function modSpecBackslashed(spec: string): boolean {
  for c in spec {
    if c == '\\' { return true }
  }
  false
}

// Whether `spec` is an absolute path: a leading separator, or a drive letter and separator.
function modSpecAbsolute(spec: string): boolean {
  if spec.length > 0 && (spec[0] == '/' || spec[0] == '\\') { return true }
  spec.length > 2 && spec[1] == ':' && (spec[2] == '/' || spec[2] == '\\')
}

// `spec` with each run of backslashes (one, or an escaped pair) a forward slash.
function modSlashed(spec: string): string {
  let out = ""
  let i = 0
  while i < spec.length {
    if spec[i] == '\\' {
      if i == 0 || spec[i - 1] != '\\' { out = out + "/" }
    } else {
      out = out + spec.slice(i, i + 1)
    }
    i = i + 1
  }
  out
}

function modIsRelative(spec: string): boolean {
  if spec.length >= 2 {
    if spec[0] == '.' && spec[1] == '/' { return true }
  }
  if spec.length >= 3 {
    if spec[0] == '.' && spec[1] == '.' && spec[2] == '/' { return true }
  }
  false
}
// A `std:` specifier: `std:` + a [a-z0-9_]+(/[a-z0-9_]+)* module name. The
// specifier IS the module key (returned verbatim by `modResolveSpecifier`);
// the HOST maps it to bytes ($VL_STD / the exe-relative std/ dir).
function modIsStdSpec(spec: string): boolean {
  if !modKeyIsStd(spec) { return false }
  let segLen = 0
  let i = 4
  while i < spec.length {
    const c = spec[i]
    if c == '/' {
      if segLen == 0 { return false }
      segLen = 0
    } else if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' {
      segLen = segLen + 1
    } else {
      return false
    }
    i = i + 1
  }
  segLen > 0
}
// The scheme prefix of module key `key` (`std` for `std:fmt`), or "" for a path key. A scheme
// is a lower-case letter then letters, digits, `+`, `-` or `.`, at least two long, so a
// drive letter (`C:/x`) is a path.
export function modKeyScheme(key: string): string {
  let i = 0
  while i < key.length {
    const c = key[i]
    if c == ':' {
      if i < 2 { return "" }
      return key.slice(0, i)
    }
    const lower = c >= 'a' && c <= 'z'
    const tail = (c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.'
    if !lower && !(i > 0 && tail) { return "" }
    i = i + 1
  }
  ""
}
// A module key in the `std:` scheme (a verbatim std specifier).
function modKeyIsStd(key: string): boolean {
  if key.length < 4 { return false }
  key[0] == 's' && key[1] == 't' && key[2] == 'd' && key[3] == ':'
}
// The directory portion of a `/`-separated key (no trailing slash), "" if none.
function modDirOf(key: string): string {
  let slash = -1
  let i = 0
  while i < key.length {
    if key[i] == '/' { slash = i }
    i = i + 1
  }
  if slash < 0 { return "" }
  // An explicit `return` — a bare member-call TAIL expression routes through the
  // statement dispatch, an emit gap in the native pipeline.
  return key.slice(0, slash)
}
// Normalize a `/`-separated path, collapsing `.` and `..` segments. A leading
// `/` (absolute key) is preserved; leading `..` that escape the root are kept
// (the key stays distinct and the reader simply won't find it).
function modNormalize(path: string): string {
  let absolute = false
  if path.length > 0 {
    if path[0] == '/' { absolute = true }
  }
  let segs: string[] = []
  // STAGE 2c: segments come out as SLICES of `path`, not rebuilt through a code-point
  // buffer. `/` is ASCII so it is found at the same offsets in either unit, and a slice
  // names no unit at all — where `fromCodePoints(cur)` over `path[i]` bytes would have
  // re-encoded every non-ASCII character in a path.
  let segStart = 0
  let i = 0
  while i <= path.length {
    const atEnd = i == path.length
    let c = 0
    if !atEnd { c = path[i] }
    if atEnd || c == '/' {
      const seg = path.slice(segStart, i)
      segStart = i + 1
      if seg == "" || seg == "." {
        // skip
      } else if seg == ".." {
        if segs.length > 0 && segs[segs.length - 1] != ".." {
          // Drop the last segment (rebuild — a bare `.pop()` STATEMENT is an
          // emit gap in the native pipeline; this stays on the lowered path).
          const trimmed: string[] = []
          let ti = 0
          while ti < segs.length - 1 {
            trimmed.push(segs[ti])
            ti = ti + 1
          }
          segs = trimmed
        } else {
          segs.push("..")
        }
      } else {
        segs.push(seg)
      }
    }
    i = i + 1
  }
  let out = ""
  let s = 0
  while s < segs.length {
    if s > 0 { out = out + "/" }
    out = out + segs[s]
    s = s + 1
  }
  if absolute { return "/" + out }
  out
}
// The key a module's stable id hashes: a `std:` key as written, else the normalised path
// relative to the module's staged project root, or absolute when it has none. A host that
// stages no root gets the path relative to the staged working directory.
function modIdKeyOf(key: string): string {
  if modKeyIsStd(key) { return key }
  let abs = key
  if !modSpecAbsolute(key) && vlCwd.length > 0 { abs = vlCwd + "/" + key }
  abs = modNormalize(abs)
  const root = modRootOfKey[key]
  let p = vlCwd
  if root != null { p = root }
  if p.length == 0 { return abs }
  if p[p.length - 1] != '/' { p = p + "/" }
  if abs.length > p.length && abs.slice(0, p.length) == p {
    return abs.slice(p.length, abs.length)
  }
  abs
}
// Gives every module of this graph its merge suffix, a function of its own key alone.
function modIdAssignKeys() {
  const ks: string[] = []
  for k in modKeys { ks.push(modIdKeyOf(k)) }
  let entry = ""
  if modKeys.length > 0 && !modKeyIsStd(modKeys[0]) { entry = modKeys[0] }
  if entry.length > 0 && !modSpecAbsolute(entry) && vlCwd.length > 0 {
    entry = vlCwd + "/" + entry
  }
  modIdAssign(ks, modDirOf(modNormalize(entry)))
  0
}
// Resolves `spec` written in the module at `fromKey` to a key, or "" for a kind
// the resolver rejects (bare, malformed `std:`, or relative-inside-std — a std
// module has no directory to resolve `./x` against). A well-formed `std:` specifier
// is its key verbatim; a relative spec gets `.vl` appended.
function modResolveSpecifier(spec: string, fromKey: string): string {
  if modIsStdSpec(spec) { return spec }
  if !modIsRelative(spec) || modSpecBackslashed(spec) { return "" }
  if modKeyIsStd(fromKey) { return "" }
  const base = modDirOf(fromKey)
  let joined = spec
  if base != "" { joined = base + "/" + spec }
  modNormalize(joined) + ".vl"
}

// ── token-level import/export scan (per committed module) ─────────────────────
// Tokenizes the committed source and walks top-level tokens (brace-depth tracked):
// each import records one entry per specifier, each exported declaration records a
// name. A clean tokenization is banked and `vcLoadToksMod` replays it instead.

// One `export`-marked declaration recorded for module `m`. The declared NAME token sits at
// `i + dOff + 1`, and the `export` keyword's own span is the target of the redundant-export
// hint (an export used locally but imported nowhere).
function modExportRecord(
  m: i32,
  name: string,
  nameLine: i32,
  nameCol: i32,
  kwLine: i32,
  kwCol: i32,
) {
  expMod.push(m)
  expName.push(name)
  expDeclLine.push(nameLine)
  expDeclCol.push(nameCol)
  expKwLine.push(kwLine)
  expKwCol.push(kwCol)
  0
}

// How far past `export` its declaration keyword sits, given the next two tokens: 2 past a
// `flat` before `type`, or an `extern` before `function`/`let`/`const`; else 1. `more` says
// a token follows the second, so a declared name can exist.
function modExportDeclOff(
  k1: TokKind,
  t1: string,
  k2: TokKind,
  more: boolean,
): i32 {
  const flat = k1 == "IDENT" && t1 == "flat" && k2 == "TYPE"
  const ext = k1 == "EXTERN" && k2 != "TYPE" && modExportDeclKind(k2)
  if more && (flat || ext) { return 2 }
  1
}

// The brace depth change token kind `k` makes: +1 for `{`, -1 for `}`, else 0.
function modBraceStep(k: TokKind): i32 {
  const open = k == "LBRACE"
  const close = k == "RBRACE"
  if open { return 1 }
  if close { return -1 }
  0
}

// Whether `k` opens a declaration an `export` names.
function modExportDeclKind(k: TokKind): boolean {
  k == "FUNCTION" || k == "LET" || k == "CONST" || k == "TYPE"
}

// The names `src` exports by a top-level declaration, as `modScan` records them, for a file
// outside the module graph; null when it does not lex. Re-exports are not included.
export function modExportNamesOf(src: string): string[] | null {
  const out: string[] = []
  const r = tokenize(src)
  if r.diags.length > 0 { return null }
  const toks = r.tokens
  let depth = 0
  let i = 0
  while i < toks.length {
    const k = toks[i].kind
    depth = depth + modBraceStep(k)
    if k == "EXPORT" && depth == 0 && i + 2 < toks.length {
      const dOff = modExportDeclOff(
        toks[i + 1].kind,
        toks[i + 1].text,
        toks[i + 2].kind,
        i + 3 < toks.length,
      )
      if i + dOff + 1 < toks.length && modExportDeclKind(toks[i + dOff].kind) {
        out.push(toks[i + dOff + 1].text)
      }
    }
    i = i + 1
  }
  out
}

function modScan(m: i32, src: string): i32 {
  const r = tokenize(src)
  const toks = r.tokens
  modScanTokN = -1
  modScanDocOff = -1
  modScanDocEnd = -1
  if r.diags.length == 0 {
    modScanToks = toks
    modScanTokN = toks.length
    // This lex is the only one most modules get, so the `///` rows are banked here on the
    // same gate the tokens are — see `modCacheDocOff`.
    modScanDocOff = modCacheDocLine.length
    let dc = 0
    while dc < r.comments.length {
      const cm = r.comments[dc]
      if cm.doc && !cm.trailing {
        modCacheDocLine.push(cm.line)
        modCacheDocText.push(cm.text)
      }
      dc = dc + 1
    }
    modScanDocEnd = modCacheDocLine.length
  }
  let depth = 0
  let sawTplHole = false
  let i = 0
  while i < toks.length {
    const k = toks[i].kind
    if k == "TEMPLATE_HEAD" {
      // A template with at least one HOLE. Its desugared render call names a
      // `std:fmt` export, so this module needs `std:fmt` in the merged program —
      // recorded below as a bare edge, after the real imports are scanned.
      sawTplHole = true
      i = i + 1
    } else if k == "LBRACE" {
      depth = depth + 1
      i = i + 1
    } else if k == "RBRACE" {
      depth = depth - 1
      i = i + 1
    } else if k == "IMPORT" && depth == 0 {
      i = modScanImport(m, toks, i)
    } else if k == "EXPORT" && depth == 0 {
      if i + 1 < toks.length && toks[i + 1].kind == "LBRACE" {
        i = modScanReExport(m, toks, i)
      } else if i + 2 < toks.length {
        // `export flat type N = { … }` puts a contextual keyword between `export`
        // and the declaration keyword, so the declared name is one token further
        // along. This token-level scanner runs before any parse, so it must
        // recognize the `flat`/`type` pair itself, the same guard the parser uses.
        const dOff = modExportDeclOff(
          toks[i + 1].kind,
          toks[i + 1].text,
          toks[i + 2].kind,
          i + 3 < toks.length,
        )
        const dk = toks[i + dOff].kind
        if modExportDeclKind(dk) {
          const dnt = toks[i + dOff + 1]
          modExportRecord(
            m,
            dnt.text,
            dnt.line,
            dnt.col,
            toks[i].line,
            toks[i].col,
          )
        }
        i = i + 1
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  // ── the injected import ────────────────────────────────────────────────────
  // A module holding a template hole gets a `std:fmt` dependency it never wrote,
  // the same row shape a bare import pushes but with `impName`/`impLocal` both
  // empty — the no-pollution mechanism. Every `imp*` column is still pushed.
  if sawTplHole && modKeys[m] != TPL_RENDER_MODULE {
    impMod.push(m)
    impSpec.push(TPL_RENDER_MODULE)
    impKey.push(TPL_RENDER_MODULE)
    impName.push("")
    impLocal.push("")
    impNameLine.push(1)
    impNameCol.push(0)
    impSpecLine.push(1)
    impSpecCol.push(0)
    impSpecEnd.push(0)
    impSpecChar.push(0)
  }
  0
}

// `modScan`'s import arm, from the `import` keyword at `kw`: one `import { a as b, … } from
// "spec"` row per specifier (`as` honored), or one row with empty names for a specifier-less
// import. Returns the token index past the path string.
function modScanImport(m: i32, toks: Tok[], kw: i32): i32 {
  let i = kw
  const kwLine = toks[i].line
  const kwCol = toks[i].col
  i = i + 1
  const names: string[] = []
  const locals: string[] = []
  const nameLines: i32[] = []
  const nameCols: i32[] = []
  if i < toks.length {
    if toks[i].kind == "LBRACE" {
      i = i + 1
      let going = true
      while going && i < toks.length {
        const ck = toks[i].kind
        if ck == "RBRACE" {
          i = i + 1
          going = false
        } else {
          if ck == "IDENT" {
            const nm = toks[i].text
            let loc = nm
            nameLines.push(toks[i].line)
            nameCols.push(toks[i].col)
            if i + 2 < toks.length {
              if (
                toks[i + 1].kind == "IDENT"
                && toks[i + 1].text == "as"
                && toks[i + 2].kind == "IDENT"
              ) {
                loc = toks[i + 2].text
                i = i + 2
              }
            }
            names.push(nm)
            locals.push(loc)
          }
          i = i + 1
        }
      }
    }
  }
  // Forwards to the path string (the `from` keyword rides as an ident), then
  // strips its surrounding quotes. Bounded exactly as `parseImport` bounds its
  // own walk (a newline, semi, or statement-start keyword ends it) — unbounded,
  // a mis-lexed single-quoted specifier would adopt the next string in the file.
  let spec = ""
  let specLine = kwLine
  let specCol = kwCol
  let specEnd = kwCol
  let specChar = SPEC_ABSENT
  let scanning = true
  while scanning && i < toks.length {
    const sk = toks[i].kind
    if sk == "STRING" {
      spec = toks[i].text
      specLine = toks[i].line
      specCol = toks[i].col
      specEnd = toks[i].col + toks[i].text.length
      specChar = SPEC_STRING
      if spec.length >= 2 {
        if spec[0] == '"' && spec[spec.length - 1] == '"' {
          spec = spec.slice(1, spec.length - 1)
        }
      }
      i = i + 1
      scanning = false
    } else if sk == "CHAR" {
      // A char literal in the specifier slot. Recorded, not skipped: it is not
      // a resolvable key, and the reader needs to be told THAT rather than
      // that the import has no specifier at all. `spec` carries the RAW
      // lexeme, which is what `importSpecCharMsg` re-quotes.
      spec = toks[i].text
      specLine = toks[i].line
      specCol = toks[i].col
      specEnd = toks[i].col + toks[i].text.length
      specChar = SPEC_CHAR
      i = i + 1
      scanning = false
    } else if sk == "EOF" || sk == "NEWLINE" || sk == "SEMI" {
      scanning = false
    } else if isStmtKeyword(sk) {
      scanning = false
    } else {
      i = i + 1
    }
  }
  let key = ""
  if specChar == SPEC_STRING { key = modResolveSpecifier(spec, modKeys[m]) }
  let n = 0
  while n < names.length {
    impMod.push(m)
    impSpec.push(spec)
    impKey.push(key)
    impName.push(names[n])
    impLocal.push(locals[n])
    impNameLine.push(nameLines[n])
    impNameCol.push(nameCols[n])
    impSpecLine.push(specLine)
    impSpecCol.push(specCol)
    impSpecEnd.push(specEnd)
    impSpecChar.push(specChar)
    n = n + 1
  }
  if names.length == 0 {
    impMod.push(m)
    impSpec.push(spec)
    impKey.push(key)
    impName.push("")
    impLocal.push("")
    impNameLine.push(kwLine)
    impNameCol.push(kwCol)
    impSpecLine.push(specLine)
    impSpecCol.push(specCol)
    impSpecEnd.push(specEnd)
    impSpecChar.push(specChar)
  }
  i
}

// `modScan`'s re-export arm, from the `export` before `{` at `kw`: scanned like an import's
// name list, and each entry is also recorded as a public re-export under its local binding
// (the `as` alias, else the name). Returns the token index past the path string.
function modScanReExport(m: i32, toks: Tok[], kw: i32): i32 {
  let i = kw
  const rkwLine = toks[i].line
  const rkwCol = toks[i].col
  i = i + 2 // past EXPORT and LBRACE
  const rnames: string[] = []
  const rlocals: string[] = []
  const rnameLines: i32[] = []
  const rnameCols: i32[] = []
  // The PUBLIC token's own span (the `as` alias when there is one), which the
  // editor surface underlines. Separate from `rnameLines`/`rnameCols` — those
  // anchor the import row, whose name is the SOURCE half of an alias.
  const rpubLines: i32[] = []
  const rpubCols: i32[] = []
  let rgoing = true
  while rgoing && i < toks.length {
    const ck = toks[i].kind
    if ck == "RBRACE" {
      i = i + 1
      rgoing = false
    } else {
      if ck == "IDENT" {
        const nm = toks[i].text
        let loc = nm
        rnameLines.push(toks[i].line)
        rnameCols.push(toks[i].col)
        let pubLine = toks[i].line
        let pubCol = toks[i].col
        if i + 2 < toks.length {
          if (
            toks[i + 1].kind == "IDENT"
            && toks[i + 1].text == "as"
            && toks[i + 2].kind == "IDENT"
          ) {
            loc = toks[i + 2].text
            pubLine = toks[i + 2].line
            pubCol = toks[i + 2].col
            i = i + 2
          }
        }
        rpubLines.push(pubLine)
        rpubCols.push(pubCol)
        rnames.push(nm)
        rlocals.push(loc)
      }
      i = i + 1
    }
  }
  // BOUNDED and CHAR-aware for the same reasons the import arm above is —
  // `export { a } from 'dep'` stole the next string literal too.
  let rspec = ""
  let rspecLine = rkwLine
  let rspecCol = rkwCol
  let rspecEnd = rkwCol
  let rspecChar = SPEC_NO_FROM
  let rscan = true
  while rscan && i < toks.length {
    const sk = toks[i].kind
    if sk == "STRING" {
      rspec = toks[i].text
      rspecLine = toks[i].line
      rspecCol = toks[i].col
      rspecEnd = toks[i].col + toks[i].text.length
      rspecChar = SPEC_STRING
      if rspec.length >= 2 {
        if rspec[0] == '"' && rspec[rspec.length - 1] == '"' {
          rspec = rspec.slice(1, rspec.length - 1)
        }
      }
      i = i + 1
      rscan = false
    } else if sk == "CHAR" {
      rspec = toks[i].text
      rspecLine = toks[i].line
      rspecCol = toks[i].col
      rspecEnd = toks[i].col + toks[i].text.length
      rspecChar = SPEC_CHAR
      i = i + 1
      rscan = false
    } else if sk == "EOF" || sk == "NEWLINE" || sk == "SEMI" {
      rscan = false
    } else if isStmtKeyword(sk) {
      rscan = false
    } else {
      if sk == "IDENT" && toks[i].text == "from" { rspecChar = SPEC_ABSENT }
      i = i + 1
    }
  }
  let rkey = ""
  if rspecChar == SPEC_STRING { rkey = modResolveSpecifier(rspec, modKeys[m]) }
  let rn = 0
  while rn < rnames.length {
    // Pull the symbol (an import edge) so the merge binds it and the host fetches `spec`.
    impMod.push(m)
    impSpec.push(rspec)
    impKey.push(rkey)
    impName.push(rnames[rn])
    impLocal.push(rlocals[rn])
    impNameLine.push(rnameLines[rn])
    impNameCol.push(rnameCols[rn])
    impSpecLine.push(rspecLine)
    impSpecCol.push(rspecCol)
    impSpecEnd.push(rspecEnd)
    impSpecChar.push(rspecChar)
    // Record the PUBLIC re-export (its merged target is resolved in `modCompile`).
    reExpMod.push(m)
    reExpPublic.push(rlocals[rn])
    reExpLocal.push(rlocals[rn])
    reExpNameLine.push(rpubLines[rn])
    reExpNameCol.push(rpubCols[rn])
    reExpKwLine.push(rkwLine)
    reExpKwCol.push(rkwCol)
    reExpKey.push(rkey)
    rn = rn + 1
  }
  i
}

// ── where a template hole's renderer comes from ───────────────────────────────
// A template binds absolutely: `` `n=${x}` `` means the same thing in every file
// regardless of what it imports, so the renderer is named here and never looked
// up in the user's scope (a string literal's meaning must not depend on imports).
const TPL_RENDER_MODULE = "std:fmt"
const TPL_RENDER_EXPORT = "toString"

function modIndexOfKey(key: string): i32 { modKeyIx[key] ?? -1 }
// Keeps `modPending` as the unresolved import keys in first-import order. Both tables only
// grow until `modReset`, so only the imports since the last call are read, and a key once
// resolved leaves the list for good.
function modRecomputePending(): i32 {
  while modPendScanned < impKey.length {
    const k = impKey[modPendScanned]
    if k != "" && modPendSeen[k] == null {
      modPendSeen[k] = 1
      if modIndexOfKey(k) < 0 { modPending.push(k) }
    }
    modPendScanned = modPendScanned + 1
  }
  const left: string[] = []
  for k in modPending {
    if modIndexOfKey(k) < 0 { left.push(k) }
  }
  modPending = left
  0
}

// ── module pipeline (order/validate → parse-merge → rename/rewrite) ───────────
// DFS state lives at the top of this file: 0 unvisited, 1 loading (a back-edge
// is a cycle), 2 done. Records one module-resolution diagnostic, deduped on
// (module, message): the same missing module imported by two files is two findings.
let modDiagLine: i32[] = []
let modDiagCol: i32[] = []
let modDiagEnd: i32[] = []
let modDiagMod: i32[] = []
function modDiag(m: i32, line: i32, col: i32, msg: string): i32 {
  modDiagSpan(m, line, col, col, msg)
}
// `modDiag` with a SPAN — `[col, endCol)` on `line`, for a report whose subject is
// a whole lexeme the reader has to see (the specifier token). These diagnostics
// are tokenless, so the span cannot be derived downstream; `endCol == col` is the
// point rendering every other module report keeps.
function modDiagSpan(
  m: i32,
  line: i32,
  col: i32,
  endCol: i32,
  msg: string,
): i32 {
  let i = 0
  while i < modDiags.length {
    if modDiagMod[i] == m && modDiags[i] == msg { return 0 }
    i = i + 1
  }
  modDiags.push(msg)
  modDiagLine.push(line)
  modDiagCol.push(col)
  modDiagEnd.push(endCol)
  modDiagMod.push(m)
  0
}
// The refusal for `export { name }` / `export { name as pub }` with no `from`. An export
// list only re-exports, so when `m` imports `name` the message spells the re-export of
// that same binding; otherwise it points at the declaration-site `export` keyword.
function modExportListNoFromMsg(m: i32, name: string, pub: string): string {
  let head = "`export { " + name + " }`"
  if pub != name { head = "`export { " + name + " as " + pub + " }`" }
  let j = 0
  while j < impMod.length {
    if (
      impMod[j] == m
      && impLocal[j] == name
      && impName[j] != ""
      && impSpecChar[j] == SPEC_STRING
    ) {
      let src = impName[j]
      if src != pub { src = src + " as " + pub }
      return head
        + " names an imported binding; re-export it with `export { "
        + src
        + " } from \""
        + impSpec[j]
        + "\"`"
    }
    j = j + 1
  }
  head
    + " has no `from` — an export list only re-exports another module's names; to export `"
    + name
    + "` from this module, write `export` on its declaration"
}
// Whether `name` is part of module `m`'s public surface — the union of two tables:
// `expName` for a plain `export` declaration, `reExpPublic` for a re-export. Kept
// separate rather than merged, since `expName` also means "declared with the
// keyword here" for go-to-definition. Visibility is the union, provenance is not.
function modExportsHas(m: i32, name: string): boolean {
  // A re-export publishes its PUBLIC name (`reExpPublic` — the `as` alias, else the
  // source name), so `export { a as b } from "dep"` surfaces `b` and NOT `a`.
  modDeclExports(m, name) || i32ListHas(expReByNow()[name] ?? [], m)
}
// Whether module `m` declares `name` with the `export` keyword (an `expName` row).
function modDeclExports(m: i32, name: string) {
  while expOwnRead < expMod.length {
    expByAdd(expOwnBy, expName[expOwnRead], expMod[expOwnRead])
    expOwnRead = expOwnRead + 1
  }
  i32ListHas(expOwnBy[name] ?? [], m)
}
// `expReBy` brought up to every `reExpPublic` row.
function expReByNow(): {[string]: i32[]} {
  while expReRead < reExpMod.length {
    expByAdd(expReBy, reExpPublic[expReRead], reExpMod[expReRead])
    expReRead = expReRead + 1
  }
  expReBy
}
function expByAdd(by: {[string]: i32[]}, name: string, m: i32) {
  const ms = by[name] ?? []
  ms.push(m)
  by[name] = ms
  0
}
// The merged (mangled) name of the declaration that module `m`'s public `name`
// ultimately denotes. When `m` re-exports rather than declares it, follows the
// chain to the declaring module, so `A declares, B re-exports from A, C from B`
// resolves to A's mangled name rather than an undefined `name$mC`. Bounded by MOD_DEPTH_MAX.
function modMergedTargetOf(m: i32, name: string): string {
  const o = modExportOrigin(m, name)
  o.oName + modSuffixOf(o.oMod)
}
// The declaring module and source name behind module `m`'s public `name`, by the same chase.
type ModOrigin = { oMod: i32, oName: string }
function modExportOrigin(m: i32, name: string): ModOrigin {
  let cm = m
  let cn = name
  let hops = 0
  while hops < MOD_DEPTH_MAX {
    let nextMod = -1
    let nextName = ""
    let r = 0
    while r < reExpMod.length && nextMod < 0 {
      if reExpMod[r] == cm && reExpPublic[r] == cn {
        let ii = 0
        while ii < impMod.length && nextMod < 0 {
          if (
            impMod[ii] == cm
            && impLocal[ii] == reExpLocal[r]
            && impName[ii] != ""
          ) {
            const dd = modIndexOfKey(impKey[ii])
            if dd >= 0 {
              nextMod = dd
              nextName = impName[ii]
            }
          }
          ii = ii + 1
        }
      }
      r = r + 1
    }
    if nextMod < 0 { return { oMod: cm, oName: cn } }
    cm = nextMod
    cn = nextName
    hops = hops + 1
  }
  { oMod: cm, oName: cn }
}
// Visits module `m`: resolves and validates its imports (unsupported specifier,
// unresolvable key, cycle back-edge, name-not-exported), recursing into deps first.
// The DFS recurses once per import-chain link, so an adversarially deep chain is
// capped with a real diagnostic instead of overflowing the wasm call stack.
const MOD_DEPTH_MAX = 256
function modVisit(m: i32, depth: i32): i32 {
  modState[m] = 1
  let i = 0
  while i < impMod.length {
    if impMod[i] == m {
      const spec = impSpec[i]
      const key = impKey[i]
      if key == "" {
        // Texts mirror the host's `loadProgram` — keep them aligned. Spec-shaped
        // problems anchor at the specifier STRING token of THIS import.
        if impSpecChar[i] == SPEC_CHAR {
          // A CHAR literal where the specifier belongs — the parser's sentence,
          // shared (`importSpecCharMsg`), because the two scanners must agree.
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            importSpecCharMsg(spec),
          )
        } else if impSpecChar[i] == SPEC_NO_FROM {
          modDiagSpan(
            m,
            impNameLine[i],
            impNameCol[i],
            impNameCol[i] + impName[i].length,
            modExportListNoFromMsg(m, impName[i], impLocal[i]),
          )
        } else if impSpecChar[i] == SPEC_ABSENT {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "missing module path — write `from \"./util\"` or `from \"std:math\"` after the name list",
          )
        } else if modKeyIsStd(modKeys[m]) && modIsRelative(spec) {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Unsupported import specifier \""
              + spec
              + "\" — std modules import only via `std:` specifiers (relative imports inside std are not allowed)",
          )
        } else if modSpecAbsolute(spec) {
          // An absolute path would key the same file apart from its relative spelling, so it
          // could load as two modules; refused until keys are canonical paths.
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Unsupported import specifier \""
              + spec
              + "\" — an absolute path is not an import specifier; write the path relative to this file (`./`, `../`)",
          )
        } else if modSpecBackslashed(spec) && !modKeyIsStd(spec) {
          // A Windows-style separator: the specifier means the forward-slash path.
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Unsupported import specifier \""
              + spec
              + "\" — an import path uses forward slashes: write \""
              + modSlashed(spec)
              + "\"",
          )
        } else {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Unsupported import specifier \""
              + spec
              + "\" — supported: relative paths (`./`, `../`) and `std:` modules; bare specifiers are not yet implemented",
          )
        }
      } else {
        const d = modIndexOfKey(key)
        if d < 0 {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Cannot resolve import \"" + spec + "\" (no module \"" + key + "\")",
          )
        } else if modFound[d] == 0 {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Cannot resolve import \"" + spec + "\" (no module \"" + key + "\")",
          )
        } else if modState[d] == 1 {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Import cycle detected through \""
              + spec
              + "\" (module \""
              + key
              + "\")",
          )
        } else {
          if modState[d] == 0 {
            if depth >= MOD_DEPTH_MAX {
              modDiagSpan(
                m,
                impSpecLine[i],
                impSpecCol[i],
                impSpecEnd[i],
                "Import chain exceeds the maximum depth ("
                  + i32ToStr(MOD_DEPTH_MAX)
                  + ") at \""
                  + spec
                  + "\" (module \""
                  + key
                  + "\")",
              )
            } else {
              modVisit(d, depth + 1)
            }
          }
          if impName[i] != "" {
            if !modExportsHas(d, impName[i]) {
              // A name-shaped problem anchors at the imported NAME token.
              modDiag(
                m,
                impNameLine[i],
                impNameCol[i],
                "\""
                  + impName[i]
                  + "\" is not exported by \""
                  + spec
                  + "\""
                  + modNotExportedNote(m, d, impName[i], spec),
              )
            }
          }
        }
      }
    }
    i = i + 1
  }
  modState[m] = 2
  modOrder.push(m)
  0
}
// The tail of the not-exported refusal for `name` imported by module `m` from module `d`
// as `spec`: the builtin note, else the modules that do export it, else `d`'s near misses.
// One exporter is recorded for `check --fix`, which moves the name to that module's import.
function modNotExportedNote(
  m: i32,
  d: i32,
  name: string,
  spec: string,
): string {
  const builtin = modBuiltinImportNote(name)
  if builtin != "" { return builtin }
  const specs = mimpSpecsFor(name, m, d)
  if specs.length > 0 {
    if specs.length == 1 { mimpNoteMoved(m, name, spec, specs[0]) }
    return mimpExportedByNote(name, specs, m)
  }
  const near = mimpNearMisses(name, d)
  if near.length == 0 { return "" }
  let out = " — did you mean `" + near[0] + "`"
  let i = 1
  while i < near.length {
    if i == near.length - 1 { out = out + " or `" } else { out = out + ", `" }
    out = out + near[i] + "`"
    i = i + 1
  }
  out + "?"
}

// Fills the missing-import index for this graph, once, before any diagnostic can ask it.
// A re-export joins only when its origin exports no such name, i.e. under a new name;
// otherwise it names a declaration already indexed, and the declaring module is the answer.
function modMissingImportIndex() {
  mimpBegin(modKeys, impMod, impKey, impSpec)
  let e = 0
  while e < expMod.length {
    mimpAddExport(expName[e], expMod[e])
    e = e + 1
  }
  let r = 0
  while r < reExpMod.length {
    const origin = modIndexOfKey(reExpKey[r])
    if origin < 0 || !modExportsHas(origin, reExpPublic[r]) {
      mimpAddExport(reExpPublic[r], reExpMod[r])
    }
    r = r + 1
  }
  0
}

// The tail of the not-exported refusal when the name is a builtin, which no module exports
// because every module already sees it (D3621); "" for any other name.
function modBuiltinImportNote(name: string): string {
  if !isBuiltinCallName(name) { return "" }
  " — `" + name + "` is a builtin and needs no import; remove it from this list"
}

// `modCompile`'s step 1: orders and validates the graph by a DFS from the entry (table index 0).
// Returns 1 when that left resolution diagnostics, banked tokenless, and 0 otherwise.
function modOrderGraph(): i32 {
  modState = []
  modOrder = []
  modDiags = []
  modDiagLine = []
  modDiagCol = []
  modDiagEnd = []
  modDiagMod = []
  let s = 0
  while s < modKeys.length {
    modState.push(0)
    s = s + 1
  }
  modMissingImportIndex()
  modVisit(0, 0)
  if modDiags.length > 0 {
    // Tokenless (no tokens are loaded yet): position, span + owner ride the
    // `vcDg*` side table, keyed on each entry's `P.diags` index.
    let d = 0
    while d < modDiags.length {
      vcDgPush(
        P.diags.length,
        modDiagLine[d],
        modDiagCol[d],
        modDiagEnd[d],
        modDiagMod[d],
      )
      P.diags.push({ msg: modDiags[d], at: -1 })
      d = d + 1
    }
    modResolveDiagN = modDiags.length
    return 1
  }
  0
}

// `modCompile`'s step 2: parses each module dependency-first into the SHARED arena, every one
// even past a failure so one run reports every file's syntax errors. Tokens append to `P.toks`
// and each `parseProgram` starts at its own module's first token. Returns the roots in
// `modOrder`'s order.
function modParseAll(): i32[] {
  const roots: i32[] = []
  modLoadStart = []
  modLoadMod = []
  // The same ranges, in the leaf both `modOfTok` and the emitter's name section read.
  srcmapReset()
  srcmapSetKeys(modKeys)
  // The doc table is cleared here, not in `vcLoadToks`: that clear keys on an empty
  // `P.toks`, and a module served from the cache never calls it, so the previous program's
  // rows would answer this one's queries (D1863).
  docCmtLine = []
  docCmtText = []
  docCmtMod = []
  parseImageBegin()
  let o = 0
  while o < modOrder.length {
    const m = modOrder[o]
    let piSpan: i32[] = []
    if parseImageArmed() { piSpan = parseImageOpen() }
    P.pos = P.toks.length
    // Record where this module's tokens begin so an occurrence's token maps back
    // to its module (`modOfTok`) for cross-file find-references.
    modLoadStart.push(P.toks.length)
    modLoadMod.push(m)
    srcmapPush(P.toks.length, m)
    vcLoadMod = m
    // The module every `extern function` this parse declares belongs to — its declaration is
    // banked outside the arena, so it cannot carry a token the merge could read it off later.
    externSetMod(m)
    const pbo = parseBankOpen(modOneShot)
    vcLoadToksMod(m)
    // A module's image carries the parse flags it set itself; the earlier modules' merge back after.
    const flagsBefore = parseFlagsTake()
    // An unchanged module replays its banked parse instead of parsing again (`parse_bank.vl`).
    let root = parseBankServe(modKeys[m], modSrcs[m], pbo, false)
    if root < 0 {
      root = parseProgram()
      parseBankKeep(modKeys[m], modSrcs[m], pbo, root)
    }
    roots.push(root)
    if piSpan.length > 0 { parseImageClose(piSpan, modIdKeyOf(modKeys[m])) }
    parseFlagsMerge(flagsBefore)
    o = o + 1
  }
  vcLoadMod = 0
  roots
}

// `modCompile`'s step 2b: the reserved-name rules over each module's declarations and imports,
// in the pre-rename window — after `modBuildRename` a declared name is `f64$mN` and there is
// nothing left to recognise. Duplicate bindings are `modCheckOverloads`'s, after the rewrite.
function modCheckReservedAll(roots: i32[]) {
  modImpRowsBuild()
  let dc = 0
  while dc < modOrder.length {
    modCheckReservedDecls(roots[dc])
    let tEnd = P.toks.length
    if dc + 1 < modLoadStart.length { tEnd = modLoadStart[dc + 1] }
    modCheckReservedImports(modOrder[dc], roots[dc], modLoadStart[dc], tEnd)
    dc = dc + 1
  }
}

// `modCompile`'s steps 3 and 4: each module's rename map and scope-aware arena rewrite. Every
// top-level `self`-function is registered under its mangled name first, across ALL modules, so
// a UFCS member-call resolves its callee through the merge.
function modRewriteAll(roots: i32[]) {
  ufcsAliasReset()
  ufcsImpReset()
  // D1571's set spans every module of ONE program, so it is cleared with the other
  // program-scoped merge state and refilled by the collect pass below.
  modBuiltinTyTargets = []
  modCanonTo = Map()
  modCollectSelfFns(roots)
  let o2 = 0
  while o2 < modOrder.length {
    modRenameReplay(o2)
    // D1191 — the module's own UFCS SCOPE, and its arena boundary. Both are read
    // where a UFCS name is resolved away from a banked call site, so a candidate
    // is one the CALLER binds rather than one any module happened to bank.
    modBankUfcsScope(modOrder[o2])
    ufcsModBoundAdd(modOrder[o2], roots[o2])
    modNoteOverloads(modOrder[o2])
    modShadow = []
    modShadowTo = []
    modTyShadow = []
    modRwMod = modOrder[o2]
    modAmbMod = modOrder[o2]
    modRwStmt(roots[o2])
    o2 = o2 + 1
  }
  modRwMod = -1
  modRenameKeptTo = []
  modRenameKeptFrom = []
  modRenameKeptSid = []
}

// `modCompile`'s step 4b: resolves each of the root module's re-exports to its merged target,
// aliasing the bare `name` onto it in the export section. A dependency's re-export is its own
// surface; aliasing it would leak a bare dependency name into the entry's wasm ABI.
function modResolveRootReExports() {
  reExpName = []
  reExpTarget = []
  let re = 0
  while re < reExpMod.length {
    const rm = reExpMod[re]
    const rloc = reExpLocal[re]
    let ii2 = 0
    // A dependency's re-export (`rm != 0`) publishes to its importers, not to the ABI:
    // start the scan already `done` so its row contributes no alias.
    let done = true
    if rm == 0 { done = false }
    while ii2 < impMod.length && !done {
      if impMod[ii2] == rm && impLocal[ii2] == rloc && impName[ii2] != "" {
        const dd = modIndexOfKey(impKey[ii2])
        if dd >= 0 {
          reExpName.push(reExpPublic[re])
          // NOT `impName[ii2]$mdd`: `dd` may itself only RE-EXPORT the name, in
          // which case that target names nothing. Chase to the declaring module.
          reExpTarget.push(modMergedTargetOf(dd, impName[ii2]))
        }
        done = true
      }
      ii2 = ii2 + 1
    }
    re = re + 1
  }
}

// `modCompile`'s step 4c: the root module's plain `export`-marked declarations surface under
// their bare names too, appended to the re-export alias tables. The emitter exports only those
// tables, so an internal function (a lifted lambda, a mono instance) never leaks into the ABI.
function modAliasRootExports() {
  const rexSeen: {[string]: boolean} = Map()
  let rsi = 0
  while rsi < reExpName.length {
    rexSeen[reExpName[rsi]] = true
    rsi = rsi + 1
  }
  let rex = 0
  while rex < expMod.length {
    if expMod[rex] == 0 && !rexSeen.has(expName[rex]) {
      // An exported EXTERN publishes to VL importers and not to the wasm ABI: there is no
      // local function to forward to, so an alias row would name a target the merge never
      // defines. Its own import entry is what a host sees.
      if (
        externLinkOf(expName[rex] + modSuffixOf(0)) < 0
        && externGlobalLinkOfName(expName[rex] + modSuffixOf(0)) < 0
      ) {
        rexSeen[expName[rex]] = true
        reExpName.push(expName[rex])
        reExpTarget.push(expName[rex] + modSuffixOf(0))
      }
    }
    rex = rex + 1
  }
}

// `modCompile`'s step 5: ONE Program concatenating the modules' statements dependency-first,
// so a dependency's top-level initializers run before its dependents', as in the host. `keep`,
// when not empty, names by module index the modules a skipping check merges (`skPlan`).
function modMergeRoots(roots: i32[], keep: boolean[]): i32 {
  const allStmts: i32[] = []
  let o3 = 0
  while o3 < modOrder.length {
    const r = nodeAt(roots[o3])
    const kept = keep.length == 0 || keep[modOrder[o3]]
    if kept && r is Program {
      const ss = r.progStmts
      let q = 0
      while q < ss.length {
        allStmts.push(ss[q])
        q = q + 1
      }
    }
    o3 = o3 + 1
  }
  mkProgram(allStmts, -1) // synthesized merged-module root (no source token)
}

// The interface hash's token side, per module, between the rewrite and the check (`iface_hash.vl`):
// each module's token range, the locals its imports bind, its exports, and its import edges.
function modIfaceBegin(roots: i32[], tokEnd: i32) {
  ihBegin(modKeys)
  ihSetLean(wiOwnsIh && !skArmed)
  const visibleOf: string[][] = []
  const exportedOf: string[][] = []
  for _ in modKeys {
    visibleOf.push([])
    exportedOf.push([])
  }
  let k = 0
  while k < impMod.length {
    const im = impMod[k]
    if im >= 0 && im < visibleOf.length && impLocal[k] != "" {
      visibleOf[im].push(impLocal[k])
    }
    k = k + 1
  }
  k = 0
  while k < expMod.length {
    const em = expMod[k]
    if em >= 0 && em < exportedOf.length { exportedOf[em].push(expName[k]) }
    k = k + 1
  }
  k = 0
  while k < impMod.length {
    const to = modIndexOfKey(impKey[k])
    if to >= 0 {
      ihEdge(impMod[k], to)
      const nm = skImportName(k)
      if nm == "" {
        ihImport(impMod[k], impLocal[k], to, "")
      } else {
        const o = modExportOrigin(to, nm)
        ihImport(impMod[k], impLocal[k], o.oMod, o.oName)
      }
    }
    k = k + 1
  }
  let o = 0
  while o < modOrder.length {
    const m = modOrder[o]
    let hi = tokEnd
    if o + 1 < modLoadStart.length { hi = modLoadStart[o + 1] }
    let visible: string[] = []
    let exported: string[] = []
    if m >= 0 && m < visibleOf.length {
      visible = visibleOf[m]
      exported = exportedOf[m]
    }
    ihModule(m, roots[o], modLoadStart[o], hi, visible, exported)
    o = o + 1
  }
  ihAmbientScan()
  if !wiOwnsIh || skArmed { ihTokDigests() }
}

// The whole module pipeline behind `compileSrc` (emit = 1) / `checkSrc` (0).
function modCompile(emit: i32): i32 {
  if !skMute {
    skReason = SK_NO_BANK
    skServed = 0
    skAmbMet = 0
    skAmbMoved = 0
    skStage = -1
  }
  modIdAssignKeys()
  if ifaceHashArmed() { ihBegin([]) }
  plusLinksClear()
  vcEtDrop()
  vcEpDrop()
  if modOrderGraph() != 0 { return 1 }
  wiLiveNow = wiLive()
  const roots = modParseAll()
  const parsedToks = P.toks.length
  if modOneShot != 0 { modCacheClear() }
  // The same stage-1 rule the single-source paths use, so a file does not lose
  // type feedback merely by gaining an `import` (see `vcParseBlocked`). The
  // quantifier spans the WHOLE graph — one lossy diagnostic in any module stops
  // the merge for all of them, which is what the shared arena requires anyway.
  if vcParseBlocked() { return 1 }
  if fsAfterParse() < 0 { return 3 }
  modCheckReservedAll(roots)
  if vcParseBlocked() { return 1 }
  modRewriteAll(roots)
  // A duplicate binding is never lossless-flagged, so this stays a hard stop: a name two
  // overlapping declarations share has no answer the checker could improve on.
  modCheckOverloads(roots)
  if vcParseBlocked() { return 1 }
  if ifaceHashArmed() && wiIhWanted() { modIfaceBegin(roots, parsedToks) }
  modResolveRootReExports()
  modAliasRootExports()
  const banking = emit == 0 && skArmed && ifaceHashArmed()
  let keep: boolean[] = []
  if banking { skSelect() }
  if banking && !skMute { keep = skPlan(roots, parsedToks) }
  const merged = modMergeRoots(roots, keep)
  csPreMintLocs()
  expInfSetEntryStd(entryIsStdModule())
  expInfSetReExports(reExpTarget, reExpName)
  recDelivArm(banking || wiLiveNow)
  crAskArm(banking || wiLiveNow)
  // A bank-served check settles only without deep `is` sites, so a walker expansion would be spent.
  if keep.length > 0 { pinDeepIsHold() }
  checkProgram(merged)
  if ifaceHashArmed() && (!wiOwnsIh || skArmed) { ihFinish() }
  checkMemSharedOrigin()
  plusLinksBank()
  if keep.length > 0 && !skSettle(keep, roots) { return SK_RERUN }
  if banking {
    if keep.length == 0 { skGroup() }
    skBankNow(parsedToks, keep)
  }
  // A lossless-recovered graph CHECKS but never BUILDS — same rule as
  // `compileSrc`, and the rc stays 1 so `vl build` behaves exactly as before.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 {
    if wiLiveNow && emit == 0 && keep.length == 0 && !pinDeepIsRan {
      wiBankWhole(roots)
    }
    return 2
  }
  if wiLiveNow && emit == 0 && keep.length == 0 { wiBankWhole(roots) }
  if fsModeOf() == FS_PLAN { return fsPlan(merged) }
  if emit != 0 {
    const rc = emitProgram(merged)
    if rc < 0 { return 3 }
    emitSrcSection()
    emitExternBoolSection()
  }
  0
}

// ── a module check that serves unchanged dependents from a bank (`checkSkipArm`) ────────────
// Armed, a module check banks each module's source, hashes, diagnostics and lint sites, and the
// next checks only S (the edited modules and their imports); a module outside S is served when
// what it imports from S is closed (`skClosed`) and kept its deep hash. The CLI never arms it.
const SK_SERVED = 0
const SK_NO_BANK = 1
const SK_GRAPH = 2
const SK_ALL = 3
const SK_DEMAND = 4
const SK_IFACE = 6
const SK_SPAN = 7
const SK_STRAY = 8
const SK_PASS = 9
const SK_AMBIENT = 10
const SK_FRESH = 11
const SK_DECOR = 12
const SK_WRITER = 13
const SK_RERUN = 99
const SK_READINGS = 9
let skArmed = false
let skMute = false
let skValid = false
let skReason = SK_NO_BANK
let skServed = 0
let skAmbMet = 0
let skAmbMoved = 0
let skStage = -1
let skKeys: string[] = []
let skKeyIx: {[string]: i32} = Map()
let skSrcs: string[] = []
let skHash: i32[] = []
// Each (importer, origin) pair's reach (`ihReachOf`), keyed by both module keys.
let skReach: {[string]: i32} = Map()
// Each fresh value a check delivered, by its declaring module's key and source name
// (`SK_UNATTRIBUTED` for a delivery it could not place): every module delivering it, with
// SK_KEPT when one delivery builds it at another storage, SK_OWN when one hands it on at
// its own, and 4 when one's judgement read its site count. `skOcc` is `ihOccDigests` of those values over every module.
let skDeliv: {[string]: {[string]: i32}} = Map()
let skOcc: {[string]: i32} = Map()
// Each name a whole-program question asked about, as its kind letter and builder key (`crAskProg`),
// unioned over the checks since a whole one, and `ihWriterDigests` of those names.
let skAsk: string[] = []
let skWr: {[string]: i32} = Map()
// Each write question a statement asked (`crAskQs`), with its answer (`crAskAnswer`) cut to the
// parts a narrowing test in `skUse` could hit; both unioned like `skAsk`.
let skQs: SkQ[] = []
let skUse: {[string]: boolean} = Map()
// Each module's ambient statements (`ihAmbEntries`), by module key.
let skAmb: {[string]: string[][]} = Map()
let skMask = 0
let skPlus: {[i32]: i32}[] = []
let skStrIdx: {[i32]: i32}[] = []
let skScalar: {[i32]: i32}[] = []
// One row per banked diagnostic: its module, its end token relative to the module's first, and
// whether it reads the same wherever another module's tokens move (`skRelocatable`).
let skDgMod: i32[] = []
let skDgEnd: i32[] = []
let skDgReloc: boolean[] = []
let skDg: TDiag[] = []
// Each module's token positions (`ihPosHash`), banked only when some diagnostic is not
// relocatable.
let skPosH: i32[] = []
// The inferred bindings of S a served module imports, which the plan admits only on a plain
// checked type (`ihPlainBinding`), read once the check has run.
let skInferred: i32[] = []
// The `let` statement the last `SK_IF_PLAIN` answer of `skClosed` names.
let skPlainDecl = -1
// The entry key the loaded bank belongs to, and the banks of other entries, newest last, so a
// host checking several entries in turn keeps each one's bank.
let skEntry = ""
type SkBank = {
  bEntry: string,
  bKeys: string[],
  bKeyIx: {[string]: i32},
  bSrcs: string[],
  bHash: i32[],
  bReach: {[string]: i32},
  bDeliv: {[string]: {[string]: i32}},
  bOcc: {[string]: i32},
  bAsk: string[],
  bWr: {[string]: i32},
  bQs: SkQ[],
  bUse: {[string]: boolean},
  bAmb: {[string]: string[][]},
  bMask: i32,
  bPlus: {[i32]: i32}[],
  bStrIdx: {[i32]: i32}[],
  bScalar: {[i32]: i32}[],
  bDgMod: i32[],
  bDgEnd: i32[],
  bDgReloc: boolean[],
  bDg: TDiag[],
  bPosH: i32[],
}
let skParked: SkBank[] = []
const SK_PARK_MAX = 4

// Arm the bank for later `checkSrc` module checks (`on` 1), arming the interface hash with
// it, or disarm it (0). Either way the bank starts empty.
export function checkSkipArm(on: i32): i32 {
  skArmed = on != 0
  skValid = false
  skParked = []
  if skArmed { ifaceHashArm(1) }
  0
}

// Load the bank made for this graph's entry, parking the loaded one when it belongs to another.
function skSelect(): i32 {
  let entry = ""
  if modKeys.length > 0 { entry = modKeys[0] }
  if skValid && skEntry == entry { return 0 }
  const kept: SkBank[] = []
  if skValid {
    for b in skParked {
      if b.bEntry != skEntry { kept.push(b) }
    }
    kept.push(
      {
        bEntry: skEntry,
        bKeys: skKeys,
        bKeyIx: skKeyIx,
        bSrcs: skSrcs,
        bHash: skHash,
        bReach: skReach,
        bDeliv: skDeliv,
        bOcc: skOcc,
        bAsk: skAsk,
        bWr: skWr,
        bQs: skQs,
        bUse: skUse,
        bAmb: skAmb,
        bMask: skMask,
        bPlus: skPlus,
        bStrIdx: skStrIdx,
        bScalar: skScalar,
        bDgMod: skDgMod,
        bDgEnd: skDgEnd,
        bDgReloc: skDgReloc,
        bDg: skDg,
        bPosH: skPosH,
      },
    )
  } else {
    for b in skParked { kept.push(b) }
  }
  skValid = false
  skParked = []
  let i = 0
  if kept.length > SK_PARK_MAX { i = kept.length - SK_PARK_MAX }
  while i < kept.length {
    const b = kept[i]
    if b.bEntry == entry {
      skKeys = b.bKeys
      skKeyIx = b.bKeyIx
      skSrcs = b.bSrcs
      skHash = b.bHash
      skReach = b.bReach
      skDeliv = b.bDeliv
      skOcc = b.bOcc
      skAsk = b.bAsk
      skWr = b.bWr
      skQs = b.bQs
      skUse = b.bUse
      skAmb = b.bAmb
      skMask = b.bMask
      skPlus = b.bPlus
      skStrIdx = b.bStrIdx
      skScalar = b.bScalar
      skDgMod = b.bDgMod
      skDgEnd = b.bDgEnd
      skDgReloc = b.bDgReloc
      skDg = b.bDg
      skPosH = b.bPosH
      skEntry = entry
      skValid = true
    } else {
      skParked.push(b)
    }
    i = i + 1
  }
  0
}

// The position in dependency order of the module type diagnostic `i` is anchored in (the
// entry's when it has no anchor), or -1 for any other diagnostic or a single-source check.
// Listing type diagnostics stably by it gives the same rows whether or not a check served.
export function diagOrderKey(i: i32): i32 {
  const j = i - P.diags.length
  if j < 0 || j >= T.diags.length || modKeys.length == 0 { return -1 }
  let m = skDiagMod(j)
  if m < 0 { m = 0 }
  let o = 0
  while o < modOrder.length {
    if modOrder[o] == m { return o }
    o = o + 1
  }
  -1
}

// The last module check: `which` 0 why it checked what it did (0 when it served some module),
// 1 how many modules it served from the bank, 2 how many served modules hold an ambient statement
// S's check could read, 3 how many S modules' ambient statements moved, 4 whether the guards
// decided before the check of S (0) or after it (1), or -1 when neither ran.
export function checkSkipStat(which: i32): i32 {
  if which == 0 { return skReason }
  if which == 1 { return skServed }
  if which == 2 { return skAmbMet }
  if which == 3 { return skAmbMoved }
  if which == 4 { return skStage }
  -1
}

// The module diagnostic `j` of `T.diags` is anchored in, or -1 when its anchor has no token.
function skDiagMod(j: i32): i32 {
  const nd = T.diags[j].tat
  if nd < 0 || nd >= nodeToks.length { return -1 }
  const tk = nodeToks[nd]
  if tk < 0 || tk >= P.toks.length { return -1 }
  modOfTok(tk)
}

// Each module's position in `modOrder`, by module index.
function skPosOf(): i32[] {
  const pos: i32[] = []
  for _ in modKeys { pos.push(-1) }
  let o = 0
  while o < modOrder.length {
    pos[modOrder[o]] = o
    o = o + 1
  }
  pos
}

// Whether every parameter is annotated and any default is a scalar literal, `null` or
// `__callsite__`: the declaration's check alone types such a default, and a caller reads only
// its annotation.
function skParamsClosed(ps: i32[]): boolean {
  for p in ps {
    const n = nodeAt(p)
    if !(n is Param) { return false }
    if n.parType < 0 { return false }
    const d = n.parDefault
    if (
      d >= 0
      && !skSignedLit(d)
      && !(d < P.nodes.length && nodeAt(d) is NullLit)
      && !paramDefaultIsCallsite(d)
    ) {
      return false
    }
  }
  true
}

// Whether node `e` is a scalar literal, or a number literal under a sign.
function skSignedLit(e: i32): boolean {
  if skScalarLit(e) { return true }
  if e < 0 || e >= P.nodes.length { return false }
  const n = nodeAt(e)
  if !(n is Unary) || (n.unOp != "-" && n.unOp != "+") { return false }
  n.unArg >= 0 && n.unArg < P.nodes.length && nodeAt(n.unArg) is NumLit
}

// Whether node `e` is a number, string, character or boolean literal.
function skScalarLit(e: i32): boolean {
  if e < 0 || e >= P.nodes.length { return false }
  const n = nodeAt(e)
  n is NumLit || n is StrLit || n is CharLit || n is BoolLit
}

// The export import row `k` names, or "" for a bare or namespace import. The template renderer's
// injected row (the only one with no specifier span) names `toString`: its holes call nothing else.
function skImportName(k: i32): string {
  if impName[k] == "" && impSpecEnd[k] == 0 && impKey[k] == TPL_RENDER_MODULE {
    return TPL_RENDER_EXPORT
  }
  impName[k]
}

// Whether declaration `merged` of the module rooted at `root` checks the same whatever imports it,
// given its hash kept: SK_SHUT for a type, an extern, an annotated or (signed) scalar-literal
// binding or one closed non-generic function; SK_IF_PLAIN for another binding; SK_IF_KEPT for one
// closed generic; SK_OPEN for an overload or a parameter `skParamsClosed` does not close.
function skClosed(root: i32, merged: string): i32 {
  let fns = 0
  let gen = false
  let typed = false
  const r = nodeAt(root)
  if r is Program {
    for st in r.progStmts {
      const n = nodeAt(st)
      if n is LetDecl && n.letName == merged {
        if n.letType >= 0 || skSignedLit(n.letInit) { return SK_SHUT }
        skPlainDecl = st
        return SK_IF_PLAIN
      }
      if n is FuncDecl && n.fnName == merged {
        if !skParamsClosed(n.fnParams) { return SK_OPEN }
        if n.fnTyParams.length > 0 { gen = true }
        fns = fns + 1
      }
      if n is TypeDecl && n.tdName == merged { typed = true }
      if n is UnionDecl && n.udName == merged { typed = true }
    }
  }
  if fns > 1 { return SK_OPEN }
  if gen { return SK_IF_KEPT }
  if fns == 1 || typed || externLinkOf(merged) >= 0 { SK_SHUT } else { SK_OPEN }
}

// What `skClosed` answers: the import is open, closed, or closed once its checked type is plain.
const SK_OPEN = 0
const SK_SHUT = 1
const SK_IF_PLAIN = 2
const SK_IF_KEPT = 3

// The mask bits that each drop one guard `skKept` applies, for the suite's mutation witnesses.
const SK_NO_KEPT_SRC = 134217728
const SK_NO_KEPT_DIAG = 268435456
const SK_NO_KEPT_CALL = 536870912
const SK_NO_FRESH_BODY = 65536
const SK_NO_FRESH_OCC = 1073741824
const SK_NO_FRESH_SPLIT = -2147483648
// Shared with the interface hash's mentions bit: the writer-closure guard (`skWriterMoved`).
const SK_NO_WRITER = 16
// Mask bit: the bodies a served module's call may run are not compared (shares IH_NO_CALLEES).
const SK_NO_EFFECT = 2048
// Mask bit: stage 1 reads no row or error of S for an outside type's name or a literal union.
const SK_NO_AMB_ROWS = 32768
const SK_KEPT = 1
const SK_OWN = 2
const SK_UNATTRIBUTED = "?"

// Whether a served module rooted at `root` may keep its banked check across an import of generic
// `merged` from `o`: no module `o`'s check reads moved (`moved`, by module index), the bank holds no
// diagnostic in one, and that module names `merged` only as a callee, so each instance it makes is
// checked at its own call site, at argument types its reach holds.
function skKept(o: i32, merged: string, moved: boolean[], root: i32): boolean {
  const mask = ihMask()
  const seen: boolean[] = []
  for _ in modKeys { seen.push(false) }
  const work: i32[] = [o]
  seen[o] = true
  let w = 0
  while w < work.length {
    const m = work[w]
    if moved[m] && (mask & SK_NO_KEPT_SRC) == 0 { return false }
    let k = 0
    while k < impMod.length {
      const d = modIndexOfKey(impKey[k])
      if impMod[k] == m && d >= 0 && !seen[d] {
        seen[d] = true
        work.push(d)
      }
      k = k + 1
    }
    w = w + 1
  }
  if (mask & SK_NO_KEPT_DIAG) == 0 {
    for b in skDgMod {
      const m = modIndexOfKey(skKeys[b])
      if m >= 0 && seen[m] { return false }
    }
  }
  if (mask & SK_NO_KEPT_CALL) != 0 { return true }
  skCallsOnly(root, merged)
}

// Whether the module rooted at `root` names `merged` only as the callee of a call.
function skCallsOnly(root: i32, merged: string): boolean {
  const stack: i32[] = [root]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is Ident && n.identName == merged { return false }
      let callee = -1
      if n is Call && n.callFn >= 0 && nodeAt(n.callFn) is Ident {
        callee = n.callFn
      }
      for c in nodeChildren(ix) {
        if c != callee { stack.push(c) }
      }
    }
  }
  true
}

// The modules this check must merge, by module index, or none for a whole check: S is every
// module whose source the bank does not hold, closed over its imports. `skReason` says why.
function skPlan(roots: i32[], tokEnd: i32): boolean[] {
  const whole: boolean[] = []
  if !skValid || skMask != ihMask() || fsAsked() || fsModeOf() != FS_COMPILE {
    return whole
  }
  if modKeys.length != skKeys.length {
    skReason = SK_GRAPH
    return whole
  }
  const inS: boolean[] = []
  const moved: boolean[] = []
  const work: i32[] = []
  skInferred = []
  let m = 0
  while m < modKeys.length {
    const b = skKeyIx[modKeys[m]] ?? -1
    if b < 0 {
      skReason = SK_GRAPH
      return whole
    }
    inS.push(modSrcs[m] != skSrcs[b])
    moved.push(inS[m])
    if inS[m] { work.push(m) }
    m = m + 1
  }
  let w = 0
  while w < work.length {
    let k = 0
    while k < impMod.length {
      const d = modIndexOfKey(impKey[k])
      if impMod[k] == work[w] && d >= 0 && !inS[d] {
        inS[d] = true
        work.push(d)
      }
      k = k + 1
    }
    w = w + 1
  }
  if inS[0] {
    skReason = SK_ALL
    return whole
  }
  const pos = skPosOf()
  let k = 0
  while k < impMod.length {
    const d = modIndexOfKey(impKey[k])
    if !inS[impMod[k]] && d >= 0 {
      const nm = skImportName(k)
      if nm == "" {
        if inS[d] {
          skReason = SK_DEMAND
          return whole
        }
      } else {
        const o = modExportOrigin(d, nm)
        if inS[o.oMod] {
          const merged = o.oName + modSuffixOf(o.oMod)
          const shut = skClosed(roots[pos[o.oMod]], merged)
          if (
            shut == SK_OPEN
            || shut == SK_IF_KEPT
              && !skKept(o.oMod, merged, moved, roots[pos[impMod[k]]])
          ) {
            skReason = SK_DEMAND
            return whole
          }
          if shut == SK_IF_PLAIN { skInferred.push(skPlainDecl) }
        }
      }
    }
    k = k + 1
  }
  if !skEarly(inS, tokEnd) { return whole }
  inS
}

// Before the check of S, the guards S's tokens decide, cheapest first, so such a decline costs
// one whole check: no ambient statement of S that moved meets a served module; every served
// module's imports resolve as banked; no served module holds an ambient statement S's tokens meet;
// and, when a served module holds a banked diagnostic, S kept every declaration and token position.
function skEarly(inS: boolean[], tokEnd: i32): boolean {
  skStage = 0
  let anyS = false
  for x in inS {
    if x { anyS = true }
  }
  let resolved = true
  let sd = 0
  while sd < modKeys.length {
    const base = (skKeyIx[modKeys[sd]] ?? -1) * SK_READINGS
    if base < 0 { return skDecline(SK_IFACE) }
    if inS[sd] && ifaceHashOf(sd, 6) != skHash[base + 6] {
      skAmbMoved = skAmbMoved + 1
    }
    if !inS[sd] && ifaceHashOf(sd, 8) != skHash[base + 8] { resolved = false }
    sd = sd + 1
  }
  let indexed = false
  if skAmbMoved > 0 {
    ihAmbientIndexParse()
    indexed = true
    if skAmbMeets(inS) { return skDecline(SK_AMBIENT) }
  }
  if !resolved { return skDecline(SK_IFACE) }
  if skFreshBanked(inS) { return skDecline(SK_FRESH) }
  if skWriterMoved(inS, skAsk, true) { return skDecline(SK_WRITER) }
  // A served diagnostic may name S's declarations, and cite S's positions unless relocatable.
  let banked = false
  let cites = false
  let q = 0
  while q < skDgMod.length {
    const m = modIndexOfKey(skKeys[skDgMod[q]])
    if m >= 0 && !inS[m] {
      banked = true
      if !skDgReloc[q] { cites = true }
    }
    q = q + 1
  }
  if banked {
    sd = 0
    while sd < modKeys.length {
      const b = skKeyIx[modKeys[sd]] ?? -1
      if inS[sd] && ifaceHashOf(sd, 7) != skHash[b * SK_READINGS + 7] {
        return skDecline(SK_DECOR)
      }
      sd = sd + 1
    }
  }
  if anyS {
    if !indexed { ihAmbientIndexParse() }
    const meets = ihAmbientMeetsIn(inS, false, false, false, true)
    if skAmbCount(inS, meets) > 0 { return skDecline(SK_AMBIENT) }
  }
  if cites {
    const pos = skPosOf()
    sd = 0
    while sd < modKeys.length {
      const b = skKeyIx[modKeys[sd]] ?? -1
      if (
        inS[sd]
        && (b >= skPosH.length || skPosHashOf(pos[sd], tokEnd) != skPosH[b])
      ) {
        return skDecline(SK_SPAN)
      }
      sd = sd + 1
    }
  }
  true
}

// Whether a served module's check may read an ambient statement of S that moved since the bank,
// on either side: one a served module's tokens meet (`ihAmbEntryMeets`), or any once a served
// module holds a banked diagnostic, which may suggest a near name. A module's statements that
// kept their entries but not their order all count as moved.
function skAmbMeets(inS: boolean[]): boolean {
  const served: boolean[] = []
  for x in inS { served.push(!x) }
  for q in skDgMod {
    const m = modIndexOfKey(skKeys[q])
    if m < 0 || !inS[m] { return true }
  }
  const now = ihAmbEntries()
  let sd = 0
  while sd < modKeys.length && sd < now.length {
    const base = (skKeyIx[modKeys[sd]] ?? -1) * SK_READINGS
    if inS[sd] && base >= 0 && ifaceHashOf(sd, 6) != skHash[base + 6] {
      const old = skAmb[modKeys[sd]]
      if old == null { return true }
      for e in skAmbDiff(old, now[sd]) {
        if ihAmbEntryMeets(e, served) { return true }
      }
    }
    sd = sd + 1
  }
  false
}

// The entries of `a` not in `b` and of `b` not in `a`, or all of both when there are none.
function skAmbDiff(a: string[][], b: string[][]): string[][] {
  const out: string[][] = []
  for e in a {
    if !skAmbHas(b, e) { out.push(e) }
  }
  for e in b {
    if !skAmbHas(a, e) { out.push(e) }
  }
  if out.length > 0 { return out }
  for e in a { out.push(e) }
  for e in b { out.push(e) }
  out
}

function skAmbHas(es: string[][], e: string[]): boolean {
  for x in es {
    if x.length == e.length {
      let same = true
      let i = 0
      while same && i < x.length {
        if x[i] != e[i] { same = false }
        i = i + 1
      }
      if same { return true }
    }
  }
  false
}

// Every module's ambient statements, by module key, for the next check's `skAmbMeets`.
function skAmbNow(): {[string]: string[][]} {
  const out: {[string]: string[][]} = Map()
  const now = ihAmbEntries()
  let m = 0
  while m < modKeys.length && m < now.length {
    out[modKeys[m]] = now[m]
    m = m + 1
  }
  out
}

// Whether S's tokens may move the adoption of a fresh value a served module delivers: its
// declaration, when in S, or S's statements that spell its name, which the site count reads.
function skFreshBanked(inS: boolean[]): boolean {
  if skDeliv.has(SK_UNATTRIBUTED) { return true }
  const mask = ihMask()
  const watch: string[] = []
  for key in skDeliv.keys() {
    const row = skDeliv[key] ?? Map()
    let served = false
    for mk in row.keys() {
      const m = modIndexOfKey(mk)
      if m < 0 { return true }
      if !inS[m] { served = true }
    }
    if served { watch.push(key) }
  }
  if watch.length == 0 { return false }
  const now = ihOccDigests(watch, inS)
  for key in watch {
    const d = modIndexOfKey(key.slice(0, key.indexOf("\n")))
    const body = key + "\n"
    if (
      (mask & SK_NO_FRESH_BODY) == 0
      && d >= 0
      && inS[d]
      && (now.has(body) != skOcc.has(body)
        || (now[body] ?? 0) != (skOcc[body] ?? 0))
    ) {
      return true
    }
    if (mask & SK_NO_FRESH_OCC) == 0 {
      let m = 0
      while m < modKeys.length {
        const k = key + "\n" + modKeys[m]
        if (
          inS[m]
          && (now.has(k) != skOcc.has(k) || (now[k] ?? 0) != (skOcc[k] ?? 0))
        ) {
          return true
        }
        m = m + 1
      }
    }
  }
  false
}

// The builder key of merged top-level name `name` (`modKeys[m] + "\n" + source name`), or ""
// for a name no module suffix marks.
function skOriginKey(name: string): string {
  const src = ihSourceName(name)
  if src == name || name.length <= src.length + 2 { return "" }
  const digits = name.slice(src.length + 2, name.length)
  let i = 0
  while i < digits.length {
    if digits[i] < '0' || digits[i] > '9' { return "" }
    i = i + 1
  }
  const m = modIxOfId(digits)
  if m < 0 || m >= modKeys.length { return "" }
  modKeys[m] + "\n" + src
}

// This check's asks (`crAskKeys`) as kind letter plus builder key, each once, after `held`.
function skAsksNow(held: string[]): string[] {
  const out: string[] = []
  const seen: {[string]: boolean} = Map()
  for a in held {
    if !seen.has(a) {
      seen[a] = true
      out.push(a)
    }
  }
  for a in crAskKeys {
    const key = skOriginKey(a.slice(1, a.length))
    if key != "" {
      const k = a.slice(0, 1) + key
      if !seen.has(k) {
        seen[k] = true
        out.push(k)
      }
    }
  }
  out
}

// A write question: the module of the statement that asked ("" for none), the declaration's
// key (`skDeclKeys`), the kind and parameter, and the answer ("!" for none to compare).
type SkQ = { qAsk: string, qDecl: string, qKind: i32, qP: i32, qAns: string }

type SkDecls = { byFn: {[i32]: string}, byKey: {[string]: i32} }

function skQKey(q: SkQ): string {
  q.qDecl + "\t" + i32ToStr(q.qKind) + "\t" + i32ToStr(q.qP)
}

// The module key a statement or declaration key starts with, past a "!".
function skKeyMod(key: string): string {
  let k = key
  if k.slice(0, 1) == "!" { k = k.slice(1, k.length) }
  const nl = k.indexOf("\n")
  if nl < 0 { return k }
  k.slice(0, nl)
}

// Each function declaration's key: its statement's (`ihStKeysOf`), its rank among that
// statement's functions from the last, and its rank among the nodes sharing its token. A key
// behind "!", or of a statement with no name, does not name one declaration.
function skDeclKeys(): SkDecls {
  const fnAt: {[i32]: i32[]} = Map()
  let n = 0
  while n < P.nodes.length && n < nodeToks.length {
    const t = nodeToks[n]
    if t >= 0 {
      const nd = nodeAt(n)
      if nd is FuncDecl {
        const row = fnAt[t] ?? []
        row.push(n)
        fnAt[t] = row
      }
    }
    n = n + 1
  }
  const toks: i32[] = []
  let t = P.toks.length - 1
  while t >= 0 {
    if fnAt.has(t) { toks.push(t) }
    t = t - 1
  }
  const keys = ihStKeysOf(toks)
  const rank: {[string]: i32} = Map()
  const out: SkDecls = { byFn: Map(), byKey: Map() }
  let k = 0
  while k < toks.length && k < keys.length {
    const r = rank[keys[k]] ?? 0
    rank[keys[k]] = r + 1
    const row = fnAt[toks[k]] ?? []
    let c = 0
    while c < row.length {
      const key = keys[k] + "\n" + i32ToStr(r) + "\n" + i32ToStr(c)
      out.byFn[row[c]] = key
      out.byKey[key] = row[c]
      c = c + 1
    }
    k = k + 1
  }
  out
}

// Whether a declaration key names no one declaration: empty, behind "!", or of a nameless statement.
function skDeclUnnamed(key: string): boolean {
  if key == "" || key.slice(0, 1) == "!" { return true }
  const pfx = skKeyMod(key) + "\n\n"
  key.slice(0, pfx.length) == pfx
}

// The answer to `q` now, or "!" when its key names no one declaration.
function skQAnswer(q: SkQ, dks: SkDecls): string {
  if skDeclUnnamed(q.qDecl) { return "!" }
  const fn = dks.byKey[q.qDecl] ?? -1
  if fn < 0 { return "!" }
  const a = crAskAnswer(q.qKind, fn, q.qP, skUse)
  if a.length < 2 { return a[0] }
  a[0] + i32ToStr(ihTextSetHash(a.slice(1, a.length)))
}

// This check's narrowing tests (`crAskUses`), with the banked ones when it served some module.
function skUsesNow(keep: boolean[]): {[string]: boolean} {
  const out: {[string]: boolean} = Map()
  if keep.length > 0 {
    for u in skUse.keys() { out[u] = true }
  }
  for u in crAskUses.keys() { out[u] = true }
  out
}

// The banked questions of the modules this check served (`keep` false), then its own, each
// answered again when its declaration's module is checked and otherwise as banked.
function skQsNow(keep: boolean[]): SkQ[] {
  const dks = skDeclKeys()
  const held: {[string]: string} = Map()
  const asked: SkQ[] = []
  const seen: {[string]: boolean} = Map()
  if keep.length > 0 {
    for q in skQs {
      held[skQKey(q)] = q.qAns
      const am = modIndexOfKey(q.qAsk)
      const k = q.qAsk + "\t" + skQKey(q)
      if (am < 0 || !keep[am]) && !seen.has(k) {
        seen[k] = true
        asked.push(q)
      }
    }
  }
  const qs = crAskQs
  const at: i32[] = []
  let j = 0
  while j + 3 < qs.length {
    at.push(qs[j])
    j = j + 4
  }
  const askers = ihStKeysOf(at)
  j = 0
  let w = 0
  while j + 3 < qs.length && w < askers.length {
    const q: SkQ = {
      qAsk: skKeyMod(askers[w]),
      qDecl: dks.byFn[qs[j + 2]] ?? "",
      qKind: qs[j + 1],
      qP: qs[j + 3],
      qAns: "!",
    }
    const k = q.qAsk + "\t" + skQKey(q)
    if !seen.has(k) {
      seen[k] = true
      asked.push(q)
    }
    j = j + 4
    w = w + 1
  }
  crAskHold(true)
  const ans: {[string]: string} = Map()
  const out: SkQ[] = []
  for q in asked {
    const qk = skQKey(q)
    if !ans.has(qk) {
      const dm = modIndexOfKey(skKeyMod(q.qDecl))
      if keep.length == 0 || (dm >= 0 && dm < keep.length && keep[dm]) {
        ans[qk] = skQAnswer(q, dks)
      } else {
        ans[qk] = held[qk] ?? "!"
      }
    }
    out.push(
      {
        qAsk: q.qAsk,
        qDecl: q.qDecl,
        qKind: q.qKind,
        qP: q.qP,
        qAns: ans[qk] ?? "!",
      },
    )
  }
  crAskHold(false)
  out
}

// Whether a question a served module asked of a declaration in S answers differently now; one
// whose declaration's module is unknown always does.
function skQsMoved(inS: boolean[]): boolean {
  const dks = skDeclKeys()
  const done: {[string]: boolean} = Map()
  let moved = false
  crAskHold(true)
  for q in skQs {
    const am = modIndexOfKey(q.qAsk)
    const dm = modIndexOfKey(skKeyMod(q.qDecl))
    const asks = am < 0 || am >= inS.length || !inS[am]
    const reads = dm < 0 || dm >= inS.length || inS[dm]
    const qk = skQKey(q)
    if !moved && asks && reads && !done.has(qk) {
      done[qk] = true
      if q.qAns == "!" || skQAnswer(q, dks) != q.qAns { moved = true }
    }
  }
  crAskHold(false)
  moved
}

// Whether a whole-program question about a name declared in S may answer differently once
// served modules join (D6780, D6781). With `held` the asks are banked, and a served module that
// names the name may have asked: its answer moves with the name's writer closure, uses, or the
// top-level statements. Otherwise S asked, and is blind to a served statement in the closure.
function skWriterMoved(inS: boolean[], all: string[], held: boolean): boolean {
  if all.length == 0 || (ihMask() & SK_NO_WRITER) != 0 { return false }
  const asks: string[] = []
  const keys: string[] = []
  for a in all {
    const key = a.slice(1, a.length)
    const d = modIndexOfKey(key.slice(0, key.indexOf("\n")))
    if d < 0 { return true }
    if inS[d] {
      asks.push(a)
      keys.push(key)
    }
  }
  if asks.length == 0 { return false }
  const pos = skPosOf()
  let last = -1
  let m = 0
  while m < modKeys.length {
    if inS[m] && pos[m] > last { last = pos[m] }
    m = m + 1
  }
  const served: boolean[] = []
  const before: boolean[] = []
  m = 0
  while m < modKeys.length {
    served.push(!inS[m])
    before.push(!inS[m] && pos[m] < last)
    m = m + 1
  }
  const now = ihWriterDigests(keys, served, before)
  for a in asks {
    const key = a.slice(1, a.length)
    if a[0] == 'o' {
      if !held && now.has("\no") { return true }
      if (
        held
        && now.has(key + "\ne")
        && (now["\nO"] ?? 0) != (skWr["\nO"] ?? 0)
      ) {
        return true
      }
    } else if held {
      const w = key + "\nW"
      const e = key + "\nE"
      if (
        now.has(key + "\ne")
        && ((now[w] ?? 0) != (skWr[w] ?? 0) || (now[e] ?? 0) != (skWr[e] ?? 0))
      ) {
        return true
      }
    } else if now.has(key + "\nw") || (a[0] == 'e' && now.has(key + "\ne")) {
      return true
    }
  }
  false
}

// The module (table index) of node `nd`'s last token, or -1.
function skNodeMod(nd: i32): i32 {
  if nd < 0 || nd >= nodeToks.length { return -1 }
  const tk = nodeToks[nd]
  if tk < 0 || tk >= P.toks.length { return -1 }
  modOfTok(tk)
}

// This check's deliveries of fresh values, keyed as `skDeliv` is.
function skDelivNow(): {[string]: {[string]: i32}} {
  const out: {[string]: {[string]: i32}} = Map()
  let k = 0
  while k < recDelivDecl.length {
    const dm = skNodeMod(recDelivDecl[k])
    const am = skNodeMod(recDelivAt[k])
    let key = SK_UNATTRIBUTED
    let at = ""
    if dm >= 0 && am >= 0 && recDelivName[k] != "" {
      key = modKeys[dm] + "\n" + ihSourceName(recDelivName[k])
      at = modKeys[am]
    }
    const row: {[string]: i32} = out[key] ?? Map()
    row[at] = (row[at] ?? 0) | recDelivFlag[k]
    out[key] = row
    k = k + 1
  }
  out
}

// After the check of S: whether a fresh value S delivers is also delivered or spelled in a served
// module, so that S's check counted its sites short, or judged a kept delivery against part of
// the deliveries that share its record.
function skFreshSplit(inS: boolean[]): boolean {
  const mask = ihMask()
  const now = skDelivNow()
  if now.has(SK_UNATTRIBUTED) { return true }
  const counted: string[] = []
  const keys: string[] = []
  for key in now.keys() { keys.push(key) }
  for key in skDeliv.keys() {
    if !now.has(key) { keys.push(key) }
  }
  for key in keys {
    const cur = now[key] ?? Map()
    const old = skDeliv[key] ?? Map()
    let sNow = 0
    for mk in cur.keys() { sNow = sNow | (cur[mk] ?? 0) }
    let sOld = 0
    let sv = 0
    for mk in old.keys() {
      const m = modIndexOfKey(mk)
      if m < 0 { return true }
      if inS[m] {
        sOld = sOld | (old[mk] ?? 0)
      } else {
        sv = sv | (old[mk] ?? 0)
      }
    }
    if (mask & SK_NO_FRESH_SPLIT) == 0 {
      const keptMoved = (sOld & SK_KEPT) != (sNow & SK_KEPT)
      if (sv & SK_KEPT) != 0 && (sNow != 0 || keptMoved) { return true }
      if (sv & SK_OWN) != 0 && keptMoved { return true }
    }
    if (sNow & SK_KEPT) != 0 { counted.push(key) }
  }
  if counted.length == 0 || (mask & SK_NO_FRESH_OCC) != 0 { return false }
  const served: boolean[] = []
  for x in inS { served.push(!x) }
  const occ = ihOccDigests(counted, served)
  for key in counted {
    let m = 0
    while m < modKeys.length {
      if !inS[m] && occ.has(key + "\n" + modKeys[m]) { return true }
      m = m + 1
    }
  }
  false
}

function skDecline(why: i32): boolean {
  skReason = why
  false
}

// Each (importer, origin) pair the import table makes, flattened: an import of a re-exported
// name pairs with the module declaring it, a namespace import with the module it names.
function skPairs(): i32[] {
  const out: i32[] = []
  const seen: {[string]: boolean} = Map()
  let k = 0
  while k < impMod.length {
    const d = modIndexOfKey(impKey[k])
    if d >= 0 {
      let o = d
      const nm = skImportName(k)
      if nm != "" { o = modExportOrigin(d, nm).oMod }
      const key = modKeys[impMod[k]] + "\n" + modKeys[o]
      if !seen.has(key) {
        seen[key] = true
        out.push(impMod[k])
        out.push(o)
      }
    }
    k = k + 1
  }
  out
}

// The served modules `meets` says hold an ambient statement the check of S may read, which
// `checkSkipStat` reports.
function skAmbCount(inS: boolean[], meets: boolean[]): i32 {
  let n = 0
  let sd = 0
  while sd < modKeys.length && sd < inS.length && sd < meets.length {
    if !inS[sd] && meets[sd] { n = n + 1 }
    sd = sd + 1
  }
  skAmbMet = n
  n
}

// After a check of S alone, the guards only the check decides, cheapest first: pass, stray,
// demand, R1 against the arena and rendered diagnostics, then each served importer's reach
// (`ihReachOf`). Then `T.diags` becomes the module-ordered merge of the fresh and banked ones.
function skSettle(inS: boolean[], roots: i32[]): boolean {
  skStage = 1
  if jwSiteNode.length > 0 || pinDeepIsRan { return skDecline(SK_PASS) }
  const freshMod: i32[] = []
  let j = 0
  while j < T.diags.length {
    const m = skDiagMod(j)
    if m < 0 || !inS[m] { return skDecline(SK_STRAY) }
    freshMod.push(m)
    j = j + 1
  }
  // An inferred binding's type joins its uses in every module; with the hash kept, the served
  // modules' uses fit it again, unless the type spells a function or elides part of itself.
  for decl in skInferred {
    if !ihPlainBinding(decl) { return skDecline(SK_DEMAND) }
  }
  // The index `skEarly` read, with the arena's records; a type's name meets only when a row or
  // error of S renders a type declared outside S, and an error may suggest a near name.
  let anyS = false
  for x in inS {
    if x { anyS = true }
  }
  if anyS {
    ihAmbientIndexArena()
    const dirty = T.diags.length > 0
    const read = (ihMask() & SK_NO_AMB_ROWS) == 0
    wiDiagTexts()
    wiRowTextsIn(inS)
    const rows = read && (wiDiagNamesOut(inS) || wiRowsIn(inS))
    const meets = ihAmbientMeetsIn(inS, dirty, true, rows, !rows)
    if skAmbCount(inS, meets) > 0 { return skDecline(SK_AMBIENT) }
    if read && (wiLitRowsIn(inS) || wiLitDiagsIn(inS)) {
      return skDecline(SK_AMBIENT)
    }
    if dirty && nearNamesRead && skAmbCount(inS, ihAmbientNear()) > 0 {
      return skDecline(SK_AMBIENT)
    }
  }
  // Each served importer reads of an origin in S only what its reach holds.
  const pairs = skPairs()
  let p = 0
  while p + 1 < pairs.length {
    const i = pairs[p]
    const o = pairs[p + 1]
    if !inS[i] && inS[o] {
      const now = ihReachOf(i, o)
      const key = modKeys[i] + "\n" + modKeys[o]
      if !skReach.has(key) || (skReach[key] ?? 0) != now {
        return skDecline(SK_IFACE)
      }
    }
    p = p + 2
  }
  // And what a served module asked of a body in S, answered again.
  if (ihMask() & SK_NO_EFFECT) == 0 && skQsMoved(inS) {
    return skDecline(SK_IFACE)
  }
  if skFreshSplit(inS) { return skDecline(SK_FRESH) }
  if skWriterMoved(inS, skAsksNow([]), false) { return skDecline(SK_WRITER) }
  const pos = skPosOf()
  const fresh = T.diags
  const out: TDiag[] = []
  for m in modOrder {
    if inS[m] {
      let f = 0
      while f < fresh.length {
        if freshMod[f] == m { out.push(fresh[f]) }
        f = f + 1
      }
    } else {
      const b = skKeyIx[modKeys[m]] ?? -1
      let i = 0
      while i < skDg.length {
        if skDgMod[i] == b {
          const g = skDg[i]
          let end = -1
          if skDgEnd[i] >= 0 { end = modLoadStart[pos[m]] + skDgEnd[i] }
          out.push(
            {
              tmsg: g.tmsg,
              tat: roots[pos[m]],
              tline: g.tline,
              tcol: g.tcol,
              tendTok: end,
              tcode: g.tcode,
              tdata: g.tdata,
            },
          )
        }
        i = i + 1
      }
    }
  }
  T.diags = out
  // A served row is anchored at its module's root, which must map back to that module.
  j = 0
  while j < T.diags.length {
    const m = skDiagMod(j)
    if m < 0 || (!inS[m] && T.diags[j].tat != roots[pos[m]]) {
      return skDecline(SK_STRAY)
    }
    j = j + 1
  }
  let s = 0
  let m = 0
  while m < modKeys.length {
    const b = skKeyIx[modKeys[m]] ?? -1
    if !inS[m] && b >= 0 {
      ihCarry(m, skHash.slice(b * SK_READINGS, (b + 1) * SK_READINGS))
      if m < plLinks.length && b < skPlus.length {
        plLinks[m] = skPlus[b]
        plStrIdx[m] = skStrIdx[b]
        plScalar[m] = skScalar[b]
      }
      s = s + 1
    }
    m = m + 1
  }
  skServed = s
  skReason = SK_SERVED
  true
}

// A whole check's diagnostics in module order, each module's in the order raised, so a check
// that serves some modules and one that serves none list the same rows in the same order.
function skGroup(): i32 {
  const mods: i32[] = []
  let j = 0
  while j < T.diags.length {
    let m = skDiagMod(j)
    if m < 0 { m = 0 }
    mods.push(m)
    j = j + 1
  }
  const all = T.diags
  const out: TDiag[] = []
  for m in modOrder {
    let i = 0
    while i < all.length {
      if mods[i] == m { out.push(all[i]) }
      i = i + 1
    }
  }
  T.diags = out
  0
}

// The end of the token range of the module at `modOrder` position `o`.
function skTokHi(o: i32, tokEnd: i32): i32 {
  if o + 1 < modLoadStart.length { return modLoadStart[o + 1] }
  tokEnd
}

// The token positions of the module at `modOrder` position `o`.
function skPosHashOf(o: i32, tokEnd: i32): i32 {
  if o < 0 || o >= modLoadStart.length { return 0 }
  ihPosHash(modLoadStart[o], skTokHi(o, tokEnd))
}

// Whether diagnostic `g`, rendered `msg`, reads the same wherever another module's tokens
// move: its span starts in its own module's tokens `[lo, hi)`, and neither its message nor its
// data spells a number, as a cited line or column would.
function skRelocatable(g: TDiag, msg: string, lo: i32, hi: i32): boolean {
  const first = nodeStartTok(g.tat)
  if first >= 0 && (first < lo || first >= hi) { return false }
  !skSpellsNumber(msg) && !skDataSpellsNumber(g.tdata)
}

// Whether `s` holds a digit outside a primitive width name such as `i32` or `f64`.
function skSpellsNumber(s: string): boolean {
  let i = 0
  while i < s.length {
    if isDigitCode(s[i]) {
      let e = i
      while e < s.length && isDigitCode(s[e]) { e = e + 1 }
      if !skWidthName(s, i, e) { return true }
      i = e
    } else {
      i = i + 1
    }
  }
  false
}

// Whether the digits `s[i, e)` end a width name: `i`, `u` or `f` alone before them.
function skWidthName(s: string, i: i32, e: i32): boolean {
  if i < 1 || (e < s.length && isWordCode(s[e])) { return false }
  const p = s[i - 1]
  if p != 'i' && p != 'u' && p != 'f' { return false }
  if i >= 2 && isWordCode(s[i - 2]) { return false }
  const w = s.slice(i, e)
  w == "8" || w == "16" || w == "32" || w == "64"
}

// Whether diagnostic data `d`, a run of `len:text,` fields, spells a number in a field, or
// is not such a run.
function skDataSpellsNumber(d: string): boolean {
  let i = 0
  while i < d.length {
    let n = 0
    let j = i
    while j < d.length && j - i < 7 && isDigitCode(d[j]) {
      n = n * 10 + (d[j] - '0')
      j = j + 1
    }
    if j == i || j >= d.length || d[j] != ':' { return true }
    const a = j + 1
    if a + n >= d.length || d[a + n] != ',' { return true }
    if skSpellsNumber(d.slice(a, a + n)) { return true }
    i = a + n + 1
  }
  false
}

function isDigitCode(c: i32): boolean { c >= '0' && c <= '9' }

function isWordCode(c: i32): boolean {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || isDigitCode(c) || c == '_'
}

// Bank this check for the next one, or leave nothing banked when a diagnostic has no module,
// or ends outside it, or the check had a pass the bank cannot replay. `keep` is S, or empty for
// a whole check.
function skBankNow(tokEnd: i32, keep: boolean[]): i32 {
  skValid = false
  if P.diags.length > 0 || jwSiteNode.length > 0 || pinDeepIsRan { return 0 }
  const pos = skPosOf()
  const dgMod: i32[] = []
  const dgEnd: i32[] = []
  const dgReloc: boolean[] = []
  const dg: TDiag[] = []
  let cites = false
  let j = 0
  while j < T.diags.length {
    const m = skDiagMod(j)
    if m < 0 { return 0 }
    const o = pos[m]
    const hi = skTokHi(o, tokEnd)
    const e = T.diags[j].tendTok
    let rel = -1
    if e >= 0 {
      if e < modLoadStart[o] || e >= hi { return 0 }
      rel = e - modLoadStart[o]
    }
    // A message renders against this check's tables, so it is banked rendered, and only when
    // rendering it again (as every reader does) leaves it unchanged.
    const g = T.diags[j]
    const msg = demangleMsg(g.tmsg)
    if strContains(msg, "#") || strContains(msg, "$") { return 0 }
    const reloc = skRelocatable(g, msg, modLoadStart[o], hi)
    if !reloc { cites = true }
    dgMod.push(m)
    dgEnd.push(rel)
    dgReloc.push(reloc)
    dg.push(
      {
        tmsg: msg,
        tat: g.tat,
        tline: g.tline,
        tcol: g.tcol,
        tendTok: g.tendTok,
        tcode: g.tcode,
        tdata: g.tdata,
      },
    )
    j = j + 1
  }
  skKeys = []
  skSrcs = []
  skHash = []
  skPosH = []
  skPlus = []
  skStrIdx = []
  skScalar = []
  const ix: {[string]: i32} = Map()
  let m = 0
  while m < modKeys.length {
    ix[modKeys[m]] = m
    skKeys.push(modKeys[m])
    skSrcs.push(modSrcs[m])
    let w = 0
    while w < SK_READINGS {
      skHash.push(ifaceHashOf(m, w))
      w = w + 1
    }
    if cites { skPosH.push(skPosHashOf(pos[m], tokEnd)) }
    if m < plLinks.length {
      skPlus.push(plLinks[m])
      skStrIdx.push(plStrIdx[m])
      skScalar.push(plScalar[m])
    }
    m = m + 1
  }
  // A served origin's reaches are carried: the check did not read it, and its tokens held.
  const reach: {[string]: i32} = Map()
  const pairs = skPairs()
  let p = 0
  while p + 1 < pairs.length {
    const key = modKeys[pairs[p]] + "\n" + modKeys[pairs[p + 1]]
    if keep.length == 0 || keep[pairs[p + 1]] {
      reach[key] = ihReachOf(pairs[p], pairs[p + 1])
    } else {
      const held = skReach[key]
      if held != null { reach[key] = held }
    }
    p = p + 2
  }
  // A served module's deliveries are carried: the check did not read it, and its tokens held.
  const deliv = skDelivNow()
  if keep.length > 0 {
    for key in skDeliv.keys() {
      const old = skDeliv[key] ?? Map()
      for mk in old.keys() {
        const om = modIndexOfKey(mk)
        if om < 0 || !keep[om] {
          const row: {[string]: i32} = deliv[key] ?? Map()
          row[mk] = (row[mk] ?? 0) | (old[mk] ?? 0)
          deliv[key] = row
        }
      }
    }
  }
  const watch: string[] = []
  for key in deliv.keys() { watch.push(key) }
  skReach = reach
  skDeliv = deliv
  skOcc = ihOccDigests(watch, [])
  let held: string[] = []
  if keep.length > 0 { held = skAsk }
  skAsk = skAsksNow(held)
  const askKeys: string[] = []
  for a in skAsk { askKeys.push(a.slice(1, a.length)) }
  skWr = ihWriterDigests(askKeys, [], [])
  skUse = skUsesNow(keep)
  skAmb = skAmbNow()
  skQs = skQsNow(keep)
  skKeyIx = ix
  skEntry = modKeys[0]
  skMask = ihMask()
  skDgMod = dgMod
  skDgEnd = dgEnd
  skDgReloc = dgReloc
  skDg = dg
  skValid = true
  0
}

// ── serving one invocation's targets from an importer's check (`wiArm`) ─────────────────────
// An importer's check banks each target whose own check cannot differ (`wiGuard`, D7940), and a
// later check of that target over the same sources is served the banked diagnostics, rc and
// lint sites.
const WI_SERVED = 0
const WI_UNSEEN = 1
const WI_DIRTY = 2
const WI_ENTRY = 3
const WI_DEMAND = 4
const WI_FRESH = 5
const WI_WRITER = 6
const WI_AMBIENT = 7
const WI_ASKS = 8
const WI_GRAPH = 9
const WI_REASONS = 10
// One banked type diagnostic: its module's key, its span and its rendered message.
type WiDiag = {
  dKey: string,
  dLine: i32,
  dCol: i32,
  dEndLine: i32,
  dEndCol: i32,
  dMsg: string,
}
type WiBank = {
  wKeys: {[string]: i32},
  wSrcs: string[],
  wPlus: {[i32]: i32}[],
  wStrIdx: {[i32]: i32}[],
  wScalar: {[i32]: i32}[],
  wDiags: WiDiag[],
  wRc: i32,
}
// The served check's diagnostics and rc (`wiServe`).
let wiSrvDiags: WiDiag[] = []
let wiSrvRc = 0
// Whether this bank pass runs over a check with type errors, and each error's module and
// rendered message, read once per pass by `wiBankWhole`.
let wiDirtyNow = false
let wiDiagMods: i32[] = []
let wiDiagMsgs: string[] = []
// Why this pass serves no target an error lies outside of, or "": an error-driven undo of a
// rewrite, or a refusal dropped as the repeat of one keyed beyond its module.
let wiOutsideWhy = ""
let wiOn = false
let wiMask = 0
// Whether `wiArm` armed the interface hashes, so a check needs only their statement table.
let wiOwnsIh = false
// Whether the current check may bank a target (`wiLive`).
let wiLiveNow = false
// Per target key: 1 while unchecked, 0 once checked.
let wiPending: {[string]: i32} = Map()
let wiBanks: {[string]: WiBank} = Map()
// Per target key, why the last importer's check did not bank it.
let wiWhy: {[string]: i32} = Map()
// Per target key, the modules outside its closure a guard named when it declined; a graph
// holding one of them does not try the target again. A target in `wiNever` is never tried.
let wiCulprits: {[string]: string[]} = Map()
let wiNever: {[string]: boolean} = Map()
// The module the last `wiGuard` decline named (-1 none, `WI_ANY` every graph).
let wiCulprit = -1
const WI_ANY = -2
let wiStats: i32[] = []
// Module checks per `wiStats` reason: a declined target adds its graph's module count, a served
// one the count it skipped. Slot `WI_REASONS` counts import-free checks, one module each.
let wiMods: i32[] = []
// One row per declined target check: its reason, its key, its graph's module count, and the
// module (and imported name) the last guard to decline it named.
let wiTrace: string[] = []
let wiWhyBy: {[string]: string} = Map()
let wiCulpritName = ""
// The report row `wiRowsIn` last counted, for the trace.
let wiRowsWhy = ""
// The report rows of the target `wiGuard` weighs: each row's stream and its rendered text.
let wiRowKind: string[] = []
let wiRowText: string[] = []
let wiServedLast = false
let wiBankedKeys: string[] = []
let wiBankedMods: i32[] = []
// Per banked target: true when it is clean and its check had errors, so its redundant-annotation
// rows are the withheld ones (`wiBankedHeld`).
let wiBankedHolds: boolean[] = []
// Read once per bank pass, for every guard of it: each module's direct imports, the check's
// fresh deliveries and its write questions.
let wiDeps: i32[][] = []
let wiNow: {[string]: {[string]: i32}} = Map()
let wiAsksAll: string[] = []
// Whether this bank pass has built the ambient index (`ihAmbientIndex`), on its first ambient read.
let wiIndexed = false
// Per import row of the check: the module it reads (-1 unresolved), the origin module of the
// name it binds (-1 for a namespace import), and whether `skClosed` shuts it (-1 not yet asked).
let wiImpTo: i32[] = []
let wiImpOrigin: i32[] = []
let wiImpMerged: string[] = []
let wiImpShut: i32[] = []
// Mask bits that each drop one guard, for the suite's mask witnesses.
const WI_NO_ENTRY = 1
const WI_NO_DEMAND = 2
const WI_NO_FRESH = 4
const WI_NO_WRITER = 8
const WI_NO_AMBIENT = 16
const WI_NO_ASKS = 32
const WI_NO_ARENA = 64
const WI_NO_RENDER = 128
const WI_NO_ADOPTED = 256
const WI_NO_TWIN = 512
const WI_NO_KEPT = 1024
const WI_NO_CALLED = 2048
const WI_NO_DIAG_NAMES = 4096
const WI_NO_OUTSIDE = 8192
const WI_NO_INERT_OUT = 16384
const WI_NO_LIT_ORDER = 32768
// Loosen four ambient guards (`ihAmbientLoose`): a literal handed to any call, a getter read,
// a literal any function returns, and a dirty check's method call.
const WI_LOOSE_ARGS = 65536
const WI_LOOSE_GETTER = 131072
const WI_LOOSE_SETTLED = 262144
const WI_LOOSE_CALLS = 524288
// The delivery flags whose judgement reads every site of the value: kept, or site-counted.
const WI_COUNTED = 5

// Arm serving across the targets `wiTargetAdd` names (`on` 1, with guard mask `mask`), or
// disarm it (0). Either way the bank and the counts start empty.
export function wiArm(on: i32, mask: i32): i32 {
  if wiOwnsIh && on == 0 { ifaceHashArm(0) }
  wiOwnsIh = wiOwnsIh && on != 0 || on != 0 && !ifaceHashArmed()
  wiOn = on != 0
  wiMask = mask
  wiLiveNow = false
  let loose = 0
  if (mask & WI_LOOSE_ARGS) != 0 { loose = loose + 1 }
  if (mask & WI_LOOSE_GETTER) != 0 { loose = loose + 2 }
  if (mask & WI_LOOSE_SETTLED) != 0 { loose = loose + 4 }
  if (mask & WI_LOOSE_CALLS) != 0 { loose = loose + 8 }
  ihAmbientLoose(loose)
  wiPending = Map()
  wiBanks = Map()
  wiWhy = Map()
  wiCulprits = Map()
  wiNever = Map()
  wiStats = []
  wiMods = [0]
  wiTrace = []
  wiWhyBy = Map()
  let r = 0
  while r < WI_REASONS {
    wiStats.push(0)
    wiMods.push(0)
    r = r + 1
  }
  wiServedLast = false
  wiBankedKeys = []
  wiBankedMods = []
  if wiOn { ifaceHashArm(1) }
  0
}

// Whether this check needs the interface hashes' statement table: when something other than
// serving armed them, or when a target it may bank is in the graph.
function wiIhWanted(): boolean { !wiOwnsIh || skArmed || wiLiveNow }

// Whether the graph just ordered holds, beside its entry, a target that may still be banked.
function wiLive(): boolean {
  if !wiOn { return false }
  let m = 1
  while m < modKeys.length {
    if wiTry(modKeys[m]) { return true }
    m = m + 1
  }
  false
}

// Whether this graph may bank target `key`: it is pending, not banked, and the graph holds no
// module an earlier decline of it named.
function wiTry(key: string): boolean {
  if (wiPending[key] ?? 0) != 1 || wiBanks.has(key) || wiNever.has(key) {
    return false
  }
  for c in wiCulprits[key] ?? [] {
    if modIndexOfKey(c) >= 0 { return false }
  }
  true
}

// The spelling an importer's check keys module `key` by: a root named `./a.vl` is the `a.vl`
// its importers resolve.
export function wiKeyOf(key: string): string {
  if modKeyIsStd(key) { return key }
  modNormalize(key)
}

// Name `key` (a root's path, in any spelling `wiKeyOf` canonicalises) a target of this invocation.
export function wiTargetAdd(key: string): i32 {
  wiPending[wiKeyOf(key)] = 1
  0
}

const wiKeyAcc = cpAccNew()
// The host's spelling of `wiTargetAdd`: push the key's bytes, then commit them.
export function wiTargetPush(c: i32): i32 {
  cpAccPush(wiKeyAcc, c)
  0
}
export function wiTargetCommit(): i32 { wiTargetAdd(cpAccTake(wiKeyAcc)) }

// Of the targets checked since `wiArm`: how many it served (`which` 0), or declined for reason
// `which` (`WI_UNSEEN` when no importer's graph holds it before its turn).
export function wiStat(which: i32): i32 {
  if which < 0 || which >= wiStats.length { return -1 }
  wiStats[which]
}

// The module checks behind `wiStat(which)`'s targets (`which` `WI_REASONS`: import-free checks).
export function wiModStat(which: i32): i32 {
  if which < 0 || which >= wiMods.length { return -1 }
  wiMods[which]
}

// The declined target checks since `wiArm`: how many, and row `i`'s length and byte `j`. A row
// is the reason's index, the key, the graph's module count, and the module and name a guard named.
export function wiTraceCount(): i32 { wiTrace.length }
export function wiTraceLen(i: i32): i32 {
  if i < 0 || i >= wiTrace.length { return 0 }
  wiTrace[i].length
}
export function wiTraceAt(i: i32, j: i32): i32 {
  if i < 0 || i >= wiTrace.length { return 0 }
  wiTrace[i][j]
}

// The import-free check that just started, counted when serving is armed.
function wiCountSingle(): i32 {
  if wiOn && WI_REASONS < wiMods.length {
    wiMods[WI_REASONS] = wiMods[WI_REASONS] + 1
  }
  0
}

// Whether an importer's bank served the last check.
export function wiServed(): boolean { wiServedLast }

// The targets the last check banked: how many, and each one's key and module index in it.
export function wiBankedCount(): i32 { wiBankedKeys.length }
export function wiBankedKey(i: i32): string { wiBankedKeys[i] }
export function wiBankedMod(i: i32): i32 { wiBankedMods[i] }
// Whether banked target `i` reads its redundant-annotation rows through `wiHeldSwap`.
export function wiBankedHeld(i: i32): boolean { wiBankedHolds[i] }
// Trade the reported redundant-annotation rows with the withheld ones; call it again to undo.
export function wiHeldSwap(): i32 { redunHeldSwap() }

// The served check's type diagnostics, in its own check's order: how many, and row `i`'s
// module index in this graph, span and message.
export function wiDiagCount(): i32 { wiSrvDiags.length }
export function wiDiagMod(i: i32): i32 {
  const k = wiSrvDiags[i].dKey
  if modKeys.length > 0 && wiKeyOf(modKeys[0]) == k { return 0 }
  modIndexOfKey(k)
}
export function wiDiagLine(i: i32): i32 { wiSrvDiags[i].dLine }
export function wiDiagCol(i: i32): i32 { wiSrvDiags[i].dCol }
export function wiDiagEndLine(i: i32): i32 { wiSrvDiags[i].dEndLine }
export function wiDiagEndCol(i: i32): i32 { wiSrvDiags[i].dEndCol }
export function wiDiagMsg(i: i32): string { wiSrvDiags[i].dMsg }
export function wiDiagMsgLen(i: i32): i32 { wiSrvDiags[i].dMsg.length }
export function wiDiagMsgAt(i: i32, j: i32): i32 { wiSrvDiags[i].dMsg[j] }

// Module `m`'s key as an importer's check banks it: the entry's canonical spelling, else its key.
function wiModKey(m: i32): string {
  if m == 0 { return wiKeyOf(modKeys[0]) }
  modKeys[m]
}

// Before a module check: serve the entry from its bank when that bank holds exactly this graph.
function wiServe(): boolean {
  if !wiOn || modKeys.length == 0 { return false }
  const key = wiKeyOf(modKeys[0])
  if (wiPending[key] ?? 0) == 0 { return false }
  wiPending[key] = 0
  const b = wiBanks[key]
  let ok = b != null
  if b != null {
    if b.wSrcs.length != modKeys.length { ok = false }
    let m = 0
    while ok && m < modKeys.length {
      const i = b.wKeys[wiModKey(m)] ?? -1
      if i < 0 || b.wSrcs[i] != modSrcs[m] || modFound[m] == 0 { ok = false }
      m = m + 1
    }
  }
  if !ok {
    let why = wiWhy[key] ?? WI_UNSEEN
    if b != null { why = WI_GRAPH }
    wiStats[why] = wiStats[why] + 1
    wiMods[why] = wiMods[why] + modKeys.length
    wiTrace.push(
      i32ToStr(why)
        + " "
        + modKeys[0]
        + " "
        + i32ToStr(modKeys.length)
        + " "
        + (wiWhyBy[key] ?? "-"),
    )
    return false
  }
  if b != null {
    plSrcs = []
    plLinks = []
    plStrIdx = []
    plScalar = []
    let m = 0
    while m < modKeys.length {
      const i = b.wKeys[wiModKey(m)] ?? -1
      plSrcs.push(modSrcs[m])
      plLinks.push(b.wPlus[i])
      plStrIdx.push(b.wStrIdx[i])
      plScalar.push(b.wScalar[i])
      m = m + 1
    }
    plBankGen = plGen
    wiSrvDiags = b.wDiags
    wiSrvRc = b.wRc
  }
  mimpClear()
  vcEpDrop()
  wiStats[WI_SERVED] = wiStats[WI_SERVED] + 1
  wiMods[WI_SERVED] = wiMods[WI_SERVED] + modKeys.length
  wiServedLast = true
  true
}

// After a whole module check with no parse errors: bank every pending target the graph holds
// as a module other than the entry, when `wiGuard` finds its own check could not differ. A
// check with type errors never runs the deep-`is` pass, and neither does a target's own check
// when its closure holds one of them (`wiDeepIsIn`).
function wiBankWhole(roots: i32[]): i32 {
  wiDirtyNow = T.diags.length > 0
  wiDiagMods = []
  wiOutsideWhy = ""
  if pinAdoptUndid { wiOutsideWhy = "(adoption undone)" }
  if wsRefusalUndid { wiOutsideWhy = "(width rewrite undone)" }
  if diagKeyDrops > 0 { wiOutsideWhy = "(repeat refusal dropped)" }
  const placed = !wiDirtyNow || wiDiagsPlaced()
  const clean = P.diags.length == 0
    && (wiDirtyNow || jwSiteNode.length == 0)
    && mimpMissed.length == 0
    && !fsAsked()
    && fsModeOf() == FS_COMPILE
    && placed
  const pos = skPosOf()
  let ready = false
  let m = 1
  while m < modKeys.length {
    const key = modKeys[m]
    if wiTry(key) {
      let why = WI_DIRTY
      if clean && !ready {
        wiPrep()
        ready = true
      }
      wiCulprit = -1
      if !placed { wiCulpritName = "(unplaced error)" }
      if clean { why = wiGuard(m, roots, pos) }
      if why == WI_SERVED { wiBankOne(m) } else { wiBlame(key, why) }
    }
    m = m + 1
  }
  0
}

// Whether every type error of this check is anchored in a module (`wiDiagMods`), renders
// with no merge spelling left in it, and holds a position no other error holds, since the
// report orders errors at one position by their check order.
function wiDiagsPlaced(): boolean {
  wiDiagTexts()
  const seen: {[string]: boolean} = Map()
  let j = 0
  while j < wiDiagMods.length {
    const m = wiDiagMods[j]
    if m < 0 { return false }
    const msg = wiDiagMsgs[j]
    if strContains(msg, "#") || strContains(msg, "$") { return false }
    const at = i32ToStr(m)
      + ":"
      + i32ToStr(T.diags[j].tline)
      + ":"
      + i32ToStr(T.diags[j].tcol)
    if seen.has(at) { return false }
    seen[at] = true
    j = j + 1
  }
  true
}

// Each type error of this check: its module (-1 when it has none) and its rendered message.
function wiDiagTexts(): i32 {
  wiDiagMods = []
  wiDiagMsgs = []
  let j = 0
  while j < T.diags.length {
    wiDiagMods.push(skDiagMod(j))
    wiDiagMsgs.push(vcDiagMsg(P.diags.length + j))
    j = j + 1
  }
  0
}

// Whether an error message names a type declared outside `inG`, the one way an outside
// declaration reaches the text of an error placed in G: a type renders by a declared name.
function wiDiagNamesOut(inG: boolean[]): boolean {
  let k = 0
  while k < wiDiagMsgs.length {
    const msg = wiDiagMsgs[k]
    const m = wiDiagMods[k]
    k = k + 1
    if m < 0 || m >= inG.length || !inG[m] { continue }
    const w = wiWordOut(msg, inG)
    if w != "" {
      wiCulpritName = "(error names " + w + ")"
      return true
    }
  }
  false
}

function wiIdentChar(c: i32): boolean {
  (c >= 'a' && c <= 'z')
    || (c >= 'A' && c <= 'Z')
    || (c >= '0' && c <= '9')
    || c == '_'
}

// Record the reason a guard declined target `key` and the module it named, so no later graph
// holding that module tries it again.
function wiBlame(key: string, why: i32): i32 {
  wiWhy[key] = why
  let by = "*"
  if wiCulprit >= 0 && wiCulprit < modKeys.length { by = modKeys[wiCulprit] }
  wiWhyBy[key] = by + " " + wiCulpritName
  wiCulpritName = ""
  if wiCulprit == WI_ANY { wiNever[key] = true }
  if wiCulprit < 0 || wiCulprit >= modKeys.length { return 0 }
  const cs = wiCulprits[key] ?? []
  cs.push(modKeys[wiCulprit])
  wiCulprits[key] = cs
  0
}

// The per-check reads every guard of one bank pass shares.
function wiPrep(): i32 {
  wiDeps = []
  for _ in modKeys {
    const none: i32[] = []
    wiDeps.push(none)
  }
  let k = 0
  while k < impMod.length {
    const d = modIndexOfKey(impKey[k])
    const f = impMod[k]
    if d >= 0 && f >= 0 && f < wiDeps.length { wiDeps[f].push(d) }
    k = k + 1
  }
  wiImpTo = []
  wiImpOrigin = []
  wiImpMerged = []
  wiImpShut = []
  k = 0
  while k < impMod.length {
    const d = modIndexOfKey(impKey[k])
    let om = -1
    let merged = ""
    if d >= 0 {
      const nm = skImportName(k)
      if nm != "" {
        const o = modExportOrigin(d, nm)
        om = o.oMod
        merged = o.oName + modSuffixOf(o.oMod)
      }
    }
    wiImpTo.push(d)
    wiImpOrigin.push(om)
    wiImpMerged.push(merged)
    wiImpShut.push(-1)
    k = k + 1
  }
  wiNow = skDelivNow()
  wiAsksAll = skAsksNow([])
  wiIndexed = false
  0
}

// The modules target `t` imports, closed, with `t` itself.
function wiClosure(t: i32): boolean[] {
  const inG: boolean[] = []
  for _ in modKeys { inG.push(false) }
  inG[t] = true
  const work: i32[] = [t]
  let w = 0
  while w < work.length {
    const f = work[w]
    if f >= 0 && f < wiDeps.length {
      for d in wiDeps[f] {
        if !inG[d] {
          inG[d] = true
          work.push(d)
        }
      }
    }
    w = w + 1
  }
  inG
}

// Why module `t`'s own check may differ from this check's reading of its closure G, or `WI_SERVED`:
// an error outside G may have changed G (`wiOutsideWhy`); an entry-only rule reads it; an import is
// not shut; a fresh value crosses G's edge; a name G asked about is written or used outside it; an
// ambient statement outside meets G's words; or G asked about a body outside it.
function wiGuard(t: i32, roots: i32[], pos: i32[]): i32 {
  const inG = wiClosure(t)
  let mine = 0
  for m in wiDiagMods {
    if inG[m] { mine = mine + 1 }
  }
  if mine < wiDiagMods.length && (wiMask & WI_NO_OUTSIDE) == 0 {
    if wiOutsideWhy != "" {
      wiCulpritName = wiOutsideWhy
      return WI_DIRTY
    }
    if mine == 0 && wiDeepIsIn(inG) {
      wiCulpritName = "(deep is)"
      return WI_DIRTY
    }
  }
  if (wiMask & WI_NO_ENTRY) == 0 && !wiEntryNeutral(t, roots[pos[t]]) {
    wiCulprit = WI_ANY
    return WI_ENTRY
  }
  if (wiMask & WI_NO_DEMAND) == 0 && !wiDemandShut(inG, roots, pos) {
    return WI_DEMAND
  }
  if (wiMask & WI_NO_FRESH) == 0 && wiFreshCrosses(inG) { return WI_FRESH }
  if ((wiMask & WI_NO_WRITER) == 0 && skWriterMoved(inG, wiAsksAll, false)) {
    return WI_WRITER
  }
  if (wiMask & WI_NO_AMBIENT) == 0 {
    if !wiIndexed {
      ihAmbientIndex()
      wiIndexed = true
    }
    if wiDirtyNow && (wiMask & WI_NO_DIAG_NAMES) == 0 && wiDiagNamesOut(inG) {
      wiCulprit = WI_ANY
      return WI_AMBIENT
    }
    const only: boolean[] = []
    for _ in modKeys { only.push(false) }
    only[t] = true
    wiRowTextsIn(only)
    const named = (wiMask & WI_NO_RENDER) == 0 && wiRowsIn(inG)
    const meets = ihAmbientMeetsIn(
      inG,
      wiDirtyNow,
      (wiMask & WI_NO_ARENA) == 0,
      named,
      !named && (wiMask & WI_NO_TWIN) == 0,
    )
    let m = 0
    while m < modKeys.length && m < meets.length {
      if !inG[m] && meets[m] {
        wiCulprit = m
        wiCulpritName = ihAmbientWhy(m)
        if wiCulpritName == "rows" { wiCulpritName = "rows " + wiRowsWhy }
        return WI_AMBIENT
      }
      m = m + 1
    }
    if (
      (wiMask & WI_NO_LIT_ORDER) == 0
      && (wiLitRowsIn(inG) || wiDirtyNow && wiLitDiagsIn(inG))
    ) {
      wiCulprit = WI_ANY
      return WI_AMBIENT
    }
  }
  if (wiMask & WI_NO_ASKS) == 0 && wiAsksOut(inG) { return WI_ASKS }
  WI_SERVED
}

// The report rows of the modules in `inG`: each row's stream and the text it renders types into.
function wiRowTextsIn(inG: boolean[]): i32 {
  wiRowKind = []
  wiRowText = []
  let i = 0
  while i < redunCount() {
    if wiModIn(redunModuleAt(i), inG) { wiRowAdd("redun", redunTypeAt(i)) }
    i = i + 1
  }
  i = 0
  while i < rcoalCount() {
    if wiModIn(rcoalModuleAt(i), inG) { wiRowAdd("rcoal", rcoalMsgAt(i)) }
    i = i + 1
  }
  i = 0
  while i < isvalCount() {
    if wiModIn(isvalModuleAt(i), inG) { wiRowAdd("isval", isvalMsgAt(i)) }
    i = i + 1
  }
  i = 0
  while i < expInfCount() {
    if wiModIn(expInfModuleAt(i), inG) {
      wiRowAdd("expInf", expInfMsgAt(i) + " " + expInfTypeAt(i))
    }
    i = i + 1
  }
  0
}

function wiModIn(m: i32, inG: boolean[]): boolean {
  m >= 0 && m < inG.length && inG[m]
}

function wiRowAdd(kind: string, text: string): void {
  wiRowKind.push(kind)
  wiRowText.push(text)
}

// Whether a row `wiRowTextsIn` read renders a type that may read otherwise in the root's own check:
// one still holding a merge spelling, or naming a type a module outside `inG` declares. The
// root's own check holds a subset of the declarations, so any other word renders the same.
function wiRowsIn(inG: boolean[]): boolean {
  let i = 0
  while i < wiRowText.length {
    const s = wiRowText[i]
    let out = wiMangled(s)
    if !out && (wiMask & WI_NO_INERT_OUT) == 0 { out = wiWordOut(s, inG) != "" }
    if out {
      wiRowsWhy = wiRowKind[i] + ":" + s
      return true
    }
    i = i + 1
  }
  false
}

// Whether `s` holds a spelling the merge numbered by its company: a `#` alias, a `$` suffix other
// than a module id, or a module id from a graph that salted one.
function wiMangled(s: string): boolean {
  let i = 0
  while i < s.length {
    if s[i] == '#' { return true }
    if s[i] == '$' {
      const id = i + 2 < s.length
        && s[i + 1] == 'm'
        && s[i + 2] >= '0'
        && s[i + 2] <= '9'
      if !id || midSalted { return true }
    }
    i = i + 1
  }
  false
}

// The first word of `s` that names a type or union declared outside `inG`, or "".
function wiWordOut(s: string, inG: boolean[]): string {
  for w in wiWords(s) {
    if ihNameDeclaredOut(w, inG) { return w }
  }
  ""
}

// The identifier words of `s`, in order.
function wiWords(s: string): string[] {
  const o: string[] = []
  let i = 0
  while i < s.length {
    let j = i
    while j < s.length && wiIdentChar(s[j]) { j = j + 1 }
    if j > i {
      o.push(s.slice(i, j))
      i = j
    } else {
      i = i + 1
    }
  }
  o
}

// Whether text `s` renders a string literal union by its members, or by a name G alone declares
// for a set another alias also names. Such a set renders as the check first interned it, and
// the check of a bigger graph may intern it first in another order or under another name.
function wiLitOrdered(s: string, inG: boolean[]): boolean {
  if strContains(s, "\" | ") || strContains(s, " | \"") { return true }
  for w in wiWords(s) {
    if (
      ihNameIsLitUnion(w)
      && !ihNameDeclaredOut(w, inG)
      && ihLitUnionTwinned(w)
    ) {
      return true
    }
  }
  false
}

// Whether a row `wiRowTextsIn` read renders a string literal union.
function wiLitRowsIn(inG: boolean[]): boolean {
  let i = 0
  while i < wiRowText.length {
    if wiLitOrdered(wiRowText[i], inG) {
      wiCulpritName = "(literal union in " + wiRowKind[i] + ")"
      return true
    }
    i = i + 1
  }
  false
}

// Whether an error `wiDiagTexts` read, placed in `inG`, renders a string literal union.
function wiLitDiagsIn(inG: boolean[]): boolean {
  let i = 0
  while i < wiDiagMsgs.length && i < wiDiagMods.length {
    if wiModIn(wiDiagMods[i], inG) && wiLitOrdered(wiDiagMsgs[i], inG) {
      wiCulpritName = "(literal union in error)"
      return true
    }
    i = i + 1
  }
  false
}

// Whether a deep-`is` site lies in `inG`: a check with errors never runs that pass, and a
// closure with none of them would.
function wiDeepIsIn(inG: boolean[]): boolean {
  for nd in jwSiteNode {
    const m = skNodeMod(nd)
    if m < 0 || m >= inG.length || inG[m] { return true }
  }
  false
}

// Whether module `t` (rooted at `root`) reads the same as an entry: each exported function is
// closed and not generic, so no uncalled export is inferred or refused, and no overloaded call
// in it waits on a receiver only a caller would give.
function wiEntryNeutral(t: i32, root: i32): boolean {
  const r = nodeAt(root)
  if r is Program {
    for st in r.progStmts {
      const n = nodeAt(st)
      if n is FuncDecl && declIsExportedFn(st) {
        if n.fnTyParams.length > 0 || !skParamsClosed(n.fnParams) {
          return false
        }
      }
    }
  }
  for s in ovHoleSites {
    if skNodeMod(s) == t { return false }
  }
  true
}

// Whether every import from outside G of a declaration in G names one `skClosed` shuts, or a
// closed generic the importer only calls, and this check's adoption did not retype (`wiAdopted`).
function wiDemandShut(inG: boolean[], roots: i32[], pos: i32[]): boolean {
  let k = 0
  while k < impMod.length && k < wiImpTo.length {
    const d = wiImpTo[k]
    if !inG[impMod[k]] && d >= 0 {
      const om = wiImpOrigin[k]
      if om < 0 {
        if inG[d] && skImportName(k) != "" {
          wiCulprit = impMod[k]
          wiCulpritName = "(namespace)"
          return false
        }
      } else if inG[om] {
        if wiImpShut[k] < 0 {
          const root = roots[pos[om]]
          const nm = wiImpMerged[k]
          const c = skClosed(root, nm)
          const kept = c == SK_IF_KEPT
            && (wiMask & WI_NO_KEPT) == 0
            && skCallsOnly(roots[pos[impMod[k]]], nm)
          const called = c == SK_IF_PLAIN
            && (wiMask & WI_NO_CALLED) == 0
            && wiInitShut(root, nm)
          wiImpShut[k] = if (c == SK_SHUT || kept || called)
            && ((wiMask & WI_NO_ADOPTED) != 0 || !wiAdopted(root, nm)) { 1 } else { 0 }
        }
        if wiImpShut[k] == 0 {
          wiCulprit = impMod[k]
          wiCulpritName = wiImpMerged[k]
          return false
        }
      }
    }
    k = k + 1
  }
  true
}

// Whether the un-annotated binding `merged` of the module rooted at `root` has a type its own
// initialiser fixes, so no importer's use can choose it: a non-empty list of scalar literals and
// names of a primitive type, or a call of a closed, non-overloaded function with a declared
// return type whose type parameters its scalar arguments fix (`wiClosedCall`).
function wiInitShut(root: i32, merged: string): boolean {
  const r = nodeAt(root)
  if r is Program {
    for st in r.progStmts {
      const n = nodeAt(st)
      if n is LetDecl && n.letName == merged {
        return wiScalarList(n.letInit) || wiClosedCall(n.letInit)
      }
    }
  }
  false
}

// Whether node `e` is a non-empty list literal of scalar literals and names of a primitive type.
function wiScalarList(e: i32): boolean {
  if e < 0 || e >= P.nodes.length { return false }
  const c = nodeAt(e)
  if !(c is ArrayLit) || c.arrElems.length == 0 { return false }
  for x in c.arrElems {
    if !skSignedLit(x) && !wiPrimName(x) { return false }
  }
  true
}

// Whether node `x` is a name whose checked type is a primitive.
function wiPrimName(x: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  n is Ident && tyIsPrimIx(identTyOf(x, n.identName))
}

// Whether node `e` calls, by name, one closed function with a declared return type and no
// overload set, and when it is generic, binds each type parameter at a parameter annotated as
// exactly that name to a scalar literal or primitive name, no other annotation naming one.
function wiClosedCall(e: i32): boolean {
  if e < 0 || e >= P.nodes.length { return false }
  const c = nodeAt(e)
  if !(c is Call) || c.callFn < 0 || c.callFn >= P.nodes.length { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) { return false }
  for cs in ovSetCands {
    for cand in cs {
      if cand == f.identName { return false }
    }
  }
  const d = fnDeclIx[f.identName] ?? -1
  if d < 0 || d >= P.nodes.length { return false }
  const fd = nodeAt(d)
  if !(fd is FuncDecl) || fd.fnName != f.identName || fd.fnRet < 0 {
    return false
  }
  if !skParamsClosed(fd.fnParams) { return false }
  if fd.fnTyParams.length == 0 { return true }
  if callHasTyArgs(e) || hasNamedArgs(c.callArgNames) { return false }
  const bound: {[string]: boolean} = Map()
  let i = 0
  while i < fd.fnParams.length {
    const p = nodeAt(fd.fnParams[i])
    if !(p is Param) || p.parType < 0 || p.parType >= P.nodes.length {
      return false
    }
    const a = nodeAt(p.parType)
    if !(a is TypeRef) { return false }
    let exact = false
    for tp in fd.fnTyParams {
      if a.tyName == tp {
        exact = true
        let x = -1
        if i < c.callArgs.length { x = c.callArgs[i] }
        if p.parRest != 0 || !(skSignedLit(x) || wiPrimName(x)) { return false }
        bound[tp] = true
      } else if a.tyName.indexOf(tp) >= 0 {
        return false
      }
    }
    if !exact && i >= c.callArgs.length && p.parDefault < 0 { return false }
    i = i + 1
  }
  for tp in fd.fnTyParams {
    if !bound.has(tp) { return false }
  }
  c.callArgs.length <= fd.fnParams.length
}

// Whether declaration `merged` of the module rooted at `root` carries a type this check's
// adoption wrote over it: an importer outside G may have chosen it, so its spelling is not its own.
function wiAdopted(root: i32, merged: string): boolean {
  if recAdOrigDecl.length == 0 { return false }
  const r = nodeAt(root)
  if r is Program {
    for st in r.progStmts {
      const n = nodeAt(st)
      if (
        (n is LetDecl && n.letName == merged)
        || (n is FuncDecl && n.fnName == merged)
      ) {
        for d in recAdOrigDecl {
          if d == st { return true }
        }
      }
    }
  }
  false
}

// Whether a fresh value crosses G's edge: one the check could not place, one of G delivered
// outside G or the reverse, or one of G a delivery judged that is spelled outside G.
function wiFreshCrosses(inG: boolean[]): boolean {
  const now = wiNow
  if now.has(SK_UNATTRIBUTED) { return true }
  const counted: string[] = []
  for key in now.keys() {
    const dm = modIndexOfKey(key.slice(0, key.indexOf("\n")))
    if dm < 0 { return true }
    const row = now[key] ?? Map()
    let flags = 0
    for mk in row.keys() {
      const am = modIndexOfKey(mk)
      if am >= 0 && inG[am] != inG[dm] {
        wiCulprit = if inG[am] { dm } else { am }
      }
      if am < 0 || inG[am] != inG[dm] { return true }
      flags = flags | (row[mk] ?? 0)
    }
    if inG[dm] && (flags & WI_COUNTED) != 0 { counted.push(key) }
  }
  if counted.length == 0 { return false }
  const out: boolean[] = []
  for x in inG { out.push(!x) }
  const occ = ihOccDigests(counted, out)
  for key in counted {
    let m = 0
    while m < modKeys.length {
      if !inG[m] && occ.has(key + "\n" + modKeys[m]) {
        wiCulprit = m
        return true
      }
      m = m + 1
    }
  }
  false
}

// Whether a statement of G asked a write question about a declaration outside G, or one the
// check could not place.
function wiAsksOut(inG: boolean[]): boolean {
  const qs = crAskQs
  let j = 0
  while j + 3 < qs.length {
    const at = qs[j]
    if at >= 0 && at < P.toks.length {
      const am = modOfTok(at)
      if am >= 0 && am < inG.length && inG[am] {
        const dm = skNodeMod(qs[j + 2])
        if dm >= 0 && dm < inG.length && !inG[dm] { wiCulprit = dm }
        if dm < 0 || dm >= inG.length || !inG[dm] { return true }
      }
    }
    j = j + 4
  }
  false
}

// Bank target module `t`: its closure's keys and sources, each one's lint sites, and the errors
// placed in the closure, with rc 2 when there are any.
function wiBankOne(t: i32): i32 {
  const inG = wiClosure(t)
  const b: WiBank = {
    wKeys: Map(),
    wSrcs: [],
    wPlus: [],
    wStrIdx: [],
    wScalar: [],
    wDiags: [],
    wRc: 0,
  }
  let j = 0
  while wiDirtyNow && j < T.diags.length {
    const i = P.diags.length + j
    if inG[wiDiagMods[j]] {
      b.wDiags.push(
        {
          dKey: modKeys[wiDiagMods[j]],
          dLine: diagLine(i),
          dCol: diagCol(i),
          dEndLine: diagEndLine(i),
          dEndCol: diagEndCol(i),
          dMsg: wiDiagMsgs[j],
        },
      )
    }
    j = j + 1
  }
  if b.wDiags.length > 0 { b.wRc = 2 }
  let m = 0
  while m < modKeys.length {
    if inG[m] {
      if m >= plLinks.length { return 0 }
      b.wKeys[modKeys[m]] = b.wSrcs.length
      b.wSrcs.push(modSrcs[m])
      b.wPlus.push(plLinks[m])
      b.wStrIdx.push(plStrIdx[m])
      b.wScalar.push(plScalar[m])
    }
    m = m + 1
  }
  wiBanks[modKeys[t]] = b
  wiBankedKeys.push(modKeys[t])
  wiBankedMods.push(t)
  wiBankedHolds.push(wiDirtyNow && b.wRc == 0)
  0
}

// ── per-module rename map (state at the top of this file) ─────────────────────
// `sid(name)` → row → `modRenameTo[row]`: every top-level name maps to `name$mN`;
// an imported local maps to the exporting module's mangled name. A generic type
// (`Box<T>`) renames by its base segment, so every application rewrites consistently.
function modDeclBase(ix: i32, name: string): string {
  const b = declGpBaseOf(ix)
  if b != "" { return b }
  name
}
// Carries the merge's rename into the bank immediately after it lands in the
// declared name, so `modTypeRenamed` gives the bare base exactly the head segment
// it gave the folded name — the two cannot drift. A stale base here would register
// the alias under `Box` while every application spells `Box$m1`.
function modRwDeclBase(ix: i32): i32 {
  const b = declGpBaseOf(ix)
  if b != "" { setDeclGpBase(ix, modTypeRenamed(b)) }
  0
}
// The reserved-name rules, in a module either: a `type` may not take a builtin type name
// (D1585), a `function` or `const` may not take a compiler intrinsic's (D2263). The checker's
// own screens run after the merge rename, when the name reads `f64$mN` and matches neither, so
// this runs before it, per module, raising through the checker's channels.
function modCheckReservedDecls(root: i32): i32 {
  const r = nodeAt(root)
  if r is Program {
    const ss = r.progStmts
    let si = 0
    while si < ss.length {
      const st = nodeAt(ss[si])
      let tyNm = ""
      let valNm = ""
      if st is TypeDecl { tyNm = st.tdName }
      if st is UnionDecl { tyNm = st.udName }
      if st is FuncDecl { valNm = st.fnName }
      if st is LetDecl { valNm = st.letName }
      if tyNm != "" && isBuiltinTyName(tyNm) { tErrBuiltinTyDecl(tyNm, ss[si]) }
      if valNm != "" { checkNotIntrinsicName(valNm, ss[si]) }
      si = si + 1
    }
  }
  0
}
// D2268 — an import's local binding (an `import` or a re-export, aliased or not) may not take
// a compiler intrinsic's name either: the merge maps the local to its target, so every call
// in the module would silently reach the import. Anchored at the local's own token, found in
// the module's token range `[t0, t1)` by the position `modScan` recorded for the source name.
function modCheckReservedImports(m: i32, root: i32, t0: i32, t1: i32): i32 {
  for ii in modImpRowsOf(m) {
    const local = impLocal[ii]
    if impName[ii] != "" && isReservedIntrinsicName(local) {
      let tk = -1
      let t = t0
      while t < t1 && tk < 0 {
        const tok = P.toks[t]
        if tok.line == impNameLine[ii] && tok.col == impNameCol[ii] { tk = t }
        t = t + 1
      }
      // The alias follows `as`, two tokens on; the bare form binds the name token itself.
      if tk >= 0 && local != impName[ii] {
        if tk + 2 < t1 && P.toks[tk + 2].text == local {
          tk = tk + 2
        } else {
          tk = -1
        }
      }
      checkNotIntrinsicImportLocal(local, root, tk)
    }
  }
  0
}
// Each module's rows of the `imp*` tables, ascending, built once per `modCompile` before the
// per-module passes, so each walks its own imports rather than every module's.
let modImpRows: i32[][] = []
function modImpRowsBuild(): i32 {
  modImpRows = []
  for _ in modKeys { modImpRows.push([]) }
  let k = 0
  while k < impMod.length {
    const m = impMod[k]
    if m >= 0 && m < modImpRows.length { modImpRows[m].push(k) }
    k = k + 1
  }
  0
}
// Module `m`'s import rows, or none for an index outside the table.
function modImpRowsOf(m: i32): i32[] {
  if m < 0 || m >= modImpRows.length { return [] }
  modImpRows[m]
}
// A type-position name only a `type` row may rename: a built-in type, or `Map`/`Set`, whose
// value of the same name (an ambient function) a declaration may shadow without taking the type.
function tyNameTypeRowOnly(name: string): boolean {
  isBuiltinTyName(name) || name == "Map" || name == "Set"
}
// The type-position rename of one identifier segment — the last matching row's
// target, or the segment unchanged. D1571's gate lives here rather than in either
// reader, since the spelling tree and the character scanner are two spellings of
// one question, and a guard in only one is the same defect on the other route.
function modTyRenamedSeg(seg: string) {
  const row = sidArrGet(modRenameLastBySid, sidLookup(seg))
  if row < 0 { return seg }
  // A builtin type name is renamed only by a `type` row. Every other segment keeps
  // the last-row rule byte for byte, since a user name that is both a type and a
  // value mints one target for both.
  if tyNameTypeRowOnly(seg) {
    if !strListHas(modBuiltinTyTargets, modRenameTo[row]) { return seg }
  }
  modRenameTo[row]
}
// Empties the rename map. The sid views keep their length and reset only the slots a row set,
// by position, so no row survives into the next map even across a `sidReset`.
function modRenameClear() {
  for s in modRenameSids {
    modRenameFirstBySid[s] = -1
    modRenameLastBySid[s] = -1
  }
  modRenameSids = []
  modRenameTo = []
  modRenameFrom = []
  modRenameRowSid = []
  0
}
// Appends one row to the rename map and indexes it under its interned `from`.
function modRenamePush(from: string, to: string): i32 {
  const row = modRenameTo.length
  const canon = modCanonTo[to] ?? ""
  if canon != "" {
    modRenameTo.push(canon)
  } else {
    modCanonTo[to] = to
    modRenameTo.push(to)
  }
  modRenameFrom.push(from)
  const s = sidOf(from)
  modRenameRowSid.push(s)
  modRenameIndexRow(s, row)
}
// Files row `row`, whose `from` interns to `s`, in the two sid views.
function modRenameIndexRow(s: i32, row: i32): i32 {
  if sidArrGet(modRenameFirstBySid, s) < 0 {
    modRenameSids.push(s)
    sidArrPut(modRenameFirstBySid, s, row)
  }
  sidArrPut(modRenameLastBySid, s, row)
  0
}
// Keeps the live map as the o-th module's, for `modRenameReplay`. The arrays are kept by
// reference: `modRenameClear` replaces them rather than emptying them.
function modRenameKeep(o: i32): i32 {
  while modRenameKeptTo.length <= o {
    modRenameKeptTo.push([])
    modRenameKeptFrom.push([])
    modRenameKeptSid.push([])
  }
  modRenameKeptTo[o] = modRenameTo
  modRenameKeptFrom[o] = modRenameFrom
  modRenameKeptSid[o] = modRenameRowSid
  0
}
// Makes the o-th module's kept map the live one, rows and sid views as `modBuildRename` left
// them. Its inputs (the module's declarations, its imports, the export tables) are fixed
// between the collect pass that kept it and the rewrite of that module.
function modRenameReplay(o: i32): i32 {
  modRenameClear()
  modRenameTo = modRenameKeptTo[o]
  modRenameFrom = modRenameKeptFrom[o]
  modRenameRowSid = modRenameKeptSid[o]
  let row = 0
  while row < modRenameRowSid.length {
    modRenameIndexRow(modRenameRowSid[row], row)
    row = row + 1
  }
  0
}
function modBuildRename(m: i32, root: i32): i32 {
  modRenameClear()
  const impLocals: string[] = []
  const rows = modImpRowsOf(m)
  for ii in rows {
    if impLocal[ii] != "" { impLocals.push(impLocal[ii]) }
  }
  const suffix = modSuffixOf(m)
  const r = nodeAt(root)
  if r is Program {
    const ss = r.progStmts
    let si = 0
    while si < ss.length {
      const st = nodeAt(ss[si])
      let nm = ""
      if st is FuncDecl { nm = st.fnName }
      if st is LetDecl { nm = st.letName }
      if st is TypeDecl { nm = st.tdName }
      if st is UnionDecl { nm = st.udName }
      if nm != "" {
        // Declarations land ahead of the imports, so a value reference to a name both bind
        // takes the local one (`modRenamed` reads the first row); `modCheckOverloads` decides
        // whether the two may coexist at all.
        const base = modDeclBase(ss[si], nm)
        modRenamePush(base, base + suffix)
        // D1571 — a `type` declaration that took a BUILTIN name is the one row that may
        // rewrite that name in type position. Registered on the TARGET, so an IMPORT of it
        // needs no kind of its own: the import row renames onto this same `base$mN`.
        if tyNameTypeRowOnly(base) {
          let isTyDecl = false
          if st is TypeDecl { isTyDecl = true }
          if st is UnionDecl { isTyDecl = true }
          if isTyDecl {
            if !strListHas(modBuiltinTyTargets, base + suffix) {
              modBuiltinTyTargets.push(base + suffix)
            }
          }
        }
      }
      si = si + 1
    }
  }
  // The module's own `extern function` declarations. They are not `progStmts`, so the loop
  // above cannot see them — but their VL name has to be mangled for the same reason a
  // function's is: an extern the module did not export must not be reachable by spelling it.
  // The LINK name is untouched, so the import section still carries what the author wrote.
  let xd = 0
  while xd < externDeclCount() {
    if extDeclMod[xd] == m {
      const xbase = externNameAt(extDeclLink[xd])
      if xbase != "" && !strListHas(impLocals, xbase) {
        modRenamePush(xbase, xbase + suffix)
        externRenameDecl(xd, xbase + suffix)
      }
    }
    xd = xd + 1
  }
  for ij in rows {
    if impLocal[ij] != "" {
      const dd = modIndexOfKey(impKey[ij])
      // The dep may only RE-EXPORT this name rather than declare it, so the
      // target is the chased declaration, not the flat `impName[ij]$mdd` (which
      // would rewrite every reference onto a name the merge never defines).
      if dd >= 0 {
        modRenamePush(impLocal[ij], modMergedTargetOf(dd, impName[ij]))
      }
    }
  }
  // The template renderer's row — the far half of the injected import. An ordinary
  // rename row, taking the identical path an author's own import would; what makes
  // it non-pollution is only its `from` key, which no program can spell. Minted for
  // every module whenever `std:fmt` is in the table, even if the author imported it too.
  const fm = modIndexOfKey(TPL_RENDER_MODULE)
  if fm >= 0 {
    modRenamePush(TPL_RENDER_LOCAL, modMergedTargetOf(fm, TPL_RENDER_EXPORT))
  }
  0
}
// Records every top-level free `self`-function of each module under its mangled
// name, so a cross-module UFCS member-call can resolve its callee through the
// merge. Runs with each module's rename map live, so `shout` registers as
// `shout$mN`, the name the rewritten `memProp` and merged `FuncDecl` will carry.
function modCollectSelfFns(roots: i32[]): i32 {
  modSelfFnReset()
  let o = 0
  while o < roots.length {
    const m = modOrder[o]
    modBuildRename(m, roots[o])
    modRenameKeep(o)
    modShadow = []
    modShadowTo = []
    const r = nodeAt(roots[o])
    if r is Program {
      const ss = r.progStmts
      let si = 0
      while si < ss.length {
        const st = nodeAt(ss[si])
        if st is FuncDecl {
          if st.fnParams.length > 0 {
            const p0 = nodeAt(st.fnParams[0])
            if p0 is Param {
              if p0.parName == "self" {
                // `modDeclBase` strips a generic parameter list; the base segment is
                // what the rename map keys on. A `FuncDecl` never folds one
                // (`fnTyParams` is out-of-name), so this is the identity here, kept
                // because the rename map is built through the same call.
                const sfBase = modDeclBase(ss[si], st.fnName)
                const sfMangled = modRenamed(sfBase)
                modSelfFnAdd(sfMangled)
                // D1230's registry, filled from the one walk that already has
                // both halves: the module index and its rename map.
                modNoteUfcsImportCand(m, sfBase, sfMangled)
              }
            }
          }
        }
        si = si + 1
      }
    }
    o = o + 1
  }
  0
}
// D1230 — one row of the registry: module `m` exports a free `self`-function
// spelled `base`, merged as `mangled`, nameable from the entry by some specifier.
// Recorded so the checker can turn a field-not-found error into a missing-import
// suggestion. Three gates skip a wrong one; it does not gate on the receiver type.
function modNoteUfcsImportCand(m: i32, base: string, mangled: string): i32 {
  if m == 0 || !modDeclExports(m, base) { return 0 }
  const spec = modUfcsSpecFromEntry(m)
  if spec == "" { return 0 }
  ufcsImpAdd(base, mangled, spec, modKeyIsEntryImported(modKeys[m]))
  0
}
// Whether the entry's own import rows already name `key` — the fact that decides both
// `modUfcsSpecFromEntry`'s first branch and D1230's "add to the existing import" phrasing,
// so the two never disagree about it.
function modKeyIsEntryImported(key: string): boolean {
  let i = 0
  while i < impMod.length {
    if impMod[i] == 0 && impKey[i] == key && impSpec[i] != "" { return true }
    i = i + 1
  }
  false
}
// The specifier the entry file can write to name module `m`, or "" when none is
// known-correct: either the entry already imports `m` (its specifier text is right
// by construction), or `m`'s key is an absolute `std:` specifier. A relative module
// the entry does not import falls through to "" rather than risk a wrong computed path.
function modUfcsSpecFromEntry(m: i32): string {
  const key = modKeys[m]
  let i = 0
  while i < impMod.length {
    if impMod[i] == 0 && impKey[i] == key && impSpec[i] != "" {
      return impSpec[i]
    }
    i = i + 1
  }
  if modIsStdSpec(key) { return key }
  ""
}
// Is `name` a merged top-level `self`-function?
function modSelfFnDeclared(name: string): boolean {
  modSelfFnSet[name] ?? false
}
// D1191 — module `m`'s UFCS scope, from the rename map already live for it: rows
// whose target is a `self`-function are exactly the plain names `m` may dispatch
// `x.name(…)` against. No arity filter — the reader that needs one compares whole
// function types, and a wrong arity is its refusal to make, not this table's.
function modBankUfcsScope(m: i32): i32 {
  let i = 0
  while i < modRenameFrom.length {
    if modSelfFnDeclared(modRenameTo[i]) {
      ufcsScopeAdd(
        m,
        modRenameFrom[i],
        modRenameTo[i],
        modExportsHas(m, modRenameFrom[i]),
      )
    }
    i = i + 1
  }
  0
}
// The distinct targets the live rename map binds `name` to, in row order (local first).
function modCandsOf(name: string): string[] {
  const out: string[] = []
  const s = sidLookup(name)
  const first = sidArrGet(modRenameFirstBySid, s)
  if first < 0 { return out }
  const last = sidArrGet(modRenameLastBySid, s)
  let r = first
  while r <= last {
    if modRenameFrom[r] == name && !strListHas(out, modRenameTo[r]) {
      out.push(modRenameTo[r])
    }
    r = r + 1
  }
  out
}
// The import row through which module `m` binds `name` to `target`, or -1 (its own).
function modOvImpRow(m: i32, name: string, target: string): i32 {
  let ii = 0
  while ii < impMod.length {
    if impMod[ii] == m && impLocal[ii] == name && impName[ii] != "" {
      const dd = modIndexOfKey(impKey[ii])
      if dd >= 0 && modMergedTargetOf(dd, impName[ii]) == target { return ii }
    }
    ii = ii + 1
  }
  -1
}
// Banks every name module `m`'s live rename map binds to two or more targets as a set.
// Whether the set may stand is `modCheckOverloads`' question, asked after the rewrite.
function modNoteOverloads(m: i32): i32 {
  let r = 0
  while r < modRenameFrom.length {
    const nm = modRenameFrom[r]
    const s = sidLookup(nm)
    if (
      sidArrGet(modRenameFirstBySid, s) == r
      && sidArrGet(modRenameLastBySid, s) != r
    ) {
      const cands = modCandsOf(nm)
      if cands.length > 1 {
        const specs: string[] = []
        for c in cands {
          const ii = modOvImpRow(m, nm, c)
          if ii >= 0 { specs.push(impSpec[ii]) } else { specs.push("") }
        }
        ovSetAdd(m, nm, cands, specs)
      }
    }
    r = r + 1
  }
  0
}
// A plain call or a value use of an overloaded name. The local declaration answers a plain
// call (lexical scope); any other use is refused once the set is known to be legal.
function modOvNoteUse(identIx: i32, callIx: i32, name: string): i32 {
  if ovSetMod.length == 0 || modRwMod < 0 { return 0 }
  if strListHas(modShadow, name) { return 0 }
  const row = ovSetOf(modRwMod, name)
  if row < 0 { return 0 }
  if callIx >= 0 && ovSetSpecs[row][0] == "" { return ovPlainAdd(callIx, row) }
  modOvUseIx.push(identIx)
  modOvUseRow.push(row)
  modOvUseCall.push(callIx >= 0)
  0
}
// Banks member call `ix` against its module's set for `prop`: one `self`-function among
// the candidates is the answer outright, several leave the choice to the receiver's type.
// False when `prop` names no set here, so the single-binding path runs unchanged.
function modOvMemberSite(ix: i32, prop: string): boolean {
  // A local binding of `prop` shadows the set, as it does a plain call.
  if ovSetMod.length == 0 || modRwMod < 0 { return false }
  const row = ovSetOf(modRwMod, prop)
  if row < 0 || strListHas(modShadow, prop) { return false }
  const selfs: string[] = []
  for c in ovSetCands[row] {
    if modSelfFnDeclared(c) { selfs.push(c) }
  }
  if selfs.length == 0 { return false }
  if selfs.length == 1 { ufcsSiteAdd(ix, selfs[0]) }
  ovSiteAdd(ix, row)
  true
}
// The token module `m` loaded at `line`:`col`, or -1.
function modTokAt(m: i32, line: i32, col: i32): i32 {
  let o = 0
  while o < modLoadMod.length {
    if modLoadMod[o] == m {
      let t1 = P.toks.length
      if o + 1 < modLoadStart.length { t1 = modLoadStart[o + 1] }
      let t = modLoadStart[o]
      while t < t1 {
        const tok = P.toks[t]
        if tok.line == line && tok.col == col { return t }
        t = t + 1
      }
      return -1
    }
    o = o + 1
  }
  -1
}
// The head class of a first-parameter spelling (`ovHeadsOverlap`): the outer constructor
// only, so `T[]` and `string[]` are both a list. A declared record, union or newtype is
// its own class, a one-member alias its member's; a union or anything open overlaps all.
function modOvHeadOfTs(
  root: i32,
  tps: string[],
  tyDecls: {[string]: i32},
  depth: i32,
): string {
  if root < 0 || depth <= 0 { return "any" }
  const k = tsKind[root]
  if k == TS_ARR { return "arr" }
  if k == TS_MAP { return "map" }
  if k == TS_FUNC { return "fn" }
  if k == TS_LITSTR { return "str" }
  if k == TS_LITNUM { return "num" }
  if k == TS_PAREN && tsKidCount[root] == 1 {
    return modOvHeadOfTs(tsKids[tsKidStart[root]], tps, tyDecls, depth - 1)
  }
  if k != TS_NAME && k != TS_APP { return "any" }
  const t = tsText[root]
  if t == "Map" { return "map" }
  if t == "Set" { return "set" }
  if k == TS_NAME {
    if strListHas(tps, t) { return "any" }
    const pc = ovPrimClass(t)
    if pc != "" { return pc }
  }
  const d = tyDecls[t] ?? -1
  if d < 0 { return "any" }
  const dn = nodeAt(d)
  if dn is TypeDecl { return "rec:" + t }
  if dn is UnionDecl {
    if dn.udNew != 0 { return "rec:" + t }
    if dn.udVariants.length > 1 { return "any" }
    const none: string[] = []
    return modOvHeadOfTs(udTsRootAt(d, 0), none, tyDecls, depth - 1)
  }
  "any"
}
// The head class of function declaration `ix`'s first parameter; "none" with no parameters.
function modOvHeadOfFn(ix: i32, tyDecls: {[string]: i32}): string {
  const fd = nodeAt(ix)
  if fd is FuncDecl {
    if fd.fnParams.length == 0 { return "none" }
    const p0 = nodeAt(fd.fnParams[0])
    if p0 is Param {
      if p0.parType < 0 || p0.parRest != 0 { return "any" }
      return modOvHeadOfTs(annTsOf(p0.parType), fd.fnTyParams, tyDecls, 8)
    }
  }
  "any"
}
// The token a set candidate is bound at in module `m`: its import's name, or its declaration's.
function modOvSiteTok(
  m: i32,
  name: string,
  cand: string,
  decls: {[string]: i32},
): i32 {
  const ii = modOvImpRow(m, name, cand)
  if ii >= 0 { return modTokAt(m, impNameLine[ii], impNameCol[ii]) }
  const d = decls[cand] ?? -1
  if d >= 0 { return declNameTokOf(d) }
  -1
}
// Decides every set the rewrite banked: functions whose heads are pairwise disjoint stand;
// any other pair is a duplicate binding at the later of the two binding sites. Then refuses
// the uses only a legal set reaches — a plain call with no local answer, a function value,
// and a re-export — each naming the candidates.
function modCheckOverloads(roots: i32[]): i32 {
  if ovSetMod.length == 0 { return 0 }
  const tyDecls: {[string]: i32} = Map()
  const fnDecls: {[string]: i32} = Map()
  // Every top-level declaration under the target its own module's rename row gives it
  // (`name$mN`, spelled from its name token, since a type's merged name follows the LAST row),
  // the binding site a refusal points at.
  const decls: {[string]: i32} = Map()
  let o = 0
  while o < roots.length && o < modOrder.length {
    const r = nodeAt(roots[o])
    if r is Program {
      for si in r.progStmts {
        const st = nodeAt(si)
        if st is FuncDecl { fnDecls[st.fnName] = si }
        if st is TypeDecl { tyDecls[modDeclBase(si, st.tdName)] = si }
        if st is UnionDecl { tyDecls[modDeclBase(si, st.udName)] = si }
        const tk = declNameTokOf(si)
        if tk >= 0 && tk < P.toks.length {
          decls[P.toks[tk].text + modSuffixOf(modOrder[o])] = si
        }
      }
    }
    o = o + 1
  }
  let row = 0
  while row < ovSetMod.length {
    modOvCheckSet(row, tyDecls, fnDecls, decls)
    row = row + 1
  }
  let re = 0
  while re < reExpMod.length {
    const rr = ovSetOf(reExpMod[re], reExpLocal[re])
    if rr >= 0 && !ovSetBad[rr] {
      P.diags.push(
        {
          msg: "`export { "
            + reExpPublic[re]
            + " } from` cannot re-export `"
            + reExpLocal[re]
            + "`: here it names "
            + ovCandsText(rr)
            + ", and a module exports one function per name — rename the one to re-export (`export { "
            + reExpLocal[re]
            + " as … } from`)",
          at: modTokAt(reExpMod[re], reExpNameLine[re], reExpNameCol[re]),
        },
      )
    }
    re = re + 1
  }
  let u = 0
  while u < modOvUseIx.length {
    const ur = modOvUseRow[u]
    if !ovSetBad[ur] {
      const nm = ovSetName[ur]
      let what = ", so it cannot be used as a function value"
      if modOvUseCall[u] {
        what = ", and a plain call does not choose between them"
      }
      P.diags.push(
        {
          msg: "`"
            + nm
            + "` names "
            + ovCandsText(ur)
            + what
            + " — call it as a method, `x."
            + nm
            + "(…)`, which picks by the receiver's type, or rename one with `as` on its import",
          at: nodeToks[modOvUseIx[u]],
        },
      )
    }
    u = u + 1
  }
  modOvUseIx = []
  modOvUseRow = []
  modOvUseCall = []
  0
}
// One set's verdict: heads recorded when it stands, the first overlapping pair reported
// when it does not (`ovSetBad`).
function modOvCheckSet(
  row: i32,
  tyDecls: {[string]: i32},
  fnDecls: {[string]: i32},
  decls: {[string]: i32},
): i32 {
  const cands = ovSetCands[row]
  const heads: string[] = []
  for c in cands {
    const d = fnDecls[c] ?? -1
    if d >= 0 { heads.push(modOvHeadOfFn(d, tyDecls)) } else { heads.push("") }
  }
  let i = 0
  while i < cands.length {
    let j = i + 1
    while j < cands.length {
      const notFns = heads[i] == "" || heads[j] == ""
      const sameShape = !notFns
        && modOvRecHeadsSameShape(heads[i], heads[j], tyDecls)
      if notFns || ovHeadsOverlap(heads[i], heads[j]) || sameShape {
        ovSetBad[row] = true
        modOvDupDiag(row, i, j, heads, notFns, decls)
        return 0
      }
      j = j + 1
    }
    i = i + 1
  }
  let k = 0
  while k < cands.length {
    ovFnHead[cands[k]] = heads[k]
    k = k + 1
  }
  0
}
// Whether heads `a` and `b` are two declared records of one shape. Records are structural, so
// two names of one shape are one type and one head class (owner ruling on D3870); a newtype
// (`new { … }`) stays its own.
function modOvRecHeadsSameShape(
  a: string,
  b: string,
  tyDecls: {[string]: i32},
): boolean {
  if a.length < 5 || b.length < 5 || a == b { return false }
  if a.slice(0, 4) != "rec:" || b.slice(0, 4) != "rec:" { return false }
  modDeclSameShape(
    tyDecls[a.slice(4, a.length)] ?? -1,
    tyDecls[b.slice(4, b.length)] ?? -1,
    tyDecls,
    8,
  )
}

// Whether type declarations `da` and `db` are records of one shape (`modTsSameShape`).
function modDeclSameShape(
  da: i32,
  db: i32,
  tyDecls: {[string]: i32},
  depth: i32,
): boolean {
  if da < 0 || db < 0 || depth <= 0 { return false }
  if da == db { return true }
  const an: string[] = []
  const at: i32[] = []
  const bn: string[] = []
  const bt: i32[] = []
  if (!modRecFields(da, -1, an, at) || !modRecFields(db, -1, bn, bt)) {
    return false
  }
  modFieldsSameShape(an, at, bn, bt, tyDecls, depth)
}

// Whether two field lists name the same fields, in any order, of one type each.
function modFieldsSameShape(
  an: string[],
  at: i32[],
  bn: string[],
  bt: i32[],
  tyDecls: {[string]: i32},
  depth: i32,
): boolean {
  if an.length != bn.length { return false }
  let i = 0
  while i < an.length {
    let j = 0
    while j < bn.length && bn[j] != an[i] { j = j + 1 }
    if j >= bn.length { return false }
    if !modTsSameShape(at[i], bt[j], tyDecls, depth - 1) { return false }
    i = i + 1
  }
  true
}

// The fields of a record: declaration `d` when it is a plain record (a newtype is no record),
// else inline object spelling `ts`; their names into `names`, type spellings into `tys`.
function modRecFields(d: i32, ts: i32, names: string[], tys: i32[]): boolean {
  if d >= 0 {
    const n = nodeAt(d)
    if !(n is TypeDecl) { return false }
    if n.tdNew != 0 { return false }
    for fi in n.tdFields {
      const f = nodeAt(fi)
      if !(f is FieldDef) { return false }
      names.push(f.fdName)
      tys.push(annTsOf(f.fdType))
    }
    return true
  }
  if ts < 0 || tsKind[ts] != TS_OBJ { return false }
  let k = 0
  while k < tsKidCount[ts] {
    const fk = tsKids[tsKidStart[ts] + k]
    if tsKind[fk] != TS_FIELD || tsKidCount[fk] != 1 { return false }
    names.push(tsText[fk])
    tys.push(tsKids[tsKidStart[fk]])
    k = k + 1
  }
  true
}

// Spelling `ts` with its aliases resolved: a parenthesised type is its member, and a name for a
// one-member alias (`type I = i32`) is that member's spelling.
function modTsResolved(ts: i32, tyDecls: {[string]: i32}, depth: i32): i32 {
  let t = ts
  let n = 0
  while t >= 0 && n < depth {
    if tsKind[t] == TS_PAREN && tsKidCount[t] == 1 {
      t = tsKids[tsKidStart[t]]
    } else if tsKind[t] == TS_NAME {
      const d = tyDecls[tsText[t]] ?? -1
      if d < 0 { return t }
      const dn = nodeAt(d)
      if !(dn is UnionDecl) { return t }
      if dn.udNew != 0 || dn.udVariants.length != 1 { return t }
      t = udTsRootAt(d, 0)
    } else {
      return t
    }
    n = n + 1
  }
  t
}

// The record declaration name spelling `ts` resolves to, or -1.
function modTsRecDecl(ts: i32, tyDecls: {[string]: i32}): i32 {
  if ts < 0 || tsKind[ts] != TS_NAME { return -1 }
  const d = tyDecls[tsText[ts]] ?? -1
  if d < 0 || !(nodeAt(d) is TypeDecl) { return -1 }
  d
}

// Whether type spellings `a` and `b` name one type: resolved through aliases, a record by its
// fields whether named or inline, and a function type by its parameter and result types, whose
// parameter names are documentation only.
function modTsSameShape(
  a0: i32,
  b0: i32,
  tyDecls: {[string]: i32},
  depth: i32,
): boolean {
  if a0 < 0 || b0 < 0 || depth <= 0 { return false }
  const a = modTsResolved(a0, tyDecls, depth)
  const b = modTsResolved(b0, tyDecls, depth)
  if a < 0 || b < 0 { return false }
  const da = modTsRecDecl(a, tyDecls)
  const db = modTsRecDecl(b, tyDecls)
  const aRec = da >= 0 || tsKind[a] == TS_OBJ
  const bRec = db >= 0 || tsKind[b] == TS_OBJ
  if aRec || bRec {
    if !aRec || !bRec { return false }
    if da >= 0 && da == db { return true }
    const an: string[] = []
    const at: i32[] = []
    const bn: string[] = []
    const bt: i32[] = []
    if (!modRecFields(da, a, an, at) || !modRecFields(db, b, bn, bt)) {
      return false
    }
    return modFieldsSameShape(an, at, bn, bt, tyDecls, depth)
  }
  if tsKind[a] != tsKind[b] || tsKidCount[a] != tsKidCount[b] { return false }
  if tsKind[a] != TS_FUNC && tsText[a] != tsText[b] { return false }
  let k = 0
  while k < tsKidCount[a] {
    const ka = tsKids[tsKidStart[a] + k]
    const kb = tsKids[tsKidStart[b] + k]
    if !modTsSameShape(ka, kb, tyDecls, depth - 1) { return false }
    k = k + 1
  }
  true
}

// The duplicate-binding refusal for candidates `i` and `j` of set `row`, at the later site.
function modOvDupDiag(
  row: i32,
  i: i32,
  j: i32,
  heads: string[],
  notFns: boolean,
  decls: {[string]: i32},
): i32 {
  const m = ovSetMod[row]
  const nm = ovSetName[row]
  const specs = ovSetSpecs[row]
  let how = "imports it from both \"" + specs[i] + "\" and \"" + specs[j] + "\""
  if specs[i] == "" || specs[j] == "" { how = "both imports and declares it" }
  let msg = "Duplicate binding \""
    + nm
    + "\": module \""
    + modKeys[m]
    + "\" "
    + how
    + " — rename one (`as` on the import)"
  if !notFns {
    ovFnHead[ovSetCands[row][i]] = heads[i]
    ovFnHead[ovSetCands[row][j]] = heads[j]
    msg = msg
      + "; "
      + ovCandText(row, i)
      + " and "
      + ovCandText(row, j)
      + " overlap, and same-named functions coexist only when their first parameters differ in kind"
  }
  let at = modOvSiteTok(m, nm, ovSetCands[row][j], decls)
  const ti = modOvSiteTok(m, nm, ovSetCands[row][i], decls)
  if ti > at { at = ti }
  P.diags.push({ msg: msg, at: at })
  0
}
// A value reference: shadowed locals win, then the rename map, else unchanged. The
// map is consulted first even though the shadow wins, since a name absent from the
// map renames to itself either way — and it is the cheap order, since most calls on
// a self-compile are locals with no map row, paying one `sidLookup` instead of a walk.
function modRenamed(name: string): string {
  const row = sidArrGet(modRenameFirstBySid, sidLookup(name))
  if row < 0 && !isAmbientFnName(name) { return name }
  let i = modShadow.length - 1
  while i >= 0 {
    if modShadow[i] == name {
      if modShadowTo[i] != "" { return modShadowTo[i] }
      return name
    }
    i = i - 1
  }
  if row < 0 { return name }
  modRenameTo[row]
}
// Whether `name` is one of the ambient functions a program reaches with no import. A binding of
// one shadows it (spec Q11): the rewrite renames the binding and its references apart, so a bare
// `print` that survives the rewrite is always the builtin.
export function isAmbientFnName(name: string): boolean {
  name == "print"
    || name == "Map"
    || name == "Set"
    || name == "fromCodePoint"
    || name == "fromCodePoints"
}
// Opens a local binding of `name` for the rest of its scope and answers the name it is declared
// under: renamed apart from the builtin when `name` is ambient, else `name`.
function modShadowBind(name: string): string {
  let to = ""
  if isAmbientFnName(name) { to = name + modSuffixOf(modAmbMod) }
  modShadow.push(name)
  modShadowTo.push(to)
  if to == "" { return name }
  to
}
// A type-position name ("A|B", "Point[]"): identifier segments rename through the map, quoted
// ones copy verbatim. A block-local type is minted unique (`P` → `P$b7`) and needs no shadow;
// `$` continues a segment, so that name is one segment here as it is one `TS_NAME` in the
// spelling tree, and a declaration renames with its references (D3022).
function modTypeRenamed(tn: string): string {
  const out: i32[] = []
  // STAGE 2c: identifier runs and quoted literal members are SLICED out of `tn` rather
  // than rebuilt from elements. An identifier run is ASCII by `nameIdentChar`'s own test,
  // but a QUOTED member is not — a literal-union arm can be spelled `"é"` — and that arm
  // copied `tn[i]` into the same code-point buffer.
  let runStart = 0
  let i = 0
  while i <= tn.length {
    const atEnd = i == tn.length
    let c = 0
    if !atEnd { c = tn[i] }
    let isIdent = false
    if !atEnd { isIdent = nameIdentChar(c) || c == '$' }
    if isIdent {
      if runStart < 0 { runStart = i }
    } else {
      if runStart >= 0 && i > runStart {
        const seg = tn.slice(runStart, i)
        runStart = 0 - 1
        let rep = seg
        // A live generic type-parameter name is the PARAMETER here, never the
        // top-level binding it may textually collide with.
        if !strListHas(modTyShadow, seg) { rep = modTyRenamedSeg(seg) }
        pushCps(out, rep)
      }
      runStart = 0 - 1
      if !atEnd {
        if c == '"' {
          // Copy a quoted literal member verbatim. `skipQuotedName` owns where one ends —
          // it lands just past the closing quote, or at `tn.length` for an unterminated
          // segment, so the span is total. The trailing decrement hands the outer `i + 1`
          // the character AFTER the member.
          const qEnd = skipQuotedName(tn, i)
          pushCps(out, tn.slice(i, qEnd))
          i = qEnd - 1
        } else {
          out.push(c)
        }
      }
    }
    i = i + 1
  }
  fromCodePoints(out)
}

// ── scope-aware arena rewrite ────────────────────────────────────────────────
// Rewrites name references, call targets, and declaration names — plus type-
// annotation references for the native checker. A name shadowed by a param, loop
// var or block-local binding is left alone for that scope's extent (`modShadow`).
function modRwTsName(root: i32): i32 {
  if root < 0 { return 0 }
  const k = tsKind[root]
  if k == TS_NAME || k == TS_APP || k == TS_MAP {
    const seg = tsText[root]
    if seg.length > 0 && !strListHas(modTyShadow, seg) {
      tsText[root] = modTyRenamedSeg(seg)
    }
  }
  const start = tsKidStart[root]
  const cnt = tsKidCount[root]
  let i = 0
  while i < cnt {
    modRwTsName(tsKids[start + i])
    i = i + 1
  }
  0
}
function modRwType(tyIx: i32): i32 {
  if tyIx < 0 { return 0 }
  const t = nodeAt(tyIx)
  if t is TypeRef {
    // The parser recorded this annotation's structure — rewrite THAT and render
    // the name from it, so the tree and the string stay in lockstep (note 22: an
    // in-place string rewrite between producer and consumer is exactly what left
    // the spelling tree describing the PRE-merge name).
    const root = annTsOf(tyIx)
    if root >= 0 {
      modRwTsName(root)
      t.tyName = tsToName(root)
      return 0
    }
    // No recorded spelling: a `TypeRef` the parser never built. None exist at
    // merge time (the emitter's `synthTypeRef` runs much later), but the
    // character scanner stays as the fall-through so the pass is total either way.
    t.tyName = modTypeRenamed(t.tyName)
  }
  0
}
// The first `saved` entries of a shadow stack (rebuild — a bare `.pop()`
// STATEMENT is an emit gap in the native pipeline).
function modTrimTo(stack: string[], saved: i32): string[] {
  const keep: string[] = []
  let ki = 0
  while ki < saved {
    keep.push(stack[ki])
    ki = ki + 1
  }
  keep
}
function modShadowTrim(saved: i32): i32 {
  modShadow = modTrimTo(modShadow, saved)
  modShadowTo = modTrimTo(modShadowTo, saved)
  0
}
function modRwFunc(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is FuncDecl {
    n.fnName = modRenamed(n.fnName)
    // R4: an IN-PLACE name write on a node already in the arena, so re-note the name.
    sidNoteNodeName(ix, ix)
    const saved = modShadow.length
    const tySaved = modTyShadow.length
    // The function's generic type parameters are live across its annotations
    // and body — segments naming them must not rewrite (see `modTyShadow`).
    let ti = 0
    while ti < n.fnTyParams.length {
      modTyShadow.push(n.fnTyParams[ti])
      ti = ti + 1
    }
    // A type parameter's BOUND is an annotation and renames like one — AFTER the
    // shadow push above, because a bound may name the parameters themselves
    // (`<T: { eq(T): boolean }>`) and those must not be renamed.
    let bi = 0
    while bi < n.fnTyParams.length {
      modRwType(fnTpBoundOf(ix, bi))
      bi = bi + 1
    }
    let pi = 0
    while pi < n.fnParams.length {
      const p = nodeAt(n.fnParams[pi])
      if p is Param {
        const pTo = modShadowBind(p.parName)
        if pTo != p.parName {
          p.parName = pTo
          sidNoteNodeName(n.fnParams[pi], n.fnParams[pi])
        }
        modRwType(p.parType)
        // A parameter default is an expression of the declaring module, so a
        // module-scope `const` default renames exactly like any other reference
        // to that const (`K` → `K$mN`) — this is what keeps a default's names
        // resolved in the declaration's scope rather than the caller's, across the merge.
        if p.parDefault >= 0 { modRwExpr(p.parDefault) }
      }
      pi = pi + 1
    }
    modRwType(n.fnRet)
    modRwStmt(n.fnBody)
    modShadowTrim(saved)
    modTyShadow = modTrimTo(modTyShadow, tySaved)
  }
  0
}
// Push arm `k`'s payload-binding names onto the merge's shadow set (the caller trims). Reads them
// off the `LetDecl`s the parser banked in `matchBinds[armStart[k] + j]` — the SAME nodes the
// desugar prepends to the arm body, so the shadow set and the eventual declarations cannot drift.
function modShadowMatchBinds(n: MatchExpr, k: i32): i32 {
  const start = n.matchArmStart[k]
  let j = 0
  while j < n.matchArmCount[k] {
    const bIx = n.matchBinds[start + j]
    if bIx >= 0 {
      const bn = nodeAt(bIx)
      if bn is Block {
        let s = 0
        while s < bn.blkStmts.length {
          const st = nodeAt(bn.blkStmts[s])
          if st is LetDecl {
            st.letName = modShadowBind(st.letName)
            sidNoteNodeName(bn.blkStmts[s], bn.blkStmts[s])
          }
          s = s + 1
        }
      }
    }
    j = j + 1
  }
  0
}
function modRwBlock(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Block {
    // A block-local `let`, `const` or `function` shadows a same-named top-level binding from
    // its declaration on, which is where the checker starts resolving to it, so a read above
    // it still reaches the module's binding (D3603, D3608). A function's own name is shadowed
    // before its body is rewritten, so a recursive call keeps naming it.
    const saved = modShadow.length
    let i = 0
    while i < n.blkStmts.length {
      const st = nodeAt(n.blkStmts[i])
      if st is LetDecl {
        if st.letInit >= 0 { modRwExpr(st.letInit) }
        modRwType(st.letType)
        st.letName = modShadowBind(st.letName)
        sidNoteNodeName(n.blkStmts[i], n.blkStmts[i])
      } else if st is FuncDecl {
        if st.fnName != "" { modShadowBind(st.fnName) }
        modRwStmt(n.blkStmts[i])
      } else {
        modRwStmt(n.blkStmts[i])
      }
      i = i + 1
    }
    modShadowTrim(saved)
  }
  0
}
function modRwStmt(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  if n is Program {
    let i = 0
    while i < n.progStmts.length {
      // D1045 — a body-scoped `type` is in this list twice over: once here (the
      // parser hoists it) and once at its lexical position inside a block. Rewrite
      // it there, never here — a second visit here would rename an already-
      // mangled name (`P$b7`) a second time, against the shadow the other visit needs.
      if !isBodyTyDecl(n.progStmts[i]) { modRwStmt(n.progStmts[i]) }
      i = i + 1
    }
    return 0
  }
  if n is Block { return modRwBlock(ix) }
  if n is LetDecl {
    // The initializer evaluates in the ENCLOSING scope; rewrite it before the
    // name. At the top level the declaration name is RENAMED; in a nested block
    // it is pre-collected into the shadow set, so `modRenamed` is a no-op.
    if n.letInit >= 0 { modRwExpr(n.letInit) }
    modRwType(n.letType)
    n.letName = modRenamed(n.letName)
    // R4: the same in-place name write (see `modRwFunc`).
    sidNoteNodeName(ix, ix)
    return 0
  }
  if n is FuncDecl { return modRwFunc(ix) }
  if n is RetStmt {
    if n.retArg >= 0 { modRwExpr(n.retArg) }
    return 0
  }
  if n is IfStmt {
    // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
    let cur = ix
    while cur >= 0 {
      const c = nodeAt(cur)
      cur = -1
      if c is IfStmt {
        modRwExpr(c.ifCond)
        modRwStmt(c.ifThen)
        if c.ifElse >= 0 {
          if nodeAt(c.ifElse) is IfStmt {
            cur = c.ifElse
          } else {
            modRwStmt(c.ifElse)
          }
        }
      }
    }
    return 0
  }
  if n is WhileStmt {
    modRwExpr(n.whileCond)
    modRwStmt(n.whileBody)
    return 0
  }
  if n is ForRange {
    modRwExpr(n.frFrom)
    modRwExpr(n.frTo)
    if n.frStep >= 0 { modRwExpr(n.frStep) }
    const frSaved = modShadow.length
    n.frVar = modShadowBind(n.frVar)
    modRwStmt(n.frBody)
    modShadowTrim(frSaved)
    return 0
  }
  if n is ForIn {
    modRwExpr(n.fiIter)
    const fiSaved = modShadow.length
    n.fiVar = modShadowBind(n.fiVar)
    if n.fiVar2 != "" { n.fiVar2 = modShadowBind(n.fiVar2) }
    modRwStmt(n.fiBody)
    modShadowTrim(fiSaved)
    return 0
  }
  if n is BreakStmt { return 0 }
  if n is ContinueStmt { return 0 }
  if n is TypeDecl {
    // A generic alias's parameters (folded into the declared name) are live
    // across the name and the field annotations.
    const tdTySaved = modTyShadow.length
    const tdPs = declGpParamsOf(ix)
    let tdPi = 0
    while tdPi < tdPs.length {
      modTyShadow.push(tdPs[tdPi])
      tdPi = tdPi + 1
    }
    n.tdName = modTypeRenamed(n.tdName)
    modRwDeclBase(ix)
    // A BOUND alias carries its whole body as one annotation and NO fields, so
    // the loop below is empty for it and this is the rename that matters.
    modRwType(declBoundOf(ix))
    let i = 0
    while i < n.tdFields.length {
      const f = nodeAt(n.tdFields[i])
      if f is FieldDef { modRwType(f.fdType) }
      i = i + 1
    }
    modTyShadow = modTrimTo(modTyShadow, tdTySaved)
    return 0
  }
  if n is UnionDecl {
    const udTySaved = modTyShadow.length
    const udPs = declGpParamsOf(ix)
    let udPi = 0
    while udPi < udPs.length {
      modTyShadow.push(udPs[udPi])
      udPi = udPi + 1
    }
    n.udName = modTypeRenamed(n.udName)
    modRwDeclBase(ix)
    const vs: string[] = []
    let i = 0
    while i < n.udVariants.length {
      // Each member's spelling is banked on this node in member order (`setUdTs`),
      // so the merge renames the tree and renders it, rather than renaming the
      // string directly — a `type v = i32` alongside a member `{ v: i32 }` would
      // otherwise rename the field, breaking the match to its own literal.
      const vRoot = udTsRootAt(ix, i)
      if vRoot >= 0 {
        modRwTsName(vRoot)
        vs.push(tsToName(vRoot))
      } else {
        vs.push(modTypeRenamed(n.udVariants[i]))
      }
      i = i + 1
    }
    n.udVariants = vs
    modTyShadow = modTrimTo(modTyShadow, udTySaved)
    return 0
  }
  modRwExpr(ix)
}

// A match arm pattern renames as a type. A bare name whose value spelling the merge renames
// differently (a local value shadows it) also banks that spelling, which a `const` arm reads
// over a value scrutinee while a type pattern keeps the type's (D3271).
function modRwMatchPat(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  let valName = ""
  if n is IsExpr {
    const root = annTsOf(ix)
    if root >= 0 && tsKind[root] == TS_NAME {
      valName = modRenamed(tsText[root])
    }
  }
  modRwIsType(ix)
  const m = nodeAt(ix)
  if m is IsExpr {
    if valName != "" && valName != m.isVariant {
      setMatchPatValueName(ix, valName)
    }
  }
  0
}

// The check-type half of the `IsExpr` merge rename, split out so a `match` arm's
// type pattern can rename its type without re-walking the shared scrutinee object a
// sibling arm already rewrote. A no-op on any other node kind. The check type is a
// parser spelling banked on this node, so the merge renames the tree and renders it.
function modRwIsType(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  if n is IsExpr {
    const isRoot = annTsOf(ix)
    if isRoot >= 0 {
      modRwTsName(isRoot)
      n.isVariant = tsToName(isRoot)
      return 0
    }
    n.isVariant = modTypeRenamed(n.isVariant)
  }
  0
}

function modRwExpr(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  match n {
    Ident => {
      if modRwCalleeIx != ix { modOvNoteUse(ix, -1, n.identName) }
      n.identName = modRenamed(n.identName)
      // R4: the in-place name write the self-compile exercises hardest — the merge
      // renames every colliding top-level reference in every compiler module. The checker,
      // which runs after the merge, resolves the read.
      sidNoteNodeName(ix, -1)
      return 0
    }
    Call => {
      // A member call `recv.prop(args)` keeps its property plain, since a callable field of
      // the same name keeps precedence; the name `prop` takes here is banked on this node
      // instead (D1120), so the binder resolves the call's spelling as it would `prop(recv)`.
      if n.callFn >= 0 {
        const cf = nodeAt(n.callFn)
        let mp = ""
        if cf is Member { mp = cf.memProp }
        if cf is OptMember { mp = cf.omProp }
        if mp != "" && !modOvMemberSite(ix, mp) {
          const target = modRenamed(mp)
          if target != mp { ufcsSiteAdd(ix, target) }
        }
        if cf is Ident {
          modOvNoteUse(n.callFn, ix, cf.identName)
          modRwCalleeIx = n.callFn
        }
      }
      modRwExpr(n.callFn)
      modRwCalleeIx = -1
      // Written type arguments are annotations in the caller's scope and rename like one (D2527).
      const tas = callTyArgsOf(ix)
      let ti = 0
      while ti < tas.length {
        modRwType(tas[ti])
        ti = ti + 1
      }
      let i = 0
      while i < n.callArgs.length {
        modRwExpr(n.callArgs[i])
        i = i + 1
      }
      return 0
    }
    Member => {
      // The property is a field label, never a top-level binding — receiver only.
      modRwExpr(n.memObj)
      return 0
    }
    OptMember => {
      modRwExpr(n.omObj)
      return 0
    }
    Index => {
      modRwExpr(n.idxArr)
      modRwExpr(n.idxIndex)
      return 0
    }
    BinExpr => {
      modRwExpr(n.binLeft)
      modRwExpr(n.binRight)
      return 0
    }
    Unary => {
      modRwExpr(n.unArg)
      return 0
    }
    Paren => {
      modRwExpr(n.parInner)
      return 0
    }
    ObjLit => {
      let i = 0
      while i < n.objFields.length {
        const f = nodeAt(n.objFields[i])
        if f is FieldInit { modRwExpr(f.fiValue) }
        i = i + 1
      }
      return 0
    }
    ArrayLit => {
      let i = 0
      while i < n.arrElems.length {
        modRwExpr(n.arrElems[i])
        i = i + 1
      }
      return 0
    }
    // A spread's source names a binding like any operand, in a literal or a call (D2334).
    Spread => {
      return modRwExpr(n.spdArg)
    }
    IsExpr => {
      modRwExpr(n.isObj)
      return modRwIsType(ix)
    }
    AsExpr => {
      modRwExpr(n.asObj)
      // The cast target is renamable: the checker requires it resolve to a numeric
      // scalar, and a user alias (`type Id = i32`, `x as Id`) does — leaving the cast
      // spelling alone while the declaration renamed to `Id$mN` failed every module
      // program casting to a named alias.
      const asRoot = annTsOf(ix)
      if asRoot >= 0 {
        modRwTsName(asRoot)
        n.asTy = tsToName(asRoot)
        return 0
      }
      n.asTy = modTypeRenamed(n.asTy)
      return 0
    }
    // D981 — an if-expression (the same `IfStmt` node in value position: a `return`,
    // initializer, assignment RHS, call argument, or nested arm). Routes to
    // `modRwStmt`'s own arm, so a nested arm keeps `modRwBlock`'s shadow handling
    // instead of a drifting second copy.
    IfStmt => {
      return modRwStmt(ix)
    }
    // A loop or labelled block whose value is used stands in value position too (D3406).
    WhileStmt => {
      return modRwStmt(ix)
    }
    ForRange => {
      return modRwStmt(ix)
    }
    ForIn => {
      return modRwStmt(ix)
    }
    // A `match` (value- or statement-position). The merge rename descends into the
    // scrutinee and every arm body, else an arm's name keeps its bare spelling after
    // the export's rename. A type pattern's check type takes `modRwIsType`, not
    // `modRwExpr`, which would re-walk the shared scrutinee and rename it n+1 times over.
    MatchExpr => {
      modRwExpr(n.matchScrut)
      let p = 0
      while p < n.matchPats.length {
        modRwMatchPat(n.matchPats[p])
        p = p + 1
      }
      let i = 0
      while i < n.matchBodies.length {
        // Payload bindings hold nothing this pass renames — the initializer is a
        // `Member` over the shared scrutinee (renamed once, above) and `letName` is
        // arm-local. But they must shadow: the desugar later prepends them to this
        // body, so a module-level `const x` would otherwise capture the body's own `x`.
        const saved = modShadow.length
        modShadowMatchBinds(n, i)
        modRwStmt(n.matchBodies[i])
        modShadowTrim(saved)
        i = i + 1
      }
      return 0
    }
    FuncDecl => {
      return modRwFunc(ix)
    }
    // a literal, declaration or statement-only node names no binding here
    NumLit | StrLit | CharLit | BoolLit | NullLit | ErrExpr | LetDecl | Param | TypeRef | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | ImportDecl | LoopVar => {}
  }
  0
}
