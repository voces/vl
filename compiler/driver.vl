// The whole module pipeline behind `compileSrc` (emit = 1) / `checkSrc` (0).
function modCompile(emit: i32): i32 {
  // 1. Order + validate (DFS from the entry, table index 0).
  modState = []
  modOrder = []
  modDiags = []
  modDiagLine = []
  modDiagCol = []
  modDiagEnd = []
  modDiagMod = []
  let s = 0
  while s < modKeys.length {
    modState.push(0)
    s = s + 1
  }
  modVisit(0, 0)
  if modDiags.length > 0 {
    // Tokenless (no tokens are loaded yet): position, span + owner ride the
    // `vcDg*` side table, keyed on each entry's `P.diags` index.
    let d = 0
    while d < modDiags.length {
      vcDgPush(
        P.diags.length,
        modDiagLine[d],
        modDiagCol[d],
        modDiagEnd[d],
        modDiagMod[d],
      )
      P.diags.push({ msg: modDiags[d], at: -1 })
      d = d + 1
    }
    return 1
  }
  // 2. Parse each module dependency-first into the SHARED arena. Tokens append
  // to `P.toks` (anchors stay per-module-correct via the global `pos`); each
  // `parseProgram` starts at its own module's first token.
  const roots: i32[] = []
  modLoadStart = []
  modLoadMod = []
  // Sibling modules are independent: parse EVERY module and aggregate their
  // parse/lex diagnostics rather than aborting at the first failing module —
  // one run reports every file's syntax errors. `vcLoadMod` attributes a lex
  // diag (tokenless) to the module being loaded; parse diags anchor at tokens
  // and resolve their owner through `modOfTok`.
  let o = 0
  while o < modOrder.length {
    const m = modOrder[o]
    P.pos = P.toks.length
    // Record where this module's tokens begin so an occurrence's token maps back
    // to its module (`modOfTok`) for cross-file find-references.
    modLoadStart.push(P.toks.length)
    modLoadMod.push(m)
    vcLoadMod = m
    vcLoadToksMod(m)
    roots.push(parseProgram())
    o = o + 1
  }
  vcLoadMod = 0
  // The same stage-1 rule the single-source paths use, so a file does not lose
  // type feedback merely by gaining an `import` (see `vcParseBlocked`). The
  // quantifier spans the WHOLE graph — one lossy diagnostic in any module stops
  // the merge for all of them, which is what the shared arena requires anyway.
  if vcParseBlocked() { return 1 }
  // 2b. Duplicate-binding check: a top-level declaration whose name collides
  // with an import local would be silently ORPHANED by the merge rename (the
  // import mapping wins, so every reference rewrites to the IMPORT's target) —
  // diagnose the collision instead of misbinding.
  let dc = 0
  while dc < modOrder.length {
    modCheckDupBindings(modOrder[dc], roots[dc])
    dc = dc + 1
  }
  // A duplicate binding is never lossless-flagged, so this stays a hard stop —
  // the merge rename below would misbind on it, which is not a diagnostic the
  // checker could improve on.
  if vcParseBlocked() { return 1 }
  // 3 + 4. Per-module rename map + scope-aware arena rewrite. First register
  // every top-level `self`-function under its mangled name (across ALL modules)
  // so a UFCS member-call can resolve its (possibly mangled) callee through the
  // merge; the rewrite records the plain→mangled aliases it discovers.
  ufcsAliasReset()
  ufcsImpReset()
  // D1571's set spans every module of ONE program, so it is cleared with the other
  // program-scoped merge state and refilled by the collect pass below.
  modBuiltinTyTargets = []
  modCollectSelfFns(roots)
  let o2 = 0
  while o2 < modOrder.length {
    modBuildRename(modOrder[o2], roots[o2])
    // D1191 — the module's own UFCS SCOPE, and its arena boundary. Both are read
    // where a UFCS name is resolved away from a banked call site, so a candidate
    // is one the CALLER binds rather than one any module happened to bank.
    modBankUfcsScope(modOrder[o2])
    ufcsModBoundAdd(modOrder[o2], roots[o2])
    modShadow = []
    modTyShadow = []
    modRwStmt(roots[o2])
    o2 = o2 + 1
  }
  // 4b. Resolve each of the ROOT module's RE-EXPORTS to its merged (mangled) target —
  // the exporting module renamed its `name` to `name$mDD`, so `export { name } from
  // "dep"` aliases the bare `name` onto that target in the emitter's export section.
  //
  // ONLY module 0's rows. A DEPENDENCY's re-export is that dependency's public surface,
  // not the program's, and aliasing every module's row puts a bare dependency name in
  // the ENTRY's wasm ABI — a three-module program whose entry exports NOTHING would
  // still export `fn`. That is the same leak 4c's rule below rules out for every other
  // kind of name, and it is not inert: each leaked row buys an export-section entry in
  // a binary no host reaches it through. The root's own row is self-sufficient because
  // `modMergedTargetOf` chases the chain to the DECLARING module; a one-hop resolver
  // would look healthy on an unrenamed chain (`tests/vl_reexport_abi_test.ts` pins it).
  reExpName = []
  reExpTarget = []
  let re = 0
  while re < reExpMod.length {
    const rm = reExpMod[re]
    const rloc = reExpLocal[re]
    let ii2 = 0
    // A dependency's re-export (`rm != 0`) publishes to its importers, not to the ABI:
    // start the scan already `done` so its row contributes no alias.
    let done = true
    if rm == 0 { done = false }
    while ii2 < impMod.length && !done {
      if impMod[ii2] == rm && impLocal[ii2] == rloc && impName[ii2] != "" {
        const dd = modIndexOfKey(impKey[ii2])
        if dd >= 0 {
          reExpName.push(reExpPublic[re])
          // NOT `impName[ii2]$mdd`: `dd` may itself only RE-EXPORT the name, in
          // which case that target names nothing. Chase to the declaring module.
          reExpTarget.push(modMergedTargetOf(dd, impName[ii2]))
        }
        done = true
      }
      ii2 = ii2 + 1
    }
    re = re + 1
  }
  // 4c. The ROOT module's plain `export`-marked declarations surface under their
  // BARE names too — appended to the same alias tables (public name → the
  // $m0-mangled merged target), exactly like a re-export. The emitter exports
  // ONLY these alias tables, so an internal function (a lifted `__lambda_N`, a
  // `name#k` mono instance, a dependency's machinery) never leaks into the wasm
  // ABI. A name already aliased (re-exported) keeps its first entry.
  let rex = 0
  while rex < expMod.length {
    if expMod[rex] == 0 && !capHas(reExpName, expName[rex]) {
      reExpName.push(expName[rex])
      reExpTarget.push(expName[rex] + "$m0")
    }
    rex = rex + 1
  }
  // 5. Merge: ONE Program concatenating the modules' statements dependency-first
  // (deps' top-level initializers run before their dependents', as in the host).
  const allStmts: i32[] = []
  let o3 = 0
  while o3 < modOrder.length {
    const r = P.nodes[roots[o3]]
    if r is Program {
      const ss = r.progStmts
      let q = 0
      while q < ss.length {
        allStmts.push(ss[q])
        q = q + 1
      }
    }
    o3 = o3 + 1
  }
  const merged = mkProgram(allStmts, -1) // synthesized merged-module root (no source token)
  csPreMintLocs()
  checkProgram(merged)
  // A lossless-recovered graph CHECKS but never BUILDS — same rule as
  // `compileSrc`, and the rc stays 1 so `vl build` behaves exactly as before.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  // The deep-`is` second pass, on the MERGED program: the generated walkers name
  // their types through `tyToStr`, which after the merge renders the mangled
  // declarations (`Json$m1`), and the fragment is parsed AFTER the rename pass —
  // so its identifiers resolve verbatim in exactly the scope they were rendered
  // from.
  const jwRc = jwSecondPass(merged)
  if jwRc != 0 { return jwRc }
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  if emit != 0 {
    const rc = emitProgram(merged)
    if rc < 0 { return 3 }
  }
  0
}

// ── per-module rename map (state at the top of this file) ─────────────────────
// `sid(name)` → row → `modRenameTo[row]`: every top-level value/type name of the
// module maps to `name$mN` (N = the module's TABLE index — entry 0); an imported local
// maps to the EXPORTING module's mangled export name. A generic TYPE declaration
// (`Box<T>` — the parser folds alias parameters into the declared name) renames by its
// BASE segment, so the declaration (→ `Box$mN<T>`) and every application (`Box<i32>` →
// `Box$mN<i32>`) rewrite consistently through the segment rewriter. Generic FUNCTIONS
// carry their parameters out-of-name (`fnTyParams`) and rename like any value.
//
// The base segment and the folded type-parameter names are the PARSER's own list,
// banked on the declaration node (`ast.setDeclGp`): both are one array read keyed by
// the node the caller already holds, never a re-parse of a string the parser built.
function modDeclBase(ix: i32, name: string): string {
  const b = declGpBaseOf(ix)
  if b != "" { return b }
  name
}
// Carry the merge's rename INTO the bank, immediately after it lands in the declared
// name. `modTypeRenamed` rewrites identifier SEGMENTS under the live `modTyShadow`
// (the declaration's own parameters, pushed by the caller before the rename), so
// running it on the bare base gives exactly the head segment it gave the folded name —
// the two cannot drift.
//
// This is the third position of the same discipline, and why it is not optional: an
// in-place string rewrite between a producer and a consumer is what left the spelling
// tree describing the PRE-merge name (`modRwType`'s note) and describing the pre-CANON
// name after `canonEmitTypeNames` (`ast.clearAnnTs`). A stale base here would register
// the alias under `Box` while every application spells `Box$m1`. A non-generic
// declaration has no row, and this is a no-op.
function modRwDeclBase(ix: i32): i32 {
  const b = declGpBaseOf(ix)
  if b != "" { setDeclGpBase(ix, modTypeRenamed(b)) }
  0
}
// Diagnose every top-level declaration of module `m` whose name (base segment,
// for a generic) collides with one of its import locals. Without this, the
// merge rename SKIPS the declaration (the import mapping claims the name), so
// every reference — including ones that meant the local — rewrites to the
// import's target and the declaration is silently orphaned. Anchored at the
// declaration's NAME token, so the diagnostic carries the colliding site's
// line/col and `diagModule` attributes it to this module.
function modCheckDupBindings(m: i32, root: i32): i32 {
  const impLocals: string[] = []
  let ii = 0
  while ii < impMod.length {
    if impMod[ii] == m && impLocal[ii] != "" { impLocals.push(impLocal[ii]) }
    ii = ii + 1
  }
  const r = P.nodes[root]
  if r is Program {
    const ss = r.progStmts
    let si = 0
    while si < ss.length {
      const st = P.nodes[ss[si]]
      let nm = ""
      if st is FuncDecl { nm = st.fnName }
      if st is LetDecl { nm = st.letName }
      if st is TypeDecl { nm = st.tdName }
      if st is UnionDecl { nm = st.udName }
      if nm != "" {
        const base = modDeclBase(ss[si], nm)
        if capHas(impLocals, base) {
          P.diags.push(
            {
              msg: "Duplicate binding \"" +
                base +
                "\": module `" +
                modKeys[m] +
                "` both imports and declares it — rename one (`as` on the import)",
              at: declNameTokOf(ss[si]),
            },
          )
        }
      }
      si = si + 1
    }
  }
  0
}
// Does `seg` name a type the language provides with no declaration? `primTyOfName` is the ONE
// home of the primitive spellings and `u8` is the storage type it deliberately withholds from
// it (it is reachable only as an array element), so the pair IS the set of names an annotation
// resolves without a `type` in sight. D1571.
function modNameIsBuiltinTy(seg: string) {
  if seg == "u8" { return true }
  primTyOfName(seg) >= 0
}
// The TYPE-position rename of one identifier segment — the LAST matching row's target, or the
// segment unchanged. D1571's gate lives HERE rather than in either reader: the spelling TREE
// (`modRwTsName`, the live path for an annotation) and the character scanner
