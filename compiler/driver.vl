        } else if modFound[d] == 0 {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Cannot resolve import \"" + spec + "\" (no module `" + key + "`)",
          )
        } else if modState[d] == 1 {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Import cycle detected through \"" +
              spec +
              "\" (module `" +
              key +
              "`)",
