  }
  const tokBefore = P.toks.length
  const diagBefore = P.diags.length
  const docBefore = docCmtLine.length
  vcLoadToks(modSrcs[m])
  if ci >= 0 && P.diags.length == diagBefore {
    const banked: Tok[] = []
    let ti2 = tokBefore
    while ti2 < P.toks.length {
      banked.push(P.toks[ti2])
      ti2 = ti2 + 1
    }
    modCacheTokArr[ci] = banked
    modCacheTokN[ci] = banked.length
    modCacheTokLive = modCacheTokLive + banked.length
    modCacheDocOff[ci] = modCacheDocLine.length
    let dj = docBefore
    while dj < docCmtLine.length {
      modCacheDocLine.push(docCmtLine[dj])
      modCacheDocText.push(docCmtText[dj])
      dj = dj + 1
    }
    modCacheDocEnd[ci] = modCacheDocLine.length
  }
