export let vcCodes: i32[] = []
// The in-module source channel, set when a VL caller already holds the source string
// — as opposed to the host channel below, which arrives one element at a time. Exactly
// one of the two is used per compile, so `vcSource` chooses between them on
// `vcCodes.length` alone rather than carrying a second flag to keep in step.
let vcSrcStr = ""
export function srcReset(): i32 {
  vcCodes = []
  vcSrcStr = ""
  0
}
export function srcPush(c: i32): i32 {
  vcCodes.push(c)
  0
}
// Stages a source string directly, with no per-element round trip. A byte producer
// feeding a code-point consumer (`srcPush` per char, then `fromCodePoints`) re-encodes
// every non-ASCII character before the lexer sees it — `'é'` would lex as two
// characters. A string handed over as a string has no unit to get wrong.
export function srcSetStr(s: string): i32 {
  vcCodes = []
  vcSrcStr = s
  0
}
// ── the host-seed ABI stamp ───────────────────────────────────────────────────
// The number a `vl` binary checks before it trusts this seed, compared with `==`. A
// mismatch is silent wrong output at a successful exit code, not a loud failure — bump
// it in the same commit that changes the guest-host ABI it covers (`docs/internals/cli-design.md`).
export function hostAbi(): i32 { 2 }

// ── bulk source intake over linear memory ─────────────────────────────────────
// `srcPush` above is one host call per code point; this batched form replaces N calls
// with N/16384, the host writing a chunk into linear memory before this loop copies
// it out — WasmGC has no memory→GC-array copy, so only the call boundary is bought.
export function srcLoad(count: i32): i32 {
  let i = 0
  while i < count {
    const cp = __load_i32__(i * 4)
    vcCodes.push(cp)
    i = i + 1
  }
  0
}
export function vcSource(): string {
  if vcCodes.length == 0 { return vcSrcStr }
  fromCodePoints(vcCodes)
}
// Source positions (and owning module) for `P.diags` entries with no token anchor:
// lex diagnostics and module-resolution diagnostics (emitted before any tokens load).
// Keyed by the diagnostic's `P.diags` index, so tokenless and token-anchored entries
// interleave freely; `diagLine`/`diagCol`/`diagEndCol`/`diagModule` consult it first.
let vcDgIdx: i32[] = []
let vcDgLine: i32[] = []
let vcDgCol: i32[] = []
// The 0-based exclusive end column of the entry's span, on `vcDgLine`. Without it,
// every lex and module-resolution diagnostic (which have no token anchor to derive a
// width from) would render as a single-column caret regardless of how much source it
// covers. Equal to `vcDgCol` for an entry with no span (the point rendering).
let vcDgEnd: i32[] = []
let vcDgMod: i32[] = []
// The module whose source `vcLoadToks` is currently loading — a lex diag's
// owner. The modCompile parse loop sets it per module; 0 elsewhere.
let vcLoadMod = 0
// The side-table slot for `P.diags` index `i`, or -1 (a token-anchored diag).
function vcDgFind(i: i32): i32 {
  let k = 0
  while k < vcDgIdx.length {
    if vcDgIdx[k] == i { return k }
    k = k + 1
  }
  -1
}
// Clears the index-keyed `P.diags` side tables — the tokenless-diag position table
// above and the parser's lossless column — in one home for the seven entry points
// that must stay in lockstep. A stale lossless entry claims a different program's
// diagnostic is lossless, the direction that wrongly lets the checker proceed.
function vcDgReset() {
  vcDgIdx = []
  vcDgLine = []
  vcDgCol = []
  vcDgEnd = []
  vcDgMod = []
  vcLoadMod = 0
  dgLosslessReset()
  0
}

// ── the stage-1 lossless-recovery gate ─────────────────────────────────────────
// Whether the pipeline must stop at the parse stage: any parse diagnostic that is
// not a lossless recovery's, since a lossless-recovered AST is exactly what the
// user wrote — one lossy recovery anywhere in the file restores the bail.
function vcParseBlocked(): boolean { P.diags.length > 0 && !dgAllLossless() }
// Record one tokenless diagnostic's position, owner and span, keyed on the
// `P.diags` index it is about to occupy. The caller pushes the `P.diags` entry.
function vcDgPush(idx: i32, line: i32, col: i32, endCol: i32, mod: i32) {
  vcDgIdx.push(idx)
  vcDgLine.push(line)
  vcDgCol.push(col)
  vcDgEnd.push(endCol)
  vcDgMod.push(mod)
  0
}

// ── H3 module-table state (globals precede their first textual use; the module
// SUBSYSTEM itself — exports, scan, pipeline, rewrite — lives at the bottom of
// this file) ──────────────────────────────────────────────────────────────────
let modKeys: string[] = [] // resolved module keys, [0] = the entry
let modSrcs: string[] = [] // module sources ("" when missing)
let modFound: i32[] = []   // 1 = read ok, 0 = host could not read the key
let modKeyAcc: i32[] = []  // accumulators for the NEXT commit
let modSrcAcc: i32[] = []
// Flat per-import-entry tables (filled by the token scan at each commit):
let impMod: i32[] = []      // importing module's table index
let impSpec: string[] = []  // the raw specifier text (diagnostics)
let impKey: string[] = []   // resolved key ("" = unsupported specifier)
let impName: string[] = []  // the exported (source) name ("" = bare import)
let impLocal: string[] = [] // the local binding name (after `as`)
// Source positions per import entry (1-based line, 0-based col): the imported name
// token and the specifier string token. `modVisit` anchors resolution diagnostics
// here — a spec-shaped problem (unsupported/unresolvable/cycle) at the specifier, a
// name-shaped one (not exported) at the name.
let impNameLine: i32[] = []
let impNameCol: i32[] = []
let impSpecLine: i32[] = []
let impSpecCol: i32[] = []
// The specifier's EXCLUSIVE end column, so the "unsupported specifier" report can
// underline the whole literal rather than its first character.
let impSpecEnd: i32[] = []
// 1 when a char literal (`'std:fs'`) appears where the specifier belongs. A specifier
// is a string, so this never becomes a resolvable key — recorded rather than skipped
// so the reader gets "that is a char literal" instead of an empty-specifier message.
// `impSpec` then carries the literal's raw lexeme for `importSpecCharMsg` to show.
let impSpecChar: i32[] = []
// Flat per-module export-name sets (token scan: `export`-modified declarations).
let expMod: i32[] = []
let expName: string[] = []
// Re-exports (`export { a, b as c } from "spec"`): the public name each surfaces
// (`a`/`c`) and the importing module, parallel arrays. Also recorded as an import (so
// the symbol is pulled and the dependency edge exists), and drives the emitter to
// alias the merged target function under its bare public name in the export section.
let reExpMod: i32[] = []       // the re-exporting module's table index
let reExpPublic: string[] = [] // the public bare name (the `as` alias, else the source name)
let reExpLocal: string[] = []  // the local binding the import created (resolves to the target)
// Filled by `modCompile` once renames are known: the public name → the merged
// target function name, consumed by `emitProgram`'s export section. Defined on the
// emitter side and imported here so the driver→emitter→driver read forms no cycle.
// The export name token's position, parallel to `expName` — the go-to-definition target.
let expDeclLine: i32[] = []
let expDeclCol: i32[] = []
// The `export` KEYWORD token's source position, parallel to `expName` — the target
// for the "redundant export keyword" hint (an export imported by no other module).
let expKwLine: i32[] = []
let expKwCol: i32[] = []
// Resolved keys imported by committed modules that are neither committed nor
// marked missing — what the host fetch loop reads next. Recomputed per commit.
let modPending: string[] = []
// DFS state: 0 unvisited, 1 loading (a back-edge is a cycle), 2 done; `modOrder`
// collects table indices dependency-first; `modDiags` the resolution errors.
let modState: i32[] = []
let modOrder: i32[] = []
let modDiags: string[] = []
// Per-module token-load ranges, recorded as each module's tokens append to the
// shared `P.toks` during `modCompile`: `modLoadStart[o]` is the first token index
// of the o-th loaded module, `modLoadMod[o]` its TABLE index. `modOfTok` maps an
// occurrence's token back to its owning module — cross-file find-references.
let modLoadStart: i32[] = []
let modLoadMod: i32[] = []
// Per-module rename map (`name` → `name$mN`) and the lexical shadow stack, keyed by
// interned id so a reader is one `sidLookup` plus one array read rather than a linear
// scan. Two index arrays because the readers disagree on a duplicate key by design:
// `modRenamed` takes the first matching row, `modRwTsName`/`modTypeRenamed` the last.
let modRenameTo: string[] = []
// The `from` keys, parallel to `modRenameTo`. The sid views index BY name and
// cannot be walked back to the spellings, and D1191's per-module UFCS scope is
// exactly a walk of this map: every row whose TARGET is a registered
// `self`-function is a plain name this module binds to one.
let modRenameFrom: string[] = []
let modRenameFirstBySid: i32[] = []
let modRenameLastBySid: i32[] = []
let modShadow: string[] = []
// Registry of every top-level free `self`-function across all modules, keyed by its
// mangled name with its parameter arity. Since the merge cannot rewrite a `Member`'s
// `memProp` (a same-named struct field keeps precedence), it records a plain→mangled
// alias instead. D1044 — two arities per row, since a default makes arity a range.
let modSelfFnName: string[] = []
let modSelfFnArity: i32[] = []
let modSelfFnMinArity: i32[] = []
// Generic type-parameter names live inside the rewrite of their declaration
// (`T` while inside `id<T>`'s annotations/body or `Box<T>`'s definition): a
// segment matching one must NOT rewrite through the rename map — it names the
// parameter, not a top-level binding.
let modTyShadow: string[] = []
// D1571 — the merged targets of `type` declarations that took a builtin type name, the
// only rows allowed to rewrite such a name in type position. The rename map is one
// namespace but the language is two: a builtin has no declaration of its own, so
// without this its value row alone wrongly renamed `u8[]` too. Almost always empty.
let modBuiltinTyTargets: string[] = []
// ── per-instance module scan/token cache ──────────────────────────────────────
// A directory check rebuilds the module table once per file, so a shared dependency
// is cached per (module key, source text): entries replay under the new table
// index, so one tokenization serves both scan and parse for every module of every build.
const modCacheKeys: string[] = []
const modCacheSrcs: string[] = []
const modCacheImpOff: i32[] = []
const modCacheImpEnd: i32[] = []
const modCacheReOff: i32[] = []
const modCacheReEnd: i32[] = []
const modCacheExpOff: i32[] = []
const modCacheExpEnd: i32[] = []
// Token slice (-1 = not captured); only a CLEAN tokenization (no lex diags) is
// cached, so a hit never has diags to re-fold.
const modCacheTokOff: i32[] = []
const modCacheTokEnd: i32[] = []
// The token range `modScan` just banked into the flat storage, handed to
// `modScanCached` for the slot it appends. `modScan` is called from exactly one
// place and its result is recorded immediately, so a scalar pair carries it
// without threading a return type through the scan.
let modScanTokOff = -1
let modScanTokEnd = -1
// Flat storage backing the slices above.
const modCacheImpSpec: string[] = []
const modCacheImpKey: string[] = []
const modCacheImpName: string[] = []
const modCacheImpLocal: string[] = []
const modCacheImpNameLine: i32[] = []
const modCacheImpNameCol: i32[] = []
const modCacheImpSpecLine: i32[] = []
const modCacheImpSpecCol: i32[] = []
const modCacheImpSpecEnd: i32[] = []
const modCacheImpSpecChar: i32[] = []
const modCacheRePublic: string[] = []
const modCacheReLocal: string[] = []
const modCacheExpName: string[] = []
const modCacheExpDeclLine: i32[] = []
const modCacheExpDeclCol: i32[] = []
const modCacheExpKwLine: i32[] = []
const modCacheExpKwCol: i32[] = []
const modCacheTokKind: TokKind[] = []
const modCacheTokText: string[] = []
const modCacheTokStart: i32[] = []
const modCacheTokLine: i32[] = []
const modCacheTokCol: i32[] = []
// The cache slot for (key, src), or -1. Duplicate keys may exist (a source
// rewritten mid-run appends a new slot); the src must match exactly.
function modCacheLookup(key: string, src: string): i32 {
  let i = 0
  while i < modCacheKeys.length {
    if modCacheKeys[i] == key && modCacheSrcs[i] == src { return i }
    i = i + 1
  }
  -1
}

function vcLoadToks(src: string): i32 {
  const r = tokenize(src)
  let i = 0
  while i < r.tokens.length {
    const t = r.tokens[i]
    // `pos` is the GLOBAL P.toks index (single-source: identical to the per-call
    // index; module mode APPENDS each module's tokens, so anchors stay correct).
    P.toks.push(
      {
        kind: t.kind,
        text: t.text,
        pos: P.toks.length,
        start: t.start,
        line: t.line,
        col: t.col,
      },
    )
    i = i + 1
  }
  // Folds the lexer's diagnostics into the parse-stage store so a lex error (an empty
  // or multi-char char literal) is rejected at the parse stage, mirroring the host's
  // `checkOnly`. A lex diag has no token to anchor at; its real source position (and
  // owning module) rides in the index-keyed `vcDg*` side table instead.
  let d = 0
  while d < r.diags.length {
    vcDgPush(
      P.diags.length,
      r.diags[d].line,
      r.diags[d].col,
      r.diags[d].endCol,
      vcLoadMod,
    )
    P.diags.push({ msg: r.diags[d].msg, at: -1 })
    d = d + 1
  }
  P.toks.length
}
// ── deep `is` over a `Json` value — the second check pass (D1035) ────────────
// `r is T` for a json-shape `T` not one of the union's arms is a runtime shape walk
// the checker cannot lower: pass 1 records the sites, this pass generates one
// predicate/builder per target as VL source and re-checks. No deep `is` means no second pass.
function jwSecondPass(root: i32): i32 {
  if jwSiteNode.length == 0 { return 0 }
  const gen = jwGenerateSource()
  if gen == "" { return 0 }
  // The fragment is tokenized ONTO the existing stream (the module pipeline's
  // own move) and parsed with `P.pos` at its first token, so every node the user
  // wrote keeps its arena index and the recorded sites stay valid.
  P.pos = P.toks.length
  const jwGenTok = P.toks.length
  vcLoadToks(gen)
  jwRestoreMangling(jwGenTok)
  const frag = parseProgram()
  if vcParseBlocked() { return 1 }
  if !jwSplice(root, frag) {
    vcDgPush(P.diags.length, 1, 0, 0, 0)
    P.diags.push(
      { msg: "internal: deep `is` walkers could not be spliced", at: -1 },
    )
    return 1
  }
  // A refusal is already a positioned TYPE error on the offending `is` site; rc 2 is the
  // type-error rung, exactly as pass 1's own diagnostics take.
  if jwRewriteAll() > 0 { return 2 }
  initChecker()
  // AFTER the reset, not before: `initChecker` clears the walker worklist and this marker
  // with it. The style tier must not report a finding about code the author never wrote,
  // and the marker is the first generated token (`jwTokIsGenerated` reads it).
  jwSetGenTokStart(jwGenTok)
  checkProgram(root)
  0
}

// 0 = ok; 1 = lex/parse error; 2 = type error; 3 = emit error.
export function compileSrc(): i32 {
  symSetEnabled(0)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  W.bytes = []
  emitErr = ""
  fnNames = []
  fnIndices = []
  localNames = []
  globalStmts = []
  globalNames = []
  initChecker()
  // Module mode (H3): a non-empty module table runs the multi-file pipeline
  // (order/validate → parse-merge → rename/rewrite → check/emit). With an EMPTY
  // table (every existing consumer) the single-source path below is untouched.
  if modKeys.length > 0 { return modCompile(1) }
  vcLoadToks(vcSource())
  const root = parseProgram()
  if vcParseBlocked() { return 1 }
  csPreMintLocs()
  checkProgram(root)
  // Emit never proceeds past a parse diagnostic, lossless or not: `vl build`/`vl run`
  // still keep rc 1 and the same parse message. The only difference lossless recovery
  // makes is that the checker's type errors are reported alongside it, not hidden.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  const jwRc = jwSecondPass(root)
  if jwRc != 0 { return jwRc }
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  // A single-source program's wasm ABI is its `export`-marked functions, staged
  // through the same alias tables a module build fills (public name → target;
  // unmangled here — no merge). Reset first: a PRIOR module compile on this
  // instance left its aliases behind. The emitter exports only these entries.
  reExpName = []
  reExpTarget = []
  let xt = 0
  while xt + 2 < P.toks.length {
    if (
      P.toks[xt].kind == "EXPORT" &&
      P.toks[xt + 1].kind == "FUNCTION" &&
      P.toks[xt + 2].kind == "IDENT" &&
      !capHas(reExpName, P.toks[xt + 2].text)
    ) {
      reExpName.push(P.toks[xt + 2].text)
      reExpTarget.push(P.toks[xt + 2].text)
    }
    xt = xt + 1
  }
  const rc = emitProgram(root)
  if rc < 0 { return 3 }
  0
}
export function rbyteLen(): i32 { W.bytes.length }
export function rbyteAt(i: i32): i32 { W.bytes[i] }
// ── bulk result read-back over linear memory — the out mirror of `srcLoad` ───────
// `rbyteAt` above is one host call per emitted byte; this batched form has the guest
// write the staging window and the host copy out, packed four bytes per i32 word so
// the copy is a `memcpy`. A return of 0 or more than `count` is a protocol violation.
export function rbyteStore(off: i32, count: i32): i32 {
  const bs = W.bytes
  const avail = bs.length - off
  let n = count
  if n > avail { n = avail }
  if n < 0 { n = 0 }
  let i = 0
  while i + 4 <= n {
    const b0 = bs[off + i]
    const b1 = bs[off + i + 1]
    const b2 = bs[off + i + 2]
    const b3 = bs[off + i + 3]
    __store_i32__(i, b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))
    i = i + 4
  }
  if i < n {
    let w = 0
    let k = n - 1
    while k >= i {
      w = (w << 8) | bs[off + k]
      k = k - 1
    }
    __store_i32__(i, w)
  }
  n
}
// `vl check`: parse and typecheck only, no emit. 0 = ok, 1 = lex/parse, 2 = type.
// Skipping emit makes `check` faster on large inputs and avoids rejecting a type-
// valid program the emitter cannot yet lower — an emit-coverage gap is not a check
// failure. Shares the diagnostic stores (`diagLen`/`diagAt`) with `compileSrc`.
export function checkSrc(): i32 {
  symSetEnabled(0)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  fnNames = []
  fnIndices = []
  localNames = []
  globalStmts = []
  globalNames = []
  // `check` never emits, so clear the emit-stage ABI a prior `compileSrc` on
  // this instance populated: stale `W.bytes` would read back through
  // `rbyteLen`/`rbyteAt`, and a stale `emitErr` would append a phantom emit
  // diagnostic to THIS check's `diagCount`/`vcDiags` stream.
  W.bytes = []
  emitErr = ""
  initChecker()
  // Module mode (H3) — see compileSrc; `check` runs the same pipeline minus emit.
  if modKeys.length > 0 { return modCompile(0) }
  vcLoadToks(vcSource())
  const root = parseProgram()
  if vcParseBlocked() { return 1 }
  csPreMintLocs()
  checkProgram(root)
  // A lossless-recovered file reports BOTH streams and keeps rc 1 — the parse
  // mistake is still the headline error, the type errors ride with it.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  // `check` runs the deep-`is` second pass too: a site the rewrite cannot route
  // is a hard error, and `vl check` must not say yes to a program `vl build`
  // then refuses.
  const jwRc = jwSecondPass(root)
  if jwRc != 0 { return jwRc }
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  0
}

// ── lint tier ──────────────────────────────────────────────────────────────────
// Runs the AST-derivable lint pass (`compiler/lint.vl`), on the parse alone with
// no typecheck, matching the standalone lint harness. Returns the finding count,
// or -1 on a lex/parse error; the host reads each via `lintCount`/`lintSev*`/`lintMsg*`.
export function lintSrc(): i32 {
  symSetEnabled(0)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  vcLoadToks(vcSource())
  const root = parseProgram()
  // A lossless-recovered AST is the one the user wrote, so lint's findings over it
  // are as real as any other file's; only a lossy parse still returns -1. The parse
  // diagnostics are not lost — every caller reads them from the error stream before
  // or beside this call.
  if vcParseBlocked() { return -1 }
  // Comments never reach the arena; the comment-budget rules read the text.
  lintSetSource(vcSource())
  lint(root)
  lintCount()
}

export function lintSevLen(i: i32): i32 { lintSevAt(i).length }
export function lintSevByte(i: i32, j: i32): i32 { lintSevAt(i)[j] }
export function lintMsgLen(i: i32): i32 { lintMsgAt(i).length }
export function lintMsgByte(i: i32, j: i32): i32 { lintMsgAt(i)[j] }
// The stable rule `code` (e.g. "unused-variable", "prefer-const") drives the LSP
// quick-fixes, and the 1-based line / 0-based col place the squiggle.
export function lintCodeLen(i: i32): i32 { lintCodeAt(i).length }
export function lintCodeByte(i: i32, j: i32): i32 { lintCodeAt(i)[j] }
export function lintLine(i: i32): i32 { lintLineAt(i) }
export function lintCol(i: i32): i32 { lintColAt(i) }

// ── module-graph lint (per-module, with file attribution) ─────────────────────
// Runs the lint pass over every resolved module of the graph, not just the entry,
// so a finding is reported against its own file — each module re-parsed in
// isolation. Resets `P.toks`/`nodeToks`, so error-tier anchors must be read first.
let lgCodes: string[] = []
let lgMsgs: string[] = []
let lgSevs: string[] = []
let lgLines: i32[] = []
let lgCols: i32[] = []
let lgMods: i32[] = []

// Copy the lint sink (one module's `lint(root)` run) into the graph accumulators
// under module index `m`.
function lgCopySink(m: i32): i32 {
  let i = 0
  while i < lintCount() {
    lgCodes.push(lintCodeAt(i))
    lgMsgs.push(lintMsgAt(i))
    lgSevs.push(lintSevAt(i))
    lgLines.push(lintLineAt(i))
    lgCols.push(lintColAt(i))
    lgMods.push(m)
    i = i + 1
  }
  0
}

export function lintGraph(): i32 {
  lgCodes = []
  lgMsgs = []
  lgSevs = []
  lgLines = []
  lgCols = []
  lgMods = []
  if modKeys.length == 0 {
    // No graph: the single-source path (module 0 = the entry, like `lintSrc`).
    if lintSrc() < 0 { return 0 }
    lgCopySink(0)
    return lgCodes.length
  }
  symSetEnabled(0)
  let m = 0
  while m < modKeys.length {
    if modFound[m] != 0 {
      P.toks = []
      P.nodes = []
      // The sharpest edge the carrier has: this loop re-parses each module into a
      // fresh arena, so index 5 is a different identifier every iteration — without
      // this reset `sidOfNode(5)` would answer with a different module's name.
      sidReset()
      sidKeyedTablesReset()
      P.diags = []
      vcDiagMemoReset()
      P.pos = 0
      nodeToks = []
      tsReset()
      declNameTok = []
      tplHole = []
      vcDgReset()
      vcLoadToksMod(m)
      const root = parseProgram()
      // Same rule as `lintSrc`: a clean parse OR an all-lossless recovery.
      if !vcParseBlocked() {
        lintSetSource(modSrcs[m])
        lintSetPath(modKeys[m])
        lint(root)
        lgCopySink(m)
      }
    }
    m = m + 1
  }
  lgCodes.length
}

// Per-finding accessors (the `lint*` idiom, plus the owning module's index).
export function lintGraphCount(): i32 { lgCodes.length }
export function lintGraphModule(i: i32): i32 { lgMods[i] }
export function lintGraphLine(i: i32): i32 { lgLines[i] }
export function lintGraphCol(i: i32): i32 { lgCols[i] }
export function lintGraphSevLen(i: i32): i32 { lgSevs[i].length }
export function lintGraphSevByte(i: i32, j: i32): i32 { lgSevs[i][j] }
export function lintGraphMsgLen(i: i32): i32 { lgMsgs[i].length }
export function lintGraphMsgByte(i: i32, j: i32): i32 { lgMsgs[i][j] }
export function lintGraphCodeLen(i: i32): i32 { lgCodes[i].length }
export function lintGraphCodeByte(i: i32, j: i32): i32 { lgCodes[i][j] }
// String reads for same-assembly consumers (the CLI): the code/sev/msg values.
export function lintGraphCodeAt(i: i32): string { lgCodes[i] }
export function lintGraphSevAt(i: i32): string { lgSevs[i] }
export function lintGraphMsgAt(i: i32): string { lgMsgs[i] }

// ── format tier ────────────────────────────────────────────────────────────────
// Runs the AST-driven formatter (`compiler/format.vl`) and exposes its canonical
// output, re-parsing it as a round-trip safety gate. Returns the formatted length;
// -1 when the input does not parse, -2 when the output does not re-parse (a formatter bug).
export let vcFmtOut = ""
export function formatSrc(): i32 {
  symSetEnabled(0)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  const src = vcSource()
  // Lex once, feeding tokens into the parser AND the formatter's comment table
  // (the formatter slices spans from `src` and places comments around them).
  fmtSetSource(src)
  fmtResetComments()
  const r = tokenize(src)
  let i = 0
  while i < r.tokens.length {
    const t = r.tokens[i]
    P.toks.push(
      {
        kind: t.kind,
        text: t.text,
        pos: P.toks.length,
        start: t.start,
        line: t.line,
        col: t.col,
      },
    )
    i = i + 1
  }
  let d = 0
  while d < r.diags.length {
    // Keep the lex diag's real position and span (`diagLine`/`diagCol`/
    // `diagEndCol` read the vcDg* side table), so a caller can point at the
    // offending source.
    vcDgPush(
      P.diags.length,
      r.diags[d].line,
      r.diags[d].col,
      r.diags[d].endCol,
      0,
    )
    P.diags.push({ msg: r.diags[d].msg, at: -1 })
    d = d + 1
  }
  let c = 0
  while c < r.comments.length {
    const cm = r.comments[c]
    let tr = 0
    if cm.trailing { tr = 1 }
    fmtAddComment(cm.text, cm.start, cm.line, tr)
    c = c + 1
  }
  if P.diags.length > 0 { return -1 }
  const root = parseProgram()
  // Not `vcParseBlocked`: the formatter is the one consumer that must keep the "any"
  // reading. A lossless recovery preserves the program's meaning, which is all the
  // checker needs, but the formatter writes its output back over the file (`vl fmt
  // -w`), so printing the recovered AST would silently re-spell the user's mistake.
  if P.diags.length > 0 { return -1 }
  vcFmtOut = formatProgram(root)
  // ── round-trip safety gate ──────────────────────────────────────────────────
  // Re-lexes and re-parses the output before handing it back: a printer bug that
  // emits unparseable text must surface as a loud -2, never as data loss through
  // `fmt -w`. An output equal to the input needs no gate, at zero extra cost.
  if vcFmtOut == src { return vcFmtOut.length }
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  vcLoadToks(vcFmtOut)
  if P.diags.length == 0 { parseProgram() }
  if P.diags.length > 0 { return -2 }
  vcFmtOut.length
}
export function fmtLen(): i32 { vcFmtOut.length }
export function fmtByteAt(j: i32): i32 { vcFmtOut[j] }

// ── LSP symbol query: a symbol-aware check ────────────────────────────────────
// Identical to `checkSrc` but with the symbol table on, so the query accessors
// below can read occurrence and binding-type tables. Used only by the LSP's
// go-to-def/find-refs/hover path; every other consumer forces the table off.
export function checkSrcSym(): i32 {
  symSetEnabled(1)
  P.toks = []
  P.nodes = []
  sidReset()
  sidKeyedTablesReset()
  P.diags = []
  vcDiagMemoReset()
  P.pos = 0
  nodeToks = []
  tsReset()
  declNameTok = []
  tplHole = []
  vcDgReset()
  fnNames = []
  fnIndices = []
  localNames = []
  globalStmts = []
  globalNames = []
  // Clear the emit-stage ABI — see checkSrc (a symbol-aware check never emits).
  W.bytes = []
  emitErr = ""
  initChecker()
  if modKeys.length > 0 {
    const mrc = modCompile(0)
    return mrc
  }
  vcLoadToks(vcSource())
  const root = parseProgram()
  if vcParseBlocked() { return 1 }
  csPreMintLocs()
  checkProgram(root)
  // Lossless recovery: the symbol tables ARE populated for the rc-1 result too,
  // so hover / go-to-def / find-refs keep answering across a missing brace.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  0
}

// The occurrence table (parallel to the host's `SymbolOccurrence[]`). After a
// `checkSrcSym`, the host reads `symCount()` occurrences; for each, its source span,
// `symIsDecl(i)` (1 = declaration, 0 = use), and `symBindingId(i)` — the declaring
// node index, the stable identity two occurrences share iff they name the same binding.
export function symCount(): i32 { symOccCount() }
export function symSpanStartLine(i: i32): i32 { symOccStartLine(i) }
export function symSpanStartCol(i: i32): i32 { symOccStartCol(i) }
export function symSpanEndLine(i: i32): i32 { symOccEndLine(i) }
export function symSpanEndCol(i: i32): i32 { symOccEndCol(i) }
export function symIsDecl(i: i32): i32 { symOccIsDeclAt(i) }
export function symBindingId(i: i32): i32 { symOccBinding(i) }

// Cross-file find-references: the module (table index) occurrence `i` belongs to.
// A module's tokens occupy a contiguous range of the merged `P.toks`, recorded as
// `modLoadStart`/`modLoadMod`; maps the occurrence's anchor token into that range.
// Single-file mode (no module load) is always 0.
export function modOfTok(tok: i32): i32 {
  let best = 0
  let o = 0
  while o < modLoadStart.length {
    if modLoadStart[o] <= tok { best = modLoadMod[o] }
    o = o + 1
  }
  best
}
// `__callsite__` mints one location-value node per call, before the checker runs,
// since a default's value here IS the site (every other default form shares one
// node). A pre-pass, not a rewrite: minted before `checkProgram` sizes `nodeTyIx`
// (D969), or a later-minted node would read its type back as -1 forever.
function csAnyCallsiteDefault(): boolean {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is Param {
      if paramDefaultIsCallsite(n.parDefault) { return true }
    }
    i = i + 1
  }
  false
}

// `s` as a string-literal lexeme — quotes kept, `"` and `\` escaped. `StrLit`
// carries the raw lexeme (`decodeStr` resolves the escapes later), so a synthesized
// literal has to be built in that same currency.
function csStrLexeme(s: string): string {
  const buf: i32[] = []
  buf.push(34)
  for cp in s {
    if cp == 34 || cp == 92 { buf.push(92) }
    buf.push(cp)
  }
  buf.push(34)
  fromCodePoints(buf)
}

// The module KEY owning the token at `tok` — the merged program's name for the
// file. A single-source compile has no module table and answers "", which is the
// honest reading: nothing in that pipeline knows the entry's path (the CLI
// prints one it holds host-side, and never tells the compiler).
function csFileOfTok(tok: i32): string {
  if modKeys.length == 0 { return "" }
  const m = modOfTok(tok)
  if m < 0 || m >= modKeys.length { return "" }
  modKeys[m]
}

export function csPreMintLocs(): i32 {
  paramDefaultTablesReset()
  if !csAnyCallsiteDefault() { return 0 }
  // Snapshot the length FIRST — minting appends, and the nodes appended are not
  // themselves calls.
  const n0 = P.nodes.length
  let i = 0
  while i < n0 {
    const n = P.nodes[i]
    if n is Call {
      let ln = 0
      let co = 0
      let file = ""
      // The callee's own anchor token — `where` in `where(1)`, `f` in `x.f(1)` —
      // what a reader means by "the call site". Not `tokIndexAt(n.pos)`: that binary
      // search assumes `P.toks[i].start` ascends, which fails across a module
      // boundary in the merged stream. `nodeToks` has no such assumption.
      let tk = -1
      if n.callFn >= 0 && n.callFn < nodeToks.length { tk = nodeToks[n.callFn] }
      if tk < 0 {
        if i < nodeToks.length { tk = nodeToks[i] }
      }
      if tk >= 0 && tk < P.toks.length {
        ln = P.toks[tk].line
        co = P.toks[tk].col + 1
        file = csFileOfTok(tk)
      }
      const fields: i32[] = []
      fields.push(mkFieldInit("file", mkStr(csStrLexeme(file), -1), -1))
      fields.push(mkFieldInit("line", mkNum(i32ToStr(ln), -1), -1))
      fields.push(mkFieldInit("col", mkNum(i32ToStr(co), -1), -1))
      // The `ObjLit` keeps the CALL's position so a type error on this argument
      // points at the call the author wrote, not at nowhere.
      setCallSiteLoc(i, mkObjLit(fields, n.pos))
    }
    i = i + 1
  }
  0
}

export function symOccModuleAt(i: i32): i32 {
  const tok = symOccTokAt(i)
  if tok < 0 { return 0 }
  modOfTok(tok)
}

// Semantic tokens: after a `checkSrcSym`, the recorded occurrences are the
// classified identifiers, so `tokCount` is `symCount` and spans reuse `symSpan*`.
// The one addition is `tokBindKindAt(i)` (0=local, 1=param, 2=function, -1
// otherwise). Identifiers only; the host keeps its own pass for everything else.
export function tokCount(): i32 { symOccCount() }
export function tokBindKindAt(i: i32): i32 { symOccKindAt(i) }
export function tokSpanStartLine(i: i32): i32 { symOccStartLine(i) }
export function tokSpanStartCol(i: i32): i32 { symOccStartCol(i) }
export function tokSpanEndCol(i: i32): i32 { symOccEndCol(i) }

// Go-to-definition: the occurrence index of the DECLARATION for the binding whose
// occurrence covers (line, col), or -1 when the cursor is off any tracked name.
// Read its span via the `symSpan*` accessors.
export function defAt(line: i32, col: i32): i32 { symDefAt(line, col) }

// Find-references: the count of occurrences (declaration + uses) of the binding
// at (line, col), and the k-th such occurrence INDEX (its span via `symSpan*`).
export function refsCountAt(line: i32, col: i32): i32 {
  symRefsCountAt(line, col)
}
export function refAt(line: i32, col: i32, k: i32): i32 {
  symRefAt(line, col, k)
}

// Hover-types: the rendered type string of the binding at (line, col), exposed
// per-codepoint (the `rbyte*` idiom). `typeStrAt` computes the string and returns
// its length; `typeStrCharAt(j)` reads code point `j` of it. A cursor off any
// tracked binding yields a zero-length string.
let symTyBuf: string = ""
export function typeStrAt(line: i32, col: i32): i32 {
  symTyBuf = symTypeStrAt(line, col)
  symTyBuf.length
}
export function typeStrLen(): i32 { symTyBuf.length }
export function typeStrCharAt(j: i32): i32 { symTyBuf[j] }

// Type-alias hover: the rendered type of the user `type` NAME (struct/union alias)
// under (line, col) — its decl name or a use in an annotation — exposed
// per-codepoint like `typeStrAt`. "" when the cursor is off a known user type.
let typeAliasBuf: string = ""
export function typeAliasAt(line: i32, col: i32): i32 {
  typeAliasBuf = symTypeAliasAt(line, col)
  typeAliasBuf.length
}
export function typeAliasCharAt(j: i32): i32 { typeAliasBuf[j] }

// Inlay hints: after a `checkSrcSym`, the inferred type at each unannotated
// declaration. `inlayScan` records the set; accessors read each hint's kind (0 =
// value binding's type, 1 = function's return type), the name-end position, and
// the rendered type label (per-codepoint).
export function inlayScan(): i32 { symInlayScan() }
export function inlayCount(): i32 { symInlayCount() }
export function inlayKindAt(i: i32): i32 { symInlayKindAt(i) }
export function inlayLineAt(i: i32): i32 { symInlayLineAt(i) }
export function inlayColAt(i: i32): i32 { symInlayColAt(i) }
export function inlayTypeLen(i: i32): i32 { symInlayTypeLen(i) }
export function inlayTypeCharAt(i: i32, j: i32): i32 {
  symInlayTypeCharAt(i, j)
}
// The module (table index) hint `i` belongs to (0 = the entry). A whole-program
// compile records a hint for every module's unannotated decls, so the host keeps
// only the entry's — else a dependency's hints render against the importer's own
// lines. Mirrors `symOccModuleAt` for the semantic-token slice.
export function inlayModuleAt(i: i32): i32 { symOccModuleAt(symInlayOccAt(i)) }

// The module a redundant-type finding belongs to (its name token's owner). Lets
// the cli keep only the ENTRY module's (== 0) findings in a multi-module compile,
// where every module's AST is merged. Single-file mode has no module table, so
// `modOfTok` returns 0 throughout (nothing filtered). Mirrors `inlayModuleAt`.
export function redunModuleAt(i: i32): i32 { modOfTok(redunTokAt(i)) }

// The redundant-annotation finding's message, per code point — the same byte ABI
// `lintMsg*`/`diagMsg*` use. Type-informed, so it never appears in the parse-only
// `lintSrc` stream; `redunMsgAt` rebuilds the string on every call, deliberately not
// memoized, since an index-keyed cache would serve a stale program's message.
export function redunMsgLen(i: i32): i32 { redunMsgAt(i).length }
export function redunMsgByte(i: i32, j: i32): i32 { redunMsgAt(i)[j] }

// The dead-`??`-default stream's module + message ABI, the exact twin of the
// redundant-annotation pair above and for the same reason: the finding is
// type-informed, so it never appears in the parse-only `lintSrc` stream and would
// otherwise be visible to the CLI alone.
export function rcoalModuleAt(i: i32): i32 { modOfTok(rcoalTokAt(i)) }
export function rcoalMsgLen(i: i32): i32 { rcoalMsgAt(i).length }
export function rcoalMsgByte(i: i32, j: i32): i32 { rcoalMsgAt(i)[j] }

// The collapsed-operand `is` stream's module + message ABI — the same twin again,
// for the same reason (type-informed, so invisible to `lintSrc`).
export function isvalModuleAt(i: i32): i32 { modOfTok(isvalTokAt(i)) }
export function isvalMsgLen(i: i32): i32 { isvalMsgAt(i).length }
export function isvalMsgByte(i: i32, j: i32): i32 { isvalMsgAt(i)[j] }

// Member hover: the rendered type string of the member access whose property name
// is at (line, col) — `o.x`/`o?.y` — exposed per-codepoint like `typeStrAt`. A
// cursor off any recorded member access yields a zero-length string.
let memTyBuf: string = ""
export function memberTypeStrAt(line: i32, col: i32): i32 {
  memTyBuf = symMemTypeStrAt(line, col)
  memTyBuf.length
}
export function memberTypeStrLen(): i32 { memTyBuf.length }
export function memberTypeStrCharAt(j: i32): i32 { memTyBuf[j] }

// Signature help: after a `checkSrcSym`, the parameter table of the function whose
// name sits at (line, col). `sigAt` returns the row count, or -1 when nothing there
// is callable — a zero-parameter function is a real empty-table signature, so the
// host tells the two apart by the sign. Accessors read each parameter's name and type.
export function sigAt(line: i32, col: i32): i32 { symSigAt(line, col) }
export function sigParamNameLen(i: i32): i32 { symSigParamNameLen(i) }
export function sigParamNameCharAt(i: i32, j: i32): i32 {
  symSigParamNameCharAt(i, j)
}
export function sigParamTypeLen(i: i32): i32 { symSigParamTypeLen(i) }
export function sigParamTypeCharAt(i: i32, j: i32): i32 {
  symSigParamTypeCharAt(i, j)
}
// The parameter's default value as source text, zero length when it has none —
// what makes a defaulted parameter render as `b: i32 = 10` in an editor that has
// no other way to flag it optional.
export function sigParamDefaultLen(i: i32): i32 { symSigParamDefaultLen(i) }
export function sigParamDefaultCharAt(i: i32, j: i32): i32 {
  symSigParamDefaultCharAt(i, j)
}
export function sigRetLen(): i32 { symSigRetLen() }
export function sigRetCharAt(j: i32): i32 { symSigRetCharAt(j) }

// Member semantic tokens: after a `checkSrcSym`, every member-access property name
// the checker resolved — `memberCount()` then per-index span and class. A member is
// a `method` when its resolved type is a function, else a `property`. Lets the wasm
// semantic-tokens path classify `o.x`/`xs.get` itself.
export function memberCount(): i32 { symMemberCount() }
export function memberLineAt(i: i32): i32 { symMemberLine(i) }
export function memberColAt(i: i32): i32 { symMemberCol(i) }
export function memberLenAt(i: i32): i32 { symMemberLen(i) }
export function memberIsMethodAt(i: i32): i32 { symMemberIsMethod(i) }

// Scope-at-position (completion): after a `checkSrcSym`, the user bindings visible at
// (line, col). `scopeAt` returns the set's count; accessors read each binding's name,
// kind and rendered type. Multi-module: filtered to bindings declared in the entry
// plus the dep declarations it imports, else a dep's whole span would leak in.
export function scopeAt(line: i32, col: i32): i32 {
  const n = symScopeAt(line, col)
  // The merged names the entry's imports denote — the only dep rows kept.
  const okDep: {[string]: i32} = Map()
  let ij = 0
  while ij < impMod.length {
    if impMod[ij] == 0 && impLocal[ij] != "" && impName[ij] != "" {
      const dd = modIndexOfKey(impKey[ij])
      if dd >= 0 { okDep[modMergedTargetOf(dd, impName[ij])] = 1 }
    }
    ij = ij + 1
  }
  let w = 0
  let i = 0
  while i < n {
    const fromEntry = modOfTok(scopeResTok[i]) == 0
    if fromEntry || (okDep[scopeResRaw[i]] ?? 0) == 1 {
      if w != i {
        scopeResName[w] = scopeResName[i]
        scopeResKind[w] = scopeResKind[i]
        scopeResType[w] = scopeResType[i]
        scopeResRaw[w] = scopeResRaw[i]
        scopeResTok[w] = scopeResTok[i]
      }
      w = w + 1
    }
    i = i + 1
  }
  while scopeResName.length > w {
    scopeResName.pop()
    scopeResKind.pop()
    scopeResType.pop()
    scopeResRaw.pop()
    scopeResTok.pop()
  }
  w
}
export function scopeNameLen(i: i32): i32 { symScopeNameLen(i) }
export function scopeNameCharAt(i: i32, j: i32): i32 {
  symScopeNameCharAt(i, j)
}
export function scopeKindAt(i: i32): i32 { symScopeKindAt(i) }
export function scopeTypeLen(i: i32): i32 { symScopeTypeLen(i) }
export function scopeTypeCharAt(i: i32, j: i32): i32 {
  symScopeTypeCharAt(i, j)
}

// Member completion: after a `checkSrcSym`, the members of the receiver type whose
// binding is under (line, col). `memberScanAt` resolves and records the set;
// accessors read each member's name, detail type, and method flag. The host strips
// the trailing `.` so the receiver parses as a bare expression at its original position.
export function memberScanAt(line: i32, col: i32): i32 {
  symMemberScanAt(line, col)
}
export function memberScanCount(): i32 { symMemberScanCount() }
export function memberScanNameLen(i: i32): i32 { symMemberScanNameLen(i) }
export function memberScanNameCharAt(i: i32, j: i32): i32 {
  symMemberScanNameCharAt(i, j)
}
export function memberScanTypeLen(i: i32): i32 { symMemberScanTypeLen(i) }
export function memberScanTypeCharAt(i: i32, j: i32): i32 {
  symMemberScanTypeCharAt(i, j)
}
export function memberScanIsFn(i: i32): i32 { symMemberScanIsFn(i) }

// UFCS candidates: after a `checkSrcSym`, the free `self`-functions the receiver
// under (line, col) dispatches to — the half `memberScanAt` cannot see, since it
// reads the receiver's field set while this reads the program's declarations.
// Accessors read each candidate's demangled name, signature, and owning module.
export function ufcsScanAt(line: i32, col: i32): i32 {
  symUfcsScanAt(line, col)
}
export function ufcsScanCount(): i32 { symUfcsScanCount() }
export function ufcsScanNameLen(i: i32): i32 { symUfcsScanNameLen(i) }
export function ufcsScanNameCharAt(i: i32, j: i32): i32 {
  symUfcsScanNameCharAt(i, j)
}
export function ufcsScanDetailLen(i: i32): i32 { symUfcsScanDetailLen(i) }
export function ufcsScanDetailCharAt(i: i32, j: i32): i32 {
  symUfcsScanDetailCharAt(i, j)
}
export function ufcsScanModuleAt(i: i32): i32 {
  const tk = symUfcsScanTokAt(i)
  if tk < 0 { return 0 }
  modOfTok(tk)
}
export function ufcsScanExportedAt(i: i32): i32 { symUfcsScanExportedAt(i) }

// Builtin completions: the compiler's builtin surface — type names, builtin
// functions, and linear-memory intrinsics — kept here beside the compiler that owns
// it. Static: `builtinScan` fills the table, accessors read each entry's name, kind
// and detail type. Hand-listed since these are special-cased call arms with no scope entry.
let blName: string[] = []
let blKind: i32[] = []
let blType: string[] = []
function blPush(n: string, k: i32, t: string) {
  blName.push(n)
  blKind.push(k)
  blType.push(t)
}
export function builtinScan(): i32 {
  // Every type string below is read by a person as the completion `detail`, so it is
  // spelled the way VL source spells a type, `(params) => ret`. Hand-written rather
  // than rendered, which is the shape that can drift from `tyToStr`'s own answer.
  blName = []
  blKind = []
  blType = []
  blPush("i32", 0, "i32")
  blPush("i64", 0, "i64")
  blPush("f32", 0, "f32")
  blPush("f64", 0, "f64")
  blPush("boolean", 0, "boolean")
  blPush("string", 0, "string")
  // `print` is an overload set, not a polymorphic function, so the accepted set
  // renders as a union of the reps that actually print. Advertised and enforced
  // domain are literally one `printDomainStr()` (also `tyPrintsAsRef`'s refusal
  // string), so they cannot drift. `toString` lives in `std:fmt` instead (DECISIONS.md).
  blPush("print", 1, "(" + printDomainStr() + ") => void")
  blPush("fromCodePoint", 1, "(i32) => string")
  blPush("fromCodePoints", 1, "(i32[]) => string")
  // D1582 — the DETAIL names the type a completion produces, and `Map`/`Set` are
  // not type names: the index signature is. Naming them here handed the one reader
  // who could still be told the spelling a type that does not resolve.
  blPush("Map", 1, "() => {[K]: V}")
  blPush("Set", 1, "() => {[K]: boolean}")
  // The linear-memory intrinsics that actually lower — only completed so a name that
  // passes `vl check` cannot then fail at emit. The addresses are byte offsets and
  // the ops match the wasm instructions' signatures exactly: `__load_i8__` sign-
  // extends into the i32 result, `__load_u8__` zero-extends; stores are sign-agnostic.
  blPush("__store_i32__", 1, "(i32, i32) => void")
  blPush("__store_i64__", 1, "(i32, i64) => void")
  blPush("__store_f32__", 1, "(i32, f32) => void")
  blPush("__store_f64__", 1, "(i32, f64) => void")
  blPush("__load_i32__", 1, "(i32) => i32")
  blPush("__load_i8__", 1, "(i32) => i32")
  blPush("__load_u8__", 1, "(i32) => i32")
  blPush("__load_i16__", 1, "(i32) => i32")
  blPush("__load_u16__", 1, "(i32) => i32")
  blPush("__load_i64__", 1, "(i32) => i64")
  blPush("__load_f32__", 1, "(i32) => f32")
  blPush("__load_f64__", 1, "(i32) => f64")
  // `memory.size` is the CURRENT size in 64 KiB pages; `memory.grow` returns the
  // size BEFORE the growth, or -1 if it failed.
  blPush("__memory_size__", 1, "() => i32")
  blPush("__memory_grow__", 1, "(i32) => i32")
  // The filesystem floor — the only host-imported intrinsics spellable in VL source,
  // listed by the memory tier's same rule (only names that actually lower). This is
  // the floor beneath `std:fs`, not the surface (an author reaches for `readTextFile`),
  // but a host embedder implementing the ABI needs the signatures.
  blPush("__fs_read__", 1, "(u8[]) => u8[]")
  blPush("__fs_write__", 1, "(u8[], u8[]) => i32")
  blPush("__fs_list__", 1, "(u8[]) => u8[]")
  blPush("__fs_stat__", 1, "(u8[]) => i32")
  blPush("__fs_read_range__", 1, "(u8[], i64, i32) => u8[]")
  blPush("__fs_size__", 1, "(u8[]) => i64")
  blPush("__args_count__", 1, "() => i32")
  blPush("__args_get__", 1, "(i32) => u8[]")
  blPush("__fs_errno__", 1, "() => i32")
  blName.length
}
export function builtinCount(): i32 { blName.length }
export function builtinNameLen(i: i32): i32 { blName[i].length }
export function builtinNameCharAt(i: i32, j: i32): i32 { blName[i][j] }
export function builtinKindAt(i: i32): i32 { blKind[i] }
export function builtinTypeLen(i: i32): i32 { blType[i].length }
export function builtinTypeCharAt(i: i32, j: i32): i32 { blType[i][j] }

// ── LSP lexical semantic tokens: keywords / operators / literals / comments ────
// Needs no typecheck: `lexScan()` tokenizes the staged source and records, per
// coloured token, a lexical class (0 keyword .. 5 template text) plus its position;
// uncoloured kinds (identifiers, strings, punctuation) drop out at class < 0.
let lexCls: i32[] = []
let lexLine: i32[] = []
let lexCol: i32[] = []
let lexLen: i32[] = []

// The lexical class for a lexer token kind, or -1 for kinds that get no token.
// Keyed off the lexer's actual kind tags, so every operator the lexer emits colours.
// The keyword arms copy `keywordKind`'s (`lexer.vl`); `tests/keyword_vocabulary_test.ts`
// derives the set from the lexer and fails this function when an arm is missing.
function lexClassOf(kind: TokKind): i32 {
  if kind == "NUMBER" { return 2 }
  if (
    kind == "TEMPLATE" ||
    kind == "TEMPLATE_HEAD" ||
    kind == "TEMPLATE_MID" ||
    kind == "TEMPLATE_TAIL"
  ) {
    return 5
  }
  if kind == "TRUE" || kind == "FALSE" || kind == "NULL" { return 3 }
  if (
    kind == "FUNCTION" ||
    kind == "IF" ||
    kind == "ELSE" ||
    kind == "WHILE" ||
    kind == "FOR" ||
    kind == "CONST" ||
    kind == "LET" ||
    kind == "RETURN" ||
    kind == "IS" ||
    kind == "AWAIT" ||
    kind == "BREAK" ||
    kind == "CONTINUE" ||
    kind == "TYPE" ||
    kind == "IMPORT" ||
    kind == "EXPORT" ||
    kind == "MATCH"
  ) {
    return 0
  }
  if (
    kind == "PLUS" ||
    kind == "MINUS" ||
    kind == "STAR" ||
    kind == "SLASH" ||
    kind == "PERCENT" ||
    kind == "CARET" ||
    kind == "EQUAL" ||
    kind == "PLUSEQ" ||
    kind == "MINUSEQ" ||
    kind == "STAREQ" ||
    kind == "SLASHEQ" ||
    kind == "PLUSPLUS" ||
    kind == "MINUSMINUS" ||
    kind == "AND" ||
    kind == "OR" ||
    kind == "BANG" ||
    kind == "EQ" ||
    kind == "NE" ||
    kind == "GT" ||
    kind == "GE" ||
    kind == "LT" ||
    kind == "LE" ||
    kind == "PIPE" ||
    kind == "AMPERSAND" ||
    kind == "TILDE" ||
    kind == "SHL" ||
    kind == "SHR" ||
    kind == "USHR" ||
    kind == "QUESTION_DOT" ||
    kind == "QUESTION_QUESTION"
  ) {
    return 1
  }
  -1
}

export function lexScan(): i32 {
  lexCls = []
  lexLine = []
  lexCol = []
  lexLen = []
  const r = tokenize(vcSource())
  let i = 0
  while i < r.tokens.length {
    const t = r.tokens[i]
    const c = lexClassOf(t.kind)
    if c >= 0 {
      lexCls.push(c)
      lexLine.push(t.line)
      lexCol.push(t.col)
      lexLen.push(t.text.length)
    }
    i = i + 1
  }
  // Retained comments → class COMMENT. The lexeme text includes the leading `//`
  // or `///`, so its length spans the whole comment to end of line.
  let k = 0
  while k < r.comments.length {
    const cm = r.comments[k]
    lexCls.push(4)
    lexLine.push(cm.line)
    lexCol.push(cm.col)
    lexLen.push(cm.text.length)
    k = k + 1
  }
  lexCls.length
}
export function lexCount(): i32 { lexCls.length }
export function lexClassAt(i: i32): i32 { lexCls[i] }
export function lexLineAt(i: i32): i32 { lexLine[i] }
export function lexColAt(i: i32): i32 { lexCol[i] }
export function lexLenAt(i: i32): i32 { lexLen[i] }

// All failure diagnostics, newline-joined: parse diags, then typecheck diags,
// then the emit failure message (whichever stage failed populated its store).
function vcDiags(): string {
  let out = ""
  let i = 0
  while i < P.diags.length {
    const d = P.diags[i]
    out = out + demangleMsg(d.msg) + "\n"
    i = i + 1
  }
  let j = 0
  while j < T.diags.length {
    const d2 = T.diags[j]
    out = out + demangleMsg(d2.tmsg) + "\n"
    j = j + 1
  }
  if emitErr.length > 0 { out = out + demangleMsg(emitErr) + "\n" }
  out
}
// The host reads the joined text one code point per call (`diagAt(i)`), so
// re-rendering on each read would make error reporting quadratic in the diagnostic
// text. Memoized (the `symTyBuf` idiom); the pipeline entry points invalidate it
// (`vcDiagMemoReset`) before repopulating the diagnostic stores.
let vcDiagsBuf = ""
let vcDiagsBufValid = 0
function vcDiagsMemo(): string {
  if vcDiagsBufValid == 0 {
    vcDiagsBuf = vcDiags()
    vcDiagsBufValid = 1
  }
  vcDiagsBuf
}
// Per-message memo for the structured stream (`diagMsgAt(i, j)` is likewise
// read once per character): the last (index, rendered message) pair.
let vcDiagMsgBufI = -1
let vcDiagMsgBuf = ""
function vcDiagMemoReset(): i32 {
  vcDiagsBufValid = 0
  vcDiagMsgBufI = -1
  0
}
export function diagLen(): i32 { vcDiagsMemo().length }
export function diagAt(i: i32): i32 { vcDiagsMemo()[i] }

// ── structured per-diagnostic exports (positions) ─────────────────────────────
// Parallel to `diagLen`/`diagAt`, which stay byte-compatible for corpus `@error`
// substring matches. The host reads `diagCount()` diagnostics, each with a
// per-byte message and a position (`diagLine`, 0 = no position; `diagCol`, 0-based).
export function vcDiagMsg(i: i32): string {
  // Demangle the module-merge `$mN` rename artifact so the user sees SOURCE names.
  if i < P.diags.length { return demangleMsg(P.diags[i].msg) }
  const j = i - P.diags.length
  if j < T.diags.length { return demangleMsg(T.diags[j].tmsg) }
  demangleMsg(emitErr)
}
export function diagCount(): i32 {
  let n = P.diags.length + T.diags.length
  if emitErr.length > 0 { n = n + 1 }
  n
}
function vcDiagMsgMemo(i: i32): string {
  if vcDiagMsgBufI != i {
    vcDiagMsgBuf = vcDiagMsg(i)
    vcDiagMsgBufI = i
  }
  vcDiagMsgBuf
}
export function diagMsgLen(i: i32): i32 { vcDiagMsgMemo(i).length }
export function diagMsgAt(i: i32, j: i32): i32 { vcDiagMsgMemo(i)[j] }
export function diagLine(i: i32): i32 {
  if i < P.diags.length {
    // A tokenless diag (lex / module-resolution) carries its own position.
    const k = vcDgFind(i)
    if k >= 0 { return vcDgLine[k] }
    // A parse diag is anchored at a token index; out of range ⇒ no position.
    const at = P.diags[i].at
    if at >= 0 && at < P.toks.length { return P.toks[at].line }
    return 0
  }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tline }
  // The emit failure (the last diagnostic): anchored at the function being lowered
  // when it failed (`emitErrAt`, resolved through `nodeToks` like a type diag), so
  // the diagnostic carries a source span. -1 ⇒ positionless (rendered bare).
  const et = emitErrTokIx()
  if et >= 0 { return P.toks[et].line }
  0
}
export function diagCol(i: i32): i32 {
  if i < P.diags.length {
    const k = vcDgFind(i)
    if k >= 0 { return vcDgCol[k] }
    const at = P.diags[i].at
    if at >= 0 && at < P.toks.length { return P.toks[at].col }
    return 0
  }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tcol }
  const et = emitErrTokIx()
  if et >= 0 { return P.toks[et].col }
  0
}
// The token index the emit-failure diagnostic anchors at (its function's decl),
// or -1 for a positionless (module-level) failure — the `emitErrAt` node resolved
// through `nodeToks`, mirroring a type diag's node→token resolution.
function emitErrTokIx(): i32 { declAnchorTokIx(emitErrAt) }

// The token an emit-side diagnostic anchors arena node `nodeIx` at, or -1. Prefers
// the declaring-name token over `nodeToks`' closing-brace anchor for a `FuncDecl`,
// since the name is where an editor jumps. D1578 — the one speller shared by the
// refusal channel and the validate diagnostic's function spans, so they cannot drift.
function declAnchorTokIx(nodeIx: i32): i32 {
  if nodeIx < 0 { return -1 }
  const nm = declNameTokOf(nodeIx)
  if nm >= 0 && nm < P.toks.length { return nm }
  if nodeIx >= nodeToks.length { return -1 }
  const at = nodeToks[nodeIx]
  if at >= 0 && at < P.toks.length { return at }
  -1
}

// The token a module-scope statement's diagnostic anchors at: its declaring name
// where it has one, else its first token. D1594 — `nodeToks` anchors at the last
// token consumed, so a thirty-line `if` chain anchored at its closing brace instead,
// nowhere near the code. Walks back rather than binary-searching `P.toks`.
function stmtAnchorTokIx(nodeIx: i32): i32 {
  const nm = declNameTokOf(nodeIx)
  if nm >= 0 && nm < P.toks.length { return nm }
  if nodeIx < 0 || nodeIx >= nodeToks.length { return -1 }
  const last = nodeToks[nodeIx]
  if last < 0 || last >= P.toks.length { return -1 }
  const at = nodePos(nodeIx)
  if at < 0 { return last }
  let t = last
  while t >= 0 {
    const s = P.toks[t].start
    if s == at { return t }
    if s < at { return last }
    t = t - 1
  }
  last
}

// ── the emitted module's byte offset → the function that owns it (D1578) ─────
// A module the engine refuses reports a byte offset into bytes the author never
// sees; `emitCodeSection`'s banked per-body byte ranges turn that into
// `file:line:col` plus the function's name. Lookup is a scan, deliberately.
export function emitFnSpanAt(off: i32): i32 {
  let i = 0
  while i < emitFnSpanStart.length {
    if off >= emitFnSpanStart[i] && off < emitFnSpanEnd[i] { return i }
    i = i + 1
  }
  -1
}

// What the body at row `i` is: 0 a user function, 1 a module-scope statement or
// global initializer in the synthetic start function, 2 an export wrapper, 3 a
// shared runtime helper, 4 the start function outside any statement, -1 for no row.
// A closed set decoded in two places — here and the host's `SpanWhere::what`.
export function emitFnSpanKindOf(i: i32): i32 {
  if i < 0 || i >= emitFnSpanKind.length { return -1 }
  emitFnSpanKind[i]
}
function emitFnSpanTokIx(i: i32): i32 {
  if i < 0 || i >= emitFnSpanNode.length { return -1 }
  // A module-scope statement anchors at its own node (D1594). The stamp test below
  // keeps a synthesized body positionless; a top-level statement is parsed, never
  // synthesized, so requiring a `declNameTok` would throw away its real position.
  if emitFnSpanKindOf(i) == 1 { return stmtAnchorTokIx(emitFnSpanNode[i]) }
  // The slot's pre-monomorphization original first: a mono instance, a lifted lambda
  // copy, and a pruned stub are all minted after parsing, so `addNode` anchors them
  // at the EOF token — a position that reads as real but points at the file's last
  // line. `monoOrigNode` holds the pristine declaration; only it carries `declNameTok`.
  const orig = monoOrigNodeOfSlot(emitFnSpanPos[i])
  if declNameTokOf(orig) >= 0 { return declAnchorTokIx(orig) }
  const nd = emitFnSpanNode[i]
  if declNameTokOf(nd) >= 0 { return declAnchorTokIx(nd) }
  -1
}
// The pristine pre-pass `FuncDecl` for `fnStmts` slot `fe`, or -1: the slot's own entry
// when the pass froze one, else the ORIGIN slot's when `fe` is an appended instance.
function monoOrigNodeOfSlot(fe: i32): i32 {
  if fe < 0 { return -1 }
  if fe < monoOrigNode.length { return monoOrigNode[fe] }
  let q = 0
  while q < monoInstFe.length {
    if monoInstFe[q] == fe {
      const of = monoInstOrig[q]
      if of >= 0 && of < monoOrigNode.length { return monoOrigNode[of] }
      return -1
    }
    q = q + 1
  }
  -1
}
export function emitFnSpanLine(i: i32): i32 {
  const t = emitFnSpanTokIx(i)
  if t >= 0 { return P.toks[t].line }
  0
}
export function emitFnSpanCol(i: i32): i32 {
  const t = emitFnSpanTokIx(i)
  if t >= 0 { return P.toks[t].col }
  0
}
export function emitFnSpanModule(i: i32): i32 {
  const t = emitFnSpanTokIx(i)
  if t >= 0 { return modOfTok(t) }
  0
}
// The name the name section gives this body — a lambda's binding display name where
// it has one, else the declared name — so the host's sentence and the engine's own
// `function[N]::<name>` cannot disagree.
export function emitFnSpanName(i: i32): string {
  if i < 0 || i >= emitFnSpanPos.length { return "" }
  // A body with no `FuncDecl` behind it carries its name directly (the shared
  // runtime helpers), spelled as the name section spells it.
  if i < emitFnSpanTag.length {
    if emitFnSpanTag[i].length > 0 { return emitFnSpanTag[i] }
  }
  const p = emitFnSpanPos[i]
  if p >= 0 && p < fnDispNames.length {
    if fnDispNames[p].length > 0 { return fnDispNames[p] }
  }
  // A SYNTHETIC body's row carries node -1, and `P.nodes[-1]` is a trap, not a miss.
  const nd = emitFnSpanNode[i]
  if nd < 0 || nd >= P.nodes.length { return "" }
  const fn = P.nodes[nd]
  if fn is FuncDecl { return fn.fnName }
  ""
}

// The clause a diagnostic puts after "the emitted module failed to validate", for
// the body at row `i` — "" when no row owns the offset. The host carries the same
// ladder in Rust (`SpanWhere::what`), since `vl build`/`vl run` never enter the CLI
// pump; the two channels move together, exactly as `engineFailOffset` and its Rust twin do.
export function emitFnSpanWhere(i: i32): string {
  const k = emitFnSpanKindOf(i)
  if k < 0 { return "" }
  if k == 1 || k == 4 { return " inside the module's top-level code" }
  if k == 2 {
    return " inside the export wrapper for `" + emitFnSpanName(i) + "`"
  }
  if k == 3 {
    return " inside the shared runtime helper `" + emitFnSpanName(i) + "`"
  }
  " inside `" + emitFnSpanName(i) + "`"
}
export function emitFnSpanNameLen(i: i32): i32 { emitFnSpanName(i).length }
export function emitFnSpanNameAt(i: i32, j: i32): i32 {
  const s = emitFnSpanName(i)
  if j >= 0 && j < s.length { return s[j] }
  0
}

// The byte offset an engine validation message names, or -1 when it names none.
// wasmtime spells it two ways, both parsed here — `(at offset 0x11b)` and `at offset
// 188` — with the last occurrence winning, since a `Caused by:` chain repeats the
// inner message under the outer one. The host carries the same parser in Rust.
export function engineFailOffset(msg: string): i32 {
  const key = "at offset "
  let at = -1
  let i = 0
  while i + key.length <= msg.length {
    let k = 0
    let same = true
    while k < key.length {
      if msg[i + k] != key[k] {
        same = false
        break
      }
      k = k + 1
    }
    if same { at = i + key.length }
    i = i + 1
  }
  if at < 0 { return -1 }
  let p = at
  let hex = false
  if p + 1 < msg.length {
    if msg[p] == '0' && msg[p + 1] == 'x' {
      hex = true
      p = p + 2
    }
  }
  let v = 0
  let n = 0
  while p < msg.length {
    const c = msg[p]
    let d = -1
    if c >= '0' && c <= '9' { d = c - '0' }
    else if hex && c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
    else if hex && c >= 'A' && c <= 'F' { d = c - 'A' + 10 }
    if d < 0 { break }
    if hex { v = v * 16 + d } else { v = v * 10 + d }
    n = n + 1
    p = p + 1
  }
  if n == 0 { return -1 }
  v
}
// The diagnostic's end column: the anchor token's start plus its lexeme length
// (lexemes never span lines, so `diagLine` is the end line). A parse diag anchors
// at a token, a type diag at a node resolved through `nodeToks`; a tokenless diag
// carries its own end in the `vcDg*` side table. Degrades to `diagCol` if unrecorded.
export function diagEndCol(i: i32): i32 {
  let at = -1
  if i < P.diags.length {
    const k = vcDgFind(i)
    if k >= 0 {
      if vcDgEnd[k] > vcDgCol[k] { return vcDgEnd[k] }
      return diagCol(i)
    }
    at = P.diags[i].at
  } else {
    const j = i - P.diags.length
    if j < T.diags.length {
      const nd = T.diags[j].tat
      if nd >= 0 && nd < nodeToks.length { at = nodeToks[nd] }
    } else {
      // The emit failure — anchored at its function's decl token (`emitErrAt`).
      at = emitErrTokIx()
    }
  }
  if at >= 0 && at < P.toks.length {
    return P.toks[at].col + tokFirstLineLen(P.toks[at].text)
  }
  diagCol(i)
}

// The lexeme's length up to its first line break — the width a `col + len` end
// column may honestly claim. `col + text.length` is correct only while a token
// cannot span lines, but a template literal can; an unclamped end column would
// land on a line the span never names. A no-op for every other, single-line, token.
function tokFirstLineLen(text: string) {
  let i = 0
  while i < text.length && text[i] != '\n' && text[i] != '\r' { i = i + 1 }
  i
}
// The diagnostic's stable category code, "" when it has none. A type diagnostic
// carries "unsupported-lowering" when the program is type-valid but uses a
// construct codegen cannot lower yet, so tooling can tell an emitter-capability
// rejection from a soundness verdict. Parse and emit diagnostics carry "".
function vcDiagCode(i: i32): string {
  if i < P.diags.length { return "" }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tcode }
  ""
}
export function diagCodeLen(i: i32): i32 { vcDiagCode(i).length }
export function diagCodeByte(i: i32, j: i32): i32 { vcDiagCode(i)[j] }

// The diagnostic's structured payload, "" when it has none — the second half of
// the coded-diagnostic ABI. The code names a bare category (`ufcs-not-imported`)
// and this carries what that category needs, netstring-encoded so no value's
// characters can bite the framing (`typecheck.diagDataField` documents it).
function vcDiagData(i: i32): string {
  if i < P.diags.length { return "" }
  const j = i - P.diags.length
  if j < T.diags.length { return T.diags[j].tdata }
  ""
}
export function diagDataLen(i: i32): i32 { vcDiagData(i).length }
export function diagDataByte(i: i32, j: i32): i32 { vcDiagData(i)[j] }

// ── native module resolution ───────────────────────────────────────────────────
// The module-table half of `docs/native-modules-design.md`. The host runs a fetch
// loop: commits the entry, asks `modPendingCount` which resolved keys are still
// needed, and repeats until the graph closes. An empty table behaves exactly as before.
export function modReset(): i32 {
  modKeys = []
  modSrcs = []
  modFound = []
  modKeyAcc = []
  modSrcAcc = []
  impMod = []
  impSpec = []
  impKey = []
  impName = []
  impLocal = []
  impNameLine = []
  impNameCol = []
  impSpecLine = []
  impSpecCol = []
  impSpecEnd = []
  impSpecChar = []
  expMod = []
  expName = []
  expDeclLine = []
  expDeclCol = []
  expKwLine = []
  expKwCol = []
  reExpMod = []
  reExpPublic = []
  reExpLocal = []
  reExpName = []
  reExpTarget = []
  modPending = []
  // Clears the token-load ranges too: a subsequent single-file check must not
  // inherit a prior graph's ranges, or `symOccModuleAt` would mis-attribute its
  // occurrences.
  modLoadStart = []
  modLoadMod = []
  0
}
export function modKeyPush(c: i32): i32 {
  modKeyAcc.push(c)
  0
}
export function modSrcPush(c: i32): i32 {
  modSrcAcc.push(c)
  0
}
// The `modKey`/`modSrc` twins of `srcLoad` — same protocol and staging window.
// `modSrcLoad` carries every module of a multi-file graph (the whole compiler
// during a self-compile); `modKeyLoad` carries only module keys. Both channels
// need the batched form, or the un-converted one keeps paying per code point silently.
export function modKeyLoad(count: i32): i32 {
  let i = 0
  while i < count {
    const cp = __load_i32__(i * 4)
    modKeyAcc.push(cp)
    i = i + 1
  }
  0
}
// The four loops are deliberately the same shape: a hand-optimized variant showed
// no measurable win, so uniformity wins on a tie.
export function modSrcLoad(count: i32): i32 {
  let i = 0
  while i < count {
    const cp = __load_i32__(i * 4)
    modSrcAcc.push(cp)
    i = i + 1
  }
  0
}
// Register the accumulated (key, source) pair. `found = 0` marks "the host could
// not read this key" so the unresolvable diagnostic fires instead of an infinite
// re-request. A found module is token-scanned immediately (imports + exports).
export function modCommit(found: i32): i32 {
  const key = fromCodePoints(modKeyAcc)
  const src = fromCodePoints(modSrcAcc)
  modKeyAcc = []
  modSrcAcc = []
  modCommitStr(key, src, found)
}
// The direct entry point, for a caller that already holds the strings —
// `cliModCommitOne`, VL calling VL with no host boundary. Stages the string
// directly rather than pushing it element by element into the accumulators, which
// would double-encode non-ASCII text; those remain only for the genuine host channel.
export function modCommitStr(key: string, src: string, found: i32): i32 {
  modKeys.push(key)
  modSrcs.push(src)
  modFound.push(found)
  if found != 0 { modScanCached(modKeys.length - 1, key, src) }
  modRecomputePending()
  0
}
// `modScan` through the per-instance cache: replay a recorded scan under table
// index `m` on a hit; on a miss, scan and record the entries the scan appended
// (modScan only ever appends, and only for `m`, so the [before, after) slice IS
// this module's scan result) together with the token range it banked.
function modScanCached(m: i32, key: string, src: string): i32 {
  const ci = modCacheLookup(key, src)
  if ci >= 0 {
    let ii = modCacheImpOff[ci]
    while ii < modCacheImpEnd[ci] {
      impMod.push(m)
      impSpec.push(modCacheImpSpec[ii])
      impKey.push(modCacheImpKey[ii])
      impName.push(modCacheImpName[ii])
      impLocal.push(modCacheImpLocal[ii])
      impNameLine.push(modCacheImpNameLine[ii])
      impNameCol.push(modCacheImpNameCol[ii])
      impSpecLine.push(modCacheImpSpecLine[ii])
      impSpecCol.push(modCacheImpSpecCol[ii])
      impSpecEnd.push(modCacheImpSpecEnd[ii])
      impSpecChar.push(modCacheImpSpecChar[ii])
      ii = ii + 1
    }
    let ri = modCacheReOff[ci]
    while ri < modCacheReEnd[ci] {
      reExpMod.push(m)
      reExpPublic.push(modCacheRePublic[ri])
      reExpLocal.push(modCacheReLocal[ri])
      ri = ri + 1
    }
    let ei = modCacheExpOff[ci]
    while ei < modCacheExpEnd[ci] {
      expMod.push(m)
      expName.push(modCacheExpName[ei])
      expDeclLine.push(modCacheExpDeclLine[ei])
      expDeclCol.push(modCacheExpDeclCol[ei])
      expKwLine.push(modCacheExpKwLine[ei])
      expKwCol.push(modCacheExpKwCol[ei])
      ei = ei + 1
    }
    return 0
  }
  const impBefore = impSpec.length
  const reBefore = reExpPublic.length
  const expBefore = expName.length
  modScan(m, src)
  modCacheKeys.push(key)
  modCacheSrcs.push(src)
  modCacheImpOff.push(modCacheImpSpec.length)
  let ci2 = impBefore
  while ci2 < impSpec.length {
    modCacheImpSpec.push(impSpec[ci2])
    modCacheImpKey.push(impKey[ci2])
    modCacheImpName.push(impName[ci2])
    modCacheImpLocal.push(impLocal[ci2])
    modCacheImpNameLine.push(impNameLine[ci2])
    modCacheImpNameCol.push(impNameCol[ci2])
    modCacheImpSpecLine.push(impSpecLine[ci2])
    modCacheImpSpecCol.push(impSpecCol[ci2])
    modCacheImpSpecEnd.push(impSpecEnd[ci2])
    modCacheImpSpecChar.push(impSpecChar[ci2])
    ci2 = ci2 + 1
  }
  modCacheImpEnd.push(modCacheImpSpec.length)
  modCacheReOff.push(modCacheRePublic.length)
  let cr = reBefore
  while cr < reExpPublic.length {
    modCacheRePublic.push(reExpPublic[cr])
    modCacheReLocal.push(reExpLocal[cr])
    cr = cr + 1
  }
  modCacheReEnd.push(modCacheRePublic.length)
  modCacheExpOff.push(modCacheExpName.length)
  let ce = expBefore
  while ce < expName.length {
    modCacheExpName.push(expName[ce])
    modCacheExpDeclLine.push(expDeclLine[ce])
    modCacheExpDeclCol.push(expDeclCol[ce])
    modCacheExpKwLine.push(expKwLine[ce])
    modCacheExpKwCol.push(expKwCol[ce])
    ce = ce + 1
  }
  modCacheExpEnd.push(modCacheExpName.length)
  modCacheTokOff.push(modScanTokOff)
  modCacheTokEnd.push(modScanTokEnd)
  0
}
// `vcLoadToks` for module `m` through the per-instance cache: on a hit, re-pushes
// the cached token stream with fresh `pos` anchors (only a clean tokenization is
// cached); on a miss, tokenizes and banks the stream if it produced no lex diags.
// The miss covers a module the scan skipped or one whose lex diags made it unbankable.
function vcLoadToksMod(m: i32): i32 {
  const ci = modCacheLookup(modKeys[m], modSrcs[m])
  if ci >= 0 && modCacheTokOff[ci] >= 0 {
    let ti = modCacheTokOff[ci]
    while ti < modCacheTokEnd[ci] {
      P.toks.push(
        {
          kind: modCacheTokKind[ti],
          text: modCacheTokText[ti],
          pos: P.toks.length,
          start: modCacheTokStart[ti],
          line: modCacheTokLine[ti],
          col: modCacheTokCol[ti],
        },
      )
      ti = ti + 1
    }
    return P.toks.length
  }
  const tokBefore = P.toks.length
  const diagBefore = P.diags.length
  vcLoadToks(modSrcs[m])
  if ci >= 0 && P.diags.length == diagBefore {
    modCacheTokOff[ci] = modCacheTokKind.length
    let ti2 = tokBefore
    while ti2 < P.toks.length {
      const t = P.toks[ti2]
      modCacheTokKind.push(t.kind)
      modCacheTokText.push(t.text)
      modCacheTokStart.push(t.start)
      modCacheTokLine.push(t.line)
      modCacheTokCol.push(t.col)
      ti2 = ti2 + 1
    }
    modCacheTokEnd[ci] = modCacheTokKind.length
  }
  P.toks.length
}
export function modPendingCount(): i32 { modPending.length }
export function modPendingLen(i: i32): i32 { modPending[i].length }
export function modPendingAt(i: i32, j: i32): i32 { modPending[i][j] }
// The whole key as a STRING. The per-element pair above is the HOST's ABI (its reader
// collects bytes); an in-module caller wants the string itself, and reassembling it from
// elements is the §Builders double-encode since Stage 2c made those elements bytes.
export function modPendingKeyAt(i: i32): string { modPending[i] }

// Cross-file symbols: the import/export surface the module scan already built
// (`imp*`/`exp*`), exposed as accessors. After committing the graph, the host reads
// each import specifier's local alias, exported name, and resolved key, and each
// module's exports with position. Disk crawl and dedup stay host-side.
export function impCount(): i32 { impMod.length }
export function impModAt(i: i32): i32 { impMod[i] }
export function impLocalLen(i: i32): i32 { impLocal[i].length }
export function impLocalCharAt(i: i32, j: i32): i32 { impLocal[i][j] }
export function impNameLen(i: i32): i32 { impName[i].length }
export function impNameCharAt(i: i32, j: i32): i32 { impName[i][j] }
export function impKeyLen(i: i32): i32 { impKey[i].length }
export function impKeyCharAt(i: i32, j: i32): i32 { impKey[i][j] }

export function expCount(): i32 { expMod.length }
export function expModAt(i: i32): i32 { expMod[i] }
export function expNameLen(i: i32): i32 { expName[i].length }
export function expNameCharAt(i: i32, j: i32): i32 { expName[i][j] }
export function expDeclLineAt(i: i32): i32 { expDeclLine[i] }
export function expDeclColAt(i: i32): i32 { expDeclCol[i] }
export function expKwLineAt(i: i32): i32 { expKwLine[i] }
export function expKwColAt(i: i32): i32 { expKwCol[i] }

// The committed modules' KEYS, by table index — lets the host map an import's
// resolved key to the module that owns a matching export (`impKey` ↔ `expMod`).
export function modKeyCount(): i32 { modKeys.length }
export function modKeyAtLen(m: i32): i32 { modKeys[m].length }
export function modKeyAtCharAt(m: i32, j: i32): i32 { modKeys[m][j] }

// The table index of the module that owns diagnostic `i` (via `modOfTok`), or 0
// (the entry) when the anchor is positionless. Mirrors `diagLine`/`diagEndCol`'s
// anchor resolution. Must be read before `lintSrc` re-parses the entry, which resets
// `P.toks`/`nodeToks`, after which the anchor would fail to map.
export function diagModule(i: i32): i32 {
  let at = -1
  if i < P.diags.length {
    // A tokenless diag (lex / module-resolution) records its owner directly.
    const k = vcDgFind(i)
    if k >= 0 { return vcDgMod[k] }
    at = P.diags[i].at
  } else {
    const j = i - P.diags.length
    if j < T.diags.length {
      const nd = T.diags[j].tat
      if nd >= 0 && nd < nodeToks.length { at = nodeToks[nd] }
    } else {
      // D1519 — the emit failure arm: `diagLine`/`diagCol`/`diagEndCol` all resolve it
      // through `emitErrTokIx`, so a refusal inside an imported module already prints
      // that module's own line and column. Without this arm the fallthrough names
      // module 0, misreporting an imported file's refusal against the entry's path.
      at = emitErrTokIx()
    }
  }
  if at >= 0 && at < P.toks.length { return modOfTok(at) }
  0
}

// ── specifier resolution (ports of the host's pure string math) ───────────────
function modIsRelative(spec: string): boolean {
  if spec.length >= 2 {
    if spec[0] == '.' && spec[1] == '/' { return true }
  }
  if spec.length >= 3 {
    if spec[0] == '.' && spec[1] == '.' && spec[2] == '/' { return true }
  }
  false
}
// A `std:` specifier: `std:` + a [a-z0-9_]+(/[a-z0-9_]+)* module name. The
// specifier IS the module key (returned verbatim by `modResolveSpecifier`);
// the HOST maps it to bytes ($VL_STD / the exe-relative std/ dir).
function modIsStdSpec(spec: string): boolean {
  if !modKeyIsStd(spec) { return false }
  let segLen = 0
  let i = 4
  while i < spec.length {
    const c = spec[i]
    if c == '/' {
      if segLen == 0 { return false }
      segLen = 0
    } else if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' {
      segLen = segLen + 1
    } else {
      return false
    }
    i = i + 1
  }
  segLen > 0
}
// A module key in the `std:` scheme (a verbatim std specifier).
function modKeyIsStd(key: string): boolean {
  if key.length < 4 { return false }
  key[0] == 's' && key[1] == 't' && key[2] == 'd' && key[3] == ':'
}
// The directory portion of a `/`-separated key (no trailing slash), "" if none.
function modDirOf(key: string): string {
  let slash = -1
  let i = 0
  while i < key.length {
    if key[i] == '/' { slash = i }
    i = i + 1
  }
  if slash < 0 { return "" }
  // An explicit `return` — a bare member-call TAIL expression routes through the
  // statement dispatch, an emit gap in the native pipeline.
  return key.slice(0, slash)
}
// Normalize a `/`-separated path, collapsing `.` and `..` segments. A leading
// `/` (absolute key) is preserved; leading `..` that escape the root are kept
// (the key stays distinct and the reader simply won't find it).
function modNormalize(path: string): string {
  let absolute = false
  if path.length > 0 {
    if path[0] == '/' { absolute = true }
  }
  let segs: string[] = []
  // STAGE 2c: segments come out as SLICES of `path`, not rebuilt through a code-point
  // buffer. `/` is ASCII so it is found at the same offsets in either unit, and a slice
  // names no unit at all — where `fromCodePoints(cur)` over `path[i]` bytes would have
  // re-encoded every non-ASCII character in a path.
  let segStart = 0
  let i = 0
  while i <= path.length {
    const atEnd = i == path.length
    let c = 0
    if !atEnd { c = path[i] }
    if atEnd || c == '/' {
      const seg = path.slice(segStart, i)
      segStart = i + 1
      if seg == "" || seg == "." {
        // skip
      } else if seg == ".." {
        if segs.length > 0 && segs[segs.length - 1] != ".." {
          // Drop the last segment (rebuild — a bare `.pop()` STATEMENT is an
          // emit gap in the native pipeline; this stays on the lowered path).
          const trimmed: string[] = []
          let ti = 0
          while ti < segs.length - 1 {
            trimmed.push(segs[ti])
            ti = ti + 1
          }
          segs = trimmed
        } else {
          segs.push("..")
        }
      } else {
        segs.push(seg)
      }
    }
    i = i + 1
  }
  let out = ""
  let s = 0
  while s < segs.length {
    if s > 0 { out = out + "/" }
    out = out + segs[s]
    s = s + 1
  }
  if absolute { return "/" + out }
  out
}
// Resolves `spec` written in the module at `fromKey` to a key, or "" for a kind
// the resolver rejects (bare, malformed `std:`, or relative-inside-std — a std
// module has no directory to resolve `./x` against). A well-formed `std:` specifier
// is its key verbatim; a relative spec gets `.vl` appended.
function modResolveSpecifier(spec: string, fromKey: string): string {
  if modIsStdSpec(spec) { return spec }
  if !modIsRelative(spec) { return "" }
  if modKeyIsStd(fromKey) { return "" }
  const base = modDirOf(fromKey)
  let joined = spec
  if base != "" { joined = base + "/" + spec }
  modNormalize(joined) + ".vl"
}

// ── token-level import/export scan (per committed module) ─────────────────────
// Tokenizes the committed source and walks top-level tokens (brace-depth tracked):
// each import records one entry per specifier, each exported declaration records a
// name. A clean tokenization is banked and `vcLoadToksMod` replays it instead.
function modScan(m: i32, src: string): i32 {
  const r = tokenize(src)
  const toks = r.tokens
  modScanTokOff = -1
  modScanTokEnd = -1
  if r.diags.length == 0 {
    modScanTokOff = modCacheTokKind.length
    let b = 0
    while b < toks.length {
      modCacheTokKind.push(toks[b].kind)
      modCacheTokText.push(toks[b].text)
      modCacheTokStart.push(toks[b].start)
      modCacheTokLine.push(toks[b].line)
      modCacheTokCol.push(toks[b].col)
      b = b + 1
    }
    modScanTokEnd = modCacheTokKind.length
  }
  let depth = 0
  let sawTplHole = false
  let i = 0
  while i < toks.length {
    const k = toks[i].kind
    if k == "TEMPLATE_HEAD" {
      // A template with at least one HOLE. Its desugared render call names a
      // `std:fmt` export, so this module needs `std:fmt` in the merged program —
      // recorded below as a bare edge, after the real imports are scanned.
      sawTplHole = true
      i = i + 1
    } else if k == "LBRACE" {
      depth = depth + 1
      i = i + 1
    } else if k == "RBRACE" {
      depth = depth - 1
      i = i + 1
    } else if k == "IMPORT" && depth == 0 {
      // One `import { a as b, … } from "spec"`, scanned inline (a named annotation
      // can't portably type a token param, since the lexer's token type is renamed
      // per assembly). Records one entry per specifier (`as` honored); a specifier-
      // less import records one entry with empty names. Ends past the path string.
      const kwLine = toks[i].line
      const kwCol = toks[i].col
      i = i + 1
      const names: string[] = []
      const locals: string[] = []
      const nameLines: i32[] = []
      const nameCols: i32[] = []
      if i < toks.length {
        if toks[i].kind == "LBRACE" {
          i = i + 1
          let going = true
          while going && i < toks.length {
            const ck = toks[i].kind
            if ck == "RBRACE" {
              i = i + 1
              going = false
            } else {
              if ck == "IDENT" {
                const nm = toks[i].text
                let loc = nm
                nameLines.push(toks[i].line)
                nameCols.push(toks[i].col)
                if i + 2 < toks.length {
                  if (
                    toks[i + 1].kind == "IDENT" &&
                    toks[i + 1].text == "as" &&
                    toks[i + 2].kind == "IDENT"
                  ) {
                    loc = toks[i + 2].text
                    i = i + 2
                  }
                }
                names.push(nm)
                locals.push(loc)
              }
              i = i + 1
            }
          }
        }
      }
      // Forwards to the path string (the `from` keyword rides as an ident), then
      // strips its surrounding quotes. Bounded exactly as `parseImport` bounds its
      // own walk (a newline, semi, or statement-start keyword ends it) — unbounded,
      // a mis-lexed single-quoted specifier would adopt the next string in the file.
      let spec = ""
      let specLine = kwLine
      let specCol = kwCol
      let specEnd = kwCol
      let specChar = 0
      let scanning = true
      while scanning && i < toks.length {
        const sk = toks[i].kind
        if sk == "STRING" {
          spec = toks[i].text
          specLine = toks[i].line
          specCol = toks[i].col
          specEnd = toks[i].col + toks[i].text.length
          if spec.length >= 2 {
            if spec[0] == '"' && spec[spec.length - 1] == '"' {
              spec = spec.slice(1, spec.length - 1)
            }
          }
          i = i + 1
          scanning = false
        } else if sk == "CHAR" {
          // A char literal in the specifier slot. Recorded, not skipped: it is not
          // a resolvable key, and the reader needs to be told THAT rather than
          // that the import has no specifier at all. `spec` carries the RAW
          // lexeme, which is what `importSpecCharMsg` re-quotes.
          spec = toks[i].text
          specLine = toks[i].line
          specCol = toks[i].col
          specEnd = toks[i].col + toks[i].text.length
          specChar = 1
          i = i + 1
          scanning = false
        } else if sk == "EOF" || sk == "NEWLINE" || sk == "SEMI" {
          scanning = false
        } else if isStmtKeyword(sk) {
          scanning = false
        } else {
          i = i + 1
        }
      }
      let key = ""
      if specChar == 0 { key = modResolveSpecifier(spec, modKeys[m]) }
      let n = 0
      while n < names.length {
        impMod.push(m)
        impSpec.push(spec)
        impKey.push(key)
        impName.push(names[n])
        impLocal.push(locals[n])
        impNameLine.push(nameLines[n])
        impNameCol.push(nameCols[n])
        impSpecLine.push(specLine)
        impSpecCol.push(specCol)
        impSpecEnd.push(specEnd)
        impSpecChar.push(specChar)
        n = n + 1
      }
      if names.length == 0 {
        impMod.push(m)
        impSpec.push(spec)
        impKey.push(key)
        impName.push("")
        impLocal.push("")
        impNameLine.push(kwLine)
        impNameCol.push(kwCol)
        impSpecLine.push(specLine)
        impSpecCol.push(specCol)
        impSpecEnd.push(specEnd)
        impSpecChar.push(specChar)
      }
    } else if k == "EXPORT" && depth == 0 {
      if i + 1 < toks.length && toks[i + 1].kind == "LBRACE" {
        // A RE-EXPORT `export { a, b as c } from "spec"`: scanned like an import's
        // name list, but each entry is ALSO recorded as a public re-export. The local
        // binding (`as` alias, else the name) is what the import created; the public
        // name is the same alias. Cursor advances past the trailing path STRING.
        const rkwLine = toks[i].line
        const rkwCol = toks[i].col
        i = i + 2 // past EXPORT and LBRACE
        const rnames: string[] = []
        const rlocals: string[] = []
        const rnameLines: i32[] = []
        const rnameCols: i32[] = []
        let rgoing = true
        while rgoing && i < toks.length {
          const ck = toks[i].kind
          if ck == "RBRACE" {
            i = i + 1
            rgoing = false
          } else {
            if ck == "IDENT" {
              const nm = toks[i].text
              let loc = nm
              rnameLines.push(toks[i].line)
              rnameCols.push(toks[i].col)
              if i + 2 < toks.length {
                if (
                  toks[i + 1].kind == "IDENT" &&
                  toks[i + 1].text == "as" &&
                  toks[i + 2].kind == "IDENT"
                ) {
                  loc = toks[i + 2].text
                  i = i + 2
                }
              }
              rnames.push(nm)
              rlocals.push(loc)
            }
            i = i + 1
          }
        }
        // BOUNDED and CHAR-aware for the same reasons the import arm above is —
        // `export { a } from 'dep'` stole the next string literal too.
        let rspec = ""
        let rspecLine = rkwLine
        let rspecCol = rkwCol
        let rspecEnd = rkwCol
        let rspecChar = 0
        let rscan = true
        while rscan && i < toks.length {
          const sk = toks[i].kind
          if sk == "STRING" {
            rspec = toks[i].text
            rspecLine = toks[i].line
            rspecCol = toks[i].col
            rspecEnd = toks[i].col + toks[i].text.length
            if rspec.length >= 2 {
              if rspec[0] == '"' && rspec[rspec.length - 1] == '"' {
                rspec = rspec.slice(1, rspec.length - 1)
              }
            }
            i = i + 1
            rscan = false
          } else if sk == "CHAR" {
            rspec = toks[i].text
            rspecLine = toks[i].line
            rspecCol = toks[i].col
            rspecEnd = toks[i].col + toks[i].text.length
            rspecChar = 1
            i = i + 1
            rscan = false
          } else if sk == "EOF" || sk == "NEWLINE" || sk == "SEMI" {
            rscan = false
          } else if isStmtKeyword(sk) {
            rscan = false
          } else {
            i = i + 1
          }
        }
        let rkey = ""
        if rspecChar == 0 { rkey = modResolveSpecifier(rspec, modKeys[m]) }
        let rn = 0
        while rn < rnames.length {
          // Pull the symbol (an import edge) so the merge binds it and the host fetches `spec`.
          impMod.push(m)
          impSpec.push(rspec)
          impKey.push(rkey)
          impName.push(rnames[rn])
          impLocal.push(rlocals[rn])
          impNameLine.push(rnameLines[rn])
          impNameCol.push(rnameCols[rn])
          impSpecLine.push(rspecLine)
          impSpecCol.push(rspecCol)
          impSpecEnd.push(rspecEnd)
          impSpecChar.push(rspecChar)
          // Record the PUBLIC re-export (its merged target is resolved in `modCompile`).
          reExpMod.push(m)
          reExpPublic.push(rlocals[rn])
          reExpLocal.push(rlocals[rn])
          rn = rn + 1
        }
      } else if i + 2 < toks.length {
        // `export flat type N = { … }` puts a contextual keyword between `export`
        // and the declaration keyword, so the declared name is one token further
        // along. This token-level scanner runs before any parse, so it must
        // recognize the `flat`/`type` pair itself, the same guard the parser uses.
        let dOff = 1
        if toks[i + 1].kind == "IDENT" && toks[i + 1].text == "flat" {
          if i + 3 < toks.length && toks[i + 2].kind == "TYPE" { dOff = 2 }
        }
        const dk = toks[i + dOff].kind
        if dk == "FUNCTION" || dk == "LET" || dk == "CONST" || dk == "TYPE" {
          expMod.push(m)
          expName.push(toks[i + dOff + 1].text)
          expDeclLine.push(toks[i + dOff + 1].line)
          expDeclCol.push(toks[i + dOff + 1].col)
          // The `export` keyword's own span — the target for the "redundant export
          // keyword" hint (an export used locally but imported nowhere).
          expKwLine.push(toks[i].line)
          expKwCol.push(toks[i].col)
        }
        i = i + 1
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  // ── the injected import ────────────────────────────────────────────────────
  // A module holding a template hole gets a `std:fmt` dependency it never wrote,
  // the same row shape a bare import pushes but with `impName`/`impLocal` both
  // empty — the no-pollution mechanism. Every `imp*` column is still pushed.
  if sawTplHole && modKeys[m] != TPL_RENDER_MODULE {
    impMod.push(m)
    impSpec.push(TPL_RENDER_MODULE)
    impKey.push(TPL_RENDER_MODULE)
    impName.push("")
    impLocal.push("")
    impNameLine.push(1)
    impNameCol.push(0)
    impSpecLine.push(1)
    impSpecCol.push(0)
    impSpecEnd.push(0)
    impSpecChar.push(0)
  }
  0
}
// ── where a template hole's renderer comes from ───────────────────────────────
// A template binds absolutely: `` `n=${x}` `` means the same thing in every file
// regardless of what it imports, so the renderer is named here and never looked
// up in the user's scope (a string literal's meaning must not depend on imports).
const TPL_RENDER_MODULE = "std:fmt"
const TPL_RENDER_EXPORT = "toString"

function modIndexOfKey(key: string): i32 {
  let i = 0
  while i < modKeys.length {
    if modKeys[i] == key { return i }
    i = i + 1
  }
  -1
}
function modRecomputePending(): i32 {
  modPending = []
  let i = 0
  while i < impKey.length {
    const k = impKey[i]
    if k != "" && modIndexOfKey(k) < 0 {
      if !capHas(modPending, k) { modPending.push(k) }
    }
    i = i + 1
  }
  0
}

// ── module pipeline (order/validate → parse-merge → rename/rewrite) ───────────
// DFS state lives at the top of this file: 0 unvisited, 1 loading (a back-edge
// is a cycle), 2 done. Records one module-resolution diagnostic, deduped on
// (module, message): the same missing module imported by two files is two findings.
let modDiagLine: i32[] = []
let modDiagCol: i32[] = []
let modDiagEnd: i32[] = []
let modDiagMod: i32[] = []
function modDiag(m: i32, line: i32, col: i32, msg: string): i32 {
  modDiagSpan(m, line, col, col, msg)
}
// `modDiag` with a SPAN — `[col, endCol)` on `line`, for a report whose subject is
// a whole lexeme the reader has to see (the specifier token). These diagnostics
// are tokenless, so the span cannot be derived downstream; `endCol == col` is the
// point rendering every other module report keeps.
function modDiagSpan(
  m: i32,
  line: i32,
  col: i32,
  endCol: i32,
  msg: string,
): i32 {
  let i = 0
  while i < modDiags.length {
    if modDiagMod[i] == m && modDiags[i] == msg { return 0 }
    i = i + 1
  }
  modDiags.push(msg)
  modDiagLine.push(line)
  modDiagCol.push(col)
  modDiagEnd.push(endCol)
  modDiagMod.push(m)
  0
}
// Whether `name` is part of module `m`'s public surface — the union of two tables:
// `expName` for a plain `export` declaration, `reExpPublic` for a re-export. Kept
// separate rather than merged, since `expName` also means "declared with the
// keyword here" for go-to-definition. Visibility is the union, provenance is not.
function modExportsHas(m: i32, name: string): boolean {
  let i = 0
  while i < expMod.length {
    if expMod[i] == m && expName[i] == name { return true }
    i = i + 1
  }
  // A re-export publishes its PUBLIC name (`reExpPublic` — the `as` alias, else the
  // source name), so `export { a as b } from "dep"` surfaces `b` and NOT `a`.
  let r = 0
  while r < reExpMod.length {
    if reExpMod[r] == m && reExpPublic[r] == name { return true }
    r = r + 1
  }
  false
}
// The merged (mangled) name of the declaration that module `m`'s public `name`
// ultimately denotes. When `m` re-exports rather than declares it, follows the
// chain to the declaring module, so `A declares, B re-exports from A, C from B`
// resolves to A's mangled name rather than an undefined `name$mC`. Bounded by MOD_DEPTH_MAX.
function modMergedTargetOf(m: i32, name: string): string {
  let cm = m
  let cn = name
  let hops = 0
  while hops < MOD_DEPTH_MAX {
    let nextMod = -1
    let nextName = ""
    let r = 0
    while r < reExpMod.length && nextMod < 0 {
      if reExpMod[r] == cm && reExpPublic[r] == cn {
        let ii = 0
        while ii < impMod.length && nextMod < 0 {
          if (
            impMod[ii] == cm &&
            impLocal[ii] == reExpLocal[r] &&
            impName[ii] != ""
          ) {
            const dd = modIndexOfKey(impKey[ii])
            if dd >= 0 {
              nextMod = dd
              nextName = impName[ii]
            }
          }
          ii = ii + 1
        }
      }
      r = r + 1
    }
    if nextMod < 0 { return cn + "$m" + i32ToStr(cm) }
    cm = nextMod
    cn = nextName
    hops = hops + 1
  }
  cn + "$m" + i32ToStr(cm)
}
// D1120 — a duplicate import is ambiguous only when the two bindings resolve to
// different declarations. Tested on the resolved merged target (`modMergedTargetOf`),
// not the specifier text, so the same name imported twice from one module is
// redundant, not ambiguous. Anchored at the second occurrence, naming both specifiers.
function modDiagDupImport(m: i32, i: i32, d: i32, spec: string): i32 {
  const local = impLocal[i]
  if local == "" { return 0 }
  const here = modMergedTargetOf(d, impName[i])
  let j = 0
  while j < i {
    if impMod[j] == m && impLocal[j] == local && impName[j] != "" {
      const dj = modIndexOfKey(impKey[j])
      if dj >= 0 {
        if modMergedTargetOf(dj, impName[j]) != here {
          modDiag(
            m,
            impNameLine[i],
            impNameCol[i],
            "Duplicate binding \"" +
              local +
              "\": module `" +
              modKeys[m] +
              "` imports it from both \"" +
              impSpec[j] +
              "\" and \"" +
              spec +
              "\" — rename one (`as` on the import)",
          )
          return 0
        }
      }
    }
    j = j + 1
  }
  0
}
// Visits module `m`: resolves and validates its imports (unsupported specifier,
// unresolvable key, cycle back-edge, name-not-exported), recursing into deps first.
// The DFS recurses once per import-chain link, so an adversarially deep chain is
// capped with a real diagnostic instead of overflowing the wasm call stack.
const MOD_DEPTH_MAX = 256
function modVisit(m: i32, depth: i32): i32 {
  modState[m] = 1
  let i = 0
  while i < impMod.length {
    if impMod[i] == m {
      const spec = impSpec[i]
      const key = impKey[i]
      if key == "" {
        // Texts mirror the host's `loadProgram` — keep them aligned. Spec-shaped
        // problems anchor at the specifier STRING token of THIS import.
        if impSpecChar[i] == 1 {
          // A CHAR literal where the specifier belongs — the parser's sentence,
          // shared (`importSpecCharMsg`), because the two scanners must agree.
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            importSpecCharMsg(spec),
          )
        } else if modKeyIsStd(modKeys[m]) && modIsRelative(spec) {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Unsupported import specifier \"" +
              spec +
              "\" — std modules import only via `std:` specifiers (relative imports inside std are not allowed)",
          )
        } else {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Unsupported import specifier \"" +
              spec +
              "\" — supported: relative paths (`./`, `../`) and `std:` modules; bare specifiers are not yet implemented",
          )
        }
      } else {
        const d = modIndexOfKey(key)
        if d < 0 {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Cannot resolve import \"" + spec + "\" (no module `" + key + "`)",
          )
        } else if modFound[d] == 0 {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Cannot resolve import \"" + spec + "\" (no module `" + key + "`)",
          )
        } else if modState[d] == 1 {
          modDiagSpan(
            m,
            impSpecLine[i],
            impSpecCol[i],
            impSpecEnd[i],
            "Import cycle detected through \"" +
              spec +
              "\" (module `" +
              key +
              "`)",
          )
        } else {
          if modState[d] == 0 {
            if depth >= MOD_DEPTH_MAX {
              modDiagSpan(
                m,
                impSpecLine[i],
                impSpecCol[i],
                impSpecEnd[i],
                "Import chain exceeds the maximum depth (" +
                  i32ToStr(MOD_DEPTH_MAX) +
                  ") at \"" +
                  spec +
                  "\" (module `" +
                  key +
                  "`)",
              )
            } else {
              modVisit(d, depth + 1)
            }
          }
          if impName[i] != "" {
            if !modExportsHas(d, impName[i]) {
              // A name-shaped problem anchors at the imported NAME token.
              modDiag(
                m,
                impNameLine[i],
                impNameCol[i],
                "\"" + impName[i] + "\" is not exported by \"" + spec + "\"",
              )
            } else {
              modDiagDupImport(m, i, d, spec)
            }
          }
        }
      }
    }
    i = i + 1
  }
  modState[m] = 2
  modOrder.push(m)
  0
}
// The whole module pipeline behind `compileSrc` (emit = 1) / `checkSrc` (0).
function modCompile(emit: i32): i32 {
  // 1. Order + validate (DFS from the entry, table index 0).
  modState = []
  modOrder = []
  modDiags = []
  modDiagLine = []
  modDiagCol = []
  modDiagEnd = []
  modDiagMod = []
  let s = 0
  while s < modKeys.length {
    modState.push(0)
    s = s + 1
  }
  modVisit(0, 0)
  if modDiags.length > 0 {
    // Tokenless (no tokens are loaded yet): position, span + owner ride the
    // `vcDg*` side table, keyed on each entry's `P.diags` index.
    let d = 0
    while d < modDiags.length {
      vcDgPush(
        P.diags.length,
        modDiagLine[d],
        modDiagCol[d],
        modDiagEnd[d],
        modDiagMod[d],
      )
      P.diags.push({ msg: modDiags[d], at: -1 })
      d = d + 1
    }
    return 1
  }
  // 2. Parse each module dependency-first into the SHARED arena. Tokens append
  // to `P.toks` (anchors stay per-module-correct via the global `pos`); each
  // `parseProgram` starts at its own module's first token.
  const roots: i32[] = []
  modLoadStart = []
  modLoadMod = []
  // Sibling modules are independent: parses every module and aggregates their
  // diagnostics rather than aborting at the first failure, so one run reports
  // every file's syntax errors. `vcLoadMod` attributes a lex diag to the module
  // being loaded; parse diags resolve their owner through `modOfTok`.
  let o = 0
  while o < modOrder.length {
    const m = modOrder[o]
    P.pos = P.toks.length
    // Record where this module's tokens begin so an occurrence's token maps back
    // to its module (`modOfTok`) for cross-file find-references.
    modLoadStart.push(P.toks.length)
    modLoadMod.push(m)
    vcLoadMod = m
    vcLoadToksMod(m)
    roots.push(parseProgram())
    o = o + 1
  }
  vcLoadMod = 0
  // The same stage-1 rule the single-source paths use, so a file does not lose
  // type feedback merely by gaining an `import` (see `vcParseBlocked`). The
  // quantifier spans the WHOLE graph — one lossy diagnostic in any module stops
  // the merge for all of them, which is what the shared arena requires anyway.
  if vcParseBlocked() { return 1 }
  // 2b. Duplicate-binding check: a top-level declaration whose name collides
  // with an import local would be silently ORPHANED by the merge rename (the
  // import mapping wins, so every reference rewrites to the IMPORT's target) —
  // diagnose the collision instead of misbinding.
  let dc = 0
  while dc < modOrder.length {
    modCheckDupBindings(modOrder[dc], roots[dc])
    // D1585 — the same pre-rename window, and the only one: after `modBuildRename` the
    // declared name is `f64$mN` and the reserved-name rule has nothing left to recognise.
    modCheckBuiltinTyDecls(roots[dc])
    dc = dc + 1
  }
  // A duplicate binding is never lossless-flagged, so this stays a hard stop —
  // the merge rename below would misbind on it, which is not a diagnostic the
  // checker could improve on.
  if vcParseBlocked() { return 1 }
  // 3 + 4. Per-module rename map + scope-aware arena rewrite. First register
  // every top-level `self`-function under its mangled name (across ALL modules)
  // so a UFCS member-call can resolve its (possibly mangled) callee through the
  // merge; the rewrite records the plain→mangled aliases it discovers.
  ufcsAliasReset()
  ufcsImpReset()
  // D1571's set spans every module of ONE program, so it is cleared with the other
  // program-scoped merge state and refilled by the collect pass below.
  modBuiltinTyTargets = []
  modCollectSelfFns(roots)
  let o2 = 0
  while o2 < modOrder.length {
    modBuildRename(modOrder[o2], roots[o2])
    // D1191 — the module's own UFCS SCOPE, and its arena boundary. Both are read
    // where a UFCS name is resolved away from a banked call site, so a candidate
    // is one the CALLER binds rather than one any module happened to bank.
    modBankUfcsScope(modOrder[o2])
    ufcsModBoundAdd(modOrder[o2], roots[o2])
    modShadow = []
    modTyShadow = []
    modRwStmt(roots[o2])
    o2 = o2 + 1
  }
  // 4b. Resolves each of the root module's re-exports to its merged target, aliasing
  // the bare `name` onto it in the export section. Only module 0's rows: a
  // dependency's re-export is that dependency's own surface, and aliasing every
  // module's row would leak a bare dependency name into the entry's wasm ABI.
  reExpName = []
  reExpTarget = []
  let re = 0
  while re < reExpMod.length {
    const rm = reExpMod[re]
    const rloc = reExpLocal[re]
    let ii2 = 0
    // A dependency's re-export (`rm != 0`) publishes to its importers, not to the ABI:
    // start the scan already `done` so its row contributes no alias.
    let done = true
    if rm == 0 { done = false }
    while ii2 < impMod.length && !done {
      if impMod[ii2] == rm && impLocal[ii2] == rloc && impName[ii2] != "" {
        const dd = modIndexOfKey(impKey[ii2])
        if dd >= 0 {
          reExpName.push(reExpPublic[re])
          // NOT `impName[ii2]$mdd`: `dd` may itself only RE-EXPORT the name, in
          // which case that target names nothing. Chase to the declaring module.
          reExpTarget.push(modMergedTargetOf(dd, impName[ii2]))
        }
        done = true
      }
      ii2 = ii2 + 1
    }
    re = re + 1
  }
  // 4c. The root module's plain `export`-marked declarations surface under their
  // bare names too, appended to the same alias tables, exactly like a re-export.
  // The emitter exports only these alias tables, so an internal function (a lifted
  // lambda, a mono instance) never leaks into the wasm ABI.
  let rex = 0
  while rex < expMod.length {
    if expMod[rex] == 0 && !capHas(reExpName, expName[rex]) {
      reExpName.push(expName[rex])
      reExpTarget.push(expName[rex] + "$m0")
    }
    rex = rex + 1
  }
  // 5. Merge: ONE Program concatenating the modules' statements dependency-first
  // (deps' top-level initializers run before their dependents', as in the host).
  const allStmts: i32[] = []
  let o3 = 0
  while o3 < modOrder.length {
    const r = P.nodes[roots[o3]]
    if r is Program {
      const ss = r.progStmts
      let q = 0
      while q < ss.length {
        allStmts.push(ss[q])
        q = q + 1
      }
    }
    o3 = o3 + 1
  }
  const merged = mkProgram(allStmts, -1) // synthesized merged-module root (no source token)
  csPreMintLocs()
  checkProgram(merged)
  // A lossless-recovered graph CHECKS but never BUILDS — same rule as
  // `compileSrc`, and the rc stays 1 so `vl build` behaves exactly as before.
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  // The deep-`is` second pass, on the merged program: the generated walkers name
  // their types through `tyToStr`, which renders the mangled declarations
  // (`Json$m1`) after the merge — so the fragment, parsed after the rename pass,
  // resolves its identifiers verbatim in the scope rendering put them in.
  const jwRc = jwSecondPass(merged)
  if jwRc != 0 { return jwRc }
  if P.diags.length > 0 { return 1 }
  if T.diags.length > 0 { return 2 }
  if emit != 0 {
    const rc = emitProgram(merged)
    if rc < 0 { return 3 }
  }
  0
}

// ── per-module rename map (state at the top of this file) ─────────────────────
// `sid(name)` → row → `modRenameTo[row]`: every top-level name maps to `name$mN`;
// an imported local maps to the exporting module's mangled name. A generic type
// (`Box<T>`) renames by its base segment, so every application rewrites consistently.
function modDeclBase(ix: i32, name: string): string {
  const b = declGpBaseOf(ix)
  if b != "" { return b }
  name
}
// Carries the merge's rename into the bank immediately after it lands in the
// declared name, so `modTypeRenamed` gives the bare base exactly the head segment
// it gave the folded name — the two cannot drift. A stale base here would register
// the alias under `Box` while every application spells `Box$m1`.
function modRwDeclBase(ix: i32): i32 {
  const b = declGpBaseOf(ix)
  if b != "" { setDeclGpBase(ix, modTypeRenamed(b)) }
  0
}
// Diagnoses every top-level declaration of module `m` whose name collides with one
// of its import locals. Without this, the merge rename skips the declaration (the
// import mapping claims the name) and every reference silently rewrites to the
// import's target instead. Anchored at the declaration's own name token.
function modCheckDupBindings(m: i32, root: i32): i32 {
  const impLocals: string[] = []
  let ii = 0
  while ii < impMod.length {
    if impMod[ii] == m && impLocal[ii] != "" { impLocals.push(impLocal[ii]) }
    ii = ii + 1
  }
  const r = P.nodes[root]
  if r is Program {
    const ss = r.progStmts
    let si = 0
    while si < ss.length {
      const st = P.nodes[ss[si]]
      let nm = ""
      if st is FuncDecl { nm = st.fnName }
      if st is LetDecl { nm = st.letName }
      if st is TypeDecl { nm = st.tdName }
      if st is UnionDecl { nm = st.udName }
      if nm != "" {
        const base = modDeclBase(ss[si], nm)
        if capHas(impLocals, base) {
          P.diags.push(
            {
              msg: "Duplicate binding \"" +
                base +
                "\": module `" +
                modKeys[m] +
                "` both imports and declares it — rename one (`as` on the import)",
              at: declNameTokOf(ss[si]),
            },
          )
        }
      }
      si = si + 1
    }
  }
  0
}
// D1585 — a `type` declaration may not take a builtin type name, in a module either.
// `checkProgram`'s pass-0 screen runs after the merge rename, by which point
// `tdName` reads `f64$mN` and names no builtin — so this runs before the rename,
// per module, raising through the checker's own `tErrBuiltinTyDecl` channel.
function modCheckBuiltinTyDecls(root: i32): i32 {
  const r = P.nodes[root]
  if r is Program {
    const ss = r.progStmts
    let si = 0
    while si < ss.length {
      const st = P.nodes[ss[si]]
      let nm = ""
      if st is TypeDecl { nm = st.tdName }
      if st is UnionDecl { nm = st.udName }
      if nm != "" {
        if isBuiltinTyName(nm) { tErrBuiltinTyDecl(nm, ss[si]) }
      }
      si = si + 1
    }
  }
  0
}
// The type-position rename of one identifier segment — the last matching row's
// target, or the segment unchanged. D1571's gate lives here rather than in either
// reader, since the spelling tree and the character scanner are two spellings of
// one question, and a guard in only one is the same defect on the other route.
function modTyRenamedSeg(seg: string) {
  const row = sidArrGet(modRenameLastBySid, sidLookup(seg))
  if row < 0 { return seg }
  // A builtin type name is renamed only by a `type` row. Every other segment keeps
  // the last-row rule byte for byte, since a user name that is both a type and a
  // value mints one target for both.
  if isBuiltinTyName(seg) {
    if !capHas(modBuiltinTyTargets, modRenameTo[row]) { return seg }
  }
  modRenameTo[row]
}
// Appends one row to the rename map and indexes it under its interned `from`. The
// two sid views are fresh arrays per module, so a row index is only ever read
// against the map that produced it — no cross-program row can survive a `sidReset`,
// the hazard `symbols.sidKeyedTablesReset` describes for un-rebuilt tables.
function modRenamePush(from: string, to: string): i32 {
  const row = modRenameTo.length
  modRenameTo.push(to)
  modRenameFrom.push(from)
  const s = sidOf(from)
  if sidArrGet(modRenameFirstBySid, s) < 0 {
    sidArrPut(modRenameFirstBySid, s, row)
  }
  sidArrPut(modRenameLastBySid, s, row)
  0
}
function modBuildRename(m: i32, root: i32): i32 {
  modRenameTo = []
  modRenameFrom = []
  modRenameFirstBySid = []
  modRenameLastBySid = []
  const impLocals: string[] = []
  let ii = 0
  while ii < impMod.length {
    if impMod[ii] == m && impLocal[ii] != "" { impLocals.push(impLocal[ii]) }
    ii = ii + 1
  }
  const suffix = "$m" + i32ToStr(m)
  const r = P.nodes[root]
  if r is Program {
    const ss = r.progStmts
    let si = 0
    while si < ss.length {
      const st = P.nodes[ss[si]]
      let nm = ""
      if st is FuncDecl { nm = st.fnName }
      if st is LetDecl { nm = st.letName }
      if st is TypeDecl { nm = st.tdName }
      if st is UnionDecl { nm = st.udName }
      if nm != "" {
        const base = modDeclBase(ss[si], nm)
        if !capHas(impLocals, base) {
          modRenamePush(base, base + suffix)
          // D1571 — a `type` declaration that took a BUILTIN name is the one row that may
          // rewrite that name in type position. Registered on the TARGET, so an IMPORT of it
          // needs no kind of its own: the import row renames onto this same `base$mN`.
          if isBuiltinTyName(base) {
            let isTyDecl = false
            if st is TypeDecl { isTyDecl = true }
            if st is UnionDecl { isTyDecl = true }
            if isTyDecl {
              if !capHas(modBuiltinTyTargets, base + suffix) {
                modBuiltinTyTargets.push(base + suffix)
              }
            }
          }
        }
      }
      si = si + 1
    }
  }
  let ij = 0
  while ij < impMod.length {
    if impMod[ij] == m && impLocal[ij] != "" {
      const dd = modIndexOfKey(impKey[ij])
      // The dep may only RE-EXPORT this name rather than declare it, so the
      // target is the chased declaration, not the flat `impName[ij]$mdd` (which
      // would rewrite every reference onto a name the merge never defines).
      if dd >= 0 {
        modRenamePush(impLocal[ij], modMergedTargetOf(dd, impName[ij]))
      }
    }
    ij = ij + 1
  }
  // The template renderer's row — the far half of the injected import. An ordinary
  // rename row, taking the identical path an author's own import would; what makes
  // it non-pollution is only its `from` key, which no program can spell. Minted for
  // every module whenever `std:fmt` is in the table, even if the author imported it too.
  const fm = modIndexOfKey(TPL_RENDER_MODULE)
  if fm >= 0 {
    modRenamePush(TPL_RENDER_LOCAL, modMergedTargetOf(fm, TPL_RENDER_EXPORT))
  }
  0
}
// Records every top-level free `self`-function of each module under its mangled
// name, so a cross-module UFCS member-call can resolve its callee through the
// merge. Runs with each module's rename map live, so `shout` registers as
// `shout$mN`, the name the rewritten `memProp` and merged `FuncDecl` will carry.
function modCollectSelfFns(roots: i32[]): i32 {
  modSelfFnName = []
  modSelfFnArity = []
  modSelfFnMinArity = []
  let o = 0
  while o < roots.length {
    const m = modOrder[o]
    modBuildRename(m, roots[o])
    modShadow = []
    const r = P.nodes[roots[o]]
    if r is Program {
      const ss = r.progStmts
      let si = 0
      while si < ss.length {
        const st = P.nodes[ss[si]]
        if st is FuncDecl {
          if st.fnParams.length > 0 {
            const p0 = P.nodes[st.fnParams[0]]
            if p0 is Param {
              if p0.parName == "self" {
                // `modDeclBase` strips a generic parameter list; the base segment is
                // what the rename map keys on. A `FuncDecl` never folds one
                // (`fnTyParams` is out-of-name), so this is the identity here, kept
                // because the rename map is built through the same call.
                const sfBase = modDeclBase(ss[si], st.fnName)
                const sfMangled = modRenamed(sfBase)
                modSelfFnName.push(sfMangled)
                modSelfFnArity.push(st.fnParams.length)
                modSelfFnMinArity.push(fnRequiredArity(st.fnParams))
                // D1230's registry, filled from the one walk that already has
                // both halves: the module index and its rename map.
                modNoteUfcsImportCand(m, sfBase, sfMangled)
              }
            }
          }
        }
        si = si + 1
      }
    }
    o = o + 1
  }
  0
}
// D1230 — one row of the registry: module `m` exports a free `self`-function
// spelled `base`, merged as `mangled`, nameable from the entry by some specifier.
// Recorded so the checker can turn a field-not-found error into a missing-import
// suggestion. Three gates skip a wrong one; it does not gate on the receiver type.
function modNoteUfcsImportCand(m: i32, base: string, mangled: string): i32 {
  if m == 0 { return 0 }
  let ex = 0
  let exported = false
  while ex < expMod.length {
    if expMod[ex] == m && expName[ex] == base { exported = true }
    ex = ex + 1
  }
  if !exported { return 0 }
  const spec = modUfcsSpecFromEntry(m)
  if spec == "" { return 0 }
  ufcsImpAdd(base, mangled, spec)
  0
}
// The specifier the entry file can write to name module `m`, or "" when none is
// known-correct: either the entry already imports `m` (its specifier text is right
// by construction), or `m`'s key is an absolute `std:` specifier. A relative module
// the entry does not import falls through to "" rather than risk a wrong computed path.
function modUfcsSpecFromEntry(m: i32): string {
  const key = modKeys[m]
  let i = 0
  while i < impMod.length {
    if impMod[i] == 0 && impKey[i] == key && impSpec[i] != "" {
      return impSpec[i]
    }
    i = i + 1
  }
  if modIsStdSpec(key) { return key }
  ""
}
// The mangled name of a UFCS `self`-function reachable as `.prop(args)`, matched
// against the registry with arity = explicit args + 1 (the receiver fills `self`).
// D1044 — the arity is a range, not a count: a defaulted parameter is reachable
// both with and without it, matching what `ufcsCallTy`/`drwSelfFnOf` already accept.
function modSelfFnTarget(prop: string, argc: i32): string {
  const cand = modRenamed(prop)
  let i = 0
  while i < modSelfFnName.length {
    if modSelfFnName[i] == cand {
      if argc + 1 >= modSelfFnMinArity[i] && argc + 1 <= modSelfFnArity[i] {
        return cand
      }
    }
    i = i + 1
  }
  ""
}
// Is `name` a merged top-level `self`-function? The arity-free half of
// `modSelfFnTarget`, asked of a rename TARGET rather than of a call.
function modSelfFnDeclared(name: string): boolean {
  let i = 0
  while i < modSelfFnName.length {
    if modSelfFnName[i] == name { return true }
    i = i + 1
  }
  false
}
// D1191 — module `m`'s UFCS scope, from the rename map already live for it: rows
// whose target is a `self`-function are exactly the plain names `m` may dispatch
// `x.name(…)` against. No arity filter — the reader that needs one compares whole
// function types, and a wrong arity is its refusal to make, not this table's.
function modBankUfcsScope(m: i32): i32 {
  let i = 0
  while i < modRenameFrom.length {
    if modSelfFnDeclared(modRenameTo[i]) {
      ufcsScopeAdd(m, modRenameFrom[i], modRenameTo[i])
    }
    i = i + 1
  }
  0
}
// A value reference: shadowed locals win, then the rename map, else unchanged. The
// map is consulted first even though the shadow wins, since a name absent from the
// map renames to itself either way — and it is the cheap order, since most calls on
// a self-compile are locals with no map row, paying one `sidLookup` instead of a walk.
function modRenamed(name: string): string {
  const row = sidArrGet(modRenameFirstBySid, sidLookup(name))
  if row < 0 { return name }
  if capHas(modShadow, name) { return name }
  modRenameTo[row]
}
// A type-position name: annotations are synthetic strings ("A|B", "Point[]"), so
// rewrites identifier segments through the rename map; quoted segments are copied
// verbatim. D1045 — a block-local type needs no shadow entry, since the parser
// already mints it under a unique name (`P` → `P$b7`); the merge must visit it once.
function modTypeRenamed(tn: string): string {
  const out: i32[] = []
  // STAGE 2c: identifier runs and quoted literal members are SLICED out of `tn` rather
  // than rebuilt from elements. An identifier run is ASCII by `nameIdentChar`'s own test,
  // but a QUOTED member is not — a literal-union arm can be spelled `"é"` — and that arm
  // copied `tn[i]` into the same code-point buffer.
  let runStart = 0
  let i = 0
  while i <= tn.length {
    const atEnd = i == tn.length
    let c = 0
    if !atEnd { c = tn[i] }
    let isIdent = false
    if !atEnd { isIdent = nameIdentChar(c) }
    if isIdent {
      if runStart < 0 { runStart = i }
    } else {
      if runStart >= 0 && i > runStart {
        const seg = tn.slice(runStart, i)
        runStart = 0 - 1
        let rep = seg
        // A live generic type-parameter name is the PARAMETER here, never the
        // top-level binding it may textually collide with.
        if !capHas(modTyShadow, seg) { rep = modTyRenamedSeg(seg) }
        pushCps(out, rep)
      }
      runStart = 0 - 1
      if !atEnd {
        if c == '"' {
          // Copy a quoted literal member verbatim. `skipQuotedName` owns where one ends —
          // it lands just past the closing quote, or at `tn.length` for an unterminated
          // segment, so the span is total. The trailing decrement hands the outer `i + 1`
          // the character AFTER the member.
          const qEnd = skipQuotedName(tn, i)
          pushCps(out, tn.slice(i, qEnd))
          i = qEnd - 1
        } else {
          out.push(c)
        }
      }
    }
    i = i + 1
  }
  fromCodePoints(out)
}

// ── scope-aware arena rewrite ────────────────────────────────────────────────
// Rewrites name references, call targets, and declaration names — plus type-
// annotation references for the native checker. A name shadowed by a param, loop
// var or block-local binding is left alone for that scope's extent (`modShadow`).
function modRwTsName(root: i32): i32 {
  if root < 0 { return 0 }
  const k = tsKind[root]
  if k == TS_NAME || k == TS_APP || k == TS_MAP {
    const seg = tsText[root]
    if seg.length > 0 && !capHas(modTyShadow, seg) {
      tsText[root] = modTyRenamedSeg(seg)
    }
  }
  const start = tsKidStart[root]
  const cnt = tsKidCount[root]
  let i = 0
  while i < cnt {
    modRwTsName(tsKids[start + i])
    i = i + 1
  }
  0
}
function modRwType(tyIx: i32): i32 {
  if tyIx < 0 { return 0 }
  const t = P.nodes[tyIx]
  if t is TypeRef {
    // The parser recorded this annotation's structure — rewrite THAT and render
    // the name from it, so the tree and the string stay in lockstep (note 22: an
    // in-place string rewrite between producer and consumer is exactly what left
    // the spelling tree describing the PRE-merge name).
    const root = annTsOf(tyIx)
    if root >= 0 {
      modRwTsName(root)
      t.tyName = tsToName(root)
      return 0
    }
    // No recorded spelling: a `TypeRef` the parser never built. None exist at
    // merge time (the emitter's `synthTypeRef` runs much later), but the
    // character scanner stays as the fall-through so the pass is total either way.
    t.tyName = modTypeRenamed(t.tyName)
  }
  0
}
// The first `saved` entries of a shadow stack (rebuild — a bare `.pop()`
// STATEMENT is an emit gap in the native pipeline).
function modTrimTo(stack: string[], saved: i32): string[] {
  const keep: string[] = []
  let ki = 0
  while ki < saved {
    keep.push(stack[ki])
    ki = ki + 1
  }
  keep
}
function modShadowTrim(saved: i32): i32 {
  modShadow = modTrimTo(modShadow, saved)
  0
}
function modRwFunc(ix: i32): i32 {
  const n = P.nodes[ix]
  if n is FuncDecl {
    n.fnName = modRenamed(n.fnName)
    // R4: an IN-PLACE name write on a node already in the arena, so re-note the name.
    sidNoteNodeName(ix)
    const saved = modShadow.length
    const tySaved = modTyShadow.length
    // The function's generic type parameters are live across its annotations
    // and body — segments naming them must not rewrite (see `modTyShadow`).
    let ti = 0
    while ti < n.fnTyParams.length {
      modTyShadow.push(n.fnTyParams[ti])
      ti = ti + 1
    }
    // A type parameter's BOUND is an annotation and renames like one — AFTER the
    // shadow push above, because a bound may name the parameters themselves
    // (`<T: { eq(T): boolean }>`) and those must not be renamed.
    let bi = 0
    while bi < n.fnTyParams.length {
      modRwType(fnTpBoundOf(ix, bi))
      bi = bi + 1
    }
    let pi = 0
    while pi < n.fnParams.length {
      const p = P.nodes[n.fnParams[pi]]
      if p is Param {
        modShadow.push(p.parName)
        modRwType(p.parType)
        // A parameter default is an expression of the declaring module, so a
        // module-scope `const` default renames exactly like any other reference
        // to that const (`K` → `K$mN`) — this is what keeps a default's names
        // resolved in the declaration's scope rather than the caller's, across the merge.
        if p.parDefault >= 0 { modRwExpr(p.parDefault) }
      }
      pi = pi + 1
    }
    modRwType(n.fnRet)
    modRwStmt(n.fnBody)
    modShadowTrim(saved)
    modTyShadow = modTrimTo(modTyShadow, tySaved)
  }
  0
}
// Push arm `k`'s payload-binding names onto the merge's shadow set (the caller trims). Reads them
// off the `LetDecl`s the parser banked in `matchBinds[armStart[k] + j]` — the SAME nodes the
// desugar prepends to the arm body, so the shadow set and the eventual declarations cannot drift.
function modShadowMatchBinds(n: MatchExpr, k: i32): i32 {
  const start = n.matchArmStart[k]
  let j = 0
  while j < n.matchArmCount[k] {
    const bIx = n.matchBinds[start + j]
    if bIx >= 0 {
      const bn = P.nodes[bIx]
      if bn is Block {
        let s = 0
        while s < bn.blkStmts.length {
          const st = P.nodes[bn.blkStmts[s]]
          if st is LetDecl { modShadow.push(st.letName) }
          s = s + 1
        }
      }
    }
    j = j + 1
  }
  0
}
function modRwBlock(ix: i32): i32 {
  const n = P.nodes[ix]
  if n is Block {
    // Block-local `let`/`function` names shadow a same-named top-level binding
    // for the WHOLE block (VL `let` is block-scoped, visible across the block).
    const saved = modShadow.length
    let pre = 0
    while pre < n.blkStmts.length {
      const st = P.nodes[n.blkStmts[pre]]
      if st is LetDecl { modShadow.push(st.letName) }
      if st is FuncDecl {
        if st.fnName != "" { modShadow.push(st.fnName) }
      }
      pre = pre + 1
    }
    let i = 0
    while i < n.blkStmts.length {
      modRwStmt(n.blkStmts[i])
      i = i + 1
    }
    modShadowTrim(saved)
  }
  0
}
function modRwStmt(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Program {
    let i = 0
    while i < n.progStmts.length {
      // D1045 — a body-scoped `type` is in this list twice over: once here (the
      // parser hoists it) and once at its lexical position inside a block. Rewrite
      // it there, never here — a second visit here would rename an already-
      // mangled name (`P$b7`) a second time, against the shadow the other visit needs.
      if !isBodyTyDecl(n.progStmts[i]) { modRwStmt(n.progStmts[i]) }
      i = i + 1
    }
    return 0
  }
  if n is Block { return modRwBlock(ix) }
  if n is LetDecl {
    // The initializer evaluates in the ENCLOSING scope; rewrite it before the
    // name. At the top level the declaration name is RENAMED; in a nested block
    // it is pre-collected into the shadow set, so `modRenamed` is a no-op.
    if n.letInit >= 0 { modRwExpr(n.letInit) }
    modRwType(n.letType)
    n.letName = modRenamed(n.letName)
    // R4: the same in-place name write (see `modRwFunc`).
    sidNoteNodeName(ix)
    return 0
  }
  if n is FuncDecl { return modRwFunc(ix) }
  if n is RetStmt {
    if n.retArg >= 0 { modRwExpr(n.retArg) }
    return 0
  }
  if n is IfStmt {
    modRwExpr(n.ifCond)
    modRwStmt(n.ifThen)
    if n.ifElse >= 0 { modRwStmt(n.ifElse) }
    return 0
  }
  if n is WhileStmt {
    modRwExpr(n.whileCond)
    modRwStmt(n.whileBody)
    return 0
  }
  if n is ForRange {
    modRwExpr(n.frFrom)
    modRwExpr(n.frTo)
    if n.frStep >= 0 { modRwExpr(n.frStep) }
    const frSaved = modShadow.length
    modShadow.push(n.frVar)
    modRwStmt(n.frBody)
    modShadowTrim(frSaved)
    return 0
  }
  if n is ForIn {
    modRwExpr(n.fiIter)
    const fiSaved = modShadow.length
    modShadow.push(n.fiVar)
    modRwStmt(n.fiBody)
    modShadowTrim(fiSaved)
    return 0
  }
  if n is BreakStmt { return 0 }
  if n is ContinueStmt { return 0 }
  if n is TypeDecl {
    // A generic alias's parameters (folded into the declared name) are live
    // across the name and the field annotations.
    const tdTySaved = modTyShadow.length
    const tdPs = declGpParamsOf(ix)
    let tdPi = 0
    while tdPi < tdPs.length {
      modTyShadow.push(tdPs[tdPi])
      tdPi = tdPi + 1
    }
    n.tdName = modTypeRenamed(n.tdName)
    modRwDeclBase(ix)
    // A BOUND alias carries its whole body as one annotation and NO fields, so
    // the loop below is empty for it and this is the rename that matters.
    modRwType(declBoundOf(ix))
    let i = 0
    while i < n.tdFields.length {
      const f = P.nodes[n.tdFields[i]]
      if f is FieldDef { modRwType(f.fdType) }
      i = i + 1
    }
    modTyShadow = modTrimTo(modTyShadow, tdTySaved)
    return 0
  }
  if n is UnionDecl {
    const udTySaved = modTyShadow.length
    const udPs = declGpParamsOf(ix)
    let udPi = 0
    while udPi < udPs.length {
      modTyShadow.push(udPs[udPi])
      udPi = udPi + 1
    }
    n.udName = modTypeRenamed(n.udName)
    modRwDeclBase(ix)
    const vs: string[] = []
    let i = 0
    while i < n.udVariants.length {
      // Each member's spelling is banked on this node in member order (`setUdTs`),
      // so the merge renames the tree and renders it, rather than renaming the
      // string directly — a `type v = i32` alongside a member `{ v: i32 }` would
      // otherwise rename the field, breaking the match to its own literal.
      const vRoot = udTsRootAt(ix, i)
      if vRoot >= 0 {
        modRwTsName(vRoot)
        vs.push(tsToName(vRoot))
      } else {
        vs.push(modTypeRenamed(n.udVariants[i]))
      }
      i = i + 1
    }
    n.udVariants = vs
    modTyShadow = modTrimTo(modTyShadow, udTySaved)
    return 0
  }
  modRwExpr(ix)
}

// The check-type half of the `IsExpr` merge rename, split out so a `match` arm's
// type pattern can rename its type without re-walking the shared scrutinee object a
// sibling arm already rewrote. A no-op on any other node kind. The check type is a
// parser spelling banked on this node, so the merge renames the tree and renders it.
function modRwIsType(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is IsExpr {
    const isRoot = annTsOf(ix)
    if isRoot >= 0 {
      modRwTsName(isRoot)
      n.isVariant = tsToName(isRoot)
      return 0
    }
    n.isVariant = modTypeRenamed(n.isVariant)
  }
  0
}

function modRwExpr(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Ident {
    n.identName = modRenamed(n.identName)
    // R4: the in-place name write the self-compile exercises hardest — the merge
    // renames every colliding top-level reference in every compiler module.
    sidNoteNodeName(ix)
    return 0
  }
  if n is Call {
    // A UFCS member-call `recv.prop(args)` whose `prop` names a mangled free
    // `self`-function. The property string on the `Member` is not rewritten, since a
    // callable field of the same name keeps precedence; records the plain→mangled
    // alias instead, banked on this node (D1120), not under the plain name.
    const cf = P.nodes[n.callFn]
    if cf is Member {
      const target = modSelfFnTarget(cf.memProp, n.callArgs.length)
      if target != "" { ufcsSiteAdd(ix, target) }
    }
    modRwExpr(n.callFn)
    let i = 0
    while i < n.callArgs.length {
      modRwExpr(n.callArgs[i])
      i = i + 1
    }
    return 0
  }
  if n is Member {
    // The property is a field label, never a top-level binding — receiver only.
    modRwExpr(n.memObj)
    return 0
  }
  if n is OptMember {
    modRwExpr(n.omObj)
    return 0
  }
  if n is Index {
    modRwExpr(n.idxArr)
    modRwExpr(n.idxIndex)
    return 0
  }
  if n is BinExpr {
    modRwExpr(n.binLeft)
    modRwExpr(n.binRight)
    return 0
  }
  if n is Unary {
    modRwExpr(n.unArg)
    return 0
  }
  if n is Paren {
    modRwExpr(n.parInner)
    return 0
  }
  if n is ObjLit {
    let i = 0
    while i < n.objFields.length {
      const f = P.nodes[n.objFields[i]]
      if f is FieldInit { modRwExpr(f.fiValue) }
      i = i + 1
    }
    return 0
  }
  if n is ArrayLit {
    let i = 0
    while i < n.arrElems.length {
      modRwExpr(n.arrElems[i])
      i = i + 1
    }
    return 0
  }
  if n is IsExpr {
    modRwExpr(n.isObj)
    return modRwIsType(ix)
  }
  if n is AsExpr {
    modRwExpr(n.asObj)
    // The cast target is renamable: the checker requires it resolve to a numeric
    // scalar, and a user alias (`type Id = i32`, `x as Id`) does — leaving the cast
    // spelling alone while the declaration renamed to `Id$mN` failed every module
    // program casting to a named alias.
    const asRoot = annTsOf(ix)
    if asRoot >= 0 {
      modRwTsName(asRoot)
      n.asTy = tsToName(asRoot)
      return 0
    }
    n.asTy = modTypeRenamed(n.asTy)
    return 0
  }
  // D981 — an if-expression (the same `IfStmt` node in value position: a `return`,
  // initializer, assignment RHS, call argument, or nested arm). Routes to
  // `modRwStmt`'s own arm, so a nested arm keeps `modRwBlock`'s shadow handling
  // instead of a drifting second copy.
  if n is IfStmt { return modRwStmt(ix) }

  // A `match` (value- or statement-position). The merge rename descends into the
  // scrutinee and every arm body, else an arm's name keeps its bare spelling after
  // the export's rename. A type pattern's check type takes `modRwIsType`, not
  // `modRwExpr`, which would re-walk the shared scrutinee and rename it n+1 times over.
  if n is MatchExpr {
    modRwExpr(n.matchScrut)
    let p = 0
    while p < n.matchPats.length {
      modRwIsType(n.matchPats[p])
      p = p + 1
    }
    let i = 0
    while i < n.matchBodies.length {
      // Payload bindings hold nothing this pass renames — the initializer is a
      // `Member` over the shared scrutinee (renamed once, above) and `letName` is
      // arm-local. But they must shadow: the desugar later prepends them to this
      // body, so a module-level `const x` would otherwise capture the body's own `x`.
      const saved = modShadow.length
      modShadowMatchBinds(n, i)
      modRwStmt(n.matchBodies[i])
      modShadowTrim(saved)
      i = i + 1
    }
    return 0
  }
  if n is FuncDecl { return modRwFunc(ix) }
  0
}
