}
// The MERGED (mangled) name of the declaration that module `m`'s public `name`
// ultimately denotes. Normally `m` DECLARES it and the answer is the `name$mM` the
// merge rename gave it. When `m` only RE-EXPORTS it, the declaration lives further
// down — follow the re-export to the module it pulls from and ask again, so a CHAIN
// (A declares, B re-exports from A, C re-exports from B) resolves to A's mangled
// name instead of to a `name$mC` that nothing ever defines. Both consumers need
// this walk: the merge rename (an importer's reference must rewrite to the real
// declaration) and the emitter's re-export alias table (the wasm export must point
// at a function that exists).
//
// Each hop reads the import edge the re-export ALSO created (`modScan` pushes both,
// always paired): its `impName` is the SOURCE name in the module it came from, which
// is what `as` renaming makes different from the public name. Bounded by
// MOD_DEPTH_MAX for the same reason `modVisit` is — though a re-export cycle is
// already an import cycle and is diagnosed before this ever runs.
function modMergedTargetOf(m: i32, name: string): string {
  let cm = m
  let cn = name
  let hops = 0
  while hops < MOD_DEPTH_MAX {
    let nextMod = -1
    let nextName = ""
    let r = 0
    while r < reExpMod.length && nextMod < 0 {
      if reExpMod[r] == cm && reExpPublic[r] == cn {
        let ii = 0
        while ii < impMod.length && nextMod < 0 {
          if (
            impMod[ii] == cm &&
            impLocal[ii] == reExpLocal[r] &&
            impName[ii] != ""
          ) {
            const dd = modIndexOfKey(impKey[ii])
            if dd >= 0 {
              nextMod = dd
              nextName = impName[ii]
            }
          }
          ii = ii + 1
        }
      }
      r = r + 1
    }
    if nextMod < 0 { return cn + "$m" + i32ToStr(cm) }
    cm = nextMod
    cn = nextName
    hops = hops + 1
  }
  cn + "$m" + i32ToStr(cm)
}
// Visit module `m`: resolve + validate its imports (unsupported specifier,
// unresolvable key, cycle back-edge, name-not-exported), recursing into deps
// first. Message texts match the host's `modules.ts` (the corpus `@error`s
// substring them).
// The DFS recurses once per import-chain link, so an adversarially deep chain
// would overflow the wasm call stack — an opaque trap. Capped with a real
// diagnostic instead; genuine dependency chains sit orders of magnitude below.
const MOD_DEPTH_MAX = 256
function modVisit(m: i32, depth: i32): i32 {
  modState[m] = 1
  let i = 0
  while i < impMod.length {
    if impMod[i] == m {
      const spec = impSpec[i]
      const key = impKey[i]
      if key == "" {
        // Texts mirror the host's `loadProgram` — keep them aligned. Spec-shaped
        // problems anchor at the specifier STRING token of THIS import.
        if modKeyIsStd(modKeys[m]) && modIsRelative(spec) {
          modDiag(
            m,
            impSpecLine[i],
            impSpecCol[i],
            "Unsupported import specifier \"" +
              spec +
              "\" — std modules import only via `std:` specifiers (relative imports inside std are not allowed)",
          )
        } else {
          modDiag(
            m,
            impSpecLine[i],
            impSpecCol[i],
            "Unsupported import specifier \"" +
              spec +
              "\" — supported: relative paths (`./`, `../`) and `std:` modules; bare specifiers are not yet implemented",
          )
        }
      } else {
        const d = modIndexOfKey(key)
        if d < 0 {
          modDiag(
            m,
            impSpecLine[i],
            impSpecCol[i],
            "Cannot resolve import \"" + spec + "\" (no module `" + key + "`)",
          )
        } else if modFound[d] == 0 {
          modDiag(
            m,
            impSpecLine[i],
            impSpecCol[i],
            "Cannot resolve import \"" + spec + "\" (no module `" + key + "`)",
          )
        } else if modState[d] == 1 {
          modDiag(
            m,
            impSpecLine[i],
            impSpecCol[i],
            "Import cycle detected through \"" +
              spec +
              "\" (module `" +
              key +
              "`)",
          )
        } else {
          if modState[d] == 0 {
            if depth >= MOD_DEPTH_MAX {
              modDiag(
                m,
                impSpecLine[i],
                impSpecCol[i],
                "Import chain exceeds the maximum depth (" +
                  i32ToStr(MOD_DEPTH_MAX) +
                  ") at \"" +
                  spec +
                  "\" (module `" +
                  key +
                  "`)",
              )
            } else {
              modVisit(d, depth + 1)
            }
          }
          if impName[i] != "" {
            if !modExportsHas(d, impName[i]) {
              // A name-shaped problem anchors at the imported NAME token.
              modDiag(
                m,
                impNameLine[i],
                impNameCol[i],
                "\"" + impName[i] + "\" is not exported by \"" + spec + "\"",
