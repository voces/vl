  // SAME row shape a bare `import "std:fmt"` pushes, one edge with `impName`/`impLocal`
  // both EMPTY. That emptiness is the no-pollution mechanism: the host's fetch loop
  // reads `impKey`, so the module is fetched, ordered, parsed and merged with no host
  // change, while `modBuildRename` mints a rename row only for `impLocal != ""`, so no
  // user-visible binding appears. The renderer is reached through the unspellable
  // `TPL_RENDER_LOCAL` row beside this edge; `std:fmt` itself is skipped (self-cycle).
  //
  // EVERY imp* COLUMN IS PUSHED, including those a synthetic row has nothing to say
  // about: they are POSITIONAL side tables, so a skipped column shifts every LATER
  // row's specifier span and char flag onto the wrong import.
  if sawTplHole && modKeys[m] != TPL_RENDER_MODULE {
    impMod.push(m)
    impSpec.push(TPL_RENDER_MODULE)
    impKey.push(TPL_RENDER_MODULE)
    impName.push("")
    impLocal.push("")
    impNameLine.push(1)
    impNameCol.push(0)
    impSpecLine.push(1)
    impSpecCol.push(0)
    impSpecEnd.push(0)
    impSpecChar.push(0)
  }
  0
}
// ── where a template hole's renderer comes from ──────────────────────────────
// A template binds ABSOLUTELY: `` `n=${x}` `` means the same thing in every file
// regardless of what that file imports, so the renderer is named here and never
// looked up in the user's scope (DECISIONS.md, owner ruling 2026-09-01 — a
// string literal's meaning must not depend on imports).
//
// THESE TWO LINES ARE THE WHOLE BINDING. The queued `toStr` → `toString` rename
// (ROADMAP § Ruled and sequenced — the ambient builtin is killed and std:fmt's
// `toStr` moves into the vacancy) is a one-line edit to `TPL_RENDER_EXPORT`.
const TPL_RENDER_MODULE = "std:fmt"
const TPL_RENDER_EXPORT = "toString"

function modIndexOfKey(key: string): i32 {
  let i = 0
  while i < modKeys.length {
    if modKeys[i] == key { return i }
    i = i + 1
  }
  -1
}
function modRecomputePending(): i32 {
  modPending = []
  let i = 0
  while i < impKey.length {
    const k = impKey[i]
    if k != "" && modIndexOfKey(k) < 0 {
      if !capHas(modPending, k) { modPending.push(k) }
    }
    i = i + 1
  }
  0
}

// ── module pipeline (order/validate → parse-merge → rename/rewrite) ───────────
// DFS state lives at the top of this file: 0 unvisited, 1 loading (on the stack
// — a back-edge is a cycle), 2 done. `modOrder` collects table indices in
// dependency-first (post) order.
// Record one module-resolution diagnostic with its position and owning module.
// Deduped on (module, message) — the same missing module imported by TWO files
// is two findings, one per importer; repeated imports WITHIN one module (e.g.
// several names pulled from one unresolvable specifier) still fold into one.
let modDiagLine: i32[] = []
let modDiagCol: i32[] = []
let modDiagEnd: i32[] = []
let modDiagMod: i32[] = []
function modDiag(m: i32, line: i32, col: i32, msg: string): i32 {
  modDiagSpan(m, line, col, col, msg)
}
// `modDiag` with a SPAN — `[col, endCol)` on `line`, for a report whose subject is
// a whole lexeme the reader has to see (the specifier token). These diagnostics
// are tokenless, so the span cannot be derived downstream; `endCol == col` is the
// point rendering every other module report keeps.
function modDiagSpan(
  m: i32,
  line: i32,
  col: i32,
  endCol: i32,
  msg: string,
): i32 {
  let i = 0
  while i < modDiags.length {
    if modDiagMod[i] == m && modDiags[i] == msg { return 0 }
    i = i + 1
  }
  modDiags.push(msg)
  modDiagLine.push(line)
  modDiagCol.push(col)
  modDiagEnd.push(endCol)
  modDiagMod.push(m)
  0
}
// Is `name` part of module `m`'s PUBLIC surface? The surface is the UNION of two
// tables, and reading only the first was the whole of the `export … from` gap: a
// declaration marked `export` lands in `expName`, but a RE-EXPORT
// (`export { name } from "dep"`) lands in `reExpPublic` and NOTHING ever writes it to
// `expName` — so a sibling importing a re-exported name was told `"name" is not
// exported by "./mid"` even though `modScan` had recorded the re-export correctly.
//
// The two tables stay SEPARATE rather than merging at the scan: `expName` doubles as
// "declarations that carry the keyword HERE" for the LSP's cross-file go-to-definition
// and its redundant-export-keyword hint, and a re-export declares nothing in this
// module — folding it in would land go-to-definition on the re-export line and fire
// the hint on every re-export. Visibility is the union; provenance is not.
function modExportsHas(m: i32, name: string): boolean {
  let i = 0
  while i < expMod.length {
    if expMod[i] == m && expName[i] == name { return true }
    i = i + 1
  }
  // A re-export publishes its PUBLIC name (`reExpPublic` — the `as` alias, else the
  // source name), so `export { a as b } from "dep"` surfaces `b` and NOT `a`.
  let r = 0
  while r < reExpMod.length {
    if reExpMod[r] == m && reExpPublic[r] == name { return true }
    r = r + 1
  }
  false
}
// The MERGED (mangled) name of the declaration that module `m`'s public `name`
// ultimately denotes. Normally `m` DECLARES it and the answer is the `name$mM` the
// merge rename gave it; when `m` only RE-EXPORTS it, follow the re-export to the
// module it pulls from and ask again, so a CHAIN (A declares, B re-exports from A,
// C re-exports from B) resolves to A's mangled name instead of to a `name$mC` that
// nothing defines. Both consumers need the walk: the merge rename (an importer's
// reference must rewrite to the real declaration) and the emitter's re-export alias
// table (the wasm export must point at a function that exists).
//
// Each hop reads the import edge the re-export ALSO created (`modScan` pushes both,
// always paired): its `impName` is the SOURCE name in the module it came from, which
// is what `as` renaming makes different from the public name. Bounded by MOD_DEPTH_MAX.
function modMergedTargetOf(m: i32, name: string): string {
  let cm = m
  let cn = name
  let hops = 0
  while hops < MOD_DEPTH_MAX {
    let nextMod = -1
    let nextName = ""
    let r = 0
    while r < reExpMod.length && nextMod < 0 {
      if reExpMod[r] == cm && reExpPublic[r] == cn {
        let ii = 0
        while ii < impMod.length && nextMod < 0 {
          if (
            impMod[ii] == cm &&
            impLocal[ii] == reExpLocal[r] &&
            impName[ii] != ""
          ) {
            const dd = modIndexOfKey(impKey[ii])
            if dd >= 0 {
              nextMod = dd
              nextName = impName[ii]
            }
          }
          ii = ii + 1
        }
      }
      r = r + 1
    }
    if nextMod < 0 { return cn + "$m" + i32ToStr(cm) }
    cm = nextMod
    cn = nextName
    hops = hops + 1
  }
  cn + "$m" + i32ToStr(cm)
}
// D1120 — A DUPLICATE IMPORT IS AMBIGUOUS ONLY WHEN THE TWO BINDINGS RESOLVE TO
// DIFFERENT DECLARATIONS, and that is a design rule with a sentence.
//
// `import { area } from "./a"` beside `import { area } from "./b"` binds ONE name in
// one scope to two different functions; there is no answer, and until this diagnostic
// the program was refused at a USE with `no field 'area' on Sq` — a message about a
// field, at a line that is not the mistake, naming neither module. The same name
// imported twice from the SAME module (or through a re-export chain landing on the
// same declaration) binds ONE thing: redundant, not ambiguous, and it RUNS today, so
// the test is on the resolved merged target (`modMergedTargetOf`) and not on the
// specifier text. Anchored at the SECOND occurrence's imported NAME token, and it
// names BOTH specifiers: a diagnostic about two imports must not hide one of them.
function modDiagDupImport(m: i32, i: i32, d: i32, spec: string): i32 {
  const local = impLocal[i]
  if local == "" { return 0 }
  const here = modMergedTargetOf(d, impName[i])
  let j = 0
  while j < i {
    if impMod[j] == m && impLocal[j] == local && impName[j] != "" {
      const dj = modIndexOfKey(impKey[j])
      if dj >= 0 {
        if modMergedTargetOf(dj, impName[j]) != here {
          modDiag(
            m,
            impNameLine[i],
            impNameCol[i],
            "Duplicate binding \"" +
              local +
              "\": module `" +
              modKeys[m] +
              "` imports it from both \"" +
              impSpec[j] +
              "\" and \"" +
              spec +
              "\" — rename one (`as` on the import)",
          )
          return 0
        }
      }
    }
    j = j + 1
  }
