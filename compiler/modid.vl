// A module's stable id: the `$m<id>` suffix the merge appends to every top-level name a
// module declares. The id is a hash of the module's normalised key, so it is a function of
// the module alone — adding an import elsewhere in the graph leaves every other module's
// names unchanged (incremental-compilation-design.md §3.2). A leaf with no imports.

// Per module table index: its suffix (`$m` + decimal id), and the reverse map from the id's
// digits to the index. Both empty outside a module compile.
let midSuffix: string[] = []
let midIxOfId: {[string]: i32} = Map()
// Per module table index, the spelling `modIdOrderNames` puts in place of its suffix: the
// suffix itself, or for a module keyed on its absolute path (no project root) `$p` and its
// path from the entry's directory, so what reads it does not depend on where the tree sits.
let midOrder: string[] = []
let midOrderAny = false

// Whether the last graph salted any key: only then can a module's id depend on its company.
export let midSalted = false

// FNV-1a over the key's bytes, then `salt` more rounds, cut to 31 bits so the id is a
// non-negative i32 and its decimal digits never carry a sign.
function midHash(key: string, salt: i32): i32 {
  let h = -2128831035
  let i = 0
  while i < key.length {
    h = (h ^ key[i]) * 16777619
    i = i + 1
  }
  let k = 0
  while k < salt {
    h = (h ^ 35) * 16777619
    k = k + 1
  }
  h & 2147483647
}

function midDecimal(v: i32): string {
  if v == 0 { return "0" }
  const ds = "0123456789"
  let out = ""
  let n = v
  while n > 0 {
    const d = n % 10
    out = ds.slice(d, d + 1) + out
    n = n / 10
  }
  out
}

// Assign every module of one graph its id from `keys` (already normalised, `[0]` the entry),
// and its order spelling, an absolute key read from `entryDir`. Two keys that hash alike are
// told apart by salting the one that sorts later until it is unique, so the outcome depends
// only on the SET of keys, never on their discovery order.
export function modIdAssign(keys: string[], entryDir: string) {
  midSalted = false
  const ids: i32[] = []
  const salts: i32[] = []
  let i = 0
  while i < keys.length {
    ids.push(midHash(keys[i], 0))
    salts.push(0)
    i = i + 1
  }
  let moved = true
  while moved {
    moved = false
    let a = 0
    while a < keys.length {
      let b = a + 1
      while b < keys.length {
        if ids[a] == ids[b] && keys[a] != keys[b] {
          let late = b
          if keys[a] > keys[b] { late = a }
          salts[late] = salts[late] + 1
          ids[late] = midHash(keys[late], salts[late])
          moved = true
          midSalted = true
        }
        b = b + 1
      }
      a = a + 1
    }
  }
  midSuffix = []
  midIxOfId = Map()
  midOrder = []
  midOrderAny = false
  let j = 0
  while j < keys.length {
    const digits = midDecimal(ids[j])
    midSuffix.push("$m" + digits)
    if midIxOfId[digits] == null { midIxOfId[digits] = j }
    const key = keys[j]
    const absolute = key.length > 0 && key[0] == '/'
      || key.length > 2 && key[1] == ':'
    if absolute {
      midOrderAny = true
      midOrder.push("$p" + modIdRelTo(entryDir, key))
    } else {
      midOrder.push("$m" + digits)
    }
    j = j + 1
  }
  0
}

// `s` with each `$m<id>` naming a module of this graph spelled as that module's order
// spelling, for a reader whose result is emitted (the canonical type order). Unchanged
// outside a module compile, or when no module of the graph is keyed on its absolute path.
export function modIdOrderNames(s: string): string {
  if !midOrderAny { return s }
  let out = ""
  let from = 0
  let i = 0
  while i + 2 < s.length {
    if s[i] == '$' && s[i + 1] == 'm' && s[i + 2] >= '0' && s[i + 2] <= '9' {
      let e = i + 2
      while e < s.length && s[e] >= '0' && s[e] <= '9' { e = e + 1 }
      const m = midIxOfId[s.slice(i + 2, e)] ?? (-1)
      if m >= 0 {
        out = out + s.slice(from, i) + midOrder[m]
        from = e
      }
      i = e
    } else {
      i = i + 1
    }
  }
  out + s.slice(from, s.length)
}

// `path` relative to the directory `dir`, both normalised and `/`-separated: one `..` per
// segment of `dir` past the prefix they share, then the rest of `path`. `path` unchanged when
// `dir` is "" or the two share no leading segment (a different drive, or a relative key).
export function modIdRelTo(dir: string, path: string): string {
  if dir.length == 0 { return path }
  const ds = midSegs(dir)
  const ps = midSegs(path)
  let c = 0
  while c < ds.length && c < ps.length - 1 && ds[c] == ps[c] { c = c + 1 }
  if c == 0 { return path }
  let out = ""
  let u = c
  while u < ds.length {
    out = out + "../"
    u = u + 1
  }
  let k = c
  while k < ps.length {
    if k > c { out = out + "/" }
    out = out + ps[k]
    k = k + 1
  }
  out
}

function midSegs(s: string): string[] {
  const out: string[] = []
  let from = 0
  let i = 0
  while i <= s.length {
    if i == s.length || s[i] == '/' {
      out.push(s.slice(from, i))
      from = i + 1
    }
    i = i + 1
  }
  out
}

// Forget the previous graph's ids; a compile with no module table then names module 0 `$m0`.
export function modIdReset() {
  midSuffix = []
  midIxOfId = Map()
  midSalted = false
  midOrder = []
  midOrderAny = false
  0
}

// The merge suffix of module table index `m`. Outside a module compile (a single-file program,
// whose only module is the entry) it is `$m` + the index itself.
export function modSuffixOf(m: i32): string {
  if m >= 0 && m < midSuffix.length { return midSuffix[m] }
  "$m" + midDecimal(m)
}

// The module table index whose id is `digits` (the run after `$m`), or -1 when no module of
// this graph carries it. With no id table the digits are the index, as `modSuffixOf` spells it.
export function modIxOfId(digits: string): i32 {
  if midSuffix.length > 0 { return midIxOfId[digits] ?? (-1) }
  let v = 0
  let i = 0
  while i < digits.length {
    v = v * 10 + (digits[i] - '0')
    i = i + 1
  }
  v
}
