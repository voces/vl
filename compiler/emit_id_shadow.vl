// The identity shadow's analysis (`$VL_ID_SHADOW`): the `Fn#d` set every function-valued read
// would carry if each declaration and lambda had a singleton function type. It reads the
// checker's persistent facts after the check and feeds nothing back, except that mode 2 keys
// callback specialization by it. The report rows are `kind`, `join`, `spec` and `insts`.

import {
  ArrayLit,
  FuncDecl,
  Ident,
  IfStmt,
  LetDecl,
  MatchExpr,
  P,
  Param,
  Spread,
  i32ToStr,
  nodeAt,
} from "./ast"
import { T, TyArray, TyFunc } from "./check_types"
import { identDeclOf } from "./symbols"
import { fnDeclParent } from "./check_decl_scan"
import { nodeTyFrozenOf } from "./check_node_tys"
import { valueTailSplit } from "./check_num_adopt"
import { elabFnSetTy, fnTagTyIsTagged, fnTagged } from "./check_fn_tag_facts"
import {
  elabFnSetOf,
  fnTagLeafId,
  fnTagLeafSetOf,
  fnTagMembers,
} from "./check_elab_cap"
import { parenPeelIx } from "./check_places"
import { fnStmts, fnStmtsPosOf } from "./emit_state"
import { nodePos } from "./fmt_util"
import {
  elabFnIdReset,
  idCanon,
  idLetSet,
  idSetOf,
  idSlotSetOf,
  idSlotWriteAt,
  idSlotWriteCount,
  idSlotWriteHeldTy,
  idSlotWriteKey,
  idSlotWritePos,
  idSlotWriteTy,
  idUnion,
  idWritesOf,
  idWrittenLets,
} from "./elab_fn_id"
import {
  idShadowModeOf,
  idShadowReadNodes,
  idShadowRow,
} from "./id_shadow_state"

// The set the checked type of node `ix` carries today, or -1.
function idTodaySetId(t: i32): i32 {
  if t < 0 { return -1 }
  elabFnSetTy[t] ?? -1
}

function idTodayTag(s: i32): string {
  if s < 0 { return "none" }
  if fnTagged[s] ?? false { return "tagged" }
  "untagged"
}

function idIsFnTy(t: i32): boolean {
  t >= 0 && t < T.tys.length && T.tys[t] is TyFunc
}

function idSetClass(s: i32[]): string {
  if s.length == 0 { return "open" }
  if s.length == 1 { return "single" }
  "set" + i32ToStr(s.length)
}

// The kind of function-valued read `ix` is: a lambda literal, a read of a module-scope
// declaration, of a nested one, of a `let`, of a parameter, or other.
function idReadKind(ix: i32): string {
  const n = nodeAt(ix)
  if n is FuncDecl { return "lambda" }
  if !(n is Ident) { return "other" }
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length { return "other" }
  const dn = nodeAt(d)
  if dn is FuncDecl {
    if (fnDeclParent[d] ?? -1) == -1 { return "decl" }
    return "nested"
  }
  if dn is LetDecl { return "binding" }
  if dn is Param { return "param" }
  idOtherKind(d)
}

// A read of any other declaration (an import, an extern, a loop or `match` binding) is
// counted as `other`.
function idOtherKind(_d: i32): string { "other" }

// Run once when the elaboration finishes: one `kind` row per read kind and one `join` row per
// value join of function values, each with the class of set the shadow gives it and whether
// the checked type carries a set today.
export function idShadowSnap() {
  if idShadowModeOf() == 0 { return 0 }
  elabFnIdReset()
  const kinds = ["lambda", "decl", "nested", "binding", "param", "other"]
  const nAll: i32[] = [0, 0, 0, 0, 0, 0]
  const nSingle: i32[] = [0, 0, 0, 0, 0, 0]
  const nSet: i32[] = [0, 0, 0, 0, 0, 0]
  const nToday: i32[] = [0, 0, 0, 0, 0, 0]
  for ix in idShadowReadNodes() {
    if ix >= P.nodes.length { continue }
    const k = idReadKind(ix)
    let ki = 0
    while ki < kinds.length && kinds[ki] != k { ki = ki + 1 }
    if ki >= kinds.length { continue }
    nAll[ki] = nAll[ki] + 1
    const s = idSetOf(ix, 0)
    if s.length == 1 { nSingle[ki] = nSingle[ki] + 1 }
    if s.length > 1 { nSet[ki] = nSet[ki] + 1 }
    if idTodaySetId(nodeTyFrozenOf(ix)) >= 0 { nToday[ki] = nToday[ki] + 1 }
  }
  let ki = 0
  while ki < kinds.length {
    if nAll[ki] > 0 {
      idShadowRow(
        "kind "
          + kinds[ki]
          + " n="
          + i32ToStr(nAll[ki])
          + " single="
          + i32ToStr(nSingle[ki])
          + " set="
          + i32ToStr(nSet[ki])
          + " todayset="
          + i32ToStr(nToday[ki]),
      )
    }
    ki = ki + 1
  }
  idJoinRows()
  idSlotRows()
  0
}

// The rep the emitter gives value `w` written into a slot: "id" when it emits the value as a
// tagged set's member id, else "clo".
function idValueRep(w: i32): string {
  const x = parenPeelIx(w)
  if fnTagLeafId(x) >= 0 { return "id" }
  if fnTagTyIsTagged(nodeTyFrozenOf(x)) { return "id" }
  "clo"
}

// Whether every member of `s` is in the tagged set value `w` emits an id of.
function idTagCovers(w: i32, s: i32[]): boolean {
  const x = parenPeelIx(w)
  let ts = fnTagLeafSetOf(x)
  if ts < 0 { ts = elabFnSetTy[nodeTyFrozenOf(x)] ?? -1 }
  if ts < 0 { return false }
  const ms: i32[] = []
  for m in fnTagMembers(ts) { ms.push(idCanon(m)) }
  for d in s {
    let hit = false
    for m in ms {
      if m == idCanon(d) { hit = true }
    }
    if !hit { return false }
  }
  true
}

// One `slot` row per function-typed write into a list element, a record field or a map value:
// the write's position, the class of its slot's set (the union of the slot's writes), the
// value's rep / the slot type's rep, and the verdict of the set against them.
function idSlotRows() {
  const n = idSlotWriteCount()
  let i = 0
  while i < n {
    const w = idSlotWriteAt(i)
    const s = idSlotSetOf(idSlotWriteKey(i))
    const vr = idValueRep(w)
    const sr = if fnTagTyIsTagged(idSlotWriteTy(i)) { "id" } else { "clo" }
    const ht = idSlotWriteHeldTy(i)
    const hr = if ht < 0 { "-" } else if fnTagTyIsTagged(ht) { "id" } else { "clo" }
    let v = ""
    if vr != sr {
      v = "split"
    } else if s.length == 0 {
      v = "open"
    } else if vr == "id" {
      v = if !idTagCovers(w, s) { "id-uncovered" } else if s.length == 1 { "static" } else { "tag" }
    } else {
      v = if s.length == 1 { "clo-single" } else { "clo-set" }
    }
    idShadowRow(
      "slot "
        + idSlotWritePos(i)
        + " "
        + idSetClass(s)
        + " "
        + vr
        + "/"
        + sr
        + "/"
        + hr
        + " "
        + v
        + (if hr != "-" && hr != vr { "+held-split" } else { "" })
        + " @"
        + i32ToStr(nodePos(idCanon(w))),
    )
    i = i + 1
  }
  0
}

function idJoinRow(pos: string, s: i32[], t: i32) {
  idShadowRow(
    "join " + pos + " " + idSetClass(s) + " " + idTodayTag(idTodaySetId(t)),
  )
}

function idJoinRows() {
  const inner: {[i32]: boolean} = Map()
  const cands: i32[] = []
  let ix = 0
  const end = P.nodes.length
  while ix < end {
    const n = nodeAt(ix)
    if (n is IfStmt || n is MatchExpr) && idIsFnTy(nodeTyFrozenOf(ix)) {
      const spine: i32[] = []
      const leaves: i32[] = []
      valueTailSplit(ix, spine, leaves)
      if leaves.length >= 2 {
        cands.push(ix)
        for sp in spine {
          if sp != ix { inner[sp] = true }
        }
      }
    } else if n is ArrayLit && n.arrElems.length >= 2 {
      const lt = nodeTyFrozenOf(ix)
      if lt >= 0 && lt < T.tys.length {
        const la = T.tys[lt]
        if la is TyArray && idIsFnTy(la.aElem) {
          let acc: i32[] = []
          let open = false
          for e in n.arrElems {
            if nodeAt(e) is Spread { open = true }
            const s = idSetOf(e, 0)
            if s.length == 0 { open = true }
            acc = idUnion(acc, s)
          }
          const none: i32[] = []
          idJoinRow("list", if open { none } else { acc }, la.aElem)
        }
      }
    }
    ix = ix + 1
  }
  for c in cands {
    if !(inner[c] ?? false) {
      idJoinRow("arms", idSetOf(c, 0), nodeTyFrozenOf(c))
    }
  }
  for bd in idWrittenLets() {
    const ws = idWritesOf(bd)
    if ws.length < 2 || bd >= end || !(nodeAt(bd) is LetDecl) { continue }
    let fnAll = true
    for w in ws {
      if !idIsFnTy(nodeTyFrozenOf(parenPeelIx(w))) { fnAll = false }
    }
    if fnAll {
      idJoinRow("let", idLetSet(bd, 0), nodeTyFrozenOf(parenPeelIx(ws[0])))
    }
  }
  0
}

// The class of one set against mono's chosen declaration `monoDecl`.
function idSpecClass(s: i32[], monoDecl: i32): string {
  if s.length == 0 { return "none" }
  if s.length > 1 { return "set" + i32ToStr(s.length) }
  if idCanon(s[0]) == idCanon(monoDecl) { return "single-ok" }
  "single-other"
}

// The argument's node kind: a lambda literal, a name, or another expression.
function idArgKind(ax: i32): string {
  const x = parenPeelIx(ax)
  if x < 0 || x >= P.nodes.length { return "none" }
  const n = nodeAt(x)
  if n is FuncDecl { return "lambda" }
  if n is Ident { return "name" }
  idOtherKind(x)
}

// One `spec` row for a callback specialization mono decided at argument `ax`, baking
// declaration `monoDecl`: today's set (read from `todayTy`), the shadow's, and whether today's
// is tagged. Under mode 2 it returns the name the shadow keys the argument by, "" for none;
// under mode 1 it returns `monoName`.
export function idShadowSpec(
  ax: i32,
  monoDecl: i32,
  monoName: string,
  todayTy: i32,
): string {
  const mode = idShadowModeOf()
  if mode == 0 { return monoName }
  const sh = idSetOf(ax, 0)
  const ts = idTodaySetId(todayTy)
  let today = "noset"
  let todayIds = ""
  if todayTy < 0 { today = "notype" }
  if ts >= 0 {
    const tl = elabFnSetOf(todayTy)
    today = idSpecClass(tl, monoDecl)
    for m in tl { todayIds = todayIds + i32ToStr(m) + "," }
  }
  idShadowRow(
    "spec today="
      + today
      + " shadow="
      + idSpecClass(sh, monoDecl)
      + " tagged="
      + (if ts >= 0 && (fnTagged[ts] ?? false) { "yes" } else { "no" })
      + " ids="
      + todayIds
      + "/"
      + (if sh.length == 1 { i32ToStr(sh[0]) } else { "-" })
      + "/"
      + i32ToStr(idCanon(monoDecl))
      + "/"
      + i32ToStr(ax)
      + " arg="
      + idArgKind(ax),
  )
  if mode < 2 { return monoName }
  if sh.length != 1 { return "" }
  const fe = fnStmtsPosOf(sh[0])
  if fe < 0 || fe >= fnStmts.length { return "" }
  const f = nodeAt(fnStmts[fe])
  if f is FuncDecl { return f.fnName }
  ""
}

// One `insts` row: how many instances mono keyed this compile.
export function idShadowInstRow(n: i32) { idShadowRow("insts " + i32ToStr(n)) }
