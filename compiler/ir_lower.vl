  listIdxScratchBase,
  localIsRef,
  localStructIdx,
  loopBrkDepth,
  loopBrkLabel,
  loopContDepth,
  loopContLabel,
  sHeapIdx,
  sTy,
  shIdxFrom,
  shIdxNode,
  shIdxTo,
  uBoxIdx,
  uBoxNewEnd,
  uFieldCount,
  uVarRow,
  uVarTyIx,
  unionSinkBase,
} from "./emit_state"
import { ListBuild } from "./emit_ref_list_kinds"
import { identDeclOf, sidOfNode } from "./symbols"
import { globalIndexOfSid } from "./emit_fn_ret_kinds"
import { i32ListHas } from "./listutil"
import { memberCallYieldsValue } from "./emit_nullable_rets"

// The function being lowered.
export function irLFn(): IrFn { return lw }

// The function being lowered, the definitions of its temps, and the state of one walk.
let lw = irFnNew(-1, "")
// Where the function being lowered sits, for the global storage classes.
let lwGlobalCtx: GlobalCtx = {
  gcInStart: false,
  gcFnPos: -1,
  gcGuardOff: false,
}
let lwMiss = ""
let lwTempRhs: Rhs[] = []
let lwTempDef: boolean[] = []
let lwTempUsed: boolean[] = []
// Locals a valued `if` left on the stack, read once as a temp is.
let lwStackVal: boolean[] = []
// Those values on the stack, not yet read, bottom first. A reader takes the lowest above
// `lwFloor`, the count beneath the valued `if` being written, which nothing in that `if` reads.
let lwLive: i32[] = []
// Where each of `lwLive` ends in the buffer: a reader writes nothing between two of them.
let lwLiveEnd: i32[] = []
let lwFloor = 0
let lwFloors: i32[] = []
// The boxes whose spans `boxLeadStage` raised the floor for, innermost last.
let lwLeadBoxes: i32[] = []
// The order-stash slots the function's `RStashSet`s opened: literal, layout position, slot.
let lwStashAt: i32[] = []
let lwStashFi: i32[] = []
let lwStashSlots: i32[] = []
// The order-stashed literals whose box head their first `RStashSet` wrote, as legacy's tag leads.
let lwBoxHeadAt: i32[] = []
// Each order-stashed literal by the out its first source field reads, noted once per function.
let lwIfHeadAt: {[i32]: i32} = Map()
let lwIfHeadBuilt = false
// Each box by the out its value is (`stashIfBoxHead`), noted with `lwIfHeadAt`.
let lwIfBoxAt: {[i32]: i32} = Map()
// Each such box's union (`RToBox.bxTy`), by the same out.
let lwIfBoxTy: {[i32]: i32} = Map()
// The temps the operands being written consumed, in the order their values reach the stack.
let lwSeq: i32[] = []
// The open control frames, innermost last: a block or loop label, or -1 for an `if`.
let lwFrames: i32[] = []
// The labels of the open frames that carry a loop value through their result binding.
let lwLvLabels: i32[] = []
// Statement spans: rows opened at a node and closed after another, by the node ids.
let lwSpanOpen: i32[] = []
let lwSpanAt: i32[] = []
let lwRowAst: i32[] = []
let lwRowFrom: i32[] = []
let lwRowTo: i32[] = []
// Each row's kind: 5 a statement, 6 an element read (`bankSpanRow`).
let lwRowKind: i32[] = []
// Where each node an element read's row opens at began, in the buffer (`irRowOpens`).
let lwRowOpenAt: {[i32]: i32} = Map()
// The row-opening node a pending temp's definition is, by temp: its row opens where it is written.
let lwRowOpenTemp: {[i32]: i32} = Map()

export function irLMiss(why: string) {
  if lwMiss == "" { lwMiss = why }
  return 0
}

// A refusal a shared legacy helper raises while a claim lowers (`emitSoftMsg`, recorded only
// inside a claim seam) is the claim's miss, so it declines and legacy writes the unit.
function softMiss(name: string) {
  if emitSoftMsg != "" {
    irLMiss("a legacy helper refused in `" + name + "`: " + emitSoftMsg)
  }
  return 0
}

function varSlot(v: i32): i32 {
  if v < 0 || v >= lw.irVars.length { return -1 }
  const s = lw.irVars[v].vSlot
  return if s >= 0 { s } else if v < lwOwnedSlots.length { lwOwnedSlots[v] } else { -1 }
}

// By variable, the local `ownedSlot` gives a slotless variable the builder assigns outside a valued
// frame, else -1.
let lwOwnedSlots: i32[] = []

// A local of its own for slotless local `v` at its assignment, declared at its rep's valtype and
// keyed by `v`, so no other holder shares it; -1 where its rep writes no valtype.
function ownedSlot(v: i32): i32 {
  if v < 0 || v >= lw.irVars.length || lw.irVars[v].vKind != "local" {
    return -1
  }
  const vt = repLocalValtype(lw.irVars[v].vRep)
  if vt.length == 0 { return -1 }
  const s = irOnceSlotAt(vt, v + 1)
  while lwOwnedSlots.length <= v { lwOwnedSlots.push(-1) }
  lwOwnedSlots[v] = s
  return s
}

// The valtype bytes legacy's `fbValtype` declares a non-null value of rep `r` at, a ref list's or a
// closure's as `refRepValtype` keys it; none for a nullable rep, one with no kind, or a ref list or
// closure that keys no shape.
function repLocalValtype(r: i32): u8[] {
  const out: u8[] = []
  const d = repOfTy(repTyOf(r))
  const k = d.rdKind
  if k == null || d.rdNul != 0 && d.rdNul != 1 { return out }
  if k == "reflist" || k == "closure" {
    return if d.rdNul == 0 { refRepValtype(r) } else { out }
  }
  // A nullable reference (its null the bottom ref) is held at its nullable valtype.
  const prev = wTarget(out)
  if d.rdNul == 1 {
    fbValtypeNullable(k, d.rdSlot)
  } else {
    fbValtype(k, d.rdSlot)
  }
  wTarget(prev)
  return out
}

function tempDefined(v: i32): boolean {
  return v >= 0 && v < lwTempDef.length && lwTempDef[v]
}

function tempRhs(v: i32): Rhs {
  // A staged temp is a value on the stack, which no reader may rewrite from its definition.
  if v >= 0 && v < lwStackVal.length && lwStackVal[v] {
    const none: Rhs = { ggSym: -1, ggNonNull: false, ggNn: -1 }
    return none
  }
  if v >= 0 && v < lwTempRhs.length { return lwTempRhs[v] }
  const none: Rhs = { ggSym: -1, ggNonNull: false, ggNn: -1 }
  return none
}

// Marks `v`'s one use; false when its use is already taken.
function takeUse(v: i32): boolean {
  if v < 0 || v >= lwTempUsed.length || lwTempUsed[v] { return false }
  lwTempUsed[v] = true
  return true
}

function isTemp(v: i32): boolean {
  return v >= 0 && v < lw.irVars.length && lw.irVars[v].vKind == "temp"
}

// Consumes operand `o` without writing it, as legacy skips a receiver a live hoist already holds:
// a temp's one use is taken in its order and its right-hand side never written; a variable
// reads nothing.
export function irLSkip(o: Opnd) {
  if o is OVar && o.ov >= 0 && o.ov < lwStackVal.length && lwStackVal[o.ov] {
    return irLMiss("staged operand skipped")
  }
  if o is OVar && isTemp(o.ov) {
    if !tempDefined(o.ov) { return irLMiss("temp used before its definition") }
    if !takeUse(o.ov) { return irLMiss("non-stack temp: used twice") }
    // A field read's receiver, or a narrowed global read's box, is consumed first, as `irLOpnd`
    // writes it.
    const r = tempRhs(o.ov)
    if r is RGetField { irLSkip(r.gfV) }
    const base = lw.irSkipBase.get(o.ov) ?? -1
    if base >= 0 { irLSkip({ ov: base }) }
    lwSeq.push(o.ov)
  }
  return 0
}

// Writes operand `o`: a variable's `local.get`, an immediate's constant, or a temp's own
// right-hand side, written here at its one use.
export function irLOpnd(o: Opnd) {
  match o {
    OVar => {
      const v = o.ov
      if v >= 0 && v < lwStackVal.length && lwStackVal[v] {
        if !takeUse(v) { return irLMiss("non-stack temp: used twice") }
        if !liveTake(v) { return irLMiss("stack value read out of order") }
        lwSeq.push(v)
        return 0
      }
      if isTemp(v) {
        if !tempDefined(v) { return irLMiss("temp used before its definition") }
        if !takeUse(v) { return irLMiss("non-stack temp: used twice") }
        tempOpenNote(v)
        tempRhsWrite(v)
        lwSeq.push(v)
        return 0
      }
      const s = varSlot(v)
      if s < 0 { return irLMiss("unmapped slot") }
      leaf()
      const rf = lwBuf.length
      // A range loop copy's variable reads as legacy's copy reads it (`urLocalRead`).
      if !urLocalRead(s) { fbLocalGet(s) }
      // An arm-site payload standing for an element read banks that read's row (`emitIndexBanked`).
      const pk = lwPayloadVars.length - 1
      if pk >= 0 && v == lwPayloadVars[pk] && lwPayloadRows[pk] >= 0 {
        irLIndexRow(lwPayloadRows[pk], rf)
      }
      // A `shadow` arm's list is the frame's nullable list scratch, read non-null.
      if listFitShadowHolds(s) { fbRefAsNonNull() }
      // A staged `is` receiver held as a non-null string reads its nullable stash non-null.
      if isRecvStagedNonNull && s == isRecvStagedSlot { fbRefAsNonNull() }
    }
    OImm => {
      leaf()
      imm(o)
    }
    OStr => {
      leaf()
      strOpnd(o)
    }
  }
  return 0
}

// A string literal operand: at an atom rep its member's id, else legacy's literal writer.
function strOpnd(o: OStr) {
  const n = nodeAt(o.osAt)
  if repNodeAt(o.osRep) is RAtom && n is StrLit {
    return staticAtomId(n.strText)
  }
  return emitStrLitAt(o.osAt, lw.irAt)
}

// The bytes written since the top live value ended are stack-neutral, as a value set into a local
// is, so a read of that value still finds it on top.
function liveNeutral() {
  if lwLive.length > 0 { lwLiveEnd[lwLive.length - 1] = lwBuf.length }
  return 0
}

// Takes stack value `v` off the live stack when it is the lowest above the floor, the next a
// reader in order may take; false, leaving it, when it is not.
function liveTake(v: i32): boolean {
  const at = lwFloor + lwRootRun
  if !liveTakeOk(lwLive, lwLiveEnd, at, v, lwBuf.length) { return false }
  const rest: i32[] = []
  const ends: i32[] = []
  let i = 0
  while i < lwLive.length {
    if i != at {
      rest.push(lwLive[i])
      ends.push(lwLiveEnd[i])
    }
    i = i + 1
  }
  lwLive = rest
  lwLiveEnd = ends
  return true
}

// Whether `v` is the value at live index `at`, the next a reader in order may take, with no byte
// written past the top value's end (one would land above it, where legacy has it below).
function liveTakeOk(
  live: i32[],
  ends: i32[],
  at: i32,
  v: i32,
  bufLen: i32,
): boolean {
  if at >= live.length || live[at] != v { return false }
  return bufLen == ends[live.length - 1]
}

// How many roots `stageLead` leaves below the floor while it stages one above them; 0 otherwise.
let lwRootRun = 0
// The outer stagings' runs, as `lwFloors` holds the outer floors.
let lwRootRuns: i32[] = []

// Puts value `v`, just written, on the live stack.
function livePush(v: i32) {
  lwStackVal[v] = true
  lwLive.push(v)
  lwLiveEnd.push(lwBuf.length)
  return 0
}

// Before a value that reads no operand: one written while a valued `if`'s value waits on the
// stack lands above it, out of order.
function leaf() {
  if lwLive.length > lwFloor && !lwPushing {
    irLMiss("operand above a valued if's value")
  }
}

function imm(o: OImm) {
  const p = repPrim(o.oiRep)
  if p == null { return irLMiss("immediate rep") }
  match p {
    "i32" | "bool" => fbI32Const(o.oiBits as% i32)
    "i64" => fbI64Const((o.oiBits >> 32) as% i32, o.oiBits as% i32)
    "f32" => fbF32ConstBits(o.oiBits)
    "f64" => fbF64ConstBits(o.oiBits)
    "str" | "u8" | "null" | "v128" => irLMiss("immediate at " + p)
  }
  return 0
}

function primOp(r: RPrimOp) {
  const a = r.poArgs
  if a.length == 0 { return irLMiss("operandless op") }
  // A `boolean | null` niche compares at its i32 cell, as a bool does.
  const niche: RpPrim = "bool"
  const p = if repBoolNiche(opRepOf(a[0])) { niche } else { repPrim(opRepOf(a[0])) }
  if p == null { return irLMiss("op over a non-primitive") }
  const ps: string = p
  // A negated float literal is the literal with its sign bit flipped, as legacy writes it.
  if r.poOp == "neg" && (ps == "f64" || ps == "f32") {
    const x = a[0]
    if x is OImm {
      const one: i64 = 1
      const sign = if ps == "f64" { one << 63 } else { one << 31 }
      const flipped: Opnd = { oiRep: x.oiRep, oiBits: x.oiBits ^ sign }
      return irLOpnd(flipped)
    }
  }
  // A negated integer literal is the literal's own negative constant.
  if r.poOp == "neg" && (ps == "i32" || ps == "i64") {
    const x = a[0]
    if x is OImm {
      const neg: Opnd = { oiRep: x.oiRep, oiBits: 0 - x.oiBits }
      return irLOpnd(neg)
    }
    // Legacy's `0 - x`.
    if ps == "i32" {
      fbI32Const(0)
      irLOpnd(x)
      fbI32Bin(107) // i32.sub
    } else {
      fbI64Const(0, 0)
      irLOpnd(x)
      fbI32Bin(125) // i64.sub
    }
    return 0
  }
  // Float `%` has no instruction: legacy's call into `__f64_rem__`, f32 widened and narrowed.
  if r.poOp == "rem" && (ps == "f32" || ps == "f64") {
    return floatRem(a, ps == "f32")
  }
  for x in a { irLOpnd(x) }
  const code = primOpcode(r.poOp, p)
  if code < 0 { return irLMiss(r.poOp + " over " + ps) }
  fbI32Bin(code)
}

function floatRem(a: Opnd[], atF32: boolean) {
  if gHelpF64Rem < 0 || a.length != 2 { return irLMiss("float rem helper") }
  for x in a {
    irLOpnd(x)
    f64RemOperandTail(atF32)
  }
  return f64RemCallTail(atF32)
}

// Whether global `g` has the cell a pre-pass assigns before any body is emitted, or is an
// `extern` binding whose import index the parse fixed (`userGlobalIdx`).
function globalMinted(g: i32): boolean {
  if g < 0 || g >= gCellIdx.length { return false }
  if gCellIdx[g] >= 0 { return true }
  return g < globalStmts.length && externGlobalLinkOfNode(globalStmts[g]) >= 0
}

function opRepOf(o: Opnd): i32 {
  return match o {
    OVar => if o.ov >= 0 && o.ov < lw.irVars.length { lw.irVars[o.ov].vRep } else { -1 }
    OImm => o.oiRep
    OStr => o.osRep
  }
}

// A call, in its tail form when `tail` and the callee returns; a never-returning callee's call is
// followed by `unreachable` instead.
function call(c: RCall, tail: boolean) {
  // A claimed function's legacy never runs, so every index it names must already exist.
  if c.caCallee < 0 || c.caCallee >= fnStmts.length {
    return irLMiss("callee index")
  }
  if c.caArgs.length == 0 || c.caEnv { leaf() }
  if c.caEnv { fbRefNullStruct() }
  for a in c.caCaps { irLOpnd(a) }
  for a in c.caArgs { irLOpnd(a) }
  // A call whose callee hands captures back is followed by their sets, so it is never a tail,
  // except a lifted function's call of itself (`liftSelfTail`).
  if tail && !c.caNever && (c.caWb.length == 0 || liftSelfTail(c)) {
    fbReturnCall(gImports + c.caCallee)
  } else {
    fbCall(gImports + c.caCallee)
    let j = c.caWb.length - 1
    while j >= 0 {
      const w = varSlot(c.caWb[j])
      if w < 0 { return irLMiss("call write-back slot") }
      fbLocalSet(w)
      j = j - 1
    }
    if c.caNever { fbUnreachable() }
  }
  return 0
}

// The slot and depth each `RCallRefHead` written and not yet read left for its `RCallRef`; heads
// nest as their calls do.
let lwHeadSlot: i32[] = []
let lwHeadDepth: i32[] = []

// `RCallRefHead`: the closure, its stash and its env, as `callRef` writes them before its arguments.
function callRefHead(r: RCallRefHead) {
  irLOpnd(r.chFn)
  const d = callRefDepth
  const s = callRefStash()
  callRefEnvOpen(s, d)
  lwHeadSlot.push(s)
  lwHeadDepth.push(d)
  return 0
}

// `RCallRef`: the closure, then legacy's shared head and tail around the arguments
// (`callRefStash`, `callRefEnvOpen`, `callRefCallTail`); a never call has no tail form and is
// followed by `unreachable`, as `emitCall` writes it.
function callRef(r: RCallRef, tail: boolean) {
  irLOpnd(r.crFn)
  // A staged head wrote the callee, stash and env already, and left its slot and depth.
  const d = if r.crHead { lwHeadDepth.pop() ?? -1 } else { callRefDepth }
  const s = if r.crHead { lwHeadSlot.pop() ?? -1 } else { callRefStash() }
  if s < 0 || d < 0 { return irLMiss("call_ref head") }
  if !r.crHead { callRefEnvOpen(s, d) }
  for a in r.crArgs { irLOpnd(a) }
  callRefDepth = d
  callRefCallTail(s, r.crSig, tail && !r.crNever)
  if r.crNever { fbUnreachable() }
  return 0
}

function rhs(r: Rhs, tail: boolean) {
  match r {
    RPrimOp => primOp(r)
    RCall => call(r, tail)
    RGlobalGet => globalGetRhs(r)
    RMapGetOr => mapGetOr(r)
    RMapGet => {
      const from = irLAt()
      const got = mapGet(r)
      if r.mtBox < 0 && !r.mtTrap && r.mtRow { irLIndexRow(r.mtAt, from) }
      got
    }
    RMapHas => mapHas(r)
    RMapClear => irLMiss("map clear value")
    RMapDelete => mapDelete(r)
    RMapEq => mapEq(r)
    RMapIter => mapIter(r)
    RPrint => irLMiss("print value")
    RPrintOpen => irLMiss("print open value")
    RNumUnionBin => numUnionBin(r)
    RNumUnionConvert => {
      // Legacy stashes the box one dispatch level deeper, then converts at its member.
      const key = numUnionStashEnter()
      irLOpnd(r.nuV)
      const bs = numUnionStashTail(true, -1, key)
      numUnionStashLeave()
      numUnionConvertTail(r.nuAt, r.nuTo, lw.irAt, bs)
    }
    RNumIntr => {
      for a in r.nxArgs { irLOpnd(a) }
      match r.nxSel {
        "op" => numIntrTail(r.nxOp)
        "abs" => intSelTail("abs", r.nxWide)
        "min" => intSelTail("min", r.nxWide)
        "max" => intSelTail("max", r.nxWide)
      }
    }
    RSimd => simd(r)
    RTagStash => irLMiss("tag stash as a value")
    RStashSet => irLMiss("stash set as a value")
    RListEmpty => listEmpty(r)
    RListEmptyArms => listEmptyArms(r)
    RListIsAcross => listIsAcross(r)
    RListFitIs => listFitIs(r)
    RLitArms => litArms(r)
    RNumIs => numIs(r)
    RIsStaged => isStaged(r)
    RTagIs => {
      leaf()
      tagIsTail(r.tgiId)
    }
    RCoalAtomStr => {
      const e = nodeAt(r.zaAt)
      if !(e is BinExpr) { return irLMiss("atom coalesce node") }
      coalAtomStrReserve()
      irLOpnd(r.zaL)
      coalAtomStrOpen(e)
      irLOpnd(r.zaD)
      coalAtomStrClose(e, lw.irAt)
    }
    RCoalStr => {
      coalNulRefOpen(sTy(), coalesceNulStrStaysNullable(r.czAt, lw.irAt))
      irLOpnd(r.czL)
      coalNulRefBranch()
      irLOpnd(r.czD)
      fbEnd()
    }
    RCoerce |
      RListCat |
      RListEq |
      RListGet |
      RListLen |
      RListPop |
      RListPush |
      RListPushMany |
      RListSlice |
      RMapFilter |
      RStrOp => irLowerListHook(r)
    RStructEq => structEq(r)
    REqHelp => eqHelp(r)
    RListClear => irLMiss("clear value")
    RListStage => irLMiss("receiver stage value")
    RMapFilterHead => irLMiss("map head value")
    RNumWiden => {
      irLOpnd(r.nwV)
      if numNarrows(r.nwSrc, r.nwDst) {
        numNarrowTail(r.nwSrc, r.nwDst)
      } else {
        numWidenTail(r.nwSrc, r.nwDst, r.nwAt, lw.irAt)
      }
    }
    RNumCast => {
      irLOpnd(r.ncV)
      if r.ncMiss is OVar && r.ncMiss.ov < 0 {
        numCastTail(r.ncAt, lw.irAt)
      } else {
        numCastMissTail(r)
      }
    }
    // The cell's re-read, then the opcode narrowing it back, as `emitAsgValue` writes it.
    RAsgUnwiden => {
      irLOpnd(r.uwV)
      wU8(r.uwOp)
    }
    RAsgParked => asgParked(r)
    RRecDown => {
      irLOpnd(r.rdV)
      asgWiderRowTail(r.rdAt, lw.irAt)
    }
    ROptRead => optRead(r)
    RToBox => boxOp(r)
    RDeadNever => {
      // Legacy's `emitExpr` writes `unreachable` for the value, and its consumer goes on.
      leaf()
      fbUnreachable()
      if r.dnPad { fbUnreachable() }
    }
    RHoleOptBox => {
      // Legacy writes the box's tag, then the operand's plain cast, then the two boxes.
      leaf()
      holeOptBoxHead(r.hxAt)
      irLOpnd(r.hxV)
      holeOptBoxTail(r.hxAt)
    }
    RAtomStr => {
      irLOpnd(r.sxV)
      atomStrTail(atomStrPlanOf(r.sxAt, lw.irAt, false))
    }
    RAtomEq => atomEq(r)
    RAfterEffects => {
      for e in r.aeEff {
        irLOpnd(e)
        fbDrop()
      }
      irLOpnd(r.aeV)
    }
    RAsTail => {
      irLOpnd(r.akV)
      if asLitTail(r.akAt, lw.irAt) < 0 { return irLMiss("literal cast tail") }
    }
    RAsUnion => {
      irLOpnd(r.auV)
      if emitAsUnionTagged(r.auAt, lw.irAt) < 0 {
        return irLMiss("union cast tail")
      }
    }
    RUnionConcreteEq => unionConcreteEqOp(r)
    RUnionEq => unionEq(r)
    RUnionVariantEq => unionVariantEq(r)
    RUnionStagedEq => unionStagedEq(r)
    RUnionStage => irLMiss("union stage as a value")
    RUnionNumCrossEq => unionNumCrossEq(r)
    RRetag => irLOpnd(r.rgV)
    RStage => irLOpnd(r.sgV)
    RNulTest => nulTestOp(r)
    RNulNoneBox => {
      // A late box (`irBoxLate`): the call held in an `anyref` once-slot, then the null tag.
      if r.nnPay && i32ListHas(lw.irBoxLate, unwrapParen(r.nnAt)) {
        irLOpnd(r.nnV)
        const any: u8[] = [VT_ANYREF]
        const s = irOnceSlot(any)
        fbLocalSet(s)
        nulNoneBoxHead()
        fbLocalGet(s)
        return nulNoneBoxTail()
      }
      // Legacy's null tag, the payload (the call, else the bottom ref), then the box.
      leaf()
      nulNoneBoxHead()
      if r.nnPay {
        irLOpnd(r.nnV)
      } else {
        leaf()
        fbRefNullNone()
      }
      nulNoneBoxTail()
    }
    RNulNicheEq => nulNicheEq(r)
    RClosureEq => closureEq(r)
    RIdentityEq => identityEq(r)
    RFieldNull => {
      leaf()
      if emitOmittedFieldNull(r.fnRow, r.fnFi) < 0 {
        return irLMiss("field typed null")
      }
    }
    RNullOf => {
      // A shared cell's read banks its element-read row over the null, as legacy's
      // `emitIndexBanked` does; an element read written for its effects first banks none of its own.
      const cellRead = r.nuAt >= 0
        && r.nuAt < P.nodes.length
        && nodeAt(r.nuAt) is Index
      const from = if cellRead { irLIndexFrom(r.nuAt, irLAt()) } else { -1 }
      if r.nuRead.length > 0 {
        if cellRead { lwIdxRowMutes.push(r.nuAt) }
        irLOpnd(r.nuRead[0])
        if cellRead { lwIdxRowMutes.pop() }
        fbDrop()
      } else {
        leaf()
      }
      emitNullOwn(r.nuOwn)
      if cellRead { irLIndexRow(r.nuAt, from) }
    }
    RJoinNull => {
      leaf()
      if fbRefNullOfKind(r.jnKind, r.jnSlot) < 0 {
        return irLMiss("join null heap")
      }
    }
    RRetNull => {
      // The builder misses a function with no null plan; the lowering holds the same line itself.
      const plan = nullRetPlanOf(lw.irAt)
      if plan == null { return irLMiss("returned null with no plan") }
      leaf()
      emitNullRetTail(plan)
    }
    RTest => {
      irLOpnd(r.teV)
      boxTagIsTail(r.teTag)
    }
    RRecordFitIs => irFitTail(r.rfV, r.rfAt, -1, true)
    RVariantChain => irFitTail(r.vcV, r.vcAt, r.vcVi, false)
    RVariantDiscrim => variantDiscrim(r)
    RBoxField => boxField(r)
    RSharedRead => sharedRead(r)
    RSharedFieldSet => irLMiss("shared field store value")
    RBoxNarrow => boxNarrow(r)
    RNicheRead => nicheRead(r)
    RArmUnbox => armUnbox(r)
    RRecCopyPure => recCopyPure(r)
    RRecover => recoverRead(r)
    RGetField => getField(r)
    RCallRef => callRef(r, tail)
    RCallRefHead => callRefHead(r)
    RMakeRec => makeRec(r)
    RMapOp => mapOp(r)
    RListNew => listNew(r)
    RListNewDefault => listNewDefault(r)
    RListCopy => irLMiss("list copy value")
    RMemAccess => memAccess(r)
    RMaFoldInit => maFoldInit(r)
    RAtomic => atomic(r)
    RTruncSat => truncSat(r)
    RMemOp => memOp(r)
    RCallHost => hostCall(r)
    RCast => {
      // `as!` over a nullable-ref niche: `ref.as_non_null` traps on the miss (D1812).
      if r.ctOnFail != "trap" { return irLMiss("cast to null") }
      irLOpnd(r.ctV)
      fbRefAsNonNull()
    }
    RCellGet |
      RCellNew |
      RFnId |
      RMapSet |
      RTagOf => irLMiss("rhs outside I1")
    RAtomSole => strToAtomSoleTail(r.asAt)
    RDeadNullTest => {
      irLOpnd(r.dnV)
      fbDrop()
      fbI32Const(r.dnBits as% i32)
    }
    RAtomWide => {
      irLOpnd(r.awV)
      strToAtomWideTail(r.awAt)
    }
    RStrToAtom => strToAtomTower(r)
    RStrToAtomStaged => {
      irLOpnd(r.zsV)
      strToAtomStagedTail(r.zsAt, lw.irAt)
    }
    RMakeClo => makeClo(r)
    REnvGet => envGet(r)
    REnvDrop => irLMiss("env drop as a value")
    RInitProgress => irLMiss("init progress as a value")
    RBundlePick => bundlePick(r)
    RResultPick => resultPick(r)
    RHandPick => handPick(r)
    RHolderPick => holderPick(r)
    RMakeList => makeList(r)
    RSpread => spreadList(r)
    RMapNew => {
      leaf()
      emitMapNew(r.mnAt, lw.irAt)
    }
    RRawOp => rawOp(r)
    RRel => {
      leaf()
      fbI32RelOf(r.rlSp, r.rlSub, r.rlVal)
    }
  }
  return 0
}

// A helper's raw value instruction: its operands, then the one writer it names.
function rawOp(r: RRawOp) {
  if r.rwOp == "tag64" {
    const k = r.rwArgs[0]
    const s = if k is OVar { varSlot(k.ov) } else { -1 }
    if s < 0 { return irLMiss("tag64 of a non-variable") }
    leaf()
    return fbMapTagOfI64(s)
  }
  if r.rwArgs.length == 0 { leaf() }
  for a in r.rwArgs { irLOpnd(a) }
  const h = r.rwHeap
  match r.rwOp {
    "struct.get" => fbStructGet(h, r.rwImm)
    "struct.new" => fbStructNew(h)
    "array.get" => fbArrayGet(h)
    "array.new_default" => fbArrayNewDefault(h)
    "array.len" => fbArrayLen()
    "ref.eq" => fbRefEq()
    "ref.cast" => fbRefCast(h)
    "ref.as_non_null" => fbRefAsNonNull()
    "ref.null" => fbRefNull(h)
    "ref.is_null" => fbRefIsNull()
    "call" => fbCall(r.rwImm)
    "test" => 0
    "load" => fbI32Load()
    "tag64" => 0
    "push" => irLMiss("push read as an operand")
    "ref.test" => fbRefTest(h)
    "select" => fbSelect()
    "tee" => {
      const s = varSlot(r.rwImm)
      if s < 0 { return irLMiss("unmapped slot") }
      fbLocalTee(s)
    }
  }
  return 0
}

// A helper's `push`: its variable or immediate written where it is defined, kept on the stack
// below whatever the body computes next, for a later effect whose leading operands the pushes are.
function pushNow(dst: i32, r: RRawOp) {
  if !lw.irHelper || r.rwArgs.length != 1 || r.rwArgs[0] is OStr {
    return irLMiss("push")
  }
  lwPushing = true
  irLOpnd(r.rwArgs[0])
  lwPushing = false
  lwPushed.push(dst)
  return 0
}

// The temps `push` wrote and no effect has consumed yet, in push order, and whether a push is
// being written, which may sit above a valued `if`'s value by design.
let lwPushed: i32[] = []
let lwPushing = false

// A helper's raw instruction that yields nothing; `array.copy`'s source heap is its `srImm`. Its
// pushed operands, if any, are its leading ones, in push order.
function rawEff(n: SRawOp, pending: i32[], at: i32) {
  lwSeq = []
  let k = 0
  const queued = lwPushed.length
  while k < n.srArgs.length && k < queued {
    const a = n.srArgs[k]
    if !(a is OVar) || a.ov != lwPushed[k] { break }
    takeUse(a.ov)
    k = k + 1
  }
  if k < queued { return irLMiss("push not consumed first") }
  lwPushed = []
  while k < n.srArgs.length {
    irLOpnd(n.srArgs[k])
    k = k + 1
  }
  irLSettle(pending)
  const h = n.srHeap
  match n.srOp {
    "struct.set" => fbStructSet(h, n.srImm)
    "array.set" => fbArraySet(h)
    "array.copy" => fbArrayCopy(h, n.srImm)
    "array.init_data" => fbArrayInitData(h, n.srImm)
    "array.fill" => fbArrayFill(h)
    "call" => fbCall(n.srImm)
    "reserve.open" => reserveOpen(n, at)
    "reserve.close" => listBuildClose(n.srImm)
    "sink.put" | "sink.null" | "sink.close" => sinkPairOp(n)
    "as.fail" => asFailReport(n.srImm)
  }
  return 0
}

// A union binding sink's pair write (`emitUnionIfBindingSink`): an arm's box into the pair, the
// missing `else`'s null into it, or the binding's one box built from it into variable `srImm`.
function sinkPairOp(n: SRawOp) {
  if n.srOp == "sink.null" { return emitUnionNullToPair() }
  const idx = varSlot(n.srImm)
  if idx < 0 { return irLMiss("unmapped slot") }
  if n.srOp == "sink.put" { return unionBoxToPairTail(idx) }
  return unionLetSinkClose(idx)
}

// `reserve.open` after `let` `at` (statement `srHeap` of its block) stored variable `srImm`:
// legacy's reserve, over the statements that follow it.
function reserveOpen(n: SRawOp, at: i32) {
  const s = nodeAt(at)
  if !(s is LetDecl) { return irLMiss("reserve node") }
  // A function's reserve is over its body; the start body's (`fnIx` -1) over the program.
  const fnIx = lw.irAt
  const fn = if fnIx >= 0 && fnIx < P.nodes.length { nodeAt(fnIx) } else { null }
  const root = if fn is FuncDecl { fn.fnBody } else if fnIx < 0 { emitRootIx } else { -1 }
  if root < 0 { return irLMiss("reserve body") }
  const sibs = stmtsHolding(root, at, n.srHeap)
  if sibs.length == 0 { return irLMiss("reserve block") }
  // The frame's slot for the `let`, the key legacy's `emitLetDecl` passes.
  const slot = declaredSlotOfDecl(at)
  if slot < 0 { return irLMiss("reserve slot") }
  const idx = varSlot(n.srImm)
  if idx < 0 || idx != declaredIndexAt(fnIx, slot) {
    return irLMiss("reserve slot")
  }
  return listReserveOpen(s, sibs, n.srHeap, idx, slot, fnIx)
}

// The statement list under `root` whose statement `pos` is `ix`, or none.
function stmtsHolding(root: i32, ix: i32, pos: i32): i32[] {
  if root < 0 { return [] }
  const n = nodeAt(root)
  if n is Block && pos < n.blkStmts.length && n.blkStmts[pos] == ix {
    return n.blkStmts
  }
  if n is Program && pos < n.progStmts.length && n.progStmts[pos] == ix {
    return n.progStmts
  }
  for k in nodeChildren(root) {
    const got = stmtsHolding(k, ix, pos)
    if got.length > 0 { return got }
  }
  return []
}

// The row a record literal at `at` is written at: its destination's `rowIn` (a variant's where
// `variant`), else its own, under the order stash where `stash`; -1 for none.
function recRowOf(at: i32, rowIn: i32, variant: boolean, stash: boolean): i32 {
  const fnIx = lw.irAt
  if rowIn >= 0 && variant {
    return if stash { variantStashRowAt(at, rowIn, fnIx) } else { objLitVariantLayoutAt(at, rowIn) }
  }
  if rowIn >= 0 {
    return if stash { structStashRowAt(at, rowIn) } else { objLitLayoutRowAt(at, rowIn) }
  }
  if variant {
    return if stash { variantStashRowAt(at, objLitBuildVariantRow(at, fnIx), fnIx) } else { objLitVariantLayoutOf(at, fnIx) }
  }
  return if stash { structStashRowAt(at, structIndexOfObjCtx(at, fnIx)) } else { objLitLayoutRowOf(at, fnIx) }
}

// The variant row a stashed literal at `at` is written at, row `vi`: the order stash's, else the
// one a dropped effectful field takes (`objLitVariantDropStashAt`).
function variantStashRowAt(at: i32, vi: i32, fnIx: i32): i32 {
  const r = objLitVariantStashAt(at, vi)
  return if r >= 0 { r } else { objLitVariantDropStashAt(at, vi, fnIx) }
}

// The struct row a stashed literal at `at` is written at, row `si`: the order stash's, else the
// one a dropped field takes (`objLitDropStashRowAt`).
function structStashRowAt(at: i32, si: i32): i32 {
  const r = objLitStashRowAt(at, si)
  return if r >= 0 { r } else { objLitDropStashRowAt(at, si) }
}

// `RMakeRec`: each field in layout order, then legacy's `struct.new` of the literal's row. Under
// the order stash, each field in source order into its scratch slot first, read back in layout;
// for `mrSet` its `RStashSet`s set the slots, and it only reads them back.
function makeRec(r: RMakeRec) {
  const variant = recIsVariant(r)
  const stash = r.mrSrc.length > 0
  // The row the builder built the fields by: the plain or stash layout, or a row omitting fields.
  const row = if r.mrBuiltRow >= 0 { r.mrBuiltRow } else { recRowOf(r.mrAt, r.mrRow, variant, stash) }
  if row < 0 { return irLMiss("record row") }
  if r.mrSet { return makeRecStashed(r, row, variant) }
  if r.mrFields.length == 0 { leaf() }
  if stash { return makeRecStashFields(r, row, variant) }
  for k in r.mrLayout {
    if k < 0 || k >= r.mrFields.length { return irLMiss("record layout") }
    irLOpnd(r.mrFields[k])
  }
  return if variant { variantStructNewTail(row) } else { objStructNewTail(row) }
}

// `emitObj`'s and `emitVariantStruct`'s order stash read back: every slot its `RStashSet`s set,
// in layout order, then the row's `struct.new`.
function makeRecStashed(r: RMakeRec, row: i32, variant: boolean) {
  let fi = 0
  while fi < r.mrLayout.length {
    const s = stashSlotOf(r.mrAt, fi)
    if s < 0 { return irLMiss("record stash") }
    fbLocalGet(s)
    fi = fi + 1
  }
  return if variant { variantStructNewTail(row) } else { objStructNewTail(row) }
}

// `emitObj`'s and `emitVariantStruct`'s order stash for `r` at `row`: each field in source order
// set into the slot `objOrderStashSlot` opens for it, then every slot read in layout order.
function makeRecStashFields(r: RMakeRec, row: i32, variant: boolean) {
  const slots: i32[] = []
  for _k in r.mrLayout { slots.push(-1) }
  for k in r.mrSrc {
    let fi = 0
    while fi < r.mrLayout.length && r.mrLayout[fi] != k { fi = fi + 1 }
    if fi >= r.mrLayout.length || k < 0 || k >= r.mrFields.length {
      return irLMiss("record stash")
    }
    irLOpnd(r.mrFields[k])
    const slot = stashSlotAt(row, fi, variant)
    slots[fi] = slot
    fbLocalSet(slot)
  }
  for s in slots {
    if s < 0 { return irLMiss("record stash") }
    fbLocalGet(s)
  }
  return if variant { variantStructNewTail(row) } else { objStructNewTail(row) }
}

// The slot `objOrderStashSlot` opens for layout position `fi` of record row `row`.
function stashSlotAt(row: i32, fi: i32, variant: boolean): i32 {
  return if variant { objOrderStashSlot(
    variantFieldStorageKind(row, fi),
    variantFieldTypeAt(row, fi),
    uFieldStorageSlot(row, fi),
  ) } else { objOrderStashSlot(
    fieldRowStorageKind(sFieldFlatRow(row, fi)),
    sFieldTypeAt(row, fi),
    sFieldStorageSlot(row, fi),
  ) }
}

// `RStashSet`: the field's value, then `local.set` into the slot `objOrderStashSlot` opens for it,
// in source order as legacy's `emitObj` and `emitVariantStruct` call it.
function stashSet(r: RStashSet) {
  const row = recRowOf(r.ssAt, r.ssRow, r.ssVariant, true)
  if row < 0 { return irLMiss("record row") }
  const fi = r.ssFi
  if !i32ListHas(lwBoxHeadAt, r.ssAt) { stashBoxHead(r.ssAt) }
  irLOpnd(r.ssV)
  const slot = stashSlotAt(row, fi, r.ssVariant)
  lwStashAt.push(r.ssAt)
  lwStashFi.push(fi)
  lwStashSlots.push(slot)
  fbLocalSet(slot)
  return 0
}

// Where the order-stashed literal at `at` is boxed under a plan that writes a head, that head,
// ahead of the literal's first field (legacy writes the tag before the literal).
function stashBoxHead(at: i32) {
  for n in lw.irNodes {
    if !(n is SLet) { continue }
    const r = n.lRhs
    if !(r is RToBox) || unwrapParen(r.bxAt) != at { continue }
    const bx = r.bxAt
    const p = holeBoxPlanOf(bx, r.bxTy, lw.irAt)
    if p.hbArm == "rec" || p.hbArm == "obj" {
      leaf()
      holeBoxHead(p, bx, lw.irAt)
      lwBoxHeadAt.push(at)
    }
    return 0
  }
  return 0
}

// Where valued `if` node `id` is the first field an order-stashed literal sets, in either stash
// form, that literal's box head, ahead of the `if` (legacy writes the tag before the literal).
function stashIfBoxHead(id: i32) {
  const n = lw.irNodes[id]
  const out = if n is SIf { n.siOut } else if n is SCoalBox { n.cbOut } else { -1 }
  if out < 0 { return 0 }
  if !lwIfHeadBuilt { stashIfHeadsNote() }
  const at = lwIfHeadAt.get(out) ?? -1
  if at >= 0 && !i32ListHas(lwBoxHeadAt, at) { return stashBoxHead(at) }
  // A valued `if`'s box head follows the operands staged ahead of it (`valuedIfOpen`), as does a
  // `??`'s (`coalBox`).
  return 0
}

// Where node `id` opens a box-lead span, the temps earlier operands left pending, written first
// as legacy writes those operands before the box's leading tag; each stays for its reader.
function boxLeadStage(id: i32, pending: i32[]) {
  if pending.length == 0 { return 0 }
  let i = 0
  while i < lw.irBoxLeadFirst.length && lw.irBoxLeadFirst[i] != id { i = i + 1 }
  if i >= lw.irBoxLeadFirst.length { return 0 }
  const roots = stageLeadOf([], pending)
  if lwMiss != "" { return 0 }
  // The span writes above the roots until its box is written (`boxLeadUnstage`).
  lwFloors.push(lwFloor)
  lwFloor = lwLive.length
  lwLeadBoxes.push(lw.irBoxLeadBox[i])
  for r in roots { pending.push(r) }
  return 0
}

// After box node `id` is written, the floor its span's staging raised is lowered again.
function boxLeadUnstage(id: i32) {
  if lwLeadBoxes.length == 0 || lwLeadBoxes[lwLeadBoxes.length - 1] != id {
    return 0
  }
  lwLeadBoxes.pop()
  lwFloor = lwFloors.pop() ?? 0
  return 0
}

// Where node `id` opens a tag dispatch a box directly follows (`irBoxLeadFirst`), that box's head,
// ahead of the dispatch, as legacy writes the dispatch under the box's leading tag.
function dispatchBoxHead(id: i32) {
  let i = 0
  while i < lw.irBoxLeadFirst.length {
    if lw.irBoxLeadFirst[i] == id {
      return dispatchBoxHeadOf(lw.irBoxLeadBox[i])
    }
    i = i + 1
  }
  return 0
}

function dispatchBoxHeadOf(boxId: i32) {
  const n = lw.irNodes[boxId]
  if !(n is SLet) { return irLMiss("dispatch box node") }
  const r = n.lRhs
  if !(r is RToBox) { return irLMiss("dispatch box node") }
  const p = holeBoxPlanOf(r.bxAt, r.bxTy, lw.irAt)
  if !holeBoxLeads(p.hbArm) {
    return irLMiss("dispatch box with no leading head")
  }
  leaf()
  holeBoxHead(p, r.bxAt, lw.irAt)
  lwBoxHeadAt.push(unwrapParen(r.bxAt))
  return 0
}

// The head of the box whose value is join out `out`, ahead of the join, as legacy's box leads;
// `staged` where it lands above the operands an earlier argument staged for the join.
function joinBoxHead(out: i32, staged: boolean) {
  if !lwIfHeadBuilt { stashIfHeadsNote() }
  const bx = lwIfBoxAt.get(out) ?? -1
  // A late box (`irBoxLate`) writes its own head after its value.
  if (
    bx < 0
    || i32ListHas(lwBoxHeadAt, unwrapParen(bx))
    || i32ListHas(lw.irBoxLate, unwrapParen(bx))
  ) {
    return 0
  }
  const p = holeBoxPlanOf(bx, lwIfBoxTy.get(out) ?? -1, lw.irAt)
  if holeBoxHeadAhead(p.hbArm) {
    if staged { lwPushing = true } else { leaf() }
    holeBoxHead(p, bx, lw.irAt)
    lwPushing = false
    lwBoxHeadAt.push(unwrapParen(bx))
  }
  return 0
}

// Notes, once per function, the out each order-stashed literal's first source field reads, by
// that out: the literal (`stashIfBoxHead`).
function stashIfHeadsNote() {
  lwIfHeadBuilt = true
  const seen: i32[] = []
  // The var each numeric step converts, by the step's own var: a box of a step is keyed by the
  // value the steps start from, the join's out (`boxOfJoinAt`).
  const convSrc: {[i32]: i32} = Map()
  for m in lw.irNodes {
    const cs = numConvSrcOf(m)
    if cs >= 0 && m is SLet { convSrc.set(m.lDst, cs) }
  }
  for m in lw.irNodes {
    if m is SLet {
      const mr = m.lRhs
      if mr is RToBox {
        const bv = mr.bxV
        if bv is OVar {
          lwIfBoxAt.set(bv.ov, mr.bxAt)
          lwIfBoxTy.set(bv.ov, mr.bxTy)
          let src = convSrc.get(bv.ov) ?? -1
          while src >= 0 {
            lwIfBoxAt.set(src, mr.bxAt)
            lwIfBoxTy.set(src, mr.bxTy)
            src = convSrc.get(src) ?? -1
          }
        }
      }
      if mr is RMakeRec && !mr.mrSet && mr.mrSrc.length > 0 {
        const k0 = mr.mrSrc[0]
        const f0 = if k0 >= 0 && k0 < mr.mrFields.length { mr.mrFields[k0] } else { null }
        if f0 is OVar { lwIfHeadAt.set(f0.ov, mr.mrAt) }
      }
      continue
    }
    if !(m is SEffect) { continue }
    const r = m.efRhs
    if !(r is RStashSet) || i32ListHas(seen, r.ssAt) { continue }
    seen.push(r.ssAt)
    const sv = r.ssV
    if sv is OVar { lwIfHeadAt.set(sv.ov, r.ssAt) }
  }
  return 0
}

// The slot the `RStashSet` of the literal at `at`, layout position `fi`, set; -1 for none.
function stashSlotOf(at: i32, fi: i32): i32 {
  let i = lwStashSlots.length - 1
  while i >= 0 {
    if lwStashAt[i] == at && lwStashFi[i] == fi { return lwStashSlots[i] }
    i = i - 1
  }
  return -1
}

// `RMakeClo` through `mcFn`'s function-value cell: filled from the environment operands when null.
function makeCloCell(r: RMakeClo) {
  const fe = r.mcFn
  if emitCloCellRef(fe, lw.irAt) < 0 { return -1 }
  fbStructGet(cloCellIdx, 0)
  fbRefIsNull()
  fbIf(64) // void
  if emitCloCellRef(fe, lw.irAt) < 0 { return -1 }
  if makeCloEnv(r) < 0 { return -1 }
  emitClosureIds(fe)
  fbStructSet(cloCellIdx, 0)
  fbEnd()
  if emitCloCellRef(fe, lw.irAt) < 0 { return -1 }
  fbStructGet(cloCellIdx, 0)
  fbRefAsNonNull()
  return 0
}

// The fresh environment struct of `r.mcFn`: each capture's operand, a cell capture its cell.
function makeCloEnv(r: RMakeClo) {
  let k = 0
  for name in captureNamesOf(r.mcFn) {
    const cell = capCellTargetOf(name)
    if cell >= 0 {
      if emitCloCellRef(cell, lw.irAt) < 0 { return -1 }
    } else {
      if k >= r.mcEnv.length { return irLMiss("closure env") }
      irLOpnd(r.mcEnv[k])
      k = k + 1
    }
  }
  if k != r.mcEnv.length { return irLMiss("closure env") }
  fbStructNew(fnEnvIdxOf(r.mcFn))
  return 0
}

// `RMakeClo`: legacy's closure writer for a capture-free function, then a name read's recovery,
// as `emitExpr` writes a function literal or a function name.
// `RMakeClo` written where another node's lowering builds its closure (`RMapFilter`).
export function irLMakeClo(r: RMakeClo) { return makeClo(r) }

function makeClo(r: RMakeClo) {
  // A function-value cell this frame fills from its own operands (D7700): the first read builds
  // the closure into the cell, as `emitClosureValueOf` does, and every read loads it.
  const viaCell = fnEnvIdxOf(r.mcFn) >= 0 && cloCellReaches(r.mcFn, lw.irAt)
  if viaCell && r.mcEnv.length > 0 { return makeCloCell(r) }
  if fnEnvIdxOf(r.mcFn) >= 0 && !cloCellReaches(r.mcFn, lw.irAt) {
    // A fresh environment: its captures, as `emitClosureEnvOf` reads them, then the closure. A
    // function-value cell capture has no operand: it is legacy's read of the cell this frame reaches.
    const envIdx = fnEnvIdxOf(r.mcFn)
    // An environment this frame caches is built at its first read in an activation (D7480).
    const ck = envCacheSlotOfFe(r.mcFn)
    if ck >= 0 { emitEnvCacheOpen(ck) }
    let k = 0
    for name in captureNamesOf(r.mcFn) {
      const cell = capCellTargetOf(name)
      if cell >= 0 {
        if emitCloCellRef(cell, lw.irAt) < 0 { return -1 }
      } else {
        if k >= r.mcEnv.length { return irLMiss("closure env") }
        irLOpnd(r.mcEnv[k])
        k = k + 1
      }
    }
    if k != r.mcEnv.length { return irLMiss("closure env") }
    fbStructNew(envIdx)
    if ck >= 0 { emitEnvCacheClose(ck) }
    emitClosureIds(r.mcFn)
  } else {
    leaf()
    // The builder held the value to the refusal its arm owes, so the core writer is legacy's bytes
    // on either arm (`emitClosureValue` is the generic refusal, then the core).
    emitClosureValueCore(r.mcFn, lw.irAt)
  }
  if nodeAt(r.mcAt) is Ident && readOwesNonNullRecover(r.mcAt, lw.irAt) {
    fbRefAsNonNull()
  }
  return 0
}

// `RBundlePick`: the bundle parameter, then its member's field, as `emitBundleCall` reads it.
function bundlePick(r: RBundlePick) {
  const pk = bundlePickOf(r.bpAt, lw.irAt)
  if pk.bpField < 0 { return irLMiss("bundle pick") }
  irLOpnd(r.bpV)
  fbStructGet(pk.bpHeap, pk.bpField)
  return 0
}

// `RHandPick`: the bundle record read, then the member legacy's `emitBundleMemberPick` picks.
function handPick(r: RHandPick) {
  const pk = bundleMemberPickOf(
    r.hpArg,
    bundleHandMemberAt(r.hpAt, r.hpI, r.hpArg, lw.irAt),
    lw.irAt,
  )
  if pk.bpHeap < 0 { return irLMiss("hand pick") }
  irLOpnd(r.hpV)
  fbStructGet(pk.bpHeap, pk.bpField)
  return 0
}

// `RHolderPick`: the holder's record read, then the member legacy's `emitTypedHolderInit` picks.
function holderPick(r: RHolderPick) {
  const pk = bundleMemberPickOf(
    r.hkArg,
    typedHolderMember(r.hkAt, lw.irAt),
    lw.irAt,
  )
  if pk.bpHeap < 0 { return irLMiss("holder pick") }
  irLOpnd(r.hkV)
  fbStructGet(pk.bpHeap, pk.bpField)
  return 0
}

// `RResultPick`: the returned record, then the member legacy's `emitBundleResultPick` picks.
function resultPick(r: RResultPick) {
  const pk = bundleResultPickOf(r.rkAt, r.rkFe, lw.irAt)
  if pk.bpField < 0 { return irLMiss("result pick") }
  irLOpnd(r.rkV)
  fbStructGet(pk.bpHeap, pk.bpField)
  return 0
}

// `REnvGet`: legacy's read of a capture from the function's environment, recovered at the read.
function envGet(r: REnvGet) {
  leaf()
  const caps = captureNamesOf(fnStmtsPosOf(lw.irAt))
  if r.evSlot < 0 || r.evSlot >= caps.length { return irLMiss("env slot") }
  if emitCapturedRead(caps[r.evSlot], lw.irAt, r.evAt) != 1 {
    return irLMiss("env read")
  }
  return 0
}

// Why a read of user global `g` in context `c` is not the IR's to lower, or "" when it is: the
// builder asks before it builds the read, so a function holding one is never claimed.
export function irGlobalReadMiss(g: i32, c: GlobalCtx): string {
  return match userGlobalReadClass(g, c) {
    "plain" => if globalMinted(g) { "" } else { "global index" }
    "fold" => ""
    "promo" => if promoSlotIn(g, c) >= 0 { "" } else { "promoted global read" }
    "guard" => if globalMinted(g) { "" } else { "global index" }
  }
}

// Why a write of user global `g` in context `c` is not the IR's to lower, or "" when it is.
export function irGlobalWriteMiss(g: i32, c: GlobalCtx): string {
  return match userGlobalWriteClass(g, c) {
    "plain" => if globalMinted(g) { "" } else { "global index" }
    "promo" => if promoSlotIn(g, c) >= 0 { "" } else { "promoted global write" }
    "immutable" => "immutable global write"
    "guard" => if globalMinted(g) { "" } else { "global index" }
  }
}

// A read of user global `sym`, recovered to non-null for `nonNull`, as legacy reads its class.
function globalRead(sym: i32, nonNull: boolean) {
  match userGlobalReadClass(sym, lwGlobalCtx) {
    "plain" => {
      if !globalMinted(sym) { return irLMiss("global index") }
      leaf()
      fbGlobalGet(userGlobalIdx(sym))
      if nonNull { fbRefAsNonNull() }
    }
    "fold" => {
      leaf()
      emitFoldedConstRead(sym)
    }
    "promo" => {
      const ps = promoSlotIn(sym, lwGlobalCtx)
      if ps < 0 { return irLMiss("promoted global read") }
      leaf()
      fbLocalGet(ps)
    }
    // Legacy's read-before-init guard, then the read (`emitUserGlobalGet`).
    "guard" => {
      if !globalMinted(sym) { return irLMiss("global index") }
      leaf()
      if emitInitGuard(sym, "read") < 0 {
        return irLMiss("guarded global read")
      }
      fbGlobalGet(userGlobalIdx(sym))
      if nonNull { fbRefAsNonNull() }
    }
  }
  return 0
}

// The arm `RNulTest` `r` lowers at: a `== null` compare's, or an `is` test's niche-only one, as
// legacy's `emitIsArm` asks it; null for any other node.
function nulTestOpArm(r: RNulTest): NulTestArm | null {
  if r.ntAt < 0 || r.ntAt >= P.nodes.length { return null }
  const n = nodeAt(r.ntAt)
  if n is IsExpr { return nulTestArmOf(n.isObj, lw.irAt, r.ntInvert, true) }
  if !(n is BinExpr) { return null }
  const bt = binNulTestOf(n)
  if bt != null { return nulTestArmOf(bt.bnRef, lw.irAt, r.ntInvert, false) }
  // A name read typed `null` against a nullable tests the other operand (`binNulNameTestOf`).
  const nt = binNulNameTestOf(n, lw.irAt)
  if nt == null { return null }
  return nulTestArmOf(nt.bnRef, lw.irAt, r.ntInvert, false)
}

// `RNulTest`: the operand, then legacy's tail for the arm `nulTestArmOf` names: the atom
// sentinel's compare, a nullable ref's `ref.is_null`, or a union box's null tag compare.
function nulTestOp(r: RNulTest) {
  const arm0 = nulTestOpArm(r)
  if arm0 == null { return irLMiss("null test node") }
  // An optional chain built once as its value is tested at that value's own rep.
  const arm = if arm0 == "optChain" { repNulTestArm(opRepOf(r.ntV)) } else { arm0 }
  if arm == "atom" {
    irLOpnd(r.ntV)
    return nulTestAtomTail(r.ntInvert)
  }
  if arm == "nullRef" || arm == "nulStr" {
    irLOpnd(r.ntV)
    return nulTestRefTail(r.ntInvert)
  }
  if arm == "bool" {
    irLOpnd(r.ntV)
    return nulTestBoolTail(r.ntInvert)
  }
  if arm == "boxTag" {
    irLOpnd(r.ntV)
    return nulTestBoxTagTail(r.ntInvert)
  }
  // The builder makes `RNulTest` only at the five arms above.
  return irLMiss("null test " + arm)
}

// The null test a nullable value at rep `vr` takes by its discipline: a ref's or string's
// `ref.is_null`, a boolean's or atom's sentinel, a union box's tag; "none" for a rep with none.
function repNulTestArm(vr: i32): NulTestArm {
  const n = repNodeAt(vr)
  if n is RBox { return "boxTag" }
  if !(n is RNullable) { return "none" }
  return if n.rnDisc == 1 { "nullRef" } else if n.rnDisc == 2 { "bool" } else if n.rnDisc == 3 { "atom" } else if n.rnDisc == 4 { "boxTag" } else { "none" }
}

// `RListEmpty`: the list, then legacy's emptiness walk over the slots and kind its plan names.
function listEmpty(r: RListEmpty) {
  const p = emptyFitPlanOf(r.leAt, lw.irAt)
  const shadow = p.efArm == "shadow"
    && r.leFit >= 0
    && r.leFit < lw.irVars.length
  if p.efArm != "loop" && !shadow || p.efRepWhy != "" {
    return irLMiss("list empty plan")
  }
  // The arm's empty `K[]` is stored first, and its local is the region's variable.
  // A pushing arm's (`listFitShadowSet` 2) tests only until its grow row's `K[]` is stored.
  let grow = -1
  if shadow {
    const sh = listFitShadowSet(r.leAt, p.efRecvTy, p.efDepth, lw.irAt)
    if sh == 2 { grow = listFitGrowOf(r.leAt, lw.irAt) }
    if sh != 1 && grow < 0 { return irLMiss("list fit shadow store") }
    const loc = listFitShadowLocalOf(r.leAt, lw.irAt)
    if loc < 0 { return irLMiss("list fit shadow local") }
    lw.irVars[r.leFit].vSlot = loc
  }
  if grow >= 0 { listFitGrowOpen(grow) }
  irLOpnd(r.leV)
  emitListEmptyLoop(p.efSlots, 0, p.efKind, p.efSlot)
  if grow >= 0 && listFitGrowFill(grow) < 0 {
    return irLMiss("list fit grow fill")
  }
  return 0
}

// Whether `RLitArms` `r` over `is` node `n` is still the test legacy writes: its literal arm, or
// a `memberEq` the `litMember` rung writes as its one member's compare (`emitLitMemberEq`).
function litArmsPlanHolds(r: RLitArms, n: IsExpr): boolean {
  if litIsArmOf(r.liAt, n, lw.irAt) == r.liArm { return true }
  if r.liArm == "numBox" && isArmOf(r.liAt, lw.irAt, 0, false) == "floatLits" {
    return true
  }
  if r.liArm == "boxLits" && isArmOf(r.liAt, lw.irAt, 0, false) == "armTag" {
    return tagIsArmOf(r.liAt, n, lw.irAt) == "boxLitSet"
  }
  return r.liArm == "memberEq"
    && isArmOf(r.liAt, lw.irAt, 0, false) == "litMember"
}

// `RLitArms`: the operand and its arm's tail, as `emitIsTestLitArms` writes it; `atomEq` reads the
// operand once per member. Every other arm is the builder's miss.
function litArms(r: RLitArms) {
  // A test at its storage is planned and written under legacy's storage-read mark.
  const n0 = nodeAt(r.liAt)
  const stored = n0 is IsExpr && isPreArmOf(r.liAt, lw.irAt) == "storage"
  const mark = storageReadEnter(
    if stored && n0 is IsExpr { n0.isObj } else { -1 },
  )
  const rc = litArmsAt(r)
  storageReadLeave(mark)
  return rc
}

function litArmsAt(r: RLitArms) {
  lw.irLitReads = 0
  const n = nodeAt(r.liAt)
  if !(n is IsExpr) || !litArmsPlanHolds(r, n) {
    return irLMiss("literal arms plan")
  }
  return match r.liArm {
    "nicheRaw" => {
      litRecv(r)
      nicheRawIsTail(r.liAt)
    }
    "atomNotNul" => {
      litRecv(r)
      atomNotNulIsTail()
    }
    "atomEq" => {
      const texts = litIsMemberTexts(r.liAt)
      let i = 0
      while i < texts.length {
        litRecv(r)
        atomEqIsTail(texts[i], i)
        i = i + 1
      }
      1
    }
    "memberEq" => memberEqLits(r, n.isObj)
    "boxLits" | "numBox" => {
      const lexes = litIsBoxLexes(r.liAt, r.liArm)
      let i = 0
      while i < lexes.length {
        if unionLitIs(r, n.isObj, lexes[i]) < 0 { return -1 }
        memberOrTail(i)
        i = i + 1
      }
      1
    }
    "mapNull" | "mapHas" | "nicheNever" | "nicheTest" | "atomTrue" | "memberNoRecv" | "memberTrue" | "none" => {
      irLMiss("literal arms " + r.liArm)
    }
  }
}

// `memberEq`: per member, the receiver and its string compare, guarded at a `string | null`, each
// after the first or-ed in, as `emitLitMemberEq` writes them.
function memberEqLits(r: RLitArms, recvIx: i32) {
  const texts = litIsMemberTexts(r.liAt)
  let i = 0
  while i < texts.length {
    const lex = quoteLex(texts[i])
    const a = litMemberEqArmOf(recvIx, lex, lw.irAt)
    if a == "union" {
      if unionLitIs(r, recvIx, lex) < 0 { return -1 }
    } else if a == "str" || a == "nulStr" {
      if a == "nulStr" { nulStrMemberOpen() }
      litRecv(r)
      if a == "nulStr" { nulStrMemberGuard() }
      if strMemberEqTail(lex, lw.irAt) < 0 {
        return irLMiss("literal member compare")
      }
      if a == "nulStr" { nulStrMemberClose() }
    } else {
      return irLMiss("literal member " + a)
    }
    memberOrTail(i)
    i = i + 1
  }
  return 1
}

// Box variable `r.liV` tested against literal `lex` as `emitUnionLitIs` writes it: the stash slot,
// then the box and a static false, or the box, its tag test, the box again and its payload compare.
function unionLitIs(r: RLitArms, recvIx: i32, lex: string): i32 {
  unionLitIsStashSlot()
  const p = unionLitIsPlanOf(recvIx, lex, lw.irAt)
  return match p.ulArm {
    "never" => {
      litRecv(r)
      unionLitNeverTail()
    }
    "tag" => {
      litRecv(r)
      unionLitTagHead(p)
      if !p.ulOnce { litRecv(r) }
      unionLitPayloadTail(p, lex, lw.irAt)
    }
    "noSet" | "noArm" => {
      irLMiss("literal box " + p.ulArm)
      -1
    }
  }
}

// `RIsStaged` as `emitIsTest` stages its receiver: the receiver set into its stash slot, which
// the rungs' variable then names, and the rungs' test written with that receiver staged.
function isStaged(r: RIsStaged) {
  const n = nodeAt(r.stAt)
  if !(n is IsExpr) || r.stVar < 0 || r.stVar >= lw.irVars.length {
    return irLMiss("is staged node")
  }
  if isRecvStagedIx >= 0 { return irLMiss("is staged nested") }
  if isRecvStageRep(r.stAt, lw.irAt) != r.stKey {
    return irLMiss("is staged plan")
  }
  irLOpnd(r.stV)
  const slot = isRecvStashSlot(r.stKey)
  fbLocalSet(slot)
  lw.irVars[r.stVar].vSlot = slot
  isRecvStagedIx = unwrapParen(n.isObj)
  isRecvStagedSlot = slot
  isRecvStagedNonNull = r.stKey == 3
  irLOpnd(r.stTest)
  isRecvStagedIx = -1
  isRecvStagedSlot = 0
  isRecvStagedNonNull = false
  return 0
}

// A bare exact `as`'s tail past its operand, as `numExactCastTail` writes it: the test, then on
// the sad path the function's own null the builder built (`ncMiss`), returned.
function numCastMissTail(r: RNumCast): i32 {
  const src = numCastExactSrc(r.ncAt, lw.irAt)
  if src == "" { return irLMiss("as miss cast") }
  const h = numExactCastHead(r.ncAt, src, lw.irAt)
  if h != 1 { return irLMiss("as miss path") }
  irLOpnd(r.ncMiss)
  return numExactCastClose(r.ncAt, src)
}

// `RNumIs` along `numIsPlanOf`, as `emitIsTestNumLit` writes it: the receiver once into its slot
// and each member's compare, or per member the receiver (read again after the first) and compare.
function numIs(r: RNumIs): i32 {
  const n = nodeAt(r.niAt)
  if !(n is IsExpr) { return irLMiss("numeric is node") }
  const pl = numIsPlanOf(r.niAt, n, lw.irAt)
  let i = 0
  if pl.nlOnce {
    irLOpnd(r.niV)
    const slot = numLitOnceStash(pl.nlBase)
    while i < pl.nlTexts.length {
      numLitOnceMember(slot, pl.nlBase, pl.nlTexts[i], i)
      i = i + 1
    }
    return 1
  }
  while i < pl.nlTexts.length {
    if i == 0 { irLOpnd(r.niV) }
    else if opndAgain(r.niV, n.isObj) < 0 { return -1 }
    numLitEqTail(n.isObj, pl.nlTexts[i], i, lw.irAt)
    i = i + 1
  }
  return 1
}

// The `.get` index operands `listGetIdxHook` reads while legacy's `.get` head is written, innermost
// last, and beside each the reads of it so far.
const getIdxOs: Opnd[] = []
const getIdxReads: i32[] = []
let getIdxSlots: i32[] = []

// The `.get` receiver operands `listGetRecvHook` reads while `coalListGetOr` writes legacy's head,
// innermost last; each read is the operand read again (`opndAgain`).
const getRecvOs: Opnd[] = []

// Whether receiver operand `o` of node `ix` can be read again at each use: a variable, or a temp
// whose read the builder recorded (`irHoistRecv`'s tables).
function recvReadAgainOk(o: Opnd, ix: i32): boolean {
  if o is OImm { return true }
  if !(o is OVar) { return false }
  if !isTemp(o.ov) { return true }
  return hoistedReadKnown(ix)
}

// Whether `irHoistRecv` finds a recorded read for node `ix`.
function hoistedReadKnown(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if (lw.irReadVar[ix] ?? -1) >= 0 { return true }
  if lw.irReadAgain.has(ix) || lw.irReadElem.has(ix) { return true }
  if lw.irReadOpt.get(ix) != null { return true }
  const m = nodeAt(ix)
  return lw.irReadField.has(ix)
    && m is Member
    && hoistedReadKnown(unwrapParen(m.memObj))
}

// Hands legacy's `.get` head receiver operand `o` of node `ix` (`listGetRecvHook`) where it can be
// read again (`recvReadAgainOk`). Returns whether it did; `irGetRecvEnd` then undoes it.
function irGetRecvBegin(o: Opnd, ix: i32): boolean {
  if !recvReadAgainOk(o, ix) { return false }
  getRecvOs.push(o)
  listGetRecvHook = irListGetRecvRead
  return true
}

// Undoes the innermost `irGetRecvBegin`.
function irGetRecvEnd() {
  getRecvOs.pop()
  if getRecvOs.length == 0 { listGetRecvHook = listGetIdxLegacy }
  return 0
}

// `listGetRecvHook` under `coalListGetOr`: the innermost receiver operand read again.
function irListGetRecvRead(objIx: i32, _fnIx: i32): i32 {
  const at = getRecvOs.length - 1
  if at < 0 {
    irLMiss("get receiver unset")
    return -1
  }
  if opndAgain(getRecvOs[at], objIx) < 0 { return -1 }
  return 0
}

// Hands legacy's `.get` head index operand `o` (`listGetIdxHook`) where it is read at each use: an
// immediate or a variable, never a temp. Returns whether it did; `irGetIdxEnd` then undoes it.
export function irGetIdxBegin(o: Opnd): boolean {
  // A temp (a call, say) is written once to a fresh i32 local and read from it at each use.
  const once = o is OVar && isTemp(o.ov) && repPrim(opRepOf(o)) == "i32"
  if !(o is OImm || o is OVar && !isTemp(o.ov) || once) { return false }
  const slot = if once { irOnceSlot([127]) } else { -1 }
  if slot >= 0 {
    irLOpnd(o)
    fbLocalSet(slot)
  }
  // Legacy's staging of the index is dropped: the tail reads it through the hook.
  listGetIdxUnstage()
  getIdxOs.push(o)
  getIdxReads.push(0)
  getIdxSlots.push(slot)
  listGetIdxHook = irListGetIdxRead
  return true
}

// Undoes the innermost `irGetIdxBegin`.
export function irGetIdxEnd() {
  getIdxOs.pop()
  getIdxReads.pop()
  getIdxSlots.pop()
  listGetIdxRelease()
  if getIdxOs.length == 0 { listGetIdxHook = listGetIdxLegacy }
  return 0
}

// `listGetIdxHook` under `coalListGetOr`: the index operand the first time, then read again.
function irListGetIdxRead(idxIx: i32, _fnIx: i32): i32 {
  const at = getIdxOs.length - 1
  if at < 0 || at >= getIdxReads.length {
    irLMiss("get index unset")
    return -1
  }
  const k = getIdxReads[at]
  getIdxReads[at] = k + 1
  const slot = getIdxSlots[at] ?? -1
  if slot >= 0 { return fbLocalGet(slot) }
  if k == 0 {
    irLOpnd(getIdxOs[at])
    return 0
  }
  return opndAgain(getIdxOs[at], idxIx)
}

// The operands legacy fit writers' tails re-read through `fitRecvReadHook` while `irFitTail`
// lowers them, innermost last, the receiver node the innermost stands for, and its reads so far.
// A stack, not a `let` of `Opnd`: a mutable union-typed module cell is checked dearly (D17063).
const fitRecvOs: Opnd[] = []
let fitRecvIx = -1
let fitRecvReads = 0

// `fitRecvReadHook` under `irFitTail`: the operand the first time, then read again as the builder
// read it. A receiver other than the one the IR holds misses.
function irFitRecvRead(recvIx: i32, _fnIx: i32): i32 {
  if unwrapParen(recvIx) != fitRecvIx {
    return irLMiss("fit receiver other") - 1
  }
  const at = fitRecvOs.length - 1
  if at < 0 { return irLMiss("fit receiver unset") - 1 }
  const k = fitRecvReads
  fitRecvReads = k + 1
  if k == 0 {
    irLOpnd(fitRecvOs[at])
    return 0
  }
  return opndAgain(fitRecvOs[at], recvIx)
}

// Legacy's fit writer for `is` test `isIx` over operand `o`, `emitRecordFitPlaced` when `record`,
// else the variant chain tail at arm `vi`: the hook set to read `o` and every piece of its state
// restored at the one exit, whatever the writer answered.
function irFitTail(o: Opnd, isIx: i32, vi: i32, record: boolean): i32 {
  const svHook = fitRecvReadHook
  const svIx = fitRecvIx
  const svReads = fitRecvReads
  fitRecvReadHook = irFitRecvRead
  fitRecvOs.push(o)
  fitRecvIx = -1
  fitRecvReads = 0
  let rc = -1
  if isIx >= 0 && isIx < P.nodes.length {
    const n = nodeAt(isIx)
    if n is IsExpr {
      fitRecvIx = unwrapParen(n.isObj)
      rc = if !record { variantRowChainTail(isIx, n, lw.irAt, vi, -1) } else if recordFitPlanOf(isIx, lw.irAt) == 1 { emitRecordFitPlaced(isIx, -1, lw.irAt) } else { irLMiss("record fit plan") - 1 }
    }
  }
  if fitRecvIx < 0 { irLMiss("variant chain node") }
  fitRecvReadHook = svHook
  fitRecvOs.pop()
  fitRecvIx = svIx
  fitRecvReads = svReads
  return rc
}

// `irFitTail` on each arm, missing: the chain over a node that is no `is` test, the record writer
// over an `is` whose plan is no record fit. Each misses, and the hook is back at legacy's default.
export function irFitTailSelfTest(): i32 {
  const svMiss = lwMiss
  const o: Opnd = { oiRep: -1, oiBits: 0 }
  const rc = irFitTail(o, -1, -1, false)
  const chainMissed = lwMiss != "" && fitRecvReadHook === fitRecvLegacy
  lwMiss = ""
  const s: StrLit = { strText: "s", pos: -1 }
  const t: IsExpr = {
    isObj: addNode(s),
    isVariant: "",
    pos: -1,
    isNeg: 0,
    isFit: -1,
  }
  const rr = irFitTail(o, addNode(t), -1, true)
  const recordMissed = lwMiss != "" && fitRecvReadHook === fitRecvLegacy
  lwMiss = svMiss
  return if rc < 0 && rr < 0 && chainMissed && recordMissed { 1 } else { 0 }
}

// `RVariantDiscrim` as `emitIsTestVariantRow` writes a `discrim` row: the variable and the arm's
// tag, then in an `if` each needed field's literals, or'd within a field and and'd across fields.
function variantDiscrim(r: RVariantDiscrim): i32 {
  const n = nodeAt(r.vdAt)
  if !(n is IsExpr) { return irLMiss("variant discriminant node") }
  if r.vdVi < 0 || r.vdVi >= uFieldCount.length {
    return irLMiss("variant discriminant row")
  }
  irLOpnd(r.vdV)
  variantTagTail(r.vdVi)
  fbIf(127)
  let first = true
  let fi = 0
  while fi < uFieldCount[r.vdVi] {
    if variantDiscrimFieldNeeded(r.vdVi, fi) {
      const lexes = variantFieldLitLexes(r.vdVi, fi)
      let li = 0
      while li < lexes.length {
        if opndAgain(r.vdV, n.isObj) < 0 { return -1 }
        if discrimFieldEqTail(r.vdVi, fi, lexes[li], lw.irAt) < 0 { return -1 }
        if li > 0 { fbI32Bin(114) }
        li = li + 1
      }
      if !first { fbI32Bin(113) }
      first = false
    }
    fi = fi + 1
  }
  fbElse()
  fbI32Const(0)
  fbEnd()
  return 0
}

// `RLitArms`' receiver: its operand the first time, then read again as the builder read it.
function litRecv(r: RLitArms): i32 {
  const n = nodeAt(r.liAt)
  const k = lw.irLitReads
  lw.irLitReads = k + 1
  if k == 0 || !(n is IsExpr) {
    irLOpnd(r.liV)
    return 0
  }
  return opndAgain(r.liV, n.isObj)
}

// `RListIsAcross` as `emitListIsAcrossReps` writes it: the plan, the receiver, then legacy's tail
// over the shared slot.
function listIsAcross(r: RListIsAcross): i32 {
  const n = nodeAt(r.laAt)
  if !(n is IsExpr) { return irLMiss("list is across node") }
  const p = listIsAcrossPlanOf(r.laAt, n, lw.irAt)
  if !p.lpOk { return irLMiss("list is across plan") }
  irLOpnd(r.laV)
  return listIsAcrossTail(n, sharedFieldRecvSlot(), p, lw.irAt)
}

// `RListFitIs` as `emitListFitIs` writes it: the receiver, then legacy's walk along the plan.
function listFitIs(r: RListFitIs): i32 {
  const n = nodeAt(r.lsAt)
  if !(n is IsExpr) { return irLMiss("list fit node") }
  const p = listFitIsPlanOf(r.lsAt, lw.irAt)
  if p.lftOk != 1 { return irLMiss("list fit plan") }
  irLOpnd(r.lsV)
  return listFitTail(p, lw.irAt)
}

// `RListEmptyArms`: per list arm of its plan, the box variable, the arm's tag test, the box
// again, and the arm's emptiness walk, as `emitListEmptyFitArms` writes them.
function listEmptyArms(r: RListEmptyArms) {
  const p0 = emptyFitPlanOf(r.lfAt, lw.irAt)
  if p0.efArm != "union" { return irLMiss("list empty arms plan") }
  const p = emptyFitArmsPlanOf(r.lfAt, lw.irAt, p0.efRecvTy)
  if !emptyFitArmsPlain(p) { return irLMiss("list empty arms plan") }
  let i = 0
  while i < p.eaRows.length {
    irLOpnd(r.lfV)
    emptyFitArmHead(p, i)
    irLOpnd(r.lfV)
    emptyFitArmBody(p, i)
    i = i + 1
  }
  return 0
}

// `RBoxField`: the narrowed box, then legacy's payload cast and field read, and the read's own
// recover, as `emitExpr` writes a member read through `emitNarrowedMem`.
function boxField(r: RBoxField) {
  const fnIx = lw.irAt
  const m = nodeAt(r.bfAt)
  if !(m is Member) { return irLMiss("box field node") }
  const idx = narrowedFieldPlain(r.bfAt, fnIx)
  if idx < 0 { return irLMiss("box field shape") }
  irLOpnd(r.bfV)
  if (
    narrowedMemTail(memNarrowVariantIndex(r.bfAt, fnIx), idx, r.bfAt, fnIx)
    < 0
  ) {
    return irLMiss("box field unbox")
  }
  if readOwesNonNullRecover(r.bfAt, fnIx) { fbRefAsNonNull() }
  return 0
}

// `RSharedRead`: legacy's shared-field dispatch over the box local, each arm but the last its tag
// test then its plain read, each read in its own frame, and the read's own recover, as `emitMem`
// writes it through `emitMemSharedRead`.
function sharedRead(r: RSharedRead) {
  const fnIx = lw.irAt
  const vis: i32[] = []
  const fis: i32[] = []
  const code = sharedReadPlanOf(r.srAt, fnIx, vis, fis)
  if code < 0 || !sharedReadPlainOf(r.srAt, fnIx) {
    return irLMiss("shared read plan")
  }
  if sharedReadStashes(r.srAt) != r.srStash {
    return irLMiss("shared read stash")
  }
  // The stash is asked for where legacy asks, after the receiver; between its set and the last
  // get, the plain arms and tail evaluate nothing that could stash again.
  if r.srStash { irLOpnd(r.srV) }
  const slot = if r.srStash { sharedFieldRecvSlot() } else { -1 }
  if r.srStash && slot < 0 { return irLMiss("shared read stash slot") }
  if r.srStash { fbLocalSet(slot) }
  const last = vis.length - 1
  let i = 0
  while i < last {
    sharedReadRecv(r, slot)
    sharedArmTestTail(code, vis, fis, i)
    lwFrames.push(-1)
    if sharedReadArm(r, slot, code, vis[i], fis[i]) < 0 { return -1 }
    fbElse()
    i = i + 1
  }
  if sharedReadArm(r, slot, code, vis[last], fis[last]) < 0 { return -1 }
  let e = 0
  while e < last {
    fbEnd()
    lwFrames.pop()
    e = e + 1
  }
  if sharedReadTail(code, vis, fis, r.srAt, fnIx) < 0 { return -1 }
  if readOwesNonNullRecover(r.srAt, fnIx) { fbRefAsNonNull() }
  return 0
}

// `RSharedFieldSet`: legacy's shared field write. The receiver is staged once or pushed again per
// arm, and the value staged once or written in its arm. Each arm but the last tests its tag; each
// casts the payload to its variant and stores the value at its field.
function sharedFieldSet(r: RSharedFieldSet) {
  const fnIx = lw.irAt
  const vis: i32[] = []
  const fis: i32[] = []
  const plan = sharedFieldStorePlan(lhsOfAssign(r.shAt), fnIx, vis, fis)
  if plan == 0 || r.shVs.length != (if plan == 1 { vis.length } else { 1 }) {
    return irLMiss("shared field store plan")
  }
  const slot = if r.shStash { sharedFieldRecvSlot() } else { -1 }
  if r.shStash {
    irLOpnd(r.shR)
    fbLocalSet(slot)
  }
  const vslot = if plan == 2 { sharedFieldValSlot(lhsOfAssign(r.shAt), fnIx, vis, fis) } else { -1 }
  if plan == 2 {
    irLOpnd(r.shVs[0])
    fbLocalSet(vslot)
  }
  let i = 0
  while i < vis.length {
    if i < vis.length - 1 {
      sharedFieldSetRecv(r, slot)
      sharedFieldArmTest(vis, i)
    }
    sharedFieldSetRecv(r, slot)
    sharedFieldArmCast(vis, i)
    if plan == 2 { fbLocalGet(vslot) } else { irLOpnd(r.shVs[i]) }
    sharedFieldArmClose(vis, fis, i)
    i = i + 1
  }
  return sharedFieldArmsEnd(vis)
}

// One receiver push of shared field write `r`: its stash slot's box, its global's, else its box
// local.
function sharedFieldSetRecv(r: RSharedFieldSet, slot: i32) {
  if r.shStash { return sharedRecvSlotGet(slot) }
  if r.shGlobal >= 0 { return globalRead(r.shGlobal, r.shGlobalNonNull) }
  return irLOpnd(r.shR)
}

// The target of assignment node `at`, or -1.
function lhsOfAssign(at: i32): i32 {
  const a = nodeAt(at)
  return if a is BinExpr { unwrapParen(a.binLeft) } else { -1 }
}

// One member's arm of shared read `r`, in its form (`sharedArmModeOf`) as legacy writes it: the
// head, the receiver where the form reads it, then the tail.
function sharedReadArm(
  r: RSharedRead,
  slot: i32,
  code: i32,
  vi: i32,
  fi: i32,
): i32 {
  if vi < 0 || vi >= uVarRow.length { return irLMiss("shared read arm row") }
  const mode = sharedArmModeOf(code, vi, fi)
  if sharedArmHead(mode, code, vi, fi, r.srAt, lw.irAt) < 0 { return -1 }
  if !sharedArmModeReads(mode) { return 0 }
  sharedReadRecv(r, slot)
  return sharedArmTail(mode, code, vi, fi, r.srAt, lw.irAt)
}

// One receiver push of shared read `r`: its stash slot's box, its global's, else its box local.
function sharedReadRecv(r: RSharedRead, slot: i32) {
  if r.srStash { return sharedRecvSlotGet(slot) }
  if r.srGlobal >= 0 { return globalRead(r.srGlobal, r.srGlobalNonNull) }
  return irLOpnd(r.srV)
}

// `SSetField`: the record, the value, then legacy's struct-store tail (`fieldStoreTail`).
function setField(n: SSetField, at: i32) {
  const a = nodeAt(at)
  if !(a is BinExpr) { return irLMiss("field store node") }
  const lhs = unwrapParen(a.binLeft)
  const arm = fieldStoreArmOf(lhs, lw.irAt)
  const sf = if arm == "struct" { fieldStoreStructAt(lhs, lw.irAt) } else if arm == "variantParam" { fieldStoreVariantAt(lhs, lw.irAt) } else if arm == "narrowVariant" { fieldStoreNarrowedAt(lhs, lw.irAt) } else { [] }
  if sf.length != 2 { return irLMiss("field store shape") }
  irLOpnd(n.sfV)
  irLOpnd(n.sfSrc)
  if arm != "struct" {
    if n.sfPark { return irLMiss("parked variant field store") }
    return fieldStoreVariantTail(sf[0], sf[1])
  }
  if n.sfPark {
    return fieldStoreParkTail(sf[0], sf[1], a.binLeft, a.binRight, lw.irAt)
  }
  return fieldStoreTail(sf[0], sf[1], a.binLeft, a.binRight, lw.irAt)
}

// `RGetField`: the record, then legacy's field read and its recover, and the read's own recover,
// as `emitExpr` writes a member read through `emitMemVariantRead` or `emitMemStructRead`.
function getField(r: RGetField) {
  const m = nodeAt(r.gfAt)
  if !(m is Member) { return irLMiss("field node") }
  if r.gfShared { return sharedField(r, m) }
  // A read the builder built at its storage has its shape there.
  const sm = if r.gfStored { storageReadEnter(r.gfAt) } else { storageReadEnter(-1) }
  const fi = fieldIdxAt(r.gfAt, m)
  storageReadLeave(sm)
  if fi < 0 && nodeAt(unwrapParen(m.memObj)) is IfStmt {
    return ifJoinField(r, m)
  }
  if fi < 0 { return irLMiss("field shape") }
  irLOpnd(r.gfV)
  // A member record read the box plan passes as its field's box is lowered at its storage, as
  // the builder built it (`memberBoxTemp`).
  if memberBoxReadAt(r.gfAt, lw.irAt) {
    const marks = memberBoxReadEnter(r.gfAt)
    const rc = fieldTail(r.gfAt, m)
    memberBoxReadLeave(marks)
    return rc
  }
  // A read the builder built at its storage (an `is` receiver's) is lowered at it too.
  if !r.gfStored { return fieldTail(r.gfAt, m) }
  const mark = storageReadEnter(r.gfAt)
  const rs = fieldTail(r.gfAt, m)
  storageReadLeave(mark)
  return rs
}

// A shared template member's read (`gfShared`): the record, then the field at its storage, as
// `emitMemStructRead` writes it for a node no instance typed.
function sharedField(r: RGetField, m: Member) {
  const fnIx = lw.irAt
  const si = structIndexOfExpr(m.memObj, fnIx)
  const idx = if si >= 0 { sFieldIndex(si, m.memProp) } else { -1 }
  if idx < 0 { return irLMiss("shared field shape") }
  irLOpnd(r.gfV)
  if memRecvOwesNonNull(r.gfAt, fnIx) { fbRefAsNonNull() }
  structFieldTail(si, idx, r.gfAt, fnIx)
  if structUnionBoxTail(si, idx, r.gfAt, fnIx) < 0 {
    return irLMiss("field unbox")
  }
  return 0
}

// A field read off a value `if` whose join legacy's field plans name no struct for: the field at
// the row of the record the builder built the join's out at.
function ifJoinField(r: RGetField, m: Member) {
  const si = structIndexOfTy(repTyOf(opRepOf(r.gfV)))
  const idx = if si >= 0 { sFieldIndex(si, m.memProp) } else { -1 }
  if idx < 0 { return irLMiss("if join field shape") }
  irLOpnd(r.gfV)
  structFieldTail(si, idx, r.gfAt, lw.irAt)
  if structUnionBoxTail(si, idx, r.gfAt, lw.irAt) < 0 {
    return irLMiss("field unbox")
  }
  return 0
}

// The plain field index member read `at` reads, or -1.
function fieldIdxAt(at: i32, m: Member): i32 {
  const fnIx = lw.irAt
  if exprVariantIndex(m.memObj, fnIx) >= 0 {
    return variantFieldPlain(at, fnIx)
  }
  const sf = structFieldPlainOrAt(at, fnIx)
  return if sf >= 0 { sf } else { nulVariantFieldPlain(at, fnIx) }
}

// `structFieldPlain`, or the stored field a read that records no kind takes (`structFieldAt`).
function structFieldPlainOrAt(at: i32, fnIx: i32): i32 {
  const sf = structFieldPlain(at, fnIx)
  return if sf >= 0 { sf } else { structFieldAt(at, fnIx) }
}

// After a plain field read's object: the field, and the read's recovery.
function fieldTail(at: i32, m: Member) {
  const fnIx = lw.irAt
  const vi = exprVariantIndex(m.memObj, fnIx)
  const sf = if vi < 0 { structFieldPlainOrAt(at, fnIx) } else { -1 }
  const idx = if vi >= 0 { variantFieldPlain(at, fnIx) } else if sf >= 0 { sf } else { nulVariantFieldPlain(at, fnIx) }
  if idx < 0 { return irLMiss("field shape") }
  // A narrowed `V | null` receiver, read non-null as `emitMemNulVariantRead` reads it.
  const nvi = if vi < 0 && sf < 0 { nulVariantIdxOfExpr(m.memObj, fnIx) } else { -1 }
  if nvi >= 0 {
    fbRefAsNonNull()
    variantFieldTail(nvi, idx, at, fnIx)
  } else if vi >= 0 {
    variantFieldTail(vi, idx, at, fnIx)
    if variantUnionBoxTail(vi, idx, at, fnIx) < 0 {
      return irLMiss("field unbox")
    }
  } else {
    const si = structIndexOfExpr(m.memObj, fnIx)
    if memRecvOwesNonNull(at, fnIx) { fbRefAsNonNull() }
    structFieldTail(si, idx, at, fnIx)
    if structUnionBoxTail(si, idx, at, fnIx) < 0 {
      return irLMiss("field unbox")
    }
  }
  if readOwesNonNullRecover(at, fnIx) { fbRefAsNonNull() }
  return 0
}

// `RBoxNarrow`: the box, then legacy's payload cast to the read's variant, as
// `emitVariantCoerce`'s box arm writes a narrowed read at a variant destination.
function boxNarrow(r: RBoxNarrow) { return boxNarrowAt(r, false) }

// `boxNarrow`, its box read as `boxNarrowBox` reads it.
function boxNarrowAt(r: RBoxNarrow, again: boolean) {
  if r.bnCon >= 0 { return boxContainerRead(r, again) }
  if r.bnAtom >= 0 {
    boxNarrowBox(r, again)
    return emitUnionUnboxTail(r.bnAtom)
  }
  // A read with no narrowing plan of its own (a union-valued map read narrowed to a member) takes the
  // variant its rep is.
  const vp = narrowedBoxVariantPlain(r.bnAt, lw.irAt)
  const vi = if narrowedVariantRepIs(vp, r.bnRep) { vp } else { variantOfRep(r.bnRep) }
  if !narrowedVariantRepIs(vi, r.bnRep) { return irLMiss("box narrow shape") }
  boxNarrowBox(r, again)
  return narrowedVariantTail(vi)
}

// The registered variant whose type's rep is `rep` (`uVarTyIx`), or -1.
function variantOfRep(rep: i32): i32 {
  let i = 0
  while i < uVarTyIx.length {
    if repNodeOfTy(uVarTyIx[i]) == rep { return i }
    i = i + 1
  }
  return -1
}

// `RNicheRead`: the box, then legacy's niche tail (`emitNicheReadTail`), as `emitNarrowedNicheRead`
// writes it after its storage read.
function nicheRead(r: RNicheRead) {
  // As legacy's `emitIndexBanked` wraps `emitNarrowedNicheRead` whole.
  const cellRead = r.nrRow
    && r.nrAt >= 0
    && r.nrAt < P.nodes.length
    && nodeAt(r.nrAt) is Index
  const from = if cellRead { irLIndexFrom(r.nrAt, irLAt()) } else { -1 }
  if cellRead { lwIdxRowMutes.push(r.nrAt) }
  irLOpnd(r.nrV)
  if cellRead { lwIdxRowMutes.pop() }
  const rc = emitNicheReadTail(r.nrAt, r.nrKind, lw.irAt)
  if cellRead { irLIndexRow(r.nrAt, from) }
  return rc
}

// `SArmWrite` as legacy's `is K[]` store chain (`emitArmIndexWriteAt`) writes it: per arm the box
// from its name's local, its tag test, the box again and its payload cast into the arm's wrapper
// local, the arm's store under the arm's overrides, its parked value dropped; `unreachable` last.
function armWriteStmt(n: SArmWrite, pending: i32[]) {
  const a = nodeAt(n.awAt)
  if !(a is BinExpr) { return irLMiss("arm write node") }
  const t = nodeAt(unwrapParen(a.binLeft))
  if !(t is Index) { return irLMiss("arm write target") }
  const recv = unwrapParen(t.idxArr)
  const arms = armIndexWriteArmsOf(t, lw.irAt)
  if arms.length == 0 || arms.length != n.awArms.length {
    return irLMiss("arm write arms")
  }
  // A variable's box is its local; a global's is read again at each use (`irHoistRecv`).
  const bl = plainVarLocal(n.awV)
  if bl < 0 && !irReadsAgain(recv) { return irLMiss("arm write receiver") }
  if bl < 0 { irLSkip(n.awV) }
  irLSettle(pending)
  let k = 0
  while k < arms.length && lwMiss == "" {
    if armWriteRecv(bl, recv) < 0 { break }
    if armIndexWriteTest(arms[k]) < 0 {
      irLMiss("arm write arm")
      break
    }
    if armWriteRecv(bl, recv) < 0 { break }
    const loc = armIndexWritePayload(arms[k])
    if loc < 0 {
      irLMiss("arm write arm")
      break
    }
    lw.irVars[n.awVars[k]].vSlot = loc
    const mark = luOvEnter(recv, arms[k])
    const lmark = luOvLocalEnter(recv, loc)
    lwFrames.push(-1)
    body(n.awArms[k], false, -1, false)
    armIndexWriteDrop(t, lw.irAt)
    luOvLocalLeave(lmark)
    luOvLeave(mark)
    fbElse()
    k = k + 1
  }
  fbUnreachable()
  while k > 0 {
    lwFrames.pop()
    fbEnd()
    k = k - 1
  }
  return 0
}

// An arm write's box: local `bl`, or node `recv` read again where it has none.
function armWriteRecv(bl: i32, recv: i32): i32 {
  if bl >= 0 {
    fbLocalGet(bl)
    return 0
  }
  return irHoistRecv(recv)
}

// `SArmSite` as legacy's tag chain (`emitArmSiteAt`) writes it: an index set once into its stash
// (`armIdxSlot`), the box set into the receiver stash or read by its name's local, then per arm
// its tag test and payload cast (`armSiteArmOpen`) and the arm's body, `unreachable` past the last.
// The out waits on the stack for its one reader; one element-read row covers the chain.
function armSiteStmt(n: SArmSite, pending: i32[]) {
  const t = n.saOut
  if varSlot(t) >= 0 { return irLMiss("arm site into a slot") }
  if t < 0 || t >= lw.irVars.length || t >= lwStackVal.length {
    return irLMiss("arm site out")
  }
  const arms = armSiteArmsOf(n.saAt, lw.irAt)
  if arms.length != n.saArms.length || n.saOps.length < 1 {
    return irLMiss("arm site arms")
  }
  const roots = stageLeadOf(n.saOps, pending)
  if lwMiss != "" { return -1 }
  // Legacy takes an outer arm site's receiver stash before it writes this chain as that receiver.
  if stashedArmSiteReads(t) { sharedFieldRecvSlot() }
  lwFloors.push(lwFloor)
  lwFloor = lwLive.length - liveCountIn(pending)
  const from = irLIndexFrom(n.saAt, lwBuf.length)
  lwSeq = []
  if n.saIdx >= 0 {
    const sl = armIdxSlot()
    irLOpnd(n.saOps[1])
    fbLocalSet(sl)
    lw.irVars[n.saIdx].vSlot = sl
  }
  let bl = -1
  // A global's box is read again before each arm's tag test and cast, as legacy re-reads the name.
  const glob = armSiteGlobalOf(n)
  if n.saStash {
    // Legacy takes the stash before it writes the box, so the box's own scratch locals follow it.
    bl = sharedFieldRecvSlot()
    irLOpnd(n.saOps[0])
    fbLocalSet(bl)
  } else if glob >= 0 {
    irLSkip(n.saOps[0])
  } else {
    bl = plainVarLocal(n.saOps[0])
    if bl < 0 { irLMiss("arm site receiver") }
  }
  irLSettle(pending)
  const sp = emitFnSpanNode.length
  const sh = shIdxNode.length
  lwIdxRowMutes.push(n.saAt)
  const recv = armSiteRecv(n.saAt)
  const recvRow = if recv >= 0 && recv < P.nodes.length && nodeAt(recv) is Index { recv } else { -1 }
  let k = 0
  while k < arms.length && lwMiss == "" {
    const loc = if glob >= 0 { armSiteGlobalArmOpen(n.saAt, glob, arms[k]) } else { armSiteArmOpen(n.saAt, bl, arms[k], lw.irAt) }
    if loc < 0 {
      irLMiss("arm site arm")
      break
    }
    lw.irVars[n.saVars[k]].vSlot = loc
    lwFrames.push(-1)
    armSiteArmEnter(n.saAt, arms[k], loc, lw.irAt)
    lwPayloadVars.push(n.saVars[k])
    lwPayloadRows.push(recvRow)
    body(n.saArms[k], false, t, false)
    lwPayloadVars.pop()
    lwPayloadRows.pop()
    armSiteArmLeave()
    fbElse()
    k = k + 1
  }
  fbUnreachable()
  while k > 0 {
    lwFrames.pop()
    fbEnd()
    k = k - 1
  }
  lwIdxRowMutes.pop()
  adoptBankedRows(sp, sh)
  // Only an element read banks a row of its own (`emitIndexBanked`).
  if nodeAt(n.saAt) is Index { irLIndexRow(n.saAt, from) }
  lwFloor = lwFloors.pop() ?? 0
  for r in roots { pending.push(r) }
  livePush(t)
  pending.push(t)
  return 0
}

// The temp an arm site's named box is when a global's read (`RGlobalGet`) defines it, or -1.
function armSiteGlobalOf(n: SArmSite): i32 {
  if n.saStash || n.saOps.length < 1 { return -1 }
  const o = n.saOps[0]
  if !(o is OVar) || !isTemp(o.ov) || !tempDefined(o.ov) { return -1 }
  return if tempRhs(o.ov) is RGlobalGet { o.ov } else { -1 }
}

// `armSiteArmOpen` over the global read defining temp `v`: the read, the arm's tag test, the read
// again, the cast.
function armSiteGlobalArmOpen(at: i32, v: i32, m: i32): i32 {
  const g = tempRhs(v)
  const t = listIsArmTag(m)
  if !(g is RGlobalGet) || t < 0 { return irLMiss("arm site global arm") }
  globalGetRhs(g)
  armSiteArmTest(at, t, lw.irAt)
  globalGetRhs(g)
  return armSiteArmCast(m)
}

// Takes the element-read rows legacy's writer banked since marks `sp` and `sh` as this lowering's,
// which `fragmentRows` banks again; a writer banks no other kind.
function adoptBankedRows(sp: i32, sh: i32) {
  let k = sp
  while k < emitFnSpanNode.length {
    if emitFnSpanKind[k] != 6 { return irLMiss("arm site banked row") }
    lwRowAst.push(emitFnSpanNode[k])
    lwRowFrom.push(emitFnSpanStart[k])
    lwRowTo.push(emitFnSpanEnd[k])
    lwRowKind.push(6)
    k = k + 1
  }
  let q = sh
  while q < shIdxNode.length {
    lwRowAst.push(shIdxNode[q])
    lwRowFrom.push(shIdxFrom[q])
    lwRowTo.push(shIdxTo[q])
    lwRowKind.push(6)
    q = q + 1
  }
  return bankedRowsDrop(sp, sh)
}

// The local a named variable `o` is read from with a plain `local.get`, or -1: a temp, a staged
// value or a range loop copy is read otherwise.
function plainVarLocal(o: Opnd): i32 {
  if !(o is OVar) || isTemp(o.ov) { return -1 }
  if o.ov < lwStackVal.length && lwStackVal[o.ov] { return -1 }
  const s = varSlot(o.ov)
  if s < 0 || urSlotUnrolled(s) { return -1 }
  return s
}

// `RArmUnbox`: the box, then the table's cast to the read's arm record (`emitArmUnboxAtCell`). An
// assignment's box takes its destination's (`emitNarrowedArmUnboxTo`), where legacy's position casts.
function armUnbox(r: RArmUnbox) {
  irLOpnd(r.uaV)
  return match armUnboxRoute(r) {
    "asg" => emitNarrowedArmUnboxTo(recHeapOf(r.uaDst), r.uaAt, lw.irAt)
    "recordArms" => {
      if emitRecordArmsUnboxTo(recHeapOf(r.uaDst), r.uaAt, lw.irAt) < 0 {
        return irLMiss("record arms unbox heap")
      }
      0
    }
    "arm" => {
      if emitArmUnboxAtCell(r.uaAt, lw.irAt, r.uaCellNul) < 0 {
        return irLMiss("arm unbox heap")
      }
      0
    }
  }
}

// `RBoxNarrow` of a ref list or map arm: the box, then legacy's payload cast to the container,
// past the list overrides `emitIdentNode` asks first.
function boxContainerRead(r: RBoxNarrow, again: boolean) {
  const e = nodeAt(r.bnAt)
  if !(e is Ident) { return irLMiss("box container read node") }
  match identListOverrideOf(e, r.bnAt, lw.irAt) {
    "luOv" | "fitShadow" => {
      return irLMiss("list override")
    }
    "none" => {}
  }
  boxNarrowBox(r, again)
  if r.bnCon == RC_MAP { return mapUnionUnboxTail(r.bnAt, lw.irAt) }
  return refArrayUnionUnboxTail(r.bnAt, lw.irAt)
}

// `RRecover`: the nullable local, then `ref.as_non_null` where a `string | null` read recovers,
// as `emitIdentLocalRead` writes it, and again where the read owes its narrowed rep, as
// `emitReadRecover` writes it after.
function recoverRead(r: RRecover) {
  // A list override (`identListOverrideOf`) reads lowering state, so it is asked here.
  const e = nodeAt(r.rcAt)
  if e is Ident {
    match identListOverrideOf(e, r.rcAt, lw.irAt) {
      "luOv" | "fitShadow" => {
        return irLMiss("list override")
      }
      "none" => {}
    }
  }
  irLOpnd(r.rcV)
  let k = 0
  while k < r.rcNn {
    fbRefAsNonNull()
    k = k + 1
  }
  return 0
}

// `RListNew`: legacy's `__array_new__` arm in `emitArrayNewIntr`'s order: the length and its
// stash, the fill one fill depth in, then the allocation at `arrNewPlanOf`'s pair.
function listNew(r: RListNew) {
  const c = nodeAt(r.lnAt)
  if !(c is Call) || c.callArgs.length != 2 { return irLMiss("array new node") }
  const pl = arrNewPlanOf(r.lnAt, c.callArgs[1], lw.irAt)
  if pl.anWhy != "" { return irLMiss("array new refused") }
  irLOpnd(r.lnLen)
  const slot = arrNewLenStash()
  arrNewFillStep(1)
  irLOpnd(r.lnFill)
  arrNewFillStep(-1)
  return arrNewTail(pl, slot)
}

// `RMemOp`: legacy's memory-management arm in `emitCallCoreMemOp`'s order, the operands then
// `memOpTail`. Answers 1 for the bulk pair, which leaves nothing, else 0.
function memOp(r: RMemOp): i32 {
  const c = nodeAt(r.moAt)
  if !(c is Call) { return irLMiss("memory op node") }
  const pl = memOpPlanOf(c)
  if pl.moFail != "" { return irLMiss("memory op plan") }
  for o in r.moArgs { irLOpnd(o) }
  memOpTail(pl.moArm)
  return if memOpIsVoid(pl.moArm) { 1 } else { 0 }
}

// Whether call node `at` is a SIMD store, the one SIMD row that leaves nothing.
function simdStoreAt(at: i32): boolean {
  const c = nodeAt(at)
  if !(c is Call) { return false }
  const row = simdCallRow(c)
  return row >= 0 && simdRowIsMem(row) && simdMemBase(row) == 2
}

// `RListNewDefault`: legacy's `__array_new_default__` arm: the length and its stash, then the
// zeroed allocation at `arrNewPlanOf`'s pair.
function listNewDefault(r: RListNewDefault) {
  const pl = arrNewPlanOf(r.ldAt, -1, lw.irAt)
  if pl.anWhy != "" { return irLMiss("array new refused") }
  irLOpnd(r.ldLen)
  return arrNewDefaultTail(pl, arrNewLenStash())
}

// `RSimd`: legacy's SIMD arm in `emitSimdIntrinsic`'s order, the value operands then the row's
// instruction (`simdTail`).
function simd(r: RSimd) {
  const c = nodeAt(r.sdAt)
  if !(c is Call) || c.callFn < 0 || c.callFn >= P.nodes.length {
    return irLMiss("simd node")
  }
  const f = nodeAt(c.callFn)
  const row = simdCallRow(c)
  if !(f is Ident) || row < 0 { return irLMiss("simd node") }
  if simdRowIsMem(row) {
    const ap = irAddrPlan(c, simdMemBase(row))
    if ap.maArm != "const" && ap.maArm != "rest" && ap.maArm != "fold" {
      return irLMiss("simd memory plan")
    }
    addrOpnds(r.sdArgs, ap)
    return simdMemTail(row, ap.maOff)
  }
  for a in r.sdArgs { irLOpnd(a) }
  return simdTail(c, f.identName, row)
}

// `RMemAccess`: legacy's load or store arm in `emitCallCoreMemAccess`'s order: the address the
// builder took along `memAddrPlanOf`'s arm, a store's value, then the access at the plan's offset.
function memAccess(r: RMemAccess) {
  const c = nodeAt(r.mmAt)
  if !(c is Call) || c.callFn < 0 || c.callFn >= P.nodes.length {
    return irLMiss("memory access node")
  }
  const p = memAccessPlanOf(r.mmName)
  const ap = irAddrPlan(c, p.mxBase)
  if (
    p.mxOp < 0
    || ap.maArm != "const" && ap.maArm != "rest" && ap.maArm != "fold"
  ) {
    return irLMiss("memory access plan")
  }
  addrOpnds(r.mmArgs, ap)
  return memAccessTail(p, ap.maOff)
}

// The address plan of memory call `c` (`base` declared operands) over the fold rows the builder
// derived (`irMaDecl`), as `memAddrPlanOf` answers it over legacy's own.
function irAddrPlan(c: Call, base: i32): MemAddrPlan {
  return memAddrPlanWith(
    c,
    base,
    lw.irAt,
    { mfDecl: lw.irMaDecl, mfSlot: lw.irMaSlot, mfK: lw.irMaK },
  )
}

// An access's operands along plan `ap`: on the `fold` arm its address is the fold's local, read in
// place of the binding the builder named, which holds that local plus the plan's offset.
function addrOpnds(args: Opnd[], ap: MemAddrPlan) {
  let i = 0
  while i < args.length {
    if i == 0 && ap.maArm == "fold" {
      fbLocalGet(ap.maRest)
    } else {
      irLOpnd(args[i])
    }
    i = i + 1
  }
  return 0
}

// `RMaFoldInit` as `emitMemConstFoldLet` writes it: the bounded part, teed into its fold local,
// then plus the folded constant.
function maFoldInit(r: RMaFoldInit) {
  irLOpnd(r.mfiV)
  fbLocalTee(r.mfiSlot)
  fbI32Const(r.mfiK as% i32)
  fbI32Bin(0x6a)
  return 0
}

// `RAtomic`: legacy's atomic arm in `emitAtomicIntrinsic`'s order: the address the builder took
// along `memAddrPlanOf`'s arm, each value, then the instruction at the plan's offset.
function atomic(r: RAtomic) {
  const c = nodeAt(r.amAt)
  if !(c is Call) { return irLMiss("atomic node") }
  const pl = atomicPlanOf(c)
  if pl.apFail != "" { return irLMiss("atomic plan") }
  if pl.apBase == 0 { return atomicTail(pl.apRow, 0) }
  const ap = irAddrPlan(c, pl.apBase)
  if ap.maArm != "const" && ap.maArm != "rest" && ap.maArm != "fold" {
    return irLMiss("atomic plan")
  }
  addrOpnds(r.amArgs, ap)
  return atomicTail(pl.apRow, ap.maOff)
}

// `RAtomic` as a statement: the atomic, then a drop of the value a valued row leaves.
function atomicEffect(r: RAtomic, pending: i32[]): i32 {
  atomic(r)
  irLSettle(pending)
  const c = nodeAt(r.amAt)
  const pl = if c is Call { atomicPlanOf(c) } else { null }
  if pl != null && atomicResultPrim(pl.apRow) != "" { fbDrop() }
  return 0
}

// `RTruncSat`: legacy's saturating-truncation arm, the float operand then `truncSatTail(tsOp)`.
function truncSat(r: RTruncSat) {
  if r.tsOp < 0 { return irLMiss("trunc_sat plan") }
  irLOpnd(r.tsV)
  return truncSatTail(r.tsOp)
}

// `RCallHost`: legacy's host-call arm in `emitCallCoreHost`'s order, the arguments then the call.
function hostCall(r: RCallHost) {
  for a in r.chArgs { irLOpnd(a) }
  hostCallTail(r.chImport)
  if r.chNever { fbUnreachable() }
  return 0
}

// `RListCopy`: legacy's `__array_copy__` arm in `emitArrayCopyIntr`'s order, each list operand
// followed by its backing read, then the copy, at `arrCopyPlanOf`'s pair.
function listCopy(r: RListCopy) {
  const pl = arrCopyPlanOf(r.lcAt, lw.irAt)
  if pl.acWhy != "" || r.lcArgs.length != 5 {
    return irLMiss("list copy refused")
  }
  irLOpnd(r.lcArgs[0])
  arrCopyBacking(pl)
  irLOpnd(r.lcArgs[1])
  irLOpnd(r.lcArgs[2])
  arrCopyBacking(pl)
  irLOpnd(r.lcArgs[3])
  irLOpnd(r.lcArgs[4])
  arrCopyTail(pl)
  return 0
}

// `RMakeList`: legacy's build pair and prologue, then each element, then the short tail at the
// arm `arrLitArmOf` names, in `emitArr`'s order.
function makeList(r: RMakeList) {
  const fnIx = lw.irAt
  const lb: ListBuild = { lbKind: r.mlKind, lbSlot: r.mlSlot }
  arrLitPrologue(r.mlAt)
  const arm = r.mlArm
  // A `for` walk's iterable of constants reads its module list, as legacy's arm does, built here
  // from the elements' immediates (`irForLitHoist`).
  if arrLitIsForIter(r.mlAt) {
    const g = irForLitHoist(r, fnIx, arm)
    if g == -2 { return -1 }
    if g >= 0 {
      for e in r.mlElems { irLSkip(e) }
      return fbGlobalGet(g)
    }
  }
  // A long literal of constants is legacy's data segment, built from the AST's own literals: the
  // operands, immediates the builder held it to, are left unwritten.
  const la = if r.mlAt >= 0 && r.mlAt < P.nodes.length { nodeAt(r.mlAt) } else { null }
  if (
    arm != "ref"
    && arm != "str"
    && arrLitShortWhy(r.mlAt, fnIx, arm, r.mlElems.length) == "long"
    && !(la is ArrayLit
      && arrLitLongRouteOf(la.arrElems, fnIx, arm, lb.lbSlot) != "dataConst")
  ) {
    if !(la is ArrayLit) { return irLMiss("array long node") }
    const a = la
    for e in r.mlElems {
      if !(e is OImm) { return irLMiss("array long element") }
    }
    if arrLitLongRouteOf(a.arrElems, fnIx, arm, lb.lbSlot) != "dataConst" {
      return irLMiss("array long route")
    }
    // A leaf the data segment would write through the expression lowering is no constant here.
    if !arrLitDataSegLeaves(a.arrElems, fnIx, arm, lb.lbSlot) {
      return irLMiss("array long element not a constant leaf")
    }
    for e in r.mlElems { irLSkip(e) }
    const d = arrLitDataTry(a.arrElems, fnIx, arm, lb.lbSlot)
    if d < 0 { return -1 }
    if d == 0 {
      return emitFail(
        "emitProgram: internal: a constant long literal declined its data segment",
      )
    }
    return 0
  }
  // A long literal with computed elements is the segment of its constants, each computed element
  // then stored into it in source order (`arrLitDataOpen`); a constant's immediate is unwritten.
  if (
    la is ArrayLit
    && arm != "ref"
    && arm != "str"
    && arrLitShortWhy(r.mlAt, fnIx, arm, r.mlElems.length) == "long"
    && arrLitLongRouteOf(la.arrElems, fnIx, arm, lb.lbSlot) == "dataComputed"
  ) {
    if la.arrElems.length != r.mlElems.length {
      return irLMiss("array long element")
    }
    if !arrLitDataSegLeaves(la.arrElems, fnIx, arm, lb.lbSlot) {
      return irLMiss("array long element not a constant leaf")
    }
    const dst = arrLitDataOpen(la.arrElems, fnIx, arm, lb.lbSlot)
    if dst < 0 { return irLMiss("array long data") }
    let i = 0
    while i < r.mlElems.length {
      if arrLitElemIsConst(la.arrElems[i]) {
        irLSkip(r.mlElems[i])
      } else {
        arrLitDataStoreAt(dst, i)
        irLOpnd(r.mlElems[i])
        arrLitDataStoreEnd(arm, lb.lbSlot)
      }
      i = i + 1
    }
    return arrLitDataClose(dst, r.mlElems.length, arm, lb.lbSlot)
  }
  // A literal past its arm's chunk size builds in chunks, as the arm's legacy writer does
  // (`arrLitChunkPlanOf`): opened before its elements, each element then the chunk's flush.
  const rs = if arm == "ref" { refLitSlot(r, fnIx, lb) } else { -1 }
  const cp = if arm != "ref" { arrLitChunkPlanOf(arm, lb.lbSlot) } else if rs >= 0 { arrLitChunkPlanOf(arm, rs) } else { null }
  if cp != null && r.mlElems.length > cp.acMax {
    const dst = arrLitChunkOpen(cp, arm, r.mlElems.length)
    let coff = 0
    let i = 0
    for e in r.mlElems {
      irLOpnd(e)
      i = i + 1
      coff = arrLitChunkStep(cp, dst, coff, i, r.mlElems.length)
    }
    return arrLitChunkClose(cp, dst, r.mlElems.length)
  }
  for e in r.mlElems { irLOpnd(e) }
  if arm == "ref" {
    if rs < 0 { return irLMiss("ref list slot") }
    return arrLitRefShortTail(rs, r.mlElems.length)
  }
  if arm == "u8" { return arrLitPackedShortTail(lb.lbSlot, r.mlElems.length) }
  return arrLitShortTail(arm, r.mlElems.length)
}

// The slot ref-list literal `r` builds at: a short arm's or its chunked twin's, else a variant or
// union-box slot's per-element build; -1 for none.
function refLitSlot(r: RMakeList, fnIx: i32, lb: ListBuild): i32 {
  const sl = arrLitRefShortSlot(r.mlAt, fnIx, lb)
  const vs = if sl >= 0 { sl } else { arrLitVariantSlot(r.mlAt, fnIx, lb) }
  const ll = if vs >= 0 { vs } else { arrLitRefLongSlot(r.mlAt, fnIx, lb) }
  const vl = if ll >= 0 { ll } else { arrLitVariantLongSlot(r.mlAt, fnIx, lb) }
  if vl >= 0 { return vl }
  if r.mlAt < 0 || r.mlAt >= P.nodes.length { return -1 }
  const a = nodeAt(r.mlAt)
  return if a is ArrayLit { arrLitUnionLongSlot(r.mlAt, a.arrElems, fnIx, lb) } else { -1 }
}

// `for` iterable `r`'s module list at arm `arm`, as legacy's hoist (`arrLitHoistGlobal`) builds
// it, each element written alone (`forLitElemAt`); where one is none the IR can write, the list
// builds as usual. Its global, -1 where it does not hoist, -2 on a miss.
function irForLitHoist(r: RMakeList, fnIx: i32, arm: ArrLitArm): i32 {
  const t = forLitHoistTysOf(arm)
  const a = if r.mlAt >= 0 && r.mlAt < P.nodes.length { nodeAt(r.mlAt) } else { null }
  if !(a is ArrayLit) || a.arrElems.length != r.mlElems.length { return -1 }
  let i = 0
  while i < r.mlElems.length {
    // An element no constant writes builds the list as usual: the loop only reads it, so the
    // hoist is no more than legacy's saving, and asking legacy's would run its element writers.
    if !forLitElemWrites(r.mlElems[i], t) { return -1 }
    i = i + 1
  }
  if t.fhBack < 0 || !forLitHoistable(r.mlAt, a.arrElems) { return -1 }
  // A global's read of a `const` string literal that is not pooled is no one constant: no hoist.
  i = 0
  while i < r.mlElems.length {
    const e = r.mlElems[i]
    const sx = if e is OVar && isTemp(e.ov) { forLitConstStrOf(a.arrElems[i], fnIx) } else { -1 }
    if sx >= 0 && !forLitStrPooled(sx) { return -1 }
    i = i + 1
  }
  const init: u8[] = []
  i = 0
  while i < r.mlElems.length {
    const one: u8[] = []
    const prev = wTarget(one)
    forLitElemAt(r.mlElems[i], a.arrElems[i], fnIx)
    wTarget(prev)
    if lwMiss != "" { return -2 }
    if !forLitHoistAdd(one, init) { return -1 }
    i = i + 1
  }
  // A variable's read that lowered to a constant is legacy's hoist too, but it reads the element.
  for e in r.mlElems {
    if e is OVar && !isTemp(e.ov) {
      irLMiss("for iterable element")
      return -2
    }
  }
  return forLitHoistClose(init, r.mlElems.length, t)
}

// Whether `for` iterable element `e` is one `forLitElemAt` writes as legacy's hoist
// does: an immediate, a variable's read, or a string global's read.
function forLitElemWrites(e: Opnd, t: ForLitHoistTys): boolean {
  if !(e is OVar) || !isTemp(e.ov) { return true }
  return tempRhs(e.ov) is RGlobalGet
    && t.fhBack >= 0
    && t.fhForm == forLitStrForm()
}

// Writes `for` iterable element `e` (node `x`) alone: a module `const`'s string literal for a
// global's read of one, any other global's read as itself (each pure, skipped where the list
// hoists), else the operand.
function forLitElemAt(e: Opnd, x: i32, fnIx: i32) {
  if e is OVar && isTemp(e.ov) {
    const sx = forLitConstStrOf(x, fnIx)
    if sx >= 0 {
      leaf()
      return emitStrLitAt(sx, fnIx)
    }
    const r = tempRhs(e.ov)
    if !(r is RGlobalGet) { return irLMiss("for iterable element") }
    return globalGetRhs(r)
  }
  return irLOpnd(e)
}

// `RGlobalGet`: the global's read, then the recover its consumer owes.
function globalGetRhs(r: RGlobalGet) {
  globalRead(r.ggSym, r.ggNonNull)
  if r.ggNn > 0 { fbRefAsNonNull() }
  return 0
}

// `RSpread`: legacy's prologue, the source, then the group stash and join `emitArrSpread`'s plain
// arm writes, read off the same plan. A minted literal no walk recorded (a variadic push's run)
// keys its slots by the emission sequence, read here at the point legacy's arm reads it.
function spreadList(r: RSpread) {
  const fnIx = lw.irAt
  const lb: ListBuild = { lbKind: r.spKind, lbSlot: r.spSlot }
  arrLitPrologue(r.spAt)
  if r.spBoxRow >= 0 { return spreadBoxedList(r, fnIx) }
  const p = spreadPlanOf(r.spAt, fnIx, lb)
  if p.spWhy != "" || p.spSrcs.length != r.spSrcs.length {
    return irLMiss("spread plan")
  }
  // The pair is asked where legacy's arm asks it, before the groups, so a first ask mints in order.
  const wrap = spreadWrapIdx(p.spKind, p.spRow)
  const back = spreadBackIdx(p.spKind, p.spRow)
  if wrap < 0 || back < 0 { return irLMiss("spread pair") }
  // Each group's list, then its stash, in source order.
  const seq = liKinds.length
  const slots: i32[] = []
  let g = 0
  while g < r.spSrcs.length {
    irLOpnd(r.spSrcs[g])
    const gs = spreadGroupStash(p, r.spAt, g, r.spGroups[g], fnIx, seq)
    if gs < 0 { return -1 }
    slots.push(gs)
    g = g + 1
  }
  return spreadJoinGroups(
    r.spAt,
    slots,
    p.spGroupRows,
    wrap,
    back,
    p.spKind,
    p.spRow,
    seq,
  )
}

// `RSpread` along legacy's boxing arm: each group's list brought to the union-box row by
// `spreadBoxedGroupTail` and stashed, then the join, as `emitArrSpreadBoxed` writes them.
function spreadBoxedList(r: RSpread, fnIx: i32): i32 {
  const row = r.spBoxRow
  const kk: ListKind = "reflist"
  const wrap = spreadWrapIdx(kk, row)
  const back = spreadBackIdx(kk, row)
  if wrap < 0 || back < 0 { return irLMiss("spread pair") }
  if r.spAt < 0 || r.spAt >= P.nodes.length { return irLMiss("spread node") }
  const a = nodeAt(r.spAt)
  if !(a is ArrayLit) { return irLMiss("spread node") }
  const seq = liKinds.length
  const slots: i32[] = []
  const rows: i32[] = []
  let g = 0
  while g < r.spSrcs.length {
    irLOpnd(r.spSrcs[g])
    const grp = r.spGroups[g]
    let isSrc = false
    for e in a.arrElems {
      if spreadArgOf(e) == grp { isSrc = true }
    }
    if spreadBoxedGroupTail(grp, isSrc, row, fnIx) < 0 { return -1 }
    const gs = spreadGroupSlotAt(r.spAt, g, kk, row, seq)
    if gs < 0 { return -1 }
    fbLocalSet(gs)
    slots.push(gs)
    rows.push(row)
    g = g + 1
  }
  return spreadJoinGroups(r.spAt, slots, rows, wrap, back, kk, row, seq)
}

// The module global map walk receiver `recvIx` names, or -1: a bare name with no local in `fnIx`
// whose declaration is a module `let`. The builder and the lowering both decide by it, so a global
// receiver is read as one and any other is an operand.
export function mapRecvGlobalIx(recvIx: i32, fnIx: i32): i32 {
  if recvIx < 0 || !(nodeAt(recvIx) is Ident) { return -1 }
  const d = identDeclOf(recvIx)
  if d < 0 || localIndexOf(fnIx, recvIx) >= 0 { return -1 }
  if !(nodeAt(d) is LetDecl) { return -1 }
  return globalIndexOfSid(sidOfNode(recvIx))
}

// `SForIn`: legacy's walk (`forInPlainWhy`) in `emitForInStmt`'s order: its loop record at the
// element variable's slot, the list stored, its header hoist, the cursor, the body's index hoists,
// the IR's body in each unrolled copy and the rolled loop, and the scope closed.
function forIn(n: SForIn, pending: i32[]) {
  if n.xfLu { return forInListUnion(n, pending) }
  const fnIx = lw.irAt
  if n.xfAt < 0 { return irLMiss("walk node") }
  const s = nodeAt(n.xfAt)
  if !(s is ForIn) { return irLMiss("walk node") }
  const ek = forInElemKind(s.fiIter, fnIx)
  if ek == null { return irLMiss("walk element") }
  const vSlot = declaredSlotOfDecl(s.fiDecl1)
  if vSlot < 0 { return irLMiss("walk slot") }
  const lp = forInLoopAt(
    s,
    fnIx,
    vSlot,
    ek,
    forInStringSrc(s.fiIter, fnIx),
    forInU8Src(s.fiIter, fnIx),
  )
  if lp == null { return irLMiss("walk backing") }
  if n.xfMap >= 0 {
    if lp.mapRecv < 0 || mapRecvGlobalIx(lp.mapRecv, fnIx) != n.xfMap {
      return irLMiss("walk map")
    }
    irLSettle(pending)
    globalRead(n.xfMap, n.xfMapNonNull)
    mapRecvRefTail(lp.mapRecv, fnIx)
    forInMapStash(fnIx, lp)
    forInMapList(s.fiIter, fnIx, lp.mwShape)
  } else if lp.mapRecv >= 0 {
    // A receiver read as an operand (a local, or a global the builder reads narrowed to its map)
    // is written where legacy's stash writes it, then recovered.
    cond(n.xfList, pending)
    mapRecvRefTail(lp.mapRecv, fnIx)
    forInMapStash(fnIx, lp)
    forInMapList(s.fiIter, fnIx, lp.mwShape)
  } else {
    if lp.mapRecv >= 0 { return irLMiss("walk map") }
    cond(n.xfList, pending)
    if forInListSync(s.fiIter, fnIx) < 0 { return irLMiss("walk list") }
  }
  forInListStore(s.fiIter, fnIx, lp)
  forInHeaderHoist(s, fnIx, lp)
  emitForInCursorInit(lp)
  // A second name is the local legacy's walk binds it at (`forInPairSlotOf`).
  const pair = s.fiVar2 != ""
  if pair && (n.xfVar2 < 0 || varSlot(n.xfVar2) != lp.pIdx) {
    return irLMiss("walk pair slot")
  }
  forInPairInit(s, lp)
  const h = irLoopHoistOpen(-1, s.fiBody, s.fiDecl1, s.fiDecl2)
  if h < 0 { return irLMiss("walk hoists") }
  scopeBind(s.fiVar, vSlot)
  if pair { scopeBind(s.fiVar2, forInPairSlotOf(vSlot)) }
  let d0 = ctrlDepth
  forInBreakOpen(s)
  const kb = walkFrames(n, d0)
  // The unrolled copies, each the IR's body over the element its copy binds.
  const c = forInCopiesOf(s, fnIx, lp)
  const marks = tempMarks()
  if c != null {
    d0 = ctrlDepth
    forInCopiesHead(c)
    const kh = walkFrames(n, d0)
    let k = 0
    while k < forInCopyCount() {
      d0 = ctrlDepth
      forInCopyOpen(s, c, k)
      const kc = walkFrames(n, d0)
      tempMarksRestore(marks)
      body(n.xfBody, false, -1, false)
      framesPop(kc)
      forInCopyClose(c)
      k = k + 1
    }
    framesPop(kh)
    forInCopiesTail(c)
  }
  d0 = ctrlDepth
  const seq = forInRolledOpen(s, lp)
  if seq == -2 { return irLMiss("walk loop") }
  const kr = walkFrames(n, d0)
  tempMarksRestore(marks)
  body(n.xfBody, false, -1, false)
  framesPop(kr)
  framesPop(kb)
  forInLoopClose(s, lp, seq)
  loopHoistClose(h)
  if pair { scopeUnbind() }
  scopeUnbind()
  return 0
}

// `SRangeLoop`: legacy's partial or wrapping range loop in `emitForRangeStmt`'s order, its blocks
// and loops written by legacy's helpers around the IR's bodies, the scratch slots taken in order.
function rangeLoop(n: SRangeLoop, pending: i32[]) {
  const fnIx = lw.irAt
  if n.rlAt < 0 { return irLMiss("range node") }
  const s = nodeAt(n.rlAt)
  if !(s is ForRange) { return irLMiss("range node") }
  const rt = forRangeTestOf(s, n.rlAt, fnIx)
  if rt.vIdx < 0 || rt.vIdx != varSlot(n.rlVar) { return irLMiss("range slot") }
  const wraps = rangeMayWrap(s, rt)
  irLSettle(pending)
  const hoists = irLoopOpenHook(n.rlAt)
  if hoists.loHoists < 0 { return irLMiss("loop hoist prologue") }
  scopeBind(s.frVar, declaredSlotOfDecl(n.rlAt))
  let kb = 0
  if n.rlPartial {
    if n.rlCopies.length != rangePartialCopies(rt, wraps) {
      return irLMiss("range copies")
    }
    let d0 = ctrlDepth
    rangePartialOuterOpen(s)
    kb = loopFrames(n.rlBrk, -1, d0)
    d0 = ctrlDepth
    const u = rangePartialMainOpen(rt, wraps)
    const km = loopFrames(n.rlBrk, -1, d0)
    const hasCont = blockHasContinueFor(s.frBody, s.frLabel, false)
    let k = 0
    while k < n.rlCopies.length {
      d0 = ctrlDepth
      rangePartialCopyOpen(s, rt, u, k, hasCont)
      const kc = loopFrames(n.rlBrk, n.rlConts[k], d0)
      body(n.rlCopies[k], false, -1, false)
      framesPop(kc)
      rangePartialCopyClose(hasCont)
      k = k + 1
    }
    if u >= 0 { rangePartialMainClose(rt, u) }
    framesPop(km)
  }
  const d1 = ctrlDepth
  const hasTailCont = emitRangeRolledHead(s, rt)
  const kt = loopFrames(n.rlTailBrk, n.rlTailCont, d1)
  body(n.rlTail, false, -1, false)
  framesPop(kt)
  emitRangeRolledTail(rt, wraps, hasTailCont)
  if n.rlPartial {
    framesPop(kb)
    rangePartialOuterClose()
  }
  irLoopCloseHook(hoists)
  scopeUnbind()
  return 0
}

// `SForIn` over a union of lists' box (`xfLu`): the box in the walk's list slot, then one loop
// whose bound and element are each read off the arm the box holds, the cursor stepped before the
// body as legacy's union walk steps it.
function forInListUnion(n: SForIn, pending: i32[]) {
  const fnIx = lw.irAt
  if n.xfAt < 0 { return irLMiss("walk node") }
  const s = nodeAt(n.xfAt)
  if !(s is ForIn) { return irLMiss("walk node") }
  const lp = luForWalkPlanOf(s, fnIx)
  if lp.lbWhy != "" { return irLMiss("walk list union") }
  const vSlot = declaredSlotOfDecl(s.fiDecl1)
  const vIdx = varSlot(n.xfVar)
  if vSlot < 0 || vIdx < 0 { return irLMiss("walk slot") }
  const iIdx = vIdx + 1
  const lIdx = vIdx + 2
  const pair = s.fiVar2 != ""
  if pair && (n.xfVar2 < 0 || varSlot(n.xfVar2) != vIdx + 3) {
    return irLMiss("walk pair slot")
  }
  cond(n.xfList, pending)
  fbLocalSet(lIdx)
  fbI32Const(0)
  fbLocalSet(iIdx)
  const h = irLoopHoistOpen(-1, s.fiBody, s.fiDecl1, s.fiDecl2)
  if h < 0 { return irLMiss("walk hoists") }
  scopeBind(s.fiVar, vSlot)
  if pair { scopeBind(s.fiVar2, forInPairSlotOf(vSlot)) }
  const d0 = ctrlDepth
  forInBreakOpen(s)
  fbLoop(64) // 0x03 loop, void
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.fiLabel)
  const k = walkFrames(n, d0)
  fbLocalGet(iIdx)
  luForLenChain(lIdx, lp.lbPlan, 0)
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)
  if luForElemChain(lIdx, iIdx, lp.lbPlan, 0) < 0 {
    return irLMiss("walk element")
  }
  fbLocalSet(vIdx)
  if pair {
    fbLocalGet(iIdx)
    fbLocalSet(vIdx + 3)
  }
  fbLocalGet(iIdx)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iIdx)
  body(n.xfBody, false, -1, false)
  framesPop(k)
  fbBr(0)
  fbEnd()
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd()
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  loopHoistClose(h)
  if pair { scopeUnbind() }
  scopeUnbind()
  return 0
}

// Pushes a frame for each block legacy opened past depth `d0`: the walk's break block and its
// current continue target carry its labels. Returns the count, for `framesPop`.
function walkFrames(n: SForIn, d0: i32): i32 {
  return loopFrames(n.xfBrk, n.xfCont, d0)
}

// Pushes a frame for each block legacy opened past depth `d0`: its innermost break block and
// continue target carry labels `brk` and `cont`. Returns the count, for `framesPop`.
function loopFrames(brk: i32, cont: i32, d0: i32): i32 {
  const brkAt = if loopBrkDepth.length > 0 { loopBrkDepth[loopBrkDepth.length - 1] } else { -1 }
  const contAt = if loopContDepth.length > 0 { loopContDepth[loopContDepth.length - 1] } else { -1 }
  let k = 0
  while d0 + k < ctrlDepth {
    const at = d0 + 1 + k
    lwFrames.push(
      if at == brkAt { brk } else if at == contAt { cont } else { -1 },
    )
    k = k + 1
  }
  return k
}

// The temps' definition and use marks, so a body lowered once per unrolled copy defines and uses
// its temps afresh each time.
type TempMarks = { tmDef: boolean[], tmUsed: boolean[], tmStack: boolean[] }

function tempMarks(): TempMarks {
  const m: TempMarks = { tmDef: [], tmUsed: [], tmStack: [] }
  marksCopy(lwTempDef, m.tmDef)
  marksCopy(lwTempUsed, m.tmUsed)
  marksCopy(lwStackVal, m.tmStack)
  return m
}

function tempMarksRestore(m: TempMarks) {
  lwTempDef = []
  lwTempUsed = []
  lwStackVal = []
  marksCopy(m.tmDef, lwTempDef)
  marksCopy(m.tmUsed, lwTempUsed)
  marksCopy(m.tmStack, lwStackVal)
  return 0
}

function marksCopy(from: boolean[], to: boolean[]) {
  for b in from { to.push(b) }
  return 0
}

function framesPop(k: i32) {
  let i = 0
  while i < k {
    lwFrames.pop()
    i = i + 1
  }
  return 0
}

// `RPrintOpen`: legacy's two blocks a nullable string's or boolean's print opens before its
// operand, each an open frame until the opened `RPrint` closes them.
function printOpen(r: RPrintOpen) {
  if r.poArm == 1 { printNulBoolOpen() } else { printNulStrOpen() }
  lwFrames.push(-1)
  lwFrames.push(-1)
  return 0
}

// `RPrint`: the argument, then legacy's tail for the arm `printArmOf` names, a string stream or
// one scalar print import.
function printOp(r: RPrint) {
  if r.pnAt < 0 { return irLMiss("print node") }
  const c = nodeAt(r.pnAt)
  if !(c is Call) || c.callArgs.length != 1 { return irLMiss("print node") }
  const arm = printArmOf(c.callArgs[0], lw.irAt)
  // A `null`-typed argument's effect is the builder's own nodes; the print is the word alone.
  if arm == "nulNone" { return emitPrintNullWord() }
  // A print an `RPrintOpen` opened before its operand's statements writes only the operand and
  // the tail, and closes the two frames the open pushed.
  if r.pnOpened >= 0 {
    if (
      r.pnOpened
      != (if arm == "nulBool" { 1 } else if arm == "nulStr" { 0 } else { -1 })
    ) {
      return irLMiss("print open arm")
    }
    irLOpnd(r.pnV)
    const rc = if r.pnOpened == 1 { printNulBoolTail() } else { printNulStrTail() }
    lwFrames.pop()
    lwFrames.pop()
    return rc
  }
  if arm == "nulStr" {
    printNulStrOpen()
    irLOpnd(r.pnV)
    return printNulStrTail()
  }
  if arm == "nulBool" {
    printNulBoolOpen()
    irLOpnd(r.pnV)
    return printNulBoolTail()
  }
  if arm == "nulRefNiche" {
    const stored = readNarrowedBoxToNull(c.callArgs[0], lw.irAt)
    const mark = if stored { storageReadEnter(c.callArgs[0]) } else { storageReadEnter(-1) }
    irLOpnd(r.pnV)
    storageReadLeave(mark)
    return printNulRefNicheTail()
  }
  if arm == "union" {
    // Legacy reads the plan, writes the box, then takes the stash slot.
    const kinds: i32[] = []
    printUnionPlan(c.callArgs[0], lw.irAt, kinds)
    irLOpnd(r.pnV)
    return printUnionTail(sharedFieldRecvSlot(), kinds)
  }
  // A box narrowed to `null` prints at its storage along the union arm, its plan pinned to keep
  // the null arm (`emitCallCorePrint`'s `boxNull`).
  if arm == "boxNull" { return printBoxNullOp(r, c.callArgs[0]) }
  irLOpnd(r.pnV)
  if arm == "str" { return printStrTail() }
  if arm == "atom" || arm == "nulAtom" || arm == "nulLitPin" {
    return printAtomTail(arm, c.callArgs[0], lw.irAt)
  }
  return printScalarTail(arm)
}

// `RPrint` of `boxNull` argument `arg`: the union arm's plan, box and tail inside the storage
// scope and the plan's null pin legacy writes them under.
function printBoxNullOp(r: RPrint, arg: i32) {
  const mark = storageReadEnter(arg)
  const was = printPlanPinNull(true)
  const kinds: i32[] = []
  const union = printArmOf(arg, lw.irAt) == "union"
  if union {
    printUnionPlan(arg, lw.irAt, kinds)
    irLOpnd(r.pnV)
  }
  const rc = if union { printUnionTail(sharedFieldRecvSlot(), kinds) } else { irLMiss("print boxNull arm") }
  printPlanPinNull(was)
  storageReadLeave(mark)
  return rc
}

// `RMapGetOr`, inline: the global, its recovery, the key and the op context, then legacy's probe,
// its plain read's head, the default and the tail. Otherwise legacy's `__map_get_<row>__` helper
// minted first, then the global, its recovery,
// the key and the op context, then the call, as `emitMapGetCall` writes them.
function mapGetOr(r: RMapGetOr) {
  const fnIx = lw.irAt
  if r.mgAt < 0 { return irLMiss("map read node") }
  const e = nodeAt(r.mgAt)
  if !(e is BinExpr) { return irLMiss("map read node") }
  const lhsIx = unwrapParen(e.binLeft)
  if lhsIx < 0 { return irLMiss("map read node") }
  const rd = nodeAt(lhsIx)
  if !(rd is Index) { return irLMiss("map read node") }
  // The scalar join: the probe, the hit boxed at its own arm, the boxed default, the `end`.
  if r.mgForm == 7 {
    if coalArmOf(e, r.mgAt, fnIx) != "mapScalarJoin" {
      return irLMiss("map read route")
    }
    if r.mgSym >= 0 && userGlobalReadClass(r.mgSym, lwGlobalCtx) != "plain" {
      return irLMiss("map read of a global not read plainly")
    }
    mapProbeHead(rd.idxArr, r.mgSym, r.mgNonNull, r.mgLoc, r.mgKey)
    mapScalarJoinOpen(mapRecvScalarBoxKindIn(rd.idxArr, fnIx))
    irLOpnd(r.mgDef)
    fbEnd()
    return 0
  }
  const rk = coalResultKindOf(r.mgAt, fnIx)
  const arm = mapGetOrArmOf(rd.idxArr, e.binRight, fnIx, rk)
  const want = mapGetOrFormArm(r.mgForm, arm)
  if (
    arm != want
    || r.mgForm == 2 && !mapGetOrMvPlain(rd.idxArr, e.binRight, fnIx)
    || r.mgForm == 3 && mapGetOrUnionPlanAt(rd.idxArr, e.binRight, rk).muKind < 0
    || r.mgForm == 4 && !mapGetOrNicheStash(rd.idxArr, e.binRight, fnIx)
    || r.mgForm == 5
      && !mapGetOrUnionBoxOf(mapRecvShapeOf(rd.idxArr, fnIx), e.binRight)
  ) {
    return irLMiss("map read route")
  }
  if r.mgSym >= 0 && userGlobalReadClass(r.mgSym, lwGlobalCtx) != "plain" {
    return irLMiss("map read of a global not read plainly")
  }
  if r.mgForm > 0 {
    const sh = mapGetOrInlineHead(
      rd.idxArr,
      r.mgForm,
      r.mgSym,
      r.mgNonNull,
      r.mgLoc,
      r.mgKey,
      mapGetOrUnionPlanAt(rd.idxArr, e.binRight, rk),
    )
    irLOpnd(r.mgDef)
    return mapGetOrInlineTail(
      r.mgForm,
      sh,
      mapGetOrUnionPlanAt(rd.idxArr, e.binRight, rk),
    )
  }
  const miss = mapGetOrHelperRoute(rd.idxArr, e.binRight, fnIx, rk)
  const fi = mapGetHelperFnOf(rd.idxArr, fnIx, miss[0])
  mapRecvRead(r.mgSym, r.mgNonNull, r.mgLoc)
  mapRecvRefTail(rd.idxArr, fnIx)
  irLOpnd(r.mgKey)
  mapRecvKeyTail(mapRecvShapeOf(rd.idxArr, fnIx))
  fbCall(fi)
  return 0
}

// A map read's probe: global `sym` or receiver `loc`, its ref tail, key `key`, and the probe that
// leaves the entry, as `emitMapPrep` writes them. Returns the receiver's shape.
function mapProbeHead(
  recvIx: i32,
  sym: i32,
  nonNull: boolean,
  loc: Opnd,
  key: Opnd,
): i32 {
  const fnIx = lw.irAt
  const sh = mapRecvShapeOf(recvIx, fnIx)
  mapRecvRead(sym, nonNull, loc)
  mapRecvRefTail(recvIx, fnIx)
  irLOpnd(key)
  mapRecvKeyTail(sh)
  mapPrepProbeTail()
  return sh
}

// `RMapGet`, a bare `m[k]` by legacy's arm (`mapGetArmOf`): the global or receiver and the key
// into `__map_get_<row>__` with the read's miss value, or the probe and its value tail; then the
// narrowed read's tail.
function mapGet(r: RMapGet) {
  const fnIx = lw.irAt
  const nd = nodeAt(r.mtAt)
  if !(nd is Index) { return irLMiss("map get node") }
  if r.mtSym >= 0 && userGlobalReadClass(r.mtSym, lwGlobalCtx) != "plain" {
    return irLMiss("map get of a global not read plainly")
  }
  // `print`'s read: the probe, then the value or `null` printed (`printScalarMapTail`).
  if r.mtPrint >= 0 {
    mapProbeHead(nd.idxArr, r.mtSym, r.mtNonNull, r.mtLoc, r.mtKey)
    return printScalarMapTail(r.mtPrint)
  }
  // `as!`'s read: the probe, then its trap on a miss and the stored value.
  if r.mtTrap {
    mapProbeHead(nd.idxArr, r.mtSym, r.mtNonNull, r.mtLoc, r.mtKey)
    return asMapProbeTrapTail()
  }
  // The box plan's scalar read: the probe, then the box of its hit or its null.
  if r.mtBox >= 0 {
    mapProbeHead(nd.idxArr, r.mtSym, r.mtNonNull, r.mtLoc, r.mtKey)
    return emitMapGetScalarBoxTail(r.mtBox)
  }
  const arm = mapGetArmOf(r.mtAt, fnIx)
  match arm {
    "unionBox" => {
      mapProbeHead(nd.idxArr, r.mtSym, r.mtNonNull, r.mtLoc, r.mtKey)
      if mapGetUnionBoxTail() < 0 { return -1 }
      // The box plan's whole read writes no narrowing unbox after it.
      if r.mtWhole { return 0 }
    }
    "helper" => {
      const fi = mapGetHelperFnOf(
        nd.idxArr,
        fnIx,
        mapGetMissOf(nd.idxArr, fnIx),
      )
      mapRecvRead(r.mtSym, r.mtNonNull, r.mtLoc)
      mapRecvRefTail(nd.idxArr, fnIx)
      irLOpnd(r.mtKey)
      mapRecvKeyTail(mapRecvShapeOf(nd.idxArr, fnIx))
      fbCall(fi)
    }
    "inline" => {
      mapProbeHead(nd.idxArr, r.mtSym, r.mtNonNull, r.mtLoc, r.mtKey)
      emitMapGetTail(nd.idxArr, fnIx)
    }
  }
  return emitNarrowedMapReadTail(r.mtAt, fnIx)
}

// An inline `??` map read's head, up to the miss arm's `else`: the probe, then the `i32` read's
// or mv slot read's open by `form`. Returns the receiver's shape for the tail.
function mapGetOrInlineHead(
  recvIx: i32,
  form: i32,
  sym: i32,
  nonNull: boolean,
  loc: Opnd,
  key: Opnd,
  qp: MapUnionPlan,
): i32 {
  const sh = mapProbeHead(recvIx, sym, nonNull, loc, key)
  if form == 6 {
    mapGetOrSentinelHead(mapGetOrSentinel(mapRecvTyIn(recvIx, lw.irAt)))
  } else if form == 5 {
    mapGetOrUnionHead(sh)
    mapGetOrUnionBoxOpen(sh)
  } else if form == 4 {
    mapGetOrNicheHead(sh)
  } else if form == 3 {
    mapGetOrUnionHead(sh)
    mapGetOrUnionScalarOpen(sh, qp)
  } else if form == 2 {
    mapGetOrMvHead(sh)
  } else {
    mapGetOrI32Head()
  }
  return sh
}

// The legacy arm (`mapGetOrArmOf`) inline form `form` writes: the plain `i32` read (1), an
// atom-valued map's being that read; an mv slot's (2-5); the sentinel's (6); else the helper.
function mapGetOrFormArm(form: i32, arm: MapGetOrArm): MapGetOrArm {
  if form == 1 { return if arm == "atom" { "atom" } else { "i32" } }
  if form == 6 { return "sentinel" }
  return if form >= 2 { "mv" } else { "helper" }
}

// An inline map read's tail after its default, by `form`.
function mapGetOrInlineTail(form: i32, sh: i32, qp: MapUnionPlan) {
  if form == 6 { return mapGetOrSentinelTail() }
  if form == 5 { return mapGetOrUnionBoxTail(sh) }
  if form == 4 { return mapGetOrNicheTail(sh) }
  if form == 3 { return mapGetOrUnionScalarTail(sh, qp) }
  return if form == 2 { mapGetOrMvTail(sh) } else { mapGetOrI32Tail() }
}

// The scalar union plan of `recvIx[k] ?? defIx` at result kind `rk` (`mapGetOrUnionScalarPlanOf`).
function mapGetOrUnionPlanAt(recvIx: i32, defIx: i32, rk: i32): MapUnionPlan {
  return mapGetOrUnionScalarPlanOf(mapRecvShapeOf(recvIx, lw.irAt), defIx, rk)
}

// The fused map read whose default computes: the route `mapGetOr` checks, the shared head, the
// default body writing the slotless out in the miss arm, and the tail.
function coalMapGetOr(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const mp = n.cbMap
  if mp == null { return irLMiss("map read probe") }
  const fnIx = lw.irAt
  const lhsIx = unwrapParen(e.binLeft)
  const rd = if lhsIx >= 0 { nodeAt(lhsIx) } else { null }
  if !(rd is Index) { return irLMiss("map read node") }
  const rk = coalResultKindOf(n.cbAt, fnIx)
  const arm = mapGetOrArmOf(rd.idxArr, e.binRight, fnIx, rk)
  const want = mapGetOrFormArm(mp.prForm, arm)
  if (
    arm != want
    || want == "helper"
    || mp.prForm == 2 && !mapGetOrMvPlain(rd.idxArr, e.binRight, fnIx)
    || mp.prForm == 3 && mapGetOrUnionPlanAt(rd.idxArr, e.binRight, rk).muKind < 0
    || mp.prForm == 4 && !mapGetOrNicheStash(rd.idxArr, e.binRight, fnIx)
    || mp.prForm == 5
      && !mapGetOrUnionBoxOf(mapRecvShapeOf(rd.idxArr, fnIx), e.binRight)
  ) {
    return irLMiss("map read route")
  }
  if mp.prSym >= 0 && userGlobalReadClass(mp.prSym, lwGlobalCtx) != "plain" {
    return irLMiss("map read of a global not read plainly")
  }
  lwSeq = []
  const sh = mapGetOrInlineHead(
    rd.idxArr,
    mp.prForm,
    mp.prSym,
    mp.prNonNull,
    n.cbL,
    mp.prKey,
    mapGetOrUnionPlanAt(rd.idxArr, e.binRight, rk),
  )
  irLSettle(pending)
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  mapGetOrInlineTail(
    mp.prForm,
    sh,
    mapGetOrUnionPlanAt(rd.idxArr, e.binRight, rk),
  )
  return 0
}

// A map operation's receiver: global `sym` read as legacy reads it, or receiver operand `loc`.
function mapRecvRead(sym: i32, nonNull: boolean, loc: Opnd) {
  if sym >= 0 { return globalRead(sym, nonNull) }
  return irLOpnd(loc)
}

// `RMapOp`: `size` is the receiver, then legacy's live entry count read (`mapSizeTail`).
function mapOp(r: RMapOp) {
  return match r.mpOp {
    "size" => {
      const m = nodeAt(r.mpAt)
      if !(m is Member) || r.mpArgs.length != 1 {
        return irLMiss("map size node")
      }
      if !mapLengthPlain(m, r.mpAt, lw.irAt) {
        return irLMiss("map size route")
      }
      irLOpnd(r.mpArgs[0])
      mapSizeTail(m.memObj, lw.irAt)
    }
    "has" | "set" | "delete" | "keys" => irLMiss("map op " + r.mpOp)
  }
}

// `RMapIter`: legacy's keys or values writer, the receiver read before each of its steps, again as
// the builder read it (`opndAgain`), or once into a local under `miOnce`. A Set's values are its keys.
function mapIter(r: RMapIter) {
  const c = nodeAt(r.miAt)
  if !(c is Call) || c.callFn < 0 { return irLMiss("map iter node") }
  const m = nodeAt(c.callFn)
  if !(m is Member) { return irLMiss("map iter node") }
  const keys = !r.miVals || mapValuesAreKeys(m.memObj, lw.irAt)
  if keys && !fnUses.mapKeys || !keys && !fnUses.mapVals {
    return irLMiss("map iter frame")
  }
  const q = if keys { mapKeysFrameOf(m.memObj, lw.irAt) } else { mapValsFrameOf(m.memObj, lw.irAt) }
  // A receiver no read repeats is evaluated once; each step reads it from a local.
  if r.miOnce {
    const s = irOnceRefSlot(q.mqMapTy)
    irLOpnd(r.miV)
    fbLocalSet(s)
    for step in [0, 1, 2] {
      fbLocalGet(s)
      mapListStep(q, step)
    }
    return 0
  }
  for step in [0, 1, 2] {
    if step == 0 { irLOpnd(r.miV) }
    else if opndAgain(r.miV, m.memObj) < 0 { return -1 }
    mapListStep(q, step)
  }
  return 0
}

// `RMapEq`: a scalar map read against an operand as `emitScalarMapReadOtherEq` writes it: the
// probe, its hit and value, the operand in source order, the compare, then `!=`'s negation.
function mapEq(r: RMapEq) {
  const fnIx = lw.irAt
  const e = nodeAt(r.mqAt)
  if !(e is BinExpr) { return irLMiss("map compare node") }
  const p = scalarMapEqPlanOf(e, fnIx)
  const rd = nodeAt(unwrapParen(p.smRead))
  if p.smArm != "read" || !(rd is Index) { return irLMiss("map compare plan") }
  if r.mqSym >= 0 && userGlobalReadClass(r.mqSym, lwGlobalCtx) != "plain" {
    return irLMiss("map compare of a global not read plainly")
  }
  const left = p.smRead == e.binLeft
  if !left { irLOpnd(r.mqOther) }
  mapProbeHead(rd.idxArr, r.mqSym, r.mqNonNull, r.mqLoc, r.mqKey)
  if scalarMapEqReadTail(rd.idxArr, left, fnIx) < 0 { return -1 }
  if left { irLOpnd(r.mqOther) }
  scalarMapEqTail(p.smKind, left)
  if e.binOp == "!=" { fbI32Eqz() }
  return 0
}

// `RMapHas`: the global, its recovery, the key and the op context, then legacy's probe and hit flag.
function mapHas(r: RMapHas) {
  const fnIx = lw.irAt
  if r.mhSym >= 0 && userGlobalReadClass(r.mhSym, lwGlobalCtx) != "plain" {
    return irLMiss("map has of a global not read plainly")
  }
  const sh = mapRecvShapeOf(r.mhRecv, fnIx)
  mapRecvRead(r.mhSym, r.mhNonNull, r.mhLoc)
  mapRecvRefTail(r.mhRecv, fnIx)
  irLOpnd(r.mhKey)
  mapRecvKeyTail(sh)
  return mapHasTail()
}

// `RMapDelete`: the global, its recovery, the key and the op context, then legacy's probe and the
// entry's tombstone.
function mapDelete(r: RMapDelete) {
  const fnIx = lw.irAt
  if r.mdSym >= 0 && userGlobalReadClass(r.mdSym, lwGlobalCtx) != "plain" {
    return irLMiss("map delete of a global not read plainly")
  }
  const sh = mapRecvShapeOf(r.mdRecv, fnIx)
  mapRecvRead(r.mdSym, r.mdNonNull, r.mdLoc)
  mapRecvRefTail(r.mdRecv, fnIx)
  irLOpnd(r.mdKey)
  mapRecvKeyTail(sh)
  return mapDeleteTail()
}

// `RMapClear`: the global, its recovery and the op context, then legacy's reset in place.
function mapClear(r: RMapClear) {
  if r.mcSym >= 0 && userGlobalReadClass(r.mcSym, lwGlobalCtx) != "plain" {
    return irLMiss("map clear of a global not read plainly")
  }
  mapRecvRead(r.mcSym, r.mcNonNull, r.mcLoc)
  mapRecvRefTail(r.mcRecv, lw.irAt)
  return mapClearTail(mapRecvShapeOf(r.mcRecv, lw.irAt))
}

// `RMapSet`: the global, its recovery, the key and the op context, then the value and legacy's
// store tail, as `emitMapSetV` writes them.
function mapSet(r: RMapSet) {
  const fnIx = lw.irAt
  if r.msSym >= 0 && userGlobalReadClass(r.msSym, lwGlobalCtx) != "plain" {
    return irLMiss("map set of a global not read plainly")
  }
  const sh = mapRecvShapeOf(r.msRecv, fnIx)
  // A global receiver staged below a short-circuit value is its read's temp, which must be
  // that global read at the store's recovery (`mapSetStageLeads`).
  const staged = r.msSym >= 0 && r.msLoc is OVar
  if staged && !stagedGlobalRead(r.msLoc, r.msSym, r.msNonNull) {
    return irLMiss("map store staged receiver is not its global's read")
  }
  if staged {
    irLOpnd(r.msLoc)
  } else {
    mapRecvRead(r.msSym, r.msNonNull, r.msLoc)
  }
  mapRecvRefTail(r.msRecv, fnIx)
  irLOpnd(r.msKey)
  mapRecvKeyTail(sh)
  irLOpnd(r.msVal)
  mapSetTail(sh, mapRecvIsSet(r.msRecv, fnIx), r.msPark)
  return 0
}

// Whether operand `o` is a temp defined by the read of global `sym` recovered as `nonNull`. A
// staged temp is on the stack, so its definition is read here and never rewritten (`tempRhs`).
function stagedGlobalRead(o: Opnd, sym: i32, nonNull: boolean): boolean {
  if !(o is OVar) || !isTemp(o.ov) || !tempDefined(o.ov) { return false }
  if o.ov >= lwTempRhs.length { return false }
  const r = lwTempRhs[o.ov]
  return r is RGlobalGet && r.ggSym == sym && r.ggNonNull == nonNull
}

// `RAtomEq`: each side as itself, or a static side through legacy's own literal writer spelled as
// the member the shared plan names, then the shared `i32.eq` (and `i32.eqz`) tail.
function atomEq(r: RAtomEq) {
  const n = nodeAt(r.aeAt)
  if !(n is BinExpr) { return irLMiss("atom compare node") }
  const p = atomEqPlanOf(n, lw.irAt)
  // Two literal sides fold: each side's id dropped, then the constant.
  if r.aeStatic == 3 {
    if p.aqArm != "fold" { return irLMiss("atom compare plan") }
    staticSide(r.aeL, p.aqLex)
    atomFoldSideTail()
    staticSide(r.aeR, p.aqLexR)
    atomFoldSideTail()
    return atomFoldTail(p, r.aeNe)
  }
  const want = if r.aeStatic == 0 { "ids" } else { "static" }
  if (
    p.aqArm != want
    || (r.aeStatic == 1 || r.aeStatic == 4) && !p.aqStaticLeft
    || r.aeStatic == 2 && p.aqStaticLeft
  ) {
    return irLMiss("atom compare plan")
  }
  if r.aeStatic == 1 { staticSide(r.aeL, p.aqLex) } else { irLOpnd(r.aeL) }
  if r.aeStatic == 2 { staticSide(r.aeR, p.aqLex) } else { irLOpnd(r.aeR) }
  return atomEqTail(r.aeNe)
}

// An atom compare's static side: its operand evaluated and dropped unless it is the literal's
// unread immediate, then the id of the member lexeme `lex`.
function staticSide(o: Opnd, lex: string) {
  if o is OImm {
    leaf()
  } else {
    irLOpnd(o)
    fbDrop()
  }
  return staticAtomId(lex)
}

// `RUnionConcreteEq`: legacy's plan around the box read twice, or once into the stash, and the
// operand once (the tag test, the payload, the compare), as `emitUnionConcreteEq` writes it.
function unionConcreteEqOp(r: RUnionConcreteEq) {
  const n = nodeAt(r.ucAt)
  if !(n is BinExpr) { return irLMiss("union compare node") }
  const boxIx = if r.ucSwap { n.binRight } else { n.binLeft }
  const otherIx = if r.ucSwap { n.binLeft } else { n.binRight }
  if r.ucNul { return unionNulEq(r, boxIx, otherIx) }
  const qp = if r.ucStash { unionEqStashPlanOf(boxIx, otherIx, lw.irAt) } else { unionConcreteEqPlanOf(boxIx, otherIx, lw.irAt) }
  if qp.uqKind < 0 { return irLMiss("union compare plan") }
  unionEqHead()
  irLOpnd(r.ucBox)
  if r.ucStash {
    unionEqStashTail(qp)
  } else {
    unionEqTagTail(qp)
    if boxAgain(r, boxIx) < 0 { return -1 }
  }
  unionEqPayloadTail(qp)
  irLOpnd(r.ucOther)
  return unionEqCmpTail(qp, r.ucNe, lw.irAt)
}

// A union compare's box read once more: its variable, or its read written again (`opndAgain`).
function boxAgain(r: RUnionConcreteEq, boxIx: i32): i32 {
  if !r.ucAgain {
    irLOpnd(r.ucBox)
    return 0
  }
  return opndAgain(r.ucBox, boxIx)
}

// `RUnionConcreteEq` on legacy's null leg: the operand's null test, the box's null tag (or 0), then
// the plain arm under the leg's `else`, through the tails legacy writes. A side `ucStage` names as
// parked is read from its slot (`unionStageEffect`'s ops 4 to 6).
function unionNulEq(r: RUnionConcreteEq, boxIx: i32, otherIx: i32): i32 {
  // The staging is the node's (`ucStage`); the plan gives only the leg, its arm and the box's `null`.
  const np = unionEqNulPlanOf(boxIx, otherIx, false, lw.irAt)
  if np.unLeg == 0 { return irLMiss("union compare null plan") }
  const qp = np.unPlan
  const leg = np.unLeg
  const boxSt = (r.ucStage & 1) != 0
  const opSt = (r.ucStage & 2) != 0
  const opFirst = (r.ucStage & 4) != 0
  if r.ucStage == 0 { unionEqHead() }
  if opFirst {
    fbLocalGet(unionEqNulOpSlot(leg))
  } else {
    irLOpnd(r.ucOther)
    if opSt { fbLocalTee(unionEqNulOpSlot(leg)) }
  }
  unionEqNulTestTail(leg)
  // The box's first read is its own; each later one its read written again (`ucAgain`).
  let first = true
  if np.unBoxNul {
    parkedOr(boxSt, r.ucBox)
    first = false
    unionEqNullTagTail()
  } else {
    unionEqNoNullTail()
  }
  unionEqNulElse()
  if boxSt || first { parkedOr(boxSt, r.ucBox) }
  else if boxAgain(r, boxIx) < 0 { return -1 }
  unionEqTagTail(qp)
  if boxSt { parkedOr(true, r.ucBox) }
  else if boxAgain(r, boxIx) < 0 { return -1 }
  unionEqPayloadTail(qp)
  // The plain arm's operand: read again, read in place, or from its slot; a `K | null` id is
  // then decoded to its member string, as `emitUnionEqOther` writes it.
  if r.ucOtherAgain {
    if opndAgain(r.ucOther, otherIx) < 0 { return -1 }
  } else if !opSt {
    irLOpnd(r.ucOther)
  } else {
    fbLocalGet(unionEqNulOpSlot(leg))
  }
  if leg == 1 && unionEqAtomOperandTail(otherIx, lw.irAt) < 0 { return -1 }
  if unionEqNulEndTail(qp, leg == 1 || leg == 3, r.ucNe, lw.irAt) < 0 {
    return -1
  }
  if r.ucStage != 0 { unionEqStageClose() }
  return 0
}

// The null legs' box: from its slot where it is parked, else operand `o`.
function parkedOr(parked: boolean, o: Opnd): i32 {
  if parked {
    fbLocalGet(unionEqNulBoxSlot())
    return 0
  }
  irLOpnd(o)
  return 0
}

// `RUnionEq`: both boxes, then legacy's compare over them (`unionUnionBoxesTail`).
function unionEq(r: RUnionEq) {
  const n = nodeAt(r.ueAt)
  if !(n is BinExpr) { return irLMiss("union compare node") }
  irLOpnd(r.ueL)
  irLOpnd(r.ueR)
  return unionUnionBoxesTail(n.binLeft, n.binRight, r.ueNe, lw.irAt)
}

// `RUnionStagedEq`: a staged compare's tails over the sides its `RUnionStage` steps parked.
function unionStagedEq(r: RUnionStagedEq) {
  const n = nodeAt(r.uqsAt)
  if !(n is BinExpr) { return irLMiss("union compare node") }
  const boxIx = if r.uqsSwap { n.binRight } else { n.binLeft }
  const otherIx = if r.uqsSwap { n.binLeft } else { n.binRight }
  const qp = unionEqStagedPlanOf(boxIx, otherIx, r.uqsSwap, lw.irAt)
  if qp.uqKind < 0 { return irLMiss("union staged compare plan") }
  return unionEqStagedTail(qp, r.uqsNe, lw.irAt)
}

// `RUnionVariantEq`: legacy's variant door (`emitUnionConcreteVariantEq`): its slots, the box, the
// record, then the arm's tag and fields (`unionVariantEqTail`).
function unionVariantEq(r: RUnionVariantEq) {
  const n = nodeAt(r.uvAt)
  if !(n is BinExpr) { return irLMiss("union compare node") }
  const boxIx = if r.uvSwap { n.binRight } else { n.binLeft }
  const otherIx = if r.uvSwap { n.binLeft } else { n.binRight }
  const vi = unionEqVariantRowOf(boxIx, otherIx, lw.irAt)
  if vi < 0 { return irLMiss("union variant compare row") }
  unionEqHead()
  unionVariantEqHead(vi)
  irLOpnd(r.uvBox)
  irLOpnd(r.uvOther)
  return unionVariantEqTail(vi, otherIx, r.uvNe, lw.irAt)
}

// `RUnionNumCrossEq`: legacy's cross-width door (`emitUnionConcreteNumCross`): its slots, the box
// parked, the number, then each number arm compared at the wider kind (`unionNumCrossTail`).
function unionNumCrossEq(r: RUnionNumCrossEq) {
  const n = nodeAt(r.ncAt)
  if !(n is BinExpr) { return irLMiss("union compare node") }
  const boxIx = if r.ncSwap { n.binRight } else { n.binLeft }
  const otherIx = if r.ncSwap { n.binLeft } else { n.binRight }
  const kas = unionNumCrossKindsOf(boxIx, otherIx, lw.irAt)
  if kas.length == 0 { return irLMiss("union cross-width compare arms") }
  unionEqHead()
  unionNumCrossHead(r.ncKind)
  irLOpnd(r.ncBox)
  unionNumCrossBoxTail()
  irLOpnd(r.ncOther)
  return unionNumCrossTail(kas, r.ncKind, r.ncNe)
}

// `RNumUnionBin`: legacy's `numUnion` dispatch in `emitNumUnionBin`'s order: each side's value
// and its stash, one level deeper for a dispatch inside it, then the member dispatch over the
// stashed sides (`numUnionBinTail`). A literal side stashes nothing.
function numUnionBin(r: RNumUnionBin) {
  const n = nodeAt(r.nbAt)
  if !(n is BinExpr) { return irLMiss("numeric union node") }
  const fnIx = lw.irAt
  const key = numUnionStashEnter()
  let k = 0
  const sides = [n.binLeft, n.binRight]
  const slots: i32[] = []
  let j = 0
  while j < 2 {
    const ix = sides[j]
    const isU = numUnionIsUnionSide(ix, fnIx)
    if !isU && numUnionSideLit(ix) {
      slots.push(-2)
    } else {
      if k >= r.nbArgs.length {
        numUnionStashLeave()
        return irLMiss("numeric union operands")
      }
      irLOpnd(r.nbArgs[k])
      k = k + 1
      slots.push(numUnionStashTail(isU, numUnionSideKindOf(ix), key + j))
    }
    j = j + 1
  }
  numUnionStashLeave()
  if numUnionBinTail(n, r.nbAt, fnIx, slots[0], slots[1]) < 0 {
    return irLMiss("numeric union dispatch")
  }
  return 0
}

// `RStrToAtom`: legacy's atom tower (`emitStrToAtomChain`): every member's id, then from the
// last tested member to the first its string read and the test that selects it.
function strToAtomTower(r: RStrToAtom) {
  const texts = strToAtomTexts(r.saAt)
  if texts.length != r.saReads.length + 1 {
    return irLMiss("atom tower members")
  }
  let m = 0
  while m < texts.length {
    strToAtomIdTail(texts, m)
    m = m + 1
  }
  let i = texts.length - 2
  while i >= 0 {
    irLOpnd(r.saReads[i])
    if strToAtomTestTail(texts, i, lw.irAt) < 0 {
      return irLMiss("atom tower test")
    }
    i = i - 1
  }
  return 0
}

// `RClosureEq`: both closures, then legacy's identity compare (`closureEqTail`).
function closureEq(r: RClosureEq) {
  const n = nodeAt(r.cqAt)
  if !(n is BinExpr) { return irLMiss("function compare node") }
  irLOpnd(r.cqL)
  irLOpnd(r.cqR)
  if closureEqTail(n, r.cqAt, lw.irAt) < 0 {
    return irLMiss("function compare")
  }
  return 0
}

// `RIdentityEq`: legacy's `emitIdentityBin`, each operand then its payload tail, `ref.eq`, and
// `i32.eqz` for `!==`; on the per-arm route, `emitIdentityMixed`'s staged compare.
function identityEq(r: RIdentityEq) {
  const n = nodeAt(r.ieAt)
  if !(n is BinExpr) { return irLMiss("identity compare node") }
  irLOpnd(r.ieL)
  identityOperandTail(n.binLeft, lw.irAt)
  if eqRouteOf(n, r.ieAt, lw.irAt) == "identMixed" {
    fbLocalSet(identityArmSlot(0))
    irLOpnd(r.ieR)
    identityOperandTail(n.binRight, lw.irAt)
    return identityMixedTail(n)
  }
  irLOpnd(r.ieR)
  identityOperandTail(n.binRight, lw.irAt)
  fbRefEq()
  if n.binOp == "!=" { fbI32Eqz() }
  return 0
}

// `RAsgParked`: the value its element store, field store or map set parked, read back by legacy's writer.
function asgParked(r: RAsgParked) {
  const a = nodeAt(r.apAt)
  if !(a is BinExpr) { return irLMiss("parked assignment node") }
  const t = nodeAt(unwrapParen(a.binLeft))
  if t is Member { return asgParkedFieldTail(r.apAt, lw.irAt) }
  if t is Index && exprMap(t.idxArr, lw.irAt) {
    return asgParkedMapTail(r.apAt, lw.irAt)
  }
  return asgParkedElemTail(r.apAt, lw.irAt)
}

// `RStructEq`: legacy's field-wise record compare (`emitStructEq`): the stashed operands' values,
// their slots, then the compare, which reads an unstashed operand from its variable's local.
function structEq(r: RStructEq) {
  const n = nodeAt(r.seAt)
  if !(n is BinExpr) { return irLMiss("record compare node") }
  const fnIx = lw.irAt
  const row = r.seRow
  const lS = structEqStagesLeft(n.binLeft, n.binRight)
  const rS = structEqStagesRight(n.binRight)
  const lE = r.seLIx.length > 0
  const rE = r.seRIx.length > 0
  // A nullable compare's non-nullable side is legacy's expression root, never a null-tested local;
  // a place side, or an element side's place receiver, is re-read at each field the same way.
  const lB = r.seNul && !lE && !(repNodeAt(opRepOf(r.seL)) is RNullable)
  const rB = r.seNul && !rE && !(repNodeAt(opRepOf(r.seR)) is RNullable)
  const lG = !lS && (structEqPlaceSide(r.seL) || lB)
  const rG = !rS && (structEqPlaceSide(r.seR) || rB)
  const lV = if lS || lE || lG { -1 } else { structEqSideLocal(r.seL) }
  const rV = if rS || rE || rG { -1 } else { structEqSideLocal(r.seR) }
  // A side held nowhere (an optional chain's value) is written once to a fresh local of its row;
  // the slot is shared by heap type, so one side at most.
  const lO = !lS && !lE && !lG && lV < 0 && structEqOnceSide(r.seL)
  const rO = !rS && !rE && !rG && rV < 0 && structEqOnceSide(r.seR)
  if lO && rO { return irLMiss("record compare two fresh sides") }
  const heap = if row >= 0 && row < sHeapIdx.length { sHeapIdx[row] } else { -1 }
  if (lO || rO) && heap < 0 { return irLMiss("record compare fresh row") }
  const lLoc = if lO { irOnceRefSlot(heap) } else { lV }
  const rLoc = if rO { irOnceRefSlot(heap) } else { rV }
  if !lS && !lE && !lG && lLoc < 0 || !rS && !rE && !rG && rLoc < 0 {
    return irLMiss("record compare place")
  }
  const plan: EqRootPlan = {
    erL: if lE { structEqElemPlace(r.seL, r.seLIx[0], lG, n.binLeft) } else { structEqRootPlace(n.binLeft, lG) },
    erR: if rE { structEqElemPlace(r.seR, r.seRIx[0], rG, n.binRight) } else { structEqRootPlace(n.binRight, rG) },
  }
  if lwMiss != "" { return -1 }
  if plan.erL.epSlot == -2 || plan.erR.epSlot == -2 {
    return irLMiss("record compare element place")
  }
  if (
    r.seNul
    && (lE && !eqElemNullTestOk(n.binLeft, fnIx)
      || rE && !eqElemNullTestOk(n.binRight, fnIx))
  ) {
    return irLMiss("nullable record compare element place")
  }
  const saved = structEqEnter()
  if lS { irLOpnd(r.seL) }
  if rS { irLOpnd(r.seR) }
  if lO {
    irLOpnd(r.seL)
    fbLocalSet(lLoc)
  }
  if rO {
    irLOpnd(r.seR)
    fbLocalSet(rLoc)
  }
  structEqPlaceSkip(lG, rG, r)
  const roots = structEqRoots(row, n.binLeft, n.binRight, lLoc, rLoc)
  // Two nullable records' compare: the nullness guard and the fields, then `!=`'s `i32.eqz`, as
  // `emitNulNicheEqBin` writes it after the guarded block.
  if r.seNul {
    if structEqNulGuard(r, n, roots, row, plan, lG, rG) < 0 {
      return irLMiss("nullable record compare fields")
    }
    structEqLeave(saved)
    structEqRowsBank(plan.erL.epRows, plan.erR.epRows)
    if n.binOp == "!=" { fbI32Eqz() }
    return 0
  }
  if structEqTail(n, row, roots, saved, fnIx, plan) < 0 {
    return irLMiss("record compare fields")
  }
  structEqRowsBank(plan.erL.epRows, plan.erR.epRows)
  return 0
}

// `nulStructEqGuardTail` over the IR's own null tests where it holds the side (`structEqSideNul`):
// the `$out` block, both sides' tests, the disagreement's 0, the left's test again, both-null's 1,
// then legacy's field-wise compare.
function structEqNulGuard(
  r: RStructEq,
  n: BinExpr,
  roots: i32[],
  row: i32,
  plan: EqRootPlan,
  lG: boolean,
  rG: boolean,
): i32 {
  nulStructEqGuardOpen()
  if structEqSideNul(r.seL, n.binLeft, roots[0], plan.erL, lG) < 0 { return -1 }
  if structEqSideNul(r.seR, n.binRight, roots[1], plan.erR, rG) < 0 {
    return -1
  }
  nulStructEqGuardMid()
  if structEqSideNul(r.seL, n.binLeft, roots[0], plan.erL, lG) < 0 { return -1 }
  nulStructEqGuardBoth()
  if nulStructEqFieldsAt(roots[0], roots[1], row, lw.irAt, plan) < 0 {
    return -1
  }
  nulStructEqGuardClose()
  return 0
}

// One side's null test in a nullable-record compare, as `emitEqIsNull` writes it along
// `nulTestArmOf`: a folded arm's constant, or the side read again (its variable's local, or a
// place the builder re-reads, `irHoistRecv`) and the arm's tail. A stashed or element side, and
// an arm reading anything else, is legacy's (`emitEqRootIsNull`).
function structEqSideNul(
  o: Opnd,
  ix: i32,
  root: i32,
  place: EqRootPlace,
  placeSide: boolean,
): i32 {
  const fnIx = lw.irAt
  if root == -2 || root == -3 || place.epKind == "elem" {
    return emitEqRootIsNull(root, ix, fnIx, place)
  }
  const arm = nulTestArmOf(ix, fnIx, false, false)
  if arm == "nnfold" || arm == "none" {
    fbI32Const(0)
    return 0
  }
  if arm == "nulfold" {
    fbI32Const(1)
    return 0
  }
  // An optional chain's null test would re-read the side's node in legacy (`emitOptChainIsNull`).
  if arm == "optChain" {
    return irLMiss("nullable record compare optional chain side")
  }
  if (
    arm != "nullRef"
    && arm != "nulStr"
    && arm != "bool"
    && arm != "atom"
    && arm != "boxTag"
  ) {
    return emitEqRootIsNull(root, ix, fnIx, place)
  }
  if placeSide {
    if irHoistRecv(unwrapParen(ix)) < 0 { return -1 }
  } else {
    const loc = structEqSideLocal(o)
    if loc < 0 { return irLMiss("nullable record compare side") }
    fbLocalGet(loc)
  }
  if arm == "bool" { return if nulTestBoolTail(false) < 0 { -1 } else { 0 } }
  if arm == "atom" { return if nulTestAtomTail(false) < 0 { -1 } else { 0 } }
  if arm == "boxTag" {
    return if nulTestBoxTagTail(false) < 0 { -1 } else { 0 }
  }
  return if nulTestRefTail(false) < 0 { -1 } else { 0 }
}

// `REqHelp`: `__eq_<row>__`'s compare, which reads its operands at their parameter slots.
function eqHelp(r: REqHelp) {
  if !paramAtSlot(r.ehL, 0) || !paramAtSlot(r.ehR, 1) {
    return irLMiss("compare helper operands")
  }
  return eqHelpTail(r.ehRow)
}

// Whether `o` is the function's parameter at wasm slot `slot`.
function paramAtSlot(o: Opnd, slot: i32): boolean {
  if !(o is OVar) || o.ov < 0 || o.ov >= lw.irVars.length { return false }
  const v = lw.irVars[o.ov]
  return v.vKind == "param" && v.vSlot == slot
}

// Banks the element-read rows a record compare's `elem` roots wrote (node, from, to), ordered by
// where each starts.
function structEqRowsBank(lRows: i32[], rRows: i32[]) {
  let a = 0
  let b = 0
  while a < lRows.length || b < rRows.length {
    const takeL = b >= rRows.length
      || a < lRows.length && lRows[a + 1] < rRows[b + 1]
    const rows = if takeL { lRows } else { rRows }
    const k = if takeL { a } else { b }
    lwRowAst.push(rows[k])
    lwRowFrom.push(rows[k + 1])
    lwRowTo.push(rows[k + 2])
    lwRowKind.push(6)
    if takeL { a = a + 3 } else { b = b + 3 }
  }
  return 0
}

// The `elem` root place of a record compare side `ix` read as a ref list element: receiver `v`
// from its local, or re-read where it is a place, as the bytes the IR reads it again with
// (`irReadsAgain`, `epSlot` -3) or from its expression (-1); index `i` likewise from its local, an
// immediate, its bytes (`epIdx` -3) or its expression (-2). `epSlot` -2 where one has neither.
function structEqElemPlace(
  v: Opnd,
  i: Opnd,
  placeRecv: boolean,
  ix: i32,
): EqRootPlace {
  const el = eqElemRootOf(ix)
  const nd = if el >= 0 { nodeAt(el) } else { null }
  const recvIx = if nd is Index { unwrapParen(nd.idxArr) } else { -1 }
  const idxIx = if nd is Index { unwrapParen(nd.idxIndex) } else { -1 }
  const rBytes = placeRecv && recvIx >= 0 && irReadsAgain(recvIx)
  // A place receiver or index the IR has no read of declines, so legacy never re-reads its node.
  if placeRecv && !rBytes { irLMiss("record compare element receiver read") }
  const vs = if rBytes { -3 } else if placeRecv { -1 } else { structEqSideLocal(v) }
  const placeIdx = structEqPlaceSide(i)
  const iBytes = placeIdx && idxIx >= 0 && irReadsAgain(idxIx)
  if placeIdx && !iBytes { irLMiss("record compare element index read") }
  const xs = if i is OImm { -1 } else if iBytes { -3 } else if placeIdx { -2 } else { structEqSideLocal(i) }
  const imm = if i is OImm { i.oiBits as% i32 } else { 0 }
  const bad = vs < 0 && !placeRecv || !(i is OImm) && xs == -1
  return {
    epKind: "elem",
    epSlot: if bad { -2 } else { vs },
    epIdx: xs,
    epImm: imm,
    epRows: [],
    epBytes: if rBytes { readAgainBytes(recvIx) } else { [] },
    epIdxBytes: if iBytes { readAgainBytes(idxIx) } else { [] },
  }
}

// The list element read a compare side `ix` roots its field chain at: the side, or the receiver
// under its field reads; -1 where that root is no list read.
function eqElemRootOf(ix: i32): i32 {
  let u = unwrapParen(ix)
  while u >= 0 && u < P.nodes.length {
    const m = nodeAt(u)
    if m is Index { return u }
    if !(m is Member) { return -1 }
    u = unwrapParen(m.memObj)
  }
  return -1
}

// The bytes `irHoistRecv` reads node `ix` again with, written aside rather than in place.
function readAgainBytes(ix: i32): u8[] {
  const bs: u8[] = []
  const prev = wTarget(bs)
  irHoistRecv(ix)
  wTarget(prev)
  return bs
}

// The root place of a record compare side at node `ix` that is no list element: a place side
// (`place`) the IR reads again (`irReadsAgain`) as those bytes, written once here. Any other side
// is stashed or held in a local, so its root is a slot and this place goes unread; a place side
// the IR has no read of declines, so legacy never re-reads the operand node.
function structEqRootPlace(ix: i32, place: boolean): EqRootPlace {
  const u = unwrapParen(ix)
  if !place { return EQ_ROOT_EXPR }
  if !irReadsAgain(u) {
    irLMiss("record compare place read")
    return EQ_ROOT_EXPR
  }
  return {
    epKind: "bytes",
    epSlot: -1,
    epIdx: -1,
    epImm: 0,
    epRows: [],
    epBytes: readAgainBytes(u),
    epIdxBytes: [],
  }
}

// Whether `irHoistRecv` writes node `ix`'s read again: a variable's, a global's or an element's
// read the builder noted, or a noted field read of one.
function irReadsAgain(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if (
    (lw.irReadVar[ix] ?? -1) >= 0
    || lw.irReadAgain.has(ix)
    || lw.irReadElem.has(ix)
  ) {
    return true
  }
  const m = nodeAt(ix)
  return lw.irReadField.has(ix)
    && m is Member
    && irReadsAgain(unwrapParen(m.memObj))
}

// Whether record compare side `o` is a temp no variable holds, a value written once to a local.
function structEqOnceSide(o: Opnd): boolean { return o is OVar && isTemp(o.ov) }

// The local a record compare reads unstashed operand `o` from: a variable's slot, else -1.
function structEqSideLocal(o: Opnd): i32 {
  if !(o is OVar) || isTemp(o.ov) { return -1 }
  if o.ov < lwStackVal.length && lwStackVal[o.ov] { return -1 }
  return varSlot(o.ov)
}

// Whether record compare side `o` is a temp holding a place legacy re-reads at each field from
// its expression (`structEqRoots` at the place): a global's read or a narrowed nullable
// variable's, under field reads, or a variable's field reads.
function structEqPlaceSide(o: Opnd): boolean {
  if !(o is OVar) || !isTemp(o.ov) { return false }
  if o.ov < lwStackVal.length && lwStackVal[o.ov] { return false }
  const r = tempRhs(o.ov)
  if r is RGlobalGet { return true }
  if r is RRecover {
    return r.rcV is OVar && !isTemp(r.rcV.ov) && varSlot(r.rcV.ov) >= 0
  }
  if !(r is RGetField) || !(r.gfV is OVar) { return false }
  return !isTemp(r.gfV.ov) && varSlot(r.gfV.ov) >= 0 || structEqPlaceSide(r.gfV)
}

// Consumes the place sides' temps unwritten, left first, as legacy reads each from its place.
function structEqPlaceSkip(lG: boolean, rG: boolean, r: RStructEq) {
  if lG { irLSkip(r.seL) }
  if r.seLIx.length > 0 && structEqPlaceSide(r.seLIx[0]) { irLSkip(r.seLIx[0]) }
  if rG { irLSkip(r.seR) }
  if r.seRIx.length > 0 && structEqPlaceSide(r.seRIx[0]) { irLSkip(r.seRIx[0]) }
  return 0
}

// `RNulNicheEq`: legacy's `nulNiche` compare in `emitNulNicheEq`'s order: the guard's head, the
// left operand, the right twice (`neR`, `neR2`) around the rep's own compare, and `i32.eqz` for `!=`.
function nulNicheEq(r: RNulNicheEq) {
  const n = nodeAt(r.neAt)
  if !(n is BinExpr) { return irLMiss("nullable compare node") }
  if nulNicheEqWhy(r.neAt, lw.irAt) != "" {
    return irLMiss("nullable compare plan")
  }
  nulNicheEqHead()
  irLOpnd(r.neL)
  nulNicheEqLeftTail()
  irLOpnd(r.neR)
  if nulNicheEqRightTail(r.neAt, lw.irAt) < 0 {
    return irLMiss("nullable compare core")
  }
  irLOpnd(r.neR2)
  nulNicheEqNullTail()
  if n.binOp == "!=" { fbI32Eqz() }
  return 0
}

// `RToBox`: the shared box plan's head, the value (a `null` or a literal leaves its immediate
// unread), an atom box's widening, and the plan's tail.
function boxOp(r: RToBox) {
  const fnIx = lw.irAt
  const p = holeBoxPlanOf(r.bxAt, r.bxTy, fnIx)
  if p.hbArm == "ladder" { return irLMiss("box plan") }
  if i32ListHas(lw.irBoxLate, unwrapParen(r.bxAt)) { return boxLate(r, p) }
  // A box that writes no head reads a valued `if`'s waiting value as its operand (`boxLeadsAt`).
  if !i32ListHas(lwBoxHeadAt, unwrapParen(r.bxAt)) {
    if p.hbArm != "pass" && p.hbArm != "memberBox" && p.hbArm != "retag" {
      leaf()
    }
    holeBoxHead(p, r.bxAt, fnIx)
  }
  if p.hbArm == "recCopy" {
    if boxRecCopy(r, p.hbKind) < 0 { return -1 }
    return holeBoxTail(p, r.bxAt, fnIx)
  }
  // A numeric union re-boxed member by member: its box stashed, then legacy's dispatch.
  if p.hbArm == "numRebox" {
    irLOpnd(r.bxV)
    if lwMiss != "" { return -1 }
    const key = numUnionStashEnter()
    const bs = numUnionStashTail(true, -1, key)
    numUnionStashLeave()
    return numUnionReboxTail(r.bxAt, p.hbKind, fnIx, bs)
  }
  if (
    p.hbArm == "pass"
    || p.hbArm == "memberBox"
    || p.hbArm == "atom"
    || p.hbArm == "atomList"
    || p.hbArm == "atomStr"
    || p.hbArm == "nulNiche"
    || p.hbArm == "nulBool"
    || p.hbArm == "rec"
    || p.hbArm == "obj"
    || p.hbArm == "refList"
    || p.hbArm == "map"
    || p.hbArm == "nulMap"
    || p.hbArm == "clo"
    || p.hbArm == "atomAsStr"
    || p.hbArm == "retag"
    || p.hbArm == "mapBox"
    || p.hbArm == "mapScalar"
    || p.hbArm == "narrowBox"
  ) {
    irLOpnd(r.bxV)
  } else {
    irLSkip(r.bxV)
  }
  if p.hbSrc >= 0 { numWidenTail(p.hbSrc, p.hbKind, r.bxAt, fnIx) }
  if p.hbArm == "atomAsStr" { atomStrTail(atomStrPlanOf(r.bxAt, fnIx, false)) }
  return holeBoxTail(p, r.bxAt, fnIx)
}

// A `recCopy` box's value: the record copied onto variant `vi`, its source read as the IR wrote
// it, into the bytes the copy reads where it reads them again, else on the stack once.
function boxRecCopy(r: RToBox, vi: i32): i32 {
  const src: u8[] = []
  if variantCopyReReads(r.bxAt, vi, lw.irAt) {
    const prev = wTarget(src)
    irLOpnd(r.bxV)
    wTarget(prev)
  } else {
    irLOpnd(r.bxV)
  }
  if lwMiss != "" { return -1 }
  return variantCopyEmit(r.bxAt, vi, lw.irAt, src)
}

// A late box (`irBoxLate`): its value and payload conversion, held in an `anyref` local
// (`irOnceSlot`), then the plan's tag, the payload again and the box. Only a plan whose head is
// its tag alone takes this; any other refuses.
function boxLate(r: RToBox, p: HoleBox) {
  const fnIx = lw.irAt
  if !boxTagOnly(p.hbArm) {
    return irLMiss("box of a valued if at plan " + p.hbArm)
  }
  irLOpnd(r.bxV)
  if p.hbSrc >= 0 { numWidenTail(p.hbSrc, p.hbKind, r.bxAt, fnIx) }
  if p.hbArm == "atomAsStr" { atomStrTail(atomStrPlanOf(r.bxAt, fnIx, false)) }
  if p.hbArm == "atom" || p.hbArm == "atomList" { atomPayloadTail(p.hbKind) }
  const any: u8[] = [VT_ANYREF]
  const s = irOnceSlot(any)
  fbLocalSet(s)
  holeBoxHead(p, r.bxAt, fnIx)
  lwBoxHeadAt.push(unwrapParen(r.bxAt))
  fbLocalGet(s)
  fbStructNew(uBoxIdx)
  return 0
}

// Opens legacy's header hoists for the loop over `condIx` and `bodyIx`, its rows and header
// reads legacy's, each receiver read as the builder read it (`irHoistRecv`).
export function irLoopHoistOpen(
  condIx: i32,
  bodyIx: i32,
  own: i32,
  own2: i32,
): i32 {
  const fnIx = lw.irAt
  let opened = 0
  for c in loopHoistCands(condIx, bodyIx, fnIx, own, own2) {
    const row = hoistCandRow(c, condIx, bodyIx, fnIx)
    if row >= 0 {
      let k = 0
      while k < hoistRowReads(row) {
        if irHoistRecv(c.hcRecv) < 0 { return -1 }
        hoistReadTail(row, k, c.hcRecv, fnIx)
        k = k + 1
      }
      hoistRowMark(row)
      opened = opened + 1
    }
  }
  return opened
}

// A hoisted receiver's read, as the builder read it: its variable, a global's read, or a plain
// field read's object read the same way, then the field.
function irHoistRecv(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length {
    irLMiss("hoisted receiver node")
    return -1
  }
  const v = lw.irReadVar[ix] ?? -1
  if v >= 0 {
    fbLocalGet(varSlot(v))
    return 0
  }
  if irLReadAgain(ix) { return 0 }
  if lw.irReadElem.has(ix) {
    const none: Rhs = { ggSym: -1, ggNonNull: false, ggNn: -1 }
    return rhs(lw.irReadElem[ix] ?? none, false)
  }
  const m = nodeAt(ix)
  if lw.irReadField.has(ix) && m is Member {
    if irHoistRecv(unwrapParen(m.memObj)) < 0 { return -1 }
    return fieldTail(ix, m)
  }
  const o = lw.irReadOpt.get(ix)
  if o != null { return optReadGo(o, true) }
  irLMiss("hoisted receiver read")
  return -1
}

// List read operand `o` at node `ix`: taken (`irLOpnd`, or `irLSkip` when `skip`), or, in a read
// written once more (`again`), its temp's read written again or, skipped, nothing.
export function irLRecvOpnd(
  o: Opnd,
  ix: i32,
  skip: boolean,
  again: boolean,
): i32 {
  if again && o is OVar && isTemp(o.ov) {
    if skip { return 0 }
    return irHoistRecv(unwrapParen(ix))
  }
  if skip { irLSkip(o) } else { irLOpnd(o) }
  return 0
}

// Operand `o` of node `ix` read once more: a variable's read, or a temp's read written again as the
// builder read it (`irHoistRecv`).
function opndAgain(o: Opnd, ix: i32): i32 {
  if o is OVar && o.ov >= 0 && lw.irVars[o.ov].vKind == "temp" {
    return irHoistRecv(unwrapParen(ix))
  }
  irLOpnd(o)
  return 0
}

// Writes the global read the builder built at node `ix` once more, as legacy re-reads a name;
// false where it built none.
export function irLReadAgain(ix: i32): boolean {
  if !lw.irReadAgain.has(ix) { return false }
  const none: Rhs = { ggSym: -1, ggNonNull: false, ggNn: -1 }
  const r = lw.irReadAgain[ix] ?? none
  if r is RBoxNarrow {
    boxNarrowAt(r, true)
    return true
  }
  rhs(r, false)
  return true
}

// The box narrowed read `r` unboxes: its operand, or, written `again`, the global's read
// (`irReadBoxed`) where its first read consumed the box temp.
function boxNarrowBox(r: RBoxNarrow, again: boolean) {
  if again && lw.irReadBoxed.has(r.bnAt) {
    const none: Rhs = { ggSym: -1, ggNonNull: false, ggNn: -1 }
    return rhs(lw.irReadBoxed[r.bnAt] ?? none, false)
  }
  return irLOpnd(r.bnV)
}

// `RRecCopyPure`: legacy's whole copy, its source read as the IR wrote it: whole, where the copy
// reads it once, or a read written again (`irHoistRecv`); with neither, the claim declines.
function recCopyPure(r: RRecCopyPure) {
  const src: u8[] = []
  // A source read once is written here whole, into the bytes the copy reads it as.
  if r.rpOnce && r.rpV.length > 0 {
    const prev = wTarget(src)
    irLOpnd(r.rpV[0])
    wTarget(prev)
    if lwMiss != "" { return -1 }
    return recCopyPureEmit(r.rpAt, lw.irAt, src)
  }
  for v in r.rpV { irLSkip(v) }
  leaf()
  const u = unwrapParen(r.rpAt)
  // A source the IR has no read of declines, so legacy's copy never re-reads its node.
  if r.rpV.length == 0 || !irReadsAgain(u) {
    return irLMiss("record copy source read")
  }
  const prev = wTarget(src)
  irHoistRecv(u)
  wTarget(prev)
  if lwMiss != "" { return -1 }
  return recCopyPureEmit(r.rpAt, lw.irAt, src)
}

// The depth a branch to `label` crosses from the innermost frame, or -1.
function brDepth(label: i32): i32 {
  let i = lwFrames.length - 1
  while i >= 0 {
    if lwFrames[i] == label { return lwFrames.length - 1 - i }
    i = i - 1
  }
  return -1
}

// Whether `o` is the immediate `true`.
// Whether the `if` built from node `at` tests the literal `true` (`condLitTrue`); a node that is
// no `if` statement, a loop's exit or a helper's, has no test of its own to read.
function testIsLitTrue(at: i32): boolean {
  if at < 0 || at >= P.nodes.length { return true }
  const s = nodeAt(at)
  return if s is IfStmt { condLitTrue(s.ifCond) } else { true }
}

function isTrue(o: Opnd): boolean {
  return match o {
    OImm => repPrim(o.oiRep) == "bool" && o.oiBits == 1
    OVar | OStr => false
  }
}

// Writes `o` as a condition, then checks that it consumed exactly the temps `pending` defined.
function cond(o: Opnd, pending: i32[]) {
  lwSeq = []
  irLOpnd(o)
  irLSettle(pending)
}

// The stack-order precondition: the temps a node's operands consumed are the ones its body
// defined since the previous node, in definition order.
export function irLSettle(pending: i32[]) {
  if lwSeq.length != pending.length {
    irLMiss("non-stack temp: out of order")
  } else {
    let i = 0
    while i < pending.length {
      if lwSeq[i] != pending[i] { irLMiss("non-stack temp: out of order") }
      i = i + 1
    }
  }
  while pending.length > 0 { pending.pop() }
  lwSeq = []
  return 0
}

// The callee of a temp defined by a direct call, or -1.
// The temp operand `o` names when its definition is an `RRetag`, or -1.
function retagOf(o: Opnd): i32 {
  if !(o is OVar) || !isTemp(o.ov) || !tempDefined(o.ov) { return -1 }
  return if tempRhs(o.ov) is RRetag { o.ov } else { passBoxOf(o.ov) }
}

// Temp `t` when it holds a box passed as it stands, which writes nothing around its value, so a
// call in it is a tail call too; else -1.
function passBoxOf(t: i32): i32 {
  const r = tempRhs(t)
  if !(r is RToBox) { return -1 }
  const p = holeBoxPlanOf(r.bxAt, r.bxTy, lw.irAt)
  return if p.hbArm == "pass" || p.hbArm == "memberBox" { t } else { -1 }
}

// The operand a pass box temp `t` holds.
function passBoxOperand(t: i32): Opnd {
  const r = tempRhs(t)
  if r is RToBox { return r.bxV }
  const none: Opnd = { ov: -1 }
  return none
}

// The operand retag (or pass box) temp `t` holds.
function retagOperand(t: i32): Opnd {
  const r = tempRhs(t)
  if r is RRetag { return r.rgV }
  if passBoxOf(t) >= 0 { return passBoxOperand(t) }
  const none: Opnd = { ov: -1 }
  return none
}

// Whether call `c` is a lifted function's call of itself, which returns what the function would,
// so its tail form drops the write-back with the return's own hand-back (`emitLiftSelfTailRet`).
function liftSelfTail(c: RCall): boolean {
  return lw.irRetExtra.length > 0
    && c.caWb.length > 0
    && c.caCallee == fnStmtsPosOf(lw.irAt)
    && !fnUses.unionSink
}

// 0 for a closure call's right-hand side, which a return takes in its tail form too; -1 else.
function callRefTemp(r: Rhs): i32 { return if r is RCallRef { 0 } else { -1 } }

function callTemp(o: Opnd): i32 {
  // A lifted body handing captures back returns them after the call, so no call is its tail but
  // its call of itself (`liftSelfTail`).
  if lw.irRetExtra.length > 0 {
    if !(o is OVar) || !isTemp(o.ov) || !tempDefined(o.ov) { return -1 }
    const r = tempRhs(o.ov)
    return if r is RCall && liftSelfTail(r) { r.caCallee } else { -1 }
  }
  return match o {
    OVar => {
      if !isTemp(o.ov) || !tempDefined(o.ov) { return -1 }
      const r = tempRhs(o.ov)
      // A callee that hands captures back is followed by their sets, so it has no tail form.
      if r is RCall {
        if r.caWb.length == 0 { r.caCallee } else { -1 }
      } else {
        callRefTemp(r)
      }
    }
    OImm | OStr => -1
  }
}

// Writes body `b`; `tail` when its last node ends a void function, `out` the slotless variable
// its valued `if`'s arm writes (-1 for none). An `else` is a frame, so an `else if` chain costs no
// stack (D1990); one walk, not a wrapper, so nesting costs one frame per level. Returns the top
// frame's stack temps, required consumed unless `keepTop` (a fragment's value reads them).
function body(b0: i32[], tail0: boolean, out0: i32, keepTop: boolean): i32[] {
  const p0: i32[] = []
  const fb: i32[][] = [b0]
  const fi: i32[] = [0]
  const fp: i32[][] = [p0]
  const ft: boolean[] = [tail0]
  const fo: i32[] = [out0]
  // The `if` whose `else` a frame is, and how it opened (`ifOpen`); -1 for the call's own body.
  const fif: i32[] = [-1]
  const fk: i32[] = [-1]
  while fb.length > 0 {
    const top = fb.length - 1
    const b = fb[top]
    const i = fi[top]
    const pending = fp[top]
    if lwMiss == "" && i < b.length {
      const id = b[i]
      rowOpenNote(id)
      siteArmMintAt(id)
      spreadPairMintAt(id)
      spanOpen(id)
      // A valueless `return` after a call in its tail form writes nothing.
      if !(i > 0 && callReturns(b, i - 1)) {
        const tl = ft[top] && i == b.length - 1 || callReturns(b, i)
        boxLeadStage(id, pending)
        dispatchBoxHead(id)
        stashIfBoxHead(id)
        const k = ifOpen(id, pending, tl)
        if k == IF_NOT {
          node(id, pending, tl, if i == b.length - 1 { fo[top] } else { -1 })
          boxLeadUnstage(id)
        }
        if k == IF_ELSE || k == IF_VALUED {
          const n = lw.irNodes[id]
          if n is SIf {
            const pe: i32[] = []
            fb.push(n.siElse)
            fi.push(0)
            fp.push(pe)
            ft.push(k == IF_ELSE && tl)
            fo.push(if k == IF_ELSE { -1 } else { n.siOut })
            fif.push(id)
            fk.push(k)
            continue
          }
        }
      }
      spanClose(id)
      fi[top] = i + 1
      continue
    }
    if lwMiss == "" && pending.length > 0 && !(keepTop && top == 0) {
      irLMiss("non-stack temp: unconsumed")
    }
    const ifId = fif[top]
    const k = fk[top]
    fb.pop()
    fi.pop()
    fp.pop()
    ft.pop()
    fo.pop()
    fif.pop()
    fk.pop()
    if ifId >= 0 {
      ifClose(ifId, k, fp[top - 1])
      spanClose(ifId)
      fi[top - 1] = fi[top - 1] + 1
    }
  }
  return p0
}

// Whether node `i` of `b` is a void call a valueless `return` follows, so the call returns.
function callReturns(b: i32[], i: i32): boolean {
  if i + 1 >= b.length { return false }
  const n = lw.irNodes[b[i]]
  const nx = lw.irNodes[b[i + 1]]
  if !(n is SEffect && nx is SReturn) || nx.rtHas { return false }
  const r = n.efRhs
  if r is RCallRef { return r.crVoid && !r.crNever }
  return r is RCall && !r.caNever && voidTailCallee(r.caCallee)
}

// A tag dispatch's callee id stash. An operand the dispatch follows reaches the stack first, as
// legacy writes it before the stash; its roots wait below the dispatch's `if`s for their reader.
// Its own frame, so `node`'s recursive frame does not carry its locals.
function tagStashEffect(r: RTagStash, pending: i32[]) {
  const roots = stageLead(r.tgsV, pending)
  if lwMiss != "" { return 0 }
  lwFloors.push(lwFloor)
  lwFloor = lwLive.length - liveCountIn(pending)
  irLOpnd(r.tgsV)
  tagStashTail()
  liveNeutral()
  irLSettle(pending)
  lwFloor = lwFloors.pop() ?? 0
  for v in roots { pending.push(v) }
  return 0
}

// A staged union compare's step: its level opened or closed, or a side parked in its slot, in
// source order as `emitUnionEqStaged` writes it.
function unionStageEffect(r: RUnionStage, pending: i32[]) {
  if r.usOp == 0 {
    if unionEqStageOpen(r.usKind) < 0 { return irLMiss("union stage slot") }
    return 0
  }
  if r.usOp == 3 {
    unionEqStageClose()
    return 0
  }
  if r.usOp == 4 {
    unionEqHead()
    unionEqNulStageOpen(r.usKind == 1)
    return 0
  }
  const roots = stageLead(r.usV, pending)
  if lwMiss != "" { return 0 }
  lwFloors.push(lwFloor)
  lwFloor = lwLive.length - liveCountIn(pending)
  irLOpnd(r.usV)
  if r.usOp == 5 { fbLocalSet(unionEqNulOpSlot(r.usKind)) }
  if r.usOp == 6 { fbLocalSet(unionEqNulBoxSlot()) }
  if r.usOp == 1 { unionEqStageSetBox() }
  if r.usOp == 2 { unionEqStageSetOther(r.usKind) }
  liveNeutral()
  irLSettle(pending)
  lwFloor = lwFloors.pop() ?? 0
  for v in roots { pending.push(v) }
  return 0
}

// An order stash's field set. An operand the literal follows reaches the stack first, as legacy
// writes it before the literal's fields; its roots wait below the set for their reader.
function stashSetEffect(r: RStashSet, pending: i32[]) {
  const roots = stageLead(r.ssV, pending)
  if lwMiss != "" { return 0 }
  lwFloors.push(lwFloor)
  lwFloor = lwLive.length - liveCountIn(pending)
  stashSet(r)
  liveNeutral()
  irLSettle(pending)
  lwFloor = lwFloors.pop() ?? 0
  for v in roots { pending.push(v) }
  return 0
}

// A discarded `.map`/`.filter`: its list built as the value builds it, then dropped. Kept out of
// `node`, whose frame each level of a nested lowering pays.
function mapFilterDropped(r: RMapFilter, pending: i32[]): i32 {
  if irLowerListHook(r) < 0 { return -1 }
  irLSettle(pending)
  fbDrop()
  return 0
}

function node(id: i32, pending: i32[], tail: boolean, armOut: i32) {
  if id < 0 || id >= lw.irNodes.length { return irLMiss("no node") }
  const ops = storeLeadOpnds(lw.irNodes[id], armOut)
  if ops.length == 0 || pending.length == 0 {
    return nodeNow(id, pending, tail, armOut)
  }
  // An earlier operand's temps reach the stack before the store, as legacy writes that operand
  // first; they wait below it for their reader, as below a valued `if`.
  const roots = stageLeadOf(ops, pending)
  if lwMiss != "" { return 0 }
  if roots.length == 0 { return nodeNow(id, pending, tail, armOut) }
  lwFloors.push(lwFloor)
  lwFloor = lwLive.length - liveCountIn(pending)
  nodeNow(id, pending, tail, armOut)
  liveNeutral()
  lwFloor = lwFloors.pop() ?? 0
  for v in roots { pending.push(v) }
  return 0
}

// The operands of store statement `n`, which an earlier operand's pending temps may wait below;
// none for any other node, and none for an arm's write of its valued `if`'s out, which reads them.
function storeLeadOpnds(n: IrNode, armOut: i32): Opnd[] {
  return match n {
    SAssign => if armOut >= 0 && n.asDst == armOut { [] } else { [n.asSrc] }
    SGlobalSet => [n.gsSrc]
    SSetField => [n.sfV, n.sfSrc]
    SListSet => [n.lsV, n.lsIx, n.lsSrc]
    SArmSite |
      SArmWrite |
      SBlock |
      SBoundsCheck |
      SBr |
      SCellSet |
      SCoalBox |
      SDrop |
      SEffect |
      SForIn |
      SIf |
      SIntSwitch |
      SLet |
      SLoop |
      SRangeLoop |
      SRawOp |
      SReturn |
      SSwitch |
      STrap => []
  }
}

function nodeNow(id: i32, pending: i32[], tail: boolean, armOut: i32) {
  if id < 0 || id >= lw.irNodes.length { return irLMiss("no node") }
  const n = lw.irNodes[id]
  match n {
    SLet => {
      if !isTemp(n.lDst) { return irLMiss("let of a non-temp") }
      if n.lDst >= lwTempRhs.length { return irLMiss("let of a non-temp") }
      lwTempRhs[n.lDst] = n.lRhs
      lwTempDef[n.lDst] = true
      tempOpenMark(id, n.lDst)
      pending.push(n.lDst)
      // A push is consumed through `lwPushed`, not the pending order of the next node.
      const r = n.lRhs
      if r is RRawOp && r.rwOp == "push" {
        pending.pop()
        return pushNow(n.lDst, r)
      }
    }
    SAssign => {
      cond(n.asSrc, pending)
      // An arm's write of its valued `if`'s out leaves the value as the arm's result.
      if armOut >= 0 && n.asDst == armOut { return 0 }
      const s0 = varSlot(n.asDst)
      const s = if s0 >= 0 { s0 } else { ownedSlot(n.asDst) }
      if s < 0 { return irLMiss("unmapped slot") }
      fbLocalSet(s)
    }
    SGlobalSet => {
      match userGlobalWriteClass(n.gsSym, lwGlobalCtx) {
        "plain" => {
          if !globalMinted(n.gsSym) { return irLMiss("global index") }
          cond(n.gsSrc, pending)
          fbGlobalSet(userGlobalIdx(n.gsSym))
          const bit = initBitOf(n.gsSym)
          if bit >= 0 {
            fbI32Const(1)
            fbGlobalSet(bit)
          }
        }
        "promo" => {
          const ps = promoSlotIn(n.gsSym, lwGlobalCtx)
          if ps < 0 { return irLMiss("promoted global write") }
          cond(n.gsSrc, pending)
          fbLocalSet(ps)
        }
        "immutable" => irLMiss("immutable global write")
        // Legacy's write-before-init guard, then the write (`emitUserGlobalSet`). A guarded write's
        // global has an initializer, and only one without has an assigned bit.
        "guard" => {
          if !globalMinted(n.gsSym) { return irLMiss("global index") }
          if initBitOf(n.gsSym) >= 0 {
            return irLMiss("guarded global write init bit")
          }
          cond(n.gsSrc, pending)
          if emitInitGuard(n.gsSym, "written") < 0 {
            return irLMiss("guarded global write")
          }
          fbGlobalSet(userGlobalIdx(n.gsSym))
        }
      }
    }
    SEffect => {
      lwSeq = []
      const r = n.efRhs
      if r is RCall {
        const t = tail
          && (lw.irThunk || voidTailCallee(r.caCallee))
          && !irNoTailEffHas(lw, id)
        call(r, t)
        irLSettle(pending)
        const si = irSigOf(lw, r.caCallee)
        if !t && si >= 0 && !repIsNoValue(lw.irSigRet[si]) { fbDrop() }
        return 0
      }
      if r is RCallRef {
        const t = tail && r.crVoid && !r.crNever
        callRef(r, t)
        irLSettle(pending)
        if !t && r.crDrop { fbDrop() }
        return 0
      }
      if (
        r is RListPush
        || r is RListPushMany
        || r is RListStage
        || r is RMapFilterHead
        || r is RListPop
        || r is RListClear
        || r is RStrOp
      ) {
        irLowerEffectHook(r)
        irLSettle(pending)
        return 0
      }
      if r is RMapClear {
        mapClear(r)
        irLSettle(pending)
        return 0
      }
      if r is RSharedFieldSet {
        sharedFieldSet(r)
        irLSettle(pending)
        return 0
      }
      if r is RMapFilter { return mapFilterDropped(r, pending) }
      if r is RMapSet {
        mapSet(r)
        irLSettle(pending)
        return 0
      }
      if r is RPrint {
        printOp(r)
        irLSettle(pending)
        return 0
      }
      if r is RPrintOpen {
        irLSettle(pending)
        return printOpen(r)
      }
      if r is RMapGet && r.mtPrint >= 0 {
        mapGet(r)
        irLSettle(pending)
        return 0
      }
      if r is RListCopy {
        listCopy(r)
        irLSettle(pending)
        return 0
      }
      // A vector store leaves nothing; any other SIMD op's discarded value is dropped.
      if r is RSimd {
        simd(r)
        irLSettle(pending)
        if !simdStoreAt(r.sdAt) { fbDrop() }
        return 0
      }
      // A store leaves nothing; a discarded load leaves its value, which legacy drops.
      if r is RMemAccess {
        memAccess(r)
        irLSettle(pending)
        if r.mmArgs.length == 1 { fbDrop() }
        return 0
      }
      // A store and a fence leave nothing; any other discarded atomic's value is dropped.
      if r is RAtomic { return atomicEffect(r, pending) }
      if r is RTruncSat {
        truncSat(r)
        irLSettle(pending)
        fbDrop()
        return 0
      }
      // The bulk pair leaves nothing; any other memory op's discarded value is dropped.
      if r is RMemOp {
        const v = memOp(r)
        irLSettle(pending)
        if v == 0 { fbDrop() }
        return 0
      }
      if r is RInitProgress {
        irInitProgressHook(r.ipOrd)
        return 0
      }
      if r is REnvDrop {
        emitEnvCacheDrop(r.edFn)
        irLSettle(pending)
        return 0
      }
      if r is RTagStash { return tagStashEffect(r, pending) }
      if r is RStashSet { return stashSetEffect(r, pending) }
      if r is RUnionStage { return unionStageEffect(r, pending) }
      // A dead call, through a field or past an argument that never returns: `unreachable`, then
      // the drop `emitCallStmt` writes where a member call yields a value.
      if r is RDeadNever {
        const dc = if r.dnAt >= 0 { nodeAt(r.dnAt) } else { null }
        if !(dc is Call) || dc.callFn < 0 {
          return irLMiss("dead never effect")
        }
        fbUnreachable()
        if r.dnPad { fbUnreachable() }
        irLSettle(pending)
        if nodeAt(dc.callFn) is Member && memberCallYieldsValue(r.dnAt) {
          fbDrop()
        }
        return 0
      }
      // A void import leaves nothing; any other host call's discarded value is dropped.
      if r is RCallHost {
        hostCall(r)
        irLSettle(pending)
        if !r.chVoid { fbDrop() }
        return 0
      }
      irLMiss("effect outside I1")
    }
    SCoalBox => coalBox(n, pending)
    SArmSite => armSiteStmt(n, pending)
    SArmWrite => armWriteStmt(n, pending)
    SBlock => {
      if n.bkOut >= 0 && varSlot(n.bkOut) >= 0 {
        return loopValueBlock(n, pending, id)
      }
      if n.bkOut >= 0 { return valuedBlock(n, pending) }
      irLSettle(pending)
      // A loop's list-header hoists open before its block, as legacy's do.
      const hoists = irLoopOpenHook(lw.irNodeAt[id])
      if hoists.loHoists < 0 { return irLMiss("loop hoist prologue") }
      fbBlock(64)
      lwFrames.push(n.bkLabel)
      body(n.bkBody, false, -1, false)
      lwFrames.pop()
      fbEnd()
      irLoopCloseHook(hoists)
    }
    SLoop => {
      irLSettle(pending)
      fbLoop(64)
      lwFrames.push(n.lpLabel)
      body(n.lpBody, false, -1, false)
      lwFrames.pop()
      fbEnd()
    }
    SForIn => forIn(n, pending)
    SRangeLoop => rangeLoop(n, pending)
    SIf => irLMiss("an `if` outside a body walk")
    SBr => {
      if n.brHas {
        if !lw.irHelper && !lvLabelOpen(n.brLabel) {
          return irLMiss("valued branch")
        }
        cond(n.brVal, pending)
      }
      irLSettle(pending)
      const d = brDepth(n.brLabel)
      if d < 0 { return irLMiss("branch out of its frames") }
      fbBr(d)
    }
    SReturn => {
      // A helper's last value falls through its `end`, as the hand-written bodies did; a
      // thunk's is its call's tail form.
      if (
        lw.irHelper
        && !lw.irThunk
        && n.rtHas
        && id == lw.irBody[lw.irBody.length - 1]
      ) {
        cond(n.rtV, pending)
        return 0
      }
      ret(n, pending)
    }
    SRawOp => rawEff(n, pending, lw.irNodeAt[id])
    STrap => {
      irLSettle(pending)
      fbUnreachable()
    }
    SDrop => {
      cond(n.dpV, pending)
      fbDrop()
    }
    SBoundsCheck => irLowerBoundsHook(n, pending)
    SListSet => {
      irLowerListSetHook(n, lw.irNodeAt[id])
      irLSettle(pending)
    }
    SSetField => {
      setField(n, lw.irNodeAt[id])
      irLSettle(pending)
    }
    SIntSwitch => intSwitch(n, pending, tail)
    SCellSet | SSwitch => irLMiss("statement outside I1")
  }
  return 0
}

// A standalone `?.` as `emitOptMemberValueGo` writes it over an unstaged base: the base's null test
// and the leaf's head, then the base as non-null (its niche recovered) and the leaf's tail.
function optRead(r: ROptRead) {
  if r.orTag >= 0 { return optFieldIs(r) }
  return optReadGo(r, false)
}

// `optRead`'s untagged read, written `again` (its root read again from the first, `irHoistRecv`).
function optReadGo(r: ROptRead, again: boolean): i32 {
  const arm = optLeafArmOf(r.orAt, lw.irAt)
  if arm == "fail" { return irLMiss("optional read arm") }
  const m = nodeAt(r.orAt)
  if !(m is OptMember) { return irLMiss("optional read node") }
  return optReadLinks(r, m, arm, [again])
}

// `optReadGo`'s chain test, leaf head, value and tail.
// `read[0]`: whether the root has been read once (`optChainRoot`).
function optReadLinks(
  r: ROptRead,
  m: OptMember,
  arm: OptLeafArm,
  read: boolean[],
): i32 {
  if arm != "nonNull" {
    if optChainIsNullAt(r, r.orAt, read) < 0 { return -1 }
    emitOptLeafHead(r.orAt, lw.irAt)
  }
  if optChainValueAt(r, m.omObj, read) < 0 { return -1 }
  emitOptLeafTail(r.orAt, lw.irAt)
  return 0
}

// `emitOptChainIsNull` over read `r`'s chain at `x`: each link's receiver test, then its own field
// test where the field has a null; the root's null test at the bottom.
function optChainIsNullAt(r: ROptRead, x: i32, read: boolean[]): i32 {
  const m = nodeAt(unwrapParen(x))
  if !(m is OptMember) {
    if optChainRoot(r, x, read, false) < 0 { return -1 }
    fbRefIsNull()
    return 0
  }
  if optChainIsNullAt(r, m.omObj, read) < 0 { return -1 }
  if emitOptLinkNullOpen(x, lw.irAt) && optChainValueAt(r, m.omObj, read) < 0 {
    return -1
  }
  emitOptLinkNullClose(x, lw.irAt)
  return 0
}

// `emitOptChainValue` over read `r`'s chain at `x`: the root, its niche recovered, then each link's
// field, recovered non-null.
function optChainValueAt(r: ROptRead, x: i32, read: boolean[]): i32 {
  const m = nodeAt(unwrapParen(x))
  if !(m is OptMember) {
    if optChainRoot(r, x, read, true) < 0 { return -1 }
    // A staged root's stash read is cast to its record, which recovers it.
    if !optChainStagesRecv(r.orAt) && exprNullableRefNiche(x, lw.irAt) {
      fbRefAsNonNull()
    }
    return 0
  }
  if optChainValueAt(r, m.omObj, read) < 0 { return -1 }
  if emitOptLinkValueTail(x, lw.irAt) < 0 {
    return irLMiss("optional link field")
  }
  return 0
}

// Read `r`'s chain root `x`: its operand the first time, then read again (`opndAgain`). A root
// legacy stages (`optChainStagesRecv`) is teed into its stash first and read back from it after,
// cast to its record where it is read as one (`asRef`), as `emitOptRecvBase` writes it.
function optChainRoot(
  r: ROptRead,
  x: i32,
  read: boolean[],
  asRef: boolean,
): i32 {
  const staged = optChainStagesRecv(r.orAt)
  if staged && !fnUses.optRecv { return irLMiss("optional read stash") }
  if !read[0] {
    read[0] = true
    irLOpnd(r.orV)
    if !staged { return 0 }
    optRecvStashTee()
    return if asRef { optRecvStashCast(x, lw.irAt) } else { 0 }
  }
  if staged { return optRecvStashGet(x, lw.irAt, asRef) }
  return opndAgain(r.orV, x)
}

// A tagged `ROptRead` as legacy's `optField` arm writes it over an unstaged base: its null test,
// then the base as non-null (its niche recovered) and the field's tag test.
function optFieldIs(r: ROptRead) {
  const n = nodeAt(r.orAt)
  const m = if n is IsExpr { nodeAt(unwrapParen(n.isObj)) } else { null }
  if !(m is OptMember) { return irLMiss("optional field test node") }
  const si = optChainStructIdxOf(m.omObj, lw.irAt)
  if si < 0 { return irLMiss("optional field test row") }
  irLOpnd(r.orV)
  fbRefIsNull()
  optFieldIsOpen()
  irLOpnd(r.orV)
  if exprNullableRefNiche(m.omObj, lw.irAt) { fbRefAsNonNull() }
  return optFieldIsTail(si, m.omProp, r.orTag)
}

// An integer switch as `emitIntSwitch` writes it: the outer frame, the default's, one per arm,
// the index less its low value (a 64-bit one range-tested onto the default), the `br_table`, then
// each arm and a branch past the rest, and the else. A tail chain's arms are in tail position.
function intSwitch(n: SIntSwitch, pending: i32[], tail: boolean) {
  // A valued switch's outer frame is typed by its out, which each arm leaves for its branch.
  const t = n.isOut
  if t >= lw.irVars.length { return irLMiss("valued switch out") }
  const vt = if t >= 0 { valtypeOf(lw.irVars[t].vRep) } else { 64 }
  if vt < 0 { return irLMiss("valued switch rep") }
  irLSettle(pending)
  const m = n.isArms.length
  const span = n.isTable.length - 1
  const lo = n.isLo
  fbBlock(vt)
  lwFrames.push(-1)
  const endDepth = ctrlDepth
  let k = 0
  while k <= m {
    fbBlock(64)
    lwFrames.push(-1)
    k = k + 1
  }
  irLOpnd(n.isOn)
  if n.isWide {
    fbI64Const(lo >> 31, lo)
    fbI32Bin(125) // 0x7d i64.sub
    fbI32WrapI64()
    fbI32Const(span + 1)
    irLOpnd(n.isOn)
    fbI64Const(lo >> 31, lo)
    fbI32Bin(125) // 0x7d i64.sub
    fbI64Const(0, span + 1)
    fbI32Bin(84) // 0x54 i64.lt_u
    fbSelect()
  } else if lo != 0 {
    fbI32Const(lo)
    fbI32Bin(107) // 0x6b i32.sub
  }
  fbBrTable(n.isTable, m)
  const armTail = n.isTail && tail
  for a in n.isArms {
    fbEnd()
    lwFrames.pop()
    body(a, armTail, t, false)
    fbBr(ctrlDepth - endDepth)
  }
  fbEnd()
  lwFrames.pop()
  body(n.isElse, armTail, t, false)
  fbEnd()
  lwFrames.pop()
  if t >= 0 {
    livePush(t)
    pending.push(t)
  }
  return 0
}

// What `ifOpen` did with a node: not an `if`, wrote all of it, or opened its `else` (a plain or a
// valued `if`), which `ifClose` ends once the body walk has written that `else`.
const IF_NOT = -1
const IF_DONE = 0
const IF_ELSE = 1
const IF_VALUED = 2

// Opens `if` node `id` up to its `else`. The loop exit `if c {} else { br L }` is legacy's
// `eqz; br_if`, and a literal-true test writes no test at all, either for that exit or for an
// else-less `if`, whose arm runs inline. A test that is only constant, as a dead null test is,
// keeps its `if` (`condLitTrue`).
function ifOpen(id: i32, pending: i32[], tail: boolean): i32 {
  if id < 0 || id >= lw.irNodes.length { return IF_NOT }
  const n = lw.irNodes[id]
  if !(n is SIf) { return IF_NOT }
  if n.siOut >= 0 { return valuedIfOpen(id, n, pending) }
  const exitBr = n.siThen.length == 0
    && n.siElse.length == 1
    && isBr(n.siElse[0])
  const litTrue = isTrue(n.siCond) && testIsLitTrue(lw.irNodeAt[id])
  if litTrue && (exitBr || n.siElse.length == 0 && !n.siElseKw) {
    irLSettle(pending)
    if !exitBr { body(n.siThen, tail, -1, false) }
    return IF_DONE
  }
  // A helper's `if c { br L }` is the hand-written bodies' `br_if`.
  if (
    lw.irHelper
    && n.siThen.length == 1
    && isBr(n.siThen[0])
    && n.siElse.length == 0
  ) {
    const b = lw.irNodes[n.siThen[0]]
    if b is SBr && !b.brHas {
      cond(n.siCond, pending)
      const d = brDepth(b.brLabel)
      if d < 0 {
        irLMiss("branch out of its frames")
        return IF_DONE
      }
      fbBrIf(d)
      return IF_DONE
    }
  }
  cond(n.siCond, pending)
  if exitBr {
    const b = lw.irNodes[n.siElse[0]]
    if b is SBr {
      const d = brDepth(b.brLabel)
      if d < 0 {
        irLMiss("branch out of its frames")
        return IF_DONE
      }
      fbI32Eqz()
      fbBrIf(d)
    }
    return IF_DONE
  }
  fbIf(64)
  lwFrames.push(-1)
  body(n.siThen, tail, -1, false)
  if n.siElse.length > 0 || n.siElseKw {
    fbElse()
    return IF_ELSE
  }
  lwFrames.pop()
  fbEnd()
  return IF_DONE
}

// The operands a `??` reads in place: its left, and a fused map read's key or a list read's
// index, which stay above any earlier operand it stages.
function coalReads(n: SCoalBox): Opnd[] {
  const cs: Opnd[] = [n.cbL]
  const mp = n.cbMap
  if mp != null { cs.push(mp.prKey) }
  const ix = n.cbIdx
  if ix != null { cs.push(ix) }
  return cs
}

// Writes the temps an earlier operand left pending below the valued `if` about to open on `c`,
// in definition order, as legacy writes that operand first; each root stays on the stack for its
// one reader after the `if`, and `pending` keeps the condition's temps. Returns the roots.
function stageLead(c: Opnd, pending: i32[]): i32[] {
  return stageLeadOf([c], pending)
}

// `stageLead` below a node that reads operands `cs`.
function stageLeadOf(cs: Opnd[], pending: i32[]): i32[] {
  const roots: i32[] = []
  if pending.length == 0 { return roots }
  // Keyed by the pending temps alone: every valued `if` of a function asks, so it costs theirs.
  const inCond: {[i32]: boolean} = Map()
  const readBy: {[i32]: boolean} = Map()
  for c in cs { condTemps(c, inCond) }
  // A temp another pending temp's definition reads is written inside that one, not staged.
  for v in pending {
    if v >= 0 && v < lwStackVal.length && !lwStackVal[v] {
      for o in irRhsOpnds(lwTempRhs[v]) {
        if o is OVar { readBy[o.ov] = true }
      }
    }
  }
  let k = 0
  while k < pending.length && !inCond.has(pending[k]) { k = k + 1 }
  let i = k
  while i < pending.length {
    if !inCond.has(pending[i]) {
      irLMiss("staged operand interleaves the condition")
      return roots
    }
    i = i + 1
  }
  lwSeq = []
  i = 0
  while i < k {
    const v = pending[i]
    if !readBy.has(v) {
      roots.push(v)
      if !lwStackVal[v] {
        // A root's definition reads above the roots already staged below it, which stay there.
        lwRootRuns.push(lwRootRun)
        lwRootRun = rootsFloor(lwLive, lwFloor, roots) - lwFloor
        stageRoot(v)
        lwRootRun = lwRootRuns.pop() ?? 0
      }
      lwSeq.push(v)
    }
    i = i + 1
  }
  // The roots and the temps their definitions read reach the stack in definition order.
  i = 0
  while i < k {
    if i >= lwSeq.length || lwSeq[i] != pending[i] {
      irLMiss("non-stack temp: out of order")
      return roots
    }
    i = i + 1
  }
  if lwSeq.length != k { irLMiss("non-stack temp: out of order") }
  lwSeq = []
  const rest: i32[] = []
  i = k
  while i < pending.length {
    rest.push(pending[i])
    i = i + 1
  }
  while pending.length > 0 { pending.pop() }
  for v in rest { pending.push(v) }
  return roots
}

// The live index just past the run of `roots` that sits in `live` from `floor` up.
function rootsFloor(live: i32[], floor: i32, roots: i32[]): i32 {
  const isRoot: {[i32]: boolean} = Map()
  for r in roots { isRoot[r] = true }
  let f = floor
  while f < live.length && isRoot.has(live[f]) { f = f + 1 }
  return f
}

// The order rule under `rootsFloor`, keyed: 0 a value above a run of roots is taken (1); 1 a
// value above a non-root, and 2 one above a non-root sitting over a root, are refused (0).
export function irStageFloorSelfTest(k: i32): i32 {
  const roots: i32[] = [1]
  const live: i32[] = if k == 0 { [1, 3] } else if k == 1 { [2, 3] } else { [1, 2, 3] }
  const ends: i32[] = []
  while ends.length < live.length { ends.push(0) }
  const ok = liveTakeOk(live, ends, rootsFloor(live, 0, roots), 3, 0)
  return if ok { 1 } else { 0 }
}

// How many of `vs` are values on the stack.
function liveCountIn(vs: i32[]): i32 {
  let k = 0
  for v in vs {
    if v >= 0 && v < lwStackVal.length && lwStackVal[v] { k = k + 1 }
  }
  return k
}

// Writes temp `v`'s definition, a `.push` receiver's with its list payload cast strict.
function tempRhsWrite(v: i32) {
  if !irPushRecvAt(lw, v) { return rhs(tempRhs(v), false) }
  const was = pushRecvCastOn()
  pushRecvCastSet(true)
  rhs(tempRhs(v), false)
  pushRecvCastSet(was)
  return 0
}

// Writes temp `v`'s definition now and leaves its value on the stack, above any already there.
function stageRoot(v: i32) {
  // It lands above the roots staged before it, as legacy writes the operands in turn.
  lwPushing = true
  tempOpenNote(v)
  tempRhsWrite(v)
  lwPushing = false
  return livePush(v)
}

// Marks in `into` the temps condition `c` consumes: its own operand, and every temp a pending
// definition among them reads.
function condTemps(c: Opnd, into: {[i32]: boolean}) {
  if !(c is OVar) || c.ov < 0 || c.ov >= lw.irVars.length || into.has(c.ov) {
    return 0
  }
  into[c.ov] = true
  if c.ov < lwStackVal.length && lwStackVal[c.ov] { return 0 }
  if !isTemp(c.ov) { return 0 }
  for o in irRhsOpnds(lwTempRhs[c.ov]) { condTemps(o, into) }
  return 0
}

// An `if` whose arms each end by writing its slotless out: a value-typed `if` (legacy's `&&` and
// `||`), whose result stays on the stack for the out's one later read.
function valuedIfOpen(id: i32, n: SIf, pending: i32[]): i32 {
  const t = n.siOut
  if varSlot(t) >= 0 {
    irLMiss("valued if into a slot")
    return IF_DONE
  }
  if t < 0 || t >= lw.irVars.length || t >= lwStackVal.length {
    irLMiss("valued if out")
    return IF_DONE
  }
  // A helper's `if` may yield a raw reference, as its hand-written body's did.
  const rr = repNodeAt(lw.irVars[t].vRep)
  // An atom join, nullable at the `-1` niche or not, or a boolean at its `2` niche, is an `i32`
  // `if` (`emitIfExprAs` at 127).
  const atomOut = rr is RAtom
    || rr is RNullable && rr.rnDisc == 3
    || repBoolNiche(lw.irVars[t].vRep)
  const refOut = lw.irHelper && rr is RRaw
  // A reference join takes legacy's blocktype for the `if` at its node (`emitIfExprRef`).
  const at = lw.irNodeAt[id] ?? -1
  // A join the atom hook takes at an atom out is the hook's while no raw read of it runs, and
  // opens at the i32 blocktype the hook passes `emitIfExprAs`.
  const atomJoin = at >= 0
    && rr is RAtom
    && atomHookArmOf(at, lw.irAt, false) == "litJoin"
  if atomJoin && atomHookArmOf(at, lw.irAt, true) != "litJoin" {
    irLMiss("atom if join raw read")
    return IF_DONE
  }
  const vt = if atomJoin || atomOut { 127 } else { valtypeOf(lw.irVars[t].vRep) }
  // A union join opens at the box's blocktype, as `emitUnionIfValueLink` does; so does an
  // else-less one its destination's union coercion writes there.
  const boxOut = !lw.irHelper
    && (rr is RBox || rr is RNullable && rr.rnDisc == 4)
    && at >= 0
    && (ifJoinPlanOf(at, lw.irAt).ijArm == "union"
    || elseLessUnionIfWhy(at, lw.irAt, lw.irVars[t].vTy) == ""
    || n.siAtDst)
  // A string or reference out at a call is a tag dispatch's, which opens through `tagDispatchIfOf`.
  const strOut = (repPrim(lw.irVars[t].vRep) == "str"
    || rr is RRecord
    || rr is RList
    || rr is RMap
    || rr is RClosure)
    && at >= 0
    && nodeAt(unwrapParen(at)) is Call
  const decided = n.siJoin.rjKind != null
  const rj = if vt < 0 && !refOut && !strOut && !boxOut && decided { n.siJoin } else if vt < 0 && !refOut && !strOut && !boxOut && at >= 0 { ifRefJoinOf(at, lw.irAt) } else { noRefJoin() }
  const rk = rj.rjKind
  if vt < 0 && !refOut && !strOut && !boxOut && rk == null {
    irLMiss("valued if rep")
    return IF_DONE
  }
  const roots = stageLead(n.siCond, pending)
  if lwMiss != "" { return IF_DONE }
  // A row this `if` opens starts above the earlier operands staged below it (`emitIndexBanked`).
  rowOpenNote(id)
  joinBoxHead(t, true)
  // The condition is written before the `if` opens and may read values already on the stack;
  // the `if` itself reads none of the values beneath it.
  lwFloors.push(lwFloor)
  lwFloor = lwLive.length - liveCountIn(pending)
  cond(n.siCond, pending)
  lwFloor = lwLive.length
  for r in roots { pending.push(r) }
  if rr is RRaw && refOut {
    fbIfRefNul(rr.rwHeap, rr.rwNull)
  } else if strOut {
    if tagDispatchIfOf(lw.irVars[t].vTy) < 0 { irLMiss("valued if rep") }
  } else if boxOut {
    fbOpenIf()
    fbValtype("union", -1)
  } else if rk != null {
    fbOpenIf()
    fbRefIfOpenType(
      rk,
      rj.rjSlot,
      if decided { n.siJoinNul } else { ifLinkYieldsNull(at, lw.irAt) },
    )
  } else {
    fbIf(vt)
  }
  lwFrames.push(-1)
  body(n.siThen, false, t, false)
  fbElse()
  return IF_VALUED
}

// A `??` through legacy's shared tails, along its arm: a boxed operand's, or the fused pop's. The
// out stays on the stack for its one later read, as a valued `if`'s does.
function coalBox(n: SCoalBox, pending: i32[]) {
  const t = n.cbOut
  if varSlot(t) >= 0 { return irLMiss("coalesce box into a slot") }
  if t < 0 || t >= lw.irVars.length || t >= lwStackVal.length {
    return irLMiss("coalesce box out")
  }
  const e0 = nodeAt(n.cbAt)
  if !(e0 is BinExpr) && !(e0 is AsExpr && n.cbArm == "asProp") {
    return irLMiss("coalesce box node")
  }
  // An earlier operand's temps are written below the operand, and the box head after them, as
  // legacy writes that operand first.
  const stages = coalArmStagesLeads(n.cbArm)
  const roots = stageLeadOf(coalReads(n), pending)
  if lwMiss != "" { return -1 }
  joinBoxHead(t, stages || roots.length > 0)
  lwFloors.push(lwFloor)
  lwFloor = lwLive.length - liveCountIn(pending)
  const got = coalBoxGo(n, pending)
  lwFloor = lwFloors.pop() ?? 0
  if got < 0 { return -1 }
  for r in roots { pending.push(r) }
  livePush(t)
  pending.push(t)
  return 0
}

// The `??` (or propagating `as`) itself along its arm, inside `coalBox`'s staging.
function coalBoxGo(n: SCoalBox, pending: i32[]): i32 {
  const e = nodeAt(n.cbAt)
  if e is AsExpr { return coalAsProp(n, e, pending) }
  if !(e is BinExpr) { return irLMiss("coalesce box node") }
  const ba = coalValBoxArm(n.cbArm)
  return if ba != null { coalBoxArm(n, ba, e, pending) } else { match n.cbArm {
    "popOr" => coalPopOr(n, e, pending)
    "listGetOr" => coalListGetOr(n, e, pending)
    "mapIndexGetOr" => coalMapGetOr(n, e, pending)
    "nulRef" => coalNulRef(n, e, pending)
    "litUnion" => coalNicheCell(n, e, -1, pending)
    "nulBool" => coalNicheCell(n, e, 2, pending)
    "fieldBox" | "fieldVal" => coalUnionField(n, e, pending)
    "optLeaf" => coalOptLeaf(n, e, pending)
    "optBoxLeaf" => coalOptBoxLeaf(n, e, pending)
    "optRecLeaf" => coalOptRecLeaf(n, e, pending)
    "optMapField" => coalOptMapField(n, e, pending)
    "nulAtomJoin" => coalNulAtomJoin(n, e, pending)
    "nulBoolJoin" => coalNulBoolJoin(n, pending)
    "boxStash" => coalBoxStash(n, e, pending)
    "boxRuntime" => coalBoxRuntime(n, pending)
    "boxFieldScalar" => coalBoxFieldScalar(n, e, pending)
    "nulStr" => coalNulStr(n, e, pending)
    "asProp" => irLMiss("propagating as over a `??`")
    "boolPop" | "valBox" | "valScalar" | "valNoKind" | "elem" | "callBox" | "callScalar" | "callNoKind" | "next" => {
      irLMiss("coalesce box arm")
    }
  } }
}

// A propagating `as` over a nullable-ref niche, as `emitAsNulNiche` writes it: the plain block at
// the non-null heap, the operand inside it, the branch out on non-null, then the null path, which
// returns the function's null.
function coalAsProp(n: SCoalBox, e: AsExpr, pending: i32[]): i32 {
  if n.cbArm != "asProp" { return irLMiss("propagating as arm") }
  const heap = asPropNicheHeapOf(e.asObj, lw.irAt)
  if heap < 0 { return irLMiss("propagating as heap") }
  if pending.length > 0 { return irLMiss("propagating as below a temp") }
  coalNulRefOpen(heap, false)
  cond(n.cbL, body(n.cbLB, false, -1, true))
  coalNulRefBranch()
  return coalNulRefTail(n, -1)
}

// `l ?? d` along legacy's `boxStash` rung, as `emitCoalesceBoxStash` writes it: the operand box,
// the shared slot, its tag tested present opening the box-typed `if`, the stash, the else, then
// the default writing the slotless out.
function coalBoxStash(n: SCoalBox, _e: BinExpr, pending: i32[]): i32 {
  cond(n.cbL, pending)
  coalBoxStashOpen(sharedFieldRecvSlot())
  fbElse()
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  fbEnd()
  return 0
}

// `l ?? d` over a box read at its storage along legacy's `boxRuntime` rung, as
// `emitCoalesceBoxRuntime` writes a scalar result: the box into the shared slot, its tag tested
// present opening the scalar `if`, the payload unboxed, the else, the default writing the out.
function coalBoxRuntime(n: SCoalBox, pending: i32[]): i32 {
  const bk = coalBoxRuntimeKind(n.cbAt)
  if bk < 0 { return irLMiss("coalesce box runtime kind") }
  cond(n.cbL, pending)
  coalBoxRuntimeOpen(sharedFieldRecvSlot(), bk)
  fbElse()
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  fbEnd()
  return 0
}

// `l ?? d` over a `K | null` niche joined into a box, as `emitCoalesceNulAtomJoin` writes it: the
// operand teed into its slot and tested null, the boxed default, then the member string boxed.
function coalNulAtomJoin(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const texts = nulLitAtomTexts(unwrapParen(e.binLeft), lw.irAt)
  if texts.length == 0 { return irLMiss("coalesce atom join member") }
  const slot = widenTmpSlot(4001)
  cond(n.cbL, pending)
  coalNulAtomJoinOpen(slot)
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  return coalNulAtomJoinPresent(texts, slot)
}

// `o.v ?? d` over a value-union record field along `coalFieldPlanOf`, as `emitCoalesceUnionField`
// writes it: the record variable, the field's null test opening the `if`, the default writing the
// slotless out, the else, the record again and the field's box or its unboxed payload, the end.
function coalUnionField(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const lhsIx = unwrapParen(e.binLeft)
  if lhsIx < 0 || lhsIx >= P.nodes.length {
    return irLMiss("coalesce field node")
  }
  const m = nodeAt(lhsIx)
  // A `p?.f` an instance holds over a non-null record takes that record's row (D17566).
  const osi = if m is OptMember { structIndexOfTy(repTyOf(opRepOf(n.cbL))) } else { -1 }
  const p = if osi >= 0 { coalFieldPlanOfOpt(e, lhsIx, osi, n.cbAt, lw.irAt) } else { coalFieldPlanOf(e, lhsIx, n.cbAt, lw.irAt) }
  const boxed = n.cbArm == "fieldBox"
  if p.cfArm != (if boxed { "boxed" } else { "unbox" }) {
    return irLMiss("coalesce field plan")
  }
  // A receiver legacy keeps in its stash is teed there and read back (`coalFieldRecvStash`).
  const recvIx = if m is Member { m.memObj } else if m is OptMember && osi >= 0 { m.omObj } else { -1 }
  if recvIx < 0 { return irLMiss("coalesce field node") }
  const st = coalFieldRecvStash(recvIx, p)
  cond(n.cbL, pending)
  coalArmRecvCast(p.cfCast)
  if st >= 0 { fbLocalTee(st) }
  if boxed { coalFieldBoxOpen(p) } else { coalFieldValOpen(p) }
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  fbElse()
  if st >= 0 {
    fbLocalGet(st)
  } else {
    if opndAgain(n.cbL, recvIx) < 0 { return -1 }
    coalArmRecvCast(p.cfCast)
  }
  if boxed { coalFieldRead(p) }
  else if coalFieldUnbox(p) < 0 { return -1 }
  lwFrames.pop()
  fbEnd()
  return 0
}

// `p?.f ?? d` over a nullable record's scalar or string field along `coalOptLeafPlanOf`, as
// `emitCoalesceOptNulRecord` writes it: the receiver variable, its null test opening the leaf's
// `if`, the default writing the slotless out, the else, the receiver read again, and its field.
function coalOptLeaf(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const m = nodeAt(unwrapParen(e.binLeft))
  if (
    !(m is OptMember)
    || coalOptArmOf(unwrapParen(e.binLeft), lw.irAt) != "nulRecord"
  ) {
    return irLMiss("coalesce optional field plan")
  }
  const lp = coalOptLeafPlanOf(m, structIndexOfExpr(m.omObj, lw.irAt))
  if lp.olLeaf == null { return irLMiss("coalesce optional field plan") }
  // A staged receiver (`optChainStagesRecv`) is teed into its stash, then read back from it cast to
  // its record, as `emitOptRecvBase` writes it.
  const staged = optChainStagesRecv(unwrapParen(e.binLeft))
  if staged && !fnUses.optRecv { return irLMiss("coalesce optional stash") }
  cond(n.cbL, pending)
  if staged { optRecvStashTee() }
  coalOptLeafOpen(lp)
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  fbElse()
  if staged {
    if optRecvStashGet(m.omObj, lw.irAt, true) < 0 { return -1 }
  } else if opndAgain(n.cbL, m.omObj) < 0 {
    return -1
  }
  lwFrames.pop()
  return coalOptLeafRead(lp)
}

// `m[k]?.f ?? d` as `emitCoalesceOptMapField` writes it: the probe, the hit's field off the
// entry's value (`optMapFieldHit`), then the default writing the slotless out, and the `end`.
function coalOptMapField(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const mp = n.cbMap
  if mp == null { return irLMiss("coalesce optional map probe") }
  const fnIx = lw.irAt
  const lhsIx = unwrapParen(e.binLeft)
  const m = if lhsIx >= 0 { nodeAt(lhsIx) } else { null }
  if !(m is OptMember) || coalOptArmOf(lhsIx, fnIx) != "mapField" {
    return irLMiss("coalesce optional map field plan")
  }
  const rd = nodeAt(m.omObj)
  if !(rd is Index) { return irLMiss("coalesce optional map field plan") }
  const p = optMapFieldPlanOf(m.omProp, mapShapeOfExpr(rd.idxArr, fnIx))
  if p.ofLeaf == null { return irLMiss("coalesce optional map field plan") }
  if mp.prSym >= 0 && userGlobalReadClass(mp.prSym, lwGlobalCtx) != "plain" {
    return irLMiss("map read of a global not read plainly")
  }
  lwSeq = []
  mapProbeHead(rd.idxArr, mp.prSym, mp.prNonNull, n.cbL, mp.prKey)
  irLSettle(pending)
  if optMapFieldHit(p) < 0 { return -1 }
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  fbEnd()
  return 0
}

// `p?.f ?? d` over a union box field, as `emitOptCoalesceBoxLeaf` writes it over an unstaged base
// that is no link itself: the chain's null test (the base's, then the field's), the plan's `if`, the
// default, then the base again and the field's box at the result's rep.
function coalOptBoxLeaf(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const lhsIx = unwrapParen(e.binLeft)
  if lhsIx < 0 || lhsIx >= P.nodes.length {
    return irLMiss("coalesce optional box field node")
  }
  const m = nodeAt(lhsIx)
  if !(m is OptMember) { return irLMiss("coalesce optional box field node") }
  // A staged base is teed into its stash and read back from it, as the chain walk writes it.
  const staged = optChainStagesRecv(lhsIx)
  if optRecvStagedAt(m.omObj) && !staged {
    return irLMiss("coalesce optional box field staged receiver")
  }
  const p = coalOptBoxLeafPlanAt(
    e,
    m,
    structIndexOfExpr(m.omObj, lw.irAt),
    n.cbAt,
    lw.irAt,
  )
  if p.obFail != "" { return irLMiss("coalesce optional box field plan") }
  if staged || nodeAt(unwrapParen(m.omObj)) is OptMember {
    return coalOptBoxChain(n, lhsIx, m, p, pending)
  }
  const niche = exprNullableRefNiche(m.omObj, lw.irAt)
  cond(n.cbL, pending)
  fbRefIsNull()
  if emitOptLinkNullOpen(lhsIx, lw.irAt) {
    if opndAgain(n.cbL, m.omObj) < 0 { return -1 }
    if niche { fbRefAsNonNull() }
  }
  emitOptLinkNullClose(lhsIx, lw.irAt)
  optBoxLeafOpen(p)
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  fbElse()
  if opndAgain(n.cbL, m.omObj) < 0 { return -1 }
  if niche { fbRefAsNonNull() }
  lwFrames.pop()
  return optBoxLeafRead(p)
}

// `a?.b?.f ?? d` over a union box field, as `emitOptCoalesceBoxLeaf` writes a chain: the chain's
// null test from its root `cbL` (`emitOptChainIsNull`), the plan's `if`, the default, then the
// chain's value (`emitOptChainValue`) and the field's box at the result's rep.
function coalOptBoxChain(
  n: SCoalBox,
  lhsIx: i32,
  m: OptMember,
  p: OptBoxLeafPlan,
  pending: i32[],
): i32 {
  const r: ROptRead = { orV: n.cbL, orAt: lhsIx, orTag: -1 }
  const read: boolean[] = [false]
  lwSeq = []
  if optChainIsNullAt(r, lhsIx, read) < 0 { return -1 }
  irLSettle(pending)
  optBoxLeafOpen(p)
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  fbElse()
  if optChainValueAt(r, m.omObj, read) < 0 { return -1 }
  lwFrames.pop()
  return optBoxLeafRead(p)
}

// `p?.f ?? d` over a record field, as `emitCoalesceOptNulRecord` writes it over an unstaged base:
// the base and its null test, the base again and the field slot's, the default, then the base a
// third time and the field.
function coalOptRecLeaf(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const m = nodeAt(unwrapParen(e.binLeft))
  if !(m is OptMember) { return irLMiss("coalesce optional record field node") }
  if optRecvStagedAt(m.omObj) {
    return irLMiss("coalesce optional record field staged receiver")
  }
  const p = coalOptRecLeafPlanAt(
    e,
    m,
    structIndexOfExpr(m.omObj, lw.irAt),
    lw.irAt,
  )
  if p.orTgtHeap < 0 { return irLMiss("coalesce optional record field plan") }
  cond(n.cbL, pending)
  optRecLeafTestOpen()
  if opndAgain(n.cbL, m.omObj) < 0 { return -1 }
  optRecLeafTestClose(p)
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  fbElse()
  if opndAgain(n.cbL, m.omObj) < 0 { return -1 }
  lwFrames.pop()
  return optRecLeafRead(p)
}

// A `boolean | null` niche joining a box, as `emitCoalesceNulBoolJoin` writes it: the slot taken,
// the operand kept in it, the null test's box `if` the default fills, then the present arm.
function coalNulBoolJoin(n: SCoalBox, pending: i32[]): i32 {
  coalNulBoolJoinReserve()
  cond(n.cbL, pending)
  coalNulBoolJoinOpen()
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  return coalNulBoolJoinPresent()
}

// A shared `scalar | null` field's `??` along its plan: the box, the stash and tag test whose
// present arm unboxes, the default writing the slotless out in the `else`, and the end.
function coalBoxFieldScalar(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const p = coalBoxFieldScalarPlanOf(e, n.cbAt, lw.irAt)
  if p.bfKind < 0 { return irLMiss("coalesce box field plan") }
  cond(n.cbL, pending)
  if coalBoxFieldScalarOpen(p) < 0 { return -1 }
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  fbEnd()
  return 0
}

// A boxed operand's arm: the stash slot taken before the box, the box, the open, the default
// writing the slotless out, the else, a binding's re-read box, and the end.
function coalBoxArm(
  n: SCoalBox,
  arm: CoalBoxArm,
  e: BinExpr,
  pending: i32[],
): i32 {
  const lhsIx = unwrapParen(e.binLeft)
  const fnIx = lw.irAt
  const slot = coalBoxSlot(arm)
  cond(n.cbL, pending)
  if coalBoxOpen(arm, slot, e, lhsIx, n.cbAt, fnIx) < 0 { return -1 }
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  if coalBoxElse(arm, slot, e, lhsIx, n.cbAt, fnIx) < 0 { return -1 }
  const reread = match arm {
    "valBox" | "valScalar" => true
    "elem" | "callBox" | "callScalar" | "boolPop" | "valNoKind" | "callNoKind" | "next" => false
  }
  if reread && opndAgain(n.cbL, e.binLeft) < 0 { return -1 }
  lwFrames.pop()
  return coalBoxEnd(arm, e, lhsIx, n.cbAt, fnIx)
}

// The fused `xs.pop() ?? d`: the receiver held in its local or staged as legacy stages it, the
// shared open, then the default writing the slotless out, and the end.
function coalPopOr(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const fnIx = lw.irAt
  const p = popOrPlanOf(unwrapParen(e.binLeft), fnIx)
  if p == null { return irLMiss("popOr plan") }
  let lIdx = listOpRecvHeld(p.poRecv, fnIx, ".pop")
  if lIdx == -2 { return irLMiss("popOr receiver") }
  lwSeq = []
  if lIdx >= 0 {
    irLSkip(n.cbL)
  } else {
    irLOpnd(n.cbL)
    const sb = listOpStageBase(p.poBase, -1)
    stageListRecvTail(p.poRecv, fnIx, sb)
    lIdx = sb + 3
  }
  irLSettle(pending)
  popOrOpen(p, lIdx)
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  fbEnd()
  return 0
}

// The fused `xs.get(i) ?? d`: legacy's shared head re-reads the receiver and the index the
// builder found re-readable, so the receiver operand is skipped, and the index is the builder's
// operand where it holds one (`listGetIdxHook`); then the default and the end.
function coalListGetOr(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  lwSeq = []
  irLSkip(n.cbL)
  if lwMiss != "" { return -1 }
  // An index temp is consumed into its local ahead of the head, before the pending temps settle.
  const ci = n.cbIdx
  const tempIdx = ci != null && ci is OVar && isTemp(ci.ov)
  const early = if tempIdx && ci != null { irGetIdxBegin(ci) } else { false }
  irLSettle(pending)
  const hooked = if early { true } else if ci != null { irGetIdxBegin(ci) } else { false }
  // The receiver, skipped above, is read again at each of the head's reads where it can be.
  const call = nodeAt(unwrapParen(e.binLeft))
  const callee = if call is Call && call.callFn >= 0 { nodeAt(call.callFn) } else { null }
  const recvIx = if callee is Member { unwrapParen(callee.memObj) } else { -1 }
  // A receiver legacy would stage is the builder's local (`heldInLocal`), read through the hook.
  const recvHooked = recvIx >= 0 && irGetRecvBegin(n.cbL, recvIx)
  if recvHooked { listGetRecvUnstage() }
  const ek = listGetOrOpen(unwrapParen(e.binLeft), lw.irAt)
  if recvHooked { listGetRecvRelease() }
  if recvHooked { irGetRecvEnd() }
  if hooked { irGetIdxEnd() }
  if ek == null { return irLMiss("listGetOr head") }
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  fbEnd()
  return 0
}

// A `string | null` `??` whose default computes: the plain block at the string heap, nullable as
// `coalesceNulStrStaysNullable`, the operand inside it, the branch out on non-null, then the tail.
function coalNulStr(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  // A join stages the operand ahead of its `if` and boxes it on the present path.
  if coalNulRefArmOf(e, n.cbAt, lw.irAt) == "join" {
    cond(n.cbL, pending)
    coalNulRefJoinOpen()
    return coalNulRefTail(n, coalNulRefJoinTag(e, sTy(), lw.irAt))
  }
  if pending.length > 0 { return irLMiss("coalesce string below a temp") }
  coalNulRefOpen(sTy(), coalesceNulStrStaysNullable(n.cbAt, lw.irAt))
  cond(n.cbL, body(n.cbLB, false, -1, true))
  coalNulRefBranch()
  return coalNulRefTail(n, -1)
}

// A nullable reference's `??` along its plan: the plain block (the operand inside it, the branch
// out on non-null) or a join's staged `if` (the operand ahead of it), then the shared tail.
function coalNulRef(n: SCoalBox, e: BinExpr, pending: i32[]): i32 {
  const fnIx = lw.irAt
  const p = coalNulRefPlanOf(e, unwrapParen(e.binLeft), n.cbAt, fnIx)
  if p == null { return irLMiss("coalesce nulRef heap") }
  return match p.nrArm {
    "plain" => {
      if pending.length > 0 { return irLMiss("coalesce nulRef below a temp") }
      coalNulRefOpen(p.nrHeap, coalesceDefaultNullable(e.binRight, fnIx))
      cond(n.cbL, body(n.cbLB, false, -1, true))
      coalNulRefBranch()
      coalNulRefTail(n, -1)
    }
    "join" => {
      cond(n.cbL, pending)
      coalNulRefJoinOpen()
      coalNulRefTail(n, p.nrTag)
    }
    "noBox" | "listClash" | "litAtom" => irLMiss("coalesce nulRef " + p.nrArm)
  }
}

// An i32 niche cell's `??` whose null is `sent`: the operand, the shared open, the default writing
// the slotless out, then the stash or, where legacy re-reads the operand, the operand again.
function coalNicheCell(
  n: SCoalBox,
  e: BinExpr,
  sent: i32,
  pending: i32[],
): i32 {
  const reEval = !coalLhsStashes(unwrapParen(e.binLeft))
  cond(n.cbL, pending)
  coalNicheOpen(sent, reEval)
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  coalNicheElse(reEval)
  if reEval && opndAgain(n.cbL, e.binLeft) < 0 { return -1 }
  lwFrames.pop()
  fbEnd()
  return 0
}

// The default of a nullable reference's `??` writing the slotless out, then, for a join, the
// present arm boxing the staged reference under `tag`, and the end.
function coalNulRefTail(n: SCoalBox, tag: i32): i32 {
  lwFrames.push(-1)
  body(n.cbNull, false, n.cbOut, false)
  lwFrames.pop()
  if tag >= 0 { coalNulRefJoinPresent(tag) }
  fbEnd()
  return 0
}

// Ends `if` node `id` that `ifOpen` opened as `k`, once its `else` is written; a valued `if`'s
// out joins `pending`, the body the `if` stands in.
function ifClose(id: i32, k: i32, pending: i32[]) {
  lwFrames.pop()
  fbEnd()
  if k != IF_VALUED { return 0 }
  lwFloor = lwFloors.pop() ?? 0
  if id < 0 || id >= lw.irNodes.length { return 0 }
  const n = lw.irNodes[id]
  if n is SIf && n.siOut >= 0 && n.siOut < lwStackVal.length {
    livePush(n.siOut)
    pending.push(n.siOut)
  }
  return 0
}

// A loop value's frame (`lvFrameOpen`): typed by its result binding, which each `break v` reads
// before branching out; a tail assigning it falls out with it, and the frame's value is stored back
// into the binding. A `while`'s list-header hoists open around it, as legacy's do.
function loopValueBlock(n: SBlock, pending: i32[], id: i32) {
  if n.bkOut < 0 || n.bkOut >= lw.irVars.length {
    return irLMiss("loop value out")
  }
  const slot = varSlot(n.bkOut)
  const vt = valtypeOf(lw.irVars[n.bkOut].vRep)
  // A reference binding's frame is typed by its local's kind, as `lvFrameOpen` writes it.
  const li = slot - fbFrameParams
  if (
    vt < 0
    && (li < 0 || li >= localIsRef.length || li >= localStructIdx.length)
  ) {
    return irLMiss("loop value rep")
  }
  irLSettle(pending)
  const hoists = irLoopOpenHook(lw.irNodeAt[id])
  if hoists.loHoists < 0 { return irLMiss("loop hoist prologue") }
  if vt >= 0 {
    fbBlock(vt)
  } else {
    fbOpenBlock()
    fbValtype(localIsRef[li], localStructIdx[li])
  }
  lwFrames.push(n.bkLabel)
  lwLvLabels.push(n.bkLabel)
  const k = n.bkBody.length - 1
  const last = if k >= 0 { lw.irNodes[n.bkBody[k]] } else { null }
  if last is SBr && last.brHas && last.brLabel == n.bkLabel {
    const head: i32[] = []
    let i = 0
    while i < k {
      head.push(n.bkBody[i])
      i = i + 1
    }
    body(head, false, -1, false)
    irLOpnd(last.brVal)
  } else {
    body(n.bkBody, false, -1, false)
  }
  lwLvLabels.pop()
  lwFrames.pop()
  fbEnd()
  fbLocalSet(slot)
  irLoopCloseHook(hoists)
  return 0
}

// Whether `label` is an open loop value's frame.
function lvLabelOpen(label: i32): boolean {
  for l in lwLvLabels {
    if l == label { return true }
  }
  return false
}

// A helper's valued block: its out is written by each branch to it and by its last node, and
// stays on the stack for the out's one later read, as a valued `if`'s does.
function valuedBlock(n: SBlock, pending: i32[]) {
  const t = n.bkOut
  if !lw.irHelper { return irLMiss("valued block") }
  if varSlot(t) >= 0 || t >= lwStackVal.length {
    return irLMiss("valued block out")
  }
  const vt = valtypeOf(lw.irVars[t].vRep)
  if vt < 0 { return irLMiss("valued block rep") }
  irLSettle(pending)
  fbBlock(vt)
  lwFrames.push(n.bkLabel)
  body(n.bkBody, false, t, false)
  lwFrames.pop()
  fbEnd()
  livePush(t)
  pending.push(t)
  return 0
}

function isBr(id: i32): boolean {
  if id < 0 || id >= lw.irNodes.length { return false }
  return lw.irNodes[id] is SBr
}

// A return: its value, then `return`, or a call's tail form when the value is a direct call.
function ret(n: SReturn, pending: i32[]) {
  if !n.rtHas {
    irLSettle(pending)
    retExtra()
    return fbReturnOp()
  }
  if retAfterEffectsTail(n.rtV, pending) { return 0 }
  // A returned `__trap__` is its `unreachable`, which legacy writes with no `return` after it.
  const tv = n.rtV
  if tv is OVar && isTemp(tv.ov) && retIsTrap(tempRhs(tv.ov)) {
    irLOpnd(tv)
    irLSettle(pending)
    return 0
  }
  // A call retagged into its `K | null` is the same i32, so legacy tail-calls it too.
  const outer = retagOf(n.rtV)
  const inner = if outer >= 0 { retagOperand(outer) } else { n.rtV }
  const callee = callTemp(inner)
  if callee >= 0 && !(inner is OVar && irNoTailHas(lw, inner.ov)) {
    const t = inner
    if t is OVar {
      if outer >= 0 { takeUse(outer) }
      takeUse(t.ov)
      const r = tempRhs(t.ov)
      lwSeq = []
      if r is RCall { call(r, true) }
      if r is RCallRef { callRef(r, true) }
      lwSeq.push(t.ov)
      if outer >= 0 { lwSeq.push(outer) }
      irLSettle(pending)
    }
    return 0
  }
  cond(n.rtV, pending)
  return sinkExit()
}

// Whether `r` is a `__trap__` call read as a value (`trapCallRhs`), not a dead read's `unreachable`.
function retIsTrap(r: Rhs): boolean {
  if !(r is RDeadNever) || r.dnAt < 0 || r.dnAt >= P.nodes.length {
    return false
  }
  const c = nodeAt(r.dnAt)
  if !(c is Call) || c.callFn < 0 || c.callFn >= P.nodes.length { return false }
  const f = nodeAt(c.callFn)
  return f is Ident && f.identName == "__trap__"
}

// Whether returned `v` is a call after effects (`RAfterEffects`), now written as legacy writes it:
// the effects dropped, then the call in its tail form.
function retAfterEffectsTail(v: Opnd, pending: i32[]): boolean {
  if !(v is OVar) || !isTemp(v.ov) { return false }
  const r0 = tempRhs(v.ov)
  if !(r0 is RAfterEffects) { return false }
  const iv = r0.aeV
  if !(iv is OVar) || callTemp(iv) < 0 || irNoTailHas(lw, iv.ov) {
    return false
  }
  takeUse(v.ov)
  lwSeq = []
  for e in r0.aeEff {
    irLOpnd(e)
    fbDrop()
  }
  takeUse(iv.ov)
  const r = tempRhs(iv.ov)
  if r is RCall { call(r, true) }
  if r is RCallRef { callRef(r, true) }
  lwSeq.push(iv.ov)
  lwSeq.push(v.ov)
  irLSettle(pending)
  return true
}

// A returned value already written exits as `emitUnionRetSink` writes it: a function taking the
// union return sink pops a box built here into the sink pair and branches to the exit block
// wrapped round the body, and anything else returns.
function sinkExit() {
  if fnUses.unionSink && uBoxNewIsLast() {
    uBoxSinkToPair()
    fbBr(lwFrames.length)
    lwSinkFired = lwSinkFired + 1
    return 0
  }
  retExtra()
  return fbReturnOp()
}

// The captures a lifted function hands back after its result (`irRetExtra`), as every legacy exit
// pushes them (`fbPushRetExtra`); the IR's exits write `fbReturnOp`, never legacy's seeded list.
function retExtra() {
  for v in lw.irRetExtra {
    const w = varSlot(v)
    if w < 0 { return irLMiss("lifted extra result slot") }
    fbLocalGet(w)
  }
  return 0
}

function spanOpen(id: i32) {
  for k in lw.irSpansAt[id] ?? [] {
    lwSpanOpen.push(k)
    lwSpanAt.push(curLen())
  }
  return 0
}

// Closes, innermost first, every open span whose last node is `id`, banking a row for each that
// wrote bytes. The scan stops once each span `id` ends (`irSpanEnds`) is closed.
function spanClose(id: i32) {
  let need = lw.irSpanEnds[id] ?? 0
  if need == 0 { return 0 }
  let i = lwSpanOpen.length - 1
  while i >= 0 && need > 0 {
    const k = lwSpanOpen[i]
    if k >= 0 && lw.irSpanLast[k] == id {
      const from = lwSpanAt[i]
      const to = curLen()
      if to > from {
        lwRowAst.push(lw.irSpanAst[k])
        lwRowFrom.push(from)
        lwRowTo.push(to)
        lwRowKind.push(lw.irSpanKind[k])
      }
      lwSpanOpen[i] = -1
      need = need - 1
    }
    i = i - 1
  }
  // Drop the closed rows past `i`, keeping the open ones in order.
  const o2: i32[] = []
  const a2: i32[] = []
  let j = i + 1
  while j < lwSpanOpen.length {
    if lwSpanOpen[j] >= 0 {
      o2.push(lwSpanOpen[j])
      a2.push(lwSpanAt[j])
    }
    j = j + 1
  }
  while lwSpanOpen.length > i + 1 {
    lwSpanOpen.pop()
    lwSpanAt.pop()
  }
  for x in o2 { lwSpanOpen.push(x) }
  for x in a2 { lwSpanAt.push(x) }
  return 0
}

let lwBuf: u8[] = []
let lwGot: u8[] = []

// The code entry the last dual emit lowered, for a mismatch's detail.
export function irLoweredEntry(): u8[] { return lwGot }

// `b` as hex bytes, space-separated.
export function irHexOf(b: u8[]): string {
  let s = ""
  for x in b { s = s + hex(x) + " " }
  return s
}

function curLen(): i32 { return lwBuf.length }

// The lowering's write position, which an element read's row starts at.
export function irLAt(): i32 { return lwBuf.length }

// Asks legacy's site arm of the assignment whose writing opens at node `id` (`irSiteArmAt`).
function siteArmMintAt(id: i32) {
  if !lw.irHasSiteArms { return 0 }
  const ix = lw.irSiteArmAt[id] ?? -1
  if ix >= 0 { strSiteArmMint(ix, lw.irAt) }
  return 0
}

// Asks the list pair of the spread literal whose groups' writing opens at node `id`
// (`irSpreadPair`), as `emitArrSpread` asks it before its groups; a first ask mints it.
function spreadPairMintAt(id: i32) {
  const nt = lw.irSpreadPair[id]
  if nt == null { return 0 }
  if nt.sqBoxRow >= 0 {
    spreadWrapIdx("reflist", nt.sqBoxRow)
    spreadBackIdx("reflist", nt.sqBoxRow)
    return 0
  }
  const lb: ListBuild = { lbKind: nt.sqKind, lbSlot: nt.sqSlot }
  elabSpreadNote(nt.sqAt)
  const p = spreadPlanOf(nt.sqAt, lw.irAt, lb)
  if p.spWhy != "" { return irLMiss("spread plan") }
  spreadWrapIdx(p.spKind, p.spRow)
  spreadBackIdx(p.spKind, p.spRow)
  return 0
}

// Notes where node `id` began, where an element read's row opens at it (`irRowOpens`).
function rowOpenNote(id: i32) {
  if lw.irHasRowOpens && lw.irRowOpens.has(id) { lwRowOpenAt[id] = curLen() }
  return 0
}

// Marks temp `v` as the row node `id` opens, when it opens one, so `tempOpenNote` re-notes it.
function tempOpenMark(id: i32, v: i32) {
  if lw.irHasRowOpens && lw.irRowOpens.has(id) { lwRowOpenTemp[v] = id }
  return 0
}

// Re-notes the row a pending temp `v` opens where its definition is written, as legacy's row
// starts at the receiver's first byte, after any earlier operand staged below it.
function tempOpenNote(v: i32) {
  const id = lwRowOpenTemp[v] ?? -1
  if id >= 0 { lwRowOpenAt[id] = curLen() }
  return 0
}

// Where element read `ix`'s row starts: where its receiver's opening statement began, else `from`.
export function irLIndexFrom(ix: i32, from: i32): i32 {
  const id = lw.irIdxRowAt[ix] ?? -1
  if id < 0 { return from }
  return lwRowOpenAt[id] ?? from
}

// The arm-site reads whose arms are lowering, each banking one row over its whole chain.
const lwIdxRowMutes: i32[] = []
// The payload variable of each arm lowering, innermost last, and the element read its receiver is
// (-1 for none).
const lwPayloadVars: i32[] = []
const lwPayloadRows: i32[] = []

// Banks the element-read row of `Index` node `ix` written from `from` on, as legacy's
// `emitIndexBanked` does: only where names and the source map are emitted, and only over bytes.
export function irLIndexRow(ix: i32, from: i32) {
  if !idxRowsOn() || lwBuf.length <= from || i32ListHas(lwIdxRowMutes, ix) {
    return 0
  }
  lwRowAst.push(ix)
  lwRowFrom.push(from)
  lwRowTo.push(lwBuf.length)
  lwRowKind.push(6)
  return 0
}

// The valtype byte of a scalar rep, or -1.
export function valtypeOf(r: i32): i32 {
  const p = repPrim(r)
  if p == null { return -1 }
  return match p {
    "i32" | "bool" => 0x7f
    "i64" => 0x7e
    "f32" => 0x7d
    "f64" => 0x7c
    "v128" => 0x7b
    "str" | "u8" | "null" => -1
  }
}

// Whether an arm-site read holds its box in the receiver stash and that box is out `t`.
function stashedArmSiteReads(t: i32): boolean {
  for n in lw.irNodes {
    if n is SArmSite && n.saStash {
      const b = n.saOps[0]
      if b is OVar && b.ov == t { return true }
    }
  }
  return false
}

// Whether number kind `src` to `dst` narrows: to `i32` from any other, or to `i64` from a float.
function numNarrows(src: i32, dst: i32): boolean {
  return dst == 1 && src != 1 || dst == 3 && (src == 4 || src == 5)
}

// The payload and index variables of the function's arm-site reads (`SArmSite`) and arm writes
// (`SArmWrite`).
function armSitePayloads(): {[i32]: boolean} {
  const r: {[i32]: boolean} = Map()
  for n in lw.irNodes {
    if n is SArmSite {
      for v in n.saVars { r[v] = true }
      if n.saIdx >= 0 { r[n.saIdx] = true }
    }
  }
  for w in lw.irNodes {
    if w is SArmWrite {
      for v in w.awVars { r[v] = true }
    }
  }
  return r
}

// The locals vector legacy's frame layout writes, read once the body has grown the lazy list
// frame. A variable holding a declared slot must carry the valtype legacy declared there.
function framedLocals(): u8[] {
  const nLocals = listIdxScratchBase - fbFrameParams - fbEagerScratch
  const payloads = armSitePayloads()
  let vi = 0
  for v in lw.irVars {
    vi = vi + 1
    // A `shadow` arm's variable, and an arm site's payload, sit in the frame's list scratch, which
    // the frame declares.
    if (
      v.vKind == "local"
      && v.vSlot >= fbFrameParams
      && !listFitShadowHolds(v.vSlot)
      && !isRecvStashHolds(v.vSlot)
      && !payloads.has(vi - 1)
    ) {
      const li = v.vSlot - fbFrameParams
      if li >= nLocals || !runAgrees(v.vRep, li) { irLMiss("locals layout") }
    }
  }
  const out: u8[] = []
  fbEmitLocalsVec(out, nLocals)
  return out
}

// Whether wasm local `slot` of the frame legacy is writing holds rep `rep`: a scalar's valtype, or
// a reference run for a reference rep. A parameter's slot is the signature's.
export function irSlotRunAgrees(rep: i32, slot: i32): boolean {
  if slot - fbFrameParams < 0 { return true }
  const b = irSlotValtype(slot)
  if b.length == 0 { return false }
  const t = valtypeOf(rep)
  const scalarRun = b[0] >= 0x7b && b[0] <= 0x7f
  return if t >= 0 { b.length == 1 && b[0] == t } else { !scalarRun }
}

// The record type of the struct row legacy declares wasm local `slot` at (`slotRowTyOf`), or -1
// for a parameter's slot, an unset one or a local of another kind.
export function irSlotRowTy(slot: i32): i32 {
  const li = slot - fbFrameParams
  if li < 0 || li >= localIsRef.length || fbLocalIsUnsetRef(li) { return -1 }
  if localIsRef[li] != "struct" { return -1 }
  return slotRowTyOf(localStructIdx[li])
}

// The valtype bytes legacy declares wasm local `slot` of the frame it is writing at; none for a
// parameter's slot or one it has not set.
export function irSlotValtype(slot: i32): u8[] {
  const out: u8[] = []
  const li = slot - fbFrameParams
  if li < 0 || li >= localIsRef.length || fbLocalIsUnsetRef(li) { return out }
  const b: u8[] = []
  const prev = wTarget(b)
  fbLocalRun(localIsRef[li], localStructIdx[li])
  wTarget(prev)
  let i = 1
  while i < b.length {
    out.push(b[i])
    i = i + 1
  }
  return out
}

// Whether declared local `li`'s run is scalar rep `rep`'s valtype; a reference rep takes the run
// legacy declares for it.
function runAgrees(rep: i32, li: i32): boolean {
  const t = valtypeOf(rep)
  if t < 0 { return true }
  if li >= localIsRef.length || fbLocalIsUnsetRef(li) { return false }
  const b: u8[] = []
  const prev = wTarget(b)
  fbLocalRun(localIsRef[li], localStructIdx[li])
  wTarget(prev)
  return b.length == 2 && b[1] == t
}

// Lowers `f`'s body, with its globals accessed in `ctx`, into `lwBuf` up to its `end`, or a
// mismatch class in `lwMiss`.
function lowerBody(f: IrFn, ctx: GlobalCtx) {
  lwReset(f, ctx, [])
  uBoxNewEnd = -1
  // The builders keep the emitter's control depth; it goes back as found.
  const prev = wTarget(lwBuf)
  const valued = !repIsNoValue(f.irRetRep)
  // The single start body opens with legacy's pool fill; an init function's does not.
  if f.irPoolFill { irStartPrologueHook() }
  // Legacy tail-calls a void body's last call, but not the start function's, nor in a lifted
  // body that hands captures back after it (`irRetExtra`).
  body(
    f.irBody,
    !valued && (f.irAt >= 0 || f.irThunk) && f.irRetExtra.length == 0,
    -1,
    false,
  )
  const pad = if valued { f.irEndPad } else { "" }
  if pad == "null" {
    emitNullRetTail(nullRetPlanOf(f.irAt))
    // Inside the sink's exit block this `null` exits like any return there (`emitFallThroughPad`).
    if lwSinkFired > 0 { sinkExit() }
  } else if pad == "unreachable" {
    fbUnreachable()
  }
  if lwSinkFired > 0 { sinkClose() }
  retExtra()
  fbEnd()
  wTarget(prev)
  // Every frame a builder opened is closed, so the one depth not given back is the function's
  // own `end`'s, which opened none.
  ctrlDepth = ctrlDepth + 1
  return 0
}

// Starts lowering `f`, its globals accessed in `ctx`, onto `buf`.
function lwReset(f: IrFn, ctx: GlobalCtx, buf: u8[]) {
  lw = f
  lwGlobalCtx = ctx
  lwMiss = ""
  lwTempRhs = []
  lwTempDef = []
  lwTempUsed = []
  lwStackVal = []
  lwLive = []
  lwLiveEnd = []
  lwFloor = 0
  lwRootRun = 0
  lwRootRuns = []
  lwFloors = []
  lwLeadBoxes = []
  lwStashAt = []
  getIdxSlots = []
  lwOwnedSlots = []
  lwBoxHeadAt = []
  lwIfHeadAt = Map()
  lwIfHeadBuilt = false
  lwIfBoxAt = Map()
  lwIfBoxTy = Map()
  lwStashFi = []
  lwStashSlots = []
  const none: Rhs = { ggSym: -1, ggNonNull: false, ggNn: -1 }
  for _v in f.irVars {
    lwTempRhs.push(none)
    lwTempDef.push(false)
    lwTempUsed.push(false)
    lwStackVal.push(false)
  }
  lwSeq = []
  lwFrames = []
  lwHeadSlot = []
  lwHeadDepth = []
  lwLvLabels = []
  lwSpanOpen = []
  lwSpanAt = []
  lwRowAst = []
  lwRowFrom = []
  lwRowTo = []
  lwRowKind = []
  lwRowOpenAt = Map()
  lwRowOpenTemp = Map()
  lwBuf = buf
  lwSinkFired = 0
  lwPushed = []
  lwPushing = false
  return 0
}

// The lowering's whole state, saved around a fragment lowered while another lowering is open.
type LwFrame = {
  lfFn: IrFn,
  lfCtx: GlobalCtx,
  lfMiss: string,
  lfTempRhs: Rhs[],
  lfTempDef: boolean[],
  lfTempUsed: boolean[],
  lfStackVal: boolean[],
  lfLive: i32[],
  lfLiveEnd: i32[],
  lfFloor: i32,
  lfFloors: i32[],
  lfLeadBoxes: i32[],
  lfRootRun: i32,
  lfRootRuns: i32[],
  lfSeq: i32[],
  lfFrames: i32[],
  lfSpanOpen: i32[],
  lfSpanAt: i32[],
  lfRowAst: i32[],
  lfRowFrom: i32[],
  lfRowTo: i32[],
  lfRowKind: i32[],
  lfRowOpenAt: {[i32]: i32},
  lfRowOpenTemp: {[i32]: i32},
  lfBuf: u8[],
  lfSinkFired: i32,
  lfPushed: i32[],
  lfPushing: boolean,
}

function lwSave(): LwFrame {
  const f: LwFrame = {
    lfFn: lw,
    lfCtx: lwGlobalCtx,
    lfMiss: lwMiss,
    lfTempRhs: lwTempRhs,
    lfTempDef: lwTempDef,
    lfTempUsed: lwTempUsed,
    lfStackVal: lwStackVal,
    lfLive: lwLive,
    lfLiveEnd: lwLiveEnd,
    lfFloor: lwFloor,
    lfFloors: lwFloors,
    lfLeadBoxes: lwLeadBoxes,
    lfRootRun: lwRootRun,
    lfRootRuns: lwRootRuns,
    lfSeq: lwSeq,
    lfFrames: lwFrames,
    lfSpanOpen: lwSpanOpen,
    lfSpanAt: lwSpanAt,
    lfRowAst: lwRowAst,
    lfRowFrom: lwRowFrom,
    lfRowTo: lwRowTo,
    lfRowKind: lwRowKind,
    lfRowOpenAt: lwRowOpenAt,
    lfRowOpenTemp: lwRowOpenTemp,
    lfBuf: lwBuf,
    lfSinkFired: lwSinkFired,
    lfPushed: lwPushed,
    lfPushing: lwPushing,
  }
  return f
}

function lwRestore(f: LwFrame) {
  lw = f.lfFn
  lwGlobalCtx = f.lfCtx
  lwMiss = f.lfMiss
  lwTempRhs = f.lfTempRhs
  lwTempDef = f.lfTempDef
  lwTempUsed = f.lfTempUsed
  lwStackVal = f.lfStackVal
  lwLive = f.lfLive
  lwLiveEnd = f.lfLiveEnd
  lwFloor = f.lfFloor
  lwFloors = f.lfFloors
  lwLeadBoxes = f.lfLeadBoxes
  lwRootRun = f.lfRootRun
  lwRootRuns = f.lfRootRuns
  lwSeq = f.lfSeq
  lwFrames = f.lfFrames
  lwSpanOpen = f.lfSpanOpen
  lwSpanAt = f.lfSpanAt
  lwRowAst = f.lfRowAst
  lwRowFrom = f.lfRowFrom
  lwRowTo = f.lfRowTo
  lwRowKind = f.lfRowKind
  lwRowOpenAt = f.lfRowOpenAt
  lwRowOpenTemp = f.lfRowOpenTemp
  lwBuf = f.lfBuf
  lwSinkFired = f.lfSinkFired
  lwPushed = f.lfPushed
  lwPushing = f.lfPushing
  return 0
}

// Whether a fragment's frame gives back the staging root run it found: a fragment lowered while a
// root is staged resets the run (`lwReset`), and the outer staging reads on with its own. 1 when so.
export function irRootRunFrameSelfTest(): i32 {
  const outer = lwSave()
  lwRootRun = 2
  lwRootRuns = [1]
  const inner = lwSave()
  lwRootRun = 0
  lwRootRuns = []
  lwRestore(inner)
  const ok = lwRootRun == 2 && lwRootRuns.length == 1
  lwRestore(outer)
  return if ok { 1 } else { 0 }
}

// Lowers fragment `f` with value `out` (`irLowerNodeIn`) onto the buffer being written, where
// legacy's own writer would leave it, in legacy's frame for `fnStmts` slot `fnPos`. "" when
// written, its rows banked as legacy banks them unless `probe`; else the miss, with the buffer,
// its relocation rows and the callees as found. A `probe` leaves the emitter's state as found.
export function irLowerFragment(
  f: IrFn,
  out: Opnd,
  ctx: GlobalCtx,
  fnPos: i32,
  probe: boolean,
): string {
  const sv = lwSave()
  const callees0 = dfeCallee.length
  const box0 = uBoxNewEnd
  const depth0 = ctrlDepth
  const cur = wTarget([])
  wTarget(cur)
  const at = cur.length
  lwReset(f, ctx, cur)
  fragmentBody(f.irBody, out)
  softMiss(f.irName)
  if lwSinkFired > 0 { irLMiss("fragment return") }
  if ctrlDepth != depth0 { irLMiss("fragment control depth") }
  const why = lwMiss
  if why == "" && probe {
    while dfeCallee.length > callees0 { dfeCallee.pop() }
    uBoxNewEnd = box0
  } else if why == "" {
    fragmentRows(fnPos)
  } else {
    while cur.length > at { cur.pop() }
    relTrim()
    while dfeCallee.length > callees0 { dfeCallee.pop() }
    ctrlDepth = depth0
  }
  lwRestore(sv)
  return why
}

// Writes fragment body `b`, then its value `out`, which consumes what the body left pending as a
// `return`'s value does.
function fragmentBody(b: i32[], out: Opnd) {
  const pending = body(b, false, -1, true)
  if lwMiss != "" { return 0 }
  cond(out, pending)
  if pending.length > 0 { irLMiss("non-stack temp: unconsumed") }
  return 0
}

// A fragment's rows, banked as legacy's writers bank them: an element read's only where the
// `vl-src` section is written, else noted for the shadow; a statement's always.
function fragmentRows(fnPos: i32) {
  let r = 0
  while r < lwRowAst.length {
    if lwRowKind[r] == 6 && !idxSpanOn() {
      shIdxNode.push(lwRowAst[r])
      shIdxFrom.push(lwRowFrom[r])
      shIdxTo.push(lwRowTo[r])
    } else {
      bankSpanRow(
        lwRowAst[r],
        fnPos,
        lwRowFrom[r],
        lwRowTo[r],
        lwRowKind[r],
        "",
      )
    }
    r = r + 1
  }
  return 0
}

// The size-prefixed code entry `f` (its globals accessed in `ctx`) lowers to, or a mismatch class
// in `lwMiss`. The frame is legacy's, opened by `fbBeginFunc`.
function entry(f: IrFn, ctx: GlobalCtx): u8[] {
  lowerBody(f, ctx)
  return framed(framedLocals())
}

// The code entry of the body in `lwBuf` behind locals vector `locals`, its rows moved with it.
function framed(locals: u8[]): u8[] {
  const code: u8[] = []
  for x in locals { code.push(x) }
  const bodyAt = code.length
  const out: u8[] = []
  // `wBytes` carries a relocated constant's row with the bytes that hold it.
  const p2 = wTarget(code)
  wBytes(lwBuf)
  wTarget(out)
  wULEB(code.length)
  const shift = out.length + bodyAt
  wBytes(code)
  wTarget(p2)
  let r = 0
  while r < lwRowFrom.length {
    lwRowFrom[r] = lwRowFrom[r] + shift
    lwRowTo[r] = lwRowTo[r] + shift
    r = r + 1
  }
  return out
}

// Lowers claimed function `f` (at `fnStmts` slot `fnPos`) onto `out` in legacy's place: its code
// entry, its statement rows, and its callees kept for dead-function elimination. "" when written,
// else the miss, with nothing written.
export function irLowerClaim(
  f: IrFn,
  ctx: GlobalCtx,
  fnPos: i32,
  out: u8[],
): string {
  const callees0 = dfeCallee.length
  if gTestClaimRefusal == 1 {
    emitFail("emitProgram: test claim refusal before the body")
  }
  const got = entry(f, ctx)
  if gTestClaimRefusal == 2 {
    emitFail("emitProgram: test claim refusal after the body")
  }
  softMiss(f.irName)
  if lwMiss != "" {
    while dfeCallee.length > callees0 { dfeCallee.pop() }
    // Legacy lowers the function in its place, from the empty lazy frame `fbBeginFunc` left.
    fbResetLazyFrame()
    return lwMiss
  }
  const at = out.length
  for x in got { out.push(x) }
  let r = 0
  while r < lwRowAst.length {
    bankSpanRow(
      lwRowAst[r],
      fnPos,
      lwRowFrom[r] + at,
      lwRowTo[r] + at,
      lwRowKind[r],
      "",
    )
    r = r + 1
  }
  return ""
}

// Lowers `f` for the order check (shadow mode 6) and returns its code entry, writing nothing and
// banking no row; empty on a miss. Legacy then lowers from the empty lazy frame.
export function irLowerProbe(f: IrFn, ctx: GlobalCtx): u8[] {
  const callees0 = dfeCallee.length
  fbResetLazyFrame()
  const got = entry(f, ctx)
  while dfeCallee.length > callees0 { dfeCallee.pop() }
  fbResetLazyFrame()
  if lwMiss != "" { return [] }
  return got
}

// Lowers the compare helper `f` onto `out` in the frame `eqHelpFnCode` opened, its locals vector
// that frame's, as legacy's helper writes it. "" when written, else the miss, with nothing written
// and the lazy frame left empty for legacy.
export function irLowerEqHelper(f: IrFn, out: u8[]): string {
  // The lazy frame grows from empty, as `fbBeginFunc` left it; the shadow's follows legacy's.
  fbResetLazyFrame()
  lowerBody(f, lwGlobalCtx)
  softMiss(f.irName)
  if lwPushed.length > 0 { irLMiss("push never consumed") }
  if lwMiss != "" {
    fbResetLazyFrame()
    return lwMiss
  }
  const locals: u8[] = []
  fbEmitLocalsVec(locals, 0)
  const p = wTarget(out)
  wBytes(framed(locals))
  wTarget(p)
  return ""
}

// `irLowerEqHelper` for the shadow, before legacy writes the helper: the callees it notes are
// taken back and the lazy frame is left empty again, so legacy writes from the state it would
// have had unarmed.
export function irShadowLowerEqHelper(f: IrFn, out: u8[]): string {
  const callees0 = dfeCallee.length
  const why = irLowerEqHelper(f, out)
  while dfeCallee.length > callees0 { dfeCallee.pop() }
  fbResetLazyFrame()
  return why
}

// Lowers runtime helper `f` onto `out`: its locals are its `local` variables, one per slot after
// its parameters. A helper IrFn is built and lowered in the call that writes it and never cached,
// so a callee index it read is current. "" when written, else the miss, with nothing written.
export function irLowerHelper(f: IrFn, out: u8[]): string {
  if !f.irHelper { return "not a helper" }
  fnUses.unionSink = false
  lowerBody(f, lwGlobalCtx)
  softMiss(f.irName)
  const runs: i32[] = []
  let slot = f.irParams.length
  for v in f.irVars {
    if v.vKind == "local" && v.vSlot >= 0 {
      if v.vSlot != slot { irLMiss("helper locals") }
      slot = slot + 1
      if runs.length > 0 && runs[runs.length - 1] == v.vRep {
        runs[runs.length - 2] = runs[runs.length - 2] + 1
      } else {
        runs.push(1)
        runs.push(v.vRep)
      }
    }
  }
  if lwPushed.length > 0 { irLMiss("push never consumed") }
  if lwMiss != "" { return lwMiss }
  const locals: u8[] = []
  const prev = wTarget(locals)
  wULEB(runs.length / 2)
  let i = 0
  while i < runs.length {
    wULEB(runs[i])
    helperValtype(runs[i + 1])
    i = i + 2
  }
  wTarget(prev)
  if lwMiss != "" { return lwMiss }
  const p3 = wTarget(out)
  wBytes(framed(locals))
  wTarget(p3)
  return ""
}

// Writes rep `r`'s valtype: a scalar's, or a raw reference at its heap type.
function helperValtype(r: i32) {
  const n = repNodeAt(r)
  if n is RRaw {
    wU8(if n.rwNull { 0x63 } else { 0x64 })
    return wSLEB(n.rwHeap)
  }
  const t = valtypeOf(r)
  if t < 0 { return irLMiss("helper local rep") }
  return wU8(t)
}

// The returns that sank into the union return sink in the function being lowered.
let lwSinkFired = 0

// Wraps the body in the sink's exit block and builds the function's one box from the pair, as
// legacy's `emitFuncCode` closes a sinking body.
function sinkClose() {
  const opened: u8[] = [0x02, 0x40]
  for x in lwBuf { opened.push(x) }
  lwBuf = opened
  wTarget(lwBuf)
  let r = 0
  while r < lwRowFrom.length {
    lwRowFrom[r] = lwRowFrom[r] + 2
    lwRowTo[r] = lwRowTo[r] + 2
    r = r + 1
  }
  fbEnd()
  fbLocalGet(unionSinkBase)
  fbLocalGet(unionSinkBase + 1)
  fbStructNew(uBoxIdx)
  return 0
}

// The dual emit: lowers `f` and compares it with the legacy code entry `legacy` (this function's
// whole entry) and the statement and element-read rows banked from `spanBase` on, at offsets in `legacy`
// once `spanShift` is taken off. "" when they are identical, else the first difference's class;
// `skew` breaks the lowering on purpose (`irShadowCorrupt`).
export function irDualEmit(
  f: IrFn,
  ctx: GlobalCtx,
  legacy: u8[],
  spanBase: i32,
  spanShift: i32,
  skew: i32,
): string {
  // The lowering's calls note their callees as legacy's did; the shadow takes its own back. It
  // grows a lazy list frame of its own from empty: legacy's is spent, its locals vector written,
  // and the next function's `fbBeginFunc` resets it.
  const callees0 = dfeCallee.length
  fbResetLazyFrame()
  const got = entry(f, ctx)
  while dfeCallee.length > callees0 { dfeCallee.pop() }
  lwGot = got
  if lwMiss != "" { return "unlowered: " + lwMiss }
  // The comparison's own controls: 1 adds a byte to the lowering, 2 drops its first span row.
  if skew == 1 { got.push(0x01) }
  if skew == 2 && lwRowAst.length > 0 { lwRowAst[0] = -2 }
  if skew == 3 { dropReadRows() }
  let i = 0
  while i < got.length && i < legacy.length && got[i] == legacy[i] { i = i + 1 }
  if i < got.length || i < legacy.length {
    return "bytes: "
      + regionAt(i, legacy)
      + " at "
      + byteText(legacy, i)
      + " vs "
      + byteText(got, i)
  }
  // The start's top-level, statement and element-read rows (kinds 1, 5 and 6) legacy banked for
  // this function, against the lowering's.
  const ln: i32[] = []
  const lf: i32[] = []
  const lt: i32[] = []
  const lk: i32[] = []
  let k = spanBase
  while k < emitFnSpanStart.length {
    if (
      emitFnSpanKind[k] == 1
      || emitFnSpanKind[k] == 5
      || emitFnSpanKind[k] == 6
    ) {
      ln.push(emitFnSpanNode[k])
      lf.push(emitFnSpanStart[k] - spanShift)
      lt.push(emitFnSpanEnd[k] - spanShift)
      lk.push(emitFnSpanKind[k])
    }
    k = k + 1
  }
  // The element reads the armed shadow noted where the section banks none.
  let q = 0
  while q < shIdxNode.length {
    ln.push(shIdxNode[q])
    lf.push(shIdxFrom[q] - spanShift)
    lt.push(shIdxTo[q] - spanShift)
    lk.push(6)
    q = q + 1
  }
  if ln.length != lwRowAst.length {
    return "spans: count "
      + i32ToStr(ln.length)
      + " vs "
      + i32ToStr(lwRowAst.length)
  }
  let j = 0
  while j < ln.length {
    if !rowListed(ln[j], lf[j], lt[j], lk[j]) {
      const what = if lk[j] == 6 { "read " } else { "" }
      return "spans: " + what + kindOf(ln[j])
    }
    j = j + 1
  }
  return ""
}

// The control that drops every element-read row the lowering banked (`irShadowCorrupt(5)`).
function dropReadRows() {
  const a: i32[] = []
  const f: i32[] = []
  const t: i32[] = []
  const k: i32[] = []
  let i = 0
  while i < lwRowAst.length {
    if lwRowKind[i] != 6 {
      a.push(lwRowAst[i])
      f.push(lwRowFrom[i])
      t.push(lwRowTo[i])
      k.push(lwRowKind[i])
    }
    i = i + 1
  }
  lwRowAst = a
  lwRowFrom = f
  lwRowTo = t
  lwRowKind = k
  return 0
}

// Whether the lowering banked the row `(node, from, to)`, in any order: rows close innermost
// first in both emitters, but a nested statement's order is not the comparison.
function rowListed(n: i32, from: i32, to: i32, kind: i32): boolean {
  let i = 0
  while i < lwRowAst.length {
    if (
      lwRowAst[i] == n
      && lwRowFrom[i] == from
      && lwRowTo[i] == to
      && lwRowKind[i] == kind
    ) {
      return true
    }
    i = i + 1
  }
  return false
}

function byteText(b: u8[], i: i32): string {
  if i >= b.length { return "end" }
  return hex(b[i])
}

function hex(x: i32): string {
  const d = "0123456789abcdef"
  return "0x"
    + d.slice((x >> 4) & 15, ((x >> 4) & 15) + 1)
    + d.slice(x & 15, (x & 15) + 1)
}

// Where in the entry byte `i` falls: the size prefix, the locals vector, or a statement, by the
// innermost lowered row holding it.
function regionAt(i: i32, legacy: u8[]): string {
  let best = -1
  let r = 0
  while r < lwRowAst.length {
    if lwRowFrom[r] <= i && i < lwRowTo[r] {
      if (
        best < 0
        || lwRowTo[r] - lwRowFrom[r] < lwRowTo[best] - lwRowFrom[best]
      ) {
        best = r
      }
    }
    r = r + 1
  }
  if best >= 0 { return kindOf(lwRowAst[best]) }
  if i < 5 && legacy.length > 0 { return "prefix or locals" }
  return "outside a statement"
}

// The source kind of node `ix`, for a mismatch's class.
export function irAstKind(ix: i32): string { return kindOf(ix) }

function kindOf(ix: i32): string {
  if ix < 0 { return "none" }
  const n = nodeAt(ix)
  return match n {
    NumLit => "number"
    StrLit => "string"
    CharLit => "char"
    BoolLit => "bool"
    NullLit => "null"
    Ident => "read"
    Unary => "unary " + n.unOp
    BinExpr => "binary " + n.binOp
    Call => "call"
    Member => "member"
    OptMember => "optional member"
    Paren => "paren"
    ErrExpr => "error"
    LetDecl => "let"
    Param => "param"
    TypeRef => "type"
    FuncDecl => "function"
    IfStmt => "if"
    WhileStmt => "while"
    BreakStmt => "break"
    ContinueStmt => "continue"
    RetStmt => "return"
    Block => "block"
    Program => "program"
    FieldDef => "field"
    TypeDecl => "type decl"
    FieldInit => "field init"
    ObjLit => "object"
    ArrayLit => "array"
    Index => "index"
    UnionDecl => "union decl"
    IsExpr => "is"
    AsExpr => "as"
    ForRange => "for range"
    ForIn => "for in"
    MatchExpr => "match"
    ImportDecl => "import"
    Spread => "spread"
    LoopVar => "loop var"
  }
}

function listUnset(_r: Rhs): i32 { return irLMiss("list hook not installed") }

function listSetUnset(_n: SListSet, _at: i32): i32 {
  return irLMiss("list hook not installed")
}

function boundsUnset(_n: SBoundsCheck, _p: i32[]): i32 {
  return irLMiss("bounds hook not installed")
}

// What a loop's prologue opened: its list-header hoists (-1 on a failed prologue) and its range
// proofs, each closed by `irLoopCloseHook`.
export type LoopOpened = { loHoists: i32, loProofs: i32 }

function loopOpenNone(_at: i32): LoopOpened {
  return { loHoists: 0, loProofs: 0 }
}

function loopCloseNone(_n: LoopOpened): i32 { return 0 }

// The list lowering's hooks (`ir_lower_ref.vl`), installed before emit; the defaults leave list
// reads and bounds checks unlowered.
export let irLowerListHook: (r: Rhs) => i32 = listUnset
// The start function's prologue (`emitStrFillCalls`), set by the emitter that owns it.
export let irStartPrologueHook: () => i32 = noPrologue
function noPrologue(): i32 { return irLMiss("start prologue unset") }
// The start body's progress store after a top-level position (`emitInitProgressAt`), set likewise.
export let irInitProgressHook: (ord: i32) => i32 = noProgress
function noProgress(_ord: i32): i32 { return irLMiss("init progress unset") }
// An element store, given its assignment node.
export let irLowerListSetHook: (n: SListSet, at: i32) => i32 = listSetUnset
// A list op in statement position, whose value is not wanted.
export let irLowerEffectHook: (r: Rhs) => i32 = listUnset
export let irLowerBoundsHook: (n: SBoundsCheck, pending: i32[]) => i32 = boundsUnset
// Opens the list-header hoists and range proof of the loop statement at AST node `at`, and closes
// what it opened; the defaults open none.
export let irLoopOpenHook: (at: i32) => LoopOpened = loopOpenNone
export let irLoopCloseHook: (n: LoopOpened) => i32 = loopCloseNone
