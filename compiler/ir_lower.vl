// The IR lowering (ir-design-2026-11.md §1.6) for I1's node set, and the shadow's dual emit: a
// covered function's IR is lowered to a code entry, which is compared with the legacy one
// byte for byte, beside its statement spans. A temp goes back onto the stack at its one use,
// which holds only when the temps are consumed in their definition order; the lowering
// checks that, and any shape it cannot lower is a named mismatch, never a guess. It writes
// through the plain byte writers into its own buffer and leaves the emitter's state as found.
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  i32ToStr,
  nodeAt,
} from "./ast"
import {
  IrFn,
  OImm,
  OStr,
  OVar,
  Opnd,
  RCall,
  RCallHost,
  RCallRef,
  RCast,
  RCellGet,
  RCellNew,
  RFnId,
  RGetField,
  RGlobalGet,
  RListGet,
  RListLen,
  RListNew,
  RListPush,
  RMakeClo,
  RMakeList,
  RMakeRec,
  RMapOp,
  RNumWiden,
  RPrimOp,
  RStrOp,
  RTagOf,
  RTest,
  RToBox,
  Rhs,
  SAssign,
  SBlock,
  SBoundsCheck,
  SBr,
  SCellSet,
  SDrop,
  SEffect,
  SGlobalSet,
  SIf,
  SLet,
  SListSet,
  SLoop,
  SReturn,
  SSetField,
  SSwitch,
  STrap,
  irFnNew,
  irSigOf,
  primOpcode,
  repIsNoValue,
  repPrim,
} from "./ir"
import {
  fbBlock,
  fbBr,
  fbBrIf,
  fbCall,
  fbDrop,
  fbElse,
  fbEmitLocalsVec,
  fbEnd,
  fbF32ConstBits,
  fbF32DemoteF64,
  fbF64ConstBits,
  fbF64PromoteF32,
  fbGlobalGet,
  fbGlobalSet,
  fbI32Bin,
  fbI32Const,
  fbI32Eqz,
  fbI64Const,
  fbIf,
  fbLocalGet,
  fbLocalIsUnsetRef,
  fbLocalRun,
  fbLocalSet,
  fbLoop,
  fbRefAsNonNull,
  fbResetLazyFrame,
  fbReturn,
  fbReturnCall,
  fbStructNew,
  fbUnreachable,
  wTarget,
  wULEB,
} from "./emit_bytes"
import {
  GlobalCtx,
  emitBoxAroundHole,
  emitFoldedConstRead,
  emitStrLitAt,
  initBitOf,
  numWidenTail,
  uBoxNewIsLast,
  uBoxSinkToPair,
  userGlobalIdx,
  userGlobalReadClass,
  userGlobalWriteClass,
  voidTailCallee,
} from "./wasmEmit"
import {
  bankSpanRow,
  ctrlDepth,
  dfeCallee,
  emitFnSpanEnd,
  emitFnSpanKind,
  emitFnSpanNode,
  emitFnSpanStart,
  fbEagerScratch,
  fbFrameParams,
  fnStmts,
  fnUses,
  gCellIdx,
  gHelpF64Rem,
  gImports,
  listIdxScratchBase,
  localIsRef,
  localStructIdx,
  uBoxIdx,
  uBoxNewEnd,
  unionSinkBase,
} from "./emit_state"

// The function being lowered.
export function irLFn(): IrFn { return lw }

// The function being lowered, the definitions of its temps, and the state of one walk.
let lw = irFnNew(-1, "")
// Where the function being lowered sits, for the global storage classes.
let lwGlobalCtx: GlobalCtx = {
  gcInStart: false,
  gcFnPos: -1,
  gcGuardOff: false,
}
let lwMiss = ""
let lwTempRhs: Rhs[] = []
let lwTempDef: boolean[] = []
let lwTempUsed: boolean[] = []
// Locals a valued `if` left on the stack, read once as a temp is.
let lwStackVal: boolean[] = []
// How many of those values are on the stack, not yet read.
let lwStackLive = 0
// The temps the operands being written consumed, in the order their values reach the stack.
let lwSeq: i32[] = []
// The open control frames, innermost last: a block or loop label, or -1 for an `if`.
let lwFrames: i32[] = []
// Statement spans: rows opened at a node and closed after another, by the node ids.
let lwSpanOpen: i32[] = []
let lwSpanAt: i32[] = []
let lwRowAst: i32[] = []
let lwRowFrom: i32[] = []
let lwRowTo: i32[] = []

export function irLMiss(why: string) {
  if lwMiss == "" { lwMiss = why }
  return 0
}

function varSlot(v: i32): i32 {
  if v < 0 || v >= lw.irVars.length { return -1 }
  return lw.irVars[v].vSlot
}

function tempDefined(v: i32): boolean {
  return v >= 0 && v < lwTempDef.length && lwTempDef[v]
}

function tempRhs(v: i32): Rhs {
  if v >= 0 && v < lwTempRhs.length { return lwTempRhs[v] }
  const none: Rhs = { ggSym: -1, ggNonNull: false }
  return none
}

// Marks `v`'s one use; false when its use is already taken.
function takeUse(v: i32): boolean {
  if v < 0 || v >= lwTempUsed.length || lwTempUsed[v] { return false }
  lwTempUsed[v] = true
  return true
}

function isTemp(v: i32): boolean {
  return v >= 0 && v < lw.irVars.length && lw.irVars[v].vKind == "temp"
}

// Consumes operand `o` without writing it, as legacy skips a receiver a live hoist already holds:
// a temp's one use is taken in its order and its right-hand side never written; a variable
// reads nothing.
export function irLSkip(o: Opnd) {
  if o is OVar && isTemp(o.ov) {
    if !tempDefined(o.ov) { return irLMiss("temp used before its definition") }
    if !takeUse(o.ov) { return irLMiss("non-stack temp: used twice") }
    lwSeq.push(o.ov)
  }
  return 0
}

// Writes operand `o`: a variable's `local.get`, an immediate's constant, or a temp's own
// right-hand side, written here at its one use.
export function irLOpnd(o: Opnd) {
  match o {
    OVar => {
      const v = o.ov
      if v >= 0 && v < lwStackVal.length && lwStackVal[v] {
        if !takeUse(v) { return irLMiss("non-stack temp: used twice") }
        lwSeq.push(v)
        lwStackLive = lwStackLive - 1
        return 0
      }
      if isTemp(v) {
        if !tempDefined(v) { return irLMiss("temp used before its definition") }
        if !takeUse(v) { return irLMiss("non-stack temp: used twice") }
        rhs(tempRhs(v), false)
        lwSeq.push(v)
        return 0
      }
      const s = varSlot(v)
      if s < 0 { return irLMiss("unmapped slot") }
      leaf()
      fbLocalGet(s)
    }
    OImm => {
      leaf()
      imm(o)
    }
    OStr => {
      leaf()
      emitStrLitAt(o.osAt, lw.irAt)
    }
  }
}

// Before a value that reads no operand: one written while a valued `if`'s value waits on the
// stack lands above it, out of order.
function leaf() {
  if lwStackLive > 0 { irLMiss("operand above a valued if's value") }
}

function imm(o: OImm) {
  const p = repPrim(o.oiRep)
  if p == null { return irLMiss("immediate rep") }
  match p {
    "i32" | "bool" => fbI32Const(o.oiBits as% i32)
    "i64" => fbI64Const((o.oiBits >> 32) as% i32, o.oiBits as% i32)
    "f32" => fbF32ConstBits(o.oiBits)
    "f64" => fbF64ConstBits(o.oiBits)
    "str" | "u8" | "null" | "v128" => irLMiss("immediate at " + p)
  }
}

function primOp(r: RPrimOp) {
  const a = r.poArgs
  if a.length == 0 { return irLMiss("operandless op") }
  const p = repPrim(opRepOf(a[0]))
  if p == null { return irLMiss("op over a non-primitive") }
  const ps: string = p
  // A negated float literal is the literal with its sign bit flipped, as legacy writes it.
  if r.poOp == "neg" && (ps == "f64" || ps == "f32") {
    const x = a[0]
    if x is OImm {
      const one: i64 = 1
      const sign = if ps == "f64" { one << 63 } else { one << 31 }
      const flipped: Opnd = { oiRep: x.oiRep, oiBits: x.oiBits ^ sign }
      return irLOpnd(flipped)
    }
  }
  // A negated integer literal is the literal's own negative constant.
  if r.poOp == "neg" && (ps == "i32" || ps == "i64") {
    const x = a[0]
    if x is OImm {
      const neg: Opnd = { oiRep: x.oiRep, oiBits: 0 - x.oiBits }
      return irLOpnd(neg)
    }
    // Legacy's `0 - x`.
    if ps == "i32" {
      fbI32Const(0)
      irLOpnd(x)
      fbI32Bin(107) // i32.sub
    } else {
      fbI64Const(0, 0)
      irLOpnd(x)
      fbI32Bin(125) // i64.sub
    }
    return 0
  }
  // Float `%` has no instruction: legacy's call into `__f64_rem__`, f32 widened and narrowed.
  if r.poOp == "rem" && (ps == "f32" || ps == "f64") {
    return floatRem(a, ps == "f32")
  }
  for x in a { irLOpnd(x) }
  const code = primOpcode(r.poOp, p)
  if code < 0 { return irLMiss(r.poOp + " over " + ps) }
  fbI32Bin(code)
}

function floatRem(a: Opnd[], atF32: boolean) {
  if gHelpF64Rem < 0 || a.length != 2 { return irLMiss("float rem helper") }
  for x in a {
    irLOpnd(x)
    if atF32 { fbF64PromoteF32() }
  }
  fbCall(gHelpF64Rem)
  if atF32 { fbF32DemoteF64() }
  return 0
}

// Whether global `g` has the cell a pre-pass assigns before any body is emitted.
function globalMinted(g: i32): boolean {
  return g >= 0 && g < gCellIdx.length && gCellIdx[g] >= 0
}

function opRepOf(o: Opnd): i32 {
  return match o {
    OVar => if o.ov >= 0 && o.ov < lw.irVars.length { lw.irVars[o.ov].vRep } else { -1 }
    OImm => o.oiRep
    OStr => o.osRep
  }
}

// A call, in its tail form when `tail` and the callee returns; a never-returning callee's call is
// followed by `unreachable` instead.
function call(c: RCall, tail: boolean) {
  // A claimed function's legacy never runs, so every index it names must already exist.
  if c.caCallee < 0 || c.caCallee >= fnStmts.length {
    return irLMiss("callee index")
  }
  if c.caArgs.length == 0 { leaf() }
  for a in c.caArgs { irLOpnd(a) }
  if tail && !c.caNever {
    fbReturnCall(gImports + c.caCallee)
  } else {
    fbCall(gImports + c.caCallee)
    if c.caNever { fbUnreachable() }
  }
}

function rhs(r: Rhs, tail: boolean) {
  match r {
    RPrimOp => primOp(r)
    RCall => call(r, tail)
    RGlobalGet => {
      match userGlobalReadClass(r.ggSym, lwGlobalCtx) {
        "plain" => {
          if !globalMinted(r.ggSym) { return irLMiss("global index") }
          leaf()
          fbGlobalGet(userGlobalIdx(r.ggSym))
          if r.ggNonNull { fbRefAsNonNull() }
        }
        "fold" => {
          leaf()
          emitFoldedConstRead(r.ggSym)
        }
        "promo" => irLMiss("promoted global read")
        "guard" => irLMiss("guarded global read")
      }
    }
    RListGet | RListLen | RListPush | RStrOp => irLowerListHook(r)
    RNumWiden => {
      irLOpnd(r.nwV)
      numWidenTail(r.nwSrc, r.nwDst, r.nwAt, lw.irAt)
    }
    RToBox => boxOp(r)
    RCallRef | RCallHost | RTest | RCast | RTagOf | RMakeRec | RGetField | RMakeList | RListNew | RMapOp | RMakeClo | RFnId | RCellNew | RCellGet => irLMiss("rhs outside I1")
  }
}

// The `RToBox` whose operand legacy's box writer asks for through the value hole, while one is
// open. Held as an `Rhs`: an `Opnd` global costs the self-compile's mono pass.
let lwHoleBox: Rhs[] = []

// The value hole's writer (`irHoleWrite`): the open box's operand.
export function irLowerHoleWrite(): i32 {
  if lwHoleBox.length != 1 {
    return irLMiss("value hole read with no box open")
  }
  const r = lwHoleBox[0]
  if r is RToBox { irLOpnd(r.bxV) } else { irLMiss("value hole holds no box") }
  return 0
}

// `RToBox`: legacy's own box writer, its value the operand, written where the writer asks for it.
// A writer that asks other than once leaves the function unlowered.
function boxOp(r: RToBox) {
  lwHoleBox = [r]
  const uses = emitBoxAroundHole(r.bxAt, lw.irAt)
  lwHoleBox = []
  if uses != 1 { irLMiss("box value written " + i32ToStr(uses) + " times") }
  return 0
}

// The depth a branch to `label` crosses from the innermost frame, or -1.
function brDepth(label: i32): i32 {
  let i = lwFrames.length - 1
  while i >= 0 {
    if lwFrames[i] == label { return lwFrames.length - 1 - i }
    i = i - 1
  }
  return -1
}

// Whether `o` is the immediate `true`.
function isTrue(o: Opnd): boolean {
  return match o {
    OImm => repPrim(o.oiRep) == "bool" && o.oiBits == 1
    OVar | OStr => false
  }
}

// Writes `o` as a condition, then checks that it consumed exactly the temps `pending` defined.
function cond(o: Opnd, pending: i32[]) {
  lwSeq = []
  irLOpnd(o)
  irLSettle(pending)
}

// The stack-order precondition: the temps a node's operands consumed are the ones its body
// defined since the previous node, in definition order.
export function irLSettle(pending: i32[]) {
  if lwSeq.length != pending.length {
    irLMiss("non-stack temp: out of order")
  } else {
    let i = 0
    while i < pending.length {
      if lwSeq[i] != pending[i] { irLMiss("non-stack temp: out of order") }
      i = i + 1
    }
  }
  while pending.length > 0 { pending.pop() }
  lwSeq = []
  return 0
}

// The callee of a temp defined by a direct call, or -1.
function callTemp(o: Opnd): i32 {
  return match o {
    OVar => {
      if !isTemp(o.ov) || !tempDefined(o.ov) { return -1 }
      const r = tempRhs(o.ov)
      if r is RCall { r.caCallee } else { -1 }
    }
    OImm | OStr => -1
  }
}

// Writes body `b`; `tail` when its last node ends a void function, and `out` the slotless
// variable its valued `if`'s arm ends by writing (-1 for none).
function body(b: i32[], tail: boolean, out: i32) {
  const pending: i32[] = []
  let i = 0
  while i < b.length {
    if lwMiss != "" { return 0 }
    const id = b[i]
    spanOpen(id)
    // A valueless `return` after a call in its tail form writes nothing.
    if !(i > 0 && callReturns(b, i - 1)) {
      node(
        id,
        pending,
        tail && i == b.length - 1 || callReturns(b, i),
        if i == b.length - 1 { out } else { -1 },
      )
    }
    spanClose(id)
    i = i + 1
  }
  if pending.length > 0 { irLMiss("non-stack temp: unconsumed") }
  return 0
}

// Whether node `i` of `b` is a void call a valueless `return` follows, so the call returns.
function callReturns(b: i32[], i: i32): boolean {
  if i + 1 >= b.length { return false }
  const n = lw.irNodes[b[i]]
  const nx = lw.irNodes[b[i + 1]]
  if !(n is SEffect && nx is SReturn) || nx.rtHas { return false }
  const r = n.efRhs
  return r is RCall && !r.caNever && voidTailCallee(r.caCallee)
}

function node(id: i32, pending: i32[], tail: boolean, armOut: i32) {
  if id < 0 || id >= lw.irNodes.length { return irLMiss("no node") }
  const n = lw.irNodes[id]
  match n {
    SLet => {
      if !isTemp(n.lDst) { return irLMiss("let of a non-temp") }
      if n.lDst >= lwTempRhs.length { return irLMiss("let of a non-temp") }
      lwTempRhs[n.lDst] = n.lRhs
      lwTempDef[n.lDst] = true
      pending.push(n.lDst)
    }
    SAssign => {
      cond(n.asSrc, pending)
      // An arm's write of its valued `if`'s out leaves the value as the arm's result.
      if armOut >= 0 && n.asDst == armOut { return 0 }
      const s = varSlot(n.asDst)
      if s < 0 { return irLMiss("unmapped slot") }
      fbLocalSet(s)
    }
    SGlobalSet => {
      match userGlobalWriteClass(n.gsSym, lwGlobalCtx) {
        "plain" => {
          if !globalMinted(n.gsSym) { return irLMiss("global index") }
          cond(n.gsSrc, pending)
          fbGlobalSet(userGlobalIdx(n.gsSym))
          const bit = initBitOf(n.gsSym)
          if bit >= 0 {
            fbI32Const(1)
            fbGlobalSet(bit)
          }
        }
        "promo" => irLMiss("promoted global write")
        "immutable" => irLMiss("immutable global write")
        "guard" => irLMiss("guarded global write")
      }
    }
    SEffect => {
      lwSeq = []
      const r = n.efRhs
      if r is RCall {
        const t = tail && voidTailCallee(r.caCallee)
        call(r, t)
        irLSettle(pending)
        const si = irSigOf(lw, r.caCallee)
        if !t && si >= 0 && !repIsNoValue(lw.irSigRet[si]) { fbDrop() }
        return 0
      }
      if r is RListPush {
        irLowerEffectHook(r)
        irLSettle(pending)
        return 0
      }
      irLMiss("effect outside I1")
    }
    SBlock => {
      irLSettle(pending)
      if n.bkOut >= 0 { return irLMiss("valued block") }
      // A loop's list-header hoists open before its block, as legacy's do.
      const hoists = irLoopOpenHook(lw.irNodeAt[id])
      if hoists < 0 { return irLMiss("loop hoist prologue") }
      fbBlock(64)
      lwFrames.push(n.bkLabel)
      body(n.bkBody, false, -1)
      lwFrames.pop()
      fbEnd()
      irLoopCloseHook(hoists)
    }
    SLoop => {
      irLSettle(pending)
      fbLoop(64)
      lwFrames.push(n.lpLabel)
      body(n.lpBody, false, -1)
      lwFrames.pop()
      fbEnd()
    }
    SIf => ifNode(n, pending, tail)
    SBr => {
      irLSettle(pending)
      if n.brHas { return irLMiss("valued branch") }
      const d = brDepth(n.brLabel)
      if d < 0 { return irLMiss("branch out of its frames") }
      fbBr(d)
    }
    SReturn => ret(n, pending)
    STrap => {
      irLSettle(pending)
      fbUnreachable()
    }
    SDrop => {
      cond(n.dpV, pending)
      fbDrop()
    }
    SBoundsCheck => irLowerBoundsHook(n, pending)
    SListSet => {
      irLowerListSetHook(n, lw.irNodeAt[id])
      irLSettle(pending)
    }
    SSetField | SCellSet | SSwitch => irLMiss("statement outside I1")
  }
}

// An `if`. The loop exit `if c {} else { br L }` is legacy's `eqz; br_if`, and a literal-true
// test writes no test at all, either for that exit or for an else-less `if`, whose arm runs inline.
function ifNode(n: SIf, pending: i32[], tail: boolean) {
  if n.siOut >= 0 { return valuedIf(n, pending) }
  const exitBr = n.siThen.length == 0
    && n.siElse.length == 1
    && isBr(n.siElse[0])
  if isTrue(n.siCond) && (exitBr || n.siElse.length == 0) {
    irLSettle(pending)
    if !exitBr { body(n.siThen, tail, -1) }
    return 0
  }
  cond(n.siCond, pending)
  if exitBr {
    const b = lw.irNodes[n.siElse[0]]
    if b is SBr {
      const d = brDepth(b.brLabel)
      if d < 0 { return irLMiss("branch out of its frames") }
      fbI32Eqz()
      fbBrIf(d)
    }
    return 0
  }
  fbIf(64)
  lwFrames.push(-1)
  body(n.siThen, tail, -1)
  if n.siElse.length > 0 {
    fbElse()
    body(n.siElse, tail, -1)
  }
  lwFrames.pop()
  fbEnd()
}

// An `if` whose arms each end by writing its slotless out: a value-typed `if` (legacy's `&&` and
// `||`), whose result stays on the stack for the out's one later read.
function valuedIf(n: SIf, pending: i32[]) {
  const t = n.siOut
  if varSlot(t) >= 0 { return irLMiss("valued if into a slot") }
  if t < 0 || t >= lw.irVars.length || t >= lwStackVal.length {
    return irLMiss("valued if out")
  }
  const vt = valtypeOf(lw.irVars[t].vRep)
  if vt < 0 { return irLMiss("valued if rep") }
  cond(n.siCond, pending)
  fbIf(vt)
  lwFrames.push(-1)
  body(n.siThen, false, t)
  fbElse()
  body(n.siElse, false, t)
  lwFrames.pop()
  fbEnd()
  lwStackVal[t] = true
  lwStackLive = lwStackLive + 1
  pending.push(t)
  return 0
}

function isBr(id: i32): boolean {
  if id < 0 || id >= lw.irNodes.length { return false }
  return lw.irNodes[id] is SBr
}

// A return: its value, then `return`, or a call's tail form when the value is a direct call.
function ret(n: SReturn, pending: i32[]) {
  if !n.rtHas {
    irLSettle(pending)
    return fbReturn()
  }
  const callee = callTemp(n.rtV)
  if callee >= 0 {
    const t = n.rtV
    if t is OVar {
      takeUse(t.ov)
      const r = tempRhs(t.ov)
      lwSeq = []
      if r is RCall { call(r, true) }
      lwSeq.push(t.ov)
      irLSettle(pending)
    }
    return 0
  }
  cond(n.rtV, pending)
  // A function taking legacy's union return sink pops a box built here into the sink pair and
  // branches to the exit block wrapped round the body, as `emitUnionRetSink` does.
  if fnUses.unionSink && uBoxNewIsLast() {
    uBoxSinkToPair()
    fbBr(lwFrames.length)
    lwSinkFired = lwSinkFired + 1
    return 0
  }
  fbReturn()
}

function spanOpen(id: i32) {
  let k = 0
  while k < lw.irSpanFirst.length {
    if lw.irSpanFirst[k] == id {
      lwSpanOpen.push(k)
      lwSpanAt.push(curLen())
    }
    k = k + 1
  }
  return 0
}

// Closes, innermost first, every open span whose last node is `id`, banking a row for each that
// wrote bytes.
function spanClose(id: i32) {
  let i = lwSpanOpen.length - 1
  while i >= 0 {
    const k = lwSpanOpen[i]
    if k >= 0 && lw.irSpanLast[k] == id {
      const from = lwSpanAt[i]
      const to = curLen()
      if to > from {
        lwRowAst.push(lw.irSpanAst[k])
        lwRowFrom.push(from)
        lwRowTo.push(to)
      }
      lwSpanOpen[i] = -1
    }
    i = i - 1
  }
  // Drop the closed rows, keeping the open ones in order.
  const o2: i32[] = []
  const a2: i32[] = []
  let j = 0
  while j < lwSpanOpen.length {
    if lwSpanOpen[j] >= 0 {
      o2.push(lwSpanOpen[j])
      a2.push(lwSpanAt[j])
    }
    j = j + 1
  }
  lwSpanOpen = o2
  lwSpanAt = a2
  return 0
}

let lwBuf: u8[] = []
let lwGot: u8[] = []

// The code entry the last dual emit lowered, for a mismatch's detail.
export function irLoweredEntry(): u8[] { return lwGot }

// `b` as hex bytes, space-separated.
export function irHexOf(b: u8[]): string {
  let s = ""
  for x in b { s = s + hex(x) + " " }
  return s
}

function curLen(): i32 { return lwBuf.length }

// The valtype byte of a scalar rep, or -1.
function valtypeOf(r: i32): i32 {
  const p = repPrim(r)
  if p == null { return -1 }
  return match p {
    "i32" | "bool" => 0x7f
    "i64" => 0x7e
    "f32" => 0x7d
    "f64" => 0x7c
    "str" | "u8" | "null" | "v128" => -1
  }
}

// The locals vector legacy's frame layout writes, read once the body has grown the lazy list
// frame. A variable holding a declared slot must carry the valtype legacy declared there.
function framedLocals(): u8[] {
  const nLocals = listIdxScratchBase - fbFrameParams - fbEagerScratch
  for v in lw.irVars {
    if v.vKind == "local" && v.vSlot >= fbFrameParams {
      const li = v.vSlot - fbFrameParams
      if li >= nLocals || !runAgrees(v.vRep, li) { irLMiss("locals layout") }
    }
  }
  const out: u8[] = []
  fbEmitLocalsVec(out, nLocals)
  return out
}

// Whether declared local `li`'s run is scalar rep `rep`'s valtype; a reference rep takes the run
// legacy declares for it.
function runAgrees(rep: i32, li: i32): boolean {
  const t = valtypeOf(rep)
  if t < 0 { return true }
  if li >= localIsRef.length || fbLocalIsUnsetRef(li) { return false }
  const b: u8[] = []
  const prev = wTarget(b)
  fbLocalRun(localIsRef[li], localStructIdx[li])
  wTarget(prev)
  return b.length == 2 && b[1] == t
}

// The size-prefixed code entry `f` (its globals accessed in `ctx`) lowers to, or a mismatch class
// in `lwMiss`. The frame is legacy's, opened by `fbBeginFunc`.
function entry(f: IrFn, ctx: GlobalCtx): u8[] {
  lw = f
  lwGlobalCtx = ctx
  lwMiss = ""
  lwTempRhs = []
  lwTempDef = []
  lwTempUsed = []
  lwStackVal = []
  lwStackLive = 0
  const none: Rhs = { ggSym: -1, ggNonNull: false }
  for _v in f.irVars {
    lwTempRhs.push(none)
    lwTempDef.push(false)
    lwTempUsed.push(false)
    lwStackVal.push(false)
  }
  lwSeq = []
  lwFrames = []
  lwSpanOpen = []
  lwSpanAt = []
  lwRowAst = []
  lwRowFrom = []
  lwRowTo = []
  lwBuf = []
  lwSinkFired = 0
  uBoxNewEnd = -1
  // The builders keep the emitter's control depth; it goes back as found.
  const prev = wTarget(lwBuf)
  const valued = !repIsNoValue(f.irRetRep)
  body(f.irBody, !valued, -1)
  if valued && !endsInReturn(f) { fbUnreachable() }
  if lwSinkFired > 0 { sinkClose() }
  fbEnd()
  wTarget(prev)
  // Every frame a builder opened is closed, so the one depth not given back is the function's
  // own `end`'s, which opened none.
  ctrlDepth = ctrlDepth + 1
  const locals = framedLocals()
  const code: u8[] = []
  for x in locals { code.push(x) }
  const bodyAt = code.length
  for x in lwBuf { code.push(x) }
  const out: u8[] = []
  const p2 = wTarget(out)
  wULEB(code.length)
  wTarget(p2)
  const shift = out.length + bodyAt
  for x in code { out.push(x) }
  let r = 0
  while r < lwRowFrom.length {
    lwRowFrom[r] = lwRowFrom[r] + shift
    lwRowTo[r] = lwRowTo[r] + shift
    r = r + 1
  }
  return out
}

// Lowers claimed function `f` (at `fnStmts` slot `fnPos`) onto `out` in legacy's place: its code
// entry, its statement rows, and its callees kept for dead-function elimination. "" when written,
// else the miss, with nothing written.
export function irLowerClaim(
  f: IrFn,
  ctx: GlobalCtx,
  fnPos: i32,
  out: u8[],
): string {
  const callees0 = dfeCallee.length
  const got = entry(f, ctx)
  if lwMiss != "" {
    while dfeCallee.length > callees0 { dfeCallee.pop() }
    // Legacy lowers the function in its place, from the empty lazy frame `fbBeginFunc` left.
    fbResetLazyFrame()
    return lwMiss
  }
  const at = out.length
  for x in got { out.push(x) }
  let r = 0
  while r < lwRowAst.length {
    bankSpanRow(lwRowAst[r], fnPos, lwRowFrom[r] + at, lwRowTo[r] + at, 5, "")
    r = r + 1
  }
  return ""
}

// The returns that sank into the union return sink in the function being lowered.
let lwSinkFired = 0

// Wraps the body in the sink's exit block and builds the function's one box from the pair, as
// legacy's `emitFuncCode` closes a sinking body.
function sinkClose() {
  const opened: u8[] = [0x02, 0x40]
  for x in lwBuf { opened.push(x) }
  lwBuf = opened
  wTarget(lwBuf)
  let r = 0
  while r < lwRowFrom.length {
    lwRowFrom[r] = lwRowFrom[r] + 2
    lwRowTo[r] = lwRowTo[r] + 2
    r = r + 1
  }
  fbEnd()
  fbLocalGet(unionSinkBase)
  fbLocalGet(unionSinkBase + 1)
  fbStructNew(uBoxIdx)
  return 0
}

function endsInReturn(f: IrFn): boolean {
  if f.irBody.length == 0 { return false }
  const last = f.irBody[f.irBody.length - 1]
  return last >= 0 && last < f.irNodes.length && f.irNodes[last] is SReturn
}

// The dual emit: lowers `f` and compares it with the legacy code entry `legacy` (this function's
// whole entry) and the statement-span rows banked from `spanBase` on, at offsets in `legacy`
// once `spanShift` is taken off. "" when they are identical, else the first difference's class;
// `skew` breaks the lowering on purpose (`irShadowCorrupt`).
export function irDualEmit(
  f: IrFn,
  ctx: GlobalCtx,
  legacy: u8[],
  spanBase: i32,
  spanShift: i32,
  skew: i32,
): string {
  // The lowering's calls note their callees as legacy's did; the shadow takes its own back. It
  // grows a lazy list frame of its own from empty: legacy's is spent, its locals vector written,
  // and the next function's `fbBeginFunc` resets it.
  const callees0 = dfeCallee.length
  fbResetLazyFrame()
  const got = entry(f, ctx)
  while dfeCallee.length > callees0 { dfeCallee.pop() }
  lwGot = got
  if lwMiss != "" { return "unlowered: " + lwMiss }
  // The comparison's own controls: 1 adds a byte to the lowering, 2 drops its first span row.
  if skew == 1 { got.push(0x01) }
  if skew == 2 && lwRowAst.length > 0 { lwRowAst[0] = -2 }
  let i = 0
  while i < got.length && i < legacy.length && got[i] == legacy[i] { i = i + 1 }
  if i < got.length || i < legacy.length {
    return "bytes: "
      + regionAt(i, legacy)
      + " at "
      + byteText(legacy, i)
      + " vs "
      + byteText(got, i)
  }
  // The statement rows (kind 5) legacy banked for this function, against the lowering's.
  const ln: i32[] = []
  const lf: i32[] = []
  const lt: i32[] = []
  let k = spanBase
  while k < emitFnSpanStart.length {
    if emitFnSpanKind[k] == 5 {
      ln.push(emitFnSpanNode[k])
      lf.push(emitFnSpanStart[k] - spanShift)
      lt.push(emitFnSpanEnd[k] - spanShift)
    }
    k = k + 1
  }
  if ln.length != lwRowAst.length { return "spans: count" }
  let j = 0
  while j < ln.length {
    if !rowListed(ln[j], lf[j], lt[j]) { return "spans: " + kindOf(ln[j]) }
    j = j + 1
  }
  return ""
}

// Whether the lowering banked the row `(node, from, to)`, in any order: rows close innermost
// first in both emitters, but a nested statement's order is not the comparison.
function rowListed(n: i32, from: i32, to: i32): boolean {
  let i = 0
  while i < lwRowAst.length {
    if lwRowAst[i] == n && lwRowFrom[i] == from && lwRowTo[i] == to {
      return true
    }
    i = i + 1
  }
  return false
}

function byteText(b: u8[], i: i32): string {
  if i >= b.length { return "end" }
  return hex(b[i])
}

function hex(x: i32): string {
  const d = "0123456789abcdef"
  return "0x"
    + d.slice((x >> 4) & 15, ((x >> 4) & 15) + 1)
    + d.slice(x & 15, (x & 15) + 1)
}

// Where in the entry byte `i` falls: the size prefix, the locals vector, or a statement, by the
// innermost lowered row holding it.
function regionAt(i: i32, legacy: u8[]): string {
  let best = -1
  let r = 0
  while r < lwRowAst.length {
    if lwRowFrom[r] <= i && i < lwRowTo[r] {
      if (
        best < 0
        || lwRowTo[r] - lwRowFrom[r] < lwRowTo[best] - lwRowFrom[best]
      ) {
        best = r
      }
    }
    r = r + 1
  }
  if best >= 0 { return kindOf(lwRowAst[best]) }
  if i < 5 && legacy.length > 0 { return "prefix or locals" }
  return "outside a statement"
}

// The source kind of node `ix`, for a mismatch's class.
export function irAstKind(ix: i32): string { return kindOf(ix) }

function kindOf(ix: i32): string {
  if ix < 0 { return "none" }
  const n = nodeAt(ix)
  return match n {
    NumLit => "number"
    StrLit => "string"
    CharLit => "char"
    BoolLit => "bool"
    NullLit => "null"
    Ident => "read"
    Unary => "unary " + n.unOp
    BinExpr => "binary " + n.binOp
    Call => "call"
    Member => "member"
    OptMember => "optional member"
    Paren => "paren"
    ErrExpr => "error"
    LetDecl => "let"
    Param => "param"
    TypeRef => "type"
    FuncDecl => "function"
    IfStmt => "if"
    WhileStmt => "while"
    BreakStmt => "break"
    ContinueStmt => "continue"
    RetStmt => "return"
    Block => "block"
    Program => "program"
    FieldDef => "field"
    TypeDecl => "type decl"
    FieldInit => "field init"
    ObjLit => "object"
    ArrayLit => "array"
    Index => "index"
    UnionDecl => "union decl"
    IsExpr => "is"
    AsExpr => "as"
    ForRange => "for range"
    ForIn => "for in"
    MatchExpr => "match"
    ImportDecl => "import"
    Spread => "spread"
    LoopVar => "loop var"
  }
}

function listUnset(_r: Rhs): i32 { return irLMiss("list hook not installed") }

function listSetUnset(_n: SListSet, _at: i32): i32 {
  return irLMiss("list hook not installed")
}

function boundsUnset(_n: SBoundsCheck, _p: i32[]): i32 {
  return irLMiss("bounds hook not installed")
}

function loopOpenNone(_at: i32): i32 { return 0 }

function loopCloseNone(_n: i32): i32 { return 0 }

// The list lowering's hooks (`ir_lower_ref.vl`), installed before emit; the defaults leave list
// reads and bounds checks unlowered.
export let irLowerListHook: (r: Rhs) => i32 = listUnset
// An element store, given its assignment node.
export let irLowerListSetHook: (n: SListSet, at: i32) => i32 = listSetUnset
// A list op in statement position, whose value is not wanted.
export let irLowerEffectHook: (r: Rhs) => i32 = listUnset
export let irLowerBoundsHook: (n: SBoundsCheck, pending: i32[]) => i32 = boundsUnset
// Opens the list-header hoists of the loop statement at AST node `at` (how many, or -1 on a failed
// prologue), and closes that many; the defaults open none.
export let irLoopOpenHook: (at: i32) => i32 = loopOpenNone
export let irLoopCloseHook: (n: i32) => i32 = loopCloseNone
