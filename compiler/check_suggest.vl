// The spelling half of the checker's `did you mean` clauses: the built-in type names, the
// other-language spelling tables for types and methods, the edit distance and its budget, the
// `Array<T>`/`Record<K, V>` respelling, and the merge-suffix strip a suggestion is offered
// under. Every answer is a function of strings; the checker picks the candidates (declared
// types, in-scope self-functions) and words the clause, so this module imports nothing.

// Strip a module-merge mangling suffix (`add$m1` → `add`) so an imported name shows under its
// source name in completion. The merge appends `$m<N>`, N being the module table index, to every
// cross-module name, and `$` is not a legal identifier char, so the first `$` marks the suffix. A
// name without a `$` is returned unchanged.
export function demangleName(nm: string) {
  let i = 0
  while i < nm.length {
    if nm[i] == '$' { return nm.slice(0, i) }
    i = i + 1
  }
  nm
}

// The set of type names an annotation resolves with no declaration in sight: `primTyOfName`'s
// spellings plus `u8`, the storage type it deliberately withholds. One home, because a second copy
// is a second answer. A list and not a predicate, because the `did you mean` suggester has to
// enumerate the names in scope rather than test one; a spelling missing here stops being reserved.
export const builtinTyNames = [
  "i32", "i64", "f64", "f32", "boolean", "string", "void", "null", "never",
  "u8", "v128",
]

// Read by the merge's type-position rename and by `tErrBuiltinTyDecl`'s two callers.
export function isBuiltinTyName(name: string) {
  let i = 0
  while i < builtinTyNames.length {
    if builtinTyNames[i] == name { return true }
    i = i + 1
  }
  false
}

// Other-language spellings of VL's primitives (`Boolean`, `String`, `Number`, …) — a
// suggestion table, not aliases: none of these becomes a type. Matched ASCII
// case-folded. Positional pair: `tySpellTo[i]` answers `tySpellFrom[i]`.
export const tySpellFrom = [
  "bool", "boolean", "int", "integer", "int32", "i32_t", "long", "int64",
  "float", "double", "number", "str", "string", "byte",
]
export const tySpellTo = [
  "boolean", "boolean", "i32", "i32", "i32", "i32", "i64", "i64", "f64", "f64",
  "f64", "string", "string", "u8",
]

// `a` equals `b` with ASCII case folded; `b` is assumed already lower-case, which is
// what lets one table answer `bool`, `Bool` and `BOOL`.
export function tyFoldedEq(a: string, b: string) {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    let c = a[i]
    if c >= 'A' && c <= 'Z' { c = c + 32 }
    if c != b[i] { return false }
    i = i + 1
  }
  true
}

// Levenshtein with adjacent transposition (optimal string alignment): plain Levenshtein
// charges `i23`→`i32` two edits, over the budget a three-character name has. Runs once
// per unresolved name on the diagnostic path, so the cost is never felt during a compile.
export function tyEditDist(a: string, b: string) {
  const n = a.length
  const m = b.length
  if n == 0 { return m }
  if m == 0 { return n }
  const w = m + 1
  const d: i32[] = []
  let k = 0
  while k < (n + 1) * w {
    d.push(0)
    k = k + 1
  }
  let j0 = 0
  while j0 <= m {
    d[j0] = j0
    j0 = j0 + 1
  }
  let i = 1
  while i <= n {
    d[i * w] = i
    let j = 1
    while j <= m {
      let cost = 1
      if a[i - 1] == b[j - 1] { cost = 0 }
      let best = d[(i - 1) * w + j] + 1
      const ins = d[i * w + j - 1] + 1
      if ins < best { best = ins }
      const sub = d[(i - 1) * w + j - 1] + cost
      if sub < best { best = sub }
      if i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] {
        const tr = d[(i - 2) * w + j - 2] + 1
        if tr < best { best = tr }
      }
      d[i * w + j] = best
      j = j + 1
    }
    i = i + 1
  }
  d[n * w + m]
}

// How far a suggestion may sit from the typed spelling: one edit up to four characters, two
// up to eight, three beyond. Scales because a fixed budget is wrong at both ends — at 1 it
// mutes `Cricle` → `Circle`, at 3 a three-letter name would reach half the built-ins.
export function tySuggestBudget(len: i32) {
  if len <= 4 { return 1 }
  if len <= 8 { return 2 }
  3
}

// Whether `a` and `b` begin with the same letter, ignoring case.
export function tySameInitial(a: string, b: string): boolean {
  if a.length == 0 || b.length == 0 { return false }
  let x = a[0]
  let y = b[0]
  if x >= 'A' && x <= 'Z' { x = x + 32 }
  if y >= 'A' && y <= 'Z' { y = y + 32 }
  x == y
}

// The `; did you mean …?` clause for another language's collection generic: `Array<T>` is
// `T[]`, and `Record<K, V>` is `{[K]: V}` or `Map<K, V>`. "" for any other name. Reached only
// once resolution failed, so a program that declares its own `Array` or `Record` never sees it.
export function foreignGenericSpell(name: string): string {
  if foreignGenericHead(name) == 0 { return "" }
  const vl = foreignGenericRespell(name)
  if foreignGenericHead(name) == 1 { return "; did you mean '" + vl + "'?" }
  const kv = foreignRecordSplit(name)
  "; did you mean '"
    + vl
    + "' or 'Map<"
    + foreignGenericRespell(kv[0])
    + ", "
    + foreignGenericRespell(kv[1])
    + ">'?"
}

// 1 when `name` is `Array<…>`, 2 when it is a two-argument `Record<…>`, else 0.
export function foreignGenericHead(name: string): i32 {
  if name.length < 8 || name[name.length - 1] != '>' { return 0 }
  if name.slice(0, 6) == "Array<" { return 1 }
  if name.slice(0, 7) == "Record<" && foreignRecordSplit(name).length == 2 {
    return 2
  }
  0
}

// A `Record<K,V>` spelling's two arguments, split at its one top-level comma; [] otherwise.
function foreignRecordSplit(name: string): string[] {
  const inner = name.slice(7, name.length - 1)
  let depth = 0
  let i = 0
  while i < inner.length {
    const c = inner[i]
    if c == '<' || c == '(' || c == '[' || c == '{' { depth = depth + 1 }
    if c == '>' || c == ')' || c == ']' || c == '}' { depth = depth - 1 }
    if c == ',' && depth == 0 {
      return [inner.slice(0, i), inner.slice(i + 1, inner.length)]
    }
    i = i + 1
  }
  []
}

// `s` with each `|` spaced as the formatter writes a union (`string | i32`).
function spaceUnionBars(s: string): string {
  let out = ""
  let i = 0
  while i < s.length {
    if s[i] == '|' {
      while out.length > 0 && out[out.length - 1] == ' ' {
        out = out.slice(0, out.length - 1)
      }
      out = out + " | "
      i = i + 1
      while i < s.length && s[i] == ' ' { i = i + 1 }
    } else {
      out = out + s.slice(i, i + 1)
      i = i + 1
    }
  }
  out
}

// `name` with every outermost `Array<…>`/`Record<…>` written the VL way, recursively, and
// its unions spaced.
function foreignGenericRespell(name: string): string {
  const h = foreignGenericHead(name)
  if h == 1 {
    let el = foreignGenericRespell(name.slice(6, name.length - 1))
    if el.includes("|") || el.includes("=>") { el = "(" + el + ")" }
    return el + "[]"
  }
  if h == 2 {
    const kv = foreignRecordSplit(name)
    return "{["
      + foreignGenericRespell(kv[0])
      + "]: "
      + foreignGenericRespell(kv[1])
      + "}"
  }
  spaceUnionBars(name)
}

// The method twin of `tySpellFrom`/`tySpellTo`, one table per receiver kind: a list, a
// string and a map answer the same typo with a different name. A target whose arguments
// differ from the call written (`charAt` takes an index, `slice` a range) is stored as the
// whole call shape, never a bare name.
export const strMethodSpellFrom = [
  "charat", "substring", "substr", "touppercase", "tolowercase", "size",
  "count", "contains",
]
export const strMethodSpellTo = [
  "slice(i, i + 1)", "slice", "slice", "toUpperAscii", "toLowerAscii", "length",
  "length", "includes",
]
export const listMethodSpellFrom = [
  "append", "add", "size", "count", "contains",
]
export const listMethodSpellTo = [
  "push", "push", "length", "length", "includes",
]
export const mapMethodSpellFrom = ["put", "containskey", "size"]
export const mapMethodSpellTo = ["set", "has", "length"]

// The intrinsic call-able names `checkCallNode` tests for a string/array receiver, in
// that order — a tie in `methodSuggestFrom`'s edit distance keeps the earlier (intrinsic)
// candidate.
export const strMethodNames = [
  "slice", "indexOf", "includes", "charCodeAt", "cpAt", "cpLen",
  "isCharBoundary", "bytes", "length",
]
export const listMethodNames = [
  "push", "map", "filter", "pop", "get", "clear", "slice", "length",
]
