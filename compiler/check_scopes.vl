// `check_scopes.vl` — the checker's scope chain and the queries that resolve a name through it.
// Each frame of `T.frames` maps a name it binds to an entry of the binding log, and the entry
// holds the slot the name binds (its declaration) and the type at that layer, so a declaration's
// type is one array read. Beside it run the inverted chain (`scopeDepthsOf`) and three parallel
// per-frame tables: which names are `const`, which name a `FuncDecl`, and which alias one.
// `declareDecl` binds a declaration, `declare` re-binds a visible name for flow, and the
// checker pushes and pops the frames and resets the tables.

import { FuncDecl, Ident, LetDecl, P, nodeAt } from "./ast"
import { modSuffixOf } from "./modid"
import { demangleName } from "./check_suggest"
import { T } from "./check_types"
import {
  IDENT_BUILTIN,
  identDeclOf,
  sidEpoch,
  sidOfNode,
  sidText,
} from "./symbols"
import { fnDeclIx } from "./check_write_scan"

// The const-binding chain, parallel to `T.frames`: each frame records which of its names carry
// `const` — an immutable name, not immutable data, so a field write through a const stays
// legal. Kept module-level rather than a `Checker` field so the exported struct shape is
// unchanged.
export let constScopes: {[string]: i32}[] = []

// Every module `const` by name, its declaration, from the hoist: the answer `constDeclOf` gives
// for a module constant read before the checker reaches its declaration.
export let moduleConstDecl: {[string]: i32} = Map()

// The scope chain inverted: for each name, the depths of the frames binding it, outermost first,
// so the innermost binding is the last entry. `declare` and `popScope` keep it in step with
// `T.frames`, and a lookup reads one entry instead of walking every frame (D2190).
export let scopeDepthsOf: {[string]: i32[]} = Map()
// Every name whose `scopeDepthsOf` entry gained a depth, in order, for a cache that must see it.
export let scopeDeclLog: string[] = []

// The function-declaration chain, parallel to `T.frames`: each frame records the arena node of
// every `FuncDecl` declared in it. `fnDeclIx` answers that for top-level functions only; this
// answers it for a nested one too, under the scope chain's shadowing rule, which is what a call
// needs to recover the callee's parameter list and the defaults a call site may omit.
export let fnDeclScopes: {[string]: i32}[] = []

// The function-alias chain, parallel to `T.frames`: for a binding whose initializer is a bare
// ident naming a declared function (`const f = addT`), the arena node of that declaration.
// `fnDeclScopes` deliberately answers -1 there, a function value keeping the exact-arity gate a
// value call has. Its one consumer is constraint ownership; a closure parameter is left out.
export let fnAliasScopes: {[string]: i32}[] = []

// The binding log. Entry `e` binds slot `envLogSlot[e]` (a declaration node, or an ambient slot
// `-2 - k` for a binding no declaration makes) at frame `envLogDepth[e]` with type `envLogTy[e]`;
// `envLogPrev[e]` is the slot's next-outer live entry. A hidden entry is out of its slot's chain.
let envLogSlot: i32[] = []
let envLogTy: i32[] = []
let envLogPrev: i32[] = []
let envLogDepth: i32[] = []
let envLogHid: boolean[] = []
// Each frame's first log entry, and each slot's innermost live entry (-1 none).
let envFrameBase: i32[] = []
let envDeclTop: i32[] = []
let envAmbTop: i32[] = []
// Each ambient intrinsic's slot by name: what a builtin `Ident`, which names no declaration, reads.
let envAmbOf: {[string]: i32} = Map()
// Each ambient slot's name, by `-2 - s`: an ambient binding has no node to read its name from.
let envAmbName: string[] = []
// Each binding that aliases a function declaration (`const f = addT`), by the binding's declaration.
let fnAliasOfDecl: {[i32]: i32} = Map()

// The (name, depth) bindings `scopeHideEnter` took out of `scopeDepthsOf`, innermost window last,
// with the log entry each one unlinked.
export let scopeHidName: string[] = []
export let scopeHidDepth: i32[] = []
let scopeHidEntry: i32[] = []

// Empties the scope chain and every table beside it, for a new program.
export function scopesReset() {
  T.frames = []
  scopeDepthsOf = Map()
  scopeDepthsBySidReset()
  scopeDeclLog = []
  scopeHidName = []
  scopeHidDepth = []
  scopeHidEntry = []
  envLogSlot = []
  envLogTy = []
  envLogPrev = []
  envLogDepth = []
  envLogHid = []
  envFrameBase = []
  envDeclTop = []
  envAmbTop = []
  envAmbOf = Map()
  envAmbName = []
  fnAliasOfDecl = Map()
  0
}

// Opens a frame of the scope chain; the parallel tables are pushed by the caller.
export function scopeFramePush() {
  T.frames.push(Map())
  envFrameBase.push(envLogSlot.length)
  0
}

// Closes the innermost frame: its names leave `scopeDepthsOf` and each slot it bound returns to
// its outer entry.
export function scopeFramePop() {
  const top = T.frames.length - 1
  if top < 0 { return 0 }
  for k in T.frames[top] {
    const ds = scopeDepthsOf[k]
    if ds != null { ds.pop() }
  }
  const base = envFrameBase[top]
  while envLogSlot.length > base {
    const e = envLogSlot.length - 1
    if !envLogHid[e] { envUnlink(e) }
    envLogSlot.pop()
    envLogTy.pop()
    envLogPrev.pop()
    envLogDepth.pop()
    envLogHid.pop()
  }
  T.frames.pop()
  envFrameBase.pop()
  0
}

function envSlotTop(s: i32) {
  if s >= 0 {
    if s < envDeclTop.length { return envDeclTop[s] }
    return -1
  }
  const k = -2 - s
  if k >= 0 && k < envAmbTop.length { return envAmbTop[k] }
  -1
}

// Resizes the declaration-indexed top table to cover `s`: at least the arena, and at least twice
// its own length, in one allocation, so the table never grows one node at a time.
function envDeclTopGrow(s: i32) {
  let n = P.nodes.length
  if n <= s { n = s + 1 }
  if n < 2 * envDeclTop.length { n = 2 * envDeclTop.length }
  const t: i32[] = __array_new__(n, -1)
  __array_copy__(t, 0, envDeclTop, 0, envDeclTop.length)
  envDeclTop = t
  0
}

function envSlotTopSet(s: i32, e: i32) {
  if s >= 0 {
    if s >= envDeclTop.length { envDeclTopGrow(s) }
    envDeclTop[s] = e
    return 0
  }
  const k = -2 - s
  if k >= 0 && k < envAmbTop.length { envAmbTop[k] = e }
  0
}

// Takes entry `e` out of its slot's chain.
function envUnlink(e: i32) {
  const s = envLogSlot[e]
  const top = envSlotTop(s)
  if top == e { return envSlotTopSet(s, envLogPrev[e]) }
  let at = top
  while at >= 0 && envLogPrev[at] != e { at = envLogPrev[at] }
  if at >= 0 { envLogPrev[at] = envLogPrev[e] }
  0
}

// Makes entry `e` its slot's innermost.
function envLink(e: i32) {
  const s = envLogSlot[e]
  envLogPrev[e] = envSlotTop(s)
  envSlotTopSet(s, e)
}

function envMintAmbient(name: string) {
  envAmbTop.push(-1)
  envAmbName.push(name)
  -1 - envAmbTop.length
}

// The name slot `s` binds: its declaration's own, or the ambient intrinsic's.
export function slotNameOf(s: i32): string {
  if s >= 0 { return sidText(sidOfNode(s)) }
  const k = -2 - s
  if k >= 0 && k < envAmbName.length { return envAmbName[k] }
  ""
}

// Slot `s`'s innermost live layer (a binding-log entry), or -1; `slotLayerPrev` steps outward,
// so a walk visits the slot's own layers, deepest first, and never another binding's.
export function slotLayerTop(s: i32) { envSlotTop(s) }
export function slotLayerPrev(e: i32) { envLogPrev[e] }
export function slotLayerDepth(e: i32) { envLogDepth[e] }
export function slotLayerTy(e: i32) { envLogTy[e] }

// Slot `s`'s layer at frame depth `d`, or -1.
function slotLayerAt(s: i32, d: i32) {
  let e = envSlotTop(s)
  while e >= 0 && envLogDepth[e] > d { e = envLogPrev[e] }
  if e >= 0 && envLogDepth[e] == d { return e }
  -1
}

// The type slot `s` holds in frame `d`, or -1 when that frame does not bind it.
export function slotTyAt(s: i32, d: i32) {
  const e = slotLayerAt(s, d)
  if e < 0 { return -1 }
  envLogTy[e]
}

// Rebinds slot `s` in frame `d` to `ty` in place; a frame that does not bind it is left alone.
export function slotTySetAt(s: i32, d: i32, ty: i32) {
  const e = slotLayerAt(s, d)
  if e >= 0 { envLogTy[e] = ty }
  0
}

// Binds `name` in the innermost frame to slot `s` at type `ty`; a name the frame already binds
// keeps its entry, re-pointed at `s`, unless both are declarations: a redeclaration leaves the
// first one bound, so a read the binder resolves to either still has its type.
function envBind(s: i32, name: string, ty: i32) {
  const top = T.frames.length - 1
  const fr = T.frames[top]
  const had = fr[name] ?? -1
  if had >= 0 && !(s >= 0 && envLogSlot[had] >= 0 && envLogSlot[had] != s) {
    envLogTy[had] = ty
    if envLogSlot[had] == s || envLogHid[had] {
      envLogSlot[had] = s
      return 0
    }
    envUnlink(had)
    envLogSlot[had] = s
    return envLink(had)
  }
  const e = envLogSlot.length
  envLogSlot.push(s)
  envLogTy.push(ty)
  envLogPrev.push(-1)
  envLogDepth.push(top)
  envLogHid.push(false)
  envLink(e)
  fr[name] = e
  0
}

// The type declaration `decl` is bound at in the innermost frame binding it, or -1 when no live
// frame binds it. This is how a node that holds its declaration reads a type.
export function declTyOf(decl: i32) {
  const e = envSlotTop(decl)
  if e < 0 { return -1 }
  envLogTy[e]
}

// The frame depth of `decl`'s innermost binding, or -1.
export function declDepthOf(decl: i32) {
  const e = envSlotTop(decl)
  if e < 0 { return -1 }
  envLogDepth[e]
}

// The slot the `Ident` `ix`, spelled `name`, reads through: its declaration, else the ambient
// intrinsic of its name when the binder found none, else -1.
export function identSlotOf(ix: i32, name: string) {
  const d = identDeclOf(ix)
  if d >= 0 { return d }
  if d != IDENT_BUILTIN { return -1 }
  const s = envAmbOf[name] ?? -1
  if s >= -1 { return -1 }
  s
}

// The type the `Ident` `ix`, spelled `name`, reads, or -1 when nothing live binds it.
export function identTyOf(ix: i32, name: string) {
  const s = identSlotOf(ix, name)
  if s == -1 { return -1 }
  declTyOf(s)
}
// The type the ambient intrinsic `name` binds, or -1.
export function ambientTyOf(name: string) {
  const s = envAmbOf[name] ?? -1
  if s >= -1 { return -1 }
  declTyOf(s)
}

// The frame depth the `Ident` `ix`, spelled `name`, resolves at, or -1.
export function identDepthOf(ix: i32, name: string) {
  const s = identSlotOf(ix, name)
  if s == -1 { return -1 }
  declDepthOf(s)
}

// The live binding the `Ident` `ix` reads, or -1 when it reads no declaration or nothing binds it.
function identLiveDeclOf(ix: i32) {
  const d = identDeclOf(ix)
  if d < 0 || declDepthOf(d) < 0 { return -1 }
  d
}

// The `FuncDecl` the `Ident` `ix` names, or -1 when it names any other binding.
export function identFnDeclOf(ix: i32) {
  const d = identLiveDeclOf(ix)
  if d >= 0 && nodeAt(d) is FuncDecl { return d }
  -1
}

// The `const` declaration the `Ident` `ix` names, or -1 when its binding is not a `const`.
export function identConstDeclOf(ix: i32) {
  const d = identLiveDeclOf(ix)
  if d < 0 { return -1 }
  const n = nodeAt(d)
  if n is LetDecl {
    if n.letKw == "const" { return d }
  }
  -1
}

// Whether the `Ident` `ix` names a live `const` binding.
export function identIsConst(ix: i32) { identConstDeclOf(ix) >= 0 }

// The function declaration the binding `decl` aliases (`const f = addT`), or -1.
export function declFnAliasOf(decl: i32) {
  if decl < 0 { return -1 }
  fnAliasOfDecl[decl] ?? -1
}

// Records that the binding `decl` aliases the function declaration `fn`.
export function declFnAliasSet(decl: i32, fn: i32) {
  if decl >= 0 { fnAliasOfDecl[decl] = fn }
  0
}

// The function declaration the `Ident` `ix`'s live binding aliases, or -1.
export function identFnAliasOf(ix: i32) { declFnAliasOf(identLiveDeclOf(ix)) }

// The slot `name`'s innermost visible binding holds, or -1. This is a second resolver of the
// fact the binder records per `Ident`, kept only where a flow question holds a place key or a
// name list and no node: B1b keys those by declaration and B2c deletes this (D14544).
export function envDeclOfNameForFlow(name: string) {
  const d = lookupDepth(name)
  if d < 0 { return -1 }
  const e = T.frames[d][name] ?? -1
  if e < 0 { return -1 }
  envLogSlot[e]
}

// The type `name` holds in frame `d`, or -1 when that frame does not bind it.
export function scopeTyAt(d: i32, name: string) {
  if d < 0 || d >= T.frames.length { return -1 }
  const e = T.frames[d][name] ?? -1
  if e < 0 { return -1 }
  envLogTy[e]
}

// The slot `name` binds in frame `d`, or -1.
export function scopeSlotAt(d: i32, name: string) {
  if d < 0 || d >= T.frames.length { return -1 }
  const e = T.frames[d][name] ?? -1
  if e < 0 { return -1 }
  envLogSlot[e]
}

// Hides every binding above the module frame from name lookup until `scopeHideLeave`, and answers
// the mark to hand it. A top-level function's body is checked under this, so a forward callee
// inferred inside a caller resolves its free names at module scope, not the caller's (D5650).
export function scopeHideEnter(): i32 {
  const mark = scopeHidName.length
  let d = T.frames.length - 1
  while d >= 1 {
    for k in T.frames[d] {
      const ds = scopeDepthsOf[k]
      if ds != null {
        let j = ds.length - 1
        while j >= 0 && ds[j] != d { j = j - 1 }
        if j >= 0 {
          while j + 1 < ds.length {
            ds[j] = ds[j + 1]
            j = j + 1
          }
          ds.pop()
          const e = T.frames[d][k] ?? -1
          if e >= 0 && !envLogHid[e] {
            envUnlink(e)
            envLogHid[e] = true
          }
          scopeHidName.push(k)
          scopeHidDepth.push(d)
          scopeHidEntry.push(e)
        }
      }
    }
    d = d - 1
  }
  mark
}

// Puts back, in depth order, what `scopeHideEnter` hid since `mark`. A binding whose frame is gone,
// or that is listed again already, stays out.
export function scopeHideLeave(mark: i32) {
  let i = scopeHidName.length - 1
  while i >= mark {
    const k = scopeHidName[i]
    scopeDeclLog.push(k)
    const d = scopeHidDepth[i]
    if d < T.frames.length && T.frames[d].has(k) {
      const e = scopeHidEntry[i]
      if e >= 0 && (T.frames[d][k] ?? -1) == e && envLogHid[e] {
        envLogHid[e] = false
        envLink(e)
      }
      const ds = scopeDepthsOf[k]
      if ds == null {
        scopeDepthsOf[k] = [d]
      } else {
        let j = ds.length
        let dup = false
        while j > 0 && ds[j - 1] >= d {
          if ds[j - 1] == d { dup = true }
          j = j - 1
        }
        if !dup {
          ds.push(d)
          let m = ds.length - 1
          while m > j {
            ds[m] = ds[m - 1]
            m = m - 1
          }
          ds[j] = d
        }
      }
    }
    scopeHidName.pop()
    scopeHidDepth.pop()
    scopeHidEntry.pop()
    i = i - 1
  }
  0
}

// The scope-chain depth of the innermost binding of `name`, or -1 when undeclared. `lookup` is
// the same walk reading the type out; this one reads the frame it came from, which is what the
// narrowing bank validates its entries against.
export function lookupDepth(name: string) {
  const ds = scopeDepthsOf[name]
  if ds == null || ds.length == 0 { return -1 }
  ds[ds.length - 1]
}

// `scopeDepthsOf` read by interned id: `sdDepths[sid]` is the SAME array the map holds for that
// name, filled on first ask, so `declare`, `popScope` and the hide window keep both in step. A row
// is live only while `sdHave[sid]` is set; `sdEpoch` drops every row once `sidReset` re-mints ids.
let sdDepths: i32[][] = []
let sdHave: boolean[] = []
let sdEpoch = -1
const SD_FILL: i32[] = []

// Drops the id view; the checker calls it wherever it replaces `scopeDepthsOf`.
export function scopeDepthsBySidReset() {
  sdDepths = []
  sdHave = []
  sdEpoch = sidEpoch
  0
}

// `lookupDepth(name)` where `sid` is `name`'s interned id (`sidOfNode` of the node spelling it),
// an array read once the name has a binding row. A negative `sid` takes the name lookup.
export function lookupDepthSid(sid: i32, name: string) {
  if sid < 0 { return lookupDepth(name) }
  if sdEpoch != sidEpoch { scopeDepthsBySidReset() }
  if sid < sdHave.length && sdHave[sid] {
    const hs = sdDepths[sid]
    if hs.length == 0 { return -1 }
    return hs[hs.length - 1]
  }
  const ds = scopeDepthsOf[name]
  if ds == null { return -1 }
  while sdHave.length <= sid {
    sdHave.push(false)
    sdDepths.push(SD_FILL)
  }
  sdDepths[sid] = ds
  sdHave[sid] = true
  if ds.length == 0 { return -1 }
  ds[ds.length - 1]
}

// True if `name` resolves (innermost-first) to a `const` binding.
export function isConstName(name: string) {
  const i = lookupDepth(name)
  if i >= 0 && i < constScopes.length { return constScopes[i].has(name) }
  false
}

// Records a fresh binding of `name` in the innermost frame in `scopeDepthsOf`, through the id
// view when `sid` is known; a name the frame already binds is left as it is.
function scopeDepthNote(sid: i32, name: string) {
  const top = T.frames.length - 1
  if T.frames[top].has(name) { return 0 }
  if sid >= 0 {
    if sdEpoch != sidEpoch { scopeDepthsBySidReset() }
    if sid < sdHave.length && sdHave[sid] {
      sdDepths[sid].push(top)
      scopeDeclLog.push(name)
      return 0
    }
  }
  let ds: i32[] = SD_FILL
  const had = scopeDepthsOf[name]
  if had == null {
    ds = [top]
    scopeDepthsOf[name] = ds
  } else {
    had.push(top)
    ds = had
  }
  if sid >= 0 {
    while sdHave.length <= sid {
      sdHave.push(false)
      sdDepths.push(SD_FILL)
    }
    sdDepths[sid] = ds
    sdHave[sid] = true
  }
  scopeDeclLog.push(name)
  0
}

// Binds declaration `decl`, spelled `name`, to `ty` in the innermost frame.
export function declareDecl(decl: i32, name: string, ty: i32) {
  if decl < 0 { return declare(name, ty) }
  scopeDepthNote(sidOfNode(decl), name)
  envBind(decl, name, ty)
}

// Binds the ambient intrinsic `name`, which no declaration makes, to `ty` in the innermost frame.
export function declareAmbient(name: string, ty: i32) {
  const s = envMintAmbient(name)
  envAmbOf[name] = s
  scopeDepthNote(-1, name)
  envBind(s, name, ty)
}

// Re-binds `name` to `ty` in the innermost frame as a layer over the binding it names now: a
// narrowing, a widening or a restored snapshot. A name nothing binds gets a slot of its own.
export function declare(name: string, ty: i32) {
  const top = T.frames.length - 1
  let s = scopeSlotAt(top, name)
  if s == -1 { s = envDeclOfNameForFlow(name) }
  if s == -1 { return declareAmbient(name, ty) }
  declareSlot(s, name, ty)
}

// Binds `name` to slot `s` at `ty` in the innermost frame: `declare` with the slot in hand.
export function declareSlot(s: i32, name: string, ty: i32) {
  scopeDepthNote(-1, name)
  envBind(s, name, ty)
}
// Record `nodeIx` as the `FuncDecl` that `name` declares in the current scope.
export function declareFnDeclNode(name: string, nodeIx: i32) {
  const top = fnDeclScopes.length - 1
  if top >= 0 { fnDeclScopes[top][name] = nodeIx }
  0
}

// The `const` declaration `name` currently resolves to, or -1 when its innermost binding is not a
// `const`. A module constant the checker has not reached yet answers from its hoist (D3271).
export function constDeclOf(name: string) {
  const i = lookupDepth(name)
  if i < 0 { return -1 }
  if i < constScopes.length {
    const d = constScopes[i][name] ?? -1
    if d >= 0 { return d }
  }
  if i == 0 { return moduleConstDecl[name] ?? -1 }
  -1
}

// Look `name` up through the scope chain, innermost first. Returns its type-arena
// index, or `-1` if undeclared (innermost-wins, so shadowing works).
export function lookup(name: string) {
  const i = lookupDepth(name)
  if i < 0 { return -1 }
  scopeTyAt(i, name)
}

// The `FuncDecl` the binder bound the `Ident` `ix` to, whether or not its scope is open now (a
// walk after the pass is out of every function's scope), or -1 for any other binding.
export function identBoundFnDeclOf(ix: i32): i32 {
  const d = identDeclOf(ix)
  if d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl { return d }
  -1
}

// The merged spelling of plain `name` that `fnDeclIx` is keyed on, or "". A merge renames
// every declaration, so any gate that asks the table by the name a SITE spells arrives
// unmangled and misses — the UFCS `self`-name gate (D1654) and the operator dispatch, whose
// site is `a + b` and has no name to rewrite at all. `lookup` is the visibility test.
export function mergedDeclKeyOf(name: string) {
  for k in fnDeclIx.keys() {
    if demangleName(k) == name && lookup(k) >= 0 { return k }
  }
  ""
}

// The declared parameter nodes behind a call's callee, when the call is direct — an `Ident`
// the scope chain resolves to a `FuncDecl` (top-level or nested). A closure-valued callee has
// no declaration to read defaults from, so it answers the empty list and every default-driven
// relaxation is off for it: a function value keeps full arity.
export function calleeDeclParams(calleeIx: i32) {
  const none: i32[] = []
  const cf = nodeAt(calleeIx)
  if cf is Ident {
    const dIx = identFnDeclOf(calleeIx)
    if dIx >= 0 {
      const d = nodeAt(dIx)
      if d is FuncDecl { return d.fnParams }
    }
  }
  none
}

// Whether the `Ident` `ix` spelled `name` reads a user binding that shadows a numeric intrinsic.
export function identIntrShadowed(ix: i32, name: string) {
  if (fnDeclIx[name] ?? -1) >= 0 { return true }
  identTyOf(ix, name) >= 0
}

// The module-level `FuncDecl` named `raw` (or its merged `raw$m<m>`), or -1.
export function moduleFnDeclOf(raw: string, m: i32) {
  let d = fnDeclIx[raw] ?? -1
  if d < 0 && m >= 0 { d = fnDeclIx[raw + modSuffixOf(m)] ?? -1 }
  d
}
