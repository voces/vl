// `check_cstr_rows.vl` — the deferred constraints a generic body records for its call sites.
// A body that cannot yet decide an operation over a hole (a binary operator, an argument, a
// return, a `print`, an `is`, a member read, ...) records a row in the matching table, stamped
// with the owning declaration (`cstrOwnerTop`) and the delivery it arrived through (`cvMark`);
// each call site re-asks its callee's rows under its substitution. The `note*Cstr` recorders
// keep one row per structurally equal constraint of a body, and `tpGradualRecv` records the
// member read a gradual receiver defers to its pin.

import { cstrOwnerStack, tpEnvNames } from "./check_cursor"
import { tpGradualView, tyIsDeferredJoin } from "./check_tp_join"
import { wsVarTy } from "./tyquery"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  tyAt,
  tyEqSameHoles,
  tyHasHole,
  tyHasInferHole,
} from "./check_types"
import { wsNoteInstErr } from "./check_width"
import { FuncDecl, Ident, P, i32ToStr, nodeAt } from "./ast"
import { i32ListHas } from "./listutil"
import { lookupFnDeclNode } from "./check_scopes"
import { cwPeel, fnDeclIx } from "./check_write_scan"

// Deferred binary-op constraints over un-annotated-param holes: with a hole operand, `a + b` /
// `s + "!"` / `n < 2` cannot be decided in the body, a hole being permissively assignable to
// both string and numeric. Record `(lt, op, rt)` as arena type indices; the generic call site
// re-validates each under the substituted argument types via `binOpDefinedFor`.
type BinCstrCols = {
  lt: i32[],
  op: string[],
  rt: i32[],
  // The `FuncDecl` node that owns each constraint — the body recording it, or -1 at module
  // scope. Without it the list is keyed on the TyVar name alone and every generic in the program
  // shares one namespace, so an unrelated generic's refusal fires at a call that never adds or
  // compares. `validateBinCstrs` / `binCstrsHold` filter on it, falling back to the whole list at -1.
  fn: i32[],
  // The `BinExpr` that wrote the constraint, or -1: the pin asks that node the direct
  // spelling's numeric pair rule, whose literal operands adapt (`numBinPairRefusal`).
  node: i32[],
  // `node`'s `binLitShape`, or -1: rows of one body alike but for a node of the same shape
  // are one row, as the rule answers both alike.
  shape: i32[],
}

export const binCstr: BinCstrCols = {
  lt: [],
  op: [],
  rt: [],
  fn: [],
  node: [],
  shape: [],
}

// Drops every `binCstr` row from `n` on, all columns together.
export function binCstrTruncate(n: i32) {
  while binCstr.op.length > n {
    binCstr.lt.pop()
    binCstr.op.pop()
    binCstr.rt.pop()
    binCstr.fn.pop()
    binCstr.node.pop()
    binCstr.shape.pop()
  }
  0
}

// Deferred call-argument constraints over un-annotated-param holes: inside a generic body a
// hole flowed as an argument into a concrete parameter (`function f(x) { g(x) }` with
// `g(n: i32)`). The body cannot judge it, so the demand is recorded (hole type, expected param
// type, callee name) and the generic call site re-validates it under the substituted types.
type ArgCstrCols = {
  at: i32[],
  exp: i32[],
  who: string[],
  // The owning declaration, for the by-name `TyVar` reason `noteBinCstr` stamps one (D2424).
  fn: i32[],
  // What the demand is: `ACF_PLAIN`, `ACF_TPL` (a template hole meeting its renderer, which also
  // delivers a `string` without the call, D2241), or N >= 1 for argument N of a call through a hole
  // callee, which the pin holds only to the scalar rule `holeArgScalarRefused` names (D3225).
  form: i32[],
  // A hole callee's argument node inside the body, or -1: what the pin asks the direct call's
  // question of when no argument of the pinning call binds it.
  node: i32[],
}

export const argCstr: ArgCstrCols = {
  at: [],
  exp: [],
  who: [],
  fn: [],
  form: [],
  node: [],
}

// Drops every `argCstr` row from `n` on, all columns together.
export function argCstrTruncate(n: i32) {
  while argCstr.at.length > n {
    argCstr.at.pop()
    argCstr.exp.pop()
    argCstr.who.pop()
    argCstr.fn.pop()
    argCstr.node.pop()
    argCstr.form.pop()
  }
  0
}

// D401 — deferred `print` constraints over un-annotated-param and type-parameter holes.
// `print` takes one value of `printDomainStr()`, and the two floors that say so
// (`tyPrintsAsRef`, `tyPrintsAsUnionBox`) both answer false at a hole, so the body admits the
// call. Record the printed type and the argument node; the pin re-asks both floors substituted.
export type TyIxCstrCols = {
  ty: i32[],
  ix: i32[],
  fn: i32[],
}

export const printCstr: TyIxCstrCols = { ty: [], ix: [], fn: [] }

// The vector-container twin of the `print` rows (`noteNestCstr`), deduped by type and owner.
export const nestCstr: TyIxCstrCols = { ty: [], ix: [], fn: [] }

// The row each type-and-owner key last matched. A probe's rollback can pop that row, so a hit
// counts only when the row is still there and still matches.
export let nestCstrSeen: {[string]: i32} = Map()

// Drops every row of `c` (`printCstr` or `nestCstr`) from `n` on, all columns together.
export function tyIxCstrTruncate(c: TyIxCstrCols, n: i32) {
  while c.ty.length > n {
    c.ty.pop()
    c.ix.pop()
    c.fn.pop()
  }
  0
}

// An `is` test over a hole parameter, re-asked at the pin as the annotated spelling asks it:
// the tested operand's type, the checked type, the test's spelling, the node, and the owner.
type IsCstrCols = {
  ty: i32[],
  chk: i32[],
  name: string[],
  ix: i32[],
  fn: i32[],
}

export const isCstr: IsCstrCols = { ty: [], chk: [], name: [], ix: [], fn: [] }

// Drops every `isCstr` row from `n` on, all columns together.
export function isCstrTruncate(n: i32) {
  while isCstr.ty.length > n {
    isCstr.ty.pop()
    isCstr.chk.pop()
    isCstr.name.pop()
    isCstr.ix.pop()
    isCstr.fn.pop()
  }
  0
}

// D551 — deferred return-type constraints, the declared return re-asked at the pin because
// neither layer owns the question in the body: `assignable(T, V)` is vacuous over a hole, and
// `substTyDeep` hands the declared return out without comparing it against the body type. The
// answer is `assignableExpr` on the substituted pair — the same function the body asked.
type RetCstrCols = {
  got: i32[],
  want: i32[],
  // The returned expression's node — the handle `assignableExpr` needs at the pin, not a position
  // for the diagnostic (that is the call, like every other pin report).
  ix: i32[],
  fn: i32[],
  // D571 — which side carries the hole, 1 for the declared side alone. The two are not
  // one constraint: a hole on the body side sits under a concrete declaration the author can
  // name, so `return x as A1` is writable and the pin holds the author to it, while a hole on the
  // declared side alone is a destination with no cast to write. Only that column is exempt below.
  wOnly: i32[],
}

export const retCstr: RetCstrCols = {
  got: [],
  want: [],
  ix: [],
  fn: [],
  wOnly: [],
}

// Drops every `retCstr` row from `n` on, all columns together.
export function retCstrTruncate(n: i32) {
  while retCstr.got.length > n {
    retCstr.got.pop()
    retCstr.want.pop()
    retCstr.ix.pop()
    retCstr.fn.pop()
    retCstr.wOnly.pop()
  }
  0
}

export let cstrSeqNext = 0

// D572 — the mirror of `retCstr.got` one node over: every other place a value lands inside a
// generic body (a local declaration, a re-assignment, a struct-field write, an element write).
// A separate table because `validateRetCstrs` cannot see these — in `const r: T = n + 1` the
// i32 enters at the `const`, where `assignable(i32, T)` is vacuous. No newtype exemption here.
type LetCstrCols = {
  got: i32[],
  want: i32[],
  // The source expression's node — the handle `assignableExpr` needs at the pin, not a position
  // for the diagnostic (that is the call, like every other pin report).
  ix: i32[],
  fn: i32[],
  // The binding's name, or "" for a destination that has none of its own. It selects which of the
  // two direct spellings' sentences the pin repeats: a declaration says `cannot assign i32 to 'r'
  // of type string` and can also say the object-literal-into-a-map and lossy-numeric forms; a
  // write to an already-declared place says only `cannot assign i32 to string`. `letAssignMsg` forks.
  name: string[],
  // The check-order stamp of each `letCstr` and `bmCstr` row, from one counter, so the pin pass
  // applies a body's writes in check order wherever each is deferred (D2218).
  seq: i32[],
}

export const letCstr: LetCstrCols = {
  got: [],
  want: [],
  ix: [],
  fn: [],
  name: [],
  seq: [],
}

// Drops every `letCstr` row from `n` on, all columns together.
export function letCstrTruncate(n: i32) {
  while letCstr.got.length > n {
    letCstr.got.pop()
    letCstr.want.pop()
    letCstr.ix.pop()
    letCstr.fn.pop()
    letCstr.name.pop()
    letCstr.seq.pop()
  }
  0
}

// D582 — deferred builtin-method argument constraints, for the one reason `argCstr*` cannot
// serve this position: that table is adjudicated against a callee it can name, and a builtin
// method has no `FuncDecl` at all. Its argument check is the builtin's own arm, and inside a
// generic body every one of those arms is vacuous. `bmArgMsg` and `bmArgPred` are its one home.
type BmCstrCols = {
  // The check-order stamp, shared with `letCstr.seq`'s counter.
  seq: i32[],
  got: i32[],
  want: i32[],
  // The type the sentence needs that is neither side of the comparison: the receiver array for
  // `push` (`cannot add i32 to string[]`), the other bound for a string `slice`. -1 when the form
  // does not use one. Substituted at the pin like the two real sides.
  ctx: i32[],
  // The argument expression's node — the handle `assignableExpr` / `nomSlotAccepts` need at the
  // pin, not a position for the diagnostic (that is the call, like every other pin report).
  ix: i32[],
  fn: i32[],
  form: i32[],
  label: string[],
}

export const bmCstr: BmCstrCols = {
  seq: [],
  got: [],
  want: [],
  ctx: [],
  ix: [],
  fn: [],
  form: [],
  label: [],
}

// Drops every `bmCstr` row from `n` on, all columns together.
export function bmCstrTruncate(n: i32) {
  while bmCstr.got.length > n {
    bmCstr.got.pop()
    bmCstr.want.pop()
    bmCstr.ctx.pop()
    bmCstr.ix.pop()
    bmCstr.fn.pop()
    bmCstr.form.pop()
    bmCstr.label.pop()
    bmCstr.seq.pop()
  }
  0
}

// D1431 — `memCstr.dem` separates the two things a row can ask, because they refuse in different
// words. A `.length` / `x[i]` row asks a classification (is this rep a collection at all) and
// keeps the direct spelling's sentence; a row from an unbounded `<T>`'s member read asks a
// demand and refuses in the inference hole's words. Stored, not sniffed off `memCstr.prop`.
type MemCstrCols = {
  ty: i32[],
  prop: string[],
  ix: i32[],
  fn: i32[],
  dem: boolean[],
}

export const memCstr: MemCstrCols = {
  ty: [],
  prop: [],
  ix: [],
  fn: [],
  dem: [],
}

// Drops every `memCstr` row from `n` on, all columns together.
export function memCstrTruncate(n: i32) {
  while memCstr.ty.length > n {
    memCstr.ty.pop()
    memCstr.prop.pop()
    memCstr.ix.pop()
    memCstr.fn.pop()
    memCstr.dem.pop()
  }
  0
}

// D1005 — deferred UFCS-receiver constraints, the receiver's half of what `memCstr.ty` asks.
// `ufcsCallTy` gates dispatch on `assignable(recvTy, params[0])`, true for a `TyVar` on either
// side, so a generic body selects by name alone. `ufcsCstr.p0` banks the selected function's
// parameter-0 type; the pin asks `tyFieldTyOf` first, a callable field of that name winning.
type UfcsCstrCols = {
  ty: i32[],
  prop: string[],
  ix: i32[],
  fn: i32[],
  p0: i32[],
  // The other call sites a row stands for: the dedupe keys on the receiver, not on the call, and
  // the pin's built-in rung checks each call's own arguments (D2517).
  more: i32[][],
}

export const ufcsCstr: UfcsCstrCols = {
  ty: [],
  prop: [],
  ix: [],
  fn: [],
  p0: [],
  more: [],
}

// Drops every `ufcsCstr` row from `n` on, all columns together.
export function ufcsCstrTruncate(n: i32) {
  while ufcsCstr.ty.length > n {
    ufcsCstr.ty.pop()
    ufcsCstr.prop.pop()
    ufcsCstr.ix.pop()
    ufcsCstr.fn.pop()
    ufcsCstr.p0.pop()
    ufcsCstr.more.pop()
  }
  0
}

// The body whose constraints are being recorded — the innermost top-level declaration on
// the checking stack, or -1 at module scope.
export function cstrOwnerTop() {
  if cstrOwnerStack.length == 0 { return -1 }
  cstrOwnerStack[cstrOwnerStack.length - 1]
}

// The constraint tables a demand deferred through a function-value delivery can sit in.
export const CV_BIN = 0
export const CV_PRINT = 1
export const CV_ARG = 2
export const CV_RET = 3
export const CV_LET = 4
export const CV_BM = 5
export const CV_MEM = 6
export const CV_UFCS = 7

// The delivery each deferred row reached its owner through, keyed `row * 16 + table`: the
// delivered generic's name node, so the pin's refusal names the delivery as well (D3923).
export let cvViaAt: {[i32]: i32} = Map()

// The delivery the demand being recorded or re-asked arrived through, -1 for none.
export let cvNow = -1

// Stamps row `row` of table `tbl`, just appended, with the delivery in force.
export function cvMark(tbl: i32, row: i32) {
  const k = row * 16 + tbl
  if cvNow >= 0 || cvViaAt.has(k) { cvViaAt[k] = cvNow }
  0
}

// The delivery row `row` of table `tbl` came through, else `outer`.
export function cvPick(tbl: i32, row: i32, outer: i32): i32 {
  const v = cvViaAt[row * 16 + tbl] ?? -1
  if v >= 0 { return v }
  outer
}

// Records a deferred binary-op constraint when either operand is a hole — the body can't
// yet decide the operator's form, so the generic call site validates it under substitution.
// Stamped with the owning declaration, since a `T` in some other generic is a different `T`
// even though `substTyDeep` matches on the name.
export function noteBinCstr(lt: i32, op: string, rt: i32) {
  noteBinCstrAt(lt, op, rt, -1, -1)
}

// `noteBinCstr` written at the `BinExpr` `node` of literal shape `shape` (-1 for none). Rows
// of one body differing in shape stay apart, since a literal operand adapts where a variable
// does not.
export function noteBinCstrAt(
  lt: i32,
  op: string,
  rt: i32,
  node: i32,
  shape: i32,
) {
  if tyHasHole(lt) || tyHasHole(rt) {
    const owner = cstrOwnerTop()
    // An identity comparison of a rewritten parameter would compare two struct types.
    if (op == "==" || op == "!=") && (wsVarTy(lt) || wsVarTy(rt)) {
      wsNoteInstErr(owner)
    }
    // A structurally equal constraint of the same body is the same constraint: a call's
    // substitution mints fresh arena copies, and keying on the index alone let each copy of a
    // callee's constraints re-record in every caller, exponential over a cycle of generics (D2757).
    let k = 0
    while k < binCstr.op.length {
      if (
        binCstr.op[k] == op
        && binCstr.fn[k] == owner
        && binCstr.shape[k] == shape
      ) {
        if (
          tyEqSameHoles(binCstr.lt[k], lt)
          && tyEqSameHoles(binCstr.rt[k], rt)
        ) {
          return 0
        }
      }
      k = k + 1
    }
    binCstr.lt.push(lt)
    binCstr.op.push(op)
    binCstr.rt.push(rt)
    binCstr.fn.push(owner)
    binCstr.node.push(node)
    binCstr.shape.push(shape)
    cvMark(CV_BIN, binCstr.fn.length - 1)
  }
  0
}

// Records a deferred call-argument constraint: hole-typed argument `at` flowed into the
// concrete param type `exp` of callee `who`. Idempotent per `(at, exp)` and argument node, since
// a literal and a value of one type answer apart. A deferred-join `exp` is not recorded; it
// surfaces through the enclosing body's own hole bindings instead.
export function noteArgCstr(
  at: i32,
  exp: i32,
  who: string,
  form: i32,
  node: i32,
) {
  if tyIsDeferredJoin(exp) { return 0 }
  const owner = cstrOwnerTop()
  let k = 0
  while k < argCstr.at.length {
    if (
      argCstr.fn[k] == owner
      && argCstr.form[k] == form
      && argCstr.node[k] == node
    ) {
      if (
        tyEqSameHoles(argCstr.at[k], at)
        && tyEqSameHoles(argCstr.exp[k], exp)
      ) {
        return 0
      }
    }
    k = k + 1
  }
  argCstr.at.push(at)
  argCstr.exp.push(exp)
  argCstr.who.push(who)
  argCstr.fn.push(owner)
  argCstr.node.push(node)
  argCstr.form.push(form)
  cvMark(CV_ARG, argCstr.fn.length - 1)
  0
}

// Records a deferred `print` constraint when the printed type still carries a hole, so the
// generic call site adjudicates the printed rep under substitution. Stamped with the owning
// declaration for the same by-name `TyVar` reason `noteBinCstr` needs it — an unscoped list
// would make every `<T>` in the program share one namespace.
export function notePrintCstr(pt: i32, argIx: i32) {
  if pt < 0 { return 0 }
  if tyHasHole(pt) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < printCstr.ty.length {
      if printCstr.fn[k] == owner && printCstr.ix[k] == argIx {
        if tyEqSameHoles(printCstr.ty[k], pt) { return 0 }
      }
      k = k + 1
    }
    printCstr.ty.push(pt)
    printCstr.ix.push(argIx)
    printCstr.fn.push(owner)
    cvMark(CV_PRINT, printCstr.fn.length - 1)
  }
  0
}

// Records an `is` test of a record type whose operand type `ot` carries a hole, once per owner
// and node (D3109).
export function noteIsCstr(ot: i32, chk: i32, name: string, ix: i32) {
  if chk < 0 || !(tyAt(chk) is TyObj) { return 0 }
  const owner = cstrOwnerTop()
  let k = 0
  while k < isCstr.ty.length {
    if (
      isCstr.fn[k] == owner
      && isCstr.ix[k] == ix
      && tyEqSameHoles(isCstr.ty[k], ot)
    ) {
      return 0
    }
    k = k + 1
  }
  isCstr.ty.push(ot)
  isCstr.chk.push(chk)
  isCstr.name.push(name)
  isCstr.ix.push(ix)
  isCstr.fn.push(owner)
  0
}

// Records a deferred return-type constraint when either side carries a hole — the body
// cannot decide it then. The generic call site re-asks it under substitution, stamped with
// the owning declaration for the same reason `noteBinCstr` is: an unowned list would let
// one generic's declared return adjudicate a sibling's call.
export function noteRetCstr(got: i32, want: i32, ix: i32) {
  const gotHole = tyHasHole(got)
  if gotHole || tyHasHole(want) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < retCstr.got.length {
      if retCstr.fn[k] == owner {
        if (
          tyEqSameHoles(retCstr.got[k], got)
          && tyEqSameHoles(retCstr.want[k], want)
        ) {
          return 0
        }
      }
      k = k + 1
    }
    retCstr.got.push(got)
    retCstr.want.push(want)
    retCstr.ix.push(ix)
    retCstr.fn.push(owner)
    if gotHole { retCstr.wOnly.push(0) } else { retCstr.wOnly.push(1) }
    cvMark(CV_RET, retCstr.fn.length - 1)
  }
  0
}

// Records a deferred builtin-method argument constraint when either side carries a hole —
// the body cannot decide it then. The generic call site re-asks it under substitution,
// stamped with the owning declaration for the same reason `noteBinCstr` is.
export function noteBmCstr(
  form: i32,
  label: string,
  got: i32,
  want: i32,
  ctx: i32,
  argIx: i32,
) {
  if tyHasHole(got) || tyHasHole(want) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < bmCstr.got.length {
      if (
        bmCstr.fn[k] == owner
        && bmCstr.form[k] == form
        && bmCstr.label[k] == label
      ) {
        if (
          tyEqSameHoles(bmCstr.got[k], got)
          && tyEqSameHoles(bmCstr.want[k], want)
        ) {
          return 0
        }
      }
      k = k + 1
    }
    bmCstr.got.push(got)
    bmCstr.want.push(want)
    bmCstr.ctx.push(ctx)
    bmCstr.ix.push(argIx)
    bmCstr.fn.push(owner)
    bmCstr.form.push(form)
    bmCstr.label.push(label)
    bmCstr.seq.push(cstrSeqNext)
    cstrSeqNext = cstrSeqNext + 1
    cvMark(CV_BM, bmCstr.fn.length - 1)
  }
  0
}

// The `memCstr.prop` of a layout constant `T.member` in a generic body, before `T.member`.
export const MC_LAYOUT_MARK = "#layout:"

// Records a deferred receiver-classification constraint when the receiver still carries a
// hole, so the generic call site re-asks whether `T` is a collection under substitution.
// Stamped with the owning declaration — `substTyDeep` matches `TyVar`s by name, so an
// unowned row would let one generic's `.length` adjudicate a sibling's call.

export function noteMemCstr(recv: i32, prop: string, ix: i32, dem: boolean) {
  if recv < 0 { return 0 }
  if tyHasHole(recv) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < memCstr.ty.length {
      if memCstr.fn[k] == owner && memCstr.prop[k] == prop {
        if tyEqSameHoles(memCstr.ty[k], recv) { return 0 }
      }
      k = k + 1
    }
    memCstr.ty.push(recv)
    memCstr.prop.push(prop)
    memCstr.ix.push(ix)
    memCstr.fn.push(owner)
    memCstr.dem.push(dem)
    cvMark(CV_MEM, memCstr.fn.length - 1)
  }
  0
}

// The receiver a member or index read of `recv` is checked at: a gradual union's concrete
// member, the read recorded for the pin to re-ask against the whole union. `recv` otherwise.
export function tpGradualRecv(recv: i32, prop: string, ix: i32): i32 {
  const v = tpGradualView(recv)
  if v == recv || v < 0 || tyAt(v) is TyUnion { return recv }
  noteMemCstr(recv, prop, ix, false)
  v
}

// A generic body's container over a type parameter (`[x, x]` at `x: T`) has no vector in it
// until a call binds `T`, so the type and node are recorded, owned by the enclosing
// declaration, and `validateNestCstrs` asks again at each pin (the `print` constraint's shape).
export function noteNestCstr(t: i32, ix: i32) {
  if t < 0 || cstrOwnerStack.length == 0 { return 0 }
  const tt = tyAt(t)
  let composite = false
  if tt is TyArray { composite = true }
  if tt is TyObj { composite = true }
  if tt is TyNullable { composite = true }
  if tt is TyUnion { composite = true }
  if tt is TyMap { composite = true }
  if !composite { return 0 }
  if !tyHasHole(t) { return 0 }
  const owner = cstrOwnerTop()
  const key = i32ToStr(t) + ":" + i32ToStr(owner)
  const seen = nestCstrSeen.get(key) ?? -1
  if (
    seen >= 0
    && seen < nestCstr.ty.length
    && nestCstr.fn[seen] == owner
    && tyEqSameHoles(nestCstr.ty[seen], t)
  ) {
    return 0
  }
  let k = 0
  while k < nestCstr.ty.length {
    if nestCstr.fn[k] == owner && tyEqSameHoles(nestCstr.ty[k], t) {
      nestCstrSeen.set(key, k)
      return 0
    }
    k = k + 1
  }
  nestCstrSeen.set(key, nestCstr.ty.length)
  nestCstr.ty.push(t)
  nestCstr.ix.push(ix)
  nestCstr.fn.push(owner)
  0
}

// Records a deferred destination constraint when either side carries a hole — the body
// cannot decide it then. Stamped with the owning declaration, for the same reason
// `noteBinCstr` is. No `wOnly` column: that column exists at the return seam only to gate
// D561's newtype exemption, and this seam has no exemption to gate.
export function noteLetCstr(got: i32, want: i32, ix: i32, name: string) {
  if tyHasHole(got) || tyHasHole(want) {
    const owner = cstrOwnerTop()
    // Outside every generic, a type parameter can only be a generic function value's own, which
    // its delivery binds and adjudicates (`genFnValueCstrs`); a row would be re-asked of every
    // later generic call whose parameter shares the name (D3104).
    if owner < 0 && tpEnvNames.length == 0 {
      if !tyHasInferHole(got, 0) && !tyHasInferHole(want, 0) { return 0 }
      // A top-level function named as the value has only its own holes, which the delivery
      // checked its body at; a row would be re-asked of every later call of it (D5972).
      if !tyHasHole(want) && namesTopFnDecl(ix) { return 0 }
      // So does one held in a literal or handed back by a call: every hole rides such a
      // function's own signature, which the delivery judged against `want` (D9031).
      if !tyHasHole(want) && tyHolesOnlyInTopFnSigs(got, 8) { return 0 }
    }
    letCstrRow(got, want, ix, name, owner)
  }
  0
}

// The owner of a row that only a delivery of its binding judges; no call owns it.
export const CSTR_DELIVERY_ONLY = -3

// `noteLetCstr` for a value written into an element of a `let`/`const` binding, kept outside
// every generic too: a delivery of the binding at a closed element type judges it (D10122).
export function noteElemLetCstr(got: i32, want: i32, ix: i32, name: string) {
  if cstrOwnerTop() >= 0 || tpEnvNames.length > 0 {
    return noteLetCstr(got, want, ix, name)
  }
  if tyHasHole(got) || tyHasHole(want) {
    if !i32ListHas(letCstr.ix, ix) {
      letCstrPush(got, want, ix, name, CSTR_DELIVERY_ONLY)
    }
  }
  0
}

// Appends the `letCstr` row unless `owner` already holds the same one.
function letCstrRow(got: i32, want: i32, ix: i32, name: string, owner: i32) {
  let k = 0
  while k < letCstr.got.length {
    if letCstr.fn[k] == owner {
      if (
        tyEqSameHoles(letCstr.got[k], got)
        && tyEqSameHoles(letCstr.want[k], want)
      ) {
        return 0
      }
    }
    k = k + 1
  }
  letCstrPush(got, want, ix, name, owner)
  0
}

function letCstrPush(got: i32, want: i32, ix: i32, name: string, owner: i32) {
  letCstr.got.push(got)
  letCstr.want.push(want)
  letCstr.ix.push(ix)
  letCstr.fn.push(owner)
  letCstr.name.push(name)
  letCstr.seq.push(cstrSeqNext)
  cstrSeqNext = cstrSeqNext + 1
  cvMark(CV_LET, letCstr.fn.length - 1)
  0
}

// Whether the value at `ix` is a name resolving to a module-scope function declaration.
function namesTopFnDecl(ix: i32): boolean {
  const v = cwPeel(ix)
  if v < 0 || v >= P.nodes.length { return false }
  const n = nodeAt(v)
  if !(n is Ident) { return false }
  const d = lookupFnDeclNode(n.identName)
  d >= 0 && (fnDeclIx[n.identName] ?? -1) == d
}

// Whether every hole in `ty` sits inside the open signature of a top-level function with an
// un-annotated parameter whose body is not being checked; false at the depth floor.
function tyHolesOnlyInTopFnSigs(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return false }
  if !tyHasHole(ty) { return true }
  const t = tyAt(ty)
  match t {
    TyFunc => {
      if fnTyIsTopHoleSig(t) { return true }
      for p in t.fnParamTypes {
        if !tyHolesOnlyInTopFnSigs(p, depth - 1) { return false }
      }
      tyHolesOnlyInTopFnSigs(t.fnRet, depth - 1)
    }
    TyArray => tyHolesOnlyInTopFnSigs(t.aElem, depth - 1)
    TyNullable => tyHolesOnlyInTopFnSigs(t.nInner, depth - 1)
    TyMap => {
      tyHolesOnlyInTopFnSigs(t.mKey, depth - 1)
        && tyHolesOnlyInTopFnSigs(t.mVal, depth - 1)
    }
    TyObj => {
      for f in t.objFieldTypes {
        if !tyHolesOnlyInTopFnSigs(f, depth - 1) { return false }
      }
      true
    }
    TyUnion => {
      for m in t.uMembers {
        if !tyHolesOnlyInTopFnSigs(m, depth - 1) { return false }
      }
      true
    }
    TyNeg => tyHolesOnlyInTopFnSigs(t.negTy, depth - 1)
    TyVar | TyPrim | TyErr | TyLit => false
  }
}

// Whether function type `f` is a top-level function's own open signature: its first hole
// parameter is named for a declaration (`?name.k`) that is not on the constraint-owner stack.
function fnTyIsTopHoleSig(f: TyFunc): boolean {
  for p in f.fnParamTypes {
    if p >= 0 && p < T.tys.length {
      const pv = tyAt(p)
      if pv is TyVar {
        const nm = pv.tvName
        const dot = nm.indexOf(".")
        if nm.slice(0, 2) == "?#" || dot < 2 || nm.slice(0, 1) != "?" {
          return false
        }
        const d = fnDeclIx[nm.slice(1, dot)] ?? -1
        if d < 0 || d >= P.nodes.length || i32ListHas(cstrOwnerStack, d) {
          return false
        }
        return nodeAt(d) is FuncDecl
      }
    }
  }
  false
}

// Is `at` a composite argument whose hole only a pin can decide against the concrete `exp`? A
// function value is its delivery's to adjudicate (`genFnValueCstrs`), and outside every generic
// a hole is such a value's own, so neither is recorded (D3104).
export function compArgCstrOk(at: i32, exp: i32): boolean {
  if at < 0 || at >= T.tys.length { return false }
  const t = tyAt(at)
  if (
    !(t is TyArray || t is TyObj || t is TyMap || t is TyNullable || t is TyUnion)
  ) {
    return false
  }
  if cstrOwnerTop() < 0 && tpEnvNames.length == 0 { return false }
  tyHasHole(at) && !tyHasHole(exp)
}
