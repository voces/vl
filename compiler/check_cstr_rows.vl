// `check_cstr_rows.vl` — the deferred constraints a generic body records for its call sites.
// A body that cannot yet decide an operation over a hole (a binary operator, an argument, a
// return, a `print`, an `is`, a member read, ...) records a bound of the matching kind on its
// owner's `Iface` (`check_iface.vl`), with the delivery it arrived through (`cvMark`); each call
// site re-asks its callee's bounds under its substitution. The `note*Cstr` recorders keep one
// bound per structurally equal constraint of a body, and `tpGradualRecv` records the member read
// a gradual receiver defers to its pin.

import { cstrOwnerStack, tpEnvNames } from "./check_cursor"
import { tpGradualView, tyIsDeferredJoin } from "./check_tp_join"
import { wsVarTy } from "./tyquery"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  tyAt,
  tyElemOf,
  tyEqSameHoles,
  tyHasHole,
  tyHasInferHole,
  tyKeyOf,
  tyPathCycles,
  tyPathWith,
  tyValOf,
} from "./check_types"
import { wsNoteInstErr } from "./check_width"
import { FuncDecl, Ident, P, i32ToStr, nodeAt } from "./ast"
import { i32ListHas } from "./listutil"
import { identFnDeclOf } from "./check_scopes"
import { cwPeel, fnDeclIx } from "./check_write_scan"
import {
  BND_ARG,
  BND_ARRDEF,
  BND_BIN,
  BND_BM,
  BND_IS,
  BND_LET,
  BND_MEM,
  BND_NEST,
  BND_PRINT,
  BND_RET,
  Bound,
  bndAt,
  bndCount,
  bndNoMore,
  bndOwnRows,
  bndPush,
  bndSiteHas,
} from "./check_iface"

// Each `__array_new_default__` list type whose element is a hole, with the call and its owner:
// the pin asks the substituted element for a default, as the direct spelling does (D2578).
export function noteArrDefCstr(listTy: i32, ix: i32) {
  if listTy < 0 { return 0 }
  bndPush(BND_ARRDEF, tyIxBound(listTy, ix, cstrOwnerTop()))
  return 0
}

// The row each type-and-owner key last matched among the `BND_NEST` bounds. A probe's rollback
// can pop that row, so a hit counts only when the row is still there and still matches.
export let nestCstrSeen: {[string]: i32} = Map()

// A list `is` test over a hole or type parameter, per test node: how many pins hand it a list
// whose element is fixed and never meets the tested one (and the first such call), a fixed list
// that meets it, and an open list (and the first such call). Settled at the program's end.
export const listIsPinIx: i32[] = []
export const listIsPinFixed: i32[] = []
export const listIsPinAt: i32[] = []
export const listIsPinMeet: i32[] = []
export const listIsPinOther: i32[] = []
export const listIsPinOtherAt: i32[] = []

// The kinds of pin `listIsPinNote` counts.
export const LIP_APART = 0
export const LIP_MEET = 1
export const LIP_OPEN = 2

// The list a list `is` test reads in operand type `t`: `t` itself, else the one list member of a
// nullable or union; -1 when `t` holds no list or several, whose test keeps its own answer.
export function tySoleListMember(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const u = tyAt(t)
  if u is TyArray { return t }
  if u is TyNullable { return tySoleListMember(u.nInner) }
  if !(u is TyUnion) { return -1 }
  let found = -1
  for m in u.uMembers {
    const ml = tySoleListMember(m)
    if ml >= 0 {
      if found >= 0 { return -1 }
      found = ml
    }
  }
  return found
}

// Each disjoint pin's list row and call, by test node: a row the unbound default settles after
// the pin is an open list, and is re-counted as one at the program's end.
export const listIsApartIx: i32[] = []
export const listIsApartRow: i32[] = []
export const listIsApartCall: i32[] = []

// Counts disjoint pin `call` of list test `ix`, handing list row `row`.
export function listIsApartNote(ix: i32, row: i32, call: i32) {
  listIsApartIx.push(ix)
  listIsApartRow.push(row)
  listIsApartCall.push(call)
  return listIsPinNote(ix, LIP_APART, call)
}

// Each argument a direct call hands a declared function, with the call, its position and that
// function; and each watched list test with the function its body belongs to and the position of
// the parameter it reads (-1 for none). Read at the program's end, when every open list has settled.
export const listCallDecl: i32[] = []
export const listCallArg: i32[] = []
export const listCallPos: i32[] = []
export const listCallIx: i32[] = []
export const listIsOwnNode: i32[] = []
export const listIsOwnDecl: i32[] = []
export const listIsOwnPos: i32[] = []

// Notes that direct call `call` hands function `decl` argument `arg` at position `pos`.
export function listCallNote(call: i32, decl: i32, arg: i32, pos: i32) {
  listCallIx.push(call)
  listCallDecl.push(decl)
  listCallArg.push(arg)
  listCallPos.push(pos)
  return 0
}

// Notes that list test `ix` sits in the body of function `decl`, reading parameter `pos`.
export function listIsOwnerNote(ix: i32, decl: i32, pos: i32) {
  if !i32ListHas(listIsOwnNode, ix) {
    listIsOwnNode.push(ix)
    listIsOwnDecl.push(decl)
    listIsOwnPos.push(pos)
  }
  return 0
}

// Counts pin `call` of list test `ix` as one of the `LIP_*` kinds.
export function listIsPinNote(ix: i32, kind: i32, call: i32) {
  let k = 0
  while k < listIsPinIx.length && listIsPinIx[k] != ix { k = k + 1 }
  if k == listIsPinIx.length {
    listIsPinIx.push(ix)
    listIsPinFixed.push(0)
    listIsPinAt.push(-1)
    listIsPinMeet.push(0)
    listIsPinOther.push(0)
    listIsPinOtherAt.push(-1)
  }
  if kind == LIP_APART {
    listIsPinFixed[k] = listIsPinFixed[k] + 1
    if listIsPinAt[k] < 0 { listIsPinAt[k] = call }
  } else if kind == LIP_MEET {
    listIsPinMeet[k] = listIsPinMeet[k] + 1
  } else {
    listIsPinOther[k] = listIsPinOther[k] + 1
    if listIsPinOtherAt[k] < 0 { listIsPinOtherAt[k] = call }
  }
  return 0
}

// Clears the list-test pins for a new program.
export function listIsPinReset() {
  listIsPinIx.clear()
  listIsPinFixed.clear()
  listIsPinAt.clear()
  listIsPinMeet.clear()
  listIsPinOther.clear()
  listIsPinOtherAt.clear()
  listIsApartIx.clear()
  listIsApartRow.clear()
  listIsApartCall.clear()
  listCallDecl.clear()
  listCallArg.clear()
  listCallPos.clear()
  listCallIx.clear()
  listIsOwnNode.clear()
  listIsOwnDecl.clear()
  listIsOwnPos.clear()
  return 0
}

// A `print`, `__array_new_default__` or nest bound: the type, the node and the owner.
function tyIxBound(ty: i32, ix: i32, fn: i32): Bound {
  return {
    on: ty,
    a: -1,
    b: -1,
    c: -1,
    site: ix,
    fn: fn,
    s: "",
    seq: -1,
    more: bndNoMore,
  }
}

// The body whose constraints are being recorded — the innermost top-level declaration on
// the checking stack, or -1 at module scope.
export function cstrOwnerTop() {
  if cstrOwnerStack.length == 0 { return -1 }
  return cstrOwnerStack[cstrOwnerStack.length - 1]
}

// The constraint tables a demand deferred through a function-value delivery can sit in.
export const CV_BIN = 0
export const CV_PRINT = 1
export const CV_ARG = 2
export const CV_RET = 3
export const CV_LET = 4
export const CV_BM = 5
export const CV_MEM = 6
export const CV_UFCS = 7

// The delivery each deferred row reached its owner through, keyed `row * 16 + table`: the
// delivered generic's name node, so the pin's refusal names the delivery as well (D3923).
export let cvViaAt: {[i32]: i32} = Map()

// The delivery the demand being recorded or re-asked arrived through, -1 for none.
export let cvNow = -1

// Stamps row `row` of table `tbl`, just appended, with the delivery in force.
export function cvMark(tbl: i32, row: i32) {
  const k = row * 16 + tbl
  if cvNow >= 0 || cvViaAt.has(k) { cvViaAt[k] = cvNow }
  return 0
}

// The delivery row `row` of table `tbl` came through, else `outer`.
export function cvPick(tbl: i32, row: i32, outer: i32): i32 {
  const v = cvViaAt[row * 16 + tbl] ?? -1
  if v >= 0 { return v }
  return outer
}

// Records a deferred binary-op constraint when either operand is a hole — the body can't
// yet decide the operator's form, so the generic call site validates it under substitution.
// Stamped with the owning declaration, since a `T` in some other generic is a different `T`
// even though `substTyDeep` matches on the name.
export function noteBinCstr(lt: i32, op: string, rt: i32) {
  return noteBinCstrAt(lt, op, rt, -1, -1)
}

// `noteBinCstr` written at the `BinExpr` `node` of literal shape `shape` (-1 for none). Rows
// of one body differing in shape stay apart, since a literal operand adapts where a variable
// does not.
export function noteBinCstrAt(
  lt: i32,
  op: string,
  rt: i32,
  node: i32,
  shape: i32,
) {
  if tyHasHole(lt) || tyHasHole(rt) {
    const owner = cstrOwnerTop()
    // An identity comparison of a rewritten parameter would compare two struct types.
    if (op == "==" || op == "!=") && (wsVarTy(lt) || wsVarTy(rt)) {
      wsNoteInstErr(owner)
    }
    // A structurally equal constraint of the same body is the same constraint: a call's
    // substitution mints fresh arena copies, and keying on the index alone let each copy of a
    // callee's constraints re-record in every caller, exponential over a cycle of generics (D2757).
    for k in bndOwnRows(BND_BIN, owner) {
      const b = bndAt(BND_BIN, k)
      if (
        b.s == op
        && b.b == shape
        && (op != "as" || b.site == node)
        && tyEqSameHoles(b.on, lt)
        && tyEqSameHoles(b.a, rt)
      ) {
        return 0
      }
    }
    const row: Bound = {
      on: lt,
      a: rt,
      b: shape,
      c: -1,
      site: node,
      fn: owner,
      s: op,
      seq: -1,
      more: bndNoMore,
    }
    cvMark(CV_BIN, bndPush(BND_BIN, row))
  }
  return 0
}

// Records a deferred call-argument constraint: hole-typed argument `at` flowed into the
// concrete param type `exp` of callee `who`. Idempotent per `(at, exp)` and argument node, since
// a literal and a value of one type answer apart. A deferred-join `exp` is not recorded; it
// surfaces through the enclosing body's own hole bindings instead.
export function noteArgCstr(
  at: i32,
  exp: i32,
  who: string,
  form: i32,
  node: i32,
) {
  return noteArgCstrAt(at, exp, who, form, node, -1)
}

// `noteArgCstr` for argument node `from` of a hole argument, a row that keeps no node of its own.
export function noteArgCstrFrom(
  at: i32,
  exp: i32,
  who: string,
  form: i32,
  from: i32,
) {
  return noteArgCstrRow(at, exp, who, form, -1, -1, from)
}

// The argument node a `BND_ARG` row came from: its site, else the node
// `noteArgCstrFrom` noted, else -1.
export function argCstrFromOf(ci: i32): i32 {
  const s = bndAt(BND_ARG, ci).site
  if s >= 0 { return s }
  return if ci >= 0 && ci < bndArgFrom.length { bndArgFrom[ci] } else { -1 }
}

// Per `BND_ARG` row, the argument node `noteArgCstrFrom` noted; every push writes its own entry,
// so a row a probe rolled back leaves none behind.
let bndArgFrom: i32[] = []
export function bndArgFromReset() { return bndArgFrom = [] }

// `noteArgCstr` for an argument of hole call `call`, which the bound keeps (`b`).
export function noteArgCstrAt(
  at: i32,
  exp: i32,
  who: string,
  form: i32,
  node: i32,
  call: i32,
) {
  return noteArgCstrRow(at, exp, who, form, node, call, -1)
}

function noteArgCstrRow(
  at: i32,
  exp: i32,
  who: string,
  form: i32,
  node: i32,
  call: i32,
  from: i32,
) {
  if tyIsDeferredJoin(exp) { return 0 }
  const owner = cstrOwnerTop()
  for k in bndOwnRows(BND_ARG, owner) {
    const b = bndAt(BND_ARG, k)
    if (
      b.c == form
      && b.site == node
      && b.b == call
      && tyEqSameHoles(b.on, at)
      && tyEqSameHoles(b.a, exp)
    ) {
      return 0
    }
  }
  const row: Bound = {
    on: at,
    a: exp,
    b: call,
    c: form,
    site: node,
    fn: owner,
    s: who,
    seq: -1,
    more: bndNoMore,
  }
  const ci = bndPush(BND_ARG, row)
  while bndArgFrom.length <= ci { bndArgFrom.push(-1) }
  bndArgFrom[ci] = from
  cvMark(CV_ARG, ci)
  return 0
}

// Records a deferred `print` constraint when the printed type still carries a hole, so the
// generic call site adjudicates the printed rep under substitution. Stamped with the owning
// declaration for the same by-name `TyVar` reason `noteBinCstr` needs it — an unscoped list
// would make every `<T>` in the program share one namespace.
export function notePrintCstr(pt: i32, argIx: i32) {
  if pt < 0 { return 0 }
  if tyHasHole(pt) {
    const owner = cstrOwnerTop()
    for k in bndOwnRows(BND_PRINT, owner) {
      const b = bndAt(BND_PRINT, k)
      if b.site == argIx && tyEqSameHoles(b.on, pt) { return 0 }
    }
    cvMark(CV_PRINT, bndPush(BND_PRINT, tyIxBound(pt, argIx, owner)))
  }
  return 0
}

// Records an `is` test of a record type whose operand type `ot` carries a hole, once per owner
// and node (D3109).
export function noteIsCstr(ot: i32, chk: i32, name: string, ix: i32) {
  if chk < 0 || !(tyAt(chk) is TyObj || tyAt(chk) is TyArray) { return 0 }
  const owner = cstrOwnerTop()
  for k in bndOwnRows(BND_IS, owner) {
    const b = bndAt(BND_IS, k)
    if b.site == ix && tyEqSameHoles(b.on, ot) { return 0 }
  }
  bndPush(
    BND_IS,
    {
      on: ot,
      a: chk,
      b: -1,
      c: -1,
      site: ix,
      fn: owner,
      s: name,
      seq: -1,
      more: bndNoMore,
    },
  )
  return 0
}

// Records a deferred return-type constraint when either side carries a hole — the body
// cannot decide it then. The generic call site re-asks it under substitution, stamped with
// the owning declaration for the same reason `noteBinCstr` is: an unowned list would let
// one generic's declared return adjudicate a sibling's call.
export function noteRetCstr(got: i32, want: i32, ix: i32) {
  const gotHole = tyHasHole(got)
  if gotHole || tyHasHole(want) {
    const owner = cstrOwnerTop()
    for k in bndOwnRows(BND_RET, owner) {
      const b = bndAt(BND_RET, k)
      if tyEqSameHoles(b.on, got) && tyEqSameHoles(b.a, want) { return 0 }
    }
    const wOnly = if gotHole { 0 } else { 1 }
    const row: Bound = {
      on: got,
      a: want,
      b: wOnly,
      c: -1,
      site: ix,
      fn: owner,
      s: "",
      seq: -1,
      more: bndNoMore,
    }
    cvMark(CV_RET, bndPush(BND_RET, row))
  }
  return 0
}

// Records a deferred builtin-method argument constraint when either side carries a hole —
// the body cannot decide it then. The generic call site re-asks it under substitution,
// stamped with the owning declaration for the same reason `noteBinCstr` is.
export function noteBmCstr(
  form: i32,
  label: string,
  got: i32,
  want: i32,
  ctx: i32,
  argIx: i32,
) {
  if tyHasHole(got) || tyHasHole(want) {
    const owner = cstrOwnerTop()
    for k in bndOwnRows(BND_BM, owner) {
      const b = bndAt(BND_BM, k)
      if (
        b.c == form
        && b.s == label
        && tyEqSameHoles(b.on, got)
        && tyEqSameHoles(b.a, want)
      ) {
        return 0
      }
    }
    const row: Bound = {
      on: got,
      a: want,
      b: ctx,
      c: form,
      site: argIx,
      fn: owner,
      s: label,
      seq: -1,
      more: bndNoMore,
    }
    cvMark(CV_BM, bndPush(BND_BM, row))
  }
  return 0
}

// The `BND_MEM` spelling of a layout constant `T.member` in a generic body, before `T.member`.
export const MC_LAYOUT_MARK = "#layout:"

// Records a deferred receiver-classification constraint when the receiver still carries a
// hole, so the generic call site re-asks whether `T` is a collection under substitution.
// Stamped with the owning declaration — `substTyDeep` matches `TyVar`s by name, so an
// unowned row would let one generic's `.length` adjudicate a sibling's call.

export function noteMemCstr(recv: i32, prop: string, ix: i32, dem: boolean) {
  if recv < 0 { return 0 }
  if tyHasHole(recv) {
    const owner = cstrOwnerTop()
    const callee = memCalleeIs(ix)
    for k in bndOwnRows(BND_MEM, owner) {
      const b = bndAt(BND_MEM, k)
      if (
        b.s == prop
        && tyEqSameHoles(b.on, recv)
        && memCalleeIs(b.site) == callee
      ) {
        return 0
      }
    }
    const row: Bound = {
      on: recv,
      a: if dem { 1 } else { 0 },
      b: -1,
      c: -1,
      site: ix,
      fn: owner,
      s: prop,
      seq: -1,
      more: bndNoMore,
    }
    cvMark(CV_MEM, bndPush(BND_MEM, row))
  }
  return 0
}

// The member nodes that are a member call's callee: the pin may answer such a site with the
// receiver type's own `self`-function, which a plain read of the same name never reaches.
export let memCalleeAt: {[i32]: i32} = Map()

export function memCalleeMark(ix: i32) {
  if ix >= 0 { memCalleeAt[ix] = 1 }
  return 0
}

export function memCalleeIs(ix: i32): boolean { return memCalleeAt.has(ix) }

// The receiver a member or index read of `recv` is checked at: a gradual union's concrete
// member, the read recorded for the pin to re-ask against the whole union. `recv` otherwise.
export function tpGradualRecv(recv: i32, prop: string, ix: i32): i32 {
  const v = tpGradualView(recv)
  if v == recv || v < 0 || tyAt(v) is TyUnion { return recv }
  noteMemCstr(recv, prop, ix, false)
  return v
}

// A generic body's container over a type parameter (`[x, x]` at `x: T`) has no vector in it
// until a call binds `T`, so the type and node are recorded, owned by the enclosing
// declaration, and `nestRule` asks again at each pin (the `print` constraint's shape).
export function noteNestCstr(t: i32, ix: i32) {
  if t < 0 || cstrOwnerStack.length == 0 { return 0 }
  const tt = tyAt(t)
  let composite = false
  if tt is TyArray { composite = true }
  if tt is TyObj { composite = true }
  if tt is TyNullable { composite = true }
  if tt is TyUnion { composite = true }
  if tt is TyMap { composite = true }
  if !composite { return 0 }
  if !tyHasHole(t) { return 0 }
  const owner = cstrOwnerTop()
  const key = i32ToStr(t) + ":" + i32ToStr(owner)
  const seen = nestCstrSeen.get(key) ?? -1
  if seen >= 0 && seen < bndCount(BND_NEST) {
    const b = bndAt(BND_NEST, seen)
    if b.fn == owner && tyEqSameHoles(b.on, t) { return 0 }
  }
  for k in bndOwnRows(BND_NEST, owner) {
    if tyEqSameHoles(bndAt(BND_NEST, k).on, t) {
      nestCstrSeen.set(key, k)
      return 0
    }
  }
  nestCstrSeen.set(key, bndPush(BND_NEST, tyIxBound(t, ix, owner)))
  return 0
}

// Records a deferred destination constraint when either side carries a hole — the body
// cannot decide it then. Stamped with the owning declaration, for the same reason
// `noteBinCstr` is. No `wOnly` column: that column exists at the return seam only to gate
// D561's newtype exemption, and this seam has no exemption to gate.
export function noteLetCstr(got: i32, want: i32, ix: i32, name: string) {
  if tyHasHole(got) || tyHasHole(want) {
    const owner = cstrOwnerTop()
    // Outside every generic, a type parameter can only be a generic function value's own, which
    // its delivery binds and adjudicates (`genFnValueCstrs`); a row would be re-asked of every
    // later generic call whose parameter shares the name (D3104).
    if owner < 0 && tpEnvNames.length == 0 {
      if !tyHasInferHole(got) && !tyHasInferHole(want) { return 0 }
      // A top-level function named as the value has only its own holes, which the delivery
      // checked its body at; a row would be re-asked of every later call of it (D5972).
      if !tyHasHole(want) && namesTopFnDecl(ix) { return 0 }
      // So does one held in a literal or handed back by a call: every hole rides such a
      // function's own signature, which the delivery judged against `want` (D9031).
      if !tyHasHole(want) && tyHolesOnlyInTopFnSigs(got) { return 0 }
    }
    letCstrRow(got, want, ix, name, owner)
  }
  return 0
}

// The owner of a row that only a delivery of its binding judges; no call owns it.
export const CSTR_DELIVERY_ONLY = -3

// `noteLetCstr` for a value written into an element of a `let`/`const` binding, kept outside
// every generic too: a delivery of the binding at a closed element type judges it (D10122).
export function noteElemLetCstr(got: i32, want: i32, ix: i32, name: string) {
  if cstrOwnerTop() >= 0 || tpEnvNames.length > 0 {
    return noteLetCstr(got, want, ix, name)
  }
  if tyHasHole(got) || tyHasHole(want) {
    if !bndSiteHas(BND_LET, ix) {
      letCstrPush(got, want, ix, name, CSTR_DELIVERY_ONLY)
    }
  }
  return 0
}

// Appends the `BND_LET` bound unless `owner` already holds the same one.
function letCstrRow(got: i32, want: i32, ix: i32, name: string, owner: i32) {
  for k in bndOwnRows(BND_LET, owner) {
    const b = bndAt(BND_LET, k)
    if tyEqSameHoles(b.on, got) && tyEqSameHoles(b.a, want) { return 0 }
  }
  letCstrPush(got, want, ix, name, owner)
  return 0
}

function letCstrPush(got: i32, want: i32, ix: i32, name: string, owner: i32) {
  const row: Bound = {
    on: got,
    a: want,
    b: -1,
    c: -1,
    site: ix,
    fn: owner,
    s: name,
    seq: -1,
    more: bndNoMore,
  }
  cvMark(CV_LET, bndPush(BND_LET, row))
  return 0
}

// Whether the value at `ix` is a name resolving to a module-scope function declaration.
function namesTopFnDecl(ix: i32): boolean {
  const v = cwPeel(ix)
  if v < 0 || v >= P.nodes.length { return false }
  const n = nodeAt(v)
  if !(n is Ident) { return false }
  const d = identFnDeclOf(v)
  return d >= 0 && (fnDeclIx[n.identName] ?? -1) == d
}

// Whether every hole in `ty` sits inside the open signature of a top-level function with an
// un-annotated parameter whose body is not being checked; false at the depth floor.
function tyHolesOnlyInTopFnSigs(ty: i32): boolean {
  const path: i32[] = []
  return tyHolesOnlyInTopFnSigsIn(ty, path)
}

function tyHolesOnlyInTopFnSigsIn(ty: i32, path: i32[]): boolean {
  if tyPathCycles(ty, path) { return false }
  const sub = tyPathWith(ty, path)
  if ty < 0 || ty >= T.tys.length { return false }
  if !tyHasHole(ty) { return true }
  const t = tyAt(ty)
  return match t {
    TyFunc => {
      if fnTyIsTopHoleSig(t) { return true }
      for p in t.fnParamTypes {
        if !tyHolesOnlyInTopFnSigsIn(p, sub) { return false }
      }
      tyHolesOnlyInTopFnSigsIn(t.fnRet, sub)
    }
    TyArray => tyHolesOnlyInTopFnSigsIn(tyElemOf(t), sub)
    TyNullable => tyHolesOnlyInTopFnSigsIn(t.nInner, sub)
    TyMap => {
      tyHolesOnlyInTopFnSigsIn(tyKeyOf(t), sub)
        && tyHolesOnlyInTopFnSigsIn(tyValOf(t), sub)
    }
    TyObj => {
      for f in t.objFieldTypes {
        if !tyHolesOnlyInTopFnSigsIn(f, sub) { return false }
      }
      true
    }
    TyUnion => {
      for m in t.uMembers {
        if !tyHolesOnlyInTopFnSigsIn(m, sub) { return false }
      }
      true
    }
    TyNeg => tyHolesOnlyInTopFnSigsIn(t.negTy, sub)
    TyVar | TyPrim | TyErr | TyLit => false
  }
}

// Whether function type `f` is a top-level function's own open signature: its first hole
// parameter is named for a declaration (`?name.k`) that is not on the constraint-owner stack.
function fnTyIsTopHoleSig(f: TyFunc): boolean {
  for p in f.fnParamTypes {
    if p >= 0 && p < T.tys.length {
      const pv = tyAt(p)
      if pv is TyVar {
        const nm = pv.tvName
        const dot = nm.indexOf(".")
        if nm.slice(0, 2) == "?#" || dot < 2 || nm.slice(0, 1) != "?" {
          return false
        }
        const d = fnDeclIx[nm.slice(1, dot)] ?? -1
        if d < 0 || d >= P.nodes.length || i32ListHas(cstrOwnerStack, d) {
          return false
        }
        return nodeAt(d) is FuncDecl
      }
    }
  }
  return false
}

// Is `at` a composite argument whose hole only a pin can decide against the concrete `exp`? A
// function value is its delivery's to adjudicate (`genFnValueCstrs`), and outside every generic
// a hole is such a value's own, so neither is recorded (D3104).
export function compArgCstrOk(at: i32, exp: i32): boolean {
  if at < 0 || at >= T.tys.length { return false }
  const t = tyAt(at)
  if (
    !(t is TyArray || t is TyObj || t is TyMap || t is TyNullable || t is TyUnion)
  ) {
    return false
  }
  if cstrOwnerTop() < 0 && tpEnvNames.length == 0 { return false }
  return tyHasHole(at) && !tyHasHole(exp)
}
