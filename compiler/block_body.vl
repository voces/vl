// A function's block body returns a value only through `return` (DECISIONS, "A function's block
// body returns a value only through `return`"): its last statement is a statement, while an
// expression body's one statement is its value. Braces after a signature are always a block.
import { Block, P, nodeAt } from "./ast"

// Whether `b` is a block body, written in braces, not the one-statement body of an expression.
export function isBlockBody(b: i32): boolean {
  if b < 0 || b >= P.nodes.length { return false }
  const n = nodeAt(b)
  if n is Block { return n.pos >= 0 }
  return false
}

// The token a `return` goes before for a statement whose node starts at `tok`: its label and
// any parentheses that open it come first (`@l while`, `(k)`).
export function stmtStartTok(tok: i32): i32 {
  let t = tok
  while (
    t > 0
    && t < P.toks.length
    && (P.toks[t - 1].kind == "LPAREN" || P.toks[t - 1].kind == "LABEL")
  ) {
    t = t - 1
  }
  return t
}
