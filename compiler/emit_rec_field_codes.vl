// The field code of a declared record's field, read from the field's checked type: the shared
// producer (`nameFieldCodeTy`) with one deviation. A record or nullable record field codes as a
// struct before its row exists, since `collectS` codes a declaration before the record it names,
// or the generic instance, has a row; an anonymous row must decline there instead (D15156).
import { T, TyNullable, TyObj, TyUnion, tyAt } from "./check_types"
import { FC_STRUCT } from "./emit_state"
import { nameFieldCodeTy } from "./emit_shape_intern"

// The type of record `rec`'s field `nm`, or -1 when `rec` is not a record or has no such field.
export function recFieldTyOf(rec: i32, nm: string): i32 {
  if rec < 0 || rec >= T.tys.length { return -1 }
  const t = tyAt(rec)
  if !(t is TyObj) { return -1 }
  let i = 0
  while i < t.objFieldNames.length {
    if t.objFieldNames[i] == nm { return t.objFieldTypes[i] }
    i = i + 1
  }
  -1
}

// The field code for a declared field of type `ty` spelled `spell`, or -1 when it has none.
export function fieldCodeOfRecField(spell: string, ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  if t is TyObj { return FC_STRUCT }
  if t is TyNullable && rfcIsRecord(rfcPeelOne(t.nInner)) { return FC_STRUCT }
  nameFieldCodeTy(spell, ty)
}

// Whether `ty` is a record.
function rfcIsRecord(ty: i32): boolean {
  ty >= 0 && ty < T.tys.length && tyAt(ty) is TyObj
}

// `ty` with a one-member union alias peeled.
function rfcPeelOne(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  if t is TyUnion && t.uMembers.length == 1 { return t.uMembers[0] }
  ty
}
