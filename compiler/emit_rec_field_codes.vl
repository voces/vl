// The type of a declared record's field, read from the record's checked type, for `collectS` to
// code the field with the shared producer (`nameFieldCodeTy`), and the type the field is stored at.
import {
  T,
  TY_STR,
  TyObj,
  mkNullableTyOf,
  strLitAsSet,
  tyAt,
  tyIsLitUnion,
} from "./check_types"
import { FC_STR, FC_STRUCT } from "./emit_state"

// The type of record `rec`'s field `nm`, or -1 when `rec` is not a record or has no such field.
export function recFieldTyOf(rec: i32, nm: string): i32 {
  if rec < 0 || rec >= T.tys.length { return -1 }
  const t = tyAt(rec)
  if !(t is TyObj) { return -1 }
  let i = 0
  while i < t.objFieldNames.length {
    if t.objFieldNames[i] == nm { return t.objFieldTypes[i] }
    i = i + 1
  }
  -1
}

// A field's storage type from its code and declared type, or -1 when the type is unknown: code 15
// stores a record field nullable whatever it declares, a string literal field the string slot
// holds is a `string`, and a lone string literal is otherwise its one-member set, the atom (D7220).
export function fieldStoreTyOf(code: i32, declTy: i32): i32 {
  if declTy < 0 { return -1 }
  if code == FC_STRUCT { return mkNullableTyOf(declTy) }
  const st = strLitAsSet(declTy)
  if code == FC_STR && tyIsLitUnion(st) { return TY_STR }
  st
}

// The storage type of record type `rec`'s field `nm` at code `code`, or -1 when either is unknown.
export function recFieldStoreTyOf(rec: i32, nm: string, code: i32): i32 {
  fieldStoreTyOf(code, recFieldTyOf(rec, nm))
}
