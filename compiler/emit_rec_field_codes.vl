// The field code of a declared record's field, read from the field's checked type: the rules
// the anonymous-row producer (`nameFieldCodeTy`) lacks, ahead of it. Asked while `collectS`
// registers declarations, so a record field codes as a struct before its row exists.
import {
  T,
  TyArray,
  TyLit,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  tyAt,
} from "./check_types"
import { FC_I32, FC_I32_LIST, FC_NUL_I32_LIST, FC_STRUCT } from "./emit_state"
import { nameFieldCodeTy } from "./emit_shape_intern"

// The type of record `rec`'s field `nm`, or -1 when `rec` is not a record or has no such field.
export function recFieldTyOf(rec: i32, nm: string): i32 {
  if rec < 0 || rec >= T.tys.length { return -1 }
  const t = tyAt(rec)
  if !(t is TyObj) { return -1 }
  let i = 0
  while i < t.objFieldNames.length {
    if t.objFieldNames[i] == nm { return t.objFieldTypes[i] }
    i = i + 1
  }
  -1
}

// The field code for a field of type `ty` spelled `spell`, or -1 when it has none.
export function fieldCodeOfRecField(spell: string, ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  // A single string literal is stored as its interned atom.
  if t is TyLit && t.litKind == "str" { return FC_I32 }
  if t is TyObj { return FC_STRUCT }
  if t is TyNullable {
    const inner = rfcPeelOne(t.nInner)
    if inner >= 0 && inner < T.tys.length && tyAt(inner) is TyObj {
      return FC_STRUCT
    }
    if rfcIsI32List(inner) { return FC_NUL_I32_LIST }
  }
  if t is TyArray && rfcIsIntLitUnion(t.aElem) { return FC_I32_LIST }
  nameFieldCodeTy(spell, ty)
}

// Whether `ty` stores as an `i32` list: a list of `i32`, `boolean` or integer literals, or a
// union whose members all do.
function rfcIsI32List(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyUnion {
    if t.uMembers.length < 1 { return false }
    for m in t.uMembers {
      if !rfcIsI32List(m) { return false }
    }
    return true
  }
  if !(t is TyArray) { return false }
  const e = t.aElem
  if e < 0 || e >= T.tys.length { return false }
  if rfcIsIntLitUnion(e) { return true }
  const et = tyAt(e)
  et is TyPrim && (et.primName == "i32" || et.primName == "boolean")
}

// Whether `ty` is a union of integer literals, stored as `i32`.
function rfcIsIntLitUnion(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if !(t is TyUnion) || t.uMembers.length < 1 { return false }
  for m in t.uMembers {
    if m < 0 || m >= T.tys.length { return false }
    const mt = tyAt(m)
    if !(mt is TyLit) || mt.litKind != "int" { return false }
  }
  true
}

// `ty` with a one-member union alias peeled.
function rfcPeelOne(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  if t is TyUnion && t.uMembers.length == 1 { return t.uMembers[0] }
  ty
}
