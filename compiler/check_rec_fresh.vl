// Where a delivered record comes from: the literal it names through un-annotated bindings,
// aliases and calls, and whether such a binding is ever reassigned.
// Does not import the checker.
import {
  ArrayLit,
  BinExpr,
  Call,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  ObjLit,
  P,
  callHasTyArgs,
  nodeAt,
} from "./ast"
import { parenPeelIx } from "./check_places"
import {
  recBindDeclOf,
  recDeclInit,
  recIndexBase,
  recPassThroughArg,
  recSolePinArg,
} from "./check_record_origins"
import { identBoundFnDeclOf } from "./check_scopes"
import { tailValueLeaves } from "./check_unconsumed"
import {
  CW_OCC_ASG,
  cwIxBuild,
  cwIxKind,
  cwIxNode,
  cwKeyOfRoot,
  cwOccNext,
  cwOccWalk,
  cwPeel,
  cwPeelValue,
} from "./check_write_scan"

// Where a delivered record comes from: an object or list literal it names through un-annotated
// bindings that hold only that literal and generic identities, or itself. A call that writes
// its type arguments builds the value at them, so it is the origin (D8022). -1 stays -1.
export function recOriginExpr(expr: i32): i32 {
  if expr < 0 { return -1 }
  let x = cwPeelValue(expr)
  let hops = 0
  while hops < 16 {
    if x < 0 || x >= P.nodes.length { return -1 }
    const e = nodeAt(x)
    if e is Ident {
      const init = recHeldLit(x)
      if init < 0 { return x }
      x = cwPeelValue(init)
      hops = hops + 1
      continue
    }
    const pass = if callHasTyArgs(x) { -1 } else { recPassThroughArg(x) }
    if pass >= 0 {
      x = cwPeelValue(pass)
      hops = hops + 1
      continue
    }
    return x
  }
  x
}

// The values `x` evaluates to: each tail of a value `if`, `match` or block, followed through
// un-annotated bindings that hold only their initializer into its tails. `via[i]` is the
// binding read that last reached `out[i]`, or -1; a -1 leaf means the walk gave up, and whether
// a leaf is a fresh literal is the caller's test.
export function recValueOrigins(x: i32, via: i32[]): i32[] {
  const out: i32[] = []
  const todo: i32[] = [x]
  const todoVia: i32[] = [-1]
  let guard = 0
  while todo.length > 0 {
    guard = guard + 1
    const at = todo.pop() ?? -1
    const av = todoVia.pop() ?? -1
    if guard > 64 {
      out.push(-1)
      via.push(av)
      return out
    }
    const tails: i32[] = []
    tailValueLeaves(at, tails)
    for lf in tails {
      const p = cwPeelValue(lf)
      const d = if p >= 0 && p < P.nodes.length { recHeldDecl(p) } else { -1 }
      if d >= 0 {
        todo.push(recDeclInit(d))
        todoVia.push(p)
      } else {
        out.push(p)
        via.push(av)
      }
    }
  }
  out
}

// What the read `x` names through un-annotated bindings that hold only their initializer: the
// first value that is not such a read, or `x` itself. -1 stays -1.
export function recBindOrigin(x: i32): i32 {
  let o = cwPeelValue(x)
  let hops = 0
  while o >= 0 && o < P.nodes.length && hops < 16 && nodeAt(o) is Ident {
    const init = recHeldLit(o)
    if init < 0 { return o }
    o = cwPeelValue(init)
    hops = hops + 1
  }
  o
}

// The call or element read the binding read `x` holds through such bindings (`recBindOrigin`),
// which a delivery of `x` delivers as it would that origin (D8140); -1 when it holds neither.
export function recHeldCallOrigin(x: i32): i32 {
  const oc = recBindOrigin(x)
  if oc < 0 || oc == cwPeelValue(x) { return -1 }
  if nodeAt(oc) is Call || nodeAt(oc) is Index { oc } else { -1 }
}

// The declaration of the un-annotated `let` or `const` the read `x` names, when it holds only
// its initializer (a `let` is assigned nothing but object literals), else -1.
// Read off the binder's declaration column, so a walk after the check answers alike.
export function recHeldDecl(x: i32): i32 {
  const e = nodeAt(x)
  if e is Ident {
    const d = recBindDeclOf(x)
    if d < 0 { return -1 }
    const dn = nodeAt(d)
    if dn is LetDecl {
      if dn.letType >= 0 || dn.letInit < 0 { return -1 }
      if dn.letKw == "const" { return d }
      if recBindReassigned(cwKeyOfRoot(x)) { return -1 }
      return d
    }
  }
  -1
}

// The initializer of `recHeldDecl`'s declaration, or -1.
export function recHeldLit(x: i32): i32 {
  const d = recHeldDecl(x)
  if d < 0 { return -1 }
  const dn = nodeAt(d)
  if dn is LetDecl { return dn.letInit }
  -1
}

// Is the binding keyed `k` (`cwKeyOfRoot`) the target of a whole assignment of anything but an object literal,
// so it may hold a value other than a literal?
function recBindReassigned(k: i32): boolean {
  if k == -1 { return true }
  cwIxBuild()
  const ow = cwOccWalk(k)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_ASG && !recAsgStoresLit(cwIxNode[r]) {
      return true
    }
  }
  false
}

// How deep `recAsgStoresLit` has followed stores into bindings that are themselves stored into.
let recAsgDepth = 0

// Does the whole assignment at `a` store an object literal, written there or held by a binding?
function recAsgStoresLit(a: i32): boolean {
  if a < 0 || a >= P.nodes.length || recAsgDepth > 4 { return false }
  const n = nodeAt(a)
  if n is BinExpr {
    recAsgDepth = recAsgDepth + 1
    const o = recOriginExpr(n.binRight)
    recAsgDepth = recAsgDepth - 1
    return o >= 0 && nodeAt(o) is ObjLit
  }
  false
}

// The declaration of the function the call `x` names, when it declares no result and no type
// parameter, so its result is built where the call delivers it; -1 otherwise.
export function recInferredFnOf(x: i32): i32 {
  const c = nodeAt(x)
  if c is Call && c.callFn >= 0 {
    const cn = nodeAt(c.callFn)
    if cn is Ident {
      let fd = identBoundFnDeclOf(c.callFn)
      if fd < 0 { fd = cwPeel(recHeldLit(c.callFn)) }
      if fd >= 0 && fd < P.nodes.length {
        const f = nodeAt(fd)
        if f is FuncDecl {
          if f.fnRet < 0 && f.fnTyParams.length == 0 { return fd }
        }
      }
    }
  }
  -1
}

// The fresh binding or function that `x` reads, through un-annotated aliases, a call or an
// element of a list literal binding; -1 for any other value.
export function recFreshOriginDecl(x: i32, depth: i32): i32 {
  if depth <= 0 { return -1 }
  const p = cwPeelValue(x)
  if p < 0 || p >= P.nodes.length { return -1 }
  const fd = recInferredFnOf(p)
  if fd >= 0 { return fd }
  const ib = recIndexBase(p)
  if ib >= 0 { return recFreshOriginDecl(ib, depth - 1) }
  const d = recHeldDecl(p)
  if d < 0 { return -1 }
  const init = cwPeel(recDeclInit(d))
  if init < 0 || init >= P.nodes.length { return -1 }
  const iv = nodeAt(init)
  if iv is ObjLit || iv is ArrayLit { return d }
  recFreshOriginDecl(init, depth - 1)
}

// The declaration of the binding the read `at` names, when it holds only an object literal or
// a list literal. -1 otherwise.
export function recFreshDeclOf(at: i32): i32 {
  const init = recHeldLit(at)
  if init < 0 { return -1 }
  const iv = nodeAt(parenPeelIx(init))
  if iv is ObjLit || iv is ArrayLit { return recHeldDecl(at) }
  -1
}

// The declaration of the binding the read `at` names, when it holds only the empty `Map()` it
// is initialised with, so each value it holds is one a store put there. -1 otherwise.
export function recFreshMapDeclOf(at: i32): i32 {
  const init = recHeldLit(at)
  if init < 0 { return -1 }
  const ci = parenPeelIx(init)
  if ci < 0 || ci >= P.nodes.length { return -1 }
  const c = nodeAt(ci)
  if c is Call {
    if c.callArgs.length > 0 || c.callFn < 0 || callHasTyArgs(ci) { return -1 }
    const f = nodeAt(c.callFn)
    if f is Ident {
      if f.identName == "Map" && identBoundFnDeclOf(c.callFn) < 0 {
        return recHeldDecl(at)
      }
    }
  }
  -1
}

// The declaration of the binding the read `at` names, when it holds a generic call that hands
// back an object literal its argument alone pins (`recSolePinArg`), at any depth. -1 otherwise.
export function recPassLitDeclOf(at: i32): i32 {
  const init = recHeldLit(at)
  if init < 0 { return -1 }
  let x = cwPeelValue(init)
  if x < 0 || x >= P.nodes.length || recSolePinArg(x) < 0 { return -1 }
  let hops = 0
  while x >= 0 && hops < 16 && recSolePinArg(x) >= 0 {
    x = cwPeelValue(recSolePinArg(x))
    hops = hops + 1
  }
  if x >= 0 && x < P.nodes.length && nodeAt(x) is ObjLit {
    return recHeldDecl(at)
  }
  -1
}
