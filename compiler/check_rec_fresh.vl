// Where a delivered record comes from: the literal it names through un-annotated bindings,
// aliases and calls, and whether such a binding is ever reassigned.
// Does not import the checker.
import { i32ListHas } from "./listutil"
import {
  ArrayLit,
  BinExpr,
  Block,
  BoolLit,
  Call,
  FieldInit,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  LetDecl,
  MatchExpr,
  Node,
  NumLit,
  ObjLit,
  P,
  Param,
  StrLit,
  TypeRef,
  callHasTyArgs,
  letInitAt,
  nodeAt,
  tailValueLeaves,
} from "./ast"
import { parenPeelIx } from "./check_places"
import {
  recBindDeclOf,
  recIndexBase,
  recMapCtorCall,
  recPassThroughArg,
  recSolePinArg,
} from "./check_record_origins"
import { identBoundFnDeclOf } from "./check_scopes"
import { identDeclOf } from "./symbols"
import { a20RetWalk } from "./check_nj_gate"
import { rcwCallSites } from "./check_record_writes"
import {
  CW_OCC_ASG,
  CW_OCC_BIND,
  CW_OCC_USE,
  CW_UP_ARG,
  CW_UP_ASG_RHS,
  CW_UP_CMP,
  CW_UP_ELEM,
  CW_UP_FIELD,
  CW_UP_IS,
  CW_UP_LETINIT,
  CW_UP_OBJ,
  CW_UP_RET,
  cwFnDeclAt,
  cwIxBuild,
  cwIxCovers,
  cwIxKind,
  cwIxNode,
  cwIxParent,
  cwIxUp,
  cwIxUpAux,
  cwIxUpKind,
  cwKeyOfDecl,
  cwKeyOfRoot,
  cwOccNext,
  cwOccWalk,
  cwPeel,
  cwPeelValue,
} from "./check_write_scan"

// Where a delivered record comes from: an object or list literal it names through un-annotated
// bindings that hold only that literal and generic identities, or itself. A call that writes
// its type arguments builds the value at them, so it is the origin (D8022). -1 stays -1.
export function recOriginExpr(expr: i32): i32 {
  if expr < 0 { return -1 }
  let x = cwPeelValue(expr)
  let hops = 0
  while hops < 16 {
    if x < 0 || x >= P.nodes.length { return -1 }
    const e = nodeAt(x)
    if e is Ident {
      const init = recHeldLit(x)
      if init < 0 { return x }
      x = cwPeelValue(init)
      hops = hops + 1
      continue
    }
    const pass = if callHasTyArgs(x) { -1 } else { recPassThroughArg(x) }
    if pass >= 0 {
      x = cwPeelValue(pass)
      hops = hops + 1
      continue
    }
    return x
  }
  return x
}

// The values `x` evaluates to: each tail of a value `if`, `match` or block, followed through
// un-annotated bindings that hold only their initializer into its tails. `via[i]` is the
// binding read that last reached `out[i]`, or -1; a -1 leaf means the walk gave up, and whether
// a leaf is a fresh literal is the caller's test.
export function recValueOrigins(x: i32, via: i32[]): i32[] {
  const out: i32[] = []
  const todo: i32[] = [x]
  const todoVia: i32[] = [-1]
  let guard = 0
  while todo.length > 0 {
    guard = guard + 1
    const at = todo.pop() ?? -1
    const av = todoVia.pop() ?? -1
    if guard > 64 {
      out.push(-1)
      via.push(av)
      return out
    }
    const tails: i32[] = []
    tailValueLeaves(at, tails)
    for lf in tails {
      const p = cwPeelValue(lf)
      const d = if p >= 0 && p < P.nodes.length { recHeldDecl(p) } else { -1 }
      if d >= 0 {
        todo.push(letInitAt(d))
        todoVia.push(p)
      } else {
        out.push(p)
        via.push(av)
      }
    }
  }
  return out
}

// What the read `x` names through un-annotated bindings that hold only their initializer: the
// first value that is not such a read, or `x` itself. -1 stays -1.
export function recBindOrigin(x: i32): i32 {
  let o = cwPeelValue(x)
  let hops = 0
  while o >= 0 && o < P.nodes.length && hops < 16 && nodeAt(o) is Ident {
    const init = recHeldLit(o)
    if init < 0 { return o }
    o = cwPeelValue(init)
    hops = hops + 1
  }
  return o
}

// The call or element read the binding read `x` holds through such bindings (`recBindOrigin`),
// which a delivery of `x` delivers as it would that origin (D8140); -1 when it holds neither.
export function recHeldCallOrigin(x: i32): i32 {
  const oc = recBindOrigin(x)
  if oc < 0 || oc == cwPeelValue(x) { return -1 }
  return if nodeAt(oc) is Call || nodeAt(oc) is Index { oc } else { -1 }
}

// The declaration of the un-annotated `let` or `const` the read `x` names, when it holds only
// its initializer (a `let` is assigned nothing but object literals), else -1.
// Read off the binder's declaration column, so a walk after the check answers alike.
export function recHeldDecl(x: i32): i32 {
  const e = nodeAt(x)
  if e is Ident {
    const d = recBindDeclOf(x)
    if d < 0 { return -1 }
    const dn = nodeAt(d)
    if dn is LetDecl {
      if dn.letType >= 0 || dn.letInit < 0 { return -1 }
      // A `const` alias of another such binding, or a `let` one never assigned, holds that
      // binding's value: its binding's. So does an element read of a list literal whose elements
      // all name one binding.
      const same = dn.letKw == "const" || !recBindAssigned(cwKeyOfRoot(x))
      const iv = cwPeelValue(dn.letInit)
      if same && iv >= 0 && iv != x && nodeAt(iv) is Ident {
        const a = recHeldDecl(iv)
        if a >= 0 && a != d { return a }
      }
      const ie = if same && iv >= 0 { recHeldElemDecl(iv) } else { -1 }
      if ie >= 0 && ie != d { return ie }
      const ic = if same && iv >= 0 { recHeldRetDecl(iv) } else { -1 }
      if ic >= 0 && ic != d { return ic }
      if dn.letKw == "const" { return d }
      if recBindReassigned(cwKeyOfRoot(x)) { return -1 }
      return d
    }
  }
  return -1
}

// The argument of call `iv` its named function returns unchanged: every return a read of one
// parameter, declared at the parameter's own type or neither declared; -1 for any other call.
function recRetParamArg(iv: i32): i32 {
  const c = nodeAt(iv)
  if !(c is Call) || c.callFn < 0 || !(nodeAt(c.callFn) is Ident) { return -1 }
  const fd = identBoundFnDeclOf(c.callFn)
  const f = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  if !(f is FuncDecl) || f.fnBody < 0 { return -1 }
  const rv: i32[] = []
  a20RetWalk(f.fnBody, true, rv)
  if rv.length == 0 { return -1 }
  let k = -1
  for v in rv {
    const p = cwPeelValue(v)
    const pn = if p >= 0 { nodeAt(p) } else { null }
    if !(pn is Ident) { return -1 }
    let j = 0
    let hit = -1
    while j < f.fnParams.length {
      const pd = nodeAt(f.fnParams[j])
      if (
        pd is Param
        && pd.parName == pn.identName
        && identDeclOf(p) == f.fnParams[j]
      ) {
        hit = j
      }
      j = j + 1
    }
    if hit < 0 || k >= 0 && hit != k { return -1 }
    k = hit
  }
  if k < 0 || k >= c.callArgs.length { return -1 }
  // Only as itself: a declared result other than the parameter's own type converts the value.
  const pd = nodeAt(f.fnParams[k])
  const pt = if pd is Param { pd.parType } else { -1 }
  if f.fnRet >= 0 || pt >= 0 {
    const rn = if f.fnRet >= 0 { nodeAt(f.fnRet) } else { null }
    const tn = if pt >= 0 { nodeAt(pt) } else { null }
    if !(rn is TypeRef) || !(tn is TypeRef) || rn.tyName != tn.tyName {
      return -1
    }
  }
  return c.callArgs[k]
}

// The binding call `iv` returns: one every return of its un-annotated function names, where that
// function has no other call site, so its result is built where this call delivers it; -1 else.
function recHeldRetDecl(iv: i32): i32 {
  // A call of a function every return of which is its parameter `k` hands back argument `k`.
  const pk = recRetParamArg(iv)
  if pk >= 0 {
    const pa = cwPeelValue(pk)
    return if pa >= 0 && nodeAt(pa) is Ident { recHeldDecl(pa) } else if pa >= 0 && pa != iv && nodeAt(pa) is Call { recHeldRetDecl(pa) } else { -1 }
  }
  const fd = recInferredFnOf(iv)
  const f = if fd >= 0 { nodeAt(fd) } else { null }
  if !(f is FuncDecl) || f.fnBody < 0 { return -1 }
  const sites: i32[] = []
  if rcwCallSites(fd, sites) >= 0 || sites.length != 1 { return -1 }
  const rv: i32[] = []
  a20RetWalk(f.fnBody, true, rv)
  if rv.length == 0 { return -1 }
  let one = -1
  for v in rv {
    const p = cwPeelValue(v)
    const rd = if p >= 0 && nodeAt(p) is Ident { recHeldDecl(p) } else { -1 }
    if rd < 0 || one >= 0 && rd != one { return -1 }
    one = rd
  }
  return one
}

// The binding every element of the list literal that element read `iv` reads names
// (`recHeldDecl` of its receiver), or -1.
function recHeldElemDecl(iv: i32): i32 {
  const ix = nodeAt(iv)
  if !(ix is Index) { return -1 }
  const r = cwPeelValue(ix.idxArr)
  if r < 0 || !(nodeAt(r) is Ident) { return -1 }
  const ld = recHeldDecl(r)
  const ln = if ld >= 0 { nodeAt(ld) } else { null }
  if !(ln is LetDecl) || ln.letInit < 0 { return -1 }
  const lit = nodeAt(cwPeelValue(ln.letInit))
  if !(lit is ArrayLit) || lit.arrElems.length == 0 { return -1 }
  let one = -1
  for e in lit.arrElems {
    const ev = cwPeelValue(e)
    const ed = if ev >= 0 && nodeAt(ev) is Ident { recHeldDecl(ev) } else { -1 }
    if ed < 0 || one >= 0 && ed != one { return -1 }
    one = ed
  }
  return one
}

// The initializer of `recHeldDecl`'s declaration, or -1.
export function recHeldLit(x: i32): i32 {
  const d = recHeldDecl(x)
  if d < 0 { return -1 }
  const dn = nodeAt(d)
  if dn is LetDecl { return dn.letInit }
  return -1
}

// Is the binding of key `k` assigned anywhere after its declaration? True for an unknown key.
function recBindAssigned(k: i32): boolean {
  if k == -1 { return true }
  cwIxBuild()
  const ow = cwOccWalk(k)
  while cwOccNext(ow) {
    if cwIxKind[ow.row] == CW_OCC_ASG { return true }
  }
  return false
}

// Is the binding keyed `k` (`cwKeyOfRoot`) the target of a whole assignment of anything but an object or
// list literal, so it may hold a value other than a literal?
function recBindReassigned(k: i32): boolean {
  if k == -1 { return true }
  cwIxBuild()
  const ow = cwOccWalk(k)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_ASG && !recAsgStoresLit(cwIxNode[r]) {
      return true
    }
  }
  return false
}

// How deep `recAsgStoresLit` has followed stores into bindings that are themselves stored into.
let recAsgDepth = 0

// Does the whole assignment at `a` store an object or list literal, written there or held by a
// binding?
function recAsgStoresLit(a: i32): boolean {
  if a < 0 || a >= P.nodes.length || recAsgDepth > 4 { return false }
  const n = nodeAt(a)
  if n is BinExpr {
    recAsgDepth = recAsgDepth + 1
    const o = recOriginExpr(n.binRight)
    recAsgDepth = recAsgDepth - 1
    return o >= 0 && (nodeAt(o) is ObjLit || nodeAt(o) is ArrayLit)
  }
  return false
}

// The declaration of the function the call `x` names, when it declares no result and no type
// parameter, so its result is built where the call delivers it; -1 otherwise.
export function recInferredFnOf(x: i32): i32 {
  const c = nodeAt(x)
  if c is Call && c.callFn >= 0 {
    const cn = nodeAt(c.callFn)
    if cn is Ident {
      let fd = identBoundFnDeclOf(c.callFn)
      if fd < 0 { fd = cwPeel(recHeldLit(c.callFn)) }
      if fd >= 0 && fd < P.nodes.length {
        const f = nodeAt(fd)
        if f is FuncDecl {
          if f.fnRet < 0 && f.fnTyParams.length == 0 { return fd }
        }
      }
    }
  }
  return -1
}

// The fresh binding or function that `x` reads, through un-annotated aliases, a call or an
// element of a list literal binding; -1 for any other value.
export function recFreshOriginDecl(x: i32, depth: i32): i32 {
  if depth <= 0 { return -1 }
  const p = cwPeelValue(x)
  if p < 0 || p >= P.nodes.length { return -1 }
  const fd = recInferredFnOf(p)
  if fd >= 0 { return fd }
  const ib = recIndexBase(p)
  if ib >= 0 { return recFreshOriginDecl(ib, depth - 1) }
  const d = recHeldDecl(p)
  if d < 0 { return -1 }
  const init = cwPeel(letInitAt(d))
  if init < 0 || init >= P.nodes.length { return -1 }
  const iv = nodeAt(init)
  if iv is ObjLit || iv is ArrayLit || iv is Call && recMapCtorCall(iv) {
    return d
  }
  return recFreshOriginDecl(init, depth - 1)
}

// The declaration of the binding the read `at` names, when it holds only an object literal or
// a list literal. -1 otherwise. Adoption retypes that binding itself; a converting copy asks
// `deliveryFresh` instead, which also needs the literal read nowhere else.
export function recLitOnlyDeclOf(at: i32): i32 {
  const init = recHeldLit(at)
  if init < 0 { return -1 }
  const iv = nodeAt(parenPeelIx(init))
  if iv is ObjLit || iv is ArrayLit { return recHeldDecl(at) }
  // An `if`, `match` or block whose every tail is a literal of one kind holds only fresh values,
  // so its binding adopts as one holding the literal does (D14872).
  if recJoinOfLits(parenPeelIx(init)) { return recHeldDecl(at) }
  return -1
}

// Whether value join `ix` hands back only object literals, or only list literals.
function recJoinOfLits(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if !(n is IfStmt || n is MatchExpr || n is Block) { return false }
  const tails: i32[] = []
  tailValueLeaves(ix, tails)
  if tails.length < 2 { return false }
  let objs = 0
  let lists = 0
  for t in tails {
    const tv = nodeAt(parenPeelIx(t))
    const isObj = tv is ObjLit
    const isList = tv is ArrayLit
    if isObj { objs = objs + 1 }
    if isList { lists = lists + 1 }
  }
  return objs == tails.length || lists == tails.length
}

// The declaration of the binding the read `at` names, when it holds only the empty `Map()` it
// is initialised with, so each value it holds is one a store put there. -1 otherwise.
export function recFreshMapDeclOf(at: i32): i32 {
  const init = recHeldLit(at)
  if init < 0 { return -1 }
  const ci = parenPeelIx(init)
  if ci < 0 || ci >= P.nodes.length { return -1 }
  const c = nodeAt(ci)
  if c is Call {
    if c.callArgs.length > 0 || c.callFn < 0 || callHasTyArgs(ci) { return -1 }
    const f = nodeAt(c.callFn)
    if f is Ident {
      if f.identName == "Map" && identBoundFnDeclOf(c.callFn) < 0 {
        return recHeldDecl(at)
      }
    }
  }
  return -1
}

// The declaration of the binding the read `at` names, when it holds a generic call that hands
// back an object literal its argument alone pins (`recSolePinArg`), at any depth. -1 otherwise.
export function recPassLitDeclOf(at: i32): i32 {
  const init = recHeldLit(at)
  if init < 0 { return -1 }
  let x = cwPeelValue(init)
  if x < 0 || x >= P.nodes.length || recSolePinArg(x) < 0 { return -1 }
  let hops = 0
  while x >= 0 && hops < 16 && recSolePinArg(x) >= 0 {
    x = cwPeelValue(recSolePinArg(x))
    hops = hops + 1
  }
  if x >= 0 && x < P.nodes.length && nodeAt(x) is ObjLit {
    return recHeldDecl(at)
  }
  return -1
}

// The annotations every whole delivery of un-annotated binding `d` names, into `out` with each
// one's projection down to the binding's value in `paths` (`e` an element, `f:name` a field,
// `/`-joined, outermost first). `d` holds a fresh literal, is never written as a whole, and every
// other use reads it. False where any use is another form, so the binding keeps its own type.
export function bindDestAnnots(d: i32, out: i32[], paths: string[]): boolean {
  if !bindHoldsFresh(d) { return false }
  const on: i32[] = []
  return bindUseDests(d, "", out, paths, on) && out.length > 0
}

// Whether `d` is an un-annotated `let`/`const` of a fresh literal never written as a whole.
function bindHoldsFresh(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return false }
  const iv = parenPeelIx(dn.letInit)
  if iv < 0 || !bindFreshLit(nodeAt(iv)) && !bindMapCtor(iv) { return false }
  const k = cwKeyOfDecl(d)
  return k >= 0 && (dn.letKw == "const" || !recBindAssigned(k))
}

// The destinations of every whole use of binding `d`, whose value sits at `path` below them.
// `on` is the path of bindings and functions the walk is inside: one met again on it is a
// cycle, which names no destination.
function bindUseDests(
  d: i32,
  path: string,
  out: i32[],
  paths: string[],
  on: i32[],
): boolean {
  const k = cwKeyOfDecl(d)
  if k < 0 || i32ListHas(on, d) { return false }
  on.push(d)
  cwIxBuild()
  let ok = true
  const ow = cwOccWalk(k)
  while ok && cwOccNext(ow) {
    const r = ow.row
    const kind = cwIxKind[r]
    if kind == CW_OCC_USE { ok = exprDests(cwIxNode[r], path, out, paths, on) }
    else if kind != CW_OCC_ASG && kind != CW_OCC_BIND { ok = false }
  }
  on.pop()
  return ok
}

// The destinations value `x` (at `path` below them) is delivered to by its consumer; false for a
// consumer no rule places.
function exprDests(
  x: i32,
  path: string,
  out: i32[],
  paths: string[],
  on: i32[],
): boolean {
  if !cwIxCovers(x) { return false }
  const uk = cwIxUpKind[x]
  const up = cwIxUp[x]
  if uk == CW_UP_OBJ || uk == CW_UP_CMP || uk == CW_UP_IS { return true }
  if uk == CW_UP_LETINIT {
    const c = nodeAt(up)
    if !(c is LetDecl) { return false }
    if c.letType >= 0 { return destPush(c.letType, path, out, paths) }
    // An un-annotated alias delivers where its own uses do.
    if c.letKw != "const" && recBindAssigned(cwKeyOfDecl(up)) { return false }
    return bindUseDests(up, path, out, paths, on)
  }
  if uk == CW_UP_ELEM {
    return exprDests(up, destJoin("e", path), out, paths, on)
  }
  if uk == CW_UP_FIELD {
    const fi = nodeAt(cwIxUpAux[x])
    if !(fi is FieldInit) { return false }
    return exprDests(up, destJoin("f:" + fi.fiName, path), out, paths, on)
  }
  if uk == CW_UP_ARG {
    const c = nodeAt(up)
    if !(c is Call) || c.callFn < 0 || !(nodeAt(c.callFn) is Ident) {
      return false
    }
    const fd = cwFnDeclAt(c.callFn)
    const f = if fd >= 0 { nodeAt(fd) } else { null }
    if !(f is FuncDecl) { return false }
    // A generic parameter takes the argument at whatever it is: no destination of its own.
    if f.fnTyParams.length > 0 { return true }
    const a = cwIxUpAux[x]
    if a < 0 || a >= f.fnParams.length { return false }
    const pn = nodeAt(f.fnParams[a])
    if !(pn is Param) || pn.parType < 0 || pn.parRest == 1 { return false }
    return destPush(pn.parType, path, out, paths)
  }
  if uk == CW_UP_RET {
    const fi = destEnclosingFn(up)
    const f = if fi >= 0 { nodeAt(fi) } else { null }
    if !(f is FuncDecl) || f.fnTyParams.length > 0 { return false }
    if f.fnRet >= 0 { return destPush(f.fnRet, path, out, paths) }
    // An inferred result is delivered where each call of the function is.
    const sites: i32[] = []
    if rcwCallSites(fi, sites) >= 0 || i32ListHas(on, fi) { return false }
    on.push(fi)
    let ok = true
    for e in sites {
      // A method spelling hands the result back the same way as a plain call. A call that is
      // returned again hands it to another inferred result: no destination is followed there.
      const call = e / 2
      if ok && cwIxCovers(call) && cwIxUpKind[call] == CW_UP_RET { ok = false }
      if ok { ok = exprDests(call, path, out, paths, on) }
    }
    on.pop()
    return ok
  }
  if uk == CW_UP_ASG_RHS { return storeDests(up, path, out, paths, on) }
  return false
}

// The destinations of the value assignment `at` stores into an element of a fresh container
// binding (`c[k] = v`): that container's, at its element; false for any other assignment.
function storeDests(
  at: i32,
  path: string,
  out: i32[],
  paths: string[],
  on: i32[],
): boolean {
  const a = nodeAt(at)
  if !(a is BinExpr) || a.binOp != "=" { return false }
  const lhs = nodeAt(parenPeelIx(a.binLeft))
  if !(lhs is Index) { return false }
  const ri = parenPeelIx(lhs.idxArr)
  if ri < 0 || !(nodeAt(ri) is Ident) { return false }
  const cd = identDeclOf(ri)
  if cd < 0 || cd >= P.nodes.length || !bindHoldsFresh(cd) { return false }
  const cn = nodeAt(cd)
  if !(cn is LetDecl) { return false }
  const step = if bindMapCtor(parenPeelIx(cn.letInit)) { "v" } else { "e" }
  return bindUseDests(cd, destJoin(step, path), out, paths, on)
}

function destPush(tr: i32, path: string, out: i32[], paths: string[]): boolean {
  out.push(tr)
  paths.push(path)
  return true
}

function destJoin(step: string, path: string): string {
  return if path == "" { step } else { step + "/" + path }
}

// The function declaration a `return` at `r` returns from, or -1.
function destEnclosingFn(r: i32): i32 {
  let x = r
  while x >= 0 && cwIxCovers(x) {
    if nodeAt(x) is FuncDecl { return x }
    x = cwIxParent[x]
  }
  return -1
}

// Whether node `x` is a bare `Map()`.
function bindMapCtor(x: i32): boolean {
  const n = nodeAt(x)
  return n is Call && recMapCtorCall(n)
}

// Whether node `n` is a fresh literal a binding may hold at its destination's type.
function bindFreshLit(n: Node): boolean {
  return n is ObjLit
    || n is ArrayLit
    || n is NumLit
    || n is StrLit
    || n is BoolLit
}
