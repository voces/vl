// `check_arrow_facts.vl` — the arrow rule's rows (`check_arrow.vl`) read as the facts the storage
// decision takes at check time: each call through a hole callee, per set the callee holds there,
// with each member's result at the call's closed argument types. One fact per (call, set); a set
// two rows give different results is split, so no fact stands for it.
// Built on demand from the tables the last check left: `arrowFactsBuild`.

import {
  ArrayLit,
  BinExpr,
  Call,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  Member,
  P,
  Param,
  Paren,
  RetStmt,
  TypeRef,
  fnNameIsLambda,
  i32ToStr,
  nodeAt,
  nodeChildren,
} from "./ast"
import {
  arrowArgsOf,
  arrowCalleeOf,
  arrowCount,
  arrowFromOf,
  arrowHoleOf,
  arrowOuterOf,
} from "./check_arrow"
import {
  fnTagCallNote,
  fnTagCallSetOf,
  fnTagCalls,
  fnTagMembers,
  fnTagSetOfMembers,
  fnTagSetOfTy,
} from "./check_elab_cap"
import { setBindSetsOf, setBindWrittenJoin } from "./check_set_bind"
import {
  T,
  TY_NEVER,
  TY_VOID,
  TyArray,
  TyMap,
  TyObj,
  mkFuncTy,
  tyAt,
  tyElemOf,
  tyFieldTyOf,
  tyMayHoldFn,
  tyValOf,
} from "./check_types"
import { crSpans } from "./check_capture_loss"
import { parenPeelIx } from "./check_places"
import { cwIxParent, cwLetWrittenInClosure } from "./check_write_scan"
import {
  setMemberRetAt,
  setMemberRetsQuiet,
  substTyDeepUnbanked,
} from "./check_relate_core"
import {
  IV_SET_CALL,
  instVecCalleeAt,
  instVecCount,
  instVecIxAt,
  instVecNamesAt,
  instVecNote,
  instVecTysAt,
} from "./check_bind_rows"
import { nodeTyIxOf } from "./check_node_tys"
import { identFnDeclOf } from "./check_scopes"
import { isNeverTy, tyHasTyVar } from "./tyquery"
import { identDeclOf, nodeSrc } from "./symbols"
import { i32ListEq, i32ListHas, i32ListIndexOf, strListHas } from "./listutil"

let afCall: i32[] = []
let afSet: i32[] = []
let afRs: i32[][] = []
let afArgs: i32[][] = []
let afSlot: {[string]: i32} = Map()
let afSplit: i32[] = []
let afOpen: i32[] = []
// The sets some call row reaches without closing its facts (STORE B2a).
let afRowOpen: i32[] = []
// Per written binding a parameter seeds and every call row joins alike (STORE B2b): the binding,
// the interned join, and the parameter's set.
let afSeedBind: i32[] = []
let afSeedSet: i32[] = []
let afSeedHeld: i32[] = []
// Per parameter key `decl|i`, the sets its calls go through, directly or handed on.
let afTakes: {[string]: i32[]} = Map()
// Per parameter key `decl|i`, whether some arrow row's hole call goes through it.
let afSeen: {[string]: boolean} = Map()

// Builds the facts from the arrow rows; returns how many stand.
export function arrowFactsBuild(): i32 {
  afCall = []
  afSet = []
  afRs = []
  afArgs = []
  afSlot = Map()
  afSplit = []
  afOpen = []
  afRowOpen = []
  afSeedBind = []
  afSeedSet = []
  afSeedHeld = []
  afTakes = Map()
  afSeen = Map()
  // The facts each call row's key gives (STORE B2a); per set, the outer calls they cover.
  const covered: {[string]: boolean} = Map()
  // A member's result at a row's types is asked quietly: a binding no call makes owes no diagnostic.
  const d0 = T.diags.length
  arrowSetCallRows()
  arrowRowFacts(covered, afRowOpen)
  arrowSeedJoins()
  while T.diags.length > d0 { T.diags.pop() }
  let r = 0
  while r < arrowCount() {
    if arrowRowStray(r) {
      r = r + 1
      continue
    }
    const sets = arrowSetsOf(r)
    const hole = arrowSrcOf(arrowHoleOf(r))
    arrowSeenNote(hole)
    // An instance is keyed by the set only in a named, non-generic body, and only a named member
    // has an instance of its own per argument types.
    const closed = arrowArgsClosed(arrowArgsOf(r))
      && arrowPerSetBody(arrowEnclosingFn(hole))
    for st in sets {
      arrowTakesNote(hole, arrowFromOf(r), st)
      const rowKey = i32ToStr(arrowSrcOf(arrowOuterOf(r))) + "|" + i32ToStr(st)
      // A lambda member's fact stands only where its body types at the row's arguments.
      const named = arrowNamedMembers(st)
      let rs: i32[] = []
      let typed = named
      if closed && named {
        rs = arrowRsAt(st, arrowArgsOf(r))
      } else if closed {
        rs = setMemberRetsQuiet(
          fnTagMembers(st),
          mkFuncTy(arrowArgsOf(r), TY_VOID),
        )
        typed = rs.length > 0
      }
      if closed && typed {
        arrowFactNote(hole, st, rs, arrowArgsOf(r))
      } else if covered[rowKey] ?? false {
        // The call's own key closes what the row leaves open; its facts stand.
      } else if !i32ListHas(afOpen, st) {
        afOpen.push(st)
      }
    }
    r = r + 1
  }
  return afCall.length
}

// The fact ids, in the order built.
export function arrowFacts(): i32[] {
  const out: i32[] = []
  let i = 0
  while i < afCall.length {
    if !i32ListHas(afSplit, afSet[i]) { out.push(i) }
    i = i + 1
  }
  return out
}

// Fact `f`'s call node; -1 for an id that names no fact.
export function arrowFactCallOf(f: i32): i32 {
  return if f >= 0 && f < afCall.length { afCall[f] } else { -1 }
}

// Fact `f`'s set; -1 for an id that names no fact.
export function arrowFactSetOf(f: i32): i32 {
  return if f >= 0 && f < afSet.length { afSet[f] } else { -1 }
}

// What each member of fact `f`'s set returns at its call, in set order.
export function arrowFactRsOf(f: i32): i32[] {
  return if f >= 0 && f < afRs.length { afRs[f] } else { [] }
}

// The declared function whose body makes fact `f`'s call, or -1.
export function arrowFactFnOf(f: i32): i32 {
  return arrowEnclosingFn(arrowFactCallOf(f))
}

// The fact for call `c` through set `s`, or -1 when none stands.
export function arrowFactAt(c: i32, s: i32): i32 {
  if i32ListHas(afSplit, s) { return -1 }
  return afSlot[i32ToStr(arrowSrcOf(c)) + "|" + i32ToStr(s)] ?? -1
}

// Whether some call through parameter `i` of `decl`, or through a parameter it is handed on to,
// goes through set `s`.
export function arrowParamTakes(decl: i32, i: i32, s: i32): boolean {
  return i32ListHas(afTakes[i32ToStr(decl) + "|" + i32ToStr(i)] ?? [], s)
}

// Whether some arrow row's hole call goes through parameter `i` of `decl`.
export function arrowParamSeen(decl: i32, i: i32): boolean {
  return afSeen[i32ToStr(decl) + "|" + i32ToStr(i)] ?? false
}

// Every set `arrowParamTakes` finds parameter `i` of `decl` taking.
export function arrowParamTakesSets(decl: i32, i: i32): i32[] {
  return afTakes[i32ToStr(decl) + "|" + i32ToStr(i)] ?? []
}

// Whether every fact of set `s` is at one argument vector holding no function and no empty list's
// element: each member, a generic one included, has one instance across them.
export function arrowSetOneShape(s: i32): boolean {
  let first: i32[] = []
  let have = false
  let i = 0
  while i < afSet.length {
    if afSet[i] == s {
      if !have {
        first = afArgs[i]
        have = true
        // A function or an empty list's element binds a generic member where the call's types
        // say nothing of it.
        for a in first {
          const at = if a >= 0 && a < T.tys.length { tyAt(a) } else { null }
          if tyMayHoldFn(a) || at is TyArray && isNeverTy(tyElemOf(at)) {
            return false
          }
        }
      } else if !i32ListEq(first, afArgs[i]) {
        return false
      }
    }
    i = i + 1
  }
  return true
}

// Whether some call row reaches set `s` without closing its facts.
export function arrowSetRowOpen(s: i32): boolean {
  return i32ListHas(afRowOpen, s)
}

// Whether some call reaches set `s` at argument types left open, so no fact stands for it.
export function arrowSetOpen(s: i32): boolean { return i32ListHas(afOpen, s) }

// Whether set `s` has two facts at one call whose member results differ.
export function arrowSetSplit(s: i32): boolean { return i32ListHas(afSplit, s) }

// The sets row `r`'s hole callee holds: its own set; else, when it is a parameter (of the caller,
// handed by the outer argument, or of the callee), every set the set-binding rows bring there.
export function arrowSetsOf(r: i32): i32[] {
  const own = fnTagSetOfTy(arrowCalleeOf(r))
  if own >= 0 { return [own] }
  const x = arrowFromOf(r)
  if x >= 0 { return arrowParamSets(x) }
  const h = arrowHoleOf(r)
  const hn = if h >= 0 && h < P.nodes.length { nodeAt(h) } else { null }
  if !(hn is Call) { return [] }
  return arrowParamSets(parenPeelIx(hn.callFn))
}

// The source node a copied node `x` comes from; `x` itself when it is a source node.
export function arrowSrcOf(x: i32): i32 {
  let y = x
  let n = 0
  while n < 64 {
    const s = nodeSrc[y] ?? -1
    if s < 0 || s == y { return y }
    y = s
    n = n + 1
  }
  return y
}

// Whether declared function `fd` is named and has no type parameters.
function arrowPerSetBody(fd: i32): boolean {
  const f = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  return f is FuncDecl && f.fnName != "" && f.fnTyParams.length == 0
}

// Whether every member of set `s` is a named function.
function arrowNamedMembers(s: i32): boolean {
  for d in fnTagMembers(s) {
    const f = nodeAt(d)
    if !(f is FuncDecl) || f.fnName == "" { return false }
  }
  return true
}

// Whether every argument type is named and closed.
function arrowArgsClosed(args: i32[]): boolean {
  for a in args {
    if a < 0 || tyHasTyVar(a) { return false }
  }
  return true
}

// What each member of set `s` returns at argument types `args`.
function arrowRsAt(s: i32, args: i32[]): i32[] {
  const ft = mkFuncTy(args, TY_VOID)
  const rs: i32[] = []
  for m in fnTagMembers(s) { rs.push(setMemberRetAt(m, ft)) }
  return rs
}

// Notes the fact (call `c`, set `s`, results `rs` at argument types `args`); a second fact of other
// results splits `s`.
function arrowFactNote(c: i32, s: i32, rs: i32[], args: i32[]) {
  const k = i32ToStr(c) + "|" + i32ToStr(s)
  const f = afSlot[k] ?? -1
  if f >= 0 {
    if !i32ListEq(afRs[f], rs) && !i32ListHas(afSplit, s) { afSplit.push(s) }
    return 0
  }
  afSlot[k] = afCall.length
  afCall.push(c)
  afSet.push(s)
  afRs.push(rs)
  afArgs.push(args)
  return 0
}

// Notes that set `s` reaches the parameter hole call `c` goes through, and the caller's parameter
// the outer argument `from` reads, which hands it on.
function arrowTakesNote(c: i32, from: i32, s: i32) {
  const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
  if cn is Call { arrowTakesAdd(parenPeelIx(cn.callFn), s) }
  if from >= 0 { arrowTakesAdd(from, s) }
  return 0
}

// Notes the parameter hole call `c` goes through as seen.
function arrowSeenNote(c: i32) {
  const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
  if !(cn is Call) { return 0 }
  const k = arrowParamKey(parenPeelIx(cn.callFn))
  if k != "" { afSeen[k] = true }
  return 0
}

// Adds set `s` to the takes of the parameter name `x` reads, when it reads one.
function arrowTakesAdd(x: i32, s: i32) {
  const k = arrowParamKey(x)
  if k == "" { return 0 }
  const was = afTakes[k] ?? []
  if !i32ListHas(was, s) {
    was.push(s)
    afTakes[k] = was
  }
  return 0
}

// `decl|i` for the parameter name `x` reads, "" when it reads none.
function arrowParamKey(x: i32): string {
  const d = arrowParamDeclOf(x)
  if d < 0 { return "" }
  const e = if d < cwIxParent.length { cwIxParent[d] } else { -1 }
  const en = if e >= 0 && e < P.nodes.length { nodeAt(e) } else { nodeAt(d) }
  if !(en is FuncDecl) { return "" }
  let i = 0
  while i < en.fnParams.length {
    if en.fnParams[i] == d { return i32ToStr(e) + "|" + i32ToStr(i) }
    i = i + 1
  }
  return ""
}

// The sets the set-binding rows bring to the parameter name `x` reads, [] when it reads none.
function arrowParamSets(x: i32): i32[] {
  const d = arrowParamDeclOf(x)
  if d < 0 { return [] }
  const e = if d < cwIxParent.length { cwIxParent[d] } else { -1 }
  const en = if e >= 0 && e < P.nodes.length { nodeAt(e) } else { nodeAt(d) }
  if !(en is FuncDecl) { return [] }
  let i = 0
  while i < en.fnParams.length {
    if en.fnParams[i] == d { return setBindSetsOf(e, i) }
    i = i + 1
  }
  return []
}

// The parameter name `x` reads, through `const` copies of it; -1 when it reads none.
export function arrowParamDeclOf(x: i32): i32 {
  // A copy chain ends at a parameter or at a binding that is no copy; a revisit is a cycle.
  const seen: i32[] = []
  let y = x
  while y >= 0 && y < P.nodes.length && nodeAt(y) is Ident {
    const d = identDeclOf(y)
    if i32ListHas(seen, d) { return -1 }
    seen.push(d)
    const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
    if dn is Param { return d }
    if !(dn is LetDecl) || dn.letKw != "const" || dn.letInit < 0 { return -1 }
    y = parenPeelIx(dn.letInit)
  }
  return -1
}

// The facts of each call row (`instVecAt`) whose binding closes once each hole parameter handed a
// set is bound at that set: each call its callee makes through that parameter, or a path from it,
// whose callee holds the row's set. A set some row cannot close goes to `rowOpen`; `covered` holds
// `call|set` for each row whose facts all stand.
function arrowRowFacts(covered: {[string]: boolean}, rowOpen: i32[]) {
  const bodies: {[i32]: boolean} = Map()
  const callsOf: {[i32]: i32[]} = Map()
  const unsure: {[i32]: boolean} = Map()
  let r = 0
  while r < instVecCount() {
    const d = instVecCalleeAt(r)
    const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
    const cx = instVecIxAt(r)
    const cn = if cx >= 0 && cx < P.nodes.length { nodeAt(cx) } else { null }
    if f is FuncDecl && cn is Call {
      if !(bodies[d] ?? false) {
        bodies[d] = true
        arrowBodyCalls(d, f, callsOf, unsure)
      }
      const tys: i32[] = []
      const closed = arrowRowBinding(r, d, f, cn, tys)
      let i = 0
      while i < f.fnParams.length && i < cn.callArgs.length {
        const b = f.fnParams[i]
        const bn = nodeAt(b)
        // Only a parameter with no annotation is bound per call; an annotated one is a delivery.
        const hole = bn is Param && bn.parType < 0
        const t = if hole { nodeTyIxOf(parenPeelIx(cn.callArgs[i])) } else { -1 }
        const held: i32[] = []
        const own = fnTagSetOfTy(t)
        if own >= 0 { held.push(own) }
        arrowSetsHeld(t, held, [])
        for st in held {
          // A lambda member's fact stands only where its body types at the call's arguments.
          const named = arrowNamedMembers(st)
          let ok = closed && !(unsure[b] ?? false)
          const fc: i32[] = []
          const frs: i32[][] = []
          const fargs: i32[][] = []
          for c in callsOf[b] ?? [] {
            const hn = nodeAt(c)
            // A callee path the row's type does not resolve (a method of a list or map read off the
            // parameter) hands its elements on where the rows do not follow.
            if hn is Call && arrowPathTy(t, hn.callFn) < 0 { ok = false }
            if (
              ok
              && hn is Call
              && fnTagSetOfTy(arrowPathTy(t, hn.callFn)) == st
            ) {
              const args: i32[] = []
              let emptyLit = false
              for a in hn.callArgs {
                const an = nodeAt(parenPeelIx(a))
                if an is ArrayLit && an.arrElems.length == 0 { emptyLit = true }
                args.push(
                  substTyDeepUnbanked(
                    nodeTyIxOf(parenPeelIx(a)),
                    instVecNamesAt(r),
                    tys,
                  ),
                )
              }
              // An empty list literal's element is bound by the member's instance, not its own type.
              const rs = if !arrowArgsClosed(args) || emptyLit { [] } else if named { arrowRsAt(st, args) } else { setMemberRetsQuiet(fnTagMembers(st), mkFuncTy(args, TY_VOID)) }
              if rs.length > 0 {
                fc.push(arrowSrcOf(c))
                frs.push(rs)
                fargs.push(args)
              } else {
                ok = false
              }
            }
          }
          // A row's facts stand only when all of them do; the parameter then takes the row's set.
          if ok {
            const pk = i32ToStr(d) + "|" + i32ToStr(i)
            const was = afTakes[pk] ?? []
            if !i32ListHas(was, st) { was.push(st) }
            afTakes[pk] = was
            if fc.length > 0 { afSeen[pk] = true }
            let k = 0
            while k < fc.length {
              arrowFactNote(fc[k], st, frs[k], fargs[k])
              k = k + 1
            }
            covered[i32ToStr(arrowSrcOf(cx)) + "|" + i32ToStr(st)] = true
          } else if !i32ListHas(rowOpen, st) {
            rowOpen.push(st)
          }
        }
        i = i + 1
      }
    }
    r = r + 1
  }
  return 0
}

// Declaration `d`'s calls through a parameter, or a path from one, by parameter; a parameter read
// inside a nested function or seeding a written binding is `unsure`, its calls being another
// instance's or the binding's.
function arrowBodyCalls(
  d: i32,
  f: FuncDecl,
  callsOf: {[i32]: i32[]},
  unsure: {[i32]: boolean},
) {
  if f.fnBody < 0 { return 0 }
  const xs: i32[] = [f.fnBody]
  while xs.length > 0 {
    const x = xs.pop()
    if x >= 0 && x < P.nodes.length {
      const n = nodeAt(x)
      if n is Call {
        const b = arrowParamDeclOf(arrowPathRoot(n.callFn))
        if b >= 0 && i32ListHas(f.fnParams, b) {
          if arrowEnclosingFn(x) == d {
            const cs = callsOf[b] ?? []
            cs.push(x)
            callsOf[b] = cs
          } else {
            unsure[b] = true
          }
        }
      }
      // A read that is no callee, argument or result stores the parameter's value somewhere the
      // rows do not follow (a written binding, a slot, a field).
      if n is Ident {
        const b = identDeclOf(x)
        if b >= 0 && i32ListHas(f.fnParams, b) && !arrowReadPlain(x) {
          unsure[b] = true
        }
      }
      for c in nodeChildren(x) { xs.push(c) }
    }
  }
  return 0
}

// Whether read `x` is a call's callee (through a field or element path), a call's argument, or a
// returned value.
function arrowReadPlain(x: i32): boolean {
  let y = x
  let p = if y < cwIxParent.length { cwIxParent[y] } else { -1 }
  let n = 0
  while n < 32 && p >= 0 && p < P.nodes.length {
    const pn = nodeAt(p)
    if (
      pn is Member && pn.memObj == y
      || pn is Index && pn.idxArr == y
      || pn is Paren
    ) {
      y = p
      p = if y < cwIxParent.length { cwIxParent[y] } else { -1 }
      n = n + 1
    } else if pn is Call && pn.callFn != y {
      return arrowArgToHole(pn, y)
    } else {
      return pn is Call || pn is RetStmt
    }
  }
  return false
}

// Whether argument `y` of call `c` goes to a declared function's parameter with no annotation,
// which a call row of its own binds; any other destination is a delivery the rows do not follow.
function arrowArgToHole(c: Call, y: i32): boolean {
  const d = identFnDeclOf(parenPeelIx(c.callFn))
  const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(f is FuncDecl) { return false }
  let i = 0
  while i < c.callArgs.length && i < f.fnParams.length {
    if parenPeelIx(c.callArgs[i]) == y {
      const pn = nodeAt(f.fnParams[i])
      return pn is Param && pn.parType < 0
    }
    i = i + 1
  }
  return false
}

// Call row `r` (`cn`, to `f` at `d`)'s binding, into `tys`: each hole parameter handed a value
// holding a set is bound at that value's type, which keeps the set's identity. False when a binding
// stays open but for the sets it holds.
export function arrowRowBinding(
  r: i32,
  d: i32,
  f: FuncDecl,
  cn: Call,
  tys: i32[],
): boolean {
  const names = instVecNamesAt(r)
  const tys0 = instVecTysAt(r)
  let j = 0
  while j < names.length && j < tys0.length {
    let t = tys0[j]
    let i = 0
    while i < f.fnParams.length && i < cn.callArgs.length {
      const pn = nodeAt(f.fnParams[i])
      if (
        pn is Param
        && pn.parType < 0
        && names[j] == arrowHolePrefix(f, d) + i32ToStr(i)
      ) {
        const at = nodeTyIxOf(parenPeelIx(cn.callArgs[i]))
        const hs: i32[] = []
        arrowSetsHeld(at, hs, [])
        if fnTagSetOfTy(at) >= 0 || hs.length > 0 { t = at }
      }
      i = i + 1
    }
    tys.push(t)
    j = j + 1
  }
  for t in tys {
    if t < 0 || t == TY_NEVER || !arrowKeyClosed(t, []) { return false }
  }
  return true
}

// The prefix of declaration `f`'s (at `m`) hole names: `?<name>.`, or `?#L<m>.` for a lambda.
export function arrowHolePrefix(f: FuncDecl, m: i32): string {
  if f.fnName == "" || fnNameIsLambda(f.fnName) {
    return "?#L" + i32ToStr(m) + "."
  }
  return "?" + f.fnName + "."
}

// The name a field or element path `x` is read off: `x` itself when it is no path.
export function arrowPathRoot(x: i32): i32 {
  let v = parenPeelIx(x)
  let n = 0
  while n < 32 && v >= 0 && v < P.nodes.length {
    const vn = nodeAt(v)
    if vn is Member { v = parenPeelIx(vn.memObj) }
    else if vn is Index { v = parenPeelIx(vn.idxArr) }
    else { return v }
    n = n + 1
  }
  return v
}

// The type path `x` reads when its root holds `t`: `t` walked down its fields and elements.
export function arrowPathTy(t: i32, x: i32): i32 {
  const v = parenPeelIx(x)
  const vn = if v >= 0 && v < P.nodes.length { nodeAt(v) } else { null }
  if vn is Member {
    const o = arrowPathTy(t, vn.memObj)
    return if o >= 0 { tyFieldTyOf(o, vn.memProp) } else { -1 }
  } else if vn is Index {
    const o = arrowPathTy(t, vn.idxArr)
    const ot = if o >= 0 && o < T.tys.length { tyAt(o) } else { null }
    return if ot is TyArray { tyElemOf(ot) } else { -1 }
  } else {
    // Any other node is the path's root, which holds `t`.
    return t
  }
}

// Whether type `t` is closed but for the function sets it holds, which key by identity.
export function arrowKeyClosed(t: i32, seen: i32[]): boolean {
  if t < 0 || t >= T.tys.length { return false }
  if fnTagSetOfTy(t) >= 0 || !tyHasTyVar(t) || i32ListHas(seen, t) {
    return true
  }
  seen.push(t)
  const a = tyAt(t)
  if a is TyArray {
    return arrowKeyClosed(tyElemOf(a), seen)
  } else if a is TyMap {
    return arrowKeyClosed(tyValOf(a), seen)
  } else if a is TyObj {
    for f in a.objFieldTypes {
      if !arrowKeyClosed(f, seen) { return false }
    }
    return true
  } else {
    // Any other type is closed only when it reads no type variable.
    return !tyHasTyVar(t)
  }
}

// The function sets type `t` holds in a list element, map value or record field, into `out`.
export function arrowSetsHeld(t: i32, out: i32[], seen: i32[]) {
  if t < 0 || t >= T.tys.length || i32ListHas(seen, t) { return 0 }
  seen.push(t)
  const a = tyAt(t)
  const parts: i32[] = []
  if a is TyArray { parts.push(tyElemOf(a)) }
  if a is TyMap { parts.push(tyValOf(a)) }
  if a is TyObj {
    for f in a.objFieldTypes { parts.push(f) }
  }
  for e in parts {
    const es = fnTagSetOfTy(e)
    if es >= 0 && !i32ListHas(out, es) { out.push(es) }
    arrowSetsHeld(e, out, seen)
  }
  return 0
}

// The written bindings a parameter seeds (`setBindWrittenJoin`), joined per call row; where every
// row of the callee gives one join, the join is a set of its own, the calls through the binding go
// through it, and their facts stand (STORE B2b).
function arrowSeedJoins() {
  const seen: {[i32]: boolean} = Map()
  const joins: {[i32]: i32[]} = Map()
  const helds: {[i32]: i32} = Map()
  const owners: {[i32]: i32} = Map()
  const keys: {[i32]: string[][]} = Map()
  const keyTys: {[i32]: i32[][]} = Map()
  const torn: {[i32]: boolean} = Map()
  const order: i32[] = []
  let r = 0
  while r < instVecCount() {
    const d = instVecCalleeAt(r)
    const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
    const cx = instVecIxAt(r)
    const cn = if cx >= 0 && cx < P.nodes.length { nodeAt(cx) } else { null }
    if f is FuncDecl && cn is Call && f.fnBody >= 0 {
      const tys: i32[] = []
      const closed = arrowRowBinding(r, d, f, cn, tys)
      // The set each parameter holds at this call; a closed function handed by name keys by its
      // signature, not by identity, so it holds none.
      const handed: i32[][] = []
      let j = 0
      while j < f.fnParams.length {
        const ax = if j < cn.callArgs.length { parenPeelIx(cn.callArgs[j]) } else { -1 }
        const hs = if ax >= 0 { fnTagSetOfTy(nodeTyIxOf(ax)) } else { -1 }
        handed.push(if hs >= 0 { fnTagMembers(hs) } else { [] })
        j = j + 1
      }
      for b in arrowSeedBindsIn(f) {
        const p = arrowSeedParamOf(b, f)
        const pi = i32ListIndexOf(f.fnParams, p)
        const js = setBindWrittenJoin(b, f.fnParams, handed)
        const ax = if pi >= 0 && pi < cn.callArgs.length { parenPeelIx(cn.callArgs[pi]) } else { -1 }
        const held = if ax >= 0 { fnTagSetOfTy(nodeTyIxOf(ax)) } else { -1 }
        const js2 = arrowSortedIds(js)
        if !(seen[b] ?? false) {
          seen[b] = true
          order.push(b)
          joins[b] = js2
          helds[b] = held
          owners[b] = d
          keys[b] = []
          keyTys[b] = []
        }
        if (
          !closed
          || js.length < 2
          || held < 0
          || !i32ListEq(joins[b] ?? [], js2)
          || helds[b] != held
        ) {
          torn[b] = true
        } else {
          const ks = keys[b] ?? []
          ks.push(instVecNamesAt(r))
          keys[b] = ks
          const kt = keyTys[b] ?? []
          kt.push(tys)
          keyTys[b] = kt
        }
      }
    }
    r = r + 1
  }
  for b in order {
    const js = joins[b] ?? []
    // A generic member is instanced per call shape, which the binding's one set does not follow
    // when the seeding parameter is also called at another (B3's, D15409).
    if !(torn[b] ?? false) && arrowAllNamed(js) && !arrowAnyGeneric(js) {
      const st = fnTagSetOfMembers(js)
      const d = owners[b] ?? -1
      const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
      if (
        st >= 0
        && f is FuncDecl
        && arrowSeedCallsNote(b, f, st, keys[b] ?? [], keyTys[b] ?? [])
      ) {
        afSeedBind.push(b)
        afSeedSet.push(st)
        afSeedHeld.push(helds[b] ?? -1)
      }
    }
  }
  return 0
}

// Notes each call through binding `b` in `f`'s body as a call through set `st`, with its fact at
// every key's argument types; false, noting nothing, when a key leaves one open or the binding is
// read other than as a callee.
function arrowSeedCallsNote(
  b: i32,
  f: FuncDecl,
  st: i32,
  names: string[][],
  tys: i32[][],
): boolean {
  const calls: i32[] = []
  const xs: i32[] = [f.fnBody]
  while xs.length > 0 {
    const x = xs.pop()
    if x >= 0 && x < P.nodes.length {
      const n = nodeAt(x)
      if n is Ident && identDeclOf(x) == b {
        const p = if x < cwIxParent.length { cwIxParent[x] } else { -1 }
        const pn = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
        if pn is Call && pn.callFn == x {
          calls.push(p)
        } else if (
          !(pn is LetDecl && p == b)
          && !(pn is BinExpr && pn.binLeft == x)
        ) {
          return false
        }
      }
      for c in nodeChildren(x) { xs.push(c) }
    }
  }
  if calls.length == 0 { return false }
  const rsOf: i32[][] = []
  const argsOf: i32[][] = []
  for c in calls {
    const cn = nodeAt(c)
    let rs: i32[] = []
    let first: i32[] = []
    let k = 0
    while cn is Call && k < names.length {
      const args: i32[] = []
      for a in cn.callArgs {
        args.push(
          substTyDeepUnbanked(nodeTyIxOf(parenPeelIx(a)), names[k], tys[k]),
        )
      }
      if !arrowArgsClosed(args) { return false }
      const here = arrowRsAt(st, args)
      if k == 0 {
        rs = here
        first = args
      } else if !i32ListEq(rs, here) {
        return false
      }
      k = k + 1
    }
    rsOf.push(rs)
    argsOf.push(first)
  }
  let i = 0
  while i < calls.length {
    fnTagCallNote(calls[i], st, "", false, rsOf[i])
    arrowFactNote(arrowSrcOf(calls[i]), st, rsOf[i], argsOf[i])
    i = i + 1
  }
  return true
}

// The written `let`s in `f`'s body a parameter of `f` initialises.
function arrowSeedBindsIn(f: FuncDecl): i32[] {
  const out: i32[] = []
  const xs: i32[] = [f.fnBody]
  while xs.length > 0 {
    const x = xs.pop()
    if x >= 0 && x < P.nodes.length {
      const n = nodeAt(x)
      if (
        n is LetDecl
        && n.letKw == "let"
        && n.letType < 0
        && arrowSeedParamOf(x, f) >= 0
        && !cwLetWrittenInClosure(x)
      ) {
        out.push(x)
      }
      for c in nodeChildren(x) { xs.push(c) }
    }
  }
  return out
}

// The parameter of `f` binding `b` is initialised with, or -1.
function arrowSeedParamOf(b: i32, f: FuncDecl): i32 {
  const n = nodeAt(b)
  if !(n is LetDecl) || n.letInit < 0 { return -1 }
  const v = parenPeelIx(n.letInit)
  const d = if v >= 0 && v < P.nodes.length && nodeAt(v) is Ident { identDeclOf(v) } else { -1 }
  return if i32ListHas(f.fnParams, d) { d } else { -1 }
}

// Whether every declaration in `ds` is a named function.
function arrowAllNamed(ds: i32[]): boolean {
  for d in ds {
    const f = nodeAt(d)
    if !(f is FuncDecl) || f.fnName == "" || fnNameIsLambda(f.fnName) {
      return false
    }
  }
  return true
}

// Whether some declaration in `ds` has type parameters of its own.
function arrowAnyGeneric(ds: i32[]): boolean {
  for d in ds {
    const f = nodeAt(d)
    if f is FuncDecl && f.fnTyParams.length > 0 { return true }
  }
  return false
}

// `xs` ascending.
function arrowSortedIds(xs: i32[]): i32[] {
  const out: i32[] = []
  for x in xs {
    out.push(x)
    let k = out.length - 1
    while k > 0 && out[k - 1] > x {
      out[k] = out[k - 1]
      k = k - 1
    }
    out[k] = x
  }
  return out
}

// The written bindings `arrowSeedJoins` gave set `s`.
export function arrowSeedBindsOf(s: i32): i32[] {
  const out: i32[] = []
  let i = 0
  while i < afSeedSet.length {
    if afSeedSet[i] == s { out.push(afSeedBind[i]) }
    i = i + 1
  }
  return out
}

// The parameters' sets the bindings of set `s` are seeded with.
export function arrowSeedHeldOf(s: i32): i32[] {
  const out: i32[] = []
  let i = 0
  while i < afSeedSet.length {
    if afSeedSet[i] == s && !i32ListHas(out, afSeedHeld[i]) {
      out.push(afSeedHeld[i])
    }
    i = i + 1
  }
  return out
}

// A call through a function set hands its arguments to each named member's parameters: one vector
// row per member, its holes and type parameters bound at the argument nodes' types, which keep a
// set's identity (STORE B2c). Only a call handing some argument a set has one.
function arrowSetCallRows() {
  for c in fnTagCalls() {
    const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
    const s = fnTagCallSetOf(c)
    if cn is Call && s >= 0 && arrowHandsSet(cn) {
      for m in fnTagMembers(s) {
        const f = nodeAt(m)
        if f is FuncDecl && f.fnName != "" && !fnNameIsLambda(f.fnName) {
          const names: string[] = []
          const tys: i32[] = []
          if arrowMemberBinding(m, f, cn, names, tys) {
            instVecNote(c, IV_SET_CALL, m, m, names, tys)
          }
        }
      }
    }
  }
  return 0
}

// Whether some argument of call `cn` holds a function set, and each set an argument holds has
// named members only: a lambda is built as a closure where it is delivered (B3's).
function arrowHandsSet(cn: Call): boolean {
  let any = false
  for a in cn.callArgs {
    const t = nodeTyIxOf(parenPeelIx(a))
    const hs: i32[] = []
    if fnTagSetOfTy(t) >= 0 { hs.push(fnTagSetOfTy(t)) }
    arrowSetsHeld(t, hs, [])
    for st in hs {
      if !arrowNamedMembers(st) { return false }
      any = true
    }
  }
  return any
}

// Member `f` (at `m`)'s binding at call `cn`'s argument nodes: a parameter with no annotation binds
// its hole, one annotated with a bare type parameter of `f` binds that name. False when the arity
// differs or another annotation reads a type parameter.
function arrowMemberBinding(
  m: i32,
  f: FuncDecl,
  cn: Call,
  names: string[],
  tys: i32[],
): boolean {
  if f.fnParams.length != cn.callArgs.length { return false }
  let i = 0
  while i < f.fnParams.length {
    const pn = nodeAt(f.fnParams[i])
    const at = nodeTyIxOf(parenPeelIx(cn.callArgs[i]))
    if pn is Param && pn.parType < 0 {
      names.push(arrowHolePrefix(f, m) + i32ToStr(i))
      tys.push(at)
    } else if pn is Param {
      const tn = nodeAt(pn.parType)
      if tn is TypeRef && strListHas(f.fnTyParams, tn.tyName) {
        names.push(tn.tyName)
        tys.push(at)
      } else if (
        f.fnTyParams.length > 0
        && tyHasTyVar(nodeTyIxOf(f.fnParams[i]))
      ) {
        return false
      }
    }
    i = i + 1
  }
  return names.length > 0
}

// Whether row `r` pairs a call through a name or call holding a set with a hole call in a declared function no
// member's body holds: such a call's solve validates every body's deferred rows, not its callee's
// alone. A lambda's hole call stands, since a lambda written into the set later is not a member yet.
function arrowRowStray(r: i32): boolean {
  const o = arrowSrcOf(arrowOuterOf(r))
  const on = if o >= 0 && o < P.nodes.length { nodeAt(o) } else { null }
  if !(on is Call) { return false }
  const cf = parenPeelIx(on.callFn)
  // A method's callback is called by the method, so only a name bound to the set, or a call
  // returning it, is the callee.
  const cn = if cf >= 0 { nodeAt(cf) } else { null }
  if !(cn is Ident || cn is Call) || cn is Ident && identFnDeclOf(cf) >= 0 {
    return false
  }
  const s = fnTagSetOfTy(nodeTyIxOf(cf))
  if s < 0 { return false }
  const hole = arrowSrcOf(arrowHoleOf(r))
  const hf = arrowEnclosingFn(hole)
  const hn = if hf >= 0 { nodeAt(hf) } else { null }
  if !(hn is FuncDecl) || hn.fnName == "" || fnNameIsLambda(hn.fnName) {
    return false
  }
  for m in fnTagMembers(s) {
    if crSpans(m, hole) { return false }
  }
  return true
}

// The declared function whose body holds node `x`, or -1.
function arrowEnclosingFn(x: i32): i32 {
  let p = if x >= 0 && x < cwIxParent.length { cwIxParent[x] } else { -1 }
  while p >= 0 && p < P.nodes.length {
    if nodeAt(p) is FuncDecl { return p }
    p = if p < cwIxParent.length { cwIxParent[p] } else { -1 }
  }
  return -1
}
