// The pin solvers' hints, queued for the host to read after the check: one row per hint, in the
// order the solvers raised them, each spanning the name token it is about. A solver's reset drops
// only its own rows, and the driver applies the rule a program with errors owes the walk's hints.
import { P } from "./ast"
import { T } from "./check_types"
import { redunTruncate } from "./check_state"
import { PinSolver } from "./check_pin_refusals"

export let pinHintSolver: PinSolver[] = []
export let pinHintLine: i32[] = []   // 1-based line of the token the hint is about
export let pinHintCol: i32[] = []    // 0-based start column
export let pinHintEnd: i32[] = []    // 0-based exclusive end column, after the token
export let pinHintTok: i32[] = []    // the token, whose module owns the finding
export let pinHintMsg: string[] = []
export let pinHintFix: string[] = [] // the annotation `--fix` inserts at the end of the span

// Queues hint `msg` owed by solver `s` over token `tk`, once per solver and token; a token
// outside the stream raises nothing.
export function pinHint(s: PinSolver, tk: i32, msg: string, fix: string) {
  if tk < 0 || tk >= P.toks.length { return 0 }
  let i = 0
  while i < pinHintTok.length {
    if pinHintTok[i] == tk && pinHintSolver[i] == s { return 0 }
    i = i + 1
  }
  const t = P.toks[tk]
  pinHintSolver.push(s)
  pinHintLine.push(t.line)
  pinHintCol.push(t.col)
  pinHintEnd.push(t.col + t.text.length)
  pinHintTok.push(tk)
  pinHintMsg.push(msg)
  pinHintFix.push(fix)
  0
}

// Drops solver `s`'s rows, keeping the others in their order.
export function pinHintDrop(s: PinSolver) {
  const ss: PinSolver[] = []
  const ls: i32[] = []
  const cs: i32[] = []
  const es: i32[] = []
  const ts: i32[] = []
  const ms: string[] = []
  const fs: string[] = []
  let i = 0
  while i < pinHintTok.length {
    if pinHintSolver[i] != s {
      ss.push(pinHintSolver[i])
      ls.push(pinHintLine[i])
      cs.push(pinHintCol[i])
      es.push(pinHintEnd[i])
      ts.push(pinHintTok[i])
      ms.push(pinHintMsg[i])
      fs.push(pinHintFix[i])
    }
    i = i + 1
  }
  pinHintSolver = ss
  pinHintLine = ls
  pinHintCol = cs
  pinHintEnd = es
  pinHintTok = ts
  pinHintMsg = ms
  pinHintFix = fs
  0
}

// What the last walk's hints owe at report: a program with errors is typed in part against what
// its annotations say, so none of them is reported redundant (D3800).
export function pinHintReport() {
  if T.diags.length > 0 { redunTruncate(0) }
  0
}
