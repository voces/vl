// `cli_budget.vl` — `vl check --budget <baseline>`: a per-file lint ratchet held by the
// lint itself. The baseline is a JSON file naming a `label`, the `writer` that rewrites
// it, the `targets`/`exclude` to walk, the per-code `total`, the per-file counts and the
// named `entries`; the CLI feeds every finding of a budgeted code through `budgetNote`
// and prints `budgetCheckLines` or `budgetWhyLines`, or `budgetWriteText` rewrites the
// baseline from the run. docs/internals/architecture-refactor-plan.md T2.

import { pushCps } from "./strutil"
import { i32ToStr } from "./ast"
import { cliStrGt } from "./cli_util"

let bgLabel = ""
let bgWriter = ""
let bgOkText = ""
let bgRemedyText = ""
let bgCommit = ""
let bgTargets: string[] = []
let bgExclude: string[] = []
let bgCodes: string[] = []
let bgTotal: i32[] = []
let bgFileRel: string[] = []
let bgFileCode: string[] = []
let bgFileN: i32[] = []
let bgHasEntries = false
let bgEntCode: string[] = []
let bgEntName: string[] = []
let bgEntN: i32[] = []
let bgSeen: {[string]: boolean} = Map()
let bgHitCode: string[] = []
let bgHitRel: string[] = []
let bgHitName: string[] = []

// The JSON reader's cursor: the baseline as code points, a position, the first error.
let bjCps: i32[] = []
let bjPos = 0
let bjErr = ""

function bjFail(msg: string) {
  if bjErr == "" { bjErr = msg + " at offset " + i32ToStr(bjPos) }
  0
}
function bjPeek(): i32 {
  while (
    bjPos < bjCps.length
    && (bjCps[bjPos] == ' '
      || bjCps[bjPos] == '\n'
      || bjCps[bjPos] == '\r'
      || bjCps[bjPos] == '\t')
  ) {
    bjPos = bjPos + 1
  }
  if bjPos < bjCps.length { return bjCps[bjPos] }
  -1
}
function bjExpect(c: i32): boolean {
  if bjPeek() == c {
    bjPos = bjPos + 1
    return true
  }
  bjFail("expected `" + fromCodePoints([c]) + "`")
  false
}
function bjHex(c: i32): i32 {
  if c >= '0' && c <= '9' { return c - '0' }
  if c >= 'a' && c <= 'f' { return c - 'a' + 10 }
  if c >= 'A' && c <= 'F' { return c - 'A' + 10 }
  bjFail("bad `\\u` escape")
  0
}
// Four hex digits after a `\u`, the cursor left on the last one.
function bjU4(): i32 {
  if bjPos + 4 >= bjCps.length {
    bjFail("short `\\u` escape")
    return 0
  }
  let v = 0
  let k = 0
  while k < 4 {
    bjPos = bjPos + 1
    v = v * 16 + bjHex(bjCps[bjPos])
    k = k + 1
  }
  v
}
function bjString(): string {
  if bjPeek() != '"' {
    bjFail("expected a string")
    return ""
  }
  bjPos = bjPos + 1
  const out: i32[] = []
  while bjPos < bjCps.length && bjCps[bjPos] != '"' {
    let c = bjCps[bjPos]
    if c == '\\' && bjPos + 1 < bjCps.length {
      bjPos = bjPos + 1
      const e = bjCps[bjPos]
      c = e
      if e == 'n' { c = '\n' }
      if e == 't' { c = '\t' }
      if e == 'r' { c = '\r' }
      if e == 'b' { c = 8 }
      if e == 'f' { c = 12 }
      if e == 'u' {
        c = bjU4()
        // A surrogate pair: `ensure_ascii` output spells one astral code point as two.
        if (
          c >= 55296
          && c < 56320
          && bjPos + 2 < bjCps.length
          && bjCps[bjPos + 1] == '\\'
          && bjCps[bjPos + 2] == 'u'
        ) {
          bjPos = bjPos + 2
          const lo = bjU4()
          c = 65536 + (c - 55296) * 1024 + (lo - 56320)
        }
      }
    }
    out.push(c)
    bjPos = bjPos + 1
  }
  if bjPos >= bjCps.length {
    bjFail("unterminated string")
    return ""
  }
  bjPos = bjPos + 1
  fromCodePoints(out)
}
function bjInt(): i32 {
  let neg = false
  if bjPeek() == '-' {
    neg = true
    bjPos = bjPos + 1
  }
  if bjPos >= bjCps.length || bjCps[bjPos] < '0' || bjCps[bjPos] > '9' {
    bjFail("expected a count")
    return 0
  }
  let v = 0
  while bjPos < bjCps.length && bjCps[bjPos] >= '0' && bjCps[bjPos] <= '9' {
    v = v * 10 + (bjCps[bjPos] - '0')
    bjPos = bjPos + 1
  }
  if neg { return 0 - v }
  v
}
// Step over one value of any shape — a field this reader has no use for.
function bjSkip() {
  const c = bjPeek()
  if c == '"' {
    bjString()
  } else if c == '{' || c == '[' {
    let close = ']'
    if c == '{' { close = '}' }
    bjPos = bjPos + 1
    if bjPeek() == close {
      bjPos = bjPos + 1
      return 0
    }
    while bjErr == "" {
      if c == '{' {
        bjString()
        bjExpect(':')
      }
      bjSkip()
      if bjPeek() != ',' { break }
      bjPos = bjPos + 1
    }
    bjExpect(close)
  } else {
    const start = bjPos
    while (
      bjPos < bjCps.length
      && bjCps[bjPos] != ','
      && bjCps[bjPos] != '}'
      && bjCps[bjPos] != ']'
      && bjCps[bjPos] != ' '
      && bjCps[bjPos] != '\n'
    ) {
      bjPos = bjPos + 1
    }
    if bjPos == start { bjFail("expected a value") }
  }
  0
}
// `[<string>, …]` onto `into`.
function bjStrList(into: string[]) {
  if !bjExpect('[') { return 0 }
  if bjPeek() == ']' {
    bjPos = bjPos + 1
    return 0
  }
  while bjErr == "" {
    into.push(bjString())
    if bjPeek() != ',' { break }
    bjPos = bjPos + 1
  }
  bjExpect(']')
  0
}
// `{<code>: <count>, …}`, each pair handed to `bgCountPair` under `rel` ("" = the total).
function bjCounts(rel: string) {
  if !bjExpect('{') { return 0 }
  if bjPeek() == '}' {
    bjPos = bjPos + 1
    return 0
  }
  while bjErr == "" {
    const code = bjString()
    bjExpect(':')
    const n = bjInt()
    if rel == "" {
      bgCodes.push(code)
      bgTotal.push(n)
    } else {
      bgFileRel.push(rel)
      bgFileCode.push(code)
      bgFileN.push(n)
    }
    if bjPeek() != ',' { break }
    bjPos = bjPos + 1
  }
  bjExpect('}')
  0
}
function bjFiles() {
  if !bjExpect('{') { return 0 }
  if bjPeek() == '}' {
    bjPos = bjPos + 1
    return 0
  }
  while bjErr == "" {
    const rel = bjString()
    bjExpect(':')
    bjCounts(rel)
    if bjPeek() != ',' { break }
    bjPos = bjPos + 1
  }
  bjExpect('}')
  0
}
// `[[<code>, <name>, <hits>], …]`.
function bjEntries() {
  bgHasEntries = true
  if !bjExpect('[') { return 0 }
  if bjPeek() == ']' {
    bjPos = bjPos + 1
    return 0
  }
  while bjErr == "" {
    bjExpect('[')
    bgEntCode.push(bjString())
    bjExpect(',')
    bgEntName.push(bjString())
    bjExpect(',')
    bgEntN.push(bjInt())
    bjExpect(']')
    if bjPeek() != ',' { break }
    bjPos = bjPos + 1
  }
  bjExpect(']')
  0
}

// Read baseline `src`, replacing any earlier one and every finding noted against it.
// Returns "" or what is wrong with the file; a baseline must name a `label` and a `total`.
export function budgetLoad(src: string): string {
  bgLabel = ""
  bgWriter = ""
  bgOkText = ""
  bgRemedyText = ""
  bgCommit = ""
  bgTargets = []
  bgExclude = []
  bgCodes = []
  bgTotal = []
  bgFileRel = []
  bgFileCode = []
  bgFileN = []
  bgHasEntries = false
  bgEntCode = []
  bgEntName = []
  bgEntN = []
  bgSeen = Map()
  bgHitCode = []
  bgHitRel = []
  bgHitName = []
  bjCps = []
  pushCps(bjCps, src)
  bjPos = 0
  bjErr = ""
  if bjExpect('{') && bjPeek() != '}' {
    while bjErr == "" {
      const key = bjString()
      bjExpect(':')
      if key == "label" { bgLabel = bjString() }
      else if key == "writer" { bgWriter = bjString() }
      else if key == "ok" { bgOkText = bjString() }
      else if key == "remedy" { bgRemedyText = bjString() }
      else if key == "commit" { bgCommit = bjString() }
      else if key == "targets" { bjStrList(bgTargets) }
      else if key == "exclude" { bjStrList(bgExclude) }
      else if key == "total" { bjCounts("") }
      else if key == "files" { bjFiles() }
      else if key == "entries" { bjEntries() }
      else { bjSkip() }
      if bjPeek() != ',' { break }
      bjPos = bjPos + 1
    }
  }
  bjExpect('}')
  if bjErr == "" && bgLabel == "" { bjErr = "it names no `label`" }
  if bjErr == "" && bgCodes.length == 0 {
    bjErr = "it budgets no code (`total`)"
  }
  bjCps = []
  bjErr
}

// The paths and `--exclude` globs the baseline says to walk.
export function budgetTargets(): string[] { bgTargets }
export function budgetExcludes(): string[] { bgExclude }

// Whether findings of lint `code` count against the loaded budget.
export function budgetWants(code: string): boolean {
  for c in bgCodes {
    if c == code { return true }
  }
  false
}

// One finding of `code` at `line:col` of checkout-relative `rel`, whose source line is
// `text`. A position already noted (one module reached from two targets) counts once.
export function budgetNote(
  code: string,
  rel: string,
  line: i32,
  col: i32,
  text: string,
) {
  const key = code + " " + rel + ":" + i32ToStr(line) + ":" + i32ToStr(col)
  if bgSeen[key] ?? false { return 0 }
  bgSeen[key] = true
  bgHitCode.push(code)
  bgHitRel.push(rel)
  bgHitName.push(rel + ": " + bgTrim(text))
  0
}
// `s` without leading or trailing ASCII whitespace — how an entry's source line is named.
function bgTrim(s: string): string {
  let a = 0
  let b = s.length
  while a < b && bgIsSpace(s[a]) { a = a + 1 }
  while b > a && bgIsSpace(s[b - 1]) { b = b - 1 }
  s.slice(a, b)
}
function bgIsSpace(c: i32): boolean {
  c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == 11 || c == 12
}

// `xs` sorted by code point and with repeats dropped.
function bgSortedUniq(xs: string[]): string[] {
  const out: string[] = []
  for x in xs {
    let j = out.length
    out.push(x)
    while j > 0 && cliStrGt(out[j - 1], x) {
      out[j] = out[j - 1]
      j = j - 1
    }
    out[j] = x
  }
  const uniq: string[] = []
  for x in out {
    if uniq.length == 0 || uniq[uniq.length - 1] != x { uniq.push(x) }
  }
  uniq
}
function bgBaseCount(rel: string, code: string): i32 {
  let i = 0
  while i < bgFileRel.length {
    if bgFileRel[i] == rel && bgFileCode[i] == code { return bgFileN[i] }
    i = i + 1
  }
  0
}
function bgNowCount(rel: string, code: string): i32 {
  let n = 0
  let i = 0
  while i < bgHitRel.length {
    if bgHitRel[i] == rel && bgHitCode[i] == code { n = n + 1 }
    i = i + 1
  }
  n
}

// The `--budget` report, one line per element; `budgetFailed()` says whether it red.
// A file may only hold its baseline's count of a code or fewer.
let bgFailed = false
export function budgetFailed(): boolean { bgFailed }
export function budgetCheckLines(baselinePath: string): string[] {
  const bad: string[] = []
  for rel in bgSortedUniq(bgHitRel) {
    for code in bgCodes {
      const now = bgNowCount(rel, code)
      const was = bgBaseCount(rel, code)
      if now > was {
        bad.push(
          "  "
            + rel
            + "  "
            + code
            + ": "
            + i32ToStr(now)
            + " (baseline "
            + i32ToStr(was)
            + ")",
        )
      }
    }
  }
  const out: string[] = []
  bgFailed = bad.length > 0
  if bgFailed {
    out.push(bgLabel + " budget REGRESSED — a file may only go down or stay:")
    for b in bad { out.push(b) }
    out.push("")
    if bgRemedyText != "" {
      out.push(bgRemedyText)
    } else {
      out.push("After a rewrite, lower the baseline with")
    }
    out.push("  " + bgRemedy(baselinePath))
    return out
  }
  let ok = bgLabel + " budget ok — "
  let below = false
  let ci = 0
  while ci < bgCodes.length {
    const now = bgRunCount("", bgCodes[ci])
    if now < bgTotal[ci] { below = true }
    if bgOkText == "" {
      if ci > 0 { ok = ok + ", " }
      ok = ok
        + i32ToStr(now)
        + " "
        + bgCodes[ci]
        + " (baseline "
        + i32ToStr(bgTotal[ci])
        + " or below)"
    }
    ci = ci + 1
  }
  if bgOkText != "" { ok = ok + bgSubst(bgOkText) }
  out.push(ok)
  if below {
    out.push(
      "  below baseline — `vl check --budget-why "
        + baselinePath
        + "` names which entries left",
    )
  }
  out
}
// The baseline's own ok sentence with each `{<code>}` replaced by that code's count.
function bgSubst(tmpl: string): string {
  let out = ""
  let i = 0
  while i < tmpl.length {
    const close = bgCloseBrace(tmpl, i)
    if tmpl[i] == '{' && close > i {
      const name = tmpl.slice(i + 1, close)
      let k = 0
      while k < bgCodes.length {
        if bgCodes[k] == name { out = out + i32ToStr(bgRunCount("", name)) }
        k = k + 1
      }
      i = close + 1
    } else {
      out = out + tmpl.slice(i, i + 1)
      i = i + 1
    }
  }
  out
}
// The index of the first `}` at or after `from`, or -1.
function bgCloseBrace(s: string, from: i32): i32 {
  let i = from
  while i < s.length {
    if s[i] == '}' { return i }
    i = i + 1
  }
  -1
}

// The `--budget-why` report: per code, the entries that `LEFT`, `ENTERED` or changed count
// between the baseline's stored `entries` and this run. Without stored entries it is one
// line saying so, and `budgetFailed()` is true.
export function budgetWhyLines(baselinePath: string): string[] {
  const out: string[] = []
  bgFailed = !bgHasEntries
  if bgFailed {
    out.push(
      bgLabel
        + ": the baseline stores no `entries`; re-run `"
        + bgRemedy(baselinePath)
        + "`",
    )
    return out
  }
  out.push(bgLabel + ": " + bgCommit + " -> working tree")
  out.push("")
  let moved = 0
  for code in bgCodes {
    const was: {[string]: i32} = Map()
    const wasNames: string[] = []
    let wasSum = 0
    let i = 0
    while i < bgEntCode.length {
      if bgEntCode[i] == code {
        was[bgEntName[i]] = (was[bgEntName[i]] ?? 0) + bgEntN[i]
        wasNames.push(bgEntName[i])
        wasSum = wasSum + bgEntN[i]
      }
      i = i + 1
    }
    const now: {[string]: i32} = Map()
    const nowNames: string[] = []
    let nowSum = 0
    let h = 0
    while h < bgHitCode.length {
      if bgHitCode[h] == code {
        now[bgHitName[h]] = (now[bgHitName[h]] ?? 0) + 1
        nowNames.push(bgHitName[h])
        nowSum = nowSum + 1
      }
      h = h + 1
    }
    const a = bgSortedUniq(wasNames)
    const b = bgSortedUniq(nowNames)
    out.push(
      code
        + "  "
        + i32ToStr(wasSum)
        + " hits over "
        + i32ToStr(a.length)
        + " names -> "
        + i32ToStr(nowSum)
        + " over "
        + i32ToStr(b.length),
    )
    let setMoved = 0
    for n in a {
      if (now[n] ?? 0) == 0 {
        out.push("  LEFT     " + n + bgTimes(was[n] ?? 0))
        setMoved = setMoved + 1
      }
    }
    for n in b {
      if (was[n] ?? 0) == 0 {
        out.push("  ENTERED  " + n + bgTimes(now[n] ?? 0))
        setMoved = setMoved + 1
      }
    }
    let countMoved = 0
    for n in a {
      const k = now[n] ?? 0
      if k > 0 && k != (was[n] ?? 0) {
        out.push("  " + n + "  " + i32ToStr(was[n] ?? 0) + " -> " + i32ToStr(k))
        countMoved = countMoved + 1
      }
    }
    if wasSum == nowSum && setMoved == 0 {
      out.push("  (the same entries, by name)")
    }
    out.push("")
    moved = moved + setMoved + countMoved
  }
  if moved == 0 {
    out.push(
      "Nothing moved by name. A count that differs without a name moving is the "
        + "instrument, not the tree.",
    )
  }
  out
}
function bgTimes(k: i32): string {
  if k > 1 { return "  (x" + i32ToStr(k) + ")" }
  ""
}

// The command that rewrites the baseline: its `writer` script while one is named, else
// this lint's own `--write-baseline`.
function bgRemedy(baselinePath: string): string {
  if bgWriter != "" { return "python3 " + bgWriter + " --write-baseline" }
  "vl check --budget " + baselinePath + " --write-baseline"
}

// `--exempt-codes`: the budgeted codes the baseline still owes, space-separated — what
// scripts/lint-self.sh holds out of its own gate until each reaches zero.
export function budgetExemptLine(): string {
  let out = ""
  let i = 0
  while i < bgCodes.length {
    if bgTotal[i] > 0 {
      if out != "" { out = out + " " }
      out = out + bgCodes[i]
    }
    i = i + 1
  }
  out
}

// `s` as a JSON string literal, escaped as Python's `json.dumps` does; `ascii` also
// spells every non-ASCII code point as `\u` escapes (`ensure_ascii`).
function bgQuote(s: string, ascii: boolean): string {
  const out: i32[] = ['"']
  for c in s {
    if c == '"' || c == '\\' {
      out.push('\\')
      out.push(c)
    } else if c == '\n' {
      out.push('\\')
      out.push('n')
    } else if c == '\r' {
      out.push('\\')
      out.push('r')
    } else if c == '\t' {
      out.push('\\')
      out.push('t')
    } else if c == 8 {
      out.push('\\')
      out.push('b')
    } else if c == 12 {
      out.push('\\')
      out.push('f')
    } else if c < 32 || (ascii && c > 126) {
      if c > 65535 {
        bgU4(out, 55296 + ((c - 65536) >> 10))
        bgU4(out, 56320 + ((c - 65536) & 1023))
      } else {
        bgU4(out, c)
      }
    } else {
      out.push(c)
    }
  }
  out.push('"')
  fromCodePoints(out)
}
function bgU4(out: i32[], v: i32) {
  const hex = "0123456789abcdef"
  out.push('\\')
  out.push('u')
  let sh = 12
  while sh >= 0 {
    out.push(hex[(v >> sh) & 15])
    sh = sh - 4
  }
  0
}
// `["a", "b"]`, as `json.dumps` spells a string list.
function bgQuoteList(xs: string[]): string {
  let out = "["
  let i = 0
  while i < xs.length {
    if i > 0 { out = out + ", " }
    out = out + bgQuote(xs[i], true)
    i = i + 1
  }
  out + "]"
}
// This run's count of `code` in file `rel`, or over every file when `rel` is "".
function bgRunCount(rel: string, code: string): i32 {
  if rel != "" { return bgNowCount(rel, code) }
  let n = 0
  for c in bgHitCode {
    if c == code { n = n + 1 }
  }
  n
}
// `{"<code>": <n>, …}` over every budgeted code, counted in `rel` ("" = every file).
function bgCountsJson(rel: string): string {
  let out = "{"
  let i = 0
  while i < bgCodes.length {
    if i > 0 { out = out + ", " }
    out = out
      + bgQuote(bgCodes[i], true)
      + ": "
      + i32ToStr(bgRunCount(rel, bgCodes[i]))
    i = i + 1
  }
  out + "}"
}

// The baseline this run counted, laid out line for line as scripts/ratchet.py writes
// one: `label`, `writer`, `targets` and `exclude` kept from the loaded baseline, `commit`
// replaced, counts recounted, and `entries` rewritten when the loaded baseline had them.
export function budgetWriteText(commit: string): string {
  const body: string[] = ["{"]
  if bgLabel != "" { body.push("\"label\": " + bgQuote(bgLabel, true) + ",") }
  if bgWriter != "" {
    body.push("\"writer\": " + bgQuote(bgWriter, true) + ",")
  }
  if bgOkText != "" { body.push("\"ok\": " + bgQuote(bgOkText, true) + ",") }
  if bgRemedyText != "" {
    body.push("\"remedy\": " + bgQuote(bgRemedyText, true) + ",")
  }
  body.push("\"commit\": " + bgQuote(commit, true) + ",")
  if bgTargets.length > 0 {
    body.push("\"targets\": " + bgQuoteList(bgTargets) + ",")
  }
  if bgExclude.length > 0 {
    body.push("\"exclude\": " + bgQuoteList(bgExclude) + ",")
  }
  body.push("\"total\": " + bgCountsJson("") + ",")
  body.push("\"files\": {")
  let rows = ""
  for rel in bgSortedUniq(bgHitRel) {
    if rows != "" { rows = rows + ",\n" }
    rows = rows + bgQuote(rel, true) + ": " + bgCountsJson(rel)
  }
  body.push(rows)
  if bgHasEntries {
    body.push("},")
    body.push("\"entries\": [")
    let ents = ""
    for code in bgSortedUniq(bgCodes) {
      const names: string[] = []
      const hits: {[string]: i32} = Map()
      let h = 0
      while h < bgHitCode.length {
        if bgHitCode[h] == code {
          names.push(bgHitName[h])
          hits[bgHitName[h]] = (hits[bgHitName[h]] ?? 0) + 1
        }
        h = h + 1
      }
      for x in bgSortedUniq(names) {
        if ents != "" { ents = ents + ",\n" }
        ents = ents
          + "["
          + bgQuote(code, false)
          + ", "
          + bgQuote(x, false)
          + ", "
          + i32ToStr(hits[x] ?? 0)
          + "]"
      }
    }
    body.push(ents)
    body.push("]")
  } else {
    body.push("}")
  }
  body.push("}")
  let out = ""
  for l in body { out = out + l + "\n" }
  out
}
// `--write-baseline`'s report: `wrote <path>: <n> <code>, …`.
export function budgetWroteLine(baselinePath: string): string {
  let out = "wrote " + baselinePath + ": "
  let i = 0
  while i < bgCodes.length {
    if i > 0 { out = out + ", " }
    out = out + i32ToStr(bgRunCount("", bgCodes[i])) + " " + bgCodes[i]
    i = i + 1
  }
  out
}

// The checkout's HEAD commit, resolved through the host's file reads alone: a linked
// worktree's `.git` file names its git dir, `commondir` the shared one, and a branch
// resolves through its loose ref or `packed-refs`. `budgetGitStart` returns the first
// path to read and `budgetGitStep` each next one, or "" once `budgetGitCommit` is known.
let bgGitStage = 0
let bgGitDir = ""
let bgGitCommon = ""
let bgGitRef = ""
let bgGitSha = ""
// HEAD's 9-character prefix, as `git rev-parse --short` prints it for this tree; "" when
// HEAD could not be resolved.
export function budgetGitCommit(): string {
  if bgGitSha.length > 9 { return bgGitSha.slice(0, 9) }
  bgGitSha
}
export function budgetGitStart(): string {
  bgGitStage = 0
  bgGitDir = ".git"
  bgGitCommon = ""
  bgGitRef = ""
  bgGitSha = ""
  ".git"
}
export function budgetGitStep(found: boolean, src: string): string {
  const text = bgTrim(src)
  if bgGitStage == 0 {
    if found && text.length > 7 && text.slice(0, 7) == "gitdir:" {
      bgGitDir = bgTrim(text.slice(7, text.length))
    }
    bgGitStage = 1
    return bgGitDir + "/HEAD"
  }
  if bgGitStage == 1 {
    if !found { return "" }
    if text.length > 4 && text.slice(0, 4) == "ref:" {
      bgGitRef = bgTrim(text.slice(4, text.length))
      bgGitStage = 2
      return bgGitDir + "/commondir"
    }
    bgGitSha = text
    return ""
  }
  if bgGitStage == 2 {
    bgGitCommon = bgGitDir
    if found && text != "" {
      bgGitCommon = text
      if text[0] != '/' { bgGitCommon = bgGitDir + "/" + text }
    }
    bgGitStage = 3
    return bgGitCommon + "/" + bgGitRef
  }
  if bgGitStage == 3 {
    if found && text != "" {
      bgGitSha = text
      return ""
    }
    bgGitStage = 4
    return bgGitCommon + "/packed-refs"
  }
  if found { bgGitSha = bgPackedRef(src, " " + bgGitRef) }
  ""
}
// The sha on the `packed-refs` line ending in `suffix`, or "".
function bgPackedRef(src: string, suffix: string): string {
  let a = 0
  let i = 0
  while i <= src.length {
    if i == src.length || src[i] == '\n' {
      const l = bgTrim(src.slice(a, i))
      const k = l.length - suffix.length
      if k > 0 && l.slice(k, l.length) == suffix { return l.slice(0, k) }
      a = i + 1
    }
    i = i + 1
  }
  ""
}
