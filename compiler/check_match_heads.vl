// The nodes `desugarMatchAt` marks when it lowers a `match` to an if/else chain: the heads of
// chains an integer `match` built, and the scrutinee nodes a chain's arm tests share. The
// checker writes them through `noteIntMatchHead` and `noteMatchScrut`; the emitter and the
// join gate read them; `matchHeadsReset` clears them per program. Nothing here imports the
// checker.

// The `IfStmt` heads `desugarMatchAt` built from an INTEGER `match` (1 at the head's index),
// the one chain shape the emitter may lower to a `br_table` (`intMatchHeadAt`).
let intMatchHead: {[i32]: boolean} = Map()
// The scrutinee nodes `desugarMatchAt` shared across a chain's arm tests: one node per `match`,
// so its recorded type is the last arm's and says nothing about any one test (`matchScrutAt`).
let matchScrutNode: {[i32]: boolean} = Map()

export function matchHeadsReset() {
  intMatchHead = Map()
  matchScrutNode = Map()
}

// Mark `ix` as the head of the if-chain an integer `match` desugared to.
export function noteIntMatchHead(ix: i32) { intMatchHead[ix] = true }

// Mark `ix` as the scrutinee node a desugared chain's arm tests share.
export function noteMatchScrut(ix: i32) { matchScrutNode[ix] = true }

// Whether node `ix` is the head of the if-chain an integer `match` desugared to.
export function intMatchHeadAt(ix: i32) {
  if ix < 0 { return false }
  intMatchHead[ix] ?? false
}

// Whether node `ix` is a `match` scrutinee every arm test of its desugared chain reads.
export function matchScrutAt(ix: i32) {
  if ix < 0 { return false }
  matchScrutNode[ix] ?? false
}
