// `check_effect_rows.vl` — the tables behind the per-function effect summary
// (function-effects-design.md §C1). One row per summarised instance, a declaration plus the
// type bindings a call pinned it at, with its step cost and the first write, allocation, host
// call, unknown call and module read it reaches; the scope names and Tarjan bookkeeping of
// the walk that fills them; and per row the heaviest contributor on its costed path. The
// checker computes the rows; `esReset` clears them per program.

// A cost past every budget, standing for "no step bound": a loop, recursion, a call through a
// function value or to the host, or an operator whose lowering loops over its operands.
export const ES_UNBOUNDED = 1000000001

// One row per summarised instance: a declaration plus the type bindings a call pinned it at
// (§C4), keyed by `esKeyOf`. Every column below is parallel to `esDecl`.
export let esKeyIx: {[string]: i32} = Map()
export let esDecl: i32[] = []
export let esBindStart: i32[] = []
export let esBindCount: i32[] = []
export let esBindNames: string[] = []
export let esBindTys: i32[] = []
// The row's cost in steps (-1 not yet costed, else a count or `ES_UNBOUNDED`), and why it has
// no bound ("" while it has one).
export let esCost: i32[] = []
export let esWhy: string[] = []
// The first write, allocation, host call and call of unknown effect the row reaches, "" for
// none, and for each the callee row it came through (-1 when the row's own body does it).
export let esWrite: string[] = []
export let esAlloc: string[] = []
export let esHost: string[] = []
export let esUnknown: string[] = []
// The first module `let` or `extern let` binding the row reads, "" for none (the getter rule:
// a getter describes its receiver, and a helper may not read what the getter may not).
export let esReadLet: string[] = []
export let esReadLetVia: i32[] = []
// Whether the row's write names a place only its own body can see (a parameter's or a local's
// field): a caller re-spells such a write as memory reachable from the callee's arguments.
export let esWriteLocal: boolean[] = []
export let esWhyVia: i32[] = []
export let esWriteVia: i32[] = []
export let esAllocVia: i32[] = []
export let esHostVia: i32[] = []
export let esUnknownVia: i32[] = []
// The names in scope at the node being walked, innermost last, from `esScopeBase` up for the
// row being walked: kind 0 a parameter, 1 a local, 2 a `const` bound directly to a literal the
// body built, whose writes nobody else can see (§C2).
export let esScopeNames: string[] = []
export let esScopeKind: i32[] = []
export let esScopeBase = 0
// Tarjan's bookkeeping over the instance call graph (§C4): visit order, low link, the stack.
export let esOrder: i32[] = []
export let esLow: i32[] = []
export let esOnStack: boolean[] = []
export let esStack: i32[] = []
export let esCounter = 0
// The row whose body is being walked, so `gwErasedIs` can read a type parameter through the
// row's bindings; -1 outside a summary walk, where a type parameter erases as before.
export let esFrame = -1
// Per row, the heaviest contributor on its costed path, for a refusal's path: the callee row
// called most expensively (or -1) and how often, and the string-literal compares' steps and count.
export let gcTopRow: i32[] = []
export let gcTopCount: i32[] = []
export let gcTopSteps: i32[] = []
export let gcCmpSteps: i32[] = []
export let gcCmpCount: i32[] = []
// What the path being costed charged, in order: a callee row (>= 0) or a literal compare of
// length `-e` (< 0). A branch keeps only its dearest arm's entries.
export let gcTrail: i32[] = []

export function esReset() {
  esKeyIx = Map()
  esDecl = []
  esBindStart = []
  esBindCount = []
  esBindNames = []
  esBindTys = []
  esCost = []
  esWhy = []
  esWrite = []
  esAlloc = []
  esHost = []
  esUnknown = []
  esReadLet = []
  esReadLetVia = []
  esWriteLocal = []
  esWhyVia = []
  esWriteVia = []
  esAllocVia = []
  esHostVia = []
  esUnknownVia = []
  esScopeNames = []
  esScopeKind = []
  esScopeBase = 0
  esOrder = []
  esLow = []
  esOnStack = []
  esStack = []
  esCounter = 0
  esFrame = -1
  gcTopRow = []
  gcTopCount = []
  gcTopSteps = []
  gcCmpSteps = []
  gcCmpCount = []
  gcTrail = []
  0
}
