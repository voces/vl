import { pushCps } from "./strutil"
import { demangleSpelling } from "./tyname"

// AST-driven source formatter for the self-hosted VL front end. `formatProgram(progRoot)`
// walks the parser arena and generates canonical VL source from it, as a hybrid:
// expressions are printed structurally (operator spacing, list reflow) with type syntax
// recovered verbatim from source `[start, stop)` spans, since the AST stores types as
// synthetic name strings only; control flow, blocks and statement sequencing are
// pretty-printed, with comments placed around them. The driver supplies source and
// comments through `fmtSetSource` and `fmtAddComment` before the call.
//
// Widths are code points, offsets are bytes. Every number compared against `fmtWidth`, or
// added to a `column`, is a width and is spelled `dispWidth(s)`; every number that indexes
// or slices stays `s.length`. One `.length` left in a width position wraps a line holding
// a non-ASCII character early and silently. What the port covers: `format-notes.md`.

import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  Param,
  Paren,
  Program,
  RetStmt,
  StrLit,
  TypeDecl,
  Unary,
  UnionDecl,
  WhileStmt,
} from "./ast"
import { P, isBodyTyDecl, nodeEndOf } from "./ast"
// The free index-operator declaration-name encoding — the formatter prints the operator
// back in its source spelling, not the name it declares under.
import { opDeclOpOf } from "./ast"
import { fnTpBoundOf } from "./ast"
import {
  binPrecOf,
  branchIsSimple,
  calleePrimary,
  codeColumnBefore,
  codeWidthBefore,
  collapseWs,
  dispWidth,
  elseIsIf,
  exportPrefix,
  hasNewline,
  indentStr,
  isBlankLine,
  isBlockNode,
  isBracedBlock,
  isCloseBraceLine,
  isLeafStmt,
  isOwnLineComment,
  joinLines,
  leadingSpaces,
  nodePos,
  normalizeProgram,
  parenForChain,
  rstrip,
  rstripNl,
  rstripWsAll,
  spaces,
  splitLines,
  tokIndexAt,
  trailingCommentAt,
  trimWs,
  trimWsStart,
  unwrapOuterParen,
} from "./fmt_util"

// ── Configuration ─────────────────────────────────────────────────────────────
let fmtWidth = 80

// The source text whose spans are sliced, plus the lexer's retained comments as parallel
// arrays (one entry per comment): verbatim `//` or `///` text, char-offset start, 1-based
// start line, and a `trailing` flag (1 for after code on its line, 0 for own-line).
// `cmtCursor` is the next unconsumed comment in order.
let fmtSrc = ""
let cmtText: string[] = []
let cmtStart: i32[] = []
let cmtLine: i32[] = []
let cmtTrailing: i32[] = []
let cmtCursor = 0

// Per-line start offsets, indexed by 1-based line, so an offset → line lookup is
// a scan over this small table. Rebuilt by `fmtSetSource`.
let lineStart: i32[] = []

export function fmtSetSource(src: string) {
  fmtSrc = src
  lineStart = []
  lineStart.push(0) // index 0 unused
  lineStart.push(0) // line 1 starts at offset 0
  let i = 0
  while i < src.length {
    if src[i] == '\n' { lineStart.push(i + 1) }
    i = i + 1
  }
  0
}

export function fmtResetComments() {
  cmtText = []
  cmtStart = []
  cmtLine = []
  cmtTrailing = []
  cmtCursor = 0
  0
}

export function fmtAddComment(
  text: string,
  start: i32,
  line: i32,
  trailing: i32,
) {
  cmtText.push(text)
  cmtStart.push(start)
  cmtLine.push(line)
  cmtTrailing.push(trailing)
  0
}

// ── output buffer ─────────────────────────────────────────────────────────────
// The emitted text is built into a flat string list, joined once at the end. A
// nested rendering (function-expression / block-expression body) saves and swaps
// `outBuf` so the inner statements render into a fresh buffer.
let outBuf: string[] = []

// Seed for the top-level `emitStatements`' `prevLine`: the stop line of the last recovered
// import (0 when there are none). It lets the blank-line policy between the import block
// and the first statement match the source. `emitStatements` consumes it on entry and
// resets it to 0, so nested calls are unaffected.
let topPrevLine = 0

function fmtEmitRaw(s: string) {
  outBuf.push(s)
  0
}

// Emit one full line `<indent><text>\n`.
function emitLine(indent: i32, text: string) {
  outBuf.push(indentStr(indent) + text + "\n")
  0
}

// ── low-level source access ───────────────────────────────────────────────────

// The 1-based source line containing char offset `off`. `lineStart` is ascending, so this
// binary-searches the largest index whose offset is `<= off`; a linear scan is O(lines) per
// call and runs per node, which is O(n²) over a whole file.
function lineOf(off: i32) {
  let lo = 1
  let hi = lineStart.length - 1
  let ln = 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    if lineStart[mid] <= off {
      ln = mid
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  ln
}

// The verbatim source slice `[start, stop)` of arena node `ix`, or "" when the
// node has no span (synthesized: `pos < 0`).
function sliceNode(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const start = nodePos(ix)
  const stop = nodeEndOf(ix)
  if start < 0 || stop < 0 || stop > fmtSrc.length || start > stop { return "" }
  // A member-call (`.slice`) cannot be a bare TAIL expression: the self-hosted
  // emitter rejects "unsupported member-call statement". Bind it to a `let` first.
  const r = fmtSrc.slice(start, stop)
  r
}

// The 1-based start line of node `ix`, or 0 when it has no span.
function startLineOf(ix: i32) {
  const p = nodePos(ix)
  if p < 0 { return 0 }
  lineOf(p)
}

// The 1-based stop line of node `ix` (line of the last source char), or 0.
function stopLineOf(ix: i32) {
  const e = nodeEndOf(ix)
  if e < 0 { return 0 }
  if e == 0 { return lineOf(0) }
  lineOf(e - 1)
}

// Trailing-comment alignment, a whole-text post-pass. `vl fmt` normalizes the spacing
// before a trailing comment to a single space; this re-aligns runs of them to a common
// column, over the finished text so it treats every trailing comment uniformly. A comment
// aligns to the widest commented line still leaving room; a wider one keeps its space.

function alignComments(text: string) {
  const lines = splitLines(text)
  const out: string[] = []
  let i = 0
  while i < lines.length {
    if (
      isBlankLine(lines[i]) ||
      isOwnLineComment(lines[i]) ||
      isCloseBraceLine(lines[i])
    ) {
      out.push(lines[i])
      i = i + 1
    } else {
      // A run is consecutive code lines at the same indent; a blank, an own-line comment or
      // an indent change ends it, so a struct's fields do not align against the surrounding
      // declarations. It aligns only when some commented line carries two or more spaces
      // before its `//`. Columns, not offsets: measuring in bytes drags a run rightwards.
      const runIndent = leadingSpaces(lines[i])
      let j = i
      let alignCol = 0
      while (
        j < lines.length &&
        !isBlankLine(lines[j]) &&
        !isOwnLineComment(lines[j]) &&
        !isCloseBraceLine(lines[j]) &&
        leadingSpaces(lines[j]) == runIndent
      ) {
        const c = trailingCommentAt(lines[j])
        if c >= 0 {
          const wc = codeColumnBefore(lines[j], c)
          if wc + 2 <= fmtWidth && wc > alignCol { alignCol = wc }
        }
        j = j + 1
      }
      // Intent = a line narrower than the widest carries padding (>1 space) — the
      // act of aligning is padding the short lines up to a column, so that is the
      // real signal. The widest line ends at one space regardless, so its own
      // spacing doesn't count (else a single stray gap would drag the run).
      let intent = false
      let m = i
      while m < j {
        const c = trailingCommentAt(lines[m])
        if c >= 0 {
          // `c - w` is the author's gap, and it is spaces/tabs — ASCII — so the byte
          // difference is the column difference. It is the only place the two units meet.
          const w = codeWidthBefore(lines[m], c)
          if codeColumnBefore(lines[m], c) < alignCol && c - w >= 2 {
            intent = true
          }
        }
        m = m + 1
      }
      const target = alignCol + 1
      let k = i
      while k < j {
        const c = trailingCommentAt(lines[k])
        if c >= 0 {
          // `w` slices (a byte offset); `wc` positions (a column). The pad is the column
          // gap `col - wc`, never `col - w` — those differ by the line's non-ASCII bytes.
          const w = codeWidthBefore(lines[k], c)
          const wc = codeColumnBefore(lines[k], c)
          let col = wc + 1
          if intent {
            col = target
            if wc >= col || wc + 2 > fmtWidth { col = wc + 1 }
          }
          out.push(
            lines[k].slice(0, w) +
              spaces(col - wc) +
              lines[k].slice(c, lines[k].length),
          )
        } else {
          out.push(lines[k])
        }
        k = k + 1
      }
      i = j
    }
  }
  joinLines(out)
}

// ── comment placement ─────────────────────────────────────────────────────────
// Comments are consumed in source order. `cmtCursor` is the next unconsumed
// comment; all placement helpers advance it monotonically (host `pending` shift).

// Char spans the printer reproduced verbatim in the output (`sliceFallback`). A pending
// comment starting inside one already appears in that text, so the placement helpers skip
// it rather than re-emit it. Spans are recorded rather than the comments consumed, because
// expression rendering is speculative and marking is idempotent where consuming is not.
let vbStart: i32[] = []
let vbStop: i32[] = []

function markVerbatim(start: i32, stop: i32) {
  vbStart.push(start)
  vbStop.push(stop)
  0
}

// Whether comment `k` lies inside a recorded verbatim span (already emitted).
function commentCovered(k: i32) {
  let i = 0
  while i < vbStart.length {
    if cmtStart[k] >= vbStart[i] && cmtStart[k] < vbStop[i] { return true }
    i = i + 1
  }
  false
}

// Advance the cursor past comments a verbatim slice already reproduced.
function skipCovered() {
  while cmtCursor < cmtText.length && commentCovered(cmtCursor) {
    cmtCursor = cmtCursor + 1
  }
  0
}

// Whether any pending comment starts inside the char span `[start, stop)`.
function commentInCharSpan(start: i32, stop: i32) {
  if start < 0 || stop < 0 { return false }
  let i = cmtCursor
  while i < cmtText.length {
    if cmtStart[i] >= stop { return false }
    if cmtStart[i] >= start { return true }
    i = i + 1
  }
  false
}

// Emit every own-line comment that starts strictly before source `line`.
function emitLeadingComments(indent: i32, line: i32) {
  let prev = 0
  skipCovered()
  while cmtCursor < cmtText.length && cmtLine[cmtCursor] < line {
    // Keep a single source blank line between consecutive own-line comments, so a
    // section header stays separated from the comment that follows it.
    if prev > 0 && cmtLine[cmtCursor] - prev > 1 { fmtEmitRaw("\n") }
    emitLine(indent, cmtText[cmtCursor])
    prev = cmtLine[cmtCursor]
    cmtCursor = cmtCursor + 1
    skipCovered()
  }
  // …and a blank between the last comment and the code it precedes.
  if prev > 0 && line > 0 && line - prev > 1 { fmtEmitRaw("\n") }
  0
}

// How many pending comments start strictly before `line` (peek, no consume).
function peekLeadingCount(line: i32) {
  let n = 0
  let i = cmtCursor
  while i < cmtText.length && cmtLine[i] < line {
    if !commentCovered(i) { n = n + 1 }
    i = i + 1
  }
  n
}

// The text of a trailing comment on exactly `line` (consumed), or "" if none.
function trailingOn(line: i32) {
  skipCovered()
  if cmtCursor < cmtText.length {
    const isTrail = cmtTrailing[cmtCursor] == 1
    if isTrail && cmtLine[cmtCursor] == line {
      const t = cmtText[cmtCursor]
      cmtCursor = cmtCursor + 1
      return t
    }
  }
  ""
}

// The count of spaces/tabs in the source immediately before offset `off`.
function gapBefore(off: i32) {
  let g = 0
  let i = off - 1
  while i >= 0 && (fmtSrc[i] == ' ' || fmtSrc[i] == '\t') {
    g = g + 1
    i = i - 1
  }
  g
}

// Suffix form of `trailingOn`: " <comment>" or "". The author's spacing before the comment
// is peeked first — two or more spaces signal an intent to align, preserved as two spaces
// so the alignment post-pass can detect it even on a reconstructed line, where the original
// gap would otherwise be normalized away. A run with no such signal stays at one space.
function trailerSuffix(line: i32) {
  skipCovered()
  let wide = false
  if (
    cmtCursor < cmtText.length &&
    cmtTrailing[cmtCursor] == 1 &&
    cmtLine[cmtCursor] == line
  ) {
    if gapBefore(cmtStart[cmtCursor]) >= 2 { wide = true }
  }
  const t = trailingOn(line)
  if t.length == 0 { return "" }
  if wide { return "  " + t }
  " " + t
}

// Drain every remaining comment as own-line text at `indent`.
function flushRemaining(indent: i32) {
  skipCovered()
  while cmtCursor < cmtText.length {
    emitLine(indent, cmtText[cmtCursor])
    cmtCursor = cmtCursor + 1
    skipCovered()
  }
  0
}

// Comment-aware verbatim fallback for a construct printed from its source slice. A slice
// with no comment inside collapses to one line; one containing a `//` must keep its line
// structure, since collapsing would splice the following code and the closing brace onto
// the comment's line. Such a slice is reproduced verbatim and its span recorded.
function sliceFallback(ix: i32) {
  const start = nodePos(ix)
  const stop = nodeEndOf(ix)
  if !commentInCharSpan(start, stop) { return collapseWs(sliceNode(ix)) }
  markVerbatim(start, stop)
  rstripWsAll(sliceNode(ix))
}

// Whether any pending comment starts on a line within `[startLine, stopLine]`.
function commentInSpan(startLine: i32, stopLine: i32) {
  let i = cmtCursor
  while i < cmtText.length {
    const cl = cmtLine[i]
    if cl < startLine { i = i + 1 }
    else if cl > stopLine { return false }
    else { return true }
  }
  false
}

// ── entry ─────────────────────────────────────────────────────────────────────

// Format the program rooted at arena index `progRoot`. Returns the canonical
// source string.
export function formatProgram(progRoot: i32) {
  fmtWidth = 80
  outBuf = []
  cmtCursor = 0
  vbStart = []
  vbStop = []
  if progRoot < 0 || progRoot >= P.nodes.length { return "" }
  const root = P.nodes[progRoot]
  if root is Program {
    // Imports are emitted from the token stream, so the parser's `ImportDecl` nodes are
    // filtered out of the statement walk; emitting them there too would duplicate every
    // import. D1045 — a body-scoped `type` is filtered one scope in for the same reason:
    // the parser hoists it into `progStmts` and it stays at its lexical position as well.
    topPrevLine = emitImports()
    const stmts: i32[] = []
    let fi = 0
    while fi < root.progStmts.length {
      const fn = P.nodes[root.progStmts[fi]]
      if !(fn is ImportDecl) {
        if !isBodyTyDecl(root.progStmts[fi]) { stmts.push(root.progStmts[fi]) }
      }
      fi = fi + 1
    }
    emitStatements(stmts, 0)
    flushRemaining(0)
  }
  const text = joinOut()
  alignComments(normalizeProgram(text))
}

// Format one recovered `import` or re-export spanning tokens `[kw .. pathTok]`. A braced
// form is reconstructed and reflowed through `wrapList` — one line when it fits in
// `fmtWidth`, else one name per line with a trailing comma — which both wraps a long import
// and normalizes an already-wrapped one. A non-braced form is kept verbatim.
function fmtImport(kw: i32, pathTok: i32) {
  const t = P.toks[kw]
  const endTok = P.toks[pathTok]
  const afterKw = kw + 1
  if afterKw >= P.toks.length || P.toks[afterKw].kind != "LBRACE" {
    return fmtSrc.slice(t.start, endTok.start + endTok.text.length)
  }
  // A comment inside the braces cannot ride the reflowed list — rebuilt on one
  // line, the `//` would swallow the names after it and the `} from "…"` tail
  // (and the wrapped form would tear it off its name). Keep such an import
  // verbatim; the caller consumes the comments the slice reproduces.
  if importHasComment(t.start, endTok.start) {
    return fmtSrc.slice(t.start, endTok.start + endTok.text.length)
  }
  // The flat `{ … }` name list: find its closing `}` (imports never nest braces).
  let rb = afterKw + 1
  while rb < pathTok && P.toks[rb].kind != "RBRACE" { rb = rb + 1 }
  const lbrace = P.toks[afterKw]
  const rbrace = P.toks[rb]
  const inner = fmtSrc.slice(lbrace.start + lbrace.text.length, rbrace.start)
  // Split on top-level commas; each item (a bare name or `a as b`) is whitespace-collapsed.
  const items: string[] = []
  let cur = ""
  let p = 0
  while p < inner.length {
    if inner[p] == ',' {
      const it = trimWs(collapseWs(cur))
      if it.length > 0 { items.push(it) }
      cur = ""
    } else {
      cur = cur + fromCodePoint(inner[p])
    }
    p = p + 1
  }
  const last = trimWs(collapseWs(cur))
  if last.length > 0 { items.push(last) }
  // Sort the names (a `{ … }` list is a set — order is not significant), so the wrapped
  // one-per-line block reads alphabetically and duplicate/stale imports are easy to spot.
  // Case-sensitive ASCII: capitalised types/singletons (`P`, `T`, `Tok`) sort before
  // lowercase functions. An `a as b` item sorts by its full text (i.e. the source name `a`).
  fmtSortNames(items)
  const head = t.text + " "
  const tail = " from " + endTok.text
  head +
    wrapList("{ ", items, " }", 0, dispWidth(head) + dispWidth(tail)) +
    tail
}

// Whether any pending comment starts inside the char span `[start, stop)` — a
// comment within an `import`/re-export statement's extent.
function importHasComment(start: i32, stop: i32) {
  let i = cmtCursor
  while i < cmtText.length {
    if cmtStart[i] >= stop { return false }
    if cmtStart[i] >= start { return true }
    i = i + 1
  }
  false
}

// Lexicographic (case-sensitive, code-point) `a < b`.
function fmtNameLess(a: string, b: string) {
  let i = 0
  while i < a.length && i < b.length {
    if a[i] != b[i] { return a[i] < b[i] }
    i = i + 1
  }
  a.length < b.length
}
// In-place insertion sort of import-name items by `fmtNameLess` (lists are short).
function fmtSortNames(items: string[]) {
  let i = 1
  while i < items.length {
    const key = items[i]
    let j = i - 1
    while j >= 0 && fmtNameLess(key, items[j]) {
      items[j + 1] = items[j]
      j = j - 1
    }
    items[j + 1] = key
    i = i + 1
  }
  0
}

// Recover `import { … } from "path"` and re-export `export { … } from "path"` statements
// from `P.toks`, which the parser consumes without building a node — a re-export being an
// `EXPORT` immediately followed by `{`, since `export function` is a declaration the parser
// keeps. Each is sliced verbatim from keyword to path; returns the last stop line, or 0.
function emitImports() {
  let prevLine = 0
  let i = 0
  while i < P.toks.length {
    const t = P.toks[i]
    let isReExport = false
    if t.kind == "EXPORT" && i + 1 < P.toks.length {
      if P.toks[i + 1].kind == "LBRACE" { isReExport = true }
    }
    if t.kind == "IMPORT" || isReExport {
      let j = i
      let found = -1
      while j < P.toks.length && found < 0 {
        if P.toks[j].kind == "STRING" { found = j }
        j = j + 1
      }
      if found < 0 { return prevLine }
      const endTok = P.toks[found]
      const startLine = t.line
      const leading = peekLeadingCount(startLine)
      if (
        prevLine > 0 &&
        startLine - prevLine > 1 + leading &&
        outBuf.length > 0
      ) {
        fmtEmitRaw("\n")
      }
      emitLeadingComments(0, startLine)
      const src = fmtImport(i, found)
      // A comment-bearing import came back verbatim with its interior comments
      // reproduced in place — consume them so they are not re-emitted after it
      // (no-op for the reflowed form: no pending comment lies in its span).
      consumeInlineSpan(startLine, endTok.line)
      emitLine(0, src + trailerSuffix(endTok.line))
      prevLine = endTok.line
      i = found + 1
    } else {
      i = i + 1
    }
  }
  prevLine
}

// Concatenate all of `outBuf` into one exactly-sized code-point buffer,
// materialized once — O(n) total allocation (see `joinLinesRange` for why the
// single buffer beats both the O(n²) running accumulator and the O(n log n)
// divide-and-conquer concat, especially under wasmtime's libcall `array.copy`).
function joinOut() {
  if outBuf.length == 0 { return "" }
  if outBuf.length == 1 { return outBuf[0] }
  let total = 0
  let i = 0
  while i < outBuf.length {
    total = total + outBuf[i].length
    i = i + 1
  }
  // A growing code-point buffer: `total` sums `.length`s, which are byte counts, while
  // `fromCodePoints` takes code points, so an exact-fit `__array_new__` would be sized in
  // the wrong unit. `.push`'s 2x growth bounds the copying at 2N, and the O(n²) `s = s + p`
  // accumulator is what both forms avoid.
  const buf: i32[] = []
  i = 0
  while i < outBuf.length {
    pushCps(buf, outBuf[i])
    i = i + 1
  }
  fromCodePoints(buf)
}

// ── statements ────────────────────────────────────────────────────────────────

// The end index (exclusive) of a maximal run `stmts[from..]` the author wrote on one source
// line as a `;`-joined sequence, every member a leaf statement. `from + 1` when there is no
// such run — the next statement is on another line, or is not a leaf.
function sameLineRunEnd(stmts: i32[], from: i32) {
  const line0 = startLineOf(stmts[from])
  if line0 == 0 || !isLeafStmt(stmts[from]) { return from + 1 }
  let j = from + 1
  let going = j < stmts.length
  while going {
    if !isLeafStmt(stmts[j]) || startLineOf(stmts[j]) != line0 {
      going = false
    } else {
      j = j + 1
      going = j < stmts.length
    }
  }
  j
}

// Emit a sequence of statements at `indent`, preserving a single source blank line between
// them and placing own-line and trailing comments.
function emitStatements(stmts: i32[], indent: i32) {
  let prevLine = topPrevLine
  topPrevLine = 0
  // A non-zero seed means this walk starts right after the top-level import
  // block: guarantee exactly one blank line between it and the first statement
  // (or its leading comment block), whatever the source had. Consumed on the
  // first statement; nested walks see a zero seed and are unaffected.
  let afterImports = prevLine > 0
  let i = 0
  while i < stmts.length {
    const ix = stmts[i]
    // A comment reproduced inside the previous statement's verbatim slice must
    // not steer this statement's blank-line policy — skip covered ones first.
    skipCovered()
    let sLine = startLineOf(ix)
    // A synthesized statement (no span) gets `0`; sequence it right after the
    // previous one. (`< 1` not `== 0`: a bare `== 0` if-cond whose body reassigns
    // trips a frozen-host emitter quirk — see the format.vl header gotchas.)
    if sLine < 1 { sLine = prevLine + 1 }
    // Preserve a single blank line before this statement's leading comment block
    // (or the statement itself, if none): measure the gap to the first pending
    // comment, not the statement, so a blank line within the comment block is
    // accounted for there (emitLeadingComments) rather than mistaken for one here.
    let gapTo = sLine
    if cmtCursor < cmtText.length && cmtLine[cmtCursor] < sLine {
      gapTo = cmtLine[cmtCursor]
    }
    if prevLine > 0 && outBuf.length > 0 {
      if afterImports || gapTo - prevLine > 1 { fmtEmitRaw("\n") }
    }
    afterImports = false
    emitLeadingComments(indent, sLine)
    // Preserve a `;`-joined one-liner: a run of leaf statements the user put on one source
    // line is re-emitted joined by `; ` IF it fits in the width (else each on its own line).
    // Bail when a comment sits on that line (a trailing `// …` would be lost) — the per-
    // statement path below handles it. Never introduce a join across separate source lines.
    let grouped = false
    const runEnd = sameLineRunEnd(stmts, i)
    if runEnd - i >= 2 && !commentInSpan(sLine, sLine) {
      let joined = ""
      let ok = true
      let g = i
      while g < runEnd {
        const inner = statementInline(stmts[g], indent)
        if hasNewline(inner) { ok = false }
        if g > i { joined = joined + "; " }
        joined = joined + inner
        g = g + 1
      }
      if ok && indent * 2 + dispWidth(joined) <= fmtWidth {
        emitLine(indent, joined)
      } else {
        // The one-liner is over the width (or an item went multi-line): expand the whole
        // run to one statement per line — never a partial regroup of the tail.
        let e = i
        while e < runEnd {
          emitStatement(stmts[e], indent)
          e = e + 1
        }
      }
      prevLine = sLine
      i = runEnd
      grouped = true
    }
    if !grouped {
      emitStatement(ix, indent)
      const sl = stopLineOf(ix)
      if sl == 0 { prevLine = sLine } else { prevLine = sl }
      i = i + 1
    }
  }
  0
}

// Emit one closing `}` at `indent`, attaching a trailing comment on `stopLine`.
function closingBrace(indent: i32, stopLine: i32) {
  let suffix = ""
  if stopLine > 0 { suffix = trailerSuffix(stopLine) }
  emitLine(indent, "}" + suffix)
  0
}

function emitStatement(ix: i32, indent: i32) {
  const n = P.nodes[ix]
  if n is LetDecl {
    emitLet(ix, n, indent)
  } else if n is RetStmt {
    emitReturn(n, indent)
  } else if n is WhileStmt {
    emitWhile(ix, n, indent)
  } else if n is ForRange {
    emitForRange(ix, n, indent)
  } else if n is ForIn {
    emitForIn(ix, n, indent)
  } else if n is BreakStmt {
    emitBreakContinue(n.brkKw, n.brkLabel, indent, ix)
  } else if n is ContinueStmt {
    emitBreakContinue(n.contKw, n.contLabel, indent, ix)
  } else if n is Block {
    emitBlockStatement(ix, n, indent)
  } else if n is IfStmt {
    emitIf(ix, n, indent)
  } else if n is FuncDecl {
    emitFunction(ix, n, indent)
  } else if n is TypeDecl {
    emitTypeOrUnionDecl(ix, indent, true)
  } else if n is UnionDecl {
    emitTypeOrUnionDecl(ix, indent, false)
  } else {
    emitExpressionStatement(ix, indent)
  }
  0
}

// Emit a possibly-multiline rendering at `indent`, attaching a trailing comment on `line`
// to the last emitted line. Only the first line is indented here: an expression renders its
// continuation lines already carrying their absolute indentation, so re-indenting them
// would double-count the statement's own indent.
function emitMultiline(rendered: string, indent: i32, line: i32) {
  const suffix = trailerSuffix(line)
  const lines = splitLines(rendered)
  let i = 0
  while i < lines.length {
    const last = i == lines.length - 1
    let tail = ""
    if last { tail = suffix }
    let pre = ""
    if i == 0 { pre = indentStr(indent) }
    outBuf.push(pre + lines[i] + tail + "\n")
    i = i + 1
  }
  0
}

// The visual column a statement's expression starts at is the leading indent plus any
// keyword or binding prefix already on the line. That absolute column is passed into `expr`
// so the width checks in `wrapList` and `binaryChain` account for the indentation;
// otherwise a deeply-indented over-width call measures as if it began at column 0.
function emitExpressionStatement(ix: i32, indent: i32) {
  const line = stopLineOf(ix)
  const rendered = expr(ix, indent, indent * 2)
  emitMultiline(rendered, indent, line)
  0
}

function emitLet(ix: i32, node: LetDecl, indent: i32) {
  const line = stopLineOf(ix)
  let head = exportPrefix(ix) + node.letKw + " " + node.letName
  if node.letType >= 0 { head = head + ": " + recoverType(node.letType) }
  if node.letInit >= 0 {
    const valueText = expr(
      node.letInit,
      indent,
      indent * 2 + dispWidth(head) + 3,
    )
    emitMultiline(head + " = " + valueText, indent, line)
  } else {
    emitMultiline(head, indent, line)
  }
  0
}

// Recover a type-annotation node's source verbatim (collapsed whitespace).
function recoverType(ix: i32) { collapseWs(sliceNode(ix)) }

function emitReturn(node: RetStmt, indent: i32) {
  if node.retArg < 0 {
    let kwLine = 0
    if node.pos >= 0 { kwLine = lineOf(node.pos) }
    emitMultiline("return", indent, kwLine)
    return 0
  }
  const line = stopLineOf(node.retArg)
  const valueText = expr(node.retArg, indent, indent * 2 + 7)
  emitMultiline("return " + valueText, indent, line)
  0
}

function emitBreakContinue(kw: string, label: string, indent: i32, ix: i32) {
  const line = stopLineOf(ix)
  if label.length > 0 {
    emitMultiline(kw + " " + label, indent, line)
  } else {
    emitMultiline(kw, indent, line)
  }
  0
}

// Consume the comments the verbatim slice of a type or union declaration already reproduces
// inline — every pending comment on lines [startLine, stopLine] except a trailing comment on
// the closing line, which sits after the `}` and is emitted by `trailerSuffix`. Without this
// they are re-emitted as own-line comments after the declaration.
function consumeInlineSpan(startLine: i32, stopLine: i32) {
  while cmtCursor < cmtText.length && cmtLine[cmtCursor] <= stopLine {
    if cmtLine[cmtCursor] < startLine { return 0 }
    if cmtLine[cmtCursor] == stopLine && cmtTrailing[cmtCursor] == 1 {
      return 0
    }
    cmtCursor = cmtCursor + 1
  }
  0
}

// Split `s` at every top-level occurrence of `sep`, returning each part trimmed. Top-level
// means not nested inside `()`/`[]`/`{}`/`<>` and not inside a string; the `>` of a `=>`
// arrow is not a bracket close, so a function type in a field stays intact. It breaks a
// union's `|` members and a struct's `,` fields when a single-line declaration is too wide.
function splitTopLevel(s: string, sep: string) {
  const parts: string[] = []
  let depth = 0
  let inStr = false
  let start = 0
  let i = 0
  while i < s.length {
    const c = s[i]
    if inStr {
      if c == '"' { inStr = false }
    } else if c == '"' {
      inStr = true
    } else if c == '(' || c == '[' || c == '{' || c == '<' {
      depth = depth + 1
    } else if c == ')' || c == ']' || c == '}' {
      depth = depth - 1
    } else if c == '>' {
      if i == 0 || s[i - 1] != '=' { depth = depth - 1 }
    } else if depth == 0 && c == sep[0] {
      parts.push(rstrip(trimWsStart(s.slice(start, i))))
      start = i + 1
    }
    i = i + 1
  }
  parts.push(rstrip(trimWsStart(s.slice(start, s.length))))
  parts
}

// Wrap an over-width single-line type declaration across lines at `indent`; `suffix` goes
// on the final line. Returns `true` when it wrapped, `false` for a shape with no wrapping
// rule, so the caller falls back to verbatim. `isRecord` is the parser's own verdict,
// threaded down: asking the rendered text instead emits a declaration that re-parses wrong.
function wrapTypeDecl(
  codeLine: string,
  indent: i32,
  suffix: string,
  isRecord: boolean,
) {
  let eq = 0
  let found = false
  while eq < codeLine.length && !found {
    if codeLine[eq] == '=' { found = true } else { eq = eq + 1 }
  }
  if !found { return false }
  const head = rstrip(codeLine.slice(0, eq + 1)) // `export type N =`
  const body = rstrip(trimWsStart(codeLine.slice(eq + 1, codeLine.length)))
  if isRecord && body.length > 1 {
    // struct record — the RHS is exactly `{ … }`, so the peel is sound
    const inner = body.slice(1, body.length - 1)
    const rawFields = splitTopLevel(inner, ",")
    const fields: string[] = []
    let fi = 0
    while fi < rawFields.length {
      if rawFields[fi].length > 0 { fields.push(rawFields[fi]) }
      fi = fi + 1
    }
    if fields.length == 0 { return false }
    emitLine(indent, head + " {")
    let k = 0
    while k < fields.length {
      emitLine(indent + 1, fields[k] + ",")
      k = k + 1
    }
    // The decl's trailing comment belongs on the closing brace (where it sat,
    // after `}`), not on the last field — and this matches the verbatim re-emit
    // of the now-multi-line decl, keeping the format idempotent.
    emitLine(indent, "}" + suffix)
    return true
  }
  const members = splitTopLevel(body, "|")
  if members.length < 2 { return false }
  emitLine(indent, head + " " + members[0])
  let m = 1
  while m < members.length {
    let tail = ""
    if m == members.length - 1 { tail = suffix }
    emitLine(indent + 1, "| " + members[m] + tail)
    m = m + 1
  }
  true
}

// A `type` or union declaration, recovered verbatim from source because the AST discards
// the field and variant type syntax. A multi-line declaration keeps its interior layout.
// The span may include a trailing newline — a union's last consumed token is the line break
// after the final variant name — which is stripped so no empty line is emitted.
function emitTypeOrUnionDecl(ix: i32, indent: i32, isRecord: boolean) {
  const raw = rstripWsAll(sliceNode(ix))
  const lines = splitLines(raw)
  const stopLine = stopLineOf(ix)
  // The slice reproduces the decl verbatim (including any inline comments inside
  // it — the trailing comment on the opening line and per-field comments), so mark
  // those consumed before reading the closing trailer. The parser drops `export`,
  // so recover it from the token stream (like let/function).
  consumeInlineSpan(startLineOf(ix), stopLine)
  const suffix = trailerSuffix(stopLine)
  // A single-line declaration whose code overflows the width gets wrapped, one union member
  // or struct field per line. The width test ignores `suffix`, so a declaration that fits in
  // code and only overflows via its trailing comment stays on one line. An already
  // multi-line declaration keeps its layout.
  if lines.length == 1 {
    const codeLine = exportPrefix(ix) + trimWsStart(lines[0])
    if indent * 2 + dispWidth(codeLine) > fmtWidth {
      if wrapTypeDecl(codeLine, indent, suffix, isRecord) { return 0 }
    }
  }
  let i = 0
  while i < lines.length {
    const last = i == lines.length - 1
    let tail = ""
    if last { tail = suffix }
    if i == 0 {
      emitLine(indent, exportPrefix(ix) + trimWsStart(lines[i]) + tail)
    } else {
      outBuf.push(rstrip(lines[i]) + tail + "\n")
    }
    i = i + 1
  }
  0
}

function emitBlockStatement(ix: i32, node: Block, indent: i32) {
  emitLine(indent, "{")
  emitStatements(node.blkStmts, indent + 1)
  closingBrace(indent, stopLineOf(ix))
  0
}

// ── control flow ──────────────────────────────────────────────────────────────

function emitWhile(ix: i32, node: WhileStmt, indent: i32) {
  let label = ""
  if node.whileLabel.length > 0 { label = node.whileLabel + ": " }
  if isBracedBlock(node.whileBody) {
    const cond = expr(node.whileCond, indent, 0)
    const inline = inlineBlockBody(node.whileBody, indent)
    if (
      !hasNewline(cond) &&
      inline.length > 0 &&
      indent * 2 +
        dispWidth(label) +
        6 +
        dispWidth(cond) +
        1 +
        dispWidth(inline) <=
        fmtWidth
    ) {
      emitLine(indent, label + "while " + cond + " " + inline)
    } else {
      emitCondHead(indent, label + "while ", node.whileCond, " {")
      emitBlockBody(node.whileBody, indent)
      closingBrace(indent, stopLineOf(node.whileBody))
    }
  } else {
    const cond = expr(node.whileCond, indent, 0)
    const headerLine = startLineOf(ix)
    const suffix = trailerSuffix(headerLine)
    emitLine(indent, label + "while " + cond + suffix)
    emitBareBody(node.whileBody, indent + 1)
  }
  0
}

// Emit the statements inside a braced block body (the `{ … }` interior).
function emitBlockBody(blockIx: i32, indent: i32) {
  const n = P.nodes[blockIx]
  if n is Block {
    emitStatements(n.blkStmts, indent + 1)
    // Flush comments that sit inside the block after its last statement (or in an
    // empty block) but before the closing `}`. Without this they stay pending and
    // bind to the next statement emitted — e.g. a `// skip` in an empty `if` branch
    // would reappear inside the following `else if` branch.
    emitLeadingComments(indent + 1, stopLineOf(blockIx))
  }
  0
}

// Emit a synthesized one-statement body (a bare loop/fn body) at `indent`.
function emitBareBody(blockIx: i32, indent: i32) {
  const n = P.nodes[blockIx]
  if n is Block {
    const st = n.blkStmts
    if st.length > 0 { emitStatement(st[0], indent) }
  }
  0
}

function emitForRange(ix: i32, node: ForRange, indent: i32) {
  let label = ""
  if node.frLabel.length > 0 { label = node.frLabel + ": " }
  const from = expr(node.frFrom, indent, 0)
  const to = expr(node.frTo, indent, 0)
  let head = label + "for " + node.frVar + " in " + from + " to " + to
  if node.frStep >= 0 { head = head + " step " + expr(node.frStep, indent, 0) }
  emitLoopBody(head, node.frBody, indent, startLineOf(ix))
  0
}

function emitForIn(ix: i32, node: ForIn, indent: i32) {
  let label = ""
  if node.fiLabel.length > 0 { label = node.fiLabel + ": " }
  const iter = expr(node.fiIter, indent, 0)
  const head = label + "for " + node.fiVar + " in " + iter
  emitLoopBody(head, node.fiBody, indent, startLineOf(ix))
  0
}

function emitLoopBody(head: string, body: i32, indent: i32, headerLine: i32) {
  if isBracedBlock(body) {
    const inline = inlineBlockBody(body, indent)
    if (
      inline.length > 0 &&
      indent * 2 + dispWidth(head) + 1 + dispWidth(inline) <= fmtWidth
    ) {
      emitLine(indent, head + " " + inline)
    } else {
      emitLine(indent, head + " {")
      emitBlockBody(body, indent)
      closingBrace(indent, stopLineOf(body))
    }
  } else {
    let suffix = ""
    if headerLine > 0 { suffix = trailerSuffix(headerLine) }
    emitLine(indent, head + suffix)
    emitBareBody(body, indent + 1)
  }
  0
}

function emitIf(ix: i32, node: IfStmt, indent: i32) {
  // An `if … else if … [else]` chain renders as a clause sequence (one clause
  // per line, or the block layout).
  const didChain = emitIfChain(ix, node, indent)
  if didChain { return 0 }
  // Every branch renders braced — a branch parsed from the bare single-statement sugar (a
  // synthesized one-statement `Block`, `pos < 0`) folds to the same one-line
  // `if cond { stmt }` a braced source does. There is no `then` spelling (DECISIONS.md).
  const oneLine = collapseSingleIf(ix, node, indent)
  if oneLine.length > 0 {
    emitLine(indent, oneLine)
    return 0
  }
  emitCondHead(indent, "if ", node.ifCond, " {")
  emitBlockBody(node.ifThen, indent)
  if node.ifElse >= 0 {
    emitLine(indent, "} else {")
    emitBlockBody(node.ifElse, indent)
  }
  closingBrace(indent, stopLineOf(ix))
  0
}

// The single inline statement of a synthesized one-statement block.
function bareBodyInline(blockIx: i32, indent: i32) {
  const n = P.nodes[blockIx]
  if n is Block {
    const st = n.blkStmts
    if st.length > 0 { return statementInline(st[0], indent) }
  }
  ""
}

// One-line `if cond { stmt }` (+ optional `else { stmt }`) or "" when it can't
// collapse (multi-statement / compound body, overlapping comment, or too wide).
function collapseSingleIf(_ix: i32, node: IfStmt, indent: i32) {
  const thenBody = inlineBlockBody(node.ifThen, indent)
  if thenBody.length == 0 { return "" }
  const cond = expr(node.ifCond, indent, 0)
  let line = "if " + cond + " " + thenBody
  if node.ifElse >= 0 {
    const elseBody = inlineBlockBody(node.ifElse, indent)
    if elseBody.length == 0 { return "" }
    line = line + " else " + elseBody
  }
  if indent * 2 + dispWidth(line) > fmtWidth { return "" }
  line
}

// Render a brace block with a single simple statement inline as `{ stmt }`, or
// `{}` when empty. Returns "" when the body can't inline.
function inlineBlockBody(blockIx: i32, indent: i32) {
  const n = P.nodes[blockIx]
  if n is Block {
    const sl = startLineOf(blockIx)
    const el = stopLineOf(blockIx)
    if sl > 0 && commentInSpan(sl, el) { return "" }
    const st = n.blkStmts
    if st.length == 0 { return "{}" }
    // A multi-statement body inlines only when the author wrote every statement on the
    // same source line — a `;`-joined one-liner. That is preserved, rejoined with `; `,
    // but never introduced across separate lines; the caller width-checks the result. A
    // single statement inlines regardless.
    if st.length > 1 {
      const line0 = startLineOf(st[0])
      if line0 == 0 { return "" }
      let li = 1
      while li < st.length {
        if startLineOf(st[li]) != line0 { return "" }
        li = li + 1
      }
    }
    let parts = ""
    let i = 0
    while i < st.length {
      if !isLeafStmt(st[i]) { return "" }
      const inner = statementInline(st[i], indent)
      if hasNewline(inner) { return "" }
      if i > 0 { parts = parts + "; " }
      parts = parts + inner
      i = i + 1
    }
    "{ " + parts + " }"
  } else {
    ""
  }
}

// Render an `if … else if … [else]` chain whose every branch is a brace block, in the
// canonical multi-conditional layout (`if cond {` / `} else if cond {` / `} else {` / `}`).
// A chain is a nested `IfStmt` in the `ifElse` slot, detected by `elseIsIf`. Returns false
// when the node is not such a chain, and the caller then uses the plain forms. No collapse.
function emitIfChain(ix: i32, node: IfStmt, indent: i32) {
  if !elseIsIf(node.ifElse) { return false }
  // Collect clause condition + body arena indices walking the chain.
  const condIxs: i32[] = []
  const bodyIxs: i32[] = []
  let hasElse = false
  let elseBodyIx = -1
  let curIx = ix
  let walking = true
  while walking {
    const c = P.nodes[curIx]
    if c is IfStmt {
      condIxs.push(c.ifCond)
      bodyIxs.push(c.ifThen)
      const e = c.ifElse
      if e < 0 {
        walking = false
      } else if elseIsIf(e) {
        curIx = e
      } else {
        hasElse = true
        elseBodyIx = e
        walking = false
      }
    } else {
      walking = false
    }
  }
  // A clause body is a Block whether the source braced it or the bare
  // single-statement sugar synthesized it (`pos < 0`) — both render braced.
  let i = 0
  while i < bodyIxs.length {
    if !isBlockNode(bodyIxs[i]) { return false }
    i = i + 1
  }
  if hasElse {
    if !isBlockNode(elseBodyIx) { return false }
  }
  // Per-clause inline layout: when no comment falls inside the chain and every clause body
  // is a single simple statement whose `if c { x }` line fits, render one clause per line.
  // The parser accepts `else` on a new line, so this round-trips; otherwise fall through to
  // the block layout below.
  if !commentInSpan(startLineOf(ix), stopLineOf(ix)) {
    const clauseLines: string[] = []
    let ok = true
    let q = 0
    while q < condIxs.length {
      const b = inlineBlockBody(bodyIxs[q], indent)
      const cd = expr(condIxs[q], indent, 0)
      let pre0 = "if "
      if q > 0 { pre0 = "else if " }
      const ln = pre0 + cd + " " + b
      if (
        b.length == 0 ||
        hasNewline(cd) ||
        indent * 2 + dispWidth(ln) > fmtWidth
      ) {
        ok = false
      }
      clauseLines.push(ln)
      q = q + 1
    }
    if ok && hasElse {
      const eb = inlineBlockBody(elseBodyIx, indent)
      const eln = "else " + eb
      if eb.length == 0 || indent * 2 + dispWidth(eln) > fmtWidth { ok = false }
      clauseLines.push(eln)
    }
    if ok {
      let r = 0
      while r < clauseLines.length {
        emitLine(indent, clauseLines[r])
        r = r + 1
      }
      return true
    }
  }
  // Block layout: `if cond {` / `} else if cond {` / `} else {` / `}`. A chain is always
  // `else if`; there is no fused `elseif` keyword.
  let m = 0
  while m < condIxs.length {
    let prefix = "if "
    if m > 0 { prefix = "} else if " }
    emitCondHead(indent, prefix, condIxs[m], " {")
    emitBlockBody(bodyIxs[m], indent)
    m = m + 1
  }
  if hasElse {
    emitLine(indent, "} else {")
    emitBlockBody(elseBodyIx, indent)
  }
  closingBrace(indent, stopLineOf(ix))
  true
}

// ── function declarations ─────────────────────────────────────────────────────

function emitFunction(ix: i32, node: FuncDecl, indent: i32) {
  const exp = exportPrefix(ix)
  const header = exp + functionHeader(ix, node, indent * 2 + dispWidth(exp) + 2)
  const body = node.fnBody
  if isBracedBlock(body) {
    const bn = P.nodes[body]
    if bn is Block {
      // A single simple statement (and `{}`) collapses onto the header line when
      // it fits, mirroring the one-line `if` collapse — so a body written inline
      // stays inline instead of being expanded. An interior comment, a compound
      // body, or an overflow keeps the multi-line form.
      const inline = inlineBlockBody(body, indent)
      if (
        inline.length > 0 &&
        indent * 2 + dispWidth(header) + 1 + dispWidth(inline) <= fmtWidth
      ) {
        emitLine(indent, header + " " + inline)
        return 0
      }
      // `emitBlockBody`, not a bare `emitStatements`: it also flushes the
      // comments after the body's last statement, so a comment on the final
      // line of a function stays inside the closing `}` instead of leaking
      // after it (at top level: after the program's final `}`).
      emitLine(indent, header + " {")
      emitBlockBody(body, indent)
      closingBrace(indent, stopLineOf(body))
      return 0
    }
  }
  // Single-expression / single-statement (synthesized) body.
  const rendered = bareBodyInline(body, indent)
  emitLine(indent, header + " " + rendered)
  0
}

// The function signature `function name<T>(params): Ret`. Parameter and return types are
// type syntax and are recovered verbatim per node; parameter names and their `:`
// annotations are rebuilt with canonical spacing. `reserved` is the columns the header line
// uses outside `prefix(params)ret`, so the list wraps when the whole line would overflow.
function functionHeader(ix: i32, node: FuncDecl, reserved: i32) {
  let name = "function"
  if node.fnName.length > 0 { name = "function " + node.fnName }
  // An index-operator declaration is stored under a name that also carries its receiver
  // (`[]@F32View`), while the source spelled the operator alone, quoted. The receiver half
  // is reprinted anyway as the `self` parameter's annotation, so the quoted operator is a
  // faithful round trip.
  const opk = opDeclOpOf(node.fnName)
  if opk != "" { name = "function \"" + opk + "\"" }
  let typarams = ""
  if node.fnTyParams.length > 0 {
    typarams = "<"
    let i = 0
    while i < node.fnTyParams.length {
      if i > 0 { typarams = typarams + ", " }
      typarams = typarams + node.fnTyParams[i]
      // A bound (`<T: Showable>`) recovers verbatim from source, the same way
      // every other annotation in this header does — so an inline bound literal
      // reprints with the spacing the author wrote rather than the synthetic
      // name the parser rendered.
      const bAnn = fnTpBoundOf(ix, i)
      if bAnn >= 0 { typarams = typarams + ": " + recoverType(bAnn) }
      i = i + 1
    }
    typarams = typarams + ">"
  }
  const prefix = name + typarams
  const params: string[] = []
  let p = 0
  while p < node.fnParams.length {
    params.push(paramText(node.fnParams[p]))
    p = p + 1
  }
  let ret = ""
  if node.fnRet >= 0 { ret = ": " + recoverType(node.fnRet) }
  const paramList = wrapList(
    "(",
    params,
    ")",
    0,
    dispWidth(prefix) + dispWidth(ret) + reserved,
  )
  prefix + paramList + ret
}

// One parameter `name: Type` (or `name` when untyped), with any default value. A
// `name?: Type` reprints from the surface marker `parOpt`: the parser desugared the
// annotation to `Type | null` and the default to `null`, and both are what the `?` says, so
// neither is printed beside it. The annotation node's span still covers exactly the `Type`.
function paramText(ix: i32) {
  const n = P.nodes[ix]
  if n is Param {
    if n.parOpt == 1 {
      if n.parType >= 0 { return n.parName + "?: " + recoverType(n.parType) }
      return n.parName + "?"
    }
    let t = n.parName
    if n.parType >= 0 { t = t + ": " + recoverType(n.parType) }
    if n.parDefault >= 0 { t = t + " = " + expr(n.parDefault, 0, 0) }
    return t
  }
  ""
}

// Render a one-line body statement (expression or simple statement).
function statementInline(ix: i32, indent: i32) {
  const n = P.nodes[ix]
  if n is RetStmt {
    if n.retArg < 0 { return "return" }
    return "return " + expr(n.retArg, indent, 0)
  }
  if n is BreakStmt {
    if n.brkLabel.length > 0 { return "break " + n.brkLabel }
    return "break"
  }
  if n is ContinueStmt {
    if n.contLabel.length > 0 { return "continue " + n.contLabel }
    return "continue"
  }
  if n is LetDecl { return letInline(ix, n, indent) }
  if n is WhileStmt { return sliceFallback(ix) }
  if n is ForRange { return sliceFallback(ix) }
  if n is ForIn { return sliceFallback(ix) }
  if n is Block { return sliceFallback(ix) }
  if n is IfStmt { return sliceFallback(ix) }
  expr(ix, indent, 0)
}

// Inline form of a `let`/`const` declaration (single-statement body context).
function letInline(_ix: i32, node: LetDecl, indent: i32) {
  let head = node.letKw + " " + node.letName
  if node.letType >= 0 { head = head + ": " + recoverType(node.letType) }
  if node.letInit >= 0 { return head + " = " + expr(node.letInit, indent, 0) }
  head
}

// ── expressions ───────────────────────────────────────────────────────────────

// Render expression node `ix`. `column` is the visual column the expression
// starts at (for reflow). Returns possibly-multiline text.
function expr(ix: i32, indent: i32, column: i32) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = P.nodes[ix]
  // D1045 — demangled. This is one of three places the formatter prints a name the node
  // carries rather than the source span, and a body-scoped `type` renames through all
  // three: a `flat type TV` declared in a body becomes `TV$b1`. `demangleSpelling` is a
  // no-op on every other name, since `$` is not a legal identifier character.
  if n is Ident { return demangleSpelling(n.identName) }
  if n is NumLit { return literalSlice(ix, n.numText) }
  if n is StrLit { return literalSlice(ix, n.strText) }
  if n is CharLit { return literalSlice(ix, n.charText) }
  if n is BoolLit {
    if n.boolVal == 1 { return literalSlice(ix, "true") }
    return literalSlice(ix, "false")
  }
  if n is NullLit { return literalSlice(ix, "null") }
  if n is BinExpr { return renderBinary(ix, n, indent, column) }
  if n is Unary { return unary(ix, n, indent, column) }
  if n is IsExpr { return isExpr(ix, n, indent, column) }
  if n is AsExpr { return asExpr(ix, n, indent, column) }
  if n is Member { return memberAccess(ix, n, indent, column) }
  if n is OptMember { return optMemberAccess(ix, n, indent, column) }
  if n is Index { return indexAccess(ix, n, indent, column) }
  if n is Call { return callExpr(ix, n, indent, column) }
  if n is ObjLit { return objectLiteral(ix, n, indent, column) }
  if n is ArrayLit { return arrayLiteral(ix, n, indent, column) }
  if n is Paren { return parenExpr(ix, n, indent, column) }
  if n is FuncDecl { return functionExpr(ix, n, indent) }
  if n is IfStmt { return ifExpr(ix, n, indent) }
  if n is Block { return blockExpr(ix, n, indent) }
  if n is MatchExpr { return matchExprFmt(ix, n, indent) }
  sliceFallback(ix)
}

// One match arm pattern. A string literal or the `_` wildcard render as the expression they
// are; a type pattern is an `IsExpr` the parser minted over the scrutinee and must not go
// through `expr`, which would render the guard surface `scrut is C`. Its `[pos, end)` span
// is exactly the type's source text, so the verbatim slice round-trips it.
function matchPatFmt(patIx: i32, bindIx: i32, indent: i32) {
  const pn = P.nodes[patIx]
  if pn is IsExpr {
    const raw = trimWs(recoverType(patIx))
    if raw.length > 0 { return raw + matchBindFmt(bindIx) }
    // No span (a synthesized pattern): the check-type name is the canonical spelling.
    return demangleSpelling(pn.isVariant) + matchBindFmt(bindIx)
  }
  expr(patIx, indent, 0)
}

// A pattern's payload-binding clause `{x, y}`, or "" when there is none. Rendered
// structurally from the bound names the parser banked as `const` declarations, not from a
// source slice: the pattern node's span stops at its type atom, so printing from the span
// would silently delete every binding. Structural rendering also canonicalizes the spacing.
function matchBindFmt(bindIx: i32) {
  if bindIx < 0 { return "" }
  const bn = P.nodes[bindIx]
  if bn is Block {
    let names = ""
    let i = 0
    while i < bn.blkStmts.length {
      const st = P.nodes[bn.blkStmts[i]]
      if st is LetDecl {
        if names.length > 0 { names = names + ", " }
        names = names + st.letName
      }
      i = i + 1
    }
    return "{" + names + "}"
  }
  ""
}

// A `match` (value- or statement-position): the scrutinee on the header line, then one arm per
// line — `<pat> [| <pat>]* => <body>` — at `indent + 1`, closed by `}` at `indent`. The arm body
// renders through `expr` (a bare expression, an `if`-expr, or a `{ … }` block — `blockExpr` inlines
// a short one). Mirrors `match`'s parse shape so it round-trips idempotently.
function matchExprFmt(_ix: i32, n: MatchExpr, indent: i32) {
  const scrut = expr(n.matchScrut, indent, 0)
  const pad = indentStr(indent + 1)
  const closePad = indentStr(indent)
  // One line per arm, joined once — a running `out = out + line` accumulator here is
  // O(arms²) allocation under the non-freeing GC. Or-pattern lists stay a plain
  // accumulator: an arm holds a handful of patterns.
  const out: string[] = []
  out.push("match " + scrut + " {")
  let k = 0
  while k < n.matchArmStart.length {
    const start = n.matchArmStart[k]
    const cnt = n.matchArmCount[k]
    let pats = ""
    let p = 0
    while p < cnt {
      if p > 0 { pats = pats + " | " }
      const patIx = n.matchPats[start + p]
      const bindIx = n.matchBinds[start + p]
      pats = pats + matchPatFmt(patIx, bindIx, indent + 1)
      p = p + 1
    }
    const body = expr(n.matchBodies[k], indent + 1, 0)
    out.push(pad + pats + " => " + body)
    k = k + 1
  }
  out.push(closePad + "}")
  joinLines(out)
}

// A literal: prefer the verbatim source lexeme; fall back to structural text.
function literalSlice(ix: i32, fallback: string) {
  const raw = trimWs(sliceNode(ix))
  if raw.length > 0 { return raw }
  fallback
}

// The binary-chain cluster, defined in dependency order (callee before caller) so no
// function within it forward-references another: the host resolves a single-level forward
// reference but not a transitive one. The operand collectors `ops`/`txt` are parameters,
// not module globals, because the flattening is re-entrant and a global would be clobbered.

// Recurse into a binary node, flattening same-precedence left-assoc operands into
// the parallel `ops`/`txt` arrays (`ops[k]` = operator leading operand k, "" for
// the first).
function flattenChain(
  ix: i32,
  leading: string,
  prec: i32,
  indent: i32,
  column: i32,
  ops: string[],
  txt: string[],
) {
  const n = P.nodes[ix]
  if n is BinExpr {
    // A TEMPLATE root is not a chain link even when its `+` matches the
    // precedence: flattening through it would print the desugared concatenation
    // (`"a" + $tpl$render(x)`) in place of the template the author wrote. It
    // falls through to `expr` → `renderBinary`, which slices the source.
    const isChain = n.binOp != "=" &&
      n.binTpl != 1 &&
      binPrecOf(n.binOp) == prec
    if isChain {
      flattenChain(n.binLeft, leading, prec, indent, column, ops, txt)
      flattenChain(n.binRight, n.binOp, prec, indent, column, ops, txt)
      return 0
    }
  }
  const r = expr(ix, indent, column)
  const wrapped = parenForChain(ix, r, prec)
  ops.push(leading)
  txt.push(wrapped)
  0
}

function binaryChain(ix: i32, node: BinExpr, indent: i32, column: i32) {
  const prec = binPrecOf(node.binOp)
  const ops: string[] = []
  const txt: string[] = []
  flattenChain(ix, "", prec, indent, column, ops, txt)
  let oneLine = ""
  let i = 0
  while i < txt.length {
    if i > 0 { oneLine = oneLine + " " }
    if ops[i].length > 0 { oneLine = oneLine + ops[i] + " " }
    oneLine = oneLine + txt[i]
    i = i + 1
  }
  if column + dispWidth(oneLine) <= fmtWidth && !hasNewline(oneLine) {
    return oneLine
  }
  // Reflow: operator at end of previous line; each operand after the first on its
  // own continuation line, one indent deeper.
  let result = txt[0] + " " + ops[1]
  let j = 1
  while j < txt.length {
    let tail = ""
    if j + 1 < txt.length { tail = " " + ops[j + 1] }
    result = result + "\n" + indentStr(indent + 1) + txt[j] + tail
    j = j + 1
  }
  result
}

function renderBinary(ix: i32, node: BinExpr, indent: i32, column: i32) {
  // A template literal's concatenation reprints as the template the author wrote — its own
  // source bytes, verbatim, as a string literal does. The parser gave the root `+` the
  // template's whole span for this. The rule is the string literal's: the bytes between the
  // delimiters are data, and a multiline template's newlines and indentation are content.
  if node.binTpl == 1 {
    const raw = sliceNode(ix)
    if raw.length > 0 { return raw }
  }
  if node.binOp == "=" { return renderAssign(ix, node, indent, column) }
  binaryChain(ix, node, indent, column)
}

// Emit possibly-multiline `text` with only its first line indented (continuation
// lines already carry their absolute indentation — the `emitMultiline` contract).
function emitFirstIndented(indent: i32, text: string) {
  const lines = splitLines(text)
  let i = 0
  while i < lines.length {
    let pre = ""
    if i == 0 { pre = indentStr(indent) }
    outBuf.push(pre + lines[i] + "\n")
    i = i + 1
  }
  0
}

// Emit each top-level `&&`/`||` operand of a wrapped condition on its own line at
// `indent`, the operator trailing every line but the last (mirroring the inline
// chain). A non-chain condition is emitted as a single (possibly wrapped) operand.
function emitCondOperands(ix: i32, indent: i32) {
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp != "=" {
      const prec = binPrecOf(n.binOp)
      const ops: string[] = []
      const txt: string[] = []
      flattenChain(ix, "", prec, indent, indent * 2, ops, txt)
      let i = 0
      while i < txt.length {
        let tail = ""
        if i + 1 < txt.length { tail = " " + ops[i + 1] }
        emitFirstIndented(indent, txt[i] + tail)
        i = i + 1
      }
      return 0
    }
  }
  emitFirstIndented(indent, expr(ix, indent, indent * 2))
  0
}

// Emit `<prefix><cond><suffix>` as a head line, switching to the forced-paren
// multi-line form when the inline head would overflow the width.
function emitCondHead(
  indent: i32,
  prefix: string,
  condIx: i32,
  suffix: string,
) {
  const inline = expr(condIx, indent, 0)
  const head = prefix + inline + suffix
  if !hasNewline(inline) && indent * 2 + dispWidth(head) <= fmtWidth {
    emitLine(indent, head)
    return 0
  }
  emitLine(indent, prefix + "(")
  emitCondOperands(unwrapOuterParen(condIx), indent + 1)
  emitLine(indent, ")" + suffix)
  0
}

// An assignment `=` node. A desugared compound `a += b` or prefix `++x`/`--x`
// carries its surface operator on the node (`binCompound`: `+`/`-`/`*`/`/` for a
// compound, `++`/`--` for a prefix increment), so it reprints directly — no source
// token scan.
function renderAssign(_ix: i32, node: BinExpr, indent: i32, column: i32) {
  const op = node.binCompound
  // Prefix increment `++x` / `--x`: the surface op is the whole prefix.
  if op == "++" || op == "--" {
    return op + expr(node.binLeft, indent, column + 2)
  }
  const left = expr(node.binLeft, indent, column)
  // Compound assignment: emit `<left> <op>= <addend>` where the addend is the
  // right operand of the desugared inner arithmetic node (`a + b` → `b`).
  if op.length > 0 {
    let addendIx = node.binRight
    const r = P.nodes[node.binRight]
    if r is BinExpr { addendIx = r.binRight }
    return left +
      " " +
      op +
      "= " +
      expr(addendIx, indent, column + dispWidth(left) + 4)
  }
  left + " = " + expr(node.binRight, indent, column + dispWidth(left) + 3)
}

function unary(_ix: i32, node: Unary, indent: i32, column: i32) {
  // Postfix `x++` / `x--`: the parser models it as `Unary("p+"/"p-", (x = x+1))`.
  // Recover the target (the inner assignment's left) and the surface operator.
  if node.unOp == "p+" || node.unOp == "p-" {
    let pop = "++"
    if node.unOp == "p-" { pop = "--" }
    const inner = P.nodes[node.unArg]
    if inner is BinExpr { return expr(inner.binLeft, indent, column) + pop }
    return expr(node.unArg, indent, column) + pop
  }
  // Negated type guard `x !is T`: the parser desugars it to `!(x is T)` as a
  // `Unary("!", IsExpr)` and flags the `IsExpr` (`isNeg`); reprint the surface
  // `!is` form (a genuine prefix `!` over a plain guard keeps `isNeg == 0`).
  if node.unOp == "!" {
    const g = P.nodes[node.unArg]
    if g is IsExpr {
      if g.isNeg == 1 {
        return expr(g.isObj, indent, column) +
          " !is " +
          recoverIsType(node.unArg)
      }
    }
  }
  let operand = expr(node.unArg, indent, column)
  if node.unOp == "!" {
    const a = P.nodes[node.unArg]
    let needs = false
    if a is BinExpr {
      if a.binOp != "=" { needs = true }
    } else if a is IsExpr {
      needs = true
    }
    if needs { operand = "(" + operand + ")" }
  }
  node.unOp + operand
}

function isExpr(ix: i32, node: IsExpr, indent: i32, column: i32) {
  const value = expr(node.isObj, indent, column)
  const ty = recoverIsType(ix)
  value + " is " + ty
}

// `x as T` — the target and the mode ride the node (`asTy`, `asMode`), so neither needs
// source recovery, unlike `is`. The operand renders through `primary`, which parenthesizes
// a composite so the cast keeps binding the whole value. The suffix is part of the
// operator: a bare `" as "` turns `x as! T` into a propagation, pinned by a `fmt` case.
function asExpr(_ix: i32, node: AsExpr, indent: i32, column: i32) {
  let kw = " as "
  if node.asMode == "trap" { kw = " as! " }
  if node.asMode == "null" { kw = " as? " }
  primary(node.asObj, indent, column) + kw + demangleSpelling(node.asTy)
}

// Recover the check-type source of an `is` from the node's span.
function recoverIsType(ix: i32) {
  const start = nodePos(ix)
  const stop = nodeEndOf(ix)
  if start < 0 || stop < 0 { return "" }
  // Seat the scan at the node's start token by binary search and stop once past the node's
  // end: this runs once per `is` expression, and a scan from token 0 is O(tokens) each. A
  // `pos` not landing exactly on a token start degrades to the full scan.
  let i = tokIndexAt(start)
  if i < 0 { i = 0 }
  while i < P.toks.length {
    const t = P.toks[i]
    if t.start >= stop { return "" }
    if t.kind == "IS" && t.start >= start {
      const afterStart = t.start + t.text.length
      return collapseWs(fmtSrc.slice(afterStart, stop))
    }
    i = i + 1
  }
  ""
}

// Member and call chain layout, fit-or-break. A postfix chain of two or more `.name` or
// `?.name` links is laid out against `fmtWidth`: inline while it fits from its start column,
// else one link per line at `indent + 1`, from the first link. The threshold is two links
// and a link starts at the first called step; the fit is taken flat (`format-notes.md`).
const FMT_CHAIN_FLAT = 1000000

// Walk the postfix chain rooted at `ix` down to its head, recording each postfix op
// outermost-first into `kinds` (0 = `.p`, 1 = `?.p`, 2 = `(args)`, 3 = `[i]`) and `nodes`.
// Returns the head — the first node that is not a postfix.
function chainWalk(ix: i32, kinds: i32[], nodes: i32[]): i32 {
  let cur = ix
  let going = true
  while going {
    if cur < 0 || cur >= P.nodes.length {
      going = false
    } else {
      const c = P.nodes[cur]
      if c is Member {
        kinds.push(0)
        nodes.push(cur)
        cur = c.memObj
      } else if c is OptMember {
        kinds.push(1)
        nodes.push(cur)
        cur = c.omObj
      } else if c is Call {
        kinds.push(2)
        nodes.push(cur)
        cur = c.callFn
      } else if c is Index {
        kinds.push(3)
        nodes.push(cur)
        cur = c.idxArr
      } else {
        going = false
      }
    }
  }
  cur
}

// The `kinds` index where the chain's links begin: the last `.` / `?.` step in
// the array — the first in source order, since `chainWalk` records outermost
// first — that is immediately followed by a call. -1 when no step carries one,
// which makes the whole postfix run a head (`a.b.c` has no links at all).
function chainLinkStart(kinds: i32[]): i32 {
  let i = kinds.length - 1
  while i >= 0 {
    if kinds[i] == 0 || kinds[i] == 1 {
      if i > 0 && kinds[i - 1] == 2 { return i }
    }
    i = i - 1
  }
  -1
}

// One postfix op appended to `text`. The three suffix forms render exactly as
// their own printer does — `callTail` is the shared one — so an inline chain
// assembled step by step is the string the recursive path produced.
function chainStep(text: string, kind: i32, ix: i32, indent: i32, column: i32) {
  const n = P.nodes[ix]
  if kind == 0 {
    if n is Member { return text + "." + n.memProp }
  } else if kind == 1 {
    if n is OptMember { return text + "?." + n.omProp }
  } else if kind == 2 {
    if n is Call { return callTail(n, text, indent, column) }
  } else {
    if n is Index { return text + "[" + expr(n.idxIndex, indent, column) + "]" }
  }
  text
}

// The chain on one line. `kinds`/`nodes` are outermost-first, so this replays
// them in reverse — source order.
function chainInline(
  headIx: i32,
  kinds: i32[],
  nodes: i32[],
  indent: i32,
  column: i32,
) {
  let text = primary(headIx, indent, column)
  let i = kinds.length - 1
  while i >= 0 {
    text = chainStep(text, kinds[i], nodes[i], indent, column)
    i = i - 1
  }
  text
}

// The chain broken: the head, with any suffixes preceding the first `.`, on its own line,
// then one `.link(args)` per line at `indent + 1`. Each link is rendered at that deeper
// indent and its own start column, so a link whose argument list still overflows wraps
// beneath the link rather than beneath the chain.
function chainBroken(
  headIx: i32,
  kinds: i32[],
  nodes: i32[],
  linkStart: i32,
  indent: i32,
  column: i32,
) {
  const pad = indentStr(indent + 1)
  const linkCol = (indent + 1) * 2
  const parts: string[] = []
  let piece = primary(headIx, indent, column)
  let pieceIndent = indent
  let pieceCol = column
  let i = kinds.length - 1
  while i >= 0 {
    const k = kinds[i]
    // Only a step at or past `linkStart` opens a line; a `.field` before it is
    // still the head, so it lands on the head line where the count put it.
    if (k == 0 || k == 1) && i <= linkStart {
      parts.push(piece)
      piece = ""
      pieceIndent = indent + 1
      pieceCol = linkCol
    }
    piece = chainStep(piece, k, nodes[i], pieceIndent, pieceCol)
    i = i - 1
  }
  parts.push(piece)
  const out: string[] = []
  out.push(parts[0])
  let j = 1
  while j < parts.length {
    out.push(pad + parts[j])
    j = j + 1
  }
  joinLines(out)
}

// The chain rooted at `ix` laid out, or "" when this node is not a breakable
// chain and the caller should print it the ordinary way.
function chainLayout(ix: i32, indent: i32, column: i32) {
  const kinds: i32[] = []
  const nodes: i32[] = []
  const headIx = chainWalk(ix, kinds, nodes)
  if headIx < 0 || headIx >= P.nodes.length { return "" }
  const linkStart = chainLinkStart(kinds)
  let links = 0
  let i = linkStart
  while i >= 0 {
    if kinds[i] == 0 || kinds[i] == 1 { links = links + 1 }
    i = i - 1
  }
  if links < 2 { return "" }
  // A comment inside the chain would be consumed by the flat measurement below and lost the
  // moment that render is discarded, since `cmtCursor` is one-way. Such a chain takes the
  // ordinary inline path instead — one render — the same guard the one-line `if` collapse
  // and `ifExpr` carry.
  const start = nodePos(ix)
  const stop = nodeEndOf(ix)
  if start < 0 || stop < 0 { return "" }
  if commentInCharSpan(start, stop) { return "" }
  const realWidth = fmtWidth
  fmtWidth = FMT_CHAIN_FLAT
  const flat = chainInline(headIx, kinds, nodes, indent, column)
  fmtWidth = realWidth
  if !hasNewline(flat) && column + dispWidth(flat) <= realWidth { return flat }
  chainBroken(headIx, kinds, nodes, linkStart, indent, column)
}

function memberAccess(ix: i32, node: Member, indent: i32, column: i32) {
  const laid = chainLayout(ix, indent, column)
  if laid.length > 0 { return laid }
  primary(node.memObj, indent, column) + "." + node.memProp
}

function optMemberAccess(ix: i32, node: OptMember, indent: i32, column: i32) {
  const laid = chainLayout(ix, indent, column)
  if laid.length > 0 { return laid }
  primary(node.omObj, indent, column) + "?." + node.omProp
}

function indexAccess(_ix: i32, node: Index, indent: i32, column: i32) {
  primary(node.idxArr, indent, column) +
    "[" +
    expr(node.idxIndex, indent, column) +
    "]"
}

// Render an expression in a postfix-operand position (receiver of `.`/`?.`/`[]`/
// call). A composite operand is parenthesized so the postfix binds the whole value.
function primary(ix: i32, indent: i32, column: i32) {
  const rendered = expr(ix, indent, column)
  const n = P.nodes[ix]
  let composite = false
  if n is BinExpr { composite = true }
  else if n is Unary { composite = true }
  else if n is IsExpr { composite = true }
  else if n is IfStmt { composite = true }
  if composite { return "(" + rendered + ")" }
  rendered
}

function callExpr(ix: i32, node: Call, indent: i32, column: i32) {
  const laid = chainLayout(ix, indent, column)
  if laid.length > 0 { return laid }
  const callee = expr(node.callFn, indent, column)
  const head = calleePrimary(node.callFn, callee)
  callTail(node, head, indent, column)
}

// `head` with the call's argument list appended, at `indent` starting from `column`, the
// column `head` itself begins at. Split out of `callExpr` because the chain layout needs the
// same tail under a different head, and a second spelling of the trailing-lambda hug plus
// the width test is exactly the one width test this file already has.
function callTail(node: Call, head: string, indent: i32, column: i32) {
  const n = node.callArgs.length
  // Every argument but the last, at the wrapped list's continuation depth. The last is
  // rendered exactly once, at the depth whichever form wins needs: rendering a lambda body
  // consumes the comments inside it, so a speculative render thrown away would delete them.
  const args: string[] = []
  let i = 0
  while i + 1 < n {
    args.push(callArgText(node, i, indent + 1, column))
    i = i + 1
  }
  if n > 0 {
    if isBlockLambda(node.callArgs[n - 1]) {
      const hugged = hugTrailingLambda(node, args, head, indent, column)
      if hugged.length > 0 { return hugged }
    }
    args.push(callArgText(node, n - 1, indent + 1, column))
  }
  head + wrapList("(", args, ")", indent, column + dispWidth(head))
}

// Argument `i` as a list item: the value, with its optional name prefix.
function callArgText(node: Call, i: i32, argIndent: i32, column: i32) {
  let nm = ""
  if i < node.callArgNames.length { nm = node.callArgNames[i] }
  const v = expr(node.callArgs[i], argIndent, column)
  if nm.length > 0 { return nm + ": " + v }
  v
}

// The trailing-lambda exception. The generic list rule is "an argument spans lines ⇒ break
// every argument", right for every multi-line argument but one: a block-bodied lambda in
// final position already carries its own vertical structure, so breaking around it says
// nothing at any width. The three rulings: `docs/internals/fmt-trailing-lambda-design.md`.

// Is node `ix` a lambda whose body is a braced block? An expression-bodied
// lambda (`(v) => v + 1`) renders on one line and is already untouched by the
// list rule, so it is deliberately not a hug candidate.
function isBlockLambda(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is FuncDecl { return isBracedBlock(n.fnBody) }
  false
}

// The hugged rendering `head(pre…, (p) => {` / body / `})`, or "" when a guard declines it,
// and the caller then falls through to the vertical list. It decides before it renders: the
// decision needs only the lambda's header, recovered from source spans with no side effects,
// so a declined hug never touches the comment cursor.
function hugTrailingLambda(
  node: Call,
  pre: string[],
  head: string,
  indent: i32,
  column: i32,
) {
  const nargs = node.callArgs.length
  const lastIx = node.callArgs[nargs - 1]
  const lam = P.nodes[lastIx]
  if lam is FuncDecl {
    // The head line the hug would produce, assembled from the pieces that will
    // actually be concatenated below. `pre` is at most a handful of items, so
    // the running accumulator here is not the O(n²) hazard `wrapList` guards.
    let joined = ""
    let j = 0
    while j < pre.length {
      // A preceding argument that spans lines is not going on the head line —
      // that is the two-lambda case, and it takes the vertical form.
      if hasNewline(pre[j]) { return "" }
      joined = joined + pre[j] + ", "
      j = j + 1
    }
    let nm = ""
    if nargs - 1 < node.callArgNames.length {
      nm = node.callArgNames[nargs - 1]
    }
    if nm.length > 0 { nm = nm + ": " }
    // `functionExpr` builds its first line as `arrowHeader(…) + " => {"` from
    // the same `indent` we are about to hand it, so this predicts that line
    // exactly rather than guessing at it.
    const header = arrowHeader(lam, indent * 2 + 6)
    if hasNewline(header) { return "" }
    const firstLine = head + "(" + joined + nm + header + " => {"
    if column + dispWidth(firstLine) > fmtWidth { return "" }
    const body = expr(lastIx, indent, column)
    return head + "(" + joined + nm + body + ")"
  }
  ""
}

function objectLiteral(_ix: i32, node: ObjLit, indent: i32, column: i32) {
  if node.objFields.length == 0 { return "{}" }
  const items: string[] = []
  let i = 0
  while i < node.objFields.length {
    items.push(fieldInitText(node.objFields[i], indent, column))
    i = i + 1
  }
  wrapList("{ ", items, " }", indent, column)
}

function fieldInitText(ix: i32, indent: i32, column: i32) {
  const n = P.nodes[ix]
  if n is FieldInit {
    return fieldKeyText(ix, n.fiName) +
      ": " +
      expr(n.fiValue, indent + 1, column)
  }
  ""
}

// A field key as written. The parser strips the quotes from a string-literal key
// (`"[]"`, `"*"`, `"=="` — operator / index-trap method fields), so an
// identifier-keyed field prints bare while a string-keyed one is recovered with
// its quoted lexeme from source (host parity; those keys carry no escapes).
function fieldKeyText(ix: i32, name: string) {
  const p = nodePos(ix)
  if p >= 0 && p < fmtSrc.length {
    const c = fmtSrc.slice(p, p + 1)
    if c == "\"" || c == "'" {
      // The key token starts exactly at the node's `pos`; binary-search it
      // (token starts are unique and ascending) instead of scanning `P.toks`
      // from 0 per quoted key.
      const i = tokIndexAt(p)
      if i >= 0 && P.toks[i].kind == "STRING" { return P.toks[i].text }
    }
  }
  name
}

function arrayLiteral(_ix: i32, node: ArrayLit, indent: i32, column: i32) {
  if node.arrElems.length == 0 { return "[]" }
  const items: string[] = []
  let i = 0
  while i < node.arrElems.length {
    items.push(expr(node.arrElems[i], indent + 1, column))
    i = i + 1
  }
  wrapList("[", items, "]", indent, column)
}

// A parenthesised expression `( inner )`. The self-host keeps explicit parens.
function parenExpr(_ix: i32, node: Paren, indent: i32, column: i32) {
  "(" + expr(node.parInner, indent, column + 1) + ")"
}

// An anonymous function value in expression position is always an arrow lambda
// `(params) => body`; arrow is the sole lambda syntax. Any `fnName` on the node is an
// internal debug name, stamped from a binding so a trap backtrace reads `foo` rather than
// `__lambda_N`; the source has no name there, so it is not printed.
function functionExpr(_ix: i32, node: FuncDecl, indent: i32) {
  const header = arrowHeader(node, indent * 2 + 6)
  const body = node.fnBody
  if isBracedBlock(body) {
    const bn = P.nodes[body]
    if bn is Block {
      const saved = outBuf
      outBuf = []
      emitStatements(bn.blkStmts, indent + 1)
      // Flush the comments after the body's last statement (still inside the
      // swapped buffer) so they stay within the lambda's `}` — the same
      // trailing-comment flush `emitBlockBody` does for statement blocks.
      emitLeadingComments(indent + 1, stopLineOf(body))
      const inner = joinOut()
      outBuf = saved
      // Rejoin the body once — a running `result = result + line` accumulator here is
      // O(lines²) allocation under the non-freeing GC.
      const out: string[] = []
      out.push(header + " => {")
      const lines = splitLines(rstripNl(inner))
      let i = 0
      while i < lines.length {
        out.push(lines[i])
        i = i + 1
      }
      out.push(indentStr(indent) + "}")
      return joinLines(out)
    }
  }
  header + " => " + bareBodyInline(body, indent)
}

// The parameter list `(a: T, b: U)` of an arrow lambda, and its optional return annotation
// `: Ret`, preserved verbatim so `vl fmt` never drops a load-bearing return type. Like
// `functionHeader` but with no keyword, name or generics. `reserved` is the columns the line
// uses outside the param list, so the list wraps only when the whole line would overflow.
function arrowHeader(node: FuncDecl, reserved: i32) {
  const params: string[] = []
  let p = 0
  while p < node.fnParams.length {
    params.push(paramText(node.fnParams[p]))
    p = p + 1
  }
  let ret = ""
  if node.fnRet >= 0 { ret = ": " + recoverType(node.fnRet) }
  wrapList("(", params, ")", 0, reserved + dispWidth(ret)) + ret
}

function ifExpr(ix: i32, node: IfStmt, indent: i32) {
  // An `if` as an expression value: single-line braced-inline `if c { a } else { b }` when
  // every branch is a simple expression and no comment lives inside the expression — a
  // comment cannot ride the inline form, so it stays anchored by falling through to the
  // verbatim slice.
  const hasCmt = commentInCharSpan(nodePos(ix), nodeEndOf(ix))
  let elseOk = node.ifElse < 0
  if !elseOk { elseOk = branchIsSimple(node.ifElse) || elseIsIf(node.ifElse) }
  if !hasCmt && branchIsSimple(node.ifThen) && elseOk {
    const cond = expr(node.ifCond, indent, 0)
    const thenE = bareBodyInline(node.ifThen, indent)
    let parts = "if " + cond + " { " + thenE + " }"
    if node.ifElse >= 0 {
      const e = P.nodes[node.ifElse]
      if e is IfStmt {
        parts = parts + " " + elseIfExpr(node.ifElse, indent)
      } else {
        parts = parts + " else { " + bareBodyInline(node.ifElse, indent) + " }"
      }
    }
    return parts
  }
  sliceFallback(ix)
}

// An `else if`-chain tail in expression position.
function elseIfExpr(ix: i32, indent: i32) {
  const n = P.nodes[ix]
  if n is IfStmt {
    const cond = expr(n.ifCond, indent, 0)
    const thenE = bareBodyInline(n.ifThen, indent)
    let parts = "else if " + cond + " { " + thenE + " }"
    if n.ifElse >= 0 {
      const e = P.nodes[n.ifElse]
      if e is IfStmt {
        parts = parts + " " + elseIfExpr(n.ifElse, indent)
      } else {
        parts = parts + " else { " + bareBodyInline(n.ifElse, indent) + " }"
      }
    }
    return parts
  }
  ""
}

function blockExpr(ix: i32, node: Block, indent: i32) {
  const saved = outBuf
  outBuf = []
  emitStatements(node.blkStmts, indent + 1)
  // Flush the comments after the block's last statement (still inside the
  // swapped buffer) so they stay within the closing `}` — the same
  // trailing-comment flush `emitBlockBody` does for statement blocks.
  emitLeadingComments(indent + 1, stopLineOf(ix))
  const inner = joinOut()
  outBuf = saved
  // Rejoin the body once — a running `result = result + line` accumulator here is
  // O(lines²) allocation under the non-freeing GC.
  const out: string[] = []
  out.push("{")
  const lines = splitLines(rstripNl(inner))
  let i = 0
  while i < lines.length {
    out.push(lines[i])
    i = i + 1
  }
  out.push(indentStr(indent) + "}")
  joinLines(out)
}

// ── list wrapping (calls / arrays / objects / params) ─────────────────────────

// Render `open item, item, … close`, collapsing to one line when it fits from
// `column`, else one item per continuation line with a trailing comma after every
// item (the wrapped form). An empty list is `open+close` trimmed.
function wrapList(
  open: string,
  items: string[],
  close: string,
  indent: i32,
  column: i32,
) {
  if items.length == 0 { return trimWs(open) + trimWs(close) }
  // Sum the one-line width first — no string allocation. When it cannot fit `fmtWidth`,
  // skip straight to the wrapped form without materializing `oneLine`. `dispWidth` is
  // O(text) but still cheaper than the concatenation it guards, and it is a width:
  // `.length` counts an em dash as three columns. A running `s = s + item` is O(n²).
  let oneLineLen = dispWidth(open) + dispWidth(close) + (items.length - 1) * 2
  let li = 0
  while li < items.length {
    oneLineLen = oneLineLen + dispWidth(items[li])
    li = li + 1
  }
  if column + oneLineLen <= fmtWidth {
    const buf: i32[] = []
    pushCps(buf, open)
    let ii = 0
    while ii < items.length {
      if ii > 0 {
        buf.push(',')
        buf.push(' ')
      }
      pushCps(buf, items[ii])
      ii = ii + 1
    }
    pushCps(buf, close)
    const oneLine = fromCodePoints(buf)
    if !hasNewline(oneLine) { return oneLine }
  }
  const pad = indentStr(indent + 1)
  const closePad = indentStr(indent)
  const openTok = rstrip(open)
  const closeTok = trimWsStart(close)
  const bodyBuf: i32[] = []
  let wi = 0
  while wi < items.length {
    pushCps(bodyBuf, pad)
    pushCps(bodyBuf, items[wi])
    bodyBuf.push(',')
    bodyBuf.push('\n')
    wi = wi + 1
  }
  const body = fromCodePoints(bodyBuf)
  openTok + "\n" + body + closePad + closeTok
}
