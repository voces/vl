// A claimed `f` first, then D17123's `take`, which legacy refuses. Under $VL_TEST_CLAIM_REFUSAL every
// claim refuses; legacy builds `f`, and the refusal reported is `take`'s, legacy's.
function f(x: i32): i32 { return x + 1 }
print(f(2))
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", half)
function take(xs) {
  const g = xs[0].get("a")
  if g != null { print(g(6)) }
}
take([m])
