// D17123's witness: the claim of `take` meets a shared legacy helper's refusal and declines,
// so legacy writes `take` and its own refusal is the one reported.
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", half)
function take(xs) {
  const g = xs[0].get("a")
  if g != null { print(g(6)) }
}
take([m])
