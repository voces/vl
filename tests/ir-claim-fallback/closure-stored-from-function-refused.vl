// A named function's closure stored into a module map of bundles from a function: legacy refuses,
// and the claimed start wrote an invalid module. Stays refused: the slot holds `lap`'s record, and a
// named function is neither a call returning it nor a hole lambda built as it. The hole-lambda
// spelling runs since D17572 (`tests/cases/maps/hole-lambda-stored-from-function-beside-bundle.vl`).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function dbl(a: f64): f64 { return a * 2.0 }
const m = Map()
m["a"] = lap((a) => a + 1)
function g() {
  m["b"] = dbl
  return m.has("a")
}
print(g())
