// A plain closure stored into a module map of bundles from a function: legacy refuses, and the
// claimed start wrote an invalid module. Stays refused after #9839 (D17094's rung).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
function g() {
  m["b"] = (a) => a * 2
  return m.has("a")
}
print(g())
