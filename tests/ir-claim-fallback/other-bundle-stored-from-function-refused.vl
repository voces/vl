// A bundle of another shape stored from a function: legacy refuses, and the claimed `g` wrote
// an invalid module. Stays refused after #9839 (D17094's rung).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function lap2(f) {
  const _a = f(1.5)
  const _b = f(true)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
function g() {
  m["b"] = lap2((a) => a)
  return m.has("a")
}
print(g())
