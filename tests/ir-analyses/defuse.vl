function loopSum(xs: i32[]): i32 {
  let s = 0
  let n = 0
  for x in xs {
    s = s + x
    n = n + 1
  }
  return s + n
}
function pick(c: boolean, a: i32, b: i32): i32 {
  let r = a
  if c { r = b }
  return r
}
function count(n: i32): i32 {
  let k = 0
  while k < n {
    k = k + 1
    k = k + 0
  }
  return k
}
function outOf(c: boolean, a: i32): i32 {
  const y = if c { a } else { 0 }
  return y
}
function rangeSum(n: i32): i32 {
  let t = 0
  for i in 0 until n { t = t + i }
  return t
}
function bump(): i32 {
  let m = 1
  const inc = () => {
    m = m + 1
  }
  inc()
  inc()
  return m
}
print(loopSum([1, 2, 3]))
print(pick(true, 4, 5))
print(count(3))
print(outOf(false, 7))
print(rangeSum(4))
print(bump())
