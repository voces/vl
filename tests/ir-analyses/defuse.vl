function loopSum(xs: i32[]): i32 {
  let s = 0
  for x in xs {
    s = s + x
  }
  return s
}
function pick(c: boolean, a: i32, b: i32): i32 {
  let r = a
  if c { r = b }
  return r
}
function count(n: i32): i32 {
  let k = 0
  while k < n {
    k = k + 1
  }
  return k
}
print(loopSum([1, 2, 3]))
print(pick(true, 4, 5))
print(count(3))
