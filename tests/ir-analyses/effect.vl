function addUp(a: i32, b: i32): i32 {
  const s = a + b
  return s * 2
}
function divide(a: i32, b: i32): i32 {
  const q = a / b
  return q
}
function grow(xs: i32[]): i32 {
  xs.push(4)
  return xs.length
}
function down(n: i32): i32 {
  if n <= 0 { return 0 }
  const r = down(n - 1)
  return r + n
}
const xs = [1, 2, 3]
print(addUp(2, 3))
print(divide(9, 3))
print(grow(xs))
print(down(4))
