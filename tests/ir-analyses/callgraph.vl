function leaf(x: i32): i32 { return x + 1 }
function mid(x: i32): i32 { return leaf(x) * 2 }
function top(x: i32): i32 { return mid(x) + leaf(x) }
function isEven(n: i32): boolean {
  if n == 0 { return true }
  return isOdd(n - 1)
}
function isOdd(n: i32): boolean {
  if n == 0 { return false }
  return isEven(n - 1)
}
function twice(f: (i32) => i32, x: i32): i32 { return f(f(x)) }
function sq(x: i32): i32 { return x * x }
print(top(3))
print(isEven(4))
print(twice(sq, 3))
