// @log true
// @log true
// @log 24
// `xs.get(i) ?? d` over a boolean list at nine positions, a literal, negative, field and global
// receiver or index, a `?? ys.get(j) ?? d` chain and a conditional default: the default runs
// only on a miss, counted by `calls`, and each prints what legacy's fused read prints.
let calls = 0
function d() {
  calls = calls + 1
  return true
}
function show(r: boolean) { print(r) }
function id(r: boolean) { return r }
type H = { xs: boolean[] }
const gs = [false, false]
function get_let_init(xs: boolean[], i: i32) {
  const r = xs.get(i) ?? d()
  print(r)
}
function get_element(xs: boolean[], i: i32) {
  const ys = [xs.get(i) ?? d()]
  print(ys[0])
}
function get_arg(xs: boolean[], i: i32) {
  show(xs.get(i) ?? d())
}
function get_ret(xs: boolean[], i: i32) { return xs.get(i) ?? d() }
function get_field(xs: boolean[], i: i32) {
  const o = { v: xs.get(i) ?? d() }
  print(o.v)
}
function get_if_arm(xs: boolean[], i: i32) {
  const r = if xs.length > 0 { xs.get(i) ?? d() } else { true }
  print(r)
}
function get_nested_arg(xs: boolean[], i: i32) {
  show(id(xs.get(i) ?? d()))
}
function get_interp(xs: boolean[], i: i32) {
  print("v=\{xs.get(i) ?? d()}")
}
function get_assign(xs: boolean[], i: i32) {
  let r = true
  r = xs.get(i) ?? d()
  print(r)
}
get_let_init([false, false], 1)
get_let_init([false, false], 5)
get_let_init([false, false], -1)
get_element([false, false], 1)
get_element([false, false], 5)
get_element([false, false], -1)
get_arg([false, false], 1)
get_arg([false, false], 5)
get_arg([false, false], -1)
print(get_ret([false, false], 1))
print(get_ret([false, false], 5))
print(get_ret([false, false], -1))
get_field([false, false], 1)
get_field([false, false], 5)
get_field([false, false], -1)
get_if_arm([false, false], 1)
get_if_arm([false, false], 5)
get_if_arm([false, false], -1)
get_nested_arg([false, false], 1)
get_nested_arg([false, false], 5)
get_nested_arg([false, false], -1)
get_interp([false, false], 1)
get_interp([false, false], 5)
get_interp([false, false], -1)
get_assign([false, false], 1)
get_assign([false, false], 5)
get_assign([false, false], -1)
function get_lit(xs: boolean[]) { print(xs.get(0) ?? d()) }
function get_neg(xs: boolean[]) { print(xs.get(-1) ?? d()) }
function get_field_recv(h: H, i: i32) { print(h.xs.get(i) ?? d()) }
function get_global_recv(i: i32) { print(gs.get(i) ?? d()) }
function get_chain(xs: boolean[], ys: boolean[], i: i32, j: i32) { print(xs.get(i) ?? ys.get(j) ?? d()) }
function get_cond(xs: boolean[], i: i32, c: boolean) { print(xs.get(i) ?? (if c { d() } else { true })) }
get_lit([false, false])
get_lit([])
get_neg([false, false])
get_field_recv({ xs: [false, false] }, 1)
get_field_recv({ xs: [false, false] }, 7)
get_global_recv(1)
get_global_recv(9)
get_chain([false, false], [], 1, 0)
get_chain([], [false, false], 0, 1)
get_chain([], [], 0, 1)
get_cond([false, false], 1, true)
get_cond([false, false], 4, true)
get_cond([false, false], 4, false)
print(calls)
