// @run
// @log 3
// @log 2
// @log 3
// @log 4
// @log 3
// @log 2
// A `u8[]` is the one list whose element does not identify its rep — the backing is
// `(array (mut i8))` where every other i32-element list is `(array (mut i32))` — so a
// classifier that reads elements has to ask the spread's source instead. The module-global
// cell ladder carries no `u8` rung until a spread can give an un-annotated expression that
// type, and without one the global takes the i32 cell while the value is packed (D1850).
const bs: u8[] = [1, 2, 3]
// The un-annotated module-scope binding is the spelling the missing rung loses.
const a = [...bs]
print(a.length)
print(a[1])
// Its function-scope twin runs either way, which is what names the rung and not the lowering.
function inner() {
  const d = [...bs]
  return d.length
}
print(inner())
// A rest parameter declares its destination rep, so it never depended on the rung.
function count(...xs: u8[]) { return xs.length }
print(count(9, ...bs))
// `push` and a second inferred binding are the other deliveries at the packed rep.
const g: u8[] = [0]
g.push(...bs)
print(g.length - 1)
const h = [...bs]
print(h[1])
