// @run
// @log 1
// @log 1
// @log ss
// @log 1.25
// @log 2
// @log 2
// @log 1
// @log 1
// @log 1

// An un-annotated `[]` filled from an un-annotated parameter takes its element from each
// instance's pin, so a second call at another type builds its own list (D10071).

function f(v) {
  const xs = []
  xs.push(v)
  print(xs.length)
}
f("s")
f(2.5)

function g(v) {
  const xs = []
  xs.push(v)
  xs.push(v)
  return xs
}
const a = g("s")
const b = g(2.5)
print(a[0] + a[1])
print(b[0] / 2.0)

function h(v, w) {
  const xs = []
  xs.push(v)
  const ys = []
  ys.push(w)
  print(xs.length + ys.length)
}
h("s", 1)
h(2.5, "t")

type P = { x: i32 }
function k(v) {
  const xs = []
  xs.push(v)
  print(xs.length)
}
const p: P = { x: 1 }
k(p)
k("s")
k([1, 2])
