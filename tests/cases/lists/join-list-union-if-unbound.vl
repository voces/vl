// @run
// @log false
// @log true
// D14085: an `if` joining an `i32[]` and a literal-union list, tested by `is` with no binding,
// has its union registered as a bound join does, so the `i32[]` arm is not taken for `K[]`.
type K = "a" | "b"
function h(a0: i32[], a1: K[], k: i32) {
  print((if k == 0 { a0 } else { a1 }) is K[])
}
h([1, 2], ["a"], 0)
h([1, 2], ["a"], 1)
