// `==` over lists whose element is `string | null` compares pair by pair: two nulls are equal, a
// null and a string are not, two strings by value. Against a literal, against a `string[]`, and
// inside a generic too.
const a: (string | null)[] = ["x", null]
const b: (string | null)[] = ["x", null]
const c: (string | null)[] = ["x", "y"]
const d: (string | null)[] = [null, "y"]
print(a == b)
print(a == c)
print(c == a)
print(a != d)
print(d == [null, "y"])
const s = ["x", "y"]
print(s == c)
print(c == s)
print(s == ["x", "y"])
function eqT<T>(x: T[], y: T[]) { x == y }
print(eqT(a, b))
print(eqT(a, c))
