// @run
// @log 3
// @log 3
// @log 4
// @log 1
// A list literal handed to an un-annotated parameter used as the callee is built for the
// function each call hands that parameter: a lambda's `const`, a nested function, a later
// parameter position, and a lambda argument (D2748).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function sum(xs: Shape[]) {
  let t = 0
  for e in xs {
    if e is Circle { t = t + e.r } else { t = t + e.s * 10 }
  }
  t
}
function viaConst() {
  const out = [{ r: 3 }]
  const ap = (g) => g(out)
  print(ap(sum))
}
function viaNested() {
  const out = [{ r: 3 }]
  function apply(g) { return g(out) }
  print(apply(sum))
}
function laterParam() {
  const out = [{ r: 3 }]
  const ap = (k: i32, g) => g(out) + k
  print(ap(1, sum))
}
function lambdaArg() {
  const out = [{ r: 3 }]
  const ap = (g) => g(out)
  print(ap((xs: Shape[]) => xs.length))
}
viaConst()
viaNested()
laterParam()
lambdaArg()
