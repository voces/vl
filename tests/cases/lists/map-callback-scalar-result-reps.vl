// @run
// @log 3
// @log 14
// @log 2
// @log 2
// @log 2.5
// @log 9
// @log 1.5
// @log 7
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// A `.map` callback whose result kind `collectMapFilterUse`'s ladder had no arm for.
// `cloRetKindOf` answers only `"i32"` / `"f64"` / null by CONTRACT — "any inferred ref/i64/f32
// kind is out of the value ABI" — so an i64- or f32-returning callback arrived as `null` and
// fell into the ladder's i32 default. The result list was then repped at the callback's REAL
// type while its `*Used` flag stayed false, and whichever floor the value next met fired
// (D1088).
//
// ONE HOLE, FIVE MESSAGES, measured over nine witnesses: `.map result is f32[] / i64[] but …
// list type not collected` at a read, a `.pop`, a `.push`, a `.length` and a lambda callback;
// `f32 indexed assignment but f32 list type not collected`; and `.map/.filter over i64[] but
// i64 list type not collected` for the CHAINED spelling (bind the inner map to its own const
// and the inner call's destination floor is recorded first and masks it).
//
// `cloRetValKind` is the reader that CAN name those kinds — already the one the struct /
// variant / union arms above consult, for the same reason. No `u8` arm is needed and that is
// not an omission: the checker refuses `u8` as a return type outright ("a storage type, not a
// value type"), so no check-clean program has a u8-returning callback to collect for.
//
// NO ANNOTATION MENTIONS THE ELEMENT TYPE anywhere below, which is what keeps the other
// collector (`collectA`'s TypeRef chain) from setting the flag by the other route — write
// `f32[]` once and the defect disappears.
function toF(_n: i32): f32 { return 1.5 }
function toI(_n: i32): i64 { return 7 }
function idI(n: i64) { return n }

function readF32() {
  const xs = [1, 2]
  const ys = xs.map(toF)
  return ys[0] + ys[1]
}

function readI64() {
  const xs = [1, 2]
  const ys = xs.map(toI)
  return ys[0] + ys[1]
}

function lengthF32() {
  const xs = [1, 2]
  return xs.map(toF).length
}

// THE CHAINED FORM is required for the i64 `.map`-SOURCE floor: an intermediate `const`
// makes the inner call's DESTINATION floor fire first and mask it.
function chainedI64() {
  const xs = [1, 2]
  const zs = xs.map(toI).map(idI)
  return zs.length
}

function pushF32() {
  const xs = [1, 2]
  const ys = xs.map(toF)
  ys.push(2.5)
  return ys[2]
}

function pushI64() {
  const xs = [1, 2]
  const ys = xs.map(toI)
  ys.push(9)
  return ys[2]
}

// The f32 INDEXED-ASSIGNMENT floor, the row's own first witness.
function indexedAssignF32() {
  const v: f32 = 1.5
  const xs = [1, 2]
  const ys = xs.map(toF)
  ys[0] = v
  return ys[0]
}

// A LAMBDA callback, so the result kind comes from the literal rather than a named function.
function lambdaI64() {
  const xs = [1, 2]
  const ys = xs.map((_n: i32): i64 => {
    return 7
  })
  return ys[0]
}

print(readF32())
print(readI64())
print(lengthF32())
print(chainedI64())
print(pushF32())
print(pushI64())
print(indexedAssignF32())
print(lambdaI64())
