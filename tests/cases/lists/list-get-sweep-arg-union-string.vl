// @run
// @log b
// @log -
// `xs.get(i)` over a string list, its `T | null` delivered at arg-union: an index in range, then
// one past the end (Q58 position sweep).
function show(g: string | null) { print(g ?? "-") }
function showU(u: string | null | boolean) {
  if u is boolean { print(u) } else { show(u) }
}
function go(i: i32) {
  const xs = ["a", "b"]
  showU(xs.get(i))
}
go(1)
go(2)
