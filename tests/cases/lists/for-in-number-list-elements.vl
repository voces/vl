// @run
// @log 2
// @log 0
// @log 1
// @log 43
// @log 2
// @log -1
// @log 0
// @log 2
// @log 1
// A walk over a list whose elements are `f64` lists, `i64` lists or nullable byte lists binds each
// inner list as it is stored, an empty one and a `null` one included; a push onto the outer list
// during the walk is read on a later step, as the header is re-read each step.
function walkF(xs: f64[][]) {
  for row in xs { print(row.length) }
}
function walkI(xs: i64[][]) {
  let t = 0 as i64
  for row in xs {
    for v in row { t = t + v }
  }
  print(t)
}
function walkU(xs: (u8[] | null)[]) {
  for b in xs {
    if b != null { print(b.length) } else { print(-1) }
  }
}
function grow(xs: f64[][]) {
  let n = 0
  for row in xs {
    n = n + 1
    if n == 1 { xs.push([9.5]) }
    print(row.length)
  }
}
walkF([[1.5, 2.5], [], [3.5]])
walkI([[1 as i64, 2 as i64], [], [40 as i64]])
walkU([[1 as u8, 2 as u8], null, []])
grow([[1.0, 2.0]])
