// @emit-error built as a list of union boxes
// A record-literal list delivered as two different unions is built at union boxes, which both
// alias (D853); a third delivery as the record's own list would need a converting copy, and a
// write through one of the union lists makes that copy observable, so the delivery is refused
// (record covariance and D3339 (A): the binding adopts one storage or none).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Tri = { t: i32 }
type Shape = Circle | Sq
type Other = Circle | Tri
function f() {
  const xs = [{ r: 7 }]
  const a: Shape[] = xs
  const b: Other[] = xs
  const c: Circle[] = xs
  b[0] = { t: 3 }
  print(a.length)
  print(c.length)
}
f()
