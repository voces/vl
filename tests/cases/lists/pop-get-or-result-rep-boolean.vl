// `.pop() ?? d` and `.get(k) ?? d` over boolean lists, the result the element, kept nullable, a union with
// a string, or a `?? d ?? e` chain, at a binding, an argument and a return: a result stored as a
// box is not the fused element read (D17382), and each prints what its hoisted twin prints.
function pop_el_const(xs: boolean[]) {
  const r = xs.pop() ?? false
  print(r)
}
function show_pop_el_arg(r: boolean) { print(r) }
function pop_el_arg(xs: boolean[]) { show_pop_el_arg(xs.pop() ?? false) }
function pop_el_ret(xs: boolean[]) { return xs.pop() ?? false }
function get_el_const(xs: boolean[], k: i32) {
  const r = xs.get(k) ?? false
  print(r)
}
function show_get_el_arg(r: boolean) { print(r) }
function get_el_arg(xs: boolean[], k: i32) {
  show_get_el_arg(xs.get(k) ?? false)
}
function get_el_ret(xs: boolean[], k: i32) { return xs.get(k) ?? false }
pop_el_const([])
pop_el_const([true])
pop_el_arg([])
pop_el_arg([true])
const r_pop_el_ret_4 = pop_el_ret([])
print(r_pop_el_ret_4)
const r_pop_el_ret_5 = pop_el_ret([true])
print(r_pop_el_ret_5)
get_el_const([true], 5)
get_el_const([true], 0)
get_el_arg([true], 5)
get_el_arg([true], 0)
const r_get_el_ret_10 = get_el_ret([true], 5)
print(r_get_el_ret_10)
const r_get_el_ret_11 = get_el_ret([true], 0)
print(r_get_el_ret_11)
