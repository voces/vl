// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 2
// @log 1
// @log 1
// @log 0
// @log a
// @log 1
// @log 0
// @log 1
// An empty list literal spread contributes nothing, at every spread position (D15286).
type P = { x: i32 }
function rest(...xs: i32[]) { xs.length }
const a = [1]
a.push(...[])
print(a.length)
a.push(2, ...[])
print(a.length)
const s = ["a"]
s.push(...[])
print(s.length)
const f = [1.5]
f.push(...[])
print(f.length)
const ll = [[1]]
ll.push(...[])
print(ll.length)
const ps: P[] = [{ x: 1 }]
ps.push(...[])
print(ps.length)
const pa = [1]
pa.push(...([]))
print(pa.length)
ll.push(...[[]])
print(ll.length)
const ann: i32[] = [1, ...[]]
print(ann.length)
const unann = [1, ...[]]
print(unann.length)
const only: i32[] = [...[]]
print(only.length)
const strs = ["a", ...[]]
print(strs[0])
const p: P = { x: 1 }
const recs = [p, ...[]]
print(recs.length)
print(rest(...[]))
print(rest(1, ...[]))
