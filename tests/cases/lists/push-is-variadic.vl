// @run
// @log 3
// @log 5
// @log 5
// @log 8
// @log 6
// @log 8
// @log c
// @log 3.5
// @log 6
// `push` is variadic, which is what makes `xs.push(...ys)` follow from the rest-parameter
// rule with no case of its own: several arguments build one list at the receiver's own rep
// and arrive as a single bulk append, while one argument keeps its element-wise lowering.
const xs = [0]
xs.push(4, 5)
print(xs.length)
print(xs[2])
const ys = [7, 8]
xs.push(...ys)
print(xs.length)
print(xs[4])
// D1592 — a push in value position still yields the new length, after all of its
// arguments rather than after the first.
const n = xs.push(11)
print(n)
const m = xs.push(12, 13)
print(m)
// The other element reps take the same path, since the packed list is built at the
// receiver's own kind rather than at the literal's self-identified one.
const s = ["a"]
s.push("b", "c")
print(s[2])
const f = [1.5]
f.push(2.5, 3.5)
print(f[2])
// A multi-argument push pins an un-annotated `[]` from its first argument, exactly as the
// one-argument form does, and checks the rest against that pin.
const inferred = []
inferred.push(5, 6)
print(inferred[1])
