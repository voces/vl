// @run
// @log 7
// @log 8
// @log 3
// A one-element list of a record holding two different un-annotated functions, whose row stores
// each as a closure (D17665), one field called: off the element, off the element bound first, and
// inside a function the list is handed to.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const xs = [{ r: inc0, s: dbl }]
print(xs[0].r(6))
const e = xs[0]
print(e.r(7))
function use(ys) { return ys[0].r(2) }
print(use(xs))
