// The hoisted twin of `pop-get-or-result-rep-boolean.vl`: each read bound to a `const` first.
function pop_el_const(xs: boolean[]) {
  const t = xs.pop()
  const r = t ?? false
  print(r)
}
function show_pop_el_arg(r: boolean) { print(r) }
function pop_el_arg(xs: boolean[]) {
  const t = xs.pop()
  show_pop_el_arg(t ?? false)
}
function pop_el_ret(xs: boolean[]) {
  const t = xs.pop()
  return t ?? false
}
function get_el_const(xs: boolean[], k: i32) {
  const t = xs.get(k)
  const r = t ?? false
  print(r)
}
function show_get_el_arg(r: boolean) { print(r) }
function get_el_arg(xs: boolean[], k: i32) {
  const t = xs.get(k)
  show_get_el_arg(t ?? false)
}
function get_el_ret(xs: boolean[], k: i32) {
  const t = xs.get(k)
  return t ?? false
}
pop_el_const([])
pop_el_const([true])
pop_el_arg([])
pop_el_arg([true])
const r_pop_el_ret_4 = pop_el_ret([])
print(r_pop_el_ret_4)
const r_pop_el_ret_5 = pop_el_ret([true])
print(r_pop_el_ret_5)
get_el_const([true], 5)
get_el_const([true], 0)
get_el_arg([true], 5)
get_el_arg([true], 0)
const r_get_el_ret_10 = get_el_ret([true], 5)
print(r_get_el_ret_10)
const r_get_el_ret_11 = get_el_ret([true], 0)
print(r_get_el_ret_11)
