// @run
// @log 7.5
// @log 6.5
// @log 8.5
// @log bb/a/z
// @log bb/a/c
// @log 6.25
// @log 4.5
// @log 3.5
// @log 5.5
// @log a/a/z
// @log a/a/c
// @log 3.25
// A spread whose source list is at another element kind than the literal's: an `i32` list widened
// into an `f64` literal, a literal union's atoms into a `string` list, each group converted by the
// plan's tail. At an annotated `const`, a return, an argument and a record field.
import { join } from "std:str"

function kk(n: i32): "a" | "bb" { return if n > 0 { "bb" } else { "a" } }
function sumF(xs: f64[]) {
  let t = 0.0
  for x in xs { t = t + x }
  return t
}
function widened(ns: i32[]): f64[] { return [...ns, 0.5] }
function strs(ks: ("a" | "bb")[]): string[] { return [...ks, "c"] }
function run(n: i32) {
  const ns = [1, 2, n]
  const fs: f64[] = [...ns, 1.5]
  print(sumF(fs))
  print(sumF(widened(ns)))
  print(sumF([...ns, 2.5]))
  const ks = [kk(n), kk(0)]
  const ss: string[] = [...ks, "z"]
  print(join(ss, "/"))
  print(join(strs(ks), "/"))
  const r = { l: [...ns, 0.25] }
  print(sumF(r.l))
}
run(3)
run(0)
// @hint redundant type annotation: `strs`
