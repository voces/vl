// @run
// @log 5
// @log 7
// @log 5
// @log 2
// @log 0
// @log 14
// D4684: an un-annotated function returning `.map` over a callback parameter that returns a
// record declares a ref-list result over that record's row, read directly, through a local,
// iterated, empty, and with a lambda passed as the callback.
type A = { v: i32 }
type B = { w: i32 }

function toB(a: A): B { return { w: a.v + 1 } }
function go(f: (a: A) => B, xs: A[]) { return xs.map(f) }
function viaLocal(f: (a: A) => B, xs: A[]) {
  const ys = xs.map(f)
  return ys
}
function readOnly(f: (a: A) => B, xs: A[]) {
  const ys = xs.map(f)
  print(ys[0].w)
}

print(go(toB, [{ v: 4 }])[0].w)
print(viaLocal(toB, [{ v: 4 }, { v: 6 }])[1].w)
readOnly(toB, [{ v: 4 }])
for b in go(toB, [{ v: 1 }]) { print(b.w) }
print(go(toB, []).length)
const k = 10
print(go((a) => { w: a.v + k }, [{ v: 4 }])[0].w)
