// @log 1
// @log k
// @log i
// @log 1
// @log 2
// @log 1
// @log 5
// @log k
// @log 1
// A union of lists stored alike (a literal set's list beside its base's) reads its elements
// through each member's arm: a walk, an index and an `is` over the nested lists, and the flat
// walk, its literal-set arm told by the elements it holds (D17730).
type K = 1 | 2
const c: K[][] | i32[][] = [[1], [2]]
for e in c { print(e.length) }
print(c[0].length)
if c is K[][] { print("k") } else { print("i") }
const d: K[][] | i32[][] = [[1], [5]]
if d is K[][] { print("k") } else { print("i") }
const f: K[] | i32[] = [1, 2]
for e in f { print(e) }
function walk(g: K[] | i32[]) {
  for e in g { print(e) }
}
walk([1, 5])
function tell(g: K[] | i32[]) {
  for e, i in g { if e is K { print("k") } else { print(i) } }
}
tell([1, 7])
