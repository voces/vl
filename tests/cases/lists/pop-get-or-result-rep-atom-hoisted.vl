// @run
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// The hoisted twin of `pop-get-or-result-rep-atom.vl`: each read bound to a `const` first.
type K = "a" | "b"
function pop_el_const(xs: K[]) {
  const t = xs.pop()
  const r = t ?? "a"
  print(r)
}
function show_pop_el_arg(r: K) { print(r) }
function pop_el_arg(xs: K[]) {
  const t = xs.pop()
  show_pop_el_arg(t ?? "a")
}
function pop_el_ret(xs: K[]) {
  const t = xs.pop()
  return t ?? "a"
}
function get_el_const(xs: K[], k: i32) {
  const t = xs.get(k)
  const r = t ?? "a"
  print(r)
}
function show_get_el_arg(r: K) { print(r) }
function get_el_arg(xs: K[], k: i32) {
  const t = xs.get(k)
  show_get_el_arg(t ?? "a")
}
function get_el_ret(xs: K[], k: i32) {
  const t = xs.get(k)
  return t ?? "a"
}
pop_el_const([])
pop_el_const(["b"])
pop_el_arg([])
pop_el_arg(["b"])
const r_pop_el_ret_4 = pop_el_ret([])
print(r_pop_el_ret_4)
const r_pop_el_ret_5 = pop_el_ret(["b"])
print(r_pop_el_ret_5)
get_el_const(["b"], 5)
get_el_const(["b"], 0)
get_el_arg(["b"], 5)
get_el_arg(["b"], 0)
const r_get_el_ret_10 = get_el_ret(["b"], 5)
print(r_get_el_ret_10)
const r_get_el_ret_11 = get_el_ret(["b"], 0)
print(r_get_el_ret_11)
