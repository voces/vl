// @run
// @log 0
// @log 1
// @log 9
// @log 2.5
// @log 1
// @log 3
// @log 8
// @log 3
// @log 2
// @log 0
// @log 5
// @log 1
// @log s1
// @log 0
// SP-044: `.clear`, `.pop` and `.get` take any expression that yields a list as their
// receiver, as `.push` and `.length` do: an element of a list, a parenthesised value, a `??`
// value and an `if` value. Each prints a value read back through the original container, so
// the op acted on the shared list and not on a copy.
type R = { k: i32 }
const l: i32[][] = [[1], [2]]
const lf: f64[][] = [[1.5, 2.5], [3.5]]
const lr: R[][] = [[{ k: 1 }], [{ k: 2 }]]
const ls: string[][] = [["s0", "s1"], []]
const m: Map<i32, i32[]> = Map()
const pick = l.length > 1

function clr() {
  l[0].clear()
  l[0].length
}
print(clr())
l[0].push(9)
print(l[0].length)
print(l[0].pop() ?? -1)
print((lf[0]).pop() ?? 0.0)
print(lf[0].length)

const inner = [7, 8]
m[1] = inner
print((m.get(1) ?? l[1]).push(3))
print((m.get(1) ?? l[1]).get(1) ?? -1)
print((m[1] ?? l[1]).pop() ?? -1)
print(inner.length)
(if pick { l[1] } else { l[0] }).clear()
print(l[1].length)

const r = lr[0].pop()
if r != null { print(r.k + 4) }
print(lr[0].length + 1)
print(ls[0].get(1) ?? "none")
ls[0].clear()
print(ls[0].length)
