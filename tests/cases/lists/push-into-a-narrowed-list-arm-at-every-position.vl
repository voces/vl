// @run
// @log 2
// @log za
// @log 5
// @log 2
// @log 2
// @log 2
// @log 2
// @log v
// @log c!
// @log n4
// @log d
// @log t
// @log r
// @log 3
// @log 2
// @log 2
// The Q58 position sweep for a `.push` into a list arm narrowed out of a union: the receiver as
// a parameter, global, field and element; the push in an if arm, a loop, a closure and the start;
// the pushed value as a call, concat, interpolation, `??`, value `if`, field read and a run.
type Box = { items: f64[] | string[] }
type R = { s: string }
function id(s: string) { return s }
function opt(b: boolean): string | null { return if b { "o" } else { null } }
function direct(x: f64[] | string[]) {
  if x is string[] { x.push("a"); print(x.length) }
}
function ifArm(x: f64[] | string[], c: boolean) {
  if x is string[] {
    if c { x.push("a") } else { x.push("b") }
    print(x[0] + x[1])
  }
}
function loop(x: f64[] | string[]) {
  if x is string[] {
    for i in 0 to 3 { x.push("a") }
    print(x.length)
  }
}
function closure(x: f64[] | string[]) {
  const g = () => {
    if x is string[] { x.push("c") }
  }
  g()
  if x is string[] { print(x.length) }
}
const gl: f64[] | string[] = ["z"]
function global() {
  if gl is string[] { gl.push("g"); print(gl.length) }
}
function field(b: Box) {
  if b.items is string[] { b.items.push("f"); print(b.items.length) }
}
function elem(a: (f64[] | string[])[]) {
  if a[0] is string[] { a[0].push("e"); print(a[0].length) }
}
function valCall(x: f64[] | string[]) {
  if x is string[] { x.push(id("v")); print(x[1]) }
}
function valConcat(x: f64[] | string[], s: string) {
  if x is string[] { x.push(s + "!"); print(x[1]) }
}
function valInterp(x: f64[] | string[], n: i32) {
  if x is string[] { x.push("n\{n}"); print(x[1]) }
}
function valCoalesce(x: f64[] | string[], b: boolean) {
  if x is string[] { x.push(opt(b) ?? "d"); print(x[1]) }
}
function valIf(x: f64[] | string[], c: boolean) {
  if x is string[] { x.push(if c { "t" } else { "e" }); print(x[1]) }
}
function valRecord(x: f64[] | string[], r: R) {
  if x is string[] { x.push(r.s); print(x[1]) }
}
function many(x: f64[] | string[]) {
  if x is string[] { x.push("a", "b"); print(x.length) }
}
function ret(x: f64[] | string[]) {
  if x is string[] {
    x.push("a")
    return x.length
  }
  return 0
}
direct(["z"])
ifArm(["z"], true)
loop(["z"])
closure(["z"])
global()
field({ items: ["z"] })
elem([["z"]])
valCall(["z"])
valConcat(["z"], "c")
valInterp(["z"], 4)
valCoalesce(["z"], false)
valIf(["z"], true)
valRecord(["z"], { s: "r" })
many(["z"])
print(ret(["z"]))
const st: f64[] | string[] = ["z"]
if st is string[] { st.push("s"); print(st.length) }
