// @run
// @log 200
// @log true
// @log true
// @log 44
// @log 45
// @log 2
// @log true
// @log 45
// @log 1
// @hint redundant type annotation: `w0` is inferred as `{f: u8[] | null}`
// @hint redundant type annotation: `ys` is inferred as `(u8[] | null)[]`

// A `u8[] | null` keeps its own rep as a list element, a record field, an inferred record field
// and a map value: each integer code table names the nullable packed byte list, so the element
// slot and the field are `(ref null …)` rather than the non-null `u8[]` code (D2239, D2249,
// D2295). A computed value stored into a byte keeps its low 8 bits: 300 reads back as 44.
function big() { 300 }
const src: u8[] | null = [200]
const xs: (u8[] | null)[] = []
xs.push(src)
const v = xs[0]
if v != null { print(v[0]) }
type W = { f: u8[] | null }
const none: u8[] | null = null
const w0: W = { f: none }
print(w0.f == null)
const w1 = { f: src }
print(w1.f != null)
const b: u8[] = [1]
b[0] = big()
const w: W = { f: b }
if w.f != null { print(w.f[0]) }
const m: {[string]: u8[] | null} = Map()
m["k"] = b
const r = m["k"]
if r != null { print(r[0] + 1) }
const ys: (u8[] | null)[] = [b, null]
print(ys.length)
print(ys[1] == null)
const z = ys[0]
if z != null { z[0] = big() + 1 }
print(b[0])
const q1: W = { f: [1] }
const q2: W = { f: null }
if q1 == q2 { print(0) } else { print(1) }
