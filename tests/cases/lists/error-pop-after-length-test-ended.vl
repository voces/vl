// @check
// @error-at 22:11 operator '+' is not defined for i32 | null and i32
// @error-at 30:11 operator '+' is not defined for i32 | null and i32
// @error-at 40:10 operator '+' is not defined for i32 and i32 | null
// @error-at 51:11 operator '+' is not defined for i32 | null and i32
// @error-at 62:11 operator '+' is not defined for i32 | null and i32
// @error-at 71:11 operator '+' is not defined for i32 | null and i32
// @error-at 80:11 operator '+' is not defined for i32 | null and i32
// @error-at 88:11 operator '+' is not defined for i32 | null and i32
// @error-at 94:46 operator '+' is not defined for i32 | null and i32
// @error-at 99:2 operator '+' is not defined for i32 | null and i32
// @error-at 104:25 operator '+' is not defined for i32 | null and i32
// @error-at 116:11 operator '+' is not defined for i32 | null and i32
// @error-at 124:11 operator '+' is not defined for i32 | null and i32
// SP-008 (D3558): what ends a `.length` test's proof before a `.pop()`. Each function below
// can reach its last pop with the list empty, or might, so every one stays `i32 | null`: a
// second pop, a push, a pop in a loop that runs again, a pop through an alias, a closure or a
// call that may pop, a reassignment, a shadowing binding, the `else` arm, below the `if`,
// inside a closure, and a write to the record through another name or an aliased parameter.
export function twoPops(xs: i32[]): i32 {
  if xs.length > 0 {
    xs.pop()
    return xs.pop() + 1
  }
  0
}

export function afterPush(xs: i32[]): i32 {
  if xs.length > 0 {
    xs.push(1)
    return xs.pop() + 1
  }
  0
}

export function nestedLoop(xs: i32[], k: i32) {
  let t = 0
  if xs.length > 0 {
    let j = 0
    while j < k {
      t = t + xs.pop()
      j = j + 1
    }
  }
  t
}

export function alias(xs: i32[]): i32 {
  if xs.length > 0 {
    const ys = xs
    ys.pop()
    return xs.pop() + 1
  }
  0
}

export function closure(xs: i32[]): i32 {
  if xs.length > 0 {
    const f = () => {
      xs.pop()
    }
    f()
    return xs.pop() + 1
  }
  0
}

function drain(l: i32[]) { l.pop() }
export function callPops(xs: i32[]): i32 {
  if xs.length > 0 {
    drain(xs)
    return xs.pop() + 1
  }
  0
}

export function reassigned(c: boolean): i32 {
  let xs = [1]
  if xs.length > 0 {
    if c { xs = [] }
    return xs.pop() + 1
  }
  0
}

export function shadowed(xs: i32[]): i32 {
  if xs.length > 0 {
    const xs: i32[] = []
    return xs.pop() + 1
  }
  0
}

export function elseArm(xs: i32[]): i32 {
  if xs.length > 0 { return 0 } else { return xs.pop() + 1 }
}

export function below(xs: i32[]): i32 {
  if xs.length > 0 { print(1) }
  xs.pop() + 1
}

export function inClosure(xs: i32[]) {
  if xs.length > 0 {
    const f = (): i32 => xs.pop() + 1
    xs.pop()
    return f()
  }
  0
}

type O = { xs: i32[] }
export function aliasWrite(o: O): i32 {
  const p = o
  if o.xs.length > 0 {
    p.xs = []
    return o.xs.pop() + 1
  }
  0
}

export function aliasParam(a: O, b: O): i32 {
  if a.xs.length > 0 {
    b.xs = []
    return a.xs.pop() + 1
  }
  0
}
