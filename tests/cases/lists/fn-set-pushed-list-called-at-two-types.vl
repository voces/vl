// @run
// @log 3
// @log 4
// @log 5
// @log 2.5
// @log 3
// @log 4
// A list built empty and pushed two un-annotated functions holds one set of them, so each
// element read calls the member it holds at that call's own arguments. The annotated face
// pushes into a list of the declared function type.
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
const xs = []
xs.push(inc)
xs.push(dbl)
print(xs[0](2))
print(xs[1](2))
print(xs[1](2.5))
print(xs[0](1.5))

function inc2(x: i32) { return x + 1 }
function dbl2(x: i32) { return x + x }
const ys: ((x: i32) => i32)[] = []
ys.push(inc2)
ys.push(dbl2)
print(ys[0](2))
print(ys[1](2))
