// @check
// @error `...` unpacks a list into a rest parameter, and `fixed` has none — VL has no tuple type, so a list's length is not known at the call. Declare the last parameter `...xs: T[]`, or pass the elements one by one
// @error `...` spreads a list, and this is string — a string is not a list of characters in VL
// @error push expects at least 1 argument, got 0
// The refusals the spread operator owes the CHECKER. Both are the design's: VL has no tuple
// type, so a list's length is never known at the call, which is the whole reason a spread
// needs a rest parameter to land in; and a string is a byte sequence with a code-point
// iteration, never a list, so there is no element type for `...` to unpack.
function fixed(a: i32, b: i32) { return a + b }
function rest(...xs: i32[]) { return xs.length }
const ys = [1, 2]
print(fixed(...ys))
print(rest(..."ab"))
const zs: i32[] = []
zs.push()
