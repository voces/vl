// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// A `.push` into a list arm narrowed out of a union, at each receiver shape: a binding, a field, an
// element and a nested field. The non-push read beside them keeps its lenient cast.
type Box = { items: f64[] | string[] }
type Out = { inn: Box }
function bind(x: f64[] | string[]) {
  if x is string[] { x.push("b"); print(x.length) }
}
function field(b: Box) {
  if b.items is string[] { b.items.push("f"); print(b.items.length) }
}
function elem(arr: (f64[] | string[])[]) {
  if arr[0] is string[] { arr[0].push("e"); print(arr[0].length) }
}
function nested(o: Out) {
  if o.inn.items is string[] {
    o.inn.items.push("n"); print(o.inn.items.length)
  }
}
function neighbour(x: f64[] | string[]) {
  if x is string[] { print(x.length) }
}
const s = ["a"]
bind(s)
field({ items: ["a"] })
elem([["a"]])
nested({ inn: { items: ["a"] } })
neighbour(s)
