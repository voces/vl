// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 1
// @log 9
// @log 1
// @log 3.5
// `.clear()` at EVERY element rep and BOTH scopes, and the refill that proves the cleared
// wrapper is still the right heap type.
//
// `.pop()` reached eight reps and `.clear()` four, so `emitClear` gained the scalar arm
// `emitPop` already had (minus the backing — a clear writes only the length field) and the
// member-call STATEMENT dispatcher's gate gained `scalarListElemKind`, which is what a `u8[]`
// receiver needed to reach `emitClear` at all rather than being refused one stage earlier by
// `emitProgram: unsupported member-call statement`.
//
// BOTH SCOPES, because they answered differently and grading one hid half the defect: at module
// scope `i64[]` and `u8[]` were CHECK-CLEAN INVALID WASM (the i32 wrapper's `struct.set` over
// another kind's wrapper) while `f64[]`/`f32[]` were loud; inside a function body all four were
// loud, and a `P[]` / `i32[][]` receiver that ran at module scope was loud too.
//
// THE REF-ELEMENT CASES ARE A DIFFERENT MECHANISM. `emitClear`/`emitPop` resolved the
// ref-element scratch frame EAGERLY, for a value only a STAGING receiver (a struct field, a
// module global, a narrowed union box) ever reads — so a BARE LOCAL, which is read in place and
// correctly had no frame reserved, was refused with `a ref-element list op needs its receiver's
// element type known before the body is lowered`. The frame is now resolved at the staging site
// (`listOpStageBase`). The tell was that `xs.clear()` alone refused while `xs.clear()` followed
// by `xs.push(…)` ran, so the last block below keeps a clear-then-refill in the fixture.

// ── module scope ─────────────────────────────────────────────────────────────
const mI32 = [1, 2]
mI32.clear()
print(mI32.length)

const mI64: i64[] = [1, 2]
mI64.clear()
print(mI64.length)

const mF64 = [1.5, 2.5]
mF64.clear()
print(mF64.length)

const mF32: f32[] = [1.5, 2.5]
mF32.clear()
print(mF32.length)

const mU8 = "ab".bytes()
mU8.clear()
print(mU8.length)

const mStr = ["a", "b"]
mStr.clear()
print(mStr.length)

const mBool = [true, false]
mBool.clear()
print(mBool.length)

// ── the same eight inside a function body ────────────────────────────────────
function inFunction() {
  const fI32 = [1, 2]
  fI32.clear()
  print(fI32.length)

  const fI64: i64[] = [1, 2]
  fI64.clear()
  print(fI64.length)

  const fF64 = [1.5, 2.5]
  fF64.clear()
  print(fF64.length)

  const fF32: f32[] = [1.5, 2.5]
  fF32.clear()
  print(fF32.length)

  const fU8 = "ab".bytes()
  fU8.clear()
  print(fU8.length)

  const fStr = ["a", "b"]
  fStr.clear()
  print(fStr.length)

  // A REF-element list on a bare local — the eager-frame face.
  const fRef = [{n: 1}, {n: 2}]
  fRef.clear()
  print(fRef.length)

  // A NESTED list, whose elements are also refs.
  const fNest = [[1], [2]]
  fNest.clear()
  print(fNest.length)
}

inFunction()

// ── the refill, which is what proves the wrapper survived ────────────────────
// `.clear()` RETAINS the backing (cap untouched), so a push after it reuses it. Reading the
// element back is the discriminating step: a wrapper cleared through the wrong heap type would
// not survive this.
function clearThenRefill() {
  const rRef = [{n: 1}, {n: 2}]
  rRef.clear()
  rRef.push({n: 9})
  print(rRef.length)
  print(rRef[0].n)

  const rF64 = [1.5, 2.5]
  rF64.clear()
  rF64.push(3.5)
  print(rF64.length)
  print(rF64[0])
}

clearThenRefill()
