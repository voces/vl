// @run
// @log null
// @log null
// @log null
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A `filter` or `slice` result of a list a kept maker's build stores at `J`, held in a record or
// list literal, is laid out at the list of `J`, as the list itself would be (D16765).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const w = { g: src.filter((y) => y.f == null) }
print(w.g[0].f)
const l = [src.slice(0, 1)]
print(l[0][0].f)
const n = { h: { g: src.filter((y) => y.f == null) } }
print(n.h.g[0].f)
