// @run
// @log 5
// @log 7
// A `??` over a list cell a write narrowed to non-null reads the cell, inside a closure as
// outside one, where the emitter carries the narrowing into the closure's body (D3419).
function inFn(x: i32) {
  const a: (i32 | null)[] = [null]
  a[0] = x
  const f = () => a[0] ?? 0
  print(f())
}
inFn(5)
const g: (i32 | null)[] = [null]
g[0] = 7
const h = () => g[0] ?? 0
print(h())
