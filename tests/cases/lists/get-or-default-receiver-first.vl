// @log -7
// @log recv
// @log idx
// @log miss
// D3756: a fused `xs.get(i) ?? d` evaluates the receiver before the index, as every other
// `.get` spelling does: the `??` form over each scalar list kind, the `const` a null test
// takes apart (SP-046), and the map reads beside them. An index out of range still misses.
const li = [1, 2]
const lf = [1.5, 2.5]
const ll = [1 as i64, 2 as i64]
const ls = [1.5 as f32, 2.5 as f32]
const mi: Map<i32, i32> = Map()
function gi() { print("recv"); li }
function gf(): f64[] { print("recv"); lf }
function gl(): i64[] { print("recv"); ll }
function gs(): f32[] { print("recv"); ls }
function gm(): Map<i32, i32> { print("recv"); mi }
function h() { print("idx"); 1 }
function ci() {
  const v = gi().get(h())
  if v == null { -1 } else { v }
}
function cf() {
  const v = gf().get(h())
  if v == null { -1.0 } else { v }
}
function cl() {
  const v = gl().get(h())
  if v == null { -1 } else { v }
}
function cs() {
  const v = gs().get(h())
  if v == null { -1.0 } else { v }
}
function cm() {
  const v = gm().get(h())
  if v == null { -1 } else { v }
}
mi[1] = 9
print(ci())
print(gi().get(h()) ?? -1)
print(cf())
print(gf().get(h()) ?? -1.0)
print(cl())
print(gl().get(h()) ?? -1)
print(cs())
print(gs().get(h()) ?? -1.0)
print(cm())
print(gm().get(h()) ?? -1)
print(gm()[h()] ?? -1)
const pv = gi().get(h())
print(pv ?? -1)
let k = -1
function hk() { print("idx"); k }
print(gi().get(hk()) ?? -7)
k = 2
print(gf().get(hk()) ?? -7.0)
print(gl().get(hk()) ?? -7)
const ov = gs().get(hk())
print(if ov == null { "miss" } else { "hit" })
