//
// THE ONE-LINE CONTROLS STILL DISCRIMINATE, and all three now RUN: delete `type Dot` (D50's
// own shape, no twin), or delete `Sq`/`Shape` (`Circle` a plain struct, never a floor).
// `tests/cases/lists/arm-elem-forin.vl` holds the twin-free spelling.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

function cell(): i32 {
  const c: Circle = { r: 7 }
  const l: Circle[] = [c]
  let t = 0
  for v in l { t = t + v.r }
  return t
}

print(cell())
