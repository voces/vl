// @run
// @log x
// @log 1.5
// @log 7
// @log 7
// @log 8
// @log y
// @log true
// @log 2.5
// @info `n` is never reassigned; use `const` instead of `let`
// An un-annotated binding of a non-empty list joined with `null` takes the list wrapper the
// join builds, at every element type, for an `if`, an else-less `if` and a `match` (D2236).

type P = { x: i32 }
function one() { 1 }

const s = if 1 == 1 { ["x"] } else { null }
if s != null { print(s[0]) }
const f = if 1 == 1 { [1.5] } else { null }
if f != null { print(f[0]) }
const l = if 1 == 1 { [(7 as i64)] } else { null }
if l != null { print(l[0]) }
const p = if 1 == 1 { [{ x: 7 }] } else { null }
if p != null { print(p[0].x) }

function inner() {
  let n = if 1 == 1 { [[8]] } else { null }
  if n != null { print(n[0][0]) }
  const m = match one() {
    1 => ["y"]
    _ => null
  }
  if m != null { print(m[0]) }
}
inner()

const e = if 1 == 1 { ["z"] }
print(e != null)
let g = if 1 == 2 { [0.5] } else { null }
g = [2.5]
if g != null { print(g[0]) }
