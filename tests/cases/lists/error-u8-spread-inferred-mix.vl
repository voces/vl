// @error a list literal mixing a `u8[]` spread with other elements has no element type, since `u8` is only an element type; annotate the destination, e.g. `const c: u8[] = [...bs, 9]`
// The INFERRED mix has no element type to land on. `u8` is only ever an element type — every
// element read widens it through `arrElemValueTy` — so the spread's `u8` and the literal's
// `i32` join to `(u8 | i32)`, which names no list. The fix is one word: annotate the
// destination `u8[]`, which `u8-spread-annotated-mix.vl` pins as running (D1852).
const bs: u8[] = [1, 2, 3]
const c = [...bs, 9]
print(c.length)
