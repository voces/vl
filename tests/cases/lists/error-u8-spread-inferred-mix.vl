// @emit-error '.length' on a receiver the emitter cannot classify as a list, string, map or set
// The INFERRED mix has no element type to land on. `u8` is only ever an element type — every
// element read widens it through `arrElemValueTy` — so the spread's `u8` and the literal's
// `i32` join to `(u8 | i32)`, which no list has a backing for. It is loud, and the fix is one
// word: annotate the destination `u8[]`, which `u8-spread-annotated-mix.vl` pins as running.
const bs: u8[] = [1, 2, 3]
const c = [...bs, 9]
print(c.length)
