// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 4
// @log none
// @log 5
// @log 6
// @log 2
// @log 9
// @log none
// A push onto a list whose element slot is nullable appends the value as it is built: a call, a
// bare `null`, a literal and a narrowed local into `(R | null)[]`, and a closure into a nullable
// closure list. Each push's returned length is printed, then each element read back.
type R = { v: i32 }
function mkr(n: i32): R { return { v: n } }
function show(x: R | null) {
  if x != null { print(x.v) } else { print("none") }
}
function fill(m: R | null): (R | null)[] {
  const xs: (R | null)[] = []
  print(xs.push(mkr(4)))
  print(xs.push(null))
  print(xs.push({ v: 5 }))
  if m != null { print(xs.push(m)) }
  return xs
}
const ys = fill(mkr(6))
print(ys.length)
show(ys[1])
show(ys[2])
show(ys[3])
const fs: ((() => i32) | null)[] = []
fs.push(null)
print(fs.push(() => 9))
const g = fs[1]
if g != null { print(g()) }
const h = fs[0]
if h == null { print("none") }
