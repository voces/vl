// @run
// @log 3
// @log a
// @log none
// @log 2
// @log true
// @log 3
// @log a
// @log none
// @log 2.5
// @log 3
// @log true
// @log true
// @log 3
// A `(string | null)[]` spread into a list of a union holding another member is boxed element by
// element, its nulls as the union's null, at a binding, an un-annotated literal, a record member
// and a return (D15045).
type K = { k: i32 }
function f(ys: (string | null)[]): (string | null | i32)[] { [...ys, 1] }
function run(xs: (string | null)[]) {
  const q: (string | null | i32)[] = [...xs, 2]
  print(q.length)
  for x in q { print(x ?? "none") }
  const r: (string | null | i32)[] = [...xs]
  print(r[1] == null)
  const u = [...xs, 2]
  print(u.length)
  const w: (string | null | f64)[] = [...xs, 2.5]
  for x in w { print(x ?? "none") }
  const k: (string | null | K)[] = [...xs, { k: 4 }]
  print(k.length)
  print(k[1] == null)
  print(f(["z", null])[1] == null)
  print(f(["z", null]).length)
}
run(["a", null])
