// @run
// @log 2
// @log 2
// @log 3
// @log 1
// @log -1
// @log 5
// @log 1
// @log 3
// @log 3
// A `.push` whose receiver holds a branch of its own (a `??`, an `if`, a captured cell's read),
// legacy's receiver written whole before the value, and an optional receiver read at its use
// below a value that assigns: in a function, a lambda, at top level, and a value that reassigns
// a local receiver.
const l: i32[][] = [[1], [2]]
const m: Map<i32, i32[]> = Map()
function coal() { return (m.get(1) ?? l[1]).push(3) }
function param(xs: i32[] | null) { return (xs ?? l[0]).push(4) }
function branch(k: i32) { return (if k > 0 { l[0] } else { l[1] }).push(k) }
function cell() {
  let xs: i32[]
  const gx = () => {
    return xs.push(10)
  }
  xs = []
  return gx()
}
function opt(set: boolean) {
  let c: i32 | null = null
  const xs = if set { [0] } else { null }
  xs?.push(c = 5)
  return c ?? -1
}
function again() {
  let xs = [1]
  const old = xs
  xs.push((xs = [9, 8]).length)
  print(old.length)
  return xs.length
}
print(coal())
print(param(null))
print(branch(1))
print(cell())
print(opt(false))
print(opt(true))
print(again())
print((m.get(2) ?? l[1]).push(7))
