// @log b
// @log c
// @log c
// @log b
// @log c
// @log c
// @log b
// @log c
// @log c
// @log b
// @log c
// @log c
// @log b
// @log c
// @log c
// @log v=b
// @log v=c
// @log v=c
// @log b
// @log c
// @log c
// @log b
// @log c
// @log c
// @log b
// @log c
// @log b
// @log c
// @log b
// @log b
// @log c
// @log b
// @log c
// @log a
// @log 24
// `xs.get(i) ?? d` over an atom list at nine positions, a literal, negative, field and global
// receiver or index, a `?? ys.get(j) ?? d` chain and a conditional default: the default runs
// only on a miss, counted by `calls`, and each prints what legacy's fused read prints.
type K = "a" | "b" | "c"
let calls = 0
function d(): K {
  calls = calls + 1
  return "c"
}
function show(r: K) { print(r) }
function id(r: K): K { return r }
type H = { xs: K[] }
const gs: K[] = ["b", "b"]
function get_let_init(xs: K[], i: i32) {
  const r = xs.get(i) ?? d()
  print(r)
}
function get_element(xs: K[], i: i32) {
  const ys = [xs.get(i) ?? d()]
  print(ys[0])
}
function get_arg(xs: K[], i: i32) {
  show(xs.get(i) ?? d())
}
function get_ret(xs: K[], i: i32): K { return xs.get(i) ?? d() }
function get_field(xs: K[], i: i32) {
  const o = { v: xs.get(i) ?? d() }
  print(o.v)
}
function get_if_arm(xs: K[], i: i32) {
  const r = if xs.length > 0 { xs.get(i) ?? d() } else { "a" }
  print(r)
}
function get_nested_arg(xs: K[], i: i32) {
  show(id(xs.get(i) ?? d()))
}
function get_interp(xs: K[], i: i32) {
  print("v=\{xs.get(i) ?? d()}")
}
function get_assign(xs: K[], i: i32) {
  let r: K = "a"
  r = xs.get(i) ?? d()
  print(r)
}
get_let_init(["b", "b"], 1)
get_let_init(["b", "b"], 5)
get_let_init(["b", "b"], -1)
get_element(["b", "b"], 1)
get_element(["b", "b"], 5)
get_element(["b", "b"], -1)
get_arg(["b", "b"], 1)
get_arg(["b", "b"], 5)
get_arg(["b", "b"], -1)
print(get_ret(["b", "b"], 1))
print(get_ret(["b", "b"], 5))
print(get_ret(["b", "b"], -1))
get_field(["b", "b"], 1)
get_field(["b", "b"], 5)
get_field(["b", "b"], -1)
get_if_arm(["b", "b"], 1)
get_if_arm(["b", "b"], 5)
get_if_arm(["b", "b"], -1)
get_nested_arg(["b", "b"], 1)
get_nested_arg(["b", "b"], 5)
get_nested_arg(["b", "b"], -1)
get_interp(["b", "b"], 1)
get_interp(["b", "b"], 5)
get_interp(["b", "b"], -1)
get_assign(["b", "b"], 1)
get_assign(["b", "b"], 5)
get_assign(["b", "b"], -1)
function get_lit(xs: K[]) { print(xs.get(0) ?? d()) }
function get_neg(xs: K[]) { print(xs.get(-1) ?? d()) }
function get_field_recv(h: H, i: i32) { print(h.xs.get(i) ?? d()) }
function get_global_recv(i: i32) { print(gs.get(i) ?? d()) }
function get_chain(xs: K[], ys: K[], i: i32, j: i32) { print(xs.get(i) ?? ys.get(j) ?? d()) }
function get_cond(xs: K[], i: i32, c: boolean) { print(xs.get(i) ?? (if c { d() } else { "a" })) }
get_lit(["b", "b"])
get_lit([])
get_neg(["b", "b"])
get_field_recv({ xs: ["b", "b"] }, 1)
get_field_recv({ xs: ["b", "b"] }, 7)
get_global_recv(1)
get_global_recv(9)
get_chain(["b", "b"], [], 1, 0)
get_chain([], ["b", "b"], 0, 1)
get_chain([], [], 0, 1)
get_cond(["b", "b"], 1, true)
get_cond(["b", "b"], 4, true)
get_cond(["b", "b"], 4, false)
print(calls)
