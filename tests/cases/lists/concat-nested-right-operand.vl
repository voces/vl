// @run
// @log i32 6 1 2 6
// @log str 6 p u
// @log f64 4 1.5 4.5
// @log i64 4 1 3
// @log f32 4 1 3
// @log u8 4 1 3
// @log bool 4 false
// @log struct 4 1 3
// @log nested 4 1 4
// @log nullable 6 1 6
// @log plus-eq 4 1 3
// @log generic 6 1 x
// @log closure 1
// @log globals 1
// @log field 4 1
// @log for-in 1234
// @log true
// @hint redundant type annotation: `pa` is inferred as `{x: i32}[]`
// @hint redundant type annotation: `pb` is inferred as `{x: i32}[]`
// @hint redundant type annotation: `fromGlobals` is inferred as `i32[]`
// @hint redundant type annotation: `q` is inferred as `{xs: i32[], n: i32}`
// A list `+` whose right operand is itself a `+` keeps its left operand: both operands
// are complete before the concat's frame is written, at every list rep, through `+=`, in a
// generic at two instances, a closure, a function reading globals and a loop (D2331).
type P = { x: i32 }
type Q = { xs: i32[], n: i32 }
const a = [1, 2]
const b = [3]
const c = [4, 5, 6]
const d = a + (b + c)
print("i32 \{d.length} \{d[0]} \{d[1]} \{d[5]}")
const s = ["p", "q"] + (["r"] + ["s", "t", "u"])
print("str \{s.length} \{s[0]} \{s[5]}")
const f = [1.5, 2.5] + ([3.5] + [4.5])
print("f64 \{f.length} \{f[0]} \{f[3]}")
const i64a: i64[] = [1, 2]
const i64b: i64[] = [3]
const l = i64a + (i64b + i64b)
print("i64 \{l.length} \{l[0]} \{l[3]}")
const f32a: f32[] = [1, 2]
const f32b: f32[] = [3]
const g = f32a + (f32b + f32b)
print("f32 \{g.length} \{g[0]} \{g[3]}")
const u8a: u8[] = [1, 2]
const u8b: u8[] = [3]
const u = u8a + (u8b + u8b)
print("u8 \{u.length} \{u[0]} \{u[3]}")
const bl = [true, false] + ([true] + [true])
print("bool \{bl.length} \{bl[1]}")
const pa: P[] = [{ x: 1 }, { x: 2 }]
const pb: P[] = [{ x: 3 }]
const pl = pa + (pb + pb)
print("struct \{pl.length} \{pl[0].x} \{pl[3].x}")
const nl = [[1], [2]] + ([[3]] + [[4]])
print("nested \{nl.length} \{nl[0][0]} \{nl[3][0]}")
function mk(n: i32): i32[] | null {
  if n > 0 { return [n, n + 1] }
  null
}
const na = mk(1)
const nb = mk(5)
if na != null && nb != null {
  const nd = na + (nb + nb)
  print("nullable \{nd.length} \{nd[0]} \{nd[5]}")
}
let xs = [1, 2]
xs += b + b
print("plus-eq \{xs.length} \{xs[0]} \{xs[3]}")
function cat3<T>(p: T[], q: T[], r: T[]): T[] { return p + (q + r) }
const r1 = cat3(a, b, c)
const r2 = cat3(["x"], ["y"], ["z"])
print("generic \{r1.length} \{r1[0]} \{r2[0]}")
const clo = (p: i32[], q: i32[]): i32[] => p + (q + p)
print("closure \{clo([1], [2, 3])[0]}")
function fromGlobals(): i32[] { return a + (b + a) }
print("globals \{fromGlobals()[0]}")
const q: Q = { xs: [1, 2] + ([3] + [4]), n: 9 }
print("field \{q.xs.length} \{q.xs[0]}")
let walked = 0
for v in a + ([3] + [4]) { walked = walked * 10 + v }
print("for-in \{walked}")
print(a + (b + c) == [1, 2, 3, 4, 5, 6])
