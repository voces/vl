// @run
// @log 1
// @log 102
// @log 4
// @log s4
// @log i=5
// @log 3
// @log 6
// @log 7
// @log 8
// @log 9
// @log 8
// Q58 position sweep: a list literal of struct literals whose layout row records a same-layout
// twin with a nullable field, each element built at the list's element on their shared heap, as
// a constant initializer and handed as a scalar and a union call argument, a nested call
// argument, a concat operand, an interpolation hole, a return, a let initializer, an if arm, a
// `??` operand and a record field.
type A = { v: i32 }
type J = { f: A | null }
type I = { f: A }
const il = [{ f: { v: 7 } }]
const cp = [...il]
function first(xs: { f: { v: i32 } }[]) { return xs[0].f.v }
function takeU(x: i32 | string) {
  if x is string { print(x) } else { print(x + 100) }
}
function inc(x: i32) { return x + 1 }
function show(n: i32) { return "\{n}" }
function mk() { return [{ f: { v: 3 } }] }
function maybe(k: i32): { f: { v: i32 } }[] | null {
  return if k > 0 { [{ f: { v: 1 } }] } else { null }
}
function go(c: boolean) {
  print(first([{ f: { v: 1 } }]))
  takeU(first([{ f: { v: 2 } }]))
  print(inc(first([{ f: { v: 3 } }])))
  print("s" + show(first([{ f: { v: 4 } }])))
  print("i=\{first([{ f: { v: 5 } }])}")
  print(first(mk()))
  const l = [{ f: { v: 6 } }]
  print(first(l))
  const k = if c { [{ f: { v: 7 } }] } else { [{ f: { v: 0 } }] }
  print(first(k))
  print(first(maybe(0) ?? [{ f: { v: 8 } }]))
  const r = { xs: [{ f: { v: 9 } }] }
  print(first(r.xs))
}
go(true)
function tail() { print(cp.length + il[0].f.v) }
tail()
