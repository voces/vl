// @run
// @log 4
// @log 3
// @log 2
// @log 3
// @log 7
// @log 15
// @log ab
// @log 6
// @log 8
// @log 9
// @log 10
// @log 11
// @log 4
// sunpa SP-008 (D3558): under `xs.length > 0` (or `!= 0`, `>= 1`, `0 < xs.length`) the first
// `xs.pop()` of that same list is its element, not `T | null`. The flood-fill loop is the
// witness; each element rep pops unchecked, at a binding, an argument, a return, a field
// path, an else-if link and a value-position `if`. `xs[xs.length - 1]` is an element already.
type S = { n: i32 }
const stack = [1, 2, 3]
while stack.length > 0 {
  const k = stack.pop()
  print(k + 1)
}
const fs = [1.5]
if fs.length != 0 { print(fs.pop() * 2.0) }
const ls: i64[] = [6]
if ls.length >= 1 { print(ls.pop() + 1) }
const us: u8[] = [14]
if 0 < us.length { print(us.pop() + 1) }
const strs = ["a"]
if strs.length > 0 {
  const t = strs.pop()
  print(t + "b")
}
function need(s: S) { s.n }
const ss = [{ n: 6 }]
if ss.length > 0 { print(need(ss.pop())) }
type O = { xs: i32[] }
const o = { xs: [8] }
if o.xs.length > 0 { print(o.xs.pop()) }
function last(xs: i32[]) {
  if xs.length > 0 { return xs.pop() }
  -1
}
print(last([9]))
function chain(xs: i32[], c: boolean) {
  if c { return 0 }
  else if xs.length != 0 { return xs.pop() }
  -2
}
print(chain([10], false))
function valueIf(xs: i32[]) {
  const r = if xs.length > 0 { xs.pop() } else { -1 }
  r
}
print(valueIf([11]))
const peek = [3, 4]
print(peek[peek.length - 1])
