// @run
// @log 1
// @log 20
// @log 3
// @log 90
// @log 70
// @log n
// @log 1.5
// @log 9
// @log 60
// @log 600
// @log 4
// @log 5
// @log 8
// D2575: an un-annotated function returning a `.map` whose callback builds a record declares a
// ref-list result over that record's row, with the result unused, read, passed on, stored in a
// field, iterated and mapped again. D2303: the same through a named callback and a local.
type Shape = { kind: "c", r: i32 } | { kind: "s", side: i32 }
type P = { x: i32, y: i32 }

function f(xs: i32[]) { return xs.map((e) => { x: e * 10, y: 0 }) }
function g(xs: i32[]) { xs.map((e) => { name: "n", k: e, w: 1.5 }) }
const h = (xs: i32[]) => xs.map((e) => { x: e + 1, y: e })
function circles(xs: i32[]) { return xs.map((e) => { kind: "c", r: e }) }
function mk(e: i32): P { return { x: e, y: 0 } }
function viaCall(xs: i32[]) { return xs.map((e) => mk(e)) }

type Box = { items: { x: i32, y: i32 }[] }
function total(ps: { x: i32, y: i32 }[]) {
  let s = 0
  for p in ps { s = s + p.x }
  s
}

f([3, 1, 2])
print(1)
const r = f([3, 1, 2])
print(r[2].x)
print(r.length)
print(total(f([4, 5])))
const b: Box = { items: f([7]) }
print(b.items[0].x)
print(g([2])[0].name)
print(g([2])[0].w)
print(h([8])[0].x)
let acc = 0
for q in f([1, 2, 3]) { acc = acc + q.x }
print(acc)
print(f(f([6]).map((p) => p.x))[0].x)
print(circles([4])[0].r)
print(viaCall([3, 5])[1].x)
function viaNamed(xs: i32[]) {
  const ys = xs.map(mk)
  return ys
}
print(viaNamed([2, 8])[1].x)
