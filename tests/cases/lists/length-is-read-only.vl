// @check
// @error-at 12:34 `length` is read-only; to empty a list use `ys.clear()` or `ys = []`
// @error-at 15:5 `length` is read-only; to empty a list use `xs.clear()` or `xs = []`
// @error-at 16:5 `length` is read-only; to empty a list use `xs.clear()` or `xs = []`
// @error-at 17:5 `length` is read-only; to empty a list use `xs.clear()` or `xs = []`
// @error-at 19:4 `length` is read-only; to empty a map or set use `m.clear()`
// @error-at 21:5 `length` is read-only; to empty a map or set use `st.clear()`
// @error-at 23:4 `length` is read-only
// D3586 (sunpa SP-023) — `.length` is read-only on a list, a map, a set and a string, so a
// write to it is a check error spanned on `.length`. It used to pass `vl check` and then
// fail to emit. A record's own field named `length` stays assignable
// (`lists/record-length-field-assignable.vl`).
function generic<T>(ys: T[]) { ys.length = 0 }
function main() {
  const xs: i32[] = [1, 2, 3]
  xs.length = 0
  xs.length += 1
  xs.length -= 1
  const m: {[string]: i32} = Map()
  m.length = 0
  const st = Set<i32>()
  st.length = 0
  const s = "abc"
  s.length = 1
  generic([1])
  print(xs.length + m.length + st.length + s.length)
}
main()
