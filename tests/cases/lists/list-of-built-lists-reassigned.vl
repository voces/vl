// @run
// @log null
// @log 1
// @log null
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// `ss` holds `src`, whose records are stored at `J`, so a list of lists reassigned to it builds
// its fresh records at `J` too (D16792).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
let ss = [src]
ss = [[{ f: null }]]
print(ss[0][0].f)
print(ss[0].filter((y) => y.f == null).length)
ss = [[{ f: null }], src]
print(ss[1][0].f)
