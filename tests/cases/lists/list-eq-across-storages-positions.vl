// @log yes
// Q58 position sweep: `==` and `!=` over two lists stored apart (an f64 list beside an i32 one, an
// i64 one beside a literal), compared by value across their storages: a print operand, a `!=`, an
// if condition, a binding, an argument and a return, in the start body and in a function.
const g = [1.0, 2.0]
const i = [1, 2]
const l: i64[] = [1, 2]
function show(b: boolean) { print(b) }
function same(a: i64[]) { return a == [1, 2] }
print(g == i)
print(g != i)
if l == [1, 2] { print("yes") }
const e = i == g
print(e)
show(l == [1, 2])
function inFn(k: i32) {
  print(g == [1, k])
  print(same(l))
  if g == i { print("yes") }
}
inFn(3)
