// @run
// @log 6.5
// @log 6.5
// @log 6.5
// @log 6.5
// @log 9.5
// @log 6.5
// @log 9.5
// @log 8.5
// The hoisted twin of `list-get-nested-stash-f64.vl`: every call bound to a `const` first.
function L(xs: f64[]) { return xs }
function I(xs: i32[]) { return xs }
function pick(k: i32) { return ls[k] }
const b = [5.5, 6.5, 7.5]
const f = [8.5, 9.5]
const ls = [b, f]
const c = [2, 1, 0]
const e = [1, 0]
const i = 1
const lb = L(b)
const lf = L(f)
const ic = I(c)
const ie = I(e)
print(lb.get(1) ?? -1.0)
const a1 = ic.get(1) ?? 0
print(lb.get(a1) ?? -1.0)
const a2 = ie.get(0) ?? 0
const a3 = ic.get(a2) ?? 0
print(lb.get(a3) ?? -1.0)
print(b.get(a1) ?? -1.0)
print(lb.get(9) ?? (lf.get(i) ?? -1.0))
print(lb.get(9) ?? (lf.get(9) ?? (lb.get(a2) ?? -1.0)))
const r1 = L(pick(a1))
print(r1.get(1) ?? -1.0)
const r2 = L(pick(a3))
print(r2.get(0) ?? -1.0)
