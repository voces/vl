// @run
// @log q
// @log q
// @log q
// @log q
// @log t
// @log q
// @log t
// @log s
// A `.get` that stages its receiver or index, with a staging `.get` nested in its index, its
// default and its receiver's argument, at depths 1 to 3, over string lists: each nested call takes
// its own stash, so each prints what its hoisted twin prints (D17381).
function L(xs: string[]) { return xs }
function I(xs: i32[]) { return xs }
function pick(k: i32) { return ls[k] }
const b = ["p", "q", "r"]
const f = ["s", "t"]
const ls = [b, f]
const c = [2, 1, 0]
const e = [1, 0]
const i = 1
print(L(b).get(1) ?? "-")
print(L(b).get(I(c).get(1) ?? 0) ?? "-")
print(L(b).get(I(c).get(I(e).get(0) ?? 0) ?? 0) ?? "-")
print(b.get(I(c).get(1) ?? 0) ?? "-")
print(L(b).get(9) ?? (L(f).get(i) ?? "-"))
print(L(b).get(9) ?? (L(f).get(9) ?? (L(b).get(I(e).get(0) ?? 0) ?? "-")))
print(L(pick(I(c).get(1) ?? 0)).get(1) ?? "-")
print(L(pick(I(c).get(I(e).get(0) ?? 0) ?? 0)).get(0) ?? "-")
