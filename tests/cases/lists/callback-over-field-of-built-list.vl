// @run
// @log true
// @log 1
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A `map` or `filter` callback over a field read of a record literal no write reaches takes the
// element row the field's list was built at, as a callback over the list's own binding does (D16210).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const xs = [mk2()]
const r = { ys: xs }
print(r.ys.map((y) => y.f == null)[0])
print(r.ys.filter((y) => y.f == null).length)
