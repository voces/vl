// @run
// @log b
// @log b
// @log 1
// @log 1
// @log a
// @log b
// @log a
// @log b
// @log 1
// @log 1
// @log 2
// @log 2
// The OPERATION axis for a bare INLINE literal-union array (`("a" | "b")[]`), beside its `K[]`
// alias control: index read, indexed WRITE, `push`, `for … in`, a member compare, and a
// struct-field round trip. The sibling file pins the BINDING positions; this one pins that the
// element VALUES survive the atom rep once the binding is right — a cell can be declared with
// the correct wrapper and still read its elements as string refs.
//
// Both spellings must agree on every line: the inline and the alias forms denote ONE type
// (`type K = "a" | "b"` and `("a" | "b")` intern the same members), so any line where the two
// columns disagree is the canon-softening split re-opening.

type K = "a" | "b"
type SInline = { xs: ("a" | "b")[] }
type SAlias = { xs: K[] }

function ops() {
  const xs: ("a" | "b")[] = ["a", "b"]
  const ys: K[] = ["a", "b"]
  print(xs[1]) // b
  print(ys[1]) // b

  const p: ("a" | "b")[] = []
  p.push("a")
  const q: K[] = []
  q.push("a")
  print(p.length) // 1
  print(q.length) // 1

  for v in xs { print(v) } // a, b
  for v in ys { print(v) } // a, b

  let hitX = 0
  if xs[0] == "a" { hitX = 1 }
  let hitY = 0
  if ys[0] == "a" { hitY = 1 }
  print(hitX) // 1
  print(hitY) // 1

  // DECLARED struct types on purpose. The INLINE-SHAPE spelling of the same field
  // (`const s: { xs: ("a" | "b")[] } = …`) still emits an unparseable module on this
  // build — a seam the arena does not reach; recorded in the PR, not pinned here.
  const s: SInline = { xs: ["a"] }
  s.xs.push("b")
  const t: SAlias = { xs: ["a"] }
  t.xs.push("b")
  print(s.xs.length) // 2
  print(t.xs.length) // 2
}
ops()
