// @run
// @log 9
// @log 3
// @log 4
// @log 5
// @log 6
// D14531: a call in a list literal that is only indexed is built where another call of the same
// function is delivered, and the list holds it there.
type Circle = { r: i32 | null }
function sink(x: Circle) { print(x.r ?? 9) }
function mkcall() {
  const cc = { r: null }
  return cc
}
sink(mkcall())
const y = [mkcall()][0]
print(y.r ?? 3)
print([mkcall()][0].r ?? 4)
const y2 = [mkcall(), mkcall()][1]
print(y2.r ?? 5)
const xs = [mkcall()]
print(xs[0].r ?? 6)
