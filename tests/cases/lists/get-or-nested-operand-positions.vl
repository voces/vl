// @run
// @log 6
// @log 6
// @log 7
// @log 6
// @log 7
// @log 7
// @log 6
// @log 2
// @log 7.5
// @log -1
// @log 21
// A fused `xs.get(i) ?? d` whose index, or receiver, holds another fused read: each receiver and
// index is evaluated once, in order, and read from its local at each of the head's reads, at a
// `const`, an argument, a function, a global receiver, a float list and a miss's default. The
// last line counts the calls.
let calls = 0
function L(xs: i32[]) {
  calls = calls + 1
  return xs
}
function F(xs: f64[]) {
  calls = calls + 1
  return xs
}
function pick(k: i32) { return ls[k] }
function show(n: i32) { print(n) }
const b = [5, 6, 7]
const c = [2, 1, 0]
const e = [1, 2]
const ls = [b, c, e]
const fs = [6.5, 7.5]
print(L(b).get(L(c).get(1) ?? 0) ?? -1)
const k = L(b).get(L(c).get(L(e).get(0) ?? 0) ?? 0) ?? -1
print(k)
print(b.get(L(c).get(0) ?? 0) ?? -1)
show(L(b).get(L(e).get(0) ?? 0) ?? -1)
function inner() { return L(b).get(L(c).get(0) ?? 0) ?? -1 }
print(inner())
print(L(pick(L(c).get(2) ?? 0)).get(2) ?? -1)
print(L(b).get(9) ?? (L(c).get(L(e).get(1) ?? 0) ?? -2) + 6)
print(L(pick(L(e).get(1) ?? 0)).get(1) ?? -1 + 7)
print(F(fs).get(L(e).get(0) ?? 0) ?? -1.0)
print(L(b).get(L(c).get(9) ?? 7) ?? -1)
print(calls)
