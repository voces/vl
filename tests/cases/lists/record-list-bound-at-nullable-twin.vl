// @run
// @log 1
// @log 1
// @log 7
// A list of records bound at the list of the record or `null`, and back, is the same list: one
// ref list holds both, so the binding converts nothing.
type Circle = { r: i32 }
function f() {
  const xs = [{ r: 7 }]
  const a: (Circle | null)[] = xs
  const b: Circle[] = xs
  print(a.length)
  print(b.length)
  print(b[0].r)
}
f()
