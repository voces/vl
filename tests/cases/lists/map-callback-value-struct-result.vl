// @run
// @log 2
// @log 7
// @log 50
// @log 72
// @log 5
// @log 2
// @log 12
// A `.map` whose callback is a function VALUE (a parameter, or a binding holding a returned
// closure) and returns a struct. The callback has no lifted entry, so the result list's row
// is interned from the call's recorded `B[]`; without it every read, write and walk of the
// result found no row and the compiler trapped (D2301). One position per line.
type A = { v: i32 }
type B = { w: i32 }
function toB(a: A): B { return { w: a.v + 1 } }

// `.get(i)?.f ?? d`, the probe's own shape.
function viaGet(f: (A) => B, xs: A[]) { return xs.map(f).get(0)?.w ?? 0 }
print(viaGet(toB, [{ v: 1 }]))

// an index read
function viaIndex(f: (A) => B, xs: A[]) {
  const ys = xs.map(f)
  return ys[1].w
}
print(viaIndex(toB, [{ v: 1 }, { v: 6 }]))

// an indexed write, then a read of it
function viaIndexWrite(f: (A) => B, xs: A[]) {
  const ys = xs.map(f)
  ys[0] = { w: 50 }
  return ys[0].w
}
print(viaIndexWrite(toB, [{ v: 1 }]))

// `.push`, `.pop` and `.clear`
function viaPushPop(f: (A) => B, xs: A[]) {
  const ys = xs.map(f)
  ys.push({ w: 70 })
  const p = ys.pop()
  const n = ys.length
  ys.clear()
  return (p?.w ?? 0) + n + ys.length
}
print(viaPushPop(toB, [{ v: 1 }, { v: 2 }]))

// a `for` walk over the call itself
function viaForIn(f: (A) => B, xs: A[]) {
  let t = 0
  for y in xs.map(f) { t = t + y.w }
  return t
}
print(viaForIn(toB, [{ v: 1 }, { v: 2 }]))

// a `.filter` chained on the result
function viaFilter(f: (A) => B, xs: A[]) {
  return xs.map(f).filter((b: B) => b.w > 1).length
}
print(viaFilter(toB, [{ v: 1 }, { v: 0 }, { v: 5 }]))

// a binding holding a returned closure, which captures
function mk(k: i32): (A) => B { return (a: A): B => ({ w: a.v + k }) }
function viaBinding() {
  const g = mk(10)
  const ys = [{ v: 1 }, { v: 2 }].map(g)
  return ys[1].w
}
print(viaBinding())
