// @log 22
// @log 2.5
// @log 1.5
// @log 72
// @log 72
// @log 72
// @log 72
// @log 143
// @log 72
// @log 2.5
// @log 1.5
// A spread group at a sub row, a source whose element is a subtype of the literal's (a record list
// beside `null`, a wider record list into a narrower one), is copied at its own row. Positions:
// binding, argument, `return`, record field, assignment, list element.
type C = { r: i32 }
type Shape = { r: f64 }
type Circle = { r: f64, w: f64 }
type H = { l: (C | null)[] }
function nn(l: (C | null)[]) {
  let k = 0
  for e in l {
    if e != null { k = k + e.r }
  }
  return k * 10 + l.length
}
function rs(l: Shape[]) { return l[0].r + l.length }
function ret(cs: C[]) { return [...cs, null] }
function run(n: i32) {
  const cs: C[] = [{ r: n }]
  const v = [...cs, null]
  print(nn(v))
  print(nn([null, ...cs]))
  print(nn(ret(cs)))
  const h: H = { l: [...cs, null] }
  print(nn(h.l))
  let a: (C | null)[] = []
  a = [...cs, ...cs, null]
  print(nn(a))
  const ls = [[...cs, null]]
  print(nn(ls[0]))
  const ci: Circle[] = [{ r: 0.5, w: 1.0 }]
  const sh: Shape[] = [...ci, { r: ci[0].w + 1.0 }]
  print(rs(sh))
  print(rs([...ci]))
}
run(2)
run(7)
