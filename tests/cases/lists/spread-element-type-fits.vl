// @run
// @hint redundant type annotation: `wide` is inferred as `f64` — remove it to lean on inference
// @log 2.5
// @log 0.5
// @log 2
// @log s
// @log 8
// @log p
// @log 0.75
// @log 5
// @log 4
// @log 2
// @log 0.75
// @log 0.75
// @log 0.75
// @log 6
// @log 1.5
// @log q
// A spread whose element fits the destination's element keeps running: the exact type, an
// `i32` into `f64`, a nullable or union element, records, nested lists, and a type parameter
// pinned at a type that fits, directly and at an argument (D3253).
const fs = [1.5, 2.5]
const a: f64[] = [...fs]
print(a[1])
const ns = [1, 2]
const b: f64[] = [...ns]
print(b[1] / 4.0)
const c: (i32 | null)[] = [...ns, null]
print(c[1])
const d: (i32 | string)[] = [...ns, "s"]
print(d[2])
function same<T>(xs: T[]): T[] {
  const ys: T[] = [...xs]
  return ys
}
print(same([7, 8])[1])
print(same(["p"])[0])
function wide<T>(xs: T[]): f64 {
  const ys: f64[] = [...xs]
  return ys[0] / 4.0
}
print(wide([3.0]))
function r(...xs: i64[]) { return xs[0] }
const ls: i64[] = [5]
print(r(...ls))
type P = { x: i32 }
const ps: P[] = [{ x: 3 }]
const e: P[] = [...ps, { x: 4 }]
print(e[1].x)
const nn: i32[][] = [[1], [2]]
const f: i32[][] = [...nn]
print(f[1][0])
function h(zs: f64[]) { return zs[0] / 4.0 }
function lit<T>(x: T) { return h([x]) }
function spread<T>(xs: T[]) { return h([...xs]) }
function hop<T>(xs: T[]) { return h(xs) }
print(lit(3))
print(spread([3.0]))
print(hop([3.0]))
function g(xs: i32[][]) { return xs[0][0] }
function nest<T>(xs: T[]) { return g([xs]) }
print(nest([6]))
function first<U>(xs: U[]): U { return xs[0] }
function pass<T>(xs: T[]) { return first(xs) }
print(pass([1.5]))
print(pass(["q"]))
