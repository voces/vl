// @run
// @log 7
// @log 3
// @log NUL
// @log 2
// @log 1
// @log y
// @log z
// @log 1.5
// @log 2.5
// @log 7
// @log 3
// @log 7
// @log 3
// @log 7
// @log 3
// @log 7
// @log 3
// @log NUL
// @log 1
// @log 7
// @log 3
// @log 7
// @log 3
// @log 7
// @log 4
// @log 7
// @log 4
// @log 9
// @log 3
// @log SIDE
// @log 7
// @hint redundant type annotation: `returnsList` is inferred as `i32[]`
// @hint redundant type annotation: `v` is inferred as `i32[]?`
// @hint redundant type annotation: `o` is inferred as `{rest: i32[]?}`
// @hint redundant type annotation: `xs` is inferred as `i32[]?[]`
// @hint redundant type annotation: `loud` is inferred as `i32[]`
// `??` over a nullable COLLECTION niche — a `(ref null $wrapper)` cell, across all three list
// families, because each carries a DIFFERENT wrapper heap type and a lowering that names the
// wrong one is `vl check`-clean invalid wasm: the i32-backed `i32[] | null`, the
// DISTINCT-backing scalar lists (`string[] | null`, `f64[] | null`), and the ref arrays
// (`i32[][] | null`, `S[] | null`).
//
// One `br_on_non_null` lowering serves every LHS source — a param, a struct FIELD, a
// `(i32[] | null)[]` element, and a CALL result, which no re-eval and no stash slot could cover
// together — and the default is reached only when the LHS was null. Both runtime inputs per
// shape: the null leg exercises the default arm, the present leg the branch.

// ── i32[] | null (the i32-backed wrapper) ──
function i32List(p: i32[] | null) {
  const v = p ?? [7]
  print(v[0])
}
i32List(null) // 7
i32List([3])  // 3

function i32ListNulDefault(p: i32[] | null, q: i32[] | null) {
  const v = p ?? q
  if v != null { print(v[0]) } else { print("NUL") }
}
i32ListNulDefault(null, null) // NUL
i32ListNulDefault(null, [2])  // 2
i32ListNulDefault([1], null)  // 1

// ── string[] | null and f64[] | null (their own wrappers) ──
function strList(p: string[] | null) {
  const v = p ?? ["y"]
  print(v[0])
}
strList(null)  // y
strList(["z"]) // z

function f64List(p: f64[] | null) {
  const v = p ?? [1.5]
  print(v[0])
}
f64List(null)  // 1.5
f64List([2.5]) // 2.5

// ── i32[][] | null and S[] | null (a ref array's slot wrapper) ──
function nestedList(p: i32[][] | null) {
  const v = p ?? [[7]]
  print(v[0][0])
}
nestedList(null)   // 7
nestedList([[3]])  // 3

type Cell = { n: i32 }

function structList(p: Cell[] | null) {
  const v = p ?? [{ n: 7 }]
  print(v[0].n)
}
structList(null)      // 7
structList([{ n: 3 }]) // 3

// ── the consumer positions: an ANNOTATED binding, an argument, a return ──
function takesList(v: i32[]) { print(v[0]) }

function asArgument(p: i32[] | null) { takesList(p ?? [7]) }
asArgument(null) // 7
asArgument([3])  // 3

function returnsList(p: i32[] | null): i32[] { return p ?? [7] }
const retNul = returnsList(null)
print(retNul[0]) // 7
const retVal = returnsList([3])
print(retVal[0]) // 3

function annotated(p: i32[] | null, q: i32[] | null) {
  const v: i32[] | null = p ?? q
  if v != null { print(v[0]) } else { print("NUL") }
}
annotated(null, null) // NUL
annotated([1], null)  // 1

// ── the LHS sources: a struct FIELD (code 18), a `(i32[] | null)[]` element, and a CALL ──
type Holder = { rest: i32[] | null }

function fieldLhs(p: i32[] | null) {
  const o: Holder = { rest: p }
  const v = o.rest ?? [7]
  print(v[0])
}
fieldLhs(null) // 7
fieldLhs([3])  // 3

function elemLhs(p: i32[] | null) {
  const xs: (i32[] | null)[] = [p]
  const v = xs[0] ?? [7]
  print(v[0])
}
elemLhs(null) // 7
elemLhs([3])  // 3

function mkList(n: i32): i32[] | null {
  if n == 0 { return null }
  return [n]
}

function callLhs(n: i32) {
  const v = mkList(n) ?? [7]
  print(v[0])
}
callLhs(0) // 7
callLhs(4) // 4

// A CALL in the MIDDLE of a chain is an LHS only after the re-association.
function midCall(n: i32, r: i32[] | null) {
  const v = r ?? mkList(n) ?? [7]
  print(v[0])
}
midCall(0, null) // 7
midCall(4, null) // 4
midCall(0, [9])  // 9

// SHORT-CIRCUIT: `br_on_non_null` reaches the default only on the null path, so the side effect
// prints exactly once across the two calls.
function loud(): i32[] {
  print("SIDE")
  [7]
}

function shortCircuit(p: i32[] | null) {
  const v = p ?? loud()
  print(v[0])
}
shortCircuit([3]) // 3 — no SIDE
shortCircuit(null) // SIDE, then 7
