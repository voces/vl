// @run
// @log 2
// @log 7
// @log 2
// @log 2
// @log 11
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// THE HINT IS DECLARED, NOT REMOVED: `const a: Circle[]` is the mutable half of the pair
// this fixture exists to contrast, so deleting the annotation deletes the subject.
// The read-only list view `readonly T[]` (owner ruling 2026-09-06): every READ a list
// serves, and the shallowness that makes it a view rather than a copy — writing an
// element's own field through the view is visible through the list, because the two are
// one value at one rep.
type Circle = { r: i32 }
function peek(xs: readonly Circle[]) { xs.length }
function f() {
  const a: Circle[] = [{ r: 7 }, { r: 9 }]
  const v: readonly Circle[] = a
  print(v.length)
  print(v[0].r)
  print(peek(a))
  v[0].r = 2
  print(a[0].r)
  let sum = 0
  for e in v { sum = sum + e.r }
  print(sum)
}
f()
