// @run
// @log 8
// @log 8
// @log 8
// @log 1
// @log 8
// @log 3
// @log 1.5
// @log 0.5
// @log null
// @log null
// @log i32
// A list literal delivered to a union of lists is typed as the arm whose elements it has exactly,
// before the first arm that merely accepts it: `[{ r: 7, s: 8 }]` into `Circle[] | Square[]` stays
// a `Square[]`, and `[1, 2]` into `f64[] | i32[]` an `i32[]`. A literal whose elements alone name
// no arm (`[null]`) boxes under the arm it was typed as. Record covariance and D3339 (A).
type Circle = { r: i32 }
type Square = { r: i32, s: i32 }
type Sq = { s: f64 }

function mc(b: boolean): Circle[] | Square[] {
  if b { return [{ r: 1 }] }
  return [{ r: 7, s: 8 }]
}
const c = mc(false)
if c is Square[] { print(c[0].s) } else { print(c[0].r) }
function ms(b: boolean): Square[] | Circle[] {
  if b { return [{ r: 1 }] }
  return [{ r: 7, s: 8 }]
}
const c2 = ms(false)
if c2 is Square[] { print(c2[0].s) } else { print(c2[0].r) }
function takeCS(x: Circle[] | Square[]) {
  if x is Square[] { print(x[0].s) } else { print(x[0].r) }
}
takeCS([{ r: 7, s: 8 }])
takeCS([{ r: 1 }])
const cb: Circle[] | Square[] = [{ r: 7, s: 8 }]
if cb is Square[] { print(cb[0].s) } else { print(cb[0].r) }

function takeQ(q: Sq[] | Circle[]) {
  if q is Circle[] { print(q[0].r) } else { print(q[0].s) }
}
takeQ([{ r: 3 }])
takeQ([{ s: 1.5 }])

const fi: f64[] | i32[] = [1, 2]
if fi is i32[] { print(fi[0] / 2.0) } else { print(-1) }

function mk(b: boolean): (f64 | null)[] | i32[] {
  if b { return [null] }
  [1]
}
const w = mk(true)
if w is (f64 | null)[] { print(w[0]) } else { print("i32") }
const wb: i32[] | (f64 | null)[] = [null]
if wb is (f64 | null)[] { print(wb[0]) } else { print("i32") }
const w2 = mk(false)
if w2 is (f64 | null)[] { print(w2[0]) } else { print("i32") }
