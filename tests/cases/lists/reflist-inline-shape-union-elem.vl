// @log OTHER
// Regression (destringify D2, `repElemKey`): a ref-list whose ELEMENT is a
// value-union boxing a litunion beside an INLINE shape — `(K0 | {w: i32})[]` —
// itself an arm of an outer union with `string`. The element slot is keyed on
// `repElemKey`; an INLINE shape's arena index is minted fresh per spelling, so a
// nominal-index key disagreed between the intern and the narrowing lookup and the
// `(K0 | {w: i32})[]` `is` narrowing fell through to the union-variant path
// ("`is` names a type that is not a union variant"). `repElemKey` expands an inline
// shape STRUCTURALLY (stable across occurrences) while keying a DECLARED struct
// nominally. Fuzz-found: seed 9 depth 5 plain, `(K0 | {w: i32})[] | string`.
type K0 = "644" | "hx" | "bdbvf"
const g: (K0 | {w: i32})[] | string = [{ w: 77 }]
function go() {
  const t0 = g
  if t0 is (K0 | {w: i32})[] {
    const t1 = t0[0]
    if t1 is K0 { print(t1) } else { print("OTHER") }
  } else {
    print("OTHER")
  }
}
go()
