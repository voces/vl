// @run
// @log true
// @log 1.5
// @log a
// @log 2
// @log a
// @log true
// A list of scalar lists delivered to a readonly list of a union holding that list is copied,
// each element boxed as the union's list member (D4152).
type B = { ys: readonly (string | string[])[] }
function count(y: readonly (string | string[])[]) { print(y.length) }
const xs: string[][] = [["a"], ["b", "c"]]
const y: readonly (string | string[])[] = xs
print(y[0] is string[])
const fs: f64[][] = [[1.5]]
const fy: readonly (string | f64[])[] = fs
const fe = fy[0]
if fe is f64[] { print(fe[0]) }
const b: B = { ys: xs }
const be = b.ys[0]
if be is string[] { print(be[0]) }
count(xs)
const sp: readonly (string | string[])[] = [...xs, "q"]
const se = sp[0]
if se is string[] { print(se[0]) }
print(sp[2] is string)
