// @run
// @log 20
// @log -1
// @log b
// @log -
// @log 2
// `.get(i)` over a receiver legacy stages once, a field and a call: the element in range, then
// past the end; the call runs once per read.
let calls = 0
type H = { xs: i32[] }
function mk() {
  calls = calls + 1
  const ss = ["a", "b"]
  return ss
}
function show(g: i32 | null) {
  if g == null {
    print(-1)
  } else {
    print(g)
  }
}
function go(i: i32) {
  const h: H = { xs: [10, 20] }
  show(h.xs.get(i))
}
function viaCall(i: i32) {
  print(mk().get(i) ?? "-")
}
go(1)
go(2)
viaCall(1)
viaCall(2)
print(calls)
