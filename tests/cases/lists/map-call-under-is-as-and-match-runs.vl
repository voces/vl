// @run
// @log true
// @log 6.5
// @log true
// A `.map`/`.filter` call read straight off its result under an `is` test, an `as` conversion or
// in a `match` arm reserves its scratch frame (D10351).
function f(k: i32, a: i32, b: string): i32 | string {
  if k == 0 { return a }
  b
}
print([1].map((i) => f(i - 1, 7, "s"))[0] is i32)
print(([3].map((i) => i * 2)[0] as f64) + 0.5)
const q = match 1 {
  1 => [1, 2].filter((i) => i > 1)[0] is i32
  _ => false
}
print(q)
