// @run
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.375
// @log 0.5
// @log 1.5
// @log 1.25
// @log 1.25
// @log 0.5
// @log 1.25
// @log 0.375
// @log 1.25
// @log 1.5
// A spread of a fresh nested list literal is built at its destination's element type (D4871), so
// the spread literal is built at that list too, not at its own. Positions: annotated `const`,
// argument, `return`, record field, assignment, list element and a third level.
type H = { l: f64[][] }
function last(xs: f64[][]) { return xs[xs.length - 1][1] / 4.0 }
function ret(n: i32): f64[][] { return [...[[n, 2]]] }
function run(n: i32) {
  const a: f64[][] = [...[[1, n]]]
  print(last(a))
  print(last([...[[1, n]]]))
  print(last(ret(n)))
  const h: H = { l: [...[[1, n]]] }
  print(last(h.l))
  let s: f64[][] = []
  s = [...[[3, n]], ...[[0.5, 1.5]]]
  print(last(s))
  const ls: f64[][][] = [[...[[1, n]]]]
  print(last(ls[0]))
  const d: f64[][][] = [...[[[n, 6]]]]
  print(last(d[0]))
}
run(2)
run(5)
