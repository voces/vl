// @run
// @log 2
// @log 1
// @log 2
// @log 2
// @log 2
// @log 4
// @hint redundant type annotation: `xs` is inferred as `i32[][]` — remove it to lean on inference
// @hint redundant type annotation: `ss` is inferred as `string[][]` — remove it to lean on inference
// @hint redundant type annotation: `fs` is inferred as `f64[][]` — remove it to lean on inference
// @hint redundant type annotation: `gs` is inferred as `{v: i32}[][]` — remove it to lean on inference
// @hint redundant type annotation: `nestedRef` is inferred as `i32` — remove it to lean on inference
// Every annotation below is kept AGAINST its own hint: each one pins the REP the
// fixture is about, and a hint saying the annotation is redundant is the checker
// agreeing about the TYPE — it says nothing about whether the two spellings agree
// about the rep.
// D1210: an UN-ANNOTATED binding of a `.pop()` over a NESTED list. The checker types
// `xs.pop()` as `i32[] | null` and every DELIVERY of that type already existed — the
// ANNOTATED spelling runs, and so does the same value from a declared function. What was
// missing is the INFERENCE: `exprNullableList`'s `Call` arm resolved an `Ident` callee and a
// closure value, and a MEMBER callee reached neither, so the cell fell to the i32-list
// default and the pop pushed a `(ref $listWrapper)` into it — check-clean invalid wasm.
//
// THE UN-ANNOTATED FACE IS THE WHOLE POINT, so nothing here annotates the binding: an
// annotation pins the rep and hides exactly this defect. The four distinct-backing leaves
// and the nested-ref leaf ride the same one classifier apiece, which is why each appears.

const xs: i32[][] = [[1], [2, 3]]
const v = xs.pop()
if v != null { print(v.length) } else { print(0) }
const v2 = xs.pop()
if v2 != null { print(v2.length) } else { print(0) }

const ss: string[][] = [["a"], ["b", "c"]]
const sv = ss.pop()
if sv != null { print(sv.length) } else { print(0) }

const fs: f64[][] = [[1.5], [2.5, 3.5]]
const fv = fs.pop()
if fv != null { print(fv.length) } else { print(0) }

const ls: i64[][] = [[1], [2, 3]]
const lv = ls.pop()
if lv != null { print(lv.length) } else { print(0) }

type S = { v: i32 }
function nestedRef(): i32 {
  const gs: S[][] = [[{v: 1}], [{v: 2}, {v: 3}, {v: 4}, {v: 5}]]
  const gv = gs.pop()
  if gv != null { return gv.length }
  0
}
print(nestedRef())
