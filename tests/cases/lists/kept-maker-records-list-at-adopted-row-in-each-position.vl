// @run
// @log null
// @log null
// @log 2
// @log null
// @log 1
// @log null
// A kept maker's records, built at the row `J` adopts them at (D16212, D16838), in lists built in
// each position: a list literal, a slice, a filter, a spread, a list of lists and a record field
// holding one; each read back by element.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const xs = [mk2(), mk2()]
const sl = xs.slice(0, 1)
print(sl[0].f)
const fl = xs.filter((y) => y.f == null)
print(fl[1].f)
const sp = [...xs]
print(sp.length)
const ll = [xs]
print(ll[0][0].f)
const w = { g: 1, h: ll[0] }
print(w.h[1].f ?? w.g)
print(dA.f)
