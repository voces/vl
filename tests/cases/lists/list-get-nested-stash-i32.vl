// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 1
// @log 1
// @log 1
// @log 2
// @log 7
// A `.get` that stages its receiver or index, with a staging `.get` nested in its index, its
// default and its receiver's argument, at depths 1 to 3, over i32 lists: each nested call takes
// its own stash, so each prints what its hoisted twin prints (D17381).
function L(xs: i32[]) { return xs }
function pick(k: i32) { return ls[k] }
const b = [5, 6, 7]
const c = [2, 1, 0]
const e = [1, 2]
const ls = [b, c, e]
const i = 1
// index position, depths 1 to 3
print(L(b).get(1) ?? -1)
print(L(b).get(L(c).get(1) ?? 0) ?? -1)
print(L(b).get(L(c).get(L(e).get(0) ?? 0) ?? 0) ?? -1)
// a name receiver, the index staged
print(b.get(L(c).get(1) ?? 0) ?? -1)
// a call receiver, a name index, the nested get in the default
print(L(b).get(9) ?? (L(c).get(i) ?? -2))
print(L(b).get(9) ?? (L(c).get(9) ?? (L(e).get(0) ?? -3)))
// receiver position, depths 2 and 3
print(L(pick(L(c).get(1) ?? 0)).get(1) ?? -1)
print(L(pick(L(c).get(L(e).get(0) ?? 0) ?? 0)).get(0) ?? -1)
// the plain value `.get`, its index a staged `.get`
const g = L(b).get(L(c).get(0) ?? 0)
print(g ?? -1)
