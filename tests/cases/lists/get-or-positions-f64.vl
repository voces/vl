// @run
// @log 2.5
// @log 9.5
// @log 9.5
// @log 2.5
// @log 9.5
// @log 9.5
// @log 2.5
// @log 9.5
// @log 9.5
// @log 2.5
// @log 9.5
// @log 9.5
// @log 2.5
// @log 9.5
// @log 9.5
// @log 2.5
// @log 9.5
// @log 9.5
// @log 2.5
// @log 9.5
// @log 9.5
// @log v=2.5
// @log v=9.5
// @log v=9.5
// @log 2.5
// @log 9.5
// @log 9.5
// @log 1.5
// @log 9.5
// @log 9.5
// @log 2.5
// @log 9.5
// @log 2.5
// @log 9.5
// @log 2.5
// @log 2.5
// @log 9.5
// @log 2.5
// @log 9.5
// @log 8.5
// @log 24
// `xs.get(i) ?? d` over a f64 list at nine positions, a literal, negative, field and global
// receiver or index, a `?? ys.get(j) ?? d` chain and a conditional default: the default runs
// only on a miss, counted by `calls`, and each prints what legacy's fused read prints.
let calls = 0
function d() {
  calls = calls + 1
  return 9.5
}
function show(r: f64) { print(r) }
function id(r: f64) { return r }
type H = { xs: f64[] }
const gs = [1.5, 2.5]
function get_let_init(xs: f64[], i: i32) {
  const r = xs.get(i) ?? d()
  print(r)
}
function get_element(xs: f64[], i: i32) {
  const ys = [xs.get(i) ?? d()]
  print(ys[0])
}
function get_arg(xs: f64[], i: i32) { show(xs.get(i) ?? d()) }
function get_ret(xs: f64[], i: i32) { return xs.get(i) ?? d() }
function get_field(xs: f64[], i: i32) {
  const o = { v: xs.get(i) ?? d() }
  print(o.v)
}
function get_if_arm(xs: f64[], i: i32) {
  const r = if xs.length > 0 { xs.get(i) ?? d() } else { 8.5 }
  print(r)
}
function get_nested_arg(xs: f64[], i: i32) { show(id(xs.get(i) ?? d())) }
function get_interp(xs: f64[], i: i32) { print("v=\{xs.get(i) ?? d()}") }
function get_assign(xs: f64[], i: i32) {
  let r = 8.5
  r = xs.get(i) ?? d()
  print(r)
}
get_let_init([1.5, 2.5], 1)
get_let_init([1.5, 2.5], 5)
get_let_init([1.5, 2.5], -1)
get_element([1.5, 2.5], 1)
get_element([1.5, 2.5], 5)
get_element([1.5, 2.5], -1)
get_arg([1.5, 2.5], 1)
get_arg([1.5, 2.5], 5)
get_arg([1.5, 2.5], -1)
print(get_ret([1.5, 2.5], 1))
print(get_ret([1.5, 2.5], 5))
print(get_ret([1.5, 2.5], -1))
get_field([1.5, 2.5], 1)
get_field([1.5, 2.5], 5)
get_field([1.5, 2.5], -1)
get_if_arm([1.5, 2.5], 1)
get_if_arm([1.5, 2.5], 5)
get_if_arm([1.5, 2.5], -1)
get_nested_arg([1.5, 2.5], 1)
get_nested_arg([1.5, 2.5], 5)
get_nested_arg([1.5, 2.5], -1)
get_interp([1.5, 2.5], 1)
get_interp([1.5, 2.5], 5)
get_interp([1.5, 2.5], -1)
get_assign([1.5, 2.5], 1)
get_assign([1.5, 2.5], 5)
get_assign([1.5, 2.5], -1)
function get_lit(xs: f64[]) { print(xs.get(0) ?? d()) }
function get_neg(xs: f64[]) { print(xs.get(-1) ?? d()) }
function get_field_recv(h: H, i: i32) { print(h.xs.get(i) ?? d()) }
function get_global_recv(i: i32) { print(gs.get(i) ?? d()) }
function get_chain(xs: f64[], ys: f64[], i: i32, j: i32) {
  print(xs.get(i) ?? ys.get(j) ?? d())
}
function get_cond(xs: f64[], i: i32, c: boolean) {
  print(xs.get(i) ?? (if c { d() } else { 8.5 }))
}
get_lit([1.5, 2.5])
get_lit([])
get_neg([1.5, 2.5])
get_field_recv({ xs: [1.5, 2.5] }, 1)
get_field_recv({ xs: [1.5, 2.5] }, 7)
get_global_recv(1)
get_global_recv(9)
get_chain([1.5, 2.5], [], 1, 0)
get_chain([], [1.5, 2.5], 0, 1)
get_chain([], [], 0, 1)
get_cond([1.5, 2.5], 1, true)
get_cond([1.5, 2.5], 4, true)
get_cond([1.5, 2.5], 4, false)
print(calls)
