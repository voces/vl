// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 1
// @log 1
// @log 1
// @log 2
// @log 7
// The hoisted twin of `list-get-nested-stash-i32.vl`: every call bound to a `const` first.
function L(xs: i32[]) { return xs }
function pick(k: i32) { return ls[k] }
const b = [5, 6, 7]
const c = [2, 1, 0]
const e = [1, 2]
const ls = [b, c, e]
const i = 1
const lb = L(b)
const lc = L(c)
const le = L(e)
print(lb.get(1) ?? -1)
const a1 = lc.get(1) ?? 0
print(lb.get(a1) ?? -1)
const a2 = le.get(0) ?? 0
const a3 = lc.get(a2) ?? 0
print(lb.get(a3) ?? -1)
print(b.get(a1) ?? -1)
print(lb.get(9) ?? (lc.get(i) ?? -2))
print(lb.get(9) ?? (lc.get(9) ?? (le.get(0) ?? -3)))
const r1 = pick(a1)
print(L(r1).get(1) ?? -1)
const r2 = pick(a3)
print(L(r2).get(0) ?? -1)
const a4 = lc.get(0) ?? 0
const g = lb.get(a4)
print(g ?? -1)
