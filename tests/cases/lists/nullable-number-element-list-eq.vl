// @run
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log true
// @warning `==` on `R` compares every element of its list field `xs`
// `==` over lists whose element is a nullable number (a union box in a list) compares pair by
// pair, tag first and then the value: two nulls are equal, a null and a number are not. Against a
// literal, in a generic, nested, and as a record field too; an `f32` element as well (D15056).
const a: (i32 | null)[] = [1, null]
const b: (i32 | null)[] = [1, null]
const c: (i32 | null)[] = [1, 2]
print(a == b)
print(a == c)
print(a != c)
print(a == [1, null])
function eqT<T>(x: T[], y: T[]) { x == y }
print(eqT(a, b))
print(eqT(a, c))
const f: (f64 | null)[] = [1.5, null]
const g: (f64 | null)[] = [1.5, null]
print(f == g)
const h: (i64 | null)[] = [7, null]
const h2: (i64 | null)[] = [7, 8]
print(h == h2)
const n: (i32 | null)[][] = [[1, null]]
print(n == n)
type R = { xs: (i32 | null)[] }
const r: R = { xs: [1, null] }
print(r == r)
const p: (f32 | null)[] = [1.5 as f32, null]
const p2: (f32 | null)[] = [1.5 as f32, null]
const p3: (f32 | null)[] = [1.5 as f32, 2.5 as f32]
print(p == p2)
print(p == p3)
print(p == [1.5 as f32, null])
