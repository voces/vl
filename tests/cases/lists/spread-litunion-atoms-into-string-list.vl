// @run
// @log z
// @log xyxz
// @log 0
// @log yw
// @log y
// @hint redundant type annotation: `go` is inferred as `string[]`
// D2868: a literal-union list spread into a `string[]` (or the `(string | null)[]` that shares its
// rep) re-encodes each atom as its member string, from a binding, a call result, an empty source
// and a returned literal alike.
type K = "x" | "y"
const ks: K[] = ["y", "x"]
const q0: string[] = [...ks, "z"]
print(q0[2])
function mk(): K[] { return ["x"] }
const q: string[] = [...mk(), ...ks, "z"]
print(q[0] + q[1] + q[2] + q[3])
const e: K[] = []
const q2: string[] = [...e]
print(q2.length)
function go(xs: K[]): string[] { return [...xs, "w"] }
const r = go(ks)
print(r[0] + r[2])
const n: (string | null)[] = [...ks]
const n0 = n[0]
if n0 != null { print(n0) }
