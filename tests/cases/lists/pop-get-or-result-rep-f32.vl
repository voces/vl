// `.pop() ?? d` and `.get(k) ?? d` over f32 lists, the result the element, kept nullable, a union with
// a string, or a `?? d ?? e` chain, at a binding, an argument and a return: a result stored as a
// box is not the fused element read (D17382), and each prints what its hoisted twin prints.
function pop_el_const(xs: f32[]) {
  const r = xs.pop() ?? 7.5
  print(r)
}
function show_pop_el_arg(r: f32) { print(r) }
function pop_el_arg(xs: f32[]) { show_pop_el_arg(xs.pop() ?? 7.5) }
function pop_el_ret(xs: f32[]) { return xs.pop() ?? 7.5 }
function pop_nul_const(xs: f32[], d: f32 | null) {
  const r = xs.pop() ?? d
  print(r ?? -1.0)
}
function show_pop_nul_arg(r: f32 | null) { print(r ?? -1.0) }
function pop_nul_arg(xs: f32[], d: f32 | null) {
  show_pop_nul_arg(xs.pop() ?? d)
}
function pop_nul_ret(xs: f32[], d: f32 | null) { return xs.pop() ?? d }
function pop_str_const(xs: f32[]) {
  const r = xs.pop() ?? "s"
  print(r)
}
