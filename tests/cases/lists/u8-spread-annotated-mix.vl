// @run
// @log 4
// @log 9
// @log 9
// @log 9
// @log 2
// A `u8[]` element comes from an ANNOTATION or from copying a `u8[]`, never from inference:
// a list literal infers `i32[]` for small integers, and an element read of a `u8[]` already
// widens to `i32`. So a spread mixed with a plain element has a destination only when one is
// written, and with it the packed element accepts an integer and range-checks a literal.
const bs: u8[] = [1, 2, 3]
// A literal element adopts the packed element through the annotation.
const a: u8[] = [...bs, 9]
print(a.length)
print(a[3])
// So does an i32-valued binding — adoption is not literal-only.
const x = 9
const b: u8[] = [...bs, x]
print(b[3])
// The spread may sit anywhere in the literal.
const c: u8[] = [9, ...bs]
print(c[0])
// The un-mixed copy needs no annotation at all: it is the source's own type.
const d = [...bs]
print(d[1])
