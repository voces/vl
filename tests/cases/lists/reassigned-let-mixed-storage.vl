// @run
// @log null
// @log null
// @log null
// @log null
// A `let` that holds an element of `src` and then one of `plain` holds both at its own record:
// the maker's call reaching it is kept there, and `dA`'s call is copied into `J` (D16803).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const plain = [{ f: null }]
function show(z: { f: null }) { print(z.f) }
function go() {
  let w = src[0]
  w = plain[0]
  print(w.f)
  show(w)
}
go()
for y in src {
  let v = y
  v = plain[0]
  show(v)
}
print(dA.f)
