// @run
// @log 9
// @log 207
// @log 110
// @log 15
// @log 6
// @log 5
// @log b
// @log 2
// @log 24
// @log 9
// A `.push` whose value stages a list receiver of its own (a `.pop` or `.push` on a list that is
// not a plain local) writes the value before its receiver, at every receiver position. Each line
// prints a value that shows where the element landed.

const src = [1, 2, 3, 4, 5, 6, 7, 8]
const xs: i32[] = []
xs.push(src.pop() ?? 0)
print(xs.length + xs[0])

const ys = [1]
const n = ys.push(src.pop() ?? 0)
print(n * 100 + ys[1])

const zs = [10]
zs.push(zs.pop() ?? 0)
print(zs.length * 100 + zs[0])

const inner: i32[] = []
const outer: i32[] = []
outer.push(inner.push(5))
print(outer[0] * 10 + inner[0])

type Box = { items: i32[] }
const bx: Box = { items: [] }
bx.items.push(src.pop() ?? 0)
print(bx.items[0])

const rows: i32[][] = [[], []]
rows[1].push(src.pop() ?? 0)
print(rows[1][0] + rows[0].length)

const words = ["a", "b"]
const outs: string[] = []
outs.push(words.pop() ?? "z")
print(outs[0])

const maybes: (string | null)[] = []
maybes.push(words.pop())
maybes.push(words.pop())
print(maybes.length)

function fill(k: i32) {
  xs.push(src.pop() ?? k)
  return xs.length
}
print(fill(0) * 10 + xs[1])

function local(a: i32[]) {
  const out: i32[] = []
  out.push(a.pop() ?? 0)
  return out[0]
}
print(local([4, 9]))
