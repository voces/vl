// @run
// @log 7
// @log 1
// @log 9
// @log 10
// @log 7
// @hint redundant type annotation: `c` is inferred as `i32[]` — remove it to lean on inference
// A spread in a list literal is the primitive the whole rule reduces to. `array.new_fixed`'s
// length is a compile-time constant, so a literal carrying one takes a runtime-length path:
// each item group is evaluated in source order, the destination is allocated once, and the
// annotation on `c` is declared rather than removed as the rep the literal lands on.
const a = [1, 2]
const b = [3, 4]
const c: i32[] = [0, ...a, 9, ...b, 10]
print(c.length)
print(c[1])
print(c[3])
print(c[6])
// The packed list is fresh — a later write through the source is not visible through it,
// which is what makes a spread a copy rather than an alias.
a.push(99)
print(c.length)
