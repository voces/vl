// @run
// @hint Intentionally-unused variable `_q` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_q` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// @log 0.5
// @log s
// @log 1
// @log 102
// @log 1
// @log 0.25
// @log 0.5
// @log 0.25
// @log 0.375
// A `return` inside a loop, a bare block, an `else if` chain or a `match` arm joins the return
// set as one at the top level does, and so does every return of a generic function at its pin
// (D2745).
type Circle = { r: i32 }
type Sq = { s: i32 }
function mc(n: i32): Circle { { r: n } }
function ms(n: i32): Sq { { s: n } }
function desc(e: Circle | Sq) {
  if e is Circle { e.r } else { 100 + e.s }
}
function inWhile(c: boolean) {
  let i = 0
  while i < 3 {
    if c && i == 1 { return [2] }
    i = i + 1
  }
  return [1.5, 2]
}
function inFor(xs: i32[]) {
  for x in xs {
    if x > 1 { return ["s"] }
  }
  return [1, "t"]
}
function inRange(c: boolean) {
  for k in 0 until 3 {
    if c && k == 2 { return [mc(1)] }
  }
  return [mc(3), ms(2)]
}
function inBlock(c: boolean) {
  {
    if c { return [[1]] }
  }
  return [[1.5]]
}
function inMatch(c: boolean) {
  const k = if c { 1 } else { "x" }
  match k {
    i32 => {
      return [2]
    }
    string => {
      let _q = 0
    }
  }
  return [1.5]
}
function atPin<T>(c: boolean, _t: T) {
  if !c { let _q = 0 }
  else if c { return [[1]] }
  return [[1.5]]
}
print(inWhile(true)[0] / 4.0)
print(inFor([1, 2])[0])
print(inFor([1])[0])
const rs = inRange(false)
print(desc(rs[rs.length - 1]))
print(desc(inRange(true)[0]))
print(inBlock(true)[0][0] / 4.0)
print(inMatch(true)[0] / 4.0)
print(atPin(true, 0)[0][0] / 4.0)
print(atPin(false, "s")[0][0] / 4.0)
