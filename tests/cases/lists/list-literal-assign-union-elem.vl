// @run
// @log 0
// @log 2
// @log 0
// The UNION-BOX element row of `list-literal-assign-cell.vl` (`pendingListKind == 2`), which
// that file cannot carry: a `(S | null)[]` and a `(S | K)[]` in ONE PROGRAM collide in the
// ref-list element interning — `emitProgram: a nullable-S list element has no rep` — on master
// exactly as here, so the split is a pre-existing composition limit, not a consequence of this
// fix. (Separate FUNCTIONS do not help; the ref-list table is program-global.)
//
// `xs = []` over a union-element list LOCAL or PARAM was invalid wasm with `vl check` clean,
// for the reason the sibling fixture states in full: `emitAssign`'s local arm never seeded the
// list context from the cell it stores into, so the literal built the default i32 list.

type S = { n: i32 }
type K = "a" | "b"

function locals() {
  let xs: (S | K)[] = ["a"]
  xs = []
  print(xs.length) // 0
  xs = [{ n: 1 }, "a"]
  print(xs.length) // 2
}
locals()

function clearUnionElem(xs: (S | K)[]) {
  xs = []
  print(xs.length) // 0
}
clearUnionElem(["a"])
