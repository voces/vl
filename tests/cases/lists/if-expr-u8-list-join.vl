// @run
// @hint redundant type annotation: `f` is inferred as `i32` — remove it to lean on inference
// @log 5
// @log 200
// @log 0
// @log 3
// @log true
// @log 9
// An if-expression over `u8[]` arms joins at the packed byte list's own wrapper, as an
// argument, a binding, a return and with a `null` arm (D2246, from consumer plumb PL-023).

const NONE: u8[] = []
const descs: {[string]: u8[]} = Map()
const d0: u8[] = [1, 2, 3]
descs["k"] = d0

function f(a: i32, b: string, c: u8[]): i32 { a + b.length + c.length }

const cond = true
print(f(1, "x", if cond { descs["k"] ?? NONE } else { NONE }))

const hi: u8[] = [200, 1]
const t = if cond { hi } else { NONE }
print(t[0])
const u = if !cond { hi } else { NONE }
print(u.length)

function pick(c: boolean): u8[] {
  if c { descs["k"] ?? NONE } else { NONE }
}
print(pick(true).length)

const n = if cond { hi } else { null }
print(n != null)
const nine: u8[] = [9]
const nn = if cond { nine } else { null }
if nn != null { print(nn[0]) }
