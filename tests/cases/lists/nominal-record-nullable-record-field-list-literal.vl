// @run
// @log 2 4 null
// @log 7
// D3762: a `new` record is a second arena index over its body, and no struct row recorded
// it, so an un-annotated list literal of one with a nullable-record field found no row and
// fell to the i32 list. The brand now denotes its base's row.
import { toString } from "std:fmt"

type B = { v: i32 }
type H = new { f: B | null }
function d(b: B | null) {
  if b != null { return b.v.toString() }
  "null"
}
function mk(k: i32): H { return { f: { v: k } } }
const p: H = { f: { v: 4 } }
const q: H = { f: null }
const xs = [p, q]
print(xs.length.toString() + " " + d(xs[0].f) + " " + d(xs[1].f))
function run() {
  const ys = [mk(7)]
  print(d(ys[0].f))
}
run()
