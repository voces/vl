// @log p
// A list `+` whose one side is a narrower list: an `i32` list widened beside an `f64` list, and a
// record list boxed into a union list, each side left and right. At an annotated `const`, a return,
// an argument and a record field.
type P = { x: i32 }
type Q = { y: string }
function sumF(xs: f64[]) {
  let t = 0.0
  for x in xs { t = t + x }
  return t
}
function show(us: (P | Q)[]) {
  for u in us { print(if u is P { "p" } else { u.y }) }
}
function catF(a: i32[], b: f64[]): f64[] { return a + b }
function catU(ps: P[], us: (P | Q)[]): (P | Q)[] { return us + ps }
function run(n: i32) {
  const ns = [1, n]
  const fs = [0.5, 1.5]
  const l: f64[] = ns + fs
  print(sumF(l))
  print(sumF(fs + ns))
  print(sumF(catF(ns, fs)))
  const r = { l: ns + fs }
  print(sumF(r.l))
  const ps: P[] = [{ x: n }]
  const us: (P | Q)[] = [{ y: "q" }]
  const both: (P | Q)[] = us + ps
  show(both)
  show(ps + us)
  show(catU(ps, us))
}
run(2)
run(5)
// @hint redundant type annotation: `l`
// @hint redundant type annotation: `both`
