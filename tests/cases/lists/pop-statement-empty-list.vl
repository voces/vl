// A `.pop()` statement on an empty list leaves it empty at every element rep (D8360).
// The numeric reps have no null cell, so their statement pop tests the length itself.
// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 2
// @log 1.5

type P = { x: i32 }
type K = "a" | "b"
type Holder = { xs: f64[] }

// The witness: a module-global list popped inside a function.
const a: i32[] = []
function f() {
  a.pop()
  0
}
f()
print(a.length)

// Every element rep, popped at top level.
const ef: f64[] = []
ef.pop()
print(ef.length)
const ei: i64[] = []
ei.pop()
print(ei.length)
const e32: f32[] = []
e32.pop()
print(e32.length)
const eu: u8[] = []
eu.pop()
print(eu.length)
const es: string[] = []
es.pop()
print(es.length)
const eb: boolean[] = []
eb.pop()
print(eb.length)
const ep: P[] = []
ep.pop()
print(ep.length)
const ek: K[] = []
ek.pop()
print(ek.length)

// A local list, a parameter, and a struct-field receiver.
function local() {
  const xs: f64[] = []
  xs.pop()
  xs.length
}
print(local())
function param(xs: i64[]) { xs.pop() }
const pi: i64[] = []
param(pi)
print(pi.length)
const h: Holder = { xs: [] }
h.xs.pop()
print(h.xs.length)

// A list emptied by pops and popped once more, and in a loop.
const g = [1]
g.pop()
g.pop()
print(g.length)
let n = 0
while n < 3 {
  g.pop()
  n = n + 1
}
print(g.length)

// The control: a non-empty statement pop still removes the last element.
const ne = [1.5, 2.5, 3.5]
ne.pop()
print(ne.length)
print(ne[0])
