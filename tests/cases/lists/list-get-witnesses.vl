// @run
// @log 10
// @log -1
// @log -1
// @log -1
// @log 1
// @log -1
// @log -1
// @log a
// @log -
// @log -
// @log -
// `xs.get(i)` at an index in range, at the length, at -1 and over an empty list, for an i32, a
// record and a string list: `null` in every miss.
type R = { x: i32 }
function showI(g: i32 | null) { print(g ?? -1) }
function showR(g: R | null) {
  if g == null { print(-1) } else { print(g.x) }
}
function showS(g: string | null) { print(g ?? "-") }
function go(n: i32, m: i32) {
  const xs = [10]
  const e: i32[] = []
  showI(xs.get(0))
  showI(xs.get(n))
  showI(xs.get(m))
  showI(e.get(0))
  const rs: R[] = [{ x: 1 }]
  showR(rs.get(0))
  showR(rs.get(n))
  showR(rs.get(m))
  const ss = ["a"]
  const es: string[] = []
  showS(ss.get(0))
  showS(ss.get(n))
  showS(ss.get(m))
  showS(es.get(0))
}
go(1, -1)
