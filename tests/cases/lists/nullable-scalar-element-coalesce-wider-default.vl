// @run
// @log 4
// @log 1.5
// @log 4
// @log 2.5
// @log 4
// @log 5000000000
// @hint redundant type annotation: `big` is inferred as `i64`
// D3795: `l[1] ?? 1.5` over an `(i32 | null)[]` unboxed the element at the RESULT's kind, so a
// wider default cast the i32 box to the f64 one and trapped. It unboxes at the element's own
// kind and widens to the result's.
import { toString } from "std:fmt"

const l: (i32 | null)[] = [null, 4]
print((l[1] ?? 1.5).toString())
print((l[0] ?? 1.5).toString())
print((l.get(1) ?? 2.5).toString())
print((l.get(5) ?? 2.5).toString())
const big: i64 = 5000000000
print((l[1] ?? big).toString())
print((l[0] ?? big).toString())
