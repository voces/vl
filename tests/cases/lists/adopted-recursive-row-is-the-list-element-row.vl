// @run
// @log 1
// @log 2
// @log 5
// @log 4
// @log 6
// @log 7
// @log 9
// @log 2
// @log 1

// A record literal bound un-annotated and listed in an un-annotated list literal, beside a
// declared record of the same field names, one of them nullable and nesting a record, is held
// as that record (D10040): with a `null` field, nesting a second literal, non-recursive, and
// as the list field of a second, anonymous record.

type Node = {v: i32, next: Node | null}
type Q = {w: i32}
type Box = {b: i32, inner: Q | null}

const x = { v: 1, next: null }
const xs = [x]
print(xs[0].v)

let y = { v: 2, next: null }
let ys = [y, x]
print(ys[0].v + ys.length - 2)

const deep = { v: 3, next: { v: 2, next: null } }
const ds = [deep]
const dn = ds[0].next
print(ds[0].v + dn.v)

const bx = { b: 4, inner: null }
const bs = [bx]
print(bs[0].b)

function mk() {
  const z = { v: 6, next: null }
  return [z]
}
print(mk()[0].v)

const h = { v: 7, next: null }
const hs = { items: [h] }
print(hs.items[0].v)

const ws = { items: xs }
ws.items.push(h)
print(ws.items.length + ws.items[1].v)

y = { v: 5, next: null }
ys.push(y)
print(ys.length - 1)
ys = [x]
print(ys[0].v)
