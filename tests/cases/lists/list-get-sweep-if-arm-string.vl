// @run
// @log b
// @log -
// `xs.get(i)` over a string list, its `T | null` delivered at if-arm: an index in range, then
// one past the end (Q58 position sweep).
function show(g: string | null) { print(g ?? "-") }
function go(i: i32) {
  const xs = ["a", "b"]
  const g = if i > 0 { xs.get(i) } else { xs.get(0) }
  show(g)
}
go(1)
go(2)
