// @run
// @log null
// @log null
// @log null
// @log null
// @log 1
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A loop variable or a list callback's parameter holds an element `src`'s build stores at `J`, so
// handing it to an annotated `{ f: null }` instances `show` at `J`, as an index read does (D16783).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
function show(z: { f: null }) { print(z.f) }
for y in src { show(y) }
for y, i in src { show(y) }
for y in src.filter((q) => q.f == null) { show(y) }
const r = src.filter((y) => {
  show(y)
  return true
})
print(r.length)
