// @run
// @log 7
// @log 2
// @log 3
// @log 4
// @log 1
// A list literal whose record element holds records of hole functions is laid out at its ref-list
// slot's struct row, not the checker's element type. The list local, an element read, a local
// bound to an element and a loop variable read that row, inside a function and at top level.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function inFn() {
  const ys = [{ r: { f: inc0 }, s: { f: dbl } }]
  print(ys[0].r.f(1))
  const e = ys[0]
  print(e.r.f(2))
  for y in ys { print(y.r.f(3)) }
  print(ys.length)
}
const xs = [{ r: { f: inc0 }, s: { f: dbl } }]
print(xs[0].r.f(6))
inFn()
