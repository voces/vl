// @run
// @log 6
// @log 4.5
// @log 30
// @log 1.5
// @log bc
// @log 7
// @log 255
// @log true
// @log 9
// @log 36
// @log 4
// @log 12
// @log 11
// @log 18
// A list index in range reads and writes the element, at every list rep, through a loop's
// hoisted header and through a receiver read in place. The index guard tests `i u< len` and
// takes a branch only to trap (`index-guard-trap-*` are the other half).
type P = { x: i32 }
function sumRun(xs: i32[], o: i32, w: i32) {
  let s = 0
  for c in 0 until w { s += xs[o + c] }
  s
}
const ints = [1, 2, 3, 4, 5]
print(sumRun(ints, 0, 3))
const fs = [1.5, 3.0]
print(fs[0] + fs[1])
const ls: i64[] = [10, 20]
print(ls[0] + ls[1])
const gs: f32[] = [0.5, 1.0]
print(gs[0] + gs[1])
const ss = ["a", "b", "c"]
print(ss[1] + ss[2])
const ps: P[] = [{ x: 3 }, { x: 7 }]
print(ps[1].x)
const bs: u8[] = [1, 255]
print(bs[1])
const flags = [false, true]
print(flags[1])

// Writes in a loop, through two names for one list: neither changes its length.
const a = [0, 0, 0]
const b = a
for c in 0 until 3 { a[c] = c + 2 }
print(b[0] + b[1] + b[2])

// Nested loops over a row-major grid, with the row's base added to the column.
const grid = [1, 2, 3, 4, 5, 6]
let t = 0
for r in 0 until 2 {
  for c in 0 until 3 { t += grid[r * 3 + c] * (r + 1) }
}
print(t)

// A list grown in the loop that reads it: the length moves, so every read is tested again.
const grow = [1]
for c in 0 until 3 {
  grow.push(grow[c] + 1)
  if c == 2 { print(grow[3]) }
}

// A field-path receiver, and the slack past `len` that a push leaves is never read.
type Rec = { vals: i32[] }
const rec: Rec = { vals: [4, 8] }
let u = 0
for c in 0 until rec.vals.length { u += rec.vals[c] }
print(u)
const sl = [5]
sl.push(6)
print(sl[0] + sl[1])
let v = 0
for c in 0 until 3 { v += [5, 6, 7][c] }
print(v)
