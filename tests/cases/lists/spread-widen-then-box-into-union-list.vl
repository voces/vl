// @run
// @log 1.5
// @log 8
// @log 3
// @log 1
// @log 4
// @log 2.5
// @hint redundant type annotation: `a` is inferred as `i32[]`
// @hint redundant type annotation: `mk` is inferred as `i32[]`
// D2882: a spread whose source element is not a member of the destination's union but widens
// losslessly to one (`i32` to `f64` or `i64`, `f32` to `f64`) converts each element, then boxes it.
const a: i32[] = [3, 4]
const p: (f64 | null)[] = [...a]
const p0 = p[0]
if p0 != null { print(p0 / 2.0) }
const q: (i64 | string)[] = [...a, "s"]
const e = q[1]
if e is i64 { print(e * 2) }
const f: f32[] = [1.5]
const r: (f64 | null)[] = [...f, null]
const g = r[0]
if g != null { print(g * 2.0) }
const none: i32[] = []
const w: (f64 | null)[] = [...none, null, ...none]
print(w.length)
const x: (i64 | null)[] = [...a]
const h = x[0]
if h != null { print(h + 1) }
function mk(): i32[] { return [5] }
const y: (f64 | null)[] = [...mk(), ...a]
const k = y[0]
if k != null { print(k / 2.0) }
