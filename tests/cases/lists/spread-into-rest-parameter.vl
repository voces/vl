// @run
// @log 3
// @log 5
// @log 2
// @log 9
// @log 4
// A call-site spread unpacks a list into a rest parameter, and mixing is allowed wherever
// it is unambiguous — which, because a rest is last, is everywhere. `f(1, 2, ...ys, 3)`
// packs everything after `a` into `xs`.
function f(a: i32, ...xs: i32[]) { return a + xs.length }
const ys = [5, 6]
print(f(1, ...ys))
print(f(1, 2, ...ys, 3))

// A `readonly` view spreads: spreading READS the source, and the packed list is a fresh
// mutable one, so nothing the view forbids is laundered through it.
function take(xs: readonly i32[]) { return [...xs, 9] }
const a = [1, 2]
const b = take(a)
print(b.length - 1)
print(b[2])

// UFCS reaches a rest parameter too: the receiver is spliced to the first slot and the
// trailing arguments pack exactly as a direct call's do.
function tally(self: i32[], ...more: i32[]) { return self.length + more.length }
print(a.tally(7, 8))
