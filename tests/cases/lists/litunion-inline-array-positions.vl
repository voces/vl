// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// A BARE INLINE literal-union array (`("a" | "b")[]`) in every binding position, each one
// PAIRED with its `K[]` alias control on the adjacent line.
//
// WHAT THIS ADDS over `literal-unions/inline-atom-array.vl` (#1198's fixture, which covers the
// global / local / field / param / return positions): the REASSIGN position, and a paired alias
// control at every position, so a future edit that heals the inline spelling by breaking the
// alias one cannot pass. The sibling `litunion-inline-array-ops.vl` adds the operation axis.
//
// WHY IT IS A FIXTURE AND NOT A CURIOSITY. `canonEmitName` SOFTENS a bare inline literal
// union to its base scalar, so this annotation RENDERS `string[]` while the checker's arena
// still holds the litunion members. Every NAME-driven classifier therefore coded the binding a
// string-ref list while every ARENA-driven path built interned i32 atom ids, and the two met at
// the cell: `(ref $strListWrapper)` declared, `(ref $i32ListWrapper)` stored. In a GLOBAL that
// is a type mismatch inside a constant expression, which wasmtime reports at module-PARSE time
// — `failed to parse WebAssembly module`, with `vl check` clean (#1198).
//
// The trigger INVERTS by binding position, which is the tell for a two-sided classifier
// disagreement rather than one bug: a NON-EMPTY initializer follows the element arena and broke
// global / local / field / reassign, while an EMPTY `[]` follows the annotation seed and broke
// param / return. Both polarities are pinned here, one column each, so a future edit that heals
// one seam and flips the other (measured: fixing the rep layer alone does exactly that) reddens
// this file instead of trading one cell for another.
//
// Verified RED on a compiler built without #1198's three arena-first checks: 6 of these 10
// bindings emit an unparseable module there.

type K = "a" | "b"

// ── non-empty initializers ───────────────────────────────────────────────────
const gInline: ("a" | "b")[] = ["a", "b"]
const gAlias: K[] = ["a", "b"]

type SInline = { xs: ("a" | "b")[] }
type SAlias = { xs: K[] }

function localsNonEmpty() {
  const xs: ("a" | "b")[] = ["a", "b"]
  print(xs.length) // 2
}

function fieldNonEmpty() {
  const s: SInline = { xs: ["a", "b"] }
  const t: SAlias = { xs: ["a", "b"] }
  print(s.xs.length + t.xs.length - 2) // 2
}

function reassignNonEmpty() {
  let xs: ("a" | "b")[] = []
  xs = ["a", "b"]
  print(xs.length) // 2
}

// ── empty initializers — the OTHER polarity ──────────────────────────────────
function takesInline(xs: ("a" | "b")[]) { print(xs.length) }
function takesAlias(xs: K[]) { print(xs.length) }

function retInline(): ("a" | "b")[] { return [] }
function retAlias(): K[] { return [] }

print(gInline.length) // 2
print(gAlias.length) // 2
localsNonEmpty() // 2
fieldNonEmpty() // 2
reassignNonEmpty() // 2

takesInline([]) // 0
takesAlias([]) // 0
print(retInline().length) // 0
print(retAlias().length) // 0

const gEmptyInline: ("a" | "b")[] = []
print(gEmptyInline.length) // 0
