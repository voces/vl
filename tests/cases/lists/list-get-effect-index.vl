// @run
// @log 20
// @log 1
// @log -
// @log 2
// An effectful index is evaluated once: `xs.get(next())` reads the counter once per call, in range
// and then past the end, under `?? d` and as a value of its own.
let n = 0
function next() {
  n = n + 1
  return n
}
function fused() {
  const xs = [10, 20]
  print(xs.get(next()) ?? -1)
  print(n)
}
function plain() {
  const ss = ["a", "b"]
  const g = ss.get(next())
  print(g ?? "-")
  print(n)
}
fused()
plain()
