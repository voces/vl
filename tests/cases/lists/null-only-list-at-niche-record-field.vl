// @run
// @log 1
// @log true
// @log 1
// @log true
// @log 2
// A null-only list literal at a record field of a niche element type stores each `null` as the
// element's own sentinel, the null of the list it is built at (D16311).
type R = { f: (boolean | null)[] }
const v: R = { f: [null] }
print(v.f.length)
print(v.f[0] == null)
function mk(): { g: ("a" | "b" | null)[] } { return { g: [null] } }
const m = mk()
print(m.g.length)
print(m.g[0] == null)
v.f.push(true)
print(v.f.length)
