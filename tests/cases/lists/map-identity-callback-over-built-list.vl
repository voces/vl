// @run
// @log null
// @log null
// @log 1
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A `map` whose callback hands each element back, over a list a kept maker's build stores at `J`,
// keeps the elements where they are stored: the callback's result and the `map` result are at `J`
// (D16211), as a `filter` result is.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const ns = src.map((y) => y)
print(ns[0].f)
function same(y) { return y }
print(src.map(same)[0].f)
print(src.map((y) => y).filter((y) => y.f == null).length)
