// @run
// @log 2
// @log 0
// @log 2
// @log a
// @log 2
// @log a
// @log 2
// @log s
// @log 2
// @log 0
// @log 2
// @hint redundant type annotation: `ys` is inferred as `(string | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(boolean | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `ks` is inferred as `K[]` — remove it to lean on inference
// @hint redundant type annotation: `nks` is inferred as `(K | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `ss` is inferred as `(string | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `direct` is inferred as `(boolean | null)[]` — remove it to lean on inference
// THE `@hint`s ARE NOW ORDINARY. Before the fix the linter's advice to delete the outer
// annotation was, accidentally, a WORKAROUND: taking it made the program compile, so writing
// the type you meant is what cost you a valid module. That disagreement is gone — the
// annotated and un-annotated spellings now lower the same way — and the annotations stay
// because they are what name the four element spellings this file is about.
// A LIST RETURNED AS A LOCAL, for the four element spellings that ride a scalar list's
// backing without being a primitive.
//
// All four used to check clean (`vl check` rc 0) and emit a module that does not
// instantiate — the failure is inside `mk*`, not at the binding: `expected i32, found
// (ref $type)`. Graduated from `soundness/xfail-miscompile-nullable-elem-list-call-init.vl`,
// which absorbed `nullable-elem-list-call-init-controls.vl` on the way. The filed fixture
// carried only `(boolean | null)[]`; the other three were found while placing it and fail
// identically, which is what makes this one defect rather than four.
//
// THE INFERRED RETURN KIND WAS THE HOLE. `computeRetInference` classifies an un-annotated
// return from the return EXPRESSION, and a returned LOCAL's collected kind does not exist
// during that pass — `buildLocals` runs per function, much later. The `expr*` families
// rescue the common cases through their typed-IR fast path, which maps only `TyPrim`
// elements, so `K[]`, `(K | null)[]`, `(boolean | null)[]` and `(string | null)[]` fell to
// the `"i32"` default and the functype declared an i32 result over a body returning the
// wrapper. The rung added beside `retIsMapLocal` — which exists for exactly this reason,
// one column over — asks the recorded type instead.
//
// THE WIDENING IS SCOPED TO THE RESULT VALTYPE, deliberately. Teaching the shared
// arena→kind map (`tyKindOf`) about these four elements instead makes `exprArray` claim a
// `K[]` at EVERY position, and `generics/error-litunion-list-arg-not-pinned.vl` — the file
// that pins a `K[]` generic argument failing CLOSED — starts printing the raw atom id where
// its oracle says `a`. A loud reject traded for a wrong value is worse than the bug. The
// result valtype is the one question whose answer is the same for all four spellings.
//
// THE LAST TWO ARMS ARE THE CONTROLS that always worked: the same annotation with a direct
// array-LITERAL init, and the same call init with a NON-nullable element type. Neither half
// is broken alone; the pair was.
type K = "a" | "b"

function mkBool() {
  const ys = [true, null]
  return ys
}

function mkLit() {
  const ys: K[] = ["a", "b"]
  return ys
}

function mkNulLit() {
  const ys: (K | null)[] = ["a", null]
  return ys
}

function mkNulStr() {
  const ys: (string | null)[] = ["s", null]
  return ys
}

function mkPlain() {
  return [true, false]
}

const xs: (boolean | null)[] = mkBool()
print(xs.length)
if xs[1] == null { print(0) } else { print(1) }

const ks: K[] = mkLit()
print(ks.length)
print(ks[0])

const nks: (K | null)[] = mkNulLit()
print(nks.length)
const nk0 = nks[0]
if nk0 != null { print(nk0) } else { print("nil") }

const ss: (string | null)[] = mkNulStr()
print(ss.length)
const s0 = ss[0]
if s0 != null { print(s0) } else { print("nil") }

const direct: (boolean | null)[] = [true, null]
print(direct.length)
if direct[1] == null { print(0) } else { print(1) }

const viaCall = mkPlain()
print(viaCall.length)
