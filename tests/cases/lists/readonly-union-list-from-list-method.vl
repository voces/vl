// @run
// @log 5
// @log 1
// @log 1
// @log 5
// @log 5
// @log 1
// A `.filter`, `.slice` or `.map` result delivered straight into a `readonly Shape[]` is copied
// into the union's row, as the same result bound to a name first is (D2214).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Bag = { xs: readonly Shape[] }
function first(w: readonly Shape[]) {
  const s = w[0]
  if s is Circle { print(s.r) }
}
const a: Circle[] = [{ r: 1 }, { r: 5 }]
const w: readonly Shape[] = a.filter((c) => c.r > 2)
first(w)
first(a.slice(0))
first(a.map((c): Circle => c))
const bag: Bag = { xs: a.filter((c) => c.r > 2) }
first(bag.xs)
let u: readonly Shape[] = []
u = a.slice(1)
first(u)
first([{ r: 1 }].filter((c) => c.r > 0))
