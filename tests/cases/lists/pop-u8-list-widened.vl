// @run
// @log 1
// @log 255
// @log 200
// @log null
// @log 9
// @log 2
// @hint redundant type annotation: `zv` is inferred as `i32 | null` — remove it to lean on inference
// Every annotation below is kept AGAINST its own hint: each one pins the REP the
// fixture is about, and a hint saying the annotation is redundant is the checker
// agreeing about the TYPE — it says nothing about whether the two spellings agree
// about the rep.
// D1211: `u8[].pop()` is `i32 | null`, not `u8 | null`. `u8` is a STORAGE type — a union
// MEMBER is a value position and `const v: u8 | null = …` is a check reject saying so — so
// the checker was producing a type it also refuses to let anyone write, and the two
// spellings of one read disagreed. `arrElemValueTy` is the one home of the widened-read
// rule the index arm already applied, and `.pop()` / `.get(i)` are that read one nullable
// out. The BOX follows for free: `emitPopNulBox` keys on the checker's recorded type.
//
// EVERY CELL PRINTS A BYTE VALUE ABOVE 127, because the packed backing is read with
// `array.get_u`: a sign-extending read would print -1 for 255.

const xs: u8[] = [200, 255]
const v = xs.pop()
if v != null { print(1) } else { print(0) }

const ys: u8[] = [200, 255]
print(ys.pop())
print(ys.pop())
print(ys.pop())

const zs: u8[] = [9]
const zv: i32 | null = zs.pop()
if zv != null { print(zv) } else { print(0) }

const ws: u8[] = [1, 2]
print(ws.pop() ?? 7)
