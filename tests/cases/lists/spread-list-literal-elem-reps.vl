// @run
// @log 1.5
// @log 3.5
// @log c
// @log 3
// @log 3
// @log 7
// @log 0
// @hint redundant type annotation: `p2` is inferred as `{x: i32}[]` — remove it to lean on inference
// Each element rep takes the same spread path: the wrapper and backing come from the
// source's own kind, so nothing here is the i32 list wearing another name. The struct copy
// is shallow — the elements are shared, as the `readonly` view is — and a spread of an
// empty list contributes nothing, so the literal stays an unpinned `T[]`.
const f = [...[1.5], 2.5, 3.5]
print(f[0])
print(f[2])
const s = ["a", "b"]
const t = [...s, "c"]
print(t[2])
const q: i64[] = [1, 2]
const r = [...q, 3]
print(r.length)
type Pt = { x: i32 }
const p = [{ x: 1 }, { x: 2 }]
const p2: Pt[] = [...p, { x: 3 }]
print(p2.length)
p2[0].x = 7
print(p[0].x)
const e: i32[] = []
const e2 = [...e]
print(e2.length)
