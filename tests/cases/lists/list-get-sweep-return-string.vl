// @run
// @log b
// @log -
// `xs.get(i)` over a string list, its `T | null` delivered at return: an index in range, then
// one past the end (Q58 position sweep).
function show(g: string | null) { print(g ?? "-") }
function at(xs: string[], i: i32) { return xs.get(i) }
function go(i: i32) {
  const xs = ["a", "b"]
  show(at(xs, i))
}
go(1)
go(2)
