// @trap
// Every list rep traps on its own bound: a struct list after the bytes and floats print.
type P = { x: i32 }
const bs: u8[] = [1, 2]
print(bs[1])
const ls: i64[] = [3]
print(ls[0])
const gs: f32[] = [0.5]
print(gs[0])
const ps: P[] = [{ x: 9 }]
print(ps[0].x)
const k = ps.length
print(ps[k].x)
print("unreached")
