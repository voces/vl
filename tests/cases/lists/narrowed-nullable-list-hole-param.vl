// @log 1.5
// @log s
// @log 200
// An un-annotated parameter pinned to an `i64[] | null`, `f32[] | null` or `u8[] | null`
// argument reads its element at the element's own rep once narrowed, in every use: print,
// arithmetic, interpolation, a binding, a call argument, a return and `.length` — and
// `lenOf` and `firstOf`, each pinned several ways, read each instance's own wrapper (D2238).

function sinkI64(v: i64) { print(v) }
function sinkF32(v: f32) { print(v) }
function sinkI32(v: i32) { print(v) }

function useI64(a) {
  if a != null {
    print(a[0])
    print(a[0] + a[0])
    print("v=\{a[0]}")
    const x = a[0]
    print(x)
    sinkI64(a[0])
  }
}
function retI64(a) {
  if a != null { return a[0] }
  return (0 as i64)
}
function lenOf(a) {
  if a != null { return a.length }
  0
}
const qi: i64[] | null = [(5000000000 as i64)]
useI64(qi)
print(retI64(qi))
print(lenOf(qi))

function useF32(a) {
  if a != null {
    print(a[0])
    print(a[0] + a[0])
    print("v=\{a[0]}")
    const x = a[0]
    print(x)
    sinkF32(a[0])
  }
}
function retF32(a) {
  if a != null { return a[0] }
  return (0.0 as f32)
}
const qf: f32[] | null = [(1.5 as f32)]
useF32(qf)
print(retF32(qf))
print(lenOf(qf))

function useU8(a) {
  if a != null {
    print(a[0])
    print(a[0] + a[0])
    print("v=\{a[0]}")
    const x = a[0]
    print(x)
    sinkI32(a[0])
  }
}
function retU8(a) {
  if a != null { return a[0] }
  0
}
const qu: u8[] | null = [200]
useU8(qu)
print(retU8(qu))
print(lenOf(qu))

function firstOf(a) {
  if a != null { print(a[0]) }
}
firstOf(qi)
firstOf(qf)
const qs: string[] | null = ["s"]
firstOf(qs)
firstOf(qu)
