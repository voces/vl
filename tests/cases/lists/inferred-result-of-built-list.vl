// @run
// @log null
// @log 2
// @log null
// @log null
// @log null
// @log null
// @log null
// A list whose elements a kept maker's build stores at `J`, handed on through an inferred result,
// a map value or a record literal: each is a delivery at the list's own type, so the maker's call
// reaching the list stays there and `dA`'s call is copied into `J` (D16772, D16793).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const srcs = [src]
function all() { return src }
const a = all()
a.push({ f: null })
print(a[1].f)
print(src.length)
const tail = () => src.filter((y) => y.f == null)
print(tail()[0].f)
function deliver() { return srcs[0] }
print(deliver()[0].f)
const m = Map()
m["k"] = src
const got = m["k"]
if got != null { print(got[0].f) }
function show(r) { print(r.g[0].f) }
show({ g: src.slice(0, 1) })
print(dA.f)
