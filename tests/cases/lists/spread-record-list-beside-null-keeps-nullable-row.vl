// @run
// @log 6
// @log 2
// @log true
// @log 2
// @log 2
// A record-list spread beside a `null`, or beside a nullable source, is typed `(C | null)[]` and
// builds at that row, not its source's: un-annotated binding, head `null`, a nullable source and
// an inferred return.
type C = { r: i32 }
const cs: C[] = [{ r: 6 }]
const v = [...cs, null]
const e = v[0]
if e != null { print(e.r) }
print(v.length)
const ncs: (C | null)[] = [null]
const w = [null, ...cs]
print(w[0] == null)
const x = [...cs, ...ncs]
print(x.length)
function mk() { return [...cs, null] }
print(mk().length)
