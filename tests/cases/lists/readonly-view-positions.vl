// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 3
// @log 9
// @hint redundant type annotation: `nest` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `{xs: readonly Circle[]}` — remove it to lean on inference
// BOTH HINTS ARE DECLARED, NOT REMOVED: the return annotation and the struct-field
// destination are two of the positions the spelling has to reach.
// The spelling at every position a type is written: alias, parameter, function-type
// parameter, return, struct field, map value, nullable union member, nested list, and a
// generic parameter pinned twice. A view is the list's rep, so none of these positions
// needs a new lowering — what is being pinned is that the SPELLING resolves in each.
type Circle = { r: i32 }
type RO = readonly Circle[]
type Box = { xs: readonly Circle[] }
function peek(xs: RO, f: (readonly Circle[]) => void): readonly Circle[] {
  f(xs)
  xs
}
function nest(g: readonly Circle[][], h: (readonly Circle[])[]): i32 {
  g.length + h.length
}
function first<T>(xs: readonly T[]): T { xs[0] }
const m: {[string]: readonly Circle[]} = Map()
const n: readonly Circle[] | null = null
function f() {
  const a: RO = [{ r: 1 }]
  const b: Box = { xs: a }
  print(
    peek(b.xs, (ys: readonly Circle[]): void => {
      print(ys.length)
    }).length,
  )
  m["k"] = a
  const got = m["k"]
  if got != null { print(got.length) }
  if n != null { print(n.length) } else { print(1) }
  print(nest([[{ r: 2 }]], [a]) - 1)
  print(first([3, 4]))
  print(first([{ r: 9 }]).r)
}
f()
