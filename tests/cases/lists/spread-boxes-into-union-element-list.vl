// @run
// @log 2
// @log 5
// @log nul
// @log q
// @log 8
// @log true
// @log 6
// @log k
// @log 3
// @hint redundant type annotation: `a` is inferred as `i32[]`
// @hint redundant type annotation: `b` is inferred as `string[]`
// @hint redundant type annotation: `bs` is inferred as `boolean[]`
// @hint redundant type annotation: `fs` is inferred as `f64[]`
// D2869: a spread into a list whose element is a union boxes each source element, when the
// destination names the union: a scalar source under its value atom's tag, a record source
// under its arm's. Binding, argument, return and field deliveries all thread the destination.
const a: i32[] = [3, 4]
const q: (i32 | null)[] = [...a]
print(q.length)
const qs: (i32 | null)[] = [...a, null]
const e = qs[1]
if e != null { print(e + 1) }
const n = qs[2]
if n == null { print("nul") }
const b: string[] = ["p", "q"]
function pick(xs: (string | i32)[]) {
  const s = xs[1]
  if s is string { print(s) }
  const t = xs[2]
  if t is i32 { print(t + 1) }
}
pick([...b, 7])
function flags(): (boolean | i32)[] {
  const bs: boolean[] = [true]
  [...bs, 2]
}
const f = flags()[0]
if f is boolean { print(f) }
type C = { r: i32 }
type D = { s: string }
type S = C | D
const cs: C[] = [{ r: 6 }]
type Box = { u: S[] }
const bx: Box = { u: [...cs, { s: "k" }] }
const c0 = bx.u[0]
if c0 is C { print(c0.r) }
const c1 = bx.u[1]
if c1 is D { print(c1.s) }
const fs: f64[] = [1.5]
const fq: (f64 | null)[] = [null, ...fs]
const g = fq[1]
if g != null { print(g * 2.0) }
