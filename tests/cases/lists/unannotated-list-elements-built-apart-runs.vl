// @run
// @warning Unused variable `wideK`
// @log 2
// @log 4
// Two makers' calls in one un-annotated list literal, one also delivered at `J` and one at a field
// union `i32 | string`, are each copied where they land, and the list holds their own rows (D14515,
// D15714).
type J = { f: i32 | null }
type K = { f: i32 | string }
function mk() { { f: 4 } }
function mk2() { { f: 6 } }
const wideJ: J = mk()
const wideK: K = mk2()
const xs = [mk(), mk2()]
print(xs.length)
print(wideJ.f ?? 0)
