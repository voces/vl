// @run
// @log 7
// @log 2
// @log 2
// The CONTROL for the write-demand refusal beside this file: a view reaching the same
// un-annotated type parameter through READ-ONLY uses is accepted, and so is a mutable list
// at the writing spelling. Without both halves the refusal could be "a hole never takes a
// view", which would be a false reject rather than the rule.
function first<T>(xs: T) { xs[0] }
function count<T>(xs: T) { xs.length }
function grow<T>(xs: T) { xs.push(9) }
function f() {
  const v: readonly i32[] = [7, 2]
  print(first(v))
  print(count(v))
  const m = [1]
  grow(m)
  print(m.length)
}
f()
