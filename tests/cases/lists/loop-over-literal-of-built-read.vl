// @run
// @log null
// @log null
// @log null
// @log null
// @log null
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A list literal holding reads of `src`'s elements, stored at `J`, holds them there, beside a
// fresh record literal built there too, so a loop over it hands `show` a `J` record (D16788).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
function show(z: { f: null }) { print(z.f) }
for w in [src[0]] { show(w) }
for y in src {
  for w in [y] { show(w) }
}
for w in [src[0], { f: null }] { show(w) }
const ws = [src[0]]
for w in ws { show(w) }
