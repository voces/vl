// @run
// @log s
// @log 1
// @log s
// @log 0.375
// @log 102
// @log s
// A function whose only return is a call of one whose returns join two list literals returns
// the joined list too, as a tail value, a `return`, or through a second relay (D2746).
type Circle = { r: i32 }
type Sq = { s: i32 }
function mc(n: i32): Circle { { r: n } }
function ms(n: i32): Sq { { s: n } }
function desc(e: Circle | Sq) {
  if e is Circle { e.r } else { 100 + e.s }
}
function mix(c: boolean) {
  if c { ["s"] } else { [1, "t"] }
}
function relay(c: boolean) { mix(c) }
function relayRet(c: boolean) { return mix(c) }
function relay2(c: boolean) { relay(c) }
function nest(c: boolean) {
  if c { [[1]] } else { [[1.5]] }
}
function nestRelay(c: boolean) { nest(c) }
function recs(c: boolean) {
  if c { [mc(1)] } else { [mc(3), ms(2)] }
}
function recsRelay(c: boolean) { recs(c) }
function loopMix(c: boolean) {
  let i = 0
  while i < 3 {
    if c && i == 1 { return ["s"] }
    i = i + 1
  }
  return [1, "t"]
}
function loopRelay(c: boolean) { loopMix(c) }
print(relay(true)[0])
print(relayRet(false)[0])
print(relay2(true)[0])
print(nestRelay(false)[0][0] / 4.0)
const z = recsRelay(false)
print(desc(z[z.length - 1]))
print(loopRelay(true)[0])
