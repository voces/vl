// @run
// @log 3
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log b
// @log 0
// @log 3
// @log 2
// @log 2
// @log 2
// @log 1
// A narrowed nullable list read through a member or index path is a list-op receiver like a
// narrowed local (D2235): push, pop and clear stage it into a non-null slot.

type P = { x: i32 }

const w: { f: string[] | null } = { f: ["a"] }
if w.f != null {
  w.f.push("b")
  print(w.f.push("c"))
}

const wi: { f: i32[] | null } = { f: [1] }
if wi.f != null { wi.f.push(2); print(wi.f.length) }

const wd: { f: f64[] | null } = { f: [1.5] }
if wd.f is f64[] { wd.f.push(2.5); print(wd.f.length) }

const wp: { f: P[] | null } = { f: [{ x: 1 }] }
if wp.f != null { wp.f.push({ x: 2 }); print(wp.f.length) }

const wn: { f: i32[][] | null } = { f: [[1]] }
if wn.f != null { wn.f.push([2]); print(wn.f.length) }

const a: { b: { f: string[] | null } } = { b: { f: ["a"] } }
if a.b.f != null { a.b.f.push("x"); print(a.b.f.length) }

const wq: { f: string[] | null } = { f: ["a", "b"] }
if wq.f != null { print(wq.f.pop() ?? "none") }
if wq.f != null { wq.f.clear(); print(wq.f.length) }

// A parameter's field, narrowed by an early exit.
function grow(s: { items: string[] | null }, x: string): void {
  if s.items == null { return }
  s.items.push(x)
}
const s: { items: string[] | null } = { items: ["a"] }
grow(s, "b")
grow(s, "c")
if s.items != null { print(s.items.length) }

// An un-annotated holder of a nullable field.
function mk(): i32[] | null { return [1] }
const u = { f: mk() }
if u.f != null { u.f.push(2); print(u.f.length) }

// An index receiver, and a field under an index.
const xs: (string[] | null)[] = [["a"]]
if xs[0] != null { xs[0].push("x"); print(xs[0].length) }
const ws: { f: string[] | null }[] = [{ f: ["a"] }]
if ws[0].f != null { ws[0].f.push("x"); print(ws[0].f.length) }

// Inside a closure.
const g = () => {
  if wi.f != null {
    wi.f.pop()
    return wi.f.length
  }
  0
}
print(g())
