// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// A binding holding an element of a list literal read in place adopts the record it is
// delivered to, as one holding the literal does: a read before the delivery, a delivery to the
// union, and the module scope (D17732, D17733).
type Circle = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function before() {
  const dd = [{ r: 7 }][0]
  print(dd.r)
  const gp: Circle = dd
  print(gp.r)
}
function toUnion() {
  const dd = [{ r: 7 }][0]
  const gp: Shape = dd
  print(if gp is Circle { gp.r } else { 0 })
}
before()
toUnion()
const md = [{ r: 7 }][0]
print(md.r)
const mg: Circle = md
print(mg.r)
