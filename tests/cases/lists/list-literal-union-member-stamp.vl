// @run
// @log 0.25
// @log 0.25
// @log 0.25
// @log 2
// @log 1
// @log 0.625
// @log 0.625
// @log 1
// @log 1
// A list literal delivered to a union of lists is built at the member it fits, looking through
// `| null` and a recursive alias's nested union: `[1]` into `boolean[] | f64[]` is an `f64[]`, and
// `[[2.5]]` into `Json` a `Json[]`. Each at an annotated binding and at a parameter or return
// (record covariance and D3339 (A): a fresh literal is stored as its destination).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type N = 1 | 2

const n: boolean[] | f64[] = [1]
if n is f64[] { print(n[0] / 4.0) }
function takeN(m: boolean[] | f64[] | null) {
  if m is f64[] { print(m[0] / 4.0) }
}
takeN([1])
function giveN(): boolean[] | f64[] { return [1] }
const g = giveN()
if g is f64[] { print(g[0] / 4.0) }

const l2: Json = ["a", "b"]
if l2 is Json[] { print(l2.length) }
const cBind: Json = [[2.5]]
if cBind is Json[] { print(cBind.length) }
function takeJ(j: Json) {
  if j is Json[] {
    const h = j[0]
    if h is Json[] {
      const v = h[0]
      if v is f64 { print(v / 4.0) }
    }
  }
}
takeJ([[2.5]])
takeJ(cBind)

const nn: N[][] = [[1]]
print(nn[0][0])
function takeNN(x: N[][]) { print(x[0][0]) }
takeNN([[1]])
