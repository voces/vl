// @run
// @log 6
// @log 4
// @log 8
// @log 6
// @log 4
// @log 6
// D13970 — a list literal built at a list destination has its elements judged by that delivery,
// not delivered again into the join of themselves: an un-annotated function first does not make
// a typed record after it a delivery into an open function type. Annotated binding, list
// argument, element store, un-annotated binding.
function inc0(a) { return a + 1 }
function dbl(a: i32) { return a * 2 }
const r0: { f: (a: i32) => i32 } = { f: dbl }
const l: { f: (a: i32) => i32 }[] = [{ f: inc0 }, r0]
print(l[1].f(3))
print(l[0].f(3))
l[0] = r0
print(l[0].f(4))
function run(xs: { f: (a: i32) => i32 }[]) {
  print(xs[1].f(3))
  print(xs[0].f(3))
}
run([{ f: inc0 }, r0])
const u = [{ f: inc0 }, r0]
print(u[1].f(3))
