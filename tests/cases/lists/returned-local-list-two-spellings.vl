// @run
// @log 0
// @log 0
// @log 4
// @log 5
// @log 3
// @log aa
// @log 3
// @log 3
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// @hint redundant type annotation: `xs` is inferred as `f64[]`
// @hint redundant type annotation: `xs` is inferred as `f32[]`
// @hint redundant type annotation: `xs` is inferred as `string[]`
// A returned local list declares the same result rep annotated and un-annotated, for a record,
// i32, f64, f32 and string element, and a `V[] | i32[]` parameter at V=i32 is the i32 list.
// The return pass asks about the local from outside its own emission, so the rep is the type's.
type Circle = { r: i32 | null }
function refA() {
  const cc: Circle[] = [{ r: null }]
  return cc
}
function refU() {
  const cc = [{ r: null }]
  return cc
}
function intA() {
  const xs: i32[] = [1, 2]
  return xs
}
function intU() {
  const xs = [1, 2]
  return xs
}
function fltA() {
  const xs: f64[] = [1.5, 2.5]
  return xs
}
function fltU() {
  const xs = [1.5, 2.5]
  return xs
}
function f32A() {
  const xs: f32[] = [1.5 as f32]
  return xs
}
function f32U() {
  const xs = [1.5 as f32]
  return xs
}
function strA() {
  const xs: string[] = ["a"]
  return xs
}
function strU() {
  const xs = ["a"]
  return xs
}
function rd(c: Circle[]) {
  if c[0].r != null { print(7) } else { print(0) }
}
rd(refA())
rd(refU())
print(intA()[1] + intU()[1])
print(fltA()[1] + fltU()[1])
print(f32A()[0] + f32U()[0])
print(strA()[0] + strU()[0])
function len<W>(a: W[] | i32[]) { a.length }
function fwdU<V>(a: V[] | i32[]) { print(len(a)) }
function fwdA(a: i32[]) { print(len(a)) }
fwdU([1, 2, 3])
fwdA([1, 2, 3])
