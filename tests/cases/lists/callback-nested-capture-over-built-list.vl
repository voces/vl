// @run
// @log null
// @log null
// @log null
// @log 1
// @log true
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A `filter` or `map` callback over `src`, whose records are stored at `J`, is instanced at `J`;
// a function nested in it, at any depth, still sees the callback's parameter (D16789).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const r = src.filter((y) => {
  const go = () => print(y.f)
  go()
  function again() { print(y.f) }
  again()
  const outer = () => {
    const inner = () => print(y.f)
    inner()
  }
  outer()
  return true
})
print(r.length)
const m = src.map((y) => {
  const test = () => y.f == null
  return test()
})
print(m[0])
