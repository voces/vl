// @run
// @log 1
// @log 2
// @log 5
// SHALLOW, as Kotlin's `List` and C#'s `IReadOnlyList` are: the marker is on the LIST, so
// `readonly Circle[][]` forbids writes to the outer list and says nothing about the inner
// ones it holds. The inner `Circle[]` is an ordinary mutable list and grows here.
type Circle = { r: i32 }
function f() {
  const g: readonly Circle[][] = [[{ r: 5 }]]
  print(g.length)
  g[0].push({ r: 6 })
  print(g[0].length)
  print(g[0][0].r)
}
f()
