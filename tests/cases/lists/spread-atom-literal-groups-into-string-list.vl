// @run
// @log bb/a
// @log a/bb/x
// @log bb/bb/a
// @log 3
// @log bb/a
// A spread literal into a `string[]` whose groups are fresh literals of literal-union atoms:
// each group is built as a string list, every atom delivered at the string it names, in a
// function, beside a string run, two atoms in one group, as an argument and at the top level.
import { join } from "std:str"

type K = "a" | "bb"
function kk(): K { return "bb" }
function count(xs: string[]) { return xs.length }
function main() {
  const k = kk()
  const one: K = "a"
  const s1: string[] = [...[k], ...[one]]
  print(join(s1, "/"))
  const s2: string[] = [...[one], ...[k], "x"]
  print(join(s2, "/"))
  const s3: string[] = [...[k, k], ...[one]]
  print(join(s3, "/"))
  print(count([...[k], ...[one, k]]))
}
main()
const t: K = "bb"
const u: K = "a"
const s4: string[] = [...[t], ...[u]]
print(join(s4, "/"))
