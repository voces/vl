// @run
// @log 20
// @log -1
// `xs.get(i)` over a i32 list, its `T | null` delivered at nested-arg: an index in range, then
// one past the end (Q58 position sweep).
function show(g: i32 | null) { print(g ?? -1) }
function pass(g: i32 | null) { return g }
function go(i: i32) {
  const xs = [10, 20]
  show(pass(xs.get(i)))
}
go(1)
go(2)
