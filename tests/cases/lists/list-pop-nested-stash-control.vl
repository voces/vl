// @run
// @log 5
// @log 9
// @log 3
// @log 1
// A staged `.pop()` nested in a staged `.get`'s index and in a staged `.pop()`'s receiver: the
// pop frames are not `.get`'s stash, and print what the hoisted spelling prints (D17381's control).
function L(xs: i32[]) { return xs }
const b = [5, 6, 7]
const c = [2, 1, 0]
const e = [8, 9]
function M(k: i32) { return if k == 0 { b } else { e } }
// a staged pop inside a staged get's index
print(L(b).get(L(c).pop() ?? 1) ?? -1)
// a staged pop inside a staged pop's receiver
print(M(L(c).pop() ?? 0).pop() ?? -1)
print(b.length)
print(e.length)
