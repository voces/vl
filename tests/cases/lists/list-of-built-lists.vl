// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// An element of a list of lists holds the build of its part `src`, stored at `J`, so a callback
// or a loop over it reads the elements there (D16784).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const srcs = [src]
print(srcs[0].filter((y: { f: null }) => y.f == null).length)
print(srcs[0].filter((y) => y.f == null).length)
const s0 = srcs[0]
print(s0.filter((y) => y.f == null).length)
function show(z: { f: null }) { print(z.f) }
for y in srcs[0] { show(y) }
