// @emit-error `??` over a list whose default is a list of another storage
// D2799 beside D2838: an `i32[] | null` operand with an `i64` literal default is typed `i32[]`,
// and no list of both exists, so the `??` is refused rather than built as invalid wasm.
const a: i32[] | null = null
const q = a ?? [5000000002]
print(q[0])
