// @log 9
// @log 5
// @log 9
// @log 8
// @log 24
// `xs.get(i) ?? d` over a i32 list at nine positions, a literal, negative, field and global
// receiver or index, a `?? ys.get(j) ?? d` chain and a conditional default: the default runs
// only on a miss, counted by `calls`, and each prints what legacy's fused read prints.
let calls = 0
function d() {
  calls = calls + 1
  return 9
}
function show(r: i32) { print(r) }
function id(r: i32) { return r }
type H = { xs: i32[] }
const gs = [4, 5]
function get_let_init(xs: i32[], i: i32) {
  const r = xs.get(i) ?? d()
  print(r)
}
function get_element(xs: i32[], i: i32) {
  const ys = [xs.get(i) ?? d()]
  print(ys[0])
}
function get_arg(xs: i32[], i: i32) { show(xs.get(i) ?? d()) }
function get_ret(xs: i32[], i: i32) { return xs.get(i) ?? d() }
function get_field(xs: i32[], i: i32) {
  const o = { v: xs.get(i) ?? d() }
  print(o.v)
}
function get_if_arm(xs: i32[], i: i32) {
  const r = if xs.length > 0 { xs.get(i) ?? d() } else { 8 }
  print(r)
}
function get_nested_arg(xs: i32[], i: i32) { show(id(xs.get(i) ?? d())) }
function get_interp(xs: i32[], i: i32) { print("v=\{xs.get(i) ?? d()}") }
function get_assign(xs: i32[], i: i32) {
  let r = 8
  r = xs.get(i) ?? d()
  print(r)
}
get_let_init([4, 5], 1)
get_let_init([4, 5], 5)
get_let_init([4, 5], -1)
get_element([4, 5], 1)
get_element([4, 5], 5)
get_element([4, 5], -1)
get_arg([4, 5], 1)
get_arg([4, 5], 5)
get_arg([4, 5], -1)
print(get_ret([4, 5], 1))
print(get_ret([4, 5], 5))
print(get_ret([4, 5], -1))
get_field([4, 5], 1)
get_field([4, 5], 5)
get_field([4, 5], -1)
get_if_arm([4, 5], 1)
get_if_arm([4, 5], 5)
get_if_arm([4, 5], -1)
get_nested_arg([4, 5], 1)
get_nested_arg([4, 5], 5)
get_nested_arg([4, 5], -1)
get_interp([4, 5], 1)
get_interp([4, 5], 5)
get_interp([4, 5], -1)
get_assign([4, 5], 1)
get_assign([4, 5], 5)
get_assign([4, 5], -1)
function get_lit(xs: i32[]) { print(xs.get(0) ?? d()) }
function get_neg(xs: i32[]) { print(xs.get(-1) ?? d()) }
function get_field_recv(h: H, i: i32) { print(h.xs.get(i) ?? d()) }
function get_global_recv(i: i32) { print(gs.get(i) ?? d()) }
function get_chain(xs: i32[], ys: i32[], i: i32, j: i32) {
  print(xs.get(i) ?? ys.get(j) ?? d())
}
function get_cond(xs: i32[], i: i32, c: boolean) {
  print(xs.get(i) ?? (if c { d() } else { 8 }))
}
get_lit([4, 5])
get_lit([])
get_neg([4, 5])
get_field_recv({ xs: [4, 5] }, 1)
get_field_recv({ xs: [4, 5] }, 7)
get_global_recv(1)
get_global_recv(9)
get_chain([4, 5], [], 1, 0)
get_chain([], [4, 5], 0, 1)
get_chain([], [], 0, 1)
get_cond([4, 5], 1, true)
get_cond([4, 5], 4, true)
get_cond([4, 5], 4, false)
print(calls)
