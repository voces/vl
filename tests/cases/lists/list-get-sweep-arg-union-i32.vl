// @run
// @log 20
// @log -1
// `xs.get(i)` over a i32 list, its `T | null` delivered at arg-union: an index in range, then
// one past the end (Q58 position sweep).
function show(g: i32 | null) { print(g ?? -1) }
function showU(u: i32 | null | boolean) {
  if u is boolean { print(u) } else { show(u) }
}
function go(i: i32) {
  const xs = [10, 20]
  showU(xs.get(i))
}
go(1)
go(2)
