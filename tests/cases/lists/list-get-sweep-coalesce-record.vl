// @run
// @log 20
// @log -1
// `xs.get(i)` over a record list, its `T | null` delivered at coalesce: an index in range, then
// one past the end (Q58 position sweep).
type R = { x: i32 }
function show(g: R | null) {
  if g == null { print(-1) } else { print(g.x) }
}
function go(i: i32) {
  const xs: R[] = [{ x: 10 }, { x: 20 }]
  const d: R = { x: -1 }
  show(xs.get(i) ?? d)
}
go(1)
go(2)
