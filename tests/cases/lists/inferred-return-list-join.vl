// @run
// @hint redundant type annotation: `y` is inferred as `f64[]`
// @log 1
// @log s
// @log 1
// @log 0.5
// @log 9000000002
// @log 0.5
// @log s
// @log 2.5
// @log 1.875
// A list whose returns or `if` arms disagree about their element is built at the joined
// list type, not at the first literal's (D2716).
function mix(c: boolean) {
  if c { return [1, "s"] }
  return ["s"]
}
function mixRev(c: boolean) {
  if c { return ["s"] }
  return [1, "s"]
}
function wide(c: boolean) {
  if c { return [2] }
  return [1.5, 2]
}
function wideI64(c: boolean) {
  if c { return [2] }
  return [9000000000]
}
function nested(c: boolean) {
  if c { return [[1.5]] }
  return [[2]]
}
function tail(c: boolean) {
  if c { [1, "s"] } else { ["s"] }
}
function arms(c: boolean) {
  const x = if c { [2] } else { [1.5] }
  const y: f64[] = if c { [2] } else { [1.5] }
  print(x[0] / 4.0 + y[0])
}
print(mix(true)[0])
print(mix(false)[0])
print(mixRev(false)[0])
print(wide(true)[0] / 4.0)
print(wideI64(true)[0] + 9000000000)
print(nested(false)[0][0] / 4.0)
print(tail(false)[0])
arms(true)
arms(false)
