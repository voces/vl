// @run
// @log 7.5
// @log 8.5
// @log 3
// @log 1
// @log 3
// @log 7.5
// An un-annotated if-expression joining an `f32[]` arm with `[]` binds the f32 list's own
// wrapper at a module binding, both arm orders, a local, an inferred return, a generic body
// and a capture (D2270).

function t() { 1 == 1 }
const src = [(7.5 as f32), (1.0 as f32)]

const v = if t() { src } else { [] }
print(v[0])

const w = if !t() { [] } else { src }
print(w[0] + w[1])

function local() {
  const x = if t() { src } else { [] }
  x.push((2.5 as f32))
  return x.length
}
print(local())

function ret(c: boolean) {
  if c { src } else { [] }
}
print(ret(true)[1])

function pick<T>(c: boolean, xs: T[]) {
  const r = if c { xs } else { [] }
  return r.length
}
print(pick(true, src))

const y = if t() { src } else { [] }
const f = () => y[0]
print(f())
