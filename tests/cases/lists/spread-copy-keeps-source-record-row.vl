// @run
// @log 1
// @log 27
// @log 82
// D2938: a spread copy of an un-annotated list of nested-record literals is built at, and binds
// to, its source's own record, not an earlier-declared record of the same layout whose field is
// nullable. At module scope, in a function, and as a generic argument.
type A = { v: i32 }
type J = { f: A | null }
type I = { f: A }
const il = [{ f: { v: 7 } }]
const cp = [...il]
print(cp.length)
function go() {
  const jl = [{ f: { v: 7 } }]
  const cq = [...jl, ...jl]
  print(cq.length * 10 + cq[1].f.v)
}
go()
const src = [{ f: { v: 7 } }, { f: { v: 8 } }]
function take(a) {
  const v = a
  print(v[1].f.v * 10 + v.length)
}
take([...src])
