// @run
// @log 82
// @log 82
// @log 82
// @log 82
// @log 82
// @log 8
// @log 82
// @log 82

// A list of an un-annotated record list keeps the inner list's own row when two declared
// records share its layout, one with a nullable field (D6731, D6772).

type Ax = { v: i32 }
type Jx = { f: Ax | null }
type Ix = { f: Ax }

const src = [{ f: { v: 7 } }, { f: { v: 8 } }]
const xs = [[...src]]

const v1 = xs[0]
print(v1[1].f.v * 10 + v1.length)

const ys = [src]
const v2 = ys[0]
print(v2[1].f.v * 10 + v2.length)

function first<T>(g: T[][]): T[] { return g[0] }
const v3 = first(xs)
print(v3[1].f.v * 10 + v3.length)

const f = () => xs[0]
const v4 = f()
print(v4[1].f.v * 10 + v4.length)

let w = xs[0]
w = xs[0]
print(w[1].f.v * 10 + w.length)

const e = xs[0][1]
print(e.f.v)

function mk() { return [[...src]] }
const v5 = mk()[0]
print(v5[1].f.v * 10 + v5.length)

const zs = [src, [...src]]
const v6 = zs[1]
print(v6[1].f.v * 10 + v6.length)
