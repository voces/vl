// @check
// @error-at 12:12 {f: i32} is not J: they store field `f` differently
// @error-at 12:18 {f: i32} is not K: they store field `f` differently
// VERDICT PIN (must-error), no `@log` form: the diagnostic IS the observable.
// Two calls in one un-annotated list literal are built at records storing `f` differently,
// so the list has no one element row and each element refuses at its own row (D14515).
type J = { f: i32 | null }
type K = { f: i32 | string }
function mk() { { f: 4 } }
function mk2() { { f: 6 } }
const wideJ: J = mk()
const wideK: K = mk2()
const xs = [mk(), mk2()]
print(xs.length)
print(wideJ.f ?? 0)
