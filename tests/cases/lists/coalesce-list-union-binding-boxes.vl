// @run
// @log 1
// @log a
// @log 2.5
// @log 5
// @log d
// @log 1
// D2844: a binding whose `??` or `if` initializer joins lists of different storage, with no
// annotation, is pinned to that list union, so the default boxes into it and an `is` tells the
// two arms apart, at module scope and inside a function alike.
function main(xs: string[] | null) {
  const v = xs ?? [[1]]
  if v is string[] { print(v[0]) } else { print(v[0][0]) }
}
main(null)
main(["a"])
function f(xs: i32[] | null) {
  const v = xs ?? [[2.5]]
  if v is i32[] { print(v[0]) } else { print(v[0][0]) }
}
f(null)
f([5])
const ys: i32[][] | null = null
const w = ys ?? ["d"]
if w is string[] { print(w[0]) } else { print(w[0][0]) }
const zs: string[][] | null = null
const q = if zs != null { zs } else { [[1]] }
if q is i32[][] { print(q[0][0]) } else { print(-1) }
