// @run
// @log 10
// @log 2
// @log 10
// @log 71
// @log 71
// @log 3
// An un-annotated list literal passed to a lambda's typed parameter takes that parameter's
// element storage, as it does for a named function's (D2696): a local lambda, one beside a
// sibling block whose same-named literal goes to a function, and a module-global lambda.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function sum(xs: Shape[]) {
  let t = 0
  for e in xs {
    if e is Circle { t = t + e.r } else { t = t + e.s * 10 }
  }
  t
}
function take(xs: Shape[]) { sum(xs) }
const g = (xs: Shape[]) => sum(xs)
function local() {
  const k = (xs: Shape[]) => sum(xs)
  const out = [{ s: 1 }]
  print(k(out))
}
function siblings(n: i32) {
  const k = (xs: Shape[]) => sum(xs)
  if n == 0 {
    const out = [{ r: 2 }]
    print(take(out))
  }
  if n == 1 {
    const out = [{ s: 1 }]
    print(k(out))
  }
}
function global() {
  const out = [{ r: 1 }, { s: 7 }]
  print(g(out))
  const out2 = [{ s: 7 }, { r: 1 }]
  print(g(out2))
  const out3 = [{ r: 3 }]
  print(g(out3))
}
local()
siblings(0)
siblings(1)
global()
