// @run
// @log 1
// @log true
// @log null
// @log null
// @log true
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A lambda annotating its parameter at the element type, over a list `src`'s build stores at `J`,
// is instanced at `J` as an un-annotated one is, and hands that `J` element on (D16764, D16783).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
print(src.filter((y: { f: null }) => y.f == null).length)
const b = src.map((y: { f: null }) => y.f == null)
print(b[0])
const r = src.filter((y: { f: null }) => y.f == null)
print(r[0].f)
function show(z: { f: null }) { print(z.f) }
const s = src.filter((y: { f: null }) => {
  show(y)
  return true
})
print(s.length == 1)
