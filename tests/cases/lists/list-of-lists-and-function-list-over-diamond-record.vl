// @run
// @log 2
// @log 3
// @log 0
// @log 2
// @log 12
// @log -1
// @log -1
// @log 22
// A list of lists of a diamond-shaped record, and a list of function types over one, nullable
// or not, as parameters, a result and globals, nested past depth 8 (D9510).
type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
const a0: A0 = { x: 1 }
const a1: A1 = { l: a0, r: a0 }
const a2: A2 = { l: a1, r: a1 }
const a3: A3 = { l: a2, r: a2 }
const a4: A4 = { l: a3, r: a3 }
const a5: A5 = { l: a4, r: a4 }
const a6: A6 = { l: a5, r: a5 }
const a7: A7 = { l: a6, r: a6 }
const a8: A8 = { l: a7, r: a7 }
const a9: A9 = { l: a8, r: a8 }
const a10: A10 = { l: a9, r: a9 }

function depth(u: A10[][]) { u[0][0].l.r.l.r.l.r.l.r.l.r.x + u.length }
function count(u: A10[][]) { u.length }
function rows(): A10[][] { [[a10, a10], [a10]] }
function apply(fs: ((x: A10) => i32)[]) { fs[0](a10) + fs.length }
function maybe(fs: (((x: A10) => i32) | null)[]) {
  const f = fs[0]
  if f == null { return 0 - 1 }
  f(a10) + fs.length
}
const grid: A10[][] = [[a10], [a10, a10]]
const none: (((x: A10) => i32) | null)[] = [null]

print(depth([[a10]]))
print(depth(rows()))
print(count([]))
print(grid[1].length)
print(apply([(a: A10) => a.l.l.l.l.l.l.l.l.l.l.x + 10]))
print(maybe([null]))
print(maybe(none))
print(maybe([(a: A10) => a.r.r.r.r.r.r.r.r.r.r.x + 20]))
