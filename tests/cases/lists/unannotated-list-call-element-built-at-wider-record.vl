// @run
// @log 5
// @log 4
// An un-annotated list literal holds its elements at the record its element call is built as:
// `mk()` is built at `J` for `wideJ`, so the list is a `J[]`, not a list of the same-shape `II`
// declared beside it (D14515).
type II = { f: i32 }
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const wideF = wideJ.f ?? 0
const xs = [mk()]
const v = xs[0]
print(v.f + 1)
print(wideF)
