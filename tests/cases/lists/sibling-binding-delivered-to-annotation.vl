// @run
// @log 2
// @log 5
// @log 2
// A list binding delivered to a `Circle[]` annotation is the binding in scope at the delivery,
// not an earlier sibling of the same name whose mixed literal is union-box storage (D2697).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f(n: i32) {
  if n == 0 {
    const out = [{ r: 1 }, { s: 7 }]
    print(out.length)
  }
  if n == 2 {
    const out = [{ r: 5 }, { r: 3 }]
    const c: Circle[] = out
    print(c[0].r)
  }
}
f(0)
f(2)
function g(n: i32) {
  if n == 0 {
    const out = [{ r: 1 }, { s: 7 }]
    print(out.length)
  }
  let c: Circle[] = []
  if n == 2 {
    const out = [{ r: 6 }, { r: 3 }]
    c = out
  }
  print(c.length)
}
g(2)
