// @check
// @error cannot assign boolean[] to 'a' of type f64[] — a `boolean` is not a number; convert each element with `b as f64`
// @error cannot assign (f64 | boolean)[] to 'm' of type f64[] — a `boolean` is not a number; convert each element with `b as f64`
// @error cannot assign string[] to 'n' of type i32[]
// @error argument 1: expected i64[], got boolean[] — a `boolean` is not a number; convert each element with `b as i64`
// @error return type mismatch: expected f64[], got boolean[] — a `boolean` is not a number; convert each element with `b as f64`
// @error argument 1: expected f64[], got boolean[] — a `boolean` is not a number; convert each element with `b as f64`
// A spread hands over its list's elements, each delivered as one element of the literal, so
// its element type is checked against the destination's as a written element is (D3253).
const bs = [3 > 2]
const a: f64[] = [...bs]
const m: f64[] = [0.5, ...bs]
const ss = ["x"]
const n: i32[] = [...ss]
function r(...xs: i64[]) { return xs.length }
print(r(...bs))
function f(ys: boolean[]): f64[] { return [...ys] }
function h(zs: f64[]) { return zs[0] / 4.0 }
print(h([...bs]))
print(a.length + m.length + n.length + f(bs).length)
