// @log 104
// D12820, D2193: a `.map` whose callback returns a nullable record that is an arm of a declared
// union builds its `| null` result, un-annotated and annotated, read in a loop, by index, through
// `?.` on an element, filtered, returned from a function, passed as an argument, built from the
// union itself, and as the copy the container rule offers.
type P = { x: i32 }
type Q = { q: i32 }
type U = P | Q
const z: P | null = null
const a: P | null = null
const b: P | null = { x: 7 }
const m0: (P | null)[] = [z].map((e) => e)
for y in m0 { print(y?.x) }
const m = [a, b].map((e) => e)
for y in m { print(y?.x) }
print(m[0] == null)
print(m[1] == null)
const n: (P | null)[] = [a, b].map((e) => e)
for y in n { print(y?.x) }
print(m.filter((e) => e != null).length)
function mk() { return [a, b].map((e) => e) }
for y in mk() { print(y?.x) }
function use(xs: (P | null)[]) {
  for y in xs { print(y?.x) }
}
use([a, b].map((e) => e))
const us: U[] = [{ x: 2 }, { q: 3 }]
for y in us.map((e) => if e is P { e } else { null }) { print(y?.x) }
const ps: P[] = [{ x: 7 }, { x: 8 }]
const w: (P | null)[] = ps.map((e): P | null => e)
print(w.length)
function g(k: i32): P | null {
  if k > 0 { { x: k * 52 } } else { null }
}
print([0, 2].map((k) => g(k))[1]?.x)
