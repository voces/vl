// @run
// @log 3
// @log 1
// @hint redundant type annotation: `z` is inferred as `{q: i32}` — remove it to lean on inference
// THE HINT IS DECLARED, NOT REMOVED: `const z: readonly` — the annotation naming a type
// called `readonly` — is exactly what this fixture pins.
// `readonly` is contextual, not reserved: it reads as the view's marker only where the next
// token can begin a type, so a declared type named `readonly` — and a value binding of that
// name — still resolve. Without the lookahead the marker would take every such program away.
type readonly = { q: i32 }
function f() {
  const z: readonly = { q: 3 }
  print(z.q)
  const readonly = 1
  print(readonly)
}
f()
