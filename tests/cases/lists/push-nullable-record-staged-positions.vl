// @run
// @log 6
// @log 3
// @log 3
// @log 4
// @log 1
// Q58 position sweep: a push into a list of nullable records (a nested element slot) whose value
// holds a valued `if` or a boxed `??` stages its receiver, at the top level and in a function.
type V2 = { u: f64, w: f64 }
function mk(k: f64): V2 { return { u: k, w: k * 3.0 } }
function pick(i: i32): V2 | null { return if i > 1 { mk(1.0) } else { null } }
function count(xs: (V2 | null)[]) {
  let n = 0
  for e in xs {
    if e != null { n += 1 }
  }
  return n
}
const g: (V2 | null)[] = []
for i in 0 until 4 { g.push(if i % 2 == 0 { mk(i as f64) } else { null }) }
g.push(pick(3) ?? mk(5.0))
g.push(if g.length > 2 { null } else { mk(9.0) })
print(g.length)
print(count(g))
function local() {
  const xs: (V2 | null)[] = []
  for i in 0 until 3 { xs.push(if i == 1 { null } else { mk(2.0) }) }
  xs.push(pick(0) ?? mk(4.0))
  print(count(xs))
  return xs.length
}
print(local())
const h: { l: (V2 | null)[] } = { l: [] }
h.l.push(if g.length > 0 { mk(7.0) } else { null })
print(count(h.l))
