// @run
// Clearing a list. `xs = []` over a NON-i32 list LOCAL or PARAM was invalid wasm with
// `vl check` clean — the most ordinary operation there is.
//
// `emitAssign`'s LOCAL arm never seeded `pendingListKind` / `pendingListSlot` from the cell it
// is storing into, so a list-LITERAL right-hand side built the DEFAULT i32 list and dropped it
// into a `string[]` / `f64[]` / `i64[]` / `f32[]` / `S[]` / `i32[][]` / `(S|null)[]` /
// `S[]|null` slot. Two CONTROLS say it was the seed and not the assignment path: the `i32[]`
// local RAN (the default IS its slot) and every GLOBAL twin RAN (the global arm has read
// `letAnnRefListKind` off the cell's annotation all along, as `emitLetDeclStmt` does for the
// declaration). Filed at the site by #1215, which declined to ride along because it changes
// what every list-literal assignment builds.
//
// A NON-EMPTY literal was broken too, in the two backings that do not self-identify: `xs = [1,
// 2]` over an `i64[]` cell built an i32 list, and `xs = [1.5, 2.5]` over `f32[]` built an f64
// one. Those rows are the reason the seed is unconditional rather than empty-literal-only.
//
// The seed is keyed off the TARGET EXPRESSION, not a `LetDecl`: a declared local's annotation
// is compiled away into the slot tables by `buildLocals`, and a param never had one — which is
// why the same arm serves both and both were equally broken.
//
// THE LITERAL-UNION ROWS ARE CONTROLS, not fixes. A `K[]` cell's backing IS the default i32
// list (of interned atom ids), so it must reach the trailing `0` exactly as
// `tyAnnRefListKind`'s own `tyIsLitUnionArray` subtraction arranges. Seeding the string-list
// build for it — which the softened `string[]` spelling invites — would break a working row.

// @log 0
// @log 2
// @log 0
// @log 2
// @log 0
// @log 2
// @log 0
// @log 2
// @log 0
// @log 2
// @log 0
// @log 2
// @log 0
// @log 2
// @log 0
// @log 2
// @log 0
// @log 2
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 3
// @hint redundant type annotation: `a` is inferred as `string[]`
// @hint redundant type annotation: `b` is inferred as `f64[]`
// @hint redundant type annotation: `e` is inferred as `{n: i32}[]`
// @hint redundant type annotation: `g` is inferred as `i32[][]`
// @hint redundant type annotation: `h` is inferred as `({n: i32} | null)[]`
// @hint redundant type annotation: `k` is inferred as `i32[]`

type S = { n: i32 }
type K = "a" | "b"

// ── LOCAL: clear, then refill ───────────────────────────────────────────────────────────
function locals() {
  let a: string[] = ["x"]
  a = []
  print(a.length) // 0
  a = ["p", "q"]
  print(a.length) // 2

  let b: f64[] = [1.5]
  b = []
  print(b.length) // 0
  b = [1.5, 2.5]
  print(b.length) // 2

  let c: i64[] = [1]
  c = []
  print(c.length) // 0
  c = [1, 2]
  print(c.length) // 2

  let d: f32[] = [1.5]
  d = []
  print(d.length) // 0
  d = [1.5, 2.5]
  print(d.length) // 2

  let e: S[] = [{ n: 1 }]
  e = []
  print(e.length) // 0
  e = [{ n: 1 }, { n: 2 }]
  print(e.length) // 2

  let g: i32[][] = [[1]]
  g = []
  print(g.length) // 0
  g = [[1], [2]]
  print(g.length) // 2

  let h: (S | null)[] = [{ n: 1 }, null]
  h = []
  print(h.length) // 0
  h = [{ n: 1 }, null]
  print(h.length) // 2

  let j: S[] | null = [{ n: 1 }]
  j = []
  print(j.length) // 0
  j = [{ n: 1 }, { n: 2 }]
  print(j.length) // 2

  // CONTROLS — the i32 list (the default IS its slot) and the literal-union list (whose
  // backing is that same default i32 list of atom ids). Both ran on master.
  let k: i32[] = [1]
  k = []
  print(k.length) // 0
  k = [1, 2]
  print(k.length) // 2
}
locals()

// ── PARAM: the same arm, the same gap ───────────────────────────────────────────────────
function clearStr(xs: string[]) {
  xs = []
  print(xs.length) // 0
}
function clearF64(xs: f64[]) {
  xs = []
  print(xs.length) // 0
}
function clearI64(xs: i64[]) {
  xs = []
  print(xs.length) // 0
}
function clearF32(xs: f32[]) {
  xs = []
  print(xs.length) // 0
}
function clearStruct(xs: S[]) {
  xs = []
  print(xs.length) // 0
}
function clearNested(xs: i32[][]) {
  xs = []
  print(xs.length) // 0
}
function clearNulElem(xs: (S | null)[]) {
  xs = []
  print(xs.length) // 0
}
function clearNulList(xs: S[] | null) {
  xs = []
  print(xs.length) // 0
}
// CONTROL: a literal-union list param — its cell is the i32 backing, so the seed must stay 0.
function clearAtoms(xs: K[]) {
  xs = []
  print(xs.length) // 0
}

clearStr(["x"])
clearF64([1.5])
clearI64([1])
clearF32([1.5])
clearStruct([{ n: 1 }])
clearNested([[1]])
clearNulElem([{ n: 1 }, null])
clearNulList([{ n: 1 }])
clearAtoms(["a"])

// A litunion list LOCAL still builds its atom ids after a clear.
function atomsAfterClear() {
  let ks: K[] = ["a"]
  ks = []
  ks = ["a", "b", "a"]
  print(ks.length) // 3
}
atomsAfterClear()
