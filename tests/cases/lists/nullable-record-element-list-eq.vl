// @log false
// @log true
// @log true
// `==` over lists whose element is a nullable record compares pair by pair: two nulls are
// equal, a null and a record are not, and two records compare field-wise. Against a literal
// and inside a generic too.
type P = { x: i32, s: string }
const a: (P | null)[] = [{ x: 1, s: "a" }, null]
const b: (P | null)[] = [{ x: 1, s: "a" }, null]
const c: (P | null)[] = [{ x: 1, s: "a" }, { x: 2, s: "b" }]
const d: (P | null)[] = [null, null]
print(a == b)
print(a == c)
print(a != c)
print(d == d)
print(c == a)
print(a == [{ x: 1, s: "a" }, null])
function eqT<T>(x: T[], y: T[]) { x == y }
print(eqT(a, b))
