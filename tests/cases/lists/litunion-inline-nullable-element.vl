// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log a
// @log a
// @log 1
// @log 1
// A NULLABLE-ELEMENT literal-union list — `(("a" | "b") | null)[]` — beside its
// `(K | null)[]` alias control at every position. The elements are interned atom ids on
// the i32 backing with the spare value `-1` for `null` (the atom NICHE), which is what
// `nameIsI32Array` already folds the alias spelling onto.
//
// WHY IT IS A FIXTURE. `canonEmitName` PRESERVES the members of a nullable ALIAS litunion
// and SOFTENS an inline one, so this annotation renders `(string | null)[]` — a spelling
// `nameIsStringArray` accepts as its own niche. The value was built correctly (atom ids,
// `-1` for `null`) into a `(ref $mkListIdx)` string-list slot, and the element READ took
// the `(ref null $aTypeIdx)` string backing of an i32 array. The alias column is rejected
// out of the string-list family by `nameIsNulLitUnionList`; the inline column had nothing
// left in the name to reject, so the rejects are now structural
// (`annIsNulLitUnionArray` / `annIsNulStrListDeep`).
//
// The element READ has its own line on purpose: the list's SLOT and the element's
// BACKING are decided by different classifiers, and healing only the slot leaves an
// `array.get` over the wrong array type.

type K = "a" | "b"

const gInline: (("a" | "b") | null)[] = ["a", null]
const gAlias: (K | null)[] = ["a", null]

type SInline = { xs: (("a" | "b") | null)[] }
type SAlias = { xs: (K | null)[] }

function locals() {
  const xi: (("a" | "b") | null)[] = ["a", null]
  print(xi.length) // 2
  const xa: (K | null)[] = ["a", null]
  print(xa.length) // 2
}

function fields() {
  const si: SInline = { xs: ["a", null] }
  print(si.xs.length) // 2
  const sa: SAlias = { xs: ["a", null] }
  print(sa.xs.length) // 2
}

// The element READ: a member element narrows to its atom, a `null` element to absent.
function reads() {
  const xi: (("a" | "b") | null)[] = ["a", null]
  const vi = xi[0]
  if vi != null {
    print(vi) // a
  }
  const xa: (K | null)[] = ["a", null]
  const va = xa[0]
  if va != null {
    print(va) // a
  }

  let hi = 0
  if xi[1] == null { hi = 1 }
  print(hi) // 1
  let ha = 0
  if xa[1] == null { ha = 1 }
  print(ha) // 1
}

print(gInline.length) // 2
print(gAlias.length) // 2
locals()
fields()
reads()
