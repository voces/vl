// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log a
// @log a
// @log 1
// @log 1
// @log 1
// @log 2
// @log 1
// @log 2
// @log 2
// @log 2
// A NULLABLE-ELEMENT literal-union list — `(("a" | "b") | null)[]` — beside its
// `(K | null)[]` alias control at every position. The elements are interned atom ids on
// the i32 backing with the spare value `-1` for `null` (the atom NICHE), which is what
// `nameIsI32Array` already folds the alias spelling onto.
//
// WHY IT IS A FIXTURE — AND THE SOFTEN IT WAS WRITTEN AGAINST IS NOW GONE. `canonEmitName`
// used to PRESERVE the members of a nullable ALIAS litunion and SOFTEN an inline one, so
// this annotation rendered `(string | null)[]` — a spelling `nameIsStringArray` accepts as
// its own niche. The value was built correctly (atom ids, `-1` for `null`) into a
// `(ref $mkListIdx)` string-list slot, and the element READ took the `(ref null $aTypeIdx)`
// string backing of an i32 array. The alias column is rejected out of the string-list family
// by `nameIsNulLitUnionList`; the inline column had nothing left in the name to reject, so
// the rejects were made structural (`annIsNulLitUnionArray` / `annIsNulStrListDeep`).
//
// THE NAME NOW AGREES WITH THE ALIAS COLUMN. `nulLitUnionPreserve` sees through the
// element's grouping paren and hands the interior to `litUnionPreserve`, so the annotation
// canons to `(K | null)[]` — the alias column's own spelling — and the module stops
// interning the string-list heap types at all (−2 types, −13 bytes; the two columns' reps
// were already identical, only their NAMES forked). The structural rejects above stay: they
// are the guard for a spelling that no longer arrives, and an unreached rung is not a wrong
// one.
//
// The element READ has its own line on purpose: the list's SLOT and the element's
// BACKING are decided by different classifiers, and healing only the slot leaves an
// `array.get` over the wrong array type.
//
// THE LAST TWO BODIES ARE THE TWO POSITIONS THE PRESERVE UNBLOCKS, and they were BOTH
// broken before it, in the two different ways this programme distinguishes:
//   · `nested()` — a 2-D `(("a" | "b") | null)[][]`: `vl check` rc 0, `vl build` wrote 530
//     bytes that do not validate (`type mismatch: expected (ref $type), found (ref $type)`).
//     SILENT INVALID WASM.
//   · `mapVals()` — the same list as a MAP VALUE: a clean REJECT,
//     `emitProgram: field access but no struct type declared`.
// Their `(K | null)` alias controls are byte-identical before and after, which is what makes
// the pair a control rather than a second copy of the same assertion.

type K = "a" | "b"

const gInline: (("a" | "b") | null)[] = ["a", null]
const gAlias: (K | null)[] = ["a", null]

type SInline = { xs: (("a" | "b") | null)[] }
type SAlias = { xs: (K | null)[] }

function locals() {
  const xi: (("a" | "b") | null)[] = ["a", null]
  print(xi.length) // 2
  const xa: (K | null)[] = ["a", null]
  print(xa.length) // 2
}

function fields() {
  const si: SInline = { xs: ["a", null] }
  print(si.xs.length) // 2
  const sa: SAlias = { xs: ["a", null] }
  print(sa.xs.length) // 2
}

// The element READ: a member element narrows to its atom, a `null` element to absent.
function reads() {
  const xi: (("a" | "b") | null)[] = ["a", null]
  const vi = xi[0]
  if vi != null {
    print(vi) // a
  }
  const xa: (K | null)[] = ["a", null]
  const va = xa[0]
  if va != null {
    print(va) // a
  }

  let hi = 0
  if xi[1] == null { hi = 1 }
  print(hi) // 1
  let ha = 0
  if xa[1] == null { ha = 1 }
  print(ha) // 1
}

// The 2-D element: the inner list's element is reached through a LIST element rather than
// through the annotation's own array arm, so it is a second decision on the same name.
function nested() {
  const n2: (("a" | "b") | null)[][] = [["a", null]]
  print(n2.length) // 1
  print(n2[0].length) // 2
  const a2: (K | null)[][] = [["a", null]]
  print(a2.length) // 1
  print(a2[0].length) // 2
}

// The MAP VALUE: the emitter's normalizer descends into a map's value, so this is the same
// element name reached from a third position.
function mapVals() {
  const mi: {[string]: (("a" | "b") | null)[]} = Map()
  mi["k"] = ["b", null]
  const vi = mi["k"]
  if vi != null {
    print(vi.length) // 2
  }
  const ma: {[string]: (K | null)[]} = Map()
  ma["k"] = ["b", null]
  const va = ma["k"]
  if va != null {
    print(va.length) // 2
  }
}

print(gInline.length) // 2
print(gAlias.length) // 2
locals()
fields()
reads()
nested()
mapVals()
