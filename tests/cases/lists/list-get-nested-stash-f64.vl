// @run
// @log 6.5
// @log 6.5
// @log 6.5
// @log 6.5
// @log 9.5
// @log 6.5
// @log 9.5
// @log 8.5
// A `.get` that stages its receiver or index, with a staging `.get` nested in its index, its
// default and its receiver's argument, at depths 1 to 3, over f64 lists: each nested call takes
// its own stash, so each prints what its hoisted twin prints (D17381).
function L(xs: f64[]) { return xs }
function I(xs: i32[]) { return xs }
function pick(k: i32) { return ls[k] }
const b = [5.5, 6.5, 7.5]
const f = [8.5, 9.5]
const ls = [b, f]
const c = [2, 1, 0]
const e = [1, 0]
const i = 1
print(L(b).get(1) ?? -1.0)
print(L(b).get(I(c).get(1) ?? 0) ?? -1.0)
print(L(b).get(I(c).get(I(e).get(0) ?? 0) ?? 0) ?? -1.0)
print(b.get(I(c).get(1) ?? 0) ?? -1.0)
print(L(b).get(9) ?? (L(f).get(i) ?? -1.0))
print(L(b).get(9) ?? (L(f).get(9) ?? (L(b).get(I(e).get(0) ?? 0) ?? -1.0)))
print(L(pick(I(c).get(1) ?? 0)).get(1) ?? -1.0)
print(L(pick(I(c).get(I(e).get(0) ?? 0) ?? 0)).get(0) ?? -1.0)
