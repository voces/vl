// @run
// @log 5
// @log 4
// @log 4
// @log 4
// A binding holding a call counts as the build it holds: `a` is `mk()` built at `J`, so the
// list it is stored into is a `J[]`, whether as an element or by index (D14518).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const a = mk()
const xs = [a]
print(xs[0].f + 1)
const ys = [{ f: 1 }]
ys[0] = mk()
print(ys[0].f ?? 0)
print(xs[0].f ?? 0)
print(wideJ.f ?? 0)
