// @error a list literal mixing a `u8[]` spread with other elements has no element type, since `u8` is only an element type; annotate the destination, e.g. `const c: u8[] = [...bs, 9]`
// A `null` element mixes as any other does: the join is `u8 | null`, and `u8` is a storage
// type, so that element is no value type either. Without this the literal passed check and the
// emitter could not box the elements (D16391).
const bs: u8[] = [1, 2, 3]
const c = [...bs, null]
print(c.length)
