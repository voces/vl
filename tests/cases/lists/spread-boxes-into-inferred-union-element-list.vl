// @run
// @log true
// @log 2
// @log 4
// @log nul
// @log s
// @log 6
// @log k
// @hint redundant type annotation: `a` is inferred as `boolean[]`
// @hint redundant type annotation: `ints` is inferred as `i32[]`
// @hint redundant type annotation: `cs` is inferred as `{r: i32}[]`
// @hint redundant type annotation: `d` is inferred as `{t: string}`
// D2868: an un-annotated spread literal typed a list of a union element (`[...bools, 2]` is
// `(boolean | i32)[]`) builds at that union's box row, each source element boxed under its own
// arm: a scalar source, a nullable join and a record source.
const a: boolean[] = [true]
const q = [...a, 2]
const q0 = q[0]
if q0 is boolean { print(q0) }
const q1 = q[1]
if q1 is i32 { print(q1) }
const ints: i32[] = [3, 4]
const n = [...ints, null]
const n1 = n[1]
if n1 != null { print(n1) }
if n[2] == null { print("nul") }
const s = [...ints, "s"]
const s2 = s[2]
if s2 is string { print(s2) }
type C = { r: i32 }
type D = { t: string }
const cs: C[] = [{ r: 6 }]
const d: D = { t: "k" }
const u = [...cs, d]
const u0 = u[0]
if u0 is C { print(u0.r) }
const u1 = u[1]
if u1 is D { print(u1.t) }
