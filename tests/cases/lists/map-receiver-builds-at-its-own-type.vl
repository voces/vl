// @run
// @log s
// @log 4
// @log s
// D3149: a `.map` returned straight from a function whose result is a union list builds its
// receiver at the receiver's own type; the result's list seed is for the mapped elements.
type U = string | f64
function g(x: string): (string | f64)[] {
  return [x].map((e): string | f64 => e)
}
print(g("s")[0])
function f(x: i32): (i32 | f64)[] { return [x].map((e): i32 | f64 => e) }
print(f(4)[0])
function d(x: string): U[] { return [x].map((e): U => e) }
print(d("s")[0])
