// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 9
// @log 6
// @log 9
// @log 8
// A `.get` that stages its receiver or index, with a staging `.get` nested in its index, its
// default and its receiver's argument, at depths 1 to 3, over record lists: each nested call takes
// its own stash, so each prints what its hoisted twin prints (D17381).
type R = { x: i32 }
function L(xs: R[]) { return xs }
function I(xs: i32[]) { return xs }
function pick(k: i32) { return ls[k] }
const b: R[] = [{ x: 5 }, { x: 6 }, { x: 7 }]
const f: R[] = [{ x: 8 }, { x: 9 }]
const ls = [b, f]
const c = [2, 1, 0]
const e = [1, 0]
const i = 1
print(L(b).get(1)?.x ?? -1)
print(L(b).get(I(c).get(1) ?? 0)?.x ?? -1)
print(L(b).get(I(c).get(I(e).get(0) ?? 0) ?? 0)?.x ?? -1)
print(b.get(I(c).get(1) ?? 0)?.x ?? -1)
print(L(b).get(9)?.x ?? (L(f).get(i)?.x ?? -1))
print(
  L(b).get(9)?.x ?? (L(f).get(9)?.x ?? (L(b).get(I(e).get(0) ?? 0)?.x ?? -1)),
)
print(L(pick(I(c).get(1) ?? 0)).get(1)?.x ?? -1)
print(L(pick(I(c).get(I(e).get(0) ?? 0) ?? 0)).get(0)?.x ?? -1)
