// @run
// @log 8
// @log 14
// @log 30
// @log 2
// A `[]` the pushes after it fill at a known count is reserved in the start body too: one row
// per top-level position such a binding is written in.
type P = { a: i32, b: i32 }
// directly at top level
const xs: i32[] = []
for i in 0 until 8 { xs.push(i * 2) }
print(xs.length)
print(xs[7])
// in a top-level loop's body, rebuilt each turn
let t = 0
for r in 0 until 3 {
  const ys: P[] = []
  for i in 0 until 4 { ys.push({ a: i, b: r }) }
  for y in ys { t = t + y.a + y.b }
}
print(t)
// in a bare block
{
  const zs: f64[] = []
  for i in 0 until 5 { zs.push(i as f64 * 0.5) }
  print(zs[4])
}
