// @run
// @log 2
// @log 3
// @log 2.5
// @log 2
// @log 3
// @log 3
// @log 2
// @log 2
// @log 8
// List `+` at each list rep: i32, string, f64, record and packed byte lists, a chain, a narrowed
// nullable operand, an i32 list widened into an f64 list's concat, and a doubling loop.
type P = { x: i32 }
function ci(a: i32[], b: i32[]) { return a + b }
function cs(a: string[], b: string[]) { return a + b }
function cf(a: f64[], b: f64[]) { return a + b }
function cr(a: P[], b: P[]) { return a + b }
function cu(a: u8[], b: u8[]) { return a + b }
function c3(a: i32[], b: i32[], c: i32[]) { return a + b + c }
function cn(a: i32[] | null, b: i32[]) {
  if a == null { return b }
  return a + b
}
function cw(a: i32[], b: f64[]) { return b + a }
function filled(n: i32, v: i32) {
  let a = [v]
  while a.length < n { a = a + a }
  return a
}
print(ci([1], [2]).length)
print(cs(["a"], ["b", "c"]).length)
print(cf([1.5], [2.5])[1])
print(cr([{ x: 1 }], [{ x: 2 }])[1].x)
const u1: u8[] = [1, 2]
const u2: u8[] = [3]
print(cu(u1, u2).length)
print(c3([1], [2], [3]).length)
print(cn([1], [2]).length)
print(cw([1], [2.5]).length)
print(filled(5, 7).length)
