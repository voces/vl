// @run
// @log 42
// @log 42
// @log 42
// @log 42
// @log hi
// @log 42
// @log 42
// @log 42
// @log 42
// @hint redundant type annotation: `e8` is inferred as `({n: i32} | null)[]` — remove it to lean on inference

// D1831 — a LATER `null` element makes the row the nullable-ref NICHE, and the niche bit is
// read off the element NAME. The inferred literal and the annotated `(P | null)[]` must key
// ONE slot, or only the annotated spelling gets the niche.

// NOTHING here may annotate the un-annotated bindings: the annotation registers the niche
// through its own channel and rescues them, which is what kept this row invisible.

type P = { n: i32 }

// The row's own witness, un-annotated.
const e1 = [{ n: 42 }, null]
const v1 = e1[0]
if v1 != null { print(v1.n) } else { print(0) }

// The `is P` guard form, the second consumer of the same read.
const e2 = [{ n: 42 }, null]
const v2 = e2[0]
if v2 is P { print(v2.n) } else { print(0) }

// `.get` beside the subscript: the two reads must key one slot.
const e3 = [{ n: 42 }, null]
const v3 = e3.get(0)
if v3 != null { print(v3.n) } else { print(0) }

// `null` FIRST — `arrLitIsRef` probes the first element, so this order takes another path.
const e4 = [null, { n: 42 }]
const v4 = e4[1]
if v4 != null { print(v4.n) } else { print(0) }

// A struct with a REF field, and one with two scalars.
type Q = { s: string }

const e5 = [{ s: "hi" }, null]
const v5 = e5[0]
if v5 != null { print(v5.s) } else { print("no") }

type R = { a: i32, b: i32 }

const e6 = [{ a: 1, b: 41 }, null]
const v6 = e6[0]
if v6 != null { print(v6.a + v6.b) } else { print(0) }

// Inside a FUNCTION body rather than at module scope.
function go() {
  const e = [{ n: 42 }, null]
  const v = e[0]
  if v != null { print(v.n) } else { print(0) }
}

go()

// The two boundaries the new arm must keep declining: a literal with NO null element keeps
// its non-null row, and the ANNOTATED spelling keys the same one slot it always did.
const e7 = [{ n: 42 }]
const v7 = e7[0]
print(v7.n)

const e8: (P | null)[] = [{ n: 42 }, null]
const v8 = e8[0]
if v8 != null { print(v8.n) } else { print(0) }
