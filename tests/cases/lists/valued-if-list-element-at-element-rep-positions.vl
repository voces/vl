// @run
// @log 2.5
// @log 5.5
// @log 7
// A valued `if` whose arms are a list of un-annotated-function records, as an element of a list
// delivered at an annotated element type: alone, before another element, and after one. Its out
// is held, and typed, at the element's rep.
function id1(a) { return a }
const inner = [{ f: id1, n: 3 }]
function one(k: i32): { f: (a: f64) => f64, n: i32 }[][] {
  return [if k > 0 { inner } else { inner }]
}
function lead(k: i32): { f: (a: f64) => f64, n: i32 }[][] {
  return [if k > 0 { inner } else { inner }, inner]
}
function trail(k: i32): { f: (a: f64) => f64, n: i32 }[][] {
  return [inner, if k > 0 { inner } else { inner }]
}
print(one(1)[0][0].f(2.5))
print(lead(1)[1][0].f(2.5) + lead(0)[0][0].n)
print(trail(1)[1][0].f(4.0) + trail(0)[0][0].n)
