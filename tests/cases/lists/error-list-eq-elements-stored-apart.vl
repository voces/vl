// @check
// @error `==` over (i32 | null)[] and i32[] has no lowering: the two are mutually assignable but store their elements differently
// @error `==` over (f64 | null)[] and f64[] has no lowering: the two are mutually assignable but store their elements differently
// @error `==` over (P | null)[] and P[] has no lowering: the two are mutually assignable but store their elements differently
// @error `==` over (i32 | null)[] and (f64 | null)[] has no lowering: the two are mutually assignable but store their elements differently
// @error `==` over f64[] and f32[] has no lowering: the two are mutually assignable but store their elements differently
// @error `==` over (f32 | null)[] has no lowering
// CONTRACT (must-error): two lists whose leaf elements are stored apart (another scalar width, or
// a nullable element beside a plain one) have no one compare core, so the check refuses them
// rather than the emitter (D15055, D15056).
type P = { x: i32 }
const a: (i32 | null)[] = [1]
const b: i32[] = [1]
print(a == b)
const f: (f64 | null)[] = [1.5]
const g: f64[] = [1.5]
print(f == g)
const p: (P | null)[] = [{ x: 1 }]
const q: P[] = [{ x: 1 }]
print(p == q)
const h: (f64 | null)[] = [1.5]
print(a == h)
const w: f32[] = [1.5 as f32]
print(g == w)
const k: (f32 | null)[] = [1.5 as f32, null]
print(k == k)
