// @check
// @error cannot compare i64[] with f64[]
// @error `==` over i64[] and f64[] has no lowering: the two are mutually assignable but store their elements differently
// @error `==` over i32[] and f64[] has no lowering: a list literal beside a list whose elements are stored apart
// CONTRACT (must-error): two lists stored apart compare across their storages (D15055, D15092);
// a lossy number pair is refused as the plain pair is (D15090), and a list literal beside a list
// stored apart is built at its own element type (D15091).
const c: i64[] = [1]
const d: f64[] = [1.0]
print(c == d)
print([1, 2] == d)
