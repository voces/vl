// @check
// @error cannot compare i64[] with f64[]
// @error `==` over i64[] and f64[] has no lowering: the two are mutually assignable but store their elements differently
// @error cannot compare f32[] with i32[]
// @error `==` over f32[] and i32[] has no lowering
// @error cannot compare (i64 | null)[] with (f64 | null)[]
// @error `==` over (i64 | null)[] and (f64 | null)[] has no lowering
// CONTRACT (must-error): a lossy number pair is refused as the plain pair is (D15090), and a
// list literal beside such a list is too, at the literal's own element type when it does not
// fit the other list's, as `f32 == 1` is (D15091).
const c: i64[] = [1]
const d: f64[] = [1.0]
const e: f32[] = [1.0 as f32]
const n: (i64 | null)[] = [1, null]
print(c == d)
print(c == [1.0])
print(e == [1, 2])
print(n == [1.0, null])
