// @run
// @log b
// @log -
// `xs.get(i)` over a string list, its `T | null` delivered at nested-arg: an index in range, then
// one past the end (Q58 position sweep).
function show(g: string | null) { print(g ?? "-") }
function pass(g: string | null) { return g }
function go(i: i32) {
  const xs = ["a", "b"]
  show(pass(xs.get(i)))
}
go(1)
go(2)
