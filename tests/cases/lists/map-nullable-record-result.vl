// @run
// @log null
// @log 7
// @log true
// @log false
// @log null
// @log 7
// @log 1
// @log 7
// @log null
// @log 7
// @log null
// @log 7
// @log null
// @log 2
// @log null
// @log 7
// D10890: a `.map` whose callback returns a nullable record keeps the `| null` in its result's
// elements, un-annotated and annotated, read in a loop, by index, filtered and sliced, returned
// from a function and passed as an argument, and from a callback that builds the null.
type P = { x: i32 }
const a: P | null = null
const b: P | null = { x: 7 }
const m = [a, b].map((e) => e)
for y in m { print(y?.x) }
print(m[0] == null)
print(m[1] == null)
const n: (P | null)[] = [a, b].map((e) => e)
for y in n { print(y?.x) }
print(m.filter((e) => e != null).length)
for y in m.slice(1, 2) { print(y?.x) }
function mk() { return [a, b].map((e) => e) }
for y in mk() { print(y?.x) }
function use(xs: (P | null)[]) {
  for y in xs { print(y?.x) }
}
use([a, b].map((e) => e))
const l: P[] = [{ x: 1 }, { x: 2 }]
for y in l.map((e) => if e.x > 1 { e } else { null }) { print(y?.x) }
const f = (e: P | null): P | null => e
for y in [a, b].map(f) { print(y?.x) }
