// @trap
// Writes before the failing index land and stay: the list is printed whole first by a
// second name, then the loop writes until index 3 of a 3-element list traps.
const xs = [0, 0, 0]
const ys = xs
for c in 0 until 2 { xs[c] = c + 1 }
print(ys[0] + ys[1] + ys[2])
for c in 0 until 4 {
  xs[c] = 9
  print(ys[c])
}
print("unreached")
