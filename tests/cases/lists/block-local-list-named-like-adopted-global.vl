// @run
// @log 9
// @log 7
// @log 5
// @log 1
// A block-local list at the top level named like a global list the checker adopted at another
// type keeps its own literal's type: adoption is per binding, never per name (D2923).
type I = { f: i64 | null }
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function show(r: { f: i32 }) { print(r.f) }
function showR(r: { r: i32 }) { print(r.r) }
const il = [{ f: 7 }]
const ic: I[] = il
if true {
  const il = [{ f: 9 }]
  show(il[0])
}
print(ic[0].f)
const cl = [{ r: 7 }]
const cs: Shape[] = cl
if true {
  const cl = [{ r: 5 }]
  showR(cl[0])
}
print(cs.length)
