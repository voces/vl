// `xs.pop()` IN VALUE POSITION IS `T | null` AT EVERY NUMERIC LIST REP (D1140 / D1174).
//
// The checker types `.pop()` `mkNullableTy(rt.aElem)`; `emitPop` pushed the RAW scalar. A
// `boolean[]` rides the i32 sentinel `2` and a `string[]` a `ref.null`, which is why exactly
// those two reps worked — i32 / i64 / f64 / f32 have no spare bit pattern for absence, so
// their `T | null` is the shared `{tag, anyref}` BOX, and that box is what this file grades.
// The gap wore two disguises: check-clean INVALID WASM wherever the destination pinned the
// box (`return`, an argument, a `T | null` binding) and the loud `narrowed union atom has no
// value box` where nothing else in the program named the union, so its box types were never
// interned at all.
//
// THE STATEMENT FORM IS THE CONTROL and it must keep its raw lowering: it drops the value, so
// boxing there would allocate once per discarded pop. It is graded first, on the mutation.
//
// THE EMPTY LIST IS THE CELL THAT GRADES THE NULL ARM. A fixture that only pops a non-empty
// list scores identically if the `len != 0` test were dropped, so every rep pops past the end.
//
// `xs.pop() ?? d` IS HERE FOR ITS OWN REASON: the fused `emitPopOr` reads the i32 wrapper and
// backing unconditionally, and its gate excluded ref / string / f64 by hand — so `i64[]`,
// `f32[]` and `u8[]` were admitted into a lowering that read their wrapper through the i32
// heap type. It is gated on `scalarListElemKind == "i32"` now, and the other reps take the
// generic `??` over the box.
// @run
// @log 2
// @log 1
// @log 5
// @log 1
// @log null
// @log 2.5
// @log null
// @log 5
// @log null
// @log 2.5
// @log null
// @log 5
// @log 2.5
// @log 2.5
// @log 7
// @log 5
// @log 2.5
// @log false
// @log null
// @log bb
// @log aa

// THE STATEMENT FORM: the value is discarded and the list still shrinks.
const st = [1, 5, 9]
st.pop()
print(st.length)
print(st[0])

// i32 — the popped value, then the empty pop's `null`.
const a = [1, 5]
print(a.pop())
print(a.pop() ?? 0)
const ae: i32[] = []
print(ae.pop())

// f64
const b = [1.5, 2.5]
print(b.pop())
const be: f64[] = []
print(be.pop())

// i64
const c: i64[] = [1, 5]
print(c.pop())
const ce: i64[] = []
print(ce.pop())

// f32
const d: f32[] = [1.5, 2.5]
print(d.pop())
const de: f32[] = []
print(de.pop())

// THE `??` FUSION AND ITS FALLBACK, one per rep: i32 keeps `emitPopOr`, the other three take
// the generic `??` over the box, and the empty case takes the default.
const e2: i64[] = [1, 5]
print(e2.pop() ?? 0)
const f2: f32[] = [1.5, 2.5]
print(f2.pop() ?? 0.0)
const g2 = [1.5, 2.5]
print(g2.pop() ?? 0.0)
const h2: i64[] = []
print(h2.pop() ?? 7)

// RETURN in value position — D1174's own witness, un-annotated so inference pins the rep.
function realPopValue() {
  const xs = [1, 5]
  return xs.pop()
}
print(realPopValue())

// ARGUMENT and an inferred binding NARROWED, the two remaining deliveries.
function twice(v: f64 | null) {
  if v == null { return 0.0 }
  v * 2.0
}
const i2 = [1.25]
print(twice(i2.pop()))

// THE TWO REPS THAT ALWAYS WORKED keep their niches: boolean the i32 sentinel, string the
// nullable ref.
const j2 = [true, false]
print(j2.pop())
const je: boolean[] = []
print(je.pop())
const k2 = ["aa", "bb"]
print(k2.pop())
print(k2.pop())
