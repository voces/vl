// @run
// @log rename 4 4 2
// @log concat 6 4
// @log str-concat 3 y
// @log struct-concat 3 3
// @log slice 2 4
// @log map 3 40
// @log filter 2 4
// @log keys k values 7
// @log closure-call 3 4
// @log eq true false
// @log push 2 2
// @log pop 2
// @log coalesce-call 7
// @log generic-call 3 5 b
// @log function 2
// @log generic 5 b
// @log rest-arg 4 1
// @log literal-callback b
// @hint redundant type annotation: `pb` is inferred as `{x: i32}[]`
// @hint redundant type annotation: `pcat` is inferred as `{x: i32}[]`
// @hint redundant type annotation: `h` is inferred as `{xs: i32[]}`
// @hint redundant type annotation: `inFn` is inferred as `i32[]`
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// A spread's source is an operand every pre-pass walks: the module merge renames the name
// it reads, the frame scans reserve what it lowers through, closures in it are lifted and
// generic calls in it are pinned, in a list literal and at a call's rest argument (D2334).
type P = { x: i32 }
type H = { xs: i32[] }
const b = [3, 4]
const m: {[string]: i32} = Map()
m["k"] = 7
function rest(...xs: i32[]) { return xs.length }
function dup<T>(x: T): T[] { return [x, x] }
function opt(n: i32): i32 | null {
  if n > 0 { return n }
  null
}
const g = (n: i32): i32[] => [n, n]
const renamed = [0, ...[9, ...b]]
print("rename \{renamed.length} \{renamed[3]} \{rest(...b)}")
const cat = [1, ...(b + b), 9]
print("concat \{cat.length} \{cat[4]}")
const scat = ["a", ...(["x"] + ["y"])]
print("str-concat \{scat.length} \{scat[2]}")
const pb: P[] = [{ x: 3 }]
const pcat: P[] = [{ x: 1 }, ...(pb + pb)]
print("struct-concat \{pcat.length} \{pcat[2].x}")
const sl = [1, ...b.slice(1)]
print("slice \{sl.length} \{sl[1]}")
const mp = [1, ...b.map((x) => x * 10)]
print("map \{mp.length} \{mp[2]}")
const fl = [1, ...b.filter((x) => x > 3)]
print("filter \{fl.length} \{fl[1]}")
const ks = ["a", ...m.keys()]
const vs = [1, ...m.values()]
print("keys \{ks[1]} values \{vs[1]}")
const cc = [1, ...g(4)]
print("closure-call \{cc.length} \{cc[2]}")
const eq = [true, ...[b == [3, 4], b != [3, 4]]]
print("eq \{eq[1]} \{eq[2]}")
const ys = [0]
const pushed = [...[ys.push(5)]]
print("push \{pushed[0]} \{ys.length}")
const h: H = { xs: [1, 2] }
const popped = [...[h.xs.pop() ?? 0]]
print("pop \{popped[0]}")
const co = [0, ...[opt(0) ?? 7]]
print("coalesce-call \{co[1]}")
const dd = [0, ...dup(5)]
const ds = ["a", ...dup("b")]
print("generic-call \{dd.length} \{dd[2]} \{ds[2]}")
function inFn(p: i32[]): i32[] { return [0, ...(p + p.slice(1))] }
print("function \{inFn([1, 2])[3]}")
function gen<T>(p: T[]): T[] {
  return [...(p + p.slice(1)), ...p.filter((_x) => true)]
}
print("generic \{gen([1, 2]).length} \{gen(["a", "b"])[2]}")
print("rest-arg \{rest(...(b + b))} \{rest(...b.slice(1))}")
function wrap<T>(p: T[]): T[][] { return [p.filter((_x) => true)] }
print("literal-callback \{wrap(["a", "b"])[0][1]}")
