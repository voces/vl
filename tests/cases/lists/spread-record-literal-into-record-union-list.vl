// @run
// @log 1
// @log x
// @log 2
// @log 3
// @log a
// @log 4
// @log b
// @log 5
// @log 6
// @log y
// @log 7
// @log -1
// @log 2
// A list literal of records spread inside a list literal of a record union is built at the
// union's row, as its plain elements are (D16702).
type A = { n: i32 }
type B = { s: string }
const u: (string | A)[] = [...[{ n: 1 }], "x", ...[{ n: 2 }, { n: 3 }]]
for e in u {
  if e is string { print(e) } else { print(e.n) }
}
const w: (A | B)[] = [{ s: "a" }, ...[{ n: 4 }], ...[{ s: "b" }]]
for e in w {
  if e is A { print(e.n) } else { print(e.s) }
}
const p: (string | A)[] = []
p.push({ n: 5 }, ...[{ n: 6 }], ...["y"])
for e in p {
  if e is string { print(e) } else { print(e.n) }
}
const q: (A | null)[] = [...[{ n: 7 }], null]
for e in q { print(e?.n ?? -1) }
function f(xs: (string | A)[]) { return xs.length }
print(f([...[{ n: 1 }], ...["z"]]))
