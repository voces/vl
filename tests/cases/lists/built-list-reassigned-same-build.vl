// binding whose initialiser holds the same build converts nothing (D16763).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
function la() {
  let v = src
  v = src
  print(v[0].f)
  let w = src.filter((y) => y.f == null)
  w = src.filter((y) => y.f == null)
  print(w[0].f)
}
la()
