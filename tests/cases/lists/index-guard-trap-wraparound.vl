// @trap
// `o + c + 1` is i32 arithmetic, which wraps: at `o = 2 * 2147483647` (-2) it reads elements
// 0 and 1, and at `o = 2147483647` it is negative at once, which traps.
function run(xs: i32[], o: i32, w: i32) {
  for c in 0 until w {
    print(c)
    print(xs[o + c + 1])
  }
}
function twice(n: i32) { n + n }
const top = 2147483647
run([7, 8], twice(top) + 1, 2)
run([7, 8], top, 1)
print("unreached")
