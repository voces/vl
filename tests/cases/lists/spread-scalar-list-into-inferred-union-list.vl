// @run
// @log 1.5
// @log s
// @log a
// @log 2
// @log 7
// @log t
// @log 1.5
// @log 2
// An un-annotated list literal spreading a scalar or string list beside another member's value is
// typed a list of their union, and each spread element is boxed into it: no source kind decides
// the list's storage (D2969).
function run(fs: f64[], ss: string[], ls: i64[]) {
  const a = [...fs, "s"]
  for x in a { print(x) }
  const b = [...ss, 2]
  for x in b { print(x) }
  const c = [...ls, "t", ...fs]
  for x in c { print(x) }
  print([...fs, "s"].length)
}
run([1.5], ["a"], [7])
