// @run
// @log x
// @log 3
// @log y
// @log 3
// @log r
// @log 3
// @log 3
// @log f
// @log 3
// @log p
// @log 3
// @log 4
// A scalar list spread into a list of a union element: each element is boxed at the union's row
// (`emitArrSpreadBoxed`). Q58 sweep of the boxing spread: a binding, a list and a union argument, a
// nested argument, a return, an `if` arm, a `??` operand, a record field, an outer literal's
// element, a `push` argument, an index write and a closure capture, each read back as a member.

import { toString } from "std:fmt"

type U = i32 | string

function show(u: U) { return if u is i32 { toString(u) } else { u } }
function last(us: U[]) { return show(us[us.length - 1]) }
function lastOr(us: U[] | boolean) {
  return if us is boolean { "b" } else { last(us) }
}
function pass(us: U[]): U[] { return us }

function pLet(a: i32[]) {
  const us: U[] = [...a, "x"]
  print(last(us))
}
function pArg(a: i32[]) { print(last([...a])) }
function pUnion(a: i32[]) { print(lastOr([...a, "y"])) }
function pNested(a: i32[]) { print(last(pass([...a]))) }
function pRet(a: i32[]): U[] { return [...a, "r"] }
function pIf(a: i32[], c: boolean) {
  const e: U[] = []
  const us: U[] = if c { [...a] } else { e }
  print(last(us))
}
function pCoal(a: i32[], o: U[] | null) {
  const us = o ?? [...a]
  print(last(us))
}
type R = { us: U[] }
function pField(a: i32[]) {
  const r: R = { us: [...a, "f"] }
  print(last(r.us))
}
function pOuter(a: i32[]) {
  const uss: U[][] = [[...a]]
  print(last(uss[0]))
}
function pPush(a: i32[]) {
  const uss: U[][] = []
  uss.push([...a, "p"])
  print(last(uss[0]))
}
function pIndex(a: i32[]) {
  const uss: U[][] = [[]]
  uss[0] = [...a]
  print(last(uss[0]))
}
function pCapture(a: i32[]) {
  const f = () => [...a, "c"]
  const us = f()
  print(us.length)
}

const a = [1, 2, 3]
pLet(a)
pArg(a)
pUnion(a)
pNested(a)
print(last(pRet(a)))
pIf(a, true)
pCoal(a, null)
pField(a)
pOuter(a)
pPush(a)
pIndex(a)
pCapture(a)
