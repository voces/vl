// @run
// @log i
// @log 1
// @log arm
// @log false
// @log true
// D14085: a `match` joining an `i32[]` and a literal-union list registers that union as an `if`
// join does, so each arm boxes under its own tag and `is` tells them apart. No other spelling of
// the union is in this file, since any one of them would register it for the `match` too.
type K = "a" | "b"
function h(a0: i32[], a1: K[], k: i32) {
  const r = match k {
    0 => a0
    _ => a1
  }
  if r is K[] { print(r.length) } else { print("i") }
}
h([1, 2], ["a"], 0)
h([1, 2], ["a"], 1)
type L = "x" | "y"
function g(a0: i32[], a1: L[], k: i32) {
  const s = match k {
    0 => {
      print("arm")
      a0
    }
    _ => a1
  }
  print(s is L[])
}
g([1, 2], ["x"], 0)
g([1, 2], ["x"], 1)
