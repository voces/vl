// @run
// @log null
// @log null
// @log null
// @log null
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A binding of a loop variable over `src`, whose records are stored at `J`, is laid out at `J`
// as the loop's local is, so handing it to `show` needs no conversion (D16787).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
function show(z: { f: null }) { print(z.f) }
for y in src {
  const z = y
  show(z)
  let w = z
  show(w)
  print(z.f)
}
function go() {
  for y in src {
    const z = y
    show(z)
  }
}
go()
