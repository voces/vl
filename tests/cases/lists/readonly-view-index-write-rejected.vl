// @error index assignment writes the list
// CONTRACT (must-error): an index write replaces a cell of the list itself, so a view
// refuses it — the second of the four write shapes, and the one that reaches the checker
// through the assignment target rather than through a method name.
//
// A VERDICT pin: the program must not type-check, so there is no run to compare against.
type Circle = { r: i32 }
function set0(xs: readonly Circle[]) { xs[0] = { r: 1 } }
function f() {
  const a: Circle[] = [{ r: 2 }]
  set0(a)
  print(a[0].r)
}
f()
