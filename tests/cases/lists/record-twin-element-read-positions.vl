// Q58 position sweep: an element of a list of records of hole functions read at the record its
// reader names, the same struct on one heap, as a scalar and a union call argument, a nested call
// argument, a concat operand, an interpolation hole, a return, a let initializer, an if arm, a
// `??` operand and a record field.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk() { return { a: [{ f: inc0 }, { f: dbl }] } }
function takeI(x: i32) { print(x) }
function takeU(x: i32 | string) {
  if x is string { print(x) } else { print(x + 100) }
}
function neg(x: i32) { return 0 - x }
function show(x: i32) { return "\{x}" }
function ret() { return 15 }
function maybe(k: i32): i32 | null { return if k > 0 { k } else { null } }
const b = [1].length > 0
takeI(mk().a[1].f(3))
takeU(mk().a[0].f(3))
takeI(neg(mk().a[1].f(4)))
print("s" + show(mk().a[0].f(6)))
print("i=\{mk().a[1].f(7)}")
print(ret())
const l = mk().a[0].f(8)
print(l)
print(if b { mk().a[1].f(9) } else { 0 })
print(maybe(0) ?? mk().a[0].f(10))
const r = { v: mk().a[1].f(11) }
print(r.v)
