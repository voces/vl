// @run
// @log 42
// @log 42
// @log 42
// @log 42
// @log hi
// @log 42
// @log 42
// @log 42
// @log 42
// @hint redundant type annotation: `e8` is inferred as `({n: i32} | null)[][]` — remove it to lean on inference

// D1884 — the OUTER literal's element is an inner list whose own element is a nullable ref.
// `tyToEmitName` renders that element structurally, and every reader resolves its struct row
// through `structIndexByName`, which answers only for a declared name — so the structural key
// leaves the element row unfindable and the cell reaches `fbValtype` with no slot.

// NOTHING here may annotate the un-annotated bindings: the annotation registers the nominal
// row through its own channel and rescues them, as the D1831 fixtures record.

type P = { n: i32 }

// The row's own witness: two levels, un-annotated.
const e1 = [[{ n: 42 }, null]]
const i1 = e1[0]
const v1 = i1[0]
if v1 != null { print(v1.n) } else { print(0) }

// THREE levels — the nominalisation recurses, so this needs no second rung.
const e2 = [[[{ n: 42 }, null]]]
const a2 = e2[0]
const b2 = a2[0]
const v2 = b2[0]
if v2 != null { print(v2.n) } else { print(0) }

// `.get` through both levels, and mixed with the subscript.
const e3 = [[{ n: 42 }, null]]
const i3 = e3.get(0)
if i3 != null {
  const v3 = i3.get(0)
  if v3 != null { print(v3.n) } else { print(0) }
}

const e4 = [[{ n: 42 }, null]]
const i4 = e4[0]
const v4 = i4.get(0)
if v4 != null { print(v4.n) } else { print(0) }

// A struct with a REF field, nested.
type Q = { s: string }

const e5 = [[{ s: "hi" }, null]]
const i5 = e5[0]
const v5 = i5[0]
if v5 != null { print(v5.s) } else { print("no") }

// The `is P` guard through the nesting.
const e6 = [[{ n: 42 }, null]]
const i6 = e6[0]
const v6 = i6[0]
if v6 is P { print(v6.n) } else { print(0) }

// Inside a FUNCTION body rather than at module scope.
function go() {
  const e = [[{ n: 42 }, null]]
  const i = e[0]
  const v = i[0]
  if v != null { print(v.n) } else { print(0) }
}

go()

// The boundaries the recursion must keep declining: a nested literal with NO null element,
// and the ANNOTATED spelling, which keys the same nominal row it always did.
const e7 = [[{ n: 42 }]]
const i7 = e7[0]
const v7 = i7[0]
print(v7.n)

const e8: ((P | null)[])[] = [[{ n: 42 }, null]]
const i8 = e8[0]
const v8 = i8[0]
if v8 != null { print(v8.n) } else { print(0) }
