// @log 2
// @log 2
// @log 2
// @log 3
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 3
// @log 2
// @log 9
// @log 1
// @log 2
// @log 2
// @log 1
// @log 5
// @log 1
// @log 2
// @log 3
// @log 2
// @log 2
// @log 3
// FACE 1 — the un-annotated INFERRED-RETURN spelling, exactly as filed (D1592). `f`'s tail is
// the push, so the checker infers `f(): i32`; the emitter classified `f` VOID and the caller
// read an empty stack — `vl check` rc 0, `type mismatch: expected i32 but nothing on stack`.
const f1: i32[] = []
function f() { f1.push(1) }
const v = f()
print(v)
print(f1.length)

// FACE 2 — the same value BOUND at its direct spelling, which refused with
// `emitProgram: callee is not a function name` at `vl check` rc 0.
const f2: i32[] = []
const w = f2.push(1)
print(w)

// THE VALUE IS THE NEW LENGTH, not a constant: two pushes in a row read 3 then 4.
const nl = [1, 2]
print(nl.push(3))
print(nl.push(4))
print(nl.length)

// EVERY LIST REP, bound. The value rides the SAME `len` field the append just wrote, so a rep
// whose wrapper is picked wrongly reads back the wrong number rather than passing.
const rI32 = [1]
print(rI32.push(2))
const rI64: i64[] = [1]
print(rI64.push(2))
const rF64 = [1.5]
print(rF64.push(2.5))
const rF32: f32[] = [1.5]
print(rF32.push(2.5))
const rU8 = "ab".bytes()
print(rU8.push(3))
const rStr = ["a"]
print(rStr.push("b"))
const rBool = [true]
print(rBool.push(false))
const rRef = [{ n: 1 }]
print(rRef.push({ n: 2 }))
const rNest = [[1]]
print(rNest.push([2]))

// EVERY RECEIVER SHAPE. A struct FIELD, an INDEX and a module GLOBAL each STAGE the wrapper
// ref in the frame's `recvRef` slot; a bare local is read in place.
const bx = { items: [1] }
print(bx.items.push(2))
const gg = [[1]]
print(gg[0].push(2))

// EVERY DELIVERY POSITION inside a function, over a PARAMETER receiver.
function pBind(xs: i32[]) {
  const n = xs.push(2)
  print(n)
}
pBind([1])

function pRet(xs: i32[]) { return xs.push(2) }
print(pRet([1]))

function pTailInferred(xs: i32[]) { xs.push(2) }
print(pTailInferred([1]))

function pArg(xs: i32[]) { print(xs.push(2)) }
pArg([1])

function pIfArm(xs: i32[], c: boolean) {
  if c { xs.push(2) } else { 99 }
}
print(pIfArm([1], true))

// A REASSIGNED local: the value is delivered TWICE, and `.push` MUTATES, so the second
// answer is 3. This is the shape `matrix.py` cannot express a want for.
function pReassign() {
  const xs = [1]
  let n = xs.push(2)
  print(n)
  n = xs.push(3)
  print(n)
}
pReassign()

// THE STATEMENT FORM still leaves an EMPTY stack — the value is emitted only where a position
// asks for one, so a bare `.push` neither pushes nor drops.
const st = [1]
st.push(2)
print(st.length)

// A VOID TAIL whose result is IGNORED still runs: the function returns `i32` now, and the
// caller's discard drops it.
function pIgnored(xs: i32[]) { xs.push(2) }
pIgnored([1])
print(9)

// A NESTED PUSH — the pushed VALUE is itself a list op, and both receivers are module
// GLOBALS, so both stage into the frame's one `recvRef` slot. The inner op used to overwrite
// the outer's receiver and the append landed on the INNER list: `n1` stayed EMPTY while `n2`
// took both. The outer receiver is now staged AFTER the value.
const n1: i32[] = []
const n2 = [1]
n1.push(n2.push(7))
print(n1.length)
print(n1[0])
print(n2.length)

// THE SAME CLASH ONE OP OVER, which predates the value lowering: a `.pop` with a staged
// receiver inside a `.push` with a staged receiver.
const p1: i32[] = []
const p2 = [4, 5]
p1.push(p2.pop() ?? 0)
print(p1.length)
print(p1[0])
print(p2.length)

// A REF-element push in VALUE position INSIDE A FUNCTION, and inside a nested block. Ref
// frames come from `fnRefPushSlots` keyed by the receiver's ref-list slot, and `fnUsesRefPush`
// is inert in `fbBeginFunc` — so teaching only the kind BITS reserves nothing here, and the
// value-position walk has to record the SLOT too.
function refInFn() {
  const rs = [{ n: 1 }]
  const a = rs.push({ n: 2 })
  print(a)
  if true {
    const b = rs.push({ n: 3 })
    print(b)
  }
  const cs = ["a"]
  print(cs.push("b"))
  const ds = [[1]]
  print(ds.push([2]))
  print(rs[2].n)
}

refInFn()
