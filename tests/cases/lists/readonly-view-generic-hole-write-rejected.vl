// @error the body writes this list
// CONTRACT (must-error): the one position where the view's refusal is NOT the receiver's
// own. An un-annotated type parameter that a body calls `.push` on is re-typed as a freshly
// synthesized MUTABLE list, and nothing re-checks the argument against that synthesis — so
// the write is filed on the hole and the pin refuses a view for it. Read-only uses through
// the same hole (`xs[0]`, `xs.length`) stay legal; only a write demand refuses.
//
// A VERDICT pin: the program must not type-check, so there is no run to compare against.
function grow<T>(xs: T) { xs.push(1) }
const v: readonly i32[] = [1]
grow(v)
print(v.length)
