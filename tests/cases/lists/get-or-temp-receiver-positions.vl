// @run
// @log r
// @log i
// @log 20
// @log r
// @log i
// @log 20
// @log r
// @log i
// @log v=20
// @log r
// @log 2.5
// @log r
// @log 7
// @log r
// @log i
// @log 20
// @log r
// @log i
// @log 21
// @log r
// @log -1
// A fused `xs.get(i) ?? d` whose receiver is a call: evaluated once, before the index, and read
// from its local at each of the head's reads, at each position, element kind and scope.
const li = [10, 20]
const lf = [1.5, 2.5]
function gi() { print("r"); return li }
function gf() { print("r"); return lf }
function L(xs: i32[]) { print("r"); return xs }
function ix() { print("i"); return 1 }
function show(n: i32) { print(n) }
function back() { return gi().get(ix()) ?? -1 }
function positions() {
  const a = gi().get(ix()) ?? -1
  print(a)
  show(gi().get(ix()) ?? -1)
  print("v=\{gi().get(ix()) ?? -1}")
  print(gf().get(1) ?? -1.0)
  print(L(li).get(9) ?? 7)
}
positions()
print(back())
print((L(li).get(ix()) ?? 0) + 1)
print(gi().get(5) ?? -1)
