// @run
// @log 6
// @log 7
// @log -1
// @log 6
// @log 4
// @log 8
// @log 10
// A plain `xs.get(i)` whose index is a fused `??` or a global read, whose receiver is a call or a
// name: each operand is evaluated once, in order, and the `T | null` read is the element or
// `null`, at a `const`, an argument, a record list and a function. The last line counts calls.
type P = { x: i32 }
let calls = 0
function L(xs: i32[]) {
  calls = calls + 1
  return xs
}
function R(xs: P[]) {
  calls = calls + 1
  return xs
}
function orNeg(v: i32 | null) { return if v == null { -1 } else { v } }
const b = [5, 6, 7]
const c = [2, 1, 0]
const e = [1, 2]
const ps: P[] = [{ x: 3 }, { x: 4 }]
const a1 = 1
const g1 = L(b).get(L(c).get(1) ?? 0)
print(g1 ?? -1)
const g2 = b.get(L(e).get(1) ?? 0)
print(g2 ?? -1)
print(orNeg(L(b).get(L(c).get(9) ?? 5)))
const g3 = L(b).get(a1)
print(g3 ?? -1)
const g4 = R(ps).get(L(e).get(0) ?? 0)
print(if g4 == null { -1 } else { g4.x })
function inner() {
  const v = L(c).get(L(e).get(1) ?? 0)
  return (v ?? -1) + 8
}
print(inner())
print(calls)
