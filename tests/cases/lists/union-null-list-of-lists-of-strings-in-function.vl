// @run
// @log 1
// @log a
// @log 1
// @log 2
// @log 2
// A list of lists annotated with a union holding `null`, built from string-only inner literals inside
// a function, mints the inner union list's row before the outer one, as at module scope.
function go() {
  const v: (string | f64 | null)[][] = [["a"]]
  print(v.length)
  const x = v[0][0]
  if x is string { print(x) }
  const w: (string | i32 | null)[][] = [["b", "c"], ["d"]]
  print(w[1].length)
  const u: (string | i64 | null)[][] = [["e"]]
  u[0].push(null)
  print(u[0].length)
  const z: (string | f32 | null)[][] = [["f"]]
  z.push([1.5 as f32])
  print(z.length)
}
go()
