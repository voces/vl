// @run
// @log 1.5
// @log 1.25
// @log 4.5
// @log 0.75
// @log 1.5
// @log 1.5
// @log 3
// @log 2
// @hint redundant type annotation: `a` is inferred as `i32[]`
// @hint redundant type annotation: `b` is inferred as `f64[]`
// @hint redundant type annotation: `t` is inferred as `f64[]`
// D2845: a spread of an `i32[]` or `f32[]` into a list literal typed `f64[]` copies each element
// converting, whether the literal types itself (`[...ints, 2.5]`), a second source makes it
// `f64[]`, or the destination is annotated. `[...ints, 2 as i64]` builds an `i64[]` the same way.
const a: i32[] = [3]
const b: f64[] = [9.0]
const q = [...a, 2.5]
print(q[0] / 2.0)
print(q[1] / 2.0)
const r = [...a, ...b]
print(r[1] / 2.0)
const f: f32[] = [1.5]
const s: f64[] = [...f]
print(s[0] / 2.0)
const t: f64[] = [2.5]
t.push(...a)
print(t[1] / 2.0)
function half(...xs: f64[]) { print(xs[0] / 2.0) }
half(...a)
const u = [...a, 2 as i64]
print(u[0])
print(u[1])
