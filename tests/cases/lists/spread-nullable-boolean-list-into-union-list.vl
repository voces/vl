// @run
// @log 4
// @log true
// @log none
// @log false
// @log 2
// @log true
// @log none
// @log false
// @log s
// @log 4
// @log true
// @log true
// A `(boolean | null)[]` keeps its null as the boolean niche's sentinel; spread into a list of a
// union holding another member, each element is boxed and the sentinel lands as the union's
// null, at a binding, an un-annotated literal and a return (D15044).
function f(ys: (boolean | null)[]): (boolean | null | i32)[] { [...ys, 1] }
function run(xs: (boolean | null)[]) {
  const q: (boolean | null | i32)[] = [...xs, 2]
  print(q.length)
  for x in q { print(x ?? "none") }
  const r: (boolean | null | string)[] = [...xs, "s"]
  for x in r { print(x ?? "none") }
  const u = [...xs, 5]
  print(u.length)
  print(u[1] == null)
  print(f([null])[0] == null)
}
run([true, null, false])
