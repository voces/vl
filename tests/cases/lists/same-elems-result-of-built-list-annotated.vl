// @run
// @log null
// @log null
// @log null
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `w` is inferred as `{g: {f: null}[]}`
// A `filter`, `slice` or identity `map` result holds the receiver's own elements, so the kept
// maker's call inside `src` lands where the result lands: an annotated narrower element type keeps
// `mk2` at its own record and copies `dA`'s call into `J` (D16766, D16767).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const v: { f: null }[] = src.filter((y) => y.f == null)
print(v[0].f)
function d() { return { g: src.slice(0) } }
const w: { g: { f: null }[] } = d()
print(w.g[0].f)
const m: { f: null }[] = src.map((y) => y)
print(m[0].f)
