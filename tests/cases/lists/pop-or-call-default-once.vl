// @run
// @log 9
// @log 0
// @log 1
// @log 5
// @log 1
// @log 1
// @log 9
// @log 0
// @log 2
// A `.pop() ?? d()` whose result is kept nullable, so it is not the element's fused read: the pop
// runs once, and the default's call runs only on an empty list, after the pop (D17382).
let n = 0
function d(): i32 | null {
  n = n + 1
  return 9
}
function go(xs: i32[]) {
  const r = xs.pop() ?? d()
  print(r ?? -1)
  print(xs.length)
  print(n)
}
go([])
go([4, 5])
go([])
