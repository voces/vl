// @run
// @log false
// @log true
// D14085: a `match` joining an `i32[]` and a literal-union list, tested by `is` with no binding,
// still has its union registered, so the `i32[]` arm is not taken for the `K[]` one.
type K = "a" | "b"
function h(a0: i32[], a1: K[], k: i32) {
  print(
    (match k {
      0 => a0
      _ => a1
    }) is K[],
  )
}
h([1, 2], ["a"], 0)
h([1, 2], ["a"], 1)
