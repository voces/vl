// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// A list literal of a maker's records, whose type `{ r: null }` an unused union lays out at a
// declared record's row, handed to a generic: an element read in a closure, in a function, bound,
// as an argument, and the list's length.
import { reverse } from "std:array"

type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
function sink(x: Circle) { return x.r ?? 3 }
function mkcall() {
  const cc = { r: null }
  return cc
}
function outer() {
  const lam = () => {
    const dd = reverse([mkcall()])[0]
    return dd.r ?? 1
  }
  return lam()
}
print(outer())
function inFn() { return reverse([mkcall(), mkcall()])[1].r ?? 2 }
print(inFn())
const bound = reverse([mkcall()])[0]
print(sink(bound))
print(sink(reverse([mkcall()])[0]) + 1)
print(reverse([mkcall(), mkcall(), mkcall(), mkcall(), mkcall()]).length)
