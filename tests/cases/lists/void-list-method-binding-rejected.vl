// @error cannot bind the void result of 'n' — a void function returns no value
// CONTRACT (must-error): the METHODS the checker types `void` still refuse a binding, at the
// same message a void FUNCTION's result gets. D1592 gave `.push` a value lowering because the
// checker types it `i32`; `.clear()` (and the map/Set `.set` / `.add`) are `TY_VOID`, so their
// bound spelling is the control's error and must stay there. The fix is the emitter agreeing
// with the checker at each method, not `.push`'s answer being generalized to the family.
const xs: i32[] = [1]
const n = xs.clear()
print(n)
