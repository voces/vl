// @run
// @log null
// @log 0
// @log -1
// @log 0
// @log b
// @log a
// @log null
// @log 0
// @hint redundant type annotation: `emptyStruct` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `ss` is inferred as `string[]` — remove it to lean on inference
// Every annotation below is kept AGAINST its own hint: each one pins the REP the
// fixture is about, and a hint saying the annotation is redundant is the checker
// agreeing about the TYPE — it says nothing about whether the two spellings agree
// about the rep.
// D1212: `.pop()` on an EMPTY ref- or string-element list answered a TRAP where the type
// says `null`. `emitPop`'s ref/string arm decremented the length and read `backing[len]`
// with no `len != 0` test, so an empty list indexed -1 and `array.get` trapped before the
// `ref.as_non_null` was reached. Every scalar rep already answered `null` there.
//
// THE LENGTH MUST NOT MOVE ON THE EMPTY POP, which is why each cell prints it: the
// decrement lives inside the present arm, so a pop past the end leaves 0 rather than -1.

const es: string[] = []
print(es.pop())
print(es.length)

type S = { v: i32 }
function emptyStruct(): i32 {
  const gs: S[] = []
  const p = gs.pop()
  if p != null { return p.v }
  -1
}
print(emptyStruct())

const el: i32[][] = []
const ev = el.pop()
if ev != null { print(ev.length) } else { print(0) }

const ss: string[] = ["a", "b"]
print(ss.pop())
print(ss.pop())
print(ss.pop())
print(ss.length)
