// @run
// @log 1
// @log 7
// A function with no result annotation whose returned list is a fresh literal builds it at the
// type it flows into, so it delivers into a wider list (D2194).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function relay() { [{ r: 7 }] }
const s: Shape[] = relay()
print(s.length)
const e = s[0]
if e is Circle { print(e.r) }
