// @log t
// @log q
// @log t
// @log s
// The hoisted twin of `list-get-nested-stash-string.vl`: every call bound to a `const` first.
function L(xs: string[]) { return xs }
function I(xs: i32[]) { return xs }
function pick(k: i32) { return ls[k] }
const b = ["p", "q", "r"]
const f = ["s", "t"]
const ls = [b, f]
const c = [2, 1, 0]
const e = [1, 0]
const i = 1
const lb = L(b)
const lf = L(f)
const ic = I(c)
const ie = I(e)
print(lb.get(1) ?? "-")
const a1 = ic.get(1) ?? 0
print(lb.get(a1) ?? "-")
const a2 = ie.get(0) ?? 0
const a3 = ic.get(a2) ?? 0
print(lb.get(a3) ?? "-")
print(b.get(a1) ?? "-")
print(lb.get(9) ?? (lf.get(i) ?? "-"))
print(lb.get(9) ?? (lf.get(9) ?? (lb.get(a2) ?? "-")))
const r1 = L(pick(a1))
print(r1.get(1) ?? "-")
const r2 = L(pick(a3))
print(r2.get(0) ?? "-")
