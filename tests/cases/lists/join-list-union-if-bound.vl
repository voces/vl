// @run
// @log i
// @log 1
// D14085: the bound `if` spelling of the join, whose union row now comes from the same join
// producer as the `match` and unbound spellings rather than from a binding pin of its own.
type K = "a" | "b"
function h(a0: i32[], a1: K[], k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  if r is K[] { print(r.length) } else { print("i") }
}
h([1, 2], ["a"], 0)
h([1, 2], ["a"], 1)
