// A list `.get(i)` whose index is a call, run once and held in a local: alone and under `??`, at a
// `let`, an argument, a return value, an interpolation and a condition, over i32, f64 and string
// lists. Each call of `next` counts once; an index of more than one temp (`next() - 3`) stays a
// named miss.
// @run
// @log 20
// @log 0
// @log 2.5
// @log 1
// @log v=-1
// @log 2
// @log a
// @log 3
// @log big
// @log 4
// @log 10
// @log 5
let n = 0
function next() {
  n = n + 1
  return n
}
function zero() { return 1 }
function show(x: f64) { print(x) }
function bound() {
  const xs = [10, 20]
  const g = xs.get(zero()) ?? -1
  print(g)
  print(n)
}
function argued() {
  const fs = [1.5, 2.5]
  show(fs.get(next()) ?? 0.0)
  print(n)
}
function interp() {
  const xs = [10, 20]
  print("v=\{xs.get(next()) ?? -1}")
  print(n)
}
function plain() {
  const ss = ["a", "b"]
  print(ss.get(next() - 3) ?? "b")
  print(n)
}
function cond() {
  const xs = [10, 20]
  if (xs.get(next()) ?? 0) == 0 { print("big") } else { print("small") }
  print(n)
}
function returned() {
  const xs = [10, 20]
  return xs.get(next() - 5) ?? 20
}
bound()
argued()
interp()
plain()
cond()
print(returned())
print(n)
