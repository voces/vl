// @run
// @log 3
// @log q
// @log q4
// @log q
// @log 3
// @log 0.5
// @log 12
// @log 0.5
// @log 1.75
// @log 21000000005
// @log 5
// @log r
// @log w
// @log 3
// @hint redundant type annotation: `da` is inferred as `(string | f64)[]`
// @hint redundant type annotation: `db` is inferred as `i32[]`
// @hint redundant type annotation: `a2` is inferred as `(Cx | Dx)[]`
// @hint redundant type annotation: `fb` is inferred as `f64[]`
// A list `+` over two reps, one of which the other is assignable to, copies the narrower
// operand into the wider one's rep before concatenating: boxed into a union element, or
// widened element-wise between scalar lists (D4858). Each operand order, both faces.

type Cx = { r: i32 }
type Dx = { s: string }

// un-annotated: the narrower operand on the right, then on the left
const u1 = ["p", 1] + ["q"]
print(u1.length)
const u1e = u1[2]
if u1e is string { print(u1e) }
const ca = ["p", 1]
const cb = ["q"]
const u2 = cb + ca
const u2a = u2[0]
const u2b = u2[2]
if u2a is string && u2b is i32 { print("\{u2a}\{u2b + u2.length}") }
// the copy is a snapshot: a later write to the source does not reach the concat
cb.push("x")
cb[0] = "z"
const u2c = u2[0]
if u2c is string { print(u2c) }
print(u2.length)

// annotated: an `i32[]` widens to the union's `f64` member, a record boxes under its arm
const da: (string | f64)[] = ["a", 1.5]
const db: i32[] = [2]
const a1 = da + db
const a1e = a1[2]
if a1e is f64 { print(a1e / 4.0) }
const ra: (Cx | Dx)[] = [{ r: 1 }, { s: "d" }]
const rb: Cx[] = [{ r: 9 }]
const a2: (Cx | Dx)[] = rb + ra
const a2e = a2[0]
if a2e is Cx { print(a2e.r + a2.length) }

// scalar lists: i32 into f64, f32 into f64, i32 into i64
const s1 = [1.5] + [2]
print(s1[1] / 4.0)
const fa: f32[] = [1.5]
const fb: f64[] = [0.25]
const s2 = fa + fb
print(s2[0] + s2[1])
const ia: i64[] = [5]
const ib = [7]
const s3 = ib + ia
print(s3[0] * 3000000000 + s3[1])

// a chain, a function's parameters, and a lambda
const ch = ca + ["q"] + [3] + ["r"]
print(ch.length)
const che = ch[4]
if che is string { print(che) }
function cat(a: (string | i32)[], b: string[]) { return a + b }
const fc = cat(["p", 1], ["w"])
const fce = fc[2]
if fce is string { print(fce) }
const lam = (s: string[]) => ca + s
print(lam(["v"]).length)
