// @run
// @log bb/bb/zz
// @log true
// @log bb/a
// D2158: a list of an un-named literal union's atoms (a function's `"a" | "bb"` result) spread
// beside a `string` builds a `string[]`, each atom widened to its member string; the same for
// the spread alone into an annotated `string[]`.
import { join } from "std:str"
const Z = "zz"
function kk(): "a" | "bb" { "bb" }
function main() {
  const k = kk()
  const lits = [k, k]
  const sp2 = [...lits, Z]
  print(join(sp2.map((x): string => x), "/"))
  print(lits[0] == "bb")
  const one: "a" | "bb" = "a"
  const sp3: string[] = [...[k], ...[one]]
  print(join(sp3, "/"))
}
main()
