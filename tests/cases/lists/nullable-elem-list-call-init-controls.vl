// @run
// @log 2
// @log 0
// @log 2
// @hint redundant type annotation: `direct` is inferred as `(boolean | null)[]` — remove it to lean on inference
// THE TWO CONTROLS for `soundness/xfail-miscompile-nullable-elem-list-call-init.vl`, a
// check-clean invalid-wasm hole on `const xs: (boolean | null)[] = mk()`.
//
//   · the same ANNOTATION with a direct array-literal init — compiles, runs;
//   · the same CALL init with a non-nullable element type — compiles, runs.
//
// Neither half is broken on its own; the pair is. Both live here, in the PASSING corpus, so the
// xfail's argument cannot quietly stop being true — if either control starts failing, the defect
// is wider than that file claims and it has to be rewritten rather than kept.
const direct: (boolean | null)[] = [true, null]
print(direct.length)
if direct[1] == null { print(0) } else { print(1) }

function mkPlain() {
  return [true, false]
}

const viaCall = mkPlain()
print(viaCall.length)
