// @emit-error a spread whose elements must each be boxed into a union or nullable element has no lowering yet
// D2868: `[...bools, 2]` is typed `(boolean | i32)[]`, so each spread element would be boxed into
// the union, which no copy builds yet. It is refused rather than built as one list of `i32`.
const a: boolean[] = [true]
const q = [...a, 2]
print(q.length)
