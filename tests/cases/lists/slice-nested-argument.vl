// @run
// @log start 3 30
// @log end 3 30
// @log map 3 30
// @log filter 3 30
// @log self 3 20 40
// @log str 2 q
// @log f64 2 2.5
// @log struct 2 2
// @log field 2 30
// @log nullable 2 6
// @log generic 30 q
// @log place 5
// @log concat 4 40
// @hint redundant type annotation: `ps` is inferred as `{x: i32}[]`
// @hint redundant type annotation: `h` is inferred as `{xs: i32[]}`
// A list `.slice` whose bound is itself a slice, `.map` or `.filter` keeps its own receiver
// and bounds: all three are complete before the shared frame is written, at every rep, on a
// field or nullable receiver, in a generic, as an indexed-store place and in a concat (D2332).
type P = { x: i32 }
type H = { xs: i32[] }
const a = [10, 20, 30, 40, 50]
const b = [1, 2, 3]
const s1 = a.slice(b.slice(1, 3)[0])
print("start \{s1.length} \{s1[0]}")
const s2 = a.slice(0, b.slice(2)[0])
print("end \{s2.length} \{s2[2]}")
const s3 = a.slice(b.map((x) => x * 2)[0])
print("map \{s3.length} \{s3[0]}")
const s4 = a.slice(b.filter((x) => x > 1)[0])
print("filter \{s4.length} \{s4[0]}")
const s5 = a.slice(1, a.slice(1, 4).length + 1)
print("self \{s5.length} \{s5[0]} \{s5[2]}")
const ss = ["p", "q", "r", "s"]
const s6 = ss.slice(ss.slice(3).length, 3)
print("str \{s6.length} \{s6[0]}")
const fs = [1.5, 2.5, 3.5]
const s7 = fs.slice(fs.slice(2).length)
print("f64 \{s7.length} \{s7[0]}")
const ps: P[] = [{ x: 1 }, { x: 2 }, { x: 3 }]
const s8 = ps.slice(ps.slice(2).length)
print("struct \{s8.length} \{s8[0].x}")
const h: H = { xs: [10, 20, 30, 40] }
const s9 = h.xs.slice(h.xs.slice(2).length)
print("field \{s9.length} \{s9[0]}")
function mk(n: i32): i32[] | null {
  if n > 0 { return [n, n + 1, n + 2] }
  null
}
const nm = mk(5)
if nm != null {
  const s10 = nm.slice(nm.slice(2).length)
  print("nullable \{s10.length} \{s10[0]}")
}
function sl<T>(p: T[], q: T[]): T[] { return p.slice(q.slice(1).length) }
print("generic \{sl(a, b)[0]} \{sl(ss, ["x", "y"])[0]}")
const xs = [1, 2, 3]
xs[xs.slice(1).length] += xs.slice(xs.slice(2).length)[0]
print("place \{xs[2]}")
const cat = a.slice(3) + (a.slice(4) + a.slice(4))
print("concat \{cat.length} \{cat[0]}")
