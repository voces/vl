// A list read whose index is a valued `if`, the receiver staged below it: at a `let`, an argument,
// a return value, an interpolation and a call through a function list's element, over a local and a
// parameter receiver.
// @run
// @log 20
// @log 10
// @log 30
// @log v=20
// @log 7
// @log 30
function show(n: i32) { print(n) }
function bound(c: boolean) {
  const xs = [10, 20, 30]
  const y = xs[if c { 1 } else { 0 }]
  print(y)
}
function argued(xs: i32[], c: boolean) { show(xs[if c { 1 } else { 0 }]) }
function returned(c: boolean) {
  const gs = [10, 20, 30]
  return gs[if c { 2 } else { 0 }]
}
function interp(c: boolean) {
  const xs = [10, 20, 30]
  print("v=\{xs[if c { 1 } else { 0 }]}")
}
function called(c: boolean) {
  const fs = [(n: i32) => n + 1, (n: i32) => n * 2]
  print(fs[if c { 0 } else { 1 }](6))
}
bound(true)
argued([10, 20, 30], false)
print(returned(true))
interp(true)
called(true)
print(returned(true))
