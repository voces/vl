// @run
// @log <20>
// @log <-1>
// `xs.get(i)` over a record list, its `T | null` delivered at interp: an index in range, then
// one past the end (Q58 position sweep).
type R = { x: i32 }
function fmt(g: R | null) {
  return if g == null { "-1" } else { "\{g.x}" }
}
function go(i: i32) {
  const xs: R[] = [{ x: 10 }, { x: 20 }]
  print("<\{fmt(xs.get(i))}>")
}
go(1)
go(2)
