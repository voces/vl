// @run
// @log 7
// @log 19
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `l` is inferred as `Circle[]`
// @hint redundant type annotation: `cell` is inferred as `i32`
// Regression (silent-class-inventory D50): a `for` loop over an ARM-element list binds a
// VARIANT loop var. No layout twin — `Dot` is absent on purpose, which is what separates
// this from `arm-elem-forin-beside-layout-twin.vl`; this is the floor that file used to
// route around, and it is now the same verdict at both coordinates.
//
// `forInElemKind`'s ref-array ladder answered `"struct"` for every kind-1 element, so
// `declareForInLocals` asked `forInRefArrayStructIdx` — whose nominal floor correctly
// declines an arm (an arm has a `uVariants` row and no `sNames` one, because `collectS`
// SKIPS a `type X = {…}` that is a union member). A -1 struct index for the loop var is
// `emitProgram: field access but no struct type declared`.
//
// The loop var's rep is the CONCRETE-VARIANT local (kind 8, `(ref $(uVarHeap[vi]))`) —
// the same cell `const c: Circle = …` binds one line above, which is the invariant worth
// pinning: one `for` must bind what one index read yields, and reading `l[0].r` OUT of
// the loop ran on master while the loop did not.
//
// THREE LADDERS, ONE ELEMENT KIND. `declareForInLocals` decides the loop var, the `#l`
// TEMP's ref-list slot, and (in `emitForInStmt`) the wrapper/backing pair plus the
// non-null recover — four lists of element kinds that must all learn a new one together.
// Teaching only the first two moved this program from one loud reject to another
// (`ref valtype with no interned shape`), which is why the fixture reads a value.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function mk(i: i32): Circle[] {
  const c: Circle = { r: i }
  const l: Circle[] = [c, { r: i + 5 }]
  return l
}

function cell(): i32 {
  const l = mk(7)
  let t = 0
  for v in l { t = t + v.r }
  return t
}

print(mk(7)[0].r)
print(cell())
