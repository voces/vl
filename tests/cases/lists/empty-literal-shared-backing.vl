// @run
// @log 3 0 0 30
// @log 2 0 7 0
// @log 2.5 0 1.5 0
// @log 9 0 0
// @log ab 0 b
// @log 4 0 6
// @log 1 0 5
// @log -1 0 1
// @log 2 0
// @log 0 0 0 0 0
// @log 18 1
// sunpa SP-043: an empty list literal shares its element type's one zero-length backing, so
// every list here starts on a backing some other list also starts on. Each line grows or
// writes one list and reads its siblings, which a write into the shared backing would change.
import { concat, extend, reverse, sort } from "std:array"

type P = { x: i32, ys: f64[] }

function fresh(): i32[] { [] }

// i32: three empties from one site, and one from a function.
const a: i32[][] = []
for _i in 0 until 3 { a.push([]) }
a[1].push(10)
a[1].push(20)
const f = fresh()
print(
  "\{a.length} \{a[0].length} \{a[2].length} \{a[1][0] + a[1][1] - f.length}",
)

// u8: a push, then an index write inside the new length.
const b0: u8[] = []
const b1: u8[] = []
b0.push(1)
b0.push(2)
b0[0] = 7
print("\{b0.length} \{b1.length} \{b0[0]} \{zeroOf(b1)}")

// f64 and f32 side by side.
const d0: f64[] = []
const d1: f64[] = []
const s0: f32[] = []
d0.push(2.5)
s0.push(1.5 as f32)
print("\{d0[0]} \{d1.length} \{s0[0]} \{d1.length}")

// i64: grown by `extend` and `concat` out of empties.
const l0: i64[] = []
const l1: i64[] = []
extend(l0, [4 as i64, 5 as i64])
const l2 = concat(l1, l0)
print("\{l0[0] + l2[1]} \{l1.length} \{concat(l1, l1).length}")

// string.
const t0: string[] = []
const t1: string[] = []
t0.push("a")
t0.push("b")
print("\{t0[0]}\{t0[1]} \{t1.length} \{t0.pop() ?? "?"}")

// records holding empty lists, and the lists inside them.
const r: P[] = []
r.push({ x: 1, ys: [] })
r.push({ x: 2, ys: [] })
r[0].ys.push(4.0)
r[0].ys.push(2.0)
print(
  "\{r[0].ys[0] as! i32} \{r[1].ys.length} \{r[0].x + r[1].x + r[0].ys.length + r[1].ys.length + 1}",
)

// cleared and refilled, and sorted and reversed while empty.
const c0: i32[] = []
const c1: i32[] = []
sort(c1, (p, q) => p < q)
reverse(c1)
c0.push(3)
c0.clear()
c0.push(1)
print("\{c0.length} \{c1.length} \{c0[0] + 4}")

// nullable elements.
const n0: (i32 | null)[] = []
const n1: (i32 | null)[] = []
n0.push(null)
print("\{n0[0] ?? -1} \{n1.length} \{n0.length}")

// closures.
const g0: ((x: i32) => i32)[] = []
const g1: ((x: i32) => i32)[] = []
g0.push((x) => x + 1)
print("\{g0[0](1)} \{g1.length}")

// every sibling above is still empty.
print("\{a[0].length} \{a[2].length} \{b1.length} \{l1.length} \{t1.length}")

// a loop that builds and drops an empty list every iteration.
let total = 0
let kept = 0
for i in 0 until 6 {
  const xs: i32[] = []
  if i % 2 == 0 { xs.push(i) }
  for x in xs { total += x + 1 }
  total += xs.length * 2
  if i == 5 { kept = xs.length + 1 }
}
print("\{total + 3} \{kept}")

function zeroOf(xs: u8[]) {
  let s = 0
  for x in xs { s += x as i32 + 1 }
  s
}
