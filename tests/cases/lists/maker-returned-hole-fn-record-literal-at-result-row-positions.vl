// @run
// @log 2
// @log 7
// A maker returning a record literal of records holding hole functions builds it at its declared
// result row, not at the literal's own layout row, and a list of its results reads by that row:
// inside a function and at top level (D17671).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk() { return { r: { f: inc0 }, s: { f: dbl } } }
function inFn() {
  const ys = [mk()]
  print(ys[0].r.f(1))
}
inFn()
const xs = [mk()]
print(xs[0].r.f(6))
