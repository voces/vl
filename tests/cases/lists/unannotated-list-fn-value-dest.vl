// @run
// @hint redundant type annotation: `o` is inferred as `{f: (Shape[]) => i32}`
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 100
// An un-annotated list literal passed to a function VALUE is built at the parameter type the
// checker resolved for that callee: through an alias of an alias, a field, a parameter that
// shadows a module function, and a lambda whose own parameter is un-annotated (D2704).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function sum(xs: Shape[]) {
  let t = 0
  for e in xs {
    if e is Circle { t = t + e.r } else { t = t + e.s * 10 }
  }
  t
}
function csum(xs: Circle[]) {
  let t = 0
  for e in xs { t = t + e.r }
  t
}
function k(xs: Circle[]) { csum(xs) * 100 }
type O = { f: (Shape[]) => i32 }
function aliasChain() {
  const a = sum
  const b = a
  const out = [{ r: 3 }]
  print(b(out))
}
function field() {
  const o: O = { f: sum }
  const out = [{ r: 4 }]
  print(o.f(out))
}
function shadow(k: (Shape[]) => i32) {
  const out = [{ r: 5 }]
  print(k(out))
}
function innerRebind() {
  const k = (xs: Shape[]) => sum(xs)
  const out = [{ r: 6 }]
  print(k(out))
  if true {
    const k = (xs: Circle[]) => csum(xs)
    const out = [{ r: 7 }]
    print(k(out))
  }
}
function unannotatedParam() {
  const g = (xs) => sum(xs)
  const out = [{ r: 8 }]
  print(g(out))
}
aliasChain()
field()
shadow(sum)
innerRebind()
unannotatedParam()
print(k([{ r: 1 }]))
