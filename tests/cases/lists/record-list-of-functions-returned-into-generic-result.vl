// @run
// @log 4
// @log 6
// @log 6
// A list of records holding a generic function, returned from a function whose result type still
// holds that function's type variable, is the list the body built; the return converts nothing.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function pick(b: boolean) {
  if b { return [{ f: inc0 }] }
  const xs = [{ f: dbl }]
  return xs
}
function mk() { return [{ f: inc0 }, { f: dbl }] }
print(pick(true)[0].f(3))
print(pick(false)[0].f(3))
print(mk()[1].f(3))
