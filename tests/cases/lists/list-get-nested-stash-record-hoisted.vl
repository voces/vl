// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 9
// @log 6
// @log 9
// @log 8
// The hoisted twin of `list-get-nested-stash-record.vl`: every call bound to a `const` first.
type R = { x: i32 }
function L(xs: R[]) { return xs }
function I(xs: i32[]) { return xs }
function pick(k: i32) { return ls[k] }
const b: R[] = [{ x: 5 }, { x: 6 }, { x: 7 }]
const f: R[] = [{ x: 8 }, { x: 9 }]
const ls = [b, f]
const c = [2, 1, 0]
const e = [1, 0]
const i = 1
const lb = L(b)
const lf = L(f)
const ic = I(c)
const ie = I(e)
print(lb.get(1)?.x ?? -1)
const a1 = ic.get(1) ?? 0
print(lb.get(a1)?.x ?? -1)
const a2 = ie.get(0) ?? 0
const a3 = ic.get(a2) ?? 0
print(lb.get(a3)?.x ?? -1)
print(b.get(a1)?.x ?? -1)
print(lb.get(9)?.x ?? (lf.get(i)?.x ?? -1))
print(lb.get(9)?.x ?? (lf.get(9)?.x ?? (lb.get(a2)?.x ?? -1)))
const r1 = L(pick(a1))
print(r1.get(1)?.x ?? -1)
const r2 = L(pick(a3))
print(r2.get(0)?.x ?? -1)
