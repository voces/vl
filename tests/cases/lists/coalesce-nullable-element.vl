// @run
// @log 7
// @log 0
// @log 1.5
// @log 0
// @log 7
// @log 0
// @log 1.5
// @log 0
// @log true
// @log false
// @log a
// @log d
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 0
// @log 0
// @log 1.5
// @log 0
// @hint redundant type annotation: `ints` is inferred as `(i32 | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `floats` is inferred as `(f64 | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `flags` is inferred as `(boolean | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `words` is inferred as `(string | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `bound` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `get` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `own` is inferred as `(i32 | null)[]` — remove it to lean on inference

// D1828 — `xs[i] ?? d` over a list whose element is a nullable NUMERIC scalar. The element
// rides the `{tag, anyref}` value box, so the `??` result is the unboxed scalar; the arm that
// owns a box operand handed the box on, and every other arm asked the element's TYPE rather
// than its REP. The four numeric widths are the family; `boolean` and `string` ran already
// because each has its own niche, and they are the controls.
const ints: (i32 | null)[] = [7, null]
print(ints[0] ?? 0)
print(ints[1] ?? 0)

const floats: (f64 | null)[] = [1.5, null]
print(floats[0] ?? 0.0)
print(floats[1] ?? 0.0)

const wides: (i64 | null)[] = [7, null]
print(wides[0] ?? 0)
print(wides[1] ?? 0)

const narrows: (f32 | null)[] = [1.5, null]
print(narrows[0] ?? 0.0)
print(narrows[1] ?? 0.0)

// The two niches, which never reach the box arm.
const flags: (boolean | null)[] = [true, null]
print(flags[0] ?? false)
print(flags[1] ?? false)

const words: (string | null)[] = ["a", null]
print(words[0] ?? "d")
print(words[1] ?? "d")

// The deliveries: a binding, an argument, a return and a body-local list.
const bound: i32 = ints[0] ?? 0
print(bound)

function take(a: i32) { a }
print(take(ints[0] ?? 0))

function get(): i32 { ints[0] ?? 0 }
print(get())

function ownList() {
  const own: (i32 | null)[] = [7, null]
  own[0] ?? 0
}
print(ownList())

// The `.get(i)` spelling of the same read (D1829). It is the CHECKED read, so an
// out-of-range index has no box at all — a second null channel the present-test covers, and
// the reason `xs.get(9) ?? 0` takes the default rather than trapping.
print(ints.get(0) ?? 0)
print(ints.get(1) ?? 0)
print(ints.get(9) ?? 0)
print(floats.get(0) ?? 0.0)
print(floats.get(1) ?? 0.0)
