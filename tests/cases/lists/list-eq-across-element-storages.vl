// D15055: `==` between two lists whose elements are stored apart reads each side at its own
// storage and compares element by element by value: a number at the wider width (D15090), a
// box against a plain number, a null only against a null, and a nullable record against a plain
// one field-wise, and lists of such lists level by level (D15092).
type P = { x: i32, s: string }
const a: (i32 | null)[] = [1, 2]
const b = [1, 2]
const n: (i32 | null)[] = [1, null]
print(a == b)
print(n == b)
print(b == a)
const i = [1, 2]
const f = [1.0, 2.5]
const g = [1.0, 2.0]
print(i == f)
print(i == g)
const h = [2.5 as f32]
const k = [2.5]
print(h == k)
const m: (f64 | null)[] = [1.0, null]
print(n != m)
print(a != f)
const p: (P | null)[] = [{ x: 1, s: "a" }]
const q: P[] = [{ x: 1, s: "a" }]
const r: (P | null)[] = [null]
print(p == q)
print(r == q)
const l: i64[] = [7]
const j = [7]
print(l == j)
print(j != l)
const ii: i32[][] = [[1], [2, 3]]
const ff: f64[][] = [[1.0], [2.0, 3.0]]
print(ii != ff)
print(ii == ff)
