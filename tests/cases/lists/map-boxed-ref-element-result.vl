// @run
// @log 2
// @log 3
// @log 1
// @log c
// @log 5
// @log 7
// @log 6
// @log 7
// @log hi!
// D12901: a `.map` whose callback returns a nullable list, a map, a nullable map or a nullable
// closure builds a ref list at that element's own row. Each element type is graded in both
// faces, the binding annotated and not, and each proof reads through the `| null` it carries.

function g(k: i32): i32[] | null {
  if k > 0 { [k, k + 1] } else { null }
}
function mk(k: i32): Map<string, i32> {
  const m: Map<string, i32> = Map()
  m.set("a", k)
  m
}
function mkn(k: i32): Map<string, i32> | null {
  if k > 0 { mk(k) } else { null }
}
function add(k: i32): ((x: i32) => i32) | null {
  if k > 0 {
    (x) => x + k
  } else {
    null
  }
}

// A nullable list, an i32 element and a string element.
const nl: (i32[] | null)[] = [0, 2].map((k) => g(k))
const nl1 = nl[1]
if nl1 != null && nl[0] == null { print(nl1[0]) }
const nu = [0, 2].map((k) => g(k))
const nu1 = nu[1]
if nu1 != null { print(nu1[1]) }
const nss: i32[][] = [[1]]
const w: (i32[] | null)[] = nss.map((x): i32[] | null => x)
print(w.length)
const sss: string[][] = [["a"], ["b", "c"]]
const sn = sss.map((x): string[] | null => if x.length > 1 { x } else { null })
const sn1 = sn[1]
if sn1 != null && sn[0] == null { print(sn1[1]) }

// A map, annotated and not.
const ma: Map<string, i32>[] = [5].map((k) => mk(k))
print(ma[0].get("a") ?? -1)
const mu = [2, 7].map((k) => mk(k))
print(mu[1].get("a") ?? -1)

// A nullable map.
const nm = [0, 6].map((k) => mkn(k))
const nm1 = nm[1]
if nm1 != null && nm[0] == null { print(nm1.get("a") ?? -1) }

// A nullable closure, and one built inline at another signature.
const nc: (((x: i32) => i32) | null)[] = [0, 3].map((k) => add(k))
const nc1 = nc[1]
if nc1 != null && nc[0] == null { print(nc1(4)) }
const bang = [1, 0].map(
  (k): ((s: string) => string) | null => if k > 0 { (s) => s + "!" } else { null },
)
const b0 = bang[0]
if b0 != null && bang[1] == null { print(b0("hi")) }
