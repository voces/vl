// @run
// @log <20>
// @log <-1>
// `xs.get(i)` over a i32 list, its `T | null` delivered at interp: an index in range, then
// one past the end (Q58 position sweep).
function fmt(g: i32 | null) { return if g == null { "-1" } else { "\{g}" } }
function go(i: i32) {
  const xs = [10, 20]
  print("<\{fmt(xs.get(i))}>")
}
go(1)
go(2)
