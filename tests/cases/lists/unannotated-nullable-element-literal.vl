// @run
// @log 42
// @log 0
// @log 42
// @log 0
// @log 1.5
// @log 0
// @log 42
// @log 42
// @log 7
// @log 42
// @log 42
// @log 42
// @log a
// @log true

// D1830 — an UN-ANNOTATED list literal whose element is a nullable NUMERIC scalar mints its
// value-box row at the LITERAL. The union rung reads `TyUnion`, and `i32 | null` is recorded
// as `TyNullable`, so the annotated `(i32 | null)[]` registered through its annotation while
// the bare literal registered nowhere. Every cell here annotates NOTHING on purpose: an
// annotation pins the rep, and pinning it is what hid this.
const ints = [42, null]
print(ints[0] ?? 0)
print(ints[1] ?? 0)

// The `.get` spelling, which registered the row on its own and made the defect
// order-dependent — a program spelling both ran while the subscript alone did not.
print(ints.get(0) ?? 0)
print(ints.get(1) ?? 0)

const floats = [1.5, null]
print(floats[0] ?? 0.0)
print(floats[1] ?? 0.0)

// The wide widths, whose element type only inference can supply here.
function big(): i64 { 42 }
const wides = [big(), null]
print(wides[0] ?? 0)

// `null` FIRST, so the literal's first element is not the one that names the box.
const nullFirst = [null, 42]
print(nullFirst[1] ?? 0)
print(nullFirst[0] ?? 7)

// NESTED: the inner literal is the one that owes the row.
const nested = [[42, null]]
const inner = nested[0]
print(inner[0] ?? 0)
print(inner.get(0) ?? 0)

// A read with no `??` anywhere — the `??` was never an ingredient.
const guarded = [42, null]
const g0 = guarded[0]
if g0 != null { print(g0) } else { print(0) }

// The two niche controls, which never needed a box and ran before.
const words = ["a", null]
print(words[0] ?? "d")
const flags = [true, null]
print(flags[0] ?? false)
