// @run
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// `.pop() ?? d` and `.get(k) ?? d` over atom lists, the result the element, kept nullable, a union with
// a string, or a `?? d ?? e` chain, at a binding, an argument and a return: a result stored as a
// box is not the fused element read (D17382), and each prints what its hoisted twin prints.
type K = "a" | "b"
function pop_el_const(xs: K[]) {
  const r = xs.pop() ?? "a"
  print(r)
}
function show_pop_el_arg(r: K) { print(r) }
function pop_el_arg(xs: K[]) { show_pop_el_arg(xs.pop() ?? "a") }
function pop_el_ret(xs: K[]) { return xs.pop() ?? "a" }
function get_el_const(xs: K[], k: i32) {
  const r = xs.get(k) ?? "a"
  print(r)
}
function show_get_el_arg(r: K) { print(r) }
function get_el_arg(xs: K[], k: i32) { show_get_el_arg(xs.get(k) ?? "a") }
function get_el_ret(xs: K[], k: i32) { return xs.get(k) ?? "a" }
pop_el_const([])
pop_el_const(["b"])
pop_el_arg([])
pop_el_arg(["b"])
const r_pop_el_ret_4 = pop_el_ret([])
print(r_pop_el_ret_4)
const r_pop_el_ret_5 = pop_el_ret(["b"])
print(r_pop_el_ret_5)
get_el_const(["b"], 5)
get_el_const(["b"], 0)
get_el_arg(["b"], 5)
get_el_arg(["b"], 0)
const r_get_el_ret_10 = get_el_ret(["b"], 5)
print(r_get_el_ret_10)
const r_get_el_ret_11 = get_el_ret(["b"], 0)
print(r_get_el_ret_11)
