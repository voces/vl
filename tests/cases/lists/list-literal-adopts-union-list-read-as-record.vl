// @run
// @log 1
// @log 7
// @log 1
// @log 7
// @log 1
// @log 7
// An un-annotated list of record literals delivered to a list of a union it is a member of
// adopts that union list (record covariance and D3339 (A), all-or-nothing per binding), and its
// own elements still read as the record: through the binding, beside a `Circle[]` delivery, and
// beside a parameter of the union list.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function g(xs: Shape[]) { print(xs.length) }
function h(xs: Circle[]) { print(xs[0].r) }
function one() {
  const xs = [{ r: 7 }]
  const a: Shape[] = xs
  print(a.length)
  print(xs[0].r)
}
function beside() {
  const xs = [{ r: 7 }]
  const a: Shape[] = xs
  const c: Circle[] = xs
  print(a.length)
  print(c[0].r)
}
function param() {
  const xs = [{ r: 7 }]
  g(xs)
  h(xs)
}
one()
beside()
param()
