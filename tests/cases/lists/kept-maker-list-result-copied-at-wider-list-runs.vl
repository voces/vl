// @log 4
// @log 4
// @log 0.5
// @log 2
// A kept maker returning a list of records, delivered at a list whose element stores a field
// wider: the call's fresh list is copied element by element there, the other call keeps its
// own list, and the copy is a list of its own (D15826).
type J = { f: i32 | null }
function mk() { [{ f: 4 }] }
const _k: J[] = mk()
const y = mk()
print(y[0].f)
print(_k[0].f ?? 0)
type H = { g: f64 }
function mh() { [{ g: 4 }] }
const hs: H[] = mh()
const h = mh()
print(hs[0].g / 8.0)
hs.push({ g: 1.5 })
print(hs.length + h.length - 1)
