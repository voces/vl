// @run
// @log 20
// @log -1
// `xs.get(i)` over a i32 list, its `T | null` delivered at field: an index in range, then
// one past the end (Q58 position sweep).
function show(g: i32 | null) { print(g ?? -1) }
function go(i: i32) {
  const xs = [10, 20]
  const r = { g: xs.get(i) }
  show(r.g)
}
go(1)
go(2)
