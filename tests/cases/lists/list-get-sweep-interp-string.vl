// @run
// @log <b>
// @log <->
// `xs.get(i)` over a string list, its `T | null` delivered at interp: an index in range, then
// one past the end (Q58 position sweep).
function fmt(g: string | null) { return g ?? "-" }
function go(i: i32) {
  const xs = ["a", "b"]
  print("<\{fmt(xs.get(i))}>")
}
go(1)
go(2)
