// A list literal holding an empty list, read in place rather than bound, takes the read-only
// default for the empty list at the program's end, after any write to it (D16879).
print([[]].length)
print([[]][0].length)
const n = [[]].length
print(n)
print([[], []].length)
print([[[]]].length)
print([[[]]][0][0].length)
function g(xs) {
  xs[0].push(7)
  return xs[0][0]
}
print(g([[]]))
function h() { print([[]].length) }
h()
function k<T>(x: T): T {
  print([[]][0].length)
  return x
}
k(1)
k("s")
for i in [1, 2] { print([[]].length + i) }
