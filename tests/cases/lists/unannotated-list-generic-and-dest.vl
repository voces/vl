// @log 3
// An un-annotated list literal built for a declared `Shape[]` destination is also what a
// generic function's `T[]` receives, in either call order, from a capture or an alias, and at
// module scope (D2747).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function sum(xs: Shape[]) {
  let t = 0
  for e in xs {
    if e is Circle { t = t + e.r } else { t = t + e.s * 10 }
  }
  t
}
function len<T>(xs: T[]) { xs.length }
function twice<T>(xs: T[]): T[] { [xs[0], xs[0]] }
function genFirst() {
  const out = [{ r: 3 }]
  print(len(out))
  print(sum(out))
}
function genAfter() {
  const out = [{ r: 3 }]
  print(sum(out))
  print(len(out))
}
function genList() {
  const out = [{ r: 3 }]
  print(twice(out).length)
  print(sum(out))
}
function genCapture() {
  const out = [{ r: 3 }]
  const g = () => len(out)
  print(g())
  print(sum(out))
}
function genAlias() {
  const out = [{ r: 3 }]
  const o2 = out
  print(len(o2))
  print(sum(out))
}
genFirst()
genAfter()
genList()
genCapture()
genAlias()
const top = [{ r: 3 }]
print(len(top))
print(sum(top))
