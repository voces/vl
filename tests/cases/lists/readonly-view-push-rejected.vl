// @error `.push()` writes the list
// CONTRACT (must-error): the view's whole purpose. `push` changes the list's own shape, so
// a `readonly Circle[]` receiver refuses it and the message names the mutable spelling that
// would allow it. `pop` and `clear` refuse through the same predicate.
//
// A VERDICT pin: there is no correct run to compare a `@log` against — the point is that
// the program does not type-check.
type Circle = { r: i32 }
function grow(xs: readonly Circle[]) { xs.push({ r: 1 }) }
function f() {
  const a: Circle[] = [{ r: 2 }]
  grow(a)
  print(a.length)
}
f()
