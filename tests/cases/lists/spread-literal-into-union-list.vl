// @run
// @log 10
// @log 11
// @log 12
// @log s
// @log 5
// @log 6
// @log -1
// @log 3
// @log 2.5
// @log 107
// @log t
// @log 108
// @log 1
// A list literal spread into a list of a union or nullable element is built at that element,
// as a plain run beside it is (D16701).
const u: (i32 | string)[] = [0, ...[1, 2], ...["s"]]
for e in u {
  if e is string { print(e) } else { print(e + 10) }
}
const n: (i32 | null)[] = [...[5, 6], null]
for e in n { print(e ?? -1) }
const f: (i32 | f64)[] = [...[1], ...[2.5]]
for e in f {
  if e is f64 { print(e) } else { print(e * 3) }
}
const p: (i32 | string)[] = []
p.push(7, ...["t", 8])
for e in p {
  if e is string { print(e) } else { print(e + 100) }
}
type U = i32 | string
const named: U[] = [...["a"]]
print(named.length)
