// @run
// @log 1
// @log null
// @log 1
// @log null
// A record literal holding an element of a list of lists, one of whose lists a kept maker's
// build stores at `J`, is laid out where that list is stored (D16838).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const srcs = [src]
const w = { f: srcs[0] }
print(w.f.length)
const v = w.f
print(v[0].f)
const i = 0
const u = { g: 1, f: srcs[i] }
print(u.f[0].f ?? u.g)
print(dA.f)
