// @run
// @log true
// @log false
// @log none
// @log true
// @log false
// @log true
// @log false
// @log true
// @log 2
// @log 2
// @log true
// @log true
// A `(boolean | null)[]` keeps its null in a niche of the `boolean[]` storage, so a boolean list
// spread into it copies as it is, at a binding, an un-annotated literal, a return and a generic's
// `(T | null)[]` at `T := boolean` (D15043).
function pad<T>(xs: T[]): (T | null)[] { return [...xs, null] }
function tail(ys: boolean[]): (boolean | null)[] { [...ys, null] }
const xs = [true, false]
const q: (boolean | null)[] = [...xs, null, ...xs]
for x in q { print(x ?? "none") }
const u = [null, ...xs]
print(u[0] == null)
print(u[2] ?? true)
print(tail([false])[0] == false)
print(tail([false]).length)
const r = pad([true])
print(r.length)
print(r[0] ?? false)
print(r[1] == null)
