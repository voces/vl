// @run
// @log a
// @log a
// @log a
// @log a
// @log a
// @log a
// @log 1
// @log 1
// A NULLABLE inline literal-union array — `("a" | "b")[] | null` — in every binding
// position that decides the cell itself, each PAIRED with its `K[] | null` alias control
// on the adjacent line. The sibling `litunion-inline-array-positions.vl` pins the
// NON-null spelling; this file is the `| null` twin, which was left behind by it.
//
// WHY IT IS A FIXTURE. `canonEmitName` softens a bare inline literal union to its base
// scalar, so this annotation RENDERS `string[] | null` while the checker's arena still
// holds the litunion members. `nulScalarListKindOfNode` read that name and answered
// `nulstrlist` — a `(ref null $strListWrapper)` — for a cell whose initializer builds the
// interned-atom i32 wrapper, and `fieldCodeOfSpelling` coded the same field 31 instead of
// 18. The two spellings denote ONE type, so any line where the columns disagree is the
// canon-softening split re-opening.
//
// The LOCAL position is deliberately in here even though it always worked: the split is
// position-dependent (the local ladder had the arena leg the global / param / field
// classifiers lacked), so the passing position is what makes the failing ones legible.

type K = "a" | "b"

const gInline: ("a" | "b")[] | null = ["a"]
const gAlias: K[] | null = ["a"]

type SInline = { xs: ("a" | "b")[] | null }
type SAlias = { xs: K[] | null }

function localBoth() {
  const xi: ("a" | "b")[] | null = ["a"]
  if xi != null {
    print(xi[0]) // a
  }
  const xa: K[] | null = ["a"]
  if xa != null {
    print(xa[0]) // a
  }
}

// A PARAM: the annotation crosses a call boundary, where the cell kind and the argument
// build are decided by different classifiers.
function takesInline(xs: ("a" | "b")[] | null) {
  if xs != null { print(xs[0]) }
}
function takesAlias(xs: K[] | null) {
  if xs != null { print(xs[0]) }
}

// A declared struct FIELD — the field-CODE position, a separate ladder from the binding.
function fields() {
  const si: SInline = { xs: ["a"] }
  const vi = si.xs
  if vi != null {
    print(vi[0]) // a
  }
  const sa: SAlias = { xs: ["a"] }
  const va = sa.xs
  if va != null {
    print(va[0]) // a
  }
}

if gInline != null {
  print(gInline[0]) // a
}
if gAlias != null {
  print(gAlias[0]) // a
}
localBoth()
takesInline(["a"])
takesAlias(["a"])
fields()

// A `null`-valued cell of each spelling still reads as absent.
function nulls() {
  const ni: ("a" | "b")[] | null = null
  let hi = 0
  if ni == null { hi = 1 }
  print(hi) // 1
  const na: K[] | null = null
  let ha = 0
  if na == null { ha = 1 }
  print(ha) // 1
}
nulls()
