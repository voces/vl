// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 3
// @log 2
// The length of a union of lists stored alike (a literal-int union's list beside its base's)
// reads the one list, at every depth and through a parameter (D16981).
type K = 1 | 2
const q: K[][] | i32[][] = [[2]]
print(q.length)
const r: K[][] | i32[][] = [[3], [4]]
print(r.length)
const a: K[] | i32[] = [1, 2, 7]
print(a.length)
const c: K[][][] | i32[][][] = [[[1]], [[2]], [[3]], [[4]]]
print(c.length)
function f(x: K[][] | i32[][]) { return x.length }
print(f([[1], [2], [3]]))
const u: i32[] | string[] = ["a", "b"]
print(u.length)
