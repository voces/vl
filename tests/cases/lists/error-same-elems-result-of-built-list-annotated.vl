// @error this container's {f: null} elements are stored at J, the row its stores build
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A `filter` result holds the receiver's own elements, stored at the record `J` the kept maker's
// build gives them, so it is delivered as the receiver is: refused where a narrower element type
// is declared, never built as a module that fails to validate (D16763).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const v: { f: null }[] = src.filter((y) => y.f == null)
print(v[0].f)
