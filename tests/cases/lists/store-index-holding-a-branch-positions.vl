// @run
// @log 5
// @log 7
// @log 0 9
// @log 3
// @log 8
// @log 1 6
// @log 4
// @log 2
// An element store whose index holds a branch (an `if`, a `match`, a `??`), the receiver staged
// below it: a local, a record's field, a parameter, a global, a nested list's row, a value that
// branches too, and at top level.
const g = [0, 0]
function pick(k: i32) { return k }
function local(a: boolean) {
  const xs = [0, 0]
  xs[if a { 0 } else { 1 }] = 5
  return xs[0]
}
function field(k: i32) {
  const e = { list: [1, 2, 3] }
  e.list[match pick(k) {
    2 => 1
    _ => 0
  }] = 7
  return e.list[1]
}
function param(xs: i32[], m: Map<i32, i32>) {
  xs[m.get(1) ?? 1] = 9
  print("\{xs[0]} \{xs[1]}")
}
function glob(a: boolean) {
  g[if a { 1 } else { 0 }] = 3
  return g[1]
}
function nested(a: boolean) {
  const rows = [[0, 0], [0, 0]]
  rows[1][if a { 1 } else { 0 }] = 8
  return rows[1][1]
}
function both(a: boolean) {
  const xs = [0, 0]
  xs[if a { 1 } else { 0 }] = if a { 6 } else { 4 }
  xs[0] = 1
  print("\{xs[0]} \{xs[1]}")
}
local(true)
print(local(true))
print(field(2))
param([0, 0], Map())
print(glob(true))
print(nested(true))
both(true)
g[if g[1] == 3 { 0 } else { 1 }] = 4
print(g[0])
print(g.length)
