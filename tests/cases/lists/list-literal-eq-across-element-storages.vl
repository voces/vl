// D15091: a list literal beside a list whose elements are stored apart is built at the other
// list's type when it fits it, else at its own and compared across storage by value.
type P = { x: i32 }
const g = [1.0, 2.0]
const n: (i32 | null)[] = [1, null]
const i = [1, 2]
const l: i64[] = [1, 2]
const q: (P | null)[] = [{ x: 1 }, null]
print(g == [1, 2])
print([1, 2] == g)
print(g != [1, 2])
print(n == [1, null])
print(n == [1.0, null])
print(n != [1, 2])
print(i == [1.5, 2.0])
print(i == [1.0, 2.0])
print(i == [])
print(l == [1, 2])
print(q == [{ x: 1 }, null])
print(q != [] && [] != q)
