// @run
// @log null
// @log null
// @log null
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A `let` that only ever holds reads of `src`'s elements, stored at `J`, or a fresh record built
// there, is read at `J`, so `show` is instanced there for it (D16800).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
function show(z: { f: null }) { print(z.f) }
function go() {
  let w = src[0]
  w = src[0]
  show(w)
  let v = src[0]
  v = { f: null }
  show(v)
}
go()
for y in src {
  let w = y
  w = y
  show(w)
}
