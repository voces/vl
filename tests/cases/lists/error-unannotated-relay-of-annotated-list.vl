// @error Circle[] is not Shape[]: a container never widens implicitly, and only a readonly list is covariant. A store through Shape[] could put in an element that Circle[] does not allow. Copy it with `.map((x): Shape => x)`
// A function with no result annotation that hands back an existing annotated list relays that
// list, not one built at the destination, so the delivery widens a container (D2194).
// `unannotated-relay-of-fresh-list.vl` is the neighbour that runs.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const circles: Circle[] = [{ r: 7 }]
function relay() { circles }
const s: Shape[] = relay()
circles.push({ r: 8 })
print(s.length)
