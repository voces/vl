// @run
// @log 3
// @log 4
// @log 4
// @log 3
// @log s
// @log 2
// @log 5
// @log 2
// @log 3
// @log 4
// @log 3
// @hint redundant type annotation: `a` is inferred as `i32[]`
// @hint redundant type annotation: `b` is inferred as `i32[]`
// @hint redundant type annotation: `f` is inferred as `f64[]`
// @hint redundant type annotation: `fs` is inferred as `(f64 | null)[][]`
// @hint redundant type annotation: `ss` is inferred as `{x: i32}[]`
// D2883: a spread boxes each source element into a union-element list wherever the list it
// builds is an element of another: an outer list literal, a `push`, a cell write, a map value.
const a: i32[] = [3]
const b: i32[] = [4]
const xs: (i32 | null)[][] = [[...a]]
print(xs[0][0] ?? -1)
xs.push([...a, ...b])
print(xs[1][1] ?? -1)
xs[0] = [...b]
print(xs[0][0] ?? -1)
const ys: (string | i32)[][] = [[...a], ["s"]]
print(ys[0][0])
print(ys[1][0])
const f: f64[] = [1.5]
const fs: (f64 | null)[][] = [[...f, null]]
print(fs[0].length)
function mk(src: i32[]): (i32 | null)[][] { [[...src]] }
print(mk([5])[0][0] ?? -1)
type S = { x: i32 }
const ss: S[] = [{ x: 2 }]
const us: (S | i32)[][] = []
us.push([...ss])
const u = us[0][0]
if u is S { print(u.x) }
const m: {[string]: (i32 | null)[]} = Map()
m.set("k", [...a])
const mv = m.get("k")
if mv != null { print(mv[0] ?? -1) }
const deep: (i32 | null)[][][] = [[[...b]]]
print(deep[0][0][0] ?? -1)
const cap = () => {
  xs.push([...a])
  0
}
cap()
print(xs.length)
