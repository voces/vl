// @run
// @log 5
// @log 7
// @log 2
// D3586 — a record's own field named `length` is assignable, compound assignment included;
// only the built-in `.length` of a list, map, set or string is read-only.
type Box<T> = { length: T }
function bump(b: Box<i32>) {
  b.length += 2
  b.length
}
const r = { length: 3 }
r.length = 5
print(r.length)
print(bump({ length: 5 }))
const rs = [{ length: 1 }]
rs[0].length += 1
print(rs[0].length)
