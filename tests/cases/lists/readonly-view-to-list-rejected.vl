// @error cannot assign readonly Circle[] to 'm' of type Circle[]
// CONTRACT (must-error): the rule that makes every other refusal hold. Were a view
// assignable to a mutable list, one binding would launder every write the view forbids —
// so `readonly T[]` -> `T[]` is refused at every position and `T[]` -> `readonly T[]` is
// the only direction that passes.
//
// A VERDICT pin: the program must not type-check, so there is no run to compare against.
type Circle = { r: i32 }
function sneak(v: readonly Circle[]) {
  const m: Circle[] = v
  m.push({ r: 1 })
}
function f() {
  const a: Circle[] = [{ r: 2 }]
  sneak(a)
  print(a.length)
}
f()
