// @run
// @log true
// @log true
// The knowingly-kept renderer copy (std:test's vltI64Str — see std/utf8.vl's
// one-renderer ruling) pinned against std:fmt's toString at the values where a
// drift would hide: i64 min (the negative-accumulator trick both use) and i32
// min widened. std:test's copy is private, so ITS half of the pin goes through
// the surface it feeds: tests/fixtures/vl-test/fail.test.vl renders i64 min in
// a failure message and vl_test_runner_test.ts asserts the digits; HERE
// std:fmt's half is pinned against the literal spellings. Same value, both
// renderers, two assertions that fail together only if both drift identically.
import { toString } from "std:fmt"

const wideMin: i64 = -9223372036854775808
print(wideMin.toString() == "-9223372036854775808")
const narrowMin: i64 = -2147483648
print(narrowMin.toString() == "-2147483648")
