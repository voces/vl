// @error-at 6:9 'some' is not imported — a free `some(self: …)` accepting i32[] is exported by "std:array"; a UFCS call resolves only names in scope, so import `some` from there — add `import { some } from "std:array"`
// @error-at 7:9 'every' is not imported — a free `every(self: …)` accepting i32[] is exported by "std:array"; a UFCS call resolves only names in scope, so import `every` from there — add `import { every } from "std:array"`
// The JS spelling of an array predicate is a UFCS call into `std:array`, and without the
// import the sentence names the module to import it from.
const xs = [1, 2, 3]
print(xs.some((i) => i == 2))
print(xs.every((i) => i > 0))
