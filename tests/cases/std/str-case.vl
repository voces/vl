// @run
// @log [HELLO]
// @log [hello]
// @log [HELLO, WORLD!]
// @log [hello, world!]
// @log [HELLO]
// @log [hello]
// @log [123-456]
// @log [123-456]
// @log []
// @log []
// @log [@az[]
// @log [`AZ{]
// @log [@AZ[]
// @log [`az{]
// @log true
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log true
// @log true
// `std:str` ASCII CASE — `toUpperAscii` / `toLowerAscii`, and the promise their
// names make.
//
// THE NAME IS THE ASSERTION. These functions change `a`–`z` and `A`–`Z` and
// NOTHING ELSE, and the `Ascii` suffix is there so no caller can mistake them
// for Unicode case mapping. `docs/guide/strings-design.md` rules the naming
// explicitly: an unqualified `toUpper` that silently leaves `é` alone works on
// every string its author tests and is wrong on the first one a user types —
// the quiet-lie class VL exists to reject. The non-ASCII lines below are the
// pinned proof that the limit is real and visible rather than accidental.
//
// Full case mapping is not even a per-character map — `ß` upper-cases to two
// characters and Turkish dotless-i makes the answer LOCALE-dependent — so it
// needs tables and belongs to a future `std:unicode`, not to a shorter name
// here.
import { toLowerAscii, toUpperAscii } from "std:str"

print("[" + "hello".toUpperAscii() + "]")            // [HELLO]
print("[" + "HELLO".toLowerAscii() + "]")            // [hello]
print("[" + "Hello, World!".toUpperAscii() + "]")    // [HELLO, WORLD!]
print("[" + "Hello, World!".toLowerAscii() + "]")    // [hello, world!]
// Already in the target case: returned as it arrived, no rebuild.
print("[" + "HELLO".toUpperAscii() + "]")            // [HELLO]
print("[" + "hello".toLowerAscii() + "]")            // [hello]
// Nothing cased at all — digits, punctuation, the empty string.
print("[" + "123-456".toUpperAscii() + "]")          // [123-456]
print("[" + "123-456".toLowerAscii() + "]")          // [123-456]
print("[" + "".toUpperAscii() + "]")                 // []
print("[" + "".toLowerAscii() + "]")                 // []
// THE BOUNDARIES of both ranges, plus the four characters that bracket them in
// ASCII (`@`/`[` around A–Z, and backtick/`{` around a–z) — the classic
// off-by-one in a hand-rolled case shift catches exactly these.
print("[" + "@AZ[".toLowerAscii() + "]")             // [@az[]
print("[" + "`az{".toUpperAscii() + "]")             // [`AZ{]
print("[" + "@AZ[".toUpperAscii() + "]")             // [@AZ[]
print("[" + "`az{".toLowerAscii() + "]")             // [`az{]
// NON-ASCII PASSES THROUGH, and this is the assertion the `Ascii` suffix
// exists to make. The characters are built with `fromCodePoint` and compared
// with `==` rather than written as literals and measured with `.length` — on
// purpose. `.length` and `charCodeAt` are in whatever unit the core's index
// currently is (a code point today, a UTF-8 byte after the rep swap in
// `strings-design.md` §Storage), so a length assertion over a multi-byte
// character would pin the REPRESENTATION and go red on a change that is not
// about this module. Byte-for-byte equality is true in either world.
const eAcute = fromCodePoint(233)  // é — HAS an upper-case form, U+00C9
const EAcute = fromCodePoint(201)  // É — HAS a lower-case form, U+00E9
print(("caf" + eAcute).toUpperAscii() == "CAF" + eAcute)   // true — é untouched
print(("CAF" + EAcute).toLowerAscii() == "caf" + EAcute)   // true — É untouched
print(("caf" + eAcute).toUpperAscii() == "CAFÉ")           // false — NOT Unicode
// A string with nothing ASCII in it is returned as it arrived.
print(eAcute.toUpperAscii() == eAcute)                     // true
print(EAcute.toLowerAscii() == EAcute)                     // true
// The German sharp s upper-cases to "SS" in Unicode and to ITSELF here — the
// single most-cited example of why the full operation is not a character map
// (its result is longer than its input, so no per-character shift can express
// it) and therefore why it needs `std:unicode` and not a shorter name here.
const sharpS = fromCodePoint(223)  // ß
print(("stra" + sharpS + "e").toUpperAscii() == "STRA" + sharpS + "E")  // true
print(("stra" + sharpS + "e").toUpperAscii() == "STRASSE")              // false
// Round trip on mixed content: lower(upper(s)) == lower(s) for ASCII letters.
print("Hello, World!".toUpperAscii().toLowerAscii() == "Hello, World!".toLowerAscii())
// A normalizing comparison — the common reason to call either of these.
print("HeLLo".toLowerAscii() == "hello".toLowerAscii())
