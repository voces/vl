// @error argument 1: expected U16View, got U8View
// A u8 view handed to the u16 reader is refused. Both views are
// `{ base: i32, length: i32 }` and both readers answer i32, so without `new`
// this would read the wrong width silently. Inverted control: `buffer-narrow-views.vl`.
import { Buffer, getU16, u8view } from "std:buffer"

const b = Buffer(64)
const t = b.u8view(0, 8)
print(getU16(t, 0))
