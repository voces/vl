// @run
// @log b
// @log b
// @log b
// @log b
// @log b
// @log b
// @log b
// @log b
// @log b
// @log b
// @log b
// @hint Intentionally-unused parameter `_i`
// The two annotated-binding cells keep their annotation and DECLARE the hint: the annotation
// IS the delivery under test (`const g: (i32, i32) => K = base` failed exactly as the
// un-annotated `const g = base` did), so removing it to quiet the lint would delete a cell.
// The `$m0` suffix in the rendered type is a monomorphized instance name leaking into a
// user-facing hint — pre-existing, measured identical on the parent seed, and a separate row.
// @hint redundant type annotation: `gAnn` is inferred as `(i32, i32) => K$m0`
// @hint redundant type annotation: `hAnn` is inferred as `(i32, i32) => K$m0`
// @hint redundant type annotation: `held` is inferred as `{cb: (i32, i32) => K$m0}`
// @hint redundant type annotation: `cbs` is inferred as `((i32, i32) => K$m0)[]`
// GRADUATED from `xfail-miscompile-mapindexed-litunion-callback-binding.vl`, and it is the
// CROSS CELL its predecessor's grid never took: `mapIndexed` with an ALIAS literal-union result
// `U` AND a callback that reaches the call site as anything other than a bare NAME. That grid
// had "alias `U`, callback by name" and "inline `U`, callback as a lambda" and no row where
// both moved. This file is the cross product instead of the diagonal — DELIVERY (by name /
// lambda / binding / annotated binding) against SPELLING (alias / inline / inline beside an
// unused same-layout alias) — because the diagonal is what let the defect through twice.
//
// THE MECHANISM WAS THE VALUE CALL'S RESULT REP, and the missing piece was a TWIN.
// `cloCallParamLitUnion` has told the emitter since function values learned to take a `K` that
// a value call's PARAMETER is an interned atom; nothing said it about the RESULT, and the
// `$fnsig` key cannot — a litunion result's token is `i`, byte-identical to a plain i32's.
// Inside a monomorphized instance `exprIsLitAtom`'s other two arms are both blind: the call
// node is SHARED with the generic body and still records the type VARIABLE, and the callee is a
// parameter rather than a `FuncDecl`. So `out.push(f(self[i], i))` staged the `call_indirect`'s
// i32 atom into the string-narrow slot: `vl check` rc 0 and `type mismatch: expected (ref
// $type), found i32` at load. `cloCallResultLitUnion` asks the callee's own SUBSTITUTED
// annotation, which is what the `call_indirect` was interned at.
//
// BY NAME ESCAPED because mono lowers a named callback to a DIRECT call, where the
// `FuncDecl` arm already answered — which is exactly why a grid that varies delivery only on
// the inline spelling proves nothing about the alias one.
//
// NOTHING HINTS AT IT. The sibling `fntype` defect at least carried a redundant-annotation
// HINT; here `const g = base` and `const g: (i32, i32) => K = base` both failed, and the
// un-annotated form has nothing to hint about.
import { mapIndexed } from "std:array"

type K = "a" | "b"

// ── the ALIAS spelling, all four deliveries ──
function base(x: i32, _i: i32): K {
  if x > 0 { return "b" }
  return "a"
}

print([0, 1].mapIndexed(base)[1])

const gPlain = base
print([0, 1].mapIndexed(gPlain)[1])

const gAnn: (i32, i32) => K = base
print([0, 1].mapIndexed(gAnn)[1])

const gLam = (x: i32, _i: i32): K => {
  if x > 0 { return "b" }
  return "a"
}
print([0, 1].mapIndexed(gLam)[1])

// ── the INLINE spelling beside an UNUSED same-layout alias ──
// `Sib` is load-bearing exactly as it is in `array-litunion-needle.vl`: an inline member set
// reps as the atom once any alias in the program carries the same members, and that is the
// cell the predecessor's grid replaced with a bare inline one.
type Sib = "a" | "b"

function baseInline(x: i32, _i: i32): ("a" | "b") {
  if x > 0 { return "b" }
  return "a"
}

print([0, 1].mapIndexed(baseInline)[1])

const hPlain = baseInline
print([0, 1].mapIndexed(hPlain)[1])

const hAnn: (i32, i32) => ("a" | "b") = baseInline
print([0, 1].mapIndexed(hAnn)[1])

const hLam = (x: i32, _i: i32): "a" | "b" => {
  if x > 0 { return "b" }
  return "a"
}
print([0, 1].mapIndexed(hLam)[1])

// ── THREE MORE DELIVERIES, found by the std review of this commit ──
// The four above are the ones the fix's write-up enumerated, and that enumeration reads as a
// whitelist. It is an UNDER-claim: a callback reaching the call site out of a STRUCT FIELD, a
// LIST ELEMENT or a FUNCTION RESULT was broken on the parent seed for the same reason and runs
// for the same fix — measured, all three, against master's published compiler. They are pinned
// because "the four ways" is exactly the shape of sentence that put this defect through twice.
type Holder = {cb: (i32, i32) => K}

const held: Holder = {cb: base}
print([0, 1].mapIndexed(held.cb)[1])

const cbs: ((i32, i32) => K)[] = [base]
print([0, 1].mapIndexed(cbs[0])[1])

function mkCb(): (i32, i32) => K { return base }
print([0, 1].mapIndexed(mkCb())[1])
