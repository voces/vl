// @run
// @log 2
// @log 2
// @log 2
// @hint redundant type annotation: `a` is inferred as `Json | JsonError` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `Json | JsonError` — remove it to lean on inference
// `Json | JsonError` holds the nullable alias `Json` as one member and keys the row of its flat
// member set, so a module binding narrows to `Json[]` as a local does, annotated or not (D14551).
import { Json, JsonError, parseJson } from "std:json"

const a: Json | JsonError = parseJson("[1, 2]")
if a is JsonError {
  print("err")
} else {
  if a is Json[] { print(a.length) }
}

const c = parseJson("[1, 2]")
if c is JsonError {
  print("err")
} else {
  if c is Json[] { print(c.length) }
}

function local() {
  const b: Json | JsonError = parseJson("[1, 2]")
  if b is JsonError {
    print("err")
  } else {
    if b is Json[] { print(b.length) }
  }
}
local()
