// THE BULK PAIR, `fill` and `copyFrom` (`buffer-design.md` §C3). Both are VL
// LOOPS today: `memory.fill` (0xfc 11) and `memory.copy` (0xfc 10) need the
// emitter's first `0xfc` byte-writer, which is sequencing item S6. The loops are
// slow and correct; this file pins the CORRECT half, so S6 can replace the
// bodies with one instruction each and keep the same expectations.
//
// The load-bearing case is OVERLAP. `memory.copy` is defined to behave as if the
// bytes went through a temporary, so `copyFrom` picks its direction from the
// absolute addresses. Both wrong directions are distinguishable here by value:
// a naive FORWARD loop turns 1,2,1,2,3,4,5,6 into 1,2,1,2,1,2,1,2, and a naive
// BACKWARD loop turns 3,4,5,6,7,8,7,8 into 7,8,7,8,7,8,7,8.
import { Buffer, copyFrom, fill, loadI32, loadU8, store8 } from "std:buffer"

const b = Buffer(32)

// `fill` writes exactly its range and nothing else.
b.fill(4, 4, 7)
print(b.loadI32(4)) // 0x07070707
print(b.loadI32(0)) // untouched
print(b.loadI32(8)) // untouched

// Unaligned start AND unaligned length — bytes 2,3,4 only.
b.fill(2, 3, 255)
print(b.loadU8(1)) // 0 — one below the range
print(b.loadU8(2))
print(b.loadU8(3))
print(b.loadU8(4))
print(b.loadU8(5)) // still 7 from the first fill — one above the range

// A zero or negative length writes nothing.
b.fill(10, 0, 9)
print(b.loadU8(10))
b.fill(10, -5, 9)
print(b.loadU8(10))

// The byte value truncates, exactly as `memory.fill` truncates it.
b.fill(12, 1, 511)
print(b.loadU8(12))

// `copyFrom` BETWEEN TWO BUFFERS — the destination is the receiver (O3).
const src = Buffer(8)
src.store8(0, 1)
src.store8(1, 2)
src.store8(2, 3)
src.store8(3, 4)
src.store8(4, 5)
src.store8(5, 6)
src.store8(6, 7)
src.store8(7, 8)
const dst = Buffer(8)
dst.copyFrom(0, src, 0, 8)
print(dst.loadI32(0)) // 1,2,3,4
print(dst.loadI32(4)) // 5,6,7,8

// A zero length copies nothing — the destination word below stays as it was.
const dst2 = Buffer(8)
dst2.copyFrom(0, src, 0, 4)
dst2.copyFrom(4, src, 0, 0)
print(dst2.loadI32(0))
print(dst2.loadI32(4))

// OVERLAP, DESTINATION ABOVE SOURCE. Copying 1..8 forward by two must read each
// byte before the copy overwrites it: 1,2,3,4,5,6 lands at offsets 2..7.
const ov = Buffer(16)
ov.store8(0, 1)
ov.store8(1, 2)
ov.store8(2, 3)
ov.store8(3, 4)
ov.store8(4, 5)
ov.store8(5, 6)
ov.store8(6, 7)
ov.store8(7, 8)
ov.copyFrom(2, ov, 0, 6)
print(ov.loadU8(0))
print(ov.loadU8(1))
print(ov.loadU8(2))
print(ov.loadU8(3))
print(ov.loadU8(4))
print(ov.loadU8(5))
print(ov.loadU8(6))
print(ov.loadU8(7))

// OVERLAP, DESTINATION BELOW SOURCE — the mirror case, where a backward loop is
// the wrong one. 3,4,5,6,7,8 lands at offsets 0..5.
const ov2 = Buffer(16)
ov2.store8(0, 1)
ov2.store8(1, 2)
ov2.store8(2, 3)
ov2.store8(3, 4)
ov2.store8(4, 5)
ov2.store8(5, 6)
ov2.store8(6, 7)
ov2.store8(7, 8)
ov2.copyFrom(0, ov2, 2, 6)
print(ov2.loadU8(0))
print(ov2.loadU8(1))
print(ov2.loadU8(2))
print(ov2.loadU8(3))
print(ov2.loadU8(4))
print(ov2.loadU8(5))
print(ov2.loadU8(6))
print(ov2.loadU8(7))
