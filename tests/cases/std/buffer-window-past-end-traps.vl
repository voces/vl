// @trap
// A WINDOW THAT RUNS OFF THE END OF ITS `Buf` IS REFUSED, NOT HANDED OUT.
//
// Past `self.length` is still inside the module's memory, so a window over it would be a
// `Buf` describing another buffer's bytes, and a write through it would corrupt them with
// no engine trap to catch it. `window` compares the range once and traps; the sentence it
// prints first is pinned by `tests/vl_buffer_bytes_trap_message_test.ts`.
import { Buffer, window } from "std:buffer"

// Three bytes left at offset 5, and four are asked for.
const b = Buffer(8)
const w = window(b, 5, 4)
print(w.length)
