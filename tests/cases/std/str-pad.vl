// @run
// @log [ababab]
// @log [ab]
// @log [xxxxx]
// @log []
// @log []
// @log []
// @log []
// @log []
// @log 200
// @log [007]
// @log [700]
// @log [xxx]
// @log [xxx]
// @log [aba5]
// @log [5aba]
// @log [ax]
// @log [xa]
// @log [abcabca]
// @log 40
// @log [hello]
// @log [hello]
// @log [hello]
// @log [hello]
// @log [hello]
// @log [hello]
// @log [x]
// @log [x]
// @log []
// `std:str` BUILDING — `repeat`, `padStart`, `padEnd`: the three exports that
// produce a string LONGER than their input, and the four degenerate arguments
// each has to rule on.
//
// The padders share one filler, so `padStart` and `padEnd` are asserted on the
// same arguments throughout — a difference between them on anything but WHICH
// SIDE the fill lands is a bug in the shared core.
import { padEnd, padStart, repeat } from "std:str"

// repeat: n copies, no separator.
print("[" + "ab".repeat(3) + "]")        // [ababab]
print("[" + "ab".repeat(1) + "]")        // [ab]
print("[" + "x".repeat(5) + "]")         // [xxxxx]
// n <= 0 is EMPTY, not a trap. JS throws a RangeError on a negative count and
// Rust/Go panic; VL reserves traps for bugs, and a count computed down past
// zero reads as "nothing to emit" rather than as a broken program.
print("[" + "ab".repeat(0) + "]")        // []
print("[" + "ab".repeat(-1) + "]")       // []
print("[" + "ab".repeat(-1000) + "]")    // []
// An empty receiver repeats to empty however many times it is asked.
print("[" + "".repeat(3) + "]")          // []
print("[" + "".repeat(0) + "]")          // []
print("ab".repeat(100).length)           // 200

// padStart / padEnd with a ONE-character pad — the ordinary case.
print("[" + "7".padStart(3, "0") + "]")     // [007]
print("[" + "7".padEnd(3, "0") + "]")       // [700]
print("[" + "".padStart(3, "x") + "]")      // [xxx]
print("[" + "".padEnd(3, "x") + "]")        // [xxx]

// A MULTI-CHARACTER pad is tiled and TRUNCATED, so the result is exactly `len`
// long. That is the entire point of padding — a column that is sometimes one
// character wider is not a column — and it is what JS does.
print("[" + "5".padStart(4, "ab") + "]")    // [aba5]
print("[" + "5".padEnd(4, "ab") + "]")      // [5aba]
print("[" + "x".padStart(2, "abc") + "]")   // [ax]
print("[" + "x".padEnd(2, "abc") + "]")     // [xa]
print("[" + "".padStart(7, "abc") + "]")    // [abcabca]
print("5".padStart(40, "ab").length)        // 40

// `len` ALREADY REACHED, or shorter than the input: the input comes back
// untouched. Padding never TRUNCATES — a padder that shortened its argument
// would silently destroy data in exactly the logging and table code that calls
// it.
print("[" + "hello".padStart(3, "0") + "]")   // [hello]
print("[" + "hello".padEnd(3, "0") + "]")     // [hello]
print("[" + "hello".padStart(5, "0") + "]")   // [hello]
print("[" + "hello".padEnd(5, "0") + "]")     // [hello]
print("[" + "hello".padStart(-2, "0") + "]")  // [hello]
print("[" + "hello".padEnd(0, "0") + "]")     // [hello]

// An EMPTY pad is a no-op, not an infinite loop — the deficit can never be
// filled, so the honest answer is the input.
print("[" + "x".padStart(3, "") + "]")        // [x]
print("[" + "x".padEnd(3, "") + "]")          // [x]
print("[" + "".padStart(3, "") + "]")         // []
