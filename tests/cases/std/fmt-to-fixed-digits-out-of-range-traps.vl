// @trap
// `toFixed` takes 0 to 100 digits, as JS does, and a count outside that range is a
// caller bug: it traps naming itself rather than clamping to a string the caller did not
// ask for (D3565). 100 is the last accepted count, so the first line prints before the trap.
import { toFixed } from "std:fmt"

const wanted = 50 * 2
print(toFixed(1.5, wanted).length)
print(toFixed(1.5, wanted + 1))
