// @trap
// A NEGATIVE index traps too, and it is a SEPARATE compare from the past-the-end
// one: VL has no unsigned comparison operator, so the single `i u< length` trick
// the emitter uses for native arrays (`wasmEmit.emitListIdxGuard`) is not
// spellable in std VL and the check is two signed compares. This case pins the
// low half — element -1 of a view starting at byte 16 is byte 12, which is in
// the `Buf` and would return the PRECEDING column's bytes.
//
// Inverted control: `buffer-view-bounds-control.vl` (a `@trap` case cannot carry
// asserted `@log` output — see that file's header).
import { Buffer, getI32, i32view, setI32, storeI32 } from "std:buffer"

const b = Buffer(64)
b.storeI32(12, 4242) // what an unchecked `id[-1]` would return
const id = b.i32view(16, 2)
id.setI32(0, 7)
const under = id.getI32(-1)
print(under)
