// @run
// @log 1
// @log 2
// @log true
// @log 2
// @log 1
// @log 2
// @log true
// @log 2
// @log false
// @log true
// @log false
// @log 1
// @log 2
// @log true
// @log 3
// @log 1
// @log 2
// @log true
// @log 3
// @hint redundant type annotation: `xs` is inferred as `(K | null)[][]`
// @hint redundant type annotation: `xs` is inferred as `(boolean | null)[][]`
// @hint redundant type annotation: `nd` is inferred as `(boolean | null)[]`
// THE `@hint` LINES ARE DELIBERATE: the annotations are what pin the element rep each row is
// about, so the redundancy hints are declared rather than silenced by deleting them.
//
// GRADUATED from `silent-class-inventory` D45, and from the `K[]` row of
// `tests/cases/std/error-array-needle-not-equatable.vl`, which pinned the refusal this
// removes. A LITERAL-UNION LIST handed to a `std:array` export's `needle: T` used to be a
// loud `vl check` reject carrying TWO sentences; the first of them was FALSE about the shape
// and the second was false about this backing.
//
// WHAT WAS WRONG WITH THE FIRST SENTENCE. `isEquatable` answered false for every `TyUnion`,
// so a list whose element is `type K = "a" | "b"` was "not value-comparable (a field is not
// value-comparable)" — while a literal union has no field at all. It reps as ONE cell: the
// interned i32 ATOM for a string union, the BASE SCALAR for a numeric one. Measured one line
// each and unchanged by this fix: `K == K` over two `K` bindings runs and prints the right
// answer, and `string[] == string[]` runs. The element compared, the container shape compared,
// and the refusal named a component that is fine.
//
// WHAT WAS WRONG WITH THE SECOND. `eqCmpKindOfArrayElem` spells its accept set as two prim
// names (`i32`, `boolean`) and answered "none" for everything else, so a literal-union element
// had no list core — but `K[]` IS that i32 list (`tyAnnRefListKind`'s litunion arms pick the
// i32 wrapper), so `emitListEqICore` was its core all along. The `+` home next door had
// already decided this exact question the other way: `concatElemIsI32Backed` accepted the
// whole literal family through `tyUnionAllLits`, and `("a"|"b")[] + ("a"|"b")[]` has always
// concatenated. Two operators, one rep question, two answers — which is the drift both
// headers exist to prevent. (It accepted too MUCH, which is D102: `tyUnionAllLits` admitted
// every literal BASE and is now deleted, and the two homes share one backing predicate.)
//
// THE SPLIT IS BY BACKING AND THE HONEST HALF STAYED. Only the i32-backed unions gained the
// core — a STRING union (the atom) and a NUMERIC one whose base is `i32`. An `f64`-based
// union rides the f64 list, whose `==` has no core at all, so `F[]` is still refused and the
// sentence it prints now names only the missing lowering. That row lives in
// `error-array-needle-not-equatable.vl`, where its symmetry with `Circle[]` is the point.
//
// THE `| null` SPELLINGS ARE THE SECOND GRADUATION, from `silent-class-inventory` D101, and
// they are here rather than in a file of their own because the axis is the same one: the rep
// of the ELEMENT, asked through a `needle: T`. D45 taught the `==` home the arm on `TyUnion`;
// `K | null` resolves to a `TyNullable`, so the same programs were still refused one spelling
// over — with BOTH sentences, while `(K | null)[] + (K | null)[]` concatenated. Its
// `boolean | null` twin is the identical divergence and is pinned beside it: those two are the
// only nullables that niche into an i32 (`repOfNullable`'s `rdNul` 3 and 2) rather than a
// `(ref null …)` ref or a value box.
//
// THE BOUNDARY IS STILL A `needle: T` ROW IN THE ERROR FILE, and it is now `(N | null)[]` —
// the NUMERIC litunion's nullable, whose spelling is identical and whose rep is a box. Two
// adjacent rows in two files, differing in one member's `litKind`, is the cheapest statement
// of what the fix actually keyed on.
//
// ALL FOUR `needle: T` EXPORTS AND BOTH BACKINGS, each pinned to a DIFFERENT answer so one
// name cannot stand in for another — the discipline `array-needle-union-arm.vl` states.
//
// **AND IT IS A CLAIM ABOUT SUBSTITUTABILITY, NOT ABOUT DISTINCT NUMERALS**, which is how the
// eight `| null` rows first failed it while looking like they passed: `lastIndexOf` and
// `count` both answered `2`, and swapping either name in at the other's receiver printed the
// pinned value — so one name COULD stand in for another and the file said otherwise. The
// `count` receivers carry a third occurrence for that reason, which makes them answer `3`
// where `lastIndexOf` answers `2`. Found by the `std-api-reviewer` pass over D101's close, by
// running the substitution rather than by reading the numerals.
import { count, includes, indexOf, lastIndexOf } from "std:array"

type K = "a" | "b"
type N = 1 | 2
type LK = K | null

// ── the STRING literal union: the interned i32 atom ──
function kIndexOf() {
  const nd: K[] = ["b"]
  const xs: K[][] = [["a"], ["b"], ["a"], ["b"]]
  return xs.indexOf(nd)
}

function kLastIndexOf() {
  const nd: K[] = ["a"]
  const xs: K[][] = [["b"], ["a"], ["a"]]
  return xs.lastIndexOf(nd)
}

function kIncludes() {
  const nd: K[] = ["b"]
  const xs: K[][] = [["a"], ["b"]]
  return xs.includes(nd)
}

function kCount() {
  const nd: K[] = ["a"]
  const xs: K[][] = [["a"], ["b"], ["a"]]
  return xs.count(nd)
}

// ── the NUMERIC literal union whose base is i32: the same list, a different rep story ──
function nIndexOf() {
  const nd: N[] = [2]
  const xs: N[][] = [[1], [2], [1]]
  return xs.indexOf(nd)
}

function nLastIndexOf() {
  const nd: N[] = [1]
  const xs: N[][] = [[1], [2], [1]]
  return xs.lastIndexOf(nd)
}

function nIncludes() {
  const nd: N[] = [2]
  const xs: N[][] = [[1], [2]]
  return xs.includes(nd)
}

function nCount() {
  const nd: N[] = [1]
  const xs: N[][] = [[1], [2], [1]]
  return xs.count(nd)
}

// ── THE DIRECT SPELLING, which is what the refusal was measured against. The point of
//    keeping it here is the same one the error fixture's control makes: one home, one
//    sentence, and where the routed call runs the direct one must too. ──
function directNe() {
  const a: K[] = ["a"]
  const b: K[] = ["b"]
  return a == b
}

function directEq() {
  const a: K[] = ["a", "b"]
  const b: K[] = ["a", "b"]
  return a == b
}

// ── LENGTH is part of the core, not just the elements: a prefix must not compare equal. ──
function directLen() {
  const a: K[] = ["a"]
  const b: K[] = ["a", "b"]
  return a == b
}

// ── the ATOM-SENTINEL nullable (D101), all four exports. The needle carries a `null`, so a
//    compare that could not tell the spare `-1` from an atom id would answer a different
//    index here — which is the whole reason these are pinned by ANSWER.
//
//    EVERY INNER LIST IS AN ANNOTATED LOCAL rather than a nested literal, and that is not
//    style: a bare `null` inside a NESTED array literal (`[[null]]`) is a loud
//    `emitProgram: bare null needs a struct-typed context` on master with no `==` in the
//    program at all — `silent-class-inventory` D117, pre-existing and filed by this change.
//    Writing the rows this way keeps the fixture measuring THIS row's rep question. ──
function nkIndexOf() {
  const nd: (K | null)[] = [null]
  const av: (K | null)[] = ["a"]
  const xs: (K | null)[][] = [av, nd, av, nd]
  return xs.indexOf(nd)
}

function nkLastIndexOf() {
  const nd: (K | null)[] = ["a", null]
  const av: (K | null)[] = ["a"]
  const xs: (K | null)[][] = [nd, av, nd]
  return xs.lastIndexOf(nd)
}

function nkIncludes() {
  const nd: (K | null)[] = [null, "b"]
  const av: (K | null)[] = ["a"]
  const xs: (K | null)[][] = [av, nd]
  return xs.includes(nd)
}

function nkCount() {
  const nd: LK[] = [null]
  const av: LK[] = ["a"]
  const xs: LK[][] = [nd, av, nd, nd]
  return xs.count(nd)
}

// ── the BOOLEAN-SENTINEL twin, whose spare is `2` rather than `-1`. `[null]` must not match
//    `[false]`, which is the row a folded sentinel would fail. ──
function nbIndexOf() {
  const nd: (boolean | null)[] = [null]
  const fv: (boolean | null)[] = [false]
  const tv: (boolean | null)[] = [true]
  const xs: (boolean | null)[][] = [fv, nd, tv]
  return xs.indexOf(nd)
}

function nbLastIndexOf() {
  const nd: (boolean | null)[] = [true]
  const fv: (boolean | null)[] = [false]
  const xs: (boolean | null)[][] = [nd, fv, nd]
  return xs.lastIndexOf(nd)
}

function nbIncludes() {
  const nd: (boolean | null)[] = [null, true]
  const ft: (boolean | null)[] = [false, true]
  const xs: (boolean | null)[][] = [ft, nd]
  return xs.includes(nd)
}

function nbCount() {
  const nd: (boolean | null)[] = [false]
  const nv: (boolean | null)[] = [null]
  const xs: (boolean | null)[][] = [nd, nv, nd, nd]
  return xs.count(nd)
}

print(kIndexOf())
print(kLastIndexOf())
print(kIncludes())
print(kCount())
print(nIndexOf())
print(nLastIndexOf())
print(nIncludes())
print(nCount())
print(directNe())
print(directEq())
print(directLen())
print(nkIndexOf())
print(nkLastIndexOf())
print(nkIncludes())
print(nkCount())
print(nbIndexOf())
print(nbLastIndexOf())
print(nbIncludes())
print(nbCount())
