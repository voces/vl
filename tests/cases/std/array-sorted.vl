// @run
// @log 0
// @log 1
// @log 7
// @log 1,2,3
// @log 1,2,3
// @log 1,2,3
// @log 5,5,5,5
// @log 1,1,1,4,4,9
// @log 3,2,1
// @log 0,5,6,10,10,12,15,17,21,21,25,28,32,35,35,38,38,40,40,41,42,45,47,51,53,54,58,61,63,68,69,69,70,75,86,87,87,88,91,97
// @log true
// @log true
// @log true
// @log 3,1,2
// @log 3,1,2
// @log Apple Fig apple fig pear
// @log a
// @log b
// @log c
// `std:array.sorted` — the shape of the answer, and the seven input shapes a sort
// gets wrong when it gets anything wrong: empty, one element, already ascending,
// exactly descending, all-equal, duplicates around distinct keys, and a length that
// crosses the SORT_RUN=16 base-case boundary so the BOTTOM-UP MERGE runs at all.
// (`array-sorted-stability.vl` pins the tie rule, `array-sorted-comparator.vl` the
// contract on `less`. This file is the ordering itself.)
//
// `sorted` BUILDS — it returns a new list and leaves the receiver alone, like the rest
// of the BUILDING family. Two prints below exist only to pin that, because `std:array`
// also exports the mutating `sort`, and telling the pair apart by name is the entire
// safety story (`array-sort-inplace.vl` pins the mutating half).
import { count, sorted } from "std:array"
import { join, toString } from "std:fmt"

// The comparator is a boolean STRICT less-than. `ltI`/`gtI` are ordinary top-level
// functions passed as values (VL's first-class function support), not closures — the
// same shape `cli.cliDiagLess` and `format.fmtNameLess` already have in the compiler.
function ltI(a: i32, b: i32) { a < b }
function gtI(a: i32, b: i32) { a > b }

function show(xs: i32[]) {
  const parts: string[] = []
  let i = 0
  while i < xs.length {
    parts.push(toString(xs[i]))
    i = i + 1
  }
  print(parts.join(","))
}

// ── the degenerate lengths ────────────────────────────────────────────────────
// n = 0 and n = 1 return before the base case runs at all; both still return a NEW
// list, so `.length` is the only thing to check.
const empty: i32[] = []
print(empty.sorted(ltI).length)
const one = [7].sorted(ltI)
print(one.length)
print(one[0])

// ── n <= SORT_RUN: the insertion base case, no merge ──────────────────────────
show([3, 1, 2].sorted(ltI))
show([1, 2, 3].sorted(ltI))          // already ascending — unchanged
show([3, 2, 1].sorted(ltI))          // exactly descending — fully reversed
show([5, 5, 5, 5].sorted(ltI))       // all equal — a no-op that must not loop
show([4, 1, 4, 1, 9, 1].sorted(ltI)) // duplicates interleaved with distinct keys

// A DESCENDING order is the same call with the comparator flipped — there is no
// `reverse: true` parameter and no second export, because `less` already says it.
show([3, 1, 2].sorted(gtI))

// ── n > SORT_RUN: the merge passes actually run ───────────────────────────────
// 40 elements = 3 base runs (16 + 16 + 8) and two merge doublings (16→32→64), so both
// the ODD final block and the truncated final merge are exercised. The stream is
// MINSTD so the values are reproducible and unsorted; the assertion is that the
// result is ascending and holds exactly the same multiset.
const big: i32[] = []
let seed = 1
let i = 0
while i < 40 {
  seed = (seed * 75) % 65537
  big.push(seed % 100)
  i = i + 1
}
const s = big.sorted(ltI)
show(s)

// Ascending, and a permutation: same length, and every element of the input is still
// present the same number of times.
let ascending = true
i = 1
while i < s.length {
  if s[i - 1] > s[i] { ascending = false }
  i = i + 1
}
print(ascending)
print(s.length == big.length)
let sameMultiset = true
i = 0
while i < big.length {
  if big.count(big[i]) != s.count(big[i]) { sameMultiset = false }
  i = i + 1
}
print(sameMultiset)

// ── the receiver is untouched ────────────────────────────────────────────────
// `xs.sorted(less)` is not `xs.sort(less)` — and BOTH now exist, so the distinction is
// live rather than hypothetical. VL lists are reference types, so `sort` reorders every
// binding that aliases the list while `sorted` reorders none of them; the past
// participle is the whole signal, and this is the proof for its half.
// (`array-sort-inplace.vl` is the proof for the other half.)
const orig = [3, 1, 2]
const alias = orig
orig.sorted(ltI) // result deliberately discarded — the point is that this is a no-op
show(orig)
show(alias)

// ── the element type is generic ───────────────────────────────────────────────
// The SAME definition over `string[]`, with `<` being VL's lexicographic string
// ordering. Post-#1848 that is a BYTE comparison; for UTF-8 byte order and code-point
// order coincide, so this is still code-point-lexicographic. Case-sensitive ASCII, so
// capitals sort before lowercase — the same rule `format.fmtNameLess` documents.
const names = ["pear", "Apple", "fig", "apple", "Fig"]
print(names.sorted((a: string, b: string) => a < b).join(" "))

// ── the INLINE literal-union element ──────────────────────────────────────────
// The one element type whose ARRAY rep and whose SCALAR rep disagree: `("a" | "b" | "c")[]`
// is an array of interned i32 ATOMS (`ctxKeepsLitUnion` preserves the members at `RC_ELEM`)
// while `"a" | "b" | "c"` in a scalar position is a string ref (it softens them at
// `RC_ROOT`), so every element leaving the array crosses a WIDEN. `sorted`'s body crosses
// it at four places — `const key = out[k]`, `out[j + 1] = out[j]`, and the comparator's two
// parameters — and until the last two of those closed, this three-line program was a module
// the engine refused: `vl check` rc 0 — the ONLY command that missed it — and
// `type mismatch: expected (ref $type), found i32` at load. It was pinned as
// `tests/cases/std/xfail-miscompile-array-litunion-element.vl`, whose header carried the map
// of the two boundaries; `soundness/generic-litunion-element-bind-and-store.vl` now carries
// the mechanism, and this is the row that file's header says `array-sorted.vl` gains.
//
// THE ORDER IS THE ASSERTION, not merely that it runs. The comparison must be on the member
// TEXT: an ordering by interned ID would hand back the INPUT order, because the ids are
// assigned in first-appearance order. `c` first in, `a` first out.
const tags: ("a" | "b" | "c")[] = ["c", "a", "b"]
const st = tags.sorted((x: "a" | "b" | "c", y: "a" | "b" | "c") => x < y)
print(st[0])
print(st[1])
print(st[2])
