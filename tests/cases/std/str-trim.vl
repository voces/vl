// @run
// @log [a b]
// @log [a b  ]
// @log [  a b]
// @log [abc]
// @log [abc]
// @log [abc]
// @log [abc]
// @log [abc]
// @log [ abc]
// @log [abc ]
// @log []
// @log []
// @log []
// @log []
// @log []
// @log []
// @log [x]
// @log 1
// @log true
// @log true
// @log true
// @log [a  b]
// `std:str` TRIM — `trim` / `trimStart` / `trimEnd` over the six ASCII
// whitespace characters, and the all-blank string that makes the two bounds
// cross.
//
// Results print inside `[]` so a trailing space survives the `@log` comparison
// visibly instead of being an invisible difference at the end of a line — which
// is the whole subject of this file.
//
// The set is space, tab, newline, vertical tab, form feed, carriage return, and
// NOTHING ELSE: `\v` and `\f` are in because C's `isspace` and Go's
// `TrimSpace` both start from the same six, and NBSP (U+00A0) is out because
// trimming it is a Unicode decision that belongs to a future `std:unicode`.
// `std:str`'s header records why that asymmetry with `toUpperAscii`'s name is
// deliberate rather than an oversight.
import { trim, trimEnd, trimStart } from "std:str"

print("[" + "  a b  ".trim() + "]")        // [a b] — INTERIOR space survives
print("[" + "  a b  ".trimStart() + "]")   // [a b  ]
print("[" + "  a b  ".trimEnd() + "]")     // [  a b]
// Nothing to remove: the input comes back as it arrived.
print("[" + "abc".trim() + "]")            // [abc]
print("[" + "abc".trimStart() + "]")       // [abc]
print("[" + "abc".trimEnd() + "]")         // [abc]
// One side only.
print("[" + " abc".trim() + "]")           // [abc]
print("[" + "abc ".trim() + "]")           // [abc]
print("[" + " abc".trimEnd() + "]")        // [ abc]
print("[" + "abc ".trimStart() + "]")      // [abc ]
// ALL BLANK — `spanStart` reports `length` and `spanEnd` reports 0, so the two
// bounds cross; every one of the three must answer "".
print("[" + "     ".trim() + "]")          // []
print("[" + "     ".trimStart() + "]")     // []
print("[" + "     ".trimEnd() + "]")       // []
// The EMPTY string is the degenerate all-blank case.
print("[" + "".trim() + "]")               // []
print("[" + "".trimStart() + "]")          // []
print("[" + "".trimEnd() + "]")            // []
// Every character of the set, on both sides of one letter.
print("[" + " \t\n\v\f\rx\r\f\v\n\t ".trim() + "]")   // [x]
print(" \t\n\v\f\rx\r\f\v\n\t ".trim().length)        // 1
// A character NOT in the set is not whitespace, even when it LOOKS like it: a
// no-break space (U+00A0) and a zero-width space (U+200B) survive a trim.
// Built with `fromCodePoint` and asserted with `==` rather than measured with
// `.length`, because `.length` is in whatever unit the core's index currently
// is (a code point today, a UTF-8 byte after `strings-design.md` §Storage) and
// a length assertion over a multi-byte character would pin the REPRESENTATION
// instead of this module. Byte equality is true in either world.
const nbsp = fromCodePoint(160)
const zwsp = fromCodePoint(8203)
print(("" + nbsp + "x" + nbsp).trim() == "" + nbsp + "x" + nbsp)   // true
print(("" + zwsp + "x").trim() == "" + zwsp + "x")                 // true
// ...but ASCII whitespace AROUND one still goes.
print((" " + nbsp + "x ").trim() == "" + nbsp + "x")               // true
// Whitespace INSIDE is never touched, at any of the three.
print("[" + "  a  b  ".trim() + "]")       // [a  b]
