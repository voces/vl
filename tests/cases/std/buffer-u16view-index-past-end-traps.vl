// @trap
// Element 4 of a 4-element u16 view at byte 9 is byte 17: inside the `Buf`.
// The view traps instead of returning the neighbour (77).
// Inverted control: `buffer-narrow-views.vl` reads element 3.
import { Buffer, store16, u16view } from "std:buffer"

const b = Buffer(64)
b.store16(17, 77)
const o = b.u16view(9, 4)
print(o[4])
