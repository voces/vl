// @log false
// `some` and `every` from `std:array`: the hand-loop-with-a-flag they replace, over
// an i32 list, an empty list, a struct element type, and closures that capture a
// local. A predicate that counts its own calls proves both stop at the deciding
// element and never see the rest.
import { every, some } from "std:array"

type Unit = { name: string, hp: i32 }

const ids = [3, 7, 9]
const id = 7
print(ids.some((i) => i == id))
print(ids.some((i) => i == 8))

const none: i32[] = []
print(none.some((i) => i == i))
print(none.every((i) => i != i))

print(ids.every((i) => i > 0))

let calls = 0
print(
  ids.some((i) => {
    calls = calls + 1
    i == 7
  }),
)
print(calls)

calls = 0
print(
  ids.every((i) => {
    calls = calls + 1
    i < 5
  }),
)
print(calls)

calls = 0
print(
  ids.every((i) => {
    calls = calls + 1
    i < 100
  }),
)
print(calls)

const units: Unit[] = [{ name: "a", hp: 5 }, { name: "b", hp: 0 }]
const floor = 1
print(units.some((u) => u.hp < floor))
print(units.every((u) => u.hp >= floor))
print(units.some((u) => u.name == "b"))
print(every(units, (u) => u.name.length == 2))
print(some(["x", "y"], (s) => s == "y"))
print(some(["x", "y"], (s) => s == "z"))
