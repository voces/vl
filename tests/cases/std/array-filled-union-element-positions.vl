// @run
// @log 3
// @log true
// @log 2.5
// @log s
// @log g
// `filled` at a union element type: the fill is already the box of that union, so it fills the
// list as it stands: a value union, a `T | null`, a numeric join, a record union, and at the top
// level.
import { filled } from "std:array"

type R = { a: i32 } | { b: string }
function valueUnion() {
  const v: i32 | string = 3
  const xs = filled(2, v)
  print(xs[1])
}
function nullable() {
  const v: f32 | null = null
  const xs = filled(3, v)
  print(xs[2] == null)
}
function numericJoin(q: i32 | null, b: f64) {
  const xs = filled(2, q ?? b)
  print(xs[1])
}
function recordUnion() {
  const r: R = { b: "s" }
  const xs = filled(2, r)
  if xs[0] is { b: string } { print(xs[0].b) }
}
valueUnion()
nullable()
numericJoin(null, 2.5)
recordUnion()
const gv: i32 | string = "g"
const gx = filled(2, gv)
print(gx[0])
