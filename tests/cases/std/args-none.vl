// @run
// @skip the args floor needs a host that can build a WasmGC value — V8 cannot; asserted natively by tests/selfhost_native_align_test.ts
// @log 0
// @log true
// @log []
// @log 0
// `std:args` WITH NO ARGUMENTS — the only argument vector the corpus can drive.
//
// It is `@skip`ped under the V8 harness for the same measured reason as
// `std/fs-roundtrip.vl`: `__args_get__` returns `u8[]`, a WasmGC array, and JS can
// neither read one nor construct one, so `tests/support/runWasm.ts` stubs it (and
// `__args_count__` alongside it) with a throw. `@skip` is honoured by
// cases_wasm_test.ts and IGNORED by selfhost_native_align_test.ts, so coverage is
// relocated rather than lost.
//
// THE VECTOR IS FIXED AT EMPTY, and that is a property of the harness rather than a
// choice: the RUN tier is driven through `vl run --batch`, which never reaches the
// host's `set_program_args` — several programs share one process there, so "the
// program's arguments" has no meaning — and the per-case `vl check` leg passes no
// arguments either. A corpus case therefore CANNOT be handed an argv. The vector
// that varies is asserted in `tests/vl_std_args_test.ts`, which spawns
// `vl run <file> -- a b c` itself; this file pins what the corpus can see, which is
// the zero case plus the fact that the module links, lowers and narrows at all.
import { programArgs } from "std:args"
import { join } from "std:fmt"
import { Utf8Error } from "std:utf8"

const args = programArgs()

// NO ARGUMENTS IS NOT A FAILURE. The union narrows to `string[]`, and being given
// nothing answers with an empty array rather than an error or a null — the whole
// reason this returns a list instead of a count plus an indexed getter is that
// "there is no argument 3" needs no third policy to express.
if args is Utf8Error {
  print("decode failed: " + args.msg)
} else {
  print(args.length)
  print(args.length == 0)
  // COMPOSES WITH THE GENERIC SURFACE, which is the other half of that decision:
  // `string[]` is a `T[]`, so `std:fmt`'s `join` and `std:array`'s helpers reach
  // it by UFCS. A `u8[]` would reach none of them.
  // Bracketed so the empty join is a VISIBLE `[]` rather than a blank line: the
  // corpus's `@log` directive is `@log <text>` and cannot spell an empty one.
  print("[" + args.join(",") + "]")
  // `programArgs()` is a plain call and not a cursor: calling it twice is two
  // independent lists, with no ambient position and no order dependence between
  // them. The errno the floor uses to separate an empty argument from a failed
  // one never leaves the module.
  const again = programArgs()
  if again is Utf8Error {
    print("second call failed")
  } else {
    print(again.length)
  }
}
