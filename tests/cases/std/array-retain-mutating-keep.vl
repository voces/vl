// @run
// @log 2
// @log 2
// @log 4
// `keep` must not change `self`: a push from inside it is dropped, so only the
// kept elements of the original length remain.
import { retain } from "std:array"

const xs = [1, 2, 3, 4]
xs.retain((x) => {
  xs.push(x * 10)
  x % 2 == 0
})
print(xs.length)
print(xs[0])
print(xs[1])
