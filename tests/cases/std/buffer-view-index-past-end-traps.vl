// @trap
// THE BOUNDS POLICY, AND WHY IT DIFFERS FROM THE REST OF THE TIER. Everywhere
// else in `std:buffer` there is no VL-level bounds check at all (§A4: `Buf`
// describes an extent, it does not fence it, and the engine's own trap is the
// memory-safety proof). A typed VIEW does check, because its failure mode is the
// one the engine cannot see: element 4 of a 4-element view is byte 16, which is
// inside this `Buf`, inside the memory, and inside the NEXT COLUMN. An unchecked
// read there returns a neighbour's bytes and no trap fires — a silent wrong
// answer in exactly the SoA kernels whose value is being byte-comparable with a
// twin. So the accessor traps on any index outside `[0, length)`.
//
// A `@trap` fixture asserts ONLY the trap — the harness does not check `@log`
// when `@trap` is set — so the "the access this prevented would have SUCCEEDED
// and returned 99.5" half cannot be pinned here. It is pinned as its own `@run`
// case in `buffer-view-bounds-control.vl`, which is this file's inverted control
// and must be read with it.
//
// (The mapped trap REASON is shared with every `__trap__` site — all lower to
// `unreachable` — so only the trap itself is pinned.)
import { Buffer, f32view, getF32, setF32, storeF32 } from "std:buffer"

const b = Buffer(64)
b.storeF32(16, 99.5) // the neighbour an unchecked read WOULD return
const x = b.f32view(0, 4)
x.setF32(0, 1.5)
const oob = x.getF32(4)
print(oob)
