// @run
// @log 3
// @log 12
// @log 99
// @log 99
// @log 8
// @log 0
// @log 0
// @log 0
// @log 8
// `window` — a sub-range of a `Buf` as a `Buf` over the SAME bytes, not a copy.
//
// A write through the window is visible through the parent at the matching offset, which
// is what separates it from `loadBytes`, the copying reader. Every edge of the range is
// in range here: the whole buffer, a zero-length window at the start and one AT the end.
// The out-of-range edges trap; `buffer-window-past-end-traps.vl` and
// `buffer-window-negative-traps.vl` pin those.
import { Buffer, loadU8, store8, window } from "std:buffer"

const b = Buffer(8)
let i = 0
while i < 8 {
  store8(b, i, 10 + i)
  i = i + 1
}

const w = window(b, 2, 3)
print(w.length)
print(loadU8(w, 0))

// The window aliases its parent: a store through it lands in `b` at 2 + 1.
store8(w, 1, 99)
print(loadU8(w, 1))
print(loadU8(b, 3))

print(window(b, 0, 8).length)
print(window(b, 0, 0).length)
print(window(b, 8, 0).length)

// A window of a window is still addressed from the parent's bytes.
const ww = window(w, 1, 0)
print(ww.length)
print(loadU8(window(w, 0, 1), 0) - 4)
