// @run
// @skip the fs floor needs a host that can build a WasmGC value — V8 cannot; asserted natively by tests/selfhost_native_align_test.ts
// @log wrote
// @log Hello, VL
// @log 9
// @log file
// @log true
// @log 44
// @log 31
// @log true
// `std:fs` END TO END — the module over the syscall floor, every export exercised.
//
// This is the first VL program that DOES something rather than computing and printing.
// Until the floor landed, the entire host import surface was seven print functions.
//
// It is `@skip`ped under the V8 harness and asserted natively, because the floor's
// intrinsics take and return `u8[]` — a WasmGC array — and JS can neither read one
// (it arrives opaque: `.length` undefined, `String(a)` throws) nor build one (`null`
// is the only value V8 accepts for a GC-ref result, and these results are non-null).
// That is measured, not assumed; `@skip` is honoured by cases_wasm_test.ts and IGNORED
// by selfhost_native_align_test.ts, so coverage is relocated rather than lost.
import {
  IoError,
  listDir,
  pathExists,
  pathKind,
  readFile,
  readTextFile,
  writeTextFile,
} from "std:fs"

const p = "/tmp/vl-std-fs-roundtrip.txt"

// WRITE returns `IoResult` — `IoError | null` — so success is literally nothing.
const w = writeTextFile(p, "Hello, VL")
if w != null { print("write failed: " + w.msg) } else { print("wrote") }

// TEXT round-trips through UTF-8 in both directions (`std:utf8` owns the codec).
const t = readTextFile(p)
if t is IoError { print("read failed") } else { print(t) }

// BYTES is a different function with a different type, not a flag on the same one:
// a file is bytes and text is a decoding on top. Nine ASCII bytes here.
const b = readFile(p)
if b is IoError { print("bytes failed") } else { print(b.length) }

// `pathKind`, not `stat` — it answers file-or-directory and nothing else, so it
// does not spend the name POSIX's `stat` has already claimed for size/mtime/mode.
const k = pathKind(p)
if k is IoError { print("kind failed") } else { print(k) }

// `pathExists` returns `boolean | IoError`, never a bare boolean: "absent" and
// "you may not look" are different facts and one boolean has to lie about one.
const e = pathExists(p)
if e is IoError { print("exists failed") } else { print(e) }

// ENOENT (44) — the error carries a code a caller can compare, not just prose.
const miss = readTextFile("/tmp/vl-std-fs-definitely-absent")
if miss is IoError { print(miss.code) } else { print("should have failed") }

// EISDIR (31) — produced by the OS's own failed read. `std:fs` does not pre-stat,
// which would cost a syscall on every read and open a TOCTOU window for nothing.
const dir = readTextFile("/tmp")
if dir is IoError { print(dir.code) } else { print("should have failed") }

// LISTING yields entry NAMES, and the separator is NUL rather than newline —
// a POSIX filename may contain 0x0A, so splitting on it would list `a\nb` as two
// files. NUL is the one byte a filename cannot hold.
const ls = listDir("/tmp")
if ls is IoError { print("list failed") } else { print(ls.length > 0) }
