// @run
// @log true
// @log true
// @log 8
// @log 9
// @log true
// @log true
// @log true
// @log 4
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
import { padEnd, padStart } from "std:str"

// §R1 IS RULED: `padStart`/`padEnd`'s `len` counts CODE POINTS, not bytes.
//
// `docs/internals/str-byte-semantics.md` §R1 surveyed five languages and found that NOT ONE
// measures padding width in bytes except C — the only one whose columns visibly misalign —
// and that Go, the byte-indexed language VL joins, went out of its way to differ from C on
// exactly this point and documented why: *"Width and precision are measured in units of
// Unicode code points, that is, runes. (This differs from C's printf where the units are
// always measured in bytes.)"*
//
// This file is the fixture that ruling did not have. Every OTHER `str-*.vl` file pins
// padding only through its invariants (never truncates, empty pad is a no-op), which hold
// under either reading — so a byte reading would have passed the whole suite while producing
// ragged columns on the first accented character it met.

// The load-bearing case. "héllo" is 5 code points and 6 bytes; padded to 8 it must get
// THREE spaces (5 + 3 = 8 characters), not two.
print(padStart("héllo", 8, " ") == "   héllo")
print(padEnd("héllo", 8, " ") == "héllo   ")

// The result is 8 code points wide and 9 BYTES long — the column lines up, and the byte
// length is simply not what a column is measured in.
print(padStart("héllo", 8, " ").cpLen())
print(padStart("héllo", 8, " ").length)

// An astral character counts ONE, where JS's UTF-16 index unit counts it as two and a byte
// reading would count it as four.
print(padStart("a\u{1F600}", 4, "-") == "--a\u{1F600}")

// A MULTI-BYTE PAD tiles by code point and truncates on a character boundary — never
// mid-sequence. Under the old `repeat`+`slice` spelling the truncation was a BYTE slice,
// which would have emitted a partial sequence here.
print(padStart("x", 4, "→") == "→→→x")
print(padEnd("x", 4, "→") == "x→→→")
print(padStart("x", 4, "→").cpLen())
print(padStart("x", 4, "ab") == "abax")

// The invariants, unchanged: never truncates, empty pad is a no-op, `len <= 0` is a no-op.
print(padStart("héllo", 3, "0") == "héllo")
print(padStart("héllo", 8, "") == "héllo")
print(padEnd("héllo", 0, " ") == "héllo")

// ASCII is unaffected — which is why nothing else in the suite moved.
print(padStart("7", 3, "0") == "007")
print(padEnd("ab", 5, ".") == "ab...")
