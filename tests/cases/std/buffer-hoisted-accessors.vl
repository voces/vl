// THE HOISTED VIEW ACCESSORS — `getF32At` / `setF32At` / `getI32At` / `setI32At`
// (webcraft P1.1 ask A1).
//
// The view accessors take the VIEW, so every access re-reads that struct's `base`
// and `length`, and nothing hoists those out of a loop. On the six-column SoA
// integrator A1 was filed on that is 24 `struct.get` per element — two descriptor
// fields times twelve accesses — and the same kernel over these four reads ZERO,
// with the identical 24 bounds traps. The shape is pinned by
// `tests/vl_buffer_view_bounds_shape_test.ts` (`soa-view` against `soa-at`); this
// file pins the SEMANTICS, which are the point of them being in std at all: the
// hoisted spelling must answer exactly what the view spelling answers.
//
// So every read below is written BOTH ways and printed twice. A divergence here
// means the two surfaces disagree about the same bytes, which is the one failure
// this pair must never have.
//
// The bounds traps have their own files (`buffer-hoisted-*-traps.vl`), because a
// `@trap` case cannot also assert `@log` output.
// @run
// @log 1.5
// @log 1.5
// @log 42
// @log 42
// @log -7
// @log -7
// @log 0
// @log 0
// @log 3
// @log 4
import {
  Buffer,
  byteAddrF32,
  byteAddrI32,
  f32view,
  getF32At,
  getI32At,
  i32view,
  setF32At,
  setI32At,
} from "std:buffer"

const buf = Buffer(128)

// ── f32: write through the hoisted pair, read back both ways ──
const fv = buf.f32view(0, 8)
const fb = fv.byteAddrF32(0)
const fn = fv.length
setF32At(fb, fn, 3, 1.5)
print(getF32At(fb, fn, 3)) // 1.5
print(fv[3]) // 1.5 — the view spelling sees the same bytes

// ── i32: and the other direction, written through the VIEW ──
const iv = buf.i32view(64, 8)
const ib = iv.byteAddrI32(0)
const inn = iv.length
iv[2] = 42
print(getI32At(ib, inn, 2)) // 42
print(iv[2]) // 42

// Negative values round-trip (the load is signed).
setI32At(ib, inn, 5, -7)
print(getI32At(ib, inn, 5)) // -7
print(iv[5]) // -7

// The FIRST and LAST elements are both in range — the fence is `[0, length)`,
// so index 0 and index `length - 1` must both answer rather than trap.
setI32At(ib, inn, 0, 0)
print(getI32At(ib, inn, 0)) // 0
print(iv[0]) // 0

// A shorter length narrows the fence without moving the base: the same address
// is reachable through the full extent and refused by the narrowed one (that
// refusal is the trap files' job; here it is just that the base is unchanged).
setI32At(ib, inn, 7, 3)
print(getI32At(ib, 8, 7)) // 3

// An extent taken from a DIFFERENT view of the same buffer addresses its own
// column — the accessors are pure address arithmetic over what they are handed.
const iv2 = buf.i32view(96, 4)
setI32At(iv2.byteAddrI32(0), iv2.length, 0, 4)
print(iv2[0]) // 4
