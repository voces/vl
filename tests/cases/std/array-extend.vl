// @log false
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @hint redundant type annotation: `gl` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `ys` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `e1` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `f2` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `circles` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `ss` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `nn` is inferred as `i32[][]` — remove it to lean on inference
// @hint redundant type annotation: `t1` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `fs` is inferred as `f64[]` — remove it to lean on inference
// @hint redundant type annotation: `bs` is inferred as `boolean[]` — remove it to lean on inference
// @hint redundant type annotation: `bag` is inferred as `{items: i32[]}` — remove it to lean on inference
// `std:array`'s in-place bulk append, and the cases its contract has to answer. `concat` is
// the copying twin; `extend` is for when the receiver IS the list being built. The alias case
// is DEFINED, not refused: the length is read once, so `a.extend(a)` doubles and terminates.
import { concat, extend } from "std:array"

const gl: i32[] = [1]

// The plain append: `other` is read, `self` grows, and `other` is left alone.
const xs: i32[] = [1, 2]
const ys: i32[] = [3, 4]
xs.extend(ys)
print(xs.length)
print(xs[2])
print(xs[3])
print(ys.length)

// An EMPTY source appends nothing; an EMPTY receiver takes the whole source.
const e1: i32[] = [1, 2]
const e2: i32[] = []
e1.extend(e2)
print(e1.length)

const f1: i32[] = []
const f2: i32[] = [7, 8, 9]
f1.extend(f2)
print(f1.length)
print(f1[0])

// The alias case, defined rather than refused: the length is read once, so a receiver that
// is also the source appends what it held on entry — it doubles, and it terminates.
const a: i32[] = [1, 2, 3]
a.extend(a)
print(a.length)
print(a[0])
print(a[3])
print(a[5])

// A covariant source: the receiver must be the wider list, and the reverse is refused in
// `error-array-extend.vl`. This is NOT the read-only parameter's doing — a mutable `other`
// accepts it too; what `readonly` buys is the body, where a write would be lost (D1799).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const shapes: Shape[] = [{ s: 1 }]
const circles: Circle[] = [{ r: 7 }, { r: 8 }]
shapes.extend(circles)
print(shapes.length)
const back = shapes[1]
if back is Circle { print(back.r) }

// A ref element type, the direct (non-UFCS) spelling, and an un-annotated receiver.
const ss: string[] = ["a"]
extend(ss, ["b", "c"])
print(ss.length)
print(ss[2])

const un = [1, 2]
un.extend([3])
print(un.length)

// A nested list element — the element is copied by reference, like every other append.
const nn: i32[][] = [[1]]
nn.extend([[2], [3]])
print(nn.length)

// The alias a caller actually hits: two names for one list, which no length test can see.
const t1: i32[] = [1, 2, 3]
const t2 = t1
t1.extend(t2)
print(t1.length)
print(t2.length)
print(t1[5])

// The element types the surface reaches, beyond the i32/string/nested-list above.
const i6: i64[] = [1]
i6.extend([2, 3])
print(i6.length)

const fs: f64[] = [1.5]
fs.extend([2.5, 3.5])
print(fs.length)
print(fs[2])

const bs: boolean[] = [true]
bs.extend([false, true])
print(bs.length)
print(bs[1])

// The receiver positions `push` is normally used in: a module global and a struct field.
gl.extend([2, 3])
print(gl.length)

type Bag = { items: i32[] }
const bag: Bag = { items: [1] }
bag.items.extend([2, 3])
print(bag.items.length)
print(bag.items[2])

// `concat`'s receiver widened with `extend`'s source, so the twins agree: a read-only list
// is a legal receiver under UFCS, and a narrower one is a legal source at both parameters.
function roView(): readonly i32[] { return [1, 2] }
const joined = roView().concat([3])
print(joined.length)
print(joined[2])
