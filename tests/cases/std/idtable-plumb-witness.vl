// @run
// @log 64 16
// @log 2
// @log 3
// @log none
// @log 7
// The shape plumb hand-rolls ten times as `(T | null)[]` grown by `push(null)`: tables keyed by
// one shared object-id space, so each is sparse, with deletes. Two tables of different value
// types, ids handed out in order across both. Only the type is imported: its methods need none.
import { toString } from "std:fmt"
import { IdTable } from "std:idtable"

type Tex = { w: i32, h: i32 }
type Buf = { size: i32 }
const texs = IdTable<Tex>()
const bufs = IdTable<Buf>()
let nextId = 0
function newId() {
  nextId += 1
  nextId
}

texs.set(newId(), { w: 64, h: 16 })
bufs.set(newId(), { size: 2 })
bufs.set(newId(), { size: 3 })
texs.set(newId(), { w: 7, h: 7 })

const t1 = texs.get(1)
if t1 != null { print(toString(t1.w) + " " + toString(t1.h)) }
const b2 = bufs[2]
if b2 != null { print(b2.size) }
bufs.delete(2)
const b3 = bufs.get(3)
if b3 != null { print(b3.size) }
if bufs.get(2) == null && texs.get(2) == null { print("none") }
const t4 = texs[4]
if t4 != null { print(t4.w) }
