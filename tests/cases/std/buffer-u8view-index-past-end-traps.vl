// @trap
// Element 8 of an 8-byte u8 view is byte 8: inside the `Buf`, the next
// column's first byte. The view traps instead of returning it (77).
// Inverted control: `buffer-narrow-views.vl` reads element 7.
import { Buffer, store8, u8view } from "std:buffer"

const b = Buffer(64)
b.store8(8, 77)
const t = b.u8view(0, 8)
print(t[8])
