// @trap
// A NEGATIVE LENGTH IS A CALLER BUG, AND IT TRAPS WITH A SENTENCE.
//
// Without the guard the length reaches `array.new` as an unsigned 4294967295 and the
// engine says `allocation size too large` — a message about the heap, for a program
// whose actual mistake is a sign error two lines earlier. `filled` refuses first and
// names itself, which is the whole difference the check buys.
//
// (`filled(0, v)` is NOT this case: an empty table is a legitimate answer, and
// `array-filled.vl` pins it.)
import { filled } from "std:array"

const wanted = 3 - 4
const t = filled(wanted, 0)
print(t.length)
