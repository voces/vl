// @run
// @hint redundant type annotation: `a` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log 1
// @log 3
// @log z
// `std:array`'s `sorted` with a comparator, in a module with a function whose tail is a member
// call on its parameter, called with its own result: the compiler trapped on this (D4290).

import { sorted } from "std:array"

function a(s: string): string { s.slice(1, s.length) }

const ys = sorted([3, 1, 2], (x: i32, y: i32) => x < y)
print(ys[0])
print(ys[2])
print(a(a("xyz")))
