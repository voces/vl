// @run
// @log 1
// @log 3
// @log 2
// @log false
// @log -1
// @log 1
// @log 2
// @hint redundant type annotation: `nd` is inferred as `{r: i32}`
// @hint redundant type annotation: `xs` is inferred as `{r: i32}[]`
// @hint redundant type annotation: `nd` is inferred as `{k: i32, n: string}`
// @hint redundant type annotation: `xs` is inferred as `{k: i32, n: string}[]`
// THE `: Circle` / `: Circle[]` ANNOTATIONS ARE THE TEST, which is why their redundancy
// hints are declared rather than obeyed: dropping them infers the INLINE shape `{r: i32}`,
// whose values are standalone-struct rows and never reach the variant table this file is
// about.
//
// D57 REACHED THROUGH `std:array`, and the reason it belongs in this directory rather than
// beside the direct compare: `indexOf` / `lastIndexOf` / `includes` / `count` all compare
// `needle: T` with `==`, so whatever the compare accepts IS these four functions' documented
// surface. Declaring `type Shape = Circle | Sq` used to take all four from `runs` to
// check-clean invalid wasm — inside `indexOf$m1`, one site, four names — with the union never
// mentioned again.
//
// NOTHING IN `std/array.vl` CHANGED. The needle's storage class did: an arm's values live in
// the variant table, and the emitter's `==` dispatch had only ever asked the standalone-struct
// one. The four signatures, their contracts and their carve-out count are exactly what they
// were; this file exists so a later change to the compare cannot quietly narrow them again
// without a std-visible test saying so.
//
// FIVE DISTINCT ANSWERS, ONE PER NAME, and that is deliberate. A first draft used a
// single-match list, where `indexOf`, `lastIndexOf` and `count` all print `1` and `cellMiss`
// printed `indexOf(...) + 2` — also `1`. Four lines of the expected block were then the same
// number, so emitting `lastIndexOf$m1` with `indexOf`'s body would have passed, and `includes`
// had no false-side pin at all. The list below holds the needle TWICE, at 1 and 3, so the four
// answers separate: `1`, `3`, `2`, `false`, `-1`.
//
// AND THE ARM IS NOT SINGLE-FIELD. `Named` carries a `string` beside its `i32`, with the
// needle's string BUILT AT RUNTIME rather than written as the same literal — so the fixture
// pins that an arm's string field compares BY VALUE (the standalone struct's rule) and that a
// difference in a NON-first field is seen. A compare that read only field 0 would pass a
// `Circle`-only file.
import { count, includes, indexOf, lastIndexOf } from "std:array"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

type Named = { k: i32, n: string }
type Tri = { t: i32 }
type Tagged = Named | Tri

function cell() {
  const nd: Circle = { r: 2 }
  const xs: Circle[] = [{ r: 1 }, { r: 2 }, { r: 3 }, { r: 2 }]
  return indexOf(xs, nd)
}

function cellLast() {
  const nd: Circle = { r: 2 }
  const xs: Circle[] = [{ r: 1 }, { r: 2 }, { r: 3 }, { r: 2 }]
  return lastIndexOf(xs, nd)
}

function cellCount() {
  const nd: Circle = { r: 2 }
  const xs: Circle[] = [{ r: 1 }, { r: 2 }, { r: 3 }, { r: 2 }]
  return count(xs, nd)
}

function cellIncludes() {
  const nd: Circle = { r: 7 }
  const xs: Circle[] = [{ r: 1 }, { r: 2 }, { r: 3 }, { r: 2 }]
  return includes(xs, nd)
}

function cellMiss() {
  const nd: Circle = { r: 9 }
  const xs: Circle[] = [{ r: 1 }, { r: 2 }, { r: 3 }, { r: 2 }]
  return indexOf(xs, nd)
}

// A multi-field arm whose string is assembled at run time — `"ab" + "ab"` is not the same
// object as the `"abab"` sitting in the list, so a reference compare would answer -1 here.
// Element 2 shares the needle's `k` and differs only in `n`, so the NON-first field has to
// discriminate for the answer to be 1 rather than 2.
function cellNamed() {
  const nd: Named = { k: 2, n: "ab" + "ab" }
  const xs: Named[] = [
    { k: 1, n: "abab" },
    { k: 2, n: "abab" },
    { k: 2, n: "zz" },
  ]
  return indexOf(xs, nd)
}

// …and the FIRST field the other way round, so neither position is taken on trust: three
// entries share `n == "zz"` and only the two with `k == 2` count.
function cellNamedCount() {
  const nd: Named = { k: 2, n: "zz" }
  const xs: Named[] = [{ k: 2, n: "zz" }, { k: 1, n: "zz" }, { k: 2, n: "zz" }]
  return count(xs, nd)
}

print(cell())
print(cellLast())
print(cellCount())
print(cellIncludes())
print(cellMiss())
print(cellNamed())
print(cellNamedCount())
