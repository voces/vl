// diderven DV-600 — the shaping trio: `clamp` (with `lo > hi` answering `hi`), `mix`
// exact at both ends, `smoothstep` with its hard step at `e0 == e1`.
import { clampF64, mixF64, smoothstepF64, clampF32 } from "std:math"

print(clampF64(3.0, 0.0, 1.0))
print(clampF64(-3.0, 0.0, 1.0))
print(clampF64(0.5, 0.0, 1.0))
print(clampF64(5.0, 3.0, 2.0))
print(mixF64(2.0, 6.0, 0.5))
print(smoothstepF64(1.0, 2.0, 0.5))
print(smoothstepF64(1.0, 2.0, 1.5))
print(smoothstepF64(1.0, 2.0, 9.0))
print(smoothstepF64(1.0, 1.0, 0.5))
print(smoothstepF64(1.0, 1.0, 1.0))
print(clampF32(0.5, 0.0, 1.0))
