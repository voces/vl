// @trap
// A NEGATIVE LENGTH IS A CALLER BUG, AND `zeroBytes` TRAPS NAMING ITSELF.
//
// Without the guard the length reaches the allocation as an unsigned 4294967295 and
// the engine reports a heap failure, for a program whose mistake is a sign error.
// `std:array.filled` makes the same choice (`array-filled-negative-traps.vl`).
// (`zeroBytes(0)` is NOT this case: `bytes-zero.vl` pins it as the empty list.)
import { zeroBytes } from "std:bytes"

const wanted = 3 - 4
const b = zeroBytes(wanted)
print(b.length)
