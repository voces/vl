// @run
// @log 7 195
// @log diff
// @log 4 233
// @log same
// A string's `length` and `charCodeAt` index its UTF-8 encoding, so a `charCodeAt` loop cannot rebuild
// a non-ASCII string. `std:utf16` is the unit-level view a UTF-16 API (Win32 `W` calls) needs.
import { toString } from "std:fmt"
import { decodeUtf16, encodeUtf16 } from "std:utf16"

const s = "a" + fromCodePoint(0xe9) + fromCodePoint(0x4e2d) + "b"
print(toString(s.length) + " " + toString(s.charCodeAt(1)))
let t = ""
for i in 0 until s.length { t = t + fromCodePoint(s.charCodeAt(i)) }
print(if t == s { "same" } else { "diff" })

// The same round trip through UTF-16 code units.
const u = encodeUtf16(s)
print(toString(u.length) + " " + toString(u[1]))
const back = decodeUtf16(u)
print(if back is string && back == s { "same" } else { "diff" })
