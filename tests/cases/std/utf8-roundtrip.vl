// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 10
// @log 10
// @log aé中😀
// @log 0
// @log 1
// `std:utf8` — the ENCODE/DECODE round trip at all four UTF-8 widths.
//
// UTF-8 transcoding needs NO Unicode database: it is range checks and bit shifts, so it
// is the one Unicode-adjacent thing that belongs in the language floor rather than behind
// an optional table module. (Case conversion, normalization, grapheme segmentation and
// collation DO need tables — those stay out; `docs/internals/concurrency-design.md` is not
// the home for that ruling but ROADMAP B7 carries the strings direction.)
//
// A VL string is an `i32` sequence of CODE POINTS and a file is BYTES, so every byte
// source — `std:fs`, argv, stdin, any future socket — crosses through here. That is why
// this lives in its own module rather than privately inside `std:fs`: two private copies
// is how two decoders with two different opinions about invalid input get shipped.
import { decodeUtf8, encodeUtf8, utf8Length } from "std:utf8"

// One code point per width: ASCII 1, Latin-1 2, CJK 3, emoji 4.
print(encodeUtf8("a").length)
print(encodeUtf8("é").length)
print(encodeUtf8("中").length)
print(encodeUtf8("😀").length)

// The four together, and `utf8Length` agrees with the encoder rather than re-deriving it.
const s = "aé中😀"
const b = encodeUtf8(s)
print(b.length)
print(utf8Length(s))

// Round trip is the identity on well-formed input.
const back = decodeUtf8(b)
if back is string { print(back) } else { print("ROUND TRIP FAILED") }

// The empty string is a real case, not a degenerate one — an empty FILE decodes here.
print(encodeUtf8("").length)

// The bytes are the ones the wire actually carries: `é` is C3 A9.
const e = encodeUtf8("é")
if e[0] == 195 && e[1] == 169 { print(1) } else { print(0) }
