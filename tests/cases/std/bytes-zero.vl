// @run
// @log 5
// @log 0
// @log 200
// @log 6
// @log 7
// @log 0
// @log 1
// @log 301990008
// @log 9
// @log 5
// @log 9
// @log 0
// @log hi
// @log 1
// @log 4000000
// `std:bytes.zeroBytes` — a zero-filled `u8[]` of a length chosen at run time.
//
// The byte-sized table a decoder fills by index: before it, the only spelling was a
// `push(0)` loop, since `filled` is generic and a type parameter never binds `u8`.
// Each value printed below proves something a `.length` alone could not: the fill is
// 0, a store keeps its byte, the list still grows, and it reaches every position a
// `u8[]` can be delivered to.
import { i32le, zeroBytes } from "std:bytes"
import { decodeUtf8Lossy } from "std:utf8"

type Frame = { data: u8[], n: i32 }

function mk(n: i32): u8[] { return zeroBytes(n) }

function sum(b: u8[]) {
  let s = 0
  for x in b { s = s + x }
  return s
}

// Every slot is 0, a store lands, and the list is an ordinary growable `u8[]`.
const b = zeroBytes(5)
print(b.length)
print(b[0] + b[4])
b[2] = 200
print(b[2])
b.push(7)
print(b.length)
print(b[5])

// Zero is the empty list, and it grows like one.
const e = zeroBytes(0)
print(e.length)
e.push(1)
print(e[0])

// Delivered as a receiver, a field, a list element, a return, a capture, an argument.
const g = zeroBytes(4)
g[0] = 0x78
g[3] = 0x12
print(g.i32le(0))
const f: Frame = { data: zeroBytes(8), n: 8 }
f.data[3] = 9
print(sum(f.data))
const rows = [zeroBytes(2), mk(3)]
rows[1][2] = 5
print(rows[0].length + rows[1].length)
const grab = () => g.length + rows[1][2]
print(grab())
print(sum(zeroBytes(10)))
const t = mk(2)
t[0] = 104
t[1] = 105
print(decodeUtf8Lossy(t))

// Into a nullable binding.
let m: u8[] | null = null
if f.n > 0 { m = zeroBytes(1) }
if m != null { print(m.length) }

// The size a consumer allocates per frame; the last byte is the one a short fill misses.
const big = zeroBytes(4000000)
big[3999999] = 0
print(big.length + big[3999999])
