// @trap
// THE RESERVED LOW REGION IS RESERVED IN BOTH DIRECTIONS. Releasing to a mark
// BELOW the heap base would drop the bump pointer into the kilobyte
// `std:buffer` promises never to hand out — the window that keeps address 0 out
// of every `Buf`, leaves a raw-address playground for programs that poke the
// bare intrinsics (§A3), and holds the host staging ABI's future home.
//
// Zero is the mark a caller reaches for when they mean "everything", and it is
// the one value that must not work. (Reason text shared with every `__trap__`
// site — only the trap is pinned.)
import { Buffer, bufferRelease } from "std:buffer"

const b = Buffer(16)
bufferRelease(0)
print(b.length)
