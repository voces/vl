// @run
// @log 2
// diderven DV-500 — `exit` returns `never`, so `if x is E { exit(1) }` leaves `x`
// narrowed after it and a function may end in `exit` with no dummy value.
import { exit } from "std:process"

type Fail = { why: string }
function pick(ok: boolean): string | Fail {
  if ok { return "ab" }
  return { why: "no" }
}
function die(): string { exit(3) }
const x = pick(true)
if x is Fail { exit(1) }
print(x.length)
if x.length > 5 { print(die()) }
