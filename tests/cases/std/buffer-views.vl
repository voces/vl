// @run
// @log 1.5
// @log -2.5
// @log 4
// @log 1.5
// @log -2.5
// @log 7.25
// @log 1069547520
// @log 168496141
// @log 168496141
// @log 2
// @log 0
// @log 8
// @log 16
// @log 99.5
// @log 99.5
// @log 3
// @log 0
// TYPED VIEWS over a `Buf` (webcraft P1.1): `buf.f32view(off, count)` /
// `buf.i32view(off, count)` re-describe a byte range in ELEMENTS, and every
// access is cross-checked HERE AGAINST THE RAW BYTE ACCESSOR rather than against
// another view — a view and its own reader agreeing proves nothing, a view and
// `Buf.loadI32` agreeing proves the address arithmetic.
//
// Element `i` of a 4-byte view starting at byte `off` is at byte `off + i*4`.
// That is asserted three ways: by reading the view's write back through
// `Buf.loadF32` at the computed offset, by reading a raw write back through the
// view, and by `byteAddrF32` naming the ABSOLUTE address the two agree on.
import {
  Buffer,
  byteAddrF32,
  f32view,
  getF32,
  getI32,
  i32view,
  loadF32,
  loadI32,
  setF32,
  setI32,
  storeF32,
} from "std:buffer"

const b = Buffer(64)
const x = b.f32view(0, 4)

// View writes, view reads.
x.setF32(0, 1.5)
x.setF32(3, -2.5)
const a0 = x.getF32(0)
print(a0)
const a3 = x.getF32(3)
print(a3)
print(x.length) // 4 — the ELEMENT count, a plain struct field

// The same bytes through the raw byte-offset accessor: element 3 is byte 12.
const r0 = b.loadF32(0)
print(r0)
const r3 = b.loadF32(12)
print(r3)

// The other direction: a raw write at byte 4 is element 1 of the view.
b.storeF32(4, 7.25)
const a1 = x.getF32(1)
print(a1)
// And the f32 bit pattern is the ordinary one — a view stores no tag, no header.
const bits = b.loadI32(0)
print(bits) // 1069547520 == f32 1.5

// An i32 view over a DISJOINT range of the same `Buf`.
const id = b.i32view(16, 2)
id.setI32(0, 168496141)
const q = id.getI32(0)
print(q)
const rq = b.loadI32(16)
print(rq)
print(id.length)

// The f32 view is untouched by the i32 view's writes — the two do not overlap.
const untouched = x.getF32(2)
print(untouched) // 0

// ABSOLUTE byte addresses. `byteAddrF32(x, i)` is what a caller mixing views
// with the bare intrinsics needs; it is unchecked, and the one-past-the-end
// address is the useful answer for a range rather than an error.
const addr0 = x.byteAddrF32(0)
const addr2 = x.byteAddrF32(2)
const addr4 = x.byteAddrF32(4)
print(addr2 - addr0) // 8  == 2 elements * 4 bytes
print(addr4 - addr0) // 16 == the one-past-the-end address, 4 elements on

// ALIASING: two views over the SAME bytes see each other's writes. Views are
// descriptors over linear memory, not copies of it — this is the render-publish
// ring's requirement and the reason a view carries no state of its own.
const y = b.f32view(0, 4)
y.setF32(2, 99.5)
const viaX = x.getF32(2)
print(viaX)
const viaRaw = b.loadF32(8)
print(viaRaw)

// PARTIAL overlap, and an offset view: `z` starts at element 1 of `x`, so
// `z[0]` IS `x[1]`.
const z = b.f32view(4, 3)
print(z.length)
z.setF32(0, 0.0)
const back = x.getF32(1)
print(back) // 0 — the 7.25 written above, overwritten through the alias
