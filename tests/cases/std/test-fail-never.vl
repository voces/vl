// @run
// @log 1
// @hint redundant type annotation: `pick` is inferred as `string`
// diderven DV-503 — `fail` returns `never`, so a helper can end in it with no dummy value
// and keep its declared result type.
import { fail } from "std:test"

function pick(k: i32): string {
  if k == 1 { return "one" }
  fail("no such key")
}
print(pick(1).length - 2)
