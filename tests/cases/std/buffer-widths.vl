// @run
// @log 168496141
// @log 13
// @log 12
// @log 11
// @log 10
// @log 5000000077
// @log 705032781
// @log 1
// @log 1.5
// @log 1069547520
// @log -1071644672
// @log 2.25
// @log 4612248968380809216
// @log -4612811918334230528
// @log 1.5
// @log 2.25
// @log 64
// THE WIDTH MATRIX over a `Buf` receiver (`buffer-design.md` §C2): the four
// native store widths and the eight load widths, each verified by ROUND TRIP
// AGAINST A DIFFERENT WIDTH so the store and the load check each other rather
// than agreeing on a shared mistake. Every expectation is the python `struct`
// encoding of the value, never hand-derived (two hand-derived expectations were
// wrong in the load slice — §H6).
//
//   f32  1.5 → 1069547520      f32 -2.5  → -1071644672
//   f64  2.25 → 4612248968380809216   f64 -1.75 → -4612811918334230528
//   i64  5000000077 → words 705032781 (low) and 1 (high)
//
// The `.base` addition each accessor performs is invisible here by design: an
// offset is relative to the `Buf`, and two `Buf`s never overlap.
import { Buffer, loadF32, loadF64, loadI32, loadI64, loadU8, storeF32, storeF64, storeI32, storeI64 } from "std:buffer"

const b = Buffer(64)

// i32 written as a word, read back BYTE BY BYTE: linear memory is little-endian,
// so 0x0A0B0C0D lands as 0D 0C 0B 0A. This cross-checks the byte loads against
// the native `i32.store` — the same endianness the emulated `store8` assumes.
b.storeI32(0, 168496141)
print(b.loadI32(0))
print(b.loadU8(0))
print(b.loadU8(1))
print(b.loadU8(2))
print(b.loadU8(3))

// i64 written wide, read back at its own width AND as its two i32 halves.
b.storeI64(8, 5000000077)
print(b.loadI64(8))
print(b.loadI32(8))
print(b.loadI32(12))

// f32 / f64 written as floats, read back as floats AND as the integer bit
// pattern of the same width — the only way to see the encoding itself.
b.storeF32(16, 1.5)
print(b.loadF32(16))
print(b.loadI32(16))
b.storeF32(20, -2.5)
print(b.loadI32(20))

b.storeF64(24, 2.25)
print(b.loadF64(24))
print(b.loadI64(24))
b.storeF64(32, -1.75)
print(b.loadI64(32))

// UNALIGNED at the two widths whose natural alignment is not 1. The allocator
// rounds every `Buf`'s BASE to 8, but an OFFSET is the caller's business and the
// wasm alignment immediate is a hint, not a constraint — a wrongly-aligned
// access is legal and correct, only potentially slower.
b.storeF32(41, 1.5)
print(b.loadF32(41))
b.storeF64(51, 2.25)
print(b.loadF64(51))

print(b.length)
