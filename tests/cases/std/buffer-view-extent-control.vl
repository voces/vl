// @run
// @log 16
// @log 0
// @log 4
// @log 8
// @log 1.5
// THE INVERTED CONTROL for `buffer-view-extent-traps.vl`: the extent check must
// reject a view that leaves the `Buf` WITHOUT rejecting the boundary cases that
// are legal. A check that trapped on everything would satisfy that file and
// pin nothing.
//
// Three boundaries, all legal:
//   - a view that EXACTLY fills the `Buf` (16 f32 in 64 bytes) — `end == length`
//     is in range, `end > length` is not;
//   - an EMPTY view (`count == 0`), which is in range at every offset up to the
//     `Buf`'s length and satisfies no index at all — the natural base case for a
//     column with no rows;
//   - an empty view at the very END of the `Buf` (offset 64 of a 64-byte `Buf`),
//     the one-past-the-end descriptor a range loop produces on its own.
import { Buffer, f32view, getF32, setF32 } from "std:buffer"

const b = Buffer(64)

const full = b.f32view(0, 16) // exactly fills it
print(full.length)

const empty = b.f32view(0, 0)
print(empty.length)

const atEnd = b.f32view(64, 0) // one past the last byte, zero elements
const tail = b.f32view(56, 2) // the last two elements
print(tail.length + atEnd.length + 2)

const mid = b.f32view(32, 8)
print(mid.length)

// The exactly-filling view can reach its last element.
full.setF32(15, 1.5)
const last = full.getF32(15)
print(last)
