// GRADUATED from `silent-class-inventory` D42 — D35's MIRROR. D35 was a REFUSAL the checker
// holds and the pin dropped; this is an ACCEPTANCE the checker holds and the pin dropped.
//
// `eqCmpKindOfTy(string | null)` is `"nulstr"` — a compare core exists, `emitNulNicheEq` owns
// it, and two `string | null` bindings compared DIRECTLY have always been correct. Through
// `xs.indexOf(nd)` the same comparison was `vl check` rc 0 over a module the engine refuses.
//
// WHY THE PIN COULD NOT SEE IT, and why the fix is NOT where D35's is. `monoCloneBody` rebuilds
// only the statement spine and SHARES every leaf expression, so one `self[i] == needle` node
// serves every instantiation of `indexOf<T>` and the type banked on it is `T` however the
// instance was pinned. `binEqNulNiche` read that node and got `""` — correct about a type
// VARIABLE, silent about the instance — so the null GUARD was skipped and the plain compare
// fed a `(ref null …)` into a `(ref …)` slot. There is no refusal to state here, so
// `eqRefusals` is right to stay silent and the deferred constraint is the wrong channel: the
// answer has to arrive at EMIT, where the instance exists.
//
// THE SECOND CHANNEL IS THE EMITTER'S OWN, and it was already written. `exprNullableString`
// and its five siblings are `fnIx`-scoped, and a monomorphized instance IS its own emitted
// function with its own parameter kinds. `eqCmpKindOfOperand` is the one home that asks the
// banked type first and them second, gated on `nodeTyIsTyVar` so the five OTHER reasons
// `eqCmpKindOfTy` answers `""` keep the dispatch they already lower correctly. BOTH consumers
// ask it — the GUARD and the CORE selection — and a first cut that wired only the guard left
// `i32[] | null` emitting `no compare core`.
//
// THE FILE COVERS THE MECHANISM'S BOUNDARY, NOT THE GRID'S ENUMERATION, and that distinction
// is the `std-api-reviewer` finding on this change. The closing grid measured `string | null`
// and `i32[] | null`; the fix is `eqCmpKindOfNulInner`'s whole niche family, so all FIVE
// admitted tokens are here — `nulstr`, `nullist` (both backings), `nulstrlist`, `nulreflist`,
// `nulclosure` — inline and through a DECLARED ALIAS, at all four `needle` exports. A file
// that pinned the two the grid happened to run would have let the other three regress
// silently, and the header that quoted those two under-promised the change.
//
// THE SIXTH TOKEN, `nulstruct`, IS NOT HERE AND ITS ABSENCE IS THE POINT. `Circle | null` has
// a compare core and compares correctly written directly; what refuses it through a generic is
// `ref valtype with no interned shape` — a nullable STRUCT cannot be a generic ARGUMENT, which
// a hand-written generic containing no `==` reproduces and `T = Circle` does not. Nothing to
// pin here; the row says so.
import { count, includes, indexOf, lastIndexOf } from "std:array"

type L = i32[] | null
type SL = string[] | null
type Fn = ((i32) => i32) | null

function inc(n: i32): i32 { n + 1 }

function mkS(i: i32): string | null {
  if i > 1 { return "b" }
  return null
}

function mkL(i: i32): i32[] | null {
  if i > 1 { return [1] }
  return null
}

function mkB(i: i32): boolean[] | null {
  if i > 1 { return [true] }
  return null
}

function mkSL(i: i32): SL {
  if i > 1 { return ["b"] }
  return null
}

function mkR(i: i32): i32[][] | null {
  if i > 1 { return [[1]] }
  return null
}

function mkF(i: i32): Fn {
  if i > 1 { return inc }
  return null
}

function mkAlias(i: i32): L {
  if i > 1 { return [1] }
  return null
}

// `nulstr` — the row's own repro, at every export.
function nulStrCells() {
  const xs: (string | null)[] = [mkS(1), mkS(2)]
  const nd: string | null = mkS(2)
  print(xs.indexOf(nd))
  print(xs.lastIndexOf(nd))
  print(xs.includes(nd))
  print(xs.count(nd))
}
nulStrCells()

// `nullist` — the other half of the row's 96 cells, and the one that needed the CORE channel
// as well as the guard one.
function nulListCells() {
  const ys: (i32[] | null)[] = [mkL(1), mkL(2)]
  const md: i32[] | null = mkL(2)
  print(ys.indexOf(md))
  print(ys.lastIndexOf(md))
  print(ys.includes(md))
  print(ys.count(md))
}
nulListCells()

// `nullist` at its OTHER backing — a boolean list shares the i32 array with an i32 list, and a
// token that covers one and not the other would be a rep answered in half a ladder.
function nulBoolListCells() {
  const bs: (boolean[] | null)[] = [mkB(1), mkB(2)]
  const bd: boolean[] | null = mkB(2)
  print(bs.indexOf(bd))
  print(bs.includes(bd))
}
nulBoolListCells()

// `nulstrlist` — a DISTINCT backing, so it reaches a different core under the same guard.
function nulStrListCells() {
  const ss: SL[] = [mkSL(1), mkSL(2)]
  const sd: SL = mkSL(2)
  print(ss.indexOf(sd))
  print(ss.includes(sd))
}
nulStrListCells()

// `nulreflist` — a ref list of i32 lists. On master this was NOT invalid wasm but a check-clean
// runtime TRAP (`null reference`), which is why the row's "all invalid wasm -> runs" phrase is
// true of its own sixteen cells and is not the family's failure kind.
function nulRefListCells() {
  const rs: (i32[][] | null)[] = [mkR(1), mkR(2)]
  const rd: i32[][] | null = mkR(2)
  print(rs.indexOf(rd))
  print(rs.includes(rd))
}
nulRefListCells()

// `nulclosure` — compared by IDENTITY under the same guard, and a trap on master too.
function nulClosureCells() {
  const fs: Fn[] = [mkF(1), mkF(2)]
  const fd: Fn = mkF(2)
  print(fs.indexOf(fd))
  print(fs.includes(fd))
}
nulClosureCells()

// THE DECLARED-ALIAS SPELLING. `type L = i32[] | null` reaches `eqCmpKindOfTy` as a `TyUnion`
// rather than a `TyNullable` — the same rep, two arena shapes — and the alias spelling has
// been the one that keeps a defect this file's inventory has closed twice before.
function aliasCells() {
  const as: L[] = [mkAlias(1), mkAlias(2)]
  const ad: L = mkAlias(2)
  print(as.indexOf(ad))
  print(as.includes(ad))
}
aliasCells()

// A NEEDLE THAT IS `null` FINDS THE FIRST NULL ELEMENT. `null == null` is true at every rep
// here, as it is written directly — and the remedy this retirement retired ("project to a
// non-null key and search that") had no spelling for this search at all.
function nullNeedle() {
  const xs: (string | null)[] = [mkS(1), mkS(2)]
  const nd: string | null = mkS(1)
  print(xs.indexOf(nd))
  print(xs.count(nd))
}
nullNeedle()

// A HAND-WRITTEN generic of the same signature, off std's surface entirely — the row
// reproduces on every route, so a fix that only reached `std:array` would be a fix about a
// module rather than about the pin.
function myIndexOf<T>(self: T[], needle: T): i32 {
  let i = 0
  while i < self.length {
    if self[i] == needle { return i }
    i = i + 1
  }
  -1
}

function handWritten() {
  const xs: (string | null)[] = [mkS(2), mkS(1)]
  const nd: string | null = mkS(2)
  myIndexOf(xs, nd)
}
print(handWritten())

// THE CONTROL, and it is what makes the row a MIRROR rather than a residue: the same compare
// written DIRECTLY has always run and been right. A fix that made the generic route LOUD would
// have been D35's over-broad twin.
function directControl() {
  const a: string | null = mkS(2)
  const b: string | null = mkS(2)
  if a == b { return 0 }
  -1
}
print(directControl())
