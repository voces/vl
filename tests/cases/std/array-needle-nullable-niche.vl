// @hint redundant type annotation: `xs` is inferred as `(string | null)[]`
// @hint redundant type annotation: `nd` is inferred as `string | null`
// @hint redundant type annotation: `ys` is inferred as `(i32[] | null)[]`
// @hint redundant type annotation: `md` is inferred as `i32[] | null`
// @hint redundant type annotation: `myIndexOf` is inferred as `i32`
// @hint redundant type annotation: `xs` is inferred as `(string | null)[]`
// @hint redundant type annotation: `nd` is inferred as `string | null`
// @hint redundant type annotation: `a` is inferred as `string | null`
// @hint redundant type annotation: `b` is inferred as `string | null`
// GRADUATED from `silent-class-inventory` D42 — D35's MIRROR. D35 was a REFUSAL the checker
// holds and the pin dropped; this is an ACCEPTANCE the checker holds and the pin dropped.
//
// `eqCmpKindOfTy(string | null)` is `"nulstr"` — a compare core exists, `emitNulNicheEq` owns
// it, and two `string | null` bindings compared DIRECTLY have always been correct. Through
// `xs.indexOf(nd)` the same comparison was `vl check` rc 0 over a module the engine refuses
// (`type mismatch: expected (ref $type), found (ref null $type)`).
//
// WHY THE PIN COULD NOT SEE IT, and why the fix is NOT where D35's is. `monoCloneBody` rebuilds
// only the statement spine and SHARES every leaf expression, so one `self[i] == needle` node
// serves every instantiation of `indexOf<T>` and the type banked on it is `T` however the
// instance was pinned. `binEqNulNiche` read that node and got `""` — correct about a type
// VARIABLE, silent about the instance — so the null GUARD was skipped and the plain string
// compare fed a `(ref null $array)` into a `(ref $array)` slot. There is no refusal to state
// here, so `eqRefusals` is right to stay silent and the deferred constraint is the wrong
// channel: the answer has to arrive at EMIT, where the instance exists.
//
// THE SECOND CHANNEL IS THE EMITTER'S OWN, and it was already written. `exprNullableString`
// and its five siblings are `fnIx`-scoped, and a monomorphized instance IS its own emitted
// function with its own parameter kinds — so they answer per instance where the node cannot.
// `eqCmpKindOfOperand` is the one home that asks the banked type first and them second, gated
// on `nodeTyIsTyVar` so the five OTHER reasons `eqCmpKindOfTy` answers `""` (a literal, a
// literal union, a value-union box, the two sentinel nullables, the error hole) keep the
// dispatch they already lower correctly.
//
// BOTH CONSUMERS ASK IT, and a first cut that gave the channel only to the GUARD is why this
// paragraph exists: `(i32[] | null)` then reached `emitNulNicheEq` with `eqCoreKindOfBin` still
// answering -1, and the guard emitted a loud `no compare core` instead of a compare. The core
// selection reads the same home now, which also keeps the frame-reservation scan (`leqNoteBin`)
// in agreement with the emitter by construction.
//
// ALL FOUR `needle: T` EXPORTS, spelled out rather than counted — the axis mistake this
// module's ledger catalogues. Both niches, and the direct control last.
import { count, includes, indexOf, lastIndexOf } from "std:array"

function mkT(i: i32): string | null {
  if i > 1 { return "b" }
  return null
}

function mkL(i: i32): i32[] | null {
  if i > 1 { return [1] }
  return null
}

// `string | null` — the row's own repro, at every export.
function nulStrCells() {
  const xs: (string | null)[] = [mkT(1), mkT(2)]
  const nd: string | null = mkT(2)
  print(xs.indexOf(nd))
  print(xs.lastIndexOf(nd))
  print(xs.includes(nd))
  print(xs.count(nd))
}
nulStrCells()

// `i32[] | null` — the other half of the row's 96 cells, and the one that needed the CORE
// channel as well as the guard one.
function nulListCells() {
  const ys: (i32[] | null)[] = [mkL(1), mkL(2)]
  const md: i32[] | null = mkL(2)
  print(ys.indexOf(md))
  print(ys.lastIndexOf(md))
  print(ys.includes(md))
  print(ys.count(md))
}
nulListCells()

// A HAND-WRITTEN generic of the same signature, off std's surface entirely — the row
// reproduces on every route, so a fix that only reached `std:array` would be a fix about a
// module rather than about the pin.
function myIndexOf<T>(self: T[], needle: T): i32 {
  let i = 0
  while i < self.length {
    if self[i] == needle { return i }
    i = i + 1
  }
  -1
}

function handWritten() {
  const xs: (string | null)[] = [mkT(2), mkT(1)]
  const nd: string | null = mkT(2)
  myIndexOf(xs, nd)
}
print(handWritten())

// THE CONTROL, and it is what makes the row a MIRROR rather than a residue: the same compare
// written DIRECTLY has always run and been right. A fix that made the generic route LOUD would
// have been D35's over-broad twin.
function directControl() {
  const a: string | null = mkT(2)
  const b: string | null = mkT(2)
  if a == b { return 0 }
  -1
}
print(directControl())
