// @check
// @error `indexOf` compares its type parameter with `==` here: `==` over Circle[] has no lowering
// @error `lastIndexOf` compares its type parameter with `==` here: `==` over Circle[] has no lowering
// @error `includes` compares its type parameter with `==` here: `==` over Circle[] has no lowering
// @error `count` compares its type parameter with `==` here: `==` over Circle[] has no lowering
// @error `indexOf` compares its type parameter with `==` here: `==` over {[string]: i32} has no lowering
// @error `indexOf` compares its type parameter with `==` here: K[] isn't equatable (a field is not value-comparable)
// @error `indexOf` compares its type parameter with `==` here: `==` over K[] has no lowering
// @error `myIndexOf` compares its type parameter with `==` here: `==` over Circle[] has no lowering
// @error `==` over Circle[] has no lowering
// GRADUATED from `silent-class-inventory` D35. A `needle: T` the checker will not `==` used
// to LOSE that refusal in the instantiation, and the loss was uniform while its CONSEQUENCE
// was decided by luck one layer down.
//
// THE CONTROL IS WHAT MAKES IT SHARP, and it is the last function in this file: the same
// comparison written DIRECTLY has always been a loud checker error. So the compiler was never
// missing a lowering it might one day grow — it HAD the refusal, and the refusal did not
// survive the trip through a type parameter. One decision, two severities, chosen by the
// spelling. The control's message is the generic routes' message with the attribution clause
// removed, and that is deliberate: `eqRefusals` is ONE home, so the two spellings cannot drift
// into two sentences.
//
// WHERE IT WAS LOST. `checkBinary` asks two questions of the operands — `isEquatable` (a plain
// object/array compares field-by-field, which needs every component value-comparable) and
// `eqCmpKindOfTy` (does a compare CORE exist for this rep). Inside a generic body the operand
// is `T`, a `TyVar`: `isEquatable` answers TRUE and `eqCmpKindOfTy` answers "" (OPAQUE). Both
// answers are correct about a type variable and useless about the instance, and nothing
// re-asked once the pin was known. Both now ride the PIN — `binOpDefinedFor` and
// `validateBinCstrs` put the same two questions at the CALL SITE under the substituted type,
// which is the only place the concrete type and the refusal are both in scope, and it is a
// `vl check` answer rather than an engine one.
//
// ALL FOUR `needle: T` EXPORTS ARE HERE, and the reason to spell them out rather than trust
// one is that the sentence they replace did not: a draft of this file ran `indexOf` on four
// ROUTES and its header called that "all four exports". A count without its axis, which is the
// mistake `std/array.vl`'s own ledger catalogues, made while retiring an entry for it. Caught
// by the `std-api-reviewer` pass over this change — the fifth consecutive time that review has
// produced the closing change's next correction.
//
// THE AXIS IS EQUATABILITY OF `T`, NOT "A LIST WHOSE ELEMENT IS A STRUCT" — the row was filed
// one axis too narrow and the same review corrected it. `{[string]: i32}` has no struct in it
// and reproduced identically, which is the `CM` row below; `reverse` over the same `CM[]`
// receiver ran and still runs, so the receiver was never the question.
//
// THE `K[]` ROW GETS **TWO** SENTENCES, and so would a `CM[]` one: a list whose element is a
// literal union fails the structural gate AND has no list core, so both fire. A table that
// files each type under one bucket is wrong about this, and one did.
//
// THE `K[]` ROW IS ALSO THE ONE THAT USED TO RUN, returning the correct index. What was lost
// was uniformly the REFUSAL; whether a given `T` then produced invalid wasm or a working
// answer was decided DOWNSTREAM, by whether the emitter happens to hold a comparison for that
// rep. Filing this as "a struct element" described the two unlucky reps and missed both the
// mechanism and the cell that shows it most clearly.
import { count, includes, indexOf, lastIndexOf } from "std:array"

type Circle = { r: i32 }
type CM = {[string]: i32}
type K = "a" | "b"

// ── ALL FOUR `needle: T` EXPORTS, UFCS, on the filed witness's receiver ──
function stdIndexOf(): i32 {
  const n: Circle[] = [{ r: 7 }]
  const xs: Circle[][] = [n]
  return xs.indexOf(n)
}

function stdLastIndexOf(): i32 {
  const n: Circle[] = [{ r: 7 }]
  const xs: Circle[][] = [n]
  return xs.lastIndexOf(n)
}

function stdIncludes(): boolean {
  const n: Circle[] = [{ r: 7 }]
  const xs: Circle[][] = [n]
  return xs.includes(n)
}

function stdCount(): i32 {
  const n: Circle[] = [{ r: 7 }]
  const xs: Circle[][] = [n]
  return xs.count(n)
}

// ── NO STRUCT ANYWHERE: the reviewer's disproof of the first axis ──
function mkM(i: i32): CM {
  const m: CM = Map()
  m["k"] = i
  return m
}
function noStruct(): i32 {
  const n = mkM(7)
  const xs: CM[] = [n]
  return xs.indexOf(n)
}

// ── the cell that RAN, and the one that trips BOTH gates ──
function usedToRun(): i32 {
  const n: K[] = ["a"]
  const xs: K[][] = [n]
  return xs.indexOf(n)
}

// ── OFF the std surface: a hand-written generic of the same signature, importing
//    nothing, so a reading of this file cannot conclude `std:array` chose the rule ──
function myIndexOf<T>(self: T[], needle: T): i32 {
  let i = 0
  while i < self.length {
    if self[i] == needle { return i }
    i = i + 1
  }
  return -1
}
function handWritten(): i32 {
  const n: Circle[] = [{ r: 7 }]
  const xs: Circle[][] = [n]
  return myIndexOf(xs, n)
}

// ── THE CONTROL. The identical comparison, spelled out. Loud before this change and
//    loud after, in the SAME sentence the four generic routes above now use. ──
function control(): boolean {
  const a: Circle[] = [{ r: 7 }]
  const b: Circle[] = [{ r: 7 }]
  return a == b
}
