// @trap
// A NEGATIVE OFFSET OR LENGTH IS NOT A WINDOW.
//
// `window(b, 2, -1)` would describe a `Buf` whose `length` a later bounds check trusts, so
// it is refused where it is made. The sentence it prints first is pinned by
// `tests/vl_buffer_bytes_trap_message_test.ts`.
import { Buffer, window } from "std:buffer"

const b = Buffer(8)
const w = window(b, 2, 0 - 1)
print(w.length)
