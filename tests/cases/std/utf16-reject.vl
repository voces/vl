// @run
// @log invalid UTF-16: unit 55296 at index 1 is a lone surrogate
// @log 1
// @log 55296
// @log 0
// @log 56320
// @log 1
// @log invalid UTF-16: unit 128512 at index 0 is not a 16-bit unit
// @log 2
// `std:utf16` — decoding is strict: a lone surrogate, in any position, is an error that names
// the offending unit and its index, and so is a value that is not a 16-bit unit at all.
import { Utf16Error, decodeUtf16 } from "std:utf16"

// A high surrogate followed by something that is not a low one.
const mid = decodeUtf16([0x41, 0xD800, 0x42])
if mid is Utf16Error {
  print(mid.msg)
  print(mid.at)
  print(mid.unit)
} else {
  print("accepted")
}

// A low surrogate on its own.
const low = decodeUtf16([0xDC00, 0x41])
if low is Utf16Error {
  print(low.at)
  print(low.unit)
} else {
  print("accepted")
}

// A high surrogate at the very end, with nothing to pair with.
const tail = decodeUtf16([0x41, 0xD83D])
if tail is Utf16Error { print(tail.at) } else { print("accepted") }

// A code point handed in as one element is not a unit: astral characters travel as pairs.
const wide = decodeUtf16([0x1F600])
if wide is Utf16Error { print(wide.msg) } else { print("accepted") }

// The valid prefix is exactly `at` units long.
const neg = decodeUtf16([0x41, 0x42, -1])
if neg is Utf16Error { print(neg.at) } else { print("accepted") }
