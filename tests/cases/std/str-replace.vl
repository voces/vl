// @run
// @log [a+b-c-d]
// @log [a+b+c+d]
// @log [abc]
// @log [abc]
// @log []
// @log []
// @log [+abc]
// @log [abc+]
// @log [+abc+]
// @log [++]
// @log [+]
// @log [a++b]
// @log [abc]
// @log [a<->b]
// @log [ba]
// @log [bb]
// @log [ba]
// @log [aa]
// @log [abab]
// @log [x/y/z]
// @log [ab]
// @log [-abc]
// @log [-]
// @log [-a-b-c-]
// @log [-]
// @log [--a--]
// @log true
// @log true
// @log true
// @log true
// @log true
// @log false
// `std:str` REPLACE — first-occurrence vs all-occurrences, the overlap rule,
// and the empty needle all four reference languages agree about.
//
// The two functions differ in exactly one thing (how many matches they take)
// and share the scan that finds them, so this file asserts them side by side on
// the same inputs — a divergence between the two on any line here is a bug in
// the shared core, not in one of them.
import { join, replace, replaceAll, split } from "std:str"

// FIRST vs ALL, on an input with three matches.
print("[" + "a-b-c-d".replace("-", "+") + "]")      // [a+b-c-d]
print("[" + "a-b-c-d".replaceAll("-", "+") + "]")   // [a+b+c+d]

// ABSENT: both return the input untouched — same string, nothing allocated.
print("[" + "abc".replace("z", "!") + "]")          // [abc]
print("[" + "abc".replaceAll("z", "!") + "]")       // [abc]
print("[" + "".replace("z", "!") + "]")             // []
print("[" + "".replaceAll("z", "!") + "]")          // []

// AT THE VERY START and AT THE VERY END — the two positions an off-by-one in
// the slice arithmetic destroys.
print("[" + "-abc".replaceAll("-", "+") + "]")      // [+abc]
print("[" + "abc-".replaceAll("-", "+") + "]")      // [abc+]
print("[" + "-abc-".replaceAll("-", "+") + "]")     // [+abc+]
print("[" + "--".replaceAll("-", "+") + "]")        // [++]
print("[" + "-".replace("-", "+") + "]")            // [+]

// ADJACENT matches, and a `to` that is EMPTY (deletion) or LONGER than `from`.
print("[" + "a--b".replaceAll("-", "+") + "]")      // [a++b]
print("[" + "a-b-c".replaceAll("-", "") + "]")      // [abc]
print("[" + "a-b".replaceAll("-", "<->") + "]")     // [a<->b]

// OVERLAP: matches are consumed left to right and the scan resumes PAST the one
// it took, so the third `a` is left over rather than starting a second match.
print("[" + "aaa".replaceAll("aa", "b") + "]")      // [ba]
print("[" + "aaaa".replaceAll("aa", "b") + "]")     // [bb]
print("[" + "aaa".replace("aa", "b") + "]")         // [ba]  — same, one match
// A `to` CONTAINING `from` is not rescanned, so this terminates.
print("[" + "a".replaceAll("a", "aa") + "]")        // [aa]
print("[" + "ab".replaceAll("a", "aba") + "]")      // [abab]

// MULTI-CHARACTER needles, including one longer than the haystack.
print("[" + "x::y::z".replaceAll("::", "/") + "]")  // [x/y/z]
print("[" + "ab".replaceAll("abcd", "!") + "]")     // [ab]

// THE EMPTY NEEDLE. `replace` takes the one match at index 0 — the core's own
// `indexOf("") == 0` rule — so `to` is prepended. `replaceAll` takes the match
// at EVERY boundary: before the first character, between each pair, and after
// the last. JS, Python, Rust and Go all produce these exact strings (Go
// documents it as "up to k+1 replacements for a k-rune string").
print("[" + "abc".replace("", "-") + "]")           // [-abc]
print("[" + "".replace("", "-") + "]")              // [-]
print("[" + "abc".replaceAll("", "-") + "]")        // [-a-b-c-]
print("[" + "".replaceAll("", "-") + "]")           // [-]
print("[" + "a".replaceAll("", "--") + "]")         // [--a--]

// THE LAW: for a NON-EMPTY `from`, replaceAll is split-then-join. Pinned on the
// inputs that break naive implementations rather than on the easy one.
print("a-b-c".replaceAll("-", "+") == "a-b-c".split("-").join("+"))
print("-a--b-".replaceAll("-", "+") == "-a--b-".split("-").join("+"))
print("aaa".replaceAll("aa", "b") == "aaa".split("aa").join("b"))
print("abc".replaceAll("z", "+") == "abc".split("z").join("+"))
print("".replaceAll("-", "+") == "".split("-").join("+"))
// And it does NOT hold for an empty `from` — stated as a pinned FALSE so nobody
// "fixes" one side into agreement with the other.
print("abc".replaceAll("", "-") == "abc".split("").join("-"))
