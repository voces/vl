// @run
// @log 1.00
// @log 3
// @log -3
// @log 1
// @log -1
// @log 1.4
// @log 0.0000010
// @log 0.00
// @log -0.00
// @log 123
// @log 0.10000000000000000555
// @log 1e+21
// @log -1.5e+21
// @log 999999900000000016384.000
// @log 0.000
// @log 100000000000000000000.00
// @log 2.67
// @log 1234.57
// @log NaN Infinity -Infinity
// @log 102
// @log 3.142
// `toFixed` agrees with JS `Number.prototype.toFixed` string for string (D3565): every
// expected line above is what V8 prints for the same call. It rounds the exact binary
// value, so `1.005` and `2.675` (both just below their tie) round down, and a true tie
// (`2.5`, `-0.5`) rounds away from zero. Negative zero is unsigned, a negative value
// that rounds to zero is not, and from 1e21 up the text is `toString`'s.
import { toFixed } from "std:fmt"

print(toFixed(1.005, 2))
print(toFixed(2.5, 0))
print(toFixed(-2.5, 0))
print(toFixed(0.5, 0))
print(toFixed(-0.5, 0))
print(toFixed(1.45, 1))
print(toFixed(0.000001, 7))
print(toFixed(-0.0, 2))
print(toFixed(-0.0001, 2))
print(toFixed(123.456, 0))
print(toFixed(0.1, 20))
print(toFixed(1e21, 2))
print(toFixed(-1.5e21, 0))
print(toFixed(9.999999e20, 3))
print(toFixed(5e-324, 3))
print(toFixed(1e20, 2))
print(toFixed(2.675, 2))
print(toFixed(1234.5678, 2))
const zero = 0.0
print(
  toFixed(zero / zero, 2)
    + " "
    + toFixed(1.0 / zero, 2)
    + " "
    + toFixed(-1.0 / zero, 2),
)
print(toFixed(5e-324, 100).length)
print((3.14159).toFixed(3))
