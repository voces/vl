// @run
// @log 0
// @log true
// @log -1
// @log 2
// @log 1 3
// @log 7
// @log 1000001
// A scalar value: a stored `0` is present, not a miss, and the table grows past a million
// slots through one shared `null`. The built-in map's `get`/`has`/`delete` and the list's
// `get` still answer beside the imported names.
import { toString } from "std:fmt"
import { IdTable, delete, get, has, ids, set } from "std:idtable"

const u = IdTable<i32>()
u.set(3, 0)
print(u.get(3) ?? -1)
print(u.has(3))
print(u[4] ?? -1)
u[1] = 5
print(u.length)
const ks = u.ids()
print(toString(ks[0]) + " " + toString(ks[1]))

const m: {[i32]: i32} = Map()
m[1] = 7
if m.has(1) && m.delete(1) { print(7) }

const big = IdTable<i32>()
big.set(1000000, 1)
print(big.slots.length)
