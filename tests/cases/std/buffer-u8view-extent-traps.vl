// @trap
// The u8 extent check: 5 bytes from byte 60 end at byte 65, past a 64-byte
// `Buf`, so the view is refused where it is built. (`u8view(60, 4)` fits.)
import { Buffer, u8view } from "std:buffer"

const b = Buffer(64)
const t = b.u8view(60, 4)
print(t.length)
const u = b.u8view(60, 5)
print(u.length)
print("unreachable marker")
