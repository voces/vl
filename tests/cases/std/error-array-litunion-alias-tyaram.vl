// @emit-error literal-union string widening with no members
// CONTRACT (must-emit-reject) — the pin `std/array.vl`'s CARVE-OUT 2 did not have, and the
// reason it did not have one is the point. That carve-out documents an honest emit refusal
// on this module's generic surface, and NOTHING IN THE TREE would have said when it moved:
// the message is pinned for other shapes, never for a `std:array` type parameter. Its
// neighbour `error-array-struct-element.vl` is the exact in-directory precedent — an honest
// refusal on the same surface, given its own `error-*` file so it cannot go stale silently.
//
// The carve-out this replaces was noticed only because the same branch happened to fix the
// defect beside it. That is luck, not a process, and the module header's own closing rule
// (re-probe the section when the family under it moves, INCLUDING toward correctness) has
// no mechanism behind it without files like this one.
//
// THE SHAPE: a string-literal-union ALIAS in a NON-ELEMENT type parameter. `K` reps as the
// interned i32 ATOM, and the widen to member text has no member list to work from at this
// boundary, so emit refuses rather than building a list of atoms over a string-repped
// value. Both spellings below carry it — `mapIndexed`'s result `U` and `reduce`'s
// accumulator `A` — and both must be fixed before this file goes green, because emission
// stops at the first and the second reports the identical message.
//
// THE INLINE SPELLINGS DIFFER, WHICH IS WHY THIS IS ITS OWN FILE. An inline `U` is
// CARVE-OUT 1, a different failure (a written-but-invalid module; see
// `xfail-miscompile-mapindexed-litunion-result.vl`), while an inline `A` RUNS correctly.
// Only the ALIAS spelling of a non-element parameter lands here.
import { mapIndexed, reduce } from "std:array"

type K = "a" | "b"

function toK(x: i32, i: i32): K {
  if x + i > 0 { return "b" }
  return "a"
}

function pick(a: K, x: i32): K {
  if x > 0 { return "b" }
  return a
}

const viaMapIndexed = [0, 1].mapIndexed(toK)
print(viaMapIndexed[1])

const init: K = "a"
print([0, 1].reduce(pick, init))
