// @run
// @log 3
// @log 2
// @log 0
// @log 9
// @log 9
// @log 6
// @log 4
// @log 2
// @hint redundant type annotation: `rows` is inferred as `i32[][]`
// `std:array.filled` at a LIST element — the same sharing the struct element has,
// and the one call that undoes it.
//
// `filled(3, [0, 0])` is three slots holding ONE two-element list, so `rows[0][1] = 9`
// is visible as `rows[2][1]`. For a row-per-slot matrix, `mapIndexed` over a `filled`
// list builds a fresh inner list per index — that composition is the remedy, and the
// bottom of this file runs it.
//
// (The struct element lives in `array-filled-struct-element.vl`, which says why the
// two are not in one file.)
import { filled, mapIndexed } from "std:array"

const rows: i32[][] = filled(3, [0, 0])
print(rows.length)
print(rows[0].length)
print(rows[2][1])

rows[0][1] = 9
print(rows[0][1])
print(rows[2][1])

// The UN-ANNOTATED face, for the same reason the struct file carries one: the
// annotation pins the element's representation, so a fixture that only annotates
// cannot see a defect in the inferred spelling.
const anon = filled(2, [4, 5, 6])
print(anon[1][2])

// The remedy: one fresh inner list per slot, so a write to row 0 stays in row 0.
const grid = filled(3, 0).mapIndexed((v: i32, i: i32) => { return [v, i] })
grid[0][1] = 4
print(grid[0][1])
print(grid[2][1])
