// @run
// @log 10
// @log 15
// @log 12
// @log 4
// @log 13
// @log 100
// @log 100
// @log 1
// @log 0
// @log 7
// Each `std:atomic` read-modify-write answers the value it replaced; a failed compare-exchange
// leaves the word alone, and a notify with no waiter wakes none. `atomicWaitI32` is pinned in
// `tests/vl_shared_memory_bands_test.ts`: over this unshared memory it traps.
import { Buffer, loadI32 } from "std:buffer"
import {
  atomicAddI32,
  atomicAndI32,
  atomicCompareExchangeI32,
  atomicExchangeI32,
  atomicLoadI32,
  atomicNotify,
  atomicOrI32,
  atomicStoreI32,
  atomicSubI32,
} from "std:atomic"

const b = Buffer(16)
b.atomicStoreI32(4, 10)
print(b.atomicAddI32(4, 5))
print(b.atomicSubI32(4, 3))
print(b.atomicAndI32(4, 6))
print(b.atomicOrI32(4, 9))
print(b.atomicExchangeI32(4, 100))
print(b.atomicCompareExchangeI32(4, 7, 1))
print(b.atomicCompareExchangeI32(4, 100, 1))
print(b.atomicLoadI32(4))
print(b.atomicNotify(4, 1))
b.atomicStoreI32(12, 7)
print(b.loadI32(12))
