// @run
// @log 1
// @log 1
// @log 6
// @log 61
// @log 4
// @hint redundant type annotation: `sortIt` is inferred as `i32[]`
// @hint redundant type annotation: `mapIt` is inferred as `i32[]`
// @hint redundant type annotation: `reduceIt` is inferred as `i32`
// @hint redundant type annotation: `sortInPlace` is inferred as `i32`
// THE CALLER-FACING SPELLINGS of `narrowed-nullable-fn-arg.vl`: an OPTIONAL callback, narrowed
// non-null, forwarded into a `std:array` generic. This is the shape the std review raised
// against `std/array.vl`'s callback-DELIVERY paragraph — "a literal union is admitted at every
// position" was not the wrong claim, and the counter-example was not about literal unions: an
// optional COMPARATOR is simply the most ordinary way to reach the call-argument boundary with
// a narrowed nullable-closure operand.
//
// All four spellings were check-clean invalid modules; the recover now lives on the argument
// boundary's non-null ladder. Kept as a SEPARATE file from the mechanism pin so that a
// regression tells you which half moved: this one is std + generic + monomorphized, the
// soundness file is non-generic with no import.
//
// The four redundant-annotation hints are DECLARED rather than acted on. Every one of those
// annotations is load-bearing: the monomorphizer binds a generic alias by NAME, so deleting a
// return annotation the checker calls redundant can turn a working program into an emit error.
import { mapIndexed, reduce, sort, sorted } from "std:array"

function lessNum(a: i32, b: i32) { return a < b }

function sortIt(xs: i32[], cmp: ((i32, i32) => boolean) | null): i32[] {
  if cmp is (i32, i32) => boolean { return xs.sorted(cmp) }
  return xs.sorted(lessNum)
}

function addUp(a: i32, b: i32) { return a + b }

function reduceIt(xs: i32[], f: ((i32, i32) => i32) | null): i32 {
  if f is (i32, i32) => i32 { return xs.reduce(f, 0) }
  return -1
}

function dbl(v: i32, i: i32) { return v * 10 + i }

function mapIt(xs: i32[], f: ((i32, i32) => i32) | null): i32[] {
  if f is (i32, i32) => i32 { return xs.mapIndexed(f) }
  return xs
}

function sortInPlace(xs: i32[], cmp: ((i32, i32) => boolean) | null): i32 {
  if cmp is (i32, i32) => boolean {
    xs.sort(cmp)
    return xs[0]
  }
  return -1
}

print(sortIt([3, 1, 2], lessNum)[0])
// The `null` arm takes the same `sorted` call with a non-optional callback — the control that
// keeps the narrowed arm honest about which half of the branch was fixed.
print(sortIt([3, 1, 2], null)[0])
print(reduceIt([1, 2, 3], addUp))
print(mapIt([5, 6], dbl)[1])
print(sortInPlace([9, 4, 7], lessNum))
