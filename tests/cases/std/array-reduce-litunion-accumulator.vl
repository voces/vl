// @run
// @log b
// @log b
// @log b
// @log b
// GRADUATED from `error-array-litunion-alias-tyaram.vl`, which was `std/array.vl`'s LAST
// surviving carve-out — the honest one. `reduce`'s accumulator `A` bound to a string literal
// union was an emit refusal (`literal-union string widening with no members`) because `A` is
// first bound at `f: (A, T) => A`, a CALLBACK parameter, whose pin renders each type
// parameter's BOUND NAME — and a literal union's bound name was the SOFTENED `string`, so the
// widen back to member text had no member list to work from.
//
// IT CLOSED WITH THE LITERAL-UNION BOUNDARY CLASS AND WITHOUT BEING AIMED AT. The pin for a
// function-type parameter is rendered by `nominalizeFnTypeOfTy`, a third hand-written copy of
// the renderer's `TyFunc` arm that had neither of that arm's alias legs; giving it both means
// `(K, i32) => K` renders as itself instead of `(string, i32) => string`, `A` binds to `K` at
// both ends, and the widen has its members. The row that DID aim at that rung is
// `tests/cases/literal-unions/fntype-litunion-result-controls.vl` cell 8 (`once<A>`), which is
// the same shape with nothing to do with std.
//
// SO THE FILE'S OWN MEASUREMENT SURVIVES ITS FIX, and it is why the parameter-ORDER rows are
// kept below rather than deleted: the deciding property WAS "which parameter binds `A` first",
// and the `init`-first spelling ran while the callback-first one did not. Both run now, and
// pinning both is what says the axis is gone rather than merely quiet.
//
// IT WAS NEVER ABOUT THE ALIAS. A hand-written generic importing nothing reproduced it, and an
// inline `"a" | "b"` accumulator was affected too the moment any same-layout alias existed in
// the COMPILED PROGRAM — `std:fs`'s exported `FileKind` would have done it to a
// `"file" | "dir"` accumulator by import alone. The inline row below carries that cell, with
// the unused alias that used to arm it.
import { reduce } from "std:array"

type K = "a" | "b"

function pick(a: K, x: i32): K {
  if x > 0 { return "b" }
  return a
}

const init: K = "a"
print([0, 1].reduce(pick, init))

// ── the hand-written generic, importing nothing, in BOTH parameter orders ──
function foldCb<A, T>(self: T[], f: (A, T) => A, seed: A): A {
  let acc = seed
  let i = 0
  while i < self.length {
    acc = f(acc, self[i])
    i = i + 1
  }
  return acc
}

function foldInit<A, T>(self: T[], seed: A, f: (A, T) => A): A {
  let acc = seed
  let i = 0
  while i < self.length {
    acc = f(acc, self[i])
    i = i + 1
  }
  return acc
}

print(foldCb([0, 1], pick, init))
print(foldInit([0, 1], init, pick))

// ── BOTH `A` AND `T` LITERAL UNIONS, and DISJOINT ──
// Flagged by the std review as an unpinned cell; measured, it was a loud
// `literal-union string widening with no members` on the parent seed and runs here. It is a
// distinct cell because every row above varies `A` alone over an `i32` element — the accumulator
// and the element bind `A` and `T` at different parameters, so a fix for one says nothing about
// the pair. DISJOINT member sets on purpose (#1304's method note): a shared set would let one
// alias registration answer a lookup it was not asked.
type E = "x" | "y"

function pickE(acc: K, e: E): K {
  if e == "y" { return "b" }
  return acc
}

const es: E[] = ["x", "y"]
print(es.reduce(pickE, init))
