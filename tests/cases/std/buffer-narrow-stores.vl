// @run
// @log 1144201745
// @log 17
// @log 34
// @log 51
// @log 68
// @log 168558349
// @log 255
// @log 255
// @log -1
// @log 255
// @log -128
// @log 128
// @log 127
// @log 127
// @log 48879
// @log 239
// @log 190
// @log 48879
// @log 48879
// @log 239
// @log 190
// @log 43981
// @log -1
// @log 65535
// @log -32768
// @log 32768
// @log 32767
// @log 32767
// THE TWO EMULATED STORE WIDTHS. `i32.store8` (0x3a) and `i32.store16` (0x3b)
// exist as instructions but are NOT reachable from VL: `__store_i8__` /
// `__store_i16__` are undeclared — S3's unshipped half — so `std:buffer` builds
// them as READ-MODIFY-WRITE over `__load_i32__` / `__store_i32__`. This file is
// what proves the masking is right, and it is what must keep passing unchanged
// when the narrow intrinsics land and the emulation is deleted.
//
// O2 IS SETTLED HERE TOO: the stores have NO signed/unsigned split (one
// instruction, and it truncates), while the loads keep theirs (two genuinely
// different instructions). `store8` of -1 and of 255 write the same byte; the
// byte reads back as -1 through `loadI8` and 255 through `loadU8`. The 127 / 32767
// CONTROLS are the ones where the two spellings must AGREE — without them,
// "they differ" is not evidence they differ for the right reason.
import { Buffer, loadI16, loadI32, loadI8, loadU16, loadU8, store16, store8, storeI32 } from "std:buffer"

const b = Buffer(64)

// EVERY BYTE POSITION WITHIN A WORD. A `Buf`'s base is 8-aligned, so offsets 0..3
// are the four lanes of one word; the emulation shifts by `(addr & 3) * 8`
// because linear memory is little-endian. Read back as one i32, the four bytes
// must assemble to 0x44332211.
b.store8(0, 17)
b.store8(1, 34)
b.store8(2, 51)
b.store8(3, 68)
print(b.loadI32(0))
print(b.loadU8(0))
print(b.loadU8(1))
print(b.loadU8(2))
print(b.loadU8(3))

// THE NEIGHBOURS SURVIVE. A read-modify-write touches four bytes where the
// instruction touches one; the other three must come back out exactly as they
// went in. 0x0A0B0C0D with lane 1 overwritten by 0xFF is 0x0A0BFF0D.
// (The allocator's 8-byte rounding means the four bytes can never reach ANOTHER
// `Buf` either — no two `Buf`s share a word.)
b.storeI32(4, 168496141)
b.store8(5, 255)
print(b.loadI32(4))

// TRUNCATION, and sign-agnosticism. `i32.store8` discards the high 24 bits; 511
// and -1 are stored by the same instruction as 0xFF and 0xFF.
b.store8(8, 511)
print(b.loadU8(8))
b.store8(9, -1)
print(b.loadU8(9))

// SIGN vs ZERO EXTENSION ON THE WAY BACK OUT — plus the control at 127.
b.store8(12, 255)
print(b.loadI8(12))
print(b.loadU8(12))
b.store8(13, 128)
print(b.loadI8(13))
print(b.loadU8(13))
b.store8(14, 127)
print(b.loadI8(14)) // the CONTROL: signed and unsigned must AGREE here
print(b.loadU8(14))

// `store16` AT EVERY ALIGNMENT, INCLUDING THE STRADDLE. A halfword at an offset
// congruent to 3 mod 4 spans TWO words, which is why the emulation goes byte at
// a time instead of doing one word-level read-modify-write. 0xBEEF is written at
// lane 0 (offset 16), lane 1 (offset 21) and lane 3 (offset 27 — the straddle),
// and read back both as a halfword and as its two little-endian bytes.
b.store16(16, 48879)
print(b.loadU16(16))
print(b.loadU8(16)) // 0xEF — low byte first
print(b.loadU8(17)) // 0xBE
b.store16(21, 48879)
print(b.loadU16(21))
b.store16(27, 48879) // offset 27: bytes 27 and 28 live in DIFFERENT words
print(b.loadU16(27))
print(b.loadU8(27))
print(b.loadU8(28))

// `store16` truncates the high 16 bits, and its result sign-extends or not
// according to which LOAD is asked — the same asymmetry as the byte width.
b.store16(32, 305441741) // 0x1234ABCD → 0xABCD
print(b.loadU16(32))
b.store16(36, 65535)
print(b.loadI16(36))
print(b.loadU16(36))
b.store16(38, 32768)
print(b.loadI16(38))
print(b.loadU16(38))
b.store16(40, 32767)
print(b.loadI16(40)) // the CONTROL: signed and unsigned must AGREE here
print(b.loadU16(40))
