// @run
// @log true
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log 4
// @log 3
// @log 0
// @log -1
// @log -1
// @log -1
// @log 1
// @log 1
// @log 3
// @log 0
// @log 0
// `std:str` SEARCH — `startsWith` / `endsWith` / `lastIndexOf`, and the three
// answers an empty needle forces.
//
// These are the affix and reverse-scan operations the core has no counterpart
// for (`indexOf` and `includes` ARE core builtins and are deliberately not
// re-exported — one name, one implementation). `lastIndexOf` keeps `indexOf`'s
// -1-for-absent convention rather than inventing a `i32 | null` beside it.
import { endsWith, lastIndexOf, startsWith } from "std:str"

// startsWith: every string begins with nothing; nothing begins with something.
print("abc".startsWith("ab"))     // true
print("abc".startsWith("abc"))    // true  — the whole string is a prefix
print("abc".startsWith("abcd"))   // false — longer than the haystack
print("abc".startsWith("bc"))     // false — a prefix, not a substring
print("abc".startsWith(""))       // true
print("".startsWith(""))          // true
print("".startsWith("a"))         // false

// endsWith: the mirror. A suffix longer than the string computes a NEGATIVE
// offset, which the shared matcher refuses instead of trapping.
print("abc".endsWith("bc"))       // true
print("abc".endsWith("abc"))      // true
print("abc".endsWith("aabc"))     // false — negative offset
print("abc".endsWith("ab"))       // false
print("abc".endsWith(""))         // true
print("".endsWith(""))            // true
print("".endsWith("a"))           // false

// lastIndexOf: the LAST occurrence, -1 when absent.
print("abcabc".lastIndexOf("bc"))  // 4
print("abcabc".lastIndexOf("abc")) // 3
print("abc".lastIndexOf("abc"))    // 0  — the only occurrence is at 0
print("abc".lastIndexOf("z"))      // -1
print("abc".lastIndexOf("abcd"))   // -1 — longer than the haystack
print("".lastIndexOf("a"))         // -1
// OVERLAP IS ALLOWED HERE, unlike in split/replaceAll: a position is being
// reported, not a sequence consumed, so the answer is the LAST position a match
// could start at.
print("aaa".lastIndexOf("aa"))     // 1
print("aaaa".lastIndexOf("aaa"))   // 1
// The empty needle occurs at all `length + 1` boundaries, so the last of them
// is `length` — the exact mirror of the core's `indexOf("") == 0`.
print("abc".lastIndexOf(""))       // 3
print("".lastIndexOf(""))          // 0
print("".indexOf(""))              // 0  — the core rule this one mirrors
