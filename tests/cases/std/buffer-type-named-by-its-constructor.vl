// @run
// @log 8
// @log 7
// DV-1212: `import { Buffer }` names the type as well as the constructor, and a `Buffer` is
// a `Buf`, so the two spellings mix freely.
import { Buf, Buffer, loadI32, storeI32 } from "std:buffer"

const b = Buffer(8)

export function get(): Buffer { b }

function asBuf(x: Buffer): Buf { x }

print(get().length)
storeI32(asBuf(get()), 0, 7)
print(b.loadI32(0))
