// @run
// @log 1
// @log 192
// @log 3
// @log 237
// `Utf8Error` carries the OFFENDING BYTE, and that field is what keeps the type
// distinct from the blessed `ParseError`.
//
// `error-handling-design.md` blesses `ParseError = { at: i32, msg: string }`. VL
// aliases are STRUCTURAL, so a two-field `Utf8Error` would be literally the same
// type — and a union naming both would fail at emit with `union box atom test on
// a union with no recorded members`. `ParseError` exists nowhere in code yet, so
// this module would have silently taken its seat and the first parser VL grows
// would have collided. `byte` was already computed and thrown away into prose.
import { Utf8Error, decodeUtf8 } from "std:utf8"

// An overlong `C0 80` after one good ASCII byte: fails at offset 1, byte 0xC0=192.
const overlong: u8[] = [104, 0xC0, 0x80]
const a = decodeUtf8(overlong)
if a is Utf8Error { print(a.at) print(a.byte) } else { print(-1) print(-1) }

// A surrogate `ED A0 80` after three good bytes: offset 3, byte 0xED=237.
const surrogate: u8[] = [97, 98, 99, 0xED, 0xA0, 0x80]
const b = decodeUtf8(surrogate)
if b is Utf8Error { print(b.at) print(b.byte) } else { print(-1) print(-1) }
