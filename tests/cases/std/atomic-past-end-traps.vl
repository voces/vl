// @trap
// A `std:atomic` word must lie inside its `Buf`: [off, off + 4) past `length` is still inside
// the memory, where an atomic write would corrupt a neighbour's protocol word with no engine trap.
import { Buffer } from "std:buffer"
import { atomicAddI32 } from "std:atomic"

const b = Buffer(8)
print(b.atomicAddI32(4, 1))
print(b.atomicAddI32(8, 1))
