// @run
// @log 170
// @log 10
// @log 17
// @log 170
// @log 8
// @log true
// @log 3
// @log 12
// @log 14
// @log 170
// @log 0
// THE `u8[]` BULK PAIR, `storeBytes` and `toBytes` (`bulk-copy-design.md` §E2).
// They replace the byte-at-a-time `for i in 0 to bytes.length - 1` idiom, and the
// `- 1` is the point: a whole-list copy has no length for the caller to get one
// short, which is the off-by-one this removes from every staging site.
//
// What is pinned here is the RANGE each one touches. `storeBytes` writes exactly
// `[off, off + src.length)` and `toBytes` reads exactly `[off, off + len)`, so the
// bytes on either side of the window are checked as well as the window itself.
import { Buffer, fill, loadU8, storeBytes, toBytes } from "std:buffer"

// A `u8[]` the way a decoder hands one over: built element by element.
const src: u8[] = []
for i in 0 to 7 { src.push(10 + i) }

// 0xAA everywhere, so any byte the copy touches by mistake is visible.
const b = Buffer(16)
b.fill(0, 16, 0xAA)
b.storeBytes(4, src)
print(b.loadU8(3)) // one below the window — untouched
print(b.loadU8(4)) // first byte written
print(b.loadU8(11)) // last byte written
print(b.loadU8(12)) // one above the window — untouched

// ROUND TRIP: what `storeBytes` put in is what `toBytes` answers.
const back = b.toBytes(4, 8)
print(back.length)
let same = true
for i in 0 to 7 { if back[i] != src[i] { same = false } }
print(same)

// AN INTERIOR WINDOW: three bytes from the middle of what was written, and
// `off` is relative to the `Buf` rather than to the earlier copy.
const win = b.toBytes(6, 3)
print(win.length)
print(win[0])
print(win[2])

// ZERO LENGTH in both directions, at the very end of the buffer — in range, and
// neither one moves a byte.
const none: u8[] = []
b.storeBytes(16, none)
print(b.loadU8(15))
const empty = b.toBytes(16, 0)
print(empty.length)
