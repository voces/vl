// @run
// @log 1
// @log 0
// @log 0
// @log 1
// @log 3
// `std:utf8` — DECODE IS STRICT, and the offset it reports is the failing byte.
//
// A decode failure is INFORMATION: those bytes are not text. Silently substituting turns
// "this is a PNG" into a string of question marks, which is how a wrong answer gets
// mistaken for a working program. So `decodeUtf8` returns `string | Utf8Error` and the
// lossy form is opt-in (`utf8-lossy.vl`) — Rust's `from_utf8` / `from_utf8_lossy` split,
// with the strict one as the default.
//
// The four rejections below are the four families a naive decoder gets wrong: an OVERLONG
// encoding (a shorter form existed), a SURROGATE (never valid in UTF-8), a lead byte ABOVE
// the U+10FFFF ceiling, and a TRUNCATED tail.
import { decodeUtf8 } from "std:utf8"

// Overlong: C0 80 encodes U+0000 in two bytes where one would do. Accepting it is a
// classic security bug — it smuggles a NUL past a byte-level filter.
const overlong: u8[] = [104, 0xC0, 0x80]
const a = decodeUtf8(overlong)
if a is string { print(0) } else { print(1) }

// A surrogate half (U+D800, spelled ED A0 80) is well-formed UTF-16 machinery and is
// never a valid UTF-8 scalar.
const surrogate: u8[] = [0xED, 0xA0, 0x80]
const b = decodeUtf8(surrogate)
if b is string { print(1) } else { print(0) }

// F5 would start a code point above U+10FFFF.
const tooBig: u8[] = [0xF5, 0x80, 0x80, 0x80]
const c = decodeUtf8(tooBig)
if c is string { print(1) } else { print(0) }

// A 3-byte lead with only one continuation byte: the input ENDS mid-character.
const truncated: u8[] = [0xE4, 0xB8]
const d = decodeUtf8(truncated)
if d is string { print(0) } else { print(1) }

// The error names WHERE, not just THAT — here the good ASCII prefix "abc" is 3 bytes, so
// the failure is at offset 3.
const late: u8[] = [97, 98, 99, 0xC0]
const e = decodeUtf8(late)
if e is string { print(-1) } else { print(e.at) }
