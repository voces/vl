// @run
// @log [007]
// @log [007]
// @log true
// @log true
// @log true
// @log [...42]
// @log [1-20-300]
// @log |  name|   age|  city|
// @log 3
// @log [anamebnamec]
// `std:str` AND `std:fmt` IN ONE FILE — the composition the split of these two
// modules exists to make possible.
//
// VL has no namespace import: every export lands in the importer's flat
// top-level scope, and a name that arrives twice is a HARD PARSE ERROR
// ("Duplicate binding …: module both imports and declares it"), not a shadowing
// warning. So while `std:fmt` carried its own `split`/`join`/`repeat`/`padLeft`
// implementations, a program could have number formatting OR the string surface
// but not both — and whichever module it reached for silently decided whether
// its `join` was O(n) or O(n²). `std:fmt` now re-exports those names from
// `std:str` instead of implementing them, so there is one implementation, and
// this file is the regression guard for that: it imports from BOTH modules at
// once and asserts the two spellings of the same function agree.
//
// It also stands in for the ordinary reason anyone wants these together —
// rendering a table row — which is what the last block does.
import { padLeft, toString } from "std:fmt"
import { join, padStart, split, trim } from "std:str"

// `padLeft` (this module's historical spelling) and `padStart` (the one beside
// `padEnd`) are ONE implementation reached by two names.
print("[" + "7".padLeft(3, "0") + "]")      // [007]
print("[" + "7".padStart(3, "0") + "]")     // [007]
print("7".padLeft(4, "ab") == "7".padStart(4, "ab"))   // true
print("hi".padLeft(1, "x") == "hi".padStart(1, "x"))   // true
print("x".padLeft(3, "") == "x".padStart(3, ""))       // true

// Number rendering from `std:fmt` feeding string work from `std:str`.
const n = 42
print("[" + n.toString().padStart(5, ".") + "]")          // [...42]
const nums = [1, 20, 300]
print("[" + nums.map((x: i32) => x.toString()).join("-") + "]")  // [1-20-300]

// A parse-and-render round trip: the shape every consumer of these two modules
// actually writes — split the row, clean each cell, pad it to a column width,
// and put it back together with `join`.
//
// The cells are collected into a `string[]` and joined ONCE rather than
// accumulated with `out = out + cell`. At three cells the difference is
// invisible; the habit is the point, and `std:str`'s header carries the
// measurement that makes it one (the accumulator is O(n²) on this compiler).
const row = "  name , age ,  city  "
const cells = row.split(",")
const cols: string[] = []
let i = 0
while i < cells.length {
  cols.push(cells[i].trim().padStart(6, " "))
  i = i + 1
}
print("|" + cols.join("|") + "|")                       // |  name|   age|  city|
print(cells.length)                                     // 3
// `join`'s separator is an ordinary string, including one that came out of the
// split it is undoing.
print("[" + ["a", "b", "c"].join(cells[0].trim()) + "]")   // [anamebnamec]
