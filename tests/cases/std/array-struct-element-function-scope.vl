// THE CAPABILITY ITS OWN REFUSAL FIXTURE HID: a struct-element receiver built INSIDE A
// FUNCTION is fully admitted by `std:array`, at every export, and has been all along.
//
// `error-array-struct-element.vl` next door pins the refusal and said, for the whole life of
// this module's header, that what "has never moved is that it does NOT admit a list whose
// element is a STRUCT" — and sent a caller to the parallel-index-array idiom for exactly the
// thing this file does with the plain spelling. It was an UNDER-promise, the first one on
// `std/array.vl`'s ledger and the only entry there that ever cost a caller a capability
// rather than a diagnostic. Found by the `std-api-reviewer` pass over the D33 retirement,
// which is the paragraph that had that sentence open.
//
// **THE DECIDING AXIS WAS THE RECEIVER'S SCOPE, NOT ITS ELEMENT — AND THAT AXIS IS NOW GONE
// (D703).** As measured when this file was written:
//
//   · a `Row[]` built inside a function              → RUNS (this file)
//   · the identical list at MODULE scope             → `monomorphize: unsupported argument
//                                                       type for `self`` (the fixture next door)
//   · a module-scope binding read from INSIDE a fn   → the same refusal — it is the BINDING's
//                                                       scope, not the call's
//   · a call RESULT used directly as the receiver
//     (`mk().sorted(byR)`), even at top level        → RUNS
//
// All four RUN now, and the correction this file made is what pointed at the root: the refusal
// was never about the element, it was `monoArgTyName`'s GLOBAL arm asking two rungs of the pin
// membership list where the LOCAL and PARAM arms ask the whole of it, and being switched off
// entirely inside a function. The former `error-` twin next door is now
// `array-struct-element-module-scope.vl` and pins the same three exports at the other scope.
//
// SORTING RECORDS BY A FIELD — the thing the refusal fixture calls "the single most obvious
// thing a caller will reach for first" — is what this file does, and it is correct AND STABLE:
// keys `1,1,2,3` come out in that order with the two `key: 1` rows keeping their input order
// (`seq` 1 then 3). The digits below are `key*10 + seq` per row, concatenated.
//
// `indexOf` over the same receiver gives STRUCTURAL struct equality — it finds a
// distinct-but-equal record rather than requiring the same reference — and `reverse` runs.
// Those two are here because "admitted" is a claim about the export set, not about `sorted`.
//
// The index-list idiom is still the right answer for a LARGE table, and it is still what
// `compiler/cli.vl` does. It is not a workaround for this shape, and since D703 it is not one
// for the module-scope shape either.
// The `type Row` DECLARATION is load-bearing for ADMISSION; the `: Row` / `: Row[]` annotations
// are NOT — strip them and this file still prints the same three numbers, which is why their
// hints are DECLARED rather than silenced. What the floor needs is a program with NEITHER a
// `type` of the layout NOR any inline annotation of it anywhere.
// @run
// @log 11132230
// @log 1
// @log 3
// @hint redundant type annotation: `rows` is inferred as `{key: i32, seq: i32}[]`
// @hint redundant type annotation: `rows` is inferred as `{key: i32, seq: i32}[]`
// @hint redundant type annotation: `needle` is inferred as `{key: i32, seq: i32}`
// @hint redundant type annotation: `rows` is inferred as `{key: i32, seq: i32}[]`
import { indexOf, reverse, sorted } from "std:array"

type Row = { key: i32, seq: i32 }

function byKey(a: Row, b: Row) { return a.key < b.key }

function sortedStable() {
  const rows: Row[] = [
    { key: 3, seq: 0 },
    { key: 1, seq: 1 },
    { key: 2, seq: 2 },
    { key: 1, seq: 3 },
  ]
  const out = rows.sorted(byKey)
  let acc = 0
  let i = 0
  while i < out.length {
    acc = acc * 100 + out[i].key * 10 + out[i].seq
    i = i + 1
  }
  return acc
}

// STRUCTURAL equality, not reference equality: the needle is a fresh record.
function structuralNeedle() {
  const rows: Row[] = [{ key: 5, seq: 0 }, { key: 6, seq: 1 }]
  const needle: Row = { key: 6, seq: 1 }
  return rows.indexOf(needle)
}

function reversedFirstKey() {
  const rows: Row[] = [{ key: 1, seq: 0 }, { key: 3, seq: 1 }]
  const out = rows.reverse()
  return out[0].key
}

print(sortedStable())
print(structuralNeedle())
print(reversedFirstKey())
