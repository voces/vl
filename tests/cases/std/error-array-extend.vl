// @check
// @error argument 1: expected readonly Circle[], got Shape[]
// @error no method '.extend' on array readonly i32[]
// @error argument 1: expected readonly i32[], got string[]
// @error argument 1: expected readonly i32[], got i32
// @hint redundant type annotation: `circles` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `mut` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `ints` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `strs` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `more` is inferred as `i32[]` — remove it to lean on inference
// What `extend` refuses, in the order below: a receiver NARROWER than the source (the wide
// receiver runs, in `array-extend.vl`), a read-only RECEIVER, a source of another element
// type, and a source that is not a list. A read-only SOURCE runs (D1798), in `array-extend.vl`.
import { extend } from "std:array"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

const circles: Circle[] = [{ r: 1 }]
const shapes: Shape[] = [{ s: 2 }]
circles.extend(shapes)

function view(): readonly i32[] { return [1] }
const mut: i32[] = [2]
view().extend(mut)

const ints: i32[] = [1]
const strs: string[] = ["a"]
ints.extend(strs)

const more: i32[] = [1]
more.extend(5)
