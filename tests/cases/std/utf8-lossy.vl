// @run
// @log h��i
// @log 4
// @log 1
// @log 1
// @log ab
// `std:utf8` — the LOSSY decode, and its unit is the MAXIMAL SUBPART.
//
// `decodeUtf8` is strict because a decode failure is information (see `utf8-reject.vl`).
// This is the deliberate opt-out, for the consumer that must show SOMETHING — a log
// tailer, an editor opening a file of unknown provenance. It is the WHATWG substitution
// algorithm, which is the one browsers implement, so text that renders here renders the
// same way there.
//
// THE SUBTLE PART, and the reason this file exists: replacement is per maximal subpart,
// NOT per bad byte. A truncated 4-byte sequence whose first three bytes are individually
// well-formed is ONE error, so it yields ONE U+FFFD — not three, and not four. Getting
// that wrong is invisible until someone diffs output against a browser.
import { decodeUtf8Lossy, encodeUtf8 } from "std:utf8"

// Two separate errors: C0 is an invalid lead, and the 80 after it is a stray
// continuation with no lead of its own. Two subparts, two replacements.
const twoBad: u8[] = [104, 0xC0, 0x80, 105]
print(decodeUtf8Lossy(twoBad))

// ...and that really is FOUR CODE POINTS (h, FFFD, FFFD, i). A VL string IS a code-point
// sequence, so `.length` counts characters, not the 8 bytes they re-encode to.
print(decodeUtf8Lossy(twoBad).length)

// A truncated `😀` (F0 9F 98, missing its last continuation byte): the three bytes form
// one maximal subpart, so ONE replacement character.
const truncEmoji: u8[] = [0xF0, 0x9F, 0x98]
const one = decodeUtf8Lossy(truncEmoji)
if encodeUtf8(one).length == 3 { print(1) } else { print(0) }

// Well-formed input is untouched — lossy is not a normalizing pass.
const good = encodeUtf8("中")
if decodeUtf8Lossy(good) == "中" { print(1) } else { print(0) }

// A bad byte at the very END still terminates cleanly rather than running off the array.
const trailing: u8[] = [97, 98]
print(decodeUtf8Lossy(trailing))
