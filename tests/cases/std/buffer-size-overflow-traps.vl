// @trap
// THE ALLOCATOR'S CEILING IS i32, AND IT SAYS SO. A byte address is an i32
// here, so the bump pointer stops being ORDERABLE past 2^31 — `next > base`
// silently becomes false and every later allocation overlaps every earlier one.
// `Buffer` refuses instead: the reservation below rounds up past i32 max, `next`
// comes back negative, and the guard fires.
//
// Note what does NOT happen: no `memory.grow` is attempted. The guard runs
// BEFORE the growth, so this costs nothing to run and nothing to fail — which is
// also why this branch is corpus-testable while the `memory.grow` returning -1
// branch beside it is not (measured: wasmtime 47 and V8 both satisfy a 2 GiB
// request, so no portable request fails).
import { Buffer } from "std:buffer"

const b = Buffer(2147483647)
print(b.base)
