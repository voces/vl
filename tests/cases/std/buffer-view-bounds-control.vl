// @run
// @log 16
// @log 99.5
// @log -4
// @log 4242
// @log 64
// THE INVERTED CONTROL for the three view-bounds trap fixtures. Those assert
// that an out-of-range index traps; a trap assertion alone cannot distinguish
// "the check fired" from "the whole program was broken", and — because the
// harness ignores `@log` on a `@trap` case — it also cannot show what the check
// PREVENTED. This case shows it, without ever going out of range.
//
// Every address the trap cases reach for is computed here with `byteAddr*`
// (which is deliberately unchecked — it computes an address, it does not
// dereference one) and then read through `Buf`'s UNFENCED byte accessors. Each
// read succeeds and returns a live neighbour. That is the measurement: the
// engine has no objection to any of these accesses, so the engine's trap is not
// the mechanism protecting the view, and the VL-level check is not redundant.
import {
  Buffer,
  byteAddrF32,
  byteAddrI32,
  f32view,
  i32view,
  loadF32,
  loadI32,
  storeF32,
  storeI32,
} from "std:buffer"

const b = Buffer(64)
const x = b.f32view(0, 4)

// PAST THE END. Element 4 of a 4-element view at byte 0 is byte 16.
const past = x.byteAddrF32(4)
const base = x.byteAddrF32(0)
print(past - base) // 16 — one past the end, still 16 bytes into a 64-byte Buf
b.storeF32(16, 99.5)
const neighbour = b.loadF32(16)
print(neighbour) // 99.5 — the unfenced read SUCCEEDS and returns the neighbour

// BELOW THE START. Element -1 of a view at byte 16 is byte 12.
const id = b.i32view(16, 2)
const idBase = id.byteAddrI32(0)
const under = id.byteAddrI32(-1)
print(under - idBase) // -4 — one element BELOW the view's first byte
b.storeI32(12, 4242)
const before = b.loadI32(12)
print(before) // 4242 — the unfenced read below the view also SUCCEEDS

// And the whole 64-byte extent is addressable, which is why none of the above
// could have been caught by the engine.
print(b.length)
