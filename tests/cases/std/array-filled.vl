// @run
// @log 256
// @log 0
// @log 0
// @log 1.5,1.5,1.5
// @log ab,ab
// @log true,true
// @log 0
// @log 9999999999,9999999999
// @log 0,0,1,5,2
// @log 5,0,1,2,3,4,6,7
// @log 8
// @hint redundant type annotation: `decodeTable` is inferred as `i32[]`
// `std:array.filled` — a LENGTH FIRST, then writes at arbitrary indices.
//
// `const a = []` plus `push` is the right idiom for a list that grows at its end, and
// it cannot express a table whose slots are written out of order: slot 5 is only
// reachable once slots 0-4 exist. `filled(n, v)` is the other constructor, and the
// element type comes from `v`, so no call below needs an annotation.
//
// The Huffman decode table at the bottom is the consumer shape this exists for: three
// tables sized from a bit-length histogram, each one written at indices the loop
// computes rather than visits in order.
import { filled } from "std:array"
import { join, toString } from "std:fmt"

function showI(xs: i32[]) {
  const parts: string[] = []
  let i = 0
  while i < xs.length {
    parts.push(toString(xs[i]))
    i = i + 1
  }
  print(parts.join(","))
}

// A scalar fill at each width. The last index is read, not just the length, because a
// wrong `array.new` length is visible in `.length` while a wrong FILL is not.
const t = filled(256, 0)
print(t.length)
print(t[255])
print(t[128])

const fs = filled(3, 1.5)
print(toString(fs[0]) + "," + toString(fs[1]) + "," + toString(fs[2]))
const ss = filled(2, "ab")
print(ss[0] + "," + ss[1])
const bs = filled(2, true)
print(toString(bs[0]) + "," + toString(bs[1]))

// A zero length is the empty list, not an error — a table sized from data that
// happened to be empty is the common way to reach it.
print(filled(0, 7).length)
const ls = filled(2, 9999999999)
print(toString(ls[0]) + "," + toString(ls[1]))

// The decode table. `count` is a histogram over bit lengths, `offs` the running start
// of each length's block, and `symbol` is written at `offs[len]` — an index that jumps
// around, which is the whole reason the table needs its length up front.
const MAXBITS = 4

function decodeTable(lengths: i32[]): i32[] {
  const count = filled(MAXBITS + 1, 0)
  let i = 0
  while i < lengths.length {
    count[lengths[i]] = count[lengths[i]] + 1
    i = i + 1
  }
  showI(count)
  const offs = filled(MAXBITS + 1, 0)
  let b = 1
  while b < MAXBITS {
    offs[b + 1] = offs[b] + count[b]
    b = b + 1
  }
  const symbol = filled(lengths.length, -1)
  let s = 0
  while s < lengths.length {
    const len = lengths[s]
    symbol[offs[len]] = s
    offs[len] = offs[len] + 1
    s = s + 1
  }
  return symbol
}

const table = decodeTable([3, 3, 3, 3, 3, 2, 4, 4])
showI(table)
// Every slot was written exactly once, so no -1 fill survives.
print(table.length)
