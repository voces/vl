// @run
// @log 3
// @log 1024
// @log 1032
// @log 1040
// @log 1056
// @log 0
// @log 0
// @log 111
// @log 222
// @log 1
// `std:buffer`'s ALLOCATOR POLICY, pinned by value — every number below is a
// decision `std/buffer.vl` documents, not an accident, so changing one must
// redden this file (`buffer-design.md` §C4: the compiler owns what an
// instruction is, the allocator's policy is ordinary code).
//
//   - `.length` is what the caller ASKED for (3), never the rounded reservation;
//   - the first allocation starts at 1024 — the reserved low region, which keeps
//     address 0 out of every `Buf` and leaves a documented kilobyte for programs
//     that poke raw addresses through the bare intrinsics (§A3's collision);
//   - sizes round up to 8, so 3 bytes advance the pointer to 1032 and 1 byte to
//     1040: every `Buf` starts 8-byte aligned, which is the natural alignment of
//     the widest scalar VL can store;
//   - a `Buf` is a plain GC struct, so `.base` and `.length` are field reads and
//     `.base` is the byte offset a HOST reads through `exports.memory`.
import { Buffer, loadI32, storeI32 } from "std:buffer"

const a = Buffer(3)
print(a.length) // the REQUESTED length, not the 8-byte reservation
print(a.base)   // HEAP_BASE — the reserved low region ends here

const b = Buffer(1)
print(b.base) // 1024 + alignUp(3) = 1032

const c = Buffer(16)
print(c.base) // 1032 + alignUp(1) = 1040

const d = Buffer(0)
print(d.base) // 1040 + 16 = 1056 — a zero-length Buf is legal and takes no bytes

// FRESH BYTES ARE ZERO, for free: a wasm memory starts zeroed and this allocator
// never hands an address out twice (until a `bufferRelease`), so `Buffer` runs no
// fill loop. Both of these were never written.
print(a.loadI32(0))
print(c.loadI32(12))

// TWO BUFFERS DO NOT COLLIDE — the §A3 hazard the allocator exists to remove.
a.storeI32(0, 111)
c.storeI32(0, 222)
print(a.loadI32(0))
print(c.loadI32(0))

// None of this grew the memory: 1024 + 8 + 8 + 16 fits in the default page.
print(__memory_size__())
