// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @log true
// @log true
// @log true
// @log true
// @log true
// @log 40
// @log 12,12,12,11,11,11,10,10,10,9,9,9,8,8,8,7,7,7,6,6,6,5,5,5,4,4,4,3,3,3,2,2,2,1,1,1,0,0,0,0
// @log true
// WHAT `sorted` DOES WITH A COMPARATOR THAT IS NOT A STRICT ORDER — a documented
// behaviour, not undefined behaviour, and this file is what makes that statement
// checkable.
//
// `sorted`'s contract asks for a strict less-than: `less(a, a)` false, and `less(a, b)`
// and `less(b, a)` never both true. Real comparators break that all the time — a `<=`
// written where `<` was meant, a key that mutates mid-sort, a three-way ported from
// another language and reduced to a boolean wrongly. In C++ the corresponding mistake
// walks `std::sort` off the end of the array; the guarantee here is deliberately
// stronger and deliberately cheap:
//
//   THE RESULT IS ALWAYS A PERMUTATION OF THE INPUT. The ORDER is unspecified, but no
//   element is lost, duplicated or invented, and the call never traps or reads out of
//   bounds.
//
// SCOPED TO WHAT `less` ANSWERS, NOT WHAT IT DOES. Every comparator below is pure — it
// returns a wrong boolean and nothing else. A comparator that MUTATES the receiver is a
// different failure with a different outcome, and under the in-place `sort` it can trap:
// see `array-sort-comparator-pops-traps.vl`. The index bounds that make a lying
// comparator safe are the same bounds a shrinking one invalidates.
//
// It holds because every loop in `sorted` is bounded by an INDEX and never by the
// comparator: the base case guards on `j >= lo`, and the merge guards on
// `p < mid && q < e` with unconditional drains after it. A sentinel-style
// `while less(...)` walk would not have this property, which is exactly why the
// implementation does not use one.
//
// Three ways to break the contract are exercised below, at n = 40 so both the
// insertion base case and the merge are involved.
import { count, sorted } from "std:array"
import { join, toStr } from "std:fmt"

const src: i32[] = []
let i = 0
while i < 40 {
  src.push((i * 7) % 13)
  i = i + 1
}

// A permutation check that does not itself assume an ordering: same length, and every
// distinct value occurs the same number of times on both sides.
function isPermutationOfSrc(out: i32[]) {
  if out.length != src.length { return false }
  let ok = true
  let k = 0
  while k < src.length {
    if src.count(src[k]) != out.count(src[k]) { ok = false }
    k = k + 1
  }
  ok
}

// ── 1. constantly TRUE: everything is less than everything, itself included ───
// The worst case for the base case — every element wants to travel all the way to the
// front — and it is `j >= lo` alone that stops it.
print(isPermutationOfSrc(src.sorted((_a: i32, _b: i32) => true)))

// ── 2. constantly FALSE: nothing is less than anything ────────────────────────
// The identity, and the stability pin's strongest case (`array-sorted-stability.vl`).
print(isPermutationOfSrc(src.sorted((_a: i32, _b: i32) => false)))

// ── 3. NON-STRICT `<=` where `<` was meant ────────────────────────────────────
// The realistic mistake. `less(a, a)` is now true, so equal elements never settle and
// the tie order is not the input order; the result still holds exactly the same
// multiset, and it is still ascending here because `<=` and `<` disagree only on ties.
const nonStrict = src.sorted((a: i32, b: i32) => a <= b)
print(isPermutationOfSrc(nonStrict))
let ascending = true
i = 1
while i < nonStrict.length {
  if nonStrict[i - 1] > nonStrict[i] { ascending = false }
  i = i + 1
}
print(ascending)

// ── 4. NON-TRANSITIVE: a < b iff they differ in a way that cycles ─────────────
// `(a - b + 13) % 13 < 7` is the classic "rock-paper-scissors" comparator: for values
// in [0, 13) it says 0 < 5, 5 < 10 and 10 < 0, so no total order exists at all and no
// output can be "correct". The multiset is still preserved, which is the whole claim.
const cyclic = src.sorted((a: i32, b: i32) => (a - b + 13) % 13 < 7)
print(isPermutationOfSrc(cyclic))
print(cyclic.length)

// ── and a WELL-BEHAVED comparator over the same input, for contrast ───────────
// Sorting descending, to show that "the order is unspecified" above is a statement
// about broken comparators only — a strict order gets exactly what it asked for.
const desc = src.sorted((a: i32, b: i32) => a > b)
const parts: string[] = []
i = 0
while i < desc.length {
  parts.push(toStr(desc[i]))
  i = i + 1
}
print(parts.join(","))
print(isPermutationOfSrc(desc))
