// @run
// @log [<a><b><c>]
// @log [<abc>]
// @log [<><a>]
// @log [<a><>]
// @log [<a><><b>]
// @log [<><>]
// @log [<>]
// @log [<x><y><z>]
// @log [<ab>]
// @log [<><a>]
// @log [<><><>]
// @log [<a><b><c>]
// @log []
// @log [a, b, c]
// @log [solo]
// @log [-]
// @log []
// @log []
// @log [ab]
// @log true
// @log true
// @log true
// @log true
// `std:str` SPLIT and JOIN — the inverse pair, and every degenerate separator.
//
// Splitting is the operation VL could not do at all before this module, and it
// is the one whose edges people actually hit: a separator at the very start, at
// the very end, doubled, absent, overlapping, or empty. Each is pinned below
// with the ruling from `std:str`'s header beside it.
//
// Results print as `<piece><piece>` inside `[]` so an empty piece and an empty
// LIST are distinguishable on the `@log` line — `[]` is no pieces, `[<>]` is one
// empty piece, and the difference between those two is the whole `""` edge.
// `show` deliberately does NOT use `join`: this file asserts `join` too, and a
// renderer built out of the thing under test asserts nothing.
import { join, split } from "std:str"

function show(xs: string[]) {
  let out = "["
  let i = 0
  while i < xs.length {
    out = out + "<" + xs[i] + ">"
    i = i + 1
  }
  return out + "]"
}

// THE RULE: one more piece than the separator has occurrences.
print(show("a,b,c".split(",")))          // [<a><b><c>]
print(show("abc".split(",")))            // [<abc>]  — absent, one piece
print(show(",a".split(",")))             // [<><a>]  — leading separator
print(show("a,".split(",")))             // [<a><>]  — trailing separator
print(show("a,,b".split(",")))           // [<a><><b>] — adjacent
print(show(",".split(",")))              // [<><>]  — the separator alone
print(show("".split(",")))               // [<>]    — empty input, ONE empty piece
// Multi-character separators, including one longer than the input.
print(show("x::y::z".split("::")))       // [<x><y><z>]
print(show("ab".split("abcd")))          // [<ab>]
// OVERLAP: matches are consumed left to right and never overlap, so the second
// `a` of `"aa"` is eaten and the third is left over.
print(show("aaa".split("aa")))           // [<><a>]
print(show("aaaa".split("aa")))          // [<><><>]
// THE EMPTY SEPARATOR splits into characters — and that is why the two empty
// INPUTS disagree: "" split on "," has one field, "" split into characters has
// none.
print(show("abc".split("")))             // [<a><b><c>]
print(show("".split("")))                // []

// JOIN — the inverse. No trailing separator, ever; one separator per GAP.
print("[" + ["a", "b", "c"].join(", ") + "]")   // [a, b, c]
print("[" + ["solo"].join("-") + "]")           // [solo] — sep never used
print("[" + ["", ""].join("-") + "]")           // [-]    — one gap, two empties
print("[" + [""].join("-") + "]")               // []
const none: string[] = []
print("[" + none.join("-") + "]")               // []
print("[" + ["a", "b"].join("") + "]")          // [ab]   — empty separator

// THE LAW, on exactly the inputs that break naive implementations:
//   s.split(sep).join(sep) == s        for every non-empty sep
print("a,b,c".split(",").join(",") == "a,b,c")
print(",a,,b,".split(",").join(",") == ",a,,b,")
print("".split(",").join(",") == "")
print("aaa".split("aa").join("aa") == "aaa")
