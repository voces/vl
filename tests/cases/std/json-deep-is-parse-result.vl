// @run
// @log 8081
// @log true
// @log 3
// @log false
// DEEP `is` OVER A `parseJson` RESULT — the design's own example, end to end, and the case
// that made the MODULE build a distinct problem from the single-source one.
//
// `docs/serde-design.md` §"Deep `is` / `as` over a `Json` value" opens with
// `const doc = text.parseJson()` then `if doc is Cfg { … }`, so the receiver here is
// `Json | JsonError` — WIDER than the tree. Two things follow, and both are measured rather
// than assumed:
//
//   * The walker's PARAMETER is the receiver's own type, not `Json`, because a
//     `Json | JsonError` is not assignable to `Json`. Its container tests still work: the
//     nested union's arms flatten through, so `doc is {[string]: Json}` runs over that type
//     today while `doc is Json` is a loud emit reject.
//   * A module build renames every declaration `Json` → `Json$m1`, which is exactly what
//     makes the generated fragment resolve in the merged scope — and `$` is NOT an
//     identifier character. The generator writes a lexable stand-in and the driver restores
//     the `$` ON THE TOKEN STREAM before the fragment parses. Without that this program was
//     forty parse errors, on a program that used to compile and answer wrong.
//
// S2 and S3 ride along: `8080` is integral and in range so it reads into `port: i32`, and
// the ABSENT `host` key matches `string | null` as `null`.
import { Json, parseJson } from "std:json"

type Cfg = { port: i32, host: string | null }

const doc = "{\"port\": 8080}".parseJson()
if doc is Cfg {
  print(doc.port + 1)
  print(doc.host == null)
} else {
  print(-1)
  print(false)
}

const arr = "[\"xyz\"]".parseJson()
if arr is string[] { print(arr[0].length) } else { print(-1) }

const nothing: Json = null
print(nothing is Cfg)
