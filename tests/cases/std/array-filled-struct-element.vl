// @run
// @log 4
// @log -1
// @log -1
// @log 7
// @log 7
// @log 5
// @hint redundant type annotation: `nodes` is inferred as `{count: i32, symbol: i32}[]`
// `std:array.filled` at a REFERENCE element, and the sharing that comes with it.
//
// `array.new` writes the same reference into every slot, so `filled(n, someStruct)`
// leaves all `n` slots pointing at ONE object: writing through slot 0 is visible from
// slot 1. That is the doc comment's "shared, not copied", and it is the difference
// between this constructor and a `push` loop that builds a fresh literal each time.
// For one object per slot, `filled(n, 0).mapIndexed(f)` composes into it —
// `array-filled-nested-element.vl` runs that spelling.
//
// (The nested-list element lives in `array-filled-nested-element.vl` — a struct
// element and a list element instantiated in ONE module do not lower today, and
// `scripts/capability-probes/generic-array-new-struct-then-nested.vl` is that gap.)
import { filled } from "std:array"

type Node = { count: i32, symbol: i32 }

const nodes: Node[] = filled(4, { count: 0, symbol: -1 })
print(nodes.length)
print(nodes[0].symbol)
print(nodes[3].symbol)

// One object, four slots.
nodes[0].symbol = 7
print(nodes[0].symbol)
print(nodes[3].symbol)

// The UN-ANNOTATED face: without `: Node[]` the element is the fill's own anonymous
// shape, and the constructor reaches it the same way. Both faces are here because an
// annotation pins the element's representation and can hide a defect in the other one.
const anon = filled(2, { count: 5, symbol: 6 })
print(anon[1].count)
