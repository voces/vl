// @run
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// A generic function passes its own generic-typed function parameter to another generic
// function: directly, through a forwarding local, and re-wrapped in a lambda. Each was an emit
// refusal until the argument's function type was pinned per instance (D2552). This is the call
// `std:array`'s `sorted` needs to be `copy; sort(out, less); return out`; `array-sort-agrees.vl`
// keeps its two copies of the merge honest until that collapse lands.
function inner<T>(xs: T[], f: (T, T) => boolean) { f(xs[0], xs[1]) }
function direct<T>(xs: T[], f: (T, T) => boolean) { inner(xs, f) }
function viaLocal<T>(xs: T[], f: (T, T) => boolean) {
  const g = f
  return inner(xs, g)
}
function rewrapped<T>(xs: T[], f: (T, T) => boolean) {
  inner(xs, (a: T, b: T) => f(a, b))
}
print(direct([1, 2], (a: i32, b: i32) => a < b))
print(direct(["b", "a"], (a: string, b: string) => a < b))
print(viaLocal([1, 2], (a: i32, b: i32) => a < b))
print(viaLocal(["b", "a"], (a: string, b: string) => a < b))
print(rewrapped([1, 2], (a: i32, b: i32) => a < b))
print(rewrapped(["b", "a"], (a: string, b: string) => a < b))
