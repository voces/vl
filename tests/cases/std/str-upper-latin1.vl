// @log ABC-123 ÉÉ
// @log true
// @log HRíMEY
// `std:str` `toUpperLatin1` (D3641, sunpa SP-029): `toUpperAscii` plus the Latin-1 letters.
// `à`..`þ` shift down by 32 except `÷`; `ÿ` maps to `Ÿ` (U+0178), outside Latin-1, as Unicode,
// Java and ICU map it. `ß` and `µ` have no single-character capital in Latin-1 and stay.
import { toUpperAscii, toUpperLatin1 } from "std:str"

print(toUpperLatin1("Hrímey"))
print(toUpperLatin1("àáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþ"))
print(toUpperLatin1("ÿ") == fromCodePoint(376))
// Upper case, `÷` and the two letters with no capital here come back unchanged.
print(toUpperLatin1("ÀÞ÷ßµ") == "ÀÞ÷ßµ")
// Outside Latin-1 nothing changes, not even a letter that has a capital.
print(toUpperLatin1("ğ ж ω") == "ğ ж ω")
// The boundaries: `ß` (U+00DF) and `÷` (U+00F7) sit just outside the shifted ranges.
print(toUpperLatin1(fromCodePoint(223)) == fromCodePoint(223))
print(toUpperLatin1(fromCodePoint(247)) == fromCodePoint(247))
print(toUpperLatin1("abc-123 éÉ"))
// On ASCII it is `toUpperAscii`; on Latin-1 letters `toUpperAscii` stops.
print(toUpperLatin1("hello, world") == toUpperAscii("hello, world"))
print(toUpperAscii("hrímey"))
