// @run
// @log 3 4
// @log 1 1
// @log false false false
// @log 2
// @log true false
// @log 1
// @log 9
// @log 0 0
// `std:idtable` over a record value: both spellings of read and write, a miss at a hole, past
// the end and below zero, `length` as the count of ids present, `delete` answering whether
// one was there, and `ids()` ascending.
import { toString } from "std:fmt"
import { IdTable, delete, get, has, ids, set } from "std:idtable"

type Tex = { w: i32, h: i32 }
const t = IdTable<Tex>()
t.set(5, { w: 3, h: 4 })
t[9] = { w: 1, h: 1 }
const a = t.get(5)
if a != null { print(toString(a.w) + " " + toString(a.h)) }
const b = t[9]
if b != null { print(toString(b.w) + " " + toString(b.h)) }
print(
  toString(t.has(2)) + " " + toString(t.has(-1)) + " " + toString(t.has(100)),
)
print(t.length)
print(toString(t.delete(5)) + " " + toString(t.delete(5)))
print(t.length)
for id in t.ids() { print(id) }
const empty = IdTable<Tex>()
print(toString(empty.length) + " " + toString(empty.ids().length))
