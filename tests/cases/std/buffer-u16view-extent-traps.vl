// @trap
// The extent counts BYTES: 32 halfwords from byte 1 end at byte 65, past a
// 64-byte `Buf`, so the view is refused where it is built. (`u8view(1, 32)` fits.)
import { Buffer, u16view, u8view } from "std:buffer"

const b = Buffer(64)
const t = b.u8view(1, 32)
print(t.length)
const o = b.u16view(1, 32)
print(o.length)
print("unreachable marker")
