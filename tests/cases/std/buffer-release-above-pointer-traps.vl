// @trap
// A MARK ABOVE THE BUMP POINTER IS A BUG, NOT A HINT. `bufferRelease` restores
// the pointer, so a mark taken from somewhere the allocator has not reached
// would RE-RESERVE bytes that are already free — the allocator would then hand
// out an extent it had also handed out before, which is the dangling-`Buf`
// hazard arriving without anyone asking for it.
//
// The mark below was never returned by `bufferMark()`; it is one the caller made
// up. There is no liveness tracking to consult, so the only honest answer is to
// stop. (Reason text shared with every `__trap__` site — only the trap is pinned.)
import { Buffer, bufferMark, bufferRelease } from "std:buffer"

const b = Buffer(16)
bufferRelease(bufferMark() + 8)
print(b.length)
