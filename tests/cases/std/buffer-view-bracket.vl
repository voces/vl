// @run
// @log 1.5
// @log 2.5
// @log 7
// @log 9
// @log 3.25
// @log 11
// @log 6
// @log 4
// webcraft P1.1's spelling: `x[i]` / `x[i] = v` over a typed view, through
// `std:buffer`'s free INDEX OPERATORS (B14). Two `"[]"` declarations live in one
// module — one per view type — and dispatch apart on the nominal BRAND, which is
// the only difference between `F32View` and `I32View` (their structures are
// identical). Cross-module: the operators are declared in `std:buffer` and used
// here, and are never named at this call site at all.
//
// The bracket is SPELLING: each operator forwards to the accessor of the same
// name, so the two spellings mix freely in one loop and read/write the same
// bytes with the same bounds check.
import { Buffer, f32view, getI32, i32view, setF32 } from "std:buffer"

const buf = Buffer(64)
const fv = buf.f32view(0, 4)
const iv = buf.i32view(16, 4)

fv[0] = 1.5
fv[1] = 2.5
iv[0] = 7
iv[1] = 9

print(fv[0])
print(fv[1])
print(iv[0])
print(iv[1])

// The accessor spelling and the bracket agree, both directions.
fv.setF32(2, 3.25)
print(fv[2])
iv[2] = 11
print(iv.getI32(2))

// A loop over a view, the shape the whole tier exists for.
let i = 0
while i < 4 {
  iv[i] = i
  i = i + 1
}
let j = 0
let acc = 0
while j < 4 {
  acc = acc + iv[j]
  j = j + 1
}
print(acc) // 0+1+2+3

// A compound write through the pair.
iv[3] += 1
print(iv[3])
