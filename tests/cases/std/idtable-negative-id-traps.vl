// @trap
// A negative id is a caller's bug, not an absent slot: `set` traps rather than dropping the
// value. Reads of a negative id answer `null` (see idtable-basics.vl).
import { IdTable, set } from "std:idtable"

type Tex = { w: i32 }
const t = IdTable<Tex>()
t.set(-1, { w: 1 })
print("unreachable")
