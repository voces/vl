// @trap
// The LOW half of the hoisted accessors' fence. As with the view accessors, VL
// has no unsigned comparison operator, so `0 <= i < length` is two signed
// compares and the negative case is its own arm — `setI32At` must refuse index
// -1 rather than write to the byte four below the base, which here is a live
// word of the preceding column.
//
// Inverted control: `buffer-hoisted-accessors.vl` (a `@trap` case cannot carry
// asserted `@log` output — see that file's header).
import {
  Buffer,
  byteAddrI32,
  getI32At,
  i32view,
  setI32At,
  storeI32,
} from "std:buffer"

const b = Buffer(64)
b.storeI32(12, 4242) // the word an unfenced `setI32At(base, n, -1, …)` would clobber
const v = b.i32view(16, 2)
const base = v.byteAddrI32(0)
const n = v.length
setI32At(base, n, -1, 9)
print(getI32At(base, n, 0))
