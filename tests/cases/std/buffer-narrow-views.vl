// @run
// @log 44
// @log 255
// @log 44
// @log 4464
// @log 4464
// @log 65535
// @log 9
// @log 7
// @log 7
// @log 200
// @log 1
// @log 2
// @log 9
// @log 8
// @log 0
// @log 255
// @log 65535
// The byte-wide views (`u8view`/`u16view`, issue #9675), each access
// cross-checked against `Buf`'s raw byte accessors: zero-extended reads,
// truncating writes, an ODD base for a u16 view, the bracket and hoisted
// spellings agreeing, and the first and last elements of each fence in range.
import {
  Buffer,
  byteAddrU16,
  byteAddrU8,
  getU16,
  getU16At,
  getU8,
  getU8At,
  loadU16,
  loadU8,
  setU16At,
  setU8,
  setU8At,
  store16,
  u16base,
  u16view,
  u8base,
  u8view,
} from "std:buffer"

const b = Buffer(64)
const t = b.u8view(0, 8)
const o = b.u16view(9, 4) // bytes [9, 17): an odd base

// A write keeps the low 8 bits; a read zero-extends.
t[0] = 300
print(t[0]) // 44
t.setU8(7, -1)
print(t.getU8(7)) // 255, not -1
print(b.loadU8(0)) // 44: the raw byte agrees

// A u16 write keeps the low 16 bits, little-endian, at byte 9 + 2*i.
o[3] = 70000
print(o[3]) // 4464
print(b.loadU16(15)) // 4464
b.store16(11, -1)
print(o.getU16(1)) // 65535: element 1 is byte 11, zero-extended

// Compound writes through the bracket pair.
o[0] = 4
o[0] += 5
print(o[0]) // 9

// The hoisted spelling reads and writes the same bytes as the view.
const tb = u8base(t)
setU8At(tb, t.length, 3, 7)
print(t[3]) // 7
print(getU8At(tb, t.length, 3)) // 7
const ob = u16base(o)
setU16At(ob, o.length, 2, 200)
print(getU16At(ob, o.length, 2)) // 200

// Addresses: one byte per u8 element, two per u16 element.
print(t.byteAddrU8(1) - t.byteAddrU8(0)) // 1
print(o.byteAddrU16(1) - o.byteAddrU16(0)) // 2
print(o.byteAddrU16(0) - t.byteAddrU8(0)) // 9

// A u8 view over the u16 view's bytes sees the low byte first.
const raw = b.u8view(9, 8)
print(raw.length) // 8
print(raw[1]) // 0: high byte of 9

// The last element of each fence is in range.
t[7] = 255
print(t[7]) // 255
o[3] = 65535
print(o[3]) // 65535
