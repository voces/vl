// @trap
// A NEGATIVE LENGTH IS NOT A SMALL ALLOCATION. `Buffer(n)` traps rather than
// letting the bump pointer walk BACKWARDS, which would hand the next caller an
// extent overlapping the previous one — silent corruption of every allocation
// that follows, discovered arbitrarily far away.
//
// This is allocator-time validation, not a per-access bounds check (§A4 rules
// those out): it costs one compare per `Buffer` call and it is the only thing
// standing between a sign error and a heap that lies about who owns what.
// (The mapped trap REASON is shared with every `__trap__`/bounds site — all lower
// to `unreachable` — so only the trap itself is pinned.)
import { Buffer } from "std:buffer"

const b = Buffer(-1)
print(b.length)
