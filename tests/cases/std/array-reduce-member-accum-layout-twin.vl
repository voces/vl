// Regression (silent-class-inventory D33, the LOUD rung of the same layout-twin family):
// `reduce` at `A = Circle`, a MEMBER STRUCT of a declared union, in a program that ALSO
// declares a standalone struct of the arm's EXACT layout. `type Dot = { r: i32 }` below is the
// whole trigger and is never mentioned again.
//
// THIS FILE WAS `error-array-reduce-member-accum-layout-twin.vl` AND PINNED A REFUSAL. It was
// the LAST live carve-out on `std:array`'s own surface: `emitProgram: ref valtype with no
// interned shape` — honest, loud, wrote nothing, and pre-existing on `a80c6717` and
// `235b365b` alike. It is retired, so the file is renamed and pins the RUN instead. A caller
// who took the documented remedy (do not declare a standalone struct with a union arm's exact
// layout) is still correct; it is no longer needed.
//
// IT WENT WITH D33 BECAUSE IT WAS THE SAME PREDICATE, which is the part worth recording. D33
// was the SILENT rung — a type parameter first bound through a callback annotation resolving
// the arm onto the twin's nominal name — and the fix is one arena rung in `shapeNominalOfTy`:
// ask `variantRowOfTy` (declaration identity in the VARIANT table) before the two STRUCTURAL
// field-set scans, exactly as `structIndexOfTy` is asked before them for the struct table. The
// same resolver feeds `recordedParamPinName`, which is what mints this file's `A = Circle`
// pin, so both rungs moved together rather than one being widened to reach the other.
//
// THE DECIDING AXIS WAS ALWAYS THE LAYOUT TWIN, not the pairing of two accumulator types and
// not the scope. Each of these was one line different from this file and RAN before the fix:
//   · `Dot` DELETED                  → runs, `8` / `1`
//   · `type Dot = { q: i32 }`        → runs (same arity, different field NAME)
//   · `type Dot = { r: string }`     → runs (same field name, different TYPE)
// so the twin is what this file adds to `array-reduce-narrowed-variant-init.vl`, whose cross
// product over the accumulator TYPE has no twin axis at all. It keeps its own file for the
// reason it always had one: the refusal it used to pin aborted the module, and the shape is
// worth keeping separable now that it does not.
//
// Found by the `std-api-reviewer` pass over the D26 retirement; closed with D33.
// @run
// @log 8
// @log 1
// @hint redundant type annotation: `useShape` is inferred as `i32`
// @hint redundant type annotation: `foldCircle` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
import { reduce } from "std:array"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

function bumpCircle(acc: Circle, x: i32): Circle { return { r: acc.r + x } }

function useShape(): i32 {
  const s: Shape = { r: 1 }
  if s is Circle { return s.r }
  return -2
}

function foldCircle(): i32 {
  const c: Circle = { r: 5 }
  const out = reduce([1, 2], bumpCircle, c)
  return out.r
}

print(foldCircle())
print(useShape())
