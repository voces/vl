// @emit-error emitProgram: ref valtype with no interned shape
// THE AXIS THE `reduce` ACCUMULATOR RETIREMENT WAS SCOPED BY, pinned in its own file because
// it cannot share one: this refusal aborts the module, so adding the trigger line to
// `array-reduce-narrowed-variant-init.vl` would turn every running cell in that file into
// this error rather than adding a cell to it.
//
// `A = Circle`, a MEMBER STRUCT of a declared union, is admitted — `array-reduce-narrowed-
// variant-init.vl` runs three consumptions of it, and that is what `silent-class-inventory`
// D26 closed. It stops being admitted when the program ALSO declares a standalone struct with
// the arm's EXACT layout. `type Dot = { r: i32 }` below is the whole trigger and is never
// mentioned again; delete it and this file prints `8` / `1`.
//
// THE DECIDING AXIS IS THE LAYOUT TWIN — not the pairing of two accumulator types, and not
// the scope. Measured, each ONE line different from this file:
//   · `Dot` DELETED                  → runs, `8` / `1`
//   · `type Dot = { q: i32 }`        → runs (same arity, different field NAME)
//   · `type Dot = { r: string }`     → runs (same field name, different TYPE)
// `std/array.vl`'s D26 retirement was scoped by SCOPE ("AT FUNCTION SCOPE, which is the
// qualifier this sentence needs"), and a draft of the D32 retirement then widened it to
// "neither the accumulator nor the list needs care any more". Both are qualified by this
// file instead. Found by the `std-api-reviewer` pass over that retirement.
//
// HONEST, NOT SILENT — kind two of the three in `std/array.vl`'s header, an emit refusal that
// writes nothing. `vl check` reports the program clean; `vl build` / `vl run` /
// `vl check --codegen` all say no, and none of them writes a bad module. Pre-existing and
// byte-identical on `a80c6717`, so it is a pin rather than a regression.
//
// It is the SAME layout-twin family as D32 and D33 and a THIRD rung — this one already loud,
// which is why it is a pin here and not an inventory row.
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `useShape` is inferred as `i32`
// @hint redundant type annotation: `foldCircle` is inferred as `i32`
import { reduce } from "std:array"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

function bumpCircle(acc: Circle, x: i32): Circle { return { r: acc.r + x } }

function useShape(): i32 {
  const s: Shape = { r: 1 }
  if s is Circle { return s.r }
  return -2
}

function foldCircle(): i32 {
  const c: Circle = { r: 5 }
  const out = reduce([1, 2], bumpCircle, c)
  return out.r
}

print(foldCircle())
print(useShape())
