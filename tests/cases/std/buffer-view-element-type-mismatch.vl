// @error no field 'getF32' on {i32base: i32, length: i32}
// THE ELEMENT TYPE IS PART OF THE TYPE, AND THE FIELD NAME IS WHAT MAKES IT SO.
//
// VL is STRUCTURALLY typed: `type X = {…}` names a shape, not a nominal identity,
// so two declarations with the same field names and types are THE SAME TYPE and
// are silently interchangeable. Spelled the obvious way — both views as
// `{ base: i32, length: i32 }` — this program would COMPILE, and `id.getF32(0)`
// would reinterpret four integer bytes as a float with no diagnostic. That was
// measured before the field names were chosen, not assumed.
//
// So `F32View` spells its address field `f32base` and `I32View` spells its
// `i32base`. The discriminator is put where a structural checker can see it, and
// this reject is the whole return on that awkwardness. A nominal newtype
// (webcraft P1.5) would let both go back to `base`; until then the field name IS
// the element type.
//
// The error names the STRUCTURE rather than the alias because `tyToStr` renders
// a `TyObj` structurally — which is itself the evidence that no nominal identity
// exists to name.
import { Buffer, getF32, i32view } from "std:buffer"

const b = Buffer(64)
const id = b.i32view(0, 4)
const bad = id.getF32(0)
print(bad)
