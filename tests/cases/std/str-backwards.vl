// @run
// @log cba
// @log olléh
// @log b🎉a
// @log []
// @log x
// @log true
// @log true
// `std:str` BACKWARDS — reverse a string by CODE POINT, not by byte.
//
// The whole point is UTF-8 safety: reversing the raw bytes of a multi-byte code
// point would produce mojibake, so `backwards` reverses the code-point SEQUENCE
// and each code point stays whole. An empty string reverses to itself, and the
// operation is its own inverse.
import { backwards } from "std:str"

print("abc".backwards()) // cba
print("héllo".backwards()) // olléh — the two-byte é stays whole
print("a🎉b".backwards()) // b🎉a — the four-byte emoji stays whole
print("[" + "".backwards() + "]") // [] — empty reverses to itself
print("x".backwards()) // x — a single code point is unchanged
// THE LAW: reversing twice is identity, a multi-byte code point included.
print("a🎉b".backwards().backwards() == "a🎉b")
print("héllo".backwards().backwards() == "héllo")
