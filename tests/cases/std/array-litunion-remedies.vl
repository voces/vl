// @run
// @log 1
// @log 1
// @log true
// @log 2
// @log b
// @hint redundant type annotation: `pickStr` is inferred as `string`
// @hint redundant type annotation: `seed` is inferred as `string`
// THE TWO HINTS ABOVE ARE DECLARED, NOT SILENCED, and that is the point of the fixture.
// Both annotations are redundant to inference — a bare `"a"` already defaults to the BASE
// type `string` rather than to the literal union — and both are exactly the remedy this file
// exists to execute. Removing them to quiet the lint would delete the thing under test: the
// remedy is "give the accumulator the type `string`", and an inferred `string` demonstrates
// nothing to a reader who arrived because their `K` accumulator was refused.
// THE TWO REMEDIES `std/array.vl`'s carve-outs PRESCRIBE, executed rather than described.
//
// WHY THIS FILE EXISTS. Both carve-outs cited a fixture under "Pinned as" — and both of those
// pin the FAILURE (`xfail-miscompile-array-litunion-needle.vl`, `error-array-litunion-alias-
// tyaram.vl`). Nothing in the tree ran the remedy. That is the module header's own closing
// rule unmet: *a remedy is not a remedy until it has been RUN in the situation that needs
// it* — and the situation that needs it is a module where the alias IS declared, because an
// unused same-layout alias anywhere in the program is what arms both defects.
//
// `type K` below is therefore LOAD-BEARING, not decoration. Delete it and this file stops
// testing anything: the inline spellings are only broken while a same-layout alias exists.
import { count, includes, indexOf, lastIndexOf, reduce } from "std:array"

type K = "a" | "b"

// ── REMEDY 1: bind the needle, for all four exports that take one ──
// The carve-out is a BARE MEMBER LITERAL at the `needle` argument — the substituted
// `needle: T` is the interned atom while the literal is a string ref at `RC_ROOT`. A binding
// crosses that seam once, at a place the checker types, so the call sees an atom.
const xs: K[] = ["a", "b"]
const needle: K = "b"

print(xs.indexOf(needle))
print(xs.lastIndexOf(needle))
print(xs.includes(needle))
print(xs.count(needle) + 1)

// ── REMEDY 2: a `string` accumulator, narrowed at the use site ──
// `reduce`'s carve-out is the ACCUMULATOR `A`, first bound at the CALLBACK parameter, whose
// pin renders the type parameter's SOFTENED spelling — so an `A` that must widen back to
// member text has no member list to widen with. Typing the accumulator `string` keeps it on
// the softened side throughout, and the narrow recovers the member at the one place that
// needs it.
function pickStr(acc: string, x: i32): string {
  if x > 0 { return "b" }
  return acc
}

const seed: string = "a"
const folded = [0, 1].reduce(pickStr, seed)
if folded is K { print(folded) } else { print("NOT-K") }
