// @run
// @log 4
// @log -1
// @log -1
// @log 7
// @log 7
// @log 5
// @log 3
// @log 2
// @log 0
// @log 9
// @log 9
// @log 6
// @log 4
// @log 2
// @hint redundant type annotation: `nodes` is inferred as `{count: i32, symbol: i32}[]`
// @hint redundant type annotation: `rows` is inferred as `i32[][]`
// `std:array.filled` at a REFERENCE element and at a LIST element, in ONE module.
//
// `array.new` writes the same reference into every slot, so `filled(n, someStruct)`
// leaves all `n` slots pointing at ONE object: writing through slot 0 is visible from
// slot 1. That is the doc comment's "shared, not copied", and it is the difference
// between this constructor and a `push` loop that builds a fresh literal each time.
// `filled(n, 0).mapIndexed(f)` is the composition that undoes the sharing, and the
// bottom of this file runs it.
//
// Both elements are here on purpose: the two instantiations pin one generic body at two
// element reps, and the emitter used to build the second at the first one's heap types
// (D1605). Each block also carries an UN-ANNOTATED face, since an annotation pins the
// element's representation and can hide a defect in the inferred spelling.
import { filled, mapIndexed } from "std:array"

type Node = { count: i32, symbol: i32 }

const nodes: Node[] = filled(4, { count: 0, symbol: -1 })
print(nodes.length)
print(nodes[0].symbol)
print(nodes[3].symbol)

// One object, four slots.
nodes[0].symbol = 7
print(nodes[0].symbol)
print(nodes[3].symbol)

const anonNodes = filled(2, { count: 5, symbol: 6 })
print(anonNodes[1].count)

// `filled(3, [0, 0])` is three slots holding ONE two-element list, so `rows[0][1] = 9`
// is visible as `rows[2][1]`.
const rows: i32[][] = filled(3, [0, 0])
print(rows.length)
print(rows[0].length)
print(rows[2][1])

rows[0][1] = 9
print(rows[0][1])
print(rows[2][1])

const anonRows = filled(2, [4, 5, 6])
print(anonRows[1][2])

// The remedy: one fresh inner list per slot, so a write to row 0 stays in row 0.
const grid = filled(3, 0).mapIndexed((v: i32, i: i32) => { return [v, i] })
grid[0][1] = 4
print(grid[0][1])
print(grid[2][1])
