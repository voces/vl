// `std:utf16` — the lossy decode: one U+FFFD per lone surrogate or out-of-range value, and a
// well-formed pair still decodes. Total, so it never returns an error.
import { decodeUtf16Lossy, encodeUtf16 } from "std:utf16"

// A lone high, a lone low, then a real pair.
print(decodeUtf16Lossy([0x41, 0xD800, 0x42, 0xDE00, 0xD83D, 0xDE00]))
print(decodeUtf16Lossy([0x110000]))
print(decodeUtf16Lossy([]).length)

// The repaired string is well formed: re-encoding it gives back three units.
print(encodeUtf16(decodeUtf16Lossy([0xD800, 0x41, 0xDC00])).length)

// A high surrogate with nothing after it, and a negative value.
print(decodeUtf16Lossy([0x41, 0xD83D]))
print(decodeUtf16Lossy([-1, 0x41]))
