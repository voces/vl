// @run
// @log 11132230
// @log 1
// @log 3
// @hint redundant type annotation: `rows` is inferred as `{key: i32, seq: i32}[]`
// @hint redundant type annotation: `rows2` is inferred as `{key: i32, seq: i32}[]`
// @hint redundant type annotation: `needle` is inferred as `{key: i32, seq: i32}`
// @hint redundant type annotation: `rows3` is inferred as `{key: i32, seq: i32}[]`
// THE OTHER HALF OF THE AXIS, AND THE AXIS IS GONE — D703. This file was
// `error-array-struct-element.vl`, an `@emit-error` pinning
// `monomorphize: unsupported argument type for `self` in a call to `sorted`` over a
// MODULE-SCOPE struct-element list, beside `array-struct-element-function-scope.vl` which
// pinned the identical program inside a function as RUNNING. Its own header said what to do
// when the refusal lifted: "delete this file and add the struct case", and the axis it named
// — "a module-scope BINDING is refused, and so is the same binding read from inside a
// function; a function-local list and a call RESULT both run" — was never about the ELEMENT
// at all. It was `monoArgTyName`'s GLOBAL arm, which asked two rungs of the pin membership
// list where the local and param arms ask the whole of it, and which was switched off
// entirely inside a function. `generics/pin-global-binding-both-scopes.vl` is the compiler-
// side pin; this is what it buys a caller.
//
// The `: Row` / `: Row[]` annotations are LOAD-BEARING for the same reason the sibling states:
// they are what make the element a DECLARED struct rather than an inferred inline shape, so
// their hints are declared rather than silenced.
//
// The three legs mirror the function-scope file exactly, so the two read as one measurement:
// a STABLE sort (keys `1,1,2,3`, the two `key: 1` rows keeping their input order — the digits
// are `key*10 + seq` per row, concatenated), a STRUCTURAL `indexOf` (a fresh record, not the
// same reference), and `reverse`. Three exports, because "admitted" is a claim about the
// export set and not about `sorted`.
//
// THE INDEX-LIST IDIOM IS STILL THE RIGHT ANSWER FOR A LARGE TABLE and is still what
// `compiler/cli.vl` does twice; it is no longer a WORKAROUND for this shape, which is what
// the deleted paragraph made it.
import { indexOf, reverse, sorted } from "std:array"

type Row = { key: i32, seq: i32 }

function byKey(a: Row, b: Row) { return a.key < b.key }

const rows: Row[] = [
  { key: 3, seq: 0 },
  { key: 1, seq: 1 },
  { key: 2, seq: 2 },
  { key: 1, seq: 3 },
]
const rows2: Row[] = [{ key: 5, seq: 0 }, { key: 6, seq: 1 }]
const needle: Row = { key: 6, seq: 1 }
const rows3: Row[] = [{ key: 1, seq: 0 }, { key: 3, seq: 1 }]

const out = rows.sorted(byKey)
let acc = 0
let i = 0
while i < out.length {
  acc = acc * 100 + out[i].key * 10 + out[i].seq
  i = i + 1
}
print(acc)
print(rows2.indexOf(needle))
print(rows3.reverse()[0].key)
