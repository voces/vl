// @run
// @log 0
// @log 112
// @log 112
// @log 0
// @log 112
// @log 112
// @log 216
// @log 321
// `bufferPeak()` is the furthest `bufferMark()` has reached: a release lowers the
// mark and leaves the peak, and only a `Buf` ending past the old peak raises it.
// Sizes round up to 8, so a 5-byte `Buf` after a 100-byte one ends at 112.
import { Buffer, bufferMark, bufferPeak, bufferRelease } from "std:buffer"

const start = bufferMark()
print(bufferPeak() - start)
const m = bufferMark()
const a = Buffer(100)
const b = Buffer(5)
print(bufferMark() - start)
print(bufferPeak() - start)
bufferRelease(m)
print(bufferMark() - start)
print(bufferPeak() - start)
const c = Buffer(16)
print(bufferPeak() - start)
const d = Buffer(200)
print(bufferPeak() - start)
print(a.length + b.length + c.length + d.length)
