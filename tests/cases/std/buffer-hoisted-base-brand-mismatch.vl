// @check
// THE WIDTH BRAND ON A HOISTED BASE. `getF32At` takes an `F32Base`, not an `i32`,
// and `f32base` / `i32base` are the only public way to mint one.
//
// Without the brand this file's program COMPILES AND RUNS, reading four integer
// bytes back as a float with no diagnostic — the same silent reinterpretation the
// view section's header calls "measured, not feared" and spends fifteen lines
// justifying `new` on `F32View`/`I32View` to close. Handing the extent out as two
// bare i32s would have reopened it one function later, which is why the `*At` tier
// has its own branded handle rather than taking the raw `byteAddrF32` address.
//
// `byteAddrF32` deliberately still answers a plain `i32`: it exists for raw address
// arithmetic and host interop, and branding it makes `a + (i << 2)` a type error at
// every one of its uses. The brand belongs on the handle whose only job is to go
// back into a fenced accessor.
//
// Inverted control: `buffer-hoisted-accessors.vl` calls every accessor through its
// own width's minter and prints.
// @error argument 1: expected F32Base, got I32Base
// @error argument 1: expected F32Base, got i32
import { Buffer, f32view, getF32At, i32base, i32view } from "std:buffer"

const b = Buffer(64)
const iv = b.i32view(0, 4)
const fv = b.f32view(16, 4)

// CROSS-WIDTH: an i32 view's base into the f32 accessor.
print(getF32At(i32base(iv), iv.length, 0))

// LAUNDERED: the raw field read is an `i32` and does not satisfy the brand either,
// so the provenance the brand carries cannot be forged by reading `.base`.
print(getF32At(fv.base, fv.length, 0))
