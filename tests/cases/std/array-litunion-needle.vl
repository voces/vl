// @run
// @log 1
// @log 1
// @log true
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// GRADUATED from `xfail-miscompile-array-litunion-needle.vl`. A bare member LITERAL handed to
// a `std:array` export's `needle: T` over a literal-union array used to be `vl check` rc 0 and
// a module the engine refused (`type mismatch: expected i32, found (ref $type)`) — the one
// DISHONEST carve-out in `std/array.vl`'s ledger, and the only shape plain `vl check` missed.
//
// THE ROOT WAS THE PIN, and it was one rung down from where the filing put it. The pin a
// monomorphized instance takes for its parameter becomes that parameter's ANNOTATION, so it
// has to name the argument's TYPE; for a literal-union array it named the argument's REP.
// `nameIsI32Array` accepts a litunion `K[]`, so `monoArgTyName`'s `exprArray` catch-all spelled
// the receiver `i32[]`, `T` bound to plain `i32`, and the instance declared `needle` an i32
// while the caller pushed the string ref a bare `"b"` is at an ordinary expression position.
// Both channels now claim the shape — `monoAnnPinName`'s litunion-array arm for the ANNOTATION
// (the function-scoped spelling, where every rep classifier is post-mono blind) and the
// recorded-type arm in the cascade for module scope — because two channels that pin one call
// two ways is the same defect one pass earlier.
//
// THE SCOPE ROWS ARE NOT DECORATION. At module scope this was the silent miscompile above; the
// IDENTICAL call inside a function was a LOUD `monomorphize: expected an array argument for
// `self`` — the annotation channel declined `K[]`, so the cascade fell to the `"i32"`
// catch-all, which is not an array at all. That took the documented remedy down with it: at
// function scope even a BOUND needle failed, because the RECEIVER is what could not be pinned.
// One arm closed both, which is why both scopes are pinned here.
//
// THE ATOM REP IS THE TRIGGER, so the hazard scope was the COMPILED PROGRAM rather than the
// spelling: an inline `("a"|"b")[]` was fine until any same-layout alias existed ANYWHERE in
// the program, `std:fs`'s `FileKind` included. The `inlineSib` rows below hold that cell — an
// UNUSED alias with the same member set, which is exactly what used to arm it.
import { count, includes, indexOf, lastIndexOf } from "std:array"

type K = "a" | "b"

// ── MODULE SCOPE, all four exports that take a bare `needle: T` ──
const xs: K[] = ["a", "b"]
print(xs.indexOf("b"))
print(xs.lastIndexOf("b"))
print(xs.includes("b"))
print(xs.count("b"))

// ── FUNCTION SCOPE, the same receiver: the loud half ──
function inFn() {
  const ys: K[] = ["a", "b"]
  print(ys.indexOf("b"))
  // The documented remedy, which used to fail HERE for a different reason than the one it
  // was written for.
  const needle: K = "b"
  print(ys.indexOf(needle))
  0
}
inFn()

// ── the INLINE spelling with an unused same-layout alias present ──
// `Sib` is load-bearing: without it the inline spelling reps as a string at both ends and
// there is no seam to cross. It is never mentioned again on purpose.
type Sib = "a" | "b"

const zs: ("a" | "b")[] = ["a", "b"]
print(zs.indexOf("b"))

function inFnInline() {
  const ws: ("a" | "b")[] = ["a", "b"]
  print(ws.indexOf("b"))
  0
}
inFnInline()

// ── a HAND-WRITTEN generic, importing nothing: not a std bug ──
function findv<T>(self: T[], needle: T) {
  let i = 0
  while i < self.length {
    if self[i] == needle { return i }
    i = i + 1
  }
  return -1
}

print(findv(xs, "b"))
