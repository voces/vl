// @trap
// `getF32At` FENCES, and this is the case that makes the hoisted accessors worth
// having in std at all rather than as advice in a comment.
//
// The recipe `std:buffer` used to give for a hot loop was to hoist the base and
// the count and then run the BARE intrinsics — fast, and with no bounds check at
// all. Element 4 of a 4-element view is byte 16 past its base, which here is
// inside the `Buf` and inside the NEXT column, so the bare spelling would return
// 4242 and print it. The hoisted accessor traps instead, exactly as `v[4]` does.
//
// Inverted control: `buffer-hoisted-accessors.vl` prints through the same pair at
// in-range indices (a `@trap` case cannot carry asserted `@log` output).
import { Buffer, byteAddrF32, f32view, getF32At, storeI32 } from "std:buffer"

const b = Buffer(64)
b.storeI32(16, 4242) // what an unfenced `getF32At(base, n, 4)` would reach
const v = b.f32view(0, 4)
const base = v.byteAddrF32(0)
const n = v.length
print(getF32At(base, n, 4))
