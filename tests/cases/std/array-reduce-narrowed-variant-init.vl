// @run
// @log 8
// @log -1
// @log 8
// @log 9
// @log 6
// @log 3
// @log 8
// @log 8
// @log 8
// The `: Circle` on each member-struct seed is LOAD-BEARING (it is what makes the local a
// kind-8 variant cell rather than an inferred inline shape), so the hint is declared, not
// silenced by deleting the annotation.
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// `std:array`'s `reduce` with a NARROWED NULLABLE UNION ARM as `init` — the carve-out
// `std/array.vl`'s header used to state, run here so the tree notices if it comes back.
//
// `init: A` is the only generic NON-ARRAY parameter in this module, so it is the only place
// where an argument's own type reaches a type parameter without an element type in the way.
// Handed a `Circle | null` narrowed to `Circle`, where `Circle` is a member of a declared
// `Shape` and `bump` accumulates `Shape`, it used to be `vl check` rc 0 and a module the
// engine refuses (`type mismatch: expected (ref $type), found (ref null $type)`). Two roots
// had to close for this one call to work: the argument needed BOXING into the union rep
// (`silent-class-inventory` D24 — the narrow is type-level, so the value keeps its
// `(ref null $uVarHeap[vi])` niche), and the monomorphizer's pin had to be able to NAME the
// arm at all (D23 — it fell to the `"i32"` catch-all).
//
// A CROSS PRODUCT OVER THE ACCUMULATOR TYPE, not a diagonal. A grid with one instance cannot
// see an interaction between instances, and this module's ledger has been caught by exactly
// that twice; so the file instantiates `reduce` at FOUR accumulator types in one program —
// the union `Shape`, a NON-member struct `Other`, a scalar `i32`, and a `string` — and every
// one of them runs.
//
// THE FIFTH ACCUMULATOR TYPE IS NOW HERE, AND IT IS THE ONE THAT USED TO FAIL: a MEMBER
// STRUCT (`A = Circle`) beside the union one (`A = Shape`) in the same program was `vl check`
// rc 0 and an invalid module — `silent-class-inventory.md` D26, unfiled until the std review
// of this retirement looked for the cross cell. Either alone was fine; it was holding both.
//
// THE ROOT WAS NOT `reduce`, NOT THE MONOMORPHIZER AND NOT NULLABILITY. The un-annotated
// binding `const out = reduce(…)` asked `letIsVariant`, whose `letInitReboxesToVariant`
// guard compared the VARIANT table against the STRUCT table using ONE integer that belongs
// to the variant namespace (`structIndexOfExpr` hands back `fRetStructIdx`, the polymorphic
// companion slot, for a variant-returning call). Its `< sHeapIdx.length` bound is a BOUNDS
// check, not a namespace check, so it declined only while the struct table was EMPTY — which
// is every program whose object types are all union arms. One standalone struct anywhere in
// the module (or one anonymous inline-shape row, which a monomorphized closure annotation
// spelling the union structurally mints) put the variant index in bounds and the binding took
// the plain-struct row. The guard is retired; `letIsVariant`'s header carries the reasoning
// and the 2,254-file measurement.
//
// THREE CONSUMPTIONS, because only the BINDING was wrong: `return reduce(…).r` inline and a
// `: Circle`-returning helper both ran throughout, so a fix measured on the binding alone
// would not have noticed if it moved them.
import { reduce } from "std:array"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Other = { n: i32 }

function bump(acc: Shape, x: i32): Shape {
  if acc is Circle { return { r: acc.r + x } }
  return acc
}

function mkc(): Circle | null { return { r: 5 } }

// A = Shape, seeded from a narrowed `Circle | null` PARAMETER.
function foldFromParam(c: Circle | null) {
  if c is Circle {
    const out = reduce([1, 2], bump, c)
    if out is Circle { return out.r }
    return -2
  }
  return -1
}

// A = Shape, seeded from a narrowed LOCAL, and with `!= null` rather than `is` — the two
// narrowing constructs reach the argument boundary through different classifiers.
function foldFromLocal() {
  const c: Circle | null = { r: 5 }
  if c != null {
    const out = reduce([1, 2], bump, c)
    if out is Circle { return out.r }
    return -2
  }
  return -1
}

// A = Shape, seeded from a narrowed CALL RESULT, over a longer list so the value differs.
function foldFromCall() {
  const c = mkc()
  if c is Circle {
    const out = reduce([1, 3], bump, c)
    if out is Circle { return out.r }
    return -2
  }
  return -1
}

// A = Other — a struct that is NOT a member of `Shape`, in the same program as the union
// instances above. This is the cell that makes the file a cross product.
function mkOther(): Other { return { n: 3 } }

function bumpOther(acc: Other, x: i32): Other { return { n: acc.n + x } }

function foldOther() {
  const o = mkOther()
  return reduce([1, 2], bumpOther, o).n
}

// A = i32, the ordinary scalar accumulator, so the union instances are not the only ones in
// the module and the four instances really are four.
function addUp(acc: i32, x: i32) { return acc + x }

function foldI32() { return reduce([1, 2], addUp, 0) }

// A = Circle — the MEMBER STRUCT of `Shape`, in the same program as the union instances
// above. The cell D26 named, at all three consumptions of the result: an un-annotated
// BINDING (the one that failed), the INLINE `.r` read, and a `: Circle`-returning helper.
function bumpCircle(acc: Circle, x: i32): Circle { return { r: acc.r + x } }

function foldCircleBind() {
  const c: Circle = { r: 5 }
  const out = reduce([1, 2], bumpCircle, c)
  return out.r
}

function foldCircleInline() {
  const c: Circle = { r: 5 }
  return reduce([1, 2], bumpCircle, c).r
}

function foldCircleRet(): Circle {
  const c: Circle = { r: 5 }
  return reduce([1, 2], bumpCircle, c)
}

print(foldFromParam(mkc()))
print(foldFromParam(null))
print(foldFromLocal())
print(foldFromCall())
print(foldOther())
print(foldI32())
print(foldCircleBind())
print(foldCircleInline())
print(foldCircleRet().r)
