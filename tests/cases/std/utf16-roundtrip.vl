// @run
// @log 97 233 20013 98 55357 56832
// @log 6
// @log same
// @log 0
// @log 0
// @log 0
// @log 65533
// @log 1
// `std:utf16` — the encode/decode round trip over BMP and astral characters, and the empty
// string. A character past U+FFFF is a surrogate pair; `utf16Length` agrees with the encoder.
import { decodeUtf16, encodeUtf16, utf16Length } from "std:utf16"
import { join, toString } from "std:fmt"

function units(xs: i32[]) {
  const parts: string[] = []
  for x in xs { parts.push(toString(x)) }
  join(parts, " ")
}

// ASCII, Latin-1, CJK, ASCII, then U+1F600 as the pair D83D DE00.
const s = "a"
  + fromCodePoint(0xe9)
  + fromCodePoint(0x4e2d)
  + "b"
  + fromCodePoint(0x1F600)
const u = encodeUtf16(s)
print(units(u))
print(utf16Length(s))
const back = decodeUtf16(u)
if back is string {
  print(if back == s { "same" } else { "diff" })
} else {
  print(back.msg)
}

// The empty string, both ways.
print(encodeUtf16("").length)
print(utf16Length(""))
const e = decodeUtf16([])
if e is string { print(e.length) } else { print(e.msg) }

// A string sliced through a character encodes its bad byte as U+FFFD, as `for cp in s` reads it.
const cut = encodeUtf16("é".slice(0, 1))
print(units(cut))
print(cut.length)
