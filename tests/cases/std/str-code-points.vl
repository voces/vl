// @run
// @log 7
// @log 195
// @log 6
// @log 72 114 237 109 101 121
// @log true
// @log 0
// @log 97 128512 98
// @log 3
// @log true
// @log 65533 65533
// @log 2
// `std:str` `codePoints` (D3641, sunpa SP-029): the code points of a string, in order, where
// `s[i]` and `s.length` are its UTF-8 bytes. Invalid UTF-8 gives one U+FFFD per byte, the
// same decoder `for cp in s` and `cpLen` drive, so the three always agree.
import { codePoints } from "std:str"

function show(xs: i32[]) {
  let o = ""
  for x in xs {
    if o.length > 0 { o = o + " " }
    o = o + "\{x}"
  }
  o
}

const name = "Hrímey"
print(name.length) // 7 bytes
print(name[2])     // 195, the first byte of `í`
const cps = codePoints(name)
print(cps.length)
print(show(cps))
print(cps[2] == 'í')
print(codePoints("").length)
// A four-byte code point is one element.
print(show(codePoints("a😀b")))
// The list agrees with `for cp in s` and with `cpLen`, also on invalid UTF-8.
const cut = "é→".slice(1, 4) // a continuation byte, then two bytes of a three-byte sequence
let n = 0
for cp in cut { n = n + 1 }
print(n)
print(codePoints(cut).length == cut.cpLen())
print(show(codePoints("→".slice(0, 2))))
// A fresh list: changing it leaves the next call's answer alone.
const mine = codePoints("ab")
mine.push(99)
print(codePoints("ab").length)
