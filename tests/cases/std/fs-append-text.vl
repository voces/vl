// @run
// @skip the fs floor needs a host that can build a WasmGC value — V8 cannot; asserted natively by tests/selfhost_native_align_test.ts
// @log line one
// @log line one
// @log line two
// @log 17
// @log line one
// @log line two
// @log héllo → 世界 🎉
// @log 40
// @log fresh
// @log 5
// @log created
// @log 44
// @log fs.appendFile /tmp/vl-std-fs-append-text-absent/x.txt: ENOENT (no such file or directory)
// @log 31
// @log 28
// @log fs.appendTextFile: the path is empty
// `appendTextFile` after `writeTextFile`, with multibyte UTF-8, and on its error path.
//
// Every step reads the file back whole, so an append that replaced, an encoding that
// dropped a byte, or a create that did not happen changes a printed line. The file is at
// a FIXED path under `/tmp` and the run starts with `writeTextFile`, so a rerun prints the
// same lines; the missing-directory case names a directory that is never created.
import {
  IoError,
  appendTextFile,
  readFile,
  readTextFile,
  writeTextFile,
} from "std:fs"

const p = "/tmp/vl-std-fs-append-text.txt"
const created = "/tmp/vl-std-fs-append-text-created.txt"

function show(path: string) {
  const t = readTextFile(path)
  if t is IoError { print("read failed: " + t.msg) } else { print(t) }
}

function size(path: string) {
  const b = readFile(path)
  if b is IoError { print("read failed: " + b.msg) } else { print(b.length) }
}

function must(e: IoError | null) {
  if e != null { print("unexpected: " + e.msg) }
}

// Append after a write keeps what the write put there.
must(writeTextFile(p, "line one"))
show(p)
must(appendTextFile(p, "\nline two"))
show(p)
size(p)

// Multibyte text is encoded whole: thirteen characters, 23 bytes, so the file grows by 23.
must(appendTextFile(p, "\nhéllo → 世界 🎉"))
show(p)
size(p)

// `writeTextFile(path, "")` is the fresh start the comment names.
must(writeTextFile(p, ""))
must(appendTextFile(p, "fresh"))
show(p)
size(p)

// A missing file is created, as `appendFile` does. The first line resets it for a rerun.
must(writeTextFile(created, ""))
must(appendTextFile(created, "created"))
show(created)

// The error path: a missing directory, a directory, and an empty path.
const e1 = appendTextFile("/tmp/vl-std-fs-append-text-absent/x.txt", "x")
if e1 is IoError {
  print(e1.code)
  print(e1.msg)
} else {
  print("should have failed")
}
const e2 = appendTextFile("/tmp", "x")
if e2 is IoError { print(e2.code) } else { print("should have failed") }
const e3 = appendTextFile("", "x")
if e3 is IoError {
  print(e3.code)
  print(e3.msg)
} else {
  print("should have failed")
}
