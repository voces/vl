// @run
// @log a,b,c,d
// @log 4
// @log x,y
// @log 7
// @log 7
// @log 7
// @log 0
// diderven DV-501 / DV-1101 — `insert` shifts the tail one place and may append at
// `length`; `fill` overwrites every slot in place and keeps the length.
import { fill, insert } from "std:array"
import { join } from "std:str"

const xs = ["b", "d"]
xs.insert(0, "a")
xs.insert(2, "c")
print(xs.join(","))
print(xs.length)
const ys: string[] = []
ys.insert(0, "y")
ys.insert(0, "x")
print(ys.join(","))
const ns = [1, 2, 3]
ns.fill(7)
for n in ns { print(n) }
const empty: i32[] = []
empty.fill(1)
print(empty.length)
