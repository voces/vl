// @trap
// A WRITE past the end traps on the same policy as a read, and this is the half
// that matters most: an unchecked out-of-range read yields a wrong answer, an
// unchecked out-of-range WRITE CORRUPTS THE NEIGHBOUR — and under a snapshot /
// rollback / hash discipline that damage is discovered arbitrarily far from its
// cause.
//
// Inverted control: `buffer-view-bounds-control.vl` (a `@trap` case cannot carry
// asserted `@log` output — see that file's header).
import { Buffer, f32view, setF32 } from "std:buffer"

const b = Buffer(64)
const x = b.f32view(0, 4)
x.setF32(3, 1.0) // in range
x.setF32(4, 5.0) // one past the end — byte 16, inside the Buf
print("unreachable marker")
