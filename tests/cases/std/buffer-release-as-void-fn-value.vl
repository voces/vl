// @run
// @log 1024
// @log 1
// D14790: `bufferRelease`'s shared-memory arm, with its bare returns, is folded away in a
// default build, so its tail write read as a value and its function took an `i32` result
// while its type is `(mark: i32) => void`. Called through a value of that type, it trapped.
import { bufferMark, bufferRelease } from "std:buffer"

function run(g: (mark: i32) => void, m: i32) { g(m) }
const m = bufferMark()
print(m)
run(bufferRelease, m)
print(1)
