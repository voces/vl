// @trap
// A COPY THAT RUNS OFF THE END IS A LOUD REFUSAL, NOT SILENT CORRUPTION.
//
// The bytes past `self.length` are still inside the module's memory, so nothing
// below `storeBytes` would object: the write would land in whatever `Buf` was
// allocated next and be discovered arbitrarily far away. `storeBytes` compares
// the range once, before the loop, and traps.
//
// The mapped trap REASON is shared with every `__trap__` site — all lower to
// `unreachable` — so only the trap itself is pinned here. The abort is preceded
// by a printed sentence naming the range, which
// `tests/vl_buffer_bytes_trap_message_test.ts` pins.
import { Buffer, storeBytes } from "std:buffer"

const src: u8[] = []
for i in 0 to 4 { src.push(i) }

// Room for four bytes at offset 2, and five are offered.
const b = Buffer(6)
b.storeBytes(2, src)
print(b.length)
