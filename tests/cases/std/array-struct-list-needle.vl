// THE GRADUATION of `error-array-needle-not-equatable.vl`'s `Circle[]` and `F[]` rows
// (`silent-class-inventory` D751/D752), ALL FOUR `needle: T` EXPORTS, READ BACK BY VALUE.
//
// That file's own rule — stated there three times, because it has been broken twice — is that
// a row which stops being refused must MOVE to a runs fixture rather than be deleted, so the
// protection its directive carried does not evaporate. These are the two rows that stopped
// being refused.
//
// WHAT CHANGED IS THE COMPARE CORE, NOT THE PIN. `std:array`'s four `needle: T` exports each
// run `self[i] == needle` inside a generic body, and `validateBinCstrs` re-asks the
// comparability question at the CALL SITE under the substituted type — that machinery is D35's
// and is untouched. What it used to get back for a `Circle[]` needle was "no core exists", and
// now a core does: `emitListEqGCore` compares a struct-element list field-wise off two stashed
// element refs, and an `f64`-based literal union rides the f64 list's own opcode.
//
// THE ANSWERS ARE INDICES AND NOT `true`/`false` ALONE, which is this fixture's whole value
// over a check-only pin: `indexOf` returning 0 for a needle that IS at 0 and -1 for one that is
// absent separates a correct compare from one that answers TRUE for every pair. `lastIndexOf`
// over a two-element receiver whose entries are EQUAL pins the direction of the scan.
import { count, includes, indexOf, lastIndexOf } from "std:array"

type Circle = { r: i32 }
type F = 1.5 | 2.5

function mkc(r: i32) {
  const c: Circle = { r: r }
  return c
}

function stdIndexOf(): i32 {
  const n: Circle[] = [mkc(7)]
  const xs: Circle[][] = [n]
  return xs.indexOf(n)
}

// TWO EQUAL ENTRIES, so a `lastIndexOf` that scanned forwards would answer 0 and this row
// would catch it.
function stdLastIndexOf(): i32 {
  const n: Circle[] = [mkc(7)]
  const xs: Circle[][] = [n]
  return xs.lastIndexOf(n)
}

function stdIncludes(): boolean {
  const n: Circle[] = [mkc(7)]
  const xs: Circle[][] = [n]
  return xs.includes(n)
}

function stdCount(): i32 {
  const n: Circle[] = [mkc(7)]
  const xs: Circle[][] = [n]
  return xs.count(n)
}

function stdF64UnionList(): i32 {
  const n: F[] = [1.5]
  const xs: F[][] = [n]
  return xs.indexOf(n)
}

// THE ABSENT NEEDLE, which is the half a compare that always answers TRUE would pass without.
function stdAbsent(): i32 {
  const n: Circle[] = [mkc(7)]
  const other: Circle[] = [mkc(8)]
  const xs: Circle[][] = [other]
  return xs.indexOf(n)
}

// STRUCTURAL EQUALITY, NOT REFERENCE IDENTITY: the needle is a separately BUILT list holding
// separately built structs, so a compare that had reached for `ref.eq` would answer -1 here.
function stdSeparatelyBuilt(): i32 {
  const xs: Circle[][] = [[mkc(7)]]
  const n: Circle[] = [mkc(7)]
  return xs.indexOf(n)
}

print(stdIndexOf())
print(stdLastIndexOf())
print(stdIncludes())
print(stdCount())
print(stdF64UnionList())
print(stdAbsent())
print(stdSeparatelyBuilt())
