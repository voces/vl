// @error-at 4:9 Duplicate binding "d"
// A union first parameter overlaps every head class, so `d(self: Shape)` cannot share a name
// with `d(self: Circle)`: narrowing a `Shape` to `Circle` would otherwise switch the callee.
import { Circle, Shape, d } from "./sh"
import { d } from "./ci"

const c: Circle = { r: 1 }
print(c.d())
