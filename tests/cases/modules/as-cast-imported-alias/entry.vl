// @run
// @log 6
// D-PARSETY P3: an IMPORTED alias as an `as` cast target. The import binds the
// local name to the exporter's mangled `Id$mN`; the cast spelling kept the bare
// `Id`, so the checker rejected it with ``unknown type `Id` in `as` cast``.
import { Id, five } from "./lib"

const y = five() as Id
print(y + 1)
