// A top-level TYPE named `v`, and — in the same module — a union MEMBER that is
// an inline object with a FIELD named `v`. `UnionDecl.udVariants` is a
// `string[]`, so the merge rewrote each member with `modTypeRenamed`, an
// identifier-segment scanner that cannot tell a type reference from a field
// name: `{v:i32}` became `{v$m1:i32}`, a member no literal can build.
export type v = i32

export type Q = { q: string }

export type AB = Q | { v: i32 }

export function mk(): AB {
  const a: AB = { v: 7 }
  a
}

export function tell(a: AB): i32 {
  if a is Q { return 1 }
  2
}
