// @run
// @log 2
// D-PARSETY P2: a `UnionDecl`'s MEMBER spellings are recorded by the parser and
// the module merge renames the TREE (`udTsRootAt` + `modRwTsName`), so a
// `TS_FIELD`'s text — a field name — is never a rename candidate.
//
// On the string scanner this failed with `cannot assign {v: i32} to 'a' of type
// {q: string} | {v: i32}`: two types that RENDER the same, because the
// diagnostic demangler strips the `$m1` the FIELD name had grown.
//
// This member comes from `parseVariantName` (the `type N = A | B` path).
import { mk, tell } from "./lib"

print(tell(mk()))
