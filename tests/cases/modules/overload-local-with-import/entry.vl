// @run
// @log A
// @log D
// @log E
// A local set and an imported set under one name merge into one; heads stay pairwise disjoint.
import { A, tag } from "./shapes"

type D = { d: boolean }
type E = { e: boolean }
function tag(self: D): string { return "D" }
function tag(self: E): string { return "E" }

const a: A = { x: 1 }
const d: D = { d: true }
const e: E = { e: false }
print(a.tag())
print(d.tag())
print(e.tag())
