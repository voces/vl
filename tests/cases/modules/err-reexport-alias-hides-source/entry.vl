// @error "square" is not exported by "./mid"
// `export { square as sq } from "./home"` publishes `sq` and ONLY `sq`. The
// pre-alias name is not part of `mid`'s surface, so importing `square` from `mid`
// is an error even though `mid` is what pulls `square` in.
//
// The re-export's public name is the `as` alias, which is also the local binding it
// creates — one notion of "public name", the same one the emitter's export section
// already used. Without this pin, widening the lookup to the SOURCE names would
// silently make both spellings work.
import { square } from "./mid"

print(square(5))
