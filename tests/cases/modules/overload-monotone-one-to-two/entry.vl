// Adding a disjoint candidate never moves a call (the step from one candidate to two).
// A wider record no head names still reaches the one candidate that accepts it, and a local
// binding named like the method (a parameter `d`) is no candidate, with one `d` or two.
import { A, d } from "./wr"
import { d } from "./s"
import { d } from "./a"
import { wider } from "./one"
import { shadowedList } from "./onelist"

const c = { x: 1, y: 2 }
print(c.d())
print(wider())
function g(d: i32): string { [1, 2].d() }
print(g(3))
print(shadowedList(3))
