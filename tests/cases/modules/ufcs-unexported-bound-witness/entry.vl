// @error does not satisfy
// D1191's second reader. A generic BOUND asks `witnessOf` whether the
// instantiation type carries the member, and that question is asked away from any
// call site — so it read the merge's plain-name map and answered with `./lib`'s
// un-exported `tag`. The bound was satisfied by a function this file cannot name,
// and the program ran. It now resolves in the PIN's module scope, which is what
// the refusal already claimed: "a `tag(self: Box, …)` function in scope at this
// call".
import { mk } from "./lib"

function show<T: { tag(): string }>(x: T): string { return x.tag() }

print(show(mk(3)))
