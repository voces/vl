// @run
// @log class pointer proc other
// @log 3 1
// @log inner outer
// IMPORTED constants as match arms (D3271), one under its own name and one renamed: the import
// binds each local to the exporter's merged name, and the arm resolves through it as a value
// reference would. A local constant shadowing a module one keeps its own value in a merged
// program too — the arm is the binding the name reaches where the `match` stands.
import { Kind, LF_CLASS, LF_POINTER as PTR, PROC, S_GPROC32 } from "./lib"

const OUTER = 7

function leaf(k: i32) {
  match k {
    LF_CLASS => "class"
    PTR => "pointer"
    S_GPROC32 => "proc"
    _ => "other"
  }
}

function kind(k: Kind) {
  match k {
    PROC => 3
    _ => 1
  }
}

function shadow(k: i32) {
  const OUTER = 5
  match k {
    OUTER => "inner"
    _ => "outer"
  }
}

print("\{leaf(0x1504)} \{leaf(0x1002)} \{leaf(0x1110)} \{leaf(0)}")
print("\{kind("proc")} \{kind("class")}")
print("\{shadow(5)} \{shadow(7)}")
