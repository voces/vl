// A cast target that is a module-local alias, and one reached through a CHAIN
// (`Count` → `Base` → i32). `modRwExpr`'s `AsExpr` arm rewrote only the operand,
// so the target kept its pre-merge spelling while the declaration became
// `Base$m1` / `Count$m1`.
type Base = i32
type Count = Base

export function mk(): i32 {
  const x = 5 as Count
  x + 1
}
