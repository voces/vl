// @run
// @log 6
// @log 3
// D-PARSETY P3: the target of an `x as T` cast is the FOURTH type spelling the
// parser used to drop. The merge renames a type DECLARATION to `Name$mN` but
// left the cast target spelling alone, so every module program casting to a
// named alias failed with ``unknown type `Id` in `as` cast`` — the alias
// declared in this module, in another module, imported, or reached through a
// chain. The single-file control (`type Id = i32` + `x as Id`) has always run.
import { mk } from "./lib"

// A cast target declared in the ENTRY module is renamed too.
type Half = i32

print(mk())
print(7 as Half / 2)
