// @error-at 7:36 because the candidates return different types
// @error-at 8:27 because a candidate's return type depends on its receiver
// A receiver each call supplies is still refused where the candidates' returns disagree once the
// arguments bind them, or where a return type is bound by the receiver itself (D4034).
import { head, tag } from "./s"
import { head, tag } from "./a"

function d<R, T>(r: R, v: T): T[] { return r.tag(v) }
function h<R>(r: R): i32 { return r.head(1) }
print(d("a", 1).length)
print(h("a"))
