// @error-at 23:9 a {z: boolean, x: i32} cannot be delivered as W here
// @error-at 25:9 a {z: boolean, x: i32} cannot be delivered as W here
// @error-at 27:9 a {z: boolean, x: i32} cannot be delivered as W here
// D14760's soundness half: a fresh binding is built at the `self` a generic's overloaded pick
// takes only while nothing else reaches it. Here `./a`'s `poke` writes the widened field, and the
// generic hands the binding back out by return, inside a record, and in a closure, so each is
// refused.
import { W, poke } from "./a"
import { V, poke } from "./b"

function g1<T>(v: T): T {
  v.poke()
  v
}
function g2<T>(v: T): { r: T } {
  v.poke()
  { r: v }
}
function g3<T>(v: T): () => T {
  v.poke()
  () => v
}
const j1 = { z: true, x: 3 }
print(g1(j1).x + 1)
const j2 = { z: true, x: 3 }
print(g2(j2).r.x + 1)
const j3 = { z: true, x: 3 }
print(g3(j3)().x + 1)
