// @check
// @error-at 12:11 'area' is not imported
// The twin of `ufcs-type-bound-no-reroute-structural`: "./lib"'s `V` has no `y`, so the local
// `area(self: Rect)` cannot take it, and the call is refused rather than handed to "./lib"'s
// exported `area`. A structural receiver never steps past the caller's own function (D1984),
// so adding `y` to `V` turns this into the local call, never into a different one.
import { V, mk } from "./lib"

type Rect = { x: i32, y: i32 }

function area(self: Rect): i32 { return self.x * self.y }

print(mk().area())
