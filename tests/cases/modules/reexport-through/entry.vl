// @run
// @log 42
// The ENTRY re-exports a name its dependency itself only RE-EXPORTS. That drives a
// second consumer of the chain walk: the emitter's re-export alias table, which
// aliases the bare public name onto the merged (mangled) target in the wasm export
// section. Resolving only one hop would alias `homeFn` onto `homeFn$mMID` — a
// function no module declares — so the module would fail wasm validation on its own
// export section rather than at any call site.
export { homeFn } from "./mid"

print(homeFn(41))
