// HOP 2 — republishes what HOP 1 republished (never declared here or there) and calls
// it too (`compiler/emit_base.vl`). The name the entry binds has to chase two republishing
// links to reach `leaf`'s declaration.
export { nameElem, nameEndsArr } from "./mid"

export function upperLeafName(name: string) {
  let cur = name
  while nameEndsArr(cur) { cur = nameElem(cur) }
  cur
}
