// @run
// @log true
// @log i32
// @log 2
// @log i32
// @log 1
// TWO CONSECUTIVE republishing hops, each of which also CALLS what it republishes.
//
// `reexport-chain` pins a three-link chase where the middle links only forward, and
// `reexport-alongside-import` pins ONE module that republishes what it also calls. The
// compiler now does BOTH AT ONCE, twice in a row: `tyname` declares the type-name
// grammars, `typecheck` republishes them and calls them, `emit_base` republishes what
// `typecheck` republished — a name it never sees declared — and calls them, and
// `emit_classify` imports from there. Neither existing case has two calling hops
// stacked, and a resolver that chases one link and stops would rewrite the entry's call
// onto a `nameEndsArr$mUPPER` that no module defines.
//
// The entry also reaches PAST the top hop for `midDepth`, the way `emit_classify`
// imports some names from `emit_base` and others from `typecheck` directly.
import { nameElem, nameEndsArr, upperLeafName } from "./upper"
import { midDepth } from "./mid"

print(nameEndsArr("i32[]"))
print(nameElem("i32[]"))
print(midDepth("i32[][]"))
print(upperLeafName("i32[][]"))
print(midDepth("{[string]:i32}[]"))
