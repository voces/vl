// The LEAF: pure character grammar over a type-name string, ZERO imports. This is the
// shape `compiler/tyname.vl` has — nothing here can observe the program being compiled,
// which is what lets it sit below every other module without risking a cycle.
export function nameEndsArr(name: string) {
  const n = name.length
  if n < 2 { return false }
  name[n - 2] == '[' && name[n - 1] == ']'
}
export function nameElem(name: string) {
  if !nameEndsArr(name) { return "" }
  const e = name.slice(0, name.length - 2)
  e
}
