// @run
// @log RA
// @log RB
// @log 2
// @log RB
// The un-annotated twin of `overload-generic-through-lambda`: each lambda's parameter takes its
// type from the call it is handed to, and the generic it calls picks by that receiver (D3820).
// `A` and `B` are records of two shapes, so each has its own `d`.
import { A, d } from "./r1"
import { B, d } from "./r2"

function h<T>(x: T): string { x.d() }
function k(x) { x.d() == "RA" }
function ap<T>(f: (x: T) => string, v: T): string { f(v) }
const a: A = { x: 1 }
const b: B = { y: 2 }
print([a].map((x) => h(x))[0])
print([b].map((x) => h(x))[0])
print([a, a].filter((x) => k(x)).length)
print(ap((x) => h(x), b))
