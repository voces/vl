// A body-scoped `type` in an IMPORTED module, sharing its source name with the module's own
// exported `type U`: the block's declaration is minted apart, and the merge renames both.
export function lib(): i32 {
  type U = { ty: i32 }
  const u: U = { ty: 40 }
  u.ty + 1
}

export type U = { other: i32 }
