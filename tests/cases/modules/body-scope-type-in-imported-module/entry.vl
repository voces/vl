// @run
// @log 41
// @log 5
// @log b
// D3022 — a body-scoped `type` survives the module merge in either module: in the imported
// one beside a same-named export, and in the entry inside a generic that captures `T`.
import { U, lib } from "./lib"

const x: U = { other: 5 }
print(lib())
print(x.other)

function gen<T>(v: T): T {
  type B = { v: T }
  const b: B = { v: v }
  b.v
}
print(gen("b"))
