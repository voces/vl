// @run
// @log 10
// @log 9
// @log 6
// D1120's three-module chain: `a`, `b` and `c` each export a free `self`-function
// called `area`, and every one is reached on its own receiver. A flat name-keyed
// registry has one answer for three questions; a per-call-site one has three.
import { area, box } from "./a"
import { nine } from "./use_b"
import { six } from "./use_c"

print(box(5).area())
print(nine())
print(six())
