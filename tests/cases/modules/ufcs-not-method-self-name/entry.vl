// @error-at 12:10 'skipTags' is not a method — its first parameter is named `c`, not `self`, and a UFCS call `x.skipTags(…)` dispatches only to a `self` first parameter; rename it to `self`, or call `skipTags(…)` directly
// D1654 — the sentence survives a merge. D1570's gate asks `fnDeclIx` for the declaration,
// a merge renames every one of them, and the caller's alias maps back only a `self`-function
// — precisely what this gate refuses on — so the whole sentence and its quick-fix payload
// went missing for any file that imported anything, leaving `no field 'skipTags' on Cursor`.
// The import is the only ingredient: drop it and the same four lines say this already.
import { bump } from "./dep"

type Cursor = { pos: i32 }
function skipTags(c: Cursor): i32 { return c.pos + bump(1) }
const cur: Cursor = { pos: 3 }
print(cur.skipTags())
