// @run
// @log 99
// @log 99
// @log true
// @log 7

// A-OPMOD — a user-defined binary operator dispatched only in a SINGLE-FILE program. A merge
// renames every declaration, so the declaration's key is `+$mN` while an operator SITE is
// `a + b` and carries no name to rewrite: the checker's `lookup("+")` and the emitter's
// `fnIndexOf("+")` both asked the unmangled name and missed. Both import spellings are here
// on purpose — the roadmap only ever demonstrated the LOCAL one, and `std:` reaches nearly
// every real program.
import { mk } from "./util"
import { toString } from "std:fmt"

type V = { x: i32 }

// The arithmetic operator the row was filed on.
function "+"(self: V, other: V): i32 { return self.x + other.x + 96 }

// A comparison, whose dispatch is the same lookup on a different name.
function "<"(self: V, other: V): boolean { return self.x < other.x }

function useAdd(a: V, b: V): i32 { return a + b }

function useLt(a: V, b: V): boolean { return a < b }

const p: V = { x: 1 }
const q: V = { x: 2 }

// The operator at a call inside a function, which is the roadmap's own witness.
print(useAdd(p, q))

// And at a bare module-scope site, printed through `std:fmt` so that import is load-bearing.
print(toString(p + q))

print(useLt(p, q))

// The local import stays used, so neither spelling is scenery.
print(mk())
