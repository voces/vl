// @run
// @log 44
// @log 105032704
// D3246: a use in the program never re-types a std constant: `ENOENT` stays `i32` for `std:fs`
// and here, so its product wraps at 32 bits as it does in every other program.
import { ENOENT } from "std:fs"

function take64(x: i64) { print(x) }
take64(ENOENT)
function scaled(by: i32) { ENOENT * by }
print(scaled(100000000))
