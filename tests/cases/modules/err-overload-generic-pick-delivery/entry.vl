// @error-at 11:6 {y: i32, x: i32} is not V: they store field `x` differently
// @error-at 12:6 {z: boolean, x: i32} is not W: they store field `x` differently
// D14756: an overloaded method call in a generic body delivers the receiver to the `self` its
// instance picks, and is refused as a lone candidate's is: `g(i)` picks `./b`'s `poke` and
// `g(j)` picks `./a`'s, and neither literal is stored the way its pick's `self` stores `x`.
import { W, poke } from "./a"
import { V, poke } from "./b"

function g<T>(v: T): i32 { v.poke() }
const i = { y: 2, x: 9 }
const j = { z: true, x: 3 }
print(g(i))
print(g(j))
print(i.x + j.x)
