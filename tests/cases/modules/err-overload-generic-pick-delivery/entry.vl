// @error-at 10:8 a {z: boolean, x: i32} cannot be delivered as W here
// @error-at 12:6 {y: i32, x: i32} is not V: they store field `x` differently
// D14756: an overloaded method call in a generic body delivers the receiver to the `self` its
// instance picks, and is refused as a lone candidate's is: `g(j)` picks `./a`'s `poke`, which
// writes the widened field; `g(a)` picks `./b`'s, but `a` is a shared record stored narrower.
import { W, poke } from "./a"
import { V, poke } from "./b"

function g<T>(v: T): i32 { v.poke() }
const j = { z: true, x: 3 }
print(g(j))
const a: { y: i32, x: i32 } = { y: 2, x: 9 }
print(g(a))
print(j.x + a.x)
