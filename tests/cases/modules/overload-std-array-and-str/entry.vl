// @run
// @log 1
// @log 1
// @log 3
// @log 3
// @log true
// @log false
// std:array's `lastIndexOf` and std:str's coexist when both modules are imported, and each
// receiver reaches its own; std:array's `indexOf` and `includes` sit beside the built-in
// string methods of the same names.
import { includes, indexOf, lastIndexOf } from "std:array"
import { lastIndexOf } from "std:str"

const xs = [1, 2, 3, 2]
const s = "abcb"
print(xs.indexOf(2))
print(s.indexOf("b"))
print(xs.lastIndexOf(2))
print(s.lastIndexOf("b"))
print(xs.includes(3))
print(s.includes("z"))
