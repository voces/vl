// @run
// @log 5
// @log 3
// @log 1
// A getter in an imported module calls the scalar intrinsics `sqrt` and `min` (D2064). The
// entry's own `function min` is the entry's: it neither reaches the library's getter body nor
// makes the library's `min` a user call.
import { pt } from "./lib"

function min(a: i32, b: i32): i32 { return a - b }

const p = pt(3.0, 4.0)
print(p.len)
print(p.lo)
print(min(3, 2))
