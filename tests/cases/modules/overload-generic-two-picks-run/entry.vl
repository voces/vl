// D14756's running half: two instances of one generic body pick different overloaded `poke`s,
// each receiver already stored as its pick's `self`, and each runs its own pick.
import { W, poke } from "./a"
import { V, poke } from "./b"

function g<T>(v: T): i32 { v.poke() }
const v: V = { y: 2, x: 9 }
const w: W = { z: true, x: 3 }
print(g(v))
print(g(w))
print(w.x is string)
