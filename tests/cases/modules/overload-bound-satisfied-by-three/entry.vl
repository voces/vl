// @run
// @log 2
// @log q
// @log 0.5
// A three-candidate set: every instance type's own candidate satisfies the bound, the middle
// and last import included.
import { A, mn } from "./a"
import { B, mn } from "./b"
import { C, mn } from "./c"

function lo<T: { mn(T): T }>(x: T, y: T): T { return x.mn(y) }

const a1: A = { v: 3 }
const a2: A = { v: 2 }
const b1: B = { s: "xyz" }
const b2: B = { s: "q" }
const c1: C = { n: 0.5 }
const c2: C = { n: 1.5 }
print(lo(a1, a2).v)
print(lo(b1, b2).s)
print(lo(c1, c2).n)
