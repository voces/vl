// @error-at 6:18 unknown type 'Level' — `Level` is exported by "./world"; add it to the existing `import { … } from "./world"`
// diderven DV-007 — a type the program's own module exports names that module, as an
// undeclared value does, rather than "did you mean 'never'": a capitalised name is a user
// type's, and a builtin is offered for it only from the same initial letter.
import { mk } from "./world"

function depth(l: Level): i32 { return l.n }
print(depth(mk()))
