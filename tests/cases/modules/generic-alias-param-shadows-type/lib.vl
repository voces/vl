// A top-level type named `T` coexists with a generic ALIAS whose PARAMETER is
// also `T`. Unlike `generic-shadow` (a generic FUNCTION, whose parameters are
// carried out-of-name in `fnTyParams`), an alias's parameters are folded INTO the
// declared name, so the merge must read the shadow set off the NAME itself
// (`modGenParams`) before it rewrites the body.
export type T = { q: i32 }
export type Opt<T> = T | null

export function orZero(o: Opt<i32>): i32 {
  if o == null { return 0 }
  return o
}
