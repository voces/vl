// @run
// @log 41
// What this pins is WHICH `T` the merge sees in `Opt<T> = T | null`: with the type-parameter
// shadow the member `T` stays the PARAMETER, so `Opt<i32>` is `i32 | null` and `41` fits.
// Without it the segment rewriter renames `T` to the module's top-level `T`, `Opt<i32>` becomes
// `{ q: i32 } | null`, and the binding below refuses. The shadow set is cut from the declared name
// by `modGenParams`. This is the only corpus witness for that shadow.
import { Opt, orZero } from "./lib"

const o: Opt<i32> = 41
print(orZero(o))
