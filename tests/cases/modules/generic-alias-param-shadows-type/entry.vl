// @error unknown type 'T' in union 'Opt<T>'
// @error unknown type 'Opt<i32>'
// @error unknown type 'Opt<i32>'
// A generic alias to a UNION is not (yet) a supported instantiation, so this
// program does not compile either way. What it pins is WHICH `T` the merge sees:
// with the type-parameter shadow the member `T` stays the PARAMETER and is
// reported unresolved; without it the segment rewriter renames `T` to the
// module's top-level `T`, the member silently binds to `{ q: i32 }`, and this
// diagnostic disappears — a generic parameter quietly captured by a colliding
// type. The shadow set is cut from the declared name by `modGenParams`.
//
// This is the ONLY corpus witness for that shadow: measured, the whole 1,508-file
// corpus and the compiler's own 25k-line multi-module source are BLIND to it
// (`modGenParams` can be stubbed to return nothing and every one of them still
// compiles byte-identically), because a generic alias's parameters otherwise
// rename consistently on both sides of the declaration. If generic union aliases
// become supported, this fixture should be updated to expect success — loudly,
// which is the point of pinning it.
import { Opt, orZero } from "./lib"

const o: Opt<i32> = 41
print(orZero(o))
