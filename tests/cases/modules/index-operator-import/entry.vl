// @run
// @log 12
// @log 24
// @log 117
// @log 3
// Cross-module index operators (B14): the operators are declared in `./lib` and
// dispatch here with no import naming them.
//
// THE MANGLING AXIS. The module merge renames every top-level declaration
// (`f` → `f$m1`), and an index operator's minted name renames with it. The
// checker's operator registry is built from the MERGED program, so it already
// holds the renamed names and needs no plain→mangled alias of the kind UFCS
// member-calls require — a bracket names nothing, so there is nothing to alias.
//
// The entry ALSO declares its own operator, over its own local type: the
// registry spans modules, so a local declaration and an imported one coexist and
// are told apart by receiver exactly like two in one file.
import { Counter, Doubler, mkCounter, mkDoubler } from "./lib"

type Local = { n: i32 }

function "[]"(self: Local, i: i32): i32 {
  return self.n - i
}

const c = mkCounter(10)
print(c[2]) // 12 — the imported `"[]"` for Counter
const d = mkDoubler(10)
print(d[2]) // 24 — a DIFFERENT imported `"[]"`, same structure, other brand
c[3] = 104  // the imported `"[]="` prints 10 + 3 + 104
const l: Local = { n: 5 }
print(l[2]) // 3 — the entry's own operator
