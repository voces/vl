// A module that exports a type AND the index operators over it. The operators
// are never IMPORTED by name — an index operator has no name a use site could
// write, so the entry reaches them purely by writing a bracket on a value whose
// type this module declared.
export type Counter = new { start: i32 }

export function "[]"(self: Counter, i: i32): i32 {
  return self.start + i
}

export function "[]="(self: Counter, i: i32, v: i32) {
  print(self.start + i + v)
}

// A SECOND receiver in the same module: the two `"[]"` declarations coexist
// because the operator is keyed by (operator, receiver type).
export type Doubler = new { start: i32 }

export function "[]"(self: Doubler, i: i32): i32 {
  return (self.start + i) * 2
}

export function mkCounter(start: i32): Counter {
  return { start: start }
}

export function mkDoubler(start: i32): Doubler {
  return { start: start }
}
