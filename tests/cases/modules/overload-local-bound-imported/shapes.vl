export type A = { x: i32 }
export type B = { s: string }
export type C = { k: f64 }
export function tag(self: A): string { return "A" }
export function tag(self: B): string { return "B" }
export function tag(self: C): string { return "C" }
export function mn(self: A, o: A): A {
  if o.x < self.x { return o }
  return self
}
export function mn(self: B, o: B): B {
  if o.s.length < self.s.length { return o }
  return self
}
