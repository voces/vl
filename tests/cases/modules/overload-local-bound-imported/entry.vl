// @run
// @log 2
// @log q
// A structural bound is satisfied through an imported set a module declares itself.
import { A, B, mn } from "./shapes"

function lo<T: { mn(T): T }>(x: T, y: T): T { return x.mn(y) }

const a1: A = { x: 3 }
const a2: A = { x: 2 }
const b1: B = { s: "xyz" }
const b2: B = { s: "q" }
print(lo(a1, a2).x)
print(lo(b1, b2).s)
