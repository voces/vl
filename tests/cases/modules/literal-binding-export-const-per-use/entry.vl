// @run
// @log 7
// @log -1589934592
// D3246: an exported literal `const` is its literal at every read, in every module. Here it is an
// `f32` argument; in the library it is still an `i32` operand, so `show()` wraps at 32 bits as
// it does in a program that never imports it.
import { MUL, show } from "./lib"

function takeF32(x: f32) { print(x) }
takeF32(MUL)
show()
