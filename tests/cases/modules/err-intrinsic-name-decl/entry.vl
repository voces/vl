// @error '__memory_size__' is a compiler intrinsic and cannot be redefined
// @error '__trap__' is a compiler intrinsic and cannot be redefined
// D2263 — an intrinsic's name is reserved in every module of a program, as it is in a single
// file: a dependency's exported `function` and the entry's own `function`. Module mode renames
// each top-level declaration before the checker runs, so the reservation screens the spelling.
import { probe } from "./lib"

function __trap__(x: i32) { return x + 1 }

print(probe())
print(__trap__(4))
