// @run
// @log 319
// @log 4
// Lifted functions in three modules, nested two deep in `a`, in binding initialisers and in a
// top-level statement: lifting reaches `b`'s lambda before `a`'s inner one, so an armed link
// that lays each module's lifted functions out in a row places them differently.
import { fa, ka } from "./a"
import { gb, kb } from "./b"

const m = (v: i32): i32 => v * 7
print(fa(2) + gb(5) + ka(1) + kb(1) + m(1))
const sq = [1, 2].map((v: i32): i32 => v * v)
print(sq[1])
