// @error-at 5:9 `export { s }` names an imported binding; re-export it with `export { sinF64 as s } from "std:math"`
// D3559: the suggested re-export names the SOURCE export and keeps the local alias as
// the public name, so it binds exactly what the import did. An empty specifier must
// appear in no diagnostic.
import { sinF64 as s } from "std:math"
export { s }
print(s(0.0))
