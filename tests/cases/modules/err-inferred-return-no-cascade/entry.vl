// @error undeclared identifier 'nope'
// An unresolved name inside an un-annotated function poisons its return type, and every
// caller that infers from it, in this module and the importer: none of them is reported
// again as "cannot infer a return type", and a `match` over the poisoned value is quiet (D3771).
import { height } from "./terrain"

function above(x: f64) { return height(x) + 1.0 }
function twice(x: f64) { return above(x) * 2.0 }
function side(x: f64) {
  const s = height(x)
  return match s {
    "a" => 1
    "b" => 2
  }
}

const xs = [1.0, 2.0].map((x) => height(x))
print(twice(1.0))
print(side(1.0))
print(xs.length)
