// The module whose exports take BUILTIN TYPE NAMES (D1571 / glean VL-015). Every one of
// these is a legal VALUE binding: VL keeps the value and type namespaces apart, and this
// file's own annotations prove it — `u8[]` below is the primitive array, in the same module
// that exports a `u8`.
type Cursor = { pos: i32 }

export function mk(p: i32): Cursor { return { pos: p } }

// A `self`-function named like the storage type. Callable as `c.u8()` AND as `u8(c)`.
export function u8(self: Cursor): i32 { return self.pos + 1 }

export function cstring(self: Cursor): i32 {
  const bytes: u8[] = [1, 2, 3]
  return bytes.length + u8(self)
}

// The other primitive spellings, as plain functions and a module `const`.
export function string(n: i32): i32 { return n * 2 }

export const i32: i32 = 7
