// @run
// @log 8
// @log 5
// @log 3
// @log 10
// @log 2
// @log 14
// D1571 — AN EXPORT NAMED LIKE A BUILTIN TYPE DOES NOT HIDE THE TYPE.
//
// The merge's rename map is ONE namespace and the language is TWO. A `type Circle` and a
// `function Circle` coexist because both mint the same `Circle$mN` target; a BUILTIN name has
// no declaration and therefore no row of its own, so the VALUE row was the only one and
// `import { u8 }` rewrote every `u8[]` in this file to `u8$m1[]` —
// `unknown type 'u8' within 'u8[]'` on an annotation naming the primitive (glean VL-015).
//
// The rule the fix keeps: a builtin type name is renamed in TYPE position only by a `type`
// row. `modules/builtin-type-name-user-type/` is that control — an exported `type u8` still
// shadows, which is the behaviour this must not take away.
//
// EVERY LINE BELOW IS A DELIVERY POSITION for the same question: the imported value used as a
// VALUE, the shadowed name used as a TYPE (annotation, array element, map key), and the
// `self`-function called both ways.
import { cstring, i32, mk, string, u8 } from "./lib"

const c = mk(4)

// The exported `self`-function, both spellings, in a file that also spells `u8[]`.
print(c.cstring())
print(u8(c))

// The TYPE is still the primitive: an annotation, and a `u8[]` element read.
const raw: u8[] = [3, 9]
print(raw[0])

// `string` and `i32` are values here and types one line apart.
const s: string = "hi"
const n: i32 = 8
print(string(5))
print(s.length)

// A MAP KEY is a type-position segment too — the tree walk's `TS_MAP` arm.
const m: {[string]: i32} = Map()
m["a"] = n
print((m["a"] ?? 0) + i32 - 1)
