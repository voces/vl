// @run
// @log 4
// @log 6
// @log 1
// D2527: a written type argument on a call is an annotation in the CALLER's scope. The module
// merge renamed every other annotation to its mangled name and skipped these, so `mk<T>()`
// with `T` declared in this module read "unknown type 'T'", and an imported `Pt` the same.
// A primitive has no module name to take, and resolved before as it does now.
import { Pt, mk } from "./lib"

type T = { w: i32 }
const t = mk<T>()
t.push({ w: 4 })
print(t[0].w)

const p = mk<Pt>()
p.push({ x: 6 })
print(p[0].x)

const n = mk<i32>()
n.push(1)
print(n[0])
