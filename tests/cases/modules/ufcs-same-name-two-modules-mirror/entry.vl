// @run
// @log 10
// @log 9
// D1120's MIRROR orientation: the entry imports `b`'s `area` and the dependency uses
// `a`'s. Before the fix this was refused `no field 'area' on Sq` — the DEPENDENCY won
// in both orientations, which is what proved the defect was the registry's first-match
// read rather than the entry's own import order.
import { area, sq } from "./b"
import { ten } from "./use_a"

print(ten())
print(sq(3).area())
