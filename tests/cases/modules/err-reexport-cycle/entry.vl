// @error Import cycle detected through "./a"
// Two modules re-exporting from each other. The re-export chain walk that resolves a
// public name to its declaring module would spin forever on this, and it is bounded
// for that reason — but the bound is belt-and-braces: a re-export creates a real
// import edge, so the cycle is caught by the ordinary import-cycle check BEFORE any
// name resolution runs.
//
// The pin is the hang guard. If the cycle check is ever reordered after name
// resolution, this case stops erroring cleanly and starts hanging.
import { x } from "./a"

print(x(1))
