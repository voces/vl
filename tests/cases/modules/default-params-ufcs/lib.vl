// The MERGE-SIDE half of parameter defaults over UFCS (D1044).
//
// This module exists to be imported. Its only structural job is to carry a free
// `self`-function, because that is what populates the merge's UFCS alias
// registry (`modCollectSelfFns` → `ufcsAliasAdd`) and so puts the entry into the
// mode where the defect lived. `std:test` carries four such functions, which is
// why EVERY `*.test.vl` was in the failing mode.
export type Box = { v: i32 }

export function box(v: i32): Box { return { v: v } }

// An IMPORTED `self`-function with a defaulted tail: the entry omits `by` and
// the merge must still map the plain property `grow` back to `grow$mN`.
export function grow(self: Box, by: i32 = 4): i32 { return self.v * by }

// A `self`-function with NO default, so the fixture also holds the exact-arity
// row the widened match must leave alone.
export function twice(self: Box): i32 { return self.v * 2 }
