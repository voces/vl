// @run
// @log 15
// @log 10
// @log 10
// @log 15
// @log 20
// @log 10
// @log 14
// A UFCS CALL THAT OMITS A DEFAULTED TAIL ARGUMENT SURVIVES THE MODULE MERGE
// (D1044). `tests/cases/functions/default-params-ufcs.vl` pins the same arity
// range in a SINGLE-FILE build and cannot see this: the merge is what the
// single-file spelling does not run.
//
// The merge cannot rewrite a call's property string (a same-named struct field
// keeps precedence, decided by the receiver TYPE), so it records a plain→mangled
// alias for every member call whose property resolves to a free `self`-function.
// That resolution (`modSelfFnTarget`) matched the DECLARED parameter count
// EXACTLY, so a call omitting a defaulted tail matched no registry row, no alias
// was recorded, the plain name no longer named anything in the merged program,
// and the call fell through to `no field 'scale' on Box` — on a program whose
// single-file form printed `15`. The registry now carries the same arity RANGE
// its two consumers already enforced (`ufcsCallTy`, `drwSelfFnOf`).
//
// EVERY OMITTING CALL BELOW USES A FUNCTION NOTHING ELSE CALLS AT EXACT ARITY.
// That separation is load-bearing, not tidiness: the alias table is keyed by the
// PLAIN property name, so ONE exact-arity call site anywhere in the program
// registers the alias that then serves every omitting site of the same name.
// Writing `box(5).scale()` beside `box(5).scale(2)` therefore passes on the
// BROKEN compiler too, and would pin nothing. `scale`, `grow` and `locOf` are
// each called only with the tail omitted; `mul` carries the spellings that
// already worked.
import { Box, box, grow, twice } from "./lib"

// The ENTRY's own defaulted `self`-function — the filed witness. Its return is
// left UN-annotated on purpose: an annotation pins a rep, and a fixture that
// annotates every destination cannot see a defect whose ingredient is inference
// doing the pinning. `grow` in `lib.vl` carries the annotated spelling.
function scale(self: Box, by: i32 = 3) { return self.v * by }
print(box(5).scale())

// The three spellings that ALREADY ran, kept beside the one that did not so a
// future exact-arity match cannot pass: supplied positionally, supplied by NAME
// (`ufcsCallTy` has a separate arm for named arguments), and the direct call.
function mul(self: Box, by: i32 = 3) { return self.v * by }
print(box(5).mul(2))
print(box(5).mul(by: 2))
print(mul(box(5)))

// An IMPORTED defaulted `self`-function, omitted.
print(box(5).grow())

// An imported `self`-function with NO default still dispatches at exact arity —
// the row the widened match must leave alone.
print(box(5).twice())

// A `__callsite__` default over UFCS anchors on the METHOD token, not on the
// receiver and not on the call's open paren: `print(` is six characters, `box`
// starts at column 7, and `locOf` at column 14. The single-file spelling of this
// program prints 14 too — the merge must not move the anchor.
type Loc = { file: string, line: i32, col: i32 }
function locOf(self: Box, caller: Loc = __callsite__) {
  if self.v == 0 { return -1 }
  return caller.col
}
print(box(5).locOf())
