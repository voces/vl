// @error Duplicate binding "d"
// A function type's parameter names are documentation only, so `(p: i32) => i32` and
// `(q: i32) => i32` are one field type, `A` and `B` one shape, and a `self`-function on each is a
// duplicate binding (D3871).
import { A, d } from "./r1"
import { B, d } from "./r2"

const a: A = { f: (p: i32): i32 => p }
print(a.d())
