// @error Duplicate binding "Box"
// A GENERIC alias colliding with an import local: the parser folds the parameter
// into the declared name (`Box<T>`), so the duplicate-binding check only sees the
// collision after cutting the name at its `<` (`modGenBase`). Without that cut the
// declared name is the whole `Box<T>`, which matches no import local, and the merge
// silently rebinds every `Box` reference to the IMPORT — the exact orphaning
// `err-duplicate-binding` exists to prevent, one generic-name grammar later.
import { Box } from "./util"

type Box<T> = { v: T }

const b: Box<i32> = { v: 1 }
print(b.v)
