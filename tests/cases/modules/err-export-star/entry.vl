// @error expected an expression but found STAR
// VL has NO `export * from "path"` form, and the important part is that it is a
// HARD error rather than a silent no-op: the parser rejects the `*` wherever the
// module is parsed. (The driver's token-level `modScan` does skip past it without
// recording anything — but every path that skips it also parses the module, so the
// rejection always lands.)
//
// This pins the absence deliberately. `export { … } from` was the opposite case —
// accepted, recorded, and then invisible to the lookup — and that silent no-op is
// what this test's neighbours exist to prevent recurring.
import { g } from "./mid"

print(g(32))
