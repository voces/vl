// @error-at 4:18 Unsupported import specifier "fmt" — an import names a relative path ("./fmt") or a std module ("std:fmt"); a bare name has no meaning
// An import names a relative path or a std module, and nothing gives a bare name a meaning,
// so the refusal states that rule and offers both spellings the bare name could have meant.

import { x } from "fmt"

print(x())
