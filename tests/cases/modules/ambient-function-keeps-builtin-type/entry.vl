// @run
// @log 3
// @log 13
// D4066 — an imported value named `Map` or `Set` shadows the ambient function at a call, and
// `Map<…>` / `Set<…>` in type position still name the built-in types: only a `type` takes those.
import { Map, Set } from "./lib"
import { mkMap, mkSet } from "./make"

function count(m: Map<string, i32>, s: Set<i32>) { m.length + s.length }

print(count(mkMap(), mkSet()))
print(Map(5) + Set(1))
