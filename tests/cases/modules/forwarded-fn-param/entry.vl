// @run
// @log 4
// @log 4
// D17127 across modules: a function handed to an imported record builder through a local forward,
// and to an imported forward over that module's own builder.
import { mk } from "./lib"
import { fwd } from "./fwd"

function inc0(a) { return a + 1 }
function o1(f) { return mk(f) }
print(o1(inc0).f(3))
print(fwd(inc0).f(3))
