// @run
// @log 3
// @log -1589934592
// @log 7
// @log 3000000000
// D3246: an exported literal binding takes its type from its own module's uses only. The entry's
// `f64` and `i64` arguments leave `N` and `K` at `i32`, so the library's own arithmetic is
// unchanged; `total` takes `i64` from the library's store.
import { K, N, add, half, kbig, total } from "./lib"

function takeF64(x: f64) { x }
function take64(x: i64) { x }

takeF64(N)
half()
take64(K)
kbig()
print(K)
add(3000000000)
print(total)
