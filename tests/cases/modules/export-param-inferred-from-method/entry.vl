// @hint `x` inferred as string from `x.describe()`; annotate to freeze the export
// An exported function nothing in the program calls takes its untyped parameter's type from
// the one method its body calls on it: `describe` has a single candidate, whose receiver is a
// `string` (D3817).
import { describe } from "./s"

export function d(x) { x.describe() }
print(1)
