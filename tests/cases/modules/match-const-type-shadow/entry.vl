// @run
// @log 5
// @log 5
// @log 1 2
// @log 1 2
// @log circle other
// An IMPORTED type a local value shadows, in a merged program (D3271). Over a union of types the
// arm is still the type, whether the shadow is a constant or a parameter; over an integer the
// constant wins, as it does in one module. The merge renames the pattern as a type and banks
// the value spelling beside it, so each vocabulary reads the name it takes.
import { Circle, Square } from "./lib"

function byConst(x: Circle | Square): i32 {
  const Circle = 5
  print(Circle)
  return match x {
    Circle => 1
    _ => 2
  }
}

function byParam(x: Circle | Square, Square: i32): i32 {
  return match x {
    Square => 2 + Square - Square
    _ => 1
  }
}

function overInt(x: i32) {
  const Circle = 5
  match x {
    Circle => "circle"
    _ => "other"
  }
}

const c: Circle = { r: 1 }
const s: Square = { s: 1 }
const a = byConst(c)
const b = byConst(s)
print("\{a} \{b}")
print("\{byParam(c, 0)} \{byParam(s, 0)}")
print("\{overInt(5)} \{overInt(1)}")
