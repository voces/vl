// @error-at 12:16 nothing calls it
// @error-at 15:14 cannot be used as a function value
// @error-at 16:17 cannot be used as a function value
// @error-at 17:9 cannot be used as a function value
// @error-at 18:14 cannot be used as a function value
// A function whose body picks an overloaded candidate per call cannot be passed as a value:
// the instance a value makes has no call to pick for. Built-in `map` and `filter`, a user
// generic, and an un-annotated function each refuse.
import { A, d } from "./r1"
import { B, d } from "./r2"

function h<T>(x: T): string { x.d() }
function k(x) { x.d() == "RA" }
function ap<T>(f: (x: T) => string, v: T): string { f(v) }
const a: A = { x: 1 }
print([a].map(h)[0])
print([a].filter(k).length)
print(ap(h, a))
print([a].map(k)[0])
