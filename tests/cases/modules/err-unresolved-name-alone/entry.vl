// @error undeclared identifier 'groundHeight'
// A missing import is the only diagnostic (sunpa, lane DX). The record carrying the
// unresolved call is pushed into a typed list, which re-checks the program; that re-check
// used to report every `concat` call in every module as unbindable (D3770).
import { place, shapes } from "./place"
import { trimmed } from "./rows"

place(1.0, 2.0)
print(shapes().length)
print(trimmed([1, 2, 3], 1).length)
