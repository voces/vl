import { concat } from "std:array"
import { waterDepth } from "./terrain"

type Obstacle = { x: f64, y: f64, base: f64, wet: f64 }
let placed: Obstacle[] = []

export function place(x: f64, y: f64) {
  const o = { x, y, base: groundHeight(x, y), wet: waterDepth(x, y) }
  placed.push(o)
}

const ROCKS: f64[] = [1.0, 2.0]
const CLIFFS: f64[] = [3.0]
const SHAPES: f64[] = ROCKS.concat(CLIFFS).concat(ROCKS)

export function shapes(): f64[] { SHAPES }
