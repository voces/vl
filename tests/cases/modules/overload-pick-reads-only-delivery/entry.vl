// @run
// @log 1
// @log 10
// @log 0
// D14755: a record delivered by an overloaded method call is judged by the candidate the call
// picks. Only `V` accepts `{y, x}`, so `i.poke()` reaches `./b`'s `poke`, which writes nothing;
// `./a`'s `poke` writes a widened field but is reached only by a receiver it accepts.
import { W, poke } from "./a"
import { V, poke } from "./b"

const i = { y: 2, x: 9 }
print(i.poke())
print(i.x + 1)
const w: W = { z: true, x: 1 }
print(w.poke())
