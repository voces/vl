// @error "nope" is not exported by "./home"
// A re-export of a name the SOURCE module does not export is diagnosed at the
// RE-EXPORTING module, against `./home` — the module that made the false claim owns
// the error. The importer here says nothing: `mid` did claim to publish `nope`, so
// re-reporting the same problem once per importer would be noise.
//
// The single `@error` is the whole pin — this file is checked STRICTLY, so a second
// diagnostic (`"nope" is not exported by "./mid"`, which is what master emits
// alongside it) fails the case.
import { nope } from "./mid"

print(nope(41))
