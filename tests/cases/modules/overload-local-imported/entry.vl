// @run
// @log A
// @log B
// @log C
// One import of a name a module declares three times binds the whole set; each method call
// picks its receiver's candidate.
import { A, B, C, tag } from "./shapes"

const a: A = { x: 1 }
const b: B = { s: "q" }
const c: C = { k: 1.5 }
print(a.tag())
print(b.tag())
print(c.tag())
