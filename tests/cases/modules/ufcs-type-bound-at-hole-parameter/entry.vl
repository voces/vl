// @run
// @log 5
// @log 12
// @log 0
// @log 8
// @log 0
// @log 5
// A type-bound member call on an un-annotated parameter takes each argument's own `self`-function,
// as the `<T>` spelling does (D4033): the argument meets the call through its type's rung, not a
// demanded field (D16384). Each instance asks its own receiver's module, in either order.
import { mk } from "./circle"
import { mk2 } from "./square"
import { Buffer } from "std:buffer"

function grown(x) { return x.grow(3) }
print(grown(mk(2)))
print(grown(mk2(4)))
load(Buffer(8))
withField(Buffer(8))
print(later(mk(2)))

function load(b) { print(b.loadI32(0)) }
function withField(b) {
  print(b.length)
  print(b.loadI32(0))
}
function later(x) { return x.grow(3) }
