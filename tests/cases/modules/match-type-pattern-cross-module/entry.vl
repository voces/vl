// @run
// @log 12
// @log 9
// @log circle
// @log square
// A value-union `match` on BOTH sides of a module boundary: an imported `match`-bodied
// function, and a `match` in the entry whose arm patterns name IMPORTED types.
//
// The pattern is an `IsExpr`, so it renames through the same `modRwIsType` half of the merge's
// `is` arm — and only that half: walking the whole pattern would re-walk the shared SCRUTINEE
// node once per arm and rename it n+1 times over (`s` → `s$m0` → `s$m0$m0`).
import { area, Circle, Shape, Square } from "./lib"

print(area({ r: 2 })) // 12
print(area({ side: 3 })) // 9

function name(s: Shape): string {
  match s {
    Circle => "circle"
    Square => "square"
  }
}

print(name({ r: 1 }))
print(name({ side: 1 }))
