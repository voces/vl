// Exports the union AND its member types. The merge renames every one of them to `X$mN`;
// a `match` arm in the ENTRY spells them by their bare imported name, so the rename walk must
// reach the arm PATTERNS — which are `IsExpr` nodes carrying a check-type spelling — or the
// arms resolve to nothing in the merged program.
export type Circle = { r: i32 }
export type Square = { side: i32 }
export type Shape = Circle | Square

export function area(s: Shape): i32 {
  match s {
    Circle => 3 * s.r * s.r
    Square => s.side * s.side
  }
}
