// @error '__trap__' is a compiler intrinsic and cannot be redefined
// D2268 — a re-export's public name is also a local binding of the re-exporting module, so
// `export { bump as __trap__ } from "./lib"` is refused in `./mid` even though nothing here
// imports that name.
import { viaMid } from "./mid"

print(viaMid(4))
