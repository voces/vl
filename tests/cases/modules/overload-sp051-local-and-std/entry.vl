// @run
// @log 1
// @log a,b
// @log 3
// sunpa SP-051: a module's own zero-parameter `join` and std:str's `join(self: string[], …)`
// coexist with no alias. The plain call is the local one; the method call is std:str's.
import { join } from "std:str"

export function join(): i32 { 1 }

const xs = ["a", "b"]
print(join())
print(xs.join(","))
print(xs.join(",").length)
