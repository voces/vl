// @error call `h` directly
// A function value refused inside a generic, where the receiver is still a type parameter: no
// concrete lambda exists to suggest, so the refusal says to annotate at a concrete type or call
// the function directly (a lambda at `T` would not help).
import { A, d } from "./r1"
import { B, d } from "./r2"

function h<T>(x: T): string { x.d() }
function w<T>(xs: T[]): string[] { xs.map(h) }
const a: A = { x: 1 }
print(h(a))
print(w([a])[0])
