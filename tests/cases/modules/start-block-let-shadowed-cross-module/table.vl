// The IMPORTED module's top level. Its statements are merged into the same start function as
// the entry's, so its `for n` loop variable and the entry's block-scoped `const n` are two
// bindings of one name in one wasm frame — the shape D1593 mis-resolved.
export const T = __array_new__(4, 0)

for n in 0 to 3 {
  let c = n
  c = c + 1
  T[n] = c
}
