// @run
// @log 4
// @log 8
// The CROSS-MODULE face of D1593, and the shape glean's VL-042 met: the loop variable and the
// covering block binding are in DIFFERENT modules. Every module's top-level statements run in
// the one start function, so `startBlockLetOfSid`'s name scan reached across the module
// boundary and typed `./table`'s `let c = n` as this file's `i32 | E`.
//
// A single file reproduces it too (`tests/cases/scope/start-block-let-shadowed.vl`); this
// module pair is what the consumer actually wrote, so it is kept whole.
import { T } from "./table"

type E = { msg: string }

function pick(k: i32): i32 | E {
  if k < 0 { return { msg: "neg" } }
  return k + 7
}

print(T[3])

if T[3] < 0 {
  print(0 - 1)
} else {
  const n = pick(1)
  if n is E { print(0 - 2) } else { print(n) }
}
