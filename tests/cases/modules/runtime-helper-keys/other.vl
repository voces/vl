// Its own map and wide compare, so `entry2.vl` reaches both helper rows before `store.vl` does.
export type Cell = {
  a: f64,
  b: f64,
  c: f64,
  d: f64,
  e: f64,
  f: f64,
  g: f64,
  h: f64,
  i: f64,
}
export type Grid = { p: Cell, q: Cell, r: Cell, s: Cell }
export type Pt = { x: i32, label: string, g: Grid }

const pts: { [string]: Pt } = Map()

export function at(k: string, x: i32): Pt {
  const c = {
    a: 0.5,
    b: 1.0,
    c: 2.0,
    d: 3.0,
    e: 4.0,
    f: 5.0,
    g: 6.0,
    h: 7.0,
    i: 8.0,
  }
  { x: x, label: k, g: { p: c, q: c, r: c, s: c } }
}

export function mark(k: string, x: i32) { pts[k] = at(k, x) }

export function xOf(k: string): i32 {
  const p = pts[k]
  if p == null { return -1 }
  p.x
}

export function near(a: Pt, b: Pt): boolean { a == b }
