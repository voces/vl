// A map store and a compare wide enough for a shared helper: each call names a runtime helper
// that `other.vl`, loaded first by `entry2.vl`, would otherwise renumber.
export type Row = {
  a: i32,
  b: i32,
  c: i32,
  d: i32,
  e: i32,
  f: i32,
  g: i32,
  h: i32,
  i: i32,
}
export type Wide = { p: Row, q: Row, r: Row, s: Row }
export type Item = { name: string, n: i32, w: Wide }

const items: { [string]: Item } = Map()

export function mk(k: string, n: i32): Item {
  const r = { a: n, b: 1, c: 2, d: 3, e: 4, f: 5, g: 6, h: 7, i: 8 }
  { name: k, n: n, w: { p: r, q: r, r: r, s: r } }
}

export function put(k: string, n: i32) { items[k] = mk(k, n) }

export function count(k: string): i32 {
  const it = items[k]
  if it == null { return -1 }
  it.n
}

export function same(a: Item, b: Item): boolean { a == b }
