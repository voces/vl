// The same collision on the union member the parser does NOT get from a type
// producer: `type AB = { … } | { … }` takes the LBRACE path, whose first member
// is the synthetic `"{" + synth + "}"` text assembled from the field list. Its
// spelling tree is assembled the same way (a `TS_FIELD` per field under one
// `TS_OBJ`), so this member renames structurally too.
export type v = i32

export type AB = { v: i32 } | { w: string }

export function mk(): AB {
  const a: AB = { v: 7 }
  a
}

export function tell(a: AB): i32 {
  if a is { w: string } { return 2 }
  1
}
