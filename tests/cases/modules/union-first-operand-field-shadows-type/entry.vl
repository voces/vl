// D-PARSETY P2, the FIRST member of a `type N = { … } | { … }` declaration —
// the one the parser synthesizes from the field list rather than returning from
// `parseVariantName`. Without a spelling tree for it, `modTypeRenamed` renamed
// the field `v` (a top-level `type v` lives in the same module) and the member
// became `{v$m1: i32}`.
//
// On master: `cannot assign {v: i32} to 'a' of type {v: i32} | {w: string}`.
import { mk, tell } from "./lib"

print(tell(mk()))
