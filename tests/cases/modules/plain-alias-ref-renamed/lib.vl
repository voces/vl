// The module MERGE renames every declaration in a NON-ENTRY module to `Name$mN`,
// and `$` is not an identifier character — so the checker's hand-written
// identifier-RUN scanner over the member's rendered spelling answered "not a plain
// alias reference" for every renamed one-member alias in this file. The
// transparency collapse #1122 established was silently lost across a module
// boundary: both aliases below died in the emitter with
// "emitProgram: ref valtype with no interned shape", while the byte-identical
// SINGLE-FILE spelling (see entry.vl's local control) has always run.
//
// D-ALIASREF asks the parser instead of the string: the member's spelling ROOT
// (`udTsRootAt`) is a `TS_NAME` / `TS_APP` before and after the rename, because the
// rename edits a node's TEXT and not its KIND.
type Cat = { legs: i32 }
type MyCat = Cat

type Box<T> = { v: T }
type BoxI = Box<i32>

// THE EXCLUSION CONTROL. A canonicalized object INTERSECTION is a one-member union
// too, and must NOT be transparent — the emitter interns it as a named struct
// through `unionStructAliasShape`, and expanding it would lose that registration.
// Its spelling root is a `TS_ISECT`, which the tree rejects exactly where the
// character scanner's leading-`{` test did, renamed or not.
type Both = { a: i32 } & { b: i32 }

export function mkCat(): MyCat { { legs: 4 } }
export function mkBox(): BoxI { { v: 9 } }
export function mkBoth(): Both { { a: 1, b: 2 } }
