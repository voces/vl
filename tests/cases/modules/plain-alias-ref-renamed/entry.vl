// @run
// @log 4
// @log 9
// @log 3
// @log 2
// A one-member alias whose body is a plain type REFERENCE is TRANSPARENT (#1122).
// Across a module boundary it was not, because the merge renames the declaration to
// `Name$mN` and the checker re-derived "is this a plain reference?" by scanning the
// member's rendered spelling for an identifier RUN — a scan `$` fails. D-ALIASREF
// routes the question to the spelling ROOT the parser banked, which is a `TS_NAME` /
// `TS_APP` on both sides of the rename.
import { mkBoth, mkBox, mkCat } from "./lib"

print(mkCat().legs)
print(mkBox().v)
const b = mkBoth()
print(b.a + b.b)

// THE ENTRY-MODULE CONTROL: the same two alias shapes declared HERE. The entry
// module's declarations are not renamed, so these ran on master and run now —
// which is what makes the two `lib.vl` lines above a RENAME finding and not an
// alias-transparency one.
type Dog = { ears: i32 }
type MyDog = Dog

function mkDog(): MyDog { { ears: 2 } }

print(mkDog().ears)
