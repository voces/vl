// @error-at 5:9 `export { foo }` has no `from` — an export list only re-exports another module's names; to export `foo` from this module, write `export` on its declaration
// D3559: a name this module DECLARES has one export spelling, the `export` keyword
// on the declaration (modules-design §2.1). The refusal says so instead of reading
// the list as a re-export from the specifier "".
function foo(): i32 { return 1 }
export { foo }
print(foo())
