// The struct and its UFCS reader live HERE, so the entry's hole parameter is pinned to a type
// it never spells. `std:buffer`'s `Buf` / `loadU8` are this pair in the consumer's own program
// (glean, VL-042); a local module keeps the fixture off std's shape while asking the same
// question of the pin.
export type Cell = { base: i32 }

export function mk(n: i32): Cell { return { base: n } }

export function ld(self: Cell) { self.base }
