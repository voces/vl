// @run
// @log 8
// @log 8
// THE CROSS-MODULE FACE of D1596, and the shape glean's VL-042 met: the struct type and its
// UFCS reader are imported, the un-annotated helper is local, and the value is bound inside a
// TOP-LEVEL BLOCK. A binding written there is a start-function local rather than a module
// global, so the monomorphizer's module-scope rung — a flat scan of the top-level statement
// list — never saw it and the instance took the `"i32"` catch-all over a `(ref $type)`
// argument.
//
// The single-file face is `tests/cases/generics/pin-module-block-binding.vl`, which grades the
// block kinds and both faces of the hole; this pair is what the consumer actually wrote.
import { Cell, ld, mk } from "./buf"

function sum(c) { c.ld() + c.ld() }

// the union narrowing the consumer's own program had around the block — scenery for this
// mechanism, kept because it is what the reported program looked like
type Bad = { msg: string }

function open(k: i32): Cell | Bad {
  if k < 0 { return { msg: "closed" } }
  return mk(k)
}

if open(4) is Bad {
  print(0 - 1)
} else {
  const c = open(4)
  if c is Bad { print(0 - 2) } else { print(sum(c)) }
}

// the same delivery with no union anywhere, so the block scope is the only ingredient left
while true {
  const d = mk(4)
  print(sum(d))
  break
}
