// The LEAKING module, which is not the entry. `mid` imports `mk` and `Box` and
// then spells `b.hidden()` — a name it never imported and cannot name directly.
// The entry below never spells `hidden` at all, so the row that answered here was
// banked by a THIRD file: a name-keyed table is global to the merge.
import { mk, Box } from "./lib"

export function twice(v: i32): i32 {
  const b: Box = mk(v)
  return b.hidden()
}
