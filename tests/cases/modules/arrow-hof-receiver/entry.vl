// @run
// @log 7
// @log 12
// @log 7
// @log 12
// An un-annotated and a partially annotated function value crossing a MODULE boundary into an
// imported higher-order receiver, once per receiver spelling. The two halves must agree: the
// receiver's definition form is not part of what a declared parameter type means.
//
// Each value reaches exactly ONE receiver, and that is load-bearing. The instance registry is
// keyed by function and signature, not by call site, so a `function`-declaration receiver anywhere
// in the module materializes the instance and annotates the shared slot's holes — which satisfies
// the emit-time value floor for every other use of that value, in either statement order. Sharing
// one `padd` between the two receivers here would make the arrow half pass on a compiler that
// cannot see an arrow receiver's parameters at all.
import { applyArrow, applyDecl } from "./util"

function paddA(a, b) { return a + b }
function pmulA(a: i32, b) { return a * b }
function paddD(a, b) { return a + b }
function pmulD(a: i32, b) { return a * b }

print(applyArrow(paddA, 3, 4))
print(applyArrow(pmulA, 3, 4))
print(applyDecl(paddD, 3, 4))
print(applyDecl(pmulD, 3, 4))
