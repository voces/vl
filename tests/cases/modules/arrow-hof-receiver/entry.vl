// @run
// @log 7
// @log 7
// @log 12
// @log 12
// An un-annotated and a partially annotated function value crossing a MODULE boundary into an
// imported higher-order receiver, once per receiver spelling. The two lines of each pair must
// agree: the receiver's definition form is not part of what a declared parameter type means.
import { applyArrow, applyDecl } from "./util"

function padd(a, b) { return a + b }
function pmulti(a: i32, b) { return a * b }

print(applyArrow(padd, 3, 4))
print(applyDecl(padd, 3, 4))
print(applyArrow(pmulti, 3, 4))
print(applyDecl(pmulti, 3, 4))
