// An IMPORTED higher-order receiver in both spellings. The exported arrow is a nameless
// `FuncDecl` bound to an exported global, so its declared callback type lives where only the
// binding walk finds it — the merged module makes the importing side's call look identical to a
// call on a `function` declaration, which is why the two spellings had to answer the same.
export const applyArrow = (g: (i32, i32) => i32, x: i32, y: i32) => g(x, y)

export function applyDecl(g: (i32, i32) => i32, x: i32, y: i32) {
  return g(x, y)
}
