// A module-private hook re-pointed only through an exported setter (D5017).

export type Box = { m: string | null }

function countNone(_n: i32): i32 { 0 }
let hook: (n: i32) => i32 = countNone
export function hookSet(f: (n: i32) => i32) { hook = f }
function runHook(n: i32): i32 { hook(n) }

export function show(b: Box): i32 {
  if b.m != null {
    const k = runHook(1)
    return b.m.length + k
  }
  -1
}
