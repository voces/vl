// @run
// @log 3
// @log 5

// A call through a binding another module re-points by an aliased setter keeps the caller's
// narrowing when no function handed to the setter writes it (D5017).
import { hookSet as install, show } from "./lib"

function bump(n: i32): i32 { n + 1 }

print(show({ m: "abc" }))
install(bump)
print(show({ m: "abc" }))
