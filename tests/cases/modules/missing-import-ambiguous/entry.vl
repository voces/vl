// @error-at 7:6 undeclared identifier 'dup' — `dup` is exported by "./a" and "./b"; import it from one of them
// Two modules export `dup`, so the sentence lists both and names no edit: the choice is the
// author's, and `check --fix` leaves the file alone (tests/vl_check_fix_test.ts).
import { dup as one } from "./a"
import { dup as two } from "./b"

print(one() + two())
print(dup())
