// @run
// @log 42
// A `self`-function EXPORTED by the receiver type's own declaring module resolves
// without being imported: `Buf` and `storeI32`/`loadI32` all live in "std:buffer", so
// `b.storeI32(…)` finds them in `Buf`'s home module (type-bound UFCS). Only `Buf` and the
// `Buffer` constructor are imported; the methods are reached through the value's own type.
import { Buf, Buffer } from "std:buffer"

function put(b: Buf, v: i32) { b.storeI32(0, v) }

function main() {
  const b = Buffer(16)
  put(b, 42)
  print(b.loadI32(0))
}

main()
