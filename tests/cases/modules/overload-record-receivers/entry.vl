// Two modules' `area` take `Box` and `Sq` first: declared record names are distinct head
// classes, so both imports stand (receiver overloading, owner ruling O1) and each receiver
// reaches its own. Before O1 this was D1120's refused import-vs-import duplicate; two
// functions whose first parameters overlap still are (`err-duplicate-binding/`).
import { area, box } from "./a"
import { area, sq } from "./b"

print(box(5).area())
print(sq(3).area())
