// The third position the merge rewrites as a STRING: an `is` check type
// (`IsExpr.isVariant`). A top-level `type w` in the same module made
// `modTypeRenamed` rename the FIELD of `{ w: string }`, so the check type
// `{w$m1: string}` was no longer a member of the union it tests.
export type w = i32

export type AB = { v: i32 } | { w: string }

export function mk(): AB {
  const a: AB = { w: "x" }
  a
}

export function tell(a: AB): i32 {
  if a is { w: string } { return 2 }
  1
}
