// @run
// @log yes
// @log no
// @log inline-yes
// @log inline-no
// @log 3
// The module-merge half of `tests/cases/types/litunion-escaped-quote-member.vl`:
// a literal-union member carrying an ESCAPED QUOTE in a module whose rename map
// holds the two identifier segments that sit inside it (`b`, `c`). A merge that
// walked the RENDERED type name for identifier runs — instead of the parser's
// spelling tree — would rewrite `"a\"b"` to `"a\"b$m1"`, and the values below
// would stop being members of their own type.
import { pick, pickInline, widths, Q } from "./lib"

const hit: Q = "a\"b"
const miss: Q = "c"
print(pick(hit))
print(pick(miss))
print(pickInline(hit))
print(pickInline(miss))
print(widths(1, 2))
