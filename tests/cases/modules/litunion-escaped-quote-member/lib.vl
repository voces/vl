// A module that declares TOP-LEVEL bindings named `b` and `c` beside a
// literal-union alias whose first member CARRIES an escaped quote. The parser
// stores the raw lexeme — quotes kept, escapes unresolved — so the member is the
// six characters `"a\"b"`, and `b` and `c` are exactly the identifier segments a
// scanner that mis-terminates that member at the ESCAPED quote would then find:
// `b` immediately after it, and `c` after the run it re-opens. The merge renames
// every top-level name to `name$mN`, so both are live rename candidates.
//
// What keeps them out of the literal is that the merge renames the parser's
// SPELLING TREE and renders the name from it (`modRwTsName` + `tsToName`), at
// every position a quoted member can occupy: a `UnionDecl` member (`setUdTs`), a
// `TypeRef` annotation and an `is` check type (both `setAnnTs`). The tree knows a
// `TS_LITSTR`'s text is a LEXEME and never a rename candidate, so no scan of the
// RENDERED name happens here and the member keeps its six characters — which is
// what lets the runtime value that carries them still match its own type.
export type b = i32
export type c = i32

export type Q = "a\"b" | "c"

export function pick(q: Q) {
  if q is "a\"b" { return "yes" }
  "no"
}

// The same member as an INLINE literal union in annotation position — a
// `TypeRef` whose `tyName` carries the quotes directly, rather than a member of a
// declared alias.
export function pickInline(q: "a\"b" | "c") {
  if q is "a\"b" { return "inline-yes" }
  "inline-no"
}

export function widths(x: b, y: c) { x + y }
