// `id` is a perfectly good generic — the defect is in what the ENTRY does with it.
// `snd` is the control: a SECOND uncalled generic that the entry does NOT re-export, so
// it is not part of the wasm ABI and must keep taking the silent no-op stub. That is the
// routine case #552's prune exists for (importing a module for some of its generics pulls
// in ALL of them), and the reject must not widen onto it.
export function id<T>(x: T): T { return x }

export function snd<T>(a: T, b: T): T { return b }
