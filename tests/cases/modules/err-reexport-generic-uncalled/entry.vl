// @emit-error the exported generic function `id` is never instantiated
// The MODULE-MODE half of `functions/error-exported-generic-uncalled.vl`: a root
// `export { … } from "./lib"` re-export of a dependency's generic that nothing
// instantiates. It reaches the same silently-wrong ABI by a different route — the merged
// declaration is named `id$m1` and the alias table maps the public `id` onto it, so the
// prune's `() -> void` stub landed under the name the entry published.
//
// The diagnostic names `id`, the PUBLIC name, not the mangled `id$m1` the merge produced:
// `id$m1` is not a string this source contains, and a re-export may rename on the way out.
//
// `lib.vl`'s `snd` is the load-bearing control — an uncalled generic that is NOT
// re-exported, so it stays a silent stub. The reject fires on ABI membership, which is
// the same name resolution `emitExportSection` performs, and on nothing else.
export { id } from "./lib"

print(5)
