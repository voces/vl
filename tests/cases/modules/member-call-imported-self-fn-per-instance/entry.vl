// @run
// @log 1
// @log 99
// @log he
// @log fn
// An imported `self`-function reaches a generic body under its merged name, and each instance
// still takes the receiver's built-in method first (D2517): the list and string instances call
// `push` and `slice` of their own type, the boolean instances the imported functions.
import { push, slice } from "./m"

function f<T>(x: T) { x.push(1) }
function g<T>(x: T): string { x.slice(0, 2) }
const xs: i32[] = []
f(xs)
print(xs.length)
f(true)
print(g("hello"))
print(g(false))
