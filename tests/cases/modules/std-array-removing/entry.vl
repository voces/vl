// @run
// @log 20
// @log 10
// @log 30
// @log 40
// @log 50
// @log 10
// @log 50
// @log 30
// @log 40
// @log 30
// @log bb,dd
// @log 3
// @log 2
// @log 2
// @log 2
// @log 1
// @log 7
// @log 0
// @log 0
// @log 2
// @log 0
// `std:array`'s in-place removers: `removeAt` keeps order, `swapRemove` moves the
// last element into the hole, `retain` compacts by a predicate that closes over
// a local. Over i32, string, f64 and a record, at both method and call spelling,
// with the lambda annotated and not.
import { removeAt, retain, swapRemove } from "std:array"
import { join } from "std:str"

type Shot = { id: i32, x: f64 }
const xs = [10, 20, 30, 40, 50]
print(xs.removeAt(1))
for v in xs { print(v) }
print(xs.swapRemove(0))
for v in xs { print(v) }
const limit = 35
xs.retain((v: i32) => v < limit)
for v in xs { print(v) }
const ss: string[] = ["a", "bb", "ccc", "dd"]
ss.retain((s: string) => s.length == 2)
print(ss.join(","))
const shots: Shot[] = [{ id: 1, x: 1.5 }, { id: 2, x: 2.5 }, { id: 3, x: 3.5 }]
const gone = removeAt(shots, shots.length - 1)
print(gone.id)
print(shots.length)
retain(shots, (s: Shot) => s.x > 2.0)
print(shots[0].id)
const fs: f64[] = [1.0, 2.0]
print(fs.swapRemove(1))
for v in fs { print(v) }
const one = [7]
print(one.swapRemove(0))
print(one.length)
const e: i32[] = []
e.retain((v: i32) => true)
print(e.length)
const zs = [1, 2, 3, 4]
zs.retain((v) => v % 2 == 0)
print(zs.length)
retain(zs, (v) => false)
print(zs.length)
