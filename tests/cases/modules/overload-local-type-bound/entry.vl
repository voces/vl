// @run
// @log A
// @log B
// The type-bound rung (#3005): with no import of `tag`, a method call asks the receiver type's
// declaring module, which answers from its set by the receiver's head.
import { A, B } from "./shapes"

const a: A = { x: 1 }
const b: B = { s: "q" }
print(a.tag())
print(b.tag())
