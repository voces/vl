// @run
// @log #b 7
// @log s
import { label } from "./label"

// The same spelling, `{r: i32}`, joined by `??` with `{r: "s"}`: one merged row whose field
// is an `i32 | string` box, so this program's store for it is another helper.
function rm(k: string) {
  const c = Map()
  c["b"] = { r: 7 }
  const g = c[k] ?? { r: "s" }
  if g.r is string { print(g.r) } else { print("\{label("b")} \{g.r}") }
}
rm("b")
rm("miss")
