// @run
// @log 1
// @log 7
// A payload BINDING must shadow a module-level name of the same spelling across the merge.
// `lib.vl` has a top-level `const x`, which the merge renames to `x$m1`; the arm binds its own
// `x` from the payload. The binding is not in the arm body yet at merge time (it lives on the
// `matchBinds` column until the desugar splices it), so without `modShadowMatchBinds` the body's
// `x` was renamed to `x$m1` too and the arm read the MODULE GLOBAL instead of its payload.
//
// `1` is the payload, `7` is the global — reading `100` (the global's value) for the first line
// would be the bug.
import { global, tell } from "./lib"

print(tell({ x: 1, y: 2 }))
print(global())
