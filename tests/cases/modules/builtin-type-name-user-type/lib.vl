// D1585 — an EXPORTED `type` that takes a built-in type name, refused at its declaration.
// `u8` is the storage type `primTyOfName` withholds, and until D1585 neither face caught it:
// the single-file screen asked a predicate that did not know `u8`, and the module face never
// ran at all, because the merge had already renamed `u8` to `u8$mN` by the time the screen
// walked this declaration. Both faces now ask `isBuiltinTyName` and raise through
// `tErrBuiltinTyDecl`, so the exporting module is where the sentence lands.
export type u8 = { x: i32 }

export function ping(): i32 { return 1 }
