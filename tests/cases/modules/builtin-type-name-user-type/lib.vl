// The CONTROL for D1571: an exported `type` that takes a builtin name. `u8` is the storage
// type `primTyOfName` withholds, so a declaration of it is not caught by the reserved-name
// rule that refuses `type f64` — and across the merge it renames to `u8$mN` and shadows.
export type u8 = { x: i32 }

export function make(v: i32): u8 { return { x: v } }
