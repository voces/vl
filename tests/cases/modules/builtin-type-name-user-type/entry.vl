// @run
// @log 5
// D1571's CONTROL — a `type` row still renames a builtin name, so an imported user type
// named `u8` still shadows the storage type here. This runs today and must keep running.
//
// It is the half of the fix that is a gate rather than a change: the narrow rule is "a
// builtin type name is renamed in TYPE position ONLY by a `type` row", and a rule spelled
// "never renamed" would have taken this program away. `builtin-type-name-export/` is the
// other side — a VALUE row, which must NOT rename.
import { make, u8 } from "./lib"

const v: u8 = make(5)
print(v.x)
