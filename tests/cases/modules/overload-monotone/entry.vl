// @run
// @log string hi
// @log list of 2
// Adding a disjoint candidate never moves a call: `./m`'s map `describe` joins the string and
// list ones of `overload-per-instance`, and the string and list calls answer exactly as there.
import { describe } from "./s"
import { describe } from "./a"
import { describe } from "./m"

print("hi".describe())
print([1, 2].describe())
