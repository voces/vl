// @run
// @log 99
// @log 7
// @log 7
// The other half of D1984's rule: a function in the caller's scope whose `self` DOES take the
// receiver keeps the call, so `std:simd`'s own `dot` and `cross` are never consulted here —
// a concrete `self: F32x4`, and a generic `self: T` whose body asks nothing of `T`.
import { F32x4, f32x4 } from "std:simd"

function dot(self: F32x4, o: F32x4): f32 { return 99.0 }

function cross<T>(self: T, o: T): i32 { return 7 }

const a = f32x4(1.0, 2.0, 3.0, 0.0)
print(a.dot(a))
print(a.cross(a))
print("s".cross("t"))
