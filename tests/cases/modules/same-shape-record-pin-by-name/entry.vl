// @run
// @log RBRA
// @log RB
// @log RARB
// @log RARB
// @log RARB
// @log RB
// @log RARB
// @log RARB
// @log RB
// @log RARB
// @log RARB
// @log RBRA
// Two same-shaped records keep their names wherever a generic is pinned from a value of one:
// a generic record's list field, a record's list field, a map read, a loop variable, a
// forwarding generic, a capture and a callback each pin `h` at `B`, not at whichever record
// came first (D3863).
import { A, d } from "./r1"
import { B, d } from "./r2"

type Box<T> = { v: T }
type Pair<T, U> = { l: T, r: U }
type HA = { f: A[] }
type HB = { f: B[] }
function h<T>(x: T): string { x.d() }
function idt<T>(x: T): T { x }
function fw<T>(x: T): string { h(x) }
const a: A = { x: 1 }
const b: B = { x: 2 }
const ba: Box<A[]> = { v: [a] }
const bb: Box<B[]> = { v: [b] }
print(h(bb.v[0]) + h(ba.v[0]))
function viaParam(x: Box<B[]>) { h(x.v[0]) }
print(viaParam(bb))
const ha: HA = { f: [a] }
const hb: HB = { f: [b] }
print(h(ha.f[0]) + h(hb.f[0]))
const ma: {[string]: A} = Map()
ma["k"] = a
const mb: {[string]: B} = Map()
mb["k"] = b
print(h(ma["k"] ?? a) + h(mb["k"] ?? b))
const p: Pair<A[], B[]> = { l: [a], r: [b] }
print(h(p.l[0]) + h(p.r[0]))
const lb: B[] = [b]
for e in lb { print(h(e)) }
print(fw(ba.v[0]) + fw(bb.v[0]))
const bba: Box<Box<A>[]> = { v: [{ v: a }] }
const bbb: Box<Box<B>[]> = { v: [{ v: b }] }
print(h(bba.v[0].v) + h(bbb.v[0].v))
const fb = () => h(bb.v[0])
print(fb())
print(h(idt(ba.v[0])) + h(idt(bb.v[0])))
print([ba].map((x) => h(x.v[0]))[0] + [bb].map((x) => h(x.v[0]))[0])
function fwl<T>(xs: T[][]): string { h(xs[0][0]) }
print(fwl([[b]]) + fwl([[a]]))
