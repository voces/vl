// @run
// @log RA
// @log RB
// @log RA
// @log RB
// @log RA
// @log RB
// @log RARB
// @log RBRA
// @log 2
// @log 0
// An un-annotated callback over a list of lists, of generic records or of lists of them pins
// the generic it calls by each record's declared name, so `A` and `B` keep their own `d`
// (D3834).
import { A, d } from "./r1"
import { B, d } from "./r2"

type Box<T> = { v: T }
type Pair<T, U> = { l: T, r: U }
function h<T>(x: T): string { x.d() }
const a: A = { x: 1 }
const b: B = { y: 2 }
print([[a]].map((xs) => h(xs[0]))[0])
print([[b]].map((xs) => h(xs[0]))[0])
const ba: Box<A> = { v: a }
const bb: Box<B> = { v: b }
print([ba].map((x) => h(x.v))[0])
print([bb].map((x) => h(x.v))[0])
const bas: Box<A>[] = [ba]
const bbs: Box<B>[] = [bb]
print([bas].map((x) => h(x[0].v))[0])
print([bbs].map((x) => h(x[0].v))[0])
const p: Pair<A, B> = { l: a, r: b }
print([p].map((x) => h(x.l) + h(x.r))[0])
const q: Pair<B, A> = { l: b, r: a }
print([q].map((x) => h(x.l) + h(x.r))[0])
const bs: B[][] = [[b], [b]]
print(bs.filter((x) => h(x[0]) == "RB").length)
const as2: A[][] = [[a]]
print(as2.filter((x) => h(x[0]) == "RB").length)
