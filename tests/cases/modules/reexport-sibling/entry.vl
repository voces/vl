// @run
// @log 42
// A re-export is part of the re-exporting module's PUBLIC surface: `mid` declares
// nothing, it only re-exports `homeFn` from `home`, and a SIBLING importing
// `homeFn` from `mid` resolves to `home`'s declaration.
//
// This is the case `tests/cases/modules/reexport` does NOT cover — that one
// re-exports from the ENTRY, which worked because the entry binds the name
// locally (the re-export rides in as an import) and never asks
// `modExportsHas`. Only a THIRD module asking "does `mid` export this?" reaches
// the lookup that used to read `expName` alone and answer no.
import { homeFn } from "./mid"

print(homeFn(41))
