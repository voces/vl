// The calls D4061's rule accepts, across a module and through a receiver-overload set: each
// named argument before a positional one is in its own position, counting the receiver as 0.
import { box, sz } from "./lib"
import { sz } from "./s"

print(box(w: 3, 2))
print(box(3, h: 2))
print((1).sz(w: 3, 2))
print("ab".sz(w: 2, 3))
print("ab".sz(3, h: 2))
