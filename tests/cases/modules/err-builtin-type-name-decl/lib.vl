// Two of the three positions D1585 refuses, in the module the ENTRY imports from: an EXPORTED
// struct alias and a PRIVATE union alias. `export` is not an ingredient — the screen walks
// every top-level declaration of every module — and neither is being reached by an importer:
// nothing below annotates `f64` or `i64`, and the program is refused all the same.
export type f64 = { x: i32 }

type i64 = "a" | "b"

export function ping(): i32 { return 1 }
