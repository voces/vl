// @run
// @log 5
// @log 6
// @log ab
// D2268's control: an alias to an ordinary name still binds, and so does one spelled as a
// compiler helper that is not reserved (`__str_concat__`), which leaves `+` on strings alone.
import { bump as __str_concat__, bump as plus } from "./lib"

print(plus(4))
print(__str_concat__(5))
print("a" + "b")
