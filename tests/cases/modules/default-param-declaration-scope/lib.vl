// The DECLARING module. Its `SEP` and `PAD` are the values every default below
// must take, whichever module the call is written in — the entry declares its
// own `SEP`/`PAD` with different values precisely so a wrong answer is visible.
const SEP: string = "-"
const PAD: i32 = 3

export function join2(a: string, b: string, sep: string = SEP): string {
  return a + sep + b
}

export function padded(n: i32, width: i32 = PAD): i32 { return n + width }

// `__callsite__` is the other half of the rule: its EVALUATION POSITION is the
// call, so this reports the CALLER's module and line — including when the caller
// is this module itself.
export function here(
  c: { file: string, line: i32, col: i32 } = __callsite__,
): string {
  return c.file
}

export function hereLine(
  c: { file: string, line: i32, col: i32 } = __callsite__,
): i32 {
  return c.line
}

export function fromLib(): string { return here() }
