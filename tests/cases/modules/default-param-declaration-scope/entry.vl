// @run
// @log a-b
// @log a!!!b
// @log 4
// @log 101
// @log true
// @log 35
// @log 36
// A DEFAULT'S NAMES RESOLVE AT THE DECLARATION, NOT AT THE CALL. `join2` and
// `padded` are declared in `./lib` and their defaults name LIB's `SEP` and
// `PAD`; this module declares its own bindings of both names, with different
// values. If the substituted expression resolved at the call site, the first two
// lines would read `a!!!b` and `101`.
//
// The mechanism is the module merge: a top-level name is mangled per module
// (`SEP` → `SEP$mN`), and the merge now rewrites parameter DEFAULTS along with
// every other expression of the declaring module — so lib's default spells lib's
// mangled name and the entry's `SEP` is a different name entirely. (Inside one
// module the same guarantee is a mark on the node; see
// `functions/default-param-module-const.vl`.)
import { fromLib, here, hereLine, join2, padded } from "./lib"

const SEP: string = "!!!"
const PAD: i32 = 100

print(join2("a", "b"))
print(join2("a", "b", SEP))
print(padded(1))
print(padded(1, PAD))

// `__callsite__` is caller-POSITIONAL by nature: `here()` written here reports
// THIS module, and `fromLib()` — whose `here()` is written in lib — reports lib.
// The two must differ, which is the attribution a single-file case cannot show.
print(here() != fromLib())
print(hereLine())
print(hereLine())
