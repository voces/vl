// @run
// @log 6
// @log 5
// An imported `: never` function ends a path exactly as a local one does: the checker reads
// the call's type, not the callee's module (D1972).
import { fail } from "./util"

type IoError = { msg: string }
function f(x: i64 | IoError) {
  if x is IoError { fail("io") }
  x * 2
}
print(f(3 as i64))
const v = if f(1 as i64) > 0 { 5 } else { fail("no") }
print(v)
