// @run
// @log 11.25
// Receiver overloading meets an un-annotated lambda (sunpa SP-052): the receiver's head class
// picks `visit`, and the picked candidate's parameter types the lambda — `p` as `P` for the
// list, `v` as `f64` for the record. The f64 sum proves both.
import { visit } from "./l"
import { P, visit } from "./p"

const ps: P[] = [{ x: 1.5 }, { x: 2.5 }]
let s = 0.25
ps.visit((p) => {
  s = s + p.x / 2.0
})
const q: P = { x: 4.5 }
q.visit((v) => {
  s = s + v * 2.0
})
print(s)
