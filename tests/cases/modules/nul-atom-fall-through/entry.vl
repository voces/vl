// @run
// @log none
// @log c
// @log c
// @log b
// @log none
// @log a!
// @log none!
// @log 2
// A function returning the nullable atom `R | null` that falls off its end returns the `-1`
// null, not a trap: an else-less tail `if` (assignment or value) and a loop that returns
// early, imported from another module, read at a binding, an argument and a list (D5340).
import { G } from "./types"
import { find, pick, store } from "./ops"

function show(x: string | null): string { (x ?? "none") + "!" }
function ruleOf(g: G): string {
  const h = g.h
  if h != null { h.rule } else { "x" }
}

const g: G = { h: null }
print(store(g) ?? "none")
g.h = { health: 1, rule: "a" }
const s = store(g)
print(s ?? "x")
print(ruleOf(g))
print(pick(true, "b") ?? "x")
print(pick(false, "b") ?? "none")
print(show(find(["b", "a"], "a")))
print(show(find(["b"], "c")))
const got = [pick(false, "a"), find(["c"], "c")]
print(got.length)
