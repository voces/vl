import { G, R } from "./types"

// Un-annotated and exported: the tail `if` makes the return `R | null`.
export function store(g: G) {
  const h = g.h
  const r: R = "c"
  if h != null { h.rule = r }
}

export function pick(c: boolean, r: R): R | null {
  if c { r }
}

export function find(rs: R[], want: R) {
  for r in rs {
    if r == want { return r }
  }
}
