// @error-at 12:29 An import specifier is a string — single quotes are a char literal; write "std:fs"
// CONTRACT (must-error): a char-quoted import specifier is refused AT THE
// SPECIFIER, and refused for what it is.
//
// THE DEFECT THIS PINS IS THE STEAL. `modScan`'s walk to the path STRING skipped
// every token that was not one — past the end of the statement, past the end of
// the LINE — so `'std:fs'` (a CHAR token, not a STRING) sent it on to adopt the
// next string literal ANYWHERE in the file as this import's specifier. The
// report then read `Unsupported import specifier "the story"` pointing at a line
// the import has nothing to do with. The walk is bounded now, exactly as
// `parseImport`'s already was — `isStmtKeyword` is imported from the parser so
// the two cannot drift — and the char literal gets its own sentence.
import { readTextFile } from 'std:fs'

// The bait: the OLD scan reported this string as the import's specifier. Its
// text must appear in no diagnostic.
print("the story")
