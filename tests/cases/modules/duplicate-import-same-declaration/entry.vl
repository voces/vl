// @run
// @log 10
// The NARROW half of D1120's duplicate-import rule, pinned. Importing one name twice
// from the SAME module binds it to ONE declaration: redundant, not ambiguous, and it
// runs today. The rule tests the resolved merged target (`modMergedTargetOf`), not the
// specifier text, so this stays legal while two DIFFERENT declarations do not — and a
// re-export chain that lands on the same declaration is legal for the same reason.
import { area, box } from "./a"
import { area } from "./a"

print(box(5).area())
