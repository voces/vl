// @run
// @log 3.5
// @log 2.5
// @log 9000000000
// The module leg of `as-cast-alias-target.vl`: an `as` cast whose target is a
// NON-i32 numeric alias, both module-local and IMPORTED. The two pre-existing
// module `as`-cast pins both alias i32, which is the one target needing no
// conversion — so they run even when the emitter mistakes the alias for i32.
// With `f64` / `i64` the same mistake emits invalid wasm.
import { Real, Wide, half } from "./lib"

print(half(7))

const r = 5 as Real
print(r / 2.0)

const w = 9000000000 as Wide
print(w)
