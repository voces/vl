// A NON-i32 numeric alias, exported as a cast target and used as one locally.
// The merge renames the declaration to `Real$m1`, so the canon pass has to
// resolve the MANGLED name to `f64` — the arena read does, because the checker
// banked the cast's resolved type on the node.
export type Real = f64
export type Wide = i64

export function half(n: i32): f64 {
  const x = n as Real
  x / 2.0
}
