// @check
// @error-at 9:11 `shown` here names a const at 8:2, not a function with a `self` parameter
// An import is a module-scope binding like any other, so a local `const shown` shadows it for the
// method call too: `b.shown()` names the const and is refused, as with an own-module function.
import { Box, mk, shown } from "./lib"

function go(): i32 {
  const shown = 5
  const b: Box = mk(21)
  return b.shown() + shown
}

print(go())
