// @run
// @log 47
// D1191's other direction: a UFCS PROPERTY is not a value reference, so a local
// binding of the same name does not hide the imported `self`-function.
//
// The merge used to answer this site through `modRenamed`, which consults the
// lexical shadow stack — so the `const shown = 5` below made `b.shown()` resolve
// to nothing and the file was refused `'shown' is not imported`, about a name the
// first line imports. Module scope is what decides a UFCS candidate now, and the
// two spellings coexist: `b.shown()` is the function, `shown` on its own is the 5.
import { mk, shown, Box } from "./lib"

function go(): i32 {
  const shown = 5
  const b: Box = mk(21)
  return b.shown() + shown
}

print(go())
