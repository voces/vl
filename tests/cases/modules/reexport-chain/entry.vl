// @run
// @log 42
// @log 9
// Re-exports CHAIN: `a` declares, `b` re-exports from `a`, `c` re-exports from `b`
// (renaming as it goes), and the entry imports from `c`. Each link resolves through
// the one below it, so the name the entry binds must chase all the way down to `a`'s
// declaration — a one-hop resolver would rewrite the call onto a `base$mC` that no
// module ever defines.
//
// `plain` rides the same chain WITHOUT a rename, so the chase is pinned on both the
// aliased and the unaliased link.
import { doubled, plain } from "./c"

print(doubled(21))
print(plain(3))
