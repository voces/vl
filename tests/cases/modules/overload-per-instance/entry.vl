// @run
// @log string a
// @log list of 3
// @log string q/string q
// @log list of 1/list of 1
// A receiver each call supplies (a type parameter, an un-annotated parameter) picks its
// candidate per monomorphized instance, through a second generic as well.
import { describe } from "./s"
import { describe } from "./a"

function d<T>(x: T): string { x.describe() }
function twice(y) { d(y) + "/" + d(y) }
print(d("a"))
print(d([1, 2, 3]))
print(twice("q"))
print(twice([true]))
