// @error D does not satisfy `{mn(T):T}`: no `mn(): D` — the bound needs a field of that type or a `mn(self: D, …)` function in scope at this call
// A type no candidate of the set takes stays refused, naming the function it lacks.
import { A, mn } from "./a"
import { B, mn } from "./b"

type D = { w: i32 }

function lo<T: { mn(T): T }>(x: T, y: T): T { return x.mn(y) }

const a1: A = { v: 3 }
const a2: A = { v: 2 }
const d1: D = { w: 1 }
const d2: D = { w: 2 }
print(lo(a1, a2).v)
print(lo(d1, d2).w)
