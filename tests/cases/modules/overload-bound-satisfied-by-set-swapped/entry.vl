// @run
// @log 2
// @log q
// The same set imported in the other order: each instance still finds its own candidate.
import { B, mn } from "./b"
import { A, mn } from "./a"

function lo<T: { mn(T): T }>(x: T, y: T): T { return x.mn(y) }

const a1: A = { v: 3 }
const a2: A = { v: 2 }
const b1: B = { s: "xyz" }
const b2: B = { s: "q" }
print(lo(a1, a2).v)
print(lo(b1, b2).s)
