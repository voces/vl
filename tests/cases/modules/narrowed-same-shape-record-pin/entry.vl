// @run
// @log RB
// @log RA
// @log RB
// @log RA
// @log RB
// @log RA
// A value narrowed by `is` to one of two same-shaped records pins a generic at that record, in
// either order, through a forwarding generic and in a lambda (D3869).
import { A, d } from "./r1"
import { B, d } from "./r2"

function h<T>(x: T): string { x.d() }
function fw<T>(x: T): string { h(x) }
const a: A = { x: 1 }
const b: B = { x: 2 }
function pick(i: i32): A | B {
  if i == 0 { a } else { b }
}
const u = pick(1)
if u is B { print(h(u)) }
const v = pick(0)
if v is A { print(h(v)) }
if u is B { print(fw(u)) }
if v is A { print(fw(v)) }
const f = () => {
  if u is B { h(u) } else { "?" }
}
const g = () => {
  if v is A { h(v) } else { "?" }
}
print(f())
print(g())
