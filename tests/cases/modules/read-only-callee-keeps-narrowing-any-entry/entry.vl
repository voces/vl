// @run
// @log The wolf guards.
// D5592: a callee summarised before its body is typed is not cached, so whether std:buffer's
// index operators are in the graph does not decide if `foeName` may write `i.kind`.
import { Buf } from "std:buffer"
import { foeActs } from "./turn"

foeActs([{ name: "wolf" }], { kind: "guard" })
