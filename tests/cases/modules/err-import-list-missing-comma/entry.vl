// @error expected `,` but found `b`
// @error expected `,` but found `c`
// CONTRACT (must-error): an import's name list separates its names with commas, on one line or
// across lines, as a list literal does (D14882).
import { a b } from "./m"
import {
  a as one
  c,
} from "./m"

print(a() + b() + one() + c())
