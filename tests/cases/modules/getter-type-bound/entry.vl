// @run
// @log 8
// @log 99
// @log 3
// A getter is found through the receiver's TYPE, in the module that declares the type — never
// by name. The entry imports `mk` only, not `twice`, and `v.twice` still resolves; the entry's
// own `const twice` and `function twice` neither shadow the getter nor collide with it, which is
// the D1984 hazard a lexically-resolved member would walk into (property-access-design.md §D3a).
import { mk } from "./lib"

const twice = 99
function twice2(self: i32): i32 { return self + 2 }

const v = mk(4)
print(v.twice)
print(twice)
print(1.twice2())
