// @error Duplicate binding "area"
// D1120's clause-2 half. Importing one name from two modules binds it to two
// different declarations — there is no answer, and the program is ILLEGAL. Until
// this diagnostic it was refused at a USE (`no field 'area' on Sq`): a message about
// a field, on a line that is not the mistake, naming neither module.
//
// Anchored at the SECOND import's name token. The same name from the SAME module
// (or through a re-export chain landing on the same declaration) still RUNS —
// redundant is not ambiguous, and the test is on the resolved merged target.
import { area, box } from "./a"
import { area, sq } from "./b"

print(box(5).area())
print(sq(3).area())
