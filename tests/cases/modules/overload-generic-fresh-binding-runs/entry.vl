// @run
// @log 1
// @log 10
// D14760: a fresh binding handed to a generic body's overloaded call is built at the `self` its
// instance picks, as the direct call builds it, when that pick writes nothing: `./b`'s `poke`.
import { W, poke } from "./a"
import { V, poke } from "./b"

function g<T>(v: T): i32 { v.poke() }
const i = { y: 2, x: 9 }
print(g(i))
print(i.x + 1)
