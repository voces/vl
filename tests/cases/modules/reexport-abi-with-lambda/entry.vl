// @run
// @log 2
// @log 4
// MODULE MODE for the export-ABI wrapper (#1264). The entry re-exports a dependency's
// concrete function and, separately, uses a lambda — so `fnValUsed` is set by the entry
// while the exported function comes from the dependency, under a MANGLED merged target
// name (`bump$m1`) that the alias tables map back to the public `bump`.
//
// That split is the reason the wrapper is keyed off the export ENTRY rather than off any
// property of the declaration: the wrapper set is built by the same
// `reExpName`/`reExpTarget` walk the export section itself uses (`exportTargetSlots`), so
// a re-exported, renamed or mangled target gets its wrapper exactly when it gets its export
// entry. `bump` publishes `(i32) -> i32`; before the fix it published
// `(structref, i32) -> i32`.
import { bump } from "./lib"

export { bump } from "./lib"

const h = (x: i32) => x * 2

print(bump(1))
print(h(2))
