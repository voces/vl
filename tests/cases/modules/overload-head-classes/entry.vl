// @run
// @log nothing
// @log string hi
// @log list of 3
// @log map of 1
// @log set of 1
// @log yes
// @log number 2.5
// @log fn giving 21
// @log point 7
// @log string nn
// Receiver overloading (owner ruling O1): one `describe` per head class, and a local one with
// no parameters, coexist because their first parameters differ in kind. A method call picks
// by the receiver's head; the plain call reaches the local one (lexical scope).
import { describe } from "./s"
import { describe } from "./a"
import { describe } from "./m"
import { describe } from "./st"
import { describe } from "./b"
import { describe } from "./n"
import { describe } from "./f"
import { Pt, describe } from "./r"

function describe() { "nothing" }

const p: Pt = { x: 7, y: 8 }
const m: {[string]: i32} = Map()
m["a"] = 1
const st: Set<string> = Set()
st.add("q")
const g = (v: i32) => v + 1
print(describe())
print("hi".describe())
print([1, 2, 3].describe())
print(m.describe())
print(st.describe())
print(true.describe())
print((2.5).describe())
print(g.describe())
print(p.describe())
// `?.` resolves on the type under the `?`.
const n: string | null = "nn"
const nd = n?.describe()
print(nd ?? "none")
