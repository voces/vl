// @run
// @log 007
// The `std:` scheme end to end: the specifier resolves VERBATIM as the module
// key and the reader layer maps it to `std/str.vl` (the repo dir in the TS
// host, $VL_STD / the exe-relative std dir in the native host). `std:str` is a
// real module with no host imports, so this needs nothing but resolution.
import { padStart } from "std:str"

print(padStart("7", 3, "0"))
