// @error-at 7:9 `export { sinF64 }` names an imported binding; re-export it with `export { sinF64 } from "std:math"`
// D3559: an export list with no `from` is refused (modules-design §2.1 has no local
// `export { … }` list), and refused for what it is. It used to be scanned as a
// re-export from the specifier "", which reported `Unsupported import specifier ""`.
// The message spells the re-export of the same binding; `reexport-std-kept-import`
// pins that the spelling it suggests runs.
import { sinF64 } from "std:math"
export { sinF64 }
print(sinF64(0.0))
