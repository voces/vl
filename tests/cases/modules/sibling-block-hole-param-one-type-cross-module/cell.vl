// The hole parameter lives HERE, so the pin has to cross a module boundary to reach the
// argument's binding — the shape glean's VL-042 had. It is not the ingredient: the same
// program with `hbase` in the entry refuses identically, which is what makes D1598 a
// module-frame table defect rather than a cross-module one.
export function hbase(b) { return b.base }
