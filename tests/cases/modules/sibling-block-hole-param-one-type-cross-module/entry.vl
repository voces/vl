// @emit-error emitProgram: field access receiver is not a struct
// D1598 — TWO SIBLING TOP-LEVEL BLOCKS BINDING ONE NAME MAKE THE HOLE PARAMETER'S PIN
// DECLINE, EVEN WHEN BOTH BINDINGS HAVE THE SAME TYPE. `moduleLocalLetOfUnique` answers
// -1 on any duplicated name because the table behind it is first-wins over a walk with no
// notion of which block a call site sits in (D1596). Where the candidates DISAGREE that
// decline is the safe answer; here they are both `{base: i32}`, so every candidate pins
// the same rep and the decline costs a working program: the instance takes the `"i32"`
// catch-all over a `(ref $type)` argument.
//
// Renaming either binding runs. One block runs. Both blocks inside a FUNCTION run — the
// module frame is the only scope whose block bindings have no lexical resolution here.
//
// The UFCS spelling of the same call is the CLAUSE-1 face, check-clean invalid wasm:
// `scripts/capability-probes/hole-param-sibling-blocks-of-one-type.vl`.
//
// When it is fixed this file prints `3` then `4`: flip the directive to `@run` and add the
// two `@log` lines.
import { hbase } from "./cell"

if true {
  const n = { base: 3 }
  print(n.base)
}

if true {
  const n = { base: 4 }
  print(hbase(n))
}
