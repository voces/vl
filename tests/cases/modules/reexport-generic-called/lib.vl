// `id` is re-exported AND instantiated by the entry; `snd` is re-exported by nobody and
// called by nobody, so it takes the routine no-op stub. Both live in one dependency so the
// case pins that the reject discriminates by ABI membership, not by "this module has an
// uncalled generic in it".
export function id<T>(x: T): T { return x }

export function snd<T>(a: T, b: T): T { return b }
