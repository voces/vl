// An imported module holding BOTH halves of the dispatch question: a free
// `self`-function `tag`, and a generic whose body calls `x.tag()` on a type
// parameter. The merge MANGLES both names (`tag` → `tag$mN`, `describe` →
// `describe$mN`) while leaving the member call's property plain, which is the
// axis the entry module cannot exercise on its own.
type Circle = { r: f64 }

export function tag(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

export function describe<T>(x: T): string { "<" + x.tag() + ">" }
