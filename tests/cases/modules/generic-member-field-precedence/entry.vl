// @run
// @log <fld>
// @hint redundant type annotation: `b` is inferred as `{r: f64, tag: () => string}` — remove it to lean on inference
// FIELD PRECEDENCE ACROSS THE MODULE BOUNDARY (silent-class-inventory D1002).
//
// The generic and the free `self`-function both live in `./shapes`, so the merge
// mangles both — and the member call's property stays PLAIN so field precedence
// can still resolve from the receiver shape (`ufcsAliasOf` bridges the two). This
// entry module supplies the receiver: a `Boxed` carrying `tag` as a closure FIELD.
//
// THE VALUE IS THE ASSERTION. `<fld>` means the field ran; `<C>` means the free
// `self`-function did, which is what this printed before the fix — a SILENT WRONG
// CALLEE with no diagnostic at any layer, not the invalid wasm the single-file
// spelling produces. A fixture that only proved the module builds would pass on
// the defect, and one that dropped `tag` from `./shapes` would pass for the wrong
// reason.
import { describe } from "./shapes"

type Boxed = { r: f64, tag: () => string }

const b: Boxed = { r: 1.0, tag: () => "fld" }
print(describe(b))
