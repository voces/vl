// The declaring module. `hidden` is NOT exported, and lib SPELLS it as a UFCS
// member call — that call is what banked the merge's old name-keyed
// `hidden → hidden$mN` row, and the row is what answered the entry (D1191).
export type Box = { v: i32 }

function hidden(self: Box): i32 { return self.v * 2 }

export function mk(v: i32): Box {
  const b: Box = { v: v }
  b.hidden()
  return b
}
