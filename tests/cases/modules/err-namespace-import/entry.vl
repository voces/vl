// @error-at 5:7 namespace imports (`import * as …`) are not supported — import the names you use: `import { A, B } from "./lib"` and drop the `S.` prefix
// DV-001 — `import * as S` bound nothing and the first `S.A` read as an undeclared `S`. The
// form is refused at its `*`, and the suggestion lists the members this file spells through
// the alias, first-seen order, once each — not a field read that happens to share its name (`o.S.z`).
// (A namespace import is an open design question, not a missing lowering.)
import * as S from "./lib"

print(S.A + S.B + S.A)
const o = { S: { z: 1 } }
print(o.S.z)
