// @run
// @log true
// @log 5
// @log 7
// @log 3
// @log 6
// @log 21
// D981: an `if`-EXPRESSION is an `IfStmt` node in VALUE position, so the merge's
// rename walker reaches it through `modRwExpr` — which had no arm for it and
// therefore never visited the condition or either arm. Every module-scope name an
// arm read kept its pre-merge spelling while its declaration renamed to `name$mN`,
// so ONE import anywhere in the file turned `f(e)` into `undeclared identifier 'f'`
// — a function declared three lines above, at module scope, before its use.
//
// The import below is deliberately UNUSED by the arms that matter: the trigger is
// the module being merged at all, not the imported name. Statement-`if`, `while`
// and a `match` arm body reach `modRwStmt` directly and always ran.
import { twice } from "./lib"

function f(x: i32) { return x }
const K = 7

// The filed witness: a value-`if` as a `return` operand.
function g(e: i32) {
  return if e > 0 { f(e) > 0 } else { false }
}

// A `let` initializer, and a module-scope `const` read from the ELSE arm.
function h(e: i32) {
  const v = if e < 0 { 0 } else { f(e) }
  const w = if e < 0 { 0 } else { K }
  return v + w - K
}

// An arm nested inside another arm, and a lambda that CAPTURES a module name.
function n(e: i32) {
  const c = if e > 0 { if e > 1 { () => f(e) } else { () => 1 } } else { () => 0 }
  return c()
}

// A top-level initializer, outside any function.
const top = if 1 > 0 { f(3) } else { 0 }

print(g(5))
print(h(5))
print(K)
print(top)
// An IMPORTED name inside an arm: it renames to `twice$m1`, so the arm had to be
// walked for the reference to follow it.
print(if top > 0 { twice(top) } else { 0 })
// A call argument, an array element and an object field are all the same position.
print(f(if top > 0 { 1 } else { 0 }) + [if top > 0 { 20 } else { 0 }][0])
