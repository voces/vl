// The dependency exists to make the entry a MERGED module — its export is read
// from inside an arm so the import is load-bearing in one position and scenery in
// the rest. Its own arms exercise the same rewrite one module out: `base` renames
// to `base$m1`, and an arm that never followed it would refuse here too.
const base = 2

function scale(x: i32): i32 {
  return if x > 0 { x * base } else { 0 }
}

export function twice(x: i32): i32 {
  scale(x)
}
