// The module the entry names but does not fully import (D1260/D1230).
export type Box = { v: i32 }

export function box(v: i32): Box { return { v: v } }

// The EXPORTED free `self`-function the entry calls without importing. This is
// the whole point of the fixture: the compiler can see it, the entry cannot.
export function area(self: Box): i32 { return self.v * self.v }

// An UN-exported self-function of the same shape. The export gate is the only
// thing keeping it out of the entry's suggestion, and naming it would send the
// reader to an import that cannot be written.
function hidden(self: Box): i32 { return self.v + 1 }

// `hidden`'s caller, and it is a DIRECT call on purpose. A UFCS spelling
// (`b.hidden()`) inside this module makes the merge bank a name-keyed
// `hidden → hidden$mN` alias, and the entry's own `b.hidden()` — which has no
// per-site alias of its own — then resolves through that fallback and compiles.
// That is a separate cross-module leak (the D1120 name-keyed fallback answering
// for a module that never imported the name); a member call here would make the
// entry's control silently measure it instead.
export function bump(b: Box): i32 { return hidden(b) }
