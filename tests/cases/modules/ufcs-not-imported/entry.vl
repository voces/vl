// @check
// @error-at 21:8 no field 'nosuch' on Box
// @error-at 24:8 no field 'hidden' on Box
// `area` is EXPORTED by "./lib", where `Box` is declared, so `box(5).area()` now resolves
// type-bound without importing `area` (§C) — in a call-result position and a declared-
// parameter position both. What REMAINS refused is the other half of this file, and both
// refusals are the design's: `nosuch` names no self-function anywhere, and `hidden` is an
// un-exported self-function of "./lib" — cross-module UFCS reaches only a module's public
// surface (the D1191 boundary), so no import would make it resolve.
import { Box, box, bump } from "./lib"

// EXPORTED in Box's home module — resolves type-bound (call-result receiver).
print(box(5).area())

// The same, with the receiver a declared PARAMETER rather than a call result.
function useIt(z: Box) { return z.area() }
print(useIt(box(3)))

const b = box(2)

// CONTROL: no field, no method, no self-function in any module of the graph.
print(b.nosuch())

// CONTROL: a self-function of "./lib" taking this receiver, but UN-exported.
print(b.hidden())

print(bump(b))
