// A host taking a function-typed parameter, with a local predicate read in a `while` header,
// under `!` and inside `&&` chains: the shape of the world generator that failed (D3713).

const LIMIT = 4

export function bake(alloc: (n: i32) => i32, ocean: i32[]): i32 {
  const drawn = (k: i32) => ocean[k] == 0 && k < LIMIT
  let s = 0
  let k = 0
  while k < ocean.length && !drawn(k) { k = k + 1 }
  while k < ocean.length && drawn(k) {
    s = s + alloc(k)
    k = k + 1
  }
  s
}
