// @run
// @log 12
// @log 102

// An imported host specialised for each callback passed to it keeps its local predicate a
// closure in every specialisation, so the program builds (D3713).

import { bake } from "./lib"

function scratch(n: i32) { n * 2 }

const ocean = [1, 0, 0, 0, 1]
print(bake(scratch, ocean))
print(bake((n: i32) => n + 32, ocean))
