// A `flat` record is EXPORTED, and its layout is read on both sides of the module
// boundary (webcraft P1.2).
//
// `export flat type` is why `modScan` in `driver.vl` had to learn the modifier.
// That scanner is TOKEN-LEVEL and runs before any parse, so it cannot ask the
// parser what it decided: it reads `export`, then the declaration keyword, then
// the NAME at a fixed offset. A contextual keyword sitting between `export` and
// `type` moves the name one token along, and until the scanner knew that, this
// declaration was not recorded as an export at all — a sibling importer got
// `"TValue" is not exported by "./lib"` on a line that plainly says `export`.
export flat type TValue = { value: i64, tt: i32, pad: i32 }
export flat type Node = { key: i32, val: i32 }

export function tvalueStride() { return TValue.size }
export function ttOffset() { return TValue.tt }
