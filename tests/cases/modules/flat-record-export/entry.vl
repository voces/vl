// @run
// @log 16
// @log 8
// @log 16
// @log 8
// @log 12
// @log 8
// @log 4
// @log 16
// A flat record's LAYOUT survives the module merge, and reads the same on both
// sides of the boundary (webcraft P1.2).
//
// The constants are folded in the CHECKER, which runs on the merged program — so
// an imported flat type is measured exactly once, after the merge has renamed
// whatever it renames, and the importing module reads the same numbers the
// defining module does. The first two lines below are the defining module's own
// answers (through exported functions); the rest are this module's, read directly
// off the imported name.
import { Node, TValue, ttOffset, tvalueStride } from "./lib"

print(tvalueStride()) // 16, computed in ./lib
print(ttOffset())     // 8,  computed in ./lib
print(TValue.size)    // 16, computed here
print(TValue.tt)      // 8
print(TValue.pad)     // 12
print(Node.size)      // 8
print(Node.val)       // 4
// And the imported layout still drives real address arithmetic.
print(TValue.size * 2 - Node.size * 2)
