// @run
// @log 5
// @log 6
// @log 6
// @log 4
// @log 3
// @log 6
// @log 9
// @log 6
// @log 9
// @log 7
// A member call at a type-parameter receiver resolves type-bound at each instance: `grow` is
// imported from neither module, and each instance reaches its own receiver's (D4033), in a
// nested function of the generic body too (D16383).
import { mk } from "./circle"
import { mkS } from "./square"

type P<T> = { a: T, b: T }

function f<T>(x: T, y: T): T { x.grow(y) }
function g<T>(xs: T[]): T { xs[0].grow(xs[1]) }
function h<T>(p: P<T>): T { p.a.grow(p.b) }
function k<T>(x: T, y: T): T {
  const c = () => x.grow(y)
  c()
}
function n<T>(x: T, y: T): T {
  function j(): T { x.grow(y) }
  j()
}
function v<T>(x: T) {
  const c = () => {
    x.show()
  }
  c()
}

print(f(mk(2), mk(3)).r)
print(f(mkS(2), mkS(3)).s)
print(g([mk(2), mk(4)]).r)
print(g([mkS(1), mkS(4)]).s)
print(h({ a: mk(1), b: mk(2) }).r)
print(h({ a: mkS(3), b: mkS(2) }).s)
print(k(mkS(3), mkS(3)).s)
print(k(mk(3), mk(3)).r)
print(n(mkS(3), mkS(3)).s)
v(mk(7))
