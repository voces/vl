// @run
// @log 2007
// @log 1012
// @log -1
// @log A
// @log 5
// @log B
// @log 105
// @log A
// @log 1
// @log B
// @log 107
// A member call in a generic body into a receiver-overload set is copied once per instance,
// and each copy chooses its own candidate as the original call would at that receiver
// (D4030): two scalar receivers, then two record receivers, each set with several instances.
import { A, app, pick } from "./a"
import { B, app, pick } from "./b"

function f<R, T>(r: R, xs: T[], g: (T) => i32) { r.app(xs, g) }
print(f(true, [7], (x: i32) => x))
print(f(5, [7], (x: i32) => x))
print(f(false, ["s"], (x: string) => x.length))

function p<R, T>(r: R, xs: T[], g: (T) => i32) { r.pick(xs, g) }
function q<R, T>(r: R, xs: T[]) { r.pick(xs, (_x: T) => 7) }
const a: A = { a: 1 }
const b: B = { b: "x" }
print(p(a, [5], (x: i32) => x))
print(p(b, [5], (x: i32) => x))
print(p(a, ["s"], (x: string) => x.length))
print(q(b, ["q"]))
