// @run
// @log 42
// A re-export carries TYPE names as well as functions: `mid` re-exports both the
// `Point` type and the `mk` constructor, and the entry annotates with the type it
// only ever saw through `mid`. Nothing in the re-export path is kind-aware (it
// records names), so this pins that the kind-blindness is the CORRECT behaviour and
// not an accident that a later change may narrow to functions.
import { Point, mk } from "./mid"

const p: Point = mk(40, 2)
print(p.x + p.y)
