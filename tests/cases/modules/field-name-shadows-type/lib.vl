// A top-level TYPE named `v`, and — in the same module — an inline object
// annotation with a FIELD named `v`. The merge renames every top-level name to
// `name$mN`; `modTypeRenamed` rewrote identifier SEGMENTS of the rendered
// annotation string, which cannot tell a type reference from a field name, so
// `{v:i32}` became `{v$m1:i32}` — a struct type with a field no literal has.
export type v = i32

export function mk(): { v: i32 } {
  const h: { v: i32 } = { v: 7 }
  h
}
