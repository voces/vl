// A receiver-overload set whose candidates return a type parameter an explicit argument binds is
// typed by that binding at a receiver each call supplies, and picks per instance (D4034).
import { pair, tag } from "./s"
import { pair, tag } from "./a"

function d<R, T>(r: R, v: T): T { return r.tag(v) }
function p<R>(r: R) { return r.pair(1, "z") }
function u<R>(r: R, v: i32) { return r.tag(v) + 1 }
print(d("a", 1))
print(d([1], "x"))
print(d("b", 2.5))
print(d([2], true))
print(p("a"))
print(u([1], 10))
