// @error `tag` names `tag` from "./shapes" (`A` first), `tag` from "./shapes" (`B` first) and `tag` from "./shapes" (`C` first), and a plain call does not choose between them — call it as a method, `x.tag(…)`, which picks by the receiver's type
// An imported set has no local declaration to answer a plain call, and an `as` alias cannot
// separate candidates that come from one module, so the method spelling is the only fix named.
import { A, tag } from "./shapes"

const a: A = { x: 1 }
print(tag(a))
