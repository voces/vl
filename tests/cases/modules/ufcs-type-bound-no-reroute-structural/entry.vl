// @run
// @log 30
// D1984's anti-hijacking half, with `ufcs-type-bound-no-reroute-structural-error` as its twin: a
// STRUCTURAL receiver never passes the caller's own `area` for its home module's. Here "./lib"'s
// `V` has the `y` a `Rect` needs, so the local `area` is called; the twin's `V` lacks it, and
// that call is an error, never "./lib"'s `area`. A field added to `V` cannot re-route the call.
import { V, mk } from "./lib"

type Rect = { x: i32, y: i32 }

function area(self: Rect): i32 { return self.x * self.y }

print(mk().area())
