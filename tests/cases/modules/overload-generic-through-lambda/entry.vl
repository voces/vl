// @run
// @log RA
// @log RB
// @log 2
// @log RB
// The spelling the function-value refusal names: an annotated lambda calls the generic, so each
// call is an instance that picks by its receiver.
import { A, d } from "./r1"
import { B, d } from "./r2"

function h<T>(x: T): string { x.d() }
function k(x) { x.d() == "RA" }
function ap<T>(f: (x: T) => string, v: T): string { f(v) }
const a: A = { x: 1 }
const b: B = { y: 2 }
print([a].map((x: A) => h(x))[0])
print(h(b))
print([a, a].filter((x: A) => k(x)).length)
print(ap((x: B) => h(x), b))
