// @error W does not satisfy `{mn(T):T}`: `.mn(…)` on W matches more than one of `mn` from "./a" (`A` first) and `mn` from "./b" (`B` first): the receiver's shape is declared under more than one name — rename one import with `as`
// A type two candidates of the set both take is refused as the member call itself would be,
// not as if no candidate existed.
import { A, mn } from "./a"
import { B, mn } from "./b"

type W = { v: i32, s: string }

function lo<T: { mn(T): T }>(x: T, y: T): T { return x.mn(y) }

const w1: W = { v: 1, s: "x" }
const w2: W = { v: 2, s: "y" }
print(lo(w1, w2).v)
