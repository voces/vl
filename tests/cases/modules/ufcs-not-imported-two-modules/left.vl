// One of two modules exporting a `label(self: Tag, …)` the entry does not import
// (D1260). Both take the SAME receiver, so both are real candidates.
export type Tag = { n: i32 }

export function tag(n: i32): Tag { return { n: n } }

export function label(self: Tag): string {
  if self.n > 0 { return "L+" }
  "L-"
}
