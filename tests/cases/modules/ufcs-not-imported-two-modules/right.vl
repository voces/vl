// The second candidate. It takes `left`'s `Tag`, so the two are interchangeable
// receivers and the choice between them is genuinely the author's to make.
import { Tag } from "./left"

export function label(self: Tag): string {
  if self.n > 0 { return "R+" }
  "R-"
}

// The entry imports THIS rather than `label`, which is what puts `./right` in
// the graph while leaving `label` out of scope — the shape the suggestion is for.
export function marker(): i32 { return 1 }
