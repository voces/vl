// @run
// @log L+
// @log 1
// The orphan rule: `Tag` is declared in "./left", so a type-bound `.label()` resolves in
// "./left" — "./right" also defines `label(self: Tag)`, but a foreign type is not its to
// extend, so its definition is reached only by an explicit import, never type-bound. The
// entry imports neither `label`; the call finds "./left"'s through `Tag`'s home module.
import { tag } from "./left"
import { marker } from "./right"

function main() {
  print(tag(1).label())
  print(marker())
}

main()
