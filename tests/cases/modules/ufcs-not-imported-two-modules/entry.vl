// @check
// @error-at 19:13 'label' is not imported — a free `label(self: …)` accepting Tag is exported by "./left", "./right"; a UFCS call resolves only names in scope, so import `label` from there
// D1230 — TWO CANDIDATE MODULES, ONE DIAGNOSTIC.
//
// The fix is a CHOICE between the two imports, not two independent problems, and
// a quick-fix offers one code action per listed module. Raising one diagnostic
// per candidate would stack two squiggles on the single `label` token and make
// the editor show the same fault twice.
//
// So the module list is a FIELD of one message — `"./left", "./right"` in the
// sentence, `./left,./right` in the `ufcs-not-imported` code's `modules=` — in
// the module graph's own dependency-first order, deduplicated.
//
// Both modules export a `label` taking `Tag`, and neither is imported by name,
// so both are live candidates. `right` imports `Tag` from `left`, which is what
// makes them the same receiver rather than two same-named accidents.
import { tag } from "./left"
import { marker } from "./right"

print(tag(1).label())

print(marker())
