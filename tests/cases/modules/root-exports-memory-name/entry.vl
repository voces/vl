// @run
// @log 42
// The root re-exports a dependency's function and exports two bindings, one named `memory`.
// This program uses linear memory, so the memory takes that name and the binding is not
// published; an armed link that publishes every root export lists `memory` twice.
import { Buffer, loadI32, storeI32 } from "std:buffer"
export { twice } from "./lib"

export let memory = 7
export let count = 3
export function area(w: i32, h: i32): i32 { w * h }
const b = Buffer(8)
storeI32(b, 0, memory)
print(twice(loadI32(b, 0)) * count)
