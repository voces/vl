// @run
// @log RA4
// @log 4
// @log 4.5
// An un-annotated callback over a list of a record the entry never names, calling a generic
// (D3820). Two modules each declare a private `A` of a different shape, and each lambda pins
// at its own.
import { d, mk } from "./r1"
import { mk2 } from "./r2"

function h<T>(x: T): string { x.d() }
function id<T>(x: T): T { x }
print(mk().map((x) => h(x))[0])
print(mk().map((x) => id(x))[0].x)
print(mk2().map((x) => id(x))[0].y)
