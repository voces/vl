// @run
// @log 30
// The orphan rule at work across modules: `Money`'s `+` lives in `money.vl`, its declaring
// module, and this module imports the TYPE and a constructor but not the operator by name.
// Operator declarations are un-exportable and merge program-wide, so `a + b` here dispatches
// to `money.vl`'s `+@Money` by the left operand's type — the cross-module half the receiver
// keying already delivers once the type's module is in the graph (step 1 + merge).
import { mkMoney } from "./money"

function main() {
  const a = mkMoney(10)
  const b = mkMoney(20)
  const t = a + b
  print(t.cents)
}

main()
