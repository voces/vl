import { used } from "./home"

export { passed } from "./home"

// A SECOND re-export statement naming the same source module, further down the
// file — and the name it publishes is one `mid` also CALLS below.
export { alsoPassed } from "./home"

export function midCalls(n: i32): i32 { return used(n) * 10 }

export function midCallsReexported(n: i32): i32 { return alsoPassed(n) + 1 }
