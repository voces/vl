// @run
// @log 2
// @log q
// A structural bound is satisfied by an overload set's candidate for the instance type, as the
// call `x.mn(y)` itself resolves, not by whichever candidate was imported first.
import { A, mn } from "./a"
import { B, mn } from "./b"

function lo<T: { mn(T): T }>(x: T, y: T): T { return x.mn(y) }

const a1: A = { v: 3 }
const a2: A = { v: 2 }
const b1: B = { s: "xyz" }
const b2: B = { s: "q" }
print(lo(a1, a2).v)
print(lo(b1, b2).s)
