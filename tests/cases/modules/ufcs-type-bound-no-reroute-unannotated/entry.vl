// @run
// @log 6
// An un-annotated `self` keeps the call (D1984): the local `f` is chosen for "./lib"'s `V` by
// name, never by what its body reads. `ufcs-type-bound-no-reroute-unannotated-error` is the
// same call after the body is edited to read a field `V` lacks: it errors, and is not handed to
// "./lib"'s exported `f`.
import { V, mk } from "./lib"

function f(self) { return self.x + 1 }

print(mk().f())
