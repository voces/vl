// @run
// @log 14
// @log -3
// @log 1
// @log 1
// @log 11
// @log -2
// @log 20
// @log b
// D1984: on a NEWTYPE receiver, a same-named `self`-function in the caller's scope whose
// `self` is annotated with a different declared type steps aside for the receiver type's home
// module. `dot` (imported, on `V2`), `cross` and `normalize` (local, on `V2`) and `lane`
// (local, on `string`) stay callable on their own receivers; `F32x4` and `Vec` reach home.
import { f32x4, storeF32x4 } from "std:simd"
import { Buffer } from "std:buffer"
import { V2, dot } from "./vec2"
import { mkVec } from "./lanes"

function cross(self: V2, o: V2): f64 { return self.x * o.y - self.y * o.x }

function normalize(self: V2): V2 { return { x: 1.0, y: 0.0 } }

function lane(self: string, i: i32): string { return self.slice(i, i + 1) }

const a = f32x4(1.0, 2.0, 3.0, 0.0)
print(a.dot(a))
const buf = Buffer(32)
buf.storeF32x4(0, a.cross(f32x4(0.0, 1.0, 0.0, 0.0)))
buf.storeF32x4(16, f32x4(0.0, 0.0, 2.0, 0.0).normalize())
print(buf.loadF32(0))
print(buf.loadF32(8))
print(buf.loadF32(24))
const v: V2 = { x: 1.0, y: 2.0 }
const w: V2 = { x: 3.0, y: 4.0 }
print(v.dot(w))
print(v.cross(w))
print(mkVec(10, 20).lane(1))
print("abc".lane(1))
