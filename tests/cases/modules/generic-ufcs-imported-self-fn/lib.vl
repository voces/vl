// Imported `self`-functions whose results mention the type parameter (D4030).
export function at2<T>(self: T[], i: i32): T { self[i] }

export function twice<T>(self: T[]): T[] {
  const out: T[] = []
  for x in self { out.push(x) }
  for x in self { out.push(x) }
  out
}

export function wrapped<T>(self: T): T[] { [self] }
