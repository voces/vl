// @run
// @log 2
// @log q
// @log 2
// @log 4
// @log 4.5
// @log 1
// @log 1
// @log 3
// D4030 — a member call in a generic body to an imported `self`-function, whose result
// mentions the type parameter, is copied per instance; the copy resolves as the original.
import { at2, twice, wrapped } from "./lib"
import { indexOf, reverse, sorted } from "std:array"

function a<T>(xs: T[]): T { xs.at2(1) }
function b<T>(xs: T[]): T[] { xs.twice().reverse() }
function c<T>(x: T): T[] { x.wrapped() }
function d<T>(xs: T[], v: T): i32 { xs.twice().indexOf(v) }
function e<T>(xs: T[], lt: (T, T) => boolean): T { xs.sorted(lt)[0] }
function flip<T>(xs: T[]): T[] { xs.reverse() }

print(a([1, 2, 3]))
print(a(["p", "q"]))
print(b([1, 2])[0])
print(b(["x", "y"]).length)
print(c(4.5)[0])
print(d([7, 8], 8))
print(e([3, 1, 2], (p: i32, q: i32) => p < q))
print(flip([1, 2, 3])[0])
