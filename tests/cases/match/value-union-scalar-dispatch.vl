// @run
// @log 6
// @log hey
// @log int
// @log str
// `match` over a SCALAR union (`i32 | string`) — master: "match scrutinee must be a literal
// union, got i32 | string". The arms narrow to the primitive, so `u + 1` (i32 arithmetic) and
// returning `u` where a `string` is wanted both type: the arm's binding is the narrowed one,
// not the union.
type U = i32 | string

function bump(u: U): string {
  match u {
    i32 => toString(u + 1)
    string => u
  }
}

function kind(u: U): string {
  match u {
    string => "str"
    i32 => "int"
  }
}

print(bump(5))
print(bump("hey"))
print(kind(5))
print(kind("x"))
