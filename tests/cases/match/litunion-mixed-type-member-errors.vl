// @check
// @error-at 10:4 match pattern "b" is not a member of "a" | i32
// @error-at 17:4 redundant match arm: "a" is already covered
// @error-at 22:2 non-exhaustive match — missing i32 (add the arm or a `_`)
// @error-at 29:4 match pattern `2` is not a member of "a" | 1
// @error-at 34:2 non-exhaustive match — missing 1 (add the arm or a `_`)
// Over a union mixing literal members with a type member, an arm is checked like any other:
// a literal that is not a member, a repeated literal, and a missing member are each named (D5714).
function a(k: "a" | i32): i32 {
  match k {
    "b" => 1
    _ => 2
  }
}
function b(k: "a" | i32): i32 {
  match k {
    "a" => 1
    "a" => 3
    _ => 2
  }
}
function c(k: "a" | i32): i32 {
  match k {
    "a" => 1
  }
}
function d(k: "a" | 1): i32 {
  match k {
    1 => 1
    2 => 2
    "a" => 3
  }
}
function e(k: "a" | 1): i32 {
  match k {
    "a" => 1
  }
}
print(a(1) + b(1) + c(1) + d(1) + e(1))
