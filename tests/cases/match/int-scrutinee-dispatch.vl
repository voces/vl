// @run
// @log 14
// @log 22
// @log 99
// @log -1
// @log zero
// @log other
// @log z
// @log big
// @log ?
// @log m2
// @log two
// @log 30
// @log 30
// @hint redundant type annotation: `len` is inferred as `i32`
// @hint redundant type annotation: `wide` is inferred as `string`
// `match` over an INTEGER scrutinee (D1572, glean VL-020) — arms are integer LITERALS of the
// scrutinee's type plus the mandatory `_`. Exercises: a value-returning match and a
// statement-position one, a hex lexeme, a NEGATIVE literal arm, an `i64` scrutinee (whose arms
// are i32 literals reaching it by the widening lattice), a match at MODULE scope as well as
// inside a function, the `_` arm actually reached, an expression-position match bound to a
// `const`, and an or-group arm (`match`'s existing arm separator, not new pattern syntax).

function len(id: i32): i32 {
  match id {
    0x10 => 14
    0x11 => 22
    -1 => 99
    _ => -1
  }
}

function name(id: i32) {
  match id {
    0 => { print("zero") }
    1 => { print("one") }
    _ => { print("other") }
  }
}

function wide(x: i64): string {
  match x {
    0 => "z"
    4294967296 => "big"
    _ => "?"
  }
}

function span(id: i32) {
  match id {
    0x12 | 0x13 => 30
    _ => 0
  }
}

print(len(0x10)) // 14
print(len(0x11)) // 22
print(len(-1)) // 99
print(len(7)) // -1 (the wildcard)
name(0) // zero
name(5) // other (the wildcard)
print(wide(0)) // z
print(wide(4294967296)) // big
print(wide(3)) // ? (the wildcard)

const k = 2
match k {
  1 => print("m1")
  2 => print("m2")
  _ => print("mx")
}
const v = match k { 2 => "two", _ => "?" }
print(v) // two
print(span(0x12)) // 30
print(span(0x13)) // 30
