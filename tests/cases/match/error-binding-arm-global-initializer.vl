// @emit-error an if-expression arm that declares a local is supported only as a binding initializer
// The second unsupported position for a binding arm: a TOP-LEVEL binding. A top-level `const` is
// a module GLOBAL, not a local, so the start function's local collection never walks its
// initializer and the arm's `const a` has no slot. Rejected loudly rather than lowered against
// whatever slot the cursor happened to be at.
//
// The supported spelling wraps it in a function, which is where locals live.
type A = { a: i32 }
type B = { b: i32 }
type U = A | B

const u: U = { a: 11 }
const r = match u { A{a} => a, B{b} => b }
print(r)
