// @run
// @log 20
// @log 40
// A match arm whose integer pattern is negative starts a new arm, not a subtraction from the
// previous arm's body, even inside a call's parentheses where a leading `-` otherwise
// continues the line (D3699).
const x = -1
print(
  match x {
    1 => 10
    -1 => 20
    _ => 30
  },
)

const y = -2
print(
  match y {
    1 => 10
    -1 | -2 => 40
    _ => 30
  },
)
