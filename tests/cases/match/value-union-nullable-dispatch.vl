// @run
// @log 7
// @log 0
// @log 8
// @log -1
// @hint redundant type annotation: `declared` is inferred as `i32`
// @hint redundant type annotation: `inline` is inferred as `i32`
// A union with a `null` member, in BOTH spellings — and they are different arena shapes: a
// DECLARED `type U = A | null` interns as a `TyUnion` with a `null` member, while an INLINE
// annotation `A | B | null` interns as a `TyNullable`. Admission walks `flattenVariantsInto`,
// which flattens either into the same variant list, so both spell the same arms and `null` is
// a member the exhaustiveness check demands like any other. Master rejects both.
type A = { a: i32 }
type B = { b: i32 }
type U = A | null

function declared(u: U): i32 {
  match u {
    A => u.a
    null => 0
  }
}

function inline(u: A | B | null): i32 {
  match u {
    A => u.a
    B => u.b
    null => 0 - 1
  }
}

print(declared({ a: 7 }))
print(declared(null))
print(inline({ b: 8 }))
print(inline(null))
