// @check
// @error-at 20:2 non-exhaustive match — missing C (add the arm or a `_`)
// EXHAUSTIVENESS is the whole point of matching a value union: the `is`-chain this lowers to
// is not checked for completeness, so a member that grows a new arm-less home fails only at
// runtime ("no interned slot"). Here it is a compile ERROR — the same rule phase 1 shipped for
// literal unions, and the same wording, with the missing member rendered from the ARENA member
// type rather than a spelling.
//
// The missing member is named, not just counted. Note the arm bodies do NOT also report: the
// last arm is the chain's bare `else`, whose narrowing is the residual `B | C`, but a
// non-exhaustive match is already refused, so the arm is checked under the type it NAMES and
// the one root cause stands alone.
type A = { a: i32 }
type B = { b: i32 }
type C = { c: i32 }
type U = A | B | C
function pick(u: U): i32 {
  match u {
    A => u.a
    B => u.b
  }
}
print(pick({ a: 1 }))
