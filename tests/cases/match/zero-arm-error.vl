// @check
// @error-at 16:9 non-exhaustive match — missing "a", "b" (add the arm or a `_`)
// @error-at 19:9 non-exhaustive match — missing A, B (add the arm or a `_`)
// A ZERO-arm `match` — the parser accepts `match k {}` — used to TRAP THE COMPILER: the desugar
// takes the wildcard arm (or, failing that, the LAST arm) as the chain's bare `else`, and with
// no arms at all that read is `bodies[-1]`. On master the literal-union line below dies as a
// bare `wasm trap: out of bounds array access` with no diagnostic and no position; the
// value-union line was not reachable there (the scrutinee gate refused it first) and would have
// been a second door to the same trap.
//
// Both now report the missing members, which is the true statement: zero arms cover nothing.
type K = "a" | "b"
type A = { a: i32 }
type B = { b: i32 }
type U = A | B
const k: K = "a"
match k {}

const u: U = { a: 1 }
match u {}
