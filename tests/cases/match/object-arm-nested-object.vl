// @run
// @log 3
// @log 3
// @log 4
// A `match` arm whose braces hold an object with a nested shorthand object, `{ a: { b } }`, is
// that object, parenthesized or not; a lone `{ b }` is still a block whose tail is `b` (D3276).
function g(b: i32) {
  match b {
    3 => ({ a: { b: b } })
    _ => ({ a: { b: b } })
  }
}
print(g(3).a.b)
function h(b: i32) {
  match b {
    3 => { a: { b: b } }
    _ => { a: { b: b } }
  }
}
print(h(3).a.b)
function tail(b: i32) {
  match b {
    _ => {
      b
    }
  }
}
print(tail(4))
