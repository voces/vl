// @check
// @error member access '.a' on non-object i32; the braces at 15:10 are a block, not an object literal; parenthesize an object there: `({ … })`
// @error cannot bind the void result of 'x' — a void function returns no value
// A `match` arm's braces are always a block, so `{ a: { b } }` there is a labelled block whose
// value is its tail `b`; the use that trips on its value names the parentheses (D3276).
function g(b: i32) {
  match b {
    3 => ({ a: { b: b } })
    _ => ({ a: { b: b } })
  }
}
print(g(3).a.b)
function h(b: i32) {
  match b {
    3 => {
      a: { b }
    }
    _ => {
      a: { b }
    }
  }
}
print(h(3).a.b)
// A control: an error whose subject is not such an arm's value takes no note, and an empty
// `{}` is a block that is never recorded.
function k() {}
function m(c: boolean) {
  if c {
    L: { c }
  }
  if c {}
  const x: i32 = k()
  print(x)
}
