// @check
// @error cannot bind the void result of 'v' — a void function returns no value; the braces at 14:10 are a block, not an object literal; parenthesize an object there: `({ … })`
// A `match` arm's braces are always a block, so `{ a: { b } }` there is a labelled block and
// the arm is `void`; the use that trips on it names the parentheses (D3276).
function g(b: i32) {
  match b {
    3 => ({ a: { b: b } })
    _ => ({ a: { b: b } })
  }
}
print(g(3).a.b)
function h(b: i32) {
  match b {
    3 => {
      a: { b }
    }
    _ => {
      a: { b }
    }
  }
}
const v = h(3)
