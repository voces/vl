// @run
// @log 1
// @log 0
// @log 0
// @log 3
// @log 1
// @log 1
// @hint redundant type annotation: `only` is inferred as `i32`
// @hint redundant type annotation: `grouped` is inferred as `i32`
// The two arm forms that are NOT one-member-one-arm, over a value union.
//
// `_` — allowed, never required. It satisfies exhaustiveness for the members no arm names,
// and (as in phase 1) it becomes the chain's bare `else` wherever it is written.
//
// `A | B => …` — an OR-pattern of TYPES. It stays TWO patterns (`(u is A) || (u is B)`), not
// one union-typed pattern: a single `is` against a union check type does not lower at all
// (`emitProgram: \`is\` names a type that is not a union variant`, master included). An
// OR-arm's body sees the UNnarrowed scrutinee, exactly as the `||` guard it lowers to does.
type A = { a: i32 }
type B = { b: i32 }
type C = { c: i32 }
type U = A | B | C

function only(u: U): i32 {
  match u {
    A => u.a
    _ => 0
  }
}

function grouped(u: U): i32 {
  match u {
    C => u.c
    A | B => 1
  }
}

print(only({ a: 1 }))
print(only({ b: 2 }))
print(only({ c: 3 }))
print(grouped({ c: 3 }))
print(grouped({ a: 1 }))
print(grouped({ b: 2 }))
