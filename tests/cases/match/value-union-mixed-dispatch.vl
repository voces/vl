// @run
// @log obj:4
// @log int:6
// @log str:hey
// @log inner-b
// @hint redundant type annotation: `tag` is inferred as `string`
// @hint redundant type annotation: `outer` is inferred as `string`
// A MIXED union — a struct member beside two scalars (`Box | i32 | string`) — plus a NESTED
// `match` inside an arm over a different union. Master rejects both with "match scrutinee must
// be a literal union". The nested case is the one that would break if the per-arm narrowing
// were global rather than scoped: the inner match's arm scope must not leak past its `}`.
type Box = { n: i32 }
type U = Box | i32 | string

function tag(u: U): string {
  match u {
    Box => "obj:" + toString(u.n)
    i32 => "int:" + toString(u + 1)
    string => "str:" + u
  }
}

type A = { a: i32 }
type B = { b: i32 }
type Inner = A | B

function outer(u: U, i: Inner): string {
  match u {
    Box => {
      match i {
        A => "inner-a"
        B => "inner-b"
      }
    }
    i32 => "n"
    string => u
  }
}

print(tag({ n: 4 }))
print(tag(5))
print(tag("hey"))
print(outer({ n: 1 }, { b: 2 }))
