// @emit-error an if-expression arm that declares a local is supported only as a binding initializer
// A binding arm in value position is lowered only where the COLLECT pass walked it — a binding
// initializer or a `return` operand. Here the `match` is an ARGUMENT, so its arms' `const`s were
// never allocated a local slot, and lowering them anyway would claim slots belonging to other
// bindings. The emitter says so instead: a loud reject, not a wrong answer.
//
// The supported spelling is one line longer:  `const r = match u { … }` then `print(r)`.
type A = { a: i32 }
type B = { b: i32 }
type U = A | B

function show(u: U) {
  print(match u { A{a} => a, B{b} => b })
  0
}

print(show({ a: 7 }))
