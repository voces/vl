// @run
// @log k is-a k
// @log 1 2
// @hint Intentionally-unused parameter `_y` (leading `_` marks it unused)
// @warning Unused variable `Circle` (prefix with `_` to suppress, or remove it)
// A name that is both a type and a constant (D3271). Over a value scrutinee (an integer or a
// literal union) no type but `null` is a pattern, so the constant the name reaches wins: a
// local constant over a module type, and a module constant over a type parameter. Over a union
// of types the arms are types, so the type wins and a same-named local constant is not an arm —
// it is unused, and the lint says so.
type K = { a: i32 }
type L = "a" | "b"
type P = { z: i32 }
type Circle = { r: i32 }
type Square = { s: i32 }
const T = 3

function overInt(x: i32) {
  const K = 3
  match x {
    K => "k"
    _ => "other"
  }
}

function overLit(x: L) {
  const P = "a"
  match x {
    P => "is-a"
    _ => "other"
  }
}

function overParam<T>(x: i32, _y: T) {
  match x {
    T => "k"
    _ => "other"
  }
}

function overUnion(x: Circle | Square) {
  const Circle = 5
  return match x {
    Circle => 1
    _ => 2
  }
}

print("\{overInt(3)} \{overLit("a")} \{overParam(3, "s")}")
const c = { r: 1 }
const s = { s: 1 }
print("\{overUnion(c)} \{overUnion(s)}")
