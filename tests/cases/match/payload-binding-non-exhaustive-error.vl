// @check
// @error-at 19:3 non-exhaustive match — missing {target: string} (add the arm or a `_`)
// @error-at 25:3 non-exhaustive match — missing {target: string} (add the arm or a `_`)
// EXHAUSTIVENESS is not weakened by the new arm form. A binding arm covers exactly what its
// pattern covers, so dropping one is the SAME hard error phase 1 shipped, with the SAME wording
// and at the same position — the two functions below differ only in whether the surviving arm
// binds its payload, and they must produce identical diagnostics.
//
// This is the pin for the property the clause could most easily have broken: a payload clause is
// read off `matchBinds`, a column parallel to `matchPats`, and coverage is decided from
// `matchPats` alone — so no clause can mark a member covered.
type Move = { x: i32, y: i32 }
type Attack = { target: string }
type Cmd = Move | Attack

function withoutBinding(c: Cmd) {
  match c {
    Move => c.x
  }
}

function withBinding(c: Cmd) {
  match c {
    Move{x, y} => x + y
  }
}

print(withoutBinding({ x: 1, y: 2 }))
print(withBinding({ x: 1, y: 2 }))
