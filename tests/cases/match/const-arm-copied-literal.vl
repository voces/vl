// @run
// @log 1
// @log 0
// @log 1
// A `const` that copies a literal `const` by name holds that literal, as if it were written
// there, so it is an arm like the original (D3246).
const A = 1
const A2 = A
function alias(k: i32) {
  match k {
    A2 => 1
    _ => 0
  }
}
print(alias(1))
print(alias(2))
function local(k: i32) {
  const L = A2
  match k {
    L => 1
    _ => 0
  }
}
print(local(1))
