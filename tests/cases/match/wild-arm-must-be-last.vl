// @check
// @error unreachable match arm — the `_` wildcard must be the last arm
// @error unreachable match arm — the `_` wildcard must be the last arm
// @error unreachable match arm — the `_` wildcard must be the last arm
// An arm after the `_` would test first once the wildcard lowers to the bare `else`, over a
// literal union, its nullable spelling and a union of records alike (D5288).
type Wide = "a" | "b" | "c"
type A = { a: i32 }
type B = { b: string }
function lit(k: Wide): i32 {
  match k {
    _ => 2
    "c" => 3
  }
}
function nul(k: Wide | null): i32 {
  match k {
    "a" => 1
    _ => 2
    null => 3
  }
}
function rec(x: A | B): i32 {
  match x {
    _ => 1
    B => 2
  }
}
print(lit("c"))
print(nul(null))
print(rec({ b: "q" }))
