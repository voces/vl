// @check
// @error argument 1: expected "red" | "green", got string
// D1885: a `match` over an un-annotated parameter asks the call that pins it the argument
// question its arm union would ask as an annotation, so a pin the arms do not cover is refused
// at the call, as `p: "red" | "green"` refuses it. A `_` arm would take the rest.
function color(p) {
  match p {
    "red" => print(1)
    "green" => print(0)
  }
}
const s: string = "blue"
color(s)
