// @check
// @error a payload clause reads fields, so `inner: Circle{…}` is not a pattern here — bind the field with `inner: Circle` and test it with `is` in the arm body
// @error `p: {}` binds nothing — drop it, or name the fields to bind inside it
// @error `x:` in a payload clause takes a binding name (`x: n`) or a nested clause (`x: {…}`)
// @error `Go{}` binds nothing — write `Go`
// @error `Halt{}` binds nothing — write `Halt`
// What the richer clause forms refuse at the PARSE tier. A separate file from the checker's
// refusals because a parse error stops the pipeline, so the two tiers cannot be graded together.
//
//   · a nested TYPE pattern. A clause READS a field; a type before the brace would TEST it, so
//     the arm would stop covering its own variant and the exhaustiveness the whole construct
//     exists for would need a rule nothing has ruled. Refused by name, naming what works today.
//   · an empty clause, nested or top-level. `p: {}` reads a field and binds nothing, and leaves
//     the formatter no declaration to print it back from; `Go{}` binds nothing either, and means
//     exactly the bare `Go`. One spelling per meaning, so each refusal names the form to write.
//   · `field:` with neither a binding name nor a nested clause after it.
type Circle = { r: i32 }
type Square = { s: i32 }
type Shape = Circle | Square
type Boxed = { inner: Shape }
type Plain = { z: i32 }
type B = Boxed | Plain

function nestedTypePattern(b: B): i32 {
  match b {
    Boxed{inner: Circle{r}} => r
    Plain{z} => z
  }
}

type Pt = { x: i32, y: i32 }
type Wrap = { p: Pt, tag: i32 }
type Other = { z: i32 }
type W = Wrap | Other

function emptyNested(w: W): i32 {
  match w {
    Wrap{p: {}} => 0
    Other{z} => z
  }
}

type Move = { x: i32, y: i32 }
type Stop = { z: i32 }
type Cmd = Move | Stop

function colonWithNothing(c: Cmd): i32 {
  match c {
    Move{x: , y} => y
    Stop{z} => z
  }
}

type Go = { g: i32 }
type Halt = { h: i32 }
type Sig = Go | Halt

function emptyTopLevel(s: Sig): i32 {
  match s {
    Go{} => 0
    Halt {} => 1
  }
}

print(nestedTypePattern({ z: 1 }))
print(emptyNested({ z: 1 }))
print(colonWithNothing({ z: 1 }))
print(emptyTopLevel({ h: 1 }))
