// @check
// @error MODE is always "debug" here, so this arm never runs. If MODE can take other values, declare them: const MODE: "debug" | "release" = "debug"
// A `const`'s literal type is declared by its initialiser, so an arm it can never match is an
// error, which names the declaration that admits it (owner ruling 2026-11-12).
const MODE = "debug"
match MODE {
  "debug" => print("d")
  "release" => print("r")
}
