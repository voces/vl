// @check
// @error redundant match arm: `DUP` (1) is already covered
// @error redundant match arm: `A` (1) is already covered
// @error a match arm needs a literal or a constant; `B` has no literal value — declare it with a number or string literal, or test it with `==`
// @error a match arm needs a literal or a constant; `x` is a variable, not a `const`
// @error a match arm needs a literal or a constant; `V` is a variable, not a `const`
// @error a match arm needs a literal or a constant; `p` is a variable, not a `const`
// @error a match arm needs a literal or a constant; `fnc` is a function
// @error unknown name `MISSING` in match pattern — an arm is a literal, a `const` with a literal value, or the `_` wildcard
// @error match pattern type mismatch: expected i32, found "a"
// @error match pattern type mismatch: expected i32, found f64
// @error a match arm needs a literal or a constant; `C` is not a number or string constant
// @error non-exhaustive match — an integer `match` needs a `_` arm
// @error match pattern `A` is a value, not a type — a pattern over i32 | string is a member type or the `_` wildcard
// What an integer scrutinee refuses where an arm names something (D3271): a constant whose
// value another arm already claimed (whichever spelling came first), a constant computed from
// other constants, anything that is not a `const` (a `let`, a parameter, a function), a name
// that resolves to nothing — a hard error, never a catch-all binding — and a constant whose
// literal is not an integer. A constant arm needs the `_` an integer match always does, and a
// value union's arms are member types, so a constant there is named as the value it is.
const A = 1
const B = A + 1
const S = "a"
const DUP = 1
const F = 1.5
const C = 'x'
let V = 3
V = 4

function fnc() { 0 }

function dup(k: i32) {
  match k {
    A => 1
    DUP => 2
    _ => 0
  }
}

function dupLit(k: i32) {
  match k {
    1 => 1
    A => 2
    _ => 0
  }
}

function folded(k: i32) {
  match k {
    B => 1
    _ => 0
  }
}

function letLocal(k: i32) {
  let x = 4
  x = 5
  match k {
    x => 1
    _ => 0
  }
}

function letModule(k: i32) {
  match k {
    V => 1
    _ => 0
  }
}

function param(k: i32, p: i32) {
  match k {
    p => 1
    _ => 0
  }
}

function func(k: i32) {
  match k {
    fnc => 1
    _ => 0
  }
}

function unknown(k: i32) {
  match k {
    MISSING => 1
    _ => 0
  }
}

function strOverInt(k: i32) {
  match k {
    S => 1
    _ => 0
  }
}

function floatOverInt(k: i32) {
  match k {
    F => 1
    _ => 0
  }
}

function charConst(k: i32) {
  match k {
    C => 1
    _ => 0
  }
}

function noWild(k: i32) {
  match k {
    A => 1
  }
}

function valueUnion(v: i32 | string) {
  match v {
    A => 1
    _ => 2
  }
}

print(
  dup(1)
    + dupLit(1)
    + folded(1)
    + letLocal(1)
    + letModule(1)
    + param(1, 2)
    + func(1),
)
print(unknown(1) + strOverInt(1) + floatOverInt(1) + charConst(1))
print(noWild(1))
print(valueUnion(1))
