// @run
// @log 7
// @log 0
// A binding arm in value position as an ARGUMENT: its arms' `const`s are allocated by node
// wherever the collect pass finds the expression, not only at a binding initializer (D2785).
type A = { a: i32 }
type B = { b: i32 }
type U = A | B

function show(u: U) {
  print(
    match u {
      A{a} => a
      B{b} => b
    },
  )
  0
}

print(show({ a: 7 }))
