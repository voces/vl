// @run
// @log 5
// @log true
// @log s
// @log 9
// @log 3
// @log true
// @log 7
// @log 1
// @log 2
// @log 101
// @log 202
// @log 303
// @log 1
// @log 0
// @log 1
// @log -1
// The payload types a binding must carry, and the arm FORMS a clause appears in. One file so a
// regression in any one cell is one red test.
//
// PAYLOAD TYPES: i32, f64, string, a nested struct, a list, and a nullable — a binding is an
// ordinary `const`, so it takes whatever the field's type is; nothing here is a binding-specific
// code path, which is the point.
type K = { k: i32 }
type Pi = { pi: i32 }
type Pf = { pf: f64 }
type Ps = { ps: string }
type Pk = { pk: K }
type Pl = { pl: i32[] }
type Pn = { pn: string | null }
type Pw = { pw: i32 }
type P = Pi | Pf | Ps | Pk | Pl | Pn | Pw

function payload(p: P): string {
  match p {
    Pi{pi} => toString(pi)
    Pf{pf} => toString(pf > 1.0)
    Ps{ps} => ps
    Pk{pk} => toString(pk.k)
    Pl{pl} => toString(pl.length)
    Pn{pn} => toString(pn == null)
    Pw{pw} => toString(pw)
  }
}

print(payload({ pi: 5 }))
print(payload({ pf: 2.5 }))
print(payload({ ps: "s" }))
print(payload({ pk: { k: 9 } }))
print(payload({ pl: [1, 2, 3] }))
print(payload({ pn: null }))
print(payload({ pw: 7 }))

// ARM FORMS. A clause may bind a SUBSET of the variant's fields (`A{a}` ignores `extra`), may be
// EMPTY (`B{}` binds nothing and is not an error), and may sit beside a payload-free arm.
type A = { a: i32, extra: string }
type B = { b: i32 }
type AB = A | B

function subsetAndEmpty(v: AB): i32 {
  match v {
    A{a} => a
    B{} => 2
  }
}

print(subsetAndEmpty({ a: 1, extra: "x" }))
print(subsetAndEmpty({ b: 9 }))

// ALIASING: the same field name on every variant (at the same type — a shared name at DIFFERENT
// types is refused for the whole union by the emitter, before `match` is involved). Each arm's
// `v` is its OWN binding, scoped to its own arm.
type Sa = { v: i32, a: i32 }
type Sb = { v: i32, b: i32 }
type Sc = { v: i32, c: i32 }
type S = Sa | Sb | Sc

function aliased(s: S): i32 {
  match s {
    Sa{v, a} => v * 100 + a
    Sb{v, b} => v * 100 + b
    Sc{v, c} => v * 100 + c
  }
}

print(aliased({ v: 1, a: 1 }))
print(aliased({ v: 2, b: 2 }))
print(aliased({ v: 3, c: 3 }))

// A `_` DEFAULT arm beside a binding arm — the wildcard becomes the chain's bare `else`, and the
// binding arm keeps its narrowing.
function withDefault(s: S): i32 {
  match s {
    Sa{a} => a
    _ => 0
  }
}

print(withDefault({ v: 1, a: 1 }))
print(withDefault({ v: 2, b: 2 }))

// A NULLABLE-spelled union: `| null` is a variant, and the binding arms sit beside its `null` arm.
type N = Sa | null

function nullable(n: N): i32 {
  match n {
    Sa{a} => a
    null => 0 - 1
  }
}

print(nullable({ v: 1, a: 1 }))
print(nullable(null))
