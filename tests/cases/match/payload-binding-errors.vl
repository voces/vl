// @check
// @error-at 30:5 payload binding is not allowed on an or-pattern arm — give each type its own arm
// @error-at 37:13 duplicate payload binding `x`
// @error-at 44:10 payload binding `x` is redeclared in the arm body — rename one
// @error-at 54:13 no field 'z' on {x: i32, y: i32}
// The four ways a payload CLAUSE can be wrong, each named at the binding it is about.
//
//   · on an OR arm. Forced, not stylistic: the checker gives a multi-pattern arm NO
//     then-narrowing (`collectThenNarrows` reports none for the `a || b` condition the desugar
//     builds), so the scrutinee inside the arm is still the whole union and `c.x` would not type.
//     Rust's rule — identical bindings in every alternative — needs narrowing to the JOIN of the
//     alternatives, which is ROADMAP B21 item 4.
//   · a name bound TWICE by one clause, and
//   · a name the arm BODY redeclares. Both exist because the desugar SPLICES: the bindings end
//     up in the body block's own scope, where the checker saw them one level out and shadowing
//     was legal — without these two the emitter's local allocator would be the first pass to
//     meet two same-named locals of possibly different types.
//   · a field the variant does not have — the ordinary field-read error, reported AT the binding
//     because the synthesized `const z = c.z` carries the field name's position.
//
// Each is ONE error: a rejected clause is not re-checked as declarations, so neither the or arm's
// `field 'x' is not on every member of …` nor the duplicate's terse `redeclared x` cascades.
type Move = { x: i32, y: i32 }
type Attack = { target: string }
type Halt = { h: i32 }
type Cmd = Move | Attack | Halt

function orArm(c: Cmd) {
  match c {
    Move{x} | Attack => 1
    Halt => 2
  }
}

function duplicate(c: Cmd) {
  match c {
    Move{x, x} => x
    _ => 0
  }
}

function redeclared(c: Cmd) {
  match c {
    Move{x} => {
      const x = "s"
      x.length
    }
    _ => 0
  }
}

function unknownField(c: Cmd) {
  match c {
    Move{x, z} => x + z
    _ => 0
  }
}

print(orArm({ h: 1 }))
print(duplicate({ h: 1 }))
print(redeclared({ h: 1 }))
print(unknownField({ h: 1 }))
