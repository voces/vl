// @run
// @log true
// @log true
// @log 8
// @log 7
// @log 5.5
// @log 4.5
// @hint redundant type annotation: `v` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `f64` — remove it to lean on inference
// A valued `match` lowered to an if chain: a literal-union chain, a type-pattern chain, a wildcard
// arm, and arms widening under an f64 head, beside a widening else-if chain.
type A = { a: i32 }
type B = { b: i32 }
type C = { c: i32 }
type U = A | B | C
type Op = "add" | "sub" | "neg" | "divide"
function linkKind(op: Op, n: i32) {
  const ok = match op {
    "add" | "sub" => true
    "neg" => false
    "divide" => n > 3
  }
  return ok
}
function isArm(u: U) {
  const v = match u {
    A => u.a
    B => u.b * 2
    C => u.c * 3
  }
  return v
}
function wildArm(u: U) {
  const v = match u {
    A => u.a
    _ => 7
  }
  return v
}
print(linkKind("sub", 0))
print(linkKind("divide", 5))
print(isArm({ b: 4 }))
print(wildArm({ c: 1 }))
type W = "i" | "f" | "z"
function widen(w: W, n: i32) {
  const v: f64 = match w {
    "i" => n
    "f" => 2.5
    "z" => 0
  }
  return v
}
function elseIfWiden(n: i32) {
  const v: f64 = if n > 2 { n } else if n > 1 { 1.5 } else { 0 }
  return v
}
print(widen("i", 3) + widen("f", 0))
print(elseIfWiden(3) + elseIfWiden(2))
