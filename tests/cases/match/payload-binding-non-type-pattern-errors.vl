// @check
// @error-at 19:7 a payload clause binds a variant's fields, so it cannot follow a literal / `_` / an integer pattern — write `"a" =>`
// @error-at 26:7 a payload clause binds a variant's fields, so it cannot follow a literal / `_` / an integer pattern — write `"a" =>`
// @error-at 34:5 a payload clause binds a variant's fields, so it cannot follow a literal / `_` / an integer pattern — write `_ =>`
// @error-at 40:7 a payload clause binds a variant's fields, so it cannot follow a literal / `_` / an integer pattern — write `"a" =>`
// @error-at 40:16 a payload clause binds a variant's fields, so it cannot follow a literal / `_` / an integer pattern — write `"b" =>`
// @error-at 47:5 a payload clause binds a variant's fields, so it cannot follow a literal / `_` / an integer pattern — write `0 =>`
// @error-at 54:6 a payload clause binds a variant's fields, so it cannot follow a literal / `_` / an integer pattern — write `-1 =>`
// A payload clause reads a VARIANT'S fields, so it is meaningful only after a type pattern.
// After a string literal, an integer literal or `_` the arm is already committed to the arrow,
// so before D1833 the `{` was reported as a missing `=` and then a missing `>` — the arrow's
// words about the wrong token — and the recovery lost the rest of the arm, 7 to 13 diagnostics
// for the six cells below. One sentence now, ANCHORED AT THE `{` and echoing the pattern as the
// source spells it, then the clause is consumed so the arm still parses. The or-pattern arm is
// why the count is one per MEMBER rather than one per arm.
type K = "a" | "b"

function strEmpty(k: K): i32 {
  match k {
    "a"{} => 1
    _ => 2
  }
}

function strFields(k: K): i32 {
  match k {
    "a"{x} => 1
    _ => 2
  }
}

function wildcard(k: K): i32 {
  match k {
    "a" => 1
    _{} => 2
  }
}

function orArm(k: K): i32 {
  match k {
    "a"{x} | "b"{y} => 1
    _ => 2
  }
}

function intLit(n: i32): i32 {
  match n {
    0{} => 1
    _ => 2
  }
}

function negIntLit(n: i32): i32 {
  match n {
    -1{x} => 1
    _ => 2
  }
}

print(strEmpty("b"))
print(strFields("b"))
print(wildcard("b"))
print(orArm("b"))
print(intLit(3))
print(negIntLit(3))
