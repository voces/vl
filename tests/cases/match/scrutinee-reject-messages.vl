// @check
// @error-at 12:0 match scrutinee must be a union or an integer, got f64
// @error-at 18:4 unknown name `high` in match pattern — an arm is a literal, a `const` with a literal value, or the `_` wildcard
// The scrutinee kinds `match` still refuses, each with its OWN reason rather than the blanket
// "must be a literal union" master gave every one of them.
//
//   · a NON-union with no closed member set and no integer dispatch — an `f64`, because
//     equality dispatch over a float is a trap, not a feature (D1572 admits `i32`/`i64` here);
//   · over a LITERAL union a bare name that is neither a type nor a constant is not a pattern
//     (D3271), and is named as the unknown name it is. A union mixing literal kinds, or a
//     literal beside a type, is a scrutinee like any other union (D5714).
const x = 5.5
match x {
  f64 => print(1)
}

function f(k: "a" | "b") {
  match k {
    high => print(1)
    "a" => print(2)
    "b" => print(3)
  }
}
f("a")
