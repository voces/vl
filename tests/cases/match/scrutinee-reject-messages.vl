// @check
// @error-at 15:0 match scrutinee must be a union or an integer, got f64
// @error-at 21:0 match over a union with literal members is not supported — compare them with `==` in an if-chain, got N
// @error-at 28:4 unknown name `high` in match pattern — an arm is a literal, a `const` with a literal value, or the `_` wildcard
// The scrutinee kinds `match` still refuses, each with its OWN reason rather than the blanket
// "must be a literal union" master gave every one of them.
//
//   · a NON-union with no closed member set and no integer dispatch — an `f64`, because
//     equality dispatch over a float is a trap, not a feature (D1572 admits `i32`/`i64` here);
//   · a union with LITERAL members has no arm spelling that lowers — the arm's test would be
//     `n is 0`, and `emitProgram: literal \`is\` over a struct union is not supported` on
//     master too, so this is refused at the type tier instead of accepted into a codegen fail;
//   · over a LITERAL union a bare name that is neither a type nor a constant is not a pattern
//     (D3271), and is named as the unknown name it is.
const x = 5.5
match x {
  f64 => print(1)
}

type N = 0 | 1 | 2
const n: N = 1
match n {
  0 => print(1)
  _ => print(2)
}

function f(k: "a" | "b") {
  match k {
    high => print(1)
    "a" => print(2)
    "b" => print(3)
  }
}
f("a")
