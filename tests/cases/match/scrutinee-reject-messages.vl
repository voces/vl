// @check
// @error-at 16:0 match scrutinee must be a union, got i32
// @error-at 23:0 match over a union with literal members is not supported — compare them with `==` in an if-chain, got 0 | 1 | 2
// @error-at 27:4 invalid match pattern `high` — a pattern is a member string literal or the `_` wildcard
// The scrutinee kinds `match` still refuses, each with its OWN reason rather than the blanket
// "must be a literal union" master gave every one of them.
//
//   · a NON-union has no closed member set to be complete over;
//   · a union with LITERAL members has no arm spelling that lowers — the arm's test would be
//     `n is 0`, and `emitProgram: literal \`is\` over a struct union is not supported` on
//     master too, so this is refused at the type tier instead of accepted into a codegen fail;
//   · over a LITERAL union a TYPE pattern is still not a pattern — phase 1's wording, verbatim,
//     reached now through the type-pattern node an identifier parses into.
const x = 5
match x {
  i32 => print(1)
}

type N = 0 | 1 | 2
const n: N = 1
match n {
  0 => print(1)
  _ => print(2)
}

function f(k: "a" | "b") {
  match k {
    high => print(1)
    "a" => print(2)
    "b" => print(3)
  }
}
f("a")
