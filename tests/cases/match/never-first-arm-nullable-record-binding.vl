// @run
// @log 4
// @log -1
// @hint redundant type annotation: `h` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// An integer `match` whose first arm is a `never` call types its binding by the arm that delivers
// a value, here a nullable record (D3354).
type Rec = { r: i32 }
function die(msg: string): never {
  print(msg)
  __trap__()
}
function pass1(x: Rec | null): Rec | null { x }
function h(n: i32): i32 {
  const o: Rec | null = if n > 1 { { r: n } } else { null }
  const y = match n {
    99 => die("dead")
    _ => o
  }
  const z = pass1(y)
  (z)?.r ?? -1
}
print(h(4))
print(h(1))
