// @run
// @log one
// @log a
// @log int
// @log a
// @log 5
// @log 0
// @log 40
// @log a!
// @log zero
// @log one
// @log null
// @log 30
// @log 2
// @log two
// @log 7
// @log 8
// @log stmt a
// @log 105
// @log 3
// @log 10
// @log ci
// @log 1
// @log 42
