// @log 5
// @log a
// A `match` over a union that mixes literal members with a type member dispatches each value
// arm by `==` and narrows the rest (D5714): a `_` or type arm, an or-pattern, a const pattern,
// a nullable union with its null arm in any place, a record member, statement and block arms,
// and captured, member, call and global scrutinees.
function f(k: "a" | 1) {
  match k {
    "a" => "a"
    1 => "one"
  }
}
function g(k: "a" | i32) {
  match k {
    "a" => "a"
    _ => "int"
  }
}
function h(k: "a" | i32) {
  match k {
    "a" => 0
    i32 => k + 1
  }
}
function w(k: "a" | i32) {
  match k {
    "a" => 0
    _ => k * 10
  }
}
function s(k: "a" | i32) {
  match k {
    "a" => k + "!"
    _ => "n"
  }
}
type N = 0 | "one"
function c(k: N | null) {
  match k {
    0 => "zero"
    "one" => "one"
    null => "null"
  }
}
function e(k: "a" | "b" | i32) {
  match k {
    "a" => 1
    "b" => 2
    _ => k * 10
  }
}
function neg(k: 2 | "x") {
  match k {
    2 => "two"
    "x" => "x"
  }
}
const K = "a"
function cst(k: "a" | 1) {
  match k {
    K => 7
    1 => 8
  }
}
function stmt(k: "a" | i32) {
  match k {
    "a" => print("stmt a")
    i32 => print(k + 100)
  }
}
function blk(k: "a" | i32) {
  const r = match k {
    "a" => {
      const q = 3; q
    }
    i32 => {
      const z = k; z + 1
    }
  }
  r
}
function capd(k: "a" | i32): () => string {
  () => match k {
    "a" => "ca"
    _ => "ci"
  }
}
function orp(k: "a" | "b" | i32) {
  match k {
    "a" | "b" => 1
    i32 => k
  }
}
print(f(1))
print(f("a"))
print(g(3))
print(g("a"))
print(h(4))
print(h("a"))
print(w(4))
print(s("a"))
print(c(0))
print(c("one"))
print(c(null))
print(e(3))
print(e("b"))
print(neg(2))
print(cst("a"))
print(cst(1))
stmt("a")
stmt(5)
print(blk("a"))
print(blk(9))
print(capd(2)())
print(orp("b"))
print(orp(42))
type Circle = { r: i32 }
function cap(k: "a" | i32): () => i32 {
  match k {
    "a" => () => 0
    i32 => () => k + 1
  }
}
function cap2(k: "a" | i32) {
  const f = () => match k {
    "a" => 1
    _ => k * 3
  }
  f()
}
type O = { k: "a" | i32 }
function mem(o: O) {
  match o.k {
    "a" => 1
    i32 => o.k + 2
  }
}
function src(): "a" | i32 { 4 }
function call() {
  match src() {
    "a" => 1
    _ => 9
  }
}
function nul(k: "a" | i32 | null) {
  match k {
    null => 2
    "a" => 1
    i32 => k + 5
  }
}
function nul2(k: "a" | i32 | null) {
  match k {
    null => 2
    "a" => 1
    _ => k + 6
  }
}
function rec(k: "a" | Circle) {
  match k {
    "a" => 1
    Circle => k.r
  }
}
function rec2(k: "a" | "b" | Circle) {
  match k {
    "a" => 1
    "b" => 2
    _ => k.r
  }
}
function order(k: "a" | "b" | i32) {
  match k {
    "a" => 1
    i32 => k
    "b" => 2
  }
}
const gl: "x" | i32 = 7
function glob() {
  match gl {
    "x" => 0
    _ => 1
  }
}
function lng(k: 1 | "s" | i64) {
  match k {
    1 => "one"
    "s" => "s"
    _ => "long"
  }
}
function fl(k: "a" | f64) {
  match k {
    "a" => 0.5
    f64 => k * 2.0
  }
}
function retd(k: "a" | i32): "a" | i32 {
  match k {
    "a" => k
    _ => k + 1
  }
}
print(cap(3)())
print(cap2(4))
print(mem({ k: 5 }))
print(call())
print(nul(1))
print(nul(null))
print(nul2(1))
print(rec({ r: 9 }))
print(rec2({ r: 8 }))
print(rec2("b"))
print(order(11))
print(order("b"))
print(glob())
print(lng(1))
print(fl(1.5))
print(retd(4))
print(retd("a"))
