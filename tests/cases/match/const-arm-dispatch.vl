// @run
// @log int class root neg zero other
// @log wide big w root neg other
// @log litunion 1 2 3 2 0 9 ts
// @log local l1 l23 l23 other
// @log dense 10 30 40 50 0
// @log hole root other
// @log order late other
// @log shadow inner5 outer2 other
// @log generic s 3
// @log closure q nq
// @log stmt 10 20 30
// A `const` with a literal value is a match arm, compared by value (D3271, owner ruling on
// plumb's PL-062): a module or a local constant, a negative one, an `i64` one, one typed as a
// literal union, beside literal arms and `_`, in every scrutinee vocabulary that takes values —
// `i32`, `i64`, a literal union and its nullable, and a hole the arms decide. The arm reads the
// constant the name resolves to where the `match` stands, so a local shadows a module constant,
// and a module constant declared below the function is already in scope.
type K = "a" | "b" | "c"
const LF_CLASS = 0x1504
const ROOT = 7
const NEG = -1
const BIG = 5000000000
const W: i64 = 3
const KA: K = "a"
const KB: K = "b"
const KC = "c"
const TS: string = "a"
const X = 1
const Y = 2

function kind(k: i32) {
  match k {
    LF_CLASS => "class"
    ROOT => "root"
    NEG => "neg"
    0 => "zero"
    _ => "other"
  }
}

function wide(x: i64) {
  match x {
    BIG => "big"
    W => "w"
    ROOT => "root"
    NEG => "neg"
    _ => "other"
  }
}

function lu(k: K) {
  match k {
    KA => 1
    KB => 2
    KC => 3
  }
}

function nlu(k: K | null) {
  match k {
    KB => 2
    null => 0
    _ => 9
  }
}

function tsk(k: K) {
  match k {
    TS => "ts"
    _ => "no"
  }
}

function local(k: i32) {
  const L1 = 10
  const L2 = 11
  const L3 = 12
  match k {
    L1 => "l1"
    L2 | L3 => "l23"
    _ => "other"
  }
}

function dense(k: i32) {
  const A = 1
  const B = 2
  const C = 3
  const D = 4
  match k {
    A => 10
    B => 20
    C => 30
    D => 40
    5 => 50
    _ => 0
  }
}

function hole(k) {
  match k {
    ROOT => "root"
    _ => "other"
  }
}

function early(k: i32) {
  match k {
    LATE => "late"
    _ => "other"
  }
}

const LATE = 42

function shadow(k: i32) {
  const X = 5
  match k {
    X => "inner5"
    Y => "outer2"
    _ => "other"
  }
}

function gen<T>(v: T, k: i32) {
  match k {
    X => v
    _ => v
  }
}

function clo(k: i32) {
  const Q = 9
  const g = (j: i32) => {
    match j {
      Q => "q"
      _ => "nq"
    }
  }
  g(k)
}

function stmt(k: i32) {
  let out = 0
  match k {
    X => {
      out = 10
    }
    Y => {
      out = 20
    }
    _ => {
      out = 30
    }
  }
  out
}

print("int \{kind(0x1504)} \{kind(7)} \{kind(-1)} \{kind(0)} \{kind(3)}")
print(
  "wide \{wide(5000000000 as i64)} \{wide(3 as i64)} \{wide(7 as i64)} \{wide(-1 as i64)} \{wide(8 as i64)}",
)
print(
  "litunion \{lu("a")} \{lu("b")} \{lu("c")} \{nlu("b")} \{nlu(null)} \{nlu("a")} \{tsk("a")}",
)
print("local \{local(10)} \{local(11)} \{local(12)} \{local(1)}")
print("dense \{dense(1)} \{dense(3)} \{dense(4)} \{dense(5)} \{dense(6)}")
print("hole \{hole(7)} \{hole(8)}")
print("order \{early(42)} \{early(1)}")
print("shadow \{shadow(5)} \{shadow(2)} \{shadow(1)}")
print("generic \{gen("s", 1)} \{gen(3, 0)}")
print("closure \{clo(9)} \{clo(8)}")
print("stmt \{stmt(1)} \{stmt(2)} \{stmt(3)}")
