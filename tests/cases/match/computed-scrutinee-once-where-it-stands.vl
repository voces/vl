// @run
// @log true 1
// @log true 2
// @log 0 13
// @log 3 7
// @log 2 8
// @log 9:two
// @log 0/three
// @log 60 70 13 2
// @log 10 15 three 7 17
// @log 17c 18
// @log 18s19 19
// @log 19nc21 21
// @log true 22
// @log one 23
// @log two 24
// @log e1
// @log which 25
// @log 9
// A computed `match` scrutinee in a position it cannot be bound ahead of its statement from (the
// right of `&&`, `||` or `??`, a loop or `else if` condition, an argument after a call, a list
// element or field after one, an index target) is bound where the match stands (D2038). Each
// line prints the side-effect count, which must rise by exactly one per match.

let n = 0
function next(): i32 {
  n = n + 1
  n
}
function maybe(): i32 | null {
  n = n + 10
  null
}

const a = true && match next() { 0 => false, 1 => true, _ => false }
print("\{a} \{n}")
const b = false || match next() { 2 => true, 3 => false, _ => false }
print("\{b} \{n}")
const c = maybe() ?? match next() { 2 => 20, 3 => 30, _ => 0 }
print("\{c} \{n}")

let loops = 0
while match next() { 14 => true, 15 => true, 16 => true, _ => false } {
  loops = loops + 1
}
print("\{loops} \{n - 10}")
let r = 0
if n > 99 { r = 1 } else if match next() { 18 => true, _ => false } { r = 2 }
print("\{r} \{n - 10}")

function two(x: i32, y: string): string { "\{x - 10}:\{y}" }
function named(x: i32, y: string): string { "\{x}/\{y}" }
print(two(next(), match next() { 20 => "two", _ => "other" }))
print(named(y: match next() { 21 => "three", _ => "?" }, x: 0))
const ys = [match next() { 22 => 60, _ => 0 }, match next() { 23 => 70, _ => 0 }]
print("\{ys[0]} \{ys[1]} \{n - 10} \{ys.length}")

let xs: i32[] = [0, 0, 0, 0]
xs.push(match next() { 24 => 10, _ => 0 })
const o = { a: next(), b: match next() { 26 => "three", _ => "?" } }
xs[match next() { 27 => 2, _ => 0 }] = 7
print("\{xs[4]} \{o.a - 10} \{o.b} \{xs[2]} \{n - 10}")

type Ci = { r: i32 }
type Sq = { s: i32 }
function shape(): Ci | Sq | string {
  n = n + 1
  if n % 3 == 1 {
    const ci: Ci = { r: n - 10 }
    return ci
  }
  if n % 3 == 2 {
    const sq: Sq = { s: n - 10 }
    return sq
  }
  "x"
}
function cat(p: string, q: string) { p + q }
function at() { n - 10 }
print(cat("\{at()}", match shape() { Ci => "c", Sq => "s", string => "str" }) + " \{n - 10}")
print(cat("\{at()}", match shape() { Ci{r} => "c\{r}", Sq{s} => "s\{s}", string => "str" }) + " \{n - 10}")
print(
  cat(
    "\{at()}",
    match shape() {
      Ci => "c"
      Sq => "s"
      _ => match shape() { Ci{r} => "nc\{r}", Sq => "ns", _ => "nd" }
    },
  ) + " \{n - 10}",
)
const ok = n > 0 && match shape() { Ci => false, Sq => true, string => false }
print("\{ok} \{n - 10}")

function show(s: string) { print("\{s} \{n - 10}") }
const flag = n > 0
show(if flag { match next() { 33 => "one", _ => "many" } } else { "no" })
function f(k: boolean) {
  show(if k { match next() { 34 => "two", _ => "many" } } else { "no" })
}
f(true)

// A module-scope choice of generic functions whose nested `match` calls (D9350).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function tg<T>(t: T): T { return t + t + t }
function say(tag: string, want: boolean): boolean {
  print(tag)
  return want
}
function which(): i32 {
  n = n + 1
  print("which \{n - 10}")
  return 2
}
const e = if say("e1", false) { idg } else {
  match which() {
    1 => idg
    2 => tg
    _ => kg
  }
}
print(e(3))
