// @run
// @log 0
// @log 1
// @log ?
// @log g
// @log r
// @log 2
// @log 1
// @log arg _
// @log c:_
// @log arg r
// @log c:r
// @log ab
// @log a_
// @log __
// @log 1
// @log 0
// @log m circle
// @log m other
// Q58 position sweep: a `match` arm's string pattern over an open scrutinee, which is untyped:
// a statement `match`, a valued `match` returned, bound by `let`, passed as a call argument and
// concatenated, two string arms beside `_`, a nested `match`, one in a lambda, and a scrutinee
// read off an open record's field.
type K = "circle" | "round"
type A = { kind: K }
function stmt(p) {
  match p {
    "red" => print(1)
    _ => print(0)
  }
}
function ret(p) {
  return match p {
    "red" => "r"
    "green" => "g"
    _ => "?"
  }
}
function bound(p) {
  const v = match p {
    "red" => 1
    _ => 2
  }
  print(v)
}
function arg(p) {
  print(
    match p {
      "red" => "arg r"
      _ => "arg _"
    },
  )
  print(
    "c:"
      + match p {
      "red" => "r"
      _ => "_"
    },
  )
}
function nested(p, q) {
  match p {
    "a" => match q {
      "b" => print("ab")
      _ => print("a_")
    }
    _ => print("__")
  }
}
function field(o) {
  match o.kind {
    "circle" => print("m circle")
    _ => print("m other")
  }
}
function main() {
  const s: string = "blue"
  stmt(s)
  stmt("red")
  print(ret(s))
  print(ret("green"))
  print(ret("red"))
  bound(s)
  bound("red")
  arg(s)
  arg("red")
  nested("a", "b")
  nested("a", s)
  nested(s, "b")
  const f = (p) => match p {
    "x" => 1
    _ => 0
  }
  print(f("x"))
  print(f(s))
  const a: A = { kind: "circle" }
  const b: A = { kind: "round" }
  field(a)
  field(b)
}
main()
