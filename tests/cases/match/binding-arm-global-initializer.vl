// @run
// @log 11
// A binding arm in a TOP-LEVEL binding: a top-level `const` is a module global, so the arm's
// `const a` is a local of the start function, allocated where the start function's collect
// walks the global's initializer (D2785).
type A = { a: i32 }
type B = { b: i32 }
type U = A | B

const u: U = { a: 11 }
const r = match u {
  A{a} => a
  B{b} => b
}
print(r)
