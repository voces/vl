// @run
// @log 15
// @log -5
// @log 42
// @log 0
// @log 7
// @hint redundant type annotation: `decode` is inferred as `i32`
// The CONSUMER'S shape (glean VL-020, D1572): a decoder that switches on an integer TAG read
// out of a buffer. Before D1572 this had to be an if-chain or a dispatch table filled by one
// assignment per command id at module init — the ask that motivated the feature. The `_` arm
// is the unknown-tag path, and a `T | null` arm rides D1086's join rule.

function decode(buf: i32[], at: i32): i32 {
  const tag = buf[at]
  match tag {
    1 => buf[at + 1]
    2 => buf[at + 1] + buf[at + 2]
    3 => 0 - buf[at + 1]
    _ => -1
  }
}

function label(tag: i32): string | null {
  match tag {
    1 => "load"
    2 => null
    _ => "unknown"
  }
}

const buf = [2, 7, 8, 3, 5]
print(decode(buf, 0)) // 15 — tag 2 sums the next two
print(decode(buf, 3)) // -5 — tag 3 negates
print((label(1) ?? "").length + 38) // 42 — the non-null arm
print((label(2) ?? "").length) // 0 — the null arm
print((label(9) ?? "").length) // 7 — the wildcard
