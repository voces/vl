// @run
// @log 5
// @log any
// @log 6
// @log 7
// @log side
// @log 8
// A `match` with one arm tests nothing, so its body is the value (D5711) — as a function's tail
// and as an initializer, over an integer, a literal union and a struct union. The scrutinee is
// still evaluated.
function overInt(n: i32) {
  match n {
    _ => 5
  }
}
print(overInt(1))

function overLits(k: "a" | "b") {
  match k {
    _ => "any"
  }
}
print(overLits("b"))

function asInit(n: i32) {
  const s = match n {
    _ => 6
  }
  s
}
print(asInit(1))

type A = { a: i32 }
type B = { b: i32 }
function overStructs(x: A | B) {
  match x {
    _ => 7
  }
}
print(overStructs({ a: 1 }))

function sideEffect() {
  print("side")
  3
}
function evaluated() {
  match sideEffect() {
    _ => 8
  }
}
print(evaluated())
