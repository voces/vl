// @run
// @log 5
// @log true
// @warning Unused parameter `x`
// @warning Unused parameter `t`
// @warning Unused parameter `x`
// A match arm in a generic body calls a destructured field spelled like a generic function: the
// call reaches the field's closure, not that function's instance (D4304).
function a<T>(x: T): (t: T) => boolean {
  (t: T) => true
}
type FA = { a: (x: f64) => (t: f64) => f64 }
type FB = { b: i32 }
function pr<T>(u: FA | FB, y: T) {
  match u {
    FA{a} => print(a(2.5)(2.5))
    FB{b} => print(a(y)(y))
  }
}
pr({ a: (x: f64) => (t: f64) => t * 2.0 }, 1)
pr({ b: 3 }, "s")
