// @run
// @log null
// @log null
// @log 1
// A `match` over a value typed `null` alone tests its one member with a `null` arm (D3335).
const v = null
print(
  match v {
    null => "null"
  },
)
function g(a: null) { return a }
const w = g(null)
print(
  match w {
    null => "null"
  },
)
function f() {
  const x = null
  const s = match x {
    null => 1
  }
  print(s)
}
f()
