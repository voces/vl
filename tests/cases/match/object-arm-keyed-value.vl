// @check
// @error `a: …` starts no statement: a label names a loop or a block (`a: { … }`), and an object literal here needs parentheses: `({ a: … })`
// @error `x: …` starts no statement: a label names a loop or a block (`x: { … }`), and an object literal here needs parentheses: `({ x: … })`
// A `match` arm's or an `if` branch's braces are always a block, so `name: value` there starts
// no statement; one diagnostic per body names the parentheses, whatever fields follow (D3276).
function f(b: i32) {
  match b {
    3 => { a: 1, c: { d: 2 } }
    _ => ({ a: 2, c: { d: 2 } })
  }
}
function k(c: boolean) {
  if c {
    x: 1,
    y: 2
  } else { x: 3, y: 4 }
}
