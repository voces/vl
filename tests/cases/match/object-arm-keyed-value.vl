// @run
// @log 2
// @log 2
// @log 2
// @log 4
// A `match` arm's or an `if` branch's braces that open `name: …` are an object literal, whatever
// fields follow, with or without parentheses, since a label is `@name` (D3276, D3374).
function f(b: i32) {
  match b {
    3 => { a: 1, c: { d: 2 } }
    _ => ({ a: 2, c: { d: 2 } })
  }
}
print(f(3).c.d)
print(f(4).a)
function k(c: boolean) {
  if c { x: 1, y: 2 } else { x: 3, y: 4 }
}
print(k(true).y)
print(k(false).y)
