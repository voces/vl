// @run
// @log b
// @log b
// @log other
// @log alias
// @log wild
// @log stmt
// @log bee
// @log b
// @log nil
// A lone string literal type is a one-member set, so a `match` naming it is complete (D5594).
// Each face: inline, narrowed to one literal, an alias, with `_`, as a statement, as a value,
// and nullable.
function lone(k: "b") {
  match k {
    "b" => "b"
  }
}
print(lone("b"))

function narrowed(k: "a" | "b" | "c") {
  if k != "b" { return "other" }
  match k {
    "b" => "b"
  }
}
print(narrowed("b"))
print(narrowed("a"))

type K = "b"
function alias(k: K) {
  match k {
    "b" => "alias"
  }
}
print(alias("b"))

function wild(k: "b") {
  match k {
    "b" => "wild"
    _ => "z"
  }
}
print(wild("b"))

function stmt(k: "b") {
  match k {
    "b" => {
      print("stmt")
    }
  }
}
stmt("b")

function value(k: "b") {
  const s = match k {
    "b" => "bee"
  }
  s
}
print(value("b"))

function nullable(k: "b" | null) {
  match k {
    "b" => "b"
    null => "nil"
  }
}
print(nullable("b"))
print(nullable(null))
