// @run
// @log six 6
// @log six 1
// @log B 2
// @log s4 3
// @log c3 4
// @log none 5
// @log six 6
// @log six 7
// @log seven 8
// @log s4 9
// @log eight 10
// @log B 12
// @log two 13
// @log six 14
// @log six 15
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// A `match` evaluates its scrutinee ONCE (D1991): a call, a field read through a call, an
// indexed read with a computed index or arithmetic is bound to a hidden local ahead of the
// statement holding the match, and every arm tests that. Each line prints the chosen arm and
// the number of side-effecting evaluations so far, which must rise by exactly one per match.

let n = 5
function next() {
  n = n + 1
  n
}

// The D1991 witness: before the fix it printed `other 8`.
const r = match next() {
  5 => "five"
  6 => "six"
  7 => "seven"
  _ => "other"
}
print("\{r} \{n}")

let c = 0
type L = "a" | "b" | "c"
type Ci = { r: i32 }
type Sq = { s: i32 }
type Tr = { t: i32 }
type Sh = Ci | Sq | Tr
type Hold = { k: i32 }

function six() {
  c = c + 1
  6
}
function lit(): L {
  c = c + 1
  "b"
}
function shape(): Sh {
  c = c + 1
  const v: Sh = { s: 4 }
  v
}
function maybe(ok: boolean): Ci | null {
  c = c + 1
  if ok { return { r: 3 } }
  null
}
function hold(): Hold {
  c = c + 1
  { k: 7 }
}
function zero() {
  c = c + 1
  0
}

// A statement `match` over a call, inside a function.
function stmt() {
  let res = ""
  match six() {
    5 => {
      res = "five"
    }
    6 => {
      res = "six"
    }
    7 => {
      res = "seven"
    }
    _ => {
      res = "other"
    }
  }
  print("\{res} \{c}")
}
stmt()

// A literal-union scrutinee, bound as a local initializer.
function litLet() {
  const res = match lit() {
    "a" => "A"
    "b" => "B"
    "c" => "C"
  }
  print("\{res} \{c}")
}
litLet()

// A union scrutinee whose arms bind payload fields: the bound local narrows.
function payload() {
  return match shape() {
    Ci{r} => "c\{r}"
    Sq{s} => "s\{s}"
    Tr{t} => "t\{t}"
  }
}
print("\{payload()} \{c}")

// A nullable scrutinee, as a function's tail value.
function nullable(ok: boolean) {
  match maybe(ok) {
    null => "none"
    Ci{r} => "c\{r}"
  }
}
print("\{nullable(true)} \{c}")
print("\{nullable(false)} \{c}")

// A lambda body, and an argument whose earlier siblings are literals.
const g = () => match six() {
  5 => "five"
  6 => "six"
  7 => "seven"
  _ => "other"
}
print("\{g()} \{c}")
function cat(a: string, b: string) { a + b }
print(
  "\{cat("", match six() { 5 => "five", 6 => "six", 7 => "seven", _ => "other" })} \{c}",
)

// A field read through a call, at module scope.
const viaField = match hold().k {
  5 => "five"
  6 => "six"
  7 => "seven"
  _ => "other"
}
print("\{viaField} \{c}")

// A generic body: the binding takes each instance's type.
function gen<T>(_x: T) {
  match shape() {
    Ci{r} => "c\{r}"
    Sq{s} => "s\{s}"
    Tr{t} => "t\{t}"
  }
}
print("\{gen(1)} \{c}")

// An index computed by a call.
const xs = [5, 6, 7, 8]
function idx() {
  c = c + 1
  3
}
print(
  "\{match xs[idx()] { 5 => "five", 6 => "six", 7 => "seven", 8 => "eight", _ => "other" }} \{c}",
)

// A computed match nested in an arm of another, and one scrutinising another.
function nested() {
  const res = match six() {
    6 => match lit() {
      "a" => "A"
      "b" => "B"
      "c" => "C"
    }
    _ => "other"
  }
  print("\{res} \{c}")
  const two = match (match zero() {
    0 => 2
    1 => 1
    _ => 0
  }) {
    0 => "zero"
    1 => "one"
    2 => "two"
    _ => "many"
  }
  print("\{two} \{c}")
}
nested()

// Arithmetic over a call, and a match that is an operand of a string concatenation.
print(
  "\{match six() * 1 { 5 => "five", 6 => "six", 7 => "seven", _ => "other" }} \{c}",
)
print(
  "" +
    match six() {
    5 => "five"
    6 => "six"
    7 => "seven"
    _ => "other"
  } +
    " \{c}",
)
