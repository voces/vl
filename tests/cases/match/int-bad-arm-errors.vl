// @check
// @error match pattern type mismatch: expected i32, found f64
// @error match pattern type mismatch: expected i32, found i64
// @error invalid match pattern — a pattern over i32 is an integer literal or the `_` wildcard
// @error invalid match pattern — a pattern over i32 is an integer literal or the `_` wildcard
// @error unreachable match arm — the `_` wildcard must be the last arm
// The arm vocabulary an INTEGER scrutinee refuses (D1572), one function per rule.
//
//   · a FLOAT literal and an out-of-i32-range literal are the ordinary assignability rule —
//     a pattern is checked as the expression it is, so an `i32` literal reaches an `i64`
//     scrutinee by the widening lattice and neither of these reaches an `i32` one;
//   · a TYPE pattern and a STRING literal are the other two vocabularies' arms, named rather
//     than mis-reported as a missing member;
//   · an arm AFTER the `_` is DEAD, and would be silently REORDERED if it were allowed — the
//     wildcard becomes the chain's bare `else`, so a later arm would be tested FIRST and
//     `match` promises first-match-wins.

function a(x: i32): i32 {
  match x {
    1.5 => 1
    _ => 2
  }
}

function b(x: i32): i32 {
  match x {
    5000000000 => 1
    _ => 2
  }
}

function c(x: i32): i32 {
  match x {
    i32 => 1
    _ => 2
  }
}

function d(x: i32): i32 {
  match x {
    "a" => 1
    _ => 2
  }
}

function e(x: i32): i32 {
  match x {
    _ => 2
    1 => 1
  }
}

print(a(1) + b(1) + c(1) + d(1) + e(1))
