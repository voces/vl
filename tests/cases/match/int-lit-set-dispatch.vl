// @run
// @log seven
// @log two
// @log one
// @log zero
// @log 11
// @log nil
// @log two
// @log other
// @log big
// @log 20
// @log one
// A union of integer literals is a closed member set, so naming every member is complete and
// no `_` is required (D5710). A lone literal, a union, an alias, nullable, narrowed, an i64-width
// member, the `_` arm narrowed to what is left, and a `const` arm.
function lone(k: 7) {
  match k {
    7 => "seven"
  }
}
print(lone(7))

function pair(k: 1 | 2) {
  match k {
    1 => "one"
    2 => "two"
  }
}
print(pair(2))
print(pair(1))

type N = 0 | 1 | 2
function named(n: N) {
  match n {
    0 => "zero"
    1 => "one"
    2 => "two"
  }
}
const x: N = 0
print(named(x))
const v = match x {
  1 => 10
  _ => 11
}
print(v)

function nullable(k: 1 | 2 | null) {
  match k {
    1 => "one"
    2 => "two"
    null => "nil"
  }
}
print(nullable(null))
print(nullable(2))

function narrowed(k: 1 | 2 | 3) {
  if k != 2 { return "other" }
  match k {
    2 => "two"
  }
}
print(narrowed(3))

function wide(k: 9000000001 | 2) {
  match k {
    9000000001 => "big"
    2 => "two"
  }
}
print(wide(9000000001))

function takesTwo(k: 2) { k * 10 }
function rest(k: 1 | 2) {
  match k {
    1 => 10
    _ => takesTwo(k)
  }
}
print(rest(2))

const ONE = 1
function viaConst(k: 1 | 2) {
  match k {
    ONE => "one"
    2 => "two"
  }
}
print(viaConst(1))
