// @check
// @error-at 10:4 match pattern `3` is not a member of 1 | 2
// @error-at 16:2 non-exhaustive match — missing 2 (add the arm or a `_`)
// @error-at 22:2 non-exhaustive match — missing null (add the arm or a `_`)
// @error-at 31:4 redundant match arm: `1` is already covered
// An integer literal set refuses what its member list rules out (D5710): a pattern that is not
// a member, a member left uncovered with no `_`, an uncovered `null`, and a repeated member.
function notMember(k: 1 | 2) {
  match k {
    1 => "one"
    3 => "three"
    _ => "z"
  }
}
print(notMember(1))
function missing(k: 1 | 2) {
  match k {
    1 => "one"
  }
}
print(missing(1))
function missingNull(k: 1 | 2 | null) {
  match k {
    1 => "one"
    2 => "two"
  }
}
print(missingNull(1))
function repeated(k: 1 | 2) {
  match k {
    1 => "one"
    1 => "uno"
    2 => "two"
  }
}
print(repeated(1))
