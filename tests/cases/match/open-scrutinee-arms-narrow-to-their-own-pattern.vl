// @run
// @log 5
// @log s!
// @log yy
// @log 7
// D1885: each arm of a `match` over an un-annotated parameter narrows to its own pattern, the
// last one included, so a read there is asked only of the pin that reaches it. The bare `else`
// of the `is` spelling does not, which is D16004.
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: string }
function value(p) {
  match p {
    i32 => print(p + 1)
    string => print(p + "!")
  }
}
function record(p) {
  match p {
    A => print(p.x)
    B => print(p.y)
  }
}
const b: A | B = { kind: "b", y: "yy" }
const a: A | B = { kind: "a", x: 7 }
value(4)
value("s")
record(b)
record(a)
