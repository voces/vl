// @run
// @log 6 1 2
// @log 6 1 2
// @log 6 1 2
// @log 6 1 2
// @log 6 1 2
// @log 6 1 2
// @log seven hi! none
// @log seven hi! none
// @log 9 1 2
// @log 9 1 2
// @log 6 1 3 2
// @log 1.5 1 2
// @log 6 1 2
// @log 6 1 2
// @log 1 1 -1
// @log 1 1 -1
// @log 1 1 -3
// @log 6 1 2
// @log 6 1 2
// @log 6 1 2
// @log 6 1 2
// @log 2 1 2.5
// @log 2 1 2.5 3
// @hint redundant type annotation: `rest` is inferred as `i32 | null`
// A literal test placed before the `null` test takes the literal out of a nullable union that
// mixes it with a type member (D5890), and out of a non-nullable one of three or more members
// (D5920): the `match` and the `==` chain, string and int literals, a record member, the
// remainder returned, passed and captured, and the alias spellings.
import { toString } from "std:fmt"

type Circle = { r: i32 }
type K = "a" | i32
type NK = K | null
type FK = "a" | i32 | null
function show3(a: string, b: string, c: string) { print(a + " " + b + " " + c) }
function showN(f: (k: "a" | i32 | null) => i32) {
  show3(f(1).toString(), f("a").toString(), f(null).toString())
}

function matchLitFirst(k: "a" | i32 | null) {
  match k {
    "a" => 1
    null => 2
    i32 => k + 5
  }
}
function matchWild(k: i32 | "a" | null) {
  match k {
    "a" => 1
    null => 2
    _ => k + 5
  }
}
function matchStmt(k: "a" | i32 | null) {
  let r = 0
  match k {
    "a" => {
      r = 1
    }
    null => {
      r = 2
    }
    i32 => {
      r = k + 5
    }
  }
  r
}
function chainElse(k: "a" | i32 | null) {
  if k == "a" { 1 }
  else if k == null { 2 }
  else { k + 5 }
}
function chainReturns(k: "a" | i32 | null) {
  if k == "a" { return 1 }
  if k != null { return k + 5 }
  2
}
function chainLitRight(k: "a" | i32 | null) {
  if "a" == k { 1 }
  else if k == null { 2 }
  else { k + 5 }
}
showN(matchLitFirst)
showN(matchWild)
showN(matchStmt)
showN(chainElse)
showN(chainReturns)
showN(chainLitRight)

function matchInt(k: 7 | string | null) {
  match k {
    7 => "seven"
    null => "none"
    string => k + "!"
  }
}
function chainInt(k: 7 | string | null) {
  if k == 7 { "seven" }
  else if k == null { "none" }
  else { k + "!" }
}
show3(matchInt(7), matchInt("hi"), matchInt(null))
show3(chainInt(7), chainInt("hi"), chainInt(null))

function matchRecord(k: "a" | Circle | null) {
  match k {
    "a" => 1
    null => 2
    Circle => k.r
  }
}
function chainRecord(k: "a" | Circle | null) {
  if k == "a" { 1 }
  else if k == null { 2 }
  else { k.r }
}
show3(
  matchRecord({ r: 9 }).toString(),
  matchRecord("a").toString(),
  matchRecord(null).toString(),
)
show3(
  chainRecord({ r: 9 }).toString(),
  chainRecord("a").toString(),
  chainRecord(null).toString(),
)

function matchTwoLits(k: "a" | "b" | i32 | null) {
  match k {
    "a" => 1
    "b" => 3
    null => 2
    i32 => k + 5
  }
}
print(
  "\{matchTwoLits(1)} \{matchTwoLits("a")} \{matchTwoLits("b")} \{matchTwoLits(null)}",
)
function matchF64(k: "a" | f64 | null) {
  match k {
    "a" => 1.0
    null => 2.0
    f64 => k + 0.5
  }
}
show3(
  matchF64(1.0).toString(),
  matchF64("a").toString(),
  matchF64(null).toString(),
)

function capture(k: "a" | i32 | null) {
  if k == "a" { return 1 }
  const g = () => {
    if k == null { 2 } else { k + 5 }
  }
  g()
}
function local(n: i32) {
  let k: "a" | i32 | null = null
  if n == 0 { k = "a" }
  else if n > 0 { k = n }
  if k == "a" { 1 }
  else if k == null { 2 }
  else { k + 5 }
}
showN(capture)
show3(local(1).toString(), local(0).toString(), local(-1).toString())

function ret(k: "a" | i32 | null): i32 | null {
  if k == "a" { return 1 }
  k
}
function retMatch(k: "a" | i32 | null): i32 | null {
  match k {
    "a" => 1
    _ => k
  }
}
function take(x: i32 | null) { x ?? -3 }
function arg(k: "a" | i32 | null) {
  if k == "a" { return 1 }
  take(k)
}
show3(
  (ret(1) ?? -1).toString(),
  (ret("a") ?? -1).toString(),
  (ret(null) ?? -1).toString(),
)
show3(
  (retMatch(1) ?? -1).toString(),
  (retMatch("a") ?? -1).toString(),
  (retMatch(null) ?? -1).toString(),
)
showN(arg)

function aliasInner(k: K | null) {
  match k {
    "a" => 1
    null => 2
    i32 => k + 5
  }
}
function aliasNullable(k: NK) {
  if k == "a" { 1 }
  else if k == null { 2 }
  else { k + 5 }
}
function aliasWhole(k: FK) {
  match k {
    "a" => 1
    null => 2
    i32 => k + 5
  }
}
function annotated(k: "a" | i32 | null) {
  if k == "a" { return 1 }
  const rest: i32 | null = k
  if rest == null { return 2 }
  rest + 5
}
showN(aliasInner)
showN(aliasNullable)
showN(aliasWhole)
showN(annotated)

function three(k: "a" | i32 | f64) {
  if k == "a" { 1.0 }
  else if k is i32 { 2.0 }
  else { k + 0.5 }
}
function threeNull(k: "a" | i32 | f64 | null) {
  if k == "a" { 1.0 }
  else if k == null { 3.0 }
  else if k is i32 { 2.0 }
  else { k + 0.5 }
}
show3(three(1).toString(), three("a").toString(), three(2.0).toString())
print("\{threeNull(1)} \{threeNull("a")} \{threeNull(2.0)} \{threeNull(null)}")
