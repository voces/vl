// @check
// @warning redundant match arm: "a" is already covered, so this arm never runs
// A pattern already covered by an earlier arm is a dead arm: a warning (owner ruling 2026-11-12).
type K = "a" | "b"
function go() {
  const k: K = "a"
  match k {
    "a" => {
      print(1)
    }
    "a" => {
      print(2)
    }
    "b" => {
      print(3)
    }
  }
}
go()
