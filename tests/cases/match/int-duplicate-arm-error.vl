// @check
// @error-at 14:4 redundant match arm: `0x10` is already covered
// @error-at 22:4 redundant match arm: `2` is already covered
// A literal already claimed by an earlier arm is a DEAD arm (D1572) — the same rule the
// litunion and value-union vocabularies apply, decided on the literal's 64-bit VALUE rather
// than its lexeme, so `0x10` and `16` are one arm. The or-group's alternatives are claimed
// individually, so a later arm repeating one of them is caught too.
//
// `-1` against `1` is NOT a duplicate — the sign is part of the value — which is why the
// third function below type-checks clean and only these two arms are reported.

function a(x: i32): i32 {
  match x {
    16 => 1
    0x10 => 2
    _ => 3
  }
}

function b(x: i32): i32 {
  match x {
    1 | 2 => 1
    2 => 2
    _ => 3
  }
}

function c(x: i32): i32 {
  match x {
    -1 => 1
    1 => 2
    _ => 3
  }
}

print(a(1) + b(1) + c(1))
