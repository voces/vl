// @check
// @error unknown name `MISSING` in match pattern — an arm is a literal, a `const` with a literal value, or the `_` wildcard
// @error match pattern type mismatch: expected K, found i32
// @error redundant match arm: `S` ("a") is already covered
// @error match pattern `Z` ("z") is not a member of K
// @error non-exhaustive match — missing "b" (add the arm or a `_`)
// A literal union's arms are its member strings, and a constant holding one is compared by
// its value (D3271): a name that resolves to nothing is an error, a number constant is the
// wrong type, a constant whose member another arm already covers is dead, one holding a
// string outside the set covers nothing, and constant arms count toward exhaustiveness.
type K = "a" | "b"
const A = 1
const S = "a"
const Z = "z"

function unknown(k: K) {
  match k {
    MISSING => 1
    _ => 0
  }
}

function intOverLu(k: K) {
  match k {
    A => 1
    _ => 0
  }
}

function dup(k: K) {
  match k {
    "a" => 1
    S => 2
    _ => 0
  }
}

function nonMember(k: K) {
  match k {
    Z => 1
    _ => 0
  }
}

function nonExhaustive(k: K) {
  match k {
    S => 1
  }
}

print(unknown("a") + intOverLu("a") + dup("a") + nonMember("a"))
print(nonExhaustive("a"))
