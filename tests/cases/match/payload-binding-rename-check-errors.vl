// @check
// @error duplicate payload binding `a`
// @error payload binding `a` is redeclared in the arm body — rename one
// @error no field 'q' on Pt
// @hint redundant type annotation: `duplicateRename` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `shadowedByBody` is inferred as `i32` — remove it to lean on inference
// What the richer clause forms refuse at the CHECK tier — the two collisions the desugar's
// splice already refused, now speaking about the BINDING name rather than the field (which is
// the name that actually collides once the clause is spliced into the arm body), plus the
// ordinary field-read error reported through a nested chain.
//
// The nested read names the INNER type: `const q = w.p.q` is checked where it is written, so a
// field the nested type lacks is `no field 'q' on Pt`, not a complaint about `Wrap`.
type Move = { x: i32, y: i32 }
type Stop = { z: i32 }
type Cmd = Move | Stop

function duplicateRename(c: Cmd): i32 {
  match c {
    Move{x: a, y: a} => a
    Stop{z} => z
  }
}

function shadowedByBody(c: Cmd): i32 {
  match c {
    Move{x: a} => {
      const a = 9
      a
    }
    Stop{z} => z
  }
}

type Pt = { x: i32, y: i32 }
type Wrap = { p: Pt, tag: i32 }
type Other = { z: i32 }
type W = Wrap | Other

function nestedUnknownField(w: W): i32 {
  match w {
    Wrap{p: {q}} => q
    Other{z} => z
  }
}

print(duplicateRename({ z: 1 }))
print(shadowedByBody({ z: 1 }))
print(nestedUnknownField({ z: 1 }))
