// @run
// @log move 1 2
// @log attack orc
// @log wait
// @log s:move 3 4
// @log s:attack goblin
// @log s:wait
// `match` PAYLOAD BINDING (B21 phase 2b) — the command-dispatch shape the webcraft order
// pipeline wants. A variant pattern may carry a punned field list, and the arm binds one
// arm-local `const` per named field: `Move{x, y} => …` narrows to `Move` AND binds `x`/`y`.
//
// The lowering is the if-chain the arm already was, with the bindings prepended to its block —
// this file's `match` compiles to a BYTE-IDENTICAL module to the hand-written
// `if c is Move { const x = c.x; const y = c.y; … } else if … else { … }`.
//
// A no-payload variant may share the match with binding arms (`Wait` below), and a payload-free
// arm still narrows exactly as phase 2a shipped it.
type Move = { x: i32, y: i32 }
type Attack = { target: string }
type Wait = { turns: i32 }
type Cmd = Move | Attack | Wait

// Expression position: the arms' values join to the match's value.
function render(c: Cmd): string {
  match c {
    Move{x, y} => "move " + toString(x) + " " + toString(y)
    Attack{target} => "attack " + target
    Wait => "wait"
  }
}

// Statement position: void arms, no join. The bindings are ordinary arm-locals.
function show(c: Cmd) {
  match c {
    Move{x, y} => print("s:move " + toString(x) + " " + toString(y))
    Attack{target} => print("s:attack " + target)
    Wait{turns} => {
      const label = "s:wait"
      if turns > 99 { print(label + "!") } else { print(label) }
    }
  }
}

print(render({ x: 1, y: 2 }))
print(render({ target: "orc" }))
print(render({ turns: 3 }))
show({ x: 3, y: 4 })
show({ target: "goblin" })
show({ turns: 1 })
