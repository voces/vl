// @check
// @error-at 21:2 redundant match arm: `A` is already covered
// @error-at 22:2 match pattern `D` is not a member of {a: i32} | {b: i32}
// @error-at 23:2 match pattern `AB` names a union — list its members as separate arms (`A | B => …`)
// @error-at 24:2 invalid match pattern "a" — a pattern over a value union is a member type or the `_` wildcard
// The four ways an arm PATTERN can be wrong over a value union, each named at the pattern:
//   · a member a previous arm already covered (a dead arm);
//   · a type that is not a member at all (`is` would be an always-false test);
//   · a type that resolves to a UNION — one `is` cannot test it (`emitProgram: \`is\` names a
//     type that is not a union variant`, on master too), so the members go in separate arms;
//   · a string literal — that is a LITERAL union's arm vocabulary, not a value union's.
// Coverage is decided by ARENA TYPE (`sameVariantTy`), so the redundancy report does not
// depend on the two arms spelling the member the same way.
type A = { a: i32 }
type B = { b: i32 }
type D = { d: i32 }
type AB = A | B
type U = A | B
const u: U = { a: 1 }
match u {
  A => print(1)
  A => print(2)
  D => print(3)
  AB => print(4)
  "a" => print(5)
  B => print(6)
}
