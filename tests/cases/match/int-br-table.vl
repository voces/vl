// @run
// @log stmt 99 99 10 11 99 13 145 145 99
// @log offset -1 0 -1 7 10 -1
// @log negative 999 50 999 10 0 999
// @log word many one three many
// @log top 3 1 0 0 0
// @log bottom 1 3 0 0
// @log wide other m1 z p2 other other other
// @log nested 1 9 16 19 22 99
// @log loop 334418
// @log fell through
// @log early 100 101 2000 -7 -7
// @log sparse 1 2 3 0
// A dense integer `match` lowers to one `br_table` (PL-001), and every shape it takes must
// answer exactly what the compare chain answered: statement and expression form, a zero, an
// offset and a negative base, holes in the range, the default hit from both sides, the `i32`
// extremes (an offset subtraction must never wrap onto a case), an `i64` scrutinee, or-groups,
// nested matches, `break`/`continue`/`return` inside arms, a string join, and a sparse set
// that stays a chain. The `br_table` itself is asserted by tests/vl_match_br_table_test.ts.

function stmt(x: i32) {
  let r = -1
  match x {
    0 => {
      r = 10
    }
    1 => {
      r = 11
    }
    3 => {
      r = 13
    }
    4 | 5 => {
      r = 145
    }
    _ => {
      r = 99
    }
  }
  r
}

function offset(x: i32) {
  match x {
    100 => 0
    101 => 1
    102 => 2
    104 => 4
    107 => 7
    110 => 10
    _ => -1
  }
}

function negative(x: i32) {
  const v = match x {
    -5 => 50
    -4 => 40
    -3 => 30
    -1 => 10
    0 => 0
    _ => 999
  }
  v
}

function word(x: i32) {
  const s = match x {
    1 => "one"
    2 => "two"
    3 => "three"
    _ => "many"
  }
  s
}

function top(x: i32) {
  match x {
    2147483645 => 1
    2147483646 => 2
    2147483647 => 3
    _ => 0
  }
}

function bottom(x: i32) {
  match x {
    -2147483648 => 1
    -2147483647 => 2
    -2147483646 => 3
    _ => 0
  }
}

function wide(x: i64) {
  match x {
    -1 => "m1"
    0 => "z"
    1 => "p1"
    2 => "p2"
    _ => "other"
  }
}

function nested(a: i32, b: i32) {
  match a {
    0 => match b {
      0 => 0
      1 => 1
      2 => 2
      _ => 9
    }
    1 => match b {
      5 => 15
      6 => 16
      7 => 17
      _ => 19
    }
    2 => 22
    _ => 99
  }
}

function loop() {
  let i = 0
  let acc = 0
  while i < 20 {
    i = i + 1
    const r = i % 5
    match r {
      0 => {
        continue
      }
      1 => {
        acc = acc + 1
      }
      2 => {
        acc = acc + 10
      }
      3 => {
        if i > 15 { break }
        acc = acc + 100
      }
      _ => {
        acc = acc + 1000
      }
    }
  }
  acc * 100 + i
}

function early(x: i32) {
  match x {
    0 => {
      return 100
    }
    1 => {
      return 101
    }
    2 => {
      print("fell through")
    }
    _ => {
      return -7
    }
  }
  2000
}

function sparse(x: i32) {
  match x {
    1 => 1
    1000 => 2
    100000 => 3
    _ => 0
  }
}

let line = ""
let i = -2
while i < 7 {
  line = line + " \{stmt(i)}"
  i = i + 1
}
print("stmt\{line}")
print(
  "offset \{offset(99)} \{offset(100)} \{offset(103)} \{offset(107)} \{offset(110)} \{offset(111)}",
)
print(
  "negative \{negative(-6)} \{negative(-5)} \{negative(-2)} \{negative(-1)} \{negative(0)} \{negative(1)}",
)
print("word \{word(0)} \{word(1)} \{word(3)} \{word(4)}")
print(
  "top \{top(2147483647)} \{top(2147483645)} \{top(2147483644)} \{top(-2147483648)} \{top(0)}",
)
print(
  "bottom \{bottom(-2147483648)} \{bottom(-2147483646)} \{bottom(-2147483645)} \{bottom(2147483647)}",
)
const far = 4294967297
const farNeg = -4294967297
print(
  "wide \{wide(-2)} \{wide(-1)} \{wide(0)} \{wide(2)} \{wide(3)} \{wide(far)} \{wide(farNeg)}",
)
print(
  "nested \{nested(0, 1)} \{nested(0, 5)} \{nested(1, 6)} \{nested(1, 0)} \{nested(2, 0)} \{nested(3, 3)}",
)
print("loop \{loop()}")
print("early \{early(0)} \{early(1)} \{early(2)} \{early(3)} \{early(-1)}")
print("sparse \{sparse(1)} \{sparse(1000)} \{sparse(100000)} \{sparse(2)}")
