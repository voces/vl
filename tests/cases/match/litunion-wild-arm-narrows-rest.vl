// @run
// @log b
// @log a
// @log b
// @log b
// @log a
// @log true
// @log a
// @log b
// @log a
// The `_` arm of a `match` over a literal union sees the scrutinee without the members the arms
// before it consumed, flat or through a nested alias, nullable, a member read and a statement (D5284).
type Kind = "a" | "b"
type Wide = Kind | "c"
type Flat = "a" | "b" | "c" | "d"
type H = { w: Wide }
function nested(k: Wide): Kind {
  match k {
    "c" => "a"
    _ => k
  }
}
function flat(k: Flat): "a" | "b" {
  match k {
    "c" => "a"
    "d" => "b"
    _ => k
  }
}
function nullable(k: Wide | null): Kind | null {
  match k {
    "c" => "a"
    _ => k
  }
}
function member(h: H): Kind {
  match h.w {
    "c" => "a"
    _ => h.w
  }
}
function stmt(k: Wide): Kind {
  let r: Kind = "a"
  match k {
    "c" => {
      r = "b"
    }
    _ => {
      r = k
    }
  }
  r
}
print(nested("b"))
print(nested("c"))
print(flat("d"))
print(flat("b"))
print(nullable("c") ?? "b")
print(nullable(null) == null)
print(member({ w: "c" }))
print(stmt("c"))
print(stmt("a"))
