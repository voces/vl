// @run
// @log 3
// @log 9
// @log 7
// @log 3
// @log 12
// @log 103
// @log 101
// @log 42
// @log 42
// @log 7
// The two richer payload-clause forms, and the shapes that mix them. A clause reads FIELDS, so
// both forms are still the flat clause's `const <name> = <scrut>.<path>` — renaming changes the
// name, nesting lengthens the path, and each arm stays byte-identical to its hand-written
// if-chain twin, which is what phase 2b's lowering rests on.
//
// Every function here leaves its return UN-ANNOTATED, so this is the inferred face: a clause
// binds ordinary `const`s, and the arm's type is inferred exactly as the if-chain twin's is.
// The annotated face is `payload-binding-rename-check-errors.vl`.
type Move = { x: i32, y: i32 }
type Stop = { z: i32 }
type Cmd = Move | Stop

// RENAMING `field: name` — the field is read, the binding takes the written name. `Move{x: x}`
// is legal and is NOT the punned spelling: the formatter prints back what was written.
function renamed(c: Cmd) {
  match c {
    Move{x: a, y: b} => a + b
    Stop{z} => z
  }
}

function mixed(c: Cmd) {
  match c {
    Move{x, y: b} => x + b
    Stop{z} => z
  }
}

function sameName(c: Cmd) {
  match c {
    Move{x: x, y: y} => x + y
    Stop{z} => z
  }
}

print(renamed({ x: 1, y: 2 }))
print(mixed({ x: 4, y: 5 }))
print(sameName({ x: 3, y: 4 }))

// NESTING `field: { … }` — the binding's initializer becomes a `Member` CHAIN, so a nested
// clause needs no narrowing of its own: the arm has already narrowed the scrutinee and the
// field it reads through is concrete.
type Pt = { x: i32, y: i32 }
type Wrap = { p: Pt, tag: i32 }
type Other = { z: i32 }
type W = Wrap | Other

function nested(w: W) {
  match w {
    Wrap{p: {x, y}} => x + y
    Other{z} => z
  }
}

function nestedRenamed(w: W) {
  match w {
    Wrap{p: {x: a, y: b}} => a * 10 + b
    Other{z} => z
  }
}

// A nested group beside a flat binding, in both orders — the group is a contiguous run, so the
// flat binding on either side of it keeps its own level.
function groupThenFlat(w: W) {
  match w {
    Wrap{tag, p: {x, y}} => tag + x + y
    Other{z} => z
  }
}

function flatThenGroup(w: W) {
  match w {
    Wrap{p: {x}, tag} => x + tag
    Other{z} => z
  }
}

print(nested({ p: { x: 1, y: 2 }, tag: 0 }))
print(nestedRenamed({ p: { x: 1, y: 2 }, tag: 0 }))
print(groupThenFlat({ p: { x: 1, y: 2 }, tag: 100 }))
print(flatThenGroup({ p: { x: 1, y: 2 }, tag: 100 }))

// Depth is the source's, not a fixed two: each level lengthens the same chain.
type In = { v: i32 }
type Mid = { i: In }
type Top = { m: Mid, n: i32 }
type OtherT = { z: i32 }
type T = Top | OtherT

function deep(t: T) {
  match t {
    Top{m: {i: {v}}} => v
    OtherT{z} => z
  }
}

function deepBesideFlat(t: T) {
  match t {
    Top{m: {i: {v}}, n} => v + n
    OtherT{z} => z
  }
}

print(deep({ m: { i: { v: 42 } }, n: 0 }))
print(deepBesideFlat({ m: { i: { v: 40 } }, n: 2 }))

// Both forms in VALUE position, which the arm PRELUDE already carries (C6) — a nested clause
// puts the most `const`s in one arm, so it is the form that most needed the prelude to exist.
function inValue(w: W) {
  const r = match w {
    Wrap{p: {x, y}} => x + y
    Other{z} => z
  }
  r
}

print(inValue({ p: { x: 6, y: 1 }, tag: 0 }))
