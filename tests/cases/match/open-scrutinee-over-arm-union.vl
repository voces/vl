// @run
// @log 1
// @log hi!
// @log 5
// @log yy
// @log 0
// @log hi!
// @log 4
// @log 0
// @log -1
// @log 1
// @log 0
// @log 1
// @log 0
// @log 1
// D1885: a `match` over an un-annotated or generic parameter is checked over the union its
// arms name, as the parameter annotated with it is: a literal set, a value union, a record
// union and a type parameter, pinned by a call, a literal argument, a nullable, a forwarder and
// a `_`.
type Color = "red" | "green"
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: string }
function mkColor(): Color { return "red" }
function mkVal(): i32 | string { return "hi" }
function mkRec(): A | B { return { kind: "b", y: "yy" } }
function color(p) {
  match p {
    "red" => print(1)
    "green" => print(0)
  }
}
function value(p) {
  match p {
    i32 => print(p + 1)
    string => print(p + "!")
  }
}
function record(p) {
  match p {
    A => print(p.x)
    B => print(p.y)
  }
}
function generic<T>(p: T) {
  match p {
    i32 => print(p + 1)
    string => print(p + "!")
  }
}
function genericColor<T>(p: T) {
  match p {
    "red" => print(1)
    "green" => print(0)
  }
}
function nullable(p) {
  match p {
    "red" => print(1)
    "green" => print(0)
    null => print(-1)
  }
}
function wild(p) {
  match p {
    "red" => print(1)
    _ => print(0)
  }
}
function outer(q) { color(q) }
color(mkColor())
value(mkVal())
value(4)
record(mkRec())
genericColor("green")
generic(mkVal())
generic(3)
color("green")
const c: Color | null = null
nullable(c)
nullable("red")
const s: string = "blue"
wild(s)
wild("red")
outer("green")
outer("red")
