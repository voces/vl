// @run
// @log 1
// @log 2
// @log 3
// @log a=1
// @log b=2
// @log c=3
// @hint redundant type annotation: `pick` is inferred as `i32`
// `match` over a STRUCT union (B21 phase 2, scrutinee half). Master rejects the whole file
// with "match scrutinee must be a literal union, got {a: i32} | {b: i32} | {c: i32}".
//
// Every arm narrows the scrutinee to its member — INCLUDING the last one, which the desugar
// lowers to the chain's bare `else` (no test). The then-arms narrow through the `is` fact the
// pattern node carries; the else-arm narrows through the union COMPLEMENT the same collector
// already computes for a hand-written `if u is A { … } else { … }`. Reading `u.c` in the last
// arm is the proof: it is only a field of `C`.
type A = { a: i32 }
type B = { b: i32 }
type C = { c: i32 }
type U = A | B | C

// Value position: the arms' types join to the match's value.
function pick(u: U): i32 {
  match u {
    A => u.a
    B => u.b
    C => u.c
  }
}

// Statement position: void arms, no join.
function show(u: U) {
  match u {
    A => print("a=" + toString(u.a))
    B => print("b=" + toString(u.b))
    C => print("c=" + toString(u.c))
  }
}

print(pick({ a: 1 }))
print(pick({ b: 2 }))
print(pick({ c: 3 }))
show({ a: 1 })
show({ b: 2 })
show({ c: 3 })
