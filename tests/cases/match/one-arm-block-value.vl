// @log 11
// @log 100
// @log 2
// @log 30
// @log 1
// A one-arm `match` whose arm is a block is the block's value (D5713), as an initializer, a
// tail, a return, an argument, a list element and a global, with `continue`, `break` and
// `return` inside the block, over an integer, a nullable, a literal union and a record union.
function f(n: i32) {
  const s = match n {
    _ => {
      5
    }
  }
  s
}
function tail(n: i32) {
  match n {
    _ => {
      6
    }
  }
}
function pre(n: i32) {
  const s = match n {
    _ => {
      const a = n + 1; a * 2
    }
  }
  s
}
function strk(k: "a" | "b") {
  match k {
    _ => {
      const t = "x"; t + "y"
    }
  }
}
type Sq = { kind: "sq", w: i32 }
type Ci = { kind: "ci", r: i32 }
function rec(s: Sq | Ci) {
  match s {
    _ => {
      const q = 3; q + 1
    }
  }
}
function ret(n: i32) {
  return match n {
    _ => {
      const z = 3; z
    }
  }
}
function loop() {
  let i = 0
  let acc = 0
  while i < 5 {
    i = i + 1
    const v = match i {
      _ => {
        if i == 2 { continue }
        if i == 4 { break }
        i * 10
      }
    }
    acc = acc + v
  }
  acc
}
function cap(n: i32): () => i32 {
  const g = () => match n {
    _ => {
      const k = n * 3; k
    }
  }
  g
}
print(f(1))
print(tail(1))
print(pre(1))
print(strk("a"))
print(rec({ kind: "sq", w: 4 }))
print(ret(0))
print(loop())
print(cap(2)())
print(
  match 3 {
    _ => {
      const m = 1; m + 7
    }
  },
)
function st(n: i32) {
  let acc = 1
  match n {
    _ => {
      acc = acc + n
    }
  }
  acc
}
function nul(n: i32 | null) {
  const r = match n {
    _ => {
      const z = 9; z
    }
  }
  r
}
function ss(k: "a" | "b") {
  const r = match k {
    _ => {
      const z = 2; z * 2
    }
  }
  r
}
function lit(k: 1 | 2) {
  match k {
    _ => {
      const z = 7; z
    }
  }
}
function arg(n: i32) { n + 1 }
function strv(n: i32) {
  const r = match n {
    _ => {
      "s" + "t"
    }
  }
  r
}
function nested(n: i32) {
  match n {
    _ => {
      match n {
        _ => {
          11
        }
      }
    }
  }
}
function early(n: i32) {
  const r = match n {
    _ => {
      if n > 5 { return 100 }
      n
    }
  }
  r
}
const g = match 2 {
  _ => {
    const q = 30; q
  }
}
print(st(2))
print(nul(null))
print(ss("a"))
print(lit(1))
print(
  arg(
    match 4 {
      _ => {
        const w = 4; w
      }
    },
  ),
)
print(strv(0))
print(nested(1))
print(early(9))
print(early(2))
print(g)
const lst = [
  match 1 {
    _ => {
      1
    }
  },
  2,
]
print(lst[0])
