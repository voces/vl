// @run
// @log 7
// @log 7
// @log NUL
// @log 3
// @log goblin
// @log 7
// @log orc
// @log 1
// Each arm test and payload read of a `match` reads the scrutinee through a node of its own
// (D14538): a subscript place with `null` tested first or last, a parameter with payload
// bindings, and a computed scrutinee that is still evaluated once.
type NtI32 = new i32
type Move = { x: i32, y: i32 }
type Attack = { target: string }
type Wait = { turns: i32 }
type Cmd = Move | Attack | Wait

function srcI(): NtI32 | null { return 7 }

function nullFirst() {
  const xs: (NtI32 | null)[] = [srcI()]
  match xs[0] {
    null => print("NUL")
    NtI32 => print(xs[0])
  }
}

function nullLast(xs: (NtI32 | null)[]) {
  match xs[0] {
    NtI32 => print(xs[0])
    null => print("NUL")
  }
}

function show(c: Cmd) {
  match c {
    Move{x, y} => print(x + y)
    Attack{target} => print(target)
    Wait{turns} => print(turns)
  }
}

let n = 0
function next(): Cmd {
  n = n + 1
  { target: "orc" }
}

nullFirst()
nullLast([srcI()])
nullLast([null])
show({ x: 1, y: 2 })
show({ target: "goblin" })
show({ turns: 7 })
match next() {
  Move{x} => print(x)
  Attack{target} => print(target)
  Wait => print(0)
}
print(n)
