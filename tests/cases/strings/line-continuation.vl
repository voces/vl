// @run
// @log 4
// @log abcd
// @log 4
// @log abcd
// @log 5
// @log 9
// @log 99
// @log 5
// @log ab cd
// STRING LINE CONTINUATION — a backslash immediately before a newline drops BOTH and the
// next line's INDENTATION, and the LEXER and the EMITTER must agree about all of it.
//
// WHY THIS FIXTURE EXISTS. VL decodes a quoted lexeme TWICE, in two different files:
// `lexer.scanQuoted` (lexer.vl) resolves escapes while scanning, and `emit_base.decodeStr`
// resolves them again from the raw lexeme at emit time. The continuation arm was once in the
// lexer alone, so `"ab\<newline> cd"` was five characters to one and six to the other: `vl
// check` clean, the program running, and simply a different string than the source denotes.
//
// The indentation strip is the same hazard one rule further on. It exists so a long literal
// can be indented with the code that holds it, which means the continued line's leading
// whitespace is LAYOUT — and a decoder that keeps it disagrees with one that does not.
// Every arm added to either decoder needs its twin in the other.

// A continuation in the middle: the newline and the next line's indentation both collapse,
// leaving the two runs joined with nothing between them.
const s = "ab\
 cd"
print(s.length)
print(s)

// The same with no indentation at all — the two spellings mean one string, which is the
// point of stripping: how the source is laid out cannot change what it denotes.
const t = "ab\
cd"
print(t.length)
print(t)

// A continuation alongside an ORDINARY escape, so the two paths are exercised in one
// lexeme: `\t` must still produce a tab while `\<newline>` produces nothing at all.
const u = "a\tb\
    cd"
print(u.length)
// By code point, because asserting the rendered string would need a literal tab inside an
// `@log` comment — the kind of invisible-whitespace expectation that rots. `u` is
// `a`,TAB,`b`,`c`,`d`: the escape survived as 9 and the indentation is gone, so `u[3]` is `c`.
print(u[1])
print(u[3])

// A SPACE THE AUTHOR WANTS goes before the backslash, where it is content rather than
// layout — the escape hatch the strip leaves open.
const v = "ab \
    cd"
print(v.length)
print(v)
