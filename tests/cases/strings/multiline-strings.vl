// @run
// @log 17
// @log true
// @log alpha beta gamma
// @log true
// @log 21
// @log a`b
// A `"…"` STRING MAY SPAN LINES, and there is only one string form.
//
// Rust's rule: a raw newline inside the literal is CONTENT, and a `\` immediately before a
// newline joins the next line and drops its indentation, so a long literal can be laid out
// with the code that holds it without the layout becoming part of the string. Holes work
// across lines too — one construct, not a second literal grammar beside it.
//
// A MULTI-LINE VALUE IS ASSERTED BY EQUALITY AND LENGTH, never by printing it: `@log` takes
// the rest of its comment line, so an embedded newline cannot be written there, and an
// expectation that cannot be written down is one that rots. The single-escape spelling on
// the right of each `==` is the same string said the other way.
//
// The refusal is `err-multiline-strings.vl`, which cannot live here: it ends the parse.

// A RAW NEWLINE IS CONTENT. The length is asserted as well as the equality, because a
// newline that survived as two characters would still compare equal to a two-character one.
const raw = "line one
line two"
print(raw.length)
print(raw == "line one\nline two")

// A `\`-JOINED LITERAL, with the continuation indented as the code around it is. The space
// before each backslash is content; the indentation after each newline is not.
const joined = "alpha \
    beta \
    gamma"
print(joined)

// A HOLE ACROSS LINES, with the hole's own expression on its own line — inside a hole a
// newline can never be a statement terminator, so the layout is free there too. The literal
// also spans lines AFTER the hole, so both rules are exercised in one lexeme.
const who = "world"
const across = "hello \{
  who
} and
again"
print(across == "hello world and\nagain")
print(across.length)

// A BACKTICK IS ORDINARY CONTENT. It has no other meaning inside a literal now, which is
// what makes the refusal outside one unambiguous.
print("a`b")
