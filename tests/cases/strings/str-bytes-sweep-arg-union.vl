// @run
// @log 2
// @log 104
// @log 3
// @log 195
// @log 0
// `s.bytes()`, its fresh `u8[]` delivered at arg-union: the length, and the first byte where
// there is one, of an ASCII, a multi-byte and an empty string (Q58 position sweep).
function show(u: u8[] | i32) {
  if u is i32 {
    print(u)
  } else {
    print(u.length)
    if u.length > 0 { print(u[0]) }
  }
}
function go(s: string) {
  show(s.bytes())
}
go("hi")
go("\u{e9}x")
go("")
