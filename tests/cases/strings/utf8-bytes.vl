// @run
// @log 9
// @log 6
// @log 104
// @log 195
// @log 169
// @log 108
// @log 108
// @log 111
// @log 226
// @log 134
// @log 146
// @log 104
// @log 233
// @log 108
// @log 108
// @log 111
// @log 8594
// @log héllo→
// @log true
// @log true
// @log false
// @log true
// @log false
// @log 4
// @log 128512
// @log 1
// @log é
// @log 2
// @log 6
// @log 3
// @log →
// @log true
// @log true
// STAGE 2c — the byte-indexed surface, pinned end to end.
//
// This is the fixture the migration did not have. `strings/escapes.vl` observes the change
// on ONE literal because it happened to assert `"é".length`; nothing in the 1,621-file
// corpus exercised byte indexing, code-point iteration over multi-byte storage, `cpAt`,
// `cpLen`, `isCharBoundary` or `bytes()` deliberately. The completeness gate
// (`vl check --codegen`) only reaches lowerings the corpus reaches, so a lowering with no
// fixture is a lowering no gate certifies.
//
// `"héllo→"` is the canonical example from `docs/guide/strings-design.md`: 6 code points,
// 9 UTF-8 bytes, and one of each width class below 4.
//
//   h    68
//   é    C3 A9        195 169
//   l    6C
//   l    6C
//   o    6F
//   →    E2 86 92     226 134 146

const s = "héllo→"

// `.length` is the BYTE count — O(1), it is the header's `$len`. `cpLen()` is the
// CODE POINT count — O(n), and named so the cost is visible (§Codepoints).
print(s.length)
print(s.cpLen())

// `s[i]` is a BYTE, zero-extended into 0..255. The lead byte of `é` is 195; nothing in
// the string is 233, which is the char-literal trap §Char-literal trap describes.
let i = 0
while i < s.length {
  print(s[i])
  i = i + 1
}

// `for cp in s` yields CODE POINTS — the surface is unchanged, the lowering is now a
// UTF-8 decode with a variable stride.
for cp in s { print(cp) }

// Printing streams the storage bytes straight to the host: no transcode on either side.
print(s)

// `isCharBoundary` — O(1), a lead/continuation bit test. True at 0, true at `len`, true
// at every sequence start, false inside a sequence, false past the end.
print(s.isCharBoundary(0))
print(s.isCharBoundary(1))
print(s.isCharBoundary(2))
print(s.isCharBoundary(9))
print(s.isCharBoundary(10))

// An astral code point is 4 bytes and one iteration.
const emoji = "\u{1F600}"
print(emoji.length)
print(emoji.cpAt(0))
print(emoji.cpLen())

// `slice` takes BYTE offsets and returns a view. Slicing a whole character is ordinary.
print(s.slice(1, 3))
print(s.slice(1, 3).length)

// `indexOf` returns a BYTE offset, in the same coordinate system `slice` consumes — so
// the round trip is invariant even though the number moved (it was 5, it is 6).
const at = s.indexOf("→")
print(at)
print("→".length)
print(s.slice(at, at + "→".length))
print(s.slice(at, at + "→".length) == "→")

// A substring match IS a byte match (str-byte-semantics.md §Property).
print(s.includes("llo"))
