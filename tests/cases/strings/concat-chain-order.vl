// @run
// @log eval a
// @log eval b
// @log eval c
// @log eval d
// @log AA-BB-CC-DD
// @log <1|2|3|4|5|6>
// @log eval p
// @log eval q
// @log eval r
// @log P/Q/R
// @log ABBCCCDDDDABBCCCDDDDABBCCCDDDDABBCCC
// @log ABBCCCDDDD
// @log |A|
// @hint redundant type annotation: `side` is inferred as `string` — remove it to lean on inference
// N-ARY CONCAT PRESERVES EVALUATION ORDER AND SIDE EFFECTS.
// A maximal string `+` chain lowers to ONE sized allocation and one `array.copy`
// per part, instead of one allocation per `+`. The fused lowering evaluates every
// part onto the stack BEFORE it stashes any of them, so this file pins the two
// things that reordering would break: each part runs EXACTLY ONCE, and the prints
// interleave in source order. An interpolation is the same chain — the parser
// desugars `"…\{x}…"` into it — so the six-hole line is the same test.

function side(tag: string, v: string): string {
  print("eval " + tag)
  return v
}

// A four-part chain whose parts are all side-effecting calls.
print(side("a", "AA") + "-" + side("b", "BB") + "-" + side("c", "CC") + "-" + side("d", "DD"))

// A six-hole interpolation: 13 parts after the parser's desugaring.
const n1 = 1
const n2 = 2
const n3 = 3
const n4 = 4
const n5 = 5
const n6 = 6
print("<\{n1}|\{n2}|\{n3}|\{n4}|\{n5}|\{n6}>")

// A NESTED chain inside a part of an outer chain: the inner one finishes with the
// shared part pool before the outer writes a single slot.
print(side("p", "P") + "/" + (side("q", "Q") + "") + "/" + side("r", "R"))

// A long chain (15 parts) and a parenthesised sub-chain, which keeps its own lowering.
const a = "A"
const b = "BB"
const c = "CCC"
const d = "DDDD"
print(a + b + c + d + a + b + c + d + a + b + c + d + a + b + c)
print((a + b) + (c + d))

// An empty part contributes nothing but still occupies its slot.
const e = ""
print("|" + e + a + e + "|")
