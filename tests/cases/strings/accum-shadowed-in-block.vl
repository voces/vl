// @run
// @warning `s` shadows the `s` declared at
// @warning `s` shadows the `s` declared at
// @warning `s` shadows the `s` declared at
// @log aaa
// @log outer
// @log outer!!!
// @log y
// @log yy
// @log yyy
// @log yyyy
// @log xzxzxzxz
// @log zzbbb
// @log zz
// @log aaaaa
// An accumulator is one declaration, not one name: a block-local `let` that shadows a
// live accumulator gets its own buffer, and the outer binding keeps its value across the
// block, including when the two lifetimes interleave inside one loop iteration.

// The inner binding accumulates; the outer one is read and appended after the block.
function after(n: i32) {
  let s = "outer"
  if n > 0 {
    let s = ""
    for i in 0 to n { s = s + "a" }
    print(s)
  }
  print(s)
  for i in 0 to 2 { s = s + "!" }
  s
}
print(after(2))

// Interleaved: the outer accumulator appends before and after each inner one.
function interleaved(n: i32) {
  let s = ""
  for i in 0 to n {
    s = s + "x"
    if i >= 0 {
      let s = ""
      for j in 0 to i { s = s + "y" }
      print(s)
    }
    s = s + "z"
  }
  s
}
print(interleaved(3))

// The inner binding is aliased before it grows; the alias keeps the literal.
function aliased(n: i32) {
  let s = ""
  let keep = ""
  for i in 0 to n {
    s = s + "a"
    if i == 1 {
      let s = "zz"
      keep = s
      for j in 0 to 2 { s = s + "b" }
      print(s)
    }
  }
  print(keep)
  s
}
print(aliased(4))
