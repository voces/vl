// @log null
// A built-in method called through `?.` on a receiver that may be `null` reads it at its
// non-null type in the guarded arm: `?.includes`, `?.slice` and a map's `?.has`, from a
// parameter, a `let` and a closure (D14792).
function inc(a: string | null) { print(a?.includes("b")) }
inc(null)
inc("abc")
const held: string | null = null
print(held?.includes("b"))
function sl(a: string | null) { print(a?.slice(0, 1)) }
sl(null)
sl("abc")
function has(m: {[string]: i32} | null) { print(m?.has("k")) }
has(null)
function viaClosure(a: string | null) {
  const f = () => a?.includes("b")
  print(f())
}
viaClosure("xb")
viaClosure(null)
