// @run
// @log dflt
// @log null
// @log e
// @log 1
// @log 7
// @log n
// @log null
// @log null
// @log p
// @log null
// @log 2
// @log true
// @log null
// A `print` of a `string | null` (or a `boolean | null`) whose argument is a valued `if` opens its
// blocks before the `if`, as legacy writes it: a `??` in an arm, an early `return` from an arm, a
// nested valued `if`, and a condition with an effect, each printing a set value and `null`.
let calls = 0
function f(n: i32) {
  calls = calls + 1
  return n
}
function coal(a: string | null, b: string | null, c: boolean) {
  print(if c { a ?? "dflt" } else { b })
}
function early(a: string | null, c: boolean) {
  print(if c { a } else { return 7 })
  return 1
}
function nest(a: string | null, b: string | null, c: boolean, d: boolean) {
  print(if c { if d { a } else { null } } else { b })
}
function lead(a: string | null, b: string | null, n: i32) {
  print(if f(n) > 0 { a } else { b })
}
function nb(a: boolean | null, b: boolean | null, c: boolean) {
  print(if c { a } else { b })
}
coal(null, "y", true)
coal("x", null, false)
print(early("e", true))
print(early("e", false))
nest("n", "m", true, true)
nest("n", "m", true, false)
nest("n", null, false, false)
lead("p", null, 1)
lead("p", null, 0)
print(calls)
nb(true, null, true)
nb(true, null, false)
