// @run
// @log nx
// @log nxxx
// @log nx
// @log nx
// @log nx
// @log nx
// @log nx
// @log nx
// @log nx
// @log nx
// @log xy
// @log an

// A concatenation delivered to a `string | null` destination reads its operands as strings
// (D2682): a narrowed nullable operand must not be read raw, as the destination's own
// null-keeping read, into the concat's non-null slot, at any position below.
type N = { s: string | null }

function src(): string | null { return "n" }
const cur0 = src()

function field() {
  const n: N = { s: "n" }
  const cur = n.s
  if cur != null { n.s = cur + "x" }
  print(n.s ?? "null")
}

function fieldInLoop() {
  const n: N = { s: "n" }
  for k in 0 until 3 {
    const c = n.s
    if c != null { n.s = c + "x" }
  }
  print(n.s ?? "null")
}

function local() {
  let q: string | null = null
  if cur0 != null { q = cur0 + "x" }
  print(q ?? "null")
}

function binding() {
  if cur0 != null {
    const q: string | null = cur0 + "x"
    print(q ?? "null")
  }
}

function ret(): string | null {
  const c = src()
  if c != null { return c + "x" }
  null
}

function show(v: string | null) { print(v ?? "null") }

function listCell() {
  const xs: (string | null)[] = [null]
  if cur0 != null { xs[0] = cur0 + "x" }
  print(xs[0] ?? "null")
}

function listPush() {
  const xs: (string | null)[] = []
  if cur0 != null { xs.push(cur0 + "x") }
  print(xs[0] ?? "null")
}

function mapValue() {
  const m: {[string]: string | null} = Map()
  if cur0 != null { m["a"] = cur0 + "x" }
  print(m["a"] ?? "null")
}

function structLit() {
  if cur0 != null {
    const n: N = { s: cur0 + "x" }
    print(n.s ?? "null")
  }
}

function sliced() {
  if cur0 != null {
    const q: string | null = (cur0 + "xyz").slice(1, 3)
    print(q ?? "null")
  }
}

function rightOperand() {
  if cur0 != null {
    const q: string | null = "a" + cur0
    print(q ?? "null")
  }
}

field()
fieldInLoop()
local()
binding()
print(ret() ?? "null")
if cur0 != null { show(cur0 + "x") }
listCell()
listPush()
mapValue()
structLit()
sliced()
rightOperand()
