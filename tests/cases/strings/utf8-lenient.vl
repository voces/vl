// @run
// @log 3
// @log 65533
// @log 65533
// @log 65533
// @log 3
// @log false
// @log true
// @log 10
// @log 65533
// @log 65533
// @log 65
// @log 65533
// @log 3
// @log 65533
// @log true
// @log 3
// @log 2
// @log 65533
// @log 233
// @log 2
// @log 195
// @log 169
// @log 2
// @log 233
// STAGE 2c — GO-LEAN VALIDITY, pinned. `docs/guide/strings-design.md` §Validity: a string
// is bytes that are USUALLY UTF-8, not a validated invariant. Nothing here traps, nothing
// here is rejected, and every malformed sequence decodes to U+FFFD (65533).
//
// THE TERMINATION ARGUMENT IS WHAT THIS FILE REALLY PINS. `for cp in s` advances by the
// decoded sequence's WIDTH, and `__utf8_dec__` never reports a width of 0 — a byte that
// begins nothing is consumed as a one-byte U+FFFD. A decoder that returned 0 on a stray
// continuation byte would hang the loop instead of yielding, and no `@log` line can catch a
// hang, so the assertions below double as the liveness check: they only print if it ends.

// SLICING OFF A CHARACTER BOUNDARY IS LEGAL (§API). `"é→"` is C3 A9 E2 86 92; bytes [1,4)
// are A9 (a lone continuation byte) then E2 86 (a 3-byte lead with its tail cut off).
const mid = "é→".slice(1, 4)
print(mid.length)
for cp in mid { print(cp) }
// `cpLen()` agrees with the loop — it DRIVES the same decoder rather than counting
// non-continuation bytes, which would have said 1 here while the loop said 3.
print(mid.cpLen())
// Neither edge of a mid-character slice is a boundary.
print(mid.isCharBoundary(0))
print(mid.isCharBoundary(1))

// `fromCodePoints` SUBSTITUTES U+FFFD for anything with no UTF-8 encoding — a lone
// surrogate (D800), a value past U+10FFFF, and a negative. It does not trap, does not
// reject, and does not DROP: dropping would change `.length` in a way no caller can
// detect, and the tree already held three different answers to this before the swap
// forced one (`docs/internals/utf8-byte-ready.md` §NonScalar).
const bad = [55296, 1114112, 65, 0 - 5]
const t = fromCodePoints(bad)
print(t.length) // 3 + 3 + 1 + 3
for cp in t { print(cp) }

// `fromCodePoint` shares the same encoder, so it substitutes identically — a second
// spelling of the rule would be a second thing that can disagree with it.
const one = fromCodePoint(56000)
print(one.length)
print(one.cpAt(0))
print(one == "\u{FFFD}")

// `print` AGREES with the storage: it streams the replacement bytes rather than dropping
// the code point silently, which is what it used to do.
print(fromCodePoint(55296).length)

// `cpAt` at a NON-boundary offset is not an error either — the byte there begins nothing.
print("é".length)
print("é".cpAt(1))
print("é".cpAt(0))

// Concatenation is byte-level and does not re-validate: two halves of one character,
// separated and rejoined, are the original character again.
const lo = "é".slice(0, 1)
const hi = "é".slice(1, 2)
print(lo.length + hi.length)
print(lo[0])
print(hi[0])
const rejoined = lo + hi
print(rejoined.length)
print(rejoined.cpAt(0))
