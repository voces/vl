// A `??` legacy writes in place (a list `.get`, a `.pop`, a map index, an optional field), after an
// earlier string operand: in an interpolation, a concatenation and a chain, the earlier operand
// first, then the `??`.
// @run
// @log v=1
// @log v=9
// @log k:1!
// @log p=2
// @log m=5
// @log m=0
// @log f=3
// @log f=-1
// @log a1b9c
type R = { n: i32 | null }
function d() { return 9 }
function interp(xs: i32[], i: i32) { print("v=\{xs.get(i) ?? d()}") }
function concat(xs: i32[], i: i32) { print("k:" + "\{xs.get(i) ?? d()}" + "!") }
function popped(xs: i32[]) { print("p=\{xs.pop() ?? d()}") }
function mapped(m: {[string]: i32}, k: string) { print("m=\{m[k] ?? 0}") }
function field(r: R) { print("f=\{r.n ?? -1}") }
function chain(xs: i32[]) { print("a\{xs.get(0) ?? d()}b\{xs.get(5) ?? d()}c") }
interp([1, 2], 0)
interp([1, 2], 7)
concat([1, 2], 0)
popped([1, 2])
const m: {[string]: i32} = Map()
m.set("a", 5)
mapped(m, "a")
mapped(m, "z")
field({ n: 3 })
field({ n: null })
chain([1])
