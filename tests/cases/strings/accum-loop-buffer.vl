// @run
// @log 0
// @log ab
// @log 10
// @log ababababab
// @log [1!, 2!, 3!]
// @log <0:0><0:2><1:0><1:2><2:0><2:2>
// @log [xxx]|xxx
// @log a,bb,ccc,
// @log aba
// @log true
// @log 8
// @log ab-AB-ab
// @log x1x2x3
// @hint redundant type annotation: `build` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `ser` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `grid` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `reset` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `joinIn` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `alias` is inferred as `string` — remove it to lean on inference
// THE LOOP-LOCAL ACCUMULATOR IS A LOWERING, NOT A SPELLING.
// `let s = ""` then `s = s + piece` inside a loop appends into slack the binding's own
// buffer allocated (capacity doubling) instead of allocating an exact-fit string per
// step. This file is the SEMANTIC pin on that: every line below prints the same thing on
// a compiler that does not do it, and the shapes are the ones an in-place append could
// break — a value read mid-loop, an ALIAS taken mid-loop and printed after more appends,
// a `.slice` and an `==` over the accumulator's own backing, a reset to a literal, a
// `break`/`continue`, nested loops, and an un-annotated and an annotated face. The COST
// class is graded separately, by `tests/vl_scaling_shape_test.ts`'s append pair.
import { toString } from "std:fmt"

function build(n: i32): string {
  let s = ""
  let i = 0
  while i < n {
    s = s + "ab"
    i = i + 1
  }
  return s
}

// The ANNOTATED face, a multi-part append, a length read inside the loop, and a `break`.
function ser(xs: i32[]): string {
  let s: string = "["
  let i = 0
  while i < xs.length {
    if i > 0 { s = s + ", " }
    s = s + toString(xs[i]) + "!"
    if s.length > 1000 { break }
    i = i + 1
  }
  return s + "]"
}

// Nested loops and a `continue`.
function grid(n: i32): string {
  let s = ""
  let i = 0
  while i < n {
    let j = 0
    while j < n {
      if j == 1 {
        j = j + 1
        continue
      }
      s = s + "<" + toString(i) + ":" + toString(j) + ">"
      j = j + 1
    }
    i = i + 1
  }
  return s
}

// An ALIAS taken mid-loop, then more appends: the alias must keep the bytes it saw.
function reset(n: i32): string {
  let s = ""
  let i = 0
  let out = ""
  while i < n {
    s = s + "x"
    if i == 2 {
      const snap = s
      out = out + "[" + snap + "]"
      s = ""
    }
    i = i + 1
  }
  return out + "|" + s
}

function joinIn(xs: string[]): string {
  let s = ""
  for x in xs {
    s = s + x + ","
  }
  return s
}

// An alias taken mid-loop and read AFTER the loop has appended past it, plus an
// accumulator whose pieces come from another accumulator.
function alias(): string {
  let a = ""
  let held = ""
  let i = 0
  while i < 3 {
    a = a + "x"
    if i == 0 { held = a }
    i = i + 1
  }
  let b = ""
  let j = 0
  while j < 3 {
    b = b + held
    j = j + 1
  }
  return held + "1" + a.slice(0, 1) + "2" + b.slice(0, 1) + "3"
}

print(build(0).length)
print(build(1))
print(build(5).length)
print(build(5))
print(ser([1, 2, 3]))
print(grid(3))
print(reset(6))
print(joinIn(["a", "bb", "ccc"]))
const g = build(4)
print(g.slice(0, 3))
print(g == "abababab")
print(g.length)
// The accumulator's own backing feeds an UPPERCASE round trip and a re-concat.
print(build(1) + "-AB-" + build(1))
print(alias())
