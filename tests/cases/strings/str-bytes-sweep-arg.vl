// @run
// @log 2
// @log 104
// @log 3
// @log 195
// @log 0
// `s.bytes()`, its fresh `u8[]` delivered at arg: the length, and the first byte where
// there is one, of an ASCII, a multi-byte and an empty string (Q58 position sweep).
function show(b: u8[]) {
  print(b.length)
  if b.length > 0 { print(b[0]) }
}
function go(s: string) {
  show(s.bytes())
}
go("hi")
go("\u{e9}x")
go("")
