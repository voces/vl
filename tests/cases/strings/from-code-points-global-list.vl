// @run
// @log ok
// @log hi
// fromCodePoints over a global list reads the global twice, as over a local.
let acc: i32[] = []
let names: string[] = []
function commit(): i32 {
  names.push(fromCodePoints(acc))
  acc = []
  return 0
}
function local(): string {
  const xs: i32[] = [104, 105]
  return fromCodePoints(xs)
}
acc.push(111)
acc.push(107)
commit()
print(names[0])
print(local())
