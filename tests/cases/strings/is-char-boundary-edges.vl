// `s.isCharBoundary(i)` at each boundary value of a two-code-point string whose second code point
// is two bytes: index 0, a lead byte, a continuation byte, `len`, `len + 1` and a negative index.
// The IR's `charbound` op and legacy share one tail, so both answer each the same.
// @run
// @log true
// @log true
// @log false
// @log true
// @log false
// @log false
const s = "aé"
print(s.isCharBoundary(0))
print(s.isCharBoundary(1))
print(s.isCharBoundary(2))
print(s.isCharBoundary(3))
print(s.isCharBoundary(4))
print(s.isCharBoundary(-1))
