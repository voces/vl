// @run
// @log 1 1-1 1
// @log 2 2-2 2
// @log 2 4 2
// @log 2 2 2
// @log 1 2:1/2 2
// A union-of-lists `.length` staged inside the operand of a root that is itself staged below a
// later valued `if`: a nested interpolation, a call argument, a list literal and two receivers
// (D17089).
const e = [1.5]
const w = ["a", "b"]
function id(a: i32) { return a }
function inner(k: f64[] | string[]) {
  print("\{k.length} \{"\{k.length}-\{k.length}"} \{k.length}")
}
function inArg(k: f64[] | string[]) {
  print("\{k.length} \{id(id(k.length) + k.length)} \{k.length}")
}
function inList(k: f64[] | string[]) {
  print("\{k.length} \{[k.length, k.length].length} \{k.length}")
}
function inNested(k: f64[] | string[], j: f64[] | string[]) {
  print("\{k.length} \{"\{j.length}:\{"\{k.length}/\{j.length}"}"} \{j.length}")
}
inner(e)
inner(w)
inArg(w)
inList(w)
inNested(e, w)
