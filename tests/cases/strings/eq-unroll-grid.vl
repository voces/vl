// @run
// @log cmps 975
// @log trues 75
// @log disagree 0
// @log uni-ok 1
// @log long-ok 1
// Adversarial grid for string value-equality (`__str_eq__`). The element loop
// compares eight code points per iteration with a scalar remainder, so the shapes
// that can break it are LENGTH-shaped: a length that is an exact multiple of the
// unroll factor, one either side of it, and a difference sitting at every single
// position (the last index of a full block and the first index of the remainder
// are the two that an off-by-one moves).
//
// `refEq` is an INDEPENDENT oracle: it walks code points through `s[i]` and never
// uses `==`, so a disagreement is a real defect rather than a tautology. The
// `cmps`/`trues` totals exist so the grid cannot pass by running nothing.
const ALPHA = "abcdefghijklmnopqrstuvwxyz"

// String value-equality computed WITHOUT `==` — the oracle. 1 = equal.
function refEq(a: string, b: string): i32 {
  if a.length != b.length { return 0 }
  let i = 0
  while i < a.length {
    if a[i] != b[i] { return 0 }
    i = i + 1
  }
  return 1
}

// A `len`-char string. When `flip >= 0` the character at that index is bumped by
// one, so the result differs from `mk(len, -1)` at exactly that one position.
function mk(len: i32, flip: i32): string {
  let s = ""
  let i = 0
  while i < len {
    let k = (i * 7 + 3) % 26
    if i == flip { k = (k + 1) % 26 }
    s = s + ALPHA.slice(k, k + 1)
    i = i + 1
  }
  return s
}

function main() {
  let cmps = 0
  let trues = 0
  let disagree = 0
  // Lengths 0..24 span the unroll factor 8 and its multiples 0/8/16/24 with one
  // either side of each.
  let len = 0
  while len <= 24 {
    const a = mk(len, -1)
    // Identity: the same object against itself (the `ref.eq` short circuit).
    let g0 = 0
    if a == a { g0 = 1 }
    if g0 != refEq(a, a) { disagree = disagree + 1 }
    trues = trues + g0
    cmps = cmps + 1
    // Equal content, distinct objects: the full walk, no short circuit.
    const b = mk(len, -1)
    let g1 = 0
    if a == b { g1 = 1 }
    if g1 != refEq(a, b) { disagree = disagree + 1 }
    trues = trues + g1
    cmps = cmps + 1
    // `!=` has to mirror `==` exactly.
    let g2 = 1
    if a != b { g2 = 0 }
    if g2 != refEq(a, b) { disagree = disagree + 1 }
    // A difference at EVERY position, one position at a time.
    let f = 0
    while f < len {
      const c = mk(len, f)
      let g3 = 0
      if a == c { g3 = 1 }
      if g3 != refEq(a, c) { disagree = disagree + 1 }
      trues = trues + g3
      cmps = cmps + 1
      f = f + 1
    }
    // Every other length, in both directions — the length gate answers first.
    let m = 0
    while m <= 24 {
      const d = mk(m, -1)
      let g4 = 0
      if a == d { g4 = 1 }
      if g4 != refEq(a, d) { disagree = disagree + 1 }
      trues = trues + g4
      cmps = cmps + 1
      m = m + 1
    }
    len = len + 1
  }
  print("cmps " + toString(cmps))
  print("trues " + toString(trues))
  print("disagree " + toString(disagree))

  // Non-ASCII: VL strings are UTF-32-backed, so a code point above the BMP is ONE
  // element and compares element-wise like any other. Length 9 puts the differing
  // astral character in the scalar remainder, past one full eight-element block.
  let u1 = ""
  let u2 = ""
  let u3 = ""
  let ui = 0
  while ui < 9 {
    u1 = u1 + fromCodePoint(955 + ui)
    u2 = u2 + fromCodePoint(955 + ui)
    if ui == 8 { u3 = u3 + fromCodePoint(128512) } else {
      u3 = u3 + fromCodePoint(955 + ui)
    }
    ui = ui + 1
  }
  let uniOk = 1
  if refEq(u1, u2) != 1 { uniOk = 0 }
  let ue = 0
  if u1 == u2 { ue = 1 }
  if ue != 1 { uniOk = 0 }
  let un = 0
  if u1 == u3 { un = 1 }
  if un != 0 { uniOk = 0 }
  print("uni-ok " + toString(uniOk))

  // Long strings: 1000 elements is 125 full blocks, and 1001/999 straddle it.
  // A difference at the very last index is the case a wrong remainder bound drops.
  let longOk = 1
  const p = mk(1000, -1)
  const q = mk(1000, -1)
  const r = mk(1000, 999)
  let e1 = 0
  if p == q { e1 = 1 }
  if e1 != 1 { longOk = 0 }
  let e2 = 0
  if p == r { e2 = 1 }
  if e2 != 0 { longOk = 0 }
  const p1 = mk(1001, -1)
  const r1 = mk(1001, 1000)
  let e3 = 0
  if p1 == r1 { e3 = 1 }
  if e3 != 0 { longOk = 0 }
  const p2 = mk(999, -1)
  const r2 = mk(999, 998)
  let e4 = 0
  if p2 == r2 { e4 = 1 }
  if e4 != 0 { longOk = 0 }
  print("long-ok " + toString(longOk))
}

main()
