// @run
// @log 6
// @log 104
// @log 195
// @log 169
// @log 108
// @log 108
// @log 111
// @log 2
// @log 195
// @log 169
// @log 3
// @log 65
// @log é
// @log 2
// @log true
// @log 0
// STAGE 2c — `s.bytes()`, the `u8[]` of a string's UTF-8 storage (§Byte view).
//
// IT COPIES, AND THAT IS A DECISION, NOT AN OVERSIGHT. `strings-design.md` §Byte view
// specified a zero-copy view; two things make that unbuildable today and both are pinned
// here rather than left as prose:
//
//   1. A `u8[]` wrapper is `{backing, len, cap}` — it has NO `start` field, so `xs[i]` is
//      always `backing[i]`. A string VIEW whose `start` is non-zero therefore has no `u8[]`
//      spelling at all. `s.slice(1, 3).bytes()` below is that case, and it must yield the
//      SLICE's two bytes, not the parent's first two.
//   2. A `u8[]` is MUTABLE. §Byte view justified aliasing with "strings are immutable", but
//      that argument is one-directional: it shows the string cannot change under the view,
//      not that the view cannot change under the string. An aliasing `bytes()` would hand
//      out a writable pointer into an immutable string's storage — breaking the cached hash
//      (§Equality), slice views (§Header) and the defensive-copy-free aliasing argument in
//      one method call. The last block below pins that a write to the result is invisible
//      to the string.
//
// The copy is one `array.copy` — a memcpy — which is what keeps it a core intrinsic rather
// than four lines of VL under OQ-3's rule.

const s = "héllo"
const b = s.bytes()
print(b.length)
let i = 0
while i < b.length {
  print(b[i])
  i = i + 1
}

// A VIEW's bytes are the view's.
const v = s.slice(1, 3)
const vb = v.bytes()
print(vb.length)
print(vb[0])
print(vb[1])

// The result is a fresh, mutable, growable `u8[]` the caller owns — the same contract
// `std:utf8`'s `encodeUtf8` has always had, which is why collapsing it to `self.bytes()`
// changes nothing for its callers (`utf8-byte-ready.md` §Ownership).
vb[0] = 65
vb.push(33)
print(vb.length)
print(vb[0])
print(v)
print(v.length)
print(v == "é")

// An empty string yields an empty list, not a null.
print("".bytes().length)
