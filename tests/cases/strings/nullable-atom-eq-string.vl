// @log false
// @log true
// @log false
// @log true
// A nullable literal-union atom compared with a string reads as a nullable string, its null the
// null ref, so it compares as `string | null` against `string` does (D16822).
type P = "i32" | "str"
function pick(n: i32): P | null {
  if n == 0 { return null }
  if n == 1 { return "str" }
  return "i32"
}
function ne(n: i32, w: string) { return pick(n) != w }
print(ne(0, "str"))
print(ne(1, "str"))
print("str" == pick(0))
print("str" == pick(1))
type R = { p: P | null }
function fieldEq(r: R, w: string) { return r.p == w }
print(fieldEq({ p: null }, "str"))
print(fieldEq({ p: "str" }, "str"))
