// @run
// @log 2
// @log 104
// @log 3
// @log 195
// @log 0
// `s.bytes()`, its fresh `u8[]` delivered at return: the length, and the first byte where
// there is one, of an ASCII, a multi-byte and an empty string (Q58 position sweep).
function bytesOf(s: string): u8[] {
  return s.bytes()
}
function go(s: string) {
  const b = bytesOf(s)
  print(b.length)
  if b.length > 0 { print(b[0]) }
}
go("hi")
go("\u{e9}x")
go("")
