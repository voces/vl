// @run
// @log 2
// @log 104
// @log 3
// @log 195
// @log 0
// `s.bytes()`, its fresh `u8[]` delivered at nested-arg: the length, and the first byte where
// there is one, of an ASCII, a multi-byte and an empty string (Q58 position sweep).
function lenOf(b: u8[]) {
  return b.length
}
function firstOf(b: u8[]) {
  return if b.length > 0 { b[0] } else { -1 }
}
function go(s: string) {
  print(lenOf(s.bytes()))
  if s.length > 0 { print(firstOf(s.bytes())) }
}
go("hi")
go("\u{e9}x")
go("")
