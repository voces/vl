// @run
// @log 1 1
// @log 2 2
// @log 11
// @log 22
// @log 22
// @log 4
// @log n2-2
// @log 1/1
// @log 2:2
// @log 2<2
// @log 2?2
// @log 202
// @log 4
// @log 1 2 1
// Two `.length` reads of one union-of-lists binding in one expression, at each position a
// string or value can take them: interpolation, call arguments, `+`, concat, return, a `let`
// initializer, an `if` arm, `??`, record fields and list elements (D17089).
const e = [1.5]
const w = ["a", "b"]
type P = { a: i32, b: i32 }
function two(a: i32, b: i32) { return a * 10 + b }
function id(a: i32) { return a }
function interp(k: f64[] | string[]) { print("\{k.length} \{k.length}") }
function arg(k: f64[] | string[]) { print(two(k.length, k.length)) }
function nested(k: f64[] | string[]) { print(two(id(k.length), id(k.length))) }
function sum(k: f64[] | string[]) { print(k.length + k.length) }
function cat(k: f64[] | string[]) {
  print("n" + "\{k.length}" + "-" + "\{k.length}")
}
function ret(k: f64[] | string[]) { return "\{k.length}/\{k.length}" }
function letInit(k: f64[] | string[]) {
  const s = "\{k.length}:\{k.length}"
  print(s)
}
function ifArm(k: f64[] | string[], c: boolean) {
  const s = if c { "\{k.length}<\{k.length}" } else { "x" }
  print(s)
}
function coal(k: f64[] | string[], m: string | null) {
  print(m ?? "\{k.length}?\{k.length}")
}
function rec(k: f64[] | string[]) {
  const p: P = { a: k.length, b: k.length }
  print(p.a + p.b * 100)
}
function lst(k: f64[] | string[]) {
  const xs = [k.length, k.length]
  print(xs[0] + xs[1])
}
function three(k: f64[] | string[], j: f64[] | string[]) {
  print("\{k.length} \{j.length} \{k.length}")
}
interp(e)
interp(w)
arg(e)
arg(w)
nested(w)
sum(w)
cat(w)
print(ret(e))
letInit(w)
ifArm(w, true)
coal(w, null)
rec(w)
lst(w)
three(e, w)
