// @run
// @log a=yes!
// @log a=no!
// @log k=y|k=
// A literal lead below a valued `if` in a string concat: the IR stages it in place. `h` writes
// the same literal staged and unstaged in one function.
function f(c: boolean) { return "a=" + (if c { "yes" } else { "no" }) + "!" }
function h(c: boolean) {
  const a = "k=" + (if c { "y" } else { "n" })
  return a + "|" + "k="
}
print(f(true))
print(f(false))
print(h(true))
