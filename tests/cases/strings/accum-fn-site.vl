// @run
// @log <<<ababababzzrrrRRR
// @log ababababccc
// @log abababab
// @log qqqww
// @log qqq
// D2669: an append site outside any loop, in a helper a loop calls, extends in place across
// calls, and an alias, a snapshot, a restore, a re-entrant call or a second site sharing the
// string still copies, so every printed value is the copying lowering's.
type B = { s: string }
let g = ""
const snaps: string[] = []
function addG(x: string) { g = g + x }
function preG(x: string) { g = x + g }
function addO(b: B, x: string) { b.s = b.s + x }
function rec(n: i32) {
  if n > 0 {
    g = g + "r"
    rec(n - 1)
    g = g + "R"
  }
}
const o: B = { s: "" }
for i in 0 until 4 { addG("ab") }
snaps.push(g)
for i in 0 until 3 { addG("c") }
const keep = g
g = snaps[0]
for i in 0 until 2 { addG("z") }
rec(3)
for i in 0 until 3 { preG("<") }
for i in 0 until 3 { addO(o, "q") }
const shared = o.s
for i in 0 until 2 { addO(o, "w") }
print(g)
print(keep)
print(snaps[0])
print(o.s)
print(shared)
