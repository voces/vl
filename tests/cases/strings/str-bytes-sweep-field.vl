// @run
// @log 2
// @log 104
// @log 3
// @log 195
// @log 0
// `s.bytes()`, its fresh `u8[]` delivered at field: the length, and the first byte where
// there is one, of an ASCII, a multi-byte and an empty string (Q58 position sweep).
function go(s: string) {
  const r = { b: s.bytes() }
  print(r.b.length)
  if r.b.length > 0 { print(r.b[0]) }
}
go("hi")
go("\u{e9}x")
go("")
