// @run
// @log lit true false false false true true
// @log ne false true true
// @log empty true false true
// @log utf8 true false false true false
// @log is true false false
// @log union true false false
// @log nullable false true false false
// @log generic true false false
// @log shapes true false true false
// A string `==` against a quoted literal tests the literal's constant UTF-8 length before it
// calls `__str_eq__`. Operands are built at run time, so none is the literal's pooled object.

function mk(a: string, b: string) { a + b }

function isHi(s: string | i32) { s is "hi" }

function nulEq(s: string | null) { s == "hi" }

const hi = mk("h", "i")
const ha = mk("h", "a")
const hii = mk("hi", "i")
const e = mk("", "")
const eAcute = mk("", "é")
const nihon = mk("日", "本")

print(
  "lit \{hi == "hi"} \{ha == "hi"} \{hii == "hi"} \{"hi" == hii} \{"hi" == hi} \{hi == hi}",
)
print("ne \{hi != "hi"} \{ha != "hi"} \{"hi" != hii}")
print("empty \{e == ""} \{hi == ""} \{"" == e}")
print(
  "utf8 \{eAcute == "é"} \{eAcute == "e"} \{eAcute == "ab"} \{nihon == "日本"} \{nihon == "日本x"}",
)
print("is \{hi is "hi"} \{ha is "hi"} \{hii is "hi"}")
print("union \{isHi(hi)} \{isHi(hii)} \{isHi(7)}")
print("nullable \{nulEq(null)} \{nulEq(hi)} \{nulEq(ha)} \{nulEq(hii)}")
print("generic \{hi == mk("h", "i")} \{hi == ha} \{hi == hii}")
const r1 = { name: hi }
const r2 = { name: mk("h", "i") }
const r3 = { name: hii }
print(
  "shapes \{r1 == r2} \{r1 == r3} \{[hi, ha] == [mk("h", "i"), mk("h", "a")]} \{[hi] == [hii]}",
)
