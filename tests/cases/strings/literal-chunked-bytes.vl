print(big.length)
print(big.cpLen())
print(big[0])
print(big.cpAt(0))
print(big.slice(0, 3))
print(big.slice(10197, 10200) == "→")
let n = 0
for cp in big { n = n + 1 }
print(n)
print(big == big.slice(0, 10200))
