// @run
// @log 0
// @log 5
// @log 195
// @log 3
// @log 97
// @log 2
// @log 98
// `s.bytes()` over an empty string, a multi-byte UTF-8 string (`é→`, 2 + 3 bytes) and a string
// built by concatenation: the length, then one byte where there is one.
function show(b: u8[]) {
  print(b.length)
  if b.length > 1 { print(b[0]) }
}
function go(t: string) {
  show("".bytes())
  show("\u{e9}\u{2192}".bytes())
  show(("a" + t).bytes())
  show(t.bytes())
}
go("bc")
