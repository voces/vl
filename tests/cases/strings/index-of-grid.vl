// @run
// @log pairs 336
// @log found 88
// @log disagree 0
// @log inc-disagree 0
// @hint redundant type annotation: `refIndexOf` is inferred as `i32`
// @hint redundant type annotation: `rep` is inferred as `string`
// @hint redundant type annotation: `mk` is inferred as `string`
// Adversarial grid for `indexOf` / `includes`. The search is a first-character
// skip loop that escalates to Boyer-Moore-Horspool above a length gate, so the
// shapes that can break it are the ones a skip gets wrong: an empty needle, a
// needle longer than the haystack, a needle equal to the haystack, a match at
// index 0 and at the very last start, an absent needle, and the classic
// repeated-character worst case (`aaaa...` searched for `aaab`) where every
// candidate matches on its first characters and fails at the last.
//
// The grid is a full CROSS PRODUCT of haystacks and needles, so "needle longer
// than haystack", "needle equal to haystack" and "needle absent" all arise
// without being enumerated by hand. Haystack lengths straddle 64/512/2048 so
// every candidate length gate has cases on both sides of it.
//
// `refIndexOf` is an INDEPENDENT oracle: a naive scan over `s[i]` that never
// calls `indexOf`, so a disagreement is a real defect rather than a tautology.
const ALPHA = "abcdefghijklmnopqrstuvwxyz"

// First index of `sub` in `s`, or -1, computed WITHOUT `indexOf` — the oracle.
// An empty needle yields 0 (the JS convention the builtin follows).
function refIndexOf(s: string, sub: string): i32 {
  const n = s.length
  const m = sub.length
  let i = 0
  while i <= n - m {
    let j = 0
    // `j = m + 1` leaves the loop on a mismatch, so a full match is exactly `j == m`.
    while j < m {
      if s[i + j] == sub[j] { j = j + 1 } else { j = m + 1 }
    }
    if j == m { return i }
    i = i + 1
  }
  return -1
}

// `unit` repeated until it is `n` characters long, then truncated to exactly `n`.
function rep(unit: string, n: i32): string {
  let s = unit
  while s.length < n { s = s + s }
  return s.slice(0, n)
}

// A `len`-char string with no short period, so slices of it are rare needles.
function mk(len: i32): string {
  let s = ""
  let i = 0
  while i < len {
    const k = (i * 7 + (i / 13) * 3 + 5) % 26
    s = s + ALPHA.slice(k, k + 1)
    i = i + 1
  }
  return s
}

function main() {
  const big = mk(2048)
  const hays: string[] = []
  // Degenerate and sub-unroll lengths.
  hays.push("")
  hays.push("a")
  hays.push("ab")
  // A repeated-character haystack at the unroll factor and one either side.
  hays.push(rep("a", 7))
  hays.push(rep("a", 8))
  hays.push(rep("a", 9))
  // Short period, so a bad-character skip is always small.
  hays.push(rep("ab", 80))
  // Straddling a 64-character gate.
  hays.push(mk(63))
  hays.push(mk(64))
  hays.push(mk(65))
  // Straddling a 512-character gate, both aperiodic and single-character.
  hays.push(mk(511))
  hays.push(mk(512))
  hays.push(rep("a", 600))
  // Above any gate under consideration.
  hays.push(big)

  const subs: string[] = []
  // Empty and single characters, present and absent.
  subs.push("")
  subs.push("a")
  subs.push("b")
  subs.push("Q")
  // Two and three characters.
  subs.push("ab")
  subs.push("ba")
  subs.push("aa")
  subs.push("aQ")
  subs.push("aaa")
  // The Boyer-Moore-Horspool worst case: every candidate matches its first
  // characters and fails on the last one, so the shift is always 1.
  subs.push("aaab")
  subs.push("aaaaaaab")
  // Exactly the unroll factor and one either side, all one character.
  subs.push(rep("a", 7))
  subs.push(rep("a", 8))
  subs.push(rep("a", 9))
  // Needles taken FROM the long haystack: at index 0, in the middle, and ending
  // at the very last character (the last legal start).
  subs.push(big.slice(0, 1))
  subs.push(big.slice(0, 12))
  subs.push(big.slice(1000, 1012))
  subs.push(big.slice(2036, 2048))
  subs.push(big.slice(2047, 2048))
  // Present-but-corrupted: the same slices with one character replaced by a
  // letter the alphabet-generated haystacks never contain.
  subs.push(big.slice(0, 6) + "Q" + big.slice(7, 12))
  subs.push(big.slice(1000, 1011) + "Q")
  subs.push("Q" + big.slice(1001, 1012))
  // Longer than every haystack but the last, and equal to the whole of one.
  subs.push(rep("a", 600))
  subs.push(mk(64))

  let pairs = 0
  let found = 0
  let disagree = 0
  let incDisagree = 0
  let h = 0
  while h < hays.length {
    let t = 0
    while t < subs.length {
      const s = hays[h]
      const sub = subs[t]
      const want = refIndexOf(s, sub)
      const got = s.indexOf(sub)
      if got != want { disagree = disagree + 1 }
      if got >= 0 { found = found + 1 }
      // `includes` is `indexOf(sub) != -1` and must agree with the oracle too.
      let inc = 0
      if s.includes(sub) { inc = 1 }
      let wantInc = 0
      if want >= 0 { wantInc = 1 }
      if inc != wantInc { incDisagree = incDisagree + 1 }
      pairs = pairs + 1
      t = t + 1
    }
    h = h + 1
  }
  print("pairs " + toString(pairs))
  print("found " + toString(found))
  print("disagree " + toString(disagree))
  print("inc-disagree " + toString(incDisagree))
}

main()
