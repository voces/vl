// @run
// @log ab
// @log xyx
// @log abc
// @log a
// @log b
// @log c
// @log end
// A string operand is built as a string at every concatenation: a literal-union part decodes to
// its member, in an accumulator append inside a loop, straight, beside another part and in a plain
// concatenation; a call that never returns is that call, at each of those positions.
type K = "x" | "y"
type B = (s: string) => never
function loopAcc(n: i32) {
  let out = ""
  let i = 0
  while i < n {
    let s: "a" | "b" = "a"
    if i % 2 == 1 { s = "b" }
    out = out + s
    i = i + 1
  }
  return out
}
function straight(k: K, j: K) {
  let out = ""
  out = out + k
  out = out + j + k
  return out
}
function plain(k: "c") { return "a" + "b" + k }
function accNever(bail: B, c: boolean) {
  let out = "a"
  if c { return out }
  out = out + bail("acc")
  return out
}
function catNever(bail: B, c: boolean) {
  if c { return "b" }
  return "a" + bail("cat")
}
function midNever(bail: B, c: boolean) {
  if c { return "c" }
  return "a" + bail("mid") + "z"
}
function bail(s: string): never {
  print(s)
  __trap__()
}
const l = (s: string): never => {
  print(s)
  __trap__()
}
print(loopAcc(2))
print(straight("x", "y"))
print(plain("c"))
print(accNever(l, true))
print(catNever(l, true))
print(midNever(l, true))
print("end")
