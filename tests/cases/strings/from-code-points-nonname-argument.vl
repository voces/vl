// @run
// @log Hi
// @log Hi
// @log Hi
// @log Hi
// @log Hi
// @log Hi
// @log 1
// @log 0
// The `fromCodePoints` argument is evaluated ONCE into a scratch local, so every spelling
// lowers: a literal, a struct field, a call result and a `.slice`, beside the two
// re-readable forms — a bare name and a parenthesised one — that were all the arm accepted
// while it emitted its argument twice. `calls` is the once-only proof (D1640).
let calls = 0
function mk() {
  calls = calls + 1
  [72, 105]
}
const cps = [72, 105, 33]
const o = { xs: [72, 105] }
const named = [72, 105]
print(fromCodePoints([72, 105]))
print(fromCodePoints(o.xs))
print(fromCodePoints(mk()))
print(fromCodePoints(cps.slice(0, 2)))
print(fromCodePoints(named))
print(fromCodePoints((named)))
print(calls)
print(fromCodePoints([]).length)
