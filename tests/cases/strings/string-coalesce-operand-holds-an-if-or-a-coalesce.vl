// A `string | null` operand of a `??` with a string-literal default, where the operand itself holds
// a valued `if` or an inner `??`; and a `null`-typed `if` run for its effect inside a `??` after an
// earlier operand still waiting. Each is printed, concatenated, passed, returned and compared, with
// both arms of every `if` taken.
// @run
// @log a
// @log none
// @log x-b
// @log x-none
// @log c
// @log none
// @log true
// @log d!
// @log none!
// @log 14
// @log 13
// @log false
// @log 16
// @log f
// @log x-none
function pick(c: boolean, s: string | null, t: string | null) {
  return (if c { s } else { t }) ?? "none"
}
function inner(s: string | null, t: string | null) { return (s ?? t) ?? "none" }
function id(s: string | null) { return s }
function viaArg(c: boolean, s: string | null) {
  return id(if c { s } else { null }) ?? "none"
}
function show(v: string) { return v + "!" }
function same(c: boolean, s: string | null) {
  return ((if c { s } else { null }) ?? "none") == "none"
}
type R = { n: i32 }
function viaField(r: R, c: boolean) {
  const x = null
  return r.n + ((if c { x } else { x }) ?? 11)
}
function viaLocal(c: boolean) {
  const x = null
  const k = 2
  return k + ((if c { x } else { x }) ?? 11)
}
function viaEq(k: i32, c: boolean) {
  const x = null
  return k == ((if c { x } else { x }) ?? 11)
}
function five() { return 5 }
function viaCall(c: boolean) {
  const x = null
  return five() + ((if c { x } else { x }) ?? 11)
}
print(pick(true, "a", "b"))
print(pick(false, "a", null))
print("x-" + pick(false, null, "b"))
print("x-" + inner(null, null))
print(inner(null, "c"))
print(inner(null, null))
print(same(false, "q"))
print(show(inner("d", null)))
print(show(pick(true, null, "e")))
print(viaField({ n: 3 }, true))
print(viaLocal(false))
print(viaEq(4, true))
print(viaCall(false))
print(viaArg(true, "f"))
print("x-" + viaArg(false, "f"))
