// @run
// @log 3
// @log 10
// @log 97
// @log 98
// @log 1
// @log 9
// @log 1
// @log 13
// @log 3
// @log 92
// @log 1
// @log 34
// @log 1
// @log 39
// @log 1
// @log 0
// @log 1
// @log 65
// @log 1
// @log 233
// @log 10
// @log 8
// @log 12
// @log 11
// @log 128512
// String escape-sequence decoding. A string literal's stored value holds the
// DECODED characters, so `\n` is a single char (code 10), not a backslash + n.
// The token span still measures the raw 2-char source extent, but `.length`
// and `charCodeAt` see the logical, decoded string.

// "a\nb" is 3 chars: 'a', newline (10), 'b'.
const nl = "a\nb"
print(nl.length)
print(nl.charCodeAt(1))
print(nl.charCodeAt(0))
print(nl.charCodeAt(2))

// "\t" is one char, code 9.
const tab = "\t"
print(tab.length)
print(tab.charCodeAt(0))

// "\r" is one char, code 13.
const cr = "\r"
print(cr.length)
print(cr.charCodeAt(0))

// "a\\b" is 3 chars with a single backslash (92) at index 1.
const bs = "a\\b"
print(bs.length)
print(bs.charCodeAt(1))

// Escaped quote inside a double-quoted string: one char, code 34.
const dq = "\""
print(dq.length)
print(dq.charCodeAt(0))

// Escaped single quote: one char, code 39.
const sq = "\'"
print(sq.length)
print(sq.charCodeAt(0))

// Null escape: one char, code 0.
const nul = "\0"
print(nul.length)
print(nul.charCodeAt(0))

// \xXX hex escape: \x41 == 'A' (65).
const hx = "\x41"
print(hx.length)
print(hx.charCodeAt(0))

// \uXXXX unicode escape: é == 'é' (233).
const u = "\u00e9"
print(u.length)
print(u.charCodeAt(0))

// A decoded newline really is a newline char (code 10), not '\' + 'n'.
const combined = "x\ny"
print(combined.charCodeAt(1))

// ── the three simple escapes NO fixture reached, and the braced `\u{…}` form ────
// `\b` (8), `\f` (12) and `\v` (11) are arms of BOTH escape decoders — the lexer's
// `decodeSimpleEscape` table and `emit_base.decodeStr` — and until now neither was pinned
// by any corpus file. (A grep for them matches this file only because of the `"a\\b"`
// BACKSLASH case above, which is a different thing entirely.)
//
// That matters because VL decodes a quoted lexeme TWICE, in two files, and the two ladders
// must stay arm-for-arm. They diverged once already: `decodeStr` had no line-continuation
// arm while the lexer did, so `"ab\<newline> cd"` was 5 chars to one and 6 to the other —
// check-clean, and uncovered by 2,075 fixtures until #1837. These three are the remaining
// arms present in both decoders and asserted by neither, which is the same one-revert-from-
// silent-divergence position. Verified in-sync at 13 arms each as of this commit.
//
// All three are ASCII control characters, so `.length` and the code point are IDENTICAL
// under today's code-point indexing and under the coming UTF-8 byte surface. These
// assertions are migration-INVARIANT by construction.
const bsp = "\b"
const ff = "\f"
const vt = "\v"
print(bsp.charCodeAt(0))
print(ff.charCodeAt(0))
print(vt.charCodeAt(0))

// The BRACED `\u{…}` form, with an ASTRAL code point — the one escape that admits the full
// Unicode range and the only shape that exercises the multi-byte encode path end to end.
//
// Asserted through `for cp in s` DELIBERATELY, not `charCodeAt(0)` or `.length`: iteration
// yields CODE POINTS under both representations, so this line survives the migration
// unchanged. `.length` here is 1 today and becomes 4 (UTF-8 bytes), and `charCodeAt(0)`
// goes 128512 → 240; pinning either would just have to be rewritten, and a fixture rewritten
// to match new behaviour is worth nothing as a check.
const astral = "\u{1F600}"
for cp in astral { print(cp) }
