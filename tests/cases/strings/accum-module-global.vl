// @run
// @log aaaa
// @log aaaabbbb
// @log 4
// @log xxx
// @log 3
// @log 1111
// @log 1111111111
// @log xxx|xxx|xxx|
// @log xxx
// @log abc
// @log abcabcabcabcabczzzzz
// @log a-ba-ba-ba-b
// @log 12
// @log 0,1,2,3,
// @log wwww
// @log ppppppppp
// @log xxxxx
// @log 5
// @log zyyy
// @log xxx!
// @log abccc
// @log inner!
// @log inner!
// @log inner!
// @log xxx
// THE MODULE-GLOBAL ACCUMULATOR IS THE SAME LOWERING, ADDRESSED AT A CELL.
// `accum-loop-buffer.vl` pins the function-scope face; this file pins the top-level one,
// where the binding is a wasm global rather than a slot. Every line below must print the
// same thing whether the append allocates a fresh exact-fit string or fills its own slack.
// The DECLINE half is as load-bearing as the fire half: a name any function mentions, a
// name declared twice, and a non-literal initialiser each fall back to the per-append
// concat, and this file is what says so if a widening ever admits one of them.

// The alias survives the appends that follow it: a view's `start + len` never covers the
// slack the append writes into.
let s1 = ""
for i in 0 to 3 { s1 = s1 + "a" }
const alias = s1
for i in 0 to 3 { s1 = s1 + "b" }
print(alias)
print(s1)
print(alias.length)

// A reset to a literal mid-loop: the binding may hold a literal, a concat result, or one of
// its own buffers, and the next append after a literal always grows.
let s2 = ""
for i in 0 to 5 {
  s2 = s2 + "x"
  if i == 2 { s2 = "" }
}
print(s2)
print(s2.length)

// Two accumulators in one loop, one of them appending the other.
let a3 = ""
let b3 = ""
for i in 0 to 3 {
  a3 = a3 + "1"
  b3 = b3 + a3
}
print(a3)
print(b3)

// A nested loop, and `break` / `continue`.
let s4 = ""
for i in 0 to 2 {
  for j in 0 to 2 { s4 = s4 + "x" }
  s4 = s4 + "|"
}
print(s4)

let s5 = ""
for i in 0 to 9 {
  if i == 4 { break }
  if i == 2 { continue }
  s5 = s5 + "x"
}
print(s5)

// A slice taken between two runs of appends.
let s6 = ""
for i in 0 to 4 { s6 = s6 + "abc" }
const head = s6.slice(0, 3)
for i in 0 to 4 { s6 = s6 + "z" }
print(head)
print(s6)

// A three-part append, and an interpolation (which the parser desugars into a chain).
let s7 = ""
const dash = "-"
for i in 0 to 3 { s7 = s7 + "a" + dash + "b" }
print(s7)
print(s7.length)

let s8 = ""
for i in 0 to 3 { s8 = s8 + "\{i}," }
print(s8)

// A `while` loop, and a `let` declared inside a top-level block rather than at module scope.
let s9 = ""
let n9 = 0
while n9 < 4 {
  s9 = s9 + "w"
  n9 = n9 + 1
}
print(s9)

let s10 = ""
for i in 0 to 2 {
  let part = ""
  for j in 0 to 2 { part = part + "p" }
  s10 = s10 + part
}
print(s10)

// DECLINE: a function READS the name, so the cell is not this lowering's to own.
let d1 = ""
function peek() { return d1.length }
for i in 0 to 4 { d1 = d1 + "x" }
print(d1)
print(peek())

// DECLINE: a function WRITES the name.
let d2 = ""
function reset() { d2 = "z" }
for i in 0 to 2 { d2 = d2 + "x" }
reset()
for i in 0 to 2 { d2 = d2 + "y" }
print(d2)

// DECLINE: a lambda mentions the name.
let d3 = ""
const bump = () => {
  d3 = d3 + "!"
}
for i in 0 to 2 { d3 = d3 + "x" }
bump()
print(d3)

// DECLINE: the initialiser is not a string literal, so the binding could be handed a buffer
// another accumulator still owns.
const base = "ab"
let d4 = base
for i in 0 to 2 { d4 = d4 + "c" }
print(d4)

// DECLINE: the name is declared twice, so one row cannot answer for both bindings.
let d5 = ""
for i in 0 to 2 {
  let d5 = "inner"
  d5 = d5 + "!"
  print(d5)
}
for i in 0 to 2 { d5 = d5 + "x" }
print(d5)
