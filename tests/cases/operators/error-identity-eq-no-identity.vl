// @check
// @error-at 6:7 `!==` compares identity, and `i32` has none — use `!=`
// @error-at 6:18 `===` compares identity, and `i32` has none — use `==`
// `===` and `!==` compare identity (DECISIONS A15), which a number does not have: each is refused
// at its operator with the `==` spelling, which `check --fix` writes.
function f(n: i32): i32 {
  if n !== 2 && n === 3 { return 1 }
  0
}
print(f(1) + 1)
