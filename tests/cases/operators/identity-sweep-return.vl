// @run
// @hint redundant type annotation: `r` is inferred as `boolean` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log false
// @log true
// Reference identity `===`/`!==` over records, its result delivered at return: a record against
// itself is identical and a structurally equal one built elsewhere is not (Q58 position sweep).
type P = { x: i32 }
function r(a: P, b: P): boolean { return a !== b }
function go(c: boolean) {
  const a: P = { x: 1 }
  const b: P = if c { a } else { { x: 1 } }
  print(r(a, b))
}
go(true)
go(false)
