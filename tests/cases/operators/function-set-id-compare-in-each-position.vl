// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log true
// @log false
// @log 10
// @log true
// A one-element hole function list's loop variable or element, called with a generic at two
// signatures and compared by identity against a declaration at module level: in a print, a
// binding, an argument, an `if`, a count and an element, with `===` and `!==` (D7180).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function show(b: boolean) { print(b) }
const fs = [apply2]
fs[0](add)
let n = 0
for f in fs {
  f(add)
  if f === apply2 { n = n + 10 }
  if f !== apply2 { n = n + 1 }
  const s = f === apply2
  show(s)
  print(f !== apply2)
}
print(n)
print(fs[0] === apply2)
