// @run
// @log false
// @log 12
// @log false
// @log 1211
// @log true
// @log 121134
// @log true
// @log 12113431
// Each nullable record operand of `==`/`!=` is evaluated once, left then right, as legacy stages
// them: the counter records the order.
type S = { a: i32 }
let n = 0
function mk(k: i32): S | null {
  n = n * 10 + k
  return if k > 2 { null } else { { a: k } }
}
print(mk(1) == mk(2))
print(n)
print(mk(1) != mk(1))
print(n)
print(mk(3) == mk(4))
print(n)
print(mk(3) != mk(1))
print(n)
