// @run
// @log true
// @log false
// @log false
// @log true
// Reference identity `===`/`!==` over records, its result delivered at field: a record against
// itself is identical and a structurally equal one built elsewhere is not (Q58 position sweep).
type P = { x: i32 }
function go(c: boolean) {
  const a: P = { x: 1 }
  const b: P = if c { a } else { { x: 1 } }
  const r = { same: a === b, diff: a !== b }
  print(r.same)
  print(r.diff)
}
go(true)
go(false)
