// @run
// @log true
// @log false
// @log true
// @log 4
// @log true
// @log false
// @log true
// A binary operator whose right operand holds a valued `if`, its left operand a parameter, a local
// or a literal staged below it: a union compare, a list compare, a list concat and a
// `boolean | null` compare, printed and bound.
function p() { return true }
function q() { return false }
function nb(c: boolean): boolean | null {
  if c { return true }
  return null
}
function run(u: i32 | string, xs: i32[]) {
  print(u == (if p() { 1 } else { "t" }))
  print(u == (if q() { 1 } else { "t" }))
  print(xs == (if p() { [1, 2] } else { [3] }))
  const ys = xs + (if p() { [3, 4] } else { [5] })
  print(ys.length)
  const b = nb(true)
  const same = b == (if p() { true } else { false })
  print(same)
  print(b == (if q() { true } else { false }))
  print([1, 2] == (if p() { xs } else { [9] }))
}
run(1, [1, 2])
