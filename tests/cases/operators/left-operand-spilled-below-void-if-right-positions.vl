// @run
// @log 12
// @log 15
// @log 13
// @log true
// @log ab11
// @log 16
// @log t
// A binary operator whose right operand runs a `null`-typed `if` for its effect before its `??`
// default, so no stack stage holds the left operand below it: the left is a parameter, a local, a
// field and a traced call, under `+`, `==` and string concatenation; the call runs once, first.
let trace = ""
function one(): i32 {
  trace = trace + "t"
  return 5
}
function add(k: i32, c: boolean) {
  const x = null
  return k + ((if c { x } else { x }) ?? 11)
}
function local(c: boolean) {
  const x = null
  const k = 4
  return k + ((if c { x } else { x }) ?? 11)
}
type R = { n: i32 }
function field(r: R, c: boolean) {
  const x = null
  return r.n + ((if c { x } else { x }) ?? 11)
}
function eq(k: i32, c: boolean) {
  const x = null
  return k == ((if c { x } else { x }) ?? 11)
}
function cat(s: string, c: boolean) {
  const x = null
  return s + "\{(if c { x } else { x }) ?? 11}"
}
function called(c: boolean) {
  const x = null
  return one() + ((if c { x } else { x }) ?? 11)
}
print(add(1, true))
print(local(false))
print(field({ n: 2 }, true))
print(eq(11, false))
print(cat("ab", true))
print(called(true))
print(trace)
