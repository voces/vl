// @run
// @log true
// @log false
// @log false
// @log true
// Reference identity `===`/`!==` over records, its result delivered at arg union: a record against
// itself is identical and a structurally equal one built elsewhere is not (Q58 position sweep).
type P = { x: i32 }
function show(u: boolean | i32) { print(u) }
function go(c: boolean) {
  const a: P = { x: 1 }
  const b: P = if c { a } else { { x: 1 } }
  show(a === b)
  show(a !== b)
}
go(true)
go(false)
