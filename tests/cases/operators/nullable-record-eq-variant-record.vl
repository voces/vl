// @log false
// @log true
// @log true
// @log false
// A nullable record compares with the bare record once a union holding it is declared (D16033).
type A = { a: i32 }
type B = { b: i32 }
type U = A | B
const x: A = { a: 1 }
const n: A | null = x
const none: A | null = null
const y: A = { a: 2 }
const z: A = { a: 1 }
print(n == x)
print(x == n)
print(none == x)
print(n == y)
print(n != z)
print(x != none)
function reassigned() {
  let m: A | null = null
  m = x
  print(m == x)
  m = null
  print(x == m)
}
reassigned()
