// @run
// @log true
// @log false
// @log true
// @log false
// `===` is reference identity over a list and over a union of records alike: the same value is
// identical, and an equal one built elsewhere is not; a union compares its boxes' payloads.
type P = { x: i32 }
type Q = { y: i32 }
function sameList(a: i32[], b: i32[]) { return a === b }
function sameArm(a: P | Q, b: P | Q) { return a === b }
const xs = [1]
print(sameList(xs, xs))
print(sameList(xs, [1]))
const p: P = { x: 1 }
print(sameArm(p, p))
print(sameArm(p, { x: 1 }))
