// @run
// @log 7
// @log 7
// @log 12
// @log 12
// @log 15
// @log 7
// @log 12
// @hint redundant type annotation: `"[]" for Box` is inferred as `i32`
// The index operators `[]` and `[]=` reached through an UN-ANNOTATED parameter. The checker
// resolves them at the pin (an annotated receiver runs), but it validated the pin without
// BANKING the operator for the emitter's dispatch rewrite — so `p[4]` reached the emitter as
// a raw Index over a receiver with no list rep and died at `emitProgram: index access but
// array type not collected`, a clause-2 emit reject on a `vl check`-clean program. Three
// sentences (index access / indexed assignment / indexed-assignment target) were three
// delivery positions of the one gap. D1892.
//
// The write is a separate lowering, so the setter is proven here beside the getter, and
// `p[4] += 1` exercises both in one place.

type Box = new { x: i32 }

function "[]"(self: Box, i: i32): i32 { return self.x + i }

function "[]="(self: Box, i: i32, k: i32) { print(self.x + i + k) }

function mkval(): Box {
  const r: Box = { x: 3 }
  return r
}

// The GET operator through the hole, and the annotated twin beside it.
function readHole(p) { print(p[4]) }
readHole(mkval())

function readAnn(p: Box) { print(p[4]) }
readAnn(mkval())

// The SET operator through the hole (prints 3 + 4 + 5 = 12), and its annotated twin.
function writeHole(p) { p[4] = 5 }
writeHole(mkval())

function writeAnn(p: Box) { p[4] = 5 }
writeAnn(mkval())

// A COMPOUND assignment desugars to a read then a write, so it needs both operators banked:
// `p[4]` reads 7, then `[]=`(p, 4, 8) prints 3 + 4 + 8 = 15.
function compoundHole(p) { p[4] += 1 }
compoundHole(mkval())

// Delivered through a FIELD rather than straight from a call — the pin reads the same
// declaration whatever the argument expression is.
const srcBox = { it: mkval() }

function viaField(p) { print(p[4]) }
viaField(srcBox.it)

// A neighbouring real list in the module, which flipped the emit sentence to a third one
// before the fix; it must not perturb the operator dispatch.
const bag = [1]
bag.push(2)

function withNeighbour(p) { p[4] = 5 }
withNeighbour(mkval())
