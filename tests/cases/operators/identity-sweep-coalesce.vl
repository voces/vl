// @run
// @log true
// @log false
// Reference identity `===`/`!==` over records, its result delivered at coalesce: a record against
// itself is identical and a structurally equal one built elsewhere is not (Q58 position sweep).
type P = { x: i32 }
function go(c: boolean) {
  const a: P = { x: 1 }
  const b: P = if c { a } else { { x: 1 } }
  const m: boolean | null = a === b
  print(m ?? false)
}
go(true)
go(false)
