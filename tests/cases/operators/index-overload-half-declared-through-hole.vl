// @check
// @error needs a matching "[]" operator
// A SET-only index operator reached for a READ through an un-annotated parameter. An
// annotated receiver already refuses this ("an index that cannot be READ cannot be written
// either"), but the hole path fell silently to the emitter: `indexFloorMsg` answers "" for a
// set-only receiver because it sees the setter, so `vl check` passed and `p[4]` died at
// `emitProgram: index access but array type not collected`. The pin now names the missing
// half, matching the inline arm. D1932.

type Box = new { x: i32 }

function "[]="(self: Box, i: i32, k: i32) { print(self.x + i + k) }

function mkval(): Box {
  const r: Box = { x: 3 }
  return r
}

function take(p) { print(p[4]) }
take(mkval())
