// @run
// @log true
// @log false
// A nullable record against a bare one: the IR names it a miss (`nullable record eq bare side`);
// the program runs alike either way.
type C = { r: i32 }
type Q = { s: i32 }
function eq(x: C | null, y: C) { return x == y }
print(eq({ r: 1 }, { r: 1 }))
print(eq(null, { r: 1 }))
