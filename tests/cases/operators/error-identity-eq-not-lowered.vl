// @check
// @error-at 10:10 `===` (reference identity) is not lowered yet — `==` compares structurally
// @error-at 11:8 cannot compare P and Q
// @error-at 12:10 `!==` compares identity, and `string` has none — use `!=`
// Two records, lists, maps or functions are compared by identity with `===`; until the emitter
// lowers it, an accepted compare is refused, and operands no value can share are refused as `==`
// refuses them.
type P = { x: i32 }
type Q = { y: i32 }
function f(p: P, q: Q, s: string) {
  print(p === p)
  print(p === q)
  print(s !== "a")
}
f({ x: 1 }, { y: 2 }, "b")
