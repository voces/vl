// @log false
// @log true
// @log false
// @log false
// @log false
// @log false
// @log false
// @log true
// @log ltrue rtrue
// @log lfalse rfalse
// @log ltrue rtrue
// A nullable record compared with a list element, each side null or not, equal, and unequal at
// each field of a nested record: a wrong side's null test or field read shows here. The compare's
// boolean is also concatenated, in both orders.
import { toString } from "std:fmt"

type P = { x: i32, y: i32 }
type C = { p: P, z: i32 }
const c: C = { p: { x: 1, y: 2 }, z: 3 }
const xs: (C | null)[] = [
  c,
  null,
  { p: { x: 0, y: 2 }, z: 3 },
  { p: { x: 1, y: 0 }, z: 3 },
  { p: { x: 1, y: 2 }, z: 0 },
]
function left(k: i32, y: C | null) { return xs[k] == y }
function right(k: i32, y: C | null) { return y != xs[k] }
function cat(k: i32, y: C | null) {
  return "l" + toString(xs[k] == y) + " r" + toString(y == xs[k])
}
print(left(0, c))
print(left(0, null))
print(left(1, c))
print(left(1, null))
print(left(2, c))
print(left(3, c))
print(left(4, c))
print(right(0, c))
print(right(1, null))
print(right(4, c))
print(cat(0, c))
print(cat(1, c))
print(cat(1, null))
