// @run
// @hint redundant type annotation: `y` is inferred as `S | null` — remove it to lean on inference
// @log 1
// @log true
// @log 0
// @log false
// A nullable records `==`/`!=` over a `(S | null)[]` element (a named miss in the IR), its result
// delivered at if arm: equal, unequal, and one side null (Q58 position sweep).
type S = { a: i32 }
type T = { f: S }
function mk(k: i32): S | null { return if k > 1 { null } else { { a: k } } }
function go(c: i32) {
  const xs: (S | null)[] = [mk(1)]
  const y: S | null = mk(c)
  const e = if xs[0] == y { 1 } else { 0 }
  const v = if c > 0 { xs[0] == y } else { xs[0] != y }
  print(e)
  print(v)
}
go(1)
go(2)
