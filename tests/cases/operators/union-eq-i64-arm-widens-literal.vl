// @run
// @log 1
// @log 0
// @log 1
// `u == 5` over an `i64 | string` box: the box's tag selects the i64 arm, then the CONCRETE
// operand must be emitted in THAT arm's rep — an i32 literal widens to i64 before `i64.eq`.
// Without the widening the compare pushes an i32 against an i64 payload (invalid wasm).
//
// The pre-existing `operators/union-eq.vl` covers the i32 / string / boolean arms, all of
// which need no widening, so the widening arm of `emitUnionEqOther` had no corpus pin at all
// (a sabotage that deletes it is byte-, message- and run-inert over the whole corpus). This
// file is that pin: it reddens the moment the i64 arm stops widening.

function pick(c: boolean): i64 | string {
  if c { return 5 }
  "x"
}

const u = pick(true)
if u == 5 { print(1) } else { print(0) }

const v = pick(false)
if v == 5 { print(1) } else { print(0) }

// `!=` takes the same widened path, negated.
if u != 6 { print(1) } else { print(0) }
