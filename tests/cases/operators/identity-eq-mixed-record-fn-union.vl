// @log true
// D16039: `===` and `!==` over a union of record and function arms (DECISIONS A15): a record
// arm by `ref.eq`, a function arm by declaration and captured environment, a nullable of the
// mix, and a union with two record arms beside the function.
type P = { x: i32 }
type Q = { y: string }
type F = (i: i32) => i32
function inc(i: i32) { return i + 1 }
function dbl(i: i32) { return i * 2 }
function adder(n: i32): F { return (i: i32) => i + n }
const p: P = { x: 1 }
const p2: P = { x: 1 }
const a1 = adder(1)
const a2 = adder(1)
const u1: P | F = p
const u2: P | F = p2
const u3: P | F = inc
const u4: P | F = inc
const u5: P | F = dbl
const u6: P | F = a1
const u7: P | F = a1
const u8: P | F = a2
print(u1 === u1)
print(u1 === u2)
print(u1 === u3)
print(u3 === u4)
print(u3 === u5)
print(u6 === u7)
print(u6 === u8)
print(u1 !== u2)
print(u3 !== u4)
function same(x: P | F, y: P | F) { return x === y }
print(same(p, p))
print(same(inc, inc))
print(same(p, inc))
const n1: P | F | null = null
const n2: P | F | null = null
const n3: P | F | null = p
print(n1 === n2)
print(n1 === n3)
print(n3 === u1)
const t1: P | Q | F = { y: "q" }
const t2: P | Q | F = inc
print(t1 === t2)
print(t2 === u3)
print(t1 === t1)
function sameG<T>(a: T, b: T) { return a === b }
print(sameG(u1, u1))
print(sameG(u1, u3))
print(sameG(u3, u4))
