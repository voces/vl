// @run
// @log 28
// @log false
// A comment after a binary operator, or inside a parenthesis, stays there under `vl fmt`
// (D3514). The file is fmt-clean only while that holds: a formatter that moves the comment
// after the statement makes it drift.
const b = 1 + // the first link
  2
const b2 = 1 + 2 + // a middle link
  3 + 4
const b3 = 1 + 2 * // a tighter operator
  3
const c = true && // a logical operator
  false
const f = -( // inside an opening parenthesis
  1)
const f2 = (1 + 2 // before a closing parenthesis
)
let g = 0
g = g + // the right side of an assignment
  3
const k = {
  k: 1 + // inside a field value
  2,
}
print(b + b2 + b3 + f + f2 + g + k.k)
print(c)
