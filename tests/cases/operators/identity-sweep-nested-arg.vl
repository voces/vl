// @run
// @log true
// @log false
// @log false
// @log true
// Reference identity `===`/`!==` over records, its result delivered at nested arg: a record
// against itself is identical and a structurally equal one built elsewhere is not (Q58 position
// sweep).
type P = { x: i32 }
function show(b: boolean) { print(b) }
function id<T>(t: T): T { return t }
function go(c: boolean) {
  const a: P = { x: 1 }
  const b: P = if c { a } else { { x: 1 } }
  show(id(a === b))
  show(id(a !== b))
}
go(true)
go(false)
