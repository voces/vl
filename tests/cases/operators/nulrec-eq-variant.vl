// @log false
// @log true
// Nullable variant records, at the variant eq row, compared with `==`.
type C = { r: i32 }
type Q = { s: i32 }
function eq(x: C | null, y: C | null) { return x == y }
function eqU(x: C | Q | null, y: C | Q | null) { return x == y }
print(eq({ r: 1 }, { r: 1 }))
print(eqU({ r: 1 }, { r: 1 }))
print(eqU({ r: 1 }, { s: 1 }))
print(eqU(null, null))
