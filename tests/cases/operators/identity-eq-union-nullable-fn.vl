// A union of records compares the record it holds, never its box: one record widened at two
// sites is identical to itself. A nullable compares two nulls identical. Two function values
// compare by declaration and environment, as `==` does.
type P = { x: i32 }
type Q = { y: i32 }

function unions(a: P | Q, b: P | Q) {
  print(a === b)
  print(a !== b)
}

function nullables(a: P | null, b: P | null) {
  print(a === b)
  print(a !== b)
}

function fns(f: (i: i32) => i32, g: (i: i32) => i32) {
  print(f === f)
  print(f === g)
}

function inc(i: i32) { return i + 1 }
function dec(i: i32) { return i - 1 }

const p: P = { x: 1 }
const p2: P = { x: 1 }
unions(p, p)
unions(p, p2)
nullables(null, null)
fns(inc, dec)
print(inc === inc)
const r: P | null = p
print(r === p)
print(r === p2)
