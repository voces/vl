// @log true
// @log true
// `===` and `!==` over a union of record and function arms, and over a union of two function
// types, at each operand position: a binding, a parameter, a field, an element, a call's result
// and a nullable union, in a start body and in a function.
type P = { x: i32 }
type M = P | ((i: i32) => i32) | null
type F = ((x: i32) => i32) | ((x: string) => i32)
function inc(i: i32) { return i + 1 }
function dec(i: i32) { return i - 1 }
function two<T>(x: T) { return [x].length }
const p: P = { x: 1 }
const a: M = p
const b: M = inc
const c: M = null
print(a === a)
print(a === b)
print(b !== a)
print(c == null)
print(c === a)
const fi: (x: i32) => i32 = two
const fs: (x: string) => i32 = two
const u: F = fi
const v: F = fs
const w: F = dec
print(u === v)
print(u !== w)
type H = { m: M, f: F }
const h: H = { m: b, f: w }
print(h.m === b)
print(h.f === w)
const ms: M[] = [a, b, c]
print(ms[0] === a)
print(ms[1] === ms[2])
function pick(k: i32): M {
  if k == 0 { return a }
  return b
}
print(pick(0) === pick(0))
print(pick(0) === pick(1))
function same(x: M, y: M) { return x === y }
print(same(a, a))
print(same(b, inc))
print(same(a, b))
function fsame(x: F, y: F) { return x !== y }
print(fsame(u, v))
print(fsame(u, w))
function none(x: M) { return x === null }
print(none(c))
