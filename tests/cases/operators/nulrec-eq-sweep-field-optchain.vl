// @run
// @hint redundant type annotation: `y` is inferred as `S | null` — remove it to lean on inference
// @log true
// @log false
// @log false
// @log true
// A nullable records `==`/`!=` over a `?.` read (a named miss in the IR), its result delivered at
// field: equal, unequal, and one side null (Q58 position sweep).
type S = { a: i32 }
type T = { f: S }
function mk(k: i32): S | null { return if k > 1 { null } else { { a: k } } }
function go(c: i32) {
  const o: T | null = { f: { a: 1 } }
  const y: S | null = mk(c)
  const r = { same: o?.f == y, diff: o?.f != y }
  print(r.same)
  print(r.diff)
}
go(1)
go(2)
