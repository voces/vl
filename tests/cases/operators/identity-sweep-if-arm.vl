// @run
// @log 1
// @log true
// @log 0
// @log true
// Reference identity `===`/`!==` over records, its result delivered at if arm: a record against
// itself is identical and a structurally equal one built elsewhere is not (Q58 position sweep).
type P = { x: i32 }
function go(c: boolean) {
  const a: P = { x: 1 }
  const b: P = if c { a } else { { x: 1 } }
  const e = if a === b { 1 } else { 0 }
  const v = if c { a === b } else { a !== b }
  print(e)
  print(v)
}
go(true)
go(false)
