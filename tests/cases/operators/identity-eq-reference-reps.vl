// @log false
// @log true
// `===` is reference identity (DECISIONS A15): a record, a list or a map is identical to itself
// and not to a structurally equal value built elsewhere, which `==` would call equal; `!==` is
// its negation.
type P = { x: i32 }

function recs(a: P, b: P) {
  print(a === a)
  print(a === b)
  print(a !== b)
}

function lists(a: i32[], b: i32[]) {
  print(a === a)
  print(a === b)
  print(a == b)
}

function maps(a: {[string]: i32}, b: {[string]: i32}) {
  print(a === a)
  print(a === b)
}

const p: P = { x: 1 }
const q: P = { x: 1 }
recs(p, q)
lists([1, 2], [1, 2])
const m: {[string]: i32} = {}
const n: {[string]: i32} = {}
maps(m, n)
print(p !== p || q === q)
