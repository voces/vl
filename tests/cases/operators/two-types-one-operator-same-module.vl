// @run
// @log 4
// @log 30
// Two nominal types each define `+` in one module. This did not compile before operator
// declarations became receiver-keyed: the symbol is keyed on `(op, receiver)` (`+@Vec2`,
// `+@Cents`), so both coexist and each `a + b` dispatches by the left operand's own type.
type Vec2 = new { x: i32, y: i32 }
type Cents = new { n: i32 }

function "+"(self: Vec2, other: Vec2): Vec2 {
  const r: Vec2 = { x: self.x + other.x, y: self.y + other.y }
  return r
}

function "+"(self: Cents, other: Cents): Cents {
  const r: Cents = { n: self.n + other.n }
  return r
}

function main() {
  const a: Vec2 = { x: 1, y: 2 }
  const b: Vec2 = { x: 3, y: 4 }
  const v = a + b
  print(v.x)

  const c: Cents = { n: 10 }
  const d: Cents = { n: 20 }
  const t = c + d
  print(t.n)
}

main()
