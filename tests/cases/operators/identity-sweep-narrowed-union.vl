// @run
// @log true
// @log false
// @log false
// @log true
// Reference identity over a read narrowed out of a union's storage, which still holds the box
// legacy reads by its payload (Q58 position sweep). The IR names it a miss, `identity compare
// narrowed box operand`; the program runs alike either way.
type A = { a: i32 }
type B = { b: i32 }
function go(u: A | B, s: A) {
  if u is A {
    print(u === s)
    print(u !== s)
  }
}
const s: A = { a: 1 }
go(s, s)
go({ a: 1 }, s)
