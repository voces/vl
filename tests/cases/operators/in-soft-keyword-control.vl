// @run
// @log 1
// @log 2
// @log 5
// @log 7
// @log 0
// @log 1
// @log a
// @log 5
// `in` stays a `for`-head keyword and a legal identifier: parsing `a in b` as a refused
// operator changes neither.
for x in [1, 2] { print(x) }
for x, i in [5, 6] { print(x + i) }
for i in 0 until 2 { print(i) }
const m: {[string]: i32} = Map()
m["a"] = 1
for k in m.keys() { print(k) }
let in = 4
in = in + 1
print(in)
