// @run
// @hint Intentionally-unused parameter `_i` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_i` (leading `_` marks it unused)
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log false
// @log true
// @log b
// @log a
// @log b
// D3164: a `for-in` directly over a user operator's `K[]` result walks the atoms, so the element
// prints its member, compares as one and is captured at the atom, in a function and at module
// scope.
type K = "a" | "b"
type Bag = { ks: K[] }
function "[]"(self: Bag, _i: i32): K[] { return self.ks }
function "+"(self: Bag, o: Bag): K[] {
  const r: K[] = []
  for k in self.ks { r.push(k) }
  for k in o.ks { r.push(k) }
  return r
}
type NBox = { k: K | null }
function "[]"(self: NBox, _i: i32): K | null { return self.k }
function h(bag: Bag) {
  for e in bag[0] { print(e) }
  for e in bag + bag {
    const c = e
    const f = () => c
    print(f())
  }
  for e in bag[0] { print(e == "a") }
}
h({ ks: ["b", "a"] })
const mb: Bag = { ks: ["b", "a"] }
for e in mb[0] {
  const f = () => e
  print(f())
}
const nb: NBox = { k: "b" }
print(nb[0] ?? "a")
