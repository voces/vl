// @run
// @hint redundant type annotation: `x` is inferred as `S | null` — remove it to lean on inference
// @hint redundant type annotation: `y` is inferred as `S | null` — remove it to lean on inference
// @log true
// @log false
// @log false
// @log true
// A nullable records `==`/`!=` over two nullable locals, its result delivered at arg union: equal,
// unequal, and one side null (Q58 position sweep).
type S = { a: i32 }
type T = { f: S }
function mk(k: i32): S | null { return if k > 1 { null } else { { a: k } } }
function show(u: boolean | i32) { print(u) }
function go(c: i32) {
  const x: S | null = mk(1)
  const y: S | null = mk(c)
  show(x == y)
  show(x != y)
}
go(1)
go(2)
