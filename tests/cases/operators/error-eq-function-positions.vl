// @check
// @error-at 23:8 `==` compares values, and a function has none: `(i32) => i32` and `(i32) => i32` can both hold a function — use `===` for identity
// @error-at 24:8 `!=` compares values, and a function has none: `(i32) => i32` and `(i32) => i32` can both hold a function — use `!==` for identity
// @error-at 25:8 `==` compares values, and a function has none: `((i32) => i32) | null` and `(i32) => i32` can both hold a function — use `===` for identity
// @error-at 26:8 `==` compares values, and `R`'s field `f`, a function, has none: `R` and `R` can both hold a function — compare the other fields, or use `===` for identity
// @error-at 27:8 `==` compares values, and a list of functions has none: `((i32) => i32)[]` and `((i32) => i32)[]` can both hold a function — use `===` for identity
// @error-at 28:8 `==` compares values, and a union with a function arm has none: `U` and `U` can both hold a function — narrow both to the same arm first
// @error-at 29:8 `==` compares values, and a union with a function arm has none: `U` and `(i32) => i32` can both hold a function — narrow both to the same arm first
// `==` is refused when both operands can hold a function in the same position (DECISIONS A15):
// a function or a nullable of one, a record field, a list element, or a union arm. The advice
// names `===` where the operands have an identity, and narrowing where they do not.
function inc(i: i32) { return i + 1 }
function dec(i: i32) { return i - 1 }
type R = { n: i32, f: (i: i32) => i32 }
type U = ((i: i32) => i32) | i32
function check(
  g: ((i: i32) => i32) | null,
  r: R,
  s: R,
  xs: ((i: i32) => i32)[],
  u: U,
  v: U,
) {
  print(inc == dec)
  print(inc != dec)
  print(g == inc)
  print(r == s)
  print(xs == xs)
  print(u == v)
  print(u == inc)
}
check(inc, { n: 1, f: inc }, { n: 1, f: dec }, [inc], 5, inc)
