// @run
// @log 1
// @log true
// @log 0
// @log false
// A nullable records `==`/`!=` over two nullable call results, its result delivered at if arm:
// equal, unequal, and one side null (Q58 position sweep).
type S = { a: i32 }
type T = { f: S }
function mk(k: i32): S | null { return if k > 1 { null } else { { a: k } } }
function go(c: i32) {
  const e = if mk(1) == mk(c) { 1 } else { 0 }
  const v = if c > 0 { mk(1) == mk(c) } else { mk(1) != mk(c) }
  print(e)
  print(v)
}
go(1)
go(2)
