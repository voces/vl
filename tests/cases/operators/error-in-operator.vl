// @error-at 13:6 `in` is not an operator in VL outside a `for` loop's head; to test for a key, use `m.has(k)`
// @error-at 14:6 `in` is not an operator in VL outside a `for` loop's head; to test set membership, use `s.has(x)`
// @error-at 15:3 `in` is not an operator in VL outside a `for` loop's head; use `xs.includes(x)` for a value, or `i < xs.length` for an index
// @error-at 16:6 `in` is not an operator in VL outside a `for` loop's head
// @error-at 17:6 `in` is not an operator in VL outside a `for` loop's head; to test for a key, use `m.has(k)`
// `a in b` parses at a comparison's precedence only to be refused with the receiver's own
// membership test — one diagnostic, never a parse cascade, and `if x in xs && y` is one
// error, not two.
const m: {[string]: i32} = Map()
const s: Set<i32> = Set()
const xs = [1, 2]
const y = true
const n: {[string]: i32} | null = null
print("a" in m)
print(1 in s)
if 1 in xs && y { print(1) }
print(1 in "abc")
print("a" in n)
