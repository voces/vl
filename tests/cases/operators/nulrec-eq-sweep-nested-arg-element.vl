// @run
// @hint redundant type annotation: `y` is inferred as `S | null` — remove it to lean on inference
// @log true
// @log false
// @log false
// @log true
// A nullable records `==`/`!=` over a `(S | null)[]` element (a named miss in the IR), its result
// delivered at nested arg: equal, unequal, and one side null (Q58 position sweep).
type S = { a: i32 }
type T = { f: S }
function mk(k: i32): S | null { return if k > 1 { null } else { { a: k } } }
function show(b: boolean) { print(b) }
function id<Z>(t: Z): Z { return t }
function go(c: i32) {
  const xs: (S | null)[] = [mk(1)]
  const y: S | null = mk(c)
  show(id(xs[0] == y))
  show(id(xs[0] != y))
}
go(1)
go(2)
