// A bare record on either side of `==` and `!=` with a nullable record: a parameter, a local, a
// global, a call and a field of a call. Each call runs once, as the count shows.
type C = { r: i32, s: string }
type W = { c: C, k: i32 }
let calls = 0
function mk(): C {
  calls = calls + 1
  return { r: 1, s: "a" }
}
function mkW(): W {
  calls = calls + 1
  return { c: { r: 1, s: "a" }, k: 0 }
}
function sides(b: C, n: C | null, z: C | null) {
  const l: C = { r: 2, s: "b" }
  print(b == n)
  print(n != b)
  print(z == b)
  print(l != z)
  print(mk() == n)
  print(n == mk())
  print(mk() != z)
  print(z != mk())
  print(mkW().c == n)
  print(n != mkW().c)
  print(calls)
}
sides({ r: 1, s: "a" }, { r: 1, s: "a" }, null)
const g: C = { r: 1, s: "a" }
const n: C | null = { r: 1, s: "a" }
print(g == n)
print(n != g)
print(mk() == n)
print(n != mkW().c)
print(calls)
