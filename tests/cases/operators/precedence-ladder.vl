// @run
// @log 4
// @log 4
// @log 5
// @log 2
// @log 2
// @log 4
// @log 3
// @log 6
// @log 3
// @log 1
// @log 0
// @log 7
// @log 5
// @log 15
// @log 5
// @log 0
// @log 3
// @log 3
// THE BINARY-OPERATOR LADDER, one rung at a time.
//
// `binPrec` is a first-character DISPATCH over a closed 25-element vocabulary
// (parser.vl). Its two failure modes are both silent at the point of the defect:
// a DROPPED arm answers `0`, which tells the expression climber "not an
// operator" and quietly truncates the expression; a MIS-BUCKETED arm answers the
// wrong binding power, which re-associates it. Neither is a crash and neither
// shows up in a fixpoint — a compiler that mis-parses `a - b * c` still compiles
// itself to a fixpoint if it mis-parses its own source the same way both times.
//
// So every rung is pinned here, and each line is written so that the WRONG
// answer prints a different number (or fails to parse at all):
//   11 (`*` `/` `%`) vs 10 (`+` `-`), 10 vs 9 (`<<` `>>` `>>>`),
//   9 vs 8 (`<` `>` `<=` `>=`), 6 (`&`) vs 5 (`^`) vs 4 (`|`),
//   3 (`&&`) vs 2 (`||` `??`), and 1 (`=` `+=` `-=` `*=` `/=`).
// The `==`/`!=` rung (7) is pinned by `union-eq.vl` and friends next door.

// ── 11 binds tighter than 10 ────────────────────────────────────────────────
print(10 - 2 * 3) // 4, not (10-2)*3 = 24
print(1 + 6 / 2) // 4, not (1+6)/2 = 3
print(7 - 5 % 3) // 5, not (7-5)%3 = 2

// ── 10 binds tighter than 9 ─────────────────────────────────────────────────
print(8 >> 1 + 1) // 2, not (8>>1)+1 = 5
print(8 >>> 1 + 1) // 2, not (8>>>1)+1 = 5
print(1 << 1 + 1) // 4, not (1<<1)+1 = 3

// ── 6 (&) tighter than 5 (^) tighter than 4 (|) ─────────────────────────────
print(1 ^ 3 & 2) // 3, not (1^3)&2 = 2
print(6 | 3 ^ 5) // 6|(3^5) = 6 … and (6|3)^5 = 2
print(1 | 2 & 3) // 3 — & under |, the shape bitwise/precedence.vl already pins

// ── 9 binds tighter than 8: the shift completes before the comparison ───────
let ge = 0
if 1 << 2 > 3 { ge = 1 }
print(ge) // 1 — (1<<2) > 3

let le = 0
if 4 >> 1 >= 3 { le = 1 }
print(le) // 0 — (4>>1) >= 3 is 2 >= 3

// ── 3 (&&) binds tighter than 2 (|| / ??) ───────────────────────────────────
let sc = 0
if false && true || true { sc = 7 }
print(sc) // 7 — (false && true) || true; the other grouping is false

const maybe: i32 | null = null
print(maybe ?? 5) // 5 — `??` yields the right side on null

// ── 1: assignment is the LOOSEST, and right-associative ─────────────────────
let acc = 1
acc += 2 * 7
print(acc) // 15 — `2 * 7` completes first
acc -= 2 * 5
print(acc) // 5
acc *= 3 / 5
print(acc) // 0 — `3 / 5` is integer division, so the right side completes to 0

let ra = 0
let rb = 0
ra = rb = 3
print(ra) // 3 — right-associative, so ra = (rb = 3)
print(rb) // 3
