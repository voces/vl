// @check
// @error '++'/'--' over the numeric union i32 | f64 is not supported; write `x += 1`
// CONTRACT (must-error): a postfix step over a numeric union names the compound assignment
// that does work, rather than calling the union not numeric.
function f(n: i32): i32 | f64 {
  if n > 0 { return 1 }
  return 2.5
}
let y = f(1)
y++
print(y)
