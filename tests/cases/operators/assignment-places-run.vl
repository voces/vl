// @log 4
// @log 2
// @log 0
// @log 5
// @log 3
// Every place an assignment may write: a name, an element, a field, a parenthesised name, and a
// compound write to a name. The prefix forms yield the new value.
type P = { x: i32 }
function name() { let x = 5; --x }
function elem() { const xs = [1, 2]; ++xs[0] }
function field() { const p: P = { x: 1 }; --p.x }
function paren() { let a = 0; (a) = 5; a }
function compound() { let a = 1; a += 2; a }
print(name())
print(elem())
print(field())
print(paren())
print(compound())
