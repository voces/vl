// @check
// @error the operand of prefix `--` must be a variable, a field or an element
// @error the operand of prefix `--` must be a variable, a field or an element
// @error the operand of prefix `++` must be a variable, a field or an element
// @error the operand of prefix `--` must be a variable, a field or an element
// @error the left side of `+=` must be a variable, a field or an element
// @error the left side of `=` must be a variable, a field or an element; VL has no destructuring assignment
// @error the left side of `=` must be a variable, a field or an element; VL has no destructuring assignment
// An assignment writes a place: a name, a field or an element, through any parentheses. A
// prefix `++`/`--` is an assignment to its operand, so over a literal or a call it has nothing
// to write, and an object or array literal on the left is a pattern VL does not have (D2689,
// D3052, D3483). `-(-5)` spells a double negation.
type P = { a: i32, b: i32 }
function g(): i32 { 3 }
function _refusals(o: P, xs: i32[]) {
  print(--5)
  const k: i64 = --2147483648
  ++5
  print(--g())
  5 += 1
  let a = 0
  let b = 0
  { a: a, b: b } = o
  [a] = xs
  print(k + a + b)
}
