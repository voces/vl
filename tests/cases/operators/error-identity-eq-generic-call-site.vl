// @check
// @error-at 18:11 argument 1: `===` compares identity, and `i32` has none — use `==` (`same` hands it to a body that applies `===`, directly or through a parameter)
// @error-at 19:12 argument 1: `===` compares identity, and `string` has none — use `==` (`loose` hands it to a body that applies `===`, directly or through a parameter)
// @error-at 20:14 `===` compares identity, and `i32` has none — use `==` (`same` is passed here as a value and instantiated at `i32`, where its body applies `===`)
// @error-at 21:14 `===` compares identity, and `boolean` has none — use `==` (`loose` is passed here as a value and instantiated at `boolean`, where its body applies `===`)
// @error-at 22:12 argument 1: `===` compares identity, and `i32` has none — use `==` (`outer` hands it to a body that applies `===`, directly or through a parameter)
// @error-at 23:17 argument 1: `===` compares identity, and `i32` has none — use `==` (`outerLoose` hands it to a body that applies `===`, directly or through a parameter)
// @error-at 24:15 argument 1: `===` compares identity, and `i32` has none — use `==` (`isSelf` hands it to a body that applies `===`, directly or through a parameter)
// A generic body's `===` is a constraint on its type parameter, decided at each call and refused
// on the argument it binds, like every operator (DECISIONS A15): a direct call, a call through
// a hole parameter, a nested generic and a method call, each annotated and un-annotated. A
// generic passed as a value is refused where it is passed, naming the type (D16110).
function same<T>(a: T, b: T) { a === b }
function loose(a, b) { a === b }
function viaHole(f, a, b) { f(a, b) }
function outer<U>(a: U, b: U) { same(a, b) }
function outerLoose(a, b) { loose(a, b) }
function isSelf<T>(self: T, other: T) { self === other }
print(same(1, 2))
print(loose("x", "y"))
print(viaHole(same, 1, 2))
print(viaHole(loose, true, false))
print(outer(1, 2))
print(outerLoose(1, 2))
print(3.isSelf(3))
