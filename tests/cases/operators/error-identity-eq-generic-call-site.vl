// @check
// @error-at 17:11 `===` compares identity, and `i32` has none — use `==` (the call's argument types)
// @error-at 18:12 `===` compares identity, and `string` has none — use `==` (the body of `loose` applies '===' to arguments 1 and 2)
// @error-at 19:14 `===` compares identity, and `i32` has none — use `==` (the call's argument types)
// @error-at 20:14 `===` compares identity, and `boolean` has none — use `==` (the call's argument types)
// @error-at 21:12 `===` compares identity, and `i32` has none — use `==` (the call's argument types)
// @error-at 22:17 `===` compares identity, and `i32` has none — use `==` (the body of `outerLoose` applies '===' to arguments 1 and 2)
// @error-at 23:15 argument 1: `===` compares identity, and `i32` has none — use `==` (the body of `isSelf` uses it on both sides of '===')
// A generic body's `===` is a constraint on its type parameter, decided at each call and refused
// on the argument it binds, like every operator (DECISIONS A15): a direct call, a call through
// a hole parameter, a nested generic and a method call, each annotated and un-annotated.
function same<T>(a: T, b: T) { a === b }
function loose(a, b) { a === b }
function viaHole(f, a, b) { f(a, b) }
function outer<U>(a: U, b: U) { same(a, b) }
function outerLoose(a, b) { loose(a, b) }
function isSelf<T>(self: T, other: T) { self === other }
print(same(1, 2))
print(loose("x", "y"))
print(viaHole(same, 1, 2))
print(viaHole(loose, true, false))
print(outer(1, 2))
print(outerLoose(1, 2))
print(3.isSelf(3))
