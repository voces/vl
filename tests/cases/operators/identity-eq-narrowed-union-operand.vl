// @run
// @log true
// @log true
// @log false
// @log true
// @log true
// @log false
// A union binding narrowed by an assignment or an `is` test still holds its box, so `===`
// compares the payload of that box, not the box against a record (the matrix's `local_assign`).
type A = { a: i32 }
type B = { b: i32 }
const src: A = { a: 1 }
const src2: A = { a: 1 }
const held: A | B = src
function f(u: A | B) {
  let v: A | B = src
  v = src
  print(v === held)
  print(v === src)
  print(v === src2)
  if u is A {
    print(u === src)
    print(u === held)
    print(u === src2)
  }
}
f(src)
