// @run
// @log 2
// @log 1.5
// @log 7
// @log 3
// @log 2.5
// @log 0
// @log 4
// @log 5
// @log 12
// @log 11
// @log 21
// @log 9
// @log 1
// Q58 position sweep: postfix `++` / `--` as a statement (its increment alone) and for its value
// (the old one, the step undone at the place's width), at i32, f64, i64 and f32, on a name, a
// field and an element: a print operand, a binding, an argument and a return, in the start body
// and in a function.
type R = { n: i32 }
let i = 1
let d = 1.5
let w: i64 = 7
let s: f32 = 3.0
i++
print(i)
print(d++)
print(w--)
const old = s++
print(old)
print(d)
function show(x: i32) { print(x) }
let z = 0
show(z--)
const r: R = { n: 4 }
print(r.n++)
const xs = [5, 6]
print(xs[0]++)
print(xs[0] + xs[1])
function inFn(k: i32) {
  let a = k
  a++
  print(a)
  let e: i64 = 20
  print(e++ + 1)
  const q: R = { n: 9 }
  q.n--
  print(q.n + 1)
  return a--
}
print(inFn(10) - 10)
