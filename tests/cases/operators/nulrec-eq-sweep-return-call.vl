// @run
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// A nullable records `==`/`!=` over two nullable call results, its result delivered at return:
// equal, unequal, and one side null (Q58 position sweep).
type S = { a: i32 }
type T = { f: S }
function mk(k: i32): S | null { return if k > 1 { null } else { { a: k } } }
function cmp(c: i32) { return mk(1) == mk(c) }
function go(c: i32) {
  print(mk(1) == mk(c))
  print(mk(1) != mk(c))
}
print(cmp(1))
print(cmp(2))
go(1)
go(2)
