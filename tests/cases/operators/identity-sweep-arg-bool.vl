// @run
// @log true
// @log false
// @log false
// @log true
// Reference identity `===`/`!==` over records, its result delivered at arg bool: a record against
// itself is identical and a structurally equal one built elsewhere is not (Q58 position sweep).
type P = { x: i32 }
function show(b: boolean) { print(b) }
function go(c: boolean) {
  const a: P = { x: 1 }
  const b: P = if c { a } else { { x: 1 } }
  show(a === b)
  show(a !== b)
}
go(true)
go(false)
