// @run
// @log 1
// @log 1
// @log 12
// @hint redundant type annotation: `>` is inferred as `boolean`
// The two spellings the D1891 flow must NOT disturb, in their own case because a non-bracket
// operator may be declared once per program (`redeclared *`).
//
// The TWO-HOLE face resolved before the fix and still does: with neither operand typed the
// comparison defers to `validateBinCstrs` at the call. It carries no `std:` import — with one,
// this same program refuses (D1931), on master too.
//
// The ASYMMETRIC operator is the proof that the recorded flow goes to the declaration's `self`
// and not to the other operand: `k` is a plain `i32`, so seeding the hole from `4` would bind
// it to `i32` and lose the receiver.

type Ord = new { x: i32 }

function ">"(self: Ord, other: Ord): boolean { return self.x > other.x }

const opO: Ord = { x: 12 }

function mkval(): Ord {
  const r: Ord = { x: 24 }
  return r
}

function holeBoth(p, q) {
  if p > q { print(1) } else { print(0) }
}
holeBoth(mkval(), opO)

// One hole and one ANNOTATED operand, the pair either side of the two-hole face.
function holeThenAnn(p, q: Ord) {
  if p > q { print(1) } else { print(0) }
}
holeThenAnn(mkval(), opO)

type Sca = new { s: i32 }

function "*"(self: Sca, k: i32): Sca {
  const r: Sca = { s: self.s * k }
  return r
}

function mkSca(): Sca {
  const r: Sca = { s: 3 }
  return r
}

function asym(p) { print((p * 4).s) }
asym(mkSca())
