// @run
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// A list element compared with a `null`-typed name is that element's null test (`nulName`),
// never the nullable record compare, in either order.
type C = { r: i32, s: i32 }
function unitLeft(xs: (C | null)[]) {
  const n = null
  return xs[0] == n
}
function unitRight(xs: (C | null)[]) {
  const n = null
  return n != xs[0]
}
function param(xs: (C | null)[], n: null) { return xs[0] == n }
print(unitLeft([null]))
print(unitLeft([{ r: 1, s: 2 }]))
print(unitRight([null]))
print(unitRight([{ r: 1, s: 2 }]))
print(param([null], null))
print(param([{ r: 1, s: 2 }], null))
