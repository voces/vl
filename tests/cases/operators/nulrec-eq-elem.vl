// @run
// @log true
// @log false
// A nullable record list element against a nullable record: the IR names it a miss (`nullable
// record eq element place`); the program runs alike either way.
type C = { r: i32 }
function eq(xs: (C | null)[], y: C | null) { return xs[0] == y }
print(eq([{ r: 1 }], { r: 1 }))
print(eq([null], { r: 1 }))
