// @run
// @log 6
// @log 5
// An operator declared after the function that uses it resolves at the use: the checker
// forces the declaration's signature on demand, for an index (`p[1]`) and a binary `+`.
type Plain = { base: i32 }
function useIdx(p: Plain) { return p[1] + 0 }
function "[]"(self: Plain, i: i32) { return self.base + i }
print(useIdx({ base: 5 }))
type V = { x: i32 }
function useAdd(a: V, b: V) { return (a + b).x }
function "+"(self: V, o: V) { return { x: self.x + o.x } }
print(useAdd({ x: 2 }, { x: 3 }))
