// @run
// @log 3
// @log 3
// @log hi
// @log side
// @log 7
// @log 2
// @log 9
// @log 5
// `null ?? d` always takes the default, so it has the default's type and value, in a record
// field, a binding, an argument and a generic call (D2261).
const v = { a: { c: null ?? 3 } }
print(v.a.c)
const x = null ?? 3
print(x)
print(null ?? "hi")
function k() {
  print("side")
  7
}
print(null ?? k())
const xs = null ?? [1, 2]
print(xs.length)
function take(c: i32) { print(c) }
take(null ?? 9)
function id<T>(t: T): T { t }
print(id(null ?? 5))
