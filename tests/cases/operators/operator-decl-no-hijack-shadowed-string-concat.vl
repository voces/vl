// @run
// @log hi!
// @log 7
// A user `"+"` operator overload must not hijack a BUILT-IN `+` on a value whose type is the
// built-in's own. `structIndexOfExpr` resolves an identifier by NAME, so the block-local
// `const n = "hi"` colliding with the module `const n: Vec` returned the Vec's struct row and
// routed the string `+` through the Vec operator — check-clean invalid wasm. D1934: the free-
// operator dispatch now gates on the operand's own OBJECT type, so a string takes the built-in.
//
// Both dispatches are exercised in one program: the shadowed string `+` (must be built-in) and
// the Vec `+` on the module binding (must be the operator). The eight-ingredient ablation lives
// in the D1934 row; each ingredient removed makes the pre-fix program run.

type Vec = new { x: i32 }

function "+"(self: Vec, other: Vec): Vec {
  const r: Vec = { x: self.x + other.x }
  return r
}

const n: Vec = { x: 3 }

if true {
  const n = "hi"
  print(n + "!")
}

const a: Vec = { x: 4 }
print((n + a).x)
