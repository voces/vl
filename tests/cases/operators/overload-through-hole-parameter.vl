// @run
// @log 0
// @log 1
// @log 0
// @log 1
// @log 36
// @log 12
// @log 288
// @log 2
// @log 0
// @log 1
// @log 36
// @log 36
// @log 1
// @hint redundant type annotation: `<` is inferred as `boolean`
// @hint redundant type annotation: `>` is inferred as `boolean`
// @hint redundant type annotation: `<=` is inferred as `boolean`
// @hint redundant type annotation: `>=` is inferred as `boolean`
// An operator overload reached through an UN-ANNOTATED parameter, at all nine overloadable
// non-bracket operators. The lookup is gated on the LEFT operand already being an object,
// and it is the lookup's own trailing `assignableExpr` that seeds a hole on the RIGHT — so
// `opO < p` resolved while `p < opO` refused `comparison expects numeric operands, got _ and
// Ord`. D1891.
//
// The `std:fmt` import is load-bearing, not scenery: with the hole unseeded the answer
// depended on whether a std module was in the graph at all, which is what D1893 named. The
// two-hole face keeps its own case (`overload-hole-two-hole-and-asymmetric.vl`) because a
// non-bracket operator may be declared once per program.

import { toString } from "std:fmt"

type Ord = new { x: i32 }

function "<"(self: Ord, other: Ord): boolean { return self.x < other.x }

function ">"(self: Ord, other: Ord): boolean { return self.x > other.x }

function "<="(self: Ord, other: Ord): boolean { return self.x <= other.x }

function ">="(self: Ord, other: Ord): boolean { return self.x >= other.x }

function "+"(self: Ord, other: Ord): Ord {
  const r: Ord = { x: self.x + other.x }
  return r
}

function "-"(self: Ord, other: Ord): Ord {
  const r: Ord = { x: self.x - other.x }
  return r
}

function "*"(self: Ord, other: Ord): Ord {
  const r: Ord = { x: self.x * other.x }
  return r
}

function "/"(self: Ord, other: Ord): Ord {
  const r: Ord = { x: self.x / other.x }
  return r
}

function "%"(self: Ord, other: Ord): Ord {
  const r: Ord = { x: self.x % other.x }
  return r
}

const opO: Ord = { x: 12 }

function mkval(): Ord {
  const r: Ord = { x: 24 }
  return r
}

// ── the hole on the LEFT, one read per operator ─────────────────────────────
function cmps(p) {
  if p < opO { print(1) } else { print(0) }
  if p > opO { print(1) } else { print(0) }
  if p <= opO { print(1) } else { print(0) }
  if p >= opO { print(1) } else { print(0) }
}
cmps(mkval())

function ariths(p) {
  print((p + opO).x)
  print((p - opO).x)
  print((p * opO).x)
  print((p / opO).x)
  print((p % opO).x)
}
ariths(mkval())

// The spelling that already resolved, as the control: the hole is on the RIGHT.
function holeRight(p) {
  if opO < p { print(1) } else { print(0) }
}
holeRight(mkval())

// The annotated twin, which never needed the flow.
function annotated(p: Ord) { print((p + opO).x) }
annotated(mkval())

// Delivered through a FIELD rather than straight from a call: the solve reads the same
// declaration whatever the argument expression is.
const srcBox = { it: mkval() }

function viaField(p) { print((p + opO).x) }
viaField(srcBox.it)

// The import is USED, so it is a real dependency rather than a decoration a lint would
// remove — D1893's ablation showed used and unused behave the same.
print(toString(1))
