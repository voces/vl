// @run
// @log true
// @log false
// A nullable records `==`/`!=` over two nullable call results, its result delivered at coalesce:
// equal, unequal, and one side null (Q58 position sweep).
type S = { a: i32 }
type T = { f: S }
function mk(k: i32): S | null { return if k > 1 { null } else { { a: k } } }
function go(c: i32) {
  const m: boolean | null = mk(1) == mk(c)
  print(m ?? false)
}
go(1)
go(2)
