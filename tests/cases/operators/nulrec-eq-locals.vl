// @log false
// @log true
// @log true
// @log true
// Two nullable record locals compared: both present and equal, one null, both null.
type S = { a: i32 }
function go(c: boolean) {
  const x: S | null = if c { { a: 1 } } else { null }
  const y: S | null = { a: 1 }
  const z: S | null = null
  print(x == y)
  print(x != y)
  print(z == z)
  print(x == z)
}
go(true)
go(false)
