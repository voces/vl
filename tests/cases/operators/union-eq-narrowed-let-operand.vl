// A union `==` whose operand is a `let` its initializer narrowed compares at the union the `let`
// is stored as (D16034).
type A = { a: i32 }
type B = { b: i32 }
const src: A = { a: 1 }
const held: A | B = src
let v: A | B = src
print(v == held)
let w: A | B = { a: 1 }
print(w == held)
let both: A | B = src
print(v == both)
const other: A | B = { b: 1 }
print(v == other)
print(v != held)
print(held == v)
function reassigned() {
  let r: A | B = src
  r = src
  print(r == held)
  r = { b: 2 }
  print(r != held)
  print(r == held)
}
reassigned()
function guarded(u: A | B) {
  if u is A { print(u == held) } else { print(u == held) }
}
guarded(src)
guarded(other)
