// @run
// @log false
// @log true
// @hint `!== null` tests for null as `!= null` does — write `!=`
// @log true
// @log true
// @log false
// @log true
// A function beside `null` or a scalar, two functions by `===`, and a record with no function
// field all keep `==`: only two operands that can both hold a function refuse it.
function inc(i: i32) { return i + 1 }
type U = ((i: i32) => i32) | i32
type P = { n: i32 }
function run(g: ((i: i32) => i32) | null, u: U) {
  print(g == null)
  print(u == 5)
  print(g === inc)
  print(g !== null)
}
run(inc, 5)
const p: P = { n: 1 }
print(p == { n: 2 })
print(inc === inc)
