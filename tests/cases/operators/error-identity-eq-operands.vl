// @check
// @error-at 9:8 cannot compare P and Q
// @error-at 10:10 `!==` compares identity, and `string` has none — use `!=`
// `===` compares two records, lists, maps or functions by identity; operands no value can share
// are refused as `==` refuses them, and an operand with no identity names the `==` spelling.
type P = { x: i32 }
type Q = { y: i32 }
function f(p: P, q: Q, s: string) {
  print(p === p)
  print(p === q)
  print(s !== "a")
}
f({ x: 1 }, { y: 2 }, "b")
