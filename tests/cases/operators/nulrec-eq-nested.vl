// @run
// @log true
// @log false
// @log true
// @log false
// Nullable records with a nested nullable record field compare field-wise through the nested
// field, its null included.
type In = { v: i32 }
type S = { a: i32, i: In | null }
function eq(x: S | null, y: S | null) { return x == y }
print(eq({ a: 1, i: { v: 2 } }, { a: 1, i: { v: 2 } }))
print(eq({ a: 1, i: null }, { a: 1, i: { v: 2 } }))
print(eq({ a: 1, i: null }, { a: 1, i: null }))
print(eq(null, { a: 1, i: null }))
