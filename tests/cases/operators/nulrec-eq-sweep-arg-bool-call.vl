// @run
// @log true
// @log false
// @log false
// @log true
// A nullable records `==`/`!=` over two nullable call results, its result delivered at arg bool:
// equal, unequal, and one side null (Q58 position sweep).
type S = { a: i32 }
type T = { f: S }
function mk(k: i32): S | null { return if k > 1 { null } else { { a: k } } }
function show(b: boolean) { print(b) }
function go(c: i32) {
  show(mk(1) == mk(c))
  show(mk(1) != mk(c))
}
go(1)
go(2)
