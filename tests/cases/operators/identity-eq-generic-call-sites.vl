// A generic body's `===` decided at each call: at a record or a list it is identity, through a
// direct call, a hole parameter, a nested generic and a method call, annotated and un-annotated.
type P = { x: i32 }
function same<T>(a: T, b: T) { a === b }
function loose(a, b) { a === b }
function differ<T>(a: T, b: T) { a !== b }
function viaHole(f, a, b) { f(a, b) }
function outer<U>(a: U, b: U) { same(a, b) }
function outerLoose(a, b) { loose(a, b) }
function isSelf<T>(self: T, other: T) { self === other }
const p: P = { x: 1 }
const q: P = { x: 1 }
print(same(p, p))
print(same(p, q))
print(loose(p, q))
print(differ(p, q))
print(viaHole(same, p, p))
print(viaHole(loose, p, q))
print(outer(p, p))
print(outerLoose(p, q))
print(p.isSelf(p))
print(p.isSelf(q))
print(same([1], [1]))
