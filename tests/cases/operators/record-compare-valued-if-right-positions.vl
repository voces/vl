// A record compare whose right operand is a valued `if` legacy stashes, the left staged below it,
// at each consumer: a `let`, an argument, an `if` condition, an interpolation, under `!`, a
// nullable compare and a `!=`.
// @run
// @log false
// @log true
// @log same
// @log v=false
// @log true
// @log true
// @log false
type P = { x: i32 }
type Q = { y: string }
function show(b: boolean) { print(b) }
function bound(u: P | Q, v: P) {
  const e = v == (if u is P { u } else { v })
  print(e)
}
function argued(u: P | Q, v: P) { show(v == (if u is P { u } else { v })) }
function cond(u: P | Q, v: P) {
  if v == (if u is P { u } else { v }) {
    print("same")
  } else {
    print("differ")
  }
}
function interp(u: P | Q, v: P) {
  print("v=\{v == (if u is P { u } else { v })}")
}
function negated(u: P | Q, v: P) { print(!(v != (if u is P { u } else { v }))) }
function nullable(u: P | Q, v: P | null) {
  print(v == (if u is P { u } else { null }))
}
function differs(u: P | Q, v: P) {
  print(v != (if u is P { u } else { { x: 1 } }))
}
const one: P = { x: 1 }
const two: P | Q = { x: 2 }
const q: P | Q = { y: "q" }
bound(two, one)
argued(q, one)
cond(q, one)
interp(two, one)
negated(q, one)
nullable(q, null)
differs(q, one)
