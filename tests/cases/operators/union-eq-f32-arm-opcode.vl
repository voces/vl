// @run
// @log 1
// @log 0
// @log 0
// @log 1
// @log 1
// @log 0
// The f32 arm of the union `==` PAYLOAD compare (`0x5b f32.eq`), on both shapes:
// union == CONCRETE (`emitUnionConcreteEq`, the other operand's rep code) and
// union == UNION (`emitUnionUnionEq`, the shared arm's banked code). The opcode is a
// projection of the value-atom KIND, and it now comes from the kind table beside the box
// tag and the value box (`atomEqOpcodeOfKind`, destringify D-EQOPCODE).
//
// The corpus pinned the i32 / string / boolean arms (`operators/union-eq*.vl`) and the
// i64 one (`union-eq-i64-arm-widens-literal.vl`, #1128) but NOT the f32 one: with the f32
// arm of the opcode table wrong, every corpus file was byte-, message- and run-identical
// (sabotage S-EQF32, 1,331 files). This file is that missing pin — it fails to
// instantiate against a build whose f32 arm is wrong ("type mismatch: expected i32,
// found f32").
//
// A float LITERAL types f64, and `f32 | string == <f64 literal>` is a CHECKER reject
// ("cannot compare f32 | string with f64") — so the concrete operand has to be an
// f32-typed binding, which is what makes this arm easy to leave unpinned.

function go() {
  const u: f32 | string = 2.5
  const w: f32 | string = 1.5
  const v: f32 | string = 2.5
  const s: f32 | string = "hi"
  const p: f32 = 2.5
  const q: f32 = 1.5
  if u == p { print(1) } else { print(0) } // concrete operand, same value
  if u == q { print(1) } else { print(0) } // concrete operand, different value
  if u == w { print(1) } else { print(0) } // union == union, different value
  if u == v { print(1) } else { print(0) } // union == union, same value
  if u != w { print(1) } else { print(0) } // `!=` negates the payload compare
  if u == s { print(1) } else { print(0) } // the other arm holds a string — unequal
}
go()
