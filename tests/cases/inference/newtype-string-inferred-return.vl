// @run
// @log ns
// @log ns2
// @log 1.5
// @log n2
// AN UN-ANNOTATED RETURN OF A NEWTYPE, all four bases.
//
// The STRING one used to check clean (`vl check` rc 0) and emit a module that does not
// instantiate: the function's result valtype fell to the i32 default while the body handed
// back the string ref (`expected i32, found (ref $type)`). Graduated from
// `soundness/xfail-miscompile-newtype-string-inferred-return.vl`, which absorbed
// `newtype-annotated-return-control.vl` on the way.
//
// THE DEFECT WAS THE ERASURE, NOT THE BRAND. A branded newtype is minted as a COPY of the
// base `Ty`, so `type NS = new string` IS a `TyPrim string` — but `tyToStrGo` checks
// `nomNameOfTy` first, so it RENDERS as `NS`. The checker's inferred-return recorder gates
// on `isClassifiableRetName`, which admits six scalar spellings and two list ones; `NS` is
// none of them, so no row was banked, and the emitter's A20 arms — which read that row —
// had nothing to read. The emitter's own comment already named this shape as inert "only
// because no recorder rung banks such a row". The fix banks it, from the ERASED type
// (`nomErasedTyIx`), which is the type the brand has at run time: a brand has no runtime
// witness and is erased before the emitter runs.
//
// WHY ONLY THE STRING BASE BROKE, and the other three arms are what say so: `fs` ANNOTATES
// the return, and the annotated path always erased correctly; `ff` is a newtype over f64,
// whose rep is the i32 default's sibling scalar and needs no ref valtype to disagree about;
// and `f2` is a brand OVER a brand, which reaches `string` because the erasure iterates to a
// fixpoint rather than peeling one layer.
type NS = new string
type NF = new f64
type N2 = new NS

function fn(x: NS) {
  const y = x
  return y
}

function fs(x: NS): NS {
  const y = x
  return y
}

function ff(x: NF) {
  const y = x
  return y
}

function f2(x: N2) {
  const y = x
  return y
}

print(fn("ns"))
print(fs("ns2"))
print(ff(1.5))
print(f2("n2"))
