// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_sp` (leading `_` marks it unused)
// @hint redundant type annotation: `viaI32` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `hook` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `viaLam` is inferred as `i32` — remove it to lean on inference
// An un-annotated function returning a binding whose name an earlier, dead-scoped binding of
// another type also uses is typed by the returned binding, at the callee and at an i32 caller:
// i64, f64, string and boolean shadows (D3236).
function pick(c: boolean, big: i64, small: i32) {
  if c {
    const s = big + 1
    print(s)
  }
  if !c {
    const s = small
    return s
  }
  0
}
function viaI32(): i32 {
  const r = pick(false, 9, 7)
  if r >= 0 { return r }
  0
}
print(viaI32())
print(pick(false, 9, 7))
function flag(c: boolean, small: i32) {
  if c {
    const s = small > 3
    print(s)
  }
  if !c {
    const s = small + 1
    return s
  }
  0
}
print(flag(false, 7))
type GuestCall = (i64, i32, i64) => i32
function sync(call: GuestCall, entry: i64) {
  let i = 0
  while i < 1 {
    const s = entry + i * 16
    print(s)
    i += 1
  }
  if entry != 0 {
    const s = call(entry, 1, entry)
    if s != 0 { return s }
  }
  0
}
function hook(): i32 {
  const s = sync((_t: i64, r: i32, _sp: i64) => r + 1, 5)
  if s != 0 { return s }
  0
}
print(hook())
const lam = (c: boolean, small: i32) => {
  if c {
    const s = "x"
    print(s)
  }
  if !c {
    const s = small
    return s
  }
  0
}
function viaLam(): i32 { lam(false, 4) }
print(viaLam())
function dbl(c: boolean, small: f64) {
  if c {
    const s = 1
    print(s)
  }
  if !c {
    const s = small * 2.0
    return s
  }
  0.0
}
print(dbl(false, 3.0))
