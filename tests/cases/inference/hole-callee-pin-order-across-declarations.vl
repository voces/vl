// @run
// @log 2.5
// @log 2.5

// A callee's write re-deferred into its caller pins in the order the caller's body was
// checked, whichever of the two is declared first (D2218).
function takeFirst(a) { a.push(1) }
function midAfter(b) {
  b[0] = 1.5
  takeFirst(b)
  print(b[0] + b[3])
}

function midBefore(b) {
  b[0] = 1.5
  takeAfter(b)
  print(b[0] + b[3])
}
function takeAfter(a) { a.push(1) }

midAfter(__array_new_default__(3))
midBefore(__array_new_default__(3))
