// @error push: cannot add string to (i32 | null)[]
// CONTRACT (must-error): a hole parameter's body that stores one argument's open `_ | null`
// into another's links the two call-site holes at the call (D2506), so `b.push(4)` fills `a`'s
// element too and the `string` push disagrees. Filled apart, `link`'s instance stored `b`'s
// `i32` box into `a`'s `string` list: check-clean invalid wasm.
function link(xs, ys) { xs.push(ys[0]) }
function main() {
  const a = []
  a.push(null)
  const b = []
  b.push(null)
  link(a, b)
  b.push(4)
  a.push("s")
  print(a.length)
}
main()
