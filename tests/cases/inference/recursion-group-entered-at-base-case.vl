// @run
// @log 0
// @log 4
// @log 4
// @log 7
// A recursion group among un-annotated functions infers whichever member the program
// reaches first, including the member holding the base case and a member read as a value (D7761).
print(b(3))

function rest(n: i32) { b(n - 1) }

function b(n: i32) {
  if n > 0 { return 0 }
  return rest(n)
}

print(c3(4))
function a3(n: i32) { return b3(n) + 1 }
function b3(n: i32) { return c3(n - 1) }
function c3(n: i32) {
  if n <= 0 { return 0 }
  return a3(n)
}

type N = { k: i32 }
function down(self: N) {
  if self.k <= 0 { return 0 }
  return { k: self.k - 1 }.up()
}
function up(self: N) { return self.down() + 1 }
print({ k: 3 }.up())

function pick() { return bv }
function av(n: i32) {
  if n <= 0 { return 7 }
  return bv(n - 1)
}
function bv(n: i32) { return av(n) }
print(pick()(3))
