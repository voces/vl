// @run
// @warning the element type of 'm' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 's' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'r.f' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'xs[i]' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'h.a[i].b' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of a container this argument holds is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'k.index' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'g' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @warning the element type of 'e' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @log 0
// @log false
// @log 0
// @log 0
// @log 1
// @log 1
// @log 0
// @log 2
// @log 0
// @log 0
// @log 0
// A container no write ever fixes holds no value, so it runs at the unbound default in every
// position; a read's key is the key it defaults to. Each gets the warning naming the place.
const m = Map()
print(m.length)
print(m.has("a"))
const s = Set()
print(s.length)
const r = { f: Map(), g: [] }
print(r.f.length + r.g.length)
const xs = [Map()]
print(xs.length)
const h = { a: [{ b: Set() }] }
print(h.a.length)
function u(a) { print(a.f.length) }
u({ f: Map() })
function mk() { { index: Map(), n: 2 } }
const k = mk()
print(k.n + k.index.length)
const g = Map()
function rg() { g.length }
print(rg())
function gen<T>(_x: T) {
  const e = Map()
  print(e.length)
}
gen(1)
gen("x")
