// @run
// @log 1
// @log 2
// @log 1
// @log big
// @log big
// @log 2
// An inferred return of `.map` whose callback returns a union is built at the list row of the
// checked element type (D4711).
type Pet = i32 | string
function mk(n: i32): Pet {
  if n > 2 { return "big" }
  return n
}
function go(xs: i32[]) { return xs.map(mk) }
print(go([3]).length)
const r = go([1, 3])
print(r.length)
print(r[0])
print(r[1])
for p in go([5, 2]) { print(p) }
