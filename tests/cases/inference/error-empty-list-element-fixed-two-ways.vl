// @check
// @error cannot assign string to 'f' of type f64
// Two uses fix one empty list's element to different types: the first decides, and the second is
// refused at check (DECISIONS.md "No default type").
const r = { xs: [] }
if r.xs.length > 0 { const s: string = r.xs[0]; print(s) }
if r.xs.length > 0 { const f: f64 = r.xs[0]; print(f) }
print(r.xs.length)
