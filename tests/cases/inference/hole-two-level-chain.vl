// @run
// @log s
// @log s
// @log s
// @log 42
// @log 42
// @log 42
// @log 1
// @log a
// @log hello
// The must-not-error twin of `soundness/hole-two-level-chain-reject.vl`. A derived
// hole that RE-BASES onto the caller's hole must only reject when the outer pin
// really does disagree with the sink — every spelling here agrees (or has no
// annotated sink at all), so they keep type-checking and running.
//
// Re-basing is pure substitution: `?fld.bar.<hgb>` under `<hgb> := <hgo>` denotes
// the same read on the same value, now named by the caller's hole. Nothing about
// it may narrow what a program is allowed to do.
//
// Each chain gets its OWN helper names, and the i32 chains read a DIFFERENTLY
// NAMED field from the string ones: monomorphizing one un-annotated body at two
// different pins, and interning `{bar: string}` beside `{bar: i32}` in a single
// program, are separate pre-existing emitter gaps (both reproduce identically on
// master) that this file is not pinning.
function ps(t: string) { print(t) }

// The chain pinned to a MATCHING type, at one hop and at two.
function gbS(v) { return v.bar }
function goFieldS(w) { ps(gbS(w)) }
goFieldS({ bar: "s" })

function gbS3(v) { return v.bar }
function midFieldS(u) { return gbS3(u) }
function goFieldS3(w) { ps(midFieldS(w)) }
goFieldS3({ bar: "s" })

function gbSr(v) { return v.bar }
function relayFieldS(w) { return gbSr(w) }
ps(relayFieldS({ bar: "s" }))

// No annotated sink: `print` takes the field's real type through every hop.
function gbI(v) { return v.qux }
function goPrintI(w) { print(gbI(w)) }
goPrintI({ qux: 42 })

function gbI3(v) { return v.qux }
function midFieldI(u) { return gbI3(u) }
function goPrintI3(w) { print(midFieldI(w)) }
goPrintI3({ qux: 42 })

// FOUR hops, still fine.
function gbI4(v) { return v.qux }
function m1(u) { return gbI4(u) }
function m2(u) { return m1(u) }
function goPrintI4(w) { print(m2(w)) }
goPrintI4({ qux: 42 })

// The index flavour, agreeing — at `print` and at an annotated sink.
function hdI(v) { return v[0] }
function goElemPrint(w) { print(hdI(w)) }
goElemPrint([1, 2, 3])

function hdS(v) { return v[0] }
function goElemS(w) { ps(hdS(w)) }
goElemS(["a", "b"])

// A wider argument than the read demands still resolves to the read's own type.
function gbW(v) { return v.zed }
function goWide(w) { ps(gbW(w)) }
goWide({ zed: "hello", zot: 1 })
