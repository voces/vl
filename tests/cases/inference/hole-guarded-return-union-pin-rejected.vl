// @check
// @error cannot assign i64 to i32 — `c` on line 10 has no annotation, so its literal defaulted to `i32`; annotate it: `let c: i64 = …`
// D3094: a call to an un-annotated function whose `is i64` branch returns `i64` has that branch
// in its type when the argument is a union holding `i64`, as the annotated parameter's does.
const zs: (i64 | string)[] = [5, "t", 6]
function g(w) {
  if w is i64 { return w + 1 }
  return 0
}
let c = 0
for e in zs { c = c + g(e) }
print(c)
