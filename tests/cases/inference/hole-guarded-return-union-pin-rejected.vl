// @check
// @error cannot assign i64 to i32
// D3094: a call to an un-annotated function whose `is i64` branch returns `i64` has that branch
// in its type when the argument is a union holding `i64`, as the annotated parameter's does: an
// `i32` accumulator refuses it. The un-annotated accumulator takes `i64` from that sum and runs
// (`inference/hole-guarded-return-union-sum.vl`).
const zs: (i64 | string)[] = [5, "t", 6]
function g(w) {
  if w is i64 { return w + 1 }
  return 0
}
let c: i32 = 0
for e in zs { c = c + g(e) }
print(c)
