// @run
// @log true
// @log false
// @log s
// @log 7
// @log 7
// @log null
// @log false
// @log null
// @log s
// @log null
// @log 7
// @log 6

// D2597: a `let x = null` whose hole a later write fills is `T | null`, and takes the cell its
// annotated twin has. A `boolean` or `string` fill was lowered as a value box the type has no
// row for (a refusal, or invalid wasm), a record or list fill refused, and a write whose own
// type is `T | null` did not fill the hole at all, so the binding stayed the `null` type and
// printed `null`. A hole only a closure fills is the same binding (D2421).
type C = { a: i32 }
function mkB(): boolean | null { return false }
function mkS(b: boolean): string | null {
  if b { return null }
  "s"
}
function mkC(): C | null { return { a: 7 } }
function mkL(): i32[] | null { return [7] }

let b = null
b = true
print(b)
let c = null
c = mkB()
print(c)

function locals(t: boolean) {
  let s = null
  if t { s = "s" }
  print(s)
  let r = null
  r = { a: 7 }
  print(r.a)
  let l = null
  l = mkL()
  if l != null { print(l[0]) }
  let n = null
  n = mkS(true)
  print(n)
}
locals(true)

let g = null
function readG() { print(g) }
g = mkB()
readG()
let h = null
h = mkS(true)
print(h)
h = mkS(false)
print(h)
let k = null
k = mkC()
if k == null { print("null") }
const q = mkC()
if q != null {
  k = null
  if k == null { print("null") }
  k = q
  if k != null { print(k.a) }
}

function closureFills() {
  let x = null
  const k = () => {
    x = 5
  }
  k()
  if x != null { return x + 1 }
  0
}
print(closureFills())
