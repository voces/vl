// @run
// @log yy
// @log 2.5
// @log yy
// @log dd
// @log bb
// @log 1
// @log dd
// D16004, D3234: a union argument meets an un-annotated parameter's demand member by member, so
// the member an `is` guard takes meets the guard and any other meets the field reads after it:
// the else arm's field read, a three-member chain, an early return, a pin of three records two of
// which hold the field, two pins, and a forwarder.
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: string }
type C = { kind: "c", z: f64 }
type D = { kind: "d", y: string, w: i32 }
function mkAB(): A | B { return { kind: "b", y: "yy" } }
function mkABC(): A | B | C { return { kind: "c", z: 2.5 } }
function mkABD(): A | B | D { return { kind: "d", y: "dd", w: 9 } }
function field(p) {
  if p is A { print(p.x) } else { print(p.y) }
}
function chain(p) {
  if p is A { print(p.x) }
  else if p is B { print(p.y) }
  else { print(p.z) }
}
function early(p) {
  if p is A {
    print(p.x)
    return 0
  }
  print(p.y)
  0
}
function outer(q) { field(q) }
field(mkAB())
chain(mkABC())
early(mkAB())
field(mkABD())
const b: B = { kind: "b", y: "bb" }
field(b)
const ab: A | B = { kind: "a", x: 1 }
field(ab)
outer(mkABD())
