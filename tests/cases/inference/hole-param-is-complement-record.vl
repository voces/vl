// @run
// @log yy
// @log yy
// @log 2.5
// @log yy
// @log yy
// @log dd
// @log bb
// @log 1
// @log dd
// D16004: the else arm of `if p is A` over an un-annotated parameter reads the members the test
// leaves at the pin, for a record `A` too, as the parameter annotated with the pin's type does:
// a field read, an argument, a three-member chain, a negated test, an early return, a pin of
// three records two of which hold the field, two pins, and a forwarder.
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: string }
type C = { kind: "c", z: f64 }
type D = { kind: "d", y: string, w: i32 }
function mkAB(): A | B { return { kind: "b", y: "yy" } }
function mkABC(): A | B | C { return { kind: "c", z: 2.5 } }
function mkABD(): A | B | D { return { kind: "d", y: "dd", w: 9 } }
function useB(b: B) { print(b.y) }
function field(p) {
  if p is A { print(p.x) } else { print(p.y) }
}
function arg(p) {
  if p is A { print(p.x) } else { useB(p) }
}
function chain(p) {
  if p is A { print(p.x) }
  else if p is B { print(p.y) }
  else { print(p.z) }
}
function negated(p) {
  if !(p is A) { print(p.y) } else { print(p.x) }
}
function early(p) {
  if p is A {
    print(p.x)
    return 0
  }
  print(p.y)
  0
}
function outer(q) { field(q) }
field(mkAB())
arg(mkAB())
chain(mkABC())
negated(mkAB())
early(mkAB())
field(mkABD())
const b: B = { kind: "b", y: "bb" }
field(b)
const ab: A | B = { kind: "a", x: 1 }
field(ab)
outer(mkABD())
