// @run
// @log i
// @log i
// @log false
// @hint redundant type annotation: `f` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @warning Unused parameter `a` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `g` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @warning `is` check type 'string' can never match a value of type i32, so this test is always false here
// @warning match pattern `string` can never match a value of type i32 here, so this arm never runs
// @warning cannot compare (i32) => i32 with (string) => i32 here, so this comparison is always false
// A test a guard's narrowing made impossible is a dead test, a warning, and lowered over the
// declared type, so it runs (owner ruling 2026-11-12).
function f(a: i32): i32 { return a }
function g(a: string): i32 { return 0 }
function mk(): i32 | string { return 1 }
function pick(b: boolean): ((a: i32) => i32) | ((a: string) => i32) {
  if b { return f } else { return g }
}
function isTest() {
  const x = mk()
  if x is i32 {
    if x is string { print("s") } else { print("i") }
  }
}
function matchArm() {
  const x = mk()
  if x is i32 {
    match x {
      i32 => print("i")
      string => print("s")
    }
  }
}
function eqTest() {
  const u = pick(true)
  const v = pick(false)
  if u is (a: i32) => i32 {
    if v is (a: string) => i32 { print(u == v) }
  }
}
isTest()
matchArm()
eqTest()
