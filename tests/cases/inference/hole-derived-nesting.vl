// @run
// @log 7
// @log inner
// @log 4
// A derived inference hole is a DERIVATION, and derivations NEST: a field of a
// field, an element of a field. Each layer used to be a prefix glued onto the
// previous layer's NAME (`?elem.?fld.xs.?f.0`), taken apart again by prefix match
// plus recursive slicing; it is a row in a side table now, whose base points at the
// layer below. This file pins the NESTING — the shapes where a derivation stacks on
// another derivation, including two different KINDS in one chain.
//
// Every case here runs identically on master: this is coverage the corpus did not
// have, not new behaviour.
//
// Each chain gets its OWN helper names and its OWN field names, for the reason
// `hole-two-level-chain.vl` already records: monomorphizing one un-annotated body
// at two different pins, and interning `{b: i32}` beside `{b: string}` in a single
// program, are separate pre-existing emitter gaps that this file is not pinning.

// FIELD of FIELD — `?fld.b.?fld.a.<h>`. `innerB`'s read re-bases onto `outerA`'s
// hole at the inner call, and only the OUTERMOST call pins the chain.
function innerB(w) { return w.b }
function outerA(v) { return innerB(v.a) }
print(outerA({ a: { b: 7 } }))

// The same two-layer nesting carrying a string, so what resolves is the pinned
// field's type and not an i32 that happened to be there.
function innerQ(w) { return w.q }
function outerP(v) { return innerQ(v.p) }
print(outerP({ p: { q: "inner" } }))

// ELEMENT of FIELD — `?elem.?fld.xs.<h>`: an indexed read whose receiver is itself
// a derived field hole. Two different derivation KINDS in one chain.
function firstOfXs(v) { return v.xs[0] }
print(firstOfXs({ xs: [4, 5, 6] }))
// NOT PINNED HERE: RETURN of FIELD (`?ret.?fld.fn.<h>` — calling a function-typed
// field of an un-annotated param, `function callFn(v) { return v.fn(9) }`). The
// checker resolves that chain; the EMITTER rejects it with `emitProgram: unknown
// struct field in field access`, identically on master and on this branch. A
// pre-existing emit gap, not this refactor's, and left uncovered rather than baked
// into a fixture that would pin the rejection.
