// @run
// @log 7
// @log true
// @log none
// @log false
// @log 0
// @log 0
// @log done
// A read of a container nothing but reads ever uses is checked as if it were annotated at the
// unbound default: a loop over it binds the default, a `get` answers the default or null.
const xs = []
for x in xs { print(x + 1) }
const m = Map()
print(m.get("a") ?? 7)
print(m.get("b") == null)
print(m.get("c") ?? "none")
for k in m { print(k) }
for v in m.values() { print(v) }
const s = Set()
for e in s { print(e) }
print(s.has(3))
function f() {
  const ys = []
  for y in ys { return y }
  return ys.length
}
print(f())
const g = () => xs.length
print(g())
print("done")
