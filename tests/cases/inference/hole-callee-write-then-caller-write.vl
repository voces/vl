// @run
// @log 1.5
// @log 5
// @log 1.5
// @log 1
// @log 0.5
// @log 1.5
// @log 2
// @log 0.5
// @log 2.5
// @log 1.5
// @log 2.5
// @log 4294967295
// @log 1
// A hole callee's write into a list binding comes first in program order, so it decides the
// element when it cannot take the caller's later write, exactly as `h.push(1.5); h.push(2)`
// does: the later `2` adapts to `f64` (D3775). A callee write the later one can hold, a literal
// `1` beside a later `2.5`, leaves the later write to decide, as before (D2218).
function take(a) {
  a.push(1.5)
  print(a[3])
}
const h = __array_new_default__(3)
take(h)
h.push(2)
print(h.length)

function put(a) { a.push(1.5) }
const p = []
put(p)
p.push(2)
print(p[0])
print(p[1] / 2)

const q = __array_new_default__(2)
put(q)
q[0] = 2
print(q[0] / 4)
print(q[2])

function inner(k: i32) {
  const r = []
  put(r)
  r.push(k)
  print(r[1])
}
inner(2)

function one(a) { a.push(1) }
const s = []
one(s)
s.push(2.5)
print(s[0] / 2)
print(s[1])

function same(a) { a.push(1.5) }
const t = []
same(t)
t.push(2.5)
print(t[0])
print(t[1])

function wide(a, v: i64) { a.push(v) }
const u = []
wide(u, 0xffffffff)
u.push(1)
print(u[0])
print(u[1])
