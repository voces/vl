// @error the element type of `o` is still open here — fill or annotate it before passing it to `call`
// CONTRACT (must-error): an open `_ | null` element at any depth of an argument refuses a call
// to a hole-parameter function (D2506). Here the element sits
// under a binding of seven nested records, past the depth a bounded walk
// once stopped at, where the instance stored into it as invalid wasm.
function call(o) { const r = o.a.b.c.d.e.f.g; r.push(null); r.length }
function main() {
  const a = []
  a.push(null)
  const o = { a: { b: { c: { d: { e: { f: { g: a } } } } } } }
  print(call(o))
  a.push("s")
  print(a.length)
}
main()
