// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// A captured `let x = null` read inside a callback that runs before the write filling it, at
// each destination: the destination's own null, whatever the cell later holds.
type Pt = { a: i32 }
function str(s: string | null) { return if s == null { 1 } else { 0 } }
function flag(f: boolean | null) { return if f == null { 2 } else { 0 } }
function lit(k: "a" | "b" | null) { return if k == null { 3 } else { 0 } }
function rec(p: Pt | null) { return if p == null { 4 } else { 0 } }
function num(n: i32 | null) { return if n == null { 5 } else { 0 } }
function app(f: () => i32) { return f() }
function main() {
  let x = null
  print(app(() => str(x)))
  print(app(() => flag(x)))
  print(app(() => lit(x)))
  print(app(() => rec(x)))
  print(app(() => num(x)))
  print(app(() => if x == null { 6 } else { 0 }))
  print(
    app(() => {
      const s: string | null = x
      return if s == null { 7 } else { 0 }
    }),
  )
  print([1].map((e) => e + 7 * str(x))[0])
  print(app(() => (x ?? 9)))
  x = 5
}
main()
