// @run
// @log 3
// @log 5
// @log 1
// @log 2
// @log s3
// @log 4
// @log 6
// @log 2
// @log 2.5
// @log B
// @log str t
// @log i32 7
// @log k
// @hint redundant type annotation: `c` is inferred as `boolean` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `a` is inferred as `Box<i32>` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `Box<f64>` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `string` — remove it to lean on inference
// A read of a `let` of a union type takes its most recent write's member (DECISIONS.md, "A
// read of a `let` takes its most recent write's type"); a join, a loop head and a capture
// called after a later write read the storage.
type Box<T> = { v: T }
type A = { n: i32 | string }
type B = { n: string }
function c(): boolean { return true }
function straight() {
  let x: i32 | string = 1
  x = "sss"
  print(x.length)
  let y: i32 | string = "t"
  if c() { y = 4 } else { y = 5 }
  print(y + 1)
}
function joins() {
  let z: i32 | string = 1
  if c() { z = "s" }
  if z is string { print(z.length) } else { print(z) }
  let w: i32 | string = 2
  let i = 0
  while i < 2 {
    if w is i32 { print(w) } else { print(w) }
    w = "s" + "3"
    i = i + 1
  }
}
function capture() {
  let v: i32 | string = 1
  const gv = () => v
  v = "s"
  const r = gv()
  if r is string { print(r.length + 3) } else { print(r) }
  const ys = [1].map((e) => e + 5)
  print(ys[0])
}
function members() {
  let q: Box<i32> | Box<f64> | string = "s"
  q = { v: 2 }
  const a: Box<i32> = q
  print(a.v)
  q = { v: 2.5 }
  const b: Box<f64> = q
  print(b.v)
}
function fits() {
  const a: A = { n: "now" }
  let w: A | B = a
  if w is B { print("B") } else { print("no") }
  w = { n: "x" }
}
function tests() {
  let h: i32 | string = 7
  h = "t"
  if h is string { print("str " + h) } else { print("i32") }
  let m: i32 | string | boolean = 7
  if c() { m = "x" }
  match m {
    i32 => print("i32")
    string => print("i32 " + "7")
  }
}
function lits() {
  let k: string | i32 = 1
  k = "k"
  const s: string = k
  print(s)
}
straight()
joins()
capture()
members()
fits()
tests()
lits()
