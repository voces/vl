// @run
// @log s
// @log f
// @log 42
// @log 42
// @log 42
// @log q
// @log q
// @log 1
// The must-not-error twin of `soundness/hole-join-two-level-chain-reject.vl`. The
// uncollapsed deferred join is now carried one hop further — through a relay's
// inferred return, and into the deferred argument constraint. That must not turn
// a join whose arms AGREE at the pin (or that re-folds to a single live arm) into
// a diagnostic, and it must not let a checker-internal placeholder reach codegen.
//
// As in `hole-two-level-chain.vl`, each chain gets its own helper names and the
// i32 field is spelled differently from the string one — mixing pins of one body,
// and interning `{bar: string}` beside `{bar: i32}`, are separate pre-existing
// emitter gaps that reproduce identically on master.
function ps(t: string) { print(t) }

// The guard join RELAYED into a matching annotated sink: the `bar` arm is the one
// `{bar: "s"}` reaches, and it IS a string.
function hS(v) {
  if v is { foo: string } then return v.foo
  return v.bar
}
function relayS(w) { return hS(w) }
ps(relayS({ bar: "s" }))

// Both guard arms still reachable through a relay, at `print` — the GUARD arm ...
function hF(v) {
  if v is { foo: string } then return v.foo
  return v.qux
}
function relayF(w) { return hF(w) }
print(relayF({ foo: "f" }))

// ... and the COMPLEMENT arm.
function hG(v) {
  if v is { foo: string } then return v.foo
  return v.qux
}
function relayG(w) { return hG(w) }
print(relayG({ qux: 42 }))

// Relay of a relay — the join survives two hops and still re-folds to one arm.
function hR(v) {
  if v is { foo: string } then return v.foo
  return v.qux
}
function relayR(w) { return hR(w) }
function relayR2(w) { return relayR(w) }
print(relayR2({ qux: 42 }))

// The join sunk from inside ANOTHER generic body, agreeing at the pin.
function hM(v) {
  if v is { foo: string } then return v.foo
  return v.qux
}
function midM(u) { return hM(u) }
function goRelay(w) { print(midM(w)) }
goRelay({ qux: 42 })

// A non-guard join whose arms AGREE once the outer call pins them.
function pick(a, b, c) {
  if c then return a
  return b
}
function goPick(x) { print(pick(x, "s", true)) }
goPick("q")

// The same through a relay's return.
function pick2(a, b, c) {
  if c then return a
  return b
}
function midPick(x) { return pick2(x, "s", true) }
function goPick3(x) { print(midPick(x)) }
goPick3("q")

// Both arms holes, both pinned to the same type.
function pick3(a, b, c) {
  if c then return a
  return b
}
function goTwo(x, y) { print(pick3(x, y, true)) }
goTwo(1, 2)
