// @run
// @log 0
// @log 0
// @log 0
// D3109: a scalar `is` test over an un-annotated parameter pinned at a nullable record is false,
// and the call's result is read at what the instance returns, not the type that dropped the branch.
type Circle = { r: i32 }
const zs: (Circle | null)[] = [{ r: 4 }, null]
function g(w) {
  if w is i64 { return w }
  return 0
}
print(g(zs[0]))
print(g(zs[1]))
let acc = 0
acc = acc + g(zs[0])
print(acc)
