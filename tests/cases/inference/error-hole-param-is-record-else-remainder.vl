// @check
// @error operator '*' is not defined for string and i32 (the call's argument types)
// @error no field 'length' on B (the body of `lenB` at the call's argument types)
// D16008: the else arm of a record `is` test over an un-annotated parameter is checked against
// the pin minus the tested record, so a use no remaining member supports is still refused.
type A = { v: i32 }
type B = { w: string }
function mul(h) {
  if h is A { print(h.v) } else { print(h * 2) }
}
function lenB(h) {
  if h is A { print(h.v) } else { print(h.length) }
}
const s: A | string = "s"
mul(s)
const b: A | B = { w: "ww" }
lenB(b)
