// @run
// @log hi
// @log 7
// @log 1.5
// @log 2.5
// @log true
// TRANSPARENT ALIASES OVER SCALARS — the shapes that LOOK like unions and are prims.
//
// `type S = string` interns as a ONE-MEMBER `TyUnion`: the parser encodes every non-`{`-bodied
// `type N = …` as a one-member `UnionDecl`. A one-member union also RENDERS as its member, bare
// (`tyToStr`'s join writes its separator only for `i > 0`), so `S` and `string` are the one
// place where a non-`TyPrim` and a `TyPrim` produce the same spelling.
//
// What keeps that from mattering is the TRANSPARENCY COLLAPSE — `declaredTyOfName`, the single
// bottom of every name-resolution route, collapses a one-member union over a `TyPrim`
// unconditionally (`singleAliasMemberTyIx`) — so the arena holds the plain `TyPrim` and the
// wrapper is never handed out as a value's type.
//
// This file pins that. `buildFnMap`'s five scalar return arms read `T.tys[ty] is TyPrim` off the
// banked inferred-return type, so if the collapse is ever gated those arms silently narrow: an
// un-annotated `S`-returning function would stop being classified `"str"` and its call sites
// would read a string ref as the i32 default. Nothing else in the corpus guards this — the arms
// were converted with 0 disagreements over 177 files, and the corpus could not have contained
// the failure.
type S = string
type I = i64
type F = f64
type G = f32
type B = boolean

function fs(x: S) {
  const y = x
  return y
}
function fi(x: I) {
  const y = x
  return y
}
function ff(x: F) {
  const y = x
  return y
}
function fg(x: G) {
  const y = x
  return y
}
function fb(x: B) {
  const y = x
  return y
}

print(fs("hi"))
print(fi(7))
print(ff(1.5))
print(fg(2.5))
print(fb(true))
