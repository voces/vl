// @run
// @log 3.5
// @log 5000000000
// @log 1.5
// @log 2.5
// @log 2.5
// @log 2.5
// @hint redundant type annotation: `x` is inferred as `f64`

// D2218's pin decides only a list written at the call (`[]`, `__array_new_default__(n)`). A
// binding handed to a pushing hole callee keeps its own later writes, which may still widen it.
function fillV(a, v) { a.push(v) }
function fill0(a) { a.push(0) }
function fill1(a) { a.push(1) }

const b1 = []
fillV(b1, 1)
b1.push(2.5)
print(b1[0] + b1[1])

const b2 = []
fill0(b2)
b2.push(5000000000)
print(b2[1])

function main() {
  const x: f64 = 1.5
  const b3 = []
  fill0(b3)
  b3.push(x)
  print(b3[1])

  const b4 = __array_new_default__(3)
  fill1(b4)
  b4[0] = 1.5
  print(b4[0] + b4[3])
}
main()

const b5 = __array_new_default__(3)
fill1(b5)
b5[0] = 1.5
print(b5[0] + b5[3])

const b6 = []
fill1(b6)
b6.push(1.5)
print(b6[0] + b6[1])
