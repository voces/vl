// @run
// @log none
// @log 4
// @log none
// @log true
// @log true
// @log true
// @log none
// @log 9
// @hint Intentionally-unused variable `_sh` (leading `_` marks it unused)
// @hint redundant type annotation: `v2` is inferred as `C | null` — remove it to lean on inference
// D1567 — AN UN-ANNOTATED FUNCTION WHOSE EVERY RETURNED VALUE IS A BARE `null`. The checker
// types that return `TyPrim:null` — the `null` TYPE, not a nullable of anything — so every
// producer in the inferred-return recorder declined, `fRetKind` kept its `"i32"` default, and
// the body's own `null` reached `emitNullLitNode` with no seed: a loud reject after a clean
// `vl check`, at every delivery position (left loud by D1563, previously papered over by the
// leaked variant seed).
//
// The rep is `nullref`, the bottom of the GC hierarchy: one value, a subtype of every
// nullable ref valtype. That is what makes ONE result serve a struct / variant / string /
// list / map / closure destination with no coercion — and why the three i32-repped nullables
// below are the cells that need `emitDirectCall` to convert.

type C = { a: i32, b: i32 }
type Circle = { r: i32 }
type Sq = { w: i32 }
type Shape = Circle | Sq

function np() {
  return null
}

// The TAIL spelling of the same function — two spellings of one return must agree.
function npTail() {
  null
}

// (1) THE FILED SHAPE — a nullable-STRUCT destination takes the `nullref` result unchanged.
const v: C | null = np()
if v != null { print(v.a) } else { print("none") }

// (2) THE CONTROL: the same destination given a real value still reads it back. The
// annotation draws `@hint redundant type annotation` and is KEPT: the hint is the checker
// agreeing about the TYPE, and this row is about the REP. `v` above draws no such hint,
// which is the same fact from the other side — `np()` is typed `null`, not `C | null`.
function some(): C | null { return { a: 4, b: 5 } }
const v2: C | null = some()
if v2 != null { print(v2.a) } else { print("none") }

// (3) THE `nulvariant` NICHE — `Circle` is an ARM of `Shape`, so the cell is a
// `(ref null $uVarHeap[vi])` and not a box. `nullref` is a subtype of that heap too.
const _sh: Shape = { r: 3 }
const vc: Circle | null = npTail()
if vc != null { print(vc.r) } else { print("none") }

// (4) THE THREE i32-REPPED NULLABLE DESTINATIONS, which `nullref` is NOT a subtype of: the
// `boolean | null` sentinel 2, the `K | null` sentinel -1, and the value-union BOX. Each is
// converted at the call — the two niches by a drop and the sentinel, the box by the
// null-TAGGED box whose payload is the call itself (so the call still happens).
type K = "a" | "b"
const vb: boolean | null = np()
print(vb == null)
const vk: K | null = np()
print(vk == null)
const vu: i32 | null = np()
print(vu == null)

// (5) A NULLABLE-STRUCT FIELD fed from the same call, and read back.
type W = { f: C | null }
const w: W = { f: np() }
if w.f != null { print(w.f.a) } else { print("none") }

// (6) STATEMENT POSITION — the result is discarded, and the call must still run.
let pick = 0
function bump() {
  pick = 9
  return null
}
bump()
print(pick)
