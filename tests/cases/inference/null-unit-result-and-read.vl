// @run
// @log 0
// @log 0
// @log true
// @log true
// A function whose result is the `null` unit returns legacy's bottom ref, and a read of a
// `null` unit binding is its destination's null: through a callback, a call and an identity.
function q(f: () => i32 | null) {
  const t = f()
  return if t == null { 0 } else { 1 }
}
function nn() { return null }
print(q(() => null))
print(q(nn))
const z = nn()
print(z == null)
function hid(x) { return x }
print(hid(null) == null)
