// @error cannot bind the void result of 'x'
// CONTRACT (must-error): a function with a bare `return` is `: void` from its hoist on, so a
// caller that infers its return from a tail call to it reads `void` whatever the source order,
// and a binding of that caller's result is refused as the `g`-first spelling is (D7760).
function a(n: i32) {
  const x = b(n)
  print(x)
}
function b(n: i32) { g(n) }
function g(n: i32) {
  if n > 5 { return }
  print(n)
}
a(1)
