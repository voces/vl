// @run
// @log foo
// @log bar
// @log A
// @log B
// @log 1
// @log two
// An `is` GUARD over an un-annotated param contributes an ALTERNATIVE constraint,
// not extra demanded fields. Inside the then-branch `v` is NARROWED to the tested
// type, so `v.foo` reads the narrowed binding and never grows the param hole's
// demanded shape — only the fall-through `v.bar` does. Checking every argument
// against that shape alone rejected `{foo: string}`, the very argument the guard
// exists to accept ("argument 1: expected {bar: any}, got {foo: string}"). The
// call-arg check now accepts the demanded shape OR any recorded alternative, and
// the emitter drops the complement statements a statically-TRUE guard makes dead.
function foobar(v) {
  if v is { foo: string } then return v.foo
  return v.bar
}
print(foobar({ foo: "foo" })) // takes the guard — never touches `.bar`
print(foobar({ bar: "bar" })) // takes the complement path

// TWO guards, each its own alternative, plus the complement.
function pick(v) {
  if v is { a: string } then return v.a
  if v is { b: string } then return v.b
  return v.c
}
print(pick({ a: "A" }))
print(pick({ b: "B" }))

// The guard's arms as `then`/`else`: the else arm's field demand belongs to the
// complement path alone, so the guard's own shape is still accepted.
function either(v) {
  if v is { left: i32 } then return v.left
  else return v.right
}
print(either({ left: 1 }))
print(either({ right: "two" }))
