// @run
// @log 4
// @log 4
// @log 4
// A member call to an un-annotated recursion-group member declared after its caller types as
// the member's return, like the backward and plain spellings (D17073).
type N = { k: i32 }

// Method-style, forward: `up` is declared after `down`.
function down(self: N) {
  if self.k <= 0 { return 0 }
  return { k: self.k - 1 }.up()
}
function up(self: N) { return self.down() + 1 }
print({ k: 3 }.up())

// Method-style, backward: `upB` is declared before `downB`.
function upB(self: N) { return self.downB() + 1 }
function downB(self: N) {
  if self.k <= 0 { return 0 }
  return { k: self.k - 1 }.upB()
}
print({ k: 3 }.upB())

// The plain call, forward.
function downP(self: N) {
  if self.k <= 0 { return 0 }
  return upP({ k: self.k - 1 })
}
function upP(self: N) { return downP(self) + 1 }
print(upP({ k: 3 }))
