// An empty list's element type is the one its uses fix (DECISIONS.md "No default type"): a read
// delivered to a typed destination is such a use, wherever the list sits.
const r = { xs: [] }
if r.xs.length > 0 { const s: string = r.xs[0]; print(s) }
print(r.xs.length)
function joined(c: boolean) { return if c { [] } else { null } }
const a = joined(true)
if a != null && a.length > 0 { const s: string = a[0]; print(s) }
if a != null { print(a.length) }
const c = true
const b = if c { [] } else { null }
if b != null && b.length > 0 { const s: string = b[0]; print(s) }
if b != null { print(b.length) }
function mk(k: boolean) { return if k { [] } else { "s" } }
const u = mk(true)
if u is string { print(u) }
else if u.length > 0 { const s: string = u[0]; print(s) }
else { print(0) }
const q = { ys: [] }
let t = "a"
if q.ys.length > 0 { t = q.ys[0] }
print(t)
const w = { zs: [] }
if w.zs.length > 0 { const s: string = w.zs[0]; print(s) }
w.zs.push("q")
print(w.zs[0])
// @log 0
// @log 0
// @log 0
// @log 0
// @log a
// @log q
