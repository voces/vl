// @run
// @log 10
// @log 0
// @log 10
// @log 0
// @log 10
// @log 10
// @log 10
// @log 0
// @log 7
// The `is` COMPLEMENT over an UN-ANNOTATED parameter. The HIT arm narrows at both
// faces — it binds the tested arm directly — while the ELSE arm needs `U − T`, and a
// hole has no member list to subtract from: `subtractTy` answered -1 and the else arm
// read `a` at the full pinned union, so `a * 2` refused a program whose ANNOTATED twin
// runs. The remainder is now DEFERRED to the pin (`HD_GNOT`), which is the first place
// a member list exists. D1243.
//
// THE LITERAL ARM rides the same remainder, and the emitter reads the pin rather than the
// registry to serve it: `i32 | "err"` REGISTERS as `i32|string`, so the emitter's literal
// complement had no `"err"` member to subtract and the else arm read the raw box. D1412.
function orNul(bad: boolean): i32 | null {
  if bad { return null }
  return 5
}

function orErr(bad: boolean): i32 | "err" {
  if bad { return "err" }
  return 5
}

function orStr(bad: boolean): i32 | string {
  if bad { return "e" }
  return 5
}

// The `is null` face — `nonNullTy` peels a `TyNullable`, and a hole is not one.
function takeNul(a) {
  if a is null { print(0) } else { print(a * 2) }
}

// The typed face, through `subtractTy`.
function takeStr(a) {
  if a is string { print(0) } else { print(a * 2) }
}

// An EARLY-RETURN guard is the same complement one statement out.
function guardNul(a) {
  if a is null { return }
  print(a * 2)
}

// …and so is the negated condition.
function notStr(a) {
  if !(a is string) { print(a * 2) } else { print(0) }
}

// The LITERAL face (D1412). `"err"` survives in the ARENA and nowhere else — the union
// registry softened it to `string` — so the complement is answered from the CALL's pin.
function takeErr(a) {
  if a is "err" { print(0) } else { print(a * 2) }
}

// THE SOUNDNESS CONTROL for the arm above: a pin of `i32 | string` is NOT reduced by
// testing one literal, so the else arm keeps the whole union and `a * 2` would refuse
// there. Reading `a` only through the guard is what makes the cell legal, and it is the
// cell that fails the moment the literal complement starts firing on a base-typed member.
function takeWide(a) {
  if a is "err" { print(0) } else { print(7) }
}

takeNul(orNul(false))
takeNul(orNul(true))
takeStr(orStr(false))
takeStr(orStr(true))
guardNul(orNul(false))
notStr(orStr(false))
takeErr(orErr(false))
takeErr(orErr(true))
takeWide(orStr(false))
