// @run
// @log 10
// @log 0
// @log 10
// @log 0
// @log 10
// @log 10
// The `is` COMPLEMENT over an UN-ANNOTATED parameter. The HIT arm narrows at both
// faces — it binds the tested arm directly — while the ELSE arm needs `U − T`, and a
// hole has no member list to subtract from: `subtractTy` answered -1 and the else arm
// read `a` at the full pinned union, so `a * 2` refused a program whose ANNOTATED twin
// runs. The remainder is now DEFERRED to the pin (`HD_GNOT`), which is the first place
// a member list exists. D1243.
function orNul(bad: boolean): i32 | null {
  if bad { return null }
  return 5
}

function orStr(bad: boolean): i32 | string {
  if bad { return "e" }
  return 5
}

// The `is null` face — `nonNullTy` peels a `TyNullable`, and a hole is not one.
function takeNul(a) {
  if a is null { print(0) } else { print(a * 2) }
}

// The typed face, through `subtractTy`.
function takeStr(a) {
  if a is string { print(0) } else { print(a * 2) }
}

// An EARLY-RETURN guard is the same complement one statement out.
function guardNul(a) {
  if a is null { return }
  print(a * 2)
}

// …and so is the negated condition.
function notStr(a) {
  if !(a is string) { print(a * 2) } else { print(0) }
}

takeNul(orNul(false))
takeNul(orNul(true))
takeStr(orStr(false))
takeStr(orStr(true))
guardNul(orNul(false))
notStr(orStr(false))
