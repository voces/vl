// @check
// @error cannot assign string to 'b' of type f64
// Two loops read one empty map's keys as two types: the first fixes them, and the second is
// refused at check (DECISIONS.md "No default type").
const m = Map()
for k in m.keys() { const a: string = k; print(a) }
for k in m.keys() { const b: f64 = k; print(b) }
print(m.length)
