// A read-only empty list is the type its typed reads fix (DECISIONS.md "No default type", D16993):
// an element read into an annotated `let`, a loop whose variable is read so, and the same through
// an alias.
const xs = []
if xs.length > 0 { const s: string = xs[0]; print(s) }
print(xs.length)
const ys = []
for y in ys { const s: string = y; print(s) }
print(ys.length)
const zs = []
const w = zs
for z in w { const f: f64 = z; print(f) }
print(w.length)
// @log 0
// @log 0
// @log 0
