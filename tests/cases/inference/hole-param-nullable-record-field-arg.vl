// @run
// @log 0
// @log 7
// @log 0
// @log 0
// @log 0
// @log 0
// @log 5
// @log 0
// @log nil
// @log -1
// @hint Intentionally-unused parameter `_q` (leading `_` marks it unused)
// A nullable record field read passed straight to an un-annotated or generic parameter
// reaches the callee as `O | null`, so the callee's own test decides: a field, a nested field,
// a call's field and a binding of one, at module and function scope (D3301).
type O = { n: i32 }
type R = { v: O | null }
type S = { r: R }
function u(q) {
  if q != null { return q.n }
  return 0
}
function seven(_q) { return 7 }
function g<T>(q: T) {
  if q != null { return 1 }
  return 0
}
function back(q) { return q }
function orElse(q) {
  const d: O = { n: -1 }
  const z = q ?? d
  return z.n
}
function mkR(): R { return { v: null } }
const r: R = { v: null }
print(u(r.v))
print(seven(r.v))
const s: S = { r: { v: null } }
print(u(s.r.v))
print(u(mkR().v))
print(g(r.v))
function main(z: R) {
  const b = z.v
  print(u(b))
  const full: R = { v: { n: 5 } }
  print(u(full.v))
  print(u(z.v))
  const y = back(z.v)
  if y != null { print(y.n) } else { print("nil") }
  print(orElse(z.v))
}
main(r)
