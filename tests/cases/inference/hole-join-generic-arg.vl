// @run
// @log q
// @log a
// @log 6
// @log s
// @log 42
// The must-not-error twin of `soundness/hole-join-generic-arg-reject.vl`. A
// deferred join reaching a concrete parameter from inside another generic body
// records a deferred argument constraint — but the constraint must only fire when
// the pinned arms actually disagree with the sink. These spellings all agree, so
// they keep type-checking and running.
function pick(a, b, c) {
  if c then return a
  return b
}
function printString(thing: string) { print(thing) }
function printI32(thing: i32) { print(thing) }

// One hole arm pinned to a MATCHING type.
function goOne(x) { printString(pick(x, "s", true)) }
goOne("q")

// Both arms holes, both pinned to the sink's type.
function goTwo(x, y) { printString(pick(x, y, true)) }
goTwo("a", "b")

// The same join against an i32 sink.
function goI32(x) { printI32(pick(x, 5, true)) }
goI32(6)

// The join taken through a RETURN of the enclosing generic, then sunk.
function relay(x) { return pick(x, "s", true) }
printString(relay("s"))

// A GUARD join relayed through a second generic body. Neither arm can resolve where
// `foobar` is called (`w` is itself a hole), so the join is UNDECIDABLE there — it
// must collapse rather than escape as this call's type. Escaping made the emitter
// classify `relay2`'s return as a union box while the monomorphized body returned
// the plain arm, breaking a program that lowers fine (`expected (ref $type), found
// i32`) — the deferred join is a checker placeholder with no runtime shape.
function foobar(v) {
  if v is { foo: string } then return v.foo
  return v.bar
}
function relay2(w) { return foobar(w) }
print(relay2({ bar: 42 }))
