// @run
// @log 0
// @log 3
// @log 0
// @log 0
// @log 1
// @log 0.75
// @log 4.5
// @log 0
// @log z
// @log 9
// @info `none` is never reassigned; use `const` instead of `let`
// AN UN-ANNOTATED `const none = []` DELIVERED TO AN INFERRED RETURN, WHOSE ELEMENT TYPE THE
// SIBLING ARM SUPPLIES (D1591, `~/glean` VL-041).
//
// `inferred` and `named` differ only in whether the empty list has a NAME. The bare `[]` in
// tail position was pinned by `constrainEmptyExpr` at the ANNOTATED-return site; under an
// inferred return the destination is the join of every return, which is not final when the
// delivery is checked — so `named`'s binding reached the scope-close floor and the consumer's
// ordinary "no data for this key" lookup did not compile.
//
// The pin is DEFERRED, not moved: each delivery to an inferred return is banked
// (`noteInferRetWitness`) and pinned once the body's witnesses are all in
// (`flushInferRetHoles`). That is what makes `early` work — its `return none` is written
// BEFORE the arm that names the type, so at the delivery there is nothing to pin against.

// The consumer's witness, verbatim.
function inferred(r: i32) {
  if r == 6 { return [1, 2, 4] }
  []
}
function named(r: i32) {
  if r == 6 { return [1, 2, 4] }
  const none = []
  none
}
print(named(7).length)
print(named(6).length)
print(inferred(7).length)

// The `let` spelling of the same binding.
function letSpelling(r: i32) {
  if r == 6 { return [1, 2, 4] }
  let none = []
  none
}
print(letSpelling(7).length)

// A NON-i32 element, pushed AFTER the delivery and read back through arithmetic — the pair
// that fails if the checker's pin never reached the emitter's hole seed, since an unpinned
// hole lowers as the i32-list default whatever the checker decided.
function measured(r: i32) {
  if r == 6 { return [1.5, 2.5, 4.0] }
  const none = []
  none
}
const v = measured(7)
v.push(0.5)
print(v.length)
print(v[0] + 0.25)
print(measured(6)[2] + 0.5)

// The RETURN written BEFORE the arm that supplies the type.
function early(r: i32) {
  const none = []
  if r == 7 { return none }
  [1, 2, 4]
}
print(early(7).length)

// A tail `if`/`else` whose sibling ARM is the concrete one.
function armed(r: i32) {
  const none = []
  if r == 6 { ["a", "b"] } else { none }
}
const p = armed(7)
p.push("z")
print(p[0])

// A `??` DEFAULT: the one delivery whose typed destination sits on the LEFT of the operator.
function maybe(r: i32): i32[] | null {
  if r == 6 { return [1, 2, 4] }
  null
}
const fallback = []
const got = maybe(7) ?? fallback
got.push(9)
print(got[0])
