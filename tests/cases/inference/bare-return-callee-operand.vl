// @error operator '+' is not defined for void and i32
// @error cannot infer a return type for 'a'
// CONTRACT (must-error): the second delivery position of D7760 — the void read through a
// forward tail call is an operand, and the refusal names the operator, as it does when the
// bare-`return` function is declared first.
function a(n: i32) { b(n) + 1 }
function b(n: i32) { g(n) }
function g(n: i32) {
  if n > 5 { return }
  print(n)
}
print(a(1))
