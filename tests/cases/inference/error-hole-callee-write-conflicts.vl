// @check
// @error push: cannot add i32 to string[]
// @error the callee's body writes string into the list passed here, whose element is f64
// @error the callee's body writes f64 into the list passed here, whose element is i32
// A hole callee's write into a list binding is checked against the element the list ends up
// with, wherever that element came from (D3775): a later caller write the callee's element
// cannot hold, a second callee's write, and a typed parameter the list is passed to. Each was
// check-clean invalid wasm inside the callee's instance.
function word(a) { a.push("s") }
const h = []
word(h)
h.push(2)

function frac(a) { a.push(1.5) }
const g = []
frac(g)
word(g)
print(g.length)

function count(xs: i32[]): i32 { xs.length }
const f = []
frac(f)
print(count(f))
