// @run
// @log 1
// @log p
// @log 1.5
// @log 5000000000
// @log 7
// @log 2
// @log w
// @log true
// @log s
// @log 4
// @log p
// @log p
// @log 1.5
// @log 1.5
// @log 2

// D2218: an empty `[]` handed to an un-annotated parameter takes the element the callee's body
// gives it. D1471: an element store through the parameter pins it the same way. Each element
// kind is printed back, so an argument built at another list rep prints a different answer.
type P = { x: i32, ys: f64[] }

function pushStr(a) {
  a.push("p")
  print(a.length)
  print(a[0])
}
function pushF64(a) {
  a.push(1.5)
  print(a[0])
}
function pushI64(a) {
  a.push(5000000000)
  print(a[0])
}
function pushRec(a) {
  a.push({ x: 7 })
  print(a[0].x)
}
function pushList(a) {
  a.push([1, 2])
  print(a[0][1])
}
function pushUnion(a) {
  const u: i32 | string = "w"
  a.push(u)
  print(a[0])
}
function pushBool(a) {
  a.push(true)
  print(a[0])
}
function pushNullThenStr(a) {
  a.push(null)
  a.push("s")
  print(a[1] ?? "-")
}
function aliasDeclared(a) {
  const v = a
  v.push({ x: 4, ys: [] })
  print(v[0].x)
}
function viaValue(a) {
  a.push("p")
  print(a[0])
}
function storeF64(a) {
  const v = a
  v[0] = 1.25
  print(v[0] + 0.25)
}
function twice(a) {
  a.push({ x: 1 })
  a.push({ x: 2 })
  print(a[1].x)
}

pushStr([])
pushF64([])
pushI64([])
pushRec([])
pushList([])
pushUnion([])
pushBool([])
pushNullThenStr([])
aliasDeclared([])
viaValue([])
const g = viaValue
g([])
pushF64([])
storeF64(__array_new_default__(3))
twice([])
