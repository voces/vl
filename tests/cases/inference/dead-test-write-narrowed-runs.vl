// @run
// @log s
// @log s
// @log false
// @log a
// @log a
// @hint redundant type annotation: `f` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @warning Unused parameter `a` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `g` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @warning `is` check type 'i32' can never match a value of type string, so this test is always false here
// @warning match pattern `i32` can never match a value of type string here, so this arm never runs
// @info `u` is never reassigned; use `const` instead of `let`
// @info `v` is never reassigned; use `const` instead of `let`
// @warning cannot compare (i32) => i32 with (string) => i32 here, so this comparison is always false
// @info `k` is never reassigned; use `const` instead of `let`
// A test a write's narrowing made impossible is a dead test, a warning, and lowered over the
// declared type, so it runs (owner ruling 2026-11-12: an impossible test is an error only by
// the declared types).
function f(a: i32): i32 { return a }
function g(a: string): i32 { return 0 }
function isTest() {
  let x: i32 | string = 1
  x = "s"
  if x is i32 { print("i") } else { print("s") }
}
function matchArm() {
  let x: i32 | string = 1
  x = "s"
  match x {
    i32 => print("i")
    string => print("s")
  }
}
function eqTest() {
  let u: ((a: i32) => i32) | ((a: string) => i32) = f
  let v: ((a: i32) => i32) | ((a: string) => i32) = g
  print(u === v)
}
function litEq() {
  let k: "a" | "b" = "a"
  if k == "b" { print("b") } else { print("a") }
}
function litArm() {
  let k: "a" | "b" = "a"
  match k {
    "a" => print("a")
    "b" => print("b")
  }
}
isTest()
matchArm()
eqTest()
litEq()
litArm()
