// @run
// @log 1.5
// @log 1.25
// @log 1.5
// @log 4
// @log 1
// @log x
// @log 2.5
// @log 1.5
// @log 7
// @log 2
// @log 1
// @log 2
// @log 2
// @info `b` is never reassigned; use `const` instead of `let`
// @info `c1` is never reassigned; use `const` instead of `let`

// A list binding a hole callee writes, with no later write of its own, takes the element that
// write gives it when its scope closes, not the intrinsic's `i32` default. The binding stays
// open at the call because its own later writes may still widen it (D2218). D3746.
function take(a) {
  a.push(1.5)
  print(a[3])
}
const h = __array_new_default__(3)
take(h)

function store(a) {
  a[0] = 1.25
  print(a[0])
}
const s = __array_new_default__(3)
store(s)

function main() {
  const m = __array_new_default__(3)
  take(m)
  print(m.length)
}
main()

// An empty `[]` binding no write of its own pins reads the same element.
function fill(a) { a.push(1.5) }
const e = []
fill(e)
print(e.length)

function addS(a) { a.push("x") }
function strs() {
  const t = []
  addS(t)
  print(t[0])
}
strs()

// Through a hole link.
function put(a) { a.push(2.5) }
const k = __array_new_default__(2)
let b = k
put(b)
print(k[2])

// …and through a chain of them, the write landing on the chain's last row.
function chainTake(a) {
  const v = a
  v[0] = 1.25
  print(v[0] + 0.25)
}
let c1 = __array_new_default__(3)
let c2 = __array_new_default__(3)
let c3 = __array_new_default__(3)
c2 = c1
c3 = c2
chainTake(c3)

// A literal-union write stores at its base primitive, whose zero the intrinsic writes: these
// ran on master through the `i32` default and must keep running.
type D = 0 | 1 | 2
function takeD(a, d: D) { a.push(d) }
const hd = __array_new_default__(3)
takeD(hd, 2)
print(hd[0] + 7)
print(hd[3])

function takeBit(a, d: 0 | 1) { a.push(d) }
const hb = __array_new_default__(2)
takeBit(hb, 1)
print(hb[2])

function storeD(a, d: D) { a[0] = d }
const hs = __array_new_default__(2)
storeD(hs, 2)
print(hs[0] + hs[1])

const ds: D[] = [1, 2]
const hr = __array_new_default__(2)
takeD(hr, ds[1])
print(hr[2])
