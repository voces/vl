// @run
// @log 1
// @log 4
// @log 5
type N = string | null
type U = i32 | N
type N4 = i32[] | null
type U4 = i64 | N4

function gp(x: i32 | (string | null), c: boolean) {
  if c { return x } else { return x }
}

function ga(x: U, c: boolean) {
  if c { return x } else { return x }
}

function g4(x: U4, c: boolean) {
  if c { return x } else { return x }
}

const a = gp(7, true)
if a is i32 { print(1) } else { print(101) }
const b = ga(7, true)
if b is i32 { print(4) } else { print(104) }
const c = g4(7, true)
if c is i64 { print(5) } else { print(105) }
