// @run
// @log 5
// @log s!
// @log 5
// @log s
// @log 5
// @log 3
// @log 5
// @log s!
// @log 5
// @log yy
// @log 9
// D16006(b): a demand the else arm of `p is T` makes over an un-annotated parameter is vacuous
// at a pin whose every member is T, since that arm is dead there; it is checked at the pins
// where the arm is live. Covers an operator, an argument, a return, a forwarding caller, a
// field read, and a single pin that never reaches the else arm.
type R = { y: string }
function needStr(s: string) { print(s) }
function bin(p) {
  if p is i32 { print(p + 1) } else { print(p + "!") }
}
function arg(p) {
  if p is i32 { print(p + 1) } else { needStr(p) }
}
function ret(p) {
  if p is i32 { return p + 1 } else { return p.length }
}
function outer(q) { bin(q) }
function mem(p) {
  if p is i32 { print(p + 1) } else { print(p.y) }
}
function onePin(p) {
  if p is i32 { print(p + 1) } else { print(p + "!") }
}
bin(4)
bin("s")
arg(4)
arg("s")
print(ret(4))
print(ret("abc"))
outer(4)
outer("s")
mem(4)
const r: R = { y: "yy" }
mem(r)
onePin(8)
