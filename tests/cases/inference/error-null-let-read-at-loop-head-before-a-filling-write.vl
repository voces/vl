// @error cannot assign i32 | null to string | null: this `let` starts as `null`, and a later write makes its type i32 | null
// A read of a `let x = null` at a loop head, before a write in the body fills it, joins the
// back-edge: its most recent write may be the fill, so it is judged at the filled type and
// refused where the destination cannot take it (D2660; the straight-line read runs).
function main() {
  let x = null
  let i = 0
  while i < 2 {
    const y: string | null = x
    print(y == null)
    x = 5
    i = i + 1
  }
}
main()
