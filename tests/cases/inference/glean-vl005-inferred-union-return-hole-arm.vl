// @run
// @log too big
// @log 2
// @log 1
// @log 1.5
// @log ab
// AN INFERRED UNION RETURN WHOSE SCALAR ARM COMES FROM AN UN-ANNOTATED PARAMETER
// (D1521, `~/glean` VL-005).
//
// `tryParse2` is the consumer's body unchanged. Its returns are `{msg: string}` and `y`,
// and `y` derives from the hole `x` — so `a20RetSetDisagrees` saw only ONE concrete arm,
// the A20 recorder called the declaration generic and banked no row, and one pass later
// `monoRetJoinDisagrees` declined the instance's mint for the same reason. The functype
// then took the STRUCT's own ref while the scalar arm returned raw: `vl check` rc 0 and a
// module the engine refuses.
//
// THE ANSWER IS PER-INSTANCE, WHICH IS WHY IT IS MINTED AT THE PIN. `twoWays` is called at
// i32 and at f64 in one program; a name-keyed row could hold only one of those, and the two
// instances here must print `1` and `1.5`. `pickS` is the value-union spelling (a string arm
// beside the hole's) — a fix taught only the struct case would leave it invalid.
//
// The MINIMAL spelling is `tryParse2`'s: with no other declaration of `Err | i32` in the
// module the same defect wore a clause-2 face (an emit reject naming an `is` test with no
// union type declared), which is the face the consumer filed — and why their reported
// message and the one master produced for their own program differ.
type Err = { msg: string }

function tryParse2(x) {
  const y = x * 2
  if y > 10 { return { msg: "too big" } }
  y
}

function twoWays(n) {
  if n > 10 { return { msg: "big" } }
  n
}

function pickS(s) {
  if s.length > 4 { return { msg: "long" } }
  s
}

const r3 = tryParse2(9)
if r3 is Err { print(r3.msg) } else { print(r3) }
const r1 = tryParse2(1)
if r1 is Err { print(r1.msg) } else { print(r1) }

const ri = twoWays(1)
if ri is Err { print(ri.msg) } else { print(ri) }
const rf = twoWays(1.5)
if rf is Err { print(rf.msg) } else { print(rf) }

const rs = pickS("ab")
if rs is Err { print(rs.msg) } else { print(rs) }
