// @run
// @log 42
// @log foo
// @log 7
// @log two
// @log y
// The must-not-error twin of `soundness/hole-is-guard-return-join-reject.vl`. A
// return joined across an `is` guard over an un-annotated param is a DEFERRED
// join, not a real union: at each call site exactly one arm is live, and the
// re-fold under the pinned argument collapses the join back to that arm's type.
// So the legitimate spellings below still lower and print — only a flow into an
// INCOMPATIBLE annotated parameter is rejected.
function foobar(v) {
  if v is { foo: string } then return v.foo
  return v.bar
}
print(foobar({ bar: 42 })) // complement path — i32, NOT the guard arm's `string`
print(foobar({ foo: "foo" })) // guard path — `string`, the complement is dead

// The joined arm still flows into a MATCHING annotated parameter.
function printI32(thing: i32) { print(thing) }
printI32(foobar({ bar: 7 }))

// `else`-arm spelling: each arm resolves per call site the same way.
function either(v) {
  if v is { left: i32 } then return v.left
  else return v.right
}
print(either({ right: "two" }))

// An argument satisfying BOTH the guard and the complement keeps its existing
// behavior (the guard is not decided statically for a wider shape).
function pick(v) {
  if v is { a: string } then return v.a
  return v.b
}
print(pick({ a: "x", b: "y" }))
