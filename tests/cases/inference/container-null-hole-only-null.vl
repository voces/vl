// @error the element type of `xs` is only ever null — annotate it
// CONTRACT (must-error): a list whose only write is a bare `null` never says what else it
// holds, so its element is `T | null` with `T` never filled. Every spelling gives this one
// sentence (D2506): `.push(null)`, `m.set(k, null)` and `m[k] = null` alike.
const xs = []
xs.push(null)
print(xs.length)
