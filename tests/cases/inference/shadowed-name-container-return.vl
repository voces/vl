// @run
// @log 4
// @log 8
// @log 8
// @hint redundant type annotation: `count` is inferred as `i32` — remove it to lean on inference
// A returned map, record or function value is typed by the binding in scope at the return,
// not by a same-named one of another type in a block the return is outside (D3295).
function pick(c: boolean) {
  if c {
    const s: Map<string, string> = Map()
    s.set("a", "zz")
    print(s.get("a") ?? "")
  }
  const s: Map<string, i32> = Map()
  s.set("a", 4)
  return s
}
const m = pick(false)
print(m.get("a") ?? 0)
type P = { x: i32, y: i32 }
type Q = { a: string }
function point(c: boolean, n: i32) {
  if c {
    const s: Q = { a: "hi" }
    print(s.a)
  }
  const s: P = { x: n, y: 2 }
  return s
}
const r = point(false, 8)
print(r.x)
function count(c: boolean, n: i32): i32 {
  if c {
    const s = (k: i32) => k > n
    print(s(2))
  }
  const s = n + 1
  return s
}
const k = count(false, 7)
print(k)
