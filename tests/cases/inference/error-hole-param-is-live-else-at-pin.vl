// @check
// @error operator '*' is not defined for string and i32 (the call's argument types)
// D16006(b): the else arm of `p is T` over an un-annotated parameter is still checked at a pin
// where it is live; only a pin whose every member is T leaves it unchecked.
function take(p) {
  if p is i32 { print(p + 1) } else { print(p * 2) }
}
take(4)
take("s")
