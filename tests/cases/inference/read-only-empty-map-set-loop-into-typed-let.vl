// A read-only empty map or set looped into a typed `let` keeps its loop variables (D16995): it
// takes its declaration default, which the reads agree with.
const m = Map()
for k, v in m { const a: i32 = k; const b: i32 = v; print(a + b) }
print(m.length)
const s = Set()
for x in s { const c: i32 = x; print(c) }
print(s.length)
// @log 0
// @log 0
// @hint redundant type annotation: `a` is inferred as `i32`
// @hint redundant type annotation: `b` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `i32`
