// @run
// @log a
// @log b
// @log 1
// @log a
// @hint redundant type annotation: `r` is inferred as `"a" | "b"` — remove it to lean on inference
// @hint redundant type annotation: `r2` is inferred as `0 | 1` — remove it to lean on inference
// An un-annotated parameter is SOLVED from the usage that constrains it, so it reps
// exactly as the annotated spelling does.
//
// `u` has no annotation, so it was an inference HOLE and its REP came from whatever the
// call site's argument happened to be. That is not a free choice for a NAMED string
// litunion: `K` is an interned i32 ATOM while a plain `string` is a `(ref $array)`, and a
// bare `"a"` argument widens to `string`. So this file — a completely correct program —
// used to pass `vl check` and then fail to instantiate:
//
//   Invalid input WebAssembly code at offset 220: type mismatch: expected i32, found (ref $type)
//
// `const r: K = u` already decides the parameter: it requires `u` assignable to `K`.
// Pass 1.6 reads that constraint off the body and records `K` as the parameter's type
// (`unannotParamTy` is the one place every producer of an un-annotated parameter's type
// asks), after which the parameter is indistinguishable from `p2`'s annotation below —
// the call site checks the argument against `K` and the emitter reps it as the atom.
//
// The `@hint`s are the consequence, not an accident: inference now knows what the
// annotation states, so the type-informed redundant-annotation stream flags it.
type K = "a" | "b"
type Z = 0 | 1

function p(u) {
  const r: K = u
  print(r)
}
p("a")
p("b")

// The NUMERIC axis, whose base scalar happens to agree with the hole's i32 default —
// correct before and after, and here so a rep change would show up as a diff rather
// than as silence.
function pz(u) {
  const r2: Z = u
  print(r2)
}
pz(1)

// The ANNOTATED twin, the oracle for both directions (see
// `soundness/unannotated-param-solved-nonmember-reject.vl` for the reject half).
function p2(u: K) { print(u) }
p2("a")
