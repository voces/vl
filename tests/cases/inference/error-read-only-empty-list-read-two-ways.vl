// @check
// @error cannot assign string to 'f' of type f64
// Two loops read one empty list's element as two types: the first fixes it, and the second is
// refused at check (DECISIONS.md "No default type").
const xs = []
for x in xs { const s: string = x; print(s) }
for x in xs { const f: f64 = x; print(f) }
print(xs.length)
