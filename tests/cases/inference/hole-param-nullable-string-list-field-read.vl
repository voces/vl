// @run
// @log nil
// @log snil
// @log nil
// @log N
// D10932: an un-annotated parameter's `(string | null)[]` field, read at a `null` element,
// keeps the element nullable rather than asserting it non-null.
function take(a) { print(a.g[1] ?? "nil") }
function both(a) {
  const v = a
  print((v.g[0] ?? "nil") + (v.g[1] ?? "nil"))
}
function deep(a) { print(a.h.g[1] ?? "nil") }
function flag(a) {
  const b = a.g[1]
  if b == null { print("N") } else { print(b) }
}
function mk(x: string): { g: (string | null)[] } { return { g: [x, null] } }

const r: { g: (string | null)[] } = { g: ["s", null] }
take(r)
both(mk("s"))
const d: { h: { g: (string | null)[] } } = { h: { g: ["s", null] } }
deep(d)
const f: { g: (boolean | null)[] } = { g: [true, null] }
flag(f)
