// @run
// @log 8
// @log w
// @log 10
// @hint redundant type annotation: `r` is inferred as `i64` — remove it to lean on inference
// A block binding that shadows a parameter is what a read inside that block denotes: the
// return is typed by the block's binding, not by the parameter it hides (D3293).
function pick(c: boolean, s: boolean, n: i32) {
  if c {
    const s = n
    return s
  }
  if s { 1 } else { 0 }
}
print(pick(true, false, 8))
function word(c: boolean, s: i32, n: i32) {
  if c {
    const s = "w"
    return s
  }
  if s > n { "big" } else { "none" }
}
print(word(true, 1, 2))
function wide(c: boolean, s: string, big: i64) {
  if c {
    const s = big + 1
    return s
  }
  if s == "" { big } else { big + 2 }
}
function viaI64() {
  const r: i64 = wide(true, "x", 9)
  r
}
print(viaI64())
