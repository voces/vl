// @check
// @error argument 1: expected {foo: string} | {bar: _}, got {baz: string}
// @error argument 1: expected A | {y: _}, got A | B | C
// D16007: a negated `is` guard's alternative is held to the same argument check as the positive
// guard's: an argument neither the guard's type nor the other arm's reads fit, or a union member
// that fits neither (`C`, with no `y`), is refused at the argument.
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: string }
type C = { kind: "c", z: f64 }
function mkABC(): A | B | C { return { kind: "c", z: 2.5 } }
function foobar(v) {
  if !(v is { foo: string }) { return v.bar }
  return v.foo
}
print(foobar({ baz: "baz" }))
function both(p) {
  if !(p is A) { print(p.y) } else { print(p.x) }
}
both(mkABC())
