// A read-only empty map or set is the type its typed reads fix (DECISIONS.md "No default type",
// D16994): a key loop, a value loop, both loop variables through an alias, and `get(k) ?? d`.
const m = Map()
for k in m.keys() { const z: string = k; print(z) }
print(m.length)
const n = Map()
const v: string = n["a"] ?? "d"
print(v)
const p = Map()
for x in p.values() { const s: string = x; print(s) }
print(p.length)
const q = Map()
const w = q
for k, x in w { const a: string = k; const b: f64 = x; print(a); print(b) }
const g = q.get("x") ?? 1.5
print(g)
const s = Set()
for e in s { const c: string = e; print(c) }
print(s.length)
// @log 0
// @log d
// @log 0
// @log 1.5
// @log 0
