// @check
// @error argument 1: expected A | {y: _}, got A | B | C
// D16004: a union argument meets an un-annotated parameter's demand member by member, each on
// its own path, so a member neither the `is` guard takes nor the else arm's field read fits (`C`,
// with no `y`) is refused at the argument.
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: string }
type C = { kind: "c", z: f64 }
function mkABC(): A | B | C { return { kind: "c", z: 2.5 } }
function field(p) {
  if p is A { print(p.x) } else { print(p.y) }
}
field(mkABC())
