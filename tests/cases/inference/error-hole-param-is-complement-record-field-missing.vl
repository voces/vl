// @check
// @error field 'y' is not on every member of B | C — narrow with `is` first (no 'y' on C)
// D16004: the else arm of `if p is A` over an un-annotated parameter reads the members the test
// leaves at the pin, so a field one of them lacks is refused there, in the words the parameter
// annotated `A | B | C` is refused in.
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: string }
type C = { kind: "c", z: f64 }
function mkABC(): A | B | C { return { kind: "c", z: 2.5 } }
function field(p) {
  if p is A { print(p.x) } else { print(p.y) }
}
field(mkABC())
