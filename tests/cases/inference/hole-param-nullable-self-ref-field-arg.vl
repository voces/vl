// @run
// @log 2
// @log 0
// @log 2
// @log 1
// @log 2
// @log 2
// @log 3
// @log 0
// A nullable field of a self-referencing record, passed to an un-annotated or generic
// parameter, pins the instance at the field's own `O | null`: a record holding a list of
// itself, a linked list walked by recursion through `q.next`, and a mutual pair (D3301).
type T1 = { n: i32, kids: T1[] }
type R1 = { v: T1 | null }
function f(q) {
  if q == null { return 0 }
  return q.n
}
function fg<X>(q: X) {
  if q == null { return 0 }
  return 2
}
const r1: R1 = { v: { n: 2, kids: [] } }
print(f(r1.v))
const r0: R1 = { v: null }
print(f(r0.v))
print(fg(r1.v))
type L = { n: i32, next: L | null }
function depth(q) {
  if q == null { return 0 }
  return 1 + depth(q.next)
}
const o: L = { n: 1, next: { n: 2, next: null } }
print(depth(o.next))
print(depth(o))
const on: L | null = o
print(depth(on))
type M = { n: i32, p: N | null }
type N = { o: M | null }
function mn(q) {
  if q == null { return 0 }
  return q.n
}
const nn: N = { o: { n: 3, p: null } }
print(mn(nn.o))
const n0: N = { o: null }
print(mn(n0.o))
