// @run
// @log a
// @log b
// @log a
// @log a
// @log a
// @hint redundant type annotation: `s` is inferred as `{f: "a" | "b"}` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `"a" | "b"[]` — remove it to lean on inference
// @hint redundant type annotation: `r` is inferred as `"a" | "b"` — remove it to lean on inference
// @hint Intentionally-unused parameter `_z` (leading `_` marks it unused)
// @hint redundant type annotation: `rn` is inferred as `"a" | "b"` — remove it to lean on inference
// The two REACHES of the un-annotated-parameter solve that a scalar `const r: K = u` in a
// top-level `function` does not cover, and both were invalid wasm.
//
// COMPOSITE DESTINATIONS. `{f: u}`, `[u]` and a `K`-valued map store all arrive at
// `assignableExpr` with a COMPOSITE source, which `assignable` accepts whole — a hole in
// any position is assignable to anything — so the plain short-circuit fires and the
// per-position flow was never asked. `noteHoleFlow` walks source and destination in
// parallel and records the hole at the position that actually constrains it.
//
// NON-HOISTED DECLARATIONS. A nested `function` and a value-bound arrow `const` have no
// pass-1 hoist, so the top-level pre-pass never saw them; `checkFuncDeclNode` is their
// first observer and attempts the solve there.
//
// Every parameter below reps as the interned i32 ATOM its destination demands, and each
// nested function is given a DISTINCT name — capture analysis is name-keyed module-wide.
type K = "a" | "b"
type SS = { f: K }

function pf(u) {
  const s: SS = { f: u }
  print(s.f)
}
pf("a")

function pe(u) {
  const a: K[] = [u]
  print(a[0])
}
pe("b")

function pm(u) {
  const m: { [string]: K } = Map()
  m["k"] = u
  const g = m["k"]
  if g != null { print(g) }
}
pm("a")

const parrow = (u) => {
  const r: K = u
  print(r)
}
parrow("a")

function outer(_z: i32) {
  function pinner(v) {
    const rn: K = v
    print(rn)
  }
  pinner("a")
}
outer(1)
