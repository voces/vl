// @run
// @log ns
// @log 1.5
// THE CONTROL for `soundness/xfail-miscompile-newtype-string-inferred-return.vl`: the two
// newtype-return shapes that DO work, pinned so the boundary of that hole stays visible.
//
//   * an ANNOTATED newtype-over-string return — the annotated path erases the brand correctly;
//   * an UN-ANNOTATED newtype-over-f64 return — the inferred path is fine for a non-ref base.
//
// Only the un-annotated STRING case miscompiles, and it is the pair above that says so. Without
// them the xfail reads as "newtype returns are broken", which is not true and would send whoever
// fixes it to the wrong layer.
type NS = new string
type NF = new f64

function fs(x: NS): NS {
  const y = x
  return y
}

function ff(x: NF) {
  const y = x
  return y
}

print(fs("ns"))
print(ff(1.5))
