// @run
// @warning the element type of 'none' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'm' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @log 0
// @log 0
// D1591's negative control: reading `.length` fixes no element type, so no value of one ever
// exists and the binding runs at the unbound default; the warning names the binding.
const none = []
print(none.length)
const m = Map()
print(m.keys().length)
