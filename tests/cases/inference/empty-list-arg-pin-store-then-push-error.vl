// @error push: cannot add i32 to string[]
// CONTRACT (must-error): a callee's deferred element store and push pin an empty `[]` argument
// in source order, as the direct spelling does, so the store decides `string` and the later
// push is the use refused (D2218).
function take(a) {
  a[0] = "x"
  a.push(5)
}
take([])
