// @run
// @log true
// @log 5
// @log 2
// @log -1
// @log 5
// @log 7
// @log -1
// @log true
// @log 3
// @log true
// @log 5
// A read of a `let x = null` before the write that fills it takes that most recent write's type,
// `null`, so it is delivered as `null` where the filled type would not fit (DECISIONS.md, "A
// read of a `let` takes its most recent write's type"). A loop head read joins the back-edge and
// an `if` join meets its arms. A bound copy, and a container, still follow the fill.
function link2<T>(xs: T[], v: T) { xs.push(v) }
function straight() {
  let x = null
  const y: string | null = x
  x = 5
  print(y == null)
  print(x ?? 0)
}
function generic() {
  const xs: (string | null)[] = []
  let x = null
  link2(xs, x)
  x = 5
  xs.push("s")
  print(xs.length)
}
function loopHead() {
  let x = null
  let i = 0
  while i < 2 {
    const y = x
    print(y ?? -1)
    x = 5
    i = i + 1
  }
}
function ifJoin(c: boolean) {
  let x = null
  if c { x = 7 }
  const y = x
  print(y ?? -1)
}
function boundCopy() {
  let x = null
  const v = x
  print(v == null)
  x = 3
  print(x ?? 0)
}
function container() {
  let x = null
  const m = Map()
  m["k"] = x
  x = 5
  print(m["k"] == null)
  print(x ?? 0)
}
straight()
generic()
loopHead()
ifJoin(true)
ifJoin(false)
boundCopy()
container()
