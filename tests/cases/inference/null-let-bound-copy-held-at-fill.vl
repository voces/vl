// @run
// @info `v` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused variable `_v` (leading `_` marks it unused)
// A name copy of a `let x = null` hole that a later write fills is held at the fill, `let` or
// `const`, read or not; the copy's own reads still see the `null` it was bound to.
function letCopy() {
  let x = null
  let v = x
  print(v == null)
  x = 3
  print(x ?? 0)
}
function unread() {
  let x = null
  const _v = x
  x = 4
  print(x ?? 0)
}
letCopy()
unread()
// @log true
// @log 3
// @log 4
