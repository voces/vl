// @run
// @log 5
// @log five
// @log 8
// @log 8
// A module global read inside a function denotes the global even where a block of that
// function, one the read is outside, binds the same name at another type (D3294).
const s = 5
function pick(c: boolean) {
  if c {
    const s = true
    print(s)
  }
  return s
}
print(pick(false))
const g = "five"
function name(c: boolean) {
  if c {
    const g = 1
    print(g)
  }
  g
}
print(name(false))
let m = 3
function bump(c: boolean, n: i32) {
  if c {
    const m: i32 | null = null
    print(m ?? 0)
  }
  m = n + 1
  m
}
print(bump(false, 7))
print(m)
