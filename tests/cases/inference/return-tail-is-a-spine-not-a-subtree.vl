// @run
// @log 1
// @log 0
// @log 7
// @log hi
// @log 3
// @log 55
// D1580 — the return tail is a SPINE. `retTailPos` follows only the nodes whose OWN
// value is the function's return (a block's last statement, an if-expression's arms, a
// `return`'s argument, a paren); a node that merely CONTAINS the expression must clear
// it. Without that clear, an if-expression written as an object literal's FIELD VALUE
// had both its arms unioned into the enclosing function's inferred return, so
// `function a(x: boolean) { { i: if x { 1 } else { 0 } } }` inferred `i32 | {i: i32}`
// and the error landed on the CALLER — `field 'i' is not on every member of
// i32 | {i: i32}` — naming a union the author never wrote. Reported by glean (VL-034),
// which hit eleven of these at once and worked around them with a `const`.
//
// The last two logs are the CONTROL the clear must not break: a genuine tail
// if-expression still seeds the inferred return from its then-branch BEFORE the else
// is checked, which is what lets a recursive `fib` resolve against its base case.
function field(x: boolean) { { i: if x { 1 } else { 0 } } }
print(field(true).i)
print(field(false).i)

function elem(x: boolean) { [if x { 7 } else { 9 }] }
print(elem(true)[0])

function returned(x: boolean) { return { s: if x { "hi" } else { "no" } } }
print(returned(true).s)

function nested(x: boolean) { { outer: { inner: if x { 3 } else { 4 } } } }
print(nested(true).outer.inner)

function fib(n: i32) { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
print(fib(10))
