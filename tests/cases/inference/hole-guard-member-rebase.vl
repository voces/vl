// @run
// @log RF
// @log RB
// A GUARDED return member re-based through a RELAY body — the single hairiest
// operation the derived-hole path language had.
//
// `gpick`'s guarded return carries two things beside the hole it guards: the type
// the branch contributes, and the type the guard tested. When `relay` calls
// `gpick`, the member has to re-base onto `relay`'s own hole and STAY a guard, so
// that `relay`'s call sites can still decide which branch their argument reaches.
//
// In the string encoding that re-base was performed by cutting the two indices
// back out of the very name being decoded (`"?galt." + restG.slice(0, g2 + 1)`)
// and gluing them onto the outer hole's name. They are columns on the derivation
// row now, and re-basing is a copy of the row with a new base. Same answers:
// the guard arm for `{foo}`, the fall-through field read for `{bar}`.
//
// Runs identically on master — the relay spelling was simply not covered.
function ps(t: string) { print(t) }

function gpick(v) {
  if v is { foo: string } then return v.foo
  return v.bar
}

function relay(w) { return gpick(w) }

ps(relay({ foo: "RF" }))
ps(relay({ bar: "RB" }))
