// @run
// @log 0
// @log 1
// @hint redundant type annotation: `a` is inferred as `i32`
// @hint redundant type annotation: `b` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `i32`
// A call whose argument cannot pass its callee's `is i64` test is typed at the other returns
// alone, as the instance returns them, so an `i32` destination takes it (D3109).
type Circle = { r: i32 }
const zs: (Circle | null)[] = [{ r: 4 }, null]
function g(w) {
  if w is i64 { return w }
  return 0
}
const a: i32 = g(true)
const b: i32 = g("x")
const c: i32 = g(zs[0])
print(a + b + c)
let n = g(zs[1])
n = n + 1
print(n)
