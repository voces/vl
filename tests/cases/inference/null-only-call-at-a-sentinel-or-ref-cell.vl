// @run
// @log true
// @log true
// @log true
// @log true
// @log none
// @log none
// A call of a function whose every return is a bare `null` is the null of the cell it lands in: a
// `boolean | null` or `K | null` cell's sentinel and a nullable record's null ref, module or local.
type C = { a: i32 }
type K = "a" | "b"
function np() { return null }
const gb: boolean | null = np()
print(gb == null)
const gk: K | null = np()
print(gk == null)
function f() {
  const lb: boolean | null = np()
  print(lb == null)
  const lk: K | null = np()
  print(lk == null)
  const lc: C | null = np()
  if lc != null { print(lc.a) } else { print("none") }
}
f()
type W = { f: C | null }
const w: W = { f: np() }
if w.f != null { print(w.f.a) } else { print("none") }
