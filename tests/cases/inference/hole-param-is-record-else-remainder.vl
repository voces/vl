// @run
// @log 5
// @log 7
// @log 6
// @log 5
// @log 10
// @log 5
// @log s!
// @log 3
// @log 3
// @log 5
// @log 6
// @log 6
// @log ww
// @log 9
// @log 9
// D16008: the else arm of a record `is` test over an un-annotated parameter reads the pin minus
// the tested record, so a scalar, string or list use of the remainder runs as the annotated
// spelling does. A field read in the arm still demands its field of the argument (D16004).
// At a pin whose every member is the record the arm is dead and goes unchecked (D16006).
type A = { v: i32 }
type B = { w: string }
function needI(n: i32) { print(n) }
function pr(h) {
  if h is A { print(h.v) } else { print(h) }
}
function bin(h) {
  if h is A { print(h.v) } else { print(h + 1) }
}
function arg(h) {
  if h is A { print(h.v) } else { needI(h) }
}
function ret(h) {
  if h is A { return h.v } else { return h * 2 }
}
function early(h) {
  if h is A {
    print(h.v)
    return
  }
  print(h)
}
function str(h) {
  if h is A { print(h.v) } else { print(h + "!") }
}
function len(h) {
  if h is A { print(h.v) } else { print(h.length) }
}
function idx(h) {
  if h is A { print(h.v) } else { print(h[0]) }
}
function fwd(q) { bin(q) }
function neg(h) {
  if !(h is A) { print(h + 1) } else { print(h.v) }
}
function fld(h) {
  if h is A { print(h.v) } else { print(h.w) }
}
const n: A | i32 = 5
const a: A | i32 = { v: 7 }
pr(n)
pr(a)
bin(n)
arg(n)
print(ret(n))
early(n)
const s: A | string = "s"
str(s)
const t: A | string = "abc"
len(t)
const l: A | i32[] = [3, 4]
idx(l)
const m: A | i32 | string = 5
pr(m)
fwd(n)
neg(n)
const b: A | B = { w: "ww" }
fld(b)
const onlyA: A = { v: 9 }
bin(onlyA)
pr(onlyA)
