// @run
// @log 7
// @log big
// @log 5
// @hint redundant type annotation: `r` is inferred as `i32` — remove it to lean on inference
// A function whose implicit return is an assignment takes its result from the cell the
// assignment stores into: the binding in scope at the target, not an earlier same-named binding
// in a block the target is outside, whether the tail is straight or a tail `if` (D3237).
function pick(c: boolean, big: i64, small: i32) {
  if c {
    const s = big + 1
    print(s)
  }
  let s = 0
  s = small
}
function viaI32() {
  const r: i32 = pick(false, 9, 7)
  r
}
print(viaI32())
function word(c: boolean, n: i32) {
  if c {
    const w = n
    print(w)
  }
  let w = "a"
  if n > 3 { w = "big" } else { w = "small" }
}
print(word(false, 8))
function arms(c: boolean, fl: f64) {
  if c {
    const t = "x"
    print(t)
  }
  if fl > 1.0 {
    let t = 1.5
    t = fl * 2.0
  } else {
    let t = 0.5
    t = fl
  }
}
print(arms(false, 2.5))
