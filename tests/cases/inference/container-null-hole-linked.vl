// @error push: cannot add string to (i32 | null)[]
// CONTRACT (must-error): an open `_ | null` written into another open one links the two, so
// one fill fills both (D2506). `x = 1` fills `x`'s hole and so the list's element, and a
// `string` push then disagrees with it. Filled apart, the list stored `x`'s `i32` box as a
// `string` element: check-clean invalid wasm.
function main() {
  let x = null
  const xs = []
  xs.push(null)
  xs.push(x)
  x = 1
  xs.push("a")
  print(xs.length)
}
main()
