// D2640: an inferred record's empty `[]` field that a later push pins to a ref element keys
// the element's own row, whichever literal mints it first.
function main() {
  const r = { c: [] }
  r.c.push({ a: 3 })
  print(r.c.length)
  print(r.c[0].a)
}
main()

const s = { xs: [] }
const q = { x: 2, y: 3 }
s.xs.push(q)
print(s.xs[0].x)
print(s.xs[0].y)

const n = { ls: [], k: 9 }
n.ls.push([1, 2])
print(n.k)
print(n.ls[0][0])
