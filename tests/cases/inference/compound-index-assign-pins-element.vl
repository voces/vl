// @run
// @log 2
// @log 0.75
// @log 2
// @log 0
// @log 6
// @log 1
// @log 2
// @log 2.25
// @log a!
// @log 2
// @log 2.25
// @log a!
// @log 5
// @log 3
// A compound assignment into an un-annotated empty list pins the element (D1603, `~/glean`
// VL-046). `count[i] += 1` desugars to `count[i] = count[i] + 1`, so the read runs before
// anything has pinned the element: it answered `-1`, the operator floor turned that into
// `TyErr`, and the store banked the error type as the element.
//
// The i32 element is the one that survived it — an unpinned hole lowers as the i32-list
// default, so the program ran with `<error>[]` recorded for the binding. Every other element
// type failed, and each in its own way: an f64 or f32 tally was check-clean invalid wasm, a
// string tally an emit reject, and any of them written as the function's TAIL a check reject.
// So the f64, f32 and string cells here are the ones that can fail; an i32-only fixture goes
// green whether or not the pin reached the emitter.

// The consumer's witness, un-annotated, with the f64 tally the same shape wants.
const seen = []
const count = []
const seconds = []
function note(name: i32, dt: f64) {
  for i in 0 to seen.length - 1 {
    if seen[i] == name {
      count[i] += 1
      seconds[i] += dt
      return
    }
  }
  seen.push(name)
  count.push(1)
  seconds.push(dt)
}
note(7, 0.5)
note(7, 0.25)
print(count[0])
print(seconds[0])

// The same shape with the annotations it does not need — one variable apart.
const seenA: i32[] = []
const countA: i32[] = []
function noteA(name: i32) {
  for i in 0 to seenA.length - 1 {
    if seenA[i] == name {
      countA[i] += 1
      return
    }
  }
  seenA.push(name)
  countA.push(1)
}
noteA(7)
noteA(7)
print(countA[0])

// Every compound operator over the same open element, plus the prefix `++`.
const minus = []
const times = []
const over = []
const pre = []
function ops(i: i32) {
  if minus.length > i {
    minus[i] -= 1
    times[i] *= 6
    over[i] /= 3
    ++pre[i]
    return
  }
  minus.push(1)
  times.push(1)
  over.push(3)
  pre.push(1)
}
ops(0)
ops(0)
print(minus[0])
print(times[0])
print(over[0])

// The hand-written desugaring: a plain store whose value reads the place it writes. Two
// different nodes over one arena row, which is why the pin is keyed on the row.
const spelled = []
function spell(i: i32) {
  if spelled.length > i {
    spelled[i] = spelled[i] + 1
    return
  }
  spelled.push(1)
}
spell(0)
spell(0)

// An f32 element, read back through arithmetic.
const scaled: f32[] = []
const scaledBare = []
function scale(i: i32) {
  if scaledBare.length > i {
    scaled[i] += 0.5
    scaledBare[i] += 0.5
    return
  }
  scaled.push(1.5)
  scaledBare.push(1.5)
}
scale(0)
scale(0)
print(scaled[0])
print(scaledBare[0] + 0.25)

// A string element: `+=` is concatenation, so the pin has to name `string`.
const tags = []
function tag(i: i32) {
  if tags.length > i {
    tags[i] += "!"
    return
  }
  tags.push("a")
}
tag(0)
tag(0)
print(tags[0])

// The TAIL face of each: the compound assignment is the function's trailing expression and the
// `.push` that names the element is written below it.
const tallyI = []
function bumpI(i: i32) {
  tallyI[i] += 1
}
const tallyF = []
function bumpF(i: i32) {
  tallyF[i] += 0.75
}
const tallyS = []
function bumpS(i: i32) {
  tallyS[i] += "!"
}
tallyI.push(1)
tallyF.push(1.5)
tallyS.push("a")
bumpI(0)
bumpF(0)
bumpS(0)
print(tallyI[0])
print(tallyF[0])
print(tallyS[0])

// The controls that already worked, kept so a change to the pin cannot quietly take them:
// a plain store, and a read of the open element in an i32 context.
const stored = []
function store(i: i32) {
  if stored.length > i {
    stored[i] = 5
    return
  }
  stored.push(1)
}
store(0)
store(0)
print(stored[0])

const read = []
function readOne(i: i32) {
  if read.length > i {
    const seenVal: i32 = read[i]
    print(seenVal + 2)
    return
  }
  read.push(1)
}
readOne(0)
readOne(0)
