// @run
// @log yy
// @log yy
// @log b
// @log yy
// @log 0
// @log yy
// @log 4
// @log b
// @log f
// D16007: a negated `is` guard over an un-annotated parameter registers the type its `else` arm
// narrows to as an alternative, as the positive guard does for its `then` arm, so a union
// argument meets the demand member by member; and the pin that makes the negated test always
// false leaves its `then` arm dead.
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: string }
function mkAB(): A | B { return { kind: "b", y: "yy" } }
function both(p) {
  if !(p is A) { print(p.y) } else { print(p.x) }
}
function after(p) {
  if !(p is A) { print(p.y) } else { print(p.x) }
  print(p.kind)
}
function noElse(p) {
  if !(p is A) { print(p.y) }
  print(0)
}
function early(p) {
  if !(p is A) {
    print(p.y)
    return 0
  }
  print(p.x)
  0
}
function foobar(v) {
  if !(v is { foo: string }) { return v.bar }
  return v.foo
}
both(mkAB())
after(mkAB())
noElse(mkAB())
early(mkAB())
const a: A = { kind: "a", x: 4 }
early(a)
print(foobar({ bar: "b" }))
print(foobar({ foo: "f" }))
