// @run
// @log 2
// @log too big
// @log 4
// @log big
// AN UN-ANNOTATED PARAMETER UNDER A UNION RETURN ANNOTATION (D1520, `~/glean` VL-004).
//
// `tryParse`'s body is the consumer's own, unchanged. The tail `x * 2` hands the hole
// back as its own result type, so the flow hook the parameter solve reads recorded
// `hole(x) -> i32 | Err` and the solve adopted the WHOLE union as `x`'s type. Both
// numeric uses then refused, `x > 5` included — a diagnostic upstream of the return
// that caused the pin, which is what made the cause hard to see.
//
// The rule is D1431's: an open hole defers to the CALL that pins it, and a multi-arm
// union destination is a choice rather than an answer. `pickS` is the value-union
// spelling of the same shape (no struct arm), so a fix that only taught the struct
// case would leave it refusing.
type Err = { msg: string }

function tryParse(x): i32 | Err {
  if x > 5 { return { msg: "too big" } }
  x * 2
}

function pickS(x): i32 | string {
  if x > 5 { return "big" }
  x * 2
}

const r1 = tryParse(1)
if r1 is Err { print(r1.msg) } else { print(r1) }
const r2 = tryParse(9)
if r2 is Err { print(r2.msg) } else { print(r2) }
const s1 = pickS(2)
if s1 is string { print(s1) } else { print(s1) }
const s2 = pickS(9)
if s2 is string { print(s2) } else { print(s2) }
