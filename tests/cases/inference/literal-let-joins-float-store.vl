// @run
// @log 4
// @log 3
// @log 1.5
// @log 1.25
// @log 4.25
// @log 1.5
// @log 5000000000
// @log 6000000000
// @log 1.75
// @log 3.5
// @log 7.25
// An integer literal `let` joins a float stored into it that holds the literal exactly, and in an
// un-annotated generic the stored hole, so each call's pin types it (D16293).
function sum(xs) {
  let t = 0
  let i = 0
  while i < xs.length { t = t + xs[i]; i = i + 1 }
  return t
}
print(sum([1.5, 2.5]))
print(sum([1, 2]))
let p = 0
p = p + 1.5
print(p)
let q = 0
q = 2.5
print(q / 2)
const fs = [1.5, 2.5, 0.25]
let acc = 0
for x in fs { acc = acc + x }
print(acc)
let r = 0
const f: f32 = 1.5
r = f
print(r)
let w = 0
const big = 5000000000
w = w + big
print(w)
function tot(xs) {
  let t = 0
  for x in xs { t = t + x }
  return t
}
const a = [3000000000, 3000000000]
const b: f32[] = [1.5, 0.25]
print(tot(a))
print(tot(b))
function fields(rs) {
  let t = 0
  for s in rs { t = t + s.v }
  return t
}
print(fields([{ v: 1.5 }, { v: 2.0 }]))
function mx(xs) {
  let m = 0
  for x in xs {
    if x > m { m = x }
  }
  return m
}
print(mx([1.5, 7.25, 2.0]))
