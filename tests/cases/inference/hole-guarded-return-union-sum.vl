// @run
// @log 13
// D3094's un-annotated face: the accumulator's literal takes `i64` from the `is i64` branch the
// sum reads, so the program runs where an `i32` accumulator is refused.
const zs: (i64 | string)[] = [5, "t", 6]
function g(w) {
  if w is i64 { return w + 1 }
  return 0
}
let c = 0
for e in zs { c = c + g(e) }
print(c)
