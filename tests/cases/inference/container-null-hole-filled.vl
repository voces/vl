// @run
// @log x
// @log none
// @log 2
// @log 4
// @log -1
// @log 3
// @log -1
// @log true
// @log 1
// @log 2.5
// @log 7
// @log 9
// @log 3
// @log 1
// @log 3
// @log 5
// @log 8
// @log true
// @log 7
// @log 4
// @log 3
// @log 4
// @hint redundant type annotation: `rl` is inferred as `({a: i32} | null)[]` — remove it to lean on inference

// D2506: a write of only `null` into an un-annotated list or map pins its element or value to
// `T | null` with `T` open, as `let x = null` does, and a later write, a call site or a
// destination fills `T`. The three write spellings (`.set`, `.push`, `m[k] = v`) agree, and a
// parameter the body only writes `null` into takes each call site's own `T` (D2524).
type C = { a: i32 }

const m = Map()
m.set("a", null)
m.set("b", "x")
print(m.get("b") ?? "none")
print(m.get("a") ?? "none")

const xs = []
xs.push(null)
xs.push(4)
print(xs.length)
print(xs[1] ?? -1)
print(xs[0] ?? -1)

const n = Map()
n["a"] = null
n["b"] = 3
print(n["b"] ?? -1)
print(n["a"] ?? -1)

function use(v) {
  v.set("b", null)
  print(v.has("b"))
}
const ms: {[string]: string | null} = Map()
use(ms)

function pushNull(v) {
  v.push(null)
  print(v.length)
}
const ss: (string | null)[] = []
pushNull(ss)

function mkF(): (f64 | null)[] {
  const fs = []
  fs.push(null)
  return fs
}
const fs2 = mkF()
fs2.push(2.5)
print(fs2[1] ?? 0.0)

function recs() {
  const rs = []
  rs.push(null)
  rs.push({ a: 7 })
  const r = rs[1]
  if r != null { print(r.a) }
}
recs()

function coal() {
  const ys = []
  ys.push(null)
  const before = ys[0] ?? 9
  ys.push(3)
  print(before)
  print(ys[1] ?? 9)
}
coal()

function take(zs: (i32 | null)[]) { print(zs.length) }
function callSite() {
  const zs = []
  zs.push(null)
  take(zs)
  zs.push(3)
  print(zs[1] ?? -1)
}
callSite()

const g = []
function fill() {
  g.push(null)
  g.push(5)
}
fill()
print(g[1] ?? -1)

// An inferred-return list of inline-shape nullable records, delivered to the declared `C | null`
// the shape matches: the list and the destination name one row (was invalid wasm).
function mkRecs() {
  const y: { a: i32 } | null = { a: 8 }
  const o = []
  o.push(y)
  return o
}
const rl: (C | null)[] = mkRecs()
const r0 = rl[0]
if r0 != null { print(r0.a) }

// A hole parameter's only write is `null`, into a caller's list of `boolean | null` or of a
// declared record's `| null`: the instance takes the caller's row. Two holes written into each
// other fill together.
type A = { v: i32 }
function addNull(zs) { zs.push(null) }
function paramFills() {
  const bs: (boolean | null)[] = []
  bs.push(true)
  addNull(bs)
  print(bs[0] ?? false)
  const as2 = []
  const a: A | null = { v: 7 }
  as2.push(a)
  addNull(as2)
  const e = as2[0]
  if e != null { print(e.v) }
}
paramFills()

function linked() {
  let x = null
  const ks = []
  ks.push(null)
  ks.push(x)
  x = 3
  ks.push(4)
  print(ks[2] ?? -1)
}
linked()

// Through a hole parameter's instance, once both elements are filled before the call.
function linkVia(xs, ys) { xs.push(ys[0]) }
function viaParam() {
  const a = []
  a.push(null)
  a.push(5)
  const b = []
  b.push(null)
  b.push(4)
  linkVia(a, b)
  print(a.length)
  print(b[1] ?? -1)
}
viaParam()
