// @run
// @log 3
// @log 3
// @log 2
// @log 2
// @log 11
// @log 5
// A captured `let x = null` read inside a callback that runs before the write filling it is
// `null`, delivered at a destination of another rep as that destination's null (D15951).
function take(s: string | null) {
  if s == null { return 1 } else { return 0 }
}
function takeU(s: string | boolean | null) {
  if s == null { return 10 } else { return 0 }
}
function app(f: (e: i32) => i32) { return f(2) }
function main() {
  let x = null
  const ys = [1, 2].map((e) => e + take(x))
  const y = app((e) => e + take(x))
  const zs = [1, 2].map((e) => {
    const s: string | null = x; return if s == null { e } else { 0 }
  })
  const fs = [1, 2, 3].filter((e) => e + take(x) > 2)
  const us = [1].map((e) => e + takeU(x))
  x = 5
  print(ys[1])
  print(y)
  print(zs[1])
  print(fs.length)
  print(us[0])
  print(x ?? 0)
}
main()
