// @error cannot assign i32 | null to string | null: this `let` starts as `null`, and a later write makes its type i32 | null
// A read of a `let x = null` delivered before a later write fills it is judged at the filled type,
// which the binding holds at every read, as the annotated twin is (D2660).
function link2<T>(xs: T[], v: T) { xs.push(v) }
function main() {
  const xs: (string | null)[] = []
  let x = null
  link2(xs, x)
  x = 5
  xs.push("s")
  print(xs.length)
}
main()
