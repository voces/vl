// @check
// @error-at 7:37 undeclared identifier 'zzz'
// @error-at 16:20 cannot assign i32 to 's' of type string
// @error-at 19:0 cannot infer a return type for 'loops' — annotate a return type
// An un-annotated function whose returned value is an earlier error's recovery type reports
// that error alone, not "cannot infer a return type" on top of it. A body that also recurses
// with no base case still reports both: the recursion is a second, independent mistake.
function broken(n: i32) { return n + zzz }

function caller(n: i32): i32 {
  const k: i32 = broken(n)
  return k
}
print(caller(1))

function loops(n: i32) {
  const s: string = n
  print(s)
  return loops(n)
}
print(loops(1))
