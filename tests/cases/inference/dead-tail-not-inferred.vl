// @run
// @warning Unreachable code
// @hint Intentionally-unused
// @hint redundant type annotation
// @log a
// @log 7
// @log pn
// @log ab
// @log ab
// @log ab
// @log ar
// @log abc
// @log c3l4
// @log 5
// @log t
// @log 4
// @log a
// @log 6
// A value tail after a statement that always exits is dead at every inference position: an
// inferred return, a `match` value arm, a labelled block and a closure leave it out of their
// type, exactly as the declared return and the value-`if` do (D8720).
import { toString } from "std:fmt"

function inferred(_k: i32) {
  return "a"
  5
}
function inferredArm(k: i32) {
  if k > 0 { return 4 }
  return 3
  "x"
}
function inferredGen<T>(x: T, k: i32) {
  if k > 0 {
    return "p"
    x
  }
  return "n"
  x
}
function matchArm(k: i32): string {
  const s: string = match k {
    1 => {
      return "a"
      5
    }
    _ => "b"
  }
  s
}
function matchTail(k: i32) {
  match k {
    1 => {
      return "a"
      5
    }
    _ => "b"
  }
}
function matchGen<T>(x: T, k: i32) {
  match k {
    1 => {
      return "a"
      x
    }
    _ => "b"
  }
}
function labelled(k: i32): string {
  const s: string = @b {
    if k > 0 { break @b "a" }
    return "r"
    5
  }
  s
}
function elseIf(k: i32) {
  if k == 1 {
    "a"
  } else if k == 2 {
    return "b"
    5
  } else {
    "c"
  }
}
function mk(n: i32): () => string {
  () => {
    return "c" + n.toString()
    5
  }
}
function mkGen<T>(x: T) {
  () => {
    return x
    "dead"
  }
}
function trapThenTail(k: i32) {
  if k > 0 { return "t" }
  __trap__()
  5
}
function deadNull(k: i32) {
  return k
  null
}
function deadList(_k: i32) {
  return "a"
  []
}
function deadRecord(k: i32) {
  return { r: k }
  "s"
}
const a: string = inferred(1)
const b: i32 = inferredArm(1) + inferredArm(0)
const c: string = inferredGen(true, 1) + inferredGen(2.5, 0)
const d: string = matchArm(1) + matchArm(2)
const e: string = matchTail(1) + matchTail(2)
const f: string = matchGen(true, 1) + matchGen(2.5, 2)
const g: string = labelled(1) + labelled(0)
const h: string = elseIf(1) + elseIf(2) + elseIf(3)
const lam = (k: i32) => {
  return "l" + k.toString()
  5
}
const i: string = mk(3)() + lam(4)
const gen = mkGen(5)
const j: i32 = gen()
const t: string = trapThenTail(1)
const n: i32 = deadNull(4)
const l: string = deadList(1)
const r: i32 = deadRecord(6).r
print(a)
print(b)
print(c)
print(d)
print(e)
print(f)
print(g)
print(h)
print(i)
print(j)
print(t)
print(n)
print(l)
print(r)
