// @run
// @log 7
// @log 7
// @log true
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// A function returning a record that wraps a narrowed map read in one arm and a literal record
// holding a never-filled `null` field in the other joins its returns; the bound result reads back.
function mk2() { return { f: null, g: 7 } }
const __m = Map()
__m["k"] = mk2()

function pick() {
  const mv = __m["k"]
  if mv != null { return { a: mv } }
  return { a: mk2() }
}
const rr = pick()
print(rr.a.g)

let lr = pick()
print(lr.a.g)
print(lr.a.f == null)

const o = { r: pick() }
print(o.r.a.g)

function use(x: { a: { f: null, g: i32 } }) { print(x.a.g) }
use(pick())

function pickList() {
  const mv = __m["k"]
  if mv != null { return [mv] }
  return [mk2()]
}
const pl = pickList()
print(pl[0].g)

function pickTwo() {
  const mv = __m["k"]
  const mw = __m["k"]
  if mv != null { return { a: mv } }
  if mw != null { return { a: mw } }
  return { a: mk2() }
}
const pt = pickTwo()
print(pt.a.g)

function pickIf(b: boolean) {
  const mv = __m["k"]
  const v = if mv != null && b { { a: mv } } else { { a: mk2() } }
  return v
}
const pi = pickIf(true)
print(pi.a.g)

print(pick().a.g)
