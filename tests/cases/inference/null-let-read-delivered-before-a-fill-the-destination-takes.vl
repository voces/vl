// @run
// @log 2
// @log true
// @log 3
// A read of a `let x = null` delivered before a later write fills it runs when the destination
// takes the filled type (D2660's grading list).
function link2<T>(xs: T[], v: T) { xs.push(v) }
function main() {
  const xs: (string | null)[] = []
  let x = null
  link2(xs, x)
  x = "t"
  xs.push(x)
  print(xs.length)
  let n = null
  const y: i32 | null = n
  n = 3
  print(y == null)
  print(n ?? 0)
}
main()
