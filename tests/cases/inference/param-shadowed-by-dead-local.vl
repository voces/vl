// @run
// @log 7
// @log kept
// @log 2.5
// @hint redundant type annotation: `r` is inferred as `i32` — remove it to lean on inference
// A read of a parameter whose name a binding in a block the read is outside also uses denotes
// the parameter, whatever that binding's type: the return is typed by the parameter (D3292).
function pick(c: boolean, big: i64, s: i32) {
  if c {
    const s = big + 1
    print(s)
  }
  return s
}
function viaI32() {
  const r: i32 = pick(false, 9, 7)
  r
}
print(viaI32())
function name(c: boolean, s: string) {
  if c {
    const s = 3
    print(s)
  }
  s
}
print(name(false, "kept"))
function tally(c: boolean, s: f64[]) {
  if c {
    const s = "x"
    print(s)
  }
  return s
}
print(tally(false, [1.5, 2.5])[1])
