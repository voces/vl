// @error-at 9:12 `\$` is not an escape — write `$` (an interpolation hole is `\{…}`)
// `\$` IS RETIRED, and it gets its own sentence rather than the generic
// "Unknown escape sequence".
//
// It was a template-only escape for the six days `${` was the hole trigger. With
// the trigger in the escape namespace, `$` is an ordinary character in a template
// again and needs no escape at all — so keeping `\$` would have left a second
// spelling for one character that only one of the two literal forms accepted,
// which is the grammar split this change exists to close.
const s = `a\$b`
print(s)
