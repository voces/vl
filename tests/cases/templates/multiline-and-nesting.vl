// @run
// @log true
// @log true
// @log ab1cd
// @log v=2
// @log n=2
// A STRING IS MULTILINE, its holes NEST, and a hole may span lines.
//
// Multiline is Rust's rule: a raw newline inside a `"…"` literal is CONTENT, not
// the end of it. The newline is therefore not emitted as a NEWLINE token, which
// is what lets a multi-line string sit inside a statement without a continuation.
const m = "line1
line2"
print(m == "line1\nline2")
print(m.length == 11)

// NESTING IS ALLOWED, and falls out of the scanner rather than being added to
// it: a hole's closing `}` is the one at that hole's own brace depth, so an
// inner literal inside a hole simply pushes its own row.
const x = 1
print("a\{ "b\{x}c" }d")

// A HOLE MAY SPAN LINES. Inside a hole, at the hole's own brace depth, a newline
// can never be a statement terminator (a hole is an expression), so it is not
// emitted — which is what makes this parse.
print(
  "v=\{
  x + 1
}",
)

// A member call inside a hole; the hole's expression is ordinary in every way.
const xs = [1, 2]
print("n=\{xs.length}")
