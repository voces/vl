// @run
// @log true
// @log true
// @log true
// @log true
// @log v=42|n=9000000000|b=true|s=S
// THE HOLE DOMAIN AT LAUNCH, and the equality that defines it.
//
// A hole is `string`, `i32`, `i64` or `boolean`. The three non-string arms go
// through `std:fmt`'s renderer; the `string` arm is delivered directly (the
// renderer does not take a string, and widening it to would box every
// interpolated string into a union to hand it straight back).
//
// EACH ARM IS ASSERTED AGAINST THE CONCATENATION IT DESUGARS TO, not against a
// transcript. That is the real contract — a template is sugar for `+` over the
// same renderer a program can call by hand — and it is the assertion that would
// fail if the injected import ever bound to something else.
//
// THE DOMAIN IS NOT SPELLED IN THE COMPILER — it is `string` plus whatever the
// renderer's declared parameter admits, so it widens with the renderer and the
// refusal's own sentence widens with it. `f64` arrived that way (serde Stage 0's
// `renderF64`) with no template-side edit; `hole-f64-rides-the-renderer.vl` is
// the pin for that half, and `err-hole-struct.vl` for what stays outside.
import { toString } from "std:fmt"

const x = 42
const n = 9000000000
const b = true
const s = "S"

print(`v=${x}` == "v=" + x.toString())
print(`n=${n}` == "n=" + n.toString())
print(`b=${b}` == "b=" + b.toString())
print(`s=${s}` == "s=" + s)

// All four in one template, in one concatenation.
print(`v=${x}|n=${n}|b=${b}|s=${s}`)
