// @run
// @log v=4
// @log 9
// @log true
// A module that ALREADY imports the renderer and also uses a template. Both
// reach ONE merged function, and `std:fmt` is merged exactly once.
//
// The injected dependency is an ordinary import row keyed on the module
// specifier, and `modKeys` is the registry: a key already in the table is never
// pending again, so a second edge to `std:fmt` costs a linear scan and nothing
// else. Measured on the emitted wasm: this program is BYTE-IDENTICAL to the
// same source with `` `v=${x}` `` written out as `"v=" + x.toStr()` — 17,103
// bytes, 59 functions, one copy of the renderer.
import { toStr } from "std:fmt"

const x = 4
print(`v=${x}`)
print(toStr(9))

// The author's own call and the template's injected one are the same function,
// so the two spellings agree by construction.
print(`v=${x}` == "v=" + toStr(x))
