// @run
// @log plain
// @log a1b2c
// @log S
// @log 3
// @log 1
// @log nested ` backtick in string
// @log `
// @log ${
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// Backtick TEMPLATE literals, the whole accepting surface in one file.
//
// The syntax is ADDITIVE: before this feature a backtick did not lex at all
// (`Unexpected character '`'`), so no existing program's meaning can change.
//
// A template desugars to the string concatenation it means, with each `${…}`
// hole delivered either directly (a `string`) or through `std:fmt`'s integer /
// boolean renderer. The renderer is named ABSOLUTELY — see `user-tostr.vl`.
print(`plain`)

// Several holes, with text between and around them.
print(`a${1}b${2}c`)

// A hole is an EXPRESSION context, not a name slot: a `string` hole rides
// through untouched, arithmetic evaluates, and an object literal's braces nest
// inside the hole (the `}` that ends a hole is the one at the hole's own brace
// depth — a deeper one closes what opened it).
const s = "S"
print(`${s}`)
print(`${1 + 2}`)
print(`${ {a: 1}.a }`)

// A BACKTICK INSIDE A HOLE'S STRING LITERAL NEEDS NO ESCAPE. The hole is
// expression context, so `"…"` is scanned by the ordinary string scanner and a
// backtick is an ordinary character there. Only the template's own text parts
// ever have to escape one.
print(`${"nested ` backtick in string"}`)

// The two template-only escapes: the two delimiters.
print(`\``)
print(`\${`)

// EVERY OTHER ESCAPE IS THE STRING ESCAPE SET, shared and unchanged — asserted
// against the `"` spelling rather than printed, so the test is the agreement
// itself and not a directive line carrying an invisible tab.
print(`\t` == "\t")
print(`\n` == "\n")
print(`\x41` == "\x41")
print(`\u0042` == "B")
print(`\u{1F600}` == "\u{1F600}")
print(`a\\b` == "a\\b")
