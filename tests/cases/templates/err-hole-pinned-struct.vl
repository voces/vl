// @check
// @error an interpolation hole is `string` or i32 | i64 | boolean | f64 — this one is P
// A template hole pinned outside the renderer's domain refuses at the pin in the direct
// spelling's words, now that the pin admits `string` (D2241).
type P = { x: i32 }
function show(a) { print("v=\{a}") }
const p: P = { x: 1 }
show(p)
