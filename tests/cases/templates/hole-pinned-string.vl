// @run
// @log v=s
// @log v=5
// @log v=true
// @log v=s
// @log v=2.5
// @log <w>
// @log <4>
// @log v=b
// @hint redundant type annotation: `tagS` is inferred as `string` — remove it to lean on inference
// @log v=m
// @log x-1
// @log 2-y
// @log inner=s
// @log inner=9
// @log v=b
// A template hole whose type is a hole a call pins at `string` (D2241). The renderer takes
// no string, so the hole is delivered as itself. Three things had to agree: the pin re-check
// admits `string` (and a literal atom) beside the renderer's domain, the emitter delivers the
// string in every instance, and a pinned re-check of the body never rewrites the shared node,
// which is what made one string call corrupt the i32 instance of the same generic.
type K = "a" | "b"

// The filed witness, an un-annotated parameter.
function show(a) { print("v=\{a}") }

// One generic, a string instance and a numeric one in the same program.
function showT<T>(a: T) { return "v=\{a}" }

// The method spelling.
function tag<T>(self: T) { print("<\{self}>") }

// Two holes, pinned in opposite orders.
function pair(a, b) { return "\{a}-\{b}" }

// A hole captured by a closure.
function inner(a) {
  const f = () => "inner=\{a}"
  print(f())
}

show("s")
show(5)
show(true)
print(showT("s"))
print(showT(2.5))
"w".tag()
(4).tag()
const k: K = "b"
show(k)
const xs = ["m"]
for x in xs { show(x) }
print(pair("x", 1))
print(pair(2, "y"))
inner("s")
inner(9)

// The method spelling at a literal atom, with a declared return (printed `v=0` before).
function tagS<T>(self: T): string { return "v=\{self}" }
print(k.tagS())
