// @error Unterminated string literal
// @error-at 7:10 Unterminated string literal
// An unterminated string reports AT ITS OPENING QUOTE, not wherever the scan ran
// out. A `"` literal may span lines, so the scan runs to end of input and the
// position it stops at says nothing useful; the opening quote is the character
// the author can fix. The span is the opener's own line, which is the only one a
// single column pair can express.
const s = "abc
print(s)
