// @run
// @log v=a
// @log v=7
// @log w=b
// @warning this value is discarded; did you mean `return …`?
// A template hole a call pins to a string or a literal atom is that string where the render call
// stands, both as a value and as a statement whose value is dropped.
type K = "a" | "b"
function show(a) { print("v=\{a}") }
function shown(a) { return "w=\{a}" }
function drop(a) { "x=\{a}" }
const k: K = "a"
show(k)
show(7)
const b: K = "b"
print(shown(b))
drop("s")
