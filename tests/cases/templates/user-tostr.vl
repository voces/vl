// @run
// @log v=7
// @log USER
// @log v=7
// @log not even a function
// THE ABSOLUTE BINDING, stated as a program: a user-declared `toStr` sitting
// beside a template does not change what the template means.
//
// This is the whole reason the renderer is not a scope lookup (DECISIONS.md,
// owner ruling 2026-09-01): a string literal's meaning must not depend on what
// the file imports or declares. Here `toStr` names a top-level function of the
// program, and then a local binding that is not even callable — and
// `` `v=${x}` `` renders through std's in both scopes.
//
// The mechanism: the hole's call names an identifier no program can spell (`$`
// is not an identifier character), and the module merge rewrites it straight to
// the merged `toStr$mN`. It is never a key the user's scope could shadow.
function toStr(self: i32) {
  if self < 0 { return "USER-" }
  "USER"
}

const x = 7
print(`v=${x}`)
print(x.toStr())

// The same, with the local declaration ALSO shadowing what a hand-written call
// would reach. A template is unmoved.
function render(v: i32) {
  const toStr = "not even a function"
  print(`v=${v}`)
  print(toStr)
  0
}
render(7)
