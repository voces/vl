// @run
// @log ab1cd
// @log v={x}
// @log t=n=1
// @log oi1o
// @log ab1cd
// NESTING ACROSS THE TWO QUOTED FORMS — all of it falls out of the scanner
// rather than being added to it, which is why none of these spellings is
// refused.
//
// A hole ends at the `}` AT THAT HOLE'S OWN BRACE DEPTH, and every open run
// records its own delimiter, so an inner literal — of either form — just pushes
// its own row and pops it again. Nothing here asks which delimiter opened the
// outer literal.
const x = 1

// A hole in a STRING holding a TEMPLATE (which holds a hole).
print("a\{ `b\{x}c` }d")

// A hole holding a STRING that contains BRACES. The braces are data inside the
// nested literal, so they are invisible to the hole's depth counter — the same
// reason a `"` inside a hole is not the outer string's terminator.
print("v=\{ "{x}" }")

// A TEMPLATE holding a holed PLAIN STRING.
print(`t=\{ "n=\{x}" }`)

// A string hole holding a string hole.
print("o\{ "i\{x}" }o")

// The backtick form's own nesting, unchanged by any of this.
print(`a\{ `b\{x}c` }d`)
