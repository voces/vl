// @run
// @log v=1.5
// @log true
// @log 3.14159|-0.5|100
// THE HOLE DOMAIN IS THE RENDERER'S, AND THIS FIXTURE IS THE PROOF IT TRACKS IT.
//
// This file was written as an ERROR fixture. `f64` was outside the domain
// because `std:fmt`'s renderer did not take one, and the template side said so
// at the hole. Then serde Stage 0 landed `renderF64` and widened that renderer
// to `i32 | i64 | boolean | f64` — and the template side picked it up with
// **no edit at all**, because both the admission test and the refusal's own
// SENTENCE are read off the renderer's declared parameter type rather than
// spelled in the compiler.
//
// So the fixture flipped from pinning a refusal to pinning the widening, which
// is the more valuable of the two: it fails the day someone re-hard-codes the
// domain, and it is the standing evidence that "the domain widens with the
// renderer" is a property and not a promise.
import { toString } from "std:fmt"

const f = 1.5
print(`v=\{f}`)

// The same equality every other arm is held to: a template is sugar for `+` over
// the renderer a program can call by hand.
print(`v=\{f}` == "v=" + f.toString())

// Shortest-round-trip rendering reaches the hole unchanged — the renderer's
// business, not the template's.
print(`\{3.14159}|\{0.0 - 0.5}|\{100.0}`)
