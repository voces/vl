// @error-at 9:10 Unterminated string literal
// MULTILINE STAYS BACKTICK-ONLY. A raw newline inside a `"…"` string is still
// the end of the literal — that rule did not move when holes arrived, and it is
// now the ONLY rule the two quoted grammars still disagree about.
//
// So a `"` run whose TAIL part runs into a newline is unterminated, and it is
// reported at the opening quote like any other. (A hole may still span lines —
// a hole is expression context, not text — which is a different question and is
// pinned in `multiline-and-nesting.vl`.)
const s = "abc\{1}def
print(s)
