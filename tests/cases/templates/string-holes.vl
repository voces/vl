// @run
// @log v=42
// @log a3b
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log v=42|n=9000000000|b=true|f=1.5|s=S
// PLAIN DOUBLE-QUOTED STRINGS INTERPOLATE, with the same `\{…}` hole a template
// takes. One hole syntax, one desugar, one renderer — this file is the `"…"`
// half of `basic.vl` + `hole-domain.vl`, and the last assertion is the point:
// the two spellings are not two features.
//
// THE TRIGGER IS IN THE ESCAPE NAMESPACE, which is what made this additive to a
// literal form that already had four thousand users. `"a\{b"` was an "Unknown
// escape sequence" error before this, so no string's meaning changed; `{` stays
// an ordinary character forever (`brace-stays-literal.vl` is that pin).
//
// MULTILINE STAYS BACKTICK-ONLY: a raw newline in a `"…"` string is still the
// end of the literal (`err-string-hole-newline.vl`). Only the HOLES are shared.
import { toString } from "std:fmt"

const x = 42
const n = 9000000000
const b = true
const f = 1.5
const s = "S"

print("v=\{x}")
print("a\{1 + 2}b")

// EACH ARM ASSERTED AGAINST THE CONCATENATION IT DESUGARS TO — the same
// contract `hole-domain.vl` holds the backtick form to, because it is the same
// lowering reached from a different delimiter.
print("v=\{x}" == "v=" + x.toString())
print("n=\{n}" == "n=" + n.toString())
print("b=\{b}" == "b=" + b.toString())
print("f=\{f}" == "f=" + f.toString())
print("s=\{s}" == "s=" + s)

// THE TWO SPELLINGS ARE ONE CONSTRUCT.
print("v=\{x}" == `v=\{x}`)

// All five arms in one string, in one concatenation.
print("v=\{x}|n=\{n}|b=\{b}|f=\{f}|s=\{s}")
