// @run
// @log v=42
// @log a3b
// @log true
// @log true
// @log true
// @log true
// @log true
// @log v=42|n=9000000000|b=true|f=1.5|s=S
// @log v={x}
// @log oi1o
// @log a`b
// STRINGS INTERPOLATE, with a `\{…}` hole. There is one string form, so this
// file is the whole accepting surface of it — `hole-domain.vl` holds the domain
// and `multiline-and-nesting.vl` the multi-line and nesting rules.
//
// THE TRIGGER IS IN THE ESCAPE NAMESPACE, which is what made this additive to a
// literal form that already had four thousand users. `"a\{b"` was an "Unknown
// escape sequence" error before this, so no string's meaning changed; `{` stays
// an ordinary character forever (`brace-stays-literal.vl` is that pin).
import { toString } from "std:fmt"

const x = 42
const n = 9000000000
const b = true
const f = 1.5
const s = "S"

print("v=\{x}")
print("a\{1 + 2}b")

// EACH ARM ASSERTED AGAINST THE CONCATENATION IT DESUGARS TO — the real
// contract is that a hole is sugar for `+` over the same renderer a program can
// call by hand, so an injected import binding elsewhere would fail here.
print("v=\{x}" == "v=" + x.toString())
print("n=\{n}" == "n=" + n.toString())
print("b=\{b}" == "b=" + b.toString())
print("f=\{f}" == "f=" + f.toString())
print("s=\{s}" == "s=" + s)

// All five arms in one string, in one concatenation.
print("v=\{x}|n=\{n}|b=\{b}|f=\{f}|s=\{s}")

// A hole holding a STRING that contains BRACES. The braces are data inside the
// nested literal, so they are invisible to the hole's depth counter — the same
// reason a `"` inside a hole is not the outer string's terminator.
print("v=\{ "{x}" }")

// A string hole holding a string hole: the closing `}` is the one at that
// hole's own brace depth, so an inner literal just pushes its own row.
print("o\{ "i\{1}" }o")

// A BACKTICK IS ORDINARY CONTENT inside a literal — the only thing it can be
// now that it is not a delimiter. Outside one it is a refusal
// (`multiline-strings.vl`).
print("a`b")
