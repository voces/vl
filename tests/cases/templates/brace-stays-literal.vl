// @run
// @log {plain}
// @log ${x}
// @log a{b}c
// @log {"k": 1}
// @log \{x}
// @log true
// @log true
// THE DECIDING PROPERTY OF THE `\{` SPELLING: A BARE `{` IN A STRING IS DATA.
//
// This is why the hole trigger lives in the ESCAPE namespace rather than being
// `{` itself, and it is the measurement the ruling turned on: 4,821 in-tree
// string literals carry a literal brace — JSON, wasm text, format specifiers,
// diagnostics — and under a `{`-triggered interpolator every one of them would
// have needed escaping forever. Under `\{` the escaping tax is zero, PERMANENTLY:
// nothing here is escaped, and nothing here ever has to be.
//
// `${` IS ALSO ORDINARY TEXT NOW, in both quoted forms. It was the backtick
// template's hole trigger for six days; it is a `$` followed by a `{` again.
print("{plain}")
print("${x}")
print("a{b}c")
print("{\"k\": 1}")

// A LITERAL `\{` IS SPELLED `\\{` — the ordinary `\\` escape consumes the first
// backslash, so the `{` after it is read as text and no hole opens. That is the
// escape hatch, and it is the string escape set's own rule rather than a new one.
print("\\{x}")

// The same in a template, so the two forms cannot drift on this.
print("{plain}" == `{plain}`)
print("${x}" == `${x}`)
