// @run
// @log 0
// @log 0
// @log 0
// A Set under adds, re-adds, deletes past compaction and a clear, string-, i32- and i64-keyed,
// checked against a membership list after every step: `0` mismatches each.
import { toString } from "std:fmt"

function step(x: i32) { return (x * 1103515245 + 12345) & 2147483647 }

function strSet() {
  const s = Set()
  const model: boolean[] = []
  for i in 0 until 64 { model.push(false) }
  let x = 7
  let bad = 0
  for n in 0 until 4000 {
    x = step(x)
    const k = x % 64
    const op = (x >> 8) % 7
    if op < 4 {
      s.add("k" + toString(k))
      model[k] = true
    } else if op < 6 {
      s.delete("k" + toString(k))
      model[k] = false
    } else if n % 500 == 0 {
      s.clear()
      for i in 0 until 64 { model[i] = false }
    }
    let live = 0
    for i in 0 until 64 {
      if model[i] { live = live + 1 }
      if s.has("k" + toString(i)) != model[i] { bad = bad + 1 }
    }
    if s.length != live { bad = bad + 1 }
  }
  let walked = 0
  for k in s {
    if k.length < 2 { bad = bad + 1 }
    walked = walked + 1
  }
  if walked != s.length { bad = bad + 1 }
  return bad
}

function i32Set() {
  const s: Set<i32> = Set()
  const model: boolean[] = []
  for i in 0 until 64 { model.push(false) }
  let x = 11
  let bad = 0
  for n in 0 until 4000 {
    x = step(x)
    const k = x % 64
    const op = (x >> 8) % 7
    if op < 4 {
      s.add(k)
      model[k] = true
    } else if op < 6 {
      s.delete(k)
      model[k] = false
    } else if n % 500 == 0 {
      s.clear()
      for i in 0 until 64 { model[i] = false }
    }
    let live = 0
    for i in 0 until 64 {
      if model[i] { live = live + 1 }
      if s.has(i) != model[i] { bad = bad + 1 }
    }
    if s.length != live { bad = bad + 1 }
  }
  let sum = 0
  for k in s { sum = sum + k }
  let want = 0
  for i in 0 until 64 {
    if model[i] { want = want + i }
  }
  if sum != want { bad = bad + 1 }
  return bad
}

function i64Set() {
  const s: Set<i64> = Set()
  const model: boolean[] = []
  for i in 0 until 64 { model.push(false) }
  const base = 5000000000
  let x = 13
  let bad = 0
  for n in 0 until 4000 {
    x = step(x)
    const k = x % 64
    const op = (x >> 8) % 7
    const key = base + k
    if op < 4 {
      s.add(key)
      model[k] = true
    } else if op < 6 {
      s.delete(key)
      model[k] = false
    } else if n % 500 == 0 {
      s.clear()
      for i in 0 until 64 { model[i] = false }
    }
    let live = 0
    for i in 0 until 64 {
      if model[i] { live = live + 1 }
      if s.has(base + i) != model[i] { bad = bad + 1 }
    }
    if s.length != live { bad = bad + 1 }
  }
  return bad
}

print(strSet())
print(i32Set())
print(i64Set())
