// @run
// @log true
// @log false
// @log false
// @log true
// A record holding a Set and its twin holding the boolean map, each pinned through a generic
// and tested against both records: `is` tells them apart however the pin spells them.
type HS = { tags: Set<string> }
type HM = { tags: {[string]: boolean} }
function isHS<T>(u: T | null) { u is HS }
function isHM<T>(u: T | null) { u is HM }
const s: Set<string> = Set()
s.add("a")
const hs: HS = { tags: s }
const m: {[string]: boolean} = Map()
m.set("a", true)
const hm: HM = { tags: m }
print(isHS<HS>(hs))
print(isHM<HS>(hs))
print(isHS<HM>(hm))
print(isHM<HM>(hm))
