// @check
// @error unknown property `add` on {[string]: i32}
// @error unknown property `add` on {[i32]: string}
// @error unknown property `add` on {[<none>]: <none>}
// @error cannot infer a type for 'c' — add a type annotation
// THE REJECTED SIDE of `.add`'s value-typed gate — what makes the grant a rule
// rather than a hole. `.add(x)` is the membership insert, so it is admitted exactly
// where `boolean` is what the slot holds:
//
//   1/2. A map whose VALUE is not `boolean` has no `.add` at all, on either key rep.
//        `.add` would have to store `true` into a slot typed `i32`/`string`.
//   3.   A bare `Map()` whose value hole is still OPEN is not boolean-valued either,
//        so it keeps rejecting — `Set()` remains the way to write a set, and the
//        hole is NOT pinned to `boolean` by an `.add` the way `.set` pins it. (The
//        second diagnostic on that binding is the pre-existing uninferred-`Map()`
//        floor, unrelated to this gate.)
//
// The mirror direction — a `Set()` value must not gain the MAP surface — is pinned
// by `error-no-map-methods.vl` (`.set`) and `error-no-get.vl` (`.get`).
const a: {[string]: i32} = Map()
a.add("k")

const b: {[i32]: string} = Map()
b.add(1)

const c = Map()
c.add(1)
