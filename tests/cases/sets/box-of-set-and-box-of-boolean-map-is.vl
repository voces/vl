// @run
// @log true
// @log false
// @log false
// @log true
// @log false
// A generic record holding a Set, and one holding the boolean map, tested against both spellings:
// `is` tells them apart however the instance spells its type argument.
type Box<T> = { v: T | null }
function isSetBox<T>(b: Box<T>) { return b.v is Set<string> }
function isMapBox<T>(b: Box<T>) { return b.v is {[string]: boolean} }
const s: Set<string> = Set()
s.add("a")
const m: {[string]: boolean} = Map()
m.set("a", true)
const bs: Box<Set<string>> = { v: s }
const bm: Box<{[string]: boolean}> = { v: m }
print(isSetBox(bs))
print(isMapBox(bs))
print(isSetBox(bm))
print(isMapBox(bm))
const nb: Box<Set<string>> = { v: null }
print(isSetBox(nb))
