// @run
// @log true
// @log false
// @log true
// @log 2
// @log true
// D4350: a bare member literal passed to `add` on a literal-union-keyed set is taken at the key
// type, by alias or inline, as `has` and `delete` already took it.
type K = "a" | "b"
const s: Set<K> = Set()
s.add("a")
print(s.has("a"))
print(s.has("b"))
const t: Set<"x" | "y"> = Set()
t.add("y")
print(t.has("y"))
t.add("x")
print(t.length)
function addB(into: Set<K>) { into.add("b") }
addB(s)
print(s.has("b"))
