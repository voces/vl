// @log false
// `Set<T>` is its own type (owner ruling Q2, 2026-09-25), so its surface follows the TYPE: a set
// reached through a parameter, return, field, list element, capture or generic keeps
// `.values()` and `for x in s` yielding its ELEMENTS, never the membership booleans the rep
// stores (D2469). A bare `Set()` bound and read with `.values()` builds (D2470).
const s0 = Set()
s0.add("a")
print(s0.values().length)
print(s0.values()[0])

function viaParam(t: Set<string>) {
  for v in t.values() { print(v) }
}
viaParam(s0)

function mk(): Set<string> {
  const s = Set()
  s.add("p")
  s
}
print(mk().values()[0])

type H = { s: Set<string> }
const h: H = { s: Set() }
h.s.add("f")
print(h.s.values()[0])
print(h.s.has("f"))
for x in h.s { print(x) }

const xs: Set<string>[] = [Set(), Set()]
xs[1].add("e")
print(xs[1].values()[0])
print(xs[0].length)

const cap = Set()
cap.add("c")
const g = () => cap.values()[0]
print(g())

function id<T>(x: T): T { x }
const gs = Set()
gs.add("g1")
print(id(gs).values()[0])

const ints = Set<i32>()
ints.add(40)
ints.add(2)
let t = 0
for x in ints { t = t + x }
print(t + ints.values()[1] + ints.keys().length)
print(ints.has(40))
ints.delete(40)
print(ints.has(40))
