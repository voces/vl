// @run
// @log 9
// @log 30
// @log 30
// @log 30
// A Set and a boolean map over the same keys in one module that deletes: each keeps its own
// store and compaction, and the two agree on which keys are present.
import { toString } from "std:fmt"

const m: {[string]: boolean} = Map()
const s = Set()
for i in 0 until 300 {
  const k = "k" + (i % 40).toString()
  m[k] = i % 3 == 0
  s.add(k)
  if i % 4 == 1 { m.delete(k); s.delete(k) }
}
let mt = 0
for k, v in m {
  if v { mt = mt + 1 }
}
print(mt)
print(m.length)
print(s.length)
let both = 0
for k in s {
  if m.has(k) { both = both + 1 }
}
print(both)
