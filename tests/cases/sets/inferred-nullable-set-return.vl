// @run
// @log 0
// @log true
// @log 0
// @log true
// @log 0
// @log true
// An un-annotated function returning `null` or a `Set` infers `Set<K> | null`, the set struct's own
// nullable ref, at every element kind a `Set` takes (D16037).
function pickI(c: boolean) {
  if c { return null }
  const m: Set<i32> = Set()
  m.add(3)
  m
}
function pickL(c: boolean) {
  if c { return null }
  const m: Set<i64> = Set()
  m.add(3)
  m
}
function pickS(c: boolean) {
  if c { return null }
  const m: Set<string> = Set()
  m.add("s")
  m
}
const a = pickI(true)
if a == null { print(0) } else { print(1) }
const b = pickI(false)
if b != null { print(b.has(3)) }
const c = pickL(true)
if c == null { print(0) } else { print(1) }
const d = pickL(false)
if d != null { print(d.has(3)) }
const e = pickS(true)
if e == null { print(0) } else { print(1) }
const f = pickS(false)
if f != null { print(f.has("s")) }
