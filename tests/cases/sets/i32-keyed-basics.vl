// @run
// @log 3
// @log true
// @log false
// @log true
// @log 2
// @log 1
// @log 2
// @log 1
// An i32-keyed `Set` (B6a): the boolean-valued flavor of the i32-keyed map, with
// the Set surface only — `.add` / `.has` / `.delete` / `.length` / `.values()`
// and bare `for k in s`. A Set has NO `.keys()`, so the bare `for` IS the only
// iteration form and `.values()` yields its ELEMENTS (the keys), which is why the
// Set flavor carries its own shape sentinel (`-5`) rather than folding into the
// map one before the value question is asked.
const s: {[i32]: boolean} = Set()
s.add(1)
s.add(-5)
s.add(0)
print(s.length)   // 3
print(s.has(-5))  // true — a negative element
print(s.has(7))   // false
print(s.delete(-5))
print(s.length)   // 2

// bare `for k in s` over the live elements, in insertion order.
let acc = 0
for k in s {
  acc = acc + k
}
print(acc)        // 1 — {1, 0}

// `.values()` on a Set ARE its elements.
const vs = s.values()
print(vs.length)  // 2
print(vs[0])      // 1
