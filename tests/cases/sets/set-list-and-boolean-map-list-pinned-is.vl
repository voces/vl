// @run
// @log true
// @log false
// @log false
// @log true
// A list of Sets and a list of their boolean maps, each pinned through a generic and tested
// against both spellings: `is` tells them apart however the pin spells them.
function isSetList<T>(u: T | null) { u is Set<i32>[] }
function isMapList<T>(u: T | null) { u is {[i32]: boolean}[] }
const s: Set<i32> = Set()
s.add(1)
const ss = [s]
const m: {[i32]: boolean} = Map()
m.set(1, true)
const ms = [m]
print(isSetList<Set<i32>[]>(ss))
print(isMapList<Set<i32>[]>(ss))
print(isSetList<{[i32]: boolean}[]>(ms))
print(isMapList<{[i32]: boolean}[]>(ms))
