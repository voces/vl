// @check
// @error `.add` is a `Set` method — use `m[k] = true`, or make it a `Set<string>`
// `.add` is a Set method only (owner ruling, 2026-09-25): a `{[K]: boolean}` built by `Map()` is a
// plain map of booleans, and it inserts with `m[k] = true`.
const m: {[string]: boolean} = Map()
m.add("a")
