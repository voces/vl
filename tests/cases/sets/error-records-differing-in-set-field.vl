// @check
// @error arms `P` and `Q` share a field-name set and no literal-typed field distinguishes them
// Records that differ only in a `Set<K>` field against a same-rep map field are the same arm to
// the union box, so they need a discriminant field like any two same-named records.
type P = { a: Set<string> }
type Q = { a: {[string]: boolean} }
function f(x: P | Q) {
  if x is Q { print("Q") } else { print("P") }
}
const m: {[string]: boolean} = Map()
f({ a: m })
