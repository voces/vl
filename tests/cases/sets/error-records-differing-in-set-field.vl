// @check
// @error a union cannot hold both P and Q yet: field `a` is a Set in one and a map in the other
// Records that differ only in a `Set<K>` field against a same-rep map field are the same arm to
// the union box, so the pair is refused until the box can tell them apart (D4056).
type P = { a: Set<string> }
type Q = { a: {[string]: boolean} }
function f(x: P | Q) {
  if x is Q { print("Q") } else { print("P") }
}
const m: {[string]: boolean} = Map()
f({ a: m })
