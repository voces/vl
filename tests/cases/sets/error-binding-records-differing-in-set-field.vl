// @check
// @error arms `P` and `Q` share a field-name set and no literal-typed field distinguishes them
// The no-discriminant rule at a BINDING annotation, as at a parameter: a map in the `Q` arm
// used to answer `is P` (D2493).
type P = { a: Set<string> }
type Q = { a: {[string]: boolean} }
const m: {[string]: boolean} = Map()
const v: P | Q = { a: m }
if v is P { print("P") } else { print("Q") }
