// @check
// @error a union cannot hold both P and Q yet: field `a` is a Set in one and a map in the other
// The Set-or-map clash one field down, at a BINDING annotation as at a parameter: the two arms
// share one representation, so a map in the `Q` arm would answer `is P` (D2493, D4056).
type P = { a: Set<string> }
type Q = { a: {[string]: boolean} }
const m: {[string]: boolean} = Map()
const v: P | Q = { a: m }
if v is P { print("P") } else { print("Q") }
