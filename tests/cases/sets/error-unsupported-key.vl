// @check
// @error A f64-keyed Set isn't supported yet
// DIAGNOSTIC (B6a): the SET half of the unsupported-key message — it names the
// constructor in play (`initMapCtorName`), so a `Set()` reads "Set" where the
// map twin reads "Map". `string` and `i32` are the two keys the map rep hashes;
// an f64 key has neither a hash nor an equality the probe can use.
let s: {[f64]: boolean} = Set()
