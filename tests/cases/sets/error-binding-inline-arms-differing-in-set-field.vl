// @check
// @error a union cannot hold both {a: Set<string>} and {a: {[string]: boolean}} yet
// The inline-arm twin of `error-binding-records-differing-in-set-field.vl`.
const m: {[string]: boolean} = Map()
const v: { a: Set<string> } | { a: {[string]: boolean} } = { a: m }
if v is { a: Set<string> } { print("set") } else { print("map") }
