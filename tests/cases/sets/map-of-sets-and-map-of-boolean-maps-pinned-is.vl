// @run
// @log true
// @log false
// @log false
// @log true
// @log false
// A map of Sets and a map of boolean maps, each pinned through a copied generic parameter and
// tested against both spellings: `is` tells them apart however the pin spells them.
function viaCopy<T>(u: T | null) {
  const v = u
  v is {[string]: Set<i32>}
}
function viaMap<T>(u: T | null) {
  const v = u
  v is {[string]: {[i32]: boolean}}
}
const s: Set<i32> = Set()
s.add(2)
const ns: {[string]: Set<i32>} = Map()
ns.set("k", s)
const m: {[i32]: boolean} = Map()
m.set(2, true)
const nm: {[string]: {[i32]: boolean}} = Map()
nm.set("k", m)
print(viaCopy<{[string]: Set<i32>}>(ns))
print(viaMap<{[string]: Set<i32>}>(ns))
print(viaCopy<{[string]: {[i32]: boolean}}>(nm))
print(viaMap<{[string]: {[i32]: boolean}}>(nm))
print(viaCopy<{[string]: Set<i32>}>(null))
