// @run
// @log 0
// @log false
// @log 0
// @log 1
// @log true
// @log false
// @log true
// @log false
// @log 1
// `s.clear()` empties a set in place; a refill afterwards behaves as on a fresh set.
const s: Set<string> = Set()
s.add("a")
s.add("b")
s.add("c")
s.clear()
print(s.length)
print(s.has("a"))
let n = 0
for v in s { n = n + 1 }
print(n)
s.add("b")
print(s.length)
print(s.has("b"))
print(s.has("c"))

const t: Set<i32> = Set()
t.add(1)
t.add(17)
t.clear()
t.add(17)
print(t.has(17))
print(t.has(1))
print(t.length)
