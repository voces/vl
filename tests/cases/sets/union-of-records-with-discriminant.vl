// @run
// @log set
// @log map
// The advice the set/map union refusal gives, taken: each value wrapped in a record with a
// literal-typed discriminant, which `is` reads instead of the shared map struct (D2493).
type P = { kind: "set", a: Set<string> }
type Q = { kind: "map", a: {[string]: boolean} }
function f(x: P | Q) {
  if x is Q { print("map") } else { print("set") }
}
const s: Set<string> = Set()
const m: {[string]: boolean} = Map()
f({ kind: "set", a: s })
f({ kind: "map", a: m })
