// @check
// @error a union cannot hold both Set<string> and {[string]: boolean} yet
// A type argument that makes a set meet a same-rep map in a generic union is refused at the call
// (D2493).
function wrap<T>(x: T): T | {[string]: boolean} { x }
const s: Set<string> = Set()
const w = wrap(s)
print(w is Set<string>)
