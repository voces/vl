// @run
// @log false
// @log true
// @log false
// @log true
// @log true
// @log true
// @log true
// A Set as the type argument of a generic record with a nullable field (D9991). The record's
// row is typed from the instantiation's name, where a Set is spelled as its boolean-valued
// map, so the literal must find that row from the Set it holds and not build a second one.
type Box<T> = { v: T | null }

function isNull<T>(b: Box<T>) { print(b.v == null) }

const s: Set<string> = Set()
s.add("a")
const bs: Box<Set<string>> = { v: s }
isNull(bs)
const w = bs.v
if w != null { print(w.has("a")) }

const si: Set<i32> = Set()
si.add(3)
const bi: Box<Set<i32>> = { v: si }
print(bi.v == null)
const wi = bi.v
if wi != null { print(wi.has(3)) }

// The Set and its map twin through one generic: the rep is shared, so both are a Set.
function isSet<T>(b: Box<T>) { print(b.v is Set<string>) }
const ms: {[string]: boolean} = Map()
const bm: Box<{[string]: boolean}> = { v: ms }
isSet(bm)
const nb: Box<Set<string>> = { v: null }
isNull(nb)
isSet(bs)
