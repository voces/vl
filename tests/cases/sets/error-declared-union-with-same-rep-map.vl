// @check
// @error a union cannot hold both Set<string> and {[string]: boolean} yet
// A declared union reaches the set/same-rep-map refusal too, through aliases of its members:
// `is A` would answer for the map (D2493).
type A = Set<string>
type Bm = {[string]: boolean}
type U = A | Bm
function f(x: U) {
  if x is A { print("set") } else { print("map") }
}
const m: {[string]: boolean} = Map()
f(m)
