// @run
// @log 2
// @log true
// @log 2
// @log 5
// @log 7
// @log 2
// @log 2
// @log 1
// @log 2
// @log 2
// @log 2
// @log 2
// @log 3
// CAPABILITY (B6a): `.add(x)` reaches a `Set<T>` in every position — a struct FIELD, an
// inline-shape field, a union ARM's field, a nested field, a PARAM, a RETURN, an ARRAY
// ELEMENT and a global — not only a binding initialized by `Set()`. `Set<T>` is its own type
// at every spelling, so the insert is a property of the type, never of how the binding was
// written. The Set surface stays sealed: `.set`/`.get` and indexing are refused
// (`error-no-map-methods.vl`, `error-no-get.vl`).

// A DECLARED struct field — direct and bound receivers.
type S = { seen: Set<i32> }
const s: S = { seen: Set() }
s.seen.add(5)
s.seen.add(7)
s.seen.add(5) // duplicate — no-op
print(s.seen.length) // 2
print(s.seen.has(7)) // true
const sb = s.seen
sb.add(5)
print(sb.length) // 2 — the bound receiver is the same set
for k in s.seen {
  print(k) // 5, then 7 — insertion order
}

// An INLINE-SHAPE field, string-keyed.
const t: { seen: Set<string> } = { seen: Set() }
t.seen.add("a")
t.seen.add("b")
print(t.seen.length) // 2

// A DECLARED UNION ARM's field, reached through an `is` narrow.
type A = { seen: Set<i32> }
type B = { n: i32 }
type U = A | B
const u: U = { seen: Set() }
if u is A {
  u.seen.add(9)
  u.seen.add(10)
  print(u.seen.length) // 2
  u.seen.delete(9)
  print(u.seen.length) // 1
}

// An INLINE UNION ARM's field — the whole `{seen: {[K]: boolean}} | i32` spelling is
// one `TypeRef`, so it is the arm that needed its own collect gate in #1289.
const v: { seen: Set<string> } | i32 = { seen: Set() }
if v is { seen: Set<string> } {
  v.seen.add("p")
  v.seen.add("q")
  print(v.seen.length) // 2
}

// A NESTED field (`n.a.seen`).
type I = { seen: Set<string> }
type N = { a: I }
const nn: N = { a: { seen: Set() } }
nn.a.seen.add("x")
nn.a.seen.add("y")
print(nn.a.seen.length) // 2

// A PARAM annotation, and an ARRAY ELEMENT.
function fill(p: Set<i32>) {
  p.add(1)
  p.add(2)
  print(p.length) // 2
}
const seed: Set<i32> = Set()
fill(seed)

const xs: Set<i32>[] = [Set()]
xs[0].add(5)
xs[0].add(7)
print(xs[0].length) // 2

// A RETURN boundary. `mk`'s local IS a `Set()`; what comes back is typed by the
// RETURN annotation, so on master this binding had no `.add` either.
function mk(): Set<string> {
  const inner: Set<string> = Set()
  inner.add("q")
  return inner
}
const back = mk()
back.add("r")
back.add("s")
print(back.length) // 3
