// @run
// @log set
// @log map
// @log set
// @log list
// A set beside a member with its OWN representation stays a legal union and discriminates: a
// string-valued map takes its own value slot, and a list is not a map (D2493 refuses only the
// pairs that share the map struct).
function f(x: Set<string> | {[string]: string}) {
  if x is Set<string> { print("set") } else { print("map") }
}
const s: Set<string> = Set()
const m: {[string]: string} = Map()
f(s)
f(m)
function g(x: Set<string> | string[]) {
  if x is Set<string> { print("set") } else { print("list") }
}
g(s)
g(["a"])
