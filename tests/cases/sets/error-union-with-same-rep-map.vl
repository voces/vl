// @check
// @error a union cannot hold both Set<string> and {[string]: boolean} yet
// A `Set<K>` and a map whose value is one i32 cell lower to one map struct, so a union box
// could not tell which it holds and `is` would answer for the wrong member (D2493). Until they
// get distinct representations the union is refused at check.
function f(x: Set<string> | {[string]: boolean} | null) { print(x == null) }
f(null)
