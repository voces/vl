// @log true
// @log 0.5
// Q58 position sweep: a `K | null` or `string | null` read narrowed to its null arm, delivered to a
// scalar union destination, is that box's own null with the storage left unread: an argument, a
// `let`, a record field, a list element, an assignment's value and a return.
type K = "a" | "b"
function pk(n: i32): K | null {
  if n == 0 { return null }
  return "a"
}
function ps(n: i32): string | null {
  if n == 0 { return null }
  return "x"
}
function takeI(x: i32 | null) { print(x == null) }
function atom(n: i32): i32 | null {
  const k = pk(n)
  if k is K { return 1 }
  takeI(k)
  const z: i32 | null = k
  print(z ?? 9)
  const r: { x: f64 | null } = { x: k }
  print(r.x == null)
  const xs: (i32 | null)[] = [k]
  print(xs[0] == null)
  let w: i32 | null = 5
  w = k
  print(w == null)
  return k
}
function str(n: i32): f64 | null {
  const s = ps(n)
  if s is string { return 0.5 }
  takeI(s)
  const z: i32 | null = s
  print(z ?? 9)
  return s
}
print(atom(0) == null)
print(atom(1))
print(str(0) == null)
print(str(1))
