// @run
// A `print` of a `null`-typed argument runs the argument for its effect, then prints `null`, from
// each source of the unit: a local, a module binding, a bare literal, a parameter, a generic
// pinned at `null`, a record field, a call (whose effect prints first), an assignment, and a `??`
// of two units.
type Box = { n: null }
let hits = 0
function noisy(): null {
  hits = hits + 1
  print("effect")
  return null
}
function fromLocal() {
  const u = null
  print(u)
}
const modNull = null
function fromModule() { print(modNull) }
function fromLiteral() { print(null) }
function fromParam(x: null) { print(x) }
function fromGeneric<T>(x: T) { print(x) }
function fromField(b: Box) { print(b.n) }
function fromCall() { print(noisy()) }
function fromAssign() {
  let u = null
  print(u = null)
}
function fromCoalesce(a: null, b: null) { print(a ?? b) }
fromLocal()
fromModule()
fromLiteral()
fromParam(null)
fromGeneric(null)
fromField({ n: null })
fromCall()
fromAssign()
fromCoalesce(null, null)
print(hits)
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log effect
// @log null
// @log null
// @log null
// @log 1
