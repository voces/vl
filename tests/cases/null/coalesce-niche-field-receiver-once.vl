// @run
// @log b
// @log 1
// @log a
// @log 2
// @log b
// @log 3
// @log true
// @log 4
// @log b
// @log 4
// A `??` over a `K | null` or `boolean | null` field evaluates an effectful receiver once,
// present or null; a field of a local still reads in place.
type R = { k: "a" | "b" | null, f: boolean | null }
type O = { m: () => R }
let calls = 0
function f(): R {
  calls = calls + 1
  return { k: "b", f: true }
}
function g(): R {
  calls = calls + 1
  return { k: null, f: null }
}
print(f().k ?? "a")
print(calls)
print(g().k ?? "a")
print(calls)
const o: O = { m: f }
print(o.m().k ?? "a")
print(calls)
print(f().f ?? false)
print(calls)
const r = f()
calls = calls - 1
print(r.k ?? "a")
print(calls)
