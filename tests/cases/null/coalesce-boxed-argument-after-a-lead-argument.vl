// @run
// @log b1bool true
// @log b1bool false
// @log b2/bool true
// @log b2/bool true
// @log l1str b
// @log l1str a
// @log l2/str b
// @log l2/str b
// @log s1str s
// @log default
// @log s1str d
// @log s2/str s
// @log default
// @log s2/str d
// @log r1rec 4
// @log r1rec 9
// @log r2/rec 4
// @log r2/rec 8
// The same boxed `??` as a union argument after another argument, directly and inside a nested
// call: the earlier argument is written before the box's tag, and the default runs only on null.
function show(v: i32 | boolean) {
  if v is i32 { return "int \{v}" }
  return "bool \{v}"
}
function showS(v: i32 | string) {
  if v is i32 { return "int \{v}" }
  return "str \{v}"
}
function showR(v: i32 | { x: i32 }) {
  if v is i32 { return "int \{v}" }
  return "rec \{v.x}"
}
function dflt() {
  print("default")
  return "d"
}
function two(a: string, b: string) { return a + "/" + b }
function pairB(f: string, v: i32 | boolean) { return f + show(v) }
function pairS(f: string, v: i32 | string) { return f + showS(v) }
function pairR(f: string, v: i32 | { x: i32 }) { return f + showR(v) }
function b1(f: string, rc: boolean | null) { return pairB(f, rc ?? false) }
function b2(f: string, rc: boolean | null) { return two(f, show(rc ?? true)) }
function l1(f: string, k: "a" | "b" | null) { return pairS(f, k ?? "a") }
function l2(f: string, k: "a" | "b" | null) { return two(f, showS(k ?? "b")) }
function s1(f: string, s: string | null) { return pairS(f, s ?? dflt()) }
function s2(f: string, s: string | null) { return two(f, showS(s ?? dflt())) }
function r1(f: string, r: { x: i32 } | null) { return pairR(f, r ?? { x: 9 }) }
function r2(f: string, r: { x: i32 } | null) {
  return two(f, showR(r ?? { x: 8 }))
}
print(b1("b1", true))
print(b1("b1", null))
print(b2("b2", true))
print(b2("b2", null))
print(l1("l1", "b"))
print(l1("l1", null))
print(l2("l2", "b"))
print(l2("l2", null))
print(s1("s1", "s"))
print(s1("s1", null))
print(s2("s2", "s"))
print(s2("s2", null))
print(r1("r1", { x: 4 }))
print(r1("r1", null))
print(r2("r2", { x: 4 }))
print(r2("r2", null))
