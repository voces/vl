// @run
// @hint redundant type annotation: `r` is inferred as `"a" | "b" | i32` — remove it to lean on inference
// @log b
// @log 1
// @log a
// @log 7
// @log false
// @log 2.5
// @log a
// @log 2
// @log a
// @log b
// @log 9
// @log 12
// A `??` over a literal union's `K | null` niche a call yields, joined with a number, boolean or
// float default, in a function and at module level, in a chain and an annotated binding: the
// call runs once, and the count shows it.
type K = "a" | "b"
let n = 0
function gk(which: i32): K | null {
  n = n + 1
  if which == 0 { return null }
  if which == 1 { return "a" }
  return "b"
}
function f() {
  print(gk(2) ?? 1)
  print(n)
  print(gk(1) ?? 0)
  print(gk(0) ?? 7)
  print(gk(0) ?? false)
  print(gk(0) ?? 2.5)
  print(gk(0) ?? gk(1) ?? 2)
  print(gk(0) ?? gk(0) ?? 2)
  const r: K | i32 = gk(1) ?? 0
  print(r)
}
f()
print(gk(2) ?? gk(1) ?? 9)
print(gk(0) ?? 9)
print(n)
