// @run
// @log d
// @log null
// @log d
// @log null
// @log d
// @log 7
// @log z
// @log 9
// @log d
// @log null
// @log 4
// A `??` over an assignment of `null` into a local, a field, a never-filled binding a call writes
// and a number cell, in a chain, a binding and at module level: each store runs, and the default
// is the value, run once each (the count shows it).
let cnt = 0
function dflt() {
  cnt = cnt + 1
  return "d"
}
function same<T>(x: T): T { return x }
function f() {
  let n: string | null = "x"
  print((n = null) ?? dflt())
  print(n ?? "null")
  const o: { f: string | null } = { f: "x" }
  print((o.f = null) ?? dflt())
  print(o.f ?? "null")
  let h = null
  print((h = same(null)) ?? dflt())
  let k: i32 | null = 3
  print((k = null) ?? 7)
  let a: string | null = "x"
  let b: string | null = "y"
  print((a = null) ?? (b = null) ?? "z")
  const z = (k = null) ?? 9
  print(z)
}
f()
let m: string | null = "x"
print((m = null) ?? dflt())
print(m ?? "null")
print(cnt)
