// @run
// @log true
// @log gm
// @log false
// @log gm
// @log false
// @log gn
// @log ne
// @log gn
// @log false
// @log gm
// @log false
// @log true
// @log true
// @log true
// @log true
// @log gn
// A `null` test of a name or call against a right side with an effect the test must not see (a
// call, a store to the tested name): the test runs first, then the right side, each once and in
// source order, as the trace shows. Printed, bound, a condition, negated, returned.
let trace = ""
type U = { id: i32, tags: null }
function mk(): U {
  trace = trace + "m"
  return { id: 2, tags: null }
}
function g(k: i32): string | null {
  trace = trace + "g"
  return if k == 0 { null } else { "x" }
}
function nothing() {
  trace = trace + "n"
  return null
}
function printed(k: i32) {
  print(g(k) == mk().tags)
  print(trace)
}
function bound(k: i32) {
  const t = g(k) != nothing()
  print(t)
  print(trace)
}
function cond(k: i32) {
  if g(k) == nothing() { print("eq") } else { print("ne") }
  print(trace)
}
function arg(k: i32) {
  print(!(g(k) == mk().tags))
  print(trace)
}
function selfStore(z: i32 | null) {
  let w = z
  print(w == (w = null))
  print(w == null)
}
function returned(k: i32) { return g(k) == nothing() }
trace = ""
printed(0)
trace = ""
printed(1)
trace = ""
bound(0)
trace = ""
cond(1)
trace = ""
arg(0)
selfStore(3) // false true
selfStore(null) // true true
trace = ""
print(returned(0)) // true
print(trace)
