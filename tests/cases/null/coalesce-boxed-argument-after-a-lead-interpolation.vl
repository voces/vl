// @run
// @log a (bool true)
// @log b (bool false)
// @log c (str b)
// @log d (str a)
// @log e (str s)
// @log default
// @log f (str d)
// @log g (rec 4)
// @log h (rec 9)
// The same boxed `??` inside an interpolation's part: the earlier parts are written before the
// box's tag, and the default runs only on null.
function show(v: i32 | boolean): string {
  if v is i32 { return "int \{v}" }
  return "bool \{v}"
}
function showS(v: i32 | string): string {
  if v is i32 { return "int \{v}" }
  return "str \{v}"
}
function showR(v: i32 | { x: i32 }): string {
  if v is i32 { return "int \{v}" }
  return "rec \{v.x}"
}
function dflt(): string {
  print("default")
  return "d"
}
function b1(f: string, rc: boolean | null): string {
  return "\{f} (\{show(rc ?? false)})"
}
function l1(f: string, k: "a" | "b" | null): string {
  return "\{f} (\{showS(k ?? "a")})"
}
function s1(f: string, s: string | null): string {
  return "\{f} (\{showS(s ?? dflt())})"
}
function r1(f: string, r: { x: i32 } | null): string {
  return "\{f} (\{showR(r ?? { x: 9 })})"
}
print(b1("a", true))
print(b1("b", null))
print(l1("c", "b"))
print(l1("d", null))
print(s1("e", "s"))
print(s1("f", null))
print(r1("g", { x: 4 }))
print(r1("h", null))
