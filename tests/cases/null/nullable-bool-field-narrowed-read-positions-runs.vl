// @run
// @hint redundant type annotation: `ret` is inferred as `boolean` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `b` is inferred as `boolean` — remove it to lean on inference
// @log true
// @log true
// @log true
// @log true
// @log yes
// @log true
// @log false
// @log true
// @log htrue
// @log true
// @log true
// @log true
// @log false
// @log false
// @log false
// @log false
// @log no
// @log false
// @log true
// @log false
// @log hfalse
// @log false
// @log false
// @log false
// @log false
// A `boolean | null` field narrowed by `is boolean` or `!= null`, read in each position: the read is
// the i32 its niche holds, as legacy reads it. The null object takes no narrowed arm.
type O = { f: boolean | null, n: i32 }
function sink(b: boolean) { print(b) }
function id<T>(x: T): T { return x }
function pr(o: O) {
  if o.f is boolean { print(o.f) }
}
function ret(o: O): boolean {
  if o.f is boolean { return o.f }
  return false
}
function arg(o: O) {
  if o.f is boolean { sink(o.f) }
}
function gen(o: O) {
  if o.f is boolean { print(id(o.f)) }
}
function cond(o: O) {
  if o.f is boolean {
    if o.f { print("yes") } else { print("no") }
  }
}
function andOp(o: O) {
  if o.f is boolean { print(o.f && o.n > 0) }
}
function notOp(o: O) {
  if o.f is boolean { print(!o.f) }
}
function letB(o: O) {
  if o.f is boolean {
    const b: boolean = o.f
    print(b)
  }
}
function hole(o: O) {
  if o.f is boolean { print("h\{o.f}") }
}
function store(o: O) {
  if o.f is boolean {
    const p: { b: boolean } = { b: o.f }
    print(p.b)
  }
}
function eqLit(o: O) {
  if o.f is boolean { print(o.f == true) }
}
function nn(o: O) {
  if o.f != null { print(o.f) }
}
const t: O = { f: true, n: 1 }
const fz: O = { f: false, n: 0 }
const z: O = { f: null, n: 2 }
for o in [t, fz, z] {
  pr(o)
  print(ret(o))
  arg(o)
  gen(o)
  cond(o)
  andOp(o)
  notOp(o)
  letB(o)
  hole(o)
  store(o)
  eqLit(o)
  nn(o)
}
