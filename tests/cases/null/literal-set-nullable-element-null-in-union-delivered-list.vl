// An all-`null` list literal of a literal set's `| null` element, its null read back: delivered
// into a union whose list member it is (D17673), at top level and in a function, and as a plain
// list. Each element is the niche's own null, not the i32 sentinel that reads as an atom.
const r: ("a" | "b" | null)[] | boolean = [null]
if r is ("a" | "b" | null)[] {
  print(r[0] == null)
  print(r[0] ?? "none")
  r.push("a")
  print(r[1] ?? "none")
}
function f() {
  const u: ("a" | "b" | null)[] | boolean = [null]
  if u is ("a" | "b" | null)[] { print(u[0] ?? "none") }
  const t: ("x" | "y" | "z" | null)[] = [null, null]
  print(t[1] ?? "none")
}
f()
const s: ("a" | "b" | null)[] = [null]
print(s[0] ?? "none")
