// @run
// @log false
// @log true
// @log true
// @log false
// @log false
// @log ne
// @log eq
// @log true
// @log false
// @log false
// Q58 position sweep: a nullable name compared with an assignment of `null` on the right, its store
// written ahead of the name's read where that reads alike (another name, an effect-free value): a
// call's argument, a `const`, an `if`, a global target, a name's value; `sameName` writes the
// tested name and stays legacy's.
let g = null
function asPrint(z: i32 | null) {
  let n = null
  print(z == (n = null))
  print(z != (n = null))
}
function asConst(z: string | null) {
  let n = null
  const c = z == (n = null)
  print(c)
}
function asIf(z: i32 | null) {
  let n = null
  if z != (n = null) { print("ne") } else { print("eq") }
}
function asGlobal(z: i32 | null) { print(z == (g = null)) }
function fromName(z: i32 | null) {
  const k = null
  let n = null
  print(z == (n = k))
}
function sameName(z: i32 | null) {
  let w = z
  print(w == (w = null))
}
asPrint(1)
asPrint(null)
asConst("s")
asIf(2)
asIf(null)
asGlobal(null)
fromName(5)
sameName(4)
