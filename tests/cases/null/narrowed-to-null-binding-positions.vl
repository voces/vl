// @run
// @log none
// @log none
// @log none!
// @log none
// A name narrowed to `null` (the `else` of an `is` test) bound to a fresh name, whose storage
// read is that null: a module global and a local, each binding then used in several positions.
type Rec = { x: i32 }
const q: Rec | null = null
function show(r: Rec | null) { return if r == null { "none" } else { "x" } }
if q is Rec {
  print(q.x)
} else {
  const z = q
  print(show(z))
}
function inFn() {
  if q is Rec { return "rec" }
  const z = q
  return show(z)
}
function local(r: Rec | null) {
  if r is Rec { return "rec" }
  const z = r
  return show(z) + "!"
}
function nested(r: Rec | null) {
  if r is Rec { return "rec" }
  const z = r
  const w = z
  return show(w)
}
print(inFn())
print(local(null))
print(nested(null))
