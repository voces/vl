// @log true
// An assignment of `null` to a never-filled `let x = null` yields the `null` unit: printed,
// null-tested either way, in a condition, as an argument, in `&&`/`||` chains, which keep their
// order, and under `??`; and a binding a later write fills, before and after that write (D17120).
let g = null
function show(x: null) { print(x) }
function isNul(x: string | null) { return x == null }
function t(): boolean {
  print("t")
  return true
}
function body() {
  let n = null
  print(n = null)
  print((n = null) == null)
  print((n = null) != null)
  if (n = null) == null { print(1) }
  show(n = null)
  print(isNul(n = null))
  print((n = null) != null && t())
  print((n = null) == null && t())
  print((n = null) != null || t())
  const b: boolean | null = (n = null) != null
  print(b ?? true)
}
function before() {
  let k = null
  print(k = null)
  print((k = null) == null)
  k = 5
  print(k)
}
function after() {
  let k = null
  k = 5
  print(k = null)
  print((k = null) == null)
  print(k)
}
body()
before()
after()
print(g = null)
print((g = null) == null)
