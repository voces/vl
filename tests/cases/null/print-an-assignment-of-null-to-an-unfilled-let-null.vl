// @run
// @log null
// @log true
// @log false
// @log 1
// @log null
// @log true
// @log null
// @log 5
// @log null
// @log true
// An assignment of `null` to a never-filled `let x = null` yields the `null` unit: printed,
// null-tested either way, in a condition and as an argument; and a binding a later write fills
// (D17120).
let g = null
function show(x: null) { print(x) }
function isNul(x: string | null) { return x == null }
function body() {
  let n = null
  print(n = null)
  print((n = null) == null)
  print((n = null) != null)
  if (n = null) == null { print(1) }
  show(n = null)
  print(isNul(n = null))
}
function later() {
  let k = null
  print(k = null)
  k = 5
  print(k)
}
body()
later()
print(g = null)
print((g = null) == null)
