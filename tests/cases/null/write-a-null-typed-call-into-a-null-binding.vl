// @log null
// A `null`-returning call written into a `null` binding, annotated or a captured never-filled
// `let x = null`, yields the `null` it stored wherever the write is read as a value, and runs its
// call once, before the rest of the expression (D17303, D17424).
function same<T>(v: T): T {
  return v
}
function eff(): null {
  print("e")
  return null
}
function effB(): null {
  print("b")
  return null
}
function id(v: null): null {
  return v
}
function annotatedPrint() {
  let x: null = null
  print(x = same(null))
  print(x = eff())
}
function annotatedCompare() {
  let x: null = null
  print((x = eff()) == effB())
  print((x = same(null)) != null)
}
function capturedValue() {
  let x = null
  const g = () => x
  print(x = eff())
  print(id(x = same(null)))
  const z = (x = eff())
  print(z)
  print(g())
}
function capturedInClosure() {
  let x = null
  const g = () => {
    print(x = same(null))
    print((x = eff()) == effB())
  }
  g()
  print(x)
}
function annotatedCaptured() {
  let x: null = null
  const g = () => x
  print((x = eff()) == effB())
  print(g())
}
annotatedPrint()
annotatedCompare()
capturedValue()
capturedInClosure()
annotatedCaptured()
