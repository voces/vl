// @run
// @log abool true
// @log bbool false
// @log cstr b
// @log dstr a
// @log estr s
// @log default
// @log fstr d
// @log grec 4
// @log hrec 9
// A `??` over a niche or a nullable reference, boxed into a union argument inside a string `+`:
// the `+`'s earlier piece is written before the box's tag, and the default runs only on null.
function show(v: i32 | boolean) {
  if v is i32 { return "int \{v}" }
  return "bool \{v}"
}
function showS(v: i32 | string) {
  if v is i32 { return "int \{v}" }
  return "str \{v}"
}
function showR(v: i32 | { x: i32 }) {
  if v is i32 { return "int \{v}" }
  return "rec \{v.x}"
}
function dflt() {
  print("default")
  return "d"
}
function b1(f: string, rc: boolean | null) { return f + show(rc ?? false) }
function l1(f: string, k: "a" | "b" | null) { return f + showS(k ?? "a") }
function s1(f: string, s: string | null) { return f + showS(s ?? dflt()) }
function r1(f: string, r: { x: i32 } | null) { return f + showR(r ?? { x: 9 }) }
print(b1("a", true))
print(b1("b", null))
print(l1("c", "b"))
print(l1("d", null))
print(s1("e", "s"))
print(s1("f", null))
print(r1("g", { x: 4 }))
print(r1("h", null))
