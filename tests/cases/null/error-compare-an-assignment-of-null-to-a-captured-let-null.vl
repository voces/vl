// @emit-error emitProgram: an assignment used as a value whose type is not its target's has no value lowering
// A closure's assignment of `null` to a captured never-filled `let x = null`, compared with a
// nullable, stays refused as the print of one does (D17302).
function body(z: i32 | null) {
  let n = null
  const f = () => {
    print((n = null) == z)
  }
  f()
}
body(3)
