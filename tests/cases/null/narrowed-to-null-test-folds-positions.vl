// @run
// @log true
// @log s
// @log none
// @log true
// @log true
// @log true
// Q58 position sweep: a `string | null` or `boolean | null` local narrowed to `null` by an `is`
// else arm, tested against `null`: legacy's folded constant (`nulfold`), the operand unread, in a
// print, an `else if`, a `const`, a return and an `&&` operand.
function ps(k: i32): string | null {
  if k == 0 { return null }
  return "s"
}
function pb(k: i32): boolean | null {
  if k == 0 { return null }
  return true
}
function asPrint(k: i32) {
  const b = ps(k)
  if b is string { print(b) } else { print(b == null) }
}
function asIf(k: i32) {
  const b = pb(k)
  if b is boolean { print(b) }
  else if b != null { print("set") }
  else { print("none") }
}
function asConst(k: i32) {
  const b = ps(k)
  if b is string {
    print(b)
  } else {
    const c = b == null
    print(c)
  }
}
function asRet(k: i32) {
  const b = pb(k)
  if b is boolean { return false }
  return b == null
}
function asAnd(k: i32) {
  const b = ps(k)
  if b is string { print(b) } else { print(k == 0 && b == null) }
}
asPrint(0)
asPrint(1)
asIf(0)
asConst(0)
print(asRet(0))
asAnd(0)
