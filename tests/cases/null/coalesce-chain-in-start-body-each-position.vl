// @run
// @log 102
// @log d
// @log 103
// @log <s>
// @log [4]
// @log 5
// @log 6
// @log 7
// @log 8
// A `??` chain `a ?? b ?? d` in the start body (top-level code), minted before the start is
// claimed, in each position: a scalar and a union argument, a nested argument, a concat operand,
// an initializer, a `??` operand and a record field; an interpolation hole's and an `if` arm's,
// whose start-level joins are another class's, in functions.
type R = { v: i32 }
function nn(k: i32): i32 | null {
  if k > 0 { return k } else { return null }
}
function ns(k: i32): string | null {
  if k > 0 { return "s" } else { return null }
}
function plus(n: i32) { return n + 100 }
function show(u: i32 | string) {
  if u is string { return u } else { return "n" }
}
function id(n: i32) { return n }
function hole() { return "[\{nn(4) ?? nn(0) ?? 1}]" }
function arm(c: boolean) { return if c { nn(0) ?? nn(6) ?? 0 } else { 0 } }
print(plus(nn(0) ?? nn(2) ?? 9))
print(show(ns(0) ?? ns(0) ?? "d"))
print(plus(id(nn(0) ?? nn(0) ?? 3)))
print("<" + (ns(1) ?? ns(0) ?? "x") + ">")
print(hole())
const a = nn(0) ?? nn(0) ?? 5
print(a)
print(arm(true))
print((nn(0) ?? nn(0) ?? null) ?? 7)
const r: R = { v: nn(8) ?? nn(0) ?? 0 }
print(r.v)
