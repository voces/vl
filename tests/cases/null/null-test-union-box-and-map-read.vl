// @run
// @log 1
// @log 0
// @log 0
// @log 1
// @log 1
// @log 0
// @log 0
// @log 1
// A `== null`/`!= null` over a `U | null` union box answers by the box's null tag; over a
// scalar-valued map read, by the map's has probe.
type A = { a: i32 }
type B = { b: string }
function pick(k: i32): A | B | null {
  return if k == 1 { { a: 1 } } else if k == 2 { { b: "x" } } else { null }
}
function isNul(k: i32) { return if pick(k) == null { 1 } else { 0 } }
function notNul(k: i32) {
  const u = pick(k)
  return if u != null { 1 } else { 0 }
}
const m: {[string]: i32} = Map()
m["here"] = 4
function miss(k: string) { return if m[k] == null { 1 } else { 0 } }
function hit(k: string) {
  const l: {[string]: i32} = Map()
  l["here"] = 5
  return if l[k] != null { 1 } else { 0 }
}
print(isNul(3))
print(isNul(1))
print(notNul(3))
print(notNul(2))
print(miss("gone"))
print(miss("here"))
print(hit("gone"))
print(hit("here"))
