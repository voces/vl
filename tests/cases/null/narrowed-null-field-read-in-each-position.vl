// @run
// @log TTF
// @log FFT
// @log TFT
// @log true
// @log n
// @log s
// A field the checker narrowed to `null` is read for its effect and is the `null` unit: compared on
// either side with another nullable, passed, returned and printed.
type O = { f: boolean | null, g: string | null }
function c(v: boolean) { return if v { "T" } else { "F" } }
function isNul(x: i32 | null) { return x == null }
function back(o: O): string | null {
  if o.g is string { return "s" }
  return o.g
}
function cmp(o: O, zi: i32 | null) {
  if o.f is boolean { return "b" }
  return c(o.f == zi) + c(zi == o.f) + c(o.f != zi)
}
function mixed(o: O, zs: string | null, zi: i32 | null) {
  if o.f is boolean || o.g is string { return "b" }
  return c(zs == o.f) + c(o.g == zi) + c(zi != o.g)
}
const o: O = { f: null, g: null }
print(cmp(o, null))
print(cmp(o, 7))
print(mixed(o, null, 3))
if o.f is boolean { print("b") } else { print(isNul(o.f)) }
print(back(o) ?? "n")
print(back({ f: null, g: "x" }) ?? "n")
