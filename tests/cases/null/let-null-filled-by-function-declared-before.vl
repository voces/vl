// @run
// @log 5
// @log 5
// @log hi
// @log 7
// @log 3
// An un-annotated module `let x = null` filled only by a function declared above it takes the
// written type: the function's write fills the binding's own hole (D16955).
function take() {
  x = 5
  print(x)
}
function takeS() { s = "hi" }
function show() { print(y ?? 7) }
let x = null
let s = null
let y = null
take()
print(x ?? 0)
takeS()
print(s ?? "none")
show()
y = 3
show()
