// @run
// @log null
// @log null
// @log null
// @log null
// @log null
// @hint redundant type annotation: `x` is inferred as `null`
// @hint redundant type annotation: `g` is inferred as `null`
// An assignment whose right side is a call yielding the `null` unit (a generic instance at
// `T = null`, a `null`-returning function) prints as `null`, in a function and at the top level.
// The cells are annotated `null`: the inferred spelling already printed.
function same<T>(v: T): T { return v }
function none(): null { return null }
function f() {
  let x: null = null
  print(x = same(null))
  print(x = none())
  const y = (x = same(null))
  print(y)
}
f()
let g: null = null
print(g = same(null))
print(g = none())
