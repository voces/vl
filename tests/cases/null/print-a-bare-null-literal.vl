// @run
// @log null
// @log null
// @log null
// @log null
// @log 3
// @log null
// @log 4
// `print` of a bare `null` literal prints `null`: plain, parenthesised, in a function body, and in
// the null arm beside an `i32 | null` or a record `R | null` operand.
type R = { a: i32 }
print(null)
print((null))
function show() { print(null) }
show()
function num(x: i32 | null) { if x == null { print(null) } else { print(x) } }
num(null)
num(3)
function rec(x: R | null) { if x == null { print(null) } else { print(x.a) } }
rec(null)
rec({ a: 4 })
