// @run
// @log bool i32 TTFFFT
// @log bool str TTFFFT
// @log bool f64 TTFFFT
// @log bool wide TTFFFT
// @log bool rec TTFFFT
// @log bool list TTFFFT
// @log str i32 TTFFFT
// @log str bool TTFFFT
// @log str wide TTFFFT
// @log true
// @log s
// @log param TTF
// @log param FFT
// @log global TTF
// @log global FFT
// @log capture TTF
// @log capture FFT
type P = { x: i32 }
function pb(k: i32): boolean | null {
  if k == 0 { return null }
  return true
}
function ps(k: i32): string | null {
  if k == 0 { return null }
  return "s"
}
function c(v: boolean) { return if v { "T" } else { "F" } }
const gb: boolean | null = null
function local(k: i32) {
  const b = pb(k)
  const s = ps(k)
  const zi: i32 | null = null
  const ni: i32 | null = 3
  const zs: string | null = null
  const ns: string | null = "s"
  const zb: boolean | null = null
  const nb: boolean | null = false
  const zf: f64 | null = null
  const nf: f64 | null = 2.5
  const zw: i32 | string | null = null
  const nw: i32 | string | null = "w"
  const zp: P | null = null
  const np: P | null = { x: 1 }
  const zl: i32[] | null = null
  const nl: i32[] | null = [1]
  if b is boolean {
    print(b)
  } else {
    print(
      "bool i32 "
        + c(b == zi)
        + c(zi == b)
        + c(b != zi)
        + c(b == ni)
        + c(ni == b)
        + c(b != ni),
    )
    print(
      "bool str "
        + c(b == zs)
        + c(zs == b)
        + c(b != zs)
        + c(b == ns)
        + c(ns == b)
        + c(b != ns),
    )
    print(
      "bool f64 "
        + c(b == zf)
        + c(zf == b)
        + c(b != zf)
        + c(b == nf)
        + c(nf == b)
        + c(b != nf),
    )
    print(
      "bool wide "
        + c(b == zw)
        + c(zw == b)
        + c(b != zw)
        + c(b == nw)
        + c(nw == b)
        + c(b != nw),
    )
    print(
      "bool rec "
        + c(b == zp)
        + c(zp == b)
        + c(b != zp)
        + c(b == np)
        + c(np == b)
        + c(b != np),
    )
    print(
      "bool list "
        + c(b == zl)
        + c(zl == b)
        + c(b != zl)
        + c(b == nl)
        + c(nl == b)
        + c(b != nl),
    )
  }
  if s is string {
    print(s)
  } else {
    print(
      "str i32 "
        + c(s == zi)
        + c(zi == s)
        + c(s != zi)
        + c(s == ni)
        + c(ni == s)
        + c(s != ni),
    )
    print(
      "str bool "
        + c(s == zb)
        + c(zb == s)
        + c(s != zb)
        + c(s == nb)
        + c(nb == s)
        + c(s != nb),
    )
    print(
      "str wide "
        + c(s == zw)
        + c(zw == s)
        + c(s != zw)
        + c(s == nw)
        + c(nw == s)
        + c(s != nw),
    )
  }
}
function param(q: boolean | null, z: i32 | null) {
  if q is boolean {
    print(q)
  } else {
    print("param " + c(q == z) + c(z == q) + c(q != z))
  }
}
function global(z: string | null) {
  if gb is boolean {
    print(gb)
  } else {
    print("global " + c(gb == z) + c(z == gb) + c(gb != z))
  }
}
function capture(k: i32, z: i32 | null) {
  const b = pb(k)
  const f = () => {
    if b is boolean {
      print(b)
    } else {
      print("capture " + c(b == z) + c(z == b) + c(b != z))
    }
  }
  f()
}
local(0)
local(1)
param(null, null)
param(null, 4)
global(null)
global("g")
capture(0, null)
capture(0, 5)
