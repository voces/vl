// @run
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log big
// @log end
// An optional call on an un-annotated parameter whose instance never passes `null` is its call
// alone, the guard never tested: bound, printed, under `??`, returned, as an argument, a record
// field, a list element, an `if` condition's operand and a statement.
function inc(x: i32) { return x + 1 }
function show(n: i32 | null) { print(n ?? -1) }
function bound(a) {
  const v = a?.f(1)
  print(v)
}
function printed(a) { print(a?.f(2)) }
function coal(a) { print(a?.f(3) ?? 0) }
function ret(a) { return a?.f(4) }
function arg(a) { show(a?.f(5)) }
function field(a) {
  const r = { n: a?.f(6) }
  print(r.n)
}
function elem(a) {
  const l = [a?.f(7)]
  print(l[0])
}
function cond(a) {
  if (a?.f(8) ?? 0) > 5 { print("big") }
}
function stmt(a) { a?.f(9) }
bound({ f: inc })
printed({ f: inc })
coal({ f: inc })
print(ret({ f: inc }))
arg({ f: inc })
field({ f: inc })
elem({ f: inc })
cond({ f: inc })
stmt({ f: inc })
print("end")
