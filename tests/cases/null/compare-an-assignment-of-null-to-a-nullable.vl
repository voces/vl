// @log true
// @log 4
// An assignment of `null` into a never-filled `let x = null`, compared with a non-literal
// nullable either way round, by `==` and `!=`, in a `const` and an `if`, at module level, and
// against a counted call whose effect runs once, in source order (D17302).
let calls = 0
function zz(z: i32 | null) {
  calls = calls + 1
  print("zz")
  return z
}
function eq(z: i32 | null) {
  let n = null
  print((n = null) == z)
  print(z == (n = null))
  print((n = null) != z)
  print(z != (n = null))
  print((n = null) == zz(z))
  print(zz(z) != (n = null))
  const c = (n = null) == z
  print(c)
  if (n = null) == z { print("if") } else { print("else") }
}
eq(null)
eq(3)
let g = null
const k: i32 | null = 7
print((g = null) == k)
print(k != (g = null))
print(calls)
