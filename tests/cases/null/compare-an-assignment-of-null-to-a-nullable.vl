// @log 4
// An assignment of the `null` unit (the literal, a `null`-typed binding, or a call returning
// `null`) into a never-filled `let x = null`, compared with a non-literal nullable either way
// round, by `==` and `!=`, parenthesised, in a `const` and an `if`, at module level, against a
// counted call whose effect runs once in source order, and over a hole a never-taken write fills;
// against a `null`-typed name, and against another such assignment (D17302, D17162).
let calls = 0
function zz(z: i32 | null) {
  calls = calls + 1
  print("zz")
  return z
}
function eq(z: i32 | null) {
  let n = null
  print((n = null) == z)
  print(z == (n = null))
  print((n = null) != z)
  print(z != (n = null))
  print((n = null) == zz(z))
  print(zz(z) != (n = null))
  const c = (n = null) == z
  print(c)
  if (n = null) == z { print("if") } else { print("else") }
}
function nothing(): null {
  print("eff")
  return null
}
function binding(z: i32 | null) {
  const n = null
  let m = null
  print((m = n) == z)
  print(z != (m = n))
  print(m = n)
  print((m = nothing()) == z)
}
function names() {
  let m = null
  let k = null
  const n = null
  print((m = null) == n)
  print(n == (k = null))
  print((m = null) != n)
}
function pairs() {
  let m = null
  let k = null
  const n = null
  print((m = n) == (k = n))
  print((m = n) != (k = n))
  print((m = nothing()) == (k = nothing()))
  print((m = null) == (k = null))
  const c = (m = null) == (k = null)
  print(c)
  if (m = n) != (k = n) { print("ne") } else { print("eq") }
}
function never() { return false }
function paren(z: i32 | null) {
  let n = null
  print(((n = null)) == z)
}
function filled(z: i32 | null) {
  let n = null
  if never() { n = 5 }
  print((n = null) == z)
  print(n)
}
eq(null)
eq(3)
binding(null)
binding(4)
paren(null)
paren(4)
filled(null)
filled(4)
names()
pairs()
let g = null
let gk = null
const gn = null
const k: i32 | null = 7
print((g = null) == k)
print(k != (g = null))
print((g = null) == gn)
print((g = null) != gn)
print((g = gn) == (gk = gn))
print(calls)
