// @log 4
// An assignment of `null` into a never-filled `let x = null`, compared with a non-literal
// nullable either way round, by `==` and `!=`, parenthesised, in a `const` and an `if`, at module
// level, against a counted call whose effect runs once in source order, and over a hole a
// never-taken write fills (D17302).
let calls = 0
function zz(z: i32 | null) {
  calls = calls + 1
  print("zz")
  return z
}
function eq(z: i32 | null) {
  let n = null
  print((n = null) == z)
  print(z == (n = null))
  print((n = null) != z)
  print(z != (n = null))
  print((n = null) == zz(z))
  print(zz(z) != (n = null))
  const c = (n = null) == z
  print(c)
  if (n = null) == z { print("if") } else { print("else") }
}
function never() { return false }
function paren(z: i32 | null) {
  let n = null
  print(((n = null)) == z)
}
function filled(z: i32 | null) {
  let n = null
  if never() { n = 5 }
  print((n = null) == z)
  print(n)
}
eq(null)
eq(3)
paren(null)
paren(4)
filled(null)
filled(4)
let g = null
const k: i32 | null = 7
print((g = null) == k)
print(k != (g = null))
print(calls)
