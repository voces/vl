// @run
// @log 1
// @log true
// @log true
// @log 2
// @log 0
// @log 5
// A `null`-typed field's null test on a callback parameter held at the row its list is stored at
// reads that row's field: an annotated lambda, a named function, and a test after a constant field
// in the same literal; a closure's `let` of a rowless record reads its storage row the same way.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
function named(y) { return y.f == null }
print(src.filter((y: { f: null }) => y.f == null).length)
print(src.map(named)[0])
const ks = src.map((y) => {
  return { n: 2, s: [y.f == null] }
})
print(ks[0].s[0])
print(ks[0].n)
function outer() {
  const lam = () => {
    const dd = mk2()
    if dd.f != null { print(7) } else { print(0) }
  }
  lam()
}
outer()
print(dA.f ?? 5)
