// @log false
// @log true
// @log ne
// @log eq
// @log true
// @log false
// Q58 position sweep: an assignment of `null` compared as the left side of `==`/`!=` with a
// nullable name, its store written ahead of the null test as legacy writes the side first: in a
// call's argument, a `const`, an `if` condition, against a global target and inside a closure.
let g = null
function asPrint(z: i32 | null) {
  let n = null
  print((n = null) == z)
  print((n = null) != z)
}
function asConst(z: string | null) {
  let n = null
  const c = (n = null) == z
  print(c)
}
function asIf(z: i32 | null) {
  let n = null
  if (n = null) != z { print("ne") } else { print("eq") }
}
function asGlobal(z: i32 | null) { print((g = null) == z) }
function asCapture(z: i32 | null) {
  let n = null
  const f = () => (n = null) == z
  print(f())
}
asPrint(1)
asPrint(null)
asConst("s")
asConst(null)
asIf(2)
asIf(null)
asGlobal(null)
asCapture(3)
