// @emit-error emitProgram: an assignment used as a value whose type is not its target's has no value lowering
// A closure's assignment of `null` to a captured never-filled `let x = null`, used as a value,
// stays refused until a write through the capture is lowered (D17300).
function body() {
  let n = null
  const f = () => {
    print(n = null)
  }
  f()
}
body()
