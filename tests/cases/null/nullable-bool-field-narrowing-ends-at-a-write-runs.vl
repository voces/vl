// @run
// @log null
// @log null
// @log true
// @log null
// A narrowing of a `boolean | null` field ends at a call that may write it, and at a write through
// an alias: the read after it is the nullable field again. The narrowing covers the name it tested,
// so a read through an alias is the nullable field too.
type O = { f: boolean | null, n: i32 }
function clear(o: O) { o.f = null }
function viaParam(o: O) {
  if o.f is boolean {
    clear(o)
    print(o.f)
  }
}
function viaCapture(n: i32) {
  const o: O = { f: true, n: n }
  const clr = () => {
    o.f = null
  }
  if o.f is boolean {
    clr()
    print(o.f)
  }
}
function alias(o: O) {
  if o.f is boolean {
    const p = o
    print(p.f)
  }
}
function aliasThenNull(o: O) {
  if o.f is boolean {
    const p = o
    p.f = null
    print(o.f)
  }
}
viaParam({ f: true, n: 1 })
viaCapture(1)
alias({ f: true, n: 1 })
aliasThenNull({ f: false, n: 2 })
