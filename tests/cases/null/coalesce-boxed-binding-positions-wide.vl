// @run
// @log -- direct
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log other -9000000003
// @log -- directU
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log i64 -9000000003
// @log -- nested
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log other -9000000003
// @log -- concat
// @log lead
// @log Li32 7
// @log lead
// @log default
// @log Lother -9000000003
// @log -- interp
// @log lead
// @log L i32 7
// @log lead
// @log default
// @log L other -9000000003
// @log -- return
// @log i32 7
// @log default
// @log other -9000000003
// @log -- let
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log other -9000000003
// @log -- ifarm
// @log lead
// @log i32 7
// @log lead
// @log default
// @log other -9000000003
// @log -- coalesce
// @log i32 7
// @log default
// @log other -9000000003
// @log -- record
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log other -9000000003
// A `??` over a boxed binding with a wider default (`q ?? big(b)`, an `i32 | i64`) in each
// delivery position, after an earlier effectful operand where the position has one: the lead is
// written first, and the default runs only when `q` is null.
function kind(v: i32 | i64) {
  if v is i32 { return "i32 \{v}" }
  return "other \{v}"
}
function kindU(v: i32 | i64 | string) {
  if v is i32 { return "i32 \{v}" }
  if v is i64 { return "i64 \{v}" }
  return "str"
}
function two() {
  print("lead")
  return 2
}
function lead() {
  print("lead")
  return "L"
}
function big(b: i64) {
  print("default")
  return b
}
function ret(q: i32 | null, b: i64): i32 | i64 { return q ?? big(b) }
function sinkR(n: i32, v: i32 | i64) {
  print(n)
  print(kind(v))
}
function at_direct(q: i32 | null, b: i64) { sinkR(two(), q ?? big(b)) }
function sinkU(n: i32, v: i32 | i64 | string) {
  print(n)
  print(kindU(v))
}
function at_directU(q: i32 | null, b: i64) { sinkU(two(), q ?? big(b)) }
function sinkS(n: i32, s: string) {
  print(n)
  print(s)
}
function at_nested(q: i32 | null, b: i64) { sinkS(two(), kind(q ?? big(b))) }
function at_concat(q: i32 | null, b: i64) { print(lead() + kind(q ?? big(b))) }
function at_interp(q: i32 | null, b: i64) {
  print("\{lead()} \{kind(q ?? big(b))}")
}
function at_return(q: i32 | null, b: i64) { print(kind(ret(q, b))) }
function at_let(q: i32 | null, b: i64) {
  const t = two()
  const v = q ?? big(b)
  print(t)
  print(kind(v))
}
function at_ifarm(q: i32 | null, b: i64) {
  const v = if two() > 1 { q ?? big(b) } else { q ?? big(b) }
  print(kind(v))
}
function at_coalesce(q: i32 | null, b: i64) {
  const r: i32 | i64 | null = null
  print(kind(r ?? q ?? big(b)))
}
function at_record(q: i32 | null, b: i64) {
  const o = { n: two(), v: q ?? big(b) }
  print(o.n)
  print(kind(o.v))
}
print("-- direct")
at_direct(7, -9000000003)
at_direct(null, -9000000003)
print("-- directU")
at_directU(7, -9000000003)
at_directU(null, -9000000003)
print("-- nested")
at_nested(7, -9000000003)
at_nested(null, -9000000003)
print("-- concat")
at_concat(7, -9000000003)
at_concat(null, -9000000003)
print("-- interp")
at_interp(7, -9000000003)
at_interp(null, -9000000003)
print("-- return")
at_return(7, -9000000003)
at_return(null, -9000000003)
print("-- let")
at_let(7, -9000000003)
at_let(null, -9000000003)
print("-- ifarm")
at_ifarm(7, -9000000003)
at_ifarm(null, -9000000003)
print("-- coalesce")
at_coalesce(7, -9000000003)
at_coalesce(null, -9000000003)
print("-- record")
at_record(7, -9000000003)
at_record(null, -9000000003)
