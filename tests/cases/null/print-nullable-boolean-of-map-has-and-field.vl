// @run
// @log true
// @log null
// @log false
// A `boolean | null` printed as itself: each of its three values by legacy's `br_table`.
type R = { f: boolean | null }
function show(m: {[string]: i32}, r: R) {
  const a = if m.length > 0 { m.has("k") } else { null }
  print(a)
  print(r.f)
}
const m: {[string]: i32} = Map()
m["k"] = 1
show(m, { f: null })
const e: {[string]: i32} = Map()
const z: boolean | null = e.has("k")
print(z)
