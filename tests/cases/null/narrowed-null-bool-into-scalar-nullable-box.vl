// @run
// @hint redundant type annotation: `v` is inferred as `i32 | null` — remove it to lean on inference
// @log i null
// @log null
// @log i null
// @log f null
// @log u null
// @log 9
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log 1
// @log null
// @log true
// @log 0.5
// @log u null
// @log x
// A `boolean | null` read narrowed to its null arm, delivered to a scalar-nullable destination
// boxed as a value union (`i32 | null`, `f64 | null`, `i32 | string | null`), at every position,
// with and without an earlier read of the same null (D17121).
function pb(k: i32): boolean | null {
  if k == 0 { return null }
  return true
}
function ps(k: i32): string | null {
  if k == 0 { return null }
  return "x"
}
function takeI(x: i32 | null) {
  if x == null { print("i null") } else { print(x) }
}
function takeF(x: f64 | null) {
  if x == null { print("f null") } else { print(x) }
}
function takeU(x: i32 | string | null) {
  if x == null { print("u null") } else { print(x) }
}
function ri(b: boolean | null): i32 | null {
  if b is boolean { return 1 }
  return b
}
function rf(b: boolean | null): f64 | null {
  if b is boolean { return 0.5 }
  print(b)
  return b
}
function t(k: i32) {
  const b = pb(k)
  if b is boolean {
    print(b)
  } else {
    takeI(b)
    print(b)
    takeI(b)
    takeF(b)
    takeU(b)
    const z: i32 | null = b
    print(z ?? 9)
    const r: { x: i32 | null } = { x: b }
    print(r.x == null)
    const xs: (i32 | null)[] = [b]
    print(xs[0] == null)
    let w: i32 | null = 5
    w = b
    print(w == null)
    const m: {[string]: f64 | null} = Map()
    m["a"] = b
    print(m["a"] == null)
    const v: i32 | null = if k > 5 { 3 } else { b }
    print(v == null)
  }
}
function u(k: i32) {
  const s = ps(k)
  if s is string { print(s) } else { takeU(s) }
}
t(0)
t(1)
print(ri(pb(0)) == null)
print(ri(pb(1)))
print(rf(pb(0)) == null)
print(rf(pb(1)))
u(0)
u(1)
