// @run
// @log field i32 TTF
// @log field str TTF
// @log field g TTF
// @log field i32 FFT
// @log field str FFT
// @log field g FFT
// @log false
// @log h
// @log elem i32 TTF
// @log elem wide TTF
// @log elem i32 FFT
// @log elem wide FFT
// @log true
type O = { f: boolean | null, g: string | null }
function pb(k: i32): boolean | null {
  if k == 0 { return null }
  return true
}
function c(v: boolean) { return if v { "T" } else { "F" } }
function field(o: O, zi: i32 | null, zs: string | null) {
  if o.f is boolean {
    print(o.f)
  } else {
    print("field i32 " + c(o.f == zi) + c(zi == o.f) + c(o.f != zi))
    print("field str " + c(o.f == zs) + c(zs == o.f) + c(o.f != zs))
  }
  if o.g is string {
    print(o.g)
  } else {
    print("field g " + c(o.g == zi) + c(zi == o.g) + c(o.g != zi))
  }
}
function elem(k: i32, zi: i32 | null, zw: i32 | string | null) {
  const a: (boolean | null)[] = [pb(k)]
  if a[0] is boolean {
    print(a[0])
  } else {
    print("elem i32 " + c(a[0] == zi) + c(zi == a[0]) + c(a[0] != zi))
    print("elem wide " + c(a[0] == zw) + c(zw == a[0]) + c(a[0] != zw))
  }
}
field({ f: null, g: null }, null, null)
field({ f: null, g: null }, 7, "s")
field({ f: false, g: "h" }, null, null)
elem(0, null, null)
elem(0, 7, "w")
elem(1, null, null)
