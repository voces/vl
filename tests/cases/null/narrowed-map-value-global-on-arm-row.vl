// @run
// @hint redundant type annotation: `su` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log 7
// @log null
// @log 7
// @log v=7
// @log v=7
// @log 7
// @log 0
// A narrowed read of a nullable map-value global, whose record type is stored on a declared
// record's union-arm row, recovers its non-null ref at a binding, a field read, a concat and an
// interpolation (D17103).
import { toString } from "std:fmt"

type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
const dA: J = mk2()
const __m = Map()
__m["k"] = mk2()
const __mv = __m["k"]
function su(j: J | string): i32 { return if j is string { 0 } else { j.g } }
if __mv != null {
  const v = __mv
  print(v.g)
  print(v.f)
  print(__mv.g)
  print("v=" + toString(__mv.g))
  print("v=\{__mv.g}")
}
print(su(dA))
print(su("s"))
