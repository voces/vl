// @run
// @log s:u
// @log n:7
// @log [5]
// @log s:v
// @log n:9
// @log s:w
// @log n:3
// @log abidrfe
// A `??` whose left is a `null`-typed `if` run for its effect, its default boxed into a union: the
// `if` runs once, then the default is the boxed value. A union argument (a string and a number
// default), an interpolation hole, a union binding, return, record field and list element.
type U = i32 | string
type R = { u: U }
let log = ""
function note(s: string) { log = log + s }
function show(u: U) {
  if u is string { return "s:" + u } else { return "n:\{u}" }
}
function arg(c: boolean) {
  const x = null
  return show(
    (if c {
      note("a")
      x
    } else {
      x
    })
      ?? "u",
  )
}
function argNum(c: boolean) {
  const x = null
  return show(
    (if c {
      x
    } else {
      note("b")
      x
    })
      ?? 7,
  )
}
function interp(c: boolean) {
  const x = null
  return "[\{(if c {
    note("i")
    x
  } else { x }) ?? 5}]"
}
function bind(c: boolean) {
  const x = null
  const u: U = (if c {
    note("d")
    x
  } else {
    x
  })
    ?? "v"
  return show(u)
}
function ret(c: boolean): U {
  const x = null
  return (if c {
    note("r")
    x
  } else {
    x
  })
    ?? 9
}
function field(c: boolean) {
  const x = null
  const r: R = {
    u: (if c {
      note("f")
      x
    } else {
      x
    })
      ?? "w",
  }
  return show(r.u)
}
function elem(c: boolean) {
  const x = null
  const l: U[] = [
    (if c {
      note("e")
      x
    } else {
      x
    })
      ?? 3,
  ]
  return show(l[0])
}
print(arg(true))
print(argNum(false))
print(interp(true))
print(bind(true))
print(show(ret(true)))
print(field(true))
print(elem(true))
print(log)
