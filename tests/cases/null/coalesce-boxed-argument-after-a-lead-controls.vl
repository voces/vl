// @run
// @log abool true
// @log bint 3
// @log c (bool false)
// @log d (int 3)
// @log e/bool true
// @log f/int 3
// @log gbool false
// @log hint 3
// @log it
// @log jf
// @log k<b>
// @log l<a>
// @log m<s>
// @log default
// @log n<d>
// @log ox4
// @log px9
// The controls beside the boxed staging `??`s: the `nulBoolJoin` arm, whose box writes no head, in
// all four positions, and each staging arm delivered unboxed inside a string `+`.
function show(v: i32 | boolean) {
  if v is i32 { return "int \{v}" }
  return "bool \{v}"
}
function two(a: string, b: string) { return a + "/" + b }
function pairB(f: string, v: i32 | boolean) { return f + show(v) }
function plainB(v: boolean) { return if v { "t" } else { "f" } }
function plainS(v: string) { return "<" + v + ">" }
function plainL(v: "a" | "b") { return "<" + v + ">" }
function plainR(v: { x: i32 }) { return "x\{v.x}" }
function dflt() {
  print("default")
  return "d"
}
function j1(f: string, rc: boolean | null) { return f + show(rc ?? 3) }
function j2(f: string, rc: boolean | null) { return "\{f} (\{show(rc ?? 3)})" }
function j3(f: string, rc: boolean | null) { return two(f, show(rc ?? 3)) }
function j4(f: string, rc: boolean | null) { return pairB(f, rc ?? 3) }
function p1(f: string, rc: boolean | null) { return f + plainB(rc ?? false) }
function p2(f: string, k: "a" | "b" | null) { return f + plainL(k ?? "a") }
function p3(f: string, s: string | null) { return f + plainS(s ?? dflt()) }
function p4(f: string, r: { x: i32 } | null) {
  return f + plainR(r ?? { x: 9 })
}
print(j1("a", true))
print(j1("b", null))
print(j2("c", false))
print(j2("d", null))
print(j3("e", true))
print(j3("f", null))
print(j4("g", false))
print(j4("h", null))
print(p1("i", true))
print(p1("j", null))
print(p2("k", "b"))
print(p2("l", null))
print(p3("m", "s"))
print(p3("n", null))
print(p4("o", { x: 4 }))
print(p4("p", null))
