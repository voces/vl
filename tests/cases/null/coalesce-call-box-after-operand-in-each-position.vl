// @run
// @log fd
// @log 0.75
// @log fd
// @log 2
// @log fd
// @log false
// @log fd
// @log 4.5
// @log fu
// @log 3s
// @log fu
// @log 3d
// @log fu
// @log c!i7
// @log fd
// @log 4
// @log fd
// @log 1.5
// @log fd
// @log fd
// @log 3
// @log fd
// @log 2
// @log 5
// A `??` over a call's boxed `f64 | null` or `i32 | string | null`, written after an earlier
// operand (a call's value) that stays below it, in each position: a sum, a compare, a second
// argument, a concat, a list element, a record field and a global's update; and a `never` default
// at an f64 and an i64, which the call widens. Each call runs once.
type P = { a: f64, b: f64 }
function fd(k: i32): f64 | null {
  print("fd")
  if k > 0 { return 1.5 }
  return null
}
function fu(k: i32): i32 | string | null {
  print("fu")
  if k > 1 { return "s" }
  if k > 0 { return 7 }
  return null
}
function fail(m: string): never { __trap__(m) }
function fl(k: i32): i64 | null {
  if k > 0 { return 5 }
  return null
}
function show(u: i32 | string) {
  if u is string { return u } else { return "i\{u}" }
}
function two(a: f64, b: f64) { return a * b }
function h(a: f64) { return a / 2.0 }
function hi(a: i32) { return a + 1 }
function hs(s: string) { return s + "!" }
function twoU(a: i32, b: i32 | string) { return "\{a}" + show(b) }
function sum(a: f64, k: i32) { return h(a) + (fd(k) ?? 0.25) }
function less(a: f64, k: i32) { return h(a) < (fd(k) ?? 0.25) }
function arg(a: f64, k: i32) { return two(a, fd(k) ?? 2.0) }
function argU(a: i32, k: i32) { return twoU(hi(a), fu(k) ?? "d") }
function cat(s: string, k: i32) { return hs(s) + show(fu(k) ?? 3) }
function list(a: f64, k: i32) { return [a, fd(k) ?? 4.0] }
function rec(a: f64, k: i32) {
  const p: P = { a: a, b: fd(k) ?? 8.0 }
  return p
}
let acc = 1.0
function bump(k: i32) { acc = acc + (fd(k) ?? 0.5) }
function wideF(k: i32) { return h(1.0) + (fd(k) ?? fail("no f64")) }
function wideI(k: i32) { return fl(k) ?? fail("no i64") }
print(sum(1.0, 0))
print(sum(1.0, 1))
print(less(1.0, 0))
print(arg(3.0, 1))
print(argU(2, 2))
print(argU(2, 0))
print(cat("c", 1))
print(list(1.0, 0)[1])
print(rec(2.0, 1).b)
bump(0)
bump(1)
print(acc)
print(wideF(1))
print(wideI(1))
