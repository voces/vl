// @run
// @log 1
// @log 4
// @log true
// @log 5
// @log 7
// @log 9
// @log true
// A binding copied from a read narrowed to `null` is typed `_ | null` and stored as its source's
// nullable record, so its null test is that reference's: a global, local or parameter source,
// `==` and `!=`, an `if`, a print, an annotated copy and the start body.
type Rec = { x: i32 }
const q: Rec | null = null
function mk(): Rec | null { return null }
function ifTest() {
  if q is Rec { return 0 }
  const z = q
  return if z == null { 1 } else { 2 }
}
function neTest() {
  if q is Rec { return 0 }
  const z = q
  return if z != null { 3 } else { 4 }
}
function printed() {
  if q is Rec { return }
  const z = q
  print(z == null)
}
function annotated() {
  if q is Rec { return 0 }
  const z: Rec | null = q
  return if z == null { 5 } else { 6 }
}
function fromLocal() {
  const p = mk()
  if p is Rec { return 0 }
  const z = p
  return if z == null { 7 } else { 8 }
}
function fromParam(p: Rec | null) {
  if p is Rec { return 0 }
  const z = p
  return if z == null { 9 } else { 10 }
}
print(ifTest())
print(neTest())
printed()
print(annotated())
print(fromLocal())
print(fromParam(null))
if q is Rec {
  print(0)
} else {
  const z = q
  print(z == null)
}
