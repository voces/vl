// @run
// @log mk
// @log 0
// @log mk
// @log true
// @log mk
// @log false
// @log 3
// A null test of a `null`-typed field runs its operand once for its effect, then answers
type K = { f: i32 | null }
let calls = 0
function mk() {
  calls = calls + 1
  print("mk")
  return { f: null }
}
const kA: K = mk()
print(kA.f ?? 0)
function probe() {
  const g = mk()
  print(g.f == null)
  print(mk().f != null)
  print(calls)
}
probe()
