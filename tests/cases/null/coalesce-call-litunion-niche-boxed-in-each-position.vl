// @run
// @log 2
// @log a
// @log 3
// @log b
// @log 4
// @log a
// @log 5
// @log b
// @log 7
// @log b
// @log 8
// @log 2
// @log 9
// @log a
// A `??` over a literal union's `K | null` niche a call yields, joined into a union box, in each
// position: a call's argument, a return, a record field, a list element, an `if` arm, a loop, a
// parameter-driven call and a nested function.
type K = "a" | "b"
type R = { v: K | i32 }
function gk(which: i32): K | null {
  if which == 0 { return null }
  if which == 1 { return "a" }
  return "b"
}
function show(x: K | i32) { print(x) }
function ret(w: i32): K | i32 { return gk(w) ?? 3 }
function rec(w: i32): R { return { v: gk(w) ?? 4 } }
function list(): (K | i32)[] { return [gk(0) ?? 5, gk(2) ?? 6] }
function arm(c: boolean, w: i32): K | i32 {
  return if c { gk(w) ?? 7 } else { 8 }
}
function loop() {
  let t = 0
  for w in [0, 1, 0] {
    const x = gk(w) ?? 1
    if x is i32 { t = t + x }
  }
  return t
}
function outer(w: i32): K | i32 {
  function inner(): K | i32 { return gk(w) ?? 9 }
  return inner()
}
show(gk(0) ?? 2)
show(gk(1) ?? 2)
print(ret(0))
print(ret(2))
print(rec(0).v)
print(rec(1).v)
const xs = list()
print(xs[0])
print(xs[1])
print(arm(true, 0))
print(arm(true, 2))
print(arm(false, 1))
print(loop())
print(outer(0))
print(outer(1))
