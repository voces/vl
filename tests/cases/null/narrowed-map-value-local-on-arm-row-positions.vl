// @run
// @hint redundant type annotation: `su` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 0
// @log 8
// @log true
// @log 7
// @log 8
// @log 7
// @log none
// @log 7
// A narrowed read of a nullable local map value, its record type stored on a declared record's
// union-arm row, delivered at each position: binding, field, argument, union argument,
// assignment, list and record element, `??` on a field, `is`, `==`, a loop and an early return
// (D17103).
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
const dA: J = mk2()
function su(j: J | string): i32 { return if j is string { 0 } else { j.g } }
function useJ(j: J) { print(j.g) }
function gx(j) { return j.g }
function rd(k: string) {
  const m = Map()
  m["k"] = mk2()
  const mv = m[k]
  if mv != null {
    const v = mv
    print(v.g)
    print(mv.g)
    useJ(mv)
    print(su(mv))
    print(gx(mv))
    let w = dA
    w = mv
    print(w.g)
    const xs = [mv]
    print(xs[0].g)
    const r = { j: mv }
    print(r.j.g)
    print(mv.f ?? 0)
    if mv is J { print(mv.g + 1) }
    print(mv == mv)
    let i = 0
    while i < 2 {
      print(mv.g + i)
      i = i + 1
    }
  }
  if mv == null {
    print("none")
    return
  }
  const u = mv
  print(u.g)
}
rd("k")
rd("x")
print(su(dA))
