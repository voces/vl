// @run
// @log true
// @log true
// @log null
// @log true
// @log b
// A `(boolean | null)[]` element narrowed to `null` is that unit wherever it is delivered: passed at
// a `null` parameter, bound, printed, and compared after binding.
function pb(k: i32): boolean | null {
  if k == 0 { return null }
  return true
}
function takeN(x: null) { print(x == null) }
function elem(k: i32) {
  const a: (boolean | null)[] = [pb(k)]
  if a[0] is boolean {
    print("b")
  } else {
    takeN(a[0])
    const q = a[0]
    print(q == null)
    print(a[0])
    takeN(q)
  }
}
elem(0)
elem(1)
