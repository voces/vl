// @run
// @log true
// @log -3
// @log 10
// @log true
// @log 7
// @log -1
// @log g
// @log end
// A `?.` call on an un-annotated parameter yields `null` where the instance's argument may be
// absent: returned, through `??`, at an instance with a present receiver, bound to a `const`
// and handed to an annotated parameter. A void method stays void (unfiled: D17662).
type F = { f: (x: i32) => i32, g: () => void }
function p3(a) { return a?.f(5) }
function viaConst(a) {
  const v = a?.f(2)
  return v
}
function show(n: i32 | null) { print(n ?? -1) }
function pass(a) { show(a?.f(3)) }
function effect(a) { a?.g() }
const none: F | null = null
const some: F = { f: (x: i32) => x * 2, g: () => print("g") }
const r = p3(none)
print(r == null)
print(p3(none) ?? -3)
print(p3(some) ?? -3)
print(viaConst(none) == null)
print((viaConst(some) ?? 0) + 3)
pass(none)
effect(some)
effect(none)
print("end")
