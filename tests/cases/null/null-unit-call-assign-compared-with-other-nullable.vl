// @run
// @log unit TTF
// @log unit FFT
// @log N
// @log true
// @log N
// @log true
// @log N
// @log false
// @log N
// @log false
// @log N
// @log false
// @log N
// @log true
// @log true
// @log true
// @log true
// @log false
// @log false
// @log true
// @log next
// @log true
// @log next
// @log true
// @log next
// @log false
// @log next
// @log true
// @log N
// @log next
// @log true
// @log next
// @log N
// @log false
// @log 6
function pb(k: i32): boolean | null {
  if k == 0 { return null }
  return true
}
function nothing() {
  print("N")
  return null
}
let cnt = 0
function next(k: i32): i32 | null {
  cnt = cnt + 1
  print("next")
  if k == 0 { return null }
  return k
}
function unit(z: i32 | null) {
  const n = null
  print(
    "unit "
      + (if n == z { "T" } else { "F" })
      + (if z == n { "T" } else { "F" })
      + (if n != z { "T" } else { "F" }),
  )
}
function call(z: i32 | null) {
  print(nothing() == z)
  print(z == nothing())
  print(nothing() != z)
}
function assign(z: i32 | null) {
  let x: boolean | null = true
  print((x = null) == z)
  print(z == (x = null))
  print(x == null)
}
function effects(k: i32) {
  const b = pb(k)
  if b is boolean {
    print(b)
  } else {
    print(next(0) == b)
    print(b == next(0))
    print(next(5) == b)
    print(b != next(5))
    print(nothing() == next(0))
    print(next(3) == nothing())
    print(cnt)
  }
}
unit(null)
unit(2)
call(null)
call(2)
assign(null)
assign(2)
effects(0)
