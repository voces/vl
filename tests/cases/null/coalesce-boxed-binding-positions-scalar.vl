// @run
// @log -- direct
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log i32 5
// @log -- directU
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log i32 5
// @log -- nested
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log i32 5
// @log -- concat
// @log lead
// @log Li32 7
// @log lead
// @log default
// @log Li32 5
// @log -- interp
// @log lead
// @log L i32 7
// @log lead
// @log default
// @log L i32 5
// @log -- return
// @log i32 7
// @log default
// @log i32 5
// @log -- let
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log i32 5
// @log -- ifarm
// @log lead
// @log i32 7
// @log lead
// @log default
// @log i32 5
// @log -- coalesce
// @log i32 7
// @log default
// @log i32 5
// @log -- record
// @log lead
// @log 2
// @log i32 7
// @log lead
// @log default
// @log 2
// @log i32 5
// A `??` over a boxed binding with a default of its present type (`q ?? five(b)`, an `i32`) in
// each delivery position, after an earlier effectful operand where the position has one: the lead
// is written first, and the default runs only when `q` is null.
function kind(v: i32) {
  if v is i32 { return "i32 \{v}" }
  return "other \{v}"
}
function kindU(v: i32 | i64 | string) {
  if v is i32 { return "i32 \{v}" }
  if v is i64 { return "i64 \{v}" }
  return "str"
}
function two() {
  print("lead")
  return 2
}
function lead() {
  print("lead")
  return "L"
}
function five(b: i32) {
  print("default")
  return b
}
function ret(q: i32 | null, b: i32) { return q ?? five(b) }
function sinkR(n: i32, v: i32) {
  print(n)
  print(kind(v))
}
function at_direct(q: i32 | null, b: i32) { sinkR(two(), q ?? five(b)) }
function sinkU(n: i32, v: i32 | i64 | string) {
  print(n)
  print(kindU(v))
}
function at_directU(q: i32 | null, b: i32) { sinkU(two(), q ?? five(b)) }
function sinkS(n: i32, s: string) {
  print(n)
  print(s)
}
function at_nested(q: i32 | null, b: i32) { sinkS(two(), kind(q ?? five(b))) }
function at_concat(q: i32 | null, b: i32) { print(lead() + kind(q ?? five(b))) }
function at_interp(q: i32 | null, b: i32) {
  print("\{lead()} \{kind(q ?? five(b))}")
}
function at_return(q: i32 | null, b: i32) { print(kind(ret(q, b))) }
function at_let(q: i32 | null, b: i32) {
  const t = two()
  const v = q ?? five(b)
  print(t)
  print(kind(v))
}
function at_ifarm(q: i32 | null, b: i32) {
  const v = if two() > 1 { q ?? five(b) } else { q ?? five(b) }
  print(kind(v))
}
function at_coalesce(q: i32 | null, b: i32) {
  const r: i32 | null = null
  print(kind(r ?? q ?? five(b)))
}
function at_record(q: i32 | null, b: i32) {
  const o = { n: two(), v: q ?? five(b) }
  print(o.n)
  print(kind(o.v))
}
print("-- direct")
at_direct(7, 5)
at_direct(null, 5)
print("-- directU")
at_directU(7, 5)
at_directU(null, 5)
print("-- nested")
at_nested(7, 5)
at_nested(null, 5)
print("-- concat")
at_concat(7, 5)
at_concat(null, 5)
print("-- interp")
at_interp(7, 5)
at_interp(null, 5)
print("-- return")
at_return(7, 5)
at_return(null, 5)
print("-- let")
at_let(7, 5)
at_let(null, 5)
print("-- ifarm")
at_ifarm(7, 5)
at_ifarm(null, 5)
print("-- coalesce")
at_coalesce(7, 5)
at_coalesce(null, 5)
print("-- record")
at_record(7, 5)
at_record(null, 5)
