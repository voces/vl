// @run
// @log 21
// @log 1
// @log 2
// EVALUATION ORDER IS SOURCE ORDER — the binary-operand instance (DECISIONS.md
// "evaluation order"). PRECEDENCE IS NOT EVALUATION ORDER: `next() + next() * 10`
// groups as `next() + (next() * 10)` and still runs its leaves left to right, so
// the answer is `1 + 2 * 10`, not `2 + 1 * 10`.
let n = 0

function next() {
  n += 1
  n
}

print(next() + next() * 10)

let m = 0

function tick() {
  m += 1
  m
}

const a = tick()
const b = tick()

print(a)
print(b)
