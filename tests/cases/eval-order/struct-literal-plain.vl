// @run
// @log 1
// @log 2
// @log 3
// EVALUATION ORDER IS SOURCE ORDER — the struct-literal instance, un-annotated
// spelling. [D1510](../../../docs/internals/inventory/D1510.md): `struct.new`
// takes its operands in LAYOUT order (field names sorted, D622) and the emitter
// used to evaluate each initialiser at the moment it pushed it, so this printed
// `2 1 3`. THE FIXTURE THAT WOULD HAVE CAUGHT IT NEEDS A SIDE EFFECT: every other
// object-literal fixture in the corpus initialises from constants, which cannot
// tell the two orders apart.
let n = 0

function next() {
  n += 1
  n
}

const s = { b: next(), a: next(), c: next() }

print(s.b)
print(s.a)
print(s.c)
