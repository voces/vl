// @hint redundant type annotation: `valOf` is inferred as `i32`
// @hint redundant type annotation: `ord` is inferred as `i32`
// @hint redundant type annotation: `acc` is inferred as `{x: f64}`
// @hint redundant type annotation: `ordIdx` is inferred as `i32`
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `viaCall` is inferred as `i32`
// @hint redundant type annotation: `old1` is inferred as `{v: i32}`
// @hint redundant type annotation: `h1` is inferred as `{b: Box}`
// @hint redundant type annotation: `bump` is inferred as `i32`
// @hint redundant type annotation: `viaIndex` is inferred as `i32`
// @hint redundant type annotation: `viaIf` is inferred as `i32`
// @hint redundant type annotation: `old2` is inferred as `{v: i32}`
// @hint redundant type annotation: `h2` is inferred as `{b: Box}`
// @hint redundant type annotation: `viaCompound` is inferred as `i32`
// @hint redundant type annotation: `n` is inferred as `{v: i32}`
// @hint redundant type annotation: `rebind` is inferred as `i32`
// @hint redundant type annotation: `viaGlobal` is inferred as `i32`
// Regression (D2170, the D1510 source-order rule). A field or element write that is a
// function's value evaluates its receiver and index before its right-hand side, stores into
// the place they named, and yields the right-hand side.
type Acc = { x: f64 }
function recvOf(tag: string, b: Acc): Acc {
  print(tag)
  b
}
function valOf(tag: string, v: i32): i32 {
  print(tag)
  v
}
function ord(b: Acc): i32 { recvOf("recv", b).x = valOf("rhs", 4) }
const acc: Acc = { x: 1.5 }
print(ord(acc))
print(acc.x)
function ordIdx(xs: i32[]): i32 { xs[valOf("idx", 0)] = valOf("rhs", 5) }
const ys = [0]
print(ordIdx(ys))
print(ys[0])

// The right-hand side replaces the receiver's holder: the store lands in the old one.
type Box = { v: i32 }
type H = { b: Box }
function g(h: H): i32 {
  print("g")
  h.b = { v: 100 }
  7
}
function viaCall(h: H): i32 { h.b.v = g(h) }
const old1: Box = { v: 1 }
const h1: H = { b: old1 }
print(viaCall(h1))
print(old1.v)
print(h1.b.v)

// The right-hand side changes the index's source, through a call and through a compound write.
function bump(b: i32[]): i32 {
  b[0] = 1
  9
}
function viaIndex(a: i32[], b: i32[]): i32 { a[b[0]] = bump(b) }
const a2 = [0, 0]
const b2 = [0]
print(viaIndex(a2, b2))
print(a2[0])
print(a2[1])

// The same replacement inside an `if` right-hand side, with no call.
function viaIf(h: H, c: boolean): i32 {
  h.b.v = if c {
    h.b = { v: 100 }
    7
  } else {
    8
  }
}
const old2: Box = { v: 1 }
const h2: H = { b: old2 }
print(viaIf(h2, true))
print(old2.v)
print(h2.b.v)
function viaCompound(a: i32[], b: i32[]): i32 { a[b[0]] += bump(b) }
const a3 = [10, 10]
const b3 = [0]
print(viaCompound(a3, b3))
print(a3[0])
print(a3[1])

// A module global the right-hand side rebinds, beside a block-scoped local of the same name.
let n: Box = { v: 1 }
function rebind(): i32 {
  n = { v: 50 }
  3
}
function viaGlobal(c: boolean): i32 {
  if c {
    const n = 5
    print(n)
  }
  n.v = rebind()
}
const old3 = n
print(viaGlobal(false))
print(old3.v)
print(n.v)
