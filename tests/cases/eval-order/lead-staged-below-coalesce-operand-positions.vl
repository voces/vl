// @run
// @log 3
// @log 3
// @log i3
// @log 3
// @log v3
// @log h 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 1
// @log 7
// @log z
// @log 2
// @log 20
// @log 2
// @log bc
// @log wbc
// @log 6
// A left operand, a list receiver or a string receiver read before a later operand that holds a
// `??` is read first: the later operand's call writes the variable, and every position prints the
// value from before that write. Positions per Q58.
import { parseI32 } from "std:fmt"
import { split } from "std:str"

let r = 1
let xs = [10, 20, 30, 40]
let s = "abcdef"

function bump(t: string): i32 | null {
  r = r + 100
  xs = [7, 7]
  s = "zz"
  return parseI32(t)
}

function sum(): i32 { return r + (bump("2") ?? 0) }
function sliced(): i32[] { return xs.slice(bump("1") ?? 0, 3) }
function sub(): string { return s.slice(bump("x") ?? 1, 3) }

function reset() {
  r = 1
  xs = [10, 20, 30, 40]
  s = "abcdef"
}

function takeI(v: i32): i32 { return v }
function takeU(v: i32 | string): string { if v is i32 { return "i\{v}" } else { return v } }
function wrap(v: i32): i32 { return takeI(v) }

type Rec = { a: i32, l: i32[], t: string }

reset()
print(sum())
reset()
print(takeI(r + (bump("2") ?? 0)))
reset()
print(takeU(r + (bump("2") ?? 0)))
reset()
print(wrap(takeI(r + (bump("2") ?? 0))))
reset()
print("v\{r + (bump("2") ?? 0)}")
reset()
print("h \{r + (bump("2") ?? 0)}")
reset()
const k = r + (bump("2") ?? 0)
print(k)
reset()
const c = if k > 0 { r + (bump("2") ?? 0) } else { 0 }
print(c)
reset()
const q: i32 | null = null
print(q ?? (r + (bump("2") ?? 0)))
reset()
const rec: Rec = { a: r + (bump("2") ?? 0), l: xs.slice(bump("1") ?? 0, 3), t: s.slice(bump("x") ?? 1, 3) }
print(rec.a)
print(rec.l.length)
print(rec.l[0])
print(rec.t)
reset()
print(sliced().length)
reset()
print(sliced()[0])
reset()
print(takeI(xs.slice(bump("1") ?? 0, 3).length))
reset()
print(sub())
reset()
print("w" + s.slice(bump("x") ?? 1, 3))
reset()
const parts = split("1 2 3", " ")
let tot = 0
for p in parts { tot = tot + (parseI32(p) ?? 0) }
print(tot)
