// @run
// @log a-b-c
// @log d/e
// EVALUATION ORDER IS SOURCE ORDER — the N-ARY string concat (DECISIONS.md
// "evaluation order"). A chain of `+` over strings is FUSED into one lowering that
// stashes each part in a slot pool before it copies (#2474), so the parts are
// exactly an expression list that a fused path could reorder; this pins that they
// run left to right.
let n = 0
const names = ["a", "b", "c", "d", "e"]

function nextName() {
  n += 1
  names[n - 1]
}

print(nextName() + "-" + nextName() + "-" + nextName())
print(nextName() + "/" + nextName())
