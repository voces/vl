// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// A fresh record binding that drops a field and widens one, held in a record field, a fresh
// record literal or a fresh list literal, is built at the record or union arm it lands on there;
// the dropped initialiser still runs (D3566).
type A = { k: i32, legs: i64 }
type B = { s: string }
type Pet = A | B
type Box = { pet: Pet }
type BoxA = { pet: A }
let n = 0
function f() {
  n = n + 1
  return true
}
function nested(): Box {
  const sv = { pet: { k: 1, legs: 4, purr: f() } }
  return sv
}
const q = nested().pet
if q is A { print(q.legs + 1) }
function inField(): Box {
  const sv = { k: 1, legs: 4, purr: f() }
  return { pet: sv }
}
const r = inField().pet
if r is A { print(r.legs + 1) }
function inList(): Pet[] {
  const sv = { k: 1, legs: 4, purr: f() }
  return [sv]
}
const t = inList()[0]
if t is A { print(t.legs + 1) }
function inRecField(): BoxA {
  const sv = { k: 1, legs: 4, purr: f() }
  return { pet: sv }
}
print(inRecField().pet.legs + 1)
function inRecList(): A[] {
  const sv = { k: 1, legs: 4, purr: f() }
  return [sv]
}
print(inRecList()[0].legs + 1)
print(n)
