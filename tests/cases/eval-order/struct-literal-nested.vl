// @run
// @log 3
// @log 2
// @log 1
// EVALUATION ORDER IS SOURCE ORDER — the NESTED struct literal (D1510). BOTH
// orders matter and the two are independent: the outer literal runs `b` before
// `a`, and running `b` means running the inner literal's `y` before its `x`. Under
// layout order the whole thing came out reversed (`1 2 3`), which is why the
// expected sequence here is descending — reading `s.a`, `s.b.x`, `s.b.y` walks the
// counter backwards through the source order that produced it.
let n = 0

function next() {
  n += 1
  n
}

const s = { b: { y: next(), x: next() }, a: next() }

print(s.a)
print(s.b.x)
print(s.b.y)
