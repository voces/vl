// @run
// @log -x
// @log mg
// @log 2
// @log mgmg
// @log false
// @log mgmggm
// @log false
// @log mgmggmmg
// @log x
// @log mgmggmmgmg
// @log true
// @log mgmggmmgmggm
// @log -x
// @log false
// @log x
// @log mgmggmmgmggmmggmmg
// A read of a `null`-typed field off a call, beside another call, in each consumer: each call
// runs once, in source order, as the trace shows.
let trace = ""
type U = { id: i32, tags: null }
function mk(): U {
  trace = trace + "m"
  return { id: 2, tags: null }
}
function g(): string | null {
  trace = trace + "g"
  return "x"
}
function two(a: string | null, b: string | null) {
  return (a ?? "-") + (b ?? "-")
}
function run() {
  print(two(mk().tags, g()))
  print(trace)
  const xs: (string | null)[] = [mk().tags, g()]
  print(xs.length)
  print(trace)
  print(g() == mk().tags)
  print(trace)
  print(mk().tags == g())
  print(trace)
  print(mk().tags ?? g())
  print(trace)
  print(g() != mk().tags)
  print(trace)
}
run()
print(two(mk().tags, g()))
print(g() == mk().tags)
print(mk().tags ?? g())
print(trace)
