// @run
// @log 4
// @log 1
// A field the declared record drops (D1696) still runs its initialiser, once, in source
// order: an increment as the dropped initialiser.
type Plain = { legs: i64 }
type Shallow = { pet: Plain }
let n = 0
function mk(): Shallow {
  const sv = { pet: { legs: 4, purr: n++ } }
  return sv
}
print(mk().pet.legs)
print(n)
