// @run
// @log 3
// @log 2
// A field the declared record drops (D1696) still runs its initialiser, once, in source
// order: a kept and a dropped field calling the same function.
type Plain = { legs: i32 }
type Shallow = { pet: Plain }
let n = 0
function f() { n = n + 1; return 3 }
function mk(): Shallow {
  const sv = { pet: { legs: f(), purr: f() } }
  return sv
}
print(mk().pet.legs)
print(n)
