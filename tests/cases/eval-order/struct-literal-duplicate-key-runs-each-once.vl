// A repeated key runs every initialiser exactly once, in source order, and the first one is the
// field's value: it ran each slot's first initialiser, `g` n-squared times and the rest never
// (D3484). Whether a repeated key is an error at all is an open ruling.
function g(n: i32) {
  print(n)
  return n
}
function s(t: string) {
  print(t)
  return t
}
const o = { a: g(1), a: g(2) }
print(o.a)
const p = { a: g(10), a: g(20), a: g(30) }
print(p.a)
function f() {
  const q = { b: g(1), a: g(5), a: g(6), a: g(7) }
  print(q.a)
  print(q.b)
}
f()
const r = { a: s("x"), b: s("y"), a: s("z") }
print(r.a)
print(r.b)
