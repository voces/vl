// @run
// @log 10
// @log 20
// @log 30
// @log 40
// @log 50
// @log 60
// @log 70
// @log 80
// @log 90
// @hint redundant type annotation: `r` is inferred as
// THE CONSUMER'S OWN SHAPE — the program
// [D1510](../../../docs/internals/inventory/D1510.md) was reported from (VL-018, the
// glean session): a nine-byte record read written field by field off a cursor. Every
// initialiser has the same side effect, so evaluating them in LAYOUT order gave each
// field its ALPHABETICAL neighbour's byte and nothing diagnosed it — check-clean,
// running, wrong answer. The source order here is deliberately NOT alphabetical.
const bytes = [10, 20, 30, 40, 50, 60, 70, 80, 90]

let pos = 0

function readU8() {
  const v = bytes[pos]
  pos = pos + 1
  v
}

type Rec = {
  playerId: i32,
  download: i32,
  status: i32,
  upload: i32,
  ping: i32,
  mode: i32,
  team: i32,
  colour: i32,
  flags: i32,
}

const r: Rec = {
  playerId: readU8(),
  download: readU8(),
  status: readU8(),
  upload: readU8(),
  ping: readU8(),
  mode: readU8(),
  team: readU8(),
  colour: readU8(),
  flags: readU8(),
}

print(r.playerId)
print(r.download)
print(r.status)
print(r.upload)
print(r.ping)
print(r.mode)
print(r.team)
print(r.colour)
print(r.flags)
