// @run
// @log 4
// @log 1
// A field the declared record drops (D1696) still runs its initialiser, once, in source
// order: a binding passed as an argument.
type Plain = { legs: i64 }
type Shallow = { pet: Plain }
let n = 0
function f() { n = n + 1; return true }
function take(s: Shallow) { return s.pet.legs }
const sv = { pet: { legs: 4, purr: f() } }
print(take(sv))
print(n)
