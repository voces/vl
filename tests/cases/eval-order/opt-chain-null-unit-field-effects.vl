// D17422: a `?.` chain whose leaf field holds the `null` unit is `null`, so `?? g()` takes `g()`.
// The receiver's call runs once, before the default, at the head of a nested chain; `g` runs once,
// and only where the chain is `null` (the `name` leaf, a live string, never calls it).
// @run
// @log mk
// @log g
// @log x
// @log none
// @log g
// @log x
// @log mk
// @log n
// @log mk
// @log true
type U = { name: string, f: null }
type W = { u: U }
function mk(): W | null {
  print("mk")
  return { u: { name: "n", f: null } }
}
function none(): W | null {
  print("none")
  return null
}
function g(): string | null {
  print("g")
  return "x"
}
print(mk()?.u.f ?? g())
print(none()?.u.f ?? g())
print(mk()?.u.name ?? g())
const s = mk()?.u.f
print(s == null)
