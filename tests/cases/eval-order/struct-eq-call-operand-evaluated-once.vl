// A struct `==` evaluates a call operand once, whatever the field count, nesting, short-circuit
// or nullability, though the compare reads the operand once per field, and a compare nested in
// an operand does not clobber the outer one's staged operand (D17022).
type I = { x: i32, y: i32 }
type P = { a: I, b: i32, c: i32 }
let n = 0
function mk(k: i32): P {
  n = n + 1
  return { a: { x: k, y: 1 }, b: 1, c: 1 }
}
function mkn(k: i32): P | null {
  n = n + 1
  if k == 0 { return null }
  return { a: { x: k, y: 1 }, b: 1, c: 1 }
}
function pick(t: boolean): P {
  if t { return { a: { x: 1, y: 1 }, b: 1, c: 1 } }
  return { a: { x: 9, y: 9 }, b: 9, c: 9 }
}
const q: P = { a: { x: 1, y: 1 }, b: 1, c: 1 }
print(mk(1) == q)
print(n)
print(mk(2) == q)
print(n)
print(q == mk(1))
print(n)
print(mk(1) != q)
print(n)
print(mkn(1) == mkn(1))
print(n)
print(mkn(0) == mkn(1))
print(n)
print(mkn(0) == mkn(0))
print(n)
print(mk(1) == pick(mk(2) == mk(2)))
print(mkn(1) == pick(mkn(2) == mk(2)))
print(n)
