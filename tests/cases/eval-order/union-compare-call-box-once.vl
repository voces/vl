// @run
// @log true
// @log true
// @log true
// @log 3
// A union compare whose box is a call evaluates the call once, on each of legacy's arms: the
// stashed arm (the operand's arm present), the variant door (a record operand), and an unnamed
// union's compare.
type P = { x: i32 }
type Q = { y: string }
type R = P | Q
type U = i32 | string | null
let n = 0
function mkU(): U { n = n + 1; return "s" }
function mkR(): R { n = n + 1; const p: P = { x: 3 }; return p }
function mkA(): i32 | string { n = n + 1; return 4 }
function arm(): boolean { return mkU() == "s" }
function rec(p: P): boolean { return mkR() == p }
function anon(): boolean { return mkA() == 4 }
print(arm())
print(rec({ x: 3 }))
print(anon())
print(n)
