// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// A fresh record binding delivered into a narrower record, or the one union arm it fits, that
// both drops a field and widens one is built there; the dropped initialiser still runs (D15093).
type A = { k: i32, legs: i64 }
type B = { s: string }
type Pet = A | B
let n = 0
function f(): boolean {
  n = n + 1
  return true
}
function toRec(): A {
  const sv = { k: 1, legs: 4, purr: f() }
  return sv
}
print(toRec().legs + 1)
function toArm(): Pet {
  const sv = { k: 1, legs: 4, purr: f() }
  return sv
}
const p = toArm()
if p is A { print(p.legs + 1) }
const sv = { k: 1, legs: 4, purr: f() }
const x: A = sv
print(x.legs + 1)
function takeRec(a: A) { a.legs + 1 }
const s2 = { k: 1, legs: 4, purr: f() }
print(takeRec(s2))
function takeArm(a: Pet) {
  if a is A { return a.legs + 1 }
  return 0
}
const s3 = { k: 1, legs: 4, purr: f() }
print(takeArm(s3))
print(n)
