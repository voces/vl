// @run
// @log true
// @log false
// @log false
// @log true
// @log true
// A struct `==` reads a place on its left before the call on its right runs, so the call's
// write to that place is not seen; on the right a place is read after the call, as written (D17023).
type P = { a: i32, b: i32 }
type R = { p: P }
let p: P = { a: 1, b: 1 }
let pn: P | null = { a: 1, b: 1 }
const r: R = { p: { a: 1, b: 1 } }
function f(): P {
  p = { a: 2, b: 2 }
  return { a: 1, b: 1 }
}
function fn(): P | null {
  pn = null
  return { a: 1, b: 1 }
}
function fr(): P {
  r.p = { a: 3, b: 3 }
  return { a: 1, b: 1 }
}
print(p == f())
print(p != { a: 2, b: 2 })
print(f() == p)
print(pn == fn())
print(r.p == fr())
