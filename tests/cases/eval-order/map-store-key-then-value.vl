// @run
// @log 1
// @log 2
// EVALUATION ORDER IS SOURCE ORDER — the map instance (DECISIONS.md "evaluation
// order"). VL HAS NO MAP LITERAL: a map is `Map()` plus indexed stores, so the
// expression list this member grades is the store's own `m[<key>] = <value>` pair
// — the key is written first and must run first.
let n = 0

function next() {
  n += 1
  n
}

function keyOf() {
  print(next())
  "k"
}

function valOf() {
  next()
}

const m: {[string]: i32} = Map()
m[keyOf()] = valOf()

print(m["k"] ?? 0 - 1)
