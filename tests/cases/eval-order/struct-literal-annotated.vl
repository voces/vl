// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @hint redundant type annotation: `s` is inferred as `{b: i32, a: i32, c: i32}`
// EVALUATION ORDER IS SOURCE ORDER — the struct-literal instance at its ANNOTATED
// spelling, plus the RETURN position (D1510). Both faces of the gap land in the
// same clause and both were wrong: an annotation pins the literal's ROW, not the
// order its initialisers run in.
type S = { b: i32, a: i32, c: i32 }

let n = 0

function next() {
  n += 1
  n
}

function mk(): S {
  return { b: next(), a: next(), c: next() }
}

const s: S = { b: next(), a: next(), c: next() }

print(s.b)
print(s.a)
print(s.c)

const t = mk()

print(t.b)
print(t.a)
print(t.c)
