// @run
// @log 7
// @log 67
// An indexed store whose right-hand side REALLOCATES the receiver's backing. The store must
// take its array reference AFTER the call, or the write lands in the backing the call replaced
// and is lost — `xs[1]` would read 0. This is the list flavour of the #918 eval-order family,
// and it is the precondition the rep tree's three fused child stores depend on.

const xs = [0, 0, 0]

function grow() {
  let i = 0
  while i < 64 {
    xs.push(9)
    i = i + 1
  }
  7
}

xs[1] = grow()
print(xs[1])
print(xs.length)
