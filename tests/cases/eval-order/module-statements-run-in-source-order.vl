// @run
// @log opt
// @log 11
// @log v
// @log 5
// @log block
// @log 21
// @log 26
// @log 31
// @log 2
// Module-level statements and binding initialisers run in the order they are written, whatever
// a statement between them lowers to: a `?.` call, a bare block, and a block whose binding a
// closure captures each sit before a write and a binding that reads what the write changed.
let x = 1
const xs: i32[] | null = [1]

function bump(tag: string) {
  print(tag)
  x = x + 10
  return 0
}

xs?.push(bump("opt"))
const a = x
print(a)

const n: {[i32]: string} = Map()
n[1] = "v"
const q = n[1]
print(q ?? "null")

let w = 1
{
  w = w + 0
}
w = 5
const y = w
print(y)

{
  print("block")
  x = x + 10
}
const b = x
print(b)

{
  let c = 0
  const h = () => {
    c = c + 5
  }
  h()
  x = x + c
}
const d = x
print(d)

x = x + 5
const e = x
print(e)

const m: {[string]: i32} = Map()
m["k"] = 1
{
  m.delete("none")
}
m.delete("k")
m["j"] = 2
m["i"] = 3
const ks = m.keys()
print(ks.length)
