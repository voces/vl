// @run
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log ooobbhnwbbor
// A union `==` runs an operand with effects whatever arm the box holds, once and in source order:
// a call, a field read off a call, either side, a box that is a call, and a compare nested in an
// operand (D17068).
type U = i32 | string
type W = i32 | boolean | null
type H = { k: string }
let tr = ""
const gu: U = 1
const gw: W = null
function bx(): U {
  tr = tr + "b"
  return gu
}
function wx(): W {
  tr = tr + "w"
  return gw
}
function ok() {
  tr = tr + "o"
  return "s"
}
function oh(): H {
  tr = tr + "h"
  return { k: "s" }
}
function nb(): boolean | null {
  tr = tr + "n"
  return null
}
function wrap(b: boolean) {
  tr = tr + "r"
  return if b { "s" } else { "t" }
}
function g(u: U) { return u == ok() }
print(g(1))
print(g("s"))
print(ok() != bx())
print(bx() == oh().k)
print(nb() == wx())
print(bx() == wrap(bx() == ok()))
print(tr)
