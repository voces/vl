// @run
// @log 102
// @log 304
// EVALUATION ORDER IS SOURCE ORDER — the UFCS instance (DECISIONS.md "evaluation
// order"). `x.f(y)` is `f(x, y)`, and the RECEIVER is written first: the rewrite
// that moves it into argument position must keep it there, ahead of the arguments.
let n = 0

function next() {
  n += 1
  n
}

function combine(self: i32, other: i32) {
  self * 100 + other
}

print(next().combine(next()))
print(next().combine(next()))
