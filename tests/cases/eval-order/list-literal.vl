// @run
// @log 1
// @log 2
// @log 3
// EVALUATION ORDER IS SOURCE ORDER — the list-literal instance (DECISIONS.md
// "evaluation order"). A list literal pushes its elements in the order it stores
// them, so this member was already correct when D1510 found the struct-literal one
// wrong; it is here so the next lowering that changes element delivery is graded.
let n = 0

function next() {
  n += 1
  n
}

const xs = [next(), next(), next()]

print(xs[0])
print(xs[1])
print(xs[2])
