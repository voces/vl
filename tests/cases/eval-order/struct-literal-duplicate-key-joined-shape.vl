// @run
// @hint redundant type annotation: `e` is inferred as `i32`
// @log 1
// @log 2
// @log 1
// @log 3
// @log 4
// @log 9
// @log 3
// @log 3
// @log 4
// @log 9
// @log 3
// @log 1
// @log 2
// @log 1
// @log 1
// @log 3
// @log 4
// @log 3
// @log 3
// @log 4
// @log 5
// @log 5
// Two literals repeating a key a different number of times join to one shape, and each still runs
// every initialiser exactly once: the one with more duplicates than the shape dropped the extras,
// and the one with fewer was refused at emit (D3484).
function e(n: i32): i32 {
  print(n)
  n
}
function mk(c: boolean) {
  if c { { a: e(1), a: e(2) } } else { { a: e(3), a: e(4), a: e(9) } }
}
print(mk(true).a)
print(mk(false).a)
function mk2(c: boolean) {
  if c { { a: e(3), a: e(4), a: e(9) } } else { { a: e(1), a: e(2) } }
}
print(mk2(true).a)
print(mk2(false).a)
const xs = [{ a: e(1) }, { a: e(3), a: e(4) }]
print(xs[1].a)
function mk3(c: boolean) {
  if c { return { a: e(1), b: 2 } }
  return { a: e(3), a: e(4), b: e(5) }
}
print(mk3(false).b)
