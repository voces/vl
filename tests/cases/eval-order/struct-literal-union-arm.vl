// @run
// @log 1
// @log 2
// @log 3
// @log 4
// EVALUATION ORDER IS SOURCE ORDER — the UNION-ARM literal (D1510), at both
// spellings of an arm. A variant row's fields are laid out sorted by name too, so
// `{ kind: "rect", w: …, h: … }` is pushed `h, kind, w`: the named-arm face goes
// through `emitVariantStruct` inside the `{tag, value}` box, the anonymous one
// through the nullable-struct niche, and each has its own field loop.
type Rect = { kind: "rect", w: i32, h: i32 }
type Circle = { kind: "circle", r: i32 }
type Shape = Rect | Circle
type Anon = { kind: "rect", w: i32, h: i32 } | null

let n = 0

function next() {
  n += 1
  n
}

const sh: Shape = { kind: "rect", w: next(), h: next() }

if sh is Rect {
  print(sh.w)
  print(sh.h)
}

const an: Anon = { kind: "rect", w: next(), h: next() }

if an != null {
  print(an.w)
  print(an.h)
}
