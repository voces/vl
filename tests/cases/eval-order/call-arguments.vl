// @run
// @log 1
// @log 2
// @log 3
// EVALUATION ORDER IS SOURCE ORDER — the argument-list instance.
// DECISIONS.md "evaluation order"; the family lives in `tests/cases/eval-order/`
// and each member drives the SAME `next()` counter, so a construct that reorders
// its operands prints a permuted sequence instead of failing to compile.
// [D1510](../../../docs/internals/inventory/D1510.md) is the row that found the
// struct-literal member of this family running in LAYOUT order.
let n = 0

function next() {
  n += 1
  n
}

function three(a: i32, b: i32, c: i32) {
  print(a)
  print(b)
  print(c)
}

three(next(), next(), next())
