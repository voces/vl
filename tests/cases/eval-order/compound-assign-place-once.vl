// @run
// @log at1
// @log 7
// @log reg
// @log 496
// @log reg
// @log at2
// @log 1
// @log at0
// @log at1
// @log 10
// @log at0
// @log at0
// @log 6
// @log at1
// @log 11
// @log at1
// @log 12
// @log at1
// @log get
// @log set
// @log 5
// @log row 1
// @log 8
// @log row 0
// @log 2
// A compound write names its place once: a receiver or index with an effect runs once,
// receiver before index, and the read and the write go to the same slot. Every compound
// form shares the rule, `+=` and prefix `++` included, at top level, in a loop, in a
// generic at two instances, in a closure, and through a user `"[]"`/`"[]="` pair,
// and a user `"[]"` in the RECEIVER (`g[1][0] += 5`) is a call like any other.
type Reg = { bits: i32, xs: i32[] }
const reg = { bits: 0xF0, xs: [3, 5, 6] }
const ys = [1, 3, 5]

function at(i: i32) {
  print("at\{i}")
  return i
}

function theReg(): Reg {
  print("reg")
  return reg
}

function shiftAll(xs: i32[]) {
  for i in 0 to 1 { xs[at(i)] <<= 1 }
}

function flip<T>(xs: T[], m: i32) {
  xs.length
  reg.xs[at(0)] ^= m
}

type Bits = { store: i32[] }
function "[]"(self: Bits, i: i32) {
  print("get")
  return self.store[i]
}
function "[]="(self: Bits, i: i32, x: i32) {
  print("set")
  self.store[i] = x
}

ys[at(1)] ^= 4
print(ys[1])
theReg().bits |= 0x100
print(reg.bits)
theReg().xs[at(2)] %= 5
print(reg.xs[2])
shiftAll(reg.xs)
print(reg.xs[1])
flip([1], 5)
flip(["a"], 5)
print(reg.xs[0])
const bump = () => {
  ys[at(1)] += 4
}
bump()
print(ys[1])
++ys[at(1)]
print(ys[1])
const b = { store: [0, 6] }
b[at(1)] ^= 3
print(b.store[1])
type Grid = { rows: i32[][] }
function "[]"(self: Grid, i: i32) {
  print("row \{i}")
  return self.rows[i]
}
const g = { rows: [[1, 2], [3, 4]] }
g[1][0] += 5
print(g.rows[1][0])
++g[0][0]
print(g.rows[0][0])
