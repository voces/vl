// @run
// @log 2
// @log true
// @log s
// @log s
// @log 4
// @log 1
// @log A
// @log 8
// @log 7
// A record copied or built into a union of records whose members share its field names is built
// at the member storing it as it is, read back at its own type through the box.
type A = { x: i32 }
type B = { x: string }
type W = { r: A | B }
function one() { { r: { x: 1 } } }
const a = one()
print(a.r.x + 1)
const w: W = one()
print(w.r is A)
function two() { { r: { x: "s" } } }
const b = two()
print(b.r.x)
const v: W = two()
const vr = v.r
if vr is B { print(vr.x) } else { print("no") }
function many() { [{ r: { x: 1 } }, { r: { x: 2 } }] }
const m = many()
const ws: W[] = many()
const w1 = ws[1].r
if w1 is A { print(w1.x + m.length) } else { print("no") }
// Two members both admitting the record: the one storing it as it is.
type A2 = { x: i32 }
type B2 = { x: i64 }
type W2 = { r: A2 | B2 }
function three() { { r: { x: 1 } } }
const c = three()
print(c.r.x)
const z: W2 = three()
const zr = z.r
if zr is A2 { print("A") } else { print("B") }
// A held literal built into the union, read at its own type.
type J = { j: A | B }
const o = { j: { x: 7 } }
const d: J = o
print(o.j.x + 1)
const dj = d.j
if dj is A { print(dj.x) } else { print("no") }
