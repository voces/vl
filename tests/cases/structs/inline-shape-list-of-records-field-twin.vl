// @run
// @log 20
// @log 30
// @log 2
// D3790: a parameter annotation that spells `St` inline names its `blows` element by shape, so
// its row recorded no `Blow`. The twin test found no row for that element and kept the two
// layouts apart: a declared `St[]` failed to validate, an inferred one refused to emit.
import { toString } from "std:fmt"

type Blow = { tick: i32, dmg: i32 }
type St = { key: i32, blows: Blow[] }
function f(x: { key: i32, blows: { tick: i32, dmg: i32 }[] }[]) {
  return x[1].blows[0].tick
}
function g(x: { key: i32, rows: { tick: i32, dmg: i32 }[][] }[]) {
  return x[0].rows[1].length
}
function mk(k: i32): St { return { key: k, blows: [{ tick: k * 10, dmg: 1 }] } }
function viaDeclared(xs: St[]) { return f(xs) + 10 }
type Grid = { key: i32, rows: Blow[][] }
const a = [mk(1), mk(2), mk(3)]
const gs: Grid[] = [
  {
    key: 1,
    rows: [[], [{ tick: 1, dmg: 1 }, { tick: 2, dmg: 1 }]],
  },
]
print(f(a).toString())
print(viaDeclared(a).toString())
print(g(gs).toString())
