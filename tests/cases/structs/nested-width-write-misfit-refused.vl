// @error `u` is `sv` itself, whose `pet` also stores `purr`
// A write through a binding that took a wider existing record at its own type must fit that
// record's layout: the annotation does not describe the storage (D3431).
const sv = { pet: { legs: 4, purr: true } }
const u: { pet: { legs: i32 } } = sv
print(sv.pet.purr)
u.pet = { legs: 3 }
