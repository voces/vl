// @run
// @log 3
// @log -1
// @log 12
// @log 7
// @log 14
// @log 5
// @log 6
// @log 21
// @log 2585.5
// The struct ROW behind a `S | null` annotation is resolved from the checker's ARENA type for
// the annotation NODE (`nodeRepTyIxOf` -> `TyNullable.nInner` -> `repRowOfTyStruct`), not by
// re-parsing the spelling. `nulBaseStructRow` is the one home the three nullable-struct row
// lookups share — `retNulRefIndex` (a nullable-struct RETURN / local annotation),
// `retStructIndex` (its tail) and `paramStructIndex` (a nullable-struct PARAM) — and all three
// held the type-annotation node index and threw it away at that boundary. This pins every
// position the arena rung answers in, plus the two families that must keep falling through it.
//
// The row a nullable annotation resolves to picks the heap type and FIELD LAYOUT of every read
// through it, so a wrong row is a wrong `struct.get` index (or invalid wasm), not a soft miss.
//
// STRUCTURAL TWINS (`Pt`/`Vec`: same fieldset, same field codes, distinct names) are the case
// where a row pick is observable: they share one WasmGC heap type, so the pick must still read
// the right FIELD. `Box` nests a nullable-struct FIELD (the code-15 referenced-layer guard).
// The INLINE-SHAPE nullable (`{f: f32} | null`) is the measured case where the arena rung
// DECLINES and the `repRowOfName` name rung is still the answering one — it must keep working.

type Pt = { x: i32, y: i32 }
type Vec = { x: i32, y: i32 }
type Box = { p: Pt | null }

// nullable-struct PARAM  -> paramStructIndex -> nulBaseStructRow
function px(p: Pt | null): i32 {
  if p != null {
    return p.x
  }
  return -1
}

// nullable-struct RETURN -> retNulRefIndex / retStructIndex -> nulBaseStructRow
function mkPt(n: i32): Pt | null {
  if n > 0 {
    return { x: n, y: n + 1 }
  }
  return null
}

// The structural TWIN, same three positions.
function vy(v: Vec | null): i32 {
  if v != null {
    return v.y
  }
  return -1
}

function mkVec(n: i32): Vec | null {
  if n > 0 {
    return { x: n * 2, y: n }
  }
  return null
}

// A nullable-struct field read through a nested struct (code-15 referenced layer).
function boxX(b: Box): i32 {
  const q = b.p
  if q != null {
    return q.x
  }
  return -1
}

// The INLINE-SHAPE nullable — the arena rung declines here; the name rung answers.
function inl(): {f: f32} | null {
  return { f: 2585.5 }
}

function go() {
  print(px({ x: 3, y: 4 })) // 3
  print(px(null)) // -1

  // nullable-struct LOCAL annotation, bound from a call.
  const a: Pt | null = mkPt(12)
  if a != null {
    print(a.x) // 12
  }

  // the TWIN: reads y, not x — a wrong row pick would surface here.
  const b: Vec | null = mkVec(7)
  if b != null {
    print(b.y) // 7
    print(b.x) // 14
  }

  print(vy({ x: 99, y: 5 })) // 5

  print(boxX({ p: { x: 6, y: 8 } })) // 6
  print(boxX({ p: null }) + 22) // 21

  const c = inl()
  if c != null {
    print(c.f) // 2585.5
  }
}

go()
