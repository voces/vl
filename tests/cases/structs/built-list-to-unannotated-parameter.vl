// @run
// @log null
// @log null
// @log 1
// @log null
// @log 1
// A list a kept maker's build stores at a wider record, handed to an un-annotated parameter, is
// read at that build in the callee's instance, through a local copy too, alongside a call handing
// the list's own record (D16772).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
print(dA.f)
const src = [mk2()]
function take(a) {
  const v = a
  print(v[0].f)
  print(v.length)
}
take(src)
take([{ f: null }])
