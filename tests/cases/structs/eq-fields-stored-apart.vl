// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log L
// @log R
// @log false
// Two records of one field set whose fields are stored apart compare field by field, each
// pair by its own `==`: a literal union beside `string`, two widths, a nullable beside a plain
// field, a nested record, and nullable records. Each operand is evaluated once (D16394).
const a: {f: "a" | "b"} = { f: "a" }
const b: {f: string} = { f: "a" }
print(a == b && !(a != b) && a != { f: "b" })
const i: {x: i32, y: {z: i32}} = { x: 1, y: { z: 2 } }
const d: {x: f64, y: {z: f64}} = { x: 1.0, y: { z: 2.0 } }
print(i == d && !(i == { x: 1.0, y: { z: 3.0 } }))
const p: {f: i32} = { f: 1 }
const q: {f: i32 | null} = { f: null }
print(p != q && p == { f: 1 })
const m: {f: i32} | null = null
const n: {f: f64} | null = null
print(m == n)
const o: {f: f64} | null = { f: 1.0 }
print(m != o && p == o)
const l: {f: i32[]} = { f: [1, 2] }
print(l == { f: [1.0, 2.0] })
function left(): {f: i32} {
  print("L")
  return { f: 1 }
}
function right(): {f: f64} {
  print("R")
  return { f: 2.0 }
}
print(left() == right())
