// @run
// @log 1
// @log 1
// @log 0
// @log 2
// @log 3
// @log s
// @log 2.5
// @log false
// @log 2
// @warning `==` on `{v: i32, kids: N[]}` compares every element of its list field `kids`
// A record literal with an empty list field has a shape whether or not anything stores into
// the list: as an un-annotated `Map()` value, at a binding, in a list, as an inferred return,
// pinned by a later push (here, through a call and inside a hole callee), and by an `==`
// against a declared record (D5344, D3745).
const m = Map()
m["k"] = { v: 1, kids: [] }
const x = m["k"]
if x != null { print(x.v) }
const r = { v: 1, kids: [] }
print(r.v)
print(r.kids.length)
const xs = [{ v: 1, kids: [] }, { v: 2, kids: [] }]
print(xs[1].v + xs[0].kids.length)
function f(n: i32) { return { n: n, tags: [] } }
print(f(3).n)
const p = { v: 1, kids: [] }
p.kids.push("s")
print(p.kids[0])
function mkq() { return { v: 1, kids: [] } }
const q = mkq()
q.kids.push(2.5)
print(q.kids[0])
type N = { v: i32, kids: N[] }
const same: N = { v: 1, kids: [{ v: 2, kids: [] }] }
const e = { v: 1, kids: [] }
print(e == same)
function take(a) {
  a.push({ x: 1, ys: [] })
  a[0].ys.push({ z: 2 })
  print(a[0].ys[0].z)
}
take([])
