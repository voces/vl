// @run
// @log 7
// @log 9
// @log 7
// @log 5
// @log hi
// @log 4
// @log 4
// @hint redundant type annotation: `held` is inferred as `{xs: U1}` — remove it to lean on inference
// @hint redundant type annotation: `h` is inferred as `{f: {xs: U2}}` — remove it to lean on inference
// CONTRACT (D1694, D1695): a declared row whose NESTED-struct field names another row may not
// capture an outer literal whose own element row boxes a different member set — the inner
// literal already minted its own row, and re-interning it at the declared element would
// renumber a box's positional tags, which is the one difference a capture cannot paper over.
//
// Two readers, one comparator. `structIndexOfObjCtxGo` resolves a literal NODE and
// `structRowOfObjFieldSet` resolves a recorded TYPE; the second is what an IDENT-valued field
// takes, and `arenaScanIdent` is the cell that goes through it.
//
// AND IT IS A PREFERENCE, NOT A REFUSAL — `widerDelivered` is the floor, and so is
// `reInternWidening`: a literal DELIVERED to a declared row keeps the field-widening and
// field-dropping that row grants, which is why only a box disagreement refutes.
type U1 = i32 | boolean
type U2 = string | boolean
type U3 = i32 | boolean | string
type U5 = string | boolean | i64
type Inner = { xs: U2 }
type InnerC = { xs: U5 }
type H = { f: Inner }
type HC = { f: InnerC }
type Wide = { f: { xs: U3 } }

function u1(): U1 { return 7 }
function u1b(): U1 { return 4 }
function u2(): U2 { return "hi" }
function u3(): U3 { return 9 }
function u1w(): U1 { return 5 }

// Two-member sets: the declared nested row never constructed.
function nestedCapture() {
  const b = { f: { xs: u1() } }
  print(b.f.xs)
}

// Three members differing in a ref member: the wrong tag is a cast failure, not a mis-read.
function nestedCaptureThreeMember() {
  const b = { f: { xs: u3() } }
  print(b.f.xs)
}

// The ARENA reader: the nested field's value is an IDENT, so its element row comes from the
// field-set scan rather than from the literal.
const held: { xs: U1 } = { xs: u1() }
function arenaScanIdent() {
  const b = { f: held }
  print(b.f.xs)
}

// The floor: a declared nested box field WIDER than the value's own union, delivered.
function widerDelivered() {
  const w: Wide = { f: { xs: u1w() } }
  print(w.f.xs)
}

// The declared rows constructed as well, so they are live and still may not capture.
function bothLive() {
  const h: H = { f: { xs: u2() } }
  print(h.f.xs)
  const b = { f: { xs: u1b() } }
  print(b.f.xs)
}

// The second floor: a re-intern that WIDENS a field and DROPS one is what the outer-shape
// boundary accepts, and only a box disagreement may refuse it.
function reInternWidening() {
  const sv = { pet: { legs: 4, purr: true } }
  const u: { pet: { legs: i64 } } = sv
  print(u.pet.legs)
}

nestedCapture()
nestedCaptureThreeMember()
arenaScanIdent()
widerDelivered()
bothLive()
reInternWidening()
