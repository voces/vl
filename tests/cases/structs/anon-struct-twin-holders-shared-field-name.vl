// @run
// @log 7
// @log 4
// @log 8
// @log true
// @log 9
// @log 3
// @log 1.5
// @log 11
// @log hi
// @log 12
// @log ha1
// CONTRACT (D1689): every holder here names its field `xs`, and each pair's ref-list ELEMENT
// differs — so the anonymous row's identity has to carry the element, not just the field name
// and its storage code.
//
// The sibling fixture `anon-struct-list-field-union-and-nullable-element.vl` names five
// different fields precisely to avoid this, so it cannot see the collapse: a second holder
// twinning onto the first's row reads its field against the wrong element, which refuses at
// some spellings and emits invalid wasm at others.
//
// NOTHING HERE MAY DECLARE THE OUTER SHAPE. An unused `type Holder = { xs: A[] }` is the
// rescue, and it would make every read pass for the wrong reason. The reads go THROUGH the
// element and print a value only the right element can produce.
type A = { r: i32 }
type B = { q: i32, tag: string }
type Bi = { r: boolean }
type Circle = { c: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Tri = { t: i32 }
type Other = Tri | Sq

function as1(): A[] { return [{ r: 7 }] }
function bs1(): B[] { return [{ q: 4, tag: "a" }] }
function cs1(): A[] { return [{ r: 8 }] }
function ds1(): Bi[] { return [{ r: true }] }
function shapes(): Shape[] { return [{ c: 9 }] }
function others(): Other[] { return [{ t: 3 }] }
function grids(): f64[][] { return [[1.5]] }
function tallies(): i32[][] { return [[11]] }
function texts(): { [string]: string }[] {
  const m: { [string]: string } = Map()
  m["k"] = "hi"
  return [m]
}
function counts(): { [string]: i32 }[] {
  const m: { [string]: i32 } = Map()
  m["k"] = 12
  return [m]
}
function joins(): ((string) => string)[] { return [(s: string) => s + "1"] }

// Two struct elements with disjoint field names: the oldest reachable spelling.
function structElements() {
  const one = { xs: as1() }
  print(one.xs[0].r)
  const two = { xs: bs1() }
  print(two.xs[0].q)
}

// Two struct elements agreeing on the field NAME and differing in its type: the i32 and the
// boolean slot are one wasm layout apart, so a wrong row here is invalid wasm, not a refusal.
function structElementsSameFieldName() {
  const one = { xs: cs1() }
  print(one.xs[0].r)
  const two = { xs: ds1() }
  print(two.xs[0].r)
}

// Two union-box elements over different member sets.
function unionBoxElements() {
  const one = { xs: shapes() }
  const e1 = one.xs[0]
  if e1 is Circle { print(e1.c) } else { print(0) }
  const two = { xs: others() }
  const e2 = two.xs[0]
  if e2 is Tri { print(e2.t) } else { print(0) }
}

// Two nested-list elements of different width.
function nestedListElements() {
  const one = { xs: grids() }
  print(one.xs[0][0])
  const two = { xs: tallies() }
  print(two.xs[0][0])
}

// Two map elements with different value types.
function mapElements() {
  const one = { xs: texts() }
  const e1 = one.xs[0]["k"]
  if e1 != null { print(e1) }
  const two = { xs: counts() }
  const e2 = two.xs[0]["k"]
  if e2 != null { print(e2) }
}

// A closure element beside a struct element.
function closureElements() {
  const one = { xs: joins() }
  print(one.xs[0]("ha"))
}

structElements()
structElementsSameFieldName()
unionBoxElements()
nestedListElements()
mapElements()
closureElements()
