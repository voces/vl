// @run
// @log true
// @log true
// @log true
// A record literal with no row of its own (`{ r: null }`) beside the union arm it narrows to is
// stored as that arm in a record field: at module scope, bound first, and in a function (D17402).
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: i32 | null }
const o = { v: { r: null } }
print(o.v.r == null)
const c = { r: null }
const p = { v: c }
print(p.v.r == null)
function f() {
  const q = { v: { r: null } }
  print(q.v.r == null)
}
f()
