// @run
// @log 5

// A fifteen-level record whose every level holds the one below twice, built from inferred
// locals: its builder's struct is the one its own arena type interns, not a shallower record's
// past the identity's size cap (D9840). Kept alone, since other uses of `A15` in the same
// module intern it first and hide the fault; the annotated and other-depth controls are in
// `diamond-record-deep.vl`.

type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
type A11 = {l: A10, r: A10}
type A12 = {l: A11, r: A11}
type A13 = {l: A12, r: A12}
type A14 = {l: A13, r: A13}
type A15 = {l: A14, r: A14}

function mk(x: i32): A15 {
  const a0 = { x: x }
  const a1 = { l: a0, r: a0 }
  const a2 = { l: a1, r: a1 }
  const a3 = { l: a2, r: a2 }
  const a4 = { l: a3, r: a3 }
  const a5 = { l: a4, r: a4 }
  const a6 = { l: a5, r: a5 }
  const a7 = { l: a6, r: a6 }
  const a8 = { l: a7, r: a7 }
  const a9 = { l: a8, r: a8 }
  const a10 = { l: a9, r: a9 }
  const a11 = { l: a10, r: a10 }
  const a12 = { l: a11, r: a11 }
  const a13 = { l: a12, r: a12 }
  const a14 = { l: a13, r: a13 }
  return { l: a14, r: a14 }
}

print(mk(5).l.l.l.l.l.l.l.l.l.l.l.l.l.l.l.x)
