// @run
// @log 3
// @log 0
// @log 3
// @log -1
// @log true
// @log false
// @log 4
// @log 0
// CONTRACT (must-RUN): a `?.` in ORDINARY VALUE POSITION — bound to a `const`, and as the
// left operand of a `??` the niche arms dispatch on by TYPE rather than by node shape.
// Both yield the chain's own `F | null` value, at the rep that type has.
//
// Before this, `emitExpr` had NO `OptMember` arm at all: `?.` was reachable only where a
// bigger pattern consumed it whole (`emitCoalesce`'s fused arms, the `!= null` guards).
// Everything else fell out of `emitExpr`'s trailing catch-all, which reported
// `emitProgram: unsupported expression in return` — a message written for the return arm,
// on a program with no `return` in it, anchored at the enclosing FUNCTION's own header
// line because the catch-all raised it with no node.
//
// THE REP IS THE DISPATCH, not the field: `i32 | null` has no spare value to niche into
// and reps as the value-union BOX, while `boolean | null` is the i32 sentinel-2 niche.
// The box case is also why the CHECKER has to export the binding's inferred union
// (`inferLetNameOf` → `nliInferOptChainLet`): `i32 | null` here is synthesized from
// `S | null` plus an `i32` field and is spelled in no annotation, so nothing else in the
// program can mint the box heap type.
type S = { w: i32, b: boolean }

function bound(a: S | null) {
  const t = a?.w
  print(t ?? 0)
}

function guarded(a: S | null) {
  const t = a?.w
  if t != null { print(t) } else { print(-1) }
}

// The `boolean` leaf goes through the niche, and reaches `emitExpr` from a DIFFERENT
// caller: `emitCoalesce` dispatches `?.b ?? false` on the operand's TYPE (`exprNulBool`)
// long before its own `?.` arms, so this spelling was the same catch-all reject with no
// `const` binding anywhere in it.
function boolLeaf(a: S | null) { print(a?.b ?? false) }

// A nested chain through a `S | null` link still folds a null at either level.
type Outer = { inner: S | null }
function nested(o: Outer) {
  const t = o.inner?.w
  print(t ?? 0)
}

bound({ w: 3, b: true })
bound(null)
guarded({ w: 3, b: true })
guarded(null)
boolLeaf({ w: 1, b: true })
boolLeaf(null)
nested({ inner: { w: 4, b: false } })
nested({ inner: null })
