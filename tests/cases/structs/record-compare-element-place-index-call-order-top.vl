// @run
// @log true
// @log 1
// @log true
// @log 1
// A global index moved by a call on either side of a top-level compare: a call on the right
// stages both sides, read before it; one on the left runs first, the element read after it.
type P = { x: i32, y: i32 }
const gs: (P | null)[] = [{ x: 1, y: 2 }, { x: 1, y: 2 }]
let i = 0
function moveTo(k: i32, g: P | null) {
  i = k
  return g
}
i = 0
print(gs[i] == moveTo(1, gs[0]))
print(i)
i = 0
print(moveTo(1, gs[1]) == gs[i])
print(i)
