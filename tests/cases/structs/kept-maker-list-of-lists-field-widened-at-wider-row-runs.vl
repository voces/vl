// @run
// @log 4
// @log 4
// @log 1.5
// @log 5
// @log 6
// @log 7
// @log 3
// A kept maker whose record holds a list of lists of numbers, delivered at a row storing them
// wider: the call copy converts each level element by element, ragged or three deep, and the
// unannotated call keeps its own row (D15723).
type K = { xs: i64[][] }
function mk() { { xs: [[4]] } }
const _k: K = mk()
const y = mk()
print(y.xs[0][0])
print(_k.xs[0][0])
type F = { xs: f64[][] }
function mf() { { xs: [[4, 5], [6]] } }
const _f: F = mf()
const z = mf()
print(_f.xs[1][0] / 4.0)
print(z.xs[0][1])
type T = { xs: i64[][][] }
function mt() { { xs: [[[4], [5, 6]], [[7]]] } }
const _t: T = mt()
const w = mt()
print(_t.xs[0][1][1])
print(_t.xs[1][0][0])
_t.xs[0].push([9])
print(_t.xs[0].length + w.xs.length - 2)
