// @run
// @log true
// @log NULL
// @log 75.5
// A `S | null` annotation written with the WHOLE-SPAN inline spelling beside its declared
// twin (`type T0 = {f: {f: boolean | null} | null}`). The nullable-struct annotation path
// resolved its base through the LENIENT fieldset scan, which merged the outer row onto its
// same-fieldset INNER row (`{f: boolean | null}`), so a field read on the param found the
// wrong layout ("field access receiver is not a struct") and a nested-map twin in the
// return position rejected outright ("nested struct fields are not supported").
// `shapeFieldTypeCompat`'s whole-span-vs-scalar arm (#996) used to mask this by making the
// scan decline; the three nullable-annotation resolvers (`paramStructIndex`,
// `retStructIndex`, `retNulRefIndex`) now consult `repRowOfName`'s canonical key instead,
// which separates the twins by the FULL nested field type — so the arm could retire AND
// these spellings graduated from loud rejects to working code.
type T0 = { f: { f: boolean | null } | null }
type T1 = { f: { f: { [string]: f64 } } }

// PARAM position: whole-span spelling, value built as the declared twin.
function useTwin(p: { f: { f: boolean | null } | null } | null) {
  const t0 = p
  if t0 != null {
    const t1 = t0.f
    if t1 != null {
      const t2 = t1.f
      if t2 != null { print(t2) } else { print("NULL") }
    } else {
      print("NULL")
    }
  } else {
    print("NULL")
  }
}

// RETURN position: whole-span spelling over a nested-MAP-field twin.
function makeIt(): { f: { f: { [string]: f64 } } } | null {
  const h0: { [string]: f64 } = Map()
  h0["k"] = 75.5
  return { f: { f: h0 } }
}

function go() {
  const w: T0 | null = { f: { f: true } }
  useTwin(w)
  const n: T0 | null = { f: null }
  useTwin(n)
  const v: { f: { f: { [string]: f64 } } } | null = makeIt()
  if v != null { print(v.f.f["k"] ?? 0.0) } else { print("NULL") }
}

go()
