// @run
// @log 7
// @log 7
// @log q
// @log 9
// @log 9
// @log 8
// @log 7
// @log 7
// A literal binding built at a record whose field is a union of records, read and written at its
// own type through that field: the read is the member with its field names, out of the box.
type Cir = { f: i32, t: string }
type Sq = { s: i32 }
type J = { j: Cir | Sq }
const o = { j: { f: 7, t: "q" } }
const d: J = o
print(o.j.f)
const k = o.j
print(k.f)
print(o.j.t)
o.j.f = 9
print(o.j.f)
const dj = d.j
if dj is Cir { print(dj.f) }
type K = { a: { j: Cir | Sq } }
const p = { a: { j: { f: 7, t: "r" } } }
const e: K = p
print(p.a.j.f + 1)
function mk() { { j: { f: 7, t: "s" } } }
const q = mk()
const g: J = q
print(q.j.f)
const ws: J[] = [o]
print(ws.length + o.j.f - 3)
