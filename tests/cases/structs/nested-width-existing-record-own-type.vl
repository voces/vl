// @run
// @log true
// @log 4
// @log 5
// @log true
// @log 4
// @log 2
// An existing record whose nested record carries a field the destination's nested record does not
// name is taken at its own type (D3431): the annotation is a bound, the binding is the record
// itself, so a write through it reaches the source and no field is lost.
const sv = { pet: { legs: 4, purr: true } }
const u: { pet: { legs: i32 } } = sv
print(sv.pet.purr)
print(u.pet.legs)
u.pet.legs = 5
print(sv.pet.legs)

type Pet = { legs: i32 }
type Holder = { pet: Pet }
function mk(): { pet: { legs: i32, purr: boolean } } {
  return { pet: { legs: 4, purr: true } }
}
function mkW(): { pet: { legs: i32, wings: i32 } } {
  return { pet: { legs: 2, wings: 2 } }
}
function show(h: Holder) { print(h.pet.legs) }
const m = mk()
const h: Holder = m
print(h.pet.purr)
show(m)
show(mkW())
