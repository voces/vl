// @run
// @log ia
// @log ia
// @log ia
// @log eq-ok
// @log ka
// @log n-eq-ok
// @log na
// @log null-ok
// @log kc
// @log mb
// THE WIDENED SET: struct fields whose type IS a literal union but which the ALIAS
// REGISTRY (`cUnionTyIxs`) does not hold. The field declaration ladder asks
// `nodeTyIsLitUnionStructural` — an ARENA question (`tyIsLitUnion`) — where it used to ask
// `nodeTyIsLitUnionAlias`, which additionally required the type to be a REGISTERED alias
// index. Three shapes sit in the difference and each one is exercised below:
//
//   1. a BARE INLINE union (`f: "ia" | "ib"`) is never registered at all;
//   2. a NARROWED alias (`K & !"kb"`) is REBUILT at a fresh arena index, so the registry's
//      index compare misses even though `K` itself is registered;
//   3. an inline union sitting ALONGSIDE a registered one in the same struct, which pins
//      that the two field kinds coexist rather than one spelling deciding the struct.
//
// The ladder alone is not enough, and that is the point of pinning all three: widening it
// without also recording the elem name from the ARENA leaves the field DECLARED as an i32
// atom while construction still builds a string, and 1, 2 and 3 each emit invalid wasm
// (`type mismatch: expected i32, found (ref $type)`). `tyNameOf` is position-dependent for
// a literal union (`ctxKeepsLitUnion`), so for exactly these three it renders `string` and
// the name-based recording records nothing; `litUnionAliasNameOfTy` /
// `litUnionInlineNameOfTy` answer FROM THE TYPE, which is why the pair ships together.
//
// Shape 4 below — the inline NULLABLE union — is the control: it takes the code-30 niche
// arm, is unaffected by either half, and emits identically before and after.
//
// The assertion is AGREEMENT PLUS REP: every arm round-trips its value through
// construction, field read, assignment, comparison and a call, and the field's storage
// type is the i32 atom rather than a string reference.
type K = "ka" | "kb" | "kc"
type N = K & !"kb"

type Inline = { f: "ia" | "ib" }
type Narrow = { f: N }
type NulIn = { f: ("na" | "nb") | null }
type Mixed = { a: K, b: "ma" | "mb" }

function takesInline(v: "ia" | "ib"): string { v }

function main() {
  const i: Inline = { f: "ia" }
  print(i.f)
  print(takesInline(i.f))
  const i2: Inline = { f: "ib" }
  i2.f = "ia"
  print(i2.f)
  if i2.f == "ia" { print("eq-ok") }

  const n: Narrow = { f: "ka" }
  print(n.f)
  if n.f == "ka" { print("n-eq-ok") }

  const nu: NulIn = { f: "na" }
  if nu.f != null { print(nu.f) }
  const nu2: NulIn = { f: null }
  if nu2.f == null { print("null-ok") }

  const m: Mixed = { a: "kc", b: "mb" }
  print(m.a)
  print(m.b)
}
main()
