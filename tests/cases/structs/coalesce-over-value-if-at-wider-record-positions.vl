// @run
// @hint redundant type annotation: `top` is inferred as `{f: i32 | null}`
// @log 74
// @log 5
// @log 6
// @log 72
// @log 5
// @log 0
// @log 9
// @log 71
// A `??` whose left operand is a value `if` of record literals, delivered to a record storing a
// field wider (D3389): the `if` is built at that record's nullable, at an argument, a return, an
// `else if` chain, module scope and a binding later written `null`.
type J = { f: i32 | null }
function show(j: J) { print(j.f ?? 72) }
function arg(y: i32) { show((if y < 0 { { f: 5 } } else { null }) ?? { f: 6 }) }
function ret(y: i32): J {
  return (if y < 0 { { f: 5 } } else { null }) ?? { f: null }
}
function chain(y: i32) {
  const d: J = (if y < 0 { { f: 5 } } else if y == 0 { { f: 0 } } else { null })
    ?? { f: 9 }
  print(d.f ?? 73)
}
function rewritten(y: i32) {
  const d: J = (if y < 0 { { f: 5 } } else { null }) ?? { f: 9 }
  d.f = null
  print(d.f ?? 71)
}
const top: J = (if 1 < 0 { { f: 5 } } else { null }) ?? { f: null }
print(top.f ?? 74)
arg(-1)
arg(1)
show(ret(1))
show(ret(-1))
chain(0)
chain(2)
rewritten(3)
