// @run
// @log none
// @log 7
// @log none
// @log 6
// @log none
// @log none
// @log 1
// @hint Intentionally-unused variable `_sh` (leading `_` marks it unused)
// D1568 — `w.f = null` OVER A NULLABLE-STRUCT FIELD. `emitObjField` seeds `pendingStructIdx`
// from `sFieldTgtStructIdx` for a code-15 (nested-struct / nullable-struct) field, so
// `{ f: null }` lowers; the field-WRITE arm of `emitAssign` — the other half of every field
// code — never seeded it, so the `null` reached `emitNullLitNode` with every seed unset and
// refused loudly on a `vl check`-clean program (left loud by D1563, previously papered over
// by the leaked variant seed).
//
// The two halves of a field code have to be wired together: that is the lesson the code-20
// arm beside this one already records, and this is its code-15 instance.

type C = { a: i32, b: i32 }
type Circle = { r: i32 }
type Sq = { w: i32 }
type Shape = Circle | Sq

// (1) THE FILED SHAPE — store `null` over a live value, read it back, then store a value
// back over the null. Both directions, so a wrong heap type cannot pass by reading null.
type W = { f: C | null }
const w: W = { f: { a: 1, b: 2 } }
w.f = null
if w.f != null { print(w.f.a) } else { print("none") }
w.f = { a: 7, b: 8 }
if w.f != null { print(w.f.a) } else { print("none") }

// (2) THE `nulvariant` NICHE — `Circle` is an ARM of `Shape`, so the field cell is a
// `(ref null $uVarHeap[vi])`. `sFieldTgtStructIdx`'s arena leg resolves the arm's layout
// twin row, which is the SAME row the construct-side seed uses.
type V = { g: Circle | null }
const _sh: Shape = { r: 3 }
const vv: V = { g: { r: 1 } }
vv.g = null
if vv.g != null { print(vv.g.r) } else { print("none") }
vv.g = { r: 6 }
if vv.g != null { print(vv.g.r) } else { print("none") }

// (3) TWO DIFFERENT STRUCT ROWS in one shape, stored in sequence: a seed that outlived its
// store would put the first row's heap type in the second's cell (D1563's family, at the
// field layer). Identical field lists are still DISTINCT heap types.
type D = { a: i32, b: i32 }
type X = { f: C | null, g: D | null }
const x: X = { f: { a: 1, b: 2 }, g: { a: 3, b: 4 } }
x.f = null
x.g = null
if x.f != null { print(x.f.a) } else { print("none") }
if x.g != null { print(x.g.a) } else { print("none") }

// (4) THE STORE INSIDE A FUNCTION, over a parameter — the position the module-scope cells
// above do not cover.
function clear(t: W) {
  t.f = null
}
const w2: W = { f: { a: 1, b: 2 } }
clear(w2)
if w2.f != null { print(0) } else { print(1) }
