// @run
// @log 4
// @log 4
// @log 7
// A kept maker delivered at a row whose nullable field is one record down: the call copy
// boxes the nested field, and the unannotated call keeps its own row.
type J = { f: i64 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
const y = mk()
print(y.j.f)
print(_k.j.f ?? 0)
type L = { j: { f: i32 | null } }
function mk2() { { j: { f: 7 } } }
const l: L = mk2()
print(l.j.f ?? 0)
