// Regression: two ANONYMOUS object literals sharing a field-name SET collapsed onto
// one interned shape. `structIndexOfObjCtxGo` scanned the struct table by field NAME
// with only a float and an i64 arm to split candidates, so `{ v: 1 }` beside
// `{ v: "s" }` matched the same `#anon` row and the second literal's string ref was
// stored through the first's i32 field — `vl check` clean, and a module the engine
// rejects (`type mismatch: expected i32, found (ref $type)`). Every value axis the two
// existing arms did not name behaved the same way: string, boolean, i32-list and
// nested-struct values all merged onto whatever row the fieldset happened to reach
// first. `anonValueFitsField` is the general (value code, field code) rule those two
// arms are special cases of.
//
// DELIBERATELY UNANNOTATED THROUGHOUT: an annotation anywhere in the module mints a
// slot an inferred binding can succeed through for the wrong reason, which would let
// this file pass without the discriminator. Every row here is minted by a literal.
// @run
// @log 1
// @log s
// @log true
// @log 7
// @log 9
// @log 2
// @log 1
// @log z
// @log 11
// @log 22
// @log a
// @log 33
const a = { v: 1 }
const b = { v: "s" }
const c = { v: true }
const d = { v: [7] }
const e = { v: { q: 9 } }
print(a.v)
print(b.v)
print(c.v)
print(d.v[0])
print(e.v.q)
// TRANSITIVE: a third literal must rejoin the FIRST row, not the second's.
const f = { v: 2 }
print(f.v)
// NESTED: the outer literals share `{n}` and both code the field a struct ref, so the
// outer row has to agree on WHICH struct too — else the second outer literal stores a
// `ref {p: string}` into a field typed `ref {p: i32}`.
const n1 = { n: { p: 1 } }
const n2 = { n: { p: "z" } }
print(n1.n.p)
print(n2.n.p)
// A SHARED field beside the differing one: the collision is on the field-name SET, so
// the row that matches by name still has to be refuted field by field.
const g = { k: 11, v: 22 }
const h = { k: "a", v: 33 }
print(g.k)
print(g.v)
print(h.k)
print(h.v)
