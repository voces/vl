// @run
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 10
// @log 11
// @hint redundant type annotation: `leaf` is inferred as `i32`
// @hint redundant type annotation: `count` is inferred as `i32`

// A record whose every level holds the one below twice, fifteen levels deep, so its spelling
// doubles per level: built from inferred locals and from annotated ones, held in a map of
// nullable functions over it (D9771) and in a list literal of them beside `null` (D9810).
// Each prints a value read back from the deepest leaf. `B8` is the control below the depth
// where a record is keyed by its arena type rather than its spelling; the inferred builder
// alone, which is what fails, is `diamond-record-inferred-locals.vl` (D9840).

type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
type A11 = {l: A10, r: A10}
type A12 = {l: A11, r: A11}
type A13 = {l: A12, r: A12}
type A14 = {l: A13, r: A13}
type A15 = {l: A14, r: A14}

function mk(x: i32): A15 {
  const a0 = { x: x }
  const a1 = { l: a0, r: a0 }
  const a2 = { l: a1, r: a1 }
  const a3 = { l: a2, r: a2 }
  const a4 = { l: a3, r: a3 }
  const a5 = { l: a4, r: a4 }
  const a6 = { l: a5, r: a5 }
  const a7 = { l: a6, r: a6 }
  const a8 = { l: a7, r: a7 }
  const a9 = { l: a8, r: a8 }
  const a10 = { l: a9, r: a9 }
  const a11 = { l: a10, r: a10 }
  const a12 = { l: a11, r: a11 }
  const a13 = { l: a12, r: a12 }
  const a14 = { l: a13, r: a13 }
  return { l: a14, r: a14 }
}

function mkAnn(x: i32): A15 {
  const a0: A0 = { x: x }
  const a1: A1 = { l: a0, r: a0 }
  const a2: A2 = { l: a1, r: a1 }
  const a3: A3 = { l: a2, r: a2 }
  const a4: A4 = { l: a3, r: a3 }
  const a5: A5 = { l: a4, r: a4 }
  const a6: A6 = { l: a5, r: a5 }
  const a7: A7 = { l: a6, r: a6 }
  const a8: A8 = { l: a7, r: a7 }
  const a9: A9 = { l: a8, r: a8 }
  const a10: A10 = { l: a9, r: a9 }
  const a11: A11 = { l: a10, r: a10 }
  const a12: A12 = { l: a11, r: a11 }
  const a13: A13 = { l: a12, r: a12 }
  const a14: A14 = { l: a13, r: a13 }
  return { l: a14, r: a14 }
}

function leaf(a: A15): i32 { a.l.r.l.r.l.r.l.r.l.r.l.r.l.r.l.x }

print(mk(5).l.l.l.l.l.l.l.l.l.l.l.l.l.l.l.x)
print(leaf(mkAnn(6)))

const m: {[string]: ((a: A15) => i32) | null} = Map()
m["k"] = (a: A15): i32 => leaf(a) + 1
const fm = m["k"]
if fm != null { print(fm(mk(6))) }

const ys: (((a: A15) => i32) | null)[] = [null, (a: A15): i32 => leaf(a) + 2]
for y in ys {
  if y != null { print(y(mkAnn(6))) }
}

function count(fs: (((a: A15) => i32) | null)[]): i32 { fs.length }
print(count([null, leaf, null, leaf, null, leaf, null, leaf, null]))

type B0 = {x: i32}
type B1 = {l: B0, r: B0}
type B2 = {l: B1, r: B1}
type B3 = {l: B2, r: B2}
type B4 = {l: B3, r: B3}
type B5 = {l: B4, r: B4}
type B6 = {l: B5, r: B5}
type B7 = {l: B6, r: B6}
type B8 = {l: B7, r: B7}

function mkB(x: i32): B8 {
  const b0 = { x: x }
  const b1 = { l: b0, r: b0 }
  const b2 = { l: b1, r: b1 }
  const b3 = { l: b2, r: b2 }
  const b4 = { l: b3, r: b3 }
  const b5 = { l: b4, r: b4 }
  const b6 = { l: b5, r: b5 }
  const b7 = { l: b6, r: b6 }
  return { l: b7, r: b7 }
}

const mb: {[string]: ((b: B8) => i32) | null} = Map()
mb["k"] = (b: B8): i32 => b.r.r.r.r.r.r.r.r.x
const fb = mb["k"]
if fb != null { print(fb(mkB(10))) }
print(mkB(11).l.r.l.r.l.r.l.r.x)
