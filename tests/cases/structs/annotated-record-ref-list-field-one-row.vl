// @run
// @log 1
// @log 7
// @log 2
// @log 9
// @log b
// @log 3
// @log 5
// @log 2
// @hint redundant type annotation: `firstX` is inferred as `i32`
// @hint redundant type annotation: `deep` is inferred as `i32`
// @hint redundant type annotation: `q` is inferred as `{f: {x: i32}[], n: i32}`
// @hint redundant type annotation: `t` is inferred as `{f: i32[][], n: i32}`
// One annotated record type with a list field takes one struct row however many bindings,
// returns and closure results spell it (D10771). Each value crosses to another spelling of
// the same type and is read and written there, at one and two list levels.
function firstX(r: { f: { x: i32 }[], n: i32 }): i32 { return r.f[0].x }
function deep(r: { f: i32[][], n: i32 }): i32 { return r.f[0][0] }
const r: { f: { x: i32 }[], n: i32 } = { f: [{ x: 1 }], n: 1 }
const q: { f: { x: i32 }[], n: i32 } = r
q.f[0].x = 7
print(r.n)
print(firstX(r))
const s: { f: i32[][], n: i32 } = { f: [[2]], n: 2 }
print(deep(s))
const t: { f: i32[][], n: i32 } = s
t.f[0][0] = 9
print(deep(s))
const u: { f: ("a" | "b")[][], n: i32 } = { f: [["a"]], n: 3 }
const mk = (): { f: ("a" | "b")[][], n: i32 } => u
mk().f[0][0] = "b"
print(u.f[0][0])
print(mk().n)
const ws: { f: { x: i32 }[], n: i32 }[] = [r, { f: [{ x: 5 }], n: 4 }]
print(firstX(ws[1]))
print(ws[0].f.length + ws[1].f.length)
