// @run
// @log 11
// @log true
// @log 11
// @log true
// Two record literals sharing field names but not a function field's signature share a layout,
// and a call through each reads its own closure's result type (D3190).
const a = { v: 1, f: () => true }
const xs = [{ v: 2, f: () => 11 }]
print(xs[0].f())
print(a.f())
const m: {[string]: { v: i32, f: () => i32 }} = Map()
m.set("k", { v: 2, f: () => 11 })
const q = m.get("k")
if q != null { print(q.f()) }
print(a.f())
