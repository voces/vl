// @run
// @log 7
// @log 8
// @log 7
// @log 9
// @log 9
// A list of record literals delivered to a record with a nullable field keeps that record while
// another binding's adoption is refused for a read of its own: the refusal undoes only the
// binding it blames. Un-annotated and annotated, read by index and by a loop.
type J = { f: i32 | null }
function show(j: J) { print(j.f ?? 0) }
function argument() {
  const r = { f: 7 }
  show(r)
  print(r.f + 1)
}
function listElement() {
  const rs = [{ f: 7 }]
  show(rs[0])
}
function listLoop() {
  const ts: J[] = [{ f: 9 }]
  const us = [{ f: 9 }]
  const e = us[0]
  show(e)
  show(ts[0])
}
argument()
listElement()
listLoop()
