// @run
// @log true
// @log 4
// @log 4
// @log true
// @log true
// @log 1
// @log 4
// @log false
// @log y
// @log 4
// @log y
// @log s
// @log true
// @log 4
// @log true
// @log y
// @log zz
// @log q
// @log a
// @log q
// @log 11
// An `i32`, a `boolean` and a string literal set's atom share field code 0, but two literals
// that differ in which one a field holds are two rows, so each reads back in its own format.
// A literal set's row takes only its own member strings, and a nested row a declared row
// would capture agrees with it on string-ness (D2841).
type K = "x" | "y"
const k: K = "y"
type P = { f: boolean }
const a = { f: true }
const b = { f: 4 }
print(a.f)
print(b.f)
const c = { f: 4 }
const d = { f: true }
print(c.f)
print(d.f)
const e = { x: true, y: 1 }
const g = { x: 4, y: false }
print(e.x)
print(e.y)
print(g.x)
print(g.y)
const h = { f: k }
const i = { f: 4 }
const j = { f: "s" }
print(h.f)
print(i.f)
print(k)
print(j.f)
function id(o) { o }
print(id({ f: true }).f)
print(id({ f: 4 }).f)
const p: P = { f: true }
const q = { f: k }
print(p.f)
print(q.f)
type R = { c: "a" | "b" }
const r: R = { c: "a" }
const o1 = { c: "zz" }
print(o1.c)
const s: string = "q"
const o2 = { c: s }
print(o2.c)
print(r.c)
type W = { w: { f: i32 } }
const zw: W = { w: { f: 11 } }
const zs = { w: { f: "q" } }
print(zs.w.f)
print(zw.w.f)
