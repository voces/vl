// @run
// @log true
// @log 4
// @log 4
// @log true
// @log true
// @log 1
// @log 4
// @log false
// @log y
// @log 4
// @log y
// @log s
// @log true
// @log 4
// @log true
// @log 4
// @log true
// @log 4
// @log true
// @log y
// @log s
// @log 3
// @hint redundant type annotation: `p` is inferred as `{f: boolean}` — remove it to lean on inference
// An `i32`, a `boolean` and a string literal set's atom share field code 0, but two anonymous
// literals that differ in which one a field holds are two rows, so each reads back in its own
// format, whatever delivers it (D2841). A literal handed straight to an un-annotated
// parameter keeps its own shape as its row, not the parameter's open hole (D2762).
type K = "x" | "y"
const k: K = "y"
type P = { f: boolean }
const a = { f: true }
const b = { f: 4 }
print(a.f)
print(b.f)
const c = { f: 4 }
const d = { f: true }
print(c.f)
print(d.f)
const e = { x: true, y: 1 }
const g = { x: 4, y: false }
print(e.x)
print(e.y)
print(g.x)
print(g.y)
const h = { f: k }
const i = { f: 4 }
const j = { f: "s" }
print(h.f)
print(i.f)
print(k)
print(j.f)
function show(o) { print(o.f) }
show({ f: true })
show({ f: 4 })
function id(o) { o }
print(id({ f: true }).f)
print(id({ f: 4 }).f)
function gen<T>(v: T) {
  const o = { f: v }
  print(o.f)
}
gen(true)
gen(4)
const p: P = { f: true }
const q = { f: k }
print(p.f)
print(q.f)
function gv(o) { o.v }
print(gv({ v: "s" }))
print(gv({ v: 3 }))
