// @run
// @log 1
// @log 2
// A record literal wider than its destination only at its leaf, eight and twelve records down,
// handed through a function value whose parameter drops the field (D16735).

function show8(x: {a: {b: {c: {d: {e: {g: {h: {i: {v: i32}}}}}}}}}) {
  print(x.a.b.c.d.e.g.h.i.v)
}
const sh8: (x: {a: {b: {c: {d: {e: {g: {h: {i: {v: i32}}}}}}}}}) => void = show8
const r8 = {
  a: { b: { c: { d: { e: { g: { h: { i: { v: 1, w: "s" } } } } } } } },
}
sh8(r8)

function show12(
  x: {a: {b: {c: {d: {e: {g: {h: {i: {j: {m: {n: {o: {v: i32}}}}}}}}}}}}},
) {
  print(x.a.b.c.d.e.g.h.i.j.m.n.o.v)
}
const sh12: (x: {a: {b: {c: {d: {e: {g: {h: {i: {j: {m: {n: {o: {v: i32}}}}}}}}}}}}}) => void = show12
const r12 = {
  a: {
    b: {
      c: {
        d: {
          e: { g: { h: { i: { j: { m: { n: { o: { v: 2, w: "s" } } } } } } } },
        },
      },
    },
  },
}
sh12(r12)
