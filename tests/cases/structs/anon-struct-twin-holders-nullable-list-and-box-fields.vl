// @run
// @log 7
// @log 4
// @log 5
// @log hi
// CONTRACT (D1689), one companion column over from the ref-list element: the `| null` niche
// over a ref list carries its element's key, and a union-box field carries its member SET. An
// anonymous row keyed only on field name and storage code collapses both pairs onto one row.
//
// The box half is the sharper one: a box's tags are positional, so the second holder writing
// the first holder's box is a cast failure at run time rather than a refusal.
//
// The two pairs live in separate programs from the plain ref-list ones: a code-28 holder
// beside a code-5 holder of the same field name is a third gap (D1663), and mixing them here
// would leave this fixture unable to grade either.
//
// NOTHING HERE MAY DECLARE THE OUTER SHAPE — an unused `type Holder = { xs: A[] | null }` is
// the rescue, and it would make every read pass for the wrong reason.
type A = { r: i32 }
type B = { q: i32, tag: string }
type U1 = i32 | boolean
type U2 = string | boolean

function ns1(): A[] | null { return [{ r: 7 }] }
function ms1(): B[] | null { return [{ q: 4, tag: "a" }] }
function u1(): U1 { return 5 }
function u2(): U2 { return "hi" }

// The `| null` niche over two ref lists whose elements differ (field code 28).
function nullableRefListFields() {
  const one = { xs: ns1() }
  const l1 = one.xs
  if l1 != null { print(l1[0].r) }
  const two = { xs: ms1() }
  const l2 = two.xs
  if l2 != null { print(l2[0].q) }
}

// Two union-box fields over different member sets (field code 16).
function unionBoxFields() {
  const one = { ys: u1() }
  print(one.ys)
  const two = { ys: u2() }
  print(two.ys)
}

nullableRefListFields()
unionBoxFields()
