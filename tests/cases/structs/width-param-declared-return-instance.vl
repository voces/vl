// @run
// @log a
// @log b
// @log a
// @log 8
// @log true
// A declared record return whose only source is a parameter the width rewrite made generic is that
// instance's record (D16401): a wider argument comes back at its own type, not refused. A return
// that builds a fresh record keeps the declared type, so `mkP` is still its own declaration.
type P = { name: string }
function pass(p: P): P { return p }
function mk(): { age: i32, name: string } { return { age: 3, name: "a" } }
const v = mk()
print(pass(v).name)
print(pass({ name: "b" }).name)
function mkP(p: P): P { return { name: p.name } }
print(mkP(v).name)
type U = { pet: { legs: i32 } }
function f(u: U): U {
  u.pet.legs = 8
  return u
}
function mkN(): { pet: { legs: i32, purr: boolean } } {
  return { pet: { legs: 4, purr: true } }
}
const sv = mkN()
print(f(sv).pet.legs)
print(sv.pet.purr)
