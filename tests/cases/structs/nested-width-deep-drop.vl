// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// A record wider than its destination only at its leaf, seven, eight and twelve records down, as
// an argument, an inline literal and a declared binding (D16734).

function show7(x: {a: {b: {c: {d: {e: {g: {h: {v: i32}}}}}}}}) {
  print(x.a.b.c.d.e.g.h.v)
}
const r7 = { a: { b: { c: { d: { e: { g: { h: { v: 1, w: "s" } } } } } } } }
show7(r7)

function show8(x: {a: {b: {c: {d: {e: {g: {h: {i: {v: i32}}}}}}}}}) {
  print(x.a.b.c.d.e.g.h.i.v)
}
const r8 = {
  a: { b: { c: { d: { e: { g: { h: { i: { v: 2, w: "s" } } } } } } } },
}
show8(r8)

function show12(
  x: {a: {b: {c: {d: {e: {g: {h: {i: {j: {m: {n: {o: {v: i32}}}}}}}}}}}}},
) {
  print(x.a.b.c.d.e.g.h.i.j.m.n.o.v)
}
const r12 = {
  a: {
    b: {
      c: {
        d: {
          e: { g: { h: { i: { j: { m: { n: { o: { v: 3, w: 2 } } } } } } } },
        },
      },
    },
  },
}
show12(r12)

show7({ a: { b: { c: { d: { e: { g: { h: { v: 4, w: "s" } } } } } } } })

const r = { a: { b: { c: { d: { e: { g: { h: { v: 5, w: "s" } } } } } } } }
const y: {a: {b: {c: {d: {e: {g: {h: {v: i32}}}}}}}} = r
print(y.a.b.c.d.e.g.h.v)
