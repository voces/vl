// @run
// @log 2.5
// @log 1
// @log 1
// @log 2.5
// @log 2
// @log 1
// @log 2.5
// @log 1
// @log 7
// @log 2.5
// @log 1
// @log 2.5
// @log 1
// @log 2.5
// @log a
// @log 1
// @log b
// @log 2.5
// @log 1
// A value `if` or `match` of record literals delivered to a record whose field is a numeric union
// is built as that record, not as the arms' join `{f: f64}` (D15020).
type R = { f: i32 | f64 }
function bind(b: boolean) {
  const v: {f: i32 | f64} = if b { { f: 2.5 } } else { { f: 1 } }
  print(v.f)
}
function swapped(b: boolean) {
  const v: {f: i32 | f64} = if b { { f: 1 } } else { { f: 2.5 } }
  print(v.f)
}
function wide(b: boolean) {
  const v: {f: i32 | i64} = if b { { f: 2 as i64 } } else { { f: 1 } }
  print(v.f)
}
function chain(k: i32) {
  const v: R = if k == 0 { { f: 2.5 } } else if k == 1 { { f: 1 } } else { { f: 7 } }
  print(v.f)
}
function arms(k: i32) {
  const v: R = match k {
    0 => { f: 2.5 }
    _ => { f: 1 }
  }
  print(v.f)
}
function assigned(b: boolean) {
  let v: R = { f: 0 }
  v = if b { { f: 2.5 } } else { { f: 1 } }
  print(v.f)
}
function two(b: boolean) {
  const v: {f: i32 | f64, s: string} = if b { { f: 2.5, s: "a" } } else { { f: 1, s: "b" } }
  print(v.f)
  print(v.s)
}
function take(v: R) { print(v.f) }
function passed(b: boolean) { take(if b { { f: 2.5 } } else { { f: 1 } }) }
bind(true)
bind(false)
swapped(true)
swapped(false)
wide(true)
wide(false)
chain(0)
chain(1)
chain(2)
arms(0)
arms(1)
assigned(true)
assigned(false)
two(true)
two(false)
passed(true)
passed(false)
