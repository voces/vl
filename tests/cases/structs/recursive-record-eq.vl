// @log false
// @log true
// @log false
// @warning `==` on `N` compares every element of its list field `kids`
// @warning `==` on `A` compares every element of its list field `bs`
// @warning `!=` on `A` compares every element of its list field `bs`
// @warning `==` on `T` compares every element of its list field `sub.ts`
// `==` over a record that reaches itself through a list field, directly, mutually, through a
// parameter, as a list element and through a nested record, compares the whole tree (D5282).
type N = { v: i32, kids: N[] }
const a: N = { v: 1, kids: [{ v: 2, kids: [] }] }
const b: N = { v: 1, kids: [{ v: 2, kids: [] }] }
const d: N = { v: 1, kids: [{ v: 2, kids: [{ v: 3, kids: [] }] }] }
print(a == b)
print(a == d)
type A = { n: string, bs: B[] }
type B = { k: i32, as: A[] }
const x: A = { n: "r", bs: [{ k: 1, as: [{ n: "s", bs: [] }] }] }
const y: A = { n: "r", bs: [{ k: 1, as: [{ n: "s", bs: [] }] }] }
const z: A = { n: "r", bs: [{ k: 1, as: [{ n: "t", bs: [] }] }] }
print(x == y)
print(x == z)
print(x != z)
function same(p: N, q: N) { p == q }
print(same(a, b))
print(same(a, d))
print([a, d] == [b, d])
print(a.kids == d.kids)
type T = { v: i32, sub: C }
type C = { ts: T[] }
const t1: T = { v: 1, sub: { ts: [{ v: 2, sub: { ts: [] } }] } }
const t2: T = { v: 1, sub: { ts: [{ v: 2, sub: { ts: [] } }] } }
const t3: T = { v: 1, sub: { ts: [{ v: 3, sub: { ts: [] } }] } }
print(t1 == t2)
print(t1 == t3)
