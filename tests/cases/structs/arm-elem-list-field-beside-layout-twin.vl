// @run
// @log 7
// @log 9
// @log 7
// @log 9
// @hint redundant type annotation: `mkC` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `xs` is inferred as `Circle[]`
// @hint redundant type annotation: `b` is inferred as `{xs: Circle[]}`
// @hint redundant type annotation: `mkD` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `xs` is inferred as `Dot[]`
// @hint redundant type annotation: `b` is inferred as `{xs: Dot[]}`
// @hint redundant type annotation: `nkC` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `xs` is inferred as `Circle[]`
// @hint redundant type annotation: `nkD` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `xs` is inferred as `Dot[]`
// D64. TWO STRUCTS WHOSE ONLY DIFFERENCE IS A REF-LIST FIELD'S ELEMENT ARE TWO HEAP TYPES.
//
// `Box = { xs: Circle[] }` and `Box2 = { xs: Dot[] }`, with `Circle` an arm of `Shape` and
// `Dot` its exact layout twin. The canonical key of the two rows matches (canon renders the
// arm structurally) and so does every top-level field CODE — both fields are code 5, a
// struct/union ref list. `buildStructTwins` therefore merged them onto ONE WasmGC struct
// type, while the ref-list layer had correctly kept `Circle[]` and `Dot[]` apart (two slots,
// element heaps `uVarHeap[Circle]` and `$Dot`). `Box2`'s `struct.new` then pushed a
// `(ref $DotListWrapper)` into a field typed `(ref $CircleListWrapper)`: `vl check` rc 0,
// "type mismatch: expected (ref $type), found (ref $type)".
//
// THE GUARD WAS ALREADY WRITTEN AND ON ONE ARM. `structFieldCodesEq` carries a
// referenced-layer descent — the element rows must be twins themselves, an unresolvable
// element name declines the merge — and it ran for code 15 (a nested struct) alone.
// `fieldCodeRefsElemHeap` names the set: 15, 5, and 28 (the `S[] | null` niche, measured as
// the same defect at the same coordinate). For an arm element the descent declines because
// an arm has no `sNames` row at all, which is the correct answer and the nominal one.
//
// EITHER FUNCTION ALONE RAN; the pairing is the trigger, which is why a one-container grid
// could not see this row or D48.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }
type Box = { xs: Circle[] }
type Box2 = { xs: Dot[] }

function mkC(): i32 {
  const c: Circle = { r: 7 }
  const xs: Circle[] = [c]
  const b: Box = { xs: xs }
  return b.xs[0].r
}

function mkD(): i32 {
  const c: Dot = { r: 9 }
  const xs: Dot[] = [c]
  const b: Box2 = { xs: xs }
  return b.xs[0].r
}

print(mkC())
print(mkD())

// THE `| null` SPELLING OF THE SAME FIELD (code 28) — its own witness, identical message
// before the fix.
type NBox = { xs: Circle[] | null }
type NBox2 = { xs: Dot[] | null }

function nkC(): i32 {
  const c: Circle = { r: 7 }
  const xs: Circle[] = [c]
  const b: NBox = { xs: xs }
  const g = b.xs
  if g != null { return g[0].r }
  return -1
}

function nkD(): i32 {
  const c: Dot = { r: 9 }
  const xs: Dot[] = [c]
  const b: NBox2 = { xs: xs }
  const g = b.xs
  if g != null { return g[0].r }
  return -1
}

print(nkC())
print(nkD())
