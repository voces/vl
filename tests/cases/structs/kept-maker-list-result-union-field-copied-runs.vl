// A fresh call's list of records delivered at a list whose element boxes a field is copied element
// by element, so the function's other calls keep reading the list at its own type.
type W = { f: i32 | string }
type N = { g: { f: i32 | string } }
function mk() { [{ f: 4 }, { f: 6 }] }
function mn() { [{ g: { f: 2 } }] }
const h = mk()
print(h[1].f + 1)
const h2: W[] = mk()
h2.push({ f: "s" })
print(h2.length)
print(h2[0].f is i32)
print(mk().length)
const n = mn()
const n2: N[] = mn()
print(n[0].g.f + n2.length)
