// @run
// @log 5
// @log 2
// @log true
// @log 5
// @log true
// @log bx
// @log 2
// @log 9
// @log a
// @log 8
// @log 6
// @log true
// @log 3
// A fresh call's record list of scalars copied where it lands boxes each element into the
// destination's `| null` or union element, widened where the nullable holds the number wider.
type U = { f: (i32 | string)[] }
function ul() { { f: [4] } }
const h = ul()
print(h.f[0] + 1)
const h2: U = ul()
h2.f.push("s")
print(h2.f.length)
print(h2.f[0] is i32)
type N = { f: (i32 | null)[] }
function nl() { { f: [4] } }
const n = nl()
print(n.f[0] + 1)
const n2: N = nl()
print(n2.f[0] != null)
type V = { f: (i32 | string)[], g: (string | null)[], h: (i64 | null)[] }
function vl() { { f: ["a", "b"], g: ["x"], h: [7, 8] } }
const va = vl()
print(va.f[1] + va.g[0])
const vv: V = vl()
vv.g.push(null)
print(vv.g.length)
const h1 = vv.h[1]
if h1 != null { print(h1 + 1) }
const f0 = vv.f[0]
if f0 is string { print(f0) }
type In = { f: (i32 | null)[] }
type O = { o: In, xs: In[] }
function mk() { { o: { f: [1, 2] }, xs: [{ f: [3] }, { f: [4, 5, 6] }] } }
const a = mk()
print(a.o.f[1] + a.xs[1].f[2])
const b: O = mk()
b.xs[1].f.push(null)
print(b.xs[1].f.length + b.o.f.length)
print(b.xs[0].f[0] != null)
print(a.xs[1].f.length)
