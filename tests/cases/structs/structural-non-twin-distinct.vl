// @run
// @log 100
// @log 9000000000
// @log true
// @log a
// @log b
// @hint redundant type annotation: `readI64` is inferred as `i64`
// @hint redundant type annotation: `a` is inferred as `{f: i32}`
// @hint redundant type annotation: `c` is inferred as `{f: i64}`
// @hint redundant type annotation: `d` is inferred as `{f: boolean}`
// NON-TWINS MUST STAY DISTINCT. The dedup keys slots on the canonical STRUCTURAL
// key (`repCanonKey`), guarded by an emitter field-code match — so two shapes that
// are NOT the same type keep separate heap types. This pins the boundary: a bad
// merge here would store an i64 into an i32 field (or an atom into a string slot).
//
// Different field TYPE under the same field NAME is a different structure — a
// different key AND different field codes — so `{f:i32}` and `{f:i64}` never share
// a heap type (the i64 stays 64-bit).
type I32Box = { f: i32 }
type I64Box = { f: i64 }
function readI32(x: I32Box) { return x.f }
function readI64(x: I64Box): i64 { return x.f }
const a: I32Box = { f: 100 }
const c: I64Box = { f: 9000000000 }
print(readI32(a))   // 100
print(readI64(c))   // 9000000000 (not truncated to i32)

// `boolean` vs `i32`: `repCanonKey` distinguishes them, so a `{f:boolean}` keeps
// its own slot even though the field CODE alone would not separate it.
type BoolBox = { f: boolean }
const d: BoolBox = { f: true }
print(d.f)          // true

// A declared litunion-alias field (`k: K`) vs an inline litunion field
// (`k: "a"|"b"`) is the one pair on this page that IS a twin, and it converged in
// #1306: `"a"|"b"` and `K` denote one type, so the annotation now resolves to `K`'s
// own arena index (`annUnionInnerTy`'s alias preference) and canon spells it `K`,
// which merges the two struct rows into one. Master emitted two — one i32-ATOM field
// and one softened `string`-ref field — and the reads disagreed about the backing rep
// in exactly the way the rest of this file exists to prevent. The heap-type count for
// this module went 7 -> 6 and the module GREW 62 bytes, because `print(wi.k)` now
// lowers the atom->member-string widen the string rep did not need. Both prints stay
// pinned below: if they ever disagree, the merge was wrong.
type K = "a" | "b"
type WithAlias = { k: K }
type WithInline = { k: "a" | "b" }
const wa: WithAlias = { k: "a" }
const wi: WithInline = { k: "b" }
print(wa.k)         // a
print(wi.k)         // b
