// @run
// @log true
// @log true
// @log 7
// @log s
// @log 2.5
// @log y
// @log 7
// @log false
// @log zz
// @log q
// @log a
// @log 7
// @log true
// @log true
// @log 4
// A constructor whose record names an un-annotated parameter or a type parameter builds its
// own row at each pin, whatever other rows share its field names (D2850). A string that is not
// a member of a declared literal set does not take that set's row (D2841).
type K = "x" | "y"
const k: K = "y"
function p(o) { print(o.f) }
p({ f: true })
function mk(x) { return { f: x } }
print(mk(true).f)
print(mk(7).f)
print(mk("s").f)
print(mk(2.5).f)
print(mk(k).f)
function mkT<T>(x: T) { { f: x } }
print(mkT(7).f)
print(mkT(false).f)
type R = { c: "a" | "b" }
const r: R = { c: "a" }
const o = { c: "zz" }
print(o.c)
const s: string = "q"
const o2 = { c: s }
print(o2.c)
print(r.c)
function bound(x) {
  const o = { f: x }
  o
}
print(bound(7).f)
print(bound(true).f)
const a2 = { w: { f: 4 } }
function nested(x) {
  const o = { w: { f: x } }
  print(o.w.f)
}
nested(true)
print(a2.w.f)
