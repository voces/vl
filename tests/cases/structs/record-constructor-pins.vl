// @run
// @log true
// @log true
// @log 7
// @log s
// @log 2.5
// @log y
// @log 7
// @log false
// @log zz
// @log q
// @log a
// @log 7
// @log true
// @log true
// @log 4
// @log 5
// @log true
// @log -3
// @log 2.5
// @log q
// @log 11
// @hint redundant type annotation: `zw` is inferred as `{w: {f: i32}}` — remove it to lean on inference
// A constructor whose record names an un-annotated parameter or a type parameter builds its
// own row at each pin, whatever other rows share its field names (D2850). A string that is not
// a member of a declared literal set does not take that set's row (D2841).
type K = "x" | "y"
const k: K = "y"
function p(o) { print(o.f) }
p({ f: true })
function mk(x) { return { f: x } }
print(mk(true).f)
print(mk(7).f)
print(mk("s").f)
print(mk(2.5).f)
print(mk(k).f)
function mkT<T>(x: T) { { f: x } }
print(mkT(7).f)
print(mkT(false).f)
type R = { c: "a" | "b" }
const r: R = { c: "a" }
const o = { c: "zz" }
print(o.c)
const s: string = "q"
const o2 = { c: s }
print(o2.c)
print(r.c)
function bound(x) {
  const o = { f: x }
  o
}
print(bound(7).f)
print(bound(true).f)
const a2 = { w: { f: 4 } }
function nested(x) {
  const o = { w: { f: x } }
  print(o.w.f)
}
nested(true)
print(a2.w.f)
function mkA<T>(x: T): { f: T } { return { f: x } }
const xs = [mkA(5)]
print(xs[0].f)
const ys = [mkT(true), mkT(false)]
print(ys[0].f)
function mkW(x) { return { w: { f: x } } }
const ws = [mkW(-3)]
print(ws[0].w.f)
const vs = [mkW(2.5)]
print(vs[0].w.f)
type W = { w: { f: i32 } }
const zw: W = { w: { f: 11 } }
const zs = { w: { f: "q" } }
print(zs.w.f)
print(zw.w.f)
