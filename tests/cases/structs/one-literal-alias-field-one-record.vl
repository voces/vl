// D7220: `{kind: "circle"}` and `{kind: KC}` with `type KC = "circle"` are one record type, so
// they have one struct rep and a value of either spelling delivers to the other with no copy.
// A one-member literal set reps as its literal, a string, at a field.
// @run
// @log circle
// @log circle
// @log circle
// @log 2
// @log 3
// @log circle
// @log true
// @hint redundant type annotation: `b` is inferred as `C`
// @hint redundant type annotation: `back` is inferred as `Ca`
// @hint redundant type annotation: `area` is inferred as `f64`
// @hint redundant type annotation: `xs` is inferred as `C[]`

type KC = "circle"
type KR = "rect"
type C = { kind: "circle", r: f64 }
type Ca = { kind: KC, r: f64 }
type Ci = { kind: "circle", r: f64 }
type Ri = { kind: "rect", w: f64 }
type Cn = { kind: KC, r: f64 }
type Rn = { kind: KR, w: f64 }

const a: C = { kind: "circle", r: 1.0 }
const b: Ca = a
print(b.kind)
const back: C = b
print(back.kind)

function takeK(k: KC): KC { return k }
print(takeK(b.kind))

function area(s: Cn | Rn): f64 {
  if s.kind == "circle" { return s.r }
  return s.w
}
const ci: Ci = { kind: "circle", r: 2.0 }
const ri: Ri = { kind: "rect", w: 3.0 }
print(area(ci))
print(area(ri))

const xs: Ca[] = [a, b]
print(xs[0].kind)
const kc: KC = "circle"
print(xs[1].kind == kc)
