// @run
// @log 7
// @log 9
// @log 5
// @log hi
// @log 7
// @log 4
// @log 6
// @hint redundant type annotation: `h` is inferred as `{b: U2}` — remove it to lean on inference
// @hint Intentionally-unused function `_neverCalled` (leading `_` marks it unused)
// CONTRACT (D1690): a union box's tags are POSITIONAL, so a DECLARED inline-shape row whose
// box holds a different member set may not capture an inferred literal — declaring the shape
// is enough, nothing has to construct it. Two outcomes, same ingredient: a two-member
// mismatch reads the payload at the wrong scalar tag and prints the wrong VALUE, a
// three-member one differing in a ref member is a cast failure at run time.
//
// AND IT IS A PREFERENCE, NOT A REFUSAL — `widerDelivered` is the floor. A declared box field
// may legitimately be WIDER than the value's own union, and a literal DELIVERED there keeps
// that widening; only a row the literal's own destination does NOT name is refused the
// capture. A close that refutes on the member set alone turns that function into a refusal.
//
// NOTHING HERE MAY ANNOTATE A CAPTURED LITERAL. `const b: { b: U1 } = { b: u1() }` is the
// rescue at every one of them, and it would make each read pass for the wrong reason.
type U1 = i32 | boolean
type U2 = string | boolean
type U3 = i32 | boolean | string
type U5 = string | boolean | i64
type Hb = { b: U2 }
type Hc = { c: U5 }
type Hw = { w: U3 }

function u1(): U1 { return 7 }
function u1b(): U1 { return 4 }
function u2(): U2 { return "hi" }
function u3(): U3 { return 9 }
function u1w(): U1 { return 5 }

// Two-member sets, the declared row never constructed.
function twoMemberCapture() {
  const b = { b: u1() }
  print(b.b)
}

// Three members differing in a REF member: the wrong tag is a cast failure, not a mis-read.
function threeMemberCapture() {
  const c = { c: u3() }
  print(c.c)
}

// The floor: a declared box field WIDER than the value's own union, with the literal
// delivered to it.
function widerDelivered() {
  const w: Hw = { w: u1w() }
  print(w.w)
}

// The declared row constructed as well, so it is live and still may not capture the sibling.
function bothLive() {
  const h: Hb = { b: u2() }
  print(h.b)
  const b = { b: u1() }
  print(b.b)
}

// An uncalled function's PARAMETER annotation mints the same row, with no `type` in sight.
function _neverCalled(p: { d: U2 }) { print(p.d) }
function paramAnnotationRow() {
  const d = { d: u1b() }
  print(d.d)
}

// The holder ABSENT — the control that must keep running with no declared row at all.
function holderAbsent() {
  const e = { e: u1e() }
  print(e.e)
}
function u1e(): U1 { return 6 }

twoMemberCapture()
threeMemberCapture()
widerDelivered()
bothLive()
paramAnnotationRow()
holderAbsent()
