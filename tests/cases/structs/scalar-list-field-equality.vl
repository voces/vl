// @run
// @log true
// @log false
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log true
// @hint redundant type annotation: `i1` is inferred as `{v: i32[]}` — remove it to lean on inference
// @hint redundant type annotation: `i2` is inferred as `{v: i32[]}` — remove it to lean on inference
// @hint redundant type annotation: `i3` is inferred as `{v: i32[]}` — remove it to lean on inference
// @hint redundant type annotation: `i4` is inferred as `{v: i32[]}` — remove it to lean on inference
// @hint redundant type annotation: `f1` is inferred as `{v: f64[]}` — remove it to lean on inference
// @hint redundant type annotation: `f2` is inferred as `{v: f64[]}` — remove it to lean on inference
// @hint redundant type annotation: `f3` is inferred as `{v: f64[]}` — remove it to lean on inference
// @hint redundant type annotation: `s1` is inferred as `{v: string[]}` — remove it to lean on inference
// @hint redundant type annotation: `s2` is inferred as `{v: string[]}` — remove it to lean on inference
// @hint redundant type annotation: `s3` is inferred as `{v: string[]}` — remove it to lean on inference
// @hint redundant type annotation: `p1` is inferred as `{v: f64[], n: i32}` — remove it to lean on inference
// @hint redundant type annotation: `p2` is inferred as `{v: f64[], n: i32}` — remove it to lean on inference
// @hint redundant type annotation: `p3` is inferred as `{v: f64[], n: i32}` — remove it to lean on inference
// THE ANNOTATIONS ARE DECLARED-REDUNDANT, NOT REMOVED. Each one names which struct type a
// pair belongs to, which is the whole readability of a fourteen-line value table — and for
// `u8[]`, `i64[]` and `f32[]` the annotation is not redundant at all (a bare `[1, 2]`
// infers `i32[]`), so removing the "redundant" ones would leave the file inconsistent
// about the one thing it is testing.
//
// Regression (silent-class-inventory D1020).
//
// Struct-field equality had an arm for `i32[]` and for NO other scalar list. `f64[]`,
// `i64[]`, `string[]`, `f32[]` and `u8[]` fields all refused:
//
//   emitProgram: unsupported struct field type in equality
//
// while the very same lists compared fine as VALUES. So the cores already existed and the
// field ladder simply never routed to them — one code's hand-written 50-line loop, and
// nothing for the other five.
//
// THE FIX IS ROUTING PLUS A FRAME, and the two must agree. `leqNoteBin` reserves a compare
// frame per rep and the equality ladder emits the core; if either side knows a code the
// other does not, the result is `list compare frame was not reserved for this rep`. Both
// now read ONE map (`eqScalarListFieldKind`), which is the same pairing D1017 established
// for the code-5 ref-list field.
//
// `i32[]` keeps its own arm: it predates the generic cores and re-routing it would move
// bytes for a compare that already worked. It is here as the control.
//
// BOTH DIRECTIONS AT EVERY ELEMENT TYPE. An equality that answers `true` for everything is
// the easy way to pass this file, so each type is compared once equal and once NOT — and
// once at differing LENGTHS, which is the branch a naive element loop skips.
type Si = { v: i32[] }
type Sf = { v: f64[] }
type Sl = { v: i64[] }
type Ss = { v: string[] }
type Su = { v: u8[] }
type S3 = { v: f32[] }

// i32[] — the control, the one code that always worked
const i1: Si = { v: [1, 2] }
const i2: Si = { v: [1, 2] }
const i3: Si = { v: [1, 3] }
const i4: Si = { v: [1] }
print(i1 == i2)
print(i1 == i3)

// differing LENGTHS, not just differing elements
print(i1 == i4)

// f64[]
const f1: Sf = { v: [1.5, 2.5] }
const f2: Sf = { v: [1.5, 2.5] }
const f3: Sf = { v: [9.5, 2.5] }
print(f1 == f2)
print(f1 == f3)

// i64[]
const l1: Sl = { v: [1, 2] }
const l2: Sl = { v: [1, 2] }
const l3: Sl = { v: [1, 9] }
print(l1 == l2)
print(l1 == l3)

// string[]
const s1: Ss = { v: ["a", "b"] }
const s2: Ss = { v: ["a", "b"] }
const s3: Ss = { v: ["a", "z"] }
print(s1 == s2)
print(s1 == s3)

// u8[] — the packed byte list, whose field code (35) is D1008's
const u1: Su = { v: [1, 2] }
const u2: Su = { v: [1, 2] }
const u3: Su = { v: [1, 9] }
print(u1 == u2)
print(u1 == u3)

// f32[]
const t1: S3 = { v: [1.5] }
const t2: S3 = { v: [1.5] }
const t3: S3 = { v: [2.5] }
print(t1 == t2)
print(t1 == t3)

// `!=` negates, and a second field alongside the list still participates
type Pair = { v: f64[], n: i32 }
const p1: Pair = { v: [1.5], n: 7 }
const p2: Pair = { v: [1.5], n: 7 }
const p3: Pair = { v: [1.5], n: 8 }
print(p1 == p2)
print(p1 != p3)
