// @run
// @log 1
// @log 3
// @log 1.5
// @log true
// @hint redundant type annotation: `x` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `t` is inferred as `boolean` — remove it to lean on inference
// A bound record literal handed to `m.set` is built at the map value's declared record, as the
// index store `m[k] = l` builds it, so a field the record widens is stored widened (D3195).
type R = { v: f64, w: i32 }
const l = { v: 1, w: 3 }
const m: {[string]: R} = Map()
m.set("a", l)
const q = m.get("a")
if q != null {
  print(q.v)
  print(q.w)
}
type D = { v: f64 }
const x: i32 = 3
const o = { v: x }
const n: {[string]: D} = Map()
n.set("k", o)
const p = n.get("k")
if p != null { print(p.v / 2.0) }
type B = { b: boolean | null }
const t: boolean = true
const bl = { b: t }
const bm: {[string]: B} = Map()
bm.set("k", bl)
const bq = bm.get("k")
if bq != null { print(bq.b) }
