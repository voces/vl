// @run
// @log 41
// @log 41
// @log s
// @log 42
// @log 41
// @log 41
// @log 43
// @log 3
// @info `r5` is never reassigned; use `const` instead of `let`
// A record literal holding a function value does not take a declared row whose field of the
// same name holds a scalar, so the field stays the function (D6373). Generic, at two types, a
// lambda, beside `string`, `boolean` and nullable fields, at two fields, and with the row used.
function k<T>(x: T): T { return x }
function m(x: i32) { return x }
type W1 = { f: i32 }
type W2 = { f: string }
type W3 = { f: boolean }
type W4 = { f: i32 | null }
type W5 = { f: i32, g: i32 }
const r1 = { f: k }
print(r1.f(41))
const r2 = { f: m }
print(r2.f(41))
print(r1.f("s"))
const r3 = { f: (x: i32) => x + 1 }
print(r3.f(41))
function main() {
  const r4 = { f: k }
  print(r4.f(41))
  let r5 = { f: m }
  print(r5.f(41))
}
main()
const r6 = { f: k, g: 2 }
print(r6.f(41) + r6.g)
const w: W1 = { f: 3 }
print(w.f)
