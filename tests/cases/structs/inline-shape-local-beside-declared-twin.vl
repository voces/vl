// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `c` is inferred as `{r: i32}` — remove it to lean on inference
// GRADUATED from `silent-class-inventory` D111 — an INLINE-SHAPE LOCAL in a program that ALSO
// declares a struct of that layout, which is D53's question asked at a THIRD resolver.
// `const c: { r: i32 } = { r: n }` beside `type Circle = { r: i32 }` was `vl check` rc 0 —
// and not diagnostic-free either: it emitted the redundant-annotation HINT telling the author
// to write the exact spelling that RUNS — plus `emitProgram: binding's inline-shape type has
// an unsupported field`. Deleting `type Circle` made it run; so did spelling the local
// `c: Circle`. The one-line control is the DECLARATION, exactly as in D53.
//
// THE GUARD WAS NAME-KEYED AND THE SHAPE HAS NO NAME. `internInlineShapeTy` ends in
// `annShapeIndexOf`, which DEDUPS the inline shape onto the declared row and pushes no
// `sNames` entry for `{r:i32}`, so `letAnnIsUninternedShape`'s `structIndexByName(nm) < 0`
// read "not interned" for a shape that IS interned under another spelling — and that guard's
// false side REJECTS. It now falls through to `repSlotOfTy(nodeRepTyIxOf(...))`, the same
// structural→declared bridge `paramStructIndex` took for D53.
//
// TWO EDITS, AND THE ORDER IS MEASURED — this fixture's `gen` rows are why. #1957 built the
// fall-through ALONE and swept it: 64 cells moved to `runs` and NINETEEN moved to
// `check-clean invalid wasm`, every one of the 19 at `route=gen`. With the guard lifted the
// binding becomes a struct local, and the pin `monoArgTyName` mints for the same spelling
// disagreed: `monoAnnPinName` had no arm for a bare inline shape (`isSName` cannot answer for
// it by construction), so the argument fell to the `"i32"` catch-all and the instance declared
// `(func (param i32) (result i32))` under a `(ref $Circle)` value. Disassembled, that is the
// whole divergence — with only the guard lifted the instance is `(param i32) (result i32)` and
// `mk` `return_call`s into it from a `(result (ref 0))` frame. `monoAnnPinName`'s inline-shape
// rung is the other edit, and it is `monoCompositeListAnnName`'s own `{…}[]` ELEMENT rung one
// container in — the `P` / `P[]` pair `monoStructAnnName` holds BOTH rungs of, missing its
// first.
//
// ABLATED on a 1,710-cell grid (`scripts/silent-sweep/d111/`): the pin rung alone moves 8
// cells, all to `runs`; the guard rung alone moves 24 — 16 to `runs` and **8 BACKWARD to
// check-clean invalid wasm**; together they move 32, all to `runs`. The two solo moved sets
// are DISJOINT, so the composition is a DIRECTION and not a cell count: the pair disagrees
// with the guard alone on exactly the 8 cells the guard alone sends silent, every one of them
// `ann1` x `local` x `gen` — the `mkGen` / `mkTwin` rows below.
type Circle = { r: i32 }

// THE FILED WITNESS, verbatim.
function mk(n: i32) {
  const c: { r: i32 } = { r: n }
  return c
}

// THE `route=gen` ROW — the 8 cells that need BOTH edits. The generic is the CONSUMER; the
// binding is not in a generic original at all.
function idg<T>(x: T): T { return x }

function mkGen(n: i32) {
  const c: { r: i32 } = { r: n }
  return idg(c)
}

// The MEMBER READ off the inline-shape local, the other resolver.
function mkRead(n: i32) {
  const c: { r: i32 } = { r: n }
  return c.r
}

// The result annotated with the DECLARED name over an inline-shape local — the two spellings
// meeting in one function.
function mkRetNamed(n: i32): Circle {
  const c: { r: i32 } = { r: n }
  return c
}

// The NULLABLE inline-shape spelling, whose `| null` the pin has to carry through the generic.
const gNul: { r: i32 } | null = { r: 7 }

// TWO declared claimants for the layout — D100's axis, which this row is wider than: it fires
// at ONE claimant as readily as at two.
type Dot = { r: i32 }

function mkTwin(n: i32) {
  const c: { r: i32 } = { r: n }
  return idg(c)
}

// The controls, both of which ran before this change and run now: the local spelled
// NOMINALLY, and the same inline shape with no declared struct in scope at all (that one
// lives in `inline-shape-declared-twin-heap.vl`'s neighbourhood — here the nominal spelling
// is the control the row names).
function mkNominal(n: i32) {
  const c: Circle = { r: n }
  return c
}

print(mk(7).r)
print(mkGen(7).r)
print(mkRead(7))
print(mkRetNamed(7).r)
print(idg(gNul ?? { r: 0 }).r)
print(mkTwin(7).r)
print(mkNominal(7).r)
print(idg(mk(7)).r)
