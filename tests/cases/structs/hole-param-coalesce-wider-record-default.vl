// @run
// @log 5
// @log 0
// @log 5
// @log 3
// A `??` over a hole parameter handed a record wider than its default keeps the argument's record
// as a member of the join, as the annotated parameter does, rather than narrowing it to the
// default's fields (D16796). Through a map's `get` too.
const r: {x: i32, y: i32} | null = { x: 5, y: 6 }
const z: {x: i32, y: i32} | null = null
const n = Map()
n.set("a", { x: 5, y: 6 })
const s: {x: i32} | null = null
field(r)
bound(z)
viaMap(n)
narrow(s)
function field(q) { print((q ?? { x: 0 }).x) }
function bound(q) {
  const v = q ?? { x: 0 }
  print(v.x)
}
function viaMap(q) { print((q.get("a") ?? { x: 0 }).x) }
function narrow(q) { print((q ?? { x: 3 }).x) }
