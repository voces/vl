// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 9
// @log 3
// @hint redundant type annotation: `o` is inferred as `{h: {r: i32}}` — remove it to lean on inference
// @hint redundant type annotation: `gHolder` is inferred as `{h: {r: i32}}` — remove it to lean on inference
// GRADUATED from `silent-class-inventory` D131's SECOND sentence, which that row recorded as a
// separate rung and which this file separates into its own root. A value whose REP is the
// nullable ref niche (`(ref null $S)`) but whose TYPE is the non-null struct, RETURNED from a
// function whose result valtype is `(ref $S)`: `vl check` rc 0, and `type mismatch: expected
// (ref $type), found (ref null $type)`.
//
// THE RETURN IS A KIND-9 USE SITE, AND IT IS THE ONE THAT NEVER GREW THE RECOVER.
// `emitCapturedReadRecover`'s header states the rule in as many words — "a nullable STRUCT
// (kind 9) keeps nullable reads and the USE site recovers" — and every other use site obeys
// it: a field access, a call ARGUMENT, an annotated `let` initializer and a nested-struct
// field STORE all recover, and all four run on master. Only the return did not.
//
// IT IS NOT THE NESTED FIELD READ, and `pickNarrowed` below is the control that says so: it
// contains no field read at all, only a `p != null`-narrowed nullable param returned into a
// `: Circle` result, and it is check-clean invalid wasm on master. That is why this is a
// second root and not a second spelling of the first — D131's own filed axis (the RECEIVER's
// storage class) does not appear in it, and it fires at a PARAM receiver where the first root
// never did.
//
// DISASSEMBLED RATHER THAN INFERRED, and the delta is one instruction inside the CALLEE:
// `struct.get 1 0` / `return` becomes `struct.get 1 0` / `ref.as_non_null` / `return`. The
// functype `(param (ref 1)) (result (ref 0))` is unchanged and the caller is byte-identical.
//
// THE POPULATION IT CAN MOVE IS ENTIRELY INVALID WASM TODAY, which is what makes the recover
// safe rather than merely plausible: the guard is "the RESULT VALTYPE is a non-null ref" AND
// "the value classifies as the nullable niche", and those two together ARE the validation
// failure — a value some inner path already recovered is a module that validates, so no such
// program is inside the guard. Corpus: 0 of 2,3xx files change their emitted-module sha256.
//
// MEASURED on the same 1,732-cell grid (`scripts/silent-sweep/d131/`): this rung moves 240
// cells, every one to `runs`, every one at `ann=nonnul`, and — unlike the first root — spread
// evenly over ALL FOUR receiver storage classes (60 each), which is the measurement that says
// it is receiver-blind. The two rungs' moved sets are DISJOINT and their union is exactly the
// full branch's 360.
type Circle = { r: i32 }
type Holder = { h: Circle }

// The nested-struct field read under an explicit NON-NULL return annotation, at each receiver
// storage class the first root distinguishes and this one does not.
function fromParam(o: Holder): Circle {
  return o.h
}

function fromLocal(n: i32): Circle {
  const o: Holder = { h: { r: n } }
  return o.h
}

function fromHop(o: Holder): Circle {
  const c = o.h
  return c
}

const gHolder: Holder = { h: { r: 7 } }

function fromGlobal(): Circle {
  return gHolder.h
}

// TWO HOPS, so the recover is not depth-keyed.
type Mid = { g: Circle }
type Deep = { h: Mid }

function fromDeep(o: Deep): Circle {
  return o.h.g
}

// THE CONTROL WITH NO FIELD READ AT ALL — a `!= null`-narrowed nullable param returned into a
// non-null result. Check-clean invalid wasm on master, and the reason this is its own root.
function pickNarrowed(p: Circle | null, d: Circle): Circle {
  if p != null { return p }
  return d
}

print(fromParam({ h: { r: 7 } }).r)
print(fromLocal(7).r)
print(fromHop({ h: { r: 7 } }).r)
print(fromGlobal().r)
print(fromDeep({ h: { g: { r: 7 } } }).r)
print(pickNarrowed(null, { r: 9 }).r)
print(pickNarrowed({ r: 3 }, { r: 9 }).r)
