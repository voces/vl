// @run
// @log n
// @log y
// @log uy
// @log y
// @log vtrue
// @log wfalse
// @log true
// @log true
// @log true
// @log false
// @log false
// @log true
// @log true
// A record compare whose element side reads a global list at a variable index, its boolean
// delivered at each position: a boolean and a union parameter, a nested call, a concatenation,
// an interpolation hole, a return, a binding, an `if` arm, a `??` operand and a record field.
import { toString } from "std:fmt"

type P = { x: i32, y: i32 }
type Got = { g: boolean }
const xs: P[] = [{ x: 1, y: 2 }, { x: 1, y: 3 }]
function yes(b: boolean) { return if b { "y" } else { "n" } }
function su(w: boolean | string) {
  if w is string { return w }
  return "u" + yes(w)
}
function not(b: boolean) { return !b }
function pCall(i: i32, p: P) { print(yes(xs[i] == p)) }
function pUnion(i: i32, p: P) { print(su(xs[i] == p)) }
function pNested(i: i32, p: P) { print(yes(not(xs[i] == p))) }
function pConcat(i: i32, p: P) { print("v" + toString(xs[i] == p)) }
function pHole(i: i32, p: P) { print("w\{xs[i] == p}") }
function pReturn(i: i32, p: P) { return xs[i] == p }
function pLet(i: i32, p: P) {
  const c = xs[i] != p
  print(c)
}
function pIf(i: i32, p: P, k: boolean) {
  const c = if k { xs[i] == p } else { false }
  print(c)
}
function pCoal(i: i32, p: P, k: boolean) {
  const o = if k { null } else { true }
  print(o ?? xs[i] == p)
}
function pRec(i: i32, p: P) {
  const r: Got = { g: xs[i] == p }
  print(r.g)
}
const p: P = { x: 1, y: 3 }
pCall(0, p)
pCall(1, p)
pUnion(1, p)
pNested(0, p)
pConcat(1, p)
pHole(0, p)
print(pReturn(1, p))
pLet(0, p)
pIf(1, p, true)
pIf(1, p, false)
pCoal(0, p, true)
pCoal(1, p, true)
pRec(1, p)
