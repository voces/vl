// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// CONTRACT (D1700): a nested inline shape interns in time LINEAR in its depth. Each field
// used to intern its nested shape twice — once through `internShapeDeepTy` and again to
// recover the row when `nameFieldCodeTy` declined — which is 2^depth walks of one spine, and
// at depth 20 the doubling reached an allocation the GC heap cannot hold.
//
// The declared row is the ingredient: without `type H` the same literal always interned once
// per level. Each function here pairs a declared row with a literal of the same shape, so the
// capture question is asked at every level of the spine.
//
// Depths 20 and 25 are past the old floor; depth 30 is past the walk's own reach at the bound
// this comparator ships with, and must keep printing the value its own leaf holds.
type U1 = i32 | boolean
type U2 = string | boolean

function u1(): U1 { return 7 }

// Depth 2, the declared row present.
type H2 = { f: { g: { g: { xs: U2 } } } }
function d2() {
  const b = { f: { g: { g: { xs: u1() } } } }
  print(b.f.g.g.xs)
}

// Depth 20, the declared row present.
type H20 = {
  f: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { xs: U2 } } } } } } } } } } } } } } } } } } } } },
}
function d20() {
  const b = {
    f: {
      g: {
        g: {
          g: {
            g: {
              g: {
                g: {
                  g: {
                    g: {
                      g: {
                        g: {
                          g: {
                            g: { g: { g: { g: { g: { g: { g: { g: { g: { xs: u1() } } } } } } } } },
                          },
                        },
                      },
                    },
                  },
                },
              },
            },
          },
        },
      },
    },
  }
  print(b.f.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.xs)
}

// Depth 30, the declared row present.
type H30 = {
  f: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { g: { xs: U2 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } },
}
function d30() {
  const b = {
    f: {
      g: {
        g: {
          g: {
            g: {
              g: {
                g: {
                  g: {
                    g: {
                      g: {
                        g: {
                          g: {
                            g: {
                              g: {
                                g: {
                                  g: {
                                    g: {
                                      g: {
                                        g: {
                                          g: {
                                            g: {
                                              g: {
                                                g: { g: { g: { g: { g: { g: { g: { g: { g: { xs: u1() } } } } } } } } },
                                              },
                                            },
                                          },
                                        },
                                      },
                                    },
                                  },
                                },
                              },
                            },
                          },
                        },
                      },
                    },
                  },
                },
              },
            },
          },
        },
      },
    },
  }
  print(b.f.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.g.xs)
}

// Depth 2 with NO declared row — the control, green before this close too.
function c2() {
  const b = { f: { g: { g: { xs: u1() } } } }
  print(b.f.g.g.xs)
}

