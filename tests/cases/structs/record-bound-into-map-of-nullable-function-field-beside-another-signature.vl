// @run
// @log 3
// @log true
// @log 6
// @log false
// A bound record delivered into a map whose value's function field is nullable joins that
// field's row at its own signature, not a literal's row whose closure has another one (D3182).
const other = { v: 99, f: () => true }
const l = { v: 1, f: () => 3 }
const m: {[string]: { v: i32, f: (() => i32) | null }} = Map()
m.set("a", l)
const q = m.get("a")
if q != null {
  const g = q.f
  if g != null { print(g()) }
}
print(other.f())
const o2 = { v: 99, f: (s: string) => s.length > 100 }
const l2 = { v: 1, f: (x: i32) => x * 3 }
const m2: {[string]: { v: i32, f: ((i32) => i32) | null }} = Map()
m2.set("a", l2)
const q2 = m2.get("a")
if q2 != null {
  const g2 = q2.f
  if g2 != null { print(g2(2)) }
}
print(o2.f("x"))
