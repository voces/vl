// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// A record whose leaf is delivered at a wider storage seven, eight and twelve records down: an
// `i32` read as `i32 | null`, as `f64` and as `i32 | string` (D16735's mechanism, clause 1).

function nul7(x: {a: {b: {c: {d: {e: {g: {h: {v: i32 | null}}}}}}}}) {
  print(x.a.b.c.d.e.g.h.v ?? 0)
}
nul7({ a: { b: { c: { d: { e: { g: { h: { v: 1 } } } } } } } })

function fl7(x: {a: {b: {c: {d: {e: {g: {h: {v: f64}}}}}}}}) {
  print(x.a.b.c.d.e.g.h.v)
}
fl7({ a: { b: { c: { d: { e: { g: { h: { v: 2 } } } } } } } })

function un7(x: {a: {b: {c: {d: {e: {g: {h: {v: i32 | string}}}}}}}}) {
  const y = x.a.b.c.d.e.g.h.v
  if y is i32 { print(y) } else { print(y) }
}
const r7 = { a: { b: { c: { d: { e: { g: { h: { v: 3 } } } } } } } }
un7(r7)

function nul8(x: {a: {b: {c: {d: {e: {g: {h: {i: {v: i32 | null}}}}}}}}}) {
  print(x.a.b.c.d.e.g.h.i.v ?? 0)
}
nul8({ a: { b: { c: { d: { e: { g: { h: { i: { v: 4 } } } } } } } } })

function fl8(x: {a: {b: {c: {d: {e: {g: {h: {i: {v: f64}}}}}}}}}) {
  print(x.a.b.c.d.e.g.h.i.v)
}
fl8({ a: { b: { c: { d: { e: { g: { h: { i: { v: 5 } } } } } } } } })

function un8(x: {a: {b: {c: {d: {e: {g: {h: {i: {v: i32 | string}}}}}}}}}) {
  const y = x.a.b.c.d.e.g.h.i.v
  if y is i32 { print(y) } else { print(y) }
}
const r8 = { a: { b: { c: { d: { e: { g: { h: { i: { v: 6 } } } } } } } } }
un8(r8)

function nul12(
  x: {a: {b: {c: {d: {e: {g: {h: {i: {j: {m: {n: {o: {v: i32 | null}}}}}}}}}}}}},
) {
  print(x.a.b.c.d.e.g.h.i.j.m.n.o.v ?? 0)
}
nul12(
  {
    a: {
      b: { c: { d: { e: { g: { h: { i: { j: { m: { n: { o: { v: 7 } } } } } } } } } } },
    },
  },
)

function fl12(
  x: {a: {b: {c: {d: {e: {g: {h: {i: {j: {m: {n: {o: {v: f64}}}}}}}}}}}}},
) {
  print(x.a.b.c.d.e.g.h.i.j.m.n.o.v)
}
fl12(
  {
    a: {
      b: { c: { d: { e: { g: { h: { i: { j: { m: { n: { o: { v: 8 } } } } } } } } } } },
    },
  },
)

function un12(
  x: {a: {b: {c: {d: {e: {g: {h: {i: {j: {m: {n: {o: {v: i32 | string}}}}}}}}}}}}},
) {
  const y = x.a.b.c.d.e.g.h.i.j.m.n.o.v
  if y is i32 { print(y) } else { print(y) }
}
const r12 = {
  a: {
    b: {
      c: {
        d: { e: { g: { h: { i: { j: { m: { n: { o: { v: 9 } } } } } } } } },
      },
    },
  },
}
un12(r12)
