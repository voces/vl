// @run
// @log 11
// @log 2
// @log true
// @log 12
// @log 13
// @log 14
// @log 15
// @log 16
// A list literal of records whose field names a declared record shares, a function field's
// signature apart, built where the declared record's row serves it: a module binding, beside a
// value of the declared record, in a function, returned, two elements, pushed to and walked.
type R = { v: i32, f: () => boolean }
const xs = [{ v: 2, f: () => 11 }]
print(xs[0].f())
print(xs[0].v)
const r: R = { v: 1, f: () => true }
print(r.f())
function local() {
  const ys = [{ v: 3, f: () => 12 }]
  return ys[0].f()
}
print(local())
function made() { return [{ v: 4, f: () => 13 }] }
print(made()[0].f())
const two = [{ v: 5, f: () => 14 }, { v: 6, f: () => 15 }]
print(two[0].f())
print(two[1].f())
const grow = [{ v: 7, f: () => 16 }]
for g in grow { print(g.f()) }
