// @run
// @log 2.5
// @log 2.5
// @log 2.5
// @log 3
// A nested literal whose data field widens into a declared record's but whose function field
// differs in signature keeps its own row, so its closure is called at its own type (D3181).
type I = { v: f64, f: () => boolean }
type R = { inner: I }
function F(z) { print(z.inner.f()) }
F({ inner: { v: 3, f: () => 2.5 } })
function G<Z>(z: Z) { print(z.inner.f()) }
G({ inner: { v: 3, f: () => 2.5 } })
const r = { inner: { v: 3, f: () => 2.5 } }
F(r)
print(r.inner.v)
