// @run
// @log 6
// @log 0.5
// @log 4
// @log 0.5
// A kept maker delivered at a row storing a field as a wider number, or a nested record as a
// record or `null`: the call copy converts the field exactly, at any depth, and the unannotated
// call keeps its own row.
type K = { f: i64, g: f64 }
function mk() { { f: 2, g: 4 } }
const _k: K = mk()
const y = mk()
print(y.f + y.g)
print(_k.g / 8.0)
type J = { f: f64 }
type L = { j: J | null }
function mk2() { { j: { f: 4 } } }
const _l: L = mk2()
const z = mk2()
print(z.j.f)
print((_l.j?.f ?? 0.0) / 8.0)
