// @run
// @log false
// @log 2
// @log true
// A nullable nested record compared with a global list's element at a global index a call moves.
type P = { x: i32, y: i32 }
type C = { p: P, z: i32 }
const xs: (C | null)[] = [
  { p: { x: 1, y: 2 }, z: 3 },
  null,
  { p: { x: 9, y: 9 }, z: 9 },
]
let i = 0
function moveTo(k: i32, g: C | null) {
  i = k
  return g
}
function lp(c: C | null) { return c == xs[i] }
print(lp(moveTo(2, xs[0])))
print(i)
i = 0
print(moveTo(2, xs[0]) != xs[i])
