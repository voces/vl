// @run
// @log true
// @log false
// @log false
// @log false
// @log false
// @log true
// @log true
// @log 2
// @warning on `A12` compares every element of its list field

// `==` and `!=` over a twelve-level record whose every level holds the one below twice and
// whose leaf holds lists and a nullable scalar, compared through one comparison per record
// type (D9962): equal, then unequal at a list's length, a list element, a null and a record
// element, inside a function, beside a map.

type P = {p: i32}
type A0 = {x: i32[], n: i32 | null, s: string[], q: P[]}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
type A11 = {l: A10, r: A10}
type A12 = {l: A11, r: A11}

function lift(a0: A0, b0: A0): A12[] {
  const a1: A1 = { l: a0, r: a0 }
  const a2: A2 = { l: a1, r: a1 }
  const a3: A3 = { l: a2, r: a2 }
  const a4: A4 = { l: a3, r: a3 }
  const a5: A5 = { l: a4, r: a4 }
  const a6: A6 = { l: a5, r: a5 }
  const a7: A7 = { l: a6, r: a6 }
  const a8: A8 = { l: a7, r: a7 }
  const a9: A9 = { l: a8, r: a8 }
  const a10: A10 = { l: a9, r: a9 }
  const a11: A11 = { l: a10, r: a10 }
  const a12: A12 = { l: a11, r: a11 }
  const b1: A1 = { l: a0, r: b0 }
  const b2: A2 = { l: a1, r: b1 }
  const b3: A3 = { l: a2, r: b2 }
  const b4: A4 = { l: a3, r: b3 }
  const b5: A5 = { l: a4, r: b4 }
  const b6: A6 = { l: a5, r: b5 }
  const b7: A7 = { l: a6, r: b6 }
  const b8: A8 = { l: a7, r: b7 }
  const b9: A9 = { l: a8, r: b8 }
  const b10: A10 = { l: a9, r: b9 }
  const b11: A11 = { l: a10, r: b10 }
  const b12: A12 = { l: a11, r: b11 }
  [a12, b12]
}

function same(a: A12, b: A12) { a == b }

const base: A0 = { x: [1, 2], n: null, s: ["a"], q: [{ p: 1 }] }
const pairs = [
  lift(base, { x: [1, 2], n: null, s: ["a"], q: [{ p: 1 }] }),
  lift(base, { x: [1], n: null, s: ["a"], q: [{ p: 1 }] }),
  lift(base, { x: [1, 3], n: null, s: ["a"], q: [{ p: 1 }] }),
  lift(base, { x: [1, 2], n: 4, s: ["a"], q: [{ p: 1 }] }),
  lift(base, { x: [1, 2], n: null, s: ["a"], q: [{ p: 2 }] }),
]
for ab in pairs { print(same(ab[0], ab[1])) }
const ne = pairs[1]
print(ne[0] != ne[1])
const m = Map()
m["k"] = 2
print(pairs[0][0] == pairs[0][0])
print(m["k"] ?? 0)
