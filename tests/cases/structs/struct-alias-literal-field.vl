// A struct alias whose shape holds a literal field: canon rewrites the literal in the alias's
// spelling, and the alias's fields are read from its record type, so the row keeps `k` and `b`.
// @run
// @log 1
// @log 2
// @log 6
// @log 3
type AB = { k: 1 } & { b: i32 }
const p: AB = { k: 1, b: 2 }
print(p.k)
print(p.b)
const ps: AB[] = [p, { k: 1, b: 5 }]
print(ps[1].b + ps[0].k)
function sum(x: AB) { x.k + x.b }
print(sum(ps[0]))
