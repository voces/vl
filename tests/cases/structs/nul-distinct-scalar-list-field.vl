// @run
// @log 2.5
// @log 13131313131
// @log 65.5
// @log yo
// @log NULL
// @log NULL
// @log NULL
// @log NULL
// @log 4.5
// @log 752985496505
// @log 32.25
// @log hey
// @log NULL
// @log OMITTED-NULL
// @log 13131313131
// A struct FIELD whose type is a NULLABLE DISTINCT-BACKING scalar list — all four
// spellings: `string[] | null` (code 31, the `$mkListIdx` wrapper), `f64[] | null` (32,
// `$fl64TypeIdx`), `i64[] | null` (33, `$il64TypeIdx`), `f32[] | null` (34,
// `$fl32TypeIdx`). Each is the leaf list's OWN wrapper made nullable — the FIELD-position
// mirror of the same-named binding niche (`nulScalarListKind`) and of the list-ELEMENT
// position (`nullArrayArrElem` kinds 6/7/8/10). Before these codes the whole family had NO
// field code at all: code 18 covers only the i32-backed leaf and code 28 only ref
// elements, so any shape carrying one was a loud reject ("no interned signature" /
// "ref-list field element type is not interned").
//
// Covered here: the DECLARED struct spelling, the INLINE-shape annotation, a field that
// only ever holds `null` (nothing else in the module builds that leaf list — the
// `forceScalarListField` / code-31 wrapper forcing), an OMITTED field completing to
// `ref.null $wrapper`, and the CLOSURE-RESULT spelling whose sig now interns. The
// build-kind seed also has to reach the field's list literal: `{b: [752985496505]}` of an
// `i64[] | null` field widens its bare int to i64 (`pendingListKind` 6) and `{c: [32.25]}`
// re-encodes at f32 (kind 7) — a wrong seed would store f64 bits in the f32 backing.
type S = {a: f64[] | null, b: i64[] | null, c: f32[] | null, d: string[] | null}

function show(s: S) {
  const a = s.a
  if a != null { print(a[1]) } else { print("NULL") }
  const b = s.b
  if b != null { print(b[0]) } else { print("NULL") }
  const c = s.c
  if c != null { print(c[0]) } else { print("NULL") }
  const d = s.d
  if d != null { print(d[1]) } else { print("NULL") }
}

// DECLARED struct — every field populated, then every field `null`.
function go0() {
  show({ a: [1.5, 2.5], b: [13131313131], c: [65.5], d: ["hi", "yo"] })
  show({ a: null, b: null, c: null, d: null })
}
go0()

// INLINE-shape annotation, with the widening edge (`[752985496505]` into an `i64[] | null`
// field, `[32.25]` into an `f32[] | null` field — the field's `pendingListKind` seed has to
// reach the literal's elements). Its own field NAMES, so the shape does not dedup onto the
// declared `S` row above (an inline binding whose shape resolves to a same-fieldset DECLARED
// struct is a separate, pre-existing loud reject).
function go1() {
  const s: {p: f64[] | null, q: i64[] | null, r: f32[] | null, t: string[] | null} = {
    p: [
      3.5,
      4.5,
    ],
    q: [
      752985496505,
    ],
    r: [
      32.25,
    ],
    t: [
      "ho",
      "hey",
    ],
  }
  const p = s.p
  if p != null { print(p[1]) } else { print("NULL") }
  const q = s.q
  if q != null { print(q[0]) } else { print("NULL") }
  const r = s.r
  if r != null { print(r[0]) } else { print("NULL") }
  const t = s.t
  if t != null { print(t[1]) } else { print("NULL") }
}
go1()

// A field that ONLY ever holds `null` — the module has no other `string[]`-only mention on
// this shape, so the field's own code-31 forcing is what keeps the `$mkListIdx` wrapper +
// string backing allocated.
function go2() {
  const s: {q: string[] | null} = { q: null }
  const q = s.q
  if q != null { print(q[0]) } else { print("NULL") }
}
go2()

// An OMITTED nullable field completes to `ref.null $wrapper` (`emitOmittedFieldNull`).
function go3() {
  const s: {r: i32, w: f32[] | null} = { r: 1 }
  const w = s.w
  if w != null { print(w[0]) } else { print("OMITTED-NULL") }
}
go3()

// CLOSURE RESULT — the shape that used to fail loudly at the call ("function-value call
// arity has no interned signature"): the annotation's `{f: i64[] | null}` now classifies,
// so `funcTypeShapeLowerable` admits it and the sig interns.
// @hint Intentionally-unused parameter `_q0`
function makeIt(): (i32) => {f: i64[] | null} {
  return (_q0) => ({ f: [712583, 13131313131] })
}
function go4() {
  const v: (i32) => {f: i64[] | null} = makeIt()
  const l = v(1).f
  if l != null { print(l[1]) } else { print("NULL") }
}
go4()
