// @check
// @error-at 14:19 field `a` is declared twice in this record type (first at 15:12)
// @error-at 15:22 field `v` is declared twice in this record type (first at 16:17)
// @error-at 16:27 field `a` is declared twice in this record type (first at 17:20)
// @error-at 17:19 field `a` is declared twice in this record type (first at 18:12)
// @error-at 18:24 field `b` is declared twice in this record type (first at 19:17)
// @error-at 22:2 field `a` is declared twice in this record type (first at 21:3)
// @error-at 24:43 field `a` is declared twice in this record type (first at 25:28)
// @error-at 25:26 field `a` is declared twice in this record type (first at 26:19)
// @error-at 26:21 field `a` is declared twice in this record type (first at 27:14)
// A record type that declares a field twice is a check error at the repeated field name, in a
// `type` declaration, a generic one, a union arm, an intersection, a nested record and an inline
// annotation alike (owner ruling 2026-10-03, D3537). A literal of such a type gets that error
// alone, with no undeclared-field refusal naming an empty field.
type P = { a: i32, a: i32 }
type Box<T> = { v: T, v: T }
type U = { k: "x", a: i32, a: i32 } | { k: "y" }
type I = { a: i32, a: i32 } & { c: i32 }
type N = { a: { b: i32, b: i32 } }
type M = {
  a: i32,
  b: i32,
  a: i32,
}
export function param(p: { a: i32, b: i32, a: string }) { return p.b }
function ret(): { a: i32, a: i32 } | null { return null }
const ann: { a: i32, a: i32 } | null = null
const u: U = { k: "y" }
export function use(p: P, b: Box<i32>, i: I, n: N, m: M) {
  print(p.a + b.v + i.c + n.a.b + m.b)
}
print(u.k)
print(ann == null)
print(ret() == null)
const lit: P = { a: 1 }
const arm: U = { k: "x", a: 1 }
print(lit.a)
print(arm.k)
