type P = { a: i32, a: i32 }
type Box<T> = { v: T, v: T }
type U = { k: "x", a: i32, a: i32 } | { k: "y" }
type I = { a: i32, a: i32 } & { c: i32 }
type N = { a: { b: i32, b: i32 } }
type M = {
  a: i32,
  b: i32,
  a: i32,
}
export function param(p: { a: i32, b: i32, a: string }) { return p.b }
function ret(): { a: i32, a: i32 } | null { return null }
const ann: { a: i32, a: i32 } | null = null
const u: U = { k: "y" }
export function use(p: P, b: Box<i32>, i: I, n: N, m: M) {
  print(p.a + b.v + i.c + n.a.b + m.b)
}
print(u.k)
print(ann == null)
