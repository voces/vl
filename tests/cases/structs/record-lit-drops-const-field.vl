// @run
// @log 21
// @log 1
// @log 21
// @log 21
// @log 21
// @log 2
// A record literal whose nested element sets a field the element's shape drops, with a constant
// initialiser: as a module global (annotated by inference and with no declared type at all),
// in a function, in a struct field and in a capture (D5342).
type M = { n: i32, kids: { n: i32 }[] }
const g = { n: 1, kids: [{ n: 2, kids: [] }] }
print(g.n + g.kids[0].n * 10)
const bare = { n: 1, kids: [{ n: 2, extra: 3 }] }
print(bare.n)
const typed: M = { n: 1, kids: [{ n: 2, kids: [] }] }
print(typed.n + typed.kids[0].n * 10)
function local() {
  const l = { n: 1, kids: [{ n: 2, kids: [] }] }
  l.n + l.kids[0].n * 10
}
print(local())
const box = { m: { n: 1, kids: [{ n: 2, kids: [] }] } }
print(box.m.n + box.m.kids[0].n * 10)
const read = () => g.kids[0].n
print(read())
