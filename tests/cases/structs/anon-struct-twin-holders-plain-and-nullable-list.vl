// @run
// @log 7
// @log 8
// @log 4
// @log 9
// @log 3
// @log 11
// @log 8
// CONTRACT (D1663): a ref-list field and its `| null` niche are two field CODES over one
// storage shape — `(ref $arr)` at code 5 and `(ref null $arr)` at code 28 — so two holders
// sharing a field name over the two codes are two rows, whatever their elements are. The
// element goes the other way: one element type is ONE key at both codes, so both fields
// intern one ref-list wrapper.
//
// The sibling fixtures keep the two codes apart precisely because this pair used to refuse:
// `anon-struct-twin-holders-nullable-list-and-box-fields.vl` holds only code-28 holders and
// `anon-struct-twin-holders-shared-field-name.vl` only code-5 ones. This is the file that
// mixes them.
//
// NOTHING HERE MAY DECLARE THE OUTER SHAPE. An unused `type Holder = { xs: A[] }` is the
// rescue, and it would make every read pass for the wrong reason. Each read goes THROUGH the
// element and prints a value only the right row can produce.
type A = { r: i32 }
type B = { q: i32, tag: string }

function as1(): A[] { return [{ r: 7 }] }
function ns1(): A[] | null { return [{ r: 8 }] }
function ms1(): B[] | null { return [{ q: 4, tag: "a" }] }
function joins(): ((string) => i32)[] { return [(s: string) => s.length] }
function njoins(): ((string) => i32)[] | null {
  return [(s: string) => s.length + 1]
}

// The filed pair: one field name, one element, the two codes.
function plainBesideNullable() {
  const one = { xs: as1() }
  print(one.xs[0].r)
  const two = { xs: ns1() }
  const l = two.xs
  if l != null { print(l[0].r) }
}

// The same pair with the elements ALSO differing, so the element test and the code test are
// both exercised on one field name.
function nullableOverAnotherElement() {
  const three = { xs: ms1() }
  const l = three.xs
  if l != null { print(l[0].q) }
}

// One element type spelled two ways across the two codes: the declared name at code 5 and the
// inline shape at code 28. Two rows, and the element is one key.
function oneElementTwoSpellings() {
  const four = { ys: as1() }
  print(four.ys[0].r + 2)
  const five = { ys: nulInline() }
  const l = five.ys
  if l != null { print(l[0].r) }
}
function nulInline(): { r: i32 }[] | null { return [{ r: 3 }] }

// An element no struct row names, at both codes under one field name.
function closureElementBothCodes() {
  const six = { zs: joins() }
  print(six.zs[0]("hello ma") + 3)
  const seven = { zs: njoins() }
  const l = seven.zs
  if l != null { print(l[0]("helloma")) }
}

plainBesideNullable()
nullableOverAnotherElement()
oneElementTwoSpellings()
closureElementBothCodes()
