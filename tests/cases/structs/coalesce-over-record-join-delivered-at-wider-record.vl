// @run
// @log 70
// @log 5
// @log 5
// @log 71
// @hint redundant type annotation: `d` is inferred as `{f: i32 | null}`
// A `??` over a value `if` of record literals, delivered to a record storing a field wider, builds
// both operands and the join at that record, at module scope and inside a function (D3389).
type J = { f: i32 | null }
const x = 3
const b: J = (if x > 0 { { f: 5 } } else { null }) ?? { f: 6 }
b.f = null
print(b.f ?? 70)
const m: J = (if x > 0 { { f: 5 } } else { null }) ?? { f: 6 }
print(m.f ?? 70)
function g(y: i32) {
  const c: J = (if y > 0 { { f: 5 } } else { null }) ?? { f: 6 }
  print(c.f ?? 70)
  const d: J = (if y < 0 { { f: 5 } } else { null }) ?? { f: null }
  print(d.f ?? 71)
}
g(x)
