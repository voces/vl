// @run
// @log true
// @log true
// @log empty
// @log true
// @log false
// @log true
// @log true
// @log true
// An empty list fits every `K[]` (the D4771 ruling), so `is K[]` over a record literal's
// un-annotated empty list field holds at any element: at the top level, in a function, as a
// binding, an `if` condition, a return, negated, a list element's field and a hole parameter's
// field (D5470).
const r = { n: 1, kids: [] }
print(r.kids is string[])
function f() {
  const q = { n: 1, kids: [] }
  print(q.kids is string[])
}
f()
const b = r.kids is string[]
if b && r.kids is string[] { print("empty") }
function g() { return r.kids is f64[] }
print(g())
print(!(r.kids is string[]))
const rs = [{ n: 2, kids: [] }]
print(rs[0].kids is string[])
function h(p) { return p.kids is string[] }
print(h({ n: 3, kids: [] }))
print(b)
