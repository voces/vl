// @run
// @log 2
// @log 1.5
// @log 3
// @log 9000000000
// @log 4
// @log 1.25
// CONTRACT (must-RUN): `p?.f ?? d` over a NULLABLE-STRUCT receiver at
// every WIDE NUMERIC field rep. Both arms of the lowering's `if` leave the field's own rep
// on the stack, so the `if` needs a blocktype spelling it — and the site hard-coded
// `fbIf(127)`, the i32 byte. That is where the sentence "supports only i32/boolean fields"
// came from, and the sentence was accurate: `f64`, `i64` and `f32` fields all refused while
// the NARROWED spelling of the same read (`if x != null { print(x.y) }`) ran at every one.
//
// THE BLOCKTYPE HAS A HOME ALREADY — `fbIfForSharedField`, over the same `sFieldTypeAt`
// codes, written for the shared-union-field dispatch. One predicate and one emitter, shared,
// so the two sites cannot drift about which reps a value-typed `if` can carry.
//
// THE DEFAULT COERCES, and that half is not optional: `?? 2` against an `f64` field is an
// `i32.const` unless somebody widens it, and the `if`'s blocktype is `f64` — invalid wasm.
// Every literal default below is spelled at the WRONG width on purpose so the coercion is
// what makes the fixture pass.
type Bf = { y: f64 }
type Bi = { y: i64 }
type B3 = { y: f32 }

function ff(x: Bf | null) { print((x?.y) ?? 2) }
function fi(x: Bi | null) { print((x?.y) ?? 3) }
function f3(x: B3 | null) { print((x?.y) ?? 4) }

ff(null) // 2      — the default, widened i32 → f64
ff({ y: 1.5 }) // 1.5
fi(null) // 3      — the default, widened i32 → i64
fi({ y: 9000000000 }) // 9000000000
f3(null) // 4      — the default, widened i32 → f32
const q: f32 = 1.25
f3({ y: q }) // 1.25
