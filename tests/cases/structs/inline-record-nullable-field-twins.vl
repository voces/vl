// @run
// @log true
// @log 2
// @log 2
// @log -1
// @log 5
// @log 7
// @log 2
// @log 9
// @log 4
// @log 5
// Two inline record types that differ only in whether a record field admits null share one row,
// and every position of either type finds it, in either order of first use (D3914).
type A = { x: i32 }
const q: { v: A | null } = { v: null }
print(q.v == null)
function g(e: { v: A }) { e.v.x }
const o: { v: A } = { v: { x: 2 } }
print(g(o))
function mk(): { v: A } { return { v: { x: 2 } } }
print(mk().v.x)
function h(e: { v: A | null }) {
  if e.v == null { return 0 - 1 }
  return e.v.x
}
print(h(q))
print(h({ v: { x: 5 } }))
print(q.v?.x ?? 7)
type B = { y: i32 }
const p: { u: B } = { u: { y: 2 } }
print(p.u.y)
function k(e: { u: B | null, w: i32 }) {
  if e.u == null { return e.w }
  return e.u.y
}
print(k({ u: null, w: 9 }))
const xs: { u: B | null, w: i32 }[] = [{ u: null, w: 4 }, { u: { y: 5 }, w: 0 }]
for e in xs { print(k(e)) }
