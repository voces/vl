// @run
// @log 4 1
// @log 4 1 2
// @log 1
// @log 3
// @log false 1 1 1
// D16392, D16277: a call's fresh record is copied into the storage a list of its record is built
// at, a reference field or list element held in its `| null` as it is stored.
type J = { f: (() => i32) | null }
function mk() { { f: () => 4 } }
const wideJ: J = mk()
const js = [mk()]
function os0() { { f: () => 1 } }
js.push(os0())
let o = ""
for w in js { o = o + (if o.length > 0 { " " } else { "" }) + "\{w.f()}" }
print(o)

type L = { f: ({ g: i32 } | null)[] }
function mkl() { { f: [{ g: 4 }] } }
const wideL: L = mkl()
const ls = [mkl()]
function ol() { { f: [{ g: 1 }, { g: 2 }] } }
const ws = [ls[0], ol()]
let p = ""
for w in ws {
  for e in w.f { p = p + (if p.length > 0 { " " } else { "" }) + "\{e.g}" }
}
print(p)

type S = { f: (string[] | null)[] }
function mks() { { f: [["a"]] } }
const wideS: S = mks()
const ss = [mks()]
print(ss[0].f[0].length)

type F = { f: ((() => i32) | null)[] }
function mkf() { { f: [() => 3] } }
const wideF: F = mkf()
const fs = [mkf()]
print(fs[0].f[0]())
print(
  "\{wideJ.f == null} \{wideL.f.length} \{wideS.f.length} \{wideF.f.length}",
)
