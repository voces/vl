// @run
// @log 2
// @log 1
// @log 2
// A fresh call copied where it lands, whose record is also an arm of a row union, is copied from
// the arm's own row.
type W = { f: i64 }
function mk() { { f: 1 } }
function rows() {
  const t = [{ f: 1 }, { g: "x" }]
  t
}
const a: W = mk()
const b = mk()
print(a.f + 1)
print(b.f)
print(rows().length)
