// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// GRADUATED from `silent-class-inventory` D53 — an INLINE-SHAPE parameter in a program that
// ALSO declares a struct of that layout. `function paramAlias(c: { r: i32 })` beside
// `type Boxed = { r: i32 }` was `vl check` rc 0 and `emitProgram: ref valtype with no interned
// shape`; DELETING the declared struct made the same program run, and so did spelling the
// parameter `c: Boxed`. Two spellings of one type, one of them lowering.
//
// TWO CLAIMANTS FOR ONE SHAPE, AND ONLY ONE OF THEM HAD A KEY. `internInlineShapeTy` ends in
// `annShapeIndexOf`, which DEDUPS the inline shape onto the declared row and pushes no
// `sNames` entry for `{r:i32}` — correct, and it leaves `structIndexByName("{r:i32}")` with
// nothing to find. `paramStructIndex` asked only that name, while the FUNCTYPE for the very
// same node resolved through `retStructIndex`'s `repSlotOfTy` bridge and emitted
// `(ref $Boxed)`. `annValtypeSlotOf`'s own header names this failure in advance: "a SHORTENED
// MIRROR of this ladder is a `ref valtype with no interned shape` reject for exactly the kinds
// it never learned".
//
// THE RUNG IS ASKED LAST AND UNDER TWO MORE GUARDS, and each answers a recorded failure rather
// than being defensive in general. LAST, so every call the earlier arena-rung RETRACTION
// measured keeps its answer. INLINE SHAPES ONLY, because `repSlotOfTy`'s structural bridge
// would hand a union ARM the row of an exact layout twin — the D63/D75 collapse, in the one
// namespace this resolver's header forbids it to enter. And NOT A GENERIC ORIGINAL, which is
// the retraction's own counterexample (`f<T>(v: { g: (T | null)[] })` — an inline shape too,
// so the shape guard alone does not exclude it); `error-param-shadow-tyaram-nullable-elem.vl`
// is that pin.
//
// THE ROWS ARE THE DELIVERY CHAIN. The parameter is read directly, through one alias hop, as
// a member access, and out of an un-annotated / inline-annotated / nominally-annotated result
// — because the reject was reached from THREE resolvers (the inferred return valtype, the
// member-read floor and the local's own slot) and one of them running is not the others.
type Boxed = { r: i32 }

// THE FILED WITNESS, verbatim.
function paramAlias(c: { r: i32 }) {
  const o = c
  return o
}

// No local: the parameter is the returned value.
function paramDirect(c: { r: i32 }) { return c }

// The MEMBER READ, which is the other resolver — `emitProgram: field access receiver is not a
// struct` before this change.
function paramRead(c: { r: i32 }) {
  const o = c
  return o.r
}

// The result annotated with the INLINE shape.
function paramRetAnnInline(c: { r: i32 }): { r: i32 } {
  const o = c
  return o
}

// The result annotated with the DECLARED name, over an inline-shape parameter — the two
// spellings meeting in one signature.
function paramRetAnnNamed(c: { r: i32 }): Boxed {
  const o = c
  return o
}

// The control the row names: the parameter spelled NOMINALLY. It ran before and runs now.
function paramNominal(c: Boxed) {
  const o = c
  return o
}

print(paramAlias({ r: 7 }).r)
print(paramDirect({ r: 7 }).r)
print(paramRead({ r: 7 }))
print(paramRetAnnInline({ r: 7 }).r)
print(paramRetAnnNamed({ r: 7 }).r)
print(paramNominal({ r: 7 }).r)
