// @run
// @log 4
// @log 4
// @log 5
// @log 5
// @log 3
// A kept maker whose record holds a list of records, delivered at a row whose list element stores
// a field otherwise: the call copy copies the list element by element, at any depth, and the
// unannotated call keeps its own row (D15722).
type J = { f: i32 | null }
type H = { xs: J[] }
function mk() { { xs: [{ f: 4 }] } }
const _k: H = mk()
const y = mk()
print(y.xs[0].f)
print(_k.xs[0].f ?? 0)
type G = { j: { xs: J[] } }
function mg() { { j: { xs: [{ f: 4 }, { f: 5 }] } } }
const _g: G = mg()
const z = mg()
print(z.j.xs[1].f)
print(_g.j.xs[1].f ?? 0)
_g.j.xs.push({ f: null })
print(_g.j.xs.length)
