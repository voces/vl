// @run
// @log 4
// @log q
// @log 11
// @log 1
// @log 4
// @log 4
// @log 5
// @log 7
// A fresh call's record field copied into a union of records is built at the member with its field
// names, widened where the member stores a field wider, and boxed under that member's tag.
type Cir = { c: i64 }
type Sq = { s: i32, t: string }
type Ring = { r: Cir | Sq, n: i32 }
function one() { { r: { c: 3 }, n: 1 } }
function two() { { r: { s: 5, t: "q" }, n: 2 } }
const a = one()
const b = two()
const ra: Ring = one()
const rb: Ring = two()
if ra.r is Cir { print(ra.r.c + 1) }
if rb.r is Sq { print(rb.r.t) }
print(a.r.c + b.r.s + ra.n + rb.n)
ra.n = 9
print(a.n)
// One record down, with a nullable field inside the member.
type In = { v: i32 | null }
type Cr = { c: In }
type Sr = { s: i32 }
type Outer = { o: { r: Cr | Sr } }
function deep() { { o: { r: { c: { v: 4 } } } } }
const d = deep()
const w: Outer = deep()
const wr = w.o.r
if wr is Cr { print(wr.c.v ?? 0) }
print(d.o.r.c.v ?? 0)
// The list-result spelling, then a push of the other member.
type C2 = { c: i32 }
type S2 = { s: i32 }
type R2 = { r: C2 | S2 }
function many() { [{ r: { c: 1 } }, { r: { c: 2 } }] }
const m = many()
const mw: R2[] = many()
mw.push({ r: { s: 7 } })
print(m[1].r.c + mw.length)
const z = mw[2].r
if z is S2 { print(z.s) }
