// @run
// @log 7
// @log 1
// @log 4
// @log 5
// @log 6
// @log 45.5
// CONTRACT (D1688): an anonymous struct literal whose field holds a ref list whose ELEMENT
// carries no struct row of its own — a union box, a nullable ref, a nested list, a map.
//
// D1515 gave the code-5 field its companion by reading a STRUCT row off the recorded element
// type, so any other element left the coder answering -1 and the owner literal with no row at
// all. The declared spelling keys the same field by the `[]`-stripped element TEXT, which
// needs no row, so the two faces disagreed about the rep while agreeing about the type.
//
// NOTHING HERE MAY DECLARE THE OUTER SHAPE. An unused `type Holder = { us: Shape[] }` is the
// rescue the row records, and it would make every read pass for the wrong reason. Each holder
// names its field differently on purpose: two `{ xs: … }` literals whose code-5 elements
// differ share one anonymous row at either spelling, which is a separate gap (D1689).
//
// The reads go THROUGH the element and discriminate it, so a field whose element heap type
// came from the wrong wrapper traps or prints the wrong value rather than passing.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Rec = { q: i32, tag: string }

function shapes(): Shape[] { return [{ r: 7 }] }
function maybes(): (Rec | null)[] { return [{ q: 4, tag: "a" }] }
function atoms(): (i32 | string)[] { return [5] }
function grids(): i32[][] { return [[6]] }
function tables(): {[string]: f32}[] {
  const m: {[string]: f32} = Map()
  m["k"] = 45.5
  return [m]
}

function unionElement() {
  const box = { us: shapes() }
  const e = box.us[0]
  if e is Circle { print(e.r) } else { print(0) }
  print(box.us.length)
}

function nullableElement() {
  const box = { ns: maybes() }
  const e = box.ns[0]
  if e != null { print(e.q) } else { print(0) }
}

function scalarUnionElement() {
  const box = { as: atoms() }
  const e = box.as[0]
  if e is i32 { print(e) } else { print(0) }
}

function nestedListElement() {
  const box = { gs: grids() }
  print(box.gs[0][0])
}

function mapElement() {
  const box = { ts: tables() }
  const e = box.ts[0]["k"]
  if e != null { print(e) } else { print(0.0) }
}

unionElement()
nullableElement()
scalarUnionElement()
nestedListElement()
mapElement()
