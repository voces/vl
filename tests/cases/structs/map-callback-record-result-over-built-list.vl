// @run
// @log null
// @log true
// @log true
// @log 2
// A `map` callback over a list a kept maker's build stores at a wider record is instanced at that
// build when its result holds no record the element could be, a lambda or a named function alike
// (D16773).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
print(dA.f)
const src = [mk2()]
const ns = src.map((y) => {
  return { g: y.f == null }
})
print(ns[0].g)
function mkg(y) { return { g: y.f == null } }
print(src.map(mkg)[0].g)
const ks = src.map((y) => {
  return { n: 2, s: [y.f == null] }
})
print(ks[0].n)
