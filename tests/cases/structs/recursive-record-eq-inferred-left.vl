// @run
// @log true
// @log false
// @log true
// @warning `==` on `{v: i32, kids: {v: i32, kids: _[]}[]}` compares every element of its list field `kids`
// @warning `==` on `N` compares every element of its list field `kids`
// @warning `==` on `{v: i32, kids: {v: i32, kids: _[]}[]}` compares every element of its list field `kids`
// `==` whose recursive record is only on the RIGHT, with an un-annotated literal on the left,
// at a binding and inside a function body (D5282).
type N = { v: i32, kids: N[] }
const same: N = { v: 1, kids: [{ v: 2, kids: [] }] }
const v = { v: 1, kids: [{ v: 2, kids: [] }] }
const w = { v: 1, kids: [] }
print(v == same)
print(w == same)
function check(q: N) {
  const u = { v: 1, kids: [{ v: 2, kids: [] }] }
  u == q
}
print(check(same))
