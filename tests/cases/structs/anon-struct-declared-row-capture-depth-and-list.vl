// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log hi
// @log 7
// @log 4
// @log 4
// @hint redundant type annotation: `h` is inferred as `{ys: ElemB[]}` — remove it to lean on inference
// CONTRACT (D1696, D1674): the capture preference is depth-GENERAL and reaches a ref-list
// element. A re-intern can drop a field the destination does not want and widen one it does;
// it cannot invent a field the source lacks, and it cannot renumber a box's positional tags.
// So the comparator asks only those two things, at every nesting level and through the
// list element, and the object-shape floor's accepting side stays lenient.
//
// The last two functions are the floors, at depth 1 and at depth 2: a literal DELIVERED to a
// declared row keeps the field-widening and field-dropping that row grants.
type U1 = i32 | boolean
type U2 = string | boolean
type Leaf1 = { xs: U1 }
type Leaf2 = { xs: U2 }
type Mid = { g: Leaf2 }
type Mid2 = { h: Mid }
type Deep = { f: Mid }
type Deeper = { f: Mid2 }
type Plain = { xs: i32 }
type Shallow = { f: Plain }
type ElemA = { p: U1 }
type ElemB = { p: U2 }
type ListH = { ys: ElemB[] }
type NulListH = { zs: ElemB[] | null }

function u1(): U1 { return 7 }
function as1(): ElemA[] { return [{ p: u1() }] }
function ns1(): ElemA[] | null { return [{ p: u1() }] }

// A box two nesting levels inside the captured row.
function boxAtDepthTwo() {
  const b = { f: { g: { xs: u1() } } }
  print(b.f.g.xs)
}

// Three levels, so the walk is not one-off.
function boxAtDepthThree() {
  const b = { f: { h: { g: { xs: u1() } } } }
  print(b.f.h.g.xs)
}

// A field the destination wants and the source lacks, one level down: no union anywhere.
function missingFieldOneDeeper() {
  const w = { f: { f: { xs: 7 } } }
  print(w.f.f.xs)
}

// The same through a ref-list ELEMENT (field code 5).
function refListElement() {
  const b = { ys: as1() }
  print(b.ys[0].p)
}

// And through the `| null` niche (field code 28).
function nullableRefListElement() {
  const b = { zs: ns1() }
  const l = b.zs
  if l != null { print(l[0].p) } else { print(0) }
}

// The declared list rows live as well, and still may not capture.
function listRowsLive() {
  const h: ListH = { ys: bs1() }
  print(h.ys[0].p)
  const b = { ys: as1() }
  print(b.ys[0].p)
}
function bs1(): ElemB[] { return [{ p: "hi" }] }

// The floor at depth 1: a re-intern that widens a field and drops one.
function reInternDepthOne() {
  const sv = { pet: { legs: 4, purr: true } }
  const u: { pet: { legs: i64 } } = sv
  print(u.pet.legs)
}

// The floor at depth 2, which a depth-general comparator must not take with it.
function reInternDepthTwo() {
  const sv = { pet: { paw: { legs: 4, purr: true } } }
  const u: { pet: { paw: { legs: i64 } } } = sv
  print(u.pet.paw.legs)
}

boxAtDepthTwo()
boxAtDepthThree()
missingFieldOneDeeper()
refListElement()
nullableRefListElement()
listRowsLive()
reInternDepthOne()
reInternDepthTwo()
