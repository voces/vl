// @run
// @log true
// @log false
// @log false
// @log true
// @log true
// A record whose field is a union compares with one whose field is a member as the bare
// compare does, in either order: the arm is tested, and another arm is unequal (D16399).
type A = { a: i32 }
type B = { a: i32, b: i32 }
const x: { f: A | B } = { f: { a: 1 } }
const w: { f: A | B } = { f: { a: 1, b: 2 } }
const y: { f: A } = { f: { a: 1 } }
print(x == y)
print(w == y)
print(y == w)
print(w != y)
const s: { f: i32 | string } = { f: 1 }
const t: { f: i32 } = { f: 1 }
print(s == t)
