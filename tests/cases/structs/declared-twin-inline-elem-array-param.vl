// @run
// @log 303.5
// @log NULL
// A DECLARED struct (`T0`) and the INLINE spelling of the same shape are twins, and the
// array param is annotated with the INLINE element spelling while the value is built as
// `T0[]`. The element's backing slot resolves through `shapeElemDeclaredStructIdx`, which
// asked the LENIENT fieldset scan (`structIndexOfTypeName`) for the inline element name:
// the nested nullable-struct field (`{f: f64} | null`, a code-16 whole-span row) made that
// scan decline, the `nameIsStructDecl` gate then saw -1, and the whole `T[]` param was a
// loud REJECT ("only i32[] arrays and struct/union element arrays are supported").
// Routing the element name through the canonical-key vocabulary (`repRowOfName` →
// `resolveAnnot(renderFaithful)` → `repRowOfTyStruct`) resolves the inline spelling onto
// its DECLARED twin's row by canon key, so the ref-list element is a struct after all.
type T0 = { f: { f: f64 } | null }

function useTwin(p: T0[]) {
  const t0 = p[0].f
  if (t0 != null) {
    print(t0.f)
  } else {
    print("NULL")
  }
}

function useInline(p: { f: { f: f64 } | null }[]) {
  const t0 = p[0].f
  if (t0 != null) {
    print(t0.f)
  } else {
    print("NULL")
  }
}

function go() {
  const w: { f: { f: f64 } | null }[] = [{ f: { f: 303.5 } }]
  useTwin(w)
  const n: T0[] = [{ f: null }]
  useInline(n)
}

go()
