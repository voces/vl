// @log true
// Record compares whose element side's index is each kind, on the left and on the right, with
// and without a call on the other side that writes the index source where it can: the element is
// read before the call when the call is on the right, after it when the call is on the left.
type P = { x: i32, y: i32 }
type K = { k: i32 }
type H = { k: i32, in: K }
const xs: P[] = [{ x: 1, y: 2 }, { x: 5, y: 5 }]
const p0: P = { x: 1, y: 2 }
let g = 0
const h: H = { k: 0, in: { k: 0 } }
function setG(v: i32, r: P) {
  g = v
  return r
}
function setH(v: i32, r: P) {
  h.k = v
  return r
}
function setIn(v: i32, r: P) {
  h.in.k = v
  return r
}
function same(r: P) { return r }
function global_L_plain() {
  g = 0
  return xs[g] == p0
}
function global_L_call() {
  g = 0
  return xs[g] == setG(1, p0)
}
function global_R_plain() {
  g = 0
  return p0 == xs[g]
}
function global_R_call() {
  g = 0
  return setG(1, p0) == xs[g]
}
function field_L_plain() {
  h.k = 0
  return xs[h.k] == p0
}
function field_L_call() {
  h.k = 0
  return xs[h.k] == setH(1, p0)
}
function field_R_plain() {
  h.k = 0
  return p0 == xs[h.k]
}
function field_R_call() {
  h.k = 0
  return setH(1, p0) == xs[h.k]
}
function fieldOfField_L_plain() {
  h.in.k = 0
  return xs[h.in.k] == p0
}
function fieldOfField_L_call() {
  h.in.k = 0
  return xs[h.in.k] == setIn(1, p0)
}
function fieldOfField_R_plain() {
  h.in.k = 0
  return p0 == xs[h.in.k]
}
function fieldOfField_R_call() {
  h.in.k = 0
  return setIn(1, p0) == xs[h.in.k]
}
function const_L_plain() { return xs[0] == p0 }
function const_L_call() { return xs[0] == same(p0) }
function const_R_plain() { return p0 == xs[0] }
function const_R_call() { return same(p0) == xs[0] }
function param_L_plain(j: i32) { return xs[j] == p0 }
function param_L_call(j: i32) { return xs[j] == same(p0) }
function param_R_plain(j: i32) { return p0 == xs[j] }
function param_R_call(j: i32) { return same(p0) == xs[j] }
function let_L_plain(j: i32) {
  let m = 0
  m = j
  return xs[m] == p0
}
function let_L_call(j: i32) {
  let m = 0
  m = j
  return xs[m] == same(p0)
}
function let_R_plain(j: i32) {
  let m = 0
  m = j
  return p0 == xs[m]
}
function let_R_call(j: i32) {
  let m = 0
  m = j
  return same(p0) == xs[m]
}
function expr_L_plain(j: i32) { return xs[j + 0] == p0 }
function expr_L_call(j: i32) { return xs[j + 0] == same(p0) }
function expr_R_plain(j: i32) { return p0 == xs[j + 0] }
function expr_R_call(j: i32) { return same(p0) == xs[j + 0] }
print(global_L_plain())
print(global_L_call())
print(global_R_plain())
print(global_R_call())
print(field_L_plain())
print(field_L_call())
print(field_R_plain())
print(field_R_call())
print(fieldOfField_L_plain())
print(fieldOfField_L_call())
print(fieldOfField_R_plain())
print(fieldOfField_R_call())
print(const_L_plain())
print(const_L_call())
print(const_R_plain())
print(const_R_call())
print(param_L_plain(0))
print(param_L_call(0))
print(param_R_plain(0))
print(param_R_call(0))
print(let_L_plain(0))
print(let_L_call(0))
print(let_R_plain(0))
print(let_R_call(0))
print(expr_L_plain(0))
print(expr_L_call(0))
print(expr_R_plain(0))
print(expr_R_call(0))
