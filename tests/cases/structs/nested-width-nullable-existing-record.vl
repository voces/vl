// @run
// @log 4
// @log 5
// @log true
// @log true
// An existing record whose nested record, nullable on both sides, carries a field the destination's
// does not name is taken at its own type (D16705): a write through a narrowed read reaches it, and
// a `null` written through the annotated name fits the real layout.
function mk(): { pet: { legs: i32, purr: boolean } | null } {
  return { pet: { legs: 4, purr: true } }
}
const sv = mk()
const u: { pet: { legs: i32 } | null } = sv
print(u.pet?.legs)
const p = u.pet
if p != null { p.legs = 5 }
print(sv.pet?.legs)
print(sv.pet?.purr)
u.pet = null
print(sv.pet == null)
