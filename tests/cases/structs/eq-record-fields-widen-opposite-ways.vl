// @log true
// @log true
// @log false
// @log true
// @log true
// `==` over two records of one field set whose field pairs widen in opposite directions compares
// field by field, nested and nullable records and parameters too (D16396).
const a: {x: i32, y: i64} = { x: 1, y: 2 }
const b: {x: f64, y: i32} = { x: 1.0, y: 2 }
print(a == b)
const c: {x: f64, y: i32} = { x: 1.5, y: 2 }
print(a == c)
print(a != c)
const n: {y: {z: i64}, x: i32} = { y: { z: 3 }, x: 1 }
const m: {y: {z: i32}, x: f64} = { y: { z: 3 }, x: 1.0 }
print(n == m)
const p: {x: i32, y: i64} | null = { x: 1, y: 2 }
const q: {x: f64, y: i32} | null = null
print(p == q)
const r: {x: f64, y: i32} | null = { x: 1.0, y: 2 }
print(p == r)
function f(u: {x: i32, y: i64}, w: {x: f64, y: i32}) { return u == w }
print(f({ x: 1, y: 2 }, { x: 1.0, y: 2 }))
