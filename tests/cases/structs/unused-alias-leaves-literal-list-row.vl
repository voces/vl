// @run
// @log 99
// @log 98
// An un-annotated record literal's list field keeps the literal's own element type when an
// unused alias declares the same field at a union element: a store through it shares the list.
// At module scope and in a function (D2215).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type H = { xs: Shape[] }
const cs: Circle[] = [{ r: 7 }]
const o = { xs: [{ r: 1 }] }
o.xs = cs
o.xs[0] = { r: 99 }
print(cs[0].r)
function local() {
  const ds: Circle[] = [{ r: 7 }]
  const p = { xs: [{ r: 1 }] }
  p.xs = ds
  p.xs[0] = { r: 98 }
  print(ds[0].r)
}
local()
