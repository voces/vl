// @check
// @error `{f: i32, g: i32}` and `{f: i32}` have different fields (`g`); compare the fields you mean
// @error `{f: i32} | null` and `{f: i32, h: string} | null` have different fields (`h`); compare the fields you mean
// Two records of different field sets are not compared at their shared fields, directly or as
// nullables (D16395).
const a: {f: i32, g: i32} = { f: 1, g: 2 }
const b: {f: i32} = a
print(a == b)
const p: {f: i32, h: string} | null = null
const q: {f: i32} | null = p
print(q != p)
