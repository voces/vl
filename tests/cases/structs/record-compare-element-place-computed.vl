// @log true
// @log false
// @log true
// @log true
// @log false
// @log 4
type P = { a: i32, b: string }
let calls = 0
function rows(): P[] {
  calls = calls + 1
  return [{ a: 1, b: "x" }, { a: 2, b: "y" }]
}
const grid: P[][] = [[{ a: 1, b: "x" }], [{ a: 2, b: "y" }, { a: 1, b: "x" }]]
function at(k: i32) { return k + 1 }
print(rows()[0] == grid[0][0])
print(grid[1][0] == grid[0][0])
print(grid[1][at(0)] == rows()[0])
print(grid[at(-1)][0] != rows()[1])
print(rows()[1] != grid[1][0])
print(calls)
