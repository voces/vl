// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log hi
// @log 7
// @log 4
// @hint redundant type annotation: `h` is inferred as `{ys: B[]}` — remove it to lean on inference
// CONTRACT (D1697): the capture comparator is CONTAINER-general as well as depth-general. A
// list-of-list element records the key `A[]`, which names no struct row, so the two keys are
// peeled and their elements asked instead; an element that resolves to neither a row nor a
// container — a closure, a map, a nullable ref — is compared as the two spellings it is.
//
// Both readers share it: `structIndexOfObjCtxGo` resolves a literal NODE and
// `structRowOfObjFieldSet` a recorded TYPE, and `arenaScanIdent` is the cell that goes
// through the second.
//
// `reInternWidening` is the floor — a literal DELIVERED to a declared row keeps the
// field-dropping and field-widening that row grants.
type U1 = i32 | boolean
type U2 = string | boolean
type A = { p: U1 }
type B = { p: U2 }
type Held1 = { ys: B[] }
type Held2 = { zs: B[][] }
type Held3 = { ws: B[][][] }
type HeldC = { cs: ((i32) => string)[] }
type HeldM = { ms: { [string]: string }[] }
type HeldN = { ns: (B | null)[] }
type HeldI = { js: B[][] }

function as1(): A[] { return [{ p: 7 }] }
function as2(): A[][] { return [[{ p: 7 }]] }
function as3(): A[][][] { return [[[{ p: 7 }]]] }
function cls(): ((i32) => i32)[] { return [(n: i32) => n] }
function mps(): { [string]: i32 }[] {
  const m: { [string]: i32 } = Map()
  m["k"] = 7
  return [m]
}
function nls(): (A | null)[] { return [{ p: 7 }] }

// One container: the arm #2714 closed, kept as the floor of the ladder.
function containerOne() {
  const b = { ys: as1() }
  print(b.ys[0].p)
}

// Two containers: the key `A[]` names no row, so the comparator peels.
function containerTwo() {
  const b = { zs: as2() }
  print(b.zs[0][0].p)
}

// Three, so the peel is not one-off.
function containerThree() {
  const b = { ws: as3() }
  print(b.ws[0][0][0].p)
}

// A CLOSURE element: neither a row nor a container, so the two spellings are compared.
function closureElement() {
  const b = { cs: cls() }
  print(b.cs[0](7))
}

// A MAP element, the same way.
function mapElement() {
  const b = { ms: mps() }
  print(b.ms[0]["k"] ?? 0)
}

// A NULLABLE-ref element, the same way.
function nullableElement() {
  const b = { ns: nls() }
  const e = b.ns[0]
  if e != null { print(e.p) } else { print(0) }
}

// The ARENA reader: the value reaches the row through an IDENT, so the element row comes from
// the field-set scan rather than from the literal.
function arenaScanIdent() {
  const inner = { js: as2() }
  const w = { f: inner }
  print(w.f.js[0][0].p)
}

// The declared row live as well, and still no capture.
function declaredRowLive() {
  const h: Held1 = { ys: bs1() }
  print(h.ys[0].p)
  const b = { ys: as1() }
  print(b.ys[0].p)
}
function bs1(): B[] { return [{ p: "hi" }] }

// The floor: a re-intern that widens a field and drops one.
function reInternWidening() {
  const sv = { pet: { legs: 4, purr: true } }
  const u: { pet: { legs: i64 } } = sv
  print(u.pet.legs)
}

containerOne()
containerTwo()
containerThree()
closureElement()
mapElement()
nullableElement()
arenaScanIdent()
declaredRowLive()
reInternWidening()
