// A record literal with no row of its own (`{ r: null }`) narrowed to its union arm, at each delivery
// position: binding, reassignment, record field, list element, map store, argument, return, and
// the same in a function.
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: i32 | null }
function take(x) { return x.r == null }
function give() { return { r: null } }
const c = { r: null }
print(c.r == null)
let d = { r: null }
d = { r: null }
print(d.r == null)
const o = { v: { r: null }, w: c }
print(o.v.r == null && o.w.r == null)
const l = [{ r: null }, c]
print(l[0].r == null && l[1].r == null)
const m = Map()
m["a"] = { r: null }
m["b"] = c
print(m.has("a") && m.has("b"))
print(take({ r: null }))
print(take(c))
print(give().r == null)
function inner() {
  const e = { r: null }
  const p = { v: e, u: { r: null } }
  const q = [e, { r: null }]
  print(e.r == null && p.v.r == null && p.u.r == null && q[1].r == null)
}
inner()
