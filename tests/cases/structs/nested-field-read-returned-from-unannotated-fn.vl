// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `o` is inferred as `{h: {r: i32}}` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `{h: {g: {r: i32}}}` — remove it to lean on inference
// @hint redundant type annotation: `gHolder` is inferred as `{h: {r: i32}}` — remove it to lean on inference
// GRADUATED from `silent-class-inventory` D131 — a NESTED-STRUCT FIELD READ returned from an
// UN-ANNOTATED function, when the receiver of that read is a LOCAL. `vl check` rc 0 with no
// error at all, and a module the engine refuses: `type mismatch: expected i32, found
// (ref null $type)`.
//
// THE RECEIVER'S STORAGE CLASS IS THE WHOLE AXIS, and the four one-line controls the row was
// filed with say so from four sides: `return o.h.r` (an i32 leaf) RUNS, the identical read at
// MODULE scope RUNS, a NOMINALLY-spelled field reproduces it exactly, and it fires with NO
// declared claimant for the layout anywhere in the program. What the row's controls did not
// separate — and a grid did — is that a PARAM, a module GLOBAL and a CALL result as the
// receiver all RUN on master. `exprNullableStruct`'s Member arm already classifies a code-15
// field read as the `(ref null $S)` it physically is; it resolves the receiver through
// `structIndexOfExpr`, whose Ident arm reads `declaredStructIndex` — a per-function table
// `buildLocals` fills long AFTER the GLOBAL return pass this classification runs in. So for a
// LOCAL receiver the slot kept its `"i32"` default while the body pushed the field's ref.
//
// DISASSEMBLED RATHER THAN INFERRED. On master `mk` is `(func (param i32) (result i32))` over
// a body whose last two instructions are `struct.get 1 0` / `return`, and `Holder`'s row is
// `(struct (field (mut (ref null 0))))` — the code-15 slot IS nullable. With the fix the
// functype is `(result (ref null 0))`, the BODY is byte-identical, and the CALLER grew the
// `ref.as_non_null` its field read already knows how to emit. The classifier now names the rep
// the body was producing all along.
//
// `"nulstruct"` AND NOT `"struct"` is the same answer the three receiver shapes that already
// worked produce: the lowering codes fold `inner: S` and `inner: S | null` onto ONE code-15
// hop, so the slot is `(ref null $S)` either way.
//
// MEASURED on a 1,732-cell grid (`scripts/silent-sweep/d131/`) whose axes are read depth x
// executing body x return annotation x field type x RECEIVER STORAGE CLASS x claimant count x
// declaration order: this rung moves 120 cells, every one to `runs`, and every one is
// `ann=none` x `recv in {local, hop}` — `param` and `global` are absent from the moved set
// because they already ran, which is the axis measured rather than asserted. The `leaf`
// (`o.h.r`) and `mod` (module-scope) rows move ZERO, which is those two controls still
// holding.
type Holder = { h: { r: i32 } }

// THE FILED WITNESS, verbatim.
function mk(n: i32) {
  const o: Holder = { h: { r: n } }
  return o.h
}

// THE LOCAL HOP — the row's own third control. `const c = o.h` then `return c` was the SAME
// reject, so the hop is not the axis; but it needs its own rung, because the returned-local
// block asks `letIsStruct`, which answers TRUE through `exprStruct`'s fall-through and minted
// `(ref $S)` over the `(ref null $S)` cell `collectLocals` built from the SAME predicate.
function mkHop(n: i32) {
  const o: Holder = { h: { r: n } }
  const c = o.h
  return c
}

// TWO NESTED HOPS — the descent is `structIndexOfExpr`'s own Member arm, so `o.h.g` resolves
// by the rule its one-level parent does.
type Mid = { g: { r: i32 } }
type Deep = { h: Mid }

function mkDeep(n: i32) {
  const o: Deep = { h: { g: { r: n } } }
  return o.h.g
}

// A NOMINALLY-spelled field, which is the row's FIRST control: it reproduces the defect
// exactly, so this is not the inline shape.
type Circle = { r: i32 }
type HolderN = { h: Circle }

function mkNominal(n: i32) {
  const o: HolderN = { h: { r: n } }
  return o.h
}

// THE SCALAR LEAF, which RUNS on master — an i32 leaf matches the `"i32"` default the
// classifier fell through to. Here so a future change that moves it is visible.
function mkLeaf(n: i32) {
  const o: Holder = { h: { r: n } }
  return o.h.r
}

// A LAMBDA and a NESTED function body, the two other executing bodies the grid carries.
const mkLam = (n: i32) => {
  const o: Holder = { h: { r: n } }
  return o.h
}

function mkOuter(n: i32) {
  function mkInner(m: i32) {
    const o: Holder = { h: { r: m } }
    return o.h
  }
  return mkInner(n)
}

// The receiver shapes that ALREADY ran, pinned beside the ones that did not — the negative
// controls for the rung's `fRetKind == "i32"` hole-filler gate.
function mkParam(o: HolderN) {
  return o.h
}

const gHolder: HolderN = { h: { r: 7 } }

function mkGlobal() {
  return gHolder.h
}

print(mk(7).r)
print(mkHop(7).r)
print(mkDeep(7).r)
print(mkNominal(7).r)
print(mkLeaf(7))
print(mkLam(7).r)
print(mkOuter(7).r)
print(mkParam({ h: { r: 7 } }).r)
print(mkGlobal().r)

// TWO declared claimants for the layout, because the row fires at NONE — the twin axis is
// here to keep saying it is not the axis.
type Dot = { r: i32 }
