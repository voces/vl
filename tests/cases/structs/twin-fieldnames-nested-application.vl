// @run
// @log 7
// @log q
// @log 1
// @hint redundant type annotation: `sb` is inferred as `{v: {v: string}}`
// @hint redundant type annotation: `xs` is inferred as `{v: {v: i32}}[]`
// TWO shapes sharing a field-NAME set and differing in a field's TYPE (`{v: {v: i32}}` from the
// generic application, `{v: {v: string}}` declared beside it), in a program that REACHES
// `structIndexOfTypeName`'s field-set rung.
//
// The witness for `tyHasStructRowShallow`, which matches a struct row by field NAMES and ignores
// the field types. That is sound only because it decides the CODE (15 = a nested struct) and
// never WHICH row, so both shapes code 15 either way. This pins the case that would expose the
// difference if that ever stopped being true — and it was verified to reach the consumer before
// its agreement was trusted, since agreement at an unreached site measures nothing.
type Box<T> = { v: T }
type StrBox = { v: string }
type StrBoxBox = { v: StrBox }
const nn: Box<Box<i32>> | null = { v: { v: 7 } }
if nn != null { print(nn.v.v) }
const sb: StrBoxBox = { v: { v: "q" } }
print(sb.v.v)
const xs: Box<Box<i32>>[] = [{ v: { v: 1 } }, { v: { v: 2 } }]
print(xs[0].v.v)
