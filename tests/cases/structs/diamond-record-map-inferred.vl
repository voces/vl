// @run
// @log 5
// @log 7
// @log 5

// An un-annotated `Map()` holding a record whose every level holds the one below twice, at
// depths 4 and 12: its value slot is keyed by the record's declared name, not a spelling
// that doubles per level (D9936). The annotated map is the control.

type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
type A11 = {l: A10, r: A10}
type A12 = {l: A11, r: A11}

const a0: A0 = { x: 5 }
const a1: A1 = { l: a0, r: a0 }
const a2: A2 = { l: a1, r: a1 }
const a3: A3 = { l: a2, r: a2 }
const a4: A4 = { l: a3, r: a3 }
const a5: A5 = { l: a4, r: a4 }
const a6: A6 = { l: a5, r: a5 }
const a7: A7 = { l: a6, r: a6 }
const a8: A8 = { l: a7, r: a7 }
const a9: A9 = { l: a8, r: a8 }
const a10: A10 = { l: a9, r: a9 }
const a11: A11 = { l: a10, r: a10 }
const a12: A12 = { l: a11, r: a11 }

const m = Map()
m["k"] = a12
const v = m["k"]
if v != null { print(v.l.r.l.r.l.r.l.r.l.r.l.r.x) }

const m4 = Map()
m4["k"] = { l: a3, r: { l: a2, r: { l: a1, r: { l: a0, r: { x: 7 } } } } }
const w = m4["k"]
if w != null { print(w.r.r.r.r.x) }

const ma: {[string]: A12} = Map()
ma["k"] = a12
const u = ma["k"]
if u != null { print(u.r.r.r.r.r.r.r.r.r.r.r.r.x) }
