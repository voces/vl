// `==` over records that recurse through a nullable field, directly, mutually and two-way, compares
// field by field through a compare helper that calls itself (D15636).
type Node = { v: i32, next: Node | null }
type M = Node & { v: i32 }
type A = { s: string, b: B | null }
type B = { n: i32, a: A | null }
type T = { name: string, l: T | null, r: T | null }
function eqP(a: Node, b: Node) { a == b }
function neP(a: Node, b: Node) { a != b }
const a: Node = { v: 1, next: { v: 2, next: null } }
const b: Node = { v: 1, next: { v: 2, next: null } }
const c: Node = { v: 1, next: { v: 3, next: null } }
const d: Node = { v: 1, next: null }
print(a == a)
print(a == b)
print(a == c)
print(a == d)
print(d == a)
print(a != c)
print(a != b)
print(eqP(a, b))
print(eqP(a, c))
print(neP(a, c))
const m1: M = { v: 4, next: null }
const m2: M = { v: 4, next: null }
print(m1 == m2)
const x: A = { s: "x", b: { n: 1, a: { s: "y", b: null } } }
const y: A = { s: "x", b: { n: 1, a: { s: "y", b: null } } }
const z: A = { s: "x", b: { n: 1, a: { s: "w", b: null } } }
print(x == y)
print(x == z)
const t1: T = { name: "r", l: { name: "a", l: null, r: null }, r: null }
const t2: T = { name: "r", l: { name: "a", l: null, r: null }, r: null }
const t3: T = { name: "r", l: null, r: { name: "a", l: null, r: null } }
print(t1 == t2)
print(t1 == t3)
let p: Node = { v: 0, next: null }
let q: Node = { v: 0, next: null }
let i = 1
while i < 5000 {
  p = { v: i, next: p }
  q = { v: i, next: q }
  i = i + 1
}
print(p == q)
