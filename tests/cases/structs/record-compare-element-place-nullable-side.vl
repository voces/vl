// A nullable record compared with an element side whose receiver is a place, in both orders:
// it stays `nullable record eq element place` and prints as legacy does.
type R = { a: i32, b: i32 }
const xs: R[] = [{ a: 1, b: 2 }, { a: 3, b: 4 }]
function left(p: R | null, i: i32) { return p == xs[i] }
function right(p: R | null, i: i32) { return xs[i] != p }
function leftImm(p: R | null) { return p == xs[0] }
function rightImm(p: R | null) { return xs[1] == p }
function local(p: R | null, ys: R[]) { return p == ys[0] }
const q: R | null = { a: 1, b: 2 }
print(left(q, 0))
print(left(null, 0))
print(left(q, 1))
print(right(q, 0))
print(right(null, 1))
print(leftImm(q))
print(rightImm({ a: 3, b: 4 }))
print(rightImm(null))
print(local(q, [{ a: 1, b: 2 }]))
print(q == xs[0])
print(xs[1] == q)
