// @run
// @log true
// @log false
// @log false
// @log false
// @log true
// @log true
// @log false
// @log false
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// @hint redundant type annotation: `f` is inferred as `(i32) => i32` — remove it to lean on inference
// @hint redundant type annotation: `g` is inferred as `(i32) => i32` — remove it to lean on inference
// Regression (silent-class-inventory D1290, D1291, D1292).
//
// D1180 ruled that `T | null` is comparable exactly when `T` is. These are the three field
// reps that rule admits and the emitter could not serve, and they are three DIFFERENT rungs
// — the union BOX had no compare core at all, the `S[] | null` niche let the guard's
// non-null recover follow its core into the nested element compare, and the `fn | null`
// niche reached an identity core whose frame the reservation scan keys by the NON-NULL code.
//
// BOTH DIRECTIONS AND BOTH NULL POSITIONS at every rep: an equality answering `true` for
// everything passes a same-only table, and a guard testing only the LEFT side passes a table
// with no `null == value` row.
//
// THE CLOSURE ANNOTATIONS ARE DECLARED-REDUNDANT, NOT REMOVED: `Fn1` is the type the
// `Fn1 | null` field is declared against, and naming it is what makes the pairing readable.
type Bi = { d: i32 | null }
type Bf = { d: f64 | null }
type Inner = { p: i32 }
type Rl = { d: Inner[] | null }
type Fn1 = (i32) => i32
type Fc = { d: Fn1 | null }

// A value-union BOX field: three distinguishable values, and the null is a TAG in the box
const bi1: Bi = { d: 3 }
const bi2: Bi = { d: 3 }
const bi3: Bi = { d: 4 }
const bin: Bi = { d: null }
const bim: Bi = { d: null }
print(bi1 == bi2)
print(bi1 == bi3)
print(bi1 == bin)
print(bin == bi1)
print(bin == bim)

// the same box at f64, whose payload compare is a different opcode
const bf1: Bf = { d: 1.5 }
const bf2: Bf = { d: 1.5 }
const bf3: Bf = { d: 2.5 }
const bfn: Bf = { d: null }
print(bf1 == bf2)
print(bf1 == bf3)
print(bf1 == bfn)

// A REF-LIST niche field — the element compare is what the leaked recover corrupted, so the
// unequal pair differs in the ELEMENT, not in the wrapper
const rl1: Rl = { d: [{ p: 5 }] }
const rl2: Rl = { d: [{ p: 5 }] }
const rl3: Rl = { d: [{ p: 6 }] }
const rln: Rl = { d: null }
const rlm: Rl = { d: null }
print(rl1 == rl2)
print(rl1 == rl3)
print(rl1 == rln)
print(rln == rlm)

// A CLOSURE niche field: identity (the lifted function AND its env), never structural
const f: Fn1 = (n: i32) => n
const g: Fn1 = (n: i32) => n + 1
const fc1: Fc = { d: f }
const fc2: Fc = { d: f }
const fc3: Fc = { d: g }
const fcn: Fc = { d: null }
const fcm: Fc = { d: null }
print(fc1 == fc2)
print(fc1 == fc3)
print(fc1 == fcn)
print(fcn == fcm)

// `f == g` at the DIRECT spelling still runs — the frame the niche field now shares
print(f == f)
print(f == g)

// `!=` negates, and a plain field alongside the niche still participates
type Pair = { d: i32 | null, n: i32 }
const p1: Pair = { d: null, n: 7 }
const p2: Pair = { d: null, n: 7 }
const p3: Pair = { d: null, n: 8 }
print(p1 == p2)
print(p1 != p3)
