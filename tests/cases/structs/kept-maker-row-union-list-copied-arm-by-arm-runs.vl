// @log 3
// @log 43
// @log x
// @log 2.5
// @log 1
// @log 2
// @log 5
// @log 5
// A fresh call's list of a union of records copied where it lands: each element's tag picks
// the arm, copied at its own row into the destination record, a field widened on the way.
type A = { a: i32 }
type B = { b: string }
type C = { c: f64 }
type Row = { r: A | B | C, n: i64 }
function rows() {
  [{ r: { a: 1 }, n: 1 }, { r: { b: "x" }, n: 2 }, { r: { c: 2.5 }, n: 3 }]
}
const own = rows()
print(own.length)
const w: Row[] = rows()
w[0].n = 40
print(w[0].n + w[2].n)
const r1 = w[1].r
if r1 is B { print(r1.b) }
const r2 = w[2].r
if r2 is C { print(r2.c) }
print(own[0].n)
type Ci = { c: i32 }
type Sqq = { s: i32 }
type Shp = { r: Ci | Sqq }
type Bx = { xs: Shp[] }
function mkb() { { xs: [{ r: { c: 1 } }, { r: { s: 5 } }] } }
const aa = mkb()
print(aa.xs.length)
const bb: Bx = mkb()
bb.xs.push({ r: { c: 9 } })
const zz = bb.xs[1].r
if zz is Sqq { print(zz.s) }
print(bb.xs.length + aa.xs.length)
