// @run
// @log true
// @log 1
// @log true
// @log 1
// The same as the top-level order cells, over a list parameter.
type P = { x: i32, y: i32 }
let i = 0
function moveTo(k: i32, g: P | null) {
  i = k
  return g
}
function a(gs: (P | null)[]) {
  i = 0
  return gs[i] == moveTo(1, gs[0])
}
function b(gs: (P | null)[]) {
  i = 0
  return moveTo(1, gs[1]) == gs[i]
}
const gs: (P | null)[] = [{ x: 1, y: 2 }, { x: 1, y: 2 }]
print(a(gs))
print(i)
print(b(gs))
print(i)
