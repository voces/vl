// @run
// @log 11
// @log 11
// @log 11
// @log 11
// @log 11
// @log 11
// @log 2
// @log true
// @hint redundant type annotation: `b` is inferred as `{v: i32, f: () => i32}` — remove it to lean on inference
// A record whose field names a declared record shares is not that record when a function
// field's signature differs: each read calls its own closure at its own type (D3180).
type R = { v: i32, f: () => boolean }
const named: R = { v: 1, f: () => true }
const lit = { v: 2, f: () => 11 }
const m: {[string]: { v: i32, f: () => i32 }} = Map()
m.set("a", lit)
const q = m.get("a")
if q != null { print(q.f()) }
const b: { v: i32, f: () => i32 } = lit
print(b.f())
const xs = [{ v: 2, f: () => 11 }]
print(xs[0].f())
function g(p: { v: i32, f: () => i32 }) { print(p.f()) }
g({ v: 2, f: () => 11 })
function h(): { v: i32, f: () => i32 } { return { v: 2, f: () => 11 } }
print(h().f())
function F<Z>(z: Z) {
  const mz: {[string]: Z} = Map()
  mz.set("a", z)
  const qz = mz.get("a")
  if qz != null { print(qz.f()) }
  print(z.v)
}
F({ v: 2, f: () => 11 })
print(named.f())
