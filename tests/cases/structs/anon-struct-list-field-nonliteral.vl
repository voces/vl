// @run
// @log 1
// @log 3
// @log 2
// @log ada
// CONTRACT (D1515): an anonymous struct literal whose field holds a LIST OF STRUCTS produced
// by anything but an array literal of object literals — a call result, a list bound first and
// handed on by name.
//
// D1443 built the code-5 (struct-ref list) field pair for the LITERAL spelling, where each
// element carries its own row by the time the field is coded. Every other producer has no
// element NODE to read a row off, so the coder answered -1, the OWNER literal got no row, and
// the refusal was a sentence about its own field count. The type was never missing: the
// checker recorded the element type on the field value, and that names the same row.
//
// NOTHING HERE MAY DECLARE THE OUTER SHAPE. An unused `type Holder = { it: Rec[] }` is the
// rescue both rows record, and it would make every cell pass for the wrong reason. `Rec` IS
// declared: the element being nominal is not the ingredient, and the call needs a return
// annotation to write at all.
//
// The reads go THROUGH the element, so a row whose element heap type came from the wrong
// shape traps or prints the wrong value rather than passing.
type Rec = { name: string, n: i32 }

function rows(): Rec[] { return [{ name: "ada", n: 3 }] }

function fromCall() {
  const box = { it: rows() }
  print(box.it.length)
  print(box.it[0].n)
}

function fromBinding() {
  const held = [{ name: "ada", n: 3 }, { name: "bo", n: 4 }]
  const box = { it: held }
  print(box.it.length)
  print(box.it[0].name)
}

fromCall()
fromBinding()
