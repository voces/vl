// @run
// @log false
// @log 3
// @log false
// @log 3
// @log y
// @log false
// @log 3
// D2866: annotated records whose one field is `boolean`, `i32` or a literal set each resolve
// their own row, so an un-annotated reader instantiated at each builds and prints each in its
// own format; a literal-set field used only in a record annotation still prints its member.
type K = "x" | "y"
function R(o) { print(o.f) }
const a: { f: boolean } = { f: false }
const b: { f: i32 } = { f: 3 }
print(a.f)
print(b.f)
R(a)
R(b)
const c: { f: K } = { f: "y" }
R(c)
function L(o) {
  const t = o.f
  print(t)
}
L(a)
L(b)
