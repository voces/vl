// @run
// @log 1
// @log 7
// @log s
// @log 7
// @log 7
// @log 1
// @log 7
// @log 3
// @log 1
// @log 7
// A record literal holding a generic function, handed to a parameter of a narrower declared
// record, runs as the same record holding a concrete function does: the generic field is closed,
// so the pair is compared as two shapes (D6422). Also with a third field inside a function,
// forwarded through a second declared parameter, and with the field a maker's result. A field
// called at `string` goes to a parameter of its own: one parameter given both is D6471.
type G = { g: i32 }
function k<T>(x: T): T { return x }
function k2<T>(x: T): T { return x }
function k3<T>(x: T): T { return x }
function k4<T>(x: T): T { return x }
function show(o: G) { print(o.g) }
function showS(o: G) { print(o.g) }
const r = { f: k, g: 7 }
print(r.f(1))
show(r)
function main() {
  const r2 = { f: k2, g: 7, h: 2 }
  print(r2.f("s"))
  showS(r2)
  showS(r2)
}
main()
function fwd(o: G) { show(o) }
const r3 = { f: k3, g: 7 }
print(r3.f(1))
fwd(r3)
show({ g: 3 })
function mk() { return k4 }
const r4 = { f: mk(), g: 7 }
print(r4.f(1))
show(r4)
