// @run
// @log 7
// @log 9
// @log 3
// @log 4
// @log 5
// @log 6
// @hint redundant type annotation: `cA` is inferred as `{r: i32}`
// @hint redundant type annotation: `xsA` is inferred as `Circle[]`
// @hint redundant type annotation: `cB` is inferred as `{r: i32}`
// @hint redundant type annotation: `xsB` is inferred as `Dot[]`
// @hint redundant type annotation: `cP` is inferred as `{p: i32}`
// @hint redundant type annotation: `xsP` is inferred as `Pt[]`
// @hint redundant type annotation: `cQ` is inferred as `{p: i32}`
// @hint redundant type annotation: `xsQ` is inferred as `Q[]`
// @hint redundant type annotation: `cD` is inferred as `{rad: i32}`
// @hint redundant type annotation: `xsD` is inferred as `Disc[]`
// @hint redundant type annotation: `cT` is inferred as `{rad: i32}`
// @hint redundant type annotation: `xsT` is inferred as `Trg[]`
// D94. AN UN-ANNOTATED STRUCT LITERAL PICKS THE ROW ITS FIELD ELEMENT'S DECLARATION NAMES.
//
// `Circle` is an arm of `Shape`, `Dot` is a standalone struct with the identical field set,
// and `BoxA`/`BoxB` are two declared rows whose only difference is the ARM-NESS of their
// field element. Annotate either binding and the program runs — the `inline`, `alias` and
// `direct` spellings of this coordinate are all correct on master. Only the UN-ANNOTATED
// literal fails, which is what says the layer is the literal's ROW PICK.
//
// IT IS NOT D64. `structFieldCodesEq`'s referenced-layer guard (#1952) already declines to
// merge the two rows: their code-5 field elements are `Circle` and `Dot`, `Circle` has no
// struct row at all (`collectS` SKIPS a `type X = {…}` that is a union member), and the
// `ra < 0 || rb < 0` leg refuses. The two rows stay apart. What collapses is one rung
// earlier: `structIndexOfObjCtx` matches the literal's field-NAME set `{xs}` and BOTH rows
// answer, so the ambiguity arm runs — `repRowOfTyStruct` correctly DECLINES (the two rows'
// layouts diverge, which is D64's guard doing its job), and `structRowOfObjFieldSet` then
// first-matches. That scan tightens per-field on the CODE, and both fields are code 5.
//
// THE CHANNEL IS ON THE ARENA AT THE NODE THAT RUNG ALREADY HOLDS. The literal's element
// binding is annotated (`xsA: Circle[]`), so the field's element type resolves to a
// DECLARATION — through `structIndexOfTy` for a struct and `variantRowOfTy` for an arm, the
// two rungs `shapeNominalOfTy` pairs and D33 is the row for pairing them. The row side has
// the same fact in `sFieldElemTyIx` / `sFieldElemName`.
//
// NOMINAL, NOT CANONICAL, and that distinction is the whole fix. The code-15 tightening
// beside this one compares `repCanonId`s, which is right for ITS question — two inline
// nested shapes differ iff their structures differ. The pair here is `Circle` beside its
// exact layout twin: ONE canon key, TWO declarations.
//
// A PREFERENCE, NOT A REFUTATION. A conflicting row stays a match and is merely outranked,
// so the scan can never return -1 where it returned a row (a -1 here sends the caller to
// the historic first-match GUESS, which is strictly worse than the conflicting row it just
// declined). With no conflict anywhere the answer is byte-identical.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

type BoxA = { xs: Circle[] }
type BoxB = { xs: Dot[] }

function reader() {
  const cA: Circle = { r: 7 }
  const xsA: Circle[] = [cA]
  const bA = { xs: xsA }
  print(bA.xs[0].r)
  const cB: Dot = { r: 9 }
  const xsB: Dot[] = [cB]
  const bB = { xs: xsB }
  print(bB.xs[0].r)
}

reader()

// THE TWIN DECLARED FIRST — the same pair, the other order. Both orders are silent on
// master at the same offset and message.
type Pt = { p: i32 }
type Tri = { t3: i32 }
type Poly = Pt | Tri
type Q = { p: i32 }

type BoxQ = { ys: Q[] }
type BoxP = { ys: Pt[] }

function readerB() {
  const cQ: Q = { p: 3 }
  const xsQ: Q[] = [cQ]
  const bQ = { ys: xsQ }
  print(bQ.ys[0].p)
  const cP: Pt = { p: 4 }
  const xsP: Pt[] = [cP]
  const bP = { ys: xsP }
  print(bP.ys[0].p)
}

readerB()

// THE CONTROL THE PREFERENCE MUST NOT MOVE: two arms of two DIFFERENT unions over one field
// set. They are `uVarTwin` layout twins and therefore ONE variant heap, so their rows may
// share a struct — and their element DECLARATIONS are still distinct, so the preference
// picks each literal's own row rather than merging them. It runs either way; it is here so
// that a future tightening of this rung into a REFUTATION is caught by a fixture rather
// than by a grid.
type Disc = { rad: i32 }
type Bar = { bw: i32 }
type Round = Disc | Bar
type Trg = { rad: i32 }
type Wedge = { ww: i32 }
type Angular = Trg | Wedge

type BoxD = { zs: Disc[] }
type BoxT = { zs: Trg[] }

function readerC() {
  const cD: Disc = { rad: 5 }
  const xsD: Disc[] = [cD]
  const bD = { zs: xsD }
  print(bD.zs[0].rad)
  const cT: Trg = { rad: 6 }
  const xsT: Trg[] = [cT]
  const bT = { zs: xsT }
  print(bT.zs[0].rad)
}

readerC()
