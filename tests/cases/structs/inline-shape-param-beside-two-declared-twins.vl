// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// GRADUATED from `silent-class-inventory` D100 — an INLINE-SHAPE parameter in a program that
// declares **TWO** structs of that layout. It is D53's own residue, the sixth `decl` level of
// that close's grid (`plaintwin`), and it was `vl check` rc 0 with
// `emitProgram: ref valtype with no interned shape`.
//
// THE ROW WAS FILED AS D39's CHANNEL CASE AND THE MEASUREMENT REFUTES IT. That filing reads:
// "`Circle` and `Dot` are two equally valid readings of `{r:i32}` and nothing at a resolver's
// position can separate them" — so it wanted a sidecar recording which row `annShapeIndexOf`
// picked. The row also NAMED the measurement that would settle it and did not take it: does
// `sTwin` already merge the two onto ONE heap type? Probed at `repSlotOfTy`'s declining rung
// on the filed witness:
//
//   N=2 rows=Circle(0/rep0) Dot(1/rep0)[twin0=1]
//
// Both rows carry `repStructSlotRep` 0 and `repStructSlotsTwin(0,1)` is 1. THE TWO CLAIMANTS
// ARE ONE WasmGC HEAP TYPE, so there is no answer to choose between and no channel to carry
// it — what declined was a uniqueness test STRONGER than soundness needs. `repSlotOfTy`'s
// bridge asked for a unique ROW (`repSlotKeyN[key] == 1`); the question it needs answered is
// a unique HEAP TYPE, and `repStructSlotsTwin` — the shipped `sTwin` equivalence, and the
// CONJUNCTION the row itself named rather than `structFieldCodesEq` alone — was already
// written, exported, and documented "queryable PAIRWISE".
//
// GENUINE AMBIGUITY STILL DECLINES, which is the arm this keeps rather than removes: two rows
// sharing a canonical key but NOT a layout — the atom-vs-plain collision `repRowOfTyStruct`
// refuses to guess through — fail the guard and the bridge answers -1 exactly as before.
//
// THE ROWS ARE D53's DELIVERY CHAIN, kept identical so the two fixtures are comparable: the
// parameter read directly, through one alias hop, as a member access, and out of an
// un-annotated / inline-annotated / nominally-annotated result.
type Circle = { r: i32 }
type Dot = { r: i32 }

// THE FILED WITNESS, verbatim.
function mk(c: { r: i32 }) {
  const o = c
  return o
}

// No local: the parameter is the returned value.
function mkDirect(c: { r: i32 }) { return c }

// The MEMBER READ — the other resolver D53's fixture separates.
function mkRead(c: { r: i32 }) {
  const o = c
  return o.r
}

// The result annotated with the INLINE shape.
function mkRetAnnInline(c: { r: i32 }): { r: i32 } {
  const o = c
  return o
}

// The result annotated with ONE of the two declared names, over an inline-shape parameter —
// the spelling that makes the "two claimants" reading concrete, and it lowers to the same
// heap type as the other.
function mkRetAnnNamed(c: { r: i32 }): Dot {
  const o = c
  return o
}

// The control the row names: the parameter spelled NOMINALLY. It ran before and runs now.
function mkNominal(c: Circle) {
  const o = c
  return o
}

print(mk({ r: 7 }).r)
print(mkDirect({ r: 7 }).r)
print(mkRead({ r: 7 }))
print(mkRetAnnInline({ r: 7 }).r)
print(mkRetAnnNamed({ r: 7 }).r)
print(mkNominal({ r: 7 }).r)
