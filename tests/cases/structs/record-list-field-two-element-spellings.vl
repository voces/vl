// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `d` is inferred as `{f: (() => {x: i32, y: i32})[]}`
// @hint redundant type annotation: `w` is inferred as `{f: (() => Circle | Sq)[]}`
// A record whose list field's element is spelled two ways is delivered between the spellings at
// a binding, an argument and a return, for a record result and a union result (D3393).
type P = { x: i32, y: i32 }
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function F(): { x: i32, y: i32 } { return { x: 1, y: 7 } }
function G(): Circle | Sq { return { r: 7 } }
function r(v: Shape) {
  if v is Circle { return v.r }
  0
}

const s: { f: (() => { x: i32, y: i32 })[] } = { f: [F] }
const d: { f: (() => P)[] } = s
print(d.f[0]().y)
function useP(e: { f: (() => P)[] }) { e.f[0]().y }
print(useP(s))
function getP(): { f: (() => P)[] } { s }
print(getP().f[0]().y)

const u: { f: (() => Circle | Sq)[] } = { f: [G] }
const w: { f: (() => Shape)[] } = u
print(r(w.f[0]()))
function useS(e: { f: (() => Shape)[] }) { r(e.f[0]()) }
print(useS(u))
function getS(): { f: (() => Shape)[] } { u }
print(r(getS().f[0]()))
