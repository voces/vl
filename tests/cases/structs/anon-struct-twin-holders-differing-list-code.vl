// @run
// @log 7
// @log hi
// @log 7
// @log 9
// @log 7
// @log 1.5
// @log hi
// @log 9
// @log hi
// @log ho
// @log 7
// @log hi
// @hint redundant type annotation: `ss1` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `is1` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `two` is inferred as `{us: string[]}` — remove it to lean on inference
// CONTRACT (D1704): two anonymous holders sharing a field NAME whose list fields have
// DIFFERENT codes are two rows — no nullability, no narrowing and no pin, which is what
// separates this from D1663's code-5-beside-28 pair. `anonValueFitsField`'s composite tail
// now REFUSES by default and each arm names the one widening its value makes, so a code with
// no arm cannot take another code's row.
//
// The last pair is the declared-row face of the same gap: a string-list slot and a
// struct-ref-list slot are one wasm layout apart with no adoption between them.
//
// NOTHING HERE MAY DECLARE THE OUTER SHAPE except where the contract says so — an unused
// `type Holder = { xs: A[] }` is the rescue, and it would make every read pass for the wrong
// reason. Each read goes THROUGH the field and prints a value only the right row can produce.
type A = { r: i32 }

function as1(): A[] { return [{ r: 7 }] }
function ss1(): string[] { return ["hi"] }
function is1(): i32[] { return [9] }
function fs1(): f64[] { return [1.5] }

// The filed pair: a struct-ref list (code 5) beside a STRING list (code 6).
function structBesideString() {
  const one = { xs: as1() }
  print(one.xs[0].r)
  const two = { xs: ss1() }
  print(two.xs[0])
}

// The scalar-list siblings, which the tail's own arms already refuted.
function structBesideI32() {
  const one = { ys: as1() }
  print(one.ys[0].r)
  const two = { ys: is1() }
  print(two.ys[0])
}

function structBesideF64() {
  const one = { zs: as1() }
  print(one.zs[0].r)
  const two = { zs: fs1() }
  print(two.zs[0])
}

// Two scalar-backed lists of different backings, neither naming a heap.
function stringBesideI32() {
  const one = { ws: ss1() }
  print(one.ws[0])
  const two = { ws: is1() }
  print(two.ws[0])
}

// A list beside a plain scalar of the same backing.
function stringListBesideString() {
  const one = { vs: ss1() }
  print(one.vs[0])
  const two = { vs: "ho" }
  print(two.vs)
}

// The DECLARED-row face: the string-list row is declared and the struct-list holder is not.
function declaredStringListRow() {
  const one = { us: as1() }
  print(one.us[0].r)
  const two: { us: string[] } = { us: ss1() }
  print(two.us[0])
}

structBesideString()
structBesideI32()
structBesideF64()
stringBesideI32()
stringListBesideString()
declaredStringListRow()
