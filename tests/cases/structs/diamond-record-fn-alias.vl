// @run
// @log 3
// @log 3
// @log 4

// A function type alias over a fourteen-level record whose every level holds the one below
// twice, as a record field and as a list element (`FF[]`), called through each (D9891).

type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
type A11 = {l: A10, r: A10}
type A12 = {l: A11, r: A11}
type A13 = {l: A12, r: A12}
type A14 = {l: A13, r: A13}
type FF = (x: i32) => A14
type GG = (a: A14) => i32
type R = {f: FF, g: GG}

const a0: A0 = { x: 0 }
const a1: A1 = { l: a0, r: a0 }
const a2: A2 = { l: a1, r: a1 }
const a3: A3 = { l: a2, r: a2 }
const a4: A4 = { l: a3, r: a3 }
const a5: A5 = { l: a4, r: a4 }
const a6: A6 = { l: a5, r: a5 }
const a7: A7 = { l: a6, r: a6 }
const a8: A8 = { l: a7, r: a7 }
const a9: A9 = { l: a8, r: a8 }
const a10: A10 = { l: a9, r: a9 }
const a11: A11 = { l: a10, r: a10 }
const a12: A12 = { l: a11, r: a11 }
const a13: A13 = { l: a12, r: a12 }
const a14: A14 = { l: a13, r: a13 }
function mk(x: i32): A14 {
  if x == 0 { return a14 }
  return { l: a13, r: { l: a12, r: { l: a11, r: { l: a10, r: a10 } } } }
}
const r: R = {
  f: (x: i32): A14 => {
    const b = mk(x); b
  },
  g: (a: A14): i32 => a.l.l.l.l.l.l.l.l.l.l.l.l.l.l.x + 3,
}
const fs: FF[] = [mk, (x: i32): A14 => mk(x * 0)]
print(r.g(r.f(1)))
print(fs.length + r.f(0).l.r.l.r.l.r.l.r.l.r.l.r.l.r.x + 1)
print(r.g(fs[1](0)) + 1)
