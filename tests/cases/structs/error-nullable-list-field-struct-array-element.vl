// @run
// @log 3.5
// @log NULL
// GRADUATED (was @emit-error "ref-list field element type is not interned"): a
// struct-element ARRAY whose element struct carries a NULLABLE distinct-backing
// scalar-list field (`{a: {z: f64[] | null}[]}`). The `f64[] | null` field is now code 32
// (`(ref null $fl64TypeIdx)` — the distinct-backing dual of the i32-backed code 18), so
// the element struct classifies, its ref-list element slot interns, and `pushFieldStorage`
// emits a real wrapper instead of recording the loud "element type is not interned" error.
// Original provenance: fuzz sweep zq0NPY multiobs, seed 24438928 (`{a: {a: {f: boolean} |
// null, f: {[string]: {[string]: i64}}, z: f64[] | null}[], f: {f: i64}, z: {f: boolean}}
// | string | {q: i64}`), where the un-interned slot ALSO crashed the compiler twice
// (`emitObj`'s out-of-bounds `rlElemKindTbl` read, and `structIndexOfTypeName`'s scan over
// a half-registered inline shape). Both bounds guards stay in place — they now protect
// genuinely un-interned elements only. Reads both the populated and the `null` field so
// the element struct's nullable-list slot round-trips through the array.
function useIt(p: {a: {z: f64[] | null}[]}) {
  const e0 = p.a[0]
  const z0 = e0.z
  if z0 != null { print(z0[0]) } else { print("NULL") }
  const e1 = p.a[1]
  const z1 = e1.z
  if z1 != null { print(z1[0]) } else { print("NULL") }
}
function go() { useIt({ a: [{ z: [3.5, 4.5] }, { z: null }] }) }
go()
