// @log 2
// @log 7
// @log true
// @log 12
// @log 13
// @log 5
// @log 1
// @log 4
// A `null` value at an inline `1 | 2 | null` field is stored in the field type's box, so the
// literal builds at the annotation's row at every delivery position (D15730).
function f(o: { k: 1 | 2 | null, n: i32 }) { o.k ?? 9 }
print(f({ k: null, n: 1 }))
print(f({ k: 2, n: 1 }))
const m: { k: 1 | 2 | null } = { k: null }
print(m.k ?? 7)
print(m.k == null)
const w: { k: 1 | 2 | null } = { k: null }
print(w.k ?? 12)
w.k = 2
print((w.k ?? 12) + 11)
const xs: { k: 1 | 2 | null }[] = [{ k: null }, { k: 1 }]
print(xs[0].k ?? 5)
print(xs[1].k ?? 5)
function g(): { k: 1 | 2 | null } { { k: null } }
print(g().k ?? 4)
