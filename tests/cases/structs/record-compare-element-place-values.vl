// Record compares whose element side reads a global list, equal and unequal at each field, a
// nested record's included: a wrong element or a field read off the wrong side shows here.
type P = { x: i32, y: i32 }
type Q = { p: P, z: i32 }
const ps: P[] = [{ x: 1, y: 2 }, { x: 0, y: 2 }, { x: 1, y: 0 }]
const qs: Q[] = [
  { p: { x: 1, y: 2 }, z: 3 },
  { p: { x: 1, y: 2 }, z: 0 },
  { p: { x: 0, y: 2 }, z: 3 },
]
function eqP(i: i32, j: i32) { return ps[i] == ps[j] }
function eqQ(i: i32, j: i32) { return qs[i] != qs[j] }
print(eqP(0, 0))
print(eqP(0, 1))
print(eqP(0, 2))
print(eqP(1, 2))
print(eqQ(0, 0))
print(eqQ(0, 1))
print(eqQ(0, 2))
print(ps[2] == { x: 1, y: 0 })
