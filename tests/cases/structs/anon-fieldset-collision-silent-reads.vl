// Regression: the fieldset collision's SILENT half — the two cells where the colliding
// literals' fields share a wasm valtype, so nothing rejects and the wrong value is
// simply read back.
//
//   * WIDTH. `{ v: 6000000000 }` interns an anonymous row with an i64 field; the
//     unrelated `{ v: 2147483647 }` joined it and its field was read at i64, so
//     `+ 1` produced 2147483648 instead of wrapping to -2147483648.
//   * SENTINEL. A declared `{ v: boolean | null }` field is an i32 slot with a spare
//     value for `null`; the unrelated `{ v: 6 }` joined that row and read 6 as the
//     null sentinel, printing `null`.
//
// The i64 half is an ANON-row refutation (a declared `f: i64` field legitimately takes
// a bare small literal — the checker adopts and the store re-encodes — so that pair
// stays lenient off an annotation). The sentinel half refutes on EVERY row, because no
// adoption turns an integer into a boolean.
// @run
// @log 6000000000
// @log -2147483648
// @log true
// @log 6
type Flag = { v: boolean | null }
const big = { w: 6000000000 }
const small = { w: 2147483647 }
print(big.w)
print(small.w + 1)
const fl: Flag = { v: true }
const num = { v: 6 }
print(fl.v)
print(num.v)
