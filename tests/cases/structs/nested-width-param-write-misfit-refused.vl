// @error `f` writes `u.pet` a {legs: i32} on line 7, and its parameter `u` is this {pet: {legs: i32, purr: boolean}} itself
// A declared record parameter is instantiated at the record it is given (D3431), so a write
// through it must fit that record's layout; the refusal names the write and the layout (D16707).
type U = { pet: { legs: i32 } }
function f(u: U) {
  print(u.pet.legs)
  u.pet = { legs: 3 }
}
function mk(): { pet: { legs: i32, purr: boolean } } {
  return { pet: { legs: 4, purr: true } }
}
const sv = mk()
f(sv)
print(sv.pet.purr)
