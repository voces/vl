// @run
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @warning `==` on `Game` compares every element of its list field `map`, not whether both sides are the same record — compare a field that identifies the record, or the `map` fields directly when the element-wise compare is the intent
// @warning `==` on `Game` compares every element of its list field `map`, not whether both sides are the same record — compare a field that identifies the record, or the `map` fields directly when the element-wise compare is the intent
// `==` over a list of records whose fields are a string, a list or a literal union, directly and
// as a record's field, compared element by element (D5281).
type NodeKind = "start" | "fight"
type MapNode = { kind: NodeKind, name: string, links: i32[] }
type Game = { map: MapNode[] }
const a: MapNode[] = [{ kind: "start", name: "s", links: [1, 2] }]
const b: MapNode[] = [{ kind: "start", name: "s", links: [1, 2] }]
const c: MapNode[] = [{ kind: "start", name: "s", links: [1, 3] }]
print(a == b)
print(a == c)
const g1: Game = { map: a }
const g2: Game = { map: b }
const g3: Game = { map: [{ kind: "fight", name: "s", links: [1, 2] }] }
print(g1 == g2)
print(g1 == g3)
function same(x: MapNode[], y: MapNode[]) { x == y }
print(same(a, b))
const n1: MapNode[] = [{ kind: "start", name: "t", links: [1, 2] }]
print(same(a, n1))
function none(): Game | null { null }
print(none() == null)
