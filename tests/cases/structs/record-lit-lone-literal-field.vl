// @log A
// A record literal whose field is read from a binding at a lone literal type has a shape: at a
// binding, compared, at a numeric literal type, as a list element, as an inferred return, as a
// module global, and passed on to a literal-union parameter (D5341).
type W = "a" | "b"
const x: "a" = "a"
const w = { f: x, g: 1 }
print(w.f)
print(w.f == "a")
const n: 7 = 7
const q = { k: n }
print(q.k + 1)
const ws = [w, { f: x, g: 2 }]
print(ws[1].g)
function mk() {
  const y: "a" = "a"
  return { f: y }
}
print(mk().f)
const m = Map()
m["k"] = { f: x }
const got = m["k"]
if got != null { print(got.f) }
function show(k: W) {
  if k == "a" { return "A" }
  "B"
}
print(show(w.f))
