// @run
// @log 20
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `a` is inferred as `St[]`
// An inline annotation that is a recursive record unfolded once shares the declared record's
// row, so a `St[]` passes to it as it is (D3791).
import { toString } from "std:fmt"

type St = { key: i32, kids: St[] }
function f(x: { key: i32, kids: St[] }[]): i32 { return x[1].kids[0].key }
function mk(k: i32): St { return { key: k, kids: [{ key: k * 10, kids: [] }] } }
const a: St[] = [mk(1), mk(2), mk(3)]
print(f(a).toString())
