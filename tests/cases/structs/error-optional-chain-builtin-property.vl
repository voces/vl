// @error `?.length` is not available on i32[] | null — `?.` reads a declared struct field, and i32[] has none; narrow the receiver instead, e.g. `if v != null { v.length }`
// `?.` reaches DECLARED STRUCT FIELDS only, so a builtin property (`.length`, `.size`) is
// unreachable through it whatever the receiver is. The DECLINE is deliberate; the message
// is what changed. It used to read `member access '?.length' on non-object i32[] | null`,
// which called a list a non-object, named no rule, and offered no way forward — and it was
// the whole of one 110-cell family in the nullability sweep (`?.length` / `?.size` over a
// nullable list / string / map). It now names the rule and the narrowing that gets the
// value, which is the same shape the emitter-capability errors use.
function go(xs: i32[] | null) { print(xs?.length ?? 0) }
go([1, 2])
