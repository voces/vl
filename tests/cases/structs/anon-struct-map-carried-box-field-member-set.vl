// @run
// @log 7
// @log hi
// @log ho
// @log hi
// CONTRACT (D1675): an un-annotated `Map()` carrier resolves its value row from a RENDERED
// shape name, and that reader keys a union-box field on its member SEQUENCE. A box's tags are
// positional, so a carrier landing on a sibling holder's row narrows the payload against the
// other set's tags — a cast failure at run time rather than a refusal.
//
// NOTHING HERE MAY ANNOTATE A MAP OR A HOLDER. `const m: { [string]: { xs: U2 } } = Map()` is
// the rescue at either end, and it would make every read pass for the wrong reason.
//
// The last function is the leniency's own control: an ALIAS and its expansion are one set, so
// a comparator refuting on the two spellings would split a row that has to stay whole.
type U1 = i32 | boolean
type U2 = string | boolean
type U3 = string | i32
type U2Alias = U2

function u1(): U1 { return 7 }
function u2(): U2 { return "hi" }
function u3(): U3 { return "ho" }
function u2a(): U2Alias { return "hi" }

// The plain holder whose row the map's value must not take.
function plainBoxHolder() {
  const first = { xs: u1() }
  print(first.xs)
}

function mapCarriedBox() {
  const m = Map()
  m["k"] = { xs: u2() }
  const got = m["k"]
  if got != null { print(got.xs) }
}

// A third member set through a second carrier, so a fix that merely swapped which row wins
// is still caught.
function mapCarriedThirdSet() {
  const m = Map()
  m["k"] = { xs: u3() }
  const got = m["k"]
  if got != null { print(got.xs) }
}

function mapCarriedAliasedSet() {
  const m = Map()
  m["k"] = { xs: u2a() }
  const got = m["k"]
  if got != null { print(got.xs) }
}

plainBoxHolder()
mapCarriedBox()
mapCarriedThirdSet()
mapCarriedAliasedSet()
