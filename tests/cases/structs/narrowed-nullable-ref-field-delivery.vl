// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `b` is inferred as `{f: i32[]}`
// @hint redundant type annotation: `b` is inferred as `{f: {[string]: i32}}`
// @hint redundant type annotation: `b` is inferred as `{f: C[]}`
// @hint redundant type annotation: `b` is inferred as `{f: string[]}`
// @hint redundant type annotation: `b` is inferred as `{f: f64[]}`
// @hint redundant type annotation: `b` is inferred as `{f: i64[]}`
// @hint redundant type annotation: `b` is inferred as `{f: f32[]}`
// D1222 — a NARROWED nullable ref delivered into a NON-NULL struct FIELD, at the three
// field deliveries and the seven non-null ref codes that own a wrapper.
//
// A nullable niche READ keeps its raw `(ref null $H)` — narrowing is type-level and the USE
// site recovers — so every delivery into a `(ref $H)` owes `ref.as_non_null`. D1115 wired
// the return / binding / local- and global-assign boundaries, each of which names its
// destination by rep KIND. A field names its destination by field CODE, so it could not ask
// the shared question at all: `{f: y}` under `if y != null` stored a nullable ref into a
// non-null field slot — `vl check` rc 0, `expected (ref $type), found (ref null $type)`.
//
// EVERY CELL READS A VALUE *THROUGH* THE FIELD, so a wrapper of the wrong heap type cannot
// pass by constructing. The three positions are the object-literal field, the `b.f = y`
// store, and the same literal one struct deeper (a nested literal is `emitObj` re-entered,
// and it was the position the row's own six-cell count missed).

type C = { a: i32 }

function mkm(): {[string]: i32} {
  const q: {[string]: i32} = Map()
  q["k"] = 7
  q
}

// ── the object-literal field ──────────────────────────────────────────────────────────
type BL = { f: i32[] }
type BM = { f: {[string]: i32} }
type BR = { f: C[] }
type BS = { f: string[] }
type BD = { f: f64[] }
type BI = { f: i64[] }
type BF = { f: f32[] }

function litL(y: i32[] | null, d: i32[]): BL { if y != null { return {f: y} } {f: d} }
function litM(y: {[string]: i32} | null, d: {[string]: i32}): BM {
  if y != null { return {f: y} }
  {f: d}
}
function litR(y: C[] | null, d: C[]): BR { if y != null { return {f: y} } {f: d} }
function litS(y: string[] | null, d: string[]): BS { if y != null { return {f: y} } {f: d} }
function litD(y: f64[] | null, d: f64[]): BD { if y != null { return {f: y} } {f: d} }
function litI(y: i64[] | null, d: i64[]): BI { if y != null { return {f: y} } {f: d} }
function litF(y: f32[] | null, d: f32[]): BF { if y != null { return {f: y} } {f: d} }

print(litL([7], [0]).f[0])
print(litM(mkm(), mkm()).f["k"])
print(litR([{a: 7}], [{a: 0}]).f[0].a)
print(litS(["7"], ["0"]).f[0])
print(litD([7.0], [0.0]).f[0])
print(litI([7], [0]).f[0])
print(litF([7.0], [0.0]).f[0])

// ── the field STORE ───────────────────────────────────────────────────────────────────
function stoL(y: i32[] | null, d: i32[]): BL {
  const b: BL = {f: d}
  if y != null { b.f = y }
  b
}
function stoM(y: {[string]: i32} | null, d: {[string]: i32}): BM {
  const b: BM = {f: d}
  if y != null { b.f = y }
  b
}
function stoR(y: C[] | null, d: C[]): BR {
  const b: BR = {f: d}
  if y != null { b.f = y }
  b
}
function stoS(y: string[] | null, d: string[]): BS {
  const b: BS = {f: d}
  if y != null { b.f = y }
  b
}
function stoD(y: f64[] | null, d: f64[]): BD {
  const b: BD = {f: d}
  if y != null { b.f = y }
  b
}
function stoI(y: i64[] | null, d: i64[]): BI {
  const b: BI = {f: d}
  if y != null { b.f = y }
  b
}
function stoF(y: f32[] | null, d: f32[]): BF {
  const b: BF = {f: d}
  if y != null { b.f = y }
  b
}

print(stoL([7], [0]).f[0])
print(stoM(mkm(), mkm()).f["k"])
print(stoR([{a: 7}], [{a: 0}]).f[0].a)
print(stoS(["7"], ["0"]).f[0])
print(stoD([7.0], [0.0]).f[0])
print(stoI([7], [0]).f[0])
print(stoF([7.0], [0.0]).f[0])

// ── the NESTED literal, one struct deeper ─────────────────────────────────────────────
type OL = { i: BL }
type OM = { i: BM }
type OR = { i: BR }
type OS = { i: BS }
type OD = { i: BD }
type OI = { i: BI }
type OF = { i: BF }

function nesL(y: i32[] | null, d: i32[]): OL {
  if y != null { return {i: {f: y}} }
  {i: {f: d}}
}
function nesM(y: {[string]: i32} | null, d: {[string]: i32}): OM {
  if y != null { return {i: {f: y}} }
  {i: {f: d}}
}
function nesR(y: C[] | null, d: C[]): OR {
  if y != null { return {i: {f: y}} }
  {i: {f: d}}
}
function nesS(y: string[] | null, d: string[]): OS {
  if y != null { return {i: {f: y}} }
  {i: {f: d}}
}
function nesD(y: f64[] | null, d: f64[]): OD {
  if y != null { return {i: {f: y}} }
  {i: {f: d}}
}
function nesI(y: i64[] | null, d: i64[]): OI {
  if y != null { return {i: {f: y}} }
  {i: {f: d}}
}
function nesF(y: f32[] | null, d: f32[]): OF {
  if y != null { return {i: {f: y}} }
  {i: {f: d}}
}

print(nesL([7], [0]).i.f[0])
print(nesM(mkm(), mkm()).i.f["k"])
print(nesR([{a: 7}], [{a: 0}]).i.f[0].a)
print(nesS(["7"], ["0"]).i.f[0])
print(nesD([7.0], [0.0]).i.f[0])
print(nesI([7], [0]).i.f[0])
print(nesF([7.0], [0.0]).i.f[0])
