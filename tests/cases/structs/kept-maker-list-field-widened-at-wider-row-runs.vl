// @run
// @log 7
// @log 0.5
// @log 3
// @log 4
// A kept maker delivered at a row whose list field holds a wider number: the call copy widens the
// list element by element, the unannotated call keeps its own row, and the copy owns its list.
type K = { xs: f64[], n: i32 }
function mk() { { xs: [4, 5], n: 2 } }
const _k: K = mk()
const y = mk()
print(y.xs[1] + y.n)
print(_k.xs[0] / 8.0)
_k.xs.push(1.5)
print(_k.xs.length)
type L = { j: { xs: i64[] } }
function mk2() { { j: { xs: [4] } } }
const l: L = mk2()
print(l.j.xs[0])
