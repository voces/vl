// @run
// @log z
// @log a
// @log 5
// @log 3
// @log s
// @log z
// @log a
// CONTRACT (must-RUN): the two REF field reps of `p?.f ?? d` over a nullable-struct
// receiver — a STRING field and a value-UNION field. Both were once refused with
// `emitProgram: \`?.\` over a nullable struct has no \`if\` blocktype for this field's rep`
// while the NARROWED spelling (`if x != null { print(x.y) }`) ran at both, which is what
// made them capability gaps rather than rules (`silent-class-inventory` D802 / D803).
//
// THE STRING HALF IS NOT A BLOCKTYPE FIX. `x?.y` over a string field IS `string | null`, so
// the whole spelling belongs to the string niche's own `??` core (`br_on_non_null`, one
// evaluation) — `exprNullableString` says so, and that is also what routes `print` and an
// un-annotated binding to the string rep. Lifting only the emit-side refusal produced a
// valid `(ref $type)` block under an i32 print dispatch.
//
// THE UNION HALF IS A CONSUMER FIX. The blocktype was always spellable (`fbIfRef(uBoxIdx)`)
// and the default always boxable (`emitUnionCoerce`); what was missing is that nothing on
// the `?.` path called the value a BOX, so `const v = (x?.y) ?? 5` bound an i32 cell around
// a `(ref $uBox)`. `exprUnion` / `unionNameOfExpr` now answer for a code-16 chain leaf.
type Bs = { y: string }
type Bu = { y: i32 | string }

function fs(x: Bs | null) { print((x?.y) ?? "z") }
function fu(x: Bu | null) {
  if (x?.y) is string { print("s") } else { print((x?.y) ?? 5) }
}

fs(null) // z      — the default
fs({ y: "a" }) // a
fu(null) // 5      — the chain is null, so the default boxes in
fu({ y: 3 }) // 3
fu({ y: "a" }) // s

// The STANDALONE `?.` at a string leaf is the same niche and used to refuse too
// ("a standalone `?.` supports only i32/boolean leaf fields").
function fb(x: Bs | null) {
  const t = x?.y
  if t != null { print(t) } else { print("z") }
}
fb(null) // z
fb({ y: "a" }) // a
