// @run
// @log false
// @log true
// The map-field sibling of `declared-twin-inline-elem-array-param.vl`: the declared `T0`
// and the INLINE spelling of the same 3-field shape are twins, the array VALUE is built as
// `T0[]` and the param carries the inline element spelling. The nested `{[string]: boolean}`
// field again made the lenient fieldset scan decline the inline element name, so
// `shapeElemDeclaredStructIdx`'s `nameIsStructDecl` gate saw -1 and the `T[]` param was a
// loud REJECT. The canonical-key route (`repRowOfName`) resolves the inline spelling onto
// the declared twin's row.
type T0 = { a: boolean, f: { a: boolean, f: { [string]: boolean }, z: string }, z: string }

function useTwin(
  p: { a: boolean, f: { a: boolean, f: { [string]: boolean }, z: string }, z: string }[],
) {
  print(p[0].f.f["k"] ?? true)
}

function go() {
  const h0: { [string]: boolean } = Map()
  h0["k"] = false
  const w: T0[] = [{ a: true, f: { a: true, f: h0, z: "dx" }, z: "dx" }]
  useTwin(w)
  const h1: { [string]: boolean } = Map()
  const m: T0[] = [{ a: false, f: { a: false, f: h1, z: "dy" }, z: "dy" }]
  useTwin(m)
}

go()
