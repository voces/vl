// @run
// @log true
// @log false
// @log true
// @warning `==` on `T` compares every element of its list field `sub.ss`
// `==` over a record whose nested record holds a list of records reserves that list's compare
// frame, at top level and inside a function (D5343).
type S = { k: i32, name: string }
type C = { ss: S[] }
type T = { v: i32, sub: C }
const a: T = { v: 1, sub: { ss: [{ k: 2, name: "x" }] } }
const b: T = { v: 1, sub: { ss: [{ k: 2, name: "x" }] } }
const c: T = { v: 1, sub: { ss: [{ k: 3, name: "x" }] } }
print(a == b)
print(a == c)
function same(p: T, q: T) { p == q }
print(same(a, b))
