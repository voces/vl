// @run
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false

// `==` and `!=` over a twelve-level record whose every level holds the one below twice,
// compared through one comparison per record type rather than inline per field path
// (D9935): equal, unequal at one leaf, a sub-record, a nullable field and string leaves.

type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
type A11 = {l: A10, r: A10}
type A12 = {l: A11, r: A11}
type S0 = {s: string}
type S1 = {l: S0, r: S0}
type S2 = {l: S1, r: S1}
type S3 = {l: S2, r: S2}
type S4 = {l: S3, r: S3}
type S5 = {l: S4, r: S4}
type S6 = {l: S5, r: S5}
type N = {p: A12 | null, q: i32}

const a0: A0 = { x: 1 }
const a1: A1 = { l: a0, r: a0 }
const a2: A2 = { l: a1, r: a1 }
const a3: A3 = { l: a2, r: a2 }
const a4: A4 = { l: a3, r: a3 }
const a5: A5 = { l: a4, r: a4 }
const a6: A6 = { l: a5, r: a5 }
const a7: A7 = { l: a6, r: a6 }
const a8: A8 = { l: a7, r: a7 }
const a9: A9 = { l: a8, r: a8 }
const a10: A10 = { l: a9, r: a9 }
const a11: A11 = { l: a10, r: a10 }
const a12: A12 = { l: a11, r: a11 }
const b0: A0 = { x: 2 }
const b1: A1 = { l: a0, r: b0 }
const b2: A2 = { l: a1, r: b1 }
const b3: A3 = { l: a2, r: b2 }
const b4: A4 = { l: a3, r: b3 }
const b5: A5 = { l: a4, r: b4 }
const b6: A6 = { l: a5, r: b5 }
const b7: A7 = { l: a6, r: b6 }
const b8: A8 = { l: a7, r: b7 }
const b9: A9 = { l: a8, r: b8 }
const b10: A10 = { l: a9, r: b9 }
const b11: A11 = { l: a10, r: b10 }
const b12: A12 = { l: a11, r: b11 }
const s0: S0 = { s: "a" }
const t0: S0 = { s: "b" }
const s1: S1 = { l: s0, r: s0 }
const t1: S1 = { l: s0, r: t0 }
const s2: S2 = { l: s1, r: s1 }
const t2: S2 = { l: s1, r: t1 }
const s3: S3 = { l: s2, r: s2 }
const t3: S3 = { l: s2, r: t2 }
const s4: S4 = { l: s3, r: s3 }
const t4: S4 = { l: s3, r: t3 }
const s5: S5 = { l: s4, r: s4 }
const t5: S5 = { l: s4, r: t4 }
const s6: S6 = { l: s5, r: s5 }
const t6: S6 = { l: s5, r: t5 }
const n1: N = { p: a12, q: 1 }
const n2: N = { p: a12, q: 1 }
const n3: N = { p: null, q: 1 }

print(a12 == a12)
print(a12 == b12)
print(a12 != b12)
print(a12.l == b12.l)
print(s6 == t6)
print(n1 == n2)
print(n1 == n3)
