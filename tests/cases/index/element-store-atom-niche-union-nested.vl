// @run
// @log c
// @log n
// @log false
// @log x
// @log 1
// @log 3
// Element stores into atom, niche, union and nested lists, each the plain store legacy writes.
type K = "a" | "b" | "c"
type A = { a: i32 }
type B = { b: string }
type U = A | B
const kinds: K[] = ["a", "a"]
const opt: (K | null)[] = ["a", null]
const flags: (boolean | null)[] = [true, null]
const strs: (string | null)[] = ["x", null]
const us: U[] = [{ a: 1 }]
const rows: i32[][] = [[1], [2]]
function setKind(i: i32, k: K): i32 {
  kinds[i] = k
  opt[i] = k
  opt[1 - i] = null
  flags[i] = null
  strs[i] = null
  return 0
}
function setU(i: i32, u: U): i32 {
  us[i] = u
  return us.length
}
function setA(i: i32, x: A): i32 {
  us[i] = x
  return 0
}
function setRow(i: i32, xs: i32[]): i32 {
  rows[i] = xs
  return rows[i].length
}
setKind(1, "c")
print(kinds[1])
print(opt[0] ?? "n")
print(flags[1] ?? false)
print(strs[0] ?? "s")
print(setU(0, { b: "q" }))
setA(0, { a: 5 })
print(setRow(0, [7, 8, 9]))
