// @check
// @error index: expected i32, got string
// @error index write: expected i32, got string
// CONTRACT (must-error): the operator's INDEX parameter checks the key and its
// VALUE parameter checks the assigned value — the same two rejections the
// closure-FIELD trap gets, reached through the free-function route.
type Box = { v: i32 }

function "[]"(self: Box, k: i32): i32 {
  return self.v + k
}

function "[]="(self: Box, k: i32, x: i32) {
  print(self.v + k + x)
}

const b: Box = { v: 1 }
print(b["wrong"])
b[0] = "wrong"
