// @check
// @error operator "[]=" for Box takes 3 parameters (self, index, value), got 2
// @warning Unused function `"[]=" for Box`
// CONTRACT (must-error): an index operator's arity is fixed by the operator —
// `"[]"` is (self, index), `"[]="` is (self, index, value). Reported AT the
// declaration, so a malformed one is named once instead of failing to resolve at
// every use site.
type Box = { v: i32 }

function "[]"(self: Box, k: i32): i32 {
  return self.v + k
}

function "[]="(self: Box, k: i32) {
  print(self.v + k)
}

const b: Box = { v: 1 }
print(b[0])
