// @check
// @error field 'r' is not on every member of M — narrow with `is` first (i32 is not an object) — the `is` test was accepted; what it could not narrow is the READ, because `i` is not a literal subscript and so names no one cell. Bind the element first: `const v = …[i]`, then test and read `v`
// A narrowing key is a spelling, so only a literal subscript names one cell. The refusal used
// to end at "narrow with `is` first" — in a program whose condition IS an `is` — which told the
// author to do the thing they had done. D1730.
type A = { r: i32 }
type M = i32 | A
function st(): A { return { r: 8 } }
function pick(b: boolean): M {
  if b { return st() }
  return 7
}

const xs: M[] = [pick(true)]
let i = 0
if xs[i] is A { print(xs[i].r) } else { print(0) }
