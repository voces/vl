// @check
// @error an index operator needs an annotated `self` parameter
// CONTRACT (must-error): an index operator dispatches on the receiver's TYPE, so
// the receiver's type has to be written down. An un-annotated `self` is an
// inference hole that would accept every receiver — a dispatch no reader could
// predict, and a declaration that could not coexist with a second `"[]"`.
type Box = { v: i32 }

function "[]"(self, k: i32): i32 {
  return k
}

const b: Box = { v: 1 }
print(b[0])
