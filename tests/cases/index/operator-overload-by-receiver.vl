// @run
// @log 6
// @log 501
// @log 14
// @log 70
// @log 506
// @log 1015
// @log 2016
// @log 1019
// @log 123
// Two `"[]"` declarations coexist: an index operator dispatches on its `self`
// parameter's TYPE, so the operator is keyed by (operator, receiver) rather than
// by the operator alone. The pair below is the sharpest case — `Plain` and
// `Brand` have the IDENTICAL structure, and only the nominal brand tells them
// apart, which is exactly the shape `std:buffer`'s two views have.
//
// Also pins the contexts a bracket appears in (binding, argument, condition,
// arithmetic), the compound form, and NESTING: `g[i][j]` composes because the
// outer receiver is the inner operator's RETURN type.
type Plain = { base: i32 }
type Brand = new { base: i32 }
type Row = { start: i32 }
type Grid = { origin: i32 }

function "[]"(self: Plain, i: i32): i32 {
  return self.base + i
}

function "[]="(self: Plain, i: i32, v: i32) {
  print(1000 + self.base + i + v)
}

function "[]"(self: Brand, i: i32): i32 {
  return self.base * 100 + i
}

function "[]="(self: Brand, i: i32, v: i32) {
  print(2000 + self.base + i + v)
}

function "[]"(self: Row, i: i32): i32 {
  return self.start + i
}

function "[]"(self: Grid, i: i32): Row {
  return { start: self.origin + i * 10 }
}

function twice(n: i32): i32 {
  return n * 2
}

const p: Plain = { base: 5 }
const b: Brand = { base: 5 }
print(p[1])        // 6
print(b[1])        // 501 — same structure, different brand, different operator
print(twice(p[2])) // 14 — argument position
if p[0] == 5 {
  print(70) // condition position
}
print(p[1] + b[0]) // 506 — arithmetic position
p[3] = 7           // 1000 + 5 + 3 + 7
b[3] = 8           // 2000 + 5 + 3 + 8
// `x[i] += v` desugars to `x[i] = x[i] + v`, so it READS through `"[]"` and
// WRITES through `"[]="` — and, exactly as for a native array, evaluates the
// receiver and the index twice.
p[4] += 1 // reads 9, writes 10 → 1000 + 5 + 4 + 10
const g: Grid = { origin: 100 }
print(g[2][3]) // 123 — the inner bracket's result is the outer's receiver
