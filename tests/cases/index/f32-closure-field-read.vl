// @run
// @log 1.5
// @log 2.5
// @log 12
// @log 1.5
// @log 5
// An f32-returning `"[]"` CLOSURE FIELD (the B13 index trap). `x[i]` over a struct
// carrying a `"[]"` field is rewritten to the member call `x."[]"(i)` before lowering,
// and that `Call` node is MINTED by the rewrite — it has no checker-recorded type, so
// the emitter's f32 classification has to come from the syntactic cascade. That cascade
// had no field-closure arm (`exprIsF64`/`exprIsI64` both carry one), so an f32 result
// was bound into an i32 local and the module failed validation.
//
// Pinned with the three shapes that always worked, because each is why the defect
// looked narrower than it was: the i32 twin of the same trap, the SAME f32 closure under
// an ordinary field name called directly (a node the checker typed), and f32 arithmetic
// over two trapped reads. The free-operator route (`function "[]"(self: T, i: i32): f32`)
// mints an IDENT callee instead and was never affected — `std/buffer-view-bracket.vl`
// covers it.
function f32view(base: f32) { { "[]": (i: i32) => base + (i as f32) } }
function i32view(base: i32) { { "[]": (i: i32) => base + i } }
function f32get(base: f32) { { get: (i: i32) => base + (i as f32) } }

const fv = f32view(1.5)
print(fv[0])
print(fv[1])

const iv = i32view(10)
print(iv[2])

const g = f32get(1.5)
const d = g.get(0)
print(d)

const s = fv[0] + fv[2]
print(s)
