// @check
// @error a quoted function name must be an operator
// CONTRACT (must-error): the quoted function-name form exists to spell an
// OPERATOR — it is not a general "any string may name a function" escape hatch,
// which would let a declaration take a name no reference could ever be written
// for.
function "shout"(self: i32): i32 {
  return self
}

