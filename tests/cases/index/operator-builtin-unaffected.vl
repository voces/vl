// @run
// @log 20
// @log 99
// @log 97
// @log 7
// @log 11
// @log 3
// THE SWALLOW: declaring index operators does not change how the LANGUAGE's own
// indexable types behave. An array keeps `array.get`/`array.set`, a string keeps
// its char-code read, a map keeps its nullable-value read — none of them consults
// a `"[]"` declaration, even one whose receiver would structurally accept them.
//
// The inverted half is the last line: the SAME program's user receiver does
// dispatch, so a byte-identical built-in half is a real result and not a
// silently-inert feature.
type AnyBox = { v: i32 }

function "[]"(self: AnyBox, i: i32): i32 {
  return self.v + i
}

function "[]="(self: AnyBox, i: i32, v: i32) {
  print(9999 + self.v + i + v)
}

const xs = [10, 20, 30]
print(xs[1]) // 20 — native array.get
xs[1] = 99   // native array.set, NOT the operator (no 9999 logged)
print(xs[1]) // 99
const s = "abc"
print(s[0]) // 97 — native string char code
const m: {[string]: i32} = Map()
m["k"] = 7
print(m["k"] ?? -1) // 7 — native map read
const b: AnyBox = { v: 10 }
print(b[1]) // 11 — the operator DOES fire for its own receiver
const nested = [[1, 2], [3, 4]]
print(nested[1][0]) // 3 — a nested native index is still native
