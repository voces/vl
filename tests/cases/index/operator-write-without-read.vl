// @check
// @error operator "[]=" for Box needs a matching "[]" operator
// CONTRACT (must-error): the assignment form checks its target as an ordinary
// index expression first, so a receiver with only a WRITE operator would be
// reported as "cannot index" — naming the wrong half. Say which half is missing
// instead.
type Box = { v: i32 }

function "[]="(self: Box, k: i32, x: i32) {
  print(self.v + k + x)
}

const b: Box = { v: 1 }
b[0] = 2
