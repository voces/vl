// @run
// @log 303
// @log 102
// @log 103
// @log 107
// @log 103
// @hint redundant type annotation: `"[]" for Box` is inferred as `i32`
// @hint redundant type annotation: `sumOf` is inferred as `i32`
// @hint redundant type annotation: `lengthPlus` is inferred as `i32`
// @hint redundant type annotation: `b` is inferred as `{v: i32}`
// The bracket reaches every body an expression can live in — not just top level.
//
// The GENERIC case is the one worth pinning: the checker banks its resolution on
// the SITE NODE, and the emitter clones a generic body once per instantiation. It
// holds because the dispatch rewrite runs BEFORE monomorphization, so each clone
// inherits an already-rewritten call rather than an `Index` whose bank its fresh
// node index would miss. Two instances below, over different element types.
type Box = { v: i32 }

function "[]"(self: Box, i: i32): i32 {
  return self.v + i
}

function "[]="(self: Box, i: i32, x: i32) {
  print(self.v + i + x)
}

function sumOf(b: Box, n: i32): i32 {
  let s = 0
  let i = 0
  while i < n {
    s = s + b[i]
    i = i + 1
  }
  return s
}

function lengthPlus<T>(xs: T[], b: Box): i32 {
  const n = xs.length
  return b[n]
}

function poke(t: Box) {
  t[1] = 2
}

const b: Box = { v: 100 }
print(sumOf(b, 3))                 // 100 + 101 + 102
print(lengthPlus([1, 2], b))       // instance 1
print(lengthPlus(["a", "b", "c"], b)) // instance 2
const f = (k: i32) => b[k]
print(f(7)) // inside a lambda
poke(b)     // the write, inside a function body
