// @run
// @log 15
// @log 12
// @log 107
// Free INDEX OPERATORS (ROADMAP B14): `function "[]"(self: T, i: I)` and
// `function "[]="(self: T, i: I, v: V)` are ordinary free functions whose NAME is
// the operator, and `x[i]` / `x[i] = v` on a receiver the language does not index
// lower to a DIRECT call to them. A quoted string is the spelling because `[` and
// `]` open an index expression everywhere else, so the bracket operators have no
// operator TOKEN — the same spelling their closure-FIELD form uses.
//
// The `self` parameter's annotation is REQUIRED: the operator dispatches on the
// receiver's TYPE, and that annotation is what the dispatch reads.
type Box = { v: i32 }

function "[]"(self: Box, k: i32): i32 {
  return self.v + k
}

function "[]="(self: Box, k: i32, x: i32) {
  print(self.v + k + x)
}

const b: Box = { v: 10 }
print(b[5]) // 15 — the direct call `"[]"(b, 5)`
print(b[2]) // 12
b[7] = 90   // 10 + 7 + 90
