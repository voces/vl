// `sinF32`/`cosF32` take and return f32, rounding once from an f64 evaluation. Each line
// prints the f32 result widened for display; every value is the exact sine or cosine
// rounded to the nearest f32, including at 1e6 and at f32's largest finite value.
import { cosF32, sinF32 } from "std:math"

const xs: f32[] = [0.5, 1.0, -2.0, 3.0, 10.0, 1000000.0, 3.4028234663852886e38]
for x in xs {
  print(sinF32(x))
  print(cosF32(x))
}
