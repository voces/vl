// @run
// @log 3.141592653589793
// @log 3.1415927410125732
// @log true
// @log true
// The nearest-representable π at each width. `PI` is the f64 value; `PI_F32` is the f32
// value, which prints as its f64 widening. The two agree to within f32's own precision.
import { PI, PI_F32 } from "std:math"

print(PI)
print(PI_F32)
print(PI > 3.1415926 && PI < 3.1415927)
print(abs(PI - PI_F32) < 0.0000001)
