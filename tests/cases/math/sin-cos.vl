// `sinF64`/`cosF64` at small, medium and huge arguments, each printing the value it must
// return on every host. Every pinned value is within 1 ulp of the exact sine or cosine,
// and the huge ones need the full reduction: 1e22, 1e300 and the largest double. All but
// `cosF64(1e15)` are the correctly rounded value; that one is 1 ulp away.
import { cosF64, sinF64 } from "std:math"

const xs = [
  0.5, 1.0, -2.0, 3.0, 10.0, -100.0, 3.141592653589793, 1e6, 1e15, 1e22, 1e300,
  1.7976931348623157e308,
]
for x in xs {
  print(sinF64(x))
  print(cosF64(x))
}
