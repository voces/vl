// `atan2(y, x)` (y first) across all four quadrants, the four axes and the origin, at
// both widths. Each line asserts the result is within the promised absolute bound of the
// true angle (1e-7 for f64, 1e-6 for f32), printing `true`. The origin is defined as 0.
import { atan2F32, atan2F64 } from "std:math"

// f64: quadrants Q1..Q4, then +x / +y / -x / -y axes, origin, then two general angles.
print(abs(atan2F64(1.0, 1.0) - 0.7853981633974483) < 0.0000001)
print(abs(atan2F64(1.0, -1.0) - 2.356194490192345) < 0.0000001)
print(abs(atan2F64(-1.0, -1.0) + 2.356194490192345) < 0.0000001)
print(abs(atan2F64(-1.0, 1.0) + 0.7853981633974483) < 0.0000001)
print(abs(atan2F64(0.0, 1.0) - 0.0) < 0.0000001)
print(abs(atan2F64(1.0, 0.0) - 1.5707963267948966) < 0.0000001)
print(abs(atan2F64(0.0, -1.0) - 3.141592653589793) < 0.0000001)
print(abs(atan2F64(-1.0, 0.0) + 1.5707963267948966) < 0.0000001)
print(atan2F64(0.0, 0.0) == 0.0)
print(abs(atan2F64(2.0, 1.0) - 1.1071487177940904) < 0.0000001)
print(abs(atan2F64(1.0, 2.0) - 0.4636476090008061) < 0.0000001)

// f32: the same coverage against the looser f32 bound.
print(abs(atan2F32(1.0, 1.0) - 0.7853981633974483) < 0.000001)
print(abs(atan2F32(1.0, -1.0) - 2.356194490192345) < 0.000001)
print(abs(atan2F32(-1.0, -1.0) + 2.356194490192345) < 0.000001)
print(abs(atan2F32(-1.0, 1.0) + 0.7853981633974483) < 0.000001)
print(abs(atan2F32(0.0, 1.0) - 0.0) < 0.000001)
print(abs(atan2F32(1.0, 0.0) - 1.5707963267948966) < 0.000001)
print(abs(atan2F32(0.0, -1.0) - 3.141592653589793) < 0.000001)
print(abs(atan2F32(-1.0, 0.0) + 1.5707963267948966) < 0.000001)
print(atan2F32(0.0, 0.0) == 0.0)
print(abs(atan2F32(2.0, 1.0) - 1.1071487177940904) < 0.000001)
print(abs(atan2F32(1.0, 2.0) - 0.4636476090008061) < 0.000001)
