// @run
// @log 2.7182817459106445
// @log 0.3678794503211975
// @log 1.6487212181091309
// @log 22026.46484375
// @log 0.00004539993096841499
// @log 3.325976864406685e+38
// @log 3.783505853677006e-44
// @log 0.6931471824645996
// @log 2.3025851249694824
// @log -0.6931471824645996
// @log 0.00010001159535022452
// @log -92.10340881347656
// @log 88.72283935546875
// @log 1.4142135381698608
// @log 10000000000
// @log -27
// @log 22052.015625
// @log 0.6147881746292114
// `expF32`/`logF32`/`powF32` take and return f32, rounding once from an f64 evaluation. Each
// line prints the f32 result widened for display; every value is the exact result rounded to
// the nearest f32, including an f32 subnormal from `expF32` and f32's largest finite value
// through `logF32`.
import { expF32, logF32, powF32 } from "std:math"

const xs: f32[] = [1.0, -1.0, 0.5, 10.0, -10.0, 88.7, -100.0]
for x in xs { print(expF32(x)) }
const ls: f32[] = [2.0, 10.0, 0.5, 1.0001, 1e-40, 3.4028234663852886e38]
for x in ls { print(logF32(x)) }
print(powF32(2.0, 0.5))
print(powF32(10.0, 10.0))
print(powF32(-3.0, 3.0))
print(powF32(1.0001, 100000.0))
print(powF32(7.0, -0.25))
