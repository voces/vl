// @run
// @log 0.40489181876182556
// @log -2.8198421001434326
// @log 0.09966865181922913
// @log 0.46364760398864746
// @log 1.1071487665176392
// @log -1.5707963705062866
// @log 0.5235987901687622
// @log 1.0471975803375244
// @log -0.7753974795341492
// @log 2.346193790435791
// @log 1.5566529035568237
// @log 0.014143426902592182
// @log 5
// @log 4.9999999241216036e+30
// @log 1.4142135555081815e-30
// `atan2F32`/`atanF32`/`asinF32`/`acosF32`/`hypotF32` take and return f32, rounding once from
// an f64 evaluation. Each line prints the f32 result widened for display; every value is the
// exact result rounded to the nearest f32, including a hypot past where `x*x` overflows f32.
import { acosF32, asinF32, atan2F32, atanF32, hypotF32 } from "std:math"

print(atan2F32(0.3, 0.7))
print(atan2F32(-1.0, -3.0))
const ts: f32[] = [0.1, 0.5, 2.0, -1e10]
for x in ts { print(atanF32(x)) }
const ss: f32[] = [0.5, -0.7, 0.9999]
for x in ss {
  print(asinF32(x))
  print(acosF32(x))
}
print(hypotF32(3.0, 4.0))
print(hypotF32(3e30, 4e30))
print(hypotF32(1e-30, 1e-30))
