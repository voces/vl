// @log 2143289344
// The edges of atan2, atan, asin, acos and hypot at both widths, as raw bits so signed zeros
// and the one quiet NaN show. atan2 follows IEEE 754 (a zero `y` keeps its sign, `x = -0`
// gives ±π, two infinities give an odd multiple of π/4); hypot is infinity when either
// argument is, even beside a NaN.
import {
  acosF32,
  acosF64,
  asinF32,
  asinF64,
  atan2F32,
  atan2F64,
  atanF32,
  atanF64,
  hypotF32,
  hypotF64,
} from "std:math"

const zero = 0.0
const nan = zero / zero
const inf = 1.0 / zero
function both(y: f64, x: f64) {
  print(f64bits(atan2F64(y, x)))
  print(f32bits(atan2F32(y as f32, x as f32)))
  print(f64bits(hypotF64(y, x)))
  print(f32bits(hypotF32(y as f32, x as f32)))
}
both(0.0, 0.0)
both(0.0, -0.0)
both(-0.0, -0.0)
both(-0.0, 1.0)
both(-0.0, -1.0)
both(1.0, 0.0)
both(-1.0, -0.0)
both(inf, inf)
both(inf, -inf)
both(-inf, -inf)
both(1.0, inf)
both(-1.0, -inf)
both(inf, 1.0)
both(nan, inf)
both(nan, 1.0)
both(1.0, nan)
for x in [nan, inf, -inf, 0.0, -0.0, 1.0, -1.0, 1.5] {
  print(f64bits(atanF64(x)))
  print(f32bits(atanF32(x as f32)))
  print(f64bits(asinF64(x)))
  print(f32bits(asinF32(x as f32)))
  print(f64bits(acosF64(x)))
  print(f32bits(acosF32(x as f32)))
}
