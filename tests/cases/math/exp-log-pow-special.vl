// @log -8388608
// The edges of `expF64`/`logF64`/`powF64` and their f32 twins, as raw bits so signed zeros and
// the one quiet NaN show. `pow` follows IEEE 754: `pow(x, 0)` and `pow(1, y)` are 1 even for
// NaN, `pow(-1, ±inf)` is 1, a zero base keeps its sign under an odd exponent, and a negative
// base with a non-integer exponent is NaN.
import { expF32, expF64, logF32, logF64, powF32, powF64 } from "std:math"

const zero = 0.0
const nan = zero / zero
const inf = 1.0 / zero
for x in [nan, inf, -inf, 0.0, -0.0, 710.0, -746.0] {
  print(f64bits(expF64(x)))
  print(f32bits(expF32(x as f32)))
}
for x in [nan, inf, -inf, 0.0, -0.0, -1.0, 1.0, -5e-324] {
  print(f64bits(logF64(x)))
  print(f32bits(logF32(x as f32)))
}
function pp(x: f64, y: f64) {
  print(f64bits(powF64(x, y)))
  print(f32bits(powF32(x as f32, y as f32)))
}
pp(nan, 0.0)
pp(1.0, nan)
pp(-1.0, inf)
pp(-1.0, -inf)
pp(0.5, inf)
pp(0.5, -inf)
pp(2.0, inf)
pp(2.0, -inf)
pp(0.0, -3.0)
pp(-0.0, -3.0)
pp(-0.0, -2.0)
pp(-0.0, 3.0)
pp(-0.0, 2.0)
pp(-0.0, 0.5)
pp(inf, -1.0)
pp(inf, 0.5)
pp(-inf, -3.0)
pp(-inf, 3.0)
pp(-inf, 2.0)
pp(-inf, -0.5)
pp(-2.0, 0.5)
pp(-8.0, 1.0)
pp(2.0, nan)
pp(nan, 1.0)
pp(-1.0, 1e300)
pp(10.0, 400.0)
pp(10.0, -400.0)
pp(-10.0, 401.0)
