// @run
// @log 5
// @log 13
// @log 17
// @log 0
// @log 7
// @log 5
// @log 13
// @log 25
// `hypot` is `sqrt(x*x + y*y)` at both widths. Pythagorean triples land on exact
// integers at each width (3-4-5, 5-12-13, 8-15-17, 7-24-25), and the zero cases show
// the degenerate vectors. These inputs are far below the naive form's overflow edge.
import { hypotF32, hypotF64 } from "std:math"

print(hypotF64(3.0, 4.0))
print(hypotF64(5.0, 12.0))
print(hypotF64(8.0, 15.0))
print(hypotF64(0.0, 0.0))
print(hypotF64(0.0, 7.0))

print(hypotF32(3.0, 4.0))
print(hypotF32(5.0, 12.0))
print(hypotF32(7.0, 24.0))
