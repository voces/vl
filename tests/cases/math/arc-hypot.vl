// @log 5e-320
// @log 1.414213562373095e-200
// @log 1
// `atan2F64`/`atanF64`/`asinF64`/`acosF64`/`hypotF64`, each printing the value it must return
// on every host. Every pinned value is the correctly rounded result, among them asin and
// acos within 1e-7 of ±1, atan2 of two subnormals, and hypot where the naive
// `sqrt(x*x + y*y)` would overflow or underflow.
import { acosF64, asinF64, atan2F64, atanF64, hypotF64 } from "std:math"

print(atan2F64(0.3, 0.7))
print(atan2F64(1.0, -3.0))
print(atan2F64(-5.0, -0.001))
print(atan2F64(1e-200, 1e100))
print(atan2F64(3e-310, 7e-310))
for x in [0.1, 0.5, -0.6, 0.75, 1.0, 3.0, -1e10] { print(atanF64(x)) }
for x in [0.1, 0.5, -0.7, 0.9999999, -1.0] {
  print(asinF64(x))
  print(acosF64(x))
}
print(hypotF64(3.0, 4.0))
print(hypotF64(1e300, 1e300))
print(hypotF64(3e-320, 4e-320))
print(hypotF64(1e-200, 1e-200))
print(hypotF64(1.0, 1e-20))
