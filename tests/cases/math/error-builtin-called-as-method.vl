// @error-at 12:8 member access '.abs' on non-object f64 — `abs` is a builtin function, not a method: call it as `abs(x)`
// @error-at 13:8 member access '.max' on non-object f64 — `max` is a builtin function, not a method: call it as `max(x, 1.0)`
// @error-at 14:8 member access '.clz' on non-object i32 — `clz` is a builtin function, not a method: call it as `clz(n)`
// diderven DV-005 — a numeric builtin spelled as a method names the call, from the source. A
// float-only builtin on an integer (`n.sqrt()`) keeps the plain sentence: `sqrt(n)` would not type.
// @error-at 15:8 member access '.sqrt' on non-object i32
// A prefix minus is spelled tight, and an argument split across lines is spelled on one.
// @error-at 16:8 call it as `max(x, -1.0)`
// @error-at 17:11 call it as `abs(-x)`
// @error-at 20:4 call it as `max(x, someLongMeasurementName * someLongMeasurementName + someLongMeasurementName - -1.0)`
const x: f64 = -2.5
const n: i32 = 8
print(x.abs())
print(x.max(1.0))
print(n.clz())
print(n.sqrt())
print(x.max(-1.0))
print((-x).abs())
const someLongMeasurementName: f64 = 1.0
print(
  x.max(
    someLongMeasurementName * someLongMeasurementName
      + someLongMeasurementName
      - -1.0,
  ),
)
