// @error-at 8:8 member access '.abs' on non-object f64 — `abs` is a builtin function, not a method: call it as `abs(x)`
// @error-at 9:8 member access '.max' on non-object f64 — `max` is a builtin function, not a method: call it as `max(x, y)`
// @error-at 10:8 member access '.clz' on non-object i32 — `clz` is a builtin function, not a method: call it as `clz(x)`
// diderven DV-005 — a numeric builtin spelled as a method names the call to write. A
// float-only builtin on an integer (`n.sqrt()`) keeps the plain sentence: `sqrt(n)` would not type.
// @error-at 11:8 member access '.sqrt' on non-object i32
const x: f64 = -2.5
const n: i32 = 8
print(x.abs())
print(x.max(1.0))
print(n.clz())
print(n.sqrt())
