// @log 1e+305
// `expF64`/`logF64`/`powF64` across their ranges, each printing the value it must return on
// every host: the unit interval, results near overflow and deep in the subnormals, `log` near
// 1 and of the smallest subnormal, and `pow` with x near 1 and a huge y. Every pinned value
// is the correctly rounded result, and the integer powers are exact.
import { expF64, logF64, powF64 } from "std:math"

const xs = [
  1.0, -1.0, 0.5, 1e-10, 10.0, -10.0, 100.0, 709.78, -708.5, -740.0, -745.13,
]
for x in xs { print(expF64(x)) }
const ls = [
  2.0, 10.0, 0.5, 1.0000001, 0.9999999, 1e-300, 5e-324, 1e300,
  1.7976931348623157e308, 3.0,
]
for x in ls { print(logF64(x)) }
print(powF64(2.0, 0.5))
print(powF64(10.0, 22.0))
print(powF64(3.0, 33.0))
print(powF64(-2.0, 3.0))
print(powF64(-2.0, -1074.0))
print(powF64(2.0, -1074.0))
print(powF64(1.0000000001, 1e12))
print(powF64(0.5, 1000.0))
print(powF64(7.0, -0.25))
print(powF64(1e10, 30.5))
