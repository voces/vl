// The edges of `sinF64`/`cosF64`/`sinF32`/`cosF32`, as raw bits so the sign of zero and
// the NaN are both visible. `sin(-0.0)` keeps its sign; `cos(-0.0)` is exactly 1; NaN,
// +infinity and -infinity all give the one quiet NaN (f64 bits 0x7FF8000000000000, f32
// bits 0x7FC00000); a tiny argument returns itself from sin and 1 from cos.
import { cosF32, cosF64, sinF32, sinF64 } from "std:math"

const zero = 0.0
const specials = [-0.0, zero / zero, 1.0 / zero, -1.0 / zero, 1e-300]
for x in specials {
  print(f64bits(sinF64(x)))
  print(f64bits(cosF64(x)))
  print(f32bits(sinF32(x as f32)))
  print(f32bits(cosF32(x as f32)))
}
