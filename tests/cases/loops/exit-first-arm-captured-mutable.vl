// @run
// @log -7
// @log 9
// @log -7
// @log -1
// @log -1
// @log 9
// A binding whose initializer's first arm always exits takes its checked type as an annotation;
// a closure that assigns it boxes it into a cell spelled from that annotation, a declared record
// by its name, so the cell has a rep (D3222).
type Rec = { r: i32 }
function scalar(n: i32) {
  let y = if n == 4 { return -7 } else { n + 1 }
  const cf = () => {
    y = 9
    0
  }
  cf()
  y
}
function record(n: i32) {
  const o: Rec | null = if n > 1 { { r: n } } else { null }
  let y = if n == 4 { return -7 } else { o }
  const cf = () => {
    y = null
    0
  }
  cf()
  (y)?.r ?? -1
}
function nev(n: i32) {
  const o: Rec | null = if n > 1 { { r: n } } else { null }
  let y = if n == 99 { __trap__() } else { o }
  const cf = () => {
    y = null
    0
  }
  cf()
  (y)?.r ?? -1
}
function labelled(n: i32) {
  const res = @B {
    let y = if n == 4 { break @B -7 } else { n + 1 }
    const cf = () => {
      y = 9
      0
    }
    cf()
    y
  }
  res
}
print(scalar(4))
print(scalar(2))
print(record(4))
print(record(2))
print(nev(2))
print(labelled(2))
