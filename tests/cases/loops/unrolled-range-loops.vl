// A range loop with constant ends, a literal step and a small body is emitted as one copy of the
// body per trip, each reading the loop var as a constant. Each row prints what the rolled
// loop printed: `break` and `continue` at every position, nesting, labels, a `let` per copy, and
// the loops that must stay rolled (a closure over the var, a body that writes it, too many trips).
const N = 4
const NEG = -3

function positions() {
  let s = 0
  for i in 0 until 4 {
    if i == 2 { break }
    s = s * 10 + i + 1
  }
  print(s)
  s = 0
  for i in 0 until 4 {
    s = s * 10 + i + 1
    if i == 1 { continue }
    s = s * 10
  }
  print(s)
  s = 0
  for i in 0 until 4 {
    s = s * 10 + i + 1
    if i == 2 { break }
  }
  print(s)
  s = 0
  for i in 1 to 7 step 3 { s = s * 10 + i }
  print(s)
  s = 0
  for i in N until NEG step -2 { s = s * 10 + i }
  print(s)
  s = 0
  for i in 0 until N { s = s * 10 + i }
  print(s)
}
positions()

// nested 4x4, a labelled continue from the inner loop, a `let` list minted fresh by every copy.
function nested() {
  const m: i32[] = []
  for i in 0 until 4 {
    for j in 0 until 4 { m.push(i * 4 + j) }
  }
  let t = 0
  for i in 0 until 4 {
    for j in 0 until 4 { t = t + m[i * 4 + j] * (j + 1) }
  }
  print(t)
  let s = 0
  outer: for i in 0 until 3 {
    for j in 0 until 3 {
      if j > i { continue outer }
      s = s * 10 + j
    }
  }
  print(s)
  for i in 0 until 3 {
    const row: i32[] = []
    row.push(i)
    for j in 0 until 2 { row.push(j) }
    print(row.length * 10 + row[0])
  }
  for i in 0 until 2 {
    let i = 7
    i = i + 1
    print(i)
  }
}
nested()

// a `return` from a copy, a `match` in the body, a for-in inside.
function firstOver(xs: i32[], lim: i32) {
  for i in 0 until 4 {
    if xs[i] > lim { return i }
  }
  -1
}
print(firstOver([1, 5, 9, 12], 6))
print(firstOver([1, 5, 9, 12], 60))
function kinds() {
  let s = ""
  for i in 0 until 3 {
    const w = match i {
      0 => "a"
      1 => "b"
      _ => "c"
    }
    s = s + w
    for x in [i, i] { s = s + "." }
  }
  print(s)
}
kinds()

// stays rolled: a closure over the loop var sees its own iteration's value, a body that writes
// the var steps from the written value, and 17 trips is past the limit.
function rolled() {
  const fs: (() => i32)[] = []
  for i in 0 until 3 { fs.push(() => i * 10) }
  for f in fs { print(f()) }
  let s = 0
  for i in 0 until 8 {
    s = s * 10 + i
    i = i + 2
  }
  print(s)
  s = 0
  for i in 0 until 17 { s = s + i }
  print(s)
  s = 0
  for i in 0 until 16 { s = s + i }
  print(s)
  s = 0
  for i in 2147483640 until 2147483647 { s = s + (i - 2147483640) }
  print(s)
}
rolled()
