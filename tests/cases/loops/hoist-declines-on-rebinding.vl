// @run
// @log 1
// @log 2
// @log 60
// @log 70
// Rebinding the indexed name inside the loop declines the hoist: after `src = c`
// the cached header would name the wrong list. The last two bytes come from `c`,
// which is only true if each read went through the current binding.
import { Buffer, loadU8 } from "std:buffer"

const a: u8[] = [1, 2, 3, 4]
const c: u8[] = [40, 50, 60, 70]
const b = Buffer(8)
let src = a
let i = 0
while i < 4 {
  __store_i8__(b.base + i, src[i])
  if i == 1 { src = c }
  i = i + 1
}
print(b.loadU8(0))
print(b.loadU8(1))
print(b.loadU8(2))
print(b.loadU8(3))
