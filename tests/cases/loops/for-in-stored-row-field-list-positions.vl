// @run
// @log null
// @log null
// @log 4
// @log 4
// @log 4
// @warning Unused variable `dA`
// @warning Unused variable `dB`
// @warning Unused variable `go`
// A list read off a record held at its stored row is walked at that row's element: one row per
// position such a field is walked in.
type J = { f: i32 | null }
function mk2() { return { f: null } }
function mk3() { return { f: 4 } }
const dA: J = mk2()
const dB: J = mk3()
const go = [1].length > 0
// a top-level walk of a record literal's list field
const r = { ys: [mk2(), mk2()] }
for y in r.ys { print(y.f) }
// a second field list, of the other maker
const t = { zs: [mk3()] }
for z in t.zs { print(z.f) }
// a walk in a function body
function inFn() {
  const q = { ys: [mk3(), mk3()] }
  for y in q.ys { print(y.f) }
}
inFn()
