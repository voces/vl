// @run
// @log 2
// @log -7
// @log 1
// @log 2
// @log -7
// @log 1
// The nested exiting-first-arm refusal covers only the construct standing at another arm's
// tail. Either fix its message names runs: binding it to a name first, or putting the exiting
// arm last (D3222).
function bound(n: i32, o: i32[] | null) {
  const y = if n > -100 {
    const q = if n == 4 { return -7 } else { o }
    q
  } else {
    o
  }
  (y ?? [0]).length
}
function last(n: i32, o: i32[] | null) {
  const y = if n > -100 {
    if n != 4 { o } else { return -7 }
  } else {
    o
  }
  (y ?? [0]).length
}
print(bound(2, [1, 2]))
print(bound(4, [1]))
print(bound(2, null))
print(last(2, [1, 2]))
print(last(4, [1]))
print(last(2, null))
