// @run
// @log c1b1||c3b3|
// @log k1.k5.
// @log n1after
// A labelled block is one frame a `break` to it leaves: inside a loop it skips to the code after
// the block, a `continue` to the loop passes it, and a `break` to the loop leaves both.
let trail = ""
function note(s: string) { trail = trail + s }
function nestedBreak(xs: i32[]) {
  for x in xs {
    @b {
      @c {
        if x == 2 { break @b }
        note("c\{x}")
      }
      note("b\{x}")
    }
    note("|")
  }
}
function blockContinue(xs: i32[]) {
  @L for x in xs {
    @b {
      if x == 3 { continue @L }
      note("k\{x}")
    }
    note(".")
  }
}
function blockBreakLoop(xs: i32[]) {
  @L for x in xs {
    @b {
      @c {
        if x == 4 { break @L }
        note("n\{x}")
      }
    }
  }
  note("after")
}
nestedBreak([1, 2, 3])
print(trail)
trail = ""
blockContinue([1, 3, 5])
print(trail)
trail = ""
blockBreakLoop([1, 4, 6])
print(trail)
