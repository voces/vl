// @run
// @log 7
// @log 10
// @hint Intentionally-unused parameter `_o` (leading `_` marks it unused)
// @hint redundant type annotation: `a` is inferred as `{x: i32}`
// A user operator is a call: `a + a` below pushes onto the walked list, so the walk must keep
// re-reading its header and visit the pushed elements. The hoist is sound only because operators
// are rewritten to calls before `hoistSafeBlock` looks at the body; were they not, this walk
// would stop after 3 steps.
type V = { x: i32 }
const log = [1, 2, 3]
function "+"(self: V, _o: V) {
  log.push(self.x)
  log.length
}
const a: V = { x: 7 }
let n = 0
let steps = 0
for e in log {
  n = a + a
  steps = steps + 1
  if steps > 6 { break }
}
print(steps)
print(n)
