// @check
// @error for-in expects an array, a map or a string, got i32
// for…in requires an array, a map or a string; anything else is a clean type error,
// not a crash. A STRUCT iterable has its own sentence naming the map, because it is
// the one an author writes on purpose (`for-in-refusal-errors.vl`).
let s = 0
for x in 5 { s = s + x }
