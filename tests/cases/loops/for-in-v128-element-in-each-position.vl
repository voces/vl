// @run
// @log 1.5
// @log 4
// @log u1.5
// @log u4
// @log 1.5
// @log 4
// @log w1.5
// @log w4
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// @log 0
// @log 1.5
// @log 1
// @log 4
// A walk over an `F32x4[]`, its loop variable delivered at each position: a call, a union
// parameter (not for a nullable closure: D17380), a nested call, an interpolation hole, a return, a binding, an `if` arm, a `??`
// operand and a record-literal field; then an index pair (Q58 position sweep).
import { F32x4, splatF32 } from "std:simd"

function val(v: F32x4) { return v.x }
type Got = { g: F32x4 }
function pass(x: F32x4) { return x }
function su(w: F32x4 | string) {
  if w is string { return w }
  return "u\{val(w)}"
}
function pCall(z: F32x4[]) {
  for e in z { print(val(e)) }
}
function pUnion(z: F32x4[]) {
  for e in z { print(su(e)) }
}
function pNested(z: F32x4[]) {
  for e in z { print(val(pass(e))) }
}
function pHole(z: F32x4[]) {
  for e in z { print("w\{val(e)}") }
}
function pReturn(z: F32x4[]) {
  for e in z { return e }
  return z[0]
}
function pLet(z: F32x4[]) {
  for e in z {
    const c = e
    print(val(c))
  }
}
function pIf(z: F32x4[], k: boolean) {
  for e in z {
    const c = if k { e } else { z[0] }
    print(val(c))
  }
}
function pCoal(z: F32x4[], k: boolean) {
  for e in z {
    const o = if k { null } else { e }
    print(val(o ?? e))
  }
}
function pRec(z: F32x4[]) {
  for e in z {
    const r: Got = { g: e }
    print(val(r.g))
  }
}
function pPair(z: F32x4[]) {
  for e, i in z {
    print(i)
    print(val(e))
  }
}
const z = [splatF32(1.5), splatF32(4.0)]
pCall(z)
pUnion(z)
pNested(z)
pHole(z)
print(val(pReturn(z)))
pLet(z)
pIf(z, true)
pIf(z, false)
pCoal(z, true)
pCoal(z, false)
pRec(z)
pPair(z)
