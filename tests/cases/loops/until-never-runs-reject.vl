// @check
// @error this range never runs: `5 until 2` counts up (step 1) from a start above its end — write `5 until 2 step -1` to count down, or swap the bounds
// @error this range never runs: `0 until 5 step -1` counts down (step -1) from a start below its end — write `0 until 5` to count up, or swap the bounds
// The direction rule (D1588) applies to `until` unchanged, spelled with the keyword the
// author wrote: a constant range whose step contradicts its direction never runs and is
// refused at the `until` token. The EMPTY half-open range `from == to` is NOT refused —
// it is the legal zero-trip case (until-empty.vl) — so only wrong-DIRECTION forms appear
// here, never `0 until 0`.
let a = 0
for i in 5 until 2 { a = a + i }
for i in 0 until 5 step -1 { a = a + i }
print(a)
