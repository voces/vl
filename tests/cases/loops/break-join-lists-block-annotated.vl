// @run
// @hint redundant type annotation: `r` is inferred as `i32[] | string[]`
// @hint redundant type annotation: `r` is inferred as `i32[] | f64[]`
// @hint redundant type annotation: `r` is inferred as `i32[] | f64[]`
// @log i
// @log 1
// @log false
// @log true
// @log 2
// @log f
// The exits of a labelled block join as an `if` joins its arms, here under an annotated binding:
// two list types are a union whose row the join registers (D14086), and `i32[]` beside
// `f64[]` stays apart rather than widening (D14087).
function h(a0: i32[], a1: string[], k: i32) {
  const r: i32[] | string[] = @out {
    if k == 0 { break @out a0 }
    a1
  }
  if r is string[] { print(r.length) } else { print("i") }
}
function g(a0: i32[], a1: f64[], k: i32) {
  const r: i32[] | f64[] = @out {
    if k == 0 { break @out a0 }
    a1
  }
  print(r is f64[])
}
function e(a0: i32[], a1: f64[], k: i32) {
  const r: i32[] | f64[] = @out {
    if k == 0 { break @out a0 }
    a1
  }
  if r is i32[] { print(r[0] + 1) } else { print("f") }
}
h([1, 2], ["a"], 0)
h([1, 2], ["a"], 1)
g([1, 2], [1.5], 0)
g([1, 2], [1.5], 1)
e([1, 2], [1.5], 0)
e([1, 2], [1.5], 1)
