// @log a
// @log 7
// @log a
// @log 7
// A binding whose initializer joins an arm that always exits with a bare `null` is the `null` type
// until a write fills it, as a binding of a bare `null` is (D3355). Its initializer still runs,
// for its exits and its effects, in a function and at module scope, and a record or list fill
// makes the join lower at that reference's `null`.
function first(n: i32) {
  const y = if n == 4 { return -7 } else { null }
  (y) ?? -1
}
function swapped(n: i32) {
  let y = if !(n == 4) { null } else { return -7 }
  y = 7
  y ?? -1
}
function effects(n: i32) {
  const y = if n == 4 { print("t") null } else { print("e") null }
  y ?? -1
}
function filled() {
  let y = if 1 > 0 { null } else { null }
  y = 7
  y ?? -1
}
type A = { a: i32 }
function recFill(n: i32) {
  let w = if n == 2 { print("r") null } else { null }
  w = { a: 7 }
  print(w == null)
  print((w ?? { a: 9 }).a)
}
function listFill(n: i32) {
  let w = if n != 2 { return } else { null }
  w = [7]
  print((w ?? [9])[0])
}
function elseIfFill(n: i32) {
  let w = if n == 1 { return } else if n == 2 { print("x") null } else { return }
  w = [7]
  print((w ?? [9])[0])
}
function nestedTail(n: i32) {
  let w = if n > 0 { if n == 1 { print("a") null } else { null } } else { null }
  w = { a: 7 }
  print((w ?? { a: 9 }).a)
}
function matchTail(n: i32) {
  let w = if n > 0 { match n {
    1 => {
      print("a")
      null
    }
    _ => {
      null
    }
  } } else { return }
  w = { a: 7 }
  print((w ?? { a: 9 }).a)
}
const g = if 1 > 0 { print("m") null } else { null }
print(first(4))
print(first(2))
print(swapped(4))
print(swapped(2))
print(filled())
print(effects(4))
print(effects(2))
print(g ?? -1)
recFill(2)
listFill(2)
elseIfFill(2)
nestedTail(1)
matchTail(1)
