// @run
// @log 12
// @log 15
// @log 12
// @log 15
// @log 0
// @log 12
// @log 1
// @hint redundant type annotation: `two` is inferred as `i32`
// A `for` range's step may be any i32 EXPRESSION, not only a literal. It is evaluated ONCE,
// before the loop, into its own slot — so a call in the step position runs exactly once — and
// its SIGN picks the exit comparison at run time, which a constant step picks at compile time.
// A run-time `0` runs the body zero times: it advances nothing, which is the same answer a
// non-constant wrong-order range already gives (`docs/guide/soundness.md`).
let calls = 0

function two(): i32 {
  calls = calls + 1
  return 2
}

const n = 2
let a = 0
for i in 0 to 6 step n { a = a + i }
print(a)

const back = 0 - 1
let b = 0
for i in 5 to 1 step back { b = b + i }
print(b)

let c = 0
for i in 0 to 6 step n * 1 { c = c + i }
print(c)

let d = 0
for i in 5 to 1 step 0 - 1 { d = d + i }
print(d)

// A step that computes to zero advances nothing, so the body never runs.
const zero = 0
let e = 0
for i in 0 to 6 step zero { e = e + 1 }
print(e)

// The step call runs once, not once per iteration.
let f = 0
for i in 0 to 6 step two() { f = f + i }
print(f)
print(calls)
