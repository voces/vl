// @check
// @error this range never runs: `3 to 0` counts up (step 1) from a start above its end — write `3 to 0 step -1` to count down, or swap the bounds
// @error this range never runs: `3 to 0 step 2` counts up (step 2) from a start above its end — write `3 to 0 step -2` to count down, or swap the bounds
// @error this range never runs: `0 to 3 step -1` counts down (step -1) from a start below its end — write `0 to 3` to count up, or swap the bounds
// @error this range never runs: `0 to 6 step -2` counts down (step -2) from a start below its end — write `0 to 6 step 2` to count up, or swap the bounds
// @error this range never runs: `-1 to -5` counts up (step 1) from a start above its end — write `-1 to -5 step -1` to count down, or swap the bounds
// @error this range never runs: `3 to 0` counts up (step 1) from a start above its end — write `3 to 0 step -1` to count down, or swap the bounds
// D1588 (glean VL-038). A range whose bounds and step are all compile-time
// constants and whose direction contradicts its step never produces an iteration.
// Every spelling of that contradiction is refused at the `to` token, in a function
// as at module scope, and parens do not hide it. The quoted range is spelled the
// way the author wrote it — a defaulted step is not printed back — while the
// parenthetical always names the step that decided the direction.
let a = 0
for i in 3 to 0 { a = a + i }
for i in 3 to 0 step 2 { a = a + i }
for i in 0 to 3 step -1 { a = a + i }
for i in 0 to 6 step -2 { a = a + i }
for i in -1 to -5 { a = a + i }
function inFn(): i32 {
  let b = 0
  for i in (3) to (0) { b = b + i }
  return b
}
print(a + inFn())
