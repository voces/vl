// @run
// @log 1
// @log 2
// @log 3
// @log 11
// @log 12
// @log 5
// @log 1
// @log 2
// @log 3
// @log 15
// A `for-in` walk is LIVE: the iterable is evaluated once, but its `len` and backing are
// re-read every step, so an element pushed mid-walk is visited and a pop shortens the walk.
// Only a body with no call — which cannot push or pop through any alias — reads the header
// once before the loop; this body calls `push`, so it keeps the per-step read.
const xs = [1, 2, 3]
for x in xs {
  if x < 3 { xs.push(x + 10) }
  print(x)
}
print(xs.length)
const zs = [1, 2, 3, 4, 5]
for z in zs {
  print(z)
  zs.pop()
}
// An element STORE does not move the header, so a call-free body walks one backing and
// sees its own writes.
const ys: u8[] = [1, 2, 3, 4]
let k = 0
let s = 0
for y in ys {
  if k + 1 < ys.length { ys[k + 1] = y * 2 }
  s += y
  k += 1
}
print(s)
