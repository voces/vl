// @run
// @log 10
// @log 20
// @log 30
// The motivating case (veldt's `0 to N - 1` voxel loops): `0 until a.length` walks a
// 3-element array's indices 0,1,2 and stops — the three elements, no out-of-bounds read.
// The inclusive `0 to a.length` reaches index 3 and traps. Prefer `for x in a`; this is
// the numeric-index spelling for when the index itself is needed.
const a = [10, 20, 30]
for i in 0 until a.length { print(a[i]) }
