// D2052: a value `if` whose arm runs statements before its value lowers in any position, not only
// as a binding initializer, and a jump in such an arm reaches its loop or function.
function id(v: i32) { v }

function argument(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    acc = acc + id(if i == 1 { if n == 2 { continue }; 5 } else { 7 })
  }
  return acc
}

function operand(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    acc = acc + (0 + if i == 1 { if n == 2 { break }; 5 } else { 7 })
  }
  return acc
}

function array(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const xs = [if i == 1 { if n == 2 { return 1000 + acc }; 5 } else { 7 }]
    acc = acc + xs[0]
  }
  return acc
}

function field(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const o = { x: if i == 1 { if n == 2 { print(9) }; 5 } else { 7 } }
    acc = acc + o.x
  }
  return acc
}

function coalesce(n: i32) {
  let acc = 0
  const m: { [string]: i32 } = Map()
  for i in 0 to 3 {
    acc = acc + (m["k"] ?? if i == 1 { if n == 2 { continue }; 5 } else { 7 })
  }
  return acc
}

function and(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    if i >= 0 && (if i == 1 { if n == 2 { break }; 5 } else { 7 }) > 0 {
      acc = acc + 1
    }
  }
  return acc
}

function or(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    if i < 0 || (if i == 1 { if n == 2 { continue }; 5 } else { 7 }) > 0 {
      acc = acc + 1
    }
  }
  return acc
}

function assign(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    let w = 0
    w = if i == 1 { if n == 2 { return 1000 + acc }; 5 } else { 7 }
    acc = acc + w
  }
  return acc
}

function cond(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    if (if i == 1 { if n == 2 { print(9) }; 5 } else { 7 }) > 6 {
      acc = acc + 1
    }
  }
  return acc
}

function effects(n: i32) {
  let c = 0
  let k = 0
  while (if k < 2 { k = k + 1; true } else { false }) { c = c + 1 }
  print(c)
  print(id(if n == 1 { c = c + 5; c } else { 0 }))
  const s = 1 + (if n == 1 { c = c + 1; c } else { 0 })
  print(s)
  const p = { x: if n == 1 { c = c * 2; c } else { 0 } }
  print(p.x)
  print(
    if n == 1 {
      if c > 0 { c = c + 100 }
      while c > 200 { c = c - 1 }
      c + 1
    } else {
      0
    },
  )
  print(
    if n == 1 {
      c = c + 1
      ((q: i32) => q + 1)(c)
    } else {
      0
    },
  )
  print(if n == 1 { c = c + 1; "s" + "t" } else { "u" })
}

print(argument(2))
print(operand(2))
print(array(2))
print(field(2))
print(coalesce(2))
print(and(2))
print(or(2))
print(assign(2))
print(cond(2))
effects(1)
