// @run
// @log 6
// @log 4
// `until` is the half-open range: `0 until 4` counts 0,1,2,3 — four trips, sum 6. The
// inclusive twin `0 to 4` runs five times (for-sum.vl); `until` stops BEFORE the bound,
// so `0 until n` makes exactly `n` iterations — the clean length-driven count.
let s = 0
for i in 0 until 4 { s = s + i }
print(s)
let c = 0
for i in 0 until 4 { c = c + 1 }
print(c)
