// @check
// @error operator '+' is not defined for i64 | boolean and i32
// A LOOP HEAD NARROWS A BARE NAME AND NOT A PROPERTY PATH, and this pins the second half.
// `while-body-is-guard-narrows.vl` is the same guard over a bare `x` and runs.
//
// The reason is aliasing, not the guard's shape: a path fact can be falsified inside the
// body through any alias of the object, and the loop re-tests only the head. The two halves
// spell one rule — the checker's `checkWhileStmtNode` filters on `isPathKey`, the emitter
// holds `narrowBareIdentOnly` across the same push — so neither can narrow what the other
// does not. The `if` spelling of this body does narrow, which is where the asymmetry is.
type O = { v: i64 | boolean }
function f(o: O) {
  while o.v is i64 {
    print(o.v + 1)
    o.v = true
  }
}
f({ v: 3 })
