// @run
// @log 2
// @log 2
// @log 2
// @log 3
// @log 2
// @log 6
// D12181: a range whose next step would leave the i32 range ends there, rather than wrapping
// to the other end and looping again: an inclusive bound at the edge, a wider step, the
// negative twin, a dynamic step, a runtime bound, and a runtime bound the 4x unroll serves.
let a = 0
for i in 2147483646 to 2147483647 {
  a = a + 1
  if a > 5 { break }
}
print(a)
let b = 0
for i in 2147483644 to 2147483647 step 2 {
  b = b + 1
  if b > 5 { break }
}
print(b)
let c = 0
for i in -2147483647 to -2147483648 step -1 {
  c = c + 1
  if c > 5 { break }
}
print(c)
let d = 0
function stepBy(st: i32) {
  for i in 2147483640 to 2147483647 step st {
    d = d + 1
    if d > 5 { break }
  }
}
stepBy(3)
print(d)
let e = 0
function upTo(lo: i32, hi: i32) {
  for i in lo to hi { e = e + 1 }
}
upTo(2147483646, 2147483647)
print(e)
let f = 0
function upTo2(lo: i32, hi: i32) {
  for i in lo to hi { f = f + 1 }
}
upTo2(2147483642, 2147483647)
print(f)
