// @run
// @log 40
// @log 30
// @log 20
// @log 10
// The hoist caches the HEADER, never the index, so an index that is not the
// induction variable is served unchanged — `3 - i` walks the list backwards and
// each read still gets its own element through the same cached `len`.
import { Buffer, loadU8 } from "std:buffer"

const xs: u8[] = [10, 20, 30, 40]
const b = Buffer(8)
let i = 0
while i < 4 {
  __store_i8__(b.base + i, xs[3 - i])
  i = i + 1
}
print(b.loadU8(0))
print(b.loadU8(1))
print(b.loadU8(2))
print(b.loadU8(3))
