// @run
// @log 2
// @log 3
// @log 2.5
// @log 1.5
// @log s
// @log t
// @log 4
// @log 5
// @log 7
// @log 8
// @log 1.5
// @log s
// @log 9
// @log u
// @hint redundant type annotation: `c2` is inferred as `() => i32`
// @hint redundant type annotation: `f2` is inferred as `f64`
// @hint redundant type annotation: `s2` is inferred as `string`
// @hint redundant type annotation: `i2` is inferred as `i32`
// @hint redundant type annotation: `r2` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `u2` is inferred as `f64 | string`
// @hint redundant type annotation: `n2` is inferred as `i32 | string`
// A labelled block's value is the join of its tail and every `break @L v` that leaves it, the
// same join a value `if` takes, and the block's result binding is stored at that type: an i32,
// an f64, a string, a closure over a block local, a record, and a union of two break values of
// different types. Each block is written un-annotated and with its type declared; the hints
// name the type the checker joined, which the declared twin repeats.

type P = { x: i32, y: i32 }

function main(k: i32) {
  const c = @B {
    const w = k + 1
    const inner = () => w
    inner
  }
  const c2: () => i32 = @B {
    const w = k + 2
    const inner = () => w
    inner
  }
  print(c())
  print(c2())
  const f = @F {
    if k > 5 { break @F 0.5 }
    2.5
  }
  const f2: f64 = @F {
    if k > 5 { break @F 0.5 }
    1.5
  }
  print(f)
  print(f2)
  const s = @S {
    if k > 5 { break @S "x" }
    "s"
  }
  const s2: string = @S {
    if k > 5 { break @S "x" }
    "t"
  }
  print(s)
  print(s2)
  const i = @I {
    if k > 5 { break @I 0 }
    k + 3
  }
  const i2: i32 = @I {
    if k > 5 { break @I 0 }
    k + 4
  }
  print(i)
  print(i2)
  const r = @R {
    if k > 5 { break @R { x: 0, y: 0 } }
    { x: k + 6, y: 1 }
  }
  const r2: P = @R {
    if k > 5 { break @R { x: 0, y: 0 } }
    { x: k + 7, y: 1 }
  }
  print(r.x)
  print(r2.x)
  const u = @U {
    if k > 0 { break @U 1.5 }
    if k > -5 { break @U "s" }
    "z"
  }
  const u2: f64 | string = @U {
    if k > 5 { break @U 1.5 }
    if k > 0 { break @U "s" }
    "z"
  }
  if u is f64 { print(u) }
  if u2 is string { print(u2) }
  const n = @N {
    if k > 0 { break @N k + 8 }
    "z"
  }
  const n2: i32 | string = @N {
    if k > 5 { break @N 0 }
    if k > 0 { break @N "u" }
    "z"
  }
  if n is i32 { print(n) }
  if n2 is string { print(n2) }
}
main(1)
