// @check
// @error-at 12:18 inside labelled block `@B`: write `break @B` to leave the block, or label the loop and write `break @L`
// @error-at 13:18 inside labelled block `@B`: label the loop and write `continue @L` to continue it
// @error-at 23:17 inside labelled block `@C`: write `break @C` to leave the block, or label the loop and write `break @L`
// @error-at 32:15 inside labelled block `@D`: write `break @D` to leave the block, or label the loop and write `break @L`
// A labelled block is left only by its name (the E0695 rule): an unlabelled `break`, `break v`
// or `continue` whose way to its loop crosses a labelled block is refused with both spellings
// that mean it, and so is a bare `break` inside a block with no loop around it.
function f(n: i32) {
  let s = 0
  for i in 0 until n {
    @B {
      if i == 1 { break }
      if i == 2 { continue }
      s = s + i
    }
  }
  s
}
print(f(3))
function g(n: i32) {
  const v = while true {
    @C {
      if n > 1 { break n }
    }
    break 0
  }
  v
}
print(g(3))
function h(n: i32) {
  @D {
    if n > 1 { break }
  }
  n
}
print(h(3))
