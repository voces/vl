// @log 2
// A walk over a list of maps, its loop variable delivered at each position: a call, a union
// parameter (not for a nullable closure: D17380), a nested call, an interpolation hole, a return, a binding, an `if` arm, a `??`
// operand and a record-literal field; then an index pair (Q58 position sweep).
function mk(x: i32) {
  const m: {[string]: i32} = Map()
  m["x"] = x
  return m
}
function val(m: {[string]: i32}) { return m["x"] ?? -1 }
type Got = { g: {[string]: i32} }
function pass(x: {[string]: i32}) { return x }
function su(w: {[string]: i32} | string) {
  if w is string { return w }
  return "u\{val(w)}"
}
function pCall(z: {[string]: i32}[]) {
  for e in z { print(val(e)) }
}
function pUnion(z: {[string]: i32}[]) {
  for e in z { print(su(e)) }
}
function pNested(z: {[string]: i32}[]) {
  for e in z { print(val(pass(e))) }
}
function pHole(z: {[string]: i32}[]) {
  for e in z { print("w\{val(e)}") }
}
function pReturn(z: {[string]: i32}[]) {
  for e in z { return e }
  return z[0]
}
function pLet(z: {[string]: i32}[]) {
  for e in z {
    const c = e
    print(val(c))
  }
}
function pIf(z: {[string]: i32}[], k: boolean) {
  for e in z {
    const c = if k { e } else { z[0] }
    print(val(c))
  }
}
function pCoal(z: {[string]: i32}[], k: boolean) {
  for e in z {
    const o = if k { null } else { e }
    print(val(o ?? e))
  }
}
function pRec(z: {[string]: i32}[]) {
  for e in z {
    const r: Got = { g: e }
    print(val(r.g))
  }
}
function pPair(z: {[string]: i32}[]) {
  for e, i in z {
    print(i)
    print(val(e))
  }
}
const z = [mk(1), mk(2)]
pCall(z)
pUnion(z)
pNested(z)
pHole(z)
print(val(pReturn(z)))
pLet(z)
pIf(z, true)
pIf(z, false)
pCoal(z, true)
pCoal(z, false)
pRec(z)
pPair(z)
