// @run
// @log 6
// @log 501
// @log 3
// @log 3
// @log 60
// @log 12
// A hoisted loop receiver reads as the loop's own read would: a local, a global and a record
// field each hoisted, and a receiver rebound or pushed to in the loop read afresh.
type Bag = { xs: i32[] }

const gs = [10, 20, 30]

function sum(xs: i32[]) {
  let s = 0
  let i = 0
  while i < xs.length {
    s = s + xs[i]
    i = i + 1
  }
  return s
}

function rebound(xs: i32[]) {
  let ys = xs
  let s = 0
  let i = 0
  while i < ys.length {
    s = s + ys[i]
    if i == 0 { ys = [100, 200, 300] }
    i = i + 1
  }
  return s
}

function grows(xs: i32[]) {
  let i = 0
  while i < xs.length && i < 5 {
    if i == 0 { xs.push(9) }
    i = i + 1
  }
  return i
}

function text(s: string) {
  let n = 0
  let i = 0
  while i < s.length {
    if s[i] == 'a' { n = n + 1 }
    i = i + 1
  }
  return n
}

function global() {
  let s = 0
  let i = 0
  while i < gs.length {
    s = s + gs[i]
    i = i + 1
  }
  return s
}

function field(b: Bag) {
  let s = 0
  let i = 0
  while i < b.xs.length {
    s = s + b.xs[i]
    i = i + 1
  }
  return s
}

print(sum([1, 2, 3]))
print(rebound([1, 2, 3]))
print(grows([1, 2]))
print(text("banana"))
print(global())
print(field({ xs: [3, 4, 5] }))
