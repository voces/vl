// @run
// @log 6
// @log 12
// @log 7
// @log ab
// A list literal walked by `for`: constant elements, a variable element, nested lists and strings.
function consts() {
  let s = 0
  for x in [1, 2, 3] { s = s + x }
  return s
}
function vars(n: i32) {
  let s = 0
  for x in [n, n * 2, 3] { s = s + x }
  return s
}
function nested() {
  let s = 0
  for xs in [[1, 2], [3]] { s = s + xs.length + xs[0] }
  return s
}
function strs() {
  let r = ""
  for t in ["a", "b"] { r = r + t }
  return r
}
print(consts())
print(vars(3))
print(nested())
print(strs())
