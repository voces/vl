// @run
// @log 6
// @log 12
// @log 7
// @log ab
// @log 101
// @hint Intentionally-unused parameter `_v` (leading `_` marks it unused)
// A list literal walked by `for`: constant, variable, nested, string, empty and record elements,
// one literal walked twice and inside another walk, and a literal in a generic instance.
function consts() {
  let s = 0
  for x in [1, 2, 3] { s = s + x }
  return s
}
function vars(n: i32) {
  let s = 0
  for x in [n, n * 2, 3] { s = s + x }
  return s
}
function nested() {
  let s = 0
  for xs in [[1, 2], [3]] { s = s + xs.length + xs[0] }
  return s
}
function strs() {
  let r = ""
  for t in ["a", "b"] { r = r + t }
  return r
}
print(consts())
print(vars(3))
print(nested())
print(strs())
function empty() {
  let s = 0
  for y in [] { s = s + 1 }
  return s
}
function recs() {
  let s = 0
  for p in [{ a: 1 }, { a: 2 }] { s = s + p.a }
  return s
}
function twice() {
  let s = 0
  for x in [1, 2] { s = s + x }
  for x in [1, 2] { s = s + x }
  return s
}
function nested2() {
  let s = 0
  for x in [1, 2] {
    for y in [10, 20] { s = s + x * y }
  }
  return s
}
function gen<T>(_v: T) {
  let n = 0
  for x in [1.5] { n = n + 1 }
  return n
}
print(empty() + recs() + twice() + nested2() + gen(1) + gen("s"))
