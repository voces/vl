// @run
// @log 18
// @log 18
// @log 0
// @log 9
// @log 6
// @log 5
// @log 3
// @log 50
// A range loop whose step is no literal reads it once into its third slot and picks its exit
// test by the step's sign: up, down, zero, `until`, a `continue`, a call, the i32 edge, the start.
function sumBy(lo: i32, hi: i32, st: i32) {
  let s = 0
  for i in lo to hi step st { s = s + i }
  return s
}
function untilBy(lo: i32, hi: i32, st: i32) {
  let s = 0
  for i in lo until hi step st { s = s + i }
  return s
}
function skipOdd(n: i32, st: i32) {
  let s = 0
  for i in 0 to n step st {
    if i % 2 == 1 { continue }
    s = s + i
  }
  return s
}
function stepOf(k: i32) { return k * 2 }
function viaCall(n: i32) {
  let c = 0
  for i in 0 to n step stepOf(1) { c = c + 1 }
  return c
}
function edge(st: i32) {
  let c = 0
  for i in 2147483640 to 2147483647 step st { c = c + 1 }
  return c
}
print(sumBy(0, 10, 3))
print(sumBy(10, 0, -4))
print(sumBy(0, 10, 0))
print(untilBy(0, 9, 3))
print(skipOdd(10, 3))
print(viaCall(9))
print(edge(3))
let t = 0
let st = 1
st = 5
for i in 0 to 20 step st { t = t + i }
print(t)
