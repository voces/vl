// @check
// @error-at 7:17 cannot assign string | i32 to 'x' of type i32
// @error-at 17:15 a `break` value must be a value, and this one has type void
// The type of a block or loop is the join of its `break` values and its tail. Two exits of
// different types join to a union, which a narrower destination refuses; an exit with a
// `void` "value" is refused where it is written.
function f(n: i32) {
  const x: i32 = @B {
    if n > 0 { break @B "positive" }
    n
  }
  x
}
print(f(3))

function g(n: i32) {
  const y = @B {
    if n > 0 { break @B print(n) }
    1
  }
  y
}
print(g(1))
