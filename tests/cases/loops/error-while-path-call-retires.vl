// @check
// @error 'o.v' was narrowed by a guard, but the call to 'clr' on line 19 can write it — re-test 'o.v' after the call
// SOUNDNESS (must-error): THE CALL CHANNEL IS WHAT MAKES A LOOP-BODY PATH NARROWING SAFE, and
// it is the half `while-body-path-guard-narrows.vl` cannot show by running.
//
// A path fact is keyed by a string over an object any number of names can reach, so the one
// way to falsify it without writing through the guarded spelling is a call that reaches the
// same object. `noteCallInvalidations` retires the narrowing at that call, and the read after
// it is then at the declared type — the refusal below. It is the same channel that closed the
// hole the loop's old restriction was justified by, and the `if` spelling of this program is
// this same diagnostic.
//
// Remove the retirement and this file compiles: `o.v` reads unboxed on the second iteration
// after `clr` put a `boolean` there. That is the cell D1845's close had to serve, not avoid.
type O = { v: i64 | boolean }
function clr(p: O) { p.v = true }
function f(o: O) {
  while o.v is i64 {
    clr(o)
    print(o.v + 1)
  }
}
f({ v: 3 })
