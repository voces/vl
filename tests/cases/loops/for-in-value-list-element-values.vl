// Walks over lists of `f32` and of `F32x4` lists: the first, the last, then an empty list; each
// element list read at its length and its first slot.
import { F32x4, splatF32 } from "std:simd"

function f32s(z: f32[][]) {
  for l in z {
    print(l.length)
    if l.length > 0 { print(l[0]) }
  }
  print("end")
}
function vecs(z: F32x4[][]) {
  for l in z {
    print(l.length)
    if l.length > 0 { print(l[0].y) }
  }
  print("end")
}
f32s([[1.5], [], [2.5, 4.0]])
f32s([])
vecs([[splatF32(1.0)], [], [splatF32(2.0), splatF32(3.0)]])
vecs([])
