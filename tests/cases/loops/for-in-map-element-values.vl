// @run
// @log 1
// @log 2
// @log 3
// @log end
// @log end
// @log 1
// @log null
// @log 3
// @log end
// @log end
// Walks over a list of maps and a list of nullable maps: the first, a null where the element
// type has one, the last, then an empty list; each element read through a map lookup.
function mk(x: i32) {
  const m: {[string]: i32} = Map()
  m["x"] = x
  return m
}
function maps(z: {[string]: i32}[]) {
  for m in z { print(m["x"] ?? -1) }
  print("end")
}
function nulMaps(z: ({[string]: i32} | null)[]) {
  for m in z {
    if m == null { print("null") } else { print(m["x"] ?? -1) }
  }
  print("end")
}
maps([mk(1), mk(2), mk(3)])
maps([])
nulMaps([mk(1), null, mk(3)])
nulMaps([])
