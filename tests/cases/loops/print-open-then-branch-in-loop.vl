// @log false
// @log false
// @log 4
// A loop that branches (continue, break) after a nullable print of a valued if: the print's opened
// blocks are closed before the branch, so each branch counts only the loop's own frames.
function g(a: string | null, b: string | null) {
  let i = 0
  while i < 10 {
    print(if i % 2 == 0 { a } else { b })
    i = i + 1
    if i == 3 { continue }
    if i > 4 { break }
  }
  print(i)
}
function h(a: boolean | null) {
  let n = 0
  while true {
    print(if n < 2 { null } else { a })
    n = n + 1
    if n == 4 { break }
  }
  print(n)
}
g("x", null)
h(false)
