// @run
// @log 4
// @log 4
// @log 1
// @log 1
// @log 4
// @log 0
// @log 0
// D1588's LEGAL NEIGHBOURS — every range the direction rule must leave alone.
// Ascending; the descending spelling that already worked (`step -1`); equal
// bounds, which run exactly once in BOTH directions (the rule fires on `from >
// to` / `from < to`, never on `from == to`); a descending multi-step; and the two
// NON-CONSTANT wrong-order forms, which still run zero times and say nothing.
// That last pair is the runtime contract, deliberately untouched: `for i in lo to
// hi` with `hi < lo` is how every "iterate a possibly-empty span" idiom is spelled.
let up = 0
for i in 0 to 3 { up = up + 1 }
print(up)
let down = 0
for i in 3 to 0 step -1 { down = down + 1 }
print(down)
let same = 0
for i in 3 to 3 { same = same + 1 }
print(same)
let sameDown = 0
for i in 3 to 3 step -1 { sameDown = sameDown + 1 }
print(sameDown)
let by2 = 0
for i in 6 to 0 step -2 { by2 = by2 + 1 }
print(by2)
let lo = 9
lo = 3
let hi = 1
hi = 0
let dyn = 0
for i in lo to hi { dyn = dyn + 1 }
print(dyn)
const clo = 3
const chi = 0
let cdyn = 0
for i in clo to chi { cdyn = cdyn + 1 }
print(cdyn)
