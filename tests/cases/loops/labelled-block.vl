// @run
// @log 111
// @log 11
// @log 0
// @log 102
// @log 3
// A labelled block `B: { … }` runs its body once and is left only by name, `break :B`; a jump
// out of it to a loop names that loop. The owner's 2026-09-29 rulings (DECISIONS.md, "Labels
// are marked at the exit", and its E0695 amendment).

// Nested blocks: `break :C` leaves only the inner one.
function f(n: i32) {
  let r = 0
  B: {
    if n > 3 { break :B }
    r = r + 10
    C: {
      if n > 1 { break :C }
      r = r + 100
    }
    r = r + 1
  }
  r
}
print(f(0))
print(f(2))
print(f(5))

// Inside a loop: `continue :outer` continues the loop, `break :B` leaves the block, and
// `break :outer` leaves the loop.
function g() {
  let s = 0
  outer: for i in 0 until 5 {
    B: {
      if i == 1 { continue :outer }
      if i == 3 { break :outer }
      if i == 2 { break :B }
      s = s + 100
    }
    s = s + i
  }
  s
}
print(g())

// A block as the first statement of a function body is a block, not an object literal.
function h(n: i32) {
  B: {
    if n > 0 { break :B }
    print(0)
  }
  n
}
print(h(3))
