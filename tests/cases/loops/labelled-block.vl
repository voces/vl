// @run
// @log 111
// @log 11
// @log 0
// @log 102
// @log 3
// A labelled block `B: { … }` runs its body once; `break :B` leaves it, a bare `break` leaves
// the innermost loop or block, and a bare `continue` passes through a block to the loop around
// it. The owner's 2026-09-29 ruling (DECISIONS.md, "Labels are marked at the exit").

// Nested blocks: `break :C` leaves only the inner one.
function f(n: i32) {
  let r = 0
  B: {
    if n > 3 { break :B }
    r = r + 10
    C: {
      if n > 1 { break :C }
      r = r + 100
    }
    r = r + 1
  }
  r
}
print(f(0))
print(f(2))
print(f(5))

// Inside a loop: `continue` continues the loop, a bare `break` leaves the block, and
// `break :outer` leaves the loop.
function g() {
  let s = 0
  outer: for i in 0 until 5 {
    B: {
      if i == 1 { continue }
      if i == 3 { break :outer }
      if i == 2 { break }
      s = s + 100
    }
    s = s + i
  }
  s
}
print(g())

// A block as the first statement of a function body is a block, not an object literal.
function h(n: i32) {
  B: {
    if n > 0 { break :B }
    print(0)
  }
  n
}
print(h(3))
