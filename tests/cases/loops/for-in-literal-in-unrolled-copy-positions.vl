// @run
// @log 22
// @log a0,b0,a1,b1
// @log 8
// @log 4
// @log 10
// @log 15
// A walk over a list literal inside a fully unrolled range loop's copy, the literal reading the
// copy's constant: integers, strings, a break, floats, a pair walk and a start body.
import { join } from "std:str"

function ints() {
  let s = 0
  for r in 0 until 2 {
    for x in [r, r + 10] { s = s + x }
  }
  return s
}
function strs() {
  const out: string[] = []
  for r in 0 until 2 {
    for w in ["a", "b"] { out.push(w + "\{r}") }
  }
  return out.join(",")
}
function withBreak() {
  let s = 0
  for r in 0 until 3 {
    for x in [r, r * 2, r * 3] {
      if x > 3 { break }
      s = s + x
    }
  }
  return s
}
function floats() {
  let s = 0.0
  for r in 0 until 2 {
    for x in [1.5, r as f64] { s = s + x }
  }
  return s
}
function pairs() {
  let s = 0
  for r in 0 until 2 {
    for i, x in [r, 5] { s = s + i * x }
  }
  return s
}
print(ints())
print(strs())
print(withBreak())
print(floats())
print(pairs())
let t = 0
for r in 0 until 2 {
  for x in [r, 7] { t = t + x }
}
print(t)
