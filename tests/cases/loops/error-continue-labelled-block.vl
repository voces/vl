// @check
// @error-at 9:28 `continue :B` names a labelled block, and only a loop can continue; use `break :B` to leave the block
// @error-at 12:11 `break :C` names no enclosing loop or labelled block
// A labelled block runs once, so there is nothing for `continue :B` to continue; and a label
// names only a loop or block the jump is inside.
function f(n: i32) {
  let s = 0
  for i in 0 until n {
    B: {
      if i == 2 { continue :B }
      s = s + i
    }
    break :C
  }
  s
}
print(f(3))
