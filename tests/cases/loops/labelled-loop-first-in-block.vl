// @log 7
// A labelled loop may be the first statement of any block: `{ B: while … }` and
// `{ B: for … }` are blocks, because no object-literal value starts with a loop
// keyword. `{ B: 5 }` and `{ a: 1 }` stay object literals, `{ a }` stays a block (D1998).

// The filed witness: the labelled loop opens an `else` arm.
function f(c: boolean): i32 {
  let n = 0
  if c {
    n = 1
  } else {
    B: while true {
      n = 2
      break B
    }
  }
  n
}
print(f(false))

// A function body opening with a labelled `for`.
let m = 0
function g(): i32 {
  L: for i in 0 to 3 {
    m = m + i + 1
    if i == 1 { break L }
  }
  m
}
print(g())

// A bare block, a nested block and a lambda body.
let n = 0
{
  B: while true {
    n = 2
    break B
  }
}
print(n)
n = 0
{
  {
    B: while true {
      n = 2
      break B
    }
  }
}
print(n)
n = 0
const h = () => {
  B: while true {
    n = 2
    break B
  }
  n
}
print(h())

// The same inside an `if`-expression arm in a function.
function k(c: boolean): i32 {
  let q = 0
  const r = if c {
    1
  } else {
    B: while true {
      q = 2
      break B
    }
    q
  }
  r
}
print(k(false))

// Controls: a key-value pair still opens an object literal, a bare name still a block.
const a = 7
function obj() { a: 1 }
print(obj().a)
function labelish() { B: 5 }
print(labelish().B)
function shorthand() { a }
print(shorthand())
