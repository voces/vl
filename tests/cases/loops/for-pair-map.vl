// @run
// @log a
// @log 1
// @log b
// @log 2
// @log x
// @log one
// @log y
// @log two
// @log p
// @log 7
// @log q
// @log 8
// @log 4
// Over a MAP the second name is the VALUE at the key just bound — the entries form
// (`collections-design.md` C2.4) — read off the same cursor and the same pinned receiver the
// key was read from, so the map is evaluated once and a deleted entry is invisible to both.
const counts: {[string]: i32} = Map()
counts.set("a", 1)
counts.set("b", 2)
for k, v in counts {
  print(k)
  print(v)
}

const words: {[string]: string} = Map()
words.set("x", "one")
words.set("y", "two")
for k, v in words {
  print(k)
  print(v)
}

type P = { n: i32 }
const recs: {[string]: P} = Map()
recs.set("p", { n: 7 })
recs.set("q", { n: 8 })
for k, r in recs {
  print(k)
  print(r.n)
}

// A deleted entry is invisible to the pair walk exactly as it is to the key walk.
const live: {[string]: i32} = Map()
live.set("a", 1)
live.set("b", 2)
live.set("c", 3)
live.delete("b")
let total = 0
for k, v in live { total = total + v }
print(total)
