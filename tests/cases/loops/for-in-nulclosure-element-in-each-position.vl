// @log 20
// A walk over a list of nullable closures, its loop variable delivered at each position: a call, a union
// parameter, a nested call, an interpolation hole, a return, a binding, an `if` arm, a `??`
// operand and a record-literal field; then an index pair (Q58 position sweep).
function val(f: ((i32) => i32) | null) {
  return if f == null { -1 } else { f(10) }
}
type Got = { g: ((i32) => i32) | null }
function pass(x: ((i32) => i32) | null) { return x }
function su(w: ((i32) => i32) | null | string) {
  if w is string { return w }
  return "u\{val(w)}"
}
function pCall(z: (((i32) => i32) | null)[]) {
  for e in z { print(val(e)) }
}
function pUnion(z: (((i32) => i32) | null)[]) {
  for e in z { print(su(e)) }
}
function pNested(z: (((i32) => i32) | null)[]) {
  for e in z { print(val(pass(e))) }
}
function pHole(z: (((i32) => i32) | null)[]) {
  for e in z { print("w\{val(e)}") }
}
function pReturn(z: (((i32) => i32) | null)[]) {
  for e in z { return e }
  return z[0]
}
function pLet(z: (((i32) => i32) | null)[]) {
  for e in z {
    const c = e
    print(val(c))
  }
}
function pIf(z: (((i32) => i32) | null)[], k: boolean) {
  for e in z {
    const c = if k { e } else { z[0] }
    print(val(c))
  }
}
function pCoal(z: (((i32) => i32) | null)[], k: boolean) {
  for e in z {
    const o = if k { null } else { e }
    print(val(o ?? e))
  }
}
function pRec(z: (((i32) => i32) | null)[]) {
  for e in z {
    const r: Got = { g: e }
    print(val(r.g))
  }
}
function pPair(z: (((i32) => i32) | null)[]) {
  for e, i in z {
    print(i)
    print(val(e))
  }
}
const z: (((i32) => i32) | null)[] = [
  (x: i32) => x + 1,
  null,
  (x: i32) => x * 2,
]
pCall(z)
pUnion(z)
pNested(z)
pHole(z)
print(val(pReturn(z)))
pLet(z)
pIf(z, true)
pIf(z, false)
pCoal(z, true)
pCoal(z, false)
pRec(z)
pPair(z)
