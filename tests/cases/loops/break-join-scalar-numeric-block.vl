// @run
// @log true
// @log false
// The exits of a labelled block holding an `i32` and an `f64` join as `i32 | f64`, which `is`
// tells apart, where they were promoted to `f64` (D14087).
function h(a0: i32, a1: f64, k: i32) {
  const r = @out {
    if k == 0 { break @out a0 }
    a1
  }
  print(r is i32)
}
h(1, 1.5, 0)
h(1, 1.5, 1)
