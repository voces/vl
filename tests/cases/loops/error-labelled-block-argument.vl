// @check
// @error-at 7:12 a labelled block is a statement, not an argument: `B: { … }` carries no value (block values are not supported yet)
// A labelled block written as a named argument is refused by name whenever its braces plainly
// hold statements, an assignment included; `f(B: { b })` stays a shorthand object argument.
function id(x: i32) { x }
function f(o: { b: i32 }) { o.b }
let x = 0
print(id(B: { x = 1 }))
const b = 4
print(f(B: { b }))
