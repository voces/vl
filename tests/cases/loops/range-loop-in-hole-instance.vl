// A range loop inside a function instanced at its un-annotated or generic parameter: the loop
// variable indexes the parameter, joins an element read, guards a store, and nests (D16746).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function bump(xs) {
  for i in 0 until 2 { print(xs[i] + 1) }
}
function shift(xs) {
  for i in 0 to 1 { print(xs[0] + i) }
}
function fill(xs) {
  for i in 0 until xs.length { xs[i] = 5 }
  print(xs[0])
}
function show<T>(xs: T[]) {
  for i in 0 until xs.length step 1 { print(xs[i]) }
}
function call(xs) {
  for i in 0 until xs.length { print(xs[i](3)) }
}
function grid(xs) {
  @outer for i in 0 until 2 {
    for j in 0 until 2 {
      if j == 1 { continue @outer }
      print(xs[i] + j)
    }
  }
}
bump([1, 2])
shift([1, 2])
fill([1, 2])
show(["a", "b"])
call([inc0, half])
grid([10, 20])
