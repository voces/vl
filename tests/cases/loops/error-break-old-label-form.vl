// @check
// @error-at 11:24 labels are written `break :outer`; `break outer` would break with the value of `outer`, so write `break (outer)` for that
// @error-at 12:27 labels are written `continue :outer`; `continue` takes no value
// The pre-colon label spelling is refused with its fix: a label is marked at the exit since
// the owner's 2026-09-29 ruling, and `break x` breaks with the value of `x`.
// `scripts/codemods/break-label-colon.py` rewrites a file that still has it.
function f(n: i32) {
  let s = 0
  outer: while s < 10 {
    s = s + 1
    for i in 0 until 3 {
      if s == n { break outer }
      if i == 1 { continue outer }
    }
  }
  s
}
print(f(3))
