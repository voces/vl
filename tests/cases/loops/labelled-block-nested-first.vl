// @log 1
// A brace whose first statement is a labelled block that itself opens with a labelled block
// (or a bare block) holds statements, at every depth and in every body that tells a block from
// an object literal: a bare block, an `else` body, a function body and a lambda body (D3265).
function bare() {
  let n = 0
  {
    B: {
      C: {
        n = 2
        break :B
      }
    }
  }
  n
}
print(bare())
function elseBody(c: boolean) {
  let n = 0
  if c {
    n = 1
  } else {
    B: {
      C: {
        if c { break :B }
        n = 3
      }
    }
  }
  n
}
print(elseBody(false))
let m = 0
function fnBody() {
  B: {
    C: {
      m = 11
      break :B
    }
  }
}
fnBody()
print(m)
const lam = () => {
  B: {
    C: {
      D: {
        m = 12
        break :B
      }
    }
  }
}
lam()
print(m)
function innerBlock(c: boolean) {
  let n = 0
  if c {
    n = 1
  } else {
    B: {
      {
        const r = 13
        n = r
      }
      break :B
    }
  }
  n
}
print(innerBlock(false))
function deep() {
  let n = 0
  {
    A: {
      B: {
        C: {
          D: {
            n = 14
            break :A
          }
        }
      }
    }
  }
  n
}
print(deep())
{
  B: {
    C: {
      m = 15
      break :B
    }
  }
}
print(m)
function typeKey() { a: { type: 1 } }
print(typeKey().a.type)
