// @run
// @log 11
// @log null
// @log 20
// @log end
// @log end
// A walk over a list of nullable closures: the first, a null, the last, then an empty list; each
// element tested null and called.
function calls(z: (((i32) => i32) | null)[]) {
  for f in z {
    if f == null { print("null") } else { print(f(10)) }
  }
  print("end")
}
calls([(x: i32) => x + 1, null, (x: i32) => x * 2])
calls([])
