// @run
// @log 1
// @log 2
// @log u1
// @log u2
// @log 2
// @log 3
// @log v1
// @log v2
// @log w1
// @log w2
// @log 1
// @log 1
// @log 2
// @log 1
// @log 2
// @log 2
// @log 2
// @log 1
// @log 0
// @log 1
// @log 2
// @log 0 1
// @log 1 2
// A walk over `(boolean | null)[]`, its loop variable delivered at each position: a nullable and
// a union parameter, a nested call, a concatenation, an interpolation hole, a return, a binding,
// an `if` arm, a `??` operand and a record-literal field; then an index pair.
import { toString } from "std:fmt"

type Got = { g: boolean | null }
function nb(v: boolean | null) {
  if v == null { return 2 }
  return if v { 1 } else { 0 }
}
function su(w: boolean | null | string) {
  if w is string { return w }
  return "u" + toString(nb(w))
}
function inc(x: i32) { return x + 1 }
function pCall(z: (boolean | null)[]) {
  for e in z { print(nb(e)) }
}
function pUnion(z: (boolean | null)[]) {
  for e in z { print(su(e)) }
}
function pNested(z: (boolean | null)[]) {
  for e in z { print(inc(nb(e))) }
}
function pConcat(z: (boolean | null)[]) {
  for e in z { print("v" + toString(nb(e))) }
}
function pHole(z: (boolean | null)[]) {
  for e in z { print("w\{nb(e)}") }
}
function pReturn(z: (boolean | null)[]): boolean | null {
  for e in z { return e }
  return false
}
function pLet(z: (boolean | null)[]) {
  for e in z {
    const c = e
    print(nb(c))
  }
}
function pIf(z: (boolean | null)[], k: boolean) {
  for e in z {
    const c = if k { e } else { null }
    print(nb(c))
  }
}
function pCoal(z: (boolean | null)[]) {
  for e in z { print(nb(e ?? false)) }
}
function pRec(z: (boolean | null)[]) {
  for e in z {
    const r: Got = { g: e }
    print(nb(r.g))
  }
}
function pPair(z: (boolean | null)[]) {
  for e, i in z { print(toString(i) + " " + toString(nb(e))) }
}
const z: (boolean | null)[] = [true, null]
pCall(z)
pUnion(z)
pNested(z)
pConcat(z)
pHole(z)
print(nb(pReturn(z)))
pLet(z)
pIf(z, true)
pIf(z, false)
pCoal(z)
pRec(z)
pPair(z)
