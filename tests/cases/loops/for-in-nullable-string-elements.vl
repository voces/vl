// @run
// @log a
// @log nil
// @log b
// @log a
// @log null
// @log b
// @log a
// @log D
// @log b
// @log a
// @log nil
// @log a
// @log nil
// @hint redundant type annotation: `xs` is inferred as `string?[]`
// A `for x in xs` over a `(string | null)[]` — the string-ref NICHE list, whose backing IS a
// plain string list but whose element slot is `(ref null $aTypeIdx)`. `forInElemKind` is the
// one place that decides a loop variable's rep, and this shape fell through to
// `exprStringArray`'s NON-null `"str"`: the element read recovered `ref.as_non_null` and
// TRAPPED on the null element, and the loop var's `x != null` found no nullable rep to test,
// so the bare `null` reached `emitNullLitNode` unseeded (`bare null needs a struct-typed
// context`). BOTH with `vl check` rc 0.
//
// THE ORACLE IS THE INDEX SPELLING. `const e = xs[i]` in a `while` already yielded the niche
// correctly, so `for x in xs` must be observationally identical to it — including the
// UN-NARROWED `print(x)`, which prints `null` for a null exactly as `print(xs[i])` and
// `print(p)` over a `p: string | null` do. That parity is what this file pins; the narrowed
// spelling has no other working oracle to copy.
//
// `xs.push(null)` is here too because it is the same list's write side: the value seed
// (`pendingNulString`) and the string-push quad's nullable VALUE slot (`fnUsesNulStrPush`)
// ship together — the seed alone turns the loud reject into invalid wasm.
function narrowed(xs: (string | null)[]) {
  for x in xs {
    if x != null { print(x) } else { print("nil") }
  }
}

function raw(xs: (string | null)[]) {
  // An un-narrowed nullable-string print is a legal program: `print` has a nullable-string
  // arm that emits the literal text `null`.
  for x in xs { print(x) }
}

function coalesced(xs: (string | null)[]) {
  for x in xs { print(x ?? "D") }
}

function go() {
  const xs: (string | null)[] = ["a", null, "b"]
  narrowed(xs)
  raw(xs)
  coalesced(xs)

  // The write side: a bare `null` pushed onto the niche.
  const ys: (string | null)[] = ["a"]
  ys.push(null)
  narrowed(ys)
}
go()

// The SAME loop at MODULE scope, where the loop-var declaration used to be a hand-copied
// second version of the kind ladder that knew only the struct / string / f64 / i64 kinds.
const gs: (string | null)[] = ["a"]
gs.push(null)
for z in gs {
  if z != null { print(z) } else { print("nil") }
}
