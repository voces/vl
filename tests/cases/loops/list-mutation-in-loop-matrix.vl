// @log 98611505
// @log 953382538
// A loop that reads a list while the list changes under it, in each way it can: a push in the
// body, a call that pushes through an alias, a closure that pushes, a nested walk of the same
// list, a store to a field holding the list (directly and through an alias of the struct), a pop,
// and a rebinding. Each reads what the unhoisted, unrolled loop read: a list header is cached
// ahead of a loop, and a small body copied, only where none of these can happen.

function grow(ys: i32[]) {
  ys.push(99)
  ys[0] = ys[0] + 1000
}

function pushInBody() {
  const xs = [1, 2, 3, 4]
  let s = 0
  for i in 0 until xs.length {
    if i < 2 { xs.push(i * 10) }
    s = s * 31 + xs[i]
  }
  s * 100 + xs.length
}

function pushInWalk() {
  const xs = [1, 2, 3, 4]
  let s = 0
  for x in xs {
    if xs.length < 9 { xs.push(x + 5) }
    s = s * 31 + x
  }
  s * 100 + xs.length
}

function aliasCallPush() {
  const xs = [1, 2, 3, 4]
  const alias = xs
  let s = 0
  for i in 0 until xs.length {
    s = s * 31 + xs[0] + xs[i]
    if i == 1 { grow(alias) }
  }
  s * 100 + xs.length
}

function aliasCallWalk() {
  const xs = [1, 2, 3, 4]
  const alias = xs
  let s = 0
  let n = 0
  for x in xs {
    s = s * 31 + x + xs[0]
    n = n + 1
    if n == 2 { grow(alias) }
  }
  s * 100 + n
}

function closurePush() {
  const xs = [1, 2, 3, 4]
  const bump = () => {
    xs.push(7)
    xs[1] = 500
  }
  let s = 0
  for i in 0 until xs.length {
    s = s * 31 + xs[1] + xs[i]
    if i == 0 { bump() }
  }
  s * 100 + xs.length
}

function nestedSame() {
  const xs = [1, 2, 3, 4, 5]
  let s = 0
  for i in 0 until xs.length {
    for j in 0 until xs.length { s = s * 31 + xs[j] }
    xs[i] = xs[i] * 2 + i
  }
  s
}

function nestedPushOuter() {
  const xs = [1, 2, 3]
  let s = 0
  for i in 0 until 4 {
    for j in 0 until xs.length { s = s * 31 + xs[j] + j }
    for x in xs { s = s * 7 + x }
    xs.push(i * 3)
  }
  s * 100 + xs.length
}

function fieldReassigned() {
  const b = { xs: [1, 2, 3, 4, 5, 6], k: 0 }
  let s = 0
  for i in 0 until b.xs.length {
    s = s * 31 + b.xs[i]
    if i == 1 { b.xs = [100, 200, 300, 400, 500, 600, 700] }
  }
  s
}

function fieldReassignedByAlias() {
  const b = { xs: [1, 2, 3, 4, 5, 6], k: 0 }
  const c = b
  let s = 0
  for i in 0 until b.xs.length {
    s = s * 31 + b.xs[i]
    if i == 2 { c.xs = [100, 200, 300, 400, 500, 600] }
  }
  s
}

function fieldWalkReassigned() {
  const b = { xs: [1, 2, 3, 4, 5, 6], k: 0 }
  let s = 0
  for x in b.xs {
    s = s * 31 + x + b.xs.length
    b.xs = [9]
  }
  s
}

function sharedFields() {
  const l = [1, 2, 3, 4, 5, 6]
  const t = { xs: l, ys: l }
  let s = 0
  for i in 0 until t.xs.length {
    t.ys[i] = t.ys[i] * 10
    s = s * 31 + t.xs[i]
  }
  s
}

function fieldPushedByCall() {
  const b = { xs: [1, 2, 3, 4], k: 0 }
  let s = 0
  for i in 0 until b.xs.length {
    s = s * 31 + b.xs[0] + b.xs[i]
    if i == 1 { grow(b.xs) }
  }
  s * 100 + b.xs.length
}

function fieldInList() {
  const bs = [{ xs: [1, 2, 3, 4, 5], k: 0 }]
  let s = 0
  for i in 0 until bs[0].xs.length {
    s = s * 31 + bs[0].xs[i]
    if i == 0 { bs[0].xs = [10, 20, 30, 40, 50] }
  }
  s
}

function popInBody() {
  const xs = [1, 2, 3, 4, 5, 6]
  let s = 0
  for i in 0 until 6 {
    if i < xs.length { s = s * 31 + xs[i] }
    if i == 2 { xs.pop() ?? 0 }
  }
  s * 100 + xs.length
}

function rebound() {
  let ys = [1, 2, 3, 4, 5, 6]
  let s = 0
  let i = 0
  while i < ys.length {
    s = s * 31 + ys[i]
    if i == 1 { ys = [7, 8, 9, 10, 11, 12, 13] }
    i = i + 1
  }
  s
}

print(pushInBody())
print(pushInWalk())
print(aliasCallPush())
print(aliasCallWalk())
print(closurePush())
print(nestedSame())
print(nestedPushOuter())
print(fieldReassigned())
print(fieldReassignedByAlias())
print(fieldWalkReassigned())
print(sharedFields())
print(fieldPushedByCall())
print(fieldInList())
print(popInBody())
print(rebound())
