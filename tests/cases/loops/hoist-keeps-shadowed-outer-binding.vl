// @run
// @log 706
// @log 51
// @log 66
// @warning `xs` shadows the `xs` declared at 10:20 in this function; rename one if they are different values
// @warning `xs` shadows the `xs` declared at 32:24 in this function; rename one if they are different values
// A hoist row is keyed by the binding's declaration: a `let` or loop variable of the same
// spelling in the body is another binding and reads its own list, while the outer one keeps
// its cached header. An assignment to the outer binding still declines.
function shadowLet(xs: i32[], ys: i32[]) {
  let s = 0
  for i in 0 until xs.length {
    s = s + xs[i]
    if i == 1 {
      const xs = ys
      s = s + xs[0] * 100
    }
  }
  s
}

function rebound(xs: i32[], ys: i32[]) {
  let s = 0
  let a = xs
  for i in 0 until a.length {
    s = s + a[i]
    if i == 0 { a = ys }
  }
  s
}

function shadowLoopVar(xs: i32[], yss: i32[][]) {
  let s = 0
  for i in 0 until xs.length {
    s = s + xs[i]
    for xs in yss { s = s + xs[i] }
  }
  s
}

print(shadowLet([1, 2, 3], [7]))
print(rebound([1, 2, 3], [10, 20, 30, 40]))
print(shadowLoopVar([1, 2, 3], [[10, 20, 30]]))
