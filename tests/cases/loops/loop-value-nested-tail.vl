// @run
// @log 3
// @log 3
// @log 3
// @log 7
// @log done
// @log 3
// @log -1
// @log 900
// @log 20
// @log -5
// @log 2
// @log 0
// A loop value whose value is another loop or labelled block, in a function, arrow or match
// arm tail: the inner one becomes the outer's stored value, so its arms are walked for their
// locals like any value `if` (D3222).
let total = 0
function bump(v: i32) {
  total = total + v
  total
}
function tailTail(n: i32) {
  A: {
    B: { n + 1 }
  }
}
function loopInBlock(n: i32) {
  A: {
    while true { break n + 1 }
  }
}
function blockInLoop(n: i32) {
  while true { break B: { n + 1 } }
}
const step = (n: i32) => {
  Outer: {
    if n < 0 { break :Outer }
    Inner: {
      if n == 0 { break :Inner }
      bump(n)
    }
  }
}
function run(k: i32) {
  match k {
    1 => {
      A: {
        B: { k + 1 }
      }
    }
    _ => {}
  }
}
function deep(n: i32) {
  A: {
    B: {
      if n > 5 { break :A n * 100 }
      C: {
        if n == 0 { break :B -1 }
        while true { break n + 1 }
      }
    }
  }
}
const inFor = (n: i32) => for i in 0 until 3 { if i == n { break B: { C: { i * 10 } } } }
function arm(k: i32) {
  match k {
    1 => {
      A: {
        B: {
          C: { k + 1 }
        }
      }
    }
    _ => 0
  }
}
print(tailTail(2))
print(loopInBlock(2))
print(blockInLoop(2))
step(3)
step(0)
step(4)
print(total)
run(1)
print("done")
print(deep(2))
print(deep(0))
print(deep(9))
print(inFor(2) ?? -5)
print(inFor(7) ?? -5)
print(arm(1))
print(arm(3))
