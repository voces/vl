// @run
// @log a
// @log nil
// @log b
// @log a
// @log null
// @log b
// @log a
// @log D
// @log b
// @log a
// @log nil
// @log 1
// @log nil
// @log 2
// @log 1
// @log nil
// @log 2
// @log nil
// @log 3
// @log a
// @log nil
// @log 7
// @log nil
// @hint redundant type annotation: `xs` is inferred as `string?[]`
// @hint redundant type annotation: `rows` is inferred as `i32[]?[]`
// @hint redundant type annotation: `ps` is inferred as `{v: i32}?[]`
// A `for x in xs` over an array whose ELEMENT is a nullable NICHE. `forInElemKind` is the one
// place that decides a loop variable's rep, and it had a nullable arm for exactly one of the
// three niches (`nulstruct`, `(P | null)[]`). The other two fell through to their NON-null
// twin — `(string | null)[]` to `exprStringArray`'s `"str"`, `(i32[] | null)[]` to the plain
// inner `"list"` — with two consequences per rep and `vl check` rc 0 for both: the element
// read recovered `ref.as_non_null` and TRAPPED on the null element, and the loop var's
// `x != null` found no nullable rep to test, so the bare `null` reached `emitNullLitNode`
// unseeded (`bare null needs a struct-typed context`).
//
// THE ORACLE IS THE INDEX SPELLING. `const e = xs[i]` in a `while` already yielded the niche
// correctly, so `for x in xs` must be observationally identical to it — including the
// UN-NARROWED `print(x)`, which prints `null` for a null exactly as `print(xs[i])` and
// `print(p)` over a `p: string | null` do. That parity is what this file pins; the narrowed
// spelling has no other working oracle to copy.
//
// `xs.push(null)` is here too because it is the same list's write side: the value seed
// (`pendingNulString`) and the string-push quad's nullable VALUE slot (`fnUsesNulStrPush`)
// ship together — the seed alone turns the loud reject into invalid wasm.
//
// The MODULE-SCOPE loops at the bottom are the pin for the loop-var declaration having ONE
// home (`declareForInLocals`): the start function's walk was a hand-copied second version of
// the kind ladder that knew only the struct / string / f64 / i64 kinds, so a top-level `for`
// over any other ref-array element declared its `#l` temp at the wrong valtype.
type P = {v: i32}
function narrowed(xs: (string | null)[]) {
  for x in xs {
    if x != null { print(x) } else { print("nil") }
  }
}

function raw(xs: (string | null)[]) {
  // An un-narrowed nullable-string print is a legal program: `print` has a nullable-string
  // arm that emits the literal text `null`.
  for x in xs { print(x) }
}

function coalesced(xs: (string | null)[]) {
  for x in xs { print(x ?? "D") }
}

// The second niche: a `(i32[] | null)[]` — the element slot keeps the `| null` (the interned
// `rlElemNullable` bit), so the loop var is the kind-15 nullable list.
function rowsNarrowed(rows: (i32[] | null)[]) {
  for r in rows {
    if r != null { print(r[0]) } else { print("nil") }
  }
}

function go() {
  const xs: (string | null)[] = ["a", null, "b"]
  narrowed(xs)
  raw(xs)
  coalesced(xs)

  // The write side: a bare `null` pushed onto the niche.
  const ys: (string | null)[] = ["a"]
  ys.push(null)
  narrowed(ys)

  const rows: (i32[] | null)[] = [[1], null, [2]]
  rowsNarrowed(rows)
  rows.push(null)
  rows.push([3])
  rowsNarrowed(rows)
}
go()

// The SAME loops at MODULE scope.
const gs: (string | null)[] = ["a"]
gs.push(null)
for z in gs {
  if z != null { print(z) } else { print("nil") }
}
// A `(P | null)[]` at module scope — the third niche, whose loop var was already nullable but
// whose `#l` temp the module-scope copy of the ladder typed as a plain i32 list.
const ps: (P | null)[] = [{v: 7}, null]
for p in ps {
  if p != null { print(p.v) } else { print("nil") }
}
