// @run
// @log 3
// @log 0
// @log 8
// @log end
// @log end
// A walk over an `F32x4[]`: the first, the last, then an empty list; each lane read.
import { F32x4, splatF32 } from "std:simd"

function lanes(z: F32x4[]) {
  for v in z { print(v.x + v.w) }
  print("end")
}
lanes([splatF32(1.5), splatF32(-0.0), splatF32(4.0)])
lanes([])
