// Walks over lists of nullable lists, one per element kind: the first, a null, the last, then an
// empty list; each element read at its length or tested null. The last walk pushes onto the list
// it walks, and reaches the pushed elements, since the walk re-reads the list each step.
import { F32x4, splatF32 } from "std:simd"

type S = { v: i32 }
function nlen(n: i32) { print(n) }
function ints(z: (i32[] | null)[]) {
  for l in z {
    if l == null { print("null") } else { nlen(l.length) }
  }
  print("end")
}
function recs(z: (S[] | null)[]) {
  for l in z {
    if l == null { print("null") } else { print(l[0].v) }
  }
  print("end")
}
function strs(z: (string[] | null)[]) {
  for l in z {
    if l == null { print("null") } else { print(l[0]) }
  }
  print("end")
}
function f64s(z: (f64[] | null)[]) {
  for l in z {
    if l == null { print("null") } else { print(l[0]) }
  }
  print("end")
}
function f32s(z: (f32[] | null)[]) {
  for l in z {
    if l == null { print("null") } else { print(l[0]) }
  }
  print("end")
}
function i64s(z: (i64[] | null)[]) {
  for l in z {
    if l == null { print("null") } else { print(l[0]) }
  }
  print("end")
}
function vecs(z: (F32x4[] | null)[]) {
  for l in z {
    if l == null { print("null") } else { print(l[0].z) }
  }
  print("end")
}
function grows(z: (i32[] | null)[]) {
  for l in z {
    if l == null { print("null") } else { nlen(l.length) }
    if z.length < 5 { z.push([7, 8, 9]) }
  }
  print(z.length)
}
ints([[1], null, [2, 3]])
ints([])
recs([[{ v: 1 }], null, [{ v: 3 }]])
recs([])
strs([["a"], null, ["c"]])
strs([])
f64s([[1.5], null, [3.5]])
f64s([])
f32s([[1.25], null, [3.25]])
f32s([])
i64s([[10], null, [30]])
i64s([])
vecs([[splatF32(1.0)], null, [splatF32(3.0)]])
vecs([])
grows([[1], null])
