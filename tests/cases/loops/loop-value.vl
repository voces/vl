// Loops and labelled blocks carry values (the owner's 2026-09-29 ruling): a `break v` exits
// with `v`, a block's tail joins its `break` values, a loop that can run out adds `null`, and
// `while true` cannot run out. Every value prints, so a wrong one shows.
type Circle = { r: i32 }

// A block: tail value or `break :B v`.
function a(n: i32) {
  const x = B: {
    if n > 3 { break :B 100 }
    n * 2
  }
  x
}
print(a(1))
print(a(5))

// A `for` that can run out is `T | null`.
function b(xs: i32[]) {
  const found = for x in xs {
    if x > 10 { break x }
  }
  found ?? -1
}
print(b([1, 20, 30]))
print(b([1, 2]))

// `while true` cannot run out, so its value is plain `T`.
function c(n: i32) {
  let i = 0
  const v = while true {
    i = i + 1
    if i * i > n { break i }
  }
  v + 1000
}
print(c(50))

// A record value, both exits.
function d(n: i32) {
  const cc = B: {
    if n > 0 { break :B { r: n } }
    { r: 0 - n }
  }
  cc.r
}
print(d(3))
print(d(-4))

// Two exit types join to a union.
function e(n: i32) {
  const u = B: {
    if n > 0 { break :B n }
    "neg"
  }
  u
}
print(e(3))
print(e(-1))

// `break :outer v` from a nested loop, as the function's value.
function f(n: i32) {
  let i = 0
  outer: while i < 10 {
    i = i + 1
    for j in 0 until 5 {
      if i * j == n { break :outer i * 100 + j }
    }
  }
}
print(f(12) ?? -1)
print(f(1000) ?? -1)

// At the top level.
const top = B: {
  let k = 0
  while k < 5 { k = k + 1 }
  if k > 3 { break :B k * 10 }
  -1
}
print(top)

// In a generic, at two instances.
function firstOver<T>(xs: T[], p: (T) => boolean): T | null {
  for x in xs {
    if p(x) { break x }
  }
}
print(firstOver([1, 5, 9], (x: i32) => x > 3) ?? -1)
print(firstOver(["a", "bb", "ccc"], (s: string) => s.length > 1) ?? "none")

// A loop value inside another loop's value.
function nest(n: i32) {
  const out = O: for a in 0 until 10 {
    const inner = for b in 0 until 10 {
      if a * b == n { break b }
    }
    if inner != null { break :O a * 100 + inner }
  }
  out ?? -1
}
print(nest(12))
print(nest(97))

// A `break v` inside an if-expression arm.
function arm(n: i32) {
  let i = 0
  const r = while true {
    i = i + 1
    const y = if i == n { break i * 3 } else { i }
    if y > 100 { break -1 }
  }
  r
}
print(arm(4))

// A record from `while true`.
function st(n: i32) {
  let i = 0
  const c = while true {
    i = i + 1
    if i >= n { break { r: i } }
  }
  c.r
}
print(st(6))

// A string block as a function's value.
function sb(n: i32) {
  B: {
    if n == 0 { break :B "zero" }
    if n < 0 { break :B "neg" }
    "pos"
  }
}
print(sb(0))
print(sb(-3))
print(sb(3))

// A union from `while true` as a function's value.
function un(n: i32) {
  let i = 0
  while true {
    i = i + 1
    if i == n { break i }
    if i > 5 { break "many" }
  }
}
print(un(3))
print(un(9))

// f64 and boolean values.
function fl(n: i32) {
  const v = B: {
    if n > 0 { break :B 1.5 }
    2.25
  }
  v * 2.0
}
print(fl(1))
print(fl(0))
function bo(n: i32) {
  const v = for i in 0 until n {
    if i == 3 { break true }
  }
  v ?? false
}
print(bo(5))
print(bo(2))

// A discarded value: the loop is a statement and `break v` still runs `v`.
function disc(n: i32) {
  let side = 0
  for i in 0 until n {
    if i == 2 { break side + 100 }
    side = side + 1
  }
  side
}
print(disc(10))

// A generic block with a non-null value.
function pick<T>(p: T, q: T, n: i32): T {
  B: {
    if n > 0 { break :B p }
    q
  }
}
print(pick(1, 2, 1))
print(pick("x", "y", 0))
