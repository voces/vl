// @run
// @log x
// @log 1
// @log 2
// @log 3
// @log 7
// @log 9
// @log a
// @log 5
// @hint redundant type annotation: `xs` is inferred as `string[]`
// @hint redundant type annotation: `ys` is inferred as `({c: i32} | {s: i32})[]`
// @hint redundant type annotation: `ss` is inferred as `string[]`
// The three annotations the hints name are kept ON PURPOSE: they are what makes the
// loop-var reps of the two same-named loops explicit at a glance, which is the whole
// subject here.
// CONTRACT: a for-in loop variable's NAME is not its identity — two loops in one frame may
// share a loop-var name while binding different reps, or different unions, and each read
// resolves against the LIVE slot. The union-box loop var is the one storage class whose
// member set has to be recovered from its ITERABLE (a loop var has no `Param` and no
// `LetDecl` to read), so the iterable is pinned PER SLOT (`localLoopIter`) and
// `forInLoopVarUnionName` reads it through the same scope-resolved `declaredSlotOf` its own
// kind guard rides.
//
// The failure this pins is a first-match-by-name AST scan handing the SECOND loop's read the
// FIRST loop's iterable. Over a non-union iterable there was no member set to unbox through,
// so the narrowed read pushed the raw `(ref $uBox)` where the loop var's own valtype said the
// unboxed scalar: loud `emitProgram: field access but no struct type declared` for a ref-list
// iterable, and `vl check`-clean INVALID WASM for a box-VALUED map's `.values()`
// (`__print_i32__` applied to a struct ref). Over a union iterable of a DIFFERENT union it
// answered the WRONG member set — loud `emitProgram: narrowed receiver names no union
// variant`. All three spellings are below, at module scope and inside a function, because the
// two walks that reach the resolution are separate (`unionNameOfIdentSid`'s `FuncDecl`-body
// arm and its `startStmts` dual) and a fix in one leaves the other broken.
//
// Distinct names are the CONTROL that made this a name-keying defect rather than a missing
// union-box rep: renaming either loop var made every spelling correct.

type C = { c: i32 }
type S = { s: i32 }
type A = { a: i32 }
type B = { b: i32 }

// module scope: an i32-list loop var, then a same-named union-box list loop var
const xs: string[] = ["x"]
for v in xs { print(v) }
const ys: (C | S)[] = [{c: 1}, {s: 2}]
for v in ys {
  if v is C { print(v.c) } else { print(v.s) }
}

// module scope: a mono-map values loop var, then a same-named BOX-valued map loop var
const mono: {[string]: i32} = Map()
mono["k"] = 3
for v in mono.values() { print(v) }
const boxed: {[string]: i32 | null} = Map()
boxed["k"] = 7
for v in boxed.values() {
  if v != null { print(v) } else { print(0) }
}

// module scope: two same-named UNION-BOX loop vars over DIFFERENT unions — the name is
// shared, the member sets are not.
const zs: (A | B)[] = [{a: 9}]
for v in zs {
  if v is A { print(v.a) } else { print(v.b) }
}

// function scope: the same pair inside one FuncDecl body
function inFn() {
  const ss: string[] = ["a"]
  for v in ss { print(v) }
  const bs: {[string]: i32 | null} = Map()
  bs["k"] = 5
  for v in bs.values() {
    if v != null { print(v) } else { print(0) }
  }
}

inFn()
