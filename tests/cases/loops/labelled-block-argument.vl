// @run
// @log 2
// @log 1
// @log 4
// @log 5
// A labelled block is a call argument as written, `id(@B { … })`, since a label is its own token;
// `f(o: { b })` is the named argument `o` holding the object `{ b }`.
function id(x: i32) { x }
function f(o: { b: i32 }) { o.b }
let x = 0
print(
  id(
    @B {
      x = 1
      x + 1
    },
  ),
)
print(x)
const b = 4
print(f(o: { b: b }))
print(f(o: { b: 5 }))
