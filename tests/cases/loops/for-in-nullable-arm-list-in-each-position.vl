// @run
// @log 4
// @log -1
// @log u4
// @log u-1
// @log 5
// @log 0
// @log v4
// @log vn
// @log w4
// @log wn
// @log 4
// @log 4
// @log -1
// @log 4
// @log -1
// @log 4
// @log 9
// @log 4
// @log -1
// @log 4
// @log -1
// @log 0 4
// @log 1 -1
// A walk over `(Circle | null)[]`, with `Circle` a union arm, its loop variable delivered at each
// position: a nullable-arm and a union parameter, a nested call, a concatenation, an
// interpolation hole, a return, a binding, an `if` arm, a `??` operand, a record-literal field and
// a closure call; then an index pair.
import { toString } from "std:fmt"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Got = { c: Circle | null }
function rOf(w: Circle | null) { return if w == null { 0 - 1 } else { w.r } }
function su(w: Circle | null | string) {
  if w is string { return w }
  return "u" + toString(rOf(w))
}
function inc(x: i32) { return x + 1 }
function nm(w: Circle | null) {
  return if w == null { "n" } else { toString(w.r) }
}
function pCall(z: (Circle | null)[]) {
  for e in z { print(rOf(e)) }
}
function pUnion(z: (Circle | null)[]) {
  for e in z { print(su(e)) }
}
function pNested(z: (Circle | null)[]) {
  for e in z { print(inc(rOf(e))) }
}
function pConcat(z: (Circle | null)[]) {
  for e in z { print("v" + nm(e)) }
}
function pHole(z: (Circle | null)[]) {
  for e in z { print("w\{nm(e)}") }
}
function pReturn(z: (Circle | null)[]) {
  for e in z { return e }
  return null
}
function pBinding(z: (Circle | null)[]) {
  for e in z {
    const c = e
    print(rOf(c))
  }
}
function pIfArm(z: (Circle | null)[], k: i32) {
  for e in z {
    const c = if k > 0 { e } else { null }
    print(rOf(c))
  }
}
function pCoalesce(z: (Circle | null)[], d: Circle) {
  for e in z { print((e ?? d).r) }
}
function pField(z: (Circle | null)[]) {
  for e in z {
    const g: Got = { c: e }
    print(rOf(g.c))
  }
}
function pClosure(z: (Circle | null)[], rd: (Circle | null) => i32) {
  for e in z { print(rd(e)) }
}
function pPair(z: (Circle | null)[]) {
  for e, i in z { print(toString(i) + " " + toString(rOf(e))) }
}
const z: (Circle | null)[] = [{ r: 4 }, null]
pCall(z)
pUnion(z)
pNested(z)
pConcat(z)
pHole(z)
print(rOf(pReturn(z)))
pBinding(z)
pIfArm(z, 1)
pCoalesce(z, { r: 9 })
pField(z)
pClosure(z, (w: Circle | null): i32 => rOf(w))
pPair(z)
