// @run
// @hint redundant type annotation: `y` is inferred as `AB`
// @log 1
// @log 1
// @log 1
// @log a
// @log 4
// @log 4
// @log -7
// @log 3
// @log -1
// @log 3
// @log 1
// A loop value at the reps whose binding is not the plain emit spelling: a literal union (an
// i32 atom, which the softened `string` spelling would box), a map (D3255), and a nullable
// record or list bound un-annotated from an `if` whose FIRST arm exits (D3222).
type Rec = { r: i32 }
type AB = "a" | "b"
function lu1() {
  const o: "a" | "b" = "a"
  const y = @C { o }
  if y == "a" { 1 } else { 2 }
}
print(lu1())
function lu2() {
  const o: "a" | "b" = "a"
  const y = while true { break o }
  if y == "a" { 1 } else { 2 }
}
print(lu2())
function lu3() {
  const o: "a" | "b" = "a"
  const y: "a" | "b" = @C { o }
  if y == "a" { 1 } else { 2 }
}
print(lu3())
function pickA(): AB { "a" }
const top = for i in 0 until 3 {
  if i == 1 { break pickA() }
}
print(if top == "a" { "a" } else { "none" })

function mp(n: i32) {
  const o = Map<string, i32>()
  o["a"] = n
  const y = @C { o }
  y["a"] ?? -1
}
print(mp(4))
function mp2(n: i32) {
  const o = Map<string, i32>()
  o["a"] = n
  const y = while true { break o }
  y["a"] ?? -1
}
print(mp2(4))

function n1(n: i32, o: Rec | null) {
  const y = if n == 4 { return -7 } else { o }
  y?.r ?? -1
}
print(n1(4, { r: 3 }))
print(n1(2, { r: 3 }))
print(n1(2, null))
function n5(n: i32, o: i32[] | null) {
  const y = if n == 4 { return -7 } else { o }
  (y ?? [9]).length
}
print(n5(2, [1, 2, 3]))
print(n5(2, null))
