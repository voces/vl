// @run
// @log 3
// @log 4
// @log 5
// @log a!
// @log 2
// @log 01
// @log 195
// A `for` over an un-annotated parameter binds its variables as the typed loop does at each
// call's argument: an array's element and index, a map's key and value, a string's code point
// (D2197).
function total(xs) {
  let t = 0
  for x in xs { t = t + x }
  return t
}
const a = [1, 1, 1]
print(total(a))
function fsum(xs) {
  let t = 0.0
  for x in xs { t = t + x }
  return t
}
print(fsum([1.5, 2.5]))
type Shape = { w: i32 }
function ws(xs) {
  let t = 0
  for s in xs { t = t + s.w }
  return t
}
const shapes: Shape[] = [{ w: 2 }, { w: 3 }]
print(ws(shapes))
function keys(m) {
  let o = ""
  for k in m { o = o + k + "!" }
  return o
}
function vals(m) {
  let t = 0
  for k, x in m { t = t + x + 1 }
  return t
}
const mm: {[string]: i32} = Map()
mm["a"] = 1
print(keys(mm))
print(vals(mm))
function idx(xs) {
  let o = ""
  for x, i in xs { o = o + "\{i}" }
  return o
}
print(idx([7, 8]))
function codes(s) {
  let t = 0
  for c in s { t = t + c }
  return t
}
print(codes("ab"))
