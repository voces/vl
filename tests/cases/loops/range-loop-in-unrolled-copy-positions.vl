// @run
// @log 36
// @log 9
// @log 6
// @log 8
// @log 7
// @log 22
// @log 28
// @log 4
// A range loop inside an outer loop that is fully unrolled is built once per copy, each copy
// reusing its slots: constant and dynamic bounds, break, continue, a pushing nest whose list
// headers hoist once above it, three levels, and a start body.
function nestConst() {
  let s = 0
  for r in 0 until 2 {
    for k in 0 until 3 { s = s + r * 10 + k }
  }
  return s
}
function nestDyn(n: i32) {
  let s = 0
  for r in 0 until 2 {
    for k in 0 until n { s = s + r + k }
  }
  return s
}
function nestBreak(n: i32) {
  let s = 0
  for r in 0 until 2 {
    for k in 0 until n {
      if k > 2 { break }
      s = s + 1
    }
  }
  return s
}
function nestContinue(n: i32) {
  let s = 0
  for r in 0 until 2 {
    for k in 0 until n {
      if k % 2 == 0 { continue }
      s = s + k
    }
  }
  return s
}
function nestPush(a: f64[]): f64[] {
  const o: f64[] = []
  for c in 0 until 2 {
    for r in 0 until 2 {
      let s = 0.0
      for k in 0 until 2 { s = s + a[k * 2 + r] * a[c * 2 + k] }
      o.push(s)
    }
  }
  return o
}
function threeDeep() {
  let s = 0
  for a in 0 until 2 {
    for b in 0 until 2 {
      for c in 0 until 2 { s = s + a * 4 + b * 2 + c }
    }
  }
  return s
}
print(nestConst())
print(nestDyn(3))
print(nestBreak(10))
print(nestContinue(5))
const m = nestPush([1.0, 2.0, 3.0, 4.0])
print(m[0])
print(m[3])
print(threeDeep())
let t = 0
for r in 0 until 2 {
  for k in 0 until 2 { t = t + r + k }
}
print(t)
