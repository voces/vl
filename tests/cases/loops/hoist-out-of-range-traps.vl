// @trap array index out of bounds
// The cached `len` is the same bound the per-access read used, so the first
// index at or past it still traps. The outer loop raises the bound one at a
// time and prints it first, so the printed prefix names the round that
// trapped — 1, 2, 3, 4 and no 99. Only the inner loop is hoisted; `print` in
// the outer body declines that one.
// `tests/vl_hoist_trap_iteration_test.ts` pins the prefix, which `@trap` cannot.
import { Buffer } from "std:buffer"

const xs: u8[] = [1, 2, 3]
const b = Buffer(8)
let bound = 1
while bound <= 5 {
  print(bound)
  let i = 0
  while i < bound {
    __store_i8__(b.base + i, xs[i])
    i = i + 1
  }
  bound = bound + 1
}
print(99)
