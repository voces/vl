// @run
// @log 11
// @log 21
// @log 12
// @log 22
// @log 13
// @log 23
// Two lists indexed in one nest each get their own cached header, and the inner
// loop's rows close at its end so the outer walk keeps reading `a`. Every
// written byte is `a[i] + c[j]`, so a crossed header would show as a wrong sum.
import { Buffer, loadU8 } from "std:buffer"

const a: u8[] = [1, 2, 3]
const c: u8[] = [10, 20]
const b = Buffer(16)
let i = 0
while i < 3 {
  let j = 0
  while j < 2 {
    __store_i8__(b.base + i * 2 + j, a[i] + c[j])
    j = j + 1
  }
  i = i + 1
}
let k = 0
while k < 6 {
  print(b.loadU8(k))
  k = k + 1
}
