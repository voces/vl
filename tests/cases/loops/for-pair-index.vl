// @run
// @log 0
// @log 10
// @log 1
// @log 20
// @log 2
// @log 30
// @log 0
// @log a
// @log 1
// @log b
// @log 0
// @log 104
// @log 1
// @log 105
// @log 0
// @log 1
// @log 1
// @log 2
// @log 2
// @log 0
// @log a
// @log 1
// @log c
// @hint redundant type annotation: `ps` is inferred as `{a: i32}[]`
// A SECOND binding name is the companion the one-name form leaves implicit. Over a SEQUENCE
// that is the INDEX — a dense count of body executions, which is what makes it right for a
// string (whose cursor is a UTF-8 offset) as well as a list. The first name keeps exactly the
// meaning it has with no second name.
const xs = [10, 20, 30]
for v, i in xs {
  print(i)
  print(v)
}

const names = ["a", "b"]
for s, i in names {
  print(i)
  print(s)
}

for cp, i in "hi" {
  print(i)
  print(cp)
}

type P = { a: i32 }
const ps: P[] = [{ a: 1 }, { a: 2 }]
for p, i in ps {
  print(i)
  print(p.a)
}

// The index counts BODY runs, and a `continue` still consumes one: the indexes seen are
// 0 and 2, summing to 2.
let seen = 0
for v, i in xs {
  if v == 20 { continue }
  seen = seen + i
}
print(seen)

// A SET is a sequence here, not a map: its second name is the index, and it stays DENSE
// across a deleted element, which the cursor would not be.
const tags: {[string]: boolean} = Set()
tags.add("a")
tags.add("b")
tags.add("c")
tags.delete("b")
for t, i in tags {
  print(i)
  print(t)
}
