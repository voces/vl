// @run
// @log 0
// @log 0
// The half-open range is empty when `from == to`: `0 until 0` runs zero times — the
// clean empty case a numeric range should have, and the reason `until` is not refused
// there (until-never-runs-reject.vl). Walking an empty array's indices is the same
// zero-trip loop; the inclusive `0 to a.length` would instead read `a[0]` and trap.
let c = 0
for i in 0 until 0 { c = c + 1 }
print(c)
const a: i32[] = []
let d = 0
for i in 0 until a.length { d = d + 1 }
print(d)
