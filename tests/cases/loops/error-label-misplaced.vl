// @check
// @error-at 9:2 a label goes before `while`, `for` or `{`: `@x while …`, `@x { … }`
// @error-at 10:22 `break @nope` names no enclosing loop or labelled block
// @error-at 11:8 a label goes before `while`, `for` or `{`: `@y while …`, `@y { … }`
// @error-at 12:12 `@` starts a label and needs its name: `@outer while …`, `break @outer`
// @error-at 12:12 expected an expression but found ERROR
// A label goes only before `while`, `for` or `{`, and `@` needs its name; a jump names only a
// label it is inside.
function f(n: i32) {
  @x
  while n > 0 { break @nope }
  print(@y)
  const z = @ 1
}
