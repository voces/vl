// @run
// @log 5
// @log x
// @log ab
// @log yz
// @log 12
// @log 0.5
// @log 1.5
// @log true
// @log false
// @log 2
// @log 4
// @log 3
// @log 6
// @log 7
// @log 8
// @log cde
// @log ab
// A `for` over a literal of constants reads one module list built from its elements: string
// literals, module `const` strings, numbers and booleans, in a function, nested, beside a local's
// read (which builds the list instead), and at module scope.
const A = "ab"
const B = "cde"
function lens() {
  let n = 0
  for s in [A, B] { n = n + s.length }
  return n
}
function words() {
  for w in ["x", A, "yz"] { print(w) }
}
function nums(k: i32) {
  let t = 0
  for v in [1, 2, 3] { t = t + v * k }
  print(t)
  for f in [0.5, 1.5] { print(f) }
  for b in [true, false] { print(b) }
}
function nested() {
  for s in [A, B] {
    for c in [1, 2] { print(s.length * c) }
  }
}
function withLocal(k: i32) {
  const j = k + 1
  for v in [k, j] { print(v) }
}
print(lens())
words()
nums(2)
nested()
withLocal(7)
for s in [B, A] { print(s) }
