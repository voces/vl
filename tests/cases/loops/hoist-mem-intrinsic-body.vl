// @run
// @log 1
// @log 2
// @log 3
// @log 4
// A loop whose only call is a linear-memory intrinsic keeps the list-header
// hoist: `__store_i8__` touches no GC object, so `src`'s backing and `len` are
// loop-invariant and read once above the loop. The bytes read back prove each
// element landed at its own offset.
import { Buffer, loadU8 } from "std:buffer"

function copyIn(base: i32, src: u8[], n: i32) {
  let i = 0
  while i < n {
    __store_i8__(base + i, src[i])
    i = i + 1
  }
}

const a: u8[] = [1, 2, 3, 4]
const b = Buffer(8)
copyIn(b.base, a, 4)
print(b.loadU8(0))
print(b.loadU8(1))
print(b.loadU8(2))
print(b.loadU8(3))
