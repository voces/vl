// @run
// @log ccc
// @log 708
// @log int
// @log str
// @log bool
// @log 8
// @log neg
// @log 2.5
// @log 0.25
// @log 3000000000
// @log 2
// @log 2
// @log 1
// One program per path the control-flow batch claims: a string and a record loop value broken out
// of `while true`, an exhaustive `is` chain whose last link has no test, a boxed call result
// returned into a wider union, and value `if`s joined at f64, i64 and f32 lists.
type P = { x: i32, y: i32 }
function firstLong(xs: string[]) {
  let i = 0
  const r = while true {
    if xs[i].length > 2 { break xs[i] }
    i = i + 1
  }
  return r
}
function firstFar(ps: P[]) {
  let i = 0
  const r = while true {
    const p = ps[i]
    if p.x + p.y > 10 { break p }
    i = i + 1
  }
  return r.x * 100 + r.y
}
function kind(v: i32 | string | boolean) {
  if v is i32 { return "int" }
  else if v is string { return "str" }
  else if v is boolean { return "bool" }
}
function inner(n: i32): i32 | string {
  if n >= 0 { return n }
  return "neg"
}
function outer(n: i32): i32 | string | null { return inner(n * 2) }
function fl(c: boolean) {
  const xs = if c { [1.5, 2.5] } else { [0.25] }
  return xs[xs.length - 1]
}
function il(c: boolean) {
  const xs = if c { [3000000000, 1] } else { [2] }
  return xs[0]
}
function f3(c: boolean) {
  const a: f32 = 1.5
  const b: f32 = 4.0
  const xs = if c { [a, b] } else { [b] }
  return xs.length
}
print(firstLong(["a", "bb", "ccc", "dddd"]))
print(firstFar([{ x: 1, y: 2 }, { x: 7, y: 8 }, { x: 9, y: 9 }]))
print(kind(3))
print(kind("s"))
print(kind(true))
print(outer(4))
print(outer(-1))
print(fl(true))
print(fl(false))
print(il(true))
print(il(false))
print(f3(true))
print(f3(false))
