// @run
// @hint redundant type annotation: `z` is inferred as `({r: i32} | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `first` is inferred as `i32` — remove it to lean on inference
// @log 4
// @log -1
// @log 4
// D3096: a walk over `(Circle | null)[]`, with `Circle` a union arm, binds the nullable arm.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const z: (Circle | null)[] = [{ r: 4 }, null]
for e in z {
  if e == null { print(0 - 1) } else { print(e.r) }
}
function first(xs: (Circle | null)[]): i32 {
  for e in xs {
    if e != null { return e.r }
  }
  return 0
}
print(first(z))
