// @check
// @error-at 6:4 an `if` or `match` whose first arm always exits cannot yet hold a nullable list as the value of another's arm; bind it to a name first, or put the exiting arm last
// An `if` whose first arm always exits, standing as another construct's arm value with a
// nullable-list value, is refused with the spelling that works (D3222).
function h(n: i32, o: i32[] | null) {
  const y = if n > -100 {
    if n == 4 { return -7 } else { o }
  } else {
    o
  }
  (y ?? [0]).length
}
print(h(2, [1]))
