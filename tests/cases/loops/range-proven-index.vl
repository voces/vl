// @run
// @log 6
// @log 6
// @log 2
// @log 0
// @log 21
// @log 7
// A range whose top is the list's own length (`until xs.length`, `to xs.length - 1`) from a
// non-negative literal, over a call-free body, proves every `xs[i]` in bounds; the read
// skips the guard. Each spelling below must read the same elements the guarded read would.
function sums(xs: u8[]) {
  let a = 0
  for i in 0 until xs.length { a += xs[i] }
  let b = 0
  for i in 0 to xs.length - 1 { b += xs[i] }
  let c = 0
  for i in 1 until xs.length step 2 { c += xs[i] }
  [a, b, c]
}
const r = sums([1, 2, 3])
print(r[0])
print(r[1])
print(r[2])
const e = sums([])
print(e[0] + e[1] + e[2])
// nested proofs over one list, and a proven STORE
function grid(xs: i32[]) {
  let s = 0
  for i in 0 until xs.length {
    for j in 0 until xs.length { s += xs[i] * xs[j] }
  }
  s
}
print(grid([1, 2, 3]) - 15)
function fill(xs: i32[]) {
  for i in 0 until xs.length { xs[i] = i + 1 }
  xs[0] + xs[1] + xs[2] + 1
}
print(fill([0, 0, 0]))
