// @run
// @log 6
// @log 9
// @log 3
// @log 15
// @log 9
// @log 5
// @log 1
// @log 12
// @log 24
// @log 5432
// @log 24
// @log 531
// @log 10
// @log 1
// @log 345
// @log 314
// @log 4
// @log 3
// @log 333
// Bottom-tested loops (DECISIONS.md, "Loops are bottom-tested"): a `while` whose condition can
// be written twice, a range loop and a list or string walk each test once ahead of the loop and
// again after the step. Every row prints what the top-tested lowering printed, so `break`,
// `continue`, zero trips and a re-evaluated condition are unchanged.
let calls = 0
function below(i: i32, n: i32) {
  calls = calls + 1
  i < n
}

// while: break and continue at the first, a middle, and the last statement of the body.
function whileRows() {
  let i = 0
  let s = 0
  while i < 6 {
    if i == 4 { break }
    s = s + i
    i = i + 1
  }
  print(s)
  i = 0
  s = 0
  while i < 6 {
    i = i + 1
    if i % 2 == 0 { continue }
    s = s + i
  }
  print(s)
  i = 0
  s = 0
  while i < 6 {
    s = s + i
    i = i + 1
    if i == 3 { break }
  }
  print(s)
  i = 0
  s = 0
  while i < 6 {
    s = s + i
    i = i + 1
    if i > 0 { continue }
  }
  print(s)
  // zero trips: the condition is false on entry and the body never runs
  i = 9
  while i < 6 { print(999) }
  print(i)
  // a side-effecting condition is evaluated once per test: n + 1 times for n trips
  calls = 0
  i = 0
  while below(i, 4) { i = i + 1 }
  print(calls)
  calls = 0
  while below(i, 4) { i = i + 1 }
  print(calls)
}
whileRows()

// range: every position, both directions, `to` and `until`, a dynamic step, zero trips.
function rangeRows(n: i32, k: i32) {
  let s = 0
  for i in 0 until n {
    if i == 3 { break }
    s = s * 10 + i
  }
  print(s)
  s = 0
  for i in 0 to n {
    if i % 2 == 1 { continue }
    s = s * 10 + i
  }
  print(s)
  s = 0
  for i in n to 0 step -1 {
    s = s * 10 + i
    if i == 2 { break }
  }
  print(s)
  s = 0
  for i in 0 until n step k {
    s = s * 10 + i
    if i < 100 { continue }
    print(999)
  }
  print(s)
  s = 0
  for i in n until 0 step 0 - k { s = s * 10 + i }
  print(s)
  for _i in n until 0 { print(999) }
  // the bound is evaluated once, before the first test, however the body moves it
  let bound = n
  s = 0
  for i in 0 until bound {
    bound = 0
    s = s + i
  }
  print(s)
  calls = 0
  for _i in 0 until countedBound(n) { s = s + 1 }
  print(calls)
}
function countedBound(n: i32) {
  calls = calls + 1
  n
}
rangeRows(5, 2)

// for-in over a list and a string: continue, break, an empty walk, and a walk that sees a push.
function forInRows() {
  const xs = [3, 1, 4, 1, 5]
  let s = 0
  for x in xs {
    if x == 1 { continue }
    s = s * 10 + x
  }
  print(s)
  s = 0
  for x, k in xs {
    s = s * 10 + x
    if k == 2 { break }
  }
  print(s)
  const none: i32[] = []
  for x in none { print(x) }
  const grow = [1, 2]
  for x in grow {
    if grow.length < 4 { grow.push(x + 10) }
  }
  print(grow.length)
  let n = 0
  for c in "héllo" {
    if c == 108 { continue }
    n = n + 1
  }
  print(n)
  for _c in "" { print(999) }
}
forInRows()

// labelled break and continue across three nested loop kinds.
function labelled() {
  let s = 0
  outer: for i in 0 until 4 {
    let j = 0
    while j < 4 {
      j = j + 1
      for x in [1, 2, 3] {
        if x == 2 { continue outer }
        if i == 3 { break outer }
        s = s + i * 100 + j * 10 + x
      }
    }
  }
  print(s)
}
labelled()
