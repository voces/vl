// @run
// @hint redundant type annotation: `r` is inferred as `i32`
// @log 99
// @log 6
// @log 12
// D3222 — an if-expression arm that always exits hands the join nothing, so the `if` types
// as its other arm. Before, the exiting arm joined `void` in and the use was refused.
function r(n: i32): i32 {
  const y = if n == 4 { return 99 } else { n }
  y + 1
}
print(r(4))
print(r(5))

// The `break` twin, in a loop whose value the arm leaves with.
function s(n: i32) {
  let i = 0
  const v = while true {
    i = i + 1
    const y = if i == n { break i * 3 } else { i }
    if y > 100 { break -1 }
  }
  v
}
print(s(4))
