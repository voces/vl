// @run
// @hint redundant type annotation: `r` is inferred as `i32`
// @log 99
// @log 6
// @log 12
// @log 5
// @log 3
// @log 3
// @log 3
// @log 3
// @log 6
// @log 3
// D3222 — an if-expression or `match` arm that always exits hands the join nothing, so the
// value types as its other arms, at every rep. Before, the exiting arm joined `void` in and the
// use was refused.
type Rec = { r: i32 }
function r(n: i32): i32 {
  const y = if n == 4 { return 99 } else { n }
  y + 1
}
print(r(4))
print(r(5))

// The `break` twin, in a loop whose value the arm leaves with.
function s(n: i32) {
  let i = 0
  const v = while true {
    i = i + 1
    const y = if i == n { break i * 3 } else { i }
    if y > 100 { break -1 }
  }
  v
}
print(s(4))

// A record, annotated; a nullable; a union; a record and a string, un-annotated.
function w1(n: i32) {
  const y: Rec = if n == 4 { return -7 } else { { r: n } }
  return y.r
}
print(w1(5))
function w2(n: i32, o: i32 | null) {
  const y = if n == 4 { return -7 } else { o }
  return y ?? -1
}
print(w2(5, 3))
function w3(n: i32, o: i32 | string) {
  const y = if n == 4 { return -7 } else { o }
  if y is i32 { return y }
  return 0
}
print(w3(5, 3))
function w4(n: i32, c: Rec) {
  const y = if n == 4 { return -7 } else { c }
  return y.r
}
print(w4(5, { r: 3 }))
function w5(n: i32, t: string) {
  const y = if n == 4 { return -7 } else { t }
  return y.length
}
print(w5(5, "abc"))

// The `match` twin.
function m(k: i32) {
  let acc = 0
  for i in 0 until k {
    const y = match i {
      4 => {
        break
      }
      _ => i
    }
    acc = acc + y
  }
  acc
}
print(m(9))

// A `break` value that is a call to an un-annotated function is read, so the callee keeps
// its value (the unconsumed-result analysis counts it).
function side(x: i32) { x }
function b() {
  const v = @B { break @B side(3) }
  v
}
print(b())
