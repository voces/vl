// @log 5
// A labelled block whose own braces are empty or hold a lone name, `@C {}` or `@C { n }`, is a
// block wherever it stands, first in a body included, since a label is its own token; a body
// `{ a: { b: b } }` is an object (D3273).
let n = 0
function setN(v: i32) { n = v }
function fnBody() {
  @C {}
  n = 5
}
fnBody()
print(n)
n = 0
function fnShort() {
  @C { n }
  n = 5
}
fnShort()
print(n)
n = 0
function nested() {
  @B1 {
    @C { n }
    n = 5
  }
}
nested()
print(n)
n = 0
function deep() {
  @B1 {
    @B2 {
      @C {}
      setN(5)
    }
  }
}
deep()
print(n)
n = 0
const lam = () => {
  @C {}
  n = 5
}
lam()
print(n)
n = 0
function elseBody(c: boolean) {
  if c {
    n = 0
  } else {
    @C {}
    n = 5
  }
}
elseBody(false)
print(n)
n = 0
{
  @C { n }
  n = 5
}
print(n)
n = 0
function thenLabel() {
  @C {}
  @D { n = 5 }
}
thenLabel()
print(n)
const b = 5
function obj() { a: { b: b } }
print(obj().a.b)
