// Walks whose element values expose a wrong rep: `true`, `false` and `null` each printed and
// tested, and f32 values that f64 would keep differently, each printed and summed into an f32.
function nb(v: boolean | null) {
  if v == null { return 2 }
  return if v { 1 } else { 0 }
}
function bools(z: (boolean | null)[]) {
  for v in z {
    print(nb(v))
    print(v == null)
    print(v ?? false)
  }
}
function floats(z: f32[]) {
  let s: f32 = 0
  for v in z {
    print(v)
    s = s + v
  }
  print(s)
}
function bump(z: f32[]) {
  let s: f32 = 0
  for v in z {
    s = s + v
    if v > 1 { z.push(1) }
  }
  print(s)
  print(z.length)
}
const big: f32 = 3.4e38
const odd: f32 = 16777217.0
bools([true, false, null])
floats([0.1, -0.0, big, odd])
floats([odd, 1])
bump([0.1, 2])
for v in [true, null, false] { print(nb(v)) }
