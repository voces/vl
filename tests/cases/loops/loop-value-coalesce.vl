// @log 102
// @log 100
// @log 102
// @log 100
// @log 102
// @log 100
// @log 102
// @log 100
// @log 102
// @log 100
// A `??` written directly on a nullable loop value takes the loop's value or the default, for a
// record, a list and a map, from any loop kind and in a delivery position (D3370).
type P = { x: i32, y: string }
function mk(k: i32): Map<string, i32> {
  const m: Map<string, i32> = Map()
  m["a"] = k
  m
}
function rec(n: i32) {
  const v = (for x in [1, 2, 3] {
    if x == n { break { x: 100, y: "r0" } }
  })
    ?? { x: 102, y: "r2" }
  print(v.x)
}
function list(n: i32) {
  const v = (for i in 1 to 4 {
    if i == n { break [0, 100] }
  })
    ?? [0, 102]
  print(v[1])
}
function map(n: i32) {
  const v = (while true {
    if n == 2 { break mk(100) }
    break null
  })
    ?? mk(102)
  print(v["a"] ?? 0)
}
function field(n: i32) {
  const q = {
    p: (B: {
      if n == 2 { break :B { x: 100, y: "b" } }
      null
    })
      ?? { x: 102, y: "d" },
  }
  print(q.p.x)
}
function ret(n: i32): P {
  (for x in [1, 2, 3] {
    if x == n { break { x: 100, y: "r0" } }
  })
    ?? { x: 102, y: "r2" }
}
rec(0)
rec(2)
list(0)
list(2)
map(0)
map(2)
field(0)
field(2)
print(ret(0).x)
print(ret(2).x)
