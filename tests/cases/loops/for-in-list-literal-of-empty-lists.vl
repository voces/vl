// @run
// @log 0
// @log 0
// @log 0
// @log s
// @log 0
// @log 1
// A `for` over a list literal holding empty list literals: each inner list's element is settled at
// scope close as a binding's would be, or by the body's own write (D16273).
for x in [[]] { print(x.length) }
for x in [[], []] { print(x.length) }
for x in [[]] {
  x.push("s")
  print(x[0])
}
for x in [[], [1]] { print(x.length) }
