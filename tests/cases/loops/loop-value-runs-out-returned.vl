// @run
// @log b
// @log null
// @log b
// @log null
// @log c
// @log c
// A `for` loop value that runs out is the `null` of its `string | null`, returned directly or
// held by a binding a closure assigns (D3222; D3352 is the return's mechanism).
type AB = "a" | "b" | "c"
function pick(n: i32): AB {
  if n == 1 {
    "a"
  } else {
    if n == 2 { "b" } else { "c" }
  }
}
function hv(n: i32) {
  return for i in 0 until 4 {
    if i == n { break "b" }
  }
}
function annotated(n: i32): string | null {
  return for i in 0 until 4 {
    if i == n { break "b" }
  }
}
function captured(n: i32) {
  let y = for i in 0 until 4 {
    if i == n { break "b" }
  }
  const cf = () => {
    y = pick(3)
    0
  }
  cf()
  print(y)
}
print(hv(1))
print(hv(7))
print(annotated(1))
print(annotated(7))
captured(1)
captured(7)
