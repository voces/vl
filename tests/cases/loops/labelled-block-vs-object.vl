// @run
// @log 2
// @log 4
// @log 7
// @log 8
// A body `{ a: { … } }` stays an object literal when the inner braces hold an object or a key
// follows the inner `}`, and is a labelled block only when the inner braces plainly hold
// statements. The shorthand shapes (`{ a: { b } }`) are in `tests/vl_label_block_object_test.ts`,
// since `vl fmt` spells a shorthand key out.
const g4 = () => { a4: { d: 1 }, e: 2 }
print(g4().e)
const h4 = () => { a5: { f: { g: 4 } } }
print(h4().a5.f.g)
function g9(n: i32) {
  let r = 0
  @a10 { r = n }
  r
}
print(g9(7))
function g10(n: i32) {
  let r = 0
  @a11 {
    if n > 9 { break @a11 }
    r = n
  }
  r
}
print(g10(8))
