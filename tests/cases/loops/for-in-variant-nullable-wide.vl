// @run
// @log 3
// @log 2
// @log 4
// @log 3.5
// @log 7
// @log false
// Walks over variant records, nullable strings and records, and f64 and i64 lists.
type C = { r: i32 }
type Q = { s: i32 }
type Sh = C | Q
type P = { x: i32 }
function sumR(cs: C[]) {
  let t = 0
  for c in cs { t = t + c.r }
  return t
}
function nonNull(xs: (string | null)[]) {
  let n = 0
  for x in xs {
    if x != null { n = n + 1 }
  }
  return n
}
function nulRec(ps: (P | null)[]) {
  let n = 0
  for p in ps {
    if p != null { n = n + p.x }
  }
  return n
}
function sumF(fs: f64[]) {
  let t = 0.0
  for f in fs { t = t + f }
  return t
}
function sumL(ls: i64[]) {
  let t: i64 = 0
  for l in ls { t = t + l }
  return t
}
function isC(s: Sh) { return s is C }
print(sumR([{ r: 1 }, { r: 2 }]))
print(nonNull(["a", null, "b"]))
print(nulRec([{ x: 4 }, null]))
print(sumF([1.5, 2.0]))
print(sumL([3, 4]))
print(isC({ s: 1 }))
