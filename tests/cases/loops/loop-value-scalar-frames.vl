// @run
// @log 9
// @log 1
// @log 50
// @log 2
// @log 100
// @log 8
// @log 12
// @log 90
// A scalar loop value leaves its frame by `break v` or by a tail that assigns it, including a
// `break @Outer v` from a nested block and a `while true` left only by its `break v`.
function tailValue(n: i32) {
  const r = @B {
    if n < 0 { break @B 0 }
    n * 2
  }
  return r + 1
}
function onlyBreaks(n: i32) {
  const r = @B {
    if n > 5 { break @B 50 }
    break @B n
  }
  return r
}
function outerBreak(n: i32) {
  const r = @Outer {
    @Inner {
      if n == 0 { break @Outer 100 }
      if n == 1 { break @Inner }
    }
    n + 7
  }
  return r
}
function firstOver(xs: i32[], limit: i32) {
  let i = 0
  const r = while true {
    if xs[i] > limit { break xs[i] }
    i = i + 1
  }
  return r * 10
}
print(tailValue(4))
print(tailValue(-3))
print(onlyBreaks(9))
print(onlyBreaks(2))
print(outerBreak(0))
print(outerBreak(1))
print(outerBreak(5))
print(firstOver([1, 5, 9, 12], 6))
