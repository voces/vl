// @run
// @log 9
// @log 1
// @log 50
// @log 2
// @log 100
// @log 8
// @log 12
// @log 90
// @log 26
// @log 15000000000
// @log 0
// @log 7.5
// A scalar loop value leaves its frame by `break v` or by a tail that assigns it, including a
// `break @Outer v` from a nested block and a `while true` left only by its `break v`, whose value
// the loop body computes, at i32, i64 and f64.
function tailValue(n: i32) {
  const r = @B {
    if n < 0 { break @B 0 }
    n * 2
  }
  return r + 1
}
function onlyBreaks(n: i32) {
  const r = @B {
    if n > 5 { break @B 50 }
    break @B n
  }
  return r
}
function outerBreak(n: i32) {
  const r = @Outer {
    @Inner {
      if n == 0 { break @Outer 100 }
      if n == 1 { break @Inner }
    }
    n + 7
  }
  return r
}
function firstOver(xs: i32[], limit: i32) {
  let i = 0
  const r = while true {
    if xs[i] > limit { break xs[i] }
    i = i + 1
  }
  return r * 10
}
function sumPast(limit: i32) {
  let i = 0
  let acc = 0
  const r = while true {
    i = i + 1
    acc = acc + i * i
    if acc > limit { break acc - i }
  }
  return r
}
function wideBlock(n: i64) {
  const r = @W {
    if n < 0 { break @W 0 }
    n * 3000000000
  }
  return r
}
function halfUntil(x: f64) {
  let v = x
  const r = while true {
    v = v / 2.0
    if v < 1.0 { break v * 10.0 }
  }
  return r
}
print(tailValue(4))
print(tailValue(-3))
print(onlyBreaks(9))
print(onlyBreaks(2))
print(outerBreak(0))
print(outerBreak(1))
print(outerBreak(5))
print(firstOver([1, 5, 9, 12], 6))
print(sumPast(20))
print(wideBlock(5))
print(wideBlock(-2))
print(halfUntil(12.0))
