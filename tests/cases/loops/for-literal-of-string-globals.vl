// @run
// @log cd
// @log efg
// @log ab
// @log cd
// @log ab
// @log hi
// @log ab
// @log 7
// @log efg
// @log ab
// A `for` over a literal list of string globals hoists the list only where each element is one
// constant; a `const` built by concatenation, or a `let`, is read where the list is built. Each
// position is its own function, and the last runs at module scope.

const LIT = "ab"
const CAT = "c" + "d"
const CAT2 = "ef" + "g"
let MUT = "h"

function concatenated() {
  for s in [CAT, CAT2] { print(s) }
}
concatenated()

function mixed() {
  for s in [LIT, CAT, LIT] { print(s) }
}
mixed()

function reassigned() {
  MUT = MUT + "i"
  for s in [MUT, LIT] { print(s) }
}
reassigned()

function counted() {
  let n = 0
  for s in [CAT, CAT2, LIT] {
    for _c in s { n = n + 1 }
  }
  print(n)
}
counted()

for s in [CAT2, LIT] { print(s) }
