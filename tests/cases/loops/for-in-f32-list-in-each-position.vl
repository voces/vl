// @run
// @log 0.75
// @log 2
// @log u1.5
// @log u4
// @log 0.375
// @log 1
// @log v1.5
// @log v4
// @log w1.5
// @log w4
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// @log 0.75
// @log 2
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// @log 0 1.5
// @log 1 4
// A walk over `f32[]`, its loop variable delivered at each position: an `f32` and a union
// parameter, a nested call, a concatenation, an interpolation hole, a return, a binding, an
// `if` arm, a `??` operand and a record-literal field; then an index pair.
import { toString } from "std:fmt"

type Got = { g: f32 }
function half(v: f32) { return v / 2 }
function su(w: f32 | string) {
  if w is string { return w }
  return "u" + toString(w)
}
function pCall(z: f32[]) {
  for e in z { print(half(e)) }
}
function pUnion(z: f32[]) {
  for e in z { print(su(e)) }
}
function pNested(z: f32[]) {
  for e in z { print(half(half(e))) }
}
function pConcat(z: f32[]) {
  for e in z { print("v" + toString(e)) }
}
function pHole(z: f32[]) {
  for e in z { print("w\{e}") }
}
function pReturn(z: f32[]): f32 {
  for e in z { return e }
  return 0
}
function pLet(z: f32[]) {
  for e in z {
    const c = e
    print(c)
  }
}
function pIf(z: f32[], k: boolean) {
  for e in z {
    const c = if k { e } else { half(e) }
    print(c)
  }
}
function pCoal(z: f32[], k: boolean) {
  for e in z {
    const o = if k { null } else { e }
    print(o ?? e)
  }
}
function pRec(z: f32[]) {
  for e in z {
    const r: Got = { g: e }
    print(r.g)
  }
}
function pPair(z: f32[]) {
  for e, i in z { print(toString(i) + " " + toString(e)) }
}
const z: f32[] = [1.5, 4]
pCall(z)
pUnion(z)
pNested(z)
pConcat(z)
pHole(z)
print(pReturn(z))
pLet(z)
pIf(z, true)
pIf(z, false)
pCoal(z, true)
pCoal(z, false)
pRec(z)
pPair(z)
