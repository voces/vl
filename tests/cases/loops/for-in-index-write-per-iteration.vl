// @run
// @log 2
// @log 1
// @log 2
// @log 3
// @log 2
// @log 1
// @log 2
// @log 3
// @log 2
// @log 1
// @log 2
// @log 3
// @log 10
// @log 11
// @log 12
// @log 4
// A for-in's index is a fresh binding per iteration, as JS `for (let [k, v] of xs.entries())`
// (D2342): writing it changes this iteration's value only, and the next iteration's index is
// still the count of elements walked. A closure capturing it must not change what prints.
function plain() {
  for _v, k in [10, 20, 30, 40] {
    if k == 0 { k = 2 }
    print(k) // 2 1 2 3
  }
}
plain()

function captured() {
  const fs: (() => i32)[] = []
  for _v, k in [10, 20, 30, 40] {
    if k == 0 { k = 2 }
    fs.push(() => k)
    print(k) // 2 1 2 3
  }
  for f in fs {
    print(f()) // 2 1 2 3
  }
}
captured()

// A string walk's index too; the write does not skip code units.
function overString() {
  let n = 0
  for _c, k in "abc" {
    k = k + 10
    print(k) // 10 11 12
    n = n + 1
  }
  print(n + 1) // 4
}
overString()
