// @run
// @log a
// @log c
// @log <a>
// @log <c>
// @log a
// @log c
// @log c
// @log c
// @log B
// A labelled block whose value is a literal union binds through a result binding with no
// initializer; a program that also has a `match` asks that binding whether it widens an atom,
// which reads its missing initializer as none rather than trapping the compiler (D3222).
type AB = "a" | "b" | "c"
function pick(n: i32): AB {
  if n == 1 {
    "a"
  } else {
    if n == 2 { "b" } else { "c" }
  }
}
function idg<T>(x: T): T { x }
function name(x: AB) {
  match x {
    "a" => "A"
    "b" => "B"
    "c" => "C"
  }
}
function field(n: i32) {
  const y = B: {
    if n == 1 { break :B "a" }
    "c"
  }
  const w = { f: y }
  print(w.f)
}
function cat(n: i32) {
  const y = B: {
    if n == 1 { break :B "a" }
    "c"
  }
  print("<" + y + ">")
}
function generic(n: i32) {
  const y = B: {
    if n == 1 { break :B "a" }
    "c"
  }
  print(idg(y))
}
function captured(n: i32) {
  let y = B: {
    if n == 1 { break :B "a" }
    "c"
  }
  const cf = () => {
    y = pick(3)
    0
  }
  cf()
  print(y)
}
field(1)
field(2)
cat(1)
cat(2)
generic(1)
generic(2)
captured(1)
captured(2)
print(name(pick(2)))
