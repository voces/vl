// @run
// @log 12
// @log 10
// `step` composes with the half-open bound. Ascending: `0 until 8 step 2` visits
// 0,2,4,6 and stops before 8 (sum 12) — the inclusive `0 to 8 step 2` would also visit
// 8. Descending: `4 until 0 step -1` visits 4,3,2,1 and stops before 0 (sum 10).
let s = 0
for i in 0 until 8 step 2 { s = s + i }
print(s)
let d = 0
for i in 4 until 0 step -1 { d = d + i }
print(d)
