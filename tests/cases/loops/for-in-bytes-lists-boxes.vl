// @run
// @log 253
// @log xxx!
// @log 6
// @log true
// @log 3
// @log false
// @log 4
// Walks over a byte list, a list of byte or string lists, and a union list whose element is
// read as its box: each the plain walk legacy writes.
function sum(bs: u8[]) {
  let s = 0
  for b in bs { s = s + b }
  return s
}
function hex(bs: u8[]) {
  let out = ""
  for b in bs {
    out = out + "x"
    if b > 100 { out = out + "!" }
  }
  return out
}
function flat(rows: u8[][]) {
  let n = 0
  for r in rows { n = n + r.length }
  return n
}
function has(xs: string[][], k: string) {
  for row in xs {
    for x in row { if x == k { return true } }
  }
  return false
}
function count(xs: string[][]) {
  let n = 0
  for row in xs { n = n + row.length }
  return n
}
type A = { a: i32 }
type B = { b: i32 }
type U = A | B
function allA(us: U[]) {
  for u in us {
    if !(u is A) { return false }
  }
  return true
}
function sumA(us: U[]) {
  let s = 0
  for u in us {
    if u is A { s = s + u.a }
  }
  return s
}
const bs: u8[] = [1, 2, 250]
print(sum(bs))
print(hex(bs))
print(flat([bs, bs]))
print(has([["a"], ["b", "c"]], "c"))
print(count([["a"], ["b", "c"]]))
const us: U[] = [{ a: 1 }, { b: 2 }, { a: 3 }]
print(allA(us))
print(sumA(us))
