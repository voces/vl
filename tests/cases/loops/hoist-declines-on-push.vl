// @run
// @log 6
// @log 1
// @log 2
// @log 30
// @log 31
// A `.push` inside the loop declines the hoist: it moves both `len` and the
// backing, so a cached header would trap on the fourth read or return the
// zero-init slack. The loop reads two elements that did not exist when it
// started, which only a per-access header read can see.
import { Buffer, loadU8 } from "std:buffer"

const xs: u8[] = [1, 2]
const b = Buffer(8)
let i = 0
while i < 4 {
  __store_i8__(b.base + i, xs[i])
  xs.push(30 + i)
  i = i + 1
}
print(xs.length)
print(b.loadU8(0))
print(b.loadU8(1))
print(b.loadU8(2))
print(b.loadU8(3))
