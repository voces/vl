// A range loop with a variable trip count and a small call-free body runs four copies of its body
// per trip while four trips remain, then the rolled loop (DECISIONS.md, "Small variable-trip range
// loops are unrolled 4x"). Every row is order-sensitive and prints what the rolled loop printed:
// each trip count from 0 to 9, `until` and `to`, bounds at both ends of i32, `break`, `continue`,
// labels and `return` in every copy, a `let` per copy, stores a later copy reads, and each list rep.
type P = { x: i32, y: i32 }

function upTo(a: i32, b: i32): i32 {
  let s = 0
  for i in a until b { s = s * 31 + i + 1 }
  s
}

function through(a: i32, b: i32): i32 {
  let s = 0
  for i in a to b { s = s * 31 + i + 7 }
  s
}

function breakAt(n: i32, stop: i32): i32 {
  let s = 0
  for i in 0 until n {
    s = s * 31 + i
    if i == stop { break }
    s = s + 1
  }
  s
}

function skipEvery(n: i32, m: i32): i32 {
  let s = 0
  for i in 0 until n {
    if i % m == 1 { continue }
    s = s * 31 + i
  }
  s
}

function firstAt(xs: i32[], want: i32): i32 {
  for i in 0 until xs.length {
    if xs[i] == want { return i }
  }
  -1
}

function labelled(n: i32): i32 {
  let s = 0
  let r = 0
  outer: while r < 3 {
    r = r + 1
    for i in 0 until n {
      if i == 5 { continue outer }
      if i + r == 9 { break outer }
      s = s * 31 + i * r
    }
  }
  s
}

function withLet(xs: i32[]): i32 {
  let s = 0
  for i in 0 until xs.length {
    const t = xs[i] * 2 + i
    let u = t
    if u > 10 { u = u - 3 }
    s = s * 31 + u
  }
  s
}

function prefix(xs: i32[]): i32 {
  for i in 1 until xs.length { xs[i] = xs[i - 1] * 3 + xs[i] }
  xs[xs.length - 1]
}

function tail(xs: i32[]): i32 {
  let s = 0
  for i in 0 to xs.length - 1 { s = s * 31 + xs[xs.length - 1 - i] }
  s
}

function kinds(n: i32): i32 {
  const fs: f64[] = []
  const ls: i64[] = []
  const bs: u8[] = []
  const ps: P[] = []
  const ss: string[] = []
  for i in 0 until n {
    fs.push(i * 1.5)
    ls.push(i * 1000000007 as i64)
    bs.push(i * 37 as% u8)
    ps.push({ x: i, y: i * i })
    ss.push("ab")
  }
  let f = 0.0
  let l = 0 as i64
  let b = 0
  let p = 0
  let c = 0
  for i in 0 until n { f = f * 1.25 + fs[i] }
  for i in 0 until n { l = l * 3 + ls[i] }
  for i in 0 until n { b = b * 31 + bs[i] }
  for i in 0 until n { p = p * 31 + ps[i].x - ps[i].y }
  for i in 0 until n { c = c * 7 + ss[i].length + i }
  print(f)
  print(l)
  b + p + c
}

function chars(s: string): i32 {
  let h = 0
  for i in 0 until s.length { h = h * 31 + s[i] }
  h
}

function walk(xs: i32[]): i32 {
  let s = 0
  for x in xs { s = s * 31 + x }
  s
}

function walkBreak(xs: i32[], stop: i32): i32 {
  let s = 0
  for x in xs {
    if x == stop { break }
    s = s * 31 + x
  }
  s
}

function walkContinue(xs: i32[]): i32 {
  let s = 0
  for x in xs {
    if x % 3 == 0 { continue }
    s = s * 31 + x
  }
  s
}

function walkFind(xs: i32[], want: i32): i32 {
  let n = 0
  for x in xs {
    if x == want { return n }
    n = n + 1
  }
  -1
}

function walkStore(xs: i32[]): i32 {
  let n = 0
  for x in xs {
    if n + 1 < xs.length { xs[n + 1] = xs[n + 1] + x }
    n = n + 1
  }
  xs[xs.length - 1]
}

function walkKinds(n: i32): i32 {
  const ps: P[] = []
  const ss: string[] = []
  const ns: (string | null)[] = []
  const fs: f64[] = []
  for i in 0 until n {
    ps.push({ x: i, y: 2 * i })
    ss.push("x")
    if i % 2 == 0 { ns.push(null) } else { ns.push("ab") }
    fs.push(i * 0.5)
  }
  let a = 0
  let b = 0
  let c = 0
  let d = 0.0
  for p in ps { a = a * 31 + p.x + p.y }
  for t in ss { b = b * 31 + t.length }
  for u in ns { if u == null { c = c * 3 } else { c = c * 3 + u.length } }
  for f in fs { d = d * 1.5 + f }
  print(d)
  a + b + c
}

function walkPair(xs: i32[]): i32 {
  let s = 0
  for x, i in xs { s = s * 31 + x * i }
  s
}

let row = ""
for n in 0 until 10 { row = "\{row}\{upTo(0, n)}," }
print(row)
row = ""
for n in -1 until 9 { row = "\{row}\{through(0, n)}," }
print(row)
print(upTo(-6, 3))
print(upTo(2147483640, 2147483647))
print(through(2147483639, 2147483646))
row = ""
for k in 0 until 6 { row = "\{row}\{upTo(-2147483647 - 1, -2147483647 - 1 + k)}," }
print(row)
row = ""
for stop in 0 until 10 { row = "\{row}\{breakAt(9, stop)}," }
print(row)
row = ""
for m in 2 until 6 { row = "\{row}\{skipEvery(11, m)}," }
print(row)
const hay = [5, 3, 8, 1, 9, 2, 7, 4, 6]
row = ""
for w in 1 until 11 { row = "\{row}\{firstAt(hay, w)}," }
print(row)
print(labelled(9))
print(labelled(4))
print(withLet([1, 9, 2, 8, 3, 7, 4]))
print(prefix([1, 2, 3, 4, 5, 6, 7, 8, 9]))
print(prefix([4, 1]))
print(tail([1, 2, 3, 4, 5, 6]))
print(kinds(7))
print(chars("partial unroll"))
row = ""
for n in 0 until 10 {
  const xs: i32[] = []
  for i in 0 until n { xs.push(i * 5 + 1) }
  row = "\{row}\{walk(xs)},"
}
print(row)
const ws = [4, 8, 15, 16, 23, 42, 7, 9, 12, 3]
row = ""
for stop in [4, 8, 15, 16, 23, 42, 7, 9, 12, 3, 99] { row = "\{row}\{walkBreak(ws, stop)}," }
print(row)
print(walkContinue(ws))
row = ""
for w in [4, 16, 23, 42, 7, 3, 5] { row = "\{row}\{walkFind(ws, w)}," }
print(row)
print(walkStore([1, 2, 3, 4, 5, 6, 7, 8, 9]))
print(walkKinds(9))
print(walkPair(ws))
