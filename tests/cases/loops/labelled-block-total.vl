// @run
// @log 1
// @log 2
// @log 3
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `h` is inferred as `i32`
// A labelled block whose body is total and that no `break :B` leaves is total, so a function
// with a declared result can end in one (D3259); one that `break :B` can leave falls through
// to what follows.
function f(): i32 {
  B: { return 1 }
}
print(f())
function g(c: boolean): i32 {
  B: {
    if c { return 2 }
    return 0
  }
}
print(g(true))
function h(c: boolean): i32 {
  B: {
    if c { break :B }
    return 0
  }
  3
}
print(h(true))
