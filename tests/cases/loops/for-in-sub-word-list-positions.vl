// @run
// @log -129
// @log -25538
// @log 65536
// @log 257
// @log -2
// @log -25536
// @log -112
// @log 65535
// @log 100001
// A walk over a packed sub-word list reads each element widened to an i32, sign- or zero-extended
// at its width: one row per width and per position such a walk is written in.
function k(n: i32) { return n }
const a: i8[] = [k(-3), k(130)]
const c: i16[] = [k(-2), k(40000)]
const u: u16[] = [k(65535), k(1)]
const b: u8[] = [k(255), k(2)]
// a top-level walk of each width, summed
let sa = 0
for x in a { sa = sa + x }
print(sa)
let sc = 0
for x in c { sc = sc + x }
print(sc)
let su = 0
for x in u { su = su + x }
print(su)
let sb = 0
for x in b { sb = sb + x }
print(sb)
// a walk in a function body, each element printed
function each(xs: i16[]) {
  for x in xs { print(x) }
}
each(c)
// a walk of a record field's list
type R = { f: i8[] }
const r: R = { f: [k(200)] }
for x in r.f { print(x * 2) }
// a walk with its index
for x, i in u { print(i * 100000 + x) }
