// @run
// @log 4
// @log -1
// @log 7
// @log 0
// @log 0 4
// @log 1 -1
// @log 2 7
// @log 11
// A walk over `(Circle | null)[]`, with `Circle` a union arm, reads each element as the arm or
// the null: a Circle first, a null, a Circle last, and an empty list that never iterates.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function show(z: (Circle | null)[]) {
  let n = 0
  for e in z {
    if e == null { print(0 - 1) } else { print(e.r) }
    n = n + 1
  }
  return n
}
const z: (Circle | null)[] = [{ r: 4 }, null, { r: 7 }]
const none: (Circle | null)[] = []
show(z)
print(show(none))
for e, i in z {
  if e == null { print("\{i} -1") } else { print("\{i} \{e.r}") }
}
let t = 0
for e in z {
  if e != null { t = t + e.r }
}
print(t)
