// @run
// A for-in over a call whose result is a literal-union list walks it: a lambda literal called
// in place (D3163) and a record's field-closure `"[]"` read (D3184), in a function and at module
// scope, and the field-closure result bound first or indexed directly.
type K = "a" | "b"
function g(ks: K[]) {
  for e in (() => ks)() { print(e) }
}
g(["a"])
const ms: K[] = ["b", "a"]
for e in (() => ms)() { print(e) }
function mk(ks: K[]) { return { "[]": (i: i32): K[] => ks } }
const c = mk(["b", "a"])
for e in c[0] { print(e) }
const xs = c[0]
for e in xs { print(e) }
print(c[0][1])
function walk(ks: K[]) {
  const d = mk(ks)
  for e in d[0] { print(e) }
}
walk(["a", "b"])
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log a
// @log a
// @log b
// @warning Unused parameter `i`
