// @run
// A LOOP BODY IS A NARROWING SCOPE, exactly like an `if` THEN-arm.
//
// The condition is re-tested before every iteration, so whatever it proves holds on
// entry to each one. Neither layer treated the body that way: `while e != null { e + 1 }`
// was `operator '+' is not defined for i32? and i32` at CHECK time for every rep, while
// the `if` spelling of the identical body ran — so the only way to use a value you had
// just null-checked inside a loop was to hoist the use into an `if` arm.
//
// THE ORACLE IS THE SECOND COLUMN OF EVERY PAIR. Each shape is spelled twice — once as
// the loop body (`wh`), once as the `if` arm that always worked (`if`) — and both must
// print the same value at BOTH runtime inputs (a null present and absent). BYTE-IDENTITY
// IS NOT AVAILABLE HERE and the check is not omitted silently: a `while` lowers to
// `block`/`loop` with a `br_if` exit and an `if` lowers to a single `if` frame, so the
// two modules differ by construction. The agreement pinned is the VALUE at both inputs.
//
// WHY A MUTATING BODY NEEDS NO INVALIDATION ANALYSIS. A bare-name narrowing is a
// shadowing declaration in a scope pushed for the body, so the narrowed type is the
// binding's ACCEPT contract inside it too: every way of putting a null back is a type
// error there, and a non-null write keeps the fact true. `MUT` below writes a non-null
// value and keeps reading unboxed; the rejected half is pinned by
// `while-body-narrow-null-write-reject.vl`, which must stay rejected.
//
// PROPERTY PATHS (`o.v != null`) ARE NOT NARROWED IN A LOOP BODY — deliberately, and the
// `if` spelling is why: a path fact can be falsified inside the body through any alias of
// the object, and `if o.v != null { clr(o); o.v.length }` is check-clean and TRAPS today.
// A path guard on a loop keeps rejecting, which is what it did before.
//
// `a || b` PROVES NOTHING IN THE THEN-SENSE, so `while e == null || c { e + 1 }` stays
// rejected — the same non-narrowing the `if` spelling has (see
// `unions/short-circuit-operand-narrowing.vl`).
//
// @log ARITH-i32 6 6
// @log ARITH-i32 - -
// @log CMP-f64 true true
// @log CMP-f64 - -
// @log SELF-bool true true
// @log SELF-bool - -
// @log LEN-str 2 2
// @log LEN-str - -
// @log IDX-str 97 97
// @log IDX-str - -
// @log FIELD-S 7 7
// @log FIELD-S - -
// @log IDX-arr 1 1
// @log IDX-arr - -
// @log LEN-arr 2 2
// @log LEN-arr - -
// @log EQ-lit true true
// @log EQ-lit - -
// @log PARAM-i32 5 5
// @log PARAM-i32 - -
// @log AND-i32 6 6
// @log AND-i32 - -
// @log NEG-i32 6 6
// @log NEG-i32 - -
// @log NEGIS-i32 6 6
// @log NEGIS-i32 - -
// @log MUT-i32 10 10
// @log MUT-i32 - -
// @log GUARD-break-i32 6 6
// @log GUARD-break-i32 - -
// @log GUARD-break-f64 true true
// @log GUARD-break-f64 - -
// @log GUARD-forrange-i32 6 6
// @log GUARD-forrange-i32 - -
// @log GUARD-forin-i32 6 6
// @log GUARD-forin-i32 - -
// @log ITER-i32 15
// @log ITER-i32 0

type K = "a" | "b"
type S = {v: i32}

function mkS(): S { return {v: 7} }
function mkA() { return [1, 2] }
function takeI(x: i32) { return x }

// ---- the boxed value reps: the ones that need the unbox the narrowing supplies ----
function whArithI32(e: i32 | null) {
  while e != null { return toString(e + 1) }
  return "-"
}
function ifArithI32(e: i32 | null) {
  if e != null { return toString(e + 1) }
  return "-"
}

function whCmpF64(e: f64 | null) {
  while e != null { return toString(e >= 0.0) }
  return "-"
}
function ifCmpF64(e: f64 | null) {
  if e != null { return toString(e >= 0.0) }
  return "-"
}

function whSelfBool(e: boolean | null) {
  while e != null { return toString(e) }
  return "-"
}
function ifSelfBool(e: boolean | null) {
  if e != null { return toString(e) }
  return "-"
}

// ---- the niche reps: green before and after, so a rep-wide claim is a measurement ----
function whLenStr(e: string | null) {
  while e != null { return toString(e.length) }
  return "-"
}
function ifLenStr(e: string | null) {
  if e != null { return toString(e.length) }
  return "-"
}

function whIdxStr(e: string | null) {
  while e != null { return toString(e[0]) }
  return "-"
}
function ifIdxStr(e: string | null) {
  if e != null { return toString(e[0]) }
  return "-"
}

function whFieldS(e: S | null) {
  while e != null { return toString(e.v) }
  return "-"
}
function ifFieldS(e: S | null) {
  if e != null { return toString(e.v) }
  return "-"
}

function whIdxArr(e: i32[] | null) {
  while e != null { return toString(e[0]) }
  return "-"
}
function ifIdxArr(e: i32[] | null) {
  if e != null { return toString(e[0]) }
  return "-"
}

function whLenArr(e: i32[] | null) {
  while e != null { return toString(e.length) }
  return "-"
}
function ifLenArr(e: i32[] | null) {
  if e != null { return toString(e.length) }
  return "-"
}

function whEqLit(e: K | null) {
  while e != null { return toString(e == "a") }
  return "-"
}
function ifEqLit(e: K | null) {
  if e != null { return toString(e == "a") }
  return "-"
}

// Passing the narrowed value to a NON-NULL parameter — the demand the union type
// cannot satisfy, so this row moves only if the body really is narrowed.
function whParamI32(e: i32 | null) {
  while e != null { return toString(takeI(e)) }
  return "-"
}
function ifParamI32(e: i32 | null) {
  if e != null { return toString(takeI(e)) }
  return "-"
}

// ---- the guard FORMS the collectors already compose, now reaching a loop body ----
function whAndI32(e: i32 | null) {
  while e != null && true { return toString(e + 1) }
  return "-"
}
function ifAndI32(e: i32 | null) {
  if e != null && true { return toString(e + 1) }
  return "-"
}

function whNegI32(e: i32 | null) {
  while !(e == null) { return toString(e + 1) }
  return "-"
}
function ifNegI32(e: i32 | null) {
  if !(e == null) { return toString(e + 1) }
  return "-"
}

function whNegIsI32(e: i32 | null) {
  while !(e is null) { return toString(e + 1) }
  return "-"
}
function ifNegIsI32(e: i32 | null) {
  if !(e is null) { return toString(e + 1) }
  return "-"
}

// A body that REASSIGNS the guarded binding to a non-null value keeps reading unboxed —
// the fact stays true, so nothing is invalidated.
function whMutI32(e: i32 | null) {
  while e != null {
    e = 9
    return toString(e + 1)
  }
  return "-"
}
function ifMutI32(e: i32 | null) {
  if e != null {
    e = 9
    return toString(e + 1)
  }
  return "-"
}

// ---- the GUARD-CLAUSE spelling: a diverging `break`, not a `return` ----
// Inside a loop an early-exit guard is `if e == null { break }`, and the rest of the
// body then runs only when the guard was false. The checker post-narrows all three
// diverging statements; the emitter's gate asked only about `return`, so this shape was
// `vl check` rc 0 and then invalid wasm (`type mismatch: expected i32, found (ref $type)`)
// for every boxed rep. The `if`-arm twin is the same program with the guard's complement
// spelled as the arm.
function whGuardBreakI32(e: i32 | null) {
  let r = "-"
  while true {
    if e == null { break }
    r = toString(e + 1)
    break
  }
  return r
}
function ifGuardBreakI32(e: i32 | null) {
  let r = "-"
  if e != null { r = toString(e + 1) }
  return r
}

function whGuardBreakF64(e: f64 | null) {
  let r = "-"
  while true {
    if e == null { break }
    r = toString(e >= 0.0)
    break
  }
  return r
}
function ifGuardBreakF64(e: f64 | null) {
  let r = "-"
  if e != null { r = toString(e >= 0.0) }
  return r
}

// The same guard clause in the two `for` bodies — they have no condition of their own,
// so a `break` guard is the ONLY way a `for` body gets narrowed.
function whGuardForRangeI32(e: i32 | null) {
  let r = "-"
  for _i in 0 to 0 {
    if e == null { break }
    r = toString(e + 1)
  }
  return r
}
function whGuardForInI32(e: i32 | null) {
  let r = "-"
  for _q in [0] {
    if e == null { break }
    r = toString(e + 1)
  }
  return r
}

// ---- a body that actually ITERATES, mutating the guarded binding each time ----
// The narrowing is re-established by the condition at the top of every iteration, so a
// body that walks the binding down to its exit reads it unboxed throughout. No `if`
// spelling can express this, so the oracle here is the arithmetic: 5+4+3+2+1.
function whIterI32(e: i32 | null) {
  let n = 0
  while e != null {
    n = n + e
    if e <= 1 { break }
    e = e - 1
  }
  return n
}

function pair(tag: string, a: string, b: string) {
  print(tag + " " + a + " " + b)
  0
}

pair("ARITH-i32", whArithI32(5), ifArithI32(5))
pair("ARITH-i32", whArithI32(null), ifArithI32(null))
pair("CMP-f64", whCmpF64(5.0), ifCmpF64(5.0))
pair("CMP-f64", whCmpF64(null), ifCmpF64(null))
pair("SELF-bool", whSelfBool(true), ifSelfBool(true))
pair("SELF-bool", whSelfBool(null), ifSelfBool(null))
pair("LEN-str", whLenStr("ab"), ifLenStr("ab"))
pair("LEN-str", whLenStr(null), ifLenStr(null))
pair("IDX-str", whIdxStr("ab"), ifIdxStr("ab"))
pair("IDX-str", whIdxStr(null), ifIdxStr(null))
pair("FIELD-S", whFieldS(mkS()), ifFieldS(mkS()))
pair("FIELD-S", whFieldS(null), ifFieldS(null))
pair("IDX-arr", whIdxArr(mkA()), ifIdxArr(mkA()))
pair("IDX-arr", whIdxArr(null), ifIdxArr(null))
pair("LEN-arr", whLenArr(mkA()), ifLenArr(mkA()))
pair("LEN-arr", whLenArr(null), ifLenArr(null))
pair("EQ-lit", whEqLit("a"), ifEqLit("a"))
pair("EQ-lit", whEqLit(null), ifEqLit(null))
pair("PARAM-i32", whParamI32(5), ifParamI32(5))
pair("PARAM-i32", whParamI32(null), ifParamI32(null))
pair("AND-i32", whAndI32(5), ifAndI32(5))
pair("AND-i32", whAndI32(null), ifAndI32(null))
pair("NEG-i32", whNegI32(5), ifNegI32(5))
pair("NEG-i32", whNegI32(null), ifNegI32(null))
pair("NEGIS-i32", whNegIsI32(5), ifNegIsI32(5))
pair("NEGIS-i32", whNegIsI32(null), ifNegIsI32(null))
pair("MUT-i32", whMutI32(5), ifMutI32(5))
pair("MUT-i32", whMutI32(null), ifMutI32(null))
pair("GUARD-break-i32", whGuardBreakI32(5), ifGuardBreakI32(5))
pair("GUARD-break-i32", whGuardBreakI32(null), ifGuardBreakI32(null))
pair("GUARD-break-f64", whGuardBreakF64(5.0), ifGuardBreakF64(5.0))
pair("GUARD-break-f64", whGuardBreakF64(null), ifGuardBreakF64(null))
pair("GUARD-forrange-i32", whGuardForRangeI32(5), ifGuardBreakI32(5))
pair("GUARD-forrange-i32", whGuardForRangeI32(null), ifGuardBreakI32(null))
pair("GUARD-forin-i32", whGuardForInI32(5), ifGuardBreakI32(5))
pair("GUARD-forin-i32", whGuardForInI32(null), ifGuardBreakI32(null))
print("ITER-i32 " + toString(whIterI32(5)))
print("ITER-i32 " + toString(whIterI32(null)))
