// @run
// @log 1117
// @log 2229
// @log abcdz
// A dense integer `match` on a fully unrolled range loop's variable reads that copy's constant
// as its scrutinee: a valued match, a statement match, and a tail match a copy calls.
function valued() {
  let acc = 0
  for k in 0 to 4 {
    const v = match k {
      0 => 1
      1 => 10
      2 => 100
      3 => 1000
      _ => 6
    }
    acc = acc + v
  }
  return acc
}
function stmt() {
  let acc = 0
  for k in 0 to 4 {
    match k {
      0 => {
        acc = acc + 2
      }
      1 => {
        acc = acc + 20
      }
      2 => {
        acc = acc + 200
      }
      3 => {
        acc = acc + 2000
      }
      _ => {
        acc = acc + 7
      }
    }
  }
  return acc
}
function pick(k: i32) {
  return match k {
    0 => "a"
    1 => "b"
    2 => "c"
    3 => "d"
    _ => "z"
  }
}
function viaTail() {
  let s = ""
  for k in 0 to 4 { s = s + pick(k) }
  return s
}
print(valued())
print(stmt())
print(viaTail())
