// @run
// @log 0 a
// @log 1 b
// @log k=1
// @log m=2
// @log 3
// A walk's second name: a list's index and a map's value, and an index the body writes.
function walk(xs: string[], m: {[string]: i32}) {
  for x, i in xs { print("\{i} \{x}") }
  for k, v in m { print("\{k}=\{v}") }
  let n = 0
  for x, i in xs {
    i = i + 10
    n = n + i - 10 + 1
  }
  print(n)
}
const m: {[string]: i32} = Map()
m["k"] = 1
m["m"] = 2
walk(["a", "b"], m)
