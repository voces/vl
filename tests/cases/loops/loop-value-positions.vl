// @run
// @log 14
// @log 5
// @log 9
// @log 3
// @log bb
// A labelled block as a call argument is parenthesized: `f(B: { … })` reads `B:` as a named
// argument. An unlabelled loop needs no parentheses there. Each value prints, so the path the
// value took shows.
function seven() { 7 }
function id(x: i32) { x }
print(
  id(
    (B: {
      if seven() > 3 { break :B seven() * 2 }
      0
    }),
  ),
)
const xs: i32[] = []
xs.push(
  (B: {
    if seven() > 3 { break :B 5 }
    0
  }),
)
print(xs[0])
const m: { [string]: i32 } = Map()
m.set(
  "k",
  (B: {
    if seven() > 30 { break :B 1 }
    9
  }),
)
print(m["k"] ?? -1)
print(id(while true { break 3 }))
function pickLong(ws: string[]) {
  for w in ws {
    if w.length > 1 { break w }
  }
}
print(pickLong(["a", "bb"]) ?? "none")
