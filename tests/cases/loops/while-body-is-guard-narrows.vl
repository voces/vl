// @run
// @log READ 4
// @log FLIP true
// @log ITER 3
// @log PAREN 1
// @log NEG true
// @log NOTIS true
// AN `is T` GUARD NARROWS A LOOP BODY, exactly as a `!= null` guard does
// (`while-body-narrowing.vl`). This file was the CONTRACT saying the opposite; the owner's
// re-ruling on D1736 retired that contract and it is now the loop's positive fixture.
//
// The old argument was that a narrowed binding's type is also what it ACCEPTS, so pinning
// the body would reject `x = true` — the write that flips the variant, which is how a loop
// over a union makes progress. NARROWING APPLIES TO READS ONLY: the write is checked against
// the DECLARATION and re-narrows the binding to what it wrote, so the flip is legal and the
// read after it sees the new member. `unions/paren-is-narrow.vl`'s `whileParen` is the same
// program and stays green.
//
// What the loop still declines is a PROPERTY PATH (`while o.v is T`), for the aliasing
// reason `while-body-narrowing.vl` states — the checker's `isPathKey` filter and the
// emitter's `narrowBareIdentOnly` are the same rule, spelled once each.
import { toString } from "std:fmt"

// The read: the body is narrowed, so `x + 1` is i64 arithmetic rather than
// `operator '+' is not defined for i64 | boolean and i32`.
function readInBody(x: i64 | boolean) {
  let r = ""
  while x is i64 {
    r = toString(x + 1)
    break
  }
  return r
}
print("READ " + readInBody(3))

// The flip: the write is checked against `i64 | boolean` and re-narrows `x` to `boolean`,
// so the read after it is a boolean read and the loop's next test ends the loop.
function flipInBody(x: i64 | boolean) {
  let r = ""
  while x is i64 {
    x = true
    r = toString(x)
  }
  return r
}
print("FLIP " + flipInBody(3))

// A body that iterates under the pin and leaves through the flip. The then arm's write is
// one the narrowing still admits, so the else arm is still narrowed and its flip is the
// loop's exit.
function iterate(x: i64 | boolean) {
  let n = 0
  while x is i64 {
    n = n + 1
    if x > 1 { x = x - 1 } else { x = false }
  }
  return n
}
print("ITER " + toString(iterate(3)))

// The parenthesized head, and the two negated spellings, each with the flip.
function parenHead() {
  let x: i64 | boolean = 6000000000
  let n = 0
  while (x is i64) {
    n = n + 1
    x = true
  }
  return n
}
print("PAREN " + toString(parenHead()))

function negatedHead() {
  let x: i64 | boolean = true
  let r = ""
  while !(x is i64) {
    r = toString(x)
    x = 5
  }
  return r
}
print("NEG " + negatedHead())

function notIsHead() {
  let x: i64 | boolean = true
  let r = ""
  while x !is i64 {
    r = toString(x)
    x = 5
  }
  return r
}
print("NOTIS " + notIsHead())
