// @run
// @log 6
// @log 9
// @log 9
// A closure called inside the loop declines the hoist. The callee is not a
// linear-memory intrinsic, so it may reach the captured list — and here it does,
// growing `xs` on every pass. The last two bytes are elements the closure added.
import { Buffer, loadU8 } from "std:buffer"

const xs: u8[] = [1, 2]
const grow = () => { xs.push(9) }
const b = Buffer(8)
let i = 0
while i < 4 {
  __store_i8__(b.base + i, xs[i])
  grow()
  i = i + 1
}
print(xs.length)
print(b.loadU8(2))
print(b.loadU8(3))
