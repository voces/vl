// @check
// @error-at 19:2 `outer: while …` is no longer a label; write `@outer while …`
// @error-at 21:4 `L: for …` is no longer a label; write `@L for …`
// @error-at 22:24 `break :outer` is now `break @outer`
// @error-at 23:27 `continue :L` is now `continue @L`
// @error-at 26:2 `B: { … }` is no longer a label; write `@B { … }`
// @error-at 27:21 `break :B` is now `break @B`
// @error-at 29:12 `C: { … }` is no longer a label; write `@C { … }`
// @error-at 29:34 `break :C` is now `break @C`
// @error-at 34:2 `B: …` is an object field here; a label is written `@B { … }`
// @error-at 35:4 expected a field name but found `if`
// @error-at 37:0 expected an expression but found RBRACE
// @error-at 39:2 `L: …` is an object field here; a label is written `@L while …`
// @error-at 40:10 `break :L` is now `break @L`
// A label is `@name` since the owner's 2026-09-30 ruling, the same token where it is declared
// and where a jump names it. Every retired spelling is refused with the one it is now, and
// `scripts/codemods/label-at.py` rewrites a file that still has them.
function f(n: i32) {
  let s = 0
  outer: while s < 10 {
    s = s + 1
    L: for i in 0 until 3 {
      if s == n { break :outer }
      if i == 1 { continue :L }
    }
  }
  B: {
    if s > 3 { break :B }
  }
  const v = C: { if s > 4 { break :C 1 }; 2 }
  s + v
}
print(f(3))
function g(n: i32) {
  B: {
    if n > 3 { break :B }
  }
}
function h(n: i32) {
  L: while n > 3 {
    break :L
  }
}
