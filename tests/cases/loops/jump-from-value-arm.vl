// @log 202235
// A `break`, `continue` or `return` inside a value-position arm branches to the right frame
// (D2050): the value `if`, `match` and else-if chain each open a frame the jump has to count.
// Every loop runs i = 0..3, the jump fires at i == 1, and the other arms yield 7, 5, 7.

function contIf(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const v = if i % 2 == 1 { if i == n { continue }; 5 } else { 7 }
    acc = acc + v
  }
  return acc
}
print(contIf(1))

// Broke to the loop head, skipping the increment, and never terminated.
function breakIf(n: i32) {
  let acc = 0
  let i = -1
  while i < 3 {
    i = i + 1
    const v = if i % 2 == 0 { 7 } else { if i == n { break }; 5 }
    acc = acc + v
  }
  return acc
}
print(breakIf(1))

function contOuter(n: i32) {
  let acc = 0
  outer: for j in 0 to 1 {
    for i in 0 to 3 {
      const v = if i % 2 == 1 { if i == n { continue outer }; 5 } else { 7 }
      acc = acc + v
    }
    acc = acc + 100
  }
  return acc
}
print(contOuter(1))

function breakInner(n: i32) {
  let acc = 0
  outer: for j in 0 to 1 {
    for i in [0, 1, 2, 3] {
      const v = if i % 2 == 1 { if i == n { break }; 5 } else { 7 }
      acc = acc + v
    }
    acc = acc + 100
  }
  return acc
}
print(breakInner(1))

// A union result sinks its `return` to the function's exit block, a `br` counted the same way.
function retUnion(n: i32): i32 | string {
  let acc = 0
  for i in 0 to 3 {
    const v = if i % 2 == 1 { if i == n { return 1000 + acc }; 5 } else { 7 }
    acc = acc + v
  }
  return acc
}
const r = retUnion(1)
if r is i32 { print(r) } else { print(r) }

function contString(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const s = if i % 2 == 1 { if i == n { continue }; "aaaaa" } else { "aaaaaaa" }
    acc = acc + s.length
  }
  return acc
}
print(contString(1))

function contMatch(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const v = match i % 2 {
      1 => {
        if i == n { continue }
        5
      }
      _ => 7
    }
    acc = acc + v
  }
  return acc
}
print(contMatch(1))

function contChain(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const v = if i == 0 { 7 } else if i == 1 { if i == n { continue }; 5 } else if i == 2 { 7 } else if i == 3 { 5 } else { 0 }
    acc = acc + v
  }
  return acc
}
print(contChain(1))

function breakNullable(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const v = if i % 2 == 1 { if i == n { break }; 5 } else { null }
    acc = acc + (v ?? 7)
  }
  return acc
}
print(breakNullable(1))

function contF64(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const v = if i % 2 == 1 { if i == n { continue }; 5.0 } else { 7.0 }
    acc = acc + (if v > 6.0 { 7 } else { 5 })
  }
  return acc
}
print(contF64(1))

// The jump sits in a value `if` nested inside another value `if`'s arm.
function breakNested(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const v = if i % 2 == 1 {
      const w = if i >= 0 { if i == n { break }; 0 } else { 0 }
      5 + w
    } else {
      7
    }
    acc = acc + v
  }
  return acc
}
print(breakNested(1))

// A loop inside the arm keeps its own `break`; the outer `return` still leaves the function.
function retInnerLoop(n: i32) {
  let acc = 0
  for i in 0 to 3 {
    const v = if i % 2 == 1 {
      let k = 0
      while true {
        k = k + 1
        if k == 5 { break }
      }
      if i == n { return 1000 + acc }
      k
    } else {
      7
    }
    acc = acc + v
  }
  return acc
}
print(retInnerLoop(1))

// A dense integer `match` lowers to a `br_table`; its arm frames count like an `if`'s.
function denseMatch() {
  let acc = 0
  outer: for j in 0 to 2 {
    for k in 0 to 4 {
      const v = match k {
        0 => 1
        1 => {
          if j == 1 { continue outer }
          10
        }
        2 => 100
        3 => 1000
        _ => 6
      }
      acc = acc + v
    }
    acc = acc + 100000
  }
  return acc
}
print(denseMatch())
