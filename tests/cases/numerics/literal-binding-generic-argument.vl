// @run
// @log 3000000000
// @log 6000000000
// An argument to a type parameter needs no one type, so it neither picks nor vetoes the type
// of a literal `let`: the `i64` store decides it (D3246).
function id<T>(x: T): T { x }
function big() { 3000000000 }
function main() {
  let b = 0
  b = big()
  print(id(b))
  print(b * 2)
}
main()
