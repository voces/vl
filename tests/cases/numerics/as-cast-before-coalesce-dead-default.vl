// @run
// @log 1
// @log 2
// @warning this `??` default is never used: a bare `as` returns its miss from the function instead of handing it to `??` — write `(x as? i32) ?? …` to default it here
// @warning this `??` default is never used: `f64` is never null — drop the `??` and its default
// A bare `as` whose miss the return can carry propagates it, so the `??` default after it is
// dead; the finding names `as?` rather than telling the author to drop the default. An `as`
// that cannot miss keeps the plain dead-default finding.
function pick(u: f64): i32 | null {
  const k = u as i32 ?? 0
  return k
}
print(pick(1.0) ?? 9)

function widen(n: i32) {
  const k = n as f64 ?? 0.0
  return k
}
print(widen(2))
