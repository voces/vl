// @run
// @hint redundant type annotation: `same` is inferred as `boolean`
// A return set holding a literal arm joins its runtime numbers apart, the literal adapting to
// them (D3495), and so does a list literal holding a nullable runtime element beside a number
// of another type (D3535).
import { indexOf } from "std:array"

function f(k: i32, a: i32, b: f64) {
  if k == 0 { return a }
  if k == 1 { return b }
  return 3
}
print(f(0, 7, 2.5) / 2)
print(f(1, 7, 2.5) / 2)
print(f(2, 7, 2.5))
function h(k: i32, a: i64, b: i64) {
  if k == 0 { return a }
  if k == 1 { b } else { 5 }
}
print(h(1, 9, 11))
print(h(2, 9, 11))
function same<T>(p: T, q: T): boolean { p == q }
function g(a: i64 | null, b: i32) {
  const xs = [a, b]
  print(xs[1] is i64)
  print(indexOf(xs, xs[1]))
  print(same(xs[0], xs[1]))
  print(xs[0] ?? 0)
}
g(null, 7)
g(5, 7)
// @log 3
// @log 1.25
// @log 3
// @log 11
// @log 5
// @log false
// @log 1
// @log false
// @log 0
// @log false
// @log 1
