// @check
// @error i64 doesn't fit in f64
// The exactness gate of the f64 contextual-integer-literal rule. `9007199254740992` (2^53)
// is the last integer f64 holds exactly and RUNS — `f64-literal-adopt-positions.vl` prints
// it. One more is not representable, so turning it into 2^53 would be the lossy implicit
// conversion VL forbids and the grant declines it, exactly as `isExactF32IntLitExpr`
// declines `16777217` at 2^24 + 1. D1890.
const over: f64 = 9007199254740993
print(over)
