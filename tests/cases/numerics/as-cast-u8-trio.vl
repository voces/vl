// @run
// @log 200
// @log 200
// @log 200
// @log null
// @log null
// @log null
// @log 200
// @log 200
// @log 200
// @log null
// @log null
// @log null
// @log 200
// @log 12
// @hint redundant type annotation: `fi32` is inferred as `i32`
// @hint redundant type annotation: `fi64` is inferred as `i64`
// @hint redundant type annotation: `ff64` is inferred as `f64`
// `x as u8` IS THE SAME EXACT-OR-FAIL NARROWING `x as i32` IS, with 0..255 as the domain —
// DECISIONS.md §"`x as u8` is the i64→i32 narrowing with a byte-sized domain" (owner,
// 2026-09-04), built as D1587. `u8` is a STORAGE type, so the cast used to be a loud check
// reject naming the store; what it names is a RANGE, and the value it produces is an
// ordinary `i32` inside that range.
//
// The trio is the trio: `as?` takes the failure as `null` (typed `i32 | null`), `as!` traps
// with a source-located reason (`as-cast-u8-trap-range.vl`,
// `as-cast-u8-trap-fraction.vl`), and a bare `as` propagates the `null` — legal only where
// the enclosing function returns `| null` (`error-as-cast-u8-module-scope.vl`).
//
// EVERY numeric source can fail it, `i32` included, which is the one pair in the whole cast
// family with no float and no width change in it: 300 is a perfectly good `i32` and not a
// byte. Values come through passthrough calls so nothing folds to a literal.
function fi32(x: i32): i32 { x }
function fi64(n: i64): i64 { n }
function ff64(x: f64): f64 { x }

// `as?` — the failure is a value, and the result type is `i32 | null`.
print(fi32(200) as? u8)
print(fi64(200) as? u8)
print(ff64(200.0) as? u8)
print(fi32(300) as? u8)
print(fi64(5000000000) as? u8)
print(ff64(3.9) as? u8)

// `as!` — asserted, and in range, so it is just the value.
print(fi32(200) as! u8)
print(fi64(200) as! u8)
print(ff64(200.0) as! u8)

// A bare `as` PROPAGATES, and the enclosing return type is what makes it legal.
function byteOf(x: i32): i32 | null {
  const b = x as u8
  return b
}
print(byteOf(300))
print(byteOf(3000))
print(byteOf(0 - 1))
print(byteOf(200))

// The consumer's spelling: a `u8[]` takes the asserted byte, and reads it back widened.
const bytes: u8[] = []
bytes.push(ff64(12.0) as! u8)
print(bytes[0])
