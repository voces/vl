// @run
// @log 1266679808
// @log 1275068416
// @log 1333788671
// @log 0
// @log -1073741824
// @log 1065353216
// @log true
// The EXACTNESS GATE for an integer literal in an f32 context, read through `f32bits` so
// the assertion is on the STORED BITS rather than on a printed decimal.
//
// An integer v != 0 is exactly an f32 iff its significand fits 24 bits once trailing zero
// bits are carried by the exponent (`bitlen - trailingZeros <= 24`) and it is not past the
// largest finite f32. `intLexemeIsExactF32` tests exactly that, so the admitted set is
// neither "under 2^24" (too narrow — it would reject every large power of two) nor "any
// i32" (unsound). The rejected side is pinned in `f32-integer-literal-inexact-reject.vl`.

// 2^24 = 16777216 — the largest integer with NO gaps below it. 0x4B800000.
const a: f32 = 16777216
print(f32bits(a))

// 2^25 = 33554432 — ABOVE the contiguous range and still exact, because its single
// significant bit rides the exponent. A "magnitude <= 2^24" rule would wrongly reject it.
// 0x4C000000.
const b: f32 = 33554432
print(f32bits(b))

// (2^24 - 1) * 2^8 = 4294967040: 24 significant bits with 8 trailing zeros, the widest
// shape the gate admits — and PAST the i32 range, so the literal itself types i64. The
// grant reads the literal's TEXT, not its default type, so the i64-typed spelling flows
// exactly as the i32-typed ones do. 0x4F7FFFFF.
const c: f32 = 4294967040
print(f32bits(c))

// Zero is exact in every format and has no significant bits to strip.
const d: f32 = 0
print(f32bits(d))

// A NEGATIVE literal: negation is exact in IEEE-754, so the sign peels and the magnitude
// decides. -2 is 0xC0000000, which prints as the signed i32 -1006632960.
const e: f32 = -2
print(f32bits(e))

// A RADIX literal folds at its own base before the bit test, so `0x1` and `1` get one
// answer. 1.0f is 0x3F800000.
const f: f32 = 0x1
print(f32bits(f))

// The integer half and the float half agree where they overlap: `16777216` and
// `16777216.0` are the same f32.
const g: f32 = 16777216.0
print(f32bits(a) == f32bits(g))
