// @run
// @hint redundant type annotation: `bind` is inferred as `f64`
// @hint redundant type annotation: `viaMatch` is inferred as `f64`
// @hint redundant type annotation: `outer` is inferred as `f64`
// @log -3
// @log 6
// @log 0.30000000000000004
// @log -1
// @log 2.5
// @log 2
// A value `if` or `match` joining an `f32` arm with an `f64` one is an `f64`, and the f32 arm
// widens into it wherever the join is delivered: a binding, an operand, a print (D2773). A float
// literal beside the f32 arm is read at double precision when a sibling arm is a genuine `f64`.
function bind(x: f32, d: f64): f64 {
  const v = if x > 0.0 { d } else { x }
  v * 3.0
}
function viaMatch(x: f32, d: f64, k: i32): f64 {
  const v = match k {
    0 => x
    _ => d
  }
  v * 3.0
}
function outer(x: f32, d: f64, k: i32): f64 {
  const v = if k > 5 { d } else { if x > 0.0 { x } else { 0.1 } }
  v * 3.0
}
function g(x: f32, k: i32) {
  if k > 5 { return 2.5 }
  return if x > 0.0 { x } else { 0.1 }
}
print(bind(-1.0, 2.0))
print(viaMatch(2.0, 9.0, 0))
print(outer(-1.0, 2.0, 1))
print(if 1 > 2 { 5.5 } else { -1.0 as f32 })
print(g(1.0, 9))
print(g(2.0, 1))
