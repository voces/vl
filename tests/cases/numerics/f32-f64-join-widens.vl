// @run
// @log -3
// @log 6
// @log 0.30000000000000004
// @log -1
// @log 2.5
// @log 2
// A value `if` or `match` joining an `f32` arm with an `f64` one is `f64 | f32`: each arm keeps
// its own type, arithmetic runs at the member's type, and the declared `f64` return widens the
// `f32` member exactly (D2773). A float literal arm of an inner join keeps its own `f64`.
function bind(x: f32, d: f64): f64 {
  const v = if x > 0.0 { d } else { x }
  v * 3.0
}
function viaMatch(x: f32, d: f64, k: i32): f64 {
  const v = match k {
    0 => x
    _ => d
  }
  v * 3.0
}
function outer(x: f32, d: f64, k: i32): f64 {
  const v = if k > 5 { d } else { if x > 0.0 { x } else { 0.1 } }
  v * 3.0
}
function g(x: f32, k: i32) {
  if k > 5 { return 2.5 }
  return if x > 0.0 { x } else { 0.1 }
}
print(bind(-1.0, 2.0))
print(viaMatch(2.0, 9.0, 0))
print(outer(-1.0, 2.0, 1))
print(if 1 > 2 { 5.5 } else { -1.0 as f32 })
print(g(1.0, 9))
print(g(2.0, 1))
