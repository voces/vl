// @run
// @hint redundant type annotation: `b` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `m32` is inferred as `i32` — remove it to lean on inference
// @log 8589934588
// @log -4
// @log -4
// @log 4611686014132420609
// @log 1
// @log 0
// @log 1073741824
// @log 4294967296
// @log 8589934588
// A `const` whose radix tree the fold leaves to its use's width is that tree at each read, so an
// `i64` read computes it at 64 bits and an `i32` or `f64` read at 32, as written there (D14990).
const P = 0x7FFFFFFF << 2
const a: i64 = P
const b: i32 = P
const c: f64 = P
print(a)
print(b)
print(c)

const M = 0x7FFFFFFF * 0x7FFFFFFF
const m: i64 = M
const m32: i32 = M
print(m)
print(m32)

const D = -1 / 0xFFFFFFFF
const d: i64 = D
print(d)

const S = 0x80000000 >> 1
const s: i64 = S
print(s)

const R = (0x7FFFFFFF + 1) * 2
const r: i64 = R
print(r)

function f(): i64 {
  const L = 0x7FFFFFFF << 2
  return L
}
print(f())
