// @run
// @log 44
// @log null
// @log 239
// @log 5
// @log 255
// @log 254
// @log 1
// @log null
// @log 0
// @log 255
// A bounded operand's cast is decided without reading the operand's width, because an inferred
// width can still change: a `let` later stored an `i64`, a global retyped by a function, a type
// parameter pinned at both widths, an un-annotated lambda parameter (D3622). `a >>> 24` is
// bounded only at `i32`, so over an `i64` it stays fallible and `as?` answers null. An `i32` pin
// shifts by the count modulo 32, so `>>> 33` there sheds one bit, not 33.
const big = 1099511628076
let a = 5
a = big
print((a & 0xFF) as u8)
print((a >>> 24) as? u8)
let gl = 5
function set(v: i64) { gl = v }
set(0x123456789ABCDEF)
print((0xFF & gl) as u8)
function g<T>(x: T) { return ((x & 0xFFFF) % 256) as u8 }
print(g(5))
print(g(-1 as i64))
const m = (v) => (v & 0xFE) as u8
print(m(-2 as i64))
print(m(1) + 1)
function h<T>(x: T) { return ((x & 0x7FFFFFFF) >>> 33) as? u8 }
print(h(-1))
print(h(-1 as i64))
function h2<T>(x: T) { return ((x & 0xFFFF) >>> 40) as! u8 }
print(h2(-1))
