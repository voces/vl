// @run
// @log 1.0000001192092896
// @log 1.0000001192092896
// @log 0.09999997913837433
// @log 1.0000000000000007

// A float constant tree initialising a binding annotated `f32` folds in `f32` arithmetic, as it
// would run there: each literal and each operation rounds to `f32`. At `f64` it folds in
// doubles. Whether a module or a local binding, the result is the same.
const m: f32 = (1.5 % 0.1) / (2.5 % 0.1)
print(m)
function local() {
  const v: f32 = (1.5 % 0.1) / (2.5 % 0.1)
  print(v)
  const r: f32 = 1.5 % 0.1
  print(r)
  const d = (1.5 % 0.1) / (2.5 % 0.1)
  print(d)
}
local()
