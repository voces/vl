// @run
// @log 3000000000
// @log 4294967295
// @log 3270148182
// @log 3270148181
// @log -1294967295
// @log -1
// A radix literal beside an operand spelled with an `i64` decimal is in that `i64` context, so it
// is zero-extended there, whatever the decimal tree's value (D16492); beside `i32` it is a pattern.
print(0xFFFFFFFF & 3000000000)
print(0xFFFFFFFF & 9223372036854775807)
print(0xFFFFFFFF & (9223372036854775807 / (-9000000003)))
print(0xFFFFFFFF + (9223372036854775807 / (-9000000003)))
print(3000000000 - 0xFFFFFFFF - 0xFFFFFFFF + 4294967295)
print(0xFFFFFFFF & -2147483648 | 0xFFFFFFFF)
