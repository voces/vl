// The unsigned COMPARISONS read the same bit pattern under a different interpretation,
// so each is the exact negation of its signed operator on a word whose sign bit is set.
// That is why they are operations and not a `u32` type: nothing about the VALUE changes,
// only the instruction — the same decision VL already made when it spelled the unsigned
// shift as the operator `>>>`.
const neg = -1     // 0xffffffff — 4294967295 read unsigned
const one = 1

print(ltU(neg, one)) // false: 4294967295 is not below 1
print(neg < one)     // true: -1 is
print(gtU(neg, one))
print(neg > one)

print(leU(neg, one))
print(geU(neg, one))
print(ltU(one, neg))
print(ltU(neg, neg)) // a value is never below itself
print(leU(neg, neg))
print(geU(neg, neg))

// At i64 the width follows the operand, and the boundary moves with it.
const negWide: i64 = -1
const bigWide: i64 = 4294967296
print(ltU(negWide, bigWide)) // false — 18446744073709551615 is not below 2^32
print(negWide < bigWide)     // true
