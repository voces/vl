// @log -2147483648
// wasm `min`/`max` are NOT `<`/`>`, and the two places they differ are exactly the two
// a comparison cannot express. Asserted through `f64bits`, because a printed zero does
// not show its sign.
const nan = 0.0 / 0.0

// NaN PROPAGATES through min/max — a `<`-based min would have returned the non-NaN
// operand, silently laundering the NaN out of the computation.
const mn = min(nan, 1.0)
const mx = max(nan, 1.0)
print(mn != mn)
print(mx != mx)
print(nan < 1.0) // the comparison says false and picks 1.0; min does not

// min ORDERS -0 below +0 and max above it, in both operand orders. `<` sees them equal.
print(f64bits(min(0.0, -0.0)))
print(f64bits(max(0.0, -0.0)))
print(f64bits(min(-0.0, 0.0)))
print(f64bits(max(-0.0, 0.0)))

// abs and copysign are SIGN-BIT edits, so they see the sign of a zero too.
print(f64bits(abs(-0.0)))
print(f64bits(copysign(1.0, -0.0)))
print(f64bits(copysign(-0.0, -1.0)))

// nearest rounds -0.5 to -0, not to +0 — at f32 as at f64.
const f32NegHalf: f32 = -0.5
print(f32bits(nearest(f32NegHalf)))
