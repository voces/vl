// @error-at 111:2 cannot assign i64 to i32
// @error-at 112:2 cannot reassign `const` t
// @error-at 112:6 cannot assign i64 to i32
// @error-at 114:10 cannot assign i64 to i32 — `cs` on line 114 has no annotation, so its literal defaulted to `i32[]`; annotate it: `const cs: i64[] = …`
// @error-at 122:6 cannot assign i64 to i32 — `n` on line 122 has no annotation, so its literal defaulted to `i32`; annotate it: `let n: i64 = …`
// @error-at 127:6 cannot assign f32 to i32 — `n` on line 127 has no annotation, so its literal defaulted to `i32`; annotate it: `let n: f32 = …`
// D2966 (plumb PL-054): a store a local's defaulted literal refuses names the declaration and the
// annotation that fixes it, as D2860 does for a read. Line and column are 0-based.

function ld32(a: i64) { (__load_i32__(a as% i32) as% i64) & 4294967295 }
function big(): i64 { 5 }
function fl(): f32 { 1.5 }
function bytes(): u8[] { [1, 2] }
function f32s(): f32[] { [1.5] }

// PL-054's witness: a compound assignment.
function sum(p: i64, n: i64) {
  let s = 0
  let i = 0
  while i < n {
    s += ld32(p + i * 4)
    i += 1
  }
  s
}

// Whole, compound and bitwise stores; one the literal's operator refuses to mix.
function locals() {
  let a = 0
  a = big()
  let b = 0
  b |= big()
  let c = 1
  c *= fl()
  let d = 0
  d -= 2.5
  print(a + b)
  print(c + d)
}

// A record field, a list element, and a whole list.
function places() {
  const r = { x: 0, y: true }
  r.x = big()
  const xs = [0, 1]
  xs[1] += big()
  let bs = [0, 255]
  bs = bytes()
  let fs = [0.5]
  fs = f32s()
  print(r.x + xs[1])
  print(bs[0])
  print(fs[0])
}

// A module-level `let`, written from a function and at the top level.
export let total = 0
function add() { total = big() }
let scale = 1
scale *= fl()

// No note: an annotated declaration, a non-literal initializer, stores that want two different
// types, and a literal the stored type cannot hold.
function misses() {
  let e: i32 = 0
  e = big()
  let z = ld32(0) as% i32
  z = big()
  let two = 0
  two = big()
  two = fl()
  let big2 = [300]
  big2 = bytes()
  let half = 0.5
  half = big()
  print(e + z + two)
  print(big2[0] + half)
}

print(sum(0, 0))
locals()
places()
add()
print(total + scale)
misses()

// No note for a whole store to a `const`, which refuses it already; an element or field store
// through one keeps its note.
const t = 0
function consts() {
  const c = 0
  c += big()
  t = big()
  const cs = [0]
  cs[0] = big()
  print(c + t + cs[0])
}
consts()

// Two functions with a binding of one name: a store in one does not refute the other's note.
function one() {
  let n = 0
  n = big()
  print(n)
}
function two() {
  let n = 0
  n = fl()
  print(n)
}
one()
two()
