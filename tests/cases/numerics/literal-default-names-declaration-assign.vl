// @error-at 85:9 cannot assign u8[] to i32[]
// @error-at 87:9 cannot assign i64 to f64
// D2966 (plumb PL-054): a store a local's defaulted literal refuses names the declaration and the
// annotation that fixes it, as D2860 does for a read. Line and column are 0-based.

function ld32(a: i64) { (__load_i32__(a as% i32) as% i64) & 4294967295 }
function big(): i64 { 5 }
function fl(): f32 { 1.5 }
function bytes(): u8[] { [1, 2] }
function f32s(): f32[] { [1.5] }

// PL-054's witness: a compound assignment.
function sum(p: i64, n: i64) {
  let s = 0
  let i = 0
  while i < n {
    s += ld32(p + i * 4)
    i += 1
  }
  s
}

// Whole, compound and bitwise stores; one the literal's operator refuses to mix.
function locals() {
  let a = 0
  a = big()
  let b = 0
  b |= big()
  let c = 1
  c *= fl()
  let d = 0
  d -= 2.5
  print(a + b)
  print(c + d)
}

// A record field, a list element, and a whole list.
function places() {
  const r = { x: 0, y: true }
  r.x = big()
  const xs = [0, 1]
  xs[1] += big()
  let bs = [0, 255]
  bs = bytes()
  let fs = [0.5]
  fs = f32s()
  print(r.x + xs[1])
  print(bs[0])
  print(fs[0])
}

// A module-level `let`, written from a function and at the top level.
export let total = 0
function add() { total = big() }
let scale = 1
scale *= fl()

// No note: an annotated declaration, a non-literal initializer, stores that want two different
// types, and a literal the stored type cannot hold.
function misses() {
  let e: i32 = 0
  e = big()
  let z = ld32(0) as% i32
  z = big()
  let two = 0
  two = big()
  two = fl()
  let big2 = [300]
  big2 = bytes()
  let half = 0.5
  half = big()
  print(e + z + two)
  print(big2[0] + half)
}

print(sum(0, 0))
locals()
places()
add()
print(total + scale)
misses()
