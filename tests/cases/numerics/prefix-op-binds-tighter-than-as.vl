// @run
// @log -2147483648
// @log -2147483648
// @log 251
// @log null
// @log 250
// @log 0
// @log 1
// @log -2147483648
// @log 255
// @log 7
// @log 3
// @log -4
// @log true
// @log -2147483648
// @log 2147483648
// Every prefix operator binds tighter than `as`, as in Rust: `-x as T` is `(-x) as T`, so the
// negation happens at the operand's own width and the cast sees its result (D3629). `as` still
// binds tighter than every binary operator, and a type guard still binds tighter than `!`.
function id(n: i32) { n }
function idb(b: boolean) { b }
const m = id(-2147483648)
const v = id(5)
const t = idb(true)
function pu(): i32 | string { 5 }
const u = pu()

function widen(): i64 | null { return -m as i64 }
function byte(): i32 | null { return -v as u8 }

print(-m as! i64)               // (-m) wraps at i32 first: INT_MIN, not 2147483648
print(widen())                  // the propagating spelling agrees
print(-v as% u8)                // (-5) as% u8 = 251
print(byte())                   // (-5) as u8 does not fit, so the function returns null
print(~v as% u8)                // (~5) as% u8 = (-6) as% u8 = 250
print(!t as i32)                // (!true) as i32 = 0
print(!!t as u8)                // (!!true) as u8 = 1
print(-2147483648 as i32)       // the constant -2147483648 fits i32
print(-1 as% u8)                // the constant -1, wrapped: 255
print(-v as i64 + 12)           // ((-v) as i64) + 12 = 7
print(-(-v as f64) as! i32 - 2) // the parenthesised cast still groups: 5 - 2 = 3
print(-(-v) as i64 - 9)         // (-(-v)) as i64 - 9 = -4
print(!(u is string))           // `!x is T` means this (vl fmt spells it so): true
print(-m as! f64)               // (-m) as f64: INT_MIN
print(-(m as! i64))             // the old grouping, spelled out: 2147483648
