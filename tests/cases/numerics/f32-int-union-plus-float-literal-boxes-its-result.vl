// @run
// @log 2.5
// @log 6
// @log 2.5
// @log 3
// @log 0
// A numeric union with an `f32` member and a float literal: the `f32` pair keeps `f32` and the
// `i32` pair computes at `f64`, so the result is an `f32 | f64` box. It boxes, widens to an `f64`
// destination, narrows and prints.
function halfOrInt(h: boolean): f32 | i32 { if h { return 0.5 } return 4 }
function asF64(x: f64) { print(x) }
asF64(halfOrInt(true) + 2.0)
asF64(2.0 + halfOrInt(false))
print(halfOrInt(true) + 2.0)
const s = halfOrInt(true) + 2.5
if s is f32 { print(s) } else { print(s) }
print(halfOrInt(true) * 2.0 - 1.0)
