// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// A join of a runtime `i32` and a runtime `f64` in a function that calls itself is `i32 | f64`, as
// it is in one that does not (D10090): a bound `if`, a returned `??` and a mutually recursive pair.
function g(q: i32 | null, d: f64, n: i32) {
  if n > 0 { g(q, d, n - 1) }
  const r = if q != null { q } else { d }
  print(r is i32)
}
g(5, 1.5, 1)
function ret(q: i32 | null, d: f64, n: i32) {
  if n > 0 { return ret(q, d, n - 1) }
  q ?? d
}
const a = ret(5, 1.5, 2)
print(a is i32 && a == 5)
const b = ret(null, 2.5, 2)
print(b is f64 && b == 2.5)
function ma(q: i32 | null, d: f64, n: i32) {
  if n > 0 { return mb(q, d, n - 1) }
  if q != null { q } else { d }
}
function mb(q: i32 | null, d: f64, n: i32) { ma(q, d, n) }
const c = ma(7, 1.5, 3)
print(c is i32 && c == 7)
