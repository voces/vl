// @check
// @error argument 1: expected f64, got i64
// @error wrong number of arguments: expected 1, got 2
// @error argument 1: expected f32, got f64
// Each saturating truncation takes exactly one operand of the float width its name gives:
// an i64 or a wider float is refused rather than converted.
const a: i64 = 5
print(__trunc_sat_f64_s_i32__(a))
print(__trunc_sat_f32_s_i32__(1.0, 2.0))
const d: f64 = 1.5
print(__trunc_sat_f32_s_i32__(d))
