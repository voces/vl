// @run
// @log 1.5
// @log 0.10000000149011612
// @log -2.5
// @log 1000
// @log 5000000000
// @log 1.5
// @log 1.5
// @log 0.10000000149011612
// @log 0.10000000149011612
// A number literal handed through a hole parameter to an `f32` one is built at `f32`, as the
// direct call builds it: directly, through a `const` alias of the function, through a forwarding
// hole, and where the hole also reads the value itself (D3226).
function H(h, v) { return h(v) }
print(H((x: f32) => x, 1.5))
print(H((x: f32) => x, 0.1))
print(H((x: f32) => x, -2.5))
print(H((x: f32) => x, 1e3))
print(H((x: f32) => x, 5000000000))
const f = (x: f32) => x
print(H(f, 1.5))
function H2(h, v) { return H(h, v) }
print(H2((x: f32) => x, 1.5))
function H3(h, v) {
  print(v)
  return h(v)
}
print(H3((x: f32) => x, 0.1))
