// @check
// @error `as u8` propagates null — use `as!` to trap instead, or `as?` to take the null here, or `as%` to keep its low bits; to propagate it, annotate the enclosing function's return type
// @error `as i32` propagates null — use `as!` to trap instead, or `as?` to take the null here; to propagate it, annotate the enclosing function's return type
// A bare `as` over an un-annotated parameter is re-asked at the call that pins it, through a
// lambda bound to a `const` and through a method receiver alike (D3624).
const k = (x) => x as u8
print(k(300))
function m(self) { self as i32 }
const v = 2.5
print(v.m())
