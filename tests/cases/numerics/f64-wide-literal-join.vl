// @run
// @log 2
// @log 9000000001
// @log 3
// @log 9000000001
// @log 7
// @log 9000000001
// @log 5
// @log 9000000001
// @log 4
// @log 1.5
// @log 4500000000.5
// An `i64` join that is i64 only because an integer literal outgrew i32 delivers into `f64`
// exactly (D5712): `??`, a value `if` and `match`, a return and an assignment. The divisions
// prove the value is a float.
function pick(n: i32): i32 | null {
  if n > 1 { return n }
  return null
}
const v: f64 = pick(2) ?? 9000000001
print(v)
const w: f64 = pick(0) ?? 9000000001
print(w)
function g(c: boolean, n: i32) {
  const r: f64 = if c { n } else { 9000000001 }
  r
}
print(g(true, 3))
print(g(false, 3))
function h(k: i32) {
  const r: f64 = match k {
    1 => 7
    _ => 9000000001
  }
  r
}
print(h(1))
print(h(2))
function ret(n: i32): f64 { pick(n) ?? 9000000001 }
print(ret(5))
print(ret(0))
let m = 0.5
m = pick(4) ?? 9000000001
print(m)
const v2: f64 = pick(3) ?? 9000000001
print(v2 / 2.0)
const w2: f64 = pick(0) ?? 9000000001
print(w2 / 2.0)
