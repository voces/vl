// A narrowing cast is no destination for its operand: a join with a radix tail wider than 32
// bits widens to `i64` (ruling 4.3), and the cast then misses, rather than pinning the tail.
let c = true
c = !c
print((if c { 0 } else { 0x1FFFFFFFF }) as? u8)
print((if c { 0 } else { 0x1FFFFFFFF }) as? i32)
function t(): i32 | null { return (if c { 0 } else { 0x1FFFFFFFF }) as i32 }
print(t())
print((if c { 0 } else { 0x1FFFFFFFF }) as i64)
