// @run
// @log -3
// @log 2
// @log 5000000000
// @log -5000000000
// @log 5000000000
// @log 200
// @log 7
// @log 2147483647
// @log -2147483648
// @log 3
// @log 20
// @log 2
// @log 0
// @log 100
// @log 3
// @log 11
// @log 2
// @log 1.5
// @log 3.5
// @log 1
// @log 1.5
// @log 1
// @log 1
// @log 1
// @log 3
// @log 1
// @log 0.25
// @log 0
// @log 2
// @log 1
// @log 7
// @log 6000000001
// @log 6000000000
// `min` / `max` over integer operands compute at the integer width: an i32 pair is an i32
// (so `min(a, b) / 2` is integer division), i64 when either side is i64, and a `u8` element
// widens to i32. A float operand, literal or not, keeps the float intrinsic, and an
// un-annotated operand takes its width per call, as `a / b` does.
const a = 3
const b = -7
print(min(a, b) / 2)
print(max(10, 3) / 4)

// i64 at both sides, and i32 mixed with i64 (the i32 side widens).
const big = 5000000000
print(max(big, 1))
print(min(big, -big))
print(max(a, big))

// A `u8[]` element reads as an i32.
const bs: u8[] = [200, 7]
print(max(bs[0], bs[1]))
print(min(bs[0], bs[1]))

// The compare is signed at the extremes.
const hi = 2147483647
const lo = -2147483648
print(max(hi, lo))
print(min(hi, lo))

// Nested on both sides.
print(min(max(a, 0), min(10, max(b, 5))))

// Each operand is evaluated exactly once, left to right.
let n = 0
function bump() {
  n = n + 1
  n * 10
}
print(max(bump(), bump()))
print(n)

// In a lambda and in a loop accumulator.
const clamp = (x: i32) => min(max(x, 0), 100)
print(clamp(-5))
print(clamp(500))
let best = 1000
for x in [5, 3, 9] { best = min(best, x) }
print(best)

// Through a field and an element.
const p = { x: 4, y: 11 }
print(max(p.x, p.y))
const xs = [8, 2, 6]
print(min(xs[0], xs[1]))

// A float operand keeps the float intrinsic.
print(min(1.5, 2))
print(max(a, 3.5))

// Un-annotated operands decide per call, like an operator's.
function g(a, b) { min(a, b) }
print(g(3, 7) / 2)
print(g(1.5, 2.0))
print(g(5000000000, 1))
function nest(a, b, c) { min(max(a, b), c) }
print(nest(1, 5, 3) / 2)

// A literal type counts as its base: a literal union or a single literal is an integer
// operand, at a destination with and without an annotation.
type D = 1 | 2
const d: D = 2
print(min(d, 5) / 2)
const single: 3 = 3
print(max(single, 1))
const dd = d
print(max(dd, 1) / 2)
function lf(x: D): f64 { min(x, 5) }
print(lf(1) / 4)
function lu(x: D) { max(x, 1) }
print(lu(2) / 4)
print(g(d, 5))
const ds: D[] = [2, 1]
let lacc = 10
for e in ds { lacc = min(lacc, e) }
print(lacc)
type Z = 5000000000 | 6000000000
const z: Z = 6000000000
print(min(z, 7))
print(max(z, 1) + 1)
const zz = z
print(max(zz, a))
