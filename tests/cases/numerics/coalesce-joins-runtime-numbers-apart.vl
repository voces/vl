// @run
// @log i32
// @log 3
// @log <7>
// @log 7
// @log true
// @log f64
// @log 3.375
// @log <6.75>
// @log 6.75
// @log false
// @log f64
// @log 1.25
// @log i32
// @log -1
// @log i32
// @log i32
// @log i32
// @log i32
// @log 7
// @log 14
// @log f64
// @log f64
// @log 0.5
// @log 9000000001
// @log i64
// @log f32
// @log f64
// @log f64
// @log 7
// @log 7
// @log i64
// @log f32
// @log i32
// @log i32
// @log i64
// @log i64
// @log f64
// @log f64
// A `??` whose default is a runtime number of another type joins the two as a union, as the
// `if` it spells does: `q ?? b` and `if q != null { q } else { b }` agree at every position, and
// a literal default still adapts (D3451).
import { filled } from "std:array"

function kind<T>(v: T) {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}

function id<T>(v: T) { v }

function hole(v) { kind(v) }

function ret(q: i32 | null, b: f64) { q ?? b }

function bind(q: i32 | null, b: f64) {
  const r = q ?? b
  print(kind(r))
  print(r / 2)
  print("<\{r}>")
  print(r)
  print(r is i32)
}
bind(7, 6.75)
bind(null, 6.75)

// The other operand order: an `f64 | null` left beside an `i32` default.
function left(m: f64 | null, y: i32) {
  const e = m ?? y
  print(kind(e))
  print(e / 2)
}
left(2.5, -3)
left(null, -3)

// Return, generic pin, hole, field, list element and `std:array`.
function places(q: i32 | null, b: f64) {
  print(kind(ret(q, b)))
  print(kind(id(q ?? b)))
  print(hole(q ?? b))
  const o = { v: q ?? b }
  print(kind(o.v))
  print([q ?? b][0])
  print(filled(2, q ?? b)[1] * 2)
}
places(7, 6.75)

// A literal default adapts, and a delivery into a wider declared number converts.
function lits(q: i32 | null, n: i64 | null, f: f32 | null, m: i64, g: f32) {
  print(kind(q ?? 2.5))
  const w: f64 = q ?? g
  print(kind(w))
  print(w)
  const z: i64 = q ?? m
  print(z)
  print(kind(n ?? 5))
  print(kind(f ?? 5))
}
lits(null, null, null, 9000000001, 0.5)
lits(7, null, 2.5, 9000000001, 0.5)

// A chain, grouped either way, joins each runtime link apart.
function chain(q: i32 | null, r: i64 | null, b: f64) {
  print(kind(q ?? r ?? b))
  print(kind(q ?? (r ?? b)))
}
chain(7, null, 0.5)
chain(null, 9000000001, 0.5)
chain(null, null, 0.5)
