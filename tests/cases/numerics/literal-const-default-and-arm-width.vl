// @run
// @log 4294967295
// @log 4294967295
// @log true
// @log B
// @log other
// @log B2
// @log other
// @log K
// @log 3.5
// @log 0.10000000149011612
// @log 0.10000000149011612
// A parameter default and a `match` arm are reads of a literal `const` like any other, so each
// takes the literal at the parameter's or the scrutinee's type: `0xFFFFFFFF` is 4294967295 at
// `i64` there as in `let a: i64 = B`, and a float default reaches an `f32` parameter (D3246).
const B = 0xFFFFFFFF
const B2 = B
function f(x: i64 = B) { x }
print(f())
function f2(x: i64 = B2) { x }
const a: i64 = B
print(f2())
print(f() == a)
function m(x: i64) {
  match x {
    B => "B"
    _ => "other"
  }
}
print(m(4294967295))
print(m(-1))
function m2(x: i64) {
  match x {
    B2 => "B2"
    _ => "other"
  }
}
print(m2(4294967295))
print(m2(-1))
const K = 3000000000
function m3(x: i64) {
  match x {
    K => "K"
    _ => "other"
  }
}
print(m3(3000000000))
const H = 7
function g(x: f64 = H) { x }
print(g() / 2)
const T = 0.1
function h(x: f32 = T) { x }
print(h())
function h2(x: f32 = 0.1) { x }
print(h2())
