// @check
// @hint redundant type annotation: `mul32` is inferred as `f32`
// @hint redundant type annotation: `one32` is inferred as `f32`
// @hint redundant type annotation: `first64` is inferred as `i64`
// @hint redundant type annotation: `src` is inferred as `f64`
// @hint redundant type annotation: `f` is inferred as `f32`
// @error-at 29:26 argument 1: expected f32, got f64 — `TABLE` on line 29 has no annotation, so its literal defaulted to `f64[]`; annotate it: `const TABLE: f32[] = …`
// @hint redundant type annotation: `T` is inferred as `f64[]`
// @error-at 63:14 i32[] is not i64[]: a container never widens implicitly, and only a readonly list is covariant. Its elements would be stored differently, so it would be a copy, and a write through either list would not reach the other. Declare the destination `readonly i64[]` for a read-only view, or copy it with `.map((x) => x as i64)` — `L` on line 37 has no annotation, so its literal defaulted to `i32[]`; annotate it: `const L: i64[] = …`
// @error-at 65:12 argument 1: expected f32, got f64 — `LIT` on line 43 has no annotation, so its literal defaulted to `f64[]`; annotate it: `const LIT: f32[] = …`
// @error-at 66:12 argument 1: expected f32, got f64
// @error-at 67:12 argument 1: expected f32, got f64
// @error-at 68:12 argument 1: expected f32, got f64
// @error-at 68:12 `w` takes its type from its uses, and they conflict: the use on line 53 needs `f64` and the use on line 69 needs `f32` — annotate `w`
// @error-at 69:12 argument 1: expected f32, got f64
// @error-at 70:12 argument 1: expected f32, got f64
// @error-at 71:12 argument 1: expected f32, got f64
// D2860 (plumb PL-052): a list literal still defaults to its base type, and a mismatch whose value
// reads one names the declaration and the annotation that fixes it. A literal `const` is its
// literal at every read and a literal `let` takes its stores' type (D3246): `X`, `NEG` and `y`
// check, and `w` conflicts. Line and column are 0-based.

function mul32(a: f32, b: f32): f32 { a * b }
function one32(a: f32): f32 { a }
function first64(a: i64[]): i64 { a[0] }
function src(): f64 { 3.0 }

// A list read through an index.
const TABLE = [1.0, 0.0, 0.0, 1.0]
function f(): f32 { mul32(TABLE[0], 1.0) }

// A scalar, and a negated one.
const X = 1.5
const NEG = -1.5

// An integer list where an i64 list is wanted.
const L = [1, 2]

// A `let` reassigned only with literals, and a list written only with literals.
let y = 1.5
y = 2.5
y += 1.0
const LIT = [1.0, 2.0]
LIT[1] = 3.0
LIT.push(4.0)

// No note: an annotated declaration, a non-literal initializer, a non-literal write, and a list
// a non-literal element write or push reaches, whether `const` or `let`. A directive matches by
// substring, so the note's absence is pinned in tests/lsp_wasm_checker_test.ts.
const T: f64[] = [1.0]
const V = T[0]
let w = 1.5
w = src()
const EW = [1.0, 0.0]
EW[1] = src()
const PU = [1.0, 0.0]
PU.push(src())
let LW = [1.0, 0.0]
LW[0] = src()

print(f())
print(one32(X))
print(one32(NEG))
print(first64(L))
print(one32(y))
print(one32(LIT[0]))
print(one32(T[0]))
print(one32(V))
print(one32(w))
print(one32(EW[0]))
print(one32(PU[0]))
print(one32(LW[0]))
