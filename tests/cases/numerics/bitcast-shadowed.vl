// @run
// @log 99
// @log true
// A numeric-opcode intrinsic is a FALLBACK for a name the program did not define:
// a function of the same name wins, in the checker and in the emitter alike. Adding
// an intrinsic therefore cannot capture a call that already resolved to the
// program's own function.
function f32bits(x: f32): i32 {
  if x > 0.0 { return 99 }
  return -99
}

const one: f32 = 1.0
print(f32bits(one)) // the program's own function, not `i32.reinterpret_f32`
print(f64bits(1.0) == 4607182418800017408) // the un-shadowed sibling is unaffected
