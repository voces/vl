// @check
// @error `as i32` propagates null, which the enclosing function cannot return (it returns void) — use `as!` to trap instead, or `as?` to take the null here
// @error `as i32` propagates null, which the enclosing function cannot return (it returns void) — use `as!` to trap instead, or `as?` to take the null here
// @error `as i32` propagates null, which the enclosing function cannot return (it returns void) — use `as!` to trap instead, or `as?` to take the null here
// A bare `as` over the result of calling a hole parameter is judged at the call that pins the
// hole, at that call's own result type, as a cast over an `f64` binding is (D8060).
function add(a, b) { return a + b }
function p(g) { print(g(1.5, 2.5) as i32) }
p(add)
function q(g) { print(g(1.5) as i32) }
q((x: f64): f64 => x)
function need(x: i32) { print(x) }
function r(g) { need(g(1.5, 2.5) as i32) }
r(add)
