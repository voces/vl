// @run
// @log 1065353216
// @log 1065353216
// @log -1082130432
// @log 1065353216
// @log 1065353216
// @log 1073741824
// @log 1065353216
// @log 1065353216
// @log 1106771968
// @log 1090519040
// @log 1077936128
// @log 1073741824
// @log 1065353216
// @log -1082130432
// @log 31
// @log 4
// @log 1069547520
// @log 1069547520
// @log 1065353216
// A numeric-opcode intrinsic's OPERAND takes its width from the OPERATION, never from
// the position the CALL sits in — the same rule a call ARGUMENT already obeys
// (`f32-context-call-argument.vl`), stated now for the three intrinsic families.
//
// Master leaked the enclosing wide-scalar context into the operand: `pendingF32` is
// read FIRST in `emitNumLitNode`, so every literal in reach of an f32 position lowered
// as `f32.const` — `f32.reinterpret_i32` handed an f32, `i32.clz` handed an f32,
// `f64.nearest` handed an f32. Measured over a 19-context x 22-expression matrix, 197
// of 418 cells were `vl check`-clean INVALID WASM, plus 3 more in the i64 mirror.
//
// The operand spines now clear the context (`emitNumIntrArg`, the four-width twin of
// the memory intrinsics' `emitMemIntrinArg`). The `f32bits` round trip is what makes
// this a VALUE pin and not a validity check: a wrongly-encoded operand that happened
// to validate would still have to arrive as the right BIT PATTERN, and
// `f32.const 1065353216` rounds to 1065353200 — a different float entirely.

// ── the bitcast pair: an i32 operand under every f32 context ──────────────────
// A module `: f32` global (its init runs in the start function).
const a: f32 = f32fromBits(1065353216) // 1.0f
print(f32bits(a))

// An f32 `return` and the implicit f32 TAIL.
function viaReturn(): f32 { return f32fromBits(1065353216) }
function viaTail(): f32 { f32fromBits(-1082130432) } // -1.0f
print(f32bits(viaReturn()))
print(f32bits(viaTail()))

// An f32 BINDING, with the literal nested one level deeper than the operand root.
function viaLet(): i32 {
  const q: f32 = f32fromBits(1065353216 + 0)
  f32bits(q)
}
print(viaLet())

// f32 list push, f32 element assignment, and the f32 linear-memory store.
const xs: f32[] = []
xs.push(f32fromBits(1065353216))
print(f32bits(xs[0]))
const ys: f32[] = [0.0]
ys[0] = f32fromBits(1073741824) // 2.0f
print(f32bits(ys[0]))
__store_f32__(0, f32fromBits(1065353216))
print(f32bits(__load_f32__(0)))

// An f32 atom coerced into a value UNION.
const u: f32 | boolean = f32fromBits(1065353216)
function unwrap(x: f32 | boolean): i32 {
  if x is f32 { f32bits(x) } else { -1 }
}
print(unwrap(u))

// ── the INTEGER ops, whose operands are i32 under an `as f32` ─────────────────
const c1: f32 = (clz(1) as f32) // 31.0f
print(f32bits(c1))
const c2: f32 = (popcnt(255) as f32) // 8.0f
print(f32bits(c2))
const c3: f32 = (divU(7, 2) as f32) // 3.0f
print(f32bits(c3))

// ── a FLOAT op resolved at f64 width inside an f32 context ────────────────────
const c4: f32 = (nearest(2.5) as f32) // round-half-to-EVEN gives 2.0
print(f32bits(c4))

// ── nested: the f32 operand of a float op is itself a bitcast ─────────────────
const c5: f32 = sqrt(f32fromBits(1065353216))
print(f32bits(c5))
const c6: f32 = copysign(f32fromBits(1065353216), f32fromBits(-1082130432))
print(f32bits(c6))

// ── the i64 MIRROR: an i32-width integer op inside an i64 PARAMETER ───────────
// `pendingI64` leaked the same way, one width over: the operand of `i32.clz` is an
// i32 however wide the position that consumes the result.
function takei64(x: i64): i64 { x }
print(takei64(clz(1)))
print(takei64(rotl(1, 2)))

// ── controls: the float-literal-adapts-to-f32 rule is untouched ───────────────
const lit: f32 = 1.5
print(f32bits(lit))
print(f32bits(min(lit, 2.5)))
// A VARIABLE argument carries its own rep and was never affected.
const bvar = 1065353216
const viaVar: f32 = f32fromBits(bvar)
print(f32bits(viaVar))
