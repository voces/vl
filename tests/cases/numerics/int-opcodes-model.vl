// The scalar bit-counting and rotate intrinsics against an independent model: Python's
// unbounded integers masked to the width (`clz` = width - bit_length, `ctz` = index of the
// lowest set bit or the width for 0, `popcnt` = count of ones, a rotate count taken modulo
// the width). Edge values 0, 1, -1, powers of two and both extremes, then values from
// `random.Random(32)`. Every result at i64 is an i64, because `i64.clz` leaves one.
function bits32(x: i32) {
  print(clz(x))
  print(ctz(x))
  print(popcnt(x))
}

function rot32(x: i32, n: i32) {
  print(rotl(x, n))
  print(rotr(x, n))
}

function bits64(x: i64) {
  print(clz(x))
  print(ctz(x))
  print(popcnt(x))
}

function rot64(x: i64, n: i64) {
  print(rotl(x, n))
  print(rotr(x, n))
}

