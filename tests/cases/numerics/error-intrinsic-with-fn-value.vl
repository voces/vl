// @emit-error the numeric intrinsic 'sqrt' is mistaken for a captured variable
// The sharper face of the same capture-analysis gap, and the one a real program hits:
// `dist` is an ORDINARY named function, but the module also uses a function value, and
// a module that does routes every "capturing" function through its closure env. `sqrt`
// sits in `dist`'s capture list because capture analysis does not know the name is a
// lowering target, so the env build has nothing to read. Without the lambda on line 10
// this file compiles and prints 5.
function dist(x: f64, y: f64): f64 { sqrt(x * x + y * y) }

const inc = (a: i32) => a + 1
print(inc(1))
print(dist(3.0, 4.0))
