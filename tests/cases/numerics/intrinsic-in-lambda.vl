// @run
// @log 3
// @hint redundant type annotation: `xs` is inferred as `f64[]`
// A numeric-opcode intrinsic CALLED FROM A LAMBDA. This used to be
// `error-intrinsic-in-lambda.vl`, pinning `emitProgram: the numeric intrinsic
// 'sqrt' is mistaken for a captured variable here`: capture analysis records
// every free identifier that is not locally bound, a module global or a
// collected function, and an intrinsic is none of those, so its NAME rode the
// lambda's capture list and the env build had nothing to read it from.
//
// `capScan`'s Call arm now exempts `isNumIntrinsicName` beside the two lists it
// already asked (`isBuiltinFnName`, `nameIsEmitterIntrinsic`) — the same
// POSITIONAL exemption, for the same reason: in callee position the name
// denotes an opcode. The exemption is guarded on nothing in scope binding the
// spelling, because unlike the dunder family these names are not reserved;
// `intrinsic-name-shadowed-by-function-in-lambda.vl` is that side.
const xs: f64[] = [1.0, 4.0, 9.0]
const ys = xs.map((v: f64) => sqrt(v))
print(ys[2])
