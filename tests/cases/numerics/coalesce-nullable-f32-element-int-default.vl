// @run
// @log 9
// @log true
// @log 7
// @log 1.5
// @log false
// @log 0.5
// A `??` over a nullable `f32` element whose default is an `i32` call or variable joins apart
// into `f32 | i32`, and runs at top level: the null element takes the default, the non-null
// control keeps its `f32` (D9701). An `i64` element with an `f64` literal default joins the same way.
const x: f32 = 1.5
const k: (f32 | null)[] = [x, null]
const kk: (f32 | null)[] = [x, x]
function dc() { 9 }
const dz = 7
const r = k[1] ?? dc()
print(r)
print(r is i32)
print(k[1] ?? dz)
const c = kk[1] ?? dc()
print(c)
print(c is i32)
const j: (i64 | null)[] = [3, null]
print(j[1] ?? 0.5)
