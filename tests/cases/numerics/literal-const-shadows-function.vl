// @run
// @log 1
// @log 1
// @log 8
// @log top
// @log 3000000000
// @log 4294967295
// @hint redundant type annotation: `x` is inferred as `i64` — remove it to lean on inference
// A literal `const` that shadows a function is its literal at every read, closures included,
// and a binding copying it holds that literal, so no alias of the shadowing local is formed
// for D2443 to mistype. A local literal `const` shadowing a module one is its own literal.
function w() { return "top" }
function g() {
  const w = 1
  const r = w
  print(r)
  const cl = () => w
  print(cl())
}
g()
function size() { "top" }
function h() {
  const size = 4
  const n = size
  const f = () => size
  print(n + f())
}
h()
print(size())
const J = 0xFFFFFFFF
function j() {
  const J = 3
  const x: i64 = J * 1000000000
  print(x)
}
j()
const big: i64 = J
print(big)
