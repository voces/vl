// @run
// @log 1.5
// @log -1.5
// @log 1
// @log -1
// @log -1.5
// @log -1.5
// @log 1.5
// @log 1
// @log 1
// @hint redundant type annotation: `g` is inferred as `f64`
// @hint redundant type annotation: `i` is inferred as `i32`
// A literal under MORE THAN ONE unary minus, in an f32 context. The float half is a
// PRE-EXISTING invalid-wasm bug, reproduced on master before the fix:
//
//   const x: f32 = -(-1.5)      -> WebAssembly translation error
//   const x: f32 = -(-(-1.5))   -> the same
//
// `vl check` clean, while the f64 twin ran fine.
//
// The cause is a checker/emitter DISAGREEMENT about the same peel. `isFloatLitExpr` — and
// now `isExactF32IntLitExpr` — recurse through unary minus when deciding that an expression
// is a literal and may adopt the f32 context. `emitExprAsF32` matched exactly ONE minus, so
// a doubly-signed literal was admitted by the checker and then not recognized as a literal
// by the emitter, which lowered it through the f64 path into an f32 slot.
//
// Both sides now share one peel (`signedNumLitText`), which folds any number of signs into
// the literal's text. `f32Bytes` parses a leading `-`, so the fold costs no `f32.neg`.

// The two spellings that FAILED on master.
const a: f32 = -(-1.5)
print(a)
const b: f32 = -(-(-1.5))
print(b)

// Their INTEGER twins, reachable since the P2 grant. Without the shared peel these would
// have been a clean type-error reject on master turning into invalid wasm here — a
// regression in failure MODE, which is why the emitter was fixed rather than the checker
// narrowed.
const c: f32 = -(-1)
print(c)
const d: f32 = -(-(-1))
print(d)

// CONTROLS — one sign, and a sign outside grouping parens, both of which already worked.
const e: f32 = -1.5
print(e)
const f: f32 = -(1.5)
print(f)

// The f64 twins, which were correct throughout.
const g: f64 = -(-1.5)
print(g)
const h: f64 = -(-1)
print(h)

// An i32 destination is untouched by any of this.
const i: i32 = -(-1)
print(i)
