// @check
// @error constant -1 does not fit `u8` (0..=255) — write `as%` to keep its low bits
// @error constant -0.5 is not a whole number, so `i32` cannot hold it
// @error constant -6 does not fit `u8` (0..=255) — `as!` on it would trap on every run
// @error constant -128 does not fit `u8` (0..=255) — `as?` on it would be null on every run
// @error constant -2147483649 does not fit `i32` (-2147483648..=2147483647) — write `as%` to keep its low bits
// A prefix operator binds tighter than `as`, so the cast's operand is the negated (or
// bit-flipped) constant, and the constant rule judges that value (D3629): `-1 as u8` is the
// constant -1, which no byte holds, not a negated byte.
function f() {
  print(-1 as u8)
  print(-0.5 as i32)
  print(~5 as! u8)
  print(-128 as? u8 ?? 0)
  print(-2147483649 as i32)
  0
}

print(f())
