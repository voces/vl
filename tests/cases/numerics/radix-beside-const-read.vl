// @run
// @log 3000000000
// @log -1024819114
// @log 8589934588
// A literal `const`'s read is its value written in place (T2.4): beside a radix literal, a value
// outside `i32` is the `i64` context (D16492) and one that fits is `i32`, however it was spelled.
// A radix tree `const` computes at each read's own width (D14990).
const a = 3000000000
print(0xFFFFFFFF & a)
const b = 9223372036854775807 / (-9000000003)
print(0xFFFFFFFF & b)
const p = 0x7FFFFFFF << 2
const w: i64 = p
print(w)
