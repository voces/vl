// @run
// @log 0.1
// @log 0.1
// An assignment's literal value is read at the literal's own f64 type even in a program that
// spells only f32, so printing it needs the f64 print import.

let h: f32 = 1.0
h = 0.5
const y = (h = 0.1)
print(y)

function locF32() {
  let l: f32 = 1.0
  l = 0.1
}
print(locF32())
