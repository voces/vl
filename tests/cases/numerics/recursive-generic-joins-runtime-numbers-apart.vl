// @run
// @log true
// @log true
// @log 0
// @log true
// @log false
// @log 3
// @log 1.25
// @hint redundant type annotation: `x` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `y` is inferred as `f64` — remove it to lean on inference
// A recursive generic joins a runtime `i32` and `f64` apart at its pin, as a non-recursive one
// does, and a function named like a member a body reads (`get` beside `m.get`) is not held to
// the widening by that read (D10280, D10281, D3494).
function g<T>(q: T | null, d: f64, n: i32) {
  if n > 0 { g(q, d, n - 1) }
  const r = if q != null { q } else { d }
  print(r is i32)
}
g(5, 1.5, 1)

function get(q: i32 | null, d: f64) {
  const r = if q != null { q } else { d }
  print(r is i32)
}
const m: Map<string, i32> = Map()
print(m.get("a") ?? 0)
get(5, 1.5)
get(null, 2.5)

function f<A, B>(k: i32, a: A, b: B) {
  if k == 0 { return a }
  b
}
function w<A, B>(k: i32, d: i32, p: A, q: B) {
  if d > 0 { return w(k, d - 1, p, q) }
  f(k, p, q)
}
const x: i32 = 7
const y: f64 = 2.5
print(w(0, 2, x, y) / 2)
print(w(1, 2, x, y) / 2)
