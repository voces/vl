// @run
// @log 0.1
// @log 8
// @log 0.1
// @log 0.1
// @log 0.1
// @log 9000000003
// An assignment whose right-hand side is a number literal yields that literal, built at the
// width of the position reading the assignment, while the cell receives it at the cell's
// width. So `k(g32 = 0.1)` hands `k` the f64 `0.1`, not the f32 cell re-read, and
// `let y = (gi = 7)` binds the literal at the binding's own type.

let gi: i64 = 0
let g32: f32 = 1.0

function k(v: f64) { return v }
print(k(g32 = 0.1))

const y = (gi = 7)
print(y + 1)

// An un-annotated function whose tail is the assignment returns the literal too.
function h() { g32 = 0.1 }
print(h())

// A local or parameter cell as the tail target: the result is the literal's own type, f64 or
// i32, whatever the cell's width, and the caller reads it at that type.
function locF32() {
  let l: f32 = 1.0
  l = 0.1
}
function parF32(p: f32) { p = 0.1 }
function locI64() {
  let l: i64 = 0
  l = 3
}
print(locF32())
print(parF32(2.0))
print(locI64() + 9000000000)
