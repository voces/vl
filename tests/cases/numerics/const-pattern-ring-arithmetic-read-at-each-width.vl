// @run
// `+`, `-` and `*` over a radix pattern fold to a pattern when the exact result fits 32 bits, so
// a `const` holding one reads as the computation at each use's width: `i32` wraps, `i64` and
// `f64` do not (D3479).
const MI = 0x7FFFFFFF + 1
const a: i64 = MI
const b: f64 = MI
const c: i32 = MI
print(a)
print(b)
print(c)
print(MI)
function wide(): i64 { MI }
print(wide())
const N = 0xFFFF * 0x10000
const n: i64 = N
print(n)
const D = 0x80000000 - 1
const d: i64 = D
print(d)
// @log 2147483648
// @log 2147483648
// @log -2147483648
// @log -2147483648
// @log 2147483648
// @log 4294901760
// @log 2147483647
