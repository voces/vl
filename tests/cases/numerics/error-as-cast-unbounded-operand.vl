// A cast stays fallible when its operand's shape does not hold it inside the target (D3622): a
// negative mask keeps the sign, a mask read from a variable is no constant, a bound past the
// target is no bound for it, `|` and `>>` are not among the rules, and `%` of an operand that
// may be negative may be negative.
const MINUS = -256
function f(x: i32, m: i32, wide: i64) {
  const a = (x & -256) as u8
  const b = (x & m) as u8
  const c = (x & 0x1FF) as u8
  const d = (x >>> 23) as u8
  const e = ((x & 0x7F) | 1) as u8
  const r = (x % 256) as u8
  const g = (x >> 24) as u8
  const h = (wide & 0xFFFFFFFF) as i32
  const i = (wide >>> 32) as i32
  const j = (x & MINUS) as u8
  const k = (x & 0xFFFFFFFF) as u8
  print(a + b + c + d + e + r + g + h + i + j + k)
}
f(-123456789, 255, -1234567890123)
