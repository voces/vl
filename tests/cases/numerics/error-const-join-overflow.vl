// @check
// @error-at 9:49 constant 2147483648 overflows i32 — write 0x80000000 for its bit pattern
// @error-at 12:9 constant 3000000000 overflows i32 — write 0xb2d05e00 for its bit pattern
// @error-at 17:27 constant 2147483648 overflows i32 — write 0x80000000 for its bit pattern
// @error-at 21:51 constant 4294967296 overflows i32
// A constant that overflows `i32` inside a join (an `if` or `match` arm, under an integer
// operator) is refused in its own words at the constant, as it is when it stands alone, not as
// the join's `expected i32, got i64`: at a return, a binding and an argument (D3780, sunpa
// SP-047). A value in the sign bit's range also names the hex literal that is its bit pattern.
function packed(held: boolean): i32 { (if held { 1 << 31 } else { 0 }) | 5 }
function word(k: i32): i32 {
  match k {
    0 => 3000000000
    _ => -1
  }
}
function lead(held: boolean): i32 {
  const v: i32 = if held { 2147483648 } else { 0 }
  v
}
function id(v: i32): i32 { v }
function passed(held: boolean): i32 { id(if held { 1 << 32 } else { 1 }) }
print(packed(true) + word(0) + lead(true) + passed(true))
