// @check
// @error cannot assign i32 | null to 'x' of type i32
// @error return type mismatch: expected i32, got i32 | null
// `a as? i32` over a hole is `i32 | null` before any pin, so an annotated destination refuses
// it as the annotated parameter's spelling does (D1400).
const u: i32 | null = 5
function take(a) {
  const x: i32 = a as? i32
  print(x)
}
take(u)
function back(a): i32 { return a as? i32 }
print(back(u))
