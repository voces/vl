// @check
// @error sqrt expects 1 argument, got 2
// @error min expects 2 arguments, got 1
// @error sqrt expects f64, got string
// @error clz expects i32, got f64
// @error rotl expects i32, got string
// @error ltU expects i32, got boolean
// The intrinsics carry a real signature: arity is fixed, and every argument is checked
// against the WIDTH the call computes at, so a wrong operand is a type error rather
// than a silent conversion.
print(sqrt(1.0, 2.0))
print(min(1.0))
print(sqrt("x"))
print(clz(1.5))
print(rotl(1, "x"))
print(ltU(1, true))
