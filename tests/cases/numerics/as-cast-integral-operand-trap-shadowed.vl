// @trap
// A local closure named `floor` is not the intrinsic, so its result is not integral by
// construction: `floor(1.0)` here is 1.5, and `as! i32` traps on the fraction. The trailing
// print never runs.
function main() {
  const floor = (x: f64): f64 => x + 0.5
  print(floor(1.0) as! i32)
  print(-1)
}
main()
