// A float tree over a value join of literals, or a negated join, adopts a typed `f32` beside it,
// a `min`/`max` over one, and an `f32` destination, as the join alone does (ruling 4.3).
function cond() { return false }
const c = cond()
const a: f32 = -0.25
print(min(a, (if c { 0.1 } else { 0.5 })) - 0.01)
print(max(a, (if c { 0.1 } else { -0.5 })) - 0.01)
const b: f32 = 1.0
print(b + (16777217.0 * (if c { 2.0 } else { 1.0 })))
print((16777217.0 * (if c { 2.0 } else { 1.0 })) + b)
print(a + (0.5 * (if c { 0.1 } else { 0.5 })) - 0.01)
print(a + -(if c { 0.1 } else { 0.3 }))
const x: f32 = 0.1 * (if c { 0.3 } else { 0.7 })
print(x)
const y: f32 = -(if c { 0.3 } else { 0.7 })
print(y)
const m = min(a, 0.5 * (if c { 0.1 } else { -0.7 }))
print(m)
const u = 0.1 * (if c { 0.3 } else { 0.7 })
print(u)
