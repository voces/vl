// @run
// @log -294967296
// @log -294967296
// @log -294967295
// @log 2
// @log 6000000000
// An `as!` cast of a float constant is a typed value, not a constant, so a tree over it computes
// at the cast's width and wraps there before a wider destination reads it (E9.1).
const x: i64 = (2.0 as! i32) * 2000000000
print(x)
function f(): i64 { return (2.0 as! i32) * 2000000000 }
print(f())
const w: i64 = 1
print(w + (2.0 as! i32) * 2000000000)
const y: i64 = 2.0 as! i32
print(y)
const z = (3000000000.0 as! i64) * 2
print(z)
