// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 2.5
// @log 8
// @log 9
// @log 10
// @log 11
// @log 12
// @log 13
// @log 14
// @log 14
// @log 21
// @log 7.5
// @log b
// @log true
// @log 1
// @log 1
// @log 2
// @log 2
// @hint redundant type annotation: `gf` is inferred as `f64`
// @hint redundant type annotation: `tailF32CellF64Ret` is inferred as `f64`
// @hint redundant type annotation: `takeI64` is inferred as `i64`
// @hint redundant type annotation: `tailWideRhs` is inferred as `i64`
// @hint redundant type annotation: `tailF64Literal` is inferred as `f64`
// @hint redundant type annotation: `gs` is inferred as `string`
// @hint redundant type annotation: `tailString` is inferred as `string`
// @hint redundant type annotation: `gb` is inferred as `boolean`
// @hint redundant type annotation: `tailBool` is inferred as `boolean`
// @hint redundant type annotation: `bumps` is inferred as `i32`
// @hint redundant type annotation: `bump` is inferred as `i32`
// An ASSIGNMENT used as a VALUE carries its CELL's numeric rep, not its right-hand side's.
//
// Assignment is an expression yielding a RE-READ of its target, so `g = 7` over an
// `: i64` cell leaves an i64 on the stack. The `emitExprAs*` widenings classified that
// expression as the RHS instead — an i32 literal — so every widening boundary emitted
// the i64 cell and then widened it AGAIN: `i64.extend_i32_s` over an i64, an invalid
// module from two ordinary lines with `vl check` clean.
//
// The axis is WIDENING, not tail position: an already-wide RHS (`g = h`) escaped because
// the checker types THAT assignment node i64, which the classifier's typed-IR fast path
// reads. And every value position was affected, not just the implicit-return one — the
// rows below walk the tail, an explicit `return`, a parenthesized tail, a call ARGUMENT,
// a binding initializer, an if-arm tail and a chained assignment.
//
// The last pair is the load-bearing one: the widening moves the CLASSIFICATION only, so
// the right-hand side is still evaluated EXACTLY ONCE. A double evaluation would print
// the bump counter as 2.

let gi: i64 = 0
let gf: f64 = 0.0
let g32: f32 = 1.0

// tail position — global, local and PARAM cells
function tailGlobalI64(): i64 { gi = 7 }
print(tailGlobalI64())

function tailLocalI64(): i64 {
  let l: i64 = 0
  l = 7
}
print(tailLocalI64())

function tailParamI64(p: i64): i64 { p = 7 }
print(tailParamI64(1))

function tailGlobalF64(): f64 { gf = 7 }
print(tailGlobalF64())

// the cell is NARROWER than the return: the widening still has to happen, once
function tailI64CellF64Ret(): f64 { gi = 7 }
print(tailI64CellF64Ret())

function tailF32CellF64Ret(): f64 { g32 = 2.5 }
print(tailF32CellF64Ret())

// the other value positions
function explicitReturn(): i64 { return gi = 8 }
print(explicitReturn())

function parenTail(): i64 { (gi = 9) }
print(parenTail())

function takeI64(v: i64): i64 { return v }
print(takeI64(gi = 10))

const bound: i64 = (gi = 11)
print(bound)

function ifArm(pick: boolean): i64 {
  if pick { gi = 12 } else { gi = 13 }
}
print(ifArm(true))
print(ifArm(false))

let hi: i64 = 0
function chained(): i64 { hi = (gi = 14) }
print(chained())
print(gi)

// CONTROLS — an already-wide RHS, and the non-widening cells, all unchanged.
const wide: i64 = 21
function tailWideRhs(): i64 { gi = wide }
print(tailWideRhs())

function tailF64Literal(): f64 { gf = 7.5 }
print(tailF64Literal())

let gs: string = "a"
function tailString(): string { gs = "b" }
print(tailString())

let gb: boolean = false
function tailBool(): boolean { gb = true }
print(tailBool())

// SINGLE EVALUATION: a side-effecting RHS at a widening tail must bump exactly once.
let bumps: i32 = 0
function bump(): i32 {
  bumps = bumps + 1
  return bumps
}
function sideEffectI64(): i64 { gi = bump() }
print(sideEffectI64())
print(bumps)

function sideEffectF64(): f64 { gf = bump() }
print(sideEffectF64())
print(bumps)
