// @run
// @log true
// @log 10
// @log 1.5
// @log true
// @log 10
// @log 1.5
// @log true
// @log 10
// @log 1.5
// @log true
// @log 10
// @log 1.5
// @log i32
// @log i64
// @log i64
// @log f64
// @log f64
// @log 2.5
// A `??` over a record field, a list element or a method call's result joins a runtime number
// of another type apart, as the same `??` over a parameter does, and a literal default still
// adapts (D10061).
function kind<T>(v: T) {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f64 { return "f64" }
  "other"
}

function show(r: i32 | f64) {
  print(r is i32)
  print(r * 2)
}

function field(o: { v: i32 | null }, d: f64) {
  const r = o.v ?? d
  if r is i32 { show(r) } else { print(r) }
}
field({ v: 5 }, 1.5)
field({ v: null }, 1.5)

function elem(a: (i32 | null)[], d: f64) { return a[0] ?? d }
show(elem([5], 1.5))
print(elem([null], 1.5))

function read(m: Map<string, i32>, k: string, d: f64) { return m.get(k) ?? d }
const m: Map<string, i32> = Map()
m.set("k", 5)
show(read(m, "k", 1.5))
print(read(m, "z", 1.5))

function generic<T>(r: { v: T | null }, d: f64) { return r.v ?? d }
const g: { v: i32 | null } = { v: 5 }
show(generic(g, 1.5))
const h: { v: i32 | null } = { v: null }
print(generic(h, 1.5))

// The other number types, and a literal default.
function others(o: { v: i32 | null }, a: (i64 | null)[], d: i64, e: f64) {
  print(kind(o.v ?? d))
  print(kind(a[0] ?? 7))
  print(kind(a[0] ?? d))
  print(kind(o.v ?? 1.5))
  print(kind(a[0] ?? e))
  const w: f64 = o.v ?? e
  print(w / 2)
}
others({ v: 5 }, [null], 9, 0.5)
