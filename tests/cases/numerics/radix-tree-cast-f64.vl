// @run
// @log -4294967296
// @log 214748364700
// @log 4294967295
// @log 1
// A radix tree cast to `f64` is read at the `f64`, so it computes at 64 bits and then converts,
// as at an `f64` destination (D16491); with no context the tree keeps 32 bits.
print(((-1) - 0xFFFFFFFF) as f64)
print((100 * 0x7fffffff) as f64)
print((0xFFFFFFFF + 0) as f64)
print((0 - 0xFFFFFFFF) * 1)
