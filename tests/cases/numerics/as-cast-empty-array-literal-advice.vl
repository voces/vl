// @run
// @log 0
// @log 2
// @log 0
// @log 2
// The advice the numeric-only `as` refusal now gives, run at both faces: deleting the cast
// leaves a bare `[]`, which takes its element type from its destination whether or not the
// enclosing function is annotated. These are the evidence that the suffix is true (D1641).
function f(m: u8[], off: i32): u8[] {
  if off < 0 { return [] }
  m.slice(off, off + 2)
}
function g(m: u8[], off) {
  if off < 0 { return [] }
  m.slice(off, off + 2)
}
const b: u8[] = [1, 2, 3, 4]
print(f(b, 0 - 1).length)
print(f(b, 1).length)
print(g(b, 0 - 1).length)
print(g(b, 1).length)
