// @error `as u8` propagates null — use `as!` to trap instead, or `as?` to take the null here; to propagate it, annotate the enclosing function's return type
// A cast in a function reached only through a reassigned binding is graded at that call (D3691).
// `as-u8-trap-through-reassigned-fn-binding.vl` is the neighbour that runs.
function k(x) { x as u8 }
function m(x) { x as u8 }
let j = k
j = m
print(j(2.5))
