// @run
// A generic or hole function read by value, or a lambda, joins its runtime numbers apart as a
// declared function does: the checker's union and the emitted body agree (D10350, D3710).
function g<A>(k: i32, a: A, b: f64) {
  if k == 0 { return a }
  b
}
const h = g
const x = 7
const v = g(0, x, 2.5)
print(v is i32)
print(h(1, x, 2.5))
const l = (q: i32 | null, s: f64) => {
  if q != null { q } else { s }
}
const r = l(4, 1.5)
print(r is i32)
print(l(null, 1.5))
// @log true
// @log 2.5
// @log true
// @log 1.5
