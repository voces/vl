// @run
// @log 8589934588
// @log 8589934588
// @log 8589934588
// @log 8589934588
// @log 8589934588
// @log 8589934588
// @log 8589934588
// @log 8589934588
// @log -4
// A parenthesised radix tree delivered at `i64` is computed and typed there, parentheses and all,
// at every delivery position, as the bare tree is (D15000).
type R = { v: i64 }

function take(x: i64) { print(x) }
function give(): i64 { return (0x7FFFFFFF << 2) }

const a: i64 = (0x7FFFFFFF << 2)
print(a)
const b: i64 = ((0x7FFFFFFF << 2))
print(b)
take((0x7FFFFFFF << 2))
print(give())
const r: R = { v: (0x7FFFFFFF << 2) }
print(r.v)
let w: i64 = 0
w = (0x7FFFFFFF << 2)
print(w)
print((0x7FFFFFFF << 2) as i64)
const xs: i64[] = [(0x7FFFFFFF << 2)]
print(xs[0])
const f: f64 = (0x7FFFFFFF << 2)
print(f)
