// @run
// @log 0
// @log 0
// @log 1
// @log 536870912
// @log -1073741824
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log -536870912
// @log -536870912
// A negated radix literal is its pattern at its use's width (owner ruling 2026-09-30, ruling A),
// so `>>` over one whose digits exceed 0x80000000 shifts the positive `i32` pattern at an `i32`
// use, inferred or written, and the negative value at an `i64` one (D16471).
function take(x: i32) { print(x) }
function give() { return (-0xFFFFFFFF) >> 3 }

const a = (-0xFFFFFFFF) >> 3
print(a)
print((-0xFFFFFFFF) >> 1)
print((-0xFFFFFFFE) >> 1)
print((-0xC0000000) >> 1)
print((-0x80000000) >> 1)
let b = (-0xFFFFFFFF) >> 3
print(b)
b = (-0xFFFFFFFF) >> 1
print(b)
take((-0xFFFFFFFF) >> 3)
print(give())
const xs = [(-0xFFFFFFFF) >> 3]
print(xs[0])
const w: i64 = (-0xFFFFFFFF) >> 3
print(w)
take64((-0xFFFFFFFF) >> 3)

function take64(x: i64) { print(x) }
