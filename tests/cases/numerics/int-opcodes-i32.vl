// @run
// @log 31
// @log 0
// @log 32
// @log 3
// @log 0
// @log 32
// @log 8
// @log 1
// @log 32
// @log 2
// @log -2147483648
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1431655764
// @log 2
// The single-opcode integer operations at i32: the bit-counting family, the rotates,
// and the UNSIGNED reads of a signed word.
print(clz(1))
print(ctz(1))
print(clz(0))  // 32 — the whole word is zeros, not a trap and not -1
print(ctz(8))
print(clz(-1)) // every bit set: no leading zeros
print(ctz(0))  // 32
print(popcnt(255))
print(popcnt(-2147483648)) // the sign bit alone
print(popcnt(-1))

// Rotation is not a shift: the bits that leave one end re-enter the other, so nothing
// is lost and the count is taken modulo the width (0 and 32 are both identities).
print(rotl(1, 1))
print(rotr(1, 1)) // 1 -> the sign bit
print(rotl(1, 0))
print(rotl(1, 32))
print(rotr(1, 32))
print(rotl(-2147483648, 1)) // the sign bit wraps to the bottom

// `divU`/`remU` read the SAME word as unsigned. -2 is 4294967294 there, so the
// quotient is a huge number rather than 0, and the remainder is 2 rather than -2.
print(divU(-2, 3))
print(remU(-2, 3))
