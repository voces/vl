// @run
// @log -2147483643
// @log 5
// @log 2147483653
// @hint redundant type annotation: `packed` is inferred as `i32`
// @hint redundant type annotation: `wide` is inferred as `i64`
// The spelling SP-047's diagnostic names: a hex literal in a join is the bit pattern at the
// join's `i32`, so the top bit sets the sign. At an `i64` destination the decimal `1 << 31` is
// the number 2^31 instead, and nothing overflows.
function packed(held: boolean): i32 { (if held { 0x80000000 } else { 0 }) | 5 }
function wide(held: boolean): i64 { (if held { 1 << 31 } else { 0 }) | 5 }
print(packed(true))
print(packed(false))
print(wide(true))
