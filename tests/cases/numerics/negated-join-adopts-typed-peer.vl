// A unary `-` over a value join of literals adopts the typed peer or destination beside it,
// `i64` or `f32`, as `~` over it and the bare join do (ruling 4.3).
function id(x: i32) { return x }
const c = id(1) == 1
const w: i64 = 5
const a: f32 = 1.5
const fa: f32 = 1.0
print((if c { 0xFFFFFFFF } else { 46341 }) + w)
print((-(if c { 0xFFFFFFFF } else { 46341 })) + w)
print((-0xFFFFFFFF) + w)
const x: i64 = -(if c { 0xFFFFFFFF } else { 46341 })
print(x)
print((-(if c { 0.1 } else { 1.5 })) + fa)
const z: f32 = -(if c { 0.1 } else { 1.5 })
print(z)
print((-(if c { (-0.25) } else { 1.5 })) / a)
print(
  (-(match 1 {
    1 => 0xFFFFFFFF
    _ => 46341
  }))
    + w,
)
const y: i64 = -(match 1 {
  1 => 0xFFFFFFFF
  _ => 46341
})
print(y)
print(
  (-(match 1 {
    1 => 0.1
    _ => 1.5
  }))
    + fa,
)
