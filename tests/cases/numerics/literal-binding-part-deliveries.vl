// @run
// @log 5
// @log 5000000000
// @log 5000000005
// @log 5000000000
// @log 5000000000
// @log 5
// A field, a list element, a map value and a nullable slot are deliveries like a parameter:
// an integer literal `let` delivered to an `i64` one is an `i64`, so its own arithmetic does
// not wrap at 32 bits (D3246).
type R = { v: i64 }
function f() {
  let b = 5
  const r: R = { v: b }
  print(r.v)
  print(b * 1000000000)
  let c = 5
  const ys: i64[] = [c]
  print(ys[0] + c * 1000000000)
  let d = 5
  const mm = Map<string, i64>()
  mm["k"] = d
  print(d * 1000000000)
  let e = 5
  const o: i64 | null = e
  print(e * 1000000000)
  print(o ?? 0)
}
f()
