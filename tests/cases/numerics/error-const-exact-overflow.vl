// @check
// @error constant 2147483648 overflows i32
// @error constant 1099511627776 overflows i32
// @error constant 2147483648 overflows i32
// @error constant 9223372036854775808 overflows i64
// @error constant 18446744073709551616 overflows i64
// @error division by zero in a constant expression
// @error shift count -1 is negative
// @error integer literal 100000000000000000000 overflows i64
// @error constant 10000000000000000000000 overflows i64
// A constant whose exact value its use cannot hold is refused there, never wrapped: an `i32` or
// `i64` destination names the value it cannot hold, including a shift that ran past the width
// and a decimal `1 << 31`, which is a number (a radix operand would make it a bit pattern).
// Division by zero and a negative shift count have no value at all.
const K = 2147483647 + 1
let y: i32 = K
const M = 1 << 40
function f(v: i32) { v }
print(f(M))
const S = 1 << 31
const s: i32 = S
const L = 9223372036854775807 + 1
const l: i64 = L
function g(): i64 { 1 << 64 }
print(g())
print(y + s + l)
const Z = 1 / 0
const N = 1 << -1
print(100000000000000000000)
const T = 100000000000 * 100000000000
print(T)
