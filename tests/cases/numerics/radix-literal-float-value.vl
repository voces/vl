// @run
// @log 4294967296
// @log 4294967295
// @log 18446744073709552000
// @log 4294967296.5
// @log -4294967296
// @log 2147483648
// @log -1
// In a float context a radix literal is the value its digits spell: `as` rounds it, a
// destination or peer takes it where the float holds it exactly, and an integer context keeps the
// bit pattern (owner ruling 4.1).
print(0xFFFFFFFF as f32)
print(0xFFFFFFFF as f64)
print(0xFFFFFFFFFFFFFFFF as f64)
print(1.5 + 0xFFFFFFFF)
print(-0xFFFFFFFF as f32)
const b: f32 = 0x80000000
print(b)
const k = 0xFFFFFFFF
print(k)
