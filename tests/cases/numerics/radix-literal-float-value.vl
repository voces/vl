// @run
// @log 4294967296
// @log 4294967295
// @log 2147483648
// @log 18446744073709552000
// @log 4294967296.5
// @log -4294967296
// @log -1
// In a float context a radix literal is the value its digits spell, rounded to the float; an
// integer context keeps the bit pattern (owner ruling 4.1).
print(0xFFFFFFFF as f32)
print(0xFFFFFFFF as f64)
const b: f32 = 0x7FFFFFFF
print(b)
function f(x: f64) { x }
print(f(0xFFFFFFFFFFFFFFFF))
print(1.5 + 0xFFFFFFFF)
print(-0xFFFFFFFF as f32)
const k = 0xFFFFFFFF
print(k)
