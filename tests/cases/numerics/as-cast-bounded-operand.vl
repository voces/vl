// @run
// @log 235
// @log 11
// @log 35
// @log 235
// @log 50
// @log 248
// @log 235207477
// @log 53
// @log 255
// @log 236
// @log 235
// @log 112
// @log 0
// A cast whose operand's own shape holds it inside the target cannot fail, so a bare `as` is
// the target type and owes the enclosing function no null (D3622, sunpa SP-035). The bounds:
// `x & K` and `K & x` with a constant `K` in 0..2^31-1 are in 0..K, `x >>> k` with a literal
// `k` is below 2^(w-k), and `x % c` over a bounded `x` stays inside it (below `c` too when `c`
// is a positive constant). `as!` and `as?` over such an operand keep working.
const MASK = 0xFF

type Px = { r: i32, g: i32 }

function channels(v: i32): Px {
  return { r: (v & 255) as u8, g: ((v >>> 8) & MASK) as u8 }
}

function top(v: i32) { (v >>> 24) as u8 }

function low(w: i64) { return (w & 0x7FFFFFFF) as i32 }

const pick = (v: i64, y: i64) => ((v & 0xFFFF) % 256 & y) as u8

const px: u8[] = []
let v = -123456789
px.push((v & 0xFF) as u8)
px.push((15 & v) as u8)
px.push(((v & 0xFFFF) % 200) as u8)
const p = channels(v)
let wide = -1234567890123
const g = (wide >>> 56) as u8
const n = (v & 0xFF) as? u8
print(px[0])
print(px[1])
print(px[2])
print(p.r)
print(p.g)
print(top(v))
print(low(wide))
print(pick(wide, 0x7F))
print(g)
print(n + 1)
print((v & 0xFF) as! u8)
v = 70000
wide = 0
print((v & 255) as u8)
print(low(wide))
