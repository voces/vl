// @run
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// @hint redundant type annotation: `bytes` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `p` is inferred as `{v: i32}` — remove it to lean on inference
// @hint redundant type annotation: `narrow` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `arg` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `wide` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `trio` is inferred as `i32` — remove it to lean on inference
// @log 255
// @log 255
// @log 0
// @log 2
// @log 255
// @log 3
// @log -7
// @log 2147483647
// @log -2147483648
// @log 3
// @log 255
// @log 0.5
// @log 255
// @log 255
// A cast whose operand is a constant tree (literals, literal consts and operators over them)
// is decided at the operand's exact value (D3588, sunpa SP-024). A value the target holds
// converts exactly, so a bare `as` cannot fail: it is the target type, owes the enclosing
// function no null, and lowers with no runtime test. `as!` and `as?` over it keep working
// and `as?` is the bare target, as over every cast that cannot fail.
const K = 200

function bytes(): i32 {
  const px: u8[] = []
  px.push(255 as u8)
  px.push((K + 55) as u8)
  px.push(0 as u8)
  print(px[0])
  print(px[1])
  print(px[2])
  px.length
}

type Px = { v: i32 }

function narrow(): i32 {
  const p: Px = { v: 255 as u8 }
  print(p.v)
  print(3.0 as i32)
  print(-(7.0) as i32)
  print(2147483647.0 as i32)
  print((-2147483648.0) as i32)
  0
}

function arg(x: i64): i64 { x }

function wide(): i64 { arg(3.0 as i64) }

function trio(): i32 {
  const a = 255 as! u8
  const b = (200 + 55) as? u8
  print(a)
  print(0.5 as f32)
  print(b ?? 0)
  0
}

print(bytes() - 1)
narrow()
print(wide())
trio()
const top = 255 as u8
print(top)
