// A value join of literals cast to a number takes the cast's context, as at a typed
// destination: a radix arm is the value its digits spell, also in a generic body.
let c = true
c = !c
print((if c { 2147483647 } else { 0xFFFFFFFF }) as f64)
const k = 2
print(
  (match k {
    1 => 3
    _ => 0xFFFFFFFF
  }) as f64,
)
print((if c { 1 } else { 0xFFFFFFFF }) as f32)
print((if c { 1 } else if k > 1 { 0xFFFFFFFF } else { 2 }) as f64)
print((if c { 1 } else { 0xFFFFFFFF }) as i64)
print((if c { 1 } else { 0xFFFFFFFF }) as i64 + 1)
print((if c { 1 } else { -0xFFFFFFFF }) as f64)
print((if c { 1 } else { 0xFFFFFFFF }) as% i32)
function g<T>(x: T) {
  print(x)
  return (if c { 1 } else { 0xFFFFFFFF }) as f64
}
print(g(1))
function h<T>(x: T) {
  print(x)
  const r: f64 = if c { 1 } else { 0xFFFFFFFF }
  return r
}
print(h("a"))
const f = () => (if c { 1 } else { 0xFFFFFFFF }) as f64
print(f())
print((if c { 1 } else { 0xFFFFFFFF << 4 }) as f64)
print((if c { 1 } else { 0xFFFFFFFF + 1 }) as i64)
print((if c { 1 } else { 0xFFFFFFFF }) as% i64)
