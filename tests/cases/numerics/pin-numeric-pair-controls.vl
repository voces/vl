// @run
// @log 1.5
// @log 1
// @log 1
// @log 3.5
// @log 5000000001
// @log 5000000001.5
// @log true
// The spellings beside `error-pin-numeric-pair-mixes.vl` that keep running at the same pins:
// an exact int literal adapts, i32 meets f64, and `as` converts the i64 member first.
const jq: i64 | null = null
function take(a) {
  const r = a ?? 0.5
  print(r + 1)
  print((r as f64) * 2.0)
  if r is i64 { print((r as f64) * 2.0) } else { print(r * 2.0) }
}
take(jq)
function add(x) { x + 1.5 }
print(add(2))
function inc(x) { x + 1 }
print(inc(5000000000))
function conv(x) { (x as f64) + 1.5 }
print(conv(5000000000))
const small = 7
const half = 2.5
function less(a, b) { a < b }
print(less(half, small))
