// @check
// @error `as u8` propagates null — use `as!` to trap instead, or `as?` to take the null here; to propagate it, annotate the enclosing function's return type
// @error `as u8` propagates null — use `as!` to trap instead, or `as?` to take the null here; to propagate it, annotate the enclosing function's return type
// A call through a `let` re-pointed at the same function re-asks the bare `as` the function
// parked on its hole, as a call by name does (D3659).
function k(x) { x as u8 }
let j = k
j = k
print(j(2.5))
const l = (x) => x as u8
function main() {
  let h = l
  h = l
  print(h(2.5))
}
main()
