// @run
// @log 0
// @log 7
// @log 5
// A hole parameter coalesced into a new binding, written before the cast, or guarded by `is null`
// is not what its pin describes at the cast, so these casts run (D1373's protected spellings).
function mk(n: i32): i32 | null {
  if n == 0 { return 5 }
  return null
}
function t2(a) {
  const b = a ?? 0
  print(b as i32)
}
t2(mk(1))
function t3(a) {
  a = 7
  print(a as i32)
}
t3(mk(1))
function t4(a) {
  if a is null { return }
  print(a as i32)
}
t4(mk(0))
