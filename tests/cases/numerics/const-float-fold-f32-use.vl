// @log 1.0000001192092896
// @log 1.0000000000000007
// @log 1

// A float constant tree used at `f32` folds in `f32` arithmetic at every use, as it runs there
// (E9.1, D16414): an argument, a return, a field, an element, a write, an operator peer and a
// nullable binding. `as f32` converts a tree its operand types at `f64`; an `f64` use folds in
// doubles. A `const` with no annotation is a constant, so each read folds at its own use type;
// one annotated `f64` is one double value.
function f(x: f32) { print(x) }
function g(): f32 { return (1.5 % 0.1) / (2.5 % 0.1) }
function h(x: f64) { print(x) }
f((1.5 % 0.1) / (2.5 % 0.1))
print(g())
const r: { x: f32 } = { x: (1.5 % 0.1) / (2.5 % 0.1) }
print(r.x)
const xs: f32[] = [(1.5 % 0.1) / (2.5 % 0.1)]
print(xs[0])
let w: f32 = 0.0
w = (1.5 % 0.1) / (2.5 % 0.1)
print(w)
const y: f32 = 0.0
print(y + (1.5 % 0.1) / (2.5 % 0.1))
const n: f32 | null = (1.5 % 0.1) / (2.5 % 0.1)
print(n ?? 0.0)
f(0.1 - 0.3)
print(((1.5 % 0.1) / (2.5 % 0.1)) as f32)
h((1.5 % 0.1) / (2.5 % 0.1))
const H = (1.5 % 0.1) / (2.5 % 0.1)
const hf: f32 = H
print(hf)
f(H)
h(H)
const D: f64 = (1.5 % 0.1) / (2.5 % 0.1)
f(D as f32)
