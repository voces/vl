// @run
// @log 1.5
// @log 7
// @log 2.5
// @log 9000000001
// @log 3
// @log 7
// A numeric union box delivered into a wider number converts at the member it holds: an `f64` and
// an `i64` destination, at a global, a declaration, an argument and a return. An `f32` one has no
// source: the checker refuses `f32 | i32` into `f32` as lossy.
function someF(): f32 | null { return 1.5 }
function noneF(): f32 | null { return null }
function bigOrSmall(big: boolean): i64 | i32 {
  if big { return 9000000001 }
  return 3
}
function halfOrInt(h: boolean): f32 | i32 {
  if h { return 0.5 }
  return 4
}
function asF64(x: f64) { print(x) }
function ret(): f64 { return noneF() ?? 7 }

const g: f64 = someF() ?? 7
print(g)
const n: f64 = noneF() ?? 7
print(n)
function body() {
  const d: f64 = halfOrInt(true)
  asF64(d + 2.0)
}
body()
const wide: i64 = bigOrSmall(true)
print(wide)
const small: i64 = bigOrSmall(false)
print(small)
print(ret())
