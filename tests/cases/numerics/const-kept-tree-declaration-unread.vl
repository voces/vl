// @run
// @hint Intentionally-unused variable `_UNUSED` (leading `_` marks it unused)
// @log -2147483648
// @log -2147483648
// @log -2147483648
// @log 0
// @log 1
// A `const` whose radix tree every read copies is never read itself, so its declaration computes
// nothing and cannot trap where the copies do not: `0x80000000 / -1` is `INT_MIN / -1` only at
// `i32`, and every read here is at `i64` (D15001).
function above(): i64 { return P }
const P = 0x80000000 / -1
const w: i64 = P
print(w)
print(above())

function local() {
  const Q = 0x80000000 / -1
  const v: i64 = Q
  print(v)
}
local()

const R = 0x80000000 % -1
const r: i64 = R
print(r)

const _UNUSED = 0x80000000 / -1
print(1)
