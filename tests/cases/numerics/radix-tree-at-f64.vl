// @run
// @log 4294968295
// @log 4294968295.5
// @log 8589934590.5
// @log true
// @log 2147483647
// @log 4294968295
// @log 4294967296.5
// @log 4294967296
// @log 0
// A radix tree read at an `f64`, delivered there or beside an `f64` peer, computes at 64 bits
// with integer division, then converts; no context keeps 32 bits (D16390), and `as f32` reads
// the literal's value (ruling 4.1).
const p = 0.5
const a: f64 = 0xFFFFFFFF + 1000
print(a)
print((0xFFFFFFFF + 1000) + p)
print(0xFFFFFFFF * 2 + p)
print(p < 0xFFFFFFFF + 1)
const d: f64 = 0xFFFFFFFF / 2
print(d)
function take(x: f64) { print(x) }
take(0xFFFFFFFF + 1000)
let x = p
x += 0xFFFFFFFF + 1
print(x)
print(0xFFFFFFFF as f32)
print(0xFFFFFFFF + 1)
