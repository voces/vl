// @run
// @log 7
// @log 4
// @log 7
// @log 4
// @log 7
// @log 4
// @log 7
// @log 4
// @log 7
// @log 4
// @log 4
// @log 5
// An assignment in value position yields its right side. When an operand before it is a call
// the write stays in place and the cell is re-read, so an `i32` written into an `f32` cell or a
// nullable scalar box is taken back to `i32` exactly (D2530).
function k() { 3 }
function h(p: i32, q: i32) { p + q }
let f: f32 = 0.5
print(h(k(), f = 4))
print(f)
let dn: f64 | null = null
print(h(k(), dn = 4))
print(dn ?? -1.0)
let fnn: f32 | null = null
print(h(k(), fnn = 4))
print(fnn ?? -1.0)
let ln: i64 | null = null
print(k() + (ln = 4))
print(ln ?? -1)
function local() {
  let v: f64 | null = null
  print(h(k(), v = 4))
  print(v ?? -1.0)
  const xs = [k(), v = 5]
  print(xs[1] - 1)
  print(v ?? -1.0)
}
local()
