// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log Infinity
// @log -Infinity
// @log NaN
// @log 1e+21
// @log 100000000000000000000
// @log 1e-7
// @log 0.000001
// @log 1.5
// @log -1.5
// @log 0.1
// @log 123456789
// @log 0.3333333333333333
// @hint redundant type annotation: `pow10` is inferred as `f64`
// PRINTING A FLOAT MUST READ THE SAME UNDER EITHER HOST. The corpus is checked twice
// — by the native runner (`scripts/vl-host`, wasmtime) and by the Deno oracle
// (`tests/support/runWasm.ts`, V8) — and the two sank `print(<float>)` through
// different formatters. Rust's `{}` Display and JS `String(v)` agree on ordinary
// magnitudes and disagree in four places, every one of which is pinned here:
//
//   value            Rust `{}` (before)        JS `String(v)`   this file
//   -0.0             -0                        0                @log 0
//   1e21             1000000000000000000000    1e+21            @log 1e+21
//   1e-7             0.0000001                 1e-7             @log 1e-7
//   Infinity         inf                       Infinity         @log Infinity
//
// Only the negative zero was filed; the census that verified it found the other
// three. The host now renders through `js_number_to_string`, which IS the spec's
// `Number::toString`, so this file can exist at all — before it, `@log 0` failed the
// native runner and `@log -0` failed the Deno oracle, and neither spelling could be
// committed.
//
// The 1e20 / 1e-6 lines are the CONTROLS for the exponent rule: the spec switches to
// exponential form at n > 21 and n <= -6, so its neighbours must stay positional. The
// last five lines are ordinary values that never diverged, present so a regression in
// the common path cannot hide behind the boundary cases.
//
// NOT closed, and not closeable here: Rust and V8 pick different digits for the ~0.01%
// of values with two equally-short round-tripping decimals (`-1715888522909781.2` vs
// `.3` — both parse to the identical f64). Measured at 3 divergences in a 22,532-value
// sweep.
//
// THE SENTENCE THAT USED TO FOLLOW WAS WRONG, and it was wrong in the direction that
// excuses the host. It said this is "a shortest-representation tie-break inside each
// language's float formatter, not a formatting rule". It IS a rule, and the spec states
// it: ECMA-262 `Number::toString` step 5 takes the shortest digit string, then the one
// CLOSEST to the value, and on an exact tie the one whose last digit is EVEN. V8 obeys
// it; Rust's shortest formatter breaks the tie the other way, and `js_number_to_string`
// inherits that because it re-formats digits it gets from `{:e}`. So the divergence is a
// host DEFECT with a named correct answer, not two defensible opinions. `std:fmt`'s
// `toString` implements the spec's rule in pure VL and agrees with V8 on 50,000 of 50,000
// pseudo-random doubles while the Rust host misses 14 — the argument and the smallest
// witness (bits 4835952189745799117, exactly 2023347301156851.25) are in `std/fmt.vl`'s
// `f64 ↔ TEXT` header, and `tests/vl_std_float_text_test.ts` pins the divergent set so
// fixing the host flips a test rather than passing unnoticed.
function pow10(n: i32): f64 {
  let r = 1.0
  let i = 0
  while i < n {
    r = r * 10.0
    i = i + 1
  }
  r
}

// NEGATIVE ZERO, every way to reach it. `String(-0)` is "0" — the sign is not
// rendered, which is why `float-opcodes-nan-zero.vl` has to assert through `f64bits`.
print(-0.0)
print(0.0 * -1.0)
print(-1.0 * 0.0)
const negZeroF32: f32 = -0.0
print(negZeroF32)
print(0.0)

// The non-finite values.
print(pow10(308) * 10.0)
print(0.0 - pow10(308) * 10.0)
print(0.0 / 0.0)

// The exponent-form boundaries, and their positional neighbours.
print(pow10(21))
print(pow10(20))
print(1.0 / pow10(7))
print(1.0 / pow10(6))

// Ordinary magnitudes — the common path, unchanged.
print(1.5)
print(-1.5)
print(0.1)
print(123456789.0)
print(1.0 / 3.0)
