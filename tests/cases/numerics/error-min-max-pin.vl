// @check
// @error operator 'min' is not defined for string and string (the body of `g` applies 'min' to arguments 1 and 2)
// @error operator 'max' is not defined for i64 and f64 (the body of `h` applies 'max' to arguments 1 and 2)
// An un-annotated `min` / `max` operand is checked at each call against the forms the
// direct spelling accepts: numbers only, and an i64 never meets a float.
function g(a, b) { min(a, b) }
print(g("a", "b"))
function h(a, b) { max(a, b) }
print(h(5000000000, 2.5))
