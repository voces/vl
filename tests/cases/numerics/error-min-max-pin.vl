// @check
// @error operator 'min' is not defined for string and string (`g` applies 'min' to parameters `a` and `b`, at 6:27)
// @error operator 'max' is not defined for i64 and f64 (`h` applies 'max' to parameters `a` and `b`, at 8:27)
// An un-annotated `min` / `max` operand is checked at each call against the forms the
// direct spelling accepts: numbers only, and an i64 never meets a float.
function g(a, b) { return min(a, b) }
print(g("a", "b"))
function h(a, b) { return max(a, b) }
print(h(5000000000, 2.5))
