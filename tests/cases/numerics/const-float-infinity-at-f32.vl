// @run
// @warning dividing by `0.0` gives Infinity or NaN
// @log Infinity
// @log -Infinity
// @log NaN
// @log Infinity
// @log Infinity
// @log Infinity
// @log Infinity
// @log Infinity
// @log Infinity

// A float constant tree whose IEEE value is no finite double computes at an `f32` use as it runs
// there (E9.1, D16541): a binding, its negation and NaN, an argument, a return, a field, an
// element and a nullable binding. A finite constant past `f32`'s largest value stays refused.
function f(x: f32) { print(x) }
function g(): f32 { return 1.0 / 0.0 }
const a: f32 = 1.0 / 0.0
print(a)
const b: f32 = -(1.0 / 0.0)
print(b)
const c: f32 = 0.0 / 0.0
print(c)
f(1.0 / 0.0)
print(g())
const r: { x: f32 } = { x: 1.0 / 0.0 }
print(r.x)
const xs: f32[] = [2.0 / 0.0]
print(xs[0])
const n: f32 | null = 1.0 / 0.0
print(n ?? 0.0)
const d: f32 = (1.0 + 2.0) / 0.0
print(d)
