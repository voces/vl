// @check
// @error-at 7:12 `as i32` propagates null, which the enclosing function cannot return (it returns i32) — use `as!` to trap instead, or `as?` to take the null here; the `??` after it never sees that null — write `(x as? i32) ?? …` to default it there
// @error-at 12:39 `as i32` propagates null, which the enclosing function cannot return (it returns i32) — use `as!` to trap instead, or `as?` to take the null here; the `??` after it never sees that null — write `(x as? i32) ?? …` to default it there
// A bare `as` sends its miss out of the function, so a `??` after it never sees the null. When
// the propagation is refused, the refusal names the `as?` spelling the `??` does see, and no
// dead-default finding repeats it.
function pick(u: f64): i32 {
  const k = u as i32 ?? 0
  return k
}
print(pick(1.5))

function picked(u: f64): i32 { return (u as i32) ?? -1 }
print(picked(1.5))
