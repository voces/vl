// @emit-error the numeric intrinsic 'sqrt' is mistaken for a captured variable
// A numeric intrinsic is not a collected function, a module global, or a locally bound
// name, so the emitter's capture analysis records its NAME as a free variable of the
// lambda and there is nothing to read it from. That is the shape the whole
// declared-intrinsic family already has (`__load_i32__` inside a lambda fails
// identically on master, with a message about a variable the author never wrote). The
// reject is loud and says what is actually wrong; the fix belongs in capture analysis.
const xs: f64[] = [1.0, 4.0, 9.0]
const ys = xs.map((v: f64) => sqrt(v))
print(ys[2])
