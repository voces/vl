// @emit-error 'sqrt' cannot be called from inside a lambda
// A numeric intrinsic is not a collected function, so the emitter's capture analysis
// records the NAME as a free variable of the lambda and there is nothing to read it
// from. That is the shape the whole declared-intrinsic family already has
// (`__load_i32__` inside a lambda fails identically); the reject is loud and says what
// is actually wrong instead of reporting a variable the author never wrote.
const xs: f64[] = [1.0, 4.0, 9.0]
const ys = xs.map((v: f64) => sqrt(v))
print(ys[2])
