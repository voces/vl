// @run
// @log 3000000000
// @log 6000000000
// @log 4294967295
// @log 4294967295
// @log 4294967295
// @log 4294967295
// D3246: a literal stored into a literal binding bounds its type: `3000000000` needs a 64-bit
// type, and a radix literal past bit 31 is a different value at `i32` (`-1`), so its binding is
// typed as its uses say, whether or not another read happens to look at it.
function take64(x: i64) { print(x) }

function wide() {
  let y = 5
  y = 3000000000
  take64(y)
}
wide()

function wideSum() {
  let y = 5
  y = 3000000000
  take64(y + y)
}
wideSum()

function pattern() {
  let y = 5
  y = 0xFFFFFFFF
  take64(y)
}
pattern()

function patternPrinted() {
  let y = 5
  y = 0xFFFFFFFF
  take64(y)
  print(y)
}
patternPrinted()

function patternInLoop() {
  let y = 5
  let i = 0
  while i < 3 {
    y = 0xFFFFFFFF
    i += 1
  }
  take64(y)
}
patternInLoop()
