// @run
// @log 2
// @log -1
// @log 7
// @log 0
// @log 4
// @log 0
// @log 5
// @log 0
// Q58 position sweep: a bare exact `as`, whose miss returns the function's own null, at results
// `i32 | null`, `i64 | null` and `f32 | null`, the cast as a return, a `let`
// initializer, a call argument and an operand, each called with a value that converts and one
// that does not.
function id(n: i32) { return n }
function r1(x: f64): i32 | null { return x as i32 }
function r2(x: f64): i32 | null {
  const b = x as i32
  return b
}
function r3(x: f64): i64 | null { return id(1) as i64 + (x as i64) }
function r4(x: f64): f32 | null {
  const y = id((x as i32) + 1)
  return y as f32
}
print(r1(2.0) ?? -1)
print(r1(2.5) ?? -1)
print(r2(7.0) ?? 0)
print(r2(7.25) ?? 0)
print(r3(3.0) ?? 0)
print(r3(3.5) ?? 0)
print(r4(4.0) ?? 0.0)
print(r4(4.5) ?? 0.0)
