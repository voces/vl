// @run
// A number literal beside list elements of two number types joins them apart in a generic or
// hole body as in a plain one: at the pin the elements' members stay apart and the literal folds
// into them (D3534).
function g<A, B>(a: A, b: B) { [a, b, 2.5] }
function h(a, b) { [5, a, b] }
function k<A, B>(a: A, b: B) { [5, a, b] }
const x = 7
const y = 2.25
const f: f32 = 0.5
print(g(x, y)[0] / 2)
print(h(x, y)[1] / 2)
print(h(x, y)[0])
const ks = k(f, y)
print(ks[1] is f32)
print(ks[2] is f64)
print(ks.length)
// @log 3
