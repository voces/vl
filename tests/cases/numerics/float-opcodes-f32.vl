// @run
// @log 3
// @log 1.5
// @log -2
// @log 2
// @log 2.5
// @log 9
// @log -2.5
// @log true
// @log true
// The same nine operations at f32 — a DIFFERENT instruction per width, chosen from the
// operands exactly as `+` and `*` are. An f32 operand and a float LITERAL keep the
// operation at f32 (the literal re-encodes); a genuine f64 operand widens it, so the
// intrinsic and the operator never disagree about the width they compute at.
const a: f32 = 9.0
const b: f32 = 2.5
const wide: f64 = 4.0
print(sqrt(a))
print(abs(0.0 - 1.5) + a - a)
print(floor(0.0 - 1.5) + a - a)
print(nearest(b))        // 2.5 -> 2, round-half-to-even
print(min(a, 2.5))       // a float literal adapts DOWN to the f32 operand
print(max(a, 2.5))
print(copysign(b, 0.0 - 1.0))

// The width is observable: an f32 square root of 2 loses precision an f64 one keeps, so
// the two answers differ — proof that `sqrt(a)` really took `f32.sqrt`. Mixing in a
// genuine f64 operand widens the operation, giving the f64 answer.
const two: f32 = 2.0
print(sqrt(two) != sqrt(2.0))
print(min(a, wide) == 4.0)
