// @run
// @log 100
// @log 100
// @log 100
// @log 100
// @log 410065408
// @log 9000000000
// @log 100
// @log 9000000000
// @log 3
// @log 3
// @log 3.5
// @log 3.5
// @log 7
// @log 7
// @log 7.9
// @log 2.5
// @log 100
// @log 100
// @log 7
// @hint redundant type annotation: `fi32` is inferred as `i32`
// @hint redundant type annotation: `fi64` is inferred as `i64`
// @hint redundant type annotation: `ff32` is inferred as `f32`
// @hint redundant type annotation: `ff64` is inferred as `f64`
// @hint redundant type annotation: `a` is inferred as `i32`
// @hint redundant type annotation: `big` is inferred as `i64`
// @hint redundant type annotation: `smallBig` is inferred as `i64`
// @hint redundant type annotation: `pf` is inferred as `f32`
// @hint redundant type annotation: `pd` is inferred as `f64`
// @hint redundant type annotation: `dd` is inferred as `f64`
// The `as` cast target may be a user ALIAS of a numeric scalar — `checkCastNode`
// admits any target that RESOLVES to i32/i64/f32/f64, so `type F64 = f64` is as
// legal a target as `f64`. Four emit consumers read the target as a STRING and
// compare it to the four primitive spellings (`emitAsCast`'s `tgt == "f64"`,
// `exprIsI64`/`exprIsF32`/`exprIsF64`, and the value-type feature scan), so an
// alias target used to fall through every one of them into the i32 arm and emit
// INVALID WASM (`type mismatch: expected f64, found i32`) for every non-i32
// target — `type W = i32` was the only alias that worked, because it needs no
// conversion. This is the alias mirror of `as-cast-values.vl`: same runtime
// values, same 4×4 matrix, every expected line identical to the primitive
// spelling's. The last three lines cast to a CHAINED alias (`Wide` → `I64` →
// i64, `Real` → `F64` → f64).
type I32 = i32
type I64 = i64
type F32 = f32
type F64 = f64
type Wide = I64
type Real = F64

function fi32(n: i32): i32 { n }
function fi64(n: i64): i64 { n }
function ff32(x: f32): f32 { x }
function ff64(x: f64): f64 { x }

// i32 → {i32 no-op, i64, f32, f64}
const a: i32 = fi32(100)
print(a as I32)
print(a as I64)
print(a as F32)
print(a as F64)

// i64 → {i32 WRAP, i64 no-op, f32, f64}
const big: i64 = fi64(9000000000)
print(big as I32)
print(big as I64)
const smallBig: i64 = fi64(100)
print(smallBig as F32)
print(big as F64)

// f32 → {i32 trunc, i64 trunc, f32 no-op, f64 promote}
const pf: f32 = ff32(3.5)
print(pf as I32)
print(pf as I64)
print(pf as F32)
print(pf as F64)

// f64 → {i32 trunc, i64 trunc, f64 no-op, f32 DEMOTE}
const pd: f64 = ff64(7.9)
print(pd as I32)
print(pd as I64)
print(pd as F64)
const dd: f64 = ff64(2.5)
print(dd as F32)

// A CHAINED alias target resolves the whole chain.
print(a as Wide)
print(a as Real)
print(pd as Wide)
