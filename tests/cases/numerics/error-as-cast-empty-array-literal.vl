// @check
// @error `as` supports numeric conversions only; write `[]` — an empty array literal takes its element type from its destination
// `as` is numeric-only by design, so this refusal is correct and the program is ill-typed.
// The suffix is the half that says what to write: an empty array literal takes its element
// type from its destination, so the cast is not merely unsupported but unnecessary, and no
// other `as` spelling can work (D1641).
function f(m: u8[], off: i32): u8[] {
  if off < 0 { return [] as u8[] }
  m.slice(off, off + 2)
}
const b: u8[] = [1, 2, 3, 4]
print(f(b, 1).length)
