// @run
// @log 3
// @log 2147483647
// @log -1
// @log 8589934590
// @log 2147483647
// @log 4294967296
// @log -1
// @log 3
// @log 3
// @log -1
// A radix tree as a value join's tail computes at the join's `i64` under every operator, as a
// bare radix tail is read there (ruling A with 4.3); an `i32` tail keeps the 32-bit reading.
function cond() { return true }
const c = cond()
print(if c { 0xFFFFFFFF % 7 } else { 3000000000 })
print(if c { 0xFFFFFFFF / 2 } else { 3000000000 })
print(if c { (-1) % 0xFFFFFFFF } else { 3000000000 })
print(if c { 0xFFFFFFFF << 1 } else { 3000000000 })
print(if c { 0xFFFFFFFF >> 1 } else { 3000000000 })
print(if c { 0xFFFFFFFF + 1 } else { 3000000000 })
const w: i64 = 5
print(if c { (-1) % 0xFFFFFFFF } else { w })
print(
  match 1 {
    1 => 0xFFFFFFFF % 7
    _ => 3000000000
  },
)
print(if c { 0xFFFFFFFF % 7 } else { 1.5 })
const v = 7
print(if c { 0xFFFFFFFF % 7 } else { v })
