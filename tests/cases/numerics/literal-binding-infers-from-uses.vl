// @run
// @log 3000000005
// @log 21000000000
// @log 1.5
// @log 7.5
// @log -1
// @log -2147483650
// @log 8000000000
// @log 7
// @log 3
// @log 0.10000000149011612
// @log 4294967295
// @log 12345
// @log 8589934592
// @log 5
// @log 2
// @log 0
// @log 4000000000
// @info `b` is never reassigned; use `const` instead of `let`
// @info `both` is never reassigned; use `const` instead of `let`
// D3246 (plumb PL-054, PL-056), owner ruling B′ + C: an un-annotated `let` initialised by a bare
// numeric literal takes its type from what it is delivered to and what is stored into it, within
// its kind; a literal `const` is its literal at every read. Each line proves the width it took.

function big() { 3000000000 }
function mul32(a: f32, b: f32) { a * b }
function take64(x: i64) { x }
function takeF64(x: f64) { x }
function takeI32(x: i32) { x }

// PL-054: an accumulator stored with i64 values is an i64.
function sum(xs: i64[]) {
  let s = 0
  for x in xs { s += x }
  s
}
print(sum([3000000000, 2, 3]))

// A store of an i64, then arithmetic wide enough to need it.
function scaled() {
  let acc = 0
  acc = big()
  acc * 7
}
print(scaled())

// PL-056: a literal `const` is an `f32` where an `f32` is wanted, as its literal would be.
const h = 0.5
print(mul32(3.0, h))
function lerp(a: f32) { a * h + 7.0 }
print(lerp(1.0))

// A negated literal `let` delivered to an `i64` is an `i64`.
let found = -1
print(take64(found))
print(found - 2147483647 - 2)

// A store inside a closure counts.
function viaClosure() {
  let t = 0
  const add = () => {
    t = t + big()
  }
  add()
  t + 5000000000
}
print(viaClosure())

// Only literal stores: no typed use, so the literal's own type.
let n = 0
n = 7
print(n)

// A destination of the other kind widens at that use; the binding stays an integer.
let b = 7
takeF64(b)
print(b / 2)

// A `const` read as an `f32` binding is the `f32` literal there.
const tenth = 0.1
const asF32: f32 = tenth
print(asF32)

// A radix `const` is the bit pattern of each read's width: 64 bits here, 32 below.
const mask = 0xFFFFFFFF
print(take64(mask))
const low = 12345
print(low & mask)

// A literal binding stored into another takes that one's type: `a` is an i64 because `c` is.
function chain() {
  let a = 2
  let c = 0
  c = a
  c += big()
  print(a * 1073741824 * 4)
}
chain()

// An `i32` destination and an `i64` one keep `i32`, the one type both take.
let both = 5
print(takeI32(both))
print(take64(both) / 2)

// A module-level `let` written in a function.
export let total = 0
function add() { total = big() + 1000000000 - 3000000000 - 1000000000 }
add()
print(total)
total = total + 4000000000
print(total)
