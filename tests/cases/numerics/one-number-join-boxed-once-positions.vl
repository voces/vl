// @run
// @log true
// @log 3
// @log false
// @log true
// @log -3
// @log true
// @log true
// @log true
// @log true
// @log true
// @log 9
// @log true
// @log 2.5
// @log false
// @log false
// A join typed one wider number with a literal tail is that number, each arm widened, boxed once
// into the result at a return, a nested and a chained link, a result admitting null and an
// argument; a binding boxes arm by arm, and an `as` tail is no literal, so `wide` keeps its i32.
function tailRet(r: i32 | null): i32 | f64 {
  return if r != null { r } else { 2.5 }
}
function nested(q: i32 | null, r: i32 | null): i32 | f64 {
  return if q != null { q } else { if r != null { r } else { 2.5 } }
}
function chain(q: i32 | null, r: i32 | null): i32 | f64 {
  return if q != null { q } else if r != null { r } else { 2.5 }
}
function withNull(r: i32 | null): i32 | f64 | null {
  return if r != null { r } else { 2.5 }
}
function nullArm(c: boolean, r: i32 | null): i32 | f64 | null {
  return if c { null } else { if r != null { r } else { 2.5 } }
}
function take(x: i32 | f64) { print(x is f64); print(x) }
function arg(r: i32 | null) { take(if r != null { r } else { 2.5 }) }
function bind(r: i32 | null) {
  const x: i32 | f64 = if r != null { r } else { 2.5 }
  print(x is f64)
}
function wide(r: i32 | null): i32 | i64 {
  return if r != null { r } else { 7 as i64 }
}
const a = tailRet(3)
print(a is f64)
print(a)
const b = nested(4, 1)
print(b is f64)
const c = nested(null, -3)
print(c is f64)
print(c)
print(chain(null, 5) is f64)
print(withNull(6) is f64)
print(nullArm(true, 1) == null)
print(nullArm(false, 8) is f64)
arg(9)
arg(null)
bind(10)
print(wide(11) is i64)
