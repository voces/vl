// @check
// @error cannot assign i32[] to 'xs' of type f32[]
// @error cannot assign i64[] to 'ys' of type f64[]
// A radix element a float list does not hold exactly is refused, as a binding of it is
// (owner ruling 4.1); only `as` rounds one.
const xs: f32[] = [0x1000001]
const ys: f64[] = [0xFFFFFFFFFFFFFFF]
print(xs[0])
print(ys[0])
