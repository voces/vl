// @check
// @error 0x80000000 is both the bit pattern -2147483648 at i32 and the number 2147483648; write the decimal you mean, or `0x80000000 as% i32`
// @error 0xffffffff is both the bit pattern -1 at i32 and the number 4294967295; write the decimal you mean, or `0xffffffff as% i32`
// @error 0x8000000000000000 is both the bit pattern -9223372036854775808 at i64 and the number 9223372036854775808; write the decimal you mean, or `0x8000000000000000 as% i64`
// @error constant 123456789000 is not exact at f32 — write it as a float literal to round it
// @error constant 2147483648 fits no member of i32 | string
// @error constant 1.5 is not a whole number, so i64 cannot hold it
// Arithmetic on a radix pattern whose top bit is set at its own width has two answers, one per
// reading, so it is refused naming both; a constant a float or union destination cannot hold is
// refused naming the constant and the destination.
const A: i32 = 0x80000000 / 2
const B: i64 = 0xFFFFFFFF % 7
const C: i64 = 0x8000000000000000 / 2
let f: f32 = 123456789 * 1000
let u: i32 | string = 2147483647 + 1
let w: i64 = 1.5 * 1
print(A + (B as% i32))
print(C)
print(f)
print(w)
if u is i32 { print(u) }
