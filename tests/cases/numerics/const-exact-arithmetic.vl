// @run
// @log 4190
// @log 1099511627776
// @log 0.30000001192092896
// @log 0.3
// @log 2147483648
// @log -3
// @log -1
// @log -128
// @log 1024
// @log 4294967296
// @log -65281
// @log 3
// @log 1.5
// @log 10
// @log 0.3333333333333333
// @log 6000000000
// @hint redundant type annotation: `x` is inferred as `i64` — remove it to lean on inference
// A `const` initialised by literal arithmetic is computed exactly and typed at each use, as its
// literal written there would be (DECISIONS.md, "Exact constant arithmetic"): no step wraps at
// 32 bits, integer division truncates, `>>` floors, a radix operand keeps its bit-pattern reading,
// and a float stays exact until its use picks `f32` or `f64`.
const K = 2147483647 + 1
const x: i64 = 9000000000000
print(x / K)
const M = 1 << 40
const m: i64 = M
print(m)
const H = 0.1 + 0.2
const h32: f32 = H
print(h32)
print(H)
print(K)
print(-7 / 2)
print(-7 % 2)
print(-1024 >> 3)
print((1 << 70) >> 60)
const A = 1 << 20
const B = A * 4096
print(B)
const P = 0xFFFF0000 | 0xFF
const p: i32 = P
print(p)
print(7 / 2)
print(1 + 0.5)
const W = 2.5 * 4
const w: i64 = W
print(w)
print(1.0 / 3)
const G = 1.5 * 4000000000
function take(v: i64) { print(v) }
take(G)
