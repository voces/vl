// @run
// @log 4
// @log 4
// @log -1
// @log 3
// @log 4
// The fallible casts over a hole call's result that do not propagate run: `as!` traps only on a
// miss, `as?` yields null, and a bare `as` over the hole's `i32` call cannot fail (D8060). A
// function that can return the null takes it.
function add(a, b) { return a + b }
function p(g) {
  print(g(1.5, 2.5) as! i32)
  print(g(1.5, 2.5) as? i32 ?? -1)
  print(g(1.5, 2.0) as? i32 ?? -1)
  print(g(1, 2) as i32)
}
function s(g): i32 | null {
  const v = g(1.5, 2.5) as i32
  return v
}
p(add)
print(s(add) ?? -1)
