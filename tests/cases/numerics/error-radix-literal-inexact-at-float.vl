// @check
// @error i32 doesn't fit in f32 — the conversion is lossy and must be made explicit with `as` (write `x as f32`)
// @error i64 doesn't fit in f64 — the conversion is lossy and must be made explicit with `as` (write `x as f64`)
// @error operator '+' mixes f64 and i64
// A float destination or peer takes a radix literal only where the float holds the value its
// digits spell exactly, as it does a decimal; `as` rounds instead (owner ruling 4.1).
const b: f32 = 0x7FFFFFFF
const c: f64 = 0x7FFFFFFFFFFFFFFF
print(b)
print(c)
print(1.5 + 0xFFFFFFFFFFFFFC00)
