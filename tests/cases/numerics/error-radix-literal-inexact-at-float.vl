// @check
// @error constant 2147483647 is not exact at f32 — write it as a float literal to round it
// @error constant 9223372036854775807 is not exact at f64 — write it as a float literal to round it
// @error constant 18446744073709550592 is not exact at f64 — write it as a float literal to round it
// A float destination or peer takes a radix literal only where the float holds the value its
// digits spell exactly, as it does a decimal, and refuses one it does not with the decimal's own
// sentence; `as` rounds instead (owner ruling 4.1).
const b: f32 = 0x7FFFFFFF
const c: f64 = 0x7FFFFFFFFFFFFFFF
print(b)
print(c)
print(1.5 + 0xFFFFFFFFFFFFFC00)
