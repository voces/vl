// @check
// @error-at 12:34 `as u8` propagates null, which the enclosing function cannot return (it returns void) — use `as!` to trap instead, or `as?` to take the null here (`as%` wraps an integer)
// @error-at 14:9 `as u8` propagates null — use `as!` to trap instead, or `as?` to take the null here (`as%` wraps an integer); to propagate it, annotate the enclosing function's return type
// @error-at 18:9 `as u8` propagates null, which the enclosing function cannot return (it returns f64) — use `as!` to trap instead, or `as?` to take the null here (`as%` wraps an integer)
// @error-at 22:9 `as u8` propagates null — use `as!` to trap instead, or `as?` to take the null here (`as%` wraps an integer); to propagate it, annotate the enclosing function's return type
// @error-at 25:7 `as u8` propagates null out of the enclosing function, and there is none here — at module scope, use `as!` to trap or `as?` to take a nullable (`as%` wraps an integer)
// @hint redundant type annotation: `annotatedRet` is inferred as `f64` — remove it to lean on inference
// A bare `as u8` from an `i32` can fail, and its fix is the cast's own suffix whatever the
// enclosing function returns (D3582, sunpa SP-022). In a function whose return type is
// inferred the message used to say only "annotate the enclosing function's return type",
// which would make a store into a `u8[]` turn every caller nullable.
const a: u8[] = [0, 0]
function voidRet(g: i32) { a[0] = g as u8 }
function inferredRet(g: i32) {
  a[0] = g as u8
  1.5
}
function annotatedRet(g: i32): f64 {
  a[0] = g as u8
  1.5
}
const lam = (g: i32) => {
  a[1] = g as u8
  2
}
a[1] = lam(4) as u8
voidRet(1)
print(inferredRet(3))
print(annotatedRet(3))
print(lam(4))
