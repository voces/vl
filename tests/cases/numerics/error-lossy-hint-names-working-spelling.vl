// @check
// @error-at 11:17 f64 doesn't fit in i32 — the conversion is lossy and must be made explicit with `as` (write `x as! i32` to trap when it does not fit, or `x as? i32` for an `i32 | null`)
// @error-at 16:40 return type mismatch: expected i32, got f64 — the conversion is lossy and must be made explicit with `as` (write `x as! i32` to trap when it does not fit, or `x as? i32` for an `i32 | null`)
// @error-at 19:40 return type mismatch: expected i32, got i64 — the conversion is lossy and must be made explicit with `as` (write `x as! i32` to trap when it does not fit, `x as? i32` for an `i32 | null`, or `x as% i32` to keep its low bits)
// @error-at 23:17 f64 doesn't fit in i32 — the conversion is lossy and must be made explicit with `as` (write `x as i32`)
// @error-at 28:39 return type mismatch: expected f32, got i32 — the conversion is lossy and must be made explicit with `as` (write `x as f32`)
// The lossy-number note names the spelling that compiles where it stands. A float-to-integer
// or narrowing conversion's bare `as` propagates `null`, so in a function whose return cannot
// carry it the note names `as!` and `as?` (and `as%` from an integer); where the return can,
// or the conversion cannot fail, it names the bare `as`. A returned value gets the note too.
function bound(u: f64): i32 {
  const k: i32 = u
  return k
}
print(bound(3.0))

function returned(u: f64): i32 { return u }
print(returned(3.0))

function narrowed(n: i64): i32 { return n }
print(narrowed(3))

function nullable(u: f64): i32 | null {
  const k: i32 = u
  return k
}
print(nullable(3.0))

function widened(n: i32): f32 { return n }
print(widened(3))
