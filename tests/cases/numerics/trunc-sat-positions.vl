// @run
// @log 2
// @log 3
// @log -2147483648
// @log 3
// @log 2147483647
// @log 0
// @log 0
// @log 3
// @log 1
// @log 0
// @log -1294967296
// @log 3000000001
// A saturating truncation where its operand is a float or integer literal, an f32 expression,
// a lambda's parameter, a named function's, a getter's receiver, a list element and a loop
// variable, and where its i64 result feeds arithmetic.
type Box = new f64
get t(self: Box): i32 { __trunc_sat_f64_s_i32__(self as! f64) }

function viaNamed(x: f64) { __trunc_sat_f64_u_i64__(x) }

function main() {
  print(__trunc_sat_f32_s_i32__(2.5))
  print(__trunc_sat_f32_s_i32__(3))
  print(__trunc_sat_f32_s_i32__(-1.0e30))
  const half: f32 = 0.5
  print(__trunc_sat_f32_u_i64__(half * 7.0))
  const f = (x: f64) => __trunc_sat_f64_s_i32__(x * 2.0)
  print(f(1.0e10))
  const g = (x: f64) => viaNamed(x)
  print(g(-3.0))
  const bx = (0.0 / 0.0) as! Box
  print(bx.t)
  const xs = [1.5, -2.5, 3.0e9]
  print(xs.map((v) => __trunc_sat_f64_s_i32__(v)).length)
  for v in xs { print(__trunc_sat_f64_u_i32__(v)) }
  const y = __trunc_sat_f64_s_i64__(xs[2]) + 1
  print(y)
}
main()
