// @run
// @log 1065353216
// @log 0
// @log -2147483648
// @log -1082130432
// @log 1073741824
// @log 1
// @log true
// @log 0
// @log -1082130432
// @log 2143289344
// @log 1065353217
// @hint redundant type annotation: `bitsRoundTrip` is inferred as `i32`
// `f32bits` / `f32fromBits` are the 32-bit REINTERPRET pair: one wasm instruction
// each (`i32.reinterpret_f32` / `f32.reinterpret_i32`), moving no bits — the same
// word is simply read at the other type. That is what makes float state hashable
// and a NaN payload inspectable, neither of which a numeric `as` cast can do.
const one: f32 = 1.0
const zero: f32 = 0.0
const negZero: f32 = -0.0
const negOne: f32 = -1.0
const two: f32 = 2.0
print(f32bits(one))     // 0x3f800000
print(f32bits(zero))    // 0x00000000
print(f32bits(negZero)) // 0x80000000 — the SIGN BIT, which `zero == negZero` cannot see
print(f32bits(negOne))  // 0xbf800000
print(f32bits(two))     // 0x40000000

print(f32fromBits(1065353216)) // 1
// The sign of zero survives the trip back — asserted through the BITS, because
// `print` of a negative zero renders host-dependently while its pattern does not.
print(f32bits(f32fromBits(-2147483648)) == -2147483648)

// Round trips, through a runtime value rather than a constant: bits -> float -> bits
// reproduces the pattern exactly for a finite value and for a quiet NaN (0x7fc00000),
// whose payload an arithmetic NaN would be free to replace.
function bitsRoundTrip(b: i32): i32 { f32bits(f32fromBits(b)) }
print(bitsRoundTrip(0))
print(bitsRoundTrip(-1082130432))
print(bitsRoundTrip(2143289344))

// The result is an ordinary i32 in an inferred local: the checker records the call's
// type, so the local gets an i32 slot and integer arithmetic applies to it.
let k = f32bits(one)
k = k + 1
print(k)
