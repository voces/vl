// @run
// @log 1.5
// @log 2
// @log 0.5
// @log 3
// A nullable number read coalesced with a number of another type keeps the numbers apart in a
// join, the present value as itself and a miss as the default, printed and added alike.
function orHalf(a: (i64 | null)[]) { print(a[1] ?? 0.5) }
function orHalfAdd(a: (i32 | null)[]) { print((a[0] ?? 0.5) + 1) }
const x: (i64 | null)[] = [1, null]
const y: (i32 | null)[] = [1]
const z: (f64 | null)[] = [1.5]
print(z[0] ?? 2)
orHalfAdd(y)
orHalf(x)
print((y[0] ?? 0.5) + 2)
