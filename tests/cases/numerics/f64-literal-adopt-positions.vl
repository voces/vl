// @run
// @log 2147483648
// @log 9000000000
// @log 4503599627370496
// @log 9007199254740992
// @log -9000000000
// @log 9000000000
// @log 9000000000
// @log 9000000000
// @log 9000000000
// @log 9000000000
// @log 9000000000
// @log 9000000000
// @log 9000000000
// @log 9000000000
// @log 9000000001
// @log 1
// @log 12884901888
// @hint redundant type annotation: `gAssign` is inferred as `f64`
// @hint redundant type annotation: `la` is inferred as `f64`
// @hint redundant type annotation: `mkf` is inferred as `f64`
// The f64 half of the contextual-integer-literal rule. An integer literal past the i32
// range types `i64`, so the only implicit route into an f64 slot was the widening
// lattice's `i32 -> f64` edge and everything above 2^31 met the lossy `i64 -> f64`
// refusal — while the same literal adopted the strictly LESS precise `f32`, which has
// its own exactness-gated predicate. D1890.
//
// The boundary is the point: `9007199254740992` (2^53) is the last integer f64 holds
// exactly and runs; `9007199254740993` is one more and still refuses. Its own case is
// `f64-literal-adopt-boundary.vl`, because a refusal cannot share a `@run` fixture.

// ── the exactness boundary, at the plainest position ────────────────────────
const b31: f64 = 2147483648       // 2^31
const b52: f64 = 4503599627370496 // 2^52
const b53: f64 = 9007199254740992 // 2^53 — the last exact one
const neg: f64 = -9000000000
print(b31)
print(9000000000.0)
print(b52)
print(b53)
print(neg)

// ── every delivery position ─────────────────────────────────────────────────
function ret(): f64 { return 9000000000 }
print(ret())

function arg(v: f64) { print(v) }
arg(9000000000)

const elem: f64[] = [9000000000]
print(elem[0])

type Holder = { v: f64 }
const fld: Holder = { v: 9000000000 }
print(fld.v)

let gAssign: f64 = 0.0
gAssign = 9000000000
print(gAssign)

function local() {
  const l: f64 = 9000000000
  print(l)
  let la: f64 = 0.0
  la = 9000000000
  print(la)
}
local()

const clo = (): f64 => 9000000000
print(clo())

// A union member, which boxes the payload: the box's atom is the union's FLOAT arm, not
// the literal's own `i64` — the D1930 half of this fix.
const nul: f64 | null = 9000000000
if nul != null { print(nul) } else { print(0) }

// ── the arithmetic face, which the assignment site does not cover ───────────
function mkf(): f64 { return 1.0 }
print(mkf() + 9000000000)
if mkf() < 9000000000 { print(1) } else { print(0) }

// A radix literal past the i32 range takes the same grant.
const hex: f64 = 0x300000000
print(hex)
