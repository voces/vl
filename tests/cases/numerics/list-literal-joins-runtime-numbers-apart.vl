// @run
// @log i32
// @log f64
// @log 3
// @log 1.125
// @log <7>
// @log true
// @log i32
// @log f64
// @log i32
// @log i32
// @log i32
// @log i32
// @log f64
// @log 1
// @log i32
// @log i64
// @log f64
// @log f64
// @log i32
// @log i32
// @log f64
// @log 3.5
// @log 7000000000
// @hint this 2-element `f64[]` is only read at fixed indexes
// A list literal whose elements are runtime numbers of different types is a list of their union,
// as `[if c { a } else { b }]` is: each element keeps its own type, and a literal element adapts
// to the runtime elements' join (D3451).
import { indexOf, reverse } from "std:array"

function kind<T>(v: T) {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}

function id<T>(v: T) { v }

function hole(v) { kind(v[0]) }

function ret(a: i32, b: f64) { [a, b] }

function pair(a: i32, b: f64) {
  const xs = [a, b]
  print(kind(xs[0]))
  print(kind(xs[1]))
  print(xs[0] / 2)
  print(xs[1] / 2)
  print("<\{xs[0]}>")
  print(xs[0] is i32)
  for x in xs { print(kind(x)) }
}
pair(7, 2.25)

// Return, field, generic pin, hole, `std:array` and a generic body.
function wide<A, B>(a: A, b: B) { [a, b] }
function places(a: i32, b: f64, n: i64) {
  print(kind(ret(a, b)[0]))
  const o = { v: [a, b] }
  print(kind(o.v[0]))
  print(kind(id([a, b])[0]))
  print(hole([a, b]))
  const ys = reverse([a, b])
  print(kind(ys[0]))
  print(indexOf([a, b], b))
  print(kind(wide(a, n)[0]))
  print(kind([b, a, n][2]))
}
places(7, 2.25, 9000000001)

// Literal elements adapt: alone, beside one runtime type, and beside a runtime join.
function lits(a: i32, b: f64) {
  print(kind([1, 2.5][0]))
  print(kind([a, 2.5][0]))
  print(kind([a, b, 4][2]))
  print(kind([4, a, b][0]))
  print(kind([a, b, 2.5][2]))
}
lits(7, 2.25)

// An annotated destination converts every member that converts exactly.
function dest(a: i32, b: f64, n: i64) {
  const fs: f64[] = [a, b]
  print(fs[0] / 2)
  const ls: i64[] = [a, n]
  print(ls[0] * 1000000000)
}
dest(7, 2.25, 9000000001)
