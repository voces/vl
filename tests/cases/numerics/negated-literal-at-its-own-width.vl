// @run
// @log -2147483648
// @log -6
// @log -3.5
// @log -1.5
// @log -9223372036854775808
// @log -6
// @log -2147483648
// @log true
// A negated literal is one constant at the negation's own width: `-2147483647` in `- 1` has a
// magnitude the checker types `i64` under an `i32` negation. Also a plain chain, floats, the
// least i64, a parenthesised operand, and the i32 minimum written as one literal.
function a4() { return -2147483647 - 1 }
function a1() { return -5 - 1 }
function a6() { return -2.5 - 1.0 }
function a7(): f32 { return -1.5 }
function a8() { return -9223372036854775807 - 1 }
function a9(x: i32) { return x * -(3) }
function b1() { return -2147483648 }
function b2(x: i32) { return x > -2147483648 }
print(a4())
print(a1())
print(a6())
print(a7())
print(a8())
print(a9(2))
print(b1())
print(b2(0))
