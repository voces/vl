// @run
// @log 3
// @log 1.5
// @log 3.5
// @log -2
// @log -1
// @log -1
// @log 2
// @log 0
// @log 2
// @log 2
// @log 1
// @log 2
// @log -3
// @log 3
// @log 3
// The single-opcode IEEE float operations at f64. Every one is fully specified by
// IEEE-754 and lowers to one wasm instruction, which is what makes them safe for a
// program that must reproduce its results bit-for-bit on every host.
const x = 2.25
print(sqrt(9.0))
print(abs(0.0 - 1.5))
print(abs(3.5))

// The three roundings differ on a NEGATIVE operand — floor goes down, ceil up, trunc
// toward zero — which is exactly where a `(x as i32)` cast would silently disagree.
print(floor(0.0 - 1.5))
print(ceil(0.0 - 1.5))
print(trunc(0.0 - 1.5))
print(ceil(1.5))

// `nearest` is round-half-to-EVEN, not "round half up": 0.5 -> 0 and 2.5 -> 2, while
// 1.5 -> 2. A library `round` would answer 1, 3, 2 here.
print(nearest(0.5))
print(nearest(1.5))
print(nearest(2.5))

print(min(1.0, 2.0))
print(max(1.0, 2.0))
print(copysign(3.0, 0.0 - 1.0)) // magnitude of the first, sign of the second
print(copysign(0.0 - 3.0, 1.0))

// An INTEGER operand widens into the f64 operation, as it does for `/` — `sqrt(9)` is
// the f64 square root of 9, not an integer operation.
print(x - x + sqrt(9))
