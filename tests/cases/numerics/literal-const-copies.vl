// @run
// @log 4294967295
// @log 4294967295
// @log 4294967295
// @log 4294967295
// A binding initialised by a bare read of a literal `const` holds that literal, as if it were
// written there: a `let` is typed by its deliveries, and a copying `const` is its literal at
// every read, in either order of declaration (D3246).
function takeI64(x: i64) { x }
const M = 0xFFFFFFFF
let bb = M
print(takeI64(bb))
function f() {
  let cc = M
  print(takeI64(cc))
  const dd = M
  print(takeI64(dd))
}
f()
const A2 = A3
const A3 = M
print(takeI64(A2))
