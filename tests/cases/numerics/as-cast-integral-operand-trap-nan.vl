// @trap
// `floor` of NaN is NaN, which no integer holds: with the integrality test omitted for a
// `floor` operand, the range test is what refuses it. The trailing print never runs.
function ff64(x: f64) { x }
function cell(x: f64) {
  const fx = floor(x)
  fx as! i32
}
print(cell(ff64(-5.5)))
print(cell(ff64(0.0) / ff64(0.0)))
print(-1)
