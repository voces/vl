// @run
// @log 0.20000001788139343
// @log 0.20000001788139343
// @log 0.20000001788139343
// @log 0.20000001788139343
// @log 1.2000000476837158

// A float constant tree folds in `f32` arithmetic where `f32` is the number member it adopts: a
// union with `string`, an argument of one, an aliased nullable, a nullable field and a compound
// write (E9.1, D16414). `0.3 - 0.1` is `0.19999999999999998` in doubles.
type F = f32
function g(x: f32 | string) {
  if x is f32 { print(x) }
}
const u: f32 | string = 0.3 - 0.1
if u is f32 { print(u) }
g(0.3 - 0.1)
const a: F | null = 0.3 - 0.1
print(a ?? 0.0)
const r: { x: f32 | null } = { x: 0.3 - 0.1 }
print(r.x ?? 0.0)
let w: f32 = 1.0
w += 0.3 - 0.1
print(w)
