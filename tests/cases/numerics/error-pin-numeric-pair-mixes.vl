// @check
// @error operator '*' over i64 | f64 and f64 mixes the members i64 and f64; narrow with `is` or convert with `as` first
// @error argument 1: operator '+' mixes i64 and f64 (`add` applies '+' to parameter `x`, at 16:26)
// @error argument 1: operator '/' mixes f64 and i64 (`lam` applies '/' to this argument, at 18:20)
// @error argument 1: operator '-' mixes i64 and f64 (`gen` applies '-' to parameter `x`, at 20:32)
// @error comparison mixes i64 and f64 (`less` applies '<' to parameters `a` and `b`, at 24:30)
// @error argument 2: operator '==' over i64 | f64 and i64 mixes the members f64 and i64; narrow with `is` or convert with `as` first (`pickEq` applies '==' to parameter `a`, at 28:9)
// An un-annotated or generic body pinned at i64 beside f64 is refused with the sentence the
// direct spelling gets (D9802, D9682, D3613); `pin-numeric-pair-controls.vl` runs the `as` spellings.
const jq: i64 | null = null
function take(a) {
  const r = a ?? 0.5
  print(r * 2.0)
}
take(jq)
function add(x) { return x + 1.5 }
print(add(5000000000))
const lam = (x) => 1.5 / x
print(lam(5000000000))
function gen<T>(x: T) { return x - 1.5 }
print(gen(5000000000))
const big: i64 = 7
const half = 2.5
function less(a, b) { return a < b }
print(less(big, half))
function pickEq<A, B>(k: i32, a: A, b: B) {
  const v = if k == 0 { a } else { b }
  print(v == a)
}
pickEq(0, big, half)
