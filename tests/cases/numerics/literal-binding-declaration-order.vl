// @run
// @log 10000000000
// @log 10000000000
// @log 10000000000
// @log 15
// @log 5000000000
// @log 1.25
// @log 1.100000023841858
// @log 1.100000023841858
// A literal `let` takes the same type whatever order the bindings are declared in (PL-079,
// D3343): a store widens the binding it writes, and never caps what was stored into it. A chain
// of stores settles from its sources, through an operand, a copy or an integer intrinsic.
function w() { 5000000000 }
function sx32(v: i64) { (v << 32) >> 32 }
function g32(x: f32) { print(x) }
function wf32(): f32 { 1.1 }
function stored() {
  let r9 = 0
  let r10 = 0
  r10 = w()
  r9 = r10 * 2
  print(r9)
}
function copied() {
  let r8 = 0
  let r9 = 0
  let r10 = 0
  r8 = 7
  r10 = w()
  r9 = r10
  r8 = r9 * 2
  print(r8)
}
function intrinsic() {
  let v2 = 0
  let v1 = 0
  let v0 = 0
  v0 = w()
  v1 = divU(v0, 1)
  v2 = divU(v1, 1) * 2
  print(v2)
}
function plumb() {
  let rax = 0
  let r9 = 0
  let r10 = 0
  rax = 5
  r10 = sx32(rax)
  r9 = r10 + r10 * 2
  print(r9)
}
function source() {
  let b = 0
  let a = 0
  a = w()
  b = a
  print(b)
}
function toF32() {
  let v0 = 0.5
  let v1 = 0.5
  let v2 = 0.5
  v0 = 1.25
  v1 = v0
  v2 = v1
  g32(v2)
}
function fromF32() {
  let v0 = 0.5
  let v1 = 0.5
  v0 = wf32()
  v1 = v0
  g32(v1)
  print(v0)
}
stored()
copied()
intrinsic()
plumb()
source()
toF32()
fromF32()
