// @check
// @error-at 10:8 `as i32` propagates null, which the enclosing function cannot return (it returns void) — use `as!` to trap instead, or `as?` to take the null here
// A `const` copy of a hole parameter is a read of it, so the cast through the copy is judged at
// the pin as a direct read is: the annotated twin's refusal, not a silent swallow (D1373).
function mk(n: i32): i32 | null {
  if n == 0 { return 5 }
  return null
}
function take(a) {
  const c = a
  print(c as i32)
  print(99)
}
take(mk(1))
