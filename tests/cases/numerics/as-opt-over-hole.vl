// @run
// `x as? N` over an un-annotated parameter is `N | null` at every pin, as over a type
// parameter, and converts at the pin its call gives the hole (D3654).
const k = (x) => x as? u8
print(k(300))
print(k(5))
function toI(x) {
  const r = x as? i32
  r
}
print(toI(2.5))
print(toI(4.0))
print(toI("s"))
function orNeg(x) { (x as? i32) ?? -1 }
print(orNeg(6.5))
print(orNeg(9))
function inner(x) {
  const f = () => x as? u8
  f()
}
print(inner(9))
print(inner(900))
