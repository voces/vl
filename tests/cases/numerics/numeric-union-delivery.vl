// @run
// @log 3.5
// @log 3.5
// @log 3.5
// @log 3.5
// @log 3.5
// @log 7
// @log 9000000007
// @log 5
// @log 9000000005
// @log 2.5
// @log null
// @log 3
// @log 3
// A numeric union delivers into a numeric type every member widens to exactly: `i32 | f64`
// into `f64` at a binding, an argument, a field and a return, and `i32 | i64` into `i64`. An
// `as` no member can fail converts at the member held, while one that can fail stays the member
// cast it is over any union (D3450).
type P = { v: f64 }
function half(v: f64) { print(v / 2) }
function back(c: boolean, x: f64, y: i32): f64 {
  if c { x } else { y }
}
function f(c: boolean, x: f64, y: i32) {
  const u: i32 | f64 = if c { x } else { y }
  const w: f64 = u
  print(w / 2)
  const z: f64 = if c { x } else { y }
  print(z / 2)
  half(if c { x } else { y })
  const p: P = { v: if c { x } else { y } }
  print(p.v / 2)
  print(back(c, x, y) / 2)
}
f(false, 2.5, 7)
function g(c: boolean, w: i64, y: i32) {
  const r = if c { w } else { y }
  const z: i64 = r
  print(z)
  print(r as i64 + 9000000000)
}
g(false, 9, 7)
g(true, 5, 7)
function h(c: boolean, x: f64, y: i32) {
  const r = if c { x } else { y }
  print(r as f64)
  print(r as? i32)
}
h(true, 2.5, 3)
h(false, 2.5, 3)
