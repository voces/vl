// @run
// @log 6
// @log 2.5
// @hint redundant type annotation: `abs` is inferred as `i32`
// @hint redundant type annotation: `magnitude` is inferred as `f64`
// THE GUARDED SIDE of the capture exemption. A numeric-opcode intrinsic is a
// FALLBACK for a name the program did not define (`bitcast-shadowed.vl` pins
// that rule for a direct call), so the exemption `capScan` grants in callee
// position must NOT fire when something in scope binds the spelling — otherwise
// a genuine capture of the program's own `abs` would be dropped and the lambda
// would lower an opcode over an i32, which is not even a typed operation.
//
// Here the shadowing declaration is a top-level FUNCTION, which is the case the
// guard's `fnIndexOf` arm answers; the un-shadowed sibling on the last line
// still lowers as `i64.reinterpret_f64` in the same module.
function abs(x: i32): i32 {
  if x < 0 { return 0 - x }
  x
}

const useAbs = (v: i32) => abs(v) * 2
print(useAbs(0 - 3))

function magnitude(x: f64): f64 { f64fromBits(f64bits(x) & 9223372036854775807) }
print(magnitude(0.0 - 2.5))
