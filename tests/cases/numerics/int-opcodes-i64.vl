// @run
// @log 63
// @log 64
// @log 64
// @log 31
// @log 32
// @log 1
// @log 64
// @log 8589934592
// @log 2147483648
// @log 4294967296
// @log 4294967296
// @log 6148914689804861440
// @log 0
// The same integer operations at i64 — a DIFFERENT instruction per width, chosen from
// the operands as it is for `+` and `<<`. `clz`/`ctz`/`popcnt` yield an i64 here, which
// is what the wasm instructions do: `i64.clz` leaves an i64 on the stack.
const one: i64 = 1
const zero: i64 = 0
const bit32: i64 = 4294967296 // 2^32, past the i32 range
print(clz(one))
print(clz(zero)) // 64, the full width
print(ctz(zero))
print(clz(bit32))
print(ctz(bit32))
print(popcnt(bit32))
print(popcnt(0 - one)) // every bit of a 64-bit word

// The rotate count is taken modulo 64 here, not 32 — the width follows the operand.
print(rotl(bit32, one))
print(rotr(bit32, one))
print(rotl(bit32, 0 - zero))
print(rotl(bit32, 64))

// Unsigned division at 64 bits: -2^32 reads as 18446744069414584320, which 3 divides
// exactly.
print(divU(0 - bit32, 3))
print(remU(0 - bit32, 3))
