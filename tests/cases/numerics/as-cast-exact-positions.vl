// @run
// @log 3
// @log null
// @log 3
// @log null
// @log 3
// @log null
// @log 3
// @log null
// @log 3
// @log null
// @log 3
// @log null
// @log 3
// @log null
// @log 3
// @log null
// @log 3
// @log null
// @log 3
// @log null
// @log 3
// @log 0
// @log 3
// @log null
// @log 7
// @hint redundant type annotation: `ff64` is inferred as `f64`
// @hint redundant type annotation: `a1` is inferred as `i32 | null`
// @hint redundant type annotation: `a2` is inferred as `i32 | null`
// @hint redundant type annotation: `s1` is inferred as `{v: i32 | null}`
// @hint redundant type annotation: `s2` is inferred as `{v: i32 | null}`
// @hint redundant type annotation: `xs` is inferred as `(i32 | null)[]`
// @hint redundant type annotation: `gOk` is inferred as `i32 | null`
// @hint redundant type annotation: `g1` is inferred as `i32 | null`
// @hint redundant type annotation: `g2` is inferred as `i32 | null`
// THE DELIVERY MATRIX for `d as? i32`'s `i32 | null` result — D965's discipline, because a
// capability enforced in ONE place (the checker) is served in MANY (every syntactic position
// the value can be delivered to), and narrowing the gate without wiring them all is how a
// loud refusal becomes check-clean invalid wasm at the positions nobody tried.
//
// Twelve positions, each with the SUCCEEDING and the FAILING value so the row proves the
// conversion actually happened rather than that something compiled: `3.0` → `3`, `3.9` →
// `null`. Ten of them ran off `emitAsCast`'s exact-or-fail arm alone; `?? 0` needed the
// coalesce stash arm widened (an `as?` is the other non-re-readable box source beside a
// call) and the generic needed `monoArgTyName` — every channel in that cascade asks a
// BINDING, and a cast written inline at the call site is none of them.
//
// AND HALF OF THEM ARE UN-ANNOTATED ON PURPOSE (D969): an annotation pins the rep, so a
// fixture that annotates every destination cannot see a defect whose ingredient is
// INFERENCE doing the pinning instead.
function ff64(x: f64): f64 { x }

// 1. annotated binding · 2. UN-annotated binding
const a1: i32 | null = ff64(3.0) as? i32
const a2: i32 | null = ff64(3.9) as? i32
print(a1)
print(a2)
const b1 = ff64(3.0) as? i32
const b2 = ff64(3.9) as? i32
print(b1)
print(b2)

// 3. function-body TAIL · 4. `return`
function tailOf(d: f64): i32 | null {
  d as? i32
}
print(tailOf(3.0))
print(tailOf(3.9))
function retOf(d: f64): i32 | null {
  return d as? i32
}
print(retOf(3.0))
print(retOf(3.9))

// 5. ARGUMENT to a union-typed parameter · 6. `print`'s own argument
function show(v: i32 | null) {
  print(v)
}
show(ff64(3.0) as? i32)
show(ff64(3.9) as? i32)
print(ff64(3.0) as? i32)
print(ff64(3.9) as? i32)

// 7. STRUCT FIELD init
type Box = { v: i32 | null }
const s1: Box = { v: ff64(3.0) as? i32 }
const s2: Box = { v: ff64(3.9) as? i32 }
print(s1.v)
print(s2.v)

// 8. LIST ELEMENT
const xs: (i32 | null)[] = [ff64(3.0) as? i32, ff64(3.9) as? i32]
print(xs[0])
print(xs[1])

// 9. GLOBAL init, read from inside a function — annotated and inferred side by side
const gOk: i32 | null = ff64(3.0) as? i32
const gBad = ff64(3.9) as? i32
function globals() {
  print(gOk)
  print(gBad)
}
globals()

// 10. ASSIGNMENT to an existing `i32 | null` local
function assigned(d: f64) {
  let cell: i32 | null = null
  cell = d as? i32
  print(cell)
}
assigned(3.0)
assigned(3.9)

// 11. `??` immediately after — the coalescing consumer
print((ff64(3.0) as? i32) ?? 0)
print((ff64(3.9) as? i32) ?? 0)

// 12. THROUGH A GENERIC, at two instantiations — the cast's `i32 | null` and a plain `i32`,
// so the row also proves the second instance is not the first one's pin reused.
function idn<T>(x: T): T {
  x
}
const g1: i32 | null = idn(ff64(3.0) as? i32)
print(g1)
const g2: i32 | null = idn(ff64(3.9) as? i32)
print(g2)
print(idn(7))
