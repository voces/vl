// @run
// @log 4607182418800017408
// @log 0
// @log -9223372036854775808
// @log 4611686018427387904
// @log 1
// @log true
// @log 9221120237041090561
// @log 9218868437227405312
// @log true
// @log 3
// `f64bits` / `f64fromBits` are the 64-bit REINTERPRET pair (`i64.reinterpret_f64` /
// `f64.reinterpret_i64`) — the f32 pair's sibling at double width, and the one a
// deterministic float hash actually runs on.
print(f64bits(1.0))  // 0x3ff0000000000000
print(f64bits(0.0))  // 0x0000000000000000
print(f64bits(-0.0)) // 0x8000000000000000 — i64 MIN as a signed pattern
print(f64bits(2.0))  // 0x4000000000000000

print(f64fromBits(4607182418800017408)) // 1
// The sign of zero survives the trip back — asserted through the BITS, because
// `print` of a negative zero renders host-dependently while its pattern does not.
print(f64bits(f64fromBits(-9223372036854775808 + 0)) == -9223372036854775808 + 0)

// A NaN PAYLOAD survives the round trip bit-for-bit. This is the point of the pair:
// wasm lets an arithmetic NaN carry an engine-chosen payload, so determinism-critical
// code canonicalizes through the bits rather than trusting the float. 0x7ff8000000000001
// is a quiet NaN with payload 1; reinterpreting it in and back out reproduces it.
function bitsRoundTrip(b: i64): i64 { f64bits(f64fromBits(b)) }
print(bitsRoundTrip(9221120237041090561))
print(bitsRoundTrip(9218868437227405312)) // +infinity, 0x7ff0000000000000

// The reinterpreted NaN really is a NaN — it compares unequal to itself — while the
// bits above are an ordinary i64 that compares equal.
const nan = f64fromBits(9221120237041090561)
print(nan != nan)

// The result of `f64fromBits` is an ordinary f64 in an inferred local.
let v = f64fromBits(4611686018427387904)
v = v + 1.0
print(v)
