// @log true
// @log false
// @log 5
// @log true
// @log false
// @log 3
// @log false
// @log true
// @log 1.5
// Two runtime numbers beside a `null` arm join as `i32 | f64 | null` in either arm order, in the
// direct spelling and at a generic pin alike, so `is` answers for the arm taken (D3363).
function g(a: i32, b: f64, k: i32) {
  const r = if k == 0 { a } else if k == 1 { b } else { null }
  print(r is i32)
  print(r is f64)
  print(r)
}
g(3, 1.5, 0)
g(3, 1.5, 1)
g(3, 1.5, 2)
function h(a: f64, b: i32, k: i32) {
  const r = if k == 0 { a } else if k == 1 { null } else { b }
  print(r is i32)
  print(r is f64)
  print(r)
}
h(2.5, 5, 0)
h(2.5, 5, 2)
function j<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { null } else if k == 1 { a } else { b }
  print(r is i32)
  print(r is f64)
  print(r)
}
const ja = 3
const jb = 1.5
j(ja, jb, 1)
j(ja, jb, 2)
