// @trap
// `floor(x) as! i32` through a `const` tests only the range, and a value past it still traps:
// 3e9 is integral and outside i32. The trailing print never runs.
function ff64(x: f64) { x }
function cell(x: f64) {
  const fx = floor(x)
  fx as! i32
}
print(cell(ff64(5.5)))
print(cell(ff64(3000000000.5)))
print(-1)
