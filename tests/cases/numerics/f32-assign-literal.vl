// @run
// @log 2.5
// @log 2.5
// @log 2.5
// @log -2.5
// @log true
// @log true
// @log 2.5
// @log 2.5
// @log 2.5
// @log 2.5
// An f32 CELL assigned a float literal re-encodes at SINGLE precision.
//
// `emitAssign` grew an i64 arm and an f64 arm on both storage classes but never an f32
// one, and `emitExpr` lowers a bare `.` literal at f64 (its default), so `let g: f32 =
// 1.0` + `g = 2.5` pushed an `f64.const` into the `(mut f32)` cell — invalid wasm from
// two ordinary lines with `vl check` clean, global / local / param alike.
//
// Only the LITERAL spelling was broken: an f32 VARIABLE or an f32-returning CALL on the
// right already carried the f32 rep, and the struct-FIELD / list-ELEMENT stores are a
// different arm entirely. Those four are the controls that pin the new arm did not take
// a cell that was already working.

// GLOBAL cell
let g: f32 = 1.0
g = 2.5
print(g)

// LOCAL cell
function localCell() {
  let l: f32 = 1.0
  l = 2.5
  print(l)
}
localCell()

// PARAM cell (same arm — a param resolves as a local index)
function paramCell(p: f32) {
  p = 2.5
  print(p)
}
paramCell(1.0)

// a NEGATED literal takes the same single-precision re-encode
function negated() {
  let n: f32 = 1.0
  n = -2.5
  print(n)
}
negated()

// a value that is not exactly representable in f64->f32 round-trip order: assigning the
// literal must give the SAME f32 as initializing the cell with it.
const seeded: f32 = 0.1
let assigned: f32 = 0.0
assigned = 0.1
print(seeded == assigned)

// CONTROLS — the spellings that already worked.
let fromVar: f32 = 1.0
fromVar = seeded
print(fromVar == seeded)

function mkF32(): f32 { return 2.5 }
let fromCall: f32 = 1.0
fromCall = mkF32()
print(fromCall)

type S = { v: f32 }
const s: S = { v: 1.0 }
s.v = 2.5
print(s.v)

const xs: f32[] = [1.0]
xs[0] = 2.5
print(xs[0])

// the f64 cell is untouched by the new arm
let d: f64 = 1.0
d = 2.5
print(d)
