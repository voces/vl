// @run
// @log 255
// @log 255
// @log 200
// @log 3
// @log 301
// @log 255
// @log 1
// @hint redundant type annotation: `f` is inferred as `i32`
// A narrowing cast over a value join whose every tail its domain holds cannot miss, so it
// is the infallible cast a bounded bare operand is, at module scope and in any function.
let c = true
c = !c
let k = 7
k = k + 1
let g: i64 = 300
g = g + 1
print((if c { 1 } else { 0xFF }) as u8)
const m = 2
print(
  (match m {
    1 => 3
    2 => 0xFF
    _ => 9
  }) as u8,
)
print((if c { 1 } else if k > 3 { 200 } else { 7 }) as u8)
print((if c { k & 0xFF } else { 3 }) as u8)
print((if c { 1 } else { g & 0xFFFF }) as i32)
function f(x: i32): i32 { return (if x > 0 { 1 } else { 0xFF }) as u8 }
print(f(0))
print(f(5))
