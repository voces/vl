// @check
// @error cannot assign f64 to i32 — `t` on line 8 has no annotation, so its literal defaulted to `i32`; annotate it: `let t: f64 = …` (parameter `xs` of `sum`, used at 11:9)
// A store a generic instance refuses into an un-annotated literal `let` names the binding and the
// annotation that fixes it, as the same store outside a generic body does (D16293): `t` is also
// delivered to an `i32`, so the hole stored into it does not type it.
function keep(n: i32): i32 { return n }
function sum(xs) {
  let t = 0
  let i = 0
  while i < xs.length {
    t = t + xs[i]
    i = i + 1
  }
  keep(t)
  return t
}
print(sum([1.5, 2.5]))
