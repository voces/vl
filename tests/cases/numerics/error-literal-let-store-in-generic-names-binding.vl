// @check
// @error cannot assign f64 to i32 — `t` on line 6 has no annotation, so its literal defaulted to `i32`; annotate it: `let t: f64 = …` (the body of `sum` at the call's argument types)
// A store a generic instance refuses into an un-annotated literal `let` names the binding and the
// annotation that fixes it, as the same store outside a generic body does (D16293).
function sum(xs) {
  let t = 0
  let i = 0
  while i < xs.length {
    t = t + xs[i]
    i = i + 1
  }
  return t
}
print(sum([1.5, 2.5]))
