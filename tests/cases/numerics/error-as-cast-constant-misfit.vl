// @check
// @error constant 300 does not fit `u8` (0..=255) — write `as%` to keep its low bits
// @error constant 256 does not fit `u8` (0..=255) — write `as%` to keep its low bits
// @error constant -1 does not fit `u8` (0..=255) — `as!` on it would trap on every run
// @error constant 256 does not fit `u8` (0..=255) — `as?` on it would be null on every run
// @error constant 2147483648 does not fit `i32` (-2147483648..=2147483647) — write `as%` to keep its low bits
// @error constant 3.5 is not a whole number, so `i32` cannot hold it
// @error constant 1e39 does not fit `f32`: it is past the largest finite f32
// @error constant 1099511627776 does not fit `i32` (-2147483648..=2147483647) — `as!` on it would trap on every run
// A cast whose operand is a constant tree the target cannot hold is a check error naming the
// value and the range (D3588). `as!` over it would trap on every run and `as?` would be null
// on every run, so neither is a way around it; `as%` still wraps, as written. A float target
// rounds, so only a value past its finite range misfits there.
const K = 255

function f() {
  const a: u8[] = []
  a.push(300 as u8)
  a.push((K + 1) as u8)
  a.push((2 - 3) as! u8)
  a.push(256 as? u8 ?? 0)
  a.push(300 as% u8)
  print(2147483648 as i32)
  print(3.5 as i32)
  print(1e39 as f32)
  print((1 << 40) as! i32)
  a.length
}

print(f())
