// @run
// @log 3
// @log 9
// @log 3
// @log 31
// @hint redundant type annotation: `min` is inferred as `i32`
// @hint redundant type annotation: `max` is inferred as `i32`
// `min` and `max` are the names a program is most likely to have already defined, so
// they are the sharpest test of the shadowing rule: a program's own function wins, and
// the intrinsics it did NOT define stay available in the same program.
function min(a: i32, b: i32): i32 {
  if a < b { return a }
  return b
}

function max(a: i32, b: i32): i32 {
  if a > b { return a }
  return b
}

print(min(3, 9)) // the program's own function, not `i32.min` (which does not exist)
print(max(3, 9))
print(min(3, 9) + max(0, 0)) // still the program's, in an expression
print(clz(1)) // an intrinsic the program did not define is untouched
