// @run
// @log true
// @log 3.5
// @log true
// @log 3.5
// @log true
// @log true
// @log true
// @log true
// A nested value join means what its hoisted twin means: the inner join's type wins, so its
// literal tail is built at it wherever the outer join delivers it (owner ruling, D3657).
function run(q: i32 | null, r: f64 | null) {
  const x = if q != null { q } else { if r != null { r } else { 7 } }
  print(x is f64)
  print(x / 2)
  const y = if q != null { q } else if r != null { r } else { 7 }
  print(y is f64)
  print(y / 2)
}
run(null, null)

function wide(q: i32 | null, r: i64 | null) {
  const x = if q != null { q } else { if r != null { r } else { 7 } }
  print(x is i64)
}
wide(null, null)

function ret(q: i32 | null, r: f64 | null) {
  if q != null { return q }
  return if r != null { r } else { 7 }
}
print(ret(null, null) is f64)

function g(x: i32 | f64) { print(x is f64) }
function arg(r: f64 | null) { g(if r != null { r } else { 7 }) }
arg(null)

function hoisted(q: i32 | null, r: f64 | null) {
  const inner = if r != null { r } else { 7 }
  const x = if q != null { q } else { inner }
  print(x is f64)
}
hoisted(null, null)
