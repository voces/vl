// @check
// @error i32 doesn't fit in f32
// @error i32 doesn't fit in f32
// @error i64 doesn't fit in f32
// The REJECTED side of the integer-literal exactness gate — the half that makes the grant
// a rule rather than a hole.
//
// This is where the two halves of the contextual-f32-literal rule deliberately DIVERGE. A
// `.` literal is context-typed and rounds once (`0.1` is admitted and becomes the f32
// nearest 0.1), because an exactness gate there would reject every useful constant and
// leave the feature with nothing to admit. An INTEGER literal denotes an exact integer, so
// the same permissiveness would silently turn `16777217` into `16777216` — the lossy
// implicit conversion the language's posture forbids.
//
// Both escape hatches stay open and both are one token: `16777217.0` (context-typed, ONE
// rounding, at f32) or `16777217 as f32` (an explicit convert). The rejection is about
// silence, not reachability.
const a: f32 = 16777217 // 2^24 + 1 — the first integer f32 cannot hold
const b: f32 = 33554433 // 2^25 + 1 — inexact for the same reason one octave up
const c: f32 = 9000000000 // past i32; 9e9 = 2^9 * 17578125, and 17578125 needs 25 bits
print(a)
print(b)
print(c)
