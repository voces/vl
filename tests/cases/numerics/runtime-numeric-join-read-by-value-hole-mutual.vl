// @run
// @log 3
// @log 1.25
// @log 3.5
// @log true
// @log 2
// @log false
// @log true
// @log false
// A runtime `i32`/`f64` join stays `i32 | f64` at a direct call of a function also read by
// value, through a hole parameter's null test, and in a mutually recursive generic pair
// (D10290, D10293, D10294).
function f(k: i32, a: i32, b: f64) {
  if k == 0 { return a }
  b
}
const h = f
print(f(0, 7, 2.5) / 2)
print(f(1, 7, 2.5) / 2)
print(h(1, 7, 3.5))

function g(q, d: f64) {
  const r = if q != null { q } else { d }
  print(r is i32)
  if r is i32 { print(r / 2) }
}
g(5, 1.5)
g(null, 1.5)

function ga<T>(q: T | null, d: f64, n: i32) {
  if n > 0 { gb(q, d, n - 1) }
  const r = if q != null { q } else { d }
  if n == 0 { print(r is i32) }
}
function gb<T>(q: T | null, d: f64, n: i32) { ga(q, d, n) }
const a: i32 | null = 5
const z: i32 | null = null
ga(a, 1.5, 1)
ga(z, 1.5, 0)
