// @run
// @log 0.36666667461395264
// @log 0.699999988079071
// @log -0.36666667461395264
// @log 2.299999952316284
// @log 1.5165750980377197
// @log 0.7666666666666666
// @log 1.15
// A store of a float intrinsic over a literal `let` is an edge, as a copy is (D3387): the operand
// bounds the target from below, and the target's `f32` caps the operand, so both take `f32` where
// each annotated `f32` twin runs. With no `f32` use anywhere both keep `f64`.
function tf32(x: f32) { print(x / 3) }
function h(x: f32) { print(x) }
function tf64(x: f64) { print(x / 3) }
function copied() {
  let x = 0.5
  let y = 0.5
  x = -1.1
  y = abs(x)
  tf32(y)
}
function inTree() {
  let x = 0.5
  let y = 0.5
  x = -1.1
  y = abs(x) + 1.0
  tf32(y)
}
function twoArgs() {
  let x = 0.5
  let y = 0.5
  x = -1.1
  y = min(x, 2.0)
  tf32(y)
}
function self() {
  let a = 0.0
  a = 2.3
  h(a)
  a = sqrt(a)
  h(a)
}
function wide() {
  let x = 0.5
  let y = 0.5
  x = -2.3
  y = abs(x)
  tf64(y)
  print(-x / 2)
}
copied()
inTree()
twoArgs()
self()
wide()
