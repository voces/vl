// @run
// @log 170
// @log 26
// @log 26
// @log 184
// @log -1206248790
// @log 4
// @hint redundant type annotation: `fi32` is inferred as `i32`
// The consumer's spelling: an `i32` written out as four bytes and read back. `as% u8` is the
// operation a binary format needs and `as! u8` cannot be — `v >>> 24` is in 0..255 only for a
// non-negative `v`, so the asserted cast traps on the top byte of any word with the sign bit
// set, which is exactly the word a hash or a flag mask is.
//
// The round trip is the proof: four masked bytes reassembled by shift-and-or give back the
// bit pattern they came from, sign bit included.
function fi32(x: i32): i32 { x }

const bytes: u8[] = []
const v = fi32(0xb81a1aaa as% i32)
bytes.push(v as% u8)
bytes.push((v >>> 8) as% u8)
bytes.push((v >>> 16) as% u8)
bytes.push((v >>> 24) as% u8)
print(bytes[0])
print(bytes[1])
print(bytes[2])
print(bytes[3])

const back = bytes[0] | (bytes[1] << 8) | (bytes[2] << 16) | (bytes[3] << 24)
print(back)
print(bytes.length)
