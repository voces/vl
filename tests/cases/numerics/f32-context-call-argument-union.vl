// @run
// @log 3
// @log true
// @hint redundant type annotation: `g` is inferred as `f32`
// @hint redundant type annotation: `unwrap` is inferred as `f64`
// @hint redundant type annotation: `sameAs` is inferred as `boolean`
// The remaining two positions that seed an f32 context: coercing a value into a
// UNION whose narrowed atom is f32, and the other side of a union `==`.
//
// Both are the same defect as `f32-context-call-argument.vl` — the enclosing f32
// context reached the call's integer-literal argument and lowered it as `f32.const`
// into an `(param i32)` callee — and both emitted an unparseable module on master
// with `vl check` clean.
function g(v: i32): f32 { (v as f32) * 1.5 }

// f32 atom into a value UNION.
const u: f32 | boolean = g(2)
function unwrap(x: f32 | boolean): f64 {
  if x is f32 { x as f64 } else { -1.0 }
}
print(unwrap(u))

// The OTHER side of a union `==` against an f32 atom.
function sameAs(x: f32 | boolean): boolean { x == g(2) }
print(sameAs(u))
