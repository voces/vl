// @run
// @log -1
// @log 268435455
// @log -1
// @log 1
// @log 0
// @log -4294967296
// @log 268435455
// @log -65281
// @log -Infinity
// @log -Infinity
// @log Infinity
// @log 2.220446049250313e-16
// A radix pattern whose top bit is set at its own width reads as a different number at each
// width, so `>>` and `~` over it are computed at the width of their use, as before the
// exact-constant ruling; `>>>`, `&`, `|` and `^` read the same at every width and fold. A float
// zero keeps its sign, and a constant rounds once, at its use.
const a = 0xFFFFFFFF >> 4
const b: i64 = 0xFFFFFFFF >> 4
const c = 0x80000000 >> 31
const d: i64 = 0x80000000 >> 31
const e = ~0xFFFFFFFF
const f: i64 = ~0xFFFFFFFF
const g = 0xFFFFFFFF >>> 4
const h = 0xFFFF0000 | 0xFF
print(a)
print(b)
print(c)
print(d)
print(e)
print(f)
print(g)
print(h)
print(1.0 / (0.0 * -1.0))
const Z = -0.0 - 0.0
print(1.0 / Z)
print(1.0 / (-0.0 + 0.0))
const R = 1.0 + 1.0 / 9007199254740992.0 + 1.0 / 3.0 / 1e70
function less1(x: f64) { x - 1.0 }
print(less1(R))
