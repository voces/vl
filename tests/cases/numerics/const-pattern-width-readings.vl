// @run
// @log -1
// @log 268435455
// @log -1
// @log 1
// @log 0
// @log -4294967296
// @log 268435455
// @log -65281
// @log -Infinity
// @log -Infinity
// @log Infinity
// @log 2.220446049250313e-16
// @log -1073741824
// @log 1073741824
// @log -1
// @log 3
// @log -2147483648
// @log -16
// @log 2147483647
// @log 2147483647
// @log 2147483647
// @log 2147483647
// A radix literal is the bit pattern at its use's width under every operator (owner, 2026-09-30),
// so `>>` and `~` over a pattern whose top bit is set there, arithmetic over any pattern, and a
// shift past 32 bits are computed at that width; `>>>`, `&`, `|` and `^` read the same at every
// width and fold. A float zero keeps its sign, and a constant rounds once, at its use.
const a = 0xFFFFFFFF >> 4
const b: i64 = 0xFFFFFFFF >> 4
const c = 0x80000000 >> 31
const d: i64 = 0x80000000 >> 31
const e = ~0xFFFFFFFF
const f: i64 = ~0xFFFFFFFF
const g = 0xFFFFFFFF >>> 4
const h = 0xFFFF0000 | 0xFF
print(a)
print(b)
print(c)
print(d)
print(e)
print(f)
print(g)
print(h)
print(1.0 / (0.0 * -1.0))
const Z = -0.0 - 0.0
print(1.0 / Z)
print(1.0 / (-0.0 + 0.0))
const R = 1.0 + 1.0 / 9007199254740992.0 + 1.0 / 3.0 / 1e70
function less1(x: f64) { x - 1.0 }
print(less1(R))
const i1 = 0x80000000 / 2
const i2: i64 = 0x80000000 / 2
const i3 = 0xFFFFFFFF % 7
const i4: i64 = 0xFFFFFFFF % 7
const i5 = 0x7FFFFFFF + 1
const i6 = 0xFFFFFFFF << 4
print(i1)
print(i2)
print(i3)
print(i4)
print(i5)
print(i6)
const m1 = (1 << 31) - 0x1
print(m1)
function takes(v: i32) { print(v) }
takes((1 << 31) - 0x1)
function gives() { (3 << 30) + 0x0 }
print(gives() - 1073741825)
function k<T>(x: T): T { x + ((1 << 31) - 0x1) }
const zero = 0
print(k(zero))
