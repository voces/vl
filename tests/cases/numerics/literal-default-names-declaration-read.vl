// @hint redundant type annotation: `r9` is inferred as `i32`
// D2977 (plumb PL-056): the value a mismatch refuses reads an un-annotated literal binding as the
// first argument, as an arithmetic operand, inside a record or list literal, or behind a negation;
// the note names the declaration and the annotation that fixes it. Line and column are 0-based.

function mul32(a: f32, b: f32): f32 { a * b }
function one32(a: f32): f32 { a }
function gi(a: i32): i32 { a }
type V = { v: f32 }

// PL-056's witness: the binding is the FIRST argument.
const x = 0.0
function f(y: f32): f32 { mul32(x, y) }

// Inside a function, `let`, an integer literal.
function g(y: f32): f32 {
  let k = 2
  k = 3
  mul32(k, y)
}

// An operand of an arithmetic operator, returned and passed.
const h = 0.5
function r1(y: f32): f32 { h * y }
function r2(y: f32): f32 { one32(-h * y) }

// An integer operand mixed with an f32.
function r3(y: f32): f32 {
  const n = 3
  n * y
}

// A record field and a list element.
const fv = 1.5
const rec: V = { v: fv }
function r4(y: f32): f32[] {
  const e = 4
  [e, y]
}

// No note: another read wants the literal's own type, in the same function or another.
const both = 3
function r5(): f32 { one32(both) }
function r6(): i32 { gi(both) }
function r7(ys: i32[]): f32 {
  const ix = 1
  print(ys[ix])
  one32(ix)
}

// Scoped per function: the same name read at i32 in another function does not withhold it.
function r8(): f32 {
  const s = 1
  one32(s)
}
function r9(): i32 {
  const s = 1
  gi(s)
}

print(f(1.0))
print(g(1.0))
print(r1(1.0))
print(r2(1.0))
print(r3(1.0))
print(rec.v)
print(r4(1.0)[0])
print(r5())
print(r6())
print(r7([1, 2]))
print(r8())
print(r9())
