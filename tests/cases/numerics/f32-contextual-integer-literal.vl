// @run
// @log 1
// @log 1
// @log 2
// @log 1
// @log 1
// @log 1
// @log -1
// @log 0
// @log 1
// @log 2
// @log false
// @log 2
// @log 1
// @log 1
// @log 1
// @log 1
// @log 16
// @log 1000
// @log 1
// @log 1
// @hint redundant type annotation: `takesF32` is inferred as `f32`
// @hint redundant type annotation: `sum` is inferred as `f32`
// @hint redundant type annotation: `"[]" for V` is inferred as `f32`
// @hint redundant type annotation: `lam` is inferred as `() => f32`
// An INTEGER literal in an f32 CONTEXT (webcraft P2, the integer half of contextual f32
// literals). Sim code is f32-saturated and `let x: f32 = 0` is as common as
// `let x: f32 = 0.5`; on master every one of the positions below was a type error
// ("i32 doesn't fit in f32 — the conversion is lossy and must be made explicit with
// `as`"), because i32→f32 is lossy IN GENERAL: an i32 carries up to 31 significant bits
// and f32's significand holds 24.
//
// But a LITERAL is not a value of unknown magnitude — the compiler can read it. The rule
// is therefore the EXACT-REPRESENTABILITY gate (`intLexemeIsExactF32`), not the
// context-typing the `.`-literal half takes: an integer literal denotes an exact integer,
// so admitting one f32 cannot hold would be precisely the silent lossy conversion VL's
// lossless-only posture exists to forbid. `16777217` still rejects — see
// `f32-integer-literal-inexact-reject.vl` — and both escape hatches remain.
//
// Every f64 spelling of every line below already compiled on master; this file is the f32
// twin reaching parity. The value is what makes it a pin: a literal lowered at the wrong
// width would still have to arrive as the right NUMBER.

// BINDINGS — global and local, const and let.
const a: f32 = 1
print(a)

function localBinding() {
  const l: f32 = 1
  print(l)
}
localBinding()

// RETURN position, and the implicit tail.
function viaReturn(): f32 { return 2 }
print(viaReturn())

function viaTail(): f32 { 1 }
print(viaTail())

// CALL ARGUMENT.
function takesF32(v: f32): f32 { v }
print(takesF32(1))

// STRUCT FIELD init — a `const` global, so the initializer must be a wasm CONSTEXPR.
// The old lowering was `i32.const` + `f32.convert_i32_s`, a two-instruction sequence
// that is not constant: this position failed with "constant expression required".
type S = { v: f32 }
const s: S = { v: 1 }
print(s.v)

// NEGATIVE and ZERO literals.
const neg: f32 = -1
print(neg)
const zero: f32 = 0
print(zero)

// REASSIGNMENT to an f32 cell.
let r: f32 = 0.0
r = 1
print(r)

// BINARY ARITHMETIC with an f32 operand — the literal RETYPES to f32; the mixed-numeric
// lattice underneath (`mixesNumeric` / `widerNumeric`) is untouched, because this pair
// was a hard error before, never an f64 promotion.
const fv: f32 = 1.0
const sum: f32 = fv + 1
print(sum)

// COMPARISON with an f32 operand — its own site, since a comparison yields bool and never
// consults `widerNumeric`. Arithmetic took the literal while comparison rejected it.
const cmp = fv > 1
print(cmp)

// COMPOUND assignment.
let acc: f32 = 1.0
acc += 1
print(acc)

// ARRAY LITERAL element (again a const global, so again a constexpr), element STORE,
// and `push`.
const xs: f32[] = [1]
print(xs[0])

const ys: f32[] = [0.0]
ys[0] = 1
print(ys[0])

const zs: f32[] = []
zs.push(1)
print(zs[0])

// The `"[]="` INDEX OPERATOR (webcraft P1.1): its `v: f32` parameter is a call argument,
// so the grant falls out of the argument position rather than needing its own arm.
type V = { d: f32[] }
function "[]"(self: V, i: i32): f32 { return self.d[i] }
function "[]="(self: V, i: i32, v: f32) { self.d[i] = v }
const vv: V = { d: [0.0] }
vv[0] = 1
print(vv[0])

// RADIX and SEPARATOR lexemes. `0x10` is 16, not 7210 — the encoder folded a
// radix-prefixed lexeme base-10 over its own prefix (see
// `float-literal-radix-constexpr.vl`, which pins the pre-existing f64 half).
const hex: f32 = 0x10
print(hex)
const sep: f32 = 1_000
print(sep)

// A LAMBDA whose contextual return is f32 and whose body is a bare integer literal.
const lam: () => f32 = () => 1
print(lam())

// A NULLABLE f32 — the literal boxes into the union's f32 value box.
const nul: f32 | null = 1
print(nul ?? 0.0)
