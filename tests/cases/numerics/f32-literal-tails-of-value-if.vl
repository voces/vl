// @run
// @log 1.25
// @log 0.75
// @log 0.5
// @log 2.5
// @log 4.5
// @log 0.25
// @log 7.5
// @log 8.5
// @log 9.5
// @log 9
// @log 0.5
// A value `if`, `match` or block whose every tail is a literal f32 holds exactly adopts an f32
// destination as a bare literal does, at every delivery position and beside an f32 operand
// (D2619). The last line is the un-annotated face, which stays f64.
type R = { v: f32 }
let g: f32 = 0
function take(p: f32) { print(p) }
function give(c: boolean): f32 { return if c { 0.5 } else { 2 } }
function f(c: boolean, d: boolean) {
  g = if c { 1.25 } else { 3 }
  print(g)
  take(if c { 0.75 } else { 1 })
  print(give(c))
  const r: R = { v: if c { 2.5 } else { 1 } }
  print(r.v)
  r.v = if c { if d { 4.5 } else { 5 } } else { 6 }
  print(r.v)
  const xs: f32[] = [if c { 0.25 } else { 1 }]
  print(xs[0])
  xs.push(if c { 7.5 } else { 1 })
  print(xs[1])
  let x: f32 = 0
  const set = () => {
    x = if c { 8.5 } else { 1 }
  }
  set()
  print(x)
  const m: {[i32]: f32} = Map()
  m[1] = if c { 9.5 } else { 1 }
  print(m[1] ?? 0)
  x += if c { 0.5 } else { 1 }
  print(x)
  const y = if c { 0.5 } else { 1 }
  print(y)
}
f(true, true)
