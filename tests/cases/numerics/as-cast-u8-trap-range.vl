// @trap
// @hint redundant type annotation: `fi32` is inferred as `i32`
// An `x as! u8` TRAPS when the value is outside 0..255, and the reason NAMES THE DOMAIN THE
// AUTHOR WROTE — `as! u8`, not `as! i32`. That distinction is the whole of D1587's emit
// half: `x as u8` records `i32` on the node because `i32` is what it produces, so the `u8`
// spelling is the only thing left carrying the range, and both the test and this message
// read it.
//
// 300 is a perfectly good `i32` and not a byte, which is the pair no other cast in the
// family has: no float, no width change, and still fallible. Built at runtime through a
// passthrough call so nothing folds it.
function fi32(x: i32): i32 { x }
const big = fi32(300)
print(big as! u8)
print(-1)
