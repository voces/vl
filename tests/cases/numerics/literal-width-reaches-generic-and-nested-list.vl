// @run
// @log 2.5
// @log 2.5
// @log 2.75
// @log 4.5
// @hint redundant type annotation: `fs` is inferred as `f64[]`
// A literal's width is its own checker type at the destination it is delivered into: the `2.5`
// default of a generic `??` stored into an `f32` map and pushed onto an `f32` list (D3418), and
// the `1` of a fresh inner list beside an existing `f64[]` (D4877).
function g<V>(m: Map<string, V>, v: V | null, d: V) { m.set("a", v ?? d) }
const m: Map<string, f32> = Map()
g(m, null, 2.5)
print(m.get("a") ?? 0.0)

function p<V>(xs: V[], v: V | null, d: V) { xs.push(v ?? d) }
const xs: f32[] = []
p(xs, null, 2.5)
print(xs[0])

const fs: f64[] = [2.5]
const v = [[1], fs]
print(v[0][0] / 4.0 + v[1][0])
const w = [fs, [2]]
print(w[1][0] + w[0][0])
