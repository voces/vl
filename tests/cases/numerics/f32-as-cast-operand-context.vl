// @hint redundant type annotation: `g0` is inferred as `f32`
// @hint redundant type annotation: `viaReturn` is inferred as `f32`
// @hint redundant type annotation: `viaTail` is inferred as `f32`
// @hint redundant type annotation: `s` is inferred as `{x: f32}`
// @hint redundant type annotation: `take` is inferred as `i32`
// @hint redundant type annotation: `unann` is inferred as `i32`
// @hint redundant type annotation: `g1` is inferred as `f32`
// @hint redundant type annotation: `g2` is inferred as `f32`
// @hint redundant type annotation: `iv` is inferred as `i32`
// @hint redundant type annotation: `g3` is inferred as `f32`
// @hint redundant type annotation: `c1` is inferred as `f64`
// @hint redundant type annotation: `c2` is inferred as `i64`
// @hint redundant type annotation: `c3` is inferred as `i32`
// @hint redundant type annotation: `c4` is inferred as `f64`
// An `x as T` cast's OPERAND takes the CAST's source width, never the width of the
// position the cast sits in — the same rule a numeric-intrinsic operand obeys
// (`f32-context-numeric-intrinsic-operand.vl`) and a call argument before it
// (`f32-context-call-argument.vl`), stated now for the third operand spine.
//
// `emitAsCast` classifies the source rep and then appends the one conversion opcode, but
// it lowered the operand through the bare `emitExprAs*` helpers — so an enclosing f32
// position's `pendingF32` reached the operand: `const g: f32 = (1.5 as f32)` lowered the
// `1.5` as `f32.const` and then appended `f32.demote_f64` to it. `vl check` clean,
// INVALID WASM, in 12 of 16 measured positions — only the two spellings whose context
// happens NOT to seed `pendingF32` (an un-annotated local) escaped. The operand now
// takes `emitNumIntrArg`, which clears every wide-scalar flag.

// ── an f64-source cast under every f32 context ────────────────────────────────
const g0: f32 = (1.5 as f32)
print(f32bits(g0)) // 1.5f

function viaReturn(): f32 { return (2.5 as f32) }
function viaTail(): f32 { (2.5 as f32) }
print(f32bits(viaReturn()))
print(f32bits(viaTail()))

const xs: f32[] = []
xs.push((3.5 as f32))
print(f32bits(xs[0]))
const ys: f32[] = [0.0]
ys[0] = (3.5 as f32)
print(f32bits(ys[0]))

__store_f32__(0, (4.5 as f32))
print(f32bits(__load_f32__(0)))

type S = { x: f32 }
const s: S = { x: (5.5 as f32) }
print(f32bits(s.x))

function take(x: f32): i32 { f32bits(x) }
print(take((6.5 as f32)))

let m: f32 = 0.0
m = (7.5 as f32)
print(f32bits(m))

// The un-annotated local, the one spelling that already worked — pinned so the fix is
// measured against it rather than around it.
function unann(): i32 {
  const q = (1.5 as f32)
  f32bits(q)
}
print(unann())

// ── the OTHER source reps under the same f32 context ──────────────────────────
const g1: f32 = (7 as f32) // an i32 literal converts
print(f32bits(g1))
const g2: f32 = ((8.5 as f64) as f32) // a nested cast: the inner one is the operand
print(f32bits(g2))
const iv: i32 = 9
const g3: f32 = (iv as f32)
print(f32bits(g3))

// ── CONTROLS: casts whose context is NOT f32 are unchanged ────────────────────
const c0 = (9.5 as i32)
print(c0)
const c1: f64 = (10.5 as f64)
print(c1)
const c2: i64 = (11 as i64)
print(c2)
const fv: f32 = 12.5
const c3: i32 = (fv as i32)
print(c3)
const c4: f64 = (fv as f64)
print(c4)
