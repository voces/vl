// @run
// @log -1077936128
// @log -1071644672
// @log 1069547520
// @log 1073741824
// @log 1065353216
// @log 1069547520
// @log 1077936128
// @log 1073741824
// @log -1073741824
// @log 1073741824
// @log 1077936128
// @log 1073741824
// @log 4618441417868443648
// @log 4609434218613702656
// @log true
// @log true
// @log 6
// @log 6
// @log 8.5
// @log 16.875
// @log 1.5
// @log -2.5
// A float intrinsic resolves at f32 when an operand is f32 and NO operand is a GENUINE
// f64 — the binary operators' own rule, which `emitFloatIntr` reuses through
// `binMixHardF64`. "Genuine" is the part that was wrong: `binMixHardF64` asked
// `exprIsF64` of a whole ARGUMENT and subtracted only a bare parenthesized `NumLit`, so
//   • `-1.0` — a `Unary` OVER the literal — read as a genuine f64, and
//   • `fv + 0.5` — a COMPOUND that is entirely f32 plus a literal — read as one too
//     (the one-argument form asks `binMixHardF64(x, x)` of its single operand).
// Both then took `f64.promote_f32` + the f64 opcode into an f32 slot: `vl check` clean,
// INVALID WASM. Measured over a (9 intrinsics x 8 operand shapes x 15 positions) grid,
// 315 of 1,080 f32 cells; the f64 twin of every one of them was already correct.
//
// The width rule now descends the ARITHMETIC SPINE of the operand (`spineFloatLeafBits`)
// and asks what its LEAVES are, which is the only way a compound operand can be
// classified at all. The controls below pin the three things that must NOT move.

const fv: f32 = 1.5
const fw: f32 = 2.5
const dv: f64 = 4.5

// ── a NEGATED float literal is a literal: it re-encodes at single precision ────
const g0: f32 = copysign(fv, -1.0)
print(f32bits(g0)) // -1.5f
const g1: f32 = min(fv, -2.5)
print(f32bits(g1)) // -2.5f
const g2: f32 = max(-3.5, fv)
print(f32bits(g2)) // 1.5f

// ── a COMPOUND f32 operand stays f32 ──────────────────────────────────────────
const g3: f32 = floor(fv + 0.5)
print(f32bits(g3)) // 2.0f
const g4: f32 = ceil(fv - 0.75)
print(f32bits(g4)) // 1.0f
const g5: f32 = abs(fv * 1.0)
print(f32bits(g5)) // 1.5f
const g6: f32 = trunc(fv * fw)
print(f32bits(g6)) // 3.0f
const g7: f32 = nearest((fv + 0.5))
print(f32bits(g7)) // 2.0f
const g8: f32 = copysign(fv + 0.5, -1.0)
print(f32bits(g8)) // -2.0f
const g9: f32 = min(fv + 0.5, 2.5)
print(f32bits(g9)) // 2.0f

// The same rule reached through the BINARY operators, whose f32 slice shares the
// predicate: an f32 variable times a parenthesized f32-plus-literal.
const ga: f32 = fv * (fv + 0.5)
print(f32bits(ga)) // 3.0f
// And the UN-ANNOTATED chain, where the compound operand is the LEFT side of the outer
// operator (`(fv * 1.0) + 0.5`): the mixed-literal sub-expression must not read as f64.
const gb = fv * 1.0 + 0.5
print(f32bits(gb)) // 2.0f

// ── CONTROL 1: a GENUINE f64 operand still widens the whole operation ──────────
const c0: f64 = floor(fv + dv)
print(f64bits(c0)) // 6.0 -> 6.0
const c1: f64 = copysign(fv, dv)
print(f64bits(c1)) // +1.5 at f64 width
print(min(fv, dv) == 1.5)
print(max(fv * fw, dv) == 4.5)

// ── CONTROL 2: ordinary MIXED arithmetic still promotes ───────────────────────
print(fv + dv)
print(dv + fv)
print((fv + fw) + dv)
print(fv * dv * fw)

// ── CONTROL 3: an ALL-LITERAL float compound has no f32 leaf to adapt to, so it
// stays f64 — there is nothing to adapt to and `emitExprAsF32` has no lowering for
// f64 arithmetic. (`float-opcodes-f32.vl` pins the same two spellings.)
print(abs(0.0 - 1.5) + fv - fv)
print(copysign(fw, 0.0 - 1.0))
