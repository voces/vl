// @run
// @log 16777217
// @log -1
// @log 8589934591
// @log 255
// A radix literal a float does not hold exactly, as the default of a `??` beside a typed float,
// keeps its own type and the join widens (ruling 4.3), as the decimal does; an exact one adopts.
const n: f32 | null = null
print(n ?? 0x1000001)
print(n ?? 0xFFFFFFFF)
print(n ?? 0x1FFFFFFFF)
print(n ?? 0xFF)
