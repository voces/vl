// @check
// @error division by zero in a constant expression
// @error division by zero in a constant expression
// @error division by zero in a constant expression
// @error division by zero in a constant expression
// A constant integer division by zero has no value whether or not the tree holds a radix
// literal: a zero divisor is zero at every width (D2.3).
print(0xFF % 0)
print((0xFF + 0) / 0)
print(7 / (0xFF & 0))
print(7 / (0x100 - 0x100))
