// @run
// @log 3.5
// @log 8
// @log 5.5
// @log 10
// @log 8
// @log 3.5
// @log 10
// @log 5.5
// An un-annotated parameter bound to a nullable union of numbers, read past its `null` test
// directly or through a local it initialises, dispatches at the member it holds, in either
// arm order (D3453).
function use(r) {
  if r != null { print(r + 1) }
}
function acc(r) {
  if r != null {
    let a = r
    a += 3
    print(a)
  }
}
function fi(k: i32, a: f64, b: i32) {
  const j = if k == 0 { a } else if k == 1 { b } else { null }
  use(j)
}
function fa(k: i32, a: f64, b: i32) {
  acc(if k == 0 { a } else if k == 1 { b } else { null })
}
function ii(k: i32, a: i32, b: f64) {
  use(if k == 0 { a } else if k == 1 { b } else { null })
}
function ia(k: i32, a: i32, b: f64) {
  const j = if k == 0 { a } else if k == 1 { b } else { null }
  acc(j)
}
fi(0, 2.5, 7)
fi(1, 2.5, 7)
fi(2, 2.5, 7)
fa(0, 2.5, 7)
fa(1, 2.5, 7)
ii(0, 7, 2.5)
ii(1, 7, 2.5)
ia(0, 7, 2.5)
ia(1, 7, 2.5)
