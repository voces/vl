// @run
// @log 4.5
// @log 10.5
// @log 10.5
// @log 13.5
// @log 7.5
// @log 6
// @log 9
// @log 4.5
// @log 30
// @log 12
// @log 16.5
// @log 1.5
// @log 7.5
// @log 7.5
// A call ARGUMENT is typed by its PARAMETER, never by the enclosing expression.
//
// Every position below sits inside an f32 context — an `f32` global init, an `f32`
// return, an `f32` tail, an `f32` binding, an `f32` parameter of an OUTER call, an
// `f32[]` push, an `f32[]` element assignment — and each one calls a function whose
// parameter is i32 (or i64) with a bare INTEGER LITERAL argument.
//
// Master emitted `f32.const 1 ; call $g` where `$g` is `(param i32)`: an UNPARSEABLE
// module with `vl check` clean, at every one of these positions. The direct-call
// argument spine cleared `pendingI64` per iteration but not `pendingF32`, so the
// enclosing f32 context reached the literal and it lowered at the wrong width.
//
// A VARIABLE argument was unaffected (it carries its own rep), which is why the
// controls at the bottom passed on master too — and f64/i64 contexts never seeded
// the flag at all. The values are what makes this a pin and not a validity check:
// a wrongly-encoded argument would still have to arrive as the right NUMBER.
function g(v: i32): f32 { (v as f32) * 1.5 }

// f32 GLOBAL init (the start-function boundary).
const gr: f32 = g(3)
print(gr as f64)

// f32 `return`, and the implicit f32 TAIL.
function viaReturn(): f32 { return g(7) }
function viaTail(): f32 { g(7) }
print(viaReturn() as f64)
print(viaTail() as f64)

// f32 BINDING inside a function.
function viaLet(): f32 {
  const q: f32 = g(9)
  q
}
print(viaLet() as f64)

// f32 PARAMETER of an OUTER direct call — the seed site is itself a call spine.
function takesF32(x: f32): f64 { x as f64 }
print(takesF32(g(5)))

// f32 list push and f32 element assignment.
const xs: f32[] = []
xs.push(g(4))
print(xs[0] as f64)
const ys: f32[] = [0.0]
ys[0] = g(6)
print(ys[0] as f64)

// The literal reached DEEPER than the argument itself: inside an arithmetic
// expression, a nested call, an array literal and an object literal.
const viaBin: f32 = g(1 + 2)
print(viaBin as f64)
function ten(v: i32): i32 { v * 10 }
const viaNest: f32 = g(ten(2))
print(viaNest as f64)
function firstOf(v: i32[]): f32 { (v[0] as f32) * 1.5 }
const viaArr: f32 = firstOf([8, 2])
print(viaArr as f64)
type Holder = { a: i32 }
function fieldOf(v: Holder): f32 { (v.a as f32) * 1.5 }
const viaObj: f32 = fieldOf({ a: 11 })
print(viaObj as f64)

// An i64 parameter: the f32 leak beat the i64 coercion, so the literal lowered as
// `f32.const` into an `(param i64)` callee.
function wide(v: i64): f32 { 1.5 }
const viaI64: f32 = wide(5000000077)
print(viaI64 as f64)

// Mixed spines, both orders — the f32 parameter must still receive an f32 while its
// i32 neighbour receives an i32.
function mixA(a: i32, b: f32): f32 { (a as f32) * b }
function mixB(a: f32, b: i32): f32 { a * (b as f32) }
print(mixA(3, 2.5) as f64)
print(mixB(2.5, 3) as f64)
