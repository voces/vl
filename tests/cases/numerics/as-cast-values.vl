// @run
// @log 100
// @log 100
// @log 100
// @log 100
// @log null
// @log 9000000000
// @log 100
// @log 9000000000
// @log 3
// @log 3
// @log 3.5
// @log 3.5
// @log -2
// @log 7
// @log 7
// @log 7.9
// @log 2.5
// @log -8
// @hint redundant type annotation: `fi32` is inferred as `i32`
// @hint redundant type annotation: `fi64` is inferred as `i64`
// @hint redundant type annotation: `ff32` is inferred as `f32`
// @hint redundant type annotation: `ff64` is inferred as `f64`
// @hint redundant type annotation: `a` is inferred as `i32`
// @hint redundant type annotation: `big` is inferred as `i64`
// @hint redundant type annotation: `smallBig` is inferred as `i64`
// @hint redundant type annotation: `pf` is inferred as `f32`
// @hint redundant type annotation: `nf` is inferred as `f32`
// @hint redundant type annotation: `pd` is inferred as `f64`
// @hint redundant type annotation: `dd` is inferred as `f64`
// @hint redundant type annotation: `nd` is inferred as `f64`
// Explicit numeric casts `x as T` (B2) — the full 4×4 scalar conversion matrix over
// RUNTIME values (a passthrough call, so the checker cannot fold it to a literal).
// `as` permits EVERY numeric direction, but an INTEGER target is EXACT-OR-FAIL
// (DECISIONS.md §"Numeric `as` to an INTEGER target is exact-or-fail under the trio",
// owner 2026-09-02): it succeeds iff the value is integral AND in range, and otherwise
// fails the way the trio fails everywhere — `as!` traps, `as?` yields `null`, a bare `as`
// propagates the `null` to an enclosing `| null` return.
//
// So the two rows that used to be silently lossy are now SPELLED. `big as? i32` is `null`
// where it once printed the wrapped 410065408, and every float→integer row states its own
// truncation with `trunc` — the operand is then integral by construction, and the emitter
// peepholes the pair back to the single `i32.trunc_f64_s` it always was.
//
// A FLOAT target rounds and cannot fail, so those rows are unchanged.
function fi32(n: i32): i32 { n }
function fi64(n: i64): i64 { n }
function ff32(x: f32): f32 { x }
function ff64(x: f64): f64 { x }

// i32 → {i32 no-op, i64, f32, f64} — every edge lossless, so `as!` cannot fail.
const a: i32 = fi32(100)
print(a as! i32)
print(a as! i64)
print(a as! f32)
print(a as! f64)

// i64 → {i32 out of range, i64 no-op, f32, f64}. `big` exceeds 2^31: under the ruling that
// is a FAILURE rather than a wrap, so `as?` takes it as `null` (`as!` would trap here).
const big: i64 = fi64(9000000000)
print(big as? i32)
print(big as! i64)
const smallBig: i64 = fi64(100)
print(smallBig as! f32)
print(big as! f64)

// f32 → {i32, i64, f32 no-op, f64 promote}, and a negative truncation. The loss is spelled.
const pf: f32 = ff32(3.5)
print(trunc(pf) as! i32)
print(trunc(pf) as! i64)
print(pf as! f32)
print(pf as! f64)
const nf: f32 = ff32(-2.9)
print(trunc(nf) as! i32) // truncation is toward zero: -2, not -3

// f64 → {i32, i64, f64 no-op, f32 DEMOTE}, and a negative truncation.
const pd: f64 = ff64(7.9)
print(trunc(pd) as! i32)
print(trunc(pd) as! i64)
print(pd as! f64)
const dd: f64 = ff64(2.5)
print(dd as! f32)
const nd: f64 = ff64(-8.5)
print(trunc(nd) as! i64) // toward zero: -8
