// @run
// @hint redundant type annotation: `mul32` is inferred as `f32`
// @hint redundant type annotation: `take` is inferred as `f32`
// @hint redundant type annotation: `clampSq` is inferred as `f32`
// @hint redundant type annotation: `chain` is inferred as `f32`
// @hint redundant type annotation: `arms` is inferred as `f32`
// @hint redundant type annotation: `nested` is inferred as `f32`
// @hint redundant type annotation: `field` is inferred as `f32`
// @hint redundant type annotation: `element` is inferred as `f32`
// @hint redundant type annotation: `operand` is inferred as `f32`
// @log 9
// @log 0
// @log 0.5
// @log 1.5
// @log 3
// @log 0.25
// @log 4
// @log -0.5
// @log 7
// @log 0.10000000149011612
// @log 6
// @log 0.75
// @log 2.5
// @log int
// A join whose one arm is an `f32` value and whose other arms are float literals is typed `f32`,
// as `raw * 2.0` is (plumb PL-049, D2775): each literal is an `f32.const`, read at single
// precision. Covers `if`, `else if`, `match`, nesting and negated literals at the binding,
// argument, field, element and operand positions; an integer-literal arm keeps its union.
function mul32(a: f32, b: f32): f32 { a * b }
function take(a: f32): f32 { a }
function clampSq(raw: f32): f32 {
  const clamped = if raw > 0.0 { raw } else { 0.0 }
  mul32(clamped, clamped)
}
function chain(x: f32): f32 {
  let v = if x > 10.0 { 1.5 } else if x > 0.0 { x } else { 0.5 }
  v = take(v)
  v
}
function arms(x: f32, k: i32): f32 {
  const v = match k {
    0 => x
    1 => 0.25
    _ => 4.0
  }
  take(v)
}
function nested(x: f32, k: i32): f32 {
  take(if k > 0 { if x > 0.0 { x } else { -0.5 } } else { 7.0 })
}
function field(x: f32): f32 {
  const s = { v: if x > 0.0 { x } else { 0.1 } }
  take(s.v)
}
function element(x: f32): f32 {
  const a = [if x > 0.0 { x } else { 0.75 }]
  take(a[0])
}
function operand(x: f32): f32 { (if x > 0.0 { x } else { 1.25 }) * 2.0 }
print(clampSq(3.0))
print(clampSq(-3.0))
print(chain(-1.0))
print(chain(20.0))
print(arms(3.0, 0))
print(arms(3.0, 1))
print(arms(3.0, 2))
print(nested(-1.0, 1))
print(nested(-1.0, 0))
print(field(-1.0) as f64)
print(field(6.0))
print(element(-1.0))
print(operand(-1.0))
function intArm(x: f32) {
  const u = if x > 0.0 { x } else { 3 }
  if u is i32 { "int" } else { "f32" }
}
print(intArm(-1.0))
