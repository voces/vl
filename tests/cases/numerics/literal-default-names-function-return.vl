// D3070 (plumb PL-070): a function value refused because its un-annotated return defaulted from
// the numeric literals it returns names the function, the literals' lines and the return
// annotation that fixes it, at every position a function value is delivered to.

function apply(f: (i64) => i64, v: i64): i64 { f(v) }
function applyD(f: (i64) => f64, v: i64): f64 { f(v) }
function applyF(f: (i64) => f32, v: i64): f32 { f(v) }
function apply32(f: (i64) => i32, v: i64): i32 { f(v) }
type H = { f: (i64) => i64 }

// PL-070's witness, at each position: argument, binding, field, list, tail and explicit return,
// assignment.
function never(_x: i64) { -1 }
const r1 = apply(never, 3 as i64)
const g: (i64) => i64 = never
const h: H = { f: never }
const fs: ((i64) => i64)[] = [never]
function pick(): (i64) => i64 { never }
function pick2(): (i64) => i64 { return never }
let q: (i64) => i64 = g
q = never

// A lambda binding, and several literal returns.
const k = (_x: i64) => -1
const r2 = apply(k, 3 as i64)
function two(x: i64) {
  if x > (0 as i64) { return 1 }
  return 2
}
const r3 = applyD(two, 3 as i64)
const blk = (x: i64) => {
  if x > (0 as i64) { return 1.5 }
  0.25
}
const r4 = applyF(blk, 3 as i64)

// Withheld: no `f32` holds 16777217 exactly.
function big(_x: i64) { 16777217 }
const r5 = applyF(big, 3 as i64)

// Withheld: another use needs the `i32` return.
function both(_x: i64) { 7 }
const r6 = apply(both, 3 as i64)
const r7 = apply32(both, 3 as i64)

// Withheld: two destinations want two different annotations.
function split(_x: i64) { 2 }
const r8 = apply(split, 3 as i64)
const r9 = applyD(split, 3 as i64)

// Kept per function: calls whose results still fit an `i64` return.
function used(_x: i64) { 5 }
const r10 = apply(used, 3 as i64)
const r11: i64 = used(1 as i64)
print(used(1 as i64))
