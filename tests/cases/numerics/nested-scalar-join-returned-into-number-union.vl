// @run
// @log true
// @log -1.5
// @log true
// @log false
// D3656: an inner `if` joining a runtime `i32` with an `f64` literal is that `f64`, returned
// into an `i32 | f64` result once, at the tail and at `return`, as at a binding (D3571); the
// outer arm's own `i32` keeps its member.
function mk(q: i32 | null, r: i32 | null): i32 | f64 {
  if q != null {
    q
  } else {
    if r != null { r } else { 2.5 }
  }
}
const x = mk(null, -3)
print(x is f64)
print(x / 2)
function mr(q: i32 | null, r: i32 | null): i32 | f64 {
  return if q != null { q } else { if r != null { r } else { 2.5 } }
}
print(mr(null, -3) is f64)
print(mr(4, 1) is f64)
