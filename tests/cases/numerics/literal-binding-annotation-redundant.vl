// @run
// @log 3000000000
// @log 6000000000
// @log 7
// @log 3000000007
// @hint redundant type annotation: `ecx` is inferred as `i32`
// D3246: an annotation on a literal binding is reported redundant only when its literal already has
// that type and the binding would keep it without the annotation. `rax` would take `i64` from its
// store, so plumb's `let rax: i64 = 0` can be dropped (the un-annotated `rbx` prints the same);
// `edx` would take `i64` from its argument, so its `i32` is load-bearing and not reported; `ecx`
// has no typed use and keeps `i32`.

function big() { 3000000000 }
function take64(x: i64) { x }

let rax: i64 = 0
rax = big()
print(rax)
let rbx = 0
rbx = big()
print(rbx + rax)

let ecx: i32 = 0
ecx = ecx + 7
print(ecx)

const edx: i32 = 7
print(take64(edx) + big())
