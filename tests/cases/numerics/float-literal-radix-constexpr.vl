// @run
// @log 16
// @log 5
// @log 15
// @log 16
// @log 16
// @log 16
// @log 4096
// @hint redundant type annotation: `f` is inferred as `f64`
// A RADIX-PREFIXED integer literal in a FLOAT context. Found while widening the
// contextual-f32-literal grid; the f64 half below is a PRE-EXISTING silent miscompile,
// reproduced on master before the fix.
//
//   const x: f64 = 0x10   printed 7210
//   const x: f64 = 0b101  printed 50101
//
// rc 0, `vl check` clean, no diagnostic. `ieeeBytes` — the shared decimal->IEEE-754
// encoder — folded mantissa digits with a hard-coded `* 10` and `c - '0'`, so it walked
// straight over the `0x` prefix: 0, then `'x' - '0'` = 72, then 721, then 7210.
//
// Only the CONSTEXPR path was wrong. A float context lowers an integer literal directly as
// `f64.const` / `f32.const` so a `const` global initializer stays a valid wasm constant
// expression; the call-ARGUMENT spelling `f(0x10)` converts from i32 instead and was
// always right, which is why this hid. The fix is in the encoder, so both widths and every
// position take it at once.
const a: f64 = 0x10
print(a)
const b: f64 = 0b101
print(b)
const c: f64 = 0o17
print(c)

// The f32 twin — reachable only since the P2 integer-literal grant, and correct from the
// start because the encoder is shared.
const d: f32 = 0x10
print(d)

// The CONTROL that always worked: an argument position converts rather than re-encoding.
function f(v: f64): f64 { v }
print(f(0x10))

// Uppercase prefix and digits, and a separator inside a radix run.
const e: f64 = 0X10
print(e)
const g: f64 = 0x1_000
print(g)
