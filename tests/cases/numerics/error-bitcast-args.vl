// @check
// @error f32bits expects 1 argument, got 2
// @error f64bits expects f64, got string
// @error f32fromBits expects i32, got f64
// @error f64fromBits expects i64, got string
// A bitcast is width-exact in both directions: the argument type IS the source
// pattern's width, so a wrong-width or non-numeric argument is a type error rather
// than a silent conversion. `f32bits(x)` reads 32 bits of float; there is no such
// thing as reinterpreting an f64 through it.
const one: f32 = 1.0
print(f32bits(one, one))
print(f64bits("x"))
print(f32fromBits(1.5))
print(f64fromBits("x"))
