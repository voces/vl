// @run
// @log 6
// @log 44
// @log 2
// @log 6
// @log 6
// @log 44
// @log 1
// @log 3
// @log 300
// @log 44
// @hint redundant type annotation: `fi32` is inferred as `i32`
// `a % b` and `a as% b` cannot be confused, and this is the fixture that says so. The suffix
// is read only directly after the `as` keyword, and `as` itself is read only directly after a
// postfix operand — so a `%` that starts a binary operator always has a left operand and a `%`
// that spells the wrap cast never does.
//
// Precedence is `as!`/`as?`'s, unchanged: the cast binds tighter than every binary operator,
// so `a % b as% i32` is `a % (b as% i32)` and `a as% u8 % b` is `(a as% u8) % b`. Whitespace
// is not part of the token: `a%b`, `a as%u8` and `a as% u8` all lex the way they read.
//
// The last two rows are the collision that has to stay open — `as` is a contextual keyword,
// so a binding may be named `as` and take an ordinary remainder.
function fi32(x: i32): i32 { x }
const a = fi32(300)
const b = fi32(7)

print(a % b)
print(a as% u8)
print(a as% u8 % b)
print(a % b as% i32)
print(a%b)
print(a as%u8)

const as = fi32(7)
print(as % 2)
print(as % 4)
print(a)
print(a as% u8)
