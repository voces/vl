// @run
// @log -2.5
// @log -7
// @log -2.5
// @log -7
// @log 1
// @log -7
// @log neg -2.5
// @log true
// @log 2.5
// @log -7
// @log -2.5
// @log -1
// @log -9000000000
// @log -9000000000
// @log -9000000000
// @log -1
// `-` over a numeric union (`f64 | i32`) negates the member its box holds, and over a two-base
// literal set it computes at `i64`: bound, returned, an argument, a list element, a record field,
// an interpolation hole, a compare operand, a double negation, inside a lambda and a generic.
type D = 9000000000 | 1
function pick(n: i32): D {
  if n > 0 { return 9000000000 }
  return 1
}
function show(x: f64 | i32) { print(x) }
function num(c: boolean): f64 | i32 { return if c { 2.5 } else { 7 } }
function bound(c: boolean) {
  const r = num(c)
  const m = -r
  print(m)
}
function returned(c: boolean): f64 | i32 { return -num(c) }
function arg(c: boolean) { show(-num(c)) }
function element(c: boolean) {
  const xs = [-num(c)]
  print(xs.length)
}
function field(c: boolean) {
  const h = { v: -num(c) }
  print(h.v)
}
function hole(c: boolean) { print("neg \{-num(c)}") }
function less(c: boolean) { print(-num(c) < 0) }
function twice(c: boolean) { print(-(-num(c))) }
function lam(c: boolean) {
  const f = () => -num(c)
  print(f())
}
function gen<T>(x: T) { return -x }
bound(true)
bound(false)
print(returned(true))
arg(false)
element(true)
field(false)
hole(true)
less(false)
twice(true)
lam(false)
print(gen(num(true)))
const lo = pick(0)
const hi = pick(1)
print(-lo)
print(-hi)
const ds = [-lo, -hi]
print(ds[1])
function litRet(n: i32) { return -pick(n) }
print(litRet(1))
print(gen(pick(0)))
