// @run
// @log 3000000000
// @log 5
// @log 1
// @log 3000000000
// @log 1.5
// @log 5
// @log 1
// @hint redundant type annotation: `id` is inferred as `i32`
// @hint redundant type annotation: `x` is inferred as `i64`
// A join whose constant arm does not fit `i32` is `i64` (or `f64`), and a nested join that keeps
// its own `i32`, because one of its arms is typed `i32`, is converted to it whole.
function id(x: i32): i32 { return x }
const v1 = id(5)
const c = id(1) == 1
print(if c { 3000000000 } else { if c { v1 } else { 1 } })
print(if !c { 3000000000 } else { if c { v1 } else { 1 } })
print(if c { if c { 1 } else { v1 } } else { 3000000000 })
const x: i64 = if c { 3000000000 } else { if !c { v1 } else { 1 } }
print(x)
print(if c { 1.5 } else { if !c { v1 } else { 1 } })
print(
  if !c { 3000000000 } else { match 1 {
    1 => v1
    _ => 1
  } },
)
print(if !c { 3000000000 } else { if !c { v1 } else { 1 } })
