// @run
// @log true
// @log false
// @log 3.5
// @log 4
// @log 2.5
// @log 3
// @log false
// @log true
// @log 4
// @log 3.5
// @log true
// @log false
// @log 3
// @log 1.75
// @log 3
// @hint redundant type annotation: `x` is inferred as `f64`
// @hint redundant type annotation: `y` is inferred as `i32`
// @hint redundant type annotation: `n` is inferred as `i32`
// A helper returning a join of its two type parameters, read by a generic, hole or wrapping caller,
// is the union of what the pin binds: `G(k, 2.5, 3)` is `f64 | i32`, so `is`, arithmetic and
// `print` see the member the call returned, not its widening to `f64` (D3589, D3494).
function G<A, B>(k: i32, a: A, b: B) {
  if k == 0 { a } else { b }
}

function R<A, B>(k: i32, a: A, b: B) {
  if k == 0 { return a }
  b
}

function N<A, B>(k: i32, a: A, b: B): A | B {
  if k == 0 { a } else { b }
}

function H(k: i32, a, b) {
  if k == 0 { a } else { b }
}

function isF<A, B>(k: i32, a: A, b: B) {
  const v = G(k, a, b)
  print(v is f64)
}

function plus<A, B>(k: i32, a: A, b: B) {
  const v = R(k, a, b)
  print(v + 1)
}

function show(k: i32, a, b) { print(H(k, a, b)) }

function annotated<A, B>(k: i32, a: A, b: B) {
  const v = N(k, a, b)
  print(v is f64)
}

function wrap<A, B>(k: i32, a: A, b: B) { G(k, a, b) }

const x: f64 = 2.5
const y: i32 = 3
const n: i32 = 7
isF(0, x, y)
isF(1, x, y)
plus(0, x, y)
plus(1, x, y)
show(0, x, y)
show(1, x, y)
annotated(0, y, x)
annotated(1, y, x)
print(wrap(1, x, y) + 1)
print(wrap(0, x, y) + 1)
print(wrap(0, x, y) is f64)
print(wrap(1, x, y) is f64)
print(wrap(0, n, x) / 2)
print(wrap(1, n, 3.5) / 2)
print(wrap(1, x, y))
