// @check
// @error-at 10:14 `as i32` propagates null, which the enclosing function cannot return (it returns i32) — use `as!` to trap instead, or `as?` to take the null here
// @error-at 17:16 `as i32` propagates null, which the enclosing function cannot return (it returns i32) — use `as!` to trap instead, or `as?` to take the null here
// @error-at 23:16 `as i32` propagates string, which the enclosing function cannot return (it returns i32) — use `as!` to trap instead, or `as?` to take the null here
// @error-at 29:16 `as i32` propagates null, which the enclosing function cannot return (it returns i32) — use `as!` to trap instead, or `as?` to take the null here
// @error-at 30:20 cannot assign i32 to 's' of type string
// A refused bare `as i32` still has the type it names, so the `min` around it picks its i32
// overload and `k` stays i32: the propagation refusal is the only error, and no later use
// reports against an f64 fallback. A second, independent mistake still reports.
function pick(u: f64, n: i32): i32 {
  let k = min((u * (n as f64)) as i32, n - 1)
  if k >= 2 { k += 1 }
  return k
}
print(pick(0.5, 4))

function pickAbs(u: f64): i32 {
  const k = abs(u as i32)
  return k
}
print(pickAbs(0.5))

function arm(x: i32 | string): i32 {
  const k = max(x as i32, 3)
  return k
}
print(arm(1))

function alsoWrong(u: f64, n: i32): i32 {
  const k = min(u as i32, n)
  const s: string = k
  print(s)
  return k
}
print(alsoWrong(0.5, 4))
