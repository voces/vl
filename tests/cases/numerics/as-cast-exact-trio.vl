// @run
// @log null
// @log 3
// @log null
// @log 8
// @log null
// @log 4
// @log 3
// @log 3
// @log 4
// @log 4
// @log null
// @log 4294967298
// @log null
// @log null
// @hint redundant type annotation: `ff64` is inferred as `f64`
// @hint redundant type annotation: `fi64` is inferred as `i64`
// @hint redundant type annotation: `frac` is inferred as `f64`
// @hint redundant type annotation: `whole` is inferred as `f64`
// @hint redundant type annotation: `big` is inferred as `i64`
// @hint redundant type annotation: `small` is inferred as `i64`
// @hint redundant type annotation: `z` is inferred as `f64`
// A numeric `as` to an INTEGER target is EXACT-OR-FAIL, and its three spellings are three
// different programs — DECISIONS.md §"Numeric `as` to an INTEGER target is exact-or-fail
// under the trio" (owner, 2026-09-02), built as D1041. Before that the suffix was accepted
// and DROPPED: `3.9 as? i32`, `3.9 as! i32` and a bare `3.9 as i32` all compiled to the same
// `i32.trunc_f64_s` and all printed `3`.
//
// The rule: the cast succeeds iff the value is integral AND in range. `as?` takes the failure
// as `null` (typed `T | null`), `as!` traps with a source-located reason, and a bare `as`
// propagates the `null` — legal only where the enclosing function returns `| null`.
//
// The `as!` TRAP arms live in their own fixtures (`as-cast-trap-nan.vl`,
// `as-cast-trap-oob.vl`, `as-cast-trap-fraction.vl`) because a trap ends the program.
//
// The values come through passthrough calls so nothing here folds to a literal.
function ff64(x: f64): f64 { x }
function fi64(n: i64): i64 { n }

const frac: f64 = ff64(3.9)
const whole: f64 = ff64(8.0)

// `as?` — the failure is a value.
print(frac as? i32)
print(ff64(3.0) as? i32)
print(frac as? i64)
print(whole as? i32)

// A bare `as` PROPAGATES, and the enclosing return type is what makes it legal.
function widen(d: f64): i32 | null {
  const v = d as i32
  v + 1
}
print(widen(3.9))
print(widen(3.0))

// The SPELLED loss: the four integral-by-construction intrinsics. `as!` after one of them
// cannot fail on integrality, so the emitter peepholes the pair to the single trapping
// instruction — `wasm-dis` shows `i32.trunc_f64_s` with no compare chain in front of it.
print(trunc(frac) as! i32)
print(floor(frac) as! i32)
print(ceil(frac) as! i32)
print(nearest(frac) as! i32)

// `i64 → i32` is exact-or-fail too, and never a wrap: `4294967298 as i32` used to print `2`.
const big: i64 = fi64(4294967298)
print(big as? i32)
print(big as! i64)
const small: i64 = fi64(9000000000)
print(small as? i32)

// NaN and ±Inf fail the integrality compare for free — `NaN == trunc(NaN)` is false.
const z: f64 = ff64(0.0)
print((z / z) as? i32)
