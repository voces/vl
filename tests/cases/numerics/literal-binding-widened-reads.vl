// @run
// @log 4999999968
// @log -5000000001
// @log 4999999999
// @log 1.5
// @log true
// @log 3000000000
// D3246: a literal `const` read where a wider operand or destination meets it is its literal at
// that width, the same number its literal's own type gives — plumb's `const y = 32; x - y`
// computes as it always did.

function big64() { 5000000000 }
function halfOf() { 0.5 }
const x = big64()
function take64(v: i64) { v }

const y = 32
print(x - y)

const neg = -1
print(-x + neg)

const one = 1
print(take64(x) - one)

const half = halfOf()
const k = 3
print(half * k)

const lim = 7
print(x > lim)

const big = 3000000000
print(take64(big))
