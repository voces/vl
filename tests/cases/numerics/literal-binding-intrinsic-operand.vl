// @run
// @log 5000000000
// @log false
// @log true
// @log 714285714
// @log 0
// @log 1
// @log 2147483648
// @log true
// @log -2147483648
// An integer intrinsic's operand is an operand, not a delivery: `ltU(a, b)` computes at the width
// its operands give it, so it neither chooses nor vetoes the type of a literal `let` whose store
// is `i64` (PL-078, D3331). A delivery inside the operand still types its binding, and a `let`
// met only as an operand stays `i32`, as it does beside `<`.
function get() { 5000000000 }
function h(x: i64) { x }
function f() {
  let a = 0
  let b = 0
  a = get()
  b = 3
  print(a)
  print(ltU(a, b))
  print(ltU(b, a))
  print(divU(a, 7))
  print(popcnt(a & 255))
  let c = 0
  print(popcnt(h(c) + 1))
  c = 2147483647
  c = c + 1
  print(c)
  let d = 0
  d = 2147483647
  d = d + 1
  print(ltU(a, d))
  print(d)
}
f()
