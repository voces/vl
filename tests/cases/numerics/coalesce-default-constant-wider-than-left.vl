// @run
// @log 1099511627776
// @log 2147483648
// @log 1099511627776
// @log 5
// @log -1
// @log 1099511627776
// An integer constant default the left side's number type cannot hold widens the `??` join,
// as the `if` it spells does (ruling 4.3), whether written as a decimal or a shift (Q8).
const n: i32 | null = null
print(n ?? (1 << 40))
print(n ?? (1 << 31))
const k = 1 << 40
print(n ?? k)
const m: i32 | null = 4
print((m ?? (1 << 40)) + 1)
print(n ?? 0xFFFFFFFF)
function f(x: i32 | null) { return x ?? (1 << 40) }
print(f(null))
