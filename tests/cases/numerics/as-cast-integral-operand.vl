// @run
// @log -3
// @log -2
// @log -3
// @log 2
// @log 4
// @log -3
// @log 2147483647
// @log -2147483648
// @log 9000000000
// @log 255
// @log null
// @log null
// @log null
// @log null
// @log 7
// @log -7
// @log null
// @log null
// @log null
// @log null
// A cast to an integer of `floor`, `ceil`, `trunc` or `nearest`, written directly or through a
// `const` it initialises, tests only the range: the value is integral by construction. NaN and
// the infinities still fail it, as does every value out of the domain, `u8` included. A `let`
// or a shadowed `floor` is not followed. The trap halves are `as-cast-integral-operand-trap-*`.
function ff64(x: f64) { x }
function ff32(x: f32) { x }
function cell(x: f64): i32 | null {
  const fx = floor(x)
  fx as i32
}

const v = ff64(-2.5)
print(floor(v) as! i32)
print(ceil(v) as! i32)
const fv = floor(v)
print(fv as! i32)
print(nearest(ff64(2.5)) as! i32)
const w = ff32(3.5)
const nw = nearest(w)
print(nw as! i32)
print(trunc(ff32(-3.9)) as! i64)

// The edges of the domain are in it.
const top = floor(ff64(2147483647.9))
print(top as! i32)
print(ceil(ff64(-2147483648.9)) as! i32)
print(floor(ff64(9000000000.5)) as! i64)
const byte = floor(ff64(255.7))
print(byte as! u8)

// Just past them, and the values with no integer at all, are a failure.
print(ceil(ff64(2147483647.1)) as? i32)
print(floor(ff64(-0.5)) as? u8)
const nan = floor(ff64(0.0) / ff64(0.0))
print(nan as? i32)
print(floor(ff64(1.0) / ff64(0.0)) as? i64)

// The bare `as` propagates, in range and out.
print(cell(ff64(7.2)))
print(cell(ff64(-6.2)))
print(cell(ff64(3000000000.0)))

// A `let` may be reassigned after its initialiser, so it is tested in full.
let lx = floor(ff64(2.0))
lx = lx + 0.5
print(lx as? i32)

// A local closure named `floor` is not the intrinsic.
function shadowed(x: f64): i32 | null {
  const floor = (y: f64): f64 => y + 0.5
  const fx = floor(x)
  print(floor(x) as? i32)
  fx as i32
}
print(shadowed(ff64(1.0)))
