// @run
// @log 3
// @log true
// @log 1.25
// @log false
// @log 1
// @log false
// @log 0.5
// @log true
// @log -7
// @log -2.5
// @log 10
// @log 5.5
// @log 9000000001
// @log 10
// @log 2
// @log 10
// @log 3.5
// @log 8
// @log 3.5
// Arithmetic over a numeric union computes at each member's own type and yields the union of
// the member results, so `/` is integer division on the `i32` member, `is` holds after the
// operation, an `i64 | f64` stays exact, and a second union operand dispatches over the pairs
// (D3449). Comparisons, unary minus, `+=`, a generic pin and a hole each dispatch the same way.
function f(c: boolean, x: f64, y: i32) {
  const r = if c { x } else { y }
  print(r / 2)
  print((r / 2) is i32)
}
f(false, 2.5, 7)
f(true, 2.5, 7)
function m(c: boolean, x: f64, y: i32) {
  const r = if c { x } else { y }
  print(r % 2)
  print(r < 3)
}
m(false, 2.5, 7)
m(true, 2.5, 7)
function n(c: boolean, x: f64, y: i32) {
  const r = if c { x } else { y }
  print(-r)
}
n(false, 2.5, 7)
n(true, 2.5, 7)
function acc(c: boolean, x: f64, y: i32) {
  let r = if c { x } else { y }
  let i = 0
  while i < 3 {
    r += 1
    i += 1
  }
  print(r)
}
acc(false, 2.5, 7)
acc(true, 2.5, 7)
function wide(c: boolean, x: f64, z: i64) {
  const r = if c { x } else { z }
  print(r + 1)
}
wide(false, 2.5, 9000000000)
function pair(c: boolean, d: boolean, x: f64, y: i32) {
  const r = if c { x } else { y }
  const s = if d { y } else { x }
  print(r + s)
}
pair(false, true, 1.0, 5)
pair(true, false, 1.0, 5)
function gen<T, U>(k: i32, a: T, b: U) {
  const r = if k == 0 { a } else { b }
  print(r + 3)
}
const ga = 7
const gb = 0.5
gen(0, ga, gb)
gen(1, ga, gb)
function hole(k, a, b) {
  const r = if k == 0 { a } else { b }
  print(r + 1)
}
hole(0, ga, gb)
hole(1, ga, 2.5)
