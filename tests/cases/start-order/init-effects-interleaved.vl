// @run
// @log a
// @log after a
// @log b
// @log after b
// @log c
// @log 13
// Initializers with side effects run interleaved with the top-level statements, in source order.
function note(s: string, v: i32) {
  print(s)
  return v
}
const a = note("a", 1)
print("after a")
const b = note("b", a + 1)
print("after b")
let c = note("c", a + b)
c = c + 10
print(c)
