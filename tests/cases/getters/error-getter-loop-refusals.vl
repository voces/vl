// @check
// @error-at 15:2 the getter `dataBound` on R loops over a range whose ends or step are not literals or `const`s, or whose variable is written, and a getter may loop only over a constant range — make it a method: `function dataBound(self: R): i32`, called as `.dataBound()`
// @error-at 20:2 the getter `written` on R loops over a range whose ends or step are not literals or `const`s, or whose variable is written, and a getter may loop only over a constant range — make it a method: `function written(self: R): i32`, called as `.written()`
// @error-at 28:2 the getter `collection` on R loops over a collection with `for … in`, and a getter may loop only over a constant range — make it a method: `function collection(self: R): i32`, called as `.collection()`
// @error-at 31:11 the getter `tooMany` on R costs 17 steps (tooMany), and a getter must cost at most 16 steps — make it a method: `function tooMany(self: R): i32`, called as `.tooMany()`
// @error-at 36:11 the getter `calls` on R costs 18 steps (calls → inc() (18×)), and a getter must cost at most 16 steps — make it a method: `function calls(self: R): i32`, called as `.calls()`
// A getter's loop is refused unless its range is constant and its variable unwritten, and a
// constant one is charged its trips times its body against the budget of 16 (D16065).
type R = new { a: i32 }
const xs = [1, 2, 3]

function inc(x: i32): i32 { x + 1 }

export get dataBound(self: R): i32 {
  let s = 0
  for i in 0 until self.a { s = s + 1 }
  s
}
export get written(self: R): i32 {
  let s = 0
  for i in 0 until 4 {
    i = 3
    s = s + self.a
  }
  s
}
export get collection(self: R): i32 {
  let s = 0
  for x in xs { s = s + x + self.a }
  s
}
export get tooMany(self: R): i32 {
  let s = 0
  for i in 0 until 17 { s = s + self.a }
  s
}
export get calls(self: R): i32 {
  let s = 0
  for i in 0 until 9 { s = s + inc(self.a) + inc(i) }
  s
}
