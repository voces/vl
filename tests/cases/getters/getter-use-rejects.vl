// @check
// @error-at 27:4 the getter `x` on V can never be read: `V` already has a member `x`,
// @error-at 29:4 the getter `onStruct` on P needs a nominal receiver: `P` is a
// @error-at 34:46 `?.doubled` reads the getter `doubled` on V, and `?.` reads only a
// @error-at 37:2 cannot assign to `.doubled`: it reads the getter `doubled` on V, and
// @error-at 38:2 cannot assign to `.doubled`: it reads the getter `doubled` on V, and
// @error-at 40:6 W does not satisfy `{x:f32}`: `x` on W is a getter, and a getter does not satisfy a bound yet — take a `W` parameter instead, or declare `x` as a method, `function x(self: W): f32`, and bound on `{ x(): f32 }`
// @error-at 41:14 argument 1: expected {x: _}, got W — `x` on W is a getter, and the parameter's inferred type is a record with a field `x`, which a getter does not satisfy; annotate the parameter as `W`
// @error-at 44:29 member access '.z' on non-object Q | null — `.q2` is a getter, and a null test does not narrow a getter read; bind it to a local first: `const q2 = n.q2`, then test `q2 != null`
// @error-at 46:6 `.doubled` reads the getter `doubled` on V; drop the `()`
// @error-at 50:4 the getter `push` on L shares its name with the built-in method
// @error-at 52:4 the getter `d2` on V shares its name with the method `d2(self: V)`,
// @error-at 55:4 the getter `val` on Box<i32> needs a nominal receiver, and an
// What a getter is NOT (property-access-design.md §C, §D3a): it is read-only, so a write
// through it is refused naming the getter; it is nominal-only, so it is never part of a
// structural type — a getter on a `{ … }` receiver is refused at its declaration, and a value
// whose `x` is a getter satisfies neither a `{ x: f32 }` bound nor an un-annotated parameter
// that reads `.x`; a field always wins, so a getter shadowed by one is refused; and a getter
// read is a call result, never a narrowing place, so a null test on it narrows nothing; and
// `?.` reads only a declared struct field, so a getter is refused through it by name.
type V = new { a: i32, x: f32 }
type W = new i32
type P = { a: i32 }
type Q = { z: i32 }
type N = new { q: Q | null }

get doubled(self: V): i32 { self.a * 2 }
get x(self: V): f32 { 2.0 }
get x(self: W): f32 { 1.0 }
get onStruct(self: P): i32 { self.a }
get q2(self: N): Q | null { self.q }

function viaBound<T: { x: f32 }>(t: T): f32 { return t.x }
function viaHole(p) { return p.x }
function viaOpt(o: V | null): i32 { return o?.doubled ?? 0 }

const v: V = { a: 1, x: 3.0 }
v.doubled = 5
v.doubled += 1
const w = 3 as! W
print(viaBound(w))
print(viaHole(w))
print(viaOpt(v))
const n: N = { q: { z: 4 } }
if n.q2 != null { print(n.q2.z) }
print(v.x)
print(v.doubled())
// A getter may not share its name with a method of the same receiver: a built-in one of the
// representation, or a `self`-function of the same module, would make `v.d` and `v.d()` differ.
type L = new i32[]
get push(self: L): i32 { 1 }
function d2(self: V): i32 { return self.a }
get d2(self: V): i32 { self.a * 2 }
// An instance of a generic `new` type is not branded yet (D2031), so it cannot carry a getter.
type Box<T> = new { v: T, n: i32 }
get val(self: Box<i32>): i32 { self.v + 1 }
