// @run
// @log 18
// @log 52
// @log 86
// @log 25
// @log 50
// @log 3
// @log 1
// @log -1
// @log 110
// @log true
// @log 25
// @log 6
// @log 7
// A getter `get p(self: T): R` is a read-only property of a nominal type: `v.p` reads it
// with no parentheses (property-access-design.md §D3a). Both nominal shapes are here — a
// brand over a scalar, which has no fields at all, and a brand over a struct, whose fields
// stay readable beside its getters. `get` is a keyword only at the head of a declaration.
type Color = new i32
type V = new { x: f32, y: f32 }

const K = 100

get r(self: Color): i32 { ((self as! i32) >> 16) & 255 }
get g(self: Color): i32 { ((self as! i32) >> 8) & 255 }
get b(self: Color): i32 { (self as! i32) & 255 }
get len2(self: V): f32 { self.x * self.x + self.y * self.y }
// A getter may read another getter, a module `const` and its own locals, and may branch.
get twice(self: V): f32 {
  const l = self.len2
  l * 2.0
}
get sign(self: Color): i32 {
  if (self as! i32) > 0 { 1 } else { -1 }
}
get shifted(self: Color): i32 { self.r / 2 + K + 1 }

function redOf(c: Color) { return c.r }

const c = 0x123456 as! Color
print(redOf(c))
print(c.g)
print(c.b)
const v: V = { x: 3.0, y: 4.0 }
print(v.len2)
print(v.twice)
print(v.x)
print(c.sign)
print(((0 - 5) as! Color).sign)
print(c.shifted)
print(v.len2 > 24.0)

// A getter read in an argument, a struct field and a return position.
const p = { a: v.len2, n: c.b - 80 }
print(p.a)
print(p.n)

// `get` stays an ordinary identifier, and a map's `get` method is untouched.
const get = 7
const m: {[string]: i32} = Map()
m.set("k", get)
print(m.get("k") ?? 0)
