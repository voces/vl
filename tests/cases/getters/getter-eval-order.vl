// @run
// @log 7
// @log 7
// A getter read keeps SOURCE order inside an object literal (D1510): `bump()` stores 7 before the
// getter loads the same address, although `p` comes first in `R`'s layout, so `p` reads 7 and not
// the 0 that was there before the store. The read is lowered as a call before the emitter runs,
// so the emitter orders it as the call it is.
import { Buffer } from "std:buffer"

type Cell = new i32
get value(self: Cell): i32 { __load_i32__(self as! i32) }

const buf = Buffer(16)
const cell = buf.base as! Cell

function bump() {
  __store_i32__(buf.base, 7)
  return 1
}

type R = { p: i32, q: i32 }
const r: R = { q: bump(), p: cell.value }
print(r.p)
print(cell.value)
