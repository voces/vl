// @check
// @error-at 17:31 the getter `full` on Name concatenates strings, and a getter must not allocate — make it a method: `function full(self: Name): string`, called as `.full()`
// @error-at 18:26 the getter `positive` on Cell returns `i32 | null`, which is allocated, and a getter must not allocate — return a type without `| null`, or make it a method: `function positive(self: Cell): i32 | null`, called as `.positive()`
// @error-at 21:23 the getter `s3` on V calls `sq`, and a getter may call only other getters and the load and SIMD intrinsics — make it a method: `function s3(self: V): f32`, called as `.s3()`
// @error-at 28:6 Color does not satisfy `{r():i32}`: `r` on Color is a getter, and a getter does not satisfy a bound yet — take a `Color` parameter instead, or declare `r` as a method, `function r(self: Color): i32`, which satisfies it
// @error-at 29:6 Color does not satisfy `{r:i32}`: `r` on Color is a getter, and a getter does not satisfy a bound yet — take a `Color` parameter instead, or declare `r` as a method, `function r(self: Color): i32`, and bound on `{ r(): i32 }`
// One mistake in a getter is one error (D2067): a `+` chain is refused once, at its outermost
// `+`; a boxed result is refused once, at the result type; a callee called three times is
// refused once. Every refusal says the rule and offers the getter as a method. A getter never
// satisfies a bound (D2066), and the refusal says so and names the method that would.
type Name = new { first: string, last: string }
type Cell = new { v: i32 }
type V = new { x: f32 }
type Color = new i32

function sq(a: f32) { return a * a }

get full(self: Name): string { self.first + " " + self.last }
get positive(self: Cell): i32 | null {
  if self.v > 0 { self.v } else { null }
}
get s3(self: V): f32 { sq(self.x) + sq(self.x) + sq(self.x) }
get r(self: Color): i32 { ((self as! i32) >> 16) & 255 }

function redM<T: { r(): i32 }>(t: T) { return t.r() }
function redF<T: { r: i32 }>(t: T) { return t.r }

const c = 0x123456 as! Color
print(redM(c))
print(redF(c))
