// The v1 getter-body contract (property-access-design.md §D3a-contract), one refusal per
// rule. A getter body is loop-free, recursion-free, allocation-free and effect-free, and
// calls only intrinsics and other getters; each refusal names the getter, anchors at the
// construct, says the rule and offers the getter as a method. The type rule (F9) refuses a
// boxed value — a value union or a nullable scalar — as a local or a result.
extern function hostVal(a: i32): i32

type V = new { a: i32, s: string }
type P = { a: i32, b: i32 }

let counter = 0
function helper(a: i32): i32 { return a + 1 }
function "+"(self: V, o: V): i32 { return self.a + o.a }

get loops(self: V): i32 {
  let s = 0
  while s < 3 { s = s + 1 }
  s
}
get selfRec(self: V): i32 { self.selfRec + 1 }
get ping(self: V): i32 { self.pong + 1 }
get pong(self: V): i32 { self.ping + 1 }
get makesStruct(self: V): i32 {
  const p: P = { a: 1, b: 2 }
  p.a
}
get makesList(self: V): i32 { [self.a, 2][0] }
get interpolates(self: V): string { "a=\{self.a}" }
get concats(self: V): string { self.s + "!" }
get boxedLocal(self: V): i32 {
  const u: i32 | string = self.a
  7
}
get boxedResult(self: V): i32 | null { self.a }
get callsHost(self: V): i32 { hostVal(self.a) }
get readsLet(self: V): i32 { self.a + counter }
get callsUser(self: V): i32 { helper(self.a) }
get callsOperator(self: V): i32 { self + self }
get stores(self: V): i32 {
  __store_i32__(0, 1)
  self.a
}
get callsMethod(self: V): string { self.s.slice(0, 1) }
get makesClosure(self: V): i32 {
  const f = (n: i32) => n + 1
  self.a
}
get writesField(self: V): i32 {
  self.a = 2
  self.a
}
// A block's local ends with the block: the module `let` of the same name is what the later
// read and write reach.
get shadowRead(self: V): i32 {
  if self.a > 100 {
    const counter = 1
    counter
  } else {
    0
  }
  counter + self.a
}
get shadowWrite(self: V): i32 {
  const x = if self.a > 100 {
    let counter = 1
    counter = 5
    counter
  } else {
    0
