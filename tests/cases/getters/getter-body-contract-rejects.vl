}
// A binding spelled like an intrinsic is not one.
const __load_fake__ = (a: i32): i32 => a + 1
get fakeIntrinsic(self: V): i32 { __load_fake__(self.a) }
// Operators whose lowering loops or allocates.
type W = new { s: string, t: string, xs: i32[], ys: i32[], m: {[string]: i32} }
type W2 = new { p: P, q: P }
get stringEq(self: W): boolean { self.s == self.t }
get stringLt(self: W): boolean { self.s < "m" }
get listEq(self: W): boolean { self.xs == self.ys }
get structEq(self: W2): boolean { self.p == self.q }
get mapRead(self: W): i32 { self.m["k"] ?? 0 }
get listConcat(self: W): i32 { (self.xs + self.ys).length }
