// @run
// @log 1
// @log 0.25
// @log 6
// @log true
// @log false
// @log 5
// @log 7
// @log 3
// @log 42
// @log true
// @log 9
// @log 3
// @hint redundant type annotation: `clamp01` is inferred as `f64`
// @hint redundant type annotation: `twice` is inferred as `i32`
// @hint redundant type annotation: `same` is inferred as `boolean`
// @hint redundant type annotation: `+` is inferred as `i32`
// @hint redundant type annotation: `inc` is inferred as `i32`
// @hint redundant type annotation: `inc2` is inferred as `i32`
// @hint redundant type annotation: `capped` is inferred as `i32`
// @hint redundant type annotation: `isAb` is inferred as `boolean`
// @hint redundant type annotation: `tab` is inferred as `i32`
// A getter may call an ordinary function whose summary writes nothing, allocates nothing, calls
// no host function and has a step bound within the getter's budget (D2136): a plain helper, one
// called by UFCS, a generic one pinned at a type whose `==` is one instruction, a std function, a
// user operator, a chain of helpers, an un-annotated helper, a helper reading a module `const`,
// a string-literal compare priced inside the helper, and a helper reading a module `const`
// table. Each call costs 1 plus the callee.
import { hypotF64 } from "std:math"

type V = new { x: f64, n: i32, s: string }
type P = new { a: i32 }

const LIMIT = 40
const TABLE = [3, 4]

function clamp01(x: f64): f64 {
  if x < 0.0 { 0.0 }
  else if x > 1.0 { 1.0 }
  else { x }
}
function twice(self: V): i32 { self.n * 2 }
function same<T>(a: T, b: T): boolean { a == b }
function "+"(self: P, o: P): i32 { self.a + o.a }
function inc(n: i32): i32 { n + 1 }
function inc2(n: i32): i32 { inc(inc(n)) }
function plusTwo(n: i32) { n + 2 }
function capped(n: i32): i32 {
  if n > LIMIT { LIMIT } else { n + 39 }
}
function isAb(s: string): boolean { s == "ab" }
function tab(i: i32): i32 { TABLE[i] }

get clamped(self: V): f64 { clamp01(self.x) }
get quarter(self: V): f64 { clamp01(self.x / 8.0) }
get doubled(self: V): i32 { self.twice() }
get isThree(self: V): boolean { same(self.n, 3) }
get isFour(self: V): boolean { same(self.n, 4) }
get hyp(self: V): f64 { hypotF64(self.x + 1.0, 4.0) }
get sum(self: P): i32 { self + self }
get bumped(self: V): i32 { inc2(self.n) + inc(0) - 1 }
get lifted(self: V): i32 { capped(self.n) }
get ab(self: V): boolean { isAb(self.s) }
get nine(self: V): i32 { plusTwo(self.n) + 4 }
get tabbed(self: V): i32 { tab(self.n - 3) }

const v: V = { x: 2.0, n: 3, s: "ab" }
const p: P = { a: 3 }
print(v.clamped)
print(v.quarter)
print(v.doubled)
print(v.isThree)
print(v.isFour)
print(v.hyp)
print(v.bumped + 2)
print(p.sum / 2)
print(v.lifted)
print(v.ab)
print(v.nine)
print(v.tabbed)
