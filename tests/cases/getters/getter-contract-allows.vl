// @run
// @log true
// @log false
// @log 3
// @log true
// @log 1.25
// @log 101
// @log 5
// @log 111
// @log 1
// @log 1
// @log 1
// What the getter-body contract admits beside the plain field and scalar reads: a literal-union
// comparison (a tag compare), a `match` over one, a null test on a nullable reference, a float
// `%` (bounded by the float format, not the operands), a string's length and byte index, and a
// block-local that shadows a module `let` inside its own block only, and an `if` whose value
// is discarded (a guard that traps, or a local write), whose type the contract never reads.
type Mode = "alpha" | "beta" | "gamma"
type Q = { z: i32 }
type V = new { mode: Mode, q: Q | null, f: f64, s: string, n: i32 }

let counter = 0

get isGamma(self: V): boolean { self.mode == "gamma" }
get hasQ(self: V): boolean { self.q != null }
get rank(self: V): i32 {
  match self.mode {
    "alpha" => 1
    "beta" => 2
    "gamma" => 3
  }
}
get sameMode(self: V): boolean { self.mode == self.mode }
get frac(self: V): f64 { self.f % 1.5 }
get shadow(self: V): i32 {
  if self.n > 0 {
    let counter = 100
    counter = counter + self.n
    return counter
  }
  0
}
get byte0(self: V): i32 { self.s[0] - self.s.length + 10 }

const v: V = { mode: "gamma", q: null, f: 7.25, s: "hey", n: 1 }
print(v.isGamma)
print(v.hasQ)
print(v.rank)
print(v.sameMode)
print(v.frac)
print(v.shadow)
counter = counter + 5
print(counter)
print(v.byte0)
type R = new i32
get guarded(self: R): i32 {
  if (self as! i32) < 0 { __trap__() }
  1
}
get written(self: R): i32 {
  let x = 0
  if (self as! i32) > 0 { x = 1 }
  x
}
get early(self: R): i32 {
  if (self as! i32) < 0 { return 0 }
  1
}
const r = 64 as! R
print(r.guarded)
print(r.written)
print(r.early)
