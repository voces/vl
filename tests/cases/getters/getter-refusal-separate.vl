// @check
// @error-at 11:2 the getter `loops` on N contains a loop, and a getter must not loop — make it a method: `function loops(self: N): i32`, called as `.loops()`
// @error-at 13:2 the getter `loops` on N contains a loop, and a getter must not loop — make it a method: `function loops(self: N): i32`, called as `.loops()`
// @error-at 17:12 the getter `concats` on N concatenates strings, and a getter must not allocate — make it a method: `function concats(self: N): i32`, called as `.concats()`
// @error-at 18:12 the getter `concats` on N concatenates strings, and a getter must not allocate — make it a method: `function concats(self: N): i32`, called as `.concats()`
// Two separate violations of one rule in one getter are two errors: each loop and each
// concatenation reports at its own span. Only a nested `+` chain collapses to one error.
type N = new { a: string, b: string, n: i32 }

get loops(self: N): i32 {
  let s = 0
  while s < self.n { s = s + 1 }
  let t = 0
  while t < 3 { t = t + 1 }
  s + t
}
get concats(self: N): i32 {
  const x = self.a + "!"
  const y = self.b + "?" + self.a
  x.length + y.length
}
