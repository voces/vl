type P = new { a: i32 }
type V = new { n: i32, s: string, xs: i32[], p: P }

let count = 0

function same<T>(a: T, b: T): boolean { a == b }
function bump(n: i32): i32 { count = count + 1; return n }
function viaBump(n: i32): i32 { bump(n) + 1 }
function says(n: i32): i32 { print(n); return n }
function allocOne(n: i32): i32 {
  if n > 0 { [n, 2][0] } else { n }
}
function loops(n: i32): i32 {
  let i = 0
  while i < n { i = i + 1 }
  return i
}
function fact(n: i32): i32 {
  if n <= 1 { 1 } else { n * fact(n - 1) }
}
function isEven(n: i32): boolean {
  if n == 0 { true } else { isOdd(n - 1) }
}
function isOdd(n: i32): boolean {
  if n == 0 { false } else { isEven(n - 1) }
}
function pushes(xs: i32[]): i32 { xs.push(1); return 0 }
function applies(n: i32, f: (i32) => i32): i32 { f(n) }
function label(self: V): string { self.s + "!" }
function f0(n: i32): i32 { n + 1 }
function f1(n: i32): i32 { f0(n) + f0(n) + f0(n) }
function f2(n: i32): i32 { f1(n) + f1(n) }
function "+"(self: P, o: P): P {
  count = count + 1
  self
}
function addG<T>(a: T, b: T): T { a + b }
function readCount(): i32 { count }
function viaLit(v: V): i32 {
  const w = { xs: v.xs }
  w.xs[0] = 5
  0
}

get g1(self: V): boolean { same(self.s, "x") }
get g2(self: V): i32 { viaBump(self.n) }
get g3(self: V): i32 { says(self.n) }
get g4(self: V): i32 { applies(self.n, (k: i32) => k) }
get g5(self: V): i32 { allocOne(self.n) }
get g6(self: V): i32 { loops(self.n) }
get g7(self: V): i32 { fact(self.n) }
get g8(self: V): boolean { isEven(self.n) }
get g9(self: V): i32 { pushes(self.xs) }
get g10(self: V): string { self.label() }
get g11(self: V): i32 { f2(self.n) + f2(self.n) + f2(self.n) }
get g12(self: V): string { addG(self.s, "y") }
get g13(self: V): i32 { addG(self.p, self.p).a }
get g14(self: V): i32 { readCount() }
get g15(self: V): i32 { viaLit(self) }

const v: V = { n: 3, s: "ab", xs: [], p: { a: 1 } }
print(v.g1)
print(v.g2)
