// @run
// @log 2.5
// @log 7
// @log 9.5
// @log 4.5
// @log 4
// @log 11
// Named lanes as getters over a `new v128` brand — the shape `std:simd` will give `F32x4`
// (property-access-design.md §E3). Each getter is one `f32x4.extract_lane`, and at `-O` a
// read `v.y` compiles to the same module as a call `y(v)`. A getter is found through the
// receiver's type and never by name, so this module's own `function x` and `const y` cannot
// shadow `.x` or `.y` — the collision D1984 describes for type-bound methods.
type F4 = new v128

get x(self: F4): f32 { __extract_lane_f32x4__(self as! v128, 0) }
get y(self: F4): f32 { __extract_lane_f32x4__(self as! v128, 1) }
get z(self: F4): f32 { __extract_lane_f32x4__(self as! v128, 2) }
get w(self: F4): f32 { __extract_lane_f32x4__(self as! v128, 3) }

function x(self: i32) { return self + 1 }
const y = 11

function lanes(a: f32, b: f32, c: f32, d: f32): F4 {
  const v0 = __splat_f32x4__(a)
  const v1 = __replace_lane_f32x4__(v0, 1, b)
  const v2 = __replace_lane_f32x4__(v1, 2, c)
  return __replace_lane_f32x4__(v2, 3, d) as F4
}

const v = lanes(2.5, 7.0, 1.5, 3.0)
print(v.x)
print(v.y)
print(v.x + v.y)
print(v.z * v.w)
print(3.x())
print(y)
