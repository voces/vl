type V = new { a: i32, f: f64 }
type R = new v128

function sqrt(x: f64) { return x }

get userSqrt(self: V): f64 { sqrt(self.f) }
get storeV128(self: R): i32 {
  __store_v128__(0, self as! v128)
  1
}
get storeI64(self: V): i32 {
  __store_i64__(0, 1 as i64)
