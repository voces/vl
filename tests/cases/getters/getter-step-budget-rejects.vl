// @check
// @error-at 27:4 the getter `a8` on C costs 87380 steps (a8 → a7 (4×) → a6 (4×) → a5 (4×) → a4 (4×) → a3 (4×) → a2 (4×) → a1 (4×) → a0 (4×)), and a getter must cost at most 16 steps — make it a method: `function a8(self: C): i32`, called as `.a8()`
// @error-at 33:4 the getter `dearArm` on C costs 17 steps (dearArm → h15 → h4 (3×) → h0 (4×)), and a getter must cost at most 16 steps — make it a method: `function dearArm(self: C): i32`, called as `.dearArm()`
// @error-at 39:4 the getter `long` on N costs 17 steps (long → a compare with a 17-character string literal), and a getter must cost at most 16 steps — make it a method: `function long(self: N): boolean`, called as `.long()`
// @error-at 40:4 the getter `longIs` on N costs 17 steps (longIs → 2 string-literal compares totalling 17 characters), and a getter must cost at most 16 steps — make it a method: `function longIs(self: N): boolean`, called as `.longIs()`
// @error-at 41:32 the getter `runtime` on N compares `string` values with `==`, which loops over their contents, and a getter must not loop — make it a method: `function runtime(self: N): boolean`, called as `.runtime()`
// @error-at 43:33 the getter `viaConst` on N compares `string` values with `==`, which loops over their contents, and a getter must not loop — make it a method: `function viaConst(self: N): boolean`, called as `.viaConst()`
// @error-at 48:27 the getter `remF64` on R takes a float remainder with `%`, which loops as many times as the operands' exponents differ, and a getter must not loop — make it a method: `function remF64(self: R): f64`, called as `.remF64()`
// @error-at 49:27 the getter `remF32` on F takes a float remainder with `%`, which loops as many times as the operands' exponents differ, and a getter must not loop — make it a method: `function remF32(self: F): f32`, called as `.remF32()`
// @error-at 66:4 the getter `uEq` on U costs 31 steps (uEq → a compare with a 31-character string literal), and a getter must cost at most 16 steps — make it a method: `function uEq(self: U): boolean`, called as `.uEq()`
// @error-at 67:4 the getter `uIs` on U costs 31 steps (uIs → a compare with a 31-character string literal), and a getter must cost at most 16 steps — make it a method: `function uIs(self: U): boolean`, called as `.uIs()`
// @error-at 68:30 the getter `uSame` on U compares `"c" | "rectangle-with-a-very-long-name"` values with `==`, which loops over their contents, and a getter must not loop — make it a method: `function uSame(self: U): boolean`, called as `.uSame()`
// @error-at 69:4 the getter `uMatch` on U costs 31 steps (uMatch → a compare with a 31-character string literal), and a getter must cost at most 16 steps — make it a method: `function uMatch(self: U): i32`, called as `.uMatch()`
// @error-at 83:4 the getter `t` on A costs 18 steps (t → A.v (2×) → w (8×)), and a getter must cost at most 16 steps — make it a method: `function t(self: A): i32`, called as `.t()`
// The getter step budget (D2061, D2062, D2063): a getter read costs 1 plus the read getter's
// cost, a compare with a string literal its length, a branch its dearest arm, and a chain over
// the budget is one error at its top, naming the path. Comparing two runtime strings and a
// float `%` loop over their operands, and are refused outright.
type C = new i32
get a0(self: C): i32 { (self as! i32) & 1 }
get a1(self: C): i32 { self.a0 + self.a0 + self.a0 + self.a0 }
get a2(self: C): i32 { self.a1 + self.a1 + self.a1 + self.a1 }
get a3(self: C): i32 { self.a2 + self.a2 + self.a2 + self.a2 }
get a4(self: C): i32 { self.a3 + self.a3 + self.a3 + self.a3 }
get a5(self: C): i32 { self.a4 + self.a4 + self.a4 + self.a4 }
get a6(self: C): i32 { self.a5 + self.a5 + self.a5 + self.a5 }
get a7(self: C): i32 { self.a6 + self.a6 + self.a6 + self.a6 }
get a8(self: C): i32 { self.a7 + self.a7 + self.a7 + self.a7 }

// `h15` costs 15 steps, so one read of it costs 16; the dearer arm decides.
get h0(self: C): i32 { (self as! i32) + 1 }
get h4(self: C): i32 { self.h0 + self.h0 + self.h0 + self.h0 }
get h15(self: C): i32 { self.h4 + self.h4 + self.h4 }
get dearArm(self: C): i32 {
  if (self as! i32) > 0 { self.h15 + self.h0 } else { 0 }
}

type N = new { name: string, other: string }
const K = "zz"
get long(self: N): boolean { self.name == "abcdefghijklmnopq" }
get longIs(self: N): boolean { self.name is "abcdefgh" | "ijklmnopq" }
get runtime(self: N): boolean { self.name == self.other }
// An un-annotated `const` widens to `string`, so it compares as a runtime string (D2120).
get viaConst(self: N): boolean { self.name == K }

type R = new f64
type F = new f32
type I = new i32
get remF64(self: R): f64 { (self as! f64) % 1.5 }
get remF32(self: F): f32 { (self as! f32) % 1.5 }
get remI32(self: I): i32 { (self as! i32) % 7 }

const c = 3 as! C
print(c.a8 + c.dearArm)
const n: N = { name: "z", other: "y" }
print(n.long || n.longIs || n.runtime || n.viaConst)
print((3.0 as! R).remF64 + 1.0)
print((3.0 as! F).remF32 + 1.0)
print((9 as! I).remI32)

// An undeclared literal union is stored as a string, so its compares call `__str_eq__`: a
// literal costs its length, and two such values compare as runtime strings.
type U = new {
  kind: "c" | "rectangle-with-a-very-long-name",
  other: "c" | "rectangle-with-a-very-long-name",
}
get uEq(self: U): boolean { self.kind == "rectangle-with-a-very-long-name" }
get uIs(self: U): boolean { self.kind is "rectangle-with-a-very-long-name" }
get uSame(self: U): boolean { self.kind == self.other }
get uMatch(self: U): i32 {
  match self.kind {
    "rectangle-with-a-very-long-name" => 2
    "c" => 1
  }
}
// The same getter name on two receivers is qualified in the path.
type A = new i32
type B = new i32
get w(self: A): i32 { (self as! i32) + 1 }
get v(self: A): i32 {
  self.w + self.w + self.w + self.w + self.w + self.w + self.w + self.w
}
get v(self: B): i32 { (self as! i32) }
get t(self: A): i32 { self.v + self.v }
const u: U = { kind: "c", other: "c" }
print(u.uEq || u.uIs || u.uSame)
print(u.uMatch + (3 as! A).t + (3 as! B).v)
