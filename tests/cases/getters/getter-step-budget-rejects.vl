// @check
// @error-at 22:4 the getter `a8` on C costs 87380 steps (a8 → a7 (4×) → a6 (4×) → a5 (4×) → a4 (4×) → a3 (4×) → a2 (4×) → a1 (4×) → a0 (4×)), and a getter must cost at most 16 steps — make it a method: `function a8(self: C): i32`, called as `.a8()`
// @error-at 28:4 the getter `dearArm` on C costs 17 steps (dearArm → h15 → h4 (3×) → h0 (4×)), and a getter must cost at most 16 steps — make it a method: `function dearArm(self: C): i32`, called as `.dearArm()`
// @error-at 33:4 the getter `long` on N costs 17 steps (long → a compare with a 17-character string literal), and a getter must cost at most 16 steps — make it a method: `function long(self: N): boolean`, called as `.long()`
// @error-at 34:4 the getter `longIs` on N costs 17 steps (longIs → 2 string-literal compares totalling 17 characters), and a getter must cost at most 16 steps — make it a method: `function longIs(self: N): boolean`, called as `.longIs()`
// @error-at 35:32 the getter `runtime` on N compares `string` values with `==`, which loops over their contents, and a getter must not loop — make it a method: `function runtime(self: N): boolean`, called as `.runtime()`
// @error-at 40:27 the getter `remF64` on R takes a float remainder with `%`, which loops as many times as the operands' exponents differ, and a getter must not loop — make it a method: `function remF64(self: R): f64`, called as `.remF64()`
// @error-at 41:27 the getter `remF32` on F takes a float remainder with `%`, which loops as many times as the operands' exponents differ, and a getter must not loop — make it a method: `function remF32(self: F): f32`, called as `.remF32()`
// @error-at 60:4 the getter `t` on A costs 18 steps (t → A.v (2×) → w (8×)), and a getter must cost at most 16 steps — make it a method: `function t(self: A): i32`, called as `.t()`
// The getter step budget (D2061, D2062, D2063): a getter read costs 1 plus the read getter's
// cost, a compare with a string literal its length, a branch its dearest arm, and a chain over
// the budget is one error at its top, naming the path. Comparing two runtime strings and a
// float `%` loop over their operands, and are refused outright.
type C = new i32
get a0(self: C): i32 { (self as! i32) & 1 }
get a1(self: C): i32 { self.a0 + self.a0 + self.a0 + self.a0 }
get a2(self: C): i32 { self.a1 + self.a1 + self.a1 + self.a1 }
get a3(self: C): i32 { self.a2 + self.a2 + self.a2 + self.a2 }
get a4(self: C): i32 { self.a3 + self.a3 + self.a3 + self.a3 }
get a5(self: C): i32 { self.a4 + self.a4 + self.a4 + self.a4 }
get a6(self: C): i32 { self.a5 + self.a5 + self.a5 + self.a5 }
get a7(self: C): i32 { self.a6 + self.a6 + self.a6 + self.a6 }
get a8(self: C): i32 { self.a7 + self.a7 + self.a7 + self.a7 }

// `h15` costs 15 steps, so one read of it costs 16; the dearer arm decides.
get h0(self: C): i32 { (self as! i32) + 1 }
get h4(self: C): i32 { self.h0 + self.h0 + self.h0 + self.h0 }
get h15(self: C): i32 { self.h4 + self.h4 + self.h4 }
get dearArm(self: C): i32 {
  if (self as! i32) > 0 { self.h15 + self.h0 } else { 0 }
}

type N = new { name: string, other: string }
get long(self: N): boolean { self.name == "abcdefghijklmnopq" }
get longIs(self: N): boolean { self.name is "abcdefgh" | "ijklmnopq" }
get runtime(self: N): boolean { self.name == self.other }

type R = new f64
type F = new f32
type I = new i32
get remF64(self: R): f64 { (self as! f64) % 1.5 }
get remF32(self: F): f32 { (self as! f32) % 1.5 }
get remI32(self: I): i32 { (self as! i32) % 7 }

const c = 3 as! C
print(c.a8 + c.dearArm)
const n: N = { name: "z", other: "y" }
print(n.long || n.longIs || n.runtime)
print((3.0 as! R).remF64 + 1.0)
print((3.0 as! F).remF32 + 1.0)
print((9 as! I).remI32)

// The same getter name on two receivers is qualified in the path.
type A = new i32
type B = new i32
get w(self: A): i32 { (self as! i32) + 1 }
get v(self: A): i32 {
  self.w + self.w + self.w + self.w + self.w + self.w + self.w + self.w
}
get v(self: B): i32 { (self as! i32) }
get t(self: A): i32 { self.v + self.v }
print((3 as! A).t + (3 as! B).v)
