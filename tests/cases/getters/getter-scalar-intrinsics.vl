// @log false
// @log 1065353216
// @log 4607182418800017408
// @log 1
// @log 1
// @log 4
// @log 1.5
// Every scalar numeric intrinsic is callable from a getter body (D2064): each lowers to one wasm
// instruction whose only possible effect is a trap (`divU` / `remU` by zero), so it is as
// effect-free as the operators beside it. One getter per intrinsic per width — f64 and f32 for
// the float family, i32 and i64 for the integer family — plus the four bitcasts, a brand read
// through `as!`, and an un-annotated local holding an intrinsic's result.
type Pt = new { x: f64, y: f64 }
get len(self: Pt): f64 { sqrt(self.x * self.x + self.y * self.y) }

type F = new { a: f64, b: f64, h: f64 }
get fSqrt(self: F): f64 { sqrt(self.a) }
get fAbs(self: F): f64 { abs(self.b) }
get fFloor(self: F): f64 { floor(self.b) }
get fCeil(self: F): f64 { ceil(self.b) }
get fTrunc(self: F): f64 { trunc(self.b) }
get fNearest(self: F): f64 { nearest(self.h) }
get fMin(self: F): f64 { min(self.a, self.b) }
get fMax(self: F): f64 { max(self.a, self.b) }
get fCopysign(self: F): f64 { copysign(self.a, self.b) }

type G = new { a: f32, b: f32, h: f32 }
get gSqrt(self: G): f32 { sqrt(self.a) }
get gAbs(self: G): f32 { abs(self.b) }
get gFloor(self: G): f32 { floor(self.b) }
get gCeil(self: G): f32 { ceil(self.b) }
get gTrunc(self: G): f32 { trunc(self.b) }
get gNearest(self: G): f32 { nearest(self.h) }
get gMin(self: G): f32 { min(self.a, self.b) }
get gMax(self: G): f32 { max(self.a, self.b) }
get gCopysign(self: G): f32 { copysign(self.a, self.b) }

type I = new { a: i32, b: i32, c: i32 }
get iClz(self: I): i32 { clz(self.a) }
get iCtz(self: I): i32 { ctz(self.a) }
get iPopcnt(self: I): i32 { popcnt(self.a) }
get iRotl(self: I): i32 { rotl(self.a, self.b) }
get iRotr(self: I): i32 { rotr(self.a, self.b) }
get iDivU(self: I): i32 { divU(self.c, self.b) }
get iRemU(self: I): i32 { remU(self.c, 5) }
get iLtU(self: I): boolean { ltU(self.c, self.b) }
get iGtU(self: I): boolean { gtU(self.c, self.b) }
get iLeU(self: I): boolean { leU(self.b, self.b) }
get iGeU(self: I): boolean { geU(self.b, self.a) }

type L = new { a: i64, b: i64, c: i64 }
get lClz(self: L): i64 { clz(self.a) }
get lCtz(self: L): i64 { ctz(self.a) }
get lPopcnt(self: L): i64 { popcnt(self.a) }
get lRotl(self: L): i64 { rotl(self.a, self.b) }
get lRotr(self: L): i64 { rotr(self.a, self.b) }
get lDivU(self: L): i64 { divU(self.c, self.b) }
get lRemU(self: L): i64 { remU(self.c, 5 as i64) }
get lLtU(self: L): boolean { ltU(self.c, self.b) }
get lGtU(self: L): boolean { gtU(self.c, self.b) }
get lLeU(self: L): boolean { leU(self.b, self.b) }
get lGeU(self: L): boolean { geU(self.b, self.a) }

type B = new { f: f32, d: f64, i: i32, l: i64 }
get bF32bits(self: B): i32 { f32bits(self.f) }
get bF64bits(self: B): i64 { f64bits(self.d) }
get bF32fromBits(self: B): f32 { f32fromBits(self.i) }
get bF64fromBits(self: B): f64 { f64fromBits(self.l) }

type Mask = new i32
get bits(self: Mask): i32 { popcnt(self as! i32) }
get root(self: F): f64 {
  const r = sqrt(self.a)
  r
}

const p: Pt = { x: 3.0, y: 4.0 }
print(p.len)
const f: F = { a: 2.25, b: -1.5, h: 2.5 }
print(f.fSqrt)
print(f.fAbs)
print(f.fFloor)
print(f.fCeil)
print(f.fTrunc)
print(f.fNearest)
print(f.fMin)
print(f.fMax)
print(f.fCopysign)
const g: G = { a: 2.25, b: -1.5, h: 2.5 }
print(g.gSqrt)
print(g.gAbs)
print(g.gFloor)
print(g.gCeil)
print(g.gTrunc)
print(g.gNearest)
print(g.gMin)
print(g.gMax)
print(g.gCopysign)
const i: I = { a: 240, b: 4, c: -8 }
print(i.iClz)
print(i.iCtz)
print(i.iPopcnt)
print(i.iRotl)
print(i.iRotr)
print(i.iDivU)
print(i.iRemU)
print(i.iLtU)
print(i.iGtU)
print(i.iLeU)
print(i.iGeU)
const l: L = { a: 240 as i64, b: 4 as i64, c: -8 as i64 }
print(l.lClz)
print(l.lCtz)
print(l.lPopcnt)
print(l.lRotl)
print(l.lRotr)
print(l.lDivU)
print(l.lRemU)
print(l.lLtU)
print(l.lGtU)
print(l.lLeU)
print(l.lGeU)
const b: B = { f: 1.0, d: 1.0, i: 1065353216, l: 4607182418800017408 as i64 }
print(b.bF32bits)
print(b.bF64bits)
print(b.bF32fromBits)
print(b.bF64fromBits)
const m = 240 as! Mask
print(m.bits)
print(f.root)
