// @run
// @log 4
// @log 36
// @log true
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log 2
// @log true
// @log true
// @log 3
// @log 3
// @log false
// @log true
// @log 1
// @log true
// @log true
// @log 3
// @log true
// @log false
// What the getter step budget (D2061, D2062) admits: a three-level chain under the budget, a
// branch whose arms sum past the budget while its dearer arm stays within it, a compare or an
// `is` against a string literal, costing its length, one of exactly 16 characters, a literal
// whose type is annotated (directly or through an alias), an integer `%`, and a declared
// literal union, whose atom compares by tag at no cost however long its members are. A checked
// conversion that can trap (`f64 as! i32`) costs nothing either. An inline literal union is the
// same atom as a declared one (D2150), so it compares at no cost too — against a literal, against
// another such field, in a `match` — and a `const` bound to a literal is that literal (D2157).
type C = new i32
get b0(self: C): i32 { (self as! i32) & 1 }
get b1(self: C): i32 { self.b0 + self.b0 }
get b2(self: C): i32 { self.b1 + self.b1 }
get b3(self: C): i32 { self.b2 }

// Each arm costs 12 steps (three reads of `h3`, 1 + 3 each), and both together would cost 24.
get h0(self: C): i32 { (self as! i32) + 1 }
get h3(self: C): i32 { self.h0 + self.h0 + self.h0 }
get branchy(self: C): i32 {
  if (self as! i32) > 0 {
    self.h3 + self.h3 + self.h3
  } else {
    self.h3 - self.h3 - self.h3
  }
}

const Z: "z" = "z"
type N = new { name: string, opt: string | null }
get isZ(self: N): boolean { self.name is "z" }
get eqZ(self: N): boolean { self.name == "z" }
get neZ(self: N): boolean { "z" != self.name }
get either(self: N): boolean { self.name is "ab" | "z" }
get sixteen(self: N): boolean { self.name != "abcdefghijklmnop" }
get optZ(self: N): boolean { self.opt is "z" }
get viaTyped(self: N): boolean { self.name == Z }

type I = new i32
get rem(self: I): i32 { (self as! i32) % 7 }

const c = 3 as! C
print(c.b3)
print(c.branchy)
const n: N = { name: "z", opt: "y" }
print(n.isZ)
print(n.eqZ)
print(n.neZ)
print(n.either)
print(n.sixteen)
print(n.optZ)
print(n.viaTyped)
print((9 as! I).rem)

type L = "abc"
const LK: L = "abc"
get viaAlias(self: N): boolean { self.name != LK }
print(n.viaAlias)

type KC = "circle" | "rectangle-with-a-very-long-name"
type K = new { kind: KC }
get isR(self: K): boolean { self.kind == "rectangle-with-a-very-long-name" }
get isRIs(self: K): boolean { self.kind is "rectangle-with-a-very-long-name" }
get code(self: K): i32 {
  match self.kind {
    "circle" => 1
    "rectangle-with-a-very-long-name" => 3
  }
}
const k: K = { kind: "rectangle-with-a-very-long-name" }
print(k.isR && k.isRIs)
print(k.code)

type RF = new f64
get whole(self: RF): i32 { (self as! f64) as! i32 }
print((3.0 as! RF).whole)

type U = new { kind: "cc" | "dd" }
get isDd(self: U): boolean { self.kind is "dd" }
get eqCc(self: U): boolean { self.kind == "cc" }
get uCode(self: U): i32 {
  match self.kind {
    "cc" => 1
    "dd" => 2
  }
}
const u: U = { kind: "cc" }
print(u.isDd)
print(u.eqCc)
print(u.uCode)

type V = new {
  kind: "c" | "rectangle-with-a-very-long-name",
  other: "c" | "rectangle-with-a-very-long-name",
}
get vEq(self: V): boolean { self.kind == "rectangle-with-a-very-long-name" }
get vIs(self: V): boolean { self.kind is "rectangle-with-a-very-long-name" }
get vSame(self: V): boolean { self.kind == self.other }
get vMatch(self: V): i32 {
  match self.kind {
    "rectangle-with-a-very-long-name" => 3
    "c" => 1
  }
}
const v: V = {
  kind: "rectangle-with-a-very-long-name",
  other: "rectangle-with-a-very-long-name",
}
print(v.vEq && v.vIs)
print(v.vSame)
const KZ = "c"
get viaConst(self: N): boolean { self.name != KZ }
get kindConst(self: V): boolean { self.kind == KZ }
print(v.vMatch)
print(n.viaConst)
print(v.kindConst)
