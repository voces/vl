// @trap
// A getter may call an intrinsic that traps (D2064): `divU` by zero is one `i32.div_u`, and the
// contract allows a trap because the program stops either way. The read below traps.
type Ratio = new { n: i32, d: i32 }
get q(self: Ratio): i32 { divU(self.n, self.d) }
const r: Ratio = { n: 7, d: 0 }
print(r.q)
print("unreachable marker")
