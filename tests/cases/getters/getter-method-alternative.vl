// @run
// @log 18
// @log 18
// @log 18
// @log 52
// The two ways out that the getter-bound refusal names (D2066): a parameter typed as the
// receiver reads the getter directly, and the same body declared as a method satisfies a
// `{ r(): i32 }` bound, and a method is what an un-annotated helper can call.
type Color = new i32
type Rgb = new i32

get r(self: Color): i32 { ((self as! i32) >> 16) & 255 }
function r(self: Rgb) { return ((self as! i32) >> 16) & 255 }
function g(self: Rgb) { return ((self as! i32) >> 8) & 255 }

function redOf(c: Color) { return c.r }
function redBound<T: { r(): i32 }>(t: T) { return t.r() }
function greenOf(t) { return t.g() }

print(redOf(0x123456 as! Color))
print(redBound(0x123456 as! Rgb))
print((0x123456 as! Rgb).r())
print(greenOf(0x123456 as! Rgb))
