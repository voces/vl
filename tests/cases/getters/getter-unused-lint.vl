// @run
// @log 6
// @warning Unused getter `never` on V
// A getter is used through a property read, so the one read below spares `twice` and the
// lint names only `never`, which nothing reads.
type V = new { a: i32 }

get twice(self: V): i32 { self.a * 2 }
get never(self: V): i32 { self.a * 3 }

const v: V = { a: 3 }
print(v.twice)
