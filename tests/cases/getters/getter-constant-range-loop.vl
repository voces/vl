// @run
// @log 8
// @log 3
// @log 12
// @log 0
// @log 9
// @log 4
// A getter may loop over a constant range (D16065): its ends and step are literals or `const`s,
// its variable is never written, and it costs its trips times its body, each trip at least one
// step, within the budget of 16. `break` and `continue` leave it, and its variable passes as a
// literal union holding the range (D2065).
type R = new { a: i32 }
type L4 = 0 | 1 | 2 | 3
const LAST = 3

function pick(self: R, i: L4) {
  if i == 2 { return self.a } else { return 1 }
}

get total(self: R): i32 {
  let s = 0
  for i in 0 until 4 { s = s + self.a }
  s
}
get firstOver(self: R): i32 {
  let s = 0
  for i in 0 until 8 {
    if i == 1 { continue }
    if i * self.a > 4 {
      s = i
      break
    }
  }
  s
}
get down(self: R): i32 {
  let s = 0
  for i in LAST to 1 step -1 { s = s + i * self.a }
  s
}
get none(self: R): i32 {
  let s = 0
  for i in 0 until 0 { s = s + self.a }
  s
}
get grid(self: R): i32 {
  let s = 0
  for i in 0 until 3 {
    for j in 0 until 3 { s = s + self.a - 1 }
  }
  s
}
get lanes(self: R): i32 {
  let s = 0
  for i in 0 until 4 { s = s + pick(self, i) }
  s - 1
}

const r: R = { a: 2 }
print(r.total)
print(r.firstOver)
print(r.down)
print(r.none)
print(r.grid)
print(r.lanes)
