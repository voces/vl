// @check
// @error-at 15:23 an `else` body requires braces: `else { … }`
// @error-at 16:20 an `else` body requires braces: `else { … }`
// @error-at 17:26 an `else` body requires braces: `else { … }`
// An `else` body requires braces too (2026-09-01 — DECISIONS.md). The bare
// statement it used to accept (`else print(2)`, `else x = 2`) and, in value
// position, the bare expression (`… else 2`) are parse diagnostics now, and
// they ride the SAME bounded recovery as `if`/`while`/`for`: the one statement
// is taken as the arm, so an unbraced `else` costs exactly ONE diagnostic and
// every later `else` is still reached and reported from its own position.
// `else if` is untouched in BOTH positions (the last two statements): a chain
// is an `if` in the else slot, never an unbraced body, so it stays silent —
// and the oracle is strict, so an undeclared diagnostic there would fail.
let c = false
let x = 0
if c { print(1) } else print(2)
if c { x = 1 } else x = 2
const y = if c { 1 } else 2
print(y)
if c { print(1) } else if x == 2 { print(2) } else { print(3) }
const z = if c { 1 } else if x == 2 { 2 } else { 3 }
print(z)
