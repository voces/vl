// @run
// @log 3
// @log 6
// @log null
// @log true
// @log 5
// @log 9
// @log 11
// @log 44
// The non-operator half of the continuing set: member access (`.`, `?.`), the `is` guard
// and all four `as` casts. None of these tokens can begin an expression, so a line that
// leads with one continues the previous expression exactly as a binary operator does.
//
// `as` is a contextual keyword and stays an IDENT token, so the lookahead matches its
// spelling rather than a kind; `is` has a kind of its own.
type Inner = { n: i32 }
type Box = { inner: Inner | null }
type A = { a: i32 }
type B = { b: string }

const p = { n: 3 }
const fld = p
  .n
print(fld)

const xs = [1, 2, 3]
const meth = xs
  .map((v) => v * 2)
print(meth[2])

const miss: Box = { inner: null }
const opt = miss
  .inner
  ?.n
print(opt)

function mk(): A | B { { a: 4 } }
const v = mk()
const isA = v
  is A
print(isA)

function widen(n: i32) {
  n
    as i64
}
print(widen(5))

const big: i64 = 9
const nar = big
  as! i32
print(nar)

function tryNarrow(n: i64) {
  n
    as? i32
}
print(tryNarrow(11))

const wrapped = 300
  as% u8
print(wrapped)
