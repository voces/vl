// @check
// @error-at 12:5 an `if` body requires braces: `if cond { … }`
// @error-at 13:28 an `if` body requires braces: `if cond { … }`
// @error-at 14:15 an `if` body requires braces: `if cond { … }`
// An `if` body requires braces, and an unbraced one costs exactly ONE
// diagnostic. Before the recovery it cost two: `expect("LBRACE")` diagnosed and
// left the cursor put, `parseBlock` then swallowed the rest of the file as the
// body, and its `expectClose` reported a phantom `expected `}` but found end of
// input` on a line the user never wrote. The parser now takes the one statement
// as the arm — statement position, the `if` after an `else`, and value position
// alike (the last is the same `parseIf`, reached from `parsePrimary`).
let c = true
if c print(1)
if c { print(1) } else if c print(2)
const x = if c 1 else { 2 }
print(x)
