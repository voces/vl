// @check
// @error-at 13:10 expected `,` but found `2`
// @error-at 15:3 postfix `++` target must be an identifier
// A missing comma inside a call is INSERTED, not skipped past (stage 2 of the
// lossless recovery): `f(1 2)` is the two-argument call the user wrote, and the
// only diagnostic is the missing `,`. It used to resync at the `)` instead,
// which dropped the `2` and left a hole-free `f(1)` whose arity was a number
// nobody wrote. The `o.x++` below is an independent LOSSY recovery (the `++` is
// dropped), so it still reports from its own position with no cascade — and it
// is what keeps this file on the bailing side of the stage-1 rule, so the
// typecheck tier never runs here. `parser/call-missing-comma-typechecks.vl` is
// the same call WITHOUT it.
function f(a: i32, b: i32) { a + b }
print(f(1 2))
let o = { x: 1 }
o.x++
