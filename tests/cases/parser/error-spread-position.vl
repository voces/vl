// @check
// @error a spread fills the rest parameter by position, so it cannot be named
// @error `...` may only appear before a call argument or a list element
// `...` is a token the parser takes in exactly TWO positions — before a call argument and
// before a list element — so a third is a parse error naming both, rather than the
// "expected an expression but found ELLIPSIS" the tag fall-through would print. A NAMED
// spread is refused for the reason named arguments exist: a name binds ONE parameter, and
// the rest parameter it would have to fill is many.
function rest(...xs: i32[]) { return xs.length }
const ys = [1, 2]
print(rest(xs: ...ys))
const bad = ...ys
print(bad)
