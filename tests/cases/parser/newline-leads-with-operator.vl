// A line that begins with a token that cannot start an expression continues the previous
// expression, at statement level and not only inside brackets (DECISIONS.md, owner
// 2026-09-04; glean VL-031). The continuing set is derived from the parser's own
// binary-operator table, so it cannot drift, and every member is pinned here once.
//
// The last two logs are the forms that already worked and must keep working: the operator
// at end of line, and the whole expression in parentheses.
const a = 1
const b = 2

const orv = a == 1
  || b == 9
print(orv)

const andv = a == 1
  && b == 2
print(andv)

const z: i32 | null = null
const co = z
  ?? 7
print(co)

const eqv = a
  == 1
print(eqv)

const nev = a
  != 2
print(nev)

const ltv = a
  < b
print(ltv)

const lev = a
  <= 1
print(lev)

const gtv = b
  > a
print(gtv)

const gev = b
  >= 2
print(gev)

const sum = a
  + b
print(sum)

const prod = b
  * 3
print(prod)

const quot = 12
  / b
print(quot)

const rem = 7
  % 3
print(rem)

const bor = 8
  | 1
print(bor)

const band = 12
  & 10
print(band)

const bxor = 12
  ^ 10
print(bxor)

const shl = 1
  << 4
print(shl)

const shr = -16
  >> 2
print(shr)

const ushr = -16
  >>> 28
print(ushr)

// Assignment and its compound forms are entries in the same binary-operator table and none
// of them can begin an expression, so the derivation carries them in with the rest.
let asg = 0
asg
  = 5
print(asg)

asg
  += 4
print(asg)

asg
  -= 2
print(asg)

asg
  *= 3
print(asg)

asg
  /= 7
print(asg)

const trail = a +
  b
print(trail)

const paren = (a
  + b)
print(paren)
