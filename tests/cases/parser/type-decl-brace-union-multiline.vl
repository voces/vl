// @run
// @log 1
// @log 2
// A union whose FIRST member is an inline object, WRAPPED across lines. Every
// other union spelling could already be written this way (`type A = Name` /
// `  | Other` parses), but the `{ … }` path tested for its `|` continuation
// WITHOUT skipping the newline first, so a brace-leading union was the one union
// that had to fit on a single line — "expected an expression but found PIPE".
// That also made `vl fmt` fail its own re-parse check on an over-width one: the
// wrap it emitted is exactly the shape below.
type Brace = { a: i32 }
  | { b: i32 }

function pick(v: Brace): i32 {
  if v is { a: i32 } { return v.a }
  v.b
}

print(pick({ a: 1 }))
print(pick({ b: 2 }))
