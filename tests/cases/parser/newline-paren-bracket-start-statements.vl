// @run
// @log 10
// @log bracket
// @log 20
// @log paren
// @log 30
// The COMPANION to the leading-dot rule: only `.` / `?.` continue a chain across
// a newline. `(` and `[` do NOT, because a line starting with `(` is a legal
// parenthesised statement and one starting with `[` a legal array literal — so
// consuming the newline before either would silently glue two statements into a
// call or an index.
//
// The logs are what distinguish the two readings. Joined, `print(xs[0])` would be
// CALLED with `(note("paren"))` and INDEXED by `[note("bracket")]`, neither of
// which type-checks; separate, each statement runs where it is written, and the
// interleaving `10 / bracket / 20 / paren / 30` is the proof it did.
function note(tag: string) {
  print(tag)
  0
}

const xs = [10, 20, 30]

print(xs[0])
[note("bracket")]
print(xs[1])
(note("paren"))
print(xs[2])
