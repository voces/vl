// @check
// @error-at 10:26 name every parameter of a function type, or none of them
// @error-at 11:31 name every parameter of a function type, or none of them
// @error-at 12:16 a parameter name is written only in a function type `(name: T) => R`
// @error-at 13:10 `type` is a keyword and can't name a parameter — rename it
// @error-at 14:24 the parameter name `a` appears twice in this function type
// Parameter names in a function type are all or none (DECISIONS.md, "Parameter names in a
// function type are documentation"): a half-named list reads as though the unnamed slots
// were something else. A name inside a plain parenthesized type names nothing, a keyword
// cannot be one, and one list cannot name two parameters alike.
type Mixed = (fn: i32, i64) => i32
type Tail = (i32, rcx: i64, i64) => i32
type P = (x: i32)
type K = (type: i32, x: i64) => i32
type D = (a: i32, a: i64) => i32
