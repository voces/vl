// @check
// @error-at 11:2 the getter `calc` on I constructs a struct, and a getter must not allocate — make it a method: `function calc(self: I): Q`, called as `.calc()`
// D2292's call-then-brace shape inside a GETTER body. A getter's body is parsed by the same
// `parseFuncBodyAndBuild` as a `function`, so it shares the fix — the diagnostic below is the
// checker's ordinary no-allocation rule for getters, reached only because the parse already
// succeeded (a getter can never itself construct the returned struct, so this is the plainest
// getter this shape can typecheck up to).
type Q = { x: i32 }
type I = new { a: i32, b: i32, c: i32 }
get calc(self: I): Q {
  remU(self.c, 5)
  { x: self.a }
}
const i: I = { a: 1, b: 2, c: 7 }
print(i.calc.x)
