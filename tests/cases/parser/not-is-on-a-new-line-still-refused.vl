// @check
// @error-at 13:3 expected an expression but found IS
// `is` continues a line; `!is` does not. The pair's first token is `!`, which can begin an
// expression, and the ruling keeps every such token a statement start — so the lookahead
// matches a bare `IS` only and the negated guard has to stay on its operand's line.
//
// The refusal is the ruling's, not a gap: a program wanting the negated guard on a second
// line writes `!(v` newline `is A)`, where the bracket depth makes the newline whitespace.
type A = { a: i32 }
type B = { b: string }
function mk(): A | B { { a: 1 } }
const v = mk()
const notA = v
  !is A
print(notA)
