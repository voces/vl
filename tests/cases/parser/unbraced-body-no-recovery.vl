// @check
// @error-at 13:7 expected `{` but found `}`
// @error-at 16:10 expected `{` but found `}`
// @error-at 19:13 expected `{` but found `}`
// The recovery is GATED on the offending token plausibly STARTING a statement
// (`startsStmt`). A closer does not, so these keep the plain `expected `{``
// reading: a body was not written unbraced, it was not written at all, and
// synthesizing an arm out of a `}` would be a guess rather than a reading.
// One diagnostic each here because the `}` still closes the enclosing block —
// the `expect` error path never consumes a sync token, by design.
const c = true
const a = [1]
function f() {
  if c }
}
function g() {
  while c }
}
function h() {
  for v in a }
}
