// @run
// @log 1
// @log true
// @log false
// @log true
// @log true
// @log true
// @log true
// @log lt
// @log no
// @log yes
// @log false
// @log false
// @log true
// After `x as T`, a `<` is a comparison when `T` takes no type arguments — a primitive, or a
// type this module declares without parameters (D3564, sunpa SP-018). The cast's target used
// to read the `<` as the start of an argument list, so `y as f64 < h` failed to parse with
// `expected > but found …` and needed `(y as f64) < h`.
const h = 10
let y = 3
let n = 0
while y as f64 < h as f64 * 0.35 {
  y = y + 1
  n = n + 1
}
print(n)
type Meters = f64
const d = 2
print(d as Meters < 2.5)
print(d as f64 < 1.5)
print(d as i64 <= 2)
// The spellings sunpa met (`!(fill[p] as f64 < fk)`): inside `!( … )`, as `&&`/`||` operands,
// an `if` condition, call arguments, list elements, and over an indexed receiver.
const fill = [1, 5, 9]
const fk = 4.5
const p = 1
print(!(fill[p] as f64 < fk))
print(fill[0] as f64 < fk && fill[2] as f64 > fk)
print(fill[2] as f64 < fk || fill[0] as f64 < fk)
if fill[0] as f64 < fk { print("lt") }
function show(b: boolean) {
  if b { "yes" } else { "no" }
}
print(show(fill[1] as f64 < fk))
print(show(fill[1] as i64 < 6))
const xs = [fill[0] as f64 < fk, fill[2] as f64 < fk]
print(xs[1])
const neg = !(fill[0] as f64 < fk) || fill[1] as f64 < 2.0
print(neg)
print(fill[p] as f64 < fill[2] as f64)
