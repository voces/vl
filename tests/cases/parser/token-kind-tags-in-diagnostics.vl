// The token KIND TAG as the parser renders it — 45 distinct members of the closed
// `TokKind` vocabulary, each named by its own spelling in the one diagnostic that
// prints a raw tag ("expected an expression but found <TAG>").
//
// WHAT THIS PINS, and why nothing else does. `TokKind` is a literal union, so a
// kind is an i32 ATOM at runtime and its SPELLING is minted back from that atom by
// a single renderer. Everything else in the corpus exercises kinds only through
// COMPARISONS — and a comparison is atom-vs-atom, so a wrong atom→spelling map is
// invisible to it: the compiler would still parse, still typecheck, still emit
// identical bytes, still self-compile to a fixpoint, and simply misname tokens in
// its own error messages. That is the §8.4 defect shape (a compiler that is a
// fixpoint of its own mistake), and these directives are the instrument that sees
// it: the harness requires every diagnostic to match a directive AND every
// directive to match a diagnostic, so one shifted tag reddens twice.
//
// It also pins the LEXER's kind assignment, since the tag printed is the kind the
// scanner chose: `>>>` must lex as USHR (not SHR + GT), `?.` as QUESTION_DOT (not
// QUESTION + DOT), `<=` as LE. Longest-match errors show up here as a wrong tag.
//
// Each line is its own statement so recovery resyncs at the newline and the
// diagnostics stay one-per-line rather than cascading.
let a01 = ;
let a02 = ,
let a03 = *
let a04 = /
let a05 = %
let a06 = ^
let a07 = >
let a08 = <
let a09 = :
let a10 = =
let a11 = ?
let a12 = .
let a13 = |
let a14 = &
let a15 = +=
let a16 = -=
let a17 = *=
let a18 = /=
let a19 = <<
let a20 = >>
let a21 = >>>
let a22 = &&
let a23 = ||
let a24 = ?.
let a25 = ??
let a26 = ==
let a27 = !=
let a28 = >=
let a29 = <=
let a30 = )
let a31 = ]
let a32 = else
let a33 = const
let a34 = let
let a35 = return
let a36 = import
let a37 = export
let a38 = is
let a39 = while
let a40 = for
let a41 = break
let a42 = continue
let a43 = type
// `~` is a PREFIX operator: it is consumed, and the NEWLINE behind it is what the
// expression parser then reports.
let a44 = ~
