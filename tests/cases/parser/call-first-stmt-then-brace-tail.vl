// @run
// @log mk
// @log 3
// @log mk
// @log 3
// @log mk
// @log 3
// @log mk
// @log 3
// @log mk
// @log 3
// @log mkI32
// @log 6
// @log mk
// @log 3
// @log mk
// @log 7
// @log blk
// @log 0
// @log else
// @log -6
// @log 3
// @log foo
// @log 3
// @log hi
// @log 3
// @log 3
// @log 8
// D2292 — a declaration BODY's opening `{` is always the body, never the start of an object
// literal with a method-shorthand member, even when its first statement is a CALL.
// `looksLikeObject`'s method-shorthand lookahead read any `IDENT (...)` followed by `{` as a
// candidate member `name(params) { … }` with no check that `(...)` looks like a parameter
// list — `print("mk")` then a returned `{ x: n }` on the next line matched it. See
// docs/internals/inventory/D2292.md for the mechanism and the full ablation.
type Q1 = { x: i32 }
function mk1(n: i32): Q1 {
  print("mk")
  { x: n }
}
print(mk1(3).x)

// No return type (inferred from the tail object).
function mk2(n: i32) {
  print("mk")
  { x: n }
}
print(mk2(3).x)

// A generic return type: `Box<T> {` is the body, not a type continuation.
type Box3<T> = { v: T }
function mk3<T>(n: T): Box3<T> {
  print("mk")
  { v: n }
}
print(mk3(3).v)

// A union return type: `Q | null {` is the body, not a nullable-of-object annotation eating
// the brace.
type Q4 = { x: i32 }
function mk4(n: i32): Q4 | null {
  print("mk")
  { x: n }
}
const r4 = mk4(3)
if r4 is Q4 { print(r4.x) }

// A nominal `new` return type.
type Q5 = new { x: i32 }
function mk5(n: i32): Q5 {
  print("mk")
  { x: n }
}
print(mk5(3).x)

// A primitive return type — the brace-tail need not be an object at all, only brace-LED, to
// trigger the misparse; an explicit `return` inside a nested block shows the body is reached
// and executed as ordinary statements.
function mk6I32(n: i32) {
  print("mkI32")
  {
    return n * 2
  }
}
print(mk6I32(3))

// A lambda with a return annotation: `(): Q => {` is the body.
type Q7 = { x: i32 }
const mk7 = (n: i32): Q7 => {
  print("mk")
  { x: n }
}
print(mk7(3).x)

// A method — an ordinary function whose first parameter is `self`, called via UFCS.
type Q8 = { x: i32 }
type Box8 = { n: i32 }
function mk8(self: Box8, extra: i32): Q8 {
  print("mk")
  { x: self.n + extra }
}
const b8 = { n: 3 }
print(b8.mk8(4).x)

// A bare block statement (not a declaration body) with the same shape.
function f9(n: i32) {
  const acc = 0
  {
    print("blk")
    { x: n }
  }
  acc
}
print(f9(3))

// The `else` arm of an `if` — a separate `looksLikeObject` call site, same lookahead.
function g10(n: i32) {
  if n > 0 {
    print("then")
  } else {
    print("else")
    {
      return n * 2
    }
  }
}
print(g10(-3))

// Control: a statement-keyword-first body is unaffected — always a block, decided before this
// lookahead ever runs.
type Q13 = { x: i32 }
function mk13(n: i32): Q13 {
  const s = n
  { x: s }
}
print(mk13(3).x)

// The zero-argument residual this row's ablation named but left open: `parenLooksLikeParamList`
// cannot rule an empty argument list out on its own. Closed by requiring the body brace on the
// same line as the closing `)` — a real signature's body always is, everywhere in this file.
type Q14 = { x: i32 }
function foo14() { print("foo") }
function mk14(n: i32): Q14 {
  foo14()
  { x: n }
}
print(mk14(3).x)

// Control: a genuine zero-parameter method shorthand, body brace on the SAME line, still
// resolves as one member of the object, not a block.
const o15 = {
  greet: () => {
    "hi"
  },
}
print(o15.greet())

// The other residual: a call whose sole argument is a bare identifier — syntactically
// identical to a one-parameter untyped signature. Closed by the same same-line rule.
type Q16 = { x: i32 }
function mk16(n: i32): Q16 {
  print(n)
  { x: n }
}
print(mk16(3).x)

// Control: a genuine one-parameter (untyped in the object, typed here so it stands alone)
// method shorthand, body brace on the SAME line, still resolves as a member.
const o17 = {
  double: (n: i32) => {
    n * 2
  },
}
print(o17.double(4))
