// @run
// @log 12
// @log 2
// @log 8
// A NEWLINE followed by `.` CONTINUES the postfix chain (DECISIONS.md, owner
// 2026-09-02). Nothing legal starts with `.` today — `.5` is already a parse
// error at the DOT in the lexer's NUMBER arm — so the rule cannot change what an
// existing program means; it only gives a chain a second line to live on.
//
// Both arities are pinned: TWO links (`.map` / `.length`) and THREE
// (`.map` / `.filter` / `.length`), plus a chain whose links sit on a run of
// SEVERAL newlines rather than one, since the parser skips the whole run.
const xs = [1, 2, 3]

const two = xs
  .map((v) => v * 4)
  .length
print(two * 4)

const three = xs
  .map((v) => v * 2)
  .filter((v) => v > 2)
  .length
print(three)

const spaced = xs

  .map((v) => v + 1)

  .length
print(spaced + 5)
