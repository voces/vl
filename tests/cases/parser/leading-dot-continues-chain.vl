// @run
// @log 12
// @log 2
// @log 8
// A NEWLINE followed by `.` CONTINUES the postfix chain (DECISIONS.md, owner
// 2026-09-02). Nothing legal starts with a LONE `.` — `.5` is already a parse
// error at the DOT in the lexer's NUMBER arm, and `...` is its own token — so the
// rule cannot change what an existing program means; it gives a chain a second line.
//
// Each chain is wider than `vl fmt`'s line, so fmt keeps it broken and every link
// below really does lead its own line. Both arities are pinned: TWO call links
// (`.map` / `.filter`) and THREE (`.map` / `.filter` / `.map`), each ending in a
// plain `.length` link of its own. A blank line or a comment between two links lives
// in `tests/vl_paren_newline_test.ts`, since `vl fmt` normalises both away.
const xs = [1, 2, 3]

const two = xs
  .map((valueFromTheList) => valueFromTheList * 4)
  .filter((valueFromTheList) => valueFromTheList > 0)
  .length
print(two * 4)

const three = xs
  .map((valueFromTheList) => valueFromTheList * 2)
  .filter((valueFromTheList) => valueFromTheList > 2)
  .map((valueFromTheList) => valueFromTheList + 1)
  .length
print(three)

const words = ["a", "bb", "ccc", "dddd"]
const longest = words
  .filter((wordFromTheList) => wordFromTheList.length > 1)
  .map((wordFromTheList) => wordFromTheList.length * 2)[2]
print(longest)
