// @run
// @log ice
// @log 1
// @log 3
// @log fire
// DV-1210: a type alias's body may start on the line after its `=`, so a long union can put
// every member on its own line.
type Tag =
  "fire"
  | "ice" // cold

type P =
  { x: i32 }

type Id =
  new i32

export type Short =
  "fire" | "ice"

const t: Tag = "ice"
print(t)
const p: P = { x: 1 }
print(p.x)
const i = 3 as Id
print(i as i32)
const s: Short = "fire"
print(s)
