// @check
// @error-at 8:19 expected `>` but found `*` — if `<` compares the cast, parenthesize it: `(x as Num) < y`
// @error-at 9:0 expected `)` but found end of input
// A cast to a GENERIC target keeps reading `<` as its argument list (D3564): `Num` takes one,
// so the parse fails where the list does, and the message says how to write the comparison
// the `<` may have meant.
type Num<T> = T
const d: i32 = 2
print(d as Num < 3 * 2)
