// @check
// @error-at 9:5 `then` was removed — wrap the branch in braces: `if cond { … }`
// @error-at 10:15 `then` was removed — wrap the branch in braces: `if cond { … }`
// The `then` single-statement sugar was removed (2026-08-31 — DECISIONS.md):
// a branch is a brace block in BOTH of its old positions (statement and
// expression). Old code gets this targeted refusal instead of the generic
// "expected `{`", and the parser recovery still consumes the old shape, so a
// stranded file reports every occurrence in one pass rather than one per run.
let c = true
if c then print(1)
const x = if c then 7 else 8
print(x)
