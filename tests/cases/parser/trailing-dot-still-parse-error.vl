// @check
// @error-at 13:12 expected an identifier but found end of line
// LEADING-DOT IS THE ONLY FORM. A trailing `.` at end of line stays a parse
// error (DECISIONS.md, owner 2026-09-02): the DOT arm of `parsePostfix` demands
// an IDENT on the spot, and the newline-skipping added for the leading form runs
// BEFORE a dot is consumed, never after one. So the chain never gets to look
// past the line break for its property name.
//
// The `else` half of the ruling — this is not merely unimplemented, it is
// refused — which is why the row is an error case and not a `@run`.
type Box = { n: i32 }

const b: Box = { n: 1 }
const r = b.
  n
print(r)
