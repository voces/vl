// @check
// @error-at 6:11 `type` is a keyword and can't name a parameter — rename it
// @error-at 14:6 expected an identifier but found `=`
// The recovery that reads a keyword as a name ends the cascade from that declaration only
// (D3069): a genuine error later in the file is still reported, and a keyword that keeps its
// meaning — the `type` declaration and the `if` statement after `f` — still parses as one.
function f(type: i64): i64 {
  type + 1
}

type Box = { n: i32 }

function g(b: Box): i32 {
  if b.n > 0 { return 1 }
  let = 2
  b.n
}
