// @check
// @error-at 13:11 `match` is a keyword and can't name a parameter — rename it
// @error-at 19:6 `while` is a keyword and can't name a variable — rename it
// @error-at 26:8 `null` is a keyword and can't name a constant — rename it
// @error-at 32:6 `is` is a keyword and can't name a loop variable — rename it
// @error-at 35:9 `else` is a keyword and can't name a loop variable — rename it
// @error-at 41:13 `export` is a keyword and can't name a parameter — rename it
// @error-at 45:9 `if` is a keyword and can't name a function — rename it
// Every binding position refuses a keyword name once, in its own words (D3069): a parameter,
// a `let`, a `const`, both `for` variables, an arrow-lambda parameter and a function name. Each
// name is then used where only a value can stand, and none of those uses is a second error.
function g(x: i64): i64 { x }

function p(match: i64): i64 {
  if match > 0 { return g(match) }
  match * 2
}

function l(): i64 {
  let while: i64 = 1
  while = while + 1
  while += 2
  while
}

function c(): i64 {
  const null = 3
  const xs = [null, null]
  null * 2
}

function fr(xs: i64[]) {
  for is in xs {
    print(is + 1)
  }
  for i, else in xs {
    print(else)
  }
}

function lam(): i64 {
  const h = (export: i64) => export + 1
  h(1)
}

function if(x: i64): i64 { x }

function call(): i64 {
  const r = if(2) + if(3)
  r
}
