// @run
// @log -0.5
// @log 2
// @log tight
// @log -1
// @log note
// @log -5
// @log 15
// A line-leading `-` followed by a space or tab continues the previous expression (D3698,
// sunpa SP-040); a `-` touching its operand starts a statement, so a block can still end in
// `-x`. The broken chains are too wide for one line, so this is the layout `vl fmt` prints.
// `note` returns 100, so a wrongly joined `note(..) - x` would print something else.
// The spellings fmt rewrites (a tab, brackets, a comment between) are in
// `tests/vl_paren_newline_test.ts`.
function note(tag: string) {
  print(tag)
  100
}

function camera(cameraDistance: f64, cameraHeightOffset: f64) {
  const w = cameraDistance * 3.0
    - cameraHeightOffset * 3.5
    - cameraDistance * cameraHeightOffset * 0.0
  w
}
print("\{camera(1.0, 1.0)}")

// Left-associative across lines: (9 - 4) - 3, not 9 - (4 - 3).
function chain(
  firstOperandLonger: i32,
  secondOperandLonger: i32,
  thirdOperand: i32,
) {
  firstOperandLonger
    - secondOperandLonger
    - thirdOperand
    + firstOperandLonger * 0
}
print(chain(9, 4, 3))

// `-1` and `-x` after a call are the block's value.
function tightLiteral() {
  note("tight")
  -1
}
print(tightLiteral())
function blockValue(x: i32) {
  note("note")
  -x
}
print(blockValue(5))

// Precedence is the one-line form's: 3 * 7 - 2 * 3 = 15.
function prec(
  firstOperandLonger: i32,
  secondOperandLonger: i32,
  unusedThird: i32,
) {
  firstOperandLonger * 7
    - secondOperandLonger * 3
    + unusedThird * 0
    + unusedThird * 0
}
print(prec(3, 2, 1))
