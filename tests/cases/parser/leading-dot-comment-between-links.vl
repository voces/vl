// @run
// @log 6
// A comment line BETWEEN two links is free: the lexer eats `// …` up to the
// newline and retains it as trivia, so it never reaches `P.toks` and the
// chain-continuation scan — which walks a run of NEWLINE tokens — cannot see it.
// Doc comments (`///`) take the same path, so both spellings are pinned here.
const xs = [1, 2, 3]

const n = xs
  // the length of the doubled list
  .map((v) => v * 2)
  /// still the same chain
  .length
print(n * 2)
