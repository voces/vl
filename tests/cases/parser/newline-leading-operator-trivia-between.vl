// @run
// @log 5
// @log 3
// The scan is "the next token after the newline", not "the next line", so a comment line or
// a blank line between the operand and its operator costs nothing: comments are trivia and
// never reach the token stream, and a blank line is one more NEWLINE in the run the scan
// already walks. Same rule and same code path as the leading-dot chain.
const a = 1
const b = 2

const withComments = a
  // the operand's second line
  + b
  /// a doc comment sits in the same trivia
  * 2
print(withComments)

const withBlanks = a

  + b

print(withBlanks)
