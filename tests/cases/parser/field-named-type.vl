// @run
// @log 3
// @log 5
// @log t
// @log 7
// @log -1
// @log 10
// @log 56
// @log 11
// @log o
// @log 3
// @log 3
// @log 4
// @hint redundant type annotation: `g` is inferred as `{name: string, type: i32}`
// @hint redundant type annotation: `r` is inferred as `{type: i32, n: i32}`
// @hint redundant type annotation: `m` is inferred as `{type: i32, other: string}`
// @hint redundant type annotation: `rs` is inferred as `{type: i32, n: i32}[]`
// @hint redundant type annotation: `u` is inferred as `{type: {type: i32, n: i32}}`
// D3021 (plumb PL-067): `type` is a keyword only where a declaration can start, so it names a
// field in a record type, an inline object type, a literal (key-value form), a member access
// (`.` and `?.`) and a match payload clause.
type Global = { name: string, type: i32 }
const g: Global = { name: "x", type: 3 }
print(g.type)

const inferred = { name: "x", type: 4 }
print(inferred.type + 1)

function inline(r: { type: string }) { r.type }
print(inline({ type: "t" }))

type R = { type: i32, n: i32 }
function mk(b: boolean): R | null {
  if b { { type: 7, n: 0 } } else { null }
}
print(mk(true)?.type ?? -1)
print(mk(false)?.type ?? -1)

const r: R = { type: 1, n: 6 }
r.type = 9
r.type += 1
print(r.type)

// A `{ type: … }` at statement position is a literal, not a block opening a declaration.
function tail(): R { { type: 5, n: 6 } }
print(tail().type * 10 + tail().n)

type M = {
  type: i32,
  other: string,
}
const m: M = { type: 11, other: "o" }
print(m.type)
print(m.other)

const rs: R[] = [{ type: 1, n: 0 }, { type: 2, n: 0 }]
let s = 0
for x in rs { s = s + x.type }
print(s)

// A block-scoped type declaration still parses beside a field of that name. (The file stays
// free of string interpolation: a block-scoped type beside a `std` import is D3022.)
function local() {
  type U = { type: R }
  const u: U = { type: { type: 3, n: 0 } }
  print(u.type.type)
}
local()

type Sym = { kind: "sym", type: i32 }
type Nil = { kind: "nil" }
function show(x: Sym | Nil) {
  match x {
    Sym{type: t} => t
    Nil => 0
  }
}
print(show({ kind: "sym", type: 4 }))
