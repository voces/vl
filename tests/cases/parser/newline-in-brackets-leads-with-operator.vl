// @run
// @log true
// @log 3
// @log 12
// @log 9
// @log 2
// @log true
// @log 1
// @log -1
// D1581 — a NEWLINE inside an open `(` / `[` / object-literal `{` is whitespace before
// a binary operator, so a continuation line may LEAD with the operator. Inside a bracket
// there is no statement the newline could be ending, so terminating there cost a
// spelling and bought nothing; the trailing-operator spelling already worked, and every
// style guide that has an opinion prefers the leading one. Reported by glean (VL-031),
// writing a JASS parser whose precedence tests are runs of `||`.
//
// The rule is gated on BRACKET DEPTH and a block resets it to zero, which is what keeps
// statement level unchanged: `a` NEWLINE `-b` is still two statements there, including
// inside a lambda body nested in a call argument. The last two logs are that control —
// `sep` returns `-a`, not `a - a`. Ruling: DECISIONS.md, "Newlines inside brackets".
const a = 1
const b = 2

const ok = (a == 1
  || b == 2)
print(ok)

const sum = (a
  + b)
print(sum)

const xs = [a * 4
  + 8, 99]
print(xs[0])

const idx = [5, 7, 9]
print(idx[a
  + 1])

const obj = { v: a
  + 1 }
print(obj.v)

function id(v: boolean) { v }
print(id(a == 1
  || a == 9))

const sep = (x: i32) => {
  const v = x
  print(v)
  -v
}
print(sep(1))
