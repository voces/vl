// @check
// @error-at 5:29 VL has no `**` operator; use `powF64(c, 2.2)` from `std:math` (or `powF32`)
// @error-at 7:2 VL has no `**=` operator; use `x = powF64(x, 3.0)` from `std:math` (or `powF32`)
// D3606 (sunpa SP-031): VL has no power operator, so `**` names the std function to call with the
// author's own operands, and `**=` the assignment that replaces it. `*` and `*=` are untouched.
function lin(c: f64) { c * c ** 2.2 }
let x = 2.0
x **= 3.0
x *= 2.0
print(lin(x) * 2.0)
