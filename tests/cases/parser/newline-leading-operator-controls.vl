// @run
// @log minus
// @log -5
// @log paren
// @log 7
// @log bracket
// @log 4
// @log bang
// @log true
// @log ident
// @log 9
// @log literal
// @log 8
// The excluded half of the ruling: a line beginning with `-`, `!`, `(`, `[`, an identifier
// or a literal is a statement, because each of those can begin an expression. Unary minus
// is the one that had to be argued — `{ f()` newline `-x }` is a legal block today whose
// value is `-x`, and joining would silently turn it into `f() - x`.
//
// Each function calls `note` first, so the interleaved tag and value are the proof that two
// statements ran where two are written: joined, none of these would type-check.
function note(tag: string) {
  print(tag)
  0
}

const five = 5
const off = false
const nine = 9

function minusStatement() {
  note("minus")
  -five
}
print(minusStatement())

function parenStatement() {
  note("paren")
  (7)
}
print(parenStatement())

function bracketStatement() {
  note("bracket")
  [3, 4][1]
}
print(bracketStatement())

function bangStatement() {
  note("bang")
  !off
}
print(bangStatement())

function identStatement() {
  note("ident")
  nine
}
print(identStatement())

function literalStatement() {
  note("literal")
  8
}
print(literalStatement())
