// @run
// @log true
// @log true
// @log 7
// @log 5
// @log 7
// @log true
// @log 8
// @log 4
// @log 4
// A continued line binds exactly as if the newline were a space: the parser skips the run
// and hands the operator to the same precedence climber, so no rule of grouping is special
// to the multi-line spelling.
//
// `grouped` and `flat` are the discriminating pair — with `t || t && f` the two readings
// disagree, `t || (t && f)` is true and `(t || t) && f` is false, and the two spellings
// print the same answer.
const t = true
const f = false

const grouped = t
  || t
  && f
print(grouped)

const flat = t || t && f
print(flat)

const arith = 1
  + 2
  * 3
print(arith)

const arith2 = 1 * 2
  + 3
print(arith2)

// Breaking before and after an operator in one expression is still one grouping.
const mixedBreak = 1 +
  2
  * 3
print(mixedBreak)

const cmp = 1
  + 2
  == 3
print(cmp)

const shifted = 1
  << 2
  + 1
print(shifted)

// Assignment stays right-associative across the break: `x = (y = 4)`.
let x = 0
let y = 0
x
  = y
  = 4
print(x)
print(y)
