// @run
// @log 4
// @log 0
// @log 5
// @log 9
// @log 3
// @hint redundant type annotation: `branch` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `arm` is inferred as `i32` — remove it to lean on inference
// D3475's guard: only `{ name, …` joined `{ name: …` as an object. A lone `{ name }` is still a
// block whose value is `name`, in an `if` and `else` branch, a `match` arm and a lambda body,
// so these return an `i32`, not a one-field object.
function branch(b: boolean, id: i32): i32 {
  if b { id } else { 0 }
}

function arm(k: i32, id: i32): i32 {
  match k {
    1 => {
      id
    }
    _ => {
      9
    }
  }
}

const lam = (id: i32): i32 => {
  id
}

print(branch(true, 4))
print(branch(false, 4))
print(arm(1, 5))
print(arm(2, 5))
print(lam(3))
