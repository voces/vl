// DV-1214: JavaScript's `!==` and `===` are one diagnostic each, spanning the whole operator, and
// the comparison is checked as `!=` and `==` with nothing cascading after it. `== =` apart is not this.
function f(n: i32): i32 {
  if n !== 2 && n === 3 { return 1 }
  0
}
print(f(1) + 1)
