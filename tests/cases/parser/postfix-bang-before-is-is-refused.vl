// @check
// @error-at 14:13 VL has no postfix `!` (non-null assertion), and `x! is O` is not `x !is O`; write `x is O` to test the type, or `x !is O` to negate the test
// @error-at 15:17 VL has no postfix `!` (non-null assertion), and `x! is O` is not `x !is O`
// @error-at 16:15 VL has no postfix `!` (non-null assertion), and `x! is O` is not `x !is O`
// D3585: `x! is O`, a `!` written against its operand and apart from `is`, is refused rather
// than read as the negated test `x !is O`. The `!is` spellings on the last lines are the
// negated test, unchanged.
type O = { n: i32 }
function f(x: O | null, xs: (O | null)[]): boolean {
  const neg = x !is O
  const tight = x!is O
  const spaced = x ! is O
  print(neg || tight || spaced)
  print(!(x is O))
  const a = x! is O
  const b = xs[0]! is O
  const c = (x)! is O
  a && b && c
}
print(f(null, []))
