// @check
// @error-at 9:4 `{ id }` here is a block, not a record — write `return { id }` or `({ id })`
// @error-at 13:25 an empty block does nothing; remove it
// D3475's guard: a function body whose tail is `{ id }` holds a nested block, not a shorthand
// object, so it returns nothing, and the error says so (DV-1216); that object is written `({ id })`. And `{}` where a statement
// starts is an empty block, not an empty object.
type Q = { id: i32 }
export function one(id: i32): Q {
  {
    id
  }
}

export function none() { {} }
