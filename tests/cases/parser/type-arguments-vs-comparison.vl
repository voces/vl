// @run
// @log true
// @log false
// @log true
// @log 1
// @log true
// @log true
// `<` after a callee opens type arguments only when TypeScript's rule holds: the run parses
// as a type list, closes with `>`, and is followed directly by `(`. Every other `<` is a
// comparison, including the ones below that start the same way. Only `a < b > (c)` — a
// relational chain VL's checker never accepted (`boolean > i32`) — reads as a generic call.
const a = 1
const b = 2
const c = 3
print(a < b)
print(b > c)
print(a < b && c > (a))
function two(x: boolean, y: boolean) {
  if x && y { 1 } else { 0 }
}
print(two((a < b), c > (a)))
print(a < b == true)
const xs = [1, 2, 3, 4]
print(xs.length < 8 >> 1 || a < xs[0] + xs.length)
