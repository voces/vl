// @check
// @error-at 8:11 `if` is a keyword and can't name a parameter — rename it
// @error-at 9:12 `match` is a keyword and can't name a parameter — rename it
// @error-at 20:11 `if` is a keyword and can't name a parameter — rename it
// A keyword read back as a recovered name only inside the scope that declared it (D3069). The
// `if`, `match` and `while` statements in `g` open with a parenthesised operand and are the
// keywords, so the only errors are the two declarations. Inside `k` the declared `if` is in
// scope, and `if (if) > 0 {` is still the statement because a `{` ends it.
function f(if: i32): i32 { 0 }
function f2(match: i32): i32 { 0 }

function g(x: i32): i32 {
  if (x) > 0 { return 1 } else { return 2 }
  while (x) < 0 { return 3 }
  match (x) + 1 {
    1 => 0
    _ => 2
  }
}

function k(if: i32): i32 {
  if (if) > 0 { return 1 }
  if + 1
}
