// @run
// @log 3
// @hint redundant type annotation: `v` is inferred as `{a: i32, b: i32}`
// The `&` arm of the same continuation test: an object intersection wrapped
// across lines. `parseTypeDecl` reaches AMPERSAND and PIPE through one `peekKind`
// pair, so both were newline-blind together — this pins the ampersand side
// independently of its union sibling.
type Both = { a: i32 }
  & { b: i32 }

const v: Both = { a: 1, b: 2 }
print(v.a + v.b)
