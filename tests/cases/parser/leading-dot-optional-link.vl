// @run
// @log 7
// @log null
// @log 70
// `?.` continues a chain from a new line on exactly the same rule as `.`: the parser looks
// past the NEWLINE run for either token. Each chain is wider than `vl fmt`'s line, so fmt
// keeps it broken and the `?.inner` link really does lead its own line.
//
// The hit reads through and the miss short-circuits to `null`. The `.n` on the line AFTER
// `?.inner` is still guarded: one `?.` guards everything to its right, newline or not, so
// the miss is `null` rather than a read through null.
type Inner = { n: i32 }
type Box = { inner: Inner }

function firstOrNull(self: Box[]): Box | null {
  if self.length == 0 { return null }
  self[0]
}

const boxes: Box[] = [{ inner: { n: 7 } }, { inner: { n: 70 } }]

const hit = boxes
  .filter((candidateBox) => candidateBox.inner.n == 7)
  .firstOrNull()
  ?.inner
  .n
print(hit)

const missed = boxes
  .filter((candidateBox) => candidateBox.inner.n == 8)
  .firstOrNull()
  ?.inner
  .n
print(missed)

const last = boxes
  .filter((candidateBox) => candidateBox.inner.n > 7)
  .firstOrNull()
  ?.inner
  .n
print(last)
