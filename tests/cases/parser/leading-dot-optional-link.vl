// @run
// @log 7
// @log null
// `?.` continues a chain from a new line on exactly the same rule as `.` — the
// parser looks past the NEWLINE run for either token. The null-safe semantics are
// untouched by where the link is written: the hit reads through and the miss
// short-circuits to `null`, which is what the two logs distinguish.
type Inner = { n: i32 }
type Box = { inner: Inner | null }

const hit: Box = { inner: { n: 7 } }
const miss: Box = { inner: null }

const a = hit
  .inner
  ?.n
print(a)

const b = miss
  .inner
  ?.n
print(b)
