// @check
// @error-at 13:5 `then` was removed — wrap the branch in braces: `if cond { … }`
// @error-at 14:15 cannot assign string to 'n' of type i32

// The `then` arm recovers LOSSLESSLY, like every other braces-required body: the stranded
// `then` is consumed and the statement after it taken whole, dropping no token and inventing
// none, so the type error two lines down is read off the program the user wrote.

// It is the arm that costs most in an EDITOR: someone types `then` from another language, and
// a parse error that suppresses the checker takes every other squiggle in the file with it.
// `recovered-body-still-typechecks.vl` is the same payoff for the unbraced arm, and
// `unbraced-body-no-recovery.vl` the other side — a recovery that DROPS tokens suppresses.
const c = true
if c then print(1)
const n: i32 = "hi"
print(n)
