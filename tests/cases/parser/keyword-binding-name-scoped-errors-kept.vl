// @check
// @error-at 11:11 `if` is a keyword and can't name a parameter — rename it
// @error-at 12:12 `function` is a keyword and can't name a parameter — rename it
// @error-at 13:12 `await` is a keyword and can't name a parameter — rename it
// @error-at 16:12 anonymous functions use arrow syntax `(params) => body`, not `function(...)`
// @error-at 17:12 expected an expression but found AWAIT
// @error-at 18:12 expected `{` but found end of line
// @error-at 24:0 expected `}` but found end of input
// A recovered keyword name does not outlive its function (D3069), so the genuine errors in `g`
// keep their own words: an `if` whose `{` is on the next line, a `function(...)` expression and
// an `await` all report exactly what they report with no misnamed parameter before them.
function f(if: i32): i32 { if + 1 }
function f2(function: i32): i32 { function + 1 }
function f3(await: i32): i32 { await + 1 }

function g(x: i32): i32 {
  const h = function(y: i32) { y }
  const v = await (x)
  if (x > 0)
  {
    return 1
  }
  0
}
