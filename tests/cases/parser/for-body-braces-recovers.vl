// @check
// @error-at 7:16 a `for` body requires braces: `for v in … { … }`
// @error-at 8:23 a `for` body requires braces: `for v in … { … }`
// @error-at 10:11 a `for` body requires braces: `for v in … { … }`
// A `for` body requires braces in BOTH forms `parseFor` builds — the numeric
// range (with or without a `step`) and the for-in over an iterable — and each
// unbraced body costs exactly one diagnostic.
for i in 0 to 3 print(i)
for i in 0 to 6 step 2 print(i)
const a = [1, 2]
for v in a print(v)
