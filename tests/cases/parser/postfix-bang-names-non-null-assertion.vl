// @check
// @error-at 16:13 VL has no postfix `!` (non-null assertion); narrow with `if x != null { … }` (or `if xs.length > 0 { … }` before a `pop()`), or give a default with `??`
// @error-at 17:13 VL has no postfix `!` (non-null assertion)
// @error-at 18:11 VL has no postfix `!` (non-null assertion)
// @error-at 19:13 VL has no postfix `!` (non-null assertion)
// @error-at 20:14 VL has no postfix `!` (non-null assertion)
// @error-at 21:13 VL has no postfix `!` (non-null assertion)
// @error-at 22:3 VL has no postfix `!` (non-null assertion)
// SP-010 (D3555): a TS-style `s!` used to read as a prefix `!` with no operand and report
// the token after it ("expected an expression but found NEWLINE"). Each spelling here names
// the missing operator on the `!` itself, one error apiece, and recovers as the bare operand.
// The prefix `!`, `!=` and `!is` lines below parse as before.
type S = { n: i32 }
function g(s: S | null, k: i32): i32 { k }
function f(s: S | null, y: i32 | null): i32 {
  const ok = !(s == null) && s != null && !(s !is S) && y != 1
  const a = s!
  const b = s!.n
  print(g(s!, 1))
  const c = s! ?? 0
  const d = (s!)
  const e = y! + 1
  y! = 2
  0
}
