// @run
// @log <7>
// @log <2.5>
// @log <true>
// @hint redundant type annotation: `describe` is inferred as `string` — remove it to lean on inference
// The `: string` / `: boolean` return annotations below are DECLARED rather than
// deleted: a fixture for a type feature should read as the documentation it is,
// and the checker calling them redundant is a fact about inference, not about
// the example. (`@hint` is how a corpus file says "yes, on purpose".)
// THE MARQUEE CASE — the bound satisfied by std's REAL `toString`, at three of its
// four arms. This is the one that decides whether the feature is useful rather
// than merely coherent: `std:fmt`'s export is what a user's `Showable` bound will
// actually bind to, and it is not a convenient shape.
//
// Two things about it are load-bearing and neither was assumed:
//
//   · its `self` parameter is a UNION (`i32 | i64 | boolean | f64`), so the
//     satisfaction test has to ask `assignable(T, self)` rather than compare
//     types — `i32` satisfies by being a member of that union;
//   · it carries NO return annotation, so its type is still PENDING when the
//     bound is judged. `witnessOf` forces the callee's inference exactly as
//     `ufcsCallTy` does before comparing the result against the bound's `string`.
//     Without that the bound would be measuring `-2`.
import { toString } from "std:fmt"

type Showable = { toString(): string }

function describe<T: Showable>(x: T): string { "<" + x.toString() + ">" }

print(describe(7))
print(describe(2.5))
print(describe(true))
