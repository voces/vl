// @run
// @log <C><C>
// @hint redundant type annotation: `toString` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `describe` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `twice` is inferred as `string` — remove it to lean on inference
// The `: string` / `: boolean` return annotations below are DECLARED rather than
// deleted: a fixture for a type feature should read as the documentation it is,
// and the checker calling them redundant is a fact about inference, not about
// the example. (`@hint` is how a corpus file says "yes, on purpose".)
// BOUNDS CHAIN THROUGH A NESTED BOUNDED GENERIC, and the reason they can is that
// the relay carries the bound too. `twice<U: Showable>` hands its own `y: U` to
// `describe<T: Showable>`, and the check that licenses it is SUBSUMPTION — does
// `U`'s bound grant what `T`'s bound demands — decided statically at the inner
// call, not deferred to whichever site later makes `U` concrete.
//
// The doc says this falls out for free. It does at EMIT: the inner instantiation
// happens inside the outer instance, where substitution has already run. It did
// NOT fall out at CHECK — see `error-bound-chain-unbounded-relay.vl` for the
// measured hole this closes.
type Circle = { r: f64 }
type Showable = { toString(): string }

function toString(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

function describe<T: Showable>(x: T): string { "<" + x.toString() + ">" }
function twice<U: Showable>(y: U): string { describe(y) + describe(y) }

print(twice({ r: 1.0 }))
