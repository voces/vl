// @run
// @log <C>
// @hint redundant type annotation: `toString` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `describe` is inferred as `string` — remove it to lean on inference
// The `: string` / `: boolean` return annotations below are DECLARED rather than
// deleted: a fixture for a type feature should read as the documentation it is,
// and the checker calling them redundant is a fact about inference, not about
// the example. (`@hint` is how a corpus file says "yes, on purpose".)
// CONSTRAINTS PHASE 1, the doc's own first example (`docs/constraints-design.md`,
// the header ruling block): a named bound whose method member is satisfied by a
// free UFCS `self`-function in scope.
//
// The bound is a CALL SHAPE — the parameters listed are the call's arguments and
// the receiver is implicit, so there is no `self` in the type. That spelling was
// FREE: before this landed, `{ toString(): string }` and `{ toString(self):
// string }` were both parse errors at the `(` in every type position.
//
// What the body's `x.toString()` means is the ruled semantics: "this call
// type-checks with result `string` under the resolution rules every call already
// uses". The body resolves it against the BOUND; the witness is chosen at the
// instantiation site and baked by the monomorphizer.
type Circle = { r: f64 }
type Showable = { toString(): string }

function toString(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

function describe<T: Showable>(x: T): string { "<" + x.toString() + ">" }

print(describe({ r: 1.0 }))
