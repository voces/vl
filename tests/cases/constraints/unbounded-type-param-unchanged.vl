// @run
// @log 6
// @log 3
// @log abab
// @log <C>
// @hint redundant type annotation: `toString` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `loose` is inferred as `string` — remove it to lean on inference
// The `: string` / `: boolean` return annotations below are DECLARED rather than
// deleted: a fixture for a type feature should read as the documentation it is,
// and the checker calling them redundant is a fact about inference, not about
// the example. (`@hint` is how a corpus file says "yes, on purpose".)
// THE REFUTATION PIN FOR THE RULING'S OTHER HALF: an UNBOUNDED `<T>` keeps
// exactly today's behaviour, everywhere.
//
// Two things this must keep proving. (1) The implicit OPERATOR machinery is
// untouched — `x + x` on a bare `<T>` still runs at i32, f64 and string, which is
// the `HD_BINOP` derivation the constraints doc §1 measured and OQ-2 deliberately
// left alone (no operator bounds in phase 1). (2) A member CALL on a bare `<T>`
// still resolves through UFCS with no bound in sight, because strict bodies (OQ-5)
// are a property of BOUNDED parameters only: `tpBoundOfName` answers -1 for an
// unbounded one and every consumer takes its pre-existing path.
//
// If a later change makes bounds mandatory or makes an unbounded `<T>` strict,
// this file is what says so out loud.
type Circle = { r: f64 }

function toString(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

function dbl<T>(x: T): T { x + x }
function loose<T>(x: T): string { "<" + x.toString() + ">" }

print(dbl(3))
print(dbl(1.5))
print(dbl("ab"))
print(loose({ r: 1.0 }))
