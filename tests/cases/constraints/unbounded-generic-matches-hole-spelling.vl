// @run
// @log fld
// @log fld
// @log 3
// @log 3
// @hint redundant type annotation: `b` is inferred as `{tag: () => string}` — remove it to lean on inference
// THE RULING, AS A PAIR (owner, 2026-09-03; `docs/constraints-design.md` §7.7): an
// explicit generic `T` functions the same as an inferred one. Each pair below is the
// SAME program written twice, once with `<T>(x: T)` and once with a bare `(x)`, and the
// two lines of every pair must agree — that is the whole property, and it is what a
// fixture can hold that a message assertion cannot.
//
// A member CALL and a bare FIELD READ are the two routes to the rung (D1221 and D1004),
// so both are here. The refusal half lives in
// `error-unbounded-member-unsatisfied-at-call.vl`: an argument missing the member is
// still refused, at the call, in the hole's words.
type Boxed = { tag: () => string }

function callT<T>(x: T): string { x.tag() }
function callHole(x) { x.tag() }

function readT<T>(x: T): i32 { x.n }
function readHole(x) { x.n }

const b: Boxed = { tag: () => "fld" }
print(callT(b))
print(callHole(b))
print(readT({ n: 3 }))
print(readHole({ n: 3 }))
