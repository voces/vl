// @run
// @log <fld>
// @log fld
// @log fld
// @log <fld>
// @log fld
// @hint redundant type annotation: `toString` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `describeU` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `tail` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `wrap` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `viaArg` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `ret` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `{r: f64, toString: () => string}` — remove it to lean on inference
// The `: string` return annotations below are DECLARED rather than deleted: a
// fixture for a dispatch rule should read as the documentation it is, and the
// checker calling them redundant is a fact about inference, not about the example.
//
// FIELD PRECEDENCE SURVIVES A TYPE PARAMETER (silent-class-inventory D1002).
//
// `x.m()` inside `g<T>(x: T)` is decided by `drwWalk` BEFORE monomorphization
// (the pass table's `monomorphize > dispatchRewrite` edge), so the receiver is
// still a type parameter when the decision is made: no struct row resolves, the
// `si < 0` arm reads that as "no field", and a same-named free `self`-function
// takes the call for EVERY instance the generic will ever have. An instantiation
// carrying `m` as a closure FIELD then handed that free function a struct it
// cannot take — `vl check` rc 0 over INVALID WASM here, and a SILENTLY WRONG
// CALLEE (`<C>` for a `fld` field) when the two happened to share a rep.
//
// EVERY LINE BELOW MUST PRINT `fld`, NEVER `C`. That is the whole point: the
// value discriminates WHICH callee ran, so a fixture that only proved the module
// builds would pass on the defect. `tag` stays in scope in every case — deleting
// it is the ablation that makes the program run for the wrong reason.
//
// FIVE DELIVERY POSITIONS, because the decision is one thing and the delivery is
// another: concat, tail expression, `print` argument, call argument, and `return`.
// A closure-field member call lowers per FUNCTION (`exprIsClosure(…, fnIx)`), so
// each instance resolves its own receiver once the rewrite stops pre-empting it.
type Circle = { r: f64 }
type Boxed = { r: f64, toString: () => string }

function toString(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

function describeU<T>(x: T): string { "<" + x.toString() + ">" }
function tail<T>(x: T): string { x.toString() }
function shown<T>(x: T) { print(x.toString()) }
function wrap(s: string): string { "<" + s + ">" }
function viaArg<T>(x: T): string { wrap(x.toString()) }
function ret<T>(x: T): string { return x.toString() }

const b: Boxed = { r: 1.0, toString: () => "fld" }
print(describeU(b))
print(tail(b))
shown(b)
print(viaArg(b))
print(ret(b))
