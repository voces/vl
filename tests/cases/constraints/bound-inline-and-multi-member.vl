// @run
// @log <C:hi>
// @log <C>
// @hint redundant type annotation: `toString` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `describe` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `brief` is inferred as `string` — remove it to lean on inference
// The `: string` / `: boolean` return annotations below are DECLARED rather than
// deleted: a fixture for a type feature should read as the documentation it is,
// and the checker calling them redundant is a fact about inference, not about
// the example. (`@hint` is how a corpus file says "yes, on purpose".)
// TWO SPELLINGS, ONE DECODER. A bound may be a named alias or an inline literal,
// and both reach the identical spelling tree: `parseTypeDecl` banks a bound body
// as one object ANNOTATION on the declaration (`ast.declBound*`) rather than as a
// field list, and `parseTypeAtom` builds the same shape for the inline form. The
// checker has one `boundObjRootOf` and one `boundMembersOf`, not a pair.
//
// A bound may also MIX members: `toString()` is a callability demand (a call must
// work) and `tag` is a layout demand (the value must carry the field). They are
// checked by different rules — the method by call resolution, the field by
// structural assignability — and both are read off the same member list.
type Circle = { r: f64, tag: string }
type Named = { toString(): string, tag: string }

function toString(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

function describe<T: Named>(x: T): string {
  "<" + x.toString() + ":" + x.tag + ">"
}

function brief<T: { toString(): string }>(x: T): string { "<" + x.toString() + ">" }

print(describe({ r: 1.0, tag: "hi" }))
print(brief({ r: 2.0, tag: "no" }))
