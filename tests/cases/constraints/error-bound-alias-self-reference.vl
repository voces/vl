// @check
// @error the bound member `eq` on `U` names a type that does not resolve here — a bound alias body resolves in its OWN scope, so it cannot name `U`. Spell a self-referential member inline: `<U: { eq(U): … }>` (the bound as written is `Eq`)
// @hint redundant type annotation: `eq` is inferred as `boolean` — remove it to lean on inference
// The `: string` / `: boolean` return annotations below are DECLARED rather than
// deleted: a fixture for a type feature should read as the documentation it is,
// and the checker calling them redundant is a fact about inference, not about
// the example. (`@hint` is how a corpus file says "yes, on purpose".)
// THE RULE FOR SELF-REFERENCE, stated by its refusal. A bound's member types are
// ordinary annotations resolved WHERE THE BOUND IS USED, with the function's type
// parameters live — so `type Eq = { eq(T): boolean }` works for a `<T: Eq>` and
// not for a `<U: Eq>`, because the alias body names `T` and this function has no
// `T`.
//
// That is not a coincidence to be tidied away; it is the same rule every other
// annotation in the function's signature follows. Phase 1 adds no `Self` keyword
// and no F-bounded generic bound aliases, so the inline form is the spelling that
// always works, and the message hands it over.
//
// The -1 an unresolved member type would otherwise carry is the reason this is a
// hard refusal rather than a warning: `assignable` reads a negative side as
// "accept anything", so an unresolved bound would silently accept every argument.
type Circle = { r: f64 }
type Eq = { eq(T): boolean }

function eq(self: Circle, other: Circle): boolean { self.r == other.r }

function same<U: Eq>(a: U, b: U): boolean { a.eq(b) }

print(same({ r: 1.0 }, { r: 1.0 }))
