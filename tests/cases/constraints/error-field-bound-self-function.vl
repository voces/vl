// @check
// @error-at 12:6 V does not satisfy `{x:f32}`: no field `x: f32` — a field bound is satisfied only by a stored field; to accept a `x(self: V)` function, bound on `{ x(): f32 }`
// A field bound `{ x: f32 }` is satisfied only by a stored field. A `x(self: V)` function in
// scope does not satisfy it, so the refusal must not offer one as a fix: it names the method
// bound that the function does satisfy (D2093).
type V = new { a: f32 }

function x(self: V) { return self.a * 2.0 }
function useX<T: { x: f32 }>(t: T) { return t.x }

const v: V = { a: 1.5 }
print(x(v))
print(useX(v))
