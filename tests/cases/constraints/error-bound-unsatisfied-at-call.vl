// @check
// @error {s: f64} does not satisfy `Showable`: no `toString(): string` — the bound needs a field of that type or a `toString(self: {s: f64}, …)` function in scope at this call
// @hint redundant type annotation: `toString` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `describe` is inferred as `string` — remove it to lean on inference
// The `: string` / `: boolean` return annotations below are DECLARED rather than
// deleted: a fixture for a type feature should read as the documentation it is,
// and the checker calling them redundant is a fact about inference, not about
// the example. (`@hint` is how a corpus file says "yes, on purpose".)
// THE UNSATISFIED INSTANTIATION — and it is a SOUNDNESS fix, not a nicety.
//
// Before bounds existed this exact program was `vl check`-clean INVALID WASM
// (silent-class-inventory D1001, measured on the 2026-09-01 seed): the first
// instantiation runs, and the second mints an instance whose `x.toString()` was
// already UFCS-rewritten to a `self`-function that cannot take a `{s: f64}`.
// Nothing refused it, because `assignable` answers TRUE for a `TyVar` on either
// side, so the body's own check was vacuous and there was no later one.
//
// The message names the BOUND, the MISSING MEMBER with its declared result, and
// both ways to supply it — the field and the `self`-function — because the author
// has a real choice between them and the compiler knows which are available.
type Circle = { r: f64 }
type Showable = { toString(): string }

function toString(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

function describe<T: Showable>(x: T): string { "<" + x.toString() + ">" }

print(describe({ r: 1.0 }))
print(describe({ s: 2.0 }))
