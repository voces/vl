// @run
// @log true
// @log false
// @hint redundant type annotation: `eq` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `sameAlias` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `sameInline` is inferred as `boolean` — remove it to lean on inference
// The `: string` / `: boolean` return annotations below are DECLARED rather than
// deleted: a fixture for a type feature should read as the documentation it is,
// and the checker calling them redundant is a fact about inference, not about
// the example. (`@hint` is how a corpus file says "yes, on purpose".)
// A BOUND MEMBER THAT TAKES ARGUMENTS, and how a bound refers to the
// instantiation type itself: **by naming the type parameter in scope.** Phase 1
// adds no self-type keyword and no `Self`, because it does not need one — a
// bound's member types are ordinary annotations resolved where the bound is USED,
// and the function's type parameters are live there. `T` in the bound below is the
// same `T` the signature declares.
//
// Both spellings are pinned. The ALIAS form works because the parameter is also
// called `T`, and that is the rule rather than a coincidence: resolution happens
// at the use site with `<T>` in scope. Renaming the parameter to `U` makes the
// alias's `T` an ordinary undeclared type name, which is a loud refusal naming the
// inline spelling as the fix (`error-bound-alias-self-reference.vl`).
//
// F-bounded generic bound aliases (`type Eq<S> = { eq(S): boolean }` with
// `<T: Eq<T>>`) are NOT in phase 1; the inline form covers the same ground.
type Circle = { r: f64 }
type Eq = { eq(T): boolean }

function eq(self: Circle, other: Circle): boolean { self.r == other.r }

function sameAlias<T: Eq>(a: T, b: T): boolean { a.eq(b) }
function sameInline<T: { eq(T): boolean }>(a: T, b: T): boolean { a.eq(b) }

print(sameAlias({ r: 1.0 }, { r: 1.0 }))
print(sameInline({ r: 1.0 }, { r: 2.0 }))
