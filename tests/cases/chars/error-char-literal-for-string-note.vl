// @check
// @error-at 26:20 cannot assign i32 to 's' of type string — a char literal is its i32 code point; use double quotes for a string: "x"
// @error-at 28:7 argument 1: expected string, got i32 — a char literal is its i32 code point; use double quotes for a string: "x"
// @error-at 23:33 return type mismatch: expected string, got i32 — a char literal is its i32 code point; use double quotes for a string: "x"
// @error-at 32:6 cannot assign i32 to string — a char literal is its i32 code point; use double quotes for a string: "x"
// @error-at 25:24 cannot assign i32 to 'plain' of type string
// CONTRACT (must-error): a char literal aimed at a `string` destination explains
// ITSELF. `'x'` IS its i32 code point — that is the design and is not changing —
// but `cannot assign i32 to 's' of type string` names a type the reader never
// wrote and says nothing about the quotes they did. The note is appended by the
// SOURCE FORM (a `CharLit` node), never by the type, so the last line above —
// an ordinary i32 into a string — keeps the plain sentence.
//
// FOUR POSITIONS, because there is no single seam they share: the declaration
// and the write route through `letAssignMsg`, the argument through
// `argMismatchErr`, the return through its own `tErr`. What is shared is the
// sentence (`charLitForStringNote`), which is what would otherwise drift.
//
// NOT COVERED, and deliberately: a char literal NESTED in a composite aimed at a
// string-element destination (`const xs: string[] = ['x']`). There the source
// form of the assigned value is the LIST, the reported types are already
// `i32[]` vs `string[]`, and the note would be attached to the wrong node.
function want(s: string) { print(s) }
function give(): string { return 'x' }
function main() {
  const plain: string = 1
  const s: string = 'x'
  print(plain + s)
  want('x')
  print(give())
  let w = "a"
  print(w)
  w = 'x'
}
main()
