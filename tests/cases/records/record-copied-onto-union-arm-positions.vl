// @run
// @log 1.5
// @log 3
// @log r
// @log 2.5
// @log 5
// @log r
// @log 3.5
// @log 7
// @log r
// @log 4.5
// @log 9
// @log r
// @log 5.5
// @log 11
// @log r
// @log 6.5
// @log 13
// @log r
// @log 7.5
// @log 15
// @log r
// @log 8.5
// @log 17
// @log r
// @log 0
// A record built at its own row (`mk`'s `{v: i32, w: i32, n: string}`) delivered into `R | string` is
// copied onto R's arm field by field, each number widened, then boxed: at a global, a `let`, a
// return, an argument, a name source, an assignment, an if arm and a record field.
type R = { v: f64, w: i64, n: string }
function mk(k: i32) { return { v: k, w: k, n: "r" } }
const own = mk(1)
function show(d: R | string) {
  if d is R { print(d.v / 2); print(d.w); print(d.n) } else { print(d) }
}
const g0: R | string = mk(3)
function letInit() {
  const d: R | string = mk(5)
  show(d)
}
function ret(): R | string { return mk(7) }
function arg() { show(mk(9)) }
function nameSrc() {
  const m = mk(11)
  const d: R | string = m
  show(d)
}
function asg(c: boolean) {
  let d: R | string = "s"
  if c { d = mk(13) }
  show(d)
}
function ifArm(c: boolean): R | string {
  if c { return mk(15) }
  return "no"
}
function fieldOf() {
  const h: { d: R | string } = { d: mk(17) }
  show(h.d)
}
show(g0)
letInit()
show(ret())
arg()
nameSrc()
asg(true)
show(ifArm(true))
fieldOf()
print(own.v / 2)
