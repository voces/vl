// @run
// @log 4
// @log 4
// @log 4
// @warning Unused variable `wm`
// D16965, D16967: a binding holding a join of `null` and a field read of a record built at `J`
// holds that build, so its `?.` read and a `??` over it read the build; and a `??` over the field
// itself, stored from a function so it stays nullable, delivers its default there.
type J = { f: i32 | null }
const m = Map()
m.set("a", { f: 4 })
const wm: {[string]: J} = m
const d = { f: 1 }
const w3 = { k: { x: d } }
w3.k = { x: m.get("a") ?? d }
const kk = if w3.k.x.f == 99 { null } else { w3.k }
print(kk?.x.f ?? 0)
print((kk ?? { x: d }).x.f ?? 0)
const w4 = { k: if d.f == 99 { null } else { { x: { f: 7 } } } }
function put() {
  w4.k = { x: m.get("a") ?? d }
  return 0
}
put()
print((w4.k ?? { x: d }).x.f ?? 0)
