// @run
// @log 7
// @log null
// @log 1
// @log null
// @log 1
// @log null
// @log 0
// @log null
// @log null
// @log null
// @log null
// Q58 position sweep: a `{ f: null }` value legacy stores at `J`'s row, read where a `{ f: null }`
// is wanted, is the variable as it stands (`rowlessReadTyOfVar`): a callback's parameter handed to
// a call, bound by a `let` first, a second callback's, and a module loop's element read.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
print(dA.f ?? 7)
const src = [mk2()]
function show(z: { f: null }) { print(z.f) }
const s = src.filter((y: { f: null }) => {
  show(y)
  return true
})
print(s.length)
const k = src.filter((y: { f: null }) => {
  const w = y
  show(w)
  return true
})
print(k.length)
const s2 = src.filter((y: { f: null }) => {
  show(y)
  return false
})
print(s2.length)
function take(a) {
  const v = a
  print(v.f)
}
take(mk2())
const xs = [mk2()]
xs.push(mk2())
print(xs[1].f)
for y in xs { print(y.f) }
