// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// A fresh binding stored into an annotated container's slot, by index or `push`, takes the
// slot's type; an element read whose value is delivered to an annotated binding is a delivery at
// the element path; a `for` over the binding names no destination (F2, coordinator rulings).
type N = 1 | 2
type Circle = { r: N }
const lv1 = { r: 1 }
const m: {[string]: Circle} = Map()
m["k"] = lv1
print((m["k"] ?? { r: 2 }).r)
const lv2 = [{ r: 1 }]
const ll: Circle[][] = []
ll.push(lv2)
print(ll[0][0].r)
const c = [{ r: 1 }]
const gp: Circle = c[0]
print(gp.r)
const mm = Map()
mm["k"] = { r: 1 }
const g0 = mm["k"] ?? { r: 2 }
const gq: Circle = g0
print(gq.r)
function sink(_x: Circle[]) { }
const d = [{ r: 1 }]
sink(d)
for z in d { print(z.r) }
