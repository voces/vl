// @run
// @log 4
// @log 0
// @log 7
// A record's own `length` field read through a binding narrowed to that record out of a union with
// a list reads the field, as any other field of the arm.
type B = { base: i32, length: i32 }
function size(d: u8[] | B) {
  if d is B { return d.length }
  return 0
}
function sizeOr(d: u8[] | B) {
  if d is B { return d.length + d.base }
  return d.length
}
print(size({ base: 1, length: 4 }))
const bytes: u8[] = []
print(size(bytes))
print(sizeOr({ base: 3, length: 4 }))
