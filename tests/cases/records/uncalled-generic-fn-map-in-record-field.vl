// @run
// @log 1
// @log 2
// @log 1
// @log 3
// A record whose field holds a map of a generic function nothing calls is built at its row, which
// the elaboration pins in place after the row is first asked: at top level, with two entries, two
// records deep, and beside a scalar field.
function id<T>(a: T): T { return a }
const gm = Map()
gm["k"] = id
const gr = { m: gm }
print(gr.m.length)

function id2<T>(a: T): T { return a }
const gm2 = Map()
gm2["a"] = id2
gm2["b"] = id2
const gr2 = { m: gm2 }
print(gr2.m.length)

function id3<T>(a: T): T { return a }
const gm3 = Map()
gm3["k"] = id3
const gr3 = { r: { m: gm3 } }
print(gr3.r.m.length)

function id4<T>(a: T): T { return a }
const gm4 = Map()
gm4["k"] = id4
const gr4 = { m: gm4, n: 3 }
print(gr4.n)
