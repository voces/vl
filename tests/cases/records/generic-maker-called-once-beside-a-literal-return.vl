// @run
// @log 8
// @log null
// A generic maker called once, joined with a literal in an inferred result, is built at the
// join (D17225).
function mk<T>(x: T) { return { f: null, g: x } }
function two() { return [1, 2].length }
function r(m: boolean) {
  if m { return { f: 1, g: 7 } }
  return mk(8)
}
const j = r(two() > 5)
print(j.g)
print(j.f)
