// @emit-error emitProgram: this branch hands over a record whose field types differ from the record the branches join to, and a record is shared rather than converted
// A call returning the module's `s`, a record it did not build, wanted at two differing records,
// is refused rather than copied: a copy would split `s` from the value read through `a` (D17228).
const s = { f: null, g: 7 }
function get() { return s }
function two() { return [1, 2].length }
const a = if two() > 5 { { f: 1, g: 7 } } else { get() }
const b = if two() > 5 { { f: "s", g: 7 } } else { get() }
print(a.f)
print(b.f)
