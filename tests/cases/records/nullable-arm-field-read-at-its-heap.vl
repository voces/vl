// @run
// @log 1
// @log false
// @log 1
// @log 4
// @log 3
// A record field holding a union arm or null is read as that arm: bound, returned and narrowed by
// a guard; and a field read off a parenthesised field read reads as the bare one.
type Q = { o: O | null, k: i32 }
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
type W = { inner: { r: i32 } }
function get(q: Q) { return q.o }
function cnt(q: Q) {
  const x = q.o
  if x != null { return x.n }
  return q.k
}
function guarded(q: Q) {
  if q.o != null { return q.o.n }
  return 0
}
function paren(w: W) { return (w.inner).r }
const q: Q = { o: { n: 1, next: null }, k: 2 }
print(cnt(q))
print(get(q) == null)
print(guarded(q))
print(paren({ inner: { r: 4 } }))
const u: U = { m: 3 }
if u is P { print(u.m) }
