// @run
// @log 8
// @log 2.5
// @log 3
// @log 0
// A nullable record field takes its value as it is: a nullable parameter, a narrowed local, and
// an arm narrowed out of a union of records, which arrives boxed and is unboxed into the field.
type Node = { v: i32, next: Node | null }
type Pt = { x: f64, y: f64 }
type Holder = { p: Pt | null, n: i32 }
type A = { a: i32 }
type B = { b: f64 }
type Slot = { s: A | null }
function cons(v: i32, rest: Node | null): Node { return { v: v, next: rest } }
function hold(p: Pt | null, n: i32): Holder { return { p: p, n: n } }
function moved(h: Holder): Holder {
  const p = h.p
  if p != null { return { p: p, n: h.n + 1 } }
  return hold(null, 0)
}
function pick(u: A | B): Slot {
  if u is A { return { s: u } }
  return { s: null }
}
const l = cons(1, cons(2, null))
const g = moved(hold({ x: 1.5, y: 2.5 }, 4))
print(l.v + (l.next?.v ?? 0) + g.n)
print(g.p?.y ?? 0.0)
print(pick({ a: 3 }).s?.a ?? 0)
print(pick({ b: 1.5 }).s?.a ?? 0)
