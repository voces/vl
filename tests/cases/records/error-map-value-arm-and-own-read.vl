// @check
// @error-at 13:14 {v: i32, next: {e: i32}} is not {v: i32, next: Node | null}
// An un-annotated map's record value also read at its own record keeps that record, so its
// read delivered to a union of records is refused as an annotated map's is (D16869).
type Node = { v: i32, next: Node | null } | { e: i32 }
function sumNode(n: Node | null): i32 {
  if n == null { return 0 }
  if n is { e: i32 } { return n.e * 100 }
  return n.v + sumNode(n.next)
}
function plain(_r: { v: i32, next: { e: i32 } } | null) { return 1 }
const m = Map()
m["k"] = { v: 3, next: { e: 1 } }
print(sumNode(m["k"]))
print(plain(m["k"]))
