// @run
// @log 60
// @log 0
// @log 70
// @log 9
// A record wider than a nullable name's own, written into the name as a valued `if`'s arm, is the
// arm's value: the wider record, whichever arm is taken.
type A = { x: i32 }
type B = { x: i32, y: i32 }
function nb(k: i32): B { return { x: k, y: k * 10 } }
function ifArm(k: i32, c: boolean) {
  let a: A | null = null
  const b = if c { a = nb(k) } else { nb(0) }
  return b.y
}
function elseArm(k: i32, c: boolean) {
  let a: A | null = null
  const b = if c { nb(k) } else { a = nb(k + 1) }
  return b.y
}
print(ifArm(6, true))
print(ifArm(6, false))
print(elseArm(6, false))
print(elseArm(9, true) / 10)
