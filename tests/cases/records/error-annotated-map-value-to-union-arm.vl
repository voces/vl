// @check
// @error-at 12:14 {v: i32, next: {e: i32}} is not {v: i32, next: Node | null}
// An annotated map's record value keeps its declared field types, so it is not a union arm
// whose field differs (field invariance); the un-annotated map adopts the arm (D16866).
type Node = { v: i32, next: Node | null } | { e: i32 }
function sumNode(n: Node | null): i32 {
  if n == null { return 0 }
  return 1
}
const m: {[string]: {v: i32, next: {e: i32}}} = Map()
m["k"] = { v: 3, next: { e: 1 } }
const r = m["k"]
print(sumNode(r))
