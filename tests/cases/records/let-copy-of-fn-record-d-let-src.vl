// @run
// @log 4
// @log 6
// @info `v` is never reassigned; use `const` instead of `let`
// A let copying a record of un-annotated functions, reassigned (D17131):
// the source a let, not a const.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(k: i32) {
  let v = { r: { f: inc0 }, s: { f: dbl } }
  let m = v
  if k > 0 { m = { r: { f: dbl }, s: { f: dbl } } }
  print(v.r.f(3))
  return m
}
print(mk(1).r.f(3))
