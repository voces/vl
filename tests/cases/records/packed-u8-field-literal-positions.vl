// @run
// @log 207
// @log 302
// @log 204
// @log s204
// @log i=205
// @log 201
// @log 206
// @log 207
// @log 208
// @log 203
// @log 216
// Q58 position sweep: a flat record literal whose `u8` field takes a plain integer, the packed
// field truncating it, built as a scalar and a union call argument, a nested call argument, a
// concat operand, an interpolation hole, a return, a let initializer, an if arm, a `??` operand,
// a record field and a constant initializer.
flat type P = { a: u8, c: i32 }
function takeP(p: P) { print(p.a + p.c) }
function takeU(p: P | string) {
  if p is string { print(p) } else { print(p.a + 100) }
}
function id(p: P) { return p }
function show(p: P) { return "\{p.a}" }
function mk(n: i32) { return { a: 200, c: n } }
function ret(): P { return { a: 201, c: 0 } }
function maybe(k: i32): P | null {
  return if k > 0 { { a: 1, c: 1 } } else { null }
}
function go(c: boolean) {
  takeP({ a: 200, c: 7 })
  takeU({ a: 202, c: 0 })
  takeP(id({ a: 203, c: 1 }))
  print("s" + show({ a: 204, c: 0 }))
  const q: P = { a: 205, c: 0 }
  print("i=\{q.a}")
  print(ret().a)
  const l: P = { a: 206, c: 0 }
  print(l.a)
  const k: P = if c { { a: 207, c: 0 } } else { { a: 1, c: 0 } }
  print(k.a)
  print((maybe(0) ?? { a: 208, c: 0 }).a)
  const w = { p: mk(3) }
  print(w.p.a + w.p.c)
}
go(true)
const p: P = { a: 209, c: 7 }
takeP(p)
