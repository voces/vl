// @run
// @log 3
// @log null
// @log 9
// A generic maker called twice at one type argument has one instance, built at the one record
// both calls land on; a write through one result does not reach the other (D17225).
type J = { f: i32 | null, g: i32 }
function mk<T>(x: T) { return { f: null, g: x } }
const j: J = mk(8)
const i: J = mk(9)
j.f = 3
print(j.f)
print(i.f)
print(i.g)
