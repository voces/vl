// @run
// @log 3
// A value `if` inside a function, delivered at a declared record, whose literal arm is taken and
// whose other arm calls a maker joining record literals, is built as that record (D16979).
type J = { a: i32 }
type K = { j: J | null }
function mk(b: boolean) { return if b { { j: { a: 1 } } } else { { j: null } } }
const go = [1].length > 0
function f() {
  const w: K = if !go { mk(go) } else { { j: null } }
  print(w.j?.a ?? 3)
}
f()
