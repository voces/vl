// @run
// @log 1
// @log 2
// @log true
// @log 4
// @log 5
// @log 6
// A record literal of a declared type's shape, which it is stored as, passed where a narrower
// record is wanted: a module binding, a local, one whose fields lead with another name into a
// generic record pattern, an argument built in a loop, and one passed on from a parameter.
type P = { a: i32, b: i32 }
type W = { y: i32, x: boolean }
function getA(r: { a: i32 }): i32 { return r.a }
function getX<T>(r: { x: T }): T { return r.x }
const m = { a: 1, b: 10 }
print(getA(m))
function local(): i32 {
  const l = { a: 2, b: 20 }
  return getA(l)
}
print(local())
const z = { y: 5, x: true }
print(getX(z))
print(getA({ a: 4, b: 40 }))
let sum = 0
for i in [5] {
  const e = { a: i, b: 50 }
  sum = sum + getA(e)
}
print(sum)
function relay(r: { a: i32, b: i32 }): i32 { return getA(r) }
print(relay({ a: 6, b: 60 }))
