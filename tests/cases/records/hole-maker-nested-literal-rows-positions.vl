// @run
// @log 4
// @log 6
// @log 8
// @log 8
// @log 10
// @log 20
// A record literal holding others, built in an instance of an un-annotated maker, finds its inner
// records' rows (D17128): two siblings at two instances, three deep, bound first, beside a scalar
// field, and handed to another hole function.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sib(f) { return { r: { f: f }, s: { g: f } } }
function deep(f) { return { a: { b: { f: f } } } }
function bound(f) {
  const inner = { f: f }
  return { r: inner }
}
function withN(f, n: i32) { return { r: { f: f, n: n }, k: n * 2 } }
function call(o) { return o.s.g(10) }
print(sib(inc0).r.f(3))
print(sib(dbl).s.g(3))
print(deep(inc0).a.b.f(7))
print(bound(dbl).r.f(4))
const w = withN(inc0, 3)
print(w.r.f(w.r.n) + w.k)
print(call(sib(dbl)))
