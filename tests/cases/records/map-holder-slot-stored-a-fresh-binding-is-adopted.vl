// @run
// @log 1
// @log 1
// @log 2
// @log 0
// A map whose slot stores the fresh binding being typed is typed by that binding's typed reads:
// the store carries the binding's value, not another the slot must also hold (D17849).
type N = 1 | 2
const dfl: { r: N } = { r: 2 }
const lv1 = Map()
lv1["k0"] = { r: 1 }
const c = Map()
c["k0"] = lv1
const g0 = c["k0"] ?? Map()
const gp: { r: N } = g0["k0"] ?? dfl
print(gp.r)
const lv3 = Map()
lv3["k0"] = { r: 1 }
const lv2 = Map()
lv2["k0"] = lv3
const c2 = Map()
c2["k0"] = lv2
const h1 = c2["k0"] ?? Map()
const h2 = h1["k0"] ?? Map()
const hp: { r: N } = h2["k0"] ?? dfl
print(hp.r)
function mk() {
  const m1 = Map()
  m1["k0"] = { r: 2 }
  const cc = Map()
  cc["k0"] = m1
  return cc
}
const j0 = mk()["k0"] ?? Map()
const jp: { r: N } = j0["k0"] ?? dfl
print(jp.r)
function mke() {
  const e1 = []
  const ce = Map()
  ce["k0"] = e1
  return ce
}
function rd(m: {[string]: { r: i32 }[]}) { print((m["k0"] ?? []).length) }
rd(mke())
