// @run
// @log 6
// @log 4
// @log 6
// @log 4
// A `let` copying a record of function records through an un-annotated identity call holds that
// record, so a literal reassigned into it joins the source's function sets (D17361).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function id(x) { return x }
function mk(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  let m = id(v)
  if k > 0 { m = { r: { f: dbl }, s: { f: dbl } } }
  return m
}
print(mk(1).r.f(3))
print(mk(0).r.f(3))
function mk2(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  let m = id(v)
  let n = m
  if k > 0 { n = { r: { f: dbl }, s: { f: dbl } } }
  return n
}
print(mk2(1).r.f(3))
print(mk2(0).r.f(3))
