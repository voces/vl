// @run
// @log 4
// @warning Unused variable `wm`
// A `??` default over a read of a map a later round adopts is demanded in that round, through an
// edge the adoption closure does not follow; the re-check budget settles it, and no assertion
// refuses it.
type J = { f: i32 | null }
const m = Map()
m.set("a", { f: 4 })
const wm: {[string]: J} = m
const d = { f: 1 }
const w3 = Map()
w3.set("b", { x: m.get("a") ?? d })
const e = w3.get("b")
if e != null { print(e.x.f ?? 0) }
