// @run
// @log 7
// @log -1
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// A union box narrowed to a record arm, stored into a field typed as that arm (or its nullable),
// is unboxed to the arm's record in each position: a parameter's field, a global's, a nested
// record's, a field reached through a call, inside a loop and inside an `else`.
type A = { a: i32 }
type B = { b: string }
type H = { x: A | null }
type O = { h: H }
function pick(c: boolean): A | B {
  if c { return { a: 7 } }
  return { b: "s" }
}
function holder() { return { x: null } }
function param(h: H, u: A | B) {
  if u is A { h.x = u }
  return h
}
function nested(o: O, u: A | B) {
  if u is A { o.h.x = u }
  return o
}
function viaCall(u: A | B) {
  const h: H = holder()
  if u is A { h.x = u }
  return h
}
function loop(h: H, us: (A | B)[]) {
  for u in us {
    if u is A { h.x = u }
  }
  return h
}
function inElse(h: H, u: A | B) {
  if u is B { print("b") } else { h.x = u }
  return h
}
function show(h: H) { print(h.x?.a ?? -1) }
show(param({ x: null }, pick(true)))
show(param({ x: null }, pick(false)))
show(nested({ h: { x: null } }, pick(true)).h)
show(viaCall(pick(true)))
show(loop({ x: null }, [pick(false), pick(true)]))
show(inElse({ x: null }, pick(true)))
const g: H = { x: null }
const u = pick(true)
if u is A { g.x = u }
show(g)
