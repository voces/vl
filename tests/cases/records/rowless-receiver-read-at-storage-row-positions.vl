// @run
// @log 1
// @log 1
// @log 4
// @log 2
// @log 2
// A record whose own type has no row is held at its storage row, so a field read of it reads that
// row's field by name: one row per position such a receiver is read in.
type J = { r: i32 | null }
function idn<T>(v: T): T { return v }
function d1() { return idn({ r: 1 }) }
function d2() { return idn({ r: 2 }) }
function outer(): J | string { return d2() }
// a top-level binding, beside a union destination of the same call
const v: J | string = d1()
const q1 = d1()
print(q1.r)
if v is J { print(v.r ?? 0) }
// read twice, beside a union return of the same call
const w = outer()
const q2 = d2()
print(q2.r + q2.r)
if w is J { print(w.r ?? 0) }
// inside a function
function inFn() {
  const q = d2()
  print(q.r)
}
inFn()
