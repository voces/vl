// @run
// @log 7
// @log null
// @log 7
// @log null
// @log 8
// @log null
// @log 3
// @log 4
// @log null
// @log 1
// @log 9
// @log null
// @log 7
// One maker delivered at one record from several joins and positions is built there once, with
// no copy per call: every call lands on that record (D17228).
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
function mk1() { return { f: 1, g: 7 } }
function two() { return [1, 2].length }
const a: J = if two() > 5 { { f: 1, g: 7 } } else { mk2() }
print(a.g)
print(a.f)
const b = if two() > 5 { { f: 1, g: 7 } } else { mk2() }
print(b.g)
print(b.f)
function use(j: J) {
  print(j.g + 1)
  print(j.f)
}
use(if two() > 5 { { f: 1, g: 7 } } else { mk2() })
function r(m: boolean): J { return if m { { f: 3, g: 7 } } else { mk2() } }
print(r(true).f ?? 0)
function local(m: boolean) {
  const c = if m { mk2() } else { { f: 4, g: 7 } }
  print(c.f)
}
local(false)
local(true)
const d = if two() > 1 { mk1() } else { mk2() }
print(d.f)
const e = if two() > 1 { { f: 9, g: 7 } } else { mk2() }
print(e.f)
const h = if two() > 5 { mk1() } else { mk2() }
print(h.f)
print(h.g)
