// @run
// @log 1
// @log 4
// @log 4
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @warning Unused variable `wm`
// A record global whose type has a struct row of its own, while its binding stores it at another
// row (`J`'s, through the map default), is held at that storage row: each read in a function is
// the cell as it stands, the map default among them.
type J = { f: i32 | null }
const m = Map()
m.set("a", { f: 4 })
const wm: {[string]: J} = m
const d = { f: 1 }
const w3 = { k: if d.f == 99 { null } else { { x: { f: 7 } } } }
function put(k: string) {
  const t = m.get(k) ?? d
  w3.k = { x: t }
  return 0
}
function asDefault(k: string) {
  const t = m.get(k) ?? d
  return t.f ?? 0
}
function asBinding() {
  const t = d
  return t.f
}
function asField() { return d.f }
function asArg(r) { return r.f }
function asListElem() {
  const xs = [d, d]
  return xs[1].f
}
function asRecField() {
  const w = { x: d }
  return w.x.f
}
put("z")
print(w3.k?.x.f ?? 0)
put("a")
print(w3.k?.x.f ?? 0)
print(asDefault("a"))
print(asDefault("z"))
print(asBinding())
print(asField())
print(asArg(d))
print(asListElem())
print(asRecField())
