// A `.map` whose un-annotated callback returns a record or `null` builds a list whose elements
// may be null, so an element read tests for null instead of asserting a record.
type S = { s: i32 }
const xs = [1, 2]
const v = xs.map((k) => if k > 1 { { s: k } } else { null })
print(v[0] == null)
print(v[0]?.s ?? 50)
print(v[1]?.s ?? 50)
const f = (k: i32) => if k > 1 { { s: k } } else { null }
print(xs.map(f)[0]?.s ?? 51)
function g(k: i32) {
  if k > 1 { return { s: k } }
  return null
}
print(xs.map(g)[0]?.s ?? 52)
const w = v.map((x) => x)
print(w[0]?.s ?? 53)
const y = v[0]
print(y?.s ?? 54)
// @log true
// @log 50
// @log 2
// @log 51
// @log 52
// @log 53
// @log 54
