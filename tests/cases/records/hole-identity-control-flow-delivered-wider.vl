// @run
// @log 1
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// A hole identity whose body holds a branch, a loop or an early return of the parameter adopts
// its literal argument at the wider record its result is delivered to (D17563).
type A = { d: i32 | null }
function br(v) {
  if v.d > 3 { print(1) }
  return v
}
const c1: A = br({ d: 5 })
print(c1.d ?? -1)
function lp(v) {
  let i = 0
  while i < v.d { i = i + 1 }
  return v
}
const c2: A = lp({ d: 5 })
print(c2.d ?? -1)
function early(v) {
  if v.d > 3 { return v }
  return v
}
const c3: A = early({ d: 5 })
print(c3.d ?? -1)
function val(v) { return if v.d > 3 { v } else { v } }
const c4: A = val({ d: 5 })
print(c4.d ?? -1)
function nest(v) {
  if v.d > 3 {
    let i = 0
    while i < v.d { i = i + 1 }
    print(i)
  }
  return v
}
const c5: A = nest({ d: 5 })
print(c5.d ?? -1)
