// @check
// @error-at 17:14 {v: i32, next: {e: i32}} is not {v: i32, next: Node | null}
// A map a function with no declared result hands back is judged as the map it builds: also read
// at its own record, its read delivered to a union of records is refused (D16869).
type Node = { v: i32, next: Node | null } | { e: i32 }
function sumNode(n: Node | null): i32 {
  if n == null { return 0 }
  if n is { e: i32 } { return n.e * 100 }
  return n.v + sumNode(n.next)
}
function plain(_r: { v: i32, next: { e: i32 } } | null) { return 1 }
function mk() {
  const m = Map()
  m["k"] = { v: 3, next: { e: 1 } }
  return m
}
const m = mk()
print(sumNode(m["k"]))
print(plain(m["k"]))
