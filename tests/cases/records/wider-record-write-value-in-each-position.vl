// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// @log 2
// @log 7
// A record wider than a nullable name's own, written into the name under a short circuit and used
// as the value, is the wider record in each position: an argument, a field read, a comparison
// operand, a nested call, under `||`, and inside a `while` condition.
type A = { x: i32 }
type B = { x: i32, y: i32 }
function yOf(q: B) { return q.y }
function twice(q: B) { return yOf(q) * 2 }
let k = 0
function nb(): B {
  k = k + 1
  return { x: k, y: k * 10 }
}
function arg() {
  let b: A | null = null
  return k < 9 && yOf(b = nb()) > 0
}
function field() {
  let b: A | null = null
  return k < 9 && (b = nb()).y > 0
}
function cmp() {
  let b: A | null = null
  return k < 9 && (b = nb()).x == k
}
function nested() {
  let b: A | null = null
  return k < 9 && twice(b = nb()) > 0
}
function orElse() {
  let b: A | null = null
  return k > 99 || yOf(b = nb()) > 0
}
function loop() {
  let b: A | null = null
  let n = 0
  while n < 2 && yOf(b = nb()) < 100 { n = n + 1 }
  return n
}
print(arg())
print(field())
print(cmp())
print(nested())
print(orElse())
print(loop())
print(k)
