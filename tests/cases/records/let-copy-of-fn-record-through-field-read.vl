// @run
// @log 6
// @log 4
// @log 6
// @log 4
// @log 6
// @log 4
// A `let` copying a field of a record (`let m = holder.v`) holds that field's record of function
// records, so a literal reassigned into it, or into a copy of it, joins the field's sets (D17360).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(k: i32) {
  const holder = { v: { r: { f: inc0 }, s: { f: dbl } } }
  let m = holder.v
  if k > 0 { m = { r: { f: dbl }, s: { f: dbl } } }
  return m
}
print(mk(1).r.f(3))
print(mk(0).r.f(3))
function deep(k: i32) {
  const holder = { a: { v: { r: { f: inc0 }, s: { f: dbl } } } }
  let m = holder.a.v
  if k > 0 { m = { r: { f: dbl }, s: { f: dbl } } }
  return m
}
print(deep(1).r.f(3))
print(deep(0).r.f(3))
function chained(k: i32) {
  const holder = { v: { r: { f: inc0 }, s: { f: dbl } } }
  const m = holder.v
  let n = m
  if k > 0 { n = { r: { f: dbl }, s: { f: dbl } } }
  return n
}
print(chained(1).r.f(3))
print(chained(0).r.f(3))
