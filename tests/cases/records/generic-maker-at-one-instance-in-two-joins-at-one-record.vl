// @run
// @log 3
// @log null
// @log 9
// A generic maker's one instance, called in two value joins at one record, is built there; the
// two results stay apart (D17225).
function mk<T>(x: T) { return { f: null, g: x } }
function two() { return [1, 2].length }
const a = if two() > 5 { { f: 1, g: 7 } } else { mk(8) }
const b = if two() > 5 { { f: 2, g: 7 } } else { mk(9) }
a.f = 3
print(a.f)
print(b.f)
print(b.g)
