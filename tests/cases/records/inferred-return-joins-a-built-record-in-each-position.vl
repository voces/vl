// @log 7
// The returns of a function with no written result join a record literal with a record built at
// another row, at each spelling of the built leaf: a maker's call, one in a nested record, one
// bound first, a local literal, a lambda maker, a lambda result, and a value `if` over a maker.
// Each built record is delivered to the inferred result and built at its row (D17224), so the
// maker also used at its own row, the result written, and one maker joined into two results run.
function mk2() { return { f: null, g: 7 } }
const mkL = () => ({ f: null, g: 7 })
function direct(m: boolean) {
  if m { return { f: 1, g: 7 } }
  return mk2()
}
function nested(m: boolean) {
  if m { return { a: { f: 1, g: 7 } } }
  return { a: mk2() }
}
function untyped(m) {
  if m { return { a: { f: 1, g: 7 } } }
  return { a: mk2() }
}
function bound(m: boolean) {
  if m { return { f: 1, g: 7 } }
  const t = mk2()
  return t
}
function local(m: boolean) {
  const t = { f: null, g: 7 }
  if m { return { f: 1, g: 7 } }
  print(t.f)
  return t
}
function viaLambda(m: boolean) {
  if m { return { f: 1, g: 7 } }
  return mkL()
}
const lam = (m: boolean) => {
  if m { return { f: 1, g: 7 } }
  return mk2()
}
function valueIf(m: boolean) {
  return if m { { a: { f: 1, g: 7 } } } else { { a: mk2() } }
}
function other(m: boolean) {
  if m { return { f: "s", g: 7 } }
  return mk2()
}
function written(m: boolean) {
  const t = mk2()
  if m { return { f: 1, g: 7 } }
  t.g = 9
  return t
}
const own = mk2()
print(own.f)
print(direct(false).f)
print(direct(true).f)
print(nested(true).a.g)
print(nested(false).a.f)
print(untyped(true).a.g)
print(bound(false).g)
print(local(false).g)
print(viaLambda(false).f)
print(lam(false).g)
print(valueIf(false).a.g)
print(other(true).f)
print(other(false).f)
const r = direct(false)
r.f = 3
print(r.f)
print(written(false).g)
print(mk2().g)
