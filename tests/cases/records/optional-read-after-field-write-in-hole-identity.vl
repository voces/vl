// @run
// @log 8
// @log 8
// @log 8
// @log 8
// @log 9
// @log 8
// @log x
// @log x
// @log 8
// @log 8
// @log 8
// @log 2
// @log 8
// A `?.` read of a nullable field after a write to it, inside an un-annotated identity instanced
// at the record its result is delivered to: printed, bound, narrowed and added to, at a string
// field, and with the result delivered to a parameter, a return and beside a second field.
type A = { d: i32 | null }
function g(v) {
  v.d = 8
  print(v?.d)
  return v
}
const c: A = g({ d: 5 })
print(c.d ?? -1)
function g2(v) {
  v.d = 8
  const x = v?.d
  print(x ?? 0)
  return v
}
const c2: A = g2({ d: 5 })
print(c2.d ?? -1)
function g3(v) {
  v.d = 8
  const n = v?.d
  if n != null { print(n + 1) }
  return v
}
const c3: A = g3({ d: 5 })
print(c3.d ?? -1)
type B = { d: string | null }
function gs(v) {
  v.d = "x"
  print(v?.d)
  return v
}
const cs: B = gs({ d: "y" })
print(cs.d ?? "-")
function g4(v) {
  v.d = 8
  print(v?.d)
  return v
}
function takes(x: A) { print(x.d ?? -1) }
takes(g4({ d: 5 }))
type E = { d: i32 | null, e: i32 }
function g5(v) {
  v.d = 8
  print(v?.d)
  print(v?.e)
  return v
}
const c5: E = g5({ d: 5, e: 2 })
print(c5.d ?? -1)
