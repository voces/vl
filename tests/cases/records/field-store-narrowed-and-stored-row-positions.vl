// @run
// @log 5
// @log loc
// @log 32
// @log 40
// @log 50
// @log 60
// @log 7
// @log 5
// @log 8
// @log 5
// A field store through a field narrowed to one record member writes that member's record, at each
// receiver position: a parameter, a local, a module binding, a nested field, an element, and after
// an early return. A store into a parameter instanced at a field's stored record writes that row.
type A = { v: i32 }
type B = { s: string, w: i32 }
type W = { h: A | B }
type O = { w: W }
const g: W = { h: { s: "g", w: 1 } }
function viaParam(q: W) {
  if q.h is B { q.h.w = 5 }
  if q.h is B { print(q.h.w) }
}
function viaLocal(q: W) {
  const k = q
  if k.h is B { k.h.s = "loc" }
  if k.h is B { print(k.h.s) }
}
function viaNested(o: O) {
  if o.w.h is B { o.w.h.w = o.w.h.w + 30 }
  if o.w.h is B { print(o.w.h.w) }
}
function viaElement(ws: W[]) {
  if ws[0].h is B { ws[0].h.w = 40 }
  if ws[0].h is B { print(ws[0].h.w) }
}
function afterReturn(q: W) {
  if q.h is A { return }
  q.h.w = 50
  print(q.h.w)
}
viaParam({ h: { s: "b", w: 1 } })
viaLocal({ h: { s: "b", w: 1 } })
viaNested({ w: { h: { s: "b", w: 2 } } })
viaElement([{ h: { s: "b", w: 3 } }])
afterReturn({ h: { s: "b", w: 4 } })
if g.h is B { g.h.w = 60 }
if g.h is B { print(g.h.w) }
if g.h is B { g.h = { v: 7 } }
if g.h is A { print(g.h.v) }

type J = { f: i32 | null }
type K = { j: J }
const y = { j: { f: 4 } }
const ks: K[] = [y]
function put(q: { f: i32 }) { q.f = 5 }
function add(q: { f: i32 }, d: i32) { q.f = q.f + d }
put(y.j)
print(ks[0].j.f ?? 0)
add(y.j, 3)
print(ks[0].j.f ?? 0)
const v = y.j
put(v)
print(ks[0].j.f ?? 0)
