// @run
// @log null
// @log null
// A lambda maker's call returned beside a literal is built at the join's record, though a maker
// of the same literal keeps its own; the join's audit reads the build (D17227).
function mk2() { return { f: null, g: 7 } }
const mkL = () => ({ f: null, g: 7 })
function viaLambda(m: boolean) {
  if m { return { f: 1, g: 7 } }
  return mkL()
}
const own = mk2()
print(own.f)
print(viaLambda(false).f)
