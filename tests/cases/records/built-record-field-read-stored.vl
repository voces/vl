// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// D16957: a record literal whose field holds a read of a map built at `J` is built with that
// field's build, and so is the map, list or record field it is stored into; an optional chain, a
// bound `?.` result and a plain read all read the build.
type J = { f: i32 | null }
const m = Map()
m.set("a", { f: 4 })
const wm: {[string]: J} = m
const d = { f: 1 }

const w3 = Map()
w3.set("b", { x: m.get("a") ?? d })
print(w3.get("b")?.x.f ?? 0)
const q = w3.get("b")?.x
print(q?.f ?? 0)

const l3 = [{ x: d }]
l3.push({ x: m.get("a") ?? d })
print(l3[1]?.x.f ?? 0)
print((l3[1] ?? { x: d }).x.f ?? 0)

const h3 = { k: { x: { f: 7 } } }
h3.k = { x: m.get("a") ?? d }
print(h3.k.x.f ?? 0)
