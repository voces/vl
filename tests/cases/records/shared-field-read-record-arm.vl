// @run
// @log 5
// @log true
// @log x
// A field read across record arms whose shared field is a record in one arm and an atom in
// another boxes the record under its arm of the read's union (D16949).
function pick(b: boolean): {f: i32} | {f: {a: boolean}} {
  if b { return { f: 5 } }
  return { f: { a: true } }
}
for b in [true, false] {
  const v = pick(b).f
  if v is i32 { print(v) } else { print(v.a) }
}
function q(b: boolean): {f: i32} | {f: {a: boolean}} | {f: {b: string}} {
  if b { return { f: 5 } }
  return { f: { b: "x" } }
}
const w = q(false).f
if w is i32 { print(w) }
else if w is {a: boolean} { print(w.a) }
else { print(w.b) }
