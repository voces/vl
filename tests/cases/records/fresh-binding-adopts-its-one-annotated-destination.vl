// @run
// @log 1
// @log 1
// @log 11
// @log 1
// @log 2
// @log 1
// @log 2
// A binding holding a fresh literal, never written whole, is built at the one destination
// type its uses name: a record, a scalar, a read before the delivery, a field write inside
// the type, a map store and an inferred function's result (F2, coordinator ruling A).
type N = 1 | 2
type Circle = { r: N }
const lv1 = { r: 1 }
const c1: Circle = lv1
print(c1.r)
const x = 1
const y: N = x
print(y)
const lv2 = { r: 1 }
print(lv2.r + 10)
const c2: Circle = lv2
print(c2.r)
const lv3 = { r: 1 }
const c3: Circle = lv3
lv3.r = 2
print(c3.r)
const cm = Map()
const lv4 = { r: 1 }
cm["k"] = lv4
const box: {[string]: Circle} = cm
print((box["k"] ?? { r: 2 }).r)
function mk() {
  const lv5 = { r: 2 }
  return lv5
}
const c5: Circle = mk()
print(c5.r)
