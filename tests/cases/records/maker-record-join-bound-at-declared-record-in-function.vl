// @run
// @log 1
// @log 5
// @log true
// An un-annotated maker's join of two record literals, built at the declared record a binding in
// a function names, is stored as that record: no union box to unbox (D16972).
type J = { a: i32 }
type K = { j: J | null }
function mk(b: boolean) { return if b { { j: { a: 1 } } } else { { j: null } } }
function f() {
  let v: K = mk(true)
  print(v.j?.a ?? 0)
  v = mk(false)
  const u = v
  print(u.j?.a ?? 5)
  print(u.j == null)
}
f()
