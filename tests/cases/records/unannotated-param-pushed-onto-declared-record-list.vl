// @run
// @log 9
// @log 5
// @log 7
// An un-annotated parameter pushed onto, or set into, a container of a declared record is that
// record, as a binding of it at the record is: each call's fresh literal is built there (D16960).
type J = { f: i32 | null }
function put(ys: J[], q) {
  ys.push(q)
  return 0
}
function putm(m: Map<string, J>, q) {
  m.set("a", q)
  return 0
}
const xs: J[] = [{ f: 4 }]
put(xs, { f: 9 })
put(xs, { f: null })
print(xs[1].f ?? 0)
print(xs[2].f ?? 5)
const m: Map<string, J> = Map()
putm(m, { f: 7 })
print(m.get("a")?.f ?? 0)
