// @run
// @log 3
// @log null
// @log 9
// A generic maker called once, from a function called twice, builds a fresh record per call: a
// write through one result does not reach the other (D17225).
type J = { f: i32 | null, g: i32 }
function mk<T>(x: T) { return { f: null, g: x } }
function outer(u: i32): J { return mk(u) }
const a = outer(8)
const b = outer(9)
a.f = 3
print(a.f)
print(b.f)
print(b.g)
