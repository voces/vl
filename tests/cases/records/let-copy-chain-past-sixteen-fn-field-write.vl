// @run
// @log 6
// @log 4
// @log 6
// @log 4
// A record write through a chain of copies of a binding, 17 and 30 deep, builds at the widening
// the source binding's function fields take: the copy walk has no fixed depth (D17362).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk17(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  const m1 = v
  const m2 = m1
  const m3 = m2
  const m4 = m3
  const m5 = m4
  const m6 = m5
  const m7 = m6
  const m8 = m7
  const m9 = m8
  const m10 = m9
  const m11 = m10
  const m12 = m11
  const m13 = m12
  const m14 = m13
  const m15 = m14
  const m16 = m15
  let m17 = m16
  if k > 0 { m17 = { r: { f: dbl }, s: { f: dbl } } }
  return m17
}
print(mk17(1).r.f(3))
print(mk17(0).r.f(3))
function mk30(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  const m1 = v
  const m2 = m1
  const m3 = m2
  const m4 = m3
  const m5 = m4
  const m6 = m5
  const m7 = m6
  const m8 = m7
  const m9 = m8
  const m10 = m9
  const m11 = m10
  const m12 = m11
  const m13 = m12
  const m14 = m13
  const m15 = m14
  const m16 = m15
  const m17 = m16
  const m18 = m17
  const m19 = m18
  const m20 = m19
  const m21 = m20
  const m22 = m21
  const m23 = m22
  const m24 = m23
  const m25 = m24
  const m26 = m25
  const m27 = m26
  const m28 = m27
  const m29 = m28
  let m30 = m29
  if k > 0 { m30 = { r: { f: dbl }, s: { f: dbl } } }
  return m30
}
print(mk30(1).r.f(3))
print(mk30(0).r.f(3))
