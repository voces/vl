// @run
// @hint redundant type annotation: `va` is inferred as `"a"`
// @hint redundant type annotation: `na` is inferred as `null`
// @log ax
// @log a
// @log ax
// @log true
// @log true
// @log true
// @log ax
// @log true
// A module binding holding a read of a record field typed at a unit, a lone string literal or
// `null`, holds the field's value: added to, printed and compared, annotated or not, and the
// same reads in a function body.
type W = { f: "a" }
const w: W = { f: "a" }
const v = w.f
print(v + "x")
print(v)
const va: "a" = w.f
print(va + "x")
const n = { f: null }
const nv = n.f
print(nv == null)
const na: null = n.f
print(na == null)
const n2 = { f: null, k: 1 }
const nv2 = n2.f
print(nv2 == null && n2.k == 1)
function main() {
  const lw: W = { f: "a" }
  const lv = lw.f
  print(lv + "x")
  const ln = { f: null }
  const lnv = ln.f
  print(lnv == null)
}
main()
