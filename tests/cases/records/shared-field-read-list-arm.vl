// @run
// @log 5
// @log 2
// @log c
// @log 1.5
// A field read across record arms whose shared field is a list in one arm and an atom in another
// boxes the list under its kind's tag (D16951).
function q(b: boolean): {f: i32} | {f: i32[]} {
  if b { return { f: 5 } }
  return { f: [1, 2] }
}
for b in [true, false] {
  const v = q(b).f
  if v is i32 { print(v) } else { print(v.length) }
}
function s(b: boolean): {f: string} | {f: string[]} {
  if b { return { f: "s" } }
  return { f: ["a", "b", "c"] }
}
const w = s(false).f
if w is string { print(w) } else { print(w[2]) }
function t(b: boolean): {f: f64[]} | {f: {a: boolean}} | {f: i32} {
  if b { return { f: [1.5] } }
  return { f: { a: true } }
}
const x = t(true).f
if x is f64[] { print(x[0]) }
else if x is i32 { print(x) }
else { print(x.a) }
