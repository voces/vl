// @run
// @log let none
// @log arg none
// @log ret none
// @log nested none
// @log elem none
// @log asg none
// @log asg 1
// Q58 position sweep: a record whose nullable map field is given an explicit `null`, written as
// its map struct's `ref.null` (`emitOmittedFieldNull`): built as a `let`, an argument, a return, a
// nested record's field, a list element and an assignment's value.
type M = { [string]: i32 }
type R = { m: M | null }
type O = { r: R }
function show(tag: string, r: R) {
  const m = r.m
  if m == null { print(tag + " none") } else { print("\{tag} \{m.length}") }
}
function asLet() {
  const r: R = { m: null }
  show("let", r)
}
function asArg() { show("arg", { m: null }) }
function asRet(): R { return { m: null } }
function asNested() {
  const o: O = { r: { m: null } }
  show("nested", o.r)
}
function asElem() {
  const xs: R[] = [{ m: null }]
  show("elem", xs[0])
}
function asAsg() {
  const full: M = Map()
  full["a"] = 1
  let r: R = { m: full }
  r = { m: null }
  show("asg", r)
  r = { m: full }
  show("asg", r)
}
asLet()
asArg()
show("ret", asRet())
asNested()
asElem()
asAsg()
