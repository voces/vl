// @error-at 7:14 they store field `f` differently (`null` into `i32 | null`), and a record is shared, not copied
// A generic maker at two instances, one delivered at a wider record, is refused: one literal
// cannot be built at two instances' rows (D17874).
type J = { f: i32 | null, g: i32 }
type K = { f: string | null, g: string }
function mk<T>(x: T) { return { f: null, g: x } }
const j: J = mk(8)
const k: K = mk("s")
print(j.g)
print(k.g)
