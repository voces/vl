// @run
// @log null
// @log 7
// A maker's call in a value `if` arm, bound in a function, is built at the join's record (D17226).
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
function local(m: boolean) {
  const c = if m { { f: 4, g: 7 } } else { mk2() }
  print(c.f)
  print(c.g)
}
local(false)
