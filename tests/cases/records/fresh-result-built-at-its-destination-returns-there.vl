// @run
// @log 4
// @log 7
// An un-annotated function whose literal is built at the record its one call delivers it to
// returns that record, directly and through a relay.
type I = { f: i32 }
type J = { f: i32 | null }
function mk() { return { f: 4 } }
const j: J = mk()
print(j.f ?? 0)
function mk2(n: i32) { return { f: n + 6 } }
function relay(n: i32): J { return mk2(n) }
print(relay(1).f ?? 0)
