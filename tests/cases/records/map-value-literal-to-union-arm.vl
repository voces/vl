// @run
// @log 103
// @log 103
// @log 105
// @log 103
// An un-annotated map's record literal, read back and delivered to a union of records, is built
// at the arm it lands on, as a `const` of the literal is (D16866).
type Node = { v: i32, next: Node | null } | { e: i32 }
function sumNode(n: Node | null) {
  if n == null { return 0 }
  if n is { e: i32 } { return n.e * 100 }
  return n.v + sumNode(n.next)
}
function at(n: Node) { return sumNode(n) }
const m = Map()
m["k"] = { v: 3, next: { e: 1 } }
print(sumNode(m["k"]))
const x = m["k"]
if x != null { print(at(x)) }
const deep = Map()
deep["k"] = { v: 3, next: { v: 2, next: { e: 1 } } }
print(sumNode(deep["k"]))
function local() {
  const lm = Map()
  lm["k"] = { v: 3, next: { e: 1 } }
  print(sumNode(lm["k"]))
}
local()
