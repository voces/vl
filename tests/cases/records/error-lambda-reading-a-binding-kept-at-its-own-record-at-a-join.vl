// @error-at 8:9 they store field `f` differently (`null` into `i32 | null`), and a record is shared, not copied
// A lambda returning a binding also kept at its own record is refused at the join, not built
// there: the binding is shared, so a write through the join would break it (D17227).
function mk2() { return { f: null, g: 7 } }
const s = { f: null, g: 7 }
const getL = () => s
function viaLambda(m: boolean) {
  if m { return { f: 1, g: 7 } }
  return getL()
}
const own = mk2()
const t: { f: null, g: i32 } = s
print(own.f)
print(viaLambda(false).f)
print(t.g)
