// Q58 position sweep: a record literal entering a union arm that declares a nullable field it
// omits, the omitted field built as its null, delivered as a scalar and a union call argument, a
// nested call argument, a concat operand, an interpolation hole, a return, a let initializer, an
// if arm, a `??` operand, a record field and a constant initializer.
type Other = { b: i32 }
type O = { q: boolean | null }
type T = Other | O
function isO(t: T) { return t is O }
function takeU(t: T | string) {
  if t is string { print(t) } else { print(t is O) }
}
function id(t: T) { return t }
function show(t: T) { return if t is O { "o" } else { "x" } }
function ret(): T { return {} }
function maybe(k: i32): T | null { return if k > 0 { { b: 1 } } else { null } }
function go(c: boolean) {
  print(isO({}))
  takeU({})
  print(isO(id({})))
  print("s" + show({}))
  const q: T = {}
  print("i=\{isO(q)}")
  print(isO(ret()))
  const l: T = {}
  print(isO(l))
  const k: T = if c { ({}) } else { { b: 2 } }
  print(isO(k))
  print(isO(maybe(0) ?? {}))
  const w: { t: T } = { t: {} }
  print(isO(w.t))
}
go(true)
const c: Other | O = {}
print(c is O)
