// @run
// @log false
// @log 1
// @log 1.5
// @log 2
// @log 7
// @log true
// A lambda's record literal whose list value fills a list-or-boolean field, beside a nullable map
// field written `null`, boxes the list at the field's union type.
const v: () => {f: f32[] | boolean, z: {[string]: i32} | null} = () => ({ f: [1.5], z: null })
print(v().f is boolean)
const r = v().f
if !(r is boolean) {
  print(r.length)
  print(r[0])
}
const u: () => {f: f32[] | boolean | null, z: {[string]: i32} | null} = () => ({ f: [2.5, 3.5], z: null })
const ur = u().f
if ur is f32[] { print(ur.length) }
function makeIt(): () => {f: f32[] | boolean, z: {[string]: i32} | null, n: i32} {
  return () => ({ f: [1.5], z: null, n: 7 })
}
print(makeIt()().n)
print(makeIt()().z == null)
