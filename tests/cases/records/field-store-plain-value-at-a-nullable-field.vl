// @run
// @log zkf
// @log y
// A plain value stored into a nullable field is the value as it is: a string literal into
// `string | null`, an atom into `K | null`, a boolean into `boolean | null`, and a generic's
// `string | null` argument.
type K = "a" | "b"
type R = { s: string | null, k: K | null, f: boolean | null, n: i32 }
function setS(r: R) { r.s = "z" }
function setK(r: R, k: K) { r.k = k }
function setF(r: R, f: boolean) { r.f = f }
function setG<T>(r: R, x: T) { r.s = x }
const r: R = { s: null, k: null, f: null, n: 0 }
setS(r)
setK(r, "b")
setF(r, true)
print(
  (r.s ?? "-")
    + (if r.k == null { "-" } else { "k" })
    + (if r.f == null { "-" } else { "f" }),
)
const v: string | null = "y"
setG(r, v)
print(r.s ?? "-")
