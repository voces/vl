// @run
// @log 2
// @log 3
// @log 4
// @log 5
// A record holding an un-annotated function, stored in an un-annotated map and returned by an
// un-annotated reader, is read at the row the map built it at: an optional call inline, bound
// first, without a default, and inside a function (D17180).
function half(a) { return a / 2.0 }
const m = Map()
m["b"] = { f: half }
function get() { return m["b"] }
print(get()?.f(4) ?? -1.0)
const r = get()
print(r?.f(6) ?? -1.0)
print(get()?.f(8))
function go() { print(get()?.f(10) ?? -1.0) }
go()
