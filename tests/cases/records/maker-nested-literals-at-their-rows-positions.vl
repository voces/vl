// @run
// @log 5
// @log 7
// @log 9
// @log 11
// @log 13
// @log 15
// @log 6
// A maker whose result nests record literals around a function parameter, each literal at the
// row it is stored in and the result at the outer row: read off a binding, an argument, a list
// element, an `if` arm, another literal's field, a returned call, and a sibling beside the nest.
function inc(a) { return a + 1 }
function mk(f) { return { o: { r: { f: f } }, n: 1 } }
function deep(f) { return { a: { b: { c: { f: f } } } } }
function through(x) { return x.o.r.f(4) + x.n }
const q = mk(inc)
print(q.o.r.f(3) + q.n)
print(through(mk(inc)) + 1)
const xs = [mk(inc), mk(inc)]
print(xs[1].o.r.f(7) + xs.length - 1)
const pick = if xs.length > 1 { mk(inc) } else { q }
print(pick.o.r.f(9) + pick.n)
const held = { m: mk(inc), k: 2 }
print(held.m.o.r.f(10) + held.k)
function relay(f) { return mk(f) }
print(relay(inc).o.r.f(13) + relay(inc).n)
print(deep(inc).a.b.c.f(5))
