// @emit-error emitProgram: this branch hands over a record whose field types differ from the record the branches join to, and a record is shared rather than converted — write the branch as an object literal, or give the value the joined type where it is declared
// A function with no written result whose `return`s join a literal with a record `mk2` built at
// another row: the built record would be handed over unconverted, so emit refuses it as it does
// under a written result (D17463, D17224).
function mk2() { return { f: null, g: 7 } }
function pick(m: boolean) {
  if m { return { a: { f: 1, g: 7 } } }
  return { a: mk2() }
}
print(pick(true).a.g)
