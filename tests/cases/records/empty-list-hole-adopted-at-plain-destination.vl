// @run
// @log 0
// @log 0
// @log 1
// @log 1
// An empty list held by a fresh binding is a hole, not its `i32` default, so a destination with
// no narrowing leaf still types it (D17788).
function mk() {
  const lv1 = []
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: { r: i32 }[]}) { print((c["k0"] ?? []).length) }
rd(mk())
const e = []
const es: { r: string }[] = e
print(es.length)
const f = []
function put(xs: { r: i32 }[]) {
  xs.push({ r: 1 })
  print(xs.length)
}
put(f)
function mk2() {
  const lv2 = [[]]
  const c2 = Map()
  c2["k0"] = lv2
  return c2
}
function rd2(c: {[string]: { r: i32 }[][]}) { print((c["k0"] ?? []).length) }
rd2(mk2())
