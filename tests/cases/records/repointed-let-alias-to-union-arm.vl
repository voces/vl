// @run
// @log 103
// @log 105
// @log 103
// An alias of a re-pointed `let` of a record literal, delivered to a union of records, holds
// both literals in one layout (D16867).
type Node = { v: i32, next: Node | null } | { e: i32 }
function sumNode(n: Node | null) {
  if n == null { return 0 }
  if n is { e: i32 } { return n.e * 100 }
  return n.v + sumNode(n.next)
}
const a = { v: 3, next: { e: 1 } }
let b = { v: 3, next: { e: 1 } }
b = a
const v = b
print(sumNode(v))
const c = { v: 3, next: { v: 2, next: { e: 1 } } }
let d = { v: 3, next: { v: 2, next: { e: 1 } } }
d = c
const w = d
print(sumNode(w))
print(sumNode(b))
