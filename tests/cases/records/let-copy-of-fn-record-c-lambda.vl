// @run
// @log 4
// @log 8
// A let copying a record of un-annotated functions, reassigned (D17131):
// the copy reassigned a literal holding a lambda.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  let m = v
  if k > 0 { m = { r: { f: (a: i32) => a + 5 }, s: { f: dbl } } }
  return m
}
print(mk(0).r.f(3))
print(mk(1).r.f(3))
