// @run
// @log nu/x/k/f
// @log i/ns/k/f
// @log q/y/nk/f
// @log i/z/k/nf
// @log nu/ns/nk/nf
// @log true
// An explicit `null` record field is the field's own null, as an omitted one is: a union box with a
// `null` member, `string | null`, a literal union's `K | null`, `boolean | null` (written out of
// layout order), all four at once, and a nullable record field.
type K = "a" | "b"
type R = {
  u: i32 | string | null,
  s: string | null,
  k: K | null,
  f: boolean | null,
  n: i32,
}
type Pt = { x: i32 }
type H = { p: Pt | null, n: i32 }
function mkU(n: i32): R { return { u: null, s: "x", k: "a", f: true, n: n } }
function mkS(n: i32): R { return { u: 1, s: null, k: "b", f: false, n: n } }
function mkK(n: i32): R { return { u: "q", s: "y", k: null, f: true, n: n } }
function mkF(n: i32): R { return { n: n, f: null, k: "a", s: "z", u: 2 } }
function mkAll(n: i32): R {
  return { u: null, s: null, k: null, f: null, n: n }
}
function mkH(n: i32): H { return { p: null, n: n } }
function show(r: R): string {
  const u = r.u
  const us = if u == null { "nu" } else if u is string { u } else { "i" }
  return us
    + "/"
    + (r.s ?? "ns")
    + "/"
    + (if r.k == null { "nk" } else { "k" })
    + "/"
    + (if r.f == null { "nf" } else { "f" })
}
print(show(mkU(1)))
print(show(mkS(2)))
print(show(mkK(3)))
print(show(mkF(4)))
print(show(mkAll(5)))
print(mkH(6).p == null)
