// @run
// @log 5
// @log 0
// @log 2
// @log true
// @log 5
// @log -1
// @log true
// A shared field read boxes a nested boolean-list arm, nullable or not, under the tag its `is`
// test reads (D16956).
function q(b: boolean): {f: i32} | {f: boolean[][]} {
  if b { return { f: 5 } }
  return { f: [[true], [false, true]] }
}
for b in [true, false] {
  const v = q(b).f
  if v is i32 { print(v) } else { print(v[1].length) }
  if v is boolean[][] { print(v[1][1]) } else { print(0) }
}
function n(k: i32): {f: i32} | {f: boolean[][] | null} {
  if k == 0 { return { f: 5 } }
  if k == 1 { return { f: null } }
  return { f: [[true]] }
}
for k in [0, 1, 2] {
  const v = n(k).f
  if v is i32 { print(v) }
  else if v is boolean[][] { print(v[0][0]) }
  else { print(-1) }
}
