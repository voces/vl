// @run
// @log null
// @log 7
// A maker's call in a value `if` arm, returned at an annotated result, is built at its record (D17226).
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
function r(m: boolean): J { return if m { { f: 3, g: 7 } } else { mk2() } }
const v = r(false)
print(v.f)
print(v.g)
