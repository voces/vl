// @run
// @log 7.5
// @log 7.5
// @log 2.5
// A call through a lambda bound to a name delivers at the lambda's annotated parameter, as a
// named function's does: a map built by stores, a record, and an inferred function's result (F2).
type Circle = { r: f32 }
const lamm = (x: {[string]: Circle}) => x
const c = Map()
c["k"] = { r: 7.5 }
print((lamm(c)["k"] ?? { r: 1.5 }).r)
const lamr = (x: { r: f32 }) => x
const lv = { r: 7.5 }
print(lamr(lv).r)
function mk() {
  const lw = { r: 2.5 }
  return lw
}
print(lamr(mk()).r)
