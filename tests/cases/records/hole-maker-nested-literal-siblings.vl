// @run
// @log 4
// @log 5
// Two sibling records each holding an un-annotated maker's hole parameter, built in the maker's
// instance: the outer record finds both inner rows (D17128).
function inc0(a) { return a + 1 }
function mk(f) { return { r: { f: f }, s: { g: f } } }
print(mk(inc0).r.f(3))
print(mk(inc0).s.g(4))
