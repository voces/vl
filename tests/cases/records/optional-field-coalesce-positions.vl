// @run
// @log 10
// @log 1
// @log s
// @log d
// @log 2
// @log <10>
// @log <4>
// @log [3]
// @log 11
// @log 4
// @log 5
// @log 10
// @log 7
// @log 10
// @log 8
// @log 11
// @log 9
// @log 12
// `p?.f ?? d` over a nullable record whose field is a union box (`i32 | null`, read at a scalar
// result, and `i32 | string | null`, read at a union result) and over a record field (`Q | null`),
// each delivered to a position: a scalar and a union parameter, a nested call, a concat operand, an
// interpolation hole, a `return`, a `let`, an `if` arm, a `??` operand, a record field and module
// scope.
type Q = { v: i32 }
type P = { n: i32 | null, u: i32 | string | null, q: Q | null }
type R = { n: i32 }
function id(x: i32) { return x }
function show(u: i32 | string) {
  if u is i32 { print(u) } else { print(u) }
}
function atScalar(p: P | null) { print(id(p?.n ?? 1)) }
function atUnion(p: P | null) { show(p?.u ?? "d") }
function nested(p: P | null) { print(id(id(p?.n ?? 2))) }
function concat(p: P | null) { print("<" + "\{p?.n ?? 4}" + ">") }
function interp(p: P | null) { print("[\{p?.n ?? 3}]") }
function viaReturn(p: P | null) { return (p?.q ?? { v: 4 }).v }
function viaLet(p: P | null) {
  const v = p?.n ?? 5
  print(v)
}
function ifArm(c: boolean, p: P | null) { print(if c { p?.n ?? 6 } else { 0 }) }
function coalesce(m: Map<string, i32>, p: P | null) {
  print(m["k"] ?? (p?.n ?? 7))
}
function field(p: P | null) {
  const r: R = { n: p?.n ?? 8 }
  print(r.n)
}
function recLet(p: P | null) {
  const q = p?.q ?? { v: 9 }
  print(q.v)
}
const full: P = { n: 10, u: "s", q: { v: 11 } }
const empty: P = { n: null, u: null, q: null }
atScalar(full)
atScalar(null)
atUnion(full)
atUnion(empty)
nested(empty)
concat(full)
concat(null)
interp(empty)
print(viaReturn(full))
print(viaReturn(null))
viaLet(empty)
ifArm(true, full)
coalesce(Map(), empty)
field(full)
field(null)
recLet(full)
recLet(empty)
const g: P | null = empty
print(g?.n ?? 12)
