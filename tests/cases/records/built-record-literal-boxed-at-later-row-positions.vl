// A map's record value whose field becomes `i32 | null` only through a later widening to `J`. The
// literal's field is boxed into its destination's union, at a map set, a field store, a list push
// and an argument, inside a function and at top level.
type J = { f: i32 | null }
function take(m: {[string]: J}) { return m.length }
function viaMapSet() {
  const m = Map()
  m.set("a", { f: 4 })
  const g: {[string]: J} = m
  print(g.length)
  const d = { f: 1 }
  const w = Map()
  w.set("b", { x: m.get("a") ?? d })
  print(w.get("b")?.x.f ?? 0)
}
function viaField() {
  const m = Map()
  m.set("a", { f: 5 })
  const g: {[string]: J} = m
  print(g.length)
  const d = { f: 1 }
  const h = { k: { x: { f: 7 } } }
  h.k = { x: m.get("a") ?? d }
  print(h.k.x.f ?? 0)
}
function viaPush() {
  const m = Map()
  m.set("a", { f: 6 })
  const g: {[string]: J} = m
  print(g.length)
  const d = { f: 1 }
  const ys = [{ x: d }]
  ys.push({ x: m.get("z") ?? d })
  print(ys[1].x.f ?? 0)
}
function viaArgument() {
  const m = Map()
  m.set("a", { f: 8 })
  take(m)
  const d = { f: 1 }
  const w = Map()
  w.set("b", { x: m.get("a") ?? d })
  print(w.get("b")?.x.f ?? 0)
}
viaMapSet() // 1 4
viaField() // 1 5
viaPush() // 1 1
viaArgument() // 8
const tm = Map()
tm.set("a", { f: 9 })
const tg: {[string]: J} = tm
print(tg.length) // 1
const td = { f: 1 }
const tw = Map()
tw.set("b", { x: tm.get("a") ?? td })
print(tw.get("b")?.x.f ?? 0) // 9
