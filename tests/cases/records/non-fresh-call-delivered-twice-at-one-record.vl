// @run
// @log null
// @log 7
// A call handing back a record it did not build, delivered twice at one record, keeps its behaviour:
// the record solve adopts the one binding at that record (D17228).
type J = { f: i32 | null, g: i32 }
const s = { f: null, g: 7 }
function get() { return s }
const x: J = get()
const y: J = get()
print(x.f)
print(y.g)
