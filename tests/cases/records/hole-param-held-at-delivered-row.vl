// @run
// @log 5
// @log 7
// A hole function's parameter, the local it initializes and its result are held at the record
// type the delivery declares them at (D15180), wider than the argument's own type.
type A = { d: i32 | null }
function g(v) {
  const w = v
  return w
}
const c: A = g({ d: 5 })
print(c.d ?? -1)
function h(v) { return v }
const f: A = h({ d: 7 })
print(f.d ?? -1)
