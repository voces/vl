// @run
// @log null
// @log null
// A lambda maker's call as a value `if` arm is built at the join's record beside a maker of
// the same literal kept at its own (D17227).
function mk2() { return { f: null, g: 7 } }
const mkL = () => ({ f: null, g: 7 })
function two() { return [1, 2].length }
const own = mk2()
const v = if two() > 5 { { f: 1, g: 7 } } else { mkL() }
print(own.f)
print(v.f)
