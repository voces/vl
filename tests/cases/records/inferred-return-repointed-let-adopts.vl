// @run
// @log 9
// @log 9
// @log 9
// @log 5
// @hint redundant type annotation: `v` is inferred as `J` — remove it to lean on inference
// @hint redundant type annotation: `w` is inferred as `J` — remove it to lean on inference
// A `let` of a record literal that a function with no declared result re-points and returns is
// built, with every record written to it, at the record its call is delivered to (D16961).
type J = { f: i32 | null }
function g() {
  let r1 = { f: 1 }
  r1 = { f: 9 }
  return r1
}
const v: J = g()
print(v.f ?? 0)
function h() {
  const r0 = { f: 9 }
  let r1 = { f: 1 }
  r1 = r0
  return r1
}
const w: J = h()
print(w.f ?? 0)
function k(c: boolean) {
  let r1 = { f: 1 }
  if c { r1 = { f: 9 } } else { r1 = { f: 5 } }
  return r1
}
const a: J = k(true)
const b: J = k(false)
print(a.f ?? 0)
print(b.f ?? 0)
