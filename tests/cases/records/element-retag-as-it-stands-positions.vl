// @log 1
// An array literal's element that is a record on the element's struct heap at another rep, its
// closure field's signature apart: a maker's result inline, beside a maker of another signature,
// a local read back in a function, and two elements of two makers. Then a record of a declared
// subtype stored into an element and pushed, each at the narrower record's row.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2.5 }
function take(a) { return a.f(3) }
function mk() { return { f: dbl0 } }
function mk2() { return { f: inc0 } }
print(take(mk2()))
print(take([mk2()][0]))
print(take([mk()][0]))
function inner() {
  const one = mk2()
  const ys = [one]
  return take(ys[0])
}
print(inner())
const zs = [mk(), mk()]
print(take(zs[1]))
type A = { x: i32 }
type B = { x: i32, y: i32 }
const b: B = { x: 1, y: 2 }
const as: A[] = [{ x: 0 }]
print((as[0] = b).y)
print(as[0].x)
const more: A[] = []
const b2: B = { x: 3, y: 4 }
more.push(b2)
more.push(b)
print(more[0].x)
print(more[1].x)
