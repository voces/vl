// @run
// @log null
// @log null
// A lambda returning a binding nothing else reads delivers it at the join's record, where the
// binding itself is built (D17227).
function mk2() { return { f: null, g: 7 } }
const s = { f: null, g: 7 }
const getL = () => s
function viaLambda(m: boolean) {
  if m { return { f: 1, g: 7 } }
  return getL()
}
const own = mk2()
print(own.f)
print(viaLambda(false).f)
