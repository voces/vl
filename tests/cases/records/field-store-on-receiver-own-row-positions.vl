// @run
// @log z
// @log 2
// @log 9
// @log 7
// A field store whose receiver is built at a record row other than its type's (a hole parameter
// delivered wider, a record a join widened) writes the field on the receiver's own row.
type B = { d: i32 | null, e: string | null }
function two(v) {
  v.e = "z"
  return v
}
const c5: B = two({ d: 2, e: "y" })
print(c5.e ?? "-")
print(c5.d ?? 0)
function mk2() { return { f: null, g: 7 } }
function bump(m: boolean) {
  return if m { { a: { f: 1, g: 7 } } } else { { a: mk2() } }
}
function written() {
  const t = mk2()
  t.g = 9
  return t.g
}
print(written())
print(bump(false).a.g)
