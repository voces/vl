// @run
// @log 1
// @log 12
// @log 14
// @log true
// @log true
// @log 1
// A kept maker's result, laid out at the wider declared record it is kept at, beside the same
// generic's instance at the record's own type: an element of the call's list bound at the record,
// one read in a function, and a `filter` or `map` callback over a list of the maker's calls.
type Circle = { r: i32 | null }
function keep<T>(xs: T[]): T[] { return xs }
function mk() { return { r: null } }
const kept: Circle = mk()
const own = [{ r: null }]
print(keep(own).length)
const k = keep([mk()])
const c: Circle = k[0]
print(c.r ?? 12)
function inner() {
  const ys = keep([mk()])
  const d: Circle = ys[0]
  return d.r ?? 14
}
print(inner())
const ms = [mk()]
print(ms.filter((y) => y.r == null).length == 1)
print(ms.map((y) => y.r == null)[0])
print(if kept.r == null { 1 } else { 0 })
