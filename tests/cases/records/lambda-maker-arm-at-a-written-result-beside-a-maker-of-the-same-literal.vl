// @run
// @log null
// @log 4
// A lambda maker's call at a written result is built at that record and written there; the
// other maker's record keeps its own row (D17227).
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
const mkL = () => ({ f: null, g: 7 })
function viaLambda(m: boolean): J {
  if m { return { f: 1, g: 7 } }
  return mkL()
}
const own = mk2()
const v = viaLambda(false)
v.f = 4
print(own.f)
print(v.f)
