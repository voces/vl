// @run
// @log 1
// @log 1
// @log 2
// @log 2
// @log true
// @log 3
// @log 3
// A maker's `{ r: null }` result, built at a union member's variant row that stores the field as
// `i32 | null`, delivered where its own type's rep holds the field as `null`: the two reps are one
// struct on one heap, so the value stands as it is. Read as a top-level list element, a function's
// list element, a binding put in a list, a push, an element's field, and a returned list.
type Circle = { r: i32 | null }
type Shape = Circle | i32
function mk() { return { r: null } }
function inFn() {
  const xs = [mk()]
  return xs.length
}
function bound() {
  const a = mk()
  const xs = [a, a]
  return xs.length
}
function pushed() {
  const xs = [mk()]
  xs.push(mk())
  return xs.length
}
function fieldOf() {
  const xs = [mk()]
  return xs[0].r == null
}
function made() { return [mk(), mk(), mk()] }
const top = [mk()]
print(top.length)
print(inFn())
print(bound())
print(pushed())
print(fieldOf())
print(made().length)
const sh: Shape = 3
print(if sh is i32 { sh } else { 0 })
