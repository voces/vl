// @run
// @log 9
// @log 9
// @log 9
// D16958: a literal binding that reaches an adopted list or map through a chain of whole
// assignments, pushes and map sets is demanded in the round its root is, at any chain length.
type J = { f: i32 | null }

function oneLink() {
  const xs = [{ f: 4 }]
  const wx: J[] = xs
  const o = { f: 9 }
  let r = { f: 6 }
  r = o
  xs.push(r)
  print(wx[1].f ?? 0)
}

function fourLinks() {
  const xs = [{ f: 4 }]
  const wx: J[] = xs
  const o3 = { f: 9 }
  let o2 = { f: 7 }
  o2 = o3
  let o = { f: 8 }
  o = o2
  let r = { f: 6 }
  r = o
  xs.push(r)
  print(wx[1].f ?? 0)
}

function assignPushSet() {
  const m = Map()
  m["a"] = [{ f: 4 }]
  const r0 = { f: 9 }
  let r1 = { f: 1 }
  r1 = r0
  const ys = [{ f: 5 }]
  ys.push(r1)
  m["k"] = ys
  const w: { [string]: J[] } = m
  const zs = w["k"] ?? []
  print(zs[1].f ?? 0)
}

oneLink()
fourLinks()
assignPushSet()
