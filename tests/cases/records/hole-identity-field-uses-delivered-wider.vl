// A hole function that reads or writes its parameter's fields, through an alias too, and returns it
// adopts the literal argument at the wider record its result is delivered to (D17047, D17425).
type A = { d: i32 | null }
type B = { d: i32 | null, e: string | null }
function g(v) {
  print(v.d)
  return v
}
const c: A = g({ d: 5 })
print(c.d ?? -1)
function w(v) {
  v.d = 7
  return v
}
const c2: A = w({ d: 5 })
print(c2.d ?? -1)
function rw(v) {
  const x = v.d
  v.d = 9
  print(x)
  return v
}
const c3: A = rw({ d: 4 })
print(c3.d ?? -1)
function alias(v) {
  const u = v
  u.d = 11
  return u
}
const c4: A = alias({ d: 1 })
print(c4.d ?? -1)
function two(v) {
  print(v.d)
  v.e = "z"
  return v
}
const c5: B = two({ d: 2, e: "y" })
print(c5.e ?? "none")
function arg(v) {
  print(v.d + 1)
  return v
}
const c6: A = arg({ d: 20 })
print(c6.d ?? -1)
