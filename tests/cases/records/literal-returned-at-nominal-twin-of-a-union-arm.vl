// @run
// @log 5
// @log 4
// A record literal returned at a nominal twin of a record that is also a union arm is the record
// the body built: both rows are one heap, so the return converts nothing.
type B = { base: i32, length: i32 }
type W = new { base: i32, length: i32 }
function size(d: u8[] | B) {
  if d is B { return d.length }
  return d.length
}
function view(b: B, c: i32): W {
  const x = b.base + 1
  return { base: x, length: c }
}
function len(w: W) { return w.length }
const b: B = { base: 3, length: 4 }
print(len(view(b, 5)))
print(size(b))
