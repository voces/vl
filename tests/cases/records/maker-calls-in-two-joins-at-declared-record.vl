// @run
// @log 1
// @log 3
// @log 1
// Two calls of a maker joining record literals, each an arm of a different value `if` delivered at a
// declared record, beside record-literal arms: the maker is built at that record (D16982).
type J = { a: i32 }
type K = { j: J | null }
function mk(b: boolean) { return if b { { j: { a: 1 } } } else { { j: null } } }
const go = [1].length > 0
const n = [1, 2].length
const v: K = if go { mk(go) } else { { j: null } }
const w: K = if !go { mk(go) } else { { j: null } }
const u: K = if n == 1 { mk(!go) } else if n == 2 { mk(go) } else { { j: null } }
print(v.j?.a ?? 0)
print(w.j?.a ?? 3)
print(u.j?.a ?? 3)
