// @run
// @log 6
// @log 12
// @log 35
// @log 63
// @log 5
// @log 5
// @log 5
// @log 6
// @log none
// @log s
// @log 1
// @log 22
// `o.v ?? d` over a value-union record field, after another operand is already built: the right
// of an operator, a call's later argument, a list element after another, a record literal field
// after another, a scalar and a union result, a parameter and a local receiver.
type R = { v: i32 | null, w: i32 | string | null, n: i32 }
function two(a: i32, b: i32) { return a * 10 + b }
function sum(r: R) { return r.n + (r.v ?? 10) }
function arg(r: R) { return two(r.n * 3, r.v ?? 3) }
function list(r: R) { return [r.n * 2, r.v ?? 5] }
function rec(r: R) { return { a: r.n + 1, b: r.v ?? 6 } }
function union(r: R) {
  const s = r.n * 7
  return [s, r.w ?? "none"]
}
function local() {
  const r: R = { v: null, w: 4, n: 2 }
  return r.n - (r.v ?? 1)
}
const a: R = { v: 5, w: null, n: 1 }
const b: R = { v: null, w: "s", n: 2 }
print(sum(a))
print(sum(b))
print(arg(a))
print(arg(b))
print(list(a)[1])
print(list(b)[1])
print(rec(a).b)
print(rec(b).b)
print(union(a)[1])
print(union(b)[1])
print(local())
print(b.n + (b.v ?? 20))
