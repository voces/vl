// @error cannot assign {r: i32} to 'a' of type {r: N}
// @error cannot assign {r: i32} to 'b' of type {r: 1 | 2 | 3}
// Two element reads delivered at different types name no one type to build the list at (F2).
type N = 1 | 2
const c = [{ r: 1 }]
const a: { r: N } = c[0]
const b: { r: 1 | 2 | 3 } = c[0]
print(a.r + b.r)
