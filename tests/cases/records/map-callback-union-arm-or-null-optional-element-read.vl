// A list mapped to a union arm or `null` reads an element's field past `null` (`v[i]?.s`) at the
// list's nullable variant storage, directly, in a loop and in a function (D16973).
type C = { r: i32 }
type S = { s: i32 }
type U = C | S
const us: U[] = [{ s: 3 }, { r: 4 }]
const v = us.map((e) => if e is S { e } else { null })
print((v[0]?.s ?? 0) + (v[1]?.s ?? 50))
let t = 0
let i = 0
while i < v.length {
  t = t + (v[i]?.s ?? 10)
  i = i + 1
}
print(t)
function first(xs: U[]) {
  const w = xs.map((e) => if e is S { e } else { null })
  return w[0]?.s ?? -1
}
print(first(us))
// @log 53
// @log 13
// @log 3
