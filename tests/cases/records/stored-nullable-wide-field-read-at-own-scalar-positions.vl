// @run
// @log 7
// @log 8
// @log 14
// @log 7
// @log 2.5
// @log 7
// @log 9
// @warning Unused variable `e`
// A record held at a later view's row, where its number field is stored wider and beside `null`
// (`i64 | null`, `f64 | null`), read at its own `i32`: as an argument, a binding, an operand, a
// return and a call argument, inside a function and at top level.
type J = { f: i64 | null }
type F = { f: f64 | null }
function mk2() { return { f: 7 } }
function mk3() { return { f: 2.5 } }
function twice(n: i32) { return n * 2 }
function viaReturn() {
  const o = mk2()
  const d: J = o
  print(d.f ?? 0)
  return o.f + 2
}
const o = mk2()
const d: J = o
print(o.f)
const b = o.f + 1
print(b)
print(twice(o.f))
print(d.f ?? 0)
const p = mk3()
const e: F = p
print(p.f)
print(viaReturn())
