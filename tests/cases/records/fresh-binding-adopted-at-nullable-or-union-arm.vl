// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 2
// A fresh binding delivered to a nullable or a union of records is built at the arm its literal
// belongs to: the non-null arm, or the one member whose fields hold the literal's (D17763).
type N = 1 | 2
type Circle = { r: N }
type Sq = { s: N }
const a1 = { r: 1 }
const c1: Circle | null = a1
print(c1?.r)
const a2 = { r: 1 }
const c2: Circle | Sq = a2
if c2 is Circle { print(c2.r) }
const a3 = { r: 1 }
const c3: Circle | null = a3
print(a3.r)
function take(c: Circle | null) { print(c?.r) }
const a4 = { r: 1 }
take(a4)
const a5 = { r: 1 }
const c5: Circle | null = a5
const d5: Circle = a5
print(d5.r)
const xs = [1, 2]
const ys: (1 | 2)[] | null = xs
if ys != null { print(ys.length) }
