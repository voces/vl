// @run
// @log 12
// @log 12
// @log 34
// @log 34
// @log 12
// @log 46
// A list of records stored at a row spelled `{b, a}` and held whole in a field spelled `{a, b}`,
// each field read off the stored row by name (`a` the tens, `b` the units): through the field, off
// the list itself, a second element, an element bound first, a function over the field, and a loop.
type AB = {b: i32} & {a: i32}
type W = { xs: {a: i32, b: i32}[] }
const q: AB[] = [{ a: 1, b: 2 }, { a: 3, b: 4 }]
const w: W = { xs: q }
print(w.xs[0].a * 10 + w.xs[0].b)
print(q[0].a * 10 + q[0].b)
print(w.xs[1].a * 10 + w.xs[1].b)
const e = w.xs[1]
print(e.a * 10 + e.b)
function viaW(m: W) { return m.xs[0].a * 10 + m.xs[0].b }
print(viaW(w))
let s = 0
for x in w.xs { s = s + x.a * 10 + x.b }
print(s)
