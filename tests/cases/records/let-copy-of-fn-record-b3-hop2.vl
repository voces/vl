// @run
// @log 4
// @log 4
// @log 4
// @log 6
// A let copying a record of un-annotated functions, reassigned (D17131):
// a second copy of the copy.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  let m = v
  let w = m
  if k > 0 { w = { r: { f: dbl }, s: { f: dbl } } }
  print(v.r.f(3))
  return w
}
print(mk(0).r.f(3))
print(mk(1).r.f(3))
