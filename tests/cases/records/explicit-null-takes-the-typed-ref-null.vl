// @run
// @log npxnf
// @log pnxnf
// @log true
// An explicit `null` into a nullable record, list or function field is that field's typed null,
// as an omitted one is; a nullable map field too.
type Pt = { x: i32 }
type H = { p: Pt | null, xs: i32[] | null, f: ((a: i32) => i32) | null, n: i32 }
type M = { m: {[string]: i32} | null, n: i32 }
function mkP(n: i32): H { return { p: null, xs: [1], f: null, n: n } }
function mkX(n: i32): H { return { p: { x: 2 }, xs: null, f: null, n: n } }
function mkM(n: i32): M { return { m: null, n: n } }
function show(h: H) {
  const a = if h.p == null { "np" } else { "p" }
  const b = if h.xs == null { "nx" } else { "x" }
  const c = if h.f == null { "nf" } else { "f" }
  return "\{a}\{b}\{c}"
}
print(show(mkP(1)))
print(show(mkX(2)))
print(mkM(3).m == null)
