// @run
// @hint redundant type annotation: `a` is inferred as `M` — remove it to lean on inference
// @hint redundant type annotation: `gn` is inferred as `M` — remove it to lean on inference
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 5
// @log 3
// @log 3
// @log 3
// The same `M` retagged at each delivery: a call argument, a let, a return, a list element, an if
// arm, a record field, a global initializer and a union argument (D17280).
type Node = { v: i32, next: Node | null }
type M = Node & { v: i32 }
type R = { w: string }
function g(u: Node | R | null) {
  if u is Node { print(u.v) }
}
function mkM(): M { return { v: 3, next: null } }
function take(m: M) { print(m.v) }
function lets() {
  const a: Node = mkM()
  print(a.v)
}
function ret(): Node { return mkM() }
function elems() {
  const xs: Node[] = [mkM()]
  print(xs[0].v)
}
function arm(c: boolean) {
  const a: Node = if c { mkM() } else { { v: 5, next: null } }
  print(a.v)
}
function field() {
  const o: { n: Node } = { n: mkM() }
  print(o.n.v)
}
const gn: Node = mkM()
take(mkM())
lets()
print(ret().v)
elems()
arm(true)
arm(false)
field()
print(gn.v)
g(mkM())
g({ w: "r" })
g(null)
