// @run
// @log 1
// @log 1
// @log 7
// @log 1
// An un-annotated binding of a maker call, the maker built at the declared record its value later
// reaches, holds that record: read at its own type, delivered on, or captured (D16978).
type J = { a: i32 }
type K = { j: J | null }
function mk(b: boolean) { return if b { { j: { a: 1 } } } else { { j: null } } }
const t = mk(true)
const v: K = t
print(v.j?.a ?? 0)
print(t.j?.a ?? 0)
function f() {
  const u = mk(false)
  const w: K = u
  print(w.j?.a ?? 7)
}
f()
function show(k: K) { print(k.j?.a ?? 0) }
show(t)
