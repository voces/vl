// @run
// @log 1
// @log 2
// @log 3
// @log 6
// @log 5
// A record whose row holds its own type, nullable and in a list, read: a field off a literal, off
// a nested field, off a list element, and through a function walking the chain.
type Node = { v: i32, next: Node | null, kids: Node[] }
const leaf: Node = { v: 3, next: null, kids: [] }
const a: Node = { v: 1, next: { v: 2, next: leaf, kids: [] }, kids: [leaf] }
print(a.v)
const b = a.next
if b != null { print(b.v) }
print(a.kids[0].v)
function sum(n: Node | null): i32 {
  if n == null { return 0 }
  return n.v + sum(n.next)
}
print(sum(a))
function kidsPlus(n: Node): i32 { return n.v + n.kids[0].v + 1 }
print(kidsPlus(a))
