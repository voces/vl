// @log 6
// @log 6
// @log 6
// A let copying a record of un-annotated functions, reassigned (D17131):
// a field written through the copy shows in the source, which keeps it once the copy is
// reassigned.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  let m = v
  print(v.r.f(3))
  m.r = { f: dbl }
  print(v.r.f(3))
  if k > 0 { m = { r: { f: inc0 }, s: { f: inc0 } } }
  print(v.r.f(3))
  print(v.s.f(3))
  print(m.r.f(3))
  return m
}
print(mk(1).s.f(3))
print(mk(0).s.f(3))
