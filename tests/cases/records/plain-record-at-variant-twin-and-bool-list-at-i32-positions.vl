// @run
// @log 3
// @log 4
// @log 5
// @log 3
// @log 7
// @log 3
// @log 6
// @log true
// @log 8
// @log false
// A plain record delivered where its row holds the record's union-arm twin, on one heap: a field, a
// call argument, a return, a list element and a nested field. A `boolean[]` built where
// a row holds an `i32[]` instance, both on one backing: a field and a nested field.
type Node = { v: i32, next: Node | null }
type R = { w: string }
type M = Node & { v: i32 }
function show(u: Node | R | null) {
  if u is Node { print(u.v) }
}
function mkM(): M { return { v: 3, next: null } }
function take(n: Node) { print(n.v) }
function back(): Node { return mkM() }
function asField() {
  const o: { n: Node } = { n: mkM() }
  print(o.n.v)
}
function asNested() {
  const o: { p: { n: Node } } = { p: { n: mkM() } }
  print(o.p.n.v + 1)
}
function asElem() {
  const xs: Node[] = [mkM(), mkM()]
  print(xs[1].v + 2)
}
asField()
asNested()
asElem()
take(mkM())
print(back().v + 4)
show(mkM())
show({ w: "r" })

function box(x) {
  const o = { xs: [x] }
  return o.xs
}
function deep(x) {
  const o = { inner: { xs: [x, x] } }
  return o.inner.xs
}
print(box(5)[0] + 1)
print(box(true)[0])
print(deep(7)[1] + 1)
print(deep(false)[1])
