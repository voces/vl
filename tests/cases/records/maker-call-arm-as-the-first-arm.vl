// @run
// @log null
// @log 7
// A maker's call as a value `if`'s first arm is built at the join's record (D17226).
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
function two() { return [1, 2].length }
const e = if two() > 1 { mk2() } else { { f: 9, g: 7 } }
print(e.f)
print(e.g)
