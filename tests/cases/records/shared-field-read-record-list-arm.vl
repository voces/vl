// @run
// @log 5
// @log 4
// @log 5
// @log -1
// @log 9
// @log x
// @log 2
// @log u
// A field read across record arms whose shared field is a list of records in one arm and an atom
// or record in another boxes the list under its list's arm tag, `null` beside it under the null
// tag (D16952).
function q(b: boolean): {f: i32} | {f: {a: i32}[]} {
  if b { return { f: 5 } }
  return { f: [{ a: 9 }, { a: 4 }] }
}
for b in [true, false] {
  const v = q(b).f
  if v is i32 { print(v) } else { print(v[1].a) }
}
function n(k: i32): {f: i32} | {f: {a: i32}[] | null} {
  if k == 0 { return { f: 5 } }
  if k == 1 { return { f: null } }
  return { f: [{ a: 9 }] }
}
for k in [0, 1, 2] {
  const v = n(k).f
  if v is i32 { print(v) } else if v == null { print(-1) } else { print(v[0].a) }
}
function r(b: boolean): {f: {b: string}} | {f: {a: i32, s: string}[]} {
  if b { return { f: { b: "x" } } }
  return { f: [{ a: 1, s: "t" }, { a: 2, s: "u" }] }
}
for b in [true, false] {
  const v = r(b).f
  if v is {b: string} { print(v.b) } else { print(v.length) ; print(v[1].s) }
}
