// @run
// @log 6
// @log 5
// @log 12
// A record of two un-annotated-function records, one field a set its row stores as the set's id
// and one a function its row stores as a closure, built where its row lays it out: a `let` copy
// reassigned under an `if` and returned, read off the call, as another literal's field, and
// through a value `if`.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  let m = v
  if k > 0 { m = { r: { f: dbl }, s: { f: dbl } } }
  return m
}
print(mk(1).r.f(3))
const held = { inner: mk(0), n: 1 }
print(held.inner.r.f(4))
const pick = if held.n > 0 { mk(1) } else { mk(0) }
print(pick.r.f(6))
