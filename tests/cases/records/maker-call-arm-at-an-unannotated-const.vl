// @run
// @log null
// @log 7
// A maker's call in a value `if` arm is built at the record the join holds, with no annotation (D17226).
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
function two() { return [1, 2].length }
const b = if two() > 5 { { f: 1, g: 7 } } else { mk2() }
print(b.f)
print(b.g)
