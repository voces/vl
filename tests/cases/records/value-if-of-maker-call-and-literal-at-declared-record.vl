// @run
// @log 1
// A value `if` delivered at a declared record, one arm calling a maker that joins record literals
// and one a literal, is built as that record: both arms are (D16979).
type J = { a: i32 }
type K = { j: J | null }
function mk(b: boolean) { return if b { { j: { a: 1 } } } else { { j: null } } }
const go = [1].length > 0
const v: K = if go { mk(go) } else { { j: null } }
print(v.j?.a ?? 0)
