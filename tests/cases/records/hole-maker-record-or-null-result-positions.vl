// @run
// @log 4
// @log true
// @log 2
// @log true
// An un-annotated function returning a record or `null` builds its `null` at the record's nullable
// row, whether its record holds a hole maker's parameter or an un-annotated function, and whichever
// arm runs (D17170).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk(f, b: boolean) { return if b { { r: { f: f } } } else { null } }
function get(b: boolean) { return if b { { f: half } } else { null } }
const m = mk(inc0, true)
if m != null { print(m.r.f(3)) }
const n = mk(inc0, false)
print(n == null)
const r = get(true)
print(r?.f(4) ?? -1.0)
print(get(false) == null)
