// @run
// @log 4
// @log 4
// @log 4
// @log c1
// @log h 4
// @log 1
// @log 4
// @log 1
// @log 4
// @warning Container `wm` is written but never read (remove it)
// A record copied into a union's variant row (a map of an unannotated record read beside an
// annotated twin's default, `m.get(k) ?? d`), the copy in each position, one per function.
type H = { f: i32 | null }
type J = { h: H }
function mk() { return { h: { f: 4 } } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
const d: J = { h: { f: 1 } }
function fOf(j) { return j.h.f ?? 0 }
function id(j) { return j }
function arg(k: string) { return fOf(m.get(k) ?? d) }
function nested(k: string) { return fOf(id(m.get(k) ?? d)) }
function concat(k: string) { return "c" + "\{fOf(m.get(k) ?? d)}" }
function hole(k: string) { return "h \{(m.get(k) ?? d).h.f ?? 0}" }
function ret(k: string) { return m.get(k) ?? d }
function init(k: string) {
  const j = m.get(k) ?? d
  return j.h.f ?? 0
}
function field(k: string) {
  const r = { j: m.get(k) ?? d }
  return r.j.h.f ?? 0
}
function arm(k: string, c: boolean) {
  const j = if c { m.get(k) ?? d } else { d }
  return j.h.f ?? 0
}
const top = m.get("a") ?? d
print(top.h.f ?? 0)
print(arg("a"))
print(nested("a"))
print(concat("z"))
print(hole("a"))
print(ret("z").h.f ?? 0)
print(init("a"))
print(field("z"))
print(arm("a", true))
