// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// A hole identity that reads its parameter through `?.` is instanced at the record its literal
// argument is adopted at, so the read is typed as that record stores it (D17426).
type A = { d: i32 | null }
function g(v) {
  print(v?.d)
  return v
}
const c: A = g({ d: 5 })
print(c.d ?? -1)
function take(a: A) { print(a.d ?? -1) }
take(g({ d: 5 }))
function h(v) {
  const z = v?.d
  print(z ?? -2)
  return v
}
const e: A = h({ d: 5 })
print(e.d ?? -1)
