// @log 1
// @log 2
// @log 1
// @log 2
// @log 1
// @log 2
// @log 1
// @log 2
// @log 1
// A typed element read pins a fresh list it reaches through an inferred call result, a generic
// pass-through or an element alias of an enclosing literal, not only through aliases (D17787).
import { reverse } from "std:array"

type N = 1 | 2
function mk() {
  const c = [{ r: 1 }]
  return c
}
function idg<T>(x: T): T { return x }
const d = mk()
const a: { r: N } = d[0]
print(a.r)
const c = [{ r: 2 }]
const e = idg(c)
const b: { r: N } = e[0]
print(b.r)
const lv1 = [[{ r: 1 }]]
const g1 = lv1[0]
const g: { r: N } = g1[0]
print(g.r)
const h = [{ r: 2 }]
const hs: { r: N }[] = idg(h)
print(hs[0].r)
const m = mk()
for x in m {
  const y: { r: N } = x
  print(y.r)
}
const k = mk()
k[0] = { r: 2 }
const z: { r: N } = k[0]
print(z.r)
const lv2 = [{ r: 1 }]
const cs = [lv2]
const rv = reverse([cs])[0]
const r1 = rv[0]
const rr: { r: N } = r1[0]
print(rr.r)
const mm = Map()
mm["k"] = { r: 2 }
const ml = [mm]
const dfl: { r: N } = { r: 1 }
const mr: { r: N } = ml[0]["k"] ?? dfl
print(mr.r)
function mkm() {
  const q = Map()
  q["k"] = { r: 1 }
  return q
}
const mq: { r: N } = mkm()["k"] ?? dfl
print(mq.r)
