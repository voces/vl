// @run
// @log 4
// @log 4
// @warning Unused variable `wm`
// D16964: a record holding a read of a map built at `J`, stored into a nullable record field
// whose initialiser is a join, is built at that field's record and read back at it.
type J = { f: i32 | null }
const m = Map()
m.set("a", { f: 4 })
const wm: {[string]: J} = m
const d = { f: 1 }
const w3 = { k: if d.f == 99 { null } else { { x: { f: 7 } } } }
function put() {
  w3.k = { x: m.get("a") ?? d }
  return 0
}
put()
print(w3.k?.x.f ?? 0)
const k = w3.k
if k != null { print(k.x.f ?? 0) }
