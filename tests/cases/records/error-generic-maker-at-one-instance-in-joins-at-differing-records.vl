// @error-at 6:49 they store field `f` differently (`null` into `i32 | null`), and a record is shared, not copied
// @error-at 7:51 they store field `f` differently (`null` into `string | null`), and a record is shared, not copied
// A generic maker's one instance delivered at two differing records is refused, not copied:
// no converting copy of an instance is lowered (D17874).
function mk<T>(x: T) { return { f: null, g: x } }
function two() { return [1, 2].length }
const a = if two() > 5 { { f: 1, g: 7 } } else { mk(8) }
const b = if two() > 5 { { f: "s", g: 7 } } else { mk(9) }
print(a.f)
print(b.f)
print(b.g)
