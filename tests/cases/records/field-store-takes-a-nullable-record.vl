// @run
// @log 2.5
// @log 3.5
// @log 4.5
// @log 2
// @log 5
// A nullable record field stores its value as it is, for a plain record (`Pt | null`) and a union
// arm (`O | null`): a nullable parameter, a narrowed local, and an arm narrowed out of a union, which
// arrives boxed and is unboxed into the field.
type Pt = { x: f64, y: f64 }
type Holder = { p: Pt | null, n: i32 }
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
type Q = { o: O | null }
function setP(h: Holder, p: Pt | null) { h.p = p }
function setNarrow(h: Holder, p: Pt | null) {
  if p != null { h.p = p }
}
function setBoxed(h: Holder, u: Pt | i32) {
  if u is Pt { h.p = u }
}
function setO(q: Q, x: O | null) { q.o = x }
function setArm(q: Q, u: U) {
  if u is O { q.o = u }
}
const h: Holder = { p: null, n: 0 }
setP(h, { x: 1.5, y: 2.5 })
print(h.p?.y ?? 0.0)
setNarrow(h, { x: 3.5, y: 0.0 })
print(h.p?.x ?? 0.0)
setBoxed(h, { x: 4.5, y: 0.0 })
print(h.p?.x ?? 0.0)
const q: Q = { o: null }
const o1: O = { n: 2, next: null }
setO(q, o1)
print(q.o?.n ?? 0)
setArm(q, { n: 5, next: null })
print(q.o?.n ?? 0)
