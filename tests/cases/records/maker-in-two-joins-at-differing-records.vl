// @log null
// A maker delivered in two value joins at differing records is copied where each lands (D17228).
function mk2() { return { f: null, g: 7 } }
function two() { return [1, 2].length }
const a = if two() > 5 { { f: 1, g: 7 } } else { mk2() }
const b = if two() > 5 { { f: "s", g: 7 } } else { mk2() }
print(a.f)
print(b.f)
