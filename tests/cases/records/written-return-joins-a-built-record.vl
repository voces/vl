// @run
// @log null
// @log 1
// @log 7
// @log null
// @log 7
// @log 7
// The returns of a function with a written record result join a literal with a record built at
// another row, from a maker call or a local: both run (D17463's annotated twins). The same joins
// under an inferred result are refused at emit until D17224.
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
function pick(m: boolean): J {
  if m { return { f: 1, g: 7 } }
  return mk2()
}
function local(m: boolean): J {
  const t = { f: null, g: 7 }
  if m { return { f: 1, g: 7 } }
  return t
}
function viaIf(m: boolean) {
  const t = { f: null, g: 7 }
  return if m { { f: 1, g: 7 } } else { t }
}
print(pick(false).f)
print(pick(true).f)
print(pick(false).g)
print(local(false).f)
print(local(true).g)
print(viaIf(false).g)
