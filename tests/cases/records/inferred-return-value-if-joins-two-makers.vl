// @run
// @log null
// @log 7
// @log null
// @log 1
// @log null
// @log 1
// A function with no written result whose value `if` joins two makers' records built at different
// rows, and a lambda maker joined with a literal: each call is delivered to the inferred result
// and built at its row (D17224), with the maker also called at its own row.
function mk2() { return { f: null, g: 7 } }
function mk1() { return { f: 1, g: 7 } }
const mkL = () => ({ f: null, g: 7 })
function twoIf(m: boolean) {
  return if m { mk1() } else { mk2() }
}
function viaLambda(m: boolean) {
  if m { return { f: 1, g: 7 } }
  return mkL()
}
const own = mk2()
print(own.f)
print(twoIf(false).g)
print(twoIf(false).f)
print(twoIf(true).f)
print(viaLambda(false).f)
print(viaLambda(true).f)
