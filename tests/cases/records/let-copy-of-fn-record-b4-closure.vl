// @run
// @log 4
// @log 6
// A let copying a record of un-annotated functions, reassigned (D17131):
// the copy reassigned inside a closure.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  let m = v
  const set = () => {
    m = { r: { f: dbl }, s: { f: dbl } }
  }
  if k > 0 { set() }
  return m
}
print(mk(0).r.f(3))
print(mk(1).r.f(3))
