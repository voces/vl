// @error-at 7:52 they store field `f` differently (`null` into `i32 | null`), and a record is shared, not copied
// A call arm returning a record it did not build, the module's `s`, which is also wanted at its own
// record, is refused by the record solve: only a fresh record is built at the join's (D17226).
type J = { f: i32 | null, g: i32 }
const s = { f: null, g: 7 }
function get() { return s }
function two() { return [1, 2].length }
const j: J = if two() > 5 { { f: 1, g: 7 } } else { get() }
const t: { f: null, g: i32 } = s
print(j.f)
print(t.f)
