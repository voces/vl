// @run
// @log 3
// @log null
// @log 5
// A generic maker's one instance, delivered once at a wider record and once at its own, keeps
// the two results apart (D17225).
type J = { f: i32 | null, g: i32 }
function mk<T>(x: T) { return { f: null, g: x } }
const k = mk(5)
const j: J = mk(8)
j.f = 3
print(j.f)
print(k.f)
print(k.g)
