// A maker delivered in two value joins at one record is built there once (D17228).
function mk2() { return { f: null, g: 7 } }
function mk1() { return { f: 1, g: 7 } }
function a(m: boolean) { return if m { mk1() } else { mk2() } }
const o = if [1].length > 5 { mk1() } else { mk2() }
print(a(false).f)
print(o.f)
