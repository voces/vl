// @run
// @log true
// @log true
// @log true
// @log 3
// A literal delivered at an annotation of its own record type keeps that type's row, even where a
// union arm it is narrower than exists, through a list element and an annotated binding
// (D17738; unfiled: D17738 — filed with the D17728 PR).
function f() {
  const xs: {r: null}[] = [{ r: null }]
  print(xs[0].r == null)
  let q: {r: null} = { r: null }
  q = { r: null }
  print(q.r == null)
}
f()
const ys: {r: null}[] = [{ r: null }]
print(ys[0].r == null)
const c = { r: 3 }
const s: Shape = c
if s is Circle { print(s.r ?? 0) }
type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
