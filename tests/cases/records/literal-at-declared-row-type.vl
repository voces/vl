// @run
// @log 1
// @log t
// @log 3
// @log 0
// A record literal whose source order legacy stashes is built at its destination's record
// type, which names the same struct row as the literal's own: a field the literal holds as a
// plain atom is the destination's nullable one, the same i32. Declared, returned, and returned
// into a nullable result.
type VK = "i32" | "struct" | "list"
type RD = {
  rdKind: VK | null,
  rdNul: i32,
  rdSlot: i32,
  rdSigTok: string,
  rdListElem: string,
  rdAtom: i32,
}
function tok(k: VK | null) { return if k == null { "" } else { "t" } }
function declared(kind: VK, nul: i32, elem: string): RD {
  const d: RD = {
    rdKind: kind,
    rdNul: nul,
    rdSlot: -1,
    rdSigTok: tok(kind),
    rdListElem: elem,
    rdAtom: 0,
  }
  return d
}
function returned(kind: VK, elem: string): RD {
  return {
    rdKind: kind,
    rdNul: 2,
    rdSlot: -1,
    rdSigTok: tok(kind),
    rdListElem: elem,
    rdAtom: 0,
  }
}
function maybe(kind: VK, nul: i32): RD | null {
  if nul < 0 { return null }
  return {
    rdKind: kind,
    rdNul: nul,
    rdSlot: -1,
    rdSigTok: tok(kind),
    rdListElem: "",
    rdAtom: 0,
  }
}
print(declared("list", 1, "x").rdNul)
print(returned("i32", "y").rdSigTok)
print(maybe("struct", 3)?.rdNul ?? 0)
print(maybe("struct", -1)?.rdNul ?? 0)
