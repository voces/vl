// @run
// @log 7
// @log null
// A function with no written result whose `return`s join a nested literal with a record `mk2`
// built at another row: the built record is delivered to the inferred result and built at its
// row, as under a written result (D17463, D17224).
function mk2() { return { f: null, g: 7 } }
function pick(m: boolean) {
  if m { return { a: { f: 1, g: 7 } } }
  return { a: mk2() }
}
print(pick(true).a.g)
print(pick(false).a.f)
