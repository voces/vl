// @run
// @log 2
// @log 2
// @log 5
// @log true
// A list literal whose elements differ in a nested record field runs: the checker's join of the
// elements holds a union of records no annotation spells, and its row comes from the literal's
// own type, annotated or not (D16948, D16911).
const v = [{ z: { f: 5 } }, { z: { f: { a: true } } }]
print(v.length)
const w: {z: {f: {a: {a: boolean} | i64}}}[] = [
  { z: { f: { a: 5 as i64 } } },
  { z: { f: { a: { a: true } } } },
]
print(w.length)
for e in v {
  const z = e.z
  if z is {f: i32} { print(z.f) } else { print(z.f.a) }
}
