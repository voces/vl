// @error cannot assign {r: i32} to 'c' of type Circle
// @error cannot assign {r: i32} to '_o' of type Other
// Two different destination types name no one type to build the binding at (F2).
type N = 1 | 2
type Circle = { r: N }
type Other = { r: 1 | 2 | 3 }
const lv1 = { r: 1 }
const c: Circle = lv1
const _o: Other = lv1
print(c.r)
