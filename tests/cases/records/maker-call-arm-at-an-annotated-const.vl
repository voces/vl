// @run
// @log null
// @log 7
// A maker's call in a value `if` arm, delivered at an annotated `const`, is built at its record (D17226).
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
function two() { return [1, 2].length }
const a: J = if two() > 5 { { f: 1, g: 7 } } else { mk2() }
print(a.f)
print(a.g)
