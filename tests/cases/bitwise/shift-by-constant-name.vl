// @run
// @log 1099511627776
// @log 1099511627776
// @log 256
// A shift of two constants is a constant, so `1 << K` is 2^40 and not an `i32` shift whose count
// wraps modulo 32; an `i64` operand shifted by a `const` count below its width is unchanged (D2724).
const K = 40
print(1 << K)
const one: i64 = 1
print(one << K)
const E = 8
function sh(x: i32) { x << E }
print(sh(1))
