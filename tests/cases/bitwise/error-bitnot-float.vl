// @check
// @error operator '~' is integer-only, got f64
// @error operator '~' is integer-only, got f32
// @error operator '~' is integer-only, got f64
// @error unary '~' expects a numeric type, got string
// @error argument 1: operator '~' is integer-only, got f64 (the body of `m` flips this argument's bits)
// @error argument 1: unary '~' expects a numeric type, got string (the body of `m` flips this argument's bits)
// @error argument 1: operator '~' is integer-only, got f64 (the body of `g` flips this argument's bits)
// `~` flips bits and a float has none, the rule the binary bitwise operators already keep. It was
// check-clean invalid wasm over a float, directly, through a type parameter and through an
// un-annotated parameter; and a non-numeric operand's error named `-` (D3629).
function g64(x: f64): f64 { x }
const d = g64(2.5)
const h: f32 = 1.5
print(~d)
print(~h)
print(~(5 as f64))
print(~"x")
function m<T>(a: T): T { ~a }
print(m(2.5))
print(m("x"))
print(m(5))
function g(a) { ~a }
print(g(2.5))
