// @check
// @error shift count 41 is out of range for an i32 operand (0 to 31) — `>>>` would take it modulo 32; widen the operand (`(x as i64) >>> 41`) or give it an i64 destination
// @error shift count 41 is out of range for an i32 operand (0 to 31) — `>>` would take it modulo 32; widen the operand (`(x as i64) >> 41`) or give it an i64 destination
// @error shift count 32 is out of range for an i32 operand (0 to 31) — `<<` would take it modulo 32; widen the operand (`(x as i64) << 32`) or give it an i64 destination
// @error shift count 64 is out of range for an i64 operand (0 to 63) — `>>` would take it modulo 64
// @error shift count 65 is out of range for an i64 operand (0 to 63) — `>>` would take it modulo 64
// A constant count tree past the operand's width is refused where the operand's type is fixed,
// a typed `i32` destination or an `i64` one, and past 63 at any width (D16318, ruling Q8).
const a: i32 = (-3) >>> (40 + 1)
const b: i32 = 0xFFFFFFFF >> (40 + 1)
function f(): i32 { return 0x80000000 << (16 + 16) }
const v: i64 = 0xFFFFFFFF >> (32 + 32)
print(4294967296 >> (60 + 5))
print(a + b + f())
print(v)
