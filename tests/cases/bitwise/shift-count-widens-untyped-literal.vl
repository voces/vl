// @run
// @log 8388607
// @log 4294967295
// @log 0
// @log -9223372036854775808
// @log 1099511627776
// @log 1073741823
// @log -17179869184
// @log 256
// @log 8
// An untyped literal shifted by a constant count of 32 to 63 is an `i64`, a count of 0 to 31
// leaves it `i32`, and a typed or variable count never types the operand (owner ruling Q8,
// D16378).
print((-3) >>> (40 + 1))
print((-3) >>> (16 + 16))
print(0xFFFFFFFF >> (40 + 1))
print(0x80000000 << (16 + 16))
print(1 << 40)
print((-3) >>> (1 + 1))
function typedCount(c: i32) {
  const w: i64 = (0xFFFFFFFF << 31) << c
  print(w)
}
typedCount(3)
function variableCount(c: i64) {
  const w = 1 << c
  print(w)
}
variableCount(40)
function wideCount(c: i64) {
  let x = 1
  x <<= c
  print(x)
}
wideCount(3)
