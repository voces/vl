// @check
// @error shift count 40 is out of range for an i32 operand (0 to 31) — `<<` would take it modulo 32; widen the operand (`(x as i64) << 40`) or give it an i64 destination
// @error shift count 32 is out of range for an i32 operand (0 to 31) — `<<` would take it modulo 32; widen the operand (`(x as i64) << 32`) or give it an i64 destination
// @error shift count 32 is out of range for an i32 operand (0 to 31) — `>>>` would take it modulo 32; widen the operand (`(x as i64) >>> 32`) or give it an i64 destination
// @error shift count 32 is out of range for an i32 operand (0 to 31) — `<<` would take it modulo 32; widen the operand (`(x as i64) << 32`) or give it an i64 destination
// @error shift count 0x80000000 is out of range for an i32 operand (0 to 31) — `<<` would take it modulo 32
// A constant shift count is graded as a literal one is (D2710): a `const` name (D2724), a tree of
// literals (D2725) and a radix count whose top bit is set (D3427) are refused past the width
// rather than taken modulo it.
const K = 40
function a(x: i32): i32 { x << K }
function b(x: i32): i32 { x << (16 + 16) }
function c(x: i32): i32 { x >>> (40 - 8) }
function d(x: i32): i32 { x << (1 << 5) }
function e(x: i32): i32 { x << 0x80000000 }
print(a(1) + b(1) + c(1) + d(1) + e(1))
