// @run
// @log 2147483647
// @log 2147483647
// @log 295
// @log 255
// @log -2
// @log 0
// @log 255

// A radix literal tree under `as% i32` or `as% u8` folds exactly and the cast wraps that value
// (D16494).
print((0xFFFFFFFF / 2) as% i32)
print((0xFFFFFFFF >> 1) as% i32)
print((0xFFFFFFFF % 1000) as% i32)
print((0xFFFFFFFF / 256) as% u8)
print((0xFFFFFFFF * 2) as% i32)
print((0xFFFFFFFF + 1) as% i32)
const c = (0xFFFFFFFF - 0) as% u8
print(c)
