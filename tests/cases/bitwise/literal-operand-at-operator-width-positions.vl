// @run
// @log 8388607
// @log 1099511627779
// @log 1099511627777
// @log 8388607
// @log 1099511627774
// @log s549755813888
// @log h 1
// @log 2199023255552
// @log 1099511627781
// @log 0
// @log 1099511627777
// @log 1099511627783
// A number literal operand built at its operator's wider width (an `i64` shift count, an `i32`
// beside an `i64`), the operation's value in each position, one per function.
const big = 1 << 40
function take(v: i64) { return v }
function maybe(v: i64 | null) { return v ?? 0 }
function arg() { return take(big + 1) }
function unionArg() { return maybe((-3) >>> (40 + 1)) }
function nested() { return take(take(big - 2)) }
function concat() { return "s" + "\{big >> 1}" }
function hole() { return "h \{(-1) >>> 63}" }
function ret() { return big * 2 }
function init() {
  const v = 5 + big
  return v
}
function field() {
  const r = { f: big & 255 }
  return r.f
}
function arm(c: boolean) { return if c { big | 1 } else { 0 } }
function coal(c: boolean) {
  const o = if c { null } else { big - 1 }
  return o ?? (big + 7)
}
print((-3) >>> (40 + 1))
print(big + 3)
print(arg())
print(unionArg())
print(nested())
print(concat())
print(hole())
print(ret())
print(init())
print(field())
print(arm(true))
print(coal(true))
