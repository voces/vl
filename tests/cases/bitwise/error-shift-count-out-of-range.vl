// @check
// @error shift count 32 is out of range for an i32 operand (0 to 31) — `<<` would take it modulo 32; widen the operand (`(x as i64) << 32`) or give it an i64 destination
// @error shift count 40 is out of range for an i32 operand (0 to 31) — `>>>` would take it modulo 32; widen the operand (`(x as i64) >>> 40`) or give it an i64 destination
// @error shift count 64 is out of range for an i64 operand (0 to 63) — `<<` would take it modulo 64
// @error shift count -1 is out of range for an i32 operand (0 to 31) — `>>` would take it modulo 32
// @error constant 1099511627776 overflows i32
// A literal shift count must be below its operand's width, as in Rust and Go: wasm takes the
// count modulo the width, so each of these shifted by something other than what it says (D2710).
// A tree of literals is a constant, exact until its use, so `1 << 40` refuses only because its
// destination is `i32`; `const ok: i64 = 1 << 40` beside it is accepted.
function a(x: i32): i32 { x << 32 }
function b(x: i32): i32 { x >>> 40 }
function c(x: i64): i64 { x << 64 }
function d(x: i32): i32 { x >> -1 }
function e(x: i64): i64 { x << 63 }
const ok: i64 = 1 << 40
const bad: i32 = 1 << 40
print(a(1) + b(1) + d(1) + bad)
print(c(1) + e(1) + ok)
