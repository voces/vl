// @run
// @log 4294967294
// @log 4294967295
// @log 4294967296
// @log 8589934590
// @log 8589934590
// @log -4294967296
// @log 8589934590
// @log 4294967295

// A radix literal tree under `as% i64` folds exactly and the cast applies to that value, the same
// as `as i64`, whatever the operator (D16494).
print((0xFFFFFFFF - 1) as% i64)
print((0xFFFFFFFF / 1) as% i64)
print((0xFFFFFFFF + 1) as% i64)
print((0xFFFFFFFF * 2) as% i64)
print((0xFFFFFFFF << 1) as% i64)
print((~0xFFFFFFFF) as% i64)
const a = (0xFFFFFFFF + 0xFFFFFFFF) as% i64
print(a)
let b = (0xFFFFFFFF | 0) as% i64
b = b + 0
print(b)
