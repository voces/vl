// @run
// @log 86
// @log 1376
// @log 224
// @log 0
// @log 255
// A masked shift whose source is an i64 shift wrapped to i32 reads the high bits it names, with
// and without an outer shift, at every bit the mask keeps.
function hi(y: i64) { return (y >>> 40) as% i32 & 255 }
function hiAt(y: i64) { return ((y >>> 40) as% i32 & 255) << 4 }
function hiMul(y: i64) { return ((y >>> 8) as% i32 & 15) * 16 }
function lo(y: i64) { return (y >>> 0) as% i32 & 1 }
const v = 0x12345678_9abcdef0 as i64
print(hi(v))
print(hiAt(v))
print(hiMul(v))
print(lo(v))
print(hi(-1 as i64))
