// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log true
// @log 0
// @log -4294967296
// @log -4294967296
// @log 65535
// @log -1

// A bitwise operation over a radix pattern whose exact result needs more than 32 bits is a
// different bit pattern at each width, so it is computed at its use's width (D16672): at `i32`
// the pattern `0xFFFFFFFF` is `-1`, and at `i64` the exact result stands.
const v2: i32 = 7
print((-1) ^ 0xFFFFFFFF)
print(0xFFFFFFFF ^ (-1))
print(v2 * ((-1) ^ 0xFFFFFFFF))
print(min(1, (-1) ^ 0xFFFFFFFF))
print(((-1) ^ 0xFFFFFFFF) == 0)
const x: i32 = (-1) ^ 0xFFFFFFFF
print(x)
const y: i64 = (-1) ^ 0xFFFFFFFF
print(y)
let z: i64 = 0
z = (-1) ^ 0xFFFFFFFF
print(z)
print((-1) ^ 0xFFFF0000)
print((-1) & 0xFFFFFFFF)
