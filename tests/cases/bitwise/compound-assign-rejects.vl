// @check
// @error operator '^' is integer-only, got f64 and i32
// @error operator '&' is integer-only, got f64 and i32
// @error operator '|' is integer-only, got f64 and i32
// @error operator '<<' is integer-only, got f64 and i32
// @error operator '>>' is integer-only, got f64 and i32
// @error operator '>>>' is integer-only, got f64 and i32
// @error cannot assign i64 to i32
// @error cannot assign f64 to i32
// @error operator '&' is not defined for boolean and boolean
// @error operator '|' is not defined for string and string
// @error cannot reassign `const` c
// A compound form refuses exactly what its spelled-out `x = x op y` refuses: a float
// operand to a bitwise or shift operator, a result wider than the place (an `i64` count
// shifting an `i32`), `%` of an integer by a float, a non-integer operand, a `const`.
function _refusals() {
  let f = 1.5
  f ^= 2
  f &= 2
  f |= 2
  f <<= 2
  f >>= 2
  f >>>= 2
  let x = 1
  const w: i64 = 3
  x <<= w
  x %= 2.5
  let b = true
  b &= false
  let s = "a"
  s |= "b"
  const c = 3
  c ^= 1
}
