// @run
// @log 6
// @log 7
// @log 15
// @log 271
// @log 1099511627776
// @log 4294967296
// @log 15
// @log 3
// @log 7
// @log 12
// @log 12
// @log 2
// @log -1
// `&= |= ^= <<= >>= >>>= %=` are `x = x op y` with the place named once: the same
// operand types, the same result type and the same wrap. Every place a compound form can
// write is here — a local, a module `let`, a field, an element, a captured variable, an
// `i64` target with an `i64` count, and an `i32` count widening into an `i64` target.
type Reg = { bits: i32, wide: i64, xs: i32[] }
const reg: Reg = { bits: 0xF0, wide: 1, xs: [3, 5, 6] }
let flags = 0

function local() {
  let v = 0xFF
  v &= 0x0F
  v |= 0x30
  v ^= 0x01
  v <<= 2
  v >>= 1
  v >>>= 1
  v %= 7
  v
}

function counter(): () => i32 {
  let c = 1
  return () => {
    c <<= 1
    c ^= 1
    return c
  }
}

function xorAll(xs: i32[]) {
  let acc = 0
  for i in 0 to xs.length - 1 {
    acc ^= xs[i]
    xs[i] <<= 1
  }
  acc
}

print(local())
flags |= 4
flags &= ~1
flags ^= 3
print(flags)
reg.bits >>= 4
print(reg.bits)
reg.bits |= 0x100
print(reg.bits)
reg.wide <<= 40
print(reg.wide)
const eight: i64 = 8
reg.wide >>>= eight
print(reg.wide)
reg.xs[0] ^= 12
print(reg.xs[0])
const k = counter()
print(k())
print(k())
print(xorAll(reg.xs))
print(reg.xs[2])
let m = 17
m %= 5
print(m)
let n = -16
n >>= 4
print(n)
