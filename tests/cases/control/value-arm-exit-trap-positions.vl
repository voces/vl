// An arm that exits (`return`, `break`) inside a value `if` or `match`, whose value the rewrite
// spells as `__trap__()`, and the bare intrinsic bound as a function value: the exit taken, the
// other arm bound, at a `const`, a `let`, an `else if`, a `match` arm, a loop and a message.
// @run
// @log -7
// @log 5
// @log 9
// @log 2
// @log 3
// @log 30
// @log 4
// @log 8
// @log end
function constArm(n: i32) {
  const y = if n == 4 { return -7 } else { null }
  return y ?? 5
}
function letArm(n: i32) {
  let w = if n != 2 { return } else { null }
  w = 9
  print(w ?? 0)
}
function elseIfArm(n: i32) {
  const y = if n == 1 { return 1 } else if n == 2 { n } else { return 3 }
  return y
}
function matchArm(n: i32) {
  const y = match n {
    1 => {
      return 30
    }
    _ => n
  }
  return y
}
function loopArm(xs: i32[]) {
  let last = 0
  for x in xs {
    const y = if x > 3 { break } else { x }
    last = y
  }
  return last
}
const t1 = __trap__
print(constArm(4))
print(constArm(1))
letArm(2)
print(elseIfArm(2))
print(elseIfArm(3))
print(matchArm(1))
print(loopArm([1, 4]) + 3)
if loopArm([8]) > 50 { t1("unreached") } else { print(8) }
print("end")
