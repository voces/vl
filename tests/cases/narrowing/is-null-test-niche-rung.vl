// An `is` test over a nullable niche answers by the niche's own null test: `is null` true for
// null, `is <member>` true for present, over a string, a boolean and a literal union.
type K = "a" | "b"
function sNul(s: string | null) { return if s is null { 1 } else { 0 } }
function sSome(s: string | null) { return if s is string { 1 } else { 0 } }
function bNul(b: boolean | null) { return if b is null { 1 } else { 0 } }
function bSome(b: boolean | null) { return if b is boolean { 1 } else { 0 } }
function kNul(k: K | null) { return if k is null { 1 } else { 0 } }
print(sNul(null))
print(sNul("x"))
print(sSome("x"))
print(sSome(null))
print(bNul(null))
print(bNul(false))
print(bSome(true))
print(bSome(null))
print(kNul(null))
print(kNul("b"))
