// @check
// @warning this `else` can never run (`p` is always `i32`)
// @error operator '+' is not defined for i32 and string
// @error operator '+' is not defined for i32 | string and i32
// D16006(a): only the tested operand reads as `never` in a dead arm; every other name there is
// checked as usual. A live arm is checked at the operand's remainder.
function other(p: i32, q: i32) {
  if p is i32 { print(p + 1) } else { print(q + "!") }
}
function live(p: i32 | string | boolean) {
  if p is boolean { print(1) } else { print(p + 1) }
}
other(4, 5)
live(true)
