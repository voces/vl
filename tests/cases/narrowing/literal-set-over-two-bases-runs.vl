// A literal set over two bases tests each base's members under that base's tag: `is`, a
// negation, a narrowed branch, a list element, a nullable or literal-union operand, an open
// parameter, a set holding `null`, a record field narrowed to such a set, and `as?`/`as!` to
// a literal set (D16326, D16327, D4086).
type K = 1 | "a"
type N = 1 | 2 | null
function mixed(x: i32 | string) { x is 1 | "a" }
print(mixed(1))
print(mixed("a"))
print(mixed(2))
function negated(x: i32 | string) { !(x is K) }
print(negated(1))
print(negated(2))
function branch(x: i32 | string) {
  if x is K { "y" } else { "n" }
}
print(branch(1))
print(branch("b"))
const xs = [1, "a", 2]
for x in xs { print(x is K) }
function orNull(x: i32 | string | null) { x is K }
print(orNull(1))
print(orNull(null))
function lits(x: K | 2) { x is K }
print(lits(1))
print(lits(2))
function open(x) { x is K }
print(open(1))
print(open(3))
function nullable(x: i32 | null) { x is N }
print(nullable(2))
print(nullable(null))
print(nullable(5))
type A = { x: i32 | string }
type B = { x: K }
function field(r: A) { r is B }
print(field({ x: 1 }))
print(field({ x: "b" }))
function cast(x: i32 | string) {
  const k = x as? K
  if k == null { "none" } else { "hit" }
}
print(cast(1))
print(cast(2))
function trapCast(x: i32 | string) { x as! K }
print(trapCast("a"))
function castNull(x: i32 | null) {
  const k = x as? N
  if k == null { 0 } else { 1 }
}
print(castNull(2))
print(castNull(7))
