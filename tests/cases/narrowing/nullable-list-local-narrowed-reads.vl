// @run
// @log 3
// @log 6
// @log 6
// @log -1
// @log 2
// @log 1
// @log 0
// A `T[] | null` local narrowed past its null, by `!= null` and by `is T[]`, read as the list:
// indexed, its length taken and walked. A generic `is f64[]` over an annotated empty list does
// not pass, so its arm does not run.
function first(xs: i32[] | null) {
  if xs != null { return xs[0] + xs.length - 1 }
  return -1
}
function total(xs: i32[] | null) {
  let t = 0
  if xs is i32[] {
    for x in xs { t = t + x }
  }
  return t
}
function size(xs: string[] | null) {
  if xs == null { return -1 }
  return xs.length
}
function fit<V>(v: V[] | null) {
  if v is f64[] { return v.length + 10 }
  return 0
}
print(first([1, 2, 3]))
print(total([1, 2, 3]))
print(total([3, 3]))
print(size(null))
print(size(["a", "b"]))
const e: i32[] = []
print(fit(e) + 1)
print(fit([3]))
