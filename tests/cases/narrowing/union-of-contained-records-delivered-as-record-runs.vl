// @run
// @log 3
// @log 1
// @log 4
// @log 2
// @log 3
// @log 4
// A union of records every member of which a record contains lands in that record's slot
// unboxed, each arm stored at the record's layout: a return, a binding, an argument, a push and
// a field (D16321).
type A = { x: i32 }
type B = { x: 1 | 2 }
type D = { x: 3 | 4 }
type R = { a: A }
function ret(b: B | D): A { return b }
print(ret({ x: 3 }).x)
print(ret({ x: 1 }).x)
function bind(b: B | D) {
  const a: A = b
  return a.x
}
print(bind({ x: 4 }))
function take(a: A) { return a.x }
function arg(b: B | D) { return take(b) }
print(arg({ x: 2 }))
const xs: A[] = []
const b: B | D = { x: 3 }
xs.push(b)
print(xs[0].x)
function field(b: B | D): R { return { a: b } }
print(field({ x: 4 }).a.x)
