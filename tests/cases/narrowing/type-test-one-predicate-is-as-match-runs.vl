// @run
// @log 2
// @log a
// @log 2.5
// @log false
// @log true
// @log A 1
// @log A 3
// @log 3
// @log 4
// @log A
// @log C
// @log A
// @log none
// A type test answers each operand member by one rule in all three spellings: a type parameter
// member is covered by a pattern naming it (D1118), a `| null` union's members are flattened
// (D2677), and a record contains a union of records it covers (D4085).
import { toString } from "std:fmt"

type R = { a: i32 }
type S = { b: i32 }
type U = R | S | null
type A = { x: i32 }
type B = { x: 1 | 2 }
type D = { x: 3 | 4 }
type C = { z: string }
function pick<T>(x: T, y: T | null): T {
  match y {
    T => y
    null => x
  }
}
print(pick(1, 2))
print(pick("a", null))
print(pick(1.5, 2.5))
const v: U = { b: 2 }
print((v as? S) == null)
print((v as? R) == null)
function isA(b: B | D) {
  if b is A { return "A " + b.x.toString() }
  "no"
}
print(isA({ x: 1 }))
print(isA({ x: 3 }))
function asA(b: B | D) {
  const a = b as? A
  if a == null { return 0 }
  a.x
}
print(asA({ x: 3 }))
function matchA(b: B | D): i32 {
  match b {
    A => b.x
  }
}
print(matchA({ x: 4 }))
function part(b: B | C) {
  match b {
    A => "A"
    C => "C"
  }
}
print(part({ x: 2 }))
print(part({ z: "q" }))
function partAs(b: B | C) {
  const a = b as? A
  if a == null { return "none" }
  "A"
}
print(partAs({ x: 1 }))
print(partAs({ z: "q" }))
