// @run
// @log else
// @log not C
// @log true
// @log false
// @log false
// D16370: `is C` over an `A | null` value, where `C` has a field `A` lacks, tests the record and
// not only the null. A `C` value handed to an `A | null` parameter still is one.
type A = { v: i32 }
type C = { v: i32, s: string }
const a: A | null = { v: 3 }
if a is C { print("then") } else { print("else") }
if a is C { print(a.s.length) } else { print("not C") }
function f(p: A | null) { return p is C }
const x: C = { v: 1, s: "a" }
print(f(x))
print(f({ v: 2 }))
const n: A | null = null
print(n is C)
