// A union of lists whose members each box under a tag of their own narrows by `is` to the member
// itself: the value is that list, empty or not, so it is delivered whole and writes reach it.
function g(xs: string[]) { return xs.length }
function add(xs: i32[]) { xs.push(5) }
const q: string[] | i32[] = ["a"]
if q is string[] { print(g(q)) }
const e: i32[] = []
const p: string[] | i32[] = e
if p is i32[] { add(p) }
print(e.length)
if p is string[] { print("s") } else { print("i") }
// @log 1
// @log 1
// @log i
