// @run
// @log 0
// @log 2
// @log 9
// A module binding narrowed in a function stays narrowed across a call whose callees never write
// it, even when the function that does write it escapes as a value.
let g: i32 | null = 1

function reset() { g = null }

const hooks = [reset]

function other() { print(0) }

function f() {
  if g != null {
    other()
    print(g + 1)
  }
}

f()
hooks[0]()
f()
print(9)
