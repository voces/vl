// @run
// @log 7
// @log map
// @log 8
// @log 3
// @log 9
// @log 3
// An `is` test at its storage over a member receiver narrowed beside a container or an atom arm:
// the record test over `A | {[string]: i32}` builds in the IR, its receiver lowered at its storage
// as it is built; the receiver narrowed beside an atom or a list is tested by legacy.
type A = { v: i32 }
type B = { s: string }
type OM = { f: A | B | {[string]: i32} }
type OI = { f: A | i32 | string }
type OL = { f: A | i32[] | string }
function withMap(o: OM) {
  if o.f is B { return }
  if o.f is A { print(o.f.v) } else { print("map") }
}
function withAtom(o: OI) {
  if o.f is string { return }
  if o.f is A { print(o.f.v) } else { print(o.f) }
}
function withList(o: OL) {
  if o.f is string { return }
  if o.f is A { print(o.f.v) } else { print(o.f.length) }
}
const m: {[string]: i32} = Map()
withMap({ f: { v: 7 } })
withMap({ f: m })
withAtom({ f: { v: 8 } })
withAtom({ f: 3 })
withList({ f: { v: 9 } })
withList({ f: [1, 2, 3] })
