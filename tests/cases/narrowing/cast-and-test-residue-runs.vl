// @run
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @log 1
// @log 2
// @log 42
// @log 2
// @log -1
// @log 1
// @log 10
// @log 2
// @log 4
// @log -1
// @log 30
// A field read straight off `as! B`, and a cast read again after one, are a test of a binding of
// the operand (D16322); a record cast to a record it is contained in or may be by its fields'
// values tests that record; and a test of records sharing one tag answers by the tag where every
// arm holding it is tested (D16320).
type A = { x: i32 }
type B = { x: 1 | 2 }
type C = { z: string }
type D = { x: 3 | 4 }
function g(r: A | C) { return (r as! B).x }
print(g({ x: 1 }))
function h(r: A | C) { return (r as! B).x }
print(h({ x: 2 }))
function twice(r: A | C) {
  let v = r as! B
  v = r as! B
  return v.x + 40
}
print(twice({ x: 2 }))
function rec(a: A) {
  const b = a as? B
  if b == null { return 0 - 1 }
  return b.x
}
print(rec({ x: 2 }))
print(rec({ x: 5 }))
function up(b: B) { return (b as! A).x }
print(up({ x: 1 }))
function trapRec(a: A) {
  const v = a as! B
  return v.x * 10
}
print(trapRec({ x: 1 }))
function tag(b: B | D | C) {
  if b is A { return b.x }
  return 0 - 1
}
print(tag({ x: 2 }))
print(tag({ x: 4 }))
print(tag({ z: "q" }))
function tagMatch(b: B | D | C) {
  return match b {
    A => b.x * 10
    C => 0
  }
}
print(tagMatch({ x: 3 }))
