// @run
// @log 5
// @log 6
// @log hi
// @log 7
// @log none
// @log 3
// A box narrowed to one variant reads a field stored as a union box: kept as the box when the read
// is the union, unboxed to the atom a test narrowed it to, and to the atom a `!= null` leaves.
type A = { k: "a", v: i32 | string, n: i64 | null }
type B = { k: "b", w: i32 }
type U = A | B
function whole(u: U) {
  if u is A {
    const x = u.v
    if x is i32 { return x }
  }
  return 0
}
function atom(u: U) {
  if u is A {
    if u.v is i32 { return u.v + 1 }
  }
  return 0
}
function text(u: U) {
  if u is A {
    if u.v is string { return u.v }
  }
  return "no"
}
function wide(u: U) {
  if u is A {
    if u.n != null { return u.n }
  }
  return 0 as i64
}
function show(u: U) {
  if u is A {
    if u.n == null { return "none" }
  }
  return "some"
}
const a: U = { k: "a", v: 5, n: 7 }
const s: U = { k: "a", v: "hi", n: null }
const b: U = { k: "b", w: 3 }
print(whole(a))
print(atom(a))
print(text(s))
print(wide(a))
print(show(s))
if b is B { print(b.w) }
