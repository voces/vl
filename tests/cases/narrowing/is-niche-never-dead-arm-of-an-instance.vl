// @run
// @log stmt no
// @log not
// @log value no
// @log tail no
// @log yes
// @log yes
// @log and
// @log yes
// @log yes
// An instance's `is` its receiver's niche cannot hold is a decided `false` even when the receiver
// is evaluated and dropped, so the arm that reads the narrowed field is not lowered there: a
// statement `if`, its `!`, an `&&`, a value `if` and a tail `if`.
type A = { v: i32 }
type C = { v: i32, s: string }
type D = { h: A | null }
type E = { h: C | null }
function F<Z>(z: Z) {
  if z.h is C { print(z.h.s) } else { print("stmt no") }
  if !(z.h is C) { print("not") } else { print(z.h.s) }
  if z.h is C && z.h.s == "yes" { print("and") }
  const w = if z.h is C { z.h.s } else { "value no" }
  print(w)
}
function T<Z>(z: Z): string {
  if z.h is C { return z.h.s }
  return "tail no"
}
const x: D = { h: { v: 3 } }
F(x)
print(T(x))
const y: E = { h: { v: 4, s: "yes" } }
F(y)
print(T(y))
