// @check
// @error operator '+' is not defined for i32 | null and i32 — 'g' is no longer narrowed to i32: the call to 'viaAlias' on line 15 may reassign it; re-test 'g' after the call
// A call ends a narrowing of a module binding when a local it calls holds the binding's writer.
let g: i32 | null = 1

function reset() { g = null }

function viaAlias() {
  const h = reset
  h()
}

function f(): i32 {
  if g != null {
    viaAlias()
    return g + 1
  }
  return 0
}

print(f())
