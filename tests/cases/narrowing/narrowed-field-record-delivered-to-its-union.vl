// @run
// @log Bb
// @log B3b
// @log Bb
// @log Bb
// @log Bb
// @log Bb
// @log Bb
// @log Bb
// @log A
// A field narrowed to one record member is that member's record, and boxes again under its arm
// wherever a union is owed: an argument, a wider union, a return, a binding, a field, an element.
type A = { v: i32 }
type B = { s: string, w: i32 }
type C = { t: string }
type W = { h: A | B }
type K = { k: A | B }
function show(h: A | B) { return if h is B { "B" + h.s } else { "A" } }
function show3(h: A | B | C) {
  return if h is B { "B3" + h.s } else if h is C { "C3" } else { "A3" }
}
function arg(z: W) {
  if z.h is B { print(show(z.h)) }
}
function wider(z: W) {
  if z.h is B { print(show3(z.h)) }
}
function ret(z: W): A | B {
  if z.h is B { return z.h }
  return { v: 9 }
}
function bind(z: W) {
  if z.h is B {
    const u: A | B = z.h
    print(show(u))
  }
}
function store(z: W, k: K) {
  if z.h is B { k.k = z.h }
}
function elem(z: W): (A | B)[] {
  if z.h is B { return [z.h] }
  return []
}
function neg(z: W) {
  if !(z.h is A) { print(show(z.h)) }
}
function gen<Z>(z: Z) {
  if z.h is B { print(show(z.h)) }
}
function viaA(z: W) {
  if z.h is A { print(show(z.h)) }
}
const w: W = { h: { s: "b", w: 1 } }
const wa: W = { h: { v: 4 } }
arg(w)
wider(w)
print(show(ret(w)))
bind(w)
const k: K = { k: { v: 0 } }
store(w, k)
print(show(k.k))
print(show(elem(w)[0]))
neg(w)
gen(w)
viaA(wa)
