// @run
// @log none
// @log 1
// @log 7
// @log none
// @log 1
// @log none
// @log none
// @log 7
// @log none
// @log 2
// @log none
// @log 2
// @log 1
// @log 7
// A null test narrows an `if` join of un-annotated parameters at each instance: the joined
// hole bound to `T | null` reads as `T` past `== null`, `!= null`, `is null` and an early
// return, for a list, a record and a string, whichever arm `k` selects.
function eq(a0, a1, k: i32) {
  const v = if k == 0 { a0 } else if k == 1 { a1 } else { [7] }
  if v == null { print("none") } else { print(v[0]) }
}
function ne(a0, a1, k: i32) {
  const v = if k == 0 { a0 } else if k == 1 { a1 } else { [7] }
  if v != null { print(v[0]) } else { print("none") }
}
function isNull(a0, a1, k: i32) {
  const v = if k == 0 { a0 } else { a1 }
  if v is null { print("none") } else { print(v[0]) }
}
function early(a0, k: i32) {
  const v = if k == 0 { a0 } else { [7] }
  if v == null {
    print("none")
    return
  }
  print(v[0])
}
function rec(a0, a1, k: i32) {
  const v = if k == 0 { a0 } else if k == 1 { a1 } else { { n: 7 } }
  if v == null { print("none") } else { print(v.n) }
}
function str(a0, a1, k: i32) {
  const v = if k == 0 { a0 } else if k == 1 { a1 } else { "z" }
  if v == null { print("none") } else { print(v.length) }
}
const x0: i32[] | null = null
const x1 = [1, 2]
eq(x0, x1, 0)
eq(x0, x1, 1)
eq(x0, x1, 2)
ne(x0, x1, 0)
ne(x0, x1, 1)
isNull(x0, x1, 0)
early(x0, 0)
early(x0, 1)
const r0: { n: i32 } | null = null
const r1 = { n: 2 }
rec(r0, r1, 0)
rec(r0, r1, 1)
const s0: string | null = null
const s1 = "ab"
str(s0, s1, 0)
str(s0, s1, 1)
isNull(x0, x1, 1)
ne(x0, x1, 2)
