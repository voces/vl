// @check
// @error member access '.length' on non-object string | null — 'g' is no longer narrowed to string: the call to 'clrG' on line 19 may reassign it; re-test 'g' after the call
// @error member access '.length' on non-object string | null — 'h' is no longer narrowed to string: the call to 'clr' on line 36 may reassign it; re-test 'h' after the call
// A function that binds `g` in an inner block and writes the outer `g` outside it still ends a
// narrowing of the outer `g` at its call: the write is matched by binding, not by name.
let g: string | null = "a"

function clrG() {
  if true {
    let g = 1
    g = 2
    print(g)
  }
  g = null
}

function readG(): i32 {
  if g != null {
    clrG()
    return g.length
  }
  return 0
}

function local(): i32 {
  let h: string | null = "b"
  const clr = () => {
    if true {
      let h = 1
      h = 2
      print(h)
    }
    h = null
  }
  if h != null {
    clr()
    return h.length
  }
  return 0
}

print(readG() + local())
