// @run
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B2` is contained in `A2`, so `is B2` tests the value
// @log 10
// @log 20
// @log -1
// @log -1
// @log B
// @log no
// @log no
// @log 1
// @log one
// @log no
// A record test only one union member may pass, by its fields' literal values, tests that
// member's tag and then its fields; its `then` reads the value as that member (D4089).
type A = { x: i32 }
type B = { x: 1 | 2 }
type C = { z: string }
function g(r: A | C) {
  if r is B { return r.x * 10 }
  return 0 - 1
}
print(g({ x: 1 }))
print(g({ x: 2 }))
print(g({ x: 7 }))
print(g({ z: "s" }))
function h(r: A | C) {
  if !(r is B) { return "no" }
  return "B"
}
print(h({ x: 2 }))
print(h({ x: 3 }))
print(h({ z: "s" }))
const rs: (A | C)[] = [{ x: 1 }, { z: "q" }, { x: 5 }]
let n = 0
for r in rs {
  if r is B { n = n + 1 }
}
print(n)
type A2 = { x: i32, y: string }
type B2 = { x: 1 | 2, y: string }
function k(r: A2 | C) {
  if r is B2 { return r.y }
  return "no"
}
print(k({ x: 1, y: "one" }))
print(k({ x: 4, y: "four" }))
