// @check
// @error 'q' is narrowed by `is` only for reading its elements; it is still declared i32[] | K[]
// An un-annotated record literal does not hand a list narrowed by `is K[]` on as `K[]` (D16997).
type K = 1 | 2
type Box = { ks: K[] }
const a: i32[] = [1, 2]
const q: i32[] | K[] = a
function mk(): Box {
  if q is K[] { const b = { ks: q }; return b }
  return { ks: [] }
}
print(mk().ks.length)
