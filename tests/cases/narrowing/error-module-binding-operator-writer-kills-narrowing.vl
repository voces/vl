// @check
// @error operator '+' is not defined for i32 | null and i32 — 'g' is no longer narrowed to i32: the call to 'viaOperator' on line 20 may reassign it; re-test 'g' after the call
// A call ends a narrowing of a module binding when an operator declaration it runs writes it.
type Cell = { v: i32 }

let g: i32 | null = 1

function "+"(self: Cell, other: Cell): Cell {
  g = null
  return { v: self.v + other.v }
}

function viaOperator() {
  const c: Cell = { v: 1 }
  print((c + c).v)
}

function f(): i32 {
  if g != null {
    viaOperator()
    return g + 1
  }
  return 0
}

print(f())
