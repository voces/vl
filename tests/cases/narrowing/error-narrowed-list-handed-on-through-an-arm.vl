// @check
// @error 'q' is narrowed by `is` only for reading its elements; it is still declared i32[] | K[]
// A list narrowed by `is K[]` is not handed on as `K[]` through an arm's value (DECISIONS.md "A
// narrowed list is not handed on as `K[]`", D16997): `a.push(200)` would reach `keep`.
type K = 1 | 2
let keep: K[] = []
function f(xs: K[]) { keep = xs }
const a: i32[] = [1, 2]
const q: i32[] | K[] = a
const e: K[] = []
if q is K[] { f(if a.length > 0 { q } else { e }) }
print(keep.length)
