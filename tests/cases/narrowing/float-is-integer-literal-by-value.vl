// @run
// @log true
// @log false
// @log true
// @log false
// @log true
// @log true
// @log true
// @log 1.5
// @log true
// @log false
// @log true
// @log 2.5
// @log true
// @log false
// @log true
// @log true
// @log false
// @log 2.5
// @log true
// A subject with a float member and no integer arm tested against integer literals compares by
// value, the literal converted to the float, and keeps its float type in the tested branch. A
// subject with an integer arm tests that arm, so `i32 | f64` holding `2.0` is not `2` (D3689).
const d = 1.0
print(d is 1)
const h = 1.5
print(h is 1)
type C = 1 | 2
print(d is C)
print(h is 2 | 3)
const big = 5000000000.0
print(big is 5000000000)
const nz = -0.0
print(nz is 0)
function rd() { return 3.0 }
print(rd() is 1 | 3)
if d is 1 { print(d + 0.5) }
function hole(x) { return x is 2 }
print(hole(2.0))
print(hole(2.5))
const v: f64 | string = 2.0
print(v is 2)
if v is 2 { print(v + 0.5) }
const n: f64 | null = 2.0
print(n is 2)
const m: i32 | f64 = 2.0
print(m is 2)
const mi: i32 | f64 = 3
print(mi is 2 | 3)
const q: f32 = 2.0
print(q is 2)
print(q is 3)
if q is 2 { print(q + 0.5) }
const qb: f32 | string = 2.0
print(qb is 2)
