// @run
// @log A
// @log 3
// @log B
// @log B
// @log b
// @log C
// @log C
// @log c
// @log 13
// @log 1
// @log 200
// A member receiver's `is` test reads the field at its storage, the declared box, while the
// same field read plainly before the test, narrowed after an early return, and inside an arm
// reads it as the program's types say.
type A = { v: i32 }
type B = { s: string, w: i32 }
type C = { t: string, w: i32 }
type W = { h: A | B | C }
function show(h: A | B | C) {
  if h is A { return "A" }
  if h is B { return "B" }
  return "C"
}
function F<Z>(z: Z) {
  print(show(z.h))
  if z.h is A {
    print(z.h.v)
    return
  }
  print(show(z.h))
  if z.h is B {
    print(z.h.s)
    return
  }
  print(z.h.t)
}
function G(z: W) {
  const before = z.h
  if z.h is A { return z.h.v + (if before is A { 10 } else { 0 }) }
  if z.h is C { return z.h.w * 100 }
  return z.h.w
}
const ws: W[] = [
  { h: { v: 3 } },
  { h: { s: "b", w: 1 } },
  { h: { t: "c", w: 2 } },
]
F(ws[0])
F(ws[1])
F(ws[2])
print(G(ws[0]))
print(G(ws[1]))
print(G(ws[2]))
