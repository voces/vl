// @run
// @log false
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log 2
// An `is` test with a static answer is that constant; a receiver that is no re-readable place
// (a call) still runs, once.
type A = { a: i32 }
type B = { b: string }
type K = "x" | "y"
let calls = 0
function mk(): A {
  calls = calls + 1
  return { a: 1 }
}
function num(): i32 {
  calls = calls + 1
  return 4
}
function never1(v: A | B): boolean { return v is K }
function never2(v: i32): boolean { return v is string }
function inst<T>(v: T): boolean { return v is i32 }
function same(v: A): boolean { return v is A }
function neverCall(): boolean { return num() is string }
function sameCall(): boolean { return mk() is A }
print(never1({ a: 1 }))
print(never2(1))
print(inst(2))
print(inst("s"))
print(same({ a: 1 }))
print(neverCall())
print(sameCall())
print(calls)
