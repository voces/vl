// @run
// @log false
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log 2
// @warning `is` check type 'K' is not a variant of A | B, so this test is always false here
// @warning `is` check type 'string' can never match a value of type i32, so this test is always false here
// @warning `is` check type 'string' can never match a value of type i32, so this test is always false here
// An `is` test with a static answer is that constant; a receiver that is no re-readable place
// (a call) still runs, once.
type A = { a: i32 }
type B = { b: string }
type K = "x" | "y"
let calls = 0
function mk(): A {
  calls = calls + 1
  return { a: 1 }
}
function num() {
  calls = calls + 1
  return 4
}
function never1(v: A | B) { return v is K }
function never2(v: i32) { return v is string }
function inst<T>(v: T) { return v is i32 }
function same(v: A) { return v is A }
function neverCall() { return num() is string }
function sameCall() { return mk() is A }
print(never1({ a: 1 }))
print(never2(1))
print(inst(2))
print(inst("s"))
print(same({ a: 1 }))
print(neverCall())
print(sameCall())
print(calls)
