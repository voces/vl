// @run
// @log big
// @log b
// @log none
// @log high
// @log low
// @log unset
// A `string | null` or `boolean | null` binding initialised by an `if` takes each arm's value, an
// atom decoded to its string, and the cell's null where an arm is missing.
type K = "a" | "b"
function str(c: i32, k: K) {
  const s = if c > 1 { "big" } else if c > 0 { k }
  return s ?? "none"
}
function flag(c: i32) {
  const f = if c > 0 { c > 5 }
  return if f == null { "unset" } else if f { "high" } else { "low" }
}
print(str(2, "a"))
print(str(1, "b"))
print(str(0, "a"))
print(flag(9))
print(flag(1))
print(flag(0))
