// A list literal delivered into `i64[] | K[]` or `f64[] | K[]`, `K` a numeric literal union, is
// built at the first list arm it fits and boxed under that arm's tag, so every read sees the one
// list it built: its length, an `is` of that arm, and an `is K[]` that a fixed arm answers by tag.
type K = 1 | 2
const a: i64[] | K[] = [1]
print(a.length)
if a is i64[] { print("i64") } else { print("other") }
if a is K[] { print("K") } else { print("not K") }
const b: i64[] | K[] = [5]
if b is K[] { print("K") } else { print("not K") }
const c: f64[] | K[] = [1, 2]
print(c.length)
function f() {
  const d: i64[] | K[] = [3]
  print(d.length)
}
f()
const e: K[] | i64[] = [1]
if e is K[] { print("K") } else { print("not K") }
// @log 1
// @log i64
// @log not K
// @log not K
// @log 2
// @log 1
// @log K
