// @run
// @log 5
// @log p2
// @log 2
// @log 6
// @log G
// @log 20
// A field store through a field narrowed to one record member writes that member's record, off a
// parameter, a local copy and a module `const`, with the record a union member or not.
type A = { v: i32 }
type B = { s: string, w: i32 }
type W = { h: A | B }
type W2 = { h: A | B }
type S = { q: i32 }
type U = W2 | S
const g: W = { h: { s: "g", w: 1 } }
const g2: W2 = { h: { s: "g2", w: 2 } }
function viaParam(q: W) {
  if q.h is B { q.h.w = 5 }
  if q.h is B { print(q.h.w) }
}
function viaParam2(q: W2) {
  if q.h is B { q.h.s = "p2" }
  if q.h is A { return }
  q.h.w = q.h.w + 1
  print(q.h.s)
  print(q.h.w)
}
function viaLocal(q: W) {
  let k = q
  if k.h is B { k.h.w = k.h.w * 3 }
  if k.h is B { print(k.h.w) }
}
viaParam({ h: { s: "b", w: 1 } })
viaParam2({ h: { s: "b", w: 1 } })
viaLocal({ h: { s: "b", w: 2 } })
if g.h is B { g.h.s = "G" }
if g.h is B { print(g.h.s) }
if g2.h is B { g2.h.w = 20 }
if g2.h is B { print(g2.h.w) }
