// A union of a list and its numeric-literal twin is stored as one list with no tag, so an `as`
// to the whole list always fits and one to the literal list fits when every element does,
// as `is` tests it; `as` hands the operand back on a miss and `as?` answers `null`.
type K = 1 | 2
type J = 9000000000 | 9000000001
function first<T>(xs: T[]): T { return xs[0] }
function keep(q: i32[] | K[]): i32[] | K[] {
  const r = q as K[]
  print(r.length)
  return r
}
const q: i32[] | K[] = [5, 2]
print(first(q as! i32[]))
const p: i32[] | K[] = [2, 1]
print((p as! K[])[1])
print(q as? K[] == null)
const s = p as? K[]
if s != null { print(s[0]) }
print(keep([1, 2]).length)
print(keep([7, 8, 9]).length)
const n: i32[] | K[] | null = [4]
print((n as! i32[])[0])
const w: i64[] | J[] = [9000000001]
print((w as! J[])[0])
// @log 5
// @log 1
// @log true
// @log 2
// @log 2
// @log 2
// @log 3
// @log 4
// @log 9000000001
