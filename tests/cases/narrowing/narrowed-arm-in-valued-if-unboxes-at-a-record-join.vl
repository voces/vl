// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// D17026: a narrowed read of a union, as an arm of a valued `if` joined at a record's row, is
// unboxed in that arm, and no position it is delivered to unboxes the joined value again.
type A = { k: "a", v: i32 }
type B = { k: "b", w: i32 }
type H = { a: A | null }
function rv(r: A | null): i32 {
  if r != null { return r.v }
  return 0
}
function bind(x: A | B): i32 {
  const r: A | null = if x is A { x } else { null }
  return rv(r)
}
function tagTest(x: A | B): i32 {
  const r: A | null = if x.k == "a" { x } else { null }
  return rv(r)
}
function swapped(x: A | B): i32 {
  const r: A | null = if !(x is A) { null } else { x }
  return rv(r)
}
function chain(x: A | B): i32 {
  const r: A | null = if x is A { x } else if x.k == "b" { null } else { null }
  return rv(r)
}
function reassign(x: A | B): i32 {
  let r: A | null = null
  r = if x is A { x } else { null }
  return rv(r)
}
function fieldStore(x: A | B): i32 {
  const o: H = { a: null }
  o.a = if x is A { x } else { null }
  return rv(o.a)
}
function arg(x: A | B): i32 { return rv(if x is A { x } else { null }) }
function listLit(x: A | B): i32 {
  const xs: (A | null)[] = [if x is A { x } else { null }]
  return rv(xs[0])
}
function push(x: A | B): i32 {
  const xs: (A | null)[] = []
  xs.push(if x is A { x } else { null })
  return rv(xs[0])
}
function mapSet(x: A | B): i32 {
  const m: {[string]: A | null} = Map()
  m["q"] = if x is A { x } else { null }
  return rv(m["q"] ?? null)
}
function objField(x: A | B): i32 {
  const o: H = { a: if x is A { x } else { null } }
  return rv(o.a)
}
const a: A | B = { k: "a", v: 2 }
const b: A | B = { k: "b", w: 9 }
print(bind(a) + bind(b))
print(tagTest(a) + tagTest(b))
print(swapped(a) + swapped(b))
print(chain(a) + chain(b))
print(reassign(a) + reassign(b))
print(fieldStore(a) + fieldStore(b))
print(arg(a) + arg(b))
print(listLit(a) + listLit(b))
print(push(a) + push(b))
print(mapSet(a) + mapSet(b))
print(objField(a) + objField(b))
