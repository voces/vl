// @run
// @log false
// @log 1
// @log n
// @log 2
// @log 3
// @log true
// @log 4
// @log false
// @log 5
// @log false
// @log true
// An `is` test its receiver's nullable niche cannot hold is `false`, and its receiver still runs:
// a call, an assignment, an increment, in a value, a condition, a loop test and an `||` (D17031).
type A = { v: i32 }
type C = { v: i32, s: string }
let n = 0
let q: A | null = { v: 2 }
function mk(): A | null {
  n = n + 1
  return { v: 1 }
}
function clear(): A | null {
  q = null
  return q
}
print(mk() is C)
print(n)
if mk() is C { print("y") } else { print("n") }
print(n)
let i = 0
while mk() is C && i < 3 { i = i + 1 }
print(n)
const b = mk() is C || true
print(b)
print(n)
function g() { return mk() is C }
print(g())
print(n)
print(clear() is C)
print(q == null)
