// A record tested against one that narrows a field to something other than a literal set (a
// union member, a nested record, a list element) tests each field it narrows at that field's
// own type, through `is`, `match` and `as?` alike, and over a nullable or union operand (D4082).
type A = { x: i32 | string, z: i32 }
type B = { x: i32, z: i32 }
type C = { w: string }
type N = { x: { y: i32 } }
type M = { x: { y: 1 | 2 } }
type L = { x: i32[] }
type K = { x: 1[] }
type S = { x: string, y: i32 | string }
type T = { x: "a" | "b", y: i32 }
function isB(a: A) { a is B }
print(isB({ x: 1, z: 0 }))
print(isB({ x: "s", z: 0 }))
function sum(a: A) {
  if a is B { a.x + a.z } else { -1 }
}
print(sum({ x: 4, z: 3 }))
print(sum({ x: "s", z: 3 }))
function nested(n: N) { n is M }
print(nested({ x: { y: 1 } }))
print(nested({ x: { y: 5 } }))
function elems(l: L) { l is K }
print(elems({ x: [1] }))
print(elems({ x: [2] }))
function both(s: S) { s is T }
print(both({ x: "a", y: 1 }))
print(both({ x: "a", y: "q" }))
function orNull(a: A | null) { a is B }
print(orNull({ x: 1, z: 0 }))
print(orNull(null))
function pick(u: A | C) {
  match u {
    B => 1
    A => 2
    C => 3
  }
}
print(pick({ x: 1, z: 0 }))
print(pick({ x: "s", z: 0 }))
print(pick({ w: "w" }))
function cast(a: A) {
  const b = a as? B
  if b == null { -1 } else { b.z }
}
print(cast({ x: 1, z: 5 }))
print(cast({ x: "s", z: 5 }))
