// @run
// @log then x
// @log else y
// @log out x
// @log in y
// @log x!
// @log y?
// @log true
// @log false
// @log nn
// @log vv
// @log true
// @log false
// @log 9
// Q58 position sweep: an operand read of a narrowed local. An atom cell narrowed by an overlapping
// `is` set decodes to its string where an operand wants one, while the test compares its id; a
// `let m = null` read before a later fill is its destination's own null in an `if` join, a loop
// body's join and a nested join.
type In = { v: i32 }
type Out = { w: string, k: i32 }
const rec: In = { v: 9 }
const A = "x"
const C = "y"
function concat(c: boolean) {
  const J = if c { A } else { C }
  if J is "x" | "z" { print("then " + J) } else { print("else " + J) }
}
function interp(c: boolean) {
  const J = if c { A } else { C }
  if J is "y" | "z" { print("in \{J}") } else { print("out \{J}") }
}
function concatRight(c: boolean) {
  const J = if c { A } else { C }
  if J is "x" | "w" { print(J + "!") } else { print(J + "?") }
}
function joined(f: boolean) {
  let m = null
  const j = if f { m } else { rec }
  m = { w: "z", k: 4 }
  return j == null
}
function inLoop(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    i = i + 1
  }
  m = { w: "z", k: 4 }
  return out
}
function nested(f: boolean, g: boolean) {
  let m = null
  const j = if f { if g { m } else { rec } } else { rec }
  m = { w: "z", k: 4 }
  return j == null
}
concat(true)
concat(false)
interp(true)
interp(false)
concatRight(true)
concatRight(false)
print(joined(true))
print(joined(false))
print(inLoop(true))
print(inLoop(false))
print(nested(true, true))
print(nested(true, false))
print(rec.v)
