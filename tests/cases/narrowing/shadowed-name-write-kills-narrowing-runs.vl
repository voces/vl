// @run
// @log 2
// @log 0
// @log 2
// @log 0
// The write a shadowing function makes to the outer binding is seen at its call, so a re-test
// after the call reads the value it left, at module scope and in a closure.
let g: string | null = "a"

function clrG() {
  if true {
    let g = 1
    g = 2
    print(g)
  }
  g = null
}

function readG() {
  if g != null {
    clrG()
    if g != null { return g.length }
  }
  return 0
}

function local() {
  let h: string | null = "b"
  const clr = () => {
    if true {
      let h = 1
      h = 2
      print(h)
    }
    h = null
  }
  if h != null {
    clr()
    if h != null { return h.length }
  }
  return 0
}

print(readG())
print(local())
