// @check
// @error operator '+' is not defined for i32 | null and i32 — 'g' is no longer narrowed to i32: the call to 'viaMethod' on line 19 may reassign it; re-test 'g' after the call
// A call ends a narrowing of a module binding when a method it calls writes the binding.
type Cell = { v: i32 }

let g: i32 | null = 1

function clear(self: Cell) {
  if self.v > 0 { g = null }
}

function viaMethod() {
  const c: Cell = { v: 1 }
  c.clear()
}

function f(): i32 {
  if g != null {
    viaMethod()
    return g + 1
  }
  return 0
}

print(f())
