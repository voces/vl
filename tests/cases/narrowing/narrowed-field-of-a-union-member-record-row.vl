// @run
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `viaU` is inferred as `i32`
// @log 3
// @log 3
// @log 3
// D17025's repro, its early-return spelling and its call through a `U` narrowed to `R`.
type A = { ov: i32 }
type B = { bits: i32 }
type O = A | B
type R = { d: O }
type S = { q: i32 }
type U = R | S
function f(r: R): i32 {
  if r.d is A { return r.d.ov }
  return -1
}
function g(r: R): i32 {
  if !(r.d is A) { return -2 }
  return r.d.ov
}
function viaU(u: U): i32 {
  if u is R { return f(u) }
  return -3
}
const a: O = { ov: 3 }
print(f({ d: a }))
print(g({ d: a }))
print(viaU({ d: a }))
