// @run
// @log 3
// @log 7
// @log 0
// @log 14
// @log 107
// @log w!
// @log none
// @log 8
// @log x
// @log a
// A field narrowed out of its union box, read off a record that is itself a member of another
// union, is the arm's own value in every position (unfiled: D17025).
type A = { ov: i32, ow: string }
type B = { bv: string }
type R = { d: A | B }
type U = R | i32
function g(u: U) { return if u is i32 { u } else { 1 } }
function sink(x: i32) { return x + 100 }
function ret(r: R) {
  if r.d is A { return r.d.ov }
  return 0
}
function bind(r: R) {
  if r.d is A {
    const x = r.d.ov
    return x * 2
  }
  return -1
}
function arg(r: R) {
  if r.d is A { return sink(r.d.ov) }
  return -2
}
function str(r: R) {
  if r.d is A { return r.d.ow + "!" }
  return "none"
}
function loc(r0: R) {
  const r = r0
  if r.d is A { return r.d.ov + 1 }
  return -3
}
function els(r: R) {
  if r.d is B { return r.d.bv } else { return "a" }
}
const ra: R = { d: { ov: 7, ow: "w" } }
const rb: R = { d: { bv: "x" } }
print(g(3))
print(ret(ra))
print(ret(rb))
print(bind(ra))
print(arg(ra))
print(str(ra))
print(str(rb))
print(loc(ra))
print(els(rb))
print(els(ra))
