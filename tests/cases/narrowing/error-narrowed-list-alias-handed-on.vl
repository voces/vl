// @check
// @error argument 1: expected K[], got i32[] | K[]
// An alias of a list narrowed by `is K[]` holds its declared type, so it is not a `K[]` (D16997).
type K = 1 | 2
let keep: K[] = []
function f(xs: K[]) { keep = xs }
const a: i32[] = [1, 2]
const q: i32[] | K[] = a
if q is K[] { const r = q; f(r) }
print(keep.length)
