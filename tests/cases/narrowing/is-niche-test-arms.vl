// An `is` over a nullable reference niche testing the niche's own record is its null test, and
// its negation the inverse; the other niches' tests (a string, a boolean, a literal set) take
// another rung today and are pinned here as they run.
type A = { v: i32 }
function rec(a: A | null) {
  print(a is A)
  print(!(a is A))
}
function str(s: string | null) {
  print(s is string)
  print(!(s is string))
}
function bool(b: boolean | null) { print(b is boolean) }
function atom(k: "x" | "y" | null) { print(k is string) }
rec({ v: 1 })
rec(null)
str("x")
str(null)
bool(true)
bool(null)
atom("x")
atom(null)
