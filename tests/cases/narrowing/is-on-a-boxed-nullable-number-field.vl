// @run
// @log 7.5
// @log none
// @log 9
// @log 5
// @log none
// An `is` test on a record field declared a nullable number, held boxed: an `f64`, `i64` and
// `i32` field, each present and absent.
type Bf = { s: f64 | null }
type Bi = { s: i64 | null }
type Bn = { s: i32 | null }
function f(b: boolean) {
  const v = { r: 7.5 }
  const w: Bf = { s: if b { v.r } else { null } }
  if w.s is f64 { print(w.s) } else { print("none") }
}
function g() {
  const w: Bi = { s: 9 }
  if w.s is i64 { print(w.s) } else { print("none") }
}
function h(n: i32 | null) {
  const w: Bn = { s: n }
  if w.s is i32 { print(w.s + 1) } else { print("none") }
}
f(true)
f(false)
g()
h(4)
h(null)
