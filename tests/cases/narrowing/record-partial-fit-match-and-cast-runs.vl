// @run
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @log B
// @log A-other
// @log C
// @log 20
// @log -1
// @log 2
// @log -1
// @log -1
// @log 1
// @log B
// @log no
// @log no
// @log null
// @log 2
// @log 0
// @log 0
// A record pattern or cast one union member may pass by its fields' values tests as `is` does:
// the member's tag and then its fields (D4087), over a nullable union too.
type A = { x: i32 }
type B = { x: 1 | 2 }
type C = { z: string }
function arm(r: A | C) {
  match r {
    B => "B"
    C => "C"
    _ => "A-other"
  }
}
print(arm({ x: 1 }))
print(arm({ x: 7 }))
print(arm({ z: "q" }))
function armRead(r: A | C) {
  match r {
    B => r.x * 10
    _ => 0 - 1
  }
}
print(armRead({ x: 2 }))
print(armRead({ z: "q" }))
function cast(r: A | C) {
  const b = r as? B
  if b == null { return 0 - 1 }
  b.x
}
print(cast({ x: 2 }))
print(cast({ x: 5 }))
print(cast({ z: "q" }))
function castTrap(r: A | C) {
  const b = r as! B
  b.x
}
print(castTrap({ x: 1 }))
function isNul(r: A | C | null) {
  if r is B { return "B" }
  "no"
}
print(isNul({ x: 1 }))
print(isNul(null))
function armNul(r: A | C | null) {
  match r {
    B => "B"
    null => "null"
    _ => "no"
  }
}
print(armNul({ x: 9 }))
print(armNul(null))
function castNul(r: A | C | null) {
  const b = r as? B
  if b == null { return 0 }
  b.x
}
print(castNul({ x: 2 }))
print(castNul(null))
print(castNul({ x: 3 }))
