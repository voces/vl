// @run
// @log 2
// @log 2
// @log 2
// @log n=2
// @log [1]
// @log 2
// @log 2
// @log 2
// @log 0
// @log 2
// @log 3
// @log 2
// @log 1
// @log 7
// @log 1
// A cast over a union of a list and its literal twin, stored as one list (`as!`, `as?`, `as`),
// in each position: a scalar and a union argument, a nested argument, a concat operand, an
// interpolation hole, a return, an initializer, an `if` arm, a `??` operand and a record field.
import { toString } from "std:fmt"

type K = 1 | 2
type L = i32[] | K[]
type R = { ks: K[] }
function first(ks: K[]): i32 { return ks[0] }
function lenU(u: K[] | string): i32 {
  if u is string { return -1 } else { return u.length }
}
function idK(ks: K[]): K[] { return ks }
function argScalar(x: L): i32 { return first(x as! K[]) }
function argUnion(x: L): i32 { return lenU(x as! K[]) }
function argNested(x: L): i32 { return first(idK(x as! K[])) }
function concat(x: L): string { return "n=" + toString((x as! K[]).length) }
function interp(x: L): string { return "[\{(x as! i32[]).length}]" }
function ret(x: L): K[] { return x as! K[] }
function letInit(x: L): i32 {
  const ks = x as! K[]
  return ks.length
}
function ifArm(x: L, c: boolean): i32 {
  const ks: K[] = if c { x as! K[] } else { [] }
  return ks.length
}
function coal(x: L): i32 {
  const ks = (x as? K[]) ?? [1, 1, 1]
  return ks.length
}
function rec(x: L): R {
  const r: R = { ks: x as! K[] }
  return r
}
function prop(x: L): L {
  const ks = x as K[]
  return [ks[0]]
}
function nul(x: L | null): i32 { return (x as! i32[]).length }
const a: L = [2, 1]
const b: L = [7]
print(argScalar(a))
print(argUnion(a))
print(argNested(a))
print(concat(a))
print(interp(b))
print(ret(a).length)
print(letInit(a))
print(ifArm(a, true))
print(ifArm(a, false))
print(coal(a))
print(coal(b))
print(rec(a).ks.length)
print(prop(a).length)
print(prop(b)[0])
print(nul(b))
