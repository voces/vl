// @run
// @hint redundant type annotation: `r` is inferred as `A | null`
// @hint redundant type annotation: `r` is inferred as `A | null`
// @log 2
// @log 2
// @log 13
// @log 1
// @log 1
// @log 5
// @log 10
// An `if` initializing an `A | null` binding, where `A` is a union member, joins at `A`'s variant:
// a box narrowed to `A` is unboxed into it and a `null` arm is the variant's own null, annotated
// or not, chained or not (unfiled: D17026).
type A = { k: "a", v: i32 }
type B = { k: "b", w: i32 }
function h(x: A | B) {
  const r: A | null = if x is A { x } else { null }
  if r != null { return r.v }
  return 0
}
function bare(x: A | B) {
  const r = if x is A { x } else { null }
  if r != null { return r.v }
  return 0
}
function pk(x: A | B, c: boolean) {
  const r: A | null = if c { null } else if x is A { x } else { null }
  if r != null { return r.v + 10 }
  return 1
}
function lit(c: boolean) {
  const r: A | null = if c { { k: "a", v: 5 } } else { null }
  if r != null { return r.v }
  return 0
}
function two(x: A | B, y: A) {
  const r: A | null = if x is A { x } else { y }
  if r != null { return r.v }
  return 0
}
print(h({ k: "a", v: 2 }) + h({ k: "b", w: 9 }))
print(bare({ k: "a", v: 2 }) + bare({ k: "b", w: 9 }))
print(pk({ k: "a", v: 3 }, false))
print(pk({ k: "a", v: 3 }, true))
print(pk({ k: "b", w: 3 }, false))
print(lit(true) + lit(false))
print(
  two({ k: "a", v: 4 }, { k: "a", v: 6 })
    + two({ k: "b", w: 1 }, { k: "a", v: 6 }),
)
