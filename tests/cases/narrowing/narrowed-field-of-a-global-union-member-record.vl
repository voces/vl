// @run
// @hint redundant type annotation: `b` is inferred as `B` — remove it to lean on inference
// @log b
// @log 1
// @log b
// @log Ub
// @log b
// @log b
// @log b
// @log c
// @log 11
// @log 7
// @log d
// A field narrowed to one record member off a module `const` whose record is a union member is
// that member's record: read, delivered at the record or at its union, and stored through.
type A = { v: i32 }
type B = { s: string, w: i32 }
type W = { h: A | B }
type S = { q: i32 }
type U = W | S
const z: W = { h: { s: "b", w: 1 } }
function showB(b: B) { return b.s }
function showU(h: A | B) { return if h is B { "U" + h.s } else { "UA" } }
if z.h is B { print(showB(z.h)) }
if z.h is B {
  const b: B = z.h
  print(b.w)
}
if z.h is B {
  const b = z.h
  print(showB(b))
}
if z.h is B { print(showU(z.h)) }
function inFn() {
  if z.h is B { print(showB(z.h)) }
}
inFn()
function early() {
  if z.h is A { return }
  print(showB(z.h))
}
early()
if z.h is B { print(z.h.s) }
if z.h is B { z.h.s = "c" }
if z.h is B { print(z.h.s) }
if z.h is B { z.h.w = z.h.w + 10 }
if z.h is B { print(z.h.w) }
if z.h is B { z.h = { v: 7 } }
if z.h is A { print(z.h.v) }
z.h = { s: "d", w: 2 }
if z.h is B { print(showB(z.h)) }
