// A copy or inferred return of a list narrowed by `is K[]` takes its declared type, so its
// elements still read and `[...q]` hands on a `K[]` of its own (D16997). After `a.push(200)`,
// `q is K[]` is false and `g` returns its other arm.
type K = 1 | 2
let keep: K[] = []
function f(xs: K[]) { keep = xs }
const a: i32[] = [1, 2]
const q: i32[] | K[] = a
function g() {
  if q is K[] { return q }
  const e: i32[] = []
  return e
}
if q is K[] {
  const r = q
  print(r[0])
  print(r.length)
  f([...q])
}
a.push(200)
print(keep.length)
print(g().length)
// @log 1
// @log 2
// @log 2
// @log 0
// @hint redundant type annotation: `a` is inferred as `i32[]`
