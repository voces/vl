// @run
// @warning this `else` can never run (`p` is always `i32`)
// @warning this `else` can never run (`p` is always `string`)
// @warning this `else` can never run (`k` is always `"a"`)
// @warning this branch can never run (`p` is always `i32`)
// @warning this `_` arm can never run (every member of `i32 | string` is already matched)
// @log 5
// @log 5
// @log 5
// @log s!
// @log 5
// @log 5
// @log i
// @log 5
// @log 5
// @log 1
// @log 5
// @log 5
// D16006(a) (owner ruling): a test the operand's whole closed type passes leaves the other arm
// dead. The operand reads as `never` there, a bottom every use checks against, and the arm is a
// warning: `if`/`else`, an `else if` chain, a negated test, `==` over a literal type, `match _`.
type K = "a"
function needS(s: string) { print(s) }
function plus(p: i32) {
  if p is i32 { print(p + 1) } else { print(p + "!") }
}
function bare(p: i32) {
  if p is i32 { print(p + 1) } else { print(p) }
}
function chain(p: i32 | string) {
  if p is i32 { print(p + 1) }
  else if p is string { print(p + "!") }
  else { print(p * 2) }
}
function arg(p: i32) {
  if p is i32 { print(p + 1) } else { needS(p) }
}
function ret(p: i32): string {
  if p is i32 { return "i" } else { return p }
}
function member(p: i32) {
  if p is i32 { print(p + 1) } else { print(p.length) }
}
function rec(p: i32) {
  if p is i32 {
    print(p + 1)
  } else {
    const r = { x: p }
    print(r.x)
    const q = p * 2
    print(q)
    const f = () => p + 1
    print(f())
  }
}
function eq(k: K) {
  if k == "a" { print(1) } else { print(k + 1) }
}
function neg(p: i32) {
  if !(p is i32) { print(p + "!") } else { print(p + 1) }
}
function wild(p: i32 | string) {
  match p {
    i32 => print(p + 1)
    string => print(p)
    _ => print(p + "!")
  }
}
plus(4)
bare(4)
chain(4)
chain("s")
arg(4)
member(4)
print(ret(4))
rec(4)
neg(4)
eq("a")
wild(4)
plus(4)
