// @run
// @log 127.5
// @log 127.5
// @log 127.5
// @log 127.5
// @log 127.5
// @log 127.5
// @log 127.5
// @log 127
// An assignment delivered where its target's own type is wanted hands over what it stored, so
// an integer literal stored at `f32` reaches an `f32` result, binding, argument, field or element
// at that width (D3785). Elsewhere it keeps its own type: `a` below is `i32`, as in D3733.
function tail(): f32 {
  let x: f32 = 0
  x = 255
}
function joined(c: boolean): f32 {
  let x: f32 = 0
  x = if c { 0xff } else { 1 }
}
function returned(): f32 {
  let x: f32 = 0
  return x = 255
}
function half(v: f32) { print(v / 2.0) }
type R = { f: f32 }
function field(r: R): f32 { r.f = 255 }
function element(): f32 {
  const xs: f32[] = [0.0]
  xs[0] = 255
}
print(tail() / 2.0)
print(joined(true) / 2.0)
print(returned() / 2.0)
let x: f32 = 0
const y: f32 = (x = 255)
print(y / 2.0)
half(x = 255)
print(field({ f: 1.0 }) / 2.0)
print(element() / 2.0)
const a = (x = 0xff)
print(a / 2)
