// @run
// @log 4294967294
// @log 1
// @log 127.5
// @log 3
// @log 4294967294
// @log 4294967294
// @log 4294967294
// @log 4294967294
// An assignment whose right side is a literal or a value `if` of literals, delivered into a union
// box at a wide number arm: the box holds the assignment's value at that arm's width (the hex
// literal's 64-bit pattern at `i64`). Return, argument, binding, record field and list element
// positions; `i64`, `f64` and `f32` arms, beside `null` and `string`.
function ret(c: boolean): i64 | null {
  let x: i64 | null = null
  return x = if c { 0xfffffffe } else { 1 }
}
function retF(c: boolean): f64 | null {
  let x: f64 | null = null
  return x = if c { 0xff } else { 1 }
}
function retS(c: boolean): f32 | string {
  let x: f32 | string = "s"
  return x = if c { 3 } else { 1 }
}
function show(v: i64 | null) { print(v ?? 0) }
type R = { v: i64 | null }
function run(c: boolean) {
  let x: i64 | null = null
  show(x = if c { 0xfffffffe } else { 1 })
  const b: i64 | null = (x = 0xfffffffe)
  print(b ?? 0)
  const r: R = { v: x = if c { 0xfffffffe } else { 1 } }
  print(r.v ?? 0)
  const l: (i64 | null)[] = [x = 0xfffffffe]
  print(l[0] ?? 0)
}
print(ret(true) ?? 0)
print(ret(false) ?? 0)
print((retF(true) ?? 0) / 2.0)
const s = retS(true)
if s is f32 { print(s) }
run(true)
