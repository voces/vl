// @run
// @log 1
// @log 2
// @log 7
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `i64` — remove it to lean on inference
// A value join of literals nested as a tail of a join with an `i64` value is built at `i64` with
// its literals, at an `else if` chain, a `match`, a block tail and an annotated destination
// (D16560).
const c = true
const n = 1
const k: i64 = 5
const v = if c { if c { 1 } else { 2 } } else { k }
print(v)
const w = if !c { k } else { if !c { 1 } else { 2 } }
print(w)
const m = if n == 1 { match n {
  1 => 7
  _ => 8
} } else { k }
print(m)
const b = if c {
  const z = 1
  if c { z } else { 2 }
} else {
  k
}
print(b)
const a: i64 = if c { if c { 1 } else { 2 } } else if c { 3 } else { k }
print(a)
