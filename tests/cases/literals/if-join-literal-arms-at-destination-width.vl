// A value `if` whose tails are constants is built at the width its literals take: a parenthesised
// arm is that literal (D16371), and arms all adopting a wider destination build the join there
// (D16373). A join with a typed arm keeps its own width and widens after.
print(if true { 4294967296 } else { (1) })
const c = true
const y: i64 = if c { 7 } else { 9 }
print(y)
const z: i64 = if c { (7) } else { 9 }
print(z)
const f: f64 = if c { 7 } else { 9 }
print(f)
function take(x: i64) { print(x) }
take(if c { 7 } else { 9 })
function give(): i64 { return if c { 7 } else { 9 } }
print(give())
const v = 3
const w: i64 = if c { 7 } else { v }
print(w)
