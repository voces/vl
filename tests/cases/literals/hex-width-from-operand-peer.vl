// @run
// @log true
// @log true
// @log false
// @log 4294967296
// @log -1
// @hint redundant type annotation: `big` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `bits` is inferred as `i32` — remove it to lean on inference
// The other operand of a binary op or comparison is a destination too: over an
// i64 peer the eight digits are the low half of a 64-bit word, so
// `x >= 0x80000000` compares against 2147483648. The adopt is upward only —
// a 32-bit peer leaves a wider literal alone and the expression widens as usual.
print(0xFFFFFFFF == -1)

const big: i64 = 3000000000
print(big >= 0x80000000)

const small: i64 = 2000000000
print(small >= 0x80000000)

const one: i64 = 1
print(one + 0xFFFFFFFF)

const bits: i32 = 0xFFFFFFFF
print(bits | 0)
