// @error member access '.e3' on non-object i32
// The other half of the unchanged mantissa grammar: a `.` starts a fractional part
// only when a DIGIT follows it, so `1.` is the integer `1` and a DOT. `1.e3` is
// therefore `1` `.` `e3` — a member access, exactly what it was before scientific
// notation existed, and NOT the float 1000.
let a = 1.e3
print(a)
