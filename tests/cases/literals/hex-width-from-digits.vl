// @run
// @log 127
// @log -286331154
// @log -1
// @log 4294967296
// @log -1
// @log -1
// @log -1
// With no destination the digit count decides: up to eight significant hex
// digits (32 binary, leading zeros and `_` not counted) is an i32, up to sixteen
// is an i64. Binary and octal read the same way, and the value is the
// two's-complement reading of the pattern at that width.
const small = 0x7F
print(small)
const seed = 0xEEEEEEEE
print(seed)
const zeros = 0x0_00FF_FFFF_FF
print(zeros)
const big = 0x1_0000_0000
print(big)
const full = 0xFFFF_FFFF_FFFF_FFFF
print(full)
print(0b11111111111111111111111111111111)
print(0o37777777777)
