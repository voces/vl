// @error expected an expression but found DOT
// THE EXPONENT DID NOT WIDEN THE MANTISSA GRAMMAR. VL has no bare `.5` float — the
// `.` is a DOT — so `.5e3` is refused exactly as `.5` already was. Measured on the
// compiler before scientific notation landed; the exponent is a suffix on the float
// literal VL already had, not a licence for a new mantissa spelling.
let a = .5e3
print(a)
