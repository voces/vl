// @check
// @error integer literal 100000000000000000000 overflows i64
// @error integer literal 9223372036854775808 overflows i64
// A decimal literal past the i64 range is refused where no float holds it, rather than keeping
// its low 64 bits (D3425); `-9223372036854775808` is the least i64, and a float destination
// takes the literal it holds exactly.
let a = 100000000000000000000
print(a)
print(9223372036854775808)
print(-9223372036854775808)
const f: f64 = 100000000000000000000
print(f)
