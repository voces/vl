// @log -4294967286
// A parenthesised value `if` is built at the width its literal tails adopt, its parentheses typed
// with it (D16374, D16376), and a join with a typed arm keeps that arm's width for its decimal
// tails at a record field and a list element too. A hex tail is read at the width it is delivered
// at, an i64 operator peer's among them (D2617), so the last line reads the 64-bit pattern.
const c = true
const v5 = 3
const v2: i64 = 5
const y: i64 = (if c { 7 } else { 9 })
print(y)
print((if c { 0x7 } else { v5 }) + v2)
print(v2 + (if c { 1000 } else { 255 }))
const f: f64 = (if c { 7 } else { 3 })
print(f)
type W = { f: i64 }
const w: W = { f: (if c { 7 } else { v5 }) }
print(w.f)
const a: i64[] = [if c { 7 } else { v5 }]
print(a[0])
print(((if c { 7 } else { 9 })) + v2 - 5)
const v3 = 255
const b: i64 = 1
print(9 - (if v3 >= v3 { 0xFFFFFFFF } else { v3 }) * b)
