// @run
// @log 12884901888
// @log 12884901888
// @log 1099511627776
// @log 2147483648
// @log 10000000000
// @log -2147483648
// @log 9223372036854775807
// @log 4294967296
// @log 1099511627776
// @log 2147483648
// @log 10000000000
// @log 12884901888
// @log 8589934592
// @log 1099511627776
// @log 1099511627777
// @log 1099511627776
// @log 1099511627776
// @log -2147483648
// @log 9
// @log -2147483648
// @log 705032704
// @hint redundant type annotation: `pack` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `g` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `narrow` is inferred as `i32` — remove it to lean on inference
// Reported by plumb (PL-047), in its own shape: a field-packing helper returned the low half.
// A tree of integer literals takes a 64-bit destination's width, as a bare literal does, so it
// is computed at 64 bits rather than wrapped at 32 first (D2709). The last three lines are the
// controls: an f64 destination keeps the i32 reading (D2711), an i32 destination keeps the
// 32-bit wrap, and an i32 variable in the tree is never widened. An exact cast to `i64` adopts
// too; the wrap cast `as%` keeps the 32-bit reading it names.
type R = { v: i64 }

function pack(hi: i64, lo: i64): i64 { (hi << 32) | lo }
const a: i64 = 3 << 32
print(a)
function f(): i64 { 3 << 32 }
print(f())
function g(x: i64): i64 { x }
print(g(1 << 40))
const b: i64 = 2147483647 + 1
print(b)
const c: i64 = 100000 * 100000
print(c)
const d: i64 = -(2147483647 + 1)
print(d)
const e: i64 = ~0 >>> 1
print(e)
const h: i64 = 0xffffffff + 1
print(h)

function positions(k: i32, cond: boolean) {
  const r: R = { v: 1 << 40 }
  print(r.v)
  const xs: i64[] = [2147483647 + 1]
  print(xs[0])
  const m: {[i32]: i64} = Map()
  m[1] = 100000 * 100000
  print(m[1] ?? 0)
  const t: i64 = if cond { 3 << 32 } else { 0 }
  print(t)
  const u: i64 = match k {
    1 => 1 << 33
    _ => 0
  }
  print(u)
  let v: i64 = 0
  v += 1 << 40
  print(v)
  print(pack(0, 1) + (1 << 40))
  const cl = (): i64 => 1 << 40
  print(cl())
}
positions(1, true)
print((1 << 40) as i64)
print((2147483647 + 1) as% i64)

const bits: f64 = (1 << 3) + 1
print(bits)
const narrow: i32 = 2147483647 + 1
print(narrow)
function times(x: i32): i64 { x * (100000 * 50000) }
print(times(1))
