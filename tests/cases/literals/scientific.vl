// @run
// @log 1000
// @log 1
// @log 1.5e-7
// @log 20000000000
// @log 100000000000
// @log 1000
// @log 0.5
// @log -150
// @log true
// @log 1500
// @log 100000
// Scientific-notation float literals: a decimal mantissa, `e` or `E`, an optional
// `+`/`-` sign, and a decimal exponent whose digits take the same `_` separator
// every other numeric literal takes. The exponent is a SPELLING of the existing
// float literal, not a new literal kind — `1e3` is the same f64-by-default node
// `1000.0` is, so it flows everywhere a `.` literal flows (an `f32` slot included,
// via the contextual-literal rule) and `vl fmt` leaves the author's spelling alone.
print(1e3)
print(1e0)
print(1.5e-7)
print(2E+10)
print(1_0e1_0)
print(1E3)
print(5e-1)
print(-1.5e2)
print(1e2 > 5e1)
const wide: f32 = 1.5e3
print(wide)
const inferred = 1e5
print(inferred)
