// @run
// @log 255
// @log 255
// @log 57005
// @log -559038737
// @log 3735928559
// Hex integer literals (0x / 0X), case-insensitive digits and prefix, with a
// `_` digit separator. A hex literal is a bit pattern of its destination's
// width; with no destination the digit count decides, so the eight digits of
// `0xDEAD_BEEF` make it an i32 and its top bit is the sign. An i64 destination
// reads the same eight digits as the low half of a 64-bit word.
print(0xFF)
print(0Xff)
print(0xDEAD)
print(0xDEAD_BEEF)
const wide: i64 = 0xDEAD_BEEF
print(wide)
