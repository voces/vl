// @run
// @log -2
// @log 4294967294
// @log -1
// @log -1
// @log -2
// @log 4294967294
// The value of a closure's tail write into an `f64` place is the write's own `i32` type: a hex
// tail yields its 32-bit pattern while the place keeps the exact value (D14797).
type R = { v: f64 }

function g(c: boolean) {
  let d: f64 = 0
  const setd = () => {
    d = if c { 0xfffffffe } else { -1 }
  }
  print(setd())
  print(d)
}
g(true)
g(false)

function h(c: boolean) {
  const r: R = { v: 0 }
  const setf = () => {
    r.v = if c { 0xfffffffe } else { 1 }
  }
  print(setf())
  print(r.v)
}
h(true)
