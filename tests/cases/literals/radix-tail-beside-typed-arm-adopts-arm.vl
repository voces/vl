// A radix tail beside a typed `i32` arm adopts that arm first, so the join is the `i32` pattern
// and widens at its use (ruling 4.3, D16561); literals alone, or a 64-bit arm, read the tail at the
// destination's width (D2617), and a pattern past 32 bits widens the join.
function take(p: i64) { print(p) }
function n() { return [255][0] }
const v = n()
const c = v >= v
const k: i64 = 1
print((if c { 0xFFFFFFFF } else { v }) * k)
const j = if c { 0xFFFFFFFF } else { v }
print(j * k)
let x: i64 = 0
x = if c { 0xFFFFFFFF } else { v }
print(x)
take(if c { 0xFFFFFFFF } else { v })
let d: f64 = 0
d = if c { 0xFFFFFFFF } else { v }
print(d)
print((if c { 0xFFFFFFFF } else { 1 }) * k)
x = if c { 0xFFFFFFFF } else { k }
print(x)
x = if c { 0x1_0000_0000 } else { v }
print(x)
