// @error does not fit a 64-bit destination
// @error constant 0x1_0000_0000_0000_0000 overflows i64
// Seventeen significant hex digits are 65 bits and no VL destination is that
// wide, so the literal is refused at itself rather than silently keeping its
// low 64 bits. A `const` holding it is refused where it is read.
print(0x1_0000_0000_0000_0000)
const c = 0x1_0000_0000_0000_0000
print(c)
