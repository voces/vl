// @error float exponent has no digits after `e`
// An `e`/`E` after a mantissa COMMITS the literal to being a float, so a missing
// exponent reports at the literal. Splitting it into `1` + an identifier `e`
// instead — what the lexer did before scientific notation existed — blamed the
// PARSER for a broken number ("expected `)` but found `e`").
let a = 1e
print(a)
