// @run
// @log 4294967302
// @log 30064771065
// @log 4294967302
// @log 4294967295
// @log 6
// @info `c` is never reassigned; use `const` instead of `let`
// A value `if` or `match` of constant tails is a constant of the literal tree it stands in, so a
// radix pattern beside it takes the tree's destination width (D16319). With no destination the
// pattern is its i32 one (DECISIONS' radix ruling).
let c = true
const k = 1
const a: i64 = 0xFFFFFFFF + if c { 7 } else { 5 }
print(a)
const b: i64 = 0xFFFFFFFF * if c { 7 } else { 5 }
print(b)
const m: i64 = 0xFFFFFFFF
  + match k {
  1 => 7
  _ => 5
}
print(m)
const d: i64 = (if c { 1 } else { 0xFFFFFFFF }) * 0xFFFFFFFF
print(d)
print(0xFFFFFFFF + if c { 7 } else { 5 })
