// @error 0x1_0000_0000 does not fit a 32-bit destination
// Nine significant hex digits are 33 bits, and an i32 slot holds 32. The
// destination decides the width, so this is the one refusal the rule owes: the
// pattern is not representable there at all, in either reading.
const c: i32 = 0x1_0000_0000
print(c)
