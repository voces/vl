// @hint redundant type annotation: `tail` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `globalTail` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `matchTail` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `chainTail` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `take` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `l` is inferred as `i64[]` — remove it to lean on inference
// @hint redundant type annotation: `returned` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `floatTail` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `singleTail` is inferred as `f32` — remove it to lean on inference
// @hint redundant type annotation: `narrowTail` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `x` is inferred as `i32` — remove it to lean on inference
// An assignment whose right side is a value `if` or `match` of hex tails yields the value its
// target stores: the tails are bit patterns of the target's width, so the assignment's value is
// read at that width too, in every position it is delivered to (D3733, D3734). The last line is
// the control, an i32 target, which keeps the 32-bit pattern.
let g: i64 = 0

function tail(c: boolean): i64 {
  let x: i64 = 0
  x = if c { 0xfffffffe } else { 1 }
}
print(tail(true))

function plainTail(c: boolean) {
  let x: i64 = 0
  x = if c { 0xfffffffe } else { 1 }
}
print(plainTail(true))

function shared(c: boolean) {
  let x: i64 = 0
  const u = (): i64 => {
    x = if c { 0xfffffffe } else { 1 }
  }
  print(u())
  print(x)
}
shared(true)

function globalTail(c: boolean): i64 { g = if c { 0xfffffffe } else { 1 } }
print(globalTail(true))

function matchTail(c: i32): i64 {
  let x: i64 = 0
  x = match c {
    1 => 0xfffffffe
    _ => 1
  }
}
print(matchTail(1))

function chainTail(c: i32): i64 {
  let x: i64 = 0
  x = if c == 0 { 0xfffffffe } else if c == 1 { 0xffffffff } else { 2 }
}
print(chainTail(1))

function nullableTail(c: boolean): i64 | null {
  let x: i64 | null = null
  x = if c { 0xfffffffe } else { 1 }
}
print(nullableTail(true) ?? 0)

function take(z: i64): i64 { z }

function positions(c: boolean) {
  let x: i64 = 0
  const y = (x = if c { 0xfffffffe } else { 1 })
  print(y)
  print(take(x = if c { 0xfffffffe } else { 1 }))
  const r: { a: i64 } = { a: x = if c { 0xfffffffe } else { 1 } }
  print(r.a)
  const l: i64[] = [x = if c { 0xfffffffe } else { 1 }]
  print(l[0])
  print(x = if c { 0xfffffffe } else { 1 })
}
positions(true)

function returned(c: boolean): i64 {
  let x: i64 = 0
  return x = if c { 0xfffffffe } else { 1 }
}
print(returned(true))

function floatTail(c: boolean): f64 {
  let x: f64 = 0
  x = if c { 0xff } else { 1 }
}
print(floatTail(true) / 2.0)

function singleTail(c: boolean): f32 {
  let x: f32 = 0
  x = if c { 0xff } else { 1 }
}
print(singleTail(true) / 2.0)

function narrowTail(c: boolean): i32 {
  let x: i32 = 0
  x = if c { 0xfffffffe } else { 1 }
}
print(narrowTail(true))
