// @hint redundant type annotation: `take` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `narrow` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `k` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `arr` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `m` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `narrowTail` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `x` is inferred as `i32` — remove it to lean on inference
// An assignment is typed by its right side, and a hex literal is a bit pattern of the width
// it is used at, so an assignment whose right side is hex reads at each use's width: the stored
// 64-bit value where the use is `i64` or `f64` as the target is, the 32-bit pattern anywhere
// else. A bare literal and a value `if`, `match` or chain of them agree (D3733, D3734).
let g: i64 = 0
let gf: f64 = 0

function tail(c: boolean): i64 {
  let x: i64 = 0
  x = if c { 0xfffffffe } else { 1 }
}
print(tail(true))

function shared(c: boolean) {
  let x: i64 = 0
  const u = (): i64 => {
    x = if c { 0xfffffffe } else { 1 }
  }
  print(u())
  print(x)
}
shared(true)

function plainTail(c: boolean) {
  let x: i64 = 0
  x = if c { 0xfffffffe } else { 1 }
}
print(plainTail(true))

function globalTail(c: boolean): i64 { g = if c { 0xfffffffe } else { 1 } }
print(globalTail(true))

function matchTail(c: i32): i64 {
  let x: i64 = 0
  x = match c {
    1 => 0xfffffffe
    _ => 1
  }
}
print(matchTail(1))

function chainTail(c: i32): i64 {
  let x: i64 = 0
  x = if c == 0 { 0xfffffffe } else if c == 1 { 0xffffffff } else { 2 }
}
print(chainTail(1))

function nullableTail(c: boolean): i64 | null {
  let x: i64 | null = null
  x = if c { 0xfffffffe } else { 1 }
}
print(nullableTail(true) ?? 0)

function twice(c: boolean): i64 {
  let a: i64 = 0
  let b: i64 = 0
  a = b = if c { 0xfffffffe } else { 1 }
}
print(twice(true))

function floatTail(c: boolean): f64 {
  let x: f64 = 0
  x = if c { 0xff } else { 1 }
}
print(floatTail(true) / 2.0)

function take(z: i64): i64 { z }
function narrow(n: i32): i32 { n * 2 }

function wide(c: boolean) {
  let x: i64 = 0
  print(take(x = if c { 0xfffffffe } else { 1 }))
  const r: { a: i64 } = { a: x = if c { 0xfffffffe } else { 1 } }
  print(r.a)
  const l: i64[] = [x = if c { 0xfffffffe } else { 1 }]
  print(l[0])
}
wide(true)

function returned(c: boolean): i64 {
  let x: i64 = 0
  return x = if c { 0xfffffffe } else { 1 }
}
print(returned(true))

// The 32-bit uses: an `i32` argument, binding, element, operand and store, from an `i64` and an
// `f64` target alike, bare or joined.
function thin(c: boolean) {
  let x: i64 = 0
  let f: f64 = 0
  print(narrow(x = if c { 0xff } else { 1 }))
  print(narrow(f = if c { 0xff } else { 1 }))
  print(narrow(x = 0xff))
  const y = (x = if c { 0xff } else { 1 })
  const k: i32 = y
  print(k)
  const arr: i32[] = [y]
  print(arr[0])
  const yf = (f = if c { 0xff } else { 1 })
  print(yf & 1)
  let m: i32 = 0
  m = y
  print(m)
  const e = (x = 0xfffffffe)
  print(e)
  const j = (x = if c { 0xfffffffe } else { 1 })
  print(j)
  const a = (gf = 0xff)
  print(a / 2)
  const b = (gf = if c { 0xff } else { 1 })
  print(b / 2)
  print(x = if c { 0xfffffffe } else { 1 })
}
thin(true)

function narrowTail(c: boolean): i32 {
  let x: i32 = 0
  x = if c { 0xfffffffe } else { 1 }
}
print(narrowTail(true))
