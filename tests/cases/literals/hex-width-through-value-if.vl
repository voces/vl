// @run
// @log 4294967294
// @log 4294967295
// @log 4294967294
// @log 4294967294
// @log 4294967294
// @log 4294967294
// @log 4294967295
// @log 4294967294
// @log 9
// @log 4294967294
// @log 4294967294
// @log 4294967294
// @log 4294967294
// @log 4294967294
// @log 4294967294
// @log 4294967294
// @log 4294967294
// @log -2
// @hint redundant type annotation: `y` is inferred as `i32` — remove it to lean on inference
// Reported by plumb (PL-041), in its own shape: a value `if`, `match` or block delivers each of
// its tails to the destination, so a hex tail is read at the destination's width exactly as a bare
// hex literal there is (D2617). Every assignment target and value shape reads the 64-bit
// pattern; the last line is the control, an i32 destination, which keeps the 32-bit one.
type R = { v: i64 }

let rax: i64 = 0
function f(level: i64) {
  rax = if level != 0 { 0xfffffffe } else { 0xffffffff }
}
f(1)
print(rax)
f(0)
print(rax)

function take(p: i64) { print(p) }
function give(c: boolean): i64 { return if c { 0xfffffffe } else { 1 } }

function positions(c: boolean, k: i32) {
  let x: i64 = 0
  x = if c { 0xfffffffe } else { 0xffffffff }
  print(x)
  const r: R = { v: 0 }
  r.v = if c { 0xfffffffe } else { 0xffffffff }
  print(r.v)
  const xs: i64[] = [0]
  xs[0] = if c { 0xfffffffe } else { 0xffffffff }
  print(xs[0])
  const m: {[i32]: i64} = Map()
  m[1] = if c { 0xfffffffe } else { 0xffffffff }
  print(m[1] ?? 0)
  x = 1
  x += if c { 0xfffffffe } else { 0xffffffff }
  print(x)
  x = match k {
    0 => 0xfffffffe
    1 => 0x80000000
    _ => 0xffffffff
  }
  print(x)
  x = if c {
    print(9)
    0xfffffffe
  } else {
    k
  }
  print(x)
  const lit: R = { v: if c { 0xfffffffe } else { 1 } }
  print(lit.v)
  const arr: i64[] = [if c { 0xfffffffe } else { 1 }]
  print(arr[0])
  const bound: i64 = if c { 0xfffffffe } else { 1 }
  print(bound)
  const set = () => {
    x = if c { 0xfffffffe } else { 1 }
  }
  set()
  print(x)
  take(if c { 0xfffffffe } else { 1 })
  print(give(c))
  let d: f64 = 0
  d = if c { 0xfffffffe } else { 1 }
  print(d)
  let y: i32 = 0
  y = if c { 0xfffffffe } else { 0xffffffff }
  print(y)
}
positions(true, 0)
