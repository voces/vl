// @run
// @log 2147483644
// @log 67108139
// @log 9223372036854775804
// @log 3
// D16375: a constant tree under `>>>` whose left side is negative folds its operands exactly, so a
// sub-tree that would wrap to zero at i32 does not divide by zero; the `>>>` itself computes at the
// operands' default i32, or at an i64 destination's width.
print((-7 % (65536 * 65536)) >>> 1)
const v = (-46342 % (-2147483648 * 100)) >>> 6
print(v)
const x: i64 = (-7 % (65536 * 65536)) >>> 1
print(x)
print((7 % (65536 * 65536)) >>> 1)
