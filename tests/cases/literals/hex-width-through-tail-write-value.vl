// @run
// @log -2
// @log 4294967294
// @log -2
// @log 4294967294
// @log 1
// @log 1
// The value of a closure's tail write is the write's own type: a hex tail the `i64` place built
// at 64 bits yields its 32-bit pattern while the place keeps the 64-bit one (D14796).
type R = { v: i64 }

function g(c: boolean) {
  let x: i64 = 0
  const set = () => {
    x = if c { 0xfffffffe } else { 1 }
  }
  print(set())
  print(x)
  const r: R = { v: 0 }
  const setf = () => {
    r.v = if c { 0xfffffffe } else { 1 }
  }
  print(setf())
  print(r.v)
}
g(true)

function h(c: boolean) {
  let x: i64 = 0
  const set = () => {
    x = if c { 0xfffffffe } else { 1 }
  }
  print(set())
  print(x)
}
h(false)
