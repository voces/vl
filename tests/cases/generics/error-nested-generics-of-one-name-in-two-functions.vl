// @error argument 1: operator '+' is not defined for boolean and i32
// Two functions each declaring a nested `b<T>`: each one's call is checked at its own
// enclosing pin (D3853 review).
function a<T>(x: T) {
  function b<T>(y: T) { print(y + 1) }
  b(x)
}
function c<V>(x: V) {
  function b<T>(y: T) { print(y + 1) }
  b(x)
}
a(1)
c(true)
