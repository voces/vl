// @log 3
// @log 3
// @log 3
// @log 4
// @log 1
// Generic recursion that keeps its type parameters, swaps them, wraps them in a union, or
// passes a larger type to a function that does not call back, has a finite set of instances
// and runs; so does a growing recursion nothing reachable calls (D2721).
function same<T>(u: T, n: i32) {
  if n == 0 { return 0 }
  return same<T>(u, n - 1) + 1
}
function swap<A, B>(a: A, b: B, n: i32) {
  if n == 0 { return 0 }
  return swap(b, a, n - 1) + 1
}
function nul<T>(u: T | null, n: i32) {
  if n == 0 { return 0 }
  return nul<T | null>(u, n - 1) + 1
}
function leaf<U>(u: U) { return [u].length }
function calls<T>(u: T, n: i32) {
  if n == 0 { return 0 }
  return leaf([u]) + calls(u, n - 1)
}
function mf<T>(u: T, n: i32) {
  if n == 0 { return 0 }
  return mg(u, n - 1) + 1
}
function mg<U>(u: U, n: i32) { return mf(u, n) }
function fold<T>(u: T, k: (x: T) => i32, n: i32) {
  if n == 0 { return k(u) }
  return fold(u, (x: T) => k(x) + 1, n - 1)
}
function grows<T>(u: T, n: i32) {
  if n == 0 { return 0 }
  return grows([u], n - 1) + 1
}
print(same<string>("a", 3))
print(swap(1, "s", 3))
print(nul<i32>(1, 3))
print(calls(1, 3))
print(mf("a", 3))
print(fold(1, (x: i32) => x, 3))
print(1)
