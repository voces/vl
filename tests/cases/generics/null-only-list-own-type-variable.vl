// @run
// @log 1
// A null-only list literal delivered to a destination that names the enclosing generic's own
// type variable is typed, whether or not the generic is ever called (D1832). A callee's type
// variable left open at a call, `f<T>(xs: T[])` called as `f([null])`, still refuses.
function g<T>(x: T): i32 {
  const ys: (T | null)[] = [null]
  ys.length
}
function h<T>(x: T): (T | null)[] { [null] }
print(1)
