// @run
// @log 3
// @log ab
// @log false
// @log 3
// @log ab
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)

// A call's re-check of the generic body's push builds no adapter into the body every instance
// shares, so each instance types the record's field at its own T (D16235).
function id<T>(x: T): T { return x }
function run<T>(_x: T) {
  const rs: {f: (x: T) => T}[] = []
  rs.push({ f: id })
  return rs
}
function runM<T>(_x: T) {
  const m: {[string]: {f: (x: T) => T}} = Map()
  m.set("k", { f: id })
  return m.get("k")
}
print(run(3)[0].f(3))
print(run("ab")[0].f("ab"))
print(run(true)[0].f(false))
const a = runM(3)
if a != null { print(a.f(3)) }
const b = runM("ab")
if b != null { print(b.f("ab")) }
