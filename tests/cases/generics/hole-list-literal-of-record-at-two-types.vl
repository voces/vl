// D10891: a list literal of a hole parameter builds the list its instance names, a record at
// one call and an i32 at the other, through `.map`, `.filter`, `push`, a `for` loop and a return.
type P = { x: i32 }
function t(x) {
  const m = [x].map((e) => e)
  print(m.length)
  const l = [x, x].filter((e) => e == e)
  l.push(x)
  let n = 0
  for e in l { n = n + 1 }
  print(n - 1)
  l
}
const a: P = { x: 7 }
const r = t(a)
print(r[0].x)
print(r[2].x)
const s = t(5)
print(s[0] + 1)
const u = t(3)
print(u.length)
print(t("s").length - 1)
print(t(a)[1].x + 2)
