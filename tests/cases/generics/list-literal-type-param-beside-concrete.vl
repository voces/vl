// @run
// @log 2
// @log 7
// @log s
// @log 2
// @log 7
// @log true
// @log 2
// @log 7
// @log 3
// @log 3
// @log 2
// @log 2
// @log 3
// A list literal joining a type parameter with a concrete element is the union of the two,
// built at each pin as its concrete twin is: `[x, 7]` at `T = string` is `(string | i32)[]`,
// at `T = i32` is `i32[]` (D3079). Every generic line prints what its concrete twin would.

function pair<T>(x: T) {
  const l = [x, 7]
  print(l.length)
  print(l[1])
  print(l[0])
}
function grow<T>(x: T) {
  const l = [7, x]
  l.push(9)
  print(l.length)
}
function walk<T>(x: T) {
  let n = 0
  for _e in [x, 7] { n = n + 1 }
  print(n)
}
function relay<T>(x: T) { walk(x) }

pair("s")
pair(true)
pair(3)
grow(1.5)
walk([1, 2])
relay("s")
grow("s")
