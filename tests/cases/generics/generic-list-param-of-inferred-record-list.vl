// @run
// @log 1
// @log 2
// @log 2
// @log 3
// @log 1
// @log 2
// D2789, D3557: a generic `T[]` parameter bound to a list of an inferred, undeclared record has
// the list's valtype, whether the body captures the element in a closure, returns one, or maps.
import { reverse } from "std:array"
function run<T>(xs: T[]) {
  for x in xs {
    const f = () => x
    return f()
  }
  xs[0]
}
print(run([{ v: 1 }, { v: 2 }]).v)
function len<T>(xs: T[]): i32 { xs.length }
const xs = [{ x: 1 }, { x: 2 }]
print(len(xs))
print(reverse(xs)[0].x)
function mapB<T, U>(xs: T[], f: (T) => U): U[] {
  const out: U[] = []
  for x in xs { out.push(f(x)) }
  out
}
print(mapB(xs, (p) => p.x + 1)[1])
function first<T>(xs: T[]): T { xs[0] }
print(first(xs).x)
print(len([{ x: 1, y: "a" }, { x: 2, y: "b" }]))
