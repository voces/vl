// @run
// @log 1
// @log 22
// @log 2
// @log 33
// @log 3
// @log 44
// @log 4
// @log 55
// @log 5
// @log z
// A generic-alias APPLICATION as a MEMBER of a declared union (`type U = Box<i32> | Tag`).
// Every CONSTRUCTION of that member compiled to invalid wasm — a module `vl check` accepted
// with nothing worse than an unused-variable warning, `vl build` wrote, and no WebAssembly
// engine would parse.
//
// Mechanism, read off the emitted bytes. `collectU` asks `isStructAtom` whether a member is a
// struct variant, and that answers from the `TypeDecl` NAMES — a generic alias declares
// `Box<T>`, never `Box<i32>` — so the member was dropped from `uVariants` while the alias
// still registered in `unNames`. The annotation then classified as the union BOX
// (`(mut (ref $uBox))`) and the literal lowered the bare variant struct: the working control
// emits `i32.const <tag> … struct.new $variant  struct.new $uBox`, the defective one stopped
// at `struct.new $variant`.
//
// #1122 fixed the ONE-member spelling (`type Y = Box<i32>`) by making such an alias
// transparent; the multi-member union was left untouched. The resolution here is the same one
// #1122 MEASURED as the only route that resolves: STRUCTURAL, not nominal. The application's
// own name interns a struct row only where a `TypeRef` spells it, which a union member is not
// — while `type U = {v:i32} | Tag` (and `type A = Box<i32>; type U = A | Tag`, which reaches
// that shape through the one-member rule) compiles and runs. So a generic application
// standing as a member of a MULTI-member union resolves to its instantiated shape.
type Box<T> = { v: T }
type Pair<A, B> = { a: A, b: B }
type Tag = { t: i32 }
type U = Box<i32> | Tag

// The reported program: a module GLOBAL. `print` before the narrowed read so the log order
// pins the box tag as well as the payload.
const g: U = { v: 1 }
if g is Box<i32> { print(g.v) }

// A LOCAL, an ARGUMENT, a RETURN and a REASSIGNMENT — four separate emit ladders, all four
// of which built the bare struct into a box-typed slot.
function local() {
  const u: U = { v: 22 }
  if u is Box<i32> { print(u.v) }
  print(2)
}
local()

function takes(u: U) {
  if u is Box<i32> { print(u.v) }
  print(3)
}
takes({ v: 33 })

function makes(): U { { v: 44 } }
const m = makes()
if m is Box<i32> { print(m.v) }
print(4)

function reassign() {
  let u: U = { t: 9 }
  u = { v: 55 }
  if u is Box<i32> { print(u.v) }
  print(5)
}
reassign()

// A TWO-argument application, and the non-generic member still discriminating.
type V = Pair<i32, string> | Tag
const p: V = { a: 6, b: "z" }
if p is Pair<i32, string> { print(p.b) }
