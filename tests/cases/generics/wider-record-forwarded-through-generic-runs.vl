// @run
// @log a
// @log b
// @log 2
// A record wider than a declared record parameter, forwarded to it through a generic function,
// is passed at its own row, and each forwarder instance takes its own (D16219).
type P = { name: string }
function show(p: P) { print(p.name) }
function fwd<T>(t: T) { show(t) }
const v: { age: i32, name: string } = { age: 3, name: "a" }
fwd(v)
const w = { name: "b", k: true }
fwd(w)
function count(p: P) { p.name.length }
function twice<T>(t: T) { count(t) + count(t) }
print(twice({ x: 1, name: "z" }))
