// @run
// @log 3
// @log 7
// @log 5
// @log s
// @log 7
// @log no
// `T | null` through a generic alias is the nullable it spells inline, so a generic function
// over `O<T>` binds `T` to the instance's argument, not to the whole instance.
type O<T> = T | null
const a: O<i32> = 3
const b: O<i32> = null
print(a ?? 0)
print(b ?? 7)

function orD<T>(o: O<T>, d: T): T {
  if o == null { return d }
  return o
}
print(orD(b, 5))
const c: O<string> = "s"
print(orD(c, "d"))

type Res<T, E> = { ok: T } | { err: E }
function wrap<T>(v: T): Res<T, string> { return { ok: v } }
const r = wrap(7)
if r is { ok: i32 } { print(r.ok) }
const q: Res<i32, string> = { err: "no" }
if q is { err: string } { print(q.err) }
