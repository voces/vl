// @run
// @log true
// @log 3
// @log 8
// @log 2
// @log 1
// @warning Unused parameter `h`
// @hint redundant type annotation: `eqCap` is inferred as `boolean`
// @hint redundant type annotation: `lenPlus` is inferred as `i32`
// @hint redundant type annotation: `applyId` is inferred as `i32`
// @hint redundant type annotation: `inc` is inferred as `i32`
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// @hint redundant type annotation: `ys` is inferred as `i32[]`
// EVERY ANNOTATION IS DECLARED RATHER THAN REMOVED. Each one names the shape the floor
// is being asked about — the generic's parameter type, the lambda's, and the value the
// cell builds — so deleting it to quiet a hint would be testing a different program.
// The unused `h` is DECLARED rather than renamed away: the cell under test is a lambda
// PARAMETER whose type is `(T) => T`, and a parameter the body does not read is exactly
// the shape that proves the floor is asking about the annotation and not about a use.
// THE ACCEPT SET of `silent-class-inventory` D426's floor — every lambda-in-a-generic-body
// shape the parameter floor must NOT refuse, read back by value.
//
// READ THE SECTIONS BELOW AS HISTORY PLUS A LIVE PIN. D426 is now CLOSED by per-pin lambda
// lifting (`monoCloneLambdaSubst`): a lambda whose annotation names the enclosing `T` is
// instantiated once per pin with the pin's own types, so the shapes the floor was built to
// refuse RUN — `lambda-param-type-param-runs.vl` is that accept set, and the floor's
// remaining domain is `error-lambda-param-unbound-typaram.vl`. What the four sections here
// still pin is that the shapes which ALWAYS ran keep running: the fix must not disturb a
// capture, a concrete annotation, a `(T) => T` parameter, or a `T`-only RESULT, and this file
// is what says so if it does.
//
// The floor asks `nodeTyHasRepTyVar`, which is `nodeTyHasTyVar` minus the one position a
// type variable can occupy without deciding the parameter's valtype. Each section below is
// a shape the WIDE predicate refused and this one keeps:
//
//   1. a lambda that CAPTURES the generic's values instead of taking them — no annotation
//      mentions `T` at all, and it is the workaround the refusal's message names.
//   2. a lambda whose parameter is CONCRETE inside a generic body.
//   3. a lambda parameter typed `(T) => T`. A closure parameter is the fat pointer at every
//      instantiation, so the shared lifted lambda's valtype is right whatever `T` is.
//      MEASURED: the wide predicate turned 12 running cells of
//      `scripts/silent-sweep/d426/lamgrid.py` into rejects, and a lambda that CALLS such a
//      parameter is already refused LOUDLY where the i32 default is wrong (`function-value
//      call arity has no interned signature` at `T = string` and `T = f64`), so the
//      exemption hides no silent class.
//   4. a lambda whose RETURN mentions `T` while no parameter does.

// 1 — capture rather than parameterize
function eqCap<T>(a: T[], b: T[]): boolean {
  const g = () => a == b
  return g()
}

// 2 — a concrete lambda parameter inside a generic body
function lenPlus<T>(a: T[]): i32 {
  const g = (n: i32) => n + 1
  return g(a.length)
}

// 3 — a `(T) => T` lambda parameter, not called and called
function applyId<T>(f: (T) => T): i32 {
  const g = (h: (T) => T) => 1
  return g(f)
}
function applyCall<T>(f: (T) => T): T {
  const g = (h: (T) => T) => h(7)
  return g(f)
}

// 4 — `T` in the lambda's RESULT only
function retT<T>(a: T): T {
  const g = (): T => a
  return g()
}

function inc(q: i32): i32 { q + 1 }

function body() {
  const xs: i32[] = [1, 2]
  const ys: i32[] = [1, 2]
  print(eqCap(xs, ys))
  print(lenPlus(xs))
  print(applyCall(inc))
  print(retT(2))
  print(applyId(inc))
}
body()
