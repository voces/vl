// @run
// @log 1.5
// @log 5
// @log 4
// @log 1.5
// @log true
// @log false
// A `??` over a hole called at `i64 | null` and at a never-null pin of another width reads the
// join `i64 | f64` in the first instance and the pin in the others (D9913).
function take(a) {
  const r2 = a ?? 0.5
  print(r2 + 1)
}
const zn: i64 | null = null
take(zn)
take(4.0)
const zi = 3
take(zi)
const w = zn
take(w)
function small(a) {
  const r = a ?? 0.5
  const s = r + 1
  return s < 2
}
const b = small(zn)
print(b)
print(small(4.0))
