// @run
// @log n
// @log z
// @log n
// @log b
// @log 9
// @log 5
// @log n
// @log z
// @log y
// @log z
// A `??` over an un-annotated join whose `null` arrives only at the pin is decided by the
// instance, not folded away in the shared template body (D4170).
type K = "a" | "b"
function g<T>(a1: T, k: i32) {
  const v = if k == 1 { a1 } else { "z" }
  print(v ?? "n")
}
function gk<T>(a1: T, k: i32) {
  const v = if k == 1 { a1 } else { "b" }
  print(v ?? "n")
}
function gi<T>(a1: T, k: i32) {
  const v = if k == 1 { a1 } else { 5 }
  print(v ?? 9)
}
function gr<T>(a1: T, b: string, k: i32) {
  const v = if k == 1 { a1 } else { b }
  print(v ?? "n")
}
const x1: string | null = null
g(x1, 1)
g(x1, 2)
const xk: K | null = null
gk(xk, 1)
gk(xk, 2)
const xi: i32 | null = null
gi(xi, 1)
gi(xi, 2)
gr(x1, "z", 1)
gr(x1, "z", 2)
g("y", 1)
g("y", 2)
