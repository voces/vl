// @emit-error `is` cannot tell {[i32]:i32} from {[i32]:boolean} yet: this instance's union holds both
// The union-pattern twin of `error-pin-same-rep-maps-is.vl`: `is IS` at a pin of
// `IM | BM | string` names one of the two same-rep maps, so the instance's tag test is refused.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
type IS = IM | string
const mb: BM = Map()
mb.set(1, true)
function k<T>(u: T) {
  if u is IS { print("wrong") } else { print("bool") }
}
const v: IM | BM | string = mb
k(v)
