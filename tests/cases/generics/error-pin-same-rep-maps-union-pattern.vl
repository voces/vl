// @check
// @error `k` tests its `T` with `is`, `match` or `as`, and this call binds it to
// The union-pattern twin of `error-pin-same-rep-maps-is.vl`: `is IS` at a pin of
// `IM | BM | string` names one of the two same-rep maps, so it is refused at the call.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
type IS = IM | string
const mb: BM = Map()
mb.set(1, true)
function k<T>(u: T) {
  if u is IS { print("wrong") } else { print("bool") }
}
const v: IM | BM | string = mb
k(v)
