// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// A `??` over a declared parameter keeps its default's own type at every pin, as the `if` it
// spells does: an `f64` default at an `i32` pin is the union of the two (D3580), and a literal
// default at a `string` pin is still an `i32` (D3619).
function g<A>(q: A | null, b: f64) { q ?? b }
function h2(): i32 | null { 7 }
function h3(): i32 | null { null }
function h4(): string | null { "x" }
print(g(h2(), 2.25))
print(g(h2(), 2.25) is i32)
print(g(h3(), 2.25))
print(g(h4(), 2.25))
function F<A>(_a: A) {
  const v: A | null = null
  print((v ?? 9) is i32)
  print(v ?? 9)
}
F("s")
F(true)
function P<A, B>(q: A | null, d: B) { q ?? d }
print(P(h3(), "u"))
print(P(h2(), "u"))
// @log 7
// @log true
// @log 2.25
// @log x
// @log true
// @log 9
// @log true
// @log 9
// @log u
// @log 7
