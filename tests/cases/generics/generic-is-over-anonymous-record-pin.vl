// @run
// @log other
// @log not int
// @log v-other
// @log int
// @log v-int
// @log other
// @log 6
// @log other
// @log int
// @log other
// @log other
// @log int
// @hint redundant type annotation: `r` is inferred as `T | i32`
// @hint redundant type annotation: `r` is inferred as `T | i32`
// D12641: `is i32` over `T | i32` with `T` pinned to an anonymous record, as a statement test,
// a negated test and a value `if`, a two-field record and a read narrowed by the test, a
// reassigned `let`, three pins of one generic, and the un-annotated spelling.
function h<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is i32 { print("int") } else { print("other") }
  if !(r is i32) { print("not int") }
  print(if r is i32 { "v-int" } else { "v-other" })
}
h({ x: 9 }, true)
h({ x: 9 }, false)
function g<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is i32 { print(r + 1) } else { print("other") }
}
g({ x: 9, s: "a" }, true)
g({ x: 9, s: "a" }, false)
function k<T>(a: T, c: boolean) {
  let r: T | i32 = 5
  if c { r = a }
  if r is i32 { print("int") } else { print("other") }
}
k({ x: 9 }, true)
k({ y: "s" }, false)
k(3.5, true)
function u<T>(a: T, c: boolean) {
  const r = if c { a } else { 5 }
  if r is i32 { print("int") } else { print("other") }
}
u({ x: 9 }, true)
u({ x: 9 }, false)
