// @run
// @log 7
// @log s
// @log 8
// @log 1
// @log s
// @log s
// @log t
// @log 1
// @log 7
// @log s
// @log 8
// @log 2
// @log s
// @log s
// @log t
// @log 2
// A capturing hole lambda inside a generic, called at one type and then delivered as a value
// at another, directly and through an alias, with the captured binding written in between: each
// instance of the enclosing generic holds its own closure (D3928).
function call(f: (n: i32) => void, n: i32) { f(n) }
function direct<T>(x: T, y: T) {
  let v = x
  const h = (u) => {
    print(v); print(u)
  }
  h("s")
  v = y
  call(h, 1)
}
function aliased<T>(x: T, y: T) {
  let v = x
  const h = (u) => {
    print(v); print(u)
  }
  h("s")
  const k = h
  const g: (n: i32) => void = k
  v = y
  g(2)
}
direct(7, 8)
direct("s", "t")
aliased(7, 8)
aliased("s", "t")
