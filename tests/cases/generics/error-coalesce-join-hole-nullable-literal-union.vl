// @emit-error a string join whose arm is a nullable literal union was typed non-null here
// A `??` joined with the other parameter at a `K | null` pin: the join is typed `string`,
// dropping the null `b` carries, so it is refused rather than built into a non-null string
// (D3290). The program is legal; this pins the refusal until the join keeps the null.
type K = "a" | "b"
function g(a, b, c: boolean) {
  const r = if c { a ?? "b" } else { b }
  print(r)
}
const u: K | null = "a"
const w: K | null = null
g(u, w, false)
