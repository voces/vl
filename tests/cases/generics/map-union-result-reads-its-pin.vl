// @run
// @hint Intentionally-unused parameter `_e` (leading `_` marks it unused)
// @log 4
// @log 4
// @log 2.5
// @log 2.5
// @log q
// @log 9
// @log true
// @log null
// @log 1
// A union-returning `.map`'s result element is the union its instance pins, not the first union
// the module declares, whatever else is declared and however many instances there are (D3092).
type AB = "a" | "b"
type U = i32 | string
function f<T>(x: T) { print([x].map((e) => e)[0]) }
function g(x) {
  const m = [x].map((e) => e)
  print(m[0])
}
const a: i32 | null = 4
f(a)
g(a)
const b: f64 | null = 2.5
f(b)
g(b)
function h(x) { print([1, 2].map((_e) => x)[0]) }
const c: i32 | string = "q"
h(c)
const d: i32 | null = 9
h(d)
function w<T>(x: T) {
  for y in [x].map((e) => e) { print(y) }
}
const t: boolean | null = true
w(t)
const n: boolean | null = null
w(n)
print([a].map((e) => e).length)
