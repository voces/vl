// @run
// @log false
// @log w
// @log true
// @log false
// @log 3
// D2573: a generic returning its in-place lambda's result, un-annotated, at a nullable `T`
// declares that nullable type as the instance's result, as the `: T` spelling does.
function k<T>(v: T) { return ((p: T) => p)(v) }
function kb<T>(v: T) {
  const f = (p: T) => p
  return f(v)
}

const w = k<string | null>("w")
print(w == null)
print(w ?? "-")
print(k<i32 | null>(null) == null)
const s: string | null = "z"
print(kb(s) == null)
const t: i32 | null = 3
print(kb(t) ?? -1)
