// @log 3
// @log true
// @log a
// @log true
// @log true
// A lambda joining two parameter holes at a `K | null` pin beside a number or a boolean returns
// the box with every arm's value box registered, so each arm reads back as itself (D3520).
type K = "a" | "b"
const xn: K | null = "a"
function F(k: i32, a, b) {
  const g = () => {
    if k == 0 { a } else { b }
  }
  const v = g()
  print(v == null)
  print(v is K)
  print(v)
}
F(0, xn, 3)
F(1, xn, 3)
function B(k: i32, a, b) {
  const g = () => {
    if k == 0 { a } else { b }
  }
  const v = g()
  print(v != null)
  print(v)
}
B(0, xn, true)
B(1, xn, true)
