// @run
// @log A
// @log is a
// @log a
// @log err
// @log E
// @log B
// @log b
// @log err
// D2167: a `T | "err"` result with `T` bound to a literal union, inline or through an alias, is
// one literal set; `==`, `is`, `print` and the `"err"` arm all read it, and a declared
// destination of the same set takes it.
type AB = "a" | "b"
function wrap<T>(x: T, fail: boolean): T | "err" {
  if fail { return "err" }
  x
}
function ka(): "a" | "b" { "a" }
function kb(): AB { "b" }
function main() {
  const r = wrap(ka(), false)
  if r == "a" { print("A") } else { print("not A") }
  if r is "a" { print("is a") }
  print(r)
  const e = wrap(ka(), true)
  print(e)
  if e == "err" { print("E") }
  const q = wrap(kb(), false)
  if q == "b" { print("B") }
  print(q)
  const s: "a" | "b" | "err" = wrap(ka(), true)
  print(s)
}
main()
