// @run
// @log 1003
// @log generic f
// @log x
// A parameter named like a nested generic is the value an alias of that name copies, not the
// generic (D3894 review).
function a() {
  function f<U>(y: U) { print("generic f"); print(y) }
  function sib(f: (n: i32) => void) {
    const h = f
    const h2 = h
    h2(3)
  }
  sib((n: i32) => print(n + 1000))
  f("x")
}
a()
