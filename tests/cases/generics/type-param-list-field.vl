// @run
// @log 2
// @log 5
// @log z
// @log 1
// A generic type ALIAS whose body puts the type PARAMETER under an ARRAY
// (`type Box<T> = { v: T[] }`). Every instantiation was an emit error on master —
// "only i32[] arrays and struct/union element arrays are supported", a message that
// NAMES the case it was rejecting, since `Box<i32>` makes `v: i32[]`. `vl check` was
// rc=0 throughout.
//
// The substitution was never the problem. `collectA`'s arena scan reaches the ALIAS
// DECLARATION's own `T[]` annotation node — un-substituted, because a generic alias
// declares no concrete struct and only its APPLICATIONS intern a shape (`gaeEnsure`).
// `collectA` has an arm for exactly this, `genTyParamArr`, and it knew only the
// FuncDecl half of where VL binds a type parameter (`genTyParamNames`, gathered from
// `fnTyParams`); the ALIAS half is folded into the declared name by the parser and
// split back out into `gaeParams`. So the alias's `T[]` fell past that arm to
// `checkArrName`. Both halves are skipped for the same reason: neither declaration is
// ever emitted, and the instance's pinned names force what the instance needs.
//
// Element type, field count, parameter count, instantiation count and use position
// were all irrelevant — the reject fires on the DECLARATION alone (see the sibling
// `type-param-list-field-uninstantiated.vl`).
type Box<T> = { v: T[] }

const bi: Box<i32> = { v: [4, 5] }
print(bi.v.length)
print(bi.v[1])

const bs: Box<string> = { v: ["z"] }
print(bs.v[0])
print(bs.v.length)
