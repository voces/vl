// @log 3
// @log 2
// @log 3
// @log 1
// A returned type parameter's list and a concrete list stay apart at a pin that stores their
// elements differently, in every position the result reaches; only a fresh list literal is
// built at the join (D4862).
function w<T>(t: T, b: boolean, q: i32[]) {
  if b { return [t] }
  q
}
function g<T>(t: T, b: boolean) {
  const q = [5, 6]
  const v = w(t, b, q)
  print(v.length)
}
function inl<T>(t: T, b: boolean, q: i32[]) { print(w(t, b, q).length) }
function back<T>(t: T, b: boolean, q: i32[]) { w(t, b, q) }
function elem<T>(t: T, b: boolean, q: i32[]) {
  const v = w(t, b, q)
  for e in v { print(e) }
}
const x: i32 | null = null
const q = [5, 6]
g(x, true)
g(x, false)
inl(x, true, q)
inl(x, false, q)
elem(x, true, q)
elem(x, false, q)
print(back(x, true, q).length)
print(back(x, false, q).length)
const r = w(x, false, q)
print(r.length)
// The concrete list returned first, a literal of the parameter last.
function w2<T>(t: T, b: boolean, q: i32[]) {
  if b { return q }
  [t, t, t]
}
function g2<T>(t: T, b: boolean, q: i32[]) {
  const v = w2(t, b, q)
  print(v.length)
}
const y: i32 | null = 4
g2(y, true, [1, 2])
g2(y, false, [1, 2])
// A literal of concrete elements adapts to the join; the held list and the parameter's do not.
function w3<T>(t: T, k: i32, q: (i32 | null)[]) {
  if k == 0 { return [1, 2] }
  if k == 1 { return q }
  [t]
}
function g3<T>(t: T, k: i32, q: (i32 | null)[]) {
  const v = w3(t, k, q)
  print(v.length)
}
const q3: (i32 | null)[] = [5, null, 6]
g3(3, 0, q3)
g3(3, 1, q3)
g3(3, 2, q3)
