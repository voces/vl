// @run
// @log 3
// @log 7
// @log s
// @log 4
// Each instance of a generic `new` type is its own erased brand (owner ruling A14 (a)): it is
// delivered through a field, a list, a return and a generic function, and read back.
type Texture = { t: i32 }
type Mesh = { m: i32 }
type Handle<T> = new i32
type Box<T> = new { v: T, n: i32 }
type Mat = { tex: Handle<Texture>, mesh: Handle<Mesh> }

function same<T>(h: Handle<T>): Handle<T> { h }
function get<T>(b: Box<T>): T { b.v }
function mesh(m: Mat): Handle<Mesh> { m.mesh }

const m: Mat = { tex: 3 as Handle<Texture>, mesh: 4 as Handle<Mesh> }
const hs = [same(m.tex), 4 as Handle<Texture>]
print(hs[0] as i32)
print((hs[1] as i32) + (m.tex as i32))
const b: Box<string> = { v: "s", n: 0 }
print(get(b))
print(mesh(m) as i32)
