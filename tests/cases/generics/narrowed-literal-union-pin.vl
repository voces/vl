// @run
// @log true
// @log true
// @log true
// @log false
// D3098: a generic called with a literal-union value narrowed out of a `K | i32` box pins its
// type parameter at `K`, with the callback annotated, un-annotated, and over a walk variable.
type K = "a" | "b"
function app<T>(x: T, f: (T) => boolean) { return f(x) }
const q: K | i32 = "a"
if !(q is i32) { print(app(q, (w: K) => w == "a")) }
if !(q is i32) { print(app(q, (w) => w == "a")) }
const zs: (K | i32)[] = ["a", 3, "b"]
for z in zs {
  if !(z is i32) { print(app(z, (w) => w == "a")) }
}
