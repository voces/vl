// @run
// @log 3.5
// @log 3.5
// @log 3.5
// @log 3
// @log 3.5
// @log 5
// @log 3
// @log 12
// @log true
// @log 5
// @log 5
// @log 5
// @log 1.5
// @log 10
// @log 5
// @log 2
// @log 2
// @log 0.75
// @log 0.75
// @log 2
// @log 2
// @log 2
// @log 0.5
// @log 4
// @log 1
// @hint redundant type annotation: `zi` is inferred as `i32`
// @hint redundant type annotation: `zw` is inferred as `i32`
// A `<T>` body's list of `x` beside `x + 1.5` holds `f64` at an `i32` pin, as the un-annotated
// `g(x)` does (D9680); `g(2.0)` and `[x, x + 1]` are the controls. A `??` over a parameter pinned
// at a never-null number has a dead default whatever its width, so it is the pin (D9870, D9910,
// D9914): `wide(zw) / 2` divides an `i32`. The nullable pins are the controls (D9913).
function g<T>(x: T) {
  const xs = [x, x + 1.5]
  print(xs[1])
}
g(2)
g(2.0)
function gr<T>(x: T) { return [x, x + 1.5] }
print(gr(2)[1])
function gi<T>(x: T) {
  const xs = [x, x + 1]
  print(xs[1])
}
gi(2)
function gh(x) {
  const xs = [x, x + 1.5]
  print(xs[1])
}
gh(2)
function take(a) {
  const r2 = a ?? 0.5
  print(r2 + 1)
}
const z: i64 = 4
take(z)
function ops(a) {
  const r2 = a ?? 0.5
  print(r2 - 1)
  print(r2 * 3)
  print(r2 < 5)
}
ops(z)
function tk<T>(a: T) {
  const r2 = a ?? 0.5
  print(r2 + 1)
}
tk(z)
const zi: i32 = 4
take(zi)
take(4.0)
function takeN(a) {
  const r2 = a ?? 0.5
  print(r2 + 1)
}
const zn: i64 | null = null
takeN(zn)
function back(a) {
  const r2 = a ?? 0.5
  return r2 + 1
}
const q = back(z)
if q is i64 { print(q * 2) }
const takeL = (a) => {
  const r2 = a ?? 0.5
  return r2 + 1
}
print(takeL(z))
function wide(x) { return x ?? 1.5 }
const zw: i32 = 5
print(wide(zw) / 2)
function wideT<T>(x: T) { return x ?? 1.5 }
print(wideT(zw) / 2)
const wn: i32 | null = null
print(wide(wn) / 2)
print(wideT(wn) / 2)
const wy = wide(zw)
print(wy / 2)
const wl = [wide(zw)]
print(wl[0] / 2)
const wr = { v: wide(zw) }
print(wr.v / 2)
function wideD(x) { return x ?? 0.5 }
const wm: i64 | null = 4
const wq: i64 | null = null
print(wideD(wq))
print(wideD(wm))
const wz: i64 = 3
print(wideD(wz) / 2)
