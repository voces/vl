// @run
// @log 2
// @log a
// @log none
// @log 2
// A generic's returned record holding `[x, null]` builds its `(T | null)[]` field at a literal-union
// pin, annotated or inferred (D10934).
type K = "a" | "b"
function f<T>(x: T): { g: (T | null)[] } { return { g: [x, null] } }
const k: K = "a"
const r = f(k)
print(r.g.length)
print(r.g[0] ?? "none")
print(r.g[1] ?? "none")
function h<T>(x: T) { return { g: [x, null] } }
print(h(k).g.length)
