// @run
// @log 2
// @log y
// A recursive local type inside a generic function that mentions the type parameter: a
// recursive generic alias per instance, built and walked like the module-scope one.
function build<T>(a: T, b: T): T {
  type N = { v: T, next: N | null }
  const n: N = { v: a, next: { v: b, next: null } }
  const nx = n.next
  if nx != null { return nx.v }
  return n.v
}
print(build(1, 2))
print(build("x", "y"))
