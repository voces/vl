// @check
// GRADUATED from `silent-class-inventory` D691 — the RECEIVER-CLASSIFICATION capability,
// lost in the instantiation exactly the way D401's printability was.
//
// `checkMemberNode`'s `TyVar` arm ADMITS `.length` on every type variable and
// `checkIndexNode`'s ADMITS `x[i]` on every type variable. Both admissions are right: a `T`
// pinned to a list / string / map / set has both, and D14 measured that refusing them in the
// BODY refuses the eight argument reps that work. What neither arm did was re-ask the
// question at the PIN, where `T` is known — so `g<T>(x: T) { print(x.length) }` at `g(true)`
// was `vl check` rc 0 and the EMITTER was left holding it (`'.length' on a receiver the
// emitter cannot classify as a list, string, map or set`), while the one-annotation-different
// direct spelling is a positioned `member access '.length' on non-object boolean`.
//
// EVERY REFUSAL BELOW IS THE DIRECT SPELLING'S OWN SENTENCE, and the pairing is what makes
// that checkable: each `…Direct` writes the operation out at the concrete type and each
// `…Pinned` reaches the identical operation through a type parameter. One annotation is the
// whole difference, so the diagnostics are one attribution apart and no more. `memberFloorMsg`
// / `indexFloorMsg` are that single home — the ARM and the PIN both call them.
//
// The accept set — every receiver rep whose `.length` / `x[i]` through a type parameter is
// still admitted — is the sibling fixture `receiver-classification-at-pin-runs.vl`, which
// reads its answers back.
//
// `idxI32Pinned` IS THE BOUND, PINNED. A scalar or map receiver reached through the bare
// parameter is already reported by the argument-flow gate (`holeIsArrayDemanded` +
// `tyRefusesArrayDemand`), several lines before the constraint pin runs, so the pin defers to
// it and the reader gets ONE sentence. That deference is what this case asserts: if the pin
// ever stops deferring, this file gains a second diagnostic and fails.
//
// MEASURED: `scripts/silent-sweep/d14/lengrid.py`, 60 cells over 15 argument reps at two
// operations beside their concrete twins. 11 were `loud emit reject` beside a `loud check
// reject` twin on master and all 11 are check rejects now; the distilled corpus moves those
// 11 plus D651's six lambda-shaped ones, 0 `runs` lost and 0 cells moved to silent.

// @error member access '.length' on non-object i32
// @error member access '.length' on non-object i32 (the body of `gLen` at the call's argument types)
// @error member access '.length' on non-object f64
// @error member access '.length' on non-object f64 (the body of `gLen` at the call's argument types)
// @error member access '.length' on non-object boolean
// @error member access '.length' on non-object boolean (the body of `gLen` at the call's argument types)
// @error no field 'length' on Circle
// @error no field 'length' on Circle (the body of `gLen` at the call's argument types)
// @error member access '.length' on non-object i32 | null
// @error member access '.length' on non-object i32 | null (the body of `gLen` at the call's argument types)
// @error member access '.length' on non-object (i32) => i32
// @error member access '.length' on non-object (i32) => i32 (the body of `gLen` at the call's argument types)
// @error field 'length' is not on every member of Shape — narrow with `is` first (no 'length' on Ca)
// @error field 'length' is not on every member of Shape — narrow with `is` first (no 'length' on Ca) (the body of `gLen` at the call's argument types)
// @error field 'length' is not on every member of K — narrow with `is` first ("a" is not an object)
// @error field 'length' is not on every member of K — narrow with `is` first ("a" is not an object) (the body of `gLen` at the call's argument types)
// @error member access '.length' on non-object i32
// @error member access '.length' on non-object i32 (the body of `lamLen` at the call's argument types)
// @error cannot index non-array Circle
// @error cannot index non-array Circle (the body of `gIdx` at the call's argument types)
// @error cannot index non-array i32 | null
// @error cannot index non-array i32 | null (the body of `gIdx` at the call's argument types)
// @error cannot index non-array (i32) => i32
// @error cannot index non-array (i32) => i32 (the body of `gIdx` at the call's argument types)
// @error cannot index non-array Shape
// @error cannot index non-array Shape (the body of `gIdx` at the call's argument types)
// @error cannot index non-array i32
// @error argument 1: expected an array, got i32

type Circle = { r: i32 }
type Ca = { n: i32 }
type Sq = { s: i32 }
type Shape = Ca | Sq
type K = "a" | "b"

// `gLen` and `gIdx` NAME THEIR PARAMETERS DIFFERENTLY, and the rename is load-bearing rather
// than cosmetic: a hole's ARRAY DEMAND is keyed by the type-parameter NAME, so with both
// generics on `T` the demand `gIdx`'s `x[0]` records would reach `gLen`'s call sites and add
// an unrelated diagnostic to a fixture whose whole point is a one-for-one pairing.
function gLen<T>(x: T) { print(x.length) }
function gIdx<U>(x: U) { print(x[0]) }

// D651's SHAPE: the receiver is a LAMBDA's parameter, typed by the enclosing generic's `V`.
// The constraint is owned by `lamLen` (the innermost top-level declaration on the checking
// stack when the lambda body is checked), so `lamLen`'s own pin adjudicates it.
function lamLen<V>(a: V): i32 {
  const inner = (x: V): i32 => x.length
  return inner(a)
}

function mknul(): i32 | null { 7 }
function mkshape(): Shape { { n: 7 } }
function id1(q: i32): i32 { q }

// ── `.length` on a receiver that has none ─────────────────────────────────────────────
function lenI32Direct(v: i32) { print(v.length) }
function lenI32Pinned(v: i32) { gLen(v) }
function lenF64Direct(v: f64) { print(v.length) }
function lenF64Pinned(v: f64) { gLen(v) }
function lenBoolDirect(v: boolean) { print(v.length) }
function lenBoolPinned(v: boolean) { gLen(v) }
function lenRecDirect(v: Circle) { print(v.length) }
function lenRecPinned(v: Circle) { gLen(v) }
function lenNulDirect(v: i32 | null) { print(v.length) }
function lenNulPinned(v: i32 | null) { gLen(v) }
function lenFnDirect(v: (i32) => i32) { print(v.length) }
function lenFnPinned(v: (i32) => i32) { gLen(v) }
function lenUnionDirect(v: Shape) { print(v.length) }
function lenUnionPinned(v: Shape) { gLen(v) }
function lenLitDirect(v: K) { print(v.length) }
function lenLitPinned(v: K) { gLen(v) }
function lenLamDirect(v: i32): i32 {
  const inner = (x: i32): i32 => x.length
  return inner(v)
}
function lenLamPinned(v: i32): i32 { return lamLen(v) }

// ── `x[0]` on a receiver that cannot be indexed ───────────────────────────────────────
function idxRecDirect(v: Circle) { print(v[0]) }
function idxRecPinned(v: Circle) { gIdx(v) }
function idxNulDirect(v: i32 | null) { print(v[0]) }
function idxNulPinned(v: i32 | null) { gIdx(v) }
function idxFnDirect(v: (i32) => i32) { print(v[0]) }
function idxFnPinned(v: (i32) => i32) { gIdx(v) }
function idxUnionDirect(v: Shape) { print(v[0]) }
function idxUnionPinned(v: Shape) { gIdx(v) }
// THE BOUND: the argument-flow gate speaks first for a scalar, so the pin stays silent.
function idxI32Direct(v: i32) { print(v[0]) }
function idxI32Pinned(v: i32) { gIdx(v) }

function body() {
  lenI32Direct(7)
  lenI32Pinned(7)
  lenF64Direct(1.5)
  lenF64Pinned(1.5)
  lenBoolDirect(true)
  lenBoolPinned(true)
  const c: Circle = { r: 7 }
  lenRecDirect(c)
  lenRecPinned(c)
  const nu = mknul()
  lenNulDirect(nu)
  lenNulPinned(nu)
  lenFnDirect(id1)
  lenFnPinned(id1)
  const sh = mkshape()
  lenUnionDirect(sh)
  lenUnionPinned(sh)
  const kk: K = "a"
  lenLitDirect(kk)
  lenLitPinned(kk)
  print(lenLamDirect(1))
  print(lenLamPinned(1))
  idxRecDirect(c)
  idxRecPinned(c)
  idxNulDirect(nu)
  idxNulPinned(nu)
  idxFnDirect(id1)
  idxFnPinned(id1)
  idxUnionDirect(sh)
  idxUnionPinned(sh)
  idxI32Direct(7)
  idxI32Pinned(7)
}
body()
