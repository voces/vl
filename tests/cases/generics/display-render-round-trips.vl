// @run
// CONTRACT: what the DISPLAY renderer prints must be a spelling the reader can WRITE.
// A hint that says "`q` is inferred as X — remove the annotation" is an instruction, so
// X has to parse, denote the same type, and compile. The structural expansion is not
// always any of those: measured over a 256-cell generic-alias grid (2 arities x 8
// argument kinds x 8 positions x exported), the structural render written back as the
// annotation round-trips in 56 of 256 cells, and the 200 failures are 120 emit rejects
// (`emitProgram: binding's inline-shape type has an unsupported field` — the very
// spelling the hint offered), 20 check-clean INVALID WASM, and 60 parse errors. The
// nominal render round-trips in 224 of 256; the residue is one position, below.
//
// PIN 1 — the render. Red before the display renderer had its nominal legs (master spells
// these `{a: i32[], b: i32}` and `{v: {n: i32}}`).
// @hint redundant type annotation: `q` is inferred as `Pair<i32[],i32>`
// @hint redundant type annotation: `b` is inferred as `Box<Sx>`
// @hint redundant type annotation: `qr` is inferred as `Pair<i32[],i32>`
// @hint redundant type annotation: `qb` is inferred as `Pair<i32[],i32>`
// @hint redundant type annotation: `br` is inferred as `Box<Sx>`
// @hint redundant type annotation: `bb` is inferred as `Box<Sx>`
//
// PIN 2 — the ROUND TRIP, and it is GREEN ON MASTER TOO, by construction: it pins that
// the string pin 1 shows is usable, not that the renderer changed. `qr`/`br` are
// annotated with the render VERBATIM — spaceless, the separator `genAppNameOfTy` emits —
// and assigned back to the source's own spelling, so both directions of assignability
// hold and in a structural language that is type identity. The structural spelling this
// replaces does NOT round-trip: `const q: { a: i32[], b: i32 } = mkq()` is
// `emitProgram: binding's inline-shape type has an unsupported field` on master and here.
//
// PIN 3 — the boundary in the OTHER direction, also green on master by construction: the
// nine checker sites that produce an emitter TABLE KEY (`nodeArrayElemName`, `nodeTyName`,
// the inferred-return recorders) must keep the STRUCTURAL render. The `.map` below is
// their witness: its callback param carries no annotation, so `synthParamAnnots`
// synthesizes one from the recorded element type and resolves it with
// `structIndexOfTypeName`, which matches a `{…}` shape by field set and has no route from
// `Animal`/`Cat`. Point those sites at the nominal entry and this line becomes
// `emitProgram: field access but no struct type declared`.
// THE RESIDUE, PINNED RATHER THAN HIDDEN: `xs` keeps the STRUCTURAL spelling. All three
// nominal legs are reverse maps over arena INDEX identity (`cStructTyIxs`, `cUnionTyIxs`,
// `gaAppTyIxs`), so they answer only for the index the DECLARATION registered. The array
// literal below mints its own union of its own inline shapes, structurally equal to
// `Animal` and a different index, and no leg can see it. The axis of what still renders
// structurally is therefore WHICH PASS PRODUCED THE INDEX — not the position, not the
// arity, not the argument kind, all of which the 256-cell grid measures inert.
// @hint redundant type annotation: `xs` is inferred as `{meow: i32} | {woof: i32}[]`
// @log 7
// @log 1
// @log 9
// @log 1
// @log 2
type Sx = { n: i32 }
type Cat = { meow: i32 }
type Dog = { woof: i32 }
type Animal = Cat | Dog
type Pair<A, B> = { a: A, b: B }
type Box<T> = { v: T }

function mkq(): Pair<i32[], i32> { return { a: [7], b: 1 } }
function mkb(): Box<Sx> { return { v: { n: 9 } } }

function main() {
  const q: Pair<i32[], i32> = mkq()
  print(q.a[0])
  const qr: Pair<i32[],i32> = q
  const qb: Pair<i32[], i32> = qr
  print(qb.b)

  const b: Box<Sx> = mkb()
  const br: Box<Sx> = b
  const bb: Box<Sx> = br
  print(bb.v.n)

  const xs: Animal[] = [{ meow: 1 }, { woof: 2 }]
  const cats = xs.map((a) => if a is Cat { a } else { { meow: a.woof } })
  print(cats[0].meow)
  print(cats[1].meow)
}
main()
