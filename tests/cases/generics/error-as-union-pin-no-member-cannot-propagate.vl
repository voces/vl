// @check
// @error `as Set<i32>` propagates string | null, which the enclosing function cannot return (it returns i32)
// A bare `as` that misses at a pin propagates its operand, so the enclosing function must be able
// to return it, as the direct spelling's remainder must (D16323).
function count<T>(u: T | null): i32 {
  const w = u as Set<i32>
  return w.length
}
print(count<string>("ab"))
