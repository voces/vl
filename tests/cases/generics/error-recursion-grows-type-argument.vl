// @error this call to `f1` binds `T` to a type built from itself
// @error this call to `f2` binds `T` to a type built from itself
// @error this call to `f3` binds `T` to a type built from itself
// @error this call to `f4` binds `T` to a type built from itself
// @error this call to `f5` binds the type of an un-annotated parameter of `f5` to a type built from itself
// @error this call to `g6` binds `U` to a type built from `T`, and the calls lead back to bind `T` again
// @error this call to `f6` binds `T` to a type built from `U`, and the calls lead back to bind `U` again
// A generic recursion whose call binds a type parameter to a larger type built from it needs a
// new instance at every depth, so monomorphization has no finite set to compile: a list, an
// explicit type argument, a record alias, a closure, an un-annotated parameter, and a cycle
// through a second function (D2721).
function f1<T>(u: T, n: i32): i32 {
  if n == 0 { return 0 }
  return f1([u], n - 1) + 1
}
print(f1(1, 3))

function f2<T>(u: T | null, n: i32) {
  if n == 0 { print(u == null) } else { f2<T[]>(null, n - 1) }
}
f2<i32>(1, 2)

type Box<T> = { v: T }
function f3<T>(u: T, n: i32): i32 {
  if n == 0 { return 0 }
  return f3<Box<T>>({ v: u }, n - 1) + 1
}
print(f3(1, 3))
function f4<T>(u: T, n: i32): i32 {
  if n == 0 { return 0 }
  return f4(() => u, n - 1) + 1
}
print(f4(1, 3))
function f5(u, n: i32): i32 {
  if n == 0 { return 0 }
  return f5([u], n - 1) + 1
}
print(f5(1, 3))
function f6<T>(u: T, n: i32): i32 {
  if n == 0 { return 0 }
  return g6({ x: u }, n - 1) + 1
}
function g6<U>(u: U, n: i32): i32 { return f6([u], n) }
print(f6(1, 3))
