// @run
// @log 5.5
// A binding initialised by a call to a function that declares its result holds the value at the
// written type: D16739's chain walk does not follow such a call to the function it returns.
function id1(a) { return a }
const inner = [{ f: id1, n: 3 }]
function __deliver(): { f: (a: f64) => f64, n: i32 }[][] { return [inner] }
const v = __deliver()
print(v[0][0].f(v[0][0].n) + v[0][0].f(2.5))
