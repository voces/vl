// @run
// @log true
// @log false
// @log false
// @log false
// @log false
// @log false
// @log false
// @log false
// @log false
// @log false
// @log false
// @log true
// @hint Intentionally-unused parameter
// @hint redundant type annotation
// CONTRACT (D1117): a lambda inside a generic body that neither annotates a type parameter
// nor captures anything, but NAMES one in its body, is a TEMPLATE — one clone per pin.
//
// `monoLamNodeIsTemplate` read three things: a parameter annotation mentioning a type
// parameter, a return annotation mentioning one, and (D943) a non-zero capture count.
// `() => gi is T` has none of the three, so ONE lifted slot served every instantiation and
// the shared body answered the FIRST pin's `is` spelling at every pin. Not invalid wasm —
// check-clean SILENTLY WRONG: `print(first(2))` printed `false` for an `i32` global at
// `T := i32`.
//
// THE FOURTH RUNG IS A BODY SCAN for the two spellings `monoFoldTyParamLayout` substitutes:
// an `is` whose check type mentions a type parameter, and a `T.field` layout constant. The
// clone gate in `monoCloneLambdaSubst` asks the same question, or the prune would stub a
// template no clone replaced.
//
// SWEEP THE ORDER AS WELL AS THE SHAPE. `first` puts the matching instantiation FIRST and
// `later` puts it LAST; a shared body answers the same for both, a cloned one does not.
const gi = 7

function first<T>(_v: T): boolean {
  const g = () => gi is T
  g()
}

function later<T>(_w: T): boolean {
  const h = () => gi is T
  h()
}

type Pt = { x: i32 }
const pt: Pt = { x: 1 }
const li: i32[] = [1]
const mp: {[string]: i32} = Map()
const bi: i64 = 9

print(first(2))       // T := i32     — `gi` IS an i32
print(first("a"))     // T := string
print(first(1.5))     // T := f64
print(first(true))    // T := boolean
print(first(bi))      // T := i64
print(first(pt))      // T := Pt
print(first(li))      // T := i32[]
print(first(mp))      // T := {[string]: i32}

print(later("a"))     // the string pin is instantiated FIRST here
print(later(1.5))
print(later(true))
print(later(2))       // …and the i32 pin LAST — still `true`
