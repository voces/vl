// @run
// @log fs
// @log 5
// @log 1.5
// @log a
// @log 7
// An un-annotated list literal of a hole-typed value, bound to a local, builds the list its pin
// names when the element is a value union or a list, as it does at a scalar pin (D2898).
function wrap(x) {
  const r = x
  const xs = [r]
  return xs[0]
}
const fs: f64 | string = "fs"
const a = wrap(fs)
if a is f64 { print(a / 2.0) } else { print(a) }
const ist: i32 | string = 4
const b = wrap(ist)
if b is i32 { print(b + 1) } else { print(b) }
const fl = [0.5, 1.5]
print(wrap(fl)[1])
const sl = ["a", "b"]
print(wrap(sl)[0])
print(wrap(7))
