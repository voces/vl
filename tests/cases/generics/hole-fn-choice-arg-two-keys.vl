// @log 1
// D13360: an `if` or `match` choosing un-annotated or generic functions, handed to a parameter
// the callee calls at two types, is evaluated once and hands each per-type slot its chosen arm:
// as a statement, a `let` initialiser, a return, after an argument, nested, and in a loop.
function both(f) {
  print(f("a"))
  print(f(1))
}
function inner(s) { return s }
function ask(s) { return s }
function twice(s) { return s + s }
function pick(c: boolean) { both(if c { inner } else { ask }) }
pick(true)

function nested(c: boolean) {
  function inner(s) { return s }
  function ask(s) { return s }
  both(if c { inner } else { ask })
}
nested(true)

function bothRet(f, k: i32) {
  print(f("a"))
  return f(k)
}
function letInit(c: boolean) {
  const r = bothRet(if c { inner } else { ask }, 2)
  print(r)
}
letInit(false)
function retPos(c: boolean) { return bothRet(if c { inner } else { ask }, 3) }
print(retPos(true))

let n = 0
function tick() {
  n = n + 1
  return n > 1
}
both(if tick() { inner } else { twice })
both(if tick() { inner } else { twice })
print(n)

function bothAfter(k: i32, f) {
  print(k)
  print(f("a"))
  print(f(1))
}
function ahead(c: boolean) { bothAfter(7, if c { inner } else { ask }) }
ahead(true)

function elseArm(c: boolean) { both(if c { inner } else { twice }) }
elseArm(false)

function byMatch(k: i32) {
  both(
    match k {
      0 => inner
      _ => ask
    },
  )
}
byMatch(1)

function elseIf(k: i32) {
  both(if k == 0 { inner } else if k == 1 { ask } else { twice })
}
elseIf(0)

function gInner<T>(s: T): T { return s }
function gAsk<T>(s: T): T { return s }
function generic(c: boolean) { both(if c { gInner } else { gAsk }) }
generic(true)

function paren(c: boolean) { both((if c { inner } else { ask })) }
paren(false)

for c in [true, false] { both(if c { inner } else { ask }) }
