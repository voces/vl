// @check
// @error the assignment on line 10 writes a widened field
// @error A is not W<i32>: they store field `x` differently
// The D2526 control: a NON-nullable field delivered to a `V | null` field is still a widening,
// and writing `null` through it would put a null in an `i32` slot. Only a nullable source
// binds a nullable type variable without widening, so this stays refused.
type W<V> = { x: V | null }
type A = { x: i32 }

function clr<V>(self: W<V>) { self.x = null }

const a: A = { x: 5 }
a.clr()
print(a.x + 1)
