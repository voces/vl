// @run
// @log 2
// @log 2.5
// @log 2
// @log 1
// @log 1
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `n` (prefix with `_` to suppress, or remove it)

// D1821's other side: the programs the re-ask must NOT refuse. A parked demand only fires
// where the pin makes the argument disagree with a concrete annotation.

// The annotation rides the type parameter, so every pin agrees with it by construction.
function d<T>(n: T): T {
  function k(x: i32): T { return n }
  function use(p: (i32) => T): T { return p(1) }
  return use(k)
}
print(d(2))
print(d(2.5))

// One pin: the concrete annotation is right for the only instance there is.
function s(n) {
  function k(x: i32) { return n }
  function use(p: (i32) => i32) { return p(1) }
  return use(k)
}
print(s(2))

// No capture: `k` is `(i32) => i32` at every pin, so the annotation holds at both.
function c(n) {
  function k(x: i32) { return x }
  function use(p: (i32) => i32) { return p(1) }
  return use(k)
}
print(c(2))
print(c(2.5))
