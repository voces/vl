// @run
// @log 1
// @log 1
// @log 2
// @log 2
// @log 4
// @log 1
// @log 1
// @log 2
// @log 1
// @hint redundant type annotation: `r` is inferred as `{a: i32}` — remove it to lean on inference
// An empty list literal a generic body fills with `push` of its type parameter is built at
// the pin's element, not the default `i32` one: at `f64`, `i64`, a list, a record, and a
// `string` pin relayed through a second generic (D3100).

type R = { a: i32 }

function one<T>(x: T) {
  const l = []
  l.push(x)
  print(l.length)
}
function two<T>(x: T) {
  const l = []
  l.push(x)
  l.push(x)
  print(l.length)
}
function back<T>(x: T) {
  const l = []
  l.push(x)
  return l
}
function mid<T>(x: T) { one(x) }

one(1.5)
one(5 as i64)
two([1, 2])
two(["a"])
const r: R = { a: 4 }
print(back(r)[0].a)
mid("s")
one(3)
two(true)
one("t")
