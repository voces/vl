// @run
// @log 4
// @log q
// @log 2.5
// @log 3
// @log s
// @log true
// @hint Intentionally-unused parameter `_u`
// A type parameter bound only through a union parameter takes the argument's members no
// concrete member admits: a printable pin runs in both arms, the return carries it, and an
// argument the concrete member admits whole binds nothing (D2803). A join left open at module
// scope is not re-folded by a sibling generic's call that names its own `T` (D2805).
function pr<T>(v: T | string) {
  if v is string { print(v) } else { print(v) }
}
function back<T>(v: T | string): T | string { v }
function first<T>(_u: T | string, w: T): T { w }
const a: string | i32 = 4
pr(a)
pr("q")
const b: f64 | string = 2.5
pr(b)
const r = back(3)
print(r)
const q = back("s")
print(q)
const xn: i32 | null = null
print(first(xn, true))
