// @run
// @log s
// @log 4
// @log 2.5
// A record literal holding a type parameter, handed straight to an un-annotated parameter from
// inside a generic, is built at the type the callee's instance takes (D3038).
function g<T>(x: T): T { h({ k: x, n: 1 }) }
function h(o) { o.k }
print(g("s"))
print(g(4))
print(g(2.5))
