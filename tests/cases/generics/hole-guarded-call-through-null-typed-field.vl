// @run
// @log none
// @log none
// @log none
// A guarded call through a field the pin types as `null` itself is a dead branch, not refused,
// in a hole or generic body and at a string result (D3197). The declared rows give the
// literals' function fields a layout.
type R = { v: i32, f: (() => boolean) | null }
type T = { v: i32, f: (() => string) | null }
function F(z) {
  if z.f != null { print(z.f()) } else { print("none") }
}
F({ v: 7, f: null })
function G<Z>(z: Z) {
  const g = z.f
  if g != null { print(g()) } else { print("none") }
}
G({ v: 7, f: null })
const r = { v: 8, f: null }
function S(z) {
  if z.f != null { print(z.f()) } else { print("none") }
}
S(r)
