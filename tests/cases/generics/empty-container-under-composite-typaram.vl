// @run
// @log 1
// @log 1
// @log 0
// @log s
// @log s
// D14735: a type parameter only an empty `Map()` or `[]` binds, under a map or a list of lists,
// closes at the default; one a later argument binds takes that argument's type.
function f<T>(v: {[string]: T}) { v.length + 1 }
print(f(Map()))
function g<T>(v: T[][]) { v.length + 1 }
print(g([]))
function h<T>(v: {[string]: T[]}) { v.length }
print(h(Map()))
function put<T>(v: {[string]: T}, x: T): T {
  v["a"] = x
  v["a"] ?? x
}
print(put(Map(), "s"))
function wrap<T>(v: T[][], x: T): T {
  v.push([x])
  v[0][0]
}
print(wrap([], "s"))
