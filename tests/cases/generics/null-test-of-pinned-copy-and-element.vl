// @run
// @log 1
// @log 1
// @log 1
// @log true
// @log false
// @log y
// @log 4
// A null test of a local copy, a capture or an element read of a pinned parameter folds at a
// pin that cannot be null, as the test of the parameter itself does (D2806, D2962).
function k<T>(v: T) {
  const w = v
  if w != null { print(1) } else { print(0) }
}
k(5)
k("s")
k({ a: 1 })
function c<T>(v: T) {
  const f = () => v != null
  print(f())
}
c(2.5)
const n: i32 | null = null
c(n)
function take(a) {
  const e = a[1]
  if e != null { print(e) }
}
const src = ["x", "y"]
take(src)
const s2 = [3, 4]
take(s2)
