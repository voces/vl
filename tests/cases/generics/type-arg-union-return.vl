// @run
// @log r
// A RETURN type that is a LIST of a generic application carrying a union argument
// (`Pair<i32 | null, string>[]`). Same rule as the param position: the `[]` peel runs
// BELOW the union split, so an angle-blind top-level `|` scan claims the whole name
// first, the element never resolves, and the module fails to compile.
type Pair<A, B> = { a: A, b: B }

function make(): Pair<i32 | null, string>[] { [{ a: 1, b: "r" }] }

print(make()[0].b)
