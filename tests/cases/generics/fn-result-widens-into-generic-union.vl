// @run
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @log 1
// @log 1
// @log 1
// @log 1
// @log 3
// @log 99
// @log 3
// @log 1
// @log 1
// @log 1
// A function value whose result is the generic's own type parameter, or one member of a
// `T | string` or `i32 | string` result, is delivered at that result, also through a hole
// parameter and beside an argument that binds `T` (D10241, D10243, D10244, D10163).
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { 0 } else { 1 }
}
function outer<T>(x: T) {
  print(len(() => x))
  print(len(() => 4))
}
outer(5)
outer(2.5)

function count<T>(f: () => T | string, x: T) {
  const t = f()
  if t is string { t.length } else { 99 }
}
function take(a) { print(count(a, 1.5)) }
take(() => "abc")
take(() => 2.5)
take((): string => "abc")

function fixed(f: () => i32 | string) {
  const t = f()
  if t is string { 0 } else { 1 }
}
function hand(a) { print(fixed(a)) }
hand((): i32 => 3)
print(fixed((): i32 => 3))
print(len<i32>(() => 4))
