// @check
// @error cannot assign <T>(T) => i32 to 'b' of type <T>(T) => T (parameter `a1` of `mid`, used at
// The `const` spelling of a generic function value with a closed result into `<T>(T) => T`
// (D17322).
function same<T>(k: T): T { return k }
function cnt<T>(_k: T): i32 { return 1 }
function mid<F, G>(a: F, a1: G) {
  const b: F = a1
  print(a("x"))
  print(a(1))
}
mid(same, cnt)
