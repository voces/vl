// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 3
// @log 5
// The seeded generic also called elsewhere, so it has an instance of its own (D17321).
function same<T>(k: T): T { return k }
function twice<T>(k: T): T { return k }
function mid<F, G>(a: F, a1: G) {
  let b: F = a1
  print(a("x"))
  print(b(3))
}
mid(same, twice)
print(twice(5))
