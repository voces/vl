// @run
// @hint Intentionally-unused function `_mk`
// @log 15
// @log 1
// @log 7
// @log 15
// @log 3
// @log 4
// A call of an inferred function with an un-annotated parameter, handed through a generic
// identity into a wider record, is built at that record as its all-annotated twin is (D15482).
type J = { r: i32 | null, g: i32 }
type K = { r: i32 | null, g: i32 | null }
function idn<T>(v: T): T { v }
function _mk(n: i32) { { r: n, g: 1 } }
function mkM(n: i32, c) { { r: n, g: c } }
function mkR(n: i32, c) { { r: c, g: n } }
function mkC(c) { { r: 4, g: c } }
function mkK(n: i32, c) { { r: n, g: c } }
const m: J = idn(mkM(15, 1))
print(m.r ?? 0)
print(m.g)
const r: J = idn(mkR(15, 7))
print(r.r ?? 0)
print(r.g)
const k: K = idn(mkK(15, 3))
print(k.g ?? 9)
const c: J = idn(mkC(1))
print(c.r ?? 0)
