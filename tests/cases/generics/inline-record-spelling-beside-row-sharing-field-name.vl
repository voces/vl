// @run
// @log 2
// @log 7
// @log 7
// @log 1
// @log s
// `{ v: { x: i32 } }` is `{ v: A }`'s row, not a `{ v: i32[] }` or `{ v: string }` row that only
// shares the field name: as a callback's pin, an annotated parameter, and a mutate-then-read (D3898).
type A = { x: i32 }
function ap<T, U>(xs: T[], f: (t: T) => U): U[] {
  const r: U[] = []
  for x in xs { r.push(f(x)) }
  r
}
const q: { v: i32[] } = { v: [1] }
const s: { v: string } = { v: "s" }
const o: { v: A } = { v: { x: 2 } }
print(ap([o], (e) => e.v.x)[0])
print(
  ap([o], (e: { v: { x: i32 } }) => {
    e.v.x = e.v.x + 5
    e.v.x
  })[0],
)
print(o.v.x)
print(q.v[0])
print(s.v)
