// @run
// @log u
// @log 4
// @log 4
// @log y
// @log y
// @log u
// @log u
// @log true
// @log true
// @log null
// A call's join of the caller's own type parameters beside a null stays a union each pin
// re-joins, so a list built from it reads every arm at that pin (D3612).
function G<A, B>(k: i32, a: A, b: B) {
  if k == 0 { a }
  else if k == 1 { b }
  else { null }
}
function F<A, B>(k: i32, a: A, b: B) {
  const v = G(k, a, b)
  const ys = [v]
  print(ys[0])
}
function F2<A, B>(k: i32, a: A, b: B) {
  const v = G(k, a, b)
  const ys = [v]
  print(ys[0])
  print(v)
}
F(1, 3, "u")
F2(1, 3, 4)
F2(1, "x", "y")
F2(1, 3, "u")
F2(0, true, 3)
F(2, 3, "u")
