// @run
// @log 3
// @log ab
// @log 3
// @log ab
// @log 3
// @log ab
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)

// A spread binding of a generic function name in a generic body is built per instance when it is
// pushed onto a field or an element of a binding, and when it is spread into an initialiser
// (D16698).
function id<T>(x: T): T { return x }
function runF<T>(_x: T) {
  const o: {rs: ((x: T) => T)[]} = { rs: [] }
  const src = [id]
  o.rs.push(...src)
  return o.rs
}
function runE<T>(_x: T) {
  const ls: ((x: T) => T)[][] = [[]]
  const src = [id]
  ls[0].push(...src)
  return ls[0]
}
function runI<T>(_x: T) {
  const src = [id]
  const rs: ((x: T) => T)[] = [...src]
  return rs
}
print(runF(3)[0](3))
print(runF("ab")[0]("ab"))
print(runE(3)[0](3))
print(runE("ab")[0]("ab"))
print(runI(3)[0](3))
print(runI("ab")[0]("ab"))
