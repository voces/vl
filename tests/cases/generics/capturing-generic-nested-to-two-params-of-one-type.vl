// @run
// @log 7
// @log x
// @log 7
// @log 2
// @log true
// @log x
// @log true
// @log 2
// @log 4
// @log y
// @log 4
// @log 1
// @log 4
// @log 3
// A capturing generic nested function handed to two parameters of one type parameter, each called
// at its own type: `F` binds the one `Fn#same`, so both read the joined bundle (D15599).
function mid<F>(a: F, b: F) {
  print(a("x"))
  print(b(2))
}
function outer<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  mid(same, same)
}
outer(7)
outer(true)
function midBoth<F>(a: F, b: F) {
  print(a("y"))
  print(a(1))
  print(b(3))
}
function outerBoth<U>(u: U) {
  function pass<T>(k: T): T {
    print(u)
    k
  }
  midBoth(pass, pass)
}
outerBoth(4)
