// @check
// @error operator '+' is not defined for Circle and Circle (the call's argument types)
// @error operator '+' is not defined for Circle and Circle (the call's argument types)
// @error `g` compares its type parameter with `==` here: {[string]: i32} isn't equatable — a map has no defined value equality
// @error operator '+' is not defined for string and i32 (the call's argument types)
// THE REJECTIONS THE OWNER SCOPING MUST NOT COST, beside the file that shows what it removes.
// Narrowing which constraints a call adjudicates is only safe if the ones it SHOULD adjudicate
// still fire, and two of these four are here because a first draft of the scoping DID cost
// them.
//
// **THE CALLEE'S OWN DELIVERY IS AN AXIS, and holding it at "by name" is what hid a
// loud-to-silent move produced by the fix for loud-to-silent moves.** The first grid over this
// change crossed the NEEDLE's delivery and the RECEIVER's delivery — five values each — and
// spelled the callee `f(x)` in every one of its 1514 cells. A generic reached through a BOUND
// LOCAL names no declaration at the call site, and the draft rule "an unnamed callee sees only
// the enclosing body's constraints" turned `const f = addT  f(c, c)` from a loud
// `operator '+' is not defined for Circle and Circle` into check-clean invalid wasm. The
// reasoning behind that rule is persuasive and false: an unnamed callee is USUALLY a closure
// parameter inside a generic HOF, whose holes belong to the enclosing body — and it is also a
// local bound to a declared generic, whose holes do not. What the unnamed callee must not do
// is RE-RECORD, which is the narrower rule the HOF case actually needed.
//
//   · a DECLARED callee judged by its own constraint (`addT(c, c)`);
//   · the same callee reached through a BOUND LOCAL (`const f = addT`);
//   · the D35 equality gate through a bound local — a NEW rejection, listed here rather than
//     with the D35 fixture because it is the callee-delivery axis that carries it;
//   · a constraint reached one hop away, which survives only through the RE-DEFERRAL: `gb`'s
//     `v.bar + 1` is re-recorded onto `go`'s `w` and settled when `go` is finally pinned. The
//     re-record is withheld from an unnamed callee, so this row proves it is NOT withheld from
//     a named one.
type Circle = { r: i32 }

function addT<T>(a: T, b: T): T { return a + b }

function myIndexOf<T>(self: T[], needle: T): i32 {
  let i = 0
  while i < self.length {
    if self[i] == needle { return i }
    i = i + 1
  }
  return -1
}

function ownCallee(): i32 {
  const c: Circle = { r: 7 }
  const d = addT(c, c)
  return d.r
}
print(ownCallee())

function throughBinding(): i32 {
  const c: Circle = { r: 7 }
  const f = addT
  const d = f(c, c)
  return d.r
}
print(throughBinding())

// THE RECEIVER IS A MAP AND THAT IS A DELIBERATE RE-POINT (D751/D752/D754). It used to be a
// `Circle[]` needle in a `Circle[][]`, refused because a struct-element list had no compare
// core; it has one now and the program RUNS. What this row is about is the callee-DELIVERY
// axis — that a generic reached through a bound local still has its `==` constraint
// adjudicated — so the needle moved to the one receiver whose `==` is refused by the DESIGN
// rather than by a missing lowering. A map has no defined value equality (D754), and that
// refusal is permanent, which makes it the right anchor for an axis test.
function eqThroughBinding(): i32 {
  const n: {[string]: i32} = Map()
  const xs: {[string]: i32}[] = [n]
  const g = myIndexOf
  return g(xs, n)
}
print(eqThroughBinding())

function gb(v) { return v.bar + 1 }
function go(w) { print(gb(w)) }
go({ bar: "s" })
