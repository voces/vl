// @run
// @log c
// @log a
// @log c
// @log a
// D3366: a `??` arm joined with a literal-union local and a member literal pins the generic
// at the join's union, in the three-arm chain and in the two-arm `if`.
type K = "a" | "b" | "c"
function show<T>(x: T) { print(x) }
function g(a, b, c: boolean) {
  show(if c { a ?? 5 } else if !c { b } else { "c" })
}
function h(a, b, c: boolean) { show(if c { a ?? 5 } else { b }) }
const u: K = "c"
const w: K = "a"
g(u, w, true)
g(u, w, false)
h(u, w, true)
h(u, w, false)
