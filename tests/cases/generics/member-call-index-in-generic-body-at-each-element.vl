// @run
// @log 1.5
// @log 3
// @log 2.5
// @log 1
// @log 3
// @log 3
// @log a
// @log 4
// A generic body that indexes the result of a member call its instance lowers to a direct call
// reads the element at the instance's type: `f64` and `i64` elements in one program, the
// parenthesised and variable-index spellings, a `.length` beside them and `i32`, string and
// record elements (D17240).
type P = { n: i32 }
function rev<T>(self: T[]): T[] { return self }
function first<T>(xs: T[]): T { return xs.rev()[0] }
function paren<T>(xs: T[]): T { return (xs.rev())[0] }
function at<T>(xs: T[], i: i32): T { return xs.rev()[i] }
function len<T>(xs: T[]) { return xs.rev().length }
print(first([1.5, 2.5]))
print(first([(3 as i64), (1 as i64)]))
print(paren([2.5]))
print(at([(3 as i64), (1 as i64)], 1))
print(len([1, 2, 3]))
print(first([3, 1]))
print(first(["a", "b"]))
print(first([{ n: 4 }]).n)
