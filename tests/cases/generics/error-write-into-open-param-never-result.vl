// @check
// @error push: cannot add i32 to never[] (this list's element type is `never`, so it holds no value; annotate the call or the binding that built it)
// @error push: cannot add i32 to never[] (this list's element type is `never`, so it holds no value; annotate the call or the binding that built it)
// @error cannot assign i32 to never
// @error cannot assign i32 to null
// @error push: cannot add i32 to null[]
// A result whose element, value or field a `never`-bound parameter types holds no value of it, so
// a write into it is refused at check rather than built.
function none<T>(_t: T | null): T[] { return [] }
const r = none(null)
r.push(3)
print(r.length)
function local<T>(t: T | null) {
  const xs: T[] = []
  return xs
}
const q = local(null)
q.push(4)
function keyed<T>(t: T | null) {
  const m: { [string]: T } = Map()
  return m
}
const m = keyed(null)
m["a"] = 3
function rec<T>(t: T | null) { return { f: t } }
const w = rec(null)
w.f = 3
function nested<T>(t: T | null) { return { xs: [t] } }
const nr = nested(null)
nr.xs.push(3)
