// @check
// @hint redundant type annotation: `s` is inferred as `{f: i32}` — remove it to lean on inference
// @error a {h: I} cannot be delivered as H here: the assignment on line 12 writes a widened field
// A record a type parameter stores into a field of another storage is refused at the pin for
// the write through the wider handle, rather than built into the field as it is (D3388).
type I = { f: i32 }
type J = { f: i32 | null }
type H = { h: J }
const s: I = { f: 4 }
function st<T>(v: T): H { { h: v } }
const q = st(s)
q.h.f = null
print(s.f + 1)
