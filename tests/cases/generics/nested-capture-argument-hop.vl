// @run
// @log 2
// @log 2.5
// @log 1
// @log 1
// @log 2
// @log 2.5
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `n` (prefix with `_` to suppress, or remove it)

// D1795 — a nested capturing function handed to a local helper as an ARGUMENT. The helper's
// parameter is pinned to the argument's `$fnsig`, and the argument's name resolves from the
// frame the call is written in, so each instance pins its own clone. Every pair must print two
// different values. Nested names are distinct per frame: sharing them is D1817.

function o(n) {
  function k(x: i32) { return n }
  function use(p) { return p(1) }
  return use(k)
}
print(o(2))
print(o(2.5))

// The capture-free control: one `k2` serves both instances, so both print the argument.
function c(n) {
  function k2(x: i32) { return x }
  function use2(p) { return p(1) }
  return use2(k2)
}
print(c(2))
print(c(2.5))

// The declared face pins the same way an inference hole does.
function d<T>(n: T): T {
  function k3(x: i32): T { return n }
  function use3(p) { return p(1) }
  return use3(k3)
}
print(d(2))
print(d(2.5))
