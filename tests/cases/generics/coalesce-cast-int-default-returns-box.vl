// @run
// `(x as? f64) ?? n` with an `i32` default is `f64 | i32` at the call, and an instance pinned
// where the cast always converts returns that box rather than a bare `f64` (D3704).
function F<T>(x: T, n: i32) { (x as? f64) ?? n }
const r = F(2.5, 3)
print(r is f64)
if r is f64 { print(r) } else { print(r + 100) }
print(F(4, 3) is f64)
print(F("s", 3) is i32)
// @log true
// @log 2.5
// @log true
// @log true
