// @log s
// @log 1
// A generic whose returns join to two list types is typed as their union, so `.length` on its
// call reads every member's as the same function spelled without a type parameter does (D2766,
// D2783, D2874); a discard, an `is` test or a union destination still builds.
function h<T>(c: boolean, t: T) {
  let i = 0
  while i < 2 {
    if c { return [t] }
    i = i + 1
  }
  [1]
}
h(true, "s")
const q = h(true, "s")
if q is string[] { print(q[0]) }
print(h(true, "s").length)
