// @run
// @log 4
// @log 4
// @log 4
// An un-annotated callback handed to a user generic takes that generic's parameter type, so
// over a list of record lists it is pinned as the generic's instance keys it (D3834).
type A = { x: i32 }
function h<T>(x: T): i32 { x.x }
function ap<T, U>(xs: T[], f: (t: T) => U): U[] {
  const r: U[] = []
  for x in xs { r.push(f(x)) }
  r
}
function first<T>(xs: T[], f: (t: T) => i32) { f(xs[0]) }
const a: A = { x: 4 }
print(ap([[a]], (xs) => h(xs[0]))[0])
print(first([[a]], (xs) => h(xs[0])))
print(ap([a], (e) => h(e))[0])
