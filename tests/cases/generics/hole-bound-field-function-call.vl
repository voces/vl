// @run
// @log true
// @log 7
// @log 2.5
// @log ok
// @log false
// @log 2.5
// A field function bound from a hole (`const g = z.f`) is called and printed at the function
// type the instance binds it to, directly or through a capture (D3117).
function F(z) {
  const g = z.f
  print(g())
}
const r0 = { f: () => true }
F(r0)
const r1 = { f: () => 7 }
F(r1)
const r2 = { f: () => 2.5 }
F(r2)
const r3 = { f: () => "ok" }
F(r3)
function C(z) {
  const g = z.f
  const k = () => g()
  print(k())
}
const s0 = { f: () => false }
C(s0)
C(r2)
