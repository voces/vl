// @check
// A hole or generic body refuses at its pin what the direct spelling refuses: a call through a
// record field typed `(() => T) | null` (D3197), and a member read through a field typed
// `H | null` or missing the field (D3204, D1433). Each `…Pinned` reaches the operation through
// an un-annotated or type parameter, and each `…Direct` writes it at the concrete type.

// @error called value is not a function ((() => boolean) | null)
// @error called value is not a function ((() => boolean) | null) (the body of `callPinned` at the call's argument types)
// @error called value is not a function ((() => boolean) | null) (the body of `callGeneric` at the call's argument types)
// @error called value is not a function ((() => boolean) | null) (the body of `boundPinned` at the call's argument types)
// @error member access '.v' on non-object H | null
// @error member access '.v' on non-object H | null (the body of `readPinned` at the call's argument types)
// @error member access '.v' on non-object H | null (the body of `readGeneric` at the call's argument types)
// @error no field 'foo' on {bar: i32}
// @error no field 'foo' on {bar: i32} (the body of `nestedPinned` at the call's argument types)
// @error no field 'foo' on {bar: i32} (the body of `nestedGeneric` at the call's argument types)

type R = { v: i32, f: (() => boolean) | null }
const r: R = { v: 7, f: () => true }

function callPinned(z) { print(z.f()) }
callPinned(r)
function callGeneric<Z>(z: Z) { print(z.f()) }
callGeneric(r)
function boundPinned(z) {
  const g = z.f
  print(g())
}
boundPinned(r)
function callDirect(z: R) { print(z.f()) }
callDirect(r)

type H = { v: i32 }
type Q = { h: H | null }
const q: Q = { h: { v: 4 } }

function readPinned(z) { print(z.h.v) }
readPinned(q)
function readGeneric<Z>(z: Z) { print(z.h.v) }
readGeneric(q)
function readDirect(z: Q) { print(z.h.v) }
readDirect(q)

function nestedPinned(x) { return x.inner.foo }
print(nestedPinned({ inner: { bar: 1 } }))
function nestedGeneric<T>(x: T): i32 { return x.inner.foo }
print(nestedGeneric({ inner: { bar: 1 } }))
function nestedDirect(x: { inner: { bar: i32 } }): i32 { return x.inner.foo }
print(nestedDirect({ inner: { bar: 1 } }))
