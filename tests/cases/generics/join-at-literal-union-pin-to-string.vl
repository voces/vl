// @run
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log null
// @log b
// A join over a literal-union pin that the pin makes a string is built as one, its atom arms
// widened, and a join of two atoms passed to a generic is the atom's own type there, so no
// reader sees the atom's id (D3291).
type K = "a" | "b"
function g<T>(a: T, b: T, c: boolean) {
  if c { a ?? "b" } else { b }
}
function g5(a, b, c: boolean) {
  if c { a ?? "b" } else { b }
}
function show<U>(x: U) { print(x) }
function s1(a, b, c: boolean) { show(if c { a } else { b }) }
function s2(a, b, c: i32) {
  show(
    match c {
      0 => a
      _ => b
    },
  )
}
const u: K = "a"
const w: K = "b"
print(g(u, w, true))
print(g(u, w, false))
print(g5(u, w, true))
print(g5(u, w, false))
s1(u, w, true)
s1(u, w, false)
s2(u, w, 0)
s2(u, w, 1)
const n: K | null = null
const m: K | null = "b"
s1(n, m, true)
s1(n, m, false)
