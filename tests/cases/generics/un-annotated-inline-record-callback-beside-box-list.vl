// @run
// @log 1
// @log 9
// An un-annotated `{ v: { x: 9 } }` mapped beside `Box<{ x: i32 }[]>` (D3900).
function h<T>(x: T) { x.x }
type Box<T> = { v: T }
const ba: Box<{ x: i32 }[]> = { v: [{ x: 1 }] }
print([ba].map((e) => h(e.v[0]))[0])
const o = { v: { x: 9 } }
print([o].map((e) => h(e.v))[0])
