// @run
// @log 1
// @log 10
// D14301: `Tag | Box<i32>` ends in `>` but is not one generic application, so canon reads it as
// a union and its `else` arm reads the `Box<i32>` field.
type Box<T> = { v: T }
type Tag = { t: i32 }

const c: Tag | Box<i32> = { t: 1 }
if c is Tag { print(c.t) } else { print(c.v) }
let x: Tag | Box<i32> = { v: 1 }
x = { t: 10 }
if x is Tag { print(x.t) } else { print(x.v) }
