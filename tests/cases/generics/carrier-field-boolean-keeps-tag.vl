// @run
// @log boolean
// @log i32
// @hint redundant type annotation: `tag` is inferred as `string` — remove it to lean on inference
// CONTRACT (must-RUN, exact values): D931 — the worst class, check-clean + runs + WRONG
// ANSWER. A generic value carried through a generic STRUCT FIELD lost its type identity
// to the field's LAYOUT: a boolean field is CODE 0 (`fieldCodeOfSpelling`, layout-shared
// with i32), so widening `self.actual` into the six-arm union boxed it under the i32 TAG
// in the `Expectation<boolean>` instance too, and BOTH lines printed `i32`. Instance
// identity was never the gap — `gaeEnsure` mints one application row per substitution
// and both `tag` instances existed — the emitter had simply lost the field's
// boolean-ness. `exprIsBool`'s Member arm now reads it from the row's D0 arena sidecar
// (`sTyIx`), the instance-scoped channel the shared clone leaf cannot carry. BOTH
// instantiations are load-bearing: alone, either prints correctly.
// The raw-parameter spelling (no carrier struct) is the control and always worked.
type Expectation<T> = { actual: T, negated: boolean }

function expect<T>(value: T): Expectation<T> {
  return { actual: value, negated: false }
}

function tag<T>(self: Expectation<T>): string {
  const aw: i32 | i64 | f64 | boolean | string | T = self.actual
  if aw is boolean { return "boolean" }
  if aw is i32 { return "i32" }
  "other"
}

print(tag(expect(true)))
print(tag(expect(5)))
