// @log 1
// A `const` or never-written `let` alias of a nested generic that captures its enclosing
// function's parameter, called in an enclosing generic instantiated at several types: each
// instance's alias holds its own frame's closure, and each call its own instance (D3887).
function call(f: (n: i32) => void) { f(1) }
function outer<T>(x: T) {
  function inner<U>(u: U) {
    print("inner")
    print(x)
    print(u)
  }
  const k = inner
  k(2)
}
outer(7)
outer("s")
outer(true)
function twoTypes<T>(x: T) {
  function inner<U>(u: U) {
    print(x)
    print(u)
  }
  const k = inner
  k(2)
  k("u")
}
twoTypes(7)
twoTypes("s")
function viaLet<T>(x: T) {
  function inner<U>(u: U) {
    print(x)
    print(u)
  }
  let k = inner
  k(3)
}
viaLet(9)
viaLet("s")
function escapes<T>(x: T) {
  function inner<U>(u: U) {
    print(x)
    print(u)
  }
  const k = inner
  k(4)
  call(k)
}
escapes(7)
escapes("s")
