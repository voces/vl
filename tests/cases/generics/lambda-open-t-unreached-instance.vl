// @run
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `d` is inferred as `string`
// @hint redundant type annotation: `h` is inferred as `string`
// @hint redundant type annotation: `fw` is inferred as `string`
// @log RA
// D3872: the lambda's open `T` mints an instance `h$1` whose receiver is an `i32`. No root
// reaches it, so a plain build emits it as an `unreachable` stub and the module validates.
type A = { x: i32 }
function d(self: A): string { "RA" }
function h<T>(x: T): string { x.d() }
function fw<T>(xs: T[]): string { const k = (r: T): string => h(r); k(xs[0]) }
const a: A = { x: 1 }
print(fw([a]))
