// @run
// @log 6
// @log 9
// @log 7
// @log 3
// @log 5
// D14736: a call handed through a hole identity into an annotated wider record is built at that
// record, so the identity's instance hands back what it receives.
type Circle = { r: i32 | null }
function sink(x: Circle) { print(x.r ?? 9) }
function id(x) { return x }
function id2(x) {
  const y = x
  return y
}
function mkcall() { { r: null } }
const w: Circle = id(mkcall())
print(w.r ?? 6)
sink(mkcall())
const w2: Circle = id2(id(mkcall()))
print(w2.r ?? 7)
const y = id(mkcall())
print(y.r ?? 3)
function mk2() { { r: 5 } }
const w3: Circle = id(mk2())
print(w3.r ?? 0)
