// @run
// @log aa
// @log aa
// @log ff
// @log ff
// @log gg
// @log gg
// @log 7
// @log 7
// @log 1
// @log 1
// @hint redundant type annotation: `cidS` is inferred as `string`
// @hint redundant type annotation: `s` is inferred as `string`
// @hint redundant type annotation: `w` is inferred as `{v: string}`
// A `string` or `{[K]: V}` argument to a generic reached the `"i32"` catch-all whenever the
// argument was a DECLARED LOCAL, a struct FIELD read or a `?? ` result — the instance then
// declared an i32 parameter over a string / map body, which is `vl check` rc 0 and INVALID
// WASM. Deleting the annotation made the same program work, which is the tell: the
// un-annotated arm recurses into the string-literal INIT, and a `string` PARAM resolves
// through `paramString` (an annotation), so only the spellings that need a LOCALS table
// were wrong.
//
// The two rep classifiers ask `declaredString` / `declaredMap`, tables `buildLocals` fills
// POST-monomorphization — the same reason the annotation arms above them exist. The CHECKER
// typed the read before the mono pass ran, so `monoArgTyName` takes its answer
// (`nodeTyName` / `nodeTyMapName`) for exactly these two reps; the map arm was already
// reading the checker's record and only its `exprMap` GATE was declining.
//
// Every line is paired with its CONCRETE TWIN, so their agreement is the assertion.

type W = { v: string }

function gid<T>(x: T): T { return x }
function cidS(x: string): string { return x }
function cidM(x: {[string]: i32}): {[string]: i32} { return x }

function main() {
  // a DECLARED LOCAL — the annotation is what made this fail
  const s: string = "aa"
  print(gid(s)) // aa
  print(cidS(s)) // aa

  // a struct FIELD read
  const w: W = { v: "ff" }
  print(gid(w.v)) // ff
  print(cidS(w.v)) // ff

  // a `??` result over the `string | null` niche
  const ns: string | null = "gg"
  print(gid((ns ?? "zz"))) // gg
  print(cidS((ns ?? "zz"))) // gg

  // a declared MAP local, read back through the instance's return
  const h: {[string]: i32} = Map()
  h["k"] = 7
  print((gid(h)["k"] ?? -1)) // 7
  print((cidM(h)["k"] ?? -1)) // 7
  print(gid(h).length) // 1
  print(cidM(h).length) // 1
}
main()
