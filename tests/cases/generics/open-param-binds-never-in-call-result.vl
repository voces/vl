// @run
// @log 5
// @log 5
// @log false
// @log 5
// @log -1
// @log 6
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log -1
// @log 5
// @log true
// @log 0
// @log 7
// @log -1
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// @hint redundant type annotation: `y` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `z` is inferred as `i32 | null` — remove it to lean on inference
// A type parameter no argument binds (only `null` reaches `T | null`) is `never` at the call: the
// result type and the instance agree, and `never | X` reads as `X`.
function wrap<T>(t: T | null, b: boolean) {
  if b { return { x: t } }
  return { x: 5 }
}
const r2 = wrap(null, false)
print(r2.x ?? -1)
const y: i32 = r2.x ?? -1
print(y)
print(r2.x == null)
const z: i32 | null = r2.x
print(z ?? -2)
print(wrap(null, true).x ?? -1)
const xv = r2.x
if xv != null { print(xv + 1) }

function use(v: i32) { print(v) }
use(wrap(null, false).x ?? -1)
function relay() { return wrap(null, false).x ?? -1 }
print(relay())
const o = { r: wrap(null, false) }
print(o.r.x ?? -1)
const es = [wrap(null, false)]
print(es[0].x ?? -1)

function orFive<T>(x: T | null, b: boolean) {
  if b { return x }
  return 5
}
print(orFive(null, false) ?? -1)
print(orFive(null, true) ?? -1)

function declared<T>(_x: T | null): T | i32 { return 5 }
print(declared(null))
print(declared(null) == 5)

function none<T>(_t: T | null): T[] { return [] }
print(none(null).length)

function field<T>(t: T | null, b: boolean) {
  if b { return { f: t } }
  return { f: 5 }
}
const fr = field(null, false)
fr.f = 7
print(fr.f ?? -1)
fr.f = null
print(fr.f ?? -1)
