// @run
// @log stmt none
// @log printed none
// @log arg none
// @log ret none
// @log hole none
// @log alias none
// @log param none
// A guarded call through a binding a generic's instance types `null` is a dead branch: the call
// as a statement, printed, as an argument, returned, in an interpolation hole, through a binding
// of a binding, and through a parameter the instance binds to `null`.
function stmt<Z>(z: Z) {
  const g = z.f
  if g != null { g() } else { print("stmt none") }
}
function printed<Z>(z: Z) {
  const g = z.f
  if g != null { print(g()) } else { print("printed none") }
}
function show(x: string) { print(x) }
function arg<Z>(z: Z) {
  const g = z.f
  if g != null { show(g()) } else { print("arg none") }
}
function ret<Z>(z: Z) {
  const g = z.f
  if g != null { return g() }
  return "ret none"
}
function hole<Z>(z: Z) {
  const g = z.f
  if g != null { print("got \{g()}") } else { print("hole none") }
}
function alias<Z>(z: Z) {
  const g = z.f
  const h = g
  if h != null { print(h()) } else { print("alias none") }
}
function param<F>(g: F) {
  if g != null { print(g()) } else { print("param none") }
}
stmt({ v: 1, f: null })
printed({ v: 2, f: null })
arg({ v: 3, f: null })
print(ret({ v: 4, f: null }))
hole({ v: 5, f: null })
alias({ v: 6, f: null })
param(null)
