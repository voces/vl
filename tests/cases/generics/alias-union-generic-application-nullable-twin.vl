// @run
// @log 4
// @log 9
// @log 9
// A nullable record with the shape of a declared union's generic-application arm is stored as
// a nullable struct, so its null-peeled read is a plain field read, not a variant-box read.
type Box<T> = { v: T }
type Tag = { t: i32 }
type U = Box<i32> | Tag

const n: U = { t: 4 }
if n is Tag { print(n.t) }
let o: { v: i32 } | null = null
o = { v: 9 }
if o != null { print(o.v) }
let b: Box<i32> | null = null
b = { v: 9 }
if b != null { print(b.v) }
