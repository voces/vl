// @run
// @log 1
// @hint redundant type annotation: `y` is inferred as `{v: i32}`
// The reported program, MINIMAL and on its own — the silent-invalid-wasm witness. Kept
// separate from `alias-to-generic-application.vl` (which adds param/return forms) because
// those forms make the emitter reject LOUDLY first, masking this exact failure mode:
//
//   master `2c5e9cd`:  vl check  → accepted, one redundant-annotation HINT
//                      vl build  → wrote a 173-byte module
//                      vl run    → failed to parse as WebAssembly:
//                                  "type mismatch: expected (ref $type), found (ref $type)"
//
// The 173 bytes hold a global declared `(mut (ref 1))` where type 1 is the UNION BOX
// `(struct (field i32) (field anyref))`, initialized with `struct.new 0` over the plain
// `(struct (field (mut i32)))`. The un-aliased control below emits ONE struct type and no
// box at all — the alias is the whole difference.
type Box<T> = { v: T }
type Y = Box<i32>
const y: Y = { v: 1 }
print(y.v)
