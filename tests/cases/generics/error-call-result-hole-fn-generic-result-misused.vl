// @error cannot assign i32 to 'q' of type boolean
// The result of a generic call whose function argument is a call result is its closed type, not
// an open one any use accepts (D16099).
function inc(a) { return a + 1 }
function app<T, R>(g: (x: T) => R, v: T): R { return g(v) }
function pick1(_c: boolean) { return inc }
const q: boolean = app(pick1(true), 3)
print(q)
