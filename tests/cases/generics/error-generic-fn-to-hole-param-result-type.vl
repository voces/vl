// @error cannot assign string to 'r' of type i32
// D4420: the hole's call result is the generic's instance result, so a mismatch with it is a
// type error at the pin, as it is when the argument is a concrete function.
function same<T>(k: T): T { k }
function take(a) {
  const r: i32 = a("x")
  print(r)
}
take(same)
