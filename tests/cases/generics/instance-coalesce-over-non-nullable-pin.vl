// @run
// @log 4
// @log abc
// @log 4
// @log eq
// `??` in a hole or generic instance whose operand the pin makes a plain `i32` or `string`,
// with a default of that type, is its operand, as at the direct spelling (D3206).
function F(z) {
  const x = z.f()
  print(x ?? 0)
}
function S<Z>(z: Z) {
  const x = z.f()
  const d = "d"
  print(x ?? d)
}
function B(z) {
  const y = z.f() ?? 7
  print(y)
  if (z.f() ?? 1) == 4 { print("eq") }
}
F({ v: 1, f: () => 4 })
S({ v: 1, f: () => "abc" })
B({ v: 1, f: () => 4 })
