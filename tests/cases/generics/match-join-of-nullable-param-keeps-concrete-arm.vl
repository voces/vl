// @run
// @log a
// @log null
// @log z
// @log str
// @log z
// @log 7
// @log null
// @log z
// @log 2.5
// @log 2.5
// @log null
// @log null
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log n
// @log true
// @log zz
// A generic's match join of a nullable type parameter and a concrete arm keeps the concrete
// arm apart, its null the wrapper, as a bare parameter's join does (D4174).
type K = "a" | "b"
function g<T>(a0: T, k: i32) {
  const xs = [
    match k {
      0 => a0
      1 => null
      _ => "z"
    },
  ]
  print(xs[0])
}
function h<T>(a0: T, k: i32) {
  const v = match k {
    0 => a0
    1 => null
    _ => 5
  }
  print(v)
  const ys = [v]
  print(ys[0])
}
function f<T>(a0: T, k: i32) {
  const s = "zz"
  const v = match k {
    0 => null
    1 => a0
    _ => s
  }
  print(v ?? "n")
}
const x0: K = "a"
g(x0, 0)
g(x0, 1)
g(x0, 2)
g("str", 0)
g("str", 2)
g(7, 0)
g(7, 1)
g(7, 2)
h(2.5, 0)
h(2.5, 1)
h(2.5, 2)
h("s", 2)
h(9, 2)
f(true, 0)
f(true, 1)
f(true, 2)
