// @run
// A returned `(x as? f64) ?? d` is an `f64` in every instance, including one pinned where the
// cast can never convert, and through an un-annotated parameter (D3692).
function F<T>(x: T) { (x as? f64) ?? 99 }
function G(x) { (x as? f64) ?? 99 }
print(F("s"))
print(F("s") / 2)
print(F(2.5))
print(G("s"))
// @log 99
// @log 49.5
// @log 2.5
// @log 99
