// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 3
// @log x
// @log 3
// @log true
// A binding annotated with one type parameter and seeded from a parameter of another takes
// the instance its seed was given, also beside a second such binding (D6703, D6740).
function same<T>(k: T): T { k }
function mid<F, G>(a: F, a1: G) {
  let b: F = a1
  print(a("x"))
  print(b(3))
}
function mid3<F, G, H, G1>(a: F, a1: G1, a2: H) {
  let b: G1 = a1
  const c: G = a2
  print(a("x"))
  print(b(3))
  print(c(true))
}
mid(same, same)
mid3(same, same, same)
