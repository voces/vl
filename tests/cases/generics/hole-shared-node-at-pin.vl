// @run
// @log null
// @log true
// @log null
// @log false
// @log true
// @log false
// @log true
// @log 7
// @log false
// @log 2.5
// @log s
// @log 2.5
// A hole instance shares the generic body's nodes, which are typed at the hole's variable; a
// read of one is typed at the instance's pin. A `boolean | null` prints its null (D2921), a
// `boolean` prints as one through a generic call or a lambda chain (D2919), and a capture of a
// list element takes the element's rep (D2918). Each generic runs at two pins.
function elem(x) {
  const xs = [x]
  print(xs[0])
}
const nb: boolean | null = null
elem(nb)
elem(true)
function mapped(x) {
  const ys = [x, x].map((e) => e)
  print(ys[0])
}
mapped(nb)
const bf: boolean | null = false
mapped(bf)
function id<T>(t: T): T { return t }
function viaId(x) {
  const l0 = [x]
  print(id(l0[0]))
}
viaId(true)
viaId(false)
function chain(x) {
  const c = () => x
  const d = () => c()
  print(d())
}
chain(true)
chain(7)
chain(false)
function cap(x) {
  const l0 = [x]
  const y = l0[0]
  const k = () => y
  print(k())
}
cap(2.5)
cap("s")
cap(2.5)
