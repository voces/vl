// @run
// @log 6
// @log 2
// @log 4
// @log 0
// A recursive generic union alias: the instance is cyclic through a list arm, walked directly and
// through a generic function, and a recursive generic record as one arm of a generic union.
type Tree<T> = { leaf: T } | { kids: Tree<T>[] }
function sum(t: Tree<i32>) {
  if t is { leaf: i32 } { return t.leaf }
  let s = 0
  for k in t.kids { s = s + sum(k) }
  return s
}
print(sum({ kids: [{ leaf: 1 }, { kids: [{ leaf: 2 }, { leaf: 3 }] }] }))

function width<T>(t: Tree<T>) {
  if t is { leaf: T } { return 1 }
  return t.kids.length
}
const w: Tree<string> = { kids: [{ leaf: "x" }, { leaf: "y" }] }
print(width(w))

type L<T> = { head: T, tail: L<T> | null }
type Opt<T> = L<T> | string
function first(o: Opt<i32>) {
  if o is string { return 0 }
  return o.head
}
print(first({ head: 4, tail: null }))
print(first("none"))
