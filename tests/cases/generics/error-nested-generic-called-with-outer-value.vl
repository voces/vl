// @error cannot assign boolean to 'n' of type i32
// A nested generic with its own parameter name, called with a value of the enclosing `T`: its
// demand is checked at the enclosing pin, through the binding the call made (D3853).
function a<T>(x: T) {
  function b<U>(y: U) {
    const n: i32 = y
    print(n + 1)
  }
  b(x)
}
a(true)
