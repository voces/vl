// @run
// @log 7
// @log 7
// @log x
// @log 2.5
// @log 5
// @log true
// @log 6
// @log q
// @log 9
// @log s
// @log 5
// @log 5
// @log 5
// @hint redundant type annotation: `n` is inferred as `{f: i32}` — remove it to lean on inference
// D2850: a record built by an un-annotated constructor, `mk(x)` returning `{ f: x }`, gets
// one row per pin, and each pin's record is read back through a second delivery position.
// The annotated spelling and a pin that widens into a declared union arm keep their rows.

function mk(x) { return { f: x } }

print(mk(7).f)
const a = mk(7)
print(a.f)
const b = mk("x")
print(b.f)
print(mk(2.5).f)

// A list element beside a sibling row with the same field name, and a closure in the body.
const xs = [mk(5)]
const t = { f: true }
print(xs[0].f)
print(t.f)
function mkc(x) {
  const c = (y) => y
  return { f: c(x) }
}
const ys = [mkc(1)]
ys.push(mkc(2))
const m = Map()
m.set("k", mkc(3))
const got = m.get("k")
if got != null { print(ys[0].f + ys[1].f + got.f) }
const ss = [mk(["p", "q"])]
print(ss[0].f[1])
const h = { inner: mk(4) }
h.inner = mk(9)
print(h.inner.f)
print(mk({ w: "s" }).f.w)

// The annotated spelling, and an `i32` pin delivered into a union arm declared at `i64`.
const n: { f: i32 } = mk(5)
print(n.f)
type A = { v: i64 }
type B = { w: string }
function mv(x) { return { v: x } }
const u: A | B = mv(5)
if u is A { print(u.v) }
function g(): A | B { return mv(5) }
const r = g()
if r is A { print(r.v) }
