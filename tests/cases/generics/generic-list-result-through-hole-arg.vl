// @run
// @log 2
// @log a
// @log 1.5
// @log 5
// @log 4
// @log 3
// A generic's `T[]` result returned through an un-annotated parameter is the argument's list at
// each instance, read directly, indexed, through a further hole function, and nested (D6500).
function g<T>(x: T[]): T[] { return x }
function f(a) { return g(a) }
print(f([1, 2]).length)
print(f(["a"])[0])
print(f([1.5])[0])
function h(a) { return f(a) }
print(h([4, 5])[1])
function g2<T>(x: T[][]): T[][] { return x }
function f2(a) { return g2(a) }
print(f2([[3, 4]])[0][1])
const r = f([7, 8, 9])
print(r.length)
