// @run
// @log none
// @log true
// @log none
// @log true
// @log none
// @log true
// @log 3
// @log 3
// @log true
// @log true
// A call through a `(() => T) | null` field runs in a hole, generic or lambda body when a null
// test guards it, on the field (D3197) or on a binding of it, or after a non-null write to the
// field, which narrows it as the direct spelling's write does; a call that may null the field
// ends that narrowing, and the field still reads after it.
type R = { v: i32, f: (() => boolean) | null }
const n: R = { v: 1, f: null }
const y: R = { v: 2, f: () => true }

function onField(z) {
  if z.f != null { print(z.f()) } else { print("none") }
}
onField(n)
onField(y)
function onBinding<Z>(z: Z) {
  const g = z.f
  if g != null { print(g()) } else { print("none") }
}
onBinding(n)
onBinding(y)
function inLambda(z) {
  const k = () => {
    if z.f != null { print(z.f()) } else { print("none") }
  }
  k()
}
inLambda(n)
inLambda(y)
type W = { v: i32, f: (() => i32) | null }
function lazy(z) {
  z.f = () => 3
  print(z.f())
}
const w: W = { v: 1, f: null }
lazy(w)
function lazyGeneric<Z>(z: Z) {
  z.f = () => 3
  print(z.f())
}
const w2: W = { v: 2, f: null }
lazyGeneric(w2)
const NF: (() => i32) | null = null
function clrH(q) {
  q.f = NF
  return
}
function afterCall(z) {
  z.f = () => 5
  clrH(z)
  print(z.f == null)
}
const w3: W = { v: 3, f: null }
afterCall(w3)
function guardCall(z) {
  if z.f != null {
    clrH(z)
    print(z.f == null)
  }
}
const w4: W = { v: 4, f: () => 4 }
guardCall(w4)
