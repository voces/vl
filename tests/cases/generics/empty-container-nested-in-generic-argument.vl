// @run
// @log 1
// @log 1
// @log 1
// @log 0
// @log 1
// @log 1
// @log 0
// @log 2
// @log 2
// An empty `[]`, `Set()` or `Map()` inside a list literal handed to a type parameter is built at
// the open container's defaults, and the call's result, an index into it and a generic caller's
// copy of the call read at that closed list (D16725).
function one<B>(b: B) { return [b].length }
function take<T>(x: T): T { return x }
function wrap<B>(b: B) { return [b] }
function inGeneric<T>(x: T) { return take([[]]).length + [x].length }
print(one([Set()]))
print(one([[]]))
print(take([[]]).length)
print(take([[]])[0].length)
print(wrap([[]])[0].length)
print(take([[[]]]).length)
print(take([[[]]])[0][0].length)
print(take([Map(), Map()]).length)
print(inGeneric(3))
