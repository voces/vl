// @run
// @log 3
// @log 1
// @log 2
// D3325: a list of declared records read out of a hole's field and handed to a second hole
// callee pins at the record's declared name: the filed program, a binding of the read, and a
// callee that returns its argument.
type O = { n: i32 }
type P = { v: O | null, xs: (O | null)[] }
function mk(n: i32): P { return { v: { n: n }, xs: [{ n: n }, { n: n + 1 }] } }
function popf(a) { a.pop() }
function t(z) {
  if z.xs[0] != null {
    popf(z.xs)
    print(z.xs[0].n)
  }
}
t(mk(3))
function t2(z) {
  const ys = z.xs
  if ys[0] != null {
    popf(ys)
    print(1)
  }
}
t2(mk(3))
function retf(a) { return a }
function t3(z) { print(retf(z.xs).length) }
t3(mk(3))
