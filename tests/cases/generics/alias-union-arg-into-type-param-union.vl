// @run
// @log 5
// @log s
// @log 5
// @log str s
// An alias-named union argument into a `T | string` parameter binds `T` to the members the fixed
// `string` does not cover, so the instance prints and narrows as the written `i32 | string` does (D2808).
type U2 = i32 | string
function k<T>(v: T | string) { print(v) }
const x: U2 = 5
k(x)
const y: U2 = "s"
k(y)
function n<T>(v: T | string) {
  if v is string { print("str " + v) } else { print(v) }
}
n(x)
n(y)
