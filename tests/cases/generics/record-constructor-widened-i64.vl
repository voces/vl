// @run
// @log 5
// @log 6
// @log 5
// @log 0.5
// @log 5
// @log 7
// A constructor pinned at `i32` whose record a wider declared row reads takes that row, and its
// `i32` field widens into the `i64` slot, in the generic and the hole spellings alike (D2850).
type In = { v: i64 }
type W = { n: In }
function mkT<T>(x: T) { return { v: x } }
function mk(x) { return { v: x } }
const a: In = mkT(5)
print(a.v)
const xs: In[] = [mkT(5), mkT(6)]
print(xs[1].v)
function use(w: In) { print(w.v) }
use(mk(5))
const nz = mk(0.5)
print(nz.v)
const w: W = { n: mk(5) }
print(w.n.v)
function mkU<T>(x: T) { return { v: x } }
const d = mkU(7)
const e: In = d
print(e.v)
