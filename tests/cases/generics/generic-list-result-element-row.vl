// @run
// @log 9000000000
// @log 9

// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)

// A generic's list result is read at the element row its instance's signature declares: a
// list of a literal-union box, and a list of functions whose element is called (D3518, D3947).

type D = 9000000000 | 1
function mi<T, U>(self: T[], f: (T) => U): U[] {
  const out: U[] = []
  out.push(f(self[0]))
  out
}
const a: D[] = [9000000000, 1]
print(mi(a, (x: D) => x)[0])

function q(n: i32) { print(n) }
function mk<T>(x: T) {
  const l: ((n: i32) => void)[] = [q]
  return l
}
mk(7)[0](9)
