// @run
// @log 6
// @log abab
// @log 3
// @log 1.5
// @log 3
// A generic function value into a generic higher-order function whose return is inferred
// from the callback's call (D2427). The instance read its return off the value's own generic
// type (`(T) => i32`, `(U) => U`) instead of the substituted pin, so a non-i32 instance
// returned an i32.
function dbl<T>(x: T) { return x + x }
function idf<U>(x: U) { return x }
function run<T>(cb: (T) => T, v: T) { return cb(v) }

print(run(dbl, 3))
print(run(dbl, "ab"))
print(run(dbl, 1.5))
print(run(idf, 1.5))
function d(x: f64) { return x + x }
print(run(d, 1.5))
