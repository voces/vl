// @run
// @log 1
// @log s
// @log true
// @log 7
// @log 7
// @log 8
// @log 8
// `{ v: Box<A> }` is its own row, not `Box<A[]>`'s, a `{ v: string }`, or a union-box row with a
// field `v` declared before it: as a `.map` callback's pin and an annotated parameter, each
// mutated through and read back (D3901).
type A = { x: i32 }
type Box<T> = { v: T }
function h<T>(x: T) { x.x }
const q: Box<A[]> = { v: [{ x: 1 }] }
const s: { v: string } = { v: "s" }
const u: { v: i32 | string } = { v: 1 }
print(q.v[0].x)
print(s.v)
print(u.v is i32)
const o: { v: Box<A> } = { v: { v: { x: 6 } } }
print(
  [o].map((e) => {
    e.v.v.x = e.v.v.x + 1
    h(e.v.v)
  })[0],
)
print(o.v.v.x)
function g(e: { v: Box<A> }) {
  e.v.v.x = e.v.v.x + 1
  e.v.v.x
}
print(g(o))
print(o.v.v.x)
