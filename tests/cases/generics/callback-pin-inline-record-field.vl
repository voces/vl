// @run
// @log 1
// @log 2
// An un-annotated callback over a list of inline records pins the generic it calls at the
// field's declared record; same-shaped `A` and `B` are one type (D3834).
type A = { x: i32 }
type B = { x: i32 }
function h<T>(x: T) { x.x }
const o: { v: A } = { v: { x: 1 } }
const o2: { v: B } = { v: { x: 2 } }
print([o].map((e) => h(e.v))[0])
print([o2].map((e) => h(e.v))[0])
