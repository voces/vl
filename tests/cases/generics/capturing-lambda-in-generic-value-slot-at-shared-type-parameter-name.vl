// @run
// @log 8
// @log 14
// @log b
// @log 14
// D15034: a lambda capturing the instance's parameter, written to a slot of a generic's value in a
// generic body whose type parameter shares the generic's name, returns at its call's own type in
// each instance.
function id<T>(x: T): T { x }
const ks = [id]
function both<T>(t: T) {
  ks[0] = (x) => {
    print(t)
    return x + x
  }
  print(ks[0](7))
}
both(8)
both("b")
