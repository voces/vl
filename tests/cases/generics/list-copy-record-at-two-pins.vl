// @log 3
// @log 1
// @log 1
// @log 3
// A list delivery's copy is recorded at its open destination and closed at each instance, so a
// generic's second pin does not read the first pin's copy (D14804).
type Dot = { x: i32 }
type Circle = { r: i32 }
function f<T>(xs: Dot[], t: T) {
  const ys: readonly (Dot | T)[] = xs
  print(ys.length)
  const y0 = ys[0]
  if y0 is Dot { print(y0.x) } else { print("other") }
}
f([{ x: 1 }], { r: 2 })
f([{ x: 3 }], { x: 5 })
function g<T>(xs: Dot[], t: T): readonly (Dot | T)[] { return xs }
const a = g([{ x: 1 }], { r: 2 })
print(a.length)
const b = g([{ x: 3 }], { x: 5 })
print(b.length)
print(b[0].x)
