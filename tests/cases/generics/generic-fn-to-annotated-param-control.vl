// @run
// @log x
// @log x!
// D4420: the annotated control, which instanced the generic at the declared function type
// before the un-annotated spelling did.
function same<T>(k: T): T { k }
function take(a: (k: string) => string) { print(a("x")) }
take(same)
function viaAlias(a: (k: string) => string) {
  const v = a
  print(v("x") + "!")
}
viaAlias(same)
