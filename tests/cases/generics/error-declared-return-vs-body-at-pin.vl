// @check
// @error return type mismatch: expected V, got i32 (the return of `g` at the call's argument types)
// @error return type mismatch: expected i32, got string (the return of `elemOf` at the call's argument types)
// @error return type mismatch: expected V, got i32 (the return of `viaUfcs` at the call's argument types)
// @error return type mismatch: expected V, got i32 (the return of `outer` at the call's argument types)
// @hint redundant type annotation: `p` is inferred as `i32`
// @hint redundant type annotation: `xs` is inferred as `string[]`
// @warning Unused variable `z1` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z3` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z4` (prefix with `_` to suppress, or remove it)
// A GENERIC'S DECLARED RETURN TYPE, RE-CHECKED AGAINST ITS BODY'S TYPE AT THE PIN
// (silent-class-inventory D551). Every rejection here was `vl check` rc 0 over a module the
// engine refuses, and every one has a DIRECT twin — the same declaration with the type
// parameter written out — that has always been a positioned `return type mismatch`. The
// suffix is the only difference between the two sentences, and it is there because the
// reader is standing at the CALL having written no `return`.
//
// The four rows are the four rungs, one witness each:
//
//   · `g`      the plain pin. `assignable(T, V)` is true in the body, so the mismatch check
//              passed; `substTyDeep` then substituted the DECLARED return at the call and
//              nothing compared it with the substituted BODY type.
//   · `elemOf` a DERIVED hole rather than a bare parameter — `self[0]` over a `T[]` — which
//              is what says the rule is about holes and not about the parameter position.
//   · `viaUfcs` the SECOND pin. `p.viaUfcs()` and `viaUfcs(p)` are the same call and must
//              answer the same way; the method spelling has its own site in `typecheck.vl`
//              and wiring only the first would have left this row silent.
//   · `outer`  the RE-DEFERRAL. `outer` relays into `inner`, so at `inner(self)` the
//              constraint's hole substitutes to ANOTHER hole and must be re-recorded under
//              the caller's — without that the chain dies at the first hop and type-checks
//              clean. The report names `outer`, which is the call the reader wrote.
type V = { x: i32 }

function g<T>(self: T): V { return self }
const p: i32 = 6
const z1 = g(p)

function elemOf<T>(self: T[]): i32 { return self[0] }
const xs: string[] = ["s"]
const z2 = elemOf(xs)
print(z2)

function viaUfcs<T>(self: T): V { return self }
const z3 = p.viaUfcs()

function inner<T>(self: T): V { return self }
function outer<U>(self: U): V { return inner(self) }
const z4 = outer(p)
