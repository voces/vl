// @run
// @log 1
// @log 7
// @log 21
// @log s
// @log 2
// @log 10
// A lambda whose result is a list literal of lambdas, handed to a generic whose function
// parameter's result is a list of `(() => T) | boolean`, binds `T` from the inner lambdas and builds
// the list at the bound union (D16917).
function gen<T>(f: () => ((() => T) | boolean)[]) { return f().length }
print(gen(() => [() => 1]))
function call0<T>(f: () => ((() => T) | boolean)[]): T | i32 {
  const x = f()[0]
  if x is boolean { return 0 }
  return x()
}
print(call0(() => [() => 7]))
function each<T>(f: () => ((() => T) | boolean)[]) {
  let n = 0
  for x in f() {
    if x is boolean { n = n + 10 } else { n = n + 1 }
  }
  return n
}
print(each(() => [false, () => 4, true]))
function str<T>(f: () => ((() => T) | boolean)[]): T | string {
  const x = f()[0]
  if x is boolean { return "b" }
  return x()
}
print(str(() => [() => "s"]))
function nested<T>(f: () => ((() => T) | boolean)[][]) { return f()[0].length }
print(nested(() => [[() => 1, false]]))
function call1<T>(f: () => (((x: i32) => T) | boolean)[]): T | i32 {
  const x = f()[0]
  if x is boolean { return 0 }
  return x(5)
}
print(call1(() => [(x) => x * 2]))
