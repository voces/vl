// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// The generic-application union member beside every OTHER kind of member the box carries —
// an inline shape, a scalar atom, `null`, and a second application of the same base. Each
// spelling reached `globalCellKind`'s union arm and lowered a bare struct into the box slot
// (invalid wasm) exactly as the two-named-member form did; they are pinned separately
// because each takes a different arm of `emitUnionCoerce` on the way in.
type Box<T> = { v: T }
type Tag = { t: i32 }

// A generic application beside an INLINE SHAPE member.
type UShape = Box<i32> | { t: i32 }
const a: UShape = { v: 1 }
if a is Box<i32> { print(a.v) }

// Beside a SCALAR atom (the MIXED union — the application boxes as a variant struct, the
// scalar through the shared value box).
type UScalar = Box<i32> | i32
const b: UScalar = { v: 2 }
if b is Box<i32> { print(b.v) }

// Beside `null` — one non-null member, so this is the nullable NICHE, not the box.
type UNull = Box<i32> | null
let c: UNull = null
c = { v: 3 }
if c is Box<i32> { print(c.v) }

// Two applications of the SAME base with different arguments, discriminated by field name.
type Cell<T> = { c: T }
type UTwo = Box<i32> | Cell<string>
const d: UTwo = { v: 4 }
if d is Box<i32> { print(d.v) }

// The generic application as a member reached through a one-member alias (`type A = Box<i32>`,
// #1122's transparency) — the same shape by a different route, so the two rules compose.
type BoxI = Box<i32>
type UAlias = BoxI | Tag
const e: UAlias = { v: 5 }
if e is { v: i32 } { print(e.v) }
