// @run
// @log 15
// @log 15
// @log 15
// @log hi
// @log 2.5
// @log 7
// @log hi
// @hint redundant type annotation: `cs` is inferred as `{s: string, x: f64, w: i64}` — remove it to lean on inference
// D8342: `??` over a field of a hole or generic parameter narrowed by `is` to a record that
// stores the field nullable, where the value is stored at a declared row holding it flat. The
// field cannot be null there, so the `??` is the field: through a copy, directly, under an open
// `T`, and for string, f64 and i64 fields.
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function mk() { { r: 15, g: 1 } }
function take(a) {
  const v = a
  if v is J { print(v.r ?? 0) } else { print(0) }
}
function takeDirect(a) {
  if a is J { print(a.r ?? 0) } else { print(0) }
}
function takeT<T>(a: T) {
  if a is J { print(a.r ?? 0) } else { print(0) }
}
take(mk())
takeDirect(mk())
takeT(mk())

type Cs = { s: string, x: f64, w: i64 }
type Js = { s: string | null, x: f64 | null, w: i64 | null }
function mkS() { { s: "hi", x: 2.5, w: 7 as i64 } }
function takeS(a) {
  if a is Js {
    print(a.s ?? "none")
    print(a.x ?? 0.0)
    print(a.w ?? (0 as i64))
  }
}
takeS(mkS())
const cs: Cs = mkS()
print(cs.s)
