// @run
// THE ACCEPT SET of `silent-class-inventory` D691 — every receiver rep whose `.length` or
// `x[0]` through a type parameter is still admitted, READ BACK BY VALUE beside its direct
// spelling.
//
// The refusal this pairs with (`error-receiver-classification-at-pin.vl`) is a capability
// check at the generic call site, and a capability check that over-refuses is a false reject
// nothing else in the suite would catch: D14 deliberately ADMITTED `.length` on every type
// variable to buy these eight reps, so the only witness that the new pin did not take them
// back is a program that prints its answers. Every line below is emitted twice — once through
// the generic and once written out — and the two must agree.
//
// The MAP and SET rows are the ones a naive floor loses first: both are `TyMap` in the arena
// and both answer `.length`, and a `.size` spelling shares the arm. The STRING row is the one
// a floor that only knows arrays loses.

// @log 2
// @log 2
// @log 2
// @log 2
// @log 3
// @log 3
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 7
// @log 7
// @log a
// @log a
// @log 97
// @log 97

type Circle = { r: i32 }
type CM = {[string]: i32}
type CS = {[string]: boolean}

function gLen<T>(x: T) { print(x.length) }
function gIdx<U>(x: U) { print(x[0]) }

function mkm(): CM {
  const m: CM = Map()
  m["k"] = 1
  m
}
function mks(): CS {
  const s: CS = Set()
  s.add("k")
  s
}

// ── `.length` on a receiver that HAS one ──────────────────────────────────────────────
function lenListDirect(v: i32[]) { print(v.length) }
function lenListPinned(v: i32[]) { gLen(v) }
function lenStrListDirect(v: string[]) { print(v.length) }
function lenStrListPinned(v: string[]) { gLen(v) }
function lenStrDirect(v: string) { print(v.length) }
function lenStrPinned(v: string) { gLen(v) }
function lenMapDirect(v: CM) { print(v.length) }
function lenMapPinned(v: CM) { gLen(v) }
function lenSetDirect(v: CS) { print(v.length) }
function lenSetPinned(v: CS) { gLen(v) }
function lenNestDirect(v: string[][]) { print(v.length) }
function lenNestPinned(v: string[][]) { gLen(v) }
function lenRecListDirect(v: Circle[]) { print(v.length) }
function lenRecListPinned(v: Circle[]) { gLen(v) }

// ── `x[0]` on a receiver that CAN be indexed ──────────────────────────────────────────
function idxListDirect(v: i32[]) { print(v[0]) }
function idxListPinned(v: i32[]) { gIdx(v) }
function idxStrListDirect(v: string[]) { print(v[0]) }
function idxStrListPinned(v: string[]) { gIdx(v) }
function idxStrDirect(v: string) { print(v[0]) }
function idxStrPinned(v: string) { gIdx(v) }

function body() {
  const xs = [7, 8]
  lenListDirect(xs)
  lenListPinned(xs)
  const ss = ["a", "b"]
  lenStrListDirect(ss)
  lenStrListPinned(ss)
  lenStrDirect("abc")
  lenStrPinned("abc")
  const m = mkm()
  lenMapDirect(m)
  lenMapPinned(m)
  const st = mks()
  lenSetDirect(st)
  lenSetPinned(st)
  const nest = [["a"]]
  lenNestDirect(nest)
  lenNestPinned(nest)
  const recs = [{ r: 7 }]
  lenRecListDirect(recs)
  lenRecListPinned(recs)
  idxListDirect(xs)
  idxListPinned(xs)
  idxStrListDirect(ss)
  idxStrListPinned(ss)
  idxStrDirect("abc")
  idxStrPinned("abc")
}
body()
