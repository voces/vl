// A lambda in a list, record field, nullable or nested list handed to a generic's list of `() => T | string` is delivered at the bound
// function type, so a call through the list reaches each lambda at the union result (D16899).
function first<T>(fs: (() => T | string)[]): T | string { return fs[0]() }
const a = first([() => 5])
if a is string { print(a) } else { print(a + 1) }
const b = first([() => "x"])
if b is string { print(b) } else { print(0) }
function sum<T>(fs: (() => T | string)[]) {
  let n = 0
  for f in fs {
    const v = f()
    if !(v is string) { n = n + 1 }
  }
  return n
}
print(sum([() => 1, () => 2, () => 3]))
function apply<T>(fs: ((x: i32) => T | string)[]): T | string {
  return fs[0](5)
}
const c = apply([(x) => x * 2])
if c is string { print(c) } else { print(c) }
function wide<T>(fs: (() => T | f64)[]): T | f64 { return fs[0]() }
const d = wide([() => 5])
if d is f64 { print(0) } else { print(d) }
function count<T>(fs: (() => T | string)[]) {
  fs[0]()
  return 7
}
print(count([() => 5]))
function viaRec<T>(r: {g: () => T | string}): T | string { return r.g() }
const e = viaRec({ g: () => 5 })
if e is string { print(e) } else { print(e + 1) }
function viaNul<T>(g: (() => T | string) | null): T | string {
  if g == null { return "none" }
  return g()
}
const h = viaNul(() => 5)
if h is string { print(h) } else { print(h + 1) }
function viaNulList<T>(fs: ((() => T | string) | null)[]): T | string {
  const g = fs[0]
  if g == null { return "none" }
  return g()
}
const j = viaNulList([() => 5])
if j is string { print(j) } else { print(j + 1) }
function viaNested<T>(fs: (() => T | string)[][]): T | string {
  return fs[0][0]()
}
const k = viaNested([[() => 5]])
if k is string { print(k) } else { print(k + 1) }
function five() { return 5 }
const m = first([five])
if m is string { print(m) } else { print(m + 1) }
function outer(n: i32) {
  const o = first([() => n])
  if o is string { print(o) } else { print(o + 1) }
}
outer(5)
function recArm<T>(fs: (() => T | {a: i32})[]) {
  const v = fs[0]()
  if v is {a: i32} { return v.a }
  return v
}
print(recArm([() => 5]))
function recOne<T>(f: () => T | {a: i32}) {
  const v = f()
  if v is {a: i32} { return v.a }
  return v
}
print(recOne(() => 5))
