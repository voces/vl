// @run
// @log 9
// @log no
// @log b
// @log 4
// @log a
// @hint Intentionally-unused parameter `_e` (leading `_` marks it unused)
// @hint redundant type annotation: `h` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `pv0` is inferred as `{x: i32}` — remove it to lean on inference
// D2976, D3134, D3143, D3159: four rows the niche and receiver fixes of D3140, D3149 and D3174
// close as a side effect. A `.map` receiver builds at its own type, and a read narrowed out of two
// literal unions and `null` is the atom niche.
type R = { x: i32 }
type K = "a" | "b"
type J = "c" | "d"
function h<T>(a: T, c: boolean): i32 {
  const r: T | string = if c { a } else { "z" }
  if r is R {
    print(r.x)
    return 1
  }
  print("no")
  return 0
}
const pv0: R = { x: 9 }
h(pv0, true)
const pv1: K = "a"
h(pv1, true)
function t(v: K | J | null) {
  if v is K { print(v) }
}
t("b")
function u<T>(x: T) {
  let n = [x].map((e): T | null => e)
  n = [x].map((e): T | null => e)
  print(n[0])
}
u(4)
function w<T>(x: T) {
  return [x].map((_e) => {
    if 1 > 2 { return 1 }
    return "a"
  })
}
for y in w(4) { print(y) }
