// @run
// @log 4
// @log a
// @hint Intentionally-unused parameter `_e` (leading `_` marks it unused)
// D3143, D3159: two rows the receiver fix of D3149 closes as a side effect. A `.map` receiver
// builds at its own type, not the destination's element or the result's union-list seed.
function u<T>(x: T) {
  let n = [x].map((e): T | null => e)
  n = [x].map((e): T | null => e)
  print(n[0])
}
u(4)
function w<T>(x: T) {
  return [x].map((_e) => {
    if 1 > 2 { return 1 }
    return "a"
  })
}
for y in w(4) { print(y) }
