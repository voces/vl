// @run
// A join of two type parameters and `null` keeps the parameters' members apart at a pin of two
// number types, whether the body returns it, ends on it, or reads it, so the caller and the
// body agree on `f64 | i32 | null` (D3611, D3591, D3485).
function R<A, B>(k: i32, a: A, b: B) {
  if k == 0 { return a }
  if k == 1 { return b }
  null
}
function G<A, B>(k: i32, a: A, b: B) {
  if k == 0 { a }
  else if k == 1 { b }
  else { null }
}
function F<A, B>(k: i32, a: A, b: B) {
  const v = if k == 0 { a } else if k == 1 { b } else { null }
  print(v == null)
  const xs = [v, v]
  print(xs[1])
  print(v ?? 9)
}
const x = 2.5
const y = 4
print(R(1, x, y) is f64)
print(R(1, x, y) is i32)
print(G(0, y, x))
print(G(1, y, x))
print(G(2, y, x))
print(G(1, x, y) is i32)
F(1, x, y)
F(2, x, y)
// @log false
// @log true
// @log 4
// @log 2.5
// @log null
// @log true
// @log false
// @log 4
// @log 4
// @log true
// @log null
// @log 9
