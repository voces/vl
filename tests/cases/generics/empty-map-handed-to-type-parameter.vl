// @run
// @log 1
// @log 1
// @log 2
// @log 3
// @log 4
// @log x
// @log 7
// An empty `Map()` or `Set()` handed to a type parameter is closed at the mono map, where the
// instance is pinned too (D1887).
function pass2<A, B>(a: A, _b: B): A { return a }
function p1<B>(_b: B): i32 { return 1 }
function sz<B>(_b: B, n: i32): i32 { return n }
function idt<B>(b: B): B { return b }
function inner<C>(_c: C): i32 { return 7 }
function outer<B>(b: B): i32 { return inner(b) }
const m: {[string]: i32} = Map()
m["k"] = 3
print(pass2(m, Map()).length)
print(p1(Map()))
print(sz(Map(), 2))
print(sz(Set(), 3))
const a: {[string]: i32} = idt(Map())
a["a"] = 4
print(a["a"] ?? 0)
const b: {[i32]: string} = idt(Map())
b[1] = "x"
print(b[1] ?? "-")
print(outer(Map()))
