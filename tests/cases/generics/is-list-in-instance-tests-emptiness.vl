// @log false
// @log false
// @log 2
// @log 2
// An instance handed only lists whose element an annotation or a write fixed answers `is` by
// that element (DECISIONS "An annotation fixes an empty list's element type"): an empty `i32[]`
// does not pass `is f64[]` at a `V[]`, a bare `V`, a `V[][]` or a record field, in a condition and
// as a value. A list nothing fixed still fits every list type (D4910).
function listParam<V>(v: V[]) {
  if v is f64[] { return 1 }
  return 0
}
function bareParam<V>(v: V) {
  if v is f64[] { return 1 }
  return 0
}
function nested<V>(v: V[][]) {
  if v is f64[][] { return 1 }
  return 0
}
function field<V>(r: { v: V[] }) {
  if r.v is f64[] { return 1 }
  return 0
}
function asValue<V>(v: V[]) { print(v is f64[]) }
function chain<V>(v: V[]) {
  if v is f64[] { return 1 }
  else if v is i32[] { return 2 }
  return 0
}
const e: i32[] = []
const f = [3]
print(listParam(e))
print(listParam(f))
print(bareParam(e))
print(bareParam(f))
const ee: i32[][] = []
const ge: i32[][] = [[]]
const he: i32[][] = [[], [2]]
print(nested(ee))
print(nested(ge))
print(nested(he))
print(field({ v: e }))
print(field({ v: f }))
asValue(e)
asValue(f)
print(chain(e))
print(chain(f))
