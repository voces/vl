// @log 2.5
// @log 9
// @hint redundant type annotation: `ys` is inferred as `T[]`
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// @hint redundant type annotation: `inner` is inferred as `boolean`
// @hint redundant type annotation: `zs` is inferred as `T[]`
// A nested generic that redeclares its enclosing function's `T` reads a variable typed at the
// enclosing `T` at that function's pin, and its own `T` at its own (D3840): every read shape,
// one enclosing instance and several, and three levels of the one name.
type Box<V> = { v: V }
function witness<T>(x: T) {
  const ys = [x, x]
  function inner<T>(u: T) {
    print(ys[1])
    print(u)
    const zs = [u]
    print(zs[0])
  }
  inner(7)
  inner("s")
}
witness(true)
witness(2.5)
function annotatedList<T>(x: T) {
  const ys: T[] = [x, x]
  function inner<T>(t: T) {
    print(ys[0])
    print(t)
  }
  inner(7)
}
annotatedList(true)
function record<T>(x: T) {
  const b: Box<T> = { v: x }
  function inner<T>(t: T) {
    print(b.v)
    print(t)
  }
  inner(7)
}
record(true)
record(2.5)
function param<T>(x: T) {
  function inner<T>(t: T) {
    print(x)
    print(t)
  }
  inner(7)
}
param(true)
function inferred<T>(x: T) {
  const y = x
  function inner<T>(t: T) {
    print("y=\{y} t=\{t}")
    const g = () => print(y)
    g()
    for e in [y] { print(e) }
  }
  inner(7)
}
inferred(true)
function equal<T>(x: T): T {
  const y = x
  function inner<T>(_t: T): boolean { y == y }
  print(inner(7))
  y
}
print(equal(2.5))
function ownAnnotations<T>(x: T) {
  function inner<T>(t: T) {
    const z: T = t
    const zs: T[] = [t]
    print(z)
    print(zs[0])
    print(x)
  }
  inner(7)
}
ownAnnotations(true)
function three<T>(x: T) {
  const y = x
  function mid<T>(m: T) {
    const z = m
    function inner<T>(t: T) {
      print(y)
      print(z)
      print(t)
    }
    inner(9)
  }
  mid(2.5)
}
three(true)
