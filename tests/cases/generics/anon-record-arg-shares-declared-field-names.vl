// @run
// @log 3
// @log 3
// @log dm
// D3123: a record argument whose spelled shape a declared record claims by field names alone is
// pinned at its own anonymous row, so the instance reads it at the argument's layout.
type D = { m: string, n: i32 }
type P = { x: i32, y: i32 }
function g<T>(b: { m: T, n: i32 }): T { b.m }
const e = g({ m: { x: 1, y: 2 }, n: 2 })
print(e.x + e.y)
const p: P = { x: 1, y: 2 }
const f = g({ m: p, n: 2 })
print(f.x + f.y)
const dd: D = { m: "dm", n: 8 }
print(dd.m)
