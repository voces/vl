// @run
// @log o
// @log "hi"
// @hint redundant type annotation: `tag` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `{r: i32}` — remove it to lean on inference
// CONTRACT (must-RUN): D933 — and the ablation that folded it into D932. Widening a
// generic `v: T` into `i32 | string | T` and narrowing the STRING arm, instantiated at
// a second REF type (`T = Circle`): in the Circle instance `aw`'s rep is the raw
// variant ref (no box — the union's other arms claim no storage the value can hold),
// so `aw is string` folds to `i32.const 0`... and the arm body still emitted, its
// narrowed use extracting a string from the Circle ref ("expected (ref $type), found
// (ref $type)" at `vl check` rc 0). D932's byte-read dead-arm skip closes it: the arm
// whose condition the module carries as a constant is pruned per instance. The
// direct spelling (`d933_ctl_direct`) and the constant-arm control (`d933_ctl_const_arms`)
// both ran before the fix and must keep running.
type Circle = { r: i32 }

function tag<T>(v: T): string {
  const aw: i32 | string | T = v
  if aw is string { return "\"" + aw + "\"" }
  "o"
}

const c: Circle = { r: 3 }
print(tag(c))
print(tag("hi"))
