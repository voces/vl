// @run
// @log 7
// @log 5
// @log s
// @log 5
// @log 7
// @log 3
// @log s
// @log 3
// A call through an alias of a capturing nested generic from a sibling function or a lambda
// reaches the generic through the alias's chain, in each instance of the enclosing generic
// (D3903).
function viaSibling<T>(x: T) {
  function inner<U>(u: U) {
    print(x)
    print(u)
  }
  const k = inner
  function sib() { k(5) }
  sib()
}
viaSibling(7)
viaSibling("s")
function viaLambda<T>(x: T) {
  function inner<U>(u: U) {
    print(x)
    print(u)
  }
  const k = inner
  const g = () => k(3)
  g()
}
viaLambda(7)
viaLambda("s")
