// @run
// @log 3
// @log 1
// @log 1
// @log 1
// D13964: at `T := null` the generic join keeps `[t]`'s `null[]` apart from `(i32 | null)[]`,
// so the instance's union holds a `null[]` member, bound in a generic body and passed on.
function w3<T>(t: T, k: i32, q: (i32 | null)[]) {
  if k == 0 { return [1, 2] }
  if k == 1 { return q }
  [t]
}
function g5<T>(t: T, k: i32, q: (i32 | null)[]) {
  const v = w3(t, k, q)
  print(v.length)
}
function n5<T>(t: T, q: (i32 | null)[]) { w3(t, 2, q).length }
const q3: (i32 | null)[] = [5, null, 6]
g5(null, 1, q3)
g5(null, 2, q3)
print(n5(null, q3))
print(w3(null, 2, q3).length)
