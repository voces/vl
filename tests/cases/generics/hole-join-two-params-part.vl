// @run
// @log true
// @log 4
// @log false
// @log true
// @log true
// @log x
// @log 7
// @log i32
// @log P
// An un-annotated parameter is an implicit type parameter, so a join of two of them keeps
// both members apart and re-joins at each call, as `g<A, B>` does (D3333).
type P = {x: i32}
function g(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  print(r)
}
g(true, 4, 0)
g(true, 4, 1)
function h(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  print(r is i32)
}
h(true, 4, 0)
h(true, 4, 1)
function s(a0, a1, k: i32) { return if k == 0 { a0 } else { a1 } }
print(s(true, "x", 0))
print(s(true, "x", 1))
print(s(7, "y", 0))
function m(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  return r
}
const p = { x: 12 }
const v0 = m(3, p, 0)
print(
  match v0 {
    i32 => "i32"
    P => "P"
  },
)
const v1 = m(3, p, 1)
print(
  match v1 {
    i32 => "i32"
    P => "P"
  },
)
