// @run
// @log 3
// @log 3
// @log 6
// THE OTHER SIDE of `type-param-nested-list-field.vl`: two spellings that produce the
// SAME instantiated shape `{v: i32[][]}` and must therefore lower the same way.
//
//   type Box<T> = { v: T[][] }   applied at `Box<i32>`    — the sibling file
//   type Box<T> = { v: T[] }     applied at `Box<i32[]>`  — this file
//
// The pair is what shows the substitution's answer cannot depend on nesting, on the
// element type, or on the type the application yields — only on where the `[]` is
// written. It also pins the ARGUMENT-side nesting on its own: `gaeApplyFieldTy` re-attaches
// the field's own `[]` run to the argument TEXT, so an argument that is itself an array
// carries its brackets through the substitution untouched.
//
// Held fixed while varying: one alias, one parameter, one field, one instantiation,
// one element type. The only thing that moves between the two files is which side of
// the application the `[]` is written on.
type Box<T> = { v: T[] }

const b: Box<i32[]> = { v: [[1, 2], [3], [4, 5, 6]] }

print(b.v.length)
print(b.v[1][0])
print(b.v[2][2])
