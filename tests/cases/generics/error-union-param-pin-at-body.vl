// @check
// @error `pr` prints its type parameter here: print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got R — print the elements or fields individually, e.g. `print(xs[0])`
// @error `early` prints its type parameter here: print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got R — print the elements or fields individually, e.g. `print(xs[0])`
// @error `pr` prints its type parameter here: print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got i32[] — print the elements or fields individually, e.g. `print(xs[0])`
// @error cannot assign i32 to 'z' of type string (the body of `dest` at the call's argument types)
// @error cannot assign i32 | string to 'r' of type string
// A type parameter bound only through a union parameter (`v: T | string`) is pinned to the
// argument's members no concrete member admits, and the body is held to that pin exactly as an
// explicit `k<R>(…)` holds it: a print, a destination and the return (D2803).
type R = { a: i32 }
function pr<T>(v: T | string) {
  if v is string { print(v) } else { print(v) }
}
function early<T>(v: T | string) {
  if v is string { return }
  print(v)
}
function dest<T>(v: T | string) {
  if !(v is string) {
    const z: string = v
    print(z)
  }
}
function back<T>(v: T | string): T | string { v }
const x: string | R = "q"
pr(x)
const y: R = { a: 1 }
early(y)
const xs: i32[] | string = "q"
pr(xs)
dest(3)
const r: string = back(3)
print(r)
