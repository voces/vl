// @error-at 22:5 cannot assign string to 'y' of type i32 (the body of `asInt` at the call's argument types)
// A generic delivered by name as a function value is instantiated at the destination's
// parameter types, and the constraints its body deferred are held there as a direct call's are:
// as an argument, an annotated binding, a record field, a list element and a return (D3080).

type R = { a: i32 }
type H = { f: (R) => void }

function hof(f: (R) => void) { f({ a: 1 }) }
function pick(): (R) => void { return show }
function wide(f: (string) => void) { f("s") }

hof(show)
const g: (R) => void = show
const h: H = { f: show }
const fs: ((R) => void)[] = [show]
wide(asInt)
g({ a: 2 })
h.f({ a: 3 })
fs[0]({ a: 4 })
pick()({ a: 5 })

function show<T>(x: T) { print(x) }
function asInt<T>(x: T) {
  const y: i32 = x
  print(y)
}
