// @check
// @error cannot assign f64 | boolean to 'v' of type f64 — a `boolean` is not a number; convert it with `b as f64` (the body of `bind`
// @error return type mismatch: expected f64, got f64 | boolean — a `boolean` is not a number; convert it with `b as f64` (the return of `ret`
// @error argument of type f64 | boolean flows into `h` expecting f64 — a `boolean` is not a number; convert it with `b as f64` (the call's argument types)
// @error cannot assign f64 | string to 'v' of type f64 (the body of `bind`
// A `??` whose default is a type parameter is the join of the left's non-null face and the
// pinned default, as the direct spelling types it, so a pin that does not fit the face is
// refused at every destination instead of reading a boolean's `1` as `1.0` (D3252).
function bind<T>(x: T) {
  const o: f64 | null = null
  const v: f64 = o ?? x
  return v / 4.0
}
function ret<T>(x: T): f64 {
  const o: f64 | null = null
  return o ?? x
}
function h(v: f64) { return v / 4.0 }
function arg<T>(x: T) {
  const o: f64 | null = null
  return h(o ?? x)
}
print(bind(3 > 2))
print(ret(3 > 2))
print(arg(3 > 2))
print(bind("hello"))
