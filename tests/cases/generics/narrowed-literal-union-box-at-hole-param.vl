// @run
// @log a
// @log 0
// @log null
// @log b
// @log b
// @log b
// @log 4
// D8181, D8281: a value union holding inline string literals, handed to an un-annotated parameter
// that two calls clone, keeps its literal members in the instance; and one with only its `null`
// narrowed away is handed on without it: alongside a value, `null`, a non-null spelling, an
// aliased literal set, a generic parameter and an annotated one.
type AB = "a" | "b"
function take(v) {
  if v is i32 { print(0) } else { print(v) }
}
function g(v) {
  if v is i32 { print(v + 1) } else { print(v) }
}
function gT<T>(v: T) {
  if v is i32 { print(1) } else { print(v) }
}
function gA(v: i32 | AB | null) {
  if v is i32 { print(v + 1) } else { print(v) }
}

const r: i32 | "a" | "b" | null = "a"
const q: i32 | "a" | "b" | null = null
const s: i32 | "a" | "b" = "b"
take(r)
take(7)
take(q)
take(s)
const ra: i32 | AB | null = "b"
if ra != null { g(ra) }
if ra != null { gT(ra) }
const ri: i32 | AB | null = 3
if ri != null { gA(ri) }
