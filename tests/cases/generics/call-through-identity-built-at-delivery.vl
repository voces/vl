// @run
// @log 9
// @log 3
// @log 3
// @log 4
// @log 5
// D14530: a call handed through a generic identity is built where another call of the same
// function is delivered, and the identity's instance stores it there.
type Circle = { r: i32 | null }
function sink(x: Circle) { print(x.r ?? 9) }
function id<T>(x: T): T { x }
function mkcall() {
  const cc = { r: null }
  return cc
}
sink(mkcall())
const y = id(mkcall())
print(y.r ?? 3)
const y2 = id(id(mkcall()))
print(y2.r ?? 3)
print(id(mkcall()).r ?? 4)
const z: Circle = id(mkcall())
print(z.r ?? 5)
