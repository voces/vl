// @run
// @log x
// @log y
// @log x
// @log a
// @log x
// @log 5
// @log a
// @log b
// @log true
// A `??` over a declared type parameter pinned at a type that cannot be null has a dead default,
// so the call's re-check types it as the pin, as the concrete `??` does (D2951).
type K = "a" | "b"
function ret<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  r
}
print(ret("x", "y", true))
print(ret("x", "y", false))
function show<T>(a: T) {
  const r = a ?? 5
  print(r)
}
show("x")
const k: K = "a"
show(k)
function tail<T>(a: T) { a ?? 5 }
print(tail("x"))
// A pin that can be null still takes the default.
const none: string | null = null
show(none)
function bind<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  print(r)
}
const kb: K = "b"
bind(k, kb, true)
bind(k, kb, false)
// The join bound and read through an alias (D2916).
function alias<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  const s = r
  s
}
print(alias(true, false, true))
