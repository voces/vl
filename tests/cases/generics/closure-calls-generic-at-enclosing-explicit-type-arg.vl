// @run
// @log 1
// @log 2
// @log 3
// A closure in a generic body calls a generic at the enclosing type parameter, spelled as an
// explicit `<V>`, and each of the enclosing function's instances calls its own instance (D5001).
function lenG<W>(xs: W[]) { xs.length }
function t<V>(a: V[]) {
  const k = () => lenG<V>(a)
  print(k())
}
t([1])
t(["a", "b"])
t([1.5, 2.5, 3.5])
