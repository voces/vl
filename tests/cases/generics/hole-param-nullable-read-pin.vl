// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 2
// @log hi

// D1753 — a NULLABLE value delivered to an un-annotated (hole) parameter. The pin ladder's
// arms all name a non-null rep, so a map read — an i32-repped niche — fell to the `"i32"`
// catch-all and the instance's parameter lost its `| null`. The body's `!= null` then had no
// context for its null and refused. A nullable CALL and a nullable LOCAL pinned correctly all
// along and are the controls; the annotated parameter is the neighbour that always ran.
const m: {[string]: i32} = Map()
const sm: {[string]: string} = Map()

function mk(b: boolean): i32 | null {
  if b { return 5 }
  null
}

const loc: i32 | null = 5

function take(a) {
  if a != null { print(a) } else { print(0) }
}

m["k"] = 5
sm["k"] = "hi"

// Both map-read spellings: the index form and the method form are one lowering and one pin.
take(m["k"])
take(m.get("k"))

// The two controls, which pinned `i32 | null` before this row and must keep doing so.
take(mk(true))
take(loc)

// A `?.` read, the other nullable projection the row names.
type L = { y: i32[] }

function mkL(b: boolean): L | null {
  if b { return { y: [1, 2] } }
  null
}

function takeLen(a) {
  if a != null { print(a.length) } else { print(0) }
}

const b = mkL(true)
takeLen(b?.y)

// A string-valued map, so the rung is not read as an i32-only patch.
take(sm.get("k"))
