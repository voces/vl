// @run
// @log true
// @log true
// @log false
// @log s
// @log 2.5
// @log true
// A hole or generic instance calling a record's field function reads the call's result at the
// function's own return type when the row stores that field as `| null`: a declared record of
// the literal's field names lays the literal out at the nullable field (D3192).
type R = { v: i32, f: (() => boolean) | null }
function F(z) { print(z.f()) }
function G<Z>(z: Z) { print(z.f()) }
F({ v: 7, f: () => true })
G({ v: 7, f: () => true })
function B(z) {
  const x = z.f()
  print(x == true)
}
B({ v: 1, f: () => false })
type S = { v: i32, f: (() => string) | null }
function P(z) { print(z.f()) }
P({ v: 1, f: () => "s" })
type D = { v: i32, f: (() => f64) | null }
P({ v: 1, f: () => 2.5 })
function Q(z) { return z.f() }
print(Q({ v: 2, f: () => true }))
