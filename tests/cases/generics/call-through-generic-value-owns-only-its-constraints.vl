// @run
// @log 14
// @log 8
// @log 1
// @hint Intentionally-unused parameter
// D15035: a call through a value typed at one generic's signature asks that generic's constraints
// only, not another generic's member constraint on a same-named `T`.
function id<T>(x: T): T { x }
function each<T>(self: T[], g: (T) => void) {
  for x in self { g(x) }
}
function cnt3<T>(x: T) {
  let n = 0
  x.each((_v) => {
    n = n + 1
  })
  n
}
const ks = [id]
function both<T>(t: T) {
  ks[0] = (x) => x + x
  print(ks[0](7))
  print(t)
}
both(8)
print(cnt3([5]))
