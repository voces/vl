// @run
// @log x
// @log V
// @log E
// @log x!
// @log y?
// @log pq
// @log z
// @hint redundant type annotation: `bound` is inferred as `string`
// @hint redundant type annotation: `xs` is inferred as `string[]`
// @hint redundant type annotation: `n` is inferred as `string`
// THE SUBSTITUTION ROUTE IS A THIRD UNION-CONSTRUCTION SITE — D1049.
//
// D1024's subsumed-arm collapse is called from `annUnionInnerTy` (both annotation
// spellings) and from `fillTypeDeclAt`'s `UnionDecl` arm. A union built by SUBSTITUTION at
// the pin — `substTyDeep`, when `T` is replaced in `T | "err"` — reached NEITHER, so
// `pick<T>(v: T): T | "err"` at `T = string` minted the duplicate `string` atom exactly as
// every route used to: `vl check` rc 0 and `expected struct type at index 0, found (array
// (mut i32))`, byte for byte D1024's own message, while the DIRECT spelling
// `function pick(v: string): string | "err"` ran and printed `x`.
//
// THE INDEX DEDUP ALREADY THERE CANNOT SEE IT. `substTyDeep`'s `TyUnion` arm dedupes by
// ARENA INDEX (#1483's fold, for `T | string` at `T := string`); `string` and `"err"` are
// different rows, so nothing is duplicated by index. What is duplicated is the VALUE SET,
// which is the question `unionArmSubsumedBy` asks — so the two folds are both needed, in
// that order.
//
// THE HINTS ARE DECLARED, NOT DELETED, for the reason D1024's own fixture records: each one
// names an annotation whose union collapsed to a single arm, and deleting the annotation to
// silence it would delete the delivery position the fixture exists to sweep.
//
// THE NON-COLLAPSING INSTANTIATIONS discriminate in TWO places now that D1042 has closed, and
// the split is no longer forced. `T = i32` and `T = Circle` are genuine two-arm boxes that must
// NOT collapse; until the pin registered its union they had no `is` lowering at all, so the only
// control available was a CHECKER one. Both now exist: the RUNNING discrimination is in
// `pin-union-return-registers-through-canon.vl`, and the sibling `@check` fixture
// `error-subsumed-literal-arm-at-the-pin-controls.vl` keeps the fact a running program cannot
// state — `const z: i32 = pick(7)` is a type error, which it is only while the `"err"` arm
// survives.

type Name = string

function pick<T>(v: T): T | "err" { return v }

// T = string: the union collapses to `string`, so the value delivers as a bare string ref
// at every position — a duplicate atom was invalid wasm at all of them.
print(pick("x"))

const r0 = pick("x")
if r0 is "err" { print("E") } else { print("V") }

// The `is` must answer TRUE for its own arm too, not merely false for the other one.
const r1 = pick("err")
if r1 is "err" { print("E") } else { print("V") }

const bound: string = pick("x")
print(bound + "!")

function take(s: string) { print(s + "?") }
take(pick("y"))

const xs: string[] = [pick("p"), pick("q")]
print(xs[0] + xs[1])

// The subsuming arm reached THROUGH AN ALIAS — subsumption is decided after flattening and
// through aliases, and the pin is no exception.
const n: Name = "z"
print(pick(n))
