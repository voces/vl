// D8400's annotated face: the identity's parameter names `null`, so the return is `null` by
// inference; it must keep agreeing with the hole spelling.
type C = { a: i32, b: i32 }
function hid(x: null) { x }
const t: C | null = hid(null)
print(t == null)
function ret(): C | null { return hid(null) }
print(ret() == null)
function take(c: C | null) { print(c == null) }
take(hid(null))
