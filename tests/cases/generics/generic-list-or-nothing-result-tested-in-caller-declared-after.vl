// @run
// @log not
// @log not
// A generic caller declared below its first call tests a generic result with `is`: the test is
// decided at each instance, never by a quiet check of the caller made before its declaration.
c2("q", true)
c2(1.5, false)
function w<T>(t: T, b: boolean) {
  if b { return [t, t] }
}
function c2<T>(t: T, b: boolean) {
  const v = w(t, b)
  if !(v is i32[]) { print("not") }
}
