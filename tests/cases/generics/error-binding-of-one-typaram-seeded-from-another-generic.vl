// @emit-error a generic function taken as a value reaches no call that fixes its type — annotate the destination's function type
// A binding annotated with one type parameter, seeded from a parameter of another, the two
// bound to different generics called at different types. The refusal comes before mono's
// seeded-binding check, which this program would otherwise be the first to reach.
function same<T>(k: T): T { k }
function twice<T>(k: T): T { k }
function mid<F, G>(a: F, a1: G) {
  let b: F = a1
  print(a("x"))
  print(b(3))
}
mid(same, twice)
