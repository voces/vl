// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 3
// @log true
// @log 1
// @log x
// @log 3
// @log true
// @log s
// A type parameter seeded from a let annotation binds at a call inside a generic's cloned body (D15495).
function same<T>(k: T): T { k }
function mid3<F, G, H, G1>(a: F, a1: G1, a2: H) {
  let b: G1 = a1
  const c: G = a2
  print(a("x"))
  print(b(3))
  print(c(true))
}
function outer<X>(x: X) {
  mid3(same, same, same)
  print(x)
}
outer(1)
outer("s")
