// @run
// @log 9
// @log null
// @log b
// @log 3
// The instance re-check gives a node the type its template gave it where the emitter builds
// from the template: `as?` to a number over an open operand, and an `is` test over a bare
// type parameter (D14487).
function k<T>(u: T) {
  const v = u as? i32
  print(v)
}
k(9)
k("s")

type A = { n: i32 | string }
type B = { n: string }
function pick(i: i32): A | B {
  if i == 0 {
    const a: A = { n: 3 }
    return a
  }
  const b: B = { n: "b" }
  b
}
function f<T>(u: T) {
  if u is B { print(u.n) }
}
function g<T>(u: T) {
  if u is A { print(u.n) }
}
f(pick(1))
g(pick(0))
