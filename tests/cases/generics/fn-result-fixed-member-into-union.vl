// @log 3
// @log s
// @log 0
// @log s
// @log 0
// A function value whose result is the fixed member of a generic's `() => T | string` binds
// nothing, so `T` takes the unbound default and the function is delivered into the union box
// the instance reads; no test in the body can tell which default was taken (D10161).
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { 0 } else { 1 }
}
print(len(() => "s"))
print(len((): string => "s"))
print(len((): string => "s"))
print(len((): i32 | string => 4))
const g = () => "s"
print(len(g))
function size<T>(f: () => T[] | string) {
  const t = f()
  if t is string { t.length } else { 99 }
}
print(size(() => "abc"))
function show<T>(f: () => T | string) {
  const t = f()
  if t is string { print(t) } else { print(t) }
}
show(() => "s")
function kind<T>(f: () => T | string) {
  const t = f()
  if t is i32 { 1 }
  else if t is f64 { 2 }
  else { 0 }
}
print(kind(() => "s"))
function at<T>(f: (n: i32) => T | string) {
  const t = f(2)
  if t is string { t } else { "x" }
}
print(at((n: i32) => if n > 0 { "s" } else { "t" }))
print(len(() => "t"))
