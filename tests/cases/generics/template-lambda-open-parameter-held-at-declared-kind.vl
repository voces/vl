// @run
// @log 4
// @log 2
// @log 3
// A lambda inside a generic body takes a parameter at the template's open type, which each
// instance binds afresh: counted over a list of numbers, of strings and of records.
type P = { x: i32 }
function each<T>(self: T[], f: (T) => void) {
  for x in self { f(x) }
}
function count<T>(x: T) {
  let n = 0
  each(x, (_v) => {
    n = n + 1
  })
  return n
}
print(count([1, 2, 3, 4]))
print(count(["a", "b"]))
const ps: P[] = [{ x: 1 }, { x: 2 }, { x: 3 }]
print(count(ps))
