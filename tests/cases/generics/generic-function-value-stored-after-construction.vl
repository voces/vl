// A generic function stored into a list element, a nested list, a record field, and pushed,
// inside a generic: each store is coerced at the slot's type at this instance (D3909).
type R<V> = { f: (v: V) => void }
function b<U>(y: U) { print(y) }
function c<U>(y: U) { print("c"); print(y) }
function a<T>(x: T) {
  const fs: ((t: T) => void)[] = [b]
  fs[0] = c
  fs[0](x)
  const gs: ((t: T) => void)[][] = [[b], [c]]
  gs[1][0](x)
  gs[0][0] = c
  gs[0][0](x)
  const r: R<T> = { f: b }
  r.f = c
  r.f(x)
  const hs: ((t: T) => void)[] = []
  hs.push(b)
  hs[0](x)
}
a(false)
a("s")
