// @run
// @log q
// A LIST OF LISTS whose leaf element is a generic application carrying a union
// argument (`Pair<i32 | null, string>[][]`). Two `[]` peels sit above the generic
// brackets, so an angle-blind scan mis-splits the name at the argument's `|` and the
// emitted module does not even parse as WebAssembly.
type Pair<A, B> = { a: A, b: B }

const ps: Pair<i32 | null, string>[][] = [[{ a: 1, b: "q" }]]

print(ps[0][0].b)
