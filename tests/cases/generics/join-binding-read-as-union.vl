// D2916's grading list: a generic join with a `??` arm, bound and then read through an alias,
// a reassignment, a generic call's argument or a comparison, keeps the value it was given at
// a pin that cannot be null, with an `i32` or a `"d"` default.
function sink<U>(x: U) { print(x) }
function g0<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  const s = r
  s
}
print(g0(true, false, true))
print(g0(true, false, false))
function g1<T>(a: T, b: T, c: boolean) {
  let r = if c { a ?? 5 } else { b }
  if !c { r = b }
  r
}
print(g1(true, false, true))
print(g1(true, false, false))
function g2<T>(a: T, b: T, c: boolean) {
  let r = if c { a ?? 5 } else { b }
  const r2 = if !c { a ?? 6 } else { b }
  r = r2
  r
}
print(g2(true, false, false))
print(g2(true, false, true))
function g3<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  sink(r)
  r
}
print(g3(true, false, true))
print(g3(true, false, false))
function g4<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  if r != b { print("ne") }
  if r == b { print("eq") }
  r
}
print(g4(true, false, true))
print(g4(true, false, false))
function g5<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? "d" } else { b }
  const s = r
  s
}
print(g5(true, false, true))
print(g5(true, false, false))
print(g5(3, 4, true))
print(g5("x", "y", false))
