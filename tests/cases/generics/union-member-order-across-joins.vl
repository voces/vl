// @log 2
// @log 1
// @log 2
// A generic join of two arms in both orders, a declared `type U = B | A` beside an inferred
// `A | B`, and joins of lists over a literal union beside `string[]` and `i32[]` in both orders:
// every read finds its own arm whichever order named the union's row.
type A = { a: i32 }
type B = { b: string }
type U = B | A
type K = "a" | "b"
function id<T>(x: T): T { return x }
function first<T>(xs: T[]): T { return xs[0] }
function back<T>(x: T): T[] { return [x, x] }
function choose<T0, T1>(a0: T0, a1: T1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  if r is A { print(r.a) }
  else if r is B { print(r.b) }
  else { print("?") }
}
function chooseL<T0, T1>(a0: T0[], a1: T1[], k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  print(r.length)
  for e in r { print(e) }
}
const pa: A = { a: 3 }
const pb: B = { b: "pb" }
choose(pa, pb, 0)
choose(pa, pb, 1)
choose(pb, pa, 0)
choose(pb, pa, 1)
const u1: U = { a: 4 }
const u2: U = { b: "u2" }
const inf = if u1 is A { pa } else { pb }
function showU(u: U) {
  if u is A { print(u.a) } else { print(u.b) }
}
showU(id(u1))
showU(id(u2))
showU(first(back(u2)))
if inf is A { print(inf.a) } else { print(inf.b) }
const ks: K = "b"
chooseL(["s"], [ks], 0)
chooseL(["s"], [ks], 1)
chooseL([ks], ["s"], 0)
chooseL([ks], ["s"], 1)
chooseL([1, 2], [ks], 1)
chooseL([ks], [1, 2], 1)
