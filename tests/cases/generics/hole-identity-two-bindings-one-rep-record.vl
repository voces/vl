// @run
// @log 6
// @log 5
// @log 6
// @log 5
// Two calls of a hole identity typed at different records, each built at the same wider record,
// are one instance at that record, checked with the program rather than on demand at the build.
type Circle = { r: i32 | null }
function id(x) { return x }
const w: Circle = id({ r: null })
print(w.r ?? 6)
const w3: Circle = id({ r: 5 })
print(w3.r ?? 0)
function mkcall() { { r: null } }
function mk2() { { r: 5 } }
const v: Circle = id(mkcall())
print(v.r ?? 6)
const v3: Circle = id(mk2())
print(v3.r ?? 0)
