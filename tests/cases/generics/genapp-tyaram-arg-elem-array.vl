// @run
// @log 3
// @log 2
// @log a
// @log 1.5
// A generic parameter typed by an alias application `Box<T>` whose body is `{ v: X[] }` binds
// `T` from the argument's element type, unified on the arena, and each read of the field
// proves the instance's element type. `genapp-tyaram-array-arg.vl` is the same field spelled
// one application along; `genapp-tyaram-arg-shadow-control.vl` holds the shadowing controls.
type Box<X> = { v: X[] }

function len<T>(b: Box<T>) { b.v.length }
function first<T>(b: Box<T>): T { b.v[0] }

print(len({ v: [1, 2, 3] }))
print(len({ v: ["a", "b"] }))
print(first({ v: ["a", "b"] }))
print(first({ v: [1.5, 2.5] }))
