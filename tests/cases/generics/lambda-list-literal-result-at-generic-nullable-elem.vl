// @log 2
// A lambda whose result is a list literal, handed to a generic whose function parameter's result
// is a list of `T | null`, builds its list at the bound `(T | null)[]` (D16924).
function gen<T>(f: () => (T | null)[]) { return f().length }
print(gen(() => [1]))
function first<T>(f: () => (T | null)[]): T | null { return f()[0] }
const a = first(() => [null, 4])
if a == null { print(0) } else { print(a) }
function last<T>(f: () => (T | null)[]): T | null {
  const xs = f()
  return xs[xs.length - 1]
}
const b = last(() => [null, 4])
if b == null { print(0) } else { print(b + 1) }
function at<T>(f: () => (T | null)[], i: i32): T | null { return f()[i] }
const c = at(() => [1, null, 3], 1)
const d = at(() => [1, null, 3], 2)
if c == null { print(0) } else { print(c) }
if d == null { print(0) } else { print(d) }
print(gen(() => ["a", "b"]))
function arg<T>(f: (x: i32) => (T | null)[]) { return f(3).length }
print(arg((x) => [x, null, x]))
print(
  gen(() => {
    return [1, 2]
  }),
)
const e = last(() => [7])
if e == null { print(0) } else { print(e + 1) }
const k = 3 > 2
const g = last(() => {
  if k { return [4] }
  return [5]
})
if g == null { print(0) } else { print(g) }
const h = last(() => if k { [1, 2] } else { [3] })
if h == null { print(0) } else { print(h) }
