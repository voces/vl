// @run
// @log 1.5
// @log 4
// A module global holding a generic call's list of lists of un-annotated functions of two result
// types stores the list its call returns, and a call through an element reads it back.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id2(x) { return x }
const ll = id2([[inc0, half]])
print(ll[0][1](3))
print(ll[0][0](3))
