// @run
// @log 3
// @log 7
// The array twins of `error-param-shadow-tyaram-nullable-elem.vl`: a type parameter `T`
// shadowing a declared `T`, used as an inline shape field's array element at depth one and
// two. The arena records the original's field element as the parameter while the emitter's
// spelling resolves the declared struct, so whether the original's shape is minted must not
// change what the instances do.
type T = { x: i32 }

function f<T>(v: { g: T[] }) { v.g.length }

function h<T>(v: { g: T[][] }) { v.g[0][0].x }

print(f({ g: [{ x: 1 }, { x: 2 }, { x: 3 }] }))
print(h({ g: [[{ x: 7 }]] }))
