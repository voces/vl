// @run
// @log 1
// @log 2
// @log 1
// @log 3
// @log other 1
// @log other 2
// @log other 3
// @log ints 1
// @log 3
// @log 2
// @log 3
// @log none
// @log 1
// @log 2
// @log b
// @hint redundant type annotation: `b` is inferred as `V[] | i32[]` — remove it to lean on inference
// @hint redundant type annotation: `first` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A generic's `V[] | i32[]` parameter forwarded to another generic's `W[] | i32[]` binds `W`
// directly, through an annotated local and across two hops (D4931); a nullable or wider union
// narrowed to `string[] | i32[]` binds it as well (D4965).
function len<W>(a: W[] | i32[]) { a.length }
function fwd<V>(a: V[] | i32[]) { print(len(a)) }
fwd(["z"])

function fwdLocal<V>(a: V[] | i32[]) {
  const b: V[] | i32[] = a
  print(len(b))
}
fwdLocal(["z", "y"])
fwdLocal([1.5])
fwdLocal([3, 4, 5])

type P = { x: i32 }
function first<W>(a: W[] | i32[]): string {
  if a is i32[] { return "ints \{a.length}" }
  "other \{a.length}"
}
function fwd2<V>(a: V[] | i32[]) { print(first(a)) }
function fwd3<U>(a: U[] | i32[]) { fwd2(a) }
const ps: P[] = [{ x: 1 }, { x: 2 }]
fwd2(["z"])
fwd2(ps)
fwd3([true, false, true])
fwd3([7])

function mk(): string[] | i32[] { ["a", "a", "a"] }
const mv: string[] | i32[] | null = mk()
if mv != null { print(len(mv)) }
function g(m: string[] | i32[] | null) {
  if m != null { print(len(m)) } else { print("none") }
}
g(["a", "b"])
g([1, 2, 3])
g(null)
function h(x: string[] | i32[] | boolean) {
  if x is boolean { print("b") } else { print(len(x)) }
}
h(["q"])
h([4, 5])
h(true)
