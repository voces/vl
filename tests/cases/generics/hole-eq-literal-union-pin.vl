// @run
// @log true
// @log false
// @log true
// @log false
// @log true
// A hole compared with a string literal holds at a literal-union pin that has the literal as a
// member, as the direct spelling's comparison does.
type AB = "a" | "b"
function f(z) { print(z == "b") }
function g(z) { print("a" != z) }
const m: {[i32]: AB} = Map()
m[3] = "b"
const y = m[3]
const w: AB = "a"
f(y)
f(w)
f("b")
g(w)
g(y)
