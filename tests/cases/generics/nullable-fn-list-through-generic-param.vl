// @run
// @log 2
// A `(T | null)[]` parameter whose `T` binds to a function, handed a list of a function and a
// `null`: its function element is called through the instance. This was refused at emit as
// "a nullable-(i32)=>i32 list element has no rep" though it type-checks and runs.
function first<T>(xs: (T | null)[]): T | null { return xs[0] }
function inc(a: i32): i32 { return a + 1 }
const f = first([inc, null])
if f != null { print(f(1)) }
