// @run
// @log 1.25
// @log q
// @log 5
// @log true
// @log 1.25
// A hole-parameter function returning a local that holds its `f64 | string`, `i32 | string` or
// `boolean | i32` pin returns the union's box, whether the local is the parameter, a nested
// lambda's result or another function's (D2895).
function viaLambda(x) {
  const c = (y) => y
  const r = c(x)
  return r
}
function viaLocal(x) {
  const r = x
  return r
}
function id(y) { return y }
function viaCall(x) {
  const r = id(x)
  return r
}
const fs: f64 | string = 2.5
const w = viaLambda(fs)
if w is f64 { print(w / 2.0) } else { print(w) }
const fq: f64 | string = "q"
const w2 = viaLocal(fq)
if w2 is f64 { print(w2 / 2.0) } else { print(w2) }
const ist: i32 | string = 4
const w3 = viaCall(ist)
if w3 is i32 { print(w3 + 1) } else { print(w3) }
const bi: boolean | i32 = true
const w4 = viaLocal(bi)
if w4 is boolean { print(w4) } else { print(w4 + 1) }
const w5 = viaCall(fs)
if w5 is f64 { print(w5 / 2.0) } else { print(w5) }
