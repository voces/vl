// @log 1
// A capturing hole lambda of a generic encloser, cloned after another encloser's instance handed
// one nested function to two type parameters: that instance is not walked a second time (D15601).
function midTwo<F, G>(a: F, b: G) {
  print(a("y"))
  print(b(3))
}
function outerTwo<U>(u: U) {
  function same(k) {
    print(u)
    k
  }
  midTwo(same, same)
}
outerTwo(4)
outerTwo("w")
function midOne<F>(a: F) {
  print(a("v"))
  print(a(1))
}
function outerFn<U>(u: U) {
  const same = (k) => {
    print(u)
    k
  }
  midOne(same)
}
outerFn(3)
