// @check
// @error member access '.length' on non-object string | null (the body of `len` at the call's argument types)
// @error member access '.v' on non-object P | null (the body of `fld` at the call's argument types)
// @error argument of type string | null flows into `take` expecting string (the call's argument types)
// A read that needs the value non-null is refused at a pin where the written place may hold
// `null`, as the direct spelling refuses it, rather than read as non-null (D3240).
type P = { v: i32 }
function len<T>(x: T) {
  let s: string | null = null
  s = "z"
  s = x
  print(s.length)
}
function fld<T>(x: T) {
  let r: P | null = null
  r = x
  print(r.v)
}
function take(y: string) { print(y) }
function arg<T>(x: T) {
  const q: { s: string | null } = { s: null }
  q.s = x
  take(q.s)
}
const sn: string | null = null
len(sn)
len("ok")
const pn: P | null = null
fld(pn)
arg(sn)
