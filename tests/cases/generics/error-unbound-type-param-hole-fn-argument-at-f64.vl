// @check
// @error-at 6:16 argument 1: expected i32, got f64 (`sel`'s `A` is bound by nothing at its call, so it is `i32` there: write `sel<f64>(…)`)
// An un-annotated function argument binds no type parameter, so `A` is the `i32` default at
// `sel(hinc)` and an `f64` argument to its result is refused, naming the remedy (D16412).
function hinc(x) { return x + 1 }
function sel<A>(f: (x: A) => A): (x: A) => A { return f }
print(sel(hinc)(2.5))
