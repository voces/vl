// @run
// @log a
// @log null
// A `??` joined with the other parameter at a `K | null` pin keeps the null `b` carries: the
// hole instance's elaboration types the join. The declared-`T` spelling is D3290's.
type K = "a" | "b"
function g(a, b, c: boolean) {
  const r = if c { a ?? "b" } else { b }
  print(r)
}
const u: K | null = "a"
const w: K | null = null
g(u, w, true)
g(u, w, false)
