// @run
// @log 0
// @log 1
// @log 1
// @log 0
// @log 1
// @log 0
// @log 3
// @log 99
// @log 3
// @log 102
// @log abc
// @log 3
// A function value handed through a hole parameter into a generic's `() => T | string`
// parameter is delivered at the type that call binds, so the instance reads the boxed
// result whether the value's result is the fixed member or narrower (D10210, D10160).
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { 0 } else { 1 }
}
function take(a) { print(len(a)) }
take(() => "s")
take(() => 4)
take(() => 2.5)
take((): i32 | string => "q")
take((): i32 => 3)
const g = () => "s"
take(g)

function count<T>(f: () => T | string) {
  const t = f()
  if t is string { t.length } else { 99 }
}
function viaCount(a) { print(count(a)) }
function fwd(b) { viaCount(b) }
fwd(() => "abc")
fwd(() => 4)

function size<T>(f: () => T[] | string) {
  const t = f()
  if t is string { t.length } else { t.length + 100 }
}
function viaSize(a) { print(size(a)) }
viaSize(() => "abc")
viaSize(() => [1, 2])

function both(a) {
  print(a())
  print(count(a))
}
both(() => "abc")
