// A kept maker's call in a list handed to a generic identity, beside its own type's instance, keys
// the instance at the row the list is built at, and the call's read takes that instance's result
// (D17641).
// @run
// @log 13
// @hint Intentionally-unused variable `_own`
type Circle = { r: i32 | null }
function keep<T>(xs: T[]): T[] { return xs }
function mk() { return { r: null } }
const _own = [{ r: null }]
function radius(p: Circle) { return p.r ?? 13 }
print(radius(keep([mk()])[0]))
