// @run
// @log 5
// @log 9
// A generic-alias APPLICATION as a MAP VALUE (`{[string]: Box<i32>}`). The instance is
// INTERIOR to the map's synthetic annotation name, and `collectGenAliasShapes` peeled only a
// `| null` and trailing `[]` off each `TypeRef` before interning — so nothing ever interned
// `Box<i32>` and the map-value classifier reported "unsupported map value type (only i32 /
// boolean / string / struct values)". The named control (`type P = {v:i32}` +
// `{[string]: P}`) runs, which is what separated this from a map-of-struct limitation.
//
// Measured before it was fixed: adding an unrelated `const w: Box<i32>` to the SAME program
// made it compile — a `TypeRef` that spells the application bare interns the instance, and
// the map value then resolves by name. So the gap was the registration WALK, not the map
// machinery; the walk now descends the map-value position too.
type Box<T> = { v: T }
type Pair<A, B> = { a: A, b: B }

const m: {[string]: Box<i32>} = Map()
m["k"] = { v: 5 }
const g = m["k"]
if g != null { print(g.v) }

// A two-argument application, and the map behind a `[]`.
const n: {[string]: Pair<i32, string>} = Map()
n["k"] = { a: 9, b: "z" }
const h = n["k"]
if h != null { print(h.a) }
