// @error cannot assign i32 to 'q' of type boolean
// A generic call's result taken from a call result's un-annotated function is that function's
// result type, refused at a destination it does not fit; it printed `true` (D16142).
function inc(a) { return a + 1 }
function pick1(_c: boolean) { return inc }
function apr<R>(g: (x: i32) => R): R { return g(3) }
const q: boolean = apr(pick1(true))
print(q)
