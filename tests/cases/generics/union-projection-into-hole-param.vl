// @run
// @log 3
// @log rect
// @log 7
// CONTRACT (D1516): a value union read out of a PROJECTION — a list element, a struct field,
// a map read — and handed to an UN-ANNOTATED parameter.
//
// Every channel the monomorphizer's pin ladder had asks a BINDING: an annotation, a callee's
// return, a global's init. A projection is none of those, so `xs[0]` resolved only when the
// array's own NAME did, and a struct-field or map read reached nothing at all — the union
// floor returned "" and the instance was refused. The checker typed the read long before the
// mono pass ran, and the floor now asks it, through `monoAnnPinName` so the pin stays a
// spelling an annotated parameter already lowers.
//
// NOTHING HERE MAY ANNOTATE THE CARRIER. `const srcArr: Val[] = …` and `function take(p: Val)`
// are both rescues the row records; annotating either makes every cell pass for the wrong
// reason. The un-annotated hole is the whole point.
type Val = i32 | string
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect

function mkval(): Val { return 3 }
function mkval7(): Val { return 7 }
function mkshape(): Shape { return { kind: "rect", w: 2.0, h: 3.0 } }

const srcArr = [mkval()]
const srcBox = { it: mkshape() }
const srcMap = Map()
srcMap["k"] = mkval7()

// The hole. Its `is` narrowing is what proves the instance was pinned at the BOX and not at
// some scalar the catch-all would have picked.
function take(p) {
  if p is i32 { print(p) } else { print(0) }
}

function takeShape(p) {
  print(p.kind)
}

take(srcArr[0])
takeShape(srcBox.it)
take(srcMap["k"] ?? 0)
