// @log x
// @log x
// @log z
// @log x
// @log w
// @log 3
// @log true
// An un-annotated parameter copied into a binding annotated with a type parameter no parameter
// names is split per call type, so each copy is built at the instance its own calls take (D6760).
function same<T>(k: T): T { k }
function sx(k: string) { k }
function mid<F>(a, a2) {
  const b: F = a
  const b2: F = a2
  print(b("x"))
  print(b2("y"))
}
mid(same, same)
print(same(1))
function one<F>(a) {
  const b: F = a
  print(b("x"))
}
function closed<F>(a) {
  const b: F = a
  print(b("x"))
}
function chain<F>(a) {
  const b: F = a
  const c: F = b
  print(c("z"))
}
function ret<F>(a) {
  const b: F = a
  return b("x")
}
function both<F>(a) {
  const b: F = a
  print(b("w"))
  print(b(3))
}
function flag<F>(a) {
  const b: F = a
  print(b(true))
}
one(same)
closed(sx)
chain(same)
print(ret(same))
both(same)
flag(same)
