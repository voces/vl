// A nested generic redeclaring `T` that indexes it, called with a value of the enclosing `T`:
// the index demand reaches the enclosing pin (D3884).
function a<T>(x: T) {
  function b<T>(y: T) { print(y[0]) }
  b(x)
}
a(5)
