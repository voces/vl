// @check
// @error cannot infer type parameter `T` in this call to `first`: its argument is `string[] | i32[]`
// A union of lists binds no `T` at a list parameter: each member would bind it differently, and a
// list never widens. Left open, `T` let the result fit `boolean` and the call failed to build.
function first<T>(xs: T[]): T { return xs[0] }
const q: string[] | i32[] = [1, 2]
const a: boolean = first(q)
print(a)
