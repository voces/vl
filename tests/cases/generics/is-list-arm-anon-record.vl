// @run
// @log 10
// @log 1
// @log 0
// @log an
// @log 0
// @log an
// @log 1
// An `is { … }[]` arm testing an anonymous record over an empty list of another element reads,
// grows and iterates that empty list at the anonymous record (D4994).
type P = { x: i32 }
function a<V>(v: V[]) {
  const q: V[] = []
  if q is { y: string }[] { print(q.length + 10) }
  print(v.length)
}
function b<V>(v: V[]) {
  if v is { z: string }[] {
    for e in v { print(e.z) }
    print(v.map((e) => e.z).length)
  }
  const r: V[] = []
  if r is { y: string }[] {
    r.push({ y: "an" })
    for e in r { print(e.y) }
  }
  print(v.length)
}
const ps: P[] = [{ x: 1 }]
a(ps)
const pe: P[] = []
b(pe)
const fs = [1.5]
b(fs)
