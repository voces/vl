// @run
// @log 0
// @log 0
// @log 0
// @log -1
// @log 5
// @log 3
// @log true
// @log s
// @log 4
// @log 2.5
// @log true
// @log true
// @log Bo
// @log Ana
// @hint Intentionally-unused parameter `_seed` (leading `_` marks it unused)
// @hint redundant type annotation: `p` is inferred as `{x: i32}` — remove it to lean on inference
// @hint redundant type annotation: `people` is inferred as `{name: string, age: i32}[]` — remove it to lean on inference
// Each instance reads its body's expressions at its own pin (D2574's mechanism), which
// closes these rows too.
import { sorted } from "std:array"

// D1472: `__array_new_default__` builds the instance's backing, not the i32 default.
function mk<T>(n: i32, _seed: T): T[] {
  const xs: T[] = __array_new_default__(n)
  return xs
}
print(mk(3, 1)[0])
print(mk(3, 1.5)[0])
const big: i64 = 5
print(mk(2, big)[1])

// D2187: a tail `if` joining two locals of `T`, at a nullable record.
type P = { x: i32 }
function id<T>(c: boolean, x: T, y: T) {
  const a = x
  const b = y
  if c { a } else { b }
}
const n: P | null = null
const p: P = { x: 5 }
print(id(true, n, p)?.x ?? -1)
print(id(false, n, p)?.x ?? -1)

// D2224: a rebound `T[]` at a nullable-string list.
function g<T>(xs: T[]) {
  const r = xs
  r
}
const src = ["a", null]
const out = g(src)
out.push("b")
print(out.length)
print(out[1] == null)

// D2432: an un-annotated `Map()` whose value is `T`.
function tally<T>(x: T): {[string]: T} {
  const t = Map()
  t["x"] = x
  t
}
print(tally("s")["x"] ?? "none")
print(tally(4)["x"] ?? 0)
function box<T>(x: T): {[string]: T[]} {
  const t = Map()
  t["x"] = [x]
  t
}
const bl = box(2.5)["x"]
if bl != null { print(bl[0]) }

// D2569: `[x, null][i]` at an `i32` and a `string` pin.
function nth<T>(x: T) { return [x, null][1] == null }
print(nth(5))
print(nth("s"))

// D1481: a `.filter` result of records handed to a `std:array` generic.
type Person = { name: string, age: i32 }
const people: Person[] = [{ name: "Ana", age: 31 }, { name: "Bo", age: 40 }]
const adults = people.filter((q: Person) => q.age >= 30)
print(adults.sorted((l: Person, r: Person) => l.age > r.age)[0].name)
print(adults.sorted((l: Person, r: Person) => l.age < r.age)[0].name)
