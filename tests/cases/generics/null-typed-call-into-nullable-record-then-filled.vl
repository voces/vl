// @run
// @log none
// @log 4
// @log nil
// @log 5
// A `null`-typed call's result stored into a nullable record global and passed to a nullable
// record parameter is the bottom ref, which the cell or parameter already holds. The global is
// filled later, read past a non-null check, and its field read.
type C = { a: i32, b: i32 }
function np() { return null }
let g: C | null = np()
function fill() { g = { a: 4, b: 5 } }
function take(c: C | null) { if c != null { print(c.b) } else { print("nil") } }
if g == null { print("none") }
fill()
if g != null { print(g.a) }
take(np())
take(g)
