// @run
// @warning Unused parameter `v`
// @hint redundant type annotation: `one` is inferred as `i32`
// @log 1
// @log 1
// @log 5
// @log 4
// D8340's annotated twin: the literal and the binding declared at their own record type.
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
function one<T>(v: T): i32 { 1 }
const u: J | string = idn({ r: 4 })
const k0: { r: i32 } = { r: 5 }
print(one(k0))
const k: { r: i32 } = { r: 5 }
print(one(k))
print(k.r)
if u is J { print(u.r ?? 0) }
