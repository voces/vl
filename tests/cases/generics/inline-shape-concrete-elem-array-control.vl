// @run
// @log 3
// @log 3
// @log 3
// The CONTROL for `error-inline-shape-tyaram-elem-array.vl`. The generic-original skip is
// keyed on a FuncDecl type parameter, so all three neighbours must keep compiling: a
// CONCRETE inline shape with an array field, a generic alias APPLIED at a concrete type
// (whose substituted shape `collectGenAliasShapes` interns), and a bare `T[]` parameter —
// the form the array classifier has always skipped.
type Box<T> = { v: T[] }

function conc(v: { g: i32[] }) {
  v.g.length
}

function applied(b: Box<i32>) {
  b.v.length
}

function bare<T>(v: T[]) {
  v.length
}

print(conc({ g: [1, 2, 3] }))
print(applied({ v: [1, 2, 3] }))
print(bare([1, 2, 3]))
