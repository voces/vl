// @hint redundant type annotation: `o` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `l` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `n` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `d` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `rd` is inferred as `{a: i32}` — remove it to lean on inference
// A record field's union matches the pattern's in any member order, so an exact instance does
// not mistake the reordered spelling for a twin (D2753).
function o<O>(u: O | null): boolean { u is {a: i32 | string} }
const ro: {a: string | i32} = { a: 1 }
print(o(ro))
function l<L>(u: L | null): boolean { u is {a: 1 | 2} }
const rl: {a: 2 | 1} = { a: 1 }
print(l(rl))
function n<M>(u: M | null): boolean { u is {a: {b: i32 | string}} }
const rn: {a: {b: string | i32}} = { a: { b: 1 } }
print(n(rn))
function d<D>(u: D | null): boolean { u is {a: string} }
const rd: {a: i32} = { a: 1 }
print(d(rd))
