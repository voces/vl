// @emit-error a test cannot tell {[i32]:i32} from the map its numeric literal union reads as yet — wrap each map in a record with a discriminant field
// One instance of `k` serves a literal-union map and its plain twin: the parameter's type at the
// instance holds both, and nothing in the box tells them apart, so the test is refused.
type LM = {[i32]: 1 | 2}
type IM = {[i32]: i32}
function k<T>(u: T | IM) {
  if u is IM { return 3 }
  0
}
const ml: LM = Map()
const mi: IM = Map()
print(k<LM>(ml))
print(k<LM>(mi))
