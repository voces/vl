// @error at the call's argument types, the branches of an `if` or `match` in the body of `f` join f64[] and string[]: field 'length' is not on every member of f64[] | string[]
// A generic if-join whose arms are two different list types at the pin (`f64[]` and
// `string[]`) is their union there, so a read that needs one list is refused at the call, in
// the words its concrete spelling earns (D2832).
function no(): boolean { false }
function f<T>(xs: T[], ys: string[]) {
  const r = if no() { xs } else { ys }
  print(r.length)
}
f([1.5], ["a", "b"])
