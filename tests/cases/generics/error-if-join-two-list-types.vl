// @emit-error '.length' on a receiver the emitter cannot classify as a list, string, map or set
// A generic if-join whose arms are two different list types at the pin (`f64[]` and
// `string[]`) has no one list rep. The binding refuses rather than taking the first arm's rep
// and delivering the other arm into it (D2832, open).
function no(): boolean { false }
function f<T>(xs: T[], ys: string[]) {
  const r = if no() { xs } else { ys }
  print(r.length)
}
f([1.5], ["a", "b"])
