// @run
// @log a
// @log null
// @log 7
// @log b
// A two-way join of type parameters pinned at `K` and `i32 | null` is the box
// `i32 | "a" | "b" | null`, built and bound at the pin, not the literal union's atom (D3284).
type K = "a" | "b"
function g<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  return r
}
const x0: K = "a"
const x1: i32 | null = null
function use(k: i32) { print(g(x0, x1, k)) }
use(0)
use(1)
function b<T, U>(a: T, u: U, k: i32) {
  const r = if k == 0 { a } else { u }
  print(r)
}
const n7: i32 | null = 7
const kb: K = "b"
b(n7, kb, 0)
b(n7, kb, 1)
