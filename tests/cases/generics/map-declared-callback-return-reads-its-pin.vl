// @run
// @log 1
// @log 1
// @log 2.5
// @log false
// @log true
// @log 1
// @log n
// A `.map` callback whose declared return is wider than its argument makes the result element
// that declared type at the instance's pin, not the argument's (D3092).
function g<T>(x: T) {
  const m = [x].map((e): T | null => e)
  print(m[0])
}
g(1)
function k<T>(x: T) { print([x].map((e): T | null => e).length) }
k(1)
function w<T>(x: T) {
  const m = [x].map((e): T | i32 => e)
  print(m[0])
}
w(2.5)
w(false)
function v<T>(x: T) {
  for y in [x].map((e): T | null => e) { print(y) }
}
v(true)
v(1)
function h(x) { print([x].map((e): string | i32 => e ?? "n")[0]) }
const a: i32 | null = null
h(a)
