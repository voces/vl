// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// @log e=true
// @log true
// @log 2.5
// @log s
// @log false
// @log b
// @log true
// @log true
// @log true
// A for-in over the list a generic call returns, inside an enclosing `<T>`: the loop variable
// takes the element the instance binds, so a `boolean` prints `true` and a literal union its
// member, not their `i32` rep (D3841). The value reaches `print`, a third generic and an
// interpolation.
function wrap<U>(u: U): U[] { [u] }
function show<V>(v: V) { print(v) }

// The reviewed witness: the result bound, indexed and iterated directly.
function outer<T>(x: T) {
  const ws = wrap(x)
  for e in ws { print(e) }
  print(ws[0])
  for e in wrap(x) { print(e) }
}
outer(true)

// An un-annotated enclosing function, and the value passed on and interpolated.
function hole(x) {
  for e in wrap(x) { print(e) }
}
hole(true)
function onward<T>(x: T) {
  for e in wrap(x) {
    show(e)
    print("e=\{e}")
  }
}
onward(true)

// Several instances, a nullable boolean and a literal union.
function many<T>(x: T) {
  for e in wrap(x) { print(e) }
}
many(true)
many(2.5)
many("s")
const nb: boolean | null = false
many(nb)
const lb: "a" | "b" = "b"
many(lb)

// A hole callee, and a `.filter` over the result.
function hwrap(u) { [u, u] }
function viaHole<T>(x: T) {
  for e in hwrap(x) { print(e) }
}
viaHole(true)
function filtered<T>(x: T) {
  for e in wrap(x).filter((y) => y == x) { print(e) }
}
filtered(true)
