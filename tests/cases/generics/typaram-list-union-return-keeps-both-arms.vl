// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log s
// @log 1.5
// @log 4
// @log 4
// @log q
// @log B
// @log s
// @log not f64[][]
// @log 2.5
// @log true
// @log i
// @log 4
// @log 2
// @log mP
// @log 1
// @log 1
// @log 2
// @log -1
// A return `T[] | i32[]` keeps both arms at every `T`: the value is the arm `T` names, tested,
// iterated, held in a record field, read back out of one, nested a level down, and passed into
// a parameter of that type.
type P = { x: i32 }
function wrap<T>(t: T): T[] | i32[] { [t] }
print(wrap("ada").length)
print(wrap(2.5).length)
print(wrap(true).length)
print(wrap(7).length)
const a = wrap("s")
if a is string[] { print(a[0]) } else { print("N") }
for e in wrap(1.5) { print(e) }
const p = wrap({ x: 4 })
if p is P[] { print(p[0].x) } else { print("N") }
const o = { f: wrap({ x: 4 }) }
if o.f is P[] { print(o.f[0].x) } else { print("N") }
const o2 = { f: wrap("q") }
if o2.f is string[] { print(o2.f[0]) } else { print("N") }
const b = wrap(true)
if b is boolean[] { print("B") } else { print("N") }

function k<T>(c: boolean, t: T): T[][] | i32[][] {
  if c { return [[t]] }
  [[1]]
}
const z = k(true, "s")
if z is string[][] { print(z[0][0]) } else { print("no") }
const z2 = k(false, 2.5)
if z2 is f64[][] { print("bad") } else { print("not f64[][]") }
const z3 = k(true, 2.5)
if z3 is f64[][] { print(z3[0][0]) } else { print("no") }

function g<U>(a: U[] | i32[]) {
  if a is i32[] { print("i") } else { print(a[0]) }
}
g(wrap(true))
g(wrap(3))

function pick<T>(t: T, c: boolean): T[] | i32[] {
  if c { return [t] }
  [7, 8]
}
const pv: P = { x: 4 }
const r = { f: pick(pv, true), h: pick(pv, false) }
const rf = r.f
if rf is P[] {
  for e in rf { print(e.x) }
} else {
  print("N")
}
const rh = r.h
if rh is P[] { print("bad") } else { print(rh.length) }
match rf {
  P[] => print("mP")
  i32[] => print("mI")
}
print(wrap({ x: 5 }).length)
const o3 = { f: wrap({ x: 6 }) }
print(o3.f.length)

// An annotation `T[] | string[]` in the body keeps the concrete arm too (D2835).
function ann<T>(xs: T[], ys: string[], c: boolean) {
  let r: T[] | string[] = ys
  if !c { r = xs }
  if r is string[] { print(r.length) } else { print(0 - r.length) }
}
ann([2.5], ["a", "b"], true)
ann([2.5], ["a", "b"], false)
