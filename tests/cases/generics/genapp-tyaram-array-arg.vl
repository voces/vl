// @run
// @log 3
// @log x
// @log 8
// `Box<T[]>` over `{ v: X }` gives the field `v: T[]`, the text `genapp-tyaram-arg-elem-array.vl`
// reaches through `{ v: X[] }` at `Box<T>`, and binds `T` the same way.
type Box<X> = { v: X }

function len<T>(b: Box<T[]>) { b.v.length }
function first<T>(b: Box<T[]>): T { b.v[0] }

print(len({ v: [1, 2, 3] }))
print(first({ v: ["x"] }))
print(first({ v: [7] }) + 1)
