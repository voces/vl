// @log 2
// A lambda whose result is a list literal, handed to a generic whose function parameter's result
// is a list of a union holding `T`, builds its list at the bound union (D16918).
function gen<T>(f: () => (T | boolean)[]) { return f().length }
print(gen(() => [1]))
function first<T>(f: () => (T | boolean)[]): T | boolean { return f()[0] }
const r = first(() => [4])
if r is boolean { print(0) } else { print(r + 1) }
print(gen(() => [1, true]))
function str<T>(f: () => (T | string)[]): T | string { return f()[0] }
const s = str(() => [7])
if s is string { print(s) } else { print(s) }
function arg<T>(f: (x: i32) => (T | boolean)[]) { return f(2).length }
print(arg((x) => [x, x]))
print(
  gen(() => {
    return [1, 2, 3]
  }),
)
function bound<T>(f: () => (T | boolean)[], t: T) {
  return f().length + [t].length - 1
}
print(bound(() => [1], 5))
function nested<T>(f: () => (T | boolean)[][]) { return f()[0].length }
print(nested(() => [[1, 2]]))
print(gen(() => ["a"]))
print(gen(() => [2.5]))
function last<T>(f: () => (T | boolean)[]): T | boolean {
  const xs = f()
  return xs[xs.length - 1]
}
const l = last(() => [1, 9])
if l is boolean { print(0) } else { print(l) }
function outer() {
  function inner<T>(f: () => (T | boolean)[]) { return f().length }
  return inner(() => [1, 2])
}
print(outer())
