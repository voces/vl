// @run
// @log false
// @log true
// @log 7
// `A | B | null` pinned at two lists of same-shape records is one nullable list type, so the
// instance's `return null` types against that list's row (D3508).
type Rec = { x: i32 }
type Rec2 = { x: i32 }
const rl: Rec[] = [{ x: 7 }]
const r2: Rec2[] = [{ x: 8 }]
function F<A, B>(k: i32, a: A, b: B): A | B | null {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
const u = F(0, r2, rl)
print(u == null)
const n = F(2, r2, rl)
print(n == null)
const w = F(1, r2, rl)
if w != null { print(w[0].x) }
