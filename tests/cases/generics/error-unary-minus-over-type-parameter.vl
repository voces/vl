// @error unary '-' expects a numeric type, got string
// @error unary '-' expects a numeric type, got boolean | i32
// A unary `-` over a type parameter, bare or inside a gradual union, is re-asked at the pin as
// the binary operators are: a pin with no numeric rep is refused at the call (D3210).
function f<T>(x: T) { print(-x) }
f(2)
f("s")
function g<T>(a: T, c: boolean) {
  const r = if c { a } else { 5 }
  print(-r)
}
g(2.5, true)
g(true, false)
