// @run
// @log 7
// @log 3
// @log v
// @log 4
// @log true
// @log s
// @log 2.5
// A hole instance's binding reaches what its body builds from the parameter: an element read of
// a record list, a lambda handed to a hole or `<T>` callee, a local bound to an element read, and
// a call of a called lambda (D2237, D2927, D2928, D2929, D2931).
function take(a) {
  if a != null { print(a[0].x) }
}
take(if 1 == 1 { [{ x: 7 }] } else { null })
function appH(g) { return g() }
function viaH(x) { print(appH(() => x)) }
viaH(3)
function isNull(x) {
  const xs = [x]
  if xs[0] == null { print("null") } else { print("v") }
}
isNull(3)
function capRead(x) {
  const l0 = [x]
  const y = l0[0]
  const k = () => y
  print(k())
}
const v: i32 | string = 4
capRead(v)
function appG<T>(g: () => T): T { return g() }
function viaG(x) { print(appG(() => x)) }
viaG(true)
function lamLam(x) {
  const k = () => () => x
  print(k()())
}
lamLam("s")
lamLam(2.5)
