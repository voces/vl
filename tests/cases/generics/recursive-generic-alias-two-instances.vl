// @run
// @log 3
// @log xy
// Two instances of one recursive generic alias: each is its own struct, keyed by its type.
type L<T> = { v: T, next: L<T> | null }

const a: L<i32> = { v: 1, next: { v: 2, next: null } }
const b: L<string> = { v: "x", next: { v: "y", next: null } }
const an = a.next
if an != null { print(a.v + an.v) }
const bn = b.next
if bn != null { print(b.v + bn.v) }
