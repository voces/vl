// @run
// A number literal argument binds its type variable after the arguments beside it, so it adapts
// to their type whatever the order: `mix(0.1, x)` with `x: f32` is an `f32[]` as `mix(x, 0.1)`
// is (D3541). A literal an `i32` cannot hold widens the `i32` in either order (D16205).
function mix<T>(a: T, b: T): T[] { return [a, b] }
function pick<T>(k: i32, a: T, b: T): T { return if k == 0 { a } else { b } }
const x: f32 = 0.5
const n: i64 = 9
print(mix(0.1, x)[1] + 0.1)
print(mix(0.1, x)[0])
print(mix(5, x)[0] + 0.1)
print(pick(0, 5, n) is i64)
const i = 7
print(mix(0.1, i)[1])
print(mix(i, 0.5)[1])
print(mix(i, 5000000000)[1])
// @log 0.6000000238418579
// @log 0.10000000149011612
// @log 5.099999904632568
// @log true
// @log 7
// @log 0.5
// @log 5000000000
