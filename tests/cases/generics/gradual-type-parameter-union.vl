// @run
// @hint redundant type annotation: `r` is inferred as `T | i32`
// @log 5
// @log 4
// @log 6
// @log 2
// @log 4
// @log a
// @log 5
// @log x
// @log 5
// @log false
// @log true
// @log 7
// @log 7
// @log 5
// @log n
// @log s
// @log true
// @log false
// @log 4
// @log 6
// @log 5
// @log 3
// @log 4
// @log null
// @log 3
// @log null
// @log false
// @log false
// @log false
// @log false
// @log true
// @log true
// A type parameter inside a union is gradual as a bare one is (owner ruling 2026-09-29): a join
// of `T` with a literal is `T | i32`, an operation on it is checked against its concrete members
// in the body and against the whole union at each pin (D2906, D2949, D3079, D3211, D3212, D3213).
// A record literal, an `as?` and a join of two parameters with a literal hold the join too.
type K = "a" | "b"
type R = { f: i32 }
function g0<T>(a: T, c: boolean) {
  const r = [if c { a } else { 5 }]
  print(r[0])
}
g0(true, false)
function ga<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  print(r + 1)
}
ga(3, true)
ga(3, false)
function gl<T>(x: T) {
  const l = [x, 7]
  print(l.length)
  return l
}
const ls = gl("s")
const l1 = ls[1]
if l1 is i32 { print(l1 - 3) }
function gk<T>(a: T, c: boolean) { print(if c { a } else { 5 }) }
const k: K = "a"
gk(k, true)
gk(k, false)
function gs<T>(a: T, c: boolean) {
  const r = if c { a } else { 5 }
  return r
}
const s0 = gs("x", true)
if s0 is string { print(s0) }
const s1 = gs("x", false)
if s1 is i32 { print(s1) }
function geq<T>(a: T, c: boolean) {
  const r = if c { 5 } else { a }
  print(r == a)
}
const rec = { f: 1 }
geq(rec, true)
geq(rec, false)
function gsh<T>(a: T, c: boolean) {
  if c {
    const r = if c { a } else { "s" }
    print(r)
  }
  const r = if c { a } else { 5 }
  print(r)
}
const n7: i32 | null = 7
gsh(n7, true)
gsh(n7, false)
function gtwo<T>(a: T, c: boolean) {
  const z = if c { a } else { "s" }
  if !c { return z }
  const y = if c { a } else { 5 }
  return y
}
const sn: string | null = "n"
print(gtwo(sn, true))
print(gtwo(sn, false))
function gke<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  print(r == a)
}
gke(k, true)
gke(k, false)
function gob<T>(a: T, c: boolean) {
  const r = if c { a } else { 5 }
  const b = { w: 1, v: r }
  if b.v is i32 { print(b.v + 1) }
}
gob(3, true)
gob(3, false)
function gor<T>(a: T, c: boolean) {
  const r = if c { 5 } else { a }
  return { v: r }
}
print(gor(3, true).v)
print(gor(3, false).v)
function gas<T>(a: T, c: boolean) {
  const r = if c { a } else { "s" }
  print(r as? i32)
}
const ius: i32 | string = 4
gas(ius, true)
gas(ius, false)
function gaf<T>(a: T, c: boolean) {
  const r = if c { a } else { 2.5 }
  print(r as? i32)
}
gaf(3, true)
gaf(3, false)
function g2<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else if k == 1 { b } else { 5 }
  print(r is i32)
  print(r == 5)
}
const xn: i32 | null = null
g2(xn, "y", 0)
g2(xn, "y", 1)
g2(xn, "y", 2)
