// @run
// @log 2
// @log 7
// @log 7
// @log 6
// @log true
// @log true
// @log true
// @log 3
// `{ v: { x: i32 } }` is `{ v: A }`'s row, not a union-box row with field `v` declared before it,
// whose box takes a record arm only on the lenient pass: one field, an arm that is itself a
// record, two fields, and a mutate-then-read (D3920).
type A = { x: i32 }
function ap<T, U>(xs: T[], f: (t: T) => U): U[] {
  const r: U[] = []
  for x in xs { r.push(f(x)) }
  r
}
const q: { v: i32 | string } = { v: 1 }
const q2: { v: { x: string } | i32 } = { v: 1 }
const q3: { v: A | string } = { v: "z" }
const q4: { v: i32 | string, n: i32 } = { v: 1, n: 3 }
const o: { v: A } = { v: { x: 2 } }
print(ap([o], (e) => e.v.x)[0])
print(
  ap([o], (e) => {
    e.v.x = e.v.x + 5
    e.v.x
  })[0],
)
print(o.v.x)
const o4: { v: A, n: i32 } = { v: { x: 2 }, n: 4 }
print(ap([o4], (e) => e.v.x + e.n)[0])
print(q.v is i32)
print(q2.v is i32)
print(q3.v is string)
print(q4.n)
