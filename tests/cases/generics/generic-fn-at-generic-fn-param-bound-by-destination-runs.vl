// @run
// @log 1.5
// @log 9000000000
// @log s
// @log 2.5
// @log 1.5
// @log 2.5
// @log 4
// @log 1
// A generic function, or an un-annotated one, handed to a generic's function-typed parameter that
// no other argument binds takes the destination's type: an annotated `const` at each width, a
// parameter, and a re-pointed `let` (D16410); the `i32` faces keep running.
function gid<A>(x: A): A { x }
function sel<A>(f: (x: A) => A): (x: A) => A { f }
function hinc(x) { x + 1 }
const k: (x: f64) => f64 = sel(gid)
print(k(1.5))
const ki: (x: i64) => i64 = sel(gid)
print(ki(9000000000))
const ks: (x: string) => string = sel(gid)
print(ks("s"))
function use(g: (x: f64) => f64) { print(g(2.5)) }
use(sel(gid))
let r = (x: f64) => x * 2.0
r = sel(gid)
print(r(1.5))
const kh: (x: f64) => f64 = sel(hinc)
print(kh(1.5))
const k32: (x: i32) => i32 = sel(gid)
print(k32(4))
print(sel(gid)(1))
