// @run
// @log 2
// @log 4
// @log 2
// A returned `if` join of a type parameter's list and a concrete list, at a record pin, places
// the record list in its arm of the union beside a string or a record list (D2834).
type P = { a: i32 }
type Q = { b: i32 }
function no() { false }
function yes() { true }
function f<T>(xs: T[], ys: string[]) { return if no() { xs } else { ys } }
const r = f([{ a: 4 }], ["a", "b"])
if r is string[] { print(r.length) } else { print(0 - r.length) }
function g<T>(xs: T[], ys: string[]) { return if yes() { xs } else { ys } }
const s = g([{ a: 4 }], ["a"])
if s is P[] { print(s[0].a) } else { print(s.length) }
function h<T>(xs: T[], ys: Q[]) { return if no() { xs } else { ys } }
const t = h([{ a: 4 }], [{ b: 1 }, { b: 2 }])
if t is Q[] { print(t.length) } else { print(0 - t.length) }
