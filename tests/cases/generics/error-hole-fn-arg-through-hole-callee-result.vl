// @error cannot assign i32 to 's' of type boolean
// The result of a hole call whose hole is handed an open function value is that instance's, so a
// wrong annotation on it is refused rather than built (D6532).
function id(a) { return a }
function lap(g) { return g(1) + 1 }
function use(k) { return k(id) }
const s: boolean = use(lap)
print(s)
