// @check
// @error cannot assign i32 to 'r' of type string (the body of `decl` at the call's argument types)
// @error cannot assign i32 to 'r' of type string (the body of `viaUfcs` at the call's argument types)
// @error cannot assign i32 to string (the body of `asg` at the call's argument types)
// @error cannot assign i32 to string (the body of `field` at the call's argument types)
// @error cannot assign i32 to string (the body of `elem` at the call's argument types)
// @hint redundant type annotation: `p` is inferred as `string`
// @hint redundant type annotation: `bx` is inferred as `{v: string}`
// @hint redundant type annotation: `xs` is inferred as `string[]`
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z1` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z2` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z3` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z4` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z5` (prefix with `_` to suppress, or remove it)
// The three `@hint`s are DECLARED rather than silenced: `p`, `bx` and `xs` carry the
// argument types the pin binds each hole to, which is the file's only axis. Deleting an
// annotation to quiet a hint would delete what the case tests.
// WHERE A VALUE LANDS INSIDE A GENERIC BODY, re-asked at the pin (silent-class-inventory
// D572). D551 and D561 are the RETURN seam; every program below was `vl check` rc 0 over a
// module the engine refuses, and the return is clean BY CONSTRUCTION in the first two —
// `r`'s declared type is the hole `T`, which substitutes to `string` and matches the
// declared return exactly, so `validateRetCstrs` has nothing to say. The i32 entered at the
// DESTINATION, where `assignable(i32, T)` is vacuous and nothing recorded the pair.
//
// EVERY ONE OF THESE HAS A ONE-TOKEN-DIFFERENT DIRECT SPELLING THAT IS ALREADY LOUD, and
// the message here is that spelling's own sentence plus an attribution — `letAssignMsg` is
// the single home both sites call, so the pin cannot drift from the body the way
// `checkBinary` and `binOpDefinedFor` did (D492 / D493).
//
//   · `decl`     the filed witness. A local DECLARATION whose annotation is the hole.
//   · `viaUfcs`  the SAME question through the method spelling. Two different pins in
//                `typecheck.vl`; wiring only the first would leave `p.g()` silent beside a
//                loud `g(p)`, which is the asymmetry D401 and D551 each had to fix late.
//   · `asg`      a write to an already-declared local. A different sentence — the write
//                seam names no binding — and that difference is why the pin carries the
//                name rather than re-deriving it.
//   · `field`    a struct field write, and
//   · `elem`     an array element write. Both ride `asg`'s one gate in
//                `checkBinExprNodeReal`; they are spelled out because a reader given only
//                `asg` would not know that.
function decl<T>(self: T, n: i32): T {
  const r: T = n + 1
  return r
}
const p: string = "s"
const z1 = decl(p, 2)

function viaUfcs<T>(self: T, n: i32): T {
  const r: T = n + 1
  return r
}
const z2 = p.viaUfcs(2)

function asg<T>(self: T, n: i32): T {
  let r: T = self
  r = n + 1
  return r
}
const z3 = asg(p, 2)

type Bx<T> = { v: T }
function field<T>(self: T, b: Bx<T>, n: i32): T {
  b.v = n + 1
  return b.v
}
const bx: Bx<string> = { v: "s" }
const z4 = field(p, bx, 2)

function elem<T>(self: T[], n: i32): T {
  self[0] = n + 1
  return self[0]
}
const xs: string[] = ["s"]
const z5 = elem(xs, 2)
