// @log 0
// A union parameter whose type parameter is inferred from a nested-list argument registers its
// union at the instance, as written type arguments do, so the argument boxes into it (D15762).
function probe<V>(v: V[][] | string) {
  if v is string { return 2 }
  0
}
function fits<V>(v: V[][] | string) {
  if v is f64[][] { return 1 }
  0
}
const e: i32[][] = [[1]]
const z: i32[][] = []
print(probe(e))
print(fits(z))
print(fits(e))
