// @run
// @log 3.5
// @log 5.5
// @log 3.5
// @log 5000000002
// @log 3
// @log 5
// @log 5000000000
// @log 2.5
// @log b
// @log 5000000000
// @log true
// @log true
// @log 3.5
// @log 3
// @log true
// @log 2.75
// A list literal of un-annotated parameters, or of a parameter beside arithmetic of it with a
// wider literal, holds each element at its own width at the pin, as `x: i32` does (D9631,
// D9632), and a float literal beside an `f32` pin stays `f32`. `f(4.0)`, `p(2, 5)`, `p("a", "b")`
// and `lit(2)` are the controls.
function f(x) {
  const xs = [x, x + 1.5]
  print(xs[1])
}
f(2)
f(4.0)
function two(x) {
  const xs = [x + 1, x + 1.5]
  print(xs[1])
}
two(2)
function r(x) { [x, x + 5000000000] }
print(r(2)[1])
print(r(3)[0])
function p(x, y) {
  const xs = [x, y]
  print(xs[1])
}
p(2, 5)
p(2, 5000000000)
p(2, 2.5)
p("a", "b")
function s(x, y) {
  const xs = [x, y]
  for e in xs {
    if e is i64 { print(e) }
  }
  print(xs[0] is i32)
  print(xs.length == 2)
}
s(1, 5000000000)
function d(x: i32) {
  const xs = [x, x + 1.5]
  print(xs[1])
}
d(2)
function lit(x) {
  const xs = [x, x + 1]
  print(xs[1])
}
lit(2)
function a32(x) {
  const xs = [x, x + 1.5]
  print(xs[1] is f32)
  print(xs[1])
}
a32(1.25 as f32)
