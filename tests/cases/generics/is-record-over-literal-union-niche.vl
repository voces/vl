// @run
// @log true
// @log false
// @log false
// @log true
// @log false
// @log false
// A `K | null` niche holds no record, so an `is` of one over a join that pins at the niche is
// false, after the receiver is read, at a declared parameter and a hole alike.
type K = "a" | "b"
type P = {x: i32}
function g<T0, T1>(a0: T0, a1: T1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  print(r is K)
  print(r is null)
  print(r is P)
}
const x0: K | null = "b"
const x1: K = "a"
g(x0, x1, 0)
function h(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  print(r is K)
  print(r is null)
  print(r is P)
}
h(x0, x1, 1)
