// @run
// @log false
// @log 2.5
// @log false
// @log 2
// @log b
// @log 9000000000
// @log true
// @log 2.5
// D2574: `x.pop()` over a generic `T[]`, returned with no annotation, yields `T | null` at the
// instance — the value box at a number, a nullable reference at a string. Each instance builds
// the checked read and declares that result, in both the `return` and expression-body spellings.
function f<T>(x: T[]) { return x.pop() }
function h<T>(x: T[]) { x.pop() }
function bound<T>(x: T[]) {
  const y = x.pop()
  return y
}

const r = f([1.5, 2.5])
print(r == null)
print(r ?? 0.0)
const n = h([1, 2])
print(n == null)
print(n ?? 0)
print(f(["a", "b"]) ?? "-")
const big: i64[] = [1, 9000000000]
print(f(big) ?? 0)
const none: f64[] = []
print(f(none) == null)
print(bound([1.5, 2.5]) ?? 0.0)
