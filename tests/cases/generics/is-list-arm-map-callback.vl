// @run
// @log 10
// @log 10
// @log 20
// @log 101
// @log 10
// @log 100
// An instance's `is K[]` over an empty list of another element reads that empty `K[]`, so a
// `.map`/`.filter` callback over it is typed at `K` whether `K` is a primitive and the receiver
// a record, the reverse, or both records (D4993).
type P = { x: i32 }
type Q = { y: i32 }
function h<V>(a: V[]) {
  if a is f64[] {
    const ys = a.map((e) => e + 1.5)
    print(ys.length + 10)
  }
}
function k<V>(a: V[]) {
  if a is Q[] {
    const ys = a.map((e) => e.y)
    const zs = a.filter((e) => e.y > 0)
    print(ys.length + zs.length + 10)
  }
  if a is f64[] { print(a.filter((e) => e > 1.5).length + 20) }
}
function g<V>(a: V[]) {
  if a is P[] { print(a.map((e) => e.x).length + 10) }
  if a is f64[] { print(a.length + 100) }
}
const pe: P[] = []
h(pe)
k(pe)
const fs = [2.5]
g(fs)
const fe: f64[] = []
g(fe)
