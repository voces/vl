// @run
// @log 3
// The accept twin of `error-lambda-param-unbound-typaram.vl`: explicit type arguments bind
// the `U` no parameter of `opT` names, so the body's `(x: U[]) => …` has a concrete type.

function opT<T, U>(a: T[]) {
  const g = (x: U[]) => x.length
  const q = [1, 2]
  return g(q) + a.length
}

const a = [1]
print(opT<i32, i32>(a))
