// @run
// @log 3
// @log 10
// D14300, the local spelling, in both member orders: `Tag | Box<i32>` is the order D14301's
// span test read as one generic application.
type Box<T> = { v: T }
type Tag = { t: i32 }

function main() {
  let w: Box<i32> | Tag = { v: 2 }
  w = { t: 3 }
  if w is Tag { print(w.t) } else { print(w.v) }
  let x: Tag | Box<i32> = { v: 1 }
  x = { t: 10 }
  if x is Tag { print(x.t) } else { print(x.v) }
}
main()
