// @run
// @log 3
// @log 3
// @log 3
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// A generic body's un-annotated list a generic function is pushed onto, returned, is built at the
// list its binding holds at the instance (D16699); the push of a spread literal and of a spread
// binding with it.
function id<T>(x: T): T { return x }

function run<T>(_x: T) {
  const rs = []
  rs.push(id)
  return rs
}
print(run(3)[0](3))

function runS<T>(_x: T) {
  const rs = []
  rs.push(...[id])
  return rs
}
print(runS(3)[0](3))

function runB<T>(_x: T) {
  const rs = []
  const src = [id]
  rs.push(...src)
  return rs
}
print(runB(3)[0](3))
