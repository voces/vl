// @run
// @log n=1 of 1
// A pushing arm's grown length read outside the arm inside an interpolation hole, the Q58 position the
// ir-shadow-rows sweep (is-empty-fit-shadow-grow-positions) cannot hold, since its rows build without std.
function pInterp<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  print("n=\{q.length} of \{a.length}")
}
pInterp([1])
