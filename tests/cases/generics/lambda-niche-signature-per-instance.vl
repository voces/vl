// @run
// @log z
// @log z
// @log none
// @log a
// @log a
// @log 4
// @log 3
// @log none
// @log 3
// D2552: a closure over a niche (`string | null`, a literal union, a nullable record) called
// other than through a binding keyed no `$fnsig` from its type, and the arity fallback picked
// an unrelated functype, silent wherever another module supplied one. It is now keyed by its
// own lambda, a `null` argument into a nullable parameter is not recovered, and D2554's list
// literal of `T` is typed at the pin as a `.map`/`.filter` receiver.
import { toString } from "std:fmt"

type LI = "a" | "b"
type Tex = { w: i32 }
function inPlace<T>(r: T): T { return ((x: T) => x)(r) }
function inList<T>(r: T): T {
  const fs = [(x: T) => x, (y: T) => y]
  return fs[1](r)
}
function holds<T>(r: T) { return ((x: T) => x == x)(r) }
function mapped<T>(r: T): T {
  const xs = [r].map((x: T) => x)
  return xs[0]
}
function filtered<T>(r: T): T { return [r, r].filter((x) => x == x)[0] }
function pickS(): string | null { return "z" }
function none(): string | null { return null }
function pickL(): LI { return "a" }
function pickN(): i32 | null { return 4 }
function pickR(): Tex | null { return { w: 3 } }
print(inPlace(pickS()) ?? "none")
print(inList(pickS()) ?? "none")
if holds(none()) { print(inPlace(none()) ?? "none") }
print(inPlace(pickL()))
print(inList(pickL()))
print(toString(mapped(pickN()) ?? 0))
print(toString((mapped(pickR()) ?? { w: 0 }).w))
print(filtered(none()) ?? "none")
print(filtered((n: i32) => n + 1)(2))
