// @run
// @log 1
// @log 2
// @log 2
// @log 3
// @log 1
// D2789, D3557's annotated face: the list names its record type, so the pin is the annotation;
// it must keep agreeing with the inferred spelling.
import { reverse } from "std:array"
type R = { v: i32 }
type P = { x: i32 }
function run<T>(xs: T[]) {
  for x in xs {
    const f = () => x
    return f()
  }
  xs[0]
}
const rs: R[] = [{ v: 1 }, { v: 2 }]
print(run(rs).v)
function len<T>(xs: T[]): i32 { xs.length }
const xs: P[] = [{ x: 1 }, { x: 2 }]
print(len(xs))
print(reverse(xs)[0].x)
function mapB<T, U>(xs: T[], f: (T) => U): U[] {
  const out: U[] = []
  for x in xs { out.push(f(x)) }
  out
}
print(mapB(xs, (p) => p.x + 1)[1])
function first<T>(xs: T[]): T { xs[0] }
print(first(xs).x)
