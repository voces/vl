// @run
// @log 1
// D14783: a list of anonymous records read out of a hole's field and handed to a second hole
// callee, with no declared record of the element's shape, has the element row's list slot.
function popf(a) { a.pop() }
function t4(z) {
  popf(z.xs)
  print(z.xs.length)
}
t4({ xs: [{ n: 1 }, { n: 2 }] })
