// @run
// @log z
// @log 4
// An inline-object annotation whose field type is a generic application (`{ v: Box<i32> }`),
// beside another struct with the same field name set (`{ v: i32 }`): the application is a
// struct field, so the annotation keeps its own row (D3901; a frontier pin since #1121).
type Box<T> = { a: T, b: string }

const o: { v: Box<i32> } = { v: { a: 1, b: "z" } }
print(o.v.b)
const q: { v: i32 } = { v: 4 }
print(q.v)
