// @run
// @log 7
// @log 11
// @log v
// @log 10
// @log 11
// @log 7
// @log 22
// @hint Intentionally-unused parameter `_n`
// @hint Intentionally-unused parameter `_p`
// @hint Intentionally-unused variable `_seen`
// A closure value passed through a generic FORWARDER (`gwrap<T>(x: T)` whose body calls a
// second generic on its own parameter), plus the void-returning and two-parameter shapes.
//
// THE FORWARDER IS ITS OWN SEAM, one step past the direct call. An instance's body is a
// CLONE whose `T`-typed annotations were rewritten to the monomorphization PIN
// (`"=>i>i"`), and a pin is not a type spelling — `nameToTy` resolves it to nothing, so the
// clone's nodes carry no `TyFunc` and the ARENA route that fixes the direct call answers ""
// here. The inner call then had no pin at all and monomorphization rejected it.
//
// The annotation IS the answer (`monoCloPinAnnNodeOf`), and it must be read as a NODE
// rather than a name: `checkParams`' first rung is `tyIsFuncType`, an ARENA question, so an
// inner instance whose parameter is NAMED as a closure but whose node carries the outer
// argument's unrelated type is rejected with "only i32, i64, f64, f32, boolean, struct,
// union, array, or string parameters are supported". Naming without typing turns a silent
// miscompile into a loud one and closes nothing; `monoArgPinTyIx` banks the type from the
// same node the name came from.
function gid<T>(x: T): T { return x }
function gwrap<T>(x: T): T { return gid(x) }
// The forwarder that hands on a LOCAL the same substitution rewrote, not its parameter.
function gwrapLet<T>(x: T): T {
  const y: T = x
  return gid(y)
}
// A VOID-returning generic: `T` is pinned by the argument alone, with no result to confirm it.
function gtake<T>(x: T) { const _seen = x }
// TWO parameters at one type param — both positions pin the same instance.
function gpair<T>(_p: T, q: T): T { return q }

function body() {
  const f0 = () => 7
  const f1 = (n: i32) => n + 1
  const f2 = (_n: i32) => "v"
  const f3 = (n: i32) => [n, n]

  print(gwrap(f0)())
  print(gwrap(f1)(10))
  print(gwrap(f2)(10))
  print(gwrap(f3)(10)[0])

  print(gwrapLet(f1)(10))

  gtake(f0)
  print(f0())

  const second = (n: i32) => n + 12
  print(gpair(f1, second)(10))
}
body()
