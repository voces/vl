// @run
// @log 4
// @log 9
// @log a

// A generic signature's `T[]` arm, narrowed by `is` and indexed. Before monomorphization the
// arm's element is an unbound type variable, which renders as nothing, so only its type says
// it is a list.

function first<T>(u: T[] | string, d: T): T {
  if u is T[] {
    if u.length > 0 { return u[0] }
    return d
  }
  d
}

print(first([4, 5], 0))
print(first("s", 9))
print(first(["a"], "z"))
