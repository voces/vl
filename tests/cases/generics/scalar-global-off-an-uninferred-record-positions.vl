// @run
// @log 6
// @log 12
// @hint Intentionally-unused parameter
// A scalar global read off a record whose type the call leaves unfixed (`_`) is the i32 its cell
// declares: built in the start, read there and in a function.
type P = { a: i32, b: f64 }
type Rows<T> = { base: i32, count: i32 }
function g<T>(_r: Rows<T>, x: T): T { return x }
function mk<T>(b: i32): Rows<T> { return { base: b, count: 1 } }
const su = mk<P>(8)
const q = g(su, { a: 3, b: 4.5 })
const s = q.a * 2
function twice() { return s + s }
print(s)
print(twice())
