// @run
// @log 2
// @log 1
// @log 2
// @log 1
// A return set of two type parameters' lists stays apart at a pin whose element types are
// stored differently, at top level and through an enclosing generic (D4862).
function w<T0, T1>(a0: T0[], a1: T1[], k: i32) {
  if k == 0 { return a0 }
  a1
}
function g<T0, T1>(a0: T0[], a1: T1[], k: i32) {
  const v = w(a0, a1, k)
  print(v.length)
}
const x0: i32 | null = 7
const x1 = 4
const r = w([x1, x1], [x0], 0)
print(r.length)
const r2 = w([x1, x1], [x0], 1)
print(r2.length)
g([x1, x1], [x0], 0)
g([x1, x1], [x0], 1)
