// @run
// @log 5
// @log 5
// @log s
// @log s
// An assignment of a generic function to a function-typed binding, as a generic call's argument,
// is that binding re-read, so it is pinned at the binding's type as the read is (D17562).
function inner<U>(u: U) { print(u) }
function other<U>(u: U) { print(u) }
function run<T>(f: (t: T) => void, x: T) { f(x) }
function go<T>(x: T) {
  let k: (t: T) => void = inner
  run(k = other, x)
  k(x)
}
go(5)
go("s")
