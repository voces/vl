// @run
// @log a
// @log true
// @log k:a
// @log arm a
// @log a
// @log b
// @log false
// @log k:b
// @log arm b
// @log b
// @log true
// @log a
// @log false
// @log n
// @log false
// @log b
// A `??` over a literal-union place a type-parameter value was written into keeps the union when
// its default is a member, and widens to the base type when it is not, at every pin (D3423).
type K = "a" | "b"
function takeK(k: K) { return "k:" + k }
function member<T>(x: T): string {
  let s: K | null = null
  s = x
  print(s ?? "b")
  print((s ?? "b") == "a")
  print(takeK(s ?? "b"))
  const r: K = s ?? "b"
  match r {
    "a" => print("arm a")
    "b" => print("arm b")
  }
  return s ?? "b"
}
function widened<T>(x: T) {
  let s: K | null = null
  s = x
  const t: string = s ?? "n"
  print((s ?? "n") == "a")
  return t
}
const ka: K = "a"
const kn: K | null = null
const kb: K | null = "b"
print(member(ka))
print(member(kn))
print(widened(ka))
print(widened(kn))
print(widened(kb))
