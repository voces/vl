// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 5
// @log 1
// @log 1
// An empty `Map()` handed to a type parameter nothing else types is built at the default map,
// and the parameter pins at that map too (D1887).
type Rec = { name: string, n: i32 }
function one<B>(b: B) { [b].length }
function pass2<A, B>(a: A, b: B): A {
  print([b].length)
  a
}
function mkval(): {[string]: Rec} {
  const m: {[string]: Rec} = Map()
  m["k"] = { name: "ada", n: 3 }
  return m
}
function srcOf(): {[string]: Rec} { return pass2(mkval(), Map()) }
print(one(Map()))
print(srcOf().length)
print(pass2(5, Map()))
const typed: {[string]: i32} = Map()
typed["k"] = 3
print(pass2(typed, Map()).length)
