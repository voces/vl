// @check
// @error operator '^' is not defined for string and string (the call's argument types)
// @error operator '%' is not defined for f64 and f64 (the call's argument types)
// @error operator '<<' is not defined for boolean and boolean (the call's argument types)
// THE INTEGER-ONLY FAMILY AT A PIN — silent-class-inventory D492 and D493, and the two cells
// beside them that must NOT be refused.
//
// `binOpDefinedFor` adjudicates a deferred binary-op constraint under the call's substituted
// argument types, and its header says it "Mirrors `checkBinary`'s accepted forms". For the
// integer-only family (`% & | ^ << >> >>>`) it did not:
//
//   · `^ & | << >> >>>` were not modelled at all and fell through to the function's `true`
//     tail, so `a ^ b` pinned at `string` was ACCEPTED and the emitter emitted `i32.xor` over
//     two `(ref $type)` operands — check-clean INVALID WASM (D492), where the direct spelling
//     `function g(a: string, b: string)` is this file's first error;
//   · `%` was modelled but asked `isNumeric` alone, which is true of `f64` — so float
//     remainder was accepted at the pin and rejected by the EMITTER (D493), where the direct
//     spelling is `operator '%' is integer-only, got f64 and f64`.
//
// The third error is the PRICE, kept here because it is the part a reader will be surprised
// by: `a << b` over two booleans RAN before this landing (the boolean rep is an i32, so
// `i32.shl` executed and `true ^ false` printed `true`), while the direct spelling has always
// been a checker reject. 36 cells of `scripts/silent-sweep/d492/pingrid.py` are that shape,
// over `boolean` and over a string literal union; `--price` re-grades them.
//
// WHAT MUST NOT BE REFUSED is the rest of the file, and the operator OVERLOAD is the one that
// took a deliberate arm to keep. `checkBinary` reaches its integer-only rule only AFTER the
// operator-dispatch arm, so a `^` declared over an object is decided there and never asks the
// pin's question — mirroring the predicate without the ORDER would have made `xorV` below a
// false reject for a program that runs today.
function g<T>(a: T, b: T): i32 {
  const r = a ^ b
  return 1
}
const s: string = "x"
const t: string = "y"
print(g(s, t))

function h<T>(a: T, b: T): T { return a % b }
const f1: f64 = 7.5
const f2: f64 = 1.5
print(h(f1, f2))

function sh<T>(a: T, b: T): i32 {
  const r = a << b
  return 1
}
const b1: boolean = true
const b2: boolean = false
print(sh(b1, b2))

// The integer pins the family still accepts — i32 and i64, both operands, no float.
function ok<T>(a: T, b: T): T { return a ^ b }
const i1: i32 = 6
const i2: i32 = 3
print(ok(i1, i2))
const l1: i64 = 6
const l2: i64 = 3
print(ok(l1, l2))

// The operator OVERLOAD at a pinned hole — `objOpDispatchTy`'s deferral. It dispatches and
// prints 99, and a blanket object reject would have taken it.
type V = { x: i32 }
function "^"(self: V, other: V): i32 { return 99 }
function xorV<T>(a: T, b: T): i32 {
  const r = a ^ b
  return r
}
const v1: V = { x: 6 }
const v2: V = { x: 3 }
print(xorV(v1, v2))
