// @run
// @log 7
// @log y
// @log 9
// @log false
// A generic nested-list join at a string or boolean pin reads an element in either narrowed
// arm, the concrete `i32[][]` arm included (D2856).
function mk<T>(c: boolean, t: T) {
  if c { return [[t, t]] }
  [[7, 8, 9]]
}
const v = mk(false, "x")
if v is string[][] { print(v[0][0]) } else { print(v[0][0]) }
const w = mk(true, "y")
if w is string[][] { print(w[0][1]) } else { print(w[0][0]) }
const b = mk(false, true)
if b is boolean[][] { print(b[0][0]) } else { print(b[0][2]) }
const b2 = mk(true, false)
if b2 is boolean[][] { print(b2[0][0]) } else { print(b2[0][2]) }
