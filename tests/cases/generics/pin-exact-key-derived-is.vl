// @log true
// A generic whose body tests a value of its type parameter gets one instance per exact pin, so a
// Set and its boolean map, or a literal-union value and its base, are told apart through a copy,
// a generic identity, a reassignment, a closure and a generic it passes the value on to (D2684).
type L = "p" | "q"
function r<T>(u: T | null): T | null { u }
function viaCopy<T>(u: T | null) {
  const v = u
  v is Set<i32>
}
function viaIdentity<T>(u: T | null) {
  const v = r(u)
  v is {[i32]: boolean}
}
function viaLet<T>(u: T | null, o: T | null) {
  let v = u
  v = o
  v is Set<i32>
}
function viaClosure<T>(u: T | null) {
  const f = () => u is {[i32]: L}
  f()
}
function h<U>(x: U | null) { x is {[i32]: string} }
function viaPass<T>(u: T | null) { h<T>(u) }
const s: Set<i32> = Set()
s.add(3)
const b: {[i32]: boolean} = Map()
b.set(3, true)
const l: {[i32]: L} = Map()
l.set(3, "p")
const t: {[i32]: string} = Map()
t.set(3, "s")
print(viaCopy<{[i32]: boolean}>(b))
print(viaCopy<Set<i32>>(s))
print(viaIdentity<{[i32]: boolean}>(b))
print(viaIdentity<Set<i32>>(s))
print(viaLet<{[i32]: boolean}>(b, b))
print(viaLet<Set<i32>>(s, null))
print(viaLet<Set<i32>>(s, s))
print(viaClosure<{[i32]: string}>(t))
print(viaClosure<{[i32]: L}>(null))
print(viaClosure<{[i32]: L}>(l))
print(viaPass<{[i32]: L}>(l))
print(viaPass<{[i32]: string}>(t))
