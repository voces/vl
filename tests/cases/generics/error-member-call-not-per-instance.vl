// @check
// @error `.push` on i32[] is its built-in method, not the `push` in scope, and this call cannot pick it per instance from inside a closure or through a local — call it on the generic's own parameter (the body of `viaLocal` at the call's argument types)
// @error `.push` on i32[] is its built-in method, not the `push` in scope, and this call cannot pick it per instance from inside a closure or through a local — call it on the generic's own parameter (the body of `viaClosure` at the call's argument types)
// The per-instance pick of built-in, field or `self`-function (D2517) is made on a generic's own
// parameter. A call through a local copy of it, or from inside a closure, still calls the
// function in every instance, so where an instance's built-in would take the call it is refused
// rather than run the wrong member (D2520). Before, both printed 99 and left the list empty.
function push(self: i32[] | boolean, x: i32) { print(99 + x - x) }
function viaLocal<T>(x: T) {
  const y = x
  y.push(1)
}
function viaClosure<T>(x: T) {
  const go = () => x.push(1)
  go()
}
const xs: i32[] = []
viaLocal(xs)
viaClosure(xs)
viaLocal(true)
viaClosure(true)
