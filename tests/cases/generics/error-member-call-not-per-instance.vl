// @check
// @error `.slice` on string is its built-in method, not the `slice` in scope, and this call cannot pick it per instance from inside a closure or through a local — call it on the generic's own parameter (the body of `viaLocal` at the call's argument types)
// @error `.slice` on string is its built-in method, not the `slice` in scope, and this call cannot pick it per instance from inside a closure or through a local — call it on the generic's own parameter (the body of `viaClosure` at the call's argument types)
// The per-instance pick of built-in, field or `self`-function (D2517) is made on a generic's own
// parameter. A call through a local copy of it, or from inside a closure, still calls the
// function in every instance, so where an instance's built-in would take the call it is refused
// rather than run the wrong member (D2520). Before, both printed `fn` where `he` was owed.
function slice(self: boolean | string, a: i32, b: i32): string { "fn" }
function viaLocal<T>(x: T) {
  const y = x
  print(y.slice(0, 2))
}
function viaClosure<T>(x: T) {
  const go = () => x.slice(0, 2)
  print(go())
}
viaLocal("hello")
viaClosure("hello")
viaLocal(true)
viaClosure(true)
