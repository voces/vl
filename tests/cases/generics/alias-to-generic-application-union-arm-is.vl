// @run
// @log 5
// @log hi
// @log 7
// A TRANSPARENT alias whose body is a generic APPLICATION as a UNION ARM, narrowed with
// `is` — the pin for the variant spelling and the test that names it coming from ONE
// producer, through BOTH of the two rewrites, in the SAME order.
//
// `canonEmitTypeNames` resolves a transparent member and only THEN expands a generic
// application to its structural shape, so a member spelled `Y` for `type Y = Box<i32>`
// reaches `uVariants` as `{v:i32}`: the render's application name, expanded. The `is`
// rewriter has to travel the same two rungs in the same order — resolve the alias, then
// expand the application — or it names `Box<i32>` against a variant table holding
// `{v:i32}` and the emitter reports ``is` names a type that is not a union variant``.
//
// D-ISALIAS is the rule this is the other side of: that slice pinned the case where the
// member arm rewrites and the `is` arm does not. Here BOTH rewrite, and the defect is the
// ORDER — which only becomes reachable once the transparency render can PRODUCE an
// application spelling, because the leading expansion cannot see a name that does not exist
// until the rung below it has run.
type Box<T> = { v: T }
type Y = Box<i32>
type Other = { w: string }
type U = Y | Other

const a: U = { v: 5 }
if a is Y { print(a.v) }

const b: U = { w: "hi" }
if b is Other { print(b.w) }

// The DIRECT spelling of the same arm — one rewrite instead of two, and it must keep
// landing on the identical variant.
type U2 = Box<i32> | Other
const c: U2 = { v: 7 }
if c is Box<i32> { print(c.v) }
