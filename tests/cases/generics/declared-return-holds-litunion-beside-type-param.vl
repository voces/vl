// A generic's declared result holding `T | K` in a record field or a list element registers that
// union at the instance, so the result's shape exists wherever it is read (D7040).
type K = "a" | "b"

function r<T>(x: T): { v: T | K } { return { v: x } }
function w<T>(x: T): { v: T | K, n: i32 } { return { v: x, n: 1 } }
function l<T>(x: T): (T | K)[] { return [x] }
function lr<T>(x: T): { v: (T | K)[] } { return { v: [x] } }

print(r(3).v)
const q = r(4)
print(q.v)
print(r(3.5).v)
print(r(true).v)
print(w(2).n)
print(l(5)[0])
print(lr(6).v[0])
// @log 3
// @log 4
// @log 3.5
// @log true
// @log 1
// @log 5
// @log 6
