// @run
// @log 2.5
// @log 1
// @log 1
// @log 1.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log s
// @log 4.25
// A hole function returning `[t]` beside the literal tail `[1]` returns the list at `t`'s
// binding, so the tail's literal adapts to `f64` as it does beside a type parameter. Read at a
// binding, for its length, as an `f64[]` argument, reassigned, in a `for`, either order (D4900).
function w(t, b: boolean) {
  if b { return [t] }
  [1]
}

function u(t, b: boolean) {
  if b { return [1] }
  [t]
}

function g<T>(t: T, b: boolean) {
  if b { return [t] }
  [1]
}

function sum(xs: f64[]) {
  let s = 0.0
  for x in xs { s = s + x }
  s
}

const a = w(2.5, true)
print(a[0])
print(a.length)
print(sum(w(2.5, false)))
print(u(1.5, false)[0])
print(u(1.5, true)[0] / 2.0)
let m = w(0.5, true)
m = w(3.5, false)
print(m[0] / 2.0)
print(g(2.5, false)[0] / 2.0)
print(w("s", true)[0])
for x in w(4.25, true) { print(x) }
