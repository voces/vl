// @log t=4
// @warning Unused parameter `a` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `b` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `p_a12` is inferred as `{x: i32}` — remove it to lean on inference
// A callback with an open parameter (an un-annotated lambda, or a generic named as a value)
// whose arrow PARAMETER position rides a type variable is checked after the value arguments,
// so the variable binds from the values (D2425, D2426, D2427). One cell per shape from the
// review grid; most were a loud emit reject or invalid wasm before. The two unused
// parameters bind a type variable and are declared warnings.
// cell a04
function fold_a04<T, A>(f: (A, T) => A, init: A, xs: T[]) {
  let acc = init
  for x in xs { acc = f(acc, x) }
  return acc
}
print(fold_a04((a, x) => a + x, 0, [1, 2, 3]))
print(fold_a04((a, x) => a + x, "", ["a", "b"]))

// cell a05
function fold_a05<T, A>(xs: T[], init: A, f: (A, T) => A) {
  let acc = init
  for x in xs { acc = f(acc, x) }
  return acc
}
print(fold_a05([1, 2, 3], 0, (a, x) => a + x))
print(fold_a05([1.5, 2.0], 0.5, (a, x) => a + x))

// cell a06
function mapL_a06<T, U>(f: (T) => U, xs: T[]): U[] {
  const out_a06: U[] = []
  for x in xs { out_a06.push(f(x)) }
  return out_a06
}
const r_a06 = mapL_a06((x) => x * 2, [1, 2, 3])
print(r_a06[2])
const s_a06 = mapL_a06((x) => "\{x}!", [1, 2])
print(s_a06[1])

// cell a09
function twice_a09<T>(f: (T) => T, x: T) { return f(f(x)) }
function dbl_a09<U>(x: U) { return x + x }
print(twice_a09(dbl_a09, 3))
print(twice_a09(dbl_a09, "ab"))
print(twice_a09(dbl_a09, 1.5))

// cell a10
function twice_a10<T>(x: T, f: (T) => T) { return f(f(x)) }
function dbl_a10<U>(x: U) { return x + x }
print(twice_a10(3, dbl_a10))
print(twice_a10("ab", dbl_a10))

// cell a11
function pair_a11<A, B>(f: (A) => B, g: (B) => A, a: A) { return g(f(a)) }
print(pair_a11((x) => x + 1, (y) => y * 3, 2))

// cell a12
function ap_a12<T>(f: (T) => T, x: T): T { return f(x) }
type P_a12 = { x: i32 }
const p_a12: P_a12 = { x: 4 }
print(ap_a12((v) => v, p_a12).x)
print(ap_a12((v) => v, [1, 2]).length)

// cell a13
function ap_a13<T>(f: (T) => T, x: T) { return f(x) }
print(ap_a13((v) => v + 1, 3))
print(ap_a13((v) => v, "q"))

// cell a14
function each_a14<T>(f: (T) => void, xs: T[]) {
  for x in xs { f(x) }
}
each_a14((x) => print(x * 10), [1, 2])
each_a14((s) => print("<\{s}>"), ["a"])

// cell a15
function first_a15<T>(f: (T) => boolean, xs: T[], d: T) {
  for x in xs {
    if f(x) { return x }
  }
  return d
}
print(first_a15((x) => x > 2, [1, 3, 5], 0))

// cell a17
function ap2_a17<T>(f: (T) => T, g: (T) => T, x: T) { return g(f(x)) }
print(ap2_a17((a) => a + 1, (b) => b * 10, 2))

// cell a19
function ap_a19<T>(f: (T) => T, x: T) { return f(x) }
print(ap_a19((v) => v + 1, ap_a19((w) => w * 2, 5)))

// cell a20
function reduce_a20<T>(xs: T[], f: (T, T) => T) {
  let acc = xs[0]
  let i = 1
  while i < xs.length { acc = f(acc, xs[i]); i = i + 1 }
  return acc
}
print(reduce_a20([3, 4, 5], (a, b) => a * b))
print(reduce_a20(["x", "y"], (a, b) => a + b))

// cell a22
function g_a22<T>(f: (T) => i32, x: T) { return f(x) }
print(g_a22((s) => s.length, "abcd"))
print(g_a22((xs) => xs.length, [1, 2, 3]))

// cell a23
function g_a23<T>(x: T, f: (T) => i32) { return f(x) }
print(g_a23("abcd", (s) => s.length))

// cell a24
function h_a24<T>(f: (T) => T, x: T) { return f(x) }
print(h_a24((v) => v * 2, 1.25))
print(h_a24((v) => !v, true))

// cell b05
function f_b05<T>(g: (T) => T, a: T, b: T) { return g(b) }
print(f_b05((v) => v, 1, 2))

// cell b13
function f_b13<A, B>(g: (A) => B, a: A, b: B) { return g(a) }
print(f_b13((x) => x * 2.0, 3.0, 1.0))
print(f_b13((x) => x * 2, 3, 1))

// cell b16
function f_b16<T>(h: (T) => string, g: (i32) => T) { return h(g(3)) }
print(f_b16((t) => "t=\{t}", (i) => i + 1))
