// @check
// @error argument of type string flows into `h` expecting i32 (the call's argument types)
// @error argument of type boolean flows into `h` expecting K (the call's argument types)
// @error argument of type string flows into `h` expecting i32 (the call's argument types)
// D3171: an argument handed to a hole callee is held, at each call that pins the callee, to the
// parameter the pinned function declares, through a forwarding hole too. Unchecked, each of
// these compiled to invalid wasm or ran with a wrong value.
type K = "a" | "b"
function H(h, v) { return h(v) }
print(H((x: i32) => x + 1, "s"))
print(H((x: K) => x, true))
function F(g, w) { return H(g, w) }
print(F((x: i32) => x + 1, "s"))
const kk: K = "b"
print(H((x: K) => x, kk))
print(H((x: f64) => x / 2.0, 3))
