// @run
// @hint redundant type annotation: `v` is inferred as `P | i32`
// @hint redundant type annotation: `w` is inferred as `P | i32`
// @hint redundant type annotation: `u` is inferred as `P | i32`
// A `??` over a bounded `T | null` parameter keeps its default in the call's type: the record
// pin's call is `P | i32`, whichever arm the value took (D2956).
type P = { x: i32 }
function g<T: { x: i32 }>(a: T | null) {
  const r = a ?? 5
  r
}
function h<T>(a: T | null) {
  const r = a ?? 5
  r
}
const n: P | null = null
const m: P | null = { x: 2 }
const v: P | i32 = g(n)
if v is P { print(v.x) } else { print(v) }
const w: P | i32 = g(m)
if w is P { print(w.x) } else { print(w) }
const u: P | i32 = h(n)
if u is P { print(u.x) } else { print(u) }
// @log 5
// @log 2
// @log 5
