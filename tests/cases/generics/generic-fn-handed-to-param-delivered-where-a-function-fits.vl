// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// A generic function handed to a type parameter and delivered where a function fits, another
// type parameter, a record field or a union of records holding one, runs (D14979's controls).
function id<T>(x: T): T { x }
function toFn<F>(a: F) {
  const zz: (x: i32) => i32 = a
  print(zz(3))
}
toFn(id)
function toNullFn<F>(a: F) {
  const zz: ((x: i32) => i32) | null = a
  if zz != null { print(zz(4)) }
}
toNullFn(id)
function two<G>(g: G): G { g }
function toParam<F>(a: F) {
  const zz = two(a)
  print(zz(5))
}
toParam(id)
function back<F>(a: F): F { a }
print(back(id)(6))
function inField<F>(a: F) {
  const r: { f: F } = { f: a }
  print(r.f(7))
}
inField(id)
function inUnion<F>(a: F) {
  const zz: boolean | ((x: i32) => i32) = a
  if zz is boolean { print(zz) } else { print(zz(8)) }
}
inUnion(id)
type P = { k: (x: i32) => i32 } | { j: string }
function inRecordUnion<F>(a: F) {
  const zz: { f: P } = { f: { k: a } }
  const p = zz.f
  if p is { k: (x: i32) => i32 } { print(p.k(9)) }
}
inRecordUnion(id)
