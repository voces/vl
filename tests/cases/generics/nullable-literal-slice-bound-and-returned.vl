// @run
// @log 1
// @log false
// @log s
// @log 1
// @log 5
// @log 2
// @log true
// D2572: a generic that binds a slice or filter of `[null, x]` and returns the binding builds
// the binding at the instance's `(T | null)[]` list, and the caller reads that list back.
function g<T>(x: T) {
  const q = [null, x].slice(1)
  return q
}
function keep<T>(x: T) {
  const q = [x, null].filter((e) => e != null)
  return q
}
function both<T>(x: T) {
  const q = [null, x]
  return q
}

const r = g("s")
print(r.length)
print(r[0] == null)
print(r[0] ?? "-")
const k = keep(5)
print(k.length)
print(k[0] ?? 0)
const b = both("t")
print(b.length)
print(b[0] == null)
