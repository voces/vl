// @check
// @error cannot assign <T>(T) => T[] to 'b' of type <T>(T) => T (parameter `a1` of `mid`, used at
// A generic function value returning a list of its parameter does not fit `<T>(T) => T` (D17322).
function same<T>(k: T): T { return k }
function wrap<T>(k: T): T[] { return [k] }
function mid<F, G>(a: F, a1: G) {
  let b: F = a1
  print(a("x"))
  print(a(1))
}
mid(same, wrap)
