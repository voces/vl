// @error cannot assign boolean to 'n' of type i32
// A nested generic redeclaring `T` still has a demand it makes of the ENCLOSING `T`, read
// through a capture, checked at the enclosing function's pin (D3853).
function a<T>(x: T) {
  function b<T>(y: T) {
    const n: i32 = x
    print(n)
    print(y)
  }
  b(1)
}
a(true)
