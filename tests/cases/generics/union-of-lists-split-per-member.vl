// A union of lists handed to a generic list parameter calls the function at the member the value
// holds: each argument is read once and in order, and a write through the parameter reaches it.
function first<T>(xs: T[]): T { return xs[0] }
function len<T>(xs: T[]) { return xs.length }
function dup<T>(xs: T[]) { xs.push(xs[0]) }
function both<A, B>(xs: A[], ys: B[]) { return xs.length * 10 + ys.length }
function last<T>(xs: T[], n: i32 = 0): T { return xs[xs.length - 1 - n] }
const q: string[] | i32[] = ["a", "bc"]
const r: string[] | f64[] | boolean[] = [1.5, 2.5, 3.5]
print(first(q))
print(len(r))
dup(q)
print(len(q))
print(both(q, r))
print(last(n: 1, xs: r))
let log = ""
function mk(): string[] | i32[] { log = log + "a"; return [7] }
function at() { log = log + "b"; return 0 }
function pick<T>(n: i32, xs: T[]): T { return xs[n] }
print(pick(at(), mk()))
print(log)
function inGeneric<U>(u: U, xs: string[] | i32[]) {
  print(u)
  return len(xs)
}
print(inGeneric(true, [1, 2, 3, 4]))
const qs: (string[] | i32[])[] = [["x"], [9]]
for x in qs { print(first(x)) }
// @log a
