// @run
// @hint redundant type annotation: `r7` is inferred as `{x: i32}`
// @hint redundant type annotation: `r8` is inferred as `{x: i32}`
// @hint redundant type annotation: `r9` is inferred as `{x: i32}`
// A `??` over a join of type parameters kept apart is typed at the pin without its `null`:
// where both parameters bind one type its result is that type, not a box (D3568).
type Rec = { x: i32 }
const r7: Rec = { x: 7 }
const r8: Rec = { x: 8 }
const r9: Rec = { x: 9 }
function F<A, B>(k: i32, a: A, b: B) {
  const v = if k == 0 { a } else if k == 1 { b } else { null }
  print((v ?? 0) + 1)
  const w = v ?? 0
  print(w * 2)
  const ys = [if k == 0 { a } else if k == 1 { b } else { null }]
  print((ys[0] ?? 0) + 1)
}
F(0, 3, 4)
F(2, 3, 4)
F(1, 2.5, 4.5)
function G<A, B, C>(k: i32, a: A, b: B, c: C) {
  const v = if k == 0 { a } else if k == 1 { b } else if k == 2 { c } else { null }
  print((v ?? 9) is i32)
  print(v ?? 9)
}
G(0, 3, 4, 5)
G(3, 3, 4, 5)
G(2, 3, 4, "s")
function H<A, B>(k: i32, a: A, b: B) {
  const v = if k == 0 { a } else if k == 1 { b } else { null }
  print((v ?? r9) is Rec)
  print((v ?? r9).x)
}
H(1, r7, r8)
H(2, r7, r8)
// @log 4
