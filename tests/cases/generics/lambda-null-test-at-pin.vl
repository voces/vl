// @run
// @log 0
// @log 1
// @log 1
// @log false
// @log false
// @log true
// @log 0
// @log 0
// A `== null` inside a lambda of an instance whose pin admits no `null` folds to its constant,
// as the same test in the instance body does, whether it reads the lambda's own parameter or
// a capture (D3126).
function f<T>(x: T) { print([x].filter((y) => y == null).length) }
f(3)
const a: i32 | null = null
f(a)
function n<T>(x: T) { print([x].filter((y) => null != y).length) }
n("s")
function k<T>(x: T) {
  const c = () => x == null
  print(c())
}
k(2.5)
k(true)
k(a)
function h(x) {
  print([x].filter((y) => y == null).length)
  const c = () => x == null
  if c() { print(1) } else { print(0) }
}
h(3)
