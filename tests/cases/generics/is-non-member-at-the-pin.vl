// @run
// @log false
// @log false
// @log false
// @log not P
// @log not P
// @log false
// @log false
// @log false
// @log false
// An `is` in a generic body naming a type the pin cannot hold answers false (D3344): a record
// against a `string | null` niche, a record against a join boxed as `boolean | i32`, and `i32`
// against a `K | null` niche. The direct spelling of each is the checker's own refusal.
type K = "a" | "b"
type P = {x: i32}
function g<T>(a: T) { print(a is P) }
const s: string | null = "q"
g(s)
function j<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r is P)
}
const xb: string | null = "q"
j("x", xb, 0)
j("x", xb, 1)
function n<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  if r is P { print(r.x) } else { print("not P") }
}
n("x", xb, 0)
n("x", xb, 1)
j(true, 3, 0)
j(true, 3, 1)
function l<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r is i32)
}
const ka: K = "b"
const kb: K | null = "a"
l(ka, kb, 0)
l(ka, kb, 1)
