// @run
// @log p
// @log 2.5
// @log 9
// @log q
// A list literal of a hole instance's local builds at the scalar list its pin names when the
// instance is reached through another function's call, at a string, an `f64` and an `i64`, and
// behind an explicit forwarder (D3061).
function f2(x) {
  const y = x
  const s = [y, y]
  print(s[1])
}
function f1(x) { f2(x) }
const sv: string = "p"
f1(sv)
const fv = 2.5
f1(fv)
const iv: i64 = 9
f1(iv)
function fx<T>(x: T) { f2(x) }
const qv: string = "q"
fx(qv)
