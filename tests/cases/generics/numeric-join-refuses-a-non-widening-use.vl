// @check
// @error-at 13:13 argument 2: expected i32, got string
// @error-at 14:13 argument 2: expected i64, got f64
// @error-at 15:13 argument 2: expected i32, got f32
// @error-at 16:23 argument 2: expected (i32) => i32, got (i32) => string
// A type parameter's uses join only over numeric widening: `i64` and `f64` do not widen to
// each other, `i32` does not widen to `f32`, and a string meets no number (D2459).
function mix<T>(a: T, b: T): T[] { [a, b] }
function first<T>(_x: T, g: (i32) => T) { return g(2) }
const n: i32 = 1
const l: i64 = 1
const d: f64 = 2.5
const s: f32 = 2.5
print(mix(n, "s").length)
print(mix(l, d).length)
print(mix(n, s).length)
print(first(n, (_i) => "s"))
