// @run
// @log true
// @log 2
// @log true
// @log s
// @log 4
// @log true
// @log true
// @log 1.5
// A `??` chain of a hole's map reads whose values differ in kind keeps each value's own kind: the
// chain's inner link joins into the same box, each arm tagged at its own member.
function show(x) { print(x) }
function use(a, b) { print(a[9] ?? a[8] ?? b[3]) }
function back(a, b) { print(a[9] ?? b[8] ?? a[3]) }
function bound(a, b) {
  const x = a[9] ?? a[8] ?? b[3]
  print(x)
}
function ret(a, b) { return a[9] ?? a[8] ?? b[3] }
function arg(a, b) { show(a[9] ?? a[8] ?? b[3]) }
const t: {[i32]: boolean} = Map()
t[8] = true
t[3] = true
const n: {[i32]: i32} = Map()
n[3] = 2
const e: {[i32]: boolean} = Map()
use(t, n)
use(e, n)
back(t, n)
const s: {[i32]: string} = Map()
s[8] = "s"
use(s, n)
const four: {[i32]: i32} = Map()
four[3] = 4
bound(e, four)
print(ret(t, n))
arg(t, n)
const f: {[i32]: f64} = Map()
f[8] = 1.5
use(f, n)
