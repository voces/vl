// @run
// @log 3
// @log 2
// @log 1
// @log 2.5
// @log 3
// @log 2
// A local bound to an `if` of a type parameter's list and a list literal is stored as the one
// list the literal adapts to at the pin, and its reads agree with that storage (D4884).
function h<T>(t: T, b: boolean) {
  const v = if b { [t, t] } else { [1, 2, 3] }
  print(v.length)
}
function f<T>(t: T, b: boolean) {
  const v = if b { [t, t] } else { [1, 2, 3] }
  print(v[0])
}
h(2.5, false)
h(2.5, true)
f(2.5, false)
f(2.5, true)
const big: i64 = 5
h(big, false)
h(big, true)
