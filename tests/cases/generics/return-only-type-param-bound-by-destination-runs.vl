// @run
// @log 0
// @log true
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log q
// @log 1
// @log 2
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// A type parameter only the result names is bound by the call's destination type (D9073):
// an annotated binding, a nullable one, an argument, a declared return, a re-pointed `let`
// and a UFCS call; the instance is the destination's, so a `push` at it holds.

import { IdTable } from "std:idtable"

function mk<T>(): T[] { [] }
const xs: string[] = mk()
print(xs.length)
function z<T>(): T | null { null }
const v: string | null = z()
print(v == null)
function cnst<T, U>(_t: T): U[] { return [] }
const ys: string[] = cnst(3)
print(ys.length)
function mcnst<T, U>(self: T): U[] { return [] }
const zs: f64[] = 3.mcnst()
print(zs.length)
function use(a: i64[]) { print(a.length) }
use(mk())
function mk2(): string[] { mk() }
print(mk2().length)
let w = ["a"]
w = mk()
print(w.length)
const ss: string[] = mk()
ss.push("q")
print(ss[0])
type Tex = { w: i32 }
const t: IdTable<Tex> = IdTable()
t.set(1, { w: 2 })
print(t.length)
print(t.get(1)?.w ?? 0)
