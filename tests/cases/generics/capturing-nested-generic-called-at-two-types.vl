// @log 3
// A capturing nested generic of a generic encloser, handed to a parameter that calls it at two
// types, is handed as one closure per type built in each encloser instance (D15595).
function mid<F>(a: F) {
  print(a("x"))
  print(a(2))
}
function outer<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  mid(same)
}
outer(7)
outer("s")

function midHole(a) {
  print(a("y"))
  print(a(3))
}
function outerHole<U>(u: U) {
  function keep<T>(k: T): T {
    print(u)
    k
  }
  midHole(keep)
}
outerHole(true)
