// @emit-error emitProgram: index receiver is not an array or string
// THE SOUNDNESS BOUNDARY of the `boolean[]` pin, in the reject direction.
//
// `nameIsI32Array` accepts FOUR spellings that all ride the one i32 list backing: `i32[]`,
// `boolean[]`, a litunion `K[]` and the `(boolean|null)[]` / `(K|null)[]` sentinel niches.
// Only `boolean[]` is claimed as a monomorphization pin, because only its divergence was
// measured; the D-SHAPEFIELD precedent is that an unreached widening is not licenced.
//
// This file is the measurement that makes declining the rest FAIL CLOSED rather than
// silently: a `K[]` argument keeps the `i32[]` pin and the element read then hits the
// floor LOUDLY, so no wrong value escapes. The `(boolean|null)[]` sibling reaches its own
// floor on the same shape (`emitProgram: `??` is only supported on a map index get`).
// The ORACLE is the concrete twin, which prints `a` — a generic that cannot spell the pin
// must reject, never print the atom id.

type K = "a" | "b"

function gtake<T>(x: T) { print(x[0]) }

function main() {
  const ks: K[] = ["a", "b"]
  gtake(ks)
}
main()
