// @run
// @log -1
// @log 4
// @log -1
// @log 4
// @log 9
// A pinned union parameter spells its members in the written order, which is not the type's
// canonical order: each atom is boxed by its own member type, so `Z[]` before `P` still boxes (D15675).
type P = { x: i32 }
type Z = { z: i32 }
function k<T>(u: T | P) {
  if u is P { return u.x }
  -1
}
function m<T>(u: T | P | string) {
  if u is P { return u.x }
  if u is string { return 9 }
  -1
}
const zs: Z[] = [{ z: 1 }]
print(k<Z[]>(zs))
print(k<Z[]>({ x: 4 }))
print(m<Z[]>(zs))
print(m<Z[]>({ x: 4 }))
print(m<Z[]>("s"))
