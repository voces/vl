// @run
// @log 2
// @log 2
// @log s
// @log 2.5
// D14721: a list literal pushed onto a generic's list of lists is built at each instance's own
// element type, in either call order and with an empty `[]` argument.
function w<T>(v: T[][], x: T) { v.push([x]) }
const a: string[][] = []
const b: f64[][] = []
w(a, "s")
w(b, 2.5)
print(a.length + b.length)
const c: f64[][] = []
const d: i32[][] = []
w(c, 1.5)
w(d, 3)
print(c.length + d.length)
function wrap<T>(v: T[][], x: T): T {
  v.push([x])
  v[0][0]
}
print(wrap([], "s"))
print(wrap([], 2.5))
