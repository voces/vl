// @emit-error a function-value call has no interned signature
// A hole-bound field function whose result is not a scalar or a string has no key at the
// instance, and the all-`i32` functype would call it at the wrong type; the second instance
// here used to trap with an indirect call type mismatch, and now refuses (D3165).
function F(z) {
  const g = z.f
  print(g())
}
const r0 = { f: (): i32 | null => null }
F(r0)
const r1 = { f: (): "a" | "b" => "a" }
F(r1)
