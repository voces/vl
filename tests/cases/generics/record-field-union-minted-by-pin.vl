// @run
// @log true
// @log true
// @log true
// @log 11
// A record annotation in a generic body whose field is a union the pin mints (`{ v: V | IM }` at
// `V := string`) has a row of its own at the instance, as its field's box does, nested or not
// (D2681).
type IM = {[i32]: i32}
function g<V>(x: IM) {
  const b: { v: V | IM } = { v: x }
  return b.v is IM
}
function n<V>(x: IM) {
  const b: { o: { v: V | IM } } = { o: { v: x } }
  return b.o.v is IM
}
function r<V>(x: IM): V | IM {
  const b: { v: V | IM, k: i32 } = { v: x, k: 1 }
  return b.v
}
const im: IM = Map()
im[1] = 11
print(g<string>(im))
print(g<boolean>(im))
print(n<string>(im))
const v = r<string>(im)
if v is IM { print(v[1] ?? -1) }
