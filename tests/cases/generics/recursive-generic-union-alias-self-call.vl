// @run
// @log 3
// @log 2
// @log 3
// A generic over a recursive generic union alias calls itself on each element of its narrowed list
// arm, at two instances, through `is` and through `match` (D16151).
type Tree<T> = { leaf: T } | { kids: Tree<T>[] }
function count<T>(t: Tree<T>) {
  if t is { leaf: T } { return 1 }
  let n = 0
  for k in t.kids { n = n + count(k) }
  return n
}
function size<T>(t: Tree<T>) {
  match t {
    { leaf: T } => 1
    { kids: Tree<T>[] } => {
      let n = 0
      for k in t.kids { n = n + size(k) }
      n
    }
  }
}
const a: Tree<string> = {
  kids: [
    { leaf: "x" },
    { kids: [{ leaf: "y" }, { leaf: "z" }] },
  ],
}
const b: Tree<i32> = { kids: [{ leaf: 1 }, { leaf: 2 }] }
print(count(a))
print(count(b))
print(size(a))
