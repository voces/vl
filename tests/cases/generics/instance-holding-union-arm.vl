// @run
// @log 4
// @log 6
// @log 2
// @log 3
// @log 4
// @log 2
// @log 6
// @log 2
// @log 3
// A generic record instance holding a union arm (D15096): as its own field, and as the type
// argument, at two instances each. The instance's field records the arm's twin row, minted on
// demand when only a type argument reaches the arm.
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
type W<T> = { o: O | null, v: T }
const w: W<i32> = { o: { n: 4, next: null }, v: 1 }
print(w.o?.n ?? 0)
const ws: W<string> = { o: { n: 6, next: null }, v: "s" }
print(ws.o?.n ?? 0)

type K = { n: i32, k: i32 }
type L = { m: i32 }
type UK = K | L
type Cell<T> = { val: T }
type Pair<A, B> = { a: A, b: B }
const c: Cell<K> = { val: { n: 2, k: 0 } }
print(c.val.n)
const d: Cell<L> = { val: { m: 3 } }
print(d.val.m)
const pr: Pair<K, L | null> = { a: { n: 4, k: 1 }, b: null }
print(pr.a.n)
const u: UK = c.val
if u is K { print(u.n + u.k) }
const cs: Cell<K>[] = [c, { val: { n: 6, k: 0 } }]
print(cs[1].val.n)
function un(x: Cell<K>): K { return x.val }
print(un(c).n)
const r: Cell<O> = { val: { n: 3, next: null } }
print(r.val.n)
