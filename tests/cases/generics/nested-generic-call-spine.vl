// @run
// @log 1
// @log x
// @log 3
// @log 4
// @log 3
// @log 4
// @log 2
// @log y
// @log 1
// @log x
// @log 1
// @log x
// @log 1
// @log x
// @hint redundant type annotation: `a` is inferred as `i32[]`
// @hint redundant type annotation: `b` is inferred as `string[]`
// @hint redundant type annotation: `f` is inferred as `f64[]`
// The POSITIONS a nested generic call can occupy inside a generic's body. The per-instance copy of
// the generic-call spine is only as good as its traversal, so this pins one case per limb the
// monomorphizer's own walk descends into: a `let` initializer, both sides of a binary expression, a
// COMPOUND assignment's value, an array literal element, an object-literal field, a `for … in`
// body, and an index receiver. Each is exercised at two element types — one instance alone never
// reproduced the defect.
//
// The compound-assignment limb is the one that needed care: `acc += at(xs, 1)` desugars to
// `target = (target + value)` with the target node SHARED between the read and the write, so it is
// re-synthesized from its parts with only the value limb cloned, rather than rebuilt limb-by-limb.

function at<T>(xs: T[], i: i32) { return xs[i] }
function idn<T>(xs: T[]): T[] { return xs }

function viaLet<T>(xs: T[]) {
  const v = at(xs, 0)
  return v
}
function viaBin<T>(xs: T[]) { return at(xs, 0) + at(xs, 1) }
function viaCompound<T>(xs: T[]) {
  let acc = at(xs, 0)
  acc += at(xs, 1)
  return acc
}
function viaArrayLit<T>(xs: T[]): T[] { return [at(xs, 0), at(xs, 1)] }
function viaObjLit<T>(xs: T[]): { v: T } { return { v: at(xs, 0) } }
function viaForIn<T>(xs: T[]): T {
  for _x in xs {
    return at(xs, 0)
  }
  return at(xs, 0)
}
function viaIndex<T>(xs: T[]) { return idn(xs)[0] }

const a: i32[] = [1, 2]
const b: string[] = ["x", "y"]
const f: f64[] = [1.5, 2.5]

print(viaLet(a)) // 1
print(viaLet(b)) // x
print(viaBin(a)) // 3
print(viaBin(f)) // 4
print(viaCompound(a)) // 3
print(viaCompound(f)) // 4
print(viaArrayLit(a)[1]) // 2
print(viaArrayLit(b)[1]) // y
print(viaObjLit(a).v) // 1
print(viaObjLit(b).v) // x
print(viaForIn(a)) // 1
print(viaForIn(b)) // x
print(viaIndex(a)) // 1
print(viaIndex(b)) // x
