// @run
// @hint Intentionally-unused parameter `_r`
// @hint redundant type annotation: `su`
// @log 2
// @log 7
// A phantom `T` of `Rows<T>` binds to `P` in the checker and in the instance alike, at an
// annotated and at an inferred binding of the row (D12470).
type P = { a: i32, b: i32 }
type Rows<T> = { base: i32, count: i32 }
function g<T>(_r: Rows<T>, x: T): T { x }
function mk<T>(b: i32): Rows<T> { return { base: b, count: 1 } }
const st: Rows<P> = { base: 1000, count: 4 }
print(g(st, { a: 1, b: 2 }).b)
const su: Rows<P> = mk<P>(8)
const q = g(su, { a: 3, b: 4 })
print(q.a + q.b)
