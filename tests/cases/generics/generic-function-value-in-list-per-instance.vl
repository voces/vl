// @log s
// A generic function stored as a list element, a bound value captured by a lambda, and an
// if-arm value, inside a generic instantiated at two types: each instance stores its own (D3909).
function a<T>(x: T) {
  function b<U>(y: U) { print(y) }
  function c<U>(y: U) { print("c"); print(y) }
  const fs: ((t: T) => void)[] = [b, c]
  fs[0](x)
  fs[1](x)
  const h: (t: T) => void = b
  const w = (t: T) => h(t)
  w(x)
  const k: (t: T) => void = if x == x { c } else { b }
  k(x)
}
a(false)
a("s")
