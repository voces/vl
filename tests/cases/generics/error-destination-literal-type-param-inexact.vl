// @check
// @error cannot assign i32[] to 'grid' of type f32[]
// @error cannot assign f64[] to 'ints' of type i64[]
// @error cannot assign i32[] to 'small' of type (1 | 2 | 7)[]
// @error cannot assign i32[] to 'bytes' of type u8[]
// @error i32[] is not f64[]
// @error cannot assign i32[] to 'lits' of type (1 | 2 | 7)[]
// The destination binds a literal-only type parameter only where the literal holds there,
// exactly as it would at an annotated binding (D3539). An integer past f32's exact range, a
// fraction at an integer, and a literal outside a literal union keep the arguments' own
// binding and refuse at the destination, and so does an integer literal at a float element,
// since a literal adapts only within its kind. `u8` is a storage type a type parameter never binds,
// so a `u8[]` destination does not reach `filled` either.
import { filled } from "std:array"

const grid: f32[] = filled(2, 16777217)
const ints: i64[] = filled(2, 2.5)
const small: (1 | 2 | 7)[] = filled(2, 3)
const bytes: u8[] = filled(4, 0)
const negs: f64[] = filled(2, -3)
const lits: (1 | 2 | 7)[] = filled(2, 7)
print(
  grid.length
    + ints.length
    + small.length
    + bytes.length
    + negs.length
    + lits.length,
)
