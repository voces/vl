// @log 1
// @log 5
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// D14081: an un-annotated record literal inside a generic body, handed to a record whose field
// is `T | null`, is built at that destination at every instance, so the delivery needs no copy
// and a read of the binding after the call still sees its own value.
function len<T>(r: {v: T | null}) {
  if r.v == null { 0 } else { 1 }
}

function outer<U>(x: U) {
  const r = { v: x }
  return len(r)
}

function readAfter<U>(x: U) {
  const r = { v: x }
  const n = len(r)
  print(r.v)
  return n
}

function outerOnly<U>(x: U) {
  const r = { v: x }
  const q: {v: U | null} = r
  if q.v == null { 0 } else { 1 }
}

print(outer(5))
print(outer("s"))
print(readAfter(5))
print(outer(2.5))
print(outerOnly(5))
print(outerOnly("s"))
print(outerOnly(2.5))
