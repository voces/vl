// @run
// @log x
// @log 3
// @log 7
// @log true
// @info `b` is never reassigned; use `const` instead of `let`
// A generic handed to a parameter of the function's own type parameter, copied into a binding
// annotated with that type parameter and called there at two types, runs each call at its own type.
function same<T>(k: T): T { k }
function twice<T>(k: T): T { k }
function p<F>(a: F) {
  const b: F = a
  print(b("x"))
  print(b(3))
}
p(same)

function q<F>(a: F, n: i32) {
  let b: F = a
  const c: F = b
  print(c(n))
  print(c(true))
}
q(twice, 7)
