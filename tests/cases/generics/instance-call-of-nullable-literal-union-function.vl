// @run
// @log a
// @log a
// @log n
// @log true
// @log b
// @log none
// @log a!
// A hole or generic instance calling a function whose result is a nullable literal union reads
// the result as that union: it prints, narrows, coalesces, compares and widens to a string
// (D3198).
type R = { v: i32, f: () => "a" | "b" | null }
function F(z) {
  print(z.f())
  const x = z.f()
  if x != null { print(x) }
}
function C(z) { print(z.f() ?? "n") }
function G<Z>(z: Z) { print(z.f() == "a") }
function W(z): string | null { return z.f() }
function P<Z>(z: Z) {
  const xs: string[] = []
  const c = z.f()
  if c != null { xs.push(c) } else { print("none") }
  if xs.length > 0 { print(xs[0] + "!") }
}
const r: R = { v: 1, f: () => "a" }
const b: R = { v: 2, f: () => "b" }
const n: R = { v: 3, f: () => null }
F(r)
C(n)
G(r)
print(W(b) ?? "n")
P(n)
P(r)
