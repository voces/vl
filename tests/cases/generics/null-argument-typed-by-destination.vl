// @run
// @log true
// @log 7
// @log true
// @log 5
// @log 2
// @log none
// A bare `null` argument binds the type parameter from the destination's type wherever the
// parameter appears in the return, beside arguments that type holds (D4024).
type Item = { n: i32 }
type Box<T> = { v: T }
function mk<T>(x: T): T[] { [x] }
function box<T>(x: T): Box<T> { { v: x } }
function pair<T>(a: T, b: T): T[] { [a, b] }
function id<T>(x: T): T { x }
function nOf(i: Item | null) {
  if i == null { return -1 }
  i.n
}
const xs: (Item | null)[] = mk(null)
print(xs[0] == null)
xs[0] = { n: 7 }
print(nOf(xs[0]))
const b: Box<Item | null> = box(null)
print(b.v == null)
b.v = { n: 5 }
print(nOf(b.v))
const ps: (Item | null)[] = pair(null, { n: 2 })
print(nOf(ps[1]))
const o: Item | null = id(null)
if o == null { print("none") }
