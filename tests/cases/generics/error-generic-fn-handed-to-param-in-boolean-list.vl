// @check
// @error cannot assign ((T) => T)[] to 'zz' of type boolean[] (the body of `one` at the call's argument types)
// D14979 one level down: a generic function as the element of a `boolean[]`.
function id<T>(x: T): T { x }
function one<F>(a: F) {
  const zz: boolean[] = [a]
  print(zz.length)
}
one(id)
