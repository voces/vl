// @run
// @log 3
// @log true
// @log 1
// @log 2.5
// @log true
// @log true
// @log 2.5
// @log 7
// @log 2.5
// A record passed to a hole parameter binds its field functions at their own types when the
// body also reads a data field, a second function field or a nested record, and when a second
// instance of a nested record comes from a module binding (D3175).
function F(z) {
  print(z.v)
  const g = z.f
  print(g())
}
F({ v: 3, f: () => true })
function H(z) {
  print(z.h())
  const g = z.f
  print(g())
}
H({ f: () => 2.5, h: () => 1 })
function N(z) {
  const g = z.inner.f
  print(g())
}
N({ inner: { f: () => true } })
function B(z) {
  const g = z.f
  print(g())
  print(z.v)
}
B({ v: 2.5, f: () => true })
function M(z) { print(z.inner.f()) }
const r0 = { inner: { f: () => 7 } }
const r1 = { inner: { f: () => 2.5 } }
M(r0)
M(r1)
