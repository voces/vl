// @run
// @log 4
// @log z
// A binding annotated with a type parameter and seeded from a top-level generic is stored as the
// generic it holds, not at the type parameter's instance, beside a call of that parameter (D17870).
function same<T>(k: T): T { return k }
function other<T>(k: T): T { return k }
function mid2<F>(a: F) {
  const b: F = other
  print(a(4))
  print(b("z"))
}
mid2(same)
