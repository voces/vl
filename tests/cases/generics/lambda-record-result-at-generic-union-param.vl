// @run
// @log 1
// @log 7
// @log 7
// @log 7
// @log 7
// @log 4
// @log 9
// @log z
// @log 6
// @log 2
// @log 0
// @log w
// A record a lambda returns, at a generic's `() => T | string`, is boxed in the instance's
// `P | string`, though no annotation spells that union (D14082).
type P = {a: i32}
type Q = {b: string}
const p: P = { a: 1 }
function get<T>(f: () => T | string): T | string { return f() }
const r = get(() => p)
if r is string { print(r) } else { print(r.a) }
function called<T>(f: () => T | string) {
  const v = f()
  if v is string { return 0 }
  return 7
}
print(called(() => p))
function stored<T>(f: () => T | string) {
  const b = { v: f() }
  if b.v is string { return 0 }
  return 7
}
print(stored(() => p))
function id<U>(u: U): U { return u }
function handed<T>(f: () => T | string) {
  const v = id(f())
  if v is string { return 0 }
  return 7
}
print(handed(() => p))
function many<T>(fs: (() => T | string)[]) {
  const v = fs[0]()
  if v is string { return 0 }
  return fs.length + 6
}
print(many([() => p]))
function other<T>(f: () => T | Q): T | Q { return f() }
const o = other(() => ({ a: 4 }))
if o is Q { print(o.b) } else { print(o.a) }
function mk(n: i32): P { return { a: n } }
const m = get(() => mk(9))
if m is string { print(m) } else { print(m.a) }
const s = get(() => "z")
if s is string { print(s) } else { print(0) }
function opt<T>(f: () => T | string | null): T | string | null { return f() }
const n = opt(() => 5)
if n is string { print(n) }
else if n == null { print(0) }
else { print(n + 1) }
const q = opt(() => ({ a: 2 }))
if q is string { print(q) }
else if q == null { print(0) }
else { print(q.a) }
const z = opt((): i32 | null => null)
if z is string { print(z) }
else if z == null { print(0) }
else { print(z) }
const w = opt(() => "w")
if w is string { print(w) } else { print(1) }
