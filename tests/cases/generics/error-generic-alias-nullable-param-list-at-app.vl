// @emit-error a nullable-GB<i32> list element has no rep; use a non-null element type
// D2525's boundary for a generic record: a `(V | null)[]` field applied at a generic application
// built a list literal's `null` element at the wrong rep (check-clean invalid wasm). The
// concrete field (`xs: (GB<i32> | null)[]`) runs; this application stays refused.
type GB<T> = { v: T }
type Bx<V> = { xs: (V | null)[], n: i32 }
const bx: Bx<GB<i32>> = { xs: [null, { v: 11 }], n: 1 }
print(bx.xs.length)
