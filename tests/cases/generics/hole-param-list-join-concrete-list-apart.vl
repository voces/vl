// @run
// @log 2
// @log 2.5
// @log 2
// @log s
// @log 2
// @log 3
// A hole parameter's list returned beside a concrete `i32[]` stays apart from it, as `T[]`
// does, so each pin builds its own list beside the `i32[]` arm (D4882).
function w(t, b: boolean, q: i32[]) {
  if b { return [t] }
  q
}

const q = [5, 6]
const v = w(2.5, false, q)
print(v.length)
for e in w(2.5, true, q) { print(e) }
const s = w("s", false, q)
print(s.length)
for e in w("s", true, q) { print(e) }
const n: i32 | null = 3
const m = w(n, false, q)
print(m.length)
for e in w(n, true, q) { print(e) }
