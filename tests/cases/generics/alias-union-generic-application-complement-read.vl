// @run
// @log 2
// @log 3
// @log 3
// D14302: the `else` of `w is Tag` over `type U = Box<i32> | Tag` leaves the `Box<i32>` arm, and
// its field read finds that arm's variant row by shape, at a global, a reassigned global and a
// local.
type Box<T> = { v: T }
type Tag = { t: i32 }
type U = Box<i32> | Tag

const g: U = { v: 2 }
if g is Tag { print(g.t) } else { print(g.v) }
let w: U = { v: 2 }
w = { t: 3 }
if w is Tag { print(w.t) } else { print(w.v) }
function main() {
  let l: U = { v: 2 }
  l = { t: 3 }
  if l is Tag { print(l.t) } else { print(l.v) }
}
main()
