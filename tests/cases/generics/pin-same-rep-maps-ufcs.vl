// @run
// @log false
// @log true
// A member call (UFCS) reaches the same instance test as a direct call.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
const mb: BM = Map()
mb.set(1, true)
const v: IM | BM = mb
function isIm<T>(self: T) { self is IM }
print(v.isIm())
const mi: IM = Map()
const v2: IM | BM = mi
print(v2.isIm())
