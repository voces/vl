// @check
// @hint redundant type annotation: `xs` is inferred as `string[]`
// @error cannot assign i32[] to 'xs' of type string[] (the body of `decl` at the call's argument types)
// @error cannot assign i32[] to string[] (the body of `write` at the call's argument types)
// @error cannot assign i32[][] to 'xs' of type string[][] (the body of `nested` at the call's argument types)
// @error cannot assign {v: i32}[] to 'xs' of type Bx[] (the body of `arrobj` at the call's argument types)
// @error cannot assign {v: i32[]} to 'b' of type Bx2 (the body of `objarr` at the call's argument types)
// @error cannot assign i32 to string (the body of `joined` at the call's argument types)
// @error cannot assign i32[] to 'xs' of type string[] (the body of `outer` at the call's argument types)
// @error cannot assign i32[] to 'xs' of type string[] (the body of `decl` at the call's argument types)
// WHERE A HOLE LANDS INSIDE A LITERAL CONTAINER (silent-class-inventory D581).
//
// D572 wired the destination seam of a generic body to a pin, and one spelling survived it:
// the value lands inside an ARRAY LITERAL aimed at the destination. The constraint IS
// recorded and IS re-asked — what failed is the PREDICATE. `assignableExpr`'s array-literal
// recursion read each element's type off `nodeTyIxOf(elem)`, the element NODE's own record,
// which at the pin still carries the UN-SUBSTITUTED hole; so `assignable(T, string)` waved
// every element past and the substituted `i32[]` vs `string[]` never decided anything. Its
// ObjLit sibling twenty lines up reads `objFieldType(srcTy, name)` — off the SUBSTITUTED
// container — which is the entire reason `const b: Bx = { v: self }` has always been a loud
// reject inside a generic while `const xs: string[] = [self]` was check-clean INVALID WASM.
//
// `joined` IS A SECOND MECHANISM, not a second spelling of the first, and its DECLARED hint
// is the evidence: `["a", self]` joins `string` with `T` through `joinTys`, a hole is
// permissively assignable BOTH ways, and the mutual-assignability collapse DROPS the hole —
// so the literal's own type IS `string[]` (hence "redundant annotation") and the
// container-level pair has no hole for the pin to resolve. That one is asked per SLOT, which
// is also why its message names the slot's types and not the collection's.
//
// Every line has a DIRECT twin that differs in exactly one thing (the type parameter written
// out as the argument's own type) and is a loud reject on every seed;
// `scripts/silent-sweep/d581/litgrid.py` grades all 1,410 of them BY VALUE — the worst cell
// in this family is not invalid wasm but a program that VALIDATES and prints `false` for an
// i32, because i32 and boolean share a rep.
type Bx = { v: string }
type Bx2 = { v: string[] }

// The declaration seam, and the write seam, which adopt the same way.
function decl<T>(self: T) {
  const xs: string[] = [self]
  return xs[0]
}
function write<T>(self: T) {
  let xs: string[] = []
  xs = [self]
  return xs[0]
}
// Nested one level, and through each literal kind's element / field.
function nested<T>(self: T) {
  const xs: string[][] = [[self]]
  return xs[0][0]
}
function arrobj<T>(self: T) {
  const xs: Bx[] = [{ v: self }]
  return xs[0].v
}
function objarr<T>(self: T) {
  const b: Bx2 = { v: [self] }
  return b.v[0]
}
// THE JOIN-DROPPED HOLE: a well-typed element beside the hole-typed one.
function joined<T>(self: T) {
  const xs: string[] = ["a", self]
  return xs[1]
}
// THE TWO-LEVEL RELAY. The inner call substitutes the constraint's hole to ANOTHER hole and
// must re-record it under the caller, or the outer call never re-asks it.
function inner<T>(self: T) {
  const xs: string[] = [self]
  return xs[0]
}
function outer<U>(self: U) {
  return inner(self)
}

print(decl(6))
print(write(6))
print(nested(6))
print(arrobj(6))
print(objarr(6))
print(joined(6))
print(outer(6))
// AND THE METHOD SPELLING, which is a DIFFERENT PIN: wiring only the direct-call one leaves
// `p.decl()` silent beside a loud `decl(p)`, the asymmetry D401, D551 and D572 each had to
// fix after the fact.
const p = 6
print(p.decl())
