// A hole list's `.map` or `.filter` result, and a list bound from one, holds `string | null`
// at that pin, so reading a `null` element keeps it rather than recovering non-null (D3089).
function f(x) {
  print([x].map((_e) => x)[0])
  print([x].filter((_e) => true)[0])
  const m = [x].map((e) => e)
  print(m[0])
}
const v0: string | null = null
f(v0)
function g(x) {
  for y in [x].map((e) => e) { print(y) }
}
const v1: string | null = "s"
g(v1)
g(v0)
