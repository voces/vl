// @run
// @hint redundant type annotation: `x` is inferred as `U` — remove it to lean on inference
// @log true
// @log false
// @log false
// @log true
// @log A
// @log true
// At a `T | null` pin the test reads the map the pin was taken from, not its spelling, which
// renders a Set as its boolean map and a literal-union value by its base (D2493): a Set niche is
// its own type and not the boolean map, and a literal-union map is not the string-valued map.
type L = "p" | "q"
function s<T>(u: T | null) { u is Set<i32> }
function b<T>(u: T | null) { u is {[i32]: boolean} }
function l<T>(u: T | null) { u is {[i32]: string} }
function l2<T>(u: T | null) { u is {[i32]: L} }
const st: Set<i32> = Set()
st.add(3)
print(s<Set<i32>>(st))
print(b<Set<i32>>(st))
const m: {[i32]: L} = Map()
m.set(3, "p")
print(l<{[i32]: L}>(m))
print(l2<{[i32]: L}>(m))
// A union of two identical map types is one member, whose `| null` stays the map's niche.
type A = {[i32]: i32}
type B = {[i32]: i32}
type U = A | B
const a: A = Map()
const c = a.length
const y: U | null = if c == 0 { a } else { null }
const x: U = y ?? a
function w(v: U | null) {
  if v == null { return "N" }
  "A"
}
print(w(x))
print(y != null)
