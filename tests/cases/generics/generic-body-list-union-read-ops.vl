// @log z
// @log 2
// @log 3
// `.length`, `u[i]` and `for … in u` over a generic body's inferred `T[] | i32[]`, at every
// pin: each read is the narrowed `is` chain, its bindings typed as the checker typed them and
// its last member tested too, since a complement cannot narrow a type parameter's list.
type P = { x: i32 }

function w<T>(t: T, b: boolean) {
  if b { return [t, t] }
  [1, 2, 3]
}

function lenOfCall<T>(t: T, b: boolean) { print(w(t, b).length) }

function len<T>(t: T, b: boolean) {
  const v = w(t, b)
  print(v.length)
}

function lenArith<T>(t: T, b: boolean) {
  const v = w(t, b)
  const k = v.length + 10
  print(k)
}

function count<T>(t: T, b: boolean) {
  const v = w(t, b)
  let c = 0
  for x in v { c = c + 1 }
  print(c)
}

function idxSum<T>(t: T, b: boolean) {
  const v = w(t, b)
  let s = 0
  for x, i in v { s = s + i }
  print(s)
}

function first<T>(t: T, b: boolean) {
  const v = w(t, b)
  const e = v[0]
  if e is i32 { print("I") } else { print(e) }
}

function complement<T>(t: T, b: boolean) {
  const v = w(t, b)
  const e = if v is i32[] { t } else { v[0] }
  print(e)
}

len("s", true)
lenArith(2.5, false)
count(true, false)
idxSum({ x: 1 }, true)
len({ x: 1 }, true)
len(7, false)
first(2.5, true)
count("s", true)
first(true, true)
idxSum(7, true)
first("ada", true)
first(7, true)
complement("z", true)
complement(1.5, true)
first("z", true)
lenOfCall(3, true)
lenOfCall("s", false)
