// @run
// @log 1.5
// @log 2.5
// @log 1.5
// @log 3.5
// @log 1.5
// A `??` of a type parameter's nullable list and a float literal list, pinned at `f32`: the result
// is held at the pin's list storage, its default built there, as legacy keeps it. Returned, bound,
// passed on, and at an `f64` pin beside it.
function gt<T>(xs: T[] | null) { return xs ?? [1.5] }
function bound<T>(xs: T[] | null) {
  const r = xs ?? [1.5]
  return r
}
function first(ys: f32[]) { return ys[0] }
function passed<T>(xs: T[] | null) { return xs ?? [1.5] }
print(gt<f32>(null)[0])
const v: f32[] = [2.5]
print(gt<f32>(v)[0])
print(bound<f32>(null)[0])
print(first(passed<f32>([3.5])))
print(gt<f64>(null)[0])
