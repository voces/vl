// @run
// @log 1
// @log 1
// @log 2
// @log 1
// @log 7
// @hint redundant type annotation: `gl` is inferred as `{r: i32[]}[]`
// @hint Intentionally-unused variable `_m1`
// @hint Intentionally-unused variable `_d`
// Legs 1 and 2 bind their result and never read it ON PURPOSE: what they measure is whether
// the CALL can be monomorphized at all, and reading the result would add a second question.
// THE PIN LADDER IS THE SAME LADDER AT EVERY SCOPE — D703, and legs 1 to 4 were each
// `emitProgram: monomorphize: unsupported argument type` on the parent.
//
// `monoArgTyName` reads an argument's pin from an ANNOTATION whenever it can, because
// mid-monomorphization the rep classifiers are blind (`buildLocals` is post-mono). It had
// three arms for that: an annotated LOCAL, a PARAM, and — behind `fnIx < 0` — a module-scope
// GLOBAL. The first two ask the whole membership list (`monoAnnPinName`); the third asked two
// rungs of it, added one defect at a time, and was switched off entirely inside a function.
//
// WHAT THAT COST, one leg each:
//   1. A UNION global at module scope. `monoAnnPinName`'s `isUName` rung names it `U` in one
//      line; the global arm did not ask, so the pin was "" and the call took the loud floor —
//      while the same binding declared as a LOCAL compiled, and the NON-generic twin
//      `function idg(x: U): U` runs.
//   2. The same global read from INSIDE a function, where `monoGlobalLetOf` declined on
//      `fnIx >= 0` outright. Its reason — "a function-scoped binding of the same name SHADOWS
//      the global" — is right about shadowing and could not tell it apart from "this name is
//      not a local at all". It declines on the shadow test itself now.
//   3. A COMPOSITE-LIST global read from inside a function: the one spelling the old two-rung
//      ladder DID claim, refused anyway because of the scope switch. The `{r: i32[]}[]`
//      annotation the hint names is LOAD-BEARING — un-annotated it is leg 4's case, not this
//      one.
//   4. An UN-ANNOTATED global, whose type only its INITIALIZER knows, at both scopes. The
//      local arm has recursed into `letInit` since it was written; the global arm had no such
//      rung.
//
// LEG 5 IS THE SHADOW TEST ITSELF: a PARAMETER named `sh` shadows the `{r: i32[]}[]` global,
// and the pin must be the parameter's `i32`. If the global scan ran ahead of the shadow test
// the instance would declare a ref parameter over an i32 caller — invalid wasm. Master and
// this build agree on it character for character, which is the point: the widening is a
// widening of WHEN the global is consulted, not of what wins.
//
// (The LOCAL-shadow twin of leg 5 is `error-pin-global-shadowed-by-local.vl`, which stays a
// loud reject on both builds.)
type U = i32 | string

function idg<T>(x: T): T { return x }

const gu: U = 1
const gl: {r: i32[]}[] = [{ r: [1, 2] }, { r: [1, 2] }]
const inner = [7]
const ginf = [inner]

// leg 1 — union global, call at MODULE scope
const _m1 = idg(gu)
print(1)

function leg2() {
  // leg 2 — the same union global, call INSIDE a function
  const _d = idg(gu)
  print(1)
}
leg2()

function leg3() {
  // leg 3 — composite-list global, call inside a function
  const d = idg(gl)
  print(d.length)
}
leg3()

// leg 4 — un-annotated global (`i32[][]`), module scope then function scope
const m4 = idg(ginf)
print(m4[0].length)

function leg5(sh: i32) {
  // leg 5 — a PARAMETER shadows a global of a different rep; the pin is the parameter's
  print(idg(sh))
}
leg5(7)
