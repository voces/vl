// @run
// @log 3
// @log ab
// @log 4
// @log cd
// @log 5
// @log ef
// @hint Intentionally-unused parameter `_x`
// An un-annotated list a generic body pushes a generic function onto, returned and read at two
// instances, holds at each instance the signatures its callers call its elements at (D17729).
function id<T>(x: T): T { return x }
function run<T>(_x: T) {
  const rs = []
  rs.push(id)
  return rs
}
print(run(3)[0](3))
print(run("ab")[0]("ab"))
const a = run(4)
print(a[0](4))
const b: ((x: string) => string)[] = run("cd")
print(b[0]("cd"))
for f in run(5) { print(f(5)) }
print(run("ef").map((g) => g("ef"))[0])
