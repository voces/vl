// @error i32[] is not f64[]: a container never widens implicitly
// D5002: an existing `V[]` handed back by a generic identity and delivered to an `f64[]` parameter
// is refused at the `i32` pin, as the direct spelling is; a list method's fresh result is
// converted instead (D4983).
function sumF(xs: f64[]) { print(xs.length) }
function idL<W>(xs: W[]): W[] { xs }
function t<V>(q: V[]) { sumF(idL(q)) }
t([1])
