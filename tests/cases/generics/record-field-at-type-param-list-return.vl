// @log 6
// @log 2.5
// @log b
// @log 6
// @log 6
// @log 6
// @log 6
// @log 1
// @log 1
// @log 6
// @log 7
// @log 7
// D4683: a generic function whose list of records has a field typed `T` builds each
// instance's row, whether the list comes from `.map`, a literal or `push`, is returned
// inferred, through a local or annotated, or is read where it is built.
type W<T> = { v: T, n: i32 }

function wrap<T>(xs: T[]) { return xs.map((e) => { v: e, n: 1 }) }
function viaLocal<T>(xs: T[]) {
  const ys = xs.map((e) => { v: e, n: 1 })
  return ys
}
function annotated<T>(xs: T[]): W<T>[] { return xs.map((e) => { v: e, n: 1 }) }
function pushed<T>(xs: T[]): W<T>[] {
  const out: W<T>[] = []
  for x in xs { out.push({ v: x, n: 1 }) }
  return out
}
function one<T>(x: T) { return [{ v: x, n: 1 }] }
function localAnn<T>(x: T) {
  const ws: W<T>[] = [{ v: x, n: 1 }]
  print(ws.length)
}
function localInline<T>(x: T) {
  const ws: { v: T, n: i32 }[] = [{ v: x, n: 1 }]
  print(ws[0].n)
}
function boundLocal<T>(x: T) {
  const ws = [{ v: x, n: 1 }]
  return ws
}
function firstV<T>(ws: W<T>[]): T { return ws[0].v }

print(wrap([5, 6])[1].v)
print(wrap([1.5, 2.5])[1].v)
print(wrap(["a", "b"])[1].v)
print(viaLocal([5, 6])[1].v)
print(annotated([5, 6])[1].v)
print(pushed([5, 6])[1].v)
print(one(6)[0].v)
localAnn(7)
localInline(7)
print(boundLocal(6)[0].v)
const xs: W<i32>[] = [{ v: 7, n: 1 }]
print(firstV(xs))
print(firstV(annotated([7])))
