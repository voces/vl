// @run
// @log 7
// @log 11
// @log v
// @log 10
// @log 7
// @log 11
// @log v
// @log 10
// @log 11
// @log absent
// @hint Intentionally-unused parameter `_n`
// A NULLABLE closure (`(() => i32) | null`, kind 19) bound to a bare type parameter — the
// union spelling of the closure-through-a-generic family.
//
// IT FAILED IN TWO DIFFERENT WAYS FOR ONE REASON, and the split is what named the fix.
// `monoArgTyName` has three channels and a nullable function type crossed none of them:
// `nodeTyIsFunc` is FALSE for a `TyNullable` (that predicate's own header says so), the
// annotation ladder declines a closure spelling, and `exprIsClosure` reads post-mono
// tables — but its MODULE-scope arm (`globalCellKind` → "nulclosure") does answer. So a
// top-level nullable closure reached the closure arm and was floored loudly, while the
// identical program inside a function went blind and took the cascade's `"i32"` catch-all:
// an i32 parameter over a `(ref null $cloStruct)`, `vl check` clean, INVALID WASM.
//
// THE PIN IS THE SPELLING, NOT THE `$fnsig` MARKER, and that is deliberate. A bare closure
// pins `"=>i>i"` because a bare function type had no annotation form an instance could
// carry; a nullable one does — `((i32) => i32) | null` is a parameter annotation the
// emitter lowers end to end already. `tyToEmitName` is the render that GROUPS the arrow,
// which is what makes the pin round-trip: the ungrouped `(i32)=>i32|null` re-parses as a
// function RETURNING `i32 | null`, a different type and a different instance.
function gid<T>(x: T): T { return x }

// ── module scope ──
const n0: (() => i32) | null = () => 7
const n1: ((i32) => i32) | null = (n) => n + 1
const n2: ((i32) => string) | null = (_n) => "v"
const n3: ((i32) => i32[]) | null = (n) => [n, n]
const r0 = gid(n0)
const r1 = gid(n1)
const r2 = gid(n2)
const r3 = gid(n3)
if r0 != null { print(r0()) }
if r1 != null { print(r1(10)) }
if r2 != null { print(r2(10)) }
if r3 != null { print(r3(10)[0]) }

function body() {
  // ── the same four inside a function, where every channel but this arm is blind ──
  const f0: (() => i32) | null = () => 7
  const f1: ((i32) => i32) | null = (n) => n + 1
  const f2: ((i32) => string) | null = (_n) => "v"
  const f3: ((i32) => i32[]) | null = (n) => [n, n]
  const q0 = gid(f0)
  const q1 = gid(f1)
  const q2 = gid(f2)
  const q3 = gid(f3)
  if q0 != null { print(q0()) }
  if q1 != null { print(q1(10)) }
  if q2 != null { print(q2(10)) }
  if q3 != null { print(q3(10)[0]) }

  // Through a generic FORWARDER, the shape whose inner call reads the pin off the
  // instance's own substituted annotation.
  const w = gwrap(f1)
  if w != null { print(w(10)) }

  // The `null` INHABITANT actually travelling through the instance — the pin has to carry
  // the `| null`, or this traps (or narrows wrong) inside the callee.
  const e: ((i32) => i32) | null = null
  const qe = gid(e)
  if qe != null { print(qe(10)) } else { print("absent") }
}
function gwrap<T>(x: T): T { return gid(x) }
body()
