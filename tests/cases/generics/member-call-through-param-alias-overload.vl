// @run
// @log 3
// @log 1
// @log 3
// @info `v` is never reassigned; use `const` instead of `let`
// An overloaded member call through a local that only ever holds an un-annotated parameter picks
// its candidate per instance, as the call on the parameter does (D3818).
import { lastIndexOf } from "std:array"
import { lastIndexOf } from "std:str"

function take(a) {
  const v = a
  print(v.lastIndexOf(2))
}
function viaLet(a) {
  let v = a
  print(v.lastIndexOf("b"))
}
take([1, 2, 3, 2])
viaLet("abc")
take([2, 0, 0, 2])
