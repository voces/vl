// @run
// @log 5
// @log x
// @log 7
// @log y
// @log 4
// @log 8
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// A generic body handing its type parameter to a concrete parameter defers that demand to the
// call. It belongs to that one body: `show`'s `toString(self)` is no demand on `third`'s `T`,
// though both are spelled `T`, at the direct and the method spelling alike (D2424).

import { toString } from "std:fmt"

function show<T>(self: T) { return toString(self) }
function third<T>(_a: i32, b: T) { return b }
function twice<T>(self: T, _a: i32) { return self }
function inc<T>(self: T) { return g(self) }
function g(n: i32) { return n + 1 }
print(show(5))
print(third(1, "x"))
print((7).show())
print("y".twice(1))
print((3).inc())
print(inc(7))
