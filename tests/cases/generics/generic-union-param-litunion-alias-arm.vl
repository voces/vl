// A generic's `T | i32` parameter bound to a literal-union alias boxes under its own union
// row (D5310): `==` and `is` over it run with `T` inferred and explicit, from an un-annotated
// binding, through a forwarding function, as a list element and at a nullable spelling.
type K = "x" | "y"
function same<T>(p: T | i32, q: T | i32) { p == q }
const k: K = "x"
const j: K = "y"
print(same(k, k))
print(same(k, j))
print(same<K>(k, 3))
print(same<K>(k, k))
function show<T>(p: T | i32) {
  if p is i32 { return "i" }
  "k"
}
print(show<K>(3))
print(show<K>(j))
print(show(k))
function pick(b: boolean): K {
  if b { return "x" }
  "y"
}
function wrap(a: K, b: K) { same(a, b) }
const a = pick(true)
const b = pick(false)
const out = [same(a, b), wrap(a, a), same(a, pick(true))]
print(out[0])
print(out[1])
print(out[2])
function nul<T>(p: T | i32 | null, q: T | i32 | null) { p == q }
print(nul(k, k))
print(nul(k, null))
