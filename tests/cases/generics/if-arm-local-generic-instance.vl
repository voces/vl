// @run
// @log 1
// @log y
// @log 1.5
// @log x
// @log 2.5
// @log 1
// @log x
// @log 1.5
// @log x
// @log x
// A generic instance's if-expression whose arm yields a local of its own prelude: the join and
// the binding read that local's slot, and a generic call handed the expression pins at the
// local's initializer, so no instance takes the type parameter's i32 default (D2821).
function id<T>(x: T): T { x }
function bind<T>(c: boolean, a: T, b: T): T {
  const r = if c { const w = a; w } else { const z = b; z }
  r
}
function ret<T>(c: boolean, a: T, b: T): T {
  return if c { const w = a; w } else { b }
}
function arg<T>(c: boolean, a: T, b: T): T {
  id(if c { const w = a; w } else { b })
}
function elem<T>(c: boolean, a: T, b: T): T[] {
  [if c { const w = a; w } else { b }, b]
}
function push<T>(c: boolean, a: T, b: T): T[] {
  const xs: T[] = []
  xs.push(if c { const w = a; w } else { b })
  xs
}
print(bind(true, 1, 2))
print(bind(false, "x", "y"))
print(bind(true, 1.5, 2.5))
print(ret(true, "x", "y"))
print(ret(false, 1.5, 2.5))
print(arg(true, 1, 2))
print(arg(true, "x", "y"))
print(elem(true, 1.5, 2.5)[0])
print(elem(true, "x", "y")[0])
print(push(true, "x", "y")[0])
