// @run
// @log 15
// @log 15
// @log 15
// @log 60
// @log 60
// @log 11
// @log 11
// @log 19
// @log 19
// @log 17
// @log 17
// @log 15
// @log 15
// The two positions the per-instance copy of the generic-call spine did not reach: the TARGET of a
// compound assignment (`vals[idx(xs, 0)] += 5`) and the whole PREFIX `++`/`--` form
// (`++vals[idx(xs, 0)]`). Both desugar to `target = (target op value)` with the target node SHARED
// between the read and the write, so the copy re-synthesized the form from its parts — but passed
// the target through untouched, on the reading that only the value limb can carry a generic call.
// An INDEX or MEMBER target carries one, so every instance kept one callee `Ident`: the last
// element type to instantiate won, the earlier instances called the wrong shape, and revisiting
// the renamed node trapped the compiler outright (`out of bounds array access`).
//
// One case per assignment form, each at two element types — one instance alone never reproduced it
// — plus a three-type cell, a target and a value limb carrying a call at once, and a MEMBER target
// whose receiver is the indexed one. POSTFIX `x++` is absent by construction: the parser accepts a
// postfix target only when it is an identifier, which holds no call.

// The generic the targets below call: an index clamped against the ELEMENT list, so `T` is what
// the instances differ by even though the answer is always an `i32`.
function idx<T>(xs: T[], i: i32): i32 {
  if i < xs.length { return i }
  return 0
}

function bumpAdd<T>(xs: T[], vals: i32[]): i32 {
  vals[idx(xs, 0)] += 5
  return vals[0]
}

function bumpMul<T>(xs: T[], vals: i32[]): i32 {
  vals[idx(xs, 1)] *= 3
  return vals[1]
}

function bumpPre<T>(xs: T[], vals: i32[]): i32 {
  ++vals[idx(xs, 0)]
  return vals[0]
}

function bumpDec<T>(xs: T[], vals: i32[]): i32 {
  --vals[idx(xs, 1)]
  return vals[1]
}

function bumpBoth<T>(xs: T[], vals: i32[]): i32 {
  vals[idx(xs, 0)] += idx(xs, 1) * 7
  return vals[0]
}

type Cell = { n: i32 }

function bumpField<T>(xs: T[], cs: Cell[]): i32 {
  cs[idx(xs, 0)].n += 5
  return cs[0].n
}

function fresh(): i32[] { return [10, 20] }

function go() {
  const a: i32[] = [1, 2]
  const b: string[] = ["x", "y"]
  const c: f64[] = [1.5, 2.5]

  print(bumpAdd(a, fresh())) // 15
  print(bumpAdd(b, fresh())) // 15
  print(bumpAdd(c, fresh())) // 15
  print(bumpMul(a, fresh())) // 60
  print(bumpMul(b, fresh())) // 60
  print(bumpPre(a, fresh())) // 11
  print(bumpPre(b, fresh())) // 11
  print(bumpDec(a, fresh())) // 19
  print(bumpDec(b, fresh())) // 19
  print(bumpBoth(a, fresh())) // 17
  print(bumpBoth(b, fresh())) // 17

  const c1: Cell[] = [{ n: 10 }]
  const c2: Cell[] = [{ n: 10 }]
  print(bumpField(a, c1)) // 15
  print(bumpField(b, c2)) // 15
}

go()
