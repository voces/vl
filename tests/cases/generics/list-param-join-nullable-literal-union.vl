// @log true
// A join of two list elements, one `i32 | null` and one `K | null`, boxes the bound `K | null`
// local as its member string, in an instance whose function declares no return (D3357).
type K = "a" | "b"
const x0: i32 | null = null
const x1: K | null = "a"
function g<T, U>(xs: T[], ys: U[], k: i32) {
  const a = xs[0]
  const b = ys[0]
  const r = if k == 0 { a } else { b }
  print(r == null)
  print(r is string)
  print(r is null)
  print(r is K)
}
g([x0], [x1], 0)
g([x0], [x1], 1)
