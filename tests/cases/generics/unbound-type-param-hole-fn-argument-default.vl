// @run
// @log 2
// @log 3
// @log 7
// @log 2
// @log 3.5
// @log 4294967297
// @log 2
// @hint Intentionally-unused parameter `_f`
// A type parameter only an un-annotated function argument reaches is bound by nothing at the
// call and takes the `i32` default there; a type argument, another argument or a destination
// binds it otherwise (D16412).
function hinc(x) { return x + 1 }
function sel<A>(f: (x: A) => A): (x: A) => A { return f }
function compose<A, B, C>(f: (x: A) => B, g: (x: B) => C): (x: A) => C { return (x: A) => g(f(x)) }
function cnt<A, B>(_f: (x: A) => B) { return 7 }
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
print(sel(hinc)(1))
print(compose(hinc, hinc)(1))
print(cnt((x) => x + 1))
print(sel((x) => x * 2)(1))
print(app(hinc, 2.5))
print(sel<i64>(hinc)(4294967296))
const k: (x: i32) => i32 = sel(hinc)
print(k(1))
