// @run
// A generic call whose argument is an INDEXED ELEMENT (`gid(xs[0])`) pins its type
// parameter from the ARRAY's own pin name minus one `[]`.
//
// THE AXIS IS THE ELEMENT SPELLING, NOT THE FORWARDING. `monoArgTyName` names the array
// itself through the annotation ladder (`monoAnnPinName`), which claims maps, Sets,
// scalars, scalar lists, composite-element lists, struct arrays and `boolean[]`. Its
// `Index` arm then cut the `[]` off that answer and accepted the element only when
// `isSName` claimed it — a STRUCT. Every other element the array arm had ALREADY named
// fell past it to the `"i32"` catch-all, so the instance declared an i32 parameter over a
// map / Set / nested-list / struct-array body: `vl check` clean, INVALID WASM
// ("current function requires result type [(ref …)] but callee returns [i32]"), or a loud
// `monomorphize: unsupported argument type` where the catch-all could not even be lowered.
// The element now goes through the SAME home the array went through, so the two ends of
// one cut cannot claim different spelling sets.
//
// WHAT MOVES, measured over a 26-rep x 10-shape grid (260 cells), each cell its own
// compile: 119 -> 192 correct, 73 moved, 0 backward.
//   * the ELEMENT REP. Six map/Set spellings, `i32[][]`, `string[][]` and `S[]` failed;
//     `string`, `i32`, `f32`, `f64`, `boolean`, `i32[]`, `string[]`, `f64[]`, `f32[]`,
//     `i64[]`, `boolean[]`, `K[]` and a bare struct were already correct, because for a
//     PARAMETER those have their own `param*` annotation probe in the cascade below.
//   * WHERE THE INDEXED BINDING LIVES, which is the wider half: through a `T[]`-annotated
//     LOCAL every non-i32 rep failed, a local having no such probe. Through the parameter
//     only the reps above did.
//   * NOT the nesting depth (two levels and three alike), NOT the arity, NOT whether the
//     index is the literal `0` or a variable, NOT whether the forwarder returns `T` or a
//     concrete type.
// CONTROLS, and they are why the axis is the element and not the generic forwarder: a
// CONCRETE forwarder over the same element moved too, and so did the no-forwarder
// `gid(a[0])` call — neither has a `T` anywhere.
//
// STILL OPEN, each measured on the same grid and each a different site: an `i64` ELEMENT
// is check-clean invalid wasm at every shape whose index is the literal `0` (the pin is
// correct — `i64` — but the i64 argument context reaches the array index, which emits
// `i64.const 0` into an i32 bounds check; a plain `f(a[0])` at a concrete `i64` parameter
// fails identically, with no generic in the file); a `T[][]` parameter, a module-GLOBAL
// array argument, a litunion `K` element and a struct-union element are loud rejects at
// the OUTER call's array binding.
//
// @hint Intentionally-unused parameter `_n`
// @hint Intentionally-unused variable `_y`
// @hint redundant type annotation: `gtakeI` is inferred as `i32`
// @hint redundant type annotation: `ys` is inferred as `T[]`
// @hint redundant type annotation: `asi` is inferred as `{[string]: i32}[]`
// @hint redundant type annotation: `ais` is inferred as `{[i32]: string}[]`
// @hint redundant type annotation: `ass` is inferred as `{[string]: string}[]`
// @hint redundant type annotation: `aif` is inferred as `{[i32]: f64}[]`
// @hint redundant type annotation: `nested` is inferred as `i32[][][]`
// @hint redundant type annotation: `strNested` is inferred as `string[][][]`
// @hint redundant type annotation: `structArr` is inferred as `{x: i32}[][]`
// @hint redundant type annotation: `ps` is inferred as `{x: i32}[]`
// @hint redundant type annotation: `ms` is inferred as `{[string]: i32}[]`
// @hint redundant type annotation: `ss` is inferred as `string[]`
// @hint redundant type annotation: `ds` is inferred as `f64[]`
// @hint redundant type annotation: `xs` is inferred as `i32[][]`
// @hint redundant type annotation: `bs` is inferred as `boolean[][]`
function gid<T>(x: T): T { return x }
function gwrap<T>(x: T): T { return gid(x) }

// The forwarder: it hands an element read of its OWN `T[]` parameter to a second generic.
function gtake<T>(xs: T[]): T { return gid(xs[0]) }
// Three generic levels — depth is not the axis.
function gtake3<T>(xs: T[]): T { return gwrap(xs[0]) }
// Arity 2, with a second type param that never reaches the inner call.
function gtake2<T, U2>(xs: T[], _n: U2): T { return gid(xs[0]) }
// The index is a VARIABLE rather than the literal `0`.
function gtakeV<T>(xs: T[], i: i32): T { return gid(xs[i]) }
// The forwarder's return is CONCRETE — `T` in parameter position only.
function gtakeI<T>(xs: T[]): i32 {
  const _y = gid(xs[0])
  return 1
}
// The indexed binding is a `T[]`-ANNOTATED LOCAL of the generic body, not the parameter.
// This is the wider half of the axis: a local carries no `param*` probe for the cascade.
function gtakeL<T>(xs: T[]): T {
  const ys: T[] = xs
  return gid(ys[0])
}
// CONTROL: a CONCRETE forwarder over a map element — no `T` anywhere, and it failed too.
function ctake(xs: {[string]: i32}[]): {[string]: i32} { return gid(xs[0]) }

// ── the six map / Set element spellings ───────────────────────────────────────
// Both KEY flavours and four VALUE reps: the value rep does not move the answer.
function maps() {
  const msi: {[string]: i32} = Map()
  msi["a"] = 1
  const asi: {[string]: i32}[] = [msi]
  // @log 1
  print(gtake(asi).length)
  const mis: {[i32]: string} = Map()
  mis[1] = "a"
  const ais: {[i32]: string}[] = [mis]
  // @log 1
  print(gtake(ais).length)
  const mss: {[string]: string} = Map()
  mss["a"] = "b"
  const ass: {[string]: string}[] = [mss]
  // @log 1
  print(gtake(ass).length)
  const mif: {[i32]: f64} = Map()
  mif[1] = 1.5
  const aif: {[i32]: f64}[] = [mif]
  // @log 1
  print(gtake(aif).length)
  const sst: {[string]: boolean} = Set()
  sst.add("a")
  const ast: {[string]: boolean}[] = [sst]
  // @log 1
  print(gtake(ast).length)
  const sit: {[i32]: boolean} = Set()
  sit.add(1)
  const ait: {[i32]: boolean}[] = [sit]
  // @log 1
  print(gtake(ait).length)
}
maps()

// ── composite ELEMENTS the array arm named and the element cut declined ────────
type P = { x: i32 }

function composites() {
  const nested: i32[][][] = [[[1, 2], [3]]]
  // @log 2
  print(gtake(nested).length)
  const strNested: string[][][] = [[["a"]]]
  // @log 1
  print(gtake(strNested).length)
  const structArr: P[][] = [[{ x: 7 }, { x: 8 }]]
  // @log 2
  print(gtake(structArr).length)
  // a BARE struct element still resolves through the arm that always claimed it.
  const ps: P[] = [{ x: 7 }]
  // @log 7
  print(gtake(ps).x)
}
composites()

// ── the dimensions the grid moved and found FLAT, on one map element ───────────
function flatShapes() {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m["b"] = 2
  const ms: {[string]: i32}[] = [m]
  // three generic levels
  // @log 2
  print(gtake3(ms).length)
  // arity 2
  // @log 2
  print(gtake2(ms, 1).length)
  // a VARIABLE index
  // @log 2
  print(gtakeV(ms, 0).length)
  // the forwarder's return is concrete
  // @log 1
  print(gtakeI(ms))
}
flatShapes()

// ── the `T[]`-annotated LOCAL, the wider half of the axis ──────────────────────
// Every one of these was a check-clean invalid module through the local while the same
// element through the PARAMETER above was already correct.
function locals() {
  const ss: string[] = ["aa"]
  // @log aa
  print(gtakeL(ss))
  const ds: f64[] = [2.5]
  // @log 2.5
  print(gtakeL(ds))
  const fs: f32[] = [1.5]
  // @log 1069547520
  print(f32bits(gtakeL(fs)))
  const xs: i32[][] = [[1, 2]]
  // @log 2
  print(gtakeL(xs).length)
  const bs: boolean[][] = [[true]]
  // @log 1
  print(gtakeL(bs).length)
  const m: {[string]: i32} = Map()
  m["a"] = 1
  const ms: {[string]: i32}[] = [m]
  // @log 1
  print(gtakeL(ms).length)
}
locals()

// ── the CONTROLS: no `T` in the forwarder, and no forwarder at all ─────────────
function controls() {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m["b"] = 2
  const ms: {[string]: i32}[] = [m]
  // a CONCRETE forwarder
  // @log 2
  print(ctake(ms).length)
  // no forwarder — the direct one-level call, which failed for the same reason
  // @log 2
  print(gid(ms[0]).length)
  const nested: i32[][][] = [[[1, 2]]]
  // @log 1
  print(gid(nested[0]).length)
}
controls()
