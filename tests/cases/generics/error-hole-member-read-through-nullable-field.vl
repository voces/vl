// @check
// A hole or generic body refuses at its pin what the direct spelling refuses: a member read
// through a field, an element, a call result or an `is` remainder that admits `null`, or
// handed to a function that reads it (D3287, D3204, D3300). Each `…Pinned` reads through an un-annotated or type parameter; `readDirect` is the
// concrete spelling.

// @error member access '.n' on non-object O | null
// @error member access '.n' on non-object O | null (parameter `b` of `readPinned`, used at 25:32)
// @error member access '.n' on non-object O | null (parameter `b` of `readGeneric`, used at 27:39)
// @error member access '.n' on non-object O | null (parameter `w` of `readNested`, used at 29:32)
// @error member access '.n' on non-object O | null (parameter `b` of `readBound`, used at 33:9)
// @error member access '.n' on non-object O | null (parameter `xs` of `readElem`, used at 36:31)
// @error member access '.n' on non-object O | null (parameter `b` of `readResult`, used at 38:32)
// @error member access '.n' on non-object O | null (parameter `b` of `readRemainder`, used at 41:43)
// @error member access '.n' on non-object O | null (parameter `b` of `readPassed`, used at 45:38)

type O = { n: i32 }
type R = { v: O | null }
function no(v: i32): O | null {
  if v < 0 { return null }
  return { n: v }
}
const r = { v: no(3) }

function readPinned(b) { print(b.v.n) }
readPinned(r)
function readGeneric<B>(b: B) { print(b.v.n) }
readGeneric(r)
function readNested(w) { print(w.r.v.n) }
readNested({ r: r })
function readBound(b) {
  const o = b.v
  print(o.n)
}
readBound(r)
function readElem(xs) { print(xs[0].n) }
readElem([no(3)])
function readResult(b) { print(b.f().n) }
readResult({ f: () => no(3) })
function readRemainder(b) {
  if b.v is i32 { print(0) } else { print(b.v.n) }
}
readRemainder(r)
function readN(q) { return q.n }
function readPassed(b) { print(readN(b.v)) }
readPassed(r)
function readDirect(b: R) { print(b.v.n) }
readDirect(r)
