// @check
// A hole or generic body refuses at its pin what the direct spelling refuses: a member read
// through a field, an element, a call result or an `is` remainder that admits `null` (D3287,
// D3204). Each `…Pinned` reads through an un-annotated or type parameter; `readDirect` is the
// concrete spelling.

// @error member access '.n' on non-object O | null
// @error member access '.n' on non-object O | null (the body of `readPinned` at the call's argument types)
// @error member access '.n' on non-object O | null (the body of `readGeneric` at the call's argument types)
// @error member access '.n' on non-object O | null (the body of `readNested` at the call's argument types)
// @error member access '.n' on non-object O | null (the body of `readBound` at the call's argument types)
// @error member access '.n' on non-object O | null (the body of `readElem` at the call's argument types)
// @error member access '.n' on non-object O | null (the body of `readResult` at the call's argument types)
// @error member access '.n' on non-object O | null (the body of `readRemainder` at the call's argument types)

type O = { n: i32 }
type R = { v: O | null }
function no(v: i32): O | null {
  if v < 0 { return null }
  return { n: v }
}
const r = { v: no(3) }

function readPinned(b) { print(b.v.n) }
readPinned(r)
function readGeneric<B>(b: B) { print(b.v.n) }
readGeneric(r)
function readNested(w) { print(w.r.v.n) }
readNested({ r: r })
function readBound(b) {
  const o = b.v
  print(o.n)
}
readBound(r)
function readElem(xs) { print(xs[0].n) }
readElem([no(3)])
function readResult(b) { print(b.f().n) }
readResult({ f: () => no(3) })
function readRemainder(b) {
  if b.v is i32 { print(0) } else { print(b.v.n) }
}
readRemainder(r)
function readDirect(b: R) { print(b.v.n) }
readDirect(r)
