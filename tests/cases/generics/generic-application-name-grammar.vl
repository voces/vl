// @run
// @log 3
// @log 4
// @log 9
// @log 1
// @log 2
// @log 6
// The GENERIC-APPLICATION NAME GRAMMAR, pinned from the two conjuncts that decide it.
// The parser folds a generic's arguments into the declared name, so a declaration is
// `Box<T>` and an application is `Box<i32>` — one concatenation, which every consumer reads
// back with the same two questions: WHERE is the head's `<` (`gaeLtAt`), and does the
// argument list CLOSE the whole name (`annGenAppSpanEnds`). D-GENAPPDOWN moved both homes
// from `emit_base.vl` down into `typecheck.vl` and routed the checker's three hand-rolled
// `let/while/flag` copies to them. This file exists because a graded sabotage found each
// conjunct decided by only one or two corpus inputs, and a one-input margin is not a margin.
type Box<T> = { v: T }

// THE `<` IS THE FIRST ONE, NOT THE LAST — a nested application whose ARGUMENT is a union.
// Reading the last `<` instead cuts the head as `Box<Box` and the argument list as
// `i32|null>`, and the annotation resolves against a registry entry that does not exist.
// The union argument is what makes the two readings diverge observably: without a separator
// inside the brackets both cuts land on a resolvable head.
const b: Box<i32 | null> = { v: 3 }
if b.v is i32 { print(b.v) }
const n: Box<Box<i32 | null>> = { v: { v: 4 } }
const iv = n.v.v
if iv is i32 { print(iv) }

// A one-member alias whose BODY is an application: recorded as a plain type REFERENCE only
// when the argument list closes the whole spelling — the same span test asked of an
// identifier RUN rather than of a synthetic name.
type Alias = Box<i32>
const al: Alias = { v: 9 }
print(al.v)

// The SUFFIX negative: `Box<i32>[]` carries a `<` at a positive index and is NOT an
// application — it is a LIST of one, whose `[]` the array grammar peels first.
const xs: Box<i32>[] = [{ v: 1 }, { v: 2 }]
print(xs[0].v)
print(xs[1].v)

// THE TRAILING `>` IS NOT DECORATION. A recursive generic alias spells its own name inside a
// union member (`L<T> | null`): a `<` at index 1, and NO closing `>` at the end. Dropping the
// final-character compare accepts it as an application, cuts the argument list as `T>|nul`,
// and the declaration no longer registers.
type L<T> = { head: T, tail: L<T> | null }
const six = 6
print(six)
