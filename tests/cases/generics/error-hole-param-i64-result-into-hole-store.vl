// @check
// @error cannot assign i64 to i32 (the body of `f` at the call's argument types)
// @error argument of type i64 flows into `g` expecting i32
// @error argument of type i32 flows into `g` expecting N
// An arithmetic result stored back into the parameter's own type, or handed to a generic
// parameter the argument binds, is refused at the pin as its annotated spelling is (D9620).
function f(x) {
  let y = x
  y = x + 5000000000
  y
}
print(f(2))
function g<T>(a: T, b: T) { a }
function p(x) { g(x, x + 5000000000) }
print(p(2))
type N = 1 | 2
const n: N = 2
function q(x) { g(x, x * 2) }
print(q(n))
