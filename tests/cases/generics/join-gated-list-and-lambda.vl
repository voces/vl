// @log s
// @log true
// @log false
// @log false
// Two shapes keep master's join, since their instances build no kept-apart join yet: an element
// of joined list parameters `T[]`/`U[]` read through its fields (D3357), and a lambda returning a
// join of two parameters (D3358). Both must keep running as they did.
type P = {x: i32, y: string}
function g<T, U>(a: T[], b: U[], k: i32) {
  const r = if k == 0 { a } else { b }
  const e = r[0]
  print(e.x)
  print(e.y)
  for v in r { print(v.y) }
}
const p0 = { x: 1, y: "s" }
const p1 = { x: 7, y: "t" }
g([p0], [p1, p0], 0)
g([p0], [p1, p0], 1)
type K = "a" | "b"
function h<T0, T1>(a0: T0, a1: T1, k: i32) {
  const f = (j: i32) => if j == 0 { a0 } else { a1 }
  const e = f(k)
  print(e is null)
}
const x0: K | null = null
h(x0, true, 0)
h(x0, true, 1)
const y0: K | null = "a"
h(y0, true, 0)
