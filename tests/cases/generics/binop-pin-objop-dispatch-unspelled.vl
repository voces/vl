// @run
// @log 99
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `other` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `^` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `p` is inferred as `{x: i32}` — remove it to lean on inference
// @hint redundant type annotation: `q` is inferred as `{x: i32}` — remove it to lean on inference
// AN OPERATOR OVERLOAD AT A PINNED HOLE, WITH NOTHING AT MODULE SCOPE SPELLED LIKE A
// PARAMETER (silent-class-inventory D511).
//
// `dispatchRewrite` runs BEFORE monomorphization, so inside a generic body it asks
// `structIndexOfExpr` whether the left operand is an object while that operand is still typed
// `T`. It answered NO — except by accident: that helper's `Ident` arm asks
// `declaredStructIndex(name)`, a bare MODULE-scope lookup with no scope test, so a `const a: V`
// at module scope answered for a PARAMETER spelled `a`. Every cell of `d492/pingrid.py` names
// its constants `a`/`b`, so the whole of that grid dispatched for that reason and was blind to
// this. `monoPinBinOps` now asks the same question of the PIN, per instance.
//
// THE NAMES ARE THE POINT AND MUST NOT BE "TIDIED". The constants are `p`/`q` and the
// parameters are `a`/`b` DELIBERATELY: renaming either pair so they coincide restores the
// accident and this file stops testing anything. Its sibling
// `binop-pin-integer-only-keeps.vl` takes the matching pair, so the two cover both spellings.
//
// The annotations the hints name are LOAD-BEARING: `p`/`q` pin the object type the overload is
// declared over, and deleting them to quiet a hint would delete the axis. The two warnings are
// declared rather than silenced because `opSelfFnTy` requires the first parameter to be named
// exactly `self` (D471), so `_self` would make the declaration inert. The body returns a
// constant on purpose — 99 is an answer the native lowering never produces, so `runs` here
// means DISPATCHED, not "ran somehow".
type V = { x: i32 }
function "^"(self: V, other: V): i32 { return 99 }
function vxor<T>(a: T, b: T): i32 {
  const r = a ^ b
  return r
}
const p: V = { x: 6 }
const q: V = { x: 3 }
print(vxor(p, q))
