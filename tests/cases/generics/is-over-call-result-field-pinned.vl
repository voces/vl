// @run
// @log 9
// @log 0
// @log 9
// @log s
// @log 9
// @log 1
// `is` over a field read off a generic call's result is decided at a bounded type parameter's
// pin in either direction, and the call is still evaluated (D15607).
function pass<U>(u: U): U { print(9); u }
function boundShow<T: { x: i32 | string }>(t: T) {
  if pass(t).x is string { print(t.x) } else { print(0) }
}
function boundNum<T: { x: i32 | string }>(t: T) {
  if pass(t).x is i32 { print(1) } else { print(0) }
}
const a: { x: i32 } = { x: 7 }
const s: { x: string } = { x: "s" }
boundShow(a)
boundShow(s)
boundNum(a)
