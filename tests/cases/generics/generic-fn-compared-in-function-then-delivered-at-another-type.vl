// @run
// @warning Unused parameter
// @hint redundant type annotation
// @log 1
// @log false
// @log 1
// @log false
// D7482: the comparison inside a function body, and inside a generic one beside the delivery.
function two<T>(x: T): i32 { return 1 }
function one(x: i32): i32 { return 1 }
function h(): boolean { return one == two }
function g<U>(u: U): boolean {
  const s: (x: boolean) => i32 = two
  print(s(true))
  return one == two
}
const r: (x: string) => i32 = two
print(r("a"))
print(h())
print(g(3))
