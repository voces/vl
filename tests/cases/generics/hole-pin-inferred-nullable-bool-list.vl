// A hole parameter handed an inferred `[null, true]` pins at the elaboration's closed
// `(boolean | null)[]`, so an element read prints the niche's value, not its `i32` (D2946).
function h(x) {
  print(x[0])
  print(x[1])
}
const v = [null, true]
h(v)
h([null, true])
const w = [true, null]
h(w)
