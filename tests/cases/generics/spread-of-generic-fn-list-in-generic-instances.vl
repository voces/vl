// @run
// @log 4
// @log u
// A spread copy of a list holding a generic function, built in a generic function's body, is
// read at each instance's own closure, so the second instance's call does not trap (D17580).
function id<T>(x: T): T { return x }
function pField<T>(x: T) {
  const src = [id]
  const r: { fs: ((x: T) => T)[] } = { fs: [...src] }
  print(r.fs[0](x))
}
pField(4)
pField("u")
