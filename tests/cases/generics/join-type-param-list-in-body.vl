// @run
// @log 3
// @log 1
// @log 2
// @log 1
// @hint redundant type annotation: `nest` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `pick` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `walk` is inferred as `i32` — remove it to lean on inference
// A join inside a generic body keeps a type parameter's list and a concrete list collapsed, so
// the body reads `.length` and `for` as it does over one list; only the return set keeps the
// two apart (D2783).
function nest<T>(t: T): i32 {
  const q = [[t], [1, 2]]
  q[0].length + q[1].length
}
function pick<T>(c: boolean, t: T): i32 {
  const q = if c { [t] } else { ["z", "y"] }
  q.length
}
function walk<T>(c: boolean, t: T): i32 {
  const q = if c { [t] } else { ["z", "y"] }
  let n = 0
  for _v in q { n = n + 1 }
  n
}
print(nest(7))
print(pick(true, "s"))
print(pick(false, "s"))
print(walk(true, "s"))
