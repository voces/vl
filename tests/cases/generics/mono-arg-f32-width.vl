// @run
// @hint Intentionally-unused parameter `_b`
// @hint redundant type annotation: `dv` is inferred as `f64`
// @hint redundant type annotation: `useF32` is inferred as `i32`
// @hint redundant type annotation: `annBind` is inferred as `f32`
// @hint redundant type annotation: `loc` is inferred as `i32`
// @hint redundant type annotation: `viaParam` is inferred as `i32`
// @hint redundant type annotation: `viaReturn` is inferred as `f32`
// A generic call's ARGUMENT classifier (`monoArgTyName`) binds the type parameter at the
// argument's OWN width, and it asks `exprIsF32` BEFORE `exprIsF64` — the order
// `exprIsF32`'s own header states ("Checked BEFORE `exprIsF64` at every dispatch") and
// that every cell / slot / assign ladder obeys.
//
// `exprIsF64` OVER-CLAIMS a mixed f32/float-literal argument: `fv * 1.0` is `exprIsF32`
// (the literal adapts down to the f32 operand) AND `exprIsF64` (the literal is a genuine
// `.` literal). Asking f64 first bound `T` to f64, so `id(fv * 1.0)` was monomorphized as
// `(param f64) (result f64)`. The argument was correctly promoted into it (`f32.mul` ·
// `f64.promote_f32` · `call`) and then the f64 RESULT was handed to a site that classifies
// the call f32 off the checker's `nodeTyIx` — `__print_f32__`, an f32 slot, an f32
// parameter, an `f32[]` element. `vl check` clean, INVALID WASM.
//
// Every value is pinned through `f32bits` / `f64bits`, not the rendered float: a wrongly
// WIDE instance that happened to validate would still have to arrive as the right BIT
// PATTERN, and the f32 and f64 encodings of the same number are different integers.

const fv: f32 = 1.5
const fw: f32 = 2.5
const dv: f64 = 4.5

function id<T>(x: T): T { return x }
function fst<T, U>(a: T, _b: U): T { return a }
function mkl<T>(x: T): T[] { return [x] }
type Box<T> = { v: T }
function wrap<T>(x: T): Box<T> { return { v: x } }
function useF32(q: f32): i32 { return f32bits(q) }

// ── the witness, and the mixed-literal spellings around it ────────────────────
// @log 1069547520
print(f32bits(id(fv * 1.0)))
// @log 1073741824
print(f32bits(id(fv + 0.5)))
// @log 1065353216
print(f32bits(id(fv - 0.5)))
// @log 1061158912
print(f32bits(id(fv / 2.0)))
// @log 1069547520
print(f32bits(id(1.0 * fv)))
// @log -1082130432
print(f32bits(id(-fv + 0.5)))
// @log 1082130432
print(f32bits(id(fv + fw)))

// ── the RESULT boundaries the f64 instance could not meet ─────────────────────
const annBind: f32 = id(fv * 1.0)
// @log 1069547520
print(f32bits(annBind))
const infBind = id(fv * 1.0)
// @log 1069547520
print(f32bits(infBind))
// @log 1069547520
print(useF32(id(fv * 1.0)))
const ps: f32[] = []
ps.push(id(fv * 1.0))
// @log 1069547520
print(f32bits(ps[0]))
let mut32: f32 = 0.0
mut32 = id(fv * 1.0)
// @log 1069547520
print(f32bits(mut32))

// ── the other generic SHAPES reach the same classifier ────────────────────────
// @log 1069547520
print(f32bits(fst(fv * 1.0, 1)))
const ml = mkl(fv * 1.0)
// @log 1069547520
print(f32bits(ml[0]))
const bx = wrap(fv * 1.0)
// @log 1069547520
print(f32bits(bx.v))
// @log 1069547520
print(f32bits(id(id(fv * 1.0))))

// ── inside a function (`fnIx >= 0`), and through a parameter ──────────────────
function loc(): i32 {
  const q = id(fv * 1.0)
  return f32bits(q)
}
// @log 1069547520
print(loc())

function viaParam(p: f32): i32 {
  const q = id(p * 1.0)
  return f32bits(q)
}
// @log 1069547520
print(viaParam(fv))

function viaReturn(): f32 { return id(fv * 1.0) }
// @log 1069547520
print(f32bits(viaReturn()))

// ── CONTROLS: a GENUINE f64 argument still binds f64 ──────────────────────────
// A BARE float literal is not `exprIsF32`, so it keeps the f64 instance.
// @log 4609434218613702656
print(f64bits(id(1.5)))
// @log 4616752568008179712
print(f64bits(id(dv)))
// @log 4616752568008179712
print(f64bits(id(dv * 1.0)))
// A genuine f64 operand makes `exprIsF32` false through `binMixHardF64`, both orders.
// @log 4618441417868443648
print(f64bits(id(fv + dv)))
// @log 4618441417868443648
print(f64bits(id(dv + fv)))
// The non-float reps are untouched by the reorder.
// @log 7
print(id(7))
// @log hi
print(id("hi"))
// @log true
print(id(true))
