// @run
// @log hi
// @log 1
// @log 3.5
// @log hi
// @log 1
// A `for` over an `is K[]` arm's empty list of another element, grown by a push in the arm, binds
// its variable at `K`, a record or a primitive alike (D4995).
type P = { x: i32 }
type Q = { y: string }
function g<V>(a: V[]) {
  const q: V[] = []
  if q is Q[] {
    q.push({ y: "hi" })
    for e in q { print(e.y) }
  }
  print(a.length)
}
function h<V>(a: V[]) {
  const q: V[] = []
  if q is f64[] {
    q.push(2.5)
    for e in q { print(e + 1.0) }
  }
  g(a)
}
const ps: P[] = [{ x: 1 }]
g(ps)
h(ps)
