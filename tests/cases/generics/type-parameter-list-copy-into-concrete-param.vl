// @run
// @log 1
// @log 1
// @log 1
// @log 2
// @log 1
// @log 0
// @log 1.5
// @log 1.5
// @log 1.5
// @log 2.5
// @log 1.5
// @log 0
// A `.map`, `.filter` or `.slice` over a `V[]` is a list nothing else holds, so delivering it
// straight into a concrete `f64[]` parameter converts its elements at an `i32` instance, as
// delivering the list itself does (D4983).
function sumF(xs: f64[]) {
  let s = 0.0
  for x in xs { s = s + x }
  print(s / 1.0)
}
function t<V>(q: V[]) {
  sumF(q.map((x) => x))
  sumF(q.filter((x) => x == x).map((x) => x))
  sumF(q.slice(0))
  sumF(q.map((x) => x + 1))
  const k = () => sumF(q.map((x) => x))
  k()
  const p: V[] = []
  if p is f64[] {
    const j = () => sumF(p.map((x) => x))
    j()
  }
}
t([1])
t([1.5])
