// @run
// @log true
// @log false
// @log 7
// @log true
// @log 7
// @hint Intentionally-unused parameter
// A field read off a nullable record inside a generic instance, and a field read off a value whose
// type a generic call leaves open: in a compare, a return, an argument, a binding and arithmetic.
type P = { a: i32, b: i32 }
type Rows<T> = { base: i32, count: i32 }
function eq<T, U>(a: { v: T }, b: { v: U }) { return a.v == b.v }
function g<T>(_r: Rows<T>, x: T): T { return x }
function mk<T>(b: i32): Rows<T> { return { base: b, count: 1 } }
function show(n: i32) { print(n) }
const x: { f: i32 } | null = { f: 1 }
const y: { f: f64 } | null = { f: 1.0 }
const z: { f: f64 } | null = { f: 2.0 }
print(eq({ v: x }, { v: y }))
const differ = eq({ v: x }, { v: z })
print(differ)
const su = mk<P>(8)
const q = g(su, { a: 3, b: 4 })
print(q.a + q.b)
const s = q.a * 2
print(s == 6)
show(q.b + q.a)
