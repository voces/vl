// @run
// @log null
// @log a
// @log s
// @log a
// @log null
// @log s
// @log x
// @log a
// @log null
// A join holding a literal union, a string and a null is `string | null` or a box with a string
// member, and the literal union's arm widens to its member string in the string-op scratch frame
// the scan now reserves for a `string | null` join too (D3280): the generic spelling, the direct
// one, and the `null` extra arm.
type K = "a" | "b"
function g<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else if k == 1 { b } else { "s" }
  return r
}
const x: i32 | null = null
const y: K = "a"
print(g(x, y, 0))
print(g(x, y, 1))
print(g(x, y, 2))
function d(a: K, b: string | null, k: i32) {
  const r = if k == 0 { a } else if k == 1 { b } else { "s" }
  return r
}
const x1: string | null = null
print(d(y, x1, 0))
print(d(y, x1, 1))
print(d(y, x1, 2))
function n<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else if k == 1 { b } else { null }
  return r
}
print(n("x", y, 0))
print(n("x", y, 1))
print(n("x", y, 2))
