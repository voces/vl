// @error argument 1: operator '+' is not defined for boolean and i32
// A nested generic redeclaring `T` that adds to its own `T`, called with a value of the
// enclosing `T`: checked at the enclosing pin (D3853 review).
function a<T>(x: T) {
  function b<T>(y: T) { print(y + 1) }
  b(x)
}
a(true)
