// @error cannot assign (i32) => i32 to a binding of the generic function type <T>(T) => T: a function written to it must be generic too (T9.3)
// A write is held to the same rule as an initializer (D17745).
function same<T>(k: T): T { return k }
function inc(k: i32) { return k + 1 }
function mid<F, G>(a: F, a1: G) {
  let b: F = a
  print(b("x"))
  b = a1
  print(b(5))
}
mid(same, inc)
