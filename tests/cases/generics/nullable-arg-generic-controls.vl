// @run
// @log 1
// @log hi
// @log hi
// @hint redundant type annotation: `t` is inferred as `string` — remove it to lean on inference
// THE THREE CONTROLS for `soundness/xfail-miscompile-nullable-ref-generic-arg.vl`, where a
// `string | null` argument at a generic call emits check-clean invalid wasm.
//
//   · `boolean | null` through the same generic — the niche is an i32 sentinel, not a ref, so
//     there is no nullable-ref valtype to get wrong;
//   · the same shape NON-generic — no pin is minted, so nothing can be pinned wrong;
//   · a plain `string` through the same generic — the pin working correctly.
//
// All three in the PASSING corpus so the xfail's argument cannot quietly stop being true: if any
// of them starts failing, the defect is wider than that file claims and it must be rewritten
// rather than kept.
function id<T>(v: T): T {
  return v
}

function idPlain(v: string | null): string | null {
  return v
}

const b: boolean | null = true
const rb = id(b)
if rb != null { print(1) } else { print(0) }

const s: string | null = "hi"
const rp = idPlain(s)
if rp != null { print(rp) } else { print(0) }

const t: string = "hi"
print(id(t))
