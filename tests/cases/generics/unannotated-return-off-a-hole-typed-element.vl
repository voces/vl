// @run
// @hint redundant type annotation: `xs` is inferred as `T[]`
// @hint redundant type annotation: `zs` is inferred as `T[][]`
// @hint Intentionally-unused parameter `_self` (leading `_` marks it unused)
// @hint redundant type annotation: `qs` is inferred as `string[]`
// @hint redundant type annotation: `p` is inferred as `{x: i32}`
// @hint redundant type annotation: `sl` is inferred as `{xs: i32[]}`
// @log s
// @log 1.5
// @log s
// @log s
// @log v
// @log s
// @log 7
// @log 7
// @log 1
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 1
// @log 5
// AN UN-ANNOTATED RETURN WHOSE VALUE IS READ OUT OF A HOLE-TYPED CONTAINER
// (silent-class-inventory D592).
//
// `monoMakeInstance` substitutes the instance's type argument into the RETURN only when an
// annotation exists. With none it walked a hand-written whitelist of return-expression
// SHAPES — a `Call` through a closure-pinned param, an `Index` whose receiver is a PARAM
// pinned to `f64[]`, an `Ident` naming a local — and everything else kept `nret = -1`, so
// the instance's functype result fell to `retAnnKindChain`'s `"i32"` seed while the body
// returned a `(ref $string)`. `vl check` rc 0 (and CORRECT: a wrongly-typed binding of the
// result says "cannot assign string to 'z' of type i32"), and the engine refusing the module
// with "type mismatch: expected i32, found (ref $type)".
//
// ONE TOKEN SEPARATED IT FROM A PROGRAM THAT RAN: declaring `: T` made every body here work,
// which is what said the defect was in the return INFERENCE and not in the local, the
// literal or the pin. The ladder now falls through to `monoInferRetExprTy`, which re-checks
// the body with the VALUE parameters AND the TYPE parameters bound to this instance's
// concrete rows and asks the return expression its own type. Measured: the un-annotated
// `elem` program below compiles to a module BYTE-IDENTICAL to its `: T` twin's.
//
// FOUR SPELLINGS, ONE QUESTION, which is why the fix is not a fifth whitelist arm. The four
// that were silent are four different node kinds — an `Index` over a local `T[]`, the same
// over a `push`-built one, a nested `xs[0][0]`, and a `??` over a map `.get` — and the next
// spelling nobody has written down is the same question again.
//
// THE CONTROLS. `retI32` returns a hole that binds to i32, where the default was already
// right and the ladder must still mint nothing (byte-identical). `retParam` returns an
// element of a `T[]` PARAM, which the old `Index` arm covered for `f64[]` only and which
// must keep its answer. `retIdent` returns the hole itself, covered by the `Ident` arm.
//
// ── AND THE SAME FOUR SPELLINGS AT A STRUCT, which shipped one PR later ──────────────────
//
// The struct arm was REFUSED with the first landing and the refusal was right about the
// candidate: minting `tyToStructStr`'s `{x: i32}` names a shape nothing registered, and four
// corpus modules answered `emitProgram: ref valtype with no interned shape`. What was wrong
// was the NAME, not the arm. `monoRetRowName` hands back the name of the ROW the emitter's
// own shape table holds — `V` — so the annotation resolves for the consumers that read it as
// TEXT as well as the ones that read the arena sidecar, and a shape no row claims mints
// nothing at all.
//
// `V` at all four spellings and BOTH pins, plus the two shapes that say the arm is not
// keyed on a flat struct: `Node` is RECURSIVE (a `tyHasErr`-style concreteness gate was
// built for this arm, ablated, and deleted — its depth floor refused exactly this line
// while the row lookup runs it), and `S` carries a LIST field.
type V = { x: i32 }
type Node = { v: i32, next: Node | null }
type S = { xs: i32[] }

function elem<T>(self: T) {
  const xs: T[] = [self]
  return xs[0]
}
function elemPush<T>(self: T) {
  const ys: T[] = []
  ys.push(self)
  return ys[0]
}
function nest<T>(self: T) {
  const zs: T[][] = [[self]]
  return zs[0][0]
}
function mapGet<T>(self: T) {
  const m: {[string]: T} = Map()
  m.set("k", self)
  return m.get("k") ?? self
}
function retParam<T>(_self: T, ps: T[]) {
  return ps[0]
}
function retIdent<T>(self: T) {
  return self
}
function retI32<T>(self: T) {
  return self
}

print(elem("s"))
print(elem(1.5))
print(elemPush("s"))
print(nest("s"))
print(mapGet("v"))
print(retIdent("s"))
// The instance whose result rep IS the i32 default: the ladder must mint nothing.
print(retI32(7))
const qs: string[] = ["s"]
print(retParam(0, [7])) // the `T[]` PARAM arm, at an i32 element
print(qs.length)
// The STRUCT arm: the same four spellings, both pins, and two shapes that are not flat.
const p: V = { x: 7 }
print(elem(p).x)
print(p.elem().x)
print(elemPush(p).x)
print(nest(p).x)
print(mapGet(p).x)
const nd: Node = { v: 1, next: null }
print(elem(nd).v)
const sl: S = { xs: [4, 5] }
print(elem(sl).xs[1])
