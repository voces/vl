// @run
// @hint redundant type annotation: `v` is inferred as `A | B | null`
// A written union of type parameters beside a concrete default keeps the default apart, so a
// pin does not read `9` as one of its members; at a numeric pin the parameters' members stay
// apart and a literal folds into them (D3618).
function F<A, B>(k: i32, a: A, b: B) {
  const v: A | B | null = if k == 0 { a } else if k == 1 { b } else { null }
  print(v ?? 9)
}
F(0, true, "s")
F(2, true, "s")
F(1, "s", true)
F(2, "s", true)
function N<A, B>(k: i32, a: A, b: B) {
  const v: A | B | null = if k == 0 { a } else if k == 1 { b } else { null }
  const r = v ?? 9
  print(r)
  print(r is i32)
  const s = if v != null { v } else { 9 }
  print(s)
  const xs = [v ?? 9]
  print(xs[0])
}
const x = 2.5
const y = 4
N(0, x, y)
N(1, x, y)
N(2, x, x)
// @log true
// @log 9
// @log true
// @log 9
// @log 2.5
// @log false
// @log 2.5
// @log 2.5
// @log 4
// @log true
// @log 4
// @log 4
// @log 9
// @log false
// @log 9
// @log 9
