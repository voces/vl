// @run
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `outer` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log 5
// D10330: a hole parameter's `const` copy handed to a generic at `null` pins the instance at
// `null`, and the call's `i32` result reaches `print`.
function outer<U>(x: U): i32 { 5 }
function take(a) {
  const v = a
  print(outer(v))
}
take(null)
