// @run
// @log 0
// @log 1.5
// @log 9
// @log true
// @log 7
// @log 0.5
// @log 4
// @log 1.5
// @log 1.5
// @log true
// @log 1.5
// @log 4
// A `??` over a nullable element read through an un-annotated parameter types as the same `??`
// at top level (D9701): an `f32` element adopts an integer literal default, an `f32` element
// with a call or variable default of `i32` joins apart into `f32 | i32`, and an `i64` element
// with an `f64` literal default joins apart into `i64 | f64`, read, bound, added to and tested.
// The non-null elements are the controls: each keeps its own value.
const x: f32 = 1.5
const k: (f32 | null)[] = [x, null]
const kk: (f32 | null)[] = [x, x]
function dc() { 9 }
const dz = 7
function orZero(a) { print(a[1] ?? 0) }
orZero(k)
orZero(kk)
function orCall(a) {
  const r = a[1] ?? dc()
  print(r)
  print(r is i32)
}
orCall(k)
function orVar(a) { print(a[1] ?? dz) }
orVar(k)
const j: (i64 | null)[] = [3, null]
const jj: (i64 | null)[] = [3, 4]
function orHalf(a) { print(a[1] ?? 0.5) }
orHalf(j)
orHalf(jj)
function orHalfAdd(a) { print((a[1] ?? 0.5) + 1) }
orHalfAdd(j)
function orHalfBound(a) {
  const r = a[1] ?? 0.5
  print(r + 1)
  print(r is f64)
}
orHalfBound(j)
const jq: i64 | null = null
const jn: i64 | null = 4
function orHalfScalar(a) {
  const r = a ?? 0.5
  print(r + 1)
}
orHalfScalar(jq)
function orHalfScalarRead(a) { print(a ?? 0.5) }
orHalfScalarRead(jn)
