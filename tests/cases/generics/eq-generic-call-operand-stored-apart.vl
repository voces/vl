// @log 1
// @log true
// @log true
// @log false
// @log true
// `==` in a generic body over a call operand of two records of one field set stored apart runs
// the call once into a fresh binding, then compares field by field, nullable records too (D16470).
function id<T>(x: T): T { return x }
let n = 0
function tick<T>(x: T): T {
  n = n + 1
  return x
}
function eq<T, U>(a: T, b: U) { return id(a) == b }
function eqr<T, U>(a: T, b: U) { return a == id(b) }
function ne<T, U>(a: T, b: U) { return id(a) != id(b) }
function eqt<T, U>(a: T, b: U) { return tick(a) == b }
print(eq({ f: 1 }, { f: 1.0 }))
print(eqr({ f: 1 }, { f: 2.0 }))
print(eq({ f: 1, g: { h: 2 } }, { f: 1.0, g: { h: 2.0 } }))
print(ne({ f: 1, g: 2 }, { f: 1.0, g: 2.0 }))
const r = eqt({ f: 1, g: 2, h: 3 }, { f: 1.0, g: 2.0, h: 3.0 })
print(n)
print(r)
const x: { f: i32 } | null = { f: 1 }
const y: { f: f64 } | null = { f: 1.0 }
const z: { f: f64 } | null = null
const w: { f: i32 } | null = null
print(eq(x, y))
print(eq(x, z))
print(eq(w, z))
