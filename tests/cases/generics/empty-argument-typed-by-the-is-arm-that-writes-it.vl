// A call that binds a type parameter to nothing binds it where the generic's `is K` arm writes
// through a receiver of that parameter (DECISIONS.md "No default type"): the empty argument is a
// `K`, read whole after the arm, through a field, or through a `const` the arm names it by.
type Box<V> = { items: V[] }
first([])
function first<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  print(v.length)
  const w = v
  print(w.length)
}
function field<V>(b: Box<V>) {
  if b.items is f64[] { b.items.push(1.5) }
  print(b.items.length)
}
field({ items: [] })
function aliased<V>(v: V[]) {
  if v is f64[] {
    const al = v
    al.push(2.5)
  }
  print(v.length)
}
aliased([])
function tested<V>(v: V[]) {
  if v is f64[] { print(-1) }
  print(v.length)
}
tested([])
// @log 1
// @log 1
// @log 1
// @log 1
// @log -1
// @log 0
