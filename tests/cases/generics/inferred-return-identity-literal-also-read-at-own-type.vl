// @run
// @log 1
// @log 1
// @log 2
// @log 2
// @log 3
// @log 3
// D8380: a function with an inferred return that hands back a generic identity's record
// literal, delivered into a union holding a wider record and also read at the literal's own
// type, is built at that record, as the literal returned directly is. Binding, return and
// argument deliveries, each beside a read at the literal's own type.
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
function d1() { return idn({ r: 1 }) }
function d2() { return idn({ r: 2 }) }
function d3() { return idn({ r: 3 }) }
function outer(): J | string { return d2() }
function take(u: J | string) {
  if u is J { print(u.r ?? 0) } else { print(0) }
}
const v: J | string = d1()
const q1 = d1()
print(q1.r)
if v is J { print(v.r ?? 0) } else { print(0) }
const q2 = d2()
print(q2.r)
const w = outer()
if w is J { print(w.r ?? 0) } else { print(0) }
const q3 = d3()
print(q3.r)
take(d3())
