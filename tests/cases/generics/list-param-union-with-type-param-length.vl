// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `h` is inferred as `i32`
// @hint redundant type annotation: `k` is inferred as `i32`
// @run
// @log 2
// @log 2
// @log 2
// @log 3
// D10880: a generic's list parameter whose element is a union with the type parameter binds the
// parameter from the argument's element arms, so `.length` reads a list at the instance.
type S = { g: i32 }

function f<T>(v: (T | i32)[]): i32 { v.length }
function h<T>(v: (S | T)[]): i32 { v.length }
function k<T>(v: ({ g: T } | i32)[]): i32 { v.length }

print(f(["a", 3]))
print(h([{ g: 1 }, 3]))
print(k([{ g: 1 }, 3]))
print(f([true, 1, false]))
