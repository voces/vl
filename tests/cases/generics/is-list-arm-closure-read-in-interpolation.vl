// @run
// @log n=10 of 1
// A closure in a shadow-arm region reads the arm's list inside an interpolation hole, the Q58 position the
// ir-shadow-rows sweep (is-empty-fit-shadow-capture-positions) cannot hold, since its rows build without std.
function pInterp<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    print("n=\{k()} of \{a.length}")
  }
}
pInterp([1])
