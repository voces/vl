// @run
// @hint redundant type annotation: `g` is inferred as `() => A | B | null`
// @hint redundant type annotation: `v` is inferred as `A | B | null`
// @log true
// @log s
// @log true
// @log false
// @log false
// @log true
// @log null
// @log 3
// @log false
// @log false
// @log true
// @log false
// A lambda's join over an un-annotated local copy of a type parameter, or of a parameter hole,
// tags a `boolean` copy as the boolean it holds at the pin, not as the `i32` it rides in. A
// lambda bound at an annotated function type compares its `null` arm as `null` (D3520).
function F<A, B>(k: i32, a0: A, b: B) {
  const a = a0
  const g = () => {
    if k == 0 { a } else { b }
  }
  print(g())
}
F(0, true, "s")
F(1, true, "s")
function T<A, B>(k: i32, a0: A, b: B) {
  const a = a0
  const g = () => {
    if k == 0 { a } else { b }
  }
  print(g() is boolean)
  print(g() is i32)
}
T(0, true, 3)
T(1, true, 3)
function H(k: i32, a0, b) {
  const a = a0
  const g = () => {
    if k == 0 { a }
    else if k == 1 { b }
    else { null }
  }
  print(g())
}
H(2, true, "s")
H(1, 3, 3)
function Q<A, B>(k: i32, a: A, b: B) {
  const g: () => A | B | null = () => {
    if k == 0 { a }
    else if k == 1 { b }
    else { null }
  }
  const v = g()
  print(v == a)
}
Q(2, 2.5, 3)
Q(1, 2.5, 3)
Q(0, 2.5, 3)
function E<A, B>(k: i32, a: A, b: B) {
  const v: A | B | null = if k == 0 { a } else if k == 1 { b } else { null }
  print(v == a)
}
E(2, 2.5, 3)
