// @run
// @hint redundant type annotation: `count` is inferred as `i32`
// @log 1
// @log 2
// @log true
// @log 2
// @log 5
// @log 7
// D8321, D4710: a list of an undeclared record, a generic constructor's or a literal's, pins a
// hole or `U[]` parameter at that record's list, and the instance's parameter has its valtype.
function pc<T>(x: T) { { a: x } }
function g(v) { print(v[0].a) }
const xs = [pc(1)]
g(xs)
function h<U>(v: U[]): U { v[0] }
print(h([pc(2)]).a)
g([pc(true)])
function cnt(v) { v.length }
print(cnt([pc(3), pc(4)]))
function pd(x: i32) { { a: x } }
g([pd(5)])
function count<T>(ws: T[]): i32 { return ws.length }
print(h([{ a: 6 }]).a + count([{ v: 7 }]))
