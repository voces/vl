// @run
// @log 9
// @log 2
// @log 9
// @log z
// @log 9
// @log q
// @log 9
// @log 4
// @warning Unused parameter `x`
// @warning Unused parameter `x`
// @warning Unused parameter `x`
// @warning Unused parameter `x`
// The return-kind reader family resolved through the CALLING FRAME. A nested capturing
// function is cloned per pin and the clone shares its template's name, so the flat
// `fnIndexOfSid` always answers the template — an instance then returned the pin kind the
// TEMPLATE was built at, and validated against a value it never built (D1788).
//
// Every line pairs a STRUCT first pin with a second pin of another rep, which is the shape
// that separates the two: with the struct at the instance's pin the instance's own return
// expression supplies the ref kind and nothing was wrong. NO ANNOTATION may be added to `o`
// — the annotated face names the substituted type and ran throughout.

type S = { a: i32 }
type T2 = { b: i32 }

function mkS(): S { return { a: 9 } }
function mkT(): T2 { return { b: 4 } }

function o(n) {
  function k(x: i32) { return n }
  return k(1)
}

// The scalar second pin: the row's own witness.
print(o(mkS()).a)
print(o(2))

// A string second pin, through a BOUND return rather than a direct one.
function ob(n) {
  function k(x: i32) { return n }
  const v = k(1)
  return v
}
print(ob(mkS()).a)
print(ob("z"))

// A string-LIST second pin, which reads back by element.
function ol(n) {
  function k(x: i32) { return n }
  return k(1)
}
print(ol(mkS()).a)
print(ol(["p", "q"])[1])

// A second STRUCT of a different shape, so the struct-table row is resolved per instance
// and not merely the kind.
function os(n) {
  function k(x: i32) { return n }
  const v = k(1)
  return v
}
print(os(mkS()).a)
print(os(mkT()).b)
