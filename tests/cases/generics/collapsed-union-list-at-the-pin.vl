// @run
// @log a
// @log a
// @log z
// @log a
// @log 2
// @log z
// @log a
// @log a
// @log s
// @log 2
// @hint Intentionally-unused parameter
// @hint redundant type annotation
// A union naming a parameter that collapses to one member at the pin (`T | string` at a string
// literal union or at `string`) is spelled as that member, so a `(T | string)[]` there is a
// plain `string[]` in every position, as its direct annotation is (D7044).
type K = "a" | "b"
const a: K = "a"

function ret<T>(x: T, o: string): (T | string)[] { return [x, o] }
const w: (string | K)[] = ret(a, "z")
print(w[0])

function bound<T>(x: T, o: string): string {
  const xs: (T | string)[] = [x, o]
  return xs[0]
}
print(bound(a, "z"))

function only<T>(_x: T, o: string): (T | string)[] { return [o] }
const wo = only(a, "z")
print(wo[0])

function scalar<T>(x: T, _o: string): string {
  const r: T | string = x; return r
}
print(scalar(a, "z"))

function param<T>(_x: T, xs: (T | string)[]): i32 { xs.length }
const q: string[] = ["p", "q"]
print(param(a, q))

function nul<T>(x: T, o: string): (T | string | null)[] { return [x, o, null] }
const wn = nul(a, "z")
print(wn[1] ?? "-")

function plain<T>(x: T, o: string): (T | string)[] { return [x, o] }
const s: string = "a"
const ws: string[] = plain(s, "z")
print(ws[0])
const wl = plain("a", "z")
print(wl[0])

function grouped<T>(x: T): (T)[] { return [x] }
const wg = grouped("s")
print(wg[0])

function num<T>(x: T) {
  const l: (T | i32)[] = [x, 7]
  print(l.length)
}
num(3)
