// @run
// @log 3
// @log 5
// @log true
// @log none
// @log abc!
// @log false
// @log a
// An un-annotated parameter written into a place that admits `null` stays open, and the place reads
// at the member its pin lands on, as `<T>`'s write does: a local (D3436), a declared record's field
// (D3299), the null pin, a list cell and a read of the parameter itself. A literal-union place keeps
// the place's answer, which is what lets the argument `"a"` adapt to it.
type O = { n: i32 }
type R = { v: O | null }
type Ab = "a" | "b"
function g(x) {
  let s: string | null = null
  s = x
  print(s.length)
}
function put(b: R, a) {
  b.v = a
  print(b.v.n)
}
function onNull(x) {
  let s: string | null = "z"
  s = x
  print(s == null)
  print(s ?? "none")
}
function cell(x) {
  const xs: (string | null)[] = [null]
  xs[0] = x
  const s = xs[0]
  print(s + "!")
  print(x == null)
}
function lit(x) {
  let s: Ab | null = null
  s = x
  print(s)
}
g("abc")
const r: R = { v: null }
put(r, { n: 5 })
onNull(null)
cell("abc")
lit("a")
