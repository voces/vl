// @run
// @log 6
// @log 6
// @log a!
// An assignment's value is its right side at every instance, also where the place is a
// `T | string` box and the value a bare `T` (D2439).
function h<T>(e: T): T {
  let v: T | string = "z"
  return (v = e)
}
function k<T>(e: T): T {
  let v: T | string = "z"
  const r: T = (v = e)
  return r
}
print(h(5) + 1)
print(k(5) + 1)
print(h("a") + "!")
