// @run
// @log 4
// @log bee
// @log bee
// @log 4
// @log bee
// A literal discriminant test on a hole's field narrows the field's parent at the pin, as the
// test does on a declared union and as `is` does on a hole (D12602). Each instance keeps the
// members the test leaves, for `==` and `!=`, under a declared or an inferred type parameter.
type A = { k: "a", v: i32 }
type B = { k: "b", s: string }
const x: { h: A | B } = { h: { k: "a", v: 4 } }
const y: { h: A | B } = { h: { k: "b", s: "bee" } }
function F<Z>(z: Z) {
  if z.h.k == "a" { print(z.h.v) } else { print(z.h.s) }
}
function G(z) {
  if z.h.k != "a" { print(z.h.s) } else { print(z.h.v) }
}
F(x)
F(y)
G(y)
G(x)
H(y)
function H(z) {
  if z.h.k == "b" { print(z.h.s) } else { print(z.h.v) }
}
