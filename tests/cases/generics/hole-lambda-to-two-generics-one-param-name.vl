// @run
// @log 14
// @log abab
// @log 14
// @log abab
// Two generics sharing a type parameter's name each take a lambda at their own binding of it; a
// lambda judged at one call does not bind the other's parameter (D12471).
function gen3<T>(g, x: T) { print(g(x, x)) }
function gen4<T>(g, x: T) { print(g(x, x)) }
gen4((a, b) => a + b, 7)
gen3((a, b) => a + b, "ab")
const ks = [gen3, gen3, gen4]
ks[2]((a, b) => a + b, 7)
ks[1]((a, b) => a + b, "ab")
