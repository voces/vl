// @check
// @error argument 2: expected (T) => T, got (T, T) => T
// A type parameter that only annotates parameters still binds once when the call hands it
// generics of different signatures: binding each parameter apart would accept this call.
function id<T>(x: T): T { x }
function pick<T>(x: T, y: T): T { y }
function one<F>(a: F, c: F) {
  print(a(3))
  print(c(4, 5))
}
one(id, pick)
