// @run
// @log 5
// @log 7
// @log 1.5
// @log false
// @log s
// @log 7
// @log 5
// @log true
// @log 2.5
// @log 9
// @log true
// @log 3
// @log -1
// @log 6
// D10231: a generic's un-annotated `if` joining a type parameter with `null`, bound or read
// through `??` directly, at the `i32`, `f64`, `boolean` and `string` pins together.
function f<V>(c: boolean, x: V, d: V): V {
  const r = if c { x } else { null }
  r ?? d
}
function m<V>(c: boolean, x: V, d: V): V { (if c { null } else { x }) ?? d }
print(f(true, 5, 0))
print(f(false, 5, 7))
print(f(false, 2.5, 1.5))
print(f(false, true, false))
print(f(true, "s", "t"))
print(m(true, 5, 7))
print(m(false, 5, 7))
print(m(false, true, false))
print(m(false, 2.5, 0.5))
function ret<V>(c: boolean, x: V): V | null {
  const r = if c { x } else { null }
  r
}
function eq<V>(c: boolean, x: V) {
  const r = if c { x } else { null }
  r == null
}
function take(v: i32 | null) { v ?? -1 }
function arg<V>(c: boolean, x: V) {
  const r = if c { x } else { null }
  take(r)
}
function fld<V>(c: boolean, x: V): { v: V | null } {
  const r = if c { x } else { null }
  { v: r }
}
print(ret(false, 5) ?? 9)
print(eq(false, 5))
print(arg(true, 3))
print(arg(false, 3))
print(fld(false, 3).v ?? 6)
