// @run
// @hint redundant type annotation: `r` is inferred as `U[]` — remove it to lean on inference
// @log null
// @log 7
// @log 2.5
// @log null
// @log 7
// @log null
// @log 7
// @log null
// @log 7
// A generic's list literal is one node every instance shares. A call's re-check of the return
// at its own bindings records nothing on it, so a `string | null` instance does not hand its
// element type to the `i32` and `f64` instances (D4866). Return, binding and field positions,
// then the un-annotated face.
function wrap<U>(u: U): U[] { [u] }
const nb: string | null = null
print(wrap(nb)[0])
print(wrap(7)[0])
print(wrap(2.5)[0])
function bound<U>(u: U): U[] {
  const r: U[] = [u]
  r
}
print(bound(nb)[0])
print(bound(7)[0])
function box<U>(u: U): { v: U[] } { { v: [u] } }
print(box(nb).v[0])
print(box(7).v[0])
function bare<U>(u: U) { [u] }
print(bare(nb)[0])
print(bare(7)[0])
