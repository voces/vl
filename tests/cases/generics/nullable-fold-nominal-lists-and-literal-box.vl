// @run
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @log false
// @log false
// @log false
// @log false
// @log true
// @log false
// The null fold makes two lists of same-shape records one list, as the annotation route spells
// them, and a `K | L | null` value pinned beside a string is the nullable literal atom at the
// argument and the `string | null` its instance reads (D3504, D3509, D14770).
type Rec = { x: i32 }
type Rec2 = { x: i32 }
type K = "a" | "b"
type L = "c" | "d" | "x"
const rl: Rec[] | null = [{ x: 7 }]
const r2: Rec2[] | null = [{ x: 8 }]
function F<A, B>(k: i32, a: A, b: B): A | B | null {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
function G<A, B>(k: i32, a: A, b: B): (A | null) | B {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
function H<A, B>(a: A, _b: B): A | B { return a }
print(F(0, r2, rl) == null)
const w = [G(1, r2, rl)]
print(w[0] == null)
const kl: K | L | null = "d"
print(H(kl, "q") == null)
function g(p: K | L | null) {
  const u = H(p, "q")
  print(u == null)
}
g("c")
g(null)
// A `K | (L | null)` pin keeps master's unfolded union at the call and in the instance.
function gn(bx: K | (L | null)) {
  const u = H(bx, "s")
  print(u == null)
}
gn("c")
