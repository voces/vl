// @run
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @log false
// @log false
// @log false
// @log false
// @log true
// @log x
// @log z
// The null fold keeps two lists of same-shape records apart (`Rec[]` and `Rec2[]` are two
// types), and a `K | L | null` box pinned beside a string folds to the `string | null` its
// instance reads, converted at the argument and the return (D3504, D3509).
type Rec = { x: i32 }
type Rec2 = { x: i32 }
type K = "a" | "b"
type L = "c" | "d" | "x"
const rl: Rec[] | null = [{ x: 7 }]
const r2: Rec2[] | null = [{ x: 8 }]
function F<A, B>(k: i32, a: A, b: B): A | B | null {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
function G<A, B>(k: i32, a: A, b: B): (A | null) | B {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
function H<A, B>(a: A, _b: B): A | B { return a }
print(F(0, r2, rl) == null)
const w = [G(1, r2, rl)]
print(w[0] == null)
const kl: K | L | null = "d"
print(H(kl, "q") == null)
function g(p: K | L | null) {
  const u = H(p, "q")
  print(u == null)
}
g("c")
g(null)
function f<T>(x: T, p: boolean, o: string): T | string {
  if p { return x }
  return o
}
function run(a: K | (L | null)) {
  print(f(a, true, "z"))
  print(f(a, false, "z"))
}
run("x")
