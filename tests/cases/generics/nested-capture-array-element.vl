// @run
// @log 2
// @log 2.5
// @log a
// @log 7
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)

// D1794 — a nested capturing function delivered as an ARRAY ELEMENT. The literal's recorded
// element type rides the enclosing frame's hole, so its render names nothing and no ref-list
// row is interned; the element is that signature at the hole's pin. One pin per literal —
// a second pin poisons the bank and the refusal stands.

function o(n) {
  function k(x: i32) { return n }
  const fs = [k]
  return fs[0](1)
}
print(o(2))

// The same shape at an f64 pin, in its own frame: the row the element interns is the pin's.
function p(n) {
  function k(x: i32) { return n }
  const fs = [k]
  return fs[0](1)
}
print(p(2.5))

// The lambda-literal spelling, whose refusal was one rung later (`ref array literal with no
// interned element type`) and whose element name comes from the same render.
function q(n) {
  const fs = [(x: i32) => n]
  return fs[0](1)
}
print(q("a"))

// The declared face: a `<T>` type parameter banks its pin exactly as an inference hole does.
function r<T>(n: T): T {
  function k(x: i32): T { return n }
  const fs = [k]
  return fs[0](1)
}
print(r(7))
