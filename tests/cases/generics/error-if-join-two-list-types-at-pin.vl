// @error the branches of an `if`, `match` or `??` join f64[] and string[] (the body of `lit`, used at 7:14): no one list holds it where its value goes
// A generic join of a type parameter's list and a concrete list that a pin binds apart is
// refused at the call where no one list can hold it, built into a list literal (D2832). Read
// as one list by a body a generic caller pins later, its length runs (D16897).
function no(): boolean { return false }
function lit<T>(xs: T[], ys: string[]) {
  const l = [if no() { xs } else { ys }]
  print(l.length)
}
function len<T>(xs: T[], ys: string[]) {
  const r = if no() { xs } else { ys }
  print(r.length)
}
function relay<U>(us: U[]) { len(us, ["a", "b"]) }
lit([1.5], ["a", "b"])
relay([1.5])
relay(["q"])
