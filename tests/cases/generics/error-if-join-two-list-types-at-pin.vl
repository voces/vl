// @error the branches of an `if` or `match` in the body of `lit` join f64[] and string[]: no one list holds it where its value goes
// @error the branches of an `if` or `match` in the body of `len` join f64[] and string[]: field 'length' is not on every member of f64[] | string[]
// A generic join of a type parameter's list and a concrete list that a pin binds apart is
// refused at the call where no one list can hold it: built into a list literal, or read as
// one list by a body a generic caller pins later (D2832).
function no(): boolean { false }
function lit<T>(xs: T[], ys: string[]) {
  const l = [if no() { xs } else { ys }]
  print(l.length)
}
function len<T>(xs: T[], ys: string[]) {
  const r = if no() { xs } else { ys }
  print(r.length)
}
function relay<U>(us: U[]) { len(us, ["a", "b"]) }
lit([1.5], ["a", "b"])
relay([1.5])
relay(["q"])
