// @check
// @error a {v: i32, f: () => i32} cannot be delivered as R here: the assignment on line 8 writes a widened field
// @error a {v: i32, f: () => i32} cannot be delivered as R here: the assignment on line 8 writes a widened field
// A record reached through a hole or a type parameter and delivered to a parameter whose body
// writes a widened field is refused at the pin, as the direct spelling's delivery is (D3250).
type R = { v: i32, f: (() => i32) | null }
const NF: (() => i32) | null = null
function clr(q: R) { q.f = NF }
function viaHole(w) {
  clr(w.r)
  print(w.r.f())
}
function viaParam<Z>(w: Z) {
  clr(w.r)
  print(w.r.f())
}
viaHole({ r: { v: 1, f: () => 5 } })
viaParam({ r: { v: 1, f: () => 6 } })
