// @log 1
// D13461, D13462: an `if` or `match` choosing un-annotated functions, handed to a parameter the
// callee calls at two types, runs once before the statement holding the call wherever that
// statement runs the call once: through a labelled block, as another call's argument, an
// operand, a field, an element, a method's argument, a condition, a `??` right side when the
// choice is pure, and with an argument ahead of it bound first.
function both(f) {
  print(f("a"))
  return f(1)
}
function inner(s) { return s }
function ask(s) { return s }
function twice(s) { return s + s }

function lblBound(c: boolean) {
  const h = @B { break @B if c { inner } else { ask } }
  print(both(h))
}
lblBound(false)

function lblArg(c: boolean) {
  const r = both(@B { break @B if c { inner } else { ask } })
  print(r)
}
lblArg(true)

function nestedArg(c) { print(both(if c { inner } else { ask })) }
nestedArg(true)

function operand(c: boolean) { print(both(if c { inner } else { ask }) + 1) }
operand(false)

function field(c: boolean) {
  const o = { v: both(if c { inner } else { ask }) }
  print(o.v)
}
field(true)

function element(c: boolean) {
  const xs = [both(if c { inner } else { ask })]
  print(xs[0])
}
element(true)

function coalesce(c: boolean, m: i32 | null) {
  print(m ?? both(if c { inner } else { ask }))
}
coalesce(true, null)
coalesce(true, 5)

function methodArg(c: boolean) {
  const xs: i32[] = []
  xs.push(both(if c { inner } else { ask }))
  print(xs[0])
}
methodArg(true)

function cond(c: boolean) {
  if both(if c { inner } else { ask }) == 1 { print("one") }
}
cond(true)

function assign(c: boolean) {
  let r = 0
  r = both(if c { inner } else { ask })
  print(r)
}
assign(false)

let n = 0
function tick() {
  n = n + 1
  return n > 1
}
print(both(if tick() { inner } else { twice }))
print(both(if tick() { inner } else { twice }))
print(n)

function compound(c: boolean) {
  let r = 5
  r += both(if c { inner } else { ask })
  print(r)
}
compound(true)

function both2(k: i32, f) {
  print(f("a"))
  return f(k)
}
let m = 3
function bump() {
  m = m + 1
  return true
}
print(both2(m, if bump() { inner } else { ask }))
print(m)

function lazyAnd(c: boolean, d: boolean) {
  print(d && both(if c { inner } else { ask }) == 1)
}
lazyAnd(true, true)
lazyAnd(true, false)

function aheadParam(c: boolean, z: i32) {
  print(z + both(if c { inner } else { ask }))
}
aheadParam(true, 10)

function breakValue(c: boolean) {
  const r = @B { break @B both(if c { inner } else { ask }) }
  print(r)
}
breakValue(true)

function byMatch(k: i32) {
  print(
    both(
      match k {
        0 => inner
        _ => ask
      },
    ),
  )
}
byMatch(1)

function forIter(c: boolean) {
  for x in [both(if c { inner } else { ask })] { print(x) }
}
forIter(true)

const top = true
print(both(if top { inner } else { ask }))
