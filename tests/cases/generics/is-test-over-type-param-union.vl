// @run
// @log str
// @log nb
// @log ni
// @log other
// @log nb
// @log 6
// @log other
// @log bool
// @log ni
// @log other
// @log nb
// @log 4
// An `is` test over a union with a type parameter member may name any type: the parameter can
// be that type at a pin, so the test is no widening edge into another member (D2950).
function h0<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is string { print("str") } else { print("other") }
  if r is boolean { print("bool") } else { print("nb") }
  if r is i32 { print(r + 1) } else { print("ni") }
}
h0("s", true)
h0("s", false)
h0(true, true)
h0(3, true)
