// A generic nested in a generic and capturing its parameter, handed to a type-parameter
// parameter, is built under each instance of its encloser that hands it (D15105).
function mid<F>(a: F) { print(a("x")) }
function outer<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  mid(same)
}
function mid2<F, G>(a: F, b: G) {
  print(a("x"))
  print(b(1))
}
function outer2<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  mid2(same, same)
}
function swap<F, G>(a: F, b: G, n: i32) {
  if n > 0 { swap(b, a, n - 1) } else { print(a("x")) }
}
function outer3<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  function other<T>(k: T): T { k }
  swap(same, other, 1)
}
function hole(a) { print(a("x")) }
function outer4<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  hole(same)
}
outer(7)
outer("s")
outer2(7)
outer2("s")
outer3(7)
outer3("s")
outer4(7)
outer4(true)
