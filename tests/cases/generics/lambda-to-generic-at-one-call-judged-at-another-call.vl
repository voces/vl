// @run
// @log 8
// @log a!
// @log 4
// @log -4
// @log 9
// An un-annotated lambda handed to a generic at one call, and an annotated one at another: each
// lambda's body is judged at its own call's binding, not the other's (D16855).
function sel<A>(f: (x: A) => A): (x: A) => A { return f }
print(sel((x) => x * 2)(4))
const g = sel((s: string) => s + "!")
print(g("a"))
print(sel((x) => if x > 3 { x } else { 0 })(4))
print(sel(((x) => -x))(4))
const h = sel((x) => x + 1)
print(h(8))
