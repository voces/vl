// @run
// @log ss
// @log ss
// @log ss
// @log aa
// @log 3
// @log 6
// @log xx
// A choice between generic functions handed to a generic function's `(x: T) => T` slot or to a
// list's `map`, inside a generic and at top level, is called at the type the other argument
// gives `T`; one choice handed to one generic at two types runs at each.
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function ap<T>(g: (x: T) => T, x: T): T { return g(x) }
const c = [1].length > 0
function handed<T>(v: T): T {
  print(ap(if c { kg } else { idg }, "s"))
  print(["s"].map(if c { kg } else { idg })[0])
  return v
}
handed(1)
print(ap(if c { kg } else { idg }, "s"))
const h = if c { kg } else { idg }
print(h("a"))
function bound<T>(v: T): T {
  const k = if c { kg } else { idg }
  return k(v)
}
print(bound(3) - 3)
const p = if c { kg } else { idg }
print(ap(p, 3))
print(ap(p, "x"))
