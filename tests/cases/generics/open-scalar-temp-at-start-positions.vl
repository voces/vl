// @run
// @log 4
// @log -5
// @log 10
// Q58 position sweep: a sum of two calls of a generic function held in a map, typed at a still-open
// variable in the start body but held at the scalar its rep names, delivered as a scalar call
// argument, a nested call argument and a `??` operand. Its union argument, concat operand and
// interpolation hole stop on `box ladder`, its let initializer, if arm and record field on
// `local rep unsup`, `rep unsup` and `open local type`, each a start miss of its own.
function id<T>(x: T): T { return x }
function run<U>(a: ((x: U) => U)[], u: U): U { return a[0](u) }
function takeI(x: i32) { print(x) }
function neg(x: i32) { return 0 - x }
function maybe(n: i32): i32 | null { return if n > 0 { n } else { null } }
const m = Map()
m["k"] = id
const r = m["k"]
if r != null {
  let w = r
  w = r
  takeI(run([w], 2) + run([w], "ab").length)
  takeI(neg(run([w], 4) + run([w], "a").length))
  print(maybe(0) ?? run([w], 9) + run([w], "a").length)
}
