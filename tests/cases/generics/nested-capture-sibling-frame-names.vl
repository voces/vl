// @run
// @log 1
// @log 1
// @log 2
// @log 2.5
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `n` (prefix with `_` to suppress, or remove it)
// @warning Unused function `o` (prefix with `_` to suppress, remove it, or `export` it)
// @warning Unused function `d` (prefix with `_` to suppress, remove it, or `export` it)

// D1817 — two module-level frames whose nested functions share a name. An instance's own
// lifted slot declares none of its origin's nested functions, so a scope walk from it ran out
// of `fnParent` and the flat first-occurrence map answered the SIBLING frame's helper. The
// chain continues into the frame the instance was cloned from instead.

// `o` is declared and NEVER CALLED, and its `k` captures. That is enough: its `use` was the
// first `use` in the flat map, so `c`'s second instance resolved to it.
function o(n) {
  function k(x: i32) { return n }
  function use(p) { return p(1) }
  return use(k)
}

function c(n) {
  function k(x: i32) { return x }
  function use(p) { return p(1) }
  return use(k)
}
print(c(2))
print(c(2.5))

// The declaration ORDER must not decide it either: with the capturing frame second, the flat
// map happened to answer correctly, so this pair is the control that keeps the fix honest.
function d(n) {
  function k(x: i32) { return x }
  function use(p) { return p(1) }
  return use(k)
}
function e(n) {
  function k(x: i32) { return n }
  function use(p) { return p(1) }
  return use(k)
}
print(e(2))
print(e(2.5))
