// @run
// @log v=zz
// @log v=a
// @log v=c
// @log v=c
// @log v=5
// @log v=2.5
// @log v=true
// @log v=9
// @log v=b
// @log zz/zz
// @log v=zz
// @log v=a
// @log v=zz
// @log v=b
// @log v=zz
// @log v=zz
// @log v=b
// A `??` a type-parameter instance folds to its non-null operand stays an interpolation hole:
// a string pin renders the string and a literal-union pin its member, at a name, an element, a
// field and a nested instance (D4166).
type K = "a" | "b"
function name<T>(x: T) { print("v=\{x ?? "c"}") }
function member<T>(x: T) { print("v=\{x ?? "a"}") }
function twice<T>(x: T) { print("\{x ?? "c"}/\{x ?? "d"}") }
function elem<T>(xs: T[]) { print("v=\{xs[0] ?? "c"}") }
function field<T>(r: { f: T }) { print("v=\{r.f ?? "c"}") }
function ret<T>(x: T) { return "v=\{x ?? "c"}" }
function inner<U>(y: U) { print("v=\{y ?? "c"}") }
function outer<T>(x: T) { inner(x) }
const k: K = "a"
const kb: K = "b"
const nk: K | null = null
const ns: string | null = null
const z: i64 = 9
name("zz")
name(k)
name(nk)
name(ns)
name(5)
name(2.5)
name(true)
name(z)
member(kb)
twice("zz")
elem(["zz"])
elem([k])
field({ f: "zz" })
field({ f: kb })
print(ret("zz"))
outer("zz")
outer(kb)
