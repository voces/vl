// @run
// @log -1
// @log 4
// @log 2
// @log 100
// @log 2.25
// @log 1.5
// @log hi
// @log none
// @log 5
// @log 7
// @log 3
// D3215: `?.` on a hole receiver reads the field at the instance's pin, re-wrapped nullable, in
// a `??` operand, a local binding, a return, and over a declared union's arm.
type H = { v: i32 }
type Q = { h: H | null }
function F(z) { print(z.h?.v ?? -1) }
const a: Q = { h: null }
const b: Q = { h: { v: 4 } }
F(a)
F(b)

type C = { r: i32 }
function G(p) {
  const r = p?.r
  print(r ?? 100)
}
const c1: C | null = { r: 2 }
const c0: C | null = null
G(c1)
G(c0)

type E = { r: f64 }
function K(p) { return p?.r }
const e1: E | null = { r: 2.25 }
const e0: E | null = null
print(K(e1) ?? 1.5)
print(K(e0) ?? 1.5)

type T = { s: string }
function L(p) {
  const s = p?.s
  print(s ?? "none")
}
const t1: T | null = { s: "hi" }
const t0: T | null = null
L(t1)
L(t0)

type W = { w: i64 }
function M(p) { return p?.w }
const w1: W | null = { w: 5 as i64 }
const w0: W | null = null
print(M(w1) ?? (7 as i64))
print(M(w0) ?? (7 as i64))

type S = { s: i32 }
type U = C | S
function N(p) { print(p?.r ?? 100) }
const n1: C | null = { r: 3 }
N(n1)
