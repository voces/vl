// @run
// @hint redundant type annotation: `c` is inferred as `Circle` — remove it to lean on inference
// @log 4
// @log 4
// @log 5
// D3139: a walk variable narrowed to a record reaches a generic at the record's pin, and an
// annotated copy of one narrowed out of a nullable list keeps its niche in a closure's env.
type Circle = { r: i32 }
function id<T>(x: T): T { return x }
function uC(c: Circle) { return c.r }
function t(zz: (Circle | null)[]) {
  for e in zz {
    if e != null {
      print(uC(id(e)))
      const c: Circle = e
      const f = () => uC(c)
      print(f())
    }
  }
}
t([{ r: 4 }, null])
const ws: (Circle | string)[] = [{ r: 5 }, "s"]
for w in ws {
  if !(w is string) {
    const d = w
    print(uC(id(d)))
  }
}
