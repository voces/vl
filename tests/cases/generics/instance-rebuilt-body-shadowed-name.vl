// @run
// @log true
// @log 10
// @log big
// @hint redundant type annotation: `s` is inferred as `T[]` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `T[]` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `T[]` — remove it to lean on inference
// @hint redundant type annotation: `w` is inferred as `i64` — remove it to lean on inference
// A generic function whose instance rebuilds its body (a binding annotated at a type
// parameter) types a shadowed name by the binding in scope at the read, as a plain one does:
// the rebuilt body shares the template's reads, which are placed in the template (D3296).
function pick<T>(c: boolean, n: i32, x: T) {
  if c {
    const s: T[] = [x]
    print(s.length)
  }
  let s = n > 3
  s = n > 3
}
const r = pick(false, 7, 3)
print(r)
function wide<T>(c: boolean, big: i64, x: T) {
  if c {
    const s: T[] = [x]
    print(s.length)
  }
  const s = big + 1
  return s
}
function viaI64() {
  const w: i64 = wide(false, 9, "q")
  w
}
print(viaI64())
function tail<T>(c: boolean, n: i32, x: T) {
  if c {
    const s: T[] = [x]
    print(s.length)
  }
  let s = "a"
  if n > 3 { s = "big" } else { s = "small" }
}
print(tail(false, 8, 1.5))
