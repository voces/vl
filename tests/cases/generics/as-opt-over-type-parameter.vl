// @run
// @log -1
// @log 6
// @log -1
// @log -1
// @log 3
// @log 12
// @log 9
// @log null
// @log 7
// @hint redundant type annotation: `c` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `d` is inferred as `f64` — remove it to lean on inference
// `u as? N` over a type parameter is `N | null` at every pin: a union arm, a number the cast
// cannot represent, and one it can (D2754).
function k<T>(u: T): i32 {
  const v = u as? i32
  if v == null { return -1 }
  v
}
const a: string | i32 = "no"
const b: string | i32 = 6
print(k<string | i32>(a))
print(k<string | i32>(b))
print(k(a))
const c: f64 = 2.5
const d: f64 = 3.0
print(k(c))
print(k(d))
const e: i64 = 12
print(k(e))
print(k(9))
function h<T>(u: T) {
  const g = () => u as? i32
  print(g())
}
h(2.5)
h(7)
