// @run
// @log 1
// @log 3
// @log 4
// @log dflt
// @log 2
// @hint redundant type annotation: `a` is inferred as `i32[]`
// @hint redundant type annotation: `f` is inferred as `(i32) => i32`
// @hint redundant type annotation: `p` is inferred as `(i32 | string)[]`
// A generic alias over a list, function, map, nullable or union-list body: each application
// is the body with the parameters bound, as a record-bodied alias is.
type X<T> = T[]
const a: X<i32> = [1]
print(a.length)

type Fn<T> = (x: T) => T
const f: Fn<i32> = (x: i32) => x + 1
print(f(2))

type D<T> = { [string]: T }
const d: D<i32> = Map()
d["a"] = 4
print(d["a"] ?? 0)

type O<T> = T | null
const o: O<string> = null
print(o ?? "dflt")

type P<A, B> = (A | B)[]
const p: P<i32, string> = [1, "x"]
print(p.length)
