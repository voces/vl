// @error cannot assign boolean to 'n' of type i32
// Two nested generics each redeclaring `T`, each called with the enclosing one's value: the
// innermost demand reaches the outermost pin (D3853 review).
function a<T>(x: T) {
  function b<T>(y: T) {
    function c<T>(z: T) {
      const n: i32 = z
      print(n + 1)
    }
    c(y)
  }
  b(x)
}
a(true)
