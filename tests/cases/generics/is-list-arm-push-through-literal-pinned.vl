// @run
// @log 1
// @log 1
// @log 1
// @log 0
// A `.push` through an `is K[]` arm in an instance bound by a `[]` argument pushes onto the
// arm's `K[]` as an exact instance does: the receiver's type is read at the instance's pin, a
// generic `T[]` argument or a local at an unbound parameter alike (D4934, D4977).
function g<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  print(v.length)
}
g([])
g([2])
function s<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  print(q.length)
  print(a.length)
}
s([])
