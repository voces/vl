// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 16
// @hint redundant type annotation: `oneA` is inferred as `{base: i32}`
// @hint redundant type annotation: `dup` is inferred as `{base: i32}`
// THE PIN LADDER'S FOURTH SCOPE — D1596, met in the wild as glean's VL-042 (its earlier
// spelling, with the two `Buf`-taking helpers' parameters left un-annotated).
//
// `monoArgTyName` pins an un-annotated parameter from its argument's BINDING, and its
// module-scope rung scanned only the flat top-level statement list. A `const` written inside a
// top-level `if`/`while`/bare block is a START-FUNCTION LOCAL, not a global, so it appears in
// no such list: every channel declined and the cascade's `"i32"` catch-all declared an i32
// parameter over a `(ref $type)` argument — `vl check` rc 0, `type mismatch: expected (ref
// $type), found i32` inside the instance.
//
// BOTH FACES OF THE HOLE, and both were broken: `viaHole` leaves its parameter to inference,
// `viaAnn` annotates it. The annotated one is the CONTROL — it ran before and must keep
// running — because an annotation pins the rep and hides any defect whose ingredient is
// inference doing the pinning instead.
//
// LEG 7 IS THE AMBIGUITY GUARD. The module-frame table is FIRST-WINS over a walk with no
// notion of which block a call site sits in, so answering from it unconditionally hands one
// block's `Box` to another block's i32 call: `twice(dup)` became invalid wasm on a first
// candidate. `moduleLocalLetOfUnique` declines on a duplicated name; D1598 narrowed that
// decline to the candidate the SITE's own recorded type does not name, which leaves this leg
// on the i32 instance it has always had.
type Box = { base: i32 }

function ld(self: Box) { self.base }

function viaHole(b) { b.ld() }

function viaAnn(b: Box) { b.ld() }

function fieldHole(b) { b.base }

function twice(x) { x + x }

function mkBox(n: i32): Box { return { base: n } }

// leg 1 — the minimal witness: an `if` block, an ANNOTATED binding, an un-annotated parameter
if true {
  const oneA: Box = { base: 1 }
  print(viaHole(oneA))
}

// leg 2 — the same block with the binding's own type left to inference
if true {
  const two = mkBox(2)
  print(viaHole(two))
}

// leg 3 — a `while` block
let i = 0
while i < 1 {
  const three = mkBox(3)
  print(viaHole(three))
  i = i + 1
}

// leg 4 — a bare block
{
  const four = mkBox(4)
  print(viaHole(four))
}

// leg 5 — CONTROL: the annotated parameter, which ran before the fix
if true {
  const five = mkBox(5)
  print(viaAnn(five))
}

// leg 6 — the field-read body, which was the loud twin (`emitProgram: field access receiver is
// not a struct`) of the same missing pin rather than invalid wasm
if true {
  const six = mkBox(6)
  print(fieldHole(six))
}

// leg 7 — CONTROL: two sibling blocks bind `dup` at DIFFERENT types, so no candidate set
// agrees and the site's type names the i32 one; `twice(dup)` keeps its i32 instance
if true {
  const dup: Box = { base: 7 }
  print(dup.base)
}
if true {
  const dup = 8
  print(twice(dup))
}
