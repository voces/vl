// @error field 's' is not on every member of A | B — narrow with `is` first (no 's' on A) (the body of `F` at the call's argument types)
// A nested read through a union field of the bound type needs narrowing at the pin (D3437).
type A = { v: i32 }
type B = { s: string }
function F<Z>(z: Z) { print(z.h.s) }
const x: { h: A | B } = { h: { v: 1 } }
F(x)
