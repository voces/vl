// @run
// @log y
// @log a
// @log b
// @log x
// @log b
// @log x
// @log x
// @log true
// @log y
// @log z
// D7041: `T | L` at `T := K`, both string literal sets, is the one flat set `K | L` spells, as
// the annotation route joins it. Annotated and inferred bindings, an argument, a forwarding
// generic, overlapping sets and a nullable `K` each run; `T := string` keeps the union.
type K = "a" | "b"
type L = "x" | "y"
type O = "a" | "x"
function l<T>(x: T, o: L): (T | L)[] { return [x, o] }
function fwd<U>(x: U): (U | L)[] { return l(x, "x") }
function show(w: (K | L)[]) {
  for e in w { print(e) }
}

const a: K = "a"
const w1: (K | L)[] = l(a, "y")
print(w1[1])
const w2 = l(a, "y")
print(w2[0])
const b: K = "b"
show(l(b, "x"))
const w3: (K | L)[] = fwd(b)
print(w3[0])
print(w3[1])
const o: O = "x"
const w4: ("a" | "x" | "y")[] = l(o, "y")
const w5 = l(o, "x")
print(w4[0])
print(w5[0] == w5[1])
const an: K | null = "a"
const w6: (L | K | null)[] = l(an, "y")
print(w6[1])
const s: string = "z"
const w7 = l(s, "x")
print(w7[0])
