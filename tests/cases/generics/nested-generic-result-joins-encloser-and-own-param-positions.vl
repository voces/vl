// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 1
// @log a
// @log 1
// @log 2.5
// @log a
// @log 2.5
// @log 2
// A nested generic whose inferred result joins its encloser's parameter with its own is typed at
// that join in each instance of the encloser: one call, two calls, a second encloser
// instance, a three-element list read element by element, and a non-generic encloser.
function one<T>(x: T) {
  function wrap<U>(u: U) { return [x, u] }
  print(wrap("a").length)
}
one(1)

function two<T>(x: T) {
  function wrap<U>(u: U) { return [x, u] }
  print(wrap(1).length)
  print(wrap("a").length)
}
two(1)
two("s")

function each<T>(x: T) {
  function wrap<U>(u: U) { return [x, u, x] }
  const xs = wrap("a")
  for e in xs { print(e) }
}
each(1)
each(2.5)

function plain(x: i32) {
  function wrap<U>(u: U) { return [x, u] }
  print(wrap("a").length)
}
plain(1)
