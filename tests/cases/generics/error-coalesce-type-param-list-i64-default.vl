// @emit-error `??` over a list whose default is a list of another storage
// D2799 beside D2838: the checker refuses `i32[] | null ?? [5000000002]` at its direct spelling,
// and in a generic body only the pin `T := i32` makes the two lists differ, so the emitter refuses.
function h<T>(xs: T[] | null) { xs ?? [5000000002] }
print(h<i32>(null).length)
