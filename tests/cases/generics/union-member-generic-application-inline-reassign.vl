// @run
// @log 1
// @log 3
// D14300: an inline union with a generic-application member is a variant box, so a global
// reassigned to the other arm and narrowed by `is` reads both arms.
type Box<T> = { v: T }
type Tag = { t: i32 }

const u: Box<i32> | Tag = { v: 1 }
if u is Tag { print(u.t) } else { print(u.v) }
let w: Box<i32> | Tag = { v: 2 }
w = { t: 3 }
if w is Tag { print(w.t) } else { print(w.v) }
