// @check
// @error argument 1: expected f64, got boolean — a `boolean` is not a number; convert it with `b as f64` (the call of `h` at the call's argument types)
// @error argument 1: expected boolean, got i32 (the call of `h` at the call's argument types)
// @error argument 1: expected i32, got f64 (the call of `h` at the call's argument types)
// @error argument 1: expected f32, got i32 (the call of `h` at the call's argument types)
// @error argument 1: expected i32, got string (the call of `h` at the call's argument types)
// @error argument 1: expected i32, got boolean — a `boolean` is not a number; convert it with `b as i32` (the call of `h` at the call's argument types)
// @error argument 1: expected f64, got boolean — a `boolean` is not a number; convert it with `b as f64` (the call of `h` at the call's argument types)
// @error argument 1: expected f32, got i32 (the call of `h` at the call's argument types)
// @error argument 1: expected f32, got i32 (the call of `h` at the call's argument types)
// @error argument 1: expected f32, got i32 (the call of `h` at the call's argument types)
// @error argument 1: expected f32, got i32 (the call of `h` at the call's argument types)
// @error argument 1: expected f32, got i32 (the call of `h` at the call's argument types)
// D3225: an argument handed to a hole callee is held at the pin to the parameter the callee
// was bound to, in the direct call's words. Each call below is refused by its direct twin
// (`((x: f64) => x)(b)` and so on); before the pin asked, they printed `1`, `true`, a
// truncated or rounded number, or failed to validate.
function apply(h, v) { return h(v) }

const b: boolean = true
const n: i32 = 16777217
const d: f64 = 2.5
const s: string = "q"
print(apply((x: f64) => x * 2.0, b))
print(apply((x: boolean) => !x, n))
print(apply((x: i32) => x + 1, d))
print(apply((x: f32) => x, n))
print(apply((x: i32) => x + 1, s))

// A literal is judged as the direct call judges it: `true` is not an `i32`.
print(apply((x: i32) => x + 1, true))

// Forwarded through a second hole, the demand reaches the outer call.
function forward(h, v) { return apply(h, v) }
print(forward((x: f64) => x, b))

// A value bound inside a forwarding body is judged at the outer call too.
function big(h) {
  const m: i32 = 16777217
  return apply(h, m)
}
print(big((x: f32) => x))

// A literal and a value of one type are two demands, in either order: the literal fits
// `f32`, the value does not.
function litFirst(h) {
  const a: i32 = 16777217
  print(h(3))
  return h(a)
}
print(litFirst((x: f32) => x))
function valueFirst(h) {
  const a: i32 = 16777217
  print(h(a))
  return h(3)
}
print(valueFirst((x: f32) => x))
function litFirstFwd(h) {
  const a: i32 = 16777217
  print(apply(h, 3))
  return apply(h, a)
}
print(litFirstFwd((x: f32) => x))
function valueFirstFwd(h) {
  const a: i32 = 16777217
  print(apply(h, a))
  return apply(h, 3)
}
print(valueFirstFwd((x: f32) => x))
