// @run
// @log w
// @log 3
// @log v
// @log 4
// @info `b` is never reassigned; use `const` instead of `let`
// @info `b2` is never reassigned; use `const` instead of `let`
// A parameter annotated with one type parameter, copied into a binding of another and into one
// of its own or a third, each copy called at another type (D6793).
function same<T>(k: T): T { k }
function mid<F, G>(a: G) {
  let b: F = a
  let b2: G = a
  print(b("w"))
  print(b2(3))
}
mid(same)
function mid3<F, G, H>(a: G) {
  const b: F = a
  const b2: H = a
  print(b("v"))
  print(b2(4))
}
mid3(same)
