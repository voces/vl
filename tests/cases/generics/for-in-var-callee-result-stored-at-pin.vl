// @run
// @log b
// @log a
// @log a
// @log b
// @log b
// @log s
// @log 2.5
// @log b
// A loop variable handed to a generic or hole callee, whose result is stored back into a `T`
// slot (a `let`, a return, a `T` const, a list element), keys the callee as the slot does: a flat
// literal union at its atom, a string or `f64` at its own rep (D3015).
type AB = "a" | "b"
function id<U>(t: U): U { return t }
function idh(z) { return z }
function lastOf<T>(l: T[]): T {
  let r = l[0]
  for e in l { r = id(e) }
  return r
}
function firstOf<T>(l: T[]): T {
  for e in l { return id(e) }
  return l[0]
}
function firstK<T>(l: T[]): T {
  for e in l {
    const k: T = id(e)
    return k
  }
  return l[0]
}
function intoList<T>(l: T[]): T {
  for e in l { l[0] = id(e) }
  return l[0]
}
const v: AB[] = ["a", "b"]
print(lastOf(v))
print(firstOf(v))
print(firstK(v))
print(intoList(v))
function holed<T>(x: T): T {
  const l = [x]
  let r = x
  for e in l { r = idh(e) }
  return r
}
const w: AB = "b"
print(holed(w))
const s = "s"
print(holed(s))
print(holed(2.5))
const iv: ("a" | "b")[] = ["a", "b"]
print(lastOf(iv))
