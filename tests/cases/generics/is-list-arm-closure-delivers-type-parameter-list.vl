// @log 11
// @log 1
// A closure in an `is K[]` arm reads its capture at the declared `V[]`, so passing it whole to
// a generic list parameter binds `W = V`, as an explicit `lenG<V>(a)` does in the arm itself,
// and the callee sees the caller's list at every instance (D4982).
function lenG<W>(xs: W[]) { xs.length }
function t<V>(a: V[]) {
  if a is f64[] {
    const k = () => lenG(a) + 10
    const z = () => {
      const w: V[] = a
      return w.length
    }
    print(lenG<V>(a))
    print(z())
    print(k())
  }
  print(a.length)
}
const e: i32[] = []
t(e)
t([1])
const f: f64[] = []
t(f)
t([1.5])
