// @run
// @warning `x == null` is always false here (x is i32 | f64)
// @warning `x != null` is always true here (x is i32 | f64)
// @warning `w == null` is always false here (w is i32 | f64)
// @log false
// @log true
// @log false
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// A `==` or `!=` against `null` over a union of numbers is a nullness test, not a comparison
// dispatched member by member: it answers as it does over any other non-null value (D3527).
function pick(k: i32): i32 | f64 {
  if k == 0 { 3 } else { 2.5 }
}
const x = pick(1)
print(x == null)
print(null != x)
const w: i32 | f64 = 3
print(w == null)
let n: i32 | f64 | null = 2.5
print(n == null)
n = null
print(n == null)
function G<A, B>(k: i32, a: A, b: B) {
  const v = if k == 0 { a } else { b }
  print(v == null)
  print(v != null)
}
G(0, 3, 2.5)
G(1, 3, 2.5)
