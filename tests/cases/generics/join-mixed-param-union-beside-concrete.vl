// @log 1
// A written union of a type parameter and a concrete member, joined beside a concrete type that
// member does not take, keeps that type at each pin: in a record field, a nested field, a list
// element and a bare value `if` (D17446).
function G<A>(v: A | i32, b: boolean) {
  if b { return { x: v } }
  return { x: "s" }
}
const r = G<i32>(5, false)
print(r.x is string)
print(r.x)
print(G<i32>(5, true).x)
print(G<boolean>(true, true).x)
print(G(5, false).x)

function L<A>(v: A | i32, b: boolean) {
  if b { return [v] }
  return ["s"]
}
print(L<i32>(5, false)[0])
print(L<i32>(6, true)[0])

function V<A>(v: A | string, b: boolean) {
  const q = if b { v } else { 2.5 }
  return q
}
print(V<string>("t", false))
print(V<string>("t", true))

function B<A>(v: A | boolean, b: boolean) {
  if b { return { x: { y: v } } }
  return { x: { y: 7 } }
}
print(B<string>("u", false).x.y)
print(B<string>("u", true).x.y)

function M<A>(v: A | i32, b: boolean) {
  if b { return { x: v } }
  return { x: 3 }
}
print(M<string>("w", false).x)
print(M<string>("w", true).x)

function N<A>(v: A | i32, b: boolean) {
  if b { return { x: v } }
  return { x: [1] }
}
const n = N<i32>(1, false).x
if n is i32[] { print(n.length) }
