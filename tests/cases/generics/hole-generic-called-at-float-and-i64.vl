// @run
// @log -2.5
// @log -5
// @log -2.5
// @log -2.5
// @log 2
// @log -2
// D5843: an un-annotated generic handed through an un-annotated parameter and called there at
// `f64`, `i64` or `f32` is instanced at that type, and an integer literal on the left of the hole
// adapts to it: `0 - a` has the hole's type, as `a - 0` does.
function neg(a) { return 0 - a }
function lin(a) { return 1 + 2 * a }
function apply(g, x) { return g(x) }
const lap = (g, x) => g(x)
const v: i64 = 5
const w: f32 = 2.5
print(apply(neg, 2.5))
print(apply(neg, v))
print(apply(neg, w))
print(lap(neg, 2.5))
print(apply(lin, 0.5))
print(apply(neg, 2))
