// @hint redundant type annotation: `f` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `g` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `r` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `n` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `ni` is inferred as `{a: i32}` — remove it to lean on inference
// @hint redundant type annotation: `ns` is inferred as `{a: string}` — remove it to lean on inference
// A Set nested in a record or behind a generic call is told from its boolean map by the exact
// pin, not the box tag they share, and so is an anonymous record of the same field names (D2753).
function f<T>(u: T | string): boolean { u is {a: Set<i32>} }
const s: {a: Set<i32>} = { a: Set() }
const m: {a: {[i32]: boolean}} = { a: Map() }
print(f<{a: Set<i32>}>(s))
print(f<{a: {[i32]: boolean}}>(m))
function id<X>(x: X): X { x }
function g<T>(u: T | string): boolean { id(u) is Set<i32> }
const p: Set<i32> = Set()
const q: {[i32]: boolean} = Map()
const up: Set<i32> | string = p
const uq: {[i32]: boolean} | string = q
print(g(up))
print(g(uq))
function r<R>(u: R | string): boolean { u is {a: i32[]} }
const ri: {a: i32[]} = { a: [] }
const rs: {a: string[]} = { a: [] }
print(r<{a: i32[]}>(ri))
print(r<{a: string[]}>(rs))
function n<N>(u: N | string): boolean { u is {a: i32} }
const ni: {a: i32} = { a: 1 }
const ns: {a: string} = { a: "x" }
print(n(ni))
print(n(ns))
