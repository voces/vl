// @run
// @log s
// @log 1
// @log 1.5
// @log z
// @log 3
// A generic's nested list of its parameter beside a nested concrete list is built at the
// parameter's pin, one level or several down, so each arm boxes under its own tag (D2798).
function h<T>(c: boolean, t: T) {
  if c { return [[t]] }
  [[1]]
}
const q = h(true, "s")
if q is string[][] { print(q[0][0]) } else { print(-1) }
const p = h(false, "s")
if p is i32[][] { print(p[0][0]) } else { print(-1) }
function k<T>(c: boolean, t: T) {
  if c { [["z"]] } else { [[[t]]] }
}
const f = k(false, 1.5)
if f is f64[][][] { print(f[0][0][0]) } else { print(-1) }
const s = k(true, 1.5)
if s is string[][] { print(s[0][0]) } else { print(-1) }
print(h(true, 3)[0][0])
