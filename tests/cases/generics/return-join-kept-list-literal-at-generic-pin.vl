// @run
// @log 3
// @log 4
// @log 3
// @log 5
// @log 1
// @log 3
// @log 3
// @log 1
// @log 3
// @log 1
// @log 3
// @log 5
// @log 3
// @log 7
// @log 2
// @log 2.5
// A generic return join that kept a list literal `[t]` apart from a stored `(i32 | null)[]`
// keeps it apart at every pin of the body: lists are invariant, so `T = i32` does not merge
// `i32[]` into `(i32 | null)[]`, and a read in a generic caller's body takes the arm it holds.
function w3<T>(t: T, k: i32, q: (i32 | null)[]) {
  if k == 1 { return q }
  [t]
}

function w3a<T>(t: T, k: i32, q: (i32 | null)[]): (i32 | null)[] | T[] {
  if k == 1 { return q }
  [t]
}

function w4<T>(t: T, k: i32, q: i32[]) {
  if k == 1 { return q }
  [t, t]
}

function viaLet<T>(t: T, k: i32, q: (i32 | null)[]) {
  let v = w3(t, k, q)
  if k == 2 { v = [t, t, t, t] }
  print(v.length)
}

function viaIndex<T>(t: T, k: i32, q: (i32 | null)[]) {
  const v = w3(t, k, q)
  print(v.length)
  print(v[0])
}

function viaCall<T>(t: T, k: i32, q: (i32 | null)[]) {
  print(w3(t, k, q).length)
}

function viaAnnotated<T>(t: T, k: i32, q: (i32 | null)[]) {
  const v = w3a(t, k, q)
  print(v.length)
}

function viaStored<T>(t: T, k: i32, q: (i32 | null)[]) {
  let v = w3(t, k, q)
  const b = [t, t, t, t, t]
  if k == 2 { v = b }
  print(v.length)
}

function reverse<T>(t: T, k: i32, q: i32[]) {
  const v = w4(t, k, q)
  print(v.length)
  print(v[0])
}

const q3: (i32 | null)[] = [5, null, 6]
viaLet(3, 1, q3)
viaLet(3, 2, q3)
viaIndex(3, 1, q3)
viaIndex(3, 2, q3)
viaCall(3, 1, q3)
viaCall(3, 2, q3)
viaAnnotated(3, 1, q3)
viaAnnotated(3, 2, q3)
viaStored(3, 1, q3)
viaStored(3, 2, q3)
const qi = [7, 8, 9]
reverse(2.5, 1, qi)
reverse(2.5, 2, qi)
