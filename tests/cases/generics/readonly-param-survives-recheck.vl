// @run
// @log 4
// @log 41
// D3770: a record literal adopting a wider field (`n: 1` into `i64`) re-checks the program,
// and the re-check lost the written spelling of every annotation canon had rewritten, so a
// `readonly T[]` parameter named no `T` and `concat` read as unbindable.
import { concat } from "std:array"

type Ob = { x: f64, n: i64 }
const placed: Ob[] = []
function place(x: f64) {
  const o = { x, n: 1 }
  placed.push(o)
}
place(2.5)
const A = [1.0, 2.0]
const B = A.concat(A)
print(B.length)
print(placed[0].n + 40)
