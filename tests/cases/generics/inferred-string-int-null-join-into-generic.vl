// @run
// @log x
// @log 4
// @log null
// D3334: an un-annotated `string | i32 | null` join handed to a generic pins at its own member
// order, so the instance reads the box the binding was built as.
function show<U>(v: U) { print(v) }
function g(a0: string, a1: i32, k: i32) {
  const r = if k == 0 { a0 } else if k == 1 { a1 } else { null }
  show(r)
}
g("x", 4, 0)
g("x", 4, 1)
g("x", 4, 2)
