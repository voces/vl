// @check
// @error `k` tests its `T` with `is`, `match` or `as`, and this call binds it to
// D2493 at a generic pin: the body's `is IM` was checked against a bare `T`, and this call binds
// `T` to a union of two maps with one representation, so the tag test could not tell them apart.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
const mb: BM = Map()
mb.set(1, true)
function k<T>(u: T) {
  if u is IM { print("wrong") } else { print("bool") }
}
const v: IM | BM = mb
k(v)
