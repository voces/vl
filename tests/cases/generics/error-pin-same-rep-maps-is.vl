// @emit-error `is` cannot tell {[i32]:i32} from {[i32]:boolean} yet: this instance's union holds both
// D2493 at a generic pin: the body's `is IM` is checked against a bare `T`; this instance binds `T`
// to a union of two maps with one representation, so the emitter refuses the tag test.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
const mb: BM = Map()
mb.set(1, true)
function k<T>(u: T) {
  if u is IM { print("wrong") } else { print("bool") }
}
const v: IM | BM = mb
k(v)
