// @run
// @log true
// @log false
// @log true
// @log false
// @hint redundant type annotation: `f` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `app` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `aps` is inferred as `boolean` — remove it to lean on inference
// A generic delivered as a function value is instantiated at the destination's exact parameter
// types, so a Set and its boolean map get two instances (D2755).
function f<T>(u: T | string): boolean { u is Set<string> }
function app(
  g: ({[string]: boolean} | string) => boolean,
  v: {[string]: boolean},
): boolean {
  g(v)
}
function aps(g: (Set<string> | string) => boolean, v: Set<string>): boolean {
  g(v)
}
const s: Set<string> = Set()
const m: {[string]: boolean} = Map()
print(aps(f, s))
print(app(f, m))
const fs: (Set<string> | string) => boolean = f
const fm: ({[string]: boolean} | string) => boolean = f
print(fs(s))
print(fm(m))
