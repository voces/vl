// @run
// @log x
// @log 1.5
// @log 5
// @log 5
// @log y
// @log 5
// @log 5
// @log 2
// @log 5000000000
// @log 2.5
// @log 1
// @log 1.5
// @log 2.5
// @log a
// @log 3
// @log 3
// @hint redundant type annotation: `big` is inferred as `i64[]`
// The generic twin of `if-arm-nested-local-join.vl`: in an instance the inner arm's local has
// the type parameter's recorded type, so the join, the binding and a generic callee's pin read
// the local's slot or initializer, and a list join reads its arms (D2825, D2831; D2272).
type P = { a: i32 }
function id<T>(q: T): T { q }
function wrap<T>(c: boolean, d: boolean, a: T, b: T): T {
  id(if c { if d { const w = a; w } else { b } } else { b })
}
function bind<T>(c: boolean, d: boolean, a: T, b: T): T {
  const r = if c { if d { const w = a; w } else { b } } else { b }
  r
}
function plain<T>(c: boolean, d: boolean, a: T, b: T): T {
  const r = if c { if d { a } else { b } } else { b }
  r
}
print(wrap(true, true, "x", "y"))
print(wrap(true, true, 1.5, 2.5))
print(wrap(true, true, { a: 5 }, { a: 7 }).a)
print(wrap(true, true, [5], [7])[0])
print(bind(true, false, "x", "y"))
print(bind(true, true, [5], [7])[0])
print(plain(true, true, [5], [7])[0])
function t() { 1 == 1 }
function ops<T>(xs: T[]): T[] {
  const c = if t() { xs } else { [] }
  c
}
print(ops([1, 2])[1])
const big: i64[] = [5000000000, 6]
print(ops(big)[0])
print(ops([1.5, 2.5])[1])
function yes() { true }
function h<T>(a: T, b: T): T {
  return if yes() { if yes() { const w: T = a; w } else { b } } else { b }
}
print(h([1], [2])[0])
function walk<T>(xs: T[]) {
  const r = if yes() { xs } else { [] }
  for x in r { print(x) }
}
walk([1.5, 2.5])
walk(["a"])
function grow<T>(xs: T[]) {
  const r = if yes() { xs } else { [] }
  r.push(xs[0])
  print(r.length)
}
grow([1.5, 2.5])
function agree<T>(xs: T[], ys: i32[]) {
  const r = if t() { xs } else { ys }
  print(r.length)
}
agree([1, 2, 3], [1, 2])
