// @run
// @log 10
// @log 1
// @log 2
// @log 1
// @log 1
// An `is K[]` arm hands its own function's reads an empty `K[]`; a closure in another function
// capturing a same-named binding is a different variable and does not refuse it (D4935).
function s<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { print(q.length + 10) }
  print(a.length)
}
function cap(q: string[]) {
  const k = () => q.length
  print(k())
}
s([1])
cap(["x", "y"])
function t<V>(v: V[]) {
  if v is f64[] { return v.length + 10 }
  v.length
}
function cap2(v: i32[]) {
  const k = () => v.length
  k()
}
print(t(["z"]))
print(cap2([4]))
