// @run
// @log 2
// @log 1
// @log 2
// @log 1
// @log 1
// @log 4
// @log 2
// @log -
// @log s
// @hint redundant type annotation: `nest` is inferred as `i32[][]` — remove it to lean on inference
// @hint redundant type annotation: `r1` is inferred as `i32[][] | null` — remove it to lean on inference
// @hint redundant type annotation: `ps` is inferred as `{x: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `r2` is inferred as `P[] | null` — remove it to lean on inference
// @hint redundant type annotation: `r3` is inferred as `i32[][] | null` — remove it to lean on inference
// @hint redundant type annotation: `bx` is inferred as `{v: i32}` — remove it to lean on inference
// @hint redundant type annotation: `r4` is inferred as `(Box<i32> | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `b4` is inferred as `{v: i32}` — remove it to lean on inference
// A list literal read in place builds from its own elements under a nullable destination,
// and an inferred return typed as a bare `T` is the instance's pin (#3175's review grid).
type P = { x: i32 }
type Box<T> = { v: T }

const nest: i32[][] = [[1], [2, 3]]
function first(x: i32[][]) { return [x, null][0] }
const r1: i32[][] | null = first(nest)
if r1 != null { print(r1.length) }
const ps: P[] = [{ x: 1 }]
const r2: P[] | null = [ps, null][0]
if r2 != null { print(r2.length) }
function g<T>(x: T) { return [x, null][0] }
const r3: i32[][] | null = g(nest)
if r3 != null { print(r3.length) }

function h<T>(x: T) {
  const q = [null, x].slice(1)
  return q
}
const bx: Box<i32> = { v: 3 }
const r4: (Box<i32> | null)[] = h(bx)
print(r4.length)

function second<T>(a: T, b: T) {
  const xs = [a, b]
  return xs[1]
}
const m: {[string]: i32} = Map()
m["a"] = 2
print(second(m, m).length)
const b4: Box<i32> = { v: 4 }
print(second(bx, b4).v)
print(second(m, m)["a"] ?? -1)
const s: string | null = "s"
const n: string | null = null
print(second(s, n) ?? "-")
print(second(n, s) ?? "-")
