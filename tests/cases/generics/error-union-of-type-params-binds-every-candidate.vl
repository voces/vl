// @check
// @error return type mismatch: expected boolean, got i32 (the return of `F` at the call's argument types)
// @error return type mismatch: expected boolean, got i32 (the return of `H` at the call's argument types)
// @error cannot assign i32 to 'r' of type boolean
// D14803: with every candidate parameter bound to the argument's type, the call's return check
// sees `i32` where it once read `never | never`, which every destination accepted.
function F<A, B>(v: A | B): boolean { v }
function H<A, B, C>(v: A | B | C): boolean { v }
function G<A, B>(v: A | B): A | B { v }
print(F(5))
print(H(5))
const r: boolean = G(5)
print(r)
