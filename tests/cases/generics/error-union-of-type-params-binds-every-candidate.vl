// @check
// @error return type mismatch: expected boolean, got i32 (the return of `F`, returned at 7:46)
// @error return type mismatch: expected boolean, got i32 (the return of `H`, returned at 8:53)
// @error cannot assign i32 to 'r' of type boolean
// D14803: with every candidate parameter bound to the argument's type, the call's return check
// sees `i32` where it once read `never | never`, which every destination accepted.
function F<A, B>(v: A | B): boolean { return v }
function H<A, B, C>(v: A | B | C): boolean { return v }
function G<A, B>(v: A | B): A | B { return v }
print(F(5))
print(H(5))
const r: boolean = G(5)
print(r)
