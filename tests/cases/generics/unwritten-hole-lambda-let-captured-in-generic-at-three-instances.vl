// @run
// @info `k` is never reassigned; use `const` instead of `let`
// @log L
// @log 1
// @log L
// @log true
// @log L
// @log s
// A `let` holding a hole lambda that nothing writes, captured in a generic body, is instanced at
// each instance's own type, including two that share a representation (D3955).
function a<T>(x: T) {
  let k = (u) => {
    print("L")
    print(u)
  }
  const rd = () => {
    k(x)
  }
  rd()
}
a(1)
a(true)
a("s")
