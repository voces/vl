// @error argument 1: expected a list, string or i32-keyed map, got i32 — the body indexes it with an i32
// A nested generic that indexes its parameter, called with a value of the enclosing `T`: the
// index demand reaches the enclosing pin, which refuses a scalar there (D3884).
function a<T>(x: T) {
  function b<U>(y: U) { print(y[0]) }
  b(x)
}
a(5)
