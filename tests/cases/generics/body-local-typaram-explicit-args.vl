// @run
// @log 2
// @log 1
// @log 1
// @hint Intentionally-unused parameter `_v` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_g` (leading `_` marks it unused)
// CONTRACT: a type parameter no parameter names, written in the body (a local's annotation, a
// body function's return), binds from explicit type arguments; and a body function that is
// never used does not make an inferred call refuse (D4552).

function inner<V>(_v: V) { return 1 }

function localT<T, U>(a: T[]) {
  const q: U[] = []
  return inner(q) + a.length
}

function retT<T, U>(a: T[]) {
  const g = (_x: i32): U[] => []
  return g(1).length + a.length
}

function unusedT<T, U>(a: T[]) {
  const _g = (_x: i32): U[] => []
  return a.length
}

const a = [1]
print(localT<i32, string>(a))
print(retT<i32, boolean>(a))
print(unusedT(a))
