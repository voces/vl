// @run
// @log a
// @log 2.5
// @log n
// @log b
// @log 3.5
// @log m
// @log c
// @log 2
// @log 4.5
// @log 2
// @log 3
// @log d
// @log 5.5
// @log 3
// @log q
// @log 7.5
// The complement of `is i32[]` over a generic body's inferred `T[] | i32[]` is `T[]`, so it
// delivers into a `T[]` return, a `T` and a `T[]` binding, a generic `T[]` parameter and a
// record field at every pin, and the tested arm still reads `i32[]`.
function w<T>(t: T, b: boolean) {
  if b { return [t, t] }
  [1, 2, 3]
}

function take<T>(xs: T[]): T { xs[0] }

function ret<T>(t: T, b: boolean): T[] {
  const v = w(t, b)
  if v is i32[] { return [t] } else { return v }
}

function arg<T>(t: T, b: boolean): T {
  const v = w(t, b)
  if v is i32[] { return t }
  take(v)
}

function bind<T>(t: T, b: boolean) {
  const v = w(t, b)
  if !(v is i32[]) {
    const e: T = v[1]
    print(e)
    const xs: T[] = v
    print(xs.length)
  } else {
    print(v.length)
  }
}

function fld<T>(t: T, b: boolean) {
  const v = w(t, b)
  if v is i32[] {
    print(v[2])
  } else {
    const r = { xs: v }
    print(r.xs[0])
  }
}

function plain<T>(v: T[]) {
  const r = { xs: v }
  print(r.xs[1])
}

print(ret("a", true)[1])
print(ret(2.5, true)[0])
print(ret("n", false)[0])
print(arg("b", true))
print(arg(3.5, true))
print(arg("m", false))
bind("c", true)
bind(4.5, true)
bind(true, false)
fld("d", true)
fld(5.5, true)
fld(true, false)
plain(["p", "q"])
plain([6.5, 7.5])
