// D7443: in an un-annotated generic, a `null`-armed join of a record union's tag coalesced with
// a string outside the tag's set is `string`, printed in place, returned or captured; with a
// default inside the set it stays the atom, read back through a local and a global binding.
// @run
// @log b
// @log z
// @log b
// @log b
// @log a
// @log true
// @log b
// @log b
type N = { tag: "a" | "c", v: i32 } | { tag: "b" | "d", w: i32 }
type M = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
function mkM(): M | null { { tag: "b", w: 2 } }
function printed(a) {
  const v = a
  const c = if v != null { v.tag } else { null }
  print(c ?? "z")
}
printed(mk(false))
printed(mk(true))
function returned(a) {
  const v = a
  const c = if v != null { v.tag } else { null }
  return c ?? "z"
}
print(returned(mkM()))
function captured(a) {
  const v = a
  const c = if v != null { v.tag } else { null }
  const g = () => {
    print(c ?? "z")
  }
  g()
}
captured(mkM())
function kept(a) {
  const v = a
  const c = if v != null { v.tag } else { null }
  return c ?? "a"
}
function local() {
  const r = kept(mk(true))
  const s: string = r
  print(s)
  print(r == "a")
}
local()
const gr = kept(mkM())
const gs: string = gr
print(gs)
print(kept(mkM()))
