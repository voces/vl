// @run
// @log 2
// @log b
// @log 2
// @log 3
// @log 4
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// Two un-annotated parameters handed to one `T[]` run at every instance that binds their
// elements alike, beside an annotated list, and one function further out (D6502).
function g<T>(_x: T[], y: T[]): T[] { return y }
function f(a, b) { return g(a, b) }
print(f([1], [2, 3]).length)
print(f(["a"], ["b"])[0])
function g2<T>(_x: T[], y: T[]): void { print(y.length) }
function f2(a, b: string[]) { g2(a, b) }
f2(["x"], ["s", "t"])
function f3(a, b) { g2(a, b) }
function h(a, b) { f3(a, b) }
h(["a"], ["b", "c", "d"])
h([1], [2, 3, 4, 5])
