// @run
// @log 8
// @log 3.5
// @log N
// @log 2
// @log d
// @log abc
// @log 0
// @log d
// @log 0
// @hint redundant type annotation: `p` is inferred as `{v: i32}` — remove it to lean on inference
// A type-parameter write into a list cell reads, at each pin, the member the pin lands on, and an
// alias, closure or call write after it ends that read, as the direct spelling's do (D3446).
type P = { v: i32 }
function plus<T>(x: T) {
  const a: (i32 | null)[] = [null]
  a[0] = x
  print(a[0] + 1)
}
function half<T>(x: T) {
  const a: (f64 | null)[] = [null]
  a[0] = x
  print((a[0] ?? 0.5) + 1.0)
}
function guarded<T>(x: T) {
  const a: (i32[] | null)[] = [null]
  a[0] = x
  if a[0] != null { print(a[0].length) } else { print("N") }
}
function coalesce<T>(x: T) {
  const a: (string | null)[] = [null]
  a[0] = x
  print(a[0] ?? "d")
}
function aliased<T>(x: T) {
  const a: (i32 | null)[] = [null]
  a[0] = x
  const al = a
  al[0] = null
  print(a[0] ?? 0)
}
function wn(b: (string | null)[]) { b[0] = null }
function called<T>(x: T) {
  const a: (string | null)[] = [null]
  a[0] = x
  wn(a)
  print(a[0] ?? "d")
}
function closed<T>(x: T) {
  const a: (P | null)[] = [null]
  a[0] = x
  const f = () => a[0]?.v ?? 0
  a[0] = null
  print(f())
}
plus(7)
half(2.5)
const nl: i32[] | null = null
guarded(nl)
guarded([1, 2])
const ns: string | null = null
coalesce(ns)
coalesce("abc")
aliased(7)
called("abc")
const p: P = { v: 3 }
closed(p)
