// @log null
// @log true
// @log true
// A `<T>` `for`-in over a list literal mixing an element read, a local and the parameter, over
// a loop variable beside the parameter, or over a `.filter` or `.slice` of such a list, binds
// the loop variable at the pin: a `boolean` and a `boolean | null` print as booleans (D3082).
function f<T>(x: T) {
  const l = [x]
  for e in [l[0], x] { print(e) }
  const y = l[0]
  for e in [y, x, y] { print(e) }
}
const t: boolean | null = true
f(t)
function g<T>(x: T) {
  const l = [x]
  for a in l {
    for e in [a, x] { print(e) }
  }
}
g(true)
function h<T>(x: T, y: T) {
  for e in [x, y].filter((e) => e != x) { print(e) }
  for e in [x, x].slice(0) { print(e) }
}
const bt: boolean | null = true
const bn: boolean | null = null
h(bt, bn)
