// @check
// @error-at 7:9 the generic type `L` uses itself at a larger type argument (`L<L<i32>>`) inside its own definition, so each instance needs a bigger one and they never end: every instance of a generic type is compiled separately, and this one has no finite set of them
// @error-at 8:9 the generic type `M` uses itself at a larger type argument (`M<string[]>`) inside its own definition, so each instance needs a bigger one and they never end: every instance of a generic type is compiled separately, and this one has no finite set of them
// A generic alias that uses itself at a larger type argument has no finite set of instances,
// so its first expansion is refused, naming the alias and the larger application (D12131).
type L<T> = { v: T, next: L<L<T>> | null }
type M<T> = { v: T, next: M<T[]> | null }
const x: L<i32> = { v: 1, next: null }
const y: M<string> = { v: "a", next: null }
print(x.v)
print(y.v)
