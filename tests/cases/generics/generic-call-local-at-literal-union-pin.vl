// @run
// @log a
// @log [b]
// @log a
// @log a
// @log b
// @log b
// An un-annotated local holding a generic call's result inside an instance pinned to a literal
// union reads its members off the callee's result, printed, interpolated, through a hole callee,
// a `let`, and from a loop variable handed to the call (D3017).
type LS = "a" | "b"
function g<T>(x: T): T { return x }
function f<T>(x: T) {
  const y = g(x)
  print(y)
}
function fi<T>(x: T) {
  const y = g(x)
  print("[\{y}]")
}
function gh(x) { return x }
function fh<T>(x: T) {
  const y = gh(x)
  print(y)
}
function fl<T>(x: T) {
  let y = g(x)
  y = g(y)
  print(y)
}
function loop<T>(l: T[]) {
  for e in l {
    const r = g(e)
    print(r)
  }
}
const a: LS = "a"
const b: LS = "b"
f(a)
fi(b)
fh(a)
fl(a)
const ls: LS[] = ["b"]
loop(ls)
const il: "a" | "b" = "b"
f(il)
