// @run
// @log 5
// @log 1
// @log 2.5
// @log 1
// @log d
// @log 1.5
// @log 1
// @log 1.5
// @log 1.5
// The control for D2799's refusal: a `??` of a type parameter's list and a concrete default
// keeps running at every pin whose list has the default's storage, a numeric default at `f64`
// and `f32` included, on the value arm and on the default arm. No `i64` list is built here,
// so its wrapper's type index is unallocated and must not be read as another list's.
function h<T>(xs: T[] | null) { xs ?? [1] }
function s<T>(xs: T[] | null) {
  const r = xs ?? ["d"]
  r
}
function g(xs: f32[] | null) { xs ?? [1] }
function ga(xs: f32[] | null): f32[] { xs ?? [1.5] }
function gt<T>(xs: T[] | null) { xs ?? [1.5] }
print(h([5])[0])
print(h<i32>(null)[0])
print(h([2.5])[0])
print(h<f64>(null)[0])
print(s<string>(null)[0])
const fx: f32[] | null = null
const fr = fx ?? [1.5]
print(fr[0])
print(g(null)[0])
print(ga(null)[0])
print(gt<f32>(null)[0])
