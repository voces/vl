// @run
// @log s
// @log 4
// @log 3
// @log 7
// @log 3
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// A generic function value bound at the top level to a typed destination is adjudicated at
// that delivery. Another generic's call, whose type parameter shares the name, does not re-ask
// it at its own binding (D3104).

type R = { a: i32 }
type H = { f: (R) => void }

function show<T>(_x: T) { print(3) }
function echo<T>(x: T) { print(x) }
const g: (R) => void = show
const h: H = { f: show }
const fs: ((i32) => void)[] = [echo]

echo("s")
echo(4)
g({ a: 2 })
fs[0](7)
h.f({ a: 5 })
