function g<T>(w: T) {
  const x = 7
  if true {
    let x = w
    return x
  }
  w
}
const r1 = g({ a: 1, b: "r" })
print(r1.b)
const r2 = g([1, 2])
print(r2[1])
print(g("s"))

function f<T>(w: T, c: boolean) {
  const x = 7
  if c {
    let x = 2.5
    return x
  }
  1.5
}
print(f("s", true))
print(f("s", false))

const y = 9
function h<T>(w: T) {
  if true {
    let y = w
    return y
  }
  w
}
const r3 = h({ a: 4, b: "q" })
print(r3.b)
print(y)
