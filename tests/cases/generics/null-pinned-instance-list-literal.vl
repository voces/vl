// @run
// @log 1
// @log 2
// An un-annotated list literal of a parameter at an instance pinned at `null` holds the `null[]`
// sentinel, as the annotated `V[]` spelling does, where it stored a bare null ref (invalid wasm).
function take<V>(v: V) {
  const ys = [v]
  return ys.length
}
function twice(v) {
  const ys = [v, v]
  return ys.length
}
print(take(null))
print(twice(null))
