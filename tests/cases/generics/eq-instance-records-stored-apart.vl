// @log true
// @log true
// @log true
// @log false
// @log false
// @log true
// @log true
// A generic body's `==` compares two records of one field set stored apart per field pair at
// each instance: widths, a literal union beside `string`, nested records, and nullable records,
// whose instance built an invalid module before (D16397).
function eq<T, U>(a: T, b: U) { a == b }
function ne<T, U>(a: T, b: U) { a != b }
const i: { f: i32 } = { f: 1 }
const d: { f: f64 } = { f: 1.0 }
print(eq(i, d))
print(eq(i, { f: 2.0 }))
const l: { f: "a" | "b" } = { f: "a" }
const s: { f: string } = { f: "a" }
print(eq(l, s))
const n1: { g: { f: i32 } } = { g: { f: 1 } }
const n2: { g: { f: f64 } } = { g: { f: 1.0 } }
print(eq(n1, n2))
const x: { f: i32 } | null = { f: 1 }
const y: { f: f64 } | null = { f: 1.0 }
const z: { f: f64 } | null = null
print(eq(x, y))
print(eq(x, z))
print(eq(z, x))
const w: { f: i32 } | null = null
print(eq(w, z))
print(ne(i, { f: 3.0 }))
