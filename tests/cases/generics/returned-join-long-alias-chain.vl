// D2934, D12453, D14649: a generic join with a `??` arm returned through a chain of aliases keeps
// the type parameter's arm, so at `T = string | null` the box carries the `null` it returns.
function g<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  const s0 = r
  const s1 = s0
  const s2 = s1
  const s3 = s2
  const s4 = s3
  const s5 = s4
  const s6 = s5
  const s7 = s6
  const s8 = s7
  const s9 = s8
  s9
}
const u: string | null = "n"
const w: string | null = null
print(g(u, w, true))
print(g(u, w, false))
