// @emit-error redeclares its enclosing function's type parameter and reads that function's variables typed at it
// A nested generic that redeclares its enclosing function's `T` and reads a capture typed at the
// enclosing `T` is refused: instance bindings substitute a type variable by name, so the
// capture would be read at the nested `T` (D3840). With one instance it printed `1` for `true`.
function outer<T>(x: T) {
  const ys = [x, x]
  function inner<T>(u: T) {
    print(ys[1])
    print(u)
  }
  inner(7)
}
outer(true)
