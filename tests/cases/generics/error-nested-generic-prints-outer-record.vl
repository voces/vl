// @error `outer` prints its type parameter here: print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got {a: i32}
// A nested generic printing its parameter, called with a value of the enclosing `T`: the print
// demand is checked at the enclosing pin (D3882).
type P = { a: i32 }
function outer<T>(x: T) {
  function inner<U>(u: U) { print(u) }
  inner(x)
}
outer({ a: 1 })
