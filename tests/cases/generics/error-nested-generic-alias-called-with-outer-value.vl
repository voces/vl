// @error cannot assign boolean to 'n' of type i32
// A nested generic called through a `const` alias with a value of the enclosing `T`: the alias
// call binds it as the direct one does (D3853 review).
function a<T>(x: T) {
  function b<T>(y: T) {
    const n: i32 = y
    print(n + 1)
  }
  const f = b
  f(x)
}
a(true)
