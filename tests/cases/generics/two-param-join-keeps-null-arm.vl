// @run
// @log 1
// @log s
// @log null
// @log true
// @log t
// @log s
// @log 4
// @log null
// @log false
// @log true
// @log x
// A generic whose value `if` chain or returns join `A`, `B` and `null` keeps the null at every pin,
// whichever arm it is in: it was absorbed into `A | B`, so the null arm's value failed the
// caller's cast at a pin with a string arm (D3487).
function two<A, B>(k: i32, a: A, b: B) {
  if k == 0 { a }
  else if k == 1 { b }
  else { null }
}
function ret<A, B>(k: i32, a: A, b: B) {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
print(two(0, 1, "s"))
print(two(1, 1, "s"))
print(two(2, 1, "s"))
print(two(2, "s", true) == null)
print(two(2, "s", true) ?? "t")
const r = ret(0, "s", 4)
if r is string { print(r) }
const q = ret(1, "s", 4)
if q is i32 { print(q) }
const n = ret(2, "s", 4)
if n == null { print("null") }
print(ret(1, true, "x") == null)
print(ret(0, true, "x") ?? false)
print(ret(1, true, "x") ?? "y")
