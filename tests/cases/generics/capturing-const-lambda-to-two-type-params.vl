// @run
// @log 4
// @log y
// @log 4
// @log 3
// @log w
// @log y
// @log w
// @log 3
// @log 6
// @log z
// @log 6
// @log 5
// A capturing `const` lambda handed to two type parameters of one call, each called at its own type:
// each parameter pins the lambda at the type the elaboration closes it to (D15604).
function midTwo<F, G>(a: F, b: G) {
  print(a("y"))
  print(b(3))
}
function outerTwo<U>(u: U) {
  const same = (k) => {
    print(u)
    k
  }
  midTwo(same, same)
}
outerTwo(4)
outerTwo("w")
function midClosed<F, G>(a: F, b: G) {
  print(a("z"))
  print(b(5))
}
function outerClosed(u: i32) {
  const pass = (k) => {
    print(u)
    k
  }
  midClosed(pass, pass)
}
outerClosed(6)
