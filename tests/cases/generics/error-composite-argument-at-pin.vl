// @check
// @error cannot assign boolean[] to 'a' of type f64[] — a `boolean` is not a number; convert each element with `b as f64` (the body of `local`
// @error argument of type boolean[] flows into `r` expecting f64[] — a `boolean` is not a number; convert each element with `b as f64`
// @error argument of type boolean[] flows into `l` expecting i64[] — a `boolean` is not a number; convert each element with `b as i64`
// @error argument of type boolean[] flows into `h` expecting f64[] — a `boolean` is not a number; convert each element with `b as f64`
// @error argument of type boolean[] flows into `h` expecting f64[] — a `boolean` is not a number; convert each element with `b as f64`
// @error argument of type boolean[] flows into `h` expecting f64[] — a `boolean` is not a number; convert each element with `b as f64`
// A list carrying a type parameter — a spread of `T[]`, a `T[]` value, or a literal of `T` —
// delivered at a concrete list is asked the direct spelling's question at the pin, at a
// binding and at an argument and a rest parameter, once at the pin that closes it (D3253).
function local<T>(xs: T[]) {
  const a: f64[] = [...xs]
  return a[0] / 4.0
}
function r(...ys: f64[]) { return ys[0] / 4.0 }
function rest<T>(xs: T[]) { return r(...xs) }
function l(ys: i64[]) { return ys.length }
function whole<T>(xs: T[]) { return l(xs) }
function h(ys: f64[]) { return ys[0] / 4.0 }
function lit<T>(x: T) { return h([x]) }
function spread<T>(xs: T[]) { return h([...xs]) }
function hop<T>(xs: T[]) { return h(xs) }
print(local([3 > 2]))
print(rest([3 > 2]))
print(whole([3 > 2]))
print(lit(3 > 2))
print(spread([3 > 2]))
print(hop([3 > 2]))
