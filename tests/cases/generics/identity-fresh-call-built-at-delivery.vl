// @run
// @log 15
// @log 17
// @log 18
// @log 19
// @log 20
// @log 21
// @log 22
// @log 23
// @log 24
// D8020: a fresh call handed through a generic identity is built at the record it is delivered
// to, though a declared record (`Col`) spells the call's own fields, and the identity's instance
// is taken there. Binding, two-leaf function, argument, list element, inferred return, list
// `push`, map `set` and a binding read at both types each print the widened field.
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function idn<T>(v: T): T { v }
function mk() { { r: 15, g: 1 } }
function mkB(b: boolean) {
  if b { return { r: 16, g: 1 } }
  { r: 17, g: 2 }
}
function mkA() { { r: 18, g: 1 } }
function mkL() { { r: 19, g: 1 } }
function mkR() { { r: 20, g: 1 } }
function mkP() { { r: 21, g: 1 } }
function mkS() { { r: 22, g: 1 } }
function mkH() { { r: 23, g: 1 } }
function dl() { return idn(mkR()) }
function take(j: J) { print(j.r ?? 0) }

const m: J = idn(mk())
print(m.r ?? 0)
const n: J = idn(mkB(false))
print(n.r ?? 0)
take(idn(mkA()))
const xs: J[] = [idn(mkL())]
print(xs[0].r ?? 0)
const d = dl()
const dj: J = d
print(dj.r ?? 0)
const ps: J[] = []
ps.push(idn(mkP()))
print(ps[0].r ?? 0)
const mm: { [string]: J } = Map()
mm.set("k", idn(mkS()))
const mv = mm["k"]
if mv != null { print(mv.r ?? 0) }
const h = idn(mkH())
const hj: J = h
print(hj.r ?? 0)
print(h.r + 1)
