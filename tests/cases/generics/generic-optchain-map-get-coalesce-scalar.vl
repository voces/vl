// @run
// @log 5
// @log 7
// @log 8
// @log s
// @log 1.5
// @log true
// @log 3
// @log 4
// D10130: a generic's `k?.get("a") ?? d` over a nullable map, pinned at scalar and ref value
// types, and the same `??` over a written `if` with a `null` arm.
function f<V>(k: {[string]: V} | null, d: V): V { k?.get("a") ?? d }
const m: {[string]: i32} = Map()
m["a"] = 5
const e: {[string]: i32} = Map()
const n: {[string]: i32} | null = null
print(f(m, 0))
print(f(e, 7))
print(f(n, 8))
const s: {[string]: string} = Map()
s["a"] = "s"
print(f(s, "z"))
const fl: {[string]: f64} = Map()
fl["a"] = 1.5
print(f(fl, 0.25))
const b: {[string]: boolean} = Map()
print(f(b, true))
function g<V>(k: V | null, d: V): V { (if k == null { null } else { k }) ?? d }
print(g(3, 4))
print(g(null, 4))
