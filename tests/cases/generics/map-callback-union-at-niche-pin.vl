// @run
// @log null
// @log s
// @log null
// @log 1
// @log null
// @log b
// @log null
// @log b
// @log true
// D3140, D3149: a `.map` callback's declared `T | X` at a pin that makes it `X | null` is that
// niche, not a box holding `X` twice; a nullable literal union entering a box widens its member
// to the string arm and its sentinel to `null`; and a box whose litunion arm rides as a string
// reads through the row that holds the string arm.
type K = "a" | "b"
function g<T>(x: T) { const m = [x].map((e): T | string => e); print(m[0]) }
const a: string | null = null
g(a)
const a2: string | null = "s"
g(a2)
function h<T>(x: T): (T | f64)[] { return [x].map((e): T | f64 => e) }
const b: boolean | null = null
const r = h(b)
print(r[0])
function k<T>(x: T) {
  const m = [x].map((e): T | boolean => e); print(m.length)
}
k(b)
function j<T>(x: T) { const m = [x].map((e): T | boolean => e); print(m[0]) }
const c: K | null = null
j(c)
const c2: K | null = "b"
j(c2)
function i<T>(x: T) { const m = [x].map((e): T | string => e); print(m[0]) }
i(c)
i(c2)
function n<T>(x: T) {
  const m = [x].map((e): T | string => e); print(m[0] == null)
}
n(c)
