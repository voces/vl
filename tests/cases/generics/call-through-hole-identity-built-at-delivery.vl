// @run
// @log 9
// @log 3
// @log 4
// @log 5
// @log 7
// D14730: a call handed through a hole identity is built where another call of the same
// function is delivered, read in place, nested, or through a rebinding identity.
type Circle = { r: i32 | null }
function sink(x: Circle) { print(x.r ?? 9) }
function id(x) { return x }
function id2(x) {
  const y = x
  return y
}
function mkcall() { { r: null } }
sink(mkcall())
const y = id(mkcall())
print(y.r ?? 3)
print(id(mkcall()).r ?? 4)
const z = id2(id(mkcall()))
print(z.r ?? 5)
const z2 = id2(mkcall())
print(z2.r ?? 7)
