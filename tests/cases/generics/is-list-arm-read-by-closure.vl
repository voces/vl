// @run
// @log 10
// @log 1
// @log 0.5
// @log 20
// @log 1
// A closure declared in an `is K[]` arm reads its capture as the arm's empty `K[]` when the
// capture is an empty list of other elements (D4935, D4771): a length read, a `for` over it, and
// a closure stored in a list. Delivering it whole as `K[]` is refused (D4963).
function s<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    print(k())
  }
  print(a.length)
}
s([1])
function t<V>(a: V[]) {
  const q: V[] = []
  if q is f64[] {
    const j = () => {
      let s = 0.5
      for x in q { s = s + x }
      s
    }
    print(j())
    const fs: (() => i32)[] = []
    fs.push(() => q.length + 20)
    print(fs[0]())
  }
  print(a.length)
}
t([1])
