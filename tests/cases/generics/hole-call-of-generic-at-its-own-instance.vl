// @run
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_k` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 3
// @log 4
// @log 5
// @log s
// @log 2
// @log 0
// @log 0
// @log 2
// @log 2
// @log 1
// @log 0.5
// @log q
// A declared generic handed to a hole is called at its own instance for each hole call's
// argument types, as the direct call binds them: a `T | null` parameter (D6541), an empty list
// literal's element where nothing else binds it (D6542), and a literal adopting the type an
// earlier argument bound (D6544).
function orz<T>(v: T | null, d: T): T { v ?? d }
function same<T>(_x: T | null, y: T): T { y }
function viaOrz(a) {
  print(a(null, 3))
  print(a(4, 3))
  print(a(null, 5))
  print(a(null, "s"))
}
viaOrz(orz)
function viaSame(a) { print(a(null, 2)) }
viaSame(same)
function len<T>(k: T[]) { k.length }
function keep<T>(k: T[]): T[] { k }
function first<T>(_k: T[], d: T): T { d }
function viaLen(a) { print(a([])) }
viaLen(len)
function viaKeep(a) { print(a([]).length) }
viaKeep(keep)
function viaTwo(a) { print(a(["x", "y"])) }
viaTwo(len)
function viaFirst(a) { print(a([], 2)) }
viaFirst(first)
function pair<T>(_x: T, y: T): T { y }
function viaPair(a) {
  print(a(2.5, 1))
  print(a(2.5, 1) / 2.0)
  print(a("p", "q"))
}
viaPair(pair)
