// @run
// @log 1
// @log 2.5
// @log s
// @log 1
// @log 2.5
// @log w
// @log 2.5
function g<T>(b: boolean, t: T) {
  const v: {f: i32} | {f: T} = if b { { f: 1 } } else { { f: t } }
  print(v.f)
}
function h<T>(t: T) {
  const v: {f: T} | {f: i32} = { f: t }
  print(v.f)
}
g(true, 2.5)
g(false, 2.5)
g(false, "s")
g(true, "s")
h(2.5)
h("w")
const k: {f: i32} | {f: f64} = { f: 2.5 }
print(k.f)
