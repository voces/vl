// @run
// @log 1
// @log 10
// @log 2
// @log 1
// @log 10
// @log 0
// @log 0
// @log 10
// @log 0
// `is K[]` over a union or nullable receiver whose list arm can never hold a `K` is true exactly
// when that arm holds an empty list: the arm's tag or non-null test guards the emptiness test,
// and the arm reads the empty `K[]` (D4912).
function probe<V>(v: V[] | string) {
  if v is f64[] { return 1 }
  0
}
function box<V>(v: V[] | string) {
  if v is f64[] { return v.length + 10 }
  if v is string { return 1 }
  2
}
function opt<V>(v: V[] | null) {
  if v is f64[] { return v.length + 10 }
  0
}
function guarded<V>(v: V[] | null) {
  if v != null && v is f64[] { return v.length + 10 }
  0
}
const e: i32[] = []
const f = [4]
print(probe(e))
print(box(e))
print(box(f))
print(box("s"))
print(opt(e))
print(opt(f))
print(opt(null))
print(guarded(e))
print(guarded(null))
