// @run
// @log 5
// @log 1
// @log 8
// @log 1
// A NESTED generic application as a UNION ARM (`Box<Box<i32>> | i32`) — the SILENT face of the
// `>>` close-credit fold that `nested-application-close-continuation.vl` pins everywhere else.
//
// The lexer fuses `>>` into one token, so the inner close banks the second `>` and the OUTER
// argument list is still open; the argument's own union loop then read the outer `|` and folded
// the two ARMS into the single type `Box<Box<i32>|i32>`. Nothing about that is a union, so:
//
//   - `is` on the arm CONST-FOLDED TO FALSE (`monoStaticIsResult` — no union rep to tag-test),
//     and `if u is Box<Box<i32>> { … } else { … }` took the ELSE branch for a value that IS a
//     member of that arm. `vl check` rc 0, no diagnostic, wrong branch;
//   - the assignment side accepted `{ v: 5 }` — an `i32` where `Box<i32>` is demanded — because
//     the folded argument's own union made `i32` a legal `v` (`…-literal-reject.vl` is that
//     half, and the DEPTH-1 spelling below is why genericity was never the axis).
//
// THE READ INSIDE THE STRUCT ARM IS NOT PINNED HERE, and that is a separate defect, not an
// omission: a union variant carrying a STRUCT-TYPED field has no emitted read
// (`error-nested-struct-union-arm-read.vl`), so the strongest oracle available for the struct
// arm is the guard's own answer. It still moves — FALSE before, TRUE after.
type Box<T> = { v: T }

// DEPTH 1, the discriminating control: one `>` closes it, nothing is banked, and this spelling
// was always correct. Genericity is not the axis; the fused close token is.
type U1 = Box<i32> | i32
const p: U1 = { v: 5 }
if p is Box<i32> { print(p.v) } else { print(0) }

// DEPTH 2 — the value below is a well-typed member of the `Box<Box<i32>>` arm, so the guard
// must answer TRUE. It answered FALSE.
type U2 = Box<Box<i32>> | i32
const a: U2 = { v: { v: 5 } }
if a is Box<Box<i32>> { print(1) } else { print(0) }

// The OTHER arm of the same union, which the fold made unreachable: `8` did not type-check
// against `Box<Box<i32>|i32>` at all.
const b: U2 = 8
if b is i32 { print(b) } else { print(0) }
if b is Box<Box<i32>> { print(0) } else { print(1) }
