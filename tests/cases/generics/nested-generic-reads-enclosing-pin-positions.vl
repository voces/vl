// @run
// @log true
// @log true
// @log b=true
// @log true
// @log false
// @log true
// @log b
// @log b
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log 3
// @log 3
// @log true
// @log 2.5
// @log 3
// @log false
// @log false
// @log true
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// More positions where a nested generic's instance reads a value at its enclosing function's
// type parameter (D3831): each prints the `boolean` or literal-union value, not its `i32` rep.
function show<V>(v: V) { print(v) }

// Returned from the nested generic, bound, interpolated and stored in a list.
function ret<T>(x: T) {
  function inR<U>(_u: U): T { x }
  const r = inR(1)
  print(r)
  const rs = [inR(3)]
  print(rs[0])
  print("b=\{inR(2)}")
}
ret(true)

// A for-in over the captured list, at `boolean` and at a literal union.
function loop<T>(x: T, y: T) {
  const ys = [x, y, x]
  function inL<U>(_u: U) {
    for e in ys { print(e) }
  }
  inL(1)
}
loop(true, false)
const lb: "a" | "b" = "b"
function loopLit<T>(x: T) {
  const ys = [x, x]
  function inLL<U>(_u: U) {
    for e in ys { print(e) }
  }
  inLL(1)
}
loopLit(lb)

// A nullable boolean, read directly, as an element and in a loop.
const nb: boolean | null = true
function nul<T>(x: T) {
  const ys = [x]
  function inN<U>(_u: U) {
    print(x)
    print(ys[0])
    for e in ys { print(e) }
  }
  inN(1)
}
nul(nb)

// Passed on to a third generic, from the nested generic and from a lambda in the enclosing one.
function third<T>(x: T) {
  const ys = [x, x]
  function inS<U>(_u: U) { show(ys[1]) }
  inS(1)
  const g = () => show(ys[0])
  g()
}
third(true)

// An un-annotated enclosing function, its captured list looped over at two pins.
function hole(x) {
  const ys = [x]
  function inH<U>(_u: U) {
    for e in ys { print(e) }
    print(ys[0])
  }
  inH(1)
}
hole(true)
hole(3)

// Two outer functions, each with a nested generic of the same name, interleaved.
function p<T>(x: T) {
  const xs = [x]
  function inner<U>(_u: U) { print(xs[0]) }
  inner(1)
}
function q<T>(x: T) {
  const xs = [x]
  function inner<U>(_u: U) { print(xs[0]) }
  inner(1)
}
p(true)
q(2.5)
p(3)
q(false)
p(false)
q(true)
