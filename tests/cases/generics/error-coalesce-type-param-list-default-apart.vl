// @error at the call's argument types, the branches of an `if`, `match` or `??` in the body of `h` join string[] and i32[]: it returns string[] | i32[], which the call reads as string[]
// D2799: a generic body types `xs ?? [1]` over `T[] | null` as `T[]`, so the pin `T := string`
// would build the `i32` default into a `string[]` result. Returned, it is the `if` it spells and
// is refused at the call (D2846); the pins whose storage agrees run (`coalesce-type-param-list-default-agrees.vl`).
function h<T>(xs: T[] | null) { xs ?? [1] }
const q = h(["a"])
if q is string[] { print(q[0]) } else { print(-1) }
