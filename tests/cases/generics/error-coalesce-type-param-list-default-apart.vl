// @emit-error `??` over a list whose default is a list of another storage
// D2799: a generic body types `xs ?? [1]` over `T[] | null` as `T[]`, so the pin `T := string`
// would build the `i32` default into a `string[]` result. Refused loudly until the `??` is typed
// apart (D2843); the pins whose storage agrees run (`coalesce-type-param-list-default-agrees.vl`).
function h<T>(xs: T[] | null) { xs ?? [1] }
const q = h(["a"])
if q is string[] { print(q[0]) } else { print(-1) }
