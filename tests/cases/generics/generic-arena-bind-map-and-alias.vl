// A type parameter is bound from the argument's type against the parameter's, so it binds
// inside a map's value (D2487, D2494, D2658), through a generic record alias whose argument
// carries no alias head (D3688, D4709), and inside a nullable function parameter (D3933).
function tot<T>(m: {[i32]: T}) { m.length }
function hs<T>(m: {[string]: T}, k: string) { m.has(k) }
function rd<V>(m: {[string]: V}, k: string): V | null { m[k] }
function g<V>(m: {[string]: V}) { m.length }
const m: {[i32]: string} = Map()
m[1] = "a"
print(tot(m))
const si: {[string]: i32} = Map()
si["a"] = 4
const ss: {[string]: string} = Map()
ss["b"] = "q"
print(hs(si, "a"))
print(hs(ss, "a"))
print(rd(si, "a") ?? 0)
print(rd(ss, "b") ?? "-")
print(rd(si, "z") ?? 0)
const mb: {[string]: boolean} = Map()
print(g(mb))
print(g(si) + g(ss))

type B<T> = { x: T }
type V = { x: i32 }
function getX<T>(r: B<T>): T { r.x }
print(getX({ x: 7 }))
const dv: V = { x: 8 }
print(getX(dv))
const a = { x: 9 }
print(getX(a))
print(getX({ x: "s" }))
type W<T> = { v: T }
function getV<T>(w: W<T>): T { return w.v }
function firstV<T>(ws: W<T>[]): T { ws[0].v }
print(getV({ v: 7 }))
print(firstV([{ v: 7 }]))

function take<Q>(f: ((v: Q) => void) | null, v: Q) {
  if f != null { f(v) } else { print("none") }
}
function aa(x: f64) {
  take(null, x)
  take((t: f64) => print(t), x)
}
aa(2.5)
function gen<Q>(x: Q) { take((t: Q) => print(t), x) }
gen(3)
