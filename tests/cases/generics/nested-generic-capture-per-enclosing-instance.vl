// @log 0.5
// @log u
// @log 0.5
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// A nested function with its own type parameter, capturing its enclosing function's parameter:
// each instance of the enclosing function calls an instance whose env holds that instance's
// capture, not one shared across them at the first instance's type (D3826).
type A = { v: i32 }

// The reviewed witness, through a closure in the nested generic.
function outer<T>(x: T) {
  function inner<U>(u: U) {
    const g = () => {
      print(x)
      print(u)
    }
    g()
  }
  inner(1)
}
outer(7)
outer("s")

// The string instance first, then a third instance, and a `U` of another rep than the capture.
function first<T>(x: T) {
  function innerF<U>(_u: U) { print(x) }
  innerF(1)
}
first("s")
first(7)
first(2.5)
function twice<T>(x: T) {
  function innerT<U>(u: U) {
    print(x)
    print(u)
  }
  innerT("q")
}
twice(7)
twice("s")

// An un-annotated enclosing function handing a record back, and two levels of nesting.
function hole(x) {
  function innerH<U>(_u: U) { x }
  innerH(1)
}
const a: A = { v: 4 }
print(hole(a).v)
print(hole("t"))
function deep<T>(x: T) {
  function mid<V>(v: V) {
    function innerD<U>(_u: U) {
      print(x)
      print(v)
    }
    innerD(1)
  }
  mid(0.5)
}
deep(9)
deep("u")
