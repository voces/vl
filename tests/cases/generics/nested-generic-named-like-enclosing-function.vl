// @run
// @warning This function always recurses: every path through `a` calls it again, so the call never returns
// @log true
// @log 2
// A nested generic named like its enclosing function is called as itself, and the enclosing
// function's own demand stays its own (D3895).
function a<T>(x: T) {
  function a<T>(y: T) { print(y) }
  a(true)
  const n: i32 = x
  print(n + 1)
}
a(1)
