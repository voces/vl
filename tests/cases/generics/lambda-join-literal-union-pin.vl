// @run
// @log true
// @log null
// @log true
// @log false
// @log true
// @log false
// @log false
// @log a
// @log false
// @log b
// @log 4
// A lambda joining two type parameters at a literal-union pin returns the join's box, so the
// caller reads each arm as itself (D3358).
type K = "a" | "b"
function g<T0, T1>(a0: T0, a1: T1, k: i32) {
  const f = (j: i32) => if j == 0 { a0 } else { a1 }
  const e = f(k)
  print(e is null)
  print(e)
  print(e == null)
}
const x0: K | null = null
const x1 = true
g(x0, x1, 0)
g(x0, x1, 1)
const y0: K | null = "a"
g(y0, x1, 0)
function h<T0, T1>(a0: T0, a1: T1, k: i32) {
  const f = (j: i32) => if j == 0 { a0 } else { a1 }
  print(f(k))
}
const z0: K = "b"
h(z0, 4, 0)
h(z0, 4, 1)
