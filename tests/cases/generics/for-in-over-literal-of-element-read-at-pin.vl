// @run
// @hint redundant type annotation: `b` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `i` is inferred as `i32` — remove it to lean on inference
// @log true
// @log null
// @log false
// @log true
// @log a
// @log 1
// A `<T>` function's `for`-in over a list literal of an element read or a local holding one
// binds the loop variable at the pin: a `boolean`, `boolean | null` or literal union prints as
// itself, not as its `i32` cell (D3065).
type ABN = "a" | "b" | null
function f<T>(x: T) {
  const l = [x]
  for e in [l[0]] { print(e) }
}
const t: boolean | null = true
f(t)
const n: boolean | null = null
f(n)
const b: boolean = false
f(b)
function g<T>(x: T) {
  const l = [x]
  const y = l[0]
  for e in [y] { print(e) }
}
g(t)
const a: ABN = "a"
g(a)
const i: i32 = 1
g(i)
