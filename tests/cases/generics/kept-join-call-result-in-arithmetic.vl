// @run
// @log 6
// @log 10
// @log 14
// @log 7.5
// @log 6
// A generic call whose return set keeps a literal arm apart from its type-parameter arms is the
// join its instance returns, so arithmetic over the call reads the box (D15635).
function lit<A, B>(k: i32, a: A, b: B) {
  if k == 0 { return a }
  if k == 1 { b } else { 5 }
}
function lit2(k: i32, a: i64, b: i64) {
  if k == 0 { return a }
  if k == 1 { b } else { 5 }
}
const z: i64 = 9
const w = 6.5
print(lit(2, z, z) + 1)
print(lit(0, z, z) + 1)
print(lit(2, z, z) + lit2(1, z, z))
print(lit(1, w, w) + 1)
print(lit(2, 7, 8) + 1)
