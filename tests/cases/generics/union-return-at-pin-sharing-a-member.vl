// @run
// @log 4
// @log 4
// A generic `T | i32` at `T := Sq | i32` is `Sq | i32`, the pin's own union, not a union
// holding `Sq | i32` beside a second `i32` (D3150), returned whole and as a list element.
type Sq = { s: i32 }
function g<T>(x: T): T | i32 { return x }
function gl<T>(x: T): (T | i32)[] { return [x] }
const a: Sq | i32 = 4
const v = g(a)
if v is i32 { print(v) }
const e = gl(a)[0]
if e is i32 { print(e) }
