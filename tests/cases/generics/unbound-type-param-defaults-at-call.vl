// @run
// @hint Intentionally-unused parameter `_v` (leading `_` marks it unused)
// @log 2
// @log 2
// @log 2
// @log 2
// @log 0
// @log 12
// @log true
// @log 1
// @log true
// @log false
// @log 1
// @log true
// @log true
// @log true
// @log 1
// @log 1
// @log 1
// A type parameter no parameter names stays unbound at an inferred call and defaults there
// (D4551); a local typed by it holds no values, so none of these uses can tell which: the local
// passes to a generic, sits in a nullable or a list, and answers every `is K[]` true because
// it is empty (D4910). An explicit binding still picks its own instance.
function inner<V>(_v: V) { return 1 }
function innerL<V>(v: V[]) { return v.length + 5 }
function opT<T, U>(a: T[]) {
  const q: U[] = []
  return inner(q) + a.length
}
const a = [1]
print(opT(a))
print(opT<i32, i32>(a))
print(opT<i32, f64>(a))
print(opT<i32, string>(a))
function countOf<T>() {
  const xs: T[] = []
  return xs.length
}
print(countOf())
function lists<T, U>(a: T[]) {
  const q: U[] = []
  return inner<U[]>(q) + innerL(q) + innerL<U>(q) + a.length
}
print(lists(a))
function nullable<T, U>(a: T[]) {
  const q: U | null = null
  print(q == null)
  print(inner(q))
  const c = () => q == null
  print(c())
  print(q is f64)
  return a.length
}
print(nullable(a))
function probeL<V>(v: V[]) {
  if v is f64[] { return 1 }
  if v is i32[] { return 2 }
  0
}
function tests<T, U>(a: T[]) {
  const q: U[] = []
  print(q is f64[])
  print(q is string[])
  print(q is boolean[])
  print(probeL(q))
  const k = () => probeL(q)
  print(k())
  return a.length
}
print(tests(a))
