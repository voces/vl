// @run
// @log 1.5
// @log 4
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.30000001192092896
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.20000000298023224
// @log 0.30000001192092896
// @log 0.30000001192092896
// @log 0.30000001192092896
// @log 0.6000000238418579
// @log 9223372036854775807
// @log 4000000007
// @log 7
// @log true
// @log 7
// @log 2.5999999046325684
// @log 2
// @log 2.5
// A type parameter that only LITERAL arguments bind takes its type from the call's
// destination, as a bare literal does (D3539, sunpa SP-007). `filled(4, 0.0)` into an
// `f32[]` is `filled<f32>(4, 0.0)`; on its own the literal would bind `T = f64` and the
// result would not fit. Each line delivers the call at one position, and each prints a value
// computed at the element type, so `+ 0.1` at f32 reads 0.2000000029…, never 0.2.
import { concat, filled } from "std:array"

// The consumer's witness: a zeroed f32 grid in one call.
const hs: f32[] = filled(4, 0.0)
hs[1] = 1.5
print(hs[1] + hs[0])
print(hs.length)

// Every delivery position: a local, assignment, return, tail, argument, field, element, push,
// map set, the arms of an `if` and a `match`, a lambda's result, and a spread.
function atLet() {
  const v: f32[] = filled(3, 0.1)
  print(v[0] + 0.1)
}
atLet()
let g: f32[] = []
g = filled(3, 0.1)
print(g[2] + 0.1)
function ret(): f32[] { return filled(3, 0.1) }
print(ret()[0] + 0.1)
function tail(): f32[] { filled(3, 0.1) }
print(tail()[0] + 0.1)
function take(v: f32[]) { print(v[0] + 0.1) }
take(filled(3, 0.1))
type Grid = { cells: f32[] }
const r: Grid = { cells: filled(3, 0.1) }
print(r.cells[0] + 0.1)
const rows: f32[][] = [filled(3, 0.1)]
print(rows[0][0] + 0.1)
const pushed: f32[][] = []
pushed.push(filled(3, 0.1))
print(pushed[0][0] + 0.1)
const byName: {[string]: f32[]} = Map()
byName["a"] = filled(2, 0.1)
print((byName["a"] ?? [])[0] + 0.1)
const pick = true
const arm: f32[] = if pick { filled(3, 0.1) } else { filled(2, 0.2) }
print(arm[0] + 0.2)
const k = 1
const viaMatch: f32[] = match k {
  1 => filled(3, 0.1)
  _ => filled(1, 0.2)
}
print(viaMatch[0] + 0.1)
const mk: () => f32[] = () => filled(3, 0.1)
print(mk()[0] + 0.1)
const nested: f32[][] = filled(2, filled(3, 0.1))
print(nested[1][2] + 0.1)
const spread: f32[] = [...filled(2, 0.1), 0.2]
print(spread[0] + spread[2])

// Other generics: `concat` in both spellings, and a literal `const`, typed per use.
const joined: f32[] = concat([0.1], [0.2])
print(joined[0] + joined[1])
const dotted: f32[] = [0.1].concat([0.2])
print(dotted[0] + dotted[1])
const HALF = 0.5
const fromConst: f32[] = filled(2, HALF)
print(fromConst[0] + 0.1)

// An integer destination: a wide integer list. A scalar `i64` keeps the `i32` instance, which
// it can be delivered from, so only the list (which it cannot) rebinds.
function mkList<T>(x: T): T[] { [x, x] }
const wide: i64[] = mkList(7)
print(wide[1] + 9223372036854775800)
function id<T>(x: T): T { x }
const big: i64 = id(7)
print(big + 4000000000)

// Unions: a literal union, a union with a boxed arm, and a nullable float.
type Small = 1 | 2 | 7
const smalls: Small[] = mkList(7)
print(smalls[0])
const mixed: (i32 | string)[] = filled(2, 7)
print(mixed[0] is i32)
print(mixed[1])
const maybe: (f32 | null)[] = filled(2, 2.5)
print((maybe[0] ?? 0.0) + 0.1)

// A body that computes on `T` keeps the instance its arguments choose wherever that instance
// can be delivered: `half(5)` into an `f64` is master's `half<i32>`, so it prints 2, not 2.5.
// Only an instance that cannot be delivered is replaced, and only within the literal's kind.
function half<T>(x: T): T { x / 2 }
const kept: f64 = half(5)
print(kept)
function halves<T>(x: T): T[] { [x / 2] }
const fhalves: f32[] = halves(5.0)
print(fhalves[0])
