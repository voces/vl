// @run
// @log 7
// @log 1
// @log 2
// @log 9
// @log 3
// @log 4
// @hint redundant type annotation: `xs` is inferred as `{v: {v: i32}}[]`
// @hint redundant type annotation: `ys` is inferred as `{v: {v: {v: i32}}}[]`
// @hint redundant type annotation: `bw` is inferred as `{v: {v: i32}, w: i32}`
// A NESTED generic application (`Box<Box<i32>>`) followed by a type-grammar CONTINUATION —
// `|`, `&`, or `[]`. The lexer fuses `>>` into ONE token (`SHR`), so the inner close consumes
// the whole token and banks the extra `>` as a credit the enclosing close drains. While that
// credit is outstanding the enclosing argument list is still OPEN and the next token can only
// be its close — but the argument's own union / intersection / array-suffix loops read the raw
// next token, so the OUTER continuation was folded INTO the argument:
//
//     Box<Box<i32>> | null   parsed as   Box<Box<i32>|null>
//     Box<Box<i32>>[]        parsed as   Box<Box<i32>[]>
//     Box<Box<i32>> & W      parsed as   Box<{v:i32,w:i32}>
//
// Each cell below is that fold in the position where it is observable; every one of them was a
// type error against the mis-built type. (The UNION-ARM position is the same fold's SILENT
// face and has its own case — `nested-application-union-arm.vl`.) The generic argument list's
// `,` loop already consulted the credit, which is why a multi-argument application never had
// this and a nested one always did.
//
// THE CREDIT IS THE DISCRIMINATOR, NOT THE TOKEN, so the last cell is the control:
// `Box<Box<i32> | i32>` closes the inner application with a plain `>`, banks nothing, and its
// `|` must still extend the ARGUMENT — the very tree the fold produced by accident above. Two
// spellings, two trees, from the same continuation token.
type Box<T> = { v: T }
type W = { w: i32 }

// `|` — the NULLABLE niche (one non-null member: a nullable ref, not a box).
const nn: Box<Box<i32>> | null = { v: { v: 7 } }
if nn != null { print(nn.v.v) }

// `[]` — an array OF the nested application. The suffix belongs to the outer type.
const xs: Box<Box<i32>>[] = [{ v: { v: 1 } }, { v: { v: 2 } }]
print(xs[0].v.v)
print(xs[1].v.v)

// `>>>` closes THREE levels and banks TWO credits, so the suffix has to survive both drains.
const ys: Box<Box<Box<i32>>>[] = [{ v: { v: { v: 9 } } }]
print(ys[0].v.v.v)

// `&` — the intersection operand, which the fold absorbed into the argument and then
// SIMPLIFIED, leaving a one-field `Box<{v:i32,w:i32}>` carrying no `w` at the top level.
const bw: Box<Box<i32>> & W = { v: { v: 5 }, w: 3 }
print(bw.w)

// THE CONTROL — no credit is banked, so this `|` really does extend the ARGUMENT.
const g: Box<Box<i32> | i32> = { v: 4 }
if g.v is i32 { print(g.v) } else { print(0) }
