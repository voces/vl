// @log c
// @log s
// @log s
// A generic function handed to a callback parameter whose type the other arguments bind to the
// enclosing generic's T, alone and in a list, at two instances (D3913).
function run<V>(g: (v: V) => void, v: V) { g(v) }
function runAll<V>(gs: ((v: V) => void)[], v: V) {
  gs[0](v)
  gs[1](v)
}
function b<U>(y: U) { print(y) }
function c<U>(y: U) { print("c"); print(y) }
function a<T>(x: T) {
  run(b, x)
  runAll([c, b], x)
}
a(2.5)
a("s")
