// One capturing hole function handed to two parameters of one type parameter, each called at its
// own type, is one bundle for both (D15598).
function mid<F>(a: F, b: F) {
  print(a("x"))
  print(b(2))
}
function outer<U>(u: U) {
  function same(k) {
    print(u)
    k
  }
  mid(same, same)
}
outer(7)
outer(true)

// The same handed to two type parameters, and through a closed encloser at three calls.
function midTwo<F, G>(a: F, b: G) {
  print(a("y"))
  print(b(3))
}
function outerTwo<U>(u: U) {
  function same(k) {
    print(u)
    k
  }
  midTwo(same, same)
}
outerTwo(4)
outerTwo("w")
function midThree<F>(a: F, b: F) {
  print(a("z"))
  print(b(5))
  print(a(6))
}
function outerThree(u: i32) {
  function same(k) {
    print(u)
    k
  }
  midThree(same, same)
}
outerThree(9)
