// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log w
// @log 9
// @log u
// A binding of a type parameter nothing else reads, seeded from a top-level generic, beside one
// seeded from another parameter: each holds and runs its own generic (D17870).
function same<T>(k: T): T { return k }
function other<T>(k: T): T { return k }
function m2<F>(_a: F) {
  const b: F = other
  print(b("w"))
}
m2(same)
function m5<F, G>(a: F, a1: G) {
  const b: F = a1
  print(a(9))
  print(b("u"))
}
m5(same, other)
