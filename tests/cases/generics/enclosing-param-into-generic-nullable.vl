// @log 7
// A generic's own parameter handed back as `() => x` into `() => T | null` at `U = null`:
// `T | null` at `T = null` is `null`, in the inferred and the annotated face (D10271).
function len<T>(f: () => T | null) {
  const t = f()
  if t == null { 0 } else { 1 }
}
function outer<U>(x: U) { print(len(() => x)) }
outer(null)
outer(5)
outer("s")
function outerAnn<U>(x: U) { print(len((): U | null => x)) }
outerAnn(null)
outerAnn(2.5)
function len7<T>(f: () => T | null) {
  const t = f()
  if t == null { 7 } else { 99 }
}
function outer7<U>(x: U) { len7(() => x) }
function take(a) { print(outer7(a)) }
take(null)
