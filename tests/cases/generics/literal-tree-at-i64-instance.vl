// @run
// @log 6442450944
// @log 1099511627776
// @log 6442450949
// A tree of literals in a generic body is a constant, exact before any instance reads it, so the
// `i64` instance adds 3 * 2^31 rather than the 32-bit reading of `3 << 31` (D2712).
function g<T>(x: T): T { x + (3 << 31) }
function h<T>(x: T): T { x + (1 << 40) }
print(g<i64>(0))
print(h<i64>(0))
const five: i64 = 5
print(g(five))
