// @run
// A join of type parameters kept apart, joined again with itself, still keeps two runtime
// numbers apart at the pin: an `i32` arm reads back as itself, not as the `null` (D3569).
function F<A, B>(k: i32, a: A, b: B) {
  const w = if k == 0 { a } else if k == 1 { b } else { null }
  const v = if k >= 0 { w } else { w }
  print(v)
  print(v is i32)
  print((v ?? 0) + 1)
}
F(0, 3, 4.5)
F(1, 3, 4.5)
F(2, 3, 4.5)
function G<A, B>(k: i32, a: A, b: B) {
  const w = if k == 0 { null } else if k == 1 { a } else { b }
  print(if k >= 0 { w } else { w })
}
G(1, 3, 2.5)
G(2, 3, 2.5)
// @log 3
// @log true
// @log 4
// @log 4.5
// @log false
// @log 5.5
// @log null
// @log false
// @log 1
// @log 3
// @log 2.5
