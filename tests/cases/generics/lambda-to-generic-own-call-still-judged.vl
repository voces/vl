// @check
// @error operator '*' is not defined for string and i32
// @error a function of type `(string) => <error>` cannot be used as `(string) => string` here
// A lambda handed to a generic is still judged at its own call's binding (D16855's guard skips
// only another call's lambdas).
function sel<A>(f: (x: A) => A): (x: A) => A { return f }
const h = sel((x) => x * 2)
print(h(4))
const k = sel<string>((x) => x * 2)
print(k("a"))
