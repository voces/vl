// D14785: a void generic's binding written a generic returning a value, delivered to an annotated
// void function type at a binding, an argument, a return, a field and an element, a set of three,
// and called at `f64`, whose twin reads its parameter as written.
function inner<U>(u: U) { print("I"); print(u) }
function retV<V>(v: V): V { print("R"); print(v); v }
function inner3<W>(w: W) { print("J"); print(w) }
function atBinding() {
  let k = inner
  k = retV
  const g: (n: i32) => void = k
  g(3)
}
atBinding()
function call(g: (n: f64) => void) { g(2.5) }
function atArgument() {
  let k = inner
  k = retV
  call(k)
}
atArgument()
function hand(f: (n: boolean) => void): (n: boolean) => void { f }
function atReturn() {
  let k = inner
  k = retV
  const g = hand(k)
  g(true)
}
atReturn()
function third() {
  let k = inner
  k = retV
  k = inner3
  const g: (n: string) => void = k
  g("s")
}
third()
type H = { f: (n: i64) => void }
function atField() {
  let k = inner
  k = retV
  const h: H = { f: k }
  h.f(7 as i64)
}
atField()
function atElement() {
  let k = inner
  k = retV
  const fs: ((n: f32) => void)[] = [k]
  fs[0](1.5 as f32)
}
atElement()
function calledAtF64() {
  let k = inner
  k = retV
  k(2.5)
}
calledAtF64()
