// @run
// @log 10
// @log 0
// @log 20
// @log 0
// @log 0
// @log 31
// An instance's `is K[]` over a list whose elements can never be `K` is a fit exactly when the
// list is empty, and an arm that reads the receiver reads that empty `K[]` (D4911): in the
// `if` arm, and in the rest of a block after a negated test that exits.
function a<V>(v: V[]) {
  if v is f64[] { return v.length + 10 }
  0
}
function b<V>(v: V[]) {
  if !(v is f64[]) { return 0 }
  v.length + 20
}
function c<V>(v: V[]) {
  let n = 0
  if v is string[] { n = v.length + 30 } else { n = v.length + 30 }
  n
}
const e: i32[] = []
const f = [3]
print(a(e))
print(a(f))
print(b(e))
print(b(f))
print(c(e) - 30)
print(c(f))
