// @run
// @log 2
// @log s
// @log 2
// @log 2
// @log 2
// A `??` whose left operand is a generic function value is that value, since a function is
// never null (D15485): called at two instances, and handed to a generic, a closed and an
// un-annotated parameter.
function id<T>(x: T): T { x }
const a = id
const r = a ?? id
print(r(2))
print(r("s"))
function runG<U>(f: (x: U) => U, u: U) { print(f(u)) }
function runC(f: (x: i32) => i32, u: i32) { print(f(u)) }
function runH(f, u) { print(f(u)) }
runG(r, 2)
runC(r, 2)
runH(r, 2)
