// @hint redundant type annotation: `a` is inferred as `boolean`
// @hint redundant type annotation: `b` is inferred as `boolean`
// @hint redundant type annotation: `p` is inferred as `boolean`
// @hint redundant type annotation: `q` is inferred as `boolean`
// @hint redundant type annotation: `r` is inferred as `boolean`
// Exact keying follows a cycle of generics: `b`, `p` and `q` reach the `is` only through a template
// still being asked, and each still gets one instance per exact pin (D2684).
function a<T>(u: T | null, n: i32): boolean {
  if n > 0 { return b<T>(u, n - 1) }
  let v = u
  v = u
  v is Set<i32>
}
function b<T>(u: T | null, n: i32): boolean { a<T>(u, n) }
function p<T>(u: T | null, n: i32): boolean { q<T>(u, n) }
function q<T>(u: T | null, n: i32): boolean { r<T>(u, n) }
function r<T>(u: T | null, n: i32): boolean {
  if n > 0 { return p<T>(u, n - 1) }
  const v = u
  v is Set<i32>
}
const s: Set<i32> = Set()
const m: {[i32]: boolean} = Map()
print(a<Set<i32>>(s, 1))
print(a<{[i32]: boolean}>(m, 1))
print(a<{[i32]: boolean}>(m, 0))
print(a<Set<i32>>(s, 0))
print(b<{[i32]: boolean}>(m, 1))
print(b<Set<i32>>(s, 1))
print(p<{[i32]: boolean}>(m, 2))
print(p<Set<i32>>(s, 2))
print(q<Set<i32>>(s, 0))
print(q<{[i32]: boolean}>(m, 0))
