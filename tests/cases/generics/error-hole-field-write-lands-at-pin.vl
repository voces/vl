// @check
// @error no field 's' on A (the body of `viaParam` at the call's argument types)
// @error no field 's' on A (the body of `viaHole` at the call's argument types)
// A write to a hole's field re-narrows it to the member the value lands on at the pin, so a read
// of the member the `is` test left is refused there, as the direct spelling refuses it (D3233).
type A = { v: i32 }
type B = { s: string }
function viaParam<Z>(z: Z) {
  if z.h is A {
    print(z.h.v)
  } else {
    z.h = { v: 9 }
    print(z.h.s)
  }
}
function viaHole(z) {
  if z.h is A {
    print(z.h.v)
  } else {
    z.h = { v: 9 }
    print(z.h.s)
  }
}
const x: { h: A | B } = { h: { s: "bee" } }
viaParam(x)
viaHole(x)
