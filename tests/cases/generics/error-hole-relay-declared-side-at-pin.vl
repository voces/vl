// @check
// @error cannot assign i32 to 'r' of type string (the body of `outerL` at the call's argument types)
// @error return type mismatch: expected string, got i32 (the return of `outerR` at the call's argument types)
// @hint redundant type annotation: `zR` is inferred as `string`
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `zL` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `zR` (prefix with `_` to suppress, or remove it)
// THE RE-DEFERRAL, ON THE DECLARED SIDE, AT BOTH TABLES (silent-class-inventory D572).
// A generic body calling a SECOND generic substitutes the inner constraint's hole to
// ANOTHER hole, which decides nothing — so the pair must be re-recorded under the caller,
// or the outer call never re-asks it.
//
// THE GATE THAT DOES THAT ASKED ONLY WHETHER THE *BODY* SIDE STILL HELD A HOLE. That was
// the whole question when D551 landed, because D551 recorded body-side holes only. D561
// widened the return table to the DECLARED side and left the gate where it was — so a
// want-side constraint EVAPORATED across one level of relay, and `outerR` below stayed
// check-clean invalid wasm on D561's own landing while the one-call spelling was already a
// loud reject. `d551/retgrid.py` is structurally blind to it: its `relay` axis puts the
// hole on the body side, which is the side that already worked.
//
// Both halves are here because the fix is one condition in two functions, and a landing
// that widened `validateRetCstrs` alone would leave `outerL` silent — the same asymmetry,
// one table over.
function innerL<T>(self: T, n: i32): T {
  const r: T = n + 1
  return r
}
function outerL<U>(self: U, n: i32): U {
  return innerL(self, n)
}
const zL = outerL("s", 2)

function innerR<T>(self: T, n: i32): T { return n + 1 }
function outerR<U>(self: U, n: i32): U { return innerR(self, n) }
const zR: string = outerR("s", 2)
