// @run
// @log G
// @log 1
// @log nul
// @log C
// @log 1
// @log G
// @log s
// @log nul
// @log C
// @log s
// @log G
// @log 7
// A list literal whose element type is a nullable function type delivers each generic
// function element at that function type, at every instance of the enclosing generic and
// through an alias (D3940).
function b<U>(y: U) {
  print("G")
  print(y)
}
function c<U>(y: U) {
  print("C")
  print(y)
}
function a<T>(x: T) {
  const l: (((t: T) => void) | null)[] = [b, null, c]
  for e in l {
    if e != null { e(x) } else { print("nul") }
  }
}
a(1)
a("s")
const k = b
const m: (((n: i32) => void) | null)[] = [k, null]
const f = m[0]
if f != null { f(7) }
