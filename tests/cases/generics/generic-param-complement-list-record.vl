// @run
// @log e
// @log 0
// @log 1
// A record built from the complement of `is i32[]` over a parameter `v: T[] | i32[]` gets the
// row of its field's type at the instance, whether the field is read by index or for its length,
// in an `else` or after `!(… is …)`. No annotation in the program names that row (D4888).
function h<T>(v: T[] | i32[]) {
  if v is i32[] {
    print(0)
  } else {
    const r = { xs: v }
    print(r.xs[0])
  }
}

function n<T>(v: T[] | i32[]) {
  if !(v is i32[]) {
    const r = { xs: v }
    print(r.xs.length)
  }
}

h(["e"])
h([7, 8])
n(["x"])
n([1])
