// @run
// @log 3
// @log s
// @log 1.5
// @log 4
// @log 5000000000000
// @log 3
// @log a
// @log 2
// @log dflt
// @log 4
// @log 8
// @log x
// @log 7
// @log q
// @log bee
// @log s
// @log 4
// @log x
// @log 4
// @log 1.5
// @log 10
// @log 5
// @log ab
// @log 9
// @log 7
// @log true
// @log 5
// @log 2.5
// Explicit type arguments on a call, TypeScript's spelling (A15): `f<A, B>(args)` binds
// the callee's type parameters in declaration order BEFORE any argument is checked, so an
// argument is checked against them and a literal takes the written type (`id<f64>(3)` is
// `3.0`). A type parameter no parameter mentions is now callable (`make<i32>()`), and two
// such calls at different types get two instances. Inside a generic body the argument may
// name the enclosing type parameter; each instance substitutes its own binding.

function id<T>(x: T): T { x }
print(id<i32>(3))
print(id<string>("s"))
print(id<f64>(3) / 2.0)
const u = id<i32 | string>(3)
if u is i32 { print(u + 1) }
print(id<i64>(5) * 1000000000000)

// A return-only type parameter, at two types.
function make<T>(): T[] { [] }
const xs = make<i32>()
xs.push(3)
print(xs[0])
const ss = make<string>()
ss.push("a")
print(ss[0])
print(xs.length + ss.length)

// An argument the explicit binding types: the empty list is a `string[]`.
function firstOr<T>(xs: T[], d: T): T {
  if xs.length > 0 { xs[0] } else { d }
}
print(firstOr<string>([], "dflt"))
print(firstOr<i32>([], 4))

// The bound is checked at the written type.
type Shape = { area(): f64 }
type Sq = { s: f64 }
function area(self: Sq) { self.s * self.s }
function total<T: Shape>(xs: T[]) {
  let t = 0.0
  for x in xs { t = t + x.area() }
  t
}
print(total<Sq>([{ s: 2.0 }, { s: 2.0 }]))

// Inside a generic body, naming the enclosing parameter — one instance per binding.
function one<U>(x: U): U[] { [x] }
function wrap<T>(x: T): T[] { one<T>(x) }
print(wrap<string>("x")[0])
function viaEmpty<T>(x: T): T[] {
  const e = make<T>()
  e.push(x)
  e
}
print(viaEmpty(7)[0])
print(viaEmpty("q")[0])

// `Map<K, T>()` in a generic body, un-annotated, at two instances.
function tally<T>(x: T): {[string]: T} {
  const t = Map<string, T>()
  t["x"] = x
  t
}
const byName = Map<string, string>()
byName["b"] = "bee"
print(byName["b"] ?? "none")
print(tally("s")["x"] ?? "none")
print(tally(4)["x"] ?? -1)

// A rest parameter takes a written union element — the remedy its inference refusal names.
function last<T>(...xs: T[]): T { xs[xs.length - 1] }
const l = last<i32 | string>(1, "x")
if l is string { print(l) }

// An un-annotated lambda takes its parameter type from the written arguments.
function apply<A, B>(f: (A) => B, a: A): B { f(a) }
print(apply<string, i32>((s) => s.length, "four"))

// An un-annotated lambda at every written parameter type: the arguments annotate it, so each
// cell is the annotated twin (#3155 review, B2).
type Pt = { x: i32, y: i32 }
const half = apply<f32, f32>((q) => q, 3)
print(half / 2)
const big: i64 = 5
print(apply<i64, i64>((q) => q * 2, big))
print(apply<i32 | null, i32>((q) => q ?? 5, null))
const su = apply<string | i32, string | i32>((q) => q, "ab")
if su is string { print(su) }
const tbl: {[string]: i32} = Map()
tbl["k"] = 9
print(apply<{[string]: i32}, i32>((q) => q["k"] ?? 0, tbl))
print(apply<Pt, i32>((q) => q.x + q.y, { x: 3, y: 4 }))
print(apply<boolean, boolean>((q) => !q, false))

// `make<T>()` un-annotated in a generic body, at a 64-bit and a float binding (N2).
function pushed<T>(x: T): T {
  const a = make<T>()
  a.push(x)
  a[0]
}
print(pushed(big))
print(pushed(2.5))
