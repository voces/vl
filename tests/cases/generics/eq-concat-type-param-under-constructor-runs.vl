// @run
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log 2
// @log 2
// @log 2
// @log 2
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @hint redundant type annotation: `eqL` is inferred as `boolean`
// @hint redundant type annotation: `eqN` is inferred as `boolean`
// @hint redundant type annotation: `eqLL` is inferred as `boolean`
// THE ACCEPT SET of `silent-class-inventory` D421 and D422, READ BACK BY VALUE.
//
// The sibling `error-eq-concat-type-param-under-constructor.vl` pins what a `T`-under-a-
// constructor operand must REFUSE. This pins what it must keep doing, and it reads the
// OPERATOR'S OWN ANSWER at an equal pair and an unequal pair rather than a constant the
// module happens to reach — a `.length` or a bare `print(7)` cannot tell a correct compare
// from one that lowered over the wrong storage, which is the trap D46's own row records.
//
// THREE THINGS ARE PINNED HERE.
//
//  1. D421's accept set. Widening `noteBinCstr` from "the operand IS a hole" to "CONTAINS
//     one" makes the pin re-ask at every `T[]` / `T | null` operand, so every element rep
//     that HAS a core has to keep answering correctly through the pin.
//  2. D421's rung 2. `Circle | null == Circle | null` written out picks the `nulstruct`
//     niche and runs; through `eqN<T>(a: T | null, b: T | null)` the banked type is
//     `T | null`, `eqCmpKindOfNulInner` reads a `TyVar` inner and answers "", and the gate
//     on the emitter's second channel was `nodeTyIsTyVar` — "IS one", not "CONTAINS one" —
//     so the channel was never consulted and the compare fell into the i32 tail: `i32.eq`
//     over two `(ref null $0)`, `vl check` rc 0.
//  3. D422. `eqCmpKindOfArrayElem`'s ARRAY arm answered "none" for a hole one hop down while
//     the element arm one level up answers "" for the same `TyVar` — a FALSE REJECT that
//     told the caller ``==` over T[][] has no lowering`, naming a type variable they never
//     wrote, about a comparison `i32[][] == i32[][]` performs correctly.

type K = "a" | "b"
type N = 1 | 2

function eqL<T>(a: T[], b: T[]): boolean { a == b }
function addL<T>(a: T[], b: T[]): T[] { a + b }
function eqN<T>(a: T | null, b: T | null): boolean { a == b }
function eqLL<T>(a: T[][], b: T[][]): boolean { a == b }

// ── 1. the `T[]` accept set: every element rep with a list-compare core ──────────────
print(eqL([1], [1]))
print(eqL([1], [2]))
print(eqL([true], [true]))
print(eqL([true], [false]))
print(eqL(["x"], ["x"]))
print(eqL(["x"], ["y"]))
const ka: K[] = ["a"]
const kb: K[] = ["a"]
const kc: K[] = ["b"]
print(eqL(ka, kb))
print(eqL(ka, kc))
const na: N[] = [1]
const nb: N[] = [1]
const nc: N[] = [2]
print(eqL(na, nb))
print(eqL(na, nc))

// the `+` half of the same set — the i32 backing `emitListConcatI` copies into. `string[]`
// is deliberately absent: it COMPARES (the `strlist` core) and does NOT concatenate, which is
// D44's own accept-set table, and the two sets differing is why `==` and `+` keep two
// predicates (`eqCmpKindOfArrayElem` and `concatElemIsI32Backed`) rather than one.
print(addL([1], [2]).length)
print(addL([true], [false]).length)
print(addL(ka, kc).length)
print(addL(na, nc).length)

// ── 2. `T | null` — the four inputs a niche compare has to separate ──────────────────
type Circle = { r: i32 }
const c1: Circle | null = { r: 1 }
const c1b: Circle | null = { r: 1 }
const c2: Circle | null = { r: 2 }
const cn: Circle | null = null
print(eqN(c1, c1b))
print(eqN(c1, c2))
print(eqN(cn, c2))
print(eqN(cn, null))

// ── 3. `T[][]` — D422's four bindings, each against an equal and an unequal pair ──────
print(eqLL([[1]], [[1]]))
print(eqLL([[1]], [[2]]))
print(eqLL([[true]], [[true]]))
print(eqLL([[true]], [[false]]))
const kka: K[][] = [["a"]]
const kkb: K[][] = [["a"]]
const kkc: K[][] = [["b"]]
print(eqLL(kka, kkb))
print(eqLL(kka, kkc))
const nna: N[][] = [[1]]
const nnb: N[][] = [[1]]
const nnc: N[][] = [[2]]
print(eqLL(nna, nnb))
print(eqLL(nna, nnc))
