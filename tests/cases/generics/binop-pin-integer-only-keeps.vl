// @run
// @log 5
// @log 5
// @log 99
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `other` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `i1` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `i2` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `^` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `va` is inferred as `{x: i32}` — remove it to lean on inference
// @hint redundant type annotation: `vb` is inferred as `{x: i32}` — remove it to lean on inference
// The annotations the hints name are LOAD-BEARING and DECLARED rather than deleted: `i1`/`i2`
// pin the integer width this file is about, and `va`/`vb` pin the object type the overload is
// declared over. Deleting them to quiet a hint would delete the axis.
// The two warnings are DECLARED rather than silenced, and the silencing is not available:
// `opSelfFnTy` requires the first parameter to be named exactly `self` (its "pollution rule",
// D471), so `_self` would make the declaration inert and this file would stop testing the
// deferral it exists for. The body returns a constant on purpose — 99 is an answer the native
// lowering never produces, so `runs` here means DISPATCHED and not "ran somehow".
// THE HALF THE INTEGER-ONLY PIN MIRROR MUST NOT TAKE (D492/D493's boundary).
//
// `binOpDefinedFor`'s new integer-only arm refuses `% & | ^ << >> >>>` at a pinned hole
// unless both operands are non-float numerics. Three programs it must keep accepting, and the
// third is the one that took a deliberate arm:
//
//   · the integer pins the family is FOR — i32 and i64;
//   · an operator OVERLOAD on the left operand. `checkBinary` reaches its integer-only rule
//     only AFTER the operator-dispatch arm, so an object receiver with a dispatch is decided
//     there and never asks the pin's question. Mirroring the predicate without the ORDER makes
//     this a false reject for a program that runs — the same mistake the `+` arm records one
//     arm up for softening order (D44). `objOpDispatchTy` is that deferral, asked from types
//     alone because `binOpDefinedFor` is a pure predicate.
//
// EVERY NAME IN THIS FILE IS CHOSEN, and D511 is why. An operator overload at a pinned hole
// lowers only when the call's LEFT argument is spelled with the same identifier as the
// generic's left parameter — so `vxor(va, vb)` below dispatches and `vxor(p, vb)` would be
// check-clean invalid wasm. The two integer generics take `p`/`q` for the same reason from the
// other side: a first draft named them `a`/`b` beside module constants `a`/`b` of type `V`,
// and the i32 instantiation picked up the OBJECT constants — this file was then a witness for
// D511 rather than for the pin mirror, and it failed loudly enough to find that out.
function xrI<T>(p: T, q: T): T { return p ^ q }
const i1: i32 = 6
const i2: i32 = 3
print(xrI(i1, i2))
// A SECOND generic rather than `xrI` used twice: one `<T>` pinned at BOTH i32 and i64 is
// already check-clean invalid wasm on this compiler (a monomorphizer seam, unrelated to this
// landing), so reusing it would make this file a witness for that instead.
function xrL<T>(p: T, q: T): T { return p ^ q }
const l1: i64 = 6
const l2: i64 = 3
print(xrL(l1, l2))

type V = { x: i32 }
function "^"(self: V, other: V): i32 { return 99 }
function vxor<T>(va: T, vb: T): i32 {
  const r = va ^ vb
  return r
}
const va: V = { x: 6 }
const vb: V = { x: 3 }
print(vxor(va, vb))
