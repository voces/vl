// @run
// @log 1
// @log 1.5
// @log a
// @log 1
// @log 1
// @log 2
// D4647: a captured function-typed parameter whose type rides `T`, passed from a lambda in a
// generic body to a generic callee's arrow parameter, is pinned at the instance's type.
import { sorted } from "std:array"

function least<T>(xs: T[], lt: (a: T, b: T) => boolean): T {
  const k = (ys: T[]) => sorted(ys, lt)[0]
  k(xs)
}
function leastNoAnn<T>(xs: T[], lt: (a: T, b: T) => boolean) {
  const k = () => sorted(xs, lt)
  k()[0]
}
function viaParam<T>(xs: T[], lt: (a: T, b: T) => boolean): T {
  const k = (ys: T[], f: (a: T, b: T) => boolean) => sorted(ys, f)[0]
  k(xs, lt)
}
function before(a: i32, b: i32) { a < b }
function after(a: i32, b: i32) { a > b }
print(least([3, 1, 2], (a, b) => a < b))
print(least([2.5, 1.5], (a, b) => a < b))
print(least(["b", "a"], (a, b) => a < b))
print(leastNoAnn([3, 1, 2], before))
print(viaParam([3, 1, 2], before))
print(viaParam([1, 2], after))
