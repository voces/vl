// @run
// @log 2
// @log 2
// @log 1
// @log 2
// @log 3
// @log 4
// @log 2
// @log 2
// D3154: a generic's nested list literal of its parameter, at a nullable or union pin, builds
// the inner list of boxes and the outer list of those lists, whether the binding is annotated,
// the literal is returned or pushed onto, or a top-level list of the pin's type is beside it.
function f<T>(x: T) {
  const l = [[x]]
  print(l.length + l[0].length)
}
function g<T>(x: T) {
  const l: T[][] = [[x]]
  print(l.length + l[0].length)
}
function mk<T>(x: T) { [[x]] }
function grow<T>(x: T) {
  const l = [[x]]
  l.push([x, x])
  print(l.length + l[1].length)
}

const v: i32 | null = 4
const u: i32 | string = "s"
f(v)
f(u)
const k = [v]
print(k.length)
g(v)
const m = mk(u)
print(m.length + m[0].length + 1)
grow(v)
f<i32 | null>(null)
const w: string | null = null
f(w)
