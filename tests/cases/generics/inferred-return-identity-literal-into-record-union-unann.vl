// @run
// @log 4
// @log 6
// @log 5
// D8341: a function with an inferred return that hands back a generic identity's record
// literal, delivered into a union holding a wider record, is read at the row its call was
// built at, not at the literal's own row. Binding and argument deliveries.
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
function take(u: J | string) {
  if u is J { print(u.r ?? 0) } else { print(u) }
}
const w0 = idn({ r: 5 })
function deliver() { return idn({ r: 4 }) }
function deliver6() { return idn({ r: 6 }) }
const v: J | string = deliver()
if v is J { print(v.r ?? 0) } else { print(0) }
take(deliver6())
print(w0.r)
