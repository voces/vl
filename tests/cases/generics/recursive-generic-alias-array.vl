// @emit-error recursive generic type `L<i32>` is not supported
// The same cyclic instance reached through an ARRAY field instead of a nullable, and
// it is a SECOND unbounded loop, not the same one: with no union anywhere in the
// program the registration walk never renders, and the trap came from `gaeEnsure`
// re-entering itself on its own field spelling (`L<i32>[]` peels to `L<i32>`, which
// is not yet interned, so the `structIndexByName` guard cannot stop it). One guard
// over the checker's declared-type registry covers both, because both start from the
// same cyclic arena index.
type L<T> = { head: T, tail: L<T>[] }

const a: L<i32> = { head: 1, tail: [] }
print(a.head)
