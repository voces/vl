// @run
// @log 10
// The same recursive instance reached through a list field: each element is the instance.
type L<T> = { head: T, tail: L<T>[] }

function sum(t: L<i32>): i32 {
  let s = t.head
  for k in t.tail { s = s + sum(k) }
  return s
}

const a: L<i32> = { head: 1, tail: [{ head: 2, tail: [] }, { head: 3, tail: [{ head: 4, tail: [] }] }] }
print(sum(a))
