// @run
// @log a
// @log a
// @log b
// @log b
// @log true
// @log <a>
// @log a
// A field function whose result is a literal union, called in a hole or generic instance,
// renders its member: the union named nowhere but in a function type's result still counts
// as a literal union the program uses (D3193).
type R = { v: i32, f: () => "a" | "b" }
function F<Z>(z: Z) { print(z.f()) }
function H(z) { print(z.f()) }
const r: R = { v: 1, f: () => "a" }
F(r)
H(r)
const q: { v: i32, f: () => "a" | "b" } = { v: 2, f: () => "b" }
F(q)
H(q)
function E(z) { print(z.f() == "a") }
E(r)
function I(z) { print("<\{z.f()}>") }
I(r)
function T(z): string { return z.f() }
print(T(r))
