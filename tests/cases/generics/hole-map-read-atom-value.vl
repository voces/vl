// @run
// @log b
// @log a
// @log b
// @log null
// @log b
// @log null
// @log none
// @log true
// @log b
// @log a
// @log null
// A literal-union map read through an un-annotated parameter is `K | null` at the pin: a
// stored atom prints its member, a miss or a stored `null` prints `null` (D3127, D3156, D3157).
type AB = "a" | "b"
type R = { m: {[i32]: AB}, n: {[i32]: AB | null} }
function mk(): R {
  const m: {[i32]: AB} = Map()
  m[3] = "b"
  const n: {[i32]: AB | null} = Map()
  n[3] = "b"
  n[4] = null
  { m: m, n: n }
}
function use(p) {
  print(p.m[3] ?? "a")
  print(p.m[9] ?? "a")
  print(p.m[9] ?? p.m[3])
  print(p.m[9])
  print(p.n[3] ?? null)
  print(p.n[4] ?? null)
  const t = p.n[9]
  if t == null { print("none") } else { print(t) }
  print(p.m[3] == "b")
  const e = p.m
  const u = e[3]
  print(u)
  p.m[13] = "a"
  print(p.m[13] ?? "b")
  print(p.n[9] ?? p.n[8])
}
use(mk())
