// @run
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// @log x
// @log 1
// @log y
// @log 1
// @log 9
// A parameter copied into an unread binding of another type parameter and handed to a closed
// function type takes that delivery's instance; the unread copy asks for none (D6762).
function same<T>(k: T): T { k }
function twice(f: (x: i32) => i32) { f(f(1)) }
function mid<F, G>(a: F, a1: G) {
  const _b: F = a1
  print(a("x"))
  print(twice(a1))
}
mid(same, same)
function mid2<F, G>(a: F, a1: G) {
  const _b: G = a1
  print(a("y"))
  print(twice(a1))
}
mid2(same, same)
print(same(9))
