// @run
// @log 4
// @log 4
// @log 1.5
// @log 4
// A generic function value whose type parameter nothing binds is the `i32` instance, so every use
// at `i32` runs, and a later argument that binds the parameter still does (D16562).
function gid<A>(x: A): A { return x }
function sel<A>(f: (x: A) => A): (x: A) => A { return f }
function apply<T>(f: (x: T) => T, x: T): T { return f(x) }
function d() { return sel(gid) }
const xs = [sel(gid)]
print(xs[0](4))
print(d()(4))
print(apply(sel(gid), 1.5))
const v: (x: i32) => i32 = d()
print(v(4))
