// A hole instance reads a shared node at its pin: an element read off a hole list takes the
// element's value type (D2943, D2944), a lambda call at an `f32` pin prints as one (D2932), and a
// literal-union pin prints its member through a capture or a generic call (D2942). The two
// hinted annotations are load-bearing: the inferred `[null, true]` pins another rep (D2946). The
// last two generics are D2577's narrowed element and D2879's literal-set field.
function elems(x) {
  print(x[0])
  print(x[1])
}
const nbs: (boolean | null)[] = [null, true]
elems(nbs)
const ints = [7, 8]
elems(ints)
function capEl(x) {
  const y0 = x[0]
  const k = () => y0
  print(k())
}
const bs: boolean[] = [true]
capEl(bs)
capEl(nbs)
const fs: f32[] = [1.5]
capEl(fs)
const ls: ("a" | "b")[] = ["b"]
capEl(ls)
function cap(x) {
  const l = [x]
  const y = l[0]
  const k = () => y
  print(k())
}
const f: f32 = 1.5
cap(f)
const a: "a" | "b" = "b"
cap(a)
cap("s")
function idh(z) { return z }
function viaIdh(x) {
  const l = [x]
  print(idh(l[0]))
}
viaIdh(a)
viaIdh("s")
function take(e0) {
  const e = e0[0]
  if e != null { print(e) } else { print("none") }
}
const nt: (boolean | null)[] = [true]
take(nt)
const nn: (boolean | null)[] = [null]
take(nn)
type K = "x" | "y"
function hc(o) {
  const xs = [o.f]
  print(xs[0])
}
hc({ f: true })
const kx: K = "x"
hc({ f: kx })
