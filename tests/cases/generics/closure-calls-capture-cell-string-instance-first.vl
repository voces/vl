// @run
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// @log I
// @log s
// @log I
// @log 1
// D3952: a closure calling a reassigned capture cell at `T` builds in each instance of the
// enclosing generic, with the string instance compiled first.
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T) {
  let k = inner
  const rd = (t: T) => {
    k(t)
  }
  const flip = () => {
    k = other
  }
  rd(x)
}
run("s")
run(1)
