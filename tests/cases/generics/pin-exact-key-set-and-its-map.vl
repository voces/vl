// @run
// @log false
// @log true
// @log map
// @log set
// @log null
// A Set and its boolean map pinned at one generic that tests its parameter are two instances, so
// the parameter and a `match` over a copy of it answer by the exact pin (D2684).
function isSet<T>(u: T | null) { u is Set<i32> }
function kind<T>(u: T | null) {
  const v = u
  match v {
    null => "null"
    _ => if v is Set<i32> { "set" } else { "map" }
  }
}
const s: Set<i32> = Set()
s.add(3)
const b: {[i32]: boolean} = Map()
print(isSet<{[i32]: boolean}>(b))
print(isSet<Set<i32>>(s))
print(kind<{[i32]: boolean}>(b))
print(kind<Set<i32>>(s))
print(kind<Set<i32>>(null))
