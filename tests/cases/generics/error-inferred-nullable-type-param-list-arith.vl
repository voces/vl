// @check
// @error operator '+' is not defined for i32 | null and i32
// D2533: `[x, null]` over `x: V` joined its elements to `V`, since `null` is assignable to a
// type parameter until an instance binds it, so the inferred return was `V[]` and every
// instance lost the `null` its concrete twin keeps. The element is now `V | null`, and the
// instance's `+` is refused exactly as `function pair(x: i32) { [x, null] }`'s is.
function pair<V>(x: V) { [x, null] }
print(pair(5)[1] + 1)
