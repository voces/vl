// D12920: with no record type declared anywhere, a record literal holding a list literal of a
// hole parameter still builds its own row at each instance, an i32 and a string.
function t(x) {
  const o = { xs: [x] }
  print(o.xs.length)
  o.xs[0]
}
print(t(1) + 1)
print(t("s"))
