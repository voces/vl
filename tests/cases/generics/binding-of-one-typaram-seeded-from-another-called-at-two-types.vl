// @run
// @log x
// @log 3
// @log y
// @log 5
// @log w
// A binding annotated with one type parameter, seeded from a parameter of another generic, is
// called at two types: each call runs the seeded generic at its own arguments (D17323, D17324).
function same<T>(k: T): T { return k }
function other<T>(k: T): T { return k }
function mid<F, G>(a: F, a1: G) {
  const b: F = a1
  print(a("x"))
  print(b(3))
  print(b("y"))
}
mid(same, other)
function mid3<F, G>(a: F, a1: G) {
  const b: F = a1
  print(b(5))
  print(a("w"))
}
mid3(same, same)
