// An unfixed empty container handed to a generic passes the first `is K` arm that tests it, so the
// call binds the type parameter there and the container is built as a `K` (DECISIONS.md "No default
// type", D16991); a map and a set answer as a list does.
function m<T>(x: T) {
  if x is {[i32]: f64} { return 7 }
  return 0
}
print(m(Map()))
function s<T>(x: T) {
  if x is Set<i32> { return 8 }
  return 0
}
print(s(Set()))
function l<T>(x: T) {
  if x is f64[] { return 9 }
  return 0
}
print(l([]))
function d<T>(x: T) {
  if x is {[string]: f64} { return 1 }
  else if x is {[i32]: f64} { return 2 }
  return 0
}
print(d(Map()))
// @log 7
// @log 8
// @log 9
// @log 1
