// A type parameter bound only by an explicit type argument still substitutes into the body's
// annotations, so `V | M` is the union the pin mints and each member keeps its tag (D2676), in a
// list's element (D2678) and in a parameter an explicit argument binds (D2679).
type R = { a: i32 }
type IM = {[i32]: i32}
function isMap<V>(n: IM) {
  const u: V | IM = n
  u is IM
}
function isSet<V>(n: Set<i32>) {
  const u: V | Set<i32> = n
  u is Set<i32>
}
function isRec<V>(n: R) {
  const u: V | R = n
  u is R
}
function matchMap<V>(n: IM) {
  const u: V | IM = n
  match u {
    IM => 1
    _ => 2
  }
}
function asRec<V>(n: R) {
  const u: V | R = n
  const w = u as? R
  w != null
}
function fieldRec<V>(n: R) {
  const u: V | R = n
  const w = u as? R
  if w != null { return w.a }
  -1
}
function nullable<V>(n: IM) {
  const u: V | IM | null = n
  u is IM
}
function allNull<V>() {
  const u: V | IM | null = null
  u is IM
}
function reassign<V>(n: IM) {
  let u: V | IM = n
  u = n
  u is IM
}
const mi: IM = Map()
const st: Set<i32> = Set()
print(isMap<string>(mi))
print(isSet<string>(st))
print(isRec<string>({ a: 1 }))
print(matchMap<i32 | null>(mi))
print(asRec<f64>({ a: 2 }))
print(fieldRec<string>({ a: 5 }))
print(nullable<string>(mi))
print(allNull<string>())
print(reassign<i32 | null>(mi))
print(isMap<{[i32]: boolean}>(mi))
type SM = {[string]: i32}
function listElem<V>(x: SM) {
  const a: (V | SM)[] = [x]
  a[0] is SM
}
type Q = { b: string }
function h<W>(y: W | string) { y is string }
function forward<V>(x: string) { h<V>(x) }
const sm: SM = Map()
print(listElem<string>(sm))
print(h<Q>("m"))
print(forward<Q>("m"))
