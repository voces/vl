// @run
// @log 7
// @log s
// @log s
// @log t
// @log 2.5
// @log 3.5
// @log a
// @log 1.5
// @log true
// @log 7
// @log 1.5
// @log s
// @log 1.5
// @log true
// @log s
// @log 2.5
// @log true
// @log 1.5
// @log q
// @log 9
// @hint Intentionally-unused parameter `_y`
// An un-annotated lambda inside a hole-parameter function is instantiated per call, so each
// instance of the function owns its copy of the call: at two pins (D2854), at two argument
// types in one instance (D2897), at a `boolean` pin printed as one (D2884), through a `const`
// alias (D2896), through a capture of the hole, from a nested lambda, and at module scope.
function mk(x) {
  const c = (y) => y
  return c(x)
}
print(mk(7))
print(mk("s"))

function two(x, z) {
  const c = (y) => y
  print(c(x))
  print(c(z))
}
two("s", "t")
two(2.5, 3.5)
two("a", 1.5)

function pb(x) {
  const c = (y) => y
  print(c(x))
}
pb(true)
pb(7)

function al(x) {
  const c = (y) => y
  const d = c
  print(d(1.5))
  print(c(x))
}
al("s")
al(true)

function cap(x) {
  const c = (_y) => x
  return c(1)
}
print(cap("s"))
print(cap(2.5))

function nest(x) {
  const c = (y) => y
  const g = () => c(x)
  return g()
}
print(nest(true))
print(nest(1.5))

const gc = (y) => y
function glob(x) { return gc(x) }
print(glob("q"))
const big: i64 = 9
print(glob(big))
