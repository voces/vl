// @run
// @log 9000000000
// @log 9000000000
// @log 0.5
// @log 0.5
// @log 1.5
// @log s
// @log s
// @log 1
// @log 2.5
// @log 9000000000
// @log e
// @log e
// A record built from the complement of `is i32[]` reads its list field at the instance's
// scalar list, `f64[]` or `i64[]`, by index, for its length and in a `for` (D4898). Over a
// hole, the `else` reads the argument's type less `i32[]`, a union argument included (D4899).
function h<T>(v: T[] | i32[]) {
  if v is i32[] {
    print(0)
  } else {
    const r = { xs: v }
    print(r.xs[0])
    for x in r.xs { print(x) }
  }
}

function n<T>(v: T[] | i32[]) {
  if !(v is i32[]) {
    const r = { xs: v }
    print(r.xs.length)
  }
}

function g(v) {
  if v is i32[] {
    print(0)
  } else {
    const r = { xs: v }
    print(r.xs[0])
  }
}

const big = 9000000000
h([big])
h([0.5, 1.5])
h(["s"])
n([2.5])
g([2.5])
g([big, big])
const a: string[] | i32[] = ["e"]
g(a)
g(["e"])
