// @run
// @log 4
// @log 5
// @log 5
// @log 5
// @log 7
// A list of un-annotated functions held below the top of a generic's argument (a record field, a
// list, a list an `if` chooses, a nested record) is pinned at the type its place classes close
// (D16839).
function id(x) { return x }
function inc0(a) { return a + 1 }
function inc1(a) { return a + 2 }
const r = id({ l: [inc0] })
print(r.l[0](3))
const ll = id([[inc0, inc1]])
print(ll[0][1](3))
const c = 3
const li = id(if c > 2 { [inc0, inc1] } else { [inc1, inc0] })
print(li[1](3))
const rr = id({ o: { l: [inc1] } })
print(rr.o.l[0](3))
const rn = id({ l: [inc0], n: 3 })
print(rn.l[0](rn.n) + rn.n)
