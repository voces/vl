// @check
// @hint redundant type annotation: `viaRet` is inferred as `i32` — remove it to lean on inference
// @error `doPrint` prints its type parameter here: print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got R — print the elements or fields individually, e.g. `print(xs[0])`
// @hint redundant type annotation: `r` is inferred as `{a: i32}` — remove it to lean on inference
// @error `viaPrint` prints its type parameter here: print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got R — print the elements or fields individually, e.g. `print(xs[0])`
// @error an interpolation hole is `string` or i32 | i64 | boolean | f64 — this one is R
// @error argument 1: operator '*' is not defined for string and i32 (the body of `viaBin` applies '*' to this argument)
// @error argument of type string flows into `takesI32` expecting i32 (the call's argument types)
// @error cannot assign string to 'y' of type i32 (the body of `viaLet` at the call's argument types)
// @error return type mismatch: expected i32, got string (the return of `viaRet` at the call's argument types)
// @error push: cannot add string to i32[] (the body of `viaPush` at the call's argument types)
// @error argument 1: expected {a: _}, got i32
// @error `cycA` prints its type parameter here: print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got R — print the elements or fields individually, e.g. `print(xs[0])`
// @error argument 1: operator '+' is not defined for string and i32 (the body of `viaGlobal` applies '+' to this argument)
// A call checked before its generic callee's body still adjudicates that body's deferred
// demands, so each refusal below is the one the callee-first order already gave (D3062).
// Every caller is declared above its callee on purpose.

type R = { a: i32 }
const k = [1, 2].map((e) => e * 3)

function viaPrint<A>(x: A) { doPrint(x) }
function doPrint<B>(x: B) { print(x) }

function viaInterp<C>(x: C) { doInterp(x) }
function doInterp<D>(x: D) { print("[\{x}]") }

function viaBin<E>(x: E) { doBin(x) }
function doBin<F>(x: F) { print(x * 2) }

function viaArg<G>(x: G) { doArg(x) }
function takesI32(n: i32) { print(n) }
function doArg<H>(x: H) { takesI32(x) }

function viaLet<I>(x: I) { doLet(x) }
function doLet<J>(x: J) {
  const y: i32 = x
  print(y)
}

function viaRet<K>(x: K): i32 { return doRet(x) }
function doRet<L>(x: L): i32 { return x }

function viaPush<M>(x: M) { doPush(x) }
function doPush<N>(x: N) {
  const l: i32[] = []
  l.push(x)
  print(l.length)
}

function viaField<O>(x: O) { doField(x) }
function doField<P>(x: P) { print(x.a) }

// A body reading a module value the caller already sees.
function viaGlobal<T>(x: T) { doGlobal(x) }
function doGlobal<U>(x: U) { print(x + k[0]) }

// A non-generic caller, and a cycle whose first member is the one called.
function concrete(x: R) { doPrint(x) }
function cycA<Q>(x: Q, n: i32) { cycB(x, n) }
function cycB<S>(x: S, n: i32) {
  if n > 0 { cycA(x, n - 1) }
  print(x)
}

const r: R = { a: 5 }
viaPrint(r)
viaInterp(r)
viaBin("s")
viaArg("s")
viaLet("s")
print(viaRet("s"))
viaPush("s")
viaField(3)
concrete(r)
cycA(r, 1)
viaGlobal("s")
