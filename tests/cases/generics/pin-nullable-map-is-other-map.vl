// @run
// @log false
// @log true
// @log false
// @log false
// At a `T | null` pin a single map is a nullable niche with no tag: an `is` naming another map,
// even one of the same representation, is false whatever the niche holds (D2493).
function g<T>(u: T | null) { u is {[i32]: string} }
const mi: {[i32]: i32} = Map()
const ms: {[i32]: string} = Map()
print(g<{[i32]: i32}>(mi))
print(g<{[i32]: string}>(ms))
print(g<{[i32]: i32}>(null))
function s<T>(u: T | null) { u is Set<i32> }
const mb: {[i32]: boolean} = Map()
print(s<{[i32]: boolean}>(mb))
