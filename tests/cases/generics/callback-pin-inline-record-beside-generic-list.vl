// @run
// @log 1
// @log 1
// @log 1
// @log 7
// @log 4
// @log 1
// Un-annotated callbacks over `Box<A[]>` and over inline records whose fields name `A`, in one
// program: each inline record is pinned by the spelling its row is interned under (D3875).
type A = { x: i32 }
function h<T>(x: T) { x.x }
type Box<T> = { v: T }
const ba: Box<A[]> = { v: [{ x: 1 }] }
print([ba].map((e) => h(e.v[0]))[0])
const o: { v: A } = { v: { x: 1 } }
print([o].map((e) => h(e.v))[0])
const f: { v: A } = { v: { x: 7 } }
print([f].filter((e) => h(e.v) > 0).length)
print([f].map((e) => h(e.v))[0])
const n: { v: { w: A } } = { v: { w: { x: 4 } } }
print([n].map((e) => h(e.v.w))[0])
const os = [o, o]
print(os.map((e) => h(e.v))[1])
