// @run
// @log true
// @log false
// @log false
// @log true
// @log false
// `v is K` in a generic pinned at `string | null` tests membership behind a null check: a null
// is not a member, where the unguarded compare read the null string and trapped (D3332).
type K = "a" | "b"
function show<U>(v: U) { print(v is K) }
const a: string | null = "a"
const z: string | null = null
const q: string | null = "q"
show(a)
show(z)
show(q)
function both<U>(v: U) {
  print(v is string)
  print(v is null)
}
both(a)
