// @run
// @hint redundant type annotation: `v` is inferred as `T[]`
// @log 1
// @log 2.5
// @log 3
// @log 1
// @log 1
// @log 2.5
// @log 1
// @log 5
// An `if` of a list literal and a type parameter's list joins at the parameter's list in either
// arm order, so a literal first adapts to the pin as one second does (D14000).
function f<T>(t: T, b: boolean) {
  const v = if b { [1, 2, 3] } else { [t] }
  print(v[0])
}
function h<T>(t: T, b: boolean) {
  const v = if b { [1, 2, 3] } else { [t] }
  print(v.length)
}
function a<T>(t: T, b: boolean) {
  const v: T[] = if b { [1, 2, 3] } else { [t] }
  print(v[0])
}
f(2.5, true)
f(2.5, false)
h(2.5, true)
h(2.5, false)
a(2.5, true)
a(2.5, false)
const big: i64 = 5
f(big, true)
f(big, false)
