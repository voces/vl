// @check
// @error return type mismatch: expected i32, got i64 (parameter `x` of `g`, returned at 6:33)
// @error return type mismatch: expected i32, got i64 (parameter `x` of `h`, returned at 7:33)
// A 64-bit constant beside a type-parameter operand computes at `i64`, so a `T` return is refused
// at a pin narrower than it, as `(x: i32): i32` is at its direct spelling (D2712, D9620).
function g<T>(x: T): T { return x + (3 << 31) }
function h<T>(x: T): T { return x + 6442450944 }
print(g<i32>(0))
print(h(5))
