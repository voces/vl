// @check
// @error cannot assign string | i32 to 'a' of type boolean
// A union of lists handed to a generic list parameter calls once per member, and the result is the
// join of each call's: `T` binds `string` and `i32`, never the open type that would fit `boolean`.
function first<T>(xs: T[]): T { return xs[0] }
const q: string[] | i32[] = [1, 2]
const a: boolean = first(q)
print(a)
