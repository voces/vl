// @log 3
// @log 4
// D2920: a list literal of a hole parameter bound to an anonymous record builds a list of that
// record at the instance, read by an index, a push, a capturing lambda and a returned element,
// beside an i32 instance of the same functions.
function h(x) {
  const xs = [x]
  xs.push(x)
  print(xs.length)
  print(xs[0] == xs[1])
}
function c(x) {
  const ys = [x, x]
  const g = () => ys[0]
  g
}
type O = { n: i32 }
function u(q) {
  const xs = [q]
  return xs[0].n
}
const v: { a: i32, b: string } = { a: 3, b: "r" }
print([v][0].a)
h(v)
h(1)
print(c(v)().b)
print(c(5)())
const o: O = { n: 3 }
print(u(o))
print(u({ n: 4 }))
