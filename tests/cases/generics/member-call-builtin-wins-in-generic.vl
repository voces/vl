// @run
// @log 1
// @log 99
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// A generic instance at `i32[]` calls the list's own `push`, not the `self`-function that the
// string instance reaches (D2517). Before, the per-instance re-pick never asked about built-in
// methods: `f(xs)` printed 99 and left the list empty.
function push(self: i32[] | string, x: i32) { print(99 + x - x) }
function f<T>(x: T) { x.push(1) }
const xs: i32[] = []
f(xs)
print(xs.length)
f("s")
