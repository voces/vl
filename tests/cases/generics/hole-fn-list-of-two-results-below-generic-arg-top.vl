// @run
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 1
// A list of un-annotated functions of two result types held below the top of a generic's argument
// (a record field, a list in a list, two fields) takes that part at the list's own pin (D16859).
// Each spelling has its own identity: two calls of one at such lists are D16875.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id(x) { return x }
function id2(x) { return x }
function id3(x) { return x }
function id4(x) { return x }
const r = id({ l: [inc0, half] })
print(r.l[1](3))
const ll = id2([[inc0, half]])
print(ll[0][1](3))
const rf = id3({ a: [inc0], b: [half] })
print(rf.a[0](3))
print(rf.b[0](3))
const rn = id4({ l: [inc0, half], n: 2 })
print(rn.l[1](rn.n))
