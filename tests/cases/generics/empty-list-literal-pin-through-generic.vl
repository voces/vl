// @run
// @log 0
// @log 0
// @log seven
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_x`
// AN UN-ANNOTATED EMPTY LIST LITERAL, PINNED BY A CALL, HANDED TO A GENERIC
// (silent-class-inventory D764). `monoArgTyName`'s un-annotated-local arm recurses into the
// binding's INIT, and an EMPTY `[]` has no element for any arm there to read — so
// `exprArray`'s catch-all answers `i32[]`, which is not `"i32"` and is therefore adopted, and
// `idg<T>(x: T): T` is cloned with an i32-LIST parameter and result.
//
// ONE WRONG PIN, SEVERAL MESSAGES, which is why the message was never the family. Every read
// off the RESULT binding refuses, each in its own words: `dd[0].r` was
// `emitProgram: field access receiver is not a struct`, `dd[0]["k"] ?? d` was
// ``??` over this nullable value is not supported yet — narrow it first`, and
// `dd[0].size` was `field access receiver is not a struct` again. Corpus cell `b022835`
// carries the `??` spelling only.
//
// THE TYPE IS NOT MISSING, ONLY UNREADABLE FROM THE LITERAL: the checker has already pinned
// the binding from `sink(c)` and will say so — `const bad: i32 = c` reports "cannot assign
// {[string]: {r: string}}[] to 'bad' of type i32", and the same probe on `idg(c)`'s result
// reports the identical type. The rung reads the ARGUMENT REFERENCE's recorded type through
// `monoAnnPinName`, the same pin membership list the ANNOTATED arm beside it uses.
//
// GATED ON THE EMPTY LITERAL, which is the ablation: a NON-empty `[lv1]` runs on master (its
// first element names the row), an annotated `const c: … = []` runs, and dropping the generic
// runs. The defect needs all three of un-annotated, EMPTY and a generic in between.
function idg<T>(x: T): T { return x }
function sinkMap(_x: {[string]: {r: string}}[]) { }
function sinkStruct(_x: {r: string}[]) { }

function coalesceLeg() {
  const c = []
  sinkMap(c)
  const dd = idg(c)
  if dd.length > 0 {
    const g1 = (dd[0])["k0"] ?? { r: "" }
    print(g1.r)
  } else { print(0) }
}

function fieldLeg() {
  const c = []
  sinkStruct(c)
  const dd = idg(c)
  if dd.length > 0 { print(dd[0].r) } else { print(0) }
}

function filledLeg() {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  const c = []
  c.push(lv1)
  sinkMap(c)
  const dd = idg(c)
  if dd.length > 0 {
    const g1 = (dd[0])["k0"] ?? { r: "" }
    print(g1.r)
  } else { print(0) }
}

coalesceLeg()
fieldLeg()
filledLeg()
