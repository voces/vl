// @run
// @log 7
// @log s
// @log true
// @log 7
// @log 7
// @log s
// @log s
// @log 7
// @log false
// @log 8
// @log false
// @log true
// A `??` over a closed nullable left with a type-parameter default joins apart, as the `if` it
// spells does: each instance builds the left's type beside its own default's (D15080).
function pick<T>(x: boolean | null, d: T) { x ?? d }
function pickI<T>(x: i32 | null, d: T) { x ?? d }
function pickS<T>(x: string | null, d: T) { x ?? d }
function pickM<T>(m: {[i32]: boolean}, d: T) { m[2] ?? d }
function pickN<T>(m: {[i32]: i32}, d: T) { m[2] ?? d }
function pickD<T>(x: boolean | null, d: T): boolean | T { x ?? d }
print(pick(null, 7))
print(pick(null, "s"))
print(pickI(null, true))
print(pickS(null, 7))
const mb: {[i32]: boolean} = Map()
print(pickM(mb, 7))
print(pickM(mb, "s"))
const mi: {[i32]: i32} = Map()
print(pickN(mi, "s"))
print(pickD(null, 7))
print(pickD(false, 7))
const r = pick(null, 7)
if r is i32 { print(r + 1) } else { print(r) }
print(pick(false, "q"))
print(pick(true, 7))
