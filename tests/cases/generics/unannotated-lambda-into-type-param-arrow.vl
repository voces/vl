// @run
// @log 4
// @log 4
// @log 4
// @log ab
// @log 2.5
// @log 14
// @log 3
// @log 5
// @hint redundant type annotation: `p` is inferred as `{n: i32}` — remove it to lean on inference
// An un-annotated lambda handed to an arrow parameter riding a type variable that a later
// argument binds (D2426). The lambda is checked after the value arguments, so its parameter
// is seeded with the bound type, not the variable, and the instance has a pin.
function ap<T>(f: (T) => T, x: T): T { return f(x) }
function mapTwo<A, B>(f: (A) => B, x: A, y: A): B[] { return [f(x), f(y)] }
type P = { n: i32 }

print(ap((v) => v + 1, 3))
print(ap(f: (v) => v + 1, x: 3))
print(ap(x: 3, f: (v) => v + 1))
print(ap((v) => v + "b", "a"))
print(ap((v) => v * 2.0, 1.25))
const r = mapTwo((v) => v * 2, 3, 4)
print(r[0] + r[1])
const s = mapTwo((v) => v.length, "ab", "cde")
print(s[1])
const p: P = { n: 4 }
print(
  ap(
    (v) => {
      return { n: v.n + 1 }
    },
    p,
  ).n,
)
