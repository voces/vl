// @run
// @log 1
// @log NULL 1
// @log INLINE 1
// @log LITERAL 1
// @log BARE-NULL 1
// @log T-FIRST 1
// @warning Unused parameter
// @warning Unused parameter
// @warning Unused parameter
// @warning Unused parameter
// @hint redundant type annotation: `two` is inferred as `i32`
// @hint redundant type annotation: `bareFirst` is inferred as `i32`
// @hint redundant type annotation: `t` is inferred as `string | null`
// A `(string | null)[]` pinned into `T[]` beside a bare `T` (D1897). The two share ONE wasm
// type, so the rep cascade cannot tell them apart and the pin hard-coded `string[]`, losing
// the `| null`: the instance's bare `T` was minted non-null and the caller handed it a
// nullable string.
//
// A pin is a NAME, not a rep, so the arena's render is the pin where the element is nullable.
// The `NULL` row is the one an annotated `t` could not have caught: it validated by inserting
// `ref.as_non_null` and trapped on an actual null. Its annotation is declared-hint on
// purpose — the checker agreeing about the TYPE said nothing about the REP.
import { toString } from "std:fmt"

function mkS(i: i32): string | null {
  if i == 0 { return null }
  "a"
}

function two<T>(xs: T[], t: T): i32 { return 1 }

function unannotated() {
  const rs = [mkS(1)]
  print(two(rs, mkS(2)))
}
unannotated()

function actuallyNull() {
  const rs = [mkS(0)]
  const t: string | null = mkS(0)
  print("NULL " + toString(two(rs, t)))
}
actuallyNull()

function inlineLiteral() { print("INLINE " + toString(two([mkS(1)], mkS(2)))) }
inlineLiteral()

function literalNullMember() {
  const rs = ["a", null]
  print("LITERAL " + toString(two(rs, mkS(2))))
}
literalNullMember()

function bareNullArg() {
  const rs = [mkS(1)]
  print("BARE-NULL " + toString(two(rs, null)))
}
bareNullArg()

function bareFirst<T>(t: T, xs: T[]): i32 { return 1 }

function orderFlipped() {
  const rs = [mkS(1)]
  print("T-FIRST " + toString(bareFirst(mkS(2), rs)))
}
orderFlipped()
