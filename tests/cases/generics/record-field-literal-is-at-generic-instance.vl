// @log false
// @log true
// @log false
// `is` with a literal-union field, inside a generic, tests the value at the instance's own record
// type. So `l` answers the same as the annotated `k` (D4088).
function l<L>(u: L | null) { u is {a: 1 | 2} }
function k(u: {a: i32} | null) { u is {a: 1 | 2} }
const r1: {a: i32} = { a: 1 }
print(l(r1))
print(k(r1))
const r3: {a: i32} = { a: 3 }
print(l(r3))
print(k(r3))
const rl: {a: 1 | 2} = { a: 2 }
print(l(rl))
print(l<{a: i32}>(null))
