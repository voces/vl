// @run
// @log 7
// @hint redundant type annotation: `o` is inferred as `{v: {inner: i32}[][]}`
// A generic APPLICATION under TWO array wrappers in an inline-object field
// (`{ v: Box<i32>[][] }`). `internShapeDeep` peels the `[]` suffixes one at a time
// and now interns the application LEAF it reaches (`gaeEnsure`, D-GAELEAF), so the
// nested ref-list's element type resolves. Failed on master with "ref-list field
// element type is not interned".
type Box<T> = { inner: T }

const o: { v: Box<i32>[][] } = { v: [[{ inner: 7 }]] }
print(o.v[0][0].inner)
