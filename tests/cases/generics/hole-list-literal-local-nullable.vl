// An un-annotated list literal of a hole-typed value at a nullable pin keeps the element's
// null, rather than casting it away when the list is built (D2899, D2661, D2901).
function mk(x) {
  const xs = [x]
  return xs[0]
}
const sn: string | null = null
const a = mk(sn)
if a != null { print(a) } else { print("null") }
const sv: string | null = "n"
const b = mk(sv)
if b != null { print(b) } else { print("null") }
const inn: i32 | null = null
const c = mk(inn)
if c != null { print(c) } else { print("null") }
const iv: i32 | null = 5
const d = mk(iv)
if d != null { print(d + 1) } else { print("null") }
function take(v) {
  const ys = [v]
  return ys.length
}
function viaCall() {
  let q = null
  print(take(q))
  q = 5
}
viaCall()
function nested(x) {
  const g = (z) => z
  const r = g(x)
  const xs = [r]
  return xs[0]
}
const e = nested(sv)
if e != null { print(e) } else { print("null") }
const f = nested(sn)
if f != null { print(f) } else { print("null") }
