// @run
// @log 1
// @log 1
// @log 1
// @log 2
// @log b
// @log 1
// @log b
// @log 2.5
// A generic well-typed at the enclosing generic's list type runs when delivered there, and a
// list literal of generics still binds its type parameter from a later argument (D3923).

function len<U>(y: U[]) { print(y.length) }
function run<V>(g: (v: V[]) => void, v: V) { g([v]) }
function a<T>(x: T) {
  const f: (t: T[]) => void = len
  f([x])
  run(len, x)
  run(len, [x, x][0])
  len([x, x])
}
function b<U>(y: U) { print("b"); print(y) }
function runAll<V>(gs: ((v: V) => void)[], v: V) { gs[0](v) }
function c<T>(x: T) { runAll([b], x) }

a(true)
c(1)
runAll([b], 2.5)
