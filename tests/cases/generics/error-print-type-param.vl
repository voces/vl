// @check
// @error print of i32[] is type-valid but not yet supported by codegen
// @error `pElem` prints its type parameter here: print of i32[] is type-valid but not yet supported by codegen — `print` renders one scalar or string; print the elements/fields individually, e.g. `print(xs[0])`
// @error print of string[] is type-valid but not yet supported by codegen
// @error `pElem` prints its type parameter here: print of string[] is type-valid but not yet supported by codegen — `print` renders one scalar or string; print the elements/fields individually, e.g. `print(xs[0])`
// @error print of Circle is type-valid but not yet supported by codegen
// @error `pElem` prints its type parameter here: print of Circle is type-valid but not yet supported by codegen — `print` renders one scalar or string; print the elements/fields individually, e.g. `print(xs[0])`
// @error print of a union value (i32 | null) is type-valid but not yet supported by codegen
// @error `pElem` prints its type parameter here: print of a union value (i32 | null) is type-valid but not yet supported by codegen — narrow it first, e.g. `if v is i32 { print(v) }`
// @error print of i32[] is type-valid but not yet supported by codegen
// @error `pBare` prints its type parameter here: print of i32[] is type-valid but not yet supported by codegen — `print` renders one scalar or string; print the elements/fields individually, e.g. `print(xs[0])`
// @error print of Circle is type-valid but not yet supported by codegen
// @error `pBare` prints its type parameter here: print of Circle is type-valid but not yet supported by codegen — `print` renders one scalar or string; print the elements/fields individually, e.g. `print(xs[0])`
// @error print of {[string]: i32} is type-valid but not yet supported by codegen
// @error `pBare` prints its type parameter here: print of {[string]: i32} is type-valid but not yet supported by codegen — `print` renders one scalar or string; print the elements/fields individually, e.g. `print(xs[0])`
// @error print of (i32) => i32 is type-valid but not yet supported by codegen
// @error `pBare` prints its type parameter here: print of (i32) => i32 is type-valid but not yet supported by codegen — `print` renders one scalar or string; print the elements/fields individually, e.g. `print(xs[0])`
// @error print of a union value (i32 | string) is type-valid but not yet supported by codegen
// @error `pBare` prints its type parameter here: print of a union value (i32 | string) is type-valid but not yet supported by codegen — narrow it first, e.g. `if v is i32 { print(v) }`
// GRADUATED from `silent-class-inventory` D401 — the PRINTABILITY capability, lost in the
// instantiation exactly the way D35's equatability and D44's concatenability were.
//
// `print` renders ONE scalar or string, and the two floors that say so (`tyPrintsAsRef`,
// `tyPrintsAsUnionBox`) are asked of the ARGUMENT'S TYPE in the body. Inside a generic that
// type is a hole — `T` itself, or the `?elem.T` an `x[0]` read derives — and a hole is
// neither a ref nor a box, so BOTH floors answered false and every generic `print` was
// admitted. The emitter's print ladder is a run of positive tests ending in an unguarded
// `call __print_i32__`, so the instance handed a `(ref $t)` to an `(i32) -> ()` import:
// `vl check` rc 0 over a module the engine refuses.
//
// EVERY REFUSAL BELOW IS THE DIRECT SPELLING'S OWN SENTENCE, and the pairing is what makes
// that checkable: each `…Direct` is the print written out at the concrete type and each
// `…Pinned` is the identical print reached through a type parameter. One annotation is the
// whole difference between them, which is why the diagnostics have to be one attribution
// apart and no more.
//
// The accept set — every argument rep whose print does NOT lose a capability here — is the
// sibling fixture `print-type-param-runs.vl`, which reads its answers back.
//
// MEASURED: `scripts/silent-sweep/d401/printgrid.py`, 152 cells over 19 argument reps at
// four print positions. 19 of them were check-clean invalid wasm on master and every one had
// a CONCRETE twin that was already a clean check reject; all 19 are refusals now, 0 `runs`
// lost and 0 cells moved to silent. D14's own `lengrid.py` — the grid that found this — moves
// its 3 index cells and nothing else.

type Circle = { r: i32 }
type CM = {[string]: i32}

function pElem<T>(x: T) { print(x[0]) }
// `pBare` NAMES ITS PARAMETER `U`, and the rename is load-bearing rather than cosmetic: a
// hole's ARRAY DEMAND is keyed by the type-parameter NAME, so with both generics on `T` the
// demand `pElem`'s `x[0]` records reaches `pBare`'s MAP call site and adds a second,
// unrelated diagnostic to a fixture whose whole point is that the print refusals pair
// one-for-one with their direct spellings.
function pBare<U>(x: U) { print(x) }

function mkm(): CM { const m: CM = Map(); m["k"] = 1; m }
function mkvu(): i32 | string { 7 }
function id1(q: i32): i32 { q }

// ── the ELEMENT position: `print(x[0])` on an unbounded `T` ───────────────────────────
// The derived `?elem.T` hole resolves through the pinned array, so the refusal names the
// ELEMENT type — `i32[]` for a list of lists, not the argument's own `i32[][]`.
function nestListDirect(v: i32[][]) { print(v[0]) }
function nestListPinned(v: i32[][]) { pElem(v) }
function strListDirect(v: string[][]) { print(v[0]) }
function strListPinned(v: string[][]) { pElem(v) }
function recListDirect(v: Circle[]) { print(v[0]) }
function recListPinned(v: Circle[]) { pElem(v) }
function nulElemDirect(v: (i32 | null)[]) { print(v[0]) }
function nulElemPinned(v: (i32 | null)[]) { pElem(v) }

// ── the BARE position: `print(x)` on the type parameter itself ────────────────────────
// This half is NOT in D401's filed 3 cells and is the larger part of the family: 15 of the
// grid's 19 silent cells. `tyPrintsAsRef`'s own header claimed a `TyVar` was safe because
// "the concrete argument is gated there" — nothing gated it there.
function listDirect(v: i32[]) { print(v) }
function listPinned(v: i32[]) { pBare(v) }
function recDirect(v: Circle) { print(v) }
function recPinned(v: Circle) { pBare(v) }
function mapDirect(v: CM) { print(v) }
function mapPinned(v: CM) { pBare(v) }
function fnDirect(v: (i32) => i32) { print(v) }
function fnPinned(v: (i32) => i32) { pBare(v) }
function vunionDirect(v: i32 | string) { print(v) }
function vunionPinned(v: i32 | string) { pBare(v) }

function body() {
  const nest = [[7, 8]]
  nestListDirect(nest)
  nestListPinned(nest)
  const strs = [["a"]]
  strListDirect(strs)
  strListPinned(strs)
  const recs = [{ r: 7 }]
  recListDirect(recs)
  recListPinned(recs)
  const nuls: (i32 | null)[] = [7]
  nulElemDirect(nuls)
  nulElemPinned(nuls)
  const flat = [7, 8]
  listDirect(flat)
  listPinned(flat)
  const c: Circle = { r: 7 }
  recDirect(c)
  recPinned(c)
  const m = mkm()
  mapDirect(m)
  mapPinned(m)
  fnDirect(id1)
  fnPinned(id1)
  const vu = mkvu()
  vunionDirect(vu)
  vunionPinned(vu)
}
body()
