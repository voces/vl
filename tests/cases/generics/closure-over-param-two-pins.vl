// @run
// @log 5
// @log q
// @log 2.5
// D2259: a lambda written as a generic's tail was lifted once and shared by every instance, so
// the second pin's closure was built at the first pin's rep (invalid wasm). Each instance now
// clones it, in either pin order.
function gen<T>(r: T): () => T {
  () => r
}
print(gen(5)())
print(gen("q")())
print(gen(2.5)())
