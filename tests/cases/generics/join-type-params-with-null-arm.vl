// @run
// @log a
// @log true
// @log null
// @log x
// @log y
// @log null
// @log true
// @log false
// @log 7
// @log 4
// @log null
// A null arm beside a join of two type parameters stays a member: `T | U | null`, not `T | U`
// with the null folded into a parameter, and each pin re-joins the three (D3267). At `K` and
// `boolean` the boolean arm is no longer read as the atom `1`.
type K = "a" | "b"
function g<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else if k == 1 { b } else { null }
  return r
}
const x: K = "a"
const y = true
print(g(x, y, 0))
print(g(x, y, 1))
print(g(x, y, 2))
print(g("x", "y", 0))
print(g("x", "y", 1))
print(g("x", "y", 2))
function f<T, U>(a: T, b: U, k: i32) {
  const o = { v: if k == 0 { a } else if k == 1 { b } else { null } }
  print(o.v is i32)
}
const n7: i32 | null = 7
f(n7, 4, 0)
f(n7, 4, 2)
function m<T, U>(a: T, b: U, k: i32) {
  const r = match k {
    0 => a
    1 => b
    _ => null
  }
  print(r)
}
m(n7, 4, 0)
m(n7, 4, 1)
m(n7, 4, 2)
