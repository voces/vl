// @run
// @log null
// @log c
// @log c
// @log null
// @log a
// @log null
// A generic's `if c { a } else { "c" }` bound to a local at a `K | null` pin: the instance's
// binding is typed `string`, but the join still yields `a`'s null, so its cell is the nullable
// string and prints `null` rather than trapping (D3290).
type K = "a" | "b" | "c"
function g<T>(a: T, c: boolean) {
  const r = if c { a } else { "c" }
  print(r)
}
function h<T>(a: T, c: boolean) {
  const r = if c { "c" } else { a }
  const s: string | null = r
  print(s)
}
const u: K | null = null
const v: K | null = "a"
g(u, true)
g(u, false)
h(u, true)
h(u, false)
h(v, false)
g(u, true)
