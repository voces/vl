// @run
// @log 15
// @log 15
// @log 1
// @log 15
// @log 15
// @log 4
// @log 1
// @log 15
// A fresh call with arguments handed through a generic identity is built at the record it is
// delivered to when its callee's parameters are all annotated; a callee with an un-annotated
// parameter, a literal argument and a nested call each print the widened field (D15178).
type J = { r: i32 | null, g: i32 }
type P = { x: i32 }
function idn<T>(v: T): T { v }
function mk(n: i32) { { r: n, g: 1 } }
function mkM(n: i32, c) { { r: n, g: c } }
function mkP(p: P) { { r: p.x, g: 1 } }
function other(n: i32) { n + 14 }
function mkN(n: i32) { { r: n, g: 1 } }
function u(a) { a.r }
const m: J = idn(mk(15))
print(m.r ?? 0)
const mm: J = idn(mkM(15, 1))
print(mm.r ?? 0)
print(mm.g)
const mp: J = idn(mkP({ x: 15 }))
print(mp.r ?? 0)
const mn: J = idn(mkN(other(1)))
print(mn.r ?? 0)
const d: J = mkN(15)
print(u(mkN(4)))
print(u({ r: 1, g: 2 }))
print(d.r ?? 0)
