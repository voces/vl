// @run
// @warning Unused parameter
// @hint redundant type annotation
// @log false
// @log true
// D7484: generics handed through `const` aliases default-bind the callee's `T` as the names do.
function two<T>(x: T): i32 { return 1 }
function three<T>(x: T): i32 { return 3 }
function same<T>(f: (x: T) => i32, g: (x: T) => i32): boolean { return f == g }
const v = two
const w = three
print(same(v, w))
print(same(v, two))
