// @check
// @error `.slice` on string is its built-in method, not the `slice` in scope, and this call cannot pick it per instance from inside a closure or through a local — call it on the generic's own parameter (parameter `a` of `inClosure`, used at 17:9)
// @error `.slice` on string is its built-in method, not the `slice` in scope, and this call cannot pick it per instance from inside a closure or through a local — call it on the generic's own parameter (parameter `a` of `inLoop`, used at 22:11)
// A `let` bound from a parameter but written again, in a closure or a loop, is not that parameter:
// a member call through it keeps the refusal at a pin a built-in would take, rather than resolve
// to the parameter (D2520).
function slice(self: boolean | string, a: i32, b: i32) {
  if self == true || a > b { return "fn" }
  return "fn"
}
function inClosure(a, b) {
  let v = a
  const g = () => {
    v = b
  }
  g()
  print(v.slice(0, 2))
}
function inLoop(a, b) {
  let v = a
  for i in 0 to 2 {
    print(v.slice(0, 2))
    v = b
  }
}
inClosure(true, false)
inClosure("hello", "world")
inLoop(true, false)
inLoop("hello", "world")
