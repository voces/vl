// @run
// @log 5
// @log q
// @log 5
// @log q
// @log 1.5
// @log 4
// @log q
// @log 5
// @log q
// @log 5
// @log q
// @log 7
// @log q
// D2551: a lambda inside a generic body is cloned per instance whatever position it is written
// in. Only a binding, a field, a `return` argument and a block's tail were; a lambda written as
// a call argument, a list element, a map value, an `if` arm, an immediately called value or
// inside another lambda was lifted once and shared, so the second instance read the first's rep.
function app<U>(f: () => U): U { return f() }
function viaArg<T>(r: T): T { return app(() => r) }
function viaList<T>(r: T): T { return [() => r][0]() }
function viaLit<T>(r: T): T { return { f: () => r }.f() }
function viaMap<T>(r: T): T {
  const m: {[string]: () => T} = Map()
  m["k"] = () => r
  const f = m["k"]
  if f != null { return f() }
  return r
}
function viaIf<T>(r: T): T {
  const f = if r == r { () => r } else { () => r }
  return f()
}
function viaCall<T>(r: T): T { return (() => r)() }
function viaNest<T>(r: T): T { return app(() => app(() => r)) }
print(viaArg(5))
print(viaArg("q"))
print(viaList(5))
print(viaList("q"))
print(viaLit(1.5))
print(viaLit(4))
print(viaMap("q"))
print(viaMap(5))
print(viaIf("q"))
print(viaIf(5))
print(viaCall("q"))
print(viaNest(7))
print(viaNest("q"))
