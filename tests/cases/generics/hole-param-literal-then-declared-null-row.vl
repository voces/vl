// @run
// @log true
// @log none
// A literal argument and a declared row holding null share one instance of an un-annotated
// parameter; the hole binds at the shared pin, not at the literal's narrower row.
type R = { v: i32, h: { f: () => boolean } | null }
function F(z) {
  if z.h != null {
    const g = z.h.f
    print(g())
  } else {
    print("none")
  }
}
F({ v: 7, h: { f: () => true } })
const r: R = { v: 1, h: null }
F(r)
