// @run
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log 7
// @log true
// @log s
// @log true
// A `let` of the enclosing generic's parameter type, captured and written after the capturer's
// declaration, is read at the enclosing instance's binding: printed, and passed to a generic
// (D3886).
function show<U>(u: U) { print(u) }
function outer<T>(x: T) {
  let m = x
  function inner() { print(m) }
  inner()
  m = x
}
outer(true)
outer(false)
function viaLambda<T>(x: T) {
  let m = x
  const g = () => print(m)
  g()
  m = x
}
viaLambda(true)
function viaGeneric<T>(x: T) {
  let m = x
  function inner<U>(_u: U) { print(m) }
  inner(0)
  m = x
}
viaGeneric(true)
function rewritten<T>(x: T, y: T) {
  let m = x
  function setm() { m = y }
  function inner() { print(m) }
  inner()
  setm()
  inner()
}
rewritten(true, false)
function each<T>(x: T) {
  let m = x
  function inner() { print(m) }
  inner()
  m = x
}
each(7)
each(true)
each("s")
function passed<T>(x: T) {
  let m = x
  function inner() { show(m) }
  inner()
  m = x
}
passed(true)
