// @run
// @log true
// @log 1
// @log q
// @log 2.5
// A generic FuncDecl parameter that is a NESTED list (`T[][]`) — the `[]` RUN, which the
// generic-instantiation trio had no arm for on either half. NO SHADOWING is involved: the
// `<T>` control was as red as any shadowed spelling, which is what separates this from the
// `type-param-shadows-alias-funcdecl*` family next door.
//
// It wrote an INVALID MODULE rather than rejecting, and the reason is that two passes each
// declined to be the one that answers. `monoTyParamOf` reads a bare `T` and ONE `[]` level,
// so `T[][]` matched no parameter, `monoAnnHasTyParam` (whose header claimed the depth for
// two slices) agreed, and the instance pinned the annotation `T[][]` VERBATIM. Meanwhile
// `genTyParamArr` — taught the leaf peel by #1230 — recognised `T[][]` as a type-parameter
// array and skipped `checkArrName`, on the documented expectation that "the passes that
// actually own the gap" would raise it. With the parameter UNUSED nothing else looked at
// it, no heap type was forced, and the module was written and could not instantiate.
//
// The three walks now close with a `[]`-RUN arm in the same position (`monoAnnHasTyParam`
// reports it, `monoBindFromAnn` binds through it by peeling the run off BOTH sides with a
// run-length check, `monoSubstAnn` re-attaches the run as the slice it already is). The
// concrete nested list has always lowered — `function f(v: i32[][])` builds and runs on
// master — so what was missing was only the route from the pattern to it.
//
// Swept as 144 cells (this constructor x 4 declarations x 6 argument types x 3 return
// spellings x 2 scopes), every shadow cell against its own `<T>` control: 52 invalid wasm
// -> CORRECT, 12 of them the CONTROL itself, and 36 loud reject -> CORRECT.
function anyRows<T>(v: T[][]): boolean { return v.length > 0 }

function firstOfFirst<T>(v: T[][]): T { return v[0][0] }

const xs: i32[][] = [[1, 2]]

print(anyRows(xs))

print(firstOfFirst(xs))

const ss: string[][] = [["q"]]

print(firstOfFirst(ss))

// THE SCOPE AXIS. `monoArgTyName`'s annotated-binding arms all sit behind `fnIx >= 0`
// (`parentLetOf` is function-scoped), so the module-scope calls above and this
// function-scope one reach DIFFERENT code and one of them was green while the other was
// not. A single scope per row measures half of this family.
function main() {
  const fs: f32[][] = [[2.5]]
  print(firstOfFirst(fs))
}

main()
