// @error cannot assign (i32) => i32 to 'b' of the generic function type <T>(T) => T: a function written to it must be generic too (T9.3)
// `F` is called at two types, so the call binds it to `same`'s generic type, which holds no concrete function (D17745).
function same<T>(k: T): T { return k }
function inc(k: i32) { return k + 1 }
function mid<F, G>(a: F, a1: G) {
  print(a("x"))
  print(a(1))
  const b: F = a1
  print(b(2))
}
mid(same, inc)
