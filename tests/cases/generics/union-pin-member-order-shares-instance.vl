// @run
// @log i4
// @log sa
// @log i8
// @log sb
// @log 2
// A generic pinned at one union spelled in two member orders shares one instance, and each
// caller's value keeps its member through it: `i32 | string` and `string | i32` are one type.
function f<T>(u: T): T { u }
function tell(v: i32 | string) {
  if v is i32 { return "i\{v + 1}" }
  "s\{v}"
}
const a: i32 | string = 3
const b: i32 | string = "a"
const c: string | i32 = 7
const d: string | i32 = "b"
print(tell(f(a)))
print(tell(f(b)))
print(tell(f(c)))
print(tell(f(d)))
const xs: (string | i32)[] = [f(c), f(a)]
print(xs.length)
