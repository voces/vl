// @run
// @log 2
// @log ab
// @log 8
// @log 7
// @log N
// @log ab
// @log false
// @log 7
// @log false
// A type-parameter write into a place of several members, a list cell or a field a closure
// reads keeps the template's read at a non-null pin, as it ran before D3240's pin-landed read.
function multi<T>(x: T) {
  let s: string | i32 | null = null
  s = x
  if s is string { print(s.length) }
  else if s is i32 { print(s + 1) }
  else { print("N") }
  print(s)
}
function multiI32<T>(x: T) {
  let s: string | i32 | null = null
  s = x
  if s is i32 { print(s + 1) } else { print("N") }
  print(s)
}
function fieldInClosure<T>(x: T) {
  const q: { s: i32 | null } = { s: null }
  q.s = x
  const f = () => q.s == null
  print(f())
  const h = () => {
    print(q.s ?? 0)
  }
  h()
}
function cellInClosure<T>(x: T) {
  const a: (string | i32 | null)[] = [null]
  a[0] = x
  const f = () => {
    print(a[0] == null)
  }
  f()
}
multi("ab")
multi(7)
multiI32("ab")
fieldInClosure(7)
cellInClosure("ab")
