// @check
// @error argument 1: expected string, got i32
// @error `id` takes 1 type argument (`T`), but the call gives 2
// @error `plain` is not generic, so it takes no type arguments
// @error explicit type arguments need a direct call of a declared generic function
// @error unknown type 'Nope'
// @error i32 does not satisfy `Shape`
// @error A f64-keyed Map isn't supported yet
// @error `Map` expects 2 type arguments but got 1
// @error `Set` expects 1 type argument but got 2
// @error A K-keyed Map isn't supported yet
// @error A K-keyed Map isn't supported yet
// @error unknown type '{[K]:i32}'
// @error A T-keyed Set isn't supported yet
// @error wrong number of arguments: expected 2, got 1; `<` … `>` directly followed by `(` is read as type arguments
// The explicit type-argument refusals (A15). The written type is authoritative: an
// argument that disagrees with it is the argument's error, reported at the argument.
// The count must match the declaration, the callee must be a declared generic (or
// `Map`/`Set`), the bound is checked at the written type, and a map key keeps the
// index signature's `string` / `i32` rule — a type-parameter key included: `Map<K, V>` and
// `Set<T>()` name the key; `{[K]: V}` below a let keeps its bare wording (D-MAPKEYDIAG). A comparison pair that reads
// as type arguments (`a < b, c > (d)`) gets a hint saying so.
function id<T>(x: T): T { x }
function plain(x: i32): i32 { x }
const lam = (x: i32) => x
type Shape = { area(): f64 }
function total<T: Shape>(_xs: T[]): f64 { 0.0 }
print(id<string>(3))
print(id<i32, i32>(3))
print(plain<i32>(3))
print(lam<i32>(3))
print(id<Nope>(3))
print(total<i32>([1]))
const _a = Map<f64, i32>()
const _b = Map<i32>()
const _c = Set<i32, i32>()
function _mk<K, V>(): Map<K, V> { Map<K, V>() }
function _sig<K>(_m: {[K]: i32}) { 0 }
function _st<T>(x: T): boolean { Set<T>().has(x) }
const a = 1
const b = 2
const c = 3
function two(_x: boolean, _y: boolean) { 0 }
print(two(a<b, c>(a)))
