// @run
// @log v
// @log x
// @log x
// @log 3
// A type parameter no parameter names, inferred from a parameter's copy, takes that parameter's
// binding in each instance: a copy of another type parameter's parameter, of an un-annotated one,
// and two copies of one parameter called at two types.
function same<T>(k: T): T { k }
function other<F, G>(a: G) {
  const b: F = a
  print(b("v"))
}
other(same)
function open<F>(a) {
  const b: F = a
  print(b("x"))
}
open(same)
function two<F, G, H>(a: H) {
  const b: F = a
  const c: G = a
  print(b("x"))
  print(c(3))
}
two(same)
