// @run
// @log 5
// @log s
// @log 5
// @log s
// @log 2.5
// @log true
// @log q
// @log 4
// @log 5
// @log 2
// D14803 (owner ruling): an argument only a union of type parameters admits binds every candidate
// parameter to its type, so `G(5)` against `G<A, B>(v: A | B)` reads as `G<i32, i32>(5)`. An
// argument whose members pair one to one with the open members still pairs by position (D3643).
function G<A, B>(v: A | B): A | B { v }
function H<A, B, C>(v: A | B | C): A | B | C { v }
function N<A, B>(v: A | B | null): A | B | null { v }
function S<A, B>(v: A[] | B[]) { return v.length }
print(G(5))
print(G("s"))
print(H(5))
print(H("s"))
print(H(2.5))
print(H(true))
const x: i32 | string = "q"
print(G(x))
const y: i32 | string = 4
print(G(y))
print(N(5) ?? 0)
print(S([1, 2]))
