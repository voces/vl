// @check
// @error member access '.has' on non-object {[string]: i32} | null (the body of `has` at the call's argument types)
// @error cannot index non-array {[string]: i32} | null (the body of `idx` at the call's argument types)
// @error member access '.has' on non-object Set<string> | null (the body of `setHas` at the call's argument types)
// @error member access '.has' on non-object {[string]: i32} | null (the body of `inClosure` at the call's argument types)
// A map method call or index read on a place a type-parameter write narrowed is asked at each
// pin, so a pin where the place may hold `null` refuses it, as the direct spelling does (D3445).
function has<T>(x: T) {
  let s: {[string]: i32} | null = null
  s = x
  print(s.has("k"))
}
function idx<T>(x: T) {
  let s: {[string]: i32} | null = null
  s = x
  print(s["k"] ?? 0)
}
function setHas<T>(x: T) {
  let s: Set<string> | null = null
  s = x
  print(s.has("k"))
}
function inClosure<T>(x: T) {
  let s: {[string]: i32} | null = null
  s = x
  const f = () => s.has("k")
  print(f())
}
const v: {[string]: i32} | null = null
has(v)
idx(v)
const sv: Set<string> | null = null
setHas(sv)
inClosure(v)
