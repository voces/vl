// @run
// @log 6
// @log 1
// @log 6
// @log 99
// @log 1032
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `other` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `v` is inferred as `{x: i32}`
// @hint redundant type annotation: `b` is inferred as `boolean`
// @hint redundant type annotation: `w` is inferred as `{x: i32}`
// The two warnings are DECLARED rather than silenced and the silencing is not
// available: `opSelfFnTy` requires the overload's first parameter to be named exactly
// `self` (the pollution rule, D471), so `_self` would make the declaration inert and
// this file would stop testing the residue it exists for. The `v`/`w` annotations pin
// the object type the overload is declared over; deleting them to quiet a hint would
// delete the axis.
// WHAT THE PIN'S RETURN CHECK MUST NOT COST (silent-class-inventory D551). Re-asking a
// generic's declared return type at the call is only safe if the programs it SHOULD accept
// still run, and three of these five are here because a draft of it took them away.
//
//   · `same`   the plain agreement: the body's type substitutes to the declared return.
//              The rung reaches this call and answers nothing, which is the discrimination
//              the whole landing rests on.
//
//   · `asI32`  THE A7 COERCION, and the reason the pin asks `assignableExpr` rather than
//              `assignable`. A boolean-typed VALUE flows into an `i32` slot as 1/0, and that
//              rule lives at the EXPRESSION seam — deliberately absent from the plain
//              predicate. A first cut asked `assignable` and REFUSED this program while its
//              direct twin `function asI32(self: boolean): i32` runs and prints `1`: a false
//              reject invented by the fix, in the exact shape the row is about.
//
//   · `viaOp`  D532'S FILED RESIDUE, CLOSING. `function viaOp<T>(a: T, b: T): V` returning a
//              deferred operator result used to be a loud `return type mismatch` where the
//              direct spelling ran, because the deferral was kept OUT of an annotated body
//              precisely for want of this check. The bound is gone and the annotation is now
//              re-checked per pin, so the overload's own `V` reaches its `V` declaration —
//              and `print(z.x)` is the overload's answer, 99, not the operand's 6.
//
//   · `rowAt`  D561'S EXEMPTION, kept whole. Recording the constraint when only the DECLARED
//              return carries a hole closes a real family — and widened WITHOUT exception it
//              refuses this, a module that runs correctly, and this whole FILE with it. Its
//              direct spelling IS a loud `return type mismatch: expected A1, got i32`, so the
//              pin would be right by the parity rule the rest of the file is built on; what
//              makes it an exemption and not a fix is that `as` over a type PARAMETER is
//              `` `as` supports numeric conversions only ``, so the author cannot write the
//              cast the direct spelling would need. D561 ships the widening MINUS that one
//              mismatch (`retNomOnlyAtHole`); the residue is D571 and the day `as A` exists,
//              the exemption goes and both close. The corpus module this line stands for is
//              `tests/cases/memory/flat-generic-rows-branded.vl`, and the exemption's own
//              three-cell witness is `declared-return-hole-newtype-brand-keeps.vl`.
type V = { x: i32 }

function same<T>(self: T): V { return self }
const v: V = { x: 6 }
print(same(v).x)

function asI32<T>(self: T): i32 { return self }
const b: boolean = true
print(asI32(b))
print(asI32(6))

function <(self: V, other: V): V { return { x: 99 } }
function viaOp<T>(a: T, b: T): V { return a < b }
const w: V = { x: 3 }
print(viaOp(v, w).x)

type A1 = new i32
type Rows<A> = { base: i32, brand: A }
function rowAt<A>(self: Rows<A>, i: i32): A { return self.base + i * 4 }
const st: Rows<A1> = { base: 1024, brand: 0 }
print(rowAt(st, 2) as! i32)
