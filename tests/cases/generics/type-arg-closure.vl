// @run
// @log 5
// @log s
// @log 7
// @log 2
// @hint redundant type annotation: `p` is inferred as `{a: (i32) -> i32, b: string}`
// A generic alias whose type ARGUMENT is a function type (`Pair<(i32) => i32, string>`).
// Two scanners have to agree for this to resolve:
//   * `splitGenArgs` splits the argument list at its top-level commas. It DID track
//     `<>` depth — but counted the `>` of the arrow `=>` as a closer, so the depth
//     went negative and the comma stopped being top-level: one garbage argument
//     `(i32)=>i32,string`, and an arity error.
//   * `gaeSplitArgs` (the emitter's generic-alias EXPANSION dual, `emit_base.vl`)
//     carries the identical defect, which is why the checker-side fix alone left
//     this failing at emit with `ref valtype with no interned shape`.
// A `>` is a bracket only when an earlier `<` is still open AND it is not the
// arrow's tail — `tyGtIsClose`.
type Pair<A, B> = { a: A, b: B }

function id(x: i32) { x }

const p: Pair<(i32) => i32, string> = { a: id, b: "s" }
print(p.a(5))
print(p.b)

// The same shape through a RETURN annotation, so the emitter expands the alias.
function mk(): Pair<(i32) => i32, i32> { { a: id, b: 2 } }
const q = mk()
print(q.a(7))
print(q.b)
