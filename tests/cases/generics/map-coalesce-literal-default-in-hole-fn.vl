// @run
// @log q
// @log m
// @log m
// A hole function's `.map` callback returning `e ?? "m"` builds a string list at the `null` pin,
// as the callback's inferred signature types it (D17561).
function k(x) { return [x].map((e) => e ?? "m")[0] }
print(k("q"))
print(k(null))
function g(x) {
  return [x]
    .map((e) => {
      return e ?? "m"
    })
    .filter((s) => s == "m")[0]
}
print(g(null))
