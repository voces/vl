// @error argument 1: expected (i32) => i32, got (i32) => f64
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)

// D1821 — a helper whose parameter is annotated with a CONCRETE function type. At check time
// the argument still rides the enclosing frame's unsolved hole, so it is assignable to
// anything and the comparison passes; the deciding type arrives at the pin. The demand parks
// on the hole and is re-asked as each pin lands, so the f64 instance is refused with the
// pin's own types — the same sentence the direct spelling already gives.

function o(n) {
  function k(x: i32) { return n }
  function use(p: (i32) => i32) { return p(1) }
  return use(k)
}
print(o(2))
print(o(2.5))
