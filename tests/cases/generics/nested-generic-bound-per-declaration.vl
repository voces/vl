// @log true
// A nested generic's type parameters are bound per declaration: two functions' nested
// generics of one name, nested generics of plain functions that use one parameter name
// differently (D3888), three levels redeclaring `T`, and calls from a lambda, from a plain
// function in between and from the generic's own body (D3853).
function a<T>(x: T) {
  function b<U>(y: U) {
    const n: i32 = y
    print(n + 1)
  }
  b(x)
}
function c<T>(x: T) {
  function b<U>(y: U) {
    const n: i32 = y
    print(n + 1)
  }
  b(5)
  print(x)
}
a(1)
c(true)
function add(x: i32) {
  function b<U>(y: U) { print(y + 1) }
  b(1)
  print(x)
}
add(1)
function len(x: i32) {
  function c<U>(y: U) { print(y.length) }
  c([1, 2])
  print(x)
}
len(2)
function deep<T>(x: T) {
  function b<T>(y: T) {
    function c<T>(z: T) {
      const n: i32 = z
      print(n)
    }
    c(1)
    print(y)
  }
  b("s")
  print(x)
}
deep(true)
function viaLambda<T>(x: T) {
  function b<U>(y: U) {
    const n: i32 = y
    print(n)
  }
  const g = () => b(3)
  g()
  print(x)
}
viaLambda("s")
function viaMid<T>(x: T) {
  function mid() {
    function b<U>(y: U) {
      const n: i32 = y
      print(n)
    }
    b(4)
  }
  mid()
  print(x)
}
viaMid(true)
function recur<T>(x: T) {
  function b<U>(y: U, k: i32) {
    if k > 0 { b(y, k - 1) }
    print(y)
  }
  b(1, 1)
  print(x)
}
recur(true)
