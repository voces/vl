// @emit-error monomorphize: unsupported argument type
// A field the callee writes through its parameter is not its argument's: the read is not resolved
// through the call (D16739), and the call is refused until its rep is built (D16842).
function inc0(a) { return a + 1 }
function inc1(a) { return a + 2 }
function idm(x) {
  x.f = inc1
  return x
}
const r = idm({ f: inc0 })
print(r.f(3))
