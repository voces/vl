// @run
// @log true
// @log false
// @log true
// @log 3
// @log true
// @log false
// @log true
// @log true
// @log s
// @log 5
// @log 3
// @log 3
// @log 5
// A binding of a value `if` with a `??` arm, returned from a generic body, is delivered at the
// union box the instance's return is annotated with, not at the template's type (D2912).
function g0<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  r
}
print(g0(true, false, true))
print(g0(true, false, false))
function g1<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  return r
}
print(g1(true, false, true))
print(g1(3, 4, true))
function g2<T>(a: T, b: T, c: boolean) {
  const r = if c { if c { a ?? 5 } else { b } } else { b }
  r
}
print(g2(true, false, true))
print(g2(true, false, false))
function g3<T>(a: T, c: boolean) {
  const z = if c { a } else { "s" }
  print(z)
  if c { a } else { 5 }
}
print(g3(true, true))
print(g3(true, false))
function g4<T>(a: T, c: boolean) {
  if c {
    const r = if c { a } else { "s" }
    print(r)
  }
  const r = if c { a } else { 5 }
  r
}
const u4: i32 | string = 3
print(g4(u4, true))
print(g4(u4, false))
