// @run
// @hint Intentionally-unused parameter `_t`
// An annotated `let` seeded with a generic and rewritten, in a generic with two instances, is
// read as itself where it is delivered at its own type, so a list or a field holds what the
// binding holds in this instance, not its seed's instance (D4303).
function b<U>(y: U) {
  print("generic")
  print(y)
}
function a<T>(x: T, flip: boolean) {
  let g: (t: T) => void = b
  const c = (_t: T) => print("local")
  if flip { g = c }
  const fs: ((t: T) => void)[] = [g, c]
  fs[0](x)
  const r: {f: (t: T) => void} = { f: g }
  r.f(x)
}
a(2.5, true)
a("s", true)
a(2.5, false)
a("s", false)
// @log local
// @log local
// @log local
// @log local
// @log generic
// @log 2.5
// @log generic
// @log 2.5
// @log generic
// @log s
// @log generic
// @log s
