// @run
// @hint redundant type annotation: `xs` is inferred as `J[]`
// @log 5
// @log 6
// @log 7
// D8381's annotated face: the literal is bound at the union member first, so the identity's
// pin reads the binding; it must keep agreeing with the un-annotated spelling.
type J = { r: i32 }
type N = { r: i32 | null }
function idn<T>(v: T): T { v }
function take(u: J | string) {
  if u is J { print(u.r) }
}

const l5: J = { r: 5 }
const a: J | string = idn(l5)
if a is J { print(a.r) }
const l6: J = { r: 6 }
take(idn(l6))
const l7: J = { r: 7 }
const xs: J[] = [idn(l7)]
print(xs[0].r)
