// @run
// @log 7
// @log 11
// @log v
// @log 10
// @log 7
// @log 11
// @log v
// @log 10
// @log 12
// @log 11
// @log 11
// @hint redundant type annotation: `ann` is inferred as `(i32) => i32`
// @hint Intentionally-unused parameter `_n`
// A CLOSURE VALUE bound to a bare type parameter (`gid<T>(x: T): T`), at all four closure
// reps and in the positions a function value reaches a generic from.
//
// THE HOLE THIS PINS. `monoArgTyName`'s closure arm was gated on `exprIsClosure`, which
// resolves an Ident through `declaredSlotOf` / `localIsRef` — tables `buildLocals` fills
// AFTER monomorphization runs. Mid-pass it therefore answered "not a closure" for every
// function value that is not a bare top-level function NAME, and the argument fell past
// that arm, past the annotation ladder below it (`monoAnnPinName` declines a closure
// spelling by design) and onto the cascade's `"i32"` catch-all. `T` bound i32, the instance
// declared `(param i32) (result i32)` over a body carrying a `(ref $cloStruct)`, and
// `vl check` was clean while the module was INVALID WASM — `expected (ref $type), found
// i32`. The gate is now the ARENA (`nodeTyIsFunc`), which needs no emitter table at this
// point in the pass, and the pin is `sigKeyOfTy`'s `$fnsig` key — byte-identical to the one
// the top-level-name route already produced, so both routes key ONE instance.
//
// ALL FOUR REPS, because the wasm result valtype differs across them and a pin that names
// the arity but not the result would still miscompile three of the four: `() => i32`
// (i32 result, no params), `(i32) => i32`, `(i32) => string` (a `(ref array)` result) and
// `(i32) => i32[]` (a ref-list result).
function gid<T>(x: T): T { return x }

// ── module scope: the generic call and its closure argument are both top-level ──
const g0 = () => 7
const g1 = (n: i32) => n + 1
const g2 = (_n: i32) => "v"
const g3 = (n: i32) => [n, n]
print(gid(g0)())
print(gid(g1)(10))
print(gid(g2)(10))
print(gid(g3)(10)[0])

function body() {
  // ── inside a function: the closure is a LOCAL, which is the shape `declaredSlotOf`
  // cannot answer for during the pass ──
  const f0 = () => 7
  const f1 = (n: i32) => n + 1
  const f2 = (_n: i32) => "v"
  const f3 = (n: i32) => [n, n]
  // Bound first, then called (the result of the instance is the closure again).
  const q0 = gid(f0)
  const q1 = gid(f1)
  const q2 = gid(f2)
  const q3 = gid(f3)
  print(q0())
  print(q1(10))
  print(q2(10))
  print(q3(10)[0])

  // A lambda LITERAL handed straight to the generic. The old closure arm reached this one
  // (a `FuncDecl` argument IS `exprIsClosure`) and then had no key for it — `ce is Ident`
  // failed — so it returned "" and monomorphization rejected the call loudly.
  print(gid((n: i32) => n + 2)(10))

  // A CAPTURING closure: the pin names the signature, and the captured env rides the
  // fat-pointer through the instance untouched.
  const k = 1
  const cap = (n: i32) => n + k
  print(gid(cap)(10))
}
body()

// The ANNOTATED spelling of the same binding, which reaches the pin through a different
// channel (the annotation ladder declines it, so the arena answers here too).
function annotated() {
  const ann: ((i32) => i32) = (n) => n + 1
  print(gid(ann)(10))
}
annotated()
