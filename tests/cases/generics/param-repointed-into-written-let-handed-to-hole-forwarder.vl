// @run
// @log x
// @log 3
// A parameter written into a `let` of its own type parameter and handed on to a hole forwarder,
// beside a direct call at another type, keys the forwarder at the set the instance holds (D15400).
function same<T>(k: T): T { k }
function take2(a) { print(a(3)) }
function fwd(f) { take2(f) }
function viaForward<F>(a: F, a1: F) {
  let b: F = a1
  b = a
  print(a("x"))
  fwd(b)
}
viaForward(same, same)
