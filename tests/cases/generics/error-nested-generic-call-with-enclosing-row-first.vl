// @error cannot assign boolean to 'n' of type i32
// A nested generic whose first parameter is the enclosing generic's `U`: its call is a call to
// it, not to the enclosing one, and its own demand is checked (D3853 review).
function m() {
  function b<U>(y: U) {
    function c<V>(w: U, z: V) { const n: i32 = z; print(n + 1) }
    c(y, true)
  }
  b(5)
}
m()
