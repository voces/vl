// @check
// @error cannot infer type parameter `T` in this call to `first`: its argument is `i32[] | K[]`
// A list and its numeric-literal twin share storage but not a type: neither `T = i32` nor `T = K`
// accepts both members, since a list never widens, so the call is refused as any list union is.
type K = 1 | 2
function first<T>(xs: T[]): T { return xs[0] }
const q: i32[] | K[] = [1, 2]
const b: boolean = first(q)
print(b)
