// @error cannot assign boolean to 'n' of type i32
// A nested generic returned where the enclosing `T` types the function: its demand is checked at
// the enclosing pin, as a call of it with a `T` is (D3896).
function a<T>(x: T): (T) => void {
  function b<U>(y: U) { const n: i32 = y; print(n + 1) }
  return b
}
a(true)(true)
