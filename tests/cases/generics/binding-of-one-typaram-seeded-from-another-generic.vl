// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 3
// A binding annotated with one type parameter, seeded from a parameter of another, the two bound
// to different generics called at different types: the binding holds what it is written, not
// its annotation's pin, so its call runs the generic it was seeded with (D17117).
function same<T>(k: T): T { return k }
function twice<T>(k: T): T { return k }
function mid<F, G>(a: F, a1: G) {
  let b: F = a1
  print(a("x"))
  print(b(3))
}
mid(same, twice)
