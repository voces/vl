// @run
// @hint redundant type annotation: `l3` is inferred as `i32[]`
// @log false
// @log 2
// @log 3
// @log true
// @log a
// A declared `A | B | null` whose two pins are the same nullable list is one `i32[] | null`: the
// two substituted list rows were kept as two arms of a box nothing collected (D3503).
const nl: i32[] | null = [1, 2]
const l3: i32[] = [1, 2, 3]
const nsl: string[] | null = ["a"]
function F<A, B>(k: i32, a: A, b: B): A | B | null {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
const u = F(0, nl, nl)
print(u == null)
if u is i32[] { print(u.length) } else { print(0) }
const v = F(1, nl, l3)
if v is i32[] { print(v.length) } else { print(0) }
print(F(2, nl, l3) == null)
const s = F(1, nsl, nsl)
if s is string[] { print(s[0]) } else { print("none") }
