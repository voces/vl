// @run
// @log 5
// @log 7
// @log 11
// @log 13
// @log 17
// A TRANSPARENT alias whose body is a generic APPLICATION (`type Y = Box<i32>`), in the
// FIELD positions — the pin for the alias's emit SPELLING being the application NAME.
//
// A one-member alias denotes its member, and the emitter is handed the member's render
// (`transparentMemberEmitName`). For an object member with a declared name that render is
// the NAME (`type MyCat = Cat` → `Cat`); an application has no declared struct to name — no
// `TypeDecl` is spelled `Box<i32>` — so the rung below it renders the APPLICATION
// (`genAppNameOfTy`), which is equally nominal: the head is declared and the arguments
// render nominally under it.
//
// THE RENDER AND THE FIELD-CODE ROUTE ARE ONE CHANGE. Under a STRUCTURAL render the field
// below reached `fieldTypeCode` as the inline shape `{v:i32}`; under the application name it
// reaches it as `Box<i32>`, which only codes as a struct-ref field because
// `nameIsGenAppDecl` routes it. Ship the render without the route and this file is the cell
// that goes down, with the reject the DIRECT spelling `{ c: Box<i32> }` used to take
// (`emitProgram: only i32 / boolean / string / array struct fields are supported`).
//
// Every log line here is the DIRECT-spelling twin's log in
// `generics/generic-application-struct-field.vl`: the two spellings denote one type, so any
// position where they disagree is a defect in whichever of them moved.
type Box<T> = { v: T }
type Node2 = { n: i32 }
type Y = Box<i32>
type YN = Box<Node2>

// The alias as a struct FIELD.
type Holder = { c: Y }
const h: Holder = { c: { v: 5 } }
print(h.c.v)

// …with a STRUCT argument behind the alias.
type Deep = { c: YN }
const d: Deep = { c: { v: { n: 7 } } }
print(d.c.v.n)

// The NULLABLE field spelling of the alias.
type OptHolder = { c: Y | null }
const o: OptHolder = { c: { v: 11 } }
const oc = o.c
if oc != null { print(oc.v) }

// A UNION-VARIANT field typed by the alias.
type Cat = { c: Y }
type Dog = { d: i32 }
type U = Cat | Dog
const u: U = { c: { v: 13 } }
if u is Cat { print(u.c.v) }

// The ARRAY-of-alias field — the control that lowered before either half existed.
type ListHolder = { c: Y[] }
const l: ListHolder = { c: [{ v: 16 }, { v: 17 }] }
print(l.c[1].v)
