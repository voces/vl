// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// @log e=true
// @log e=true
// @log true
// @log true
// @log true
// @log 2.5
// @log 2.5
// @log s
// @log s
// @log true
// @log true
// @log b
// @log true
// @log true
// @hint redundant type annotation: `zs` is inferred as `T[]` — remove it to lean on inference
// A for-in over an inline list literal holding a generic call on the enclosing `<T>`: the loop
// variable takes the element the instance binds, so a `boolean` prints as `true`, not as its
// `i32` rep (D3835). The value reaches `print`, a third generic, and an interpolation.
function id<U>(u: U): U { u }
function show<V>(v: V) { print(v) }

function outer<T>(x: T) {
  for e in [id(x), x] { print(e) }
}
outer(true)

// One element, the call second, and a hole callee.
function one<T>(x: T) {
  for e in [id(x)] { print(e) }
  for e in [x, id(x)] { show(e) }
}
one(true)
function hid(u) { u }
function viaHole<T>(x: T) {
  for e in [hid(x)] { print("e=\{e}") }
}
viaHole(true)
function interp<T>(x: T) {
  for e in [id(x)] { print("e=\{e}") }
}
interp(true)

// An un-annotated enclosing function, then three more instances of one.
function hole(x) {
  for e in [id(x)] { print(e) }
}
hole(true)
function many<T>(x: T) {
  for e in [id(x), x] { print(e) }
}
many(true)
many(2.5)
many("s")

// A nullable boolean and a literal union.
const nb: boolean | null = true
function nul<T>(x: T) {
  for e in [id(x), x] { print(e) }
}
nul(nb)
const lb: "a" | "b" = "b"
function lit<T>(x: T) {
  for e in [id(x)] { print(e) }
}
lit(lb)

// The bound spellings, which already ran.
function bound<T>(x: T) {
  const ys = [id(x)]
  for e in ys { print(e) }
  const zs: T[] = [id(x)]
  for e in zs { print(e) }
}
bound(true)
