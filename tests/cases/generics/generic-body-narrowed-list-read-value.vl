// @run
// @log z
// @log true
// @log z
// @log 2
// @log 0
// @log 3
// Inside a generic body, an `is T[]`-narrowed read of an inferred `T[] | i32[]` used as a
// value lowers at each pin: the join is typed as the pin types it, and an arm the pin's own
// `is` test rules out is not lowered at the arm's type (D2876).
function w<T>(t: T, b: boolean) {
  if b { return [t, t] }
  [1, 2, 3]
}

function elem<T>(t: T, b: boolean) {
  const v = w(t, b)
  const e = if v is T[] { v[0] } else { t }
  print(e)
}

function elemInline<T>(t: T, b: boolean) {
  const v = w(t, b)
  print(if v is T[] { v[0] } else { t })
}

function len<T>(t: T, b: boolean) {
  const v = w(t, b)
  print(
    if v is T[] { v.length } else if v is i32[] { v.length } else { __trap__() },
  )
}

function concreteArm<T>(t: T, b: boolean) {
  const v = w(t, b)
  print(if v is i32[] { v.length } else { 0 })
}

elem("z", true)
elem(true, true)
elemInline("z", true)
len(1.5, true)
concreteArm(1.5, false)
len("z", false)
