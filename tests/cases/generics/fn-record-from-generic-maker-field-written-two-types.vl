// @run
// @log 2
// @log 2.5
// @log 3
// @log 3.5
// @log 1
// @log s
// @log q
// A record a generic maker returns, its function field written with another generic and called
// at two types, holds the widened set as a plain maker's does, in each instance (D15743).
function id0(a) { return a }
function id1(a) { return a }
function mk<T>(x: T) { return { f: id1, x: x } }
const r = mk(1)
r.f = id0
print(r.f(2))
print(r.f(2.5))
const s = mk("s")
s.f = id0
const g = s.f
print(g(3))
print(g(3.5))
print(r.x)
print(s.x)
print(s.f("q"))
