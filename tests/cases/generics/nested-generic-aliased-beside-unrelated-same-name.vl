// @run
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @log 2
// @log true
// A nested generic called through an alias beside another function's nested generic with the
// same parameter name (D3853 review).
function a<T, S>(x: T, s: S) {
  function b<U>(y: U) { const n: i32 = y; print(n + 1) }
  const f = b
  f(1)
  function q<U>(y: U) { print(y) }
  q(s)
}
a(1, true)
