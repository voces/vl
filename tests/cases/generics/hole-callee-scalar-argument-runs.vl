// @run
// @log 3
// @log 6
// @log 2
// @log 3
// @log 1
// @log 7.5
// @log 3
// @hint redundant type annotation: `i` is inferred as `i32`
// @hint redundant type annotation: `b` is inferred as `boolean`
// D3225's keep-running half: what the direct call admits, the pin admits. A widening
// (`i32` into `f64`), a literal taking the parameter's width (`3` into `f32`), and a
// `boolean` value into `i32`, which the language delivers as `1`/`0`, each run through a
// hole callee and print what the direct call prints.
function apply(h, v) { return h(v) }

const i: i32 = 3
const b: boolean = true
print(apply((x: f64) => x, i))
print(apply((x: f64) => x * 2.0, 3))
print(apply((x: i32) => x + 1, b))
print(apply((x: f32) => x, 3))
print(apply((x: i32) => x, b))

function forward(h, v) { return apply(h, v) }
print(forward((x: f64) => x * 2.5, i))

// A literal inside a forwarding body keeps its adoption at the outer call.
function three(h) { return apply(h, 3) }
print(three((x: f32) => x))
