// @run
// @log 3
// @log 5
// @log 2
// Written type arguments annotate an open lambda by substituting type parameters in TYPE
// positions of the declared spelling only (D2434): a record field named like the type
// parameter, a string-literal member spelled like it, and a map key that IS it.
function ap<K>(f: ({ K: K }) => i32, x: { K: K }) { f(x) }
print(ap<string>((o) => o.K.length, { K: "abc" }))
function lit<A>(f: (A | "A") => i32, x: A) { f(x) }
print(lit<i32>((v) => if v is i32 { v + 2 } else { 0 }, 3))
function sz<V>(f: ({[string]: V}) => i32, m: {[string]: V}) { f(m) }
const m: {[string]: string} = Map()
m["V"] = "x"
m["y"] = "z"
print(sz<string>((q) => q.size, m))
