// D14084: a generic join of lists, one bound to a literal-union list beside a `string[]`, reads
// each arm at its own rep: the instance's copy of the list-union rewrite tests the stored arm.
type K = "a" | "b"
function g<T0, T1, T2>(a0: T0[], a1: T1[], a2: T2[], k: i32) {
  const r = match k {
    0 => a0
    1 => a1
    _ => a2
  }
  print(r.length)
  print(r[0])
}
function h<T0, T2>(a0: T0[], a2: T2[], k: i32) {
  const r = if k == 0 { a0 } else { a2 }
  for e in r { print(e) }
}
const x2: K = "a"
g(["x", "z"], [false], [x2], 0)
g(["x", "z"], [false], [x2], 1)
g(["x", "z"], [false], [x2], 2)
h(["y"], [x2], 0)
h(["y"], [x2], 1)
h([1, 2], [x2], 1)
