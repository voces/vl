// @run
// @log null
// @log d
// @log s
// @log s
// @log null
// @log true
// @log t
// @log false
// @log -1
// @log 4
// A hole's `string | null` value written into a `(string | null)[]` cell, or held as a nested
// literal's inner element, keeps its `null` for the reads after it (D3114).
function f(x) {
  const l: (string | null)[] = [null]
  l[0] = x
  print(l[0])
  print(l[0] ?? "d")
}
const v0: string | null = null
f(v0)
f("s")
function g(x) {
  const l = [[x]]
  print(l[0][0])
  const i = l[0]
  print(i[0] == null)
}
g(v0)
const v1: string | null = "t"
g(v1)
function h(x) {
  const l: (i32 | null)[] = [null]
  l[0] = x
  print(l[0] ?? -1)
}
const n0: i32 | null = null
h(n0)
h(4)
