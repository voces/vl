// @run
// @log true
// @log true
// @log false
// @log false
// @log false

// D2593: `a ?? false` over a parameter pinned at `boolean | null` is a boolean, and prints as one.
function mk(n: i32): boolean | null {
  if n == 1 { return true }
  null
}
function take(a) {
  print(a ?? false)
  const b = a ?? false
  print(b)
}
function flip(a) { print(!(a ?? true)) }
take(mk(1))
take(mk(0))
flip(mk(0))
