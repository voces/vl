// @run
// @log 6
// @log 2
// @log true
// @log 5
// @log 4
// @log 7
// A hole lambda or function forwarding its parameter to a generic with an `i32` demand runs where
// the enclosing pin, or a literal argument, satisfies it (D3893).
function b<U>(y: U) {
  const n: i32 = y
  print(n + 1)
}
function viaLambda<T>(x: T) {
  const g = (q) => b(q)
  g(x)
}
viaLambda(5)
function viaLiteral<T>(x: T) {
  const g = (q) => b(q)
  g(1)
  print(x)
}
viaLiteral(true)
function twoHops<T>(x: T) {
  const g = (q) => b(q)
  const h = (r) => g(r)
  h(x)
}
twoHops(4)
function viaFunction<T>(x: T) {
  function g(q) { b(q) }
  g(x)
}
viaFunction(3)
function nested<T>(x: T) {
  function c<U>(y: U) {
    const n: i32 = y
    print(n + 1)
  }
  const g = (q) => c(q)
  g(x)
}
nested(6)
