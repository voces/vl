// @run
// @log false
// @log true
// @log false
// @log true
// @hint redundant type annotation: `z` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `y` is inferred as `boolean` — remove it to lean on inference
// A `T | null` niche pinned at a record holds one member, so `is` against an anonymous record of
// the same field names (one variant row) answers from the exact pin, not the null test (D2778).
function z<Z>(u: Z | null): boolean { u is {a: string} }
print(z<{a: i32}>({ a: 1 }))
print(z<{a: string}>({ a: "x" }))
function y<Y>(u: Y | null): boolean { u is {a: i32[]} }
print(y<{a: string[]}>({ a: [] }))
print(y<{a: i32[]}>({ a: [] }))
