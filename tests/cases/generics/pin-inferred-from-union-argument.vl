// A type parameter inferred against a union annotation binds to the argument's members the
// annotation's own members do not name, in any order, or to the whole argument when it is all
// concrete members (D2734, D2717, D2486, D2674).
function f<T>(u: T | string): boolean { u is Set<i32> }
function r<T>(u: string | T): boolean { u is Set<i32> }
const s: Set<i32> = Set()
const m: {[i32]: boolean} = Map()
const us: Set<i32> | string = s
const um: {[i32]: boolean} | string = m
print(f(us))
print(f(um))
print(f<Set<i32>>("x"))
const nm: {[i32]: boolean} | null = m
const ns: Set<i32> | null = s
print(f(nm))
print(f(ns))
print(r(nm))
print(r(ns))
function g<T>(u: T | null): boolean { u == null }
const l: i32[] = []
print(g(l))
print(g(m))
function h<T>(x: T | string): boolean { x is string }
print(h(1))
print(h("s"))
type R = { a: i32 }
type S = { b: i32 }
const v: R | S = { a: 1 }
const v2: R | S = { b: 2 }
function k<T>(u: T | null): boolean { u is R }
print(k(v))
print(k(v2))
function b<T>(_u: T | string, v: T): T { v }
const xn: i32 | null = null
print(b(xn, true))
print(b("s", 5))
function c<T>(_u: T | i32 | null, v: T): T { v }
print(c(xn, "hi"))
function d<T>(_u: T | null, v: T): T { v }
print(d(null, "yo"))
function e<T>(_u: T | string, v: T): T { v }
const rec: R = { a: 4 }
print(e("q", rec).a)
function g2<T>(v: T, _u: T | string): T { v }
print(g2(rec, "q").a)
const rl: R[] = [{ a: 1 }]
print(e("q", rl).length)
function h3<T>(_u: T | string): i32 { 1 }
print(h3<R[]>("q"))
