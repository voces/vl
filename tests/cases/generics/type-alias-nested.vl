// @run
// @log 3
// @log x
// @log 1
// @log y
// @hint redundant type annotation: `nested` is inferred as `{value: {a: i32, b: string}}`
// @hint redundant type annotation: `ps` is inferred as `{a: i32, b: string}[]`
// Nested application: a generic alias may appear as another's type argument
// (`Box<Pair<i32, string>>`) and at array-element position (`Pair<…>[]`). The
// inner alias is applied first (to a concrete object type), which then flows in
// as the outer alias's argument — substitution composes. `>>` closing two nested
// applications is ONE lexer token (SHR), so the inner close consumes it whole and banks
// the second `>` as a credit the outer close drains — see
// `nested-application-close-continuation.vl` for what that credit must NOT be spent on.
type Box<T> = { value: T }
type Pair<A, B> = { a: A, b: B }

const nested: Box<Pair<i32, string>> = { value: { a: 3, b: "x" } }
print(nested.value.a)
print(nested.value.b)

const ps: Pair<i32, string>[] = [{ a: 1, b: "y" }]
print(ps[0].a)
print(ps[0].b)
