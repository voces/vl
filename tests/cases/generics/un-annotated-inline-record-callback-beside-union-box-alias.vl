// @run
// @log true
// @log 9
// An un-annotated `{ v: { x: 9 } }` mapped beside `Box<i32 | string>`, whose row boxes `v` (D3920).
type A = { x: i32 }
function h<T>(x: T) { x.x }
type Box<T> = { v: T }
const bu: Box<i32 | string> = { v: "s" }
print(bu.v is string)
const o = { v: { x: 9 } }
print([o].map((e) => h(e.v))[0])
