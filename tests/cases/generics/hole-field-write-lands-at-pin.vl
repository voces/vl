// @run
// @log 9
// @log 9
// A write to a hole's field in an `is` test's else arm reads the written member after it, at
// the pin, as the direct spelling's write re-narrows the field (D3233).
type A = { v: i32 }
type B = { s: string }
function viaParam<Z>(z: Z) {
  if z.h is A {
    print(z.h.v)
  } else {
    z.h = { v: 9 }
    print(z.h.v)
  }
}
function viaHole(z) {
  if z.h is A {
    print(z.h.v)
  } else {
    z.h = { v: 8 }
    print(z.h.v + 1)
  }
}
const x: { h: A | B } = { h: { s: "bee" } }
viaParam(x)
const y: { h: A | B } = { h: { s: "see" } }
viaHole(y)
