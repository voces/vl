// @run
// @warning `k` shadows the `k` declared at 13:9 in this function
// An alias of a nested capturing generic, in a generic outer with two instances, reads each
// instance's own nested function even where an inner block binds the alias's name again: the
// copy follows the binding in scope, not the name (D4302, D3906).
function call(f: (n: i32) => void, n: i32) { f(n) }
function outer<T>(x: T, tag: string) {
  function inner<U>(u: U) {
    print(tag)
    print(x)
    print(u)
  }
  const k = inner
  if true {
    const k = 5
    print(k)
  }
  call(k, 1)
  k(0)
}
outer(7, "A")
outer(true, "B")
// @log 5
// @log A
// @log 7
// @log 1
// @log A
// @log 7
// @log 0
// @log 5
// @log B
// @log true
// @log 1
// @log B
// @log true
// @log 0
