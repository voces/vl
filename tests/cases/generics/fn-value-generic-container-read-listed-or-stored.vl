// @run
// @log 7
// @log w
// @log 7
// @log w
// @log 3
// @log v
// @log 4
// @log 4
// @log 4
// @log 4
// @log true
// @log 4
// A generic function read out of a record field or a list element runs when that read is put in a
// list literal and called at two types (D10390), or stored in an un-annotated `Map()` and handed
// to a generic at two types (D10383); a map-read generic bound to a re-pointed `let` runs when
// the `let` is listed and handed on at two types (D10384).
function id<T>(x: T): T { x }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function runAll<U>(a: ((x: U) => U)[], u: U): U { a[0](u) }

const r = { f: id }
const ws = [r.f]
print(ws[0](7))
print(ws[0]("w"))

const arr = [id]
const xs = [arr[0]]
print(xs[0](7))
print(xs[0]("w"))

const vs = [arr[0], r.f]
print(vs[1](3))
print(vs[0]("v"))

const w = { f: id }
const m = Map()
m["k"] = w.f
const mv = m["k"]
if mv != null { print(run(mv, 2) + run(mv, "ab").length) }

const w2 = { f: id }
const g = w2.f
const mg = Map()
mg["k"] = g
const mgv = mg["k"]
if mgv != null { print(run(mgv, 2) + run(mgv, "ab").length) }

const ma = Map()
ma["k"] = arr[0]
const mav = ma["k"]
if mav != null { print(run(mav, 2) + run(mav, "ab").length) }

const mp = Map()
mp["k"] = id
const mpv = mp["k"]
if mpv != null {
  let p = mpv
  p = mpv
  print(runAll([p], 2) + runAll([p], "ab").length)
}
const mq = Map()
mq["k"] = id
const mqv = mq["k"]
const mqa = mq["absent"]
print(mqa == null)
if mqv != null {
  let q = mqv
  q = mqv
  print(runAll([q], 2) + runAll([q], "ab").length)
}
