// @check
// @error field 's' is not on every member of A | B — narrow with `is` first (no 's' on A) (the body of `viaCall` at the call's argument types)
// @error field 's' is not on every member of A | B — narrow with `is` first (no 's' on A) (the body of `viaAlias` at the call's argument types)
// @error field 's' is not on every member of A | B — narrow with `is` first (no 's' on A) (the body of `viaClosure` at the call's argument types)
// @error field 's' is not on every member of A | B — narrow with `is` first (no 's' on A) (the body of `viaHoleAlias` at the call's argument types)
// A call, an alias write or a closure write in the else arm of an `is` test on a hole's field
// ends the remainder the arm narrowed to, so a read of it after the write is refused at the pin,
// as the direct spelling refuses it (D3420).
type A = { v: i32 }
type B = { s: string }
type W = { h: A | B }
function wA(w: W) { w.h = { v: 7 } }
function viaCall<Z>(z: Z) {
  if z.h is A {
    print(z.h.v)
  } else {
    wA(z)
    print(z.h.s)
  }
}
function viaAlias<Z>(z: Z) {
  if z.h is A {
    print(z.h.v)
  } else {
    const al = z
    al.h = { v: 8 }
    print(z.h.s)
  }
}
function viaClosure<Z>(z: Z) {
  if z.h is A {
    print(z.h.v)
  } else {
    const c = () => {
      z.h = { v: 6 }
    }
    c()
    print(z.h.s)
  }
}
function viaHoleAlias(z) {
  if z.h is A {
    print(z.h.v)
  } else {
    const al = z
    al.h = { v: 8 }
    print(z.h.s)
  }
}
const x: W = { h: { s: "bee" } }
viaCall(x)
viaAlias(x)
viaClosure(x)
viaHoleAlias(x)
