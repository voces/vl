// @emit-error a nullable-string list element has no rep; use a non-null element type
// D2525's boundary: a `(V | null)[]` over a type parameter builds at a boxed or reference `V`
// (see nullable-type-param-list.vl), and stays a loud refusal where `V | null` is a niche — a
// string here, and a boolean, a literal union of strings or a function type the same way. The
// instance would read its elements at the template's rep, so it must not build.
function put<V>(xs: (V | null)[], id: i32, v: V) {
  const none: V | null = null
  while xs.length <= id { xs.push(none) }
  xs[id] = v
}

const s: (string | null)[] = []
put(s, 2, "a")
print(s[2] ?? "-")
