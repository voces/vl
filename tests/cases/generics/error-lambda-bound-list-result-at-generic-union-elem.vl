// @check
// @error a function of type `() => i32[]` cannot be used as `() => (i32 | boolean)[]` here
// A lambda that can return a bound list keeps its own result: only a fresh literal is built at
// the bound union, and the bound `i32[]` never widens to `(i32 | boolean)[]` (D16918).
function last<T>(f: () => (T | boolean)[]): T | boolean {
  const xs = f()
  return xs[xs.length - 1]
}
const c = 3 > 2
const ys = [5]
const r = last(() => {
  if c { return ys }
  return [2]
})
if r is boolean { print(0) } else { print(r + 1) }
