// @run
// @log n
// @log true
// @log isnull
// @log abc
// @log false
// @log 3
// @log xy
// @log false
// @log 2
// @log n
// @log c
// @log xy
// @log xy
// @log 0
// @log -1
// @log 5
// @log 5
// @log none
// @log 4
// @log b
// @log r
// A place a type-parameter value was written into reads at the member of its declaration each
// pin lands on: a nullable pin keeps its null tests real, a non-null pin reads the value (D3240).
type P = { v: i32 }
type Q = { s: string | null }
function name<T>(x: T) {
  let s: string | null = "q"
  s = x
  print(s ?? "n")
  print(s == null)
  if s != null { print(s.length) } else { print("isnull") }
}
function field<T>(x: T) {
  const q: Q = { s: null }
  q.s = x
  print(q.s ?? "n")
  const f = () => q.s ?? "c"
  print(f())
}
function elem<T>(x: T) {
  const a: (i32 | null)[] = [null]
  a[0] = x
  print(a[0] ?? 0)
  const f = () => a[0] ?? -1
  print(f())
}
function rec<T>(x: T) {
  let r: P | null = null
  r = x
  if r != null { print(r.v) } else { print("none") }
}
function back<T>(x: T): string | null {
  let s: string | null = null
  s = x
  return s
}
const sn: string | null = null
const sv: string | null = "abc"
name(sn)
name(sv)
name("xy")
field(sn)
field("xy")
const inull: i32 | null = null
elem(inull)
elem(5)
const pn: P | null = null
rec(pn)
rec({ v: 4 })
print(back(sn) ?? "b")
print(back("r") ?? "b")
