// @run
// @log 10000000000
// @log 8
// @log 2
// @log 12345678901
// @log 1
// @log y
// A GENERIC function called with an `i64[]` ARGUMENT binds its type parameter to `i64`.
// The monomorphizer's argument-type classifier (`monoArgTyName`) named a string / f64 /
// struct array argument but fell THROUGH an i64 array to the i32-list default
// (`"i32[]"`), so `head(xs)` instantiated `head<i32>` — the instance's functype declared
// the i32-list param and an i32 result while the caller passed the i64 list and printed
// an i64, so the module failed wasm validation. One instantiation was enough: this is a
// per-ELEMENT-TYPE hole, not an arity one.

function head<T>(self: T[]): T { return self[0] }
function at<T>(self: T[], i: i32) { return self[i] }
function count<T>(self: T[]): i32 { return self.length }

const xs: i64[] = [10000000000, 8]
print(head(xs)) // 10000000000
print(at(xs, 1)) // 8
print(count(xs)) // 2

// A LITERAL-built i64 list (an out-of-i32-range element makes the literal i64).
print(head([12345678901, 2])) // 12345678901

// The SAME generics still serve `i32[]` and `string[]` — each element type gets its
// own instance.
print(head([1, 2])) // 1
print(head(["y", "z"])) // y
