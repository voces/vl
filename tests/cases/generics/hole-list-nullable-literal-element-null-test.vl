// @run
// @log false
// @log true
// @log false
// D3174: an element of a list built from a hole parameter, read at a pin of `K | null` or
// `K | L | null`, is tested against the atom niche's `null`, not a bare null.
type K = "a" | "b"
type L = "x" | "y"
function g(x) {
  const m = [x]
  print(m[0] == null)
}
const a: K | null = "b"
g(a)
const z: K | null = null
g(z)
function h(x) {
  const m = [x].map((e) => e)
  print(m[0] == null)
}
const b: K | L | null = "y"
h(b)
