// @run
// @log 6
// @log 7
// @log 8
// @log v
// The spellings of a top-level generic seeding a binding that already ran: annotated and called at
// the parameter's own type, and un-annotated beside a call of the parameter (D17870).
function same<T>(k: T): T { return k }
function other<T>(k: T): T { return k }
function m3<F>(a: F) {
  const b: F = other
  print(a(6))
  print(b(7))
}
m3(same)
function m4<F>(a: F) {
  const b = other
  print(a(8))
  print(b("v"))
}
m4(same)
