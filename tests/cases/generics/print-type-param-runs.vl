// @run
// @log 7
// @log 7
// @log a
// @log a
// @log 1.5
// @log 1.5
// @log true
// @log true
// @log 97
// @log 97
// @log 2
// @log 2
// @log 3
// @log 3
// @log 1
// @log 1
// @log abc
// @log abc
// @log 7
// @log 7
// @log 1.5
// @log 1.5
// @log true
// @log true
// THE ACCEPT SET of `silent-class-inventory` D401 — every argument rep whose `print`
// through a type parameter is still admitted, READ BACK BY VALUE beside its direct
// spelling.
//
// The refusal this pairs with (`error-print-type-param.vl`) is a capability check at the
// generic call site, and a capability check that over-refuses is a false reject nothing
// else in the suite would catch: the whole family is `vl check` clean on master, so the
// only witness that the new pin did not eat a working program is a program that prints
// its answers. Every line below is emitted twice — once through the generic and once
// written out — and the two must agree.
//
// The `.length` column is here for the same reason: it is an i32 result, so it carries no
// hole and the constraint is never recorded for it. It must keep printing at every
// receiver rep, including the ones whose ELEMENT print is refused.

type CM = {[string]: i32}

function pElem<T>(x: T) { print(x[0]) }
// EACH GENERIC NAMES ITS OWN TYPE PARAMETER, and that is load-bearing rather than tidy: a
// hole's ARRAY DEMAND is keyed by the type-parameter NAME, so sharing `T` between `pElem`
// and `pLen` makes `pElem`'s `x[0]` demand an array of `pLen`'s MAP receiver and rejects a
// program that runs.
function pLen<L>(x: L) { print(x.length) }
function pBare<U>(x: U) { print(x) }

function mkm(): CM { const m: CM = Map(); m["k"] = 1; m }

// ── ELEMENT reads whose element is a printable scalar/string ──────────────────────────
function i32ElemDirect(v: i32[]) { print(v[0]) }
function strElemDirect(v: string[]) { print(v[0]) }
function f64ElemDirect(v: f64[]) { print(v[0]) }
function boolElemDirect(v: boolean[]) { print(v[0]) }
function strCodeDirect(v: string) { print(v[0]) }

// ── `.length`, at receivers whose ELEMENT print is refused ────────────────────────────
function nestLenDirect(v: i32[][]) { print(v.length) }
function strLenDirect(v: string) { print(v.length) }
function mapLenDirect(v: CM) { print(v.length) }

// ── the BARE position at every printable rep ──────────────────────────────────────────
function strDirect(v: string) { print(v) }
function i32Direct(v: i32) { print(v) }
function f64Direct(v: f64) { print(v) }
function boolDirect(v: boolean) { print(v) }

function body() {
  const ints = [7, 8]
  i32ElemDirect(ints)
  pElem(ints)
  const strs = ["a", "b"]
  strElemDirect(strs)
  pElem(strs)
  const flts = [1.5, 2.5]
  f64ElemDirect(flts)
  pElem(flts)
  const bools = [true, false]
  boolElemDirect(bools)
  pElem(bools)
  const s = "abc"
  strCodeDirect(s)
  pElem(s)

  const nest = [[7, 8], [9, 10]]
  nestLenDirect(nest)
  pLen(nest)
  strLenDirect(s)
  pLen(s)
  const m = mkm()
  mapLenDirect(m)
  pLen(m)

  strDirect(s)
  pBare(s)
  i32Direct(7)
  pBare(7)
  f64Direct(1.5)
  pBare(1.5)
  boolDirect(true)
  pBare(true)
}
body()
