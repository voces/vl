// @check
// @error cannot assign i32[] to 'r' of type string[]
// A generic's `T[]` result through an un-annotated parameter carries the argument's element
// type, so a destination of another element type is refused (D6500).
function g<T>(x: T[]): T[] { return x }
function f(a) { return g(a) }
const r: string[] = f([3])
print(r.length)
