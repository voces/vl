// A generic's `T | B` bound at `T := B` is the record `B`, with no union around it: an open
// arm's union registers its members only in its instances (D7050).
type A = { x: i32 }
type B = { x: i32 }
type C = { y: string }

function orB<T>(v: T): T | B { return v }
function pn<T>(_a: T, b: B): T | B { return b }
function orBN<T>(v: T): T | B | null { return v }
function pick<T>(v: T, w: B, k: boolean): T | B { return if k { v } else { w } }
function show(b: B) { return b.x }

const b: B = { x: 4 }
print(orB(b).x)
const r = orB(b)
print(r.x)
const ra = orB(b)
print(show(ra))
print(show(orB(b)))
const a: A = { x: 1 }
print(pn(a, b).x)
const rn = orBN(b)
if rn != null { print(rn.x) }
const c: C = { y: "cc" }
const rc = pick(c, b, false)
if rc is B { print(rc.x) } else { print(rc.y) }
const rc2 = pick(c, b, true)
if rc2 is B { print(rc2.x) } else { print(rc2.y) }
const bs: B[] = [orB(b), orB({ x: 9 })]
print(bs[1].x)
// @hint Intentionally-unused parameter `_a`
// @hint redundant type annotation: `bs` is inferred as `B[]`
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log cc
// @log 9
