// @error cannot assign boolean to 'n' of type i32
// A nested generic the enclosing body passes as a value: its demands are checked at the
// enclosing pin by name, as nothing else binds them (D3853 review).
function run<A>(f: (a: A) => void, v: A) { f(v) }
function a<T>(x: T) {
  function b<T>(y: T) {
    const n: i32 = y
    print(n + 1)
  }
  run(b, x)
}
a(true)
