// @run
// @log 8
// The annotated twin of `nullable-fn-list-through-generic-param`: the list is bound at
// `(((a: i32) => i32) | null)[]` before it reaches the generic.
function first<T>(xs: (T | null)[]): T | null { return xs[0] }
const g = (a: i32) => a * 2
const xs: (((a: i32) => i32) | null)[] = [g, null]
const f = first(xs)
if f != null { print(f(4)) }
