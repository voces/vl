// @run
// @log a
// @log 2.5
// @log 3
// @log b
// @log 4.5
// @log 7
// @log c
// @log 1.5
// @log 8
// @log d
// @log 1
// @log z
// @log s
// @log s
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// Two nested generics of one name, in different functions: each keeps its own instances
// whatever order the calls mint them in, so a renamed call never reaches the other's (D3830).
function p<T>(x: T) {
  const xs = [x]
  function inner<U>(_u: U) { print(xs[0]) }
  inner(1)
}
function q<T>(x: T) {
  const xs = [x]
  function inner<U>(_u: U) { print(xs[0]) }
  inner(1)
}

// The outer functions interleaved, then each pinned twice before the other.
p("a")
q(2.5)
p(3)
q("b")
p(4.5)
q(7)
p("c")
p(1.5)
q(8)
q("d")

// Neither captures from a generic frame: the second pin of each is what collides.
function r(x: i32) {
  function inner<U>(u: U) { print(u) }
  inner(x)
  inner("z")
}
function s(x: string) {
  function inner<U>(_u: U) { print(x) }
  inner(1)
  inner(2.5)
}
r(1)
s("s")
