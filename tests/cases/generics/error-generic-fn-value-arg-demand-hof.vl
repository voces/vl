// @check
// @error argument 1: expected (string) => i32, got (T) => i32
// A generic function value handed to a generic higher-order function ahead of the argument
// that binds the shared type variable (D2425). The value is checked after that argument, so
// its body's demand (`g(x)` wants i32) meets `string` rather than a hole.
function g(n: i32) { return n + 1 }
function f<T>(x: T) { return g(x) }
function run<T>(cb: (T) => i32, v: T) { return cb(v) }
print(run(f, 3))
print(run(f, "s"))
