// @run
// @log s
// @log 1
// @log 6
// @log 0
// @log 7
// @log 1032
// @hint redundant type annotation: `b` is inferred as `boolean`
// @hint redundant type annotation: `asI32` is inferred as `i32`
// @warning Unused parameter `n` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// WHAT THE DESTINATION SEAM'S PIN MUST NOT COST (silent-class-inventory D572). Re-asking
// where a value lands inside a generic body is only safe if the programs it SHOULD accept
// still run, and every line here is a program a draft of that check could plausibly refuse.
//
//   · `relay`   the plain agreement: the hole flows into a destination annotated with the
//               same hole. Correct at every instance. The pin reaches this call and answers
//               nothing, which is the discrimination the landing rests on — a rung that
//               never ASKED would look identical from outside, so the counter probe reads
//               `ask=1 rej=0` here rather than `ask=0`.
//
//   · `asI32`   THE A7 COERCION, and the reason the pin asks `assignableExpr` and not
//               `assignable`. A boolean-typed VALUE flows into an `i32` slot as 1/0, and
//               that rule lives at the EXPRESSION seam — deliberately absent from the plain
//               predicate. D551's first cut asked `assignable` at the return seam and
//               invented a false reject in exactly this shape; the same mistake is
//               available one node over and this line is what refuses it.
//
//   · `mk`      THE NOMINAL-LITERAL BRAND WAIVER, through a hole-typed destination. `const
//               addr: TVAddr = 0` is accepted at top level because a LITERAL may adopt a
//               brand; that must not change because the destination's annotation happens to
//               be a type parameter. It separates "an i32 VALUE wearing a brand" — which is
//               D571's forge, and which this landing does close at this seam — from "an i32
//               LITERAL declared as one", which is the language's own rule.
//
//   · `keep`    a brand RELAYED rather than forged: the value already has the brand, and
//               the destination is the hole it is bound to.
//
//   · `rowAt`   D561'S EXEMPTION, UNTOUCHED. This landing is a different seam and must not
//               reach the RETURN, so the branded accessor that `declared-return-hole-
//               newtype-brand-keeps.vl` pins still builds here. The laundered spelling of
//               the same function — `const r: A = self.base + i * 4  return r` — is the one
//               this landing DOES close, deliberately: it is the "rewrite" D572's row warns
//               is a relocation of a D561 reject rather than a repair, no corpus module
//               reaches a brand that way, and the capability itself survives on this line.
function relay<T>(self: T, n: i32): T {
  const r: T = self
  return r
}
print(relay("s", 2))

function asI32<T>(self: T): i32 {
  const r: i32 = self
  return r
}
const b: boolean = true
print(asI32(b))
print(asI32(6))

type TVAddr = new i32
function mk<T>(self: T, n: i32): T {
  const r: T = 0
  return r
}
const addr: TVAddr = 5
print(mk(addr, 1) as! i32)

function keep<T>(self: T, n: i32): T {
  const r: T = self
  return r
}
const kept: TVAddr = 7
print(keep(kept, 1) as! i32)

type A1 = new i32
type Rows<A> = { base: i32, brand: A }
function rowAt<A>(self: Rows<A>, i: i32): A { return self.base + i * 4 }
const st: Rows<A1> = { base: 1024, brand: 0 }
print(rowAt(st, 2) as! i32)
