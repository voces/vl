// @run
// @log c
// @log false
// @log c
// @log s
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// A generic's returned function value called as a statement inside a generic caller (D3912).
function c<U>(y: U) { print("c"); print(y) }
function a<T>(x: T): (t: T) => void { c }
function pr<T>(x: T) { a(x)(x) }
pr(false)
pr("s")
