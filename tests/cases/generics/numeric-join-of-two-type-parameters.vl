// @run
// @log 3
// @log true
// @log 1.25
// @log 3
// @log 14
// @log 80000000002
// @log 14
// @log 5
// @log 3
// @log 0.5
// @log true
// @hint redundant type annotation: `x` is inferred as `i32`
// @hint redundant type annotation: `y` is inferred as `i64`
// @hint redundant type annotation: `z` is inferred as `f64`
// @hint redundant type annotation: `v` is inferred as `f64`
// A join of two type parameters pinned at two number types is their union at the instance,
// whether the join is the tail, a set of `return`s or a binding an operator then reads, and
// for un-annotated parameters as for declared ones (D3449, D3345).
function tail<A, B>(c: boolean, a: A, b: B) {
  if c { a } else { b }
}
function rets<A, B>(c: boolean, a: A, b: B) {
  if c { return a }
  return b
}
function bound<A, B>(c: boolean, a: A, b: B) {
  const r = if c { a } else { b }
  return r * 2
}
function hole(c: boolean, a, b) {
  const r = if c { a } else { b }
  return r * 2
}
function narrow<A, B>(c: boolean, a: A, b: B) {
  const r = if c { a } else { b }
  return r * 2
}
const x: i32 = 7
const y: i64 = 40000000001
const z: f64 = 2.5
const t = tail(true, x, y)
print(t / 2)
print(t is i32)
const r = rets(false, x, z)
print(r / 2)
print(rets(true, x, z) / 2)
print(bound(true, x, y))
print(bound(false, x, y))
print(hole(true, x, z))
print(hole(false, x, z))
const w: f32 = 1.5
const v: f64 = 0.25
print(narrow(true, w, v))
print(narrow(false, w, v))
print(tail(false, w, v) is f64)
