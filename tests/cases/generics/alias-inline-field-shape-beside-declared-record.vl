// @run
// @log hi
// @log 7
// @log n
// D4568: a generic alias's inline field shape reads at its pin when a declared record has the
// same field names.
type B<T> = { v: T }
type N = { q: B<string>, r: i32 }
type G<T> = { inner: { q: B<T>, r: i32 }, s: i32 }
function get<T>(g: G<T>): T { return g.inner.q.v }

const ga: G<string> = { inner: { q: { v: "hi" }, r: 2 }, s: 3 }
print(get(ga))
const gi: G<i32> = { inner: { q: { v: 7 }, r: 2 }, s: 3 }
print(get(gi))
const n: N = { q: { v: "n" }, r: 1 }
print(n.q.v)
