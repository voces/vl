// @check
// @error argument of type string flows into `mix` expecting f64 (parameter `u` of `w2`)
// @error argument of type i64 flows into `mix` expecting f64 (parameter `u` of `w2`)
// The `f64` join of a type parameter's binding refuses an instance whose parameter has no join
// with `f64`: a string, and an `i64`, which joins no float (D15041).
function mix<T>(a: T, b: T): T[] { return [a, b] }
function w2<U>(u: U, v: f64) { return mix(u, v)[0] / 4.0 }
const s: string = "a"
const x: i64 = 1
print(w2(s, 0.5))
print(w2(x, 0.5))
