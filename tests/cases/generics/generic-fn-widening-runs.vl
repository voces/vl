// @run
// @log 1.5
// @log 1.5
// @log 2.5
// @log 1.5
// @log 4
// @hint redundant type annotation: `s` is inferred as `f64`
// @hint redundant type annotation: `k` is inferred as `i32`
// D8941, D8942: a generic function widening its `T` argument to `f64` keeps running un-annotated,
// at an `f64` binding and as an `f64` argument; a declared `T` result runs when the body gives
// `T` at the binding, at `T := f64` over `x / 2.0` and at `T := i32` over `x + 1`.
function half(a) { return a / 2.0 }
function halfG<T>(x: T) { return x / 2.0 }
function wrapG<T>(x: T) { return half(x) }
function declG<T>(x: T): T { return x / 2.0 }
function incG<T>(x: T): T { return x + 1 }
function takeF(v: f64) { print(v) }
const u = wrapG(3)
print(u)
const s: f64 = halfG(3)
print(s)
takeF(wrapG(5))
const d = declG(3.0)
print(d)
const k: i32 = incG(3)
print(k)
