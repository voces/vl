// @run
// @log 1
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_r` (leading `_` marks it unused)
// D14161: a record literal in a generic instance, annotated with a nullable function field of
// the type parameter, is built at that instance's closed function type.
function a<T>(_x: T) {
  const _r: { f: ((t: T) => void) | null } = { f: (_t) => {} }
}
a("s")
print(1)
