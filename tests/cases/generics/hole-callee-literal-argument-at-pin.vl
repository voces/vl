// @run
// @log a
// @log 1
// @log n
// @log 3
// @log b
// @log 3
// @log 2
// @log 1
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// D3171: a literal written as a hole callee's argument is held to the pinned parameter as the
// direct call holds it, in the parameter's context: `h("a")` fits `K`, `h(1)` fits `1 | 2`, a
// record literal fits by its literal leaves, `null` among them, and a named function callee alike.
type K = "a" | "b"
type Q = { d: "n" | "m" }
function H(h) { return h("a") }
print(H((x: K) => x))
function N(h) { return h(1) }
print(N((x: 1 | 2) => x))
function R(h) { return h({ d: "n" }) }
print(R((q: Q) => q.d))
function M(h) { return h("a", 2) }
print(M((_x: K, n: 1 | 2) => n + 1))
function kk(x: K): K { return x }
function Z(h) { return h("b") }
print(Z(kk))
type RN = { k: K | null, n: 1 | 2 }
function LN(h) { return h(["a", null, "b"]) }
print(LN((xs: (K | null)[]) => xs.length))
function NL(h) { return h([1, null]) }
print(NL((xs: (1 | 2 | null)[]) => xs.length))
function RR(h) { return h({ k: null, n: 1 }) }
print(RR((r: RN) => r.n))
