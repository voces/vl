// @run
// @log b
// @log b
// @log a
// @log null
// @log true
// @log true
// @log b
// @log b
// @log 2
// A `for`-in loop variable over a list whose element is a hole or `<T>` pinned to a literal union,
// its nullable spelling or `boolean | null`, prints its member, over a local list, the parameter
// itself, or a list literal of the parameter (D2983).
type AB = "a" | "b"
function f(x) {
  const l = [x]
  for e in l { print(e) }
}
const v: AB = "b"
f(v)
function g<T>(x: T[]) {
  for e in x { print(e) }
}
const vs: AB[] = ["b"]
g(vs)
const ns: (AB | null)[] = ["a", null]
g(ns)
function lit<T>(x: T) {
  for e in [x, x] { print(e) }
}
const bn: boolean | null = true
lit(bn)
const abn: AB | null = "b"
lit(abn)
const nn: 1 | 2 = 2
f(nn)
