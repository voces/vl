// @run
// @hint redundant type annotation: `v` is inferred as `A | B | null` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `A | B | null` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `A | B | null` — remove it to lean on inference
// @log true
// @log true
// @log true
// @log true
// @log t
// @log z
// @log 2.5
// @log 9
// An annotated `A | B | null` binding read through `??` at a pin binding both parameters alike
// is read at the pin, where the join is one type, not the box (D3528).
function F<A, B>(k: i32, a: A, b: B) {
  const v: A | B | null = if k == 0 { a } else if k == 1 { b } else { null }
  print((v ?? 9) is i32)
  const w = v ?? 9
  print(w is i32)
}
F(0, 3, 3)
F(2, 3, 3)
function S<A, B>(k: i32, a: A, b: B) {
  const v: A | B | null = if k == 0 { a } else if k == 1 { b } else { null }
  print(v ?? "z")
}
S(1, "s", "t")
S(2, "s", "t")
function L<A, B>(k: i32, a: A, b: B) {
  const g = () => {
    if k == 0 { a }
    else if k == 1 { b }
    else { null }
  }
  const v: A | B | null = g()
  print(v ?? 9)
}
L(1, 3, 2.5)
L(2, 3, 2.5)
