// @run
// @log ok
// @log 4
// @log 1
// @log 9
// @log 1
// @log 7
// A generic whose returns join a list of its parameter with `i32[]` builds the union at a
// record pin too, including a record the literal argument spells by shape (D2782).
type Circle = { r: i32 }
function h<T>(c: boolean, t: T) {
  if c { return [t] }
  [1]
}
h(true, { r: 4 })
print("ok")
const q = h(true, { r: 4 })
if q is Circle[] { print(q[0].r) } else { print(q[0]) }
const p = h(false, { r: 4 })
if p is Circle[] { print(p[0].r) } else { print(p[0]) }
const l = [h(true, { r: 9 }), h(false, { r: 9 })]
const l0 = l[0]
if l0 is Circle[] { print(l0[0].r) } else { print(l0[0]) }
const l1 = l[1]
if l1 is Circle[] { print(l1[0].r) } else { print(l1[0]) }
const cc: Circle = { r: 7 }
const m = h(true, cc)
if m is Circle[] { print(m[0].r) }
