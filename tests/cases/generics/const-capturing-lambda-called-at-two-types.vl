// The callee of the two-parameter spelling (D15598).
function mid<F>(a: F, b: F) {
  print(a("x"))
  print(b(2))
}

// A `const` capturing lambda in place of the nested function is bundled as that is (D15597).
function midOne<F>(a: F) {
  print(a("v"))
  print(a(1))
}
function outerConst<U>(u: U) {
  const same = (k) => {
    print(u)
    k
  }
  midOne(same)
  mid(same, same)
}
outerConst(3)
outerConst(false)
function outerConstClosed(u: i32) {
  const same = (k) => {
    print(u)
    k
  }
  midOne(same)
}
outerConstClosed(2)
