// @run
// @log s
// @log s
// @log 2.5
// @log 2.5
// @log true
// @log true
// @log 5
// @log 5
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// A generic's returned function called for its value inside a generic caller: the result is the
// instance's own type, bound or printed directly (D3912, D3922).
function a<T>(x: T): (t: T) => T {
  (t: T) => t
}
function pr<T>(x: T) {
  const v = a(x)(x)
  print(v)
  print(a(x)(x))
}
pr("s")
pr(2.5)
pr(true)
pr(5 as i64)
