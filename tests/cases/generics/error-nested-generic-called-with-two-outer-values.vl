// @error cannot assign boolean to 'n' of type i32
// A nested generic called with values of two enclosing type parameters: each call's binding is
// checked at the enclosing pin (D3853 review).
function a<T, V>(x: T, z: V) {
  function b<U>(y: U) {
    const n: i32 = y
    print(n + 1)
  }
  b(x)
  b(z)
}
a(1, true)
