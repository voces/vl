import { lastIndexOf } from "std:array"
import { lastIndexOf } from "std:str"

// @run
// @log he
// @log fn
// @log fn
// @log he
// @log he
// @log fn
// @log fn
// @log he
// @log 3
// @log 8
// @log s
// A member call on an un-annotated parameter from inside a closure is picked per instance, in
// either order of instances: a block or expression closure, one nested two deep, one stored in a
// record, one returned, and a map read (D16877).
function slice(self: boolean | string, a: i32, b: i32) {
  if self == true || a > b { return "fn" }
  return "fn"
}
function block(a) {
  const g = () => {
    print(a.slice(0, 2))
  }
  g()
}
function nested(a) {
  const g = () => {
    const h = () => {
      print(a.slice(0, 2))
    }
    h()
  }
  g()
}
function inRecord(a) {
  const r = { run: () => a.slice(0, 2) }
  print(r.run())
}
function mk(a) { return () => a.slice(0, 2) }

function over(a) {
  const g = () => {
    print(a.lastIndexOf(2))
  }
  g()
}
function read(a) {
  const g = () => {
    const h = a.get("a")
    if h != null { print(h) }
  }
  g()
}
block("hello")
block(true)
nested(true)
nested("hello")
inRecord("hello")
inRecord(true)
const f1 = mk(true)
const f2 = mk("hello")
print(f1())
print(f2())
over([1, 2, 3, 2])
const m1 = Map()
m1.set("a", 8)
const m2 = Map()
m2.set("a", "s")
read(m1)
read(m2)
