// A capturing nested hole function of a generic encloser, handed to a parameter that calls it at
// two types, is handed as one closure per type built in each encloser instance (D15596).
function mid<F>(a: F) {
  print(a("x"))
  print(a(2))
}
function outer<U>(u: U) {
  function same(k) {
    print(u)
    k
  }
  mid(same)
}
outer(7)
outer(true)

function midThree(a) {
  print(a("y"))
  print(a(3))
  print(a(false))
}
function outerThree<U>(u: U, w: string) {
  function keep(k) {
    print(u)
    print(w)
    k
  }
  midThree(keep)
  print(keep(5))
}
outerThree(1, "p")
outerThree("s", "q")

function fwd<G>(g: G) { mid(g) }
function outerFwd<U>(u: U) {
  function same(k) {
    print(u)
    k
  }
  fwd(same)
}
outerFwd(8)
outerFwd(false)
