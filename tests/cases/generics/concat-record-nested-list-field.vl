// @run
// @log 1:0 3:2
// @log 2
// D3790 (sunpa SP-048): `slice` re-spells `St` structurally, so `concat`'s instance minted its
// own record row, and that row's `blows` field named `Blow` by shape. The two rows did not
// share a heap type and the module failed to validate inside the instance.
import { concat } from "std:array"
import { toString } from "std:fmt"

type Blow = { tick: i32, dmg: i32 }
type St = { x: f64, key: i32, blows: Blow[] }
let sts: St[] = []
function add(k: i32) { sts.push({ x: 1.0, key: k, blows: [] }) }
function drop(key: i32) {
  for k in 0 until sts.length {
    if sts[k].key != key { continue }
    sts = sts.slice(0, k).concat(sts.slice(k + 1, sts.length))
    return
  }
}
add(1)
add(2)
add(3)
sts[2].blows.push({ tick: 7, dmg: 9 })
sts[2].blows.push({ tick: 8, dmg: 9 })
drop(2)
let out = ""
for t in sts {
  if out != "" { out = out + " " }
  out = out + t.key.toString() + ":" + t.blows.length.toString()
}
print(out)
print(sts.length)
