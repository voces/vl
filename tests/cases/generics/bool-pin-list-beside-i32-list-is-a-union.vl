// @run
// @log I
// @log true
// @log 1
// @log false
// @log 1
// @log 5
// @log false
// @log 0
// @log false
// @log false
// @log B
// @log true
// @log B
// @log true
// D2800: at `T := boolean` a type parameter's list beside `i32[]` stays the union, as it does at
// `T := string`, so the value built by either arm answers for itself. D2820: an element of a
// generic call's list, read inside another generic's instance, prints as its pinned element.
// A local, a `T[]` parameter or a call result reaching the join tags at the instance's pin, and
// `(boolean | null)[]` tags apart from `boolean[]`.
function h<T>(c: boolean, t: T) {
  if c { return [t] }
  [1]
}
const q = h(false, true)
if q is boolean[] { print(q[0]) } else { print("I") }
const r = h(true, true)
if r is boolean[] { print(r[0]) } else { print("I") }
function m<T>(c: boolean, t: T) {
  if c { return [1] }
  [t]
}
const s = m(true, false)
if s is i32[] { print(s[0]) } else { print("B") }
const u = m(false, false)
if u is i32[] { print(u[0]) } else { print(u[0]) }
print(h(false, 5)[0])
print(h(true, 5)[0])
function p<T>(t: T) { return [t, t] }
function k<T>(t: T) {
  print(p(t)[1])
  0
}
k(false)
k(0)
function hb<T>(c: boolean, t: T) {
  const xs = [t]
  if c { return xs }
  [1, 2, 3]
}
const qb = hb(true, false)
if qb is boolean[] { print(qb[0]) } else { print(qb[0]) }
function hp<T>(c: boolean, t: T[]) {
  if c { return t }
  [1, 2, 3]
}
const qp = hp(true, [false, true])
if qp is boolean[] { print(qp[0]) } else { print(qp[0]) }
function mkl<U>(u: U) { return [u, u] }
function hc<T>(c: boolean, t: T) {
  if c { return mkl(t) }
  [7, 8, 9]
}
const qc = hc(true, true)
if qc is boolean[] { print("B"); print(qc[1]) } else { print("I") }
function sn(u: boolean[] | (boolean | null)[]) {
  if u is boolean[] { print("B") } else { print(u[0] == null) }
}
const nn: (boolean | null)[] = [null]
sn([true])
sn(nn)
