// @run
// @log I
// @log 1
// @log I
// @log 2
// @log O
// @log 3
// @log I
// @log 4
// @log O
// @log 4
// @log true
// @log O
// @log 5
// @log s
// @log O
// @log 5
// A binding holding a module generic function, delivered at `(n: i32) => void`: a never-written
// alias pushed into a module list (D3929), and a `let` the program reassigns, read before and
// after the write and inside a generic at two types (D3930). The read keeps the binding's value.
function call(f: (n: i32) => void, n: i32) { f(n) }
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
const gl: ((n: i32) => void)[] = []
const k = inner
gl.push(k)
gl[0](1)
function main() {
  let h = inner
  call(h, 2)
  h = other
  call(h, 3)
  const fs: ((n: i32) => void)[] = []
  let w = inner
  fs.push(w)
  w = other
  fs.push(w)
  fs[0](4)
  fs[1](4)
}
main()
function gen<T>(x: T) {
  print(x)
  let h = inner
  if true { h = other }
  call(h, 5)
}
gen(true)
gen("s")
