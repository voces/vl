// @log true
// @log b=true
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// A nested generic's instance binds only its own type parameter, so a value it reads at the
// enclosing function's `T` takes that type from the enclosing instance: a `boolean` prints as
// `true`, not as its `i32` rep (D3831). Each line reads a capture typed at `T`.
type A = { v: i32 }

// The row's witness: an element of a captured list.
function outer<T>(x: T) {
  const ys = [x, x]
  function inner<U>(_u: U) { print(ys[1]) }
  inner(1)
}
outer(true)

// A captured local and a captured parameter, side by side, and through a closure.
function both<T>(x: T) {
  const y = x
  function inB<U>(_u: U) {
    print(y)
    print(x)
  }
  inB("k")
}
both(true)
function viaClosure<T>(x: T) {
  const ys = [x, x]
  function inC<U>(_u: U) {
    const g = () => print(ys[0])
    g()
  }
  inC(1)
}
viaClosure(true)

// `f64`, `string` and record captures, then two instances of one enclosing function.
function elem<T>(x: T): T {
  const ys = [x, x]
  function inE<U>(_u: U) { ys[1] }
  inE(1)
}
print(elem(2.5))
print(elem("s"))
const a: A = { v: 4 }
print(elem(a).v)
function twice<T>(x: T) {
  const ys = [x]
  function inT<U>(_u: U) { print(ys[0]) }
  inT(1)
}
twice(true)
twice(2.5)

// An un-annotated enclosing function, and the capture interpolated.
function hole(x) {
  const ys = [x, x]
  const y = x
  function inH<U>(_u: U) {
    print(ys[1])
    print(y)
    print("b=\{ys[0]}")
  }
  inH(1)
}
hole(true)
