// @run
// A parameter typed a union of type parameters alone, met by one union argument, binds them by
// position; a parameter some other argument binds keeps that binding and the union's other
// parameter takes what is left (D3643).
function F<A, B>(v: A | B | null) { print(v ?? 9) }
const n: boolean | string | null = null
F(n)
const t: boolean | string | null = true
F(t)
const s: boolean | string | null = "s"
F(s)
function D<A, B>(d: i32, v: A | B | null) { print(v ?? d) }
const m: f64 | string | null = null
D(7, m)
function P<A, B>(v: A | B, a: A) {
  print(a)
  print(v)
}
const x: string | i32 = 5
P(x, 7)
function Q<A, B>(v: A | B, b: B) {
  print(v)
  print(b)
}
const y: f64 | i32 = 2.5
Q(y, 4)
function S<A, B>(k: i32, w: A | B | null) {
  const v = if k >= 0 { w } else { w }
  print(v)
}
const z: f64 | i32 | null = null
S(0, z)
// @log 9
// @log true
// @log s
// @log 7
// @log 7
// @log 5
// @log 2.5
// @log 4
// @log null
