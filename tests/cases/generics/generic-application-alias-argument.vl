// @run
// @log z
// @log 4
// @log 5
// @log 1.5
// @log 2.5
// @log true
// @log 1
// @log 1
// @log 7
// @log q
// @hint redundant type annotation: `a` is inferred as `{v: string}`
// @hint redundant type annotation: `b` is inferred as `{v: i32}`
// @hint redundant type annotation: `d` is inferred as `{v: f64}`
// @hint redundant type annotation: `f` is inferred as `{v: boolean}`
// @hint redundant type annotation: `h` is inferred as `{v: i32}`
// @hint redundant type annotation: `i` is inferred as `{v: i32[]}`
// @hint redundant type annotation: `j` is inferred as `{v: string}`
// A generic application whose ARGUMENT is a transparent alias (`Box<Nm>` where
// `type Nm = string`). `canonEmitNameAt` had no generic-APPLICATION arm at all, so the
// argument position was the ONE place in an annotation the emitter's vocabulary never
// reached: the name arrived at `gaeEnsure` still spelling `Nm`, `gaeApplyFieldTy`
// substituted that TEXT verbatim, and the field was recorded as `Nm` — a name `collectU`
// had registered as a one-member `UnionDecl`, so the field interned as a union BOX while
// every read lowered as the string it is. `vl check` rc=0 (the checker resolves `Nm`
// through its own registry and reports `{v: string}`) and invalid wasm, "expected i32,
// found (ref $type)".
//
// Swept over 9 alias-body kinds against the SAME program with the argument written
// CONCRETELY: 8 of 9 invalid wasm, all 9 controls CORRECT. The one green row is a DECLARED
// struct body — a name canon does not rewrite, and one the emitter resolves on its own.
// That control is the whole reason this is filed as a defect rather than as a symmetric
// pre-existing gap: an earlier reading recorded the control as ALSO invalid wasm.
//
// The reps under the applications are spread across i32 / i64 / f64 / f32 / boolean /
// string / a list / a numeric literal union so a rep-blind rewrite cannot pass, and the
// alias-of-an-alias row pins the recursion (the argument's canon is the full one, not one
// level).
type Nm = string

type N32 = i32

type N64 = i64

type F64 = f64

type F32 = f32

type Bl = boolean

type Zs = 0 | 1

type Jz = N32

type Ary = i32[]

type Box<T> = { v: T }

const a: Box<Nm> = { v: "z" }
print(a.v)

const b: Box<N32> = { v: 4 }
print(b.v)

const c: Box<N64> = { v: 5 }
print(c.v)

const d: Box<F64> = { v: 1.5 }
print(d.v)

const e: Box<F32> = { v: 2.5 }
print(e.v)

const f: Box<Bl> = { v: true }
print(f.v)

const g: Box<Zs> = { v: 1 }
print(g.v)

// The alias-of-an-alias: the argument's canon must run to the LEAF, not one level.
const h: Box<Jz> = { v: 1 }
print(h.v)

const i: Box<Ary> = { v: [7, 8] }
print(i.v[0])

// The CONTROL the sweep is read against: the same application with the argument written
// concretely. It was correct on master and must stay correct.
const j: Box<string> = { v: "q" }
print(j.v)
