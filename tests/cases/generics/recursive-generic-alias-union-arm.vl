// @run
// @log sum 6
// @log none
// A recursive generic instance as one arm of a union: the union box names the instance by
// its application, and the narrowed arm walks the list.
import { toString } from "std:fmt"

type L<T> = { v: T, next: L<T> | null }

function total(x: L<i32> | string): string {
  if x is string { return x }
  let s = 0
  let c: L<i32> | null = x
  while c != null {
    s = s + c.v
    c = c.next
  }
  return "sum " + s.toString()
}

print(total({ v: 1, next: { v: 2, next: { v: 3, next: null } } }))
print(total("none"))
