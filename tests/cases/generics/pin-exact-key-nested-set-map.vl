// @hint redundant type annotation: `f` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `d` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `e` is inferred as `boolean` — remove it to lean on inference
// A map whose value is a Set, in a union box, answers `is` against its own type (D2752), and a
// generic pinned at a map nested past a dozen levels keeps its exact pin (D2751).
const s: {[string]: Set<i32>} = Map()
const w: {[string]: Set<i32>} | string = s
print(w is {[string]: Set<i32>})
print(w is string)
const t: {[i32]: Set<string>} = Map()
const v: {[i32]: Set<string>} | i32 = t
print(v is {[i32]: Set<string>})
function f<T>(u: T | string): boolean { u is {[string]: Set<i32>} }
const m: {[string]: {[i32]: boolean}} = Map()
print(f<{[string]: Set<i32>}>(s))
print(f<{[string]: {[i32]: boolean}}>(m))
print(f<{[string]: Set<i32>}>("x"))
function d<T>(u: T | string): boolean {
  u is {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: Set<i32>}}}}}}}}}}}}}}
}
const ds: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: Set<i32>}}}}}}}}}}}}}} = Map()
const dm: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[i32]: boolean}}}}}}}}}}}}}}} = Map()
print(
  d<{[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: Set<i32>}}}}}}}}}}}}}}>(
    ds,
  ),
)
print(
  d<{[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[i32]: boolean}}}}}}}}}}}}}}}>(
    dm,
  ),
)
function e<T>(u: T | string): boolean { u is string }
const es: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: Set<i32>}}}}}}}}}}}}}}}}}} = Map()
print(
  e<{[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: Set<i32>}}}}}}}}}}}}}}}}}}>(
    es,
  ),
)
print(
  e<{[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: {[string]: Set<i32>}}}}}}}}}}}}}}}}}}>(
    "y",
  ),
)
