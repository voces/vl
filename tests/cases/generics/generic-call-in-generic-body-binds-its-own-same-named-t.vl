// @run
// @log 4
// @log 3
// @log 3
// @log 3
// @log 1
// @log 2
// @hint Intentionally-unused parameter
// D15033: a generic called with its argument at the enclosing generic's same-named `T` binds its
// own `T` afresh at each instance: a list, a string list, a record, a nested list, and D3822's
// spelling of the plain call.
function each<T>(self: T[], f: (T) => void) {
  for x in self { f(x) }
}
function cnt3<T>(x: T) {
  let n = 0
  each(x, (_v) => {
    n = n + 1
  })
  n
}
print(cnt3([1, 2, 3, 4]))
function cnt<T>(self: T[]) {
  let c = 0
  for _x in self { c = c + 1 }
  c
}
function outer<T>(x: T) { cnt(x) }
print(outer([1, 2, 3]))
print(outer(["a", "b", "c"]))
function field<T>(self: { f: T }) {
  print(self.f)
  1
}
function viaRec<T>(x: T) { field(x) }
print(viaRec({ f: 3 }))
function rows<T>(self: T[][]) { self.length }
function viaRows<T>(x: T) { rows(x) }
print(viaRows([[1], [2]]))
