// @run
// @log other
// @log not int
// @log v-other
// @log int
// @log v-int
// @log other
// @log int
// @log other
// @log 6
// @log other
// @log int
// @hint redundant type annotation: `r` is inferred as `T | i32`
// @hint redundant type annotation: `r` is inferred as `T | i32`
// @hint redundant type annotation: `r` is inferred as `T | i32`
// D2975: `is i32` over `T | i32` with `T` pinned to a function type, as a statement test, a
// negated test and a value `if`, at a no-argument and a typed-parameter function, a read
// narrowed by the test, and the un-annotated spelling, which ran before the fix.
function h<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is i32 { print("int") } else { print("other") }
  if !(r is i32) { print("not int") }
  print(if r is i32 { "v-int" } else { "v-other" })
}
h(() => 1, true)
h(() => 1, false)
function k<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is i32 { print("int") } else { print("other") }
}
k((n: i32) => n, true)
k((n: i32) => n, false)
function g<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is i32 { print(r + 1) } else { print("other") }
}
g(() => 1, true)
g(() => 1, false)
function u<T>(a: T, c: boolean) {
  const r = if c { a } else { 5 }
  if r is i32 { print("int") } else { print("other") }
}
u(() => 1, true)
u(() => 1, false)
