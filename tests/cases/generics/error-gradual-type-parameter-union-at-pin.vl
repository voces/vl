// @error operator '+' is not defined for string | i32 and i32
// @error field 'length' is not on every member of string | i32
// @error an interpolation hole is `string` or i32 | i64 | boolean | f64 — this one is string | i32
// @error no method '.push' on string | i32[]
// @error return type mismatch: expected string, got string | i32
// A type parameter inside a union is gradual: an operation the body applies to `T | i32` is
// refused at the call whose pin makes the whole union one it is not defined for, in the words
// its direct spelling is refused in (D2906, D3079, D3103).
function g<T>(a: T, c: boolean) {
  const r = if c { a } else { 5 }
  print(r + 1)
  return r
}
const n = g(3, false)
print(n)
const s = g("x", false)
function h<T>(a: T, b: T, c: boolean) {
  const r = if c { a } else { 5 }
  r
}
print(h("x", "y", false).length)
function t<T>(a: T, c: boolean) {
  const r = if c { a } else { 5 }
  print("v=\{r}")
}
t("s", true)
function p<T>(a: T, c: boolean) {
  const r = if c { a } else { [5] }
  r.push(9)
}
p("s", true)
function f2<T>(x: T, c: boolean): T { return if c { x } else { 7 } }
print(f2(3, false))
print(f2("s", false))
