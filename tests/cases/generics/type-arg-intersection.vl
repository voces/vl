// @run
// @log 1
// @log 2
// The `&` sibling of `type-arg-union.vl`: a generic alias applied to an
// INTERSECTION argument (`Box<A & B>`). `nameHasSep(name, '&')` and `splitTopAmp`
// carry the same `<>`-blind depth tracker as the `|` split, so the intersection
// arm claimed the whole name and `Box<A` failed to resolve.
type A = { x: i32 }
type B = { y: i32 }
type Box<T> = { v: T }

const b: Box<A & B> = { v: { x: 1, y: 2 } }
print(b.v.x)
print(b.v.y)
