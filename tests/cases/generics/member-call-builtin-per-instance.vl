// @run
// @log 1
// @log 99
// @log he
// @log fn
// @log 2
// @log -9
// @log 6
// @log 0
// @log 7
// @log true
// @log 2
// @log 2
// @log 42
// @log 99
// @log 1
// @log 99
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `a` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `b` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `s` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `k` (prefix with `_` to suppress, or remove it)
// A generic body's `x.name(…)` resolves per instance, on the instance's own receiver type:
// the built-in method, then a field, then the `self`-function in scope (D2517). Before, the
// monomorphizer's re-pick asked only field-then-function, so `pushOne(xs)` printed 99 and left
// the list empty, and a string instance of `slice` called the function instead of the built-in.
function push(self: i32[] | boolean, x: i32) { print(99 + x - x) }
function slice(self: string | boolean, a: i32, b: i32) { "fn" }
function indexOf(self: string | boolean, s: string) { -9 }
function pop(self: i32[] | boolean): i32 | null { null }
function clear(self: i32[] | boolean) { print(0) }
function get(self: {[string]: i32} | boolean, k: string): i32 | null { null }
function has(self: {[string]: i32} | boolean, k: string) { false }
function add(self: Set<string> | boolean, k: string) { print(99) }
type P = { run: (i32) => i32, tag: i32 }
function run(self: P | boolean, k: i32) { 99 }

function pushOne<T>(x: T) { x.push(1) }
function sl<T>(x: T) { x.slice(0, 2) }
function ix(x) { x.indexOf("l") }
function popped<T>(x: T) { x.pop() ?? -1 }
function cleared(x) { x.clear() }
function got<T>(x: T) { x.get("a") ?? -1 }
function hasA(x) { x.has("a") }
function added<T>(x: T) { x.add("q") }
function ran<T>(x: T) { x.run(2) }
function relay<U>(y: U) { pushOne(y) }

const xs: i32[] = []
pushOne(xs)
print(xs.length)
pushOne(true)
print(sl("hello"))
print(sl(false))
print(ix("hello"))
print(ix(true))
print(popped([5, 6]))
const ys = [5, 6]
cleared(ys)
print(ys.length)
const m: {[string]: i32} = Map()
m["a"] = 7
print(got(m))
print(hasA(m))
const s = Set<string>()
s.add("p")
added(s)
print(s.length)
const zs = [3]
relay(zs)
print(zs.length)
print(ran({ run: (k: i32) => k + 40, tag: 3 }))
print(ran(true))
const ws: i32[] = []
relay(ws)
print(ws.length)
relay(false)
