// @run
// @log <b>
// @log <x>
// @log <7>
// An interpolated element of a `<T>` list pinned to a literal union renders its member, beside
// another instance of the same generic (D2984).
type AB = "a" | "b"
function f<T>(x: T[]) { print("<\{x[0]}>") }
const v: AB[] = ["b"]
f(v)
const w: ("x" | "y")[] = ["x"]
f(w)
const n = [7]
f(n)
