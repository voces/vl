// @run
// @log x
// @log x!
// @log 1
// @log x
// @log q
// @log 3
// @log 2.5
// @log 2
// @log p
// @log 4
// @log y
// D4420: a generic function handed to an un-annotated parameter is instanced at the arguments
// the body calls that parameter with: through an alias, a returned call, a second argument and
// a parameter typed by a bare type parameter.
function same<T>(k: T): T { k }
function wrap<T>(k: T): T[] { [k, k] }
function pair<A, B>(_a: A, _b: B): string { "p" }
function take(a) { print(a("x")) }
take(same)
function viaAlias(a) {
  const v = a
  print(v("x") + "!")
}
viaAlias(same)
function num(a) { print(a(1)) }
num(same)
function ret(a) { a("x") }
print(ret(same))
function apply(a, b) { print(a(b)) }
apply(same, "q")
apply(same, 3)
apply(same, 2.5)
print(ret(wrap).length)
function two(a) { print(a(1, "s")) }
two(pair)
type P = {x: i32}
function field(a) {
  const p: P = { x: 4 }
  print(a(p).x)
}
field(same)
function declared<F>(a: F) { print(a("y")) }
declared(same)
