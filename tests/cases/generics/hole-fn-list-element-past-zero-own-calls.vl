// @run
// @log 4
// @log xy
// @log 3
// @log 4
// @log false
// @log 3.75
// @log 14
// @log 15
// @log abab
// @log 8
// An un-annotated lambda handed through a list of hole functions past index 0 is pinned at the
// calls the named element's own body makes, though element 0's differ (D10795), and where those
// calls pass the element's own generic parameter, at the call's binding of it (D10796).
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(1.5, 2.5)) }
function applyS(g) { print(g("x", "y")) }
function apply4(g) { print(g(true, false)) }
const gs = [apply2, apply3, applyS, apply4]
gs[1]((a, b) => a + b)
gs[2]((a, b) => a + b)
gs[0]((a, b) => a + b)
function main() {
  const hs = [apply2, apply3, apply4]
  hs[1]((a, b) => a + b)
  hs[2]((a, b) => a == b)
  hs[1]((a, b) => a * b)
}
main()
function gen2<T>(g, x: T) { print(g(x, x)) }
function gen3<T>(g, x: T) { print(g(x, x)) }
function gen4<T>(g, x: T) { print(g(x, 1)) }
const ks = [gen2, gen3, gen4]
ks[1]((a, b) => a + b, 7)
ks[1]((a, b) => a + b, 7.5)
ks[1]((a, b) => a + b, "ab")
ks[2]((a, b) => a + b, 7)
