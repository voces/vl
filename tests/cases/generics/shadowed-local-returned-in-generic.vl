function g<T>(w: T) {
  let x = 7
  if true {
    let x = w
    return x
  }
  w
}
const r1 = g({ a: 1, b: "r" })
print(r1.b)

function h<T>(w: T) {
  let x = "s"
  if true {
    let x = w
    return x
  }
  w
}
