// @emit-error monomorphize: unsupported argument type for `b` in a call to `len`
// THE SAME HOLE ONE SPELLING ALONG — and the two produce BYTE-IDENTICAL substituted field
// text, which is what makes the omission indefensible rather than merely incomplete.
//
//   type Box<X> = { v: X[] }   at  X := T     ->  field `v: T[]`   (the sibling fixture)
//   type Box<X> = { v: X }     at  X := T[]   ->  field `v: T[]`   (this one)
//
// The guard first asked `fnTyParamName` of the RAW argument, so `T[]` did not match any
// declared parameter name and the application was never skipped: `vl check --codegen` rc 0,
// `vl run` "expected (ref null $type), found i32".
//
// It now peels to the leaf exactly as `genTyParamArr` does, whose header states the rule
// for its own half — "`T[][]` is as much a type-parameter array as `T[]` is". Both halves
// peel or neither is right.
//
// Found by a review agent asked whether the guard's borrowed accept set was COMPLETE.
type Box<X> = { v: X }

function len<T>(b: Box<T[]>): i32 {
  b.v.length
}

print(len({ v: [1, 2, 3] }))
