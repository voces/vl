// @log 2
// @log false
// @log 1
// @log z
// @log 0.25
// @log y
// A record of a `T[]` parameter built in a body that returns `T[]`, `T[][]` or a hole's list
// gets its row at each instance: the return holds no record the body could have built (D4901).
function h<T>(v: T[]): T[] {
  const r = { xs: v }
  print(r.xs[0])
  return v
}

function k<T>(v: T[]) {
  const r = { xs: v, n: v.length }
  print(r.n)
  return r.xs
}

function m(v) {
  const r = { xs: v }
  print(r.xs.length)
  return v
}

function q<T>(v: T[]): T[][] {
  const r = { xs: v }
  return [r.xs, v]
}

print(h(["e"])[0])
print(h([2.5])[0] / 2.0)
print(k([1.5, 2.5])[1] / 2.0)
print(k(["a", "b"])[1])
print(m([true, false])[1])
print(m(["z"])[0])
print(q([0.5])[1][0] / 2.0)
print(q(["y"])[0][0])
