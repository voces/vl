// @run
// @log 5
// @log 5
// @log 9
// @log false
// @log 1
// A write to a type parameter's field in an `is` test's else arm re-narrows it to the written
// member in the instance, in a loop and across two writes, as the direct spelling does (D3439).
type A = { v: i32 }
type B = { s: string }
function inLoop<Z>(z: Z) {
  let i = 0
  while i < 2 {
    if z.h is A {
      print(z.h.v)
    } else {
      z.h = { v: 5 + i }
      print(z.h.v)
    }
    i = i + 1
  }
}
function twoWrites<Z>(z: Z) {
  if z.h is A {
    print(z.h.v)
  } else {
    z.h = { v: 9 }
    print(z.h.v)
    z.h = { s: "w" }
    print(z.h is A)
  }
}
const x: { h: A | B } = { h: { s: "bee" } }
inLoop(x)
const y: { h: A | B } = { h: { s: "bee" } }
twoWrites(y)
const w: { h: A | B } = { h: { v: 1 } }
twoWrites(w)
