// @run
// An inline record holding a generic application crosses a user generic's boundary, as a
// callback's element and as a parameter pinned at two instances (D3936, D3937).
type A = { x: i32 }
type Box<T> = { v: T }
function ap<T, U>(xs: T[], f: (t: T) => U): U[] {
  const r: U[] = []
  for x in xs { r.push(f(x)) }
  r
}
function rd<T>(e: { v: Box<T> }): T { e.v.v }
const o: { v: Box<A> } = { v: { v: { x: 2 } } }
print(ap([o], (e) => e.v.v.x)[0])
print(rd(o).x)
const p: { v: Box<i32> } = { v: { v: 3 } }
print(rd(p))
// @log 2
// @log 2
// @log 3
