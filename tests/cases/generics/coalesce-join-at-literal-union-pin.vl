// @run
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a
// @log b
// A generic's `a ?? d` joined with `b`, pinned at a literal union, read back through a
// return, a binding, a bound result and a print (D3281). At `K` the join of `a ?? 5` is the
// box `K | i32`, so its binding is the box and not the atom its arms are alone.
type K = "a" | "b"
function ret<T>(a: T, b: T, c: boolean) {
  if c { a ?? 5 } else { b }
}
function bind<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  print(r)
}
function retbind<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  r
}
const u: K = "a"
const w: K = "b"
print(ret(u, w, true))
print(ret(u, w, false))
bind(u, w, true)
bind(u, w, false)
const v0 = retbind(u, w, true)
print(v0)
const v1 = retbind(u, w, false)
print(v1)
function show<T>(a: T, b: T, c: boolean) { print(if c { a ?? 5 } else { b }) }
show(u, w, true)
show(u, w, false)
