// @run
// @hint Intentionally-unused parameter
// @hint Intentionally-unused parameter
// @hint Intentionally-unused parameter
// @log 1
// @log 2
// @log 4
// @log 1
// @log 5
// @log 2
// @log a
// D17033: a generic union alias whose instance is first applied while emit monomorphizes is
// filled in its application's own scope, so no emit memo is stale: the arm free of `T` returned,
// annotated, passed as an argument, at two instancings, and a record arm holding `T`. A cyclic
// instance is the control.
type U<T> = { k: "g", n: i32 } | { k: "h", v: T }
type W<T> = { n: i32, v: T } | { s: string }
type Tr<T> = { leaf: T } | { kids: Tr<T>[] }
function mk<T>(_x: T): U<T> { return { k: "g", n: 9 } }
function ann<T>(_x: T): U<T> {
  const u: U<T> = { k: "g", n: 4 }
  return u
}
function take<T>(u: U<T>) {
  if u.k == "g" { return 1 }
  return 2
}
function pass<T>(_x: T) { return take<T>({ k: "g", n: 2 }) }
function wmk<T>(v: T) {
  const u: W<T> = { n: 5, v: v }
  return u
}
function lf<T>(x: T): Tr<T> { return { leaf: x } }
function two<T>(x: T): Tr<T> { return { kids: [lf(x), lf(x)] } }
const a = mk(3)
if a.k == "g" { print(1) }
const b = mk("s")
if b.k == "g" { print(2) }
const c = ann(1.5)
if c.k == "g" { print(c.n) }
print(pass(true))
const w = wmk("a")
if w is { n: i32, v: string } { print(w.n) }
const t = two(3)
if t is { kids: Tr<i32>[] } { print(t.kids.length) }
const l = lf("a")
if l is { leaf: string } { print(l.leaf) }
