// @run
// @log z
// @log null
// @log a
// @log null
// @log b
// @log z
// @log 7
// @log b
// A value at a pin whose one union is itself nullable, a whole alias `"x" | "y" | "z" | null` or
// the inline `"a" | "b" | null`, prints its member or `null` at a hole or explicit instance, and
// beside a second instance of another pin (D2998).
type XYN = "x" | "y" | "z" | null
function f<T>(x: T) { print(x) }
function go() {
  const v2: XYN = "z"
  f(v2)
  const v3: XYN = null
  f(v3)
}
go()
function h(x) {
  const l = [x]
  print(l[0])
}
const a: "a" | "b" | null = "a"
h(a)
const an: "a" | "b" | null = null
h(an)
function k<T>(x: T) {
  const y = x
  print(y)
}
const b: "a" | "b" | null = "b"
k(b)
const z: XYN = "z"
k(z)
const n = 7
k(n)
function cap<T>(x: T) {
  const c = () => x
  print(c())
}
cap(b)
