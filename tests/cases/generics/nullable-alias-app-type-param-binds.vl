// @run
// @log 1
// @log 1
// @log 1
// @log 1.5
// @log a
// @log 7
// @log none
// A type parameter named only under a nullable alias application binds from the argument's
// record, which the spelling match misses, through the checker's binding at the call; the
// unbound-parameter default never answers it.
type CN<X> = { v: X }
function f<T>(_v: CN<T> | null): i32 { 1 }
function show<T>(v: CN<T> | null) {
  if v == null {
    print("none")
    return
  }
  print(v.v)
}
print(f({ v: 1.5 }))
print(f({ v: "a" }))
print(f({ v: 1 }))
show({ v: 1.5 })
show({ v: "a" })
show({ v: 7 })
show(null)
