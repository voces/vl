// @run
// @log 3
// @log ab
// @log 3
// @log ab
// @log 3
// @log ab
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)

// An un-annotated binding of a fresh list, spread into a push in a generic body, hands its elements
// to the receiver's, so each instance builds the generic function it holds at its own T (D16695).
function id<T>(x: T): T { return x }
function run<T>(_x: T) {
  const rs: ((x: T) => T)[] = []
  const src = [id]
  rs.push(...src)
  return rs
}
function runR<T>(_x: T) {
  const rs: {f: (x: T) => T}[] = []
  const src = [{ f: id }]
  rs.push(...src)
  return rs
}
function runC<T>(x: T): T {
  const rs: ((x: T) => T)[] = []
  const src = [id]
  rs.push(...src)
  return rs[0](x)
}
print(run(3)[0](3))
print(run("ab")[0]("ab"))
print(runR(3)[0].f(3))
print(runR("ab")[0].f("ab"))
print(runC(3))
print(runC("ab"))
