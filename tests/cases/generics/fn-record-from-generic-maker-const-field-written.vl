// @run
// @log 2
// @log 2.5
// @log two
// @log 3
// @log 3
// @log 3.5
// A generic maker returning a `const` that holds its record literal, the caller writing the
// record's function field and calling it at two types, widens the field as a returned literal
// does; a write the maker makes to the `const` first is kept (D15745).
function id0(a) { return a }
function id1(a) { return a }
function mk<T>(x: T) {
  const o = { f: id1, x: x }
  return o
}
const r = mk(1)
r.f = id0
print(r.f(2))
print(r.f(2.5))

function k0(a) { return a }
function k1(a) { return a }
function k2(a) {
  print("two")
  return a
}
function nk<T>(x: T) {
  const o = { g: k1, x: x }
  o.g = k2
  return o
}
const q = nk("s")
print(q.g(3))
q.g = k0
print(q.g(3))
print(q.g(3.5))
