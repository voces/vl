// @run
// @log 2
// @log 2
// @log 2
// @log ab
// @log 4
// @log cd
// @log 3
// @log 3
// @log 2
// @log ab
// @log 7
// @log 7
// @log 2
// @log ab
// @log mk3
// @log 5
// @log ef
// @info `h` is never reassigned; use `const` instead of `let`
// A generic function handed to a generic's function parameter runs when it comes back from an
// un-annotated function, out of a nested list read, out of an un-annotated `Map()`, or through a
// re-pointed `let` written into list literals, at one type and at two (D10310, D10311, D10312),
// and a call returning one as its trailing expression is listed and called at two (D9723).
function id<T>(x: T): T { x }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function runAll<U>(a: ((x: U) => U)[], u: U): U { a[0](u) }

function mk() { id }
const v = mk()
print(run(v, 2))

const xs = [id]
const ys = [xs]
print(run(ys[0][0], 2))

const m = Map()
m["k"] = id
const mv = m["k"]
if mv != null {
  print(run(mv, 2))
  print(run(mv, "ab"))
}
const ml = Map()
ml["k"] = [id]
const mlv = ml["k"]
if mlv != null {
  print(run(mlv[0], 4))
  print(run(mlv[0], "cd"))
}

function mk2() { id }
const w = mk2()
print(run(w, 3))
print(run(w, "abc").length)

let g = mk()
g = mk()
print(run(g, 2))
print(run(g, "ab"))

let h = mk2()
const hc = h
print(run(hc, 7))

let p = id
p = id
print(runAll([p], 7))
print(runAll([p], 2))
print(runAll([p], "ab"))

function mk3() {
  print("mk3")
  id
}
const zs = [mk3()]
print(zs[0](5))
print(zs[0]("ef"))
