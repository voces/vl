// @run
// @log 1
// @log s
// @log 2.5
// @log 7
// @log t
// Two generics that both name their variable `T`, each pinned at a different type, and a third
// whose own `T` is pinned twice. A pin table keyed on the bare name has all three sharing one
// row, so the second function's pin poisons the first's; keyed on the declaring function they
// are three rows and only the third — a real conflict, since one body serves both calls —
// poisons. Nothing here changes what is emitted; the fixture pins that every spelling runs.

function idA<T>(x: T): T { x }

function idB<T>(y: T): T { y }

function idC<T>(z: T): T { z }

function main() {
  print(idA(1))
  print(idB("s"))
  print(idA(2.5))
  print(idC(7))
  print(idC("t"))
}

main()
