// @run
// @log 1
// @log 2
// @log 5
// @log true
// @log s
// @log true
// @log none
// @log 2.5
// A hole body that null-tests a function field reads a record whose field is a plain function
// at its own signature, beside one whose field is nullable, and the test is simply true (D3182).
function F(z) {
  print(z.v)
  const g = z.f
  if g != null { print(g()) }
}
const a: { v: i32, f: (() => i32) | null } = { v: 1, f: () => 2 }
F(a)
F({ v: 5, f: () => true })
F({ v: "s", f: () => true })
function H(z) {
  const g = z.f
  if g == null { print("none") } else { print(g()) }
}
const n: { f: (() => f64) | null } = { f: null }
H(n)
H({ f: () => 2.5 })
