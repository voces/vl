// @run
// @log 5
// @log null
// @log 4
// @log null
// @log 6
// @log null
// @log c4
// @log null
// @log h4
// @log null
// @log 4
// @log null
// @log 4
// @log null
// @log 4
// @log null
// @log 4
// @log null
// @log 4
// @log null
// @log 5
// @log s
// @log 4
// @log s
// @log 4
// @log s
// @log 4
// @log s
// Q58 position sweep: a bare `as` at a pin it can never hit returns from its function, over a
// type parameter pinned at no number (`holeMiss`, the function's null) and over `T | null` pinned
// with no member (`instMiss`, the operand as the remainder); the pin it hits converts.
import { toString } from "std:fmt"
type R = { v: i32 }
function sc(x: i32) { return x + 1 }
function un(x: i32 | string) { return if x is string { 0 } else { x } }
function none(): i32 | null { return null }
function hArg<T>(u: T): i32 | null { return sc(u as i32) }
function hUnion<T>(u: T): i32 | null { return un(u as i32) }
function hNested<T>(u: T): i32 | null { return sc(sc(u as i32)) }
function hConcat<T>(u: T): string | null { return "c" + toString(u as i32) }
function hHole<T>(u: T): string | null { return "h\{u as i32}" }
function hRet<T>(u: T): i32 | null { return u as i32 }
function hLet<T>(u: T): i32 | null {
  const v = u as i32
  return v
}
function hIf<T>(u: T, c: boolean): i32 | null { return if c { u as i32 } else { 0 } }
function hCoal<T>(u: T): i32 | null { return none() ?? (u as i32) }
function hField<T>(u: T): i32 | null {
  const r: R = { v: u as i32 }
  return r.v
}
function iArg<T>(u: T | null): i32 | string | null { return sc(u as i32) }
function iLet<T>(u: T | null): i32 | string | null {
  const v = u as i32
  return v
}
function iIf<T>(u: T | null, c: boolean): i32 | string | null {
  return if c { u as i32 } else { 0 }
}
function iField<T>(u: T | null): i32 | string | null {
  const r: R = { v: u as i32 }
  return r.v
}
print(hArg(4))
print(hArg("s"))
print(hUnion(4))
print(hUnion("s"))
print(hNested(4))
print(hNested("s"))
print(hConcat(4))
print(hConcat("s"))
print(hHole(4))
print(hHole("s"))
print(hRet(4))
print(hRet("s"))
print(hLet(4))
print(hLet("s"))
print(hIf(4, true))
print(hIf("s", true))
print(hCoal(4))
print(hCoal("s"))
print(hField(4))
print(hField("s"))
print(iArg<i32>(4))
print(iArg<string>("s"))
print(iLet<i32>(4))
print(iLet<string>("s"))
print(iIf<i32>(4, true))
print(iIf<string>("s", true))
print(iField<i32>(4))
print(iField<string>("s"))
