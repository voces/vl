// @emit-error a list literal around a generic call whose `??` default is a list of another element at this type argument has no lowering yet
// D2849's list literal is refused where the call it wraps reaches D2816's `??`: at `T := boolean`
// the `[1]` default is built as a boolean list and would print `true`.
function p<T>(t: T, c: boolean) {
  let a: T[] | null = null
  if c { a = [t] }
  pc(a)
}
function pc<T>(xs: T[] | null) { xs ?? [1] }
function k<T>(t: T, c: boolean) {
  const xs = [p(t, c)]
  print(xs[0][0])
  0
}
k(true, false)
