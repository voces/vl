// @run
// @log 1
// @log 0
// @log 1
// @log 0
// @log 3
// @log 3
// @log 0
// @log 3
// @log 3
// @log 3
// @log 1
// @log 1
// A `.push` through an `is K[]` arm whose receiver is an empty list of other elements pushes onto
// the arm's `K[]`, which the receiver then reads wherever the test fits; the caller's own list is
// not the place pushed onto (D4934, D4771).
function g<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  v.length
}
const e: i32[] = []
print(g(e))
print(e.length)
function h<V>(v: V[], x: V) {
  if v is f64[] { v.push(x) }
  print(v.length)
}
const e2: i32[] = []
h(e2, 3)
print(e2.length)
function k<V>(v: V[]) {
  let n = 0
  while n < 3 {
    if v is f64[] { v.push(0.5) }
    n = n + 1
  }
  if v is f64[] { print(v.length) }
  print(v.length)
}
const e3: i32[] = []
k(e3)
print(e3.length)
const f3: f64[] = []
k(f3)
print(f3.length)
function s<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  print(q.length)
  print(a.length)
}
s([1])
