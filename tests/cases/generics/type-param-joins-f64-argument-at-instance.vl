// @run
// @log 0.25
// @log 0.5
// @log 1.5
// A type parameter bound by one argument at the encloser's own type parameter and by another at
// `f64` joins at `f64` in each instance whose parameter joins it (D15041), as an un-annotated
// parameter's does; the callback spelling binds the same way.
function mix<T>(a: T, b: T): T[] { return [a, b] }
function w2<U>(u: U, v: f64) { return mix(u, v)[0] / 4.0 }
function f<T>(x: T, g: (i: i32) => T): T {
  return if [1].length > 1 { x } else { g(1) }
}
function w<U>(u: U) { return f(u, (i) => i * 1.5) }
const one = [1][0]
const two = [2.0][0]
print(w2(one, 0.5))
print(w2(two, 0.5))
print(w(one))
