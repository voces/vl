// @run
// @log 3
// @log e
// @log 3
// @log false
// @log 3
// @log e
// A higher-order function handed an un-annotated function at one call and a lambda literal at
// another: each instance calls only the functions its own calls hand it (D16814).
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
function app1<A>(f: (x: A) => A, x: A): A { return f(x) }
function happ(f, x) { return f(x) }
function hinc(x) { return x + 1 }
print(app(hinc, 2))
print(app((s: string) => s, "e"))
print(app1(hinc, 2))
print(app1((b: boolean) => !b, true))
print(happ(hinc, 2))
print(happ((s) => s, "e"))
