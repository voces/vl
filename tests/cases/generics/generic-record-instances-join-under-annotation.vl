// @run
// @log false
// @log y
// @hint redundant type annotation: `y` is inferred as `Box<i32> | Box<string> | null`
// A `??` join of two instances of one generic record, under an annotation naming both, is a
// union box whose arms are the two instances.
type Box<T> = { item: T }
function mkX(): Box<i32> | null { return null }
function mkY(): Box<string> | null { return { item: "y" } }
function go() {
  const y: Box<i32> | Box<string> | null = mkX() ?? mkY()
  print(y == null)
  if y is Box<string> { print(y.item) }
}
go()
