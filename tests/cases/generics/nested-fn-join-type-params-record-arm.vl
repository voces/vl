// @log true
// A join of two type parameters, one a record, read inside a function or lambda nested in the
// generic: each instance of the encloser types the join and builds its box (D4046).
type P = {x: i32}
type Q = {y: string}
function outer<T, U>(a: T, b: U, k: i32) {
  function inner(k2: i32) {
    const r = if k2 == 0 { a } else { b }
    print(r == null)
    print(r is P)
  }
  inner(k)
}
function viaLambda<T, U>(a: T, b: U, k: i32) {
  const inner = (k2: i32) => {
    const r = if k2 == 0 { a } else { b }
    print(r is Q)
  }
  inner(k)
}
const x1: P = { x: 8 }
const q1: Q = { y: "q" }
outer(4, x1, 0)
outer(4, x1, 1)
outer("s", x1, 1)
viaLambda(x1, q1, 0)
viaLambda(x1, q1, 1)
