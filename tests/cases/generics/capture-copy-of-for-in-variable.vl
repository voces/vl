// @run
// @log q
// @log p
// @log 2.5
// @log 7
// @log q
// @log p
// A closure capturing a bare copy (`const c = x`) of a `for-in` variable, inside a generic,
// stores the copy in its environment at the element's type (D2763). The copy's own local is
// typed with the loop in scope; the environment was typed without it and fell to `i32`. A copy
// of a copy is typed through the chain (D2786).
function run<T>(xs: T[]) {
  const fs: (() => T)[] = []
  for x in xs {
    const c = x
    fs.push(() => c)
  }
  fs
}
function first<T>(xs: T[]) {
  for x in xs {
    const c = x
    const f = () => c
    return f()
  }
  xs[0]
}
function runStr(xs: string[]) {
  const fs: (() => string)[] = []
  for x in xs {
    const c = x
    fs.push(() => c)
  }
  fs
}
print(run(["p", "q"])[1]())
print(first(["p", "q"]))
print(first([2.5, 1.5]))
print(first([7, 8]))
print(runStr(["p", "q"])[1]())
function twice<T>(xs: T[]) {
  for x in xs {
    const c = x
    const d = c
    const f = () => d
    return f()
  }
  xs[0]
}
print(twice(["p", "q"]))
