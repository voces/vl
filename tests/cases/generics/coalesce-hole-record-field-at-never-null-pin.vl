// @run
// @log 5
// @log 7
// @log 2.5
// @log 1.5
// @log 5
// A record field holding a `??` over a hole or type parameter, called at never-null pins, is
// built at each instance's own field type (D9911).
function f(x) { return { v: x ?? 1.5 } }
const a = 5
const b: i64 = 7
const c = 2.5
const n: i32 | null = null
print(f(a).v)
const r = f(b)
print(r.v)
print(f(c).v)
print(f(n).v)
function g<T>(x: T) { return { v: x ?? 1.5 } }
print(g(a).v)
