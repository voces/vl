// @check
// @error cannot infer type parameter `U`: no parameter of `opT` names it, but its body's function `g` takes it as a parameter type, so a call has nothing to bind it from — give `U` a parameter position, or pass the type arguments explicitly
// CONTRACT (must-error): `U` is a type parameter of `opT` that no parameter of `opT` names, and
// the body calls a lambda whose parameter is `U[]`, so an inferred call has nothing to bind `U`
// from. The checker refuses it, as it refuses a return-only type parameter; the same call with
// explicit type arguments (`opT<i32, i32>(a)`) binds `U` and runs.

function opT<T, U>(a: T[]): i32 {
  const g = (x: U[]) => x.length
  const q: i32[] = [1, 2]
  return g(q) + a.length
}

function cell(): i32 {
  const a: i32[] = [1]
  return opT(a)
}

print(cell())
