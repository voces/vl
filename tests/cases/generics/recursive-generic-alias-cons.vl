// @run
// @log 6
// @log 3
// @log ab
// @log 2
// A generic function building and walking a recursive generic instance: substituting `T` in
// `L<T>` yields the one shared `L<i32>`, so the nested calls deliver the type they return.
type L<T> = { head: T, tail: L<T> | null }

function cons<T>(h: T, t: L<T> | null): L<T> { return { head: h, tail: t } }

function len<T>(l: L<T> | null): i32 {
  let n = 0
  let c = l
  while c != null {
    n = n + 1
    c = c.tail
  }
  return n
}

const xs = cons(1, cons(2, cons(3, null)))
let s = 0
let c: L<i32> | null = xs
while c != null {
  s = s + c.head
  c = c.tail
}
print(s)
print(len(xs))
const ys = cons("a", cons("b", null))
const yt = ys.tail
if yt != null { print(ys.head + yt.head) }
print(len(ys))
