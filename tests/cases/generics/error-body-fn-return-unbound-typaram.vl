// @check
// @error cannot infer type parameter `U`: no parameter of `opT` names it, but its body's function `g` returns it, so a call has nothing to bind it from — give `U` a parameter position, or pass the type arguments explicitly
// @error cannot infer type parameter `U`: no parameter of `opN` names it, but its body's function `h` returns it, so a call has nothing to bind it from — give `U` a parameter position, or pass the type arguments explicitly
// CONTRACT (must-error, D4552): no parameter of the callee names `U`, but a body function
// returns `U[]`, so an inferred call has nothing to bind `U` from. The same calls with
// explicit type arguments run (`body-local-typaram-explicit-args.vl`).

function opT<T, U>(a: T[]) {
  const g = (_x: i32): U[] => []
  const r = g(1)
  return r.length + a.length
}

function opN<T, U>(a: T[]) {
  function h(_x: i32): U[] { return [] }
  return h(1).length + a.length
}

const a = [1]
print(opT(a))
print(opN(a))
