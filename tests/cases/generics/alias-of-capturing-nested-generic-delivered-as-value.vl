// @log 5
// An alias, and a chain of aliases, of a capturing nested generic delivered as a value with no
// call through it holds the enclosing instance's own closure: a callback argument, a list element
// read after the captured binding is written, and a record field (D3902);
// an alias called first at another type (D3905); a two-link chain called from a sibling (D3907).
function call(f: (n: i32) => void) { f(1) }
type R = { f: (n: i32) => void }
function outer<T>(x: T) {
  function inner<U>(u: U) { print(x); print(u) }
  const k = inner
  call(k)
}
function listed<T>(x: T, y: T) {
  let v = x
  function inner<U>(u: U) { print(v); print(u) }
  const k = inner
  const j = k
  const fs: ((n: i32) => void)[] = [j]
  v = y
  fs[0](3)
}
function fielded<T>(x: T) {
  function inner<U>(u: U) { print(x); print(u) }
  const k = inner
  const r: R = { f: k }
  r.f(4)
}
outer(7)
outer("s")
listed(7, 8)
listed("s", "t")
fielded(7)
fielded("s")
function firstOther<T>(x: T) {
  function inner<V>(u: V) { print(x); print(u) }
  const k = inner
  k("first")
  call(k)
}
function sibling<T>(x: T) {
  function inner<U>(u: U) { print(x); print(u) }
  const k = inner
  const j = k
  function sib() { j(5) }
  sib()
}
firstOther(7)
firstOther("s")
sibling(7)
sibling("s")
