// @run
// @log circle
// @log round
// @log circle
// @log 2
// A generic instance reading a literal-set field its layout family stores as the string decodes
// it to the atom its result holds, as the non-generic read does (D17283).
type K = "circle" | "round"
type A = { kind: K, r: i32 }
type B = { kind: string, r: i32 }
type C = { kind: K, n: i32 }
function mk(n: i32): A | B {
  if n == 0 { return { kind: "round", r: 1 } }
  return { kind: "zz", r: 2 }
}
function kindOf<T>(x: T): K { return x.kind }
function held<T>(x: T): K {
  const k: K = x.kind
  return k
}
const a: A = { kind: "circle", r: 1 }
const c: C = { kind: "round", n: 5 }
print(kindOf(a))
print(kindOf(c))
print(held(a))
print(mk(1).r)
