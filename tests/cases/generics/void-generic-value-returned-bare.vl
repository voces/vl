// @run
// @info `m` is never reassigned; use `const` instead of `let`
// @log 6
// @log 9
// @log 12
// @log 15
// @log 18
// @log 21
// @log 24
// @log 30
// @log 6
// A void generic function returned bare from an un-annotated function, then called as a
// statement through the binding, a copy, a capture, a lambda, a nested return and a local (D5610).
function show<T>(x: T) { print(x * 3) }
function d() { return show }
function e() { return d() }
const v = d()
v(2)
const w = v
w(3)
let m = d()
m(4)
function viaCapture() { v(5) }
viaCapture()
const viaLambda = () => {
  v(6)
}
viaLambda()
const n = e()
n(7)
function local() {
  const u = d()
  u(8)
}
local()
function pair<T>(x: T, y: T) { print(x * y) }
function dp() { return pair }
const p = dp()
p(5, 6)
d()(2)
