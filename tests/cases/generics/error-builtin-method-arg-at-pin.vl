// @check
// A BUILTIN COLLECTION METHOD'S ARGUMENT, RE-ASKED AT THE PIN (silent-class-inventory D582).
//
// The deferred ARGUMENT table (`argCstr*`) is recorded from the user-function call path and
// adjudicated against a callee it can NAME. A builtin method has no `FuncDecl` at all, so its
// argument check is the builtin's OWN arm — and inside a generic body every one of those arms
// is vacuous, because `assignable(T, string)` waves the value past it. `vl check` rc 0 and the
// engine refuses the module; or worse, i32 and boolean share a rep, so `"abc".charCodeAt(self)`
// at `g(true)` VALIDATED and printed `98`.
//
// FOURTEEN ARMS OVER THREE RECEIVER KINDS, and the width is measured rather than assumed: the
// row filed "at least two builtins" and `scripts/silent-sweep/d581/litgrid.py`'s block B grades
// the whole surface. Each line below is one arm, and each keeps the arm's OWN sentence —
// `bmArgMsg` is the single home both the arm and the pin render it from, so the two cannot
// drift the way `checkBinary` and `binOpDefinedFor` did (D492 / D493).
// @error push: cannot add i32 to string[] (the body of `apush` at the call's argument types)
// @error get: index must be i32, got string (the body of `aget` at the call's argument types)
// @error slice: bound must be i32, got string (the body of `aslice` at the call's argument types)
// @error set: expected string, got i32 (the body of `msetv` at the call's argument types)
// @error set: expected string, got i32 (the body of `msetk` at the call's argument types)
// @error get: key must be string, got i32 (the body of `mget` at the call's argument types)
// @error has: key must be string, got i32 (the body of `mhas` at the call's argument types)
// @error delete: key must be string, got i32 (the body of `mdel` at the call's argument types)
// @error add: expected string, got i32 (the body of `sadd` at the call's argument types)
// @error indexOf expects a string, got i32 (the body of `sidx` at the call's argument types)
// @error includes expects a string, got i32 (the body of `sinc` at the call's argument types)
// @error charCodeAt expects an i32 index, got string (the body of `scc` at the call's argument types)
// @error slice expects i32 bounds, got string and i32 (the body of `sslice` at the call's argument types)
// @error cpAt expects an i32 byte offset, got string (the body of `scp` at the call's argument types)
// @error isCharBoundary expects an i32 byte offset, got string (the body of `sicb` at the call's argument types)
// @error push: cannot add i32 to string[] (the body of `mirror` at the call's argument types)
// @error push: cannot add i32 to string[] (the body of `outer` at the call's argument types)
// @error push: cannot add i32 to string[] (the body of `apush` at the call's argument types)

// ── the ARRAY arms ────────────────────────────────────────────────────────────────────
function apush<T>(self: T) {
  const xs: string[] = []
  xs.push(self)
  return xs[0]
}
function aget<T>(self: T) {
  const xs = ["a", "b"]
  return xs.get(self) ?? "z"
}
function aslice<T>(self: T) {
  const xs = ["a", "b"]
  return xs.slice(self).length
}
// ── the MAP / SET arms ────────────────────────────────────────────────────────────────
function msetv<T>(self: T) {
  const m: {[string]: string} = Map()
  m.set("k", self)
  return m.get("k") ?? "z"
}
function msetk<T>(self: T) {
  const m: {[string]: string} = Map()
  m.set(self, "v")
  return m.keys().length
}
function mget<T>(self: T) {
  const m: {[string]: string} = Map()
  return m.get(self) ?? "z"
}
function mhas<T>(self: T) {
  const m: {[string]: string} = Map()
  return m.has(self)
}
function mdel<T>(self: T) {
  const m: {[string]: string} = Map()
  return m.delete(self)
}
function sadd<T>(self: T) {
  const st: {[string]: boolean} = Set()
  st.add(self)
  return st.has("a")
}
// ── the STRING arms ───────────────────────────────────────────────────────────────────
function sidx<T>(self: T) {
  return "abc".indexOf(self)
}
function sinc<T>(self: T) {
  return "abc".includes(self)
}
function scc<T>(self: T) {
  return "abc".charCodeAt(self)
}
function sslice<T>(self: T) {
  return "abc".slice(self, 2)
}
function scp<T>(self: T) {
  return "abc".cpAt(self)
}
function sicb<T>(self: T) {
  return "abc".isCharBoundary(self)
}
// THE MIRROR: the hole is on the RECEIVER's element and the value is concrete. Both sides of
// the gate have to be asked, or a widening evaporates in exactly one direction (#2019 found
// both existing tables want-side-blind).
function mirror<T>(xs: T[], v: i32) {
  xs.push(v)
  return xs[0]
}
// THE TWO-LEVEL RELAY: the inner call substitutes the constraint's hole to ANOTHER hole, so
// it must be re-recorded under the caller.
function inner<T>(self: T) {
  const xs: string[] = []
  xs.push(self)
  return xs[0]
}
function outer<U>(self: U) {
  return inner(self)
}

print(apush(6))
print(aget("s"))
print(aslice("s"))
print(msetv(6))
print(msetk(6))
print(mget(6))
print(mhas(6))
print(mdel(6))
print(sadd(6))
print(sidx(6))
print(sinc(6))
print(scc("s"))
print(sslice("s"))
print(scp("s"))
print(sicb("s"))
const zs = ["a"]
print(mirror(zs, 1))
print(outer(6))
// AND THE METHOD SPELLING, which rides a DIFFERENT PIN.
const p = 6
print(p.apush())
