// @check
// A BUILTIN COLLECTION METHOD'S ARGUMENT, RE-ASKED AT THE PIN (silent-class-inventory D582).
//
// The deferred ARGUMENT table (`argCstr*`) is recorded from the user-function call path and
// adjudicated against a callee it can NAME. A builtin method has no `FuncDecl` at all, so its
// argument check is the builtin's OWN arm — and inside a generic body every one of those arms
// is vacuous, because `assignable(T, string)` waves the value past it. `vl check` rc 0 and the
// engine refuses the module; or worse, i32 and boolean share a rep, so `"abc".charCodeAt(self)`
// at `g(true)` VALIDATED and printed `98`.
//
// FOURTEEN ARMS OVER THREE RECEIVER KINDS, and the width is measured rather than assumed: the
// row filed "at least two builtins" and `scripts/silent-sweep/d581/litgrid.py`'s block B grades
// the whole surface. Each line below is one arm, and each keeps the arm's OWN sentence —
// `bmArgMsg` is the single home both the arm and the pin render it from, so the two cannot
// drift the way `checkBinary` and `binOpDefinedFor` did (D492 / D493).
// @error push: cannot add i32 to string[] (parameter `self` of `apush`, used at 38:11)
// @error get: index must be i32, got string (parameter `self` of `aget`, used at 43:17)
// @error slice: bound must be i32, got string (parameter `self` of `aslice`, used at 47:19)
// @error set: expected string, got i32 (parameter `self` of `msetv`, used at 52:14)
// @error set: expected string, got i32 (parameter `self` of `msetk`, used at 57:9)
// @error get: key must be string, got i32 (parameter `self` of `mget`, used at 62:16)
// @error has: key must be string, got i32 (parameter `self` of `mhas`, used at 66:16)
// @error delete: key must be string, got i32 (parameter `self` of `mdel`, used at 70:19)
// @error add: expected string, got i32 (parameter `self` of `sadd`, used at 74:10)
// @error indexOf expects a string, got i32 (parameter `self` of `sidx`, used at 78:50)
// @error includes expects a string, got i32 (parameter `self` of `sinc`, used at 79:51)
// @error charCodeAt expects an i32 index, got string (parameter `self` of `scc`, used at 80:52)
// @error slice expects i32 bounds, got string and i32 (parameter `self` of `sslice`, used at 81:50)
// @error cpAt expects an i32 byte offset, got string (parameter `self` of `scp`, used at 82:46)
// @error isCharBoundary expects an i32 byte offset, got string (parameter `self` of `sicb`, used at 83:57)
// @error push: cannot add i32 to string[] (the body of `mirror`, used at 88:11)
// @error push: cannot add i32 to string[] (parameter `self` of `outer`, used at 95:11)
// @error push: cannot add i32 to string[] (parameter `self` of `apush`, used at 38:11)

// ── the ARRAY arms ────────────────────────────────────────────────────────────────────
function apush<T>(self: T) {
  const xs: string[] = []
  xs.push(self)
  return xs[0]
}
function aget<T>(self: T) {
  const xs = ["a", "b"]
  return xs.get(self) ?? "z"
}
function aslice<T>(self: T) {
  const xs = ["a", "b"]
  return xs.slice(self).length
}
// ── the MAP / SET arms ────────────────────────────────────────────────────────────────
function msetv<T>(self: T) {
  const m: {[string]: string} = Map()
  m.set("k", self)
  return m.get("k") ?? "z"
}
function msetk<T>(self: T) {
  const m: {[string]: string} = Map()
  m.set(self, "v")
  return m.keys().length
}
function mget<T>(self: T) {
  const m: {[string]: string} = Map()
  return m.get(self) ?? "z"
}
function mhas<T>(self: T) {
  const m: {[string]: string} = Map()
  return m.has(self)
}
function mdel<T>(self: T) {
  const m: {[string]: string} = Map()
  return m.delete(self)
}
function sadd<T>(self: T) {
  const st: Set<string> = Set()
  st.add(self)
  return st.has("a")
}
// ── the STRING arms ───────────────────────────────────────────────────────────────────
function sidx<T>(self: T) { return "abc".indexOf(self) }
function sinc<T>(self: T) { return "abc".includes(self) }
function scc<T>(self: T) { return "abc".charCodeAt(self) }
function sslice<T>(self: T) { return "abc".slice(self, 2) }
function scp<T>(self: T) { return "abc".cpAt(self) }
function sicb<T>(self: T) { return "abc".isCharBoundary(self) }
// THE MIRROR: the hole is on the RECEIVER's element and the value is concrete. Both sides of
// the gate have to be asked, or a widening evaporates in exactly one direction (#2019 found
// both existing tables want-side-blind).
function mirror<T>(xs: T[], v: i32) {
  xs.push(v)
  return xs[0]
}
// THE TWO-LEVEL RELAY: the inner call substitutes the constraint's hole to ANOTHER hole, so
// it must be re-recorded under the caller.
function inner<T>(self: T) {
  const xs: string[] = []
  xs.push(self)
  return xs[0]
}
function outer<U>(self: U) { return inner(self) }

print(apush(6))
print(aget("s"))
print(aslice("s"))
print(msetv(6))
print(msetk(6))
print(mget(6))
print(mhas(6))
print(mdel(6))
print(sadd(6))
print(sidx(6))
print(sinc(6))
print(scc("s"))
print(sslice("s"))
print(scp("s"))
print(sicb("s"))
const zs = ["a"]
print(mirror(zs, 1))
print(outer(6))
// AND THE METHOD SPELLING, which rides a DIFFERENT PIN.
const p = 6
print(p.apush())
