// @run
// @log 3
// @log a
// @log a
// @log 7
// @log true
// @log 4
// A generic `T | string` pinned at a union that already holds `string` returns the union the direct
// spelling registers, at every member order and arity (D2779).
function f<T>(u: T | string): T | string { u }
const x: i32 | string = 3
const s: i32 | string = "a"
print(f<i32 | string>(x))
print(f<i32 | string>(s))
const y: i32 | string = f<i32 | string>(s)
print(y)
const w: string | i32 = 7
print(f<string | i32>(w))
const b: boolean | string | i32 = true
print(f<boolean | string | i32>(b))
const r = f<i32 | string>(x)
if r is i32 { print(r + 1) } else { print(r) }
