// @run
// @log true
// @log 2
// @log 2
// @log true
// @hint redundant type annotation: `s` is inferred as `(i32[] | null)[]`
// @hint redundant type annotation: `t` is inferred as `{slots: (i32[] | null)[]}`
// D2525: a lambda written as a `return` argument inside a generic was lifted once and shared by
// every instance, so its capture of a `(V | null)[]` read the element at the template's rep —
// invalid wasm when `V` is a list, through a parameter and through a generic record `self`. Each
// instance now clones the lambda, as it already did for a lambda bound with `const`.
function mkGet<V>(xs: (V | null)[]): (i32) => V | null {
  return (i: i32) => xs[i]
}
const s: (i32[] | null)[] = [null, [4, 5]]
const g = mkGet(s)
print(g(0) == null)
const r = g(1)
if r != null { print(r.length) }

type Tbl<V> = { slots: (V | null)[] }
function getter<V>(self: Tbl<V>): (i32) => V | null {
  return (i: i32) => self.slots[i]
}
const t: Tbl<i32[]> = { slots: s }
const h = t.getter()
const r2 = h(1)
if r2 != null { print(r2.length) }
print(h(0) == null)
