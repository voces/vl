// @run
// @log none
// @log true
// @log true
// @log true
// A hole or generic instance reading a function through a declared row's `H | null` field, of a
// literal whose field is present, calls it at the function's own result type (D3205).
type H = { f: () => boolean }
type Q = { v: i32, h: H | null }
function nested(z) {
  if z.h != null { print(z.h.f()) } else { print("none") }
}
nested({ v: 5, h: null })
function nestedBound(z) {
  const g = z.h.f
  print(g())
}
nestedBound({ v: 6, h: { f: () => true } })
function nestedGeneric<Z>(z: Z) {
  const g = z.h.f
  print(g())
}
nestedGeneric({ v: 6, h: { f: () => true } })
nested({ v: 7, h: { f: () => true } })
