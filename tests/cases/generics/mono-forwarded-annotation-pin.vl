// @run
// A generic call whose argument is a binding of the ENCLOSING GENERIC BODY — its own
// parameter, or a `T`-annotated local — takes its monomorphization pin from that
// binding's SUBSTITUTED ANNOTATION.
//
// The axis is the ANNOTATION CHANNEL, not the nesting. `monoArgTyName` has two ways to
// name a generic call's argument: the CHECKER's recorded type of the argument node, and
// the argument's own annotation (`monoAnnPinName`). Inside a generic body the first one
// is blind — the recorded type of `x` in `gid(x)` is the type PARAMETER, so
// `nodeTyMapName` and `nodeTyName` both render "" — and `buildLocals` is post-mono, so
// every `declared*` table the expression cascade would fall back on is empty. The
// instance's parameter DOES carry the substituted annotation. When the annotation ladder
// had no arm for the spelling, the argument fell to the `"i32"` catch-all: the instance
// declared an i32 parameter over a body doing map / string / list work, `vl check` was
// clean and the module failed validation ("current function requires result type
// [(ref …)] but callee returns [i32]").
//
// WHAT MOVES, measured over a 26-rep x 9-shape grid:
//   * the REP. Through a forwarded PARAMETER only the map/Set spellings failed — a
//     `string` / `i32[]` / scalar parameter is reachable from the cascade's own
//     annotation probes (`paramString`, `paramF64Array`, …) and always was. Through a
//     `T`-annotated LOCAL every non-i32 rep failed, because a LOCAL has no such probe.
//   * NOT the nesting depth (two levels and three fail alike), NOT the arity, NOT
//     whether `T` also appears in the return, NOT whether the result is bound to a
//     `const` first. Those four were held fixed by the filing and each is flat here.
// CONTROL: making the forwarder CONCRETE was always correct, which is what isolates the
// failure to the substituted annotation rather than to the forwarding.
//
// @hint Intentionally-unused parameter `_y`
// @hint Intentionally-unused variable `_y`
// @hint redundant type annotation: `gpin` is inferred as `i32`
// @hint redundant type annotation: `s` is inferred as `string`
// @hint redundant type annotation: `dv` is inferred as `f64`
// @hint redundant type annotation: `lv` is inferred as `i64`
// @hint redundant type annotation: `bv` is inferred as `boolean`
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// @hint redundant type annotation: `ss` is inferred as `string[]`
// @hint redundant type annotation: `ds` is inferred as `f64[]`
// @hint redundant type annotation: `ls` is inferred as `i64[]`
function gid<T>(x: T): T { return x }
// Two generic levels — the forwarder hands on its own parameter.
function gwrap<T>(x: T): T { return gid(x) }
// Three levels: depth is not the axis.
function gouter<T>(x: T): T { return gwrap(x) }
// Arity 2, and a second type param that never reaches the inner call.
function gpair<T, U>(x: T, _y: U): T { return gid(x) }
// `T` in PARAMETER position only — the forwarder's own return is concrete.
function gpin<T>(x: T, n: i32): i32 {
  const _y = gid(x)
  return n
}
// A `T`-ANNOTATED LOCAL, the second binding form the annotation ladder answers for.
function gloc<T>(x: T): T {
  const y: T = x
  return gid(y)
}
// CONTROL: a CONCRETE forwarder was correct on master for every rep below.
function wrapc(x: {[string]: i32}): {[string]: i32} { return gid(x) }

// ── the six map/Set spellings, forwarded through a generic parameter ──────────
// Both KEY flavours and four VALUE reps: the filing measured four spellings and the
// value rep turns out not to move either.
function maps() {
  const msi: {[string]: i32} = Map()
  msi["a"] = 1
  // @log 1
  print(gwrap(msi).length)
  const mis: {[i32]: string} = Map()
  mis[1] = "a"
  // @log 1
  print(gwrap(mis).length)
  const mss: {[string]: string} = Map()
  mss["a"] = "b"
  // @log 1
  print(gwrap(mss).length)
  const mif: {[i32]: f64} = Map()
  mif[1] = 1.5
  // @log 1
  print(gwrap(mif).length)
  const ss: {[string]: boolean} = Set()
  ss.add("a")
  // @log 1
  print(gwrap(ss).length)
  const si: {[i32]: boolean} = Set()
  si.add(1)
  // @log 1
  print(gwrap(si).length)
}
maps()

// ── the shapes held fixed by the filing, each flat ────────────────────────────
function shapes() {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m["b"] = 2
  // three levels
  // @log 2
  print(gouter(m).length)
  // arity 2
  // @log 2
  print(gpair(m, 1).length)
  // `T` in parameter position only
  // @log 9
  print(gpin(m, 9))
  // a `T`-annotated LOCAL inside the forwarder
  // @log 2
  print(gloc(m).length)
  // the result read straight through, with no `const` binding
  // @log 2
  print(gwrap(m).length)
  // CONTROL: the concrete forwarder
  // @log 2
  print(wrapc(m).length)
}
shapes()

// ── the `T`-annotated LOCAL over the reps a forwarded PARAMETER never lost ────
// A local carries no `param*` probe, so the annotation ladder is the only channel and
// every one of these was a check-clean invalid module.
function locals() {
  const s: string = "aa"
  // @log aa
  print(gloc(s))
  const fv: f32 = 1.5
  // @log 1069547520
  print(f32bits(gloc(fv)))
  const dv: f64 = 2.5
  // @log 2.5
  print(gloc(dv))
  const lv: i64 = 5 as i64
  // @log 5
  print(gloc(lv))
  const bv: boolean = true
  // @log true
  print(gloc(bv))
  const xs: i32[] = [1, 2]
  // @log 2
  print(gloc(xs).length)
  const ss: string[] = ["a"]
  // @log 1
  print(gloc(ss).length)
  const ds: f64[] = [1.5]
  // @log 1
  print(gloc(ds).length)
  const ls: i64[] = [5 as i64]
  // @log 1
  print(gloc(ls).length)
  const fs: f32[] = [1.5]
  // @log 1
  print(gloc(fs).length)
}
locals()

// ── an `f32[]` / `i64[]` ARGUMENT bound to an annotated local ─────────────────
// The same annotation ladder, at the direct one-level call. `f32[]` was the loud half of
// the family (`monomorphize: expected an array argument`), which is why it is pinned
// beside the silent ones: one arm answers for both.
function directLists() {
  const fs: f32[] = [1.5, 2.5]
  // @log 2
  print(gid(fs).length)
  // @log 1069547520
  print(f32bits(gid(fs)[0]))
  const ls: i64[] = [5 as i64]
  // @log 1
  print(gid(ls).length)
}
directLists()
