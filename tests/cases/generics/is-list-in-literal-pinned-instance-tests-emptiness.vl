// @run
// @log 10
// @log 0
// @log 1
// @log 10
// @log 1
// @log 10
// @log 0
// @log 10
// @log 0
// An instance bound by a `[]` argument answers `is K[]` by the value as an exact one does: the
// receiver's type is read at the instance's pin, so an empty list fits (D4771), whether
// the receiver is the argument, a local typed at an unbound parameter, or an un-annotated one.
function arg<T>(a: T[]) {
  if a is f64[] { print(10) }
  print(a.length)
}
function local<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { print(10) }
  print(a.length)
}
function bare(a) {
  if a is f64[] { print(10) }
  print(a.length)
}
arg([])
arg([1])
arg([1.5])
local([])
bare([])
