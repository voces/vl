// @run
// @log a
// @log b
// @log b
// @log 3
// @log true
// @log 2
// A list literal of members, passed to a generic whose result reaches a literal-union list, binds
// the type parameter to the member type, at a binding, a return and an argument (D5283).
type K = "a" | "b"
function id<T>(xs: T[]): T[] { xs }
function firstOf(ks: K[]): K { ks[0] }
const r: K[] = id(["a"])
print(r[0])
function f(): K[] { id(["a", "b"]) }
print(f()[1])
print(firstOf(id(["b"])))
const p: K[] = id(["a", "b"])
p.push("b")
print(p.length)
print(p[2] == "b")
const nested: K[][] = id([["a"], ["b", "a"]])
print(nested[1].length)
