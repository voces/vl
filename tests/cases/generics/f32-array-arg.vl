// @run
// @log 1.5
// @log 2.5
// @log 2
// @log 1.5
// @log 7.5
// @log 1
// @hint redundant type annotation: `count` is inferred as `i32`
// @hint redundant type annotation: `ds` is inferred as `f64[]`
// A GENERIC function called with an `f32[]` ARGUMENT binds its type parameter to `f32`.
// The monomorphizer's argument-type classifier (`monoArgTyName`) tested the f64 list and
// then fell THROUGH to the i32-list default (`"i32[]"`), so `head(xs)` instantiated
// `head<i32>` — the instance's functype declared the i32-list param and an i32 result
// while the caller passed the f32 list, so the module failed wasm validation. f32 and
// f64 are separate reps: binding `T` to either one must follow the ARGUMENT.

function head<T>(self: T[]): T { return self[0] }
function at<T>(self: T[], i: i32) { return self[i] }
function count<T>(self: T[]): i32 { return self.length }

const xs: f32[] = [1.5, 2.5]
print(head(xs)) // 1.5
print(at(xs, 1)) // 2.5
print(count(xs)) // 2

// An f32 list reached through a PARAMETER annotation.
function firstOf(ys: f32[]) { return head(ys) }
print(firstOf(xs)) // 1.5

// `f64[]` and `i32[]` keep their own instances of the same generics.
const ds: f64[] = [7.5, 8.5]
print(head(ds)) // 7.5
print(head([1, 2])) // 1
