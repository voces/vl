// @run
// @log 1
// @hint Intentionally-unused variable `_u`
// WAS a frontier pin ("@emit-error ref valtype with no interned shape"); CLOSED by the
// generic-application nominal sidecar (typed-IR P1), which banked the application in the arena
// so the shape registration key and the classifiers' lookup key are both `Box<i32>`.
//
// The inline spelling is one `TypeRef` whose name is the pipe-joined member set. Canon now
// rewrites its generic-application members to their shapes when the union has two or more
// non-null members, as the `UnionDecl` arm always did (D14300), so the reassigned and narrowed
// inline spellings build a variant box too. `Box<i32> | null` keeps the application's name,
// because its nullable niche resolves through it.
type Box<T> = { v: T }
type Tag = { t: i32 }

const _u: Box<i32> | Tag = { v: 1 }
print(1)
