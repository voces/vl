// `==` in a generic body over field and element reads of two records of one field set stored
// apart compares field by field at the instance, nested and nullable records too (D16470, D16810).
function eq<T, U>(a: {v: T}, b: {v: U}) { return a.v == b.v }
function eqi<T, U>(a: T[], b: U[]) { return a[0] == b[0] }
function ne<T, U>(a: {v: T}, b: {v: U}) { return a.v != b.v }
print(eq({ v: { f: 1 } }, { v: { f: 1.0 } }))
print(eq({ v: { f: 1 } }, { v: { f: 2.0 } }))
print(eqi([{ f: 1 }], [{ f: 1.0 }]))
print(ne({ v: { f: 1 } }, { v: { f: 1.0 } }))
print(eq({ v: { f: 1, g: { h: 2 } } }, { v: { f: 1.0, g: { h: 2.0 } } }))
print(eq({ v: { f: 1, g: { h: 2 } } }, { v: { f: 1.0, g: { h: 3.0 } } }))
const x: { f: i32 } | null = { f: 1 }
const y: { f: f64 } | null = { f: 1.0 }
print(eq({ v: x }, { v: y }))
print(eq({ v: x }, { v: null }))
