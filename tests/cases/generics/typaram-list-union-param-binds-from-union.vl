// @run
// @log e
// @log 7
// @log s
// @log other
// @log 2.5
// @log 1
// @log true
// @log 7
// @log int
// @log 3
// @log r
// @log 1.5
// @log 3
// @log 0
// @log p
// @log 1
// @log q
// @log n
// @log 3.5
// @log w
// A parameter `U[] | i32[]` keeps both arms and binds `U` from the argument's list the `i32[]`
// arm does not admit, a union argument included: the complement's record, an unnarrowed read
// printed, bound and tested, the read returned, captured, iterated, assigned, and forwarded.
function h<T>(v: T[] | i32[]) {
  if v is i32[] {
    print(v[0])
  } else {
    const r = { xs: v }
    print(r.xs[0])
  }
}
const a: string[] | i32[] = ["e"]
h(a)
h([7])

function g2<U>(a: U[] | i32[]) {
  print(a[0])
  const y = a[0]
  if y is i32 { print("int") } else { print("other") }
}
g2(["s"])

function narrowed<U>(a: U[] | i32[]) {
  if a is i32[] { print(a[0] + 1) } else { print(a[0]) }
}
narrowed([2.5])
narrowed([0])
narrowed([true])
g2([7])

function cap<U>(a: U[] | i32[]) {
  const f = () => a.length
  print(f())
}
cap(["a", "b", "c"])

function first<U>(a: U[] | i32[]): U | i32 { a[0] }
print(first(["r"]))
print(first([1.5]))

function lenInf<U>(a: U[] | i32[]) { a.length }
print(lenInf([1, 2, 3]))

function each<U>(a: U[] | i32[]) {
  for e, i in a {
    print(i)
    print(e)
  }
}
each(["p", "q"])

function asg<U>(a: U[] | i32[]) {
  let v = a[0]
  v = a[a.length - 1]
  print(v)
}
asg(["m", "n"])
asg([2.25, 3.5])

const u: string[] | i32[] = ["w"]
print(first(u))
