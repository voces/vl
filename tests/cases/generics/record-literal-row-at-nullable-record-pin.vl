// @run
// @log ok
// @log ok
// @log ok
// @log ok
// A record literal in a generic body whose type parameter is pinned to a nullable record
// (`Circle | null`) is built at that instance's row: `expect`'s `{actual: value, ...}` and the
// `{r: 3}` handed to `toEqual` each get the row their instance names.
import { expect, toEqual } from "std:test"

type Circle = { r: i32 }

// Un-annotated spelling: the nullable record is inferred from `pick`'s return.
function pick(f: boolean): Circle | null {
  if f { return { r: 3 } }
  null
}
expect(pick(true)).toEqual({ r: 3 })
print("ok")

// Annotated spelling: the binding names the nullable record itself.
const held: Circle | null = { r: 3 }
expect(held).toEqual({ r: 3 })
print("ok")

// Second delivery position: the expected value is bound first, then passed.
const want: Circle | null = { r: 3 }
expect(pick(true)).toEqual(want)
print("ok")

// Absent arm of the same instance.
expect(pick(false)).toEqual(null)
print("ok")
