// @run
// @log 1.5
// @log 4
// @log 3
// @log 1.5
// @log 1.5
// An indexed read of a binding an identity's call initialises resolves through that call's own
// argument, however many times the identity is called (D16875).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id(x) { return x }
const r = id([inc0, half])
const s = id([half, inc0])
print(r[1](3))
print(s[1](3))
print(id(3))
const t = id({ l: [inc0, half] })
const u = id([[inc0, half]])
print(t.l[1](3))
print(u[0][1](3))
