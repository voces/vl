// @run
// @log null
// @log null
// @log 3
// @log 2
// @log false
// @log true
// @log false
// @log null
// @log null
// @log 5
// @log 7
// @log 7
// @hint redundant type annotation: `a` is inferred as `null`
// D8280: a `null` handed to a generic or un-annotated parameter through a binding no write fills,
// or through a parameter of an instance already pinned at `null`, pins `null`, not `i32`: at a
// module binding and a local, beside a second call at a value, under `is`, forwarded to a second
// generic, annotated, and through a binding a later write fills; and to a parameter that only
// tests it (D3305).
function show(v) { print(v) }
function showT<T>(v: T) { print(v) }
function kind<T>(v: T) {
  if v is i32 { print(1) } else { print(2) }
}
function isInt<T>(v: T) { v is i32 }
function fwd<T>(v: T) { print(isInt(v)) }
function u(q) {
  if q == null { 7 } else { 0 }
}
function uT<T>(q: T) {
  if q == null { 7 } else { 0 }
}
function local() {
  const n = null
  show(n)
}

const n = null
show(n)
local()
show(3)
kind(n)
fwd(n)
fwd(3)
print(isInt(n))
const a: null = null
showT(a)
let m = null
show(m)
m = 5
show(m)
print(u(n))
print(uT(n))
