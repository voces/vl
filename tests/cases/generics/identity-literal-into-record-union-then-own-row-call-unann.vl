// @run
// @log 1
// @log 1
// @log 5
// @log 4
// D8340: a record literal delivered through a generic identity into a union holding a wider
// record leaves a later generic call at the same field names its own row. Literal and
// binding arguments.
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
function one<T>(v: T): i32 { 1 }
const u: J | string = idn({ r: 4 })
print(one({ r: 5 }))
const k = { r: 5 }
print(one(k))
print(k.r)
if u is J { print(u.r ?? 0) }
