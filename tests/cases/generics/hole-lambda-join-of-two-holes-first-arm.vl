// @run
// @log a
// @log 3
// @log a
// @log 3
// A lambda joining two parameter holes returns either arm as itself: the call site and the
// lambda's body read one producer, the hole instance's elaboration (D3616). The second
// function delivers the call into a binding.
type K = "a" | "b"
const xn: K | null = "a"
function F(k: i32, a, b) {
  const g = () => {
    if k == 0 { a } else { b }
  }
  print(g())
}
F(0, xn, 3)
F(1, xn, 3)
function G(k: i32, a, b) {
  const g = () => {
    if k == 0 { a } else { b }
  }
  const r = g()
  print(r)
}
G(0, xn, 3)
G(1, xn, 3)
