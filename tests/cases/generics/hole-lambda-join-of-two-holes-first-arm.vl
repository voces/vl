// @run
// @log a
// @log a
// A lambda joining two parameter holes returns its first arm, a nullable literal union, as
// itself: the call site and the lambda's body are typed by one producer. The second arm is
// D3616's witness. The second function delivers the call into a binding.
type K = "a" | "b"
const xn: K | null = "a"
function F(k: i32, a, b) {
  const g = () => { if k == 0 { a } else { b } }
  print(g())
}
F(0, xn, 3)
function G(k: i32, a, b) {
  const g = () => { if k == 0 { a } else { b } }
  const r = g()
  print(r)
}
G(0, xn, 3)
