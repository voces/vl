// @log 1
// A function value whose result is `null`, the generic's own type parameter, or a member of a
// nullable result is delivered at that result, wherever the value comes from (D10240, D10241,
// D10242).
function len<T>(f: () => T | null) {
  const t = f()
  if t == null { 0 } else { 1 }
}
function outer<T>(x: T) {
  print(len(() => 4))
  print(len(() => x))
}
outer(5)
outer("s")

function q(f: () => i32 | null) {
  const t = f()
  if t == null { 0 } else { 1 }
}
const g = () => 4
print(q(g))
const k = () => null
print(q(k))

function mk<T>(f: () => T) { f() }
print(mk(() => 3) == 3)
print(mk(() => null) == null)

const h = () => null
print(len(h))
function take(a) { print(len(a)) }
take(() => null)
take(() => 3)
