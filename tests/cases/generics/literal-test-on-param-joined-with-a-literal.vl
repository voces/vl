// @run
// @log one
// @log t
// @log one
// @log t
// @log one
// A literal test on a parameter typed `T | 1` reads the box of the pinned instance's own union,
// at both pins and in both spellings (D4203).
function f<T>(x: T | 1) {
  if x is 1 { print("one") } else { print("t") }
}
function g<T>(x: T | 1) {
  if x == 1 { print("one") } else { print("t") }
}
f(1)
f("q")
g(1)
g("q")
function h<T>(x: T | 1) {
  if x is 1 { print("one") } else { print("t") }
}
h(1)
