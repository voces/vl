// @run
// @hint Intentionally-unused parameter `_b`
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_b`
// @hint Intentionally-unused parameter `_a`
// @log 2.5
// @log 2.5
// @log 1.5
// @log 1.5
// A destination binds a type parameter its call leaves open where it sits in a parameter position of
// an open-function slot, though another argument binds the slot's other parameter: generic and hole
// arguments, returning the bound or the open parameter (D16563).
function first<A, B>(a: A, _b: B): A { return a }
function second<X, Y>(_x: X, y: Y): Y { return y }
function hfst(a, _b) { return a }
function hsnd(_a, b) { return b }
function bind1<A, B>(f: (a: A, b: B) => A, a: A): (b: B) => A {
  return (b: B) => f(a, b)
}
const v1: (b: string) => f64 = bind1(first, 2.5)
print(v1("s"))
const v2: (b: string) => f64 = bind1(hfst, 2.5)
print(v2("s"))
const v3: (b: f64) => f64 = bind1(second, 2.5)
print(v3(1.5))
const v4: (b: f64) => f64 = bind1(hsnd, 2.5)
print(v4(1.5))
