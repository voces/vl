// @run
// @log 2.5
// @log s
// @log -1
// A generic returning another generic's two-list result beside its own list returns the union
// of the three at the pin, and an `is` test tells each arm apart (D2784).
function g<U>(u: U, c: boolean) {
  if c { return [u] }
  [2.5]
}
function h<T>(c: boolean, t: T) {
  if c { return g(t, false) }
  [t]
}
const q = h(true, "s")
if q is f64[] { print(q[0]) } else { print(-1) }
const p = h(false, "s")
if p is string[] { print(p[0]) } else { print(-1) }
const w: string[] | f64[] = h(false, "s")
if w is f64[] { print(w[0]) } else { print(-1) }
