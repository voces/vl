// @run
// @log 4
// @log 1
// @log 4
// @log s
// @log 6
// @log 2
// @log 6
// @log t
// @log 8
// @log 3
// @log 8
// @log u
// @log 8
// @log true
// D12212: a generic read as a value keeps its own `T` though the generic body it is written in
// declares one too, so each instance calls the written lambda at the call's own type: a list
// slot, a record field annotated or not, a nested list, and an instance at a third type.
function id<T>(x: T): T { x }
const fs = [id]
function w<T>(t: T) {
  fs[0] = (x) => x + x
  print(fs[0](2))
  print(t)
}
w(1)
w("s")
const r = { f: id }
function v<T>(t: T) {
  r.f = (x: i32) => x + x
  print(r.f(3))
  print(t)
}
v(2)
v("t")
function u<T>(t: T) {
  const gs = [[id]]
  gs[0][0] = (x) => x + x
  print(gs[0][0](4))
  print(t)
}
u(3)
u("u")
u(true)
