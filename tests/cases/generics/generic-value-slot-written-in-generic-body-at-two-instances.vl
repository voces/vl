// @run
// @log 4
// @log 1
// @log 4
// @log s
// @log 6
// @log 2
// @log 6
// @log t
// @log 8
// @log 3
// @log 8
// @log u
// @log 8
// @log true
// @log 4
// @log 6
// @log 10
// @log c
// @log 10
// @hint Intentionally-unused parameter
// D12212: a generic read as a value keeps its own `T` though the generic body it is written in
// declares one too, so each instance calls the written lambda at the call's own type: a list
// slot, a record field annotated or not, a nested list, and an instance at a third type; and a
// method call on the body's own `T` naming a generic of the same parameter name (D3822); and a
// lambda capturing the instance's parameter, cloned per instance (D15032).
function id<T>(x: T): T { x }
const fs = [id]
function w<T>(t: T) {
  fs[0] = (x) => x + x
  print(fs[0](2))
  print(t)
}
w(1)
w("s")
const r = { f: id }
function v<T>(t: T) {
  r.f = (x: i32) => x + x
  print(r.f(3))
  print(t)
}
v(2)
v("t")
function u<T>(t: T) {
  const gs = [[id]]
  gs[0][0] = (x) => x + x
  print(gs[0][0](4))
  print(t)
}
u(3)
u("u")
u(true)
function each<T>(self: T[], g: (T) => void) {
  for x in self { g(x) }
}
function cnt3<T>(x: T) {
  let n = 0
  x.each((_v) => {
    n = n + 1
  })
  n
}
print(cnt3([1, 2, 3, 4]))
function pick<U>(x: U): U { x }
const hs = [pick]
function cap<T>(t: T) {
  hs[0] = (x) => {
    print(t)
    return x + x
  }
  print(hs[0](5))
}
cap(6)
cap("c")
