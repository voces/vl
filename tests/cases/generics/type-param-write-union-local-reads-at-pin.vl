// @run
// @log true
// @log false
// @log n
// @log true
// @log 1
// @log false
// @log a
// @log false
// @log true
// @log false
// @log 7
// @log 2
// @log null n
// @log set
// A type-parameter write into a local declared over a several-member or number-literal union
// reads, at each pin, whether the pin can be null, as the direct spelling does (D3446).
type M = "a" | 1
type N = 1 | 2
function multi<T>(x: T) {
  let s: string | i32 | null = null
  s = x
  print(s == null)
}
function mixed<T>(x: T) {
  let s: M | null = null
  s = x
  print(s ?? "n")
  print(s == null)
}
function num<T>(x: T) {
  let s: N | null = null
  s = x
  print(s == null)
}
function numDefault<T>(x: T) {
  let s: N | null = 1
  s = x
  const r: i32 = s ?? 7
  r
}
function multiDefault<T>(x: T) {
  let s: string | i32 | null = 1
  s = x
  const d = s ?? "n"
  if s == null && d == "n" { return "null n" }
  "set"
}
const sv: string | i32 | null = null
const si: string | i32 | null = 4
multi(sv)
multi(si)
const mv: M | null = null
const mw: M | null = 1
const mu: M = "a"
mixed(mv)
mixed(mw)
mixed(mu)
const nv: N | null = null
const nu: N = 1
num(nv)
num(nu)
const nw: N | null = 2
print(numDefault(nv))
print(numDefault(nw))
print(multiDefault(sv))
print(multiDefault(si))
