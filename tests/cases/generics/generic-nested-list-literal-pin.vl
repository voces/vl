// @log null
// @log null
// A type parameter's nested list literal builds its inner list at the instance's pin, and a
// loop over it binds each inner list and element there (D3115).
function f<T>(x: T) {
  const l = [[x]]
  print(l.length + l[0].length)
  print(l[0][0])
  for r in l {
    for e in r { print(e) }
  }
}
f(2.5)
f("s")
f(5000000000)
f(true)
f(3)
const v: string | null = null
f(v)
