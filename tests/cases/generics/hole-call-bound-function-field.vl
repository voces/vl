// @run
// @log s
// @log 1.5
// @log s
// @log false
// A hole instance calling a field that holds a bound function value, not a lambda, reads the
// call's result at the pin: a `string` or `f64` result prints as one, and a `??` over it folds
// (D3229).
function h(z) { print(z.f()) }
function c(z) {
  const y = z.f()
  print(y ?? "d")
  print(y == "d")
}
const g0 = () => "s"
const g1 = () => 1.5
h({ k: 0, f: g0 })
h({ k: 0, f: g1 })
c({ k: 0, f: g0 })
