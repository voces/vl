// @run
// @log 3
// @log 4.5
// @log 3
// @log 4
// The annotated spelling of `record-literal-row-per-instance.vl`: a generic record literal
// whose field type is the type parameter, at i32 and at f64.
// Return position.
function wrapX<T>(v: T): {x: T} { x: v }
print(wrapX(3).x)
print(wrapX(4.5).x)

// Built from a callback's result, then bound.
function sumX<T>(self: {x: T}, b: {x: T}, f: (a: T, b: T) => T): {x: T} {
  const o: {x: T} = { x: f(self.x, b.x) }
  return o
}
print(sumX({ x: 1 }, { x: 2 }, (a, b) => a + b).x)
print(sumX({ x: 1.5 }, { x: 2.5 }, (a, b) => a + b).x)
