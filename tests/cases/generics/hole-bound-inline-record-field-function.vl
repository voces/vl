// @run
// @log true
// @log x
// @log 3.5
// @log ok!
// @log 8
// A record literal written at the call binds its field functions at their own types, though
// the row a hole parameter registered first holds `_` there: called through a binding,
// through two levels of capture, and as an operand (D3142, D3147, D3148).
function F(z) {
  const g = z.f
  print(g())
}
F({ f: () => true })
function N(z) {
  const g = z.f
  const k = () => {
    const m = () => g()
    return m()
  }
  print(k())
}
N({ f: () => "x" })
function A(z) {
  const g = z.f
  print(g() + 1.0)
}
A({ f: () => 2.5 })
function S(z) {
  const g = z.f
  print(g() + "!")
}
S({ f: () => "ok" })
function I(z) {
  const g = z.f
  print(g() + 1)
}
I({ f: () => 7 })
