// @run
// @log 10
// @log 0
// @log 10
// @log 10
// D3111: a closure over an un-annotated parameter narrowed by a literal complement (`a is "err"`,
// else arm) captures the narrowed `i32`: from a call's result, from a binding, and annotated.
function orErr(bad: boolean): i32 | "err" {
  if bad { return "err" }
  return 5
}
function takeErr(a) {
  if a is "err" {
    print(0)
  } else {
    const k = () => a * 2
    print(k())
  }
}
function takeErrA(a: i32 | "err") {
  if a is "err" {
    print(0)
  } else {
    const k = () => a * 2
    print(k())
  }
}

takeErr(orErr(false))
takeErr(orErr(true))
const v = orErr(false)
takeErr(v)
takeErrA(orErr(false))
