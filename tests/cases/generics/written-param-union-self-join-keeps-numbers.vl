// @run
// @hint redundant type annotation: `w` is inferred as `A | B | null`
// A written union of type parameters joined with itself keeps two runtime numbers apart at the
// pin: the `null` arm reads back as `null`, not as a cast of the `i32` arm (D3594).
function F<A, B>(k: i32, a: A, b: B) {
  const w: A | B | null = if k == 0 { a } else if k == 1 { b } else { null }
  const v = if k >= 0 { w } else { w }
  print(v)
  print(v is i32)
}
F(0, 4.5, 3)
F(1, 4.5, 3)
F(2, 4.5, 3)
function G<A, B>(k: i32, a: A, b: B) {
  const w: A | B = if k == 0 { a } else { b }
  print(
    match k {
      0 => w
      _ => w
    } is i32,
  )
}
G(1, 4.5, 3)
// @log 4.5
// @log false
// @log 3
// @log true
// @log null
// @log false
// @log true
