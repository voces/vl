// @run
// @log 2
// @log 2
// @log nonerubble
// A body that only stores, returns and compares its `T` keeps a literal-union binding a
// member, so the destination binds it, through a generic it calls too (D4024).
import { filled } from "std:array"

function g<T>(x: T): T { x }
function viaG<T>(x: T): T[] { [g(x)] }
function twiceList<T>(x: T): T[] { [x, x] }
type K = 1 | 2
type D = "none" | "rubble"

const a: K[] = viaG(2)
const b: K[] = twiceList(2)
const d: D[] = filled(2, "none")
d[1] = "rubble"
print(a[0])
print(b[1])
print(d[0] + d[1])
