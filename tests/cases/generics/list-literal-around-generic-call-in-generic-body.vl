// @run
// @log s
// @log 3
// @log 2.5
// @log s
// @log 1
// D2849: inside a generic body, a list literal around another generic's list-returning call is
// re-made per instance, and the re-made literal keeps the type its template was checked at, so
// it builds the list of lists the pin names rather than the `i32` list.
function pc<T>(xs: T[]) { xs }
function k<T>(t: T) {
  const xs = [pc([t])]
  print(xs[0][0])
  0
}
k("s")
k(3)
k(2.5)
function m<T>(t: T) {
  print([pc(["s"])][0][0])
  print([pc([t]), pc([t])].length - 1)
  0
}
m(true)
