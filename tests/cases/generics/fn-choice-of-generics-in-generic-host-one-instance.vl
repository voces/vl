// @run
// @log ss
// @log 3
// A choice between generic functions inside a generic host, instanced once: the members keep
// their own `T`, which the host's same-named `T` does not substitute.
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
const c = [1].length > 0
function f<T>(v: T): T {
  const h = if c { kg } else { idg }
  print(h("s"))
  return v
}
print(f(3))
