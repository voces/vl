// @check
// @error-at 32:3 argument 1: operator '==' is not defined for S and T2 (the body of `eq` applies '==' to this argument)
// @error-at 33:3 argument 1: operator '<' is not defined for S and T2 (the body of `lt` applies '<' to this argument)
// @error-at 34:4 argument 1: operator '+' is not defined for G and H (the body of `add` applies '+' to this argument)
// CONTRACT (must-error): the soundness half of D1747. `nomBinMixes` defers on a HOLE
// operand, because a hole carries no brand yet; the refusal has to reappear at the PIN,
// where both operands are concrete. Two DIFFERENT brands must still be refused at every
// operator the body defers — deferring without the mirror let all three of these RUN.
//
// The diagnosis moves channel deliberately: the body said `cannot compare _ and T2`, naming
// a hole; the pin names both brands and the argument that pinned them.

type S = new string
type T2 = new string
type G = new f64
type H = new f64

const sv: S = "green"
const tv: T2 = "red"
const gv: G = 1.5
const hv: H = 2.5

function eq(a) {
  if a == tv { print("y") } else { print("n") }
}

function lt(a) {
  if a < tv { print("y") } else { print("n") }
}

function add(a) { print(a + hv) }

eq(sv)
lt(sv)
add(gv)
