// @check
// @error cannot assign (T) => T to 'zz' of type boolean (the body of `one` at the call's argument types)
// A generic function handed to a type parameter fits no `boolean` whatever its own parameter
// becomes, so the body's re-check at the call refuses it rather than deferring (D14979).
function id<T>(x: T): T { x }
function one<F>(a: F) {
  const zz: boolean = a
  print(zz)
}
one(id)
