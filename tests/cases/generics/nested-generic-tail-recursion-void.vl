// @run
// @log 7
// @log 0
// @log 7
// @log 7
// @log 7
// @log 8
// A nested generic or hole-parameter function whose tail `if` or `match` recurses in one arm
// and calls a void function in the other is void: its own call yields what its other arms do,
// and only a value arm makes it return one (D3828).
function outer(x: i32) {
  function inner<U>(u: U, n: i32) {
    if n > 0 { inner(u, n - 1) } else { print(x) }
  }
  inner(1, 2)
}
outer(7)
function noCapture() {
  function inner<U>(u: U, n: i32) {
    if n > 0 { inner(u, n - 1) } else { print(n) }
  }
  inner("s", 2)
}
noCapture()
function holeParam(x: i32) {
  function inner(u, n: i32) {
    if n > 0 { inner(u, n - 1) } else { print(x) }
  }
  inner(1, 2)
}
holeParam(7)
function viaMatch(x: i32) {
  function inner<U>(u: U, n: i32) {
    match n {
      0 => print(x)
      _ => inner(u, n - 1)
    }
  }
  inner(true, 2)
}
viaMatch(7)
function valueArm(x: i32) {
  function inner<U>(u: U, n: i32) {
    if n > 0 { inner(u, n - 1) } else { x + n }
  }
  print(inner(1, 2))
  print(inner("s", 0) + 1)
}
valueArm(7)
