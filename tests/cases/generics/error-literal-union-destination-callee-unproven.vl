// @check
// @error cannot assign i32 to 'a' of type K
// @error cannot assign i32 to 'b' of type K
// @error cannot assign i32[] to 'c' of type K[]
// @error cannot assign i32 to 'd' of type K
// @error cannot assign i32 to 'e' of type K
// @error cannot assign i32 to 'f' of type K
// @error cannot assign i32[] to 'g' of type K[]
// @error cannot assign i32 to 'i' of type K
// @error cannot assign i32[] to 'j' of type K[]
// A body calling through anything but a declared function is not proven closed, so a
// literal-union destination does not bind its `T`; `print` and an intrinsic still have their
// arguments read (D4024).
type K = 1 | 2 | 7
function twice<T>(x: T): T { x + x }
const h = twice
function viaLocal<T>(x: T): T {
  const t = twice
  t(x)
}
function viaModuleAlias<T>(x: T): T { h(x) }
function viaLocalInList<T>(x: T): T[] {
  const t = twice
  [t(x)]
}
function app<T>(x: T, f: (T) => T): T { f(x) }
function viaParam<T>(x: T): T { app(x, twice) }
function viaField<T>(x: T): T {
  const ops = { run: twice }
  ops.run(x)
}
function inPrintArg<T>(x: T): T {
  let y = x
  print(y = y * 1000)
  y
}
function inPrintListArg<T>(x: T): T[] {
  const xs: T[] = [x]
  print(xs[0] = xs[0] * 1000)
  xs
}
function inPrintLambda<T>(x: T): T {
  let y = x
  print(
    (() => {
      y = y * 1000
      0
    })(),
  )
  y
}
function inIntrinsicArg<T>(x: T): T[] { __array_new__(1, x * 1000) }
const a: K = viaLocal(7)
const b: K = viaModuleAlias(7)
const c: K[] = viaLocalInList(7)
const d: K = viaParam(7)
const e: K = viaField(7)
const f: K = inPrintArg(7)
const g: K[] = inPrintListArg(7)
const i: K = inPrintLambda(7)
const j: K[] = inIntrinsicArg(7)
print(a)
print(b)
print(c[0])
print(d)
print(e)
print(f)
print(g[0])
print(i)
print(j[0])
