// @run
// @log 6
// @log 3
// A recursive generic alias through a nullable field, instantiated and walked: the instance's
// field refers back to the instance itself, so its struct is keyed by the type, not by a name.
type L<T> = { head: T, tail: L<T> | null }

const c: L<i32> = { head: 3, tail: null }
const b: L<i32> = { head: 2, tail: c }
const a: L<i32> = { head: 1, tail: b }
let s = 0
let n = 0
let cur: L<i32> | null = a
while cur != null {
  s = s + cur.head
  n = n + 1
  cur = cur.tail
}
print(s)
print(n)
