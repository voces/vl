// @emit-error recursive generic type `L<i32>` is not supported
// A recursive GENERIC alias, instantiated. `applyGenAlias` registers an empty
// placeholder under the instance's memo key before it resolves the fields, so the
// self-application lands on its own arena index — the resolved `Ty` is CYCLIC and,
// unlike a recursive declared struct (`recursive-linked-list-sound.vl`, whose index
// carries a NAME), nothing short-circuits a renderer walking it. Every emit renderer
// then descends forever. Before this pin the compiler TRAPPED (`wasm trap: call stack
// exhausted`, from `tyToNominalName`), which tells the user nothing.
type L<T> = { head: T, tail: L<T> | null }

const a: L<i32> = { head: 1, tail: null }
print(a.head)
