// @run
// @log he
// @log 1
// @log 2
// @log 2
// @log 2
// @log 2
// @log he
// @log rec
// @log wo
// A string or list built-in method called on an un-annotated parameter answers the member the
// body demands of it, at each instance: alone, beside a list instance in either order, beside a
// record whose field is a function of that name, and from a closure (D16882).
function str(a) { print(a.slice(0, 2)) }
function idx(a) { print(a.indexOf("b")) }
function len(a) { print(a.slice(0, 2).length) }
function lenRev(a) { print(a.slice(0, 2).length) }
function either(a) { print(a.slice(0, 2)) }
function inClosure(a) {
  const g = () => a.slice(0, 2)
  print(g())
}
str("hello")
idx("abc")
len("hello")
len([1, 2, 3])
lenRev([1, 2, 3])
lenRev("hello")
either("hello")
either({ slice: (x: i32, y: i32) => if x < y { "rec" } else { "cer" } })
inClosure("world")
