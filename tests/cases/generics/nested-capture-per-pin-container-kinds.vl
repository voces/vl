// @run
// @log 2
// @log a
// @log 2
// @log 7
// @log 2
// @log 7.5
// @log 2
// @log 9

// D1781 — the container and string halves of the per-pin nested-capture clone. Each kind is
// decided by its own return-kind classifier, so each one is a separate reader that has to
// resolve the callee through the frame chain rather than the flat name map.

function s(n) {
  function k() { return n }
  return k()
}
print(s(2))
print(s("a"))

function l(n) {
  function k() { return n }
  return k()
}
print(l(2))
print(l([7, 8])[0])

function f(n) {
  function k() { return n }
  return k()
}
print(f(2))
print(f([7.5])[0])

// The anonymous struct pin, which the annotated outer-return face already served; the
// un-annotated one reaches the same row only when the instance reads its own clone.
function t(n) {
  function k() { return n }
  return k()
}
print(t(2))
print(t({ a: 9 }).a)
