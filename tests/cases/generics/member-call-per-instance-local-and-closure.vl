// @run
// @log he
// @log he
// @log fn
// @log fn
// The per-instance pick of built-in, field or `self`-function (D2517) is made on a generic's own
// parameter, on a local that only ever holds it, and inside a closure that reads it: each instance
// clones the closure and picks there (D2520, D16877). Before, the string instance printed `fn`.
function slice(self: boolean | string, a: i32, b: i32) {
  if self == true || a > b { return "fn" }
  return "fn"
}
function viaLocal<T>(x: T) {
  const y = x
  print(y.slice(0, 2))
}
function viaClosure<T>(x: T) {
  const go = () => x.slice(0, 2)
  print(go())
}
viaLocal("hello")
viaClosure("hello")
viaLocal(true)
viaClosure(true)
