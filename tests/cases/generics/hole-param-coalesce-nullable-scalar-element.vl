// @run
// @log 4
// @log 7
// @log 4.25
// @log 0.5
// @log 5000000000
// @log 3
// @log 5
// @log 2
// D3744: a generic body records its `??` at the hole, so the unboxing arm for a nullable scalar
// element read found no result kind and refused, and the dead-default fold for a non-null pin
// compared against the hole too. Both now read the `??` at the instance's pin.
import { toString } from "std:fmt"

function takeI(a) {
  print(a[1] ?? 0)
  print(a[0] ?? 7)
}
function takeF(a) {
  print((a[1] ?? 0.5).toString())
  print((a[0] ?? 0.5).toString())
}
function takeL(a) {
  print((a[1] ?? 0).toString())
  print((a[0] ?? 3).toString())
}
function ret(a) { return a[1] ?? 0 }
function dead(a) { print(a[1] ?? 0) }
const li: (i32 | null)[] = [null, 4]
takeI(li)
const lf: (f64 | null)[] = [null, 4.25]
takeF(lf)
const ll: (i64 | null)[] = [null, 5000000000]
takeL(ll)
print(ret(li) + 1)
const plain = [1, 2]
dead(plain)
