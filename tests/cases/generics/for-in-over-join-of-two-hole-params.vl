// @run
// @log 2
// @log 1
// @log 6
// @log 10
// @log 1
// @log 2
// @log pq
// @log z
// A `for` over a value `if` joining two un-annotated parameters binds each variable to the join of
// their element holes, and each instance walks its own union of lists (D16931).
function g(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  let n = 0
  for e in r { n = n + 1 }
  print(n)
}
const x0: i32[] = [1, 2]
const x1: string[] = ["y"]
g(x0, x1, 0)
g(x0, x1, 1)
function sum(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  let s = 0
  for e in r { s = s + e }
  return s
}
print(sum([1, 2, 3], [10], 0))
print(sum([1, 2, 3], [10], 1))
function idx(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  let last = -1
  for e, i in r { last = i }
  return last
}
print(idx([5, 6], ["a", "b", "c"], 0))
print(idx([5, 6], ["a", "b", "c"], 1))
function cat(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  let out = ""
  for e in r { out = out + e }
  return out
}
print(cat(["p", "q"], ["z"], 0))
print(cat(["p", "q"], ["z"], 1))
