// @run
// @log 2
// @warning Unused variable `dd` (prefix with `_` to suppress, or remove it)
// A record-pattern parameter forwarded to a second record-pattern generic, beside a declared
// record sharing its field names: the argument's spelling is not that record's row (D3145).
import { toString } from "std:fmt"

type D = { m: string, n: i32 }
const dd: D = { m: "dm", n: 8 }
function g<T>(b: { m: T, n: i32 }): T { b.m }
function k<T>(b: { m: T, n: i32 }): T { g(b) }
const e = k({ m: { x: 1, y: 2 }, n: 2 })
print(toString(e.y))
