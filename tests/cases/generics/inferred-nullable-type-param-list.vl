// @run
// @log 6
// @log true
// @log 1.5
// @log true
// @log true
// @hint redundant type annotation: `q` is inferred as `(i32 | null)[]` — remove it to lean on inference
// D2533: an un-annotated generic returning `[x, null]` types its result `(V | null)[]` at every
// instance, so the `null` element is a value the caller can test for.
function pair<V>(x: V) { [x, null] }
print((pair(5)[0] ?? 0) + 1)
print(pair(5)[1] == null)
print(pair(1.5)[0] ?? 0.0)
print(pair(true)[1] == null)
const q: (i32 | null)[] = pair(5)
print(q[1] == null)
