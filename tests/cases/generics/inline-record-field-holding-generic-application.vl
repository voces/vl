// @run
// An inline record type whose field is a generic application (`{ q: B<i32> }`), nested in a
// declared record, a union arm or a generic alias, has a struct-field rep at every delivery
// position (D4556).
type B<T> = { v: T }
type Obj = { inner: { q: B<i32>, r: i32 }, s: i32 }
type N = { inner: { q: B<string> | null, t: i32 } | null }
type G<T> = { inner: { q: B<T>, r: i32 }, s: i32 }
type U = { kind: "a", inner: { q: B<i32> } } | { kind: "b", q: B<i32> }
function arg(o: Obj) { return o.inner.q.v + o.inner.r }
function ret(n: i32): Obj { return { inner: { q: { v: n }, r: 2 }, s: 3 } }
function get<T>(g: G<T>): T { return g.inner.q.v }
function un(u: U) {
  if (u.kind == "a") { return u.inner.q.v }
  return u.q.v
}
// binding
const o: Obj = { inner: { q: { v: 1 }, r: 2 }, s: 3 }
print(o.inner.q.v)
// argument and return
print(arg({ inner: { q: { v: 40 }, r: 2 }, s: 3 }))
print(ret(7).inner.q.v)
// field writes, whole record, nested record and leaf
o.inner = { q: { v: 9 }, r: 4 }
o.inner.q = { v: 11 }
o.inner.q.v = o.inner.q.v + 1
print(o.inner.q.v)
// list element
const xs = [o, ret(5)]
xs.push({ inner: { q: { v: 8 }, r: 0 }, s: 0 })
print(xs[0].inner.q.v + xs[1].inner.q.v + xs[2].inner.q.v)
// un-annotated bindings read through the declared return
const k = ret(3)
const ki = k.inner
const kq = ki.q
print(kq.v)
// nullable at both levels
const n: N = { inner: { q: { v: "nul" }, t: 1 } }
const ni = n.inner
if (ni != null) {
  const nq = ni.q
  if (nq != null) { print(nq.v) }
}
// a generic alias owning the inline record, at two pins
const ga: G<string> = { inner: { q: { v: "hi" }, r: 2 }, s: 3 }
const gb: G<i32> = { inner: { q: { v: 4 }, r: 2 }, s: 3 }
print(get(ga))
print(get(gb))
// union arms: the inline record, and the application directly
print(un({ kind: "a", inner: { q: { v: 6 } } }))
print(un({ kind: "b", q: { v: 13 } }))
// @log 1
// @log 42
// @log 7
// @log 12
// @log 25
// @log 3
// @log nul
// @log hi
// @log 4
// @log 6
// @log 13
