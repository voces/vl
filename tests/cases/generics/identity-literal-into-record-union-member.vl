// @run
// @log 4
// @log 6
// @log 7
// D8021: an object literal handed through a generic identity into a union holding a wider
// record is built as that member, and the identity's instance is taken at the member's row.
// Binding, argument and list-element deliveries each print the widened field.
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
function take(u: J | string) {
  if u is J { print(u.r ?? 0) } else { print(u) }
}

const v: J | string = idn({ r: 4 })
if v is J { print(v.r ?? 0) }
take(idn({ r: 6 }))
const xs: (J | string)[] = [idn({ r: 7 }), "s"]
const x0 = xs[0]
if x0 is J { print(x0.r ?? 0) }
