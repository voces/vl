// @run
// @log 1
// @log 2
// A generic whose `??` default is an `i32` list, called from inside another generic, runs at an
// `i32` instance (D16946): the join is one list there.
function pc<T>(xs: T[] | null) { return xs ?? [1] }
function p<T>(t: T, c: boolean) {
  let a: T[] | null = null
  if c { a = [t, t] }
  return pc(a)
}
print(p(3, false).length)
print(p(3, true).length)
