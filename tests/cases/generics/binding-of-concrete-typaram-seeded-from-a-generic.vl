// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log 3
// @log 101
// @log 6
// A binding annotated with a type parameter bound to a concrete function, seeded from another
// parameter, calls the function it was seeded with, never the one its annotation's parameter holds.
function plus100(k: i32) { return k + 100 }
function other<T>(k: T): T { return k }
function twice(k: i32) { return k * 2 }
function mid<F, G>(_a: F, a1: G) {
  const b: F = a1
  print(b(3))
}
mid(plus100, other)
function mid2<F, G>(a: F, a1: G) {
  const b: F = a1
  print(a(1))
  print(b(3))
}
mid2(plus100, twice)
