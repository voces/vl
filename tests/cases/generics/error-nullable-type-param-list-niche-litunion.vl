// @emit-error a nullable-K list element has no rep; use a non-null element type
// D2525's remaining boundary: a `(T | null)[]` over a type parameter bound to a literal union
// is a niche the instance would read at the template's rep, so it must not build.
type K = "a" | "b"
function f<T>(x: T): (T | null)[] { [x, null] }
const k: K = "a"
print(f(k).length)
