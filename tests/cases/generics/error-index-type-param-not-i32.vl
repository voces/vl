// @check
// @error array index must be i32, got i64 (the call's argument types)
// @error array index must be i32, got f64 (the call's argument types)
// @error array index must be i32, got string (the call's argument types)
// A list index whose type is a type parameter is held, at each call, to the rule the direct
// spelling `s[x]` with `x: i64` already gets (D3584): an `i32` instance runs, any other is a
// check error at the call rather than an invalid module.
function at<T>(x: T) {
  const s = ["a", "b", "c"]
  return s[x]
}

print(at(1))
print(at<i64>(1))
print(at(1.5))
print(at("q"))
