// @run
// @log null
// @log true
// @log null
// @log true
// @log 2.5
// @log true
// @log null
// D14200: an explicit `T[]` parameter bound by an inferred `[null, true]` pins at the
// argument's closed `(boolean | null)[]`, so its elements print as the booleans and null.
function g<T>(x: T[]) {
  print(x[0])
  print(x[1])
}
function k<T>(x: T[]): T { return x[1] }
const v = [null, true]
g(v)
g([null, true])
const w = [null, 2.5]
print(k(w))
const u = [true, null]
g(u)
