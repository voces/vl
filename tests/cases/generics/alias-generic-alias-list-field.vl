// @run
// @log 3
// @log 4
// @log 6
// @log w
// @log 15
// @log r
// @log 0
// D11451: a generic alias whose field is a list of a second generic alias applied to its
// parameter has a list rep, with or without a generic function, delivered as a literal, a
// binding, a return or a push; the alias's own field is not refused as a non-i32 list.
type I<U> = { g: U }
type B<U> = { s: I<U>[] }
type Unused<U> = { s: I<U>[], t: { g: U }[] }

function f(v: B<i32>) { v.s[0].g }
function f1(v: B<i32>) { v.s[1].g }
function h<T>(v: B<T>): T { v.s[0].g }
function mk(): B<string> { { s: [{ g: "r" }] } }

print(f({ s: [{ g: 3 }] }))
const a = { s: [{ g: 3 }, { g: 4 }] }
print(f1(a))
print(f1({ s: [{ g: 5 }, { g: 6 }] }))
print(h({ s: [{ g: "w" }] }))
const x: B<i32> = { s: [{ g: 10 }, { g: 11 }] }
x.s.push({ g: 12 })
print(x.s[2].g + x.s.length)
print(mk().s[0].g)
print(0)
