// @run
// @log 1
// @log 1
// @log 1
// @log 0
// A `.push` through an instance's `is Q[]` arm over an empty list of another record pushes onto
// the arm's own `Q[]`, whose push frame is reserved at that row (D4962, D4934).
type P = { x: i32 }
type Q = { y: string }
function g<V>(a: V[]) {
  const q: V[] = []
  if q is Q[] {
    q.push({ y: "hi" })
    print(q.length)
  }
  print(a.length)
}
const ps: P[] = [{ x: 1 }]
g(ps)
const none: P[] = []
g(none)
