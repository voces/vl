// @run
// @log 6
// @log 7
// BOTH spellings of `is Box<i32>` in ONE program — the load-bearing guard on the `IsExpr`
// rewrite's gate, and the only shape that can fail it.
//
// The declared-union operand takes the structural rewrite: `type UBoth = Box<i32> | Tag` is
// canonicalized to `{v:i32} | Tag`, so the tested name must follow or the emitter resolves no
// variant. The NULLABLE operand must NOT: `b: Box<i32> | null` carries no `UnionDecl`, its
// annotation keeps the application NAME, `nullablePartOf` peels straight to it, and the gae
// registry has interned the instance from that very `TypeRef` — `is Box<i32>` already resolves
// there on master. An UNGATED rewrite compiles `viaUnion` and breaks `viaNullable`, and only a
// program holding both can tell.
//
// The gate reads the OPERAND's checked type off the typed-IR bank (`nodeTyIx`) and fires only
// for a `TyUnion`, which is exactly the population whose `UnionDecl` variants were rewritten.
type Box<T> = { v: T }
type Tag = { t: i32 }
type UBoth = Box<i32> | Tag

function viaUnion(u: UBoth) {
  if u is Box<i32> { print(u.v) }
}
function viaNullable(b: Box<i32> | null) {
  if b is Box<i32> { print(b.v) }
}
viaUnion({ v: 6 })
viaNullable({ v: 7 })
viaNullable(null)
