// A value `if` or `??` in a generic body joins at each pin from its arms' pinned types: an arm
// narrowed by `is` is the parameter's pin (D2904), and a literal of another type beside the
// parameter makes the join a union there (D2893, D2787).
function narrowed<T>(a: T, b: T) {
  const r = if a is string { b } else { a }
  print(r)
}
narrowed(true, false)
function lit<T>(t: T, c: boolean) {
  const u = if c { t } else { 5 }
  print(u)
}
lit(true, true)
lit(true, false)
lit("x", true)
lit("x", false)
function litFirst<T>(t: T, c: boolean) { print(if c { 5 } else { t }) }
litFirst(7, false)
function litStr<T>(t: T, c: boolean) {
  const u = if c { t } else { "s" }
  print(u)
}
litStr(3, false)
function chain<T>(a: T, b: T, c: boolean) {
  const r = if c { a } else if b == a { b } else { 5 }
  print(r)
}
chain(true, false, false)
chain(true, false, true)
function coal<T>(t: T | null, d: f64) {
  const u = t ?? d
  print(u)
}
const none: string | null = null
coal(none, 2.5)
function two<A, B>(a: A, b: B, k: boolean) {
  const r = if k { a } else { b }
  print(r)
}
two(1, "s", false)
two(1, "b", true)
function g<T, U>(t: T, u: U | string, c: boolean) {
  const r = if c { t } else { u }
  print(r)
}
g(7, "zz", false)
g(7, 2.5, false)
g("a", true, true)
g(2.5, 9, true)
function h<T, U>(t: T, u: U | null) {
  const r = u ?? t
  print(r)
}
h(7, 3)
h("x", null)
h("x", "y")
function eq<T>(a: T, c: boolean) {
  const r = if c { a } else { false }
  print(r == a)
}
eq(true, true)
eq(true, false)
