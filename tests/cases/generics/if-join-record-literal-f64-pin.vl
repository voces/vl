// @run
// @log 1
// @log 2.5
// @log 2.5
// @log 1
// @log 1
// @log 2.5
// @log 2.5
// @log 1
// A generic if-join of a record literal and a record over a type parameter builds, at each pin,
// the row that instance's join names, in either arm order and with or without an annotation:
// at `T := f64` the literal's `1` is the `f64` field the join stores (D14001).
function lit<T>(t: T, b: boolean) {
  const v = if b { { f: 1 } } else { { f: t } }
  print(v.f)
}
function litLast<T>(t: T, b: boolean) {
  const v = if b { { f: t } } else { { f: 1 } }
  print(v.f)
}
function ann<T>(t: T, b: boolean) {
  const v: {f: T} = if b { { f: 1 } } else { { f: t } }
  print(v.f)
}
function annLast<T>(t: T, b: boolean) {
  const v: {f: T} = if b { { f: t } } else { { f: 1 } }
  print(v.f)
}
lit(2.5, true)
lit(2.5, false)
litLast(2.5, true)
litLast(2.5, false)
ann(2.5, true)
ann(2.5, false)
annLast(2.5, true)
annLast(2.5, false)
