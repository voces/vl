// @run
// @log 4
// @log 9
// D14303: `n is Tag` over an inline union with a generic-application member tests the box tag
// rather than folding false. With no declared alias naming `Box<i32>` as an arm, the null-peeled
// `Box<i32> | null` beside it stays a plain struct read.
type Box<T> = { v: T }
type Tag = { t: i32 }

const n: Box<i32> | Tag = { t: 4 }
if n is Tag { print(n.t) }
let o: Box<i32> | null = null
o = { v: 9 }
if o != null { print(o.v) }
