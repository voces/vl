// @run
// @hint Intentionally-unused parameter `_c` (leading `_` marks it unused)
// @hint redundant type annotation: `r` is inferred as `i32` — remove it to lean on inference
// @log 4
// @log 6
// @log 4
// @log 6
// A call's result holding un-annotated functions, handed straight to a generic `(x: T) => R`
// parameter, binds `T` from the closed argument and `R` from the functions' result there
// (D16099).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function app<T, R>(g: (x: T) => R, v: T): R { return g(v) }
function pick1(_c: boolean) { return inc }
function pick2(c: boolean) { return if c { dbl } else { inc } }
print(app(pick1(true), 3))
print(app(pick2(true), 3))
print(app(pick2(false), 3))
const r: i32 = app(pick2(true), 3)
print(r)
