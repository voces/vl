// @run
// @log ss
// @log ss
// @log ss
// @log ss
// @log ss
// @log ss
// @log 3
// @log ss
// @log true
// A choice of generic functions called inside a generic body whose type parameter has the
// callees' name: bound, matched, inline, handed to a generic and to `.map`, two levels deep and
// in a body instanced twice (D9160).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function ku<U>(t: U): U { return t + t }
function ap<T>(g: (x: T) => T, x: T): T { return g(x) }
const c = [1].length > 0
const n = [1].length
function bound<T>(v: T): T {
  const h = if c { kg } else { idg }
  print(h("s"))
  return v
}
function matched<T>(v: T): T {
  const h = match n {
    1 => kg
    _ => idg
  }
  print(h("s"))
  return v
}
function inline<T>(v: T): T {
  print((if c { ku } else { idg })("s"))
  return v
}
function handed<T>(v: T): T {
  print(ap(if c { kg } else { idg }, "s"))
  print(["s"].map(if c { kg } else { idg })[0])
  return v
}
function deep<T>(v: T): T { return bound(v) }
matched(1)
inline(1)
handed(1)
deep(1)
print(bound(3))
print(bound(true))
