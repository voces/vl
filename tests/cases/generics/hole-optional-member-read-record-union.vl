// @run
// @log 3
// @log -1
// @log 4
// @log -1
// @log 3
// @log -1
// @log s
// @log d
// @log 3
// @log -1
// @log 9
// @log 4
// @log -1
// @log 5
// D13080: `?.` on a hole receiver an instance pins at a union of records reads the shared field
// at each pin: in a `??` operand, a binding, an argument, a return, through a field, from an
// inferred union, and with a pin that bears no null.
type A = { k: i32, x: i32 }
type B = { k: i32, y: string }
function F(u) { print(u?.k ?? -1) }
const a: A | B | null = { k: 3, x: 1 }
const b: A | B | null = null
F(a)
F(b)

function mk(i: i32) {
  if i == 0 { return null }
  const r: B = { k: 4, y: "q" }
  return r
}
function H(u) {
  const r = u?.k
  print(r ?? -1)
}
H(mk(1))
H(mk(0))

function G(v: i32 | null) { print(v ?? -1) }
function J(u) { G(u?.k) }
J(a)
J(b)

type C = { s: string, x: i32 }
type D = { s: string, y: string }
function K(u) { return u?.s }
const c: C | D | null = { s: "s", x: 1 }
const n: C | D | null = null
print(K(c) ?? "d")
print(K(n) ?? "d")

type W = { u: A | B | null }
function L(w) { print(w.u?.k ?? -1) }
const w1: W = { u: { k: 3, x: 1 } }
const w0: W = { u: null }
L(w1)
L(w0)

const d: A | B = { k: 9, y: "w" }
F(d)

type E = { k: i32, z: boolean }
function M(u) { return u?.k ?? -1 }
const xs: (A | B | E | null)[] = [{ k: 4, y: "p" }, null, { k: 5, z: true }]
for x in xs { print(M(x)) }
