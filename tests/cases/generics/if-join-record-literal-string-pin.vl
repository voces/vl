// @run
// @log 1
// @log s
// @log s
// @log 1
// @log 1
// @log s
// A generic if-join of `{f: 1}` and `{f: t}` at `T := string` reads its field as the instance's
// `i32 | string`, in either arm order and through an alias, not as the template's `T` (D14021).
function g<T>(t: T, b: boolean) {
  const v = if b { { f: 1 } } else { { f: t } }
  print(v.f)
}
function h<T>(t: T, b: boolean) {
  const v = if b { { f: t } } else { { f: 1 } }
  print(v.f)
}
function k<T>(t: T, b: boolean) {
  const v = if b { { f: 1 } } else { { f: t } }
  const w = v
  const x: i32 | T = w.f
  print(x)
}
g("s", true)
g("s", false)
h("s", true)
h("s", false)
k("s", true)
k("s", false)
