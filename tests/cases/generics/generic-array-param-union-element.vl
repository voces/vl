// @run
// @log 5
// @log 7
// @log 10
// @log 11
// @log 2
// @log 13
// @hint redundant type annotation: `ns` is inferred as `i32[]`
// @hint redundant type annotation: `pair` is inferred as `({r: i32} | {s: i32})[]`
// A generic `T[]` parameter applied at a UNION-element list. `monoAnnPinName`'s union-alias
// arm had only its BARE rung — `isUName(name)` — and no LIST complement, so `Shape[]` was
// claimed by nothing: the cascade's `"i32"` catch-all answered and the binding rung asked
// `nameIsArray("i32")`. The message, `monomorphize: expected an array argument for `xs``,
// was false about an argument the checker had already proved is an array of the right
// element (D1082).
//
// THE THIRD INSTANCE of that shape in this one ladder: the union-ARM rung below it and the
// struct pair in `monoStructAnnName` each have both rungs, and each header says so.
//
// One hole, TWO messages: `expected an array argument` at a local, a second instance and a
// `T[]`-returning generic; `unsupported argument type` at module scope and at a `Shape[]`
// PARAMETER forwarded in. The pin is the caller's OWN spelling, and the safety property is
// measured rather than argued — the identical program through a non-generic
// `firstS(xs: Shape[]): Shape` runs, at a nominal struct union and at a value union alike.
type Circle = { r: i32 }
type Square = { s: i32 }
type Shape = Circle | Square
type Val = i32 | string

function first<T>(xs: T[]): T { return xs[0] }
function idList<T>(xs: T[]): T[] { return xs }
function count<T>(xs: T[]) { return xs.length }

function localBinding() {
  const xs: Shape[] = [{ r: 5 }]
  const f = first(xs)
  if f is Circle { return f.r }
  return 0
}

function valueUnionElement() {
  const xs: Val[] = [7]
  const v = first(xs)
  if v is i32 { return v }
  return 0
}

// TWO INSTANCES of one generic in one function — the union-element pin must not disturb the
// i32 one beside it.
function twoInstances() {
  const xs: Shape[] = [{ r: 6 }]
  const ns: i32[] = [4]
  const f = first(xs)
  const n = first(ns)
  if f is Circle { return f.r + n }
  return 0
}

function throughReturn() {
  const xs: Shape[] = [{ r: 11 }]
  const ys = idList(xs)
  const f = ys[0]
  if f is Circle { return f.r }
  return 0
}

// A `Shape[]` PARAMETER forwarded into the generic — the `unsupported argument type` half.
function forwarded(xs: Shape[]) { return count(xs) }

// MODULE SCOPE, the other half of that message.
const modXs: Shape[] = [{ r: 13 }]
const modFirst = first(modXs)

print(localBinding())
print(valueUnionElement())
print(twoInstances())
print(throughReturn())

const pair: Shape[] = [{ r: 1 }, { s: 2 }]
print(forwarded(pair))

if modFirst is Circle { print(modFirst.r) }
