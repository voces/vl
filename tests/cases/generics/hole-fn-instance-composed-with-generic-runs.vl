// @run
// @log a
// @log 5
// @log 7
// A hole function whose only instance is at `string`, composed after a generic handed only to an
// open slot: `compose`'s parameters take `gid`'s type variable at the unbound default, so the call
// is built at `i32` and runs (D16562, D16493).
function hid(x) { return x }
function gid<A>(x: A): A { return x }
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
function compose<A, B, C>(f: (x: A) => B, g: (x: B) => C): (x: A) => C {
  return (x: A) => g(f(x))
}
print(hid("a"))
print(compose(gid, hid)(5))
print(app(gid, 7))
