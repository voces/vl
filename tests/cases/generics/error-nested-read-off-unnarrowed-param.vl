// @error no field 'foo' on {bar: i32} (the body of `a` at the call's argument types)
// A nested field read off a type parameter is re-asked at the call's argument types (D1433).
// `nested-read-off-param-per-pin.vl` is the neighbour that runs.
function a<T>(x: T): i32 { x.inner.foo }
print(a({ inner: { bar: 1 } }))
