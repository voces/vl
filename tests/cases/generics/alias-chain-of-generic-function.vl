// @run
// @info `f` is never reassigned; use `const` instead of `let`
// @info `h` is never reassigned; use `const` instead of `let`
// @log s
// @log s
// @log 3
// @log 1.5
// @log t
// @log 4
// @log 5
// @log 7
// @log 2
// @log s
// @log 2
// @log 6
// A chain of un-annotated aliases that ends at a generic function by name calls it, nested or at
// top level, from a function, and in an enclosing generic instantiated twice (D3894).
function b0<U>(y: U): U { y }
const tf = b0
const th = tf
function viaTop() { print(th(5)) }
function a<T>(x: T) {
  function b<U>(y: U): U { y }
  const f = b
  const h = f
  print(h(x))
}
a("s")
function three<T>(x: T) {
  function b<U>(y: U): U { y }
  const f = b
  const g = f
  const h = g
  print(h(x))
  print(h(3))
}
three("s")
function viaLet<T>(x: T) {
  function b<U>(y: U): U { y }
  let f = b
  let h = f
  print(h(x))
}
viaLet(1.5)
print(th("t"))
print(th(4))
viaTop()
function captures<T>(x: T) {
  function inner<U>(u: U) {
    print(x)
    print(u)
  }
  const k = inner
  const j = k
  j(2)
}
captures(7)
captures("s")
function triple<T>(x: T) { print(x * 3) }
const tc = triple
const viaLambda = () => {
  const v = tc
  v(2)
}
viaLambda()
