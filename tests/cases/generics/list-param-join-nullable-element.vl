// @run
// @log null
// @log null
// @log null
// @log s
// @log null
// @log 4
// An element read out of a join of two list parameters `T[]`/`U[]` at a nullable pin, bound,
// printed in place and returned, with `null` and a value at each pin (D3357).
function bound<T, U>(a: T[], b: U[], k: i32) {
  const r = if k == 0 { a } else { b }
  const e = r[0]
  print(e)
}
function inPlace<T, U>(a: T[], b: U[], k: i32) {
  const r = if k == 0 { a } else { b }
  print(r[0])
}
function ret<T, U>(a: T[], b: U[], k: i32): T | U {
  const r = if k == 0 { a } else { b }
  return r[0]
}
const xb: string | null = null
const xs: string | null = "s"
bound([xs], [xb], 1)
inPlace([xs], [xb], 1)
print(ret([xs], [xb], 1))
print(ret([xs], [xb], 0))
const xi: i32 | null = null
const xj: i32 | null = 4
bound([xj], [xi], 1)
bound([xj], [xi], 0)
