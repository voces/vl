// @check
// @error cannot assign i32[] to 'scaledUp' of type (5 | 6)[]
// @error cannot assign i32 to 'k' of type K
// @error cannot assign i32 to 'kn' of type K | null
// @error cannot assign i32[] to 'nested' of type K[]
// @error cannot assign string[] to 'mixed' of type M[]
// A literal union binds a type parameter from the destination only when the body makes no new
// value of it: arithmetic on `T` here, directly or in a generic it calls, could leave the
// union (D3602), so each call keeps its arguments' binding and refuses at the destination. A
// union mixing literal kinds has no one scalar rep, so it is never bound either.
function scaled<T>(x: T): T[] { [x * 1000000] }
function twice<T>(x: T): T { x + x }
function viaTwice<T>(x: T): T[] { [twice(x)] }
function mk<T>(x: T): T[] { [x] }
type K = 1 | 2 | 7
type M = 1 | "a"

const scaledUp: (5 | 6)[] = scaled(5)
const k: K = twice(7)
const kn: K | null = twice(7)
const nested: K[] = viaTwice(2)
const mixed: M[] = mk("a")
print(scaledUp.length + nested.length + mixed.length)
print(k)
print(kn ?? 0)
