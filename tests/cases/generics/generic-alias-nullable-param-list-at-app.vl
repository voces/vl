// @run
// @log 2
// @log 11
// @log true
// @log 16
// @log a
// @log 1
// D12452: a generic record's `(V | null)[]` field applied at a generic record application
// (`Bx<GB<i32>>`) builds, reads, pushes and iterates its nullable elements, at two instances
// and from a function's return.
type GB<T> = { v: T }
type Bx<V> = { xs: (V | null)[], n: i32 }
const bx: Bx<GB<i32>> = { xs: [null, { v: 11 }], n: 1 }
print(bx.xs.length)
const e = bx.xs[1]
if e != null { print(e.v) }
print(bx.xs[0] == null)
bx.xs.push({ v: 5 })
bx.xs.push(null)
let s = 0
for x in bx.xs { if x != null { s = s + x.v } }
print(s)
const by: Bx<GB<string>> = { xs: [{ v: "a" }, null], n: 2 }
const f = by.xs[0]
if f != null { print(f.v) }
function mk(): Bx<GB<i32>> { { xs: [null], n: 9 } }
print(mk().xs.length)
