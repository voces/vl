// @run
// @log 1
// @log x
// @log 3.5
// @log 30
// @log b
// A RECURSIVE generic used at more than one shape. `emit_mono.vl`'s header called this out as a
// hypothetical ("clones SHARE the original's body arena nodes, so a RECURSIVE generic used at
// multiple shapes would mis-resolve its self-call (none exists in the corpus)") — it was in fact
// LIVE: `rec(a, 2)` alone printed `1`, and adding `rec(b, 2)` at a second element type emitted an
// invalid module. Instances are registered BEFORE their body is walked, so the self-call is a
// registry HIT — which renames the callee `Ident` to that instance's name. Sharing that `Ident`
// across instances made the last shape's rename win for all of them.
//
// A self-call is just the case where the generic callee IS the enclosing declaration, so the
// per-instance generic-call spine that fixes a nested call to a DIFFERENT generic covers it too.

function rec<T>(xs: T[], i: i32): T {
  if i <= 0 { return xs[0] }
  return rec(xs, i - 1)
}

// Mutual recursion between two generics, each instantiated at two shapes.
function evenStep<T>(xs: T[], i: i32): T {
  if i <= 0 { return xs[xs.length - 1] }
  return oddStep(xs, i - 1)
}
function oddStep<T>(xs: T[], i: i32): T {
  if i <= 0 { return xs[0] }
  return evenStep(xs, i - 1)
}

const a: i32[] = [1, 2]
const b: string[] = ["x", "y"]
const c: f64[] = [3.5, 4.5]

print(rec(a, 2)) // 1
print(rec(b, 2)) // x
print(rec(c, 2)) // 3.5

const m: i32[] = [10, 20, 30]
const n: string[] = ["a", "b"]
print(evenStep(m, 2)) // 30
print(evenStep(n, 2)) // b
