// @run
// @log b
// @log 1
// @log b
// @log 2
// A join of two different declared type parameters is their union: `if k { [a] } else { [b] }`
// is `A[] | B[]`, not `A[]` (D2760). A type variable is assignable either way inside a generic
// body, so the join collapsed to one side, and an instance binding the two apart was refused as
// a return mismatch the program never had, or read one side's list as the other's.
function w<A, B>(a: A, b: B, k: boolean): A[] | B[] {
  if k { [a] } else { [b] }
}
function j<A, B>(a: A, b: B, k: boolean) {
  const x = a
  const y = b
  if k { x } else { y }
}
const r = w(1, "b", false)
if r is string[] { print(r[0]) } else { print(r[0]) }
const q = w(1, "b", true)
if q is string[] { print(q[0]) } else { print(q[0]) }
const v = j(1, "b", false)
if v is string { print(v) } else { print(v + 1) }
const u = j(1, "b", true)
if u is string { print(u) } else { print(u + 1) }
