// A generic function stored into a slot whose type names T through a parameter, an inferred
// local or a map value, each read back after the store, at two instances (D3916).
function b<U>(y: U) { print(y) }
function c<U>(y: U) { print("c"); print(y) }
function st<T>(fs: ((t: T) => void)[], gs: ((t: T) => void)[][], x: T) {
  fs[0] = c
  fs[0](x)
  fs.push(b)
  fs[1](x)
  gs[0][0] = c
  gs[0][0](x)
}
function a<T>(x: T) {
  const fs = [(t: T) => print(t)]
  fs[0] = c
  fs[0](x)
  const r = { f: (t: T) => print(t) }
  r.f = b
  r.f(x)
  const m: Map<string, (t: T) => void> = Map()
  m.set("k", b)
  m["k"] = c
  const g = m.get("k")
  if g != null { g(x) }
}
st([(t: boolean) => print(t)], [[(t: boolean) => print(t)]], false)
st([(t: string) => print(t)], [[(t: string) => print(t)]], "s")
a(false)
a("s")
