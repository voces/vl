// @run
// @log 3
// @log s
// @log 4
// @log t
// One declared generic handed to two hole parameters, each called with `null` at its own
// instance, runs each call at the instance whose parameters accept `null` (D14582).
function orz<T>(v: T | null, d: T): T { v ?? d }
function viaOrz(a, b) {
  print(a(null, 3))
  print(b(null, "s"))
}
viaOrz(orz, orz)
function viaBoth(a, b) {
  print(a(4, 3))
  print(b("t", "u"))
}
viaBoth(orz, orz)
