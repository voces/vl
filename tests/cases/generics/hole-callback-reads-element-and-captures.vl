// @run
// @log a
// @log b
// @log 3.5
// @log t
// @log 1
// @log null
// @log 7
// @warning Unused parameter `e`
// A hole function's `.filter` or `.map` callback is typed at the receiver's pin, whether it
// reads its element, captures a parameter, or both, at a non-`i32` list and a nullable one; the
// template the instances replaced is not emitted (D3067, D3083, D2930).
function keep(h, z) { return h.filter((e) => e != z) }
const b = ["a", "b"]
print(keep(b, "b")[0])
function drop(h) { return h.filter((e) => e != "a") }
print(drop(b)[0])
function to(h, z) { return h.map((e) => z) }
const fs = [1.5, 2.5]
print(to(fs, 3.5)[0])
print(to(b, "t")[1])
function nul(x) {
  const l0 = [x]
  const m0 = l0.filter((e) => e == e)
  const y = m0[0]
  if y == null { print("null") } else { print(y) }
}
const one: i32 | null = 1
nul(one)
const none: i32 | null = null
nul(none)
const ints = [7, 8]
print(keep(ints, 8)[0])
