// @run
// @hint redundant type annotation: `v` is inferred as `A | B | null`
// An annotated `A | B | null` read through `??` is read at the pin, where both parameters can
// bind one type and the result is that type rather than the box (D3528).
function F<A, B>(k: i32, a: A, b: B) {
  const v: A | B | null = if k == 0 { a } else if k == 1 { b } else { null }
  print((v ?? 9) is i32)
  print(v ?? 9)
}
F(2, 3, 3)
F(0, 3, 3)
function S<A, B>(k: i32, a: A, b: B) {
  const v: A | B | null = if k == 0 { a } else if k == 1 { b } else { null }
  print(v ?? "z")
}
S(2, "s", "t")
S(1, "s", "t")
function W<A, B>(k: i32, a: A, b: B) {
  const v: A | B | null = if k == 0 { null } else if k == 1 { a } else { b }
  print((v ?? 0) == 3)
  print(3 != (v ?? 0))
  print((v ?? 0) + 1 == 3.5)
}
W(0, 2.5, 4.5)
W(1, 2.5, 4.5)
W(1, 3, 4)
// @log true
// @log 9
// @log true
// @log 3
// @log z
// @log t
// @log false
// @log true
// @log false
// @log false
// @log true
// @log true
// @log true
// @log false
// @log false
