// @run
// @log 2
// @log 3
// @log 2
// @log ab!
// @log 2
// @log 2
// @log 11
// @log 6
// @log 2
// @log 5
// A hole function, a declared generic, a `const` lambda or a lambda written in place, handed by a
// hole parameter's call to another hole function, is delivered at the type that function's body
// calls it with, and the call's result is that instance's (D6532).
function id(a) { return a }
function idT<T>(a: T): T { return a }
const idL = (a) => a
function lap(g) { return g(1) + 1 }
function lapLen(g) { return g("abc").length }
function lapS(g) { return g("ab") + "!" }
const lapC = (g) => g(1) + 1
function lapF(g) { return g(1.5) * 2.0 }
function use(k) { return k(id) }
function useT(k) { return k(idT) }
function useL(k) { return k(idL) }
function useLam(k) { return k((a) => a * 10) }
function useLamF(k) { return k((a) => a + 1.5) }
print(use(lap))
print(use(lapLen))
print(useT(lap))
print(useT(lapS))
print(useL(lap))
print(use(lapC))
print(useLam(lap))
print(useLamF(lapF))
const lapB = (g) => {
  print(g(1) + 1)
  return g(5)
}
print(use(lapB))
