// @run
// @log false
// @log true
// @log not int
// @log true
// @log false
// @log int
// @log true
// @log false
// @log int
// @log false
// @log false
// @log B
// @log true
// @log A
// @log false
// @log e
// @log false
// @log 1
// @log not A
// @log true
// @log 5
// @log s
// An `is` over a bounded parameter's field answers per pin: false where the pin's field cannot
// match, true where it is the tested record or list, over a scalar, record or list arm (D15608, D15629).
function boundShow<T: { x: i32 | string }>(t: T) {
  print(t.x is i32)
  const y = t.x is string
  print(y)
  if t.x is i32 { print("int") } else { print("not int") }
}
const b: { x: string } = { x: "s" }
boundShow(b)
const c: { x: i32 } = { x: 3 }
boundShow(c)
const d: { x: i32 | string } = { x: 3 }
boundShow(d)
function plain(v: i32 | string) { print(v is i32) }
plain("q")
type A = { a: i32 }
type B = { b: string }
function rec<T: { x: A | B }>(t: T) {
  print(t.x is A)
  if t.x is A { print("A") } else { print("B") }
}
const rb: { x: B } = { x: { b: "q" } }
rec(rb)
const ra: { x: A } = { x: { a: 1 } }
rec(ra)
function lst<T: { x: i32[] | string }>(t: T) { print(t.x is i32[]) }
const ls: { x: string } = { x: "q" }
lst(ls)
function eff<T: { x: i32 | string }>(t: T): T {
  print("e")
  t
}
function viaCall<T: { x: i32 | string }>(t: T) { print(eff(t).x is i32) }
viaCall(ls)
function recArm<T: { x: A | B }>(t: T) {
  if t.x is A { print(t.x.a) } else { print("not A") }
}
recArm(ra)
recArm(rb)
const ll: { x: i32[] } = { x: [5] }
lst(ll)
function lstArm<T: { x: i32[] | string }>(t: T) {
  if t.x is i32[] { print(t.x[0]) } else { print("s") }
}
lstArm(ll)
lstArm(ls)
