// @error member access '.r' on non-object A | B | null
// A `??` over a declared parameter joins its record default rather than reading as the
// parameter's pin, so a field the default lacks is refused at check (D2562).
type A = { r: i32 }
type B = { q: string }
function mkA(): A | null { return null }
function mkB(): B | null { return { q: "b" } }
function pick<T>(a: T | null, b: B | null) { return a ?? b }
const x = pick(mkA(), mkB())
print(x.r)
