// @run
// @log 5
// @log 6
// @log 7
// @log 8
// D8381: an object literal handed through a generic identity into a union member is pinned at
// that member, not at a declared record outside the union that shares its field names.
// Binding, argument, list-element and wider-record deliveries each print the field.
type J = { r: i32 }
type N = { r: i32 | null }
function idn<T>(v: T): T { v }
function take(u: J | string) {
  if u is J { print(u.r) }
}

const a: J | string = idn({ r: 5 })
if a is J { print(a.r) }
take(idn({ r: 6 }))
const xs = [idn({ r: 7 })]
const x0 = xs[0]
if x0 is N { print(x0.r ?? 0) }
const b: N = idn({ r: 8 })
print(b.r ?? 0)
