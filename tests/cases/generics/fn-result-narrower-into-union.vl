// @run
// @log 1
// @log 1
// @log 1
// @log 4
// @log 3
// @log 5
// @log 1
// @log 1
// @hint redundant type annotation: `at` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A function value whose result is narrower than a generic's `() => T | string` binds `T` to its
// result and is delivered into the union box the instance reads (D10133).
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { 0 } else { 1 }
}
print(len(() => 4))
print(len(() => 2.5))
const g = () => 4
print(len(g))
function show<T>(f: () => T | string) {
  const t = f()
  if t is string { print(t) } else { print(t) }
}
show(() => 4)
function cnt<T>(f: () => T[] | i32) {
  const t = f()
  if t is i32 { t } else { t.length }
}
print(cnt(() => [1, 2, 3]))
function get<T>(f: () => T | string): T | string { f() }
const v = get(() => 4)
if v is string { print(v) } else { print(v + 1) }
function at<T>(f: (n: i32) => T | string): i32 {
  const t = f(3)
  if t is string { 0 } else { 1 }
}
print(at((n: i32) => n + 1))
print(at((n) => n + 1))
