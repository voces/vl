// @run
// @log 0
// @log 0
// @log 2
// An empty `[]` handed to a generic `T[]` that no other argument binds pins the unbound
// default's list, so the instance has a parameter type (D12581).
function len<T>(x: T[]) { x.length }
function both<T>(x: T[], y: T[]) { x.length + y.length }
print(len([]))
print(both([], []))
print(both([], [1, 2]))
