// @run
// @log [a]
// @log [b]
// @log [p]
// @log [q]
// @log [true]
// @log [false]
// @log b
// @log null
// @log 2.5
// @log 5
// @log [a]
// @log [b]
// @log a
// @log b
// @log a
// @log b
// A `for`-in loop variable of an instance reached only through another generic's call reads at
// the pin that call forwards, at a literal union, a string, a boolean, a nullable literal union,
// a float and a record, through an explicit or a hole forwarder, and the instance a forwarder
// builds first is the one a direct call later shares (D3044, D3045).
type AB = "a" | "b"
type R = { a: i32 }
function inner<U>(x: U) { print("[\{x}]") }
function mid<T>(l: T[]) {
  for e in l { inner(e) }
}
function outer<T>(l: T[]) { mid(l) }
const v: AB[] = ["a", "b"]
outer(v)
const s = ["p", "q"]
outer(s)
const bs = [true, false]
outer(bs)
function show<T>(l: T[]) {
  for e in l { print(e) }
}
function fwd<T>(l: T[]) { show(l) }
const ns: (AB | null)[] = ["b", null]
fwd(ns)
const fs = [2.5]
fwd(fs)
function field<T>(l: T[]) {
  for e in l { print(e.a) }
}
function fwdR<T>(l: T[]) { field(l) }
const rs = [{ a: 5 }]
fwdR(rs)
function hole(l) { mid(l) }
const w: AB[] = ["a", "b"]
hole(w)
function mid2<T>(l: T[]) {
  for e in l { print(e) }
}
function outer2<T>(l: T[]) { mid2(l) }
const w2: AB[] = ["a", "b"]
outer2(w2)
mid2(w2)
