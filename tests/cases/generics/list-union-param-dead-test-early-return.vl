// @log 3
// @hint redundant type annotation: `r` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `r2` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `r3` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `r4` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `r5` is inferred as `i32` — remove it to lean on inference
// A generic's `T[] | i32` parameter tested first by an `is` the pin makes dead and then returned
// early under `is i32` returns the join of its returns, not the parameter's union (D10164).
function f<T>(x: T[] | i32) {
  if x is string[] { return 1 }
  if x is i32 { return x }
  5
}
const r: i32 = f(3)
print(r)
const r2: i32 = f(["a"])
print(r2)
const r3: i32 = f(4)
print(r3)
print(f([1]))
function g<T>(x: T[] | i32) {
  if x is string[] { return x.length }
  if x is i32 { return x }
  5
}
print(g([2]))
const r4: i32 = g(3)
print(r4)
function h<T>(x: T[] | i32) {
  if x is string[] { return 1 }
  if x is i32 { return x }
  return 5
}
print(h([1.5]))
const r5: i32 = h(3)
print(r5)
