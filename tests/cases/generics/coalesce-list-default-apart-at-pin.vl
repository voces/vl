// @run
// @log 1
// @log xs
// @log false
// @log xs
// @log false
// A generic `??` whose operand list and default list a pin binds apart builds their union
// where it is bound, as the `if` it spells does (D2846, D2816).
function nested<T>(xs: T[][] | null) {
  const r = xs ?? [[1]]
  if r is i32[][] { print(r[0][0]) } else { print("xs") }
}
nested<string>(null)
nested([["s"]])
function flat<T>(xs: T[] | null) {
  const r = xs ?? [false]
  if r is boolean[] { print(r[0]) } else { print("xs") }
}
flat<f64>(null)
flat<f64>([1.5])
flat<boolean>(null)
