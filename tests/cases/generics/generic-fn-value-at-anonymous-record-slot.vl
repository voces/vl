// @run
// @log Q
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 10
// @log x
// @warning Unused parameter `u`
// @info `m` is never reassigned; use `const` instead of `let`
// D3985, D12640: a generic function delivered as a value where the function type's parameter
// is an anonymous record is instantiated at that record, at a written binding, a parameter, a
// return, a module global and a result typed by the type parameter.
function id<U>(u: U): U { u }
function inner<U>(u: U) { print("I") }
function cAnon(p: { b: i32 }) { print("Q"); print(p.b) }
function main() {
  let k: ({b: i32}) => void = inner
  k = cAnon
  k({ b: 5 })
  const r: ({b: i32}) => {b: i32} = id
  print(r({ b: 6 }).b)
}
main()
function run(f: ({b: i32}) => {b: i32}) { print(f({ b: 7 }).b) }
run(id)
function pick(): ({b: i32}) => {b: i32} { return id }
const g = pick()
print(g({ b: 8 }).b)
let m: ({b: i32}) => {b: i32} = id
print(m({ b: 9 }).b)
const two: ({b: i32, c: string}) => {b: i32, c: string} = id
const t = two({ b: 10, c: "x" })
print(t.b)
print(t.c)
