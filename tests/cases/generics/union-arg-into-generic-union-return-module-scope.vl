// @run
// @log 3
// @log 3
// @log 5
// @log str
// @log 4
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 4
// A generic `T | string` return at a union `T` is recorded with that union nested. An
// un-annotated module binding of the call names the box of its flattened members, so a narrowed
// read unboxes its arm, in every delivery position and at every argument union (D10522).
function f<T>(u: T): T | string { u }
function g<T>(u: T, b: boolean): T | string {
  if b { return "str" }
  u
}
function inc(x: i32) { x + 1 }
const s: f64 | i32 = 3
const r = f(s)
if r is i32 { print(r) }
let lr = f(s)
lr = f(s)
if lr is i32 { print(lr) }
const h: f64 | i32 = 2.5
const fr = f(h)
if fr is f64 { print(fr * 2.0) }
const sr = g(s, true)
if sr is string { print(sr) }
if r is i32 { print(inc(r)) }
const c = () => {
  if r is i32 { print(r) }
}
c()
const s32: f32 | i32 = 3
const r32 = f(s32)
if r32 is i32 { print(r32) }
const s3: f64 | i32 | i64 = 3
const r3 = f(s3)
if r3 is i32 { print(r3) }
const ann: f64 | i32 | string = f(s)
if ann is i32 { print(ann) }
print(f(s))
const ex = f<f64 | i32>(s)
if ex is i32 { print(ex) } else { print(1) }
const sa: i32[] | i32 = 3
const ra = f(sa)
if ra is i32 { print(ra) }
type Sq = { s: i32 }
function gi<T>(x: T): T | i32 { return x }
const sq: Sq | i32 = 4
const rq = gi(sq)
if rq is i32 { print(rq) }
