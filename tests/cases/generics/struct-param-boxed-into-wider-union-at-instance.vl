// @run
// @log o
// @log "hi"
// @log 3
// A record type parameter, pinned at a plain struct, boxed into a wider union inside the instance
// rides the box as itself under its arm's tag.
type Circle = { r: i32 }
function tag<T>(v: T) {
  const aw: i32 | string | T = v
  if aw is string { return "\"" + aw + "\"" }
  return "o"
}
function radius<T>(v: T, f: (x: T) => i32) {
  const aw: i32 | T = v
  if aw is i32 { return aw }
  return f(v)
}
const c: Circle = { r: 3 }
print(tag(c))
print(tag("hi"))
print(radius(c, (x) => x.r))
