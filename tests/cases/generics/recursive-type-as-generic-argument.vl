// @run
// @log 1
// The other boundary: a recursive DECLARED struct is cyclic in the arena too, and it
// travels through a generic alias here. It renders finitely because its index carries
// a NAME (`structNameOfTy` short-circuits the walk at `Tree`), so the guard must let it
// through — the reject is for a cycle with no nominal exit, not for a cycle.
type Tree = { v: i32, kids: Tree[] }
type Wrap<T> = { inner: T }

const w: Wrap<Tree> = { inner: { v: 1, kids: [] } }
print(w.inner.v)
