// @run
// @log z
// @log 1
// @hint redundant type annotation: `o` is inferred as `{v: {a: i32, b: string}}`
// A generic application as an inline-object FIELD type (`{ v: Pair<i32, string> }`).
// `nameToTy`'s inline-object arm splits the synthetic name at its top-level commas
// and each field at its first top-level `:` — both `<>`-blind, so the argument
// list's comma split the FIELD list. The result did not even reject: the second
// half had no top-level `:` and was dropped, and `v` got the -1 hole for a type
// (`no field 'v' on {v: _}` — the renderer's blank standing in for a type).
type Pair<A, B> = { a: A, b: B }

const o: { v: Pair<i32, string> } = { v: { a: 1, b: "z" } }
print(o.v.b)
print(o.v.a)
