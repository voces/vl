// @check
// @error return type mismatch: expected string, got i32 (the return of `g` at the call's argument types)
// @error return type mismatch: expected boolean, got i32 (the return of `asBool` at the call's argument types)
// @error return type mismatch: expected V, got i32 (the return of `asObj` at the call's argument types)
// @error return type mismatch: expected Feet, got Meters (the return of `pass` at the call's argument types)
// @hint redundant type annotation: `s` is inferred as `string`
// @hint redundant type annotation: `b` is inferred as `boolean`
// @hint redundant type annotation: `v` is inferred as `{x: i32}`
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `a` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z1` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z2` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z3` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `z4` (prefix with `_` to suppress, or remove it)
// THE DECLARED RETURN IS THE HOLE, AND THE BODY IS CONCRETE (silent-class-inventory D561) —
// D551's mirror image, one column over. There the BODY carried the hole under a concrete
// declaration; here the DECLARATION carries it over a body whose type is already decided, so
// `assignable(i32, T)` is vacuously true in the body for the same reason and nothing re-asked
// it at the pin. Every row below was `vl check` rc 0, and every one has a DIRECT twin — the
// same declaration with the type parameter written out — that has always been a positioned
// `return type mismatch`.
//
//   · `g`      the filed witness. `print(g("s", 2))` was check-clean INVALID WASM:
//              `type mismatch: expected (ref $type), found i32`, an i32 in a string slot.
//   · `asBool` THE ONE THE FILED ROW DID NOT COUNT, and it is worse than the two it did.
//              i32 and boolean share a rep, so there is no invalid wasm to trip over: the
//              module VALIDATED and `print(asBool(true, -1))` printed `false` — the returned
//              i32 `0` rendered at the declared `boolean`, for an argument that was `true`.
//              The grid could not see it either, because the `wanthole` block printed `1` at
//              every cell; `d551wv_*` is that block with the value restored.
//   · `asObj`  the same shape at a REF destination, `expected (ref $type), found i32` again.
//   · `pass`   TWO BRANDS OVER ONE BASE. `Meters` handed back where the call bound `A` to
//              `Feet` — same rep, same value, the exact confusion `new` exists to catch —
//              and it RAN, printing `10`.
//
// WHAT IS DELIBERATELY NOT HERE is the fifth shape: a body type that fits the declared
// brand's UNBRANDED base (`function rowAt<A>(self: Rows<A>, i: i32): A { return self.base +
// i * 4 }`). That one is exempted and keeps running —
// `declared-return-hole-newtype-brand-keeps.vl` is its witness and D571 is its row.
type V = { x: i32 }

function g<T>(self: T, n: i32): T { return n + 1 }
const s: string = "s"
const z1 = g(s, 2)

function asBool<T>(self: T, n: i32): T { return n + 1 }
const b: boolean = true
const z2 = asBool(b, -1)

function asObj<T>(self: T, n: i32): T { return n + 1 }
const v: V = { x: 6 }
const z3 = asObj(v, 2)

type Meters = new i32
type Feet = new i32
function pass<A>(a: A, m: Meters): A { return m }
const f: Feet = 3
const m: Meters = 10
const z4 = pass(f, m)
