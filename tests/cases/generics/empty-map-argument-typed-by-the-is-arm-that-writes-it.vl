// An empty `Map()` or `Set()` handed to a generic is the type the generic's `is K` arm writes it at
// (DECISIONS.md "No default type"): the caller's container is built there and reads it back.
function f<T>(x: T) {
  if x is {[i32]: f64} {
    x[1] = 2.5
    return x.length
  }
  return 0
}
print(f(Map()))
const m = Map()
print(f(m))
print(m.length)
m[2] = 3.5
print(m.length)
function g<T>(x: T) {
  if x is Set<i32> {
    x.add(3)
    return x.length
  }
  return 0
}
print(g(Set()))
// A hole-template caller: every instance pins its own map at the callee's `{[i32]: f64}`, and one
// instance writes it too.
function h(tag, more) {
  const m2 = Map()
  const n = f(m2)
  if more { m2[7] = 0.5 }
  print(tag)
  print(n + m2.length)
}
h(1, false)
h("b", false)
h(3.5, true)
// @log 1
// @log 1
// @log 1
// @log 2
// @log 1
// @log 1
// @log 2
// @log b
// @log 2
// @log 3.5
