// An empty `Map()` or `Set()` handed to a generic is the type the generic's `is K` arm writes it at
// (DECISIONS.md "No default type"): the caller's container is built there and reads it back.
function f<T>(x: T) {
  if x is {[i32]: f64} {
    x[1] = 2.5
    return x.length
  }
  return 0
}
print(f(Map()))
const m = Map()
print(f(m))
print(m.length)
m[2] = 3.5
print(m.length)
function g<T>(x: T) {
  if x is Set<i32> {
    x.add(3)
    return x.length
  }
  return 0
}
print(g(Set()))
// @log 1
