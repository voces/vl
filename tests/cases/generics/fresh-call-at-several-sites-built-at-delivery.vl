// @run
// @log 15
// @log 16
// @log 17
// @log 18
// @log 20
// @log 0
// @log 21
// @log 18
// @log 22
// @log 23
// @log 24
// @log 25
// D8201, D8202: a fresh call is built at the record its calls deliver to, though a declared
// record (`Col`) spells its own fields, when every call lands on that record: two calls into
// a local, a field, a list element and a module binding, each call a record of its own. A
// generic identity over a function handing back an identity over one is built there too, as a
// binding, an argument, a list element and un-annotated.
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
type W = { f: J }
function idn<T>(v: T): T { v }
function mkV() { { r: 15, g: 1 } }
function mkW() { { r: 16, g: 1 } }
function mkX() { { r: 17, g: 1 } }
function mkG() { { r: 18, g: 1 } }
function mkS() { { r: 19, g: 1 } }
function mkD() { { r: 22, g: 1 } }
function wrapD() { idn(mkD()) }
function mkA() { { r: 23, g: 1 } }
function wrapA() { idn(mkA()) }
function mkL() { { r: 24, g: 1 } }
function wrapL() { idn(mkL()) }
function mkU() { { r: 25, g: 1 } }
function wrapU() { idn(mkU()) }
function take(j: J) { print(j.r ?? 0) }

let v: J = mkV()
v = mkV()
print(v.r ?? 0)
const w: W = { f: idn(mkW()) }
w.f = idn(mkW())
const wf = w.f
print(wf.r ?? 0)
const xs: J[] = [idn(mkX())]
xs[0] = idn(mkX())
print(xs[0].r ?? 0)
const ga: J = idn(mkG())
const gb: J = idn(mkG())
print(ga.r ?? 0)
const sa: J = mkS()
const sb: J = mkS()
sa.r = null
sb.r = 20
print(sb.r ?? 0)
print(sa.r ?? 0)
sa.r = 21
print(sa.r ?? 0)
print(gb.r ?? 0)
const d: J = idn(wrapD())
print(d.r ?? 0)
take(idn(wrapA()))
const ls: J[] = [idn(wrapL())]
print(ls[0].r ?? 0)
const u = idn(wrapU())
print(u.r)
