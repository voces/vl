// @run
// @log false
// @log false
// @log false
// @log false
// D3362: a record `is` over a call result the callee lowers as `string | null` is false, not a
// null test: the join of two type parameters read in a hole-typed caller, through a binding and
// directly, beside a one-parameter identity.
type P = {x: i32}
function j<T, U>(a: T, b: U, k: i32) { return if k == 0 { a } else { b } }
function h(a, b, k: i32) {
  const r = j(a, b, k)
  print(r is P)
}
const x0: string = "x"
const x1: string | null = null
h(x0, x1, 0)
h(x0, x1, 1)
function idt<T>(a: T) { return a }
function hd(a) { print(idt(a) is P) }
const s: string | null = "y"
hd(s)
const t: string | null = null
hd(t)
