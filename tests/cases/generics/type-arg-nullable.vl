// @run
// @log 1
// A NULLABLE generic application whose argument is itself a union
// (`Box<i32 | null> | null`). Past the checker's split this needs the emitter's
// `nullablePartOf` (`emit_base.vl`) to find the nullable's `|` — it took the FIRST
// depth-0 bar, which was the one INSIDE `<…>`, so the two halves were `Box<i32`
// and `null>|null` and neither was `null`.
type Box<T> = { v: T }

let nb: Box<i32 | null> | null = null
nb = { v: 4 }
if nb is Box<i32 | null> { print(1) }
