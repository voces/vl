// @run
// @log 0
// @log 1
// @log s
// @log null
// @log s
// @log d
// @log 7
// @log true
// @log n
// @log true
// A declared return that nests a parameter's nullable, `(A | null) | B` or `A | (B | null)`, is
// the one nullable union `A | B | null` at every pin: the instance kept the null inside the union
// and built a box no reader agreed with (D3504).
type Rec = { x: i32 }
const r7: Rec = { x: 7 }
const ns: string | null = "n"
function F<A, B>(k: i32, a: A, b: B): (A | null) | B {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
function G<A, B>(k: i32, a: A, b: B): A | (B | null) {
  if k == 0 { a }
  else if k == 1 { b }
  else { null }
}
const u = F(0, true, 4)
if u is i32 { print(u) } else { print(0) }
print(F(0, 1, "s"))
print(F(1, 1, "s"))
print(F(2, 1, "s"))
print(F(1, ns, "s") ?? "d")
print(F(2, ns, "s") ?? "d")
const w = G(1, 2.5, r7)
if w is Rec { print(w.x) } else { print(w == null) }
const z = G(2, 2.5, r7)
if z is Rec { print(z.x) }
else if z is f64 { print(z) }
else { print(z == null) }
print(G(0, ns, ns))
print(G(2, ns, ns) == null)
