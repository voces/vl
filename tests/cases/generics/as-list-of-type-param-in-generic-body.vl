// @run
// @log 1.5
// @log s
// @log e
// @log 1.5
// @log 2.5
// `as? T[]` in a generic body names the written arm `T[]` of its operand's union, which the
// annotation's own `T` row and the parameter's are the same parameter of (D4155).
function f<T>(u: T[] | i32, d: T): T {
  const r = u as? T[]
  if r != null { return r[0] }
  return d
}
function g<T>(u: T[] | string, d: T): T {
  const r = u as? T[]
  if r != null { return r[0] }
  return d
}
print(f([1.5], 0.0))
print(f(["s"], "d"))
print(f(3, "e"))
print(g([1.5], 0.0))
print(g("x", 2.5))
