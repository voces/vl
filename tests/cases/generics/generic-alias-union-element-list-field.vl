// @run
// @log 2
// @log 2
// @log true
// @log 2
// @log 1
// @log 3
// @log z
// @log 4
// @log w
// @log 2
// @log 2
// @log 3
// @log s
// @log 3
// @log a
// @log 1
// @log 1

// D12560: a generic alias's `T[]` field applied at a union is spelled `(i32|string)[]`, so the
// instance's field keys the union's own ref-list slot rather than a list arm of a union. D4191
// is the null-only literal at the same spelling.
type Box<T> = { xs: T[] }
type Grid<T> = { xs: T[][] }
type Pr<A, B> = { xs: A[], ys: (B | null)[] }
type Nb<T> = { xs: (T | null)[] }
type Ob<T> = { xs: T[] | null }
type P = { k: i32 }

function f(b: Box<i32 | string>) { b.xs.length }
function n<T>(b: Box<T>) { b.xs.length }
function mk(): Box<i32 | string> { { xs: [1, "z", 3] } }

const bu: Box<i32 | string> = { xs: [1, "z"] }
print(bu.xs.length)
const bn: Box<i32 | null> = { xs: [1, null] }
print(bn.xs.length)
print(bn.xs[1] == null)
print(n({ xs: [1, "z"] }))
print(f({ xs: ["q"] }))
const m = mk()
print(m.xs.length)
const e = m.xs[1]
if e is string { print(e) }
let bv: Box<i32 | string> = { xs: [] }
bv = mk()
bv.xs.push("w")
print(bv.xs.length)
print(bv.xs[3])
const g: Grid<i32 | string> = { xs: [[1, "z"], ["y"]] }
print(g.xs.length)
const p: Pr<i32 | boolean, string | i32> = { xs: [true, 2], ys: [null, "s", 4] }
print(p.xs.length)
print(p.ys.length)
const y = p.ys[1]
if y is string { print(y) }
const nb: Nb<i32> = { xs: [1, null, 3] }
print(nb.xs.length)
const ob: Ob<string> = { xs: ["a"] }
const ox = ob.xs
if ox != null { print(ox[0]) }
const bz: Box<i32 | null> = { xs: [null] }
print(bz.xs.length)
const pz: Box<P | null> = { xs: [null] }
print(pz.xs.length)
