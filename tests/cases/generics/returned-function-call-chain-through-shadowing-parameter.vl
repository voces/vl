// @run
// @log 40
// @log 45
// @log strstr
// @log 30
// @log true
// @log true
// @log 2.5
// @log 2.5
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `t` (prefix with `_` to suppress, or remove it)
// A call of a call whose callee is a parameter named like a module function calls the parameter
// and yields its type, at i32, f64, string and through a lambda; and a call of a call of a call
// yields the innermost declared result (D3912, D3922).
function a(x: i32): (t: i32) => boolean {
  (t: i32) => t > 0
}
function pr(a: (x: i32) => (t: i32) => i32, y: i32) { print(a(y)(y)) }
function prf(a: (x: f64) => (t: f64) => f64, y: f64) { print(a(y)(y)) }
function prs(a: (x: string) => (t: string) => string, y: string) {
  print(a(y)(y))
}
const viaLambda = (a: (x: i32) => (t: i32) => i32) => print(a(3)(3))
pr((x: i32) => (t: i32) => t * 10, 4)
prf((x: f64) => (t: f64) => t * 10.0, 4.5)
prs((x: string) => (t: string) => t + t, "str")
viaLambda((x: i32) => (t: i32) => t * 10)
function g<T>(x: T): (t: T) => (u: T) => T {
  (t: T) => (u: T) => u
}
function tri<T>(x: T) {
  print(g(x)(x)(x))
  const v = g(x)(x)(x)
  print(v)
}
tri(true)
tri(2.5)
