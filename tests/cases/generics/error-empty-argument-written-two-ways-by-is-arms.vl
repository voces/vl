// @check
// @error an empty value handed to 'V' is written as one type in the `is` arm at line 6 and as another in the one at line 7; annotate the argument
// Two `is` arms write the receiver at different types, so the empty argument has no one element
// type (DECISIONS.md "No default type"): refused at the call, naming both arms.
function g<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  if v is string[] { v.push("a") }
  print(v.length)
}
g([])
