// @run
// @log 3
// @log y
// @log 3
// @log 1.5
// @log 2
// @log 2
// A spread of the parameter's list into a literal of `(T | string)[]` or `(T | null)[]` is built
// at the instance's list: a literal-union pin widens each atom to its string, and a scalar pin
// boxes each element (D2968, D2970).
type K = "x" | "y"
function ws<T>(xs: T[]): (T | string)[] { return [...xs, "s"] }
function pad<T>(xs: T[]): (T | null)[] { return [...xs, null] }
const pb: K[] = ["y", "x"]
const rk = ws(pb)
print(rk.length)
print(rk[0])
print(ws([1, 2]).length)
const rf = ws([1.5])
const f0 = rf[0]
if f0 is f64 { print(f0) }
print(pad([3]).length)
print(pad([2 as i64]).length)
