// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 4
// @log 2
// A list of un-annotated functions of two result types two or more literal levels below a
// generic's argument top (a record in a record, a record in a list) takes each level at the pin
// built from its parts (D16876).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id(x) { return x }
function id2(x) { return x }
function id3(x) { return x }
function id4(x) { return x }
const r = id({ o: { l: [inc0, half] } })
print(r.o.l[1](3))
const q = id2([{ l: [inc0, half] }])
print(q[0].l[1](3))
const t = id3({ a: { b: { l: [inc0, half] } } })
print(t.a.b.l[1](3))
print(t.a.b.l[0](3))
const u = id4({ o: { l: [inc0, half], n: 2 }, m: 1 })
print(u.o.l[1](u.o.n) + u.m)
