// @run
// @log 2
// @log s
// An aliased nested generic called with the enclosing `T`, beside an unrelated nested generic of
// another function with the same parameter name: each binds its own (D3853 review).
function a<T>(x: T) {
  function b<U>(y: U) { const n: i32 = y; print(n + 1) }
  const f = b
  f(x)
}
function c<T>(x: T) {
  function q<U>(y: U) { print(y) }
  q(x)
}
a(1)
c("s")
