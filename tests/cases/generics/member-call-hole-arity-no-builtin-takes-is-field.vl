// A list, map or set method name called on an un-annotated parameter at an argument count no
// built-in method of that name takes is a call of the record field of that name.
type CcPair = { inc: () => void, get: () => i32 }
function mk(): CcPair {
  let n = 0
  return {
    inc: () => {
      n = n + 1
    },
    get: () => n,
  }
}
function t(a) {
  a.inc()
  print(a.get())
}
type K = {
  keys: (x: i32) => i32,
  values: (x: i32, y: i32) => i32,
  clear: (x: i32) => i32,
  set: (x: i32) => i32,
  add: () => i32,
  has: () => boolean,
  push: () => i32,
  pop: (x: i32) => i32,
}
function mkK(): K {
  return {
    keys: (x) => x + 1,
    values: (x, y) => x + y,
    clear: (x) => x * 2,
    set: (x) => x - 1,
    add: () => 7,
    has: () => true,
    push: () => 9,
    pop: (x) => x + 100,
  }
}
function u(a) {
  print(a.keys(1))
  print(a.values(2, 3))
  print(a.clear(4))
  print(a.set(5))
  print(a.add())
  print(a.has())
  print(a.push())
  print(a.pop(1))
}
t(mk())
u(mkK())
