// @run
// @log 5
// @log 6
// @log 5
// The `f64` twin: an `i32` pin whose record only a declared `f64` row reads takes that row
// (D2850).
type Fl = { v: f64 }
function mkT<T>(x: T) { return { v: x } }
function mk(x) { return { v: x } }
const b: Fl = mkT(5)
print(b.v)
const ys: Fl[] = [mkT(6)]
print(ys[0].v)
function use(f: Fl) { print(f.v) }
use(mk(5))
