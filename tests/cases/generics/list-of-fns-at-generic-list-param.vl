// @run
// @log 116
// @log 161
// @log 110
// @log 10
// @log 2
// @log 6
// @log 116
// @log 116
// @log 105

// A list of functions handed to a generic whose parameter is `T[]`: the instance's list is
// named with the function type grouped, `((a: i32) => i32)[]`, so it finds the list's own row
// (D9860). The nullable-function list and the direct index are the controls.

import { fill, mapIndexed, reduce, retain, sort } from "std:array"

type F = (a: i32) => i32

function inc(a: i32) { a + 1 }
function dbl(a: i32) { a * 2 }

function len<T>(xs: T[]) { xs.length }
function first<T>(xs: T[]): T { xs[0] }

const v = [(a: i32): i32 => a + 1, (a: i32): i32 => a * 2]
print(v.reduce((s: i32, r: (a: i32) => i32): i32 => s + r(5), 100))
const o = v.mapIndexed((r: (a: i32) => i32, i: i32): i32 => r(5) * 10 + i)
print(o[0] + o[1])

const w = [inc, dbl]
w.retain((r: (a: i32) => i32): boolean => r(5) > 6)
print(w.length * 100 + w[0](5))
w.push(inc)
w.sort((x: (a: i32) => i32, y: (a: i32) => i32): boolean => x(5) > y(5))
print(w[0](5))

const al: F[] = [inc, dbl]
al.fill(inc)
print(len(al) + al[1](0) - 1)
print(first(al)(5))

const nl: (F | null)[] = [inc, dbl]
print(
  nl.reduce(
    (s: i32, r: F | null): i32 => s + (if r == null { 0 } else { r(5) }),
    100,
  ),
)
print(v.reduce((s: i32, r: F): i32 => s + r(5), 100))
print(v[0](4) + w[0](0) + 100)
