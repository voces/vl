// @run
// @log 3
// @log ab
// @log 1.5
// A `for` straight over a generic maker's bound list of generic-function records calls each
// element at the loop's instance, the first one included (D16236).
function id<T>(x: T): T { return x }
function run<T>(x: T) {
  const rs = [{ f: id }]
  return rs
}
for r in run(3) { print(r.f(3)) }
for r in run("ab") { print(r.f("ab")) }
for r in run(1.5) { print(r.f(1.5)) }
