// @log 6
// @log 7
// @log 8
// D14426: a hole instance reached by a value built at a wider record is typed at the checker's
// binding and stored at the build, so a field read unboxes to the narrower field's type.
type II = { f: i32 }
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const wideF: i32 = wideJ.f ?? 0
function take(a) { print(a.f + 1) }
function takeLet(a) {
  const v = a
  print(v.f + 1)
}
function guard(v) {
  if v.f == 4 {
    print(v.f + 1)
    return
  }
  print(0)
}
take(mk())
takeLet(mk())
guard(mk())
type A = { d: i32 | null }
type D = { d: i32 }
function relay(v) {
  const w = v
  return w
}
const c: A = relay({ d: 6 })
print(c.d ?? 0)
function idn<T>(v: T): T { v }
const e: A = idn({ d: 6 })
print(e.d ?? 0)
const ys = [idn({ d: 7 })]
const y0 = ys[0]
if y0 is A { print(y0.d ?? 0) }
const b: A = idn({ d: 8 })
print(b.d ?? 0)
