// A generic whose first parameter names its type parameter only in a phantom alias binds it from a
// later argument, not from the open variable the alias's instance result carries (D17575).
// @run
// @log 9
// @hint Intentionally-unused parameter `_r`
type P = { a: i32, b: f64 }
type Rows<T> = { base: i32, count: i32 }
function g<T>(_r: Rows<T>, x: T): T { return x }
function mk<T>(b: i32): Rows<T> { return { base: b, count: 1 } }
const su = mk<P>(8)
const q = g(su, { a: 3, b: 4.5 })
const f = q.b * 2.0
print(f)
