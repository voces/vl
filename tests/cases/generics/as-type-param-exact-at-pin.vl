// @run
// @log 3
// @log -1
// @log 12
// @log -1
// @log 7
// @log 4
// A type-parameter operand's `as? i32` is exact at its pin: an f64 or i64 the target holds
// exactly converts, one it does not is `null`, and an i32 pin passes the value through. `as!`
// converts an exact value at its pin.
function opt<T>(u: T) {
  const v = u as? i32
  if v == null { return -1 }
  return v
}

function bang<T>(u: T) { return u as! i32 }

const f = 3.0
const g = 2.5
const w: i64 = 12
const big = 5000000000
print(opt(f))
print(opt(g))
print(opt(w))
print(opt(big))
print(opt(7))
print(bang(4.0))
