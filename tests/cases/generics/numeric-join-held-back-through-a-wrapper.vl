// @run
// @log 7
// @log 2.5
// @log 3.5
// @log 9
// @log 5
// @log 3.5
// @log 3
// @hint redundant type annotation: `x` is inferred as `i32`
// @hint redundant type annotation: `y` is inferred as `f64`
// A function reached through a generic wrapper, and a return set holding a literal arm, keep
// the widening join until D3494 and D3495 close: these print what they printed before the
// numeric-join ruling, and a value `if` beside a literal return still joins apart.
function f<A, B>(k: i32, a: A, b: B) {
  if k == 0 { return a }
  b
}
function g<A, B>(k: i32, p: A, q: B) { f(k, p, q) }
function lit<A, B>(k: i32, a: A, b: B) {
  if k == 0 { return a }
  if k == 1 { b } else { 5 }
}
function h(k: i32, a: i32, b: f64) {
  if k == 0 { return a }
  if k == 1 { return b }
  return 3
}
function v(c: boolean, a: i32, b: f64) {
  const r = if c { a } else { b }
  print(r / 2)
  return 0
}
const x: i32 = 7
const y: f64 = 2.5
const z: i64 = 9
print(g(0, x, y))
print(g(1, x, y))
print(g(0, x, y) / 2)
print(lit(0, z, z))
print(lit(2, z, z))
print(h(0, 7, 2.5) / 2)
v(true, 7, 2.5)
