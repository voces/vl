// A union of lists handed to a generic list parameter one member at a time binds `T` per call.
function first<T>(xs: T[]): T { return xs[0] }
type A = { k: i32 }
type B = { k: string }
function kk<T>(x: { k: T }): T { return x.k }
const q: string[] | i32[] = [4, 2]
print(first(q as! i32[]))
if q is i32[] { print(first(q.map((x) => x)) + 1) }
const r: A | B = { k: "s" }
if r is B { print(kk(r)) }
// @log 4
// @log 5
// @log s
