// @check
// @error argument of type string flows into `g` expecting i32 (the call's argument types)
// A generic body's call-argument demand, adjudicated at the method spelling too (D2425):
// `"s".inc()` is `inc("s")`, and built an invalid module while the direct spelling refused.
function g(n: i32) { return n + 1 }
function inc<T>(self: T) { return g(self) }
print((3).inc())
print("s".inc())
