// @error cannot assign boolean to 'm' of type i32
// The enclosing function's own demand on its `T` is checked at its pin beside a nested generic
// that redeclares `T` and makes the same demand of its own (D3853 review).
function a<T>(x: T) {
  function b<T>(y: T) {
    const n: i32 = y
    print(n + 1)
  }
  const m: i32 = x
  print(m)
}
a(true)
