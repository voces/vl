// @run
// @log 2
// @log b
// @log 4
// @log 5
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// Two distinct type parameters handed to one of a callee's run at an instance binding them
// alike, and a body that only reads one of them runs at any instance (D6426).
function g<T>(_x: T, y: T): T { return y }
function f<T, U>(a: T, b: U): T { return g(a, b) }
print(f(1, 2))
print(f("a", "b"))
function h<A, B>(x: A, y: B): A { return f(x, y) }
print(h(3, 4))
function k<T, U>(a: T, _b: U): T { return a }
print(k(5, "u"))
