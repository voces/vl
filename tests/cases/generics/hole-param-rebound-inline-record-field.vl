// @run
// @log true
// @log s
// An inline record literal handed to an un-annotated parameter and re-bound inside reads its
// field at the literal's own type through the alias (D2997).
function take(a) {
  const v = a
  print(v.v)
}
take({ v: true })
function takeS(a) {
  const v = a
  print(v.w)
}
takeS({ w: "s" })
