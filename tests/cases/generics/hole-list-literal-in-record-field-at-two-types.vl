// @log true
// D12920: a record literal whose field is a list literal of a hole parameter builds the record
// its instance names, a record element at one call and a scalar at the other: bound, returned,
// beside a second field and nested.
type P = { x: i32 }
function t(x) {
  const o = { xs: [x] }
  print(o.xs.length)
  o.xs
}
const a: P = { x: 7 }
print(t(a)[0].x)
print(t(3)[0] + 1)
function mk(x) { { xs: [x], n: 2 } }
const r = mk(a)
print(r.xs[0].x + r.n)
print(mk(1.5).xs[0] * 2.0)
function two(x, y) {
  const o = { a: [x], b: [y, y] }
  print(o.a.length + o.b.length)
  o
}
print(two(a, 1).a[0].x - 4)
print(two(2, a).b[1].x - 4)
function nest(x) {
  const o = { inner: { xs: [x] } }
  o.inner.xs
}
print(nest(a)[0].x - 1)
print(nest(true)[0])
