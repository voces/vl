// @log false
// A string-literal `is` in an un-annotated or generic function is false at an instance whose
// operand is no string or `null`, and tests the string at one that is: an inline literal, a set,
// a named set, and an `i32` or `null` pin (D15251).
type K = "x" | "y"
function h(v) { v is "x" }
print(h("x"))
print(h(3))
print(h(null))
function g<T>(v: T) { v is "x" }
print(g("x"))
print(g(3))
print(g(true))
function s(v) { v is "x" | "y" }
print(s("y"))
print(s(3))
print(s(null))
const k: K = "x"
function n(v) { v is K }
print(n(k))
print(n("y"))
print(n(2.5))
function r(v) { v is "y" | "x" }
print(r(k))
print(r(7))
