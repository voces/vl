// @run
// @log 0
// @log 0
// @log 1
// @log -1
// @log 5
// @log eval
// @log -1
// An `as?` over `T | null` pinned where no member can be the target answers `null` there, as a
// type parameter pinned at no number does (D2791, D16323); the pin where it fits still hits.
type P = { a: i32 }

function size<T>(u: T | null) {
  const w = u as? Set<i32>
  if w == null { return 0 }
  w.length
}
function field<T>(u: T | null) {
  const w = u as? P
  if w == null { return -1 }
  w.a
}
function num<T>(u: () => T | null) { (u() as? i32) ?? -1 }
function src(): string | null {
  print("eval")
  "x"
}

const s: Set<i32> = Set()
s.add(1)
print(size<string>("ab"))
print(size<string>(null))
print(size<Set<i32>>(s))
print(field<string>("s"))
print(field<P>({ a: 5 }))
print(num<string>(src))
