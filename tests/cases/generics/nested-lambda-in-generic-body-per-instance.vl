// @run
// @log 2
// @log a!
// @log 2.75
// @log true
// @log 901
// @log 41
// @log 6
// @log 12
// @log 3
// @log 4
// @log b
// @log 14
// @log zz
// @log 41
// @log 5
// @log 5
// @log qq
// @log 41
// @hint redundant type annotation
// CONTRACT (D1116): a lambda nested INSIDE a lambda in a generic body is a template at every
// depth, and each instantiation gets its own lifted slot.
//
// `monoPinBodyLambdas` walks the INSTANCE body's statement spine, so it reached
// `const g = …` and stopped at its `FuncDecl`. `const g = () => { const h = () => v; h() }`
// therefore minted a fresh slot for `g` at every pin and left `h` on the ONE slot every
// instance shares — D943's env defect one frame down: `fnEnvIdx` is parallel to `fnStmts`, so
// at `T := i32` the env is minted `(struct (field i32))` and the `T := string` instance emits
// `struct.new` of a string ref into that i32 field (`expected i32, found (ref $type)`).
//
// THE PARENT POINTER IS THE HALF READING THE CALL SITES DOES NOT GIVE YOU. `monoMakeInstance`
// re-points every slot left in `monoLamMintedSlots` at the INSTANCE function, which is right
// for a lambda bound directly in the instance body and wrong one frame down — a nested clone's
// free names resolve up the chain THROUGH the lambda that encloses it. `monoReparentNestedLams`
// re-points them at their enclosing clone and retires them from the ledger.
//
// EVERY CELL PRINTS A PROVING VALUE — the round-tripped payload operated on, never a constant,
// so a clone that returned the wrong instance's value cannot pass.
type Pt = { x: i32 }

function f<T>(v: T): T {
  const g = () => {
    const h = () => v
    h()
  }
  g()
}

// depth 3 — three frames down
function f3<T>(v: T): T {
  const a = () => {
    const b = () => {
      const c = () => v
      c()
    }
    b()
  }
  a()
}

// the NAMED nested `function` spelling one frame down
function fn<T>(v: T): T {
  const g = () => {
    function inner(): T {
      v
    }
    inner()
  }
  g()
}

const pt: Pt = { x: 41 }
const li: i32[] = [5, 6]
const mp: {[string]: i32} = Map()
mp["k"] = 12
const bi: i64 = 900
const nu: i32 | null = 3
const un: i32 | string = 4
type Sh = "a" | "b"
const lu: Sh = "b"

print(f(1) + 1)
print(f("a") + "!")
print(f(2.5) + 0.25)
print(f(true))
print(f(bi) + 1)
print(f(pt).x)
print(f(li)[1])
print(f(mp)["k"])
print(f(nu) ?? 0)
print(f(un))
print(f(lu))

print(f3(7) * 2)
print(f3("z") + "z")
print(f3(pt).x)
print(f3(li)[0])

print(fn(8) - 3)
print(fn("q") + "q")
print(fn(pt).x)
