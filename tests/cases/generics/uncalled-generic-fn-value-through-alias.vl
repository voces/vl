// @run
// @log 1
// @log 4
// @log 1
// @hint Intentionally-unused variable `_j` (leading `_` marks it unused)
// A declared generic taken as a value and never called, copied on through an alias into a list, a
// record field and a further alias, none of which is called (D6830).
function apply3<F>(g: F) { print(g(1, 2)) }
const h = apply3
const fs = [h]
print(fs.length)
const r = { f: h, n: 4 }
print(r.n)
const k = h
const _j = k
print(1)
