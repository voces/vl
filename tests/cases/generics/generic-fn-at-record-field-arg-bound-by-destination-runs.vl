// @run
// @log 1.5
// @log 3
// @log 1.5
// @log s
// @log 1.5
// @log 1.5
// @log 9000000000
// A generic function at a field of a record literal argument takes its instance from the
// destination, as one handed directly does (D16590): a binding at two widths, a nested record,
// two fields at two type parameters, a declared return and an argument.

function gid<A>(x: A): A { return x }
function unbox<A>(r: { f: (x: A) => A }): (x: A) => A { return r.f }
const k: (x: f64) => f64 = unbox({ f: gid })
print(k(1.5))
const ki: (x: i32) => i32 = unbox({ f: gid })
print(ki(3))
function unb2<A>(r: { g: { f: (x: A) => A } }): (x: A) => A { return r.g.f }
const kn: (x: f64) => f64 = unb2({ g: { f: gid } })
print(kn(1.5))
function un2<A, B>(r: { f: (x: A) => A, g: (x: B) => B }): (x: B) => B { return r.g }
const ks: (x: string) => string = un2({ f: gid, g: gid })
print(ks("s"))
function mk(): (x: f64) => f64 { return unbox({ f: gid }) }
print(mk()(1.5))
function inc(x: f64) { return x + 1.0 }
function unm<A>(r: { f: (x: A) => A, g: (x: A) => A }): (x: A) => A { return r.g }
const km: (x: f64) => f64 = unm({ f: inc, g: gid })
print(km(1.5))
function use(g: (x: i64) => i64) { print(g(9000000000)) }
use(unbox({ f: gid }))
