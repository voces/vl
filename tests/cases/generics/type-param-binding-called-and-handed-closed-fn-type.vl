// @run
// @log x
// @log 1
// @log y
// @log 1
// @log 9
// A binding of the parameter's type parameter, called at one type and handed to a closed
// function type of another, is split by that delivery's type too (D6761).
function same<T>(k: T): T { k }
function twice(f: (x: i32) => i32) { f(f(1)) }
function mid<F>(a: F) {
  const b: F = a
  print(b("x"))
  print(twice(b))
}
mid(same)
function bare<F>(a) {
  const b: F = a
  print(b("y"))
  print(twice(b))
}
bare(same)
print(same(9))
