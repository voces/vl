// @hint redundant type annotation: `tb` is inferred as `string`
// @run
// @log 2
// @log snil
// @log FN
// @log 2
// @log 7
// D10881: a generic returning a record whose `(T | null)[]` field holds a literal with a bare
// `null` builds the list at the instance's element, a string or boolean niche included.
function f<T>(x: T): { g: (T | null)[] } { return { g: [x, null] } }
function l<T>(x: T): (T | null)[] { return [x, null] }

function tb(x: boolean | null): string {
  if x == null { return "N" }
  if x { return "T" }
  "F"
}

const r = f("s")
print(r.g.length)
print((r.g[0] ?? "nil") + (r.g[1] ?? "nil"))
const b = f(false)
print(tb(b.g[0]) + tb(b.g[1]))
print(l("s").length)
print(f(7).g[0] ?? 0)
