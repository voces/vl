// @log 2.5
// @hint redundant type annotation: `x` is inferred as `A[] | B[]` — remove it to lean on inference
// A list literal of either type parameter at a join of `A[]` and `B[]`, in an instance binding the
// pair to two number types: each arm is its own list, read back at its own element (D17387).
// Four spellings, each read for its length and first element, at both arms and four pairs.
function joinLit<A, B>(a: A, b: B, k: boolean) {
  const x = if k { [a] } else { [b] }
  print(x.length)
  print(x[0])
}
function joinAnn<A, B>(a: A, b: B, k: boolean) {
  const x: A[] | B[] = if k { [a, a] } else { [b] }
  print(x.length)
  print(x[0])
}
function joinRet<A, B>(a: A, b: B, k: boolean): A[] | B[] {
  return if k { [a] } else { [b, b, b] }
}
function stmtRet<A, B>(a: A, b: B, k: boolean): A[] | B[] {
  if k { return [a] }
  return [b]
}
// A moved list: a bound literal handed through the join, not built at it.
function joinMoved<A, B>(a: A, b: B, k: boolean) {
  const ys = [b, b]
  const x = if k { [a] } else { ys }
  print(x.length)
  print(x[0])
}
joinLit(1, 2.5, true)
joinAnn(1, 2.5, true)
const r_i32_f64_true = joinRet(1, 2.5, true)
print(r_i32_f64_true.length)
const s_i32_f64_true = stmtRet(1, 2.5, true)
print(s_i32_f64_true.length)
joinMoved(1, 2.5, true)
joinLit(1, 2.5, false)
joinAnn(1, 2.5, false)
const r_i32_f64_false = joinRet(1, 2.5, false)
print(r_i32_f64_false.length)
const s_i32_f64_false = stmtRet(1, 2.5, false)
print(s_i32_f64_false.length)
joinMoved(1, 2.5, false)
joinLit(1.5, 2, true)
joinAnn(1.5, 2, true)
const r_f64_i32_true = joinRet(1.5, 2, true)
print(r_f64_i32_true.length)
const s_f64_i32_true = stmtRet(1.5, 2, true)
print(s_f64_i32_true.length)
joinMoved(1.5, 2, true)
joinLit(1.5, 2, false)
joinAnn(1.5, 2, false)
const r_f64_i32_false = joinRet(1.5, 2, false)
print(r_f64_i32_false.length)
const s_f64_i32_false = stmtRet(1.5, 2, false)
print(s_f64_i32_false.length)
joinMoved(1.5, 2, false)
joinLit(1, 2.5 as f32, true)
joinAnn(1, 2.5 as f32, true)
const r_i32_f32_true = joinRet(1, 2.5 as f32, true)
print(r_i32_f32_true.length)
const s_i32_f32_true = stmtRet(1, 2.5 as f32, true)
print(s_i32_f32_true.length)
joinMoved(1, 2.5 as f32, true)
joinLit(1, 2.5 as f32, false)
joinAnn(1, 2.5 as f32, false)
const r_i32_f32_false = joinRet(1, 2.5 as f32, false)
print(r_i32_f32_false.length)
const s_i32_f32_false = stmtRet(1, 2.5 as f32, false)
print(s_i32_f32_false.length)
joinMoved(1, 2.5 as f32, false)
joinLit(1.5 as f32, 2.5, true)
joinAnn(1.5 as f32, 2.5, true)
const r_f32_f64_true = joinRet(1.5 as f32, 2.5, true)
print(r_f32_f64_true.length)
const s_f32_f64_true = stmtRet(1.5 as f32, 2.5, true)
print(s_f32_f64_true.length)
joinMoved(1.5 as f32, 2.5, true)
joinLit(1.5 as f32, 2.5, false)
joinAnn(1.5 as f32, 2.5, false)
const r_f32_f64_false = joinRet(1.5 as f32, 2.5, false)
print(r_f32_f64_false.length)
const s_f32_f64_false = stmtRet(1.5 as f32, 2.5, false)
print(s_f32_f64_false.length)
joinMoved(1.5 as f32, 2.5, false)
