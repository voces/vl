// @run
// @warning Unused parameter
// @hint redundant type annotation
// @log true
// @log 1
// @log true
// D7482: comparing a delivered generic with its name constrains no call, so the generic is
// still delivered at another type afterwards.
function two<T>(x: T): i32 { return 1 }
const p: (x: i32) => i32 = two
print(p == two)
const r: (x: string) => i32 = two
print(r("a"))
print(r == two)
