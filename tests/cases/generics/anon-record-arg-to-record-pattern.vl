// @run
// @log 5
// @log x
// @log 7
// @log 7
// @log true
// @log 7
// @log b
// @log b
// D3123: an inferred record argument to a generic record pattern binds its type parameter from
// the literal's spelled shape; one whose field holds a literal union keeps master's path.
function g<T>(b: { m: T }): T { b.m }
print(g({ m: 5 }))
const o = { m: "x" }
print(g(o))
const xs = [7]
print(g({ m: xs })[0])
const v: {[i32]: i32} = Map()
v[3] = 7
print(g({ m: v })[3] ?? -1)
const s: Set<i32> = Set()
s.add(7)
print(g({ m: s }).has(7))
function mk(): {[i32]: i32} { const q: {[i32]: i32} = Map(); q[3] = 7; q }
print(g({ m: mk() })[3] ?? -1)

type AB = "a" | "b"
function g2<T>(b: { m: T, n: i32 }): T { b.m }
const lv: {[i32]: AB} = Map()
lv[2] = "b"
const lo = { m: lv, n: 1 }
print(g2(lo)[2] ?? "a")
print(g2({ m: lv, n: 2 })[2] ?? "a")
