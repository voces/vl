// @run
// @log z
// @log 2
// @log 1
// @log 2
// @log 1.5
// @log 2
// @log 1
// @log 2
// @log 3
// @log q
// @log q
// @log 1
// @log 2.5
// @log 2.5
// @log 1
// The complement of `is i32[]` over a generic body's inferred `T[] | i32[]`, read at an index,
// through an alias, as a list element, in a closure and by a `for … in`: each reads the arm the
// checker recorded at the pin, `T[]`.
function w<T>(t: T, b: boolean) {
  if b { return [t, t] }
  [1, 2, 3]
}

function c1<T>(t: T, b: boolean) {
  const v = w(t, b)
  if v is i32[] {
    print(v.length)
  } else {
    const e = v[0]
    print(e)
    const a = v
    print(a.length)
    const bx = [v]
    print(bx.length)
    const f = () => v.length
    print(f())
  }
}

function c2<T>(t: T, b: boolean) {
  let v = w(t, b)
  if !(v is i32[]) {
    for x in v { print(x) }
  }
  v = [9]
  print(v.length)
}

c1("z", true)
c1(1.5, true)
c1(true, false)
c2("q", true)
c2(2.5, true)
