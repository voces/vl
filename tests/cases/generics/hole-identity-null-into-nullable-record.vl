// @run
// @log true
// @log true
// @log true
// @log true
// @log 4
// @log 2
// D8400: a hole identity called with `null` returns the `nullref` its parameter is pinned at,
// delivered to a nullable-record binding, map value, return and argument.
type C = { a: i32, b: i32 }
function hid(x) { x }
const nn = null
const t: C | null = hid(null)
print(t == null)
const m: { [string]: C | null } = Map()
m.set("k", hid(nn))
print(m["k"] == null)
function ret(): C | null { return hid(nn) }
print(ret() == null)
function take(c: C | null) { print(c == null) }
take(hid(null))
print(hid(3) + 1)
const c2: C | null = hid({ a: 1, b: 2 })
if c2 != null { print(c2.b) }
