// @log 3
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// The neighbours of the refusal beside this file, which run: a nested generic reached
// from a lambda inside its own instance, one called from a sibling at a single instance,
// one that captures nothing, and a redeclared `T` whose captures are not typed at it.
function viaOwnLambda<T>(x: T) {
  function inner<U>(u: U, n: i32) {
    print(x)
    const again = () => {
      if n > 0 { inner(u, n - 1) }
    }
    again()
  }
  inner(1, 1)
}
viaOwnLambda(7)
viaOwnLambda("s")
function oneInstance<T>(x: T) {
  function inner<U>(_u: U) { print(x) }
  function other() { inner(true) }
  other()
}
oneInstance(7)
function noCapture<T>(x: T) {
  function inner<U>(u: U) { print(u) }
  function other() { inner(x) }
  other()
}
noCapture(7)
noCapture("s")
function shadowOther<T>(_x: T, k: string) {
  function inner<T>(u: T) {
    print(k)
    print(u)
  }
  inner(3)
  inner("q")
}
shadowOther(true, "K")
shadowOther(2.5, "L")
function shadowNoCapture<T>(x: T) {
  function inner<T>(u: T) { print(u) }
  inner(x)
  inner(3)
}
shadowNoCapture(true)
shadowNoCapture("s")
