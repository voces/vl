// @run
// @log bool
// @log is
// @log is
// The union-pattern twin of `pin-same-rep-maps-is.vl`: `is IS` at a pin of `IM | BM | string`
// names one of the two same-rep maps, and its tag test answers for that map alone.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
type IS = IM | string
const mb: BM = Map()
mb.set(1, true)
const mi: IM = Map()
function k<T>(u: T) {
  if u is IS { print("is") } else { print("bool") }
}
const v: IM | BM | string = mb
k(v)
const v2: IM | BM | string = mi
k(v2)
const v3: IM | BM | string = "s"
k(v3)
