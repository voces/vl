// @run
// @log 15
// @log 15
// D8342's annotated face: the parameter declares the stored row `Col`, so `is J` narrows to the
// meet and `??` over the flat field folds to the field.
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function mk() { { r: 15, g: 1 } }
function take(a: Col) {
  const v = a
  if v is J { print(v.r ?? 0) } else { print(0) }
}
function takeDirect(a: Col) {
  if a is J { print(a.r ?? 0) } else { print(0) }
}
take(mk())
takeDirect(mk())
