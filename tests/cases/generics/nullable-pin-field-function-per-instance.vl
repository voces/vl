// @run
// @log true
// @log 7
// @log false
// @log s
// Records differing only in a function field, passed at a `Z | null` pin, each call and print
// their own field's result in their own instance (D3124).
function F<Z>(z: Z | null) {
  if z != null { print(z.f()) }
}
const r0 = { f: () => true }
const q0: { f: () => boolean } | null = r0
F(q0)
const r1 = { f: () => 7 }
const q1: { f: () => i32 } | null = r1
F(q1)
function G<Z>(z: Z | null) {
  if z != null { print(z.f(1)) }
}
const s0 = { f: (a: i32) => a > 1 }
const p0: { f: (i32) => boolean } | null = s0
G(p0)
const s1 = { f: (a: i32) => if a < 0 { "n" } else { "s" } }
const p1: { f: (i32) => string } | null = s1
G(p1)
