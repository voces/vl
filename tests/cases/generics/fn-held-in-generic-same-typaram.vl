// @run
// @log ss
// @log 6
// @log ss
// @log ss
// @log ss
// @log ss
// @log ss
// @log ss
// @log 3
// @log ss
// @log 2.5
// A generic function held in a list element, a record field or a call result, called inside a
// generic body whose type parameter has the callees' name (D9190).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function ku<U>(t: U): U { return t + t }
function pick() { return kg }
function pickc() { return if c { kg } else { idg } }
const c = [1].length > 0
const n = [1].length
function listed<T>(v: T): T {
  const fs = [if c { kg } else { idg }]
  print(fs[0]("s"))
  return v
}
function listedAtV<T>(v: T): T {
  const fs = [if c { kg } else { idg }]
  print(fs[0](v))
  return v
}
function mixed<T>(v: T): T {
  const fs = [if c { ku } else { idg }]
  print(fs[0]("s"))
  return v
}
function field<T>(v: T): T {
  const r = { h: if c { kg } else { idg } }
  print(r.h("s"))
  const q = {
    h: match n {
      1 => kg
      _ => idg
    },
  }
  print(q.h("s"))
  return v
}
function returned<T>(v: T): T {
  print(pick()("s"))
  print(pickc()("s"))
  return v
}
listed(1)
listedAtV(3)
mixed(1)
field(1)
returned(1)
print(listed(3))
print(listed(2.5))
