// @run
// @log true
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log false
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log false
// @log false
// @hint redundant type annotation: `bs` is inferred as `boolean[]`
// @hint redundant type annotation: `bs2` is inferred as `boolean[]`
// @hint redundant type annotation: `bss` is inferred as `boolean[][]`
// A `boolean[]` ARGUMENT to a generic printed its elements as `0`/`1`. Every line below is
// paired with its CONCRETE TWIN — the same program with the type parameter replaced by the
// actual type — so the two agreeing IS the assertion, and the twin is what the generic was
// silently disagreeing with.
//
// TWO roots compose here, and each is a classifier ladder whose arm set was a shortened
// mirror of a sibling's:
//
//  * a `boolean[]` shares the i32 list REP exactly (`nameIsI32Array` says so), so only the
//    element's PRINT formatting recovers boolean-ness, and `listElemIsBool` is that one
//    home. It resolved its receiver from a `let` local or a module global and had no PARAM
//    arm and no nested-INDEX arm — the two its rep siblings (`exprStringArray` and family)
//    both carry. Outside a generic the checker's node-type bank answers first and masks the
//    gap; inside a MONOMORPHIZED INSTANCE the body is a clone the checker never typed, so
//    the substituted parameter ANNOTATION is the only boolean-ness left and the gap is the
//    whole answer. `listAnnNameOf` is now the one home for all four storage classes.
//
//  * for that annotation to say `boolean[]` at all, `monoArgTyName` has to be able to SPELL
//    the pin. The rep cascade cannot — `exprArray` claims the argument and answers `i32[]` —
//    so the checker's own element name is read instead (`nodeArrayElemName`), the same way
//    the map arm reads `nodeTyMapName` rather than asking a rep classifier.
//
// The FORWARDER line is what makes the arm set's DUPLICATION load-bearing rather than
// stylistic: the inner call's argument is a PARAM of the outer instance, so it is answered
// by the param arm, and while the annotated-LOCAL and PARAM ladders were two verbatim
// copies the direct call was right and the forwarded one was wrong. They are one home
// (`monoAnnPinName`) now.

function gtake<T>(x: T) { print(x[0]) }
function ctake(x: boolean[]) { print(x[0]) }

// the FORWARDER: the inner generic's argument is the outer instance's own parameter
function ginner<T>(x: T) { print(x[0]) }
function gfwd<T>(x: T) { ginner(x) }
function cfwd(x: boolean[]) { ctake(x) }

// the `T[]` shape binds T to the ELEMENT, so the instance reads `xs[0]` over a `boolean[]`
function gelem<T>(xs: T[]) { print(xs[0]) }
function celem(xs: boolean[]) { print(xs[0]) }

// a NESTED boolean list: the element read is an INDEX over an INDEX, the arm
// `exprStringArray` carries for its own nested case
function gnest<T>(x: T) { print(x[0][0]) }
function cnest(x: boolean[][]) { print(x[0][0]) }

function main() {
  const bs: boolean[] = [true, false]
  gtake(bs) // true
  ctake(bs) // true

  const bs2: boolean[] = [false, true]
  gtake(bs2) // false
  ctake(bs2) // false

  gfwd(bs) // true
  cfwd(bs) // true

  gfwd(bs2) // false
  cfwd(bs2) // false

  gelem(bs) // true
  celem(bs) // true

  // a BARE list literal reaches no annotation arm at all: it is the CASCADE's cell, and
  // `exprArray` would claim it and answer `i32[]`. Its own pin comes from the checker's
  // recorded element name.
  gtake([true, false]) // true
  ctake([true, false]) // true

  const bss: boolean[][] = [[true, false]]
  gnest(bss) // true
  cnest(bss) // true

  // the BARE nested LITERAL takes a different arm from the annotated binding above:
  // `arrLitElemName`'s nested rung names the inner list by its leaf and has no boolean
  // member, so this one is pinned from the checker's whole array type instead.
  gnest([[false, true]]) // false
  cnest([[false, true]]) // false
}
main()
