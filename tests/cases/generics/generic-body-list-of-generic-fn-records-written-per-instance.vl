// @run
// @log 3
// @log ab
// @log 3
// @log 3
// @log ab
// @log ab
// @log 3
// @log ab
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_x`
// A generic body's bound list literal of records holding a generic function is built at each
// instance's own `T`, whether the list is pushed onto or index-written, and read by index or by a
// `for` straight over the call (D16234).
function id<T>(x: T): T { return x }
function pushed<T>(_x: T) {
  const rs = [{ f: id }]
  rs.push({ f: id })
  return rs
}
function written<T>(_x: T) {
  const rs = [{ f: id }, { f: id }]
  rs[1] = { f: id }
  return rs
}
print(pushed(3)[0].f(3))
print(pushed("ab")[0].f("ab"))
for r in pushed(3) { print(r.f(3)) }
for r in pushed("ab") { print(r.f("ab")) }
print(written(3)[0].f(3))
print(written("ab")[0].f("ab"))
