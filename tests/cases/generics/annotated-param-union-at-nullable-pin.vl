// @run
// @log n
// @log s
// @log null
// @log s
// @log n
// @log null
// @log n
// @log null
// @log n
// @log 7
// @log null
// A declared `A | B | null` return whose pin binds a parameter to `string | null` is one
// nullable string, not `string | null | string | null`: the instance built a value box nothing
// declared, and the caller refused `string | null` into `string | null` (D3499).
type Rec = { x: i32 }
const ns: string | null = "n"
function F<A, B>(k: i32, a: A, b: B): A | B | null {
  if k == 0 { a }
  else if k == 1 { b }
  else { null }
}
function G<A, B>(k: i32, a: A, b: B): A | B | null {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
print(F(0, ns, "s"))
print(F(1, ns, "s"))
print(F(2, ns, "s"))
print(G(0, "s", ns))
print(G(1, "s", ns))
print(G(2, "s", ns))
const r: string | null = F(0, ns, ns)
print(r)
print(F(2, ns, ns))
const r7: Rec = { x: 7 }
const u = F(0, ns, r7)
if u is Rec { print(u.x) } else { print(u ?? "s") }
const t = F(1, ns, r7)
if t is Rec { print(t.x) } else { print(t ?? "s") }
const e = F(2, ns, r7)
if e is Rec { print(e.x) } else { print(e) }
