// @run
// @log x
// @log 3
// One generic handed through `const` bindings of its name to two parameters of one type parameter,
// each called at another type, binds the parameter once to its set.
function sameG<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F) {
  take(a)
  take2(a1)
}
const s = sameG
const s2 = s
mid(s2, s)
