// @run
// @log 1.5
// @log 5
// @log s
// @log 1
// @log s
// @log 7
// @log q
// D2433: an un-annotated lambda parameter the checker inferred at a type variable is annotated
// at each pin, so the lifted lambda and its caller agree on the rep. D2113: a loop variable
// captured into a lambda of a two-instance generic is called at each instance's signature.
// D2457: a nested generic's un-annotated lambda over the outer `T` is pinned per instance.
function apply<A, B>(f: (A) => B, a: A): B { f(a) }
const x: f32 = 3
print(apply((q) => q, x) / 2)
const n: i32 | null = null
print(apply((q) => q ?? 5, n))
const u: string | i32 = "s"
const r = apply((q) => q, u)
if r is string { print(r) }

function ap<T>(fs: ((T) => T)[], v: T): void {
  for f in fs {
    const h = () => {
      f(v)
    }
    h()
  }
}
function pi(v: i32) {
  print(v)
  return v
}
function ps(v: string) {
  print(v)
  return v
}
ap([pi], 1)
ap([ps], "s")

function outer<T>(v: T) {
  function inner<U>(f: (U) => U, y: U) { return f(y) }
  return inner((w) => w, v)
}
print(outer(7))
print(outer("q"))
