// @run
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 5
// @log 4
// @log true
// @log 6
// @log true
// A nested generic delivered as a value where the enclosing `T` types the function runs where
// that pin satisfies its demand, or where the destination is concrete (D3896).
function returned<T>(_x: T): (T) => void {
  function b<U>(y: U) {
    const n: i32 = y
    print(n + 1)
  }
  return b
}
returned(4)(4)
function bound<T>(x: T) {
  function b<U>(y: U) {
    const n: i32 = y
    print(n + 1)
  }
  const f: (t: T) => void = b
  f(x)
}
bound(3)
function concrete<T>(x: T): (n: i32) => void {
  function b<U>(y: U) {
    const n: i32 = y
    print(n + 1)
  }
  print(x)
  return b
}
concrete(true)(5)
function printer<T>(_x: T): (T) => void {
  function b<U>(y: U) { print(y) }
  return b
}
printer(true)(true)
