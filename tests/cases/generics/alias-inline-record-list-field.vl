// @run
// @log 4
// @log yz
// @log 6
// @log 1
// @log 9
// @log 3
// @log 3
// @log a
// D11450: a generic alias whose field is a list of an inline record over its parameter has
// a list rep at every application, delivered as a literal, a binding, a return or a list
// element; the alias's own field mints no slot an application's element could dedup onto.
type B<U> = { s: { g: U }[] }
type C<U> = { s: { g: U }[] | null, t: { g: U, h: U[] }[] }

function f<T>(v: B<T>): T { v.s[1].g }
function n<T>(v: B<T>) { v.s.length }
function mk(): B<i32> { { s: [{ g: 7 }, { g: 8 }] } }
function hl<T>(v: C<T>) { v.t[0].h.length }

const a = { s: [{ g: 3 }, { g: 4 }] }
const b: B<string> = { s: [{ g: "x" }, { g: "yz" }] }
print(f(a))
print(f(b))
print(f({ s: [{ g: 5 }, { g: 6 }] }))
print(n({ s: [{ g: "p" }] }))
print(mk().s[1].g + 1)
const c: B<i32>[] = [{ s: [{ g: 9 }] }, a]
print(c[1].s[0].g)
print(hl({ s: null, t: [{ g: 1, h: [1, 2, 3] }] }))
const y: C<string> = { s: [{ g: "a" }], t: [] }
const ys = y.s
if ys != null { print(ys[0].g) }
