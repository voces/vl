// @run
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 3
// @log g
// @hint redundant type annotation: `xs` is inferred as `{[string]: {r: i32 | null}}[]` — remove it to lean on inference
// @hint Intentionally-unused variable `_u` (leading `_` marks it unused)
// A generic call's argument read from a binding the calling body captures pins at that binding's
// type: an enclosing function's parameter or local, annotated or not, in a nested function or a
// lambda; and a list of maps of records pins by its whole spelling.

type U = { r: i32 } | i32

function idg<T>(x: T): T { return x }

function byParam(c: { r: i32 }) {
  function inner() { print(idg(c).r) }
  inner()
  const lam = () => idg(c).r + 1
  print(lam())
}
byParam({ r: 5 })

function byLocal() {
  const a: { r: i32 } = { r: 7 }
  const b = { r: 8 }
  const lam = () => {
    print(idg(a).r)
    print(idg(b).r)
  }
  lam()
}
byLocal()

const m: {[string]: { r: i32 | null }} = Map()
m["k"] = { r: 9 }
const xs: {[string]: { r: i32 | null }}[] = [m]
print(idg(xs)[0]["k"]?.r ?? 0)

const c: string = "g"
function shadow() {
  const c: { r: i32 } = { r: 3 }
  const lam = () => {
    print(idg(c).r)
  }
  lam()
}
shadow()
print(idg(c))
const _u: U = 1
