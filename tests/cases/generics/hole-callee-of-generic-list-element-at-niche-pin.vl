// @run
// @log b
// @log null
// @log true
// @log null
// @log b
// @log null
// @log false
// A hole callee handed an element of a list built over `T` inside an explicit instance pinned to
// a nullable niche, `K | null` or `boolean | null`, returns the member rather than its `i32`
// (D2985), and so does a generic callee (D2945).
type AB = "a" | "b"
function idh(z) { return z }
function f<T>(x: T) {
  const l = [x]
  print(idh(l[0]))
}
const v: AB | null = "b"
f(v)
const vn: AB | null = null
f(vn)
const b: boolean | null = true
f(b)
const bn: boolean | null = null
f(bn)
const ab: AB = "b"
f(ab)
function id<U>(t: U): U { return t }
function h<T>(x: T) {
  const l0 = [x]
  print(id(l0[0]))
}
h(bn)
const bf: boolean | null = false
h(bf)
