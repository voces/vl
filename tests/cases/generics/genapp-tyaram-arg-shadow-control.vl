// @run
// @log 1
// @log 3
// @log 1
// @log 1.5
// @log b
// @log 3
// THE CONTROLS for `error-genapp-tyaram-arg-elem-array.vl`. The generic-original skip in
// `gaeEnsure` keys on a FuncDecl type parameter that does NOT name a real type, so all
// three neighbours must keep interning and running:
//
//   · the SHADOW — `type T` is declared, so the parameter `<T>` binds nothing and `Box<T>`
//     is a CONCRETE application (the ruling `genTyParamArr`'s header states and
//     `type-param-shadows-alias-through-constructors.vl` pins at eight constructors);
//   · a concrete application at a builtin, `Box<i32>`;
//   · the same shadowed application with no generic function in sight at all.
type T = { x: i32 }

type Box<X> = { v: X[] }

type Cell<X> = { v: X }

function shadowed<T>(b: Box<T>) {
  b.v.length
}

function concrete(b: Box<i32>) {
  b.v.length
}

function plain(b: Box<T>) {
  b.v.length
}

// A parameter named for a PRIMITIVE binds nothing (`gaeParamShadowed` — the checker's
// `primTyOfName`-first resolution order read as a predicate), so these applications are
// CONCRETE and must still intern. The guard's borrowed array accept set covers only `i32`
// and `boolean` among the primitives, so without `gaeParamShadowed` beside it these four
// spellings (`f64`/`i64`/`f32`/`string`) were skipped and the parameter position that needs
// the interned row failed on a program master runs.
function shadowF64<f64>(b: Cell<f64>) {
  b.v
}

function shadowStr<string>(b: Cell<string>) {
  b.v
}

// A CONCRETE array argument — the leaf peel must not claim it.
function concreteArr(b: Cell<i32[]>) {
  b.v.length
}

print(shadowed({ v: [{ x: 1 }] }))
print(concrete({ v: [1, 2, 3] }))
print(plain({ v: [{ x: 9 }] }))
print(shadowF64({ v: 1.5 }))
print(shadowStr({ v: "b" }))
print(concreteArr({ v: [7, 8, 9] }))
