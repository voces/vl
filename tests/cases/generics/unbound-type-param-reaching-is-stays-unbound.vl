// @emit-error `is` names a type that is not a union variant
// A type parameter no parameter names is defaulted at an inferred call only while no `is` or
// `T.field` can read the default (D4551). Here `T` reaches `x is U` through `h<T>`, so it stays
// unbound and the call keeps the refusal it had before the default existed.
function h<U>(x: i32 | string): i32 {
  if x is U { return 1 }
  0
}
function f<T>(x: i32 | string): i32 { return h<T>(x) }
print(f(1))
print(f("s"))
