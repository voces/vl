// @run
// @log 1.5
// @log q
// @log 9
// @log true
// @log 6
// @log abc
// D2552: a value call inside a generic keyed its `$fnsig` off the callee's recorded type, which
// in the template names the type parameter. A callee that is not a bound lambda (a call's
// result, a parenthesised literal) keyed no signature at `f64` or `string`, and at a second
// instance took the first's; a recursive call forwarding its own callback (D2545) had no pin
// for the argument. Callees and function arguments now carry their type at the binding.
function twice<T>(r: T): T {
  const f = () => () => r
  const h = f()
  return h()
}
function nested<T>(r: T): T {
  const f = () => () => r
  return f()()
}
const big: i64 = 9
print(twice(1.5))
print(twice("q"))
print(nested(big))
print(nested(true))
function fold<T, A>(xs: T[], i: i32, acc: A, f: (A, T) => A): A {
  if i >= xs.length { return acc }
  return fold(xs, i + 1, f(acc, xs[i]), f)
}
print(fold<i32, i32>([1, 2, 3], 0, 0, (a: i32, b: i32): i32 => a + b))
print(fold(["a", "b", "c"], 0, "", (a: string, b: string): string => a + b))
