// @run
// @log ok
// @log hmm
// @log two
// @log yes
// @log no-match
// @log int
// An `is` test against an ANONYMOUS SHAPE inside an un-annotated (monomorphized) param.
// The static-`is` guard decides `v is T` per instance, and it compared the instance's
// bound type name with the tested name by STRING EQUALITY. An object-literal argument
// binds that name to its INTERNED ROW name (`#anon0`, minted by `collectAnonShapes`)
// while the test carries the source spelling (`{foo: string}`), so the compare said NO
// and `hello({foo: "ok"})` silently took the ELSE arm — a WRONG ANSWER, not a loud one.
// Both sides now resolve to a struct ROW (`structIndexByName` / `repRowOfName`'s
// canonical key, layout twins accepted) and compare structurally.
//
// The i32 instance exposed the dual: with the guard statically FALSE the then-branch
// was still emitted, and `v.foo` on an i32 has no struct receiver ("field access but no
// struct type declared"). A provably-dead arm of a mono `is` guard is now skipped.
function hello(v) {
  if v is { foo: string } then return v.foo
  return "hmm"
}

// The block form, and a shape that must NOT match (different field set).
function pick(v) {
  if v is { a: i32, b: string } { return v.b }
  return "no-match"
}

// A second static arm in the same body: the dead-arm skip must not disturb the live one.
function kind(v) {
  if v is { foo: string } then return v.foo
  if v is i32 then return "int"
  return "other"
}

print(hello({ foo: "ok" }))
print(hello(3))
print(hello({ foo: "two" }))
print(pick({ a: 1, b: "yes" }))
print(pick({ foo: "zzz" }))
print(kind(7))
