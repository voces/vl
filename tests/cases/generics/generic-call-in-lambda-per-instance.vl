// @run
// @log 7
// @log q
// @log 8
// @log s
// D2553: a generic call inside a lambda that a generic body clones per instance was
// instantiated once, from the template lambda's walk, at the type parameter's default. Every
// clone called that one instance. Each clone now takes its own copy of the call and walks it.
function id<U>(x: U): U { return x }
function capture<T>(r: T): T {
  const f = () => id(r)
  return f()
}
function param<T>(r: T): T {
  const f = (x: T) => id(x)
  return f(r)
}
print(capture(7))
print(capture("q"))
print(param(8))
print(param("s"))
