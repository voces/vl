// @run
// @log b
// @log a
// @log b
// A `let` bound to a join of two parameters pinned at one literal union holds the atom, and an
// assignment of one of them into it stores the atom, not a box (D3268's parted join).
type K = "a" | "b"
function g<T, U>(a: T, b: U, k: i32) {
  let r = if k == 0 { a } else { b }
  if k == 2 { r = a }
  print(r)
}
const xa: K = "b"
const xb: K = "a"
g(xa, xb, 0)
g(xa, xb, 1)
g(xa, xb, 2)
