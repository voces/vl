// @run
// @log 15
// @log 16
// @log 17
// @log 18
// @log 19
// @log 20
// @log 1
// D8303: a fresh call handed through nested generic identities, each pinned only by the call
// inside, is built at the record its delivery lands on, though a declared record (`Col`) spells
// its own fields: two and three identities, an argument, a return, a list element, under a
// wrapper, and beside a direct call into the same record.
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function idn<T>(v: T): T { v }
function mkA() { { r: 15, g: 1 } }
function mkB() { { r: 16, g: 1 } }
function mkC() { { r: 17, g: 1 } }
function mkD() { { r: 18, g: 1 } }
function mkE() { { r: 19, g: 1 } }
function mkF() { { r: 20, g: 1 } }
function wrapE() { return idn(idn(mkE())) }
function take(j: J) { print(j.r ?? 0) }
function give(): J { return idn(idn(mkC())) }

const a: J = idn(idn(mkA()))
print(a.r ?? 0)
const b: J = idn(idn(idn(mkB())))
print(b.r ?? 0)
print(give().r ?? 0)
take(idn(idn(mkD())))
const e: J = idn(wrapE())
print(e.r ?? 0)
const fs: J[] = [idn(idn(mkF()))]
print(fs[0].r ?? 0)
const f2: J = mkF()
print(f2.g)
