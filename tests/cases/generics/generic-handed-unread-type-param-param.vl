// @run
// @hint Intentionally-unused parameter `_a1` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_a1` (leading `_` marks it unused)
// @log 1
// @log x
// @log s
// A generic handed to a type-parameter parameter the body never reads builds, alone and beside
// a parameter that is called (D6763).
function same<T>(k: T): T { k }
function mid<G>(_a1: G) { print(1) }
mid(same)
function pair<F, G>(a: F, _a1: G) { print(a("x")) }
pair(same, same)
print(same("s"))
