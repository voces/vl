// @run
// @log 1
// @log 7
// D14720: a list of records no declared type names, read out of a hole's field and handed to a
// second hole callee, pins at the elaboration's type: the filed program, and a binding of the read.
function popf(a) { a.pop() }
function t4(z) {
  popf(z.xs)
  print(z.xs.length)
}
t4({ xs: [{ n: 1 }, { n: 2 }] })
function first(a) { return a[0].n }
function t5(z) {
  const ys = z.xs
  print(first(ys))
}
t5({ xs: [{ n: 7 }, { n: 8 }] })
