// @run
// @log none
// @log none
// @log none
// @log none
// @log true
// A guarded call through a field typed `null` itself is a dead branch, so it lowers to
// `unreachable` even when no declared row gives the field a function layout (D3197).
function F(z) {
  if z.f != null { print(z.f()) } else { print("none") }
}
F({ v: 7, f: null })
function G<Z>(z: Z) {
  const g = z.f
  if g != null { print(g()) } else { print("none") }
}
G({ v: 7, f: null })
const r = { v: 8, f: null }
function S(z) {
  if z.f != null { print(z.f()) } else { print("none") }
}
S(r)
S({ v: 9, f: null })
F({ v: 8, f: () => true })
