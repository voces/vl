// @run
// @log false
// @log true
// @log false
// @log true
// @log true
// @log false
// A union parameter over `T` boxes a Set and its boolean map under one tag, so an exact
// instance answers `is` from the member set it binds, not from the tag (D2720).
function f<T>(u: T | string) { print(u is Set<i32>) }
function g<T>(u: T | null | i32) { print(u is Set<i32>) }
function h<T>(u: T | string) { print(u is {[i32]: boolean}) }
const s: Set<i32> = Set()
const m: {[i32]: boolean} = Map()
f<{[i32]: boolean}>(m)
f<Set<i32>>(s)
g<{[i32]: boolean}>(m)
g<Set<i32>>(s)
h<{[i32]: boolean}>(m)
h<Set<i32>>(s)
