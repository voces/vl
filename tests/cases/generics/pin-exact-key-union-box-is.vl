// @run
// @log false
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// @log true
// A union parameter over `T` boxes a Set and its boolean map under one tag, so an exact
// instance answers `is` from the member set it binds, not from the tag (D2720), and a map's
// value union matches in any member order, at a pin or beside `null` (D2733).
function f<T>(u: T | string) { print(u is Set<i32>) }
function g<T>(u: T | null | i32) { print(u is Set<i32>) }
function h<T>(u: T | string) { print(u is {[i32]: boolean}) }
const s: Set<i32> = Set()
const m: {[i32]: boolean} = Map()
f<{[i32]: boolean}>(m)
f<Set<i32>>(s)
g<{[i32]: boolean}>(m)
g<Set<i32>>(s)
h<{[i32]: boolean}>(m)
h<Set<i32>>(s)
function o<T>(u: T | string) { print(u is {[string]: i32 | string}) }
const x: {[string]: string | i32} = Map()
o<{[string]: string | i32}>(x)
const n: {[string]: string | i32} | null = x
print(n is {[string]: i32 | string})
print(n is {[string]: string | i32})
