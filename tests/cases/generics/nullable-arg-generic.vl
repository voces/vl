// @run
// @log hi
// @log hi
// @log 0
// @log 1
// @log hi
// @log hi
// @hint redundant type annotation: `t` is inferred as `string` — remove it to lean on inference
// A NULLABLE-REF ARGUMENT AT A GENERIC CALL, at both scopes.
//
// The MODULE-SCOPE one used to check clean (`vl check` rc 0) and emit a module that does not
// instantiate — `type mismatch: expected (ref $type), found (ref null $type)`, which is word
// for word the failure `monoNulAnnName` exists to prevent. Graduated from
// `soundness/xfail-miscompile-nullable-ref-generic-arg.vl`, which absorbed
// `nullable-arg-generic-controls.vl` on the way.
//
// THE PIN LOST THE `| null`, AND ONLY AT MODULE SCOPE. Every channel `monoArgTyName`
// consults answers about the REP, and a nullable's rep is its non-null base by design — a
// `string | null` parameter takes the string ops after narrowing — so the cascade names the
// argument `string`, the instance declares a NON-NULL parameter, and the caller hands it the
// nullable ref. `monoNulAnnName` is the arm that makes the nullability RIDE the pin, and it
// sat only on the annotated-LOCAL and PARAM arms, both behind `fnIx >= 0`. A top-level
// `const s: string | null` reached neither: the identical program inside a `function main()`
// body compiled and ran, which is the second arm below and is what localised this.
//
// THE SCOPE AXIS IS THE LESSON, not the nullability. The module-scope twin one line above
// the fix already existed for the composite-element list question and had been widened for
// exactly the same reason — a generic call whose argument is a top-level `const xs: i32[][]`
// reaching none of the function-scoped arms. Two questions, one missing scope, found a
// release apart.
//
// THE LAST THREE ARMS ARE THE CONTROLS that always worked, and they place the defect: a
// `boolean | null` argument (an i32 SENTINEL, so no nullable-ref valtype to get wrong), the
// same shape NON-generic (no pin is minted at all), and a plain `string` through the same
// generic (the pin working correctly). An `i32 | null` argument fails LOUDLY (rc 1, no module
// emitted) and is a different defect, deliberately not folded in.
function id<T>(v: T): T {
  return v
}

function idPlain(v: string | null): string | null {
  return v
}

const s: string | null = "hi"
const r = id(s)
if r != null { print(r) } else { print(0) }

function main() {
  const inner: string | null = "hi"
  const ri = id(inner)
  if ri != null { print(ri) } else { print(0) }

  const gone: string | null = null
  const rg = id(gone)
  if rg != null { print(rg) } else { print(0) }
}
main()

const b: boolean | null = true
const rb = id(b)
if rb != null { print(1) } else { print(0) }

const sp: string | null = "hi"
const rp = idPlain(sp)
if rp != null { print(rp) } else { print(0) }

const t: string = "hi"
print(id(t))
