// @run
// @log false
// @log false
// @log false
// @log false
// @log false
// @log 8
// @log true
// A generic's `A | B | null` result at two nullable lists of same-shape records is one
// nullable list, the type the same set spelled directly has, at every place it is delivered:
// a list literal, an annotated list, a binding, a return and a push (D14770, D14771).
type Rec = { x: i32 }
type Rec2 = { x: i32 }
const rl: Rec[] | null = [{ x: 7 }]
const r2: Rec2[] | null = [{ x: 8 }]
function F<A, B>(k: i32, a: A, b: B): A | B | null {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
function G<A, B>(k: i32, a: A, b: B): A | B {
  if k == 0 { return a }
  return b
}
const w = [F(1, r2, rl)]
print(w[0] == null)
const wa: (Rec2[] | Rec[] | null)[] = [F(1, r2, rl)]
print(wa[0] == null)
const v: Rec2[] | Rec[] | null = G(1, r2, rl)
print(v == null)
function H(): Rec2[] | Rec[] | null { return F(0, r2, rl) }
print(H() == null)
const ws: (Rec2[] | Rec[] | null)[] = []
ws.push(F(1, r2, rl))
print(ws[0] == null)
const h = H()
if h != null { print(h[0].x) }
print(F(2, r2, rl) == null)
