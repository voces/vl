// @run
// @log 7
// @log -1
// @log 9
// @log none
// @log 3
// D2525: a `(V | null)[]` whose element is a type parameter, in a generic function's
// signature and body, was refused at emit ("a nullable-V list element has no rep"); each
// instance (a scalar, a record) now builds its own list.
function put<V>(xs: (V | null)[], id: i32, v: V) {
  const none: V | null = null
  while xs.length <= id { xs.push(none) }
  xs[id] = v
}

function at<V>(xs: (V | null)[], id: i32): V | null {
  if id < 0 || id >= xs.length { return null }
  return xs[id]
}

const s: (i32 | null)[] = []
put(s, 3, 7)
print(at(s, 3) ?? -1)
print(at(s, 2) ?? -1)

type Tex = { w: i32 }
const q: (Tex | null)[] = []
put(q, 2, { w: 9 })
const r = at(q, 2)
if r != null { print(r.w) }
const miss = at(q, 5)
if miss == null { print("none") }
print(q.length)
