// @run
// @log null
// @log a
// @log x
// @log 7
// @log b
// @log w
// @log null
// A join of three bare type parameters keeps every member apart, and each pin re-joins them as
// the direct spelling would: `i32 | null`, `K` and `string` join as `i32 | string | null` with the
// atom widened to its string (D3266). The fourth arm adds a null (D3280's null-arm slice).
type K = "a" | "b"
function g<T, U, V>(a: T, b: U, d: V, k: i32) {
  const r = if k == 0 { a } else if k == 1 { b } else { d }
  return r
}
const x: i32 | null = null
const y: K = "a"
const z: string = "x"
print(g(x, y, z, 0))
print(g(x, y, z, 1))
print(g(x, y, z, 2))
function h<T, U, V>(a: T, b: U, d: V, k: i32) {
  const r = if k == 0 { a } else if k == 1 { b } else if k == 2 { d } else { null }
  return r
}
const x7: i32 | null = 7
const yb: K = "b"
print(h(x7, yb, "w", 0))
print(h(x7, yb, "w", 1))
print(h(x7, yb, "w", 2))
print(h(x7, yb, "w", 3))
