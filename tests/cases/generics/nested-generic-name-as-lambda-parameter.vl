// @run
// @log 2
// @log 2
// @log true
// A lambda parameter named like a nested generic is another binding, not an escape of it
// (D3853 review).
function a<T>(x: T) {
  function b<U>(y: U) { const n: i32 = y; print(n + 1) }
  const k = (b: i32) => b + 1
  print(k(1))
  b(x)
}
function c<T>(x: T) {
  function b<U>(y: U) { print(y) }
  b(x)
}
a(1)
c(true)
