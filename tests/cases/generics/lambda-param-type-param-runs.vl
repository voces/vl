// @run
// @log true
// @log true
// @log 2
// @log true
// @log 1
// @log true
// @log 5
// @hint redundant type annotation: `eqT` is inferred as `boolean`
// @hint redundant type annotation: `lenT` is inferred as `i32`
// @hint redundant type annotation: `eqNul` is inferred as `boolean`
// @hint redundant type annotation: `firstT` is inferred as `i32`
// @hint Intentionally-unused function `_uninstantiated` (leading `_` marks it unused)
// @hint redundant type annotation: `_uninstantiated` is inferred as `boolean`
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// @hint redundant type annotation: `ys` is inferred as `i32[]`
// @hint redundant type annotation: `ss` is inferred as `string[]`
// @hint redundant type annotation: `ts` is inferred as `string[]`
// @hint redundant type annotation: `grid` is inferred as `i32[][]`
// EVERY ANNOTATION IS DECLARED RATHER THAN REMOVED, for this directory's standing reason:
// each one names the shape under test — the generic's parameter type, the lambda's, and the
// value the cell builds — so deleting one to quiet a hint would be testing a different
// program.
// THE CLOSE OF `silent-class-inventory` D426 — a LAMBDA declared inside a generic body whose
// own parameter annotation names the enclosing `T`. This is the ACCEPT set; it replaces the
// `@emit-error` fixture that pinned D426's floor, which is retired with it because the
// program that fixture refuses now RUNS.
//
// WHAT WAS WRONG. `collectFns` runs BEFORE `monomorphize` and lifts `const g = (x: T[]) => …`
// exactly once, so ONE lifted function served every instance with `T` still written on its
// parameters — its `$fnsig` and its functype were built at the unsubstituted type, which
// lowers to the i32 default. Disassembled on master, the call was `call_indirect (type $N)`
// over `(func (param structref i32 i32) (result i32))` with two `(ref $list)` values pushed
// into the i32 slots. D426 answered that with a FLOOR (`emitProgram: parameter `T[]` still
// names an unsubstituted type parameter`), and its own close said so: a floor, not a fix, at
// a price of four running cells.
//
// WHAT IS RIGHT. A lambda in a generic body is a TEMPLATE in exactly the sense the enclosing
// generic is, and it is instantiated the same way — one lifted copy per pin, with the pin's
// own parameter types (`monoCloneLambdaSubst`, driven from the instance-body chain), and the
// template stubbed by `monomorphize`'s prune. Disassembled, the two-pin cell below emits TWO
// lambda functions, `(param structref (ref $i32List) (ref $i32List))` and
// `(param structref (ref $strList) (ref $strList))`, each called through its own functype.
//
// MEASURED on `scripts/silent-sweep/d426/lamgrid.py` (360 cells, lambda-parameter SHAPE × `T`
// binding × body, each generic cell beside the CONTROL that spells the annotation at the
// binding's concrete type): 68 cells moved, ALL of them to `runs`, 0 `runs` lost, 0 to silent
// — and the `gen` column now equals the `con` column exactly, which is the row's own
// criterion (the generic and the direct spelling are ONE ANNOTATION apart and must be one
// outcome apart).
//
// Every value is READ BACK, not merely built: a fixture that only compiles cannot tell a
// correct instance from one whose functype happens to validate.

// 1 — `T[]`, the filed witness, at two DIFFERENT pins of one generic. The template is lifted
//     once and instantiated twice; this is the cell whose disassembly names the mechanism.
function eqT<T>(a: T[], b: T[]): boolean {
  const g = (x: T[], y: T[]) => x == y
  return g(a, b)
}

// 2 — the same shape with a body that READS the parameter rather than comparing it.
function lenT<T>(a: T[], b: T[]): i32 {
  const g = (x: T[], y: T[]) => x.length + y.length
  return g(a, b)
}

// 3 — a BARE `T` parameter. D426's row filed this as already refused by a different rung; it
//     is the same family and the same message, and it runs now.
function idBare<T>(a: T): T {
  const g = (x: T) => x
  return g(a)
}

// 4 — `T | null`, the union-box niche. Two of these were the `runs` cells D426's floor cost
//     (`distilled/named/d426nul_*`), and buying them back is the reversal that row promised.
function eqNul<T>(a: T | null, b: T | null): boolean {
  const g = (x: T | null, y: T | null) => x == y
  return g(a, b)
}

// 5 — `T[][]`, a constructor two levels deep.
function firstT<T>(a: T[][]): i32 {
  const g = (x: T[][]) => x.length
  return g(a)
}

// 6 — a lambda template inside a generic that is NEVER INSTANTIATED. Nothing calls it,
//     so its own slot is stubbed by the prune and the lambda's must go with it — on master
//     the lifted lambda alone was enough to refuse the whole module.
function _uninstantiated<T>(a: T[]): boolean {
  const g = (x: T[], y: T[]) => x == y
  return g(a, a)
}

function body() {
  const xs: i32[] = [1, 2]
  const ys: i32[] = [1, 2]
  const ss: string[] = ["a"]
  const ts: string[] = ["a"]
  const nn: i32 | null = 5
  const grid: i32[][] = [[1]]
  print(eqT(xs, ys))
  print(eqT(ss, ts))
  print(lenT(ss, ts))
  print(eqNul(nn, nn))
  print(firstT(grid))
  print(idBare(true))
  print(idBare(5))
}
body()
