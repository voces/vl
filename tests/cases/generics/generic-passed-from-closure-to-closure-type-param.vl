// @run
// @log O
// @log 1
// @log O
// @log s
// @log O
// @log 1
// @log 7
// @log t
// A generic function handed from a closure to another closure's parameter typed by the enclosing
// generic's type parameter is instanced at that parameter's type in each instance (D3956): through
// a binding, a list element, and a capture written back.
function other<V>(v: V) {
  print("O")
  print(v)
}
function a<T>(x: T) {
  const w = (g: (t: T) => void) => {
    g(x)
  }
  const w2 = () => {
    w(other)
  }
  w2()
}
a(1)
a("s")
function b<T>(x: T) {
  const fs = [
    (g: (t: T) => void) => {
      g(x)
    },
  ]
  const w2 = () => {
    fs[0](other)
  }
  w2()
}
b(1)
function id<V>(v: V): V { return v }
function c<T>(x: T): T {
  let keep = x
  const w = (g: (t: T) => T) => {
    keep = g(x)
  }
  const w2 = () => {
    w(id)
  }
  w2()
  return keep
}
print(c(7))
print(c("t"))
