// @run
// @log 9
// @log 7
// @log 2
// A list whose element is a numeric literal union is stored as its base scalar, so a fill whose
// type argument names the union builds the base list (D3540).
import { filled } from "std:array"

type N = 1 | 2 | 7
const lits = filled<1 | 2 | 7>(2, 7)
lits[0] = 2
print(lits[0] + lits[1])
const named = filled<N>(2, 7)
print(named[1])
function mk<T>(n: i32, v: T): T[] { return __array_new__(n, v) }
const xs = mk<1 | 2>(2, 2)
print(xs[0])
