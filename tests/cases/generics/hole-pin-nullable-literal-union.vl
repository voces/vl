// @run
// @log b
// @log null
// @log b
// @log null
// @log b
// @log a
// @log b
// @log false
// @log b
// @log b
// @log b
// @log 3
// A hole or explicit instance pinned to `K | null` holds the atom niche, so a shared node read at
// the pin prints its member or `null`: an element of a local list (D2978), an element of the
// parameter itself, a capture beside a non-null instance, and a generic's own parameter (D2807).
type LS = "a" | "b"
function inList(v) {
  const l = [v]
  print(l[0])
}
const x: LS | null = "b"
inList(x)
const xn: LS | null = null
inList(xn)
function elem(v) {
  print(v[0])
  print(v[1])
}
const xs: (LS | null)[] = ["b", null]
elem(xs)
function cap(v) {
  const y = v[0]
  const c = () => y
  print(c())
}
const p: LS[] = ["b"]
cap(p)
const q: (LS | null)[] = ["a"]
cap(q)
function viaVar(v) {
  const e = v[0]
  print(e)
  print(e == null)
}
viaVar(xs)
function gen<T>(v: T) { print(v) }
gen(x)
function genElem<T>(v: T[]) {
  const e = v[0]
  print(e)
}
genElem(xs)
function genDirect<T>(v: T[]) { print(v[0]) }
genDirect(xs)
gen(3)
