// @run
// @log true
// @log 2.5
// @log s
// @log 4
// @log true
// @log 2.5
// @log s
// @log true
// @log 2.5
// @log s
// @log 4
// @log true
// @log 2.5
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// A list built off an enclosing function's parameter and read inside a nested generic or a
// lambda has the element's list rep, whether the parameter is annotated, a hole or a type
// parameter: the nested body reads the hole at the enclosing instance's binding.
type A = { v: i32 }
function annB(x: boolean) {
  const ys = [x, x]
  function inner<U>(_u: U) { print(ys[1]) }
  inner(1)
}
function annF(x: f64) {
  const ys = [x, x]
  function inner<U>(_u: U) { print(ys[1]) }
  inner(1)
}
function annS(x: string) {
  const ys = [x, x]
  const g = () => ys[0]
  print(g())
}
function annA(x: A) {
  const ys = [x, x]
  const g = () => ys[0].v
  print(g())
}
annB(true)
annF(2.5)
annS("s")
annA({ v: 4 })
function hole(x) {
  const ys = [x, x]
  function inner<U>(_u: U) { print(ys[1]) }
  inner(1)
}
function holeLam(x) {
  const ys = [x, x]
  const g = () => ys[0]
  print(g())
}
hole(true)
hole(2.5)
holeLam("s")
const a: A = { v: 4 }
function gen<T>(x: T) {
  const ys = [x, x]
  function inner<U>(_u: U) { print(ys[1]) }
  inner(1)
}
function genLam<T>(x: T): T {
  const ys = [x, x]
  const g = () => ys[0]
  g()
}
gen(true)
gen(2.5)
print(genLam("s"))
print(genLam(a).v)
function both(x) {
  const ys = [x]
  function inner<U>(_u: U) { print(ys[0]) }
  inner("k")
}
both(true)
both(2.5)
