// @run
// @log 2
// @log 2
// @log 3
// @log 1
// @log a
// @log 1
// @log 7
// A generic type ALIAS whose body puts the type PARAMETER under TWO or more arrays
// (`type Box<T> = { v: T[][] }`). The substitution takes the parameter's depth from the
// ARRAY-NAME grammar's leaf peel (`emit_base.gaeApplyFieldTy` over `arrLeafNameOf`) and
// re-attaches the same `[]` run to the argument, so `T[][]` at `Box<i32>` is `i32[][]`
// exactly as `T[]` at `Box<i32>` is `i32[]`.
//
// A ladder that knew only the spellings `T` and `T[]` returned `T[][]` UNCHANGED, and
// the instantiated shape then recorded its ref-list element as the un-substituted `T[]`
// — a STRUCT-element row — while the row the literal needs (`i32[]`, a nested i32 list)
// sat interned beside it with nothing pointing at it. The array-literal lowering then
// refused an array element in a struct-element list: "nested arrays are not supported",
// on a program whose concrete twin `type Box = { v: i32[][] }` lowers fine.
//
// Nesting was never the axis, and neither was the element type nor the type the
// application yields — `type-param-list-field-nested-arg.vl` spells the SAME
// `{v: i32[][]}` as `Box<i32[]>` over `{v: T[]}` and always ran. The axis is the depth
// the parameter sits at IN THE ALIAS BODY, which is what the leaf peel removes from the
// answer. `type-param-list-field.vl` is the depth-1 sibling and
// `type-param-list-field-uninstantiated.vl` the declaration-only one.
type Box<T> = { v: T[][] }

type Deep<T> = { v: T[][][] }

type Two<A, B> = { a: A, b: B[][] }

const bi: Box<i32> = { v: [[1, 2], [3]] }
print(bi.v.length)
print(bi.v[0][1])
print(bi.v[1][0])

const bs: Box<string> = { v: [["a"]] }
print(bs.v.length)
print(bs.v[0][0])

const d: Deep<i32> = { v: [[[9]]] }
print(d.v.length)

const t: Two<i32, string> = { a: 7, b: [["z"]] }
print(t.a)
