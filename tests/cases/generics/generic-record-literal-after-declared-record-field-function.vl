// @run
// @log true
// @log 11
// @log 2.5
// @log 4
// @hint redundant type annotation: `named` is inferred as `{f: () => boolean}` — remove it to lean on inference
// @hint redundant type annotation: `q` is inferred as `{f: () => f64}` — remove it to lean on inference
// A record literal passed to a generic after a declared record with the same field names gets
// its own instance, and calls its own field function rather than the declared record's (D3177).
type R = { f: () => boolean }
const named: R = { f: () => true }
function F<Z>(z: Z) { print(z.f()) }
F(named)
F({ f: () => 11 })
type Q = { f: () => f64 }
const q: Q = { f: () => 2.5 }
function G<Z>(z: Z) {
  const g = z.f
  print(g())
}
G(q)
G({ f: () => 4 })
