// @check
// @error argument of type string flows into `g` expecting i32 (the call's argument types)
// @error argument of type i32 flows into `g` expecting string (the call's argument types)
// @error argument of type string[] flows into `g3` expecting i32[] (the call's argument types)
// @error argument of type boolean flows into `g` expecting f64 — a `boolean` is not a number; convert it with `b as f64` (the call's argument types)
// Two distinct type parameters handed to one of a callee's are judged at each instance: an
// instance binding them apart is refused at the call, swapped, in a list, or one generic
// further out (D6426).
function g<T>(_x: T, y: T): T { return y }
function f<T, U>(a: T, b: U): T { return g(a, b) }
print(f(1, "s"))
function f2<T, U>(a: T, b: U): U { return g(b, a) }
print(f2(1, "s"))
function g3<T>(_x: T[], y: T[]): T[] { return y }
function f3<T, U>(a: T[], b: U[]): T[] { return g3(a, b) }
print(f3([1], ["s"]).length)
function h<A, B>(x: A, y: B): A { return f(x, y) }
print(h(1.5, true))
