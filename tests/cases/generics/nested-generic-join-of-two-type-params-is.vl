// @run
// @log false
// @log true
// @log true
// @log false
// @log false
// @log true
// @log false
// @log true
// @hint redundant type annotation: `x1` is inferred as `boolean`
// D3361, D3533: a join of two declared type parameters stays a union of both inside a generic
// nested in another function and inside a lambda in a generic body, so `is` reads each arm.
type P = {x: i32}
const x0: i32 | null = null
const x1: boolean = false
function outer(k: i32) {
  function inner<V, W>(a: V, b: W, k2: i32) {
    const r = if k2 == 0 { a } else { b }
    print(r is boolean)
    print(r is null)
  }
  inner(x0, x1, k)
}
outer(0)
outer(1)
function g<V, W>(a: V, b: W, k2: i32) {
  const f = (k: i32) => {
    const r = if k == 0 { a } else { b }
    print(r is boolean)
  }
  f(k2)
}
g(x0, x1, 0)
g(x0, x1, 1)
function outerP(k: i32) {
  function innerP<V, W>(a: V, b: W, k2: i32) {
    const r = if k2 == 0 { a } else { b }
    print(r is P)
  }
  const p: P = {x: 1}
  innerP(x0, p, k)
}
outerP(0)
outerP(1)
