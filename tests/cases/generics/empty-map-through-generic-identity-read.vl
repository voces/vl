// @run
// @log 0
// @log 0
// @log 0
// A generic identity's result over an empty `Map()` or `Set()` reads at the closed container its
// call's instance binds, read off the call itself as well as off a binding of it (D16207).
function take<B>(b: B): B { return b }
print(take(Map()).length)
print(take(Set()).length)
const s = take(Map())
print(s.length)
