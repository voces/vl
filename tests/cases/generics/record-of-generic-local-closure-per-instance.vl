// @run
// @log 2.5
// @log s
// @info `g` is never reassigned; use `const` instead of `let`
// A local closure of a generic held in an annotated record is held per instance: each instance's
// binding is its own, at that instance's closure, whichever instance is built first.
function b<U>(y: U) { print(y) }
function a<T>(x: T) {
  let g: (t: T) => void = b
  const r: {f: (t: T) => void} = { f: g }
  r.f(x)
}
a(2.5)
a("s")
