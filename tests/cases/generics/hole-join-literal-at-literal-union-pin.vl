// @run
// @log a
// @log z
// @log a
// @log z
// @log null
// @log c
// @log b
// @log null
// @log c
// An un-annotated parameter joined with a string literal is typed as the join per call, so at a
// `K | null` pin the call is `string | null` and its value the literal's (D3303); an `else if`
// chain and a direct `print` of the join read it the same way.
type K = "a" | "b" | "c"
function g(a, c: boolean) {
  const r = if c { a } else { "z" }
  r
}
const u: K | null = "a"
print(g(u, true))
print(g(u, false))
function p(a, c: boolean) { print(if c { a } else { "z" }) }
p(u, true)
p(u, false)
const n: K | null = null
function q(a, c: boolean) { print(if c { a } else { "c" }) }
q(n, true)
q(n, false)
function e(a, b, k: i32) {
  const r = if k == 0 { a } else if k == 1 { b } else { "c" }
  print(r)
}
const w: K | null = "b"
e(w, n, 0)
e(w, n, 1)
e(w, n, 2)
