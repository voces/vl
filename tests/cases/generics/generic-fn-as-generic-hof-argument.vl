// @run
// @log false
// @log false
// @log false
// @log false
// @log 1
// @log false
// @log false
// @hint redundant type annotation: `opT` is inferred as `boolean`
// @hint redundant type annotation: `opC` is inferred as `boolean`
// @hint redundant type annotation: `hofConcrete` is inferred as `boolean`
// @hint redundant type annotation: `hofGenTv` is inferred as `boolean`
// @hint redundant type annotation: `a` is inferred as `i32`
// @hint redundant type annotation: `b` is inferred as `i32`
// @hint redundant type annotation: `a` is inferred as `f64`
// @hint redundant type annotation: `b` is inferred as `f64`
// THE HINTS ARE DECLARED RATHER THAN THE ANNOTATIONS DELETED: `const a: i32 = 1` is what
// pins the operand type this instantiation is measured at, and `opT`'s `: boolean` is the
// arrow's RESULT half — the axis the `hofGenRet` row varies. An annotation a fixture is
// about is load-bearing even where inference agrees with it.
// GRADUATED from `silent-class-inventory` D58 — a GENERIC function passed as a closure
// ARGUMENT was a loud emit reject at EVERY instantiation (105 of 741 cells of the D42/D44/D46
// grid, all of them, so that grid's whole HOF-parameter column measured the delivery and never
// reached the comparison it was written for).
//
// THE TRIGGER IS THE PAIR, NOT EITHER HALF. `monoWalk` hands the RECEIVER's declared parameter
// type to `monoCoerceFnValue` so a generic argument materializes at it — sound when the
// declaration is concrete (`apply(f: (i32,i32)=>i32)`), and nonsense when the receiver is
// itself generic: `monoFnTypeAnnParamsName` split `(U, U) => R` into the pin names
// `["U", "U"]`, and `monoInstanceFor` minted an instance of `opT` whose parameters are spelled
// `U` — a type VARIABLE of a different function, which no valtype ladder can lower
// (`emitProgram: only i32, i64, f64, f32, boolean, struct, union, array, or string parameters
// are supported`). A generic callee into a CONCRETE hof ran; a concrete callee into a generic
// hof ran; only both together failed, which is why the two single-generic rows below are the
// controls that make the pair the axis.
//
// THE FIX IS AN ORDER, NOT A NEW RESOLVER. The main binding loop takes a type parameter at its
// FIRST use in declaration order, and `hof<U, R>(g: (U, U) => R, a: U, b: U)` uses `U` first at
// `g`, where the only thing to read it off is the argument's own declaration. Binding from the
// VALUE arguments first — gated on a generic function actually being on its way into such a
// parameter, so the two orders can only differ where one of them says `U = T` — makes the
// arrow parameter SUBSTITUTE to a function type that exists, and the coercion `monoWalk`
// deferred then happens against that.
//
// THE ARROW SHAPES ARE THE AXIS AND ALL FOUR ARE HERE: a fully concrete arrow, an arrow whose
// RESULT alone is a type parameter (which ran — `R` binds from the argument and nothing reads
// a variable as a type), an arrow whose PARAMETERS are (which did not), and both.
function opT<T>(a: T, b: T): boolean { a == b }
function opC(a: i32, b: i32): boolean { a == b }
function idn<Q>(q: Q): Q { q }

function hofConcrete(g: (i32, i32) => boolean, a: i32, b: i32): boolean {
  g(a, b)
}
function hofGenRet<R>(g: (i32, i32) => R, a: i32, b: i32): R { g(a, b) }
function hofGenTv<U>(g: (U, U) => boolean, a: U, b: U): boolean { g(a, b) }
function hofGen2<U, R>(g: (U, U) => R, a: U, b: U): R { g(a, b) }

// THE FILED WITNESS: a generic callee into a two-parameter generic hof.
function cellGen2() {
  const a: i32 = 1
  const b: i32 = 2
  return hofGen2(opT, a, b)
}

// The arrow's PARAMETERS ride the type variable; its result does not.
function cellGenTv() {
  const a: i32 = 1
  const b: i32 = 2
  return hofGenTv(opT, a, b)
}

// The arrow's RESULT alone rides one — this ran before and must still.
function cellGenRet() {
  const a: i32 = 1
  const b: i32 = 2
  return hofGenRet(opT, a, b)
}

// CONTROL: the generic callee into a CONCRETE hof. Ran before, runs now.
function cellConcreteHof() {
  const a: i32 = 1
  const b: i32 = 2
  return hofConcrete(opT, a, b)
}

// CONTROL: a THIRD generic in the file, so the count of generics is an axis rather than a
// constant — a false reject survived a whole grid whose every cell had exactly one.
function cellThreeGenerics() {
  const a: i32 = 1
  const b: i32 = 2
  const z = idn(1)
  if hofGen2(opT, a, b) { return 0 }
  return z
}

// CONTROL: a CONCRETE callee into the generic hof. Ran before, runs now.
function cellConcreteCallee() {
  const a: i32 = 1
  const b: i32 = 2
  return hofGen2(opC, a, b)
}

// A NON-i32 operand type, so the pin is not carrying the default.
function cellF64() {
  const a: f64 = 1.5
  const b: f64 = 2.5
  return hofGen2(opT, a, b)
}

print(cellGen2())
print(cellGenTv())
print(cellGenRet())
print(cellConcreteHof())
print(cellThreeGenerics())
print(cellConcreteCallee())
print(cellF64())
