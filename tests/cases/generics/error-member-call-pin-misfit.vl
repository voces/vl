// @check
// @error `.slice` on string is its built-in method, not the `slice` in scope, which returns string, not the i32 the body uses (the body of `f` at the call's argument types)
// @error `.push` on string[] is its built-in method, not the `push` in scope, whose argument 1 is string, not i32 (the body of `g` at the call's argument types)
// @error `.indexOf` on string is its built-in method, not the `indexOf` in scope, whose argument 1 is string, not i32 (the body of `h` at the call's argument types)
// @error `.charCodeAt` on string is its built-in method, not the `charCodeAt` in scope, which takes different arguments than this call passes (the body of `k` at the call's argument types)
// @error `.includes` on string is its built-in method, not the `includes` in scope, which takes no named arguments (the body of `n` at the call's argument types)
// A generic body typed `x.name(…)` against the `self`-function in scope; at an instance whose
// receiver has a built-in method of that name, the built-in takes the call (D2517), so the call
// must fit it as the body used it. Each refusal names the built-in and what does not fit. Before,
// these ran the function, or emitted invalid wasm where the value's type differed.
function slice(self: string | boolean, a: i32, b: i32): i32 { 5 }
function f<T>(x: T) { print(x.slice(0, 2) + 1) }
f("hello")
function push(self: string[] | boolean, v: i32) { print(99) }
function g<T>(x: T) { x.push(1) }
const xs: string[] = []
g(xs)
function indexOf(self: string | boolean, a: i32): i32 { a }
function h<T>(x: T) { print(x.indexOf(1)) }
h("hello")
function charCodeAt(self: string | boolean, a: i32, b: i32): i32 { a + b }
function k<T>(x: T) { print(x.charCodeAt(1, 2)) }
k("hello")
function includes(self: string | boolean, s: string): boolean { false }
function n<T>(x: T) { print(x.includes(s: "e")) }
n("hello")
