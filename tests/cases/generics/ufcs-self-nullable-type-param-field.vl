// @run
// @log 7
// @log 4
// @hint redundant type annotation: `t` is inferred as `{slots: (i32 | null)[]}`
// @hint redundant type annotation: `tt` is inferred as `{slots: (Tex | null)[]}`
// D2526: a method-call spelling `t.put(…)` of a generic `self`-function over a record whose
// field is `(V | null)[]` was refused as a write to a widened field, because the receiver's
// `(i32 | null)` element was compared with `V | null` before `V` was bound. The direct call
// `put(t, …)` always ran. A nullable source into a nullable type variable binds the variable.
type Tbl<V> = { slots: (V | null)[] }

function put<V>(self: Tbl<V>, id: i32, v: V) { self.slots[id] = v }

const s: (i32 | null)[] = [null, null]
const t: Tbl<i32> = { slots: s }
t.put(1, 7)
print(t.slots[1] ?? -1)

type Tex = { w: i32 }
const u: (Tex | null)[] = [null]
const tt: Tbl<Tex> = { slots: u }
tt.put(0, { w: 4 })
const r = tt.slots[0]
if r != null { print(r.w) }
