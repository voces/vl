// @run
// @log 1
// @log 1
// @log 0
// @log false
// An empty `Set()` handed to a type parameter nothing else types closes it to the set the literal
// is built at, a `string` element, as an empty `Map()` closes to its built map (D15040, D1887).
// Nothing observes the element of a set no write reaches: a `has` of a string asks it, `false`.
function one<B>(b: B) { return [b].length }
function take<B>(b: B): B { return b }
print(one(Set()))
print(one(Map()))
print(take(Set()).length)
print(take(Set()).has("a"))
